+            visit(window, 0)
+        } else {
+            out.append(Node(el: window, depth: 0))
+            for sheet in sheets { visit(sheet, 1, panel: true) }
+        }
     }
-    for window in (attr(app, kAXWindowsAttribute) as? [AXUIElement]) ?? [] { visit(window, 0) }
     return out
 }
 
