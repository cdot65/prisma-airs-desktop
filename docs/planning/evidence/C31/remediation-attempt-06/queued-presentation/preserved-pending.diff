+
+// Both queue adapters use the production callback guards. The unscoped fallback
+// deliberately preserves the old public adapter contract: the old core's calls
+// have no owner to revoke. This makes the old-red failures behavioral, not a
+// missing-new-API compilation failure.
+#[derive(Default)]
+struct QueuedNative {
+    registry: desktop_host::native_confirmation::Registry,
+    owner: desktop_host::native_confirmation::SecretOwnership,
+    queue_confirms: std::sync::atomic::AtomicBool,
+    confirm_entries: std::sync::atomic::AtomicUsize,
+    state: Mutex<QueuedState>,
+}
+#[derive(Default)]
+struct QueuedState {
+    secrets: Vec<SecretTask>,
+    confirmations: Vec<ConfirmationTask>,
+    shown_secrets: usize,
+    copied_secrets: usize,
+    shown_confirmations: usize,
+}
+enum SecretTask {
+    Legacy(String, zeroize::Zeroizing<String>),
+    Scoped(desktop_host::native_confirmation::SecretPresentation),
+}
+enum ConfirmationTask {
+    Legacy(u64, desktop_core::ConfirmationRequest),
+    Scoped(desktop_host::native_confirmation::ConfirmationPresentation),
+}
+impl QueuedNative {
+    fn secret_count(&self) -> usize { self.state.lock().expect("queue").secrets.len() }
+    fn confirmation_count(&self) -> usize { self.state.lock().expect("queue").confirmations.len() }
+    fn drain(&self) {
+        use desktop_host::native_confirmation::SecretPresentation;
+        let (secrets, confirmations) = {
+            let mut state = self.state.lock().expect("queue");
+            (std::mem::take(&mut state.secrets), std::mem::take(&mut state.confirmations))
+        };
+        for task in secrets {
+            let task = match task {
+                SecretTask::Legacy(label, secret) => SecretPresentation::new(label, secret, desktop_core::PresentationLease::default(), self.owner.begin()),
+                SecretTask::Scoped(task) => task,
+            };
+            task.run(&self.owner, |_, _, permit| {
+                let mut state = self.state.lock().expect("queue");
+                state.shown_secrets += 1;
+                if permit.allowed(&self.owner) { state.copied_secrets += 1; }
+            });
+        }
+        for task in confirmations {
+            match task {
+                ConfirmationTask::Legacy(nonce, _request) => {
+                    self.state.lock().expect("queue").shown_confirmations += 1;
+                    self.registry.complete(nonce, true);
+                }
+                ConfirmationTask::Scoped(task) => {
+                    task.run(&self.registry, |_, _, permit| {
+                        self.state.lock().expect("queue").shown_confirmations += 1;
+                        permit.complete(&self.registry, true);
+                    });
+                }
+            }
+        }
+    }
+}
+impl desktop_core::SecretPresenter for QueuedNative {
+    fn reveal(&self, label: String, secret: zeroize::Zeroizing<String>) {
+        self.state.lock().expect("queue").secrets.push(SecretTask::Legacy(label, secret));
+    }
+    fn reveal_scoped(&self, label: String, secret: zeroize::Zeroizing<String>, lease: desktop_core::PresentationLease) {
+        let task = desktop_host::native_confirmation::SecretPresentation::new(label, secret, lease, self.owner.begin());
+        self.state.lock().expect("queue").secrets.push(SecretTask::Scoped(task));
+    }
+    fn dismiss(&self) { self.owner.begin(); }
+}
+impl desktop_core::OperatorConfirmation for QueuedNative {
+    fn confirm(&self, nonce: u64, request: desktop_core::ConfirmationRequest) -> futures_util::future::BoxFuture<'static, bool> {
+        if !self.queue_confirms.load(std::sync::atomic::Ordering::Acquire) {
+            self.confirm_entries.fetch_add(1, std::sync::atomic::Ordering::Release);
+            return Box::pin(async { true });
+        }
+        let receiver = self.registry.open(nonce);
+        self.state.lock().expect("queue").confirmations.push(ConfirmationTask::Legacy(nonce, request));
+        self.confirm_entries.fetch_add(1, std::sync::atomic::Ordering::Release);
+        Box::pin(desktop_host::native_confirmation::outcome(receiver))
+    }
+    fn confirm_scoped(&self, nonce: u64, request: desktop_core::ConfirmationRequest, lease: desktop_core::PresentationLease) -> futures_util::future::BoxFuture<'static, bool> {
+        if !lease.is_current() {
+            self.confirm_entries.fetch_add(1, std::sync::atomic::Ordering::Release);
+            return Box::pin(async { false });
+        }
+        if !self.queue_confirms.load(std::sync::atomic::Ordering::Acquire) {
+            self.confirm_entries.fetch_add(1, std::sync::atomic::Ordering::Release);
+            return Box::pin(async { true });
+        }
+        let receiver = self.registry.open(nonce);
+        let task = desktop_host::native_confirmation::ConfirmationPresentation::new(nonce, request, lease);
+        self.state.lock().expect("queue").confirmations.push(ConfirmationTask::Scoped(task));
+        self.confirm_entries.fetch_add(1, std::sync::atomic::Ordering::Release);
+        Box::pin(desktop_host::native_confirmation::outcome(receiver))
+    }
+    fn dismiss(&self, nonce: u64) { self.registry.complete(nonce, false); }
+}
+
+async fn cross_teardown(secret: bool, before_effect: bool) {
+    let native = Arc::new(QueuedNative::default());
+    let mut desk = Desk::with_presenter(false, Some(Arc::clone(&native))).await;
+    let review = desk.review().await;
+    let original = if secret {
+        desk.apply(&review);
+        Some(desk.settled().await)
+    } else {
+        native.queue_confirms.store(true, std::sync::atomic::Ordering::Release);
+        None
+    };
+    let confirm_before = native.confirm_entries.load(std::sync::atomic::Ordering::Acquire);
+    let gate = before_effect.then(|| desk.core.operator().hold_next_native_presentation());
+    let intent = if let Some(result) = &original {
+        json!({"kind":"revealSecret","operation":result.operation})
+    } else {
+        json!({"kind":"requestApply","review":review.review,"draft":draft(),"confirmation":"CREATE"})
+    };
+    let dispatch = desk.send_thread(intent);
+    if let Some(gate) = &gate {
+        assert!(eventually(|| gate.entered()).await, "real admission completed; effect not executed");
+    } else {
+        assert!(eventually(|| if secret { native.secret_count() == 1 } else { native.confirmation_count() == 1 }).await, "real native callback queued");
+    }
+    desk.retire();
+    desk.register();
+    if let Some(gate) = gate { gate.release(); }
+    dispatch.join().expect("dispatch thread").expect("original admission receipt");
+    if !secret {
+        assert!(eventually(|| native.confirm_entries.load(std::sync::atomic::Ordering::Acquire) > confirm_before).await,
+            "native adapter has made its queue/refusal decision");
+    }
+    native.drain();
+    {
+        let state = native.state.lock().expect("queue");
+        assert_eq!(state.shown_secrets, 0, "departed page's admitted/queued key must never be presented");
+        assert_eq!(state.copied_secrets, 0, "departed page's key must never be copied");
+        assert_eq!(state.shown_confirmations, 0, "departed page's confirmation must never be presented");
+    }
+    assert_eq!(native.registry.open_count(), 0, "no stale pending nonce");
+    assert_eq!(desk.writes(), usize::from(secret), "no mutation replay");
+    if let Some(original) = original {
+        let result = &desk.snap().changes.results[0];
+        assert_eq!(result.operation, original.operation);
+        assert_eq!(result.outcome, Some(desktop_core::runtime::Outcome::Completed));
+        assert!(desk.send(json!({"kind":"revealSecret","operation":original.operation})).is_err());
+    }
+    native.queue_confirms.store(false, std::sync::atomic::Ordering::Release);
+    let fresh = desk.review().await;
+    desk.apply(&fresh);
+    let fresh = desk.settled().await;
+    assert_eq!(fresh.outcome, Some(desktop_core::runtime::Outcome::Completed));
+    assert_eq!(desk.writes(), usize::from(secret) + 1, "only explicit fresh-page work writes");
+    desk.send(json!({"kind":"revealSecret","operation":fresh.operation})).expect("fresh reveal");
+    native.drain();
+    let state = native.state.lock().expect("queue");
+    assert_eq!(state.shown_secrets, 1, "fresh-page presentation works");
+    assert_eq!(state.copied_secrets, 1, "fresh-page explicit copy works");
+}
+
+#[tokio::test(flavor = "multi_thread")]
+async fn scoped_secret_admitted_before_teardown_cannot_present_after_effect_release() { cross_teardown(true, true).await; }
+#[tokio::test(flavor = "multi_thread")]
+async fn scoped_secret_queued_before_teardown_cannot_present_or_copy() { cross_teardown(true, false).await; }
+#[tokio::test(flavor = "multi_thread")]
+async fn scoped_confirmation_admitted_before_teardown_cannot_present_after_effect_release() { cross_teardown(false, true).await; }
+#[tokio::test(flavor = "multi_thread")]
+async fn scoped_confirmation_queued_before_teardown_cannot_present() { cross_teardown(false, false).await; }
