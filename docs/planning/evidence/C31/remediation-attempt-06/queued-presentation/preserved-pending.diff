+/// The same revocation check is used immediately before AppKit presentation
+/// and again in its explicit copy callback.
+#[derive(Clone)]
+pub struct SecretCopyPermit {
+    lease: desktop_core::PresentationLease,
+    generation: u64,
+}
+impl SecretCopyPermit {
+    pub fn allowed(&self, owner: &SecretOwnership) -> bool {
+        self.lease.is_current() && owner.owns(self.generation)
+    }
+}
+
+/// An admitted secret waiting for the main-thread queue; no new ownership is
+/// allocated when the callback runs. Dropping a refused task zeroizes its key.
+pub struct SecretPresentation {
+    label: String,
+    secret: zeroize::Zeroizing<String>,
+    permit: SecretCopyPermit,
+}
+impl SecretPresentation {
+    pub fn new(label: String, secret: zeroize::Zeroizing<String>, lease: desktop_core::PresentationLease, generation: u64) -> Self {
+        Self { label, secret, permit: SecretCopyPermit { lease, generation } }
+    }
+    pub fn run(self, owner: &SecretOwnership, show: impl FnOnce(String, zeroize::Zeroizing<String>, SecretCopyPermit)) -> bool {
+        if !self.permit.allowed(owner) { return false; }
+        show(self.label, self.secret, self.permit);
+        true
+    }
+}
+
+pub struct ConfirmationPermit {
+    lease: desktop_core::PresentationLease,
+    nonce: u64,
+}
+impl ConfirmationPermit {
+    pub fn complete(&self, registry: &Registry, accepted: bool) -> bool {
+        registry.complete(self.nonce, accepted && self.lease.is_current())
+    }
+}
+/// Production queue entry shared by AppKit and deterministic host regressions.
+pub struct ConfirmationPresentation {
+    nonce: u64,
+    request: desktop_core::ConfirmationRequest,
+    lease: desktop_core::PresentationLease,
+}
+impl ConfirmationPresentation {
+    pub fn new(nonce: u64, request: desktop_core::ConfirmationRequest, lease: desktop_core::PresentationLease) -> Self {
+        Self { nonce, request, lease }
+    }
+    pub fn run(self, registry: &Registry, show: impl FnOnce(u64, desktop_core::ConfirmationRequest, ConfirmationPermit)) -> bool {
+        if !self.lease.is_current() || !registry.is_pending(self.nonce) {
+            registry.complete(self.nonce, false);
+            return false;
+        }
+        show(self.nonce, self.request, ConfirmationPermit { lease: self.lease, nonce: self.nonce });
+        true
+    }
+}
