fn current(open: &Open, id: &str, revision: &str) -> Result<Document, WorkbenchProblem> {
    let doc = open.documents.get(id).ok_or(WorkbenchProblem::Missing)?;
    if doc.revision() != revision {
        return Err(WorkbenchProblem::Stale);
    }
    Ok(doc.clone())
}

