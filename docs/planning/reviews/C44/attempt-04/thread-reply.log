+                        ) : feature.id === 'inbox' ? (
+                            <Inbox ref={heading} snapshot={snapshot} onAct={props.onAct} onNavigate={props.onNavigate} />
+                        ) : feature.id === 'administration' && feature.availability.state === 'available' ? (
+                            <Administration
+                                key={snapshot.active?.context ?? 'none'}
+                                ref={heading}
+                                snapshot={snapshot}
+                                dispatch={props.dispatch}
+                                client={props.client}
+                                onAct={props.onAct}
+                                onNavigate={props.onNavigate}
+                                arrival={arrival && arrival.tenant === tenantNow && arrival.feature === 'administration' ? arrival : null}
+                            />
+                        ) : feature.id === 'harness' && feature.availability.state === 'available' ? (
+                            <Harness
+                                key={snapshot.active?.context ?? 'none'}
+                                ref={heading}
+                                snapshot={snapshot}
+                                dispatch={props.dispatch}
+                                onNavigate={props.onNavigate}
+                                arrival={arrival && arrival.tenant === tenantNow && arrival.feature === 'harness' ? arrival : null}
+                            />
+                        ) : feature.id === 'library' && feature.availability.state === 'available' ? (
+                            // Keyed by context: a new tenant starts at its first page, nothing inspected.
+                            <TestCases key={snapshot.active?.context ?? 'none'} ref={heading} snapshot={snapshot} dispatch={props.dispatch} onNavigate={props.onNavigate} />
+                        ) : feature.id === 'academy' && feature.availability.state === 'available' ? (
+                            // Not keyed by tenant: the learner generation is the account's, not the tenant's.
+                            <Academy ref={heading} snapshot={snapshot} client={props.client} onNavigate={props.onNavigate} />
+                        ) : feature.id === 'apiClient' && feature.availability.state === 'available' ? (
+                            // Not keyed by tenant: API Client documents are on this Mac.
+                            <ApiClient ref={heading} snapshot={snapshot} dispatch={props.dispatch} observe={observeWorkbench} />
+                        ) : (feature.id === 'runtime' || feature.id === 'gateway' || feature.id === 'redTeam') && feature.availability.state === 'available' ? (
+                            // C44: the product destinations (Go, the palette) open Administration on their product; the legacy views are gone.
+                            <Administration
+                                key={snapshot.active?.context ?? 'none'}
+                                ref={heading}
+                                snapshot={snapshot}
+                                dispatch={props.dispatch}
+                                client={props.client}
+                                onAct={props.onAct}
+                                onNavigate={props.onNavigate}
+                                arrival={tenantNow ? { tenant: tenantNow, feature: 'administration', resource: null, item: null, ...PRODUCT_DESTINATION[feature.id] } : null}
+                            />
+                        ) : (
+                            <FeatureBody
+                                ref={heading}
+                                feature={feature}
+                                snapshot={snapshot}
+                                appearancePending={props.appearancePending}
+                                onSetAppearance={props.onSetAppearance}
+                                onNavigate={props.onNavigate}
+                                dispatch={props.dispatch}
+                stack.push(entry.path());
+            } else if meta.is_file() {
+                total += meta.len();
+            }
+        }
+    }
+    Ok(total)
+}
+
+/// Builds the complete unsigned production app and DMG with the sealed
+/// Harness engine as a bundle resource (C19, D046): the frontend, then
+/// `tauri build` with `tauri.harness.conf.json`. Returns the app and DMG.
+pub fn build_production(repo: &Repo, env: &Environment, target: &str) -> Result<ProductionBuild> {
+    // The sealed engine the production app ships with (C19).
+    crate::harness::unpack(repo)?;
+    let commands: Vec<Vec<String>> = [
+        vec!["pnpm", "--filter", "@prisma-airs/desktop", "build"],
+        vec![
+            "pnpm",
+            "--filter",
+            "@prisma-airs/desktop",
+            "exec",
+            "tauri",
+            "build",
+            "--ci",
+            "--no-sign",
+            "--target",
+            target,
+            "--bundles",
+            "app,dmg",
+            // The sealed Harness engine as a bundle resource (C19, D046).
+            "--config",
+            "src-tauri/tauri.harness.conf.json",
+        ],
+    ]
+    .iter()
+    .map(|argv| argv.iter().map(|s| (*s).to_owned()).collect())
+    .collect();
+    for argv in &commands {
+        let status = env
+            .command(argv, repo.root())?
+            .status()
+            .map_err(io_err(repo.root()))?;
+        if !status.success() {
+            return Err(invalid(format!("{} failed with {status}", argv.join(" "))));
+        }
+    }
+    let app = bundle_path(repo, target, PRODUCT);
+    let identifier = plist_value(&app, "CFBundleIdentifier")?;
+    if identifier != crate::native::PRODUCTION_IDENTIFIER {
+        return Err(invalid(format!(
+            "the production bundle has identifier {identifier}"
+        )));
+    }
+    let version = plist_value(&app, "CFBundleShortVersionString")?;
+    let dmg = repo.join(format!(
+        "target/{target}/release/bundle/dmg/{PRODUCT}_{version}_aarch64.dmg"
+    ));
+    Ok(ProductionBuild {
+        app,
+        dmg,
+        identifier,
+        commands,
+    })
+}
+
+/// A production build: the app, its DMG, the bundle identifier and the
+/// commands that built them.
+pub struct ProductionBuild {
+    pub app: PathBuf,
+    pub dmg: PathBuf,
+    pub identifier: String,
+    pub commands: Vec<Vec<String>>,
+}
+
+const MIB: f64 = 1024.0 * 1024.0;
+
