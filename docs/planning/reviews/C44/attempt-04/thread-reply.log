#!/bin/bash
# Deterministic inventory of the inputs C44's checks compile, test or build:
# the Rust crates and host, the desktop app sources and configuration, the
# contracts package sources and fixtures, the Academy shared source actually
# consumed (.work/academy/src and its installed packages, staged from
# .inputs/academy), the native acceptance tools, the lockfiles, the workspace
# and toolchain manifests, the harness pin and every docs/architecture/*.json.
# Every listed path must exist: a missing one fails the inventory (exit 2)
# instead of producing a partial digest.
# Usage: hash-inputs.sh <repo-root> <inventory-out>; prints the digest.
set -euo pipefail
cd "$1"
DIRS=(crates apps/desktop/src apps/desktop/src-tauri packages/desktop-contracts/src packages/desktop-contracts/fixtures tools/native-acceptance tools/parity tools/academy .work/academy/src .work/academy/packages .inputs/academy)
FILES=(Cargo.toml Cargo.lock rust-toolchain.toml pnpm-lock.yaml package.json pnpm-workspace.yaml resources/harness/pin.json apps/desktop/package.json apps/desktop/index.html packages/desktop-contracts/package.json packages/desktop-contracts/tsconfig.json)
for p in "${DIRS[@]}"; do [ -d "$p" ] || { echo "inventory: missing directory $p" >&2; exit 2; }; done
for p in "${FILES[@]}"; do [ -f "$p" ] || { echo "inventory: missing file $p" >&2; exit 2; }; done
{
  find "${DIRS[@]}" -type f -not -path '*/target/*' -not -path '*/node_modules/*' -not -path '*/gen/schemas/*' -not -path '*/.git/*' -print0 | sort -z | xargs -0 shasum -a 256
  shasum -a 256 "${FILES[@]}" apps/desktop/*.ts apps/desktop/*.json docs/architecture/*.json
} | LC_ALL=C sort -k2 > "$2"
[ -s "$2" ] || { echo "inventory: empty" >&2; exit 2; }
shasum -a 256 "$2" | cut -d' ' -f1
#!/bin/bash
# C44 check runs with a source-bound record. Usage: run-checks.sh <attempt>
# Runs on the approved toolchain (rustup 1.99.0, node 24.21.0, repo pnpm).
set -o pipefail
ATTEMPT=${1:-attempt-01}
cd "$(dirname "$0")/../../../../.."
export PATH="$PWD/.tools/bin:$HOME/.cargo/bin:$HOME/.nvm/versions/node/v24.21.0/bin:/usr/bin:/bin:/usr/sbin:/sbin"
unset RUSTFLAGS CARGO_BUILD_RUSTFLAGS CARGO_TARGET_DIR
# Timing-sensitive suites (4 s "eventually" waits, engine bootstraps) flake when ten test threads
# per binary share this Mac with the owner's browser and a second session; four threads per
# binary keep the same tests and assertions, only less contention. Recorded in the run record.
export RUST_TEST_THREADS=4
R=docs/planning/evidence/C44/runs
E=$R/$ATTEMPT
mkdir -p "$E"
# Flake logs are same-input retries of this run only: earlier runs' logs are removed first.
rm -f $E/core-lib.flake-*.log $E/core-fixtures.flake-*.log $E/host.flake-*.log
BEFORE=$($R/hash-inputs.sh "$PWD" $E/inputs-before.sha256) || { echo "input inventory failed; run invalid"; exit 2; }
[ -n "$BEFORE" ] || { echo "input inventory produced no digest; run invalid"; exit 2; }
# Configuration and build flags the controller fingerprints: itemised and hashed together.
BUILD_FLAGS=$(shasum -a 256 docs/architecture/checks.json docs/architecture/native-checks.json docs/architecture/toolchain.json docs/architecture/budgets.json apps/desktop/src-tauri/tauri.conf.json apps/desktop/src-tauri/tauri.fixture.conf.json apps/desktop/src-tauri/capabilities/*.json rust-toolchain.toml 2>/dev/null | shasum -a 256 | cut -d' ' -f1)
export BUILD_FLAGS
run() { local name=$1; shift; local log=$E/$name.log; echo "\$ $*" > "$log"; "$@" >> "$log" 2>&1; local rc=$?; echo "EXIT $rc" >> "$log"; echo "$name exit=$rc"; echo $rc > $E/$name.exit; }
run rustfmt cargo fmt --all -- --check
run clippy cargo clippy --locked -p desktop-core -p desktop-host -p xtask --features test-fixtures --all-targets -- -D warnings
run clippy-default cargo clippy --locked --workspace --all-targets -- -D warnings
run notices cargo run --locked -q -p xtask -- notices --check
run bindings cargo run --locked -q -p xtask -- bindings --check
run contracts-typecheck pnpm --filter @prisma-airs/desktop-contracts exec tsc --noEmit
run desktop-typecheck pnpm --filter @prisma-airs/desktop exec tsc --noEmit
run vitest pnpm --filter @prisma-airs/desktop exec vitest run --config vitest.config.ts
run vitest-truth pnpm --filter @prisma-airs/desktop exec vitest run --config vitest.truth.config.ts
run core-lib cargo test --locked -p desktop-core --lib
# One library test (workbench::profile sealed_files_open_only_under_their_key_and_name) reads the first entry of
# its fresh directory and flaked once under the full suite's load while passing alone: the same command is
# retried on the same frozen inputs, every failed run kept as evidence.
for try in 1 2; do
  if [ "$(cat $E/core-lib.exit)" != "0" ]; then
    cp $E/core-lib.log $E/core-lib.flake-$try.log
    run core-lib cargo test --locked -p desktop-core --lib
  fi
done
run core-fixtures cargo test --locked -p desktop-core --features test-fixtures
# A timing-sensitive test (Harness-engine turns, or the transport's connection-release
# check) can flake under the full-suite load: the exact same
# command is retried on the same frozen inputs, every failed run kept as evidence.
for try in 1 2; do
  if [ "$(cat $E/core-fixtures.exit)" != "0" ]; then
    cp $E/core-fixtures.log $E/core-fixtures.flake-$try.log
    run core-fixtures cargo test --locked -p desktop-core --features test-fixtures
  fi
done
# The chunk's registered fixture command (docs/architecture/checks.json C44), exactly as the manifest runs it.
run fixture-command cargo test --locked -p desktop-core --features test-fixtures --test ui_v2_closure
run host cargo test --locked -p desktop-host --features test-fixtures
# The host's Academy device-flow tests (browser_callback.rs, outside this chunk) wait 5 s for a
# state and flake under load: the same command is retried on the same frozen inputs, every
# failed run kept as evidence.
for try in 1 2; do
  if [ "$(cat $E/host.exit)" != "0" ]; then
    cp $E/host.log $E/host.flake-$try.log
    run host cargo test --locked -p desktop-host --features test-fixtures
  fi
done
run xtask-lib cargo test --locked -p xtask --lib
run shell-controller cargo test --locked -p xtask --features test-fixtures --test shell_controller
run desktop-build pnpm --filter @prisma-airs/desktop build
AFTER=$($R/hash-inputs.sh "$PWD" $E/inputs-after.sha256) || { echo "input inventory failed after the runs; run invalid"; exit 2; }
[ -n "$AFTER" ] || { echo "input inventory produced no digest after the runs; run invalid"; exit 2; }
python3 -I - "$E" "$BEFORE" "$AFTER" "$ATTEMPT" <<'PY'
import json,sys,subprocess,os,time,hashlib
E,b,a,attempt=sys.argv[1:5]
def ver(c):
    try: return subprocess.check_output(c,text=True,stderr=subprocess.STDOUT).strip()
    except Exception as e: return str(e)
sha=lambda p: hashlib.sha256(open(p,"rb").read()).hexdigest()
names=["rustfmt","clippy","clippy-default","notices","bindings","contracts-typecheck","desktop-typecheck","vitest","vitest-truth","core-lib","core-fixtures","fixture-command","host","xtask-lib","shell-controller","desktop-build"]
rec={"subject":"C44","attempt":attempt,"time":time.strftime("%Y-%m-%dT%H:%M:%S%z"),"cwd":os.getcwd(),
 "toolchain":{"rustc":ver(["rustc","-V"]),"cargo":ver(["cargo","-V"]),"node":ver(["node","-v"]),"pnpm":ver(["pnpm","-v"]),"rustup_active":ver(["rustup","show","active-toolchain"])},
 "environment":{"PATH":os.environ["PATH"],"RUSTFLAGS":os.environ.get("RUSTFLAGS"),"CARGO_TARGET_DIR":os.environ.get("CARGO_TARGET_DIR"),"RUST_TEST_THREADS":os.environ.get("RUST_TEST_THREADS")},
 "build_flags":{"digest":os.environ.get("BUILD_FLAGS"),"covers":"checks.json, native-checks.json, toolchain.json, budgets.json, tauri.conf.json, tauri.fixture.conf.json, src-tauri/capabilities/*.json, rust-toolchain.toml"},"inputs":{"procedure":f"{E}/../hash-inputs.sh","procedure_sha256":sha(f"{E}/../hash-inputs.sh"),"before_inventory_sha256":sha(f"{E}/inputs-before.sha256"),"before_digest":b,"after_inventory_sha256":sha(f"{E}/inputs-after.sha256"),"after_digest":a,"unchanged":a==b,"members":sum(1 for _ in open(f"{E}/inputs-before.sha256"))},
 "runs":{}}
for n in names:
    log=f"{E}/{n}.log"
    rec["runs"][n]={"exit":int(open(f"{E}/{n}.exit").read().strip()),"log":log,"log_sha256":sha(log),"summary":[l.strip() for l in open(log,errors="replace") if l.startswith("test result") or "Test Files" in l or "Tests  " in l or l.startswith("EXIT")][-4:]}
json.dump(rec,open(f"{E}/../run-{attempt}.json","w"),indent=2)
print(json.dumps({k:v["exit"] for k,v in rec["runs"].items()}),"inputs unchanged:",a==b,"members:",rec["inputs"]["members"])
PY
import { useCallback, useEffect, useLayoutEffect, useRef, useState } from 'react'
import {
    DeliveryOutcomeUnknown,
    type DesktopClient,
    type FeatureId,
    type Intent,
    type MenuCommand,
    type Refusal,
    type ShellSnapshot,
    type Theme,
} from '@prisma-airs/desktop-contracts'
import { followAppearance } from './shell/appearance'
import { type DispatchOutcome, outcomeMessage } from './features/tenants/dispatch'
import { V2Shell } from './v2/v2-shell'
import { Wizard } from './v2/wizard/wizard'
import { useShellStore } from './v2/store'
import { SHELL_COPY } from './v2/copy'
import { forgetAcademyPresentation } from './features/academy/presentation-storage'
import { SAVE_DOCUMENT_EVENT } from './v2/workbench/request-editor'

export function App({ client }: { client: DesktopClient }) {
    const [snapshot, setSnapshot] = useState<ShellSnapshot | null>(null)
    const snapshotRef = useRef<ShellSnapshot | null>(null)
    snapshotRef.current = snapshot
    const [failure, setFailure] = useState<string | null>(null)
    const [pending, setPending] = useState(false)
    const [status, setStatus] = useState('')

    const dispatch = useCallback(
        async (intent: Intent): Promise<DispatchOutcome> => {
            try {
                const response = await client.dispatch(intent)
                return response.outcome === 'refusal'
                    ? { kind: 'refused', refusal: response.refusal }
                    : { kind: 'admitted', operation: response.receipt.operation }
            } catch (error) {
                return error instanceof DeliveryOutcomeUnknown ? { kind: 'unknown' } : { kind: 'failed' }
            }
        },
        [client]
    )

    // v2 (C28): navigation is Rust-owned. The native menu, the sidebar and
    // the palette all dispatch `navigate`; refusals reach the status surface.
    const v2Navigate = useCallback(
        async (feature: FeatureId) => {
            useShellStore.getState().closePalette()
            const intent: Intent = { kind: 'navigate', feature }
            const outcome = await dispatch(intent)
            if (outcome.kind === 'refused') useShellStore.getState().toast(SHELL_COPY.toastRefused('Navigation', outcome.refusal), 'warn')
            // Unknown delivery is kept inline with Retry; never an expiring toast alone.
            else if (outcome.kind === 'unknown') useShellStore.getState().addUnconfirmed('Navigation', intent)
            else if (outcome.kind === 'failed') useShellStore.getState().toast(SHELL_COPY.toastFailed('Navigation'), 'warn')
        },
        [dispatch]
    )
    // Every v2 action's outcome reaches the shell's surfaces (DESIGN-V2 §7):
    // a refusal or failed delivery as a warn toast naming what was asked, an
    // unconfirmed delivery inline with Retry, never replayed on its own.
    const v2Act = useCallback(
        async (what: string, intent: Intent, quiet: Refusal[] = []): Promise<DispatchOutcome> => {
            // A context-bound action speaks for the tenant it was sent in (I2).
            const boundContext = typeof (intent as { context?: unknown }).context === 'string' ? (intent as { context: string }).context : null
            const bound = boundContext !== null ? (snapshotRef.current?.active?.tenant ?? null) : null
            const outcome = await dispatch(intent)
            if (outcome.kind === 'refused' && quiet.includes(outcome.refusal)) return outcome
            if (outcome.kind === 'refused') useShellStore.getState().toast(SHELL_COPY.toastRefused(what, outcome.refusal, outcomeMessage(outcome)), 'warn', undefined, bound, boundContext)
            else if (outcome.kind === 'unknown') useShellStore.getState().addUnconfirmed(what, intent)
            else if (outcome.kind === 'failed') useShellStore.getState().toast(SHELL_COPY.toastFailed(what), 'warn', undefined, bound, boundContext)
            return outcome
        },
        [dispatch]
    )
    const v2Preference = useCallback(
        async (what: string, intent: Intent, quiet: Refusal[] = []) => {
            await v2Act(what, intent, quiet)
        },
        [v2Act]
    )

    const onMenu = useRef<(command: MenuCommand) => void>(() => undefined)
    onMenu.current = (command: MenuCommand) => {
        // Native navigation dismisses the modal palette first so focus can
        // move to the new page heading instead of behind an open dialog.
        if (command.kind === 'navigate') void v2Navigate(command.feature)
        else if (command.kind === 'commandPalette') useShellStore.getState().openPalette()
        // ⌘T: the tenant switcher opens; nothing switches until chosen.
        else if (command.kind === 'tenantSwitcher') useShellStore.getState().setSwitcher(true)
        // The open API Client request saves (its editor listens).
        else if (command.kind === 'saveDocument') window.dispatchEvent(new Event(SAVE_DOCUMENT_EVENT))
        else void v2Preference('The appearance change', { kind: 'setAppearance', theme: command.theme })
    }

    useEffect(() => {
        let stop: (() => void) | undefined
        let cancelled = false
        client
            .observeShell({
                onSnapshot: (next) => {
                    // The shell's scope follows the snapshot before it renders: a
                    // notification for another tenant or context is never surfaced.
                    useShellStore.getState().setScope(next.active?.tenant ?? null, next.active?.context ?? null)
                    setSnapshot(next)
                },
                onMenu: (command) => onMenu.current(command),
                onError: () => setFailure('The desktop sent an unexpected update.'),
            })
            .then(
                (unsubscribe) => {
                    if (cancelled) unsubscribe()
                    else stop = unsubscribe
                },
                () => setFailure('The desktop shell could not be observed.')
            )
        return () => {
            cancelled = true
            stop?.()
        }
    }, [client])

    // A completed reset also forgets Academy's WebView presentation state
    // (completion latches keyed by account); a stopped reset keeps it.
    const storage = snapshot?.storage
    const resetFailed = Boolean(snapshot?.resetFailure)
    const previousStorage = useRef(storage)
    useEffect(() => {
        if (previousStorage.current === 'resetting' && storage !== 'resetting' && !resetFailed) {
            forgetAcademyPresentation()
        }
        previousStorage.current = storage
    }, [storage, resetFailed])

    const appearance = snapshot?.appearance
    // Apply the theme in the same commit as the snapshot, before paint, so
    // the shell never shows a frame in the previous theme.
    useLayoutEffect(() => (appearance ? followAppearance(appearance) : undefined), [appearance])

    if (failure && !snapshot) {
        return (
            <main role='alert' className='text-academy-ink p-8'>
                {failure}
            </main>
        )
    }
    if (!snapshot) {
        return (
            <main role='status' aria-live='polite' className='text-academy-ink-soft p-8'>
                Starting Prisma AIRS Desktop…
            </main>
        )
    }
    if (snapshot.onboarding !== 'done') {
        // First run: the wizard owns the window (D060: no alpha import; nothing leaves it before a tenant exists).
        return (
            <div data-v2-shell=''>
                <Wizard
                    snapshot={snapshot}
                    dispatch={dispatch}
                    observeManagement={(operation) => client.observeManagement(operation)}
                    mode='firstRun'
                    onClose={() => undefined}
                    onNavigate={(feature) => void v2Navigate(feature)}
                />
            </div>
        )
    }
    return (
        <V2Shell
            snapshot={snapshot}
            appearancePending={pending}
            status={failure ?? status}
            onNavigate={(feature) => void v2Navigate(feature)}
            onSetAppearance={(theme) => void v2Preference('The appearance change', { kind: 'setAppearance', theme })}
            onSetShowCalls={(on) => void v2Preference('The preference change', { kind: 'setShowCalls', on })}
            onSwitchTenant={(tenant, resolution) => {
                // The target is captured now: a late refusal still names it. A
                // pending-decision refusal is not a toast: the snapshot carries
                // the guard the shell renders (I1).
                const label = snapshot.tenants.find((t) => t.id === tenant)?.label ?? tenant
                void v2Preference(SHELL_COPY.switchTo(label), { kind: 'selectTenant', tenant, resolution: resolution ?? null }, ['decisionPending'])
            }}
            onReadNow={() => {
                // The palette's Read now is the same finite read of every chosen product (I4).
                const active = snapshot.active
                if (!active) return
                const label = snapshot.tenants.find((t) => t.id === active.tenant)?.label ?? active.tenant
                void v2Preference(SHELL_COPY.readOf(label), { kind: 'readTenant', context: active.context })
            }}
            onRetry={(what, intent) => void v2Preference(what, intent)}
            onAct={v2Act}
            dispatch={dispatch}
            client={client}
        />
    )
}
import { forwardRef, useCallback } from 'react'
import type { DesktopClient, FeatureEntry, FeatureId, ShellSnapshot, Theme } from '@prisma-airs/desktop-contracts'
import { SessionsView } from '../features/sessions/sessions-view'
import type { Dispatch } from '../features/tenants/dispatch'
import { SettingsView, UnavailableView } from './feature-view'

export interface FeatureBodyProps {
    feature: FeatureEntry
    snapshot: ShellSnapshot
    appearancePending: boolean
    onSetAppearance: (theme: Theme) => void
    onNavigate: (id: FeatureId) => void
    dispatch: Dispatch
    /** The native client, for management observations. */
    client: DesktopClient
}

/**
 * The destinations the v2 shell frames without a board of their own (C44):
 * Settings, Sessions & Reports and the reviewed v1 import, keyed by the
 * active context where a view must never outlive its credential. Every
 * other destination is a v2 screen; the legacy shell and its views are gone.
 */
export const FeatureBody = forwardRef<HTMLHeadingElement, FeatureBodyProps>(function FeatureBody(props, heading) {
    const { feature, snapshot } = props
    const client = props.client
    const observeManagement = useCallback((operation: string) => client.observeManagement(operation), [client])
    return (
        <>
            {feature.id === 'settings' ? (
                <SettingsView
                    ref={heading}
                    snapshot={snapshot}
                    pending={props.appearancePending}
                    onSetAppearance={props.onSetAppearance}
                    dispatch={props.dispatch}
                    observeManagement={observeManagement}
                />
            ) : feature.id === 'sessions' && feature.availability.state === 'available' ? (
                <SessionsView
                    // A new tenant or management credential remounts the view:
                    // revealed content never outlives its credential.
                    key={snapshot.active?.context ?? 'none'}
                    ref={heading}
                    snapshot={snapshot}
                    dispatch={props.dispatch}
                    observe={observeManagement}
                    onNavigate={props.onNavigate}
                />
            ) : (
                <UnavailableView ref={heading} feature={feature} />
            )}
        </>
    )
})
import { forwardRef, useId, useState } from 'react'
import { Button, Callout, Kicker } from '@ai-security-academy/presentation'
import { Info } from 'lucide-react'
import type { FeatureEntry, Intent, ShellSnapshot, Theme } from '@prisma-airs/desktop-contracts'
import { type Dispatch, outcomeMessage } from '../features/tenants/dispatch'
import { DiagnosticsPanel } from '../features/diagnostics/diagnostics-panel'
import { AcademyAccount } from '../features/academy/academy-account'
import { TenantsSettings } from '../features/tenants/tenants-settings'
import type { ObserveManagement } from '../features/administration/management-read'
import { useV2Layout } from './presentation'

interface HeadingProps {
    id: string
    kicker: string
    title: string
}

/** Page heading that receives focus after navigation (tabIndex -1). */
export const PageHeading = forwardRef<HTMLHeadingElement, HeadingProps>(function PageHeading({ id, kicker, title }, ref) {
    // In the v2 shell: its title row (26px/700, no kicker), like every other destination (C33).
    if (useV2Layout()) {
        return (
            <header className='mb-4 flex flex-col gap-1' data-slot='page-header-v2'>
                <h1 ref={ref} id={id} tabIndex={-1} data-slot='page-heading' className='font-bold outline-none' style={{ fontSize: 'var(--v2-title)' }}>
                    {title}
                </h1>
            </header>
        )
    }
    return (
        <header className='mb-6 flex flex-col gap-2'>
            <Kicker>{kicker}</Kicker>
            <h1
                ref={ref}
                id={id}
                tabIndex={-1}
                data-slot='page-heading'
                className='font-display text-academy-ink text-[28px] leading-tight font-semibold tracking-[-0.01em] outline-none'
            >
                {title}
            </h1>
        </header>
    )
})

export const UnavailableView = forwardRef<HTMLHeadingElement, { feature: FeatureEntry }>(function UnavailableView({ feature }, ref) {
    const planned = feature.availability.state === 'unavailable' ? feature.availability.plannedChunk : ''
    return (
        <section aria-labelledby={`${feature.id}-heading`} data-slot='feature-unavailable'>
            <PageHeading ref={ref} id={`${feature.id}-heading`} kicker='Not available' title={feature.label} />
            <Callout tone='default' icon={Info}>
                <p>
                    {feature.label} is not available in this build. Nothing here contacts a Prisma AIRS
                    tenant or the Academy.
                </p>
                <p className='text-academy-ink-faint mt-2 font-mono text-[11px] tracking-[0.12em] uppercase'>
                    Planned in {planned}
                </p>
            </Callout>
        </section>
    )
})

const THEMES: { value: Theme; label: string; hint: string }[] = [
    { value: 'system', label: 'Match System', hint: 'Follow the macOS appearance' },
    { value: 'light', label: 'Light', hint: 'Paper light theme' },
    { value: 'dark', label: 'Dark', hint: 'Gruvbox dark theme' },
]

interface SettingsProps {
    snapshot: ShellSnapshot
    pending: boolean
    onSetAppearance: (theme: Theme) => void
    dispatch: Dispatch
    observeManagement: ObserveManagement
}

export const SettingsView = forwardRef<HTMLHeadingElement, SettingsProps>(function SettingsView(
    { snapshot, pending, onSetAppearance, dispatch, observeManagement },
    ref
) {
    const legend = useId()
    const appearance = snapshot.appearance
    return (
        <section aria-labelledby='settings-heading' data-slot='settings'>
            <PageHeading ref={ref} id='settings-heading' kicker='Desktop' title='Settings' />
            <fieldset aria-labelledby={legend} aria-busy={pending} className='border-academy-rule flex flex-col gap-3 rounded-[12px] border p-5'>
                <legend id={legend} className='text-academy-ink px-1 text-[15px] font-semibold'>
                    Appearance
                </legend>
                <p className='text-academy-ink-soft text-[13px]'>
                    A desktop-wide preference. It does not change your Academy account settings.
                </p>
                {THEMES.map((option) => (
                    <label key={option.value} className='flex min-h-11 cursor-pointer items-center gap-3'>
                        <input
                            type='radio'
                            name='appearance'
                            value={option.value}
                            checked={appearance === option.value}
                            onChange={() => onSetAppearance(option.value)}
                            className='accent-[var(--academy-accent)] size-4'
                        />
                        <span className='flex flex-col'>
                            <span className='text-academy-ink text-[14px] font-medium'>{option.label}</span>
                            <span className='text-academy-ink-faint text-[12px]'>{option.hint}</span>
                        </span>
                    </label>
                ))}
            </fieldset>
            <div className='mt-6'>
                <AcademyAccount view={snapshot.academy} dispatch={dispatch} />
            </div>
            <div className='mt-6'>
                <TenantsSettings snapshot={snapshot} dispatch={dispatch} observeManagement={observeManagement} />
            </div>
            <div className='mt-6'>
                <DiagnosticsPanel view={snapshot.diagnostics} dispatch={dispatch} />
            </div>
        </section>
    )
})
//! C44: one presentation. Through the production authority interface: the
//! snapshot always says the v2 presentation with the v2 catalogue, whatever
//! an older store persisted; `SetUiVariant` (sent by older presentations
//! and drivers) is accepted and changes nothing; navigation resolves against
//! the v2 catalogue only, so every destination the legacy shell reached is
//! still a destination here (the product entries open Administration's
//! products in the shell); a fresh store starts in the first-run wizard.

use desktop_core::features::{FeatureId, OnboardingState, UiVariant};
use desktop_core::fixtures::{self, ScriptedStore};
use desktop_core::store::PersistedState;
use desktop_core::{
    AuthorityHandle, Core, CoreConfig, Delivery, Intent, Observation, Receipt, Refusal,
    ShellSnapshot, ViewScope,
};
use serde_json::json;

struct Desk {
    _core: Core,
    handle: AuthorityHandle,
    session: String,
    sequence: u64,
}

impl Desk {
    fn from_state(state: PersistedState) -> Self {
        let (adapters, _handles) = fixtures::adapters_with(ScriptedStore::with_state(state));
        let core = Core::new(CoreConfig::default(), adapters);
        core.start();
        let handle = core.operator();
        let session = handle.register_delivery_session().expect("session").nonce;
        Self {
            _core: core,
            handle,
            session,
            sequence: 0,
        }
    }

    async fn send(&mut self, intent: serde_json::Value) -> Result<Receipt, Refusal> {
        let intent: Intent = serde_json::from_value(intent).expect("intent");
        self.sequence += 1;
        self.handle
            .dispatch(
                Delivery {
                    session: self.session.clone(),
                    sequence: self.sequence,
                },
                intent,
            )
            .await
    }

    fn snap(&self) -> ShellSnapshot {
        match self.handle.observe(ViewScope::Shell).expect("observe") {
            Observation::Shell { snapshot, .. } => snapshot,
            _ => unreachable!("shell scope"),
        }
    }
}

fn v2_ids(snap: &ShellSnapshot) -> Vec<FeatureId> {
    snap.features.iter().map(|f| f.id).collect()
}

#[tokio::test]
async fn an_older_store_that_persisted_the_legacy_presentation_still_gets_v2() {
    let state = PersistedState {
        ui_variant: UiVariant::Legacy,
        onboarding: OnboardingState::Done,
        ..Default::default()
    };
    let mut desk = Desk::from_state(state);
    let snap = desk.snap();
    assert_eq!(snap.ui_variant, UiVariant::V2);
    assert_eq!(
        v2_ids(&snap)[..7],
        [
            FeatureId::Home,
            FeatureId::Inbox,
            FeatureId::Harness,
            FeatureId::Academy,
            FeatureId::Library,
            FeatureId::ApiClient,
            FeatureId::Administration
        ]
    );
    // The switch intent is accepted and changes nothing.
    desk.send(json!({"kind": "setUiVariant", "variant": "legacy"}))
        .await
        .expect("accepted");
    let after = desk.snap();
    assert_eq!(after.ui_variant, UiVariant::V2);
    assert_eq!(v2_ids(&after), v2_ids(&snap));
}

#[tokio::test]
async fn every_destination_the_legacy_shell_reached_is_a_v2_destination() {
    let state = PersistedState {
        onboarding: OnboardingState::Done,
        ..Default::default()
    };
    let mut desk = Desk::from_state(state);
    for feature in [
        "home",
        "inbox",
        "harness",
        "academy",
        "library",
        "apiClient",
        "administration",
        "runtime",
        "gateway",
        "redTeam",
        "sessions",
        "settings",
    ] {
        desk.send(json!({"kind": "navigate", "feature": feature}))
            .await
            .unwrap_or_else(|r| panic!("{feature}: {r:?}"));
        let snap = desk.snap();
        assert_eq!(
            serde_json::to_value(snap.active_feature).expect("json"),
            json!(feature)
        );
    }
}

#[tokio::test]
async fn a_fresh_store_starts_in_the_first_run_wizard_of_the_only_presentation() {
    let desk = Desk::from_state(PersistedState::default());
    let snap = desk.snap();
    assert_eq!(snap.ui_variant, UiVariant::V2);
    assert_eq!(snap.onboarding, OnboardingState::Needed);
    assert!(snap.tenants.is_empty());
}

