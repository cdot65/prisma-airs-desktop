    fn prune_workbench_calls(&mut self) {
        self.workbench.calls.retain(|c| !(c.settled && c.observed));
        let settled = self.workbench.calls.iter().filter(|c| c.settled).count();
        let mut excess = settled.saturating_sub(RETAINED_RESULTS);
