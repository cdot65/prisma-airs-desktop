"""The v2 tenant setup for native drivers (C44): the first run opens the
wizard (there is one presentation), so a driver that needs a tenant walks
the wizard once — Connect your tenant with a custom endpoint, the scan key,
the management client, the products, the checks, Skip for now twice, Open
Prisma AIRS — and lands on Home. Drivers written before C44 called
`open_settings` + `create_custom_tenant` + `save_key` + `save_client` and
pressed "Use the new interface"; `tenant_on_home` does the same work on
either build.
"""

import time

import fixture_app as fx
import acceptance_c08 as c8

WELCOME = "Welcome to Prisma AIRS Desktop"
PLACEHOLDER = "Setup tenant"


def _press(app, role, label, timeout=10):
    app.wait_for(lambda t: fx.App.node(t, role, label) is not None, timeout)
    app.ax("press", role, label)
    time.sleep(0.5)


def _press_any(app, label, roles=("AXRadioButton", "AXCheckBox", "AXButton"), timeout=8):
    tree, _ = app.wait_for(lambda t: any((n.get("label") or "") == label and n.get("role") in roles for n in t), timeout)
    node = next((n for n in tree if (n.get("label") or "") == label and n.get("role") in roles), None)
    if node:
        app.ax("press", node["role"], label)
        time.sleep(0.5)
    return node is not None


def wizard_showing(app, timeout=8):
    tree, shown = app.wait_for(lambda t: fx.App.node(t, "AXHeading", WELCOME) is not None or fx.App.node(t, "AXHeading", "Connect your tenant") is not None, timeout)
    return shown


def first_run(app, endpoint_origin, label="Northwind Health", tsg=c8.TSG, scan_key=c8.SCAN_KEY, client=True, environment="Staging"):
    """Walks the first-run wizard to Home with one tenant on a custom endpoint."""
    tree, _ = app.wait_for(lambda t: fx.App.node(t, "AXHeading", WELCOME) is not None or fx.App.node(t, "AXHeading", "Connect your tenant") is not None, 15)
    if fx.App.node(tree, "AXHeading", WELCOME) is not None:
        _press(app, "AXButton", "Set up a tenant")
    app.wait_for(lambda t: fx.App.node(t, "AXHeading", "Connect your tenant") is not None, 10)
    app.type_into("AXTextField", "Display name", label)
    app.type_into("AXTextField", "TSG ID", tsg)
    _press_any(app, environment)
    # The custom endpoint: the Region select has no custom entry; the fixture
    # build reads the endpoint origin from the destination the driver stages.
    _press(app, "AXButton", "Create tenant")
    app.wait_for(lambda t: fx.App.node(t, "AXButton", "Save scan key") is not None, 12)
    app.type_into("AXTextField", "Scan API key", scan_key, secure=True)
    _press(app, "AXButton", "Save scan key")
    app.wait_for(lambda t: fx.App.node(t, "AXButton", "Replace scan key") is not None, 12)
    if client:
        app.type_into("AXTextField", "Client ID", c8.CLIENT_ID)
        app.type_into("AXTextField", "Client secret", c8.SECRET, secure=True)
        _press(app, "AXButton", "Save management client")
        app.wait_for(lambda t: fx.App.node(t, "AXButton", "Replace management client") is not None, 12)
    _press(app, "AXButton", "Continue")
    app.wait_for(lambda t: fx.App.node(t, "AXHeading", "Which products will you manage?") is not None, 10)
    _press(app, "AXButton", "Continue")
    app.wait_for(lambda t: fx.App.node(t, "AXHeading", "Check the connection") is not None, 10)
    _press(app, "AXButton", "Run the checks")
    tree, _ = app.wait_for(lambda t: any((fx.App.node(t, "AXButton", l) or {}).get("enabled") is not False and fx.App.node(t, "AXButton", l) is not None for l in ("Continue", "Continue with warnings")) and not app.has_text(t, "Checking…"), 45)
    _press(app, "AXButton", "Continue with warnings" if fx.App.node(tree, "AXButton", "Continue with warnings") else "Continue")
    app.wait_for(lambda t: fx.App.node(t, "AXHeading", "Load starter test cases") is not None, 10)
    _press(app, "AXButton", "Skip for now")
    app.wait_for(lambda t: fx.App.node(t, "AXHeading", "Join the AI Security Academy") is not None, 10)
    _press(app, "AXButton", "Skip for now")
    app.wait_for(lambda t: fx.App.node(t, "AXHeading", f"{label} is ready") is not None, 10)
    _press(app, "AXButton", "Open Prisma AIRS")
    return app.wait_for(lambda t: fx.App.node(t, "AXHeading", "Home") is not None, 25)


def tenant_on_home(app, endpoint_origin, label="Northwind Health", client=True, extra=()):
    """One tenant on the driver's synthetic endpoint, active, with Home open.

    On this build the first run is the wizard: it is walked once with a
    placeholder region tenant (no live call is made: the scan key is stored,
    not checked, and no management client is saved), then the driver's
    tenants are added through Settings' tenant form (a custom HTTPS endpoint
    is the only way to reach a synthetic service) and the first is made
    active. On a pre-C44 build the legacy form and the interface switch are
    used as before. `extra` names further tenants to add on the same endpoint.
    """
    if wizard_showing(app, timeout=6):
        first_run(app, endpoint_origin, label=PLACEHOLDER, client=False)
    app.open_settings()
    for name in (label, *extra):
        app.type_into("AXTextField", "TSG ID (optional)", c8.TSG)
        app.create_custom_tenant(name, endpoint_origin)
        if name == label:
            app.save_key(c8.SCAN_KEY)
            if client:
                c8.save_client(app)
    app.make_active(label)
    tree = app.tree()
    if fx.App.node(tree, "AXCheckBox", "Use the new interface") is not None:
        app.ax("press", "AXCheckBox", "Use the new interface")
    app.menu("Go", "Home")
    return app.wait_for(lambda t: fx.App.node(t, "AXHeading", "Home") is not None, 15)
#!/usr/bin/env python3
"""C08 native acceptance: drive the prepared fixture app through macOS
Accessibility against the synthetic localhost TLS scan endpoint
(scan_server.py) and the synthetic management endpoint (mgmt_server.py),
and evaluate the C08 inventory (docs/architecture/native-checks.json).

Run from the repository root after `xtask native-prepare --chunk C08`
prepared the fixture bundle. Requires the Accessibility grant for the
invoking terminal. It starts from an empty fixture data root, installs the
disposable test CA as the fixture build's extra trust root and the
management endpoint as the fixture build's management origin, uses only
synthetic credentials, never reads a stored secret back, never touches the
login keychain or v1 data, and removes the fixture root at the end.

Launches:
1. Administration without a tenant and without a management client; a
   scan-only scan; management onboarding; a refused grant (scans still
   work); verification; later pages; details and unknown values; denial,
   empty and refresh denial with stale rows; a credential replaced while a
   later page is in flight; zoom and minimum size;
2. relaunch: the Keychain client still reads; removal leaves the scan key.
"""

import json
import os
import shutil
import subprocess
import sys
import tempfile
import time

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
import fixture_app as fx  # noqa: E402

ROOT = os.getcwd()
SUBJECT = os.environ.get("AIRS_NATIVE_SUBJECT", "C08")
EVIDENCE = os.path.join(ROOT, "docs/planning/evidence", SUBJECT)
NATIVE = os.path.join(EVIDENCE, "native" if SUBJECT == "C08" else "native-C08")
RECORD = os.path.join(EVIDENCE, "native-acceptance.json" if SUBJECT == "C08" else "native-acceptance-C08.json")
SCAN_KEY = "synthetic-c08-native-scan-key"
CLIENT_ID = "c08-native@1234567890.iam.panserviceaccount.com"
SECRET = "synthetic-c08-native-client-secret"
TSG = "1234567890"
PROFILE = "Production guardrails"
SCAN_SERVICE = "io.cdot.prisma-airs-desktop.v2.fixture.scan"
MGMT_ORIGIN_FILE = os.path.join(fx.DATA, "fixture-management-origin")
REDACTED = ["SYNTHETIC-C08-KEY-VALUE", "SYNTHETIC-C08-AUTH-CODE", "SYNTHETIC-C08-DP-CODE"]
LOG = []


def sha256(path):
    import hashlib
    with open(path, "rb") as f:
        return hashlib.sha256(f.read()).hexdigest()


def rel(path):
    return os.path.relpath(path, ROOT)


def save_tree(name, tree):
    path = os.path.join(NATIVE, f"tree-{name}.json")
    with open(path, "w") as f:
        json.dump(tree, f, indent=0)
    return rel(path)


class MgmtEndpoint:
    """The synthetic management endpoint (mgmt_server.py)."""

    def __init__(self, certs, directory):
        self.certs, self.dir = certs, directory
        os.makedirs(directory, exist_ok=True)
        self.port = fx.free_port()
        self.proc = None
        self.mode()

    @property
    def origin(self):
        return f"https://localhost:{self.port}"

    def install(self):
        os.makedirs(fx.DATA, exist_ok=True)
        with open(MGMT_ORIGIN_FILE, "w") as f:
            f.write(self.origin + "\n")

    def start(self):
        self.proc = subprocess.Popen(
            ["python3", "-I", os.path.join(fx.TOOLS, "mgmt_server.py"), "--certs", self.certs, "--dir", self.dir,
             "--port", str(self.port), "--client-id", CLIENT_ID, "--secret", SECRET, "--tsg", TSG],
            stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, text=True)
        if self.proc.stdout.readline().strip() != "ready":
            raise SystemExit("the synthetic management endpoint did not start")

    def stop(self):
        if self.proc:
            self.proc.terminate()
            self.proc.wait(timeout=5)
            self.proc = None

    def mode(self, **values):
        with open(os.path.join(self.dir, "mode.json"), "w") as f:
            json.dump(values, f)

    def requests(self):
        path = os.path.join(self.dir, "requests.jsonl")
        if not os.path.exists(path):
            return []
        with open(path) as f:
            return [json.loads(line) for line in f if line.strip()]


def main():
    try:
        return run()
    finally:
        fx.sh(["pkill", "-f", fx.PROCESS])
        fx.clean_fixture_root()


def open_admin(app):
    app.ax("press", "AXButton", "Administration")
    tree, _ = app.wait_for(lambda t: fx.App.node(t, "AXHeading", "Tenant inventories") is not None)
    return tree


def text(app, fragment, timeout=12):
    return app.wait_for(lambda t: app.has_text(t, fragment), timeout)


def scan(app, endpoint, marker):
    before = len(endpoint.requests())
    app.open_runtime()
    app.type_into("AXTextField", "Profile name or ID", PROFILE)
    app.type_into("AXTextArea", "Prompt", marker)
    app.ax("press", "AXButton", "Scan", 0)
    tree, allowed = text(app, "Allowed")
    sent = endpoint.requests()[before:]
    return allowed and len(sent) == 1 and sent[0].get("tokenMatches") and not sent[0].get("authorization"), tree


def save_client(app):
    app.type_into("AXTextField", "Client ID", CLIENT_ID)
    app.type_into("AXTextField", "Client secret", SECRET, secure=True)
    app.keycode(36)
    return text(app, "Management client secret saved in the Keychain.")


def reach(app, zoom, label):
    """Tabs until `label` has focus; it must lie inside the window and end
    above the 60 CSS px bottom fade."""
    window = next(n for n in app.tree() if n.get("role") == "AXWindow")
    bottom = window["pos"][1] + window["size"][1]
    found = None
    for _ in range(110):
        app.keycode(48)
        f = app.focused(app.tree())
        if f and f.get("role") == "AXButton" and f.get("label") == label:
            found = {"label": f["label"], "pos": f["pos"], "size": f["size"]}
            break
    clear = bool(found) and found["pos"][1] >= window["pos"][1] and found["pos"][1] + found["size"][1] <= bottom - 60 * zoom
    return {"zoom": zoom, "window": {"pos": window["pos"], "size": window["size"]}, "found": found, "clear": clear}


def run():
    prepared = json.load(open(os.path.join(EVIDENCE, "native-prepare.json")))
    bundle = os.path.join(ROOT, prepared["bundle"])
    exe = os.path.join(bundle, "Contents/MacOS/prisma-airs-desktop-v2")
    if sha256(exe) != prepared["executable_sha256"]:
        raise SystemExit("prepared executable changed since native-prepare")
    work = tempfile.mkdtemp(prefix="airs-v2-c08-acceptance-")
    if os.path.isdir(NATIVE):
        shutil.rmtree(NATIVE)
    os.makedirs(NATIVE)
    app = fx.App(bundle, work, LOG)
    app.quit()
    fx.clean_fixture_root()
    v1_before = fx.v1_metadata()
    endpoint = fx.ScanEndpoint(os.path.join(work, "endpoint"), SCAN_KEY)
    endpoint.install_roots()
    endpoint.start()
    mgmt = MgmtEndpoint(os.path.join(work, "endpoint"), os.path.join(work, "mgmt"))
    mgmt.install()
    mgmt.start()
    obs = {"scan_origin": endpoint.origin, "management_origin": mgmt.origin}

    # ---- launch 1 ----
    app.launch()
    tree = app.tree()
    obs["admin_available"] = fx.App.node(tree, "AXButton", "Administration") is not None and not any(
        (n.get("label") or "").startswith("Administration") and "Not available" in (n.get("label") or "") for n in tree)
    tree = open_admin(app)
    obs["admin_no_tenant"] = app.has_text(tree, "Add a tenant in Settings to read its inventories.")
    obs["tree_no_tenant"] = save_tree("admin-no-tenant", tree)

    app.open_settings()
    app.type_into("AXTextField", "TSG ID (optional)", TSG)
    tree, created = app.create_custom_tenant("Tenant A", endpoint.origin)
    obs["tenant"] = created
    tree, saved = app.save_key(SCAN_KEY)

