import { forwardRef, type ReactNode, useCallback, useEffect, useRef, useState } from 'react'
import { createPortal } from 'react-dom'
import type { AdminProduct, AdminTab, DesktopClient, FeatureId, ManagementResource, ProductReadState, ShellSnapshot } from '@prisma-airs/desktop-contracts'
import { CHANGE_NOUN, type ChangeTarget, verbOf } from '../../features/administration/runtime-changes'
import type { Dispatch } from '../../features/tenants/dispatch'
import type { Act } from '../inbox/inbox'
import { type Arrival, useShellStore } from '../store'
import { SHELL_COPY } from '../copy'
import { Verdict } from '../verdict'
import { ADMIN_COPY as C } from './copy'
import { ReviewSheet } from './review-sheet'
import { InventoryTable } from './inventory-table'
import { Playground } from './playground'
import { type PillTone, ProductCard } from './product-card'
import { RuntimeOverview } from './runtime-overview'
import { GatewayProduct, type GatewayTabId } from './gateway-tabs'
import { ObservationProduct } from './observation-tabs'
import type { GlyphName } from '../icons'
import { Btn } from '../controls'

export interface AdministrationProps {
    snapshot: ShellSnapshot
    dispatch: Dispatch
    client: DesktopClient
    onAct: Act
    onNavigate: (feature: FeatureId) => void
    arrival: Arrival | null
}

const DLP: ManagementResource[] = ['dataPatterns', 'dictionaries', 'dataProfiles', 'filteringProfiles', 'dlpCatalog']
const DLP_LABEL: Record<string, string> = {
    dataPatterns: 'Data patterns',
    dictionaries: 'Dictionaries',
    dataProfiles: 'Data profiles',
    filteringProfiles: 'Data filtering profiles',
    dlpCatalog: 'DLP profiles (AIRS)',
}
const DLP_KIND: Partial<Record<ManagementResource, string>> = {
    dataPatterns: 'dataPatterns',
    dictionaries: 'dictionaries',
    dataProfiles: 'dataProfiles',
    filteringProfiles: 'filteringProfiles',
}
interface Sheet {
    change: ChangeTarget | null
    rotation: string | null
    onDraft?: (body: string) => void
    note?: ReactNode
}

/**
 * Administration (C31, screens/reviews-administration.md): the accordion of
 * the products in `AdminInventory`, each tab rendered by its disposition.
 * Read and Change tabs render the retained views (the same reads and
 * reviewed changes), with the inventory's labels for exactly its actions;
 * Unavailable tabs and products show their gate and nothing else; Removed
 * tabs are not rendered. Every change opens the review sheet; a key rotation
 * follows the core's staged sequence there.
 */
export const Administration = forwardRef<HTMLHeadingElement, AdministrationProps>(function Administration(
    { snapshot, dispatch, client, onAct, onNavigate, arrival },
    ref
) {
    const tenant = snapshot.tenants.find((t) => t.id === snapshot.active?.tenant) ?? null
    const context = snapshot.active?.context ?? null
    const products = snapshot.administration?.products ?? []
    const [open, setOpen] = useState<Record<string, boolean>>({
        runtimeSecurity: true,
    })
    const [tabOf, setTabOf] = useState<Record<string, string>>({
        runtimeSecurity: 'custom-topics',
        gateway: 'routes',
        redTeam: 'scans',
        modelSkill: 'skill-scans',
    })
    const [dlp, setDlp] = useState<ManagementResource>('dataPatterns')
    const [sheet, setSheet] = useState<Sheet | null>(null)
    const observe = useCallback((operation: string) => client.observeManagement(operation), [client])

    // A Harness proposal the operator opened into a review (C21) arrives
    // here: the sheet shows its exact draft under the native review, on the
    // product and tab of its kind; typed confirmation and native approval
    // still apply, and leaving the sheet discards the review.
    const review = snapshot.changes.review
    const proposed = snapshot.harness.conversation?.proposals.find((p) => p.state === 'inReview' && review !== null && p.review === review.review) ?? null
    const shownProposal = useRef<string | null>(null)
    useEffect(() => {
        if (!proposed || shownProposal.current === proposed.review) return
        shownProposal.current = proposed.review
        const d = proposed.draft
        for (const p of products) {
            const t = p.tabs.find((x) => x.disposition.kind === 'change' && x.actions.some((a) => a.kind === d.kind))
            if (!t) continue
            setOpen((o) => ({ ...o, [p.id]: true }))
            setTabOf((s) => ({ ...s, [p.id]: t.id }))
            if (DLP.includes(d.kind as ManagementResource)) setDlp(d.kind as ManagementResource)
            break
        }
        setSheet({
            change: {
                kind: d.kind,
                action: d.action,
                target: d.target,
                title: `Proposed by the Harness: ${verbOf(d.kind, d.action).toLowerCase()} ${CHANGE_NOUN[d.kind]}${d.target ? ` ${d.target}` : ''}`,
                body: d.body,
            },
            rotation: null,
        })
        // eslint-disable-next-line react-hooks/exhaustive-deps -- once per opened proposal review
    }, [proposed])

    // A Runtime case opened in the Playground from Test Cases (C33): Runtime
    // Security's Playground tab, filled with the case.
    const playground = useShellStore((s) => s.playground)
    useEffect(() => {
        if (!playground || playground.tenant !== tenant?.id) return
        const tab = products.find((p) => p.id === 'runtimeSecurity')?.tabs.find((t) => t.label === 'Playground')
        if (!tab) return
        setOpen((o) => ({ ...o, runtimeSecurity: true }))
        setTabOf((s) => ({ ...s, runtimeSecurity: tab.id }))
        // eslint-disable-next-line react-hooks/exhaustive-deps -- once per handed case
    }, [playground?.prefill.nonce, products.length])

    // An arrival is consumed once, when its target is in the inventory (C35 attempt-02 R1):
    // a fresh snapshot never re-applies it over what the operator chose since. The rail's
    // product children and the tenant menu's "Change Gateway workspace…" name a product
    // (and a tab); a contextual action (Inbox, Home) names a Runtime inventory (C30).
    const consumedArrival = useRef<number | null>(null)
    useEffect(() => {
        if (!arrival || consumedArrival.current === arrival.sequence) return
        if (arrival.product) {
            const product = products.find((p) => p.id === arrival.product)
            if (!product) return
            consumedArrival.current = arrival.sequence
            setOpen((o) => ({ ...o, [product.id]: true }))
            const tab = arrival.tab ? product.tabs.find((t) => t.id === arrival.tab && t.disposition.kind !== 'removed') : undefined
            if (tab) setTabOf((s) => ({ ...s, [product.id]: tab.id }))
            return
        }
        if (!arrival.resource) {
            consumedArrival.current = arrival.sequence
            return
        }
        const resource = arrival.resource
        const runtime = products.find((p) => p.id === 'runtimeSecurity')
        const tab = runtime?.tabs.find((t) => t.resource === resource) ?? (DLP.includes(resource) ? runtime?.tabs.find((t) => t.label === 'DLP') : undefined)
        if (!tab) return
        consumedArrival.current = arrival.sequence
        setOpen((o) => ({ ...o, runtimeSecurity: true }))
        setTabOf((s) => ({ ...s, runtimeSecurity: tab.id }))
        if (DLP.includes(resource)) setDlp(resource)
    }, [arrival, products])

    if (!tenant || !context) {
        return (
            <section aria-labelledby='administration-heading' data-slot='administration-v2'>
                <h1 ref={ref} id='administration-heading' tabIndex={-1} className='font-bold' style={{ fontSize: 'var(--v2-title)' }}>
                    {C.title}
                </h1>
                <p className='mt-2 text-[13px]'>{C.noTenant}</p>
            </section>
        )
    }

    const labelsOf = (tab: AdminTab, kind?: string) =>
        Object.fromEntries(tab.actions.filter((a) => !kind || a.kind === kind).map((a) => [a.action, a.label])) as Partial<Record<ChangeTarget['action'], string>>

    function body(product: AdminProduct, tab: AdminTab) {
        if (tab.disposition.kind === 'unavailable') {
            return (
                <div data-slot='admin-unavailable' className='rounded-[12px] border p-4 text-[13px]' style={{ borderColor: 'var(--v2-rule)' }}>
                    <Verdict tone='info' word={C.unavailableTab} />
                    <p className='mt-2' style={{ color: 'var(--v2-soft)' }}>
                        {tab.disposition.reason}
                    </p>
                </div>
            )
        }
        const key = `${context}-${product.id}-${tab.id}`
        if (product.id === 'runtimeSecurity') {
            if (tab.label === 'Overview')
                return (
                    <RuntimeOverview
                        snapshot={snapshot}
                        onRead={() =>
                            void onAct(SHELL_COPY.readOf(tenant!.label), {
                                kind: 'readTenant',
                                context: context!,
                            })
                        }
                    />
                )
            if (tab.label === 'Playground') {
                // A case handed over from Test Cases fills the form (C33); the operator runs it.
                const handed = playground && playground.tenant === tenant!.id ? playground : null
                return <Playground key={key} snapshot={snapshot} dispatch={dispatch} onNavigate={onNavigate} prefill={handed?.prefill ?? null} caseId={handed?.caseId ?? null} />
            }
            const resource = (tab.label === 'DLP' ? dlp : tab.resource) as ManagementResource | null
            if (!resource) return null
            return (
                <div className='flex flex-col gap-3'>
                    {tab.label === 'DLP' ? (
                        <div role='radiogroup' aria-label={C.dlpResources} className='flex flex-wrap rounded-[8px] self-start' style={{ gap: 2, padding: 2, background: 'var(--v2-inset)' }} data-slot='dlp-resources'>
                            {DLP.map((r) => (
                                <button
                                    key={r}
                                    type='button'
                                    role='radio'
                                    aria-checked={dlp === r}
                                    onClick={() => setDlp(r)}
                                    className='h-7 min-h-0 rounded-[6px] px-3 text-[12px] font-semibold'
                                    style={{
                                        background: dlp === r ? 'var(--v2-paper)' : 'transparent',
                                        boxShadow: dlp === r ? '0 1px 2px rgba(0,0,0,0.12)' : 'none',
                                        color: 'var(--v2-ink)',
                                    }}
                                >
                                    {DLP_LABEL[r]}
                                </button>
                            ))}
                        </div>
                    ) : null}
                    <InventoryTable
                        key={`${key}-${resource}`}
                        snapshot={snapshot}
                        context={context!}
                        dispatch={dispatch}
                        observe={observe}
                        resource={resource}
                        arrival={arrival && arrival.resource === resource ? arrival : null}
                        labels={labelsOf(tab, tab.label === 'DLP' ? DLP_KIND[resource] : undefined)}
                        admitted={tab.actions}
                        onReview={(change) => setSheet({ change, rotation: null })}
                        rotations={snapshot.rotations}
                        onFinishRotation={(application) => setSheet({ change: null, rotation: application })}
                    />
                </div>
            )
        }
        if (product.id === 'gateway') {
            return (
                <GatewayProduct
                    key={`${context}-gateway`}
                    snapshot={snapshot}
                    context={context!}
                    dispatch={dispatch}
                    observe={observe}
                    onNavigate={onNavigate}
                    tab={tab.id as GatewayTabId}
                    actions={tab.actions}

    return (
        <div data-v2-shell='' className='flex h-screen overflow-hidden'>
            <nav
                data-v2-rail=''
                aria-label={SHELL_COPY.navLabel}
                aria-hidden={modalOpen ? true : undefined}
                inert={modalOpen ? true : undefined}
                // The prototype reserves 14px above the tenant button for the window's traffic lights, which this
                // window's own title bar carries; the rail starts under it (noted in the parity notes).
                className='flex h-screen shrink-0 flex-col overflow-y-auto'
                style={{ width: 'var(--v2-rail)', padding: '12px 10px 12px', background: 'var(--v2-side)', borderRight: '1px solid var(--v2-rule)' }}
            >
                <TenantSwitcher snapshot={snapshot} onSwitch={props.onSwitchTenant} onAdd={() => setAdding(true)} onNavigate={props.onNavigate} onChangeWorkspace={changeWorkspace} />
                <ul className='flex flex-grow flex-col overflow-y-auto overscroll-contain' style={{ gap: 2, minHeight: 0 }} data-slot='nav-list'>
                    {snapshot.features
                        .filter((f) => f.sidebar)
                        .map((f) => {
                            const glyph = FEATURE_GLYPHS[f.id] ?? 'chevR'
                            const current = f.id === feature.id
                            const unavailable = f.availability.state === 'unavailable'
                            const reason = f.availability.state === 'unavailable' ? f.availability.reason : ''
                            const isAdmin = f.id === 'administration'
                            const badge = f.id === 'inbox' && needing.length > 0 ? String(needing.length) : ''
                            return (
                                <li key={f.id} className='flex flex-col' style={{ gap: 1 }}>
                                    <div className='flex items-center' style={{ gap: 2 }}>
                                        <button
                                            type='button'
                                            aria-current={current ? 'page' : undefined}
                                            aria-disabled={unavailable || undefined}
                                            aria-describedby={unavailable ? `${f.id}-hint` : undefined}
                                            title={unavailable ? SHELL_COPY.unavailableHint(reason) : f.shortcut !== null ? `${f.label} (⌘${f.shortcut})` : f.label}
                                            onClick={() => !unavailable && props.onNavigate(f.id)}
                                            data-inset-focus=''
                                            className='flex h-[34px] min-h-0 flex-grow items-center rounded-[8px] px-2.5 text-left text-[13px]'
                                            style={{ ...navRow(current, unavailable), gap: 9, fontWeight: current ? 600 : 500 }}
                                        >
                                            <Glyph name={glyph} size={16} color={current ? 'var(--v2-sel-ink)' : 'var(--v2-soft)'} />
                                            <span data-v2-label className='flex-grow truncate'>
                                                {f.label}
                                            </span>
                                            {badge && (
                                                <span
                                                    data-v2-label
                                                    data-slot='nav-badge'
                                                    aria-label={SHELL_COPY.needAction(needing.length)}
                                                    className='grid h-[18px] min-w-[18px] place-items-center rounded-full px-[5px] text-[11px] font-bold'
                                                    style={{ background: current ? 'rgba(255,255,255,0.22)' : 'var(--v2-acc)', color: current ? 'var(--v2-sel-ink)' : 'var(--v2-acc-ink)' }}
                                                >
                                                    {badge}
                                                </span>
                                            )}
                                            {f.shortcut !== null && (
                                                <kbd data-v2-label className='text-[12px]' aria-label={`Command ${f.shortcut}`} style={{ color: current ? 'var(--v2-sel-ink)' : 'var(--v2-faint)', opacity: current ? 0.85 : 1 }}>
                                                    ⌘{f.shortcut}
                                                </kbd>
                                            )}
                                        </button>
                                        {isAdmin && adminAvailable && productsKnown && (
                                            <button
                                                type='button'
                                                data-v2-collapse=''
                                                aria-expanded={adminNavOpen}
                                                aria-label={SHELL_COPY.productsToggle}
                                                aria-controls='v2-nav-products'
                                                onClick={() => setAdminNav(!adminNavOpen)}
                                                className='grid h-[34px] min-h-0 w-6 shrink-0 place-items-center rounded-[6px]'
                                                style={{ background: 'transparent', color: 'var(--v2-faint)' }}
                                            >
                                                <Glyph name={adminNavOpen ? 'chev' : 'chevR'} size={12} stroke={2.2} />
                                            </button>
                                        )}
                                    </div>
                                    {unavailable && (
                                        <span id={`${f.id}-hint`} className='sr-only'>
                                            {SHELL_COPY.unavailableHint(reason)}
                                        </span>
                                    )}
                                    {isAdmin && adminAvailable && productsKnown && adminNavOpen && (
                                        <ul id='v2-nav-products' aria-label={SHELL_COPY.productsLabel} data-slot='nav-products' data-v2-collapse='' className='flex flex-col' style={{ gap: 1, padding: '2px 0 4px 18px' }}>
                                            {products.map((p) => {
                                                const key = productOf(p.id)
                                                const count = key ? needing.filter((e) => e.product === key).length : 0
                                                const shown = current && productShown === p.id
                                                const gated = p.availability.state === 'unavailable'
                                                return (
                                                    <li key={p.id}>
                                                        <button
                                                            type='button'
                                                            aria-current={shown ? 'true' : undefined}
                                                            aria-disabled={gated || undefined}
                                                            title={p.availability.state === 'unavailable' ? p.availability.reason : p.label}
                                                            onClick={() => !gated && openProduct(p.id)}
                                                            className='flex h-[31px] min-h-0 w-full items-center gap-2 rounded-[7px] px-2 text-left text-[12.5px]'
                                                            style={{ background: shown ? 'var(--v2-inset)' : 'transparent', color: 'var(--v2-ink)', fontWeight: shown ? 600 : 400 }}
                                                        >
                                                            <Glyph name={PRODUCT_GLYPHS[p.id]} size={14} color='var(--v2-soft)' />
                                                            <span data-v2-label className='flex-grow truncate'>
                                                                {p.label}
                                                            </span>
                                                            {gated && (
                                                                <span data-v2-label className='rounded-full px-1.5 text-[12px] font-bold' style={{ padding: '1px 6px', background: 'var(--v2-acc-soft)', color: 'var(--v2-acc)' }}>
                                                                    {SHELL_COPY.newTag}
                                                                </span>
                                                            )}
                                                            {count > 0 && (
                                                                <span data-v2-label data-slot='product-badge' aria-label={SHELL_COPY.needAction(count)} className='text-[11px] font-semibold' style={{ color: 'var(--v2-faint)' }}>
                                                                    {count}
                                                                </span>
                                                            )}
                                                        </button>
                                                    </li>
                                                )
                                            })}
                                        </ul>
                                    )}
                                </li>
                            )
                        })}
                </ul>
                <div className='flex flex-col text-[12px]' data-slot='status-block' style={{ gap: 6, padding: '12px 10px 4px', marginTop: 8, borderTop: '1px solid var(--v2-rule)', color: 'var(--v2-soft)' }}>
                    <button
                        type='button'
                        data-v2-collapse=''
                        data-slot='connection'
                        data-tone={readStatus.tone}
                        title={`${readStatus.text} · ${HOME_COPY.readNow}`}
                        onClick={props.onReadNow}
                        disabled={!tenant}
                        className='flex min-h-0 w-full items-center rounded-[6px] text-left text-[12px]'
                        style={{ gap: 7, color: 'var(--v2-soft)' }}
                    >
                        <span aria-hidden='true' className='size-2 shrink-0 rounded-full' style={{ background: readStatus.tone === 'allowed' ? 'var(--v2-ok)' : readStatus.tone === 'blocked' ? 'var(--v2-block)' : readStatus.tone === 'flagged' ? 'var(--v2-flag)' : 'var(--v2-faint)' }} />
                        <span className='flex-grow'>{tenant ? SHELL_COPY.connected : SHELL_COPY.tenantNone}</span>
                        <span className='truncate text-right font-semibold' style={{ color: readStatus.tone === 'allowed' ? 'var(--v2-faint)' : readStatus.tone === 'info' ? 'var(--v2-faint)' : 'var(--v2-flag)' }}>
                            {readStatus.text}
                        </span>
                    </button>
                    {(
                        [
//! The desktop feature catalogue presented by the shell.
//!
//! Every product feature is listed with an explicit availability. A feature
//! is available only when its owning chunk has shipped; until then the shell
//! shows an unavailable destination naming the chunk, never a stub that looks
//! like working behavior.

use serde::{Deserialize, Serialize};
use ts_rs::TS;

/// Which desktop presentation the shell renders (D058). `Legacy` was the
/// C01 shell, removed in C44; `V2` is the "Refined Native" shell introduced
/// in C28 and the only one. The value stays on the wire for compatibility
/// (the snapshot always says `v2`; `Intent::SetUiVariant` is accepted and
/// ignored) and the persisted field is no longer read.
#[derive(Clone, Copy, Debug, Default, PartialEq, Eq, Hash, Serialize, Deserialize, TS)]
#[serde(rename_all = "camelCase")]
pub enum UiVariant {
    Legacy,
    #[default]
    V2,
}

/// First-run state of the v2 onboarding wizard (D058, C29 realises D013).
/// Persisted; it never moves back to `Needed`.
#[derive(Clone, Copy, Debug, Default, PartialEq, Eq, Hash, Serialize, Deserialize, TS)]
#[serde(rename_all = "camelCase")]
pub enum OnboardingState {
    #[default]
    Needed,
    InProgress,
    Done,
}

/// A product a tenant reads (C29, DESIGN-V2 §6): only products with an
/// admitted service exist here; AIS and AES are not admitted and have no id.
#[derive(Clone, Copy, Debug, PartialEq, Eq, Hash, Serialize, Deserialize, TS)]
#[serde(rename_all = "camelCase")]
pub enum ProductId {
    RuntimeSecurity,
    Gateway,
    RedTeam,
    ModelSkill,
}

/// A tenant's environment, chosen at setup (C29; prototype `env`).
#[derive(Clone, Copy, Debug, Default, PartialEq, Eq, Hash, Serialize, Deserialize, TS)]
#[serde(rename_all = "camelCase")]
pub enum TenantEnvironment {
    #[default]
    Production,
    Staging,
    Other,
}

/// Which wizard a setup runs in (C29).
#[derive(Clone, Copy, Debug, PartialEq, Eq, Hash, Serialize, Deserialize, TS)]
#[serde(rename_all = "camelCase")]
pub enum SetupMode {
    FirstRun,
    Add,
}

/// One verification line (C29, screens/wizard.md "Verify").
#[derive(Clone, Copy, Debug, PartialEq, Eq, Hash, Serialize, Deserialize, TS)]
#[serde(rename_all = "camelCase")]
pub enum VerifyLine {
    ScanKey,
    ManagementClient,
    Gateway,
    RedTeam,
    ModelSkill,
    /// Agentic Identity Security: listed as not available, never checked.
    Ais,
    /// Agentic Endpoint Security: listed as not available, never checked.
    Aes,
}

/// How a verification line ended. `Stored` is an explicit non-result: the
/// credential exists but no admitted read exercises it here.
#[derive(Clone, Copy, Debug, PartialEq, Eq, Hash, Serialize, Deserialize, TS)]
#[serde(rename_all = "camelCase")]
pub enum VerifyState {
    Pending,
    Pass,
    Warning,
    Fail,
    Stored,
    Skipped,
    /// No admitted service exists for this line (AIS, AES); never a result.
    Unavailable,
}

/// One streamed verification result (core-owned).
#[derive(Clone, Debug, PartialEq, Eq, Serialize, Deserialize, TS)]
#[serde(rename_all = "camelCase")]
pub struct VerifyStep {
    pub line: VerifyLine,
    /// The admitted product the line reports on; none for an unavailable
    /// product's line.
    pub product: Option<ProductId>,
    pub state: VerifyState,
    pub reason: String,
}

/// A warning a verification run produced for an admitted product.
#[derive(Clone, Debug, PartialEq, Eq, Serialize, Deserialize, TS)]
#[serde(rename_all = "camelCase")]
pub struct VerifyWarning {
    pub product: ProductId,
    pub reason: String,
}

/// The current verification run as the shell shows it.
#[derive(Clone, Debug, PartialEq, Eq, Serialize, Deserialize, TS)]
#[serde(rename_all = "camelCase")]
pub struct VerifyView {
    /// Counts runs; a later run replaces an earlier one's lines.
    pub generation: u32,
    pub steps: Vec<VerifyStep>,
    /// Every line has settled.
    pub done: bool,
    /// Some line failed.
    pub failed: bool,
    /// A required line failed (the scan key on first run): completion is
    /// refused. An optional line's failure is carried as a warning instead.
    pub blocking: bool,
    /// The inputs changed since this run started: it no longer counts.
    pub stale: bool,
    /// What completion records as the tenant's setup warnings: warning
    /// lines and failed optional lines.
    pub warnings: Vec<VerifyWarning>,
}

/// A starter pack: the bundled cases for one chosen product.
#[derive(Clone, Debug, PartialEq, Eq, Serialize, Deserialize, TS)]
#[serde(rename_all = "camelCase")]
pub struct PackView {
    pub product: ProductId,
    pub count: u32,
}

/// The tenant under setup (C29): a draft with its own context, not yet a
/// tenant. Absent when no wizard is open.
#[derive(Clone, Debug, PartialEq, Eq, Serialize, TS)]
#[serde(rename_all = "camelCase")]
pub struct SetupView {
    pub mode: SetupMode,
    /// The context credential and verify intents use for the draft.
    pub context: crate::context::ContextRef,
    /// The draft's profile and credential states (no secret material).
    pub tenant: crate::TenantView,
    pub products: Vec<ProductId>,
    /// First run requires the scan key; the add sheet does not.
    pub scan_required: bool,
    pub packs: Vec<PackView>,
    /// The Gateway workspace chosen for the draft, with the reference its
    /// inference key is configured under.
    pub workspace: Option<crate::authority::SelectedWorkspace>,
    pub verify: Option<VerifyView>,
    /// The current inputs were verified without a blocking failure:
    /// completion is admitted (optional failures travel as warnings).
    pub completable: bool,
}

/// A recorded verify warning for one tenant: the Inbox item type C29
/// defines and C30 renders (`InboxItem` kind `setupWarning`).
#[derive(Clone, Debug, PartialEq, Eq, Serialize, Deserialize, TS)]
#[serde(rename_all = "camelCase")]
pub struct SetupWarning {
    /// `vw-<n>`, unique within the tenant.
    pub id: String,
    pub product: ProductId,
    pub reason: String,
    /// Wall-clock seconds since the Unix epoch when it was recorded
    /// (`u32`: a JSON number, never a bigint, on the TypeScript side).
    pub recorded_secs: u32,
}

/// A Runtime API key named by its identifier and name (never a secret).
#[derive(Clone, Debug, PartialEq, Eq, Serialize, Deserialize, TS)]
#[serde(rename_all = "camelCase")]
pub struct KeyRef {
    pub id: String,
    pub name: String,
}

/// Whether the additional key's issuance was confirmed by readback (C31).
#[derive(Clone, Copy, Debug, PartialEq, Eq, Serialize, Deserialize, TS)]
#[serde(rename_all = "camelCase")]
pub enum RotationIssuance {
    Confirmed,
    /// The version settled unknown: a key is confirmed only once the key
    /// inventory shows one for the application besides the old key.
    Unconfirmed,
}

/// Where the old key's removal stands (C31).
#[derive(Clone, Debug, PartialEq, Eq, Serialize, Deserialize, TS)]
#[serde(tag = "state", rename_all = "camelCase")]
pub enum RotationRemoval {
    Pending,
    /// Sent but not read back absent: reconciled by a complete inventory.
    Unconfirmed,
    /// Refused or failed: the reminder stays, the completion time unset.
    Rejected {
        reason: String,
    },
    Done,
}

/// One Runtime API key rotation of a tenant (C31, I7), persisted so its two
/// timestamps are stored once and survive reads, switches and relaunches.
#[derive(Clone, Debug, PartialEq, Eq, Serialize, Deserialize, TS)]
#[serde(rename_all = "camelCase")]
pub struct Rotation {
    pub application: String,
    pub old_key: KeyRef,
    pub new_key: Option<KeyRef>,
    pub issuance: RotationIssuance,
    /// The change result that issued the key (its one-time secret lives
    /// there, for the context it was applied in, never here). Session-only:
    /// operation IDs restart with the core, so a relaunch never restores
    /// this link (a reused ID must not point at another key; C31).
    #[serde(skip)]
    #[ts(skip)]
    pub issued_by: Option<String>,
    /// The key name the issuing review named: the only key that can confirm
    /// an unconfirmed issuance.
    #[serde(default)]
    pub pending_name: Option<String>,
    pub issued_at: u32,
    /// The operator's local statement that the application uses the new key.
    pub deployment_acknowledged_at: Option<u32>,
    pub removal: RotationRemoval,
    /// When the old key was read back absent (remote readback).
    pub old_key_removed_at: Option<u32>,
}

/// Stable identifier of a top-level desktop feature destination.
#[derive(Clone, Copy, Debug, PartialEq, Eq, Hash, Serialize, Deserialize, TS)]
#[serde(rename_all = "camelCase")]
pub enum FeatureId {
    /// v2 only (C28): the tenant's Home.
    Home,
    /// v2 only (C28): the Inbox.
    Inbox,
    Runtime,
    Academy,
    Administration,
    Sessions,
    Library,
    RedTeam,
    ApiClient,
    Gateway,
    Harness,
    Import,
    Settings,
}

/// Whether a destination is usable in this build.
#[derive(Clone, Debug, PartialEq, Eq, Serialize, TS)]
#[serde(tag = "state", rename_all = "camelCase")]
pub enum Availability {
    Available,
    /// Not implemented yet; `plannedChunk` names the owning chunk.
    #[serde(rename_all = "camelCase")]
    Unavailable {
        reason: String,
        planned_chunk: String,
    },
}

/// One navigation destination in the shell.
#[derive(Clone, Debug, PartialEq, Eq, Serialize, TS)]
#[serde(rename_all = "camelCase")]
pub struct FeatureEntry {
    pub id: FeatureId,
    pub label: String,
    pub availability: Availability,
    /// The native menu accelerator digit (⌘1–⌘9), when the destination has
    /// one. The menu, the sidebar and the palette all read this one value.
    pub shortcut: Option<u8>,
    /// Whether the v2 sidebar lists it; false entries stay reachable from
    /// the Go menu and the command palette.
    pub sidebar: bool,
}

impl FeatureEntry {
    fn available(id: FeatureId, label: &str, shortcut: Option<u8>, sidebar: bool) -> Self {
        Self {
            id,
            label: label.to_owned(),
            availability: Availability::Available,
            shortcut,
            sidebar,
        }
    }
}

/// The catalogue for a presentation, in navigation order: the single
/// inventory the native menu, the sidebar and the command palette read.
pub fn catalogue_for(variant: UiVariant) -> Vec<FeatureEntry> {
    match variant {
        UiVariant::Legacy => catalogue(),
        UiVariant::V2 => vec![
            FeatureEntry::available(FeatureId::Home, "Home", Some(1), true),
            // Listed with its shortcut from the start so ⌘2 never moves; the
            // Inbox view itself lands in C30 and is unavailable until then.
            FeatureEntry::available(FeatureId::Inbox, "Inbox", Some(2), true),
            FeatureEntry::available(FeatureId::Harness, "Harness", Some(3), true),
            FeatureEntry::available(FeatureId::Academy, "Academy", Some(4), true),
            FeatureEntry::available(FeatureId::Library, "Test Cases", Some(5), true),
            FeatureEntry::available(FeatureId::ApiClient, "API Client", Some(6), true),
            FeatureEntry::available(FeatureId::Administration, "Administration", Some(7), true),
            // Inside Administration's accordion in v2; still direct Go/palette
            // destinations so nothing the legacy shell reached is lost.
            FeatureEntry::available(FeatureId::Runtime, "Runtime Security", None, false),
            FeatureEntry::available(FeatureId::Gateway, "AI Gateway", None, false),
            FeatureEntry::available(FeatureId::RedTeam, "Red Team & Models", None, false),
            FeatureEntry::available(FeatureId::Sessions, "Sessions & Reports", None, false),
            FeatureEntry::available(FeatureId::Import, "Import from v1", None, false),
            FeatureEntry::available(FeatureId::Settings, "Settings", None, false),
        ],
    }
}

/// The first sidebar destination of a presentation: where a fresh session
/// lands and where navigation falls back after a variant change.
pub fn default_feature(variant: UiVariant) -> FeatureId {
    catalogue_for(variant)
        .into_iter()
        .find(|e| e.sidebar)
        .map(|e| e.id)
        .unwrap_or(FeatureId::Settings)
}

/// The catalogue shipped by this build, in navigation order.
pub fn catalogue() -> Vec<FeatureEntry> {
    // Runtime Security shipped in C03, Academy learning in C05, management
    // reads (Administration) in C08, Sessions & Reports in C11, the Case
    // Library in C12, Red Team and Model/skill observation in C13, API
    // Client projects and documents in C14, AI Gateway workspace and
    // configuration reads in C16, the native Harness in C19, and the
    // reviewed import of v1 work in C23.
    let mut entries = vec![
        FeatureEntry {
            id: FeatureId::Runtime,
            label: "Runtime Security".to_owned(),
            availability: Availability::Available,
            shortcut: Some(1),
            sidebar: true,
        },
        FeatureEntry {
            id: FeatureId::Academy,
            label: "Academy".to_owned(),
            availability: Availability::Available,
            shortcut: Some(2),
            sidebar: true,
        },
        FeatureEntry {
