   562	    it('V2-T20: every product and tab renders its disposition, its content, and exactly the admitted actions', async () => {
   563	        const { user } = await launch(fxAdmin({ gateway: GATEWAY }))
   564	        type Tab = (typeof INVENTORY.products)[number]['tabs'][number]
   565	        // The kind a tab shows first (DLP opens on data patterns, Gateway keys on service keys).
   566	        const kindOf = (productId: string, tab: Tab) =>
   567	            productId === 'gateway' ? tab.actions[0]?.kind : tab.label === 'DLP' ? 'dataPatterns' : (tab.resource ?? tab.actions[0]?.kind)
   568	        const creating = (b: HTMLElement) => /^(New |Provision )/.test(b.textContent ?? '')
   569	        for (const p of INVENTORY.products) {
   570	            const el = product(p.id)
   571	            if (p.availability.state === 'unavailable') {
   572	                expect(within(el).queryByRole('tablist')).toBeNull()
   573	                expect(within(el).queryByRole('table')).toBeNull()
   574	                continue
   575	            }
   576	            const header = within(el).getByRole('button', { name: new RegExp(p.label) })
