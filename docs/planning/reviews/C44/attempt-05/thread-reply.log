    tree, n1["relaunch_home"] = app.wait_for(lambda t: heading(t, "Home") is not None and heading(t, v2s.WELCOME) is None, 20)
    n1["relaunch_tenant"] = any((n.get("label") or "").startswith("Switch tenant: Northwind Health") for n in tree)
    app.menu("Go", "Administration")
    tree, n1["relaunch_admin"] = app.wait_for(lambda t: heading(t, "Administration") is not None and app.has_text(t, "Connected"), 25)
    obs["tree_relaunch"] = c29.save_tree("relaunch-administration", tree)
    n1["startup"] = {"sockets": sockets, "webkit_sampled": sum(1 for n in sampled.values() if "WebKit" in n), "log": rel(net_path)}
    obs["n1"] = n1
    app.quit()
    # The cumulative gate: every mapped driver's record on this same bundle (tools/native-acceptance/run_on_v2.py
    # files them under native/cumulative/<CNN>/), bound to the prepared executable; a missing, stale or failing one
    # fails C44-N01. The set is the drivers the legacy-script map names as replacements and the pre-P09 drivers it
    # keeps running on the one presentation (C10, C11; C23 retired by D060).
    cumulative = {}
    for chunk in CUMULATIVE:
        path = os.path.join(EVIDENCE, "native", "cumulative", chunk, "native-acceptance.json")
        try:
            rec = json.load(open(path))
            cumulative[chunk] = {"record": rel(path), "bound": rec["app"]["executable_sha256"] == prepared["executable_sha256"],
                                 "checks": {c["id"]: c["result"] for c in rec["checks"]}, "recorded_utc": rec.get("recorded_utc")}
        except (OSError, ValueError, KeyError) as e:
            cumulative[chunk] = {"record": rel(path), "bound": False, "checks": {}, "missing": str(e)}
    obs["cumulative"] = cumulative

    run_path = os.path.join(NATIVE, "observations.json")
    with open(run_path, "w") as f:
        json.dump(json.loads(json.dumps({"observations": obs, "log": LOG}).replace(rel(NATIVE), rel(FINAL))), f, indent=1)
    run_rel = rel(run_path)
    inventory = {c["id"]: c["check"] for c in json.load(open(os.path.join(ROOT, "docs/architecture/native-checks.json")))["chunks"]["C44"]}
    checks = []
    dest = obs["destinations"]
    all_ok = all(d["opened"] and d.get("product_opened", True) and d["no_features_rail"] and d["destinations_rail"] and d["no_interface_switch"] and all(d["captures"].values()) for d in dest.values())
    # A record must be present and bound to this executable. Every check of a v2 driver must pass; of a self-run legacy
    # driver the checks the map keeps (its targets) must pass — a legacy check the map retires or supersedes (C24-N06,
    # the legacy cumulative matrix, is this check) is reported but not required.
    mapped_targets = {t for k, ts, _ in la.ASSERTIONS.values() if k in (la.X, la.S, la.P) for t in ts}
    self_run = {lid.split("-")[0] for lid, (k, _, _) in la.ASSERTIONS.items() if k == la.S}  # the legacy drivers that run themselves
    def record_ok(chunk, v):
        if not (v["bound"] and v["checks"]):
            return False
        required = [i for i in v["checks"] if i in mapped_targets] if chunk in self_run else list(v["checks"])
        return bool(required) and all(v["checks"][i] == "pass" for i in required)
    cumulative_ok = all(record_ok(k, v) for k, v in cumulative.items())
    carried = (n1["shortcut_inbox"] and n1["shortcut_settings"] and n1["reduced_motion_clamp"] and not n1["node_free"] and not n1["runtime_processes"]
               and not learner_hits and n1["relaunch_home"] and n1["relaunch_tenant"] and n1["relaunch_admin"]
               and n1["startup"]["sockets"] == 0 and n1["startup"]["webkit_sampled"] > 0)
    # Every legacy assertion the map keeps (exercised, self-run or ported) has its targets passing on this bundle;
    # a retirement carries its reason. C44-N01's own targets are this check's other facts.
    results_by_id = {i: r for v in cumulative.values() for i, r in v["checks"].items()}
    own_ok = n1["first_run_is_wizard"] and n1["no_features_rail_at_start"] and all_ok and not secret_hits and len(dest) == len(DESTINATIONS) and cumulative_ok and carried
    results_by_id["C44-N01"] = "pass" if own_ok else "fail"
    # A retirement is accepted only through the owner's record: the id listed in reviews/C44/legacy-retirements.md and
    # that record carrying the owner's acceptance line (not its pending placeholder).
    retire_path = os.path.join(ROOT, "docs/planning/reviews/C44/legacy-retirements.md")
    retire_text = open(retire_path).read() if os.path.exists(retire_path) else ""
    retire_accepted = bool(retire_text) and "ACCEPTANCE PENDING" not in retire_text and "## Acceptance" in retire_text
    retire_listed = set(re.findall(r"^\| (C\d\d-N\d\d) \|", retire_text, re.M))
    uncovered = []
    # The map must cover exactly the legacy manifest (attempt-04 O1): an unmapped check fails, never skipped.
    manifest = json.load(open(os.path.join(ROOT, "docs/architecture/native-checks.json")))["chunks"]
    legacy_ids = {c["id"] for k, v in manifest.items() if re.fullmatch(r"C(0[1-9]|1\d|2\d|3[0-3])", k) for c in v}
    uncovered += [f"{lid} (in the legacy manifest, not in the map)" for lid in sorted(legacy_ids - set(la.ASSERTIONS))]
    uncovered += [f"{lid} (in the map, not in the legacy manifest)" for lid in sorted(set(la.ASSERTIONS) - legacy_ids)]
    for lid, (kind, targets, note) in la.ASSERTIONS.items():
        if kind == la.R:
            if not note:
                uncovered.append(f"{lid} (retired without a reason)")
            elif lid not in retire_listed:
                uncovered.append(f"{lid} (retired but not in the owner's retirement record)")
            elif not retire_accepted:
                uncovered.append(f"{lid} (the retirement record is not accepted by the owner)")
        elif not targets or any(results_by_id.get(t) != "pass" for t in targets):
            uncovered.append(lid + " → " + ", ".join(t + " " + str(results_by_id.get(t, "not run")) for t in targets))
    from collections import Counter
    kinds = Counter(k for k, _, _ in la.ASSERTIONS.values())
    retire_summary = f"retirements accepted by the owner's record {retire_accepted} ({len(retire_listed)} listed in reviews/C44/legacy-retirements.md)"
    coverage_text = f"{retire_summary}; legacy assertions mapped: {len(la.ASSERTIONS)} ({kinds.get(la.X, 0)} exercised, {kinds.get(la.S, 0)} self-run, {kinds.get(la.P, 0)} ported, {kinds.get(la.R, 0)} retired with reasons); without a passing target on this bundle: {uncovered or 'none'}"
    obs["coverage"] = {"uncovered": uncovered, "kinds": dict(kinds)}
    cumulative_text = "; ".join(f"{k}: " + ("not run" if not v["checks"] else ("stale bundle; " if not v["bound"] else "") + ", ".join(f"{i} {r}" + ("" if i in mapped_targets or k not in self_run else " (not required: the map carries it elsewhere)") for i, r in v["checks"].items())) for k, v in cumulative.items())
    passed = own_ok and not uncovered
    checks.append({"id": "C44-N01", "description": inventory["C44-N01"], "result": "pass" if passed else "fail",
                   "observation": f"window requested 1440×900, got window {obs['geometry']['window']} viewport {obs['geometry']['viewport']} (the display's menu bar and the title bar take the rest); first run is the wizard {n1['first_run_is_wizard']} (no Features rail {n1['no_features_rail_at_start']}); "
                   + "; ".join(f"{k}: opened {v['opened']}" + (f", product {v.get('product_opened')}" if 'product_opened' in v else "") + f", no legacy rail {v['no_features_rail']}, Destinations {v['destinations_rail']}, no switch {v['no_interface_switch']}, captures {sorted(v['captures'])}" for k, v in dest.items())
                   + f"; plaintext secrets in any tree: {secret_hits}; learner chrome outside Academy: {learner_hits}; ⌘2 opened the Inbox {n1['shortcut_inbox']} and ⌘, Settings {n1['shortcut_settings']}; the built stylesheet carries the reduced-motion clamp {n1['reduced_motion_clamp']}; Node or JavaScript runtime files in the bundle: {n1['node_free']}; runtime processes beside the app: {n1['runtime_processes']}; after a relaunch Home with no wizard {n1['relaunch_home']}, the tenant active {n1['relaunch_tenant']}, Administration reading with the kept client {n1['relaunch_admin']}, internet sockets over 15 s of startup {n1['startup']['sockets']} (WebKit processes sampled {n1['startup']['webkit_sampled']}); cumulative records on this bundle: {cumulative_text}; {coverage_text}",
                   "evidence": [run_rel, obs["tree_relaunch"], n1["startup"]["log"]] + [v["tree"] for v in dest.values()] + [c for v in dest.values() for c in v["captures"].values() if c] + [v["record"] for v in cumulative.values() if v["checks"]]})

    hw = fx.sh(["sysctl", "-n", "hw.model"]).stdout.strip()
    os_ver = fx.sh(["sw_vers", "-productVersion"]).stdout.strip() + " (" + fx.sh(["sw_vers", "-buildVersion"]).stdout.strip() + ")"
    record = {
        "schema": "airs-v2/native-acceptance/1", "subject": "C44", "recorded_utc": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()), "method": "cua",
        "performed_by": "Claude Code driving the real fixture window through macOS Accessibility (System Events and the ax helper) with fixture WebView self-capture; tools/native-acceptance/acceptance_c44.py",
        "host": f"{hw}; macOS {os_ver}",
        "app": {"bundle": prepared["bundle"], "identifier": prepared["identifier"], "executable_sha256": prepared["executable_sha256"], "fixture": True},
        "checks": checks,
        "limitations": [
            "Pixels come from the fixture build's own WKWebView snapshot; the whole-app set under evidence/C44/parity/app is the app alone (C44 has no prototype board of its own).",
            "Synthetic scan and management endpoints only; the Academy destination is opened as a guest here (no Academy endpoint is staged for this driver; the Academy drivers C04–C07 stage their own and run in the cumulative set); Sessions & Reports is opened, not exercised here (acceptance_c11.py exercises it in the cumulative set); the alpha import is gone (D060).",
            "Spoken VoiceOver output was not recorded.",
        ],
    }
    screens = os.path.join(EVIDENCE, "screens")
    if os.path.isdir(screens):
        shutil.rmtree(screens)
    os.makedirs(screens, exist_ok=True)
    for name, variants in obs["captures"].items():
        for variant, src in variants.items():
            if src:
                shutil.copy(os.path.join(ROOT, src), os.path.join(screens, f"{name}-{variant}.png"))
    record["screens"] = sorted(os.listdir(screens))
    # The cumulative drivers' records (run_on_v2.py, before this driver) live under native/cumulative: they move
    # into the staged folder so the swap keeps them (the first cumulative run lost them here).
    kept = os.path.join(FINAL, "cumulative")
    if os.path.isdir(kept):
        shutil.move(kept, os.path.join(NATIVE, "cumulative"))
    if os.path.isdir(FINAL):
        shutil.rmtree(FINAL)
    os.rename(NATIVE, FINAL)
    staged_rel, final_rel = rel(NATIVE), rel(FINAL)
    for c in checks:
        c["evidence"] = [e.replace(staged_rel, final_rel) for e in c["evidence"]]
    NATIVE = FINAL
    with open(RECORD, "w") as f:
        json.dump(record, f, indent=2)
        f.write("\n")
    for c in checks:
        print(c["result"].upper(), c["id"], c["observation"][:220])
    return 0 if all(c["result"] == "pass" for c in checks) else 1


if __name__ == "__main__":
    sys.exit(main())
#!/usr/bin/env python3
"""Runs one native driver against the C44 bundle and files its record under
the C44 evidence (the cumulative P09 gate): `run_on_v2.py <cNN> [legacy]`.

The driver's own evidence paths (EVIDENCE/NATIVE/RECORD/PARITY) are
redirected to docs/planning/evidence/C44/native/cumulative/<CNN>/, where a
copy of C44's native-prepare.json binds the run to the same executable; a
pre-P09 driver (`legacy`) runs through legacy_v2 (the wizard's placeholder,
activate-on-create, the Go menu for the legacy sidebar entries).
"""

import importlib
import json
import os
import shutil
import sys

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))

ROOT = os.getcwd()
which = sys.argv[1]
legacy = len(sys.argv) > 2 and sys.argv[2] == "legacy"
chunk = which.upper()
out = os.path.join(ROOT, "docs/planning/evidence/C44/native/cumulative", chunk)
os.makedirs(out, exist_ok=True)
# An earlier run's record never stands for this one: removed before the driver starts, so a crashed run leaves no
# record (the gate reads a missing record as not run, never as the earlier bundle's result).
for stale in ("native-acceptance.json",):
    if os.path.exists(os.path.join(out, stale)):
        os.remove(os.path.join(out, stale))
shutil.copy(os.path.join(ROOT, "docs/planning/evidence/C44/native-prepare.json"), os.path.join(out, "native-prepare.json"))
if legacy:
    importlib.import_module("legacy_v2")
mod = importlib.import_module(f"acceptance_{which}")
mod.EVIDENCE = out
mod.NATIVE = os.path.join(out, "native")
mod.RECORD = os.path.join(out, "native-acceptance.json")
if hasattr(mod, "PARITY"):
    mod.PARITY = os.path.join(out, "parity")
# Trees and the copies of captures the shared helpers write go under this run too. c29.CAPTURES stays the
# fixture app's own capture folder (the system temp dir the app writes "Capture Window" files to): the first
# cumulative run redirected it and every v2 driver's first capture found nothing ("no capture for admin-light").
import acceptance_c29 as c29  # noqa: E402
c29.NATIVE = mod.NATIVE
code = mod.main()
try:
    r = json.load(open(mod.RECORD))
    print("RUN", chunk, [(c["id"], c["result"]) for c in r["checks"]])
except Exception as e:  # noqa: BLE001
    print("RUN", chunk, "no record", e)
sys.exit(code)
#!/usr/bin/env python3
"""Writes the assertion-level legacy-script map (C44): every native check a pre-P09 script recorded
(docs/architecture/native-checks.json), what it asserts, where it stands on the one presentation
(tools/native-acceptance/legacy_assertions.py: exercised by a v2 check, self-run through legacy_v2, ported into a v2
check, or retired with its reason) and the result of each target on the C44 bundle (native/cumulative/<CNN>/ for the
cumulative drivers, the root C44 record for C44-N01). Run from the repository root after the native stage; prints the
table and rewrites the table section of docs/planning/evidence/C44/legacy-script-map.md."""

import json
import os
import re
import sys
from collections import Counter

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
import legacy_assertions as la  # noqa: E402

ROOT = os.getcwd()
CHECKS = json.load(open(os.path.join(ROOT, "docs/architecture/native-checks.json")))["chunks"]
CUM = os.path.join(ROOT, "docs/planning/evidence/C44/native/cumulative")
ROOT_RECORD = os.path.join(ROOT, "docs/planning/evidence/C44/native-acceptance.json")
MAP = os.path.join(ROOT, "docs/planning/evidence/C44/legacy-script-map.md")
KIND = {la.X: "exercised", la.S: "self-run", la.P: "ported", la.R: "retired"}
LEGACY = [c for c in CHECKS if re.fullmatch(r"C(0[1-9]|1\d|2[0-9]|3[0-3])", c)]


def results(chunk):
    path = ROOT_RECORD if chunk == "C44" else os.path.join(CUM, chunk, "native-acceptance.json")
    try:
        rec = json.load(open(path))
        return {c["id"]: c["result"] for c in rec["checks"]}
    except (OSError, ValueError, KeyError):
        return {}


rows, missing_entries, counts = [], [], Counter()
for chunk in LEGACY:
    for c in CHECKS[chunk]:
        what = re.sub(r"\s+", " ", c["check"]).strip()
        if len(what) > 170:
            what = what[:167] + "…"
        entry = la.ASSERTIONS.get(c["id"])
        if entry is None:
            missing_entries.append(c["id"])
            rows.append((c["id"], what, "UNMAPPED", "—", "—"))
            continue
        kind, targets, note = entry
        counts[kind] += 1
        if kind == la.R:
            rows.append((c["id"], what, KIND[kind], note, "retired"))
        else:
            per = [f"{t} {results(t.split('-')[0]).get(t, 'not run')}" for t in targets]
            where = (", ".join(targets) + (f" — {note}" if note else "")) if targets else note
            rows.append((c["id"], what, KIND[kind], where, ", ".join(per) or "—"))

table = ["| Legacy check | What it asserts | Standing | Where it is asserted on the one presentation (or why it is retired) | Result on the C44 bundle |", "|---|---|---|---|---|"]
for r in rows:
    table.append("| " + " | ".join(x.replace("|", "\\|") for x in r) + " |")
summary = (f"{sum(counts.values())} legacy assertions: {counts.get(la.X, 0)} exercised by v2 checks, {counts.get(la.S, 0)} self-run through legacy_v2, "
           f"{counts.get(la.P, 0)} ported into v2 checks, {counts.get(la.R, 0)} retired with a reason"
           + (f"; UNMAPPED: {missing_entries}" if missing_entries else "") + ".")
text = summary + "\n\n" + "\n".join(table) + "\n"
print(text)
md = open(MAP).read()
start = md.index("## Every legacy assertion")
end = md.index("\n## ", start + 10) if "\n## " in md[start + 10:] else len(md)
md = (md[:start] + "## Every legacy assertion, where it stands now, and its result on this bundle\n\n"
      "Generated by `tools/native-acceptance/legacy_map.py` from `docs/architecture/native-checks.json`, `tools/native-acceptance/legacy_assertions.py` "
      "(the per-assertion standing: exercised, self-run, ported, retired) and the records under `native/cumulative/` and the root C44 record, after the native stage. "
      "A retirement names the suite that holds the behaviour where it survives in the core; that suite result does not stand in for a native assertion. "
      "The gate (`acceptance_c44.py`, C44-N01) fails when an exercised, self-run or ported assertion has a target missing or failing on this bundle.\n\n" + text + md[end:])
open(MAP, "w").write(md)
if missing_entries:
    sys.exit(1)

