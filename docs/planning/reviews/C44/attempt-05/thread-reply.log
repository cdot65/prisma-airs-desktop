#!/usr/bin/env python3 -I
"""Builds a by-hand review packet for a chunk: make-packet.py <chunk> <attempt> <run-record> [limitation...]
Scope = tracked files changed since the previous chunk commit + untracked files under the chunk's paths."""
import sys, json, hashlib, subprocess, os, time
chunk, attempt, record = sys.argv[1:4]
extra = sys.argv[4:]
A = f"docs/planning/reviews/{chunk}/{attempt}"
os.makedirs(A, exist_ok=True)
sha = lambda p: hashlib.sha256(open(p, 'rb').read()).hexdigest()
base = subprocess.check_output(["git", "rev-parse", "HEAD"], text=True).strip()
# BASE_REF: the commit the chunk's work is measured from (HEAD~1 when the chunk is already committed).
base_ref = os.environ.get("BASE_REF", "HEAD")
tracked = [l for l in subprocess.check_output(["git", "diff", "--name-only", base_ref, "--"], text=True).split() if os.path.exists(l)]
untracked = subprocess.check_output(["git", "ls-files", "--others", "--exclude-standard"], text=True).split()
# Exclude the owner's unrelated C26/academy work from scope: everything not under the chunk's declared paths.
own_prefixes = ("packages/desktop-contracts/src/generated/", f"docs/planning/evidence/{chunk}/", f"docs/planning/reviews/{chunk}/", "apps/desktop/src/v2/", "apps/desktop/src/styles/", "tools/parity/", f"docs/planning/evidence/{chunk}/runs/", "crates/desktop-core/tests/ui_v2_", "crates/desktop-core/src/authority/setup_domain.rs", "crates/desktop-core/src/authority/cases_domain.rs", "crates/desktop-core/src/authority/rotation_domain.rs", "crates/desktop-core/src/cases_inventory.rs", "tools/perf/measure_c", "tools/native-acceptance/acceptance_c", "apps/desktop/src/shell/feature-body", "apps/desktop/src/shell/presentation", "crates/desktop-core/tests/ui_v2_", "docs/planning/reviews/C28/", "packages/desktop-contracts/fixtures/wire/cases-lifecycle")
untracked = [u for u in untracked if u.startswith(own_prefixes)]
unrelated_mod = [t for t in tracked if t in json.load(open("docs/planning/evidence/C28/owner-work.json"))["modified"]] if os.path.exists("docs/planning/evidence/C28/owner-work.json") else []
force = [t for t in tracked if t in ("crates/xtask/src/budgets.rs", "crates/xtask/src/live_run.rs")]
# C37 (Inbox) was merged into this tree (merge commit C37_MERGE) so the cumulative gate can run its driver on the one
# presentation; its own gate stands at 9 (reviews/C37/attempt-03, worktree c37-inbox). Files the merge alone brought in
# are not this chunk's work and leave the scope; files this chunk also changed stay.
merges = os.environ.get("MERGES", os.environ.get("C37_MERGE", "")).split()
merge = " ".join(merges)
merged_only = set()
if merges:
    # Files the merged predecessor branches brought in and this branch never touched itself: the merges' second
    # parents' changes minus everything changed on the first-parent line (this chunk's own commits).
    first_parent = set(subprocess.check_output(["git", "log", "--first-parent", "--format=", "--name-only", f"{base_ref}..HEAD"], text=True).split())
    first_parent -= set(subprocess.check_output(["git", "diff", "--name-only", "--diff-filter=A", f"{base_ref}", f"{base_ref}"], text=True).split())
    theirs = set()
    for m in merges:
        theirs |= set(subprocess.check_output(["git", "diff", "--name-only", f"{m}^1", f"{m}^2"], text=True).split())
    own = set()
    for h in subprocess.check_output(["git", "log", "--first-parent", "--no-merges", "--format=%H", f"{base_ref}..HEAD"], text=True).split():
        own |= set(subprocess.check_output(["git", "show", "--format=", "--name-only", h], text=True).split())
    # A chunk fix can share a file with preserved owner edits. Attest the full compiled file in that case;
    # excluding the owner's path wholesale would also hide this chunk's committed application changes.
    force += [t for t in unrelated_mod if t in own]
    merged_only = theirs - own
# The attempt's own review artefacts (request, message, diff, inventory, the reviewer's reply) are written by this
# packet and after it: never part of the attested source (attempt-04 E1: a reused folder's earlier files were hashed).
own_review = {p for p in tracked + untracked if p.startswith(f"docs/planning/reviews/{chunk}/{attempt}/")}
scope = sorted((set(tracked + untracked) - set(unrelated_mod) - merged_only - own_review) | set(force))
inv = {p: sha(p) for p in scope}
source_fp = hashlib.sha256("".join(f"{p} {h}\n" for p, h in sorted(inv.items())).encode()).hexdigest()
run = json.load(open(record))
assert run["inputs"]["before_digest"] and run["inputs"]["before_digest"] == run["inputs"]["after_digest"], "run record inputs are empty or changed"
fps = {"source": source_fp, "dependencies": run["inputs"]["before_digest"], "build_flags": run["build_flags"]["digest"], "evidence": sha(record)}
diff = subprocess.check_output(["git", "diff", base_ref, "--"] + [t for t in tracked if t in scope], text=True)
open(f"{A}/diff.patch", "w").write(diff + "\n# Untracked files in scope:\n" + "\n".join("# + " + p for p in untracked) + "\n")
json.dump({"files": inv, "source_fingerprint": source_fp, "base_commit": base, "measured_from": subprocess.check_output(["git", "rev-parse", base_ref], text=True).strip(), "merged_only": sorted(merged_only), "merges": merges}, open(f"{A}/source-inventory.json", "w"), indent=2)
req_id = f"{chunk}-{attempt}-{int(time.time())}"
native = f"docs/planning/evidence/{chunk}/native-acceptance.json"
if os.path.exists(native):
    nrec = json.load(open(native)); prep = json.load(open(f"docs/planning/evidence/{chunk}/native-prepare.json"))
    assert nrec["app"]["executable_sha256"] == prep["executable_sha256"], "native record does not match the prepared executable"
    exe = os.path.join(prep["bundle"], "Contents/MacOS/prisma-airs-desktop-v2")
    assert sha(exe) == prep["executable_sha256"], "bundled executable changed since preparation"
    missing = [e for c in nrec["checks"] for e in c["evidence"] if not os.path.exists(e)]
    assert not missing, f"native evidence missing: {missing[:5]}"
    assert all(c["result"] == "pass" for c in nrec["checks"]), "native record has failures"
request = {"request_id": req_id, "attempt_id": attempt, "subject": chunk, "base_commit": base,
 "transport": "fresh codex exec fallback (read-only, ephemeral, ignore-user-config, ignore-rules, stdin closed), run by hand; see limitations",
 "scope": {"chunk_instruction": f"docs/planning/chunks/{chunk}.md", "specification": "docs/architecture/ui-v2/ (reviewed in C27, commit c0ac8b30); the frozen prototype docs/architecture/ui-v2/prototype/ is the visual specification under D059 (docs/planning/p09-recut.md)", "files": scope, "measured_from": subprocess.check_output(["git", "rev-parse", base_ref], text=True).strip(),
           "excluded_unrelated_user_work": "Modified paths not listed in scope belong to the owner's in-progress C26 attempt-02 and academy-2.1 work (see git status) and are out of scope."},
 "fingerprints": fps,
 "fingerprint_notes": f"dependencies = digest of the retained input inventory produced by docs/planning/evidence/{chunk}/runs/hash-inputs.sh (every compiled/tested/built input incl. lockfiles and the consumed Academy shared source; unchanged across the runs); build_flags = the run record's itemised configuration digest (checks, native-checks, toolchain, budgets, tauri configs, capabilities, rust-toolchain); evidence = sha256 of {record}, which binds every run log by hash.",
