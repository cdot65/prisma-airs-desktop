function WorkspaceKey({ tenant, selected, context, dispatch }: { tenant: ShellSnapshot['tenants'][number]; selected: NonNullable<ShellSnapshot['gateway']['selected']>; context: ContextRef; dispatch: Dispatch }) {
    const K = C.workspaceKey
    const ids = useId()
    const keyRef = useRef<HTMLInputElement>(null)
    const [endpoint, setEndpoint] = useState('')
    const [errors, setErrors] = useState<{ endpoint: string; key: string }>({ endpoint: '', key: '' })
    const [busy, setBusy] = useState(false)
    const [message, setMessage] = useState<string | null>(null)
    const key = tenant.inference
    const here = key.target !== null && key.target.workspace.id === selected.workspace.id
    const ready = key.state === 'ready' && here
    async function save(event: FormEvent<HTMLFormElement>) {
        event.preventDefault()
        const field = keyRef.current
        if (!field) return
        const secret = field.value
        field.value = ''
        setMessage(null)
        if (!/^https:\/\/\S+$/.test(endpoint.trim())) return setErrors({ endpoint: K.errors.endpoint, key: '' })
        if (!secret) return setErrors({ endpoint: '', key: K.errors.key })
        setErrors({ endpoint: '', key: '' })
        setBusy(true)
        try {
            const outcome = await dispatch({ kind: 'configureInferenceCredential', context, mode: 'keychain', workspace: selected.reference, endpoint: endpoint.trim(), secret })
            setMessage(outcome.kind === 'admitted' ? K.saved : (outcomeMessage(outcome) ?? 'That was not done.'))
            if (outcome.kind === 'admitted') setEndpoint('')
        } finally {
            setBusy(false)
        }
    }
    async function remove() {
        setMessage(null)
        setBusy(true)
        try {
            const outcome = await dispatch({ kind: 'removeInferenceCredential', context })
            setMessage(outcome.kind === 'admitted' ? K.removed : (outcomeMessage(outcome) ?? 'That was not done.'))
        } finally {
            setBusy(false)
        }
    }
    return (
        <form onSubmit={(e) => void save(e)} aria-labelledby={`${ids}-title`} className='flex flex-col rounded-[10px] border p-3' style={{ gap: 10, ...cardStyle }} data-slot='gateway-workspace-key'>
            <div className='flex flex-wrap items-baseline' style={{ gap: 10 }}>
                <h4 id={`${ids}-title`} className='text-[13px] font-bold'>
                    {K.title}
                </h4>
                <span className='text-[12px]' style={ready ? { color: 'var(--v2-ok)' } : faint} data-slot='gateway-workspace-key-state'>
                    {ready ? `${K.state.ready}${key.target?.endpoint ? ` · ${key.target.endpoint}` : ''}` : K.state[key.state] ?? K.state.missing}
                </span>
            </div>
            <p className='text-[12px]' style={faint}>
                {K.hint}
            </p>
            {key.state === 'ready' && key.target && !here ? (
                <p className='text-[12px]' style={faint}>
                    {K.otherWorkspace(key.target.workspace.name)}
                </p>
            ) : null}
            <label className='flex flex-col text-[12px]' style={{ gap: 4 }}>
                <span>{K.endpoint}</span>
                <Field aria-label={K.endpoint} value={endpoint} onChange={(e) => setEndpoint(e.target.value)} placeholder='https://' autoComplete='off' spellCheck={false} aria-invalid={errors.endpoint ? true : undefined} aria-describedby={`${ids}-endpoint-hint`} />
                <span id={`${ids}-endpoint-hint`} style={faint}>
                    {errors.endpoint || K.endpointHint}
                </span>
            </label>
            <label className='flex flex-col text-[12px]' style={{ gap: 4 }}>
                <span>{K.key}</span>
                <input
                    ref={keyRef}
                    type='password'
                    aria-label={K.key}
                    autoComplete='off'
                    aria-invalid={errors.key ? true : undefined}
                    className='h-8 min-h-0 rounded-[7px] border px-2.5 text-[13px]'
                    style={{ borderColor: 'var(--v2-ctl)', background: 'var(--v2-paper)', color: 'var(--v2-ink)' }}
                />
                {errors.key ? (
                    <span role='alert' style={{ color: 'var(--v2-flag)' }}>
                        {errors.key}
                    </span>
                ) : null}
            </label>
            <div className='flex flex-wrap' style={{ gap: 8 }}>
                <Btn tier='primary' type='submit' disabled={busy}>
                    {ready ? K.replace : K.save}
                </Btn>
                {key.state === 'ready' ? (
                    <Btn tier='tertiary' type='button' disabled={busy} onClick={() => void remove()}>
                        {K.remove}
                    </Btn>
                ) : null}
            </div>
            {message ? (
                <p role='status' className='text-[12px]'>
                    {message}
                </p>
            ) : null}
## Per-chunk execution contract

1. Read AGENTS/CLAUDE, glossary, accepted ADRs, the chunk, predecessor receipts,
   dependency manifest, test catalogue, and its canonical implementer prompt.
2. Confirm a clean approved source snapshot and identify unrelated user work.
   Resolve dependency availability/provenance and baseline check limitations.
3. Implement only that chunk and approved supporting changes. A shared Academy,
   SDK, or Harness change needs its own reviewed revision and regression evidence;
   preserve active work and do not move another project's main branch casually.
4. Run exact checks from the approved command manifest. Use deterministic local
   fixtures and literal external contracts, then the appropriate native tests.
   Never call hosted application endpoints by accident.
5. Record commands, environments, inputs, results, failures, hashes, limitations,
   and rollback rehearsal. Save raw sensitive evidence privately; commit redacted
   summaries with references/hashes, not credentials or customer bodies.
6. Freeze source and dependency inputs. Request actual independent Codex
   review through [the independent prompt](prompts/review-chunk.md) (D026).
7. If any critical dimension/overall score is below 9, required fixes remain,
   source changed, or mandatory evidence is absent: remediate, rerun affected
   checks, freeze a new snapshot, and request a new review of the same chunk.
8. Complete only after the receipt and evidence validate against current inputs.
   After a phase's last chunk, obtain the cumulative Codex phase review
   ([prompt](prompts/review-phase.md)) before starting the next phase.
   Make a focused commit; revalidate that its tree matches the reviewed tree.
   Later edits invalidate affected receipts and trigger targeted regression
   checks/re-review. Preserve failed attempts; never pressure a reviewer to pass.

# 4. Managed HTTP enters native configuration authority

Date: 2026-10-16. Status: selected following owner candidate selection; independent G01 verdict
and implementation readiness are tracked in planning/status.md. Implements D014,D016 and C14/C15 requirements.

V1's workbench has real request-document and transport depth. Its redactions-based
redirect guard is not explicit tenant-credential classification, Live mode lacks
application destination binding, and its post-401 retry can resend a mutation.
The stricter v2 review/no-replay policy must be enforced below every Send path.

Keep RequestDocument reconciliation separate. Native execution admission captures
a fresh immutable effective request and explicitly distinguishes tenant-managed,
workbench-owned and anonymous credentials. Known managed reads need capability/
destination admission. Known mutations need exact Configuration review. Unknown
managed methods/paths are denied, even if presented as a read or generic draft.
Ordinary workbench-owned/anonymous HTTP remains supported.

Replace the editable SCM collection-ID credential gate with native-owned
capability registration. Imported IDs/references cannot authorize tenant secret
resolution. An edited token_url/request URL is admitted against the explicit
credential destination before secrets are obtained; an ID change never creates
a capability. Preserve operator-reviewed endpoint configuration separately.

Bind review to expanded URL/method/headers/body and file hashes, variables,
cookies, credential/context/destination and resource classification. Recheck
before dispatch; changed input/context/files require fresh review. Rust constructs
the actual request; renderer fields cannot mark it preapproved.

Managed redirects are disabled initially: a 3xx is shown, and following it is a
new prepared/admitted request. Generic redirects preserve bounded cookie/credential
origin policy. No automatic workbench resend follows HTTP401, refresh, reconnect,
lost response, import or history replay. Refresh can precede a new explicit Send.

The built-in catalogue has 193 request specifications, 81 with mutation methods;
this is metadata parity, not a claim of dedicated/live-qualified product support.
Tests cover imported/edited requests, unknown managed endpoints, direct IPC bypass,
ambiguous paths/auth headers, same/cross-origin redirects, stale cookie/file/
variable/context bindings, double Apply and post-401/lost-response no resend.

This is a stricter v2 product contract, not an allegation that v1 failed its own
