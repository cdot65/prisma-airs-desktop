   737	 * discarded here; it is edited in the Playground.
   738	 */
   739	/**
   740	 * The chosen workspace's inference key (C18) on the one presentation (C44): its Keychain state from the tenant's
   741	 * snapshot, the endpoint and key fields, and Save or Replace (configureInferenceCredential, keychain) or Remove
   742	 * (removeInferenceCredential). The key is read back only as a state; the field is emptied as soon as it is sent.
   743	 */
   744	function WorkspaceKey({ tenant, selected, context, dispatch }: { tenant: ShellSnapshot['tenants'][number]; selected: NonNullable<ShellSnapshot['gateway']['selected']>; context: ContextRef; dispatch: Dispatch }) {
   745	    const K = C.workspaceKey
   746	    const ids = useId()
   747	    const keyRef = useRef<HTMLInputElement>(null)
   748	    const [endpoint, setEndpoint] = useState('')
   749	    const [errors, setErrors] = useState<{ endpoint: string; key: string }>({ endpoint: '', key: '' })
   750	    const [busy, setBusy] = useState(false)
   751	    const [message, setMessage] = useState<string | null>(null)
   752	    const key = tenant.inference
   753	    const here = key.target !== null && key.target.workspace.id === selected.workspace.id
   754	    const ready = key.state === 'ready' && here
   755	    async function save(event: FormEvent<HTMLFormElement>) {
   756	        event.preventDefault()
   757	        const field = keyRef.current
   758	        if (!field) return
   759	        const secret = field.value
   760	        field.value = ''
   761	        setMessage(null)
   762	        if (!/^https:\/\/\S+$/.test(endpoint.trim())) return setErrors({ endpoint: K.errors.endpoint, key: '' })
   763	        if (!secret) return setErrors({ endpoint: '', key: K.errors.key })
   764	        setErrors({ endpoint: '', key: '' })
   765	        setBusy(true)
   766	        try {
   767	            const outcome = await dispatch({ kind: 'configureInferenceCredential', context, mode: 'keychain', workspace: selected.reference, endpoint: endpoint.trim(), secret })
   768	            setMessage(outcome.kind === 'admitted' ? K.saved : (outcomeMessage(outcome) ?? 'That was not done.'))
   769	            if (outcome.kind === 'admitted') setEndpoint('')
   770	        } finally {
   771	            setBusy(false)
   772	        }
   773	    }
   774	    async function remove() {
   775	        setMessage(null)
   776	        setBusy(true)
   777	        try {
   778	            const outcome = await dispatch({ kind: 'removeInferenceCredential', context })
   779	            setMessage(outcome.kind === 'admitted' ? K.removed : (outcomeMessage(outcome) ?? 'That was not done.'))
   780	        } finally {
   781	            setBusy(false)
   782	        }
   783	    }
   784	    return (
   785	        <form onSubmit={(e) => void save(e)} aria-labelledby={`${ids}-title`} className='flex flex-col rounded-[10px] border p-3' style={{ gap: 10, ...cardStyle }} data-slot='gateway-workspace-key'>
   786	            <div className='flex flex-wrap items-baseline' style={{ gap: 10 }}>
   787	                <h4 id={`${ids}-title`} className='text-[13px] font-bold'>
   788	                    {K.title}
   789	                </h4>
