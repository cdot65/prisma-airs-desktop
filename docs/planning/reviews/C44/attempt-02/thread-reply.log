/// A document as the editor needs it.
#[derive(Clone, Debug, PartialEq, Eq, Serialize, TS)]
#[serde(rename_all = "camelCase")]
pub struct DocumentView {
    pub id: String,
    pub relative: String,
    pub revision: String,
    /// What the editor shows: the protected draft, else the saved fields.
    pub fields: Fields,
    pub saved: Fields,
    pub new: bool,
