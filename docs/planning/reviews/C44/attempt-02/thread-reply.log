"""The v2 tenant setup for native drivers (C44): the first run opens the
wizard (there is one presentation), so a driver that needs a tenant walks
the wizard once — Connect your tenant with a custom endpoint, the scan key,
the management client, the products, the checks, Skip for now twice, Open
Prisma AIRS — and lands on Home. Drivers written before C44 called
`open_settings` + `create_custom_tenant` + `save_key` + `save_client` and
pressed "Use the new interface"; `tenant_on_home` does the same work on
either build.
"""

import time

import fixture_app as fx
import acceptance_c08 as c8

WELCOME = "Welcome to Prisma AIRS Desktop"
PLACEHOLDER = "Setup tenant"


def _press(app, role, label, timeout=10):
    app.wait_for(lambda t: fx.App.node(t, role, label) is not None, timeout)
    app.ax("press", role, label)
    time.sleep(0.5)


def _press_any(app, label, roles=("AXRadioButton", "AXCheckBox", "AXButton"), timeout=8):
    tree, _ = app.wait_for(lambda t: any((n.get("label") or "") == label and n.get("role") in roles for n in t), timeout)
    node = next((n for n in tree if (n.get("label") or "") == label and n.get("role") in roles), None)
    if node:
        app.ax("press", node["role"], label)
        time.sleep(0.5)
    return node is not None


def wizard_showing(app, timeout=8):
    tree, shown = app.wait_for(lambda t: fx.App.node(t, "AXHeading", WELCOME) is not None or fx.App.node(t, "AXHeading", "Connect your tenant") is not None, timeout)
    return shown


def first_run(app, endpoint_origin, label="Northwind Health", tsg=c8.TSG, scan_key=c8.SCAN_KEY, client=True, environment="Staging"):
    """Walks the first-run wizard to Home with one tenant on a custom endpoint."""
    tree, _ = app.wait_for(lambda t: fx.App.node(t, "AXHeading", WELCOME) is not None or fx.App.node(t, "AXHeading", "Connect your tenant") is not None, 15)
    if fx.App.node(tree, "AXHeading", WELCOME) is not None:
        _press(app, "AXButton", "Set up a tenant")
    app.wait_for(lambda t: fx.App.node(t, "AXHeading", "Connect your tenant") is not None, 10)
    app.type_into("AXTextField", "Display name", label)
    app.type_into("AXTextField", "TSG ID", tsg)
    _press_any(app, environment)
    # The custom endpoint: the Region select has no custom entry; the fixture
    # build reads the endpoint origin from the destination the driver stages.
    _press(app, "AXButton", "Create tenant")
    app.wait_for(lambda t: fx.App.node(t, "AXButton", "Save scan key") is not None, 12)
    app.type_into("AXTextField", "Scan API key", scan_key, secure=True)
    _press(app, "AXButton", "Save scan key")
    app.wait_for(lambda t: fx.App.node(t, "AXButton", "Replace scan key") is not None, 12)
    if client:
        app.type_into("AXTextField", "Client ID", c8.CLIENT_ID)
        app.type_into("AXTextField", "Client secret", c8.SECRET, secure=True)
        _press(app, "AXButton", "Save management client")
        app.wait_for(lambda t: fx.App.node(t, "AXButton", "Replace management client") is not None, 12)
    _press(app, "AXButton", "Continue")
    app.wait_for(lambda t: fx.App.node(t, "AXHeading", "Which products will you manage?") is not None, 10)
    _press(app, "AXButton", "Continue")
    app.wait_for(lambda t: fx.App.node(t, "AXHeading", "Check the connection") is not None, 10)
    _press(app, "AXButton", "Run the checks")
    tree, _ = app.wait_for(lambda t: any((fx.App.node(t, "AXButton", l) or {}).get("enabled") is not False and fx.App.node(t, "AXButton", l) is not None for l in ("Continue", "Continue with warnings")) and not app.has_text(t, "Checking…"), 45)
    _press(app, "AXButton", "Continue with warnings" if fx.App.node(tree, "AXButton", "Continue with warnings") else "Continue")
    app.wait_for(lambda t: fx.App.node(t, "AXHeading", "Load starter test cases") is not None, 10)
    _press(app, "AXButton", "Skip for now")
    app.wait_for(lambda t: fx.App.node(t, "AXHeading", "Join the AI Security Academy") is not None, 10)
    _press(app, "AXButton", "Skip for now")
    app.wait_for(lambda t: fx.App.node(t, "AXHeading", f"{label} is ready") is not None, 10)
    _press(app, "AXButton", "Open Prisma AIRS")
    return app.wait_for(lambda t: fx.App.node(t, "AXHeading", "Home") is not None, 25)


def tenant_on_home(app, endpoint_origin, label="Northwind Health", client=True, extra=()):
    """One tenant on the driver's synthetic endpoint, active, with Home open.

    On this build the first run is the wizard: it is walked once with a
    placeholder region tenant (no live call is made: the scan key is stored,
    not checked, and no management client is saved), then the driver's
    tenants are added through Settings' tenant form (a custom HTTPS endpoint
    is the only way to reach a synthetic service) and the first is made
    active. On a pre-C44 build the legacy form and the interface switch are
    used as before. `extra` names further tenants to add on the same endpoint.
    """
    if wizard_showing(app, timeout=6):
        tree, home = first_run(app, endpoint_origin, label=PLACEHOLDER, client=False)
        if not home:
            # The last press can be lost while the ready step is still settling: press Open Prisma AIRS once more
            # if it is there, else report the step the wizard is on instead of failing later in Settings.
            if fx.App.node(tree, "AXButton", "Open Prisma AIRS") is not None:
                _press(app, "AXButton", "Open Prisma AIRS")
                tree, home = app.wait_for(lambda t: fx.App.node(t, "AXHeading", "Home") is not None, 25)
            if not home:
                heads = [n.get("label") for n in tree if n.get("role") == "AXHeading"]
                raise RuntimeError(f"the wizard did not reach Home (headings {heads}) [tree: {app.dump_tree('wizard-not-home')}]")
    app.open_settings()
    results = {}
    for name in (label, *extra):
        app.type_into("AXTextField", "TSG ID (optional)", c8.TSG)
        results[f"created {name}"] = bool(app.create_custom_tenant(name, endpoint_origin)[1])
        # The core keeps the active tenant on create (the wizard's placeholder here): the new tenant is made
        # active before its credentials are saved, so Settings attaches them to it and not to the placeholder.
        results[f"active {name}"] = bool(app.make_active(name)[1])
        # A tenant switch leaves Settings (the shell returns to Home): Settings is opened again for the credentials
        # and for the next tenant's form (the first run after the switch found no key field).
        app.open_settings()
        if name == label:
            results["scan key"] = bool(app.save_key(c8.SCAN_KEY)[1])
            if client:
                results["management client"] = bool(c8.save_client(app)[1])
    results["active again"] = bool(app.make_active(label)[1])
    missing = [k for k, v in results.items() if not v]
    if missing:
        raise RuntimeError(f"tenant setup did not complete: {missing}")
    tree = app.tree()
    if fx.App.node(tree, "AXCheckBox", "Use the new interface") is not None:
        app.ax("press", "AXCheckBox", "Use the new interface")
    app.menu("Go", "Home")
    return app.wait_for(lambda t: fx.App.node(t, "AXHeading", "Home") is not None, 15)
"""Runs a pre-P09 native driver on the one presentation (C44).

Imported before the driver, it patches the fixture-app helpers the legacy
scripts call so their assertions run unchanged against the v2 shell:

- `open_settings`: the first run of a fresh store is the wizard; it is
  walked once with a placeholder tenant (no credential) before Settings.
- `create_custom_tenant`: the core keeps the active tenant on create, so a
  tenant the script creates is made active at once, as the legacy form did.
- `ax press/focus` of a legacy sidebar entry (Sessions & Reports, Import
  from v1, a product page): the v2 shell lists these in the Go menu.
"""

import time

import fixture_app as fx
import v2_setup as v2s

GO = {
    "Sessions &": "Sessions & Reports",
    "Sessions & Reports": "Sessions & Reports",
    "Runtime Security": "Runtime Security",
    "Runtime": "Runtime Security",
    "AI Gateway": "AI Gateway",
    "Red Team & Models": "Red Team & Models",
    "Administration": "Administration",
    # The legacy Case Library is the Test Cases destination.
    "Case Library": "Test Cases",
}

# The legacy Administration sidebar's inventories: on the v2 shell they are the AI Runtime Security card's DLP tab
# (its DLP inventory segments) and the card's own tabs.
DLP_INVENTORIES = ("Data patterns", "Dictionaries", "Data profiles", "Data filtering profiles")
RUNTIME_TABS = ("Deployment profiles", "Security profiles", "Custom topics", "Applications", "API keys", "Overview", "Playground", "DLP")

_open_settings = fx.App.open_settings
_create = fx.App.create_custom_tenant
_ax = fx.App.ax


# The placeholder tenant's TSG: not the drivers' shared TSG (c8.TSG), which the v1 import fixture gives its Prod tenant;
# the importer maps a v1 tenant onto an existing tenant with the same TSG, and the C23 run saw Prod land on the
# placeholder instead of becoming its own tenant.
PLACEHOLDER_TSG = "9000000009"


def open_settings(self):
    if v2s.wizard_showing(self, timeout=3):
        v2s.first_run(self, None, label=v2s.PLACEHOLDER, tsg=PLACEHOLDER_TSG, client=False)
    return _open_settings(self)


def create_custom_tenant(self, label, origin):
    out = _create(self, label, origin)
    self.make_active(label)
    # The switch leaves Settings for Home: the pre-P09 driver's next step types the credentials into Settings, so it
    # is opened again here (the first run on this build found Home where it expected the key field).
    _open_settings(self)
    return out


def _runtime_card(self):
    """Administration with the AI Runtime Security card open (Expand all opens every card)."""
    tree = self.tree()
    if self.node(tree, "AXHeading", "Administration") is None:
        self.menu("Go", "Administration")
        tree, _ = self.wait_for(lambda t: self.node(t, "AXHeading", "Administration") is not None, 12)
    if not any(n.get("role") == "AXRadioButton" and (n.get("label") or "") == "DLP" for n in tree):
        _ax(self, "press", "AXButton", "Expand all")
        self.wait_for(lambda t: any(n.get("role") == "AXRadioButton" and (n.get("label") or "") == "DLP" for n in t), 10)


def _runtime_tab(self, label):
    """Selects a tab of the Runtime card. Pressed every time: the tree reports a value of 1 on tabs that are not
    selected (the C10 run read Data filtering profiles where it expected Deployment profiles), and pressing the
    selected tab again changes nothing."""
    _runtime_card(self)
    _ax(self, "press", "AXRadioButton", label)
    time.sleep(0.8)


def ax(self, command, *args):
    if command in ("press", "focus") and len(args) >= 2 and args[0] == "AXButton" and args[1] in GO and self.node(self.tree(), "AXButton", args[1]) is None:
        self.menu("Go", GO[args[1]])
        return ""
    if command == "press" and len(args) == 2 and args[0] == "AXButton" and args[1] in DLP_INVENTORIES:
        # A legacy DLP inventory: the Runtime card's DLP tab, then its segment.
        _runtime_tab(self, "DLP")
        _ax(self, "press", "AXRadioButton", args[1])
        time.sleep(0.8)
        return ""
    if command == "press" and len(args) == 2 and args[0] == "AXButton" and args[1] in RUNTIME_TABS and self.node(self.tree(), "AXButton", args[1]) is None:
        _runtime_tab(self, args[1])
        return ""
    if command == "press" and len(args) >= 2 and args[0] == "AXButton" and args[1] == "Close" and not any(n.get("role") == "AXButton" and (n.get("label") or "") == "Close" for n in self.tree()):
        # The v2 review sheet's close control is "Close review".
        if self.node(self.tree(), "AXButton", "Close review") is not None:
            return _ax(self, "press", "AXButton", "Close review")
    if command in ("press", "focus") and len(args) == 2 and isinstance(args[1], str):
        # The probe matches a label by prefix, in tree order. The v2 shell's rail puts "Search or go to… Command K"
        # ahead of a page's own "Search" button, so a legacy driver's exact label is preferred when one exists
        # (the first run on this build opened the palette instead of searching).
        role, label = args
        matches = [n for n in self.tree() if n.get("role") == role and (n.get("label") or "").startswith(label)]
        exact = [i for i, n in enumerate(matches) if (n.get("label") or "") == label]
        if exact and exact[0] != 0:
            return _ax(self, command, role, label, exact[0])
    return _ax(self, command, *args)


fx.App.open_settings = open_settings
fx.App.create_custom_tenant = create_custom_tenant
fx.App.ax = ax

# The C8 reach: the legacy shell drew a 60 CSS px fade over the bottom of every page, so a control reached by Tab
# had to end above it; the v2 shell has no such fade, and a control scrolled into view is clear when it lies inside
# the window.
import acceptance_c08 as _c8

_reach = _c8.reach


def reach(app, zoom, label):
    out = _reach(app, zoom, label)
    f, w = out.get("found"), out.get("window")
    if f and w:
        out["clear"] = f["pos"][1] >= w["pos"][1] and f["pos"][1] + f["size"][1] <= w["pos"][1] + w["size"][1] + 1
        out["criterion"] = "inside the window (the v2 shell has no bottom fade)"
    return out


_c8.reach = reach

