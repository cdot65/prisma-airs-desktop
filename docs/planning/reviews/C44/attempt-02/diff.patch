+    pub(super) fn save_gateway_draft(
+        &mut self,
+        context: &ContextRef,
+        input: GatewayDraftInput,
+    ) -> Result<(TenantId, u64), Refusal> {
+        let tenant = self.check_context(context)?;
+        let kept = {
+            let work = self.ready_local(&tenant)?;
+            match &input.id {
+                Some(id) => Some(
+                    work.book
