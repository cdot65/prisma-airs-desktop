++def within(tree, node):
++    if not node:
++        return []
++    i = tree.index(node)
++    out = []
++    for m in tree[i + 1:]:
++        if m.get("depth", 0) <= node.get("depth", 0):
++            break
++        out.append(m)
++    return out
