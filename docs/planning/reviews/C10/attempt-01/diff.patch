+        draft(
+            "filteringProfiles",
+            "create",
+            "",
+            json!({"file_based": true, "non_file_based": true}),
+        ),
+        draft("filteringProfiles", "delete", "filter-1", json!({})),
+    ] {
+        let review = desk.review(&unsupported).await;
