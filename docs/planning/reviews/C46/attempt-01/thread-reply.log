{"type":"item.completed","item":{"id":"item_39","type":"command_execution","command":"/bin/zsh -lc \"sed -n '1,280p' tools/p10/qualification.py; sed -n '243,292p' tools/p11/proof.py; cat tools/p10/review_gate.py\"","aggregated_output":"\"\"\"Explicit C45/P10 evidence accounting. Does not execute checks or assign scores.\n\nThe existing runners produce raw records; this consumer rejects omitted coverage,\nchanged evidence, unsupported retirement and affected checks carried as unchanged.\nHistorical results always retain their original candidate and execution bindings.\n\"\"\"\nfrom pathlib import Path\nimport hashlib\nimport json\n\n\ndef require(value, message):\n    if not value:\n        raise ValueError(message)\n\n\ndef read(path):\n    return json.loads(Path(path).read_text())\n\n\ndef sha(path):\n    return hashlib.sha256(Path(path).read_bytes()).hexdigest()\n\n\ndef digest(value):\n    return hashlib.sha256((json.dumps(value, sort_keys=True, separators=(\",\", \":\")) + \"\\n\").encode()).hexdigest()\n\n\ndef bound(root, reference):\n    path = root / reference[\"path\"]\n    require(path.resolve().is_relative_to(root.resolve()), \"evidence escapes checkout\")\n    require(sha(path) == reference[\"sha256\"], \"evidence hash drift: \" + str(path))\n    return path\n\n\nEXACT_FIELDS = (\"executable_sha256\", \"bundle_sha256\", \"build_flags\", \"conditions\")\n\n\ndef verify_raw(root, needed, execution, origin):\n    require(execution[\"argv\"] == needed[\"argv\"], \"execution command differs from approved plan\")\n    require(execution[\"cwd\"] == origin[\"execution_root\"], \"execution cwd differs from original candidate\")\n    raw_path = bound(root, execution[\"raw\"])\n    raw = read(raw_path)\n    if needed[\"kind\"] == \"native\":\n        require(raw[\"schema\"] == \"airs-v2/native-acceptance/1\" and raw[\"app\"][\"executable_sha256\"] == origin[\"executable_sha256\"], \"raw native candidate mismatch\")\n        checks = [check for check in raw[\"checks\"] if check[\"id\"] == needed[\"id\"]]\n        require(len(checks) == 1 and checks[0][\"result\"] == \"pass\" and checks[0].get(\"observation\") and checks[0].get(\"evidence\"), \"raw native assertion not passing\")\n        for name in checks[0][\"evidence\"]:\n            require(name in execution[\"evidence\"], \"native evidence missing from execution inventory\")\n            bound(root, {\"path\":name,\"sha256\":execution[\"evidence\"][name]})\n    elif needed[\"kind\"] == \"command\":\n        require(raw[\"schema\"] == \"airs-v2/run/1\" and raw[\"status\"] == \"passed\" and raw[\"failure\"] is None and raw[\"inputs_before\"] == raw[\"inputs_after\"], \"raw runner failed or inputs changed\")\n        require(raw[\"inputs_before\"] == origin[\"runner_inputs\"], \"runner input fingerprint does not bind original candidate\")\n        commands = [command for command in raw[\"commands\"] if command[\"label\"] == needed[\"label\"]]\n        require(len(commands) == 1, \"raw runner command missing/duplicated\")\n        command = commands[0]\n        require(command[\"status\"] == \"passed\" and command[\"exit_code\"] == 0 and command[\"argv\"] == needed[\"argv\"] and command[\"cwd\"] in [\".\", origin[\"execution_root\"]] and not command[\"note\"], \"raw runner command failed/differs\")\n        require(command[\"output_sha256\"] == execution[\"log\"][\"sha256\"] and str((raw_path.parent/command[\"log\"]).relative_to(root)) == execution[\"log\"][\"path\"], \"raw runner log binding\")\n        if needed.get(\"expects_tests\"):\n            require(command[\"tests\"] and command[\"tests\"][\"passed\"] > 0 and command[\"tests\"][\"failed\"] == 0, \"test command did not execute passing tests\")\n    else:\n        raise ValueError(\"unsupported required raw execution kind\")\n\n\ndef verify(root, record, historical=None):\n    require(record[\"schema\"] == \"airs-desktop/qualified-coverage/1\", \"coverage schema\")\n    plan = read(bound(root, record[\"plan\"]))\n    require(plan[\"schema\"] == \"airs-desktop/required-coverage/1\", \"plan schema\")\n    requirements = plan[\"requirements\"]\n    ids = [item[\"id\"] for item in requirements]\n    require(len(ids) == len(set(ids)) and ids, \"duplicate/empty required coverage\")\n    rows = record[\"coverage\"]\n    require(len(rows) == len(ids) and {r[\"id\"] for r in rows} == set(ids), \"missing/duplicate/unknown coverage\")\n    by_id = {item[\"id\"]: item for item in requirements}\n    candidate = read(bound(root, record[\"candidate\"]))\n    require(all(candidate.get(k) for k in EXACT_FIELDS) and candidate.get(\"helper_closure\"), \"candidate binding incomplete\")\n    require(candidate.get(\"source_inventory_sha256\") == record[\"source_inventory_sha256\"], \"candidate source binding\")\n    for row in rows:\n        needed = by_id[row[\"id\"]]\n        mode = row[\"disposition\"]\n        require(mode in [\"executed\", \"reused_exact\", \"carried_unaffected\", \"not_applicable\"], \"unsupported coverage disposition\")\n        if mode == \"not_applicable\":\n            decision = needed.get(\"retirement\")\n            require(decision and row.get(\"reason\") and row.get(\"decision\") == decision, \"unapproved assertion retirement\")\n            bound(root, decision)\n            continue\n        original = read(bound(root, row[\"result\"]))\n        require(original.get(\"status\") == \"pass\" and original.get(\"exit_code\") == 0, \"result is not an actual passing execution\")\n        require(original.get(\"execution_id\") and original.get(\"argv\") and original.get(\"cwd\") and original.get(\"started_utc\") and original.get(\"finished_utc\"), \"execution provenance missing\")\n        require(row[\"id\"] in original.get(\"required_ids\", []), \"result does not cover required assertion\")\n        bound(root, original[\"log\"])\n        origin = read(bound(root, original[\"candidate\"]))\n        require(all(origin.get(k) for k in EXACT_FIELDS) and origin.get(\"helper_closure\"), \"original candidate binding incomplete\")\n        verify_raw(root, needed, original, origin)\n        if mode in [\"executed\", \"reused_exact\"]:\n            if mode == \"reused_exact\":\n                require(not needed.get(\"must_execute\", needed.get(\"affected\", True)), \"changed check must execute\")\n            helpers = needed.get(\"helper_paths\")\n            if helpers is None:\n                require(origin[\"helper_closure\"] == candidate[\"helper_closure\"], \"relevant helper closure differs\")\n            else:\n                require(all(name in origin[\"helper_closure\"] and name in candidate[\"helper_closure\"] and origin[\"helper_closure\"][name] == candidate[\"helper_closure\"][name] for name in helpers), \"relevant helper closure differs\")\n            require(all(origin[k] == candidate[k] for k in EXACT_FIELDS), \"artifact/helper/flags/conditions differ\")\n            if mode == \"executed\":\n                require(origin[\"source_inventory_sha256\"] == record[\"source_inventory_sha256\"], \"execution is historical, not current\")\n        else:\n            require(not needed.get(\"affected\", True), \"affected check cannot be carried unchanged\")\n            rationale = row.get(\"impact\")\n            require(rationale and rationale.get(\"reason\") and rationale.get(\"dependencies\") == needed.get(\"dependencies\") and rationale.get(\"original_candidate_sha256\") == original[\"candidate\"][\"sha256\"], \"unchanged-impact proof missing\")\n            proof = read(bound(root, rationale[\"proof\"]))\n            bindings = proof.get(\"file_bindings\", {})\n            require(set(bindings) == set(needed[\"dependencies\"]) and bindings, \"dependency membership proof missing\")\n            current_files=historical.source(record['source_inventory_sha256']) if historical else root\n            original_files=historical.source(origin['source_inventory_sha256']) if historical else root\n            for dependency, binding in bindings.items():\n                require(binding[\"original_sha256\"] == binding[\"current_sha256\"] == sha(current_files/dependency), \"dependency changed: \" + dependency)\n                original_source = original_files/dependency if historical else bound(root, binding[\"original_file\"])\n                require(sha(original_source) == binding[\"original_sha256\"], \"original dependency proof mismatch\")\n            require(proof.get(\"unchanged_dependencies\") == needed[\"dependencies\"] and proof.get(\"current_source_inventory_sha256\") == record[\"source_inventory_sha256\"] and proof.get(\"original_candidate_sha256\") == original[\"candidate\"][\"sha256\"], \"impact proof does not bind current and original inputs\")\n    return {\"qualified\": True, \"required\": len(ids), \"dispositions\": {m: sum(r[\"disposition\"] == m for r in rows) for m in sorted({r[\"disposition\"] for r in rows})}, \"candidate_sha256\": record[\"candidate\"][\"sha256\"], \"source_inventory_sha256\": record[\"source_inventory_sha256\"]}\ndef validate_run(root, path, kind, runner_inputs, labels=None, source=None):\n    raw = read(path)\n    if raw.get('schema') == 'airs-desktop/p11-check-selection/1':\n        require(kind == 'check', 'check selection cannot replace a test run')\n        return validate_check_selection(root, path, runner_inputs)\n    require(raw['schema'] == 'airs-v2/run/1' and raw['subject'] == 'P11'\n            and raw['kind'] == kind, 'not an actual P11 run of the required kind')\n    require(raw['status'] == 'passed' and raw['failure'] is None,\n            'P11 run is not passing')\n    require(raw['inputs_before'] == raw['inputs_after'] == runner_inputs,\n            'P11 run inputs differ or changed')\n    expected = command_plan(source or root, kind)\n    if labels is not None:\n        expected = [row for row in expected if row['label'] in labels]\n        require(labels and [row['label'] for row in expected] == labels\n                and not any(label.startswith('setup/') for label in labels),\n                'unknown, duplicate or out-of-order selected command')\n    require([row['argv'] for row in raw['commands']] == [row['argv'] for row in expected],\n            'P11 command membership/order differs from approved focused plan')\n    for actual, needed in zip(raw['commands'], expected):\n        require(actual['label'] == needed['label'], 'P11 command label differs')\n        require(actual['status'] == 'passed' and actual['exit_code'] == 0\n                and not actual['note'], 'P11 command failed or was skipped')\n        require(actual['cwd'] in ('.', str(root)), 'P11 execution root differs')\n        log = (path.parent / actual['log']).resolve()\n        require(log.is_relative_to(root.resolve()) and sha(log) == actual['output_sha256'],\n                'P11 raw command log drift')\n        if needed['expects_tests']:\n            require(actual['tests'] and actual['tests']['passed'] > 0\n                    and actual['tests']['failed'] == 0, 'P11 target executed no passing tests')\n    return raw\n\n\ndef inventory_source(record):\n    \"\"\"Join a retained file inventory to the Rust runner's source fingerprint.\"\"\"\n    parts = []\n    for name, identity in sorted(record['files'].items()):\n        if name == 'docs/planning/status.md' or name.startswith(('docs/planning/evidence/', 'docs/planning/reviews/')):\n            continue\n        mode = 'symlink' if identity['kind'] == 'symlink' else ('100755' if identity['mode'] & 0o111 else '100644')\n        value = (hashlib.sha256(os.fsencode(identity['target'])).hexdigest()\n                 if mode == 'symlink' else identity['sha256'])\n        parts.append(f'{name}\\0{mode}\\0{value}\\n')\n    config = record['git_config']\n    mode = 'deleted' if config is None else ('100755' if config['mode'] & 0o111 else '100644')\n    parts.append(f'.git/config\\0{mode}\\0{config[\"sha256\"] if config else \"\"}\\n')\n    return hashlib.sha256(''.join(parts).encode()).hexdigest()\n\n\ndef validate_check_selection(root, path, runner_inputs, source=None, files=None):\n\"\"\"Read-only actual-review proof checks for C45/P10 and production prerequisites.\n\nNo score assignment, evidence execution, controller completion or release action.\n\"\"\"\nfrom pathlib import Path\nimport json\nimport sys\n\nsys.path.insert(0, str(Path(__file__).resolve().parent))\nsys.path.insert(0, str(Path(__file__).resolve().parents[1] / \"p09\"))\nfrom phase_packet import file_identity, digest, validate\nfrom phase_inputs import full_gate, require, read, sha, REVIEW_DISABLED\n\n\ndef transport(root, out, request):\n    invocation = read(out/\"invocation.json\")\n    require(invocation[\"request_sha256\"] == sha(out/\"request.json\"), \"transport request drift\")\n    schema_path = root/request.get(\"schema_archive\", \"docs/architecture/review-verdict.schema.json\")\n    require(invocation[\"schema_sha256\"] == sha(schema_path), \"transport schema drift\")\n    args = invocation[\"command_without_prompt\"]\n    require(args[0] == \"codex\" and args.count(\"exec\") == 1, \"not fresh Codex exec\")\n    for flag in [\"--no-daemon\", \"--ephemeral\", \"--ignore-user-config\", \"--ignore-rules\", \"--json\"]:\n        require(args.count(flag) == 1, \"transport isolation \" + flag)\n    for flag, value in [(\"-a\", \"never\"), (\"-s\", \"read-only\"), (\"-m\", \"gpt-6.1-sol\")]:\n        require(args.count(flag) == 1 and args[args.index(flag)+1] == value, \"transport isolation argument \" + flag)\n    require(args.count(\"--output-schema\") == 1 and args[args.index(\"--output-schema\")+1] == \"docs/architecture/review-verdict.schema.json\", \"transport output schema\")\n    expected_out = Path(request.get(\"execution_root\", root))/\"docs/planning/reviews\"/request[\"subject\"]/request[\"attempt_id\"]/\"verdict-returned.json\"\n    require(args.count(\"-o\") == 1 and args[args.index(\"-o\")+1] == str(expected_out), \"transport output path\")\n    require(invocation[\"model_requested\"] == \"gpt-6.1-sol\", \"configured review model changed\")\n    require(not any(\"dangerously\" in arg or arg in [\"resume\", \"fork\", \"--last\", \"--approve-for-me\"] for arg in args), \"review resume/bypass\")\n    disabled = [args[i+1] for i,a in enumerate(args) if a == \"--disable\"]\n    require(set(disabled) == REVIEW_DISABLED and len(disabled) == len(REVIEW_DISABLED), \"restricted review features\")\n    overrides = [args[i+1] for i,a in enumerate(args) if a == \"-c\"]\n    require(set(overrides) == {'web_search=\"disabled\"', 'model_reasoning_effort=\"xhigh\"'} and len(overrides) == 2, \"review overrides\")\n    require(invocation[\"feature_probe_sha256\"] == sha(out/\"feature-probe.log\"), \"feature probe drift\")\n    observed = {line.split()[0]:line.split()[-1] for line in (out/\"feature-probe.log\").read_text().splitlines() if len(line.split()) >= 3}\n    require(all(observed.get(k) == invocation[\"restricted_features_observed\"].get(k) == \"false\" for k in REVIEW_DISABLED), \"feature isolation not observed\")\n    messages=[];sessions=[]\n    for line in (out/\"thread-reply.log\").read_text().splitlines():\n        try:event=json.loads(line)\n        except json.JSONDecodeError:continue\n        if not isinstance(event,dict):continue\n        item=event.get(\"item\",{})\n        if not isinstance(item,dict):item={}\n        require(event.get(\"type\") not in [\"hook.started\",\"hook.completed\"] and item.get(\"type\") not in [\"mcp_tool_call\",\"hook_execution\"], \"unexpected review side effect\")\n        if event.get(\"type\") == \"thread.started\":sessions.append(event.get(\"thread_id\"))\n        if event.get(\"type\") == \"item.completed\" and item.get(\"type\") in [\"agent_message\",\"assistant_message\"]:messages.append(item.get(\"text\",\"\"))\n    require(len(sessions) == 1 and messages and json.loads(messages[-1]) == read(out/\"verdict-returned.json\"), \"actual independent returned verdict missing/mismatched\")\n    return dict(invocation_sha256=sha(out/\"invocation.json\"),thread_reply_sha256=sha(out/\"thread-reply.log\"),feature_probe_sha256=sha(out/\"feature-probe.log\"),reviewer_sessions_observed=sessions)\n\n\ndef actual_review(root, subject, attempt, source_root=None, evidence=True):\n    out=root/\"docs/planning/reviews\"/subject/attempt\n    request=read(out/\"request.json\"); verdict=read(out/\"verdict-returned.json\")\n    schema_path=(root/request[\"schema_archive\"] if request.get(\"schema_archive\")\n                 else (source_root or root)/\"docs/architecture/review-verdict.schema.json\")\n    # Historical P09 schema is preserved independently of future descriptions.\n    if subject == \"P09\":schema_path=root/\"docs/planning/evidence/C45/activation-20261102-g11/p09-source/docs/architecture/review-verdict.schema.json\"\n    validate(verdict,read(schema_path))\n    require(verdict[\"subject\"] == subject and request[\"subject\"] == subject and verdict[\"attempt_id\"] == request[\"attempt_id\"] == attempt and verdict[\"request_id\"] == request[\"request_id\"] and verdict[\"fingerprints\"] == request[\"fingerprints\"], \"actual verdict request/fingerprint binding\")\n    full_gate(verdict)\n    # Preserve request bytes: the archive path is verification context, never an edit.\n    transport_request=dict(request)\n    # A later schema description must not change an archived review's input.\n    # Supply verification context only; request/invocation bytes stay immutable.\n    if source_root is not None:\n        transport_request[\"schema_archive\"]=str(schema_path.relative_to(root))\n    if subject == \"P09\":\n        transport_request[\"schema_archive\"]=str(schema_path.relative_to(root))\n        transport_request[\"execution_root\"]=read(root/\"docs/planning/evidence/C45/activation-20261102-g11/p09-proof.json\")[\"source_checkout\"]\n    observed=transport(root,out,transport_request)\n    audit=read(out/\"post-review-audit.json\");receipt=read(out/\"receipt.json\")\n    require(audit[\"full_gate_pass\"] is True and receipt[\"full_gate_pass\"] is True and receipt[\"source_frozen\"] is True, \"actual full-gate audit missing\")\n    for record in [audit,receipt]:\n        require(record[\"request_sha256\"] == sha(out/\"request.json\") and record.get(\"raw_verdict_sha256\",record.get(\"verdict_sha256\")) == sha(out/\"verdict-returned.json\") and record[\"scores\"] == verdict[\"scores\"], \"review audit/receipt binding\")\n    require(receipt[\"post_review_audit_sha256\"] == sha(out/\"post-review-audit.json\") and receipt[\"fingerprints\"] == verdict[\"fingerprints\"], \"receipt audit/fingerprints\")\n    require(receipt[\"invocation_sha256\"] == observed[\"invocation_sha256\"] and receipt[\"thread_reply_sha256\"] == observed[\"thread_reply_sha256\"], \"receipt transport binding\")\n    for name,key,base in [(\"source-inventory.json\",\"source\",source_root or root),(\"evidence-inventory.json\",\"evidence\",root)]:\n        inventory=read(out/name)[\"files\"]\n        require(digest(inventory) == request[\"fingerprints\"][key], \"inventory fingerprint mismatch\")\n        if evidence or key == \"source\":\n            locations = read(root/\"docs/planning/evidence/C45/activation-20261102-g11/p09-extra-evidence/locations.json\") if subject == \"P09\" and key == \"evidence\" else {}\n            for relative,identity in inventory.items():\n                path = root/locations[relative] if relative in locations else base/relative\n                require(file_identity(path) == identity, \"reviewed input drift: \" + relative)\n    return dict(subject=subject,attempt=attempt,request_sha256=sha(out/\"request.json\"),verdict_sha256=sha(out/\"verdict-returned.json\"),audit_sha256=sha(out/\"post-review-audit.json\"),receipt_sha256=sha(out/\"receipt.json\"),scores=verdict[\"scores\"],fingerprints=verdict[\"fingerprints\"])\n\n\ndef release_prerequisites(root):\n    archive=root/\"docs/planning/evidence/C45/activation-20261102-g11/p09-source\"\n    p09=actual_review(root,\"P09\",\"attempt-02\",archive)\n    standing=read(root/\"docs/planning/evidence/P10/completion-proof.json\")\n    require(standing[\"schema\"] == \"airs-desktop/p10-completion-proof/1\" and standing[\"p09\"] == p09,\"P09 prerequisite binding\")\n    # P10's exact reviewed source is archived on completion. Later C26 release\n    # implementation gets its own checks/review; it does not relabel P10 inputs.\n    archived=root/standing[\"source_archive\"]\n    require(archived.resolve().is_relative_to((root/\"docs/planning/evidence/P10\").resolve()),\"P10 archive escapes evidence\")\n    p10=actual_review(root,\"P10\",standing[\"attempt\"],archived)\n    require(standing[\"p10\"] == p10,\"P10 completion proof binding\")\n    c45=actual_review(root,\"C45\",standing[\"c45\"][\"attempt\"],root/standing[\"c45_source_archive\"])\n    require(standing[\"c45\"] == c45,\"C45 member proof binding\")\n    from packet import qualification\n    from historical import Historical\n    historical=Historical(root,standing[\"historical_context\"])\n    qualified=qualification(root,root/standing[\"qualification\"][\"record\"],current=False,historical=historical)\n    request=read(root/\"docs/planning/reviews/P10\"/standing[\"attempt\"]/\"request.json\")\n    require(qualified == standing[\"qualification\"] == request[\"qualification\"] and request[\"predecessors\"][\"C45\"] == c45,\"P10 qualified candidate/member binding\")\n    return {\"p09\":p09,\"p10\":p10,\"c45\":c45,\"controller_complete\":False,\"c26_required_here\":False}\n\n\nif __name__ == \"__main__\":\n    require(len(sys.argv) == 2 and sys.argv[1] == \"release-prerequisites\", \"usage: review_gate.py release-prerequisites\")\n    print(json.dumps(release_prerequisites(Path.cwd().resolve()),indent=2))\n","exit_code":0,"status":"completed"}}
