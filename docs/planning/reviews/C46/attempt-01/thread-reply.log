{"type":"item.completed","item":{"id":"item_28","type":"command_execution","command":"/bin/zsh -lc 'cat crates/desktop-core/tests/setup_warning_recheck.rs'","aggregated_output":"//! F01/F02: dedicated setup warning checks over real authority, storage and\n//! management transport. Every endpoint and credential is an owned TLS fixture.\n#[allow(dead_code)]\n#[path = \"context_credentials/support.rs\"]\nmod support;\n\nuse desktop_core::fixtures::{self, Handles, ScriptedStore};\nuse desktop_core::management::ManagementEndpoints;\nuse desktop_core::store::PersistedState;\nuse desktop_core::transport::{ProxyMode, TransportPolicy};\nuse desktop_core::{\n    AuthorityHandle, Core, CoreConfig, Delivery, Intent, Observation, Receipt, ShellSnapshot,\n    ViewScope,\n};\nuse serde_json::{Value, json};\nuse std::sync::{Arc, Mutex};\nuse std::time::Duration;\nuse support::{Reply, Seen, TestCa, TlsServer, eventually};\n\nconst TENANT: &str = \"tn-0123456789abcdef\";\nconst TSG: &str = \"1234567890\";\nconst WS: &str = \"099073d7-ced5-456f-b29b-86601b9cc42d\";\nconst LEGACY_MODEL: &str = \"2 of 3 model and skill sources readable.\";\n\nstruct Script {\n    model_status: [u16; 3],\n    scope_slug: String,\n}\nfn reply(status: u16, value: Value) -> Reply {\n    if status == 0 {\n        return Reply::Hang;\n    }\n    let body = serde_json::to_vec(&value).expect(\"serialize fixture response\");\n    Reply::Raw {\n        head: format!(\n            \"HTTP/1.1 {status} Status\\r\\ncontent-type: application/json\\r\\ncontent-length: {}\\r\\nconnection: close\",\n            body.len()\n        ),\n        body,\n    }\n}\nimpl Script {\n    fn route(&self, seen: &Seen) -> Reply {\n        let path = seen\n            .request_line\n            .split(' ')\n            .nth(1)\n            .unwrap_or(\"\")\n            .split('?')\n            .next()\n            .unwrap_or(\"\");\n        match path {\n            \"/oauth2/access_token\" => reply(\n                200,\n                json!({\"access_token\":\"synthetic-access\", \"token_type\":\"Bearer\", \"expires_in\":3600}),\n            ),\n            \"/aims/data/v1/scans\" => reply(\n                self.model_status[0],\n                json!({\"scans\":[],\"pagination\":{\"total_items\":0}}),\n            ),\n            \"/aiag/data/v1/stats/scans\" => reply(\n                self.model_status[1],\n                json!({\"unique_skills_scanned\":{\"count\":0,\"percent_change\":null},\"total_vulnerabilities_found\":{\"count\":0,\"percent_change\":null},\"top_vulnerability\":null}),\n            ),\n            \"/aiag/data/v1/scans\" => reply(\n                self.model_status[2],\n                json!({\"scans\":[],\"pagination\":{\"total_items\":0}}),\n            ),\n            \"/ai_gw/v2/workspaces\" => reply(\n                200,\n                json!({\"object\":\"list\",\"total\":1,\"success\":true,\"has_more\":false,\"data\":[{\"id\":WS,\"slug\":\"goshawks\",\"name\":\"Goshawks\",\"icon\":null,\"description\":null,\"created_at\":\"2026-10-01T00:00:00Z\",\"last_updated_at\":\"2026-10-02T00:00:00Z\",\"is_default\":0,\"status\":\"active\",\"scope_name\":\"ws_goshawks_io_2mwlan\",\"object\":\"workspace\"}]}),\n            ),\n            \"/ai_gw/v2/configs\"\n            | \"/ai_gw/v2/providers\"\n            | \"/ai_gw/v2/api-keys/service\"\n            | \"/ai_gw/admin/v2/integrations\" => reply(\n                200,\n                json!({\"object\":\"list\",\"total\":0,\"success\":true,\"has_more\":false,\"data\":[]}),\n            ),\n            \"/iam/v1/scopes/ws_goshawks_io_2mwlan\" => reply(\n                200,\n                json!({\"name\":\"ws_goshawks_io_2mwlan\",\"description\":\"Fixture\", \"tsg_id\":TSG,\"id\":\"scope-fixture\",\"resources\":[{\"resource_type\":\"workspace\",\"resource_id\":self.scope_slug}]}),\n            ),\n            _ => reply(404, json!({\"error\":\"fixture path not admitted\"})),\n        }\n    }\n}\nstruct Desk {\n    _core: Core,\n    handle: AuthorityHandle,\n    session: String,\n    sequence: u64,\n    handles: Handles,\n    script: Arc<Mutex<Script>>,\n    server: TlsServer,\n}\nimpl Desk {\n    fn snap(&self) -> ShellSnapshot {\n        match self\n            .handle\n            .observe(ViewScope::Shell)\n            .expect(\"observe fixture shell\")\n        {\n            Observation::Shell { snapshot, .. } => snapshot,\n            _ => panic!(\"shell\"),\n        }\n    }\n    fn context(&self) -> String {\n        self.snap()\n            .active\n            .expect(\"fixture tenant is active\")\n            .context\n            .as_str()\n            .to_owned()\n    }\n    fn warning(&self) -> Value {\n        serde_json::to_value(&self.snap().tenants[0].setup_warnings[0])\n            .expect(\"serialize fixture warning\")\n    }\n    async fn send(&mut self, intent: Value) -> Receipt {\n        self.sequence += 1;\n        self.handle\n            .dispatch(\n                Delivery {\n                    session: self.session.clone(),\n                    sequence: self.sequence,\n                },\n                serde_json::from_value::<Intent>(intent).expect(\"public typed intent\"),\n            )\n            .await\n            .expect(\"admitted\")\n    }\n    async fn recheck(&mut self) {\n        let context = self.context();\n        self.send(json!({\"kind\":\"recheckSetupWarning\",\"context\":context,\"warning\":\"vw-1\"}))\n            .await;\n        assert!(\n            eventually(|| self.warning()[\"recheck\"][\"state\"]\n                .as_str()\n                .is_some_and(|s| s != \"pending\"))\n            .await,\n            \"check settled: {}\",\n            self.warning()\n        );\n    }\n    async fn workspace(&mut self) {\n        let context = self.context();\n        self.send(json!({\"kind\":\"management\",\"context\":context,\"request\":{\"kind\":\"gateway\",\"workspace\":null,\"read\":{\"kind\":\"inventory\",\"resource\":\"workspaces\"}}})).await;\n        assert!(eventually(|| self.snap().gateway.workspaces.is_some()).await);\n        self.send(json!({\"kind\":\"selectGatewayWorkspace\",\"context\":context,\"workspace\":WS}))\n            .await;\n    }\n}\nasync fn desk(product: &str, reason: &str, check: Option<Value>) -> Desk {\n    desk_with_tsg(product, reason, check, Some(TSG)).await\n}\nasync fn desk_with_tsg(\n    product: &str,\n    reason: &str,\n    check: Option<Value>,\n    tsg: Option<&str>,\n) -> Desk {\n    let ca = TestCa::new(\"warning-recheck fixture\");\n    let script = Arc::new(Mutex::new(Script {\n        model_status: [200; 3],\n        scope_slug: \"goshawks\".to_owned(),\n    }));\n    let routed = Arc::clone(&script);\n    let server = TlsServer::start(\n        ca.leaf(&[\"localhost\"]),\n        Reply::Route(Arc::new(move |s| {\n            routed.lock().expect(\"fixture route lock\").route(s)\n        })),\n    )\n    .await;\n    let origin = format!(\"https://localhost:{}\", server.port);\n    let mut state =\n        serde_json::to_value(PersistedState::default()).expect(\"serialize default fixture state\");\n    state[\"tenants\"] = json!([{\"id\":TENANT,\"label\":\"Fixture\",\"tsgId\":tsg,\"destination\":{\"kind\":\"custom\",\"origin\":origin},\"environment\":\"production\"}]);\n    state[\"activeTenant\"] = json!(TENANT);\n    state[\"onboarding\"] = json!(\"done\");\n    state[\"tenantProducts\"] = json!([{\"tenant\":TENANT,\"products\":if product == \"runtimeSecurity\" { vec![product] } else { vec![\"runtimeSecurity\", product] }}]);\n    let mut warning =\n        json!({\"id\":\"vw-1\",\"product\":product,\"reason\":reason,\"recordedSecs\":1761480000});\n    if let Some(mut binding) = check {\n        binding[\"origin\"] = json!(origin);\n        warning[\"check\"] = binding;\n    }\n    state[\"tenantWarnings\"] = json!([{\"tenant\":TENANT,\"warnings\":[warning]}]);\n    let (adapters, handles) = fixtures::adapters_with(ScriptedStore::with_state(\n        serde_json::from_value(state).expect(\"decode fixture state\"),\n    ));\n    let core = Core::new(\n        CoreConfig {\n            management: ManagementEndpoints::at_origin(&origin),\n            deadline_tick: Duration::from_millis(25),\n            ..CoreConfig::default()\n        },\n        adapters,\n    );\n    core.start();\n    core.set_transport_policy(TransportPolicy {\n        revision: 2,\n        proxy: ProxyMode::Direct,\n        extra_roots: vec![ca.pem.as_bytes().to_vec()],\n    })\n    .expect(\"install fixture TLS transport policy\");\n    let handle = core.operator();\n    let session = handle\n        .register_delivery_session()\n        .expect(\"register fixture delivery\")\n        .nonce;\n    let mut desk = Desk {\n        _core: core,\n        handle,\n        session,\n        sequence: 0,\n        handles,\n        script,\n        server,\n    };\n    if product != \"runtimeSecurity\" {\n        let context = desk.context();\n        desk.send(json!({\"kind\":\"configureManagementCredential\",\"context\":context,\"mode\":\"keychain\",\"clientId\":\"synthetic-client@1234567890.iam.panserviceaccount.com\",\"secret\":\"synthetic-warning-secret\"})).await;\n        assert!(\n        eventually(|| desk.snap().tenants[0].management.state == desktop_core::ScanState::Ready)\n            .await\n    );\n    }\n    desk\n}\nfn known(product: &str) -> Value {\n    json!({\"version\":1,\"line\":product,\"tsgId\":TSG,\"origin\":\"replaced-by-owned-origin\",\"workspace\":null})\n}\n\n#[tokio::test(flavor = \"multi_thread\")]\nasync fn legacy_model_warning_requires_dedicated_check_and_preserves_dated_history() {\n    let mut d = desk(\"modelSkill\", LEGACY_MODEL, None).await;\n    let context = d.context();\n    d.send(json!({\"kind\":\"readTenant\",\"context\":context})).await;\n    assert!(\n        eventually(|| {\n            let read = d.snap().inbox.read;\n            read.state != desktop_core::ReadState::Reading\n                && read.products.iter().any(|p| {\n                    p.product == desktop_core::features::ProductId::ModelSkill\n                        && p.state == desktop_core::ProductReadState::Ok\n                })\n        })\n        .await\n    );\n    assert!(\n        d.warning().get(\"resolvedSecs\").is_none(),\n        \"ordinary healthy read is not a setup recheck\"\n    );\n    d.recheck().await;\n    let warning = d.warning();\n    assert_eq!(warning[\"reason\"], LEGACY_MODEL);\n    assert_eq!(warning[\"recordedSecs\"], 1761480000u32);\n    assert_eq!(warning[\"recheck\"][\"state\"], \"pass\");\n    assert_eq!(warning[\"recheck\"][\"basis\"], \"legacyTenantSources\");\n    assert!(warning[\"resolvedSecs\"].as_u64().is_some());\n    assert!(!d.snap().inbox.items.iter().any(|i| i.id == \"vw-1\"));\n    assert!(\n        serde_json::to_value(d.handles.store.saved().expect(\"warning state was saved\")).expect(\"serialize saved warning state\")[\"tenantWarnings\"][0][\"warnings\"][0][\"resolvedSecs\"].as_u64().is_some()\n    );\n    assert!(\n        d.server\n            .seen()\n            .iter()\n            .all(|r| r.request_line.starts_with(\"GET \")\n                || r.request_line.starts_with(\"POST /oauth2/access_token \")),\n        \"no product writes or paid scans\"\n    );\n}\n\n#[tokio::test(flavor = \"multi_thread\")]\nasync fn source_specific_denial_remains_active_then_resolves_after_fresh_complete_check() {\n    let mut d = desk(\"modelSkill\", LEGACY_MODEL, Some(known(\"modelSkill\"))).await;\n    d.script.lock().expect(\"fixture script lock\").model_status[1] = 403;\n    d.recheck().await;\n    assert!(d.warning().get(\"resolvedSecs\").is_none());\n    let reason = d.warning()[\"recheck\"][\"reason\"]\n        .as_str()\n        .expect(\"warning recheck has a reason\")\n        .to_owned();\n    assert!(\n        reason.contains(\"Skill statistics\") && reason.contains(\"not allowed\"),\n        \"{reason}\"\n    );\n    d.script.lock().expect(\"fixture script lock\").model_status[1] = 200;\n    d.recheck().await;\n    assert_eq!(d.warning()[\"recheck\"][\"basis\"], \"recordedScope\");\n    assert!(d.warning()[\"resolvedSecs\"].as_u64().is_some());\n}\n\n#[tokio::test(flavor = \"multi_thread\")]\nasync fn unknown_legacy_scope_and_failed_persistence_do_not_clear_warning() {\n    let mut d = desk(\"modelSkill\", \"A freeform unknown legacy diagnostic\", None).await;\n    d.recheck().await;\n    assert_eq!(d.warning()[\"recheck\"][\"basis\"], \"unknown\");\n    assert!(d.warning().get(\"resolvedSecs\").is_none());\n    let mut d = desk(\"modelSkill\", LEGACY_MODEL, None).await;\n    d.handles.store.fail_saves(true);\n    d.recheck().await;\n    assert!(d.warning().get(\"resolvedSecs\").is_none());\n    assert!(\n        d.warning()[\"recheck\"][\"reason\"]\n            .as_str()\n            .expect(\"warning recheck has a reason\")\n            .contains(\"could not be saved\")\n    );\n}\n\n#[tokio::test(flavor = \"multi_thread\")]\nasync fn reported_legacy_gateway_scope_is_rechecked_with_slug_not_display_uuid() {\n    let reason =\n        format!(\"Workspace {WS}: partial; scope ws_goshawks_io_2mwlan does not list the workspace\");\n    let mut d = desk(\"gateway\", &reason, None).await;\n    d.workspace().await;\n    d.script.lock().expect(\"fixture script lock\").scope_slug = WS.to_owned();\n    d.recheck().await;\n    assert!(\n        d.warning().get(\"resolvedSecs\").is_none(),\n        \"UUID binding is not the documented slug contract\"\n    );\n    d.script.lock().expect(\"fixture script lock\").scope_slug = \"goshawks\".to_owned();\n    d.recheck().await;\n    assert_eq!(d.warning()[\"recheck\"][\"basis\"], \"legacyWorkspaceScope\");\n    assert!(d.warning()[\"resolvedSecs\"].as_u64().is_some());\n    assert_eq!(d.warning()[\"reason\"], reason);\n}\n\n#[tokio::test(flavor = \"multi_thread\")]\nasync fn gateway_wrong_workspace_or_unknown_scope_format_remains_unresolved() {\n    for reason in [\n        \"Workspace other-workspace: partial; scope ws_goshawks_io_2mwlan does not list the workspace\",\n        \"scope ws_goshawks_io_2mwlan: arbitrary unknown scope\",\n    ] {\n        let mut d = desk(\"gateway\", reason, None).await;\n        d.workspace().await;\n        d.recheck().await;\n        assert_eq!(d.warning()[\"recheck\"][\"basis\"], \"unknown\");\n        assert!(d.warning().get(\"resolvedSecs\").is_none());\n    }\n}\n\n#[tokio::test(flavor = \"multi_thread\")]\nasync fn replaced_credential_generation_retires_pending_warning_check() {\n    let mut d = desk(\"modelSkill\", LEGACY_MODEL, Some(known(\"modelSkill\"))).await;\n    d.script.lock().expect(\"fixture script lock\").model_status[0] = 0;\n    let old_context = d.context();\n    d.send(json!({\"kind\":\"recheckSetupWarning\",\"context\":old_context,\"warning\":\"vw-1\"}))\n        .await;\n    assert!(\n        eventually(|| d\n            .server\n            .seen()\n            .iter()\n            .any(|s| s.request_line.starts_with(\"GET /aims/data/v1/scans\")))\n        .await\n    );\n    assert_eq!(d.warning()[\"recheck\"][\"state\"], \"pending\");\n    d.send(json!({\"kind\":\"configureManagementCredential\",\"context\":old_context,\"mode\":\"keychain\",\"clientId\":\"synthetic-client@1234567890.iam.panserviceaccount.com\",\"secret\":\"synthetic-replaced-warning-secret\"})).await;\n    assert!(\n        eventually(|| d.context() != old_context\n            && d.snap().tenants[0].management.state == desktop_core::ScanState::Ready)\n        .await\n    );\n    assert!(eventually(|| d.server.closed_by_client() > 0).await);\n    assert!(d.warning().get(\"resolvedSecs\").is_none());\n    assert_ne!(d.warning()[\"recheck\"][\"state\"], \"pending\");\n    d.script.lock().expect(\"fixture script lock\").model_status[0] = 200;\n    d.recheck().await;\n    assert!(d.warning()[\"resolvedSecs\"].as_u64().is_some());\n}\n\n#[tokio::test(flavor = \"multi_thread\")]\nasync fn absent_original_gateway_workspace_does_not_mean_any_workspace_matches() {\n    let reason =\n        format!(\"Workspace {WS}: partial; scope ws_goshawks_io_2mwlan does not list the workspace\");\n    let mut d = desk(\"gateway\", &reason, Some(known(\"gateway\"))).await;\n    d.workspace().await;\n    d.recheck().await;\n    assert_eq!(d.warning()[\"recheck\"][\"equivalent\"], false);\n    assert!(d.warning().get(\"resolvedSecs\").is_none());\n}\n\n#[tokio::test(flavor = \"multi_thread\")]\nasync fn known_legacy_scan_configuration_is_rechecked_locally_without_claiming_service_validity() {\n    let reason = \"No scan key saved; scans stay unavailable until one is added in Administration.\";\n    let mut d = desk_with_tsg(\"runtimeSecurity\", reason, None, None).await;\n    assert!(d.snap().tenants[0].tsg_id.is_none());\n    let context = d.context();\n    d.send(json!({\"kind\":\"configureScanCredential\",\"context\":context,\"mode\":\"keychain\",\"key\":\"synthetic-scan-key\"})).await;\n    assert!(eventually(|| d.snap().tenants[0].scan.state == desktop_core::ScanState::Ready).await);\n    d.recheck().await;\n    assert_eq!(d.warning()[\"reason\"], reason);\n    assert_eq!(d.warning()[\"recheck\"][\"state\"], \"stored\");\n    assert_eq!(d.warning()[\"recheck\"][\"basis\"], \"legacyTenantSources\");\n    assert!(d.warning()[\"resolvedSecs\"].as_u64().is_some());\n    assert!(\n        d.server.seen().is_empty(),\n        \"configuration proof never calls a product or OAuth endpoint\"\n    );\n}\n\n#[tokio::test(flavor = \"multi_thread\")]\nasync fn known_missing_selection_check_is_superseded_only_by_full_selected_prerequisites() {\n    let reason =\n        \"1 Gateway workspace(s) readable; none chosen, so its prerequisites were not checked.\";\n    let mut d = desk(\"gateway\", reason, Some(known(\"gateway\"))).await;\n    d.recheck().await;\n    assert!(\n        d.warning().get(\"resolvedSecs\").is_none(),\n        \"a listing is not selected-workspace prerequisites\"\n    );\n    d.workspace().await;\n    d.recheck().await;\n    assert_eq!(d.warning()[\"recheck\"][\"basis\"], \"recordedScope\");\n    assert!(d.warning()[\"resolvedSecs\"].as_u64().is_some());\n    assert!(\n        d.warning()[\"recheck\"][\"reason\"]\n            .as_str()\n            .expect(\"warning recheck has a reason\")\n            .contains(\"original check found no selected workspace\")\n    );\n}\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_29","type":"command_execution","command":"/bin/zsh -lc \"rg -n 'fixture_tenant_creation|CompleteSetup|BeginSetup|DiscardSetup|UpdateSetup|ConfigureManagement|reissue_setup_context' crates/desktop-core/src/authority.rs; cat apps/desktop/src/modules/tenants/management-credential.tsx\"","aggregated_output":"254:    ConfigureManagementCredential {\n794:    ConfigureManagementCredential => \"configureManagementCredential\",\n1330:    pub fixture_tenant_creation: bool,\n1354:            fixture_tenant_creation: true,\n1774:    fixture_tenant_creation: bool,\n2848:            fixture_tenant_creation: config.fixture_tenant_creation,\n2850:            fixture_tenant_creation: false,\n3724:            if !state.fixture_tenant_creation {\n4038:        Intent::ConfigureManagementCredential {\n5767:        state.reissue_setup_context();\n5846:        state.reissue_setup_context();\nimport { type FormEvent, useId, useRef, useState } from 'react'\nimport { Button, Callout, Input } from '@ai-security-academy/presentation'\nimport { AlertTriangle, CheckCircle2, Info } from 'lucide-react'\nimport type { ContextRef, StorageMode, TenantView, VaultError } from '@prisma-airs/desktop-contracts'\nimport { MANAGEMENT_FAILURE_TEXT, type ObserveManagement, readManagement } from '../administration/management-read'\nimport { type Dispatch, outcomeMessage } from './dispatch'\n\nconst FAILURE_TEXT: Record<VaultError, string> = {\n    locked: 'Secure storage is locked. Unlock it and enter the secret again, or keep it for this session only.',\n    denied: 'The system did not allow access to secure storage. Enter the secret again, or keep it for this session only.',\n    unavailable: 'The credential store is not available. Enter the secret again, or keep it for this session only.',\n    notFound: 'The stored client secret is missing. Enter it again.',\n    corrupt: 'The stored client secret could not be read. Enter it again.',\n}\n\nfunction status(tenant: TenantView): { tone: 'default' | 'success' | 'danger'; text: string } {\n    const { state, mode, failure } = tenant.management\n    switch (state) {\n        case 'missing':\n            return {\n                tone: 'default',\n                text: 'No management client. Scans do not need one; add one to read this tenant’s inventories in Administration.',\n            }\n        case 'storing':\n            return { tone: 'default', text: 'Saving the management client…' }\n        case 'ready':\n            return {\n                tone: 'success',\n                text:\n                    mode === 'session'\n                        ? 'Management client secret held for this session only.'\n                        : 'Management client secret saved in secure storage.',\n            }\n        case 'failed':\n            return { tone: 'danger', text: failure ? FAILURE_TEXT[failure] : 'The management client could not be saved.' }\n    }\n}\n\ninterface Props {\n    tenant: TenantView\n    context: ContextRef\n    dispatch: Dispatch\n    observe: ObserveManagement\n}\n\n/**\n * The tenant's separate management OAuth client (C08). It never replaces or\n * reads the scan key. The secret is read from its field at submission and\n * the field is cleared before the request is awaited; it is never held in\n * React state, storage or any snapshot. Verify authenticates the stored OAuth client without reading product inventories.\n */\nexport function ManagementCredentialForm({ tenant, context, dispatch, observe }: Props) {\n    const [mode, setMode] = useState<StorageMode>('keychain')\n    const [message, setMessage] = useState<string | null>(null)\n    const [verified, setVerified] = useState<string | null>(null)\n    const [busy, setBusy] = useState(false)\n    const secretRef = useRef<HTMLInputElement>(null)\n    const clientRef = useRef<HTMLInputElement>(null)\n    const ids = useId()\n    const shown = status(tenant)\n    const view = tenant.management\n    const hasClient = view.state === 'ready' || view.state === 'failed'\n    const noTsg = tenant.tsgId === null\n\n    async function submit(event: FormEvent<HTMLFormElement>) {\n        event.preventDefault()\n        const secretField = secretRef.current\n        const clientField = clientRef.current\n        if (!secretField || !clientField) return\n        const secret = secretField.value\n        secretField.value = ''\n        const clientId = clientField.value.trim()\n        setVerified(null)\n        if (clientId.length === 0) {\n            setMessage('Enter the client ID.')\n            clientField.focus()\n            return\n        }\n        if (secret.length === 0) {\n            setMessage('Enter the client secret.')\n            secretField.focus()\n            return\n        }\n        setBusy(true)\n        setMessage(null)\n        const outcome = await dispatch({ kind: 'configureManagementCredential', context, mode, clientId, secret })\n        setBusy(false)\n        setMessage(outcomeMessage(outcome))\n    }\n\n    async function verify() {\n        setBusy(true)\n        setMessage(null)\n        setVerified(null)\n        const outcome = await readManagement(dispatch, observe, context, { kind: 'verify' })\n        setBusy(false)\n        if (outcome.kind === 'notAdmitted') setMessage(outcome.message)\n        else if (outcome.result.kind === 'verified') setVerified('Management OAuth authentication succeeded.')\n        else if (outcome.result.kind === 'failed') setMessage(MANAGEMENT_FAILURE_TEXT[outcome.result.failure])\n        else setMessage('The service returned a reply the desktop could not use.')\n    }\n\n    async function remove() {\n        setBusy(true)\n        setMessage(null)\n        setVerified(null)\n        const outcome = await dispatch({ kind: 'removeManagementCredential', context })\n        setBusy(false)\n        setMessage(outcomeMessage(outcome))\n    }\n\n    return (\n        <section aria-labelledby={`${ids}-heading`} data-slot='management-credential' className='settings-card'>\n            <h3 id={`${ids}-heading`} className='text-academy-ink text-[14px] font-semibold'>\n                Management client\n            </h3>\n            <Callout\n                tone={shown.tone}\n                icon={shown.tone === 'success' ? CheckCircle2 : shown.tone === 'danger' ? AlertTriangle : Info}\n                role='status'\n                aria-live='polite'\n                data-slot='management-status'\n            >\n                {shown.text}\n                {view.clientId ? (\n                    <span className='text-academy-ink-soft mt-1 block text-[12px]' data-slot='management-client-id'>\n                        Client ID: {view.clientId}\n                    </span>\n                ) : null}\n            </Callout>\n            {noTsg ? (\n                <Callout tone='warning' icon={AlertTriangle} data-slot='management-no-tsg'>\n                    This tenant has no TSG ID. Add a replacement tenant with its TSG ID to configure a management client.\n                </Callout>\n            ) : null}\n            <p className='text-academy-ink-faint text-[12px]' data-slot='management-sso-pointer'>\n                Company sign-in (SSO) for the Harness is set up per Gateway workspace, in Harness.\n            </p>\n            <form onSubmit={(e) => void submit(e)} className='flex flex-col gap-3' aria-busy={busy}>\n                <label htmlFor={`${ids}-client`} className='text-academy-ink text-[13px] font-medium'>\n                    Client ID\n                </label>\n                <Input\n                    ref={clientRef}\n                    id={`${ids}-client`}\n                    name='management-client-id'\n                    autoComplete='off'\n                    autoCapitalize='off'\n                    autoCorrect='off'\n                    spellCheck={false}\n                    defaultValue={view.clientId ?? ''}\n                    maxLength={1024}\n                    data-slot='management-client-input'\n                />\n                <label htmlFor={`${ids}-secret`} className='text-academy-ink text-[13px] font-medium'>\n                    Client secret\n                </label>\n                <Input\n                    ref={secretRef}\n                    id={`${ids}-secret`}\n                    name='management-secret'\n                    type='password'\n                    autoComplete='off'\n                    autoCapitalize='off'\n                    autoCorrect='off'\n                    spellCheck={false}\n                    aria-describedby={`${ids}-hint`}\n                    data-slot='management-secret-input'\n                />\n                <p id={`${ids}-hint`} className='text-academy-ink-faint text-[12px]'>\n                    The secret is sent only to {view.tokenOrigin ?? 'the Palo Alto Networks token service'} to obtain\n                    short-lived access tokens. It is separate from the scan key.\n                </p>\n                <fieldset aria-labelledby={`${ids}-mode`} className='flex flex-col gap-1'>\n                    <legend id={`${ids}-mode`} className='text-academy-ink text-[13px] font-medium'>\n                        Keep the secret\n                    </legend>\n                    {(\n                        [\n                            ['keychain', 'In secure storage', 'Available after restarting the desktop'],\n                            ['session', 'For this session only', 'Forgotten when the desktop quits'],\n                        ] as const\n                    ).map(([value, label, hint]) => (\n                        <label key={value} className='flex min-h-8 cursor-pointer items-center gap-3'>\n                            <input\n                                type='radio'\n                                name='management-mode'\n                                value={value}\n                                checked={mode === value}\n                                onChange={() => setMode(value)}\n                                className='size-4 accent-[var(--academy-accent)]'\n                            />\n                            <span className='flex flex-col'>\n                                <span className='text-academy-ink text-[13px]'>{label}</span>\n                                <span className='text-academy-ink-faint text-[12px]'>{hint}</span>\n                            </span>\n                        </label>\n                    ))}\n                </fieldset>\n                <div className='flex flex-wrap gap-2'>\n                    <Button type='submit' tier='primary' disabled={busy || noTsg}>\n                        {hasClient ? 'Replace client' : 'Save client'}\n                    </Button>\n                    {view.state === 'ready' ? (\n                        <Button type='button' tier='secondary' disabled={busy} onClick={() => void verify()}>\n                            Verify\n                        </Button>\n                    ) : null}\n                    {hasClient ? (\n                        <Button type='button' tier='secondary' disabled={busy} onClick={() => void remove()}>\n                            Remove management client\n                        </Button>\n                    ) : null}\n                </div>\n                {verified ? (\n                    <p role='status' data-slot='management-verified' className='text-academy-ink text-[13px]'>\n                        {verified}\n                    </p>\n                ) : null}\n                {message ? (\n                    <p role='alert' data-slot='management-message' className='text-academy-accent-warn text-[13px]'>\n                        {message}\n                    </p>\n                ) : null}\n            </form>\n        </section>\n    )\n}\n","exit_code":0,"status":"completed"}}
