    record.observed = true;\n                 setup_results.push((record.operation.clone(), result.clone()));\n             }\n@@ -426,6 +428,7 @@ impl State {\n         }\n         for (operation, result) in setup_results {\n             self.setup_settled(&operation, &result);\n+            self.warning_recheck_settled(&operation, &result);\n         }\n         for (context, result) in overviews {\n             self.overview_settled(&context, result);\n@@ -467,6 +470,16 @@ impl State {\n         });\n     }\n \n+    /// Internal warning checks have no presentation result observation, even\n+    /// if their lease was retired before a management completion arrived.\n+    pub(super) fn retire_warning_check_records(&mut self, operations: &[OperationId]) {\n+        for record in &mut self.management_calls {\n+            if operations.contains(&record.operation) {\n+                record.observed = true;\n+            }\n+        }\n+    }\n+\n     /// The single observation of a management read's result.\n     pub(super) fn observe_management(\n         &mut self,\ndiff --git a/crates/desktop-core/src/authority/setup_domain.rs b/crates/desktop-core/src/authority/setup_domain.rs\nindex f4bdc9b1..cc169de3 100644\n--- a/crates/desktop-core/src/authority/setup_domain.rs\n+++ b/crates/desktop-core/src/authority/setup_domain.rs\n@@ -90,15 +90,6 @@ pub(super) fn case_products(product: ProductId) -> &'static [CaseProduct] {\n     }\n }\n \n-fn product_label(product: ProductId) -> &'static str {\n-    match product {\n-        ProductId::RuntimeSecurity => \"AI Runtime Security\",\n-        ProductId::Gateway => \"AI Gateway\",\n-        ProductId::RedTeam => \"AI Red Teaming\",\n-        ProductId::ModelSkill => \"Model and skill scans\",\n-    }\n-}\n-\n fn needs_management(product: ProductId) -> bool {\n     product != ProductId::RuntimeSecurity\n }\n@@ -111,7 +102,9 @@ fn failure_reason(failure: ManagementFailure) -> &'static str {\n         }\n         ManagementFailure::Denied => \"The management client is not allowed to read this tenant.\",\n         ManagementFailure::NotFound => \"The service found nothing for this TSG.\",\n-        ManagementFailure::RateLimited => \"The service is rate-limiting reads; try again shortly.\",\n+        ManagementFailure::RateLimited => {\n+            \"The service is rate-limiting requests; try again shortly.\"\n+        }\n         ManagementFailure::Unavailable => \"The management service could not be reached.\",\n         ManagementFailure::Rejected => \"The service rejected the request.\",\n         ManagementFailure::Timeout => \"The service did not answer in time.\",\n@@ -356,7 +349,6 @@ impl State {\n         let setup = self.setup_for(context)?;\n         let generation = setup.verify.as_ref().map_or(1, |v| v.generation + 1);\n         let signature = Self::setup_signature(setup);\n-        let mode = setup.mode;\n         let products = setup.products.clone();\n         let scan = setup.tenant.scan.clone();\n         let management_ready = matches!(setup.tenant.management, ScanCapability::Ready { .. });\n@@ -386,13 +378,9 @@ impl State {\n             ScanCapability::Storing { .. } => {\n                 (VerifyState::Fail, \"The scan key is still being saved.\")\n             }\n-            _ if mode == SetupMode::FirstRun => (\n-                VerifyState::Fail,\n-                \"No scan key saved. Runtime Security needs one on first run.\",\n-            ),\n             _ => (\n                 VerifyState::Warning,\n-                \"No scan key saved; scans stay unavailable until one is added in Administration.\",\n+                \"No scan key configured; scanning stays unavailable until one is added in Settings.\",\n             ),\n         };\n         steps.push(StepState {\n@@ -404,35 +392,20 @@ impl State {\n             },\n             operation: None,\n         });\n-        // Management client: a real verify read when one is stored.\n-        let needing: Vec