{"type":"item.completed","item":{"id":"item_41","type":"command_execution","command":"/bin/zsh -lc \"rg -n 'createTenant|beginTenantSetup|completeTenantSetup' apps/desktop/src --glob '\"'!*.test.tsx'\"' --glob '\"'!*.test.ts'\"'; sed -n '60,180p' crates/desktop-core/src/authority/management_domain.rs; sed -n '320,450p' crates/desktop-core/src/authority/management_domain.rs; sed -n '595,692p' crates/desktop-core/src/management.rs\"","aggregated_output":"apps/desktop/src/v2/store.ts:69:    return intent.kind === 'selectTenant' || intent.kind === 'completeTenantSetup' ? intent.resolution : null\napps/desktop/src/v2/wizard/wizard.tsx:178:            const promise = dispatch({ kind: 'beginTenantSetup', mode, profile: profileOf() })\napps/desktop/src/v2/wizard/wizard.tsx:334:        const outcome = await dispatch({ kind: 'completeTenantSetup', context: setup.context, packs: selectedPacks, resolution })\n    settled: bool,\n    observed: bool,\n    /// A Runtime overview read: its result also updates the shell's\n    /// Home/Inbox state.\n    overview: bool,\n    /// The Gateway workspace selection a scoped Gateway read was admitted\n    /// under: its result is withdrawn once another is chosen (C16).\n    workspace: Option<WorkspaceRef>,\n    /// A Gateway Workspaces listing: its result updates the choice.\n    lists_workspaces: bool,\n    /// One product's part of the tenant's Home read (C30, I4): its result\n    /// settles into the tenant's read record as a finite outcome.\n    read_part: Option<crate::features::ProductId>,\n    /// A Runtime API key inventory page: it reconciles key rotations (C31).\n    api_keys_page: bool,\n}\n\n/// The binding of one credential generation (context): its session and\n/// its lazily built clients.\npub(super) struct GenerationBinding {\n    context: ContextRef,\n    session: Session,\n    cell: BindingCell,\n    pub(super) investigation: Arc<Investigation>,\n}\n\nimpl State {\n    fn management_binding(\n        &mut self,\n        context: &ContextRef,\n        persistence: impl FnOnce() -> Option<Persistence>,\n    ) -> (Session, BindingCell, Arc<Investigation>) {\n        if let Some(b) = self\n            .management_bindings\n            .iter()\n            .find(|b| &b.context == context)\n        {\n            return (\n                b.session.clone(),\n                Arc::clone(&b.cell),\n                Arc::clone(&b.investigation),\n            );\n        }\n        let binding = GenerationBinding {\n            context: context.clone(),\n            session: Session::new(),\n            cell: BindingCell::default(),\n            investigation: Investigation::new(persistence()),\n        };\n        let triple = (\n            binding.session.clone(),\n            Arc::clone(&binding.cell),\n            Arc::clone(&binding.investigation),\n        );\n        self.management_bindings.push(binding);\n        triple\n    }\n\n    /// The active context's investigation, when its binding exists.\n    pub(super) fn investigation(&self, context: &ContextRef) -> Option<Arc<Investigation>> {\n        self.management_bindings\n            .iter()\n            .find(|b| &b.context == context)\n            .map(|b| Arc::clone(&b.investigation))\n    }\n\n    /// Cancels every binding but the current context's (its session ends\n    /// in-flight reads; its token cache is dropped with it).\n    /// Retires the binding cached under one context (C29: a setup draft's\n    /// context when its credentials or profile change).\n    pub(super) fn retire_management_binding(&mut self, context: &ContextRef) {\n        self.management_bindings.retain(|b| {\n            if &b.context == context {\n                b.session.cancel();\n                b.investigation.retire();\n                false\n            } else {\n                true\n            }\n        });\n    }\n\n    pub(super) fn retire_management_bindings(&mut self) {\n        let keep = self.active_ref.clone();\n        self.management_bindings.retain(|b| {\n            let current = Some(&b.context) == keep.as_ref();\n            if !current {\n                b.session.cancel();\n                // A write already admitted for this cache finds it retired\n                // and places nothing (the credential's cleanup may follow).\n                b.investigation.retire();\n            }\n            current\n        });\n    }\n\n    /// Admits one management read for the active tenant's management\n    /// capability. The scan key is never consulted.\n    /// The active tenant's management binding inputs, checked: a ready\n    /// management credential, its client ID and TSG, and the configured\n    /// token origin equal to the one the credential was stored for. The scan\n    /// key is never consulted.\n    pub(super) fn binding_source(\n        &mut self,\n        context: &ContextRef,\n        keychain: Arc<dyn super::CredentialStore>,\n        session_vault: Arc<SessionVault>,\n    ) -> Result<BindingSource, Refusal> {\n        let tenant = self.check_context(context)?;\n        let current = self.tenant(&tenant).ok_or(Refusal::StaleContext)?;\n        let (record, mode, destination) = match &current.management {\n            ScanCapability::Ready {\n                record,\n                mode,\n                destination,\n            } => (record.clone(), *mode, destination.clone()),\n            _ => return Err(Refusal::CapabilityMissing),\n        };\n        let client_id = current\n            .management_client\n            .clone()\n        let request = match product {\n            crate::features::ProductId::RedTeam => ManagementRequest::RedTeam { window: 7 },\n            crate::features::ProductId::ModelSkill => ManagementRequest::SupplyChain,\n            _ => return Err(Refusal::InvalidInput),\n        };\n        let admitted = self.admit_management(context.clone(), request, keychain, session_vault)?;\n        if let Some(record) = self.management_calls.last_mut() {\n            record.read_part = Some(product);\n            record.observed = true;\n        }\n        self.read_part_started(&context);\n        Ok(admitted)\n    }\n\n    /// Delivers settled management results to their single observation.\n    pub(super) fn sync_management_calls(&mut self) {\n        let current = self.active_ref.clone();\n        let mut overviews = Vec::new();\n        let mut parts = Vec::new();\n        let mut key_pages = Vec::new();\n        let mut listings = Vec::new();\n        // A setup's verify reads (C29) belong to the draft's context and\n        // settle into its lines instead of an observation.\n        let setup_context = self.data.setup.as_ref().map(|s| s.context.clone());\n        let setup_operations = self.setup_operations();\n        let warning_operations = self.warning_recheck_operations();\n        let mut setup_results = Vec::new();\n        let selected = self.gateway_selection();\n        let setup_selected = self.setup_workspace_reference();\n        for record in self.management_calls.iter_mut().filter(|r| !r.settled) {\n            let settlement = match self.operations.state(&record.operation) {\n                Some(OperationState::Settled(s)) => s,\n                None => Settlement {\n                    outcome: Outcome::Unknown,\n                    stop: None,\n                },\n                Some(_) => continue,\n            };\n            record.settled = true;\n            let reply = record.slot.lock().ok().and_then(|mut s| s.take());\n            let for_setup = setup_operations.contains(&record.operation)\n                || warning_operations.contains(&record.operation);\n            // The draft's context stays current for every read admitted under\n            // it (its verify lines and the presentation's own reads, such as\n            // the Gateway workspace listing) until the draft ends.\n            let retired = (current.as_ref() != Some(&record.context)\n                && setup_context.as_ref() != Some(&record.context))\n                || record.workspace.as_ref().is_some_and(|w| {\n                    selected.as_ref() != Some(w) && setup_selected.as_ref() != Some(w)\n                });\n            let result = match (reply, retired, settlement.stop) {\n                // A reply for a retired context is never shown.\n                (_, true, _) | (_, _, Some(_)) | (None, _, _) => ManagementResult::Failed {\n                    failure: ManagementFailure::Cancelled,\n                    outcome: settlement.outcome,\n                },\n                (Some(result), false, None) => result,\n            };\n            if record.overview {\n                overviews.push((record.context.clone(), result.clone()));\n            }\n            if let Some(product) = record.read_part {\n                parts.push((record.context.clone(), product, result.clone()));\n            }\n            if record.api_keys_page && !retired {\n                match &result {\n                    ManagementResult::Page { page } => {\n                        // The whole inventory in one read: the first page,\n                        // and the last.\n                        key_pages.push(KeyRead::Items(\n                            record.context.clone(),\n                            page.items.clone(),\n                            page.offset == 0 && page.complete,\n                        ));\n                    }\n                    ManagementResult::Detail { detail } => match (&detail.found, &detail.item) {\n                        (crate::management::DetailFound::Found, Some(item)) => {\n                            key_pages.push(KeyRead::Items(\n                                record.context.clone(),\n                                format!(\"[{item}]\"),\n                                false,\n                            ));\n                        }\n                        (crate::management::DetailFound::Absent, _) => {\n                            key_pages\n                                .push(KeyRead::Absent(record.context.clone(), detail.id.clone()));\n                        }\n                        _ => {}\n                    },\n                    _ => {}\n                }\n            }\n            if record.lists_workspaces\n                && let ManagementResult::Gateway {\n                    gateway: crate::gateway::GatewayResult::List { list },\n                } = &result\n            {\n                listings.push((record.context.clone(), list.clone()));\n            }\n            if for_setup {\n                // Consumed by setup or a warning recheck; nothing observes it.\n                record.observed = true;\n                setup_results.push((record.operation.clone(), result.clone()));\n            }\n            if let Ok(mut slot) = record.cell.result.lock() {\n                *slot = Some(result);\n            }\n            record.cell.ready.notify_waiters();\n        }\n        for (operation, result) in setup_results {\n            self.setup_settled(&operation, &result);\n            self.warning_recheck_settled(&operation, &result);\n        }\n        for (context, result) in overviews {\n            self.overview_settled(&context, result);\n        }\n        for (context, product, result) in parts {\n            self.product_read_settled(&context, product, &result);\n        }\n        for read in key_pages {\n            match read {\n                KeyRead::Items(context, items, whole) => {\n                    if let Ok(tenant) = self.check_context(&context)\n                        && let Ok(items) = serde_json::from_str::<Vec<serde_json::Value>>(&items)\n                    {\n                        self.rotation_reconcile(&tenant, &items, whole);\n                    }\n                }\n                KeyRead::Absent(context, id) => {\n                    if let Ok(tenant) = self.check_context(&context) {\n                        self.rotation_key_absent(&tenant, &id);\n            &endpoints.red_team_broker,\n            &endpoints.model_data,\n            &endpoints.model_mgmt,\n            &endpoints.agentguard_data,\n            &endpoints.agentguard_mgmt,\n            &endpoints.gateway_data,\n            &endpoints.gateway_admin,\n            &endpoints.gateway_iam,\n        ]\n        .map(|url| parse(url));\n        let [\n            rt_data,\n            rt_mgmt,\n            rt_broker,\n            ms_data,\n            ms_mgmt,\n            ag_data,\n            ag_mgmt,\n            gw_data,\n            gw_admin,\n            gw_iam,\n        ] = products;\n        let (rt_data, rt_mgmt, rt_broker) = (rt_data?, rt_mgmt?, rt_broker?);\n        let (ms_data, ms_mgmt, ag_data, ag_mgmt) = (ms_data?, ms_mgmt?, ag_data?, ag_mgmt?);\n        let (gw_data, gw_admin, gw_iam) = (gw_data?, gw_admin?, gw_iam?);\n        let all = [\n            &token, &api, &dlp, &rt_data, &rt_mgmt, &rt_broker, &ms_data, &ms_mgmt, &ag_data,\n            &ag_mgmt, &gw_data, &gw_admin, &gw_iam,\n        ];\n        if !all.iter().all(|e| e.origin().starts_with(\"https://\")) {\n            return Err(ManagementFailure::Destination);\n        }\n        let context = AuthContext::new(token.clone(), client_id, 1, tsg)\n            .map_err(|_| ManagementFailure::Configuration)?;\n        let secret =\n            Secret::new(secret.as_str()).map_err(|_| ManagementFailure::CredentialMissing)?;\n        let policy = Arc::new(OriginPolicy::new(all.map(Endpoint::clone)));\n        let oauth = Arc::new(\n            OAuthProvider::new(\n                context,\n                secret,\n                Arc::clone(&transport),\n                policy.clone(),\n                session.clone(),\n            )\n            .map_err(|_| ManagementFailure::Configuration)?,\n        );\n        let client = Client::builder(api.clone())\n            .authentication(Authentication::oauth(oauth.clone(), false))\n            .transport(transport)\n            .destination_policy(policy)\n            .limits(limits())\n            .session(session)\n            .build()\n            .map_err(|_| ManagementFailure::Configuration)?;\n        let management =\n            ManagementClient::new(client).map_err(|_| ManagementFailure::Configuration)?;\n        let configured = |_| ManagementFailure::Configuration;\n        let red_team = RedTeamClient::new(\n            management\n                .client()\n                .with_endpoint(rt_data)\n                .map_err(configured)?,\n            rt_mgmt,\n            rt_broker,\n        )\n        .map_err(configured)?;\n        let model_security =\n            ModelSecurityClient::new(management.client().clone(), ms_data, ms_mgmt)\n                .map_err(configured)?;\n        let agentguard = AgentGuardClient::new(management.client().clone(), ag_data, ag_mgmt)\n            .map_err(configured)?;\n        let gateway = AIGatewayClient::new(\n            management\n                .client()\n                .with_endpoint(gw_data)\n                .map_err(configured)?,\n            gw_admin,\n            gw_iam,\n        )\n        .map_err(configured)?;\n        let dlp = management.dlp(dlp).map_err(configured)?;\n        Ok(Self {\n            oauth,\n            management,\n            dlp,\n            red_team,\n            model_security,\n            agentguard,\n            gateway,\n        })\n    }\n\n    /// The Gateway client over this binding's management credential (C16).\n    pub(crate) fn gateway(&self) -> &AIGatewayClient {\n        &self.gateway\n    }\n\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_42","type":"command_execution","command":"/bin/zsh -lc \"sed -n '973,1198p' crates/desktop-core/tests/ui_v2_setup_reads/main.rs; sed -n '263,437p' crates/desktop-core/tests/ui_v2_onboarding/main.rs\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_42","type":"command_execution","command":"/bin/zsh -lc \"sed -n '973,1198p' crates/desktop-core/tests/ui_v2_setup_reads/main.rs; sed -n '263,437p' crates/desktop-core/tests/ui_v2_onboarding/main.rs\"","aggregated_output":"#[tokio::test]\nasync fn refinement_oauth_authentication_does_not_require_profile_permission() {\n    let mut desk = desk().await;\n    desk.script.lock().expect(\"script\").routes.insert(\n        format!(\"/aisec/v1/mgmt/profiles/tsg/{TSG}\"),\n        (403, json!({\"error\": \"profile permission denied\"})),\n    );\n    desk.send(\n        json!({\"kind\": \"beginTenantSetup\", \"mode\": \"firstRun\", \"profile\": {\n            \"label\": \"OAuth only\", \"tsgId\": TSG,\n            \"destination\": {\"kind\": \"region\", \"region\": \"europe\"}\n        }}),\n    )\n    .await\n    .expect(\"draft\");\n    let context = desk.draft_context();\n    desk.send(\n        json!({\"kind\": \"configureManagementCredential\", \"context\": context,\n            \"mode\": \"keychain\", \"clientId\": CLIENT_ID, \"secret\": CLIENT_SECRET\n        }),\n    )\n    .await\n    .expect(\"management credential\");\n    assert!(eventually(|| desk.setup().tenant.management.state == ScanState::Ready).await);\n    let context = desk.draft_context();\n    desk.send(json!({\"kind\": \"verifyTenantSetup\", \"context\": context}))\n        .await\n        .expect(\"verify\");\n    let verify = desk.verified().await;\n    let auth = verify\n        .steps\n        .iter()\n        .find(|s| s.line == VerifyLine::ManagementClient)\n        .expect(\"auth line\");\n    assert_eq!(\n        auth.state,\n        VerifyState::Pass,\n        \"OAuth succeeds independently of Runtime profile permission: {}\",\n        auth.reason\n    );\n    assert!(\n        !verify.blocking && desk.setup().completable,\n        \"a missing scan key does not block authenticated first-run\"\n    );\n    assert!(!desk.setup().scan_required);\n    assert!(\n        desk._server\n            .seen()\n            .iter()\n            .all(|request| !request.request_line.contains(\"/profiles/\")),\n        \"authentication must not inventory Runtime profiles\"\n    );\n    desk.send(json!({\"kind\": \"completeTenantSetup\", \"context\": context, \"packs\": []}))\n        .await\n        .expect(\"complete\");\n    let snapshot = desk.snap();\n    assert_eq!(snapshot.tenants.len(), 1);\n    assert_eq!(snapshot.tenants[0].scan.state, ScanState::Missing);\n    assert_eq!(\n        snapshot.onboarding,\n        desktop_core::features::OnboardingState::Done\n    );\n}\n\n#[tokio::test]\nasync fn refinement_missing_oauth_cannot_complete_an_add_draft() {\n    let mut desk = desk().await;\n    desk.send(\n        json!({\"kind\": \"beginTenantSetup\", \"mode\": \"add\", \"profile\": {\n            \"label\": \"No OAuth\", \"tsgId\": TSG,\n            \"destination\": {\"kind\": \"region\", \"region\": \"europe\"}\n        }}),\n    )\n    .await\n    .expect(\"draft\");\n    let context = desk.draft_context();\n    desk.send(json!({\"kind\": \"verifyTenantSetup\", \"context\": context}))\n        .await\n        .expect(\"verify\");\n    let verify = desk.verified().await;\n    assert!(\n        verify.blocking && !desk.setup().completable,\n        \"missing management OAuth must block Add as well as first-run\"\n    );\n    assert_eq!(\n        desk.send(json!({\"kind\": \"completeTenantSetup\", \"context\": context, \"packs\": []}))\n            .await,\n        Err(Refusal::InvalidInput)\n    );\n    assert!(desk.snap().tenants.is_empty());\n    assert!(\n        desk._server.seen().is_empty(),\n        \"missing credentials initiate no network call\"\n    );\n}\n\n#[tokio::test]\nasync fn refinement_invalid_oauth_cannot_complete_an_add_draft() {\n    let mut desk = desk().await;\n    desk.script.lock().expect(\"script\").token_status = 401;\n    desk.send(\n        json!({\"kind\": \"beginTenantSetup\", \"mode\": \"add\", \"profile\": {\n            \"label\": \"Invalid OAuth\", \"tsgId\": TSG,\n            \"destination\": {\"kind\": \"region\", \"region\": \"europe\"}\n        }}),\n    )\n    .await\n    .expect(\"draft\");\n    let context = desk.draft_context();\n    desk.send(\n        json!({\"kind\": \"configureManagementCredential\", \"context\": context,\n            \"mode\": \"keychain\", \"clientId\": CLIENT_ID, \"secret\": CLIENT_SECRET\n        }),\n    )\n    .await\n    .expect(\"management credential\");\n    assert!(eventually(|| desk.setup().tenant.management.state == ScanState::Ready).await);\n    let context = desk.draft_context();\n    desk.send(json!({\"kind\": \"verifyTenantSetup\", \"context\": context}))\n        .await\n        .expect(\"verify\");\n    let verify = desk.verified().await;\n    assert!(\n        verify.blocking && !desk.setup().completable,\n        \"invalid OAuth is a blocking authentication failure, not an optional product warning\"\n    );\n    assert_eq!(\n        desk.send(json!({\"kind\": \"completeTenantSetup\", \"context\": context, \"packs\": []}))\n            .await,\n        Err(Refusal::InvalidInput)\n    );\n    assert!(desk.snap().tenants.is_empty());\n}\n\n#[tokio::test]\nasync fn refinement_production_policy_rejects_the_legacy_create_tenant_bypass() {\n    // This uses the same actor/intent path as production, with the fixture-only\n    // compatibility capability explicitly disabled as it is in shipping builds.\n    let mut desk = desk_with_fixture_creation(false).await;\n    assert_eq!(\n        desk.send(json!({\"kind\": \"createTenant\", \"profile\": {\n            \"label\": \"Bypass\", \"tsgId\": TSG,\n            \"destination\": {\"kind\": \"region\", \"region\": \"europe\"}\n        }}))\n        .await,\n        Err(Refusal::InvalidInput)\n    );\n    assert!(desk.snap().tenants.is_empty());\n    assert!(desk.snap().active.is_none());\n    assert!(desk._server.seen().is_empty());\n}\n\nasync fn issuer_failure_keeps_its_cause(status: u16, expected: ManagementFailure) {\n    let mut desk = desk_with_fixture_creation(false).await;\n    desk.send(\n        json!({\"kind\": \"beginTenantSetup\", \"mode\": \"add\", \"profile\": {\n            \"label\": \"Issuer failure\", \"tsgId\": TSG,\n            \"destination\": {\"kind\": \"region\", \"region\": \"europe\"}\n        }}),\n    )\n    .await\n    .expect(\"draft\");\n    let context = desk.draft_context();\n    desk.send(\n        json!({\"kind\": \"configureManagementCredential\", \"context\": context,\n            \"mode\": \"session\", \"clientId\": CLIENT_ID, \"secret\": CLIENT_SECRET\n        }),\n    )\n    .await\n    .expect(\"client\");\n    assert!(eventually(|| desk.setup().tenant.management.state == ScanState::Ready).await);\n    let context = desk.draft_context();\n    desk.script.lock().expect(\"script\").token_status = status;\n    let result = desk.read(&context, json!({\"kind\": \"verify\"})).await;\n    assert!(\n        matches!(result, ManagementResult::Failed { failure, .. } if failure == expected),\n        \"issuer {status}: {result:?}\"\n    );\n    desk.send(json!({\"kind\": \"verifyTenantSetup\", \"context\": context}))\n        .await\n        .expect(\"verify draft\");\n    let verify = desk.verified().await;\n    assert!(verify.blocking && !desk.setup().completable);\n    assert_eq!(\n        desk.send(json!({\"kind\": \"completeTenantSetup\", \"context\": context, \"packs\": []}))\n            .await,\n        Err(Refusal::InvalidInput)\n    );\n    assert!(desk.snap().tenants.is_empty());\n    assert!(\n        desk._server\n            .seen()\n            .iter()\n            .all(|request| request.request_line.contains(\"/oauth2/access_token\")),\n        \"a failed grant must not become a product permission probe\"\n    );\n}\n\n#[tokio::test]\nasync fn refinement_issuer_400_is_an_authentication_failure() {\n    issuer_failure_keeps_its_cause(400, ManagementFailure::Unauthorized).await;\n}\n\n#[tokio::test]\nasync fn refinement_issuer_401_is_an_authentication_failure() {\n    issuer_failure_keeps_its_cause(401, ManagementFailure::Unauthorized).await;\n}\n\n#[tokio::test]\nasync fn refinement_issuer_403_does_not_prove_authentication() {\n    issuer_failure_keeps_its_cause(403, ManagementFailure::Unauthorized).await;\n}\n\n#[tokio::test]\nasync fn refinement_issuer_429_retains_the_rate_limit_cause() {\n    issuer_failure_keeps_its_cause(429, ManagementFailure::RateLimited).await;\n}\n\n#[tokio::test]\nasync fn refinement_issuer_503_retains_the_service_failure_cause() {\n    issuer_failure_keeps_its_cause(503, ManagementFailure::Unavailable).await;\n}\nasync fn changing_inputs_makes_authentication_stale_and_product_permissions_warn() {\n    let mut desk = Desk::new().await;\n    let context = desk.begin(\"firstRun\", \"Northwind Health\").await;\n    desk.send(json!({\"kind\": \"configureScanCredential\", \"context\": context, \"mode\": \"session\", \"key\": KEY}))\n        .await\n        .expect(\"key\");\n    desk.settled(true).await;\n    let context = desk.management(\"session\").await;\n    desk.send(json!({\"kind\": \"verifyTenantSetup\", \"context\": context}))\n        .await\n        .expect(\"verify\");\n    let first = desk.verified().await;\n    assert_eq!(first.generation, 1);\n    // Choosing Gateway afterwards invalidates the run; completion is refused.\n    desk.send(json!({\"kind\": \"chooseSetupProducts\", \"context\": context, \"products\": [\"gateway\", \"gateway\", \"redTeam\"]}))\n        .await\n        .expect(\"products\");\n    let setup = desk.setup();\n    assert_eq!(\n        setup.products,\n        vec![\n            ProductId::RuntimeSecurity,\n            ProductId::Gateway,\n            ProductId::RedTeam\n        ]\n    );\n    assert!(setup.verify.expect(\"kept\").stale && !setup.completable);\n    assert_eq!(\n        desk.send(json!({\"kind\": \"completeTenantSetup\", \"context\": context, \"packs\": []}))\n            .await,\n        Err(Refusal::InvalidInput)\n    );\n    desk.send(json!({\"kind\": \"verifyTenantSetup\", \"context\": context}))\n        .await\n        .expect(\"verify again\");\n    let second = desk.verified().await;\n    assert_eq!(second.generation, 2);\n    assert!(!second.stale);\n    let lines: Vec<(VerifyLine, VerifyState)> =\n        second.steps.iter().map(|s| (s.line, s.state)).collect();\n    assert_eq!(\n        lines,\n        vec![\n            (VerifyLine::ScanKey, VerifyState::Stored),\n            (VerifyLine::ManagementClient, VerifyState::Pass),\n            (VerifyLine::Gateway, VerifyState::Fail),\n            (VerifyLine::RedTeam, VerifyState::Fail),\n            (VerifyLine::Ais, VerifyState::Unavailable),\n            (VerifyLine::Aes, VerifyState::Unavailable),\n        ]\n    );\n    assert_eq!(second.warnings.len(), 2);\n    assert_eq!(second.warnings[0].product, ProductId::Gateway);\n    assert!(desk.setup().completable, \"warnings do not block completion\");\n    // A profile change (new destination) retires the key and goes stale.\n    desk.send(\n        json!({\"kind\": \"updateTenantSetup\", \"context\": context, \"profile\": {\n        \"label\": \"Northwind Health\", \"tsgId\": \"1234567890\",\n        \"destination\": {\"kind\": \"region\", \"region\": \"unitedStates\"}, \"environment\": \"production\"}}),\n    )\n    .await\n    .expect(\"updated\");\n    let setup = desk.setup();\n    assert_eq!(setup.tenant.scan.state, desktop_core::ScanState::Missing);\n    assert_eq!(\n        setup.tenant.environment,\n        desktop_core::features::TenantEnvironment::Production\n    );\n    assert!(\n        setup.verify.is_none() && !setup.completable,\n        \"the run went with the old context\"\n    );\n    assert_ne!(\n        setup.context.as_str(),\n        context,\n        \"a profile change retires the draft's context\"\n    );\n    assert_eq!(\n        desk.send(json!({\"kind\": \"verifyTenantSetup\", \"context\": context}))\n            .await,\n        Err(Refusal::StaleContext)\n    );\n}\n\n#[tokio::test]\nasync fn completion_commits_the_draft_once_with_products_warnings_and_onboarding() {\n    let mut desk = Desk::new().await;\n\n    desk.send(json!({\"kind\": \"setOnboarding\", \"state\": \"inProgress\"}))\n        .await\n        .expect(\"in progress\");\n    let context = desk.begin(\"firstRun\", \"Northwind Health\").await;\n    desk.send(json!({\"kind\": \"configureScanCredential\", \"context\": context, \"mode\": \"session\", \"key\": KEY}))\n        .await\n        .expect(\"key\");\n    desk.settled(true).await;\n    let context = desk.management(\"session\").await;\n    desk.send(json!({\"kind\": \"chooseSetupProducts\", \"context\": context, \"products\": [\"gateway\"]}))\n        .await\n        .expect(\"products\");\n    desk.send(json!({\"kind\": \"verifyTenantSetup\", \"context\": context}))\n        .await\n        .expect(\"verify\");\n    desk.verified().await;\n    // A pack for an unchosen product is refused.\n    assert_eq!(\n        desk.send(json!({\"kind\": \"completeTenantSetup\", \"context\": context, \"packs\": [\"redTeam\"]}))\n            .await,\n        Err(Refusal::InvalidInput)\n    );\n    desk.send(\n        json!({\"kind\": \"completeTenantSetup\", \"context\": context, \"packs\": [\"runtimeSecurity\"]}),\n    )\n    .await\n    .expect(\"completed\");\n    let snap = desk.snap();\n    assert!(snap.setup.is_none());\n    assert_eq!(snap.tenants.len(), 1);\n    let tenant = &snap.tenants[0];\n    assert_eq!(tenant.label, \"Northwind Health\");\n    assert_eq!(\n        tenant.products,\n        vec![ProductId::RuntimeSecurity, ProductId::Gateway]\n    );\n    assert_eq!(\n        tenant.scan.state,\n        desktop_core::ScanState::Ready,\n        \"the key moved with it\"\n    );\n    assert_eq!(\n        tenant.setup_warnings.len(),\n        1,\n        \"product permission warning only\"\n    );\n    assert_eq!(tenant.setup_warnings[0].id, \"vw-1\");\n    assert_eq!(tenant.setup_warnings[0].product, ProductId::Gateway);\n    assert!(tenant.setup_warnings[0].recorded_secs > 1_700_000_000);\n    assert_eq!(\n        snap.active.as_ref().map(|a| &a.tenant),\n        Some(&tenant.id),\n        \"active once\"\n    );\n    assert_ne!(\n        snap.active.as_ref().map(|a| a.context.as_str()),\n        Some(context.as_str()),\n        \"a fresh context, not the draft's\"\n    );\n    assert_eq!(snap.onboarding, OnboardingState::Done);\n    assert_eq!(snap.active_feature, desktop_core::features::FeatureId::Home);\n    // The draft's context is retired with it.\n    assert_eq!(\n        desk.send(json!({\"kind\": \"verifyTenantSetup\", \"context\": context}))\n            .await,\n        Err(Refusal::StaleContext)\n    );\n    let saved = desk.adapters.store.saved().expect(\"saved\");\n    assert!(saved.tenant_draft.is_none());\n    assert_eq!(saved.tenant_warnings.len(), 1);\n    let desk = desk.restart().await;\n    let snap = desk.snap();\n    assert_eq!(snap.onboarding, OnboardingState::Done);\n    assert_eq!(snap.tenants[0].setup_warnings.len(), 1, \"restored\");\n    assert_eq!(\n        snap.tenants[0].management.state,\n        desktop_core::ScanState::Missing,\n        \"session-only OAuth is not resurrected\"\n    );\n    assert_eq!(\n        snap.onboarding,\n        OnboardingState::Done,\n        \"existing tenants do not reenter onboarding when session credentials disappear\"\n    );\n}\n\n#[tokio::test]\n","exit_code":0,"status":"completed"}}
