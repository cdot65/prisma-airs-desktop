ytes = std::fs::read(&p).expect(\"protected history\");\n            (p, bytes)\n        })\n        .collect();\n    assert!(\n311:    async fn tenant_with_products(&mut self, label: &str, products: &[&str]) -> String {\n759:    desk.tenant_with_products(\n883:    desk.tenant_with_products(\"Tenant T\", &[\"runtimeSecurity\", \"redTeam\", \"modelSkill\"])\n1156:    desk.tenant_with_products(\"Tenant P\", &[\"runtimeSecurity\", \"redTeam\"])\n1241:    desk.tenant_with_products(\"Tenant U\", &[\"runtimeSecurity\", \"redTeam\", \"modelSkill\"])\n1279:    desk.tenant_with_products(\"Tenant V\", &[\"runtimeSecurity\", \"redTeam\"])\n1309:    desk.tenant_with_products(\"Tenant W\", &[\"runtimeSecurity\", \"redTeam\"])\nchanged paths ['.gitattributes', 'AGENTS.md', 'apps/desktop/src/v2/admin/administration.test.tsx', 'apps/desktop/src/v2/modal.tsx', 'apps/desktop/src/v2/v2-shell.test.tsx', 'apps/desktop/src/v2/v2-shell.tsx', 'crates/xtask/examples/p11_affected.rs', 'tools/p11/README.md', 'tools/p11/proof.py', 'tools/p11/standing.py', 'tools/p11/test_proof.py']\naffected {'check': ['C46/check/1', 'C46/check/4'], 'test': ['C46/frontend/1', 'C46/frontend/2', 'C46/frontend/3', 'C46/frontend/4', 'C46/frontend/5', 'C47/fixture', 'C47/frontend/2', 'C47/frontend/3', 'C47/frontend/4', 'C48/frontend/1', 'C48/frontend/2', 'C49/frontend/1']}\nreason The real desktop Modal composition/focus fix and its App-level regressions affect frontend consumers. Current formatting, desktop typecheck and all 12 registered frontend groups executed in worf-vm. Eight Rust test commands and seven other source checks retain original Kirk provenance because their complete conservative source/dependency closure is unchanged and the actual compiler/Cargo/Node/pnpm binaries match; only rustup selector shims differ. No original result is relabelled or reported as a VM execution.\n['New first-run and Add/replacement tenant require actual successful management OAuth before commitment. Invalid/missing OAuth ca