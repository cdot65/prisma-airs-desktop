{"type":"item.completed","item":{"id":"item_50","type":"command_execution","command":"/bin/zsh -lc \"cat tools/native-acceptance/candidate_process.py; rg -n '\"'^class|def (launch|front|keys|ax|tree|running_pid|stop_app|stop_engines)|candidate'\"' tools/native-acceptance/fixture_app.py; sed -n '155,310p' tools/native-acceptance/fixture_app.py; cat crates/desktop-core/tests/refinement_metadata.rs\"","aggregated_output":"\"\"\"C45 fixture process ownership: exact bundle, executable and PID lifetime.\n\nNo process-name signaling, argument inspection, foreign adoption or installed-app\nlookup. macOS struct layout comes from the selected SDK sys/proc_info.h.\n\"\"\"\nfrom dataclasses import dataclass\nfrom pathlib import Path\nimport ctypes\nimport hashlib\nimport json\nimport os\nimport plistlib\nimport signal\nimport subprocess\nimport sys\nimport time\n\nFIXTURE_ID = 'io.cdot.airs-desktop.fixture'\nEXECUTABLE = 'prisma-airs-desktop'\n\n@dataclass(frozen=True)\nclass Identity:\n    pid: int\n    executable: str\n    birth: tuple\n    parent: int\n\nclass _BsdInfo(ctypes.Structure):\n    _fields_ = [('header', ctypes.c_uint32 * 12), ('comm', ctypes.c_char * 16),\n                ('name', ctypes.c_char * 32), ('misc', ctypes.c_uint32 * 5),\n                ('nice', ctypes.c_int32), ('seconds', ctypes.c_uint64), ('micros', ctypes.c_uint64)]\n\nclass MacProcesses:\n    def __init__(self):\n        if sys.platform != 'darwin':\n            raise RuntimeError('native process ownership requires macOS')\n        self.lib = ctypes.CDLL('/usr/lib/libproc.dylib', use_errno=True)\n        self.lib.proc_pidpath.argtypes = [ctypes.c_int, ctypes.c_void_p, ctypes.c_uint32]\n        self.lib.proc_pidpath.restype = ctypes.c_int\n        self.lib.proc_pidinfo.argtypes = [ctypes.c_int, ctypes.c_int, ctypes.c_uint64, ctypes.c_void_p, ctypes.c_int]\n        self.lib.proc_pidinfo.restype = ctypes.c_int\n\n    def snapshot(self, pid):\n        path = ctypes.create_string_buffer(4096)\n        info = _BsdInfo()\n        if self.lib.proc_pidpath(pid, path, len(path)) <= 0:\n            return None\n        if self.lib.proc_pidinfo(pid, 3, 0, ctypes.byref(info), ctypes.sizeof(info)) != ctypes.sizeof(info):\n            return None\n        if info.header[3] != pid:\n            return None\n        return Identity(pid, os.path.realpath(os.fsdecode(path.value)), (info.seconds, info.micros), info.header[4])\n\n    def pids(self):\n        return [int(p) for p in subprocess.check_output(['/bin/ps', '-axo', 'pid='], text=True).split()]\n\n    def send(self, pid, sig):\n        os.kill(pid, sig)\n\nclass Candidate:\n    def __init__(self, bundle, processes=None, record=None):\n        self.bundle = Path(bundle).resolve(strict=True)\n        info = plistlib.loads((self.bundle/'Contents/Info.plist').read_bytes())\n        if info.get('CFBundleIdentifier') != FIXTURE_ID or info.get('CFBundleExecutable') != EXECUTABLE:\n            raise ValueError('only the chosen C45 fixture bundle is allowed')\n        app_path=(self.bundle/'Contents/MacOS'/EXECUTABLE).resolve(strict=True)\n        engine_path=(self.bundle/'Contents/Resources/harness/airs-harness').resolve()\n        if not app_path.is_relative_to(self.bundle) or not engine_path.is_relative_to(self.bundle):\n            raise ValueError('candidate executable or engine escapes its fixture bundle')\n        self.app_path=str(app_path)\n        self.engine_path=str(engine_path)\n        self.processes = processes if processes is not None else MacProcesses()\n        self.record = Path(record) if record else None\n        self.app = None\n        self.engines_owned = {}\n        self.child = None\n\n    def matching(self, path):\n        return [s for pid in self.processes.pids() if (s := self.processes.snapshot(pid)) and s.executable == path]\n\n    def valid(self, identity):\n        if identity is None:return False\n        current=self.processes.snapshot(identity.pid)\n        return current is not None and (current.pid,current.executable,current.birth)==(identity.pid,identity.executable,identity.birth)\n\n    def publish(self):\n        if self.record:\n            def value(s):return dict(pid=s.pid, executable=s.executable, birth=s.birth, parent=s.parent)\n            data={'schema':'airs-desktop/candidate-processes/1','bundle':str(self.bundle),\n                  'app':value(self.app) if self.app else None,\n                  'engines':[value(s) for s in self.engines_owned.values()],\n                  'meaning':'Observed exact executable/PID birth identities owned by this driver; no process-name or installed-app lookup.'}\n            self.record.parent.mkdir(parents=True,exist_ok=True)\n            self.record.write_text(json.dumps(data,indent=2)+'\\n')\n\n    def app_pid(self):\n        matches = self.matching(self.app_path)\n        if len(matches)>1:\n            raise RuntimeError('multiple candidate processes; no UI or signal allowed')\n        if self.valid(self.app):return self.app.pid\n        if matches:\n            raise RuntimeError('candidate process is not owned by this driver; inspect durable ownership')\n        return None\n\n    def adopt_child(self, pid, parent):\n        identity=self.processes.snapshot(pid)\n        if not identity or identity.executable!=self.app_path or identity.parent!=parent:\n            raise RuntimeError('launched child identity does not match the bound fixture')\n        self.app=identity;self.publish();return pid\n\n    def launch(self):\n        if self.matching(self.app_path) or self.matching(self.engine_path):\n            raise RuntimeError('unowned candidate process exists; no automatic cleanup or duplicate writer')\n        self.child=subprocess.Popen([self.app_path], stdin=subprocess.DEVNULL,\n                                    stdout=subprocess.DEVNULL,stderr=subprocess.DEVNULL)\n        deadline=time.monotonic()+6\n        while time.monotonic()<deadline:\n            if self.child.poll() is not None:raise RuntimeError('fixture executable exited during launch')\n            s=self.processes.snapshot(self.child.pid)\n            if s and s.executable==self.app_path:return self.adopt_child(self.child.pid,os.getpid())\n            time.sleep(.05)\n        raise RuntimeError('fixture child identity was not observed')\n\n    def engines(self):\n        app_pid=self.app_pid()\n        for identity in self.matching(self.engine_path):\n            current=identity;seen=set()\n            while app_pid and current and current.pid not in seen:\n                if current.parent==app_pid:\n                    self.engines_owned[identity.pid]=identity;break\n                seen.add(current.pid);current=self.processes.snapshot(current.parent)\n        self.engines_owned={pid:s for pid,s in self.engines_owned.items() if self.valid(s)}\n        self.publish();return sorted(self.engines_owned)\n\n    def signal_identity(self, identity, sig):\n        if not self.valid(identity):return False\n        self.processes.send(identity.pid,sig);return True\n\n    def signal_app(self, sig=signal.SIGTERM):\n        self.engines()  # establish owned descendants before their parent exits\n        return self.signal_identity(self.app,sig)\n\n    def signal_engine(self,pid,sig=signal.SIGKILL):\n        self.engines();return self.signal_identity(self.engines_owned.get(pid),sig)\n\n    def stop_engines(self):\n        for pid in self.engines():self.signal_engine(pid)\n\n_bound = None\n\ndef bind(bundle):\n    global _bound\n    path=Path(bundle).resolve(strict=True)\n    if _bound is not None and _bound.bundle != path:\n        raise RuntimeError('one driver cannot switch fixture candidates')\n    if _bound is None:\n        prepare=os.environ.get('AIRS_NATIVE_PREPARE')\n        if prepare:\n            p=json.loads(Path(prepare).read_text());expected=(Path.cwd()/p['bundle']).resolve(strict=True)\n            if path!=expected:raise RuntimeError('bundle differs from declared native preparation')\n            executable=path/'Contents/MacOS'/EXECUTABLE\n            if hashlib.sha256(executable.read_bytes()).hexdigest()!=p['executable_sha256']:\n                raise RuntimeError('prepared executable changed')\n        _bound=Candidate(path,record=os.environ.get('AIRS_NATIVE_PROCESS_RECORD'))\n    return _bound\n\ndef current():\n    if _bound is not None:return _bound\n    prepare=os.environ.get('AIRS_NATIVE_PREPARE')\n    if prepare:return bind(Path.cwd()/json.loads(Path(prepare).read_text())['bundle'])\n    return None\n\ndef app_pid():\n    candidate=current();return candidate.app_pid() if candidate else None\n\ndef engine_pids():\n    candidate=current();return candidate.engines() if candidate else []\n\ndef stop_app(sig=signal.SIGTERM):\n    candidate=current()\n    if candidate:candidate.signal_app(sig)\n\ndef stop_engines():\n    candidate=current()\n    if candidate:candidate.stop_engines()\n\ndef signal_engine(pid,sig=signal.SIGKILL):\n    candidate=current();return candidate.signal_engine(pid,sig) if candidate else False\n22:import candidate_process as candidate\n43:        raise RuntimeError(\"process-name signaling is forbidden; use candidate-owned PID controls\")\n46:def bind_candidate(bundle):\n47:    return candidate.bind(bundle)\n49:def launch_candidate(bundle):\n50:    return candidate.bind(bundle).launch()\n52:def stop_app():\n53:    return candidate.stop_app()\n55:def stop_engines():\n56:    return candidate.stop_engines()\n59:    return candidate.signal_engine(pid,sig)\n63:class App:\n68:        self.candidate = candidate.bind(bundle)\n81:    def running_pid():\n82:        return candidate.app_pid()\n95:        candidate.stop_app()\n103:            candidate.stop_app(signal.SIGKILL)\n110:    def launch(self, settle=6):\n112:        self.candidate.launch()\n138:    def ax(self, command, *args):\n149:    def tree(self):\n179:    def front(self):\n190:    def keys(self, text, modifiers=None):\n353:class ScanEndpoint:\n401:class AcademyEndpoint:\n\n    def has_text(self, tree, fragment):\n        return any(fragment in t for t in self.texts(tree))\n\n    @staticmethod\n    def node(tree, role, prefix, nth=0):\n        found = [n for n in tree if n.get(\"role\") == role and (n.get(\"label\") or \"\").startswith(prefix)]\n        return found[nth] if nth < len(found) else None\n\n    @staticmethod\n    def focused(tree):\n        return next((n for n in tree if n.get(\"focused\") and n.get(\"role\") not in (\"AXWindow\", \"AXWebArea\", \"AXGroup\", \"AXScrollArea\")), None)\n\n    def wait_for(self, predicate, timeout=12.0):\n        deadline = time.time() + timeout\n        while True:\n            tree = self.tree()\n            if predicate(tree):\n                return tree, True\n            if time.time() > deadline:\n                return tree, False\n            time.sleep(0.3)\n\n    # ---- keyboard (frontmost-guarded) ----\n    def front(self):\n        if self.pid != self.running_pid():\n            raise RuntimeError(\"fixture process identity changed before focus/input\")\n        script = (f'tell application \"System Events\"\\nset p to first application process whose unix id is {self.pid}\\n'\n                  'set frontmost of p to true\\ndelay 0.2\\nreturn frontmost of p\\nend tell')\n        for _ in range(5):\n            if sh([\"osascript\", \"-e\", script]).stdout.strip() == \"true\":\n                return\n            time.sleep(0.3)\n        raise RuntimeError(f\"the fixture app (pid {self.pid}) is not frontmost; refusing to send keystrokes\")\n\n    def keys(self, text, modifiers=None):\n        if self.pid is None:\n            self.pid = self.running_pid()\n        if self.pid is None:\n            raise RuntimeError(\"keystrokes need the fixture pid\")\n        self.front()\n        using = f\" using {{{modifiers}}}\" if modifiers else \"\"\n        escaped = text.replace(\"\\\\\", \"\\\\\\\\\").replace('\"', '\\\\\"')\n        sh([\"osascript\", \"-e\", f'tell application \"System Events\" to keystroke \"{escaped}\"{using}'])\n        time.sleep(0.4)\n\n    def keycode(self, code, modifiers=None):\n        self.front()\n        using = f\" using {{{modifiers}}}\" if modifiers else \"\"\n        sh([\"osascript\", \"-e\", f'tell application \"System Events\" to key code {code}{using}'])\n        time.sleep(0.35)\n\n    def tab_walk(self, steps):\n        order = []\n        for _ in range(steps):\n            self.keycode(48)\n            f = self.focused(self.tree())\n            order.append(None if f is None else {\"role\": f[\"role\"], \"subrole\": f.get(\"subrole\"), \"label\": f.get(\"label\")})\n        return order\n\n    def menu(self, *path):\n        self.front()\n        chain = f'menu item \"{path[-1]}\"'\n        for item in reversed(path[1:-1]):\n            chain += f' of menu 1 of menu item \"{item}\"'\n        chain += f' of menu 1 of menu bar item \"{path[0]}\" of menu bar 1'\n        sh([\"osascript\", \"-e\", f'tell application \"System Events\" to tell (first application process whose unix id is {self.pid}) to click {chain}'])\n        time.sleep(0.8)\n\n    def field(self, role, label, nth=0):\n        return self.node(self.tree(), role, label, nth)\n\n    def type_into(self, role, label, text, nth=0, secure=False):\n        \"\"\"Types `text` and verifies what arrived; retypes over a selection if\n        keystrokes were dropped.\"\"\"\n        for attempt in range(3):\n            self.ax(\"focus\", role, label, nth)\n            time.sleep(0.4)\n            if attempt:\n                self.keys(\"a\", \"command down\")\n                self.keycode(51)\n            self.keys(text)\n            time.sleep(0.3)\n            value = str((self.field(role, label, nth) or {}).get(\"value\") or \"\")\n            if (len(value) == len(text) and set(value) <= {\"•\"}) if secure else value == text:\n                self.note(\"typed\", field=label, attempts=attempt + 1)\n                return\n        raise RuntimeError(f\"could not type into {label} reliably\")\n\n    def type_file(self, role, label, path, nth=0, timeout=60, per_event=20):\n        \"\"\"Replaces a field's text with a file's contents typed as real key\n        events (posted to the app's process only) and waits until it all\n        arrived.\"\"\"\n        expected = open(path, encoding=\"utf-8\").read()\n        for attempt in range(3):\n            self.ax(\"focus\", role, label, nth)\n            time.sleep(0.3)\n            self.keys(\"a\", \"command down\")\n            self.keycode(51)\n            self.front()\n            self.ax(\"type-file\", path, per_event)\n            time.sleep(1.0)\n            deadline = time.time() + timeout\n            value = \"\"\n            while time.time() < deadline:\n                value = str((self.field(role, label, nth) or {}).get(\"value\") or \"\")\n                if len(value) >= len(expected):\n                    break\n                time.sleep(0.3)\n            if value == expected:\n                self.note(\"typed-file\", field=label, chars=len(expected), attempts=attempt + 1)\n                return True\n            self.note(\"typed-file-mismatch\", field=label, expected=len(expected), arrived=len(value), attempt=attempt + 1)\n        return False\n\n    # ---- flows ----\n    def open_settings(self):\n        \"\"\"Opens Settings and waits until its form is in the tree (the heading\n        lands before the fields under load; a second ⌘, is sent if the sheet\n        did not open).\"\"\"\n        ready = lambda t: self.node(t, \"AXHeading\", \"Settings\") is not None and self.node(t, \"AXTextField\", \"TSG ID (optional)\") is not None\n        for _ in range(2):\n            self.keys(\",\", \"command down\")\n            tree, ok = self.wait_for(ready, 20)\n            if ok:\n                return tree\n        raise RuntimeError(\"Settings did not open with its tenant form\")\n\n    def open_runtime(self):\n        self.ax(\"press\", \"AXButton\", \"Runtime Security\")\n        tree, _ = self.wait_for(lambda t: self.node(t, \"AXHeading\", \"Scan a prompt or response\") is not None)\n        return tree\n\n    def create_custom_tenant(self, label, origin):\n        self.type_into(\"AXTextField\", \"Label\", label)\n        self.ax(\"press\", \"AXRadioButton\", \"Custom HTTPS endpoint\")\n        self.wait_for(lambda t: self.node(t, \"AXTextField\", \"Endpoint origin\") is not None)\n        self.type_into(\"AXTextField\", \"Endpoint origin\", origin)\n        self.keycode(36)\n        return self.wait_for(lambda t: self.node(t, \"AXButton\", f\"Delete {label}\") is not None)\n\n    def save_key(self, key):\n        # The credential form re-renders when the tenant becomes active; wait for its field (the first launch after\n        # a reboot, caches cold, had the field appear after the driver looked for it).\n        self.wait_for(lambda t: self.node(t, \"AXTextField\", \"AIRS API key\") is not None, 12)\n        self.type_into(\"AXTextField\", \"AIRS API key\", key, secure=True)\n        self.keycode(36)\n        return self.wait_for(lambda t: self.has_text(t, \"Scan key saved in the Keychain.\"))\n\n    def make_active(self, label):\n        \"\"\"Makes `label` the active tenant from Settings' list; confirmed by Settings' active-tenant text or, since the\n        v2 shell leaves Settings for Home on a switch, by the shell's tenant switcher naming it.\"\"\"\n        def active(t):\n            # The switcher names the active tenant first (\"Switch tenant: Prod · Production · TSG …\"): the label is\n            # matched as that first part, not as a substring (Prod is one of Production).\n            return self.has_text(t, f\"Active tenant: {label}\") or self.has_text(t, f\"{label} (active)\") \\\n#![cfg(feature = \"test-fixtures\")]\n\nuse desktop_core::features::TenantEnvironment;\nuse desktop_core::fixtures::{self, ScriptedStore};\nuse desktop_core::store::PersistedState;\nuse desktop_core::tenants::{Destination, Region, TenantId, TenantProfile};\nuse desktop_core::{\n    Core, CoreConfig, Delivery, Intent, Observation, Refusal, ShellSnapshot, ViewScope,\n};\nuse serde_json::json;\n\nfn profile(id: &str, label: &str) -> TenantProfile {\n    TenantProfile {\n        id: TenantId::parse(id).expect(\"fixture id\"),\n        label: label.to_owned(),\n        tsg_id: Some(\"1234567890\".to_owned()),\n        destination: Destination::Region {\n            region: Region::Europe,\n        },\n        environment: TenantEnvironment::Production,\n    }\n}\nfn snapshot(core: &Core) -> ShellSnapshot {\n    match core.operator().observe(ViewScope::Shell).expect(\"snapshot\") {\n        Observation::Shell { snapshot, .. } => snapshot,\n        _ => panic!(\"shell expected\"),\n    }\n}\nfn state() -> PersistedState {\n    let a = profile(\"tn-0123456789abcdef\", \"A\");\n    let b = profile(\"tn-fedcba9876543210\", \"B\");\n    PersistedState {\n        tenants: vec![a.clone(), b],\n        active_tenant: Some(a.id),\n        ..PersistedState::default()\n    }\n}\n#[tokio::test]\nasync fn metadata_edit_targets_only_the_selected_profile_without_rebinding_identity() {\n    let (adapters, handles) = fixtures::adapters_with(ScriptedStore::with_state(state()));\n    let core = Core::new(\n        CoreConfig {\n            fixture_tenant_creation: false,\n            ..CoreConfig::default()\n        },\n        adapters,\n    );\n    core.start();\n    let before = snapshot(&core);\n    let handle = core.operator();\n    let session = handle.register_delivery_session().expect(\"session\").nonce;\n    let target = before.tenants[1].id.clone();\n    handle\n        .dispatch(\n            Delivery {\n                session,\n                sequence: 1,\n            },\n            Intent::EditTenant {\n                tenant: target.clone(),\n                label: \"Renamed B\".to_owned(),\n                environment: TenantEnvironment::Staging,\n            },\n        )\n        .await\n        .expect(\"metadata edit\");\n    let after = snapshot(&core);\n    assert_eq!(\n        after.active, before.active,\n        \"metadata never switches the active tenant\"\n    );\n    assert_eq!(after.tenants[0], before.tenants[0]);\n    let changed = &after.tenants[1];\n    assert_eq!(changed.id, target);\n    assert_eq!(changed.label, \"Renamed B\");\n    assert_eq!(changed.environment, TenantEnvironment::Staging);\n    assert_eq!(changed.tsg_id, before.tenants[1].tsg_id);\n    assert_eq!(changed.destination, before.tenants[1].destination);\n    assert_eq!(changed.management, before.tenants[1].management);\n    assert_eq!(changed.scan, before.tenants[1].scan);\n    assert_eq!(\n        handles.store.saved().expect(\"saved\").tenants[1].label,\n        \"Renamed B\"\n    );\n}\n#[tokio::test]\nasync fn metadata_edit_rolls_back_when_private_persistence_fails() {\n    let (adapters, handles) = fixtures::adapters_with(ScriptedStore::with_state(state()));\n    let core = Core::new(\n        CoreConfig {\n            fixture_tenant_creation: false,\n            ..CoreConfig::default()\n        },\n        adapters,\n    );\n    core.start();\n    let before = snapshot(&core);\n    handles.store.fail_saves(true);\n    let handle = core.operator();\n    let session = handle.register_delivery_session().expect(\"session\").nonce;\n    assert!(\n        handle\n            .dispatch(\n                Delivery {\n                    session,\n                    sequence: 1\n                },\n                Intent::EditTenant {\n                    tenant: before.tenants[0].id.clone(),\n                    label: \"Not saved\".to_owned(),\n                    environment: TenantEnvironment::Other,\n                }\n            )\n            .await\n            .is_err()\n    );\n    let after = snapshot(&core);\n    assert_eq!(after.tenants, before.tenants);\n    assert_eq!(after.active, before.active);\n    assert_eq!(\n        handles.store.saved().expect(\"old saved state\").tenants[0].label,\n        \"A\"\n    );\n}\n#[tokio::test]\nasync fn metadata_edit_rejects_invalid_labels_and_has_no_tsg_or_endpoint_fields() {\n    let (adapters, _) = fixtures::adapters_with(ScriptedStore::with_state(state()));\n    let core = Core::new(\n        CoreConfig {\n            fixture_tenant_creation: false,\n            ..CoreConfig::default()\n        },\n        adapters,\n    );\n    core.start();\n    let before = snapshot(&core);\n    let handle = core.operator();\n    let session = handle.register_delivery_session().expect(\"session\").nonce;\n    assert_eq!(\n        handle\n            .dispatch(\n                Delivery {\n                    session,\n                    sequence: 1\n                },\n                Intent::EditTenant {\n                    tenant: before.tenants[0].id.clone(),\n                    label: \"   \".to_owned(),\n                    environment: TenantEnvironment::Other,\n                }\n            )\n            .await,\n        Err(Refusal::InvalidInput)\n    );\n    for (field, value) in [\n        (\"tsgId\", json!(\"9999999999\")),\n        (\"destination\", json!({\"kind\":\"region\", \"region\":\"india\"})),\n    ] {\n        let mut intent = json!({\"kind\":\"editTenant\", \"tenant\":before.tenants[0].id, \"label\":\"A\", \"environment\":\"production\"});\n        intent[field] = value;\n        assert!(\n            serde_json::from_value::<Intent>(intent).is_err(),\n            \"unreviewed identity field {field}\"\n        );\n    }\n    assert_eq!(snapshot(&core).tenants, before.tenants);\n}\n","exit_code":0,"status":"completed"}}
