{"type":"item.completed","item":{"id":"item_20","type":"command_execution","command":"/bin/zsh -lc \"sed -n '1,180p' tools/p10/candidate.py; sed -n '732,805p' tools/p11/proof.py\"","aggregated_output":"\"\"\"Candidate/source bindings shared by C45 qualification and actual reviews.\"\"\"\nfrom pathlib import Path\nimport ast\nimport os\nimport stat\nimport sys\nsys.path.insert(0,str(Path(__file__).resolve().parents[1]/'p09'))\nfrom phase_packet import source_inventory, file_identity, digest\nfrom qualification import read, sha, require\n\n\ndef bundle_hash(bundle):\n    entries=[]\n    for base, directories, files in os.walk(bundle,followlinks=False):\n        symlinks=[name for name in directories if (Path(base)/name).is_symlink()]\n        directories[:]=[name for name in directories if name not in symlinks]\n        for name in files+symlinks:\n            path=Path(base)/name;relative=str(path.relative_to(bundle))\n            if path.is_symlink():mode='symlink';value=__import__('hashlib').sha256(os.readlink(path).encode()).hexdigest()\n            else:mode='100755' if path.stat().st_mode & 0o111 else '100644';value=sha(path)\n            entries.append((relative,mode,value))\n    text=''.join(f'{name}\\0{mode}\\0{value}\\n' for name,mode,value in sorted(entries))\n    return __import__('hashlib').sha256(text.encode()).hexdigest()\n\n\ndef helper_closure(root, driver):\n    folder=root/'tools/native-acceptance';pending=[driver];seen=set()\n    while pending:\n        name=pending.pop()\n        if name in seen or not (folder/(name+'.py')).is_file():continue\n        seen.add(name);tree=ast.parse((folder/(name+'.py')).read_text())\n        for node in ast.walk(tree):\n            if isinstance(node,ast.Import):pending.extend(alias.name.split('.')[0] for alias in node.names)\n            elif isinstance(node,ast.ImportFrom) and node.module:pending.append(node.module.split('.')[0])\n    paths=['tools/native-acceptance/'+name+'.py' for name in seen]\n    # Native compiled helpers/servers are used through literal paths, not imports.\n    paths += [str(p.relative_to(root)) for p in folder.iterdir() if p.suffix in ['.swift','.js']]\n    paths += ['tools/p10/native.py','tools/p10/candidate.py','docs/planning/evidence/P09/native-controller/native_requirements.py']\n    return {name:sha(root/name) for name in sorted(set(paths))}\n\n\ndef verify_source(root, seal):\n    expected=read(root/seal)['files']\n    require(source_inventory(root)==expected,'sealed source membership/content changed')\n    return digest(expected)\n\n\ndef verify_candidate(root, value, historical=None):\n    prepared=read(root/value['prepare']['path'])\n    require(sha(root/value['prepare']['path'])==value['prepare']['sha256'],'preparation drift')\n    bundle=historical.application(value) if historical else root/prepared['bundle']\n    require(sha(bundle/'Contents/MacOS/prisma-airs-desktop')==value['executable_sha256']==prepared['executable_sha256'],'candidate executable drift')\n    require(bundle_hash(bundle)==value['bundle_sha256']==prepared['bundle_sha256'],'complete candidate bundle drift')\n    helper_root=historical.source(value['source_inventory_sha256']) if historical else root\n    for name,value_hash in value['helper_closure'].items():require(sha(helper_root/name)==value_hash,'candidate helper drift: '+name)\n    if value.get('build_origin'):\n        import platform\n        origin=value['build_origin'];path=root/origin['record']\n        require(sha(path)==origin['sha256'],'build origin proof drift')\n        audit=verify_build_reuse(root,read(path),value['runner_inputs'],platform.platform(),platform.node(),historical=historical)\n        require(audit==origin['audit'],'build reuse audit drift')\n    return value\n\n# Explicit helper/provenance-only transition after the baseline02 startup smoke.\n# No application/config/dependency path is permitted. Old raw build and failed\n# smoke remain immutable; this is not a new execution of that build.\nBUILD_REUSE_PATHS = {\n    'tools/p10/historical.py','tools/p10/test_historical.py',\n    'tools/p10/provenance_followup.py','tools/p10/qualification.py',\n    'tools/p10/review_gate.py','tools/p10/followup.py',\n    'crates/xtask/tests/controlled_live.rs',\n    'crates/xtask/tests/live_run/common.rs',\n    'crates/xtask/examples/c45_baseline.rs',\n    'tools/p10/packet.py','tools/p10/followup.py','tools/p10/test_followup.py',\n    'tools/native-acceptance/acceptance_c04.py',\n    'tools/native-acceptance/test_c04_current_frame.py',\n    'tools/native-acceptance/acceptance_c45.py',\n    'tools/p10/candidate.py', 'tools/p10/test_build_reuse.py',\n    'tools/p10/supervise.py', 'tools/p10/seal.py',\n    'tools/p10/finalize.py', 'tools/p10/native.py',\n    'apps/desktop/src-tauri/tests/permission_manifest.rs',\n    'tools/p10/continuation.py', 'tools/p10/test_continuation.py',\n    'tools/native-acceptance/acceptance_c32_current.py',\n    'tools/native-acceptance/test_c32_project_path.py',\n}\n\n\ndef verify_build_reuse(root, record, current_identity, platform_name, hostname, historical=None):\n    from qualification import bound\n    from stages import verify_completed\n    require(record['schema']=='airs-desktop/c45-helper-only-build-reuse/1','build reuse schema')\n    old=read(bound(root,record['original_candidate']))\n    before=read(bound(root,record['original_source']))['files']\n    after=read(bound(root,record['current_source']))['files']\n    changed=sorted(name for name in set(before)|set(after) if before.get(name)!=after.get(name))\n    require(changed==record['declared_changed_paths'] and set(changed)<=BUILD_REUSE_PATHS,'undeclared or application-affecting build-reuse delta')\n    if historical:\n        historical.source(digest(before));historical.source(digest(after))\n    else:require(source_inventory(root)==after,'current build-reuse source changed')\n    require(digest(before)==old['source_inventory_sha256'],'original source seal/candidate mismatch')\n    require(current_identity['dependencies']==old['runner_inputs']['dependencies'] and current_identity['build_flags']==old['runner_inputs']['build_flags'],'build dependency/toolchain/flags changed')\n    if not historical:require(old['conditions']['platform']==platform_name and old['conditions']['hostname']==hostname,'build execution conditions changed')\n    state_path=bound(root,record['original_build_stage']);state=read(state_path)\n    verify_completed(root,state_path.parent,state,state['argv'],digest(before))\n    prepared=read(bound(root,old['prepare']));bundle=historical.application(old) if historical else root/prepared['bundle']\n    require(sha(bundle/'Contents/MacOS/prisma-airs-desktop')==old['executable_sha256']==prepared['executable_sha256'],'retained executable changed')\n    require(bundle_hash(bundle)==old['bundle_sha256']==prepared['bundle_sha256'],'retained complete bundle changed')\n    return {'original_candidate_sha256':record['original_candidate']['sha256'],'original_build_stage_sha256':record['original_build_stage']['sha256'],'declared_helper_only_delta':changed,'executable_sha256':old['executable_sha256'],'bundle_sha256':old['bundle_sha256'],'new_build_executed':False,'meaning':'Exact unchanged application retained from actual baseline02 build; changed C45 selector and qualification provenance execute current affected verification.'}\ndef verify(root, path):\n    record = read(path)\n    require(record['schema'] == 'airs-desktop/p11-shared-qualification/1', 'P11 proof schema')\n    require(set(record['runner_inputs']) == {'source', 'dependencies', 'build_flags'},\n            'P11 runner input keys differ')\n    require(record['runner_inputs']['source'] == xtask_source(root),\n            'current source does not match actual runner source fingerprint')\n    seal = read(bound(root, record['source']))\n    require(source_inventory(root) == seal['files'], 'P11 source changed after qualification')\n    qualified = read(bound(root, record['coverage']))\n    require(digest(seal['files']) == qualified['source_inventory_sha256'], 'P11 source binding')\n    if 'helper_source_carry' in record:\n        validate_helper_source_carry(root, bound(root, record['helper_source_carry']), record['runner_inputs'])\n    elif 'impact_selection' in record:\n        validate_impact_selection(root, bound(root, record['impact_selection']), record['runner_inputs'])\n    else:\n        for kind in ('check', 'test'):\n            validate_run(root, bound(root, record['runs'][kind]), kind, record['runner_inputs'])\n    inputs = read(bound(root, record['fingerprint']))\n    require(record['runner_inputs'] == {key: inputs[key] for key in record['runner_inputs']},\n            'P11 observed current fingerprint mismatch')\n    current = current_fingerprints(root)\n    require(record['runner_inputs'] == {key: current[key] for key in record['runner_inputs']},\n            'current dependency/toolchain/build flags differ from executed checks')\n    result = verify_coverage(root, qualified)\n    candidate = read(bound(root, qualified['candidate']))\n    from candidate import verify_candidate\n    verify_candidate(root, candidate)\n    performed = read(bound(root, record['native_execution']))\n    require(candidate['helper_closure'] == helper_closure(root, native_driver(root, performed)),\n            'P11 native helper membership changed')\n    validate_execution(root, performed, candidate,\n        acceptance=bound(root, record['native_acceptance']) if 'native_acceptance' in record else None,\n        execution=bound(root, record['native_execution']))\n    build_path = bound(root, record['build'])\n    build = read(build_path)\n    require(build['application_inputs_unchanged'] is True\n            and all(step['exit_code'] == 0 for step in build['steps']), 'fixture build failed/drifted')\n    require([step['argv'] for step in build['steps']] == [\n        ['pnpm', '--filter', '@prisma-airs/desktop-contracts', 'typecheck'],\n        ['pnpm', '--filter', '@prisma-airs/desktop', 'typecheck'],\n        ['cargo', 'run', '--locked', '-p', 'xtask', '--', 'native-prepare', '--phase', 'P11',\n         '--target', 'aarch64-apple-darwin', '--features', 'test-fixtures']],\n        'missing or changed fixture build invocation')\n    require(set(build['application_inputs_before']) == application_files(root),\n            'built application input membership differs or is incomplete')\n    require(read(build_path.parent / 'native-prepare.json') == read(bound(root, candidate['prepare'])),\n            'prepared candidate differs from retained actual build output')\n    for step in build['steps']:\n        log = (build_path.parent / step['log']).resolve()\n        require(log.is_relative_to(root.resolve()) and sha(log) == step['log_sha256'],\n                'fixture build log drift')\n    changed = [name for name, value in build['application_inputs_before'].items()\n               if sha(root / name) != value]\n    if changed:\n        carry_schema = read(bound(root, record['build_input_carry']))['schema']\n        if carry_schema == 'airs-desktop/rust-test-build-carry/1':\n            rust_test_carry(root, record, build_path, build, candidate, changed)\n        else:\n            frontend_test_carry(root, record, build_path, build, candidate, changed)\n    else:\n        require('build_input_carry' not in record, 'unnecessary or stale build carry')\n    baseline = read(bound(root, record['historical_baseline']))\n    require(record['historical_baseline']['path'] == 'docs/planning/evidence/P10/completion-proof.json'\n            and baseline['schema'] == 'airs-desktop/p10-completion-proof/1', 'missing accepted baseline')\n    from review_gate import release_prerequisites\n    require(record['historical_standing'] == release_prerequisites(root),\n            'actual historical standing drift')\n    return {'record': str(path.relative_to(root)), 'sha256': sha(path),\n            'verified': result, 'candidate_sha256': qualified['candidate']['sha256'],\n            'controller_complete': False}\n\n\ndef make(root, check, tests, fingerprint, prepare, native, execution, build, out,\n","exit_code":0,"status":"completed"}}
