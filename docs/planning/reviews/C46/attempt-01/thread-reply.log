{"type":"item.completed","item":{"id":"item_24","type":"command_execution","command":"/bin/zsh -lc \"nl -ba crates/desktop-core/src/authority/setup_domain.rs | sed -n '600,765p'; rg -n '\"'^def digest'\"' tools/p09/phase_packet.py\"","aggregated_output":"   600\t\n   601\t    /// Commits the draft: it becomes a tenant with its products and the\n   602\t    /// verify warnings, is made active, and a first run's onboarding is\n   603\t    /// done. Refused unless the current inputs were verified without a\n   604\t    /// failure (the presentation cannot skip or forge a check).\n   605\t    /// Whether the draft under `context` may complete with `packs` now (the\n   606\t    /// checks of [`State::complete_setup`], without changing anything):\n   607\t    /// the draft tenant's id when it may.\n   608\t    pub(super) fn completable_setup(\n   609\t        &self,\n   610\t        context: &ContextRef,\n   611\t        packs: &[ProductId],\n   612\t    ) -> Result<TenantId, Refusal> {\n   613\t        let setup = self.setup_for(context)?;\n   614\t        let view = Self::verify_view(setup).ok_or(Refusal::InvalidInput)?;\n   615\t        if !view.done || view.blocking || view.stale {\n   616\t            return Err(Refusal::InvalidInput);\n   617\t        }\n   618\t        if !setup\n   619\t            .tenant\n   620\t            .profile\n   621\t            .tsg_id\n   622\t            .as_deref()\n   623\t            .is_some_and(crate::management::tsg_is_valid)\n   624\t            || !matches!(setup.tenant.management, ScanCapability::Ready { .. })\n   625\t        {\n   626\t            return Err(Refusal::InvalidInput);\n   627\t        }\n   628\t        if packs.iter().any(|p| !setup.products.contains(p)) {\n   629\t            return Err(Refusal::InvalidInput);\n   630\t        }\n   631\t        if self.data.tenants.len() >= MAX_TENANTS {\n   632\t            return Err(Refusal::Busy);\n   633\t        }\n   634\t        Ok(setup.tenant.profile.id.clone())\n   635\t    }\n   636\t\n   637\t    pub(super) fn complete_setup(\n   638\t        &mut self,\n   639\t        context: &ContextRef,\n   640\t        packs: Vec<ProductId>,\n   641\t        recorded_secs: u32,\n   642\t    ) -> Result<Completed, Refusal> {\n   643\t        self.completable_setup(context, &packs)?;\n   644\t        let setup = self.setup_for(context)?;\n   645\t        let view = Self::verify_view(setup).ok_or(Refusal::InvalidInput)?;\n   646\t        // Stage only Data before persistence. Authority retirement is\n   647\t        // irreversible and waits for the handler's successful save.\n   648\t        let retired_workspace = self.setup_workspace_reference();\n   649\t        let Some(mut setup) = self.data.setup.take() else {\n   650\t            return Err(Refusal::StaleContext);\n   651\t        };\n   652\t        let first_run = setup.mode == SetupMode::FirstRun;\n   653\t        setup.tenant.products = setup.products.clone();\n   654\t        for (n, w) in view.warnings.into_iter().take(MAX_WARNINGS).enumerate() {\n   655\t            setup\n   656\t                .tenant\n   657\t                .setup_warnings\n   658\t                .push(crate::features::SetupWarning {\n   659\t                    id: format!(\"vw-{}\", n + 1),\n   660\t                    product: w.product,\n   661\t                    reason: w.reason,\n   662\t                    recorded_secs,\n   663\t                    check: Some(super::setup_warning_domain::binding_for(\n   664\t                        &setup.tenant,\n   665\t                        super::setup_warning_domain::line_for(w.product),\n   666\t                        setup\n   667\t                            .gateway\n   668\t                            .selection\n   669\t                            .as_ref()\n   670\t                            .map(|s| crate::gateway::WorkspaceScope::from(&s.workspace)),\n   671\t                    )),\n   672\t                    recheck: None,\n   673\t                    resolved_secs: None,\n   674\t                });\n   675\t        }\n   676\t        let id = setup.tenant.profile.id.clone();\n   677\t        self.data.tenants.push(setup.tenant);\n   678\t        self.data.active = Some(id.clone());\n   679\t        if first_run {\n   680\t            self.data.onboarding = Some(OnboardingState::Done);\n   681\t        }\n   682\t        let packs = packs\n   683\t            .iter()\n   684\t            .flat_map(|p| case_products(*p).iter().copied())\n   685\t            .collect();\n   686\t        Ok(Completed {\n   687\t            tenant: id,\n   688\t            first_run,\n   689\t            packs,\n   690\t            retired_workspace,\n   691\t        })\n   692\t    }\n   693\t\n   694\t    /// Drops the draft. Its Keychain records go to the cleanup queue; the\n   695\t    /// returned session records are the caller's to delete. No tenant,\n   696\t    /// selection or onboarding state changes.\n   697\t    pub(super) fn discard_setup(&mut self, context: &ContextRef) -> Result<Vec<RecordId>, Refusal> {\n   698\t        let id = self.setup_for(context)?.tenant.profile.id.clone();\n   699\t        let mut retired = Vec::new();\n   700\t        for class in [\n   701\t            CredentialClass::Scan,\n   702\t            CredentialClass::Management,\n   703\t            CredentialClass::Inference,\n   704\t        ] {\n   705\t            retired.extend(self.retire_class(&id, class));\n   706\t        }\n   707\t        self.retire_setup_authority();\n   708\t        self.data.setup = None;\n   709\t        Ok(retired)\n   710\t    }\n   711\t\n   712\t    /// Nothing bound to the draft's context outlives the draft: the cached\n   713\t    /// management binding (SDK clients, token cache), the reads queued or in\n   714\t    /// flight under its context and under its chosen workspace reference.\n   715\t    /// Late replies are withdrawn by the pipeline (the context is gone).\n   716\t    fn retire_setup_authority(&mut self) {\n   717\t        let Some((context, reference)) = self.data.setup.as_ref().map(|s| {\n   718\t            (\n   719\t                s.context.clone(),\n   720\t                s.gateway.selection.as_ref().map(|w| w.reference.clone()),\n   721\t            )\n   722\t        }) else {\n   723\t            return;\n   724\t        };\n   725\t        self.retire_setup_context(&context, reference.as_ref());\n   726\t    }\n   727\t\n   728\t    /// Retire a committed draft only after its state replacement succeeded.\n   729\t    pub(super) fn retire_setup_context(\n   730\t        &mut self,\n   731\t        context: &ContextRef,\n   732\t        reference: Option<&WorkspaceRef>,\n   733\t    ) {\n   734\t        self.retire_management_binding(context);\n   735\t        let now = Instant::now();\n   736\t        let mut starts = self.operations.retire_context(context.as_str(), now);\n   737\t        if let Some(reference) = reference {\n   738\t            starts.extend(self.operations.retire_context(reference.as_str(), now));\n   739\t        }\n   740\t        self.queue_gateway_starts(starts);\n   741\t    }\n   742\t\n   743\t    /// Whether a draft credential is stored in the Keychain (its removal\n   744\t    /// needs storage).\n   745\t    pub(super) fn setup_has_keychain_credential(&self) -> bool {\n   746\t        self.data.setup.as_ref().is_some_and(|s| {\n   747\t            [\n   748\t                CredentialClass::Scan,\n   749\t                CredentialClass::Management,\n   750\t                CredentialClass::Inference,\n   751\t            ]\n   752\t            .into_iter()\n   753\t            .any(|c| {\n   754\t                matches!(\n   755\t                    s.tenant.capability(c),\n   756\t                    ScanCapability::Ready {\n   757\t                        mode: StorageMode::Keychain,\n   758\t                        ..\n   759\t                    }\n   760\t                )\n   761\t            })\n   762\t        })\n   763\t    }\n   764\t}\n   765\t\n16:def digest(value):\n","exit_code":0,"status":"completed"}}
