{"type":"item.completed","item":{"id":"item_23","type":"command_execution","command":"/bin/zsh -lc \"nl -ba crates/desktop-core/src/authority/setup_domain.rs | sed -n '205,525p'\"","aggregated_output":"   205\t\n   206\t    /// Whether `tenant` is the draft under setup.\n   207\t    pub(super) fn is_setup_tenant(&self, tenant: &TenantId) -> bool {\n   208\t        self.data\n   209\t            .setup\n   210\t            .as_ref()\n   211\t            .is_some_and(|s| &s.tenant.profile.id == tenant)\n   212\t    }\n   213\t\n   214\t    /// The draft's inputs changed (a credential, the profile): a fresh\n   215\t    /// context replaces the old one so nothing bound to it survives — the\n   216\t    /// cached management binding (SDK clients, token cache, TSG), reads in\n   217\t    /// flight, the verify run and the Gateway listing and choice.\n   218\t    pub(super) fn reissue_setup_context(&mut self) {\n   219\t        if self.data.setup.is_none() {\n   220\t            return;\n   221\t        }\n   222\t        self.epoch += 1;\n   223\t        let fresh = ContextRef::issue(&self.salt, self.epoch);\n   224\t        self.retire_setup_authority();\n   225\t        if let Some(setup) = self.data.setup.as_mut() {\n   226\t            setup.context = fresh;\n   227\t            setup.verify = None;\n   228\t            setup.gateway = SetupGateway::default();\n   229\t        }\n   230\t    }\n   231\t\n   232\t    /// A tenant was committed outside the setup (the legacy Create tenant\n   233\t    /// or a v1 import during first run): a first-run draft is over, since\n   234\t    /// the desktop now has a tenant and the shell takes over. Its Keychain\n   235\t    /// records go to the cleanup queue; returned session records are the\n   236\t    /// caller's to delete.\n   237\t    pub(super) fn end_first_run_setup(&mut self) -> Vec<RecordId> {\n   238\t        if self\n   239\t            .data\n   240\t            .setup\n   241\t            .as_ref()\n   242\t            .is_none_or(|s| s.mode != SetupMode::FirstRun)\n   243\t        {\n   244\t            return Vec::new();\n   245\t        }\n   246\t        let context = self.data.setup.as_ref().map(|s| s.context.clone());\n   247\t        match context {\n   248\t            Some(context) => self.discard_setup(&context).unwrap_or_default(),\n   249\t            None => Vec::new(),\n   250\t        }\n   251\t    }\n   252\t\n   253\t    /// Changes the draft's profile. A new destination retires credentials\n   254\t    /// bound to the old one (returned session records are the caller's to\n   255\t    /// delete); verification results go stale through the signature.\n   256\t    pub(super) fn update_setup(\n   257\t        &mut self,\n   258\t        context: &ContextRef,\n   259\t        profile: ProfileDraft,\n   260\t    ) -> Result<Vec<RecordId>, Refusal> {\n   261\t        let profile = profile.validate().ok_or(Refusal::InvalidInput)?;\n   262\t        let setup = self.setup_for(context)?;\n   263\t        let id = setup.tenant.profile.id.clone();\n   264\t        let destination_changed = setup.tenant.profile.destination != profile.destination;\n   265\t        let tsg_changed = setup.tenant.profile.tsg_id != profile.tsg_id;\n   266\t        let mut retired = Vec::new();\n   267\t        if destination_changed {\n   268\t            for class in [\n   269\t                CredentialClass::Scan,\n   270\t                CredentialClass::Management,\n   271\t                CredentialClass::Inference,\n   272\t            ] {\n   273\t                retired.extend(self.retire_class(&id, class));\n   274\t            }\n   275\t        } else if tsg_changed {\n   276\t            retired.extend(self.retire_class(&id, CredentialClass::Management));\n   277\t        }\n   278\t        let setup = self.setup_for_mut(context)?;\n   279\t        let changed = setup.tenant.profile.label != profile.label\n   280\t            || setup.tenant.profile.tsg_id != profile.tsg_id\n   281\t            || setup.tenant.profile.destination != profile.destination\n   282\t            || setup.tenant.profile.environment != profile.environment;\n   283\t        setup.tenant.profile.label = profile.label;\n   284\t        setup.tenant.profile.tsg_id = profile.tsg_id;\n   285\t        setup.tenant.profile.destination = profile.destination;\n   286\t        setup.tenant.profile.environment = profile.environment;\n   287\t        if changed {\n   288\t            self.reissue_setup_context();\n   289\t        }\n   290\t        Ok(retired)\n   291\t    }\n   292\t\n   293\t    /// Records the chosen products (Runtime Security always, in first place).\n   294\t    pub(super) fn choose_setup_products(\n   295\t        &mut self,\n   296\t        context: &ContextRef,\n   297\t        products: Vec<ProductId>,\n   298\t    ) -> Result<(), Refusal> {\n   299\t        let setup = self.setup_for_mut(context)?;\n   300\t        setup.products = chosen(products);\n   301\t        Ok(())\n   302\t    }\n   303\t\n   304\t    /// A digest of every input verification depends on: profile, products\n   305\t    /// and the credential records. Results for another digest are stale.\n   306\t    fn setup_signature(setup: &Setup) -> u64 {\n   307\t        let mut h = DefaultHasher::new();\n   308\t        let p = &setup.tenant.profile;\n   309\t        p.label.hash(&mut h);\n   310\t        p.tsg_id.hash(&mut h);\n   311\t        p.destination.origin().hash(&mut h);\n   312\t        (p.environment as u8).hash(&mut h);\n   313\t        for product in &setup.products {\n   314\t            (*product as u8).hash(&mut h);\n   315\t        }\n   316\t        for class in [\n   317\t            CredentialClass::Scan,\n   318\t            CredentialClass::Management,\n   319\t            CredentialClass::Inference,\n   320\t        ] {\n   321\t            match setup.tenant.capability(class) {\n   322\t                ScanCapability::Ready { record, .. } => record.as_str().hash(&mut h),\n   323\t                ScanCapability::Storing { record, .. } => {\n   324\t                    \"storing\".hash(&mut h);\n   325\t                    record.as_str().hash(&mut h);\n   326\t                }\n   327\t                ScanCapability::Missing | ScanCapability::Failed { .. } => \"none\".hash(&mut h),\n   328\t            }\n   329\t        }\n   330\t        setup.tenant.management_client.hash(&mut h);\n   331\t        setup\n   332\t            .gateway\n   333\t            .selection\n   334\t            .as_ref()\n   335\t            .map(|s| s.workspace.id.as_str())\n   336\t            .hash(&mut h);\n   337\t        h.finish()\n   338\t    }\n   339\t\n   340\t    /// Starts a verification run over the current inputs: every line is\n   341\t    /// decided in the core; the lines that need a service read are admitted\n   342\t    /// through the management pipeline and settle through it.\n   343\t    pub(super) fn begin_verify(\n   344\t        &mut self,\n   345\t        context: &ContextRef,\n   346\t        keychain: Arc<dyn super::CredentialStore>,\n   347\t        session_vault: Arc<SessionVault>,\n   348\t    ) -> Result<Vec<crate::runtime::Start>, Refusal> {\n   349\t        let setup = self.setup_for(context)?;\n   350\t        let generation = setup.verify.as_ref().map_or(1, |v| v.generation + 1);\n   351\t        let signature = Self::setup_signature(setup);\n   352\t        let products = setup.products.clone();\n   353\t        let scan = setup.tenant.scan.clone();\n   354\t        let management_ready = matches!(setup.tenant.management, ScanCapability::Ready { .. });\n   355\t        let mut starts = Vec::new();\n   356\t        let mut steps = Vec::new();\n   357\t        let mut admit = |state: &mut Self, request: ManagementRequest| -> Option<OperationId> {\n   358\t            match state.admit_management(\n   359\t                context.clone(),\n   360\t                request,\n   361\t                Arc::clone(&keychain),\n   362\t                Arc::clone(&session_vault),\n   363\t            ) {\n   364\t                Ok((operation, s)) => {\n   365\t                    starts.extend(s);\n   366\t                    Some(operation)\n   367\t                }\n   368\t                Err(_) => None,\n   369\t            }\n   370\t        };\n   371\t        // Runtime Security scan key: stored keys are proven by the first\n   372\t        // scan (there is no admitted read that exercises a scan key).\n   373\t        let (state_, reason) = match scan {\n   374\t            ScanCapability::Ready { .. } => (\n   375\t                VerifyState::Stored,\n   376\t                \"Stored in the Keychain. Not checked here: the first scan proves it against the service.\",\n   377\t            ),\n   378\t            ScanCapability::Storing { .. } => {\n   379\t                (VerifyState::Fail, \"The scan key is still being saved.\")\n   380\t            }\n   381\t            _ => (\n   382\t                VerifyState::Warning,\n   383\t                \"No scan key configured; scanning stays unavailable until one is added in Settings.\",\n   384\t            ),\n   385\t        };\n   386\t        steps.push(StepState {\n   387\t            step: VerifyStep {\n   388\t                line: VerifyLine::ScanKey,\n   389\t                product: Some(ProductId::RuntimeSecurity),\n   390\t                state: state_,\n   391\t                reason: reason.to_owned(),\n   392\t            },\n   393\t            operation: None,\n   394\t        });\n   395\t        // Authentication is required independently of the chosen products.\n   396\t        let management = if management_ready {\n   397\t            match admit(self, ManagementRequest::Verify) {\n   398\t                Some(op) => (VerifyState::Pending, \"Authenticating…\".to_owned(), Some(op)),\n   399\t                None => (\n   400\t                    VerifyState::Fail,\n   401\t                    \"OAuth authentication could not be started.\".to_owned(),\n   402\t                    None,\n   403\t                ),\n   404\t            }\n   405\t        } else {\n   406\t            (\n   407\t                VerifyState::Fail,\n   408\t                \"Management OAuth authentication is required before adding a tenant.\".to_owned(),\n   409\t                None,\n   410\t            )\n   411\t        };\n   412\t        steps.push(StepState {\n   413\t            step: VerifyStep {\n   414\t                line: VerifyLine::ManagementClient,\n   415\t                product: Some(ProductId::RuntimeSecurity),\n   416\t                state: management.0,\n   417\t                reason: management.1,\n   418\t            },\n   419\t            operation: management.2,\n   420\t        });\n   421\t        let chosen_workspace = self.setup_workspace_reference();\n   422\t        for product in products.iter().copied().filter(|p| needs_management(*p)) {\n   423\t            let (line, request) = match product {\n   424\t                // With a workspace chosen its prerequisites are read (the\n   425\t                // admitted scoped read); otherwise only the listing can be.\n   426\t                ProductId::Gateway => (\n   427\t                    VerifyLine::Gateway,\n   428\t                    match chosen_workspace.clone() {\n   429\t                        Some(reference) => ManagementRequest::Gateway {\n   430\t                            workspace: Some(reference),\n   431\t                            read: GatewayRead::Prerequisites,\n   432\t                        },\n   433\t                        None => ManagementRequest::Gateway {\n   434\t                            workspace: None,\n   435\t                            read: GatewayRead::Inventory {\n   436\t                                resource: GatewayResource::Workspaces,\n   437\t                            },\n   438\t                        },\n   439\t                    },\n   440\t                ),\n   441\t                ProductId::RedTeam => (\n   442\t                    VerifyLine::RedTeam,\n   443\t                    ManagementRequest::RedTeam { window: 7 },\n   444\t                ),\n   445\t                ProductId::ModelSkill => (VerifyLine::ModelSkill, ManagementRequest::SupplyChain),\n   446\t                ProductId::RuntimeSecurity => continue,\n   447\t            };\n   448\t            let (state_, reason, operation) = if !management_ready {\n   449\t                (\n   450\t                    VerifyState::Warning,\n   451\t                    \"Needs the management client; not checked.\".to_owned(),\n   452\t                    None,\n   453\t                )\n   454\t            } else {\n   455\t                match admit(self, request) {\n   456\t                    Some(op) => (VerifyState::Pending, \"Reading…\".to_owned(), Some(op)),\n   457\t                    None => (\n   458\t                        VerifyState::Fail,\n   459\t                        \"The read could not be started.\".to_owned(),\n   460\t                        None,\n   461\t                    ),\n   462\t                }\n   463\t            };\n   464\t            steps.push(StepState {\n   465\t                step: VerifyStep {\n   466\t                    line,\n   467\t                    product: Some(product),\n   468\t                    state: state_,\n   469\t                    reason,\n   470\t                },\n   471\t                operation,\n   472\t            });\n   473\t        }\n   474\t        // Products without an admitted service are listed, never checked.\n   475\t        for line in [VerifyLine::Ais, VerifyLine::Aes] {\n   476\t            steps.push(StepState {\n   477\t                step: VerifyStep {\n   478\t                    line,\n   479\t                    product: None,\n   480\t                    state: VerifyState::Unavailable,\n   481\t                    reason: \"Not available in this release: no admitted service (D058).\".to_owned(),\n   482\t                },\n   483\t                operation: None,\n   484\t            });\n   485\t        }\n   486\t        let setup = self.setup_for_mut(context)?;\n   487\t        setup.verify = Some(VerifyRun {\n   488\t            generation,\n   489\t            signature,\n   490\t            steps,\n   491\t        });\n   492\t        Ok(starts)\n   493\t    }\n   494\t\n   495\t    /// The operations the current verify run waits on.\n   496\t    pub(super) fn setup_operations(&self) -> Vec<OperationId> {\n   497\t        self.data\n   498\t            .setup\n   499\t            .as_ref()\n   500\t            .and_then(|s| s.verify.as_ref())\n   501\t            .map(|v| v.steps.iter().filter_map(|s| s.operation.clone()).collect())\n   502\t            .unwrap_or_default()\n   503\t    }\n   504\t\n   505\t    /// Settles one verify line from its management result.\n   506\t    pub(super) fn setup_settled(&mut self, operation: &OperationId, result: &ManagementResult) {\n   507\t        let Some(run) = self.data.setup.as_mut().and_then(|s| s.verify.as_mut()) else {\n   508\t            return;\n   509\t        };\n   510\t        let Some(step) = run\n   511\t            .steps\n   512\t            .iter_mut()\n   513\t            .find(|s| s.operation.as_ref() == Some(operation))\n   514\t        else {\n   515\t            return;\n   516\t        };\n   517\t        step.operation = None;\n   518\t        let (state, reason) = verify_result(step.step.line, result);\n   519\t        step.step.state = state;\n   520\t        step.step.reason = reason;\n   521\t    }\n   522\t\n   523\t    fn verify_view(setup: &Setup) -> Option<VerifyView> {\n   524\t        let run = setup.verify.as_ref()?;\n   525\t        let steps: Vec<VerifyStep> = run.steps.iter().map(|s| s.step.clone()).collect();\n","exit_code":0,"status":"completed"}}
