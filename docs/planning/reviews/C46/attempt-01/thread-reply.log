{"type":"item.completed","item":{"id":"item_22","type":"command_execution","command":"/bin/zsh -lc 'nl -ba crates/desktop-core/src/authority/setup_warning_domain.rs'","aggregated_output":"     1\t//! Dedicated, read-only reconciliation of recorded setup warnings. Ordinary\n     2\t//! product refreshes do not enter this path. Original diagnostics are immutable.\n     3\t\n     4\tuse std::collections::hash_map::DefaultHasher;\n     5\tuse std::hash::{Hash, Hasher};\n     6\tuse std::sync::Arc;\n     7\t\n     8\tuse super::{CredentialClass, Refusal, ScanCapability, State, Tenant, TenantView};\n     9\tuse crate::context::ContextRef;\n    10\tuse crate::features::{\n    11\t    ProductId, SetupWarning, SetupWarningBasis, SetupWarningBinding, SetupWarningRecheck,\n    12\t    SetupWarningWorkspace, VerifyLine, VerifyState,\n    13\t};\n    14\tuse crate::gateway::{GatewayRead, WorkspaceScope};\n    15\tuse crate::management::{ManagementRequest, ManagementResult};\n    16\tuse crate::runtime::{OperationId, Start};\n    17\tuse crate::tenants::TenantId;\n    18\tuse crate::vault::SessionVault;\n    19\t\n    20\t#[derive(Clone, Debug)]\n    21\tpub(super) struct Recheck {\n    22\t    operation: OperationId,\n    23\t    context: ContextRef,\n    24\t    tenant: TenantId,\n    25\t    warning: String,\n    26\t    binding: SetupWarningBinding,\n    27\t    signature: u64,\n    28\t    started_secs: u32,\n    29\t}\n    30\t\n    31\tpub(super) fn line_for(product: ProductId) -> VerifyLine {\n    32\t    match product {\n    33\t        ProductId::RuntimeSecurity => VerifyLine::ScanKey,\n    34\t        ProductId::Gateway => VerifyLine::Gateway,\n    35\t        ProductId::RedTeam => VerifyLine::RedTeam,\n    36\t        ProductId::ModelSkill => VerifyLine::ModelSkill,\n    37\t    }\n    38\t}\n    39\t\n    40\tpub(super) fn binding_for(\n    41\t    tenant: &Tenant,\n    42\t    line: VerifyLine,\n    43\t    workspace: Option<WorkspaceScope>,\n    44\t) -> SetupWarningBinding {\n    45\t    SetupWarningBinding {\n    46\t        version: 1,\n    47\t        line,\n    48\t        tsg_id: tenant.profile.tsg_id.clone().unwrap_or_default(),\n    49\t        origin: tenant.profile.destination.origin().to_owned(),\n    50\t        workspace: workspace.filter(|_| line == VerifyLine::Gateway).map(|w| {\n    51\t            SetupWarningWorkspace {\n    52\t                id: w.id,\n    53\t                slug: w.slug,\n    54\t                scope_name: w.scope_name,\n    55\t            }\n    56\t        }),\n    57\t    }\n    58\t}\n    59\t\n    60\t/// Reconstruct only known historical formatters. Never infer scope from an\n    61\t/// arbitrary substring or treat an unrelated healthy overview as evidence.\n    62\tfn missing_workspace(reason: &str) -> bool {\n    63\t    reason == \"No Gateway workspace in this tenant yet.\" || reason\n    64\t        .strip_suffix(\" Gateway workspace(s) readable; none chosen, so its prerequisites were not checked.\")\n    65\t        .and_then(|count| count.parse::<u32>().ok()).is_some_and(|count| count > 0)\n    66\t}\n    67\t\n    68\tfn basis(warning: &SetupWarning, current: &SetupWarningBinding) -> SetupWarningBasis {\n    69\t    let reason = warning\n    70\t        .reason\n    71\t        .strip_prefix(\"Failed: \")\n    72\t        .unwrap_or(&warning.reason);\n    73\t    if let Some(original) = &warning.check {\n    74\t        let same = original.version == 1\n    75\t            && original.line == current.line\n    76\t            && original.tsg_id == current.tsg_id\n    77\t            && original.origin == current.origin;\n    78\t        // A recorded scope is exact. The one explicit predicate exception is\n    79\t        // the known no-selection check: selecting a workspace and passing its\n    80\t        // full prerequisites supersedes that specific missing-selection fact.\n    81\t        let selected_now = current\n    82\t            .workspace\n    83\t            .as_ref()\n    84\t            .is_some_and(|w| !w.slug.is_empty() && !w.scope_name.is_empty());\n    85\t        let was_missing_selection = original.line == VerifyLine::Gateway\n    86\t            && original.workspace.is_none()\n    87\t            && selected_now\n    88\t            && missing_workspace(reason);\n    89\t        let workspace = original.workspace == current.workspace || was_missing_selection;\n    90\t        return if same && workspace {\n    91\t            SetupWarningBasis::RecordedScope\n    92\t        } else {\n    93\t            SetupWarningBasis::Unknown\n    94\t        };\n    95\t    }\n    96\t    match warning.product {\n    97\t        ProductId::RuntimeSecurity\n    98\t            if matches!(\n    99\t                reason,\n   100\t                \"No scan key saved; scans stay unavailable until one is added in Administration.\"\n   101\t                    | \"No scan key saved. Runtime Security needs one on first run.\"\n   102\t                    | \"No scan key configured; scanning stays unavailable until one is added in Settings.\"\n   103\t            ) =>\n   104\t        {\n   105\t            SetupWarningBasis::LegacyTenantSources\n   106\t        }\n   107\t        ProductId::ModelSkill\n   108\t            if matches!(\n   109\t                reason,\n   110\t                \"1 of 3 model and skill sources readable.\"\n   111\t                    | \"2 of 3 model and skill sources readable.\"\n   112\t            ) =>\n   113\t        {\n   114\t            SetupWarningBasis::LegacyTenantSources\n   115\t        }\n   116\t        ProductId::Gateway => {\n   117\t            let Some(workspace) = current.workspace.as_ref() else {\n   118\t                return SetupWarningBasis::Unknown;\n   119\t            };\n   120\t            if workspace.slug.is_empty() || workspace.scope_name.is_empty() {\n   121\t                return SetupWarningBasis::Unknown;\n   122\t            }\n   123\t            if missing_workspace(reason) {\n   124\t                return SetupWarningBasis::LegacyTenantSources;\n   125\t            }\n   126\t            let prefix = format!(\"Workspace {}: \", workspace.id);\n   127\t            let Some(detail) = reason.strip_prefix(&prefix) else {\n   128\t                return SetupWarningBasis::Unknown;\n   129\t            };\n   130\t            let detail = detail.strip_prefix(\"partial; \").unwrap_or(detail);\n   131\t            let expected = [\n   132\t                \"does not list the workspace\",\n   133\t                \"does not exist\",\n   134\t                \"may not be read by this client\",\n   135\t                \"could not be read\",\n   136\t            ]\n   137\t            .map(|suffix| format!(\"scope {} {suffix}\", workspace.scope_name));\n   138\t            if expected.iter().any(|expected| detail == expected) {\n   139\t                SetupWarningBasis::LegacyWorkspaceScope\n   140\t            } else {\n   141\t                SetupWarningBasis::Unknown\n   142\t            }\n   143\t        }\n   144\t        _ => SetupWarningBasis::Unknown,\n   145\t    }\n   146\t}\n   147\t\n   148\timpl State {\n   149\t    fn warning_signature(\n   150\t        &self,\n   151\t        context: &ContextRef,\n   152\t        tenant: &Tenant,\n   153\t        binding: &SetupWarningBinding,\n   154\t    ) -> u64 {\n   155\t        let mut hash = DefaultHasher::new();\n   156\t        context.as_str().hash(&mut hash);\n   157\t        tenant.profile.id.as_str().hash(&mut hash);\n   158\t        binding.tsg_id.hash(&mut hash);\n   159\t        binding.origin.hash(&mut hash);\n   160\t        for class in [CredentialClass::Scan, CredentialClass::Management] {\n   161\t            match tenant.capability(class) {\n   162\t                ScanCapability::Ready { record, .. } => record.as_str().hash(&mut hash),\n   163\t                _ => \"not-ready\".hash(&mut hash),\n   164\t            }\n   165\t        }\n   166\t        tenant.management_client.hash(&mut hash);\n   167\t        if let Some(workspace) = &binding.workspace {\n   168\t            workspace.id.hash(&mut hash);\n   169\t            workspace.slug.hash(&mut hash);\n   170\t            workspace.scope_name.hash(&mut hash);\n   171\t        }\n   172\t        if binding.line == VerifyLine::Gateway {\n   173\t            self.gateway_selection()\n   174\t                .as_ref()\n   175\t                .map(|w| w.as_str())\n   176\t                .hash(&mut hash);\n   177\t        }\n   178\t        hash.finish()\n   179\t    }\n   180\t\n   181\t    pub(super) fn begin_warning_recheck(\n   182\t        &mut self,\n   183\t        context: &ContextRef,\n   184\t        warning: &str,\n   185\t        keychain: Arc<dyn super::CredentialStore>,\n   186\t        session: Arc<SessionVault>,\n   187\t    ) -> Result<(Option<OperationId>, Vec<Start>), Refusal> {\n   188\t        self.require_storage()?;\n   189\t        self.prune_warning_rechecks();\n   190\t        let id = self.check_context(context)?;\n   191\t        if self.is_setup_context(context) {\n   192\t            return Err(Refusal::InvalidInput);\n   193\t        }\n   194\t        if self\n   195\t            .warning_rechecks\n   196\t            .iter()\n   197\t            .any(|r| &r.context == context && r.warning == warning)\n   198\t        {\n   199\t            return Err(Refusal::Busy);\n   200\t        }\n   201\t        let tenant = self.tenant(&id).ok_or(Refusal::StaleContext)?;\n   202\t        let saved = tenant\n   203\t            .setup_warnings\n   204\t            .iter()\n   205\t            .find(|w| w.id == warning && w.resolved_secs.is_none())\n   206\t            .ok_or(Refusal::InvalidInput)?;\n   207\t        let line = saved\n   208\t            .check\n   209\t            .as_ref()\n   210\t            .map_or(line_for(saved.product), |b| b.line);\n   211\t        if line != line_for(saved.product)\n   212\t            && !(saved.product == ProductId::RuntimeSecurity\n   213\t                && line == VerifyLine::ManagementClient)\n   214\t        {\n   215\t            return Err(Refusal::InvalidInput);\n   216\t        }\n   217\t        let binding = binding_for(tenant, line, self.chosen_scope(context));\n   218\t        let signature = self.warning_signature(context, tenant, &binding);\n   219\t        let at = super::wall_secs(self.clock_offset);\n   220\t        let request = match line {\n   221\t            VerifyLine::ScanKey => {\n   222\t                let result = if matches!(tenant.scan, ScanCapability::Ready { .. }) {\n   223\t                    (VerifyState::Stored, \"Scan key configured. Its service validity is checked only when you submit a scan.\".to_owned())\n   224\t                } else {\n   225\t                    (\n   226\t                        VerifyState::Warning,\n   227\t                        \"No ready scan key configured; scanning stays unavailable.\".to_owned(),\n   228\t                    )\n   229\t                };\n   230\t                self.finish_warning_recheck(&id, warning, &binding, result, at);\n   231\t                return Ok((None, Vec::new()));\n   232\t            }\n   233\t            VerifyLine::ManagementClient => ManagementRequest::Verify,\n   234\t            VerifyLine::Gateway => {\n   235\t                let Some(workspace) = self\n   236\t                    .gateway_selection()\n   237\t                    .filter(|_| self.chosen_scope(context).is_some())\n   238\t                else {\n   239\t                    self.finish_warning_recheck(&id, warning, &binding, (VerifyState::Warning, \"Choose the relevant Gateway workspace in Administration before rechecking its setup.\".to_owned()), at);\n   240\t                    return Ok((None, Vec::new()));\n   241\t                };\n   242\t                ManagementRequest::Gateway {\n   243\t                    workspace: Some(workspace),\n   244\t                    read: GatewayRead::Prerequisites,\n   245\t                }\n   246\t            }\n   247\t            VerifyLine::RedTeam => ManagementRequest::RedTeam { window: 7 },\n   248\t            VerifyLine::ModelSkill => ManagementRequest::SupplyChain,\n   249\t            _ => return Err(Refusal::InvalidInput),\n   250\t        };\n   251\t        let (operation, starts) =\n   252\t            self.admit_management(context.clone(), request, keychain, session)?;\n   253\t        self.warning_rechecks.push(Recheck {\n   254\t            operation: operation.clone(),\n   255\t            context: context.clone(),\n   256\t            tenant: id,\n   257\t            warning: warning.to_owned(),\n   258\t            binding,\n   259\t            signature,\n   260\t            started_secs: at,\n   261\t        });\n   262\t        Ok((Some(operation), starts))\n   263\t    }\n   264\t\n   265\t    fn warning_recheck_current(&self, run: &Recheck) -> bool {\n   266\t        if self.active_ref.as_ref() != Some(&run.context)\n   267\t            || self.data.active.as_ref() != Some(&run.tenant)\n   268\t        {\n   269\t            return false;\n   270\t        }\n   271\t        let Some(tenant) = self.tenant(&run.tenant) else {\n   272\t            return false;\n   273\t        };\n   274\t        let current = binding_for(tenant, run.binding.line, self.chosen_scope(&run.context));\n   275\t        current == run.binding\n   276\t            && self.warning_signature(&run.context, tenant, &current) == run.signature\n   277\t    }\n   278\t\n   279\t    /// Lease invalidation cannot depend on a service ever replying. Keep\n   280\t    /// only checks still bound to the current context/credential/workspace.\n   281\t    pub(super) fn prune_warning_rechecks(&mut self) {\n   282\t        let retired = self\n   283\t            .warning_rechecks\n   284\t            .iter()\n   285\t            .filter(|r| !self.warning_recheck_current(r))\n   286\t            .map(|r| r.operation.clone())\n   287\t            .collect::<Vec<_>>();\n   288\t        self.warning_rechecks\n   289\t            .retain(|r| !retired.contains(&r.operation));\n   290\t        self.retire_warning_check_records(&retired);\n   291\t    }\n   292\t\n   293\t    pub(super) fn warning_recheck_operations(&self) -> Vec<OperationId> {\n   294\t        self.warning_rechecks\n   295\t            .iter()\n   296\t            .map(|r| r.operation.clone())\n   297\t            .collect()\n   298\t    }\n   299\t\n   300\t    pub(super) fn warning_recheck_settled(\n   301\t        &mut self,\n   302\t        operation: &OperationId,\n   303\t        result: &ManagementResult,\n   304\t    ) {\n   305\t        let Some(index) = self\n   306\t            .warning_rechecks\n   307\t            .iter()\n   308\t            .position(|r| &r.operation == operation)\n   309\t        else {\n   310\t            return;\n   311\t        };\n   312\t        let run = self.warning_rechecks.remove(index);\n   313\t        if self.active_ref.as_ref() != Some(&run.context)\n   314\t            || self.data.active.as_ref() != Some(&run.tenant)\n   315\t        {\n   316\t            return;\n   317\t        }\n   318\t        let Some(tenant) = self.tenant(&run.tenant) else {\n   319\t            return;\n   320\t        };\n   321\t        let binding = binding_for(tenant, run.binding.line, self.chosen_scope(&run.context));\n   322\t        if binding != run.binding\n   323\t            || self.warning_signature(&run.context, tenant, &binding) != run.signature\n   324\t        {\n   325\t            return;\n   326\t        }\n   327\t        let result = super::setup_domain::verify_result(binding.line, result);\n   328\t        self.finish_warning_recheck(\n   329\t            &run.tenant,\n   330\t            &run.warning,\n   331\t            &binding,\n   332\t            result,\n   333\t            super::wall_secs(self.clock_offset),\n   334\t        );\n   335\t    }\n   336\t\n   337\t    fn finish_warning_recheck(\n   338\t        &mut self,\n   339\t        tenant: &TenantId,\n   340\t        id: &str,\n   341\t        binding: &SetupWarningBinding,\n   342\t        (state, mut reason): (VerifyState, String),\n   343\t        at: u32,\n   344\t    ) {\n   345\t        let before = self.data.clone();\n   346\t        let Some(warning) = self\n   347\t            .data\n   348\t            .tenants\n   349\t            .iter_mut()\n   350\t            .find(|t| &t.profile.id == tenant)\n   351\t            .and_then(|t| {\n   352\t                t.setup_warnings\n   353\t                    .iter_mut()\n   354\t                    .find(|w| w.id == id && w.resolved_secs.is_none())\n   355\t            })\n   356\t        else {\n   357\t            return;\n   358\t        };\n   359\t        let basis = basis(warning, binding);\n   360\t        // A stored scan-key configuration is a tenant-local fact, including\n   361\t        // old scan-only profiles without a TSG. Remote checks still require it.\n   362\t        let equivalent = basis != SetupWarningBasis::Unknown\n   363\t            && (binding.line == VerifyLine::ScanKey || !binding.tsg_id.is_empty());\n   364\t        let passed = state == VerifyState::Pass\n   365\t            || (binding.line == VerifyLine::ScanKey && state == VerifyState::Stored);\n   366\t        if passed && !equivalent {\n   367\t            reason.push_str(\" The current check passed, but the original check scope cannot be established; its warning remains active.\");\n   368\t        }\n   369\t        if basis == SetupWarningBasis::LegacyTenantSources {\n   370\t            reason.push_str(\" Reconstructed from the known legacy setup check for this tenant; the original diagnostic is unchanged.\");\n   371\t        }\n   372\t        if basis == SetupWarningBasis::LegacyWorkspaceScope {\n   373\t            reason.push_str(\" Reconstructed from the legacy workspace UUID and scope name. The current listed slug was checked against IAM; the original slug was not recorded.\");\n   374\t        }\n   375\t        warning.recheck = Some(SetupWarningRecheck {\n   376\t            checked_secs: at,\n   377\t            state,\n   378\t            reason,\n   379\t            equivalent,\n   380\t            basis,\n   381\t        });\n   382\t        if passed\n   383\t            && equivalent\n   384\t            && binding.line == VerifyLine::Gateway\n   385\t            && warning\n   386\t                .check\n   387\t                .as_ref()\n   388\t                .is_some_and(|b| b.workspace.is_none())\n   389\t            && missing_workspace(&warning.reason)\n   390\t            && let Some(check) = &mut warning.recheck\n   391\t        {\n   392\t            check.reason.push_str(\" The original check found no selected workspace; the current selection's full setup prerequisites were checked.\");\n   393\t        }\n   394\t        if passed && equivalent {\n   395\t            warning.resolved_secs = Some(at);\n   396\t        }\n   397\t        if self.save_with(&before).is_err()\n   398\t            && let Some(warning) = self\n   399\t                .data\n   400\t                .tenants\n   401\t                .iter_mut()\n   402\t                .find(|t| &t.profile.id == tenant)\n   403\t                .and_then(|t| t.setup_warnings.iter_mut().find(|w| w.id == id))\n   404\t        {\n   405\t            warning.recheck = Some(SetupWarningRecheck { checked_secs: at, state: VerifyState::Fail,\n   406\t                    reason: \"The recheck result could not be saved; the original warning remains active. Try again when local storage is available.\".to_owned(), equivalent: false, basis: SetupWarningBasis::Unknown });\n   407\t        }\n   408\t    }\n   409\t\n   410\t    pub(super) fn warning_recheck_view(&self, mut view: TenantView) -> TenantView {\n   411\t        for warning in &mut view.setup_warnings {\n   412\t            if let Some(run) = self.warning_rechecks.iter().find(|r| {\n   413\t                r.tenant == view.id\n   414\t                    && r.warning == warning.id\n   415\t                    && self.active_ref.as_ref() == Some(&r.context)\n   416\t            }) {\n   417\t                warning.recheck = Some(SetupWarningRecheck {\n   418\t                    checked_secs: run.started_secs,\n   419\t                    state: VerifyState::Pending,\n   420\t                    reason: \"Rechecking the setup finding…\".to_owned(),\n   421\t                    equivalent: false,\n   422\t                    basis: SetupWarningBasis::Unknown,\n   423\t                });\n   424\t            }\n   425\t        }\n   426\t        view\n   427\t    }\n   428\t}\n   429\t\n   430\t#[cfg(test)]\n   431\tmod tests {\n   432\t    use super::*;\n   433\t\n   434\t    #[tokio::test]\n   435\t    async fn context_retirement_prunes_checks_without_waiting_for_a_management_reply() {\n   436\t        let (adapters, _) = crate::fixtures::adapters();\n   437\t        let core = crate::Core::new(crate::CoreConfig::default(), adapters);\n   438\t        let mut state = super::super::lock(&core.inner).unwrap();\n   439\t        let tenant = crate::tenants::TenantId::issue().unwrap();\n   440\t        state\n   441\t            .data\n   442\t            .tenants\n   443\t            .push(Tenant::new(crate::tenants::TenantProfile {\n   444\t                id: tenant.clone(),\n   445\t                label: \"Fixture\".to_owned(),\n   446\t                tsg_id: Some(\"1234567890\".to_owned()),\n   447\t                destination: crate::tenants::Destination::Custom {\n   448\t                    origin: \"https://localhost:9\".to_owned(),\n   449\t                },\n   450\t                environment: crate::features::TenantEnvironment::Production,\n   451\t            }));\n   452\t        state.data.active = Some(tenant.clone());\n   453\t        state.reissue_context();\n   454\t        let context = state.active_ref.clone().unwrap();\n   455\t        let binding = binding_for(state.tenant(&tenant).unwrap(), VerifyLine::ModelSkill, None);\n   456\t        let signature = state.warning_signature(&context, state.tenant(&tenant).unwrap(), &binding);\n   457\t        state.warning_rechecks.push(Recheck {\n   458\t            operation: serde_json::from_str(\"\\\"op-1\\\"\").unwrap(),\n   459\t            context,\n   460\t            tenant,\n   461\t            warning: \"vw-1\".to_owned(),\n   462\t            binding,\n   463\t            signature,\n   464\t            started_secs: 1,\n   465\t        });\n   466\t        state.changed();\n   467\t        assert_eq!(\n   468\t            state.warning_rechecks.len(),\n   469\t            1,\n   470\t            \"a current unanswered check stays pending\"\n   471\t        );\n   472\t        state.reissue_context();\n   473\t        assert!(\n   474\t            state.warning_rechecks.is_empty(),\n   475\t            \"no completion can be required to release this bookkeeping\"\n   476\t        );\n   477\t    }\n   478\t}\n","exit_code":0,"status":"completed"}}
