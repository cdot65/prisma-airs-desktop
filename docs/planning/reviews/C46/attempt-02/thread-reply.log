{"type":"item.completed","item":{"id":"item_38","type":"command_execution","command":"/bin/zsh -lc 'cat crates/xtask/examples/p11_native_candidate.rs; cat tools/p11/test_remediation.py; cat tools/p10/review_gate.py'","aggregated_output":"//! Versioned P11 fixture preparation; never overwrites sealed preparation.\nuse sha2::{Digest, Sha256};\nuse std::{\n    fs,\n    io::Write,\n    path::Path,\n    time::{SystemTime, UNIX_EPOCH},\n};\nuse xtask::{Repo, env::Environment, manifest::Manifest, native};\n\ntype Result<T> = std::result::Result<T, Box<dyn std::error::Error>>;\n\nfn reserve(repo: &Repo, args: &[String]) -> Result<fs::File> {\n    let name = args.get(1).map(String::as_str).unwrap_or(\"\");\n    let attempt = name\n        .strip_prefix(\"docs/planning/evidence/P11/native-build-\")\n        .and_then(|s| s.strip_suffix(\"-vm/native-prepare.json\"))\n        .and_then(|s| s.parse::<u32>().ok());\n    if args.len() != 2\n        || args[0] != \"--out\"\n        || !attempt.is_some_and(|n| {\n            n >= 5\n                && name\n                    == format!(\n                        \"docs/planning/evidence/P11/native-build-{n:02}-vm/native-prepare.json\"\n                    )\n        })\n    {\n        return Err(\"expected --out docs/planning/evidence/P11/native-build-NN-vm/native-prepare.json (NN>=05)\".into());\n    }\n    if repo.root().canonicalize()? != repo.root() {\n        return Err(\"repository parents must not be symlinks\".into());\n    }\n    let mut parent = repo.root().to_path_buf();\n    for part in Path::new(name)\n        .parent()\n        .ok_or(\"missing output parent\")?\n        .components()\n    {\n        parent.push(part);\n        match fs::symlink_metadata(&parent) {\n            Ok(m) if m.is_dir() && !m.file_type().is_symlink() => {}\n            Err(e) if e.kind() == std::io::ErrorKind::NotFound => fs::create_dir(&parent)?,\n            _ => return Err(\"output parents must be real directories\".into()),\n        }\n    }\n    Ok(fs::OpenOptions::new()\n        .write(true)\n        .create_new(true)\n        .open(repo.join(name))?)\n}\n\nfn main() -> Result<()> {\n    let repo = Repo::discover();\n    // Reserve before environment probes, extraction or either build command.\n    // A failed build leaves this incomplete attempt reserved for inspection.\n    let mut output = reserve(&repo, &std::env::args().skip(1).collect::<Vec<_>>())?;\n    let manifest = Manifest::load(&repo.manifest())?;\n    let target = \"aarch64-apple-darwin\";\n    let features = vec![\"test-fixtures\".to_owned()];\n    if manifest.target != target || manifest.fixture_only_features != features {\n        return Err(\"P11 requires the fixed ARM64 fixture recipe\".into());\n    }\n    let env = Environment::prepare(&repo)?;\n    xtask::harness::unpack(&repo)?;\n    let commands: Vec<Vec<String>> = native::build_commands(target)\n        .iter()\n        .map(|argv| argv.iter().map(|s| (*s).to_owned()).collect())\n        .collect();\n    for argv in &commands {\n        if !env.command(argv, repo.root())?.status()?.success() {\n            return Err(format!(\"fixture build failed: {}\", argv.join(\" \")).into());\n        }\n    }\n    let bundle = native::bundle_path(&repo, target, \"Prisma AIRS Desktop Fixture\");\n    let identifier = native::plist_value(&bundle, \"CFBundleIdentifier\")?;\n    if identifier != native::FIXTURE_IDENTIFIER {\n        return Err(format!(\"unexpected fixture identifier: {identifier}\").into());\n    }\n    let prepared = native::Prepared {\n        subject: \"P11\".to_owned(),\n        built_utc: desktop_core::sessions::rfc3339(\n            SystemTime::now().duration_since(UNIX_EPOCH)?.as_secs(),\n        ),\n        bundle: bundle.strip_prefix(repo.root())?.display().to_string(),\n        identifier,\n        executable_sha256: hex::encode(Sha256::digest(fs::read(\n            bundle.join(\"Contents/MacOS/prisma-airs-desktop\"),\n        )?)),\n        bundle_sha256: xtask::fingerprint::tree_hash(&bundle)?,\n        features,\n        target: target.to_owned(),\n        commands,\n    };\n    serde_json::to_writer_pretty(&mut output, &prepared)?;\n    output.write_all(b\"\\n\")?;\n    output.sync_all()?;\n    Ok(())\n}\n\n#[cfg(test)]\nmod tests {\n    use super::*;\n\n    #[test]\n    fn invalid_paths_collisions_and_symlink_parents_refuse_before_build() -> Result<()> {\n        let base = std::env::temp_dir().join(format!(\n            \"airs-p11-reserve-{}-{}\",\n            std::process::id(),\n            SystemTime::now().duration_since(UNIX_EPOCH)?.as_nanos()\n        ));\n        fs::create_dir(&base)?;\n        let repo = Repo::new(base.canonicalize()?);\n        for value in [\n            \"docs/planning/evidence/P11/native-prepare.json\",\n            \"docs/planning/evidence/P11/native-build-04-vm/native-prepare.json\",\n            \"docs/planning/evidence/P11/native-build-5-vm/native-prepare.json\",\n            \"docs/planning/evidence/P11/native-build-0005-vm/native-prepare.json\",\n            \"docs/planning/evidence/P11/../P11/native-build-05-vm/native-prepare.json\",\n            \"/docs/planning/evidence/P11/native-build-05-vm/native-prepare.json\",\n        ] {\n            assert!(reserve(&repo, &[\"--out\".into(), value.into()]).is_err());\n        }\n        assert!(reserve(&repo, &[]).is_err());\n        assert!(reserve(&repo, &[\"--out\".into()]).is_err());\n        assert!(reserve(&repo, &[\"--wrong\".into(), \"x\".into()]).is_err());\n        assert!(!repo.join(\"docs\").exists());\n        let value = \"docs/planning/evidence/P11/native-build-05-vm/native-prepare.json\";\n        let args = vec![\"--out\".to_owned(), value.to_owned()];\n        reserve(&repo, &args)?.write_all(b\"owned-sentinel\")?;\n        assert!(reserve(&repo, &args).is_err());\n        assert_eq!(fs::read(repo.join(value))?, b\"owned-sentinel\");\n        drop(reserve(\n            &repo,\n            &[\"--out\".into(), value.replace(\"05-vm\", \"06-vm\")],\n        )?);\n        fs::remove_dir_all(repo.join(\"docs\"))?;\n        fs::create_dir(repo.join(\"outside\"))?;\n        std::os::unix::fs::symlink(repo.join(\"outside\"), repo.join(\"docs\"))?;\n        assert!(reserve(&repo, &args).is_err());\n        assert_eq!(fs::read_dir(repo.join(\"outside\"))?.count(), 0);\n        fs::remove_dir_all(&base)?;\n        Ok(())\n    }\n}\n\"\"\"Adversarial remediation-validator fixtures, never application qualification evidence.\"\"\"\nfrom pathlib import Path\nfrom io import BytesIO\nimport copy\nimport hashlib\nimport json\nimport tarfile\nimport tempfile\nimport unittest\nfrom unittest.mock import patch\n\nimport remediation\n\n\nclass RemediationTests(unittest.TestCase):\n    def setUp(self):\n        directory = tempfile.TemporaryDirectory()\n        self.addCleanup(directory.cleanup)\n        self.root = Path(directory.name).resolve()\n        self.app = 'apps/desktop/src/v2/workbench/api-client.tsx'\n        self.rust = 'crates/desktop-core/tests/harness_tools/main.rs'\n        self.app_pair = ('fixture-old-app', 'fixture-new-app')\n        self.rust_pair = ('fixture-old-test', 'fixture-new-test')\n        app_patch = patch.object(remediation, 'APP_DELTA', {self.app: self.app_pair})\n        rust_patch = patch.object(remediation, 'TEST_DELTA', {self.rust: self.rust_pair})\n        app_patch.start(); rust_patch.start()\n        self.addCleanup(app_patch.stop); self.addCleanup(rust_patch.stop)\n\n    def put(self, name, data):\n        path = self.root / name\n        path.parent.mkdir(parents=True, exist_ok=True)\n        path.write_bytes(data)\n        return {'path': name, 'sha256': hashlib.sha256(data).hexdigest()}\n\n    def json(self, name, value):\n        return self.put(name, (json.dumps(value, sort_keys=True) + '\\n').encode())\n\n    def test_delta_requires_every_exact_reviewed_pair_and_rejects_other_production(self):\n        before = {self.app: {'sha256': self.app_pair[0]}, self.rust: {'sha256': self.rust_pair[0]}}\n        after = {self.app: {'sha256': self.app_pair[1]}, self.rust: {'sha256': self.rust_pair[1]}}\n        # A declared verifier edit is allowed alongside both exact, mandatory reviewed fixes.\n        before['tools/p11/remediation.py'] = {'sha256': 'old-verifier'}\n        after['tools/p11/remediation.py'] = {'sha256': 'new-verifier'}\n        declared = sorted(after)\n        self.assertEqual(remediation.delta(before, after, declared), declared)\n        for change in ('undeclared', 'unrelated', 'altered', 'omitted', 'unfrozen'):\n            b, a, names = copy.deepcopy(before), copy.deepcopy(after), declared[:]\n            if change == 'undeclared': names.pop()\n            elif change == 'unrelated':\n                a['apps/desktop/src/app.tsx'] = {'sha256': 'unreviewed'}\n                names = sorted(a)\n            elif change == 'altered': a[self.app]['sha256'] = 'different-app-fix'\n            elif change == 'omitted':\n                a[self.rust] = b[self.rust]\n                names.remove(self.rust)\n            else:\n                with patch.object(remediation, 'APP_DELTA', {}), self.assertRaises(ValueError):\n                    remediation.delta(b, a, names)\n                continue\n            with self.subTest(change=change), self.assertRaises(ValueError):\n                remediation.delta(b, a, names)\n\n    def test_dependencies_include_all_resources_and_exclude_only_pinned_scope_changes(self):\n        retained = {'resources/harness.json', 'resources/icons/another.svg', 'resources/fixtures/nested.bin',\n                    'crates/desktop-core/src/lib.rs', 'crates/xtask/src/main.rs',\n                    'packages/desktop-contracts/src/generated/Intent.ts', 'docs/architecture/checks.json',\n                    '.cargo/config.toml', 'Cargo.toml', 'Cargo.lock', 'rust-toolchain.toml',\n                    'pnpm-lock.yaml', 'pnpm-workspace.yaml', 'package.json', 'crates/xtask/Cargo.toml'}\n        frontend = 'apps/desktop/src/v2/store.ts'\n        helper = 'tools/native-acceptance/owned-fixture.py'\n        files = {n: {'sha256': 'fixture'} for n in retained | {frontend, helper, self.app, self.rust, 'README.md'}}\n        core = remediation.dependencies(files, 'test:C46/core/1', [helper])\n        self.assertEqual(set(core), retained | {helper})\n        ui = remediation.dependencies(files, 'test:C48/frontend/1', [helper])\n        self.assertEqual(set(ui), retained | {frontend, helper})\n        self.assertEqual(ui, sorted(ui))\n        self.assertNotIn(self.app, ui)\n        self.assertNotIn(self.rust, ui)\n        # An unpinned sibling production file cannot disappear from an unaffected native closure.\n        files['apps/desktop/src/another.tsx'] = {'sha256': 'must-be-compared'}\n        self.assertIn('apps/desktop/src/another.tsx', remediation.dependencies(files, 'C49-N01'))\n\n    def bundle_fixture(self, executable=b'original-executable'):\n        archive = self.root / 'fixture-app.tar'\n        with tarfile.open(archive, 'w') as stream:\n            directory = tarfile.TarInfo('Fixture.app'); directory.type = tarfile.DIRTYPE\n            stream.addfile(directory)\n            item = tarfile.TarInfo('Fixture.app/Contents/MacOS/prisma-airs-desktop')\n            item.size = len(executable); item.mode = 0o755\n            stream.addfile(item, BytesIO(executable))\n        exe = hashlib.sha256(executable).hexdigest()\n        bundle = hashlib.sha256(('Contents/MacOS/prisma-airs-desktop\\0' + '100755\\0' + exe + '\\n').encode()).hexdigest()\n        return {'path': archive.name, 'sha256': remediation.sha(archive), 'size': archive.stat().st_size}, exe, bundle\n\n    def test_preserved_bundle_rejects_changed_tar_even_when_rebound_and_wrong_identity(self):\n        archive, exe, bundle = self.bundle_fixture()\n        original = {'prepare': {'path': 'original-prepare.json', 'sha256': 'fixture-prepare'},\n                    'executable_sha256': exe, 'bundle_sha256': bundle}\n        record = {'schema': 'airs-desktop/p11-preserved-candidate/1',\n                  'old_qualification': {'path': remediation.BASELINE}, 'original_prepare': original['prepare'],\n                  'archive': archive, 'executable_sha256': exe, 'bundle_sha256': bundle}\n        reference = self.json('preserved.json', record)\n        remediation.preserved_bundle(self.root, reference, original)\n        # Rewriting only tar bytes must fail the immutable reference first.\n        (self.root / archive['path']).write_bytes(b'changed archive bytes')\n        with self.assertRaises(ValueError): remediation.preserved_bundle(self.root, reference, original)\n        # Rehashing the changed archive and manifest cannot substitute a different executable.\n        changed_archive, _, _ = self.bundle_fixture(b'altered-executable')\n        changed = dict(record, archive=changed_archive)\n        changed_ref = self.json('rebound.json', changed)\n        with self.assertRaisesRegex(ValueError, 'application bytes differ'):\n            remediation.preserved_bundle(self.root, changed_ref, original)\n        restored_archive, _, _ = self.bundle_fixture()\n        reference = self.json('preserved.json', dict(record, archive=restored_archive))\n        with self.assertRaisesRegex(ValueError, 'application bytes differ'):\n            remediation.preserved_bundle(self.root, reference, dict(original, bundle_sha256='foreign-bundle'))\n        with self.assertRaisesRegex(ValueError, 'candidate source differs'):\n            remediation.preserved_bundle(self.root, reference, dict(original, prepare={'path': 'foreign-prepare'}))\n\n    def test_source_selection_requires_original_producers_and_bounded_source_hashes(self):\n        # These five synthetic selector records exercise the validator, not real application checks.\n        app_input = self.put('inputs/final-app.tsx', b'validator fixture final app source')\n        test_name = 'apps/desktop/src/v2/workbench/api-client.test.tsx'\n        test_input = self.put('inputs/api.test.tsx', b'validator fixture tests')\n        files = {self.app: {'sha256': app_input['sha256']}, test_name: {'sha256': test_input['sha256']}}\n        selected = []\n        producers = [[], []]\n        coverage = [('C48/recovery-final02', 4), ('C48/typecheck-final02', None),\n                    ('C48/controllers-final', 20), ('C48/api-prior', 42), ('C48/shell-and-cases-prior', 45)]\n        for index, (cid, passed) in enumerate(coverage):\n            log = self.put('logs/selector%d.log' % index, ('validator fixture only: ' + cid).encode())\n            command = {'argv': ['fixture-validator', cid], 'cwd': '/validator/temporary-root',\n                       'exit_code': 0, 'passed': passed}\n            original = dict(command, log='original-private/selector%d.log' % index, log_sha256=log['sha256'])\n            producers[0 if index < 2 else 1].append(original)\n            hashes = {self.app: app_input['sha256']}\n            inputs = {self.app: app_input}\n            if index >= 2:\n                hashes[test_name] = test_input['sha256']; inputs[test_name] = test_input\n            selected.append(dict(command, id=cid, log=log, source_hashes=hashes, source_inputs=inputs))\n        producer_refs = [self.json('producer%d.json' % index, {'final_checks': rows,\n                         'meaning': 'pure validator fixtures, no application execution'})\n                         for index, rows in enumerate(producers)]\n        supplement = {'schema': 'airs-desktop/p11-c48-source-supplement/1',\n                      'source_files': {self.app: app_input['sha256']},\n                      'producer_receipts': producer_refs, 'checks': selected}\n        def consume(value):\n            reference = self.json('source-selection.json', value)\n            return remediation.source_qa(self.root, reference, files)\n        with patch.object(remediation, 'APP_DELTA', {self.app: ('fixture-before', app_input['sha256'])}):\n            self.assertEqual(len(consume(supplement)['checks']), 5)\n            for change in ('omitted', 'forged-command', 'forged-log', 'unknown-prior-source'):\n                altered = copy.deepcopy(supplement)\n                if change == 'omitted': altered['checks'].pop()\n                elif change == 'forged-command': altered['checks'][0]['argv'].append('not-in-producer')\n                elif change == 'forged-log':\n                    altered['checks'][0]['log'] = self.put('logs/invented.log', b'not original producer output')\n                else:\n                    unknown = self.put('inputs/unreviewed-app.tsx', b'unknown earlier production change')\n                    altered['checks'][2]['source_hashes'][self.app] = unknown['sha256']\n                    altered['checks'][2]['source_inputs'][self.app] = unknown\n                with self.subTest(change=change), self.assertRaises(ValueError):\n                    consume(altered)\n\n    def test_versioned_build_preserves_canonical_output_and_exact_fixture_recipe(self):\n        # Preparation metadata and commands are validator fixtures; no builder is executed.\n        canonical = 'docs/planning/evidence/P11/native-prepare.json'\n        versioned = 'docs/planning/evidence/P11/native-build-05-vm/native-prepare.json'\n        prepared = {'commands': [['fixture-build-recipe']], 'target': 'fixture-arm64-target',\n                    'features': ['fixture'], 'subject': 'P11'}\n        old_ref = self.json(canonical, prepared)\n        new_ref = self.json(versioned, prepared)\n        candidate = {'prepare': new_ref}\n        argv = ['cargo', 'run', '--locked', '-p', 'xtask', '--example', 'p11_native_candidate', '--', '--out', versioned]\n        build = {'steps': [{'argv': argv}], 'application_inputs_before': {'app': 'same-fixture-input'},\n                 'application_inputs_after': {'app': 'same-fixture-input'}}\n        remediation.versioned_build(self.root, build, candidate)\n        offline = copy.deepcopy(build); offline['steps'][0]['argv'].insert(2, '--offline')\n        remediation.versioned_build(self.root, offline, candidate)\n        for change in ('canonical-output', 'old-version', 'changed-recipe', 'changed-after', 'different-command'):\n            current, record = copy.deepcopy(candidate), copy.deepcopy(build)\n            if change == 'canonical-output':\n                current['prepare'] = old_ref\n                record['steps'][0]['argv'][-1] = canonical\n            elif change == 'old-version':\n                current['prepare'] = dict(new_ref, path=versioned.replace('-05-', '-04-'))\n                record['steps'][0]['argv'][-1] = current['prepare']['path']\n            elif change == 'changed-recipe':\n                current['prepare'] = self.json(versioned, dict(prepared, commands=[['different-fixture-recipe']]))\n            elif change == 'changed-after': record['application_inputs_after']['app'] = 'different-input'\n            else: record['steps'][0]['argv'] = ['echo', 'a-build-was-not-executed']\n            with self.subTest(change=change), self.assertRaises(ValueError):\n                remediation.versioned_build(self.root, record, current)\n            self.json(versioned, prepared)\n\n    def native_fixture(self, kind):\n        source = self.put('tools/native-acceptance/fixture.py', b'# validator fixture only\\n')\n        execution = self.json('execution.json', {'meaning': 'pure validator fixture, no actual UI execution'})\n        candidate = {'prepare': {'path': 'prepare.json', 'sha256': 'fixture-prepare'},\n                     'executable_sha256': 'fixture-executable', 'bundle_sha256': 'fixture-bundle',\n                     'execution_root': '/fixture/vm/root', 'conditions': {'hostname': 'fixture-vm'}}\n        baseline = {'path': remediation.BASELINE, 'sha256': 'fixture-baseline'}\n        facts = (remediation.SCROLL_FACTS if kind == 'scroll' else\n                 {'missing_restore_warning_visible', 'recovery_survives_home_back', 'retry_is_explicit',\n                  'retry_recovers_when_root_restored', 'intentional_close_stays_closed'})\n        raw = {'facts': dict.fromkeys(facts, True), 'exit_code': 0, 'argv': ['fixture-only'],\n               'cwd': candidate['execution_root'], 'started_utc': '2026-01-01T00:00:00Z', 'finished_utc': '2026-01-01T00:00:01Z',\n               'source_sha256': source['sha256'], 'executable_sha256': candidate['executable_sha256'],\n               'bundle_sha256': candidate['bundle_sha256'], 'conditions': candidate['conditions'],\n               'helper_closure': {source['path']: source['sha256']}}\n        captures = [dict(self.put('capture%d.png' % n, b'validator fixture pixels'),\n                         visually_reviewed=True, accepted=True, findings=[]) for n in range(2)]\n        supplement = {'schema': ('airs-desktop/p11-drawer-scroll-supplement/1' if kind == 'scroll'\n                                 else 'airs-desktop/p11-recovery-supplement/1'),\n                      'baseline_qualification': baseline, 'facts': raw['facts'], 'execution': execution,\n                      'source': source, 'helper_closure': {source['path']: source['sha256']},\n                      'executable_sha256': candidate['executable_sha256'], 'bundle_sha256': candidate['bundle_sha256'],\n                      'captures': captures, 'prepare': candidate['prepare'],\n                      'retained_result': {'path': 'original-result.json', 'sha256': 'fixture-result'},\n                      'retained_reason': 'Preserve original first-use facts; fixture only.'}\n        if kind == 'scroll':\n            supplement['assertion'] = 'C47-N02'\n            raw.update(baseline_qualification=baseline, fixture_state_unchanged=True,\n                       fixture_modes_unchanged=True, trust_roots_unchanged=True,\n                       state_before_sha256='same-state', state_after_sha256='same-state',\n                       before_anchor={'pos': [1, 2], 'size': [100, 200]},\n                       after_anchor={'pos': [1, 2], 'size': [100, 200]},\n                       before_first_call={'pos': [10, 200]}, after_first_call={'pos': [10, 20]},\n                       before_lower_call={'pos': [10, 800]}, after_lower_call={'pos': [10, 100]})\n        return supplement, raw, candidate, baseline, {source['path']: {'sha256': source['sha256']}}\n\n    def test_native_supplements_reject_foreign_artifacts_vm_and_missing_facts(self):\n        for kind in ('scroll', 'recovery'):\n            supplement, raw, candidate, baseline, files = self.native_fixture(kind)\n            def consume(s, r):\n                s = copy.deepcopy(s); s['raw'] = self.json(kind + '-raw.json', r)\n                reference = self.json(kind + '.json', s)\n                if kind == 'scroll': return remediation.scroll(self.root, reference, baseline, candidate, files)\n                return remediation.recovery(self.root, reference, baseline, candidate, supplement['retained_result'], files)\n            consume(supplement, raw)\n            if kind == 'recovery':\n                expanded, expanded_raw = copy.deepcopy(supplement), copy.deepcopy(raw)\n                expanded['facts']['additional_replaced_root_observation'] = True\n                expanded_raw['facts']['additional_replaced_root_observation'] = True\n                consume(expanded, expanded_raw)\n                expanded['facts']['additional_replaced_root_observation'] = False\n                expanded_raw['facts']['additional_replaced_root_observation'] = False\n                with self.assertRaisesRegex(ValueError, 'observations incomplete'):\n                    consume(expanded, expanded_raw)\n            for change in ('artifact', 'missing-fact', 'unreviewed-capture', 'helper', 'reversed-time') + (('vm',) if kind == 'recovery' else ()):\n                s, r = copy.deepcopy(supplement), copy.deepcopy(raw)\n                if change == 'artifact':\n                    s['executable_sha256'] = r['executable_sha256'] = 'foreign-executable'\n                elif change == 'missing-fact':\n                    name = next(iter(s['facts'])); s['facts'].pop(name); r['facts'].pop(name)\n                elif change == 'unreviewed-capture': s['captures'][0]['visually_reviewed'] = False\n                elif change == 'helper': s['helper_closure'][next(iter(s['helper_closure']))] = 'foreign-helper'\n                elif change == 'reversed-time': r['finished_utc'] = '2025-12-31T23:59:59Z'\n                else: r['conditions'] = {'hostname': 'different-vm'}\n                with self.subTest(kind=kind, change=change), self.assertRaises(ValueError):\n                    consume(s, r)\n\n\nif __name__ == '__main__':\n    unittest.main()\n\"\"\"Read-only actual-review proof checks for C45/P10 and production prerequisites.\n\nNo score assignment, evidence execution, controller completion or release action.\n\"\"\"\nfrom pathlib import Path\nimport json\nimport sys\n\nsys.path.insert(0, str(Path(__file__).resolve().parent))\nsys.path.insert(0, str(Path(__file__).resolve().parents[1] / \"p09\"))\nfrom phase_packet import file_identity, digest, validate\nfrom phase_inputs import full_gate, require, read, sha, REVIEW_DISABLED\n\n\ndef transport(root, out, request):\n    invocation = read(out/\"invocation.json\")\n    require(invocation[\"request_sha256\"] == sha(out/\"request.json\"), \"transport request drift\")\n    schema_path = root/request.get(\"schema_archive\", \"docs/architecture/review-verdict.schema.json\")\n    require(invocation[\"schema_sha256\"] == sha(schema_path), \"transport schema drift\")\n    args = invocation[\"command_without_prompt\"]\n    require(args[0] == \"codex\" and args.count(\"exec\") == 1, \"not fresh Codex exec\")\n    for flag in [\"--no-daemon\", \"--ephemeral\", \"--ignore-user-config\", \"--ignore-rules\", \"--json\"]:\n        require(args.count(flag) == 1, \"transport isolation \" + flag)\n    for flag, value in [(\"-a\", \"never\"), (\"-s\", \"read-only\"), (\"-m\", \"gpt-6.1-sol\")]:\n        require(args.count(flag) == 1 and args[args.index(flag)+1] == value, \"transport isolation argument \" + flag)\n    require(args.count(\"--output-schema\") == 1 and args[args.index(\"--output-schema\")+1] == \"docs/architecture/review-verdict.schema.json\", \"transport output schema\")\n    expected_out = Path(request.get(\"execution_root\", root))/\"docs/planning/reviews\"/request[\"subject\"]/request[\"attempt_id\"]/\"verdict-returned.json\"\n    require(args.count(\"-o\") == 1 and args[args.index(\"-o\")+1] == str(expected_out), \"transport output path\")\n    require(invocation[\"model_requested\"] == \"gpt-6.1-sol\", \"configured review model changed\")\n    require(not any(\"dangerously\" in arg or arg in [\"resume\", \"fork\", \"--last\", \"--approve-for-me\"] for arg in args), \"review resume/bypass\")\n    disabled = [args[i+1] for i,a in enumerate(args) if a == \"--disable\"]\n    require(set(disabled) == REVIEW_DISABLED and len(disabled) == len(REVIEW_DISABLED), \"restricted review features\")\n    overrides = [args[i+1] for i,a in enumerate(args) if a == \"-c\"]\n    require(set(overrides) == {'web_search=\"disabled\"', 'model_reasoning_effort=\"xhigh\"'} and len(overrides) == 2, \"review overrides\")\n    require(invocation[\"feature_probe_sha256\"] == sha(out/\"feature-probe.log\"), \"feature probe drift\")\n    observed = {line.split()[0]:line.split()[-1] for line in (out/\"feature-probe.log\").read_text().splitlines() if len(line.split()) >= 3}\n    require(all(observed.get(k) == invocation[\"restricted_features_observed\"].get(k) == \"false\" for k in REVIEW_DISABLED), \"feature isolation not observed\")\n    messages=[];sessions=[]\n    for line in (out/\"thread-reply.log\").read_text().splitlines():\n        try:event=json.loads(line)\n        except json.JSONDecodeError:continue\n        if not isinstance(event,dict):continue\n        item=event.get(\"item\",{})\n        if not isinstance(item,dict):item={}\n        require(event.get(\"type\") not in [\"hook.started\",\"hook.completed\"] and item.get(\"type\") not in [\"mcp_tool_call\",\"hook_execution\"], \"unexpected review side effect\")\n        if event.get(\"type\") == \"thread.started\":sessions.append(event.get(\"thread_id\"))\n        if event.get(\"type\") == \"item.completed\" and item.get(\"type\") in [\"agent_message\",\"assistant_message\"]:messages.append(item.get(\"text\",\"\"))\n    require(len(sessions) == 1 and messages and json.loads(messages[-1]) == read(out/\"verdict-returned.json\"), \"actual independent returned verdict missing/mismatched\")\n    return dict(invocation_sha256=sha(out/\"invocation.json\"),thread_reply_sha256=sha(out/\"thread-reply.log\"),feature_probe_sha256=sha(out/\"feature-probe.log\"),reviewer_sessions_observed=sessions)\n\n\ndef actual_review(root, subject, attempt, source_root=None, evidence=True):\n    out=root/\"docs/planning/reviews\"/subject/attempt\n    request=read(out/\"request.json\"); verdict=read(out/\"verdict-returned.json\")\n    schema_path=(root/request[\"schema_archive\"] if request.get(\"schema_archive\")\n                 else (source_root or root)/\"docs/architecture/review-verdict.schema.json\")\n    # Historical P09 schema is preserved independently of future descriptions.\n    if subject == \"P09\":schema_path=root/\"docs/planning/evidence/C45/activation-20261102-g11/p09-source/docs/architecture/review-verdict.schema.json\"\n    validate(verdict,read(schema_path))\n    require(verdict[\"subject\"] == subject and request[\"subject\"] == subject and verdict[\"attempt_id\"] == request[\"attempt_id\"] == attempt and verdict[\"request_id\"] == request[\"request_id\"] and verdict[\"fingerprints\"] == request[\"fingerprints\"], \"actual verdict request/fingerprint binding\")\n    full_gate(verdict)\n    # Preserve request bytes: the archive path is verification context, never an edit.\n    transport_request=dict(request)\n    # A later schema description must not change an archived review's input.\n    # Supply verification context only; request/invocation bytes stay immutable.\n    if source_root is not None:\n        transport_request[\"schema_archive\"]=str(schema_path.relative_to(root))\n    if subject == \"P09\":\n        transport_request[\"schema_archive\"]=str(schema_path.relative_to(root))\n        transport_request[\"execution_root\"]=read(root/\"docs/planning/evidence/C45/activation-20261102-g11/p09-proof.json\")[\"source_checkout\"]\n    observed=transport(root,out,transport_request)\n    audit=read(out/\"post-review-audit.json\");receipt=read(out/\"receipt.json\")\n    require(audit[\"full_gate_pass\"] is True and receipt[\"full_gate_pass\"] is True and receipt[\"source_frozen\"] is True, \"actual full-gate audit missing\")\n    for record in [audit,receipt]:\n        require(record[\"request_sha256\"] == sha(out/\"request.json\") and record.get(\"raw_verdict_sha256\",record.get(\"verdict_sha256\")) == sha(out/\"verdict-returned.json\") and record[\"scores\"] == verdict[\"scores\"], \"review audit/receipt binding\")\n    require(receipt[\"post_review_audit_sha256\"] == sha(out/\"post-review-audit.json\") and receipt[\"fingerprints\"] == verdict[\"fingerprints\"], \"receipt audit/fingerprints\")\n    require(receipt[\"invocation_sha256\"] == observed[\"invocation_sha256\"] and receipt[\"thread_reply_sha256\"] == observed[\"thread_reply_sha256\"], \"receipt transport binding\")\n    for name,key,base in [(\"source-inventory.json\",\"source\",source_root or root),(\"evidence-inventory.json\",\"evidence\",root)]:\n        inventory=read(out/name)[\"files\"]\n        require(digest(inventory) == request[\"fingerprints\"][key], \"inventory fingerprint mismatch\")\n        if evidence or key == \"source\":\n            locations = read(root/\"docs/planning/evidence/C45/activation-20261102-g11/p09-extra-evidence/locations.json\") if subject == \"P09\" and key == \"evidence\" else {}\n            for relative,identity in inventory.items():\n                path = root/locations[relative] if relative in locations else base/relative\n                require(file_identity(path) == identity, \"reviewed input drift: \" + relative)\n    return dict(subject=subject,attempt=attempt,request_sha256=sha(out/\"request.json\"),verdict_sha256=sha(out/\"verdict-returned.json\"),audit_sha256=sha(out/\"post-review-audit.json\"),receipt_sha256=sha(out/\"receipt.json\"),scores=verdict[\"scores\"],fingerprints=verdict[\"fingerprints\"])\n\n\ndef release_prerequisites(root):\n    archive=root/\"docs/planning/evidence/C45/activation-20261102-g11/p09-source\"\n    p09=actual_review(root,\"P09\",\"attempt-02\",archive)\n    standing=read(root/\"docs/planning/evidence/P10/completion-proof.json\")\n    require(standing[\"schema\"] == \"airs-desktop/p10-completion-proof/1\" and standing[\"p09\"] == p09,\"P09 prerequisite binding\")\n    # P10's exact reviewed source is archived on completion. Later C26 release\n    # implementation gets its own checks/review; it does not relabel P10 inputs.\n    archived=root/standing[\"source_archive\"]\n    require(archived.resolve().is_relative_to((root/\"docs/planning/evidence/P10\").resolve()),\"P10 archive escapes evidence\")\n    p10=actual_review(root,\"P10\",standing[\"attempt\"],archived)\n    require(standing[\"p10\"] == p10,\"P10 completion proof binding\")\n    c45=actual_review(root,\"C45\",standing[\"c45\"][\"attempt\"],root/standing[\"c45_source_archive\"])\n    require(standing[\"c45\"] == c45,\"C45 member proof binding\")\n    from packet import qualification\n    from historical import Historical\n    historical=Historical(root,standing[\"historical_context\"])\n    qualified=qualification(root,root/standing[\"qualification\"][\"record\"],current=False,historical=historical)\n    request=read(root/\"docs/planning/reviews/P10\"/standing[\"attempt\"]/\"request.json\")\n    require(qualified == standing[\"qualification\"] == request[\"qualification\"] and request[\"predecessors\"][\"C45\"] == c45,\"P10 qualified candidate/member binding\")\n    return {\"p09\":p09,\"p10\":p10,\"c45\":c45,\"controller_complete\":False,\"c26_required_here\":False}\n\n\nif __name__ == \"__main__\":\n    require(len(sys.argv) == 2 and sys.argv[1] == \"release-prerequisites\", \"usage: review_gate.py release-prerequisites\")\n    print(json.dumps(release_prerequisites(Path.cwd().resolve()),indent=2))\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_39","type":"command_execution","command":"/bin/zsh -lc \"sed -n '1,120p' apps/desktop/src/v2/inbox/inbox.tsx; sed -n '250,326p' apps/desktop/src/v2/inbox/inbox.tsx; cat apps/desktop/src/modules/tenants/management-credential.tsx; sed -n '1,160p' tools/native-acceptance/candidate_process.py\"","aggregated_output":"import { forwardRef, useEffect, useRef, useState } from 'react'\nimport type { FeatureId, InboxEntry, Intent, ProductId, SetupWarning, ShellSnapshot } from '@prisma-airs/desktop-contracts'\nimport type { DispatchOutcome } from '../../modules/tenants/dispatch'\nimport { INBOX_COPY as C, READ_COPY, SHELL_COPY, SNOOZE_COPY, clockOf } from '../copy'\nimport { Glyph, type GlyphName } from '../icons'\nimport { useShellStore } from '../store'\nimport type { VerdictTone } from '../verdict'\nimport { PageIntro } from '../page-intro'\nimport { SetupWarningResult } from '../setup-warning-history'\n\n/**\n * Sends one intent and reports its outcome on the shell's surfaces (DESIGN-V2\n * §7): a refusal or failed delivery as a warn toast naming `what`, an\n * unconfirmed delivery inline with Retry (never replayed on its own).\n */\nexport type Act = (what: string, intent: Intent) => Promise<DispatchOutcome>\n\nexport interface InboxProps {\n    snapshot: ShellSnapshot\n    onAct: Act\n    onNavigate: (feature: FeatureId) => void\n}\n\nexport type InboxTab = 'all' | 'action' | 'updates' | 'snoozed'\nconst TABS: InboxTab[] = ['all', 'action', 'updates', 'snoozed']\n\nexport const toneOf = (severity: InboxEntry['severity']): VerdictTone => (severity === 'bad' ? 'blocked' : severity === 'warn' ? 'flagged' : 'info')\n\n/** Where an entry's action leads (C30): the destination the core names. */\nexport function destinationFeature(entry: InboxEntry): FeatureId | null {\n    return entry.target?.feature ?? null\n}\n\n/**\n * Follows an entry's contextual action: the target's inventory and item are\n * handed to the destination (it selects them on arrival), then the shell\n * navigates through the core.\n */\nexport function follow(entry: InboxEntry, tenant: string, onNavigate: (feature: FeatureId) => void) {\n    const target = entry.target\n    if (!target) return\n    // The target belongs to the tenant it was followed in (I2): another tenant never inherits it.\n    useShellStore.getState().arrive({ tenant, feature: target.feature, resource: target.resource, item: target.item, ...(target.product ? { product: target.product } : {}) })\n    onNavigate(target.feature)\n}\n\n/** The tenant-named description of a hold action, for its outcome report. */\nexport function holdWhat(kind: 'acknowledgeItem' | 'snoozeItem' | 'unsnoozeItem', title: string): string {\n    return kind === 'acknowledgeItem' ? SHELL_COPY.acknowledgmentOf(title) : kind === 'snoozeItem' ? SHELL_COPY.snoozeOf(title) : SHELL_COPY.unsnoozeOf(title)\n}\n\n/** Which tab an entry belongs to; held entries are never \"needs action\". */\nexport function tabOf(entry: InboxEntry): InboxTab {\n    if (entry.hold?.kind === 'snooze') return 'snoozed'\n    if (entry.needsAction && !entry.hold) return 'action'\n    return 'updates'\n}\n\nconst severityTile = (severity: InboxEntry['severity']): { glyph: GlyphName; fg: string; bg: string } =>\n    severity === 'bad' ? { glyph: 'ban', fg: 'var(--v2-block)', bg: 'var(--v2-block-bg)' } : severity === 'warn' ? { glyph: 'alert', fg: 'var(--v2-flag)', bg: 'var(--v2-flag-bg)' } : { glyph: 'info', fg: 'var(--v2-soft)', bg: 'var(--v2-inset)' }\n\nconst button32 = 'flex h-8 min-h-0 items-center rounded-[7px] text-[13px] whitespace-nowrap'\n\n/**\n * The Inbox (C30, screens/inbox-reads.md): the active tenant's entries from\n * the core's Inbox scope, in tabs with counts, a detail pane with the facts,\n * the explanation and the contextual actions. Acknowledge and snooze are\n * core intents on the entry; the snooze return time is the core's and the\n * label is the one Home uses (I11). The selected tab and item are kept per\n * tenant across a switch (I2) and cleared when the tenant is deleted.\n */\nexport const Inbox = forwardRef<HTMLHeadingElement, InboxProps>(function Inbox({ snapshot, onAct, onNavigate }, _ref) {\n    const tenant = snapshot.tenants.find((t) => t.id === snapshot.active?.tenant) ?? null\n    const context = snapshot.active?.context ?? null\n    const tenantKey = tenant?.id ?? 'none'\n    const selection = useShellStore((s) => s.inboxSelection[tenantKey])\n    const selectInbox = useShellStore((s) => s.selectInbox)\n    const tab: InboxTab = selection?.tab ?? 'all'\n    const selectedId = selection?.item ?? null\n    const items = snapshot.inbox.items\n    const counts: Record<InboxTab, number> = { all: items.length, action: 0, updates: 0, snoozed: 0 }\n    for (const e of items) counts[tabOf(e)] += 1\n    const visible = items.filter((e) => tab === 'all' || tabOf(e) === tab)\n    const selected = items.find((e) => e.id === selectedId) ?? null\n    const selectedWarning = selected?.kind === 'setupWarning' ? tenant?.setupWarnings.find((w) => w.id === selected.id) : undefined\n    useEffect(() => {\n        if (selectedId && !items.some((e) => e.id === selectedId)) selectInbox(tenantKey, { tab, item: null })\n    }, [items, selectedId, selectInbox, tenantKey, tab])\n    const read = snapshot.inbox.read\n\n    // Holds are core intents; their outcomes reach the shell's surfaces. A\n    // snooze's return time is the core's: the shell announces it from the\n    // receipt the snapshot carries (the same toast whether asked here or on Home).\n    const act = (entry: InboxEntry, kind: 'acknowledgeItem' | 'snoozeItem' | 'unsnoozeItem') => context && void onAct(holdWhat(kind, entry.title), { kind, context, id: entry.id })\n    const readNow = () => context && tenant && void onAct(SHELL_COPY.readOf(tenant.label), { kind: 'readTenant', context })\n\n    // Never attempted, in progress, failed, partial, expired and healthy-empty\n    // reads stay distinct (I4, C12). Entries the core supplies (a setup\n    // warning before any read) are listed whatever the read status.\n    const failedUnread = read.state === 'failed' && read.lastReadAt === null && read.failedAt !== null\n    const stale = (read.state === 'done' || read.state === 'reading') && read.lastReadAt !== null && !snapshot.overview.fresh\n    const readingAgain = read.state === 'reading' && read.lastReadAt !== null\n    const empty = !tenant\n        ? C.emptyPending\n        : items.length === 0 && read.state === 'reading'\n          ? C.emptyReading\n          : items.length === 0 && read.state === 'pending'\n            ? C.emptyPending\n            : items.length === 0 && failedUnread\n              ? C.emptyFailed(clockOf(read.failedAt ?? 0))\n              : items.length === 0 && read.lastReadAt === null && read.settledAt !== null\n                ? C.emptyUnread(clockOf(read.settledAt), read.sourcesMissing.length)\n                : visible.length === 0\n                  ? tab === 'all' || tab === 'action'\n                      ? read.sourcesMissing.length > 0\n                          ? C.emptyPartial(read.products.reduce((n, p) => n + p.sourcesRead, 0), read.products.reduce((n, p) => n + p.sourcesTotal, 0), read.sourcesMissing)\n                          : stale\n                            ? C.emptyStale(clockOf(read.lastReadAt ?? 0))\n                            : C.emptyClear\n                      : C.emptyTab\n                <aside aria-label={C.detail} data-slot='inbox-detail' className='flex min-w-0 flex-col rounded-[12px] border break-words' style={{ padding: '28px 30px', gap: 18, borderColor: 'var(--v2-rule)', background: 'var(--v2-paper)' }}>\n                    {!selected ? (\n                        <div className='flex flex-grow flex-col items-center justify-center text-center leading-[1.5]' style={{ gap: 12, color: 'var(--v2-faint)' }}>\n                            <span>{empty ?? C.selectHint}</span>\n                        </div>\n                    ) : (\n                        <>\n                            <div className='flex items-center' style={{ gap: 10 }}>\n                                <span aria-hidden='true' className='grid size-[34px] place-items-center rounded-[9px]' style={{ background: severityTile(selected.severity).bg, color: severityTile(selected.severity).fg }}>\n                                    <Glyph name={severityTile(selected.severity).glyph} size={17} stroke={2} />\n                                </span>\n                                <span className='rounded-full text-[12px] font-semibold' style={{ padding: '2px 9px', background: severityTile(selected.severity).bg, color: severityTile(selected.severity).fg }}>\n                                    {C.severity[selected.severity]}\n                                </span>\n                                <span style={{ color: 'var(--v2-faint)' }}>\n                                    {selected.product ? READ_COPY.products[selected.product] : C.kind[selected.kind]} · {selected.source}\n                                </span>\n                            </div>\n                            <h2 className='min-w-0 text-[22px] font-bold' style={{ letterSpacing: '-0.01em' }}>\n                                {selected.title}\n                            </h2>\n                            <p className='text-[14px] leading-[1.55]' style={{ color: 'var(--v2-soft)' }}>\n                                {selected.detail}\n                            </p>\n                            {selectedWarning ? <SetupWarningResult warning={selectedWarning} live /> : null}\n                            {selected.facts.length > 0 && (\n                                <dl aria-label={C.facts} className='grid' style={{ gridTemplateColumns: 'repeat(3, minmax(0, 1fr))', gap: 10 }}>\n                                    {selected.facts.map((f) => (\n                                        <div key={f.label} className='rounded-[10px]' style={{ padding: '12px 14px', background: 'var(--v2-inset)' }}>\n                                            <dt className='text-[12px]' style={{ color: 'var(--v2-faint)' }}>\n                                                {f.label}\n                                            </dt>\n                                            <dd className='font-semibold' style={{ marginTop: 2 }}>\n                                                {f.value}\n                                            </dd>\n                                        </div>\n                                    ))}\n                                </dl>\n                            )}\n                            {snapshot.showCalls && (\n                                <div data-slot='inbox-why' className='flex gap-2 rounded-[10px] text-[13px] leading-[1.45]' style={{ padding: '12px 14px', background: 'var(--v2-acc-soft)', maxWidth: 860 }}>\n                                    <Glyph name='info' size={15} stroke={2} color='var(--v2-acc)' className='mt-px' />\n                                    <span>\n                                        <span className='font-semibold'>{C.why}: </span>\n                                        {C.whyText[selected.kind]}\n                                    </span>\n                                </div>\n                            )}\n                            {selected.hold?.kind === 'snooze' && selected.hold.returnsAt !== null && (\n                                <p data-slot='snooze-returns' className='text-[12px]' style={{ color: 'var(--v2-soft)' }}>\n                                    {SNOOZE_COPY.returns(selected.hold.returnsAt)}\n                                </p>\n                            )}\n                            <div className='flex flex-wrap' style={{ gap: 8, marginTop: 'auto' }}>\n                                {selectedWarning && context && selectedWarning.resolvedSecs === undefined ? <WarningRecheck key={`${context}:${selectedWarning.id}`} warning={selectedWarning} context={context} onAct={onAct} /> : null}\n                                {destinationFeature(selected) && selected.actionLabel && (\n                                    <button type='button' onClick={() => tenant && follow(selected, tenant.id, onNavigate)} className={`${button32} px-[18px] font-semibold`} style={{ background: 'var(--v2-acc)', color: 'var(--v2-acc-ink)' }}>\n                                        {selected.actionLabel}\n                                    </button>\n                                )}\n                                {selected.hold?.kind === 'acknowledge' ? (\n                                    <button type='button' aria-pressed='true' onClick={() => void act(selected, 'unsnoozeItem')} className={`${button32} border px-3.5`} style={{ borderColor: 'var(--v2-rule)', background: 'var(--v2-paper)', color: 'var(--v2-ink)' }}>\n                                        {C.needsAction}\n                                    </button>\n                                ) : (\n                                    <button type='button' aria-pressed='false' onClick={() => void act(selected, 'acknowledgeItem')} className={`${button32} border px-3.5`} style={{ borderColor: 'var(--v2-rule)', background: 'var(--v2-paper)', color: 'var(--v2-ink)' }}>\n                                        {C.acknowledge}\n                                    </button>\n                                )}\n                                {selected.hold?.kind === 'snooze' ? (\n                                    <button type='button' onClick={() => void act(selected, 'unsnoozeItem')} className={`${button32} border px-3.5`} style={{ borderColor: 'var(--v2-rule)', background: 'var(--v2-paper)', color: 'var(--v2-ink)' }}>\n                                        {C.unsnooze}\n                                    </button>\n                                ) : (\n                                    <button type='button' title={SNOOZE_COPY.offer} aria-label={`${SNOOZE_COPY.offer}: ${selected.title}`} onClick={() => void act(selected, 'snoozeItem')} className={`${button32} border px-3.5`} style={{ borderColor: 'var(--v2-rule)', background: 'var(--v2-paper)', color: 'var(--v2-ink)' }}>\n                                        {SNOOZE_COPY.offer}\n                                    </button>\nimport { type FormEvent, useId, useRef, useState } from 'react'\nimport { Button, Callout, Input } from '@ai-security-academy/presentation'\nimport { AlertTriangle, CheckCircle2, Info } from 'lucide-react'\nimport type { ContextRef, StorageMode, TenantView, VaultError } from '@prisma-airs/desktop-contracts'\nimport { MANAGEMENT_FAILURE_TEXT, type ObserveManagement, readManagement } from '../administration/management-read'\nimport { type Dispatch, outcomeMessage } from './dispatch'\n\nconst FAILURE_TEXT: Record<VaultError, string> = {\n    locked: 'Secure storage is locked. Unlock it and enter the secret again, or keep it for this session only.',\n    denied: 'The system did not allow access to secure storage. Enter the secret again, or keep it for this session only.',\n    unavailable: 'The credential store is not available. Enter the secret again, or keep it for this session only.',\n    notFound: 'The stored client secret is missing. Enter it again.',\n    corrupt: 'The stored client secret could not be read. Enter it again.',\n}\n\nfunction status(tenant: TenantView): { tone: 'default' | 'success' | 'danger'; text: string } {\n    const { state, mode, failure } = tenant.management\n    switch (state) {\n        case 'missing':\n            return {\n                tone: 'default',\n                text: 'No management client. Scans do not need one; add one to read this tenant’s inventories in Administration.',\n            }\n        case 'storing':\n            return { tone: 'default', text: 'Saving the management client…' }\n        case 'ready':\n            return {\n                tone: 'success',\n                text:\n                    mode === 'session'\n                        ? 'Management client secret held for this session only.'\n                        : 'Management client secret saved in secure storage.',\n            }\n        case 'failed':\n            return { tone: 'danger', text: failure ? FAILURE_TEXT[failure] : 'The management client could not be saved.' }\n    }\n}\n\ninterface Props {\n    tenant: TenantView\n    context: ContextRef\n    dispatch: Dispatch\n    observe: ObserveManagement\n}\n\n/**\n * The tenant's separate management OAuth client (C08). It never replaces or\n * reads the scan key. The secret is read from its field at submission and\n * the field is cleared before the request is awaited; it is never held in\n * React state, storage or any snapshot. Verify authenticates the stored OAuth client without reading product inventories.\n */\nexport function ManagementCredentialForm({ tenant, context, dispatch, observe }: Props) {\n    const [mode, setMode] = useState<StorageMode>('keychain')\n    const [message, setMessage] = useState<string | null>(null)\n    const [verified, setVerified] = useState<string | null>(null)\n    const [busy, setBusy] = useState(false)\n    const secretRef = useRef<HTMLInputElement>(null)\n    const clientRef = useRef<HTMLInputElement>(null)\n    const ids = useId()\n    const shown = status(tenant)\n    const view = tenant.management\n    const hasClient = view.state === 'ready' || view.state === 'failed'\n    const noTsg = tenant.tsgId === null\n\n    async function submit(event: FormEvent<HTMLFormElement>) {\n        event.preventDefault()\n        const secretField = secretRef.current\n        const clientField = clientRef.current\n        if (!secretField || !clientField) return\n        const secret = secretField.value\n        secretField.value = ''\n        const clientId = clientField.value.trim()\n        setVerified(null)\n        if (clientId.length === 0) {\n            setMessage('Enter the client ID.')\n            clientField.focus()\n            return\n        }\n        if (secret.length === 0) {\n            setMessage('Enter the client secret.')\n            secretField.focus()\n            return\n        }\n        setBusy(true)\n        setMessage(null)\n        const outcome = await dispatch({ kind: 'configureManagementCredential', context, mode, clientId, secret })\n        setBusy(false)\n        setMessage(outcomeMessage(outcome))\n    }\n\n    async function verify() {\n        setBusy(true)\n        setMessage(null)\n        setVerified(null)\n        const outcome = await readManagement(dispatch, observe, context, { kind: 'verify' })\n        setBusy(false)\n        if (outcome.kind === 'notAdmitted') setMessage(outcome.message)\n        else if (outcome.result.kind === 'verified') setVerified('Management OAuth authentication succeeded.')\n        else if (outcome.result.kind === 'failed') setMessage(MANAGEMENT_FAILURE_TEXT[outcome.result.failure])\n        else setMessage('The service returned a reply the desktop could not use.')\n    }\n\n    async function remove() {\n        setBusy(true)\n        setMessage(null)\n        setVerified(null)\n        const outcome = await dispatch({ kind: 'removeManagementCredential', context })\n        setBusy(false)\n        setMessage(outcomeMessage(outcome))\n    }\n\n    return (\n        <section aria-labelledby={`${ids}-heading`} data-slot='management-credential' className='settings-card'>\n            <h3 id={`${ids}-heading`} className='text-academy-ink text-[14px] font-semibold'>\n                Management client\n            </h3>\n            <Callout\n                tone={shown.tone}\n                icon={shown.tone === 'success' ? CheckCircle2 : shown.tone === 'danger' ? AlertTriangle : Info}\n                role='status'\n                aria-live='polite'\n                data-slot='management-status'\n            >\n                {shown.text}\n                {view.clientId ? (\n                    <span className='text-academy-ink-soft mt-1 block text-[12px]' data-slot='management-client-id'>\n                        Client ID: {view.clientId}\n                    </span>\n                ) : null}\n            </Callout>\n            {noTsg ? (\n                <Callout tone='warning' icon={AlertTriangle} data-slot='management-no-tsg'>\n                    This tenant has no TSG ID. Add a replacement tenant with its TSG ID to configure a management client.\n                </Callout>\n            ) : null}\n            <p className='text-academy-ink-faint text-[12px]' data-slot='management-sso-pointer'>\n                Company sign-in (SSO) for the Harness is set up per Gateway workspace, in Harness.\n            </p>\n            <form onSubmit={(e) => void submit(e)} className='flex flex-col gap-3' aria-busy={busy}>\n                <label htmlFor={`${ids}-client`} className='text-academy-ink text-[13px] font-medium'>\n                    Client ID\n                </label>\n                <Input\n                    ref={clientRef}\n                    id={`${ids}-client`}\n                    name='management-client-id'\n                    autoComplete='off'\n                    autoCapitalize='off'\n                    autoCorrect='off'\n                    spellCheck={false}\n                    defaultValue={view.clientId ?? ''}\n                    maxLength={1024}\n                    data-slot='management-client-input'\n                />\n                <label htmlFor={`${ids}-secret`} className='text-academy-ink text-[13px] font-medium'>\n                    Client secret\n                </label>\n                <Input\n                    ref={secretRef}\n                    id={`${ids}-secret`}\n                    name='management-secret'\n                    type='password'\n                    autoComplete='off'\n                    autoCapitalize='off'\n                    autoCorrect='off'\n                    spellCheck={false}\n                    aria-describedby={`${ids}-hint`}\n                    data-slot='management-secret-input'\n                />\n                <p id={`${ids}-hint`} className='text-academy-ink-faint text-[12px]'>\n                    The secret is sent only to {view.tokenOrigin ?? 'the Palo Alto Networks token service'} to obtain\n                    short-lived access tokens. It is separate from the scan key.\n                </p>\n                <fieldset aria-labelledby={`${ids}-mode`} className='flex flex-col gap-1'>\n                    <legend id={`${ids}-mode`} className='text-academy-ink text-[13px] font-medium'>\n                        Keep the secret\n                    </legend>\n                    {(\n                        [\n                            ['keychain', 'In secure storage', 'Available after restarting the desktop'],\n                            ['session', 'For this session only', 'Forgotten when the desktop quits'],\n                        ] as const\n                    ).map(([value, label, hint]) => (\n                        <label key={value} className='flex min-h-8 cursor-pointer items-center gap-3'>\n                            <input\n                                type='radio'\n                                name='management-mode'\n                                value={value}\n                                checked={mode === value}\n                                onChange={() => setMode(value)}\n                                className='size-4 accent-[var(--academy-accent)]'\n                            />\n                            <span className='flex flex-col'>\n                                <span className='text-academy-ink text-[13px]'>{label}</span>\n                                <span className='text-academy-ink-faint text-[12px]'>{hint}</span>\n                            </span>\n                        </label>\n                    ))}\n                </fieldset>\n                <div className='flex flex-wrap gap-2'>\n                    <Button type='submit' tier='primary' disabled={busy || noTsg}>\n                        {hasClient ? 'Replace client' : 'Save client'}\n                    </Button>\n                    {view.state === 'ready' ? (\n                        <Button type='button' tier='secondary' disabled={busy} onClick={() => void verify()}>\n                            Verify\n                        </Button>\n                    ) : null}\n                    {hasClient ? (\n                        <Button type='button' tier='secondary' disabled={busy} onClick={() => void remove()}>\n                            Remove management client\n                        </Button>\n                    ) : null}\n                </div>\n                {verified ? (\n                    <p role='status' data-slot='management-verified' className='text-academy-ink text-[13px]'>\n                        {verified}\n                    </p>\n                ) : null}\n                {message ? (\n                    <p role='alert' data-slot='management-message' className='text-academy-accent-warn text-[13px]'>\n                        {message}\n                    </p>\n                ) : null}\n            </form>\n        </section>\n    )\n}\n\"\"\"C45 fixture process ownership: exact bundle, executable and PID lifetime.\n\nNo process-name signaling, argument inspection, foreign adoption or installed-app\nlookup. macOS struct layout comes from the selected SDK sys/proc_info.h.\n\"\"\"\nfrom dataclasses import dataclass\nfrom pathlib import Path\nimport ctypes\nimport hashlib\nimport json\nimport os\nimport plistlib\nimport signal\nimport subprocess\nimport sys\nimport time\n\nFIXTURE_ID = 'io.cdot.airs-desktop.fixture'\nEXECUTABLE = 'prisma-airs-desktop'\n\n@dataclass(frozen=True)\nclass Identity:\n    pid: int\n    executable: str\n    birth: tuple\n    parent: int\n\nclass _BsdInfo(ctypes.Structure):\n    _fields_ = [('header', ctypes.c_uint32 * 12), ('comm', ctypes.c_char * 16),\n                ('name', ctypes.c_char * 32), ('misc', ctypes.c_uint32 * 5),\n                ('nice', ctypes.c_int32), ('seconds', ctypes.c_uint64), ('micros', ctypes.c_uint64)]\n\nclass MacProcesses:\n    def __init__(self):\n        if sys.platform != 'darwin':\n            raise RuntimeError('native process ownership requires macOS')\n        self.lib = ctypes.CDLL('/usr/lib/libproc.dylib', use_errno=True)\n        self.lib.proc_pidpath.argtypes = [ctypes.c_int, ctypes.c_void_p, ctypes.c_uint32]\n        self.lib.proc_pidpath.restype = ctypes.c_int\n        self.lib.proc_pidinfo.argtypes = [ctypes.c_int, ctypes.c_int, ctypes.c_uint64, ctypes.c_void_p, ctypes.c_int]\n        self.lib.proc_pidinfo.restype = ctypes.c_int\n\n    def snapshot(self, pid):\n        path = ctypes.create_string_buffer(4096)\n        info = _BsdInfo()\n        if self.lib.proc_pidpath(pid, path, len(path)) <= 0:\n            return None\n        if self.lib.proc_pidinfo(pid, 3, 0, ctypes.byref(info), ctypes.sizeof(info)) != ctypes.sizeof(info):\n            return None\n        if info.header[3] != pid:\n            return None\n        return Identity(pid, os.path.realpath(os.fsdecode(path.value)), (info.seconds, info.micros), info.header[4])\n\n    def pids(self):\n        return [int(p) for p in subprocess.check_output(['/bin/ps', '-axo', 'pid='], text=True).split()]\n\n    def send(self, pid, sig):\n        os.kill(pid, sig)\n\nclass Candidate:\n    def __init__(self, bundle, processes=None, record=None):\n        self.bundle = Path(bundle).resolve(strict=True)\n        info = plistlib.loads((self.bundle/'Contents/Info.plist').read_bytes())\n        if info.get('CFBundleIdentifier') != FIXTURE_ID or info.get('CFBundleExecutable') != EXECUTABLE:\n            raise ValueError('only the chosen C45 fixture bundle is allowed')\n        app_path=(self.bundle/'Contents/MacOS'/EXECUTABLE).resolve(strict=True)\n        engine_path=(self.bundle/'Contents/Resources/harness/airs-harness').resolve()\n        if not app_path.is_relative_to(self.bundle) or not engine_path.is_relative_to(self.bundle):\n            raise ValueError('candidate executable or engine escapes its fixture bundle')\n        self.app_path=str(app_path)\n        self.engine_path=str(engine_path)\n        self.processes = processes if processes is not None else MacProcesses()\n        self.record = Path(record) if record else None\n        self.app = None\n        self.engines_owned = {}\n        self.child = None\n\n    def matching(self, path):\n        return [s for pid in self.processes.pids() if (s := self.processes.snapshot(pid)) and s.executable == path]\n\n    def valid(self, identity):\n        if identity is None:return False\n        current=self.processes.snapshot(identity.pid)\n        return current is not None and (current.pid,current.executable,current.birth)==(identity.pid,identity.executable,identity.birth)\n\n    def publish(self):\n        if self.record:\n            def value(s):return dict(pid=s.pid, executable=s.executable, birth=s.birth, parent=s.parent)\n            data={'schema':'airs-desktop/candidate-processes/1','bundle':str(self.bundle),\n                  'app':value(self.app) if self.app else None,\n                  'engines':[value(s) for s in self.engines_owned.values()],\n                  'meaning':'Observed exact executable/PID birth identities owned by this driver; no process-name or installed-app lookup.'}\n            self.record.parent.mkdir(parents=True,exist_ok=True)\n            self.record.write_text(json.dumps(data,indent=2)+'\\n')\n\n    def app_pid(self):\n        matches = self.matching(self.app_path)\n        if len(matches)>1:\n            raise RuntimeError('multiple candidate processes; no UI or signal allowed')\n        if self.valid(self.app):return self.app.pid\n        if matches:\n            raise RuntimeError('candidate process is not owned by this driver; inspect durable ownership')\n        return None\n\n    def adopt_child(self, pid, parent):\n        identity=self.processes.snapshot(pid)\n        if not identity or identity.executable!=self.app_path or identity.parent!=parent:\n            raise RuntimeError('launched child identity does not match the bound fixture')\n        self.app=identity;self.publish();return pid\n\n    def launch(self):\n        if self.matching(self.app_path) or self.matching(self.engine_path):\n            raise RuntimeError('unowned candidate process exists; no automatic cleanup or duplicate writer')\n        self.child=subprocess.Popen([self.app_path], stdin=subprocess.DEVNULL,\n                                    stdout=subprocess.DEVNULL,stderr=subprocess.DEVNULL)\n        deadline=time.monotonic()+6\n        while time.monotonic()<deadline:\n            if self.child.poll() is not None:raise RuntimeError('fixture executable exited during launch')\n            s=self.processes.snapshot(self.child.pid)\n            if s and s.executable==self.app_path:return self.adopt_child(self.child.pid,os.getpid())\n            time.sleep(.05)\n        raise RuntimeError('fixture child identity was not observed')\n\n    def engines(self):\n        app_pid=self.app_pid()\n        for identity in self.matching(self.engine_path):\n            current=identity;seen=set()\n            while app_pid and current and current.pid not in seen:\n                if current.parent==app_pid:\n                    self.engines_owned[identity.pid]=identity;break\n                seen.add(current.pid);current=self.processes.snapshot(current.parent)\n        self.engines_owned={pid:s for pid,s in self.engines_owned.items() if self.valid(s)}\n        self.publish();return sorted(self.engines_owned)\n\n    def signal_identity(self, identity, sig):\n        if not self.valid(identity):return False\n        self.processes.send(identity.pid,sig);return True\n\n    def signal_app(self, sig=signal.SIGTERM):\n        self.engines()  # establish owned descendants before their parent exits\n        return self.signal_identity(self.app,sig)\n\n    def signal_engine(self,pid,sig=signal.SIGKILL):\n        self.engines();return self.signal_identity(self.engines_owned.get(pid),sig)\n\n    def stop_engines(self):\n        for pid in self.engines():self.signal_engine(pid)\n\n_bound = None\n\ndef bind(bundle):\n    global _bound\n    path=Path(bundle).resolve(strict=True)\n    if _bound is not None and _bound.bundle != path:\n        raise RuntimeError('one driver cannot switch fixture candidates')\n    if _bound is None:\n        prepare=os.environ.get('AIRS_NATIVE_PREPARE')\n        if prepare:\n            p=json.loads(Path(prepare).read_text());expected=(Path.cwd()/p['bundle']).resolve(strict=True)\n            if path!=expected:raise RuntimeError('bundle differs from declared native preparation')\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_40","type":"command_execution","command":"/bin/zsh -lc \"sed -n '1,110p' tools/p10/review_gate.py; rg -n 'C46|C49|P11' crates/xtask/src/subject.rs crates/xtask/src/manifest.rs docs/architecture/implementation-manifest.json; sed -n '38,82p' apps/desktop/src/v2/inbox/inbox.tsx; sed -n '1,135p' apps/desktop/src/modules/tenants/management-credential.tsx; rg -n 'unwrap|zero|consumer|omitt|fail|drift|status' tools/p11/test_remediation.py tools/p11/test_native.py | head -n 80\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_40","type":"command_execution","command":"/bin/zsh -lc \"sed -n '1,110p' tools/p10/review_gate.py; rg -n 'C46|C49|P11' crates/xtask/src/subject.rs crates/xtask/src/manifest.rs docs/architecture/implementation-manifest.json; sed -n '38,82p' apps/desktop/src/v2/inbox/inbox.tsx; sed -n '1,135p' apps/desktop/src/modules/tenants/management-credential.tsx; rg -n 'unwrap|zero|consumer|omitt|fail|drift|status' tools/p11/test_remediation.py tools/p11/test_native.py | head -n 80\"","aggregated_output":"\"\"\"Read-only actual-review proof checks for C45/P10 and production prerequisites.\n\nNo score assignment, evidence execution, controller completion or release action.\n\"\"\"\nfrom pathlib import Path\nimport json\nimport sys\n\nsys.path.insert(0, str(Path(__file__).resolve().parent))\nsys.path.insert(0, str(Path(__file__).resolve().parents[1] / \"p09\"))\nfrom phase_packet import file_identity, digest, validate\nfrom phase_inputs import full_gate, require, read, sha, REVIEW_DISABLED\n\n\ndef transport(root, out, request):\n    invocation = read(out/\"invocation.json\")\n    require(invocation[\"request_sha256\"] == sha(out/\"request.json\"), \"transport request drift\")\n    schema_path = root/request.get(\"schema_archive\", \"docs/architecture/review-verdict.schema.json\")\n    require(invocation[\"schema_sha256\"] == sha(schema_path), \"transport schema drift\")\n    args = invocation[\"command_without_prompt\"]\n    require(args[0] == \"codex\" and args.count(\"exec\") == 1, \"not fresh Codex exec\")\n    for flag in [\"--no-daemon\", \"--ephemeral\", \"--ignore-user-config\", \"--ignore-rules\", \"--json\"]:\n        require(args.count(flag) == 1, \"transport isolation \" + flag)\n    for flag, value in [(\"-a\", \"never\"), (\"-s\", \"read-only\"), (\"-m\", \"gpt-6.1-sol\")]:\n        require(args.count(flag) == 1 and args[args.index(flag)+1] == value, \"transport isolation argument \" + flag)\n    require(args.count(\"--output-schema\") == 1 and args[args.index(\"--output-schema\")+1] == \"docs/architecture/review-verdict.schema.json\", \"transport output schema\")\n    expected_out = Path(request.get(\"execution_root\", root))/\"docs/planning/reviews\"/request[\"subject\"]/request[\"attempt_id\"]/\"verdict-returned.json\"\n    require(args.count(\"-o\") == 1 and args[args.index(\"-o\")+1] == str(expected_out), \"transport output path\")\n    require(invocation[\"model_requested\"] == \"gpt-6.1-sol\", \"configured review model changed\")\n    require(not any(\"dangerously\" in arg or arg in [\"resume\", \"fork\", \"--last\", \"--approve-for-me\"] for arg in args), \"review resume/bypass\")\n    disabled = [args[i+1] for i,a in enumerate(args) if a == \"--disable\"]\n    require(set(disabled) == REVIEW_DISABLED and len(disabled) == len(REVIEW_DISABLED), \"restricted review features\")\n    overrides = [args[i+1] for i,a in enumerate(args) if a == \"-c\"]\n    require(set(overrides) == {'web_search=\"disabled\"', 'model_reasoning_effort=\"xhigh\"'} and len(overrides) == 2, \"review overrides\")\n    require(invocation[\"feature_probe_sha256\"] == sha(out/\"feature-probe.log\"), \"feature probe drift\")\n    observed = {line.split()[0]:line.split()[-1] for line in (out/\"feature-probe.log\").read_text().splitlines() if len(line.split()) >= 3}\n    require(all(observed.get(k) == invocation[\"restricted_features_observed\"].get(k) == \"false\" for k in REVIEW_DISABLED), \"feature isolation not observed\")\n    messages=[];sessions=[]\n    for line in (out/\"thread-reply.log\").read_text().splitlines():\n        try:event=json.loads(line)\n        except json.JSONDecodeError:continue\n        if not isinstance(event,dict):continue\n        item=event.get(\"item\",{})\n        if not isinstance(item,dict):item={}\n        require(event.get(\"type\") not in [\"hook.started\",\"hook.completed\"] and item.get(\"type\") not in [\"mcp_tool_call\",\"hook_execution\"], \"unexpected review side effect\")\n        if event.get(\"type\") == \"thread.started\":sessions.append(event.get(\"thread_id\"))\n        if event.get(\"type\") == \"item.completed\" and item.get(\"type\") in [\"agent_message\",\"assistant_message\"]:messages.append(item.get(\"text\",\"\"))\n    require(len(sessions) == 1 and messages and json.loads(messages[-1]) == read(out/\"verdict-returned.json\"), \"actual independent returned verdict missing/mismatched\")\n    return dict(invocation_sha256=sha(out/\"invocation.json\"),thread_reply_sha256=sha(out/\"thread-reply.log\"),feature_probe_sha256=sha(out/\"feature-probe.log\"),reviewer_sessions_observed=sessions)\n\n\ndef actual_review(root, subject, attempt, source_root=None, evidence=True):\n    out=root/\"docs/planning/reviews\"/subject/attempt\n    request=read(out/\"request.json\"); verdict=read(out/\"verdict-returned.json\")\n    schema_path=(root/request[\"schema_archive\"] if request.get(\"schema_archive\")\n                 else (source_root or root)/\"docs/architecture/review-verdict.schema.json\")\n    # Historical P09 schema is preserved independently of future descriptions.\n    if subject == \"P09\":schema_path=root/\"docs/planning/evidence/C45/activation-20261102-g11/p09-source/docs/architecture/review-verdict.schema.json\"\n    validate(verdict,read(schema_path))\n    require(verdict[\"subject\"] == subject and request[\"subject\"] == subject and verdict[\"attempt_id\"] == request[\"attempt_id\"] == attempt and verdict[\"request_id\"] == request[\"request_id\"] and verdict[\"fingerprints\"] == request[\"fingerprints\"], \"actual verdict request/fingerprint binding\")\n    full_gate(verdict)\n    # Preserve request bytes: the archive path is verification context, never an edit.\n    transport_request=dict(request)\n    # A later schema description must not change an archived review's input.\n    # Supply verification context only; request/invocation bytes stay immutable.\n    if source_root is not None:\n        transport_request[\"schema_archive\"]=str(schema_path.relative_to(root))\n    if subject == \"P09\":\n        transport_request[\"schema_archive\"]=str(schema_path.relative_to(root))\n        transport_request[\"execution_root\"]=read(root/\"docs/planning/evidence/C45/activation-20261102-g11/p09-proof.json\")[\"source_checkout\"]\n    observed=transport(root,out,transport_request)\n    audit=read(out/\"post-review-audit.json\");receipt=read(out/\"receipt.json\")\n    require(audit[\"full_gate_pass\"] is True and receipt[\"full_gate_pass\"] is True and receipt[\"source_frozen\"] is True, \"actual full-gate audit missing\")\n    for record in [audit,receipt]:\n        require(record[\"request_sha256\"] == sha(out/\"request.json\") and record.get(\"raw_verdict_sha256\",record.get(\"verdict_sha256\")) == sha(out/\"verdict-returned.json\") and record[\"scores\"] == verdict[\"scores\"], \"review audit/receipt binding\")\n    require(receipt[\"post_review_audit_sha256\"] == sha(out/\"post-review-audit.json\") and receipt[\"fingerprints\"] == verdict[\"fingerprints\"], \"receipt audit/fingerprints\")\n    require(receipt[\"invocation_sha256\"] == observed[\"invocation_sha256\"] and receipt[\"thread_reply_sha256\"] == observed[\"thread_reply_sha256\"], \"receipt transport binding\")\n    for name,key,base in [(\"source-inventory.json\",\"source\",source_root or root),(\"evidence-inventory.json\",\"evidence\",root)]:\n        inventory=read(out/name)[\"files\"]\n        require(digest(inventory) == request[\"fingerprints\"][key], \"inventory fingerprint mismatch\")\n        if evidence or key == \"source\":\n            locations = read(root/\"docs/planning/evidence/C45/activation-20261102-g11/p09-extra-evidence/locations.json\") if subject == \"P09\" and key == \"evidence\" else {}\n            for relative,identity in inventory.items():\n                path = root/locations[relative] if relative in locations else base/relative\n                require(file_identity(path) == identity, \"reviewed input drift: \" + relative)\n    return dict(subject=subject,attempt=attempt,request_sha256=sha(out/\"request.json\"),verdict_sha256=sha(out/\"verdict-returned.json\"),audit_sha256=sha(out/\"post-review-audit.json\"),receipt_sha256=sha(out/\"receipt.json\"),scores=verdict[\"scores\"],fingerprints=verdict[\"fingerprints\"])\n\n\ndef release_prerequisites(root):\n    archive=root/\"docs/planning/evidence/C45/activation-20261102-g11/p09-source\"\n    p09=actual_review(root,\"P09\",\"attempt-02\",archive)\n    standing=read(root/\"docs/planning/evidence/P10/completion-proof.json\")\n    require(standing[\"schema\"] == \"airs-desktop/p10-completion-proof/1\" and standing[\"p09\"] == p09,\"P09 prerequisite binding\")\n    # P10's exact reviewed source is archived on completion. Later C26 release\n    # implementation gets its own checks/review; it does not relabel P10 inputs.\n    archived=root/standing[\"source_archive\"]\n    require(archived.resolve().is_relative_to((root/\"docs/planning/evidence/P10\").resolve()),\"P10 archive escapes evidence\")\n    p10=actual_review(root,\"P10\",standing[\"attempt\"],archived)\n    require(standing[\"p10\"] == p10,\"P10 completion proof binding\")\n    c45=actual_review(root,\"C45\",standing[\"c45\"][\"attempt\"],root/standing[\"c45_source_archive\"])\n    require(standing[\"c45\"] == c45,\"C45 member proof binding\")\n    from packet import qualification\n    from historical import Historical\n    historical=Historical(root,standing[\"historical_context\"])\n    qualified=qualification(root,root/standing[\"qualification\"][\"record\"],current=False,historical=historical)\n    request=read(root/\"docs/planning/reviews/P10\"/standing[\"attempt\"]/\"request.json\")\n    require(qualified == standing[\"qualification\"] == request[\"qualification\"] and request[\"predecessors\"][\"C45\"] == c45,\"P10 qualified candidate/member binding\")\n    return {\"p09\":p09,\"p10\":p10,\"c45\":c45,\"controller_complete\":False,\"c26_required_here\":False}\n\n\nrg: docs/architecture/implementation-manifest.json: No such file or directory (os error 2)\ncrates/xtask/src/manifest.rs:156:            return Err(invalid(\"checks.json must define exactly C01-C49\"));\ncrates/xtask/src/manifest.rs:196:            return Err(invalid(\"phases must partition C01-C49 in order\"));\ncrates/xtask/src/manifest.rs:199:        if self.phases.get(\"P11\") != Some(&refinements) {\ncrates/xtask/src/manifest.rs:201:                \"P11 must contain exactly C46-C49; historical phases cannot absorb refinement chunks\",\ncrates/xtask/src/manifest.rs:456:    /// P11 selects and deduplicates its four members' affected checks/tests.\ncrates/xtask/src/manifest.rs:616:        // Captured from the pre-P11 controller with the same native-map bytes.\ncrates/xtask/src/manifest.rs:631:        let phase = Subject::parse(\"P11\").expect(\"registered P11\");\ncrates/xtask/src/manifest.rs:632:        let checks = manifest.plan(phase, RunKind::Check).expect(\"P11 checks\");\ncrates/xtask/src/manifest.rs:633:        let tests = manifest.plan(phase, RunKind::Test).expect(\"P11 tests\");\ncrates/xtask/src/manifest.rs:634:        assert!(checks.iter().any(|c| c.label.starts_with(\"C46/\")));\ncrates/xtask/src/manifest.rs:643:                    [\"C46/\", \"C47/\", \"C48/\", \"C49/\"]\ncrates/xtask/src/manifest.rs:668:            [\"C46\", \"C47\", \"C48\", \"C49\"]\ncrates/xtask/src/manifest.rs:705:        missing[\"chunks\"][\"C46\"]\ncrates/xtask/src/manifest.rs:717:            invalid[\"chunks\"][\"C46\"][\"check_commands\"] = argv;\ncrates/xtask/src/manifest.rs:725:        wrong_phase[\"phases\"][\"P10\"] = json!([\"C45\", \"C46\"]);\ncrates/xtask/src/manifest.rs:726:        wrong_phase[\"phases\"][\"P11\"] = json!([\"C47\", \"C48\", \"C49\"]);\ncrates/xtask/src/manifest.rs:737:            .get_mut(\"C46\")\ncrates/xtask/src/manifest.rs:738:            .expect(\"C46\")\ncrates/xtask/src/subject.rs:1://! Validated review subjects through the P11 refinement phase (D063).\ncrates/xtask/src/subject.rs:47:            \"not a valid chunk (C01-C49) or phase (P01-P11): {text:?}\"\ncrates/xtask/src/subject.rs:77:        assert_eq!(Subject::parse(\"C49\").expect(\"C49\"), Subject::Chunk(49));\ncrates/xtask/src/subject.rs:78:        assert_eq!(Subject::parse(\"P11\").expect(\"P11\"), Subject::Phase(11));\n */\nexport function follow(entry: InboxEntry, tenant: string, onNavigate: (feature: FeatureId) => void) {\n    const target = entry.target\n    if (!target) return\n    // The target belongs to the tenant it was followed in (I2): another tenant never inherits it.\n    useShellStore.getState().arrive({ tenant, feature: target.feature, resource: target.resource, item: target.item, ...(target.product ? { product: target.product } : {}) })\n    onNavigate(target.feature)\n}\n\n/** The tenant-named description of a hold action, for its outcome report. */\nexport function holdWhat(kind: 'acknowledgeItem' | 'snoozeItem' | 'unsnoozeItem', title: string): string {\n    return kind === 'acknowledgeItem' ? SHELL_COPY.acknowledgmentOf(title) : kind === 'snoozeItem' ? SHELL_COPY.snoozeOf(title) : SHELL_COPY.unsnoozeOf(title)\n}\n\n/** Which tab an entry belongs to; held entries are never \"needs action\". */\nexport function tabOf(entry: InboxEntry): InboxTab {\n    if (entry.hold?.kind === 'snooze') return 'snoozed'\n    if (entry.needsAction && !entry.hold) return 'action'\n    return 'updates'\n}\n\nconst severityTile = (severity: InboxEntry['severity']): { glyph: GlyphName; fg: string; bg: string } =>\n    severity === 'bad' ? { glyph: 'ban', fg: 'var(--v2-block)', bg: 'var(--v2-block-bg)' } : severity === 'warn' ? { glyph: 'alert', fg: 'var(--v2-flag)', bg: 'var(--v2-flag-bg)' } : { glyph: 'info', fg: 'var(--v2-soft)', bg: 'var(--v2-inset)' }\n\nconst button32 = 'flex h-8 min-h-0 items-center rounded-[7px] text-[13px] whitespace-nowrap'\n\n/**\n * The Inbox (C30, screens/inbox-reads.md): the active tenant's entries from\n * the core's Inbox scope, in tabs with counts, a detail pane with the facts,\n * the explanation and the contextual actions. Acknowledge and snooze are\n * core intents on the entry; the snooze return time is the core's and the\n * label is the one Home uses (I11). The selected tab and item are kept per\n * tenant across a switch (I2) and cleared when the tenant is deleted.\n */\nexport const Inbox = forwardRef<HTMLHeadingElement, InboxProps>(function Inbox({ snapshot, onAct, onNavigate }, _ref) {\n    const tenant = snapshot.tenants.find((t) => t.id === snapshot.active?.tenant) ?? null\n    const context = snapshot.active?.context ?? null\n    const tenantKey = tenant?.id ?? 'none'\n    const selection = useShellStore((s) => s.inboxSelection[tenantKey])\n    const selectInbox = useShellStore((s) => s.selectInbox)\n    const tab: InboxTab = selection?.tab ?? 'all'\n    const selectedId = selection?.item ?? null\n    const items = snapshot.inbox.items\n    const counts: Record<InboxTab, number> = { all: items.length, action: 0, updates: 0, snoozed: 0 }\n    for (const e of items) counts[tabOf(e)] += 1\nimport { type FormEvent, useId, useRef, useState } from 'react'\nimport { Button, Callout, Input } from '@ai-security-academy/presentation'\nimport { AlertTriangle, CheckCircle2, Info } from 'lucide-react'\nimport type { ContextRef, StorageMode, TenantView, VaultError } from '@prisma-airs/desktop-contracts'\nimport { MANAGEMENT_FAILURE_TEXT, type ObserveManagement, readManagement } from '../administration/management-read'\nimport { type Dispatch, outcomeMessage } from './dispatch'\n\nconst FAILURE_TEXT: Record<VaultError, string> = {\n    locked: 'Secure storage is locked. Unlock it and enter the secret again, or keep it for this session only.',\n    denied: 'The system did not allow access to secure storage. Enter the secret again, or keep it for this session only.',\n    unavailable: 'The credential store is not available. Enter the secret again, or keep it for this session only.',\n    notFound: 'The stored client secret is missing. Enter it again.',\n    corrupt: 'The stored client secret could not be read. Enter it again.',\n}\n\nfunction status(tenant: TenantView): { tone: 'default' | 'success' | 'danger'; text: string } {\n    const { state, mode, failure } = tenant.management\n    switch (state) {\n        case 'missing':\n            return {\n                tone: 'default',\n                text: 'No management client. Scans do not need one; add one to read this tenant’s inventories in Administration.',\n            }\n        case 'storing':\n            return { tone: 'default', text: 'Saving the management client…' }\n        case 'ready':\n            return {\n                tone: 'success',\n                text:\n                    mode === 'session'\n                        ? 'Management client secret held for this session only.'\n                        : 'Management client secret saved in secure storage.',\n            }\n        case 'failed':\n            return { tone: 'danger', text: failure ? FAILURE_TEXT[failure] : 'The management client could not be saved.' }\n    }\n}\n\ninterface Props {\n    tenant: TenantView\n    context: ContextRef\n    dispatch: Dispatch\n    observe: ObserveManagement\n}\n\n/**\n * The tenant's separate management OAuth client (C08). It never replaces or\n * reads the scan key. The secret is read from its field at submission and\n * the field is cleared before the request is awaited; it is never held in\n * React state, storage or any snapshot. Verify authenticates the stored OAuth client without reading product inventories.\n */\nexport function ManagementCredentialForm({ tenant, context, dispatch, observe }: Props) {\n    const [mode, setMode] = useState<StorageMode>('keychain')\n    const [message, setMessage] = useState<string | null>(null)\n    const [verified, setVerified] = useState<string | null>(null)\n    const [busy, setBusy] = useState(false)\n    const secretRef = useRef<HTMLInputElement>(null)\n    const clientRef = useRef<HTMLInputElement>(null)\n    const ids = useId()\n    const shown = status(tenant)\n    const view = tenant.management\n    const hasClient = view.state === 'ready' || view.state === 'failed'\n    const noTsg = tenant.tsgId === null\n\n    async function submit(event: FormEvent<HTMLFormElement>) {\n        event.preventDefault()\n        const secretField = secretRef.current\n        const clientField = clientRef.current\n        if (!secretField || !clientField) return\n        const secret = secretField.value\n        secretField.value = ''\n        const clientId = clientField.value.trim()\n        setVerified(null)\n        if (clientId.length === 0) {\n            setMessage('Enter the client ID.')\n            clientField.focus()\n            return\n        }\n        if (secret.length === 0) {\n            setMessage('Enter the client secret.')\n            secretField.focus()\n            return\n        }\n        setBusy(true)\n        setMessage(null)\n        const outcome = await dispatch({ kind: 'configureManagementCredential', context, mode, clientId, secret })\n        setBusy(false)\n        setMessage(outcomeMessage(outcome))\n    }\n\n    async function verify() {\n        setBusy(true)\n        setMessage(null)\n        setVerified(null)\n        const outcome = await readManagement(dispatch, observe, context, { kind: 'verify' })\n        setBusy(false)\n        if (outcome.kind === 'notAdmitted') setMessage(outcome.message)\n        else if (outcome.result.kind === 'verified') setVerified('Management OAuth authentication succeeded.')\n        else if (outcome.result.kind === 'failed') setMessage(MANAGEMENT_FAILURE_TEXT[outcome.result.failure])\n        else setMessage('The service returned a reply the desktop could not use.')\n    }\n\n    async function remove() {\n        setBusy(true)\n        setMessage(null)\n        setVerified(null)\n        const outcome = await dispatch({ kind: 'removeManagementCredential', context })\n        setBusy(false)\n        setMessage(outcomeMessage(outcome))\n    }\n\n    return (\n        <section aria-labelledby={`${ids}-heading`} data-slot='management-credential' className='settings-card'>\n            <h3 id={`${ids}-heading`} className='text-academy-ink text-[14px] font-semibold'>\n                Management client\n            </h3>\n            <Callout\n                tone={shown.tone}\n                icon={shown.tone === 'success' ? CheckCircle2 : shown.tone === 'danger' ? AlertTriangle : Info}\n                role='status'\n                aria-live='polite'\n                data-slot='management-status'\n            >\n                {shown.text}\n                {view.clientId ? (\n                    <span className='text-academy-ink-soft mt-1 block text-[12px]' data-slot='management-client-id'>\n                        Client ID: {view.clientId}\n                    </span>\n                ) : null}\n            </Callout>\n            {noTsg ? (\n                <Callout tone='warning' icon={AlertTriangle} data-slot='management-no-tsg'>\n                    This tenant has no TSG ID. Add a replacement tenant with its TSG ID to configure a management client.\n                </Callout>\n            ) : null}\ntools/p11/test_remediation.py:46:        for change in ('undeclared', 'unrelated', 'altered', 'omitted', 'unfrozen'):\ntools/p11/test_remediation.py:53:            elif change == 'omitted':\ntools/p11/test_remediation.py:104:        # Rewriting only tar bytes must fail the immutable reference first.\ntools/p11/test_remediation.py:152:            for change in ('omitted', 'forged-command', 'forged-log', 'unknown-prior-source'):\ntools/p11/test_remediation.py:154:                if change == 'omitted': altered['checks'].pop()\ntools/p11/test_native.py:1:\"\"\"Synthetic native-consumer fixtures, never app or pixel acceptance results.\"\"\"\ntools/p11/test_native.py:47:                helper_closure=helper, complete=not prior, status='failed' if prior else 'observed',\ntools/p11/test_native.py:48:                exit_code=1 if prior else 0, errors=[{'message': 'later unrelated helper failed'}] if prior else [],\ntools/p11/test_native.py:54:                                      {'fixture': 'metadata consumer, not an app observation'})\ntools/p11/test_native.py:104:    def test_failed_process_can_contribute_only_its_completed_assertion(self):\ntools/p11/test_native.py:109:        for change in ('false-fact', 'missing-row', 'failed-continuation', 'relabel-prior-pass'):\ntools/p11/test_native.py:113:            elif change == 'failed-continuation': self.raws[1]['exit_code'] = 1\ntools/p11/test_native.py:119:    def test_helper_and_candidate_drift_cannot_reuse_completed_assertion(self):\ntools/p11/test_native.py:134:        with self.assertRaisesRegex(ValueError, 'capture review failed'): self.verify()\ntools/p11/test_native.py:139:    def test_manifest_consumer_survives_fresh_clone_without_app_or_current_host(self):\ntools/p11/test_native.py:156:        middle.update(complete=False, status='failed', exit_code=1, errors=[{'message': 'later Contents role failed'}])\ntools/p11/test_native.py:199:    def test_positive_selector_preserves_failed_measurement_explicitly(self):\ntools/p11/test_native.py:206:        self.assertEqual(n.excluded_checks(raw)[0]['failed_facts'], ['named_actions_keyboard_reachable'])\ntools/p11/test_native.py:227:        with self.assertRaisesRegex(ValueError, 'omitted retained matrix or capture'):\ntools/p11/test_native.py:237:    def test_state_artifact_helper_and_process_drift_fail_before_ui(self):\ntools/p11/test_native.py:256:                status='failed', exit_code=1, complete=False, host='synthetic-platform',\ntools/p11/test_native.py:277:                with self.assertRaisesRegex(RuntimeError, 'failed first-unfinished'): admit()\n","exit_code":0,"status":"completed"}}
