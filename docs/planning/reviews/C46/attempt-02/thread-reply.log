I Supply Chain Security' }\n    return { ...base, tenants: base.tenants.map((t, i) => i === 0 ? { ...t, setupWarnings: [warning], management: { state: 'ready', mode: 'keychain', failure: null, clientId: 'public-client@1762204418.iam.panserviceaccount.com', tokenOrigin: 'https://auth.apps.paloaltonetworks.com' } } : t), inbox: { ...base.inbox, items: [entry] } }\n}\nbeforeEach(() => resetShellStore())\n\ndescribe('setup warning presentation', () => {\n    it('preserves the product through the Inbox action and opens that Administration section', async () => {\n        const snapshot = warned()\n        follow(snapshot.inbox.items[0]!, snapshot.active!.tenant, () => {})\n        expect(useShellStore.getState().arrival).toMatchObject({ product: 'modelSkill', feature: 'administration' })\n        const native = scriptedNative(snapshot)\n        const user = userEvent.setup()\n        render(<App client={new DesktopClient(native.transport)} />)\n        await screen.findByRole('heading', { name: 'Inbox', level: 1 })\n        await user.click(within(screen.getByRole('list', { name: 'Inbox items' })).getByRole('button', { name: /Supply chain setup warning/ }))\n        await user.click(screen.getByRole('button', { name: 'Open AI Supply Chain Security' }))\n        await native.push({ ...native.current, activeFeature: 'administration' })\n        const product = document.querySelector('[data-product=\"modelSkill\"]') as HTMLElement\n        await waitFor(() => expect(within(product).getByRole('button', { name: /AI Supply Chain Security/ })).toHaveAttribute('aria-expanded', 'true'))\n        expect(within(product).getByRole('tab', { name: 'Model scans' })).toBeInTheDocument()\n    })\n\n    it('rechecks only the selected warning and shows native pending and failed results without clearing it locally', async () => {\n        const native = scriptedNative(warned())\n        const user = userEvent.setup()\n        render(<App client={new DesktopClient(native.transport)} />)\n        await screen.findByRole('heading', { name: 'Inbox', level: 1 })\n        await user.click(within(screen.getByRole('list', { name: 'Inbox items' })).getByRole('button', { name: /Supply chain setup warning/ }))\n        await user.click(screen.getByRole('button', { name: 'Recheck setup' }))\n        expect(native.dispatched.at(-1)).toEqual({ kind: 'recheckSetupWarning', context: native.current.active!.context, warning: warning.id })\n        const update = async (state: 'pending' | 'warning') => native.push({ ...native.current, tenants: native.current.tenants.map((t, i) => i === 0 ? { ...t, setupWarnings: [{ ...warning, recheck: { checkedSecs: 1_790_000_100, state, reason: state === 'pending' ? 'Checking original scope.' : 'Model scans still need a role.', equivalent: state !== 'pending', basis: state === 'pending' ? 'unknown' as const : 'recordedScope' as const } }] } : t) })\n        await update('pending')\n        expect(screen.getByRole('button', { name: 'Recheck setup' })).toBeDisabled()\n        await user.click(screen.getByRole('button', { name: 'Recheck setup' }))\n        expect(native.dispatched.filter((i) => i.kind === 'recheckSetupWarning')).toHaveLength(1)\n        expect(screen.getByText('Checking original scope.')).toBeInTheDocument()\n        expect(screen.queryByText(/original scope could not be matched/i)).toBeNull()\n        await update('warning')\n        expect(screen.getByText('Model scans still need a role.')).toBeInTheDocument()\n        expect(screen.getByRole('button', { name: 'Recheck setup' })).not.toBeDisabled()\n        expect(within(screen.getByRole('list', { name: 'Inbox items' })).getByRole('button', { name: /Supply chain setup warning/ })).toBeInTheDocument()\n        const checked = { ...warning, recheck: { checkedSecs: 1_790_000_101, state: 'pass' as const, reason: 'Current product read passed.', equivalent: false, basis: 'unknown' as const } }\n        await native.push({ ...native.current, tenants: native.current.tenants.map((t, i) => i === 0 ? { ...t, setupWarnings: [checked] } : t) })\n        expect(screen.getByText(/original scope could not be matched/i)).toBeInTheDocument()\n        expect(within(screen.getByRole('list', { name: 'Inbox items' })).getByRole('button', { name: /Supply chain setup warning/ })).toBeInTheDocument()\n        const resolved = { ...checked, recheck: { ...checked.recheck, equivalent: true, basis: 'recordedScope' as const, reason: 'Matching sources passed.' }, resolvedSecs: 1_790_000_101 }\n        await native.push({ ...native.current, inbox: { ...native.current.inbox, items: [] }, tenants: native.current.tenants.map((t, i) => i === 0 ? { ...t, setupWarnings: [resolved] } : t) })\n        await waitFor(() => expect(screen.queryByRole('list', { name: 'Inbox items' })).toBeNull())\n        await native.push({ ...native.current, activeFeature: 'settings' })\n        const history = await screen.findByRole('region', { name: 'Setup check history' })\n        expect(within(history).getByText(warning.reason)).toBeInTheDocument()\n        expect(within(history).getByText('Matching sources passed.')).toBeInTheDocument()\n        expect(history.querySelector('[data-warning=\"vw-12\"] [data-state=\"resolved\"]')).not.toBeNull()\n    })\n\n    it('reports a refused recheck through the scoped action surface and retains the warning', async () => {\n        const base = warned()\n        const { check: _check, ...legacy } = warning\n        const native = scriptedNative({ ...base, tenants: base.tenants.map((t, i) => i === 0 ? { ...t, setupWarnings: [legacy] } : t) })\n        native.respond = () => ({ outcome: 'refusal', refusal: 'staleContext' })\n        const user = userEvent.setup()\n        render(<App client={new DesktopClient(native.transport)} />)\n        await screen.findByRole('heading', { name: 'Inbox', level: 1 })\n        await user.click(within(screen.getByRole('list', { name: 'Inbox items' })).getByRole('button', { name: /Supply chain setup warning/ }))\n        await user.click(screen.getByRole('button', { name: 'Recheck setup' }))\n        expect(await screen.findByText(/setup recheck for AI Supply Chain Security was refused \\(staleContext\\)/)).toBeInTheDocument()\n        expect(within(screen.getByRole('list', { name: 'Inbox items' })).getByRole('button', { name: /Supply chain setup warning/ })).toBeInTheDocument()\n        expect(screen.getByRole('button', { name: 'Recheck setup' })).not.toBeDisabled()\n    })\n\n    it('allows a legacy Scan Key configuration recheck without management credentials or a TSG ID', async () => {\n        const base = warned()\n        const legacy = { id: 'vw-13', product: 'runtimeSecurity' as const, reason: 'No scan key was configured.', recordedSecs: warning.recordedSecs }\n        const entry = { ...base.inbox.items[0]!, id: legacy.id, product: 'runtimeSecurity' as const, title: 'Scan key setup warning', detail: legacy.reason }\n        const native = scriptedNative({ ...base, inbox: { ...base.inbox, items: [entry] }, tenants: base.tenants.map((t, i) => i === 0 ? { ...t, tsgId: null, management: { state: 'missing', mode: null, failure: null, clientId: null, tokenOrigin: null }, setupWarnings: [legacy] } : t) })\n        const user = userEvent.setup()\n        render(<App client={new DesktopClient(native.transport)} />)\n        await screen.findByRole('heading', { name: 'Inbox', level: 1 })\n        await user.click(within(screen.getByRole('list', { name: 'Inbox items' })).getByRole('button', { name: /Scan key setup warning/ }))\n        await user.click(screen.getByRole('button', { name: 'Recheck setup' }))\n        expect(native.dispatched.at(-1)).toEqual({ kind: 'recheckSetupWarning', context: base.active!.context, warning: legacy.id })\n        const stored = { ...legacy, recheck: { checkedSecs: 1_790_000_101, state: 'stored' as const, reason: 'Scan key configured. Its validity was not tested.', equivalent: true, basis: 'legacyTenantSources' as const }, resolvedSecs: 1_790_000_101 }\n        await native.push({ ...native.current, activeFeature: 'settings', inbox: { ...native.current.inbox, items: [] }, tenants: native.current.tenants.map((t, i) => i === 0 ? { ...t, setupWarnings: [stored] } : t) })\n        const history = await screen.findByRole('region', { name: 'Setup check history' })\n        expect(history).toHaveTextContent('Latest check: Stored')\n        expect(history).toHaveTextContent('Its validity was not tested.')\n        expect(history).not.toHaveTextContent('Latest check: Passed')\n    })\n})\nimport { describe, expect, it } from 'vitest'\nimport { ContractViolation, parseShellSnapshot } from '@prisma-airs/desktop-contracts'\nimport { baseSnapshot, tenant, withTenant } from '../test/native'\n\nconst warning = { id: 'vw-12', product: 'modelSkill', reason: 'Model scans: forbidden; Skill scans: available.', recordedSecs: 1_790_000_000 }\nconst check = { version: 1, line: 'modelSkill', tsgId: '1762204418', origin: 'https://api.scm.paloaltonetworks.com', workspace: null }\nconst recheck = { checkedSecs: 1_790_000_100, state: 'warning', reason: 'Model scans still need a role.', equivalent: true, basis: 'recordedScope' }\nconst snapshot = (entry: unknown) => withTenant(baseSnapshot, { ...tenant(), setupWarnings: [entry] } as ReturnType<typeof tenant>)\n\ndescribe('setup warning metadata boundary', () => {\n    it('accepts legacy warnings and complete versioned metadata, including an honestly incomplete workspace binding', () => {\n        expect(parseShellSnapshot(snapshot(warning))).toBeTruthy()\n        expect(parseShellSnapshot(snapshot({ ...warning, check, recheck }))).toBeTruthy()\n        expect(parseShellSnapshot(snapshot({ ...warning, check: { ...check, line: 'gateway', workspace: { id: 'workspace-id', slug: '', scopeName: '' } } }))).toBeTruthy()\n        expect(parseShellSnapshot(snapshot({ ...warning, recheck: { ...recheck, state: 'pass', equivalent: false, basis: 'unknown' } }))).toBeTruthy()\n    })\n\n    it('rejects malformed check versions, lines, origins and workspace shapes', () => {\n        for (const bad of [null, {}, { ...check, version: 2 }, { ...check, line: 'futureLine' }, { ...check, tsgId: '' }, { ...check, origin: 'http://untrusted.invalid' }, { ...check, origin: 'https://example.invalid/path' }, { ...check, workspace: undefined }, { ...check, workspace: { id: '', slug: 'team', scopeName: 'team-a' } }, { ...check, workspace: { id: 'id', slug: 3, scopeName: 'team-a' } }]) {\n            expect(() => parseShellSnapshot(snapshot({ ...warning, check: bad }))).toThrow(ContractViolation)\n        }\n    })\n\n    it('rejects malformed recheck evidence instead of treating it as an authentication or scope result', () => {\n        for (const bad of [null, {}, { ...recheck, checkedSecs: -1 }, { ...recheck, checkedSecs: 1.5 }, { ...recheck, state: 'authenticated' }, { ...recheck, equivalent: 'true' }, { ...recheck, reason: {} }, { ...recheck, basis: 'assumedSameTenant' }]) {\n            expect(() => parseShellSnapshot(snapshot({ ...warning, recheck: bad }))).toThrow(ContractViolation)\n        }\n        for (const resolvedSecs of [null, -1, 1.5, Number.MAX_SAFE_INTEGER + 1, 'now']) expect(() => parseShellSnapshot(snapshot({ ...warning, resolvedSecs }))).toThrow(ContractViolation)\n    })\n})\nimport { render, screen, within } from '@testing-library/react'\nimport userEvent from '@testing-library/user-event'\nimport { beforeEach, describe, expect, it } from 'vitest'\nimport { DesktopClient } from '@prisma-airs/desktop-contracts'\nimport { App } from '../../app'\nimport { scriptedNative } from '../../test/native'\nimport { fxInbox } from '../fixtures'\nimport { resetShellStore } from '../store'\n\nbeforeEach(() => resetShellStore())\n\ndescribe('dated setup warning history', () => {\n    it('keeps the original outcome/date beside a later resolution and distinguishes unknown-scope checks', async () => {\n        const base = fxInbox()\n        const warnings = [\n            { id: 'vw-21', product: 'modelSkill' as const, reason: 'Original model source was forbidden.', recordedSecs: 1_790_000_000, recheck: { checkedSecs: 1_790_000_100, state: 'pass' as const, reason: 'Matching source reads passed.', equivalent: true, basis: 'recordedScope' as const }, resolvedSecs: 1_790_000_100 },\n            { id: 'vw-22', product: 'gateway' as const, reason: 'Original Gateway workspace IAM check failed.', recordedSecs: 1_790_000_001, recheck: { checkedSecs: 1_790_000_101, state: 'pass' as const, reason: 'Current workspace read passed.', equivalent: false, basis: 'unknown' as const } },\n        ]\n        const native = scriptedNative({ ...base, activeFeature: 'settings', tenants: base.tenants.map((t, i) => i === 0 ? { ...t, setupWarnings: warnings } : t) })\n        const user = userEvent.setup()\n        render(<App client={new DesktopClient(native.transport)} />)\n        const diagnostics = await screen.findByRole('group', { name: 'Diagnostics' })\n        const history = within(diagnostics).getByRole('region', { name: 'Setup check history' })\n        expect(within(history).getByText('Original model source was forbidden.')).toBeInTheDocument()\n        expect(within(history).getByText('Matching source reads passed.')).toBeInTheDocument()\n        expect(Array.from(history.querySelectorAll('[data-warning=\"vw-21\"] time')).map((time) => time.getAttribute('datetime'))).toEqual([new Date(1_790_000_000_000).toISOString(), new Date(1_790_000_100_000).toISOString(), new Date(1_790_000_100_000).toISOString()])\n        expect(history.querySelector('[data-warning=\"vw-21\"] [data-state=\"resolved\"]')).not.toBeNull()\n        expect(within(history).getByText('Original Gateway workspace IAM check failed.')).toBeInTheDocument()\n        expect(history.querySelector('[data-warning=\"vw-22\"] [data-state=\"active\"]')).not.toBeNull()\n        expect(within(history).getByText(/scope could not be matched/i)).toBeInTheDocument()\n        expect(native.dispatched.filter((i) => i.kind === 'exportDiagnostics' || i.kind === 'clearDiagnostics')).toHaveLength(0)\n        await user.click(within(diagnostics).getByRole('button', { name: 'Export diagnostics…' }))\n        expect(native.dispatched.at(-1)).toEqual({ kind: 'exportDiagnostics' })\n        await user.click(within(diagnostics).getByRole('button', { name: 'Clear diagnostics' }))\n        expect(native.dispatched.at(-1)).toEqual({ kind: 'clearDiagnostics' })\n        await native.push({ ...native.current, diagnostics: { ...native.current.diagnostics, events: 0, clear: 'cleared' } })\n        expect(within(history).getByText('Original model source was forbidden.')).toBeInTheDocument()\n        expect(within(history).getByText('Original Gateway workspace IAM check failed.')).toBeInTheDocument()\n    })\n})\n    async function saveClient(event: FormEvent<HTMLFormElement>) {\n        event.preventDefault()\n        const secretField = secretRef.current\n        if (!secretField || !context) return\n        const secret = secretField.value\n        secretField.value = ''\n        const clientId = String(new FormData(event.currentTarget).get('clientId') ?? '').trim()\n        if (!clientId) return setErrors((e) => ({ ...e, clientId: C.tenant.errors.clientId }))\n        if (!secret) return setErrors((e) => ({ ...e, clientSecret: C.tenant.errors.clientSecret }))\n        setErrors((e) => ({ ...e, clientId: '', clientSecret: '' }))\n        setBusy(true)\n        report(await dispatch({ kind: 'configureManagementCredential', context, mode: 'keychain', clientId, secret }), C.tenant.clientSaved)\n        setBusy(false)\n    }\n\n    async function remove(kind: 'removeScanCredential' | 'removeManagementCredential', ok: string) {\n        if (!context) return\n        setBusy(true)\n        report(await dispatch({ kind, context }), ok)\n        setBusy(false)\n    }\n\n    // ---- Gateway workspace (optional): list through the management client, choose, key ----\n    const [gatewayOn, setGatewayOn] = useState(false)\n    const [workspaces, setWorkspaces] = useState<{ id: string; name: string }[] | null>(null)\n    const [workspacesNote, setWorkspacesNote] = useState<string | null>(null)\n    const [workspace, setWorkspace] = useState<string>('')\n    // The chosen workspace is core state on the draft (its reference is what the key is configured under).\n    const chosen = setup?.workspace ?? null\n    const [endpoint, setEndpoint] = useState('')\n\n    async function listWorkspaces() {\n        if (!context) return\n        setWorkspacesNote(C.tenant.readingWorkspaces)\n        setWorkspaces(null)\n        const outcome = await readManagement(dispatch, props.observeManagement, context, { kind: 'gateway', workspace: null, read: { kind: 'inventory', resource: 'workspaces' } })\n        if (outcome.kind !== 'result') return setWorkspacesNote(outcome.kind === 'notAdmitted' ? outcome.message : C.outcome.failed)\n        const result = outcome.result\n        if (result.kind !== 'gateway' || result.gateway.kind !== 'list') return setWorkspacesNote(result.kind === 'failed' ? C.outcome.failed : C.tenant.noWorkspaces)\n        const rows = (JSON.parse(result.gateway.list.rows) as Record<string, unknown>[])\n            .filter((r) => typeof r.id === 'string')\n            .map((r) => ({ id: String(r.id), name: typeof r.name === 'string' && r.name ? r.name : String(r.id) }))\n        setWorkspaces(rows)\n        setWorkspace(rows[0]?.id ?? '')\n        setWorkspacesNote(rows.length ? null : C.tenant.noWorkspaces)\n    }\n\n    async function chooseWorkspace() {\n        if (!context || !workspace) return\n        setBusy(true)\n        const outcome = await dispatch({ kind: 'selectGatewayWorkspace', context, workspace })\n        setBusy(false)\n        report(outcome, C.tenant.workspaceChosen(workspaces?.find((w) => w.id === workspace)?.name ?? workspace))\n    }\n\n    async function saveWorkspaceKey(event: FormEvent<HTMLFormElement>) {\n        event.preventDefault()\n        const field = workspaceKeyRef.current\n        if (!field || !context || !chosen) return\n        const secret = field.value\n        field.value = ''\n        if (!/^https:\\/\\/\\S+$/.test(endpoint.trim())) return setErrors((e) => ({ ...e, endpoint: C.tenant.errors.endpoint }))\n        if (!secret) return setErrors((e) => ({ ...e, workspaceKey: C.tenant.errors.workspaceKey }))\n        setErrors((e) => ({ ...e, endpoint: '', workspaceKey: '' }))\n        setBusy(true)\n        report(await dispatch({ kind: 'configureInferenceCredential', context, mode: 'keychain', workspace: chosen.reference, endpoint: endpoint.trim(), secret }), C.tenant.workspaceKeySaved)\n        setBusy(false)\n    }\n\n    // The Done summary's checks line, from the verification states themselves: \"All passed\" only when every line\n    // passed; otherwise each state is counted (a stored or skipped credential, an unavailable product, a warning or a\n    // failure is never described as passed). No run yet: none.\n    const checksSummary = (r: typeof run): [string, 'ok' | 'warn' | 'skip'] => {\n        if (!r || !r.done) return [C.done.summary.none, 'skip']\n        const counts = new Map<VerifyState, number>()\n        for (const st of r.steps) counts.set(st.state, (counts.get(st.state) ?? 0) + 1)\n        if (r.steps.length > 0 && counts.get('pass') === r.steps.length) return [C.done.summary.checksPassed, 'ok']\n        const order: VerifyState[] = ['pass', 'warning', 'fail', 'stored', 'skipped', 'unavailable', 'pending']\n        const text = order.filter((k) => (counts.get(k) ?? 0) > 0).map((k) => C.done.summary.checkCounts[k](counts.get(k) ?? 0)).join(' · ')\n        return [text || C.done.summary.none, (counts.get('fail') ?? 0) + (counts.get('warning') ?? 0) > 0 ? 'warn' : 'skip']\n    }\n    const scanReady = setup?.tenant.scan.state === 'ready'\n    const clientReady = setup?.tenant.management.state === 'ready'\n    const tenantContinue = !setup ? { label: C.tenant.continueNeedsDraft, disabled: true } : profileDirty ? { label: C.tenant.continueDirty, disabled: true } : setup.managementRequired && !clientReady ? { label: C.tenant.continueNeedsClient, disabled: true } : { label: C.tenant.continue, disabled: false }\n\n    // ---- products: the choice is recorded in the core as it changes ----\n    async function toggleProduct(id: ProductId, on: boolean) {\n        if (!setup) return\n        const next = on ? [...setup.products, id] : setup.products.filter((p) => p !== id)\n        report(await dispatch({ kind: 'chooseSetupProducts', context: setup.context, products: next }), null)\n    }\n\n    // ---- verify: one core-owned run; lines stream through the snapshot ----\n    async function verify() {\n        if (!context) return\n        setBusy(true)\n        report(await dispatch({ kind: 'verifyTenantSetup', context }), null, () => void verify())\n        setBusy(false)\n    }\n    const run = setup?.verify ?? null\n    const running = Boolean(run && !run.done)\n    const plannedRows: VerifyStep[] = run\n        ? run.steps\n        : [\n              { line: 'scanKey', product: 'runtimeSecurity', state: 'pending', reason: '' },\n              { line: 'managementClient', product: 'runtimeSecurity', state: 'pending', reason: '' },\n              ...(setup?.products ?? []).filter((p) => p !== 'runtimeSecurity').map((p): VerifyStep => ({ line: p === 'gateway' ? 'gateway' : p === 'redTeam' ? 'redTeam' : 'modelSkill', product: p, state: 'pending', reason: '' })),\n              ...UNAVAILABLE_LINES,\n          ]\n    const verifyStatus = !run ? '' : running ? C.verify.running : run.stale ? C.verify.stale : run.blocking ? C.verify.failed : run.failed ? C.verify.failedOptional : run.warnings.length ? C.verify.finishedWarnings : C.verify.finishedClean\n\n    // ---- packs: the chosen packs are imported by the completion intent ----\n    // Only packs of currently chosen products with cases count; a product removed\n    // after its pack was ticked takes the pack with it (R8).\n    const offered = setup?.packs.filter((p) => p.count > 0 && setup.products.includes(p.product)).map((p) => p.product) ?? []\n    const selectedPacks: ProductId[] = (packs ?? offered).filter((p) => offered.includes(p))\n\n    // ---- done: completion is one core intent; the shell confirms it ----\n    // Completion makes the new tenant active: it is the one guarded switch\n    // path (I1). A pending Harness decision refuses it; the core's guard is\n    // rendered here and the completion re-sent with the chosen resolution.\n    async function finish(resolution: SwitchResolution | null = null) {\n        if (!setup) return\n        setFinishing(true)\n        const outcome = await dispatch({ kind: 'completeTenantSetup', context: setup.context, packs: selectedPacks, resolution })\n        if (outcome.kind === 'admitted') {\n            // First run: the shell takes over once the snapshot shows onboarding\n            // done (the same intent set it). Add: the sheet closes with the label.\n            if (mode === 'add') props.onClose(setup.tenant.label)\n            return\n        }\n        setFinishing(false)\n        // The guard is the snapshot's to show (switchBlocked), not a status line.\n        if (outcome.kind === 'refused' && outcome.refusal === 'decisionPending') return\n        report(outcome, null, () => void finish())\n    }\n    const completionGuard = snapshot.switchBlocked?.completion && setup && snapshot.switchBlocked.to === setup.tenant.id ? snapshot.switchBlocked : null\n\n    // ---- cancel (add mode): the draft is discarded in the core before the sheet closes ----\n    // idle → awaitingCreate (a creation is pending or unconfirmed: wait for what it\n    // produces) → discarding (sent; closes on admission, or when the draft is seen\n    // gone after an unconfirmed delivery) → retry (refused or failed, with Retry).\n    type CancelState = 'idle' | 'awaitingCreate' | 'discarding' | 'retry'\n    const [cancelState, setCancelState] = useState<CancelState>('idle')\n    const latestSetup = useRef(setup)\n    latestSetup.current = setup\n    const cancelling = cancelState === 'awaitingCreate' || cancelState === 'discarding'\n    async function discardNow(context: ContextRef) {\n        setCancelState('discarding')\n        const outcome = await dispatch({ kind: 'discardTenantSetup', context })\n        if (outcome.kind === 'admitted') return props.onClose()\n        // Unconfirmed: the draft may be gone (the next snapshot closes the sheet) or\n        // still here; the operator can send the discard again for the current draft.\n        if (outcome.kind === 'unknown') return setStatus({ text: C.outcome.unknown, retry: () => void retryDiscard() })\n        setCancelState('retry')\n        setStatus({ text: `${C.cancelFailed} ${outcome.kind === 'refused' ? (outcomeMessage(outcome) ?? '') : C.outcome.failed}`.trim(), retry: () => void retryDiscard() })\n    }\n    async function retryDiscard() {\n        const current = latestSetup.current\n        if (!current) return props.onClose()\n        await discardNow(current.context)\n    }\n    async function cancel() {\n        // A close request while a discard is unconfirmed is the operator's retry.\n        if (cancelState === 'discarding') return retryDiscard()\n        if (cancelling) return\n        if (createInFlight.current || createUnknown !== null || createAdmitted) {\n            setCancelState('awaitingCreate')\n            if (createInFlight.current) {\n                const outcome = await createInFlight.current\n                // Nothing was created: close. Admitted or unconfirmed: the next snapshot decides.\n                if (outcome.kind === 'refused' || outcome.kind === 'failed') return props.onClose()\n            }\n            return\n        }\n        const current = latestSetup.current\n        if (!current) return props.onClose()\n        await discardNow(current.context)\n    }\n    useEffect(() => {\n        if (cancelState !== 'awaitingCreate' || createPending) return\n        if (setup) void discardNow(setup.context)\n        // An admitted creation's draft is still on its way: keep waiting for it.\n        else if (createAdmitted) return\n        else if (createUnknown === null) props.onClose()\n        // eslint-disable-next-line react-hooks/exhaustive-deps -- decided per settlement and snapshot\n    }, [cancelState, setup, createUnknown, createAdmitted, createPending, snapshot.revision])\n    const seenCloseRequests = useRef(props.closeRequests ?? 0)\n    useEffect(() => {\n        if ((props.closeRequests ?? 0) > seenCloseRequests.current) {\n            seenCloseRequests.current = props.closeRequests ?? 0\n            void cancel()\n        }\n        // eslint-disable-next-line react-hooks/exhaustive-deps -- a request is handled once\n    }, [props.closeRequests])\n    useEffect(() => {\n        // An unconfirmed discard that did go through shows up as the draft being gone.\n        if (cancelState === 'discarding' && !setup) props.onClose()\n    }, [cancelState, setup, props])\n    useEffect(() => {\n        // The draft's context changed (a credential or profile change): the core\n        // cleared its listing and choice, so the local chooser goes with them.\n        setWorkspaces(null)\n        setWorkspacesNote(null)\n        setWorkspace('')\n    }, [context])\n\n    const railCtx = setup ? `${setup.tenant.label} · ${ENVIRONMENT_LABELS[setup.tenant.environment]}${setup.tenant.tsgId ? ` · TSG ${setup.tenant.tsgId}` : ''}` : ''\n    const productLabel = (id: ProductId) => PRODUCT_CARDS.find((c) => c.id === id)?.label ?? id\n    const isAdd = mode === 'add'\n    const dark = snapshot.appearance === 'dark' || (snapshot.appearance === 'system' && typeof window !== 'undefined' && window.matchMedia?.('(prefers-color-scheme: dark)').matches)\n    const skip = (s: WizardStep) => {\n        setSkipped((x) => new Set([...x, s]))\n        go(index + 1)\n","exit_code":0,"status":"completed"}}
