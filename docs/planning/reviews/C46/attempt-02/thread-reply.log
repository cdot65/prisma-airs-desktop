{"type":"item.completed","item":{"id":"item_45","type":"command_execution","command":"/bin/zsh -lc \"sed -n '180,350p' crates/desktop-core/tests/ui_v2_onboarding/main.rs; sed -n '650,708p' crates/desktop-core/tests/ui_v2_setup_reads/main.rs; sed -n '784,972p' crates/desktop-core/tests/ui_v2_setup_reads/main.rs\"","aggregated_output":"}\n\n#[tokio::test]\nasync fn a_draft_is_not_a_tenant_and_first_run_requires_oauth_not_a_scan_key() {\n    let mut desk = Desk::new().await;\n\n    let context = desk.begin(\"firstRun\", \"Northwind Health\").await;\n    let snap = desk.snap();\n    assert!(snap.tenants.is_empty(), \"the draft is not listed\");\n    assert!(snap.active.is_none());\n    assert_eq!(snap.onboarding, OnboardingState::Needed);\n    let setup = snap.setup.expect(\"setup\");\n    assert_eq!(setup.tenant.label, \"Northwind Health\");\n    assert_eq!(\n        setup.tenant.environment,\n        desktop_core::features::TenantEnvironment::Staging\n    );\n    assert!(!setup.scan_required);\n    assert!(setup.management_required);\n    assert_eq!(setup.products, vec![ProductId::RuntimeSecurity]);\n    assert!(setup.verify.is_none() && !setup.completable);\n    // A second draft is refused while one is open.\n    assert_eq!(\n        desk.send(json!({\"kind\": \"beginTenantSetup\", \"mode\": \"add\", \"profile\": {\n            \"label\": \"Other\", \"tsgId\": null, \"destination\": {\"kind\": \"region\", \"region\": \"europe\"}}}))\n            .await,\n        Err(Refusal::Busy)\n    );\n    // A missing Scan Key is optional; missing OAuth blocks completion in either mode.\n    desk.send(json!({\"kind\": \"verifyTenantSetup\", \"context\": context}))\n        .await\n        .expect(\"verify started\");\n    let v = desk.verified().await;\n    let scan = v\n        .steps\n        .iter()\n        .find(|s| s.line == VerifyLine::ScanKey)\n        .expect(\"scan line\");\n    assert_eq!(scan.state, VerifyState::Warning);\n    assert!(v.failed && !desk.setup().completable);\n    assert_eq!(\n        desk.send(json!({\"kind\": \"completeTenantSetup\", \"context\": context, \"packs\": []}))\n            .await,\n        Err(Refusal::InvalidInput)\n    );\n}\n\n#[tokio::test]\nasync fn credentials_attach_to_the_draft_and_a_stored_key_is_never_a_pass() {\n    let mut desk = Desk::new().await;\n    let context = desk.begin(\"firstRun\", \"Northwind Health\").await;\n    desk.send(json!({\"kind\": \"configureScanCredential\", \"context\": context, \"mode\": \"session\", \"key\": KEY}))\n        .await\n        .expect(\"key accepted for the draft\");\n    desk.settled(true).await;\n    let context = desk.context();\n    assert!(desk.snap().tenants.is_empty(), \"still no tenant\");\n    desk.send(json!({\"kind\": \"verifyTenantSetup\", \"context\": context}))\n        .await\n        .expect(\"verify\");\n    let v = desk.verified().await;\n    let by_line = |line: VerifyLine| v.steps.iter().find(|s| s.line == line).cloned();\n    let scan = by_line(VerifyLine::ScanKey).expect(\"scan\");\n    assert_eq!(\n        scan.state,\n        VerifyState::Stored,\n        \"explicitly unverified, not Pass\"\n    );\n    assert!(scan.reason.contains(\"first scan proves it\"));\n    let management = by_line(VerifyLine::ManagementClient).expect(\"management\");\n    assert_eq!(management.state, VerifyState::Fail);\n    assert!(\n        by_line(VerifyLine::Gateway).is_none(),\n        \"unselected products have no line\"\n    );\n    assert!(v.done && v.failed && v.blocking && !v.stale && v.warnings.is_empty());\n    assert!(\n        !desk.setup().completable,\n        \"a stored Scan Key is not OAuth authentication\"\n    );\n}\n\n#[tokio::test]\nasync fn changing_inputs_makes_authentication_stale_and_product_permissions_warn() {\n    let mut desk = Desk::new().await;\n    let context = desk.begin(\"firstRun\", \"Northwind Health\").await;\n    desk.send(json!({\"kind\": \"configureScanCredential\", \"context\": context, \"mode\": \"session\", \"key\": KEY}))\n        .await\n        .expect(\"key\");\n    desk.settled(true).await;\n    let context = desk.management(\"session\").await;\n    desk.send(json!({\"kind\": \"verifyTenantSetup\", \"context\": context}))\n        .await\n        .expect(\"verify\");\n    let first = desk.verified().await;\n    assert_eq!(first.generation, 1);\n    // Choosing Gateway afterwards invalidates the run; completion is refused.\n    desk.send(json!({\"kind\": \"chooseSetupProducts\", \"context\": context, \"products\": [\"gateway\", \"gateway\", \"redTeam\"]}))\n        .await\n        .expect(\"products\");\n    let setup = desk.setup();\n    assert_eq!(\n        setup.products,\n        vec![\n            ProductId::RuntimeSecurity,\n            ProductId::Gateway,\n            ProductId::RedTeam\n        ]\n    );\n    assert!(setup.verify.expect(\"kept\").stale && !setup.completable);\n    assert_eq!(\n        desk.send(json!({\"kind\": \"completeTenantSetup\", \"context\": context, \"packs\": []}))\n            .await,\n        Err(Refusal::InvalidInput)\n    );\n    desk.send(json!({\"kind\": \"verifyTenantSetup\", \"context\": context}))\n        .await\n        .expect(\"verify again\");\n    let second = desk.verified().await;\n    assert_eq!(second.generation, 2);\n    assert!(!second.stale);\n    let lines: Vec<(VerifyLine, VerifyState)> =\n        second.steps.iter().map(|s| (s.line, s.state)).collect();\n    assert_eq!(\n        lines,\n        vec![\n            (VerifyLine::ScanKey, VerifyState::Stored),\n            (VerifyLine::ManagementClient, VerifyState::Pass),\n            (VerifyLine::Gateway, VerifyState::Fail),\n            (VerifyLine::RedTeam, VerifyState::Fail),\n            (VerifyLine::Ais, VerifyState::Unavailable),\n            (VerifyLine::Aes, VerifyState::Unavailable),\n        ]\n    );\n    assert_eq!(second.warnings.len(), 2);\n    assert_eq!(second.warnings[0].product, ProductId::Gateway);\n    assert!(desk.setup().completable, \"warnings do not block completion\");\n    // A profile change (new destination) retires the key and goes stale.\n    desk.send(\n        json!({\"kind\": \"updateTenantSetup\", \"context\": context, \"profile\": {\n        \"label\": \"Northwind Health\", \"tsgId\": \"1234567890\",\n        \"destination\": {\"kind\": \"region\", \"region\": \"unitedStates\"}, \"environment\": \"production\"}}),\n    )\n    .await\n    .expect(\"updated\");\n    let setup = desk.setup();\n    assert_eq!(setup.tenant.scan.state, desktop_core::ScanState::Missing);\n    assert_eq!(\n        setup.tenant.environment,\n        desktop_core::features::TenantEnvironment::Production\n    );\n    assert!(\n        setup.verify.is_none() && !setup.completable,\n        \"the run went with the old context\"\n    );\n    assert_ne!(\n        setup.context.as_str(),\n        context,\n        \"a profile change retires the draft's context\"\n    );\n    assert_eq!(\n        desk.send(json!({\"kind\": \"verifyTenantSetup\", \"context\": context}))\n            .await,\n        Err(Refusal::StaleContext)\n    );\n}\n\n#[tokio::test]\nasync fn completion_commits_the_draft_once_with_products_warnings_and_onboarding() {\n    let mut desk = Desk::new().await;\n\n    );\n}\n\n#[tokio::test]\nasync fn oauth_failure_blocks_commit_without_mutating_the_active_tenant() {\n    let mut desk = desk().await;\n    desk.tenant_a().await;\n    let before = desk.snap();\n    let origin = desk.origin.clone();\n    desk.send(json!({\"kind\": \"beginTenantSetup\", \"mode\": \"add\", \"profile\": {\"label\": \"Tenant B\", \"tsgId\": TSG,\n        \"destination\": {\"kind\": \"custom\", \"origin\": origin}}}))\n        .await\n        .expect(\"draft\");\n    let context = desk.draft_context();\n    desk.send(\n        json!({\"kind\": \"configureManagementCredential\", \"context\": context, \"mode\": \"keychain\",\n        \"clientId\": CLIENT_ID, \"secret\": CLIENT_SECRET}),\n    )\n    .await\n    .expect(\"draft client\");\n    let context = desk.draft_context();\n    assert!(eventually(|| desk.setup().tenant.management.state == ScanState::Ready).await);\n    desk.send(json!({\"kind\": \"chooseSetupProducts\", \"context\": context, \"products\": [\"redTeam\"]}))\n        .await\n        .expect(\"products\");\n    let vault_before = desk.adapters.vault.records();\n    // The management plane refuses this client: the verify read fails.\n    desk.script.lock().expect(\"script\").token_status = 401;\n    desk.send(json!({\"kind\": \"verifyTenantSetup\", \"context\": context}))\n        .await\n        .expect(\"verify\");\n    let v = tokio::time::timeout(Duration::from_secs(60), desk.verified())\n        .await\n        .expect(\"settled\");\n    let management = v\n        .steps\n        .iter()\n        .find(|s| s.line == VerifyLine::ManagementClient)\n        .expect(\"line\");\n    assert_eq!(management.state, VerifyState::Fail, \"{}\", management.reason);\n    assert!(v.failed && v.blocking && !desk.setup().completable);\n    assert_eq!(\n        desk.send(json!({\"kind\": \"completeTenantSetup\", \"context\": context, \"packs\": []}))\n            .await,\n        Err(Refusal::InvalidInput)\n    );\n    let after = desk.snap();\n    assert_eq!(after.tenants, before.tenants);\n    assert_eq!(after.active, before.active);\n    assert!(after.setup.is_some(), \"failed authentication stays a draft\");\n    assert_eq!(\n        desk.adapters.vault.records(),\n        vault_before,\n        \"verification does not mutate either credential generation\"\n    );\n}\n\nasync fn product_source_failure_remains_a_warning(status: u16) {\n    let mut desk = desk().await;\nasync fn discarding_a_draft_cancels_its_reads_in_flight_and_leaves_the_active_tenant_alone() {\n    let mut desk = desk().await;\n    desk.tenant_a().await;\n    let a_before = desk.snap().gateway;\n    let origin = desk.origin.clone();\n    desk.send(json!({\"kind\": \"beginTenantSetup\", \"mode\": \"add\", \"profile\": {\"label\": \"Tenant B\", \"tsgId\": TSG,\n        \"destination\": {\"kind\": \"custom\", \"origin\": origin}}}))\n        .await\n        .expect(\"draft\");\n    let context = desk.draft_context();\n    desk.send(\n        json!({\"kind\": \"configureManagementCredential\", \"context\": context, \"mode\": \"keychain\",\n        \"clientId\": CLIENT_ID, \"secret\": CLIENT_SECRET}),\n    )\n    .await\n    .expect(\"draft client\");\n    let context = desk.draft_context();\n    assert!(eventually(|| desk.setup().tenant.management.state == ScanState::Ready).await);\n    // The draft's fresh binding must fetch a token first; that request hangs.\n    desk.script\n        .lock()\n        .expect(\"script\")\n        .hang\n        .insert(\"/oauth2/access_token\".to_owned());\n    let Receipt::Admitted {\n        operation: Some(operation),\n        ..\n    } = desk\n        .send(json!({\"kind\": \"management\", \"context\": context,\n            \"request\": {\"kind\": \"gateway\", \"workspace\": null, \"read\": {\"kind\": \"inventory\", \"resource\": \"workspaces\"}}}))\n        .await\n        .expect(\"admitted\")\n    else {\n        panic!(\"no operation\");\n    };\n    desk.send(json!({\"kind\": \"verifyTenantSetup\", \"context\": context}))\n        .await\n        .expect(\"verify started\");\n    tokio::time::sleep(Duration::from_millis(200)).await;\n    desk.send(json!({\"kind\": \"discardTenantSetup\", \"context\": context}))\n        .await\n        .expect(\"discarded while reads were in flight\");\n    // The read queued under the draft settles cancelled, not with a result.\n    let Ok(Observation::Management(handle)) = desk.handle.observe(ViewScope::Management(operation))\n    else {\n        panic!(\"management observation\");\n    };\n    let result = tokio::time::timeout(Duration::from_secs(20), handle.result())\n        .await\n        .expect(\"settled in time\");\n    assert!(\n        matches!(\n            result,\n            ManagementResult::Failed {\n                failure: desktop_core::management::ManagementFailure::Cancelled,\n                ..\n            }\n        ),\n        \"{result:?}\"\n    );\n    desk.script.lock().expect(\"script\").hang.clear();\n    let snap = desk.snap();\n    assert!(snap.setup.is_none());\n    assert_eq!(\n        snap.gateway.selected, a_before.selected,\n        \"A's choice untouched\"\n    );\n    // A's own reads still work under its context and workspace reference.\n    let a_context = desk.active_context();\n    let a_reference = a_before.selected.expect(\"A\").reference;\n    let prerequisites = desk\n        .read(\n            &a_context,\n            json!({\"kind\": \"gateway\", \"workspace\": a_reference, \"read\": {\"kind\": \"prerequisites\"}}),\n        )\n        .await;\n    assert!(\n        matches!(prerequisites, ManagementResult::Gateway { .. }),\n        \"{prerequisites:?}\"\n    );\n}\n\n#[tokio::test]\nasync fn a_replaced_client_authenticates_afresh_and_profile_changes_retire_the_binding() {\n    let mut desk = desk().await;\n    desk.tenant_a().await;\n    let origin = desk.origin.clone();\n    desk.send(json!({\"kind\": \"beginTenantSetup\", \"mode\": \"add\", \"profile\": {\"label\": \"Tenant B\", \"tsgId\": TSG,\n        \"destination\": {\"kind\": \"custom\", \"origin\": origin}}}))\n        .await\n        .expect(\"draft\");\n    let context = desk.draft_context();\n    desk.send(\n        json!({\"kind\": \"configureManagementCredential\", \"context\": context, \"mode\": \"keychain\",\n        \"clientId\": CLIENT_ID, \"secret\": CLIENT_SECRET}),\n    )\n    .await\n    .expect(\"good client\");\n    let context = desk.draft_context();\n    assert!(eventually(|| desk.setup().tenant.management.state == ScanState::Ready).await);\n    desk.send(json!({\"kind\": \"verifyTenantSetup\", \"context\": context}))\n        .await\n        .expect(\"verify\");\n    let v = desk.verified().await;\n    assert_eq!(v.steps[1].state, VerifyState::Pass, \"{}\", v.steps[1].reason);\n    // Replace the secret with one the plane rejects: the cached binding must not pass for it.\n    desk.send(\n        json!({\"kind\": \"configureManagementCredential\", \"context\": context, \"mode\": \"keychain\",\n        \"clientId\": CLIENT_ID, \"secret\": \"wrong-synthetic-secret\"}),\n    )\n    .await\n    .expect(\"replaced client\");\n    let wrong_context = desk.draft_context();\n    assert_ne!(wrong_context, context);\n    assert!(eventually(|| desk.setup().tenant.management.state == ScanState::Ready).await);\n    desk.send(json!({\"kind\": \"verifyTenantSetup\", \"context\": wrong_context}))\n        .await\n        .expect(\"verify\");\n    let v = desk.verified().await;\n    assert_eq!(v.steps[1].state, VerifyState::Fail, \"{}\", v.steps[1].reason);\n    assert!(\n        v.steps[1].reason.contains(\"not accepted\"),\n        \"{}\",\n        v.steps[1].reason\n    );\n    assert!(\n        v.blocking && !desk.setup().completable,\n        \"a replacement secret must authenticate before completion\"\n    );\n    assert_eq!(\n        desk.send(json!({\"kind\": \"completeTenantSetup\", \"context\": wrong_context, \"packs\": []}))\n            .await,\n        Err(Refusal::InvalidInput)\n    );\n    // Remove the client, add the right one back: it authenticates afresh.\n    desk.send(json!({\"kind\": \"removeManagementCredential\", \"context\": wrong_context}))\n        .await\n        .expect(\"removed\");\n    let removed_context = desk.draft_context();\n    assert_ne!(removed_context, wrong_context);\n    assert_eq!(desk.setup().tenant.management.state, ScanState::Missing);\n    desk.send(json!({\"kind\": \"configureManagementCredential\", \"context\": removed_context, \"mode\": \"keychain\",\n        \"clientId\": CLIENT_ID, \"secret\": CLIENT_SECRET}))\n        .await\n        .expect(\"re-added\");\n    let context = desk.draft_context();\n    assert!(eventually(|| desk.setup().tenant.management.state == ScanState::Ready).await);\n    desk.send(json!({\"kind\": \"verifyTenantSetup\", \"context\": context}))\n        .await\n        .expect(\"verify\");\n    let v = desk.verified().await;\n    assert_eq!(v.steps[1].state, VerifyState::Pass, \"{}\", v.steps[1].reason);\n    // A TSG change retires the management credential (it was bound to the TSG) and the context.\n    desk.send(json!({\"kind\": \"verifyTenantSetup\", \"context\": context}))\n        .await\n        .expect(\"verify restored generation\");\n    let restored = desk.verified().await;\n    assert_eq!(\n        restored\n            .steps\n            .iter()\n            .find(|s| s.line == VerifyLine::ManagementClient)\n            .expect(\"OAuth\")\n            .state,\n        VerifyState::Pass\n    );\n    let origin = desk.origin.clone();\n    desk.send(json!({\"kind\": \"updateTenantSetup\", \"context\": context, \"profile\": {\"label\": \"Tenant B\", \"tsgId\": \"9876543210\",\n        \"destination\": {\"kind\": \"custom\", \"origin\": origin}}}))\n        .await\n        .expect(\"tsg changed\");\n    let setup = desk.setup();\n    assert_ne!(setup.context.as_str(), context);\n    assert_eq!(setup.tenant.tsg_id.as_deref(), Some(\"9876543210\"));\n    assert_eq!(\n        setup.tenant.management.state,\n        ScanState::Missing,\n        \"the client went with the old TSG\"\n    );\n    assert!(setup.verify.is_none());\n    assert_eq!(\n        desk.send(json!({\"kind\": \"verifyTenantSetup\", \"context\": context}))\n            .await,\n        Err(Refusal::StaleContext)\n    );\n}\n\n// Owner refinement: management authentication gates every new tenant; a\n// product permission is a separate observation and scan keys remain optional.\n","exit_code":0,"status":"completed"}}
