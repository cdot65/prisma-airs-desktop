{"type":"item.completed","item":{"id":"item_23","type":"command_execution","command":"/bin/zsh -lc \"sed -n '1,165p' apps/desktop/src/v2/inbox/inbox.tsx; cat apps/desktop/src/v2/setup-warning-history.tsx; sed -n '3950,4095p' crates/desktop-core/src/authority.rs; sed -n '5650,5868p' crates/desktop-core/src/authority.rs\"","aggregated_output":"import { forwardRef, useEffect, useRef, useState } from 'react'\nimport type { FeatureId, InboxEntry, Intent, ProductId, SetupWarning, ShellSnapshot } from '@prisma-airs/desktop-contracts'\nimport type { DispatchOutcome } from '../../modules/tenants/dispatch'\nimport { INBOX_COPY as C, READ_COPY, SHELL_COPY, SNOOZE_COPY, clockOf } from '../copy'\nimport { Glyph, type GlyphName } from '../icons'\nimport { useShellStore } from '../store'\nimport type { VerdictTone } from '../verdict'\nimport { PageIntro } from '../page-intro'\nimport { SetupWarningResult } from '../setup-warning-history'\n\n/**\n * Sends one intent and reports its outcome on the shell's surfaces (DESIGN-V2\n * §7): a refusal or failed delivery as a warn toast naming `what`, an\n * unconfirmed delivery inline with Retry (never replayed on its own).\n */\nexport type Act = (what: string, intent: Intent) => Promise<DispatchOutcome>\n\nexport interface InboxProps {\n    snapshot: ShellSnapshot\n    onAct: Act\n    onNavigate: (feature: FeatureId) => void\n}\n\nexport type InboxTab = 'all' | 'action' | 'updates' | 'snoozed'\nconst TABS: InboxTab[] = ['all', 'action', 'updates', 'snoozed']\n\nexport const toneOf = (severity: InboxEntry['severity']): VerdictTone => (severity === 'bad' ? 'blocked' : severity === 'warn' ? 'flagged' : 'info')\n\n/** Where an entry's action leads (C30): the destination the core names. */\nexport function destinationFeature(entry: InboxEntry): FeatureId | null {\n    return entry.target?.feature ?? null\n}\n\n/**\n * Follows an entry's contextual action: the target's inventory and item are\n * handed to the destination (it selects them on arrival), then the shell\n * navigates through the core.\n */\nexport function follow(entry: InboxEntry, tenant: string, onNavigate: (feature: FeatureId) => void) {\n    const target = entry.target\n    if (!target) return\n    // The target belongs to the tenant it was followed in (I2): another tenant never inherits it.\n    useShellStore.getState().arrive({ tenant, feature: target.feature, resource: target.resource, item: target.item, ...(target.product ? { product: target.product } : {}) })\n    onNavigate(target.feature)\n}\n\n/** The tenant-named description of a hold action, for its outcome report. */\nexport function holdWhat(kind: 'acknowledgeItem' | 'snoozeItem' | 'unsnoozeItem', title: string): string {\n    return kind === 'acknowledgeItem' ? SHELL_COPY.acknowledgmentOf(title) : kind === 'snoozeItem' ? SHELL_COPY.snoozeOf(title) : SHELL_COPY.unsnoozeOf(title)\n}\n\n/** Which tab an entry belongs to; held entries are never \"needs action\". */\nexport function tabOf(entry: InboxEntry): InboxTab {\n    if (entry.hold?.kind === 'snooze') return 'snoozed'\n    if (entry.needsAction && !entry.hold) return 'action'\n    return 'updates'\n}\n\nconst severityTile = (severity: InboxEntry['severity']): { glyph: GlyphName; fg: string; bg: string } =>\n    severity === 'bad' ? { glyph: 'ban', fg: 'var(--v2-block)', bg: 'var(--v2-block-bg)' } : severity === 'warn' ? { glyph: 'alert', fg: 'var(--v2-flag)', bg: 'var(--v2-flag-bg)' } : { glyph: 'info', fg: 'var(--v2-soft)', bg: 'var(--v2-inset)' }\n\nconst button32 = 'flex h-8 min-h-0 items-center rounded-[7px] text-[13px] whitespace-nowrap'\n\n/**\n * The Inbox (C30, screens/inbox-reads.md): the active tenant's entries from\n * the core's Inbox scope, in tabs with counts, a detail pane with the facts,\n * the explanation and the contextual actions. Acknowledge and snooze are\n * core intents on the entry; the snooze return time is the core's and the\n * label is the one Home uses (I11). The selected tab and item are kept per\n * tenant across a switch (I2) and cleared when the tenant is deleted.\n */\nexport const Inbox = forwardRef<HTMLHeadingElement, InboxProps>(function Inbox({ snapshot, onAct, onNavigate }, _ref) {\n    const tenant = snapshot.tenants.find((t) => t.id === snapshot.active?.tenant) ?? null\n    const context = snapshot.active?.context ?? null\n    const tenantKey = tenant?.id ?? 'none'\n    const selection = useShellStore((s) => s.inboxSelection[tenantKey])\n    const selectInbox = useShellStore((s) => s.selectInbox)\n    const tab: InboxTab = selection?.tab ?? 'all'\n    const selectedId = selection?.item ?? null\n    const items = snapshot.inbox.items\n    const counts: Record<InboxTab, number> = { all: items.length, action: 0, updates: 0, snoozed: 0 }\n    for (const e of items) counts[tabOf(e)] += 1\n    const visible = items.filter((e) => tab === 'all' || tabOf(e) === tab)\n    const selected = items.find((e) => e.id === selectedId) ?? null\n    const selectedWarning = selected?.kind === 'setupWarning' ? tenant?.setupWarnings.find((w) => w.id === selected.id) : undefined\n    useEffect(() => {\n        if (selectedId && !items.some((e) => e.id === selectedId)) selectInbox(tenantKey, { tab, item: null })\n    }, [items, selectedId, selectInbox, tenantKey, tab])\n    const read = snapshot.inbox.read\n\n    // Holds are core intents; their outcomes reach the shell's surfaces. A\n    // snooze's return time is the core's: the shell announces it from the\n    // receipt the snapshot carries (the same toast whether asked here or on Home).\n    const act = (entry: InboxEntry, kind: 'acknowledgeItem' | 'snoozeItem' | 'unsnoozeItem') => context && void onAct(holdWhat(kind, entry.title), { kind, context, id: entry.id })\n    const readNow = () => context && tenant && void onAct(SHELL_COPY.readOf(tenant.label), { kind: 'readTenant', context })\n\n    // Never attempted, in progress, failed, partial, expired and healthy-empty\n    // reads stay distinct (I4, C12). Entries the core supplies (a setup\n    // warning before any read) are listed whatever the read status.\n    const failedUnread = read.state === 'failed' && read.lastReadAt === null && read.failedAt !== null\n    const stale = (read.state === 'done' || read.state === 'reading') && read.lastReadAt !== null && !snapshot.overview.fresh\n    const readingAgain = read.state === 'reading' && read.lastReadAt !== null\n    const empty = !tenant\n        ? C.emptyPending\n        : items.length === 0 && read.state === 'reading'\n          ? C.emptyReading\n          : items.length === 0 && read.state === 'pending'\n            ? C.emptyPending\n            : items.length === 0 && failedUnread\n              ? C.emptyFailed(clockOf(read.failedAt ?? 0))\n              : items.length === 0 && read.lastReadAt === null && read.settledAt !== null\n                ? C.emptyUnread(clockOf(read.settledAt), read.sourcesMissing.length)\n                : visible.length === 0\n                  ? tab === 'all' || tab === 'action'\n                      ? read.sourcesMissing.length > 0\n                          ? C.emptyPartial(read.products.reduce((n, p) => n + p.sourcesRead, 0), read.products.reduce((n, p) => n + p.sourcesTotal, 0), read.sourcesMissing)\n                          : stale\n                            ? C.emptyStale(clockOf(read.lastReadAt ?? 0))\n                            : C.emptyClear\n                      : C.emptyTab\n                  : null\n    const partialLine =\n        read.state === 'failed' && read.failedAt !== null && read.lastReadAt !== null\n            ? C.failedKept(clockOf(read.failedAt), clockOf(read.lastReadAt))\n            : (read.lastReadAt ?? read.settledAt) !== null && read.sourcesMissing.length > 0\n              ? C.partial(read.products.reduce((n, p) => n + p.sourcesRead, 0), read.products.reduce((n, p) => n + p.sourcesTotal, 0), clockOf(read.lastReadAt ?? read.settledAt ?? 0))\n              : readingAgain\n                ? stale\n                    ? C.readingStale(clockOf(read.lastReadAt ?? 0))\n                    : C.readingKept(clockOf(read.lastReadAt ?? 0))\n                : stale\n                  ? C.stale(clockOf(read.lastReadAt ?? 0))\n                  : null\n\n    // The empty states' role issue, the footer's coverage lines and the product hand-off (C37, R2App).\n    const needsRole = read.products.find((p) => p.state === 'needsRole') ?? null\n    const openProduct = (id: ProductId) => {\n        if (tenant) useShellStore.getState().arrive({ tenant: tenant.id, feature: 'administration', resource: null, item: null, product: id })\n        onNavigate('administration')\n    }\n    const sourcesRead = read.products.reduce((n, p) => n + p.sourcesRead, 0)\n    const sourcesTotal = read.products.reduce((n, p) => n + p.sourcesTotal, 0)\n    const readAt = read.lastReadAt ?? read.settledAt\n    const footLine1 = !tenant || readAt === null ? C.footNoReads(tenant?.label ?? '') : read.sourcesMissing.length > 0 ? C.footPartial(sourcesRead, sourcesTotal, clockOf(readAt)) : C.footAll(clockOf(readAt))\n    const gateway = snapshot.overview.read?.gateway ?? null\n    const footLine2 = gateway ? C.footGateway(gateway.workspaceName, gateway.policies) : (snapshot.overview.read?.gaps[0] ?? '')\n\n    return (\n        <section aria-label={C.title} data-slot='inbox' className='flex min-h-0 flex-grow flex-col' style={{ gap: 20 }}>\n            <PageIntro\n                description={\n                    <p role='status' data-slot='inbox-sub' className='text-[14px]' style={{ marginTop: 4, color: 'var(--v2-soft)' }}>\n                        {tenant ? C.sub(tenant.label) : C.emptyPending}\n                        {partialLine ? ` · ${partialLine}` : ''}\n                    </p>\n                }\n                actions={context && (\n                    <button type='button' onClick={readNow} disabled={read.state === 'reading'} className={`${button32} ml-auto border px-3.5 disabled:opacity-60`} style={{ borderColor: 'var(--v2-rule)', background: 'var(--v2-paper)', color: 'var(--v2-ink)' }}>\n                        {read.state === 'reading' ? C.reading : C.refresh}\n                    </button>\n                )}\n            />\n            {/* The list column is the prototype's 430px beside the detail; one under the other when both cannot fit (200% zoom, a narrow window). */}\n            <div data-slot='inbox-columns' className='grid min-h-0 min-w-0 flex-grow' style={{ gridTemplateColumns: 'minmax(0, 430px) minmax(0, 1fr)', gap: 20 }}>\n                <section aria-label={C.listCard} data-slot='inbox-list' className='flex min-h-0 min-w-0 flex-col overflow-hidden rounded-[12px] border' style={{ borderColor: 'var(--v2-rule)', background: 'var(--v2-paper)' }}>\nimport type { SetupWarning, VerifyState } from '@prisma-airs/desktop-contracts'\nimport { READ_COPY } from './copy'\n\nconst CHECK_STATE: Record<VerifyState, string> = { pending: 'Checking', pass: 'Passed', warning: 'Warning', fail: 'Failed', stored: 'Stored', skipped: 'Skipped', unavailable: 'Unavailable' }\n\nfunction RecordedTime({ seconds }: { seconds: number }) {\n    const date = new Date(seconds * 1000)\n    return Number.isFinite(date.valueOf()) ? <time dateTime={date.toISOString()}>{date.toLocaleString()}</time> : <span>Time unavailable</span>\n}\n\n/** Native outcomes only: this presentation never infers resolution from a product read. */\nexport function SetupWarningResult({ warning, live = false }: { warning: SetupWarning; live?: boolean }) {\n    return <div className='flex flex-col text-[13px]' style={{ gap: 5, color: 'var(--v2-soft)' }} role={live ? 'status' : undefined} aria-live={live ? 'polite' : undefined} data-slot='setup-warning-result'>\n        <p>Originally recorded <RecordedTime seconds={warning.recordedSecs} />.</p>\n        {warning.recheck ? <>\n            <p>Latest check: {CHECK_STATE[warning.recheck.state]} · <RecordedTime seconds={warning.recheck.checkedSecs} />.</p>\n            <p>{warning.recheck.reason}</p>\n            {warning.recheck.state !== 'pending' && (warning.recheck.basis === 'unknown' || !warning.recheck.equivalent) ? <p>The original scope could not be matched. This result does not resolve the original warning.</p> : null}\n        </> : <p>No later setup recheck is recorded.</p>}\n        {warning.resolvedSecs !== undefined\n            ? <p data-state='resolved'>Resolved <RecordedTime seconds={warning.resolvedSecs} />.</p>\n            : <p data-state='active'>Warning active.</p>}\n    </div>\n}\n\n/** Tenant configuration history is separate from the redacted diagnostic event log/export. */\nexport function SetupWarningHistory({ warnings }: { warnings: SetupWarning[] }) {\n    if (warnings.length === 0) return null\n    return <section aria-label='Setup check history' className='flex flex-col' style={{ gap: 10, borderTop: '1px solid var(--v2-rule)', paddingTop: 12 }}>\n        <h3 className='text-[14px] font-semibold' style={{ color: 'var(--v2-ink)' }}>Setup check history</h3>\n        <p className='text-[13px]' style={{ color: 'var(--v2-soft)' }}>These tenant setup records are separate from the redacted diagnostic events above. Exporting or clearing diagnostic events does not export or clear this history.</p>\n        <ol className='flex flex-col' style={{ gap: 14 }}>\n            {[...warnings].sort((a, b) => b.recordedSecs - a.recordedSecs).map((warning) => <li key={warning.id} data-warning={warning.id} className='flex flex-col' style={{ gap: 5 }}>\n                <h4 className='text-[13px] font-semibold' style={{ color: 'var(--v2-ink)' }}>{READ_COPY.products[warning.product]}</h4>\n                <p className='text-[13px] whitespace-pre-wrap' style={{ color: 'var(--v2-soft)' }}>{warning.reason}</p>\n                <SetupWarningResult warning={warning} />\n            </li>)}\n        </ol>\n    </section>\n}\n                        .filter_map(|m| m.grant.as_ref().map(|g| g.record.clone()))\n                        .collect()\n                })\n                .unwrap_or_default();\n            for record in mcp_records {\n                if !state.data.pending_cleanup.contains(&record) {\n                    state.data.pending_cleanup.push(record);\n                }\n            }\n            // Its protected history keys go through the ledger too (the\n            // sealed records are removed with its directory below).\n            let (history_keys, history_dir) = state.forget_harness_history(&tenant);\n            for key in history_keys {\n                if !state.data.pending_cleanup.contains(&key) {\n                    state.data.pending_cleanup.push(key);\n                }\n            }\n            state.data.tenants.retain(|t| t.profile.id != tenant);\n            if was_active {\n                state.data.active = None;\n            }\n            // The tenant's case Library key (and with it its sealed file)\n            // goes through the durable cleanup ledger, retried until done.\n            let library_key = crate::library::key_record(tenant.as_str());\n            if !state.data.pending_cleanup.contains(&library_key) {\n                state.data.pending_cleanup.push(library_key);\n            }\n            state.save_with(&before)?;\n            // Only an accepted deletion drops the tenant's scan records; a\n            // refused one keeps them observable and cancellable.\n            state.scans.retain(|r| r.tenant != tenant);\n            if let Some(path) = state.forget_reports(&tenant) {\n                effects.push(Effect::ForgetReports(path));\n            }\n            if let Some(path) = state.forget_gateway_local(&tenant) {\n                effects.push(Effect::ForgetReports(path));\n            }\n            state.forget_library(&tenant);\n            state.forget_holds(&tenant);\n            if let Some(dir) = history_dir {\n                effects.push(Effect::ForgetHarnessHistory(tenant.clone(), dir));\n            }\n            state.harness_grants.retain(|g| g.tenant != tenant);\n            if let Some(grant) = signed_in {\n                effects.push(Effect::HarnessSignedOut(grant));\n            }\n            state.mcp_live.retain(|g| g.tenant != tenant);\n            for grant in mcp_signed_in {\n                effects.push(Effect::McpSignedOut(grant));\n            }\n            for record in [retired_session, retired_management, retired_inference]\n                .into_iter()\n                .flatten()\n            {\n                let _ = session.delete(&record);\n            }\n            if state\n                .endpoint_review\n                .as_ref()\n                .is_some_and(|r| r.tenant == tenant)\n            {\n                state.endpoint_review = None;\n            }\n            if was_active {\n                effects.push(Effect::Start(state.reissue_context()));\n            }\n            effects.push(Effect::Cleanup);\n            state.changed();\n        }\n        Intent::ConfigureScanCredential { context, mode, key } => {\n            if key.expose().is_empty()\n                || key.expose().len() > MAX_SECRET_BYTES\n                || !crate::scan::key_is_usable(key.expose())\n            {\n                return Err(Refusal::InvalidInput);\n            }\n            configure_credential(\n                state,\n                session,\n                effects,\n                &context,\n                CredentialClass::Scan,\n                mode,\n                key,\n                None,\n                None,\n            )?;\n        }\n        Intent::ConfigureManagementCredential {\n            context,\n            mode,\n            client_id,\n            secret,\n        } => {\n            let tenant = state.check_context(&context)?;\n            // Management needs the tenant's TSG and its own OAuth client; the\n            // client secret goes only to the configured token origin.\n            let tsg_ok = state\n                .tenant(&tenant)\n                .and_then(|t| t.profile.tsg_id.as_deref())\n                .is_some_and(crate::management::tsg_is_valid);\n            if !tsg_ok {\n                return Err(Refusal::CapabilityMissing);\n            }\n            if !crate::management::client_id_is_valid(&client_id)\n                || secret.expose().is_empty()\n                || secret.expose().len() > MAX_SECRET_BYTES\n                || secret.expose().chars().any(char::is_control)\n                || state.management_endpoints.token_origin().is_none()\n            {\n                return Err(Refusal::InvalidInput);\n            }\n            configure_credential(\n                state,\n                session,\n                effects,\n                &context,\n                CredentialClass::Management,\n                mode,\n                secret,\n                Some(client_id),\n                None,\n            )?;\n        }\n        Intent::RemoveManagementCredential { context } => {\n            remove_credential(\n                state,\n                session,\n                effects,\n                &context,\n                CredentialClass::Management,\n            )?;\n        }\n        Intent::ReviewChange { context, draft } => {\n            let (operation, starts) = state.review_change(\n                context,\n                draft,\n                Arc::clone(&adapters.keychain),\n                Arc::clone(session),\n            )?;\n            operation_ref = operation;\n            effects.push(Effect::Start(starts));\n            state.changed();\n        }\n        Intent::RequestApply {\n            review,\n                });\n            }\n        }\n    }\n}\n\nfn complete_operation(\n    inner: &Arc<Inner>,\n    id: &OperationId,\n    outcome: Outcome,\n    stop: Option<StopReason>,\n) {\n    let effects = match lock(inner) {\n        Ok(mut state) => {\n            let now = Instant::now();\n            if let Some(stop) = stop {\n                state.operations.cancel(id, stop, now);\n            }\n            let starts = state.operations.complete(id, outcome, now);\n            state.sync_scans();\n            state.changed();\n            let mut effects = vec![Effect::Start(starts)];\n            effects.extend(state.take_case_writes());\n            effects.extend(gateway_local_effects(&mut state));\n            effects\n        }\n        Err(_) => return,\n    };\n    run_effects(inner, effects);\n}\n\n/// Gateway work to keep on this Mac after settlements: the newest writes,\n/// and reads of books that settlements wait for.\nfn gateway_local_effects(state: &mut State) -> Vec<Effect> {\n    let (writes, reads) = state.take_gateway_local();\n    writes\n        .into_iter()\n        .map(|(tenant, generation)| Effect::StoreGatewayLocal { tenant, generation })\n        .chain(\n            reads\n                .into_iter()\n                .map(|lease| Effect::LoadGatewayLocal { lease }),\n        )\n        .collect()\n}\n\n/// Stores a new credential of `class` for the active tenant, replacing any\n/// previous one of that class (the other class is untouched). The record is\n/// written ahead into the cleanup ledger and its secret stored only once\n/// that entry is durable.\n#[allow(clippy::too_many_arguments)]\nfn configure_credential(\n    state: &mut State,\n    session: &Arc<SessionVault>,\n    effects: &mut Vec<Effect>,\n    context: &ContextRef,\n    class: CredentialClass,\n    mode: StorageMode,\n    key: EnteredSecret,\n    client_id: Option<String>,\n    inference: Option<crate::gateway_inference::InferenceTarget>,\n) -> Result<(), Refusal> {\n    let tenant = state.check_context(context)?;\n    if mode == StorageMode::Keychain {\n        state.require_storage()?;\n    } else if state.storage == StorageHealth::Resetting {\n        return Err(Refusal::Busy);\n    }\n    let current = state.tenant(&tenant).ok_or(Refusal::StaleContext)?;\n    if matches!(current.capability(class), ScanCapability::Storing { .. }) {\n        return Err(Refusal::Busy);\n    }\n    let record = RecordId::issue().ok_or(Refusal::ShuttingDown)?;\n    let lease = state.lease();\n    let before = state.data.clone();\n    let retired_session = state.retire_class(&tenant, class);\n    if let Some(t) = state.tenant_mut(&tenant) {\n        *t.capability_mut(class) = ScanCapability::Storing {\n            lease,\n            record: record.clone(),\n            mode,\n        };\n        if class == CredentialClass::Management {\n            t.management_client = client_id;\n        }\n        if class == CredentialClass::Inference {\n            t.inference_target = inference;\n        }\n    }\n    if mode == StorageMode::Keychain {\n        // Write-ahead: the new record is in the cleanup ledger until\n        // it is committed, so a crash never leaves an untracked item.\n        state.data.pending_cleanup.push(record.clone());\n    }\n    if state.storage == StorageHealth::Ready {\n        state.save_with(&before)?;\n    }\n    if let Some(old) = retired_session {\n        let _ = session.delete(&old);\n    }\n    // A Keychain secret may be written only once its write-ahead\n    // ledger entry is confirmed durable: if a crash could restore a\n    // document without that entry, the secret would be untracked.\n    // The retirement of the previous key stays visible either way.\n    let authorized =\n        mode == StorageMode::Session || !state.durability_unconfirmed || state.confirm_durable();\n    // An inference key is not part of the tenant context: replacing it\n    // stops only the run that used the old one (reviews, reads and the\n    // workspace choice are untouched).\n    if class == CredentialClass::Inference {\n        effects.push(Effect::Start(state.retire_inference(&tenant)));\n    } else if state.data.active.as_ref() == Some(&tenant) {\n        effects.push(Effect::Start(state.reissue_context()));\n    } else if state.is_setup_tenant(&tenant) {\n        // A draft under setup (C29) has its own context: replacing its\n        // credential retires that context (and the binding cached under it)\n        // without touching the shell's active context.\n        state.reissue_setup_context();\n    }\n    if authorized {\n        if mode == StorageMode::Keychain {\n            state.writes_in_flight.push(record.clone());\n        }\n        effects.push(Effect::Store {\n            tenant,\n            class,\n            lease,\n            record,\n            mode,\n            key,\n        });\n    } else if let Some(t) = state.tenant_mut(&tenant) {\n        // Nothing was written; the ledger entry settles as absent.\n        *t.capability_mut(class) = ScanCapability::Failed {\n            mode,\n            failure: VaultError::Unavailable,\n        };\n    }\n    effects.push(Effect::Cleanup);\n    state.changed();\n    Ok(())\n}\n\n/// Signs the active tenant's `class` capability out (the other class is\n/// untouched).\n/// The native confirmation's private completion: never reachable from the\n/// renderer (it is the adapter future's own result).\nfn settle_confirmation(inner: &Arc<Inner>, review: &ReviewId, nonce: u64, accepted: bool) {\n    let starts = match lock(inner) {\n        Ok(mut state) => {\n            let starts = state.settle_confirmation(\n                review,\n                nonce,\n                accepted,\n                Arc::clone(&inner.adapters.keychain),\n                Arc::clone(&inner.session),\n            );\n            state.changed();\n            starts\n        }\n        Err(_) => return,\n    };\n    run_effects(inner, vec![Effect::Start(starts)]);\n}\n\nfn remove_credential(\n    state: &mut State,\n    session: &Arc<SessionVault>,\n    effects: &mut Vec<Effect>,\n    context: &ContextRef,\n    class: CredentialClass,\n) -> Result<(), Refusal> {\n    let tenant = state.check_context(context)?;\n    let has_keychain = matches!(\n        state.tenant(&tenant).map(|t| t.capability(class)),\n        Some(ScanCapability::Ready {\n            mode: StorageMode::Keychain,\n            ..\n        })\n    );\n    if has_keychain {\n        state.require_storage()?;\n    }\n    let before = state.data.clone();\n    let retired_session = state.retire_class(&tenant, class);\n    if state.storage == StorageHealth::Ready {\n        state.save_with(&before)?;\n    }\n    if let Some(old) = retired_session {\n        let _ = session.delete(&old);\n    }\n    if class == CredentialClass::Inference {\n        effects.push(Effect::Start(state.retire_inference(&tenant)));\n    } else if state.data.active.as_ref() == Some(&tenant) {\n        effects.push(Effect::Start(state.reissue_context()));\n    } else if state.is_setup_tenant(&tenant) {\n        state.reissue_setup_context();\n    }\n    effects.push(Effect::Cleanup);\n    state.changed();\n    Ok(())\n}\n\nfn settle_store(\n    inner: &Arc<Inner>,\n    tenant: &TenantId,\n    class: CredentialClass,\n    lease: u64,\n    record: RecordId,\n    mode: StorageMode,\n    result: Result<(), VaultError>,\n) {\n    let Ok(mut state) = lock(inner) else {\n        return;\n    };\n    state.writes_in_flight.retain(|r| r != &record);\n    let current = state.tenant(tenant).is_some_and(\n        |t| matches!(t.capability(class), ScanCapability::Storing { lease: l, .. } if *l == lease),\n    );\n","exit_code":0,"status":"completed"}}
