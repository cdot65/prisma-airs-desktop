{"type":"item.completed","item":{"id":"item_13","type":"command_execution","command":"/bin/zsh -lc 'cat crates/desktop-core/src/authority/setup_domain.rs'","aggregated_output":"//! Tenant setup (C29, screens/wizard.md): the first-run wizard and the\n//! add-tenant sheet work on one core-owned draft tenant with its own\n//! context. Credentials attach to the draft through the existing intents,\n//! verification runs in the core over the admitted reads and streams its\n//! steps through the shell snapshot, completion commits the draft as a\n//! tenant in one step, and a discard cleans its credentials up. Nothing of\n//! the draft is visible as a tenant until completion.\n\nuse std::collections::hash_map::DefaultHasher;\nuse std::hash::{Hash, Hasher};\nuse std::sync::{Arc, OnceLock};\n\nuse tokio::time::Instant;\n\nuse super::gateway_domain::SetupGateway;\nuse super::{CredentialClass, MAX_TENANTS, Refusal, ScanCapability, State, Tenant};\nuse crate::context::{ContextRef, WorkspaceRef};\nuse crate::features::{\n    OnboardingState, PackView, ProductId, SetupMode, SetupView, VerifyLine, VerifyState,\n    VerifyStep, VerifyView, VerifyWarning,\n};\nuse crate::gateway::{GatewayRead, GatewayResource, GatewayResult, PlaneAccess, ScopeBinding};\nuse crate::library::CaseProduct;\nuse crate::management::{ManagementFailure, ManagementRequest, ManagementResult};\nuse crate::runtime::OperationId;\nuse crate::tenants::TenantId;\nuse crate::tenants::{ProfileDraft, TenantProfile};\nuse crate::vault::{RecordId, SessionVault, StorageMode};\n\n/// The draft under setup.\n#[derive(Clone, Debug)]\npub(super) struct Setup {\n    pub mode: SetupMode,\n    pub tenant: Tenant,\n    pub context: ContextRef,\n    pub products: Vec<ProductId>,\n    pub verify: Option<VerifyRun>,\n    /// The draft's own Gateway listing and choice.\n    pub gateway: SetupGateway,\n}\n\n/// One verification run: its steps and the inputs it was run over.\n#[derive(Clone, Debug)]\npub(super) struct VerifyRun {\n    generation: u32,\n    signature: u64,\n    steps: Vec<StepState>,\n}\n\n#[derive(Clone, Debug)]\nstruct StepState {\n    step: VerifyStep,\n    operation: Option<OperationId>,\n}\n\n/// What a completed setup left for the handler to act on.\npub(super) struct Completed {\n    pub tenant: TenantId,\n    pub first_run: bool,\n    pub packs: Vec<CaseProduct>,\n    pub retired_workspace: Option<WorkspaceRef>,\n}\n\nconst MAX_WARNINGS: usize = 8;\n\n/// The bundled case-catalog counts per product (the packs step).\nfn pack_counts() -> &'static [(CaseProduct, u32)] {\n    static COUNTS: OnceLock<Vec<(CaseProduct, u32)>> = OnceLock::new();\n    COUNTS.get_or_init(|| {\n        let cases = crate::library::parse_catalog(crate::library::BUNDLED_CATALOG, \"catalog\")\n            .unwrap_or_default();\n        let mut counts: Vec<(CaseProduct, u32)> = Vec::new();\n        for case in cases {\n            match counts.iter_mut().find(|(p, _)| *p == case.product) {\n                Some((_, n)) => *n += 1,\n                None => counts.push((case.product, 1)),\n            }\n        }\n        counts\n    })\n}\n\n/// The case-catalog products a chosen product's starter pack holds.\npub(super) fn case_products(product: ProductId) -> &'static [CaseProduct] {\n    match product {\n        ProductId::RuntimeSecurity => &[CaseProduct::RuntimeSecurity],\n        ProductId::Gateway => &[CaseProduct::AiGateway],\n        ProductId::RedTeam => &[CaseProduct::AiRedTeaming],\n        ProductId::ModelSkill => &[CaseProduct::ModelSecurity, CaseProduct::SkillScanning],\n    }\n}\n\nfn needs_management(product: ProductId) -> bool {\n    product != ProductId::RuntimeSecurity\n}\n\n/// The verify step's reason for a management failure.\nfn failure_reason(failure: ManagementFailure) -> &'static str {\n    match failure {\n        ManagementFailure::Unauthorized => {\n            \"The management client was not accepted. Check the client ID and secret.\"\n        }\n        ManagementFailure::Denied => \"The management client is not allowed to read this tenant.\",\n        ManagementFailure::NotFound => \"The service found nothing for this TSG.\",\n        ManagementFailure::RateLimited => {\n            \"The service is rate-limiting requests; try again shortly.\"\n        }\n        ManagementFailure::Unavailable => \"The management service could not be reached.\",\n        ManagementFailure::Rejected => \"The service rejected the request.\",\n        ManagementFailure::Timeout => \"The service did not answer in time.\",\n        ManagementFailure::Cancelled => \"The check was cancelled.\",\n        ManagementFailure::Network => \"The network request failed.\",\n        ManagementFailure::Destination => \"The management destination is not reachable from here.\",\n        ManagementFailure::InvalidResponse => {\n            \"The service returned a reply the desktop could not use.\"\n        }\n        ManagementFailure::CredentialLocked => {\n            \"The Keychain is locked; unlock it and verify again.\"\n        }\n        ManagementFailure::CredentialDenied => \"The Keychain denied access to the client secret.\",\n        ManagementFailure::CredentialMissing => \"The client secret is missing from the Keychain.\",\n        ManagementFailure::Configuration => \"The management client is not fully configured.\",\n    }\n}\n\nfn chosen(products: Vec<ProductId>) -> Vec<ProductId> {\n    let mut chosen = vec![ProductId::RuntimeSecurity];\n    for p in products {\n        if !chosen.contains(&p) {\n            chosen.push(p);\n        }\n    }\n    chosen\n}\n\nimpl State {\n    /// Whether `context` is the draft's.\n    pub(super) fn is_setup_context(&self, context: &ContextRef) -> bool {\n        self.data\n            .setup\n            .as_ref()\n            .is_some_and(|s| &s.context == context)\n    }\n\n    /// The draft's tenant id for its context.\n    pub(super) fn setup_tenant_for(&self, context: &ContextRef) -> Option<TenantId> {\n        self.data\n            .setup\n            .as_ref()\n            .filter(|s| &s.context == context)\n            .map(|s| s.tenant.profile.id.clone())\n    }\n\n    fn setup_for(&self, context: &ContextRef) -> Result<&Setup, Refusal> {\n        self.data\n            .setup\n            .as_ref()\n            .filter(|s| &s.context == context)\n            .ok_or(Refusal::StaleContext)\n    }\n\n    fn setup_for_mut(&mut self, context: &ContextRef) -> Result<&mut Setup, Refusal> {\n        self.data\n            .setup\n            .as_mut()\n            .filter(|s| &s.context == context)\n            .ok_or(Refusal::StaleContext)\n    }\n\n    /// Starts a setup with a validated profile. One draft at a time.\n    pub(super) fn begin_setup(\n        &mut self,\n        mode: SetupMode,\n        profile: ProfileDraft,\n    ) -> Result<(), Refusal> {\n        let profile = profile.validate().ok_or(Refusal::InvalidInput)?;\n        if self.data.setup.is_some() {\n            return Err(Refusal::Busy);\n        }\n        if self.data.tenants.len() >= MAX_TENANTS {\n            return Err(Refusal::Busy);\n        }\n        if mode == SetupMode::FirstRun && !self.data.tenants.is_empty() {\n            return Err(Refusal::InvalidInput);\n        }\n        let id = TenantId::issue().ok_or(Refusal::ShuttingDown)?;\n        self.epoch += 1;\n        let context = ContextRef::issue(&self.salt, self.epoch);\n        self.data.setup = Some(Setup {\n            mode,\n            tenant: Tenant::new(TenantProfile {\n                id,\n                label: profile.label,\n                tsg_id: profile.tsg_id,\n                destination: profile.destination,\n                environment: profile.environment,\n            }),\n            context,\n            products: vec![ProductId::RuntimeSecurity],\n            verify: None,\n            gateway: SetupGateway::default(),\n        });\n        Ok(())\n    }\n\n    /// Whether `tenant` is the draft under setup.\n    pub(super) fn is_setup_tenant(&self, tenant: &TenantId) -> bool {\n        self.data\n            .setup\n            .as_ref()\n            .is_some_and(|s| &s.tenant.profile.id == tenant)\n    }\n\n    /// The draft's inputs changed (a credential, the profile): a fresh\n    /// context replaces the old one so nothing bound to it survives — the\n    /// cached management binding (SDK clients, token cache, TSG), reads in\n    /// flight, the verify run and the Gateway listing and choice.\n    pub(super) fn reissue_setup_context(&mut self) {\n        if self.data.setup.is_none() {\n            return;\n        }\n        self.epoch += 1;\n        let fresh = ContextRef::issue(&self.salt, self.epoch);\n        self.retire_setup_authority();\n        if let Some(setup) = self.data.setup.as_mut() {\n            setup.context = fresh;\n            setup.verify = None;\n            setup.gateway = SetupGateway::default();\n        }\n    }\n\n    /// A tenant was committed outside the setup (the legacy Create tenant\n    /// or a v1 import during first run): a first-run draft is over, since\n    /// the desktop now has a tenant and the shell takes over. Its Keychain\n    /// records go to the cleanup queue; returned session records are the\n    /// caller's to delete.\n    pub(super) fn end_first_run_setup(&mut self) -> Vec<RecordId> {\n        if self\n            .data\n            .setup\n            .as_ref()\n            .is_none_or(|s| s.mode != SetupMode::FirstRun)\n        {\n            return Vec::new();\n        }\n        let context = self.data.setup.as_ref().map(|s| s.context.clone());\n        match context {\n            Some(context) => self.discard_setup(&context).unwrap_or_default(),\n            None => Vec::new(),\n        }\n    }\n\n    /// Changes the draft's profile. A new destination retires credentials\n    /// bound to the old one (returned session records are the caller's to\n    /// delete); verification results go stale through the signature.\n    pub(super) fn update_setup(\n        &mut self,\n        context: &ContextRef,\n        profile: ProfileDraft,\n    ) -> Result<Vec<RecordId>, Refusal> {\n        let profile = profile.validate().ok_or(Refusal::InvalidInput)?;\n        let setup = self.setup_for(context)?;\n        let id = setup.tenant.profile.id.clone();\n        let destination_changed = setup.tenant.profile.destination != profile.destination;\n        let tsg_changed = setup.tenant.profile.tsg_id != profile.tsg_id;\n        let mut retired = Vec::new();\n        if destination_changed {\n            for class in [\n                CredentialClass::Scan,\n                CredentialClass::Management,\n                CredentialClass::Inference,\n            ] {\n                retired.extend(self.retire_class(&id, class));\n            }\n        } else if tsg_changed {\n            retired.extend(self.retire_class(&id, CredentialClass::Management));\n        }\n        let setup = self.setup_for_mut(context)?;\n        let changed = setup.tenant.profile.label != profile.label\n            || setup.tenant.profile.tsg_id != profile.tsg_id\n            || setup.tenant.profile.destination != profile.destination\n            || setup.tenant.profile.environment != profile.environment;\n        setup.tenant.profile.label = profile.label;\n        setup.tenant.profile.tsg_id = profile.tsg_id;\n        setup.tenant.profile.destination = profile.destination;\n        setup.tenant.profile.environment = profile.environment;\n        if changed {\n            self.reissue_setup_context();\n        }\n        Ok(retired)\n    }\n\n    /// Records the chosen products (Runtime Security always, in first place).\n    pub(super) fn choose_setup_products(\n        &mut self,\n        context: &ContextRef,\n        products: Vec<ProductId>,\n    ) -> Result<(), Refusal> {\n        let setup = self.setup_for_mut(context)?;\n        setup.products = chosen(products);\n        Ok(())\n    }\n\n    /// A digest of every input verification depends on: profile, products\n    /// and the credential records. Results for another digest are stale.\n    fn setup_signature(setup: &Setup) -> u64 {\n        let mut h = DefaultHasher::new();\n        let p = &setup.tenant.profile;\n        p.label.hash(&mut h);\n        p.tsg_id.hash(&mut h);\n        p.destination.origin().hash(&mut h);\n        (p.environment as u8).hash(&mut h);\n        for product in &setup.products {\n            (*product as u8).hash(&mut h);\n        }\n        for class in [\n            CredentialClass::Scan,\n            CredentialClass::Management,\n            CredentialClass::Inference,\n        ] {\n            match setup.tenant.capability(class) {\n                ScanCapability::Ready { record, .. } => record.as_str().hash(&mut h),\n                ScanCapability::Storing { record, .. } => {\n                    \"storing\".hash(&mut h);\n                    record.as_str().hash(&mut h);\n                }\n                ScanCapability::Missing | ScanCapability::Failed { .. } => \"none\".hash(&mut h),\n            }\n        }\n        setup.tenant.management_client.hash(&mut h);\n        setup\n            .gateway\n            .selection\n            .as_ref()\n            .map(|s| s.workspace.id.as_str())\n            .hash(&mut h);\n        h.finish()\n    }\n\n    /// Starts a verification run over the current inputs: every line is\n    /// decided in the core; the lines that need a service read are admitted\n    /// through the management pipeline and settle through it.\n    pub(super) fn begin_verify(\n        &mut self,\n        context: &ContextRef,\n        keychain: Arc<dyn super::CredentialStore>,\n        session_vault: Arc<SessionVault>,\n    ) -> Result<Vec<crate::runtime::Start>, Refusal> {\n        let setup = self.setup_for(context)?;\n        let generation = setup.verify.as_ref().map_or(1, |v| v.generation + 1);\n        let signature = Self::setup_signature(setup);\n        let products = setup.products.clone();\n        let scan = setup.tenant.scan.clone();\n        let management_ready = matches!(setup.tenant.management, ScanCapability::Ready { .. });\n        let mut starts = Vec::new();\n        let mut steps = Vec::new();\n        let mut admit = |state: &mut Self, request: ManagementRequest| -> Option<OperationId> {\n            match state.admit_management(\n                context.clone(),\n                request,\n                Arc::clone(&keychain),\n                Arc::clone(&session_vault),\n            ) {\n                Ok((operation, s)) => {\n                    starts.extend(s);\n                    Some(operation)\n                }\n                Err(_) => None,\n            }\n        };\n        // Runtime Security scan key: stored keys are proven by the first\n        // scan (there is no admitted read that exercises a scan key).\n        let (state_, reason) = match scan {\n            ScanCapability::Ready { .. } => (\n                VerifyState::Stored,\n                \"Stored in the Keychain. Not checked here: the first scan proves it against the service.\",\n            ),\n            ScanCapability::Storing { .. } => {\n                (VerifyState::Fail, \"The scan key is still being saved.\")\n            }\n            _ => (\n                VerifyState::Warning,\n                \"No scan key configured; scanning stays unavailable until one is added in Settings.\",\n            ),\n        };\n        steps.push(StepState {\n            step: VerifyStep {\n                line: VerifyLine::ScanKey,\n                product: Some(ProductId::RuntimeSecurity),\n                state: state_,\n                reason: reason.to_owned(),\n            },\n            operation: None,\n        });\n        // Authentication is required independently of the chosen products.\n        let management = if management_ready {\n            match admit(self, ManagementRequest::Verify) {\n                Some(op) => (VerifyState::Pending, \"Authenticating…\".to_owned(), Some(op)),\n                None => (\n                    VerifyState::Fail,\n                    \"OAuth authentication could not be started.\".to_owned(),\n                    None,\n                ),\n            }\n        } else {\n            (\n                VerifyState::Fail,\n                \"Management OAuth authentication is required before adding a tenant.\".to_owned(),\n                None,\n            )\n        };\n        steps.push(StepState {\n            step: VerifyStep {\n                line: VerifyLine::ManagementClient,\n                product: Some(ProductId::RuntimeSecurity),\n                state: management.0,\n                reason: management.1,\n            },\n            operation: management.2,\n        });\n        let chosen_workspace = self.setup_workspace_reference();\n        for product in products.iter().copied().filter(|p| needs_management(*p)) {\n            let (line, request) = match product {\n                // With a workspace chosen its prerequisites are read (the\n                // admitted scoped read); otherwise only the listing can be.\n                ProductId::Gateway => (\n                    VerifyLine::Gateway,\n                    match chosen_workspace.clone() {\n                        Some(reference) => ManagementRequest::Gateway {\n                            workspace: Some(reference),\n                            read: GatewayRead::Prerequisites,\n                        },\n                        None => ManagementRequest::Gateway {\n                            workspace: None,\n                            read: GatewayRead::Inventory {\n                                resource: GatewayResource::Workspaces,\n                            },\n                        },\n                    },\n                ),\n                ProductId::RedTeam => (\n                    VerifyLine::RedTeam,\n                    ManagementRequest::RedTeam { window: 7 },\n                ),\n                ProductId::ModelSkill => (VerifyLine::ModelSkill, ManagementRequest::SupplyChain),\n                ProductId::RuntimeSecurity => continue,\n            };\n            let (state_, reason, operation) = if !management_ready {\n                (\n                    VerifyState::Warning,\n                    \"Needs the management client; not checked.\".to_owned(),\n                    None,\n                )\n            } else {\n                match admit(self, request) {\n                    Some(op) => (VerifyState::Pending, \"Reading…\".to_owned(), Some(op)),\n                    None => (\n                        VerifyState::Fail,\n                        \"The read could not be started.\".to_owned(),\n                        None,\n                    ),\n                }\n            };\n            steps.push(StepState {\n                step: VerifyStep {\n                    line,\n                    product: Some(product),\n                    state: state_,\n                    reason,\n                },\n                operation,\n            });\n        }\n        // Products without an admitted service are listed, never checked.\n        for line in [VerifyLine::Ais, VerifyLine::Aes] {\n            steps.push(StepState {\n                step: VerifyStep {\n                    line,\n                    product: None,\n                    state: VerifyState::Unavailable,\n                    reason: \"Not available in this release: no admitted service (D058).\".to_owned(),\n                },\n                operation: None,\n            });\n        }\n        let setup = self.setup_for_mut(context)?;\n        setup.verify = Some(VerifyRun {\n            generation,\n            signature,\n            steps,\n        });\n        Ok(starts)\n    }\n\n    /// The operations the current verify run waits on.\n    pub(super) fn setup_operations(&self) -> Vec<OperationId> {\n        self.data\n            .setup\n            .as_ref()\n            .and_then(|s| s.verify.as_ref())\n            .map(|v| v.steps.iter().filter_map(|s| s.operation.clone()).collect())\n            .unwrap_or_default()\n    }\n\n    /// Settles one verify line from its management result.\n    pub(super) fn setup_settled(&mut self, operation: &OperationId, result: &ManagementResult) {\n        let Some(run) = self.data.setup.as_mut().and_then(|s| s.verify.as_mut()) else {\n            return;\n        };\n        let Some(step) = run\n            .steps\n            .iter_mut()\n            .find(|s| s.operation.as_ref() == Some(operation))\n        else {\n            return;\n        };\n        step.operation = None;\n        let (state, reason) = verify_result(step.step.line, result);\n        step.step.state = state;\n        step.step.reason = reason;\n    }\n\n    fn verify_view(setup: &Setup) -> Option<VerifyView> {\n        let run = setup.verify.as_ref()?;\n        let steps: Vec<VerifyStep> = run.steps.iter().map(|s| s.step.clone()).collect();\n        let done = steps.iter().all(|s| s.state != VerifyState::Pending);\n        let failed = steps.iter().any(|s| s.state == VerifyState::Fail);\n        // Authentication must positively pass; stored credentials and product\n        // permissions are separate facts and cannot substitute for that proof.\n        let blocking = steps\n            .iter()\n            .find(|s| s.line == VerifyLine::ManagementClient)\n            .is_none_or(|s| s.state != VerifyState::Pass);\n        let warnings = steps\n            .iter()\n            .filter_map(|s| {\n                let product = s.product?;\n                match s.state {\n                    VerifyState::Warning => Some(VerifyWarning {\n                        product,\n                        reason: s.reason.clone(),\n                    }),\n                    VerifyState::Fail if s.line != VerifyLine::ManagementClient => {\n                        Some(VerifyWarning {\n                            product,\n                            reason: format!(\"Failed: {}\", s.reason),\n                        })\n                    }\n                    _ => None,\n                }\n            })\n            .collect();\n        Some(VerifyView {\n            generation: run.generation,\n            steps,\n            done,\n            failed,\n            blocking,\n            stale: run.signature != Self::setup_signature(setup),\n            warnings,\n        })\n    }\n\n    /// The draft as the shell shows it.\n    pub(super) fn setup_view(&self) -> Option<SetupView> {\n        let setup = self.data.setup.as_ref()?;\n        let verify = Self::verify_view(setup);\n        let completable = verify\n            .as_ref()\n            .is_some_and(|v| v.done && !v.blocking && !v.stale);\n        let packs = setup\n            .products\n            .iter()\n            .map(|p| PackView {\n                product: *p,\n                count: case_products(*p)\n                    .iter()\n                    .map(|cp| {\n                        pack_counts()\n                            .iter()\n                            .find(|(c, _)| c == cp)\n                            .map_or(0, |(_, n)| *n)\n                    })\n                    .sum(),\n            })\n            .collect();\n        Some(SetupView {\n            mode: setup.mode,\n            context: setup.context.clone(),\n            tenant: super::tenant_view(&setup.tenant),\n            products: setup.products.clone(),\n            scan_required: false,\n            management_required: true,\n            packs,\n            workspace: self.setup_workspace(&setup.context),\n            verify,\n            completable,\n        })\n    }\n\n    /// Commits the draft: it becomes a tenant with its products and the\n    /// verify warnings, is made active, and a first run's onboarding is\n    /// done. Refused unless the current inputs were verified without a\n    /// failure (the presentation cannot skip or forge a check).\n    /// Whether the draft under `context` may complete with `packs` now (the\n    /// checks of [`State::complete_setup`], without changing anything):\n    /// the draft tenant's id when it may.\n    pub(super) fn completable_setup(\n        &self,\n        context: &ContextRef,\n        packs: &[ProductId],\n    ) -> Result<TenantId, Refusal> {\n        let setup = self.setup_for(context)?;\n        let view = Self::verify_view(setup).ok_or(Refusal::InvalidInput)?;\n        if !view.done || view.blocking || view.stale {\n            return Err(Refusal::InvalidInput);\n        }\n        if !setup\n            .tenant\n            .profile\n            .tsg_id\n            .as_deref()\n            .is_some_and(crate::management::tsg_is_valid)\n            || !matches!(setup.tenant.management, ScanCapability::Ready { .. })\n        {\n            return Err(Refusal::InvalidInput);\n        }\n        if packs.iter().any(|p| !setup.products.contains(p)) {\n            return Err(Refusal::InvalidInput);\n        }\n        if self.data.tenants.len() >= MAX_TENANTS {\n            return Err(Refusal::Busy);\n        }\n        Ok(setup.tenant.profile.id.clone())\n    }\n\n    pub(super) fn complete_setup(\n        &mut self,\n        context: &ContextRef,\n        packs: Vec<ProductId>,\n        recorded_secs: u32,\n    ) -> Result<Completed, Refusal> {\n        self.completable_setup(context, &packs)?;\n        let setup = self.setup_for(context)?;\n        let view = Self::verify_view(setup).ok_or(Refusal::InvalidInput)?;\n        // Stage only Data before persistence. Authority retirement is\n        // irreversible and waits for the handler's successful save.\n        let retired_workspace = self.setup_workspace_reference();\n        let Some(mut setup) = self.data.setup.take() else {\n            return Err(Refusal::StaleContext);\n        };\n        let first_run = setup.mode == SetupMode::FirstRun;\n        setup.tenant.products = setup.products.clone();\n        for (n, w) in view.warnings.into_iter().take(MAX_WARNINGS).enumerate() {\n            setup\n                .tenant\n                .setup_warnings\n                .push(crate::features::SetupWarning {\n                    id: format!(\"vw-{}\", n + 1),\n                    product: w.product,\n                    reason: w.reason,\n                    recorded_secs,\n                    check: Some(super::setup_warning_domain::binding_for(\n                        &setup.tenant,\n                        super::setup_warning_domain::line_for(w.product),\n                        setup\n                            .gateway\n                            .selection\n                            .as_ref()\n                            .map(|s| crate::gateway::WorkspaceScope::from(&s.workspace)),\n                    )),\n                    recheck: None,\n                    resolved_secs: None,\n                });\n        }\n        let id = setup.tenant.profile.id.clone();\n        self.data.tenants.push(setup.tenant);\n        self.data.active = Some(id.clone());\n        if first_run {\n            self.data.onboarding = Some(OnboardingState::Done);\n        }\n        let packs = packs\n            .iter()\n            .flat_map(|p| case_products(*p).iter().copied())\n            .collect();\n        Ok(Completed {\n            tenant: id,\n            first_run,\n            packs,\n            retired_workspace,\n        })\n    }\n\n    /// Drops the draft. Its Keychain records go to the cleanup queue; the\n    /// returned session records are the caller's to delete. No tenant,\n    /// selection or onboarding state changes.\n    pub(super) fn discard_setup(&mut self, context: &ContextRef) -> Result<Vec<RecordId>, Refusal> {\n        let id = self.setup_for(context)?.tenant.profile.id.clone();\n        let mut retired = Vec::new();\n        for class in [\n            CredentialClass::Scan,\n            CredentialClass::Management,\n            CredentialClass::Inference,\n        ] {\n            retired.extend(self.retire_class(&id, class));\n        }\n        self.retire_setup_authority();\n        self.data.setup = None;\n        Ok(retired)\n    }\n\n    /// Nothing bound to the draft's context outlives the draft: the cached\n    /// management binding (SDK clients, token cache), the reads queued or in\n    /// flight under its context and under its chosen workspace reference.\n    /// Late replies are withdrawn by the pipeline (the context is gone).\n    fn retire_setup_authority(&mut self) {\n        let Some((context, reference)) = self.data.setup.as_ref().map(|s| {\n            (\n                s.context.clone(),\n                s.gateway.selection.as_ref().map(|w| w.reference.clone()),\n            )\n        }) else {\n            return;\n        };\n        self.retire_setup_context(&context, reference.as_ref());\n    }\n\n    /// Retire a committed draft only after its state replacement succeeded.\n    pub(super) fn retire_setup_context(\n        &mut self,\n        context: &ContextRef,\n        reference: Option<&WorkspaceRef>,\n    ) {\n        self.retire_management_binding(context);\n        let now = Instant::now();\n        let mut starts = self.operations.retire_context(context.as_str(), now);\n        if let Some(reference) = reference {\n            starts.extend(self.operations.retire_context(reference.as_str(), now));\n        }\n        self.queue_gateway_starts(starts);\n    }\n\n    /// Whether a draft credential is stored in the Keychain (its removal\n    /// needs storage).\n    pub(super) fn setup_has_keychain_credential(&self) -> bool {\n        self.data.setup.as_ref().is_some_and(|s| {\n            [\n                CredentialClass::Scan,\n                CredentialClass::Management,\n                CredentialClass::Inference,\n            ]\n            .into_iter()\n            .any(|c| {\n                matches!(\n                    s.tenant.capability(c),\n                    ScanCapability::Ready {\n                        mode: StorageMode::Keychain,\n                        ..\n                    }\n                )\n            })\n        })\n    }\n}\n\n/// Shared capability evaluation for first setup and dedicated warning rechecks.\n/// A normal product refresh never calls this reconciliation path.\npub(super) fn verify_result(line: VerifyLine, result: &ManagementResult) -> (VerifyState, String) {\n    match (&line, result) {\n        (_, ManagementResult::Failed { failure, .. }) => {\n            (VerifyState::Fail, failure_reason(*failure).to_owned())\n        }\n        (VerifyLine::ManagementClient, ManagementResult::Verified) => (\n            VerifyState::Pass,\n            \"Management OAuth authenticated successfully.\".to_owned(),\n        ),\n        (\n            VerifyLine::Gateway,\n            ManagementResult::Gateway {\n                gateway: GatewayResult::List { list },\n            },\n        ) => {\n            // No workspace chosen: the listing is readable, but the\n            // workspace's prerequisites were not checked.\n            if list.count > 0 {\n                (\n                    VerifyState::Warning,\n                    format!(\n                        \"{} Gateway workspace(s) readable; none chosen, so its prerequisites were not checked.\",\n                        list.count\n                    ),\n                )\n            } else {\n                (\n                    VerifyState::Warning,\n                    \"No Gateway workspace in this tenant yet.\".to_owned(),\n                )\n            }\n        }\n        (\n            VerifyLine::Gateway,\n            ManagementResult::Gateway {\n                gateway: GatewayResult::Prerequisites { prerequisites },\n            },\n        ) => {\n            let sources = [\n                (\"routes\", prerequisites.routes_failure),\n                (\"providers\", prerequisites.providers_failure),\n                (\"integrations\", prerequisites.integrations_failure),\n                (\"service keys\", prerequisites.service_keys_failure),\n            ];\n            let mut failed: Vec<String> = sources\n                .iter()\n                .filter_map(|(name, f)| f.map(|f| format!(\"{name}: {}\", failure_reason(f))))\n                .collect();\n            // Every source attempted counts: the IAM scope binding and the\n            // three planes are part of the prerequisites, not decoration.\n            let plane = |name: &str, access: PlaneAccess| match access {\n                PlaneAccess::Granted => None,\n                PlaneAccess::Denied => Some(format!(\"{name} plane: permission refused\")),\n                PlaneAccess::Failed => Some(format!(\"{name} plane: reads failed\")),\n            };\n            failed.extend(plane(\"data\", prerequisites.data_plane));\n            failed.extend(plane(\"admin\", prerequisites.admin_plane));\n            failed.extend(plane(\"IAM\", prerequisites.iam_plane));\n            failed.extend(match prerequisites.scope {\n                ScopeBinding::Bound => None,\n                ScopeBinding::Unbound => Some(format!(\n                    \"scope {} does not list the workspace\",\n                    prerequisites.scope_name\n                )),\n                ScopeBinding::Absent => {\n                    Some(format!(\"scope {} does not exist\", prerequisites.scope_name))\n                }\n                ScopeBinding::Denied => Some(format!(\n                    \"scope {} may not be read by this client\",\n                    prerequisites.scope_name\n                )),\n                ScopeBinding::Failed => Some(format!(\n                    \"scope {} could not be read\",\n                    prerequisites.scope_name\n                )),\n            });\n            let lists_failed = sources.iter().filter(|(_, f)| f.is_some()).count();\n            if failed.is_empty() {\n                (\n                    VerifyState::Pass,\n                    format!(\n                        \"Workspace {}: {} route(s), {} provider(s), {} inference key(s) readable.\",\n                        prerequisites.workspace,\n                        prerequisites.routes.as_ref().map_or(0, |l| l.count),\n                        prerequisites.providers.as_ref().map_or(0, |l| l.count),\n                        prerequisites.inference_keys\n                    ),\n                )\n            } else if lists_failed < sources.len() {\n                (\n                    VerifyState::Warning,\n                    format!(\n                        \"Workspace {}: partial; {}\",\n                        prerequisites.workspace,\n                        failed.join(\"; \")\n                    ),\n                )\n            } else {\n                (\n                    VerifyState::Fail,\n                    format!(\n                        \"Workspace {}: {}\",\n                        prerequisites.workspace,\n                        failed.join(\"; \")\n                    ),\n                )\n            }\n        }\n        (VerifyLine::RedTeam, ManagementResult::RedTeam { observation }) => {\n            match (&observation.scans, &observation.statistics) {\n                (Some(scans), Some(_)) => (\n                    VerifyState::Pass,\n                    format!(\n                        \"Red Team scans and statistics readable ({} scans listed).\",\n                        scans.rows.len()\n                    ),\n                ),\n                (Some(scans), None) => (\n                    VerifyState::Warning,\n                    format!(\n                        \"Red Team scans readable ({} listed); statistics did not: {}\",\n                        scans.rows.len(),\n                        observation\n                            .statistics_failure\n                            .map_or(\"no reason\", failure_reason)\n                    ),\n                ),\n                (None, Some(_)) => (\n                    VerifyState::Warning,\n                    format!(\n                        \"Statistics read; the scan list did not: {}\",\n                        observation\n                            .scans_failure\n                            .map_or(\"no reason\", failure_reason)\n                    ),\n                ),\n                (None, None) => (\n                    VerifyState::Fail,\n                    observation\n                        .scans_failure\n                        .or(observation.statistics_failure)\n                        .map_or(\"The Red Team reads returned nothing.\", failure_reason)\n                        .to_owned(),\n                ),\n            }\n        }\n        (VerifyLine::ModelSkill, ManagementResult::SupplyChain { observation }) => {\n            let ok = [\n                observation.models.is_some(),\n                observation.skills.is_some(),\n                observation.skill_statistics.is_some(),\n            ];\n            let readable = ok.iter().filter(|b| **b).count();\n            if readable == 3 {\n                (\n                    VerifyState::Pass,\n                    format!(\n                        \"AI Supply Chain Security readable ({} model scans, {} skill scans).\",\n                        observation.models.as_ref().map_or(0, |m| m.rows.len()),\n                        observation.skills.as_ref().map_or(0, |s| s.rows.len())\n                    ),\n                )\n            } else {\n                let failures = [\n                    (\n                        \"Model scans\",\n                        observation.models.is_none(),\n                        observation.models_failure,\n                    ),\n                    (\n                        \"Skill scans\",\n                        observation.skills.is_none(),\n                        observation.skills_failure,\n                    ),\n                    (\n                        \"Skill statistics\",\n                        observation.skill_statistics.is_none(),\n                        observation.skill_statistics_failure,\n                    ),\n                ]\n                .into_iter()\n                .filter(|(_, missing, _)| *missing)\n                .map(|(source, _, failure)| {\n                    format!(\n                        \"{source}: {}\",\n                        failure.map_or(\"The service returned no usable result.\", failure_reason)\n                    )\n                })\n                .collect::<Vec<_>>()\n                .join(\"; \");\n                (\n                    if readable > 0 {\n                        VerifyState::Warning\n                    } else {\n                        VerifyState::Fail\n                    },\n                    format!(\n                        \"{readable} of 3 AI Supply Chain Security sources readable. {failures}\"\n                    ),\n                )\n            }\n        }\n        _ => (\n            VerifyState::Fail,\n            \"The service returned a reply the desktop could not use.\".to_owned(),\n        ),\n    }\n}\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_14","type":"command_execution","command":"/bin/zsh -lc 'cat crates/desktop-core/src/authority/setup_warning_domain.rs; git diff f1e58da5 -- crates/desktop-core/src/management.rs crates/desktop-core/src/authority/management_domain.rs crates/desktop-core/src/authority/inbox_domain.rs crates/desktop-core/src/gateway.rs'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_14","type":"command_execution","command":"/bin/zsh -lc 'cat crates/desktop-core/src/authority/setup_warning_domain.rs; git diff f1e58da5 -- crates/desktop-core/src/management.rs crates/desktop-core/src/authority/management_domain.rs crates/desktop-core/src/authority/inbox_domain.rs crates/desktop-core/src/gateway.rs'","aggregated_output":"//! Dedicated, read-only reconciliation of recorded setup warnings. Ordinary\n//! product refreshes do not enter this path. Original diagnostics are immutable.\n\nuse std::collections::hash_map::DefaultHasher;\nuse std::hash::{Hash, Hasher};\nuse std::sync::Arc;\n\nuse super::{CredentialClass, Refusal, ScanCapability, State, Tenant, TenantView};\nuse crate::context::ContextRef;\nuse crate::features::{\n    ProductId, SetupWarning, SetupWarningBasis, SetupWarningBinding, SetupWarningRecheck,\n    SetupWarningWorkspace, VerifyLine, VerifyState,\n};\nuse crate::gateway::{GatewayRead, WorkspaceScope};\nuse crate::management::{ManagementRequest, ManagementResult};\nuse crate::runtime::{OperationId, Start};\nuse crate::tenants::TenantId;\nuse crate::vault::SessionVault;\n\n#[derive(Clone, Debug)]\npub(super) struct Recheck {\n    operation: OperationId,\n    context: ContextRef,\n    tenant: TenantId,\n    warning: String,\n    binding: SetupWarningBinding,\n    signature: u64,\n    started_secs: u32,\n}\n\npub(super) fn line_for(product: ProductId) -> VerifyLine {\n    match product {\n        ProductId::RuntimeSecurity => VerifyLine::ScanKey,\n        ProductId::Gateway => VerifyLine::Gateway,\n        ProductId::RedTeam => VerifyLine::RedTeam,\n        ProductId::ModelSkill => VerifyLine::ModelSkill,\n    }\n}\n\npub(super) fn binding_for(\n    tenant: &Tenant,\n    line: VerifyLine,\n    workspace: Option<WorkspaceScope>,\n) -> SetupWarningBinding {\n    SetupWarningBinding {\n        version: 1,\n        line,\n        tsg_id: tenant.profile.tsg_id.clone().unwrap_or_default(),\n        origin: tenant.profile.destination.origin().to_owned(),\n        workspace: workspace.filter(|_| line == VerifyLine::Gateway).map(|w| {\n            SetupWarningWorkspace {\n                id: w.id,\n                slug: w.slug,\n                scope_name: w.scope_name,\n            }\n        }),\n    }\n}\n\n/// Reconstruct only known historical formatters. Never infer scope from an\n/// arbitrary substring or treat an unrelated healthy overview as evidence.\nfn missing_workspace(reason: &str) -> bool {\n    reason == \"No Gateway workspace in this tenant yet.\" || reason\n        .strip_suffix(\" Gateway workspace(s) readable; none chosen, so its prerequisites were not checked.\")\n        .and_then(|count| count.parse::<u32>().ok()).is_some_and(|count| count > 0)\n}\n\nfn basis(warning: &SetupWarning, current: &SetupWarningBinding) -> SetupWarningBasis {\n    let reason = warning\n        .reason\n        .strip_prefix(\"Failed: \")\n        .unwrap_or(&warning.reason);\n    if let Some(original) = &warning.check {\n        let same = original.version == 1\n            && original.line == current.line\n            && original.tsg_id == current.tsg_id\n            && original.origin == current.origin;\n        // A recorded scope is exact. The one explicit predicate exception is\n        // the known no-selection check: selecting a workspace and passing its\n        // full prerequisites supersedes that specific missing-selection fact.\n        let selected_now = current\n            .workspace\n            .as_ref()\n            .is_some_and(|w| !w.slug.is_empty() && !w.scope_name.is_empty());\n        let was_missing_selection = original.line == VerifyLine::Gateway\n            && original.workspace.is_none()\n            && selected_now\n            && missing_workspace(reason);\n        let workspace = original.workspace == current.workspace || was_missing_selection;\n        return if same && workspace {\n            SetupWarningBasis::RecordedScope\n        } else {\n            SetupWarningBasis::Unknown\n        };\n    }\n    match warning.product {\n        ProductId::RuntimeSecurity\n            if matches!(\n                reason,\n                \"No scan key saved; scans stay unavailable until one is added in Administration.\"\n                    | \"No scan key saved. Runtime Security needs one on first run.\"\n                    | \"No scan key configured; scanning stays unavailable until one is added in Settings.\"\n            ) =>\n        {\n            SetupWarningBasis::LegacyTenantSources\n        }\n        ProductId::ModelSkill\n            if matches!(\n                reason,\n                \"1 of 3 model and skill sources readable.\"\n                    | \"2 of 3 model and skill sources readable.\"\n            ) =>\n        {\n            SetupWarningBasis::LegacyTenantSources\n        }\n        ProductId::Gateway => {\n            let Some(workspace) = current.workspace.as_ref() else {\n                return SetupWarningBasis::Unknown;\n            };\n            if workspace.slug.is_empty() || workspace.scope_name.is_empty() {\n                return SetupWarningBasis::Unknown;\n            }\n            if missing_workspace(reason) {\n                return SetupWarningBasis::LegacyTenantSources;\n            }\n            let prefix = format!(\"Workspace {}: \", workspace.id);\n            let Some(detail) = reason.strip_prefix(&prefix) else {\n                return SetupWarningBasis::Unknown;\n            };\n            let detail = detail.strip_prefix(\"partial; \").unwrap_or(detail);\n            let expected = [\n                \"does not list the workspace\",\n                \"does not exist\",\n                \"may not be read by this client\",\n                \"could not be read\",\n            ]\n            .map(|suffix| format!(\"scope {} {suffix}\", workspace.scope_name));\n            if expected.iter().any(|expected| detail == expected) {\n                SetupWarningBasis::LegacyWorkspaceScope\n            } else {\n                SetupWarningBasis::Unknown\n            }\n        }\n        _ => SetupWarningBasis::Unknown,\n    }\n}\n\nimpl State {\n    fn warning_signature(\n        &self,\n        context: &ContextRef,\n        tenant: &Tenant,\n        binding: &SetupWarningBinding,\n    ) -> u64 {\n        let mut hash = DefaultHasher::new();\n        context.as_str().hash(&mut hash);\n        tenant.profile.id.as_str().hash(&mut hash);\n        binding.tsg_id.hash(&mut hash);\n        binding.origin.hash(&mut hash);\n        for class in [CredentialClass::Scan, CredentialClass::Management] {\n            match tenant.capability(class) {\n                ScanCapability::Ready { record, .. } => record.as_str().hash(&mut hash),\n                _ => \"not-ready\".hash(&mut hash),\n            }\n        }\n        tenant.management_client.hash(&mut hash);\n        if let Some(workspace) = &binding.workspace {\n            workspace.id.hash(&mut hash);\n            workspace.slug.hash(&mut hash);\n            workspace.scope_name.hash(&mut hash);\n        }\n        if binding.line == VerifyLine::Gateway {\n            self.gateway_selection()\n                .as_ref()\n                .map(|w| w.as_str())\n                .hash(&mut hash);\n        }\n        hash.finish()\n    }\n\n    pub(super) fn begin_warning_recheck(\n        &mut self,\n        context: &ContextRef,\n        warning: &str,\n        keychain: Arc<dyn super::CredentialStore>,\n        session: Arc<SessionVault>,\n    ) -> Result<(Option<OperationId>, Vec<Start>), Refusal> {\n        self.require_storage()?;\n        self.prune_warning_rechecks();\n        let id = self.check_context(context)?;\n        if self.is_setup_context(context) {\n            return Err(Refusal::InvalidInput);\n        }\n        if self\n            .warning_rechecks\n            .iter()\n            .any(|r| &r.context == context && r.warning == warning)\n        {\n            return Err(Refusal::Busy);\n        }\n        let tenant = self.tenant(&id).ok_or(Refusal::StaleContext)?;\n        let saved = tenant\n            .setup_warnings\n            .iter()\n            .find(|w| w.id == warning && w.resolved_secs.is_none())\n            .ok_or(Refusal::InvalidInput)?;\n        let line = saved\n            .check\n            .as_ref()\n            .map_or(line_for(saved.product), |b| b.line);\n        if line != line_for(saved.product)\n            && !(saved.product == ProductId::RuntimeSecurity\n                && line == VerifyLine::ManagementClient)\n        {\n            return Err(Refusal::InvalidInput);\n        }\n        let binding = binding_for(tenant, line, self.chosen_scope(context));\n        let signature = self.warning_signature(context, tenant, &binding);\n        let at = super::wall_secs(self.clock_offset);\n        let request = match line {\n            VerifyLine::ScanKey => {\n                let result = if matches!(tenant.scan, ScanCapability::Ready { .. }) {\n                    (VerifyState::Stored, \"Scan key configured. Its service validity is checked only when you submit a scan.\".to_owned())\n                } else {\n                    (\n                        VerifyState::Warning,\n                        \"No ready scan key configured; scanning stays unavailable.\".to_owned(),\n                    )\n                };\n                self.finish_warning_recheck(&id, warning, &binding, result, at);\n                return Ok((None, Vec::new()));\n            }\n            VerifyLine::ManagementClient => ManagementRequest::Verify,\n            VerifyLine::Gateway => {\n                let Some(workspace) = self\n                    .gateway_selection()\n                    .filter(|_| self.chosen_scope(context).is_some())\n                else {\n                    self.finish_warning_recheck(&id, warning, &binding, (VerifyState::Warning, \"Choose the relevant Gateway workspace in Administration before rechecking its setup.\".to_owned()), at);\n                    return Ok((None, Vec::new()));\n                };\n                ManagementRequest::Gateway {\n                    workspace: Some(workspace),\n                    read: GatewayRead::Prerequisites,\n                }\n            }\n            VerifyLine::RedTeam => ManagementRequest::RedTeam { window: 7 },\n            VerifyLine::ModelSkill => ManagementRequest::SupplyChain,\n            _ => return Err(Refusal::InvalidInput),\n        };\n        let (operation, starts) =\n            self.admit_management(context.clone(), request, keychain, session)?;\n        self.warning_rechecks.push(Recheck {\n            operation: operation.clone(),\n            context: context.clone(),\n            tenant: id,\n            warning: warning.to_owned(),\n            binding,\n            signature,\n            started_secs: at,\n        });\n        Ok((Some(operation), starts))\n    }\n\n    fn warning_recheck_current(&self, run: &Recheck) -> bool {\n        if self.active_ref.as_ref() != Some(&run.context)\n            || self.data.active.as_ref() != Some(&run.tenant)\n        {\n            return false;\n        }\n        let Some(tenant) = self.tenant(&run.tenant) else {\n            return false;\n        };\n        let current = binding_for(tenant, run.binding.line, self.chosen_scope(&run.context));\n        current == run.binding\n            && self.warning_signature(&run.context, tenant, &current) == run.signature\n    }\n\n    /// Lease invalidation cannot depend on a service ever replying. Keep\n    /// only checks still bound to the current context/credential/workspace.\n    pub(super) fn prune_warning_rechecks(&mut self) {\n        let retired = self\n            .warning_rechecks\n            .iter()\n            .filter(|r| !self.warning_recheck_current(r))\n            .map(|r| r.operation.clone())\n            .collect::<Vec<_>>();\n        self.warning_rechecks\n            .retain(|r| !retired.contains(&r.operation));\n        self.retire_warning_check_records(&retired);\n    }\n\n    pub(super) fn warning_recheck_operations(&self) -> Vec<OperationId> {\n        self.warning_rechecks\n            .iter()\n            .map(|r| r.operation.clone())\n            .collect()\n    }\n\n    pub(super) fn warning_recheck_settled(\n        &mut self,\n        operation: &OperationId,\n        result: &ManagementResult,\n    ) {\n        let Some(index) = self\n            .warning_rechecks\n            .iter()\n            .position(|r| &r.operation == operation)\n        else {\n            return;\n        };\n        let run = self.warning_rechecks.remove(index);\n        if self.active_ref.as_ref() != Some(&run.context)\n            || self.data.active.as_ref() != Some(&run.tenant)\n        {\n            return;\n        }\n        let Some(tenant) = self.tenant(&run.tenant) else {\n            return;\n        };\n        let binding = binding_for(tenant, run.binding.line, self.chosen_scope(&run.context));\n        if binding != run.binding\n            || self.warning_signature(&run.context, tenant, &binding) != run.signature\n        {\n            return;\n        }\n        let result = super::setup_domain::verify_result(binding.line, result);\n        self.finish_warning_recheck(\n            &run.tenant,\n            &run.warning,\n            &binding,\n            result,\n            super::wall_secs(self.clock_offset),\n        );\n    }\n\n    fn finish_warning_recheck(\n        &mut self,\n        tenant: &TenantId,\n        id: &str,\n        binding: &SetupWarningBinding,\n        (state, mut reason): (VerifyState, String),\n        at: u32,\n    ) {\n        let before = self.data.clone();\n        let Some(warning) = self\n            .data\n            .tenants\n            .iter_mut()\n            .find(|t| &t.profile.id == tenant)\n            .and_then(|t| {\n                t.setup_warnings\n                    .iter_mut()\n                    .find(|w| w.id == id && w.resolved_secs.is_none())\n            })\n        else {\n            return;\n        };\n        let basis = basis(warning, binding);\n        // A stored scan-key configuration is a tenant-local fact, including\n        // old scan-only profiles without a TSG. Remote checks still require it.\n        let equivalent = basis != SetupWarningBasis::Unknown\n            && (binding.line == VerifyLine::ScanKey || !binding.tsg_id.is_empty());\n        let passed = state == VerifyState::Pass\n            || (binding.line == VerifyLine::ScanKey && state == VerifyState::Stored);\n        if passed && !equivalent {\n            reason.push_str(\" The current check passed, but the original check scope cannot be established; its warning remains active.\");\n        }\n        if basis == SetupWarningBasis::LegacyTenantSources {\n            reason.push_str(\" Reconstructed from the known legacy setup check for this tenant; the original diagnostic is unchanged.\");\n        }\n        if basis == SetupWarningBasis::LegacyWorkspaceScope {\n            reason.push_str(\" Reconstructed from the legacy workspace UUID and scope name. The current listed slug was checked against IAM; the original slug was not recorded.\");\n        }\n        warning.recheck = Some(SetupWarningRecheck {\n            checked_secs: at,\n            state,\n            reason,\n            equivalent,\n            basis,\n        });\n        if passed\n            && equivalent\n            && binding.line == VerifyLine::Gateway\n            && warning\n                .check\n                .as_ref()\n                .is_some_and(|b| b.workspace.is_none())\n            && missing_workspace(&warning.reason)\n            && let Some(check) = &mut warning.recheck\n        {\n            check.reason.push_str(\" The original check found no selected workspace; the current selection's full setup prerequisites were checked.\");\n        }\n        if passed && equivalent {\n            warning.resolved_secs = Some(at);\n        }\n        if self.save_with(&before).is_err()\n            && let Some(warning) = self\n                .data\n                .tenants\n                .iter_mut()\n                .find(|t| &t.profile.id == tenant)\n                .and_then(|t| t.setup_warnings.iter_mut().find(|w| w.id == id))\n        {\n            warning.recheck = Some(SetupWarningRecheck { checked_secs: at, state: VerifyState::Fail,\n                    reason: \"The recheck result could not be saved; the original warning remains active. Try again when local storage is available.\".to_owned(), equivalent: false, basis: SetupWarningBasis::Unknown });\n        }\n    }\n\n    pub(super) fn warning_recheck_view(&self, mut view: TenantView) -> TenantView {\n        for warning in &mut view.setup_warnings {\n            if let Some(run) = self.warning_rechecks.iter().find(|r| {\n                r.tenant == view.id\n                    && r.warning == warning.id\n                    && self.active_ref.as_ref() == Some(&r.context)\n            }) {\n                warning.recheck = Some(SetupWarningRecheck {\n                    checked_secs: run.started_secs,\n                    state: VerifyState::Pending,\n                    reason: \"Rechecking the setup finding…\".to_owned(),\n                    equivalent: false,\n                    basis: SetupWarningBasis::Unknown,\n                });\n            }\n        }\n        view\n    }\n}\n\n#[cfg(test)]\nmod tests {\n    use super::*;\n\n    #[tokio::test]\n    async fn context_retirement_prunes_checks_without_waiting_for_a_management_reply() {\n        let (adapters, _) = crate::fixtures::adapters();\n        let core = crate::Core::new(crate::CoreConfig::default(), adapters);\n        let mut state = super::super::lock(&core.inner).unwrap();\n        let tenant = crate::tenants::TenantId::issue().unwrap();\n        state\n            .data\n           