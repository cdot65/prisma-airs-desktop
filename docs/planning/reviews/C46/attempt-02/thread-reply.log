 \"crates/desktop-core/tests/harness_tools/main.rs\": {\n      \"before_sha256\": \"ad88285ee7ae6b2e3ee1e7828565f50659423fd27483b10f3511eb81a18c287f\",\n      \"after_sha256\": \"7a72bcd6afd6a56edf20b04d1195794b32e0cda85d816f4bc886f99281584861\"\n    },\n    \"crates/desktop-core/tests/ui_v2_inbox/main.rs\": {\n      \"before_sha256\": \"0d19a3058ba5847fdec43860a53fb1454834bb867b398cd89331494ec8d3f443\",\n      \"after_sha256\": \"d746a8ad524e38502daa9dbb1ffb6d4368a4d9324fe4b6fd5ba11b471b4d2811\"\n    }\n  },\n  \"unchanged_runtime_and_locks\": {\n    \"crates/desktop-core/src/authority/setup_domain.rs\": \"6a52a4c1e2e0567990c0efaae36348848bd85e84991d525b479d9ac8d299050d\",\n    \"crates/desktop-core/Cargo.toml\": \"c61aab70870501455a80bc418447408b3e78eb59d50490ba23d2b68f5858ef01\",\n    \"Cargo.lock\": \"513de038ab408300d06721d75a2390d94c76312520505c82c6693eecace163c4\",\n    \"rust-toolchain.toml\": \"3ac87df98c6720396dac364b4b94273e9261ee2b1a971af6c43e0a714efa84cd\"\n  },\n  \"raw_alias_index\": {\n    \"path\": \"docs/planning/evidence/P11/c46-consumer-remediation-01/alias-index.json\",\n    \"sha256\": \"731494f6137f878e89b8181ed602a84513eb80c35b238adfcd55889be0d3df06\"\n  },\n  \"original_summary\": {\n    \"path\": \"docs/planning/evidence/P11/c46-consumer-remediation-01/summary.json\",\n    \"sha256\": \"11156891511ddecc4b46431ba439911d340059cf3ce0211a10db31d5bbd7bcb0\"\n  },\n  \"observed_outcome\": {\n    \"selected_unique_passed\": 9,\n    \"selected_unique_failed\": 0,\n    \"selected_ignored\": 0\n  },\n  \"red_failures_retained\": true,\n  \"recorder_error_retained\": true,\n  \"raw_records_rewritten\": false,\n  \"application_source_edited\": false,\n  \"application_rebuilt\": false,\n  \"native_rerun\": false\n}\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_29","type":"command_execution","command":"/bin/zsh -lc \"sed -n '1,78p' tools/p09/phase_packet.py; sed -n '735,827p' tools/p11/proof.py; sed -n '1,140p' tools/p10/qualification.py; sed -n '1,116p' tools/p11/standing.py; cat docs/planning/evidence/P11/c46-consumer-remediation-01/green-harness-02.log docs/planning/evidence/P11/c46-consumer-remediation-01/green-inbox-01.log docs/planning/evidence/P11/c46-consumer-remediation-01/clippy-affected-tests.log\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_29","type":"command_execution","command":"/bin/zsh -lc \"sed -n '1,78p' tools/p09/phase_packet.py; sed -n '735,827p' tools/p11/proof.py; sed -n '1,140p' tools/p10/qualification.py; sed -n '1,116p' tools/p11/standing.py; cat docs/planning/evidence/P11/c46-consumer-remediation-01/green-harness-02.log docs/planning/evidence/P11/c46-consumer-remediation-01/green-inbox-01.log docs/planning/evidence/P11/c46-consumer-remediation-01/clippy-affected-tests.log\"","aggregated_output":"\"\"\"Current P09 packet and post-review audit; independent review remains external.\"\"\"\nfrom pathlib import Path\nimport argparse\nimport hashlib\nimport json\nimport os\nimport stat\nimport subprocess\nimport time\n\nimport phase_inputs as inputs\n\nPREVIOUS_PHASE = '6a7253c2'\n\n\ndef digest(value):\n    return hashlib.sha256((json.dumps(value, sort_keys=True, separators=(',', ':')) + '\\n').encode()).hexdigest()\n\n\ndef file_identity(path):\n    metadata = path.lstat()\n    value = {'mode': stat.S_IMODE(metadata.st_mode)}\n    if path.is_symlink():\n        value.update(kind='symlink', target=os.readlink(path))\n    else:\n        inputs.require(path.is_file(), 'unsupported source kind: ' + str(path))\n        value.update(kind='file', sha256=inputs.sha(path))\n    return value\n\n\ndef source_inventory(root):\n    names = subprocess.check_output(['git', 'ls-files', '-z', '--cached', '--others', '--exclude-standard'], cwd=root).decode().split('\\0')\n    excluded = ('docs/planning/evidence/', 'docs/planning/reviews/')\n    def active_tool(name):\n        return ((name.startswith('docs/planning/evidence/P09/native-controller/') and name.endswith('.py'))\n                or name in ['docs/planning/evidence/P09/runs/hash-inputs.sh', 'docs/planning/evidence/P09/runs/run-checks.sh'])\n    return {name: file_identity(root / name) for name in sorted(set(names))\n            if name and name != 'docs/planning/status.md' and (not name.startswith(excluded) or active_tool(name))\n            and ((root / name).exists() or (root / name).is_symlink())}\n\n\ndef live_evidence(root):\n    path = root / 'docs/planning/evidence/C29/live/L19-verify.json'\n    live = inputs.read(path)\n    inputs.require(live['status'] == 'pass' and live['temporary_local_credentials_removed'], 'L19 pass/cleanup missing')\n    inputs.require(live['budget']['total_reserved'] == 3 and live['budget']['refunded'] == 0, 'L19 charged budget changed')\n    receipt = root / live['native_receipt']\n    inputs.require(inputs.sha(receipt) == live['native_receipt_sha256'], 'L19 receipt hash mismatch')\n    raw = inputs.read(receipt)\n    inputs.require(raw['status'] == 'pass' and raw['local_credentials_removed'], 'L19 actual receipt not passing/cleaned')\n    archived = root / 'docs/planning/evidence/C29/live/L19/build-02/l19-qualification-executable.bin'\n    inputs.require(inputs.sha(archived) == raw['executable_sha256'], 'L19 historical executable mismatch')\n    return {'record': str(path.relative_to(root)), 'sha256': inputs.sha(path),\n            'native_receipt': str(receipt.relative_to(root)), 'native_receipt_sha256': inputs.sha(receipt),\n            'qualification_executable': str(archived.relative_to(root)), 'qualification_executable_sha256': inputs.sha(archived),\n            'live_calls_performed_by_this_verifier': 0, 'remaining_live_allowance': 0}\n\n\ndef evidence_inventory(root, run_path, verified):\n    files = set()\n    phase = root / 'docs/planning/evidence/P09'\n    prefixes = [phase / 'native', phase / 'parity', phase / 'screens', phase / 'preparations', phase / 'check-remediation', phase / 'performance', phase / 'phase-tooling-history', phase / 'phase-tooling-validation', run_path.parent / inputs.read(run_path)['attempt'],\n                root / 'docs/planning/evidence/C29/live/L19']\n    prefixes += list((phase / 'native-history').glob('*Worf*'))\n    for prefix in prefixes:\n        files.update(p for p in prefix.rglob('*') if p.is_file() and '__pycache__' not in p.parts)\n    files.update(phase / name for name in ['native-prepare.json', 'native-acceptance.json', 'execution.json'])\n    files.add(phase / 'native-build-inputs.json')\n    files.add(phase / 'workload-perf-C30.json')\n    files.add(run_path)\n    files.add(root / 'docs/planning/evidence/C29/live/L19-verify.json')\n    files.add(root / 'docs/planning/reviews/C44/legacy-retirements.md')\n    for member in verified['predecessors']:\n        for key in ['record', 'request', 'receipt', 'audit', 'owner_decision']:\n            if key in member:\n                files.add(root / member[key])\n        if 'record' in member:\n            directory = (root / member['record']).parent\ndef verify(root, path):\n    record = read(path)\n    require(record['schema'] == 'airs-desktop/p11-shared-qualification/1', 'P11 proof schema')\n    require(set(record['runner_inputs']) == {'source', 'dependencies', 'build_flags'},\n            'P11 runner input keys differ')\n    require(record['runner_inputs']['source'] == xtask_source(root),\n            'current source does not match actual runner source fingerprint')\n    seal = read(bound(root, record['source']))\n    require(source_inventory(root) == seal['files'], 'P11 source changed after qualification')\n    qualified = read(bound(root, record['coverage']))\n    require(digest(seal['files']) == qualified['source_inventory_sha256'], 'P11 source binding')\n    if 'review_remediation' in record:\n        require(qualified.get('review_remediation') == record['review_remediation'],\n                'review remediation qualification binding differs')\n    elif 'helper_source_carry' in record:\n        validate_helper_source_carry(root, bound(root, record['helper_source_carry']), record['runner_inputs'])\n    elif 'impact_selection' in record:\n        validate_impact_selection(root, bound(root, record['impact_selection']), record['runner_inputs'])\n    else:\n        for kind in ('check', 'test'):\n            validate_run(root, bound(root, record['runs'][kind]), kind, record['runner_inputs'])\n    inputs = read(bound(root, record['fingerprint']))\n    require(record['runner_inputs'] == {key: inputs[key] for key in record['runner_inputs']},\n            'P11 observed current fingerprint mismatch')\n    current = current_fingerprints(root)\n    require(record['runner_inputs'] == {key: current[key] for key in record['runner_inputs']},\n            'current dependency/toolchain/build flags differ from executed checks')\n    result = verify_coverage(root, qualified)\n    candidate = read(bound(root, qualified['candidate']))\n    from candidate import verify_candidate\n    verify_candidate(root, candidate)\n    performed = read(bound(root, record['native_execution']))\n    if 'review_remediation' in record:\n        remedy = read(bound(root, record['review_remediation']))\n        recovery = read(bound(root, remedy['recovery']))\n        require(record['native_execution'] == recovery['raw']\n                and candidate['helper_closure'] == recovery['helper_closure'],\n                'affected recovery helper/execution membership changed')\n    else:\n        require(candidate['helper_closure'] == helper_closure(root, native_driver(root, performed)),\n                'P11 native helper membership changed')\n        validate_execution(root, performed, candidate,\n            acceptance=bound(root, record['native_acceptance']) if 'native_acceptance' in record else None,\n            execution=bound(root, record['native_execution']))\n    build_path = bound(root, record['build'])\n    build = read(build_path)\n    require(build['application_inputs_unchanged'] is True\n            and all(step['exit_code'] == 0 for step in build['steps']), 'fixture build failed/drifted')\n    if 'review_remediation' in record:\n        import remediation\n        remediation.versioned_build(root, build, candidate)\n    else:\n        require([step['argv'] for step in build['steps']] == [\n            ['pnpm', '--filter', '@prisma-airs/desktop-contracts', 'typecheck'],\n            ['pnpm', '--filter', '@prisma-airs/desktop', 'typecheck'],\n            ['cargo', 'run', '--locked', '-p', 'xtask', '--', 'native-prepare', '--phase', 'P11',\n             '--target', 'aarch64-apple-darwin', '--features', 'test-fixtures']],\n            'missing or changed fixture build invocation')\n    require(set(build['application_inputs_before']) == application_files(root),\n            'built application input membership differs or is incomplete')\n    require(read(build_path.parent / 'native-prepare.json') == read(bound(root, candidate['prepare'])),\n            'prepared candidate differs from retained actual build output')\n    for step in build['steps']:\n        log = (build_path.parent / step['log']).resolve()\n        require(log.is_relative_to(root.resolve()) and sha(log) == step['log_sha256'],\n                'fixture build log drift')\n    changed = [name for name, value in build['application_inputs_before'].items()\n               if sha(root / name) != value]\n    if changed:\n        carry_schema = read(bound(root, record['build_input_carry']))['schema']\n        if carry_schema == 'airs-desktop/rust-test-build-carry/1':\n            rust_test_carry(root, record, build_path, build, candidate, changed)\n        else:\n            frontend_test_carry(root, record, build_path, build, candidate, changed)\n    else:\n        require('build_input_carry' not in record, 'unnecessary or stale build carry')\n    baseline = read(bound(root, record['historical_baseline']))\n    require(record['historical_baseline']['path'] == 'docs/planning/evidence/P10/completion-proof.json'\n            and baseline['schema'] == 'airs-desktop/p10-completion-proof/1', 'missing accepted baseline')\n    from review_gate import release_prerequisites\n    require(record['historical_standing'] == release_prerequisites(root),\n            'actual historical standing drift')\n    return {'record': str(path.relative_to(root)), 'sha256': sha(path),\n            'verified': result, 'candidate_sha256': qualified['candidate']['sha256'],\n            'controller_complete': False}\n\n\ndef make(root, check, tests, fingerprint, prepare, native, execution, build, out,\n         carry=None, impact=None, helper_carry=None):\n    \"\"\"Bind existing executions; never create a passing raw run or verdict.\"\"\"\n    require(not out.exists(), 'preserve previous P11 qualification')\n    require((root / 'tools/native-acceptance/acceptance_p11.py').is_file(),\n            'P11 native driver missing')\n\"\"\"Explicit C45/P10 evidence accounting. Does not execute checks or assign scores.\n\nThe existing runners produce raw records; this consumer rejects omitted coverage,\nchanged evidence, unsupported retirement and affected checks carried as unchanged.\nHistorical results always retain their original candidate and execution bindings.\n\"\"\"\nfrom pathlib import Path\nimport hashlib\nimport json\n\n\ndef require(value, message):\n    if not value:\n        raise ValueError(message)\n\n\ndef read(path):\n    return json.loads(Path(path).read_text())\n\n\ndef sha(path):\n    return hashlib.sha256(Path(path).read_bytes()).hexdigest()\n\n\ndef digest(value):\n    return hashlib.sha256((json.dumps(value, sort_keys=True, separators=(\",\", \":\")) + \"\\n\").encode()).hexdigest()\n\n\ndef bound(root, reference):\n    path = root / reference[\"path\"]\n    require(path.resolve().is_relative_to(root.resolve()), \"evidence escapes checkout\")\n    require(sha(path) == reference[\"sha256\"], \"evidence hash drift: \" + str(path))\n    return path\n\n\nEXACT_FIELDS = (\"executable_sha256\", \"bundle_sha256\", \"build_flags\", \"conditions\")\n\n\ndef verify_raw(root, needed, execution, origin):\n    require(execution[\"argv\"] == needed[\"argv\"], \"execution command differs from approved plan\")\n    require(execution[\"cwd\"] == origin[\"execution_root\"], \"execution cwd differs from original candidate\")\n    raw_path = bound(root, execution[\"raw\"])\n    raw = read(raw_path)\n    if needed[\"kind\"] == \"native\":\n        require(raw[\"schema\"] == \"airs-v2/native-acceptance/1\" and raw[\"app\"][\"executable_sha256\"] == origin[\"executable_sha256\"], \"raw native candidate mismatch\")\n        checks = [check for check in raw[\"checks\"] if check[\"id\"] == needed[\"id\"]]\n        require(len(checks) == 1 and checks[0][\"result\"] == \"pass\" and checks[0].get(\"observation\") and checks[0].get(\"evidence\"), \"raw native assertion not passing\")\n        for name in checks[0][\"evidence\"]:\n            require(name in execution[\"evidence\"], \"native evidence missing from execution inventory\")\n            bound(root, {\"path\":name,\"sha256\":execution[\"evidence\"][name]})\n    elif needed[\"kind\"] == \"command\":\n        require(raw[\"schema\"] == \"airs-v2/run/1\" and raw[\"status\"] == \"passed\" and raw[\"failure\"] is None and raw[\"inputs_before\"] == raw[\"inputs_after\"], \"raw runner failed or inputs changed\")\n        require(raw[\"inputs_before\"] == origin[\"runner_inputs\"], \"runner input fingerprint does not bind original candidate\")\n        commands = [command for command in raw[\"commands\"] if command[\"label\"] == needed[\"label\"]]\n        require(len(commands) == 1, \"raw runner command missing/duplicated\")\n        command = commands[0]\n        require(command[\"status\"] == \"passed\" and command[\"exit_code\"] == 0 and command[\"argv\"] == needed[\"argv\"] and command[\"cwd\"] in [\".\", origin[\"execution_root\"]] and not command[\"note\"], \"raw runner command failed/differs\")\n        require(command[\"output_sha256\"] == execution[\"log\"][\"sha256\"] and str((raw_path.parent/command[\"log\"]).relative_to(root)) == execution[\"log\"][\"path\"], \"raw runner log binding\")\n        if needed.get(\"expects_tests\"):\n            require(command[\"tests\"] and command[\"tests\"][\"passed\"] > 0 and command[\"tests\"][\"failed\"] == 0, \"test command did not execute passing tests\")\n    else:\n        raise ValueError(\"unsupported required raw execution kind\")\n\n\ndef verify(root, record, historical=None):\n    require(record[\"schema\"] == \"airs-desktop/qualified-coverage/1\", \"coverage schema\")\n    plan = read(bound(root, record[\"plan\"]))\n    require(plan[\"schema\"] == \"airs-desktop/required-coverage/1\", \"plan schema\")\n    requirements = plan[\"requirements\"]\n    ids = [item[\"id\"] for item in requirements]\n    require(len(ids) == len(set(ids)) and ids, \"duplicate/empty required coverage\")\n    rows = record[\"coverage\"]\n    require(len(rows) == len(ids) and {r[\"id\"] for r in rows} == set(ids), \"missing/duplicate/unknown coverage\")\n    by_id = {item[\"id\"]: item for item in requirements}\n    candidate = read(bound(root, record[\"candidate\"]))\n    require(all(candidate.get(k) for k in EXACT_FIELDS) and candidate.get(\"helper_closure\"), \"candidate binding incomplete\")\n    require(candidate.get(\"source_inventory_sha256\") == record[\"source_inventory_sha256\"], \"candidate source binding\")\n    for row in rows:\n        needed = by_id[row[\"id\"]]\n        mode = row[\"disposition\"]\n        require(mode in [\"executed\", \"reused_exact\", \"carried_unaffected\", \"not_applicable\"], \"unsupported coverage disposition\")\n        if mode == \"not_applicable\":\n            decision = needed.get(\"retirement\")\n            require(decision and row.get(\"reason\") and row.get(\"decision\") == decision, \"unapproved assertion retirement\")\n            bound(root, decision)\n            continue\n        original = read(bound(root, row[\"result\"]))\n        require(original.get(\"status\") == \"pass\" and original.get(\"exit_code\") == 0, \"result is not an actual passing execution\")\n        require(original.get(\"execution_id\") and original.get(\"argv\") and original.get(\"cwd\") and original.get(\"started_utc\") and original.get(\"finished_utc\"), \"execution provenance missing\")\n        require(row[\"id\"] in original.get(\"required_ids\", []), \"result does not cover required assertion\")\n        bound(root, original[\"log\"])\n        origin = read(bound(root, original[\"candidate\"]))\n        require(all(origin.get(k) for k in EXACT_FIELDS) and origin.get(\"helper_closure\"), \"original candidate binding incomplete\")\n        verify_raw(root, needed, original, origin)\n        if mode in [\"executed\", \"reused_exact\"]:\n            if mode == \"reused_exact\":\n                require(not needed.get(\"must_execute\", needed.get(\"affected\", True)), \"changed check must execute\")\n            helpers = needed.get(\"helper_paths\")\n            if helpers is None:\n                require(origin[\"helper_closure\"] == candidate[\"helper_closure\"], \"relevant helper closure differs\")\n            else:\n                require(all(name in origin[\"helper_closure\"] and name in candidate[\"helper_closure\"] and origin[\"helper_closure\"][name] == candidate[\"helper_closure\"][name] for name in helpers), \"relevant helper closure differs\")\n            require(all(origin[k] == candidate[k] for k in EXACT_FIELDS), \"artifact/helper/flags/conditions differ\")\n            if mode == \"executed\":\n                require(origin[\"source_inventory_sha256\"] == record[\"source_inventory_sha256\"], \"execution is historical, not current\")\n        else:\n            require(not needed.get(\"affected\", True), \"affected check cannot be carried unchanged\")\n            rationale = row.get(\"impact\")\n            require(rationale and rationale.get(\"reason\") and rationale.get(\"dependencies\") == needed.get(\"dependencies\") and rationale.get(\"original_candidate_sha256\") == original[\"candidate\"][\"sha256\"], \"unchanged-impact proof missing\")\n            proof = read(bound(root, rationale[\"proof\"]))\n            bindings = proof.get(\"file_bindings\", {})\n            require(set(bindings) == set(needed[\"dependencies\"]) and bindings, \"dependency membership proof missing\")\n            current_files=historical.source(record['source_inventory_sha256']) if historical else root\n            original_files=historical.source(origin['source_inventory_sha256']) if historical else root\n            for dependency, binding in bindings.items():\n                require(binding[\"original_sha256\"] == binding[\"current_sha256\"] == sha(current_files/dependency), \"dependency changed: \" + dependency)\n                original_source = original_files/dependency if historical else bound(root, binding[\"original_file\"])\n                require(sha(original_source) == binding[\"original_sha256\"], \"original dependency proof mismatch\")\n            require(proof.get(\"unchanged_dependencies\") == needed[\"dependencies\"] and proof.get(\"current_source_inventory_sha256\") == record[\"source_inventory_sha256\"] and proof.get(\"original_candidate_sha256\") == original[\"candidate\"][\"sha256\"], \"impact proof does not bind current and original inputs\")\n    return {\"qualified\": True, \"required\": len(ids), \"dispositions\": {m: sum(r[\"disposition\"] == m for r in rows) for m in sorted({r[\"disposition\"] for r in rows})}, \"candidate_sha256\": record[\"candidate\"][\"sha256\"], \"source_inventory_sha256\": record[\"source_inventory_sha256\"]}\n\"\"\"Durable, audited P11 standing for later production promotion.\n\nFinalization consumes completed executions and five real full-9 reviews. It\nnever assigns a score or completes a controller ledger. Historical validation\nuses the archived source/application, not this checkout's ignored target tree,\ninstalled application, toolchain, hostname, or current application source.\n\"\"\"\nfrom pathlib import Path\nimport json\nimport shutil\nimport subprocess\nimport sys\n\nsys.path.insert(0, str(Path(__file__).resolve().parent))\nsys.path.insert(0, str(Path(__file__).resolve().parents[1] / 'p10'))\nfrom candidate import bundle_hash, digest, file_identity\nfrom historical import Historical\nfrom qualification import bound, read, require, sha, verify as verify_coverage\nfrom review_gate import actual_review, release_prerequisites\n\nCHUNKS = ('C46', 'C47', 'C48', 'C49')\nSUBJECTS = (*CHUNKS, 'P11')\nBASE = Path('docs/planning/evidence/P11')\nACCEPTED = BASE / 'accepted'\nCOMPLETION = BASE / 'completion-proof.json'\nD2_SOURCE = BASE / 'source-history/D2'\nS2_SOURCE = BASE / 'source-history/S2'\nS3_SOURCE = BASE / 'source-history/S3'\nLFS_PATHS = (str(S3_SOURCE / 'resources/harness/darwin-arm64.tar.gz'),\n             str(S2_SOURCE / 'resources/harness/darwin-arm64.tar.gz'),\n             str(D2_SOURCE / 'resources/harness/darwin-arm64.tar.gz'),\n             str(ACCEPTED / 'application/Contents/MacOS/prisma-airs-desktop'),\n             str(ACCEPTED / 'application/Contents/Resources/harness/airs-harness'),\n             str(ACCEPTED / 'source/resources/harness/darwin-arm64.tar.gz'))\n\n\nclass ArchivedP11(Historical):\n    \"\"\"Explicit P11 archive context; historical C45 behavior is untouched.\"\"\"\n    def archive_path(self, name):\n        path = self.root / name\n        require(path.resolve().is_relative_to((self.root / ACCEPTED).resolve())\n                or path.resolve() in ((self.root / D2_SOURCE).resolve(), (self.root / S2_SOURCE).resolve(), (self.root / S3_SOURCE).resolve()),\n                'historical archive escapes accepted P11 evidence')\n        return path\n\n\ndef reference(root, path):\n    root = Path(root).resolve()\n    path = Path(path).resolve(strict=True)\n    require(path.is_relative_to(root.resolve()), 'P11 reference escapes checkout')\n    return {'path': str(path.relative_to(root)), 'sha256': sha(path)}\n\n\ndef identities(root, paths):\n    return {str(path.relative_to(root)): file_identity(path) for path in sorted(set(paths))}\n\n\ndef evidence_files(root, attempts):\n    paths = [p for p in (root / BASE).rglob('*')\n             if (p.is_file() or p.is_symlink()) and not p.is_relative_to(root / ACCEPTED)\n             and p != root / COMPLETION and '__pycache__' not in p.parts]\n    for subject, attempt in attempts.items():\n        paths.extend(p for p in (root / 'docs/planning/reviews' / subject / attempt).rglob('*')\n                     if (p.is_file() or p.is_symlink()) and '__pycache__' not in p.parts)\n    return paths\n\n\ndef latest_attempt(root, subject):\n    attempts = [p.name for p in (root / 'docs/planning/reviews' / subject).glob('attempt-*')\n                if p.is_dir() and p.name.removeprefix('attempt-').isdigit()]\n    require(attempts, 'missing actual P11 member/phase review: ' + subject)\n    return max(attempts, key=lambda name: int(name.removeprefix('attempt-')))\n\n\ndef require_archive_lfs(root):\n    result = subprocess.run(['/usr/bin/git', 'check-attr', '-z', 'filter', '--', *LFS_PATHS],\n                            cwd=root, capture_output=True, check=True)\n    fields = result.stdout.decode().strip('\\0').split('\\0')\n    require(len(fields) == len(LFS_PATHS) * 3\n            and all(fields[i:i+3] == [name, 'filter', 'lfs'] for i, name in zip(range(0, len(fields), 3), LFS_PATHS)),\n            'configure reviewed P11 archive Git LFS paths before finalization')\n\n\ndef audited_reviews(root, attempts, qualified, source):\n    root = Path(root).resolve()\n    require(set(attempts) == set(SUBJECTS), 'P11 requires exactly four member reviews and its phase review')\n    reviews = {}\n    for subject in SUBJECTS:\n        attempt = attempts[subject]\n        require(attempt == latest_attempt(root, subject), 'newer review attempt exists: ' + subject)\n        request = read(root / 'docs/planning/reviews' / subject / attempt / 'request.json')\n        require(request['qualification'] == qualified,\n                'P11 reviews do not bind one shared qualification: ' + subject)\n        reviews[subject] = actual_review(root, subject, attempt, source_root=source)\n        require(all(value >= 9 for value in reviews[subject]['scores'].values()),\n                'P11 promotion requires full-9 reviewed standing: ' + subject)\n    phase = read(root / 'docs/planning/reviews/P11' / attempts['P11'] / 'request.json')\n    require(phase['predecessors']['members'] == {name: reviews[name] for name in CHUNKS},\n            'phase review did not consume these exact four audited member reviews')\n    require(all(row['fingerprints']['source'] == qualified['verified']['source_inventory_sha256']\n                for row in reviews.values()), 'reviews bind a foreign qualified source')\n    return reviews\n\n\ndef verify(root):\n    \"\"\"Verify immutable historical standing; no current build directory needed.\"\"\"\n    root = Path(root).resolve()\n    path = root / COMPLETION\n    require(path.is_file(), 'P11 promotion requires actual accepted standing: ' + str(COMPLETION))\n    record = read(path)\n    require(record['schema'] == 'airs-desktop/p11-completion-proof/1'\n            and record['controller_complete'] is False, 'P11 standing schema/controller claim')\n    require(record['context']['path'] == str(ACCEPTED / 'historical-context.json'),\n            'P11 standing context is foreign')\n    history = ArchivedP11(root, record['context'])\n    qualified = record['qualification']\n    Finished `test` profile [unoptimized + debuginfo] target(s) in 0.08s\n     Running tests/harness_tools/main.rs (/Users/cdot/development/redtail/p09-queue/refinement-20261104/tooling/targets/core/debug/deps/harness_tools-1cfe990d1c656c6d)\n\nrunning 3 tests\ntest completing_a_tenant_setup_is_the_guarded_switch_path ... ok\ntest setup_archive_resolution_save_failure_preserves_pending_work ... ok\ntest setup_discard_resolution_save_failure_preserves_pending_work ... ok\n\ntest result: ok. 3 passed; 0 failed; 0 ignored; 0 measured; 19 filtered out; finished in 2.06s\n\n   Compiling desktop-core v1.0.0 (/Users/cdot/development/redtail/p09-queue/refinement-20261104/core/crates/desktop-core)\n    Finished `test` profile [unoptimized + debuginfo] target(s) in 1.37s\n     Running tests/ui_v2_inbox/main.rs (/Users/cdot/development/redtail/p09-queue/refinement-20261104/tooling/targets/core/debug/deps/ui_v2_inbox-f1bdfe8188a53264)\n\nrunning 6 tests\ntest a_first_product_recheck_refused_for_a_role_is_a_settled_attempt ... ok\ntest setup_warnings_are_inbox_entries_the_operator_can_hold_across_reads ... ok\ntest a_truncated_listing_is_incomplete_coverage_not_a_complete_read ... ok\ntest reads_cover_every_chosen_product_with_finite_per_source_outcomes ... ok\ntest unread_chosen_products_stay_in_coverage_after_a_partial_attempt ... ok\ntest a_failed_product_attempt_is_reported_and_never_replaces_its_last_read ... ok\n\ntest result: ok. 6 passed; 0 failed; 0 ignored; 0 measured; 11 filtered out; finished in 0.17s\n\n    Checking tokio v1.53.3\n    Checking tokio-util v0.7.20\n    Checking async-compression v0.4.51\n    Checking tokio-rustls v0.26.6\n    Checking tower v0.5.3\n    Checking h2 v0.4.20\n    Checking tower-http v0.6.11\n    Checking scm-sdk v0.2.4\n    Checking hyper v1.12.0\n    Checking hyper-util v0.1.21\n    Checking hyper-rustls v0.27.10\n    Checking reqwest v0.13.5\n    Checking desktop-core v1.0.0 (/Users/cdot/development/redtail/p09-queue/refinement-20261104/core/crates/desktop-core)\n    Finished `dev` profile [unoptimized + debuginfo] target(s) in 23.65s\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_30","type":"command_execution","command":"/bin/zsh -lc \"python3 -B -c 'import sys,json; from pathlib import Path; sys.path.insert(0,\\\"tools/p11\\\"); import proof; from candidate import verify_candidate; root=Path.cwd().resolve(); base=root/\\\"docs/planning/reviews/C46/attempt-02\\\"; req=proof.read(base/\\\"request.json\\\"); print(\\\"inventory digests\\\",{n:proof.digest(proof.read(base/(n+\\\"-inventory.json\\\"))[\\\"files\\\"])==req[\\\"fingerprints\\\"][n] for n in (\\\"source\\\",\\\"evidence\\\")}); q=proof.read(root/req[\\\"qualification\\\"][\\\"record\\\"]); c=proof.read(proof.bound(root,q[\\\"coverage\\\"])); print(\\\"source fingerprint\\\",proof.xtask_source(root)==q[\\\"runner_inputs\\\"][\\\"source\\\"]); print(\\\"coverage\\\",json.dumps(proof.verify_coverage(root,c))); candidate=proof.read(proof.bound(root,c[\\\"candidate\\\"])); print(\\\"bundle\\\",json.dumps({k:verify_candidate(root,candidate)[k] for k in (\\\"executable_sha256\\\",\\\"bundle_sha256\\\")}))'\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.started","item":{"id":"item_31","type":"command_execution","command":"/bin/zsh -lc \"sed -n '970,1200p' crates/desktop-core/tests/ui_v2_setup_reads/main.rs; sed -n '237,430p' crates/desktop-core/tests/setup_warning_recheck.rs\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_31","type":"command_execution","command":"/bin/zsh -lc \"sed -n '970,1200p' crates/desktop-core/tests/ui_v2_setup_reads/main.rs; sed -n '237,430p' crates/desktop-core/tests/setup_warning_recheck.rs\"","aggregated_output":"\n// Owner refinement: management authentication gates every new tenant; a\n// product permission is a separate observation and scan keys remain optional.\n#[tokio::test]\nasync fn refinement_oauth_authentication_does_not_require_profile_permission() {\n    let mut desk = desk().await;\n    desk.script.lock().expect(\"script\").routes.insert(\n        format!(\"/aisec/v1/mgmt/profiles/tsg/{TSG}\"),\n        (403, json!({\"error\": \"profile permission denied\"})),\n    );\n    desk.send(\n        json!({\"kind\": \"beginTenantSetup\", \"mode\": \"firstRun\", \"profile\": {\n            \"label\": \"OAuth only\", \"tsgId\": TSG,\n            \"destination\": {\"kind\": \"region\", \"region\": \"europe\"}\n        }}),\n    )\n    .await\n    .expect(\"draft\");\n    let context = desk.draft_context();\n    desk.send(\n        json!({\"kind\": \"configureManagementCredential\", \"context\": context,\n            \"mode\": \"keychain\", \"clientId\": CLIENT_ID, \"secret\": CLIENT_SECRET\n        }),\n    )\n    .await\n    .expect(\"management credential\");\n    assert!(eventually(|| desk.setup().tenant.management.state == ScanState::Ready).await);\n    let context = desk.draft_context();\n    desk.send(json!({\"kind\": \"verifyTenantSetup\", \"context\": context}))\n        .await\n        .expect(\"verify\");\n    let verify = desk.verified().await;\n    let auth = verify\n        .steps\n        .iter()\n        .find(|s| s.line == VerifyLine::ManagementClient)\n        .expect(\"auth line\");\n    assert_eq!(\n        auth.state,\n        VerifyState::Pass,\n        \"OAuth succeeds independently of Runtime profile permission: {}\",\n        auth.reason\n    );\n    assert!(\n        !verify.blocking && desk.setup().completable,\n        \"a missing scan key does not block authenticated first-run\"\n    );\n    assert!(!desk.setup().scan_required);\n    assert!(\n        desk._server\n            .seen()\n            .iter()\n            .all(|request| !request.request_line.contains(\"/profiles/\")),\n        \"authentication must not inventory Runtime profiles\"\n    );\n    desk.send(json!({\"kind\": \"completeTenantSetup\", \"context\": context, \"packs\": []}))\n        .await\n        .expect(\"complete\");\n    let snapshot = desk.snap();\n    assert_eq!(snapshot.tenants.len(), 1);\n    assert_eq!(snapshot.tenants[0].scan.state, ScanState::Missing);\n    assert_eq!(\n        snapshot.onboarding,\n        desktop_core::features::OnboardingState::Done\n    );\n}\n\n#[tokio::test]\nasync fn refinement_missing_oauth_cannot_complete_an_add_draft() {\n    let mut desk = desk().await;\n    desk.send(\n        json!({\"kind\": \"beginTenantSetup\", \"mode\": \"add\", \"profile\": {\n            \"label\": \"No OAuth\", \"tsgId\": TSG,\n            \"destination\": {\"kind\": \"region\", \"region\": \"europe\"}\n        }}),\n    )\n    .await\n    .expect(\"draft\");\n    let context = desk.draft_context();\n    desk.send(json!({\"kind\": \"verifyTenantSetup\", \"context\": context}))\n        .await\n        .expect(\"verify\");\n    let verify = desk.verified().await;\n    assert!(\n        verify.blocking && !desk.setup().completable,\n        \"missing management OAuth must block Add as well as first-run\"\n    );\n    assert_eq!(\n        desk.send(json!({\"kind\": \"completeTenantSetup\", \"context\": context, \"packs\": []}))\n            .await,\n        Err(Refusal::InvalidInput)\n    );\n    assert!(desk.snap().tenants.is_empty());\n    assert!(\n        desk._server.seen().is_empty(),\n        \"missing credentials initiate no network call\"\n    );\n}\n\n#[tokio::test]\nasync fn refinement_invalid_oauth_cannot_complete_an_add_draft() {\n    let mut desk = desk().await;\n    desk.script.lock().expect(\"script\").token_status = 401;\n    desk.send(\n        json!({\"kind\": \"beginTenantSetup\", \"mode\": \"add\", \"profile\": {\n            \"label\": \"Invalid OAuth\", \"tsgId\": TSG,\n            \"destination\": {\"kind\": \"region\", \"region\": \"europe\"}\n        }}),\n    )\n    .await\n    .expect(\"draft\");\n    let context = desk.draft_context();\n    desk.send(\n        json!({\"kind\": \"configureManagementCredential\", \"context\": context,\n            \"mode\": \"keychain\", \"clientId\": CLIENT_ID, \"secret\": CLIENT_SECRET\n        }),\n    )\n    .await\n    .expect(\"management credential\");\n    assert!(eventually(|| desk.setup().tenant.management.state == ScanState::Ready).await);\n    let context = desk.draft_context();\n    desk.send(json!({\"kind\": \"verifyTenantSetup\", \"context\": context}))\n        .await\n        .expect(\"verify\");\n    let verify = desk.verified().await;\n    assert!(\n        verify.blocking && !desk.setup().completable,\n        \"invalid OAuth is a blocking authentication failure, not an optional product warning\"\n    );\n    assert_eq!(\n        desk.send(json!({\"kind\": \"completeTenantSetup\", \"context\": context, \"packs\": []}))\n            .await,\n        Err(Refusal::InvalidInput)\n    );\n    assert!(desk.snap().tenants.is_empty());\n}\n\n#[tokio::test]\nasync fn refinement_production_policy_rejects_the_legacy_create_tenant_bypass() {\n    // This uses the same actor/intent path as production, with the fixture-only\n    // compatibility capability explicitly disabled as it is in shipping builds.\n    let mut desk = desk_with_fixture_creation(false).await;\n    assert_eq!(\n        desk.send(json!({\"kind\": \"createTenant\", \"profile\": {\n            \"label\": \"Bypass\", \"tsgId\": TSG,\n            \"destination\": {\"kind\": \"region\", \"region\": \"europe\"}\n        }}))\n        .await,\n        Err(Refusal::InvalidInput)\n    );\n    assert!(desk.snap().tenants.is_empty());\n    assert!(desk.snap().active.is_none());\n    assert!(desk._server.seen().is_empty());\n}\n\nasync fn issuer_failure_keeps_its_cause(status: u16, expected: ManagementFailure) {\n    let mut desk = desk_with_fixture_creation(false).await;\n    desk.send(\n        json!({\"kind\": \"beginTenantSetup\", \"mode\": \"add\", \"profile\": {\n            \"label\": \"Issuer failure\", \"tsgId\": TSG,\n            \"destination\": {\"kind\": \"region\", \"region\": \"europe\"}\n        }}),\n    )\n    .await\n    .expect(\"draft\");\n    let context = desk.draft_context();\n    desk.send(\n        json!({\"kind\": \"configureManagementCredential\", \"context\": context,\n            \"mode\": \"session\", \"clientId\": CLIENT_ID, \"secret\": CLIENT_SECRET\n        }),\n    )\n    .await\n    .expect(\"client\");\n    assert!(eventually(|| desk.setup().tenant.management.state == ScanState::Ready).await);\n    let context = desk.draft_context();\n    desk.script.lock().expect(\"script\").token_status = status;\n    let result = desk.read(&context, json!({\"kind\": \"verify\"})).await;\n    assert!(\n        matches!(result, ManagementResult::Failed { failure, .. } if failure == expected),\n        \"issuer {status}: {result:?}\"\n    );\n    desk.send(json!({\"kind\": \"verifyTenantSetup\", \"context\": context}))\n        .await\n        .expect(\"verify draft\");\n    let verify = desk.verified().await;\n    assert!(verify.blocking && !desk.setup().completable);\n    assert_eq!(\n        desk.send(json!({\"kind\": \"completeTenantSetup\", \"context\": context, \"packs\": []}))\n            .await,\n        Err(Refusal::InvalidInput)\n    );\n    assert!(desk.snap().tenants.is_empty());\n    assert!(\n        desk._server\n            .seen()\n            .iter()\n            .all(|request| request.request_line.contains(\"/oauth2/access_token\")),\n        \"a failed grant must not become a product permission probe\"\n    );\n}\n\n#[tokio::test]\nasync fn refinement_issuer_400_is_an_authentication_failure() {\n    issuer_failure_keeps_its_cause(400, ManagementFailure::Unauthorized).await;\n}\n\n#[tokio::test]\nasync fn refinement_issuer_401_is_an_authentication_failure() {\n    issuer_failure_keeps_its_cause(401, ManagementFailure::Unauthorized).await;\n}\n\n#[tokio::test]\nasync fn refinement_issuer_403_does_not_prove_authentication() {\n    issuer_failure_keeps_its_cause(403, ManagementFailure::Unauthorized).await;\n}\n\n#[tokio::test]\nasync fn refinement_issuer_429_retains_the_rate_limit_cause() {\n    issuer_failure_keeps_its_cause(429, ManagementFailure::RateLimited).await;\n}\n\n#[tokio::test]\nasync fn refinement_issuer_503_retains_the_service_failure_cause() {\n    issuer_failure_keeps_its_cause(503, ManagementFailure::Unavailable).await;\n}\nasync fn legacy_model_warning_requires_dedicated_check_and_preserves_dated_history() {\n    let mut d = desk(\"modelSkill\", LEGACY_MODEL, None).await;\n    let context = d.context();\n    d.send(json!({\"kind\":\"readTenant\",\"context\":context})).await;\n    assert!(\n        eventually(|| {\n            let read = d.snap().inbox.read;\n            read.state != desktop_core::ReadState::Reading\n                && read.products.iter().any(|p| {\n                    p.product == desktop_core::features::ProductId::ModelSkill\n                        && p.state == desktop_core::ProductReadState::Ok\n                })\n        })\n        .await\n    );\n    assert!(\n        d.warning().get(\"resolvedSecs\").is_none(),\n        \"ordinary healthy read is not a setup recheck\"\n    );\n    d.recheck().await;\n    let warning = d.warning();\n    assert_eq!(warning[\"reason\"], LEGACY_MODEL);\n    assert_eq!(warning[\"recordedSecs\"], 1761480000u32);\n    assert_eq!(warning[\"recheck\"][\"state\"], \"pass\");\n    assert_eq!(warning[\"recheck\"][\"basis\"], \"legacyTenantSources\");\n    assert!(warning[\"resolvedSecs\"].as_u64().is_some());\n    assert!(!d.snap().inbox.items.iter().any(|i| i.id == \"vw-1\"));\n    assert!(\n        serde_json::to_value(d.handles.store.saved().expect(\"warning state was saved\")).expect(\"serialize saved warning state\")[\"tenantWarnings\"][0][\"warnings\"][0][\"resolvedSecs\"].as_u64().is_some()\n    );\n    assert!(\n        d.server\n            .seen()\n            .iter()\n            .all(|r| r.request_line.starts_with(\"GET \")\n                || r.request_line.starts_with(\"POST /oauth2/access_token \")),\n        \"no product writes or paid scans\"\n    );\n}\n\n#[tokio::test(flavor = \"multi_thread\")]\nasync fn source_specific_denial_remains_active_then_resolves_after_fresh_complete_check() {\n    let mut d = desk(\"modelSkill\", LEGACY_MODEL, Some(known(\"modelSkill\"))).await;\n    d.script.lock().expect(\"fixture script lock\").model_status[1] = 403;\n    d.recheck().await;\n    assert!(d.warning().get(\"resolvedSecs\").is_none());\n    let reason = d.warning()[\"recheck\"][\"reason\"]\n        .as_str()\n        .expect(\"warning recheck has a reason\")\n        .to_owned();\n    assert!(\n        reason.contains(\"Skill statistics\") && reason.contains(\"not allowed\"),\n        \"{reason}\"\n    );\n    d.script.lock().expect(\"fixture script lock\").model_status[1] = 200;\n    d.recheck().await;\n    assert_eq!(d.warning()[\"recheck\"][\"basis\"], \"recordedScope\");\n    assert!(d.warning()[\"resolvedSecs\"].as_u64().is_some());\n}\n\n#[tokio::test(flavor = \"multi_thread\")]\nasync fn unknown_legacy_scope_and_failed_persistence_do_not_clear_warning() {\n    let mut d = desk(\"modelSkill\", \"A freeform unknown legacy diagnostic\", None).await;\n    d.recheck().await;\n    assert_eq!(d.warning()[\"recheck\"][\"basis\"], \"unknown\");\n    assert!(d.warning().get(\"resolvedSecs\").is_none());\n    let mut d = desk(\"modelSkill\", LEGACY_MODEL, None).await;\n    d.handles.store.fail_saves(true);\n    d.recheck().await;\n    assert!(d.warning().get(\"resolvedSecs\").is_none());\n    assert!(\n        d.warning()[\"recheck\"][\"reason\"]\n            .as_str()\n            .expect(\"warning recheck has a reason\")\n            .contains(\"could not be saved\")\n    );\n}\n\n#[tokio::test(flavor = \"multi_thread\")]\nasync fn reported_legacy_gateway_scope_is_rechecked_with_slug_not_display_uuid() {\n    let reason =\n        format!(\"Workspace {WS}: partial; scope ws_goshawks_io_2mwlan does not list the workspace\");\n    let mut d = desk(\"gateway\", &reason, None).await;\n    d.workspace().await;\n    d.script.lock().expect(\"fixture script lock\").scope_slug = WS.to_owned();\n    d.recheck().await;\n    assert!(\n        d.warning().get(\"resolvedSecs\").is_none(),\n        \"UUID binding is not the documented slug contract\"\n    );\n    d.script.lock().expect(\"fixture script lock\").scope_slug = \"goshawks\".to_owned();\n    d.recheck().await;\n    assert_eq!(d.warning()[\"recheck\"][\"basis\"], \"legacyWorkspaceScope\");\n    assert!(d.warning()[\"resolvedSecs\"].as_u64().is_some());\n    assert_eq!(d.warning()[\"reason\"], reason);\n}\n\n#[tokio::test(flavor = \"multi_thread\")]\nasync fn gateway_wrong_workspace_or_unknown_scope_format_remains_unresolved() {\n    for reason in [\n        \"Workspace other-workspace: partial; scope ws_goshawks_io_2mwlan does not list the workspace\",\n        \"scope ws_goshawks_io_2mwlan: arbitrary unknown scope\",\n    ] {\n        let mut d = desk(\"gateway\", reason, None).await;\n        d.workspace().await;\n        d.recheck().await;\n        assert_eq!(d.warning()[\"recheck\"][\"basis\"], \"unknown\");\n        assert!(d.warning().get(\"resolvedSecs\").is_none());\n    }\n}\n\n#[tokio::test(flavor = \"multi_thread\")]\nasync fn replaced_credential_generation_retires_pending_warning_check() {\n    let mut d = desk(\"modelSkill\", LEGACY_MODEL, Some(known(\"modelSkill\"))).await;\n    d.script.lock().expect(\"fixture script lock\").model_status[0] = 0;\n    let old_context = d.context();\n    d.send(json!({\"kind\":\"recheckSetupWarning\",\"context\":old_context,\"warning\":\"vw-1\"}))\n        .await;\n    assert!(\n        eventually(|| d\n            .server\n            .seen()\n            .iter()\n            .any(|s| s.request_line.starts_with(\"GET /aims/data/v1/scans\")))\n        .await\n    );\n    assert_eq!(d.warning()[\"recheck\"][\"state\"], \"pending\");\n    d.send(json!({\"kind\":\"configureManagementCredential\",\"context\":old_context,\"mode\":\"keychain\",\"clientId\":\"synthetic-client@1234567890.iam.panserviceaccount.com\",\"secret\":\"synthetic-replaced-warning-secret\"})).await;\n    assert!(\n        eventually(|| d.context() != old_context\n            && d.snap().tenants[0].management.state == desktop_core::ScanState::Ready)\n        .await\n    );\n    assert!(eventually(|| d.server.closed_by_client() > 0).await);\n    assert!(d.warning().get(\"resolvedSecs\").is_none());\n    assert_ne!(d.warning()[\"recheck\"][\"state\"], \"pending\");\n    d.script.lock().expect(\"fixture script lock\").model_status[0] = 200;\n    d.recheck().await;\n    assert!(d.warning()[\"resolvedSecs\"].as_u64().is_some());\n}\n\n#[tokio::test(flavor = \"multi_thread\")]\nasync fn absent_original_gateway_workspace_does_not_mean_any_workspace_matches() {\n    let reason =\n        format!(\"Workspace {WS}: partial; scope ws_goshawks_io_2mwlan does not list the workspace\");\n    let mut d = desk(\"gateway\", &reason, Some(known(\"gateway\"))).await;\n    d.workspace().await;\n    d.recheck().await;\n    assert_eq!(d.warning()[\"recheck\"][\"equivalent\"], false);\n    assert!(d.warning().get(\"resolvedSecs\").is_none());\n}\n\n#[tokio::test(flavor = \"multi_thread\")]\nasync fn known_legacy_scan_configuration_is_rechecked_locally_without_claiming_service_validity() {\n    let reason = \"No scan key saved; scans stay unavailable until one is added in Administration.\";\n    let mut d = desk_with_tsg(\"runtimeSecurity\", reason, None, None).await;\n    assert!(d.snap().tenants[0].tsg_id.is_none());\n    let context = d.context();\n    d.send(json!({\"kind\":\"configureScanCredential\",\"context\":context,\"mode\":\"keychain\",\"key\":\"synthetic-scan-key\"})).await;\n    assert!(eventually(|| d.snap().tenants[0].scan.state == desktop_core::ScanState::Ready).await);\n    d.recheck().await;\n    assert_eq!(d.warning()[\"reason\"], reason);\n    assert_eq!(d.warning()[\"recheck\"][\"state\"], \"stored\");\n    assert_eq!(d.warning()[\"recheck\"][\"basis\"], \"legacyTenantSources\");\n    assert!(d.warning()[\"resolvedSecs\"].as_u64().is_some());\n    assert!(\n        d.server.seen().is_empty(),\n        \"configuration proof never calls a product or OAuth endpoint\"\n    );\n}\n\n#[tokio::test(flavor = \"multi_thread\")]\nasync fn known_missing_selection_check_is_superseded_only_by_full_selected_prerequisites() {\n    let reason =\n        \"1 Gateway workspace(s) readable; none chosen, so its prerequisites were not checked.\";\n    let mut d = desk(\"gateway\", reason, Some(known(\"gateway\"))).await;\n    d.recheck().await;\n    assert!(\n        d.warning().get(\"resolvedSecs\").is_none(),\n        \"a listing is not selected-workspace prerequisites\"\n    );\n    d.workspace().await;\n    d.recheck().await;\n    assert_eq!(d.warning()[\"recheck\"][\"basis\"], \"recordedScope\");\n    assert!(d.warning()[\"resolvedSecs\"].as_u64().is_some());\n    assert!(\n        d.warning()[\"recheck\"][\"reason\"]\n            .as_str()\n            .expect(\"warning recheck has a reason\")\n            .contains(\"original check found no selected workspace\")\n    );\n}\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_32","type":"command_execution","command":"/bin/zsh -lc \"sed -n '1850,2125p' crates/desktop-core/tests/harness_tools/main.rs; sed -n '306,402p' crates/desktop-core/tests/ui_v2_inbox/main.rs; rg -n 'tenant_with_products' crates/desktop-core/tests/ui_v2_inbox/main.rs\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_32","type":"command_execution","command":"/bin/zsh -lc \"sed -n '1850,2125p' crates/desktop-core/tests/harness_tools/main.rs; sed -n '306,402p' crates/desktop-core/tests/ui_v2_inbox/main.rs; rg -n 'tenant_with_products' crates/desktop-core/tests/ui_v2_inbox/main.rs\"","aggregated_output":"\n/// Authenticate the synthetic draft through the same management pipeline,\n/// then use its rotated context for a genuinely completable setup.\nasync fn authenticated_setup(desk: &mut Desk) -> String {\n    let before = desk.json()[\"setup\"][\"context\"]\n        .as_str()\n        .expect(\"draft context\")\n        .to_owned();\n    desk.send(\n        json!({\"kind\": \"configureManagementCredential\", \"context\": before, \"mode\": \"keychain\",\n        \"clientId\": CLIENT_ID, \"secret\": CLIENT_SECRET}),\n    )\n    .await\n    .expect(\"draft management credential\");\n    assert!(\n        settle(|| desk\n            .snap()\n            .setup\n            .is_some_and(|s| s.tenant.management.state == desktop_core::ScanState::Ready))\n        .await\n    );\n    let context = desk.json()[\"setup\"][\"context\"]\n        .as_str()\n        .expect(\"authenticated draft context\")\n        .to_owned();\n    assert_ne!(\n        context, before,\n        \"the saved draft credential rotates context\"\n    );\n    desk.send(json!({\"kind\": \"verifyTenantSetup\", \"context\": context}))\n        .await\n        .expect(\"verify authenticated draft\");\n    assert!(settle(|| desk.json()[\"setup\"][\"verify\"][\"done\"] == true).await);\n    let setup = desk.snap().setup.expect(\"verified draft\");\n    assert!(\n        setup.completable,\n        \"authentication must reach the switch guard\"\n    );\n    let verify = setup.verify.expect(\"verification\");\n    assert!(!verify.blocking && !verify.stale);\n    assert_eq!(\n        verify\n            .steps\n            .iter()\n            .find(|s| s.line == desktop_core::features::VerifyLine::ManagementClient)\n            .expect(\"OAuth line\")\n            .state,\n        desktop_core::features::VerifyState::Pass\n    );\n    context\n}\n\n/// C30 (I1): completing an Add-a-tenant draft makes the new tenant active,\n/// so it is the same guarded switch: a pending Harness decision refuses it\n/// with the guard naming the draft, nothing is committed or retired until\n/// the operator resolves the conversation, and the resolution completes it.\n#[tokio::test(flavor = \"multi_thread\", worker_threads = 4)]\nasync fn completing_a_tenant_setup_is_the_guarded_switch_path() {\n    let mut desk = desk().await;\n    let dir = project();\n    choose_project(&mut desk, &dir).await;\n    let id = ready(&mut desk).await;\n    tool(&desk, None, \"exec_command\", json!({\"cmd\": \"ls\"}));\n    desk.say(&id, \"List the files.\").await.expect(\"sent\");\n    let c = answered_with(&mut desk, |c| {\n        c[\"approvals\"].as_array().is_some_and(|a| !a.is_empty())\n    })\n    .await;\n    let token = c[\"approvals\"][0][\"id\"].as_str().expect(\"id\").to_owned();\n    let a = desk.json()[\"active\"][\"tenant\"]\n        .as_str()\n        .expect(\"A\")\n        .to_owned();\n    let origin = desk.json()[\"tenants\"][0][\"origin\"]\n        .as_str()\n        .expect(\"origin\")\n        .to_owned();\n    desk.send(json!({\"kind\": \"beginTenantSetup\", \"mode\": \"add\", \"profile\": {\"label\": \"Tenant C\", \"tsgId\": \"1234567890\",\n        \"destination\": {\"kind\": \"custom\", \"origin\": origin}}}))\n        .await\n        .expect(\"draft\");\n    let setup = desk.json()[\"setup\"].clone();\n    let draft_id = setup[\"tenant\"][\"id\"].as_str().expect(\"draft id\").to_owned();\n    let draft = authenticated_setup(&mut desk).await;\n    assert_eq!(\n        desk.send(json!({\"kind\": \"completeTenantSetup\", \"context\": draft, \"packs\": []}))\n            .await,\n        Err(desktop_core::Refusal::DecisionPending)\n    );\n    let s = desk.json();\n    assert_eq!(s[\"active\"][\"tenant\"], a, \"still on A\");\n    assert_eq!(\n        s[\"switchBlocked\"][\"to\"], draft_id,\n        \"the guard names the draft\"\n    );\n    assert_eq!(s[\"switchBlocked\"][\"completion\"], true);\n    assert_eq!(s[\"switchBlocked\"][\"pending\"][\"conversation\"], id);\n    assert_eq!(s[\"switchBlocked\"][\"pending\"][\"decision\"], token);\n    assert_eq!(s[\"setup\"][\"context\"], draft, \"the draft is untouched\");\n    assert!(\n        s[\"harness\"][\"conversation\"][\"approvals\"]\n            .as_array()\n            .is_some_and(|x| !x.is_empty()),\n        \"nothing was decided for the operator\"\n    );\n    assert!(\n        s[\"tenants\"]\n            .as_array()\n            .expect(\"tenants\")\n            .iter()\n            .all(|t| t[\"label\"] != \"Tenant C\"),\n        \"nothing was committed\"\n    );\n    // Stay: the guard closes; the draft, the tenant and the decision remain.\n    desk.send(json!({\"kind\": \"dismissSwitchGuard\"}))\n        .await\n        .expect(\"dismissed\");\n    let s = desk.json();\n    assert!(s[\"switchBlocked\"].is_null());\n    assert_eq!(s[\"setup\"][\"context\"], draft);\n    assert_eq!(s[\"active\"][\"tenant\"], a);\n    // Archive and complete: the conversation ends (kept), the tenant is\n    // committed and active, the draft is gone.\n    let resolved = reviewed_switch(\n        &mut desk,\n        json!({\"kind\": \"completeTenantSetup\", \"context\": draft, \"packs\": []}),\n        \"archive\",\n    )\n    .await;\n    assert_eq!(\n        resolved[\"resolution\"][\"context\"],\n        desk.context(),\n        \"bound to the active source, not the setup draft\"\n    );\n    let mut wrong_source = resolved.clone();\n    wrong_source[\"resolution\"][\"context\"] = json!(draft);\n    assert_eq!(\n        desk.send(wrong_source).await,\n        Err(desktop_core::Refusal::StaleContext)\n    );\n    assert_eq!(\n        desk.conversation()[\"id\"],\n        id,\n        \"forged source does not end the conversation\"\n    );\n    desk.send(resolved).await.expect(\"completed\");\n    let s = desk.json();\n    assert!(s[\"setup\"].is_null());\n    assert!(s[\"switchBlocked\"].is_null());\n    let c_id = s[\"tenants\"]\n        .as_array()\n        .expect(\"tenants\")\n        .iter()\n        .find(|t| t[\"label\"] == \"Tenant C\")\n        .and_then(|t| t[\"id\"].as_str())\n        .expect(\"committed\")\n        .to_owned();\n    assert_eq!(s[\"active\"][\"tenant\"], c_id);\n    assert!(\n        s[\"harness\"][\"conversation\"].is_null(),\n        \"another tenant's conversation is never shown\"\n    );\n    desk.send(json!({\"kind\": \"selectTenant\", \"tenant\": a}))\n        .await\n        .expect(\"back to A\");\n    assert!(\n        settle_for(30, || {\n            let c = desk.conversation();\n            c.is_null() || c[\"phase\"] == \"ended\" || c[\"phase\"] == \"ending\"\n        })\n        .await\n    );\n    std::fs::remove_dir_all(&dir).expect(\"cleanup\");\n}\n\n/// C30 attempt11 R1/E1: a refused state save authorizes no destructive\n/// resolution. The same native refusal remains actionable after recovery.\nasync fn guarded_resolution_save_failure(completion: bool, kind: &str) {\n    let mut desk = desk().await;\n    let dir = project();\n    choose_project(&mut desk, &dir).await;\n    let id = ready(&mut desk).await;\n    desk.say(&id, \"Say hello.\").await.expect(\"sent\");\n    desk.answered().await;\n    assert!(settle(|| !desk.conversation()[\"savedAt\"].is_null()).await);\n    let history = desk.conversation()[\"historyId\"]\n        .as_str()\n        .expect(\"history\")\n        .to_owned();\n    tool(&desk, None, \"exec_command\", json!({\"cmd\": \"ls\"}));\n    desk.say(&id, \"List the files.\")\n        .await\n        .expect(\"pending turn\");\n    answered_with(&mut desk, |c| {\n        c[\"approvals\"].as_array().is_some_and(|a| !a.is_empty())\n    })\n    .await;\n    let origin = desk.json()[\"tenants\"][0][\"origin\"]\n        .as_str()\n        .expect(\"origin\")\n        .to_owned();\n    let intent = if completion {\n        desk.send(json!({\"kind\":\"beginTenantSetup\",\"mode\":\"add\",\"profile\":{\"label\":\"Tenant B\",\"tsgId\":\"1234567890\",\"destination\":{\"kind\":\"custom\",\"origin\":origin}}})).await.expect(\"draft\");\n        let draft = authenticated_setup(&mut desk).await;\n        json!({\"kind\":\"completeTenantSetup\",\"context\":draft,\"packs\":[]})\n    } else {\n        desk.send(json!({\"kind\":\"createTenant\",\"profile\":{\"label\":\"Tenant B\",\"tsgId\":\"1234567890\",\"destination\":{\"kind\":\"custom\",\"origin\":origin}}})).await.expect(\"B\");\n        let b = desk.json()[\"tenants\"]\n            .as_array()\n            .expect(\"tenants\")\n            .iter()\n            .find(|t| t[\"label\"] == \"Tenant B\")\n            .expect(\"B\")[\"id\"]\n            .clone();\n        json!({\"kind\":\"selectTenant\",\"tenant\":b})\n    };\n    let resolved = reviewed_switch(&mut desk, intent, kind).await;\n    let before = desk.json();\n    let stored = serde_json::to_value(desk.adapters.store.saved()).expect(\"stored document\");\n    let protected: Vec<_> = files_under(&desk.history_root)\n        .into_iter()\n        .filter(|f| f.to_string_lossy().contains(&history))\n        .map(|f| {\n            let bytes = std::fs::read(&f).expect(\"protected transcript\");\n            (f, bytes)\n        })\n        .collect();\n    assert!(\n        !protected.is_empty(),\n        \"the completed first turn is protected on disk\"\n    );\n    desk.adapters.store.fail_saves(true);\n    assert_eq!(\n        desk.send(resolved.clone()).await,\n        Err(desktop_core::Refusal::DeniedStore)\n    );\n    let refused = desk.json();\n    assert_eq!(\n        refused[\"active\"], before[\"active\"],\n        \"the source remains active\"\n    );\n    assert_eq!(\n        refused[\"switchBlocked\"], before[\"switchBlocked\"],\n        \"save refusal preserves the exact native guard\"\n    );\n    assert_eq!(\n        refused[\"setup\"], before[\"setup\"],\n        \"the draft remains actionable\"\n    );\n    for field in [\"id\", \"phase\", \"approvals\", \"historyId\", \"savedAt\"] {\n        assert_eq!(\n            refused[\"harness\"][\"conversation\"][field], before[\"harness\"][\"conversation\"][field],\n            \"pending conversation {field} unchanged\"\n        );\n    }\n    assert_eq!(\n        serde_json::to_value(desk.adapters.store.saved()).expect(\"saved\"),\n        stored\n    );\n    for (path, bytes) in &protected {\n        assert_eq!(&std::fs::read(path).expect(\"still protected\"), bytes);\n    }\n    // Recovery uses the same refusal binding, with a new explicit delivery.\n    desk.adapters.store.fail_saves(false);\n    desk.send(resolved.clone())\n        .await\n        .expect(\"one successful resolution after storage recovery\");\n    assert_ne!(desk.json()[\"active\"][\"tenant\"], before[\"active\"][\"tenant\"]);\n    assert!(desk.json()[\"switchBlocked\"].is_null());\n    if completion {\n        assert!(desk.json()[\"setup\"].is_null());\n    }\n    assert_eq!(\n        desk.send(resolved).await,\n        Err(desktop_core::Refusal::StaleContext),\n        \"a consumed resolution cannot run again\"\n        );\n    }\n\n    /// Save synthetic OAuth on the draft, then return its fresh context.\n    async fn draft_management_key(&mut self) -> String {\n        let before = self\n            .snap()\n            .setup\n            .expect(\"draft\")\n            .context\n            .as_str()\n            .to_owned();\n        self.send(\n            json!({\"kind\": \"configureManagementCredential\", \"context\": before, \"mode\": \"keychain\",\n            \"clientId\": CLIENT_ID, \"secret\": CLIENT_SECRET}),\n        )\n        .await\n        .expect(\"draft management key\");\n        assert!(\n            eventually(|| self\n                .snap()\n                .setup\n                .is_some_and(|s| s.tenant.management.state == ScanState::Ready))\n            .await\n        );\n        let current = self\n            .snap()\n            .setup\n            .expect(\"draft\")\n            .context\n            .as_str()\n            .to_owned();\n        assert_ne!(current, before, \"the draft credential rotates context\");\n        current\n    }\n\n    fn assert_setup_completable(&self) {\n        let setup = self.snap().setup.expect(\"verified draft\");\n        assert!(\n            setup.completable,\n            \"synthetic OAuth must allow setup completion\"\n        );\n        let verify = setup.verify.expect(\"verification\");\n        assert!(!verify.blocking && !verify.stale);\n        assert_eq!(\n            verify\n                .steps\n                .iter()\n                .find(|s| s.line == desktop_core::features::VerifyLine::ManagementClient)\n                .expect(\"OAuth line\")\n                .state,\n            desktop_core::features::VerifyState::Pass\n        );\n    }\n\n    /// Authenticates a draft with the chosen products, completes it (active),\n    /// then refreshes the active credential for each consumer's later reads.\n    async fn tenant_with_products(&mut self, label: &str, products: &[&str]) -> String {\n        let origin = self.origin.clone();\n        self.send(json!({\"kind\": \"beginTenantSetup\", \"mode\": \"add\", \"profile\": {\"label\": label, \"tsgId\": TSG,\n            \"destination\": {\"kind\": \"custom\", \"origin\": origin}}}))\n            .await\n            .expect(\"draft\");\n        let draft = self.draft_management_key().await;\n        self.send(json!({\"kind\": \"chooseSetupProducts\", \"context\": draft, \"products\": products}))\n            .await\n            .expect(\"products\");\n        self.send(json!({\"kind\": \"verifyTenantSetup\", \"context\": draft}))\n            .await\n            .expect(\"verify\");\n        assert!(\n            eventually(|| self\n                .snap()\n                .setup\n                .and_then(|s| s.verify)\n                .is_some_and(|v| v.done))\n            .await\n        );\n        self.assert_setup_completable();\n        self.send(json!({\"kind\": \"completeTenantSetup\", \"context\": draft, \"packs\": []}))\n            .await\n            .expect(\"completed\");\n        let id = self.snap().active.expect(\"active\").tenant;\n        self.management_key().await;\n        id.as_str().to_owned()\n    }\n\n    /// `readTenant`, waited to completion.\n    async fn read(&mut self) -> ShellSnapshot {\n        let context = self.context();\n        let before = self.snap().inbox.read.generation;\n        self.send(json!({\"kind\": \"readTenant\", \"context\": context}))\n            .await\n            .expect(\"read admitted\");\n        assert!(\n            eventually(|| {\n                let s = self.snap();\n363:    async fn tenant_with_products(&mut self, label: &str, products: &[&str]) -> String {\n801:    desk.tenant_with_products(\n925:    desk.tenant_with_products(\"Tenant T\", &[\"runtimeSecurity\", \"redTeam\", \"modelSkill\"])\n1198:    desk.tenant_with_products(\"Tenant P\", &[\"runtimeSecurity\", \"redTeam\"])\n1283:    desk.tenant_with_products(\"Tenant U\", &[\"runtimeSecurity\", \"redTeam\", \"modelSkill\"])\n1321:    desk.tenant_with_products(\"Tenant V\", &[\"runtimeSecurity\", \"redTeam\"])\n1351:    desk.tenant_with_products(\"Tenant W\", &[\"runtimeSecurity\", \"redTeam\"])\n","exit_code":0,"status":"completed"}}
