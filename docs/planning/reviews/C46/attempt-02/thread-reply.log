{"type":"item.completed","item":{"id":"item_26","type":"command_execution","command":"/bin/zsh -lc \"sed -n '1,215p' tools/p11/proof.py; sed -n '240,500p' tools/p11/remediation.py\"","aggregated_output":"\"\"\"P11's shared candidate proof. Reuses the existing strict raw-evidence consumer.\n\nOne actual phase run remains a phase run when four chunk reviews consume it.\nThis module neither executes tests nor assigns scores or ledger completions.\n\"\"\"\nfrom pathlib import Path\nimport json\nimport hashlib\nimport importlib.util\nimport os\nimport platform\nimport stat\nimport subprocess\nimport sys\nimport argparse\n\nsys.path.insert(0, str(Path(__file__).resolve().parents[1] / 'p10'))\nfrom candidate import bundle_hash, helper_closure, source_inventory, file_identity, digest\nimport qualification as coverage\n\nCHUNKS = ('C46', 'C47', 'C48', 'C49')\nAPPLICATION_INPUTS = ('apps/desktop', 'crates/desktop-core', 'packages/desktop-contracts',\n                      'resources', 'Cargo.toml', 'Cargo.lock', 'pnpm-lock.yaml',\n                      'pnpm-workspace.yaml', 'package.json', 'rust-toolchain.toml',\n                      'docs/architecture/inputs.lock.json')\nrequire, read, sha, bound = coverage.require, coverage.read, coverage.sha, coverage.bound\nCHECK_CARRY_PATHS = {'crates/desktop-core/src/authority/setup_warning_domain.rs',\n                     'crates/desktop-core/tests/setup_warning_recheck.rs',\n                     'tools/p11/proof.py', 'tools/p11/test_proof.py',\n                     'tools/p11/standing.py', 'tools/p11/README.md',\n                     'docs/planning/refinements/2026-11-04/execution.md'}\nCHECK_LINT_SHA256 = ('78670431d22db13786eccddb0fb30328d0596378937d3cc5dacefb91d6089c5a',\n                    '53416c79363d279943b51f7f935514be01b576166241ec3bb2af24a8e8e34e27')\nCHECK_TEST_PATH = 'crates/desktop-core/tests/setup_warning_recheck.rs'\nCHECK_TEST_LINT_SHA256 = ('e9133b4869104afc448a5701685b4b72dffd1405ed687284f370cec04fa906f5',\n                         'e4aef28bf18b15f77d3fac003fbd65c2b6379cd97ee58e8ed43fda1a1f5fc7e5')\nCHECK_CARRY_LABELS = {'setup/1', 'setup/2', 'C46/check/2', 'C46/check/3',\n                     'C46/check/4', 'C46/check/5'}\n\n\ndef xtask_source(root):\n    \"\"\"Recompute fingerprint.rs source inventory/hash, including deleted files.\n\n    This joins the current Python review seal to the Rust runner's actual source\n    binding. A stale fingerprint JSON cannot bind new source to old test results.\n    \"\"\"\n    names = subprocess.check_output(['/usr/bin/git', 'ls-files', '-z', '--cached', '--others',\n                                     '--exclude-standard'], cwd=root).decode().split('\\0')\n    names = sorted({name for name in names if name and name != 'docs/planning/status.md'\n                    and not name.startswith(('docs/planning/reviews/', 'docs/planning/evidence/'))})\n    parts = []\n    for name in names + ['.git/config']:\n        path = root / name\n        try:\n            metadata = path.lstat()\n        except OSError:\n            mode, value = 'deleted', ''\n        else:\n            if path.is_symlink():\n                mode = 'symlink'\n                value = hashlib.sha256(os.fsencode(os.readlink(path))).hexdigest()\n            else:\n                mode = '100755' if stat.S_IMODE(metadata.st_mode) & 0o111 else '100644'\n                value = sha(path)\n        parts.append(f'{name}\\0{mode}\\0{value}\\n')\n    return hashlib.sha256(''.join(parts).encode()).hexdigest()\n\n\ndef application_files(root):\n    return set(subprocess.check_output(['/usr/bin/git', 'ls-files', '-z', '--cached', '--others',\n                                       '--exclude-standard', *APPLICATION_INPUTS],\n                                       cwd=root).decode().strip('\\0').split('\\0'))\n\n\ndef current_fingerprints(root):\n    \"\"\"Metadata audit only: no tests, native flow, frontend or application build.\"\"\"\n    env = {key: os.environ[key] for key in ('HOME', 'USER', 'LOGNAME', 'TMPDIR', 'LANG', 'LC_ALL')\n           if key in os.environ}\n    env['PATH'] = ':'.join([str(root / '.tools/bin'), str(Path.home() / '.cargo/bin'),\n                            str(Path.home() / '.nvm/versions/node/v24.21.0/bin'),\n                            '/usr/bin', '/bin', '/usr/sbin', '/sbin'])\n    env['RUSTUP_TOOLCHAIN'] = '1.99.0'\n    result = subprocess.run([str(Path.home() / '.cargo/bin/cargo'), 'run', '--locked', '-p',\n                             'xtask', '--', 'fingerprint', '--phase', 'P11'], cwd=root,\n                            env=env, capture_output=True, text=True)\n    require(result.returncode == 0, 'current metadata fingerprint audit failed: ' + result.stderr[-2000:])\n    return json.loads(result.stdout)\n\n\ndef native_origins(root, acceptance, execution, candidate):\n    spec = importlib.util.spec_from_file_location('p11_native_proof', Path(__file__).with_name('native.py'))\n    module = importlib.util.module_from_spec(spec)\n    spec.loader.exec_module(module)\n    return module.validate(root, acceptance, execution, candidate)\n\n\n\ndef native_driver(root, performed):\n    raw = (read(bound(root, performed['origins'][-1]['observations']))\n           if performed.get('schema') == 'airs-desktop/p11-native-selection/1' else performed)\n    argv = raw.get('argv', [])\n    names = ('acceptance_p11', 'acceptance_p11_resume', 'acceptance_p11_continue', 'acceptance_p11_finish', 'acceptance_p11_last', 'acceptance_p11_verify', 'acceptance_p11_warn')\n    require(len(argv) > 1 and argv[1] in ['tools/native-acceptance/' + name + '.py' for name in names],\n            'unknown actual native driver')\n    return Path(argv[1]).stem\n\n\ndef equivalent_native_origin(root, raw_path, raw, candidate, source):\n    \"\"\"Original helper bytes verified in a current source context, not a new run.\"\"\"\n    require(raw['executable_sha256'] == candidate['executable_sha256']\n            and raw['bundle_sha256'] == candidate['bundle_sha256']\n            and raw['host'] == candidate['conditions']['platform'],\n            'native origin application or execution platform changed')\n    require(raw['helper_closure'] and all((source / name).resolve().is_relative_to(source.resolve())\n            and (source / name).is_file() and sha(source / name) == value\n            for name, value in raw['helper_closure'].items()),\n            'original native helper bytes changed')\n    return {key: candidate[key] for key in\n        ('source_inventory_sha256', 'execution_root', 'prepare', *coverage.EXACT_FIELDS)} | {\n        'helper_closure': raw['helper_closure'],\n        'native_observation': reference(root, raw_path),\n        'meaning': 'Original native process observations retain their actual arguments, times and exit status. '\n                   'The source inventory identifies only the current exact-helper-byte equivalence context; '\n                   'the original observations recorded no whole-source fingerprint. No current execution '\n                   'or original global source fingerprint is claimed.'}\n\n\ndef validate_execution(root, performed, candidate, acceptance=None, execution=None):\n    if performed.get('schema') == 'airs-desktop/p11-native-selection/1':\n        require(acceptance is not None and execution is not None, 'native continuation paths missing')\n        return native_origins(root, acceptance, execution, candidate)\n    require(performed['status'] == 'observed' and performed['exit_code'] == 0,\n            'native observation process failed or did not finish')\n    require(Path(performed['argv'][0]).name in ('python3', 'Python3', 'Python')\n            and performed['argv'][1] == 'tools/native-acceptance/acceptance_p11.py',\n            'native execution entrypoint differs')\n    require(performed['executable_sha256'] == candidate['executable_sha256']\n            and performed['bundle_sha256'] == candidate['bundle_sha256'],\n            'native observation candidate differs')\n    require(performed['helper_closure'] == candidate['helper_closure'], 'native helper drift')\n\n\ndef frontend_test_carry(root, record, build_path, build, candidate, changed):\n    \"\"\"A test-only edit may retain the native build after an exact frontend rebuild.\n\n    The native executable/bundle are verified independently. Original build\n    outcomes stay bound; this does not claim a newly executed native build.\n    \"\"\"\n    require(changed and all(name.startswith('apps/desktop/src/')\n                           and name.endswith(('.test.ts', '.test.tsx')) for name in changed),\n            'application-affecting build input changed')\n    carry = read(bound(root, record['build_input_carry']))\n    require(carry['schema'] == 'airs-desktop/frontend-test-build-carry/1'\n            and carry['build'] == reference(root, build_path)\n            and carry['prepare'] == candidate['prepare'] and carry['native_rebuilt'] is False,\n            'test-only native build carry is not bound')\n    expected = {name: {'before': build['application_inputs_before'][name], 'after': sha(root / name)}\n                for name in changed}\n    require(carry['changed_inputs'] == expected and carry['reason'], 'test-only delta differs')\n    equivalence_path = bound(root, carry['frontend_equivalence'])\n    equivalence = read(equivalence_path)\n    require(equivalence['schema'] == 'airs-desktop/frontend-build-equivalence/1'\n            and equivalence['cwd'] == str(root)\n            and len(equivalence['argv']) == 8\n            and equivalence['argv'][:7] == ['pnpm', '--filter', '@prisma-airs/desktop',\n                                           'exec', 'vite', 'build', '--outDir']\n            and Path(equivalence['argv'][7]).resolve().is_relative_to(root / '.evidence-private'),\n            'frontend equivalence command differs')\n    current_inputs = {name: sha(root / name) for name in sorted(application_files(root))}\n    require(equivalence['application_inputs_before'] == current_inputs\n            and equivalence['application_inputs_after'] == current_inputs,\n            'frontend equivalence inputs changed or were not bound')\n    require(equivalence['exit_code'] == 0 and equivalence['frontend_byte_identical'] is True\n            and equivalence['original_frontend_unchanged'] is True\n            and equivalence['original_prepare_sha256'] == candidate['prepare']['sha256'],\n            'frontend rebuild equivalence failed or names another candidate')\n    original = equivalence['original_frontend_files']\n    require(original and original == equivalence['rebuilt_frontend_files'],\n            'frontend rebuilt bytes or membership differ')\n    current = {str(path.relative_to(root / 'apps/desktop/dist')): sha(path)\n               for path in sorted((root / 'apps/desktop/dist').rglob('*')) if path.is_file()}\n    require(current == original, 'retained frontend bytes changed after equivalence proof')\n    require(sha(equivalence_path.parent / 'build.log') == equivalence['log_sha256'],\n            'frontend equivalence build log drift')\n\n\ndef rust_test_carry(root, record, build_path, build, candidate, changed):\n    \"\"\"Retain the native build for the exact dated unwrap-to-expect test edit.\n\n    Current Check/Test evidence is validated before this consumer. Rust test\n    source is not part of the application target; no native build is claimed.\n    \"\"\"\n    require(changed == [CHECK_TEST_PATH]\n            and (build['application_inputs_before'].get(CHECK_TEST_PATH),\n                 sha(root / CHECK_TEST_PATH)) == CHECK_TEST_LINT_SHA256,\n            'build carry is not the reviewed Rust test-only change')\n    carry = read(bound(root, record['build_input_carry']))\n    require(carry['schema'] == 'airs-desktop/rust-test-build-carry/1'\n            and carry['build'] == reference(root, build_path)\n            and carry['prepare'] == candidate['prepare'] and carry['native_rebuilt'] is False,\n            'Rust test-only native build carry is not bound')\n    expected = {CHECK_TEST_PATH: {'before': CHECK_TEST_LINT_SHA256[0],\n                                  'after': CHECK_TEST_LINT_SHA256[1]}}\n    require(carry['changed_inputs'] == expected and carry['reason'], 'Rust test-only delta differs')\n    runs = record.get('runs', {})\n    require(runs.get('check') and runs.get('test')\n            and carry.get('check_selection') == runs['check']\n            and carry.get('tests') == runs['test'], 'Rust test carry lacks current Check/Test bindings')\n    bound(root, runs['check'])\n    bound(root, runs['test'])\n\n\ndef reference(root, path):\n    path = Path(path).resolve()\n    require(path.is_relative_to(root.resolve()), 'proof path escapes checkout')\n    scroll(root, receipt['scroll'], receipt['baseline'], old_candidate, files)\n    rust_consumers(root, receipt['rust_consumers'], files)\n    affected_lints(root, receipt, files)\n    format_selector(root, receipt['format'], files, candidate['execution_root'])\n    covered = set()\n    require(receipt['helper_qa'], 'remediation affected helper QA missing')\n    for ref in receipt['helper_qa']:\n        qa = read(bound(root, ref)); bound(root, qa['log'])\n        require(qa['schema'] == 'airs-desktop/p11-helper-qa/1' and qa['argv']\n                and qa['exit_code'] == 0 and qa['tests']['passed'] > 0 and qa['tests']['failed'] == 0\n                and qa.get('source_before') == qa.get('source_after')\n                and qa['helper_files'] and all(files.get(n, {}).get('sha256') == value\n                    for n, value in qa['helper_files'].items()), 'remediation helper QA failed/drifted')\n        covered.update(qa['helper_files'])\n    require({n for n in receipt['changed_paths'] if n.endswith('.py')} <= covered,\n            'remediation changed helper lacks affected QA')\n    return old_record, old_coverage, history\n\n\ndef source_qa(root, reference, files):\n    supplement = read(bound(root, reference))\n    require(supplement['schema'] == 'airs-desktop/p11-c48-source-supplement/1'\n            and supplement['source_files'] == {n: files[n]['sha256'] for n in APP_DELTA},\n            'C48 affected source inputs differ')\n    producers = [read(bound(root, ref)) for ref in supplement['producer_receipts']]\n    originals = [row for producer in producers for key in ('final_checks', 'retained_prior_focused_checks')\n                 for row in producer.get(key, [])]\n    expected = {'C48/recovery-final02': 4, 'C48/typecheck-final02': None,\n        'C48/controllers-final': 20, 'C48/api-prior': 42, 'C48/shell-and-cases-prior': 45}\n    checks = supplement['checks']\n    require(len(checks) == len(expected) and {c['id'] for c in checks} == set(expected),\n            'C48 selected recovery/cross-consumer coverage missing')\n    earlier = {\n        'apps/desktop/src/v2/workbench/api-client.tsx': {\n            '50b881c165ce183abe845f4c572d687fe7bc4b0041a1a69c875394c55a67bb1d',\n            '0d1da0ed31d0ff86e4d46fb0392f08ad06945b30eb47c7cf97c114fba46e63d3'},\n        'apps/desktop/src/v2/workbench/api-client.test.tsx': {\n            '2d07b3ec2c0d340b30c4cf23877c05b548d30f34c7a4a98fe2dc72433f2f01eb',\n            '7a68e497d5056c30ebb8aa1f9f9c8216d7a28e979d86496ea74cbce9c255de03'}}\n    for item in checks:\n        require(item['exit_code'] == 0 and item.get('passed') == expected[item['id']]\n                and item['argv'] and item['cwd'], 'C48 selected command failed')\n        log = bound(root, item['log'])\n        require(any(all(old.get(k) == item.get(k) for k in ('argv', 'cwd', 'exit_code', 'passed'))\n                    and old['log_sha256'] == sha(log) for old in originals),\n                'C48 selection is not an original actual execution')\n        require(item['source_hashes'] and set(item['source_inputs']) == set(item['source_hashes']),\n                'C48 original source scope missing')\n        for name, value in item['source_hashes'].items():\n            require(sha(bound(root, item['source_inputs'][name])) == value\n                    and (files.get(name, {}).get('sha256') == value or value in earlier.get(name, set())),\n                    'C48 selected source delta is not the bounded recovery refinement')\n        if item['id'].endswith('final02'):\n            require(item['source_hashes'] == supplement['source_files'], 'final selector source was retagged')\n    return supplement\n\n\ndef recovery(root, reference, baseline, candidate, old_result, files):\n    supplement = read(bound(root, reference))\n    raw = read(bound(root, supplement['raw']))\n    bound(root, supplement['execution']); bound(root, supplement['source'])\n    needed = {'missing_restore_warning_visible', 'recovery_survives_home_back', 'retry_is_explicit',\n              'retry_recovers_when_root_restored', 'intentional_close_stays_closed'}\n    require(supplement['schema'] == 'airs-desktop/p11-recovery-supplement/1'\n            and supplement['baseline_qualification'] == baseline\n            and needed <= set(supplement['facts'])\n            and supplement['facts'] == raw['facts'] and all(v is True for v in raw['facts'].values()),\n            'affected recovery observations incomplete')\n    require(completed(raw) and raw['cwd'] == candidate['execution_root']\n            and supplement['prepare'] == candidate['prepare']\n            and raw['source_sha256'] == supplement['source']['sha256']\n            and all(supplement[k] == raw[k] == candidate[k] for k in ('executable_sha256', 'bundle_sha256'))\n            and raw['conditions'] == candidate['conditions'], 'recovery execution/candidate differs')\n    require(supplement['helper_closure'] == raw.get('helper_closure') and supplement['helper_closure']\n            and all(files.get(n, {}).get('sha256') == value\n            for n, value in supplement['helper_closure'].items()), 'recovery helper inputs changed')\n    require(supplement['retained_result'] == old_result and supplement['retained_reason'],\n            'old N03 first-use/save observations were lost or retagged')\n    require(supplement['captures'], 'recovery pixels missing')\n    for image in supplement['captures']:\n        bound(root, image)\n        require(image['visually_reviewed'] is True and image['accepted'] is True and not image['findings'],\n                'recovery capture not individually accepted')\n    return supplement\n\n\nSOURCE_IDS = {'check:C46/check/1', 'check:C46/check/4', 'test:C47/fixture', 'test:C48/frontend/1', 'test:C48/frontend/2'}\n\n\ndef verify_coverage(root, qualified, historical=None):\n    receipt = read(bound(root, qualified['review_remediation']))\n    candidate = read(bound(root, qualified['candidate']))\n    source = historical.source(qualified['source_inventory_sha256']) if historical else root\n    files = read(bound(root, receipt['current_source']))['files']\n    require(digest(files) == qualified['source_inventory_sha256']\n            and files == ({str(p.relative_to(source)): proof.file_identity(p) for p in source.rglob('*')\n                           if p.is_file() or p.is_symlink()} if historical else proof.source_inventory(root)),\n            'remediation current source differs')\n    require(receipt['schema'] == 'airs-desktop/p11-review-remediation/1'\n            and receipt['runner_inputs'] == candidate['runner_inputs'], 'remediation source binding missing')\n    original_record, original_coverage, history = source_transition(root, receipt, candidate, source, files)\n    source_qa(root, receipt['source_qa'], files)\n    originals = {r['id']: r for r in original_coverage['coverage']}\n    recovery(root, receipt['recovery'], receipt['baseline'], candidate, originals['C48-N03']['result'], files)\n    modes = {cid: 'executed' if cid in SOURCE_IDS | {'C48-N03'} else 'carried_unaffected' for cid in originals}\n    plan = read(bound(root, qualified['plan']))\n    proof.verify_plan(source, plan, modes)\n    rows = qualified['coverage']\n    require(len(rows) == len(originals) and {r['id'] for r in rows} == set(originals), 'remediation coverage missing/duplicated')\n    require(set(receipt['unaffected']) == set(originals)-SOURCE_IDS-{'C48-N03'}, 'unchanged-impact reason missing')\n    requirements = {r['id']: r for r in plan['requirements']}\n    for row in rows:\n        cid = row['id']; require(row['disposition'] == modes[cid], 'remediation disposition differs')\n        if cid in SOURCE_IDS | {'C48-N03'}:\n            expected = {'schema': 'airs-desktop/p11-affected-selector-result/1', 'required_id': cid,\n                'actual_evidence': selector_reference(receipt, cid),\n                'original_result': originals[cid]['result'],\n                'meaning': 'Actual affected selectors supplement the retained original registered goal. No full original command or unrelated native flow is claimed newly executed.'}\n            require(read(bound(root, row['result'])) == expected, 'affected goal lacks actual selector evidence')\n            continue\n        require(row['result'] == originals[cid]['result'] and receipt['unaffected'][cid], 'original result was relabelled')\n        original = read(bound(root, row['result'])); origin = read(bound(root, original['candidate']))\n        deps = dependencies(files, cid, requirements[cid].get('helper_paths', []))\n        require(requirements[cid].get('dependencies') == deps\n                and row['impact']['dependencies'] == deps\n                and row['impact']['reason'] == receipt['unaffected'][cid]\n                and row['impact']['original_candidate_sha256'] == original['candidate']['sha256'],\n                'remediation dependency scope/rationale differs')\n        impact = read(bound(root, row['impact']['proof']))\n        bindings = impact['file_bindings']\n        require(set(bindings) == set(deps) and deps\n                and impact['unchanged_dependencies'] == deps\n                and impact['current_source_inventory_sha256'] == qualified['source_inventory_sha256']\n                and impact['original_candidate_sha256'] == original['candidate']['sha256'],\n                'remediation dependency proof binding differs')\n        old_source = history.source(origin['source_inventory_sha256'])\n        for name in deps:\n            value = bindings[name]\n            require(value['original_sha256'] == value['current_sha256'] == sha(source/name) == sha(old_source/name),\n                    'carried dependency changed: ' + name)\n    # The old custom partial Check rows were already validated above in their\n    # archived source. Their failed full-run status must not be rewritten to\n    # satisfy the generic all-pass-run parser. Other original raw rows use it.\n    generic_ids = {cid for cid in originals if cid not in SOURCE_IDS | {'C48-N03'} and not cid.startswith('check:')}\n    runtime_plan = read(bound(root, qualified['runtime_plan']))\n    require(runtime_plan == dict(plan, requirements=[r for r in plan['requirements'] if r['id'] in generic_ids]),\n            'remediation generic coverage projection differs')\n    proof.coverage.verify(root, dict(qualified, plan=qualified['runtime_plan'],\n        coverage=[r for r in rows if r['id'] in generic_ids]), historical=historical)\n    return {'qualified': True, 'required': len(rows),\n            'dispositions': {m: sum(r['disposition'] == m for r in rows) for m in sorted(set(modes.values()))},\n            'candidate_sha256': qualified['candidate']['sha256'], 'source_inventory_sha256': qualified['source_inventory_sha256']}\n\n\ndef versioned_build(root, build, candidate):\n    path = candidate['prepare']['path']\n    prefix, suffix = 'docs/planning/evidence/P11/native-build-', '-vm/native-prepare.json'\n    number = path.removeprefix(prefix).removesuffix(suffix)\n    require(number.isdigit() and int(number) >= 5 and path == f'{prefix}{int(number):02}{suffix}',\n            'new build may not overwrite the original canonical preparation')\n    argv = ['cargo', 'run', '--locked', '-p', 'xtask', '--example', 'p11_native_candidate', '--', '--out', path]\n    commands = [step['argv'] for step in build['steps']]\n    require(commands and commands[-1] in (argv, argv[:2]+['--offline']+argv[2:])\n            and commands[:-1] in ([], [['pnpm', '--filter', '@prisma-airs/desktop-contracts', 'typecheck'],\n                ['pnpm', '--filter', '@prisma-airs/desktop', 'typecheck']])\n            and build['application_inputs_after'] == build['application_inputs_before'],\n            'versioned native build command/input recipe differs')\n    old = read(root/'docs/planning/evidence/P11/native-prepare.json')\n    current = read(bound(root, candidate['prepare']))\n    require(current['commands'] == old['commands'] and current['target'] == old['target']\n            and current['features'] == old['features'] and current['subject'] == 'P11',\n            'versioned build changed the fixture recipe')\n\n\ndef make(root, receipt_path, out):\n    require(not out.exists(), 'preserve previous remediation qualification')\n    receipt = read(receipt_path)\n    files = read(bound(root, receipt['current_source']))['files']\n    old = read(bound(root, receipt['baseline']))\n    original = read(bound(root, old['coverage']))\n    prepared = read(bound(root, receipt['prepare']))\n    native = read(bound(root, receipt['recovery']))\n    candidate = dict(source_inventory_sha256=digest(files), execution_root=str(root),\n        runner_inputs=receipt['runner_inputs'], dependency_fingerprint=receipt['runner_inputs']['dependencies'],\n        prepare=receipt['prepare'], executable_sha256=prepared['executable_sha256'],\n        bundle_sha256=prepared['bundle_sha256'], build_flags={'target': prepared['target'], 'features': prepared['features']},\n        conditions=read(bound(root, native['raw']))['conditions'], helper_closure=native['helper_closure'])\n    history = ArchivedP11(root, receipt['historical_context'])\n    out.mkdir(parents=True)\n    def write(name, value):\n        p = out/name; p.parent.mkdir(parents=True, exist_ok=True)\n        with p.open('x') as stream: json.dump(value, stream, indent=2); stream.write('\\n')\n        return proof.reference(root, p)\n    candidate_ref = write('candidate.json', candidate)\n    requirements = copy.deepcopy(read(bound(root, original['plan']))['requirements'])\n    by_id = {r['id']: r for r in requirements}; rows = []\n    for original_row in original['coverage']:\n        cid = original_row['id']; needed = by_id[cid]\n        affected = cid in SOURCE_IDS | {'C48-N03'}\n        needed.update(affected=affected, must_execute=affected)\n        if affected:\n            result = write('results/'+cid.replace(':', '-').replace('/', '-')+'.json', {\n                'schema': 'airs-desktop/p11-affected-selector-result/1', 'required_id': cid,\n                'actual_evidence': selector_reference(receipt, cid),\n                'original_result': original_row['result'],\n                'meaning': 'Actual affected selectors supplement the retained original registered goal. No full original command or unrelated native flow is claimed newly executed.'})\n            rows.append(dict(id=cid, disposition='executed', result=result))\n            continue\n        result = read(bound(root, original_row['result'])); origin = read(bound(root, result['candidate']))\n        deps = dependencies(files, cid, needed.get('helper_paths', [])); needed['dependencies'] = deps\n        old_source = history.source(origin['source_inventory_sha256'])\n        bindings = {name: {'original_sha256': sha(old_source/name), 'current_sha256': sha(root/name),\n            'original_file': proof.reference(root, old_source/name)} for name in deps}\n        impact = write('impact/'+cid.replace(':', '-').replace('/', '-')+'.json', {\n            'file_bindings': bindings, 'unchanged_dependencies': deps,\n            'current_source_inventory_sha256': digest(files), 'original_candidate_sha256': result['candidate']['sha256']})\n        rows.append(dict(id=cid, disposition='carried_unaffected', result=original_row['result'], impact={\n            'reason': receipt['unaffected'][cid], 'dependencies': deps, 'proof': impact,\n            'original_candidate_sha256': result['candidate']['sha256']}))\n    plan = {'schema': 'airs-desktop/required-coverage/1', 'subject': 'P11', 'requirements': requirements}\n    plan_ref = write('required-coverage.json', plan)\n    generic_ids = {r['id'] for r in rows if r['disposition'] == 'carried_unaffected' and not r['id'].startswith('check:')}\n    runtime = write('runtime-required-coverage.json', dict(plan,\n        requirements=[r for r in requirements if r['id'] in generic_ids]))\n    qualified = write('coverage.json', {'schema': 'airs-desktop/qualified-coverage/1', 'plan': plan_ref,\n        'candidate': candidate_ref, 'source_inventory_sha256': digest(files), 'coverage': rows,\n        'runtime_plan': runtime, 'review_remediation': proof.reference(root, receipt_path)})\n    record = {'schema': 'airs-desktop/p11-shared-qualification/1', 'source': receipt['current_source'],\n        'coverage': qualified, 'runner_inputs': receipt['runner_inputs'], 'fingerprint': receipt['fingerprint'],\n        'native_execution': native['raw'], 'build': receipt['build'], 'runs': old['runs'],\n        'historical_baseline': old['historical_baseline'], 'historical_standing': old['historical_standing'],\n        'review_remediation': proof.reference(root, receipt_path), 'controller_complete': False,\n        'historical_use': 'Original qualification02 results/artifacts remain bound. Only explicit affected source selectors and native recovery execute anew; unrelated results retain original process/source/artifact provenance.'}\n    path = write('qualification.json', record)\n    return proof.verify(root, root/path['path'])\n\n\nif __name__ == '__main__':\n    parser = argparse.ArgumentParser(description=__doc__)\n    parser.add_argument('receipt', type=Path)\n    parser.add_argument('--out', required=True, type=Path)\n    args = parser.parse_args()\n    print(json.dumps(make(Path.cwd().resolve(), args.receipt.resolve(), args.out.resolve()), indent=2))\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_27","type":"command_execution","command":"/bin/zsh -lc \"cat tools/p10/candidate.py; sed -n '900,1040p' tools/p11/proof.py; cat docs/planning/evidence/P11/remediation-selection-02/receipt.json\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_27","type":"command_execution","command":"/bin/zsh -lc \"cat tools/p10/candidate.py; sed -n '900,1040p' tools/p11/proof.py; cat docs/planning/evidence/P11/remediation-selection-02/receipt.json\"","aggregated_output":"\"\"\"Candidate/source bindings shared by C45 qualification and actual reviews.\"\"\"\nfrom pathlib import Path\nimport ast\nimport os\nimport stat\nimport sys\nsys.path.insert(0,str(Path(__file__).resolve().parents[1]/'p09'))\nfrom phase_packet import source_inventory, file_identity, digest\nfrom qualification import read, sha, require\n\n\ndef bundle_hash(bundle):\n    entries=[]\n    for base, directories, files in os.walk(bundle,followlinks=False):\n        symlinks=[name for name in directories if (Path(base)/name).is_symlink()]\n        directories[:]=[name for name in directories if name not in symlinks]\n        for name in files+symlinks:\n            path=Path(base)/name;relative=str(path.relative_to(bundle))\n            if path.is_symlink():mode='symlink';value=__import__('hashlib').sha256(os.readlink(path).encode()).hexdigest()\n            else:mode='100755' if path.stat().st_mode & 0o111 else '100644';value=sha(path)\n            entries.append((relative,mode,value))\n    text=''.join(f'{name}\\0{mode}\\0{value}\\n' for name,mode,value in sorted(entries))\n    return __import__('hashlib').sha256(text.encode()).hexdigest()\n\n\ndef helper_closure(root, driver):\n    folder=root/'tools/native-acceptance';pending=[driver];seen=set()\n    while pending:\n        name=pending.pop()\n        if name in seen or not (folder/(name+'.py')).is_file():continue\n        seen.add(name);tree=ast.parse((folder/(name+'.py')).read_text())\n        for node in ast.walk(tree):\n            if isinstance(node,ast.Import):pending.extend(alias.name.split('.')[0] for alias in node.names)\n            elif isinstance(node,ast.ImportFrom) and node.module:pending.append(node.module.split('.')[0])\n    paths=['tools/native-acceptance/'+name+'.py' for name in seen]\n    # Native compiled helpers/servers are used through literal paths, not imports.\n    paths += [str(p.relative_to(root)) for p in folder.iterdir() if p.suffix in ['.swift','.js']]\n    paths += ['tools/p10/native.py','tools/p10/candidate.py','docs/planning/evidence/P09/native-controller/native_requirements.py']\n    return {name:sha(root/name) for name in sorted(set(paths))}\n\n\ndef verify_source(root, seal):\n    expected=read(root/seal)['files']\n    require(source_inventory(root)==expected,'sealed source membership/content changed')\n    return digest(expected)\n\n\ndef verify_candidate(root, value, historical=None):\n    prepared=read(root/value['prepare']['path'])\n    require(sha(root/value['prepare']['path'])==value['prepare']['sha256'],'preparation drift')\n    bundle=historical.application(value) if historical else root/prepared['bundle']\n    require(sha(bundle/'Contents/MacOS/prisma-airs-desktop')==value['executable_sha256']==prepared['executable_sha256'],'candidate executable drift')\n    require(bundle_hash(bundle)==value['bundle_sha256']==prepared['bundle_sha256'],'complete candidate bundle drift')\n    helper_root=historical.source(value['source_inventory_sha256']) if historical else root\n    for name,value_hash in value['helper_closure'].items():require(sha(helper_root/name)==value_hash,'candidate helper drift: '+name)\n    if value.get('build_origin'):\n        import platform\n        origin=value['build_origin'];path=root/origin['record']\n        require(sha(path)==origin['sha256'],'build origin proof drift')\n        audit=verify_build_reuse(root,read(path),value['runner_inputs'],platform.platform(),platform.node(),historical=historical)\n        require(audit==origin['audit'],'build reuse audit drift')\n    return value\n\n# Explicit helper/provenance-only transition after the baseline02 startup smoke.\n# No application/config/dependency path is permitted. Old raw build and failed\n# smoke remain immutable; this is not a new execution of that build.\nBUILD_REUSE_PATHS = {\n    'tools/p10/historical.py','tools/p10/test_historical.py',\n    'tools/p10/provenance_followup.py','tools/p10/qualification.py',\n    'tools/p10/review_gate.py','tools/p10/followup.py',\n    'crates/xtask/tests/controlled_live.rs',\n    'crates/xtask/tests/live_run/common.rs',\n    'crates/xtask/examples/c45_baseline.rs',\n    'tools/p10/packet.py','tools/p10/followup.py','tools/p10/test_followup.py',\n    'tools/native-acceptance/acceptance_c04.py',\n    'tools/native-acceptance/test_c04_current_frame.py',\n    'tools/native-acceptance/acceptance_c45.py',\n    'tools/p10/candidate.py', 'tools/p10/test_build_reuse.py',\n    'tools/p10/supervise.py', 'tools/p10/seal.py',\n    'tools/p10/finalize.py', 'tools/p10/native.py',\n    'apps/desktop/src-tauri/tests/permission_manifest.rs',\n    'tools/p10/continuation.py', 'tools/p10/test_continuation.py',\n    'tools/native-acceptance/acceptance_c32_current.py',\n    'tools/native-acceptance/test_c32_project_path.py',\n}\n\n\ndef verify_build_reuse(root, record, current_identity, platform_name, hostname, historical=None):\n    from qualification import bound\n    from stages import verify_completed\n    require(record['schema']=='airs-desktop/c45-helper-only-build-reuse/1','build reuse schema')\n    old=read(bound(root,record['original_candidate']))\n    before=read(bound(root,record['original_source']))['files']\n    after=read(bound(root,record['current_source']))['files']\n    changed=sorted(name for name in set(before)|set(after) if before.get(name)!=after.get(name))\n    require(changed==record['declared_changed_paths'] and set(changed)<=BUILD_REUSE_PATHS,'undeclared or application-affecting build-reuse delta')\n    if historical:\n        historical.source(digest(before));historical.source(digest(after))\n    else:require(source_inventory(root)==after,'current build-reuse source changed')\n    require(digest(before)==old['source_inventory_sha256'],'original source seal/candidate mismatch')\n    require(current_identity['dependencies']==old['runner_inputs']['dependencies'] and current_identity['build_flags']==old['runner_inputs']['build_flags'],'build dependency/toolchain/flags changed')\n    if not historical:require(old['conditions']['platform']==platform_name and old['conditions']['hostname']==hostname,'build execution conditions changed')\n    state_path=bound(root,record['original_build_stage']);state=read(state_path)\n    verify_completed(root,state_path.parent,state,state['argv'],digest(before))\n    prepared=read(bound(root,old['prepare']));bundle=historical.application(old) if historical else root/prepared['bundle']\n    require(sha(bundle/'Contents/MacOS/prisma-airs-desktop')==old['executable_sha256']==prepared['executable_sha256'],'retained executable changed')\n    require(bundle_hash(bundle)==old['bundle_sha256']==prepared['bundle_sha256'],'retained complete bundle changed')\n    return {'original_candidate_sha256':record['original_candidate']['sha256'],'original_build_stage_sha256':record['original_build_stage']['sha256'],'declared_helper_only_delta':changed,'executable_sha256':old['executable_sha256'],'bundle_sha256':old['bundle_sha256'],'new_build_executed':False,'meaning':'Exact unchanged application retained from actual baseline02 build; changed C45 selector and qualification provenance execute current affected verification.'}\n            log = reference(root, origin_path.parent / actual['log'])\n            result = dict(status='pass', exit_code=0, execution_id=origin['run_id'],\n                          argv=actual['argv'], cwd=str(root), started_utc=origin['started_utc'],\n                          finished_utc=origin['finished_utc'], required_ids=[cid], log=log,\n                          candidate=candidate_ref, raw=reference(root, origin_path), evidence={})\n            if selected_check and choice['disposition'] != 'reused_exact':\n                result.update(original_runner_inputs=origin['inputs_before'], reason=choice['reason'])\n            if reuse and choice['disposition'] == 'reused_exact':\n                result['candidate'] = reuse['record']['baseline_candidate']\n                result['cwd'] = reuse['origin']['execution_root']\n            if selection and kind == 'test' and choice['disposition'] == 'carried_unaffected':\n                result['candidate'] = selection['record']['baseline_candidate']\n                result['cwd'] = selection['origin']['execution_root']\n            result_ref = write('results/' + kind + '-' + needed['label'].replace('/', '-') + '.json', result)\n            row = dict(id=cid, disposition=choice['disposition'], result=result_ref)\n            if selection and kind == 'test' and choice['disposition'] == 'carried_unaffected':\n                deps = selection['dependencies']\n                bindings = {name: {'original_sha256': sha(root / D2_SOURCE / name),\n                                    'current_sha256': sha(root / name),\n                                    'original_file': reference(root, root / D2_SOURCE / name)}\n                            for name in deps}\n                impact_ref = write('impact/' + needed['label'].replace('/', '-') + '.json', {\n                    'file_bindings': bindings, 'unchanged_dependencies': deps,\n                    'current_source_inventory_sha256': digest(source),\n                    'original_candidate_sha256': selection['record']['baseline_candidate']['sha256']})\n                row['impact'] = {'reason': selection['record']['reason'], 'dependencies': deps,\n                                 'original_candidate_sha256': selection['record']['baseline_candidate']['sha256'],\n                                 'proof': impact_ref}\n            rows.append(row)\n    expected = {row['id'] for chunk in CHUNKS for row in\n                read(root / 'docs/architecture/native-checks.json')['chunks'][chunk]}\n    require(len(acceptance['checks']) == len(expected)\n            and {row['id'] for row in acceptance['checks']} == expected,\n            'native acceptance does not cover exactly the twelve P11 assertions')\n    native_contexts = {}\n    for row in acceptance['checks']:\n        cid = row['id']\n        require(row['result'] == 'pass' and row['observation'] and row['evidence'],\n                'native assertion not established: ' + cid)\n        evidence = {name: sha(root / name) for name in row['evidence']}\n        origin = per_native.get(cid)\n        actual = origin['raw'] if origin else performed\n        raw_path = origin['raw_path'] if origin else execution\n        mode = origin['disposition'] if origin else 'executed'\n        require(str(execution.relative_to(root)) in evidence and str(raw_path.relative_to(root)) in evidence,\n                'native row omits original execution provenance')\n        requirements.append(dict(id=cid, kind='native', argv=actual['argv'], affected=mode == 'executed',\n            must_execute=mode == 'executed', helper_paths=origin['helper_paths'] if origin else sorted(helpers)))\n        native_candidate = candidate_ref\n        if mode == 'reused_exact':\n            if cid == 'C46-N01':\n                native_candidate = reuse['record']['baseline_candidate']\n            else:\n                key = sha(raw_path)\n                if key not in native_contexts:\n                    native_contexts[key] = write('native-origins/' + actual['execution_id'] + '-' + key[:8] + '.json',\n                        equivalent_native_origin(root, raw_path, actual, candidate, root))\n                native_candidate = native_contexts[key]\n        result = dict(status='pass', exit_code=0, execution_id=actual['execution_id'],\n                      argv=actual['argv'], cwd=str(root), started_utc=actual['started_utc'],\n                      finished_utc=actual['finished_utc'], required_ids=[cid],\n                      log=reference(root, raw_path), candidate=native_candidate,\n                      raw=reference(root, native), evidence=evidence)\n        if continuation:\n            result['process_exit_code'] = actual['exit_code']\n        rows.append(dict(id=cid, disposition=mode, result=write('results/' + cid + '.json', result)))\n    plan = write('required-coverage.json', {'schema': 'airs-desktop/required-coverage/1',\n                 'subject': 'P11', 'requirements': requirements})\n    qualified_record = {'schema': 'airs-desktop/qualified-coverage/1',\n                      'plan': plan, 'candidate': candidate_ref,\n                      'source_inventory_sha256': digest(source), 'coverage': rows}\n    if selection:\n        custom_checks = {row['id'] for row in rows if row['id'].startswith('check:')\n                         and row['disposition'] != 'reused_exact'}\n        qualified_record.update(impact_selection=reference(root, impact),\n            impact_source=reuse['record']['current_source'] if reuse else selection['record']['current_source'],\n            runtime_plan=write('runtime-required-coverage.json', {\n                'schema': 'airs-desktop/required-coverage/1', 'subject': 'P11',\n                'requirements': [r for r in requirements if r['id'] not in custom_checks]}))\n        if reuse:\n            qualified_record['helper_source_carry'] = reference(root, helper_carry)\n    elif 'selection' in runs['check']:\n        qualified_record.update(check_selection=reference(root, check),\n            check_source=runs['check']['selection']['current_source'],\n            runtime_plan=write('runtime-required-coverage.json', {\n                'schema': 'airs-desktop/required-coverage/1', 'subject': 'P11',\n                'requirements': [r for r in requirements if not r['id'].startswith('check:')]}))\n    if continuation:\n        qualified_record.update(native_acceptance=reference(root, native), native_selection=reference(root, execution))\n    qualified = write('coverage.json', qualified_record)\n    record = {'schema': 'airs-desktop/p11-shared-qualification/1', 'source': seal,\n              'coverage': qualified, 'runs': {'check': reference(root, check), 'test': reference(root, tests)},\n              'runner_inputs': runner_inputs, 'fingerprint': reference(root, fingerprint),\n              'native_execution': reference(root, execution),\n              'build': reference(root, build),\n              'historical_baseline': reference(root, root / 'docs/planning/evidence/P10/completion-proof.json'),\n              'historical_use': 'Original P10 standing/artifact bindings retained. No old result is relabelled current and no RC1 byte equality is claimed. P11 executes the changed-flow requirements on one shared candidate.',\n              'controller_complete': False}\n    if selection:\n        record['impact_selection'] = reference(root, impact)\n    if continuation:\n        record['native_acceptance'] = reference(root, native)\n    if reuse:\n        record['helper_source_carry'] = reference(root, helper_carry)\n    if carry is not None:\n        record['build_input_carry'] = reference(root, carry)\n    from review_gate import release_prerequisites\n    record['historical_standing'] = release_prerequisites(root)\n    record_ref = write('qualification.json', record)\n    return verify(root, root / record_ref['path'])\n\n\nif __name__ == '__main__':\n    parser = argparse.ArgumentParser(description=__doc__)\n    actions = parser.add_subparsers(dest='action', required=True)\n    inspect = actions.add_parser('verify')\n    inspect.add_argument('record', type=Path)\n    create = actions.add_parser('make')\n    for flag in ('check', 'tests', 'fingerprint', 'prepare', 'native', 'execution', 'build', 'out'):\n        create.add_argument('--' + flag, type=Path, required=True)\n    create.add_argument('--build-input-carry', type=Path)\n    create.add_argument('--impact-selection', type=Path)\n    create.add_argument('--helper-source-carry', type=Path)\n    args = parser.parse_args()\n    root = Path.cwd().resolve()\n    if args.action == 'verify':\n        result = verify(root, args.record.resolve())\n    else:\n        result = make(root, *[getattr(args, key).resolve() for key in\n                             ('check', 'tests', 'fingerprint', 'prepare', 'native', 'execution', 'build', 'out')],\n                      carry=args.build_input_carry.resolve() if args.build_input_carry else None,\n                      impact=args.impact_selection.resolve() if args.impact_selection else None,\n                      helper_carry=args.helper_source_carry.resolve() if args.helper_source_carry else None)\n    print(json.dumps(result, indent=2))\n{\n  \"schema\": \"airs-desktop/p11-review-remediation/1\",\n  \"baseline\": {\n    \"path\": \"docs/planning/evidence/P11/qualification-final-02/qualification.json\",\n    \"sha256\": \"e7817dc4490720470560c3f21124849bdc8a9ab98412f8e1a78c5de62003fd56\"\n  },\n  \"historical_context\": {\n    \"path\": \"docs/planning/evidence/P11/remediation-baseline-01/historical-context.json\",\n    \"sha256\": \"6867415a5b9f6f62c75601f7de2bed6afec3c79e58b2b3588af12e1a9119c7db\"\n  },\n  \"preserved_candidate\": {\n    \"path\": \"docs/planning/evidence/P11/remediation-baseline-01/receipt.json\",\n    \"sha256\": \"2e03f767395d48de3a9dd797b82ad2df6911878ecec5cbe29b5129e11e13bd9e\"\n  },\n  \"current_source\": {\n    \"path\": \"docs/planning/evidence/P11/remediation-selection-02/source-current.json\",\n    \"sha256\": \"802017c8632e05febf7c7f047f249e79b23e20c37e1260492095e15194b3916e\"\n  },\n  \"fingerprint\": {\n    \"path\": \"docs/planning/evidence/P11/remediation-selection-02/fingerprint.json\",\n    \"sha256\": \"c489702b6c701f148ed1a9fe631ae3fa0f963da22dd7d906d7f4e09f036f23c5\"\n  },\n  \"runner_inputs\": {\n    \"source\": \"5e8e8bb12e9efda00f04da5be85184190b9c97f6d2bb21a96c82197f86eccbdd\",\n    \"dependencies\": \"2c489f82dc23ebf9680a9cb5977071253b226b29c8f019f1fb43db4ff3384326\",\n    \"build_flags\": \"2b2