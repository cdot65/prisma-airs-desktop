t _ = session.delete(&old);\n            }\n            effects.push(Effect::Cleanup);\n            state.changed();\n        }\n        Intent::ChooseSetupProducts { context, products } => {\n            state.require_storage()?;\n            let before = state.data.clone();\n            state.choose_setup_products(&context, products)?;\n            state.save_with(&before)?;\n            state.changed();\n        }\n        Intent::VerifyTenantSetup { context } => {\n            let starts = state.begin_verify(\n                &context,\n                Arc::clone(&adapters.keychain),\n                Arc::clone(session),\n            )?;\n            effects.push(Effect::Start(starts));\n            effects.push(Effect::Start(state.take_gateway_starts()));\n            state.changed();\n        }\n        Intent::CompleteTenantSetup {\n            context,\n            packs,\n            resolution,\n        } => {\n            state.require_storage()?;\n            let draft = state.completable_setup(&context, &packs)?;\n            // Completion makes the new tenant active: the one guarded switch\n            // path (I1). A pending Harness decision refuses it, with the\n            // draft, the active tenant and the decision all untouched.\n            let resolution = match state.guard_switch(&draft, resolution, Some(&context)) {\n                Ok(resolution) => resolution,\n                Err(refusal) => {\n                    state.changed();\n                    return Err(refusal);\n                }\n            };\n            let before = state.data.clone();\n            let recorded_secs = wall_secs(state.clock_offset);\n            let done = state.complete_setup(&context, packs, recorded_secs)?;\n            state.save_with(&before)?;\n            if let Some(resolution) = resolution {\n                resolution.resolve(state)?;\n            }\n            effects.extend(state.take_history_jobs());\n            state.retire_setup_context(&context, done.retired_workspace.as_ref());\n            effects.push(Effect::Start(state.reissue_context()));\n            effects.push(Effect::Start(state.take_gateway_starts()));\n            if !done.packs.is_empty() {\n                let (lease, write) = state.queue_examples(&done.tenant, &done.packs);\n                if let Some(lease) = lease {\n                    effects.push(Effect::LoadLibrary { lease });\n                }\n                if let Some((tenant, generation)) = write {\n                    effects.push(Effect::StoreLibrary { tenant, generation });\n                }\n            }\n            let _ = done.first_run;\n            state.changed();\n        }\n        Intent::DiscardTenantSetup { context } => {\n            if state.setup_has_keychain_credential() {\n                state.require_storage()?;\n            }\n            let before = state.data.clone();\n            let retired = state.discard_setup(&context)?;\n            if state.storage == StorageHealth::Ready {\n                state.save_with(&before)?;\n            }\n            for old in retired {\n                let _ = session.delete(&old);\n            }\n            effects.push(Effect::Start(state.take_gateway_starts()));\n            effects.push(Effect::Cleanup);\n            state.changed();\n        }\n        Intent::CreateTenant { profile } => {\n            if !state.fixture_tenant_creation {\n                return Err(Refusal::InvalidInput);\n            }\n            state.require_storage()?;\n            let profile = profile.validate().ok_or(Refusal::InvalidInput)?;\n            if state.data.tenants.len() >= MAX_TENANTS {\n                return Err(Refusal::Busy);\n            }\n            let id = TenantId::issue().ok_or(Refusal::ShuttingDown)?;\n            let before = state.data.clone();\n            let select = state.data.active.is_none();\n            state.data.tenants.push(Tenant::new(TenantProfile {\n                id: id.clone(),\n                label: profile.label,\n                tsg_id: profile.tsg_id,\n158:    VerifyTenantSetup {\n165:    CompleteTenantSetup {\n254:    ConfigureManagementCredential {\n261:    RemoveManagementCredential {\n777:    VerifyTenantSetup => \"verifyTenantSetup\",\n778:    CompleteTenantSetup => \"completeTenantSetup\",\n794:    ConfigureManagementCredential => \"configureManagementCredential\",\n795:    RemoveManagementCredential => \"removeManagementCredential\",\n3657:        Intent::VerifyTenantSetup { context } => {\n3667:        Intent::CompleteTenantSetup {\n3686:            let done = state.complete_setup(&context, packs, recorded_secs)?;\n4038:        Intent::ConfigureManagementCredential {\n4074:        Intent::RemoveManagementCredential { context } => {\n5767:        state.reissue_setup_context();\n5846:        state.reissue_setup_context();\n            workspace,\n            endpoint,\n            secret,\n        } => {\n            // The key is bound to the workspace chosen now (natively) and\n            // to the runtime endpoint entered with it.\n            let workspace = state.inference_workspace(&context, &workspace)?;\n            let target = crate::gateway_inference::InferenceTarget {\n                workspace,\n                endpoint,\n            };\n            if !target.is_valid()\n                || secret.expose().is_empty()\n                || secret.expose().len() > MAX_SECRET_BYTES\n                || !secret.expose().bytes().all(|b| b.is_ascii_graphic())\n            {\n                return Err(Refusal::InvalidInput);\n            }\n            configure_credential(\n                state,\n                session,\n                effects,\n                &context,\n                CredentialClass::Inference,\n                mode,\n                secret,\n                None,\n                Some(target),\n            )?;\n        }\n        Intent::RemoveInferenceCredential { context } => {\n            remove_credential(\n                state,\n                session,\n                effects,\n                &context,\n                CredentialClass::Inference,\n            )?;\n        }\n        Intent::RunInference {\n            context,\n            workspace,\n            run,\n        } => {\n            let (operation, starts) = state.run_inference(\n                context,\n                workspace,\n                run,\n                Arc::clone(&adapters.keychain),\n                Arc::clone(session),\n            )?;\n            operation_ref = Some(operation);\n            effects.push(Effect::Start(starts));\n            state.changed();\n        }\n        Intent::ReadGatewayFiles { context, workspace } => {\n            let (operation, starts) = state.read_files(\n                context,\n                workspace,\n                Arc::clone(&adapters.keychain),\n                Arc::clone(session),\n            )?;\n            operation_ref = Some(operation);\n            effects.push(Effect::Start(starts));\n            state.changed();\n        }\n        Intent::ChooseGatewayFile { context, workspace } => {\n            let lease = state.choose_file(\n                context,\n                workspace,\n                Arc::clone(&adapters.keychain),\n                Arc::clone(session),\n            )?;\n            effects.push(Effect::ChooseGatewayFile { lease });\n            state.changed();\n        }\n        Intent::UploadGatewayFile {\n            context,\n            workspace,\n            file,\n        } => {\n            let (operation, starts) = state.upload_file(\n                context,\n                workspace,\n                &file,\n                Arc::clone(&adapters.keychain),\n                Arc::clone(session),\n            )?;\n            operation_ref = Some(operation);\n            effects.push(Effect::Start(starts));\n            state.changed();\n        }\n        Intent::DeleteGatewayFile {\n            context,\n            workspace,\n            file,\n        } => {\n            let (operation, starts) = state.delete_file(\n                context,\n                workspace,\n                &file,\n                Arc::clone(&adapters.keychain),\n                Arc::clone(session),\n            )?;\n            operation_ref = Some(operation);\n            effects.push(Effect::Start(starts));\n            state.changed();\n        }\n        Intent::StopInference { operation } => {\n            let starts = state.stop_inference(&operation)?;\n            effects.push(Effect::Start(starts));\n            state.changed();\n        }\n        Intent::ClearInference { operation } => {\n            state.clear_inference(&operation)?;\n            state.changed();\n        }\n        Intent::StartHarness { context, workspace } => {\n            let start = state.start_harness(\n                context,\n                workspace,\n                &adapters.harness,\n                Arc::clone(&adapters.keychain),\n                Arc::clone(session),\n                None,\n            )?;\n            operation_ref = Some(start.id.clone());\n            effects.push(Effect::Harness(Box::new(start)));\n            state.changed();\n        }\n        Intent::ChooseHarnessProject { context } => {\n            state.check_context(&context)?;\n            state.harness_project_refused = None;\n            effects.push(Effect::ChooseHarnessProject(context));\n        }\n        Intent::ClearHarnessProject { context } => {\n            state.clear_harness_project(&context)?;\n            state.changed();\n        }\n        Intent::SetHarnessWrite { context, write } => {\n            state.set_harness_write(&context, write)?;\n            state.changed();\n        }\n        Intent::DecideHarnessApproval {\n            conversation,\n            approval,\n            allow,\n        } => {\n            // Allowing a decision that may change things opens the native\n            // confirmation; only its private completion lets it run (C32).\n            if let Some(harness_tools::NativeDecisionConfirmation {\n                nonce,\n                request,\n                presentation,\n            }) = state.decide_harness_approval(&conversation, &approval, allow)?\n            {\n                effects.push(Effect::ConfirmHarness {\n                    conversation,\n                    approval,\n                    nonce,\n                    request,\n                    presentation,\n                });\n            }\n            state.changed();\n        }\n        Intent::ReviewHarnessProposal {\n            conversation,\n            proposal,\n        } => {\n            let (operation, starts) = state.review_harness_proposal(\n                &conversation,\n                &proposal,\n                Arc::clone(&adapters.keychain),\n                Arc::clone(session),\n            )?;\n            operation_ref = operation;\n            effects.push(Effect::Start(starts));\n            state.changed();\n        }\n        Intent::DismissHarnessProposal {\n            conversation,\n            proposal,\n        } => {\n            state.dismiss_harness_proposal(&conversation, &proposal)?;\n            state.changed();\n        }\n        Intent::ConfirmHarnessWrite {\n            conversation,\n            allow,\n        } => {\n            if let Some(job) = state.confirm_harness_write(&conversation, allow)? {\n                effects.push(Effect::HarnessRenew(Box::new(job)));\n            }\n            state.changed();\n        }\n        Intent::ListMcpServers { context, workspace } => {\n            effects.push(state.list_mcp_servers(&context, &workspace)?);\n            state.changed();\n        }\n        Intent::EnableMcpServer {\n            context,\n            workspace,\n            server,\n            enabled,\n        } => {\n            state.enable_mcp_server(&context, &workspace, &server, enabled)?;\n            state.changed();\n        }\n        Intent::SignInMcpServer {\n            context,\n            workspace,\n            server,\n        } => {\n            effects.push(state.begin_mcp_sign_in(&context, &workspace, &server)?);\n            state.changed();\n        }\n        Intent::CancelMcpSignIn { context } => {\n            state.cancel_mcp_sign_in(&context)?;\n            state.changed();\n        }\n        Intent::SignOutMcpServer {\n            context,\n            workspace,\n            server,\n        } => {\n            if let Some(grant) = state.sign_out_mcp_server(&context, &workspace, &server)? {\n                effects.push(Effect::McpSignedOut(grant));\n            }\n            effects.push(Effect::Cleanup);\n            state.changed();\n            if list.count > 0 {\n                (\n                    VerifyState::Warning,\n                    format!(\n                        \"{} Gateway workspace(s) readable; none chosen, so its prerequisites were not checked.\",\n                        list.count\n                    ),\n                )\n            } else {\n                (\n                    VerifyState::Warning,\n                    \"No Gateway workspace in this tenant yet.\".to_owned(),\n                )\n            }\n        }\n        (\n            VerifyLine::Gateway,\n            ManagementResult::Gateway {\n                gateway: GatewayResult::Prerequisites { prerequisites },\n            },\n        ) => {\n            let sources = [\n                (\"routes\", prerequisites.routes_failure),\n                (\"providers\", prerequisites.providers_failure),\n                (\"integrations\", prerequisites.integrations_failure),\n                (\"service keys\", prerequisites.service_keys_failure),\n            ];\n            let mut failed: Vec<String> = sources\n                .iter()\n                .filter_map(|(name, f)| f.map(|f| format!(\"{name}: {}\", failure_reason(f))))\n                .collect();\n            // Every source attempted counts: the IAM scope binding and the\n            // three planes are part of the prerequisites, not decoration.\n            let plane = |name: &str, access: PlaneAccess| match access {\n                PlaneAccess::Granted => None,\n                PlaneAccess::Denied => Some(format!(\"{name} plane: permission refused\")),\n                PlaneAccess::Failed => Some(format!(\"{name} plane: reads failed\")),\n            };\n            failed.extend(plane(\"data\", prerequisites.data_plane));\n            failed.extend(plane(\"admin\", prerequisites.admin_plane));\n            failed.extend(plane(\"IAM\", prerequisites.iam_plane));\n            failed.extend(match prerequisites.scope {\n                ScopeBinding::Bound => None,\n                ScopeBinding::Unbound => Some(format!(\n                    \"scope {} does not list the workspace\",\n                    prerequisites.scope_name\n                )),\n                ScopeBinding::Absent => {\n                    Some(format!(\"scope {} does not exist\", prerequisites.scope_name))\n                }\n                ScopeBinding::Denied => Some(format!(\n                    \"scope {} may not be read by this client\",\n                    prerequisites.scope_name\n                )),\n                ScopeBinding::Failed => Some(format!(\n                    \"scope {} could not be read\",\n                    prerequisites.scope_name\n                )),\n            });\n            let lists_failed = sources.iter().filter(|(_, f)| f.is_some()).count();\n            if failed.is_empty() {\n                (\n                    VerifyState::Pass,\n                    format!(\n                        \"Workspace {}: {} route(s), {} provider(s), {} inference key(s) readable.\",\n                        prerequisites.workspace,\n                        prerequisites.routes.as_ref().map_or(0, |l| l.count),\n                        prerequisites.providers.as_ref().map_or(0, |l| l.count),\n                        prerequisites.inference_keys\n                    ),\n                )\n            } else if lists_failed < sources.len() {\n                (\n                    VerifyState::Warning,\n                    format!(\n                        \"Workspace {}: partial; {}\",\n                        prerequisites.workspace,\n                        failed.join(\"; \")\n                    ),\n                )\n            } else {\n                (\n                    VerifyState::Fail,\n                    format!(\n                        \"Workspace {}: {}\",\n                        prerequisites.workspace,\n                        failed.join(\"; \")\n                    ),\n                )\n            }\n        }\n        (VerifyLine::RedTeam, ManagementResult::RedTeam { observation }) => {\n            match (&observation.scans, &observation.statistics) {\n                (Some(scans), Some(_)) => (\n                    VerifyState::Pass,\n                    format!(\n                        \"Red Team scans and statistics readable ({} scans listed).\",\n                        scans.rows.len()\n                    ),\n                ),\n                (Some(scans), None) => (\n                    VerifyState::Warning,\n                    format!(\n                        \"Red Team scans readable ({} listed); statistics did not: {}\",\n                        scans.rows.len(),\n                        observation\n                            .statistics_failure\n                            .map_or(\"no reason\", failure_reason)\n                    ),\n                ),\n                (None, Some(_)) => (\n                    VerifyState::Warning,\n                    format!(\n                        \"Statistics read; the scan list did not: {}\",\n                        observation\n                            .scans_failure\n                            .map_or(\"no reason\", failure_reason)\n                    ),\n                ),\n                (None, None) => (\n                    VerifyState::Fail,\n                    observation\n                        .scans_failure\n                        .or(observation.statistics_failure)\n                        .map_or(\"The Red Team reads returned nothing.\", failure_reason)\n                        .to_owned(),\n                ),\n            }\n        }\n        (VerifyLine::ModelSkill, ManagementResult::SupplyChain { observation }) => {\n            let ok = [\n                observation.models.is_some(),\n                observation.skills.is_some(),\n                observation.skill_statistics.is_some(),\n            ];\n            let readable = ok.iter().filter(|b| **b).count();\n            if readable == 3 {\n                (\n                    VerifyState::Pass,\n                    format!(\n                        \"AI Supply Chain Security readable ({} model scans, {} skill scans).\",\n                        observation.models.as_ref().map_or(0, |m| m.rows.len()),\n                        observation.skills.as_ref().map_or(0, |s| s.rows.len())\n                    ),\n                )\n            } else {\n            None if overview => (\n                context.as_str().to_owned(),\n                None,\n                self.chosen_scope(&context),\n            ),\n            None => (context.as_str().to_owned(), None, None),\n        };\n        let slot: ResultSlot = Arc::default();\n        let job = ManagementJob {\n            source,\n            request,\n            slot: Arc::clone(&slot),\n            workspace: scope,\n        };\n        let (operation, starts) =\n            self.operations\n                .admit(&domain, 0, job.into_work(), Instant::now())?;\n        self.management_calls.push(ManagementRecord {\n            operation: operation.clone(),\n            context,\n            slot,\n            cell: Arc::default(),\n            settled: false,\n            observed: false,\n            overview,\n            workspace,\n            lists_workspaces,\n            read_part: None,\n            api_keys_page,\n        });\n        if overview {\n            let context = self.management_calls.last().map(|r| r.context.clone());\n            if let Some(context) = context {\n                self.overview_started(&context);\n            }\n        }\n        Ok((operation, starts))\n    }\n\n    /// Admits one product's part of the tenant's Home read (C30, I4): the\n    /// Red Team scans and statistics over the last week, or the model and\n    /// skill scans. The result is observed by the read record, never by a\n    /// presentation observation.\n    pub(super) fn admit_read_part(\n        &mut self,\n        context: ContextRef,\n        product: crate::features::ProductId,\n        keychain: Arc<dyn super::CredentialStore>,\n        session_vault: Arc<SessionVault>,\n    ) -> Result<(OperationId, Vec<crate::runtime::Start>), Refusal> {\n        let request = match product {\n            crate::features::ProductId::RedTeam => ManagementRequest::RedTeam { window: 7 },\n            crate::features::ProductId::ModelSkill => ManagementRequest::SupplyChain,\n            _ => return Err(Refusal::InvalidInput),\n        };\n        let admitted = self.admit_management(context.clone(), request, keychain, session_vault)?;\n        if let Some(record) = self.management_calls.last_mut() {\n            record.read_part = Some(product);\n            record.observed = true;\n        }\n        self.read_part_started(&context);\n        Ok(admitted)\n    }\n\n    /// Delivers settled management results to their single observation.\n    pub(super) fn sync_management_calls(&mut self) {\n        let current = self.active_ref.clone();\n        let mut overviews = Vec::new();\n        let mut parts = Vec::new();\n        let mut key_pages = Vec::new();\n        let mut listings = Vec::new();\n        // A setup's verify reads (C29) belong to the draft's context and\n        // settle into its lines instead of an observation.\n        let setup_context = self.data.setup.as_ref().map(|s| s.context.clone());\n        let setup_operations = self.setup_operations();\n        let warning_operations = self.warning_recheck_operations();\n        let mut setup_results = Vec::new();\n        let selected = self.gateway_selection();\n        let setup_selected = self.setup_workspace_reference();\n        for record in self.management_calls.iter_mut().filter(|r| !r.settled) {\n            let settlement = match self.operations.state(&record.operation) {\n                Some(OperationState::Settled(s)) => s,\n                None => Settlement {\n                    outcome: Outcome::Unknown,\n                    stop: None,\n                },\n                Some(_) => continue,\n            };\n            record.settled = true;\n            let reply = record.slot.lock().ok().and_then(|mut s| s.take());\n            let for_setup = setup_operations.contains(&record.operation)\n                || warning_operations.contains(&record.operation);\n            // The draft's context stays current for every read admitted under\n            // it (its verify lines and the presentation's own reads, such as\n            // the Gateway workspace listing) until the draft ends.\n            let retired = (current.as_ref() != Some(&record.context)\n                && setup_context.as_ref() != Some(&record.context))\n                || record.workspace.as_ref().is_some_and(|w| {\n                    selected.as_ref() != Some(w) && setup_selected.as_ref() != Some(w)\n                });\n            let result = match (reply, retired, settlement.stop) {\n                // A reply for a retired context is never shown.\n                (_, true, _) | (_, _, Some(_)) | (None, _, _) => ManagementResult::Failed {\n                    failure: ManagementFailure::Cancelled,\n                    outcome: settlement.outcome,\n                },\n                (Some(result), false, None) => result,\n            };\n            if record.overview {\n                overviews.push((record.context.clone(), result.clone()));\n            }\n            if let Some(product) = record.read_part {\n                parts.push((record.context.clone(), product, result.clone()));\n            }\n            if record.api_keys_page && !retired {\n                match &result {\n                    ManagementResult::Page { page } => {\n                        // The whole inventory in one read: the first page,\n                        // and the last.\n                        key_pages.push(KeyRead::Items(\n                            record.context.clone(),\n                            page.items.clone(),\n                            page.offset == 0 && page.complete,\n                        ));\n                    }\n                    ManagementResult::Detail { detail } => match (&detail.found, &detail.item) {\n                        (crate::management::DetailFound::Found, Some(item)) => {\n                            key_pages.push(KeyRead::Items(\n                                record.context.clone(),\n                                format!(\"[{item}]\"),\n                                false,\n                            ));\n                        }\n                        (crate::management::DetailFound::Absent, _) => {\n                            key_pages\n                                .push(KeyRead::Absent(record.context.clone(), detail.id.clone()));\n                        }\n                        _ => {}\n                    },\n                    _ => {}\n                }\n            }\n            if record.lists_workspaces\n                && let ManagementResult::Gateway {\n                    gateway: crate::gateway::GatewayResult::List { list },\n                } = &result\n            {\n                listings.push((record.context.clone(), list.clone()));\n            }\n            if for_setup {\n                // Consumed by setup or a warning recheck; nothing observes it.\n                record.observed = true;\n                setup_results.push((record.operation.clone(), result.clone()));\n            }\n            if let Ok(mut slot) = record.cell.result.lock() {\n                *slot = Some(result);\n            }\n            record.cell.ready.notify_waiters();\n        }\n        for (operation, result) in setup_results {\n            self.setup_settled(&operation, &result);\n            self.warning_recheck_settled(&operation, &result);\n        }\n        for (context, result) in overviews {\n            self.overview_settled(&context, result);\n        }\n        for (context, product, result) in parts {\n            self.product_read_settled(&context, product, &result);\n        }\n        for read in key_pages {\n            match read {\n                KeyRead::Items(context, items, whole) => {\n                    if let Ok(tenant) = self.check_context(&context)\n                        && let Ok(items) = serde_json::from_str::<Vec<serde_json::Value>>(&items)\n                    {\n                        self.rotation_reconcile(&tenant, &items, whole);\n                    }\n                }\n                KeyRead::Absent(context, id) => {\n                    if let Ok(tenant) = self.check_context(&context) {\n                        self.rotation_key_absent(&tenant, &id);\n                    }\n                }\n            }\n        }\n        for (context, list) in listings {\n            self.gateway_listed(&context, &list);\n        }\n        let mut settled = 0;\n        let mut keep = vec![true; self.management_calls.len()];\n        for (i, record) in self.management_calls.iter().enumerate().rev() {\n            if record.settled {\n                settled += 1;\n                keep[i] = !record.observed && settled <= RETAINED_RESULTS;\n            }\n        }\n        let mut index = 0;\n        self.management_calls.retain(|_| {\n            index += 1;\n            keep[index - 1]\n        });\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_20","type":"command_execution","command":"/bin/zsh -lc 'cat apps/desktop/src/modules/tenants/tenants-settings.tsx apps/desktop/src/v2/wizard/wizard.tsx'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_20","type":"command_execution","command":"/bin/zsh -lc 'cat apps/desktop/src/modules/tenants/tenants-settings.tsx apps/desktop/src/v2/wizard/wizard.tsx'","aggregated_output":"import { type FormEvent, useId, useState } from 'react'\nimport { Button, Callout, TextField } from '@ai-security-academy/presentation'\nimport { AlertTriangle } from 'lucide-react'\nimport type {\n    Destination,\n    Region,\n    ResetFailure,\n    ShellSnapshot,\n    TenantEnvironment,\n    TenantView,\n    VaultError,\n} from '@prisma-airs/desktop-contracts'\nimport { ScanKeyForm } from './credential-entry'\nimport { ManagementCredentialForm } from './management-credential'\nimport type { ObserveManagement } from '../administration/management-read'\nimport { type Dispatch, outcomeMessage } from './dispatch'\nimport { Wizard } from '../../v2/wizard/wizard'\nimport { Modal } from '../../v2/modal'\n\nconst REGIONS: { value: Region; label: string }[] = [\n    { value: 'unitedStates', label: 'United States' },\n    { value: 'europe', label: 'Europe (Germany)' },\n    { value: 'india', label: 'India' },\n    { value: 'singapore', label: 'Singapore' },\n]\n\nconst REASON: Record<VaultError, string> = {\n    locked: 'secure storage is locked',\n    denied: 'the system denied access to secure storage',\n    unavailable: 'local storage is unavailable',\n    notFound: 'a stored item was missing',\n    corrupt: 'a stored item was unreadable',\n}\n\n/** What a stopped reset did and did not do, stated without overclaiming. */\nexport function resetFailureText(failure: ResetFailure): string {\n    const reason = REASON[failure.reason]\n    return failure.stage === 'credentials'\n        ? `Reset stopped while deleting scan keys because ${reason}. All scan keys were removed from use and are deleted as soon as possible; enter them again to scan. Tenant profiles and preferences were kept. Try the reset again.`\n        : `Reset deleted the scan keys but could not remove the local desktop data because ${reason}. Tenant profiles were kept without keys. Try the reset again.`\n}\n\nfunction regionLabel(region: Region): string {\n    return REGIONS.find((r) => r.value === region)?.label ?? region\n}\n\nfunction destinationLabel(destination: Destination): string {\n    return destination.kind === 'region' ? `${regionLabel(destination.region)} region` : destination.origin\n}\n\n/** Destination fields shared by tenant creation and endpoint review. */\nfunction DestinationFields({ name, initial }: { name: string; initial?: Destination }) {\n    const [kind, setKind] = useState<'region' | 'custom'>(initial?.kind ?? 'region')\n    const selectId = useId()\n    return (\n        <fieldset className='flex flex-col gap-2'>\n            <legend className='text-academy-ink text-[13px] font-medium'>Scan destination</legend>\n            {(['region', 'custom'] as const).map((value) => (\n                <label key={value} className='flex min-h-8 cursor-pointer items-center gap-3'>\n                    <input\n                        type='radio'\n                        name={`${name}-kind`}\n                        value={value}\n                        checked={kind === value}\n                        onChange={() => setKind(value)}\n                        className='size-4 accent-[var(--academy-accent)]'\n                    />\n                    <span className='text-academy-ink text-[13px]'>\n                        {value === 'region' ? 'AIRS region' : 'Custom HTTPS endpoint'}\n                    </span>\n                </label>\n            ))}\n            {kind === 'region' ? (\n                <div className='flex flex-col gap-1'>\n                    <label htmlFor={selectId} className='text-academy-ink text-[13px] font-medium'>\n                        Region\n                    </label>\n                    <select\n                        id={selectId}\n                        name={`${name}-region`}\n                        defaultValue={initial?.kind === 'region' ? initial.region : 'unitedStates'}\n                        className='border-academy-rule bg-academy-bg text-academy-ink min-h-8 rounded-[8px] border px-3 text-[13px]'\n                    >\n                        {REGIONS.map((r) => (\n                            <option key={r.value} value={r.value}>\n                                {r.label}\n                            </option>\n                        ))}\n                    </select>\n                </div>\n            ) : (\n                <TextField\n                    label='Endpoint origin'\n                    name={`${name}-origin`}\n                    placeholder='https://scan.example.com'\n                    hint='HTTPS only, with no path, query or credentials. The scan key is sent only here.'\n                    defaultValue={initial?.kind === 'custom' ? initial.origin : ''}\n                    autoComplete='off'\n                    spellCheck={false}\n                />\n            )}\n        </fieldset>\n    )\n}\n\n/** Reads the destination fields at the moment of submission. */\nfunction readDestination(form: HTMLFormElement, name: string): Destination {\n    const data = new FormData(form)\n    if (data.get(`${name}-kind`) === 'custom') {\n        return { kind: 'custom', origin: String(data.get(`${name}-origin`) ?? '') }\n    }\n    return { kind: 'region', region: String(data.get(`${name}-region`) ?? 'unitedStates') as Region }\n}\n\nfunction useAction(dispatch: Dispatch) {\n    const [message, setMessage] = useState<string | null>(null)\n    const [busy, setBusy] = useState(false)\n    async function run(intent: Parameters<Dispatch>[0]): Promise<boolean> {\n        setBusy(true)\n        setMessage(null)\n        const outcome = await dispatch(intent)\n        setBusy(false)\n        setMessage(outcomeMessage(outcome))\n        return outcome.kind === 'admitted'\n    }\n    return { message, busy, run }\n}\n\nfunction Message({ text }: { text: string | null }) {\n    return text ? (\n        <p role='alert' className='text-academy-accent-warn text-[13px]'>\n            {text}\n        </p>\n    ) : null\n}\n\nfunction EndpointChange({ tenant, snapshot, dispatch }: { tenant: TenantView; snapshot: ShellSnapshot; dispatch: Dispatch }) {\n    const { message, busy, run } = useAction(dispatch)\n    const [editing, setEditing] = useState(false)\n    const headingId = useId()\n    const context = snapshot.active?.context\n    const review = snapshot.endpointReview?.tenant === tenant.id ? snapshot.endpointReview : null\n    if (!context) return null\n    return (\n        <section aria-labelledby={headingId} data-slot='endpoint' className='settings-card'>\n            <h3 id={headingId} className='text-academy-ink text-[14px] font-semibold'>\n                Scan destination\n            </h3>\n            <p className='text-academy-ink-soft text-[13px]'>\n                Scan requests and the scan key go only to <span className='font-mono'>{tenant.origin}</span>.\n            </p>\n            {review ? (\n                <div data-slot='endpoint-review' className='flex flex-col gap-3'>\n                    <Callout tone='warning' icon={AlertTriangle}>\n                        <p>\n                            Review: scan requests will go to <span className='font-mono'>{review.toOrigin}</span> instead\n                            of <span className='font-mono'>{review.fromOrigin}</span>.\n                        </p>\n                        {review.removesScanCredential ? (\n                            <p>The current scan key will be removed. Enter a key for the new destination afterwards.</p>\n                        ) : null}\n                    </Callout>\n                    <div className='flex flex-wrap gap-2'>\n                        <Button\n                            type='button'\n                            tier='primary'\n                            disabled={busy}\n                            onClick={() => void run({ kind: 'confirmEndpointChange', context, review: review.review })}\n                        >\n                            Change destination\n                        </Button>\n                        <Button\n                            type='button'\n                            tier='tertiary'\n                            disabled={busy}\n                            onClick={() => void run({ kind: 'discardReview', review: review.review })}\n                        >\n                            Keep current destination\n                        </Button>\n                    </div>\n                </div>\n            ) : editing ? (\n                <form\n                    className='flex flex-col gap-3'\n                    aria-busy={busy}\n                    onSubmit={(event: FormEvent<HTMLFormElement>) => {\n                        event.preventDefault()\n                        const destination = readDestination(event.currentTarget, 'endpoint')\n                        void run({ kind: 'reviewEndpointChange', context, destination }).then((ok) => {\n                            if (ok) setEditing(false)\n                        })\n                    }}\n                >\n                    <DestinationFields name='endpoint' initial={tenant.destination} />\n                    <div className='flex flex-wrap gap-2'>\n                        <Button type='submit' tier='primary' disabled={busy}>\n                            Review change\n                        </Button>\n                        <Button type='button' tier='tertiary' onClick={() => setEditing(false)}>\n                            Cancel\n                        </Button>\n                    </div>\n                </form>\n            ) : (\n                <div>\n                    <Button type='button' tier='secondary' onClick={() => setEditing(true)}>\n                        Change destination…\n                    </Button>\n                </div>\n            )}\n            <Message text={message} />\n        </section>\n    )\n}\n\nfunction UpdateTenant({ snapshot, dispatch }: { snapshot: ShellSnapshot; dispatch: Dispatch }) {\n    const { message, busy, run } = useAction(dispatch)\n    const [selected, setSelected] = useState(snapshot.active?.tenant ?? '')\n    const [editing, setEditing] = useState<string | null>(null)\n    const [confirmDelete, setConfirmDelete] = useState<string | null>(null)\n    const headingId = useId()\n    const tenant = snapshot.tenants.find((t) => t.id === selected) ?? snapshot.tenants[0]\n    return (\n        <section aria-labelledby={headingId} data-slot='update-tenant' className='settings-card'>\n            <h3 id={headingId}>Update Tenant</h3>\n            {!tenant ? <p className='settings-description'>No tenants yet. Add a tenant to connect.</p> : <>\n                <label className='settings-field'>Tenant\n                    <select aria-label='Tenant to update' value={tenant.id} disabled={busy} onChange={(e) => { setSelected(e.target.value); setEditing(null); setConfirmDelete(null) }}>\n                        {snapshot.tenants.map((t) => <option key={t.id} value={t.id}>{t.label}{t.id === snapshot.active?.tenant ? ' (active)' : ''}</option>)}\n                    </select>\n                </label>\n                <p className='settings-description'>{tenant.tsgId ? `TSG ${tenant.tsgId} · ` : ''}{destinationLabel(tenant.destination)}</p>\n                {editing === tenant.id ? <form key={tenant.id} className='flex flex-col gap-3' onSubmit={(event) => {\n                    event.preventDefault()\n                    const data = new FormData(event.currentTarget)\n                    void run({ kind: 'editTenant', tenant: tenant.id, label: String(data.get('label') ?? '').trim(), environment: String(data.get('environment')) as TenantEnvironment }).then((ok) => { if (ok) setEditing(null) })\n                }}>\n                    <div className='settings-fields'>\n                        <label className='settings-field'>Display name<input name='label' required maxLength={64} defaultValue={tenant.label} autoComplete='off' /></label>\n                        <label className='settings-field'>Environment<select name='environment' defaultValue={tenant.environment}>\n                            <option value='production'>Production</option><option value='staging'>Staging</option><option value='other'>Other</option>\n                        </select></label>\n                    </div>\n                    <p className='settings-description'>Environment labels this profile; it does not change service endpoints. To change the TSG identity, add a replacement tenant.</p>\n                    <div className='flex flex-wrap gap-2'><Button type='submit' tier='primary' disabled={busy}>Save changes</Button><Button type='button' tier='tertiary' disabled={busy} onClick={() => setEditing(null)}>Cancel</Button></div>\n                </form> : <div className='flex flex-wrap gap-2'>\n                    <Button type='button' tier='secondary' disabled={busy} onClick={() => setEditing(tenant.id)}>Edit</Button>\n                    {tenant.id !== snapshot.active?.tenant && <Button type='button' tier='secondary' disabled={busy} onClick={() => void run({ kind: 'selectTenant', tenant: tenant.id, resolution: null })}>Make active</Button>}\n                    {confirmDelete === tenant.id ? <>\n                        <Button type='button' tier='primary' disabled={busy} aria-label={`Confirm deleting ${tenant.label} and its credentials`} onClick={() => void run({ kind: 'deleteTenant', tenant: tenant.id }).then((ok) => { if (ok) setConfirmDelete(null) })}>Confirm delete</Button>\n                        <Button type='button' tier='tertiary' disabled={busy} onClick={() => setConfirmDelete(null)}>Cancel</Button>\n                    </> : <Button type='button' tier='tertiary' disabled={busy} onClick={() => setConfirmDelete(tenant.id)}>Delete</Button>}\n                </div>}\n            </>}\n            <Message text={message} />\n        </section>\n    )\n}\n\nfunction AddTenant({ snapshot, dispatch, observeManagement }: Props) {\n    const headingId = useId()\n    const [open, setOpen] = useState(false)\n    const [closeRequests, setCloseRequests] = useState(0)\n    const [added, setAdded] = useState<string | null>(null)\n    return <section aria-labelledby={headingId} className='settings-card' data-slot='add-tenant'>\n        <h3 id={headingId}>Add Tenant</h3>\n        <p className='settings-description'>Connect a tenant with its TSG ID, management client and scan region. OAuth authentication is required before it is added; a Scan Key can be configured later.</p>\n        <div><Button type='button' tier='primary' onClick={() => { setCloseRequests(0); setOpen(true) }}>Add tenant…</Button></div>\n        {added && <p role='status'>Added {added}.</p>}\n        {open && <Modal label='Add a tenant' onClose={() => setCloseRequests((n) => n + 1)} width={1160} padding={0} data-slot='settings-add-tenant-sheet'>\n            <Wizard mode='add' snapshot={snapshot} dispatch={dispatch} observeManagement={observeManagement} onNavigate={() => undefined} closeRequests={closeRequests} onClose={(label) => { setOpen(false); setCloseRequests(0); if (label) setAdded(label) }} />\n        </Modal>}\n    </section>\n}\n\nfunction ResetLocalData({ snapshot, dispatch }: { snapshot: ShellSnapshot; dispatch: Dispatch }) {\n    const { message, busy, run } = useAction(dispatch)\n    const [confirming, setConfirming] = useState(false)\n    const headingId = useId()\n    return (\n        <section aria-labelledby={headingId} className='settings-card' data-slot='reset'>\n            <h3 id={headingId} className='text-academy-ink text-[14px] font-semibold'>\n                Reset local data\n            </h3>\n            <p className='text-academy-ink-soft text-[13px]'>\n                Removes this app’s tenant profiles, preferences and stored credentials. Other applications are not changed.\n            </p>\n            {snapshot.resetFailure ? (\n                <Callout tone='danger' icon={AlertTriangle} role='alert' data-slot='reset-failure'>\n                    {resetFailureText(snapshot.resetFailure)}\n                </Callout>\n            ) : null}\n            <div className='flex flex-wrap gap-2'>\n                {confirming ? (\n                    <>\n                        <Button\n                            type='button'\n                            tier='primary'\n                            disabled={busy}\n                            onClick={() => {\n                                setConfirming(false)\n                                void run({ kind: 'resetLocalData' })\n                            }}\n                        >\n                            Confirm reset\n                        </Button>\n                        <Button type='button' tier='tertiary' onClick={() => setConfirming(false)}>\n                            Cancel\n                        </Button>\n                    </>\n                ) : (\n                    <Button\n                        type='button'\n                        tier='secondary'\n                        disabled={busy || snapshot.storage === 'resetting'}\n                        onClick={() => setConfirming(true)}\n                    >\n                        Reset local data…\n                    </Button>\n                )}\n            </div>\n            <Message text={message} />\n        </section>\n    )\n}\n\nfunction StorageNotice({ snapshot }: { snapshot: ShellSnapshot }) {\n    switch (snapshot.storage) {\n        case 'ready':\n            return snapshot.durabilityUnconfirmed ? (\n                <Callout tone='warning' icon={AlertTriangle} role='status' data-slot='durability-notice'>\n                    The last change was saved, but the system did not confirm it was written to disk. It may be lost if\n                    this device stops unexpectedly; the next change retries.\n                </Callout>\n            ) : null\n        case 'resetting':\n            return (\n                <p role='status' aria-live='polite' className='text-academy-ink-soft text-[13px]'>\n                    Resetting local data… Scan keys are out of use until it finishes.\n                </p>\n            )\n        case 'corrupt':\n            return (\n                <Callout tone='danger' icon={AlertTriangle} role='alert' data-slot='storage-notice'>\n                    Local desktop data could not be read. Nothing was changed. Reset local data to continue.\n                </Callout>\n            )\n        case 'unavailable':\n            return (\n                <Callout tone='danger' icon={AlertTriangle} role='alert' data-slot='storage-notice'>\n                    Local desktop data is unavailable. Another copy of the desktop may be running.\n                </Callout>\n            )\n    }\n}\n\ninterface Props {\n    snapshot: ShellSnapshot\n    dispatch: Dispatch\n    observeManagement: ObserveManagement\n}\n\n/** Tenant settings keep profile editing separate from credential and destination authority. */\nexport function TenantsSettings({ snapshot, dispatch, observeManagement }: Props) {\n    const legend = useId()\n    const active = snapshot.active ? snapshot.tenants.find((t) => t.id === snapshot.active?.tenant) : undefined\n    return (\n        <section aria-labelledby={legend} data-slot='tenants' className='flex flex-col gap-3'>\n            <div className='flex flex-wrap items-baseline gap-3'>\n                <h2 id={legend} className='text-[16px] font-semibold'>Tenants</h2>\n                {active && <p className='settings-description'>Active tenant: <strong>{active.label}</strong></p>}\n            </div>\n            <StorageNotice snapshot={snapshot} />\n            <div className='settings-grid'>\n                {active && snapshot.active && <>\n                    <ScanKeyForm key={snapshot.active.context} tenant={active} context={snapshot.active.context} dispatch={dispatch} />\n                    <ManagementCredentialForm key={`management-${snapshot.active.context}`} tenant={active} context={snapshot.active.context} dispatch={dispatch} observe={observeManagement} />\n                    <EndpointChange key={`destination-${snapshot.active.context}`} tenant={active} snapshot={snapshot} dispatch={dispatch} />\n                </>}\n                <UpdateTenant snapshot={snapshot} dispatch={dispatch} />\n                <AddTenant snapshot={snapshot} dispatch={dispatch} observeManagement={observeManagement} />\n                <ResetLocalData snapshot={snapshot} dispatch={dispatch} />\n            </div>\n        </section>\n    )\n}\nimport { useEffect, useId, useRef, useState, type FormEvent, type ReactNode } from 'react'\nimport { createPortal } from 'react-dom'\nimport type { ContextRef, ManagementResult, ProductId, Region, SetupView, ShellSnapshot, SwitchResolution, TenantEnvironment, VerifyState, VerifyStep } from '@prisma-airs/desktop-contracts'\nimport type { Dispatch, DispatchOutcome } from '../../modules/tenants/dispatch'\nimport { outcomeMessage } from '../../modules/tenants/dispatch'\nimport { readManagement } from '../../modules/administration/management-read'\nimport { AcademyAccount } from '../../modules/academy/academy-account'\nimport { Glyph, type GlyphName } from '../icons'\nimport { Verdict, type VerdictTone } from '../verdict'\nimport { ENVIRONMENT_LABELS } from '../copy'\nimport { SwitchGuard } from '../switch-guard'\nimport { PRODUCT_CARDS, WIZARD_COPY as C } from './copy'\n\nexport type WizardStep = 'welcome' | 'tenant' | 'products' | 'verify' | 'packs' | 'academy' | 'done'\nconst FIRST_RUN: WizardStep[] = ['welcome', 'tenant', 'products', 'verify', 'packs', 'academy', 'done']\nconst ADD: WizardStep[] = ['tenant', 'products', 'verify', 'packs', 'done']\n\nconst REGIONS: { value: Region; label: string }[] = [\n    { value: 'unitedStates', label: 'United States' },\n    { value: 'europe', label: 'Europe' },\n    { value: 'india', label: 'India' },\n    { value: 'singapore', label: 'Singapore' },\n]\nconst ENVIRONMENTS: TenantEnvironment[] = ['production', 'staging', 'other']\n\nexport interface WizardProps {\n    snapshot: ShellSnapshot\n    dispatch: Dispatch\n    observeManagement: (operation: string) => Promise<ManagementResult>\n    mode: 'firstRun' | 'add'\n    /**\n     * add mode: the sheet closes, with the added tenant's label once the\n     * core committed it (a plain close means Cancel: the shell discards the\n     * draft); firstRun: the shell takes over once onboarding is done.\n     */\n    onClose: (added?: string) => void\n    onNavigate: (feature: 'home') => void\n    /** Board fixtures and tests only: open on a later step. */\n    initial?: WizardInitial\n    /**\n     * add mode: every close request from outside (Escape, the scrim) arrives\n     * here as a count; the wizard runs the same Cancel as its button, so a\n     * refused or unconfirmed discard stays visible instead of closing.\n     */\n    closeRequests?: number\n}\n\n/** The step a board fixture opens the wizard on (boards.md `fx.on.*`); the state itself is the snapshot's `setup`. */\nexport interface WizardInitial {\n    step?: WizardStep\n    packs?: ProductId[]\n}\n\nconst toneOf = (state: VerifyState): VerdictTone => (state === 'pass' ? 'allowed' : state === 'warning' ? 'flagged' : state === 'fail' ? 'blocked' : 'info')\nconst UNAVAILABLE_LINES: VerifyStep[] = [\n    { line: 'ais', product: null, state: 'unavailable', reason: 'Not available in this release: no admitted service (D058).' },\n    { line: 'aes', product: null, state: 'unavailable', reason: 'Not available in this release: no admitted service (D058).' },\n]\nconst fieldError = (name: 'name' | 'tsg', value: string): string => (name === 'name' ? (value.trim() ? '' : C.tenant.errors.name) : /^\\d{10}$/.test(value.trim()) ? '' : C.tenant.errors.tsg)\ntype Status = { text: string; retry?: () => void } | null\n\n/**\n * The first-run wizard and the add-tenant sheet (C29, screens/wizard.md).\n * Everything durable lives in the core's setup draft (`snapshot.setup`):\n * the profile, the credentials attached to the draft's own context, the\n * chosen products, the verification run and its staleness, and the\n * completion gate. This component only walks the steps and sends intents;\n * secrets are read from their fields once, cleared, and sent inside the\n * intent (provenance P25); nothing here holds them.\n */\nexport function Wizard(props: WizardProps) {\n    const { snapshot, dispatch, mode } = props\n    const steps = mode === 'add' ? ADD : FIRST_RUN\n    const setup: SetupView | null = snapshot.setup && snapshot.setup.mode === mode ? snapshot.setup : null\n    const context: ContextRef | null = setup?.context ?? null\n    const startStep: WizardStep = props.initial?.step ?? (mode === 'firstRun' && snapshot.onboarding === 'inProgress' ? 'tenant' : (steps[0] as WizardStep))\n    const startIndex = Math.max(0, steps.indexOf(startStep))\n    const [index, setIndex] = useState(startIndex)\n    const step = steps[index] as WizardStep\n    const [visited, setVisited] = useState<Set<WizardStep>>(() => new Set<WizardStep>(steps.slice(0, startIndex + 1)))\n    const [status, setStatus] = useState<Status>(null)\n    const [busy, setBusy] = useState(false)\n    const [finishing, setFinishing] = useState(false)\n    const [packs, setPacks] = useState<ProductId[] | null>(props.initial?.packs ?? null)\n    // Steps the operator skipped (the rail tags them Skipped once passed).\n    const [skipped, setSkipped] = useState<Set<WizardStep>>(() => new Set())\n    const [helpOpen, setHelpOpen] = useState(false)\n    const [scanOpen, setScanOpen] = useState(false)\n    const heading = useRef<HTMLHeadingElement>(null)\n    const headingId = useId()\n\n    useEffect(() => {\n        heading.current?.focus()\n    }, [step])\n\n    // Steps after Verify stay out of reach until the current inputs verified\n    // without a blocking failure (R4): an edit anywhere sends the walk back\n    // through Verify; unsaved profile edits keep every later step out of reach.\n    const verifyIndex = steps.indexOf('verify')\n    const tenantIndex = steps.indexOf('tenant')\n    const reachable = (i: number) => visited.has(steps[i] as WizardStep) && (i <= tenantIndex || !profileDirty) && (i <= verifyIndex || Boolean(setup?.completable))\n    const go = (next: number) => {\n        if (next < 0 || next >= steps.length) return\n        setStatus(null)\n        setIndex(next)\n        setVisited((v) => new Set<WizardStep>([...v, steps[next] as WizardStep]))\n    }\n    const report = (outcome: DispatchOutcome, ok: string | null, retry?: () => void): boolean => {\n        if (outcome.kind === 'admitted') {\n            setStatus(ok ? { text: ok } : null)\n            return true\n        }\n        if (outcome.kind === 'refused') setStatus({ text: outcomeMessage(outcome) ?? C.outcome.failed })\n        else if (outcome.kind === 'unknown') setStatus({ text: C.outcome.unknown, retry })\n        else setStatus({ text: C.outcome.failed, retry })\n        return false\n    }\n\n    // ---- welcome: leaving it marks onboarding in progress (Rust-owned) ----\n    async function leaveWelcome() {\n        if (snapshot.onboarding !== 'needed') return go(index + 1)\n        setBusy(true)\n        const outcome = await dispatch({ kind: 'setOnboarding', state: 'inProgress' })\n        setBusy(false)\n        if (report(outcome, null, () => void leaveWelcome())) go(index + 1)\n    }\n\n    // ---- tenant: the profile form drafts or updates the core's setup ----\n    const [form, setForm] = useState<{ name: string; environment: TenantEnvironment; region: Region; tsg: string }>(() => ({\n        name: setup?.tenant.label ?? '',\n        environment: setup?.tenant.environment ?? 'production',\n        region: setup && setup.tenant.destination.kind === 'region' ? setup.tenant.destination.region : 'unitedStates',\n        tsg: setup?.tenant.tsgId ?? '',\n    }))\n    const [errors, setErrors] = useState<Record<string, string>>({})\n    const [touched, setTouched] = useState<Record<string, boolean>>({})\n    const savedProfile = setup ? { name: setup.tenant.label, environment: setup.tenant.environment, region: setup.tenant.destination.kind === 'region' ? setup.tenant.destination.region : 'unitedStates', tsg: setup.tenant.tsgId ?? '' } : null\n    // Displayed details that differ from the draft's, or are invalid, must be\n    // saved or reverted before anything downstream (R7): the core only ever\n    // verifies and commits what it holds.\n    const profileDirty = Boolean(savedProfile && (form.name.trim() !== savedProfile.name || form.environment !== savedProfile.environment || form.region !== savedProfile.region || form.tsg.trim() !== savedProfile.tsg))\n    const revertProfile = () => {\n        if (savedProfile) setForm(savedProfile)\n        setErrors({})\n        setTouched({})\n    }\n    const scanRef = useRef<HTMLInputElement>(null)\n    const secretRef = useRef<HTMLInputElement>(null)\n    const workspaceKeyRef = useRef<HTMLInputElement>(null)\n    useEffect(() => {\n        const fields = [scanRef.current, secretRef.current, workspaceKeyRef.current]\n        const clear = () => { for (const field of fields) if (field) field.value = '' }\n        clear()\n        return clear\n    }, [context])\n    const profileOf = () => ({ label: form.name.trim(), tsgId: form.tsg.trim(), destination: { kind: 'region' as const, region: form.region }, environment: form.environment })\n\n    // A draft creation that is in flight, or whose delivery was not confirmed,\n    // may still produce a draft: Cancel waits for it and discards what appears.\n    const createInFlight = useRef<Promise<DispatchOutcome> | null>(null)\n    // Mirrored in state so a settlement re-runs the cancel decision whatever\n    // order the receipt and the draft snapshot arrive in.\n    const [createPending, setCreatePending] = useState(false)\n    // An admitted creation whose draft has not been observed yet: the draft is\n    // coming, so a cancellation waits for it however long the snapshot takes.\n    const [createAdmitted, setCreateAdmitted] = useState(false)\n    const [createUnknown, setCreateUnknown] = useState<string | null>(null)\n    async function submitProfile(event: FormEvent<HTMLFormElement>) {\n        event.preventDefault()\n        const next = { name: fieldError('name', form.name), tsg: fieldError('tsg', form.tsg) }\n        setTouched({ name: true, tsg: true })\n        setErrors(next)\n        if (next.name || next.tsg) return\n        setBusy(true)\n        let outcome: DispatchOutcome\n        if (setup) outcome = await dispatch({ kind: 'updateTenantSetup', context: setup.context, profile: profileOf() })\n        else {\n            const promise = dispatch({ kind: 'beginTenantSetup', mode, profile: profileOf() })\n            createInFlight.current = promise\n            setCreatePending(true)\n            outcome = await promise\n            createInFlight.current = null\n            if (outcome.kind === 'unknown') setCreateUnknown(snapshot.revision)\n            if (outcome.kind === 'admitted') setCreateAdmitted(true)\n            setCreatePending(false)\n        }\n        setBusy(false)\n        report(outcome, setup ? C.tenant.updated : C.tenant.created(form.name.trim()), () => void submitProfile(event))\n    }\n    useEffect(() => {\n        // A later snapshot settles an unconfirmed creation either way; an admitted\n        // one is settled by the draft it produced.\n        if (createUnknown !== null && createUnknown !== snapshot.revision) setCreateUnknown(null)\n        if (createAdmitted && setup) setCreateAdmitted(false)\n    }, [createUnknown, createAdmitted, setup, snapshot.revision])\n\n    async function saveScanKey(event: FormEvent<HTMLFormElement>) {\n        event.preventDefault()\n        const field = scanRef.current\n        if (!field || !context) return\n        const key = field.value\n        field.value = ''\n        if (!key) return setErrors((e) => ({ ...e, scanKey: C.tenant.errors.scanKey }))\n        setErrors((e) => ({ ...e, scanKey: '' }))\n        setBusy(true)\n        report(await dispatch({ kind: 'configureScanCredential', context, mode: 'keychain', key }), C.tenant.keySaved)\n        setBusy(false)\n    }\n\n    async function saveClient(event: FormEvent<HTMLFormElement>) {\n        event.preventDefault()\n        const secretField = secretRef.current\n        if (!secretField || !context) return\n        const secret = secretField.value\n        secretField.value = ''\n        const clientId = String(new FormData(event.currentTarget).get('clientId') ?? '').trim()\n        if (!clientId) return setErrors((e) => ({ ...e, clientId: C.tenant.errors.clientId }))\n        if (!secret) return setErrors((e) => ({ ...e, clientSecret: C.tenant.errors.clientSecret }))\n        setErrors((e) => ({ ...e, clientId: '', clientSecret: '' }))\n        setBusy(true)\n        report(await dispatch({ kind: 'configureManagementCredential', context, mode: 'keychain', clientId, secret }), C.tenant.clientSaved)\n        setBusy(false)\n    }\n\n    async function remove(kind: 'removeScanCredential' | 'removeManagementCredential', ok: string) {\n        if (!context) return\n        setBusy(true)\n        report(await dispatch({ kind, context }), ok)\n        setBusy(false)\n    }\n\n    // ---- Gateway workspace (optional): list through the management client, choose, key ----\n    const [gatewayOn, setGatewayOn] = useState(false)\n    const [workspaces, setWorkspaces] = useState<{ id: string; name: string }[] | null>(null)\n    const [workspacesNote, setWorkspacesNote] = useState<string | null>(null)\n    const [workspace, setWorkspace] = useState<string>('')\n    // The chosen workspace is core state on the draft (its reference is what the key is configured under).\n    const chosen = setup?.workspace ?? null\n    const [endpoint, setEndpoint] = useState('')\n\n    async function listWorkspaces() {\n        if (!context) return\n        setWorkspacesNote(C.tenant.readingWorkspaces)\n        setWorkspaces(null)\n        const outcome = await readManagement(dispatch, props.observeManagement, context, { kind: 'gateway', workspace: null, read: { kind: 'inventory', resource: 'workspaces' } })\n        if (outcome.kind !== 'result') return setWorkspacesNote(outcome.kind === 'notAdmitted' ? outcome.message : C.outcome.failed)\n        const result = outcome.result\n        if (result.kind !== 'gateway' || result.gateway.kind !== 'list') return setWorkspacesNote(result.kind === 'failed' ? C.outcome.failed : C.tenant.noWorkspaces)\n        const rows = (JSON.parse(result.gateway.list.rows) as Record<string, unknown>[])\n            .filter((r) => typeof r.id === 'string')\n            .map((r) => ({ id: String(r.id), name: typeof r.name === 'string' && r.name ? r.name : String(r.id) }))\n        setWorkspaces(rows)\n        setWorkspace(rows[0]?.id ?? '')\n        setWorkspacesNote(rows.length ? null : C.tenant.noWorkspaces)\n    }\n\n    async function chooseWorkspace() {\n        if (!context || !workspace) return\n        setBusy(true)\n        const outcome = await dispatch({ kind: 'selectGatewayWorkspace', context, workspace })\n        setBusy(false)\n        report(outcome, C.tenant.workspaceChosen(workspaces?.find((w) => w.id === workspace)?.name ?? workspace))\n    }\n\n    async function saveWorkspaceKey(event: FormEvent<HTMLFormElement>) {\n        event.preventDefault()\n        const field = workspaceKeyRef.current\n        if (!field || !context || !chosen) return\n        const secret = field.value\n        field.value = ''\n        if (!/^https:\\/\\/\\S+$/.test(endpoint.trim())) return setErrors((e) => ({ ...e, endpoint: C.tenant.errors.endpoint }))\n        if (!secret) return setErrors((e) => ({ ...e, workspaceKey: C.tenant.errors.workspaceKey }))\n        setErrors((e) => ({ ...e, endpoint: '', workspaceKey: '' }))\n        setBusy(true)\n        report(await dispatch({ kind: 'configureInferenceCredential', context, mode: 'keychain', workspace: chosen.reference, endpoint: endpoint.trim(), secret }), C.tenant.workspaceKeySaved)\n        setBusy(false)\n    }\n\n    // The Done summary's checks line, from the verification states themselves: \"All passed\" only when every line\n    // passed; otherwise each state is counted (a stored or skipped credential, an unavailable product, a warning or a\n    // failure is never described as passed). No run yet: none.\n    const checksSummary = (r: typeof run): [string, 'ok' | 'warn' | 'skip'] => {\n        if (!r || !r.done) return [C.done.summary.none, 'skip']\n        const counts = new Map<VerifyState, number>()\n        for (const st of r.steps) counts.set(st.state, (counts.get(st.state) ?? 0) + 1)\n        if (r.steps.length > 0 && counts.get('pass') === r.steps.length) return [C.done.summary.checksPassed, 'ok']\n        const order: VerifyState[] = ['pass', 'warning', 'fail', 'stored', 'skipped', 'unavailable', 'pending']\n        const text = order.filter((k) => (counts.get(k) ?? 0) > 0).map((k) => C.done.summary.checkCounts[k](counts.get(k) ?? 0)).join(' · ')\n        return [text || C.done.summary.none, (counts.get('fail') ?? 0) + (counts.get('warning') ?? 0) > 0 ? 'warn' : 'skip']\n    }\n    const scanReady = setup?.tenant.scan.state === 'ready'\n    const clientReady = setup?.tenant.management.state === 'ready'\n    const tenantContinue = !setup ? { label: C.tenant.continueNeedsDraft, disabled: true } : profileDirty ? { label: C.tenant.continueDirty, disabled: true } : setup.managementRequired && !clientReady ? { label: C.tenant.continueNeedsClient, disabled: true } : { label: C.tenant.continue, disabled: false }\n\n    // ---- products: the choice is recorded in the core as it changes ----\n    async function toggleProduct(id: ProductId, on: boolean) {\n        if (!setup) return\n        const next = on ? [...setup.products, id] : setup.products.filter((p) => p !== id)\n        report(await dispatch({ kind: 'chooseSetupProducts', context: setup.context, products: next }), null)\n    }\n\n    // ---- verify: one core-owned run; lines stream through the snapshot ----\n    async function verify() {\n        if (!context) return\n        setBusy(true)\n        report(await dispatch({ kind: 'verifyTenantSetup', context }), null, () => void verify())\n        setBusy(false)\n    }\n    const run = setup?.verify ?? null\n    const running = Boolean(run && !run.done)\n    const plannedRows: VerifyStep[] = run\n        ? run.steps\n        : [\n              { line: 'scanKey', product: 'runtimeSecurity', state: 'pending', reason: '' },\n              { line: 'managementClient', product: 'runtimeSecurity', state: 'pending', reason: '' },\n              ...(setup?.products ?? []).filter((p) => p !== 'runtimeSecurity').map((p): VerifyStep => ({ line: p === 'gateway' ? 'gateway' : p === 'redTeam' ? 'redTeam' : 'modelSkill', product: p, state: 'pending', reason: '' })),\n              ...UNAVAILABLE_LINES,\n          ]\n    const verifyStatus = !run ? '' : running ? C.verify.running : run.stale ? C.verify.stale : run.blocking ? C.verify.failed : run.failed ? C.verify.failedOptional : run.warnings.length ? C.verify.finishedWarnings : C.verify.finishedClean\n\n    // ---- packs: the chosen packs are imported by the completion intent ----\n    // Only packs of currently chosen products with cases count; a product removed\n    // after its pack was ticked takes the pack with it (R8).\n    const offered = setup?.packs.filter((p) => p.count > 0 && setup.products.includes(p.product)).map((p) => p.product) ?? []\n    const selectedPacks: ProductId[] = (packs ?? offered).filter((p) => offered.includes(p))\n\n    // ---- done: completion is one core intent; the shell confirms it ----\n    // Completion makes the new tenant active: it is the one guarded switch\n    // path (I1). A pending Harness decision refuses it; the core's guard is\n    // rendered here and the completion re-sent with the chosen resolution.\n    async function finish(resolution: SwitchResolution | null = null) {\n        if (!setup) return\n        setFinishing(true)\n        const outcome = await dispatch({ kind: 'completeTenantSetup', context: setup.context, packs: selectedPacks, resolution })\n        if (outcome.kind === 'admitted') {\n            // First run: the shell takes over once the snapshot shows onboarding\n            // done (the same intent set it). Add: the sheet closes with the label.\n            if (mode === 'add') props.onClose(setup.tenant.label)\n            return\n        }\n        setFinishing(false)\n        // The guard is the snapshot's to show (switchBlocked), not a status line.\n        if (outcome.kind === 'refused' && outcome.refusal === 'decisionPending') return\n        report(outcome, null, () => void finish())\n    }\n    const completionGuard = snapshot.switchBlocked?.completion && setup && snapshot.switchBlocked.to === setup.tenant.id ? snapshot.switchBlocked : null\n\n    // ---- cancel (add mode): the draft is discarded in the core before the sheet closes ----\n    // idle → awaitingCreate (a creation is pending or unconfirmed: wait for what it\n    // produces) → discarding (sent; closes on admission, or when the draft is seen\n    // gone after an unconfirmed delivery) → retry (refused or failed, with Retry).\n    type CancelState = 'idle' | 'awaitingCreate' | 'discarding' | 'retry'\n    const [cancelState, setCancelState] = useState<CancelState>('idle')\n    const latestSetup = useRef(setup)\n    latestSetup.current = setup\n    const cancelling = cancelState === 'awaitingCreate' || cancelState === 'discarding'\n    async function discardNow(context: ContextRef) {\n        setCancelState('discarding')\n        const outcome = await dispatch({ kind: 'discardTenantSetup', context })\n        if (outcome.kind === 'admitted') return props.onClose()\n        // Unconfirmed: the draft may be gone (the next snapshot closes the sheet) or\n        // still here; the operator can send the discard again for the current draft.\n        if (outcome.kind === 'unknown') return setStatus({ text: C.outcome.unknown, retry: () => void retryDiscard() })\n        setCancelState('retry')\n        setStatus({ text: `${C.cancelFailed} ${outcome.kind === 'refused' ? (outcomeMessage(outcome) ?? '') : C.outcome.failed}`.trim(), retry: () => void retryDiscard() })\n    }\n    async function retryDiscard() {\n        const current = latestSetup.current\n        if (!current) return props.onClose()\n        await discardNow(current.context)\n    }\n    async function cancel() {\n        // A close request while a discard is unconfirmed is the operator's retry.\n        if (cancelState === 'discarding') return retryDiscard()\n        if (cancelling) return\n        if (createInFlight.current || createUnknown !== null || createAdmitted) {\n            setCancelState('awaitingCreate')\n            if (createInFlight.current) {\n                const outcome = await createInFlight.current\n                // Nothing was created: close. Admitted or unconfirmed: the next snapshot decides.\n                if (outcome.kind === 'refused' || outcome.kind === 'failed') return props.onClose()\n            }\n            return\n        }\n        const current = latestSetup.current\n        if (!current) return props.onClose()\n        await discardNow(current.context)\n    }\n    useEffect(() => {\n        if (cancelState !== 'awaitingCreate' || createPending) return\n        if (setup) void discardNow(setup.context)\n        // An admitted creation's draft is still on its way: keep waiting for it.\n        else if (createAdmitted) return\n        else if (createUnknown === null) props.onClose()\n        // eslint-disable-next-line react-hooks/exhaustive-deps -- decided per settlement and snapshot\n    }, [cancelState, setup, createUnknown, createAdmitted, createPending, snapshot.revision])\n    const seenCloseRequests = useRef(props.closeRequests ?? 0)\n    useEffect(() => {\n        if ((props.closeRequests ?? 0) > seenCloseRequests.current) {\n            seenCloseRequests.current = props.closeRequests ?? 0\n            void cancel()\n        }\n        // eslint-disable-next-line react-hooks/exhaustive-deps -- a request is handled once\n    }, [props.closeRequests])\n    useEffect(() => {\n        // An unconfirmed discard that did go through shows up as the draft being gone.\n        if (cancelState === 'discarding' && !setup) props.onClose()\n    }, [cancelState, setup, props])\n    useEffect(() => {\n        // The draft's context changed (a credential or profile change): the core\n        // cleared its listing and choice, so the local chooser goes with them.\n        setWorkspaces(null)\n        setWorkspacesNote(null)\n        setWorkspace('')\n    }, [context])\n\n    const railCtx = setup ? `${setup.tenant.label} · ${ENVIRONMENT_LABELS[setup.tenant.environment]}${setup.tenant.tsgId ? ` · TSG ${setup.tenant.tsgId}` : ''}` : ''\n    const productLabel = (id: ProductId) => PRODUCT_CARDS.find((c) => c.id === id)?.label ?? id\n    const isAdd = mode === 'add'\n    const dark = snapshot.appearance === 'dark' || (snapshot.appearance === 'system' && typeof window !== 'undefined' && window.matchMedia?.('(prefers-color-scheme: dark)').matches)\n    const skip = (s: WizardStep) => {\n        setSkipped((x) => new Set([...x, s]))\n        go(index + 1)\n    }\n    const unskip = (s: WizardStep) =>\n        setSkipped((x) => {\n            const n = new Set(x)\n            n.delete(s)\n            return n\n        })\n\n    // ---- the pinned footer, per step ----\n    type Btn = { label: string; onClick: () => void; disabled?: boolean }\n    let primary: Btn\n    let secondary: Btn | undefined\n    let extra: Btn | undefined\n    let skipBtn: Btn | undefined\n    let hint = ''\n    switch (step) {\n        case 'welcome':\n            primary = { label: C.welcome.continue, onClick: () => void leaveWelcome(), disabled: busy }\n            break\n        case 'tenant':\n            primary = { label: tenantContinue.label, onClick: () => go(index + 1), disabled: tenantContinue.disabled }\n            hint = isAdd && !setup ? C.cancelNote : ''\n            break\n        case 'products':\n            primary = { label: C.products.continue, onClick: () => go(index + 1) }\n            break\n        case 'verify':\n            primary = { label: run && run.done && !run.stale && run.warnings.length > 0 && !run.blocking ? C.verify.continueWarnings : C.verify.continue, onClick: () => go(index + 1), disabled: !setup?.completable }\n            secondary = { label: run ? C.verify.again : C.verify.run, onClick: () => void verify(), disabled: busy || running }\n            extra = run && run.done && run.failed && !run.stale ? { label: C.verify.fix, onClick: () => go(steps.indexOf('tenant')) } : undefined\n            break\n        case 'packs':\n            primary = { label: C.packs.continue, onClick: () => { unskip('packs'); go(index + 1) } }\n            skipBtn = { label: C.packs.skip, onClick: () => { setPacks([]); skip('packs') } }\n            break\n        case 'academy':\n            primary = snapshot.academy.state === 'signedIn' ? { label: C.academy.continue, onClick: () => { unskip('academy'); go(index + 1) } } : { label: C.academy.skip, onClick: () => skip('academy') }\n            break\n        default:\n            primary = { label: finishing ? (isAdd ? C.done.finishing : C.done.opening) : isAdd ? C.done.finish : C.done.open, onClick: () => void finish(), disabled: finishing || !setup?.completable || profileDirty }\n    }\n    const showBack = index > 0\n\n    const card = (children: ReactNode, extraStyle: React.CSSProperties = {}, rest: Record<string, unknown> = {}) => (\n        <section className='flex flex-col rounded-[12px] border' style={{ gap: 12, padding: '18px 20px', borderColor: 'var(--v2-rule)', background: 'var(--v2-paper)', ...extraStyle }} {...rest}>\n            {children}\n        </section>\n    )\n    const pill = (text: string, tone: 'required' | 'optional' = 'optional') => (\n        <span className='rounded-full text-[12px] font-semibold' style={{ padding: '1px 7px', background: 'var(--v2-inset)', color: tone === 'required' ? 'var(--v2-soft)' : 'var(--v2-faint)' }}>\n            {text}\n        </span>\n    )\n    const tile = (name: GlyphName, size = 30) => (\n        <span className='grid shrink-0 place-items-center rounded-[8px]' style={{ width: size, height: size, background: 'var(--v2-inset)', color: 'var(--v2-soft)' }}>\n            <Glyph name={name} size={Math.round(size / 2)} color='var(--v2-soft)' />\n        </span>\n    )\n    const stateTone = (state: 'missing' | 'storing' | 'ready' | 'failed'): VerdictTone => (state === 'ready' ? 'allowed' : state === 'failed' ? 'blocked' : 'info')\n    const scanCard = setup && (\n        <OptionalCard\n            icon='shield'\n            title={C.tenant.scanKey}\n            text={`${setup.scanRequired ? C.tenant.scanRequired : C.tenant.scanOptional} ${C.tenant.scanHint}`}\n            tag={setup.scanRequired ? C.required : C.optional}\n            open={scanOpen || setup.scanRequired || scanReady}\n            onToggle={setup.scanRequired ? undefined : (on) => setScanOpen(on)}\n            state={\n                <span data-slot='scan-state'>\n                    <Verdict tone={stateTone(setup.tenant.scan.state)} word={C.tenant.state[setup.tenant.scan.state]} />\n                </span>\n            }\n            slot='scan-key-form'\n            onSubmit={(e) => void saveScanKey(e)}\n            busy={busy}\n        >\n            <SecretField label={C.tenant.scanKey} inputRef={scanRef} error={errors.scanKey} />\n            <div className='flex items-end' style={{ gap: 10 }}>\n                <Primary label={scanReady ? C.tenant.replaceKey : C.tenant.saveKey} disabled={busy} />\n                {scanReady && <Secondary label={C.tenant.removeKey} disabled={busy} onClick={() => void remove('removeScanCredential', C.tenant.keyRemoved)} />}\n            </div>\n        </OptionalCard>\n    )\n\n    return (\n        <div data-desktop-theme='' data-slot='wizard' data-mode={mode} className='flex' style={{ height: isAdd ? 'min(780px, 92vh)' : '100vh', minHeight: 0, background: 'var(--v2-bg)', color: 'var(--v2-ink)' }}>\n            <nav aria-label='Setup steps' className='flex shrink-0 flex-col' style={{ width: isAdd ? 244 : 320, padding: isAdd ? '22px 16px 16px' : '22px 20px 20px', background: 'var(--v2-side)', borderRight: '1px solid var(--v2-rule)' }}>\n                <div className='flex items-center' style={{ gap: 12, marginBottom: 28 }}>\n                    <span className='grid shrink-0 place-items-center rounded-[10px]' style={{ width: 40, height: 40, background: 'var(--v2-acc)', color: 'var(--v2-acc-ink)' }} data-slot='brand-tile'>\n                        <Glyph name='shield' size={22} color='var(--v2-acc-ink)' />\n                    </span>\n                    <span className='min-w-0'>\n                        <b className='text-[15px]'>{isAdd ? C.railTitleAdd : C.railTitle}</b>\n                        <br />\n                        <span style={{ color: 'var(--v2-faint)' }}>{isAdd ? C.railSubAdd : C.railSub}</span>\n                        {railCtx && step !== 'welcome' && (\n                            <>\n                                <br />\n                                <span data-slot='rail-context' className='inline-block text-[12px] font-semibold leading-[1.35] break-words' style={{ marginTop: 4 }}>\n                                    {railCtx}\n                                </span>\n                            </>\n                        )}\n                    </span>\n                </div>\n                <ol className='flex flex-col' style={{ gap: 2 }}>\n                    {steps.map((s, i) => {\n                        const cur = s === step\n                        const done = i < index && visited.has(s) && !skipped.has(s)\n                        const optional = s === 'packs' || s === 'academy'\n                        return (\n                            <li key={s}>\n                                <button\n                                    type='button'\n                                    aria-current={cur ? 'step' : undefined}\n                                    disabled={!reachable(i)}\n                                    onClick={() => reachable(i) && go(i)}\n                                    className='flex w-full items-center rounded-[8px] text-left text-[13px] disabled:opacity-60'\n                                    style={{ gap: 12, height: 40, padding: '0 10px', background: cur ? 'var(--v2-paper)' : 'transparent', color: 'var(--v2-ink)', fontWeight: cur ? 600 : 400 }}\n                                >\n                                    <span className='grid shrink-0 place-items-center rounded-full text-[11px] font-bold' style={{ width: 24, height: 24, border: `1.5px solid ${cur || done ? 'var(--v2-acc)' : 'var(--v2-ctl)'}`, background: done ? 'var(--v2-acc)' : cur ? 'var(--v2-acc-soft)' : 'transparent', color: done ? 'var(--v2-acc-ink)' : cur ? 'var(--v2-acc)' : 'var(--v2-soft)' }} data-slot='step-mark' data-done={done ? 'true' : undefined}>\n                                        {done ? <Glyph name='check' size={12} color='var(--v2-acc-ink)' /> : i + 1}\n                                    </span>\n                                    <span className='flex-grow'>{C.steps[s]}</span>\n                                    {skipped.has(s) ? (\n                                        <span className='text-[12px] font-normal' style={{ color: 'var(--v2-faint)' }}>\n                                            {C.skipped}\n                                        </span>\n                                    ) : optional ? (\n                                        <span className='text-[12px] font-normal' style={{ color: 'var(--v2-faint)' }}>\n                                            {C.optional}\n                                        </span>\n                                    ) : null}\n                                </button>\n                            </li>\n                        )\n                    })}\n                </ol>\n                <div className='mt-auto flex rounded-[10px] text-[12px] leading-[1.5]' style={{ gap: 8, padding: 12, background: 'var(--v2-inset)', color: 'var(--v2-soft)' }} data-slot='privacy-note'>\n                    <Glyph name='lock' size={14} color='var(--v2-soft)' className='mt-[2px] shrink-0' />\n                    <span>{C.privacy}</span>\n                </div>\n                <button type='button' onClick={() => void dispatch({ kind: 'setAppearance', theme: dark ? 'light' : 'dark' })} className='h-8 self-start rounded-[7px] border px-3 text-[12px]' style={{ marginTop: 10, borderColor: 'var(--v2-rule)', background: 'var(--v2-paper)', color: 'var(--v2-soft)' }} data-slot='theme-button'>\n                    {dark ? C.themeDark : C.themeLight}\n                </button>\n            </nav>\n            {/* min-h-0: in the column layout below 760px this column must shrink below its content, so the step scrolls\n                and the footer stays pinned inside the sheet (a 900-point window at 200% put the footer 2000 points down). */}\n            <div className='flex min-h-0 min-w-0 flex-grow flex-col'>\n                <main className='min-h-0 flex-grow overflow-auto' style={{ padding: isAdd ? '26px 32px 22px' : '32px 44px 28px' }}>\n                    <section aria-labelledby={headingId} className='flex flex-col' style={{ gap: 18, maxWidth: 860 }}>\n                        {step === 'welcome' && (\n                            <div className='flex flex-col' style={{ gap: 18, paddingTop: 30 }}>\n                                <span className='grid place-items-center rounded-[18px]' style={{ width: 72, height: 72, background: 'var(--v2-acc)', color: 'var(--v2-acc-ink)' }}>\n                                    <Glyph name='shield' size={38} color='var(--v2-acc-ink)' />\n                                </span>\n                                <h1 ref={heading} id={headingId} tabIndex={-1} className='font-bold' style={{ fontSize: 32, letterSpacing: '-0.02em' }}>\n                                    {C.welcome.title}\n                                </h1>\n                                <p className='text-[15px] leading-[1.55]' style={{ maxWidth: 680, color: 'var(--v2-soft)' }}>\n                                    {C.welcome.lead}\n                                </p>\n                                <p className='text-[14px] leading-[1.55]' style={{ maxWidth: 680, color: 'var(--v2-soft)' }}>\n                                    {C.welcome.lead2}\n                                </p>\n                                <ul className='grid' style={{ gridTemplateColumns: 'repeat(3, minmax(0, 1fr))', gap: 12, marginTop: 6 }}>\n                                    {C.welcome.cards.map((c) => (\n                                        <li key={c.title} className='flex flex-col rounded-[12px] border' style={{ gap: 10, padding: '18px 20px', borderColor: 'var(--v2-rule)', background: 'var(--v2-paper)' }}>\n                                            <span className='grid place-items-center rounded-[8px]' style={{ width: 30, height: 30, background: 'var(--v2-acc-soft)', color: 'var(--v2-acc)' }}>\n                                                <Glyph name={c.icon} size={15} color='var(--v2-acc)' />\n                                            </span>\n                                            <b>{c.title}</b>\n                                            <span className='leading-[1.45]' style={{ color: 'var(--v2-soft)' }}>\n                                                {c.body}\n                                            </span>\n                                        </li>\n                                    ))}\n                                </ul>\n                            </div>\n                        )}\n                        {step === 'tenant' && (\n                            <>\n                                <div className='flex flex-wrap items-end' style={{ gap: 12 }}>\n                                    <div>\n                                        <h1 ref={heading} id={headingId} tabIndex={-1} className='font-bold' style={{ fontSize: 26, letterSpacing: '-0.01em' }}>\n                                            {C.tenant.title}\n                                        </h1>\n                                        <p className='text-[14px]' style={{ marginTop: 4, color: 'var(--v2-soft)' }}>\n                                            {C.tenant.lead}\n                                        </p>\n                                    </div>\n                                </div>\n                                <form onSubmit={(e) => void submitProfile(e)} aria-busy={busy} className='flex flex-col rounded-[12px] border' style={{ gap: 12, padding: '18px 20px', borderColor: 'var(--v2-rule)', background: 'var(--v2-paper)' }} data-slot='tenant-form'>\n                                    <div className='flex items-center' style={{ gap: 8 }}>\n                                        <b className='text-[14px]'>{C.tenant.card}</b>\n                                        {pill(C.required, 'required')}\n                                    </div>\n                                    <div className='grid' style={{ gridTemplateColumns: '1fr 1fr', gap: 12 }} data-slot='field-grid'>\n                                        <Field label={C.tenant.name} name='name' value={form.name} onChange={(v) => setForm((f) => ({ ...f, name: v }))} hint={C.tenant.nameHint} error={touched.name ? errors.name : ''} maxLength={64} onBlur={(v) => { setTouched((t) => ({ ...t, name: true })); setErrors((e) => ({ ...e, name: fieldError('name', v) })) }} />\n                                        <Field label={C.tenant.tsg} name='tsg' value={form.tsg} onChange={(v) => setForm((f) => ({ ...f, tsg: v }))} hint={C.tenant.tsgHint} inputMode='numeric' error={touched.tsg ? errors.tsg : ''} onBlur={(v) => { setTouched((t) => ({ ...t, tsg: true })); setErrors((e) => ({ ...e, tsg: fieldError('tsg', v) })) }} />\n                                        <div className='flex flex-col text-[12px] font-semibold' style={{ gap: 5, color: 'var(--v2-soft)' }}>\n                                            {C.tenant.environment}\n                                            <div role='radiogroup' aria-label={C.tenant.environment} className='flex w-fit rounded-[8px]' style={{ padding: 2, background: 'var(--v2-inset)' }} data-slot='environment-control'>\n                                                {ENVIRONMENTS.map((env) => {\n                                                    const on = form.environment === env\n                                                    // Native radios in the segmented control: one tab stop for the group, arrow keys move\n                                                    // the selection, the label is the visible segment (buttons with a radio role had neither).\n                                                    return (\n                                                        <label key={env} className='relative flex h-8 cursor-pointer items-center rounded-[6px] text-[12.5px] font-semibold' style={{ padding: '0 14px', background: on ? 'var(--v2-paper)' : 'transparent', boxShadow: on ? '0 1px 2px rgba(0,0,0,0.12)' : 'none', color: 'var(--v2-ink)' }} data-slot='environment-choice'>\n                                                            <input type='radio' className='sr-only' name={`${headingId}-environment`} value={env} checked={on} onChange={() => setForm((f) => ({ ...f, environment: env }))} />\n                                                            {ENVIRONMENT_LABELS[env]}\n                                                        </label>\n                                                    )\n                                                })}\n                                            </div>\n                                            <span className='font-normal' style={{ color: 'var(--v2-faint)' }}>\n                                                {C.tenant.environmentHint}\n                                            </span>\n                                        </div>\n                                        <label className='flex flex-col text-[12px] font-semibold' style={{ gap: 5, color: 'var(--v2-soft)' }}>\n                                            {C.tenant.region}\n                                            <select name='region' aria-label={C.tenant.region} value={form.region} onChange={(e) => setForm((f) => ({ ...f, region: e.target.value as Region }))} className='h-8 min-h-0 rounded-[7px] border px-2.5 text-[13px] font-normal' style={{ borderColor: 'var(--v2-ctl)', background: 'var(--v2-bg)', color: 'var(--v2-ink)' }}>\n                                                {REGIONS.map((r) => (\n                                                    <option key={r.value} value={r.value}>\n                                                        {r.label}\n                                                    </option>\n                                                ))}\n                                            </select>\n                                            <span className='font-normal' style={{ color: 'var(--v2-faint)' }}>\n                                                {C.tenant.regionHint}\n                                            </span>\n                                        </label>\n                                    </div>\n                                    {setup && (\n                                        <p className='text-[12px]' style={{ color: 'var(--v2-faint)' }}>\n                                            {C.tenant.updateHint}\n                                        </p>\n                                    )}\n                                    <div className='flex items-center' style={{ gap: 10 }}>\n                                        <Primary label={setup ? C.tenant.save : C.tenant.create} disabled={busy} />\n                                        {profileDirty && <Secondary label={C.tenant.revert} onClick={revertProfile} />}\n                                    </div>\n                                </form>\n                                {setup && (\n                                    <>\n                                        <form onSubmit={(e) => void saveClient(e)} aria-busy={busy} className='flex flex-col rounded-[12px] border' style={{ gap: 12, padding: '18px 20px', borderColor: 'var(--v2-rule)', background: 'var(--v2-paper)' }} data-slot='management-form'>\n                                            <div className='flex items-center' style={{ gap: 8 }}>\n                                                <b className='text-[14px]'>{C.tenant.management}</b>\n                                                {pill(C.required, 'required')}\n                                                <button type='button' aria-expanded={helpOpen} onClick={() => setHelpOpen((h) => !h)} className='ml-auto text-[12px] font-semibold' style={{ color: 'var(--v2-acc)' }}>\n                                                    {C.tenant.whereFind}\n                                                </button>\n                                            </div>\n                                            {helpOpen && (\n                                                <ol className='flex list-decimal flex-col rounded-[8px] leading-[1.5]' style={{ gap: 4, padding: '12px 14px 12px 32px', background: 'var(--v2-inset)', color: 'var(--v2-soft)' }}>\n                                                    {C.tenant.whereSteps.map((t) => (\n                                                        <li key={t}>{t}</li>\n                                                    ))}\n                                                </ol>\n                                            )}\n                                            <p className='text-[12px]' style={{ color: 'var(--v2-faint)' }}>\n                                                {C.tenant.managementHint}\n                                            </p>\n                                            <p data-slot='management-state'>\n                                                <Verdict tone={stateTone(setup.tenant.management.state)} word={C.tenant.state[setup.tenant.management.state]} reason={clientReady && setup.tenant.management.clientId ? `Client ID: ${setup.tenant.management.clientId}` : undefined} />\n                                            </p>\n                                            <div className='grid' style={{ gridTemplateColumns: '1fr 1fr', gap: 12 }}>\n                                                <Field label={C.tenant.clientId} name='clientId' error={errors.clientId} />\n                                                <SecretField label={C.tenant.clientSecret} inputRef={secretRef} error={errors.clientSecret} />\n                                            </div>\n                                            <div className='flex items-center' style={{ gap: 10 }}>\n                                                <Primary label={clientReady ? C.tenant.replaceClient : C.tenant.saveClient} disabled={busy} />\n                                                {clientReady && <Secondary label={C.tenant.removeClient} disabled={busy} onClick={() => void remove('removeManagementCredential', C.tenant.clientRemoved)} />}\n                                            </div>\n                                        </form>\n                                        {scanCard}\n                                        <OptionalCard icon='route' title={C.tenant.gateway} text={C.tenant.gatewayHint} tag={C.optional} open={gatewayOn} onToggle={(on) => setGatewayOn(on)} switchLabel={C.tenant.gatewayOn} slot='gateway-section'>\n                                            {!clientReady && (\n                                                <p className='text-[12px]' style={{ color: 'var(--v2-soft)' }}>\n                                                    {C.tenant.gatewayNeedsClient}\n                                                </p>\n                                            )}\n                                            {clientReady && (\n                                                <div className='flex flex-col' style={{ gap: 10 }}>\n                                                    <div className='flex items-center' style={{ gap: 10 }}>\n                                                        <Secondary label={C.tenant.readWorkspaces} disabled={busy} onClick={() => void listWorkspaces()} />\n                                                        {workspacesNote && (\n                                                            <span className='text-[12px]' style={{ color: 'var(--v2-soft)' }}>\n                                                                {workspacesNote}\n                                                            </span>\n                                                        )}\n                                                    </div>\n                                                    {workspaces && workspaces.length > 0 && (\n                                                        <div className='flex items-end' style={{ gap: 10 }}>\n                                                            <label className='flex flex-col text-[12px] font-semibold' style={{ gap: 5, color: 'var(--v2-soft)' }}>\n                                                                {C.tenant.workspace}\n                                                                <select value={workspace} onChange={(e) => setWorkspace(e.target.value)} className='h-8 min-h-0 rounded-[7px] border px-2.5 text-[13px] font-normal' style={{ borderColor: 'var(--v2-ctl)', background: 'var(--v2-bg)', color: 'var(--v2-ink)' }}>\n                                                                    {workspaces.map((w) => (\n                                                                        <option key={w.id} value={w.id}>\n                                                                            {w.name}\n                                                                        </option>\n                                                                    ))}\n                                                                </select>\n                                                            </label>\n                                                            <Secondary label={C.tenant.chooseWorkspace} disabled={busy || !workspace} onClick={() => void chooseWorkspace()} />\n                                                        </div>\n                                                    )}\n                                                    {chosen && (\n                                                        <form onSubmit={(e) => void saveWorkspaceKey(e)} aria-busy={busy} className='flex flex-col' style={{ gap: 10 }} data-slot='workspace-key-form'>\n                                                            <p className='text-[13px]'>{C.tenant.workspaceChosen(chosen.workspace.name)}</p>\n                                                            <p data-slot='inference-state'>\n                                                                <Verdict tone={setup.tenant.inference.state === 'ready' ? 'allowed' : 'info'} word={C.tenant.state[setup.tenant.inference.state]} />\n                                                            </p>\n                                                            <div className='grid' style={{ gridTemplateColumns: '1fr 1fr', gap: 12 }}>\n                                                                <Field label={C.tenant.endpoint} name='endpoint' value={endpoint} onChange={setEndpoint} hint={C.tenant.endpointHint} error={errors.endpoint} />\n                                                                <SecretField label={C.tenant.workspaceKey} inputRef={workspaceKeyRef} error={errors.workspaceKey} />\n                                                            </div>\n                                                            <div>\n                                                                <Primary label={C.tenant.saveWorkspaceKey} disabled={busy} />\n                                                            </div>\n                                                        </form>\n                                                    )}\n                                                </div>\n                                            )}\n                                        </OptionalCard>\n                                    </>\n                                )}\n                            </>\n                        )}\n                        {step === 'products' && setup && (\n                            <>\n                                <div>\n                                    <h1 ref={heading} id={headingId} tabIndex={-1} className='font-bold' style={{ fontSize: 26, letterSpacing: '-0.01em' }}>\n                                        {C.products.title}\n                                    </h1>\n                                    <p className='text-[14px]' style={{ marginTop: 4, color: 'var(--v2-soft)' }}>\n                                        {C.products.lead(setup.tenant.label)}\n                                    </p>\n                                </div>\n                                <div className='grid' style={{ gridTemplateColumns: 'repeat(3, minmax(0, 1fr))', gap: 12 }} data-slot='product-cards'>\n                                    {PRODUCT_CARDS.map((card) => {\n                                        // An id without spaces (a label is not one): the description's targets.\n                                        const cardId = `product-${card.label.replace(/\\W+/g, '-').toLowerCase()}`\n                                        const unavailable = card.id === null\n                                        const always = card.id === 'runtimeSecurity'\n                                        const on = card.id !== null && setup.products.includes(card.id)\n                                        const reads = card.id === null ? null : card.id === 'runtimeSecurity' ? (scanReady ? C.products.readsWith.scanReady : C.products.readsWith.scanMissing) : clientReady ? C.products.readsWith.clientReady : C.products.readsWith.clientMissing\n                                        const lastStep = run && !run.stale && card.id ? run.steps.find((s) => s.product === card.id && s.line !== 'managementClient') : undefined\n                                        const missing = reads === C.products.readsWith.clientMissing || reads === C.products.readsWith.scanMissing\n                                        return (\n                                            // A label around a native checkbox, not a checkbox-role button: a checkbox's children are\n                                            // presentational to assistive technology, which hid the body and the tags (\"Always on\",\n                                            // \"Not available in this release\"); as the label's text they are read, and the control keeps\n                                            // the card's name, description and state. The card shows the control's focus ring.\n                                            <label\n                                                key={card.label}\n                                                className='relative flex flex-col text-left'\n                                                style={{ gap: 10, minHeight: 176, padding: '18px 20px', border: `1.5px solid ${on ? 'var(--v2-acc)' : 'var(--v2-rule)'}`, borderRadius: 12, background: on ? 'var(--v2-acc-soft)' : 'var(--v2-paper)', color: 'var(--v2-ink)', opacity: unavailable ? 0.7 : 1, cursor: unavailable || always ? 'default' : 'pointer' }}\n                                                data-slot='product-card'\n                                            >\n                                                <input\n                                                    type='checkbox'\n                                                    className='sr-only'\n                                                    checked={on}\n                                                    aria-disabled={unavailable || always ? true : undefined}\n                                                    aria-label={card.label}\n                                                    aria-describedby={`${cardId}-body ${cardId}-tags`}\n                                                    onChange={() => card.id && !always && void toggleProduct(card.id, !on)}\n                                                    data-slot='product-choice'\n                                                />\n                                                <span className='absolute grid place-items-center rounded-full' style={{ top: 14, right: 14, width: 20, height: 20, border: `1.5px solid ${on ? 'var(--v2-acc)' : 'var(--v2-ctl)'}`, background: on ? 'var(--v2-acc)' : 'transparent', color: 'var(--v2-acc-ink)' }}>\n                                                    {on && <Glyph name='check' size={11} color='var(--v2-acc-ink)' />}\n                                                </span>\n                                                <span className='grid place-items-center rounded-[10px]' style={{ width: 36, height: 36, background: on ? 'var(--v2-acc)' : 'var(--v2-inset)', color: on ? 'var(--v2-acc-ink)' : 'var(--v2-soft)' }}>\n                                                    <Glyph name={card.icon} size={18} color={on ? 'var(--v2-acc-ink)' : 'var(--v2-soft)'} />\n                                                </span>\n                                                <span className='block leading-[1.35]' style={{ paddingRight: 26 }}>\n                                                    <b className='text-[14px]'>{card.label}</b>\n                                                </span>\n                                                <span id={`${cardId}-body`} className='leading-[1.45]' style={{ color: 'var(--v2-soft)' }}>\n                                                    {card.body}\n                                                </span>\n                                                <span id={`${cardId}-tags`} className='mt-auto flex flex-wrap' style={{ gap: 6 }}>\n                                                    {unavailable && <Verdict tone='info' word={C.products.unavailable} />}\n                                                    {always && <Verdict tone='info' word={C.products.always} />}\n                                                    {card.readOnly && <Verdict tone='info' word={C.products.readOnly} />}\n                                                    {reads && !unavailable && <Verdict tone={missing ? 'flagged' : 'allowed'} word={reads} />}\n                                                    {lastStep && lastStep.state !== 'pending' && <Verdict tone={toneOf(lastStep.state)} word={C.verify.state[lastStep.state]} />}\n                                                </span>\n                                            </label>\n                                        )\n                                    })}\n                                </div>\n                                {!scanReady && (\n                                    <div className='flex items-center rounded-[8px] leading-[1.45]' style={{ gap: 8, padding: '10px 12px', background: 'var(--v2-flag-bg)' }} data-slot='no-scan-banner'>\n                                        <Glyph name='alert' size={15} color='var(--v2-flag)' className='shrink-0' />\n                                        <span className='flex-grow'>{C.products.noScan}</span>\n                                        <Secondary label={C.products.addScanKey} onClick={() => go(steps.indexOf('tenant'))} />\n                                    </div>\n                                )}\n                                <p className='text-[12px]' style={{ color: 'var(--v2-faint)' }}>\n                                    {C.products.licence}\n                                </p>\n                            </>\n                        )}\n                        {step === 'verify' && setup && (\n                            <>\n                                <div>\n                                    <h1 ref={heading} id={headingId} tabIndex={-1} className='font-bold' style={{ fontSize: 26, letterSpacing: '-0.01em' }}>\n                                        {C.verify.title}\n                                    </h1>\n                                    <p className='text-[14px]' style={{ marginTop: 4, color: 'var(--v2-soft)' }}>\n                                        {C.verify.lead(setup.tenant.label)}\n                                    </p>\n                                </div>\n                                <div role='status' aria-live='polite' className='flex items-center rounded-[12px]' style={{ gap: 12, padding: '14px 16px', background: !run ? 'var(--v2-inset)' : run.stale || run.blocking ? 'var(--v2-block-bg)' : running ? 'var(--v2-acc-soft)' : run.failed || run.warnings.length ? 'var(--v2-flag-bg)' : 'var(--v2-ok-bg)' }} data-slot='verify-banner'>\n                                    <Glyph name={!run || running ? 'clock' : run.stale || run.blocking ? 'ban' : run.failed || run.warnings.length ? 'alert' : 'check'} size={22} color={!run ? 'var(--v2-soft)' : run.stale || run.blocking ? 'var(--v2-block)' : running ? 'var(--v2-acc)' : run.failed || run.warnings.length ? 'var(--v2-flag)' : 'var(--v2-ok)'} className='shrink-0' />\n                                    <span className='flex-grow'>\n                                        <b className='text-[14px]'>{!run ? C.verify.notRunTitle : verifyStatus}</b>\n                                        <br />\n                                        <span style={{ color: 'var(--v2-soft)' }}>{!run ? C.verify.notRunText : running ? C.verify.runningText : run.stale ? C.verify.staleText : run.blocking ? C.verify.failedText : run.failed ? C.verify.failedOptionalText : C.verify.doneText}</span>\n                                    </span>\n                                    {run && run.done && run.failed && !run.stale && <Secondary label={C.verify.editCredentials} onClick={() => go(steps.indexOf('tenant'))} />}\n                                </div>\n                                <ul className='flex flex-col overflow-hidden rounded-[12px] border' aria-label='Checks' aria-busy={running} style={{ borderColor: 'var(--v2-rule)', background: 'var(--v2-paper)', opacity: run?.stale ? 0.6 : 1 }}>\n                                    {plannedRows.map((r, i) => {\n                                        const tone = run || r.state === 'unavailable' ? toneOf(r.state) : 'info'\n                                        const colors: [string, string, GlyphName] = tone === 'allowed' ? ['var(--v2-ok-bg)', 'var(--v2-ok)', 'check'] : tone === 'flagged' ? ['var(--v2-flag-bg)', 'var(--v2-flag)', 'alert'] : tone === 'blocked' ? ['var(--v2-block-bg)', 'var(--v2-block)', 'x'] : ['var(--v2-inset)', 'var(--v2-soft)', running && r.state === 'pending' ? 'clock' : 'dot']\n                                        return (\n                                            <li key={r.line} className='flex items-center' style={{ gap: 12, padding: '12px 18px', borderTop: i ? '1px solid var(--v2-rule)' : 0 }} data-slot={`verify-${r.line}`}>\n                                                <span className='grid shrink-0 place-items-center rounded-full' style={{ width: 26, height: 26, background: colors[0], color: colors[1] }}>\n                                                    <Glyph name={colors[2]} size={13} color={colors[1]} />\n                                                </span>\n                                                <span className='min-w-0 flex-grow'>\n                                                    <b className='font-semibold'>{C.verify.rows[r.line]}</b>\n                                                    <br />\n                                                    <span className='leading-[1.45]' style={{ color: tone === 'blocked' ? 'var(--v2-block)' : tone === 'flagged' ? 'var(--v2-flag)' : 'var(--v2-soft)' }}>\n                                                        {r.reason}\n                                                    </span>\n                                                </span>\n                                                <Verdict tone={tone} word={run || r.state === 'unavailable' ? C.verify.state[r.state] : C.verify.notRun} />\n                                            </li>\n                                        )\n                                    })}\n                                </ul>\n                            </>\n                        )}\n                        {step === 'packs' && setup && (\n                            <>\n                                <div>\n                                    <h1 ref={heading} id={headingId} tabIndex={-1} className='font-bold' style={{ fontSize: 26, letterSpacing: '-0.01em' }}>\n                                        {C.packs.title}\n                                    </h1>\n                                    <p className='text-[14px]' style={{ marginTop: 4, color: 'var(--v2-soft)' }}>\n                                        {C.packs.lead(setup.tenant.label)}\n                                    </p>\n                                </div>\n                                {setup.packs.some((p) => p.count > 0) ? (\n                                    <div role='group' aria-label={C.packs.title} className='flex flex-col overflow-hidden rounded-[12px] border' style={{ borderColor: 'var(--v2-rule)', background: 'var(--v2-paper)' }} data-slot='pack-list'>\n                                        {setup.packs.map((p, i) => {\n                                            const on = selectedPacks.includes(p.product)\n                                            const off = p.count === 0 || !setup.products.includes(p.product)\n                                            const cardInfo = PRODUCT_CARDS.find((c) => c.id === p.product)\n                                            return (\n                                                <button\n                                                    key={p.product}\n                                                    type='button'\n                                                    role='checkbox'\n                                                    aria-checked={on}\n                                                    aria-disabled={off ? true : undefined}\n                                                    aria-label={C.packs.pack(productLabel(p.product), p.count)}\n                                                    onClick={() => !off && setPacks(on ? selectedPacks.filter((x) => x !== p.product) : [...selectedPacks, p.product])}\n                                                    className='flex w-full items-center text-left'\n                                                    style={{ gap: 14, padding: '12px 18px', border: 0, borderTop: i ? '1px solid var(--v2-rule)' : 0, background: 'transparent', color: 'var(--v2-ink)', opacity: off ? 0.55 : 1 }}\n                                                    data-slot='pack-row'\n                                                >\n                                                    <span className='grid shrink-0 place-items-center rounded-[5px]' style={{ width: 18, height: 18, border: `1.5px solid ${on ? 'var(--v2-acc)' : 'var(--v2-ctl)'}`, background: on ? 'var(--v2-acc)' : 'transparent', color: 'var(--v2-acc-ink)' }}>\n                                                        {on && <Glyph name='check' size={11} color='var(--v2-acc-ink)' />}\n                                                    </span>\n                                                    {tile(cardInfo?.icon ?? 'cases')}\n                                                    <span className='min-w-0 flex-grow'>\n                                                        <b className='font-semibold'>{C.packs.name(productLabel(p.product))}</b> <span style={{ color: 'var(--v2-faint)' }}>· {productLabel(p.product)}</span>\n                                                        <br />\n                                                        <span style={{ color: 'var(--v2-soft)' }}>{cardInfo?.body ?? ''}</span>\n                                                    </span>\n                                                    <span className='text-[12px] whitespace-nowrap' style={{ color: 'var(--v2-faint)' }}>\n                                                        {C.packs.count(p.count)}\n                                                    </span>\n                                                </button>\n                                            )\n                                        })}\n                                    </div>\n                                ) : (\n                                    <p className='text-[13px]' style={{ color: 'var(--v2-soft)' }}>\n                                        {C.packs.none}\n                                    </p>\n                                )}\n                                <p style={{ color: 'var(--v2-soft)' }} data-slot='pack-summary'>\n                                    {C.packs.summary(selectedPacks.length, selectedPacks.reduce((a, id) => a + (setup.packs.find((p) => p.product === id)?.count ?? 0), 0))}\n                                </p>\n                            </>\n                        )}\n                        {step === 'academy' && (\n                            <>\n                                <div>\n                                    <h1 ref={heading} id={headingId} tabIndex={-1} className='font-bold' style={{ fontSize: 26, letterSpacing: '-0.01em' }}>\n                                        {C.academy.title}\n                                    </h1>\n                                    <p className='text-[14px]' style={{ marginTop: 4, color: 'var(--v2-soft)' }}>\n                                        {C.academy.lead}\n                                    </p>\n                                </div>\n                                <div className='grid' style={{ gridTemplateColumns: 'minmax(0, 1fr) minmax(0, 1fr)', gap: 14 }}>\n                                    {card(\n                                        <>\n                                            <b className='text-[14px]'>{C.academy.account}</b>\n                                            <AcademyAccount view={snapshot.academy} dispatch={dispatch} />\n                                        </>,\n                                        {},\n                                        { 'data-slot': 'academy-card' }\n                                    )}\n                                    {card(\n                                        <>\n                                            <b className='text-[14px]'>{C.academy.whatSyncs}</b>\n                                            <ul className='flex list-disc flex-col pl-5 text-[13px]' style={{ gap: 6, color: 'var(--v2-soft)' }}>\n                                                {C.academy.syncs.map((t) => (\n                                                    <li key={t}>{t}</li>\n                                                ))}\n                                            </ul>\n                                        </>,\n                                        { gap: 10 },\n                                        { 'data-slot': 'academy-syncs' }\n                                    )}\n                                </div>\n                            </>\n                        )}\n                        {step === 'done' && setup && (\n                            <div className='flex flex-col' style={{ gap: 16, paddingTop: 10 }}>\n                                <span className='grid place-items-center rounded-[18px]' style={{ width: 64, height: 64, background: 'var(--v2-ok-bg)', color: 'var(--v2-ok)' }}>\n                                    <Glyph name='check' size={34} color='var(--v2-ok)' />\n                                </span>\n                                <h1 ref={heading} id={headingId} tabIndex={-1} className='font-bold' style={{ fontSize: 30, letterSpacing: '-0.02em' }}>\n                                    {C.done.title(setup.tenant.label)}\n                                </h1>\n                                <p className='text-[15px]' style={{ color: 'var(--v2-soft)' }}>\n                                    {C.done.lead}\n                                </p>\n                                <div className='flex flex-col overflow-hidden rounded-[12px] border' style={{ borderColor: 'var(--v2-rule)', background: 'var(--v2-paper)' }} data-slot='summary'>\n                                    {(\n                                        [\n                                            [C.done.summary.tenant, railCtx, 'ok', 'tenant'],\n                                            [C.done.summary.scan, scanReady ? C.done.summary.saved : C.done.summary.notSaved, scanReady ? 'ok' : 'skip', 'tenant'],\n                                            [C.done.summary.client, clientReady ? C.done.summary.saved : C.done.summary.notSaved, clientReady ? 'ok' : 'skip', 'tenant'],\n                                            [C.done.summary.products, setup.products.map(productLabel).join(', '), 'ok', 'products'],\n                                            [C.done.summary.checks, ...checksSummary(run), 'verify'],\n                                            [C.done.summary.packs, selectedPacks.length ? selectedPacks.map(productLabel).join(', ') : C.done.summary.none, selectedPacks.length ? 'ok' : 'skip', 'packs'],\n                                            ...(isAdd ? [] : [[C.done.summary.academy, snapshot.academy.state === 'signedIn' ? snapshot.academy.displayName : C.done.summary.academySkipped, snapshot.academy.state === 'signedIn' ? 'ok' : 'skip', 'academy']]),\n                                        ] as [string, string, 'ok' | 'warn' | 'skip', WizardStep][]\n                                    ).map(([k, v, tone, target], i) => (\n                                        <div key={k} className='flex items-center' style={{ gap: 12, padding: '12px 18px', borderTop: i ? '1px solid var(--v2-rule)' : 0 }}>\n                                            <span className='grid shrink-0 place-items-center rounded-full' style={{ width: 26, height: 26, background: tone === 'ok' ? 'var(--v2-ok-bg)' : tone === 'warn' ? 'var(--v2-flag-bg)' : 'var(--v2-inset)', color: tone === 'ok' ? 'var(--v2-ok)' : tone === 'warn' ? 'var(--v2-flag)' : 'var(--v2-soft)' }}>\n                                                <Glyph name={tone === 'ok' ? 'check' : tone === 'warn' ? 'alert' : 'dot'} size={13} color={tone === 'ok' ? 'var(--v2-ok)' : tone === 'warn' ? 'var(--v2-flag)' : 'var(--v2-soft)'} />\n                                            </span>\n                                            <span className='font-semibold' style={{ width: 130 }}>\n                                                {k}\n                                            </span>\n                                            <span className='sr-only'>: </span>\n                                            <span className='min-w-0 flex-grow' style={{ color: 'var(--v2-soft)' }}>\n                                                {v}\n                                            </span>\n                                            <button type='button' onClick={() => reachable(steps.indexOf(target)) && go(steps.indexOf(target))} className='text-[12px] font-semibold' style={{ color: 'var(--v2-acc)' }} aria-label={`${C.done.change} ${k}`}>\n                                                {C.done.change}\n                                            </button>\n                                        </div>\n                                    ))}\n                                </div>\n                                <div className='grid' style={{ gridTemplateColumns: 'repeat(3, minmax(0, 1fr))', gap: 12 }} data-slot='next-up'>\n                                    {C.done.nextUp.map((n) => (\n                                        <div key={n.title} className='flex flex-col rounded-[12px] border' style={{ gap: 8, padding: '18px 20px', borderColor: 'var(--v2-rule)', background: 'var(--v2-paper)' }}>\n                                            <span className='grid place-items-center rounded-[8px]' style={{ width: 28, height: 28, background: 'var(--v2-acc-soft)', color: 'var(--v2-acc)' }}>\n                                                <Glyph name={n.icon} size={14} color='var(--v2-acc)' />\n                                            </span>\n                                            <b>{n.title}</b>\n                                            <span className='leading-[1.45]' style={{ color: 'var(--v2-soft)' }}>\n                                                {n.text}\n                                            </span>\n                                        </div>\n                                    ))}\n                                </div>\n                            </div>\n                        )}\n                    </section>\n                </main>\n                <footer className='flex shrink-0 flex-wrap items-center' style={{ gap: 10, padding: isAdd ? '14px 32px' : '14px 44px', borderTop: '1px solid var(--v2-rule)', background: 'var(--v2-bg)' }} data-slot='wizard-footer'>\n                    {isAdd && (\n                        <button type='button' onClick={() => void cancel()} disabled={cancelling} className='h-8 rounded-[7px] border px-3.5 text-[13px] disabled:opacity-60' style={{ borderColor: 'var(--v2-rule)', background: 'var(--v2-paper)' }}>\n                            {cancelling ? C.cancelling : C.cancel}\n                        </button>\n                    )}\n                    {showBack && (\n                        <button type='button' onClick={() => go(index - 1)} className='h-8 rounded-[7px] border px-3.5 text-[13px]' style={{ borderColor: 'var(--v2-rule)', background: 'var(--v2-paper)' }}>\n                            {C.back}\n                        </button>\n                    )}\n                    <p role='status' aria-live='polite' data-slot='wizard-status' className='flex min-w-0 items-center text-[12.5px]' style={{ gap: 10, color: status ? 'var(--v2-ink)' : 'var(--v2-soft)' }}>\n                        <span className='min-w-0'>{status?.text ?? hint}</span>\n                        {status?.retry && <Secondary label={C.outcome.retry} onClick={status.retry} />}\n                    </p>\n                    <span className='ml-auto text-[12px]' style={{ color: 'var(--v2-faint)' }} data-slot='wizard-progress'>\n                        {C.progress(index + 1, steps.length)}\n                    </span>\n                    {extra && <Secondary label={extra.label} onClick={extra.onClick} disabled={extra.disabled} />}\n                    {secondary && <Secondary label={secondary.label} onClick={secondary.onClick} disabled={secondary.disabled} />}\n                    {skipBtn && <Secondary label={skipBtn.label} onClick={skipBtn.onClick} disabled={skipBtn.disabled} />}\n                    <button type='button' onClick={primary.onClick} disabled={primary.disabled} className='h-8 rounded-[7px] px-[18px] text-[13px] font-semibold disabled:opacity-60' style={{ background: 'var(--v2-acc)', color: 'var(--v2-acc-ink)' }} data-slot='wizard-primary'>\n                        {primary.label}\n                    </button>\n                </footer>\n            </div>\n            {/* The guard is a dialog above the sheet (I8): rendered at the body, outside the sheet's inert subtree. */}\n            {completionGuard && setup && createPortal(<SwitchGuard target={setup.tenant.label} completion binding={completionGuard} onStay={() => void dispatch({ kind: 'dismissSwitchGuard' })} onResolve={(resolution) => void finish(resolution)} />, document.body)}\n        </div>\n    )\n}\n\n/** A section card with a switch in its header (R2Onboard's optional cards); a required card has no switch and stays open. */\nfunction OptionalCard({ icon, title, text, tag, open, onToggle, switchLabel, state, slot, onSubmit, busy, children }: { icon: GlyphName; title: string; text: string; tag: string; open: boolean; onToggle?: (on: boolean) => void; switchLabel?: string; state?: ReactNode; slot: string; onSubmit?: (e: FormEvent<HTMLFormElement>) => void; busy?: boolean; children: ReactNode }) {\n    const Tag = onSubmit ? 'form' : 'section'\n    return (\n        <Tag onSubmit={onSubmit} aria-busy={onSubmit ? busy : undefined} aria-label={onSubmit ? undefined : title} className='flex flex-col rounded-[12px] border' style={{ gap: 12, padding: '18px 20px', borderColor: 'var(--v2-rule)', background: 'var(--v2-paper)' }} data-slot={slot}>\n            <div className='flex items-center' style={{ gap: 12 }}>\n                <span className='grid shrink-0 place-items-center rounded-[8px]' style={{ width: 30, height: 30, background: 'var(--v2-inset)', color: 'var(--v2-soft)' }}>\n                    <Glyph name={icon} size={15} color='var(--v2-soft)' />\n                </span>\n                <span className='min-w-0 flex-grow'>\n                    <span className='flex items-center' style={{ gap: 8 }}>\n                        <b className='text-[14px]'>{title}</b>\n                        <span className='rounded-full text-[12px] font-semibold' style={{ padding: '1px 7px', background: 'var(--v2-inset)', color: 'var(--v2-faint)' }}>\n                            {tag}\n                        </span>\n                        {state}\n                    </span>\n                    <span className='text-[12px]' style={{ color: 'var(--v2-soft)' }}>\n                        {text}\n                    </span>\n                </span>\n                {onToggle && (\n                    <button type='button' role='switch' aria-checked={open} aria-label={switchLabel ?? title} onClick={() => onToggle(!open)} className='relative shrink-0 rounded-full' style={{ width: 38, height: 22, border: 0, background: open ? 'var(--v2-acc)' : 'var(--v2-inset)', boxShadow: `inset 0 0 0 1px ${open ? 'var(--v2-acc)' : 'var(--v2-ctl)'}` }} data-slot='switch'>\n                        <span className='absolute rounded-full' style={{ top: 3, left: open ? 19 : 3, width: 16, height: 16, background: open ? 'var(--v2-acc-ink)' : 'var(--v2-paper)' }} />\n                    </button>\n                )}\n            </div>\n            {open && (\n                <div className='flex flex-col' style={{ gap: 10, paddingLeft: 42 }}>\n                    {children}\n                </div>\n            )}\n        </Tag>\n    )\n}\n\nfunction Field({ label, name, hint, error, onBlur, value, onChange, ...rest }: { label: string; name: string; hint?: string; error?: string; onBlur?: (value: string) => void; value?: string; onChange?: (value: string) => void; maxLength?: number; inputMode?: 'numeric' }) {\n    const id = useId()\n    return (\n        <label className='flex flex-col text-[12px] font-semibold' style={{ gap: 5, color: 'var(--v2-soft)' }}>\n            {label}\n            <input id={id} name={name} autoComplete='off' value={value} onChange={onChange ? (e) => onChange(e.target.value) : undefined} aria-invalid={error ? true : undefined} aria-describedby={error ? `${id}-error` : hint ? `${id}-hint` : undefined} onBlur={(e) => onBlur?.(e.target.value)} className='h-8 min-h-0 rounded-[7px] border px-2.5 text-[13px] font-normal' style={{ borderColor: error ? 'var(--v2-block)' : 'var(--v2-ctl)', background: 'var(--v2-bg)', color: 'var(--v2-ink)' }} {...rest} />\n            {error ? (\n                <span id={`${id}-error`} role='alert' className='font-normal' style={{ color: 'var(--v2-block)' }}>\n                    {error}\n                </span>\n            ) : hint ? (\n                <span id={`${id}-hint`} className='font-normal' style={{ color: 'var(--v2-faint)' }}>\n                    {hint}\n                </span>\n            ) : null}\n        </label>\n    )\n}\n\n/** A password field read once through its ref and cleared by the caller (P25). */\nfunction SecretField({ label, inputRef, error }: { label: string; inputRef: React.RefObject<HTMLInputElement | null>; error?: string }) {\n    const id = useId()\n    return (\n        <label className='flex flex-col text-[12px] font-semibold' style={{ gap: 5, color: 'var(--v2-soft)' }}>\n            {label}\n            <input id={id} ref={inputRef} type='password' autoComplete='off' aria-invalid={error ? true : undefined} aria-describedby={error ? `${id}-error` : undefined} className='h-8 min-h-0 rounded-[7px] border px-2.5 text-[13px] font-normal' style={{ borderColor: error ? 'var(--v2-block)' : 'var(--v2-ctl)', background: 'var(--v2-bg)', color: 'var(--v2-ink)' }} />\n            {error && (\n                <span id={`${id}-error`} role='alert' className='font-normal' style={{ color: 'var(--v2-block)' }}>\n                    {error}\n                </span>\n            )}\n        </label>\n    )\n}\n\nfunction Primary({ label, disabled }: { label: string; disabled?: boolean }) {\n    return (\n        <button type='submit' disabled={disabled} className='h-8 rounded-[7px] px-4 text-[13px] font-semibold disabled:opacity-60' style={{ background: 'var(--v2-acc)', color: 'var(--v2-acc-ink)' }}>\n            {label}\n        </button>\n    )\n}\n\nfunction Secondary({ label, onClick, disabled }: { label: string; onClick: () => void; disabled?: boolean }) {\n    return (\n        <button type='button' onClick={onClick} disabled={disabled} className='h-8 rounded-[7px] border px-3 text-[13px] disabled:opacity-60' style={{ borderColor: 'var(--v2-rule)', background: 'var(--v2-paper)', color: 'var(--v2-ink)' }}>\n            {label}\n        </button>\n    )\n}\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_21","type":"command_execution","command":"/bin/zsh -lc \"cat apps/desktop/src/v2/inbox/inbox.tsx apps/desktop/src/v2/setup-warning-history.tsx apps/desktop/src/modules/diagnostics/diagnostics-panel.tsx; git diff f1e58da5 -- packages/desktop-contracts/src/client.ts; rg -n 'arrival|modelSkill|warning|tenant' apps/desktop/src/v2/v2-shell.tsx apps/desktop/src/v2/admin/administration.tsx\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_21","type":"command_execution","command":"/bin/zsh -lc \"cat apps/desktop/src/v2/inbox/inbox.tsx apps/desktop/src/v2/setup-warning-history.tsx apps/desktop/src/modules/diagnostics/diagnostics-panel.tsx; git diff f1e58da5 -- packages/desktop-contracts/src/client.ts; rg -n 'arrival|modelSkill|warning|tenant' apps/desktop/src/v2/v2-shell.tsx apps/desktop/src/v2/admin/administration.tsx\"","aggregated_output":"import { forwardRef, useEffect, useRef, useState } from 'react'\nimport type { FeatureId, InboxEntry, Intent, ProductId, SetupWarning, ShellSnapshot } from '@prisma-airs/desktop-contracts'\nimport type { DispatchOutcome } from '../../modules/tenants/dispatch'\nimport { INBOX_COPY as C, READ_COPY, SHELL_COPY, SNOOZE_COPY, clockOf } from '../copy'\nimport { Glyph, type GlyphName } from '../icons'\nimport { useShellStore } from '../store'\nimport type { VerdictTone } from '../verdict'\nimport { PageIntro } from '../page-intro'\nimport { SetupWarningResult } from '../setup-warning-history'\n\n/**\n * Sends one intent and reports its outcome on the shell's surfaces (DESIGN-V2\n * §7): a refusal or failed delivery as a warn toast naming `what`, an\n * unconfirmed delivery inline with Retry (never replayed on its own).\n */\nexport type Act = (what: string, intent: Intent) => Promise<DispatchOutcome>\n\nexport interface InboxProps {\n    snapshot: ShellSnapshot\n    onAct: Act\n    onNavigate: (feature: FeatureId) => void\n}\n\nexport type InboxTab = 'all' | 'action' | 'updates' | 'snoozed'\nconst TABS: InboxTab[] = ['all', 'action', 'updates', 'snoozed']\n\nexport const toneOf = (severity: InboxEntry['severity']): VerdictTone => (severity === 'bad' ? 'blocked' : severity === 'warn' ? 'flagged' : 'info')\n\n/** Where an entry's action leads (C30): the destination the core names. */\nexport function destinationFeature(entry: InboxEntry): FeatureId | null {\n    return entry.target?.feature ?? null\n}\n\n/**\n * Follows an entry's contextual action: the target's inventory and item are\n * handed to the destination (it selects them on arrival), then the shell\n * navigates through the core.\n */\nexport function follow(entry: InboxEntry, tenant: string, onNavigate: (feature: FeatureId) => void) {\n    const target = entry.target\n    if (!target) return\n    // The target belongs to the tenant it was followed in (I2): another tenant never inherits it.\n    useShellStore.getState().arrive({ tenant, feature: target.feature, resource: target.resource, item: target.item, ...(target.product ? { product: target.product } : {}) })\n    onNavigate(target.feature)\n}\n\n/** The tenant-named description of a hold action, for its outcome report. */\nexport function holdWhat(kind: 'acknowledgeItem' | 'snoozeItem' | 'unsnoozeItem', title: string): string {\n    return kind === 'acknowledgeItem' ? SHELL_COPY.acknowledgmentOf(title) : kind === 'snoozeItem' ? SHELL_COPY.snoozeOf(title) : SHELL_COPY.unsnoozeOf(title)\n}\n\n/** Which tab an entry belongs to; held entries are never \"needs action\". */\nexport function tabOf(entry: InboxEntry): InboxTab {\n    if (entry.hold?.kind === 'snooze') return 'snoozed'\n    if (entry.needsAction && !entry.hold) return 'action'\n    return 'updates'\n}\n\nconst severityTile = (severity: InboxEntry['severity']): { glyph: GlyphName; fg: string; bg: string } =>\n    severity === 'bad' ? { glyph: 'ban', fg: 'var(--v2-block)', bg: 'var(--v2-block-bg)' } : severity === 'warn' ? { glyph: 'alert', fg: 'var(--v2-flag)', bg: 'var(--v2-flag-bg)' } : { glyph: 'info', fg: 'var(--v2-soft)', bg: 'var(--v2-inset)' }\n\nconst button32 = 'flex h-8 min-h-0 items-center rounded-[7px] text-[13px] whitespace-nowrap'\n\n/**\n * The Inbox (C30, screens/inbox-reads.md): the active tenant's entries from\n * the core's Inbox scope, in tabs with counts, a detail pane with the facts,\n * the explanation and the contextual actions. Acknowledge and snooze are\n * core intents on the entry; the snooze return time is the core's and the\n * label is the one Home uses (I11). The selected tab and item are kept per\n * tenant across a switch (I2) and cleared when the tenant is deleted.\n */\nexport const Inbox = forwardRef<HTMLHeadingElement, InboxProps>(function Inbox({ snapshot, onAct, onNavigate }, _ref) {\n    const tenant = snapshot.tenants.find((t) => t.id === snapshot.active?.tenant) ?? null\n    const context = snapshot.active?.context ?? null\n    const tenantKey = tenant?.id ?? 'none'\n    const selection = useShellStore((s) => s.inboxSelection[tenantKey])\n    const selectInbox = useShellStore((s) => s.selectInbox)\n    const tab: InboxTab = selection?.tab ?? 'all'\n    const selectedId = selection?.item ?? null\n    const items = snapshot.inbox.items\n    const counts: Record<InboxTab, number> = { all: items.length, action: 0, updates: 0, snoozed: 0 }\n    for (const e of items) counts[tabOf(e)] += 1\n    const visible = items.filter((e) => tab === 'all' || tabOf(e) === tab)\n    const selected = items.find((e) => e.id === selectedId) ?? null\n    const selectedWarning = selected?.kind === 'setupWarning' ? tenant?.setupWarnings.find((w) => w.id === selected.id) : undefined\n    useEffect(() => {\n        if (selectedId && !items.some((e) => e.id === selectedId)) selectInbox(tenantKey, { tab, item: null })\n    }, [items, selectedId, selectInbox, tenantKey, tab])\n    const read = snapshot.inbox.read\n\n    // Holds are core intents; their outcomes reach the shell's surfaces. A\n    // snooze's return time is the core's: the shell announces it from the\n    // receipt the snapshot carries (the same toast whether asked here or on Home).\n    const act = (entry: InboxEntry, kind: 'acknowledgeItem' | 'snoozeItem' | 'unsnoozeItem') => context && void onAct(holdWhat(kind, entry.title), { kind, context, id: entry.id })\n    const readNow = () => context && tenant && void onAct(SHELL_COPY.readOf(tenant.label), { kind: 'readTenant', context })\n\n    // Never attempted, in progress, failed, partial, expired and healthy-empty\n    // reads stay distinct (I4, C12). Entries the core supplies (a setup\n    // warning before any read) are listed whatever the read status.\n    const failedUnread = read.state === 'failed' && read.lastReadAt === null && read.failedAt !== null\n    const stale = (read.state === 'done' || read.state === 'reading') && read.lastReadAt !== null && !snapshot.overview.fresh\n    const readingAgain = read.state === 'reading' && read.lastReadAt !== null\n    const empty = !tenant\n        ? C.emptyPending\n        : items.length === 0 && read.state === 'reading'\n          ? C.emptyReading\n          : items.length === 0 && read.state === 'pending'\n            ? C.emptyPending\n            : items.length === 0 && failedUnread\n              ? C.emptyFailed(clockOf(read.failedAt ?? 0))\n              : items.length === 0 && read.lastReadAt === null && read.settledAt !== null\n                ? C.emptyUnread(clockOf(read.settledAt), read.sourcesMissing.length)\n                : visible.length === 0\n                  ? tab === 'all' || tab === 'action'\n                      ? read.sourcesMissing.length > 0\n                          ? C.emptyPartial(read.products.reduce((n, p) => n + p.sourcesRead, 0), read.products.reduce((n, p) => n + p.sourcesTotal, 0), read.sourcesMissing)\n                          : stale\n                            ? C.emptyStale(clockOf(read.lastReadAt ?? 0))\n                            : C.emptyClear\n                      : C.emptyTab\n                  : null\n    const partialLine =\n        read.state === 'failed' && read.failedAt !== null && read.lastReadAt !== null\n            ? C.failedKept(clockOf(read.failedAt), clockOf(read.lastReadAt))\n            : (read.lastReadAt ?? read.settledAt) !== null && read.sourcesMissing.length > 0\n              ? C.partial(read.products.reduce((n, p) => n + p.sourcesRead, 0), read.products.reduce((n, p) => n + p.sourcesTotal, 0), clockOf(read.lastReadAt ?? read.settledAt ?? 0))\n              : readingAgain\n                ? stale\n                    ? C.readingStale(clockOf(read.lastReadAt ?? 0))\n                    : C.readingKept(clockOf(read.lastReadAt ?? 0))\n                : stale\n                  ? C.stale(clockOf(read.lastReadAt ?? 0))\n                  : null\n\n    // The empty states' role issue, the footer's coverage lines and the product hand-off (C37, R2App).\n    const needsRole = read.products.find((p) => p.state === 'needsRole') ?? null\n    const openProduct = (id: ProductId) => {\n        if (tenant) useShellStore.getState().arrive({ tenant: tenant.id, feature: 'administration', resource: null, item: null, product: id })\n        onNavigate('administration')\n    }\n    const sourcesRead = read.products.reduce((n, p) => n + p.sourcesRead, 0)\n    const sourcesTotal = read.products.reduce((n, p) => n + p.sourcesTotal, 0)\n    const readAt = read.lastReadAt ?? read.settledAt\n    const footLine1 = !tenant || readAt === null ? C.footNoReads(tenant?.label ?? '') : read.sourcesMissing.length > 0 ? C.footPartial(sourcesRead, sourcesTotal, clockOf(readAt)) : C.footAll(clockOf(readAt))\n    const gateway = snapshot.overview.read?.gateway ?? null\n    const footLine2 = gateway ? C.footGateway(gateway.workspaceName, gateway.policies) : (snapshot.overview.read?.gaps[0] ?? '')\n\n    return (\n        <section aria-label={C.title} data-slot='inbox' className='flex min-h-0 flex-grow flex-col' style={{ gap: 20 }}>\n            <PageIntro\n                description={\n                    <p role='status' data-slot='inbox-sub' className='text-[14px]' style={{ marginTop: 4, color: 'var(--v2-soft)' }}>\n                        {tenant ? C.sub(tenant.label) : C.emptyPending}\n                        {partialLine ? ` · ${partialLine}` : ''}\n                    </p>\n                }\n                actions={context && (\n                    <button type='button' onClick={readNow} disabled={read.state === 'reading'} className={`${button32} ml-auto border px-3.5 disabled:opacity-60`} style={{ borderColor: 'var(--v2-rule)', background: 'var(--v2-paper)', color: 'var(--v2-ink)' }}>\n                        {read.state === 'reading' ? C.reading : C.refresh}\n                    </button>\n                )}\n            />\n            {/* The list column is the prototype's 430px beside the detail; one under the other when both cannot fit (200% zoom, a narrow window). */}\n            <div data-slot='inbox-columns' className='grid min-h-0 min-w-0 flex-grow' style={{ gridTemplateColumns: 'minmax(0, 430px) minmax(0, 1fr)', gap: 20 }}>\n                <section aria-label={C.listCard} data-slot='inbox-list' className='flex min-h-0 min-w-0 flex-col overflow-hidden rounded-[12px] border' style={{ borderColor: 'var(--v2-rule)', background: 'var(--v2-paper)' }}>\n                    <div className='flex items-center' style={{ padding: '14px 18px', gap: 10, borderBottom: '1px solid var(--v2-rule)' }}>\n                        <div role='tablist' aria-label={C.filter} className='flex rounded-[8px]' style={{ padding: 2, background: 'var(--v2-inset)' }}>\n                            {TABS.map((t) => (\n                                <button\n                                    key={t}\n                                    role='tab'\n                                    type='button'\n                                    id={`itab-${t}`}\n                                    aria-controls='inbox-panel'\n                                    aria-selected={tab === t}\n                                    onClick={() => selectInbox(tenantKey, { tab: t, item: selectedId })}\n                                    className='h-7 min-h-0 rounded-[6px] px-3 text-[12px] font-semibold'\n                                    style={{ background: tab === t ? 'var(--v2-paper)' : 'transparent', boxShadow: tab === t ? '0 1px 2px rgba(0,0,0,0.12)' : 'none', color: 'var(--v2-ink)' }}\n                                >\n                                    {C.tabs[t]}{' '}\n                                    <span className='font-medium' style={{ color: 'var(--v2-faint)' }}>\n                                        {counts[t]}\n                                    </span>\n                                </button>\n                            ))}\n                        </div>\n                    </div>\n                    <div role='tabpanel' id='inbox-panel' aria-labelledby={`itab-${tab}`} className='min-h-0 flex-grow overflow-auto'>\n                        {empty ? (\n                            <div role='status' data-slot='inbox-empty' className='flex flex-col items-center text-center leading-[1.5]' style={{ gap: 12, padding: '32px 18px', color: 'var(--v2-faint)' }}>\n                                <span>{empty}</span>\n                                {needsRole && context && (\n                                    <button type='button' onClick={() => openProduct(needsRole.product)} className={`${button32} border px-3.5 font-semibold`} style={{ borderColor: 'var(--v2-flag)', background: 'var(--v2-flag-bg)', color: 'var(--v2-flag)' }}>\n                                        {C.openRoleIssue}\n                                    </button>\n                                )}\n                            </div>\n                        ) : (\n                            <ul aria-label={C.ariaList} className='flex flex-col'>\n                                {visible.map((e) => {\n                                    const tile = severityTile(e.severity)\n                                    const current = selected?.id === e.id\n                                    return (\n                                        <li key={e.id}>\n                                            <button\n                                                type='button'\n                                                aria-current={current ? 'true' : undefined}\n                                                data-inset-focus=''\n                                                onClick={() => selectInbox(tenantKey, { tab, item: e.id })}\n                                                className='flex w-full min-w-0 items-start text-left'\n                                                style={{ gap: 10, padding: '14px 18px', borderBottom: '1px solid var(--v2-rule)', background: current ? 'var(--v2-inset)' : 'transparent', boxShadow: current ? 'inset 3px 0 0 var(--v2-acc)' : 'none', color: 'var(--v2-ink)' }}\n                                            >\n                                                <span aria-hidden='true' className='grid size-[26px] shrink-0 place-items-center rounded-[7px]' style={{ background: tile.bg, color: tile.fg }}>\n                                                    <Glyph name={tile.glyph} size={13} stroke={2} />\n                                                </span>\n                                                <span className='min-w-0 flex-grow'>\n                                                    <span className='block font-semibold [overflow-wrap:anywhere]'>{e.title}</span>\n                                                    <span className='text-[12px]' style={{ color: 'var(--v2-faint)' }}>\n                                                        {/* The severity is a word as well as a colour and an icon (I9). */}\n                                                        <span data-slot='severity' className='font-semibold' style={{ color: tile.fg }}>\n                                                            {C.severity[e.severity]}\n                                                        </span>\n                                                        {' · '}\n                                                        {e.product ? READ_COPY.products[e.product] : C.kind[e.kind]} · {e.source}\n                                                        {e.hold?.kind === 'snooze' && e.hold.returnsAt !== null ? ` · ${SNOOZE_COPY.returns(e.hold.returnsAt)}` : ''}\n                                                    </span>\n                                                    {e.hold?.kind === 'acknowledge' && (\n                                                        <span className='ml-2 inline-flex items-center gap-1 text-[12px] font-semibold' style={{ color: 'var(--v2-ok)' }}>\n                                                            <Glyph name='check' size={11} stroke={2.6} />\n                                                            {C.acknowledged}\n                                                        </span>\n                                                    )}\n                                                </span>\n                                                <span className='text-[12px]' style={{ color: 'var(--v2-faint)' }}>\n                                                    {clockOf(e.when)}\n                                                </span>\n                                            </button>\n                                        </li>\n                                    )\n                                })}\n                            </ul>\n                        )}\n                    </div>\n                    <div data-slot='inbox-foot' className='text-[12px] leading-[1.6]' style={{ padding: '14px 18px', borderTop: '1px solid var(--v2-rule)', color: 'var(--v2-faint)' }}>\n                        <span>{footLine1}</span>\n                        <br />\n                        <span>{footLine2}</span>\n                    </div>\n                </section>\n                <aside aria-label={C.detail} data-slot='inbox-detail' className='flex min-w-0 flex-col rounded-[12px] border break-words' style={{ padding: '28px 30px', gap: 18, borderColor: 'var(--v2-rule)', background: 'var(--v2-paper)' }}>\n                    {!selected ? (\n                        <div className='flex flex-grow flex-col items-center justify-center text-center leading-[1.5]' style={{ gap: 12, color: 'var(--v2-faint)' }}>\n                            <span>{empty ?? C.selectHint}</span>\n                        </div>\n                    ) : (\n                        <>\n                            <div className='flex items-center' style={{ gap: 10 }}>\n                                <span aria-hidden='true' className='grid size-[34px] place-items-center rounded-[9px]' style={{ background: severityTile(selected.severity).bg, color: severityTile(selected.severity).fg }}>\n                                    <Glyph name={severityTile(selected.severity).glyph} size={17} stroke={2} />\n                                </span>\n                                <span className='rounded-full text-[12px] font-semibold' style={{ padding: '2px 9px', background: severityTile(selected.severity).bg, color: severityTile(selected.severity).fg }}>\n                                    {C.severity[selected.severity]}\n                                </span>\n                                <span style={{ color: 'var(--v2-faint)' }}>\n                                    {selected.product ? READ_COPY.products[selected.product] : C.kind[selected.kind]} · {selected.source}\n                                </span>\n                            </div>\n                            <h2 className='min-w-0 text-[22px] font-bold' style={{ letterSpacing: '-0.01em' }}>\n                                {selected.title}\n                            </h2>\n                            <p className='text-[14px] leading-[1.55]' style={{ color: 'var(--v2-soft)' }}>\n                                {selected.detail}\n                            </p>\n                            {selectedWarning ? <SetupWarningResult warning={selectedWarning} live /> : null}\n                            {selected.facts.length > 0 && (\n                                <dl aria-label={C.facts} className='grid' style={{ gridTemplateColumns: 'repeat(3, minmax(0, 1fr))', gap: 10 }}>\n                                    {selected.facts.map((f) => (\n                                        <div key={f.label} className='rounded-[10px]' style={{ padding: '12px 14px', background: 'var(--v2-inset)' }}>\n                                            <dt className='text-[12px]' style={{ color: 'var(--v2-faint)' }}>\n                                                {f.label}\n                                            </dt>\n                                            <dd className='font-semibold' style={{ marginTop: 2 }}>\n                                                {f.value}\n                                            </dd>\n                                        </div>\n                                    ))}\n                                </dl>\n                            )}\n                            {snapshot.showCalls && (\n                                <div data-slot='inbox-why' className='flex gap-2 rounded-[10px] text-[13px] leading-[1.45]' style={{ padding: '12px 14px', background: 'var(--v2-acc-soft)', maxWidth: 860 }}>\n                                    <Glyph name='info' size={15} stroke={2} color='var(--v2-acc)' className='mt-px' />\n                                    <span>\n                                        <span className='font-semibold'>{C.why}: </span>\n                                        {C.whyText[selected.kind]}\n                                    </span>\n                                </div>\n                            )}\n                            {selected.hold?.kind === 'snooze' && selected.hold.returnsAt !== null && (\n                                <p data-slot='snooze-returns' className='text-[12px]' style={{ color: 'var(--v2-soft)' }}>\n                                    {SNOOZE_COPY.returns(selected.hold.returnsAt)}\n                                </p>\n                            )}\n                            <div className='flex flex-wrap' style={{ gap: 8, marginTop: 'auto' }}>\n                                {selectedWarning && context && selectedWarning.resolvedSecs === undefined ? <WarningRecheck key={`${context}:${selectedWarning.id}`} warning={selectedWarning} context={context} onAct={onAct} /> : null}\n                                {destinationFeature(selected) && selected.actionLabel && (\n                                    <button type='button' onClick={() => tenant && follow(selected, tenant.id, onNavigate)} className={`${button32} px-[18px] font-semibold`} style={{ background: 'var(--v2-acc)', color: 'var(--v2-acc-ink)' }}>\n                                        {selected.actionLabel}\n                                    </button>\n                                )}\n                                {selected.hold?.kind === 'acknowledge' ? (\n                                    <button type='button' aria-pressed='true' onClick={() => void act(selected, 'unsnoozeItem')} className={`${button32} border px-3.5`} style={{ borderColor: 'var(--v2-rule)', background: 'var(--v2-paper)', color: 'var(--v2-ink)' }}>\n                                        {C.needsAction}\n                                    </button>\n                                ) : (\n                                    <button type='button' aria-pressed='false' onClick={() => void act(selected, 'acknowledgeItem')} className={`${button32} border px-3.5`} style={{ borderColor: 'var(--v2-rule)', background: 'var(--v2-paper)', color: 'var(--v2-ink)' }}>\n                                        {C.acknowledge}\n                                    </button>\n                                )}\n                                {selected.hold?.kind === 'snooze' ? (\n                                    <button type='button' onClick={() => void act(selected, 'unsnoozeItem')} className={`${button32} border px-3.5`} style={{ borderColor: 'var(--v2-rule)', background: 'var(--v2-paper)', color: 'var(--v2-ink)' }}>\n                                        {C.unsnooze}\n                                    </button>\n                                ) : (\n                                    <button type='button' title={SNOOZE_COPY.offer} aria-label={`${SNOOZE_COPY.offer}: ${selected.title}`} onClick={() => void act(selected, 'snoozeItem')} className={`${button32} border px-3.5`} style={{ borderColor: 'var(--v2-rule)', background: 'var(--v2-paper)', color: 'var(--v2-ink)' }}>\n                                        {SNOOZE_COPY.offer}\n                                    </button>\n                                )}\n                            </div>\n                        </>\n                    )}\n                </aside>\n            </div>\n        </section>\n    )\n})\n\nfunction WarningRecheck({ warning, context, onAct }: { warning: SetupWarning; context: string; onAct: Act }) {\n    const [sending, setSending] = useState(false)\n    const live = useRef(true)\n    useEffect(() => { live.current = true; return () => { live.current = false } }, [])\n    const pending = sending || warning.recheck?.state === 'pending'\n    const recheck = async () => {\n        if (pending) return\n        setSending(true)\n        try {\n            // Admission failures/unknown deliveries use the shell's existing\n            // scoped report/Retry surface. Only native metadata states a result.\n            await onAct(`setup recheck for ${READ_COPY.products[warning.product]}`, { kind: 'recheckSetupWarning', context, warning: warning.id })\n        } finally {\n            if (live.current) setSending(false)\n        }\n    }\n    return <button type='button' disabled={pending} onClick={() => void recheck()} className={`${button32} border px-3.5`} style={{ borderColor: 'var(--v2-rule)', background: 'var(--v2-paper)', color: 'var(--v2-ink)' }}>Recheck setup</button>\n}\nimport type { SetupWarning, VerifyState } from '@prisma-airs/desktop-contracts'\nimport { READ_COPY } from './copy'\n\nconst CHECK_STATE: Record<VerifyState, string> = { pending: 'Checking', pass: 'Passed', warning: 'Warning', fail: 'Failed', stored: 'Stored', skipped: 'Skipped', unavailable: 'Unavailable' }\n\nfunction RecordedTime({ seconds }: { seconds: number }) {\n    const date = new Date(seconds * 1000)\n    return Number.isFinite(date.valueOf()) ? <time dateTime={date.toISOString()}>{date.toLocaleString()}</time> : <span>Time unavailable</span>\n}\n\n/** Native outcomes only: this presentation never infers resolution from a product read. */\nexport function SetupWarningResult({ warning, live = false }: { warning: SetupWarning; live?: boolean }) {\n    return <div className='flex flex-col text-[13px]' style={{ gap: 5, color: 'var(--v2-soft)' }} role={live ? 'status' : undefined} aria-live={live ? 'polite' : undefined} data-slot='setup-warning-result'>\n        <p>Originally recorded <RecordedTime seconds={warning.recordedSecs} />.</p>\n        {warning.recheck ? <>\n            <p>Latest check: {CHECK_STATE[warning.recheck.state]} · <RecordedTime seconds={warning.recheck.checkedSecs} />.</p>\n            <p>{warning.recheck.reason}</p>\n            {warning.recheck.state !== 'pending' && (warning.recheck.basis === 'unknown' || !warning.recheck.equivalent) ? <p>The original scope could not be matched. This result does not resolve the original warning.</p> : null}\n        </> : <p>No later setup recheck is recorded.</p>}\n        {warning.resolvedSecs !== undefined\n            ? <p data-state='resolved'>Resolved <RecordedTime seconds={warning.resolvedSecs} />.</p>\n            : <p data-state='active'>Warning active.</p>}\n    </div>\n}\n\n/** Tenant configuration history is separate from the redacted diagnostic event log/export. */\nexport function SetupWarningHistory({ warnings }: { warnings: SetupWarning[] }) {\n    if (warnings.length === 0) return null\n    return <section aria-label='Setup check history' className='flex flex-col' style={{ gap: 10, borderTop: '1px solid var(--v2-rule)', paddingTop: 12 }}>\n        <h3 className='text-[14px] font-semibold' style={{ color: 'var(--v2-ink)' }}>Setup check history</h3>\n        <p className='text-[13px]' style={{ color: 'var(--v2-soft)' }}>These tenant setup records are separate from the redacted diagnostic events above. Exporting or clearing diagnostic events does not export or clear this history.</p>\n        <ol className='flex flex-col' style={{ gap: 14 }}>\n            {[...warnings].sort((a, b) => b.recordedSecs - a.recordedSecs).map((warning) => <li key={warning.id} data-warning={warning.id} className='flex flex-col' style={{ gap: 5 }}>\n                <h4 className='text-[13px] font-semibold' style={{ color: 'var(--v2-ink)' }}>{READ_COPY.products[warning.product]}</h4>\n                <p className='text-[13px] whitespace-pre-wrap' style={{ color: 'var(--v2-soft)' }}>{warning.reason}</p>\n                <SetupWarningResult warning={warning} />\n            </li>)}\n        </ol>\n    </section>\n}\nimport { useId, useState, type ReactNode } from 'react'\nimport { Button } from '@ai-security-academy/presentation'\nimport type { DiagnosticsClear, DiagnosticsExport, DiagnosticsView } from '@prisma-airs/desktop-contracts'\nimport { type Dispatch, outcomeMessage } from '../tenants/dispatch'\n\nconst EXPORT_TEXT: Record<DiagnosticsExport, string> = {\n    saving: 'Choose where to save the diagnostics in the open dialog.',\n    saved: 'Diagnostics saved.',\n    cancelled: 'Nothing was saved.',\n    failed: 'The diagnostics could not be saved.',\n}\n\nconst CLEAR_TEXT: Record<DiagnosticsClear, string> = {\n    cleared: 'Diagnostics cleared.',\n    failed: 'The diagnostics could not all be removed, so the events counted above are still kept. Try again.',\n}\n\ninterface Props {\n    view: DiagnosticsView\n    dispatch: Dispatch\n    children?: ReactNode\n}\n\n/**\n * Local, redacted diagnostics (C24, D051). The desktop keeps only the kind\n * of each request and why one was refused, storage and reset outcomes, and\n * where the app stopped unexpectedly; never prompts, responses, keys or\n * names. Nothing is sent anywhere: export is explicit and saved where the\n * operator chooses.\n */\nexport function DiagnosticsPanel({ view, dispatch, children }: Props) {\n    const legend = useId()\n    const [message, setMessage] = useState<string | null>(null)\n    const busy = view.export === 'saving'\n\n    async function run(intent: Parameters<Dispatch>[0]) {\n        setMessage(null)\n        const outcome = await dispatch(intent)\n        setMessage(outcomeMessage(outcome))\n    }\n\n    return (\n        <fieldset aria-labelledby={legend} data-slot='diagnostics' className='settings-card'>\n            <legend id={legend} className='text-academy-ink px-1 text-[15px] font-semibold'>\n                Diagnostics\n            </legend>\n            {!view.available ? (\n                <p className='text-academy-ink-soft text-[13px]'>This build keeps no diagnostics.</p>\n            ) : (\n                <>\n                    <p className='text-academy-ink-soft max-w-prose text-[13px]'>\n                        Kept only on this device for {view.retentionDays} days and never sent anywhere: the kind of each\n                        request and why one was refused, storage and reset outcomes, and where the app stopped\n                        unexpectedly. Prompts, responses, keys, tokens and names are never kept.\n                    </p>\n                    <p className='text-academy-ink text-[13px]' data-slot='diagnostics-count'>\n                        {view.events} event{view.events === 1 ? '' : 's'} kept.\n                    </p>\n                    <div className='flex flex-wrap gap-2'>\n                        {/* aria-disabled, not disabled, while the save dialog is open: a\n                            disabled button drops keyboard focus, which would not come back to\n                            Export when the dialog closes. */}\n                        <Button type='button' tier='secondary' aria-disabled={busy} onClick={() => !busy && void run({ kind: 'exportDiagnostics' })}>\n                            Export diagnostics…\n                        </Button>\n                        <Button type='button' tier='tertiary' aria-disabled={busy} onClick={() => !busy && void run({ kind: 'clearDiagnostics' })}>\n                            Clear diagnostics\n                        </Button>\n                    </div>\n                    {view.export ? (\n                        <p role='status' aria-live='polite' className='text-academy-ink-soft text-[13px]'>\n                            {EXPORT_TEXT[view.export]}\n                        </p>\n                    ) : null}\n                    {view.clear === 'failed' ? (\n                        <p role='alert' data-slot='diagnostics-clear' className='text-academy-accent-warn text-[13px]'>\n                            {CLEAR_TEXT.failed}\n                        </p>\n                    ) : view.clear === 'cleared' ? (\n                        <p role='status' aria-live='polite' data-slot='diagnostics-clear' className='text-academy-ink-soft text-[13px]'>\n                            {CLEAR_TEXT.cleared}\n                        </p>\n                    ) : null}\n                </>\n            )}\n            {message ? (\n                <p role='alert' className='text-academy-accent-warn text-[13px]'>\n                    {message}\n                </p>\n            ) : null}\n            {children}\n        </fieldset>\n    )\n}\ndiff --git a/packages/desktop-contracts/src/client.ts b/packages/desktop-contracts/src/client.ts\nindex 2404a21e..1b317b4a 100644\n--- a/packages/desktop-contracts/src/client.ts\n+++ b/packages/desktop-contracts/src/client.ts\n@@ -91,6 +91,7 @@ const FEATURE_IDS: readonly string[] = [\n     'settings',\n ]\n const THEMES: readonly string[] = ['system', 'light', 'dark']\n+const COLOR_THEMES: readonly string[] = ['prismaAirs', 'gruvbox']\n const PRODUCT_IDS: readonly