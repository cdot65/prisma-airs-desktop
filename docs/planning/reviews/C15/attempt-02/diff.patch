+#!/usr/bin/env python3
+"""C15 native acceptance: API Client execution through the real fixture
+window. A synthetic collection is opened through the folder sheet (staged);
+requests go to a plain-HTTP loopback endpoint (workbench_server.py) and,
+with the tenant's native credentials, to the synthetic management endpoint
+(mgmt_server.py). Covers Send of the fresh typed input from the keyboard,
+cookies, a 64 MiB response streamed and saved through the save sheet
+(staged), cancel, a lost response, tenant-credential admission, a reviewed
+change through the native AppKit confirmation sheet, history across a
+relaunch with nothing replayed, and no Node/Bun in the process tree.
+
+Run from the repository root after `xtask native-prepare --chunk C15`.
+Requires the Accessibility grant. Synthetic data only; the fixture data
+root is removed at the end; v1 data and the login keychain are untouched.
+"""
+
+import hashlib
+import json
+import os
+import shutil
+import subprocess
+import sys
+import tempfile
+import time
+
+sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
+import fixture_app as fx  # noqa: E402
+import acceptance_c08 as c8  # noqa: E402
+import acceptance_c09 as c9  # noqa: E402
+
+ROOT = os.getcwd()
+SUBJECT = os.environ.get("AIRS_NATIVE_SUBJECT", "C15")
+EVIDENCE = os.path.join(ROOT, "docs/planning/evidence", SUBJECT)
+NATIVE = os.path.join(EVIDENCE, "native" if SUBJECT == "C15" else "native-C15")
+RECORD = os.path.join(EVIDENCE, "native-acceptance.json" if SUBJECT == "C15" else "native-acceptance-C15.json")
+BIG = 64 * 1024 * 1024
+LOG = []
+
+OAUTH = ('[auth]\nkind = "oauth2"\ntoken_url = "{{token_url}}"\nclient_id = "{{client_id}}"\n'
+         'client_secret = "{{client_secret}}"\nscope = "tsg_id:{{tsg_id}}"\n')
+
+
+def rel(path):
+    return os.path.relpath(path, ROOT)
+
+
+def sha(path):
+    h = hashlib.sha256()
+    with open(path, "rb") as f:
+        for piece in iter(lambda: f.read(1 << 20), b""):
+            h.update(piece)
+    return h.hexdigest()
+
+
+def pattern(n):
+    return bytes(i % 251 for i in range(n))
+
+
+def pattern_sha(n):
+    h = hashlib.sha256()
+    chunk = pattern(251 * 4096)
+    left = n
+    while left:
+        piece = chunk[: min(len(chunk), left)]
+        h.update(piece)
+        left -= len(piece)
+    return h.hexdigest()
+
+
+def save_tree(name, tree):
+    path = os.path.join(NATIVE, f"tree-{name}.json")
+    with open(path, "w") as f:
+        json.dump(tree, f, indent=0)
+    return rel(path)
+
+
+def press(app, label, roles=("AXButton", "AXRadioButton", "AXTab")):
+    tree = app.tree()
+    for role in roles:
+        matches = [n for n in tree if n.get("role") == role and (n.get("label") or "").startswith(label)]
+        for nth, n in enumerate(matches):
+            if n.get("label") == label:
+                app.ax("press", role, label, nth)
+                time.sleep(0.4)
+                return role
+    raise RuntimeError(f"no element labelled {label!r}")
+
+
+def value(app, role, label):
+    node = app.field(role, label)
+    return None if node is None else str(node.get("value") or "")
+
+
+def replace(app, role, label, text):
+    for _ in range(3):
+        app.ax("focus", role, label)
+        time.sleep(0.3)
+        app.keys("a", "command down")
+        app.keycode(51)
+        app.keys(text)
+        if value(app, role, label) == text:
+            return True
+    return False
+
+
+class Workbench:
+    """The plain-HTTP loopback endpoint (workbench_server.py)."""
+
+    def __init__(self, directory):
+        self.dir = directory
+        self.proc = subprocess.Popen(["python3", "-I", os.path.join(fx.TOOLS, "workbench_server.py"), "--dir", directory],
+                                     stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, text=True)
+        line = self.proc.stdout.readline().split()
+        if not line or line[0] != "ready":
+            raise SystemExit("the synthetic workbench endpoint did not start")
+        self.port = int(line[1])
+
+    @property
+    def origin(self):
+        return f"http://127.0.0.1:{self.port}"
+
+    def requests(self, path=None, ends=False):
+        """Requests received (or, with `ends`, streams finished)."""
+        p = os.path.join(self.dir, "requests.jsonl")
+        if not os.path.exists(p):
+            return []
+        with open(p) as f:
+            rows = [json.loads(line) for line in f if line.strip()]
+        return [r for r in rows if (r["method"] == "END") == ends and (path is None or r["path"].split("?")[0] == path)]
+
+    def stop(self):
+        self.proc.terminate()
+        self.proc.wait(timeout=5)
+
+
+def request(id_, method, url, extra=""):
+    return f'format_version = 1\nid = "{id_}"\nmethod = "{method}"\nurl = "{url}"\n{extra}'
+
+
+def stage(work, server, mgmt):
+    repo = os.path.realpath(os.path.join(work, "repo"))
+    root = os.path.join(repo, "api")
+    os.makedirs(os.path.join(repo, ".git"))
+    os.makedirs(root)
+    with open(os.path.join(root, "collection.toml"), "w") as f:
+        f.write(f'format_version = 1\nid = "c15"\nname = "Exec"\n\n[variables]\nbase = "{server.origin}"\n'
+                f'scm_base = "{mgmt.origin}"\ntoken_url = "{mgmt.origin}/oauth2/access_token"\n'
+                'tsg_id = { secret = "tenant.tsg_id" }\nclient_id = { secret = "tenant.client_id" }\n'
+                'client_secret = { secret = "tenant.client_secret" }\n')
+    files = {
+        "items": request("items", "GET", "{{base}}/items"),
+        "login": request("login", "GET", "{{base}}/login"),
+        "needs": request("needs", "GET", "{{base}}/needs-cookie"),
+        "big": request("big", "GET", f"{{{{base}}}}/big?bytes={BIG}"),
+        "hang": request("hang", "GET", "{{base}}/hang"),
+        "lost": request("lost", "POST", "{{base}}/lost"),
+        "policies": request("policies", "GET", "{{scm_base}}/iam/v1/access_policies", OAUTH),
+        "unknown": request("unknown", "GET", "{{scm_base}}/iam/v1/not-a-catalogue-operation", OAUTH),
+        # Its token URL edited away from the credential's token address.
+        "retoken": request("retoken", "GET", "{{scm_base}}/iam/v1/access_policies",
+                           OAUTH.replace("{{token_url}}", f"{mgmt.origin}/elsewhere")),
+        "create": request("create", "POST", "{{scm_base}}/iam/v1/access_policies", OAUTH),
+    }
+    for name, text in files.items():
+        with open(os.path.join(root, f"{name}.request.toml"), "w") as f:
+            f.write(text)
+    os.makedirs(fx.DATA, exist_ok=True)
+    with open(os.path.join(fx.DATA, "fixture-open-folder"), "w") as f:
+        f.write(root + "\n")
+    saved = os.path.join(work, "saved", "big-response.bin")
+    os.makedirs(os.path.dirname(saved))
+    with open(os.path.join(fx.DATA, "fixture-save-response"), "w") as f:
+        f.write(saved + "\n")
+    return {"repo": repo, "root": root, "saved": saved}
+
+
+def open_client(app):
+    app.ax("press", "AXButton", "API Client")
+    return app.wait_for(lambda t: fx.App.node(t, "AXHeading", "API Client") is not None)
+
+
+def open_request(app, name, method):
+    label = f"Open {method} {name}.request.toml"
+    shown = lambda t: any(n.get("role") == "AXHeading" and n.get("label") == name for n in t)  # noqa: E731
+    for _ in range(3):
+        app.wait_for(lambda t: fx.App.node(t, "AXButton", label) is not None, 10)
+        app.ax("press", "AXButton", label)
+        tree, ok = app.wait_for(shown, 6)
+        if ok:
+            return tree, ok
+    return tree, False
+
+
+def send(app):
+    press(app, "Send")
+
+
+def descendants(pid):
+    out = fx.sh(["ps", "-A", "-o", "pid=,ppid=,comm="]).stdout.splitlines()
+    rows = [line.split(None, 2) for line in out if len(line.split(None, 2)) == 3]
+    children = {}
+    for p, pp, comm in rows:
+        children.setdefault(pp, []).append((p, comm))
+    found, stack = [], [str(pid)]
+    while stack:
+        for p, comm in children.get(stack.pop(), []):
+            found.append(os.path.basename(comm))
+            stack.append(p)
+    return found
+
+
+def main():
+    try:
+        return run()
+    finally:
+        fx.sh(["pkill", "-f", fx.PROCESS])
+        fx.clean_fixture_root()
+
+
+def run():
+    prepared = json.load(open(os.path.join(EVIDENCE, "native-prepare.json")))
+    bundle = os.path.join(ROOT, prepared["bundle"])
+    exe = os.path.join(bundle, "Contents/MacOS/prisma-airs-desktop-v2")
+    if c8.sha256(exe) != prepared["executable_sha256"]:
+        raise SystemExit("prepared executable changed since native-prepare")
+    work = tempfile.mkdtemp(prefix="airs-v2-c15-acceptance-")
+    if os.path.isdir(NATIVE):
+        shutil.rmtree(NATIVE)
+    os.makedirs(NATIVE)
+    app = fx.App(bundle, work, LOG)
+    app.quit()
+    fx.clean_fixture_root()
+    v1_before = fx.v1_metadata()
+    endpoint = fx.ScanEndpoint(os.path.join(work, "endpoint"), c8.SCAN_KEY)
+    endpoint.install_roots()
+    endpoint.start()
+    mgmt = c8.MgmtEndpoint(os.path.join(work, "endpoint"), os.path.join(work, "mgmt"))
+    mgmt.install()
+    mgmt.start()
+    mgmt.mode()
+    server = Workbench(os.path.join(work, "workbench"))
+    s = stage(work, server, mgmt)
+    obs = {}
+
+    app.launch()
+    app.open_settings()
+    app.type_into("AXTextField", "TSG ID (optional)", c8.TSG)
+    app.create_custom_tenant("Tenant A", endpoint.origin)
+    app.save_key(c8.SCAN_KEY)
+    c8.save_client(app)
+    open_client(app)
+    press(app, "Open collection…")
+    tree, opened = c8.text(app, "Exec", 10)
+    obs["network_note"] = app.has_text(tree, "loopback addresses only")
+
+    # ---- N01: the fresh typed input, sent from the keyboard ----
+    open_request(app, "items", "GET")
+    items_file = os.path.join(s["root"], "items.request.toml")
+    before = sha(items_file)
+    app.ax("focus", "AXTextField", "URL")
+    time.sleep(0.3)
+    app.keycode(119)  # End
+    app.keys("?q=1")
+    app.ax("focus", "AXButton", "Send")
+    time.sleep(0.3)
+    focused = app.focused(app.tree())
+    app.keycode(49)  # Space activates the focused button
+    tree, ran = c8.text(app, "HTTP 200 ·", 12)
+    got = server.requests("/items")
+    obs["fresh"] = {
+        "send_focusable": bool(focused) and (focused.get("label") or "") == "Send",
+        "ran": ran,
+        "body_shown": app.has_text(tree, '{"items":[1,2,3]}'),
+        "sent_as_typed": [r["path"] for r in got] == ["/items?q=1"],
+        "file_unchanged": sha(items_file) == before,
+        "response_region": any(n.get("label") == "Response" for n in tree),
+    }
+    obs["tree_fresh"] = save_tree("fresh", tree)
+
+    # ---- N02: cookies follow the collection's jar ----
+    open_request(app, "login", "GET")
+    send(app)
+    c8.text(app, "HTTP 200 ·", 10)
+    open_request(app, "needs", "GET")
+    send(app)
+    tree, cookie = c8.text(app, '"cookie":true', 10)
+    sent = {k.lower(): v for k, v in (server.requests("/needs-cookie") or [{}])[-1].get("headers", {}).items()}
+    obs["cookies"] = {"returned": cookie, "header": sent.get("cookie")}
+
+    # ---- N03: a 64 MiB response streamed, then saved exactly ----
+    open_request(app, "big", "GET")
+    started = time.time()
+    send(app)
+    tree, big = c8.text(app, "HTTP 200 · 67.1 MB", 90)
+    obs["big"] = {"ran": big, "seconds": round(time.time() - started, 2),
+                  "not_text": app.has_text(tree, "The body is not text; save it to open it elsewhere.")}
+    press(app, "Save response…")
+    tree, saved = c8.text(app, "Saved 67.1 MB as big-response.bin.", 60)
+    obs["big"]["saved"] = saved
+    obs["big"]["exact"] = os.path.exists(s["saved"]) and os.path.getsize(s["saved"]) == BIG and sha(s["saved"]) == pattern_sha(BIG)
+    sample = pattern(4096)
+    plain = []
+    for d, _, names in os.walk(os.path.join(fx.DATA, "api-client")):
+        for name in names:
+            p = os.path.join(d, name)
+            with open(p, "rb") as f:
+                if sample in f.read():
+                    plain.append(os.path.relpath(p, fx.DATA))
+    obs["big"]["sealed"] = not plain
+    obs["tree_big"] = save_tree("big", tree)
+
+    # ---- N04: cancel a running request ----
+    open_request(app, "hang", "GET")
+    send(app)
+    tree, running = app.wait_for(lambda t: fx.App.node(t, "AXButton", "Cancel request") is not None, 10)
+    obs["cancel"] = {"running": running, "progress": app.has_text(tree, "Sending GET…")}
+    press(app, "Cancel request")
+    tree, cancelled = c8.text(app, "Cancelled ·", 10)
+    obs["cancel"].update({"cancelled": cancelled, "sent_once": len(server.requests("/hang")) == 1})
+
+    # ---- N05: a lost response is never resent ----
+    open_request(app, "lost", "POST")
+    send(app)
+    tree, uncertain = c8.text(app, "may have reached the server", 15)
+    time.sleep(2)
+    obs["lost"] = {"uncertain": uncertain, "sent_once": len(server.requests("/lost")) == 1,
+                   "no_resend_control": not any((n.get("label") or "").lower() in ("retry", "resend") for n in tree)}
+
+    # ---- N06: tenant credentials admitted before any is read ----
+    base = len(mgmt.requests())
+    open_request(app, "unknown", "GET")
+    send(app)
+    tree, denied = c8.text(app, "known Strata Cloud Manager and AIRS operations", 10)
+    open_request(app, "retoken", "GET")
+    send(app)
+    tree, token_refused = c8.text(app, "not the tenant credential's token address", 10)
+    nothing = len(mgmt.requests()) == base
+    open_request(app, "policies", "GET")
+    send(app)
+    tree, read = c8.text(app, "HTTP ", 15)
+    calls = mgmt.requests()[base:]
+    token = [c for c in calls if c["path"] == "/oauth2/access_token"]
+    reads = [c for c in calls if c["path"] == "/iam/v1/access_policies"]
+    obs["managed"] = {
+        "unknown_denied": denied,
+        "token_url_refused": token_refused,
+        "nothing_sent_before": nothing,
+        "read": read,
+        "token": len(token) == 1 and token[0]["auth"] == "basic-ok" and token[0]["scope"] == f"tsg_id:{c8.TSG}" and not token[0]["secretInBody"],
+        "bearer": len(reads) == 1 and reads[0]["auth"] == "bearer-issued",
+    }
+    obs["tree_managed"] = save_tree("managed", tree)
+
+    # ---- N07: a reviewed change through the native sheet ----
+    open_request(app, "create", "POST")
+    replace(app, "AXTextArea", "Body", '{"name": "synthetic-c15"}')
+    send(app)
+    tree, reviewed = c8.text(app, "Review this change to the tenant", 10)
+    posts = lambda: [c for c in mgmt.requests() if c["method"] == "POST" and c["path"] == "/iam/v1/access_policies"]  # noqa: E731
+    obs["review"] = {"shown": reviewed, "none_before": not posts(), "masked_url": app.has_text(tree, f"POST {mgmt.origin}/iam/v1/access_policies")}
+    obs["tree_review"] = save_tree("review", tree)
+    press(app, "Send to tenant…")
+    tree, sheet = c9.wait_sheet(app)
+    nodes = c9.sheet(app, tree) or []
+    obs["review"]["sheet"] = sheet
+    obs["review"]["sheet_title"] = any("Send POST to the tenant?" in (n.get("label") or "") + str(n.get("value") or "") for n in nodes)
+    obs["tree_sheet"] = save_tree("sheet", tree)
+    app.keycode(53)  # Escape
+    c9.wait_no_sheet(app)
+    tree, declined = c8.text(app, "Not sent.", 10)
+    obs["review"]["escape_declined"] = declined and not posts()
+    press(app, "Send to tenant…")
+    c9.wait_sheet(app)
+    app.keycode(36)  # Return: Send
+    tree, applied = c8.text(app, "HTTP ", 15)
+    time.sleep(1)
+    obs["review"]["applied_once"] = applied and len(posts()) == 1
+    obs["review"]["review_gone"] = fx.App.node(app.tree(), "AXButton", "Send to tenant…") is None
+
+    # ---- N09: no Node or Bun beside the app ----
+    obs["process_tree"] = sorted(set(descendants(app.running_pid() or 0)))
+
+    # ---- N08: history across a relaunch; nothing replayed ----
+    open_request(app, "hang", "GET")
+    send(app)
+    app.wait_for(lambda t: fx.App.node(t, "AXButton", "Cancel request") is not None, 10)
+    hangs = len(server.requests("/hang"))
+    app.quit()
+    app.launch()
+    open_client(app)
+    press(app, "Exec (api)")
+    app.wait_for(lambda t: fx.App.node(t, "AXRadioButton", "History") is not None or fx.App.node(t, "AXTab", "History") is not None, 10)
+    press(app, "History")
+    tree, interrupted = c8.text(app, "Interrupted (not sent again)", 12)
+    time.sleep(2)
+    obs["history"] = {
+        "interrupted": interrupted,
+        "earlier": app.has_text(tree, "GET items · HTTP 200"),
+        "nothing_replayed": len(server.requests("/hang")) == hangs and len(posts()) == 1,
+    }
+    obs["tree_history"] = save_tree("history", tree)
+
+    app.quit()
+    server.stop()
+    endpoint.stop()
+    mgmt.stop()
+    obs["v1_unchanged"] = fx.v1_metadata() == v1_before
+    shutil.rmtree(work, ignore_errors=True)
+    with open(os.path.join(NATIVE, "observations.json"), "w") as f:
+        json.dump({"observations": obs, "log": LOG}, f, indent=1)
+    return evaluate(prepared, obs)
+
+
+def evaluate(prepared, o):
+    inventory = {c["id"]: c["check"] for c in json.load(open(os.path.join(ROOT, "docs/architecture/native-checks.json")))["chunks"]["C15"]}
+    obs_path = rel(os.path.join(NATIVE, "observations.json"))
+    checks = []
+
+    def add(cid, passed, observation, evidence):
+        checks.append({"id": cid, "description": inventory[cid], "result": "pass" if passed else "fail",
+                       "observation": observation, "evidence": [obs_path] + [e for e in evidence if e]})
+
+    add("C15-N01", all(o["fresh"].values()) and o["network_note"], f"fresh input {o['fresh']}; loopback note {o['network_note']}", [o["tree_fresh"]])
+    ck = o["cookies"]
+    add("C15-N02", ck["returned"] and ck["header"] == "sid=synthetic-c15", f"cookies {ck}", [])
+    bg = o["big"]
+    add("C15-N03", bg["ran"] and bg["not_text"] and bg["saved"] and bg["exact"] and bg["sealed"], f"64 MiB {bg}", [o["tree_big"]])
+    add("C15-N04", all(o["cancel"].values()), f"cancel {o['cancel']}", [])
+    add("C15-N05", all(o["lost"].values()), f"lost response {o['lost']}", [])
+    add("C15-N06", all(o["managed"].values()), f"tenant credentials {o['managed']}", [o["tree_managed"]])
+    add("C15-N07", all(o["review"].values()), f"review {o['review']}", [o["tree_review"], o["tree_sheet"]])
+    add("C15-N08", all(o["history"].values()), f"history {o['history']}", [o["tree_history"]])
+    pt = o["process_tree"]
+    add("C15-N09", not any(n in ("node", "bun", "deno") for n in pt) and o["v1_unchanged"],
+        f"descendants {pt}; v1 unchanged {o['v1_unchanged']}", [])
+
+    hw = fx.sh(["sysctl", "-n", "hw.model"]).stdout.strip()
+    os_ver = fx.sh(["sw_vers", "-productVersion"]).stdout.strip() + " (" + fx.sh(["sw_vers", "-buildVersion"]).stdout.strip() + ")"
+    record = {
+        "schema": "airs-v2/native-acceptance/1",
+        "subject": "C15",
+        "recorded_utc": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()),
+        "method": "cua",
+        "performed_by": "Claude Code driving the real fixture window through macOS Accessibility (tools/native-acceptance/ax.swift, System Events keystrokes); tools/native-acceptance/acceptance_c15.py",
+        "host": f"{hw}; macOS {os_ver}",
+        "app": {"bundle": prepared["bundle"], "identifier": prepared["identifier"], "executable_sha256": prepared["executable_sha256"], "fixture": True},
+        "checks": checks,
+        "limitations": [
+            "Fixture builds send API Client requests to loopback only (literal loopback addresses and localhost pinned to 127.0.0.1); no product endpoint is called.",
+            "The fixture build answers the collection folder sheet and the save-response sheet with staged paths; the production rfd sheets are the same adapter's native branch (flag fixture-native-sheets) and are not driven here.",
+            "Spoken VoiceOver output was not recorded; AX roles, names and focus are inspected.",
+        ],
+    }
+    with open(RECORD, "w") as f:
+        json.dump(record, f, indent=2)
+        f.write("\n")
+    for c in checks:
+        print(c["result"].upper(), c["id"], c["observation"][:220])
+    return 0 if all(c["result"] == "pass" for c in checks) else 1
+
+
+if __name__ == "__main__":
+    sys.exit(main())
diff --git a/tools/native-acceptance/workbench_server.py b/tools/native-acceptance/workbench_server.py
new file mode 100644
index 0000000..584cca2
--- /dev/null
+++ b/tools/native-acceptance/workbench_server.py
@@ -0,0 +1,151 @@
+#!/usr/bin/env python3
+"""Synthetic plain-HTTP endpoint for the API Client (C15 native acceptance
+and workload measurement). Binds 127.0.0.1 only and records every request
+(method, path, selected headers, body size and SHA-256) in
+<dir>/requests.jsonl. Routes:
+
+  GET  /items            a small JSON body
+  GET  /login            sets a persistent cookie
+  GET  /needs-cookie     200 only when that cookie comes back
+  GET  /big?bytes=N      N bytes of a repeating pattern, streamed (with
+                         &pace=U, U microseconds between 64 KiB writes; the
+                         end of the stream is recorded as a second row)
+  POST /upload           drained (any size); its size and digest recorded
+  ANY  /hang             never answers (until the client goes away)
+  POST /lost             closes without any reply (a lost response)
+"""
+import argparse
+import hashlib
+import json
+import os
+import socket
+import threading
+import time
+from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
+from urllib.parse import parse_qs, urlparse
+
+LOCK = threading.Lock()
+KEPT = ("content-type", "cookie", "authorization", "x-trace", "content-length")
+
+
+def pattern(n):
+    return bytes(i % 251 for i in range(n))
+
+
+CHUNK = pattern(251 * 260)  # a whole number of pattern periods
+
+
+class Handler(BaseHTTPRequestHandler):
+    protocol_version = "HTTP/1.1"
+
+    def log_message(self, *_):
+        pass
+
+    def record(self, size, digest):
+        entry = {
+            "method": self.command,
+            "path": self.path,
+            "headers": {k: v for k, v in self.headers.items() if k.lower() in KEPT},
+            "bytes": size,
+            "sha256": digest,
+            "at": time.time(),
+        }
+        with LOCK, open(os.path.join(self.server.dir, "requests.jsonl"), "a") as f:
+            f.write(json.dumps(entry) + "\n")
+
+    def drain(self):
+        length = int(self.headers.get("content-length") or 0)
+        h = hashlib.sha256()
+        left = length
+        while left > 0:
+            piece = self.rfile.read(min(left, 1 << 20))
+            if not piece:
+                break
+            h.update(piece)
+            left -= len(piece)
+        return length - left, h.hexdigest()
+
+    def answer(self, status, body, headers=()):
+        self.send_response(status)
+        for k, v in headers:
+            self.send_header(k, v)
+        self.send_header("content-length", str(len(body)))
+        self.send_header("connection", "close")
+        self.end_headers()
+        self.wfile.write(body)
+
+    def handle_any(self):
+        size, digest = self.drain()
+        self.record(size, digest)
+        url = urlparse(self.path)
+        if url.path == "/hang":
+            try:
+                self.connection.settimeout(600)
+                while self.connection.recv(64):
+                    pass
+            except OSError:
+                pass
+            return
+        if url.path == "/lost":
+            self.connection.shutdown(socket.SHUT_RDWR)
+            return
+        if url.path == "/items":
+            return self.answer(200, b'{"items":[1,2,3]}', [("content-type", "application/json")])
+        if url.path == "/login":
+            return self.answer(200, b"{}", [("content-type", "application/json"),
+                                            ("set-cookie", "sid=synthetic-c15; Path=/; Max-Age=3600")])
+        if url.path == "/needs-cookie":
+            ok = "sid=synthetic-c15" in (self.headers.get("cookie") or "")
+            return self.answer(200 if ok else 401, b'{"cookie":%s}' % (b"true" if ok else b"false"),
+                               [("content-type", "application/json")])
+        if url.path == "/big":
+            query = parse_qs(url.query)
+            n = int(query.get("bytes", ["0"])[0])
+            pace = int(query.get("pace", ["0"])[0]) / 1_000_000
+            self.send_response(200)
+            self.send_header("content-type", "application/octet-stream")
+            self.send_header("content-length", str(n))
+            self.send_header("connection", "close")
+            self.end_headers()
+            sent = 0
+            try:
+                while sent < n:
+                    piece = CHUNK[: min(len(CHUNK), n - sent)]
+                    self.wfile.write(piece)
+                    sent += len(piece)
+                    if pace:
+                        time.sleep(pace)
+            except OSError:
+                pass
+            with LOCK, open(os.path.join(self.server.dir, "requests.jsonl"), "a") as f:
+                f.write(json.dumps({"method": "END", "path": url.path, "bytes": sent, "at": time.time()}) + "\n")
+            return
+        if url.path == "/upload":
+            return self.answer(200, json.dumps({"bytes": size, "sha256": digest}).encode(),
+                               [("content-type", "application/json")])
+        return self.answer(404, b"{}", [("content-type", "application/json")])
+
+    do_GET = do_POST = do_PUT = do_DELETE = do_PATCH = handle_any
+
+
+class Server(ThreadingHTTPServer):
+    daemon_threads = True
+
+    def __init__(self, port, directory):
+        self.dir = directory
+        super().__init__(("127.0.0.1", port), Handler)
+
+
+def main():
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--dir", required=True)
+    parser.add_argument("--port", type=int, default=0)
+    args = parser.parse_args()
+    os.makedirs(args.dir, exist_ok=True)
+    server = Server(args.port, args.dir)
+    print(f"ready {server.server_address[1]}", flush=True)
+    server.serve_forever()
+
+
+if __name__ == "__main__":
+    main()
diff --git a/tools/perf/measure_c15.py b/tools/perf/measure_c15.py
new file mode 100644
index 0000000..31fd07e
--- /dev/null
+++ b/tools/perf/measure_c15.py
@@ -0,0 +1,292 @@
+#!/usr/bin/env python3
+"""C15 measurement of the large HTTP bodies and downloads workload against
+the budgets registered before C15 implemented it
+(docs/planning/evidence/C15/workload-budget.md, registration in
+docs/planning/evidence/C15/workload-budget-registration.json).
+
+  measure_c15.py --label calibration|acceptance
+
+Run from the repository root on the prepared C15 fixture bundle. Only an
+acceptance run writes docs/planning/evidence/<subject>/workload-perf.json,
+and it refuses to start unless the budget table matches its registration.
+Raw samples are recorded; `xtask native` recomputes every statistic.
+
+Workloads, on one launch against the synthetic plain-HTTP loopback endpoint
+(tools/native-acceptance/workbench_server.py), which streams or drains at
+full speed:
+
+- api-client-response-256mib: from AXPress on Send (a saved GET answering
+  256 MiB of octet-stream) to the response summary "HTTP 200 · 268.4 MB"
+  existing in the Accessibility tree (tools/perf/probe.swift activate, 2 ms
+  polling). A new Send clears the previous response first.
+- api-client-upload-128mib: from AXPress on Send (a saved multipart POST of
+  two 64 MiB collection files, drained by the server) to "HTTP 200 ·".
+- api-client-save-response-256mib: from AXPress on Save response… to
+  "Saved 268.4 MB as save-N.bin." (the staged fixture destination, a new
+  name per sample), the file then checked at its full size.
+- api-client-responsive-during-transfer: while a 256 MiB response streams
+  (paced by the server to about four seconds), from AXPress on another open
+  request's tab to that tab's URL field exposing its URL (probe.swift
+  activate-field, the registered editor-ready target); each sample is
+  checked to have ended before the stream did.
+- api-client-process-tree-resident: the app plus its WebKit processes' RSS
+  sampled once per second for 20 s spanning three 256 MiB responses, one
+  128 MiB multipart upload and one 256 MiB save.
+"""
+
+import argparse
+import hashlib
+import json
+import os
+import sys
+import tempfile
+import threading
+import time
+
+HERE = os.path.dirname(os.path.abspath(__file__))
+sys.path.insert(0, os.path.join(HERE, "..", "native-acceptance"))
+import fixture_app as fx  # noqa: E402
+import acceptance_c15 as c15  # noqa: E402
+
+ROOT = os.getcwd()
+SUBJECT = os.environ.get("AIRS_NATIVE_SUBJECT", "C15")
+EVIDENCE = os.path.join(ROOT, "docs/planning/evidence", SUBJECT)
+REGISTRATION = os.path.join(ROOT, "docs/planning/evidence/C15/workload-budget-registration.json")
+BIG = 256 * 1024 * 1024
+PART = 64 * 1024 * 1024
+BIG_DONE = "HTTP 200 · 268.4 MB"
+
+
+def sha256_file(path):
+    with open(path, "rb") as f:
+        return hashlib.sha256(f.read()).hexdigest()
+
+
+def utc():
+    return time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())
+
+
+def webkit_pids():
+    return set(int(p) for p in fx.sh(["pgrep", "-f", "com.apple.WebKit"]).stdout.split())
+
+
+def rss_mib(pids):
+    out = fx.sh(["ps", "-o", "rss=", "-p", ",".join(str(p) for p in pids)]).stdout.split()
+    return sum(int(v) for v in out) / 1024
+
+
+def probe_activate(probe, app, role, label, heading, text, timeout=60000):
+    out = fx.sh([probe, "activate", str(app.pid), role, label, heading, text, str(timeout)])
+    return json.loads(out.stdout or "{}")
+
+
+def probe_field(probe, app, role, label, field, value, timeout=60000):
+    out = fx.sh([probe, "activate-field", str(app.pid), role, label, field, value, str(timeout)])
+    return json.loads(out.stdout or "{}")
+
+
+def stage(work, server):
+    root = os.path.join(os.path.realpath(work), "repo", "api")
+    os.makedirs(os.path.join(root, "data"))
+    os.makedirs(os.path.join(root, "..", ".git"))
+    with open(os.path.join(root, "collection.toml"), "w") as f:
+        f.write(f'format_version = 1\nid = "c15perf"\nname = "Perf"\n\n[variables]\nbase = "{server.origin}"\n')
+    for name in ("a.bin", "b.bin"):
+        with open(os.path.join(root, "data", name), "wb") as f:
+            f.truncate(PART)
+    files = {
+        "big": c15.request("big", "GET", f"{{{{base}}}}/big?bytes={BIG}"),
+        "paced": c15.request("paced", "GET", f"{{{{base}}}}/big?bytes={BIG}&pace=1000"),
+        "items": c15.request("items", "GET", "{{base}}/items"),
+        "upload": c15.request("upload", "POST", "{{base}}/upload", 'body_kind = "multipart"\nbody = "upload.body.txt"\n'),
+    }
+    for name, text in files.items():
+        with open(os.path.join(root, f"{name}.request.toml"), "w") as f:
+            f.write(text)
+    with open(os.path.join(root, "upload.body.txt"), "w") as f:
+        f.write('[[parts]]\nname = "a"\nfile = "data/a.bin"\n[[parts]]\nname = "b"\nfile = "data/b.bin"\n')
+    os.makedirs(fx.DATA, exist_ok=True)
+    with open(os.path.join(fx.DATA, "fixture-open-folder"), "w") as f:
+        f.write(root + "\n")
+    return root
+
+
+def stage_save(work, n):
+    path = os.path.join(work, "saved", f"save-{n}.bin")
+    os.makedirs(os.path.dirname(path), exist_ok=True)
+    with open(os.path.join(fx.DATA, "fixture-save-response"), "w") as f:
+        f.write(path + "\n")
+    return path
+
+
+def main():
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--label", choices=["calibration", "acceptance"], required=True)
+    label = parser.parse_args().label
+    registration = json.load(open(REGISTRATION))
+    table = os.path.join(ROOT, registration["budgets"])
+    table_sha = sha256_file(table)
+    if table_sha != registration["budgets_sha256"]:
+        raise SystemExit("the workload budget table does not match its C15 registration")
+    prepared = json.load(open(os.path.join(EVIDENCE, "native-prepare.json")))
+    bundle = os.path.join(ROOT, prepared["bundle"])
+    exe = os.path.join(bundle, "Contents/MacOS/prisma-airs-desktop-v2")
+    if sha256_file(exe) != prepared["executable_sha256"]:
+        raise SystemExit("prepared executable changed since native-prepare")
+    work = tempfile.mkdtemp(prefix="airs-v2-c15-perf-")
+    probe = os.path.join(work, "probe")
+    built = fx.sh(["swiftc", "-O", os.path.join(HERE, "probe.swift"), "-o", probe])
+    if built.returncode != 0:
+        raise SystemExit(f"probe did not build: {built.stderr}")
+    started = utc()
+    app = fx.App(bundle, work, [])
+    app.quit()
+    fx.clean_fixture_root()
+    server = c15.Workbench(os.path.join(work, "workbench"))
+    stage(work, server)
+    metrics, details = {}, {}
+    try:
+        before = webkit_pids()
+        app.launch()
+        time.sleep(2)
+        pids = [app.pid, *sorted(webkit_pids() - before)]
+        details["process_tree"] = {"app": app.pid, "webkit": pids[1:]}
+        c15.open_client(app)
+        c15.press(app, "Open collection…")
+        app.wait_for(lambda t: fx.App.node(t, "AXButton", "Open GET big.request.toml") is not None, 10)
+
+        # ---- api-client-response-256mib ----
+        c15.open_request(app, "big", "GET")
+        timings, runs = [], []
+        for n in range(10):
+            mark = len(server.requests("/big", ends=True))
+            data = probe_activate(probe, app, "AXButton", "Send", "big", BIG_DONE)
+            ends = server.requests("/big", ends=True)[mark:]
+            timings.append(data.get("ms"))
+            runs.append({"sample": n + 1, "streamed": [e["bytes"] for e in ends], **data})
+            time.sleep(0.5)
+        if any(t is None for t in timings) or any(r["streamed"] != [BIG] for r in runs):
+            raise RuntimeError(f"a 256 MiB response did not complete: {runs}")
+        metrics["api-client-response-256mib"] = {"unit": "ms", "samples": timings}
+        details["response_256mib"] = runs
+
+        # ---- api-client-save-response-256mib ----
+        timings, runs = [], []
+        for n in range(10):
+            path = stage_save(work, n + 1)
+            data = probe_activate(probe, app, "AXButton", "Save response…", "big", f"Saved 268.4 MB as save-{n + 1}.bin.")
+            size = os.path.getsize(path) if os.path.exists(path) else None
+            timings.append(data.get("ms"))
+            runs.append({"sample": n + 1, "bytes": size, **data})
+            if os.path.exists(path):
+                os.remove(path)
+            time.sleep(0.4)
+        if any(t is None for t in timings) or any(r["bytes"] != BIG for r in runs):
+            raise RuntimeError(f"a response was not saved in full: {runs}")
+        metrics["api-client-save-response-256mib"] = {"unit": "ms", "samples": timings}
+        details["save_256mib"] = runs
+
+        # ---- api-client-upload-128mib ----
+        c15.open_request(app, "upload", "POST")
+        timings, runs = [], []
+        for n in range(10):
+            mark = len(server.requests("/upload"))
+            data = probe_activate(probe, app, "AXButton", "Send", "upload", "HTTP 200 ·")
+            got = server.requests("/upload")[mark:]
+            timings.append(data.get("ms"))
+            runs.append({"sample": n + 1, "received": [g["bytes"] for g in got], **data})
+            time.sleep(0.5)
+        if any(t is None for t in timings) or any(len(r["received"]) != 1 or r["received"][0] < 2 * PART for r in runs):
+            raise RuntimeError(f"an upload was not received in full: {runs}")
+        metrics["api-client-upload-128mib"] = {"unit": "ms", "samples": timings}
+        details["upload_128mib"] = runs
+
+        # ---- api-client-responsive-during-transfer ----
+        c15.open_request(app, "items", "GET")
+        c15.open_request(app, "paced", "GET")
+        timings, runs = [], []
+        for n in range(20):
+            mark = len(server.requests("/big", ends=True))
+            c15.press(app, "Send")
+            time.sleep(0.3)
+            clicked = time.time()
+            data = probe_field(probe, app, "AXRadioButton", "GET items", "URL", "{{base}}/items", 10000)
+            answered = clicked + (data.get("ms") or 0) / 1000
+            app.ax("press", "AXRadioButton", "GET paced")
+            app.wait_for(lambda t: any(x.get("role") == "AXHeading" and x.get("label") == "paced" for x in t), 10)
+            app.wait_for(lambda t: len(server.requests("/big", ends=True)) > mark, 30)
+            ends = server.requests("/big", ends=True)[mark:]
+            during = bool(ends) and answered < ends[0]["at"]
+            timings.append(data.get("ms"))
+            runs.append({"sample": n + 1, "during_transfer": during, **data})
+            app.wait_for(lambda t: not app.has_text(t, "Sending GET…"), 30)
+            time.sleep(0.3)
+        if any(t is None for t in timings) or not all(r["during_transfer"] for r in runs):
+            raise RuntimeError(f"a tab switch was not measured during a transfer: {runs}")
+        metrics["api-client-responsive-during-transfer"] = {"unit": "ms", "samples": timings}
+        details["responsive"] = runs
+
+        # ---- api-client-process-tree-resident ----
+        resident = []
+        stop = threading.Event()
+
+        def sample():
+            for _ in range(20):
+                resident.append(round(rss_mib(pids), 1))
+                if stop.wait(1):
+                    break
+
+        sampler = threading.Thread(target=sample)
+        sampler.start()
+        steps = []
+        c15.open_request(app, "big", "GET")
+        for _ in range(3):
+            c15.press(app, "Send")
+            _, ok = app.wait_for(lambda t: app.has_text(t, BIG_DONE), 60)
+            steps.append(("response", ok))
+        path = stage_save(work, 99)
+        c15.press(app, "Save response…")
+        _, ok = app.wait_for(lambda t: app.has_text(t, "Saved 268.4 MB as save-99.bin."), 60)
+        steps.append(("save", ok))
+        if os.path.exists(path):
+            os.remove(path)
+        c15.open_request(app, "upload", "POST")
+        c15.press(app, "Send")
+        _, ok = app.wait_for(lambda t: app.has_text(t, "HTTP 200 ·"), 60)
+        steps.append(("upload", ok))
+        sampler.join()
+        if len(resident) != 20 or not all(ok for _, ok in steps):
+            raise RuntimeError(f"the resident workload did not complete: {steps}, {len(resident)} samples")
+        metrics["api-client-process-tree-resident"] = {"unit": "MiB", "samples": resident}
+        details["resident_steps"] = steps
+        details["requests"] = len(server.requests())
+    finally:
+        app.quit()
+        server.stop()
+        fx.clean_fixture_root()
+    record = {
+        "schema": "airs-v2-workload-perf/1",
+        "label": label,
+        "registration_sha256": table_sha,
+        "started_utc": started,
+        "finished_utc": utc(),
+        "executable_sha256": prepared["executable_sha256"],
+        "host": fx.sh(["sysctl", "-n", "hw.model"]).stdout.strip(),
+        "metrics": metrics,
+        "details": details,
+    }
+    name = "workload-perf.json" if label == "acceptance" else f"workload-perf-calibration-{started.replace(':', '')}.json"
+    path = os.path.join(EVIDENCE, name)
+    with open(path, "w") as f:
+        json.dump(record, f, indent=1)
+        f.write("\n")
+    for key, metric in metrics.items():
+        ordered = sorted(metric["samples"])
+        p95 = ordered[max(1, -(-95 * len(ordered) // 100)) - 1]
+        print(f"{key}: n={len(ordered)} p95={p95} max={ordered[-1]} {metric['unit']}")
+    print(os.path.relpath(path, ROOT))
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
