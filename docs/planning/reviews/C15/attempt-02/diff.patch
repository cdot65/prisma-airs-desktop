+#[tokio::test(flavor = "multi_thread")]
+async fn a_tenant_change_retires_reviews_and_unsent_requests() {
+    let Tenant {
+        mut desk,
+        server,
+        origin,
+        ..
+    } = tenant_with(3000).await;
+    let root = managed_collection(
