+#[tokio::test(flavor = "multi_thread")]
+async fn sends_the_fresh_snapshot_with_v1_auth_bodies_and_cookies() {
+    let http = Http::start(Arc::new(|seen| {
+        if seen.request_line.starts_with("GET /login") {
