+    ) as (HTMLInputElement | HTMLTextAreaElement)[]
+    expect(fields.length).toBeGreaterThan(0)
+    expect(fields.filter((f) => f.value === RUNTIME.prompt || f.value === RUNTIME.name)).toEqual([])
