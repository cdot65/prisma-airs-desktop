const ran: RunView = {
    record: {
        id: 'run-0123456789abcdef',
        request: 'list',
        relative: 'topics/list.request.toml',
        at: 1_760_000_000,
        method: 'GET',
        url: 'http://127.0.0.1:8080/topics',
        class: 'anonymous',
        operation: null,
        state: 'completed',
        failure: null,
        uncertain: false,
        status: 200,
        headers: [['content-type', 'application/json']],
        redirect: null,
        elapsedMs: 42,
