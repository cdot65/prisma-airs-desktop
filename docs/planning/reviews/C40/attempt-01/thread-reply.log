                        </span>
                        <span className='leading-[1.5] break-words whitespace-pre-wrap'>{v}</span>
                    </div>
                ))}
            </section>
            <p className='text-[12px] leading-[1.5]' style={faint}>
                {C.neverRunHere}
            </p>
        </div>
    )
}

