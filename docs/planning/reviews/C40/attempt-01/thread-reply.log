   331	                <div className='flex flex-wrap items-center text-[12px]' style={{ gap: 10, padding: '10px 18px', borderTop: '1px solid var(--v2-rule)', ...faint }} data-slot='cases-pages'>
   332	                    <span role='status'>{matching.length === 0 ? '' : C.range(shownPage * PAGE_SIZE + 1, Math.min(matching.length, (shownPage + 1) * PAGE_SIZE), matching.length)}</span>
   333	                    <span className='ml-auto flex items-center' style={{ gap: 8 }}>
   334	                        <Btn tier='tertiary' className='h-7 text-[12px]' disabled={shownPage === 0} onClick={() => setPage(shownPage - 1)}>
   335	                            {C.previous}
   336	                        </Btn>
   337	                        <span>{C.page(shownPage + 1, pages)}</span>
   338	                        <Btn tier='tertiary' className='h-7 text-[12px]' disabled={shownPage >= pages - 1} onClick={() => setPage(shownPage + 1)}>
   339	                            {C.next}
