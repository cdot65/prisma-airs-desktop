   280	/** Answers the API Client's workbench requests, as request-send.test.tsx does. */
   281	function workbench(native: Native, answer: (request: WorkbenchRequest) => WorkbenchResult): WorkbenchRequest[] {
   282	    const requests: WorkbenchRequest[] = []
   283	    const pending = new Map<string, WorkbenchRequest>()
   284	    const respond = native.respond
   285	    native.respond = (intent: Intent) => {
   286	        if (intent.kind !== 'workbench') return respond(intent)
   287	        requests.push(intent.request)
   288	        const operation = `op-${requests.length}`
   289	        pending.set(operation, intent.request)
   290	        return { outcome: 'receipt', receipt: { kind: 'admitted', request: `rq-${requests.length}`, operation } }
   291	    }
   292	    native.observeWorkbench = async (operation) => {
   293	        const request = pending.get(operation)
   294	        if (!request) return { kind: 'refusal', refusal: 'invalidInput' }
   295	        return { kind: 'workbench', result: answer(request) }
   296	    }
   297	    return requests
   298	}
