/* The shared frame scrolls the document under a sticky 56px topbar and a
 * fixed 60px decorative bottom fade. Focused controls scrolled into view stay
 * clear of both, including at 200% zoom (C01-N10). */
html {
    scroll-padding-top: 72px;
    scroll-padding-bottom: 76px;
}

/* Tailwind's reset strips form controls to bare text, so a field written
 * without classes had no visible edge (C26 installed acceptance F04). Every
 * text field, select and text area gets a visible box at zero specificity:
 * any utility class on a control still wins. The border meets the 3:1
 * non-text contrast floor in both themes. */
@layer base {
    :where(input:not([type='radio'], [type='checkbox'], [type='range'], [type='file'], [type='hidden']), select, textarea) {
        border: 1px solid var(--academy-ink-faint);
        border-radius: var(--academy-radius-md);
        background: var(--academy-paper);
        color: var(--academy-ink);
        padding: 0.5rem 0.75rem;
        min-height: 2.25rem;
    }

    :where(input, select, textarea):disabled {
        opacity: 0.6;
    }
}
