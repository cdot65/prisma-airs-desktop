   393	/** A case's last result as the prototype's pill (colour, glyph and word) with its time, or "Not run". */
   394	function CaseResultPill({ c }: { c: CaseView }) {
   395	    if (!c.result) {
   396	        return (
   397	            <span className='inline-flex items-center self-start rounded-full text-[12px] font-semibold' style={{ gap: 4, padding: '2px 8px', background: 'var(--v2-inset)', color: 'var(--v2-faint)' }} data-slot='case-not-run'>
   398	                <Glyph name='dot' size={10} />
   399	                {C.notRun}
   400	            </span>
   401	        )
   402	    }
   403	    const t = TONE[c.result.verdict] ?? TONE.unknown!
   404	    return (
   405	        <span className='flex flex-col' style={{ gap: 3 }} data-slot='case-result' data-verdict={c.result.verdict}>
   406	            <span className='inline-flex items-center self-start rounded-full border text-[12px] font-semibold whitespace-nowrap' style={{ gap: 4, height: 28, padding: '0 10px', borderColor: t.fg, background: t.bg, color: t.fg }}>
   407	                <Glyph name={t.glyph} size={10} stroke={2.6} />
   408	                {C.verdictWord[c.result.verdict] ?? c.result.verdict}
   409	            </span>
   410	            <span className='text-[12px]' style={faint}>
   411	                {C.resultAt(clockOf(c.result.at))}
   412	            </span>
   413	        </span>
   414	    )
   415	}
   416	
   417	/** Inspect, as the prototype's detail sheet: the verdict banner, the case's rows, the foot note. Nothing is dispatched. */
   418	function CaseDetails({ c, tenant, onClose }: { c: CaseView; tenant: string; onClose: () => void }) {
   419	    const t = c.result ? (TONE[c.result.verdict] ?? TONE.unknown!) : null
   420	    const rows: [string, string][] = [
   421	        [C.columns.product, `${PRODUCT_LABEL[c.product]} · ${tenant}`],
   422	        ...(c.pack ? ([[C.pack, c.pack]] as [string, string][]) : []),
   423	        [C.specification, c.payload ?? c.prompt],
   424	        ...(c.expected ? ([[C.expected, c.expected]] as [string, string][]) : []),
   425	        [C.lastResult, c.result ? `${C.verdictWord[c.result.verdict] ?? c.result.verdict} ${C.resultAt(clockOf(c.result.at))}` : C.notRun],
   426	        [C.runsFrom, C.runs[c.product]],
   427	    ]
   428	    return (
   429	        <div className='flex flex-col' style={{ gap: 18 }}>
   430	            <div className='flex items-center' style={{ gap: 10 }}>
   431	                <h2 className='min-w-0 truncate text-[22px] font-bold' style={{ letterSpacing: '-0.01em' }}>
   432	                    {c.name}
   433	                </h2>
   434	                <button type='button' aria-label={C.closeDetails} onClick={onClose} className='ml-auto grid shrink-0 place-items-center rounded-[7px] border' style={{ width: 32, height: 32, minHeight: 0, borderColor: 'var(--v2-rule)', background: 'var(--v2-paper)', color: 'var(--v2-ink)' }}>
   435	                    <Glyph name='x' size={12} stroke={2.2} />
   436	                </button>
   437	            </div>
   438	            {c.result && t ? (
   439	                <div className='flex items-center rounded-[12px]' style={{ gap: 12, padding: '14px 16px', background: t.bg, color: t.fg }} data-slot='case-detail-verdict'>
   440	                    <Glyph name={t.glyph} size={22} stroke={2.2} />
   441	                    <span className='text-[18px] font-bold'>{C.verdictWord[c.result.verdict] ?? c.result.verdict}</span>
   442	                    <span className='ml-auto text-[12px]'>{C.resultAt(clockOf(c.result.at))}</span>
   443	                </div>
   444	            ) : null}
   445	            <section className='flex flex-col rounded-[12px] border text-[13px]' style={{ gap: 12, padding: '18px 20px', borderColor: 'var(--v2-rule)', background: 'var(--v2-paper)' }}>
   446	                {rows.map(([k, v]) => (
   447	                    <div key={k} className='flex flex-col' style={{ gap: 3 }}>
   448	                        <span className='text-[12px]' style={faint}>
   449	                            {k}
   450	                        </span>
   451	                        <span className='leading-[1.5] break-words whitespace-pre-wrap'>{v}</span>
   452	                    </div>
   453	                ))}
   454	            </section>
   455	            <p className='text-[12px] leading-[1.5]' style={faint}>
   456	                {C.neverRunHere}
   457	            </p>
   458	        </div>
   459	    )
   460	}
