   530	type CaseDraft = { product: CaseProduct; name: string; profile: string; prompt: string; response: string; appName: string; expected: string; payload: string }
   531	
   532	const LABEL = 'flex flex-col text-[12px] font-semibold'
   533	const labelStyle = { gap: 5, color: 'var(--v2-soft)' }
   534	const control = { borderColor: 'var(--v2-ctl)', background: 'var(--v2-bg)', color: 'var(--v2-ink)' }
   535	
   536	/** A new case (C12's authoring) in the prototype's dialog: every field is read when Save is pressed; saving runs nothing. */
   537	function CaseForm({ tenant, initialProduct, onSave, onCancel }: { tenant: string; initialProduct: CaseProduct; onSave: (draft: CaseDraft) => Promise<void>; onCancel: () => void }) {
   538	    const ids = useId()
   539	    const form = useRef<HTMLFormElement>(null)
   540	    const [product, setProduct] = useState<CaseProduct>(initialProduct)
   541	    const runtime = product === 'runtime-security'
   542	    const F = C.form
   543	    return (
   544	        <form
   545	            ref={form}
   546	            aria-label={F.title}
   547	            className='flex flex-col'
   548	            style={{ gap: 14 }}
   549	            data-slot='case-form'
   550	            onSubmit={(e) => {
   551	                e.preventDefault()
   552	                const data = new FormData(form.current ?? undefined)
   553	                const read = (n: string) => (data.get(n) as string | null) ?? ''
   554	                void onSave({ product, name: read('name'), profile: runtime ? read('profile') : '', prompt: read('prompt'), response: read('response'), appName: runtime ? read('app') : '', expected: read('expected'), payload: runtime ? '' : read('payload') })
   555	            }}
   556	        >
   557	            <div>
   558	                <h2 className='text-[20px] font-bold' style={{ letterSpacing: '-0.01em' }}>
   559	                    {C.newCaseTitle}
   560	                </h2>
   561	                <p className='text-[13px] font-normal' style={{ marginTop: 4, ...soft }}>
   562	                    {C.newCaseLead(tenant)}
   563	                </p>
   564	            </div>
   565	            <div className='grid' style={{ gridTemplateColumns: 'repeat(auto-fit, minmax(min(100%, 200px), 1fr))', gap: 12 }}>
   566	                <label className={LABEL} style={labelStyle}>
   567	                    {F.product}
   568	                    <select className='h-8 min-h-0 rounded-[7px] border px-2 text-[13px] font-normal' style={control} value={product} onChange={(e) => setProduct(e.target.value as CaseProduct)}>
   569	                        {PRODUCTS.map((p) => (
   570	                            <option key={p} value={p}>
   571	                                {PRODUCT_LABEL[p]}
   572	                            </option>
   573	                        ))}
   574	                    </select>
   575	                </label>
   576	                <label className={LABEL} style={labelStyle} htmlFor={`${ids}-name`}>
   577	                    {F.name}
   578	                    <Field id={`${ids}-name`} name='name' maxLength={128} autoComplete='off' className='font-normal' />
   579	                </label>
   580	            </div>
   581	            {runtime ? (
   582	                <div className='grid' style={{ gridTemplateColumns: 'repeat(auto-fit, minmax(min(100%, 200px), 1fr))', gap: 12 }}>
   583	                    <label className={LABEL} style={labelStyle} htmlFor={`${ids}-profile`}>
   584	                        {F.profile}
   585	                        <Field id={`${ids}-profile`} name='profile' maxLength={256} autoComplete='off' spellCheck={false} className='font-normal' />
   586	                    </label>
   587	                    <label className={LABEL} style={labelStyle} htmlFor={`${ids}-app`}>
   588	                        {F.app}
   589	                        <Field id={`${ids}-app`} name='app' maxLength={256} autoComplete='off' spellCheck={false} className='font-normal' />
   590	                    </label>
   591	                </div>
   592	            ) : null}
   593	            <label className={LABEL} style={labelStyle} htmlFor={`${ids}-prompt`}>
   594	                {F.prompt}
   595	                <textarea id={`${ids}-prompt`} name='prompt' rows={4} spellCheck={false} className='min-h-0 resize-none rounded-[8px] border px-3 py-2.5 text-[13px] font-normal leading-[1.45]' style={control} />
   596	            </label>
   597	            <label className={LABEL} style={labelStyle} htmlFor={`${ids}-response`}>
   598	                {F.response}
   599	                <textarea id={`${ids}-response`} name='response' rows={2} spellCheck={false} className='min-h-0 resize-none rounded-[8px] border px-3 py-2.5 text-[13px] font-normal leading-[1.45]' style={control} />
   600	            </label>
   601	            <label className={LABEL} style={labelStyle} htmlFor={`${ids}-expected`}>
   602	                {F.expected}
   603	                <Field id={`${ids}-expected`} name='expected' maxLength={1024} autoComplete='off' aria-describedby={`${ids}-expected-hint`} className='font-normal' />
   604	                <span id={`${ids}-expected-hint`} className='text-[12px] font-normal' style={faint}>
   605	                    {F.expectedHint}
   606	                </span>
