[data-v2-shell] select,
[data-v2-shell] textarea {
    border: 1px solid var(--v2-ctl);
    border-radius: var(--v2-radius-control);
    background: var(--v2-bg);
    color: var(--v2-ink);
    min-height: var(--v2-control);
}
/* Rail collapses to icons below 1280 CSS px; nothing scrolls horizontally. */
