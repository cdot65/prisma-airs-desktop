   462	/** Load starter packs: the bundled packs and the public examples as checks, loaded together; the operator's own cases move by file. */
   463	function PacksDialog({ tenant, fetching, choosing, hasCases, onLoad, onImport, onExport, onCancel, status }: { tenant: string; fetching: boolean; choosing: boolean; hasCases: boolean; onLoad: (sources: ('bundled' | 'public')[]) => Promise<void>; onImport: () => void; onExport: () => void; onCancel: () => void; status: React.ReactNode }) {
   464	    const [bundled, setBundled] = useState(true)
   465	    const [pub, setPub] = useState(false)
   466	    const [busy, setBusy] = useState(false)
   467	    const P = C.packs
   468	    const option = (on: boolean, toggle: () => void, name: string, note: string, disabled = false) => (
   469	        <button type='button' role='checkbox' aria-checked={on} aria-disabled={disabled || undefined} onClick={() => !disabled && toggle()} className='flex items-center text-left text-[13px]' style={{ gap: 12, padding: '12px 16px', borderTop: '1px solid var(--v2-rule)', color: 'var(--v2-ink)', opacity: disabled ? 0.6 : 1 }}>
   470	            <span className='grid shrink-0 place-items-center rounded-[5px]' style={{ width: 18, height: 18, border: `1.5px solid ${on ? 'var(--v2-acc)' : 'var(--v2-ctl)'}`, background: on ? 'var(--v2-acc)' : 'transparent', color: 'var(--v2-acc-ink)' }}>
   471	                {on ? <Glyph name='check' size={11} stroke={3.2} /> : null}
   472	            </span>
   473	            <span className='flex-grow font-semibold'>{name}</span>
   474	            <span className='text-[12px]' style={faint}>
   475	                {note}
   476	            </span>
   477	        </button>
   478	    )
   479	    return (
   480	        <div className='flex flex-col' style={{ gap: 14 }}>
   481	            <div>
   482	                <h2 className='text-[20px] font-bold' style={{ letterSpacing: '-0.01em' }}>
   483	                    {P.title}
   484	                </h2>
   485	                <p className='text-[13px]' style={{ marginTop: 4, ...soft }}>
   486	                    {P.lead(tenant)}
   487	                </p>
   488	            </div>
   489	            <div className='flex flex-col overflow-hidden rounded-[12px] border' style={{ borderColor: 'var(--v2-rule)', marginTop: -1 }}>
   490	                {option(bundled, () => setBundled(!bundled), P.bundled, P.bundledNote)}
   491	                {option(pub, () => setPub(!pub), P.public, fetching ? 'Fetching…' : P.publicNote, fetching)}
   492	            </div>
   493	            <p className='text-[12px]' style={faint} data-slot='cases-transfer-note'>
   494	                {C.transferNote}
   495	            </p>
   496	            {status}
   497	            <div className='flex flex-wrap items-center' style={{ gap: 8 }}>
   498	                <span className='text-[12px]' style={faint}>
   499	                    {P.transfer}
   500	                </span>
   501	                <Btn tier='tertiary' aria-disabled={choosing} onClick={onImport}>
   502	                    {C.importCases}
   503	                </Btn>
   504	                <Btn tier='tertiary' disabled={!hasCases} onClick={onExport}>
   505	                    {C.exportCases}
   506	                </Btn>
   507	                <span className='ml-auto flex' style={{ gap: 8 }}>
   508	                    <Btn onClick={onCancel}>{P.cancel}</Btn>
   509	                    <Btn
   510	                        tier='primary'
   511	                        className='px-4'
   512	                        disabled={busy || (!bundled && !pub)}
   513	                        onClick={async () => {
   514	                            setBusy(true)
   515	                            try {
   516	                                await onLoad([...(bundled ? (['bundled'] as const) : []), ...(pub ? (['public'] as const) : [])])
   517	                            } finally {
   518	                                setBusy(false)
   519	                            }
   520	                        }}
   521	                    >
   522	                        {P.load}
   523	                    </Btn>
   524	                </span>
   525	            </div>
   526	        </div>
   527	    )
   528	}
