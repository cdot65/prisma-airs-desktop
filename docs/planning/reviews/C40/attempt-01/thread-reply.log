    fn changed_library(library: &mut Library) -> (TenantId, u64) {
        library.problem = None;
        library.generation += 1;
        (library.tenant.clone(), library.generation)
    }

    /// Saves a new case authored from `draft`. A library that is not open
    /// yet opens, and the case is added when it does (its write follows).
    pub(super) fn save_case(
        &mut self,
        context: &ContextRef,
        draft: CaseDraft,
    ) -> Result<CopyEffects, Refusal> {
        let tenant = self.check_context(context)?;
        self.library_root
            .as_ref()
            .ok_or(Refusal::CapabilityMissing)?;
        let name = draft.name.clone();
        let case = draft.into_case(tenant.as_str());
        let open = self
            .libraries
            .iter()
            .any(|l| l.tenant == tenant && l.state == LibraryState::Ready);
        if !open {
            let case = case.map_err(|_| Refusal::InvalidInput)?;
            let load = self.start_library(&tenant);
            let library = self
                .libraries
                .iter_mut()
                .find(|l| l.tenant == tenant)
                .ok_or(Refusal::Busy)?;
            if library.pending.len() >= crate::library::CASE_LIMIT {
                return Err(Refusal::Busy);
            }
            let stamp = library.act();
            library.pending.push(Pending {
                case,
                origin: tenant,
                notice: LibraryNotice::Saved { name },
                stamp,
            });
            return Ok((None, load));
        }
        let library = self.library_mut(&tenant)?;
        library.notice = None;
        match case.and_then(|case| library.library.add(case, tenant.as_str())) {
            Ok(()) => {
                let write = Self::changed_library(library);
                library.outcomes.push(Outcome {
                    generation: write.1,
                    origin: tenant,
                    notice: LibraryNotice::Saved { name },
                    stamp: library.status,
                });
                Ok((Some(write), None))
            }
            Err(problem) => {
                library.problem = Some(problem);
                Err(Refusal::InvalidInput)
            }
        }
    }

    /// Writes the library again (an explicit retry after a failed save).
    pub(super) fn retry_library(
        &mut self,
        context: &ContextRef,
    ) -> Result<(TenantId, u64), Refusal> {
        let tenant = self.check_context(context)?;
        let library = self.library_mut(&tenant)?;
        if library.unsaved.is_none() {
            return Err(Refusal::InvalidInput);
        }
        library.generation += 1;
        Ok((tenant, library.generation))
    }

    pub(super) fn delete_case(
        &mut self,
        context: &ContextRef,
        id: &str,
    ) -> Result<(TenantId, u64), Refusal> {
        let tenant = self.check_context(context)?;
        let library = self.library_mut(&tenant)?;
        library.notice = None;
        if library.library.remove(id).is_none() {
            library.problem = Some(CaseProblem::Missing);
            return Err(Refusal::InvalidInput);
        }
        Ok(Self::changed_library(library))
    }

    /// Adds catalog examples (new identifiers, this tenant) not already
    /// present by product and name.
    pub(super) fn add_examples(
        &mut self,
        tenant: &TenantId,
        parsed: Result<Vec<TestCase>, CaseProblem>,
    ) -> Result<(TenantId, u64), Refusal> {
        let library = self.library_mut(tenant)?;
        let examples = match parsed {
            Ok(examples) => new_examples(&library.library, examples),
            Err(problem) => {
                library.problem = Some(problem);
                return Err(Refusal::InvalidInput);
            }
        };
        if examples.is_empty() {
            library.problem = Some(CaseProblem::AllPresent);
            return Err(Refusal::InvalidInput);
        }
        match library.library.merge(examples) {
            Ok(added) => {
                library.notice = None;
                let write = Self::changed_library(library);
                library.outcomes.push(Outcome {
                    generation: write.1,
                    origin: tenant.clone(),
                    notice: LibraryNotice::ExamplesAdded {
                        added: u32::try_from(added).unwrap_or(u32::MAX),
                    },
                    stamp: library.status,
                });
                Ok(write)
            }
            Err(problem) => {
                library.problem = Some(problem);
                Err(Refusal::InvalidInput)
            }
        }
    }

    pub(super) fn import_bundled(
        &mut self,
        context: &ContextRef,
                Ok(()) => Ok(o.notice),
                Err(_) => Err(CaseProblem::NotSaved),
            };
            self.deliver(&o.origin, o.stamp, outcome);
        }
    }

    /// A tenant's cases as its open library holds them (C23).
    pub(super) fn open_library_cases(&self, tenant: &TenantId) -> Option<Vec<TestCase>> {
        self.libraries
            .iter()
            .find(|l| &l.tenant == tenant && l.state == LibraryState::Ready)
            .map(|l| l.library.cases.clone())
    }

    /// Applies an import's change to a tenant's open library (C23): what it
    /// returned and, when it changed the library, the generation to write.
    /// `None` when the library is not open.
    pub(super) fn change_open_library<R>(
        &mut self,
        tenant: &TenantId,
        change: impl FnOnce(&mut CaseLibrary) -> (R, bool),
    ) -> Option<(R, Option<u64>)> {
        let library = self
            .libraries
            .iter_mut()
            .find(|l| &l.tenant == tenant && l.state == LibraryState::Ready)?;
        let (result, changed) = change(&mut library.library);
        if !changed {
            return Some((result, None));
        }
        library.status += 1;
        let (_, generation) = Self::changed_library(library);
        Some((result, Some(generation)))
    }

    /// Reports a problem with a change the core made to a tenant's open
    /// library by itself (C33: a case result it had no room for).
    pub(super) fn library_problem(&mut self, tenant: &TenantId, problem: CaseProblem) {
        if let Some(library) = self
            .libraries
            .iter_mut()
            .find(|l| &l.tenant == tenant && l.state == LibraryState::Ready)
        {
            library.problem = Some(problem);
        }
    }

    /// The newest generation of a tenant's open library (C23).
