   113	def contained(n, outer, slack=1):
   114	    a, b = frame(n), frame(outer)
   115	    return bool(a and b) and a[0] >= b[0] - slack and a[1] >= b[1] - slack and a[2] <= b[2] + slack and a[3] <= b[3] + slack
   116	
