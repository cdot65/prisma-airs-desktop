   118	def geometry(tree):
   119	    web = next((n for n in tree if n.get("role") == "AXWebArea" and n.get("size")), None)
   120	    scroll = next((n for n in tree if n.get("role") == "AXScrollArea" and n.get("size")), None)
   121	    win = next((n for n in tree if n.get("role") == "AXWindow"), None)
   122	    return {"web": [int(web["size"][0]), int(web["size"][1])] if web else None,
   123	            "viewport": [int(scroll["size"][0]), int(scroll["size"][1])] if scroll else None,
   124	            "window": win.get("size") if win else None}
