   141	def overflow(app):
   142	    tree = app.tree()
   143	    win = next((n for n in tree if n.get("role") == "AXWindow"), None)
   144	    nodes = [n for n in tree if n.get("pos") and n.get("size") and n["size"][0] > 0
   145	             and n.get("role") in ("AXButton", "AXStaticText", "AXTextField", "AXTextArea", "AXSearchField", "AXCheckBox", "AXPopUpButton", "AXLink", "AXHeading", "AXRadioButton")]
   146	    right = max(n["pos"][0] + n["size"][0] for n in nodes) if nodes and win else None
   147	    hbars = [n for n in tree if n.get("role") == "AXScrollBar" and (n.get("orientation") == "horizontal" or (n.get("size") and n["size"][0] > n["size"][1]))]
   148	    return {"overflow_px": max(0, right - (win["pos"][0] + win["size"][0])) if right is not None else None, "horizontal_scrollbars": len(hbars)}, tree
