   409	/** A case's last result as the prototype's pill (colour, glyph and word) with its time, or "Not run". */
   410	function CaseResultPill({ c, onOpen }: { c: CaseView; onOpen: () => void }) {
   411	    if (!c.result) {
   412	        return (
   413	            <span className='inline-flex items-center self-start rounded-full text-[12px] font-semibold' style={{ gap: 4, padding: '2px 8px', background: 'var(--v2-inset)', color: 'var(--v2-faint)' }} data-slot='case-not-run'>
   414	                <Glyph name='dot' size={10} />
   415	                {C.notRun}
