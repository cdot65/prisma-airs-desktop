   127	def size_window(app, pid, w, h):
   128	    fx.sh(["osascript", "-e", f'tell application "System Events" to tell (first application process whose unix id is {pid}) to set position of window 1 to {{0, 0}}'])
   129	    requested = [w, h + TITLE_BAR]
   130	    for _ in range(3):
   131	        c28.set_window_size(pid, requested[0], requested[1])
   132	        time.sleep(0.8)
   133	        g = geometry(app.tree())
   134	        vp = g["viewport"] or g["web"]
   135	        if not vp or vp[1] == h:
   136	            break
   137	        requested = [requested[0], requested[1] + (h - vp[1])]
   138	    return c29.window_frame(pid)
