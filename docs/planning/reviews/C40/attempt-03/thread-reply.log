        let library = self
            .libraries
            .iter_mut()
            .find(|l| l.lease == lease && l.state == LibraryState::Loading)?;
        let pending = std::mem::take(&mut library.pending);
        let (write, failed) = match loaded {
            Ok(cases) => {
                library.library = cases;
                library.state = LibraryState::Ready;
