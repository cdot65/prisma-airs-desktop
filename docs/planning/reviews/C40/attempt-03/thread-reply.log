//! The case Library inside the authority (C12). Each tenant's cases are
//! sealed on this Mac under a key in the credential Keychain namespace and
//! opened off the lock; every change is written newest-generation-first by
//! the local-data writer, which tenant deletion and reset also take, so a
//! deleted tenant's library never reappears. Imports and catalog imports
//! are explicit, bounded and validated like v1; nothing is executed or
//! uploaded. Only Runtime Security cases fill the scan form, and that
//! happens in the presentation without scanning.

use serde::{Deserialize, Serialize};
use ts_rs::TS;

use super::{Refusal, State};
use crate::context::ContextRef;
use crate::library::{
    CaseDraft, CaseLibrary, CaseProblem, CaseProduct, CaseView, LibraryFailure, TestCase,
    new_examples,
};
use crate::tenants::TenantId;

#[derive(Clone, Copy, Debug, PartialEq, Eq, Serialize, TS)]
#[serde(rename_all = "camelCase")]
pub enum LibraryState {
    Idle,
    Loading,
    Ready,
    Failed,
}

/// Where a catalog import comes from.
#[derive(Clone, Copy, Debug, PartialEq, Eq, Serialize, Deserialize, TS)]
#[serde(rename_all = "camelCase")]
pub enum CatalogSource {
    /// v1's eleven synthetic examples, compiled in.
    Bundled,
    /// The public example catalog (an explicit HTTPS read of public data;
    /// no tenant credential is involved).
    Public,
}

/// What the last explicit library operation did.
#[derive(Clone, Debug, PartialEq, Eq, Serialize, TS)]
#[serde(tag = "kind", rename_all = "camelCase")]
pub enum LibraryNotice {
    /// A case was saved (its write on this Mac succeeded).
    Saved {
        name: String,
    },
    Imported {
        added: u32,
    },
    ExamplesAdded {
        added: u32,
    },
    /// A case was copied into another tenant's library (as a new case).
    Copied {
        tenant: String,
    },
    /// The public catalog could not be read (sanitized).
    CatalogUnavailable,
    /// The chosen file could not be read.
    FileUnreadable,
}

#[derive(Clone, Debug, PartialEq, Eq, Serialize, TS)]
#[serde(rename_all = "camelCase")]
pub struct LibraryView {
    pub state: LibraryState,
    pub failure: Option<LibraryFailure>,
    pub cases: Vec<CaseView>,
    /// Why the last change was refused.
    pub problem: Option<CaseProblem>,
    /// The last change could not be saved on this Mac.
    pub unsaved: Option<LibraryFailure>,
    pub notice: Option<LibraryNotice>,
    /// A case file sheet is open.
    pub choosing: bool,
    /// The public catalog is being read.
    pub fetching: bool,
    pub export: Option<super::ExportView>,
}

pub(super) struct Library {
    tenant: TenantId,
    lease: u64,
    state: LibraryState,
    failure: Option<LibraryFailure>,
    library: CaseLibrary,
    pub(super) generation: u64,
    unsaved: Option<LibraryFailure>,
    problem: Option<CaseProblem>,
    notice: Option<LibraryNotice>,
    /// Additions made before this library opened (saves and copies).
    pending: Vec<Pending>,
    /// What to tell whom once the write of a generation succeeds.
    outcomes: Vec<Outcome>,
    /// Advances with every operation on this library; a success notice
    /// stamped earlier never replaces what a later operation reported.
    status: u64,
    choosing: Option<u64>,
    fetching: Option<u64>,
}

impl Library {
    fn new(tenant: TenantId, lease: u64) -> Self {
        Self {
            tenant,
            lease,
            state: LibraryState::Loading,
            failure: None,
            library: CaseLibrary::default(),
            generation: 0,
            unsaved: None,
            problem: None,
            notice: None,
            pending: Vec::new(),
            outcomes: Vec::new(),
            status: 0,
            choosing: None,
            fetching: None,
        }
    }
}

impl Library {
    /// Marks the start of an operation; returns its status stamp.
    fn act(&mut self) -> u64 {
        self.status += 1;
        self.status
    }
}

/// An addition waiting for its library to open, and whom to tell.
pub(super) struct Pending {
    case: TestCase,
    origin: TenantId,
    notice: LibraryNotice,
    /// The origin's status when the addition was made.
    stamp: u64,
}

/// What a write of `generation` tells `origin` once it ends.
struct Outcome {
    generation: u64,
    origin: TenantId,
    notice: LibraryNotice,
    stamp: u64,
}

/// A copy's follow-up: the destination's write and, if it was not open,
/// its load lease.
pub(super) type CopyEffects = (Option<(TenantId, u64)>, Option<u64>);

/// What a write needs: the tenant, its generation and its cases.
pub(super) struct LibraryWrite {
    pub root: std::path::PathBuf,
    pub tenant: String,
    pub library: CaseLibrary,
}

impl State {
    /// Tells the library of `origin` how its operation ended. A success is
    /// shown only if nothing was done there since (`stamp`); a failure to
    /// save is always shown.
    fn deliver(
        &mut self,
        origin: &TenantId,
        stamp: u64,
        outcome: Result<LibraryNotice, CaseProblem>,
    ) {
        if let Some(library) = self.libraries.iter_mut().find(|l| &l.tenant == origin) {
            match outcome {
                Ok(_) if library.status != stamp => {}
                Ok(notice) => {
                    library.notice = Some(notice);
                    library.problem = None;
                }
                Err(problem) => {
                    library.problem = Some(problem);
                    library.notice = None;
                }
            }
        }
    }

    fn library_mut(&mut self, tenant: &TenantId) -> Result<&mut Library, Refusal> {
        let library = self
            .libraries
            .iter_mut()
            .find(|l| &l.tenant == tenant)
            .ok_or(Refusal::CapabilityMissing)?;
        match library.state {
            LibraryState::Ready => {
                library.act();
                Ok(library)
            }
            LibraryState::Loading => Err(Refusal::Busy),
            _ => Err(Refusal::CapabilityMissing),
        }
    }

    /// Starts opening `tenant`'s library unless it is open or opening;
    /// returns the load lease.
    fn start_library(&mut self, tenant: &TenantId) -> Option<u64> {
        if self.libraries.iter().any(|l| {
            &l.tenant == tenant && matches!(l.state, LibraryState::Loading | LibraryState::Ready)
        }) {
            return None;
        }
        let lease = self.lease();
        let pending = self
            .libraries
            .iter_mut()
            .find(|l| &l.tenant == tenant)
            .map(|l| std::mem::take(&mut l.pending))
            .unwrap_or_default();
        self.libraries.retain(|l| &l.tenant != tenant);
        let mut library = Library::new(tenant.clone(), lease);
        library.pending = pending;
        self.libraries.push(library);
        Some(lease)
    }

    pub(super) fn open_library(&mut self, context: &ContextRef) -> Result<Option<u64>, Refusal> {
        let tenant = self.check_context(context)?;
        self.library_root
            .as_ref()
            .ok_or(Refusal::CapabilityMissing)?;
        Ok(self.start_library(&tenant))
    }

    pub(super) fn library_load_target(&self, lease: u64) -> Option<(std::path::PathBuf, String)> {
        let library = self.libraries.iter().find(|l| l.lease == lease)?;
        Some((
            self.library_root.clone()?,
            library.tenant.as_str().to_owned(),
        ))
    }

    /// Settles a load. Additions made meanwhile are merged (all or none)
        let runtime = self.product.can_scan();
        let payload = if runtime || self.payload.trim().is_empty() {
            Value::Null
        } else {
            match serde_json::from_str::<Value>(&self.payload) {
                Ok(value @ Value::Object(_)) => value,
                _ => return Err(CaseProblem::Payload),
            }
        };
        let case = TestCase {
            id: new_id().ok_or(CaseProblem::Fields)?,
            tenant: tenant.to_owned(),
            product: self.product,
            name: self.name,
            profile: if runtime { self.profile } else { String::new() },
            prompt: self.prompt,
            response: self.response,
            app_name: if runtime {
                self.app_name
            } else {
                String::new()
            },
            expected: self.expected,
            payload,
            pack: None,
            result: None,
        };
        case.validate(tenant)?;
        Ok(case)
    }
}

/// A case as the presentation sees it.
#[derive(Clone, Debug, PartialEq, Eq, Serialize, TS)]
#[serde(rename_all = "camelCase")]
pub struct CaseView {
    pub id: String,
    pub product: CaseProduct,
    pub name: String,
    pub profile: String,
    pub prompt: String,
    pub response: String,
    pub app_name: String,
    pub expected: String,
    /// The payload as pretty JSON (non-Runtime products), if any.
    pub payload: Option<String>,
    /// The starter pack it came from (C33).
    #[serde(skip_serializing_if = "Option::is_none")]
    #[ts(optional)]
    pub pack: Option<String>,
    /// Its last result; absent: not run (C33).
    #[serde(skip_serializing_if = "Option::is_none")]
    #[ts(optional)]
    pub result: Option<CaseResult>,
}

impl From<&TestCase> for CaseView {
    fn from(c: &TestCase) -> Self {
        Self {
            id: c.id.clone(),
            product: c.product,
            name: c.name.clone(),
            profile: c.profile.clone(),
            prompt: c.prompt.clone(),
            response: c.response.clone(),
            app_name: c.app_name.clone(),
            expected: c.expected.clone(),
            payload: (!c.payload.is_null())
                .then(|| serde_json::to_string_pretty(&c.payload).ok())
                .flatten(),
            pack: c.pack.clone(),
            result: c.result.clone(),
        }
    }
}

/// The cases of one tenant, in order, within v1's bounds.
#[derive(Clone, Debug, Default, PartialEq)]
pub struct CaseLibrary {
    pub cases: Vec<TestCase>,
}

impl CaseLibrary {
    fn encoded_len(cases: &[TestCase]) -> usize {
        serde_json::to_vec(cases).map_or(usize::MAX, |b| b.len())
    }

    /// Records a Playground scan's result for case `id` (C33): only for a
    /// Runtime case still holding exactly what was scanned, and only while
    /// the library stays within 256 KiB (the loader's own limit).
    pub fn record_result(
        &mut self,
        id: &str,
        prompt: &str,
        response: &str,
        result: CaseResult,
    ) -> Recorded {
        let Some(at) = self.cases.iter().position(|c| {
            c.id == id && c.product.can_scan() && c.prompt == prompt && c.response == response
        }) else {
            return Recorded::NotHeld;
        };
        let before = self.cases[at].result.replace(result);
        if Self::encoded_len(&self.cases) > LIBRARY_BYTES {
            self.cases[at].result = before;
            return Recorded::TooLarge;
        }
        Recorded::Recorded
    }

    /// v1 `add_case`: validated, unique, within 32 cases and 256 KiB.
    pub fn add(&mut self, case: TestCase, tenant: &str) -> Result<(), CaseProblem> {
        case.validate(tenant)?;
        if self.cases.len() >= CASE_LIMIT {
            return Err(CaseProblem::Full);
        }
    .iter()
    .map(|argv| argv.iter().map(|s| (*s).to_owned()).collect())
    .collect();
    for argv in &commands {
        let status = env
            .command(argv, repo.root())?
            .status()
            .map_err(io_err(repo.root()))?;
        if !status.success() {
            return Err(invalid(format!("{} failed with {status}", argv.join(" "))));
        }
    }
    let app = bundle_path(repo, target, PRODUCT);
    let identifier = plist_value(&app, "CFBundleIdentifier")?;
    if identifier != crate::native::PRODUCTION_IDENTIFIER {
        return Err(invalid(format!(
            "the production bundle has identifier {identifier}"
        )));
    }
    let version = plist_value(&app, "CFBundleShortVersionString")?;
    let dmg = repo.join(format!(
        "target/{target}/release/bundle/dmg/{PRODUCT}_{version}_aarch64.dmg"
    ));
    Ok(ProductionBuild {
        app,
        dmg,
        identifier,
        commands,
    })
}

