    97	def within(tree, node):
    98	    if not node:
    99	        return []
   100	    i = tree.index(node)
   101	    out = []
   102	    for m in tree[i + 1:]:
   103	        if m.get("depth", 0) <= node.get("depth", 0):
   104	            break
   105	        out.append(m)
   106	    return out
