   419	    const t = TONE[c.result.verdict] ?? TONE.unknown!
   420	    return (
   421	        <span className='flex flex-col' style={{ gap: 3 }} data-slot='case-result' data-verdict={c.result.verdict}>
   422	            <button
   423	                type='button'
   424	                aria-label={`${C.verdictWord[c.result.verdict] ?? c.result.verdict}: ${C.showResult(c.name)}`}
   425	                aria-haspopup='dialog'
   426	                onClick={onOpen}
   427	                className='inline-flex min-h-0 items-center self-start rounded-full border text-[12px] font-semibold whitespace-nowrap'
   428	                style={{ gap: 4, height: 28, padding: '0 10px', borderColor: t.fg, background: t.bg, color: t.fg }}
   429	            >
   430	                <Glyph name={t.glyph} size={10} stroke={2.6} />
   431	                {C.verdictWord[c.result.verdict] ?? c.result.verdict}
