   151	def table_usable(tree, zoom):
   152	    """The cases table at this zoom: the header row, the first row's action and the footer inside the card, the
   153	    row's action control at least 32 CSS px."""
   154	    table = next((n for n in tree if n.get("role") == "AXTable" and (n.get("label") or "") == "Test Cases"), None)
   155	    card = next((n for n in tree if n.get("role") == "AXGroup" and n.get("pos") and n.get("size") and table and contained(table, n) and n["size"][1] > table["size"][1] - 1 and n["size"][0] >= table["size"][0] - 1), None)
   156	    action = next((n for n in tree if n.get("role") in BTN and (n.get("label") or "").startswith(("Open in Playground:", "Inspect:"))), None)
   157	    foot = next((n for n in tree if n.get("role") == "AXButton" and (n.get("label") or "") == "Next page"), None)
   158	    out = {"table": table is not None, "action_size": action.get("size") if action else None, "action_ok": bool(action and action["size"][0] >= 32 * zoom - 1 and action["size"][1] >= 32 * zoom - 1),
   159	           "foot": foot is not None, "zoom": zoom}
   160	    if table and action:
   161	        out["action_inside"] = contained(action, table) or (card is not None and contained(action, card))
   162	    else:
   163	        out["action_inside"] = False
   164	    # Readable regions (attempt-01 R1/E2, attempt-02 R1): the header words and one case row's four regions, bound
   165	    # to that row by its action's label (the case name): the name, the input, the result (the verdict button or
   166	    # "Not run") and the action each exist, are at least 24 CSS px wide and none overlaps another.
   167	    def box(n):
   168	        return (n["pos"][0], n["pos"][1], n["pos"][0] + n["size"][0], n["pos"][1] + n["size"][1]) if n and n.get("pos") and n.get("size") else None
   169	
   170	    def apart(a, b):
   171	        return not (a[0] < b[2] and b[0] < a[2] and a[1] < b[3] and b[1] < a[3])
   172	
   173	    inside = [n for n in tree if table and n.get("pos") and n.get("size") and contained(n, table)] if table else []
   174	    texts = [n for n in inside if n.get("role") == "AXStaticText" and (n.get("label") or n.get("value"))]
   175	    label_of = lambda n: (n.get("label") or n.get("value") or "")  # noqa: E731
   176	    headers = [next((n for n in texts if label_of(n) == h), None) for h in ("Case", "Product", "Input or specification", "Last result")]
   177	    case_name = (action.get("label") or "").split(": ", 1)[1] if action and ": " in (action.get("label") or "") else None
   178	    name = next((n for n in texts if case_name and label_of(n) == case_name), None)
   179	    # The row's nodes lie between its name and its action in tree order.
   180	    start = tree.index(name) if name else None
   181	    end = tree.index(action) if action else None
   182	    row = tree[start + 1:end] if start is not None and end is not None and end > start else []
   183	    result = next((n for n in row if (n.get("role") in BTN and label_of(n).endswith(f"Show the result of {case_name}")) or (n.get("role") == "AXStaticText" and label_of(n) == "Not run")), None)
   184	    product_words = ("Runtime Security", "AI Gateway", "AI Red Teaming", "Model Security", "Skill Scanning")
   185	    inputs = [n for n in row if n.get("role") == "AXStaticText" and n is not result and label_of(n) not in product_words and not label_of(n).startswith("at ") and label_of(n) != "Not run" and not label_of(n).startswith(("Starter", "Bundled"))]
   186	    input_text = max(inputs, key=lambda n: len(label_of(n)), default=None)
   187	    regions = {"name": name, "input": input_text, "result": result, "action": action, **{f"header_{i}": h for i, h in enumerate(headers)}}
   188	    out["regions"] = {k: label_of(v)[:40] if v else None for k, v in regions.items()}
   189	    present = {k: box(v) for k, v in regions.items() if v}
   190	    out["regions_present"] = len(present) == len(regions)
   191	    out["regions_wide"] = all(b[2] - b[0] >= 24 * zoom and b[3] - b[1] >= 8 * zoom for b in present.values())
   192	    keys = list(present)
   193	    overlaps = [(a, b) for i, a in enumerate(keys) for b in keys[i + 1:] if not apart(present[a], present[b])]
   194	    out["overlaps"] = overlaps
   195	    out["readable"] = out["regions_present"] and out["regions_wide"] and not overlaps
   196	    out["ok"] = out["table"] and out["action_ok"] and out["foot"] and out["action_inside"] and out["readable"]
   197	    return out
