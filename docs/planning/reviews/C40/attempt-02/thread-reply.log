   356	/** Answers the API Client's workbench requests, as request-send.test.tsx does. */
   357	function workbench(native: Native, answer: (request: WorkbenchRequest) => WorkbenchResult): WorkbenchRequest[] {
   358	    const requests: WorkbenchRequest[] = []
   359	    const pending = new Map<string, WorkbenchRequest>()
   360	    const respond = native.respond
   361	    native.respond = (intent: Intent) => {
   362	        if (intent.kind !== 'workbench') return respond(intent)
   363	        requests.push(intent.request)
   364	        const operation = `op-${requests.length}`
   365	        pending.set(operation, intent.request)
   366	        return { outcome: 'receipt', receipt: { kind: 'admitted', request: `rq-${requests.length}`, operation } }
   367	    }
   368	    native.observeWorkbench = async (operation) => {
   369	        const request = pending.get(operation)
   370	        if (!request) return { kind: 'refusal', refusal: 'invalidInput' }
   371	        return { kind: 'workbench', result: answer(request) }
   372	    }
   373	    return requests
   374	}
