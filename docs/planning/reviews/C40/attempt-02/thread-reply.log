   151	def table_usable(tree, zoom):
   152	    """The cases table at this zoom: the header row, the first row's action and the footer inside the card, the
   153	    row's action control at least 32 CSS px."""
   154	    table = next((n for n in tree if n.get("role") == "AXTable" and (n.get("label") or "") == "Test Cases"), None)
   155	    card = next((n for n in tree if n.get("role") == "AXGroup" and n.get("pos") and n.get("size") and table and contained(table, n) and n["size"][1] > table["size"][1] - 1 and n["size"][0] >= table["size"][0] - 1), None)
   156	    action = next((n for n in tree if n.get("role") in BTN and (n.get("label") or "").startswith(("Open in Playground:", "Inspect:"))), None)
   157	    foot = next((n for n in tree if n.get("role") == "AXButton" and (n.get("label") or "") == "Next page"), None)
   158	    out = {"table": table is not None, "action_size": action.get("size") if action else None, "action_ok": bool(action and action["size"][0] >= 32 * zoom - 1 and action["size"][1] >= 32 * zoom - 1),
   159	           "foot": foot is not None, "zoom": zoom}
   160	    if table and action:
   161	        out["action_inside"] = contained(action, table) or (card is not None and contained(action, card))
   162	    else:
   163	        out["action_inside"] = False
   164	    # Readable regions (attempt-01 R1/E2): the header words, the first row's case name, its input, its result and
   165	    # its action each have a width and none of them overlaps another; the 200% layout once stacked them.
   166	    def box(n):
   167	        return (n["pos"][0], n["pos"][1], n["pos"][0] + n["size"][0], n["pos"][1] + n["size"][1]) if n and n.get("pos") and n.get("size") else None
   168	
   169	    def apart(a, b):
   170	        return not (a[0] < b[2] and b[0] < a[2] and a[1] < b[3] and b[1] < a[3])
   171	
   172	    inside = [n for n in tree if table and n.get("pos") and n.get("size") and contained(n, table)] if table else []
   173	    texts = [n for n in inside if n.get("role") == "AXStaticText" and (n.get("label") or n.get("value"))]
   174	    headers = [next((n for n in texts if (n.get("label") or n.get("value")) == h), None) for h in ("Case", "Product", "Input or specification", "Last result")]
   175	    header_bottom = max((n["pos"][1] + n["size"][1] for n in headers if n), default=None)
   176	    row_texts = [n for n in texts if header_bottom is not None and n["pos"][1] >= header_bottom and n not in headers]
   177	    name = row_texts[0] if row_texts else None
   178	    result = next((n for n in inside if (n.get("role") in BTN and (n.get("label") or "").startswith("Show the result of")) or (n.get("role") == "AXStaticText" and (n.get("label") or n.get("value")) == "Not run")), None)
   179	    regions = {"name": name, "result": result, "action": action, **{f"header_{i}": h for i, h in enumerate(headers)}}
   180	    out["regions"] = {k: (v.get("label") or v.get("value") or "")[:30] if v else None for k, v in regions.items()}
   181	    present = {k: box(v) for k, v in regions.items() if v}
