async fn starter_packs_are_named_and_a_playground_scan_records_a_case_result_only_while_it_holds() {
    let mut t = tenant().await;
    t.desk.open_library().await;
    let context = t.desk.context();
    t.desk
        .send(json!({"kind": "importExamples", "context": context, "source": "bundled"}))
        .await
        .expect("packs");
    assert!(eventually(|| !t.desk.cases().is_empty()).await);
    let cases = t.desk.cases();
    // Every starter case carries its product's pack name and no result: "Not run".
    for c in &cases {
        let pack = c["pack"].as_str().expect("pack");
        assert!(pack.ends_with("starter pack"), "{c}");
        assert!(c.get("result").is_none(), "{c}");
    }
    let runtime = cases
        .iter()
        .find(|c| c["product"] == "runtime-security")
        .expect("runtime case")
        .clone();
    assert_eq!(runtime["pack"], "Runtime Security starter pack");
    let id = runtime["id"].as_str().expect("id").to_owned();
    let prompt = runtime["prompt"].as_str().expect("prompt").to_owned();
    let response = runtime["response"].as_str().expect("response").to_owned();
    // A scan opened from the case, of what the case holds: its verdict is recorded.
    let scan = t.scan(&prompt, &response, Some(&id)).await;
    assert_eq!(scan["result"]["verdict"], "block", "{scan}");
    assert!(
        eventually(|| t
            .desk
            .cases()
            .iter()
            .any(|c| c["id"] == id.as_str() && c["result"]["verdict"] == "block"))
        .await
    );
    let recorded = t
        .desk
        .cases()
        .into_iter()
        .find(|c| c["id"] == id.as_str())
        .expect("case");
    assert_eq!(recorded["result"]["scanId"], "S-c33-1");
    // A scan of something else (the prompt was changed in the Playground)
    // records nothing for the case, whatever its verdict.
    t.script.lock().expect("script").action = "allow";
    let other = t
        .scan(&format!("{prompt} (edited)"), &response, Some(&id))
        .await;
    assert_eq!(other["result"]["verdict"], "allow");
    tokio::time::sleep(Duration::from_millis(200)).await;
    let still = t
        .desk
        .cases()
        .into_iter()
        .find(|c| c["id"] == id.as_str())
        .expect("case");
    assert_eq!(still["result"]["verdict"], "block");
    // Never a result for a case of another product, and a malformed case is refused.
    let spec = cases
        .iter()
        .find(|c| c["product"] != "runtime-security")
        .expect("spec case")
        .clone();
    // A specification named with its own exact input: refused before anything
    // is sent (attempt-01 R1), as is a case this library does not hold.
    let requests = scan_requests(&t);
    let context = t.desk.context();
    for (case, prompt, response) in [
        (
            spec["id"].as_str().expect("id").to_owned(),
            spec["prompt"].as_str().expect("prompt").to_owned(),
            spec["response"].as_str().expect("response").to_owned(),
        ),
        (
            "00000000-0000-4000-8000-00000000dead".to_owned(),
            prompt.clone(),
            response.clone(),
        ),
    ] {
        assert_eq!(
            t.desk
                .send(
                    json!({"kind": "scan", "context": context, "case": case, "draft": {
                    "profile": {"kind": "name", "name": "Production guardrails"},
                    "prompt": prompt, "response": response, "appName": "Desktop examples"}})
                )
                .await
                .err(),
            Some(Refusal::InvalidInput),
            "{case}"
        );
    }
    tokio::time::sleep(Duration::from_millis(200)).await;
    assert_eq!(scan_requests(&t), requests, "nothing was sent");
    assert!(
        t.desk
            .cases()
            .iter()
            .find(|c| c["id"] == spec["id"])
            .is_some_and(|c| c.get("result").is_none())
    );
    let context = t.desk.context();
    assert!(
        t.desk
            .send(
                json!({"kind": "scan", "context": context, "case": "not-a-case", "draft": {
                "profile": {"kind": "name", "name": "Production guardrails"},
                "prompt": "x", "response": "", "appName": "Desktop examples"}})
            )
            .await
            .is_err()
    );
    // The result and pack survive a restart; an export carries neither.
    let mut t = t.restart().await;
    t.desk.open_library().await;
    let kept = t
        .desk
        .cases()
        .into_iter()
        context: &ContextRef,
        id: &str,
        to: &TenantId,
    ) -> Result<CopyEffects, Refusal> {
        let tenant = self.check_context(context)?;
        if to == &tenant || self.tenant(to).is_none() {
            return Err(Refusal::InvalidInput);
        }
        let source = self.library_mut(&tenant)?;
        let stamp = source.status;
        let Some(mut copy) = source.library.cases.iter().find(|c| c.id == id).cloned() else {
            source.problem = Some(CaseProblem::Missing);
            return Err(Refusal::InvalidInput);
        };
        copy.id = crate::library::new_id().ok_or(Refusal::Busy)?;
        copy.tenant = to.as_str().to_owned();
        // A result is this tenant's run, never the copy's (C33).
        copy.result = None;
        let label = self
            .tenant(to)
            .map(|t| t.profile.label.clone())
            .unwrap_or_default();
        let load = self.start_library(to);
        let destination = self
            .libraries
            .iter_mut()
            .find(|l| &l.tenant == to)
            .ok_or(Refusal::Busy)?;
        let notice = LibraryNotice::Copied { tenant: label };
        let write = if destination.state == LibraryState::Ready {
            match destination.library.add(copy, to.as_str()) {
                Ok(()) => {
                    let write = Self::changed_library(destination);
                    destination.outcomes.push(Outcome {
                        generation: write.1,
                        origin: tenant.clone(),
                        notice,
                        stamp,
                    });
                    Some(write)
                }
                Err(problem) => {
                    if let Some(source) = self.libraries.iter_mut().find(|l| l.tenant == tenant) {
                        source.problem = Some(problem);
                    }
                    return Err(Refusal::InvalidInput);
                }
            }
        } else {
            if destination.pending.len() >= crate::library::CASE_LIMIT {
                return Err(Refusal::Busy);
            }
            destination.pending.push(Pending {
                case: copy,
                origin: tenant.clone(),
                notice,
                stamp,
            });
            None
        };
        // The source hears that the copy is done once its write succeeds.
        if let Some(source) = self.libraries.iter_mut().find(|l| l.tenant == tenant) {
            source.problem = None;
            source.notice = None;
        }
        Ok((write, load))
    }

    /// The export of the active tenant's cases, for the save sheet.
    pub(super) fn export_cases(
        &mut self,
        context: &ContextRef,
    ) -> Result<(u64, String, Vec<u8>), Refusal> {
        let tenant = self.check_context(context)?;
        let library = self.library_mut(&tenant)?;
        let bytes = match crate::library::export(tenant.as_str(), &library.library.cases) {
            Ok(bytes) => bytes,
            Err(problem) => {
                library.problem = Some(problem);
                return Err(Refusal::InvalidInput);
            }
        };
        let lease = self.begin_export(context, super::ExportKind::Cases)?;
        Ok((lease, crate::library::EXPORT_NAME.to_owned(), bytes))
    }

    /// A tenant's newest library to write, if `generation` is still newest.
    pub(super) fn library_write(&self, tenant: &TenantId, generation: u64) -> Option<LibraryWrite> {
        if self.storage == super::StorageHealth::Resetting {
            return None;
        }
        let library = self.libraries.iter().find(|l| {
            &l.tenant == tenant && l.generation == generation && l.state == LibraryState::Ready
        })?;
        Some(LibraryWrite {
            root: self.library_root.clone()?,
            tenant: tenant.as_str().to_owned(),
            library: library.library.clone(),
        })
    }

    pub(super) fn settle_library_write(
        &mut self,
        tenant: &TenantId,
        generation: u64,
        stored: Result<(), LibraryFailure>,
    ) {
        let Some(library) = self
            .libraries
            .iter_mut()
            .find(|l| &l.tenant == tenant && l.generation == generation)
        else {
            return;
        };
        library.unsaved = stored.err();
        // Everything this write covered now ends: saved, or not saved.
        let (done, rest): (Vec<_>, Vec<_>) = std::mem::take(&mut library.outcomes)
            .into_iter()
            .partition(|o| o.generation <= generation);
        library.outcomes = rest;
        for o in done {
            let outcome = match stored {
                Ok(()) => Ok(o.notice),
                Err(_) => Err(CaseProblem::NotSaved),
            };
            self.deliver(&o.origin, o.stamp, outcome);
        }
    }

    /// A tenant's cases as its open library holds them (C23).
    pub(super) fn open_library_cases(&self, tenant: &TenantId) -> Option<Vec<TestCase>> {
        self.libraries
            .iter()
            .find(|l| &l.tenant == tenant && l.state == LibraryState::Ready)
            .map(|l| l.library.cases.clone())
    }

    /// Applies an import's change to a tenant's open library (C23): what it
    /// returned and, when it changed the library, the generation to write.
    /// `None` when the library is not open.
    pub(super) fn change_open_library<R>(
        &mut self,
        tenant: &TenantId,
        change: impl FnOnce(&mut CaseLibrary) -> (R, bool),
    ) -> Option<(R, Option<u64>)> {
        let library = self
            .libraries
            .iter_mut()
            .find(|l| &l.tenant == tenant && l.state == LibraryState::Ready)?;
        let (result, changed) = change(&mut library.library);
        if !changed {
            return Some((result, None));
        }
        library.status += 1;
        let (_, generation) = Self::changed_library(library);
        Some((result, Some(generation)))
    }

    /// Reports a problem with a change the core made to a tenant's open
    /// library by itself (C33: a case result it had no room for).
    pub(super) fn library_problem(&mut self, tenant: &TenantId, problem: CaseProblem) {
        if let Some(library) = self
            .libraries
            .iter_mut()
            .find(|l| &l.tenant == tenant && l.state == LibraryState::Ready)
        {
            library.problem = Some(problem);
        }
    }

