allback.current = onDisplayed\n+    useEffect(() => {\n+        displayCallback.current?.(record ? { record, history: fromHistory !== null } : null)\n+    }, [record, fromHistory])\n+    const formatted = useMemo(() => shown?.preview != null ? prettyJson(shown.preview) : null, [shown?.preview])\n \n     const save = async () => {\n         if (!record) return\n@@ -123,7 +131,7 @@ export function ResponsePane({ run, running, review, call, historyKey, onApply,\n     ))\n     const head = record ? (\n         <>\n-            <span\n+            {!onDisplayed ? <><span\n                 className='inline-flex items-center rounded-[6px] font-bold'\n                 style={{\n                     gap: 4,\n@@ -137,7 +145,7 @@ export function ResponsePane({ run, running, review, call, historyKey, onApply,\n                 {tone(record).text}\n             </span>\n             <span style={soft}>{elapsedText(record.elapsedMs)}</span>\n-            <span style={soft}>{sizeText(record.bytes)}</span>\n+            <span style={soft}>{sizeText(record.bytes)}</span></> : null}\n             <span className='ml-auto truncate text-[12px]' style={faint}>\n                 {fromHistory ? `${requestName(record.relative)} · ${clockOf(record.at)}` : clockOf(record.at)}\n             </span>\n@@ -330,12 +338,7 @@ export function ResponsePane({ run, running, review, call, historyKey, onApply,\n                                                 color: 'var(--v2-ink)',\n                                             }}\n                                         >\n-                                            {formatted.split('\\n').map((line, i) => (\n-                                                <span key={i} data-line=''>\n-                                                    {line}\n-                                                    {'\\n'}\n-                                                </span>\n-                                            ))}\n+                                            <JsonText text={formatted} numbered />\n                                         </pre>\n                                     ) : (\n                                         <pre\n@@ -438,6 +441,18 @@ function History({ call, revision, onShow }: { call: WorkbenchCall; revision: st\n     const [runs, setRuns] = useState<RunRecord[]>([])\n     const [more, setMore] = useState(false)\n     const [message, setMessage] = useState('')\n+    const generation = useRef(0)\n+    useEffect(() => {\n+        generation.current += 1\n+        return () => { generation.current += 1 }\n+    }, [revision])\n+    const show = async (id: string) => {\n+        const asked = ++generation.current\n+        const x = await call({ kind: 'showRun', run: id })\n+        if (asked !== generation.current) return\n+        if (x.kind === 'ran') onShow(x.run)\n+        else setMessage(resultText(x) ?? '')\n+    }\n     useEffect(() => {\n         let live = true\n         void call({ kind: 'history', before: null }).then((r) => {\n@@ -483,12 +498,7 @@ function History({ call, revision, onShow }: { call: WorkbenchCall; revision: st\n                             <button\n                                 type='button'\n                                 aria-label={summary}\n-                                onClick={() =>\n-                                    void call({ kind: 'showRun', run: r.id }).then((x) => {\n-                                        if (x.kind === 'ran') onShow(x.run)\n-                                        else setMessage(resultText(x) ?? '')\n-                                    })\n-                                }\n+                                onClick={() => void show(r.id)}\n                                 className='flex w-full min-h-0 items-center rounded-[8px] border text-left'\n                                 style={{\n                                     gap: 10,\nimport { describe, expect, it } from 'vitest'\nimport { prettyJson } from './request-rows'\n\ndescribe('API JSON presentation preserves JSON tokens', () => {\n    it('indents without rounding large numbers or rewriting string escapes', () => {\n        const raw = '{\"integer\":9007199254740993,\"decimal\":1.2300e+50,\"escaped\":\"\\\\u0061\\\\/\",\"duplicate\":1,\"duplicate\":2}'\n        const shown = prettyJson(raw)\n        expect(shown).toContain('9007199254740993')\n        expect(shown).toContain('1.2300e+50')\n        expect(shown).toContain('\"\\\\u0061\\\\/\"')\n        expect(shown?.match(/\"duplicate\"/g)).toHaveLength(2)\n        expect(raw).toBe('{\"integer\":9007199254740993,\"decimal\":1.2300e+50,\"escaped\":\"\\\\u0061\\\\/\",\"duplicate\":1,\"duplicate\":2}')\n    })\n\n    it('rejects invalid or truncated JSON instead of presenting a repaired response', () => {\n        for (const raw of ['', '  \\n', '{\"x\":', '{\"x\":1,}', 'true false', '[1,', '{\"x\":\"unterminated']) expect(prettyJson(raw)).toBeNull()\n    })\n\n    it('formats empty/nested containers and primitive values without changing their tokens', () => {\n        expect(prettyJson('[{},[],true,false,null,-0,1e3,\"a b\"]')).toBe('[\\n  {},\\n  [],\\n  true,\\n  false,\\n  null,\\n  -0,\\n  1e3,\\n  \"a b\"\\n]')\n        expect(prettyJson('  \"\\\\u0061\"  ')).toBe('\"\\\\u0061\"')\n    })\n\n    it('falls back to raw presentation for excessively large or deeply nested previews', () => {\n        expect(prettyJson(JSON.stringify('x'.repeat(256 * 1024)))).toBeNull()\n        expect(prettyJson('['.repeat(65) + '0' + ']'.repeat(65))).toBeNull()\n    })\n})\n","exit_code":0,"status":"completed"}}
