{"type":"item.completed","item":{"id":"item_26","type":"command_execution","command":"/bin/zsh -lc \"sed -n '674,832p' tools/p11/proof.py; sed -n '1,94p' tools/p10/candidate.py; sed -n '1,145p' tools/p10/qualification.py\"","aggregated_output":"def verify_coverage(root, qualified, historical=None):\n    \"\"\"P11 check selection plus the unchanged generic test/native consumer.\"\"\"\n    if 'review_remediation' in qualified:\n        import remediation\n        return remediation.verify_coverage(root, qualified, historical=historical)\n    if 'impact_selection' in qualified:\n        return verify_impact_coverage(root, qualified, historical=historical)\n    if 'check_selection' not in qualified:\n        source = historical.source(qualified['source_inventory_sha256']) if historical else root\n        verify_plan(source, read(bound(root, qualified['plan'])))\n        require(all(row['disposition'] == 'executed' for row in qualified['coverage']),\n                'changed P11 coverage was not executed')\n        return coverage.verify(root, qualified, historical=historical)\n    candidate = read(bound(root, qualified['candidate']))\n    source = historical.source(qualified['source_inventory_sha256']) if historical else root\n    check_source = read(bound(root, qualified['check_source']))\n    require(digest(check_source['files']) == qualified['source_inventory_sha256'],\n            'check selection source does not bind qualified source')\n    selection = validate_check_selection(root, bound(root, qualified['check_selection']),\n        candidate['runner_inputs'], source=source,\n        files=check_source['files'] if historical else None)\n    require(qualified['check_source'] == selection['selection']['current_source'],\n            'check selection source reference differs')\n    require(selection['selection']['execution_root'] == candidate['execution_root'],\n            'check selection original execution root differs from candidate')\n    selected = {'check:' + row['needed']['label']: row for row in selection['selected']\n                if not row['needed']['label'].startswith('setup/')}\n    plan = read(bound(root, qualified['plan']))\n    verify_plan(source, plan, {cid: row['disposition'] for cid, row in selected.items()})\n    rows = qualified['coverage']\n    require(len(rows) == len(plan['requirements']) and {r['id'] for r in rows}\n            == {r['id'] for r in plan['requirements']}, 'check coverage membership differs')\n    for row in rows:\n        if row['id'] not in selected:\n            continue\n        chosen = selected[row['id']]\n        raw, actual, path = chosen['raw'], chosen['actual'], chosen['path']\n        result = read(bound(root, row['result']))\n        require(row['disposition'] == chosen['disposition'] and result == {\n            'status': 'pass', 'exit_code': 0, 'execution_id': raw['run_id'],\n            'argv': actual['argv'], 'cwd': selection['selection']['execution_root'],\n            'started_utc': raw['started_utc'], 'finished_utc': raw['finished_utc'],\n            'required_ids': [row['id']], 'log': reference(root, path.parent / actual['log']),\n            'candidate': qualified['candidate'], 'raw': reference(root, path),\n            'original_runner_inputs': raw['inputs_before'],\n            'reason': chosen['reason'], 'evidence': {}}, 'check result changed original execution binding')\n    runtime_plan = read(bound(root, qualified['runtime_plan']))\n    require(runtime_plan == dict(plan, requirements=[r for r in plan['requirements'] if r['id'] not in selected]),\n            'runtime plan does not match test/native subset')\n    runtime = dict(qualified, plan=qualified['runtime_plan'],\n                   coverage=[row for row in rows if row['id'] not in selected])\n    require(all(row['disposition'] == 'executed' for row in runtime['coverage']),\n            'changed P11 test/native coverage was not executed')\n    result = coverage.verify(root, runtime, historical=historical)\n    result['required'] += len(selected)\n    for row in selected.values():\n        mode = row['disposition']\n        result['dispositions'][mode] = result['dispositions'].get(mode, 0) + 1\n    return result\n\n\ndef verify(root, path):\n    record = read(path)\n    require(record['schema'] == 'airs-desktop/p11-shared-qualification/1', 'P11 proof schema')\n    require(set(record['runner_inputs']) == {'source', 'dependencies', 'build_flags'},\n            'P11 runner input keys differ')\n    require(record['runner_inputs']['source'] == xtask_source(root),\n            'current source does not match actual runner source fingerprint')\n    seal = read(bound(root, record['source']))\n    require(source_inventory(root) == seal['files'], 'P11 source changed after qualification')\n    qualified = read(bound(root, record['coverage']))\n    require(digest(seal['files']) == qualified['source_inventory_sha256'], 'P11 source binding')\n    if 'review_remediation' in record:\n        require(qualified.get('review_remediation') == record['review_remediation'],\n                'review remediation qualification binding differs')\n    elif 'helper_source_carry' in record:\n        validate_helper_source_carry(root, bound(root, record['helper_source_carry']), record['runner_inputs'])\n    elif 'impact_selection' in record:\n        validate_impact_selection(root, bound(root, record['impact_selection']), record['runner_inputs'])\n    else:\n        for kind in ('check', 'test'):\n            validate_run(root, bound(root, record['runs'][kind]), kind, record['runner_inputs'])\n    inputs = read(bound(root, record['fingerprint']))\n    require(record['runner_inputs'] == {key: inputs[key] for key in record['runner_inputs']},\n            'P11 observed current fingerprint mismatch')\n    current = current_fingerprints(root)\n    require(record['runner_inputs'] == {key: current[key] for key in record['runner_inputs']},\n            'current dependency/toolchain/build flags differ from executed checks')\n    result = verify_coverage(root, qualified)\n    candidate = read(bound(root, qualified['candidate']))\n    from candidate import verify_candidate\n    verify_candidate(root, candidate)\n    performed = read(bound(root, record['native_execution']))\n    if 'review_remediation' in record:\n        remedy = read(bound(root, record['review_remediation']))\n        recovery = read(bound(root, remedy['recovery']))\n        require(record['native_execution'] == recovery['raw']\n                and candidate['helper_closure'] == recovery['helper_closure'],\n                'affected recovery helper/execution membership changed')\n    else:\n        require(candidate['helper_closure'] == helper_closure(root, native_driver(root, performed)),\n                'P11 native helper membership changed')\n        validate_execution(root, performed, candidate,\n            acceptance=bound(root, record['native_acceptance']) if 'native_acceptance' in record else None,\n            execution=bound(root, record['native_execution']))\n    build_path = bound(root, record['build'])\n    build = read(build_path)\n    require(build['application_inputs_unchanged'] is True\n            and all(step['exit_code'] == 0 for step in build['steps']), 'fixture build failed/drifted')\n    if 'review_remediation' in record:\n        import remediation\n        remediation.versioned_build(root, build, candidate)\n    else:\n        require([step['argv'] for step in build['steps']] == [\n            ['pnpm', '--filter', '@prisma-airs/desktop-contracts', 'typecheck'],\n            ['pnpm', '--filter', '@prisma-airs/desktop', 'typecheck'],\n            ['cargo', 'run', '--locked', '-p', 'xtask', '--', 'native-prepare', '--phase', 'P11',\n             '--target', 'aarch64-apple-darwin', '--features', 'test-fixtures']],\n            'missing or changed fixture build invocation')\n    require(set(build['application_inputs_before']) == application_files(root),\n            'built application input membership differs or is incomplete')\n    require(read(build_path.parent / 'native-prepare.json') == read(bound(root, candidate['prepare'])),\n            'prepared candidate differs from retained actual build output')\n    for step in build['steps']:\n        log = (build_path.parent / step['log']).resolve()\n        require(log.is_relative_to(root.resolve()) and sha(log) == step['log_sha256'],\n                'fixture build log drift')\n    changed = [name for name, value in build['application_inputs_before'].items()\n               if sha(root / name) != value]\n    if changed:\n        carry_schema = read(bound(root, record['build_input_carry']))['schema']\n        if carry_schema == 'airs-desktop/rust-test-build-carry/1':\n            rust_test_carry(root, record, build_path, build, candidate, changed)\n        else:\n            frontend_test_carry(root, record, build_path, build, candidate, changed)\n    else:\n        require('build_input_carry' not in record, 'unnecessary or stale build carry')\n    baseline = read(bound(root, record['historical_baseline']))\n    require(record['historical_baseline']['path'] == 'docs/planning/evidence/P10/completion-proof.json'\n            and baseline['schema'] == 'airs-desktop/p10-completion-proof/1', 'missing accepted baseline')\n    from review_gate import release_prerequisites\n    require(record['historical_standing'] == release_prerequisites(root),\n            'actual historical standing drift')\n    return {'record': str(path.relative_to(root)), 'sha256': sha(path),\n            'verified': result, 'candidate_sha256': qualified['candidate']['sha256'],\n            'controller_complete': False}\n\n\ndef make(root, check, tests, fingerprint, prepare, native, execution, build, out,\n         carry=None, impact=None, helper_carry=None):\n    \"\"\"Bind existing executions; never create a passing raw run or verdict.\"\"\"\n    require(not out.exists(), 'preserve previous P11 qualification')\n    require((root / 'tools/native-acceptance/acceptance_p11.py').is_file(),\n            'P11 native driver missing')\n    inputs = read(fingerprint)\n    runner_inputs = {key: inputs[key] for key in ('source', 'dependencies', 'build_flags')}\n    reuse = validate_helper_source_carry(root, helper_carry, runner_inputs) if helper_carry else None\n    selection = reuse['selection'] if reuse else validate_impact_selection(root, impact, runner_inputs) if impact else None\n    if reuse:\n\"\"\"Candidate/source bindings shared by C45 qualification and actual reviews.\"\"\"\nfrom pathlib import Path\nimport ast\nimport os\nimport stat\nimport sys\nsys.path.insert(0,str(Path(__file__).resolve().parents[1]/'p09'))\nfrom phase_packet import source_inventory, file_identity, digest\nfrom qualification import read, sha, require\n\n\ndef bundle_hash(bundle):\n    entries=[]\n    for base, directories, files in os.walk(bundle,followlinks=False):\n        symlinks=[name for name in directories if (Path(base)/name).is_symlink()]\n        directories[:]=[name for name in directories if name not in symlinks]\n        for name in files+symlinks:\n            path=Path(base)/name;relative=str(path.relative_to(bundle))\n            if path.is_symlink():mode='symlink';value=__import__('hashlib').sha256(os.readlink(path).encode()).hexdigest()\n            else:mode='100755' if path.stat().st_mode & 0o111 else '100644';value=sha(path)\n            entries.append((relative,mode,value))\n    text=''.join(f'{name}\\0{mode}\\0{value}\\n' for name,mode,value in sorted(entries))\n    return __import__('hashlib').sha256(text.encode()).hexdigest()\n\n\ndef helper_closure(root, driver):\n    folder=root/'tools/native-acceptance';pending=[driver];seen=set()\n    while pending:\n        name=pending.pop()\n        if name in seen or not (folder/(name+'.py')).is_file():continue\n        seen.add(name);tree=ast.parse((folder/(name+'.py')).read_text())\n        for node in ast.walk(tree):\n            if isinstance(node,ast.Import):pending.extend(alias.name.split('.')[0] for alias in node.names)\n            elif isinstance(node,ast.ImportFrom) and node.module:pending.append(node.module.split('.')[0])\n    paths=['tools/native-acceptance/'+name+'.py' for name in seen]\n    # Native compiled helpers/servers are used through literal paths, not imports.\n    paths += [str(p.relative_to(root)) for p in folder.iterdir() if p.suffix in ['.swift','.js']]\n    paths += ['tools/p10/native.py','tools/p10/candidate.py','docs/planning/evidence/P09/native-controller/native_requirements.py']\n    return {name:sha(root/name) for name in sorted(set(paths))}\n\n\ndef verify_source(root, seal):\n    expected=read(root/seal)['files']\n    require(source_inventory(root)==expected,'sealed source membership/content changed')\n    return digest(expected)\n\n\ndef verify_candidate(root, value, historical=None):\n    prepared=read(root/value['prepare']['path'])\n    require(sha(root/value['prepare']['path'])==value['prepare']['sha256'],'preparation drift')\n    bundle=historical.application(value) if historical else root/prepared['bundle']\n    require(sha(bundle/'Contents/MacOS/prisma-airs-desktop')==value['executable_sha256']==prepared['executable_sha256'],'candidate executable drift')\n    require(bundle_hash(bundle)==value['bundle_sha256']==prepared['bundle_sha256'],'complete candidate bundle drift')\n    helper_root=historical.source(value['source_inventory_sha256']) if historical else root\n    for name,value_hash in value['helper_closure'].items():require(sha(helper_root/name)==value_hash,'candidate helper drift: '+name)\n    if value.get('build_origin'):\n        import platform\n        origin=value['build_origin'];path=root/origin['record']\n        require(sha(path)==origin['sha256'],'build origin proof drift')\n        audit=verify_build_reuse(root,read(path),value['runner_inputs'],platform.platform(),platform.node(),historical=historical)\n        require(audit==origin['audit'],'build reuse audit drift')\n    return value\n\n# Explicit helper/provenance-only transition after the baseline02 startup smoke.\n# No application/config/dependency path is permitted. Old raw build and failed\n# smoke remain immutable; this is not a new execution of that build.\nBUILD_REUSE_PATHS = {\n    'tools/p10/historical.py','tools/p10/test_historical.py',\n    'tools/p10/provenance_followup.py','tools/p10/qualification.py',\n    'tools/p10/review_gate.py','tools/p10/followup.py',\n    'crates/xtask/tests/controlled_live.rs',\n    'crates/xtask/tests/live_run/common.rs',\n    'crates/xtask/examples/c45_baseline.rs',\n    'tools/p10/packet.py','tools/p10/followup.py','tools/p10/test_followup.py',\n    'tools/native-acceptance/acceptance_c04.py',\n    'tools/native-acceptance/test_c04_current_frame.py',\n    'tools/native-acceptance/acceptance_c45.py',\n    'tools/p10/candidate.py', 'tools/p10/test_build_reuse.py',\n    'tools/p10/supervise.py', 'tools/p10/seal.py',\n    'tools/p10/finalize.py', 'tools/p10/native.py',\n    'apps/desktop/src-tauri/tests/permission_manifest.rs',\n    'tools/p10/continuation.py', 'tools/p10/test_continuation.py',\n    'tools/native-acceptance/acceptance_c32_current.py',\n    'tools/native-acceptance/test_c32_project_path.py',\n}\n\n\ndef verify_build_reuse(root, record, current_identity, platform_name, hostname, historical=None):\n    from qualification import bound\n    from stages import verify_completed\n    require(record['schema']=='airs-desktop/c45-helper-only-build-reuse/1','build reuse schema')\n    old=read(bound(root,record['original_candidate']))\n    before=read(bound(root,record['original_source']))['files']\n    after=read(bound(root,record['current_source']))['files']\n\"\"\"Explicit C45/P10 evidence accounting. Does not execute checks or assign scores.\n\nThe existing runners produce raw records; this consumer rejects omitted coverage,\nchanged evidence, unsupported retirement and affected checks carried as unchanged.\nHistorical results always retain their original candidate and execution bindings.\n\"\"\"\nfrom pathlib import Path\nimport hashlib\nimport json\n\n\ndef require(value, message):\n    if not value:\n        raise ValueError(message)\n\n\ndef read(path):\n    return json.loads(Path(path).read_text())\n\n\ndef sha(path):\n    return hashlib.sha256(Path(path).read_bytes()).hexdigest()\n\n\ndef digest(value):\n    return hashlib.sha256((json.dumps(value, sort_keys=True, separators=(\",\", \":\")) + \"\\n\").encode()).hexdigest()\n\n\ndef bound(root, reference):\n    path = root / reference[\"path\"]\n    require(path.resolve().is_relative_to(root.resolve()), \"evidence escapes checkout\")\n    require(sha(path) == reference[\"sha256\"], \"evidence hash drift: \" + str(path))\n    return path\n\n\nEXACT_FIELDS = (\"executable_sha256\", \"bundle_sha256\", \"build_flags\", \"conditions\")\n\n\ndef verify_raw(root, needed, execution, origin):\n    require(execution[\"argv\"] == needed[\"argv\"], \"execution command differs from approved plan\")\n    require(execution[\"cwd\"] == origin[\"execution_root\"], \"execution cwd differs from original candidate\")\n    raw_path = bound(root, execution[\"raw\"])\n    raw = read(raw_path)\n    if needed[\"kind\"] == \"native\":\n        require(raw[\"schema\"] == \"airs-v2/native-acceptance/1\" and raw[\"app\"][\"executable_sha256\"] == origin[\"executable_sha256\"], \"raw native candidate mismatch\")\n        checks = [check for check in raw[\"checks\"] if check[\"id\"] == needed[\"id\"]]\n        require(len(checks) == 1 and checks[0][\"result\"] == \"pass\" and checks[0].get(\"observation\") and checks[0].get(\"evidence\"), \"raw native assertion not passing\")\n        for name in checks[0][\"evidence\"]:\n            require(name in execution[\"evidence\"], \"native evidence missing from execution inventory\")\n            bound(root, {\"path\":name,\"sha256\":execution[\"evidence\"][name]})\n    elif needed[\"kind\"] == \"command\":\n        require(raw[\"schema\"] == \"airs-v2/run/1\" and raw[\"status\"] == \"passed\" and raw[\"failure\"] is None and raw[\"inputs_before\"] == raw[\"inputs_after\"], \"raw runner failed or inputs changed\")\n        require(raw[\"inputs_before\"] == origin[\"runner_inputs\"], \"runner input fingerprint does not bind original candidate\")\n        commands = [command for command in raw[\"commands\"] if command[\"label\"] == needed[\"label\"]]\n        require(len(commands) == 1, \"raw runner command missing/duplicated\")\n        command = commands[0]\n        require(command[\"status\"] == \"passed\" and command[\"exit_code\"] == 0 and command[\"argv\"] == needed[\"argv\"] and command[\"cwd\"] in [\".\", origin[\"execution_root\"]] and not command[\"note\"], \"raw runner command failed/differs\")\n        require(command[\"output_sha256\"] == execution[\"log\"][\"sha256\"] and str((raw_path.parent/command[\"log\"]).relative_to(root)) == execution[\"log\"][\"path\"], \"raw runner log binding\")\n        if needed.get(\"expects_tests\"):\n            require(command[\"tests\"] and command[\"tests\"][\"passed\"] > 0 and command[\"tests\"][\"failed\"] == 0, \"test command did not execute passing tests\")\n    else:\n        raise ValueError(\"unsupported required raw execution kind\")\n\n\ndef verify(root, record, historical=None):\n    require(record[\"schema\"] == \"airs-desktop/qualified-coverage/1\", \"coverage schema\")\n    plan = read(bound(root, record[\"plan\"]))\n    require(plan[\"schema\"] == \"airs-desktop/required-coverage/1\", \"plan schema\")\n    requirements = plan[\"requirements\"]\n    ids = [item[\"id\"] for item in requirements]\n    require(len(ids) == len(set(ids)) and ids, \"duplicate/empty required coverage\")\n    rows = record[\"coverage\"]\n    require(len(rows) == len(ids) and {r[\"id\"] for r in rows} == set(ids), \"missing/duplicate/unknown coverage\")\n    by_id = {item[\"id\"]: item for item in requirements}\n    candidate = read(bound(root, record[\"candidate\"]))\n    require(all(candidate.get(k) for k in EXACT_FIELDS) and candidate.get(\"helper_closure\"), \"candidate binding incomplete\")\n    require(candidate.get(\"source_inventory_sha256\") == record[\"source_inventory_sha256\"], \"candidate source binding\")\n    for row in rows:\n        needed = by_id[row[\"id\"]]\n        mode = row[\"disposition\"]\n        require(mode in [\"executed\", \"reused_exact\", \"carried_unaffected\", \"not_applicable\"], \"unsupported coverage disposition\")\n        if mode == \"not_applicable\":\n            decision = needed.get(\"retirement\")\n            require(decision and row.get(\"reason\") and row.get(\"decision\") == decision, \"unapproved assertion retirement\")\n            bound(root, decision)\n            continue\n        original = read(bound(root, row[\"result\"]))\n        require(original.get(\"status\") == \"pass\" and original.get(\"exit_code\") == 0, \"result is not an actual passing execution\")\n        require(original.get(\"execution_id\") and original.get(\"argv\") and original.get(\"cwd\") and original.get(\"started_utc\") and original.get(\"finished_utc\"), \"execution provenance missing\")\n        require(row[\"id\"] in original.get(\"required_ids\", []), \"result does not cover required assertion\")\n        bound(root, original[\"log\"])\n        origin = read(bound(root, original[\"candidate\"]))\n        require(all(origin.get(k) for k in EXACT_FIELDS) and origin.get(\"helper_closure\"), \"original candidate binding incomplete\")\n        verify_raw(root, needed, original, origin)\n        if mode in [\"executed\", \"reused_exact\"]:\n            if mode == \"reused_exact\":\n                require(not needed.get(\"must_execute\", needed.get(\"affected\", True)), \"changed check must execute\")\n            helpers = needed.get(\"helper_paths\")\n            if helpers is None:\n                require(origin[\"helper_closure\"] == candidate[\"helper_closure\"], \"relevant helper closure differs\")\n            else:\n                require(all(name in origin[\"helper_closure\"] and name in candidate[\"helper_closure\"] and origin[\"helper_closure\"][name] == candidate[\"helper_closure\"][name] for name in helpers), \"relevant helper closure differs\")\n            require(all(origin[k] == candidate[k] for k in EXACT_FIELDS), \"artifact/helper/flags/conditions differ\")\n            if mode == \"executed\":\n                require(origin[\"source_inventory_sha256\"] == record[\"source_inventory_sha256\"], \"execution is historical, not current\")\n        else:\n            require(not needed.get(\"affected\", True), \"affected check cannot be carried unchanged\")\n            rationale = row.get(\"impact\")\n            require(rationale and rationale.get(\"reason\") and rationale.get(\"dependencies\") == needed.get(\"dependencies\") and rationale.get(\"original_candidate_sha256\") == original[\"candidate\"][\"sha256\"], \"unchanged-impact proof missing\")\n            proof = read(bound(root, rationale[\"proof\"]))\n            bindings = proof.get(\"file_bindings\", {})\n            require(set(bindings) == set(needed[\"dependencies\"]) and bindings, \"dependency membership proof missing\")\n            current_files=historical.source(record['source_inventory_sha256']) if historical else root\n            original_files=historical.source(origin['source_inventory_sha256']) if historical else root\n            for dependency, binding in bindings.items():\n                require(binding[\"original_sha256\"] == binding[\"current_sha256\"] == sha(current_files/dependency), \"dependency changed: \" + dependency)\n                original_source = original_files/dependency if historical else bound(root, binding[\"original_file\"])\n                require(sha(original_source) == binding[\"original_sha256\"], \"original dependency proof mismatch\")\n            require(proof.get(\"unchanged_dependencies\") == needed[\"dependencies\"] and proof.get(\"current_source_inventory_sha256\") == record[\"source_inventory_sha256\"] and proof.get(\"original_candidate_sha256\") == original[\"candidate\"][\"sha256\"], \"impact proof does not bind current and original inputs\")\n    return {\"qualified\": True, \"required\": len(ids), \"dispositions\": {m: sum(r[\"disposition\"] == m for r in rows) for m in sorted({r[\"disposition\"] for r in rows})}, \"candidate_sha256\": record[\"candidate\"][\"sha256\"], \"source_inventory_sha256\": record[\"source_inventory_sha256\"]}\n","exit_code":0,"status":"completed"}}
