{"type":"item.completed","item":{"id":"item_43","type":"command_execution","command":"/bin/zsh -lc \"sed -n '1,185p' tools/p10/review_gate.py; rg -n 'C48|P11|C49|C46' crates/xtask/src; cat tools/p11/standing.py\"","aggregated_output":"\"\"\"Read-only actual-review proof checks for C45/P10 and production prerequisites.\n\nNo score assignment, evidence execution, controller completion or release action.\n\"\"\"\nfrom pathlib import Path\nimport json\nimport sys\n\nsys.path.insert(0, str(Path(__file__).resolve().parent))\nsys.path.insert(0, str(Path(__file__).resolve().parents[1] / \"p09\"))\nfrom phase_packet import file_identity, digest, validate\nfrom phase_inputs import full_gate, require, read, sha, REVIEW_DISABLED\n\n\ndef transport(root, out, request):\n    invocation = read(out/\"invocation.json\")\n    require(invocation[\"request_sha256\"] == sha(out/\"request.json\"), \"transport request drift\")\n    schema_path = root/request.get(\"schema_archive\", \"docs/architecture/review-verdict.schema.json\")\n    require(invocation[\"schema_sha256\"] == sha(schema_path), \"transport schema drift\")\n    args = invocation[\"command_without_prompt\"]\n    require(args[0] == \"codex\" and args.count(\"exec\") == 1, \"not fresh Codex exec\")\n    for flag in [\"--no-daemon\", \"--ephemeral\", \"--ignore-user-config\", \"--ignore-rules\", \"--json\"]:\n        require(args.count(flag) == 1, \"transport isolation \" + flag)\n    for flag, value in [(\"-a\", \"never\"), (\"-s\", \"read-only\"), (\"-m\", \"gpt-6.1-sol\")]:\n        require(args.count(flag) == 1 and args[args.index(flag)+1] == value, \"transport isolation argument \" + flag)\n    require(args.count(\"--output-schema\") == 1 and args[args.index(\"--output-schema\")+1] == \"docs/architecture/review-verdict.schema.json\", \"transport output schema\")\n    expected_out = Path(request.get(\"execution_root\", root))/\"docs/planning/reviews\"/request[\"subject\"]/request[\"attempt_id\"]/\"verdict-returned.json\"\n    require(args.count(\"-o\") == 1 and args[args.index(\"-o\")+1] == str(expected_out), \"transport output path\")\n    require(invocation[\"model_requested\"] == \"gpt-6.1-sol\", \"configured review model changed\")\n    require(not any(\"dangerously\" in arg or arg in [\"resume\", \"fork\", \"--last\", \"--approve-for-me\"] for arg in args), \"review resume/bypass\")\n    disabled = [args[i+1] for i,a in enumerate(args) if a == \"--disable\"]\n    require(set(disabled) == REVIEW_DISABLED and len(disabled) == len(REVIEW_DISABLED), \"restricted review features\")\n    overrides = [args[i+1] for i,a in enumerate(args) if a == \"-c\"]\n    require(set(overrides) == {'web_search=\"disabled\"', 'model_reasoning_effort=\"xhigh\"'} and len(overrides) == 2, \"review overrides\")\n    require(invocation[\"feature_probe_sha256\"] == sha(out/\"feature-probe.log\"), \"feature probe drift\")\n    observed = {line.split()[0]:line.split()[-1] for line in (out/\"feature-probe.log\").read_text().splitlines() if len(line.split()) >= 3}\n    require(all(observed.get(k) == invocation[\"restricted_features_observed\"].get(k) == \"false\" for k in REVIEW_DISABLED), \"feature isolation not observed\")\n    messages=[];sessions=[]\n    for line in (out/\"thread-reply.log\").read_text().splitlines():\n        try:event=json.loads(line)\n        except json.JSONDecodeError:continue\n        if not isinstance(event,dict):continue\n        item=event.get(\"item\",{})\n        if not isinstance(item,dict):item={}\n        require(event.get(\"type\") not in [\"hook.started\",\"hook.completed\"] and item.get(\"type\") not in [\"mcp_tool_call\",\"hook_execution\"], \"unexpected review side effect\")\n        if event.get(\"type\") == \"thread.started\":sessions.append(event.get(\"thread_id\"))\n        if event.get(\"type\") == \"item.completed\" and item.get(\"type\") in [\"agent_message\",\"assistant_message\"]:messages.append(item.get(\"text\",\"\"))\n    require(len(sessions) == 1 and messages and json.loads(messages[-1]) == read(out/\"verdict-returned.json\"), \"actual independent returned verdict missing/mismatched\")\n    return dict(invocation_sha256=sha(out/\"invocation.json\"),thread_reply_sha256=sha(out/\"thread-reply.log\"),feature_probe_sha256=sha(out/\"feature-probe.log\"),reviewer_sessions_observed=sessions)\n\n\ndef actual_review(root, subject, attempt, source_root=None, evidence=True):\n    out=root/\"docs/planning/reviews\"/subject/attempt\n    request=read(out/\"request.json\"); verdict=read(out/\"verdict-returned.json\")\n    schema_path=(root/request[\"schema_archive\"] if request.get(\"schema_archive\")\n                 else (source_root or root)/\"docs/architecture/review-verdict.schema.json\")\n    # Historical P09 schema is preserved independently of future descriptions.\n    if subject == \"P09\":schema_path=root/\"docs/planning/evidence/C45/activation-20261102-g11/p09-source/docs/architecture/review-verdict.schema.json\"\n    validate(verdict,read(schema_path))\n    require(verdict[\"subject\"] == subject and request[\"subject\"] == subject and verdict[\"attempt_id\"] == request[\"attempt_id\"] == attempt and verdict[\"request_id\"] == request[\"request_id\"] and verdict[\"fingerprints\"] == request[\"fingerprints\"], \"actual verdict request/fingerprint binding\")\n    full_gate(verdict)\n    # Preserve request bytes: the archive path is verification context, never an edit.\n    transport_request=dict(request)\n    # A later schema description must not change an archived review's input.\n    # Supply verification context only; request/invocation bytes stay immutable.\n    if source_root is not None:\n        transport_request[\"schema_archive\"]=str(schema_path.relative_to(root))\n    if subject == \"P09\":\n        transport_request[\"schema_archive\"]=str(schema_path.relative_to(root))\n        transport_request[\"execution_root\"]=read(root/\"docs/planning/evidence/C45/activation-20261102-g11/p09-proof.json\")[\"source_checkout\"]\n    observed=transport(root,out,transport_request)\n    audit=read(out/\"post-review-audit.json\");receipt=read(out/\"receipt.json\")\n    require(audit[\"full_gate_pass\"] is True and receipt[\"full_gate_pass\"] is True and receipt[\"source_frozen\"] is True, \"actual full-gate audit missing\")\n    for record in [audit,receipt]:\n        require(record[\"request_sha256\"] == sha(out/\"request.json\") and record.get(\"raw_verdict_sha256\",record.get(\"verdict_sha256\")) == sha(out/\"verdict-returned.json\") and record[\"scores\"] == verdict[\"scores\"], \"review audit/receipt binding\")\n    require(receipt[\"post_review_audit_sha256\"] == sha(out/\"post-review-audit.json\") and receipt[\"fingerprints\"] == verdict[\"fingerprints\"], \"receipt audit/fingerprints\")\n    require(receipt[\"invocation_sha256\"] == observed[\"invocation_sha256\"] and receipt[\"thread_reply_sha256\"] == observed[\"thread_reply_sha256\"], \"receipt transport binding\")\n    for name,key,base in [(\"source-inventory.json\",\"source\",source_root or root),(\"evidence-inventory.json\",\"evidence\",root)]:\n        inventory=read(out/name)[\"files\"]\n        require(digest(inventory) == request[\"fingerprints\"][key], \"inventory fingerprint mismatch\")\n        if evidence or key == \"source\":\n            locations = read(root/\"docs/planning/evidence/C45/activation-20261102-g11/p09-extra-evidence/locations.json\") if subject == \"P09\" and key == \"evidence\" else {}\n            for relative,identity in inventory.items():\n                path = root/locations[relative] if relative in locations else base/relative\n                require(file_identity(path) == identity, \"reviewed input drift: \" + relative)\n    return dict(subject=subject,attempt=attempt,request_sha256=sha(out/\"request.json\"),verdict_sha256=sha(out/\"verdict-returned.json\"),audit_sha256=sha(out/\"post-review-audit.json\"),receipt_sha256=sha(out/\"receipt.json\"),scores=verdict[\"scores\"],fingerprints=verdict[\"fingerprints\"])\n\n\ndef release_prerequisites(root):\n    archive=root/\"docs/planning/evidence/C45/activation-20261102-g11/p09-source\"\n    p09=actual_review(root,\"P09\",\"attempt-02\",archive)\n    standing=read(root/\"docs/planning/evidence/P10/completion-proof.json\")\n    require(standing[\"schema\"] == \"airs-desktop/p10-completion-proof/1\" and standing[\"p09\"] == p09,\"P09 prerequisite binding\")\n    # P10's exact reviewed source is archived on completion. Later C26 release\n    # implementation gets its own checks/review; it does not relabel P10 inputs.\n    archived=root/standing[\"source_archive\"]\n    require(archived.resolve().is_relative_to((root/\"docs/planning/evidence/P10\").resolve()),\"P10 archive escapes evidence\")\n    p10=actual_review(root,\"P10\",standing[\"attempt\"],archived)\n    require(standing[\"p10\"] == p10,\"P10 completion proof binding\")\n    c45=actual_review(root,\"C45\",standing[\"c45\"][\"attempt\"],root/standing[\"c45_source_archive\"])\n    require(standing[\"c45\"] == c45,\"C45 member proof binding\")\n    from packet import qualification\n    from historical import Historical\n    historical=Historical(root,standing[\"historical_context\"])\n    qualified=qualification(root,root/standing[\"qualification\"][\"record\"],current=False,historical=historical)\n    request=read(root/\"docs/planning/reviews/P10\"/standing[\"attempt\"]/\"request.json\")\n    require(qualified == standing[\"qualification\"] == request[\"qualification\"] and request[\"predecessors\"][\"C45\"] == c45,\"P10 qualified candidate/member binding\")\n    return {\"p09\":p09,\"p10\":p10,\"c45\":c45,\"controller_complete\":False,\"c26_required_here\":False}\n\n\nif __name__ == \"__main__\":\n    require(len(sys.argv) == 2 and sys.argv[1] == \"release-prerequisites\", \"usage: review_gate.py release-prerequisites\")\n    print(json.dumps(release_prerequisites(Path.cwd().resolve()),indent=2))\ncrates/xtask/src/cli.rs:104:                _ => Err(invalid(\"--chunk expects C01-C49\")),\ncrates/xtask/src/cli.rs:108:                _ => Err(invalid(\"--phase expects P01-P11\")),\ncrates/xtask/src/package.rs:71:/// P09/P10/P11 actual independent phase proofs supplement the existing C01-C25\ncrates/xtask/src/package.rs:96:            \"release requires genuine archived P11 member and phase proofs: {}\",\ncrates/xtask/src/manifest.rs:156:            return Err(invalid(\"checks.json must define exactly C01-C49\"));\ncrates/xtask/src/manifest.rs:196:            return Err(invalid(\"phases must partition C01-C49 in order\"));\ncrates/xtask/src/manifest.rs:199:        if self.phases.get(\"P11\") != Some(&refinements) {\ncrates/xtask/src/manifest.rs:201:                \"P11 must contain exactly C46-C49; historical phases cannot absorb refinement chunks\",\ncrates/xtask/src/manifest.rs:456:    /// P11 selects and deduplicates its four members' affected checks/tests.\ncrates/xtask/src/manifest.rs:616:        // Captured from the pre-P11 controller with the same native-map bytes.\ncrates/xtask/src/manifest.rs:631:        let phase = Subject::parse(\"P11\").expect(\"registered P11\");\ncrates/xtask/src/manifest.rs:632:        let checks = manifest.plan(phase, RunKind::Check).expect(\"P11 checks\");\ncrates/xtask/src/manifest.rs:633:        let tests = manifest.plan(phase, RunKind::Test).expect(\"P11 tests\");\ncrates/xtask/src/manifest.rs:634:        assert!(checks.iter().any(|c| c.label.starts_with(\"C46/\")));\ncrates/xtask/src/manifest.rs:643:                    [\"C46/\", \"C47/\", \"C48/\", \"C49/\"]\ncrates/xtask/src/manifest.rs:668:            [\"C46\", \"C47\", \"C48\", \"C49\"]\ncrates/xtask/src/manifest.rs:705:        missing[\"chunks\"][\"C46\"]\ncrates/xtask/src/manifest.rs:717:            invalid[\"chunks\"][\"C46\"][\"check_commands\"] = argv;\ncrates/xtask/src/manifest.rs:725:        wrong_phase[\"phases\"][\"P10\"] = json!([\"C45\", \"C46\"]);\ncrates/xtask/src/manifest.rs:726:        wrong_phase[\"phases\"][\"P11\"] = json!([\"C47\", \"C48\", \"C49\"]);\ncrates/xtask/src/manifest.rs:737:            .get_mut(\"C46\")\ncrates/xtask/src/manifest.rs:738:            .expect(\"C46\")\ncrates/xtask/src/subject.rs:1://! Validated review subjects through the P11 refinement phase (D063).\ncrates/xtask/src/subject.rs:47:            \"not a valid chunk (C01-C49) or phase (P01-P11): {text:?}\"\ncrates/xtask/src/subject.rs:77:        assert_eq!(Subject::parse(\"C49\").expect(\"C49\"), Subject::Chunk(49));\ncrates/xtask/src/subject.rs:78:        assert_eq!(Subject::parse(\"P11\").expect(\"P11\"), Subject::Phase(11));\n\"\"\"Durable, audited P11 standing for later production promotion.\n\nFinalization consumes completed executions and five real full-9 reviews. It\nnever assigns a score or completes a controller ledger. Historical validation\nuses the archived source/application, not this checkout's ignored target tree,\ninstalled application, toolchain, hostname, or current application source.\n\"\"\"\nfrom pathlib import Path\nimport json\nimport shutil\nimport subprocess\nimport sys\n\nsys.path.insert(0, str(Path(__file__).resolve().parent))\nsys.path.insert(0, str(Path(__file__).resolve().parents[1] / 'p10'))\nfrom candidate import bundle_hash, digest, file_identity\nfrom historical import Historical\nfrom qualification import bound, read, require, sha, verify as verify_coverage\nfrom review_gate import actual_review, release_prerequisites\n\nCHUNKS = ('C46', 'C47', 'C48', 'C49')\nSUBJECTS = (*CHUNKS, 'P11')\nBASE = Path('docs/planning/evidence/P11')\nACCEPTED = BASE / 'accepted'\nCOMPLETION = BASE / 'completion-proof.json'\nD2_SOURCE = BASE / 'source-history/D2'\nS2_SOURCE = BASE / 'source-history/S2'\nS3_SOURCE = BASE / 'source-history/S3'\nS4_SOURCE = BASE / 'source-history/S4'\nS4_APPLICATION = BASE / 'review-carry-baseline-01/application'\nLFS_PATHS = (str(S4_SOURCE / 'resources/harness/darwin-arm64.tar.gz'),\n             str(S4_APPLICATION / 'Contents/MacOS/prisma-airs-desktop'),\n             str(S4_APPLICATION / 'Contents/Resources/harness/airs-harness'),\n             str(S3_SOURCE / 'resources/harness/darwin-arm64.tar.gz'),\n             str(S2_SOURCE / 'resources/harness/darwin-arm64.tar.gz'),\n             str(D2_SOURCE / 'resources/harness/darwin-arm64.tar.gz'),\n             str(ACCEPTED / 'application/Contents/MacOS/prisma-airs-desktop'),\n             str(ACCEPTED / 'application/Contents/Resources/harness/airs-harness'),\n             str(ACCEPTED / 'source/resources/harness/darwin-arm64.tar.gz'))\n\n\nclass ArchivedP11(Historical):\n    \"\"\"Explicit P11 archive context; historical C45 behavior is untouched.\"\"\"\n    def archive_path(self, name):\n        path = self.root / name\n        require(path.resolve().is_relative_to((self.root / ACCEPTED).resolve())\n                or path.resolve() in ((self.root / D2_SOURCE).resolve(), (self.root / S2_SOURCE).resolve(), (self.root / S3_SOURCE).resolve(),\n                (self.root / S4_SOURCE).resolve(), (self.root / S4_APPLICATION).resolve()),\n                'historical archive escapes accepted P11 evidence')\n        return path\n\n\ndef reference(root, path):\n    root = Path(root).resolve()\n    path = Path(path).resolve(strict=True)\n    require(path.is_relative_to(root.resolve()), 'P11 reference escapes checkout')\n    return {'path': str(path.relative_to(root)), 'sha256': sha(path)}\n\n\ndef identities(root, paths):\n    return {str(path.relative_to(root)): file_identity(path) for path in sorted(set(paths))}\n\n\ndef evidence_files(root, attempts):\n    paths = [p for p in (root / BASE).rglob('*')\n             if (p.is_file() or p.is_symlink()) and not p.is_relative_to(root / ACCEPTED)\n             and p != root / COMPLETION and '__pycache__' not in p.parts]\n    for subject, attempt in attempts.items():\n        paths.extend(p for p in (root / 'docs/planning/reviews' / subject / attempt).rglob('*')\n                     if (p.is_file() or p.is_symlink()) and '__pycache__' not in p.parts)\n    return paths\n\n\ndef latest_attempt(root, subject):\n    attempts = [p.name for p in (root / 'docs/planning/reviews' / subject).glob('attempt-*')\n                if p.is_dir() and p.name.removeprefix('attempt-').isdigit()]\n    require(attempts, 'missing actual P11 member/phase review: ' + subject)\n    return max(attempts, key=lambda name: int(name.removeprefix('attempt-')))\n\n\ndef require_archive_lfs(root):\n    result = subprocess.run(['/usr/bin/git', 'check-attr', '-z', 'filter', '--', *LFS_PATHS],\n                            cwd=root, capture_output=True, check=True)\n    fields = result.stdout.decode().strip('\\0').split('\\0')\n    require(len(fields) == len(LFS_PATHS) * 3\n            and all(fields[i:i+3] == [name, 'filter', 'lfs'] for i, name in zip(range(0, len(fields), 3), LFS_PATHS)),\n            'configure reviewed P11 archive Git LFS paths before finalization')\n\n\ndef audited_reviews(root, attempts, qualified, source):\n    root = Path(root).resolve()\n    require(set(attempts) == set(SUBJECTS), 'P11 requires exactly four member reviews and its phase review')\n    phase = read(root / 'docs/planning/reviews/P11' / attempts['P11'] / 'request.json')\n    carry = None\n    if 'review_carry' in phase:\n        import review_carry\n        carry = review_carry.validate(root, bound(root, phase['review_carry']), qualified, source_root=source)\n    reviews = {}\n    for subject in SUBJECTS:\n        attempt = attempts[subject]\n        require(attempt == latest_attempt(root, subject), 'newer review attempt exists: ' + subject)\n        request = read(root / 'docs/planning/reviews' / subject / attempt / 'request.json')\n        if carry and subject in carry['members']:\n            reviews[subject] = carry['members'][subject]\n            require(attempt == reviews[subject]['attempt'], 'carried original member attempt changed')\n        else:\n            require(request['qualification'] == qualified,\n                    ('current C48/phase qualification differs: ' if carry else\n                     'P11 reviews do not bind one shared qualification: ') + subject)\n            reviews[subject] = actual_review(root, subject, attempt, source_root=source)\n        require(all(value >= 9 for value in reviews[subject]['scores'].values()),\n                'P11 promotion requires full-9 reviewed standing: ' + subject)\n    require(phase['predecessors']['members'] == {name: reviews[name] for name in CHUNKS},\n            'phase review did not consume these exact four audited member reviews')\n    if carry:\n        require(phase['predecessors']['member_review_carry'] == carry['proof']\n                and phase['predecessors']['member_dispositions'] == {\n                    name: 'carried_unaffected' if name in carry['members'] else 'executed' for name in CHUNKS},\n                'phase lost explicit mixed-member qualification proof')\n    else:\n        require(all(row['fingerprints']['source'] == qualified['verified']['source_inventory_sha256']\n                    for row in reviews.values()), 'reviews bind a foreign qualified source')\n    return reviews\n\n\ndef verify(root):\n    \"\"\"Verify immutable historical standing; no current build directory needed.\"\"\"\n    root = Path(root).resolve()\n    path = root / COMPLETION\n    require(path.is_file(), 'P11 promotion requires actual accepted standing: ' + str(COMPLETION))\n    record = read(path)\n    require(record['schema'] == 'airs-desktop/p11-completion-proof/1'\n            and record['controller_complete'] is False, 'P11 standing schema/controller claim')\n    require(record['context']['path'] == str(ACCEPTED / 'historical-context.json'),\n            'P11 standing context is foreign')\n    history = ArchivedP11(root, record['context'])\n    qualified = record['qualification']\n    original = read(bound(root, {'path': qualified['record'], 'sha256': qualified['sha256']}))\n    require(original['schema'] == 'airs-desktop/p11-shared-qualification/1', 'foreign P11 qualification')\n    coverage = read(bound(root, original['coverage']))\n    source_hash = coverage['source_inventory_sha256']\n    source = history.source(source_hash)\n    seal = read(bound(root, original['source']))\n    require(digest(seal['files']) == source_hash, 'original P11 source seal differs')\n    import proof\n    result = proof.verify_coverage(root, coverage, historical=history)\n    require(result == qualified['verified'], 'archived P11 raw qualification differs')\n    candidate = read(bound(root, coverage['candidate']))\n    from candidate import verify_candidate\n    verify_candidate(root, candidate, historical=history)\n    require(coverage['candidate']['sha256'] == qualified['candidate_sha256'],\n            'P11 accepted candidate reference differs')\n    if 'review_remediation' not in original:\n        proof.validate_execution(root, read(bound(root, original['native_execution'])), candidate,\n            acceptance=bound(root, original['native_acceptance']) if 'native_acceptance' in original else None,\n            execution=bound(root, original['native_execution']))\n    inventory = read(bound(root, record['evidence']))['files']\n    require(inventory, 'P11 raw evidence inventory missing')\n    require(set(inventory) == {str(p.relative_to(root)) for p in evidence_files(root, record['attempts'])},\n            'P11 retained evidence membership differs')\n    for name, identity in inventory.items():\n        target = root / name\n        require(target.resolve().is_relative_to(root), 'P11 evidence escapes checkout')\n        require(file_identity(target) == identity,\n                'P11 retained evidence drift (hydrate pinned LFS objects if needed): ' + name)\n    reviews = audited_reviews(root, record['attempts'], qualified, source)\n    require(reviews == record['reviews'], 'P11 audited review standing changed')\n    baseline = release_prerequisites(root)\n    require(record['historical_standing'] == original['historical_standing'] == baseline,\n            'P11 historical baseline standing differs')\n    return {'schema': 'airs-desktop/p11-promotion-prerequisites/1',\n            'record': str(COMPLETION), 'sha256': sha(path),\n            'qualification': qualified, 'reviews': reviews, 'controller_complete': False}\n\n\ndef finalize(root, qualification_path, attempts):\n    \"\"\"Archive only after actual reviews; refuse every existing output path.\n\n    Large files under accepted/application and accepted/source/resources/harness\n    must have their reviewed explicit Git LFS rules before the qualified seal.\n    This function never runs a test, native driver, build, signing or publication.\n    \"\"\"\n    root = Path(root).resolve()\n    destination, completion = root / ACCEPTED, root / COMPLETION\n    require(not destination.exists() and not completion.exists(), 'preserve existing accepted P11 archive')\n    require_archive_lfs(root)\n    import proof\n    qualified = proof.verify(root, Path(qualification_path).resolve())\n    reviews = audited_reviews(root, attempts, qualified, root)\n    original = read(root / qualified['record'])\n    seal = read(bound(root, original['source']))\n    coverage = read(bound(root, original['coverage']))\n    candidate = read(bound(root, coverage['candidate']))\n    prepared = read(bound(root, candidate['prepare']))\n    evidence = identities(root, evidence_files(root, attempts))\n    destination.mkdir(parents=True, exist_ok=False)\n\n    def write(name, value):\n        path = destination / name\n        with path.open('x') as stream:\n            json.dump(value, stream, indent=2)\n            stream.write('\\n')\n        return reference(root, path)\n\n    source = destination / 'source'\n    source.mkdir()\n    for name, identity in seal['files'].items():\n        original_file, archived = root / name, source / name\n        require(original_file.resolve().is_relative_to(root) or original_file.is_symlink(),\n                'source path escapes checkout')\n        require(archived.resolve().is_relative_to(source), 'source archive path escapes destination')\n        archived.parent.mkdir(parents=True, exist_ok=True)\n        if identity['kind'] == 'symlink':\n            archived.symlink_to(identity['target'])\n        else:\n            shutil.copy2(original_file, archived)\n        require(file_identity(archived) == identity, 'source changed while archiving: ' + name)\n    application = destination / 'application'\n    shutil.copytree(root / prepared['bundle'], application, symlinks=True)\n    require(bundle_hash(application) == candidate['bundle_sha256'], 'application changed while archiving')\n    source_seal = write('source-seal.json', seal)\n    sources = {coverage['source_inventory_sha256']: {\n        'path': str(source.relative_to(root)), 'seal': source_seal}}\n    if 'impact_selection' in original:\n        impact = read(bound(root, original['impact_selection']))\n        baseline = read(bound(root, impact['baseline_source']))\n        sources[digest(baseline['files'])] = {\n            'path': str(D2_SOURCE), 'seal': impact['baseline_source']}\n    if 'helper_source_carry' in original:\n        helper = read(bound(root, original['helper_source_carry']))\n        baseline = read(bound(root, helper['baseline_source']))\n        sources[digest(baseline['files'])] = {\n            'path': str(S2_SOURCE), 'seal': helper['baseline_source']}\n    if 'review_remediation' in original:\n        remedy = read(bound(root, original['review_remediation']))\n        prior = read(bound(root, remedy['historical_context']))\n        for fingerprint, value in prior['sources'].items():\n            require(fingerprint not in sources or sources[fingerprint] == value,\n                    'remediation historical source conflicts with accepted source')\n            sources[fingerprint] = value\n    applications = {candidate['bundle_sha256']: {\n        'path': str(application.relative_to(root)), 'executable_sha256': candidate['executable_sha256']}}\n    phase = read(root / 'docs/planning/reviews/P11' / attempts['P11'] / 'request.json')\n    if 'review_carry' in phase:\n        carry = read(bound(root, phase['review_carry']))\n        old_source = read(bound(root, carry['original_source']))\n        sources[digest(old_source['files'])] = {'path': str(S4_SOURCE), 'seal': carry['original_source']}\n        old_q = read(bound(root, {'path': carry['original_qualification']['record'],\n                                 'sha256': carry['original_qualification']['sha256']}))\n        old_coverage = read(bound(root, old_q['coverage']))\n        old_candidate = read(bound(root, old_coverage['candidate']))\n        applications[old_candidate['bundle_sha256']] = {\n            'path': str(S4_APPLICATION), 'executable_sha256': old_candidate['executable_sha256']}\n    context = write('historical-context.json', {\n        'schema': 'airs-desktop/historical-qualification-context/1',\n        'sources': sources,\n        'applications': applications})\n    evidence_ref = write('evidence-inventory.json', {'files': evidence})\n    record = {'schema': 'airs-desktop/p11-completion-proof/1',\n              'qualification': qualified, 'attempts': attempts, 'reviews': reviews,\n              'context': context, 'evidence': evidence_ref,\n              'historical_standing': original['historical_standing'],\n              'controller_complete': False,\n              'meaning': ('Actual full-nine C48/current phase plus explicitly carried original qualification03 C46/C47/C49 full-nine reviews. No old review is relabelled current. ' if 'review_carry' in phase else 'Actual audited full-nine members and phase on one qualification. ') + 'Historical sources, candidates, artifacts and raw outcomes remain bound; no controller ledger or production acceptance is claimed.'}\n    with completion.open('x') as stream:\n        json.dump(record, stream, indent=2)\n        stream.write('\\n')\n    return verify(root)\n\n\nif __name__ == '__main__':\n    require(sys.argv[1:] == ['release-prerequisites'],\n            'usage: standing.py release-prerequisites; finalize is an explicit API after actual reviews')\n    print(json.dumps(verify(Path.cwd()), indent=2))\n","exit_code":0,"status":"completed"}}
