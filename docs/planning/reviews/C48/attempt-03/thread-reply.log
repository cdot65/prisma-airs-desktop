{"type":"item.completed","item":{"id":"item_39","type":"command_execution","command":"/bin/zsh -lc \"sed -n '690,865p' crates/desktop-core/src/authority/workbench_domain.rs; sed -n '1410,1505p' crates/desktop-core/src/authority/workbench_domain.rs; sed -n '258,307p' apps/desktop/src-tauri/src/adapters.rs; cat apps/desktop/src/v2/workbench/calls-panel.tsx\"","aggregated_output":"                .iter()\n                .filter_map(|id| {\n                    let doc = o.documents.get(id);\n                    let (relative, method, new) = match (doc, o.entry(id)) {\n                        (Some(d), _) => (\n                            d.relative.clone(),\n                            o.data.drafts.get(id).map_or_else(\n                                || d.saved.method.clone(),\n                                |dr| dr.fields.method.clone(),\n                            ),\n                            d.new,\n                        ),\n                        (None, Some(e)) => (e.relative.clone(), e.method.clone(), false),\n                        (None, None) => return None,\n                    };\n                    Some(TabView {\n                        id: id.clone(),\n                        relative,\n                        method,\n                        draft: o.data.drafts.contains_key(id),\n                        new,\n                        recovered: o.recovered.contains(id),\n                        conflict: o.conflicts.get(id).copied(),\n                        interrupted: o.interrupted.contains(id),\n                    })\n                })\n                .collect();\n            let profile = w.profile.as_ref();\n            let mut references: BTreeSet<String> = profile\n                .map(|p| {\n                    p.secrets\n                        .iter()\n                        .filter(|(c, _)| c == &o.catalog.id)\n                        .map(|(_, r)| r.clone())\n                        .collect()\n                })\n                .unwrap_or_default();\n            let mut texts: Vec<&str> = o.data.private.values().map(String::as_str).collect();\n            let settings: Vec<String> = o\n                .documents\n                .values()\n                .map(|d| {\n                    o.data\n                        .drafts\n                        .get(&d.id)\n                        .map_or_else(|| d.saved.settings.clone(), |dr| dr.fields.settings.clone())\n                })\n                .collect();\n            texts.extend(settings.iter().map(String::as_str));\n            references.extend(environments::references(&texts));\n            references.extend(o.catalog.references.iter().cloned());\n            let secrets = references\n                .into_iter()\n                .map(|reference| SecretView {\n                    stored: profile.is_some_and(|p| {\n                        p.secrets\n                            .iter()\n                            .any(|(c, r)| c == &o.catalog.id && r == &reference)\n                    }),\n                    managed: reference.starts_with(scm::MANAGED_PREFIX),\n                    reference,\n                })\n                .collect();\n            CollectionView {\n                id: o.catalog.id.clone(),\n                name: o.catalog.name.clone(),\n                folder: folder_name(&o.root),\n                scope: profile::scope(&o.root, &o.catalog.id),\n                built_in: o.built_in,\n                complete: o.catalog.complete,\n                requests: o.catalog.requests.clone(),\n                folders: o.catalog.folders.clone(),\n                schemas: o.catalog.schemas.clone(),\n                issues: o.catalog.issues.iter().take(200).cloned().collect(),\n                environments: o.environments(),\n                environment: o.data.environment.clone(),\n                tabs,\n                selected: o.data.selected.clone(),\n                secrets,\n                unsaved: o.unsaved,\n                archives: u32::try_from(o.data.archives.len()).unwrap_or(u32::MAX),\n            }\n        });\n        WorkbenchView {\n            available: self.workbench_root.is_some(),\n            loaded: w.profile.is_some() || w.failure.is_some(),\n            failure: w.failure,\n            recent: w\n                .profile\n                .as_ref()\n                .map(|p| {\n                    // An import's collections show once it commits (D050).\n                    p.recent\n                        .iter()\n                        .enumerate()\n                        .map(|(i, r)| RecentView {\n                            index: u32::try_from(i).unwrap_or(u32::MAX),\n                            name: r.name.clone(),\n                            folder: folder_name(&r.root),\n                        })\n                        .collect()\n                })\n                .unwrap_or_default(),\n            collection,\n            import: w.import.as_ref().map(insomnia::Export::view),\n            git: w.git.clone(),\n            busy: w.calls.iter().any(|c| !c.settled && !c.later),\n            unprotected: self.workbench_unprotected(),\n            running: w.sending.running(),\n            review: w.sending.review(),\n            network: self.workbench_network,\n        }\n    }\n}\n\n// ----------------------------------------------------------------- worker\n\nasync fn blocking<T: Send + 'static>(fallback: T, f: impl FnOnce() -> T + Send + 'static) -> T {\n    tokio::task::spawn_blocking(f).await.unwrap_or(fallback)\n}\n\n/// Runs one admitted request in its turn on the lane and settles it.\npub(super) async fn run(inner: Arc<Inner>, operation: OperationId, request: WorkbenchRequest) {\n    let Some(lane) = lock(&inner).ok().map(|s| Arc::clone(&s.workbench.lane)) else {\n        return;\n    };\n    let step = {\n        let _turn = lane.lock().await;\n        match request {\n            WorkbenchRequest::Send { .. } | WorkbenchRequest::Apply { .. } => {\n                let page = lock(&inner).ok().and_then(|s| {\n                    s.workbench\n                        .calls\n                        .iter()\n                        .find(|c| c.operation == operation)\n                        .map(|c| c.page.clone())\n                });\n                match page {\n                    Some(page) => send::begin(&inner, request, page).await,\n                    None => send::Step::Done(Box::new(refused(WorkbenchProblem::Unavailable))),\n                }\n            }\n            other => send::Step::Done(Box::new(execute(&inner, other).await)),\n        }\n    };\n    let result = match step {\n        send::Step::Done(result) => *result,\n        send::Step::Later(work) => {\n            if let Ok(mut state) = lock(&inner) {\n                if let Some(call) = state\n                    .workbench\n                    .calls\n                    .iter_mut()\n                    .find(|c| c.operation == operation)\n                {\n                    call.later = true;\n                }\n                state.changed();\n            }\n            work.await\n        }\n    };\n    if let Ok(mut state) = lock(&inner) {\n        state.settle_workbench(&operation, result);\n        state.changed();\n    }\n}\n\nasync fn execute(inner: &Arc<Inner>, request: WorkbenchRequest) -> WorkbenchResult {\n    let Some(root) = inner.adapters.workbench_root.clone() else {\n        return refused(WorkbenchProblem::Unavailable);\n    };\n    let profile = match ensure_profile(inner, &root).await {\n        Ok(p) => p,\n        Err(problem) => return refused(problem),\n    };\n    inner: &Arc<Inner>,\n    root: &std::path::Path,\n    folder: PathBuf,\n    built_in: bool,\n    expected_id: Option<String>,\n) -> WorkbenchResult {\n    let keychain = Arc::clone(&inner.adapters.keychain);\n    let private = root.to_path_buf();\n    let opened = blocking(Err(WorkbenchProblem::Unavailable), move || {\n        read_opening(&private, keychain.as_ref(), &folder, expected_id.as_deref())\n    })\n    .await;\n    let opening = match opened {\n        Ok(o) => o,\n        Err(p) => return refused(p),\n    };\n    let name = opening.catalog.name.clone();\n    let recent = Recent {\n        root: opening.catalog.root.clone(),\n        id: opening.catalog.id.clone(),\n        name: name.clone(),\n    };\n    let profile = lock(inner).ok().and_then(|s| s.workbench.profile.clone());\n    if let Some(mut next) = profile {\n        next.selection = Some(if built_in {\n            Selection::BuiltIn\n        } else {\n            Selection::Custom {\n                root: recent.root.clone(),\n                id: recent.id.clone(),\n            }\n        });\n        if !built_in {\n            next.remember(recent);\n        }\n        if let Err(f) = store_profile(inner, root, next).await {\n            return refused(WorkbenchProblem::Private(f));\n        }\n    }\n    {\n        let Ok(mut state) = lock(inner) else {\n            return refused(WorkbenchProblem::Unavailable);\n        };\n        state.workbench.editing.clear();\n        state.workbench.sending.leave();\n        state.workbench.git = None;\n        state.workbench.import = None;\n        state.workbench.open = Some(Open {\n            root: opening.catalog.root.clone(),\n            recovered: opening.documents.keys().cloned().collect(),\n            scope: opening.scope,\n            built_in,\n            catalog: opening.catalog,\n            data: opening.data,\n            unsaved: None,\n            documents: opening.documents,\n            conflicts: opening.conflicts,\n            interrupted: opening.interrupted,\n        });\n    }\n    WorkbenchResult::Opened { name }\n}\n\nasync fn open_built_in(\n    inner: &Arc<Inner>,\n    root: &std::path::Path,\n    profile: Profile,\n) -> WorkbenchResult {\n    let folder = scm::folder(root);\n    let target = folder.clone();\n    let previous = profile.scm.clone();\n    let written = blocking(Err(ProjectProblem::Io), move || {\n        let _placement = crate::sessions::placement();\n        scm::refresh(&target, &previous)\n    })\n    .await;\n    let (record, _) = match written {\n        Ok(done) => done,\n        Err(p) => return refused(WorkbenchProblem::Project(p)),\n    };\n    let mut next = profile;\n    next.scm = record;\n    if let Err(f) = store_profile(inner, root, next).await {\n        return refused(WorkbenchProblem::Private(f));\n    }\n    open_at(inner, root, folder, true, None).await\n}\n\n/// Reads the collection's inventory again (after a write).\nasync fn rediscover(inner: &Arc<Inner>) {\n    let Some(folder) = collection_root(inner) else {\n        return;\n    };\n    let found = blocking(Err(ProjectProblem::Io), move || project::discover(&folder)).await;\n    if let (Ok(catalog), Ok(mut state)) = (found, lock(inner))\n        && let Some(open) = state.workbench.open.as_mut()\n    /// Save a response body under a suggested name (the panel confirms\n    /// replacing an existing file).\n    Save(String),\n}\n\nimpl<R: Runtime> NativeFolders<R> {\n    fn sheet(&self, sheet: Sheet) -> BoxFuture<'static, Option<PathBuf>> {\n        let app = self.app.clone();\n        Box::pin(async move {\n            let (tx, rx) = tokio::sync::oneshot::channel::<Option<PathBuf>>();\n            let window = app.get_webview_window(MAIN_WINDOW)?;\n            app.run_on_main_thread(move || {\n                let dialog = rfd::FileDialog::new().set_parent(&window);\n                let chosen = match sheet {\n                    Sheet::New => dialog\n                        .set_title(\"New collection\")\n                        .set_file_name(\"New collection\")\n                        .save_file(),\n                    Sheet::Open => dialog.set_title(\"Open collection\").pick_folder(),\n                    Sheet::Project => dialog.set_title(\"Choose project folder\").pick_folder(),\n                    Sheet::Save(name) => dialog\n                        .set_title(\"Save response\")\n                        .set_file_name(name)\n                        .save_file(),\n                };\n                let _ = tx.send(chosen);\n            })\n            .ok()?;\n            rx.await.ok()?\n        })\n    }\n}\n\nimpl<R: Runtime> FolderPicker for NativeFolders<R> {\n    fn choose_folder(&self) -> BoxFuture<'static, Option<PathBuf>> {\n        self.sheet(Sheet::Open)\n    }\n    fn choose_new(&self) -> BoxFuture<'static, Option<PathBuf>> {\n        self.sheet(Sheet::New)\n    }\n    fn choose_project(&self) -> BoxFuture<'static, Option<PathBuf>> {\n        self.sheet(Sheet::Project)\n    }\n    fn choose_save(&self, suggested: String) -> BoxFuture<'static, Option<PathBuf>> {\n        self.sheet(Sheet::Save(suggested))\n    }\n}\n\n/// Where the fixture driver stages Insomnia exports.\n#[cfg(feature = \"test-fixtures\")]\nimport type { CallView, ShellSnapshot } from '@prisma-airs/desktop-contracts'\nimport type { Dispatch } from '../../modules/tenants/dispatch'\nimport { CALLS_COPY as C } from './copy'\n\n/** How long a call took, as the API Client's completion says it. */\nconst durationOf = (ms: number) => (ms < 1000 ? `${ms} ms` : `${(ms / 1000).toFixed(1)} s`)\n\n/**\n * \"Show the calls\" (C33, DESIGN-V2 §3): beside every destination while the\n * Rust-owned preference is on, the calls this app made for the active\n * tenant, newest last, as the core recorded them: the request line without\n * its query, header names (never values), the credential by kind (the core\n * attached it), and the response status, duration and content type. No body\n * is ever kept. Rendered like the API Client's response line.\n */\nexport function CallsPanel({ snapshot, dispatch, onClose }: { snapshot: ShellSnapshot; dispatch: Dispatch; onClose?: () => void }) {\n    const calls = snapshot.calls\n    if (!snapshot.showCalls || calls === undefined) return null\n    return (\n        <aside aria-label={C.title} data-slot='calls-panel' className='flex min-w-0 flex-col gap-3 p-4 text-[13px]' style={{ width: '100%' }}>\n            <div className='flex items-center justify-between gap-2'>\n                <h2 className='text-[15px] font-semibold'>{C.title}</h2>\n                <button type='button' aria-label={onClose ? C.closeExplain : undefined} className='h-8 rounded-[7px] border px-3 text-[12px]' style={{ borderColor: 'var(--v2-rule)' }} onClick={() => (onClose ? onClose() : void dispatch({ kind: 'setShowCalls', on: false }))}>\n                    {onClose ? C.close : C.hide}\n                </button>\n            </div>\n            <p className='text-[12px]' style={{ color: 'var(--v2-soft)' }}>\n                {C.note}\n            </p>\n            {calls.length === 0 ? (\n                <p data-slot='calls-empty'>{C.empty}</p>\n            ) : (\n                <ol className='flex flex-col gap-2' data-slot='calls-list'>\n                    {calls.map((call) => (\n                        <CallItem key={call.sequence} call={call} />\n                    ))}\n                </ol>\n            )}\n        </aside>\n    )\n}\n\nfunction CallItem({ call }: { call: CallView }) {\n    const outcome = call.status !== null ? String(call.status) : C.failed\n    return (\n        <li className='flex flex-col gap-1 rounded-[10px] border p-3' style={{ borderColor: 'var(--v2-rule)' }} data-slot='call' data-purpose={call.purpose}>\n            <div className='flex flex-wrap items-baseline gap-x-2 text-[12px]' style={{ color: 'var(--v2-soft)' }}>\n                <span>{C.purpose[call.purpose]}</span>\n                <span>\n                    {outcome} · {durationOf(call.durationMs)}\n                </span>\n            </div>\n            <p className='break-all font-mono text-[12px]'>\n                <span className='font-semibold' style={{ color: 'var(--v2-get)' }}>\n                    {call.method}\n                </span>{' '}\n                {call.origin}\n                {call.path}\n                {call.query ? <span style={{ color: 'var(--v2-soft)' }}> ({C.query})</span> : null}\n            </p>\n            <p className='text-[12px]'>{C.credential[call.credential]}</p>\n            <details className='text-[12px]'>\n                <summary className='cursor-pointer'>\n                    {C.requestHeaders} · {C.bytes(call.requestBytes)}\n                </summary>\n                <p className='break-all font-mono'>{call.requestHeaders.join(', ')}</p>\n                <p className='mt-1' style={{ color: 'var(--v2-soft)' }}>\n                    {C.responseHeaders}\n                    {call.contentType ? ` · ${call.contentType}` : ''}\n                </p>\n                <p className='break-all font-mono'>{call.responseHeaders.join(', ')}</p>\n            </details>\n        </li>\n    )\n}\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_38","type":"command_execution","command":"/bin/zsh -lc \"rg -n 'workbench|RequestEditor|ApiClient' apps/desktop/src/v2/workbench/test-cases.tsx apps/desktop/src/shell/feature-body.tsx apps/desktop/src/shell/feature-view.tsx apps/desktop/src/v2/v2-shell.tsx; sed -n '1,140p' tools/p11/test_review_carry.py; rg -n '\"'^    def test'\"' tools/p11/test_remediation.py tools/p11/test_proof.py tools/p11/test_native.py\"","aggregated_output":"apps/desktop/src/v2/v2-shell.tsx:21:import { ApiClient } from './workbench/api-client'\napps/desktop/src/v2/v2-shell.tsx:23:import { TestCases } from './workbench/test-cases'\napps/desktop/src/v2/v2-shell.tsx:560:                            <ApiClient snapshot={snapshot} dispatch={props.dispatch} observe={observeWorkbench} />\n\"\"\"Pure review-carry adversarial fixtures; never actual review evidence.\"\"\"\nfrom pathlib import Path\nimport copy\nimport json\nimport tempfile\nimport unittest\nfrom unittest.mock import patch\n\nimport review_carry as carry\nimport review\n\n\nclass ReviewCarryTests(unittest.TestCase):\n    def setUp(self):\n        self.temp = tempfile.TemporaryDirectory()\n        self.addCleanup(self.temp.cleanup)\n        self.root = Path(self.temp.name).resolve()\n        self.name = 'apps/desktop/src/v2/workbench/api-client.tsx'\n        self.patch = patch.object(carry, 'RETRY_DELTA', {self.name: ('old', 'new')})\n        self.patch.start(); self.addCleanup(self.patch.stop)\n\n    def test_only_exact_declared_retry_delta_can_carry(self):\n        before = {self.name: {'sha256': 'old'}, 'Cargo.lock': {'sha256': 'same'}}\n        after = {self.name: {'sha256': 'new'}, 'Cargo.lock': {'sha256': 'same'}}\n        self.assertEqual(carry.impact_delta(before, after, [self.name]), [self.name])\n        for kind in ('undeclared', 'different-fix', 'unrelated-behavior', 'configuration', 'deleted'):\n            changed, declared = copy.deepcopy(after), [self.name]\n            if kind == 'undeclared': declared = []\n            elif kind == 'different-fix': changed[self.name]['sha256'] = 'other'\n            elif kind == 'unrelated-behavior':\n                changed['apps/desktop/src/v2/settings.tsx'] = {'sha256': 'other'}\n                declared = sorted([self.name, 'apps/desktop/src/v2/settings.tsx'])\n            elif kind == 'configuration':\n                changed['Cargo.lock']['sha256'] = 'other'; declared = sorted([self.name, 'Cargo.lock'])\n            else: changed.pop(self.name)\n            with self.subTest(kind=kind), self.assertRaises(ValueError):\n                carry.impact_delta(before, changed, declared)\n\n    def test_dependency_closure_keeps_all_resources_and_unmodified_consumers(self):\n        names = [self.name, 'resources/harness/pin', 'resources/another-package.bin',\n                 'apps/desktop/src/app.tsx', 'crates/desktop-core/tests/harness_tools/main.rs',\n                 'packages/desktop-contracts/src/index.ts', 'Cargo.lock']\n        selected = carry.dependencies(dict.fromkeys(names, {}))\n        self.assertNotIn(self.name, selected)\n        self.assertEqual(set(selected), set(names)-{self.name})\n        files = {n: {'sha256': 'unchanged-'+n} for n in names}\n        identities = {n: files[n] for n in selected}\n        carry.unchanged(files, files, selected, identities)\n        altered = copy.deepcopy(files); altered['resources/another-package.bin']['sha256'] = 'changed'\n        with self.assertRaises(ValueError): carry.unchanged(files, altered, selected, identities)\n        with self.assertRaises(ValueError): carry.unchanged(files, files, selected[:-1], identities)\n\n    def test_qualification_and_subject_set_are_bound(self):\n        qualified = {'record': 'fixture-current', 'verified': {'qualified': True}}\n        original = {'record': carry.OLD_QUALIFICATION, 'sha256': carry.OLD_QUALIFICATION_SHA}\n        record = {'schema': 'airs-desktop/p11-member-review-carry/1',\n                  'members': dict.fromkeys(carry.CARRIED, {}), 'current_qualification': qualified,\n                  'original_qualification': original}\n        self.assertEqual(carry.qualification_bindings(record, qualified), original)\n        for kind in ('affected-subject', 'phase-subject', 'old-qualification', 'current-qualification', 'unqualified'):\n            altered = copy.deepcopy(record)\n            if kind == 'affected-subject': altered['members']['C48'] = altered['members'].pop('C49')\n            elif kind == 'phase-subject': altered['members']['P11'] = altered['members'].pop('C49')\n            elif kind == 'old-qualification': altered['original_qualification']['sha256'] = 'foreign'\n            elif kind == 'current-qualification': altered['current_qualification']['record'] = 'foreign'\n            else: altered['current_qualification']['verified']['qualified'] = False\n            with self.subTest(kind=kind), self.assertRaises(ValueError):\n                carry.qualification_bindings(altered, qualified)\n\n    def test_original_full_nine_member_cannot_be_rescored_or_retargeted(self):\n        qualification = {'record': 'fixture-original-qualification'}\n        scores = dict.fromkeys(('architecture', 'behavior', 'authority_security', 'validation', 'overall'), 9)\n        original = {'subject': 'C46', 'attempt': 'attempt-02', 'scores': scores,\n                    'verdict_sha256': 'fixture-original-verdict'}\n        entry = {'review': original, 'reason': 'Pure validator fixture: scoped C48-only retry change.'}\n        folder = self.root/'docs/planning/reviews/C46/attempt-02'; folder.mkdir(parents=True)\n        request = {'subject': 'C46', 'qualification': qualification}\n        def save(value): (folder/'request.json').write_text(json.dumps(value))\n        save(request)\n        with patch.object(carry, 'actual_review', return_value=original) as actual:\n            self.assertEqual(carry.member(self.root, 'C46', entry, qualification, self.root/'old-source'), original)\n            self.assertFalse(actual.call_args.kwargs['evidence'])\n        for kind in ('C48', 'P11', 'wrong-subject', 'wrong-qualification', 'changed-original', 'score-eight'):\n            altered, outcome, subject = copy.deepcopy(entry), copy.deepcopy(original), 'C46'; save(request)\n            if kind in ('C48', 'P11'): subject = kind\n            elif kind == 'wrong-subject': altered['review']['subject'] = 'C47'\n            elif kind == 'wrong-qualification': save(dict(request, qualification={'record': 'foreign'}))\n            elif kind == 'changed-original': outcome['verdict_sha256'] = 'changed'\n            else: altered['review']['scores']['overall'] = outcome['scores']['overall'] = 8\n            with self.subTest(kind=kind), patch.object(carry, 'actual_review', return_value=outcome), self.assertRaises(ValueError):\n                carry.member(self.root, subject, altered, qualification, self.root/'old-source')\n\n    def test_phase_packet_describes_mixed_original_members_without_retagging(self):\n        # Temporary metadata-only fixture; no actual review/qualification is fabricated.\n        folder = self.root/'docs/planning/evidence/P11'; folder.mkdir(parents=True)\n        qualified = {'record': 'fixture-qualified', 'meaning': 'pure validator fixture'}\n        qualification = self.root/'qualification.json'\n        qualification.write_text(json.dumps({'runner_inputs': {'dependencies': 'fixture', 'build_flags': 'fixture'}}))\n        carry_path = self.root/'carry.json'; carry_path.write_text('pure validator fixture')\n        with patch.object(review.proof, 'verify', return_value=qualified), \\\n             patch.object(review, 'predecessors', return_value={'meaning': 'pure predecessor fixture'}), \\\n             patch.object(review.proof, 'source_inventory', return_value={}), \\\n             patch.object(review.subprocess, 'run'):\n            request = review.make(self.root, 'P11', 'attempt-01', qualification, review_carry=carry_path)\n        message = (self.root/'docs/planning/reviews/P11/attempt-01/message.txt').read_text()\n        self.assertEqual(request['review_carry'], review.proof.reference(self.root, carry_path))\n        self.assertIn('qualification03', request['limitations'][1])\n        self.assertIn('three explicitly carried original qualification03', message)\n        self.assertIn('do not relabel those members current', message)\n\n\nif __name__ == '__main__':\n    unittest.main()\ntools/p11/test_native.py:104:    def test_failed_process_can_contribute_only_its_completed_assertion(self):\ntools/p11/test_native.py:119:    def test_helper_and_candidate_drift_cannot_reuse_completed_assertion(self):\ntools/p11/test_native.py:128:    def test_capture_and_admission_proofs_are_bound_without_live_state_reads(self):\ntools/p11/test_native.py:139:    def test_manifest_consumer_survives_fresh_clone_without_app_or_current_host(self):\ntools/p11/test_native.py:150:    def test_three_real_process_origins_retain_five_completed_rows(self):\ntools/p11/test_native.py:199:    def test_positive_selector_preserves_failed_measurement_explicitly(self):\ntools/p11/test_native.py:208:    def test_repaired_keyboard_fact_binds_retained_matrix_and_all_old_pixels(self):\ntools/p11/test_native.py:237:    def test_state_artifact_helper_and_process_drift_fail_before_ui(self):\ntools/p11/test_remediation.py:38:    def test_delta_requires_every_exact_reviewed_pair_and_rejects_other_production(self):\ntools/p11/test_remediation.py:63:    def test_dependencies_include_all_resources_and_exclude_only_pinned_scope_changes(self):\ntools/p11/test_remediation.py:95:    def test_preserved_bundle_rejects_changed_tar_even_when_rebound_and_wrong_identity(self):\ntools/p11/test_remediation.py:120:    def test_source_selection_requires_original_producers_and_bounded_source_hashes(self):\ntools/p11/test_remediation.py:165:    def test_versioned_build_preserves_canonical_output_and_exact_fixture_recipe(self):\ntools/p11/test_remedi