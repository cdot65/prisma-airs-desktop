{"type":"item.completed","item":{"id":"item_50","type":"command_execution","command":"/bin/zsh -lc \"sed -n '1,185p' tools/native-acceptance/test_acceptance_p11_api.py; sed -n '220,260p' apps/desktop/src/v2/workbench/api-client.test.tsx; sed -n '1,90p' crates/xtask/examples/p11_native_candidate.rs; git status --short\"","aggregated_output":"\"\"\"Pure replay of native AX evidence; never launches apps or endpoints.\"\"\"\nimport argparse\nimport copy\nimport hashlib\nimport json\nfrom pathlib import Path\nimport unittest\n\nimport acceptance_p11_api as api\n\nRAW_TREE = Path('docs/planning/evidence/P11/native-attempt-06-vm/failure-tree.json')\n\nclass App:\n    def __init__(self, tree): self.value = tree\n    def wait_for(self, predicate, timeout): return self.value, bool(predicate(self.value))\n    @staticmethod\n    def has_text(tree, text): return any(text in str(n.get('label') or '') or text in str(n.get('value') or '') for n in tree)\n\nclass Context:\n    def __init__(self, tree): self.app = App(tree); self.state = {}; self.saved = []\n    def save(self, name, value): self.saved.append((name, value)); return 'new-attempt/' + name + '.json'\n    @staticmethod\n    def require(condition, message):\n        if not condition: raise RuntimeError(message)\n\nclass FooterReplay(unittest.TestCase):\n    @classmethod\n    def setUpClass(cls): cls.tree = json.loads(RAW_TREE.read_text())\n\n    def test_captured_split_footer_names_current_record(self):\n        self.assertIs(api._metrics(Context(self.tree), 'My request', 200), self.tree)\n\n    def test_wrong_request_is_not_accepted(self):\n        with self.assertRaises(RuntimeError): api._metrics(Context(self.tree), 'Other request', 200)\n\n    def test_wrong_status_is_not_accepted(self):\n        with self.assertRaises(RuntimeError): api._metrics(Context(self.tree), 'My request', 201)\n\n    def test_current_record_is_not_history(self):\n        with self.assertRaises(RuntimeError): api._metrics(Context(self.tree), 'My request', 200, True)\n\n    def test_history_prefix_keeps_its_own_binding(self):\n        tree = copy.deepcopy(self.tree)\n        node = next(n for n in tree if n.get('label') == 'My request')\n        node['label'] = node['value'] = 'History · My request'\n        self.assertIs(api._metrics(Context(tree), 'My request', 200, True), tree)\n        with self.assertRaises(RuntimeError): api._metrics(Context(tree), 'My request', 200, False)\n\n    def test_status_from_another_region_cannot_satisfy_name(self):\n        tree = [\n            {'depth': 0, 'subrole': 'AXApplicationStatus'},\n            {'depth': 1, 'label': 'My request'},\n            {'depth': 1, 'label': ' · '},\n            {'depth': 1, 'label': '201'},\n            {'depth': 0, 'subrole': 'AXApplicationStatus'},\n            {'depth': 1, 'label': 'Other request · 15:23'},\n            {'depth': 1, 'label': '200 OK'},\n        ]\n        with self.assertRaises(RuntimeError): api._metrics(Context(tree), 'My request', 200)\n        self.assertIs(api._metrics(Context(tree), 'My request', 201), tree)\n\nclass FirstUseCarry(unittest.TestCase):\n    def setUp(self):\n        observations = RAW_TREE.parent / 'observations.json'\n        evidence = RAW_TREE.parent / 'c48-first-use.json'\n        self.binding = {kind: {'path': path.as_posix(), 'sha256': hashlib.sha256(path.read_bytes()).hexdigest()}\n                        for kind, path in [('observations', observations), ('evidence', evidence)]}\n        original = json.loads(observations.read_text())\n        self.ctx = Context([])\n        self.ctx.prepared = {key: original[key] for key in ('executable_sha256', 'bundle_sha256')}\n\n    def test_actual_first_use_keeps_original_provenance(self):\n        passed, local = api._prior_first_use(self.ctx, self.binding)\n        self.assertTrue(passed)\n        self.assertEqual(local, 'new-attempt/c48-first-use-carry.json')\n        carry = self.ctx.saved[-1][1]\n        self.assertEqual(carry['observations'], self.binding['observations'])\n        self.assertEqual(carry['evidence'], self.binding['evidence'])\n        self.assertEqual(carry['original']['execution_id'], RAW_TREE.parent.name)\n        self.assertIn('not a new first-use execution', carry['meaning'])\n\n    def test_hash_drift_is_rejected(self):\n        self.binding['evidence']['sha256'] = '0' * 64\n        with self.assertRaises(RuntimeError): api._prior_first_use(self.ctx, self.binding)\n        self.assertEqual(self.ctx.saved, [])\n\n    def test_other_application_artifact_is_rejected(self):\n        self.ctx.prepared['executable_sha256'] = '0' * 64\n        with self.assertRaises(RuntimeError): api._prior_first_use(self.ctx, self.binding)\n        self.assertEqual(self.ctx.saved, [])\n\n    def test_non_first_use_tree_is_rejected(self):\n        self.binding['evidence'] = {'path': RAW_TREE.as_posix(), 'sha256': hashlib.sha256(RAW_TREE.read_bytes()).hexdigest()}\n        with self.assertRaises(RuntimeError): api._prior_first_use(self.ctx, self.binding)\n        self.assertEqual(self.ctx.saved, [])\n\n    def test_escape_reference_is_rejected(self):\n        self.binding['evidence']['path'] = '../not-P11-evidence.json'\n        with self.assertRaises(RuntimeError): api._prior_first_use(self.ctx, self.binding)\n        self.assertEqual(self.ctx.saved, [])\n\nif __name__ == '__main__':\n    parser = argparse.ArgumentParser()\n    parser.add_argument('--tree', type=Path, default=RAW_TREE)\n    args, remaining = parser.parse_known_args()\n    RAW_TREE = args.tree\n    unittest.main(argv=[__file__, *remaining])\nconst document_ = () => globalThis.document\n\ndescribe('C41 API Client board', () => {\n    it('colors one complete editable URL template without duplicating its base variable', async () => {\n        const url = '{{scm_base}}/profiles/{{profile_id}}?value=hello%20world'\n        const { requests, user, line } = await open(board(), (r) => r.kind === 'openRequest' ? document({ url }) : null)\n        const input = within(line()).getByRole('textbox', { name: 'URL' })\n        expect(input).toHaveValue(url)\n        const template = input.closest('[data-slot=\"template-input\"]') as HTMLElement\n        expect(template).not.toBeNull()\n        expect(template.querySelectorAll('[data-variable]')).toHaveLength(2)\n        expect(template.textContent).toBe(url)\n        await user.click(input)\n        await user.keyboard('{Control>}a{/Control}')\n        await user.copy()\n        expect(await navigator.clipboard.readText()).toBe(url)\n        await user.keyboard('{Meta>}s{/Meta}')\n        await waitFor(() => expect(requests.filter((r) => r.kind === 'save')).toHaveLength(1))\n        expect(requests.filter((r) => r.kind === 'save')[0]).toMatchObject({ fields: { url } })\n        await user.click(within(line()).getByRole('button', { name: 'Send' }))\n        expect(requests.filter((r) => r.kind === 'send').at(-1)).toMatchObject({ fields: { url } })\n    })\n\n    it('colors JSON while Save, Send, response Copy and Save Response keep the original text and run', async () => {\n        const raw = '{\\r\\n \"integer\":9007199254740993,\"escaped\":\"\\\\u0061\\\\/\"\\r\\n}\\r\\n'\n        const response = { ...ran, preview: raw, previewBytes: raw.length, record: { ...ran.record, bytes: raw.length } }\n        const { user, requests, line } = await open(board(), (r) => r.kind === 'openRequest' ? document({ bodyKind: 'json', body: raw }) : r.kind === 'send' ? { kind: 'ran', run: response } : r.kind === 'saveResponse' ? { kind: 'responseSaved', bytes: raw.length, name: 'chosen.json' } : null)\n        await user.click(within(screen.getByRole('tablist', { name: 'Request' })).getByRole('tab', { name: /^Body/ }))\n        const body = screen.getByRole('textbox', { name: 'Body' })\n        const colored = body.closest('[data-slot=\"json-body-editor\"]') as HTMLElement\n        expect(colored.querySelector('[data-json-token*=\"propertyName\"]')).not.toBeNull()\n        await user.click(within(line()).getByRole('button', { name: 'Save' }))\n        await waitFor(() => expect(requests.filter((r) => r.kind === 'save')).toHaveLength(1))\n        expect(requests.filter((r) => r.kind === 'save').at(-1)).toMatchObject({ fields: { body: raw } })\n        await user.click(within(line()).getByRole('button', { name: 'Send' }))\n        await waitFor(() => expect(requests.filter((r) => r.kind === 'send')).toHaveLength(1))\n        expect(requests.filter((r) => r.kind === 'send').at(-1)).toMatchObject({ fields: { body: raw } })\n        const pane = screen.getByRole('region', { name: 'Response pane' })\n        expect(within(pane).getByLabelText('Response body')).toHaveTextContent('9007199254740993')\n        await user.click(within(pane).getByRole('button', { name: 'Copy' }))\n        expect(await navigator.clipboard.readText()).toBe(raw)\n//! Versioned P11 fixture preparation; never overwrites sealed preparation.\nuse sha2::{Digest, Sha256};\nuse std::{\n    fs,\n    io::Write,\n    path::Path,\n    time::{SystemTime, UNIX_EPOCH},\n};\nuse xtask::{Repo, env::Environment, manifest::Manifest, native};\n\ntype Result<T> = std::result::Result<T, Box<dyn std::error::Error>>;\n\nfn reserve(repo: &Repo, args: &[String]) -> Result<fs::File> {\n    let name = args.get(1).map(String::as_str).unwrap_or(\"\");\n    let attempt = name\n        .strip_prefix(\"docs/planning/evidence/P11/native-build-\")\n        .and_then(|s| s.strip_suffix(\"-vm/native-prepare.json\"))\n        .and_then(|s| s.parse::<u32>().ok());\n    if args.len() != 2\n        || args[0] != \"--out\"\n        || !attempt.is_some_and(|n| {\n            n >= 5\n                && name\n                    == format!(\n                        \"docs/planning/evidence/P11/native-build-{n:02}-vm/native-prepare.json\"\n                    )\n        })\n    {\n        return Err(\"expected --out docs/planning/evidence/P11/native-build-NN-vm/native-prepare.json (NN>=05)\".into());\n    }\n    if repo.root().canonicalize()? != repo.root() {\n        return Err(\"repository parents must not be symlinks\".into());\n    }\n    let mut parent = repo.root().to_path_buf();\n    for part in Path::new(name)\n        .parent()\n        .ok_or(\"missing output parent\")?\n        .components()\n    {\n        parent.push(part);\n        match fs::symlink_metadata(&parent) {\n            Ok(m) if m.is_dir() && !m.file_type().is_symlink() => {}\n            Err(e) if e.kind() == std::io::ErrorKind::NotFound => fs::create_dir(&parent)?,\n            _ => return Err(\"output parents must be real directories\".into()),\n        }\n    }\n    Ok(fs::OpenOptions::new()\n        .write(true)\n        .create_new(true)\n        .open(repo.join(name))?)\n}\n\nfn main() -> Result<()> {\n    let repo = Repo::discover();\n    // Reserve before environment probes, extraction or either build command.\n    // A failed build leaves this incomplete attempt reserved for inspection.\n    let mut output = reserve(&repo, &std::env::args().skip(1).collect::<Vec<_>>())?;\n    let manifest = Manifest::load(&repo.manifest())?;\n    let target = \"aarch64-apple-darwin\";\n    let features = vec![\"test-fixtures\".to_owned()];\n    if manifest.target != target || manifest.fixture_only_features != features {\n        return Err(\"P11 requires the fixed ARM64 fixture recipe\".into());\n    }\n    let env = Environment::prepare(&repo)?;\n    xtask::harness::unpack(&repo)?;\n    let commands: Vec<Vec<String>> = native::build_commands(target)\n        .iter()\n        .map(|argv| argv.iter().map(|s| (*s).to_owned()).collect())\n        .collect();\n    for argv in &commands {\n        if !env.command(argv, repo.root())?.status()?.success() {\n            return Err(format!(\"fixture build failed: {}\", argv.join(\" \")).into());\n        }\n    }\n    let bundle = native::bundle_path(&repo, target, \"Prisma AIRS Desktop Fixture\");\n    let identifier = native::plist_value(&bundle, \"CFBundleIdentifier\")?;\n    if identifier != native::FIXTURE_IDENTIFIER {\n        return Err(format!(\"unexpected fixture identifier: {identifier}\").into());\n    }\n    let prepared = native::Prepared {\n        subject: \"P11\".to_owned(),\n        built_utc: desktop_core::sessions::rfc3339(\n            SystemTime::now().duration_since(UNIX_EPOCH)?.as_secs(),\n        ),\n        bundle: bundle.strip_prefix(repo.root())?.display().to_string(),\n        identifier,\n        executable_sha256: hex::encode(Sha256::digest(fs::read(\n            bundle.join(\"Contents/MacOS/prisma-airs-desktop\"),\n        )?)),\n        bundle_sha256: xtask::fingerprint::tree_hash(&bundle)?,\n?? docs/planning/reviews/C48/attempt-03/\n","exit_code":0,"status":"completed"}}
