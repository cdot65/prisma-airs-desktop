on data must be valid JSON.',\n    header: 'Headers must be single-line Name: value with a value.',\n    external: 'Files, stdin and interactive prompts are not supported.',\n    combination: 'These options cannot be combined.',\n}\n\nconst PROBLEM_TEXT: Record<string, string> = {\n    noCollection: 'Open a collection first.',\n    missing: 'That request is not open any more.',\n    stale: 'This request changed since it was loaded. It was reloaded; check it and try again.',\n    unavailable: 'The API Client is not available in this build.',\n    invalid: 'Check the entered values and try again.',\n    managed: 'tenant.* references belong to the tenant and are not stored here.',\n    limit: 'A limit was reached (drafts or private environments).',\n    keychain: 'The Keychain did not store the value.',\n    unprotected: 'Your latest edits are not kept on this Mac yet.',\n}\n\nexport function problemText(problem: WorkbenchProblem): string {\n    if (problem.kind === 'curl') return CURL_TEXT[problem.detail] ?? 'The command could not be imported.'\n    if ('detail' in problem) return DETAIL_TEXT[problem.detail] ?? 'That could not be done.'\n    return PROBLEM_TEXT[problem.kind] ?? 'That could not be done.'\n}\n\nconst RENDER_TEXT: Record<Exclude<RenderProblem['kind'], 'field' | 'unresolved' | 'nested'>, string> = {\n    unclosed: 'A {{ is not closed.',\n    secretInName: 'Secrets go into values only, never into names.',\n    name: 'A header or part name is not valid after variables are filled in.',\n    url: 'The URL is not an absolute http(s) URL after variables are filled in.',\n    auth: 'The auth settings are incomplete (check kind, secret, username, name, location, token_url and client_id).',\n    multipartContentType: 'A multipart body sets its own Content-Type; remove that header.',\n}\n\nexport function renderProblemText(problem: RenderProblem): string {\n    switch (problem.kind) {\n        case 'field':\n            return `Fix to send. ${fieldText(problem.problem)}.`\n        case 'unresolved':\n            return `{{${problem.name}}} names no variable in the selected environment.`\n        case 'nested':\n            return `The variable ${problem.name} itself holds {{ … }}; variables are filled in one level deep.`\n        default:\n            return RENDER_TEXT[problem.kind]\n    }\n}\n\nconst SEND_TEXT: Record<Exclude<SendRefusal['kind'], 'render' | 'unknownManagedReference' | 'secret' | 'body'>, string> = {\n    url: 'Use an absolute http(s) URL whose host is written out, not a secret.',\n    network: 'This build does not send to that address.',\n    mixedCredentials: 'A request with tenant credentials cannot also use API Client secrets.',\n    managedPlacement: 'Tenant credentials go only into their OAuth grant or the x-pan-token header.',\n    ambiguousCredential: 'Remove Authorization, Cookie, x-pan-token or method-override headers from tenant requests.',\n    noTenant: 'Select a tenant with this credential in Settings, then send again.',\n    tokenDestination: \"The token URL is not the tenant credential's token address.\",\n    requestDestination: \"The URL is not where the tenant's credential may go.\",\n    notHttps: 'Tenant credentials are sent over HTTPS only.',\n    unknownEndpoint: 'Tenant credentials are used only for the known Strata Cloud Manager and AIRS operations.',\n    busy: 'Four requests are already running. Wait for one or cancel it.',\n    stale: 'This request changed since it was loaded. Check it and send again.',\n    reviewMissing: 'That review is no longer open. Send again to review the change.',\n    reviewStale: 'The request, its files or environment changed since the review. Send again to review it.',\n    reviewExpired: 'The review expired. Send again to review the change.',\n    reviewConsumed: 'That review was already applied; the change was sent once.',\n    declined: 'Not sent.',\n    private: 'Private API Client storage is unavailable; nothing was sent.',\n}\n\nconst SECRET_TEXT: Record<string, string> = {\n    missing: 'has no value on this Mac',\n    locked: 'is locked in the Keychain',\n    denied: 'was denied by the Keychain',\n    invalid: 'is empty, has surrounding spaces or a line break',\n}\n\nexport function sendRefusalText(refusal: SendRefusal): string {\n    switch (refusal.kind) {\n        case 'render':\n            return renderProblemText(refusal.problem)\n        case 'unknownManagedReference':\n            return `${refusal.reference} is not a tenant credential.`\n        case 'secret':\n            return `The secret ${refusal.reference} ${SECRET_TEXT[refusal.failure] ?? 'is unavailable'}. Nothing was sent.`\n        case 'body':\n            return refusal.problem === 'tooLarge'\n                ? 'A body file is over 64 MiB (128 MiB per multipart body). Nothing was sent.'\n                : refusal.problem === 'unsaved'\n                  ? 'Save the body file first; file bodies are sent as stored.'\n                  : 'A body file is missing or outside the collection. Nothing was sent.'\n        default:\n            return SEND_TEXT[refusal.kind]\n    }\n}\n\nconst FAILURE_TEXT: Record<RunFailure, string> = {\n    timeout: 'No response within 120 seconds.',\n    connect: 'Could not connect. Nothing was sent.',\n    tls: 'The secure connection failed (certificate or TLS). Nothing was sent.',\n    request: 'The connection failed after the request may have been sent.',\n    token: 'The OAuth token could not be obtained. Nothing else was sent.',\n    tooLarge: 'The response is over 512 MiB; the rest was not read.',\n    storage: 'The response could not be stored on this Mac.',\n    redirect: 'A redirect pointed somewhere this build does not send to.',\n    retired: 'The tenant changed before it was sent. Nothing was sent.',\n}\n\nexport function runFailureText(failure: RunFailure): string {\n    return FAILURE_TEXT[failure]\n}\n\nexport function exportFailureText(failure: ExportFailure): string {\n    return failure === 'destination'\n        ? 'Choose a place outside the app’s private folder and any .git folder.'\n        : failure === 'body'\n          ? 'This response body is not stored.'\n          : 'The file could not be written.'\n}\n\nconst SIZE = ['B', 'KB', 'MB', 'GB']\nexport function sizeText(bytes: number): string {\n    let value = bytes\n    let unit = 0\n    while (value >= 1000 && unit < SIZE.length - 1) {\n        value /= 1000\n        unit += 1\n    }\n    return unit === 0 ? `${value} B` : `${value.toFixed(1)} ${SIZE[unit]}`\n}\n\nexport function elapsedText(ms: number): string {\n    return ms < 1000 ? `${ms} ms` : `${(ms / 1000).toFixed(2)} s`\n}\n\n/** One line for a recorded run. */\nexport function runSummary(record: RunRecord): string {\n    const state =\n        record.state === 'completed' && record.status !== null\n            ? `HTTP ${record.status}`\n            : record.state === 'interrupted'\n              ? 'Interrupted (not sent again)'\n              : record.state === 'cancelled'\n                ? 'Cancelled'\n                : record.state === 'running'\n                  ? 'Running'\n                  : 'Failed'\n    return `${state} · ${sizeText(record.bytes)} · ${elapsedText(record.elapsedMs)}`\n}\n\n/** Operator text for a result that did not do what was asked (else null). */\nexport function resultText(result: Awaited<ReturnType<WorkbenchCall>>): string | null {\n    switch (result.kind) {\n        case 'undelivered':\n            return result.message\n        case 'refused':\n            return problemText(result.problem)\n        case 'saveRefused':\n            return saveRefusalText(result.refusal)\n        case 'sendRefused':\n            return sendRefusalText(result.refusal)\n        case 'saveResponseFailed':\n            return exportFailureText(result.failure)\n        default:\n            return null\n    }\n}\nimport { useEffect, useMemo, useRef, useState } from 'react'\nimport type { RunRecord, RunView, RunningView, SendReviewView } from '@prisma-airs/desktop-contracts'\nimport { type WorkbenchCall, resultText, runFailureText, runSummary, sizeText } from '../../modules/workbench/workbench-call'\nimport { clockOf } from '../copy'\nimport { Btn } from '../controls'\nimport { Glyph } from '../icons'\nimport { API_COPY as C } from './copy'\nimport { prettyJson } from './request-rows'\nimport { requestName } from './request-tree'\nimport { JsonText } from './json-presentation'\nimport type { DisplayedResponse } from './presentation-status'\n\ntype ResponseTab = 'body' | 'headers' | 'details' | 'history'\nconst TABS: ResponseTab[] = ['body', 'headers', 'details', 'history']\n\nconst faint = { color: 'var(--v2-faint)' }\nconst soft = { color: 'var(--v2-soft)' }\nconst MONO = \"ui-monospace, 'SF Mono', Menlo, monospace\"\nconst BOX = {\n    margin: '0 14px 12px',\n    border: '1px solid var(--v2-rule)',\n    borderRadius: 8,\n    background: 'var(--v2-paper)',\n}\n\n/** The status pill's tone: the code's class, a failure, or a run that never completed. */\nexport function tone(record: RunRecord): {\n    fg: string\n    bg: string\n    text: string\n    glyph: 'check' | 'alert' | 'ban' | 'x'\n} {\n    if (record.state === 'completed' && record.status !== null) {\n        const code = record.status\n        return code < 300\n            ? {\n                  fg: 'var(--v2-ok)',\n                  bg: 'var(--v2-ok-bg)',\n                  text: `${code} ${code === 200 ? 'OK' : ''}`.trim(),\n                  glyph: 'check',\n              }\n            : code < 500\n              ? {\n                    fg: 'var(--v2-flag)',\n                    bg: 'var(--v2-flag-bg)',\n                    text: String(code),\n                    glyph: 'alert',\n                }\n              : {\n                    fg: 'var(--v2-block)',\n                    bg: 'var(--v2-block-bg)',\n                    text: String(code),\n                    glyph: 'ban',\n                }\n    }\n    const text = record.state === 'interrupted' ? 'Interrupted' : record.state === 'cancelled' ? 'Cancelled' : record.state === 'running' ? 'Running' : 'Failed'\n    return { fg: 'var(--v2-block)', bg: 'var(--v2-block-bg)', text, glyph: 'x' }\n}\n\nexport function elapsedText(ms: number): string {\n    return ms < 1000 ? `${ms} ms` : `${(ms / 1000).toFixed(2)} s`\n}\n\ninterface Props {\n    /** The run Send produced for this request (null before the first send). */\n    run: RunView | null\n    running: RunningView[]\n    review: SendReviewView | null\n    call: WorkbenchCall\n    /** Changes when history may have changed (the collection, a send). */\n    historyKey: string\n    onApply: () => void\n    onDismiss: () => void\n    onDisplayed?: (response: DisplayedResponse | null) => void\n}\n\n/**\n * The response pane (R2App's right 40%): the status line, the Body,\n * Headers, Details and History tabs. A run shown from History is the\n * immutable record of what happened then; nothing here sends anything.\n */\nexport function ResponsePane({ run, running, review, call, historyKey, onApply, onDismiss, onDisplayed }: Props) {\n    const [tab, setTab] = useState<ResponseTab>('body')\n    const [pretty, setPretty] = useState(true)\n    const [fromHistory, setFromHistory] = useState<RunView | null>(null)\n    const [message, setMessage] = useState('')\n    // A new send shows its own run and returns to Body.\n    const runId = run?.record.id ?? null\n    useEffect(() => {\n        setFromHistory(null)\n        setMessage('')\n        if (runId) setTab('body')\n    }, [runId])\n    const shown = fromHistory ?? run\n    const record = shown?.record ?? null\n    const displayCallback = useRef(onDisplayed)\n    displayCallback.current = onDisplayed\n    useEffect(() => {\n        displayCallback.current?.(record ? { record, history: fromHistory !== null } : null)\n    }, [record, fromHistory])\n    const formatted = useMemo(() => shown?.preview != null ? prettyJson(shown.preview) : null, [shown?.preview])\n\n    const save = async () => {\n        if (!record) return\n        setMessage('')\n        const r = await call({ kind: 'saveResponse', run: record.id })\n        if (r.kind === 'responseSaved') setMessage(C.saved(sizeText(r.bytes), r.name))\n        else if (r.kind !== 'cancelled') setMessage(resultText(r) ?? '')\n    }\n    const copy = async () => {\n        if (shown?.preview == null) return\n        try {\n            await navigator.clipboard.writeText(shown.preview)\n            setMessage(C.copied)\n        } catch {\n            setMessage(C.copyFailed)\n        }\n    }\n\n    const first = running[0] ?? null\n    // Every transfer in flight is in view with its own Cancel, whatever response is being inspected (a run from\n    // History shown while a new send runs hid the progress and the cancellation behind the old record; the core\n    // runs several sends of one document at once, and only the first was shown).\n    const progress = running.map((r, i) => (\n        <span key={r.run} role='status' aria-live='polite' className='flex w-full flex-wrap items-center text-[12.5px]' style={{ gap: 8 }} data-slot='workbench-running'>\n            {C.sendingProgress(r.method, sizeText(r.bytes))}\n            <Btn className='h-7' aria-label={running.length > 1 ? `${C.cancel_} ${i + 1} of ${running.length}` : undefined} onClick={() => void call({ kind: 'cancel', run: r.run })}>\n                {C.cancel_}\n            </Btn>\n        </span>\n    ))\n    const head = record ? (\n        <>\n            {!onDisplayed ? <><span\n                className='inline-flex items-center rounded-[6px] font-bold'\n                style={{\n                    gap: 4,\n                    padding: '2px 9px',\n                    background: tone(record).bg,\n                    color: tone(record).fg,\n                }}\n                data-slot='response-status'\n            >\n                <Glyph name={tone(record).glyph} size={11} color={tone(record).fg} />\n                {tone(record).text}\n            </span>\n            <span style={soft}>{elapsedText(record.elapsedMs)}</span>\n            <span style={soft}>{sizeText(record.bytes)}</span></> : null}\n            <span className='ml-auto truncate text-[12px]' style={faint}>\n                {fromHistory ? `${requestName(record.relative)} · ${clockOf(record.at)}` : clockOf(record.at)}\n            </span>\n        </>\n    ) : first ? null : (\n        <span style={faint}>{C.noResponseYet}</span>\n    )\n\n    return (\n        <section\n            aria-label={C.pane}\n            data-slot='workbench-response-pane'\n                        <pre className='max-h-48 overflow-auto rounded-[8px] p-2 font-mono text-[12px] whitespace-pre-wrap' style={{ background: 'var(--v2-paper)' }}>\n                            {review.body}\n                        </pre>\n                    ) : null}\n                    {review.files.length ? <p>{C.review.files(review.files.join(', '))}</p> : null}\n                    <p className='text-[12px]' style={faint}>\n                        {C.review.expires(new Date(review.expires * 1000).toLocaleTimeString())}\n                    </p>\n                    <div className='flex flex-wrap' style={{ gap: 8 }}>\n                        <Btn tier='primary' onClick={onApply}>\n                            {C.review.apply}\n                        </Btn>\n                        <Btn onClick={onDismiss}>{C.review.dismiss}</Btn>\n                    </div>\n                </div>\n            ) : null}\n            <div\n                role='tablist'\n                aria-label={`${C.response} views`}\n                className='flex flex-wrap'\n                style={{\n                    gap: 2,\n                    padding: '0 10px',\n                    borderBottom: '1px solid var(--v2-rule)',\n                }}\n            >\n                {TABS.map((t) => (\n                    <button\n                        key={t}\n                        type='button'\n                        role='tab'\n                        aria-selected={tab === t}\n                        aria-controls={`response-panel-${t}`}\n                        onClick={() => setTab(t)}\n                        className='min-h-0 text-[12.5px] font-semibold'\n                        style={{\n                            height: 38,\n                            padding: '0 10px',\n                            border: 0,\n                            borderBottom: `2px solid ${tab === t ? 'var(--v2-acc)' : 'transparent'}`,\n                            background: 'transparent',\n                            color: tab === t ? 'var(--v2-ink)' : 'var(--v2-soft)',\n                        }}\n                    >\n                        {C.responseTabs[t]}\n                        {t === 'headers' && record?.headers.length ? (\n                            <span className='font-normal' style={{ fontSize: 12, ...faint }}>\n                                {' '}\n                                {record.headers.length}\n                            </span>\n                        ) : null}\n                    </button>\n                ))}\n            </div>\n            <div role='tabpanel' id={`response-panel-${tab}`} className='flex min-h-0 flex-grow flex-col'>\n                {tab === 'history' ? (\n                    <History\n                        call={call}\n                        revision={historyKey}\n                        onShow={(view) => {\n                            setFromHistory(view)\n                            setTab('body')\n                        }}\n                    />\n                ) : !shown || !record ? (\n                    <p className='text-[13px]' style={{ margin: '20px 14px', ...faint }} data-slot='workbench-no-response'>\n                        {C.noResponse}\n                    </p>\n                ) : (\n                    <section aria-label={C.response} data-slot='workbench-response' className='flex min-h-0 flex-grow flex-col text-[13px]'>\n                        <p className='sr-only' data-slot='workbench-run-summary'>\n","exit_code":0,"status":"completed"}}
