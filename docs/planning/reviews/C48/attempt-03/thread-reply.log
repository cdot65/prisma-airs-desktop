                                           className='shrink-0 rounded-full'\n                                                        style={{\n                                                            width: 6,\n                                                            height: 6,\n                                                            background: 'var(--v2-acc)',\n                                                        }}\n                                                    />\n                                                ) : null}\n                                                {t.conflict || t.interrupted ? <Glyph name='alert' size={11} color='var(--v2-flag)' /> : null}\n                                            </button>\n                                            <button\n                                                type='button'\n                                                aria-label={C.closeTab(name)}\n                                                onClick={() => void close({ kind: 'tab', id: t.id, name })}\n                                                className='grid size-6 min-h-0 place-items-center rounded-[5px] text-[13px]'\n                                                style={{\n                                                    border: 0,\n                                                    background: 'transparent',\n                                                    ...faint,\n                                                }}\n                                            >\n                                                ×\n                                            </button>\n                                        </span>\n                                    )\n                                })}\n                            </div>\n                            {alerts !== null ? (\n                                <div className='flex flex-col empty:hidden' style={{ gap: 8, padding: '0 20px' }}>\n                                    {alerts}\n                                </div>\n                            ) : null}\n                            {loadFailure && doc?.id !== loadFailure.id ? (\n                                <div role='alert' className='flex flex-wrap items-center text-[13px]' style={{ gap: 10, margin: '16px 20px 0', padding: '12px 14px', borderRadius: 10, background: 'var(--v2-block-bg)' }} data-slot='workbench-load-failed'>\n                                    <span className='min-w-0 flex-grow'>{C.loadFailed(requestName(loadFailure.relative), loadFailure.text)}</span>\n                                    <Btn onClick={() => open({ id: loadFailure.id, relative: loadFailure.relative })}>{C.tryAgain}</Btn>\n                                </div>\n                            ) : null}\n                            {/* Scope ownership is checked in this commit, before passive effects clear the old document. */}\n                            {doc && docCollection.current === collectionId && selectedTab && doc.id === selectedTab.id ? (\n                                <RequestEditor\n                                    key={`${doc.id}:${doc.revision}:${doc.relative}:${docSeq}`}\n                                    initial={doc}\n                                    notes={notes}\n                                    call={call}\n                                    schemas={collection.schemas}\n                                    historyKey={`${collection.scope}:${state.running.length}`}\n                                    onStatusChange={(value) => {\n                                        if (statusOwner.current === editorOwner) setEditorStatus(value && editorOwner ? { owner: editorOwner, value } : null)\n                                    }}\n                                    onClosed={() => setDoc(null)}\n                                    register={(handle) => editors.current.set(doc.id, handle)}\n                                    context={snapshot.active?.context ?? null}\n                                    running={state.running.filter((r) => r.request === doc.id)}\n                                    review={state.review?.request === doc.id ? state.review : null}\n                                />\n                            ) : collection.tabs.length === 0 ? (\n                                <p className='text-[13px]' style={{ padding: '20px', ...soft }} data-slot='workbench-empty'>\n                                    {collection.requests.length === 0 ? C.noRequests : C.selectRequest}\n                                </p>\n                            ) : null}\n                            <div\n                                className='flex shrink-0 flex-wrap items-center text-[12px]'\n                                style={{\n                                    minHeight: 26,\n                                    gap: 14,\n                                    padding: '0 14px',\n                                    borderTop: '1px solid var(--v2-rule)',\n                                    background: 'var(--v2-side)',\n                                    ...faint,\n                                }}\n                                data-slot='api-footer'\n                            >\n                                <span className='flex items-center' style={{ gap: 5 }}>\n                                    <span\n                                        aria-hidden\n                                        className='rounded-full'\n                                        style={{\n                                            width: 6,\n                                            height: 6,\n                                            background: state.busy ? 'var(--v2-flag)' : 'var(--v2-ok)',\n                                        }}\n                                    />\n                                    {state.busy ? C.working : C.footer.ready}\n                                </span>\n                                {displayedStatus ? <span role='status' aria-live='polite' data-slot='workbench-save-status' data-state={displayedStatus.save.state}>{displayedStatus.save.text}</span> : null}\n                                {displayed ? <span role='status' aria-live='polite' className='flex min-w-0 flex-wrap items-center' style={{ gap: 8 }} data-slot='workbench-response-status' data-run={displayed.record.id} data-request={displayed.record.request}>\n                                    <span>{displayed.history ? 'History · ' : ''}{requestName(displayed.record.relative)} · {clockOf(displayed.record.at)}</span>\n                                    <span style={{ color: tone(displayed.record).fg }}>{tone(displayed.record).text}</span>\n                                    <span>{elapsedText(displayed.record.elapsedMs)}</span>\n                                    <span>{sizeText(displayed.record.bytes)}</span>\n                                </span> : null}\n                                <span className='ml-auto'>{C.footer.requests(collection.requests.length)}</span>\n                                {collection.archives ? <span>{C.footer.archives(collection.archives)}</span> : null}\n                            </div>\n                        </div>\n                    </div>\n                    {tool ? (\n                        <ToolsSheet\n                            tool={tool}\n                            state={state}\n                            collection={collection}\n                            run={run}\n                            onClose={() => setTool(null)}\n                            importCurl={async (text, relative) => {\n                                // A cURL import's draft is a load of this collection: begun before the call, settled against it.\n                                const load = beginLoad(null)\n                                const r = await run({ kind: 'importCurl', text, relative })\n                                settleLoad(load, r, true)\n                                return r\n                            }}\n                            onCreated={() => setTool(null)}\n                            returnFocus={chip.current}\n                        />\n                    ) : null}\n                </>\n            )}\n            {closing\n                ? createPortal(\n                      <Modal label={closing.kind === 'tab' ? C.closing.tab(closing.name) : C.closing.collection} width={480} onClose={() => setClosing(null)} data-slot='workbench-closing-dialog'>\n                          <div\n                              role='alertdialog'\n                              aria-label={closing.kind === 'tab' ? C.closing.tab(closing.name) : C.closing.collection}\n                              className='flex flex-col text-[13px]'\n                              style={{ gap: 12 }}\n                              data-slot='workbench-closing'\n                          >\n                              <h2 className='text-[17px] font-bold'>{closing.kind === 'tab' ? C.closing.tab(closing.name) : C.closing.collection}</h2>\n                              <p>{C.closing.text}</p>\n                              <div className='flex justify-end' style={{ gap: 8 }}>\n                                  <Btn onClick={() => setClosing(null)}>{C.closing.keep}</Btn>\n                                  <Btn tier='primary' onClick={() => void close(closing, true)}>\n                                      {C.closing.discard}\n                                  </Btn>\n                              </div>\n                          </div>\n                      </Modal>,\n                      document.body\n                  )\n                : null}\n        </section>\n    )\n}\n\n/** No collection open: open, create, the built-in, recents. */\nfunction Start({ state, run, message, offerNew, retry }: { state: WorkbenchState; run: Run; message: string; offerNew: boolean; retry?: () => Promise<void> }) {\n    return (\n        <div className='flex flex-col' style={{ gap: 14, maxWidth: 760 }} data-slot='workbench-start'>\n            <p className='text-[14px]'>{C.start.none}</p>\n            {message ? (\n                <div\n                    role='alert'\n                    className='flex flex-col rounded-[10px] text-[13px]'\n                    style={{\n                        gap: 8,\n                        padding: '12px 14px',\n                        background: 'var(--v2-flag-bg)',\n                    }}\n                    data-slot='workbench-message'\n                >\n                    <p>{message}</p>\n                    {retry ? <Btn tier='tertiary' className='self-start' onClick={() => void retry()}>{C.tryAgain}</Btn> : null}\n                    {offerNew ? (\n                        <Btn className='self-start' onClick={() => void run({ kind: 'createCollection' })}>\n                            {C.start.create}\n                        </Btn>\n                    ) : null}\nimport { create } from 'zustand'\n\nexport type ToastKind = 'ok' | 'info' | 'warn'\nimport type { AdminProductId, FeatureId, Intent, ManagementResource } from '@prisma-airs/desktop-contracts'\n\n/** What a contextual action asked the destination to select on arrival (C30), owned by the tenant it was followed in (I2). */\nexport interface Arrival {\n    tenant: string\n    feature: FeatureId\n    resource: ManagementResource | null\n    /** The item to filter to, by name. */\n    item: string | null\n    /** The Administration product to open (the rail's product children, C35). */\n    product?: AdminProductId\n    /** That product's tab to show, by the inventory's tab id (the tenant menu's workspace row, C35). */\n    tab?: string\n    /** Counts arrivals: a destination already open applies a new one. */\n    sequence: number\n}\n\n/** A Harness message kept for the operator: refused or never sent, or not confirmed (C32). */\nexport interface HarnessKept {\n    /** This record's own id: each attempt is its own record (C32). */\n    id: number\n    text: string\n    unconfirmed: boolean\n    /**\n     * For an unconfirmed send: the conversation it was sent to and the send's\n     * own ID. It is settled only when that conversation reports the core took\n     * that ID (`ConversationView.submissions`), never by matching text (C32).\n     */\n    conversation?: string\n    submission?: string\n}\n\n/** A Harness send the page dispatched, awaiting the core's word on it (C32): never shown, never sent again. */\nexport interface HarnessSent {\n    submission: string\n    conversation: string\n    text: string\n}\n\n/**\n * A Runtime case handed to the Playground (C33): Administration opens Runtime\n * Security's Playground tab with the case's fields; the operator runs the\n * scan there. Bound to the tenant it was opened in.\n */\nexport interface PlaygroundCase {\n    tenant: string\n    caseId: string\n    prefill: import('../modules/library/case-prefill').CasePrefill\n}\n\n/** A delivery the desktop did not confirm: kept until the operator retries or dismisses it (DESIGN-V2 §7). */\nexport interface Unconfirmed {\n    id: number\n    what: string\n    intent: Intent\n    /** The native context or captured switch source this delivery belongs to; retirement never rebinds it. */\n    context: string | null\n}\n\n/** An initial tenant selection captures even the absence of an active context. */\nexport function unconfirmedInContext(delivery: Pick<Unconfirmed, 'intent' | 'context'>, context: string | null): boolean {\n    return delivery.context === context || (delivery.context === null && delivery.intent.kind !== 'selectTenant')\n}\n\nfunction switchResolution(intent: Intent) {\n    return intent.kind === 'selectTenant' || intent.kind === 'completeTenantSetup' ? intent.resolution : null\n}\n\n/** A destructive switch is bound to its source, not its destination or setup draft. */\nexport function deliveryContext(intent: Intent): string | null {\n    const resolution = switchResolution(intent)\n    if (resolution) return resolution.context\n    return 'context' in intent && typeof intent.context === 'string' ? intent.context : null\n}\n\nexport interface Toast {\n    id: number\n    kind: ToastKind\n    text: string\n    /** An optional undo the toast offers (label + action). */\n    undo?: { label: string; run: () => void }\n    /** The tenant the toast speaks for (an item, a read): retired on leaving it (I2). */\n    tenant: string | null\n    /** The context it was raised under, when the action was context-bound: retired with it. */\n    context: string | null\n}\n\n/**\n * Transient shell presentation state (state-ownership.md \"UI\"): what is open,\n * the palette query, toasts and the modal stack. Nothing here survives a\n * reload and nothing here is authority: every durable fact is observed from\n * the Rust snapshot.\n */\n/** Unresolved preferred-collection recovery survives page navigation, but never a retired native scope or collection choice. */\ninterface WorkbenchRecovery {\n    tenant: string | null\n    context: string | null\n    collection: string | null\n    generation: number\n    pending: boolean\n    failed: boolean\n    /** Sanitized delivery outcome; survives page remount with this recovery. */\n    message: string\n}\nconst initialWorkbenchRecovery = (): WorkbenchRecovery => ({ tenant: null, context: null, collection: null, generation: 0, pending: false, failed: false, message: '' })\n\ninterface ShellStore {\n    /** The scope the shell shows now (set from each snapshot before it renders): what a notification must belong to. */\n    scope: { tenant: string | null; context: string | null; switchReview: string | null }\n    setScope(tenant: string | null, context: string | null, switchReview?: string | null): void\n    workbenchRecovery: WorkbenchRecovery\n    observeWorkbench(tenant: string | null, context: string | null, collection: string | null): void\n    beginWorkbenchRestore(tenant: string | null, context: string | null): number | null\n    finishWorkbenchRestore(tenant: string | null, context: string | null, generation: number, failed: boolean, message?: string): void\n    resolveWorkbenchRestore(tenant: string | null, context: string | null, generation: number): void\n    paletteOpen: boolean\n    switcherOpen: boolean\n    /** The rail's Administration children shown or hidden (C35; the prototype's `adminNav`). */\n    adminNavOpen: boolean\n    setAdminNav(open: boolean): void\n    toasts: Toast[]\n    /** Open modal ids, bottom to top; only the last is interactive (I8). */\n    modals: string[]\n    /** The Inbox tab and item per tenant (I2: a switch round trip keeps it). */\n    inboxSelection: Record<string, { tab: 'all' | 'action' | 'updates' | 'snoozed'; item: string | null }>\n    selectInbox(tenant: string, selection: { tab: 'all' | 'action' | 'updates' | 'snoozed'; item: string | null }): void\n    /** Harness drafts, by `tenant|workspace|conversation` (C32): kept across navigation and tenant round trips, never shared between scopes, never sent by themselves. */\n    harnessDrafts: Record<string, string>\n    setHarnessDraft(scope: string, text: string): void\n    /** Per `tenant|workspace`: the operator chose a new investigation while one runs (C32). */\n    harnessFresh: Record<string, boolean>\n    setHarnessFresh(scope: string, fresh: boolean): void\n    /**\n     * Per `tenant|workspace`: messages kept for the operator (C32). `unconfirmed`\n     * ones may have been delivered (the desktop did not confirm it); the others\n     * were refused or never sent. Never sent by themselves.\n     */\n    harnessUnsent: Record<string, HarnessKept[]>\n    keepHarnessUnsent(scope: string, kept: Omit<HarnessKept, 'id'>): void\n    dropHarnessUnsent(scope: string, id: number): void\n    /**\n     * Per `tenant|workspace`: sends dispatched and not yet reported by their\n     * conversation (C32), so a send the core gives back keeps its text whatever\n     * order its receipt and the core's word arrive in. Newest 64.\n     */\n    harnessSent: Record<string, HarnessSent[]>\n    /** The case last handed to the Playground (C33); never runs anything by itself. */\n    playground: PlaygroundCase | null\n    openPlayground(target: Omit<PlaygroundCase, 'prefill'> & { prefill: Omit<PlaygroundCase['prefill'], 'nonce'> }): void\n    trackHarnessSend(scope: string, sent: HarnessSent): void\n    untrackHarnessSend(scope: string, submission: string): void\n    /** The last contextual action's target, consumed by the destination it names. */\n    arrival: Arrival | null\n    arrive(target: Omit<Arrival, 'sequence'>): void\n    /** Forgets an arrival that belongs to another tenant than `tenant`. */\n    scopeArrival(tenant: string | null): void\n    /** Drops unconfirmed deliveries bound to a context other than `context` (their authority retired). */\n    retireUnconfirmed(context: string | null): void\n    unconfirmed: Unconfirmed[]\n    /** Toast lifetime in ms (6 s; tests shorten it). */\n    toastMs: number\n    addUnconfirmed(what: string, intent: Intent, sourceContext?: string | null): number\n    clearUnconfirmed(id: number): void\n    openPalette(): void\n    closePalette(): void\n    setSwitcher(open: boolean): void\n    toast(text: string, kind?: ToastKind, undo?: Toast['undo'], tenant?: string | null, context?: string | null): number\n    /** Retires toasts that speak for another tenant than `tenant`. */\n    retireToasts(tenant: string | null): void\n    dismissToast(id: number): void\n    pushModal(id: string): void\n    popModal(id: string): void\n}\n\nlet nextToast = 1\nlet nextKept = 1\n\nexport const useShellStore = create<ShellStore>((set, get) => ({\n    scope: { tenant: null, context: null, switchReview: null },\n    setScope: (tenant, context, switchReview = null) =>\n        set((s) => ({\n            scope: { tenant, context, switchReview },\n            // Leaving a scope retires what spoke for it, however late it would have arrived.\n            toasts: s.toasts.filter((t) => (t.tenant === null || t.tenant === tenant) && (t.context === null || t.context === context)),\n            unconfirmed: s.unconfirmed.filter((u) => unconfirmedInContext(u, context) && (!switchResolution(u.intent) || switchResolution(u.intent)?.review === switchReview)),\n            arrival: s.arrival && s.arrival.tenant !== tenant ? null : s.arrival,\n        })),\n    workbenchRecovery: initialWorkbenchRecovery(),\n    observeWorkbench: (tenant, context, collection) => set((s) => {\n        const old = s.workbenchRecovery\n        if (old.tenant === tenant && old.context === context && old.collection === collection) return s\n        return { workbenchRecovery: { tenant, context, collection, generation: old.generation + 1, pending: false, failed: false, message: '' } }\n    }),\n    beginWorkbenchRestore: (tenant, context) => {\n        const old = get().workbenchRecovery\n        if (old.tenant !== tenant || old.context !== context || old.collection !== null || old.pending) return null\n        const generation = old.generation + 1\n        set({ workbenchRecovery: { ...old, generation, pending: true } })\n        return generation\n    },\n    finishWorkbenchRestore: (tenant, context, generation, failed, message = '') => set((s) => {\n        const old = s.workbenchRecovery\n        if (old.tenant !== tenant || old.context !== context || old.generation !== generation || !old.pending) return s\n        return { workbenchRecovery: { ...old, pending: false, failed, message } }\n    }),\n    resolveWorkbenchRestore: (tenant, context, generation) => set((s) => {\n        const old = s.workbenchRecovery\n        if (old.tenant !== tenant || old.context !== context || old.generation !== generation) return s\n        return { workbenchRecovery: { ...old, generation: old.generation + 1, pending: false, failed: false, message: '' } }\n    }),\n    paletteOpen: false,\n    switcherOpen: false,\n    adminNavOpen: true,\n    setAdminNav: (open) => set({ adminNavOpen: open }),\n    toasts: [],\n    modals: [],\n    inboxSelection: {},\n    selectInbox: (tenant, selection) => set((s) => ({ inboxSelection: { ...s.inboxSelection, [tenant]: selection } })),\n    harnessDrafts: {},\n    setHarnessDraft: (scope, text) => set((s) => ({ harnessDrafts: { ...s.harnessDrafts, [scope]: text } })),\n    harnessFresh: {},\n    setHarnessFresh: (scope, fresh) => set((s) => ({ harnessFresh: { ...s.harnessFresh, [scope]: fresh } })),\n    harnessUnsent: {},\n    keepHarnessUnsent: (scope, item) =>\n        set((s) => {\n            const kept = s.harnessUnsent[scope] ?? []\n            const record = { ...item, id: nextKept++ }\n            // An uncertain attempt is never removed or downgraded by a later one:\n            // only the core's word on its own send ID, or the operator, settles it.\n            // A not-sent record of the same text is superseded by a later attempt;\n            // not-sent records are kept once per text.\n            const others = kept.filter((k) => k.unconfirmed || k.text !== item.text)\n            return { harnessUnsent: { ...s.harnessUnsent, [scope]: [...others, record] } }\n        }),\n    dropHarnessUnsent: (scope, id) => set((s) => ({ harnessUnsent: { ...s.harnessUnsent, [scope]: (s.harnessUnsent[scope] ?? []).filter((k) => k.id !== id) } })),\n    harnessSent: {},\n    playground: null,\n    openPlayground: (target) => set((s) => ({ playground: { ...target, prefill: { ...target.prefill, nonce: (s.playground?.prefill.nonce ?? 0) + 1 } } })),\n    trackHarnessSend: (scope, sent) => set((s) => ({ harnessSent: { ...s.harnessSent, [scope]: [...(s.harnessSent[scope] ?? []), sent].slice(-64) } })),\n    untrackHarnessSend: (scope, submission) => set((s) => ({ harnessSent: { ...s.harnessSent, [scope]: (s.harnessSent[scope] ?? []).filter((t) => t.submission !== submission) } })),\n    arrival: null,\n    arrive: (target) => set((s) => ({ arrival: { ...target, sequence: (s.arrival?.sequence ?? 0) + 1 } })),\n    unconfirmed: [],\n    toastMs: 6000,\n    addUnconfirmed: (what, intent, context = deliveryContext(intent)) => {\n        const id = nextToast++\n        // A delivery bound to a context the shell no longer shows is moot: never surfaced (I2).\n        if (!unconfirmedInContext({ intent, context }, get().scope.context)) return id\n        const resolution = switchResolution(intent)\n        if (resolution && resolution.review !== get().scope.switchReview) return id\n        set((s) => ({ unconfirmed: [...s.unconfirmed, { id, what, intent, context }] }))\n        return id\n    },\n    scopeArrival: (tenant) => set((s) => (s.arrival && s.arrival.tenant !== tenant ? { arrival: null } : {})),\n    retireUnconfirmed: (context) => set((s) => ({ unconfirmed: s.unconfirmed.filter((u) => unconfirmedInContext(u, context)) })),\n    clearUnconfirmed: (id) => set((s) => ({ unconfirmed: s.unconfirmed.filter((u) => u.id !== id) })),\n    openPalette: () => set({ paletteOpen: true, switcherOpen: false }),\n    closePalette: () => set({ paletteOpen: false }),\n    setSwitcher: (open) => set({ switcherOpen: open, ...(open ? { paletteOpen: false } : {}) }),\n    toast: (text, kind = 'ok', undo, tenant = null, context = null) => {\n        const id = nextToast++\n        // A toast for a tenant or context the shell no longer shows is never surfaced (I2).\n        if (tenant !== null && tenant !== get().scope.tenant) return id\n        if (context !== null && context !== get().scope.context) return id\n        // One toast at a time: the newest replaces the rest (I10).\n        set({ toasts: [{ id, kind, text, undo, tenant, context }] })\n        return id\n    },\n    retireToasts: (tenant) => set((s) => ({ toasts: s.toasts.filter((t) => t.tenant === null || t.tenant === tenant) })),\n    dismissToast: (id) => set((s) => ({ toasts: s.toasts.filter((t) => t.id !== id) })),\n    pushModal: (id) => set((s) => ({ modals: s.modals.includes(id) ? s.modals : [...s.modals, id] })),\n    popModal: (id) => set((s) => ({ modals: s.modals.filter((m) => m !== id) })),\n}))\n\n/** Test seam: forget everything (each test starts from an empty store). */\nexport function resetShellStore() {\n    useShellStore.setState({ workbenchRecovery: initialWorkbenchRecovery(), scope: { tenant: null, context: null, switchReview: null }, paletteOpen: false, switcherOpen: false, adminNavOpen: true, toasts: [], modals: [], unconfirmed: [], toastMs: 6000, inboxSelection: {}, arrival: null, harnessDrafts: {}, harnessFresh: {}, harnessUnsent: {}, harnessSent: {}, playground: null })\n}\n","exit_code":0,"status":"completed"}}
