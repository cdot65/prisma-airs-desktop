{"type":"item.completed","item":{"id":"item_11","type":"command_execution","command":"/bin/zsh -lc 'cat apps/desktop/src/v2/workbench/json-presentation.tsx apps/desktop/src/v2/workbench/request-rows.ts apps/desktop/src/v2/workbench/presentation-status.ts'","aggregated_output":"import { useLayoutEffect, useMemo, useRef, type CSSProperties } from 'react'\nimport { jsonLanguage } from '@codemirror/lang-json'\nimport { classHighlighter, highlightTree } from '@lezer/highlight'\n\n// Large editable bodies remain ordinary editable text. Highlighting never\n// changes their value or introduces a second body/preview size contract.\nconst HIGHLIGHT_LIMIT = 256 * 1024\nconst TOKEN_LIMIT = 12_000\nconst MONO = \"ui-monospace, 'SF Mono', Menlo, monospace\"\n\n/** JSON whitespace changes only: retain number/string spellings and duplicate keys. */\nexport function formatJson(text: string): string | null {\n    if (text.trim() === '' || text.length > HIGHLIGHT_LIMIT) return null\n    const tree = jsonLanguage.parser.parse(text)\n    const tokens: string[] = []\n    let invalid = false\n    tree.iterate({ enter(node) {\n        if (node.type.isError) invalid = true\n        if (!node.node.firstChild) tokens.push(text.slice(node.from, node.to))\n    } })\n    if (invalid || tokens.length === 0 || tokens.length > TOKEN_LIMIT) return null\n    const parts: string[] = []\n    let depth = 0\n    let length = 0\n    const put = (s: string) => { parts.push(s); length += s.length }\n    const line = () => put(`\\n${'  '.repeat(depth)}`)\n    for (let i = 0; i < tokens.length; i += 1) {\n        const token = tokens[i]!\n        const previous = tokens[i - 1]\n        const next = tokens[i + 1]\n        if (token === '{' || token === '[') {\n            put(token)\n            if (next !== '}' && next !== ']') {\n                depth += 1\n                if (depth > 64) return null\n                line()\n            }\n        } else if (token === '}' || token === ']') {\n            if (previous !== '{' && previous !== '[') { depth -= 1; line() }\n            put(token)\n        } else if (token === ',') { put(','); line() }\n        else if (token === ':') put(': ')\n        else put(token)\n        if (length > 1024 * 1024) return null\n    }\n    return parts.join('')\n}\n\nfunction color(classes: string): string {\n    if (classes.includes('propertyName')) return 'var(--v2-acc)'\n    if (classes.includes('string')) return 'var(--v2-ok)'\n    if (classes.includes('number') || classes.includes('bool') || classes.includes('null')) return 'var(--v2-flag)'\n    return 'var(--v2-soft)'\n}\n\nexport function JsonText({ text, numbered = false }: { text: string; numbered?: boolean }) {\n    const ranges = useMemo(() => {\n        if (text.length > HIGHLIGHT_LIMIT) return []\n        const ranges: { from: number; to: number; classes: string }[] = []\n        highlightTree(jsonLanguage.parser.parse(text), classHighlighter, (from, to, classes) => ranges.push({ from, to, classes }))\n        return ranges.length > TOKEN_LIMIT ? [] : ranges\n    }, [text])\n    let rangeIndex = 0\n    const paint = (from: number, to: number) => {\n        const out = []\n        let offset = from\n        while (rangeIndex < ranges.length && ranges[rangeIndex]!.to <= from) rangeIndex += 1\n        for (let i = rangeIndex; i < ranges.length; i += 1) {\n            const r = ranges[i]!\n            if (r.from >= to) break\n            const start = Math.max(from, r.from)\n            const end = Math.min(to, r.to)\n            if (start > offset) out.push(text.slice(offset, start))\n            out.push(<span key={start} data-json-token={r.classes} style={{ color: color(r.classes) }}>{text.slice(start, end)}</span>)\n            offset = end\n        }\n        out.push(text.slice(offset, to))\n        return out\n    }\n    if (!numbered) return <>{paint(0, text.length)}</>\n    let offset = 0\n    return <>{text.split('\\n').map((line) => {\n        const from = offset\n        offset += line.length + 1\n        return <span key={from} data-line=''>{paint(from, from + line.length)}{'\\n'}</span>\n    })}</>\n}\n\n/** A native textarea owns editing, selection, IME and copy. Its inert color layer is never a second input. */\nexport function JsonBodyEditor({ id, value, readOnly, style, onChange }: { id: string; value: string; readOnly: boolean; style: CSSProperties; onChange: (text: string) => void }) {\n    const paint = useRef<HTMLPreElement>(null)\n    const input = useRef<HTMLTextAreaElement>(null)\n    const highlighted = value.length <= HIGHLIGHT_LIMIT\n    const sync = () => {\n        if (!input.current || !paint.current) return\n        // A non-overlay native scrollbar reduces the textarea's text width.\n        // Match that width before wrapping the inert color layer.\n        if (input.current.clientWidth > 0) paint.current.style.width = `${input.current.clientWidth + 2}px`\n        paint.current.scrollTop = input.current.scrollTop\n        paint.current.scrollLeft = input.current.scrollLeft\n    }\n    useLayoutEffect(() => {\n        sync()\n        if (!input.current || typeof ResizeObserver === 'undefined') return\n        const observer = new ResizeObserver(sync)\n        observer.observe(input.current)\n        return () => observer.disconnect()\n    }, [highlighted])\n    const shared: CSSProperties = { ...style, fontFamily: MONO, fontWeight: 400, letterSpacing: 'normal', whiteSpace: 'pre-wrap', overflowWrap: 'break-word', tabSize: 4 }\n    return <div className='relative min-w-0' data-slot='json-body-editor'>\n        {highlighted ? <pre ref={paint} aria-hidden='true' style={{ ...shared, position: 'absolute', inset: 0, margin: 0, height: '100%', overflow: 'hidden', pointerEvents: 'none', borderColor: 'transparent' }}><JsonText text={value} />{value.endsWith('\\n') ? ' ' : ''}</pre> : null}\n        <textarea ref={input} id={id} value={value} readOnly={readOnly} spellCheck={false} style={{ ...shared, display: 'block', position: 'relative', background: highlighted ? 'transparent' : style.background, color: highlighted ? 'transparent' : 'var(--v2-ink)', caretColor: 'var(--v2-ink)' }} onScroll={sync} onChange={(e) => onChange(e.target.value)} />\n    </div>\n}\n\n/** One complete template string, with noninteractive inline variable color. */\nexport function UrlTemplateInput({ label, value, onChange }: { label: string; value: string; onChange: (text: string) => void }) {\n    const paint = useRef<HTMLPreElement>(null)\n    const parts = value.split(/(\\{\\{[^{}]+\\}\\})/g)\n    const shared: CSSProperties = { fontFamily: MONO, fontSize: 12.5, lineHeight: '32px', letterSpacing: 'normal', padding: 0, border: 0, margin: 0 }\n    return <span className='relative min-w-0 flex-grow' data-slot='template-input'>\n        <pre ref={paint} aria-hidden='true' style={{ ...shared, position: 'absolute', inset: 0, overflow: 'hidden', whiteSpace: 'pre', pointerEvents: 'none', color: 'var(--v2-ink)' }}>{parts.map((part, i) => part.startsWith('{{') && part.endsWith('}}') ? <span key={i} data-variable='' style={{ color: 'var(--v2-acc)' }}>{part}</span> : part)}</pre>\n        <input aria-label={label} value={value} autoComplete='off' spellCheck={false} className='relative min-h-0 min-w-0 w-full bg-transparent' style={{ ...shared, borderRadius: 0, minHeight: 0, background: 'transparent', color: 'transparent', caretColor: 'var(--v2-ink)' }} onScroll={(e) => { if (paint.current) paint.current.scrollLeft = e.currentTarget.scrollLeft }} onChange={(e) => onChange(e.target.value)} />\n    </span>\n}\n/**\n * The request's Params and Headers as rows (C41): the files keep one row\n * per line (`name=value` for params, `Name: value` for headers, `# ` in\n * front of a disabled row); the table edits those lines and writes them\n * back in the same form, so Rust reads what it always read.\n */\nexport interface Row {\n    enabled: boolean\n    name: string\n    value: string\n    /**\n     * The separator exactly as the line has it (`=` for a param; `:` and the\n     * spacing after it for a header), so a row written back is the line it\n     * came from. A new row takes the default.\n     */\n    sep?: string\n}\n\nexport type RowKind = 'query' | 'headers'\n\nconst SEPARATOR: Record<RowKind, string> = { query: '=', headers: ':' }\nconst DEFAULT_SEP: Record<RowKind, string> = { query: '=', headers: ': ' }\n\n/**\n * Rows from the field's text, or null when a non-empty line has no\n * separator (the text is then edited as text, never rewritten). Names and\n * values are verbatim: desktop-core keeps a query value as written (a\n * padded `q=  padded  ` stays padded), and a space typed at the end of a\n * value must survive the next render for the next word to follow it (the\n * table is controlled: trimming here lost it before the next character).\n * A header's value is the text after the colon and its spacing; that\n * spacing is kept on the row and written back as it was.\n */\nexport function parseRows(text: string, kind: RowKind): Row[] | null {\n    const rows: Row[] = []\n    for (const raw of text.split('\\n')) {\n        if (raw.trim() === '') continue\n        const enabled = !raw.startsWith('# ')\n        const line = enabled ? raw : raw.slice(2)\n        const at = line.indexOf(SEPARATOR[kind])\n        if (at < 0) return null\n        const rest = line.slice(at + 1)\n        const spacing = kind === 'headers' ? (/^\\s*/.exec(rest)?.[0] ?? '') : ''\n        rows.push({\n            enabled,\n            name: line.slice(0, at),\n            value: rest.slice(spacing.length),\n            sep: SEPARATOR[kind] + spacing,\n        })\n    }\n    return rows\n}\n\n/** The field's text for these rows: each row on the line it came from, a new row with the default separator. */\nexport function serializeRows(rows: Row[], kind: RowKind): string {\n    return rows.map((r) => `${r.enabled ? '' : '# '}${r.name}${r.sep ?? DEFAULT_SEP[kind]}${r.value}`).join('\\n')\n}\n\n/** How many rows are enabled (the sub-tab's count). */\nexport function enabledCount(text: string, kind: RowKind): number {\n    const rows = parseRows(text, kind)\n    return rows ? rows.filter((r) => r.enabled).length : text.split('\\n').filter((l) => l.trim() !== '' && !l.startsWith('# ')).length\n}\n\n/** `{{base}}/path` → the variable prefix and the rest, for the URL's display. */\nexport function splitUrl(url: string): { base: string; rest: string } {\n    const m = /^(\\{\\{[^}]+\\}\\})(.*)$/.exec(url)\n    return m ? { base: m[1] ?? '', rest: m[2] ?? '' } : { base: '', rest: url }\n}\n\n/** A body's JSON, pretty-printed, or null when it is not JSON. */\nexport { formatJson as prettyJson } from './json-presentation'\nimport type { RunRecord } from '@prisma-airs/desktop-contracts'\n\n/** The inspected response can be a collection-history entry from another request. */\nexport interface DisplayedResponse {\n    record: RunRecord\n    history: boolean\n}\n\n/** Presentation state only. No request/credential authority moves into the footer. */\nexport interface EditorStatus {\n    save: { text: string; state: 'new' | 'unsaved' | 'saved' }\n    response: DisplayedResponse | null\n}\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_9","type":"command_execution","command":"/bin/zsh -lc \"sed -n '1,260p' apps/desktop/src/v2/workbench/api-client.tsx\"","aggregated_output":"import { useCallback, useEffect, useMemo, useRef, useState } from 'react'\nimport { createPortal } from 'react-dom'\nimport type { DocumentView, ImportNote, ShellSnapshot, WorkbenchView as WorkbenchState } from '@prisma-airs/desktop-contracts'\nimport type { Dispatch } from '../../modules/tenants/dispatch'\nimport { type ObserveWorkbench, type WorkbenchCall, resultText, sizeText, workbenchCall } from '../../modules/workbench/workbench-call'\nimport { Btn } from '../controls'\nimport { Glyph } from '../icons'\nimport { Modal } from '../modal'\nimport { API_COPY as C, methodColor } from './copy'\nimport { type EditorHandle, RequestEditor } from './request-editor'\nimport { RequestTree, requestName } from './request-tree'\nimport { type Run, type Tool, ToolsSheet } from './tools-sheet'\nimport { tone, elapsedText } from './response-pane'\nimport { clockOf } from '../copy'\nimport type { EditorStatus } from './presentation-status'\nimport { PageIntro } from '../page-intro'\nimport { useShellStore } from '../store'\n\nexport interface ApiClientProps {\n    snapshot: ShellSnapshot\n    dispatch: Dispatch\n    observe: ObserveWorkbench\n}\n\ntype Closing = { kind: 'tab'; id: string; name: string } | { kind: 'collection' }\nconst TOOLS: Tool[] = ['environments', 'secrets', 'schemas', 'import', 'git']\nconst faint = { color: 'var(--v2-faint)' }\nconst soft = { color: 'var(--v2-soft)' }\n// A chip never widens the title row: it shrinks and truncates within it (a 900-point window at 200% overflowed by its width).\nconst CHIP = 'flex h-8 max-w-full min-h-0 min-w-0 items-center truncate rounded-[7px] border text-[13px]'\nconst chipStyle = {\n    gap: 8,\n    padding: '0 12px',\n    borderColor: 'var(--v2-rule)',\n    background: 'var(--v2-paper)',\n    color: 'var(--v2-ink)',\n}\n\n/**\n * The API Client as R2App draws it (C41): the title row with the\n * Collection and Environment chips, the 286px request tree, the open\n * requests' tabs, the request line, sub-tabs and response pane, the\n * footer. New components over the workbench intents: the C14/C15\n * behaviour (local-first collections, drafts protected on this Mac,\n * reviewed tenant-credential changes, immutable history) is unchanged.\n * Rust owns each document's revision, conflicts and the private drafts;\n * nothing in this view sends a request by itself.\n */\nexport function ApiClient({ snapshot, dispatch, observe }: ApiClientProps) {\n    const call = useMemo(() => workbenchCall(dispatch, observe), [dispatch, observe])\n    const state = snapshot.workbench\n    const collection = state.collection\n    const [message, setMessage] = useState('')\n    const messageAction = useRef(0)\n    const [offerNew, setOfferNew] = useState(false)\n    const [tool, setTool] = useState<Tool | null>(null)\n    const [menu, setMenu] = useState(false)\n    const [doc, setDoc] = useState<DocumentView | null>(null)\n    // Counts documents arriving from the core: the editor is keyed by it, so a reloaded document always starts a fresh\n    // editor (the same id and revision under one key kept the old editor's fields).\n    const [docSeq, setDocSeq] = useState(0)\n    const [notes, setNotes] = useState<ImportNote[]>([])\n    const loading = useRef<string | null>(null)\n    // Each load of the selected request has a generation; a result from an earlier load is obsolete (two selections\n    // in flight resolving out of order replaced the current request's document with the earlier one's).\n    const loadGen = useRef(0)\n    // A load that failed, by request id, with its reason: shown in place of the editor with Try again (no automatic retry).\n    const [loadFailure, setLoadFailure] = useState<{ id: string; relative: string; text: string } | null>(null)\n    const [editorStatus, setEditorStatus] = useState<{ owner: string; value: EditorStatus } | null>(null)\n    const statusOwner = useRef<string | null>(null)\n    const tabStrip = useRef<HTMLDivElement>(null)\n    const tenant = snapshot.active?.tenant ?? null\n    const context = snapshot.active?.context ?? null\n    const startupFailure = useShellStore((s) => s.workbenchRecovery.tenant === tenant && s.workbenchRecovery.context === context && s.workbenchRecovery.failed)\n    const startupMessage = useShellStore((s) => s.workbenchRecovery.tenant === tenant && s.workbenchRecovery.context === context ? s.workbenchRecovery.message : '')\n    const restorePreferred = useCallback(async () => {\n        const recovery = useShellStore.getState()\n        const generation = recovery.beginWorkbenchRestore(tenant, context)\n        if (generation === null) return { kind: 'cancelled' } as const\n        const action = ++messageAction.current\n        const result = await call({ kind: 'load' })\n        const current = useShellStore.getState().workbenchRecovery\n        // A successful retry retires its prior alternative-open message, even if the opened snapshot arrived first.\n        // Another action, context or collection generation must keep its own message.\n        const currentChoice = current.generation === generation || (current.collection !== null && current.generation === generation + 1)\n        if (action === messageAction.current && current.tenant === tenant && current.context === context && currentChoice && (result.kind === 'opened' || result.kind === 'done')) {\n            setMessage('')\n            setOfferNew(false)\n        }\n        // Admission/delivery/observation failure is still unresolved, including on the first load.\n        // Only a positive owned result may retire recovery; keep sanitized text with its scope.\n        const resolved = result.kind === 'opened' || result.kind === 'done'\n        const deliveryMessage = result.kind === 'undelivered' ? resultText(result) ?? '' : result.kind === 'cancelled' ? recovery.workbenchRecovery.message : ''\n        recovery.finishWorkbenchRestore(tenant, context, generation, !resolved, deliveryMessage)\n        return result\n    }, [call, tenant, context])\n    const editors = useRef(new Map<string, EditorHandle>())\n    const [closing, setClosing] = useState<Closing | null>(null)\n    // The Collection chip: where focus returns when its menu or a tool it opened closes (the menu item is gone by then).\n    const chip = useRef<HTMLButtonElement>(null)\n\n    // A refusal stays shown until the next action that succeeds (a cancelled sheet keeps it).\n    const run: Run = async (request) => {\n        if (request.kind !== 'load') ++messageAction.current\n        const generation = useShellStore.getState().workbenchRecovery.generation\n        const r = request.kind === 'load' ? await restorePreferred() : await call(request)\n        if (request.kind === 'load') return r\n        if (['openFolder', 'openRecent', 'openBuiltIn', 'createCollection', 'closeCollection'].includes(request.kind) && ['done', 'opened', 'created'].includes(r.kind)) {\n            useShellStore.getState().resolveWorkbenchRestore(tenant, context, generation)\n        }\n        const text = resultText(r)\n        if (text) {\n            setMessage(text)\n            setOfferNew(r.kind === 'refused' && r.problem.kind === 'project' && r.problem.detail === 'notCollection')\n        } else if (r.kind !== 'cancelled') {\n            setMessage('')\n            setOfferNew(false)\n        }\n        return r\n    }\n\n    // Closing protects the latest typing first. If that fails, or Rust still\n    // sees unprotected edits, the operator chooses: keep editing, or close\n    // and discard them.\n    const close = async (target: Closing, discard = false) => {\n        setClosing(null)\n        const handles = target.kind === 'tab' ? [editors.current.get(target.id)] : [...editors.current.values()]\n        if (discard) {\n            for (const h of handles) h?.aban