l choice and must not dismiss recovery.\n402:        restored = true\n438:    it.each([['initial', 'busy'], ['initial', 'lost'], ['retry', 'busy'], ['retry', 'lost']] as const)('keeps %s restore delivery recovery actionable after %s across Home and back', async (stage, failure) => {\n491:    it('uses only the restore warning for a core refusal after an undelivered load', async () => {\n524:    it('settles an in-flight restore after remount without duplicate loads and ignores its reply after context retirement', async () => {\n558:    it('draws the title row with the chips, the tree, the tabs, the request line, the sub-tabs, the response pane and the footer (V2-T14)', async () => {\n603:    it('searches the tree flat, says when nothing matches and clears; a collapsed folder hides its requests', async () => {\n626:    it('edits Params as rows that are written back as the file’s name=value lines, protected after the typing pause, and shown as text on request', async () => {\n665:    it('keeps a value as typed, word by word, in Params and Headers, and leaves a padded query value verbatim when another row is edited: Save and Send carry the exact lines (attempt-02 R1)', async () => {\n700:    it('shows the response under Body (pretty, then Raw), Headers, Details and History, where an older run is shown as recorded (I5)', async () => {\n749:    it('keeps a transfer in flight, with Cancel request, in view while an older run from History is being inspected; Cancel dispatches the active run once, history stays as recorded, nothing is resent (attempt-03 R1)', async () => {\n783:    it('shows every transfer in flight for the request with its own Cancel: two deferred sends across a tab round trip, each cancelled by its own id exactly once, nothing resent (attempt-04 R1)', async () => {\n831:    it('an obsolete document result never replaces the current selection: two selections in flight resolve out of order and the later selection stays usable (attempt-05 R1)', async () => {\n863:    it('a selected request whose load fails says why and offers Try again, which reopens it once; a lost delivery is said too (attempt-05 R2)', async () => {\n898:    it('a tool\\'s failure is said inside its sheet, with the entered work and focus kept (attempt-05 R3)', async () => {\n913:    it('a tree click\\'s late reply never replaces the current selection: the selection moves on while the reply is held, and its release changes nothing (attempt-06 R1)', async () => {\n943:    it('closing and re-opening a collection while its selected request\\'s first load is held loads it afresh, and the old reply is ignored (attempt-06 R2)', async () => {\n973:    it('a refused or undelivered creation is said inside the New request dialog, for a request and for a folder, with the path and focus kept (attempt-06 R3)', async () => {\n994:    it('a cURL import\\'s late reply never replaces the current selection: held past the draft\\'s selection, the sheet closing and another selection, it is ignored (attempt-07 R1)', async () => {\n1032:    it('a cURL import\\'s reply held across a collection close and re-open is ignored; the re-opened selection loads afresh (attempt-07 R1)', async () => {\n1059:    it('an unselected tree entry whose load is refused, then lost, says so above the current editor, which stays; Try again reopens it once each time (attempt-07 R2)', async () => {\n1084:    it('a cURL import\\'s conversion report shows with its draft whether the result or the selecting snapshot arrives first; later selections stay protected (attempt-08 R2)', async () => {\n1117:    it('a cURL import\\'s conversion report shows when the result arrives before the selecting snapshot (attempt-08 R2)', async () => {\n1135:    it('typing while an environment or schema save is pending is kept: the reply brings the revision, the next Save sends the newer text (attempt-08 R1)', async () => {\n1199:    it('returning to an edited request after its editor unmounted reloads it from the core: the protected fields come back, never the old snapshot (attempt-09 R1)', async () => {\n1245:    it('a superseded environment or schema open cannot replace the current editor or its typing: a newer selection, a new resource or Close retires it (attempt-09 R2)', async () => {\n1310:    it('reads the preview for Variables and Preview, and the Collection chip’s menu opens the tools sheet, refreshes and closes the collection', async () => {\n1339:    it('creates a request draft from + and shows it new; a tab with edits the core could not protect closes only after the operator chooses to discard them', async () => {\n1402:    it('re-opens the selected request when the same collection is closed and opened again: following its selection is scoped to the open collection', async () => {\n1420:    it.each([\n1490:    it('draws nested folders as a hierarchy: a collapsed folder hides its whole subtree, a folder counts every request under it, and search still finds them', async () => {\n1531:    it('opens a collection tool from the keyboard; closing the sheet by Escape or its close control returns focus to the Collection chip, as the menu does on Escape (I8, T09)', async () => {\n1565:    it('a send from an already dirty request announces response metrics separately from its save state', async () => {\n1579:    it('a send from a new request announces response metrics without replacing \"New · not saved yet\"', async () => {\n1608:    it('shows the start panel with recents and no profile import when no collection is open, and the built-in collection opens from it', async () => {\ncrates/desktop-core/tests/workbench_execution/main.rs:594:async fn refinement_response_suggestions_normalize_whitespace_without_renaming_the_chosen_destination()\ncrates/desktop-core/tests/workbench_documents/main.rs:152:async fn refinement_startup_defaults_once_and_remembers_an_explicit_close() {\ncrates/desktop-core/tests/workbench_documents/main.rs:184:async fn refinement_startup_restores_custom_choice_and_does_not_replace_missing_or_changed_folders()\ncrates/desktop-core/tests/workbench_documents/main.rs:240:async fn refinement_startup_rejects_a_redirected_custom_root_even_with_the_same_collection_id() {\n[\n  {\n    \"id\": \"C48-N01\",\n    \"check\": \"Editable request JSON and complete URL show colored tokens once while native input owns text/cursor/selection/IME/copy. Pretty JSON colors exact large-integer/escape tokens; invalid/truncated preview degrades safely. Raw/copy/saved bytes remain exact; Save is admitted exactly once.\"\n  },\n  {\n    \"id\": \"C48-N02\",\n    \"check\": \"Request tabs occupy one horizontally scrolling row and reveal selected/focused tabs. Bottom Ready/request-count status shows only displayed request/run/history metrics; late/background/old-collection replies cannot overwrite it. Active Cancel and separate save state remain usable.\"\n  },\n  {\n    \"id\": \"C48-N03\",\n    \"check\": \"First use loads SCM193; chosen built-in/custom or explicitly closed state survives restart. Missing/replaced/redirected custom root offers recovery without fallback or folder creation. Native Save Response suggests hyphenated whitespace-normalized basename and respects explicitly chosen filename/directory, preserving bytes.\"\n  }\n]\n{\n  \"schema\": \"airs-desktop/p11-review-remediation/1\",\n  \"baseline\": {\n    \"path\": \"docs/planning/evidence/P11/qualification-final-02/qualification.json\",\n    \"sha256\": \"e7817dc4490720470560c3f21124849bdc8a9ab98412f8e1a78c5de62003fd56\"\n  },\n  \"historical_context\": {\n    \"path\": \"docs/planning/evidence/P11/remediation-baseline-01/historical-context.json\",\n    \"sha256\": \"6867415a5b9f6f62c75601f7de2bed6afec3c79e58b2b3588af12e1a9119c7db\"\n  },\n  \"preserved_candidate\": {\n    \"path\": \"docs/planning/evidence/P11/remediation-baseline-01/receipt.json\",\n    \"sha256\": \"2e03f767395d48de3a9dd797b82ad2df6911878ecec5cbe29b5129e11e13bd9e\"\n  },\n  \"current_source\": {\n    \"path\": \"do