{"type":"item.completed","item":{"id":"item_28","type":"command_execution","command":"/bin/zsh -lc \"sed -n '345,557p' apps/desktop/src/v2/workbench/api-client.test.tsx; sed -n '90,120p' apps/desktop/src/app.tsx\"","aggregated_output":"    it('offers explicit restore recovery without automatically opening SCM or creating a missing collection', async () => {\n        const base = fxApi()\n        const closed = { ...base, workbench: { ...base.workbench, collection: null } }\n        const native = scriptedNative({ ...closed, workbench: { ...closed.workbench, loaded: false } })\n        const requests = workbench(native, answers((r) => r.kind === 'load' ? { kind: 'refused', problem: { kind: 'project', detail: 'notCollection' } } : null))\n        const user = userEvent.setup()\n        render(<App client={new DesktopClient(native.transport)} />)\n        await waitFor(() => expect(requests.filter((r) => r.kind === 'load')).toHaveLength(1))\n        await native.push(closed)\n        expect(await screen.findByText(/The preferred collection could not be opened/)).toBeInTheDocument()\n        await user.click(screen.getByRole('button', { name: 'Try again' }))\n        await waitFor(() => expect(requests.filter((r) => r.kind === 'load')).toHaveLength(2))\n        expect(screen.getByRole('button', { name: 'Open collection…' })).toBeInTheDocument()\n        expect(screen.getByRole('button', { name: 'Open Strata Cloud Manager' })).toBeInTheDocument()\n        await native.push(closed)\n        expect(requests.filter((r) => r.kind === 'load')).toHaveLength(2)\n        expect(requests.filter((r) => ['openBuiltIn', 'createCollection', 'openFolder'].includes(r.kind))).toHaveLength(0)\n    })\n\n    it.each(['missing', 'notCollection'] as const)('keeps %s preferred-folder recovery across Home and back until an explicit retry succeeds', async (detail) => {\n        const base = fxApi()\n        const closed = { ...base, workbench: { ...base.workbench, collection: null } }\n        const native = scriptedNative({ ...closed, workbench: { ...closed.workbench, loaded: false } })\n        let restored = false\n        let cancelled = false\n        const requests = workbench(native, answers((r) => r.kind === 'load'\n            ? cancelled ? { kind: 'cancelled' } : restored ? { kind: 'opened', name: 'AIRS' } : { kind: 'refused', problem: { kind: 'project', detail } }\n            : r.kind === 'openFolder' ? { kind: 'refused', problem: { kind: 'project', detail: 'io' } } : null))\n        const user = userEvent.setup()\n        render(<App client={new DesktopClient(native.transport)} />)\n        await waitFor(() => expect(requests.filter((r) => r.kind === 'load')).toHaveLength(1))\n        await native.push(closed)\n        expect(await screen.findByText(/The preferred collection could not be opened/)).toBeInTheDocument()\n        const navigate = async (feature: 'home' | 'apiClient', label: string) => {\n            await user.click(within(screen.getByRole('navigation', { name: 'Destinations' })).getByRole('button', { name: new RegExp(label) }))\n            expect(native.dispatched.at(-1)).toEqual({ kind: 'navigate', feature })\n            await native.push({ ...native.current, activeFeature: feature })\n            await screen.findByRole('heading', { level: 1, name: label })\n        }\n        await navigate('home', 'Home')\n        await navigate('apiClient', 'API Client')\n        expect(screen.getByText(/The preferred collection could not be opened/)).toBeInTheDocument()\n        expect(screen.getByRole('button', { name: 'Try again' })).toBeInTheDocument()\n        expect(requests.filter((r) => r.kind === 'load')).toHaveLength(1)\n        // A failed alternative is not a successful choice and must not dismiss recovery.\n        await user.click(screen.getByRole('button', { name: 'Open collection…' }))\n        await waitFor(() => expect(requests.filter((r) => r.kind === 'openFolder')).toHaveLength(1))\n        expect(screen.getByText(/The preferred collection could not be opened/)).toBeInTheDocument()\n        expect(screen.getByRole('button', { name: 'Try again' })).toBeInTheDocument()\n        await user.click(screen.getByRole('button', { name: 'Try again' }))\n        await waitFor(() => expect(requests.filter((r) => r.kind === 'load')).toHaveLength(2))\n        expect(screen.getByRole('button', { name: 'Try again' })).toBeInTheDocument()\n        cancelled = true\n        await user.click(screen.getByRole('button', { name: 'Try again' }))\n        await waitFor(() => expect(requests.filter((r) => r.kind === 'load')).toHaveLength(3))\n        expect(screen.getByRole('button', { name: 'Try again' })).toBeInTheDocument()\n        cancelled = false\n        restored = true\n        let releaseRestore: (() => void) | undefined\n        if (detail === 'notCollection') {\n            const observe = native.observeWorkbench\n            native.observeWorkbench = async (operation) => {\n                native.observeWorkbench = observe\n                const result = await observe(operation)\n                await new Promise<void>((resolve) => { releaseRestore = resolve })\n                return result\n            }\n        }\n        await user.click(screen.getByRole('button', { name: 'Try again' }))\n        await waitFor(() => expect(requests.filter((r) => r.kind === 'load')).toHaveLength(4))\n        // Both native orders: an opened snapshot may precede the load result.\n        if (detail === 'notCollection') {\n            await waitFor(() => expect(releaseRestore).toBeDefined())\n            await native.push(base)\n            await act(async () => { releaseRestore!() })\n        } else await native.push(base)\n        expect(screen.queryByText(/The preferred collection could not be opened/)).not.toBeInTheDocument()\n        expect(document_().querySelector('[data-slot=workbench-message]')).toBeNull()\n        // The explicit Close preference must remain closed on remount, rather than restoring the default.\n        await user.click(screen.getByRole('button', { name: 'Collection AIRS' }))\n        await user.click(screen.getByRole('menuitem', { name: 'Close collection' }))\n        await waitFor(() => expect(requests.filter((r) => r.kind === 'closeCollection')).toHaveLength(1))\n        await native.push(closed)\n        await navigate('home', 'Home')\n        await navigate('apiClient', 'API Client')\n        expect(screen.getByText('No collection is open.')).toBeInTheDocument()\n        expect(screen.queryByRole('button', { name: 'Try again' })).not.toBeInTheDocument()\n        expect(screen.queryByText(/The preferred collection could not be opened/)).not.toBeInTheDocument()\n        expect(requests.filter((r) => r.kind === 'load')).toHaveLength(4)\n        expect(requests.filter((r) => ['openBuiltIn', 'createCollection'].includes(r.kind))).toHaveLength(0)\n        expect(requests.filter((r) => r.kind === 'openFolder')).toHaveLength(1)\n    })\n\n    it.each([['initial', 'busy'], ['initial', 'lost'], ['retry', 'busy'], ['retry', 'lost']] as const)('keeps %s restore delivery recovery actionable after %s across Home and back', async (stage, failure) => {\n        const base = fxApi()\n        const closed = { ...base, workbench: { ...base.workbench, collection: null } }\n        const native = scriptedNative({ ...closed, workbench: { ...closed.workbench, loaded: false } })\n        let mode: 'missing' | 'busy' | 'lost' | 'opened' = stage === 'initial' ? failure : 'missing'\n        const requests = workbench(native, answers((r) => r.kind === 'load'\n            ? mode === 'opened' ? { kind: 'opened', name: 'AIRS' } : { kind: 'refused', problem: { kind: 'project', detail: 'missing' } }\n            : null))\n        const respond = native.respond\n        native.respond = (intent) => intent.kind === 'workbench' && intent.request.kind === 'load' && mode === 'busy'\n            ? { outcome: 'refusal', refusal: 'busy' } : respond(intent)\n        const observe = native.observeWorkbench\n        native.observeWorkbench = (operation) => {\n            const request = requests.find((_, i) => `op-${i + 1}` === operation)\n            return request?.kind === 'load' && mode === 'lost' ? Promise.reject(new Error('private observation detail must not surface')) : observe(operation)\n        }\n        const loads = () => native.dispatched.filter((intent) => intent.kind === 'workbench' && intent.request.kind === 'load').length\n        const user = userEvent.setup()\n        render(<App client={new DesktopClient(native.transport)} />)\n        await waitFor(() => expect(loads()).toBe(1))\n        if (stage === 'retry') {\n            await native.push(closed)\n            await screen.findByRole('button', { name: 'Try again' })\n            mode = failure\n            await user.click(screen.getByRole('button', { name: 'Try again' }))\n        }\n        const count = stage === 'initial' ? 1 : 2\n        const outcome = failure === 'busy' ? 'The desktop is busy with a previous request. Try again in a moment.' : 'The desktop did not report how the request ended. Check the request before trying again.'\n        const warning = () => document_().querySelector('[data-slot=workbench-message]') as HTMLElement\n        await waitFor(() => expect(warning()).toHaveTextContent(outcome))\n        expect(warning()).toHaveTextContent('The preferred collection could not be opened.')\n        expect(screen.getByRole('button', { name: 'Try again' })).toBeInTheDocument()\n        expect(screen.getByText('No collection is open.')).toBeInTheDocument()\n        expect(loads()).toBe(count)\n        // The initial failure deliberately leaves Rust's loaded=false snapshot unchanged.\n        for (const [feature, label] of [['home', 'Home'], ['apiClient', 'API Client']] as const) {\n            await user.click(within(screen.getByRole('navigation', { name: 'Destinations' })).getByRole('button', { name: new RegExp(label) }))\n            await native.push({ ...native.current, activeFeature: feature })\n            await screen.findByRole('heading', { level: 1, name: label })\n        }\n        expect(warning()).toHaveTextContent(outcome)\n        expect(screen.getByRole('button', { name: 'Try again' })).toBeInTheDocument()\n        expect(loads()).toBe(count)\n        expect(screen.queryByText(/private observation detail/)).not.toBeInTheDocument()\n        mode = 'opened'\n        await user.click(screen.getByRole('button', { name: 'Try again' }))\n        await waitFor(() => expect(loads()).toBe(count + 1))\n        await native.push(base)\n        expect(document_().querySelector('[data-slot=workbench-message]')).toBeNull()\n        expect(screen.queryByRole('button', { name: 'Try again' })).not.toBeInTheDocument()\n        expect(native.dispatched.filter((intent) => intent.kind === 'workbench' && ['openBuiltIn', 'createCollection', 'openFolder'].includes(intent.request.kind))).toHaveLength(0)\n    })\n\n    it('uses only the restore warning for a core refusal after an undelivered load', async () => {\n        const base = fxApi()\n        const native = scriptedNative({ ...base, workbench: { ...base.workbench, loaded: false, collection: null } })\n        let mode: 'busy' | 'cancelled' | 'refused' | 'opened' = 'busy'\n        workbench(native, answers((r) => r.kind === 'load'\n            ? mode === 'opened' ? { kind: 'opened', name: 'AIRS' } : mode === 'cancelled' ? { kind: 'cancelled' } : { kind: 'refused', problem: { kind: 'project', detail: 'notCollection' } }\n            : null))\n        const respond = native.respond\n        native.respond = (intent) => intent.kind === 'workbench' && intent.request.kind === 'load' && mode === 'busy'\n            ? { outcome: 'refusal', refusal: 'busy' } : respond(intent)\n        const loads = () => native.dispatched.filter((intent) => intent.kind === 'workbench' && intent.request.kind === 'load').length\n        const warning = () => document_().querySelector('[data-slot=workbench-message]') as HTMLElement\n        const user = userEvent.setup()\n        render(<App client={new DesktopClient(native.transport)} />)\n        await waitFor(() => expect(warning()).toHaveTextContent('The desktop is busy with a previous request.'))\n        mode = 'cancelled'\n        await user.click(screen.getByRole('button', { name: 'Try again' }))\n        await waitFor(() => expect(loads()).toBe(2))\n        expect(warning()).toHaveTextContent('The desktop is busy with a previous request.')\n        mode = 'refused'\n        await user.click(screen.getByRole('button', { name: 'Try again' }))\n        await waitFor(() => expect(loads()).toBe(3))\n        expect(warning()).toHaveTextContent('The preferred collection could not be opened.')\n        expect(warning()).not.toHaveTextContent(\"That folder isn't empty\")\n        expect(warning()).not.toHaveTextContent('The desktop is busy')\n        expect(screen.getByRole('button', { name: 'Try again' })).toBeInTheDocument()\n        mode = 'opened'\n        await user.click(screen.getByRole('button', { name: 'Try again' }))\n        await waitFor(() => expect(loads()).toBe(4))\n        await native.push(base)\n        expect(document_().querySelector('[data-slot=workbench-message]')).toBeNull()\n    })\n\n    it('settles an in-flight restore after remount without duplicate loads and ignores its reply after context retirement', async () => {\n        const base = fxApi()\n        const closed = { ...base, workbench: { ...base.workbench, collection: null } }\n        const native = scriptedNative({ ...closed, workbench: { ...closed.workbench, loaded: false } })\n        const requests = workbench(native, answers((r) => r.kind === 'load' ? { kind: 'refused', problem: { kind: 'project', detail: 'missing' } } : null))\n        const observe = native.observeWorkbench\n        let release: (() => void) | undefined\n        native.observeWorkbench = async (operation) => {\n            const result = await observe(operation)\n            await new Promise<void>((resolve) => { release = resolve })\n            return result\n        }\n        const user = userEvent.setup()\n        render(<App client={new DesktopClient(native.transport)} />)\n        await waitFor(() => expect(release).toBeDefined())\n        await native.push({ ...native.current, activeFeature: 'home' })\n        await native.push({ ...native.current, activeFeature: 'apiClient' })\n        expect(requests.filter((r) => r.kind === 'load')).toHaveLength(1)\n        await native.push(closed)\n        await act(async () => { release!() })\n        expect(await screen.findByText(/The preferred collection could not be opened/)).toBeInTheDocument()\n        release = undefined\n        await user.click(screen.getByRole('button', { name: 'Try again' }))\n        await waitFor(() => expect(release).toBeDefined())\n        const next = { ...closed, active: { ...closed.active!, context: `cx-${'b'.repeat(24)}` } }\n        await native.push({ ...next, activeFeature: 'home' })\n        await native.push(next)\n        await act(async () => { release!() })\n        expect(screen.getByText('No collection is open.')).toBeInTheDocument()\n        expect(screen.queryByRole('button', { name: 'Try again' })).not.toBeInTheDocument()\n        expect(screen.queryByText(/The preferred collection could not be opened/)).not.toBeInTheDocument()\n        expect(requests.filter((r) => r.kind === 'load')).toHaveLength(2)\n    })\n\n        // ⌘T: the tenant switcher opens; nothing switches until chosen.\n        else if (command.kind === 'tenantSwitcher') useShellStore.getState().setSwitcher(true)\n        // The open API Client request saves (its editor listens).\n        else if (command.kind === 'saveDocument') window.dispatchEvent(new Event(SAVE_DOCUMENT_EVENT))\n        else void v2Preference('The appearance change', { kind: 'setAppearance', theme: command.theme })\n    }\n\n    useEffect(() => {\n        let stop: (() => void) | undefined\n        let cancelled = false\n        client\n            .observeShell({\n                onSnapshot: (next) => {\n                    // The shell's scope follows the snapshot before it renders: a\n                    // notification for another tenant or context is never surfaced.\n                    useShellStore.getState().setScope(next.active?.tenant ?? null, next.active?.context ?? null, next.switchBlocked?.review ?? null)\n                    useShellStore.getState().observeWorkbench(next.active?.tenant ?? null, next.active?.context ?? null, next.workbench.collection?.scope ?? null)\n                    setSnapshot(next)\n                },\n                onMenu: (command) => onMenu.current(command),\n                onError: () => setFailure('The desktop sent an unexpected update.'),\n            })\n            .then(\n                (unsubscribe) => {\n                    if (cancelled) unsubscribe()\n                    else stop = unsubscribe\n                },\n                () => setFailure('The desktop shell could not be observed.')\n            )\n        return () => {\n            cancelled = true\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_29","type":"command_execution","command":"/bin/zsh -lc \"cat tools/p11/review_carry.py; sed -n '432,520p' tools/p11/remediation.py; sed -n '1,100p' tools/p09/phase_packet.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_29","type":"command_execution","command":"/bin/zsh -lc \"cat tools/p11/review_carry.py; sed -n '432,520p' tools/p11/remediation.py; sed -n '1,100p' tools/p09/phase_packet.py\"","aggregated_output":"\"\"\"Dated unchanged-impact carry of three actual full-nine P11 member reviews.\n\nNo review is reissued, rescored or relabelled current. C48 and the phase must\nreview the current qualification; the phase also reviews this carry logic.\n\"\"\"\nfrom pathlib import Path\n\nimport proof\nfrom review_gate import actual_review\n\nread, bound, require, sha, digest = proof.read, proof.bound, proof.require, proof.sha, proof.digest\nCARRIED = ('C46', 'C47', 'C49')\nOLD_QUALIFICATION = 'docs/planning/evidence/P11/qualification-final-03/qualification.json'\nOLD_QUALIFICATION_SHA = '21eb4c44168ce7ce5cd3e01484399fba397b788176e310e5d15df696cebbb218'\nSOURCE = Path('docs/planning/evidence/P11/source-history/S4')\nAPPLICATION = Path('docs/planning/evidence/P11/review-carry-baseline-01/application')\n# Set only after the three-file retry fix freezes. Other production changes\n# must not borrow this one-off decision.\nRETRY_DELTA = {'apps/desktop/src/v2/store.ts': ('8bc2feec3d7de4c6dc8ef31ab6233c88b8209218285917de0c50acd1e70225d8',\n                                  '4612a821dc4779c4af4751ab426d227bcf8458f34e7a71f0ff4137f027850fee'),\n 'apps/desktop/src/v2/workbench/api-client.test.tsx': ('161ad953f06049d464ef001857c3cb59fb221e62ff8d9e255c7a75a99d1cb548',\n                                                       'cf397af69ee6f19b399c64c475aa44d749f3121c8b217816c0d838b585516672'),\n 'apps/desktop/src/v2/workbench/api-client.tsx': ('b95eb3953ff1e51b16012d38c982b4f71cebc39b12c294b383c2134346d43bde',\n                                                  '3116c93e0d83bb997a1edda763223be43b99888e04d90c42ababea574975923b')}\n\n\ndef impact_delta(before, after, declared):\n    changed = sorted(n for n in set(before) | set(after) if before.get(n) != after.get(n))\n    require(RETRY_DELTA and changed == declared, 'review carry source delta missing/undeclared')\n    for name in changed:\n        if name in RETRY_DELTA:\n            require(tuple(files.get(name, {}).get('sha256') for files in (before, after)) == RETRY_DELTA[name],\n                    'review carry is not the frozen retry-only fix')\n        else:\n            require(name.startswith('tools/p11/') or name in (\n                '.gitattributes', 'docs/planning/refinements/2026-11-04/execution.md'),\n                'unlisted behavior/configuration change cannot carry reviews: ' + name)\n    require(set(RETRY_DELTA) <= set(changed), 'retry fix source membership missing')\n    return changed\n\n\ndef dependencies(files):\n    roots = ('apps/desktop/', 'crates/desktop-core/', 'crates/xtask/src/',\n             'packages/desktop-contracts/', 'resources/', 'docs/architecture/', '.cargo/')\n    exact = {'Cargo.toml', 'Cargo.lock', 'rust-toolchain.toml', 'pnpm-lock.yaml',\n             'pnpm-workspace.yaml', 'package.json', 'crates/xtask/Cargo.toml'}\n    return sorted(n for n in files if (n in exact or n.startswith(roots)) and n not in RETRY_DELTA)\n\n\ndef unchanged(before, after, names, identities):\n    needed = dependencies(after)\n    require(names == needed and needed and set(identities) == set(needed)\n            and all(identities[n] == before.get(n) == after.get(n) for n in needed),\n            'carried review dependency identity changed/missing')\n\n\ndef member(root, subject, entry, original_qualification, source_root):\n    original = entry['review']\n    require(subject in CARRIED and original['subject'] == subject\n            and original['attempt'] == 'attempt-02' and entry['reason'], 'unapproved carried member/subject')\n    folder = root/'docs/planning/reviews'/subject/original['attempt']\n    request = read(folder/'request.json')\n    require(request['subject'] == subject and request['qualification'] == original_qualification,\n            'original member reviewed another qualification')\n    # The actual audit/transport and archived source are rechecked. Historical\n    # qualification/source/artifact proofs suffice; do not recursively execute\n    # the old global consumer against newly pinned remediation constants.\n    actual = actual_review(root, subject, original['attempt'], source_root=source_root, evidence=False)\n    require(actual == original and len(actual['scores']) == 5\n            and all(value >= 9 for value in actual['scores'].values()), 'original full-nine review differs')\n    return actual\n\n\ndef qualification_bindings(record, qualified):\n    require(record['schema'] == 'airs-desktop/p11-member-review-carry/1'\n            and set(record['members']) == set(CARRIED)\n            and record['current_qualification'] == qualified\n            and qualified['verified']['qualified'] is True, 'review carry subject/current qualification differs')\n    original = record['original_qualification']\n    require(original['record'] == OLD_QUALIFICATION and original['sha256'] == OLD_QUALIFICATION_SHA,\n            'review carry original qualification differs')\n    return original\n\n\ndef validate(root, path, qualified, source_root=None):\n    record = read(path)\n    original = qualification_bindings(record, qualified)\n    old_record = read(bound(root, {'path': original['record'], 'sha256': original['sha256']}))\n    current_record = read(bound(root, {'path': qualified['record'], 'sha256': qualified['sha256']}))\n    require(record['original_source'] == old_record['source']\n            and record['current_source'] == current_record['source'], 'review carry source references differ')\n    before = read(bound(root, record['original_source']))['files']\n    after = read(bound(root, record['current_source']))['files']\n    require(digest(before) == original['verified']['source_inventory_sha256']\n            and digest(after) == qualified['verified']['source_inventory_sha256'], 'review carry source fingerprints differ')\n    archived = root/SOURCE\n    require(record['original_source_archive'] == str(SOURCE)\n            and {str(p.relative_to(archived)): proof.file_identity(p) for p in archived.rglob('*')\n                 if p.is_file() or p.is_symlink()} == before, 'original reviewed source archive differs')\n    current = (proof.source_inventory(root) if source_root is None or source_root == root else\n        {str(p.relative_to(source_root)): proof.file_identity(p) for p in source_root.rglob('*')\n         if p.is_file() or p.is_symlink()})\n    require(current == after, 'current reviewed source differs')\n    impact_delta(before, after, record['changed_paths'])\n    unchanged(before, after, record['unchanged_dependencies'], record['file_identities'])\n    old_coverage = read(bound(root, old_record['coverage']))\n    old_candidate = read(bound(root, old_coverage['candidate']))\n    require(old_coverage['candidate']['sha256'] == original['candidate_sha256'], 'original reviewed candidate differs')\n    preservation = read(bound(root, record['application_preservation']))\n    app = root/APPLICATION\n    require(record['original_application'] == str(APPLICATION)\n            and preservation['application'] == str(APPLICATION)\n            and preservation['qualification'] == {'path': original['record'], 'sha256': original['sha256']}\n            and preservation['bundle_sha256'] == old_candidate['bundle_sha256']\n            and preservation['executable_sha256'] == old_candidate['executable_sha256']\n            and proof.bundle_hash(app) == old_candidate['bundle_sha256']\n            and sha(app/'Contents/MacOS/prisma-airs-desktop') == old_candidate['executable_sha256'],\n            'original reviewed application was not preserved')\n    return {'members': {subject: member(root, subject, record['members'][subject], original, archived)\n                        for subject in CARRIED},\n            'proof': proof.reference(root, path), 'original_source': archived,\n            'original_qualification': original, 'record': record}\ndef versioned_build(root, build, candidate):\n    path = candidate['prepare']['path']\n    prefix, suffix = 'docs/planning/evidence/P11/native-build-', '-vm/native-prepare.json'\n    number = path.removeprefix(prefix).removesuffix(suffix)\n    require(number.isdigit() and int(number) >= 5 and path == f'{prefix}{int(number):02}{suffix}',\n            'new build may not overwrite the original canonical preparation')\n    argv = ['cargo', 'run', '--locked', '-p', 'xtask', '--example', 'p11_native_candidate', '--', '--out', path]\n    commands = [step['argv'] for step in build['steps']]\n    require(commands and commands[-1] in (argv, argv[:2]+['--offline']+argv[2:])\n            and commands[:-1] in ([], [['pnpm', '--filter', '@prisma-airs/desktop-contracts', 'typecheck'],\n                ['pnpm', '--filter', '@prisma-airs/desktop', 'typecheck']])\n            and build['application_inputs_after'] == build['application_inputs_before'],\n            'versioned native build command/input recipe differs')\n    old = read(root/'docs/planning/evidence/P11/native-prepare.json')\n    current = read(bound(root, candidate['prepare']))\n    require(current['commands'] == old['commands'] and current['target'] == old['target']\n            and current['features'] == old['features'] and current['subject'] == 'P11',\n            'versioned build changed the fixture recipe')\n\n\ndef make(root, receipt_path, out):\n    require(not out.exists(), 'preserve previous remediation qualification')\n    receipt = read(receipt_path)\n    files = read(bound(root, receipt['current_source']))['files']\n    old = read(bound(root, receipt['baseline']))\n    original = read(bound(root, old['coverage']))\n    prepared = read(bound(root, receipt['prepare']))\n    native = read(bound(root, receipt['recovery']))\n    candidate = dict(source_inventory_sha256=digest(files), execution_root=str(root),\n        runner_inputs=receipt['runner_inputs'], dependency_fingerprint=receipt['runner_inputs']['dependencies'],\n        prepare=receipt['prepare'], executable_sha256=prepared['executable_sha256'],\n        bundle_sha256=prepared['bundle_sha256'], build_flags={'target': prepared['target'], 'features': prepared['features']},\n        conditions=read(bound(root, native['raw']))['conditions'], helper_closure=native['helper_closure'])\n    history = ArchivedP11(root, receipt['historical_context'])\n    out.mkdir(parents=True)\n    def write(name, value):\n        p = out/name; p.parent.mkdir(parents=True, exist_ok=True)\n        with p.open('x') as stream: json.dump(value, stream, indent=2); stream.write('\\n')\n        return proof.reference(root, p)\n    candidate_ref = write('candidate.json', candidate)\n    requirements = copy.deepcopy(read(bound(root, original['plan']))['requirements'])\n    by_id = {r['id']: r for r in requirements}; rows = []\n    for original_row in original['coverage']:\n        cid = original_row['id']; needed = by_id[cid]\n        affected = cid in SOURCE_IDS | {'C48-N03'}\n        needed.update(affected=affected, must_execute=affected)\n        if affected:\n            result = write('results/'+cid.replace(':', '-').replace('/', '-')+'.json', {\n                'schema': 'airs-desktop/p11-affected-selector-result/1', 'required_id': cid,\n                'actual_evidence': selector_reference(receipt, cid),\n                'original_result': original_row['result'],\n                'meaning': 'Actual affected selectors supplement the retained original registered goal. No full original command or unrelated native flow is claimed newly executed.'})\n            rows.append(dict(id=cid, disposition='executed', result=result))\n            continue\n        result = read(bound(root, original_row['result'])); origin = read(bound(root, result['candidate']))\n        deps = dependencies(files, cid, needed.get('helper_paths', [])); needed['dependencies'] = deps\n        old_source = history.source(origin['source_inventory_sha256'])\n        bindings = {name: {'original_sha256': sha(old_source/name), 'current_sha256': sha(root/name),\n            'original_file': proof.reference(root, old_source/name)} for name in deps}\n        impact = write('impact/'+cid.replace(':', '-').replace('/', '-')+'.json', {\n            'file_bindings': bindings, 'unchanged_dependencies': deps,\n            'current_source_inventory_sha256': digest(files), 'original_candidate_sha256': result['candidate']['sha256']})\n        rows.append(dict(id=cid, disposition='carried_unaffected', result=original_row['result'], impact={\n            'reason': receipt['unaffected'][cid], 'dependencies': deps, 'proof': impact,\n            'original_candidate_sha256': result['candidate']['sha256']}))\n    plan = {'schema': 'airs-desktop/required-coverage/1', 'subject': 'P11', 'requirements': requirements}\n    plan_ref = write('required-coverage.json', plan)\n    generic_ids = {r['id'] for r in rows if r['disposition'] == 'carried_unaffected' and not r['id'].startswith('check:')}\n    runtime = write('runtime-required-coverage.json', dict(plan,\n        requirements=[r for r in requirements if r['id'] in generic_ids]))\n    qualified = write('coverage.json', {'schema': 'airs-desktop/qualified-coverage/1', 'plan': plan_ref,\n        'candidate': candidate_ref, 'source_inventory_sha256': digest(files), 'coverage': rows,\n        'runtime_plan': runtime, 'review_remediation': proof.reference(root, receipt_path)})\n    record = {'schema': 'airs-desktop/p11-shared-qualification/1', 'source': receipt['current_source'],\n        'coverage': qualified, 'runner_inputs': receipt['runner_inputs'], 'fingerprint': receipt['fingerprint'],\n        'native_execution': native['raw'], 'build': receipt['build'], 'runs': old['runs'],\n        'historical_baseline': old['historical_baseline'], 'historical_standing': old['historical_standing'],\n        'review_remediation': proof.reference(root, receipt_path), 'controller_complete': False,\n        'historical_use': 'Original qualification02 results/artifacts remain bound. Only explicit affected source selectors and native recovery execute anew; unrelated results retain original process/source/artifact provenance.'}\n    path = write('qualification.json', record)\n    return proof.verify(root, root/path['path'])\n\n\nif __name__ == '__main__':\n    parser = argparse.ArgumentParser(description=__doc__)\n    parser.add_argument('receipt', type=Path)\n    parser.add_argument('--out', required=True, type=Path)\n    args = parser.parse_args()\n    print(json.dumps(make(Path.cwd().resolve(), args.receipt.resolve(), args.out.resolve()), indent=2))\n\"\"\"Current P09 packet and post-review audit; independent review remains external.\"\"\"\nfrom pathlib import Path\nimport argparse\nimport hashlib\nimport json\nimport os\nimport stat\nimport subprocess\nimport time\n\nimport phase_inputs as inputs\n\nPREVIOUS_PHASE = '6a7253c2'\n\n\ndef digest(value):\n    return hashlib.sha256((json.dumps(value, sort_keys=True, separators=(',', ':')) + '\\n').encode()).hexdigest()\n\n\ndef file_identity(path):\n    metadata = path.lstat()\n    value = {'mode': stat.S_IMODE(metadata.st_mode)}\n    if path.is_symlink():\n        value.update(kind='symlink', target=os.readlink(path))\n    else:\n        inputs.require(path.is_file(), 'unsupported source kind: ' + str(path))\n        value.update(kind='file', sha256=inputs.sha(path))\n    return value\n\n\ndef source_inventory(root):\n    names = subprocess.check_output(['git', 'ls-files', '-z', '--cached', '--others', '--exclude-standard'], cwd=root).decode().split('\\0')\n    excluded = ('docs/planning/evidence/', 'docs/planning/reviews/')\n    def active_tool(name):\n        return ((name.startswith('docs/planning/evidence/P09/native-controller/') and name.endswith('.py'))\n                or name in ['docs/planning/evidence/P09/runs/hash-inputs.sh', 'docs/planning/evidence/P09/runs/run-checks.sh'])\n    return {name: file_identity(root / name) for name in sorted(set(names))\n            if name and name != 'docs/planning/status.md' and (not name.startswith(excluded) or active_tool(name))\n            and ((root / name).exists() or (root / name).is_symlink())}\n\n\ndef live_evidence(root):\n    path = root / 'docs/planning/evidence/C29/live/L19-verify.json'\n    live = inputs.read(path)\n    inputs.require(live['status'] == 'pass' and live['temporary_local_credentials_removed'], 'L19 pass/cleanup missing')\n    inputs.require(live['budget']['total_reserved'] == 3 and live['budget']['refunded'] == 0, 'L19 charged budget changed')\n    receipt = root / live['native_receipt']\n    inputs.require(inputs.sha(receipt) == live['native_receipt_sha256'], 'L19 receipt hash mismatch')\n    raw = inputs.read(receipt)\n    inputs.require(raw['status'] == 'pass' and raw['local_credentials_removed'], 'L19 actual receipt not passing/cleaned')\n    archived = root / 'docs/planning/evidence/C29/live/L19/build-02/l19-qualification-executable.bin'\n    inputs.require(inputs.sha(archived) == raw['executable_sha256'], 'L19 historical executable mismatch')\n    return {'record': str(path.relative_to(root)), 'sha256': inputs.sha(path),\n            'native_receipt': str(receipt.relative_to(root)), 'native_receipt_sha256': inputs.sha(receipt),\n            'qualification_executable': str(archived.relative_to(root)), 'qualification_executable_sha256': inputs.sha(archived),\n            'live_calls_performed_by_this_verifier': 0, 'remaining_live_allowance': 0}\n\n\ndef evidence_inventory(root, run_path, verified):\n    files = set()\n    phase = root / 'docs/planning/evidence/P09'\n    prefixes = [phase / 'native', phase / 'parity', phase / 'screens', phase / 'preparations', phase / 'check-remediation', phase / 'performance', phase / 'phase-tooling-history', phase / 'phase-tooling-validation', run_path.parent / inputs.read(run_path)['attempt'],\n                root / 'docs/planning/evidence/C29/live/L19']\n    prefixes += list((phase / 'native-history').glob('*Worf*'))\n    for prefix in prefixes:\n        files.update(p for p in prefix.rglob('*') if p.is_file() and '__pycache__' not in p.parts)\n    files.update(phase / name for name in ['native-prepare.json', 'native-acceptance.json', 'execution.json'])\n    files.add(phase / 'native-build-inputs.json')\n    files.add(phase / 'workload-perf-C30.json')\n    files.add(run_path)\n    files.add(root / 'docs/planning/evidence/C29/live/L19-verify.json')\n    files.add(root / 'docs/planning/reviews/C44/legacy-retirements.md')\n    for member in verified['predecessors']:\n        for key in ['record', 'request', 'receipt', 'audit', 'owner_decision']:\n            if key in member:\n                files.add(root / member[key])\n        if 'record' in member:\n            directory = (root / member['record']).parent\n            for name in ['source-inventory.json', 'diff.patch', 'thread-reply.log']:\n                if (directory / name).is_file():\n                    files.add(directory / name)\n    return {str(p.relative_to(root)): file_identity(p) for p in sorted(files)}\n\n\ndef make(root, attempt, run_path, limitations):\n    inputs.require(attempt.startswith('attempt-') and attempt[8:].isdigit(), 'invalid phase attempt ID')\n    out = root / 'docs/planning/reviews/P09' / attempt\n    inputs.require(not out.exists(), 'preserve existing phase attempt; choose a fresh ID')\n    # No output folder is created until every current gate passes.\n    verified = inputs.verify(root, run_path)\n    live = live_evidence(root)\n    source = source_inventory(root)\n    evidence = evidence_inventory(root, run_path, verified)\n    run = inputs.read(run_path)\n    fingerprints = {'source': digest(source), 'dependencies': run['inputs']['before_digest'],\n                    'build_flags': run['build_flags']['digest'], 'evidence': digest(evidence)}\n    instructions = (root / 'docs/planning/prompts/review-phase.md').read_text().split('```text')[1].split('```')[0]\n    instructions = instructions.replace('PHASE_ID', 'P09').replace('CHUNK_LIST', ', '.join(inputs.MEMBERS)).strip()\n    request_id = 'P09-' + attempt + '-' + str(int(time.time()))\n    request = {'request_id': request_id, 'attempt_id': attempt, 'subject': 'P09', 'kind': 'phase',\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_30","type":"command_execution","command":"/bin/zsh -lc \"python3 -B -c 'import sys,json; from pathlib import Path; sys.path.insert(0,\\\"tools/p11\\\"); import proof; from candidate import verify_candidate; root=Path.cwd(); folder=root/\\\"docs/planning/reviews/C48/attempt-03\\\"; request=proof.read(folder/\\\"request.json\\\");\nfor name,key in ((\\\"source-inventory.json\\\",\\\"source\\\"),(\\\"evidence-inventory.json\\\",\\\"evidence\\\")):\n value=proof.read(folder/name)[\\\"files\\\"]; print(key,proof.digest(value),\\\"matches\\\",proof.digest(value)==request[\\\"fingerprints\\\"][key])\nq=proof.read(root/request[\\\"qualification\\\"][\\\"record\\\"]); c=proof.read(proof.bound(root,q[\\\"coverage\\\"])); print(\\\"current source inventory\\\",proof.source_inventory(root)==proof.read(proof.bound(root,q[\\\"source\\\"]))[\\\"files\\\"]); print(\\\"runner source\\\",proof.xtask_source(root)==q[\\\"runner_inputs\\\"][\\\"source\\\"]); print(\\\"coverage\\\",json.dumps(proof.verify_coverage(root,c),indent=2)); candidate=proof.read(proof.bound(root,c[\\\"candidate\\\"])); verify_candidate(root,candidate); print(\\\"current candidate executable/bundle/helper identities verified\\\")'\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
