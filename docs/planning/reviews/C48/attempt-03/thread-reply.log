desk.adapters;\n    drop(desk.core);\n    let mut again = start(Some(&handles), CoreConfig::default()).await;\n    let result = again.wb(json!({\"kind\": \"load\"})).await;\n    assert_eq!(result[\"kind\"], \"opened\", \"{result}\");\n    assert_eq!(again.workbench()[\"collection\"][\"id\"], \"c14\");\n    drop(again.core);\n    let moved = root.with_file_name(\"moved-api\");\n    std::fs::rename(&root, &moved).expect(\"move owned collection\");\n    let mut missing = start(Some(&handles), CoreConfig::default()).await;\n    assert_eq!(missing.wb(json!({\"kind\": \"load\"})).await[\"kind\"], \"refused\");\n    assert!(missing.workbench()[\"collection\"].is_null());\n    assert!(\n        !root.exists(),\n        \"startup must not recreate the missing folder\"\n    );\n    std::fs::rename(&moved, &root).expect(\"restore owned collection\");\n    assert_eq!(\n        missing.wb(json!({\"kind\": \"load\"})).await[\"kind\"],\n        \"opened\",\n        \"explicit Retry can restore the remembered choice\"\n    );\n    drop(missing.core);\n    let metadata = root.join(\"collection.toml\");\n    let original = std::fs::read_to_string(&metadata).expect(\"metadata\");\n    std::fs::write(\n        &metadata,\n        original.replace(\"id = \\\"c14\\\"\", \"id = \\\"replacement\\\"\"),\n    )\n    .expect(\"replace collection identity\");\n    let mut changed = start(Some(&handles), CoreConfig::default()).await;\n    assert_eq!(changed.wb(json!({\"kind\": \"load\"})).await[\"kind\"], \"refused\");\n    assert!(\n        changed.workbench()[\"collection\"].is_null(),\n        \"never silently open another collection at the old path\"\n    );\n    let profile = desktop_core::workbench::profile::load_profile(\n        &handles.workbench_root,\n        handles.vault.as_ref(),\n    )\n    .expect(\"private profile\");\n    assert!(\n        serde_json::to_value(profile)\n            .expect(\"profile\")\n            .to_string()\n            .contains(\"c14\"),\n        \"keep the remembered preference for recovery\"\n    );\n}\n\n#[tokio::test(flavor = \"multi_thread\")]\nasync fn refinement_startup_rejects_a_redirected_custom_root_even_with_the_same_collection_id() {\n    let root = collection();\n    let mut desk = desk().await;\n    desk.open(&root).await;\n    let handles = desk.adapters;\n    drop(desk.core);\n    let moved = root.with_file_name(\"redirected-api\");\n    std::fs::rename(&root, &moved).expect(\"move owned collection\");\n    std::os::unix::fs::symlink(&moved, &root).expect(\"redirect the remembered path\");\n    let before = project_bytes(&moved);\n    let mut again = start(Some(&handles), CoreConfig::default()).await;\n    let restored = again.wb(json!({\"kind\": \"load\"})).await;\n    assert_eq!(\n        restored[\"kind\"], \"refused\",\n        \"a copied or redirected folder can retain its collection id: {restored}\"\n    );\n    assert!(again.workbench()[\"collection\"].is_null());\n    assert_eq!(project_bytes(&moved), before);\n}\n\n#[tokio::test(flavor = \"multi_thread\")]\nasync fn saves_a_fresh_snapshot_keeping_the_files_layout_and_revisions() {\n    let root = collection();\n    let mut desk = desk().await;\n    assert_eq!(\n        desk.open(&root).await,\n        json!({\"kind\": \"opened\", \"name\": \"Items API\"})\n    );\n    let wb = desk.workbench();\n    assert_eq!(\n        assert_eq!(r[\"run\"][\"record\"][\"uncertain\"], true);\n    }\n    assert_eq!(http.seen().len(), 5);\n}\n\n#[tokio::test(flavor = \"multi_thread\")]\nasync fn refinement_response_suggestions_normalize_whitespace_without_renaming_the_chosen_destination()\n {\n    const BODY: &str = \"{\\\"integer\\\":9007199254740993,\\\"escaped\\\":\\\"\\\\u0061\\\"}\\r\\n\";\n    let http = Http::start(Arc::new(|_| Answer::ok(BODY))).await;\n    let root = collection(\n        &format!(\"base = \\\"{}\\\"\\n\", http.origin()),\n        &[(\n            \"My  request.request.toml\",\n            &request(\"response-name\", \"GET\", \"{{base}}/probe\", \"\"),\n        )],\n    );\n    let mut desk = desk().await;\n    desk.open(&root).await;\n    let r = desk.send_doc(\"My  request.request.toml\").await;\n    let run = r[\"run\"][\"record\"][\"id\"].clone();\n    let folder = temp(\"response name with spaces\");\n    let chosen = folder.join(\"My explicitly chosen name.json\");\n    desk.adapters.folders.reply_save(Some(chosen.clone()));\n    let saved = desk.wb(json!({\"kind\": \"saveResponse\", \"run\": run})).await;\n    assert_eq!(\n        desk.adapters.folders.suggested(),\n        [\"My-request-response.json\"]\n    );\n    assert_eq!(\n        saved,\n        json!({\"kind\": \"responseSaved\", \"bytes\": BODY.len(), \"name\": \"My explicitly chosen name.json\"})\n    );\n    assert_eq!(\n        std::fs::read(&chosen).expect(\"exact exported bytes\"),\n        BODY.as_bytes()\n    );\n}\n\n#[tokio::test(flavor = \"multi_thread\")]\nasync fn large_responses_stream_to_sealed_storage_and_save_exactly() {\n    const LEN: u64 = 20 * 1024 * 1024 + 7;\n    let http = Http::start(Arc::new(|_| Answer::Stream { len: LEN })).await;\n    let root = collection(\n        &format!(\"base = \\\"{}\\\"\\n\", http.origin()),\n        &[(\n            \"big.request.toml\",\n            &request(\"big\", \"GET\", \"{{base}}/big\", \"\"),\n        )],\n    );\n    let mut desk = desk().await;\n    desk.open(&root).await;\n    let r = desk.send_doc(\"big.request.toml\").await;\n    let record = &r[\"run\"][\"record\"];\n    assert_eq!(record[\"bytes\"], LEN, \"{record}\");\n    assert_eq!(record[\"stored\"], true);\n    assert_eq!(r[\"run\"][\"previewBytes\"], 256 * 1024);\n    assert!(\n        r[\"run\"][\"preview\"].is_null(),\n                history::PREVIEW_BYTES,\n            )\n            .unwrap_or_default()\n        })\n        .await\n    } else {\n        Vec::new()\n    };\n    WorkbenchResult::Ran {\n        run: run_view(record, &preview, false),\n    }\n}\n\n/// Saves a stored response body where the operator chooses.\npub(super) async fn save_response(inner: &Arc<Inner>, root: &Path, run: String) -> WorkbenchResult {\n    let scope = match open_scope(inner) {\n        Ok(s) => s,\n        Err(r) => return *r,\n    };\n    match load_history(inner, root, &scope, epoch(inner)).await {\n        None => return retired(),\n        Some(Err(r)) => return refusal(r),\n        Some(Ok(())) => {}\n    }\n    let Some(record) = find_run(inner, &scope, &run) else {\n        return refused(WorkbenchProblem::Missing);\n    };\n    if !record.stored {\n        return WorkbenchResult::SaveResponseFailed {\n            failure: ExportFailure::Body,\n        };\n    }\n    let name = record\n        .relative\n        .rsplit('/')\n        .next()\n        .unwrap_or(\"response\")\n        .trim_end_matches(\".request.toml\");\n    let name = name.split_whitespace().collect::<Vec<_>>().join(\"-\");\n    let json = record.headers.iter().any(|(n, v)| {\n        n.eq_ignore_ascii_case(\"content-type\") && v.to_ascii_lowercase().contains(\"json\")\n    });\n    let suggested = format!(\"{name}-response.{}\", if json { \"json\" } else { \"txt\" });\n    let Some(destination) = inner.adapters.folders.choose_save(suggested).await else {\n        return WorkbenchResult::Cancelled;\n    };\n    let name = destination\n        .file_name()\n        .map(|n| n.to_string_lossy().into_owned())\n        .unwrap_or_default();\n    let keychain = Arc::clone(&inner.adapters.keychain);\n    let private = root.to_path_buf();\n    let written = blocking(Err(ExportFailure::Io), move || {\n        history::export(&private, keychain.as_ref(), &scope, &run, &destination)\n    })\n    .await;\n    match written {\n        Ok(bytes) => WorkbenchResult::ResponseSaved { bytes, name },\n        Err(failure) => WorkbenchResult::SaveResponseFailed { failure },\n    }\n}\n\n/// Clears the open collection's history (not while one of its requests\n/// runs) and, separately, its cookies.\npub(super) async fn