{"type":"item.completed","item":{"id":"item_15","type":"command_execution","command":"/bin/zsh -lc \"cat apps/desktop/src/v2/workbench/json-presentation.tsx apps/desktop/src/v2/workbench/presentation-status.ts; sed -n '260,520p' apps/desktop/src/v2/workbench/api-client.tsx\"","aggregated_output":"import { useLayoutEffect, useMemo, useRef, type CSSProperties } from 'react'\nimport { jsonLanguage } from '@codemirror/lang-json'\nimport { classHighlighter, highlightTree } from '@lezer/highlight'\n\n// Large editable bodies remain ordinary editable text. Highlighting never\n// changes their value or introduces a second body/preview size contract.\nconst HIGHLIGHT_LIMIT = 256 * 1024\nconst TOKEN_LIMIT = 12_000\nconst MONO = \"ui-monospace, 'SF Mono', Menlo, monospace\"\n\n/** JSON whitespace changes only: retain number/string spellings and duplicate keys. */\nexport function formatJson(text: string): string | null {\n    if (text.trim() === '' || text.length > HIGHLIGHT_LIMIT) return null\n    const tree = jsonLanguage.parser.parse(text)\n    const tokens: string[] = []\n    let invalid = false\n    tree.iterate({ enter(node) {\n        if (node.type.isError) invalid = true\n        if (!node.node.firstChild) tokens.push(text.slice(node.from, node.to))\n    } })\n    if (invalid || tokens.length === 0 || tokens.length > TOKEN_LIMIT) return null\n    const parts: string[] = []\n    let depth = 0\n    let length = 0\n    const put = (s: string) => { parts.push(s); length += s.length }\n    const line = () => put(`\\n${'  '.repeat(depth)}`)\n    for (let i = 0; i < tokens.length; i += 1) {\n        const token = tokens[i]!\n        const previous = tokens[i - 1]\n        const next = tokens[i + 1]\n        if (token === '{' || token === '[') {\n            put(token)\n            if (next !== '}' && next !== ']') {\n                depth += 1\n                if (depth > 64) return null\n                line()\n            }\n        } else if (token === '}' || token === ']') {\n            if (previous !== '{' && previous !== '[') { depth -= 1; line() }\n            put(token)\n        } else if (token === ',') { put(','); line() }\n        else if (token === ':') put(': ')\n        else put(token)\n        if (length > 1024 * 1024) return null\n    }\n    return parts.join('')\n}\n\nfunction color(classes: string): string {\n    if (classes.includes('propertyName')) return 'var(--v2-acc)'\n    if (classes.includes('string')) return 'var(--v2-ok)'\n    if (classes.includes('number') || classes.includes('bool') || classes.includes('null')) return 'var(--v2-flag)'\n    return 'var(--v2-soft)'\n}\n\nexport function JsonText({ text, numbered = false }: { text: string; numbered?: boolean }) {\n    const ranges = useMemo(() => {\n        if (text.length > HIGHLIGHT_LIMIT) return []\n        const ranges: { from: number; to: number; classes: string }[] = []\n        highlightTree(jsonLanguage.parser.parse(text), classHighlighter, (from, to, classes) => ranges.push({ from, to, classes }))\n        return ranges.length > TOKEN_LIMIT ? [] : ranges\n    }, [text])\n    let rangeIndex = 0\n    const paint = (from: number, to: number) => {\n        const out = []\n        let offset = from\n        while (rangeIndex < ranges.length && ranges[rangeIndex]!.to <= from) rangeIndex += 1\n        for (let i = rangeIndex; i < ranges.length; i += 1) {\n            const r = ranges[i]!\n            if (r.from >= to) break\n            const start = Math.max(from, r.from)\n            const end = Math.min(to, r.to)\n            if (start > offset) out.push(text.slice(offset, start))\n            out.push(<span key={start} data-json-token={r.classes} style={{ color: color(r.classes) }}>{text.slice(start, end)}</span>)\n            offset = end\n        }\n        out.push(text.slice(offset, to))\n        return out\n    }\n    if (!numbered) return <>{paint(0, text.length)}</>\n    let offset = 0\n    return <>{text.split('\\n').map((line) => {\n        const from = offset\n        offset += line.length + 1\n        return <span key={from} data-line=''>{paint(from, from + line.length)}{'\\n'}</span>\n    })}</>\n}\n\n/** A native textarea owns editing, selection, IME and copy. Its inert color layer is never a second input. */\nexport function JsonBodyEditor({ id, value, readOnly, style, onChange }: { id: string; value: string; readOnly: boolean; style: CSSProperties; onChange: (text: string) => void }) {\n    const paint = useRef<HTMLPreElement>(null)\n    const input = useRef<HTMLTextAreaElement>(null)\n    const highlighted = value.length <= HIGHLIGHT_LIMIT\n    const sync = () => {\n        if (!input.current || !paint.current) return\n        // A non-overlay native scrollbar reduces the textarea's text width.\n        // Match that width before wrapping the inert color layer.\n        if (input.current.clientWidth > 0) paint.current.style.width = `${input.current.clientWidth + 2}px`\n        paint.current.scrollTop = input.current.scrollTop\n        paint.current.scrollLeft = input.current.scrollLeft\n    }\n    useLayoutEffect(() => {\n        sync()\n        if (!input.current || typeof ResizeObserver === 'undefined') return\n        const observer = new ResizeObserver(sync)\n        observer.observe(input.current)\n        return () => observer.disconnect()\n    }, [highlighted])\n    const shared: CSSProperties = { ...style, fontFamily: MONO, fontWeight: 400, letterSpacing: 'normal', whiteSpace: 'pre-wrap', overflowWrap: 'break-word', tabSize: 4 }\n    return <div className='relative min-w-0' data-slot='json-body-editor'>\n        {highlighted ? <pre ref={paint} aria-hidden='true' style={{ ...shared, position: 'absolute', inset: 0, margin: 0, height: '100%', overflow: 'hidden', pointerEvents: 'none', borderColor: 'transparent' }}><JsonText text={value} />{value.endsWith('\\n') ? ' ' : ''}</pre> : null}\n        <textarea ref={input} id={id} value={value} readOnly={readOnly} spellCheck={false} style={{ ...shared, display: 'block', position: 'relative', background: highlighted ? 'transparent' : style.background, color: highlighted ? 'transparent' : 'var(--v2-ink)', caretColor: 'var(--v2-ink)' }} onScroll={sync} onChange={(e) => onChange(e.target.value)} />\n    </div>\n}\n\n/** One complete template string, with noninteractive inline variable color. */\nexport function UrlTemplateInput({ label, value, onChange }: { label: string; value: string; onChange: (text: string) => void }) {\n    const paint = useRef<HTMLPreElement>(null)\n    const parts = value.split(/(\\{\\{[^{}]+\\}\\})/g)\n    const shared: CSSProperties = { fontFamily: MONO, fontSize: 12.5, lineHeight: '32px', letterSpacing: 'normal', padding: 0, border: 0, margin: 0 }\n    return <span className='relative min-w-0 flex-grow' data-slot='template-input'>\n        <pre ref={paint} aria-hidden='true' style={{ ...shared, position: 'absolute', inset: 0, overflow: 'hidden', whiteSpace: 'pre', pointerEvents: 'none', color: 'var(--v2-ink)' }}>{parts.map((part, i) => part.startsWith('{{') && part.endsWith('}}') ? <span key={i} data-variable='' style={{ color: 'var(--v2-acc)' }}>{part}</span> : part)}</pre>\n        <input aria-label={label} value={value} autoComplete='off' spellCheck={false} className='relative min-h-0 min-w-0 w-full bg-transparent' style={{ ...shared, borderRadius: 0, minHeight: 0, background: 'transparent', color: 'transparent', caretColor: 'var(--v2-ink)' }} onScroll={(e) => { if (paint.current) paint.current.scrollLeft = e.currentTarget.scrollLeft }} onChange={(e) => onChange(e.target.value)} />\n    </span>\n}\nimport type { RunRecord } from '@prisma-airs/desktop-contracts'\n\n/** The inspected response can be a collection-history entry from another request. */\nexport interface DisplayedResponse {\n    record: RunRecord\n    history: boolean\n}\n\n/** Presentation state only. No request/credential authority moves into the footer. */\nexport interface EditorStatus {\n    save: { text: string; state: 'new' | 'unsaved' | 'saved' }\n    response: DisplayedResponse | null\n}\n        } else if (editorFor.current !== null) {\n            staleDoc.current = editorFor.current\n            editorFor.current = null\n        }\n    }, [editorUp, doc])\n    const loaded = state.loaded\n    useEffect(() => {\n        if (!loaded && !useShellStore.getState().workbenchRecovery.failed) void restorePreferred()\n    }, [loaded, restorePreferred])\n    // The collection menu closes on Escape (focus back on the chip) and on a click elsewhere.\n    useEffect(() => {\n        if (!menu) return\n        const onKey = (e: KeyboardEvent) => {\n            if (e.key !== 'Escape') return\n            setMenu(false)\n            chip.current?.focus()\n        }\n        const onClick = () => setMenu(false)\n        window.addEventListener('keydown', onKey)\n        window.addEventListener('click', onClick)\n        return () => {\n            window.removeEventListener('keydown', onKey)\n            window.removeEventListener('click', onClick)\n        }\n    }, [menu])\n\n    const where = collection ? (collection.builtIn ? C.chips.builtIn : collection.folder) : ''\n    const environment = collection?.environments.find((e) => e.name === collection.environment) ?? null\n    const editorOwner = doc && docCollection.current === collectionKey && selected === doc.id ? `${collectionKey}:${doc.id}:${docSeq}` : null\n    statusOwner.current = editorOwner\n    const displayedStatus = editorStatus?.owner === editorOwner ? editorStatus.value : null\n    const displayed = displayedStatus?.response ?? null\n    useEffect(() => { tabStrip.current?.querySelector('[role=\"tab\"][aria-selected=\"true\"]')?.scrollIntoView({ block: 'nearest', inline: 'nearest' }) }, [collectionKey, selected])\n\n    const band = (\n        <div\n            data-slot='page-header-v2'\n            className='flex shrink-0 flex-wrap items-end'\n            style={{\n                gap: 12,\n                padding: 'var(--v2-page-top) var(--v2-page-x) 18px',\n                borderBottom: '1px solid var(--v2-rule)',\n            }}\n        >\n            <PageIntro className='w-full' description={<span data-slot='api-lead'>{collection ? C.description : C.leadNone}</span>} actions={collection ? (\n                <div className='ml-auto flex min-w-0 max-w-full flex-wrap items-center' style={{ gap: 8 }} data-slot='api-chips'>\n                    <span className='relative'>\n                        <button\n                            ref={chip}\n                            type='button'\n                            aria-haspopup='menu'\n                            aria-expanded={menu}\n                            aria-label={`${C.chips.collection} ${collection.name}`}\n                            className={CHIP}\n                            style={chipStyle}\n                            onClick={(e) => {\n                                e.stopPropagation()\n                                setMenu((m) => !m)\n                            }}\n                            data-slot='collection-chip'\n                        >\n                            <Glyph name='folder' size={13} color='var(--v2-ink)' />\n                            <span style={faint}>{C.chips.collection}</span>\n                            <b>{collection.name}</b>\n                            <span style={faint}>{where}</span>\n                            <Glyph name='chev' size={10} color='var(--v2-faint)' />\n                        </button>\n                        {menu ? (\n                            <div\n                                role='menu'\n                                aria-label={C.menu}\n                                className='absolute top-full right-0 z-10 mt-1 flex min-w-52 flex-col rounded-[10px] border p-1 text-[13px]'\n                                style={{\n                                    borderColor: 'var(--v2-rule)',\n                                    background: 'var(--v2-paper)',\n                                    boxShadow: '0 12px 30px rgba(0,0,0,0.18)',\n                                }}\n                                data-slot='collection-menu'\n                            >\n                                <button type='button' role='menuitem' className='rounded-[7px] px-3 py-1.5 text-left' onClick={() => void run({ kind: 'refresh' })}>\n                                    {C.refresh}\n                                </button>\n                                {TOOLS.map((t) => (\n                                    <button key={t} type='button' role='menuitem' className='rounded-[7px] px-3 py-1.5 text-left' aria-haspopup='dialog' onClick={() => setTool(t)}>\n                                        {C.tools[t]}\n                                    </button>\n                                ))}\n                                <button type='button' role='menuitem' className='rounded-[7px] px-3 py-1.5 text-left' onClick={() => void close({ kind: 'collection' })}>\n                                    {C.closeCollection}\n                                </button>\n                            </div>\n                        ) : null}\n                    </span>\n                    <label className={CHIP} style={chipStyle} data-slot='environment-chip'>\n                        <span\n                            aria-hidden\n                            className='rounded-full'\n                            style={{\n                                width: 8,\n                                height: 8,\n                                background: environment ? 'var(--v2-ok)' : 'var(--v2-faint)',\n                            }}\n                        />\n                        <span style={faint}>{C.chips.environment}</span>\n                        <select\n                            aria-label={C.chips.environment}\n                            value={collection.environment ?? ''}\n                            onChange={(e) =>\n                                void run({\n                                    kind: 'selectEnvironment',\n                                    name: e.target.value === '' ? null : e.target.value,\n                                })\n                            }\n                            className='min-h-0 border-0 bg-transparent font-bold'\n                            style={{\n                                border: 0,\n                                minHeight: 0,\n                                height: 24,\n                                padding: 0,\n                                borderRadius: 0,\n                                background: 'transparent',\n                                color: 'var(--v2-ink)',\n                            }}\n                        >\n                            <option value=''>{C.chips.noEnvironment}</option>\n                            {collection.environments.map((e) => (\n                                <option key={e.name} value={e.name}>\n                                    {e.name}\n                                </option>\n                            ))}\n                        </select>\n                        {environment ? <span style={faint}>{C.chips.envOrigin[environment.origin] ?? environment.origin}</span> : null}\n                    </label>\n                </div>\n            ) : null} />\n        </div>\n    )\n\n    const alerts = (\n        <>\n            {state.network !== 'live' ? (\n                <p className='text-[12px]' style={faint} data-slot='workbench-network'>\n                    {state.network === 'loopbackOnly' ? C.network.loopbackOnly : C.network.none}\n                </p>\n            ) : null}\n            {state.failure ? (\n                <p role='alert' className='rounded-[10px] text-[13px]' style={{ padding: '12px 14px', background: 'var(--v2-block-bg)' }}>\n                    {C.privateFailure(state.failure)}\n                </p>\n            ) : null}\n            {message && collection ? (\n                <p role='alert' className='text-[13px]' style={{ color: 'var(--v2-block)' }} data-slot='workbench-message'>\n                    {message}\n                </p>\n            ) : null}\n            {collection?.issues.length ? (\n                <div role='alert' className='rounded-[10px] text-[13px]' style={{ padding: '12px 14px', background: 'var(--v2-flag-bg)' }} data-slot='workbench-issues'>\n                    <p>{C.issues(collection.issues.length, collection.complete)}</p>\n                    <ul className='mt-1 list-disc pl-5 text-[12px]'>\n                        {collection.issues.slice(0, 10).map((i) => (\n                            <li key={`${i.relative}:${i.kind}`}>{`${i.relative}: ${i.kind}`}</li>\n                        ))}\n                    </ul>\n                </div>\n            ) : null}\n            {collection?.unsaved ? (\n                <p role='alert' className='rounded-[10px] text-[13px]' style={{ padding: '12px 14px', background: 'var(--v2-block-bg)' }}>\n                    {C.unsaved(collection.unsaved)}\n                </p>\n            ) : null}\n        </>\n    )\n\n    if (!state.available) {\n        return (\n            <section\n                aria-label={C.title}\n                data-slot='api-client-v2'\n                className='flex min-h-0 min-w-0 flex-grow flex-col'\n                style={{\n                    margin: 'calc(-1 * var(--v2-page-top)) calc(-1 * var(--v2-page-x)) -28px',\n                }}\n            >\n                {band}\n                <p role='alert' className='text-[13px]' style={{ padding: '20px var(--v2-page-x)' }}>\n                    {C.unavailable}\n                </p>\n            </section>\n        )\n    }\n\n    return (\n        <section\n            aria-label={C.title}\n            data-slot='api-client-v2'\n            className='flex min-h-0 min-w-0 flex-grow flex-col'\n            style={{\n                margin: 'calc(-1 * var(--v2-page-top)) calc(-1 * var(--v2-page-x)) -28px',\n            }}\n        >\n            {band}\n            {!collection ? (\n                <div className='flex flex-col' style={{ gap: 12, padding: '20px var(--v2-page-x)' }}>\n                    {alerts}\n                    {state.loaded || startupFailure ? (\n                        <Start state={state} run={run} message={startupFailure ? `${C.start.restoreFailed}${startupMessage ? ` ${startupMessage}` : ''}${message ? ` ${message}` : ''}` : message} offerNew={offerNew} retry={startupFailure ? async () => { await restorePreferred() } : undefined} />\n                    ) : (\n                        <p role='status' className='text-[13px]' style={soft}>\n                            {C.opening}\n                        </p>\n                    )}\n                </div>\n            ) : (\n                <>\n                    <div className='flex min-h-0 flex-grow' data-slot='api-body'>\n                        <RequestTree\n                            collection={collection}\n                            onOpen={open}\n                            onCreate={async (kind, relative) => {\n                                // A new request's document is a load too: bound to this collection and the current generation.\n                                const load = kind === 'request' ? beginLoad(null) : null\n                                const r = await run(kind === 'request' ? { kind: 'newRequest', relative } : { kind: 'newFolder', relative })\n                                if (load) settleLoad(load, r, true)\n                                // The dialog says a refusal or a lost delivery itself (the page behind it is inert).\n                                return r.kind === 'document' || r.kind === 'done' || r.kind === 'cancelled' ? null : (resultText(r) ?? C.unknownFailure)\n                            }}\n                        />\n                        <div className='flex min-h-0 min-w-0 flex-grow flex-col' data-slot='api-main'>\n                            <div\n                                ref={tabStrip}\n                                role='tablist'\n                                aria-label={C.openRequests}\n                                className='flex min-w-0 shrink-0 items-end overflow-x-auto'\n                                onFocusCapture={(e) => (e.target as HTMLElement).scrollIntoView({ block: 'nearest', inline: 'nearest' })}\n                                style={{\n                                    minHeight: 36,\n                                    gap: 2,\n                                    padding: '0 8px',\n                                    borderBottom: '1px solid var(--v2-rule)',\n                                    background: 'var(--v2-side)',\n                                }}\n                                data-slot='workbench-tabs'\n                            >\n                                {collection.tabs.map((t) => {\n                                    const name = requestName(t.relative)\n                                    const on = t.id === collection.selected\n                                    const marks = [t.new ? 'new' : t.draft ? 'unsaved' : '', t.conflict ? `${t.conflict} on disk` : '', t.interrupted ? 'interrupted save' : '']\n                                        .filter(Boolean)\n                                        .join(', ')\n                                    return (\n                                        <span\n                                            key={t.id}\n                                            data-request-tab=''\n                                            className='flex shrink-0 items-center rounded-t-[7px] border border-b-0'\n                                            style={{\n                                                height: 30,\n                                                maxWidth: 240,\n                                                borderColor: on ? 'var(--v2-rule)' : 'transparent',\n                                                background: on ? 'var(--v2-bg)' : 'transparent',\n                                            }}\n                                        >\n","exit_code":0,"status":"completed"}}
