 useRef<string | null>(null)\n    type Load = { gen: number; asked: string | null; id: string | null; relative: string | null }\n    const beginLoad = (id: string | null, relative: string | null = null): Load => {\n        const gen = ++loadGen.current\n        loading.current = id\n        setLoadFailure(null)\n        return { gen, asked: collectionRef.current, id, relative }\n    }\n    /** Shows a load's document if the load is still current; a failure of a selected request's load is shown with its reason. */\n    const settleLoad = (load: Load, r: Awaited<ReturnType<WorkbenchCall>> | null, keepNotes: boolean): boolean => {\n        if (load.asked === null || load.asked !== collectionRef.current) return false\n        if (load.gen !== loadGen.current) {\n            // Superseded, but a current import's report is not lost: when the reply's document is the selected request\n            // (its snapshot came first and its own load took over), its notes are shown with that document.\n            if (keepNotes && r?.kind === 'document' && r.notes.length > 0 && selectedRef.current === r.document.id) {\n                // Shown now if that document is already up (the editor renders only for the selected document), else\n                // when its own load lands.\n                lateNotes.current = { id: r.document.id, notes: r.notes }\n                setNotes(r.notes)\n            }\n            return false\n        }\n        if (loading.current === load.id) loading.current = null\n        if (r?.kind === 'document') {\n            setDoc(r.document)\n            docCollection.current = load.asked\n            setDocSeq((n) => n + 1)\n            setNotes(keepNotes ? r.notes : lateNotes.current?.id === r.document.id ? lateNotes.current.notes : [])\n            if (lateNotes.current && lateNotes.current.id !== r.document.id) lateNotes.current = null\n            return true\n        }\n        // The failure names the request it was for: the core keeps the previous selection when a read fails, so a\n        // tree entry's failure must show without that request ever being selected.\n        if (load.id !== null && load.relative !== null && r?.kind !== 'cancelled') setLoadFailure({ id: load.id, relative: load.relative, text: (r && resultText(r)) ?? C.unknownFailure })\n        return false\n    }\n\n    const selected = collection?.selected ?? null\n    const selectedTab = collection?.tabs.find((t) => t.id === selected) ?? null\n    // The core's selection is followed when it changes, not re-asserted against the document shown: after + the\n    // draft is shown from the core's reply before the snapshot naming it selected arrives, and re-opening the\n    // previously selected request in between made the core select that one again (the draft's tab lost).\n    const followed = useRef<string | null>(null)\n    // Following is scoped to one open collection: closing it forgets the followed selection, so the same\n    // collection re-opened with its persisted selection opens that request again (the editor was left blank).\n    const collectionId = collectionKey\n    useEffect(() => {\n        // A collection boundary (closed, re-opened, or replaced by another collection) retires every load in flight\n        // (its reply is ignored), the loading marker and the document shown: the editor never shows one collection's\n        // fields under another, even when both select a request with the same id (attempt-03 R1), and the new\n        // collection's selected request is loaded afresh.\n        followed.current = null\n        loadGen.current += 1\n        loading.current = null\n        setLoadFailure(null)\n        setDoc(null)\n        setNotes([])\n        lateNotes.current = null\n    }, [collectionId])\n    // Opens a request (the selected tab, or a tree entry); only the latest load's reply counts.\n    const open = (tab: { id: string; relative: string }) => {\n        const load = beginLoad(tab.id, tab.relative)\n        void call({ kind: 'openRequest', relative: tab.relative }).then(\n            (r) => settleLoad(load, r, false),\n            () => settleLoad(load, null, false)\n        )\n    }\n    const openRef = useRef(open)\n    openRef.current = open\n    // The document whose editor is up: the editor owns newer fields and revisions, so once it has unmounted (the\n    // selection moved away) the retained DocumentView is obsolete and a return to that request reloads it from the\n    // core (the old snapshot remounted could be saved over a protected draft, or sent).\n    const editorFor = useRef<string | null>(null)\n    // The document whose editor was up and has since unmounted: obsolete, reloaded on return. A document that never\n    // had its editor up (an import's or a draft's reply shown ahead of its snapshot) is fresh and is reused.\n    const staleDoc = useRef<string | null>(null)\n    const editorUp = doc !== null && selectedTab !== null && doc.id === selectedTab.id\n    useEffect(() => {\n        if (!selectedTab || followed.current === selectedTab.id) return\n        followed.current = selectedTab.id\n        // A load of another request still in flight is obsolete once the selection moves on: its reply must not land.\n        if (loading.current !== null && loading.current !== selectedTab.id) {\n            loadGen.current += 1\n            loading.current = null\n        }\n        const reusable = doc?.id === selectedTab.id && docCollection.current === collectionId && staleDoc.current !== selectedTab.id\n        if (reusable || loading.current === selectedTab.id) return\n        // A stale document is not shown while its reload is in flight: remounted, its editor would start from the old\n        // fields and keep them when the fresh document arrived under the same key.\n        if (doc?.id === selectedTab.id) setDoc(null)\n        openRef.current(selectedTab)\n    }, [selectedTab, doc, collectionId])\n    // Recorded after the selection was followed, so that effect sees which editor was up before this render.\n    useEffect(() => {\n        if (editorUp && doc) {\n            editorFor.current = doc.id\n            staleDoc.current = null\n        } else if (editorFor.current !== null) {\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_10","type":"command_execution","command":"/bin/zsh -lc 'cat apps/desktop/src/v2/workbench/request-editor.tsx apps/desktop/src/v2/workbench/response-pane.tsx'","aggregated_output":"import { useCallback, useEffect, useId, useRef, useState } from 'react'\nimport type { DocumentView, Fields, ImportNote, Preview, RunView, RunningView, SendReviewView } from '@prisma-airs/desktop-contracts'\nimport { type WorkbenchCall, fieldText, resultText, saveRefusalText } from '../../modules/workbench/workbench-call'\nimport { Btn } from '../controls'\nimport { Glyph } from '../icons'\nimport { API_COPY as C, BODY_KINDS, METHODS, methodColor } from './copy'\nimport { type Row, type RowKind, enabledCount, parseRows, serializeRows } from './request-rows'\nimport { ResponsePane } from './response-pane'\nimport { requestName } from './request-tree'\nimport { JsonBodyEditor, UrlTemplateInput } from './json-presentation'\nimport type { DisplayedResponse, EditorStatus } from './presentation-status'\n\n/** File > Save (Cmd+S) arrives from the native menu as this window event. */\nexport const SAVE_DOCUMENT_EVENT = 'airs-save-document'\n/** How long typing pauses before the snapshot is protected on this Mac. */\nexport const PROTECT_DELAY_MS = 400\n\ntype Sub = 'params' | 'headers' | 'body' | 'auth' | 'variables' | 'preview'\nconst SUBS: Sub[] = ['params', 'headers', 'body', 'auth', 'variables', 'preview']\n\nconst same = (a: Fields, b: Fields) =>\n    a.method === b.method && a.url === b.url && a.headers === b.headers && a.query === b.query && a.body === b.body && a.bodyKind === b.bodyKind && a.settings === b.settings\n\n/**\n * What the completion status region announces after Send (C33, known gap 5):\n * \"<request> · <code> · <duration>\". The response body is outside it.\n */\nexport function completionText(record: { relative: string; status: number | null; elapsedMs: number }): string {\n    const code = record.status !== null ? String(record.status) : 'no response'\n    const ms = record.elapsedMs\n    const duration = ms < 1000 ? `${ms} ms` : `${(ms / 1000).toFixed(1)} s`\n    return `${requestName(record.relative)} · ${code} · ${duration}`\n}\n\nconst NOTE_TEXT = (note: ImportNote): string => {\n    switch (note.kind) {\n        case 'flagOmitted':\n            return 'Presentation and globbing flags were left out.'\n        case 'authRemoved':\n            return `The authentication credential was removed: store its value in Secrets as ${note.reference}.`\n        case 'headerReplaced':\n            return `A credential header now uses {{${note.variable}}}: store its value in Secrets as ${note.reference}.`\n        case 'compressed':\n            return '--compressed became Accept-Encoding: identity.'\n        case 'emptyCookie':\n            return 'The empty cookie option added no cookie.'\n    }\n}\n\nconst MONO = \"ui-monospace, 'SF Mono', Menlo, monospace\"\nconst faint = { color: 'var(--v2-faint)' }\nconst soft = { color: 'var(--v2-soft)' }\nexport const TEXTAREA_STYLE = {\n    border: '1px solid var(--v2-rule)',\n    borderRadius: 8,\n    background: 'var(--v2-paper)',\n    color: 'var(--v2-ink)',\n    fontFamily: MONO,\n    fontSize: 12.5,\n    lineHeight: 1.6,\n    padding: 12,\n    minHeight: 140,\n    width: '100%',\n    resize: 'vertical' as const,\n}\n\nexport interface EditorHandle {\n    /** Protects any edit not yet acknowledged; resolves whether everything typed is now kept on this Mac. */\n    flush: () => Promise<boolean>\n    /** The operator chose to close without the latest edits. */\n    abandon: () => void\n}\n\ninterface Props {\n    initial: DocumentView\n    notes: ImportNote[]\n    call: WorkbenchCall\n    schemas: string[]\n    historyKey: string\n    onClosed: (id: string) => void\n    register?: (handle: EditorHandle) => void\n    context?: string | null\n    running?: RunningView[]\n    review?: SendReviewView | null\n    onStatusChange?: (status: EditorStatus | null) => void\n}\n\n/**\n * One request document as R2App draws it (C41): the method, URL and Send\n * on one line with the save state beside them, the Params / Headers / Body\n * / Auth / Variables / Preview sub-tabs on the left and the response pane\n * on the right. The C14/C15 behaviour is the legacy editor's, ported: the\n * editor text lives here (React owns immediate input); Rust owns the\n * baseline and revision; Save and Send take the fields the editor holds at\n * that moment; typing pauses protect the snapshot on this Mac; a reply\n * never overwrites newer typing.\n */\nexport function RequestEditor({ initial, notes, call, schemas, historyKey, onClosed, register, context = null, running = [], review = null, onStatusChange }: Props) {\n    const ids = useId()\n    const [doc, setDoc] = useState(initial)\n    const [fields, setFields] = useState(initial.fields)\n    const fieldsRef = useRef(initial.fields)\n    const revisionRef = useRef(initial.revision)\n    const idRef = useRef(initial.id)\n    const timer = useRef<ReturnType<typeof setTimeout> | null>(null)\n    const editGen = useRef(0)\n    const markedGen = useRef(0)\n    const sentGen = useRef(0)\n    const ackGen = useRef(0)\n    const [status, setStatus] = useState('')\n    const [saving, setSaving] = useState(false)\n    const [preview, setPreview] = useState<Preview | null>(null)\n    const [run, setRun] = useState<RunView | null>(null)\n    const [displayed, setDisplayed] = useState<DisplayedResponse | null>(null)\n    const reportStatus = useRef(onStatusChange)\n    reportStatus.current = onStatusChange\n    const [sending, setSending] = useState(false)\n    const [sub, setSub] = useState<Sub>('params')\n    const [asText, setAsText] = useState<Record<RowKind, boolean>>({\n        query: false,\n        headers: false,\n    })\n    const [conflict, setConflict] = useState<'changed' | 'deleted' | 'interrupted' | null>(initial.interrupted ? 'interrupted' : initial.conflict)\n\n    const adopt = useCallback((next: DocumentView, editor: Fields | null) => {\n        setDoc(next)\n        revisionRef.current = next.revision\n        setConflict(next.interrupted ? 'interrupted' : next.conflict)\n        if (editor !== null) {\n            fieldsRef.current = editor\n            setFields(editor)\n        }\n    }, [])\n\n    const protect = useCallback((): Promise<boolean> => {\n        timer.current = null\n        const edit = editGen.current\n        sentGen.current = Math.max(sentGen.current, edit)\n        return call({\n            kind: 'protect',\n            id: idRef.current,\n            revision: revisionRef.current,\n            fields: fieldsRef.current,\n            edit,\n        }).then((r) => {\n            if (r.kind === 'protected') {\n                ackGen.current = Math.max(ackGen.current, edit)\n                return true\n            }\n            setStatus(resultText(r) ?? '')\n            return false\n        })\n    }, [call])\n\n    const flush = useCallback((): Promise<boolean> => {\n        const waiting = timer.current !== null\n        if (timer.current !== null) clearTimeout(timer.current)\n        if (waiting || editGen.current > ackGen.current) return protect()\n        return Promise.resolve(true)\n    }, [protect])\n\n    const abandon = useCallback(() => {\n        if (timer.current !== null) clearTimeout(timer.current)\n        timer.current = null\n        ackGen.current = editGen.current\n    }, [])\n\n    const registerRef = useRef(register)\n    registerRef.current = register\n    useEffect(() => {\n        registerRef.current?.({ flush, abandon })\n        return () => {\n            const left = flush()\n            registerRef.current?.({ flush: () => left, abandon: () => {} })\n        }\n    }, [flush, abandon])\n\n    // The status line's last word (a save's, a send's completion, a refusal) gives way to the state once the\n    // request is edited again; only an action still in flight keeps its line.\n    const settle = () => setStatus((s) => (s === C.sending || s === C.waitingReview || s === 'Saving…' ? s : ''))\n\n    const edit = (patch: Partial<Fields>) => {\n        const next = { ...fieldsRef.current, ...patch }\n        fieldsRef.current = next\n        setFields(next)\n        // Every edit, not only the one that first makes the request dirty: a send from an already dirty (or new)\n        // request left its completion standing through the next edits, since dirty never changed.\n        settle()\n        const generation = ++editGen.current\n        if (markedGen.current <= sentGen.current) {\n            markedGen.current = generation\n            void call({ kind: 'editing', id: idRef.current, edit: generation })\n        }\n        if (timer.current !== null) clearTimeout(timer.current)\n        timer.current = setTimeout(() => void protect(), PROTECT_DELAY_MS)\n    }\n\n    const reload = async () => {\n        const r = await call({ kind: 'openRequest', relative: doc.relative })\n        if (r.kind === 'document') adopt(r.document, r.document.fields)\n    }\n\n    const save = async () => {\n        const snapshot = fieldsRef.current\n        const edit = editGen.current\n        if (timer.current !== null) {\n            clearTimeout(timer.current)\n            timer.current = null\n        }\n        sentGen.current = Math.max(sentGen.current, edit)\n        setSaving(true)\n        setStatus('Saving…')\n        const r = await call({\n            kind: 'save',\n            id: idRef.current,\n            revision: revisionRef.current,\n            fields: snapshot,\n            edit,\n        })\n        setSaving(false)\n        if (r.kind === 'saved' || r.kind === 'unchanged') {\n            ackGen.current = Math.max(ackGen.current, edit)\n            adopt(r.document, null)\n            if (fieldsRef.current !== snapshot) {\n                setStatus('Saved. Edits made while saving are kept unsaved.')\n                void protect()\n            } else {\n                setStatus(r.kind === 'saved' ? 'Saved' : 'No changes to save')\n            }\n            return\n        }\n        if (r.kind === 'saveRefused') {\n            if (r.refusal.kind === 'conflict') setConflict('changed')\n            if (r.refusal.kind === 'interrupted' || r.refusal.kind === 'io') setConflict('interrupted')\n            setStatus(saveRefusalText(r.refusal))\n            return\n        }\n        if (r.kind === 'refused' && r.problem.kind === 'stale') await reload()\n        setStatus(resultText(r) ?? '')\n    }\n\n    const resolve = async (choice: 'useDisk' | 'keepMine') => {\n        const r = await call({\n            kind: 'resolve',\n            id: idRef.current,\n            revision: revisionRef.current,\n            fields: fieldsRef.current,\n            choice,\n        })\n        if (r.kind === 'closed') return onClosed(r.id)\n        if (r.kind === 'document') {\n            adopt(r.document, choice === 'useDisk' ? r.document.fields : null)\n            setStatus(choice === 'useDisk' ? 'Using the files on disk. Your version was kept privately.' : 'Your edits now apply to the files on disk. Save to write them.')\n            return\n        }\n        setStatus(resultText(r) ?? '')\n    }\n\n    const discard = async () => {\n        const r = await call({ kind: 'discardDraft', id: idRef.current })\n        if (r.kind === 'closed') return onClosed(r.id)\n        if (r.kind === 'document') {\n            ackGen.current = editGen.current\n            adopt(r.document, r.document.fields)\n            setStatus('Draft discarded')\n            return\n        }\n        setStatus(resultText(r) ?? '')\n    }\n\n    const associate = async (schema: string) => {\n        const r = await call({\n            kind: 'associateSchema',\n            id: idRef.current,\n            revision: revisionRef.current,\n            fields: fieldsRef.current,\n            schema: schema === '' ? null : schema,\n        })\n        if (r.kind === 'document') adopt(r.document, null)\n        else setStatus(resultText(r) ?? '')\n    }\n\n    const sendNow = async (reviewId: string | null) => {\n        const snapshot = fieldsRef.current\n        setSending(true)\n        setRun(null)\n        setStatus(reviewId ? C.waitingReview : C.sending)\n        const r = await call(\n            reviewId\n                ? {\n                      kind: 'apply',\n                      review: reviewId,\n                      id: idRef.current,\n                      revision: revisionRef.current,\n                      fields: snapshot,\n                      context,\n                  }\n                : {\n                      kind: 'send',\n                      id: idRef.current,\n                      revision: revisionRef.current,\n                      fields: snapshot,\n                      context,\n                  }\n        )\n        setSending(false)\n        if (r.kind === 'ran') {\n            setRun(r.run)\n            // Response metrics belong to the displayed response in the footer;\n            // the save state remains the state of the current editor text.\n            setStatus(onStatusChange ? '' : completionText(r.run.record))\n            return\n        }\n        if (r.kind === 'reviewRequired') {\n            setStatus(C.reviewBelow)\n            return\n        }\n        if (r.kind === 'refused' && r.problem.kind === 'stale') await reload()\n        setStatus(resultText(r) ?? '')\n    }\n\n    const readPreview = useCallback(async () => {\n        const r = await call({\n            kind: 'preview',\n            id: idRef.current,\n            fields: fieldsRef.current,\n        })\n        if (r.kind === 'preview') setPreview(r.preview)\n        else setStatus(resultText(r) ?? '')\n    }, [call])\n    // Variables and Preview read the rendered request when they open.\n    useEffect(() => {\n        if (sub === 'variables' || sub === 'preview') void readPreview()\n    }, [sub, readPreview])\n\n    const saveRef = useRef(save)\n    saveRef.current = save\n    useEffect(() => {\n        const onSave = () => void saveRef.current()\n        window.addEventListener(SAVE_DOCUMENT_EVENT, onSave)\n        return () => window.removeEventListener(SAVE_DOCUMENT_EVENT, onSave)\n    }, [])\n\n    const dirty = doc.new || doc.metadataDirty || !same(fields, doc.saved)\n    const name = requestName(doc.relative)\n    const state = doc.new ? C.state.new : dirty ? C.state.unsaved : C.state.saved\n    // Metadata changes the core reports (a schema association) make the request dirty without an edit here.\n    useEffect(() => {\n        if (dirty) setStatus((s) => (s === C.sending || s === C.waitingReview || s === 'Saving…' ? s : ''))\n    }, [dirty])\n    useEffect(() => {\n        reportStatus.current?.({ save: { text: status || state, state: doc.new ? 'new' : dirty ? 'unsaved' : 'saved' }, response: displayed })\n    }, [status, state, dirty, doc.new, displayed])\n    useEffect(() => () => reportStatus.current?.(null), [])\n\n    const rowsTable = (kind: RowKind) => {\n        const text = kind === 'query' ? fields.query : fields.headers\n        const rows = parseRows(text, kind)\n        const textMode = asText[kind] || rows === null\n        const write = (next: Row[]) => edit(kind === 'query' ? { query: serializeRows(next, kind) } : { headers: serializeRows(next, kind) })\n        const label = kind === 'query' ? C.sub.params : C.sub.headers\n        return (\n            <>\n                <div className='flex flex-wrap items-center' style={{ gap: 8 }}>\n                    <Btn disabled={textMode} onClick={() => write([...(rows ?? []), { enabled: true, name: '', value: '' }])}>\n                        {C.addRow[kind === 'query' ? 'params' : 'headers']}\n                    </Btn>\n                    {rows === null ? (\n                        <span className='text-[12px]' style={faint}>\n                            {C.textOnly}\n                        </span>\n                    ) : null}\n                    <span className='ml-auto flex rounded-[7px] text-[12px]' style={{ padding: 2, background: 'var(--v2-inset)' }} role='group' aria-label={`${label} view`}>\n                        {(['table', 'text'] as const).map((m) => {\n                            const on = m === 'text' ? textMode : !textMode\n                            return (\n                                <button\n                                    key={m}\n                                    type='button'\n                                    aria-pressed={on}\n                                    disabled={m === 'table' && rows === null}\n                                    onClick={() => setAsText((s) => ({ ...s, [kind]: m === 'text' }))}\n                                    className='min-h-0 rounded-[5px] font-semibold disabled:opacity-60'\n                                    style={{\n                                        padding: '2px 9px',\n                                        border: 0,\n                                        background: on ? 'var(--v2-paper)' : 'transparent',\n                                        color: on ? 'var(--v2-ink)' : 'var(--v2-soft)',\n                                    }}\n                                >\n                                    {m === 'table' ? C.table : C.text}\n                                </button>\n                            )\n                        })}\n                    </span>\n                </div>\n                {textMode ? (\n                    <label className='flex flex-col text-[13px] font-medium' style={{ gap: 4 }}>\n                        {label}\n                        <textarea value={text} spellCheck={false} style={TEXTAREA_STYLE} onChange={(e) => edit(kind === 'query' ? { query: e.target.value } : { headers: e.target.value })} />\n                        <span className='text-[12px] font-normal' style={faint}>\n                            {kind === 'query' ? 'One row per line: name=value. Start a row with \"# \" to disable it.' : 'One row per line: Name: value. Start a row with \"# \" to disable it.'}\n                        </span>\n                    </label>\n                ) : (\n                    <div role='table' aria-label={label} className='overflow-hidden rounded-[8px] border' style={{ borderColor: 'var(--v2-rule)' }} data-slot={`rows-${kind}`}>\n                        <div\n                            role='row'\n                            className='grid text-[12px] font-semibold'\n                            style={{\n                                gridTemplateColumns: '30px 1fr 1fr 26px',\n                                background: 'var(--v2-inset)',\n                                ...faint,\n                            }}\n                        >\n                            <span role='columnheader'>\n                                <span className='sr-only'>{C.columns.enabled}</span>\n                            </span>\n                            <span role='columnheader' style={{ padding: 8 }}>\n                                {C.columns.name}\n                            </span>\n                            <span role='columnheader' style={{ padding: 8 }}>\n                                {C.columns.value}\n                            </span>\n                            <span role='columnheader'>\n                                <span className='sr-only'>{C.columns.remove}</span>\n                            </span>\n                        </div>\n                        {(rows ?? []).map((r, i) => {\n                            const set = (patch: Partial<Row>) => write((rows ?? []).map((x, j) => (j === i ? { ...x, ...patch } : x)))\n                            return (\n                                <div\n                                    key={i}\n                                    role='row'\n                                    className='grid items-center'\n                                    style={{\n                                        gridTemplateColumns: '30px 1fr 1fr 26px',\n                                        borderTop: '1px solid var(--v2-rule)',\n                                    }}\n                                >\n                                    <span role='cell' className='flex justify-center'>\n                                        <input type='checkbox' aria-label={C.rowEnabled(r.name)} checked={r.enabled} onChange={(e) => set({ enabled: e.target.checked })} />\n                                    </span>\n                                    <span role='cell' style={{ borderLeft: '1px solid var(--v2-rule)' }}>\n                                        <input\n                                            aria-label={`${C.rowName} ${i + 1}`}\n                                            value={r.name}\n                                            spellCheck={false}\n                                            autoComplete='off'\n                                            onChange={(e) => set({ name: e.target.value })}\n                                            className='w-full min-h-0 border-0 bg-transparent'\n                                            style={{\n                                                padding: '10px 8px',\n                                                border: 0,\n                                                minHeight: 0,\n                                                borderRadius: 0,\n                                                background: 'transparent',\n                                                fontFamily: MONO,\n                                                fontSize: 12,\n                                                color: r.enabled ? 'var(--v2-ink)' : 'var(--v2-faint)',\n                                            }}\n                                        />\n                                    </span>\n                                    <span role='cell' style={{ borderLeft: '1px solid var(--v2-rule)' }}>\n                                        <input\n                                            aria-label={`${C.rowValue} ${i + 1}`}\n                                            value={r.value}\n                                            spellCheck={false}\n                                            autoComplete='off'\n                                            onChange={(e) => set({ value: e.target.value })}\n                                            className='w-full min-h-0 border-0 bg-transparent'\n                                            style={{\n                                                padding: '10px 8px',\n                                                border: 0,\n                                                minHeight: 0,\n                                                borderRadius: 0,\n                                                background: 'transparent',\n                                                fontFamily: MONO,\n                                                fontSize: 12,\n                                                color: r.enabled ? 'var(--v2-ink)' : 'var(--v2-faint)',\n                                            }}\n                                        />\n                                    </span>\n                                    <span role='cell' className='flex justify-center'>\n                                        <button\n                                            type='button'\n                                            aria-label={C.removeRow(r.name)}\n                                            onClick={() => write((rows ?? []).filter((_, j) => j !== i))}\n                                            className='grid size-6 min-h-0 place-items-center text-[14px]'\n                                            style={{ border: 0, background: 'transparent', ...faint }}\n                                        >\n                                            ×\n                                        </button>\n                                    </span>\n                                </div>\n                            )\n                        })}\n                    </div>\n                )}\n            </>\n        )\n    }\n\n    const panel =\n        sub === 'params' || sub === 'headers' ? (\n            rowsTable(sub === 'params' ? 'query' : 'headers')\n        ) : sub === 'body' ? (\n            <>\n                <div className='flex flex-wrap items-end' style={{ gap: 12 }}>\n                    <label htmlFor={`${ids}-kind`} className='flex flex-col text-[13px] font-medium' style={{ gap: 4 }}>\n                        {C.bodyKind}\n                        <select\n                            id={`${ids}-kind`}\n                            value={fields.bodyKind}\n                            onChange={(e) => edit({ bodyKind: e.target.value })}\n                            className='h-8 min-h-0 rounded-[7px] border px-2 text-[13px]'\n                            style={{\n                                borderColor: 'var(--v2-ctl)',\n                                background: 'var(--v2-paper)',\n                                color: 'var(--v2-ink)',\n                            }}\n                        >\n                            {BODY_KINDS.map((k) => (\n                                <option key={k} value={k}>\n                                    {k}\n                                </option>\n                            ))}\n                        </select>\n                    </label>\n                    <label className='flex flex-col text-[13px] font-medium' style={{ gap: 4 }}>\n                        {C.schema}\n                        <select\n                            value={doc.schema ?? ''}\n                            onChange={(e) => void associate(e.target.value)}\n                            className='h-8 min-h-0 rounded-[7px] border px-2 text-[13px]'\n                            style={{\n                                borderColor: 'var(--v2-ctl)',\n                                background: 'var(--v2-paper)',\n                                color: 'var(--v2-ink)',\n                            }}\n                        >\n                            <option value=''>{C.noSchema}</option>\n                            {schemas.map((s) => (\n                                <option key={s} value={s}>\n                                    {s}\n                                </option>\n                            ))}\n                        </select>\n                    </label>\n                </div>\n                <label htmlFor={`${ids}-body`} className='flex flex-col text-[13px] font-medium' style={{ gap: 4 }}>\n                    {C.body}\n                    {fields.bodyKind === 'json' ? <JsonBodyEditor id={`${ids}-body`} value={fields.body} readOnly={!doc.bodyEditable} style={{ ...TEXTAREA_STYLE, minHeight: 200 }} onChange={(text) => edit({ body: text })} /> : <textarea\n                        id={`${ids}-body`}\n                        value={fields.body}\n                        spellCheck={false}\n                        readOnly={!doc.bodyEditable}\n                        style={{ ...TEXTAREA_STYLE, minHeight: 200 }}\n                        onChange={(e) => edit({ body: e.target.value })}\n                    />}\n                </label>\n                {!doc.bodyEditable ? (\n                    <p className='text-[12px]' style={faint}>\n                        {C.subText.bodyFixed}\n                    </p>\n                ) : null}\n            </>\n        ) : sub === 'auth' ? (\n            <label htmlFor={`${ids}-settings`} className='flex flex-col text-[13px] font-medium' style={{ gap: 4 }}>\n                {C.settings}\n                <textarea id={`${ids}-settings`} value={fields.settings} spellCheck={false} style={TEXTAREA_STYLE} onChange={(e) => edit({ settings: e.target.value })} />\n            </label>\n        ) : sub === 'variables' ? (\n            <>\n                {preview ? (\n                    preview.variables.length ? (\n                        <div role='table' aria-label={C.sub.variables} className='overflow-hidden rounded-[8px] border' style={{ borderColor: 'var(--v2-rule)' }} data-slot='rows-variables'>\n                            <div\n                                role='row'\n                                className='grid text-[12px] font-semibold'\n                                style={{\n                                    gridTemplateColumns: '1fr 1fr 1fr',\n                                    background: 'var(--v2-inset)',\n                                    ...faint,\n                                }}\n                            >\n                                <span role='columnheader' style={{ padding: 8 }}>\n                                    {C.columns.name}\n                                </span>\n                                <span role='columnheader' style={{ padding: 8 }}>\n                                    Layer\n                                </span>\n                                <span role='columnheader' style={{ padding: 8 }}>\n                                    {C.columns.value}\n                                </span>\n                            </div>\n                            {preview.variables.map((v) => (\n                                <div\n                                    key={v.name}\n                                    role='row'\n                                    className='grid'\n                                    style={{\n                                        gridTemplateColumns: '1fr 1fr 1fr',\n                                        borderTop: '1px solid var(--v2-rule)',\n                                        fontFamily: MONO,\n                                        fontSize: 12,\n                                    }}\n                                >\n                                    <span role='cell' className='break-all' style={{ padding: '10px 8px' }}>\n                                        {v.name}\n                                    </span>\n                                    <span\n                                        role='cell'\n                                        style={{\n                                            padding: '10px 8px',\n                                            borderLeft: '1px solid var(--v2-rule)',\n                                            ...soft,\n                                        }}\n                                    >\n                                        {String(v.layer)}\n                                    </span>\n                                    <span\n                                        role='cell'\n                                        className='break-all'\n                                        style={{\n                                            padding: '10px 8px',\n                                            borderLeft: '1px solid var(--v2-rule)',\n                                            ...soft,\n                                        }}\n                                    >\n                                        {v.secret ? `•••• ${v.secret}${v.stored === false ? ' (no value on this Mac)' : ''}` : 'from the environment'}\n                                    </span>\n                                </div>\n                            ))}\n                        </div>\n                    ) : (\n                        <p className='text-[13px]' style={faint}>\n                            No variables are used by this request.\n                        </p>\n                    )\n                ) : null}\n                {preview?.unresolved.length ? <p role='alert' className='text-[13px]'>{`Unresolved variables: ${preview.unresolved.join(', ')}`}</p> : null}\n                <Btn className='self-start' onClick={() => void readPreview()}>\n                    {C.readPreview}\n                </Btn>\n            </>\n        ) : (\n            <>\n                {preview ? (\n                    <section aria-label='Request preview' data-slot='workbench-preview' className='flex flex-col text-[13px]' style={{ gap: 8 }}>\n                        <pre\n                            role='region'\n                            aria-label={C.sub.preview}\n                            className='break-all whitespace-pre-wrap'\n                            style={{\n                                ...TEXTAREA_STYLE,\n                                minHeight: 0,\n                                resize: 'none',\n                                margin: 0,\n                            }}\n                        >\n                            {[\n                                `${preview.method} ${preview.url}${preview.query.length ? `?${preview.query.map(([n, v]) => `${n}=${v}`).join('&')}` : ''}`,\n                                ...preview.headers.map(([n, v]) => `${n}: ${v}`),\n                                ...(preview.body ? ['', preview.body] : []),\n                            ].join('\\n')}\n                        </pre>\n                        {preview.auth && preview.auth !== 'none' ? <p>{`Authentication: ${preview.auth}`}</p> : null}\n                        {preview.unresolved.length ? <p role='alert'>{`Unresolved variables: ${preview.unresolved.join(', ')}`}</p> : null}\n                        {preview.missingSecrets.length ? <p role='alert'>{`Secrets without a value on this Mac: ${preview.missingSecrets.join(', ')}`}</p> : null}\n                        {preview.problem ? <p role='alert'>{fieldText(preview.problem)}</p> : null}\n                        {preview.jsonWarning ? <p>The JSON body does not parse; it is kept exactly as typed.</p> : null}\n                    </section>\n                ) : null}\n                <div className='flex flex-wrap items-center' style={{ gap: 10 }}>\n                    <Btn onClick={() => void readPreview()}>{C.readPreview}</Btn>\n                    <span className='text-[12px]' style={faint}>\n                        {C.previewHint}\n                    </span>\n                </div>\n            </>\n        )\n\n    const extra = (s: Sub): string => {\n        if (s === 'params') return String(enabledCount(fields.query, 'query') || '')\n        if (s === 'headers') return String(enabledCount(fields.headers, 'headers') || '')\n        if (s === 'body') return fields.body ? fields.bodyKind.toUpperCase() : ''\n        return ''\n    }\n\n    return (\n        <form\n            aria-label={`Request ${name}`}\n            data-slot='workbench-document'\n            className='flex min-h-0 flex-grow flex-col'\n            onSubmit={(e) => {\n                e.preventDefault()\n                void save()\n            }}\n            onKeyDown={(e) => {\n                if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 's') {\n                    e.preventDefault()\n                    void save()\n                }\n            }}\n        >\n            {conflict ? (\n                <div\n                    role='alert'\n                    className='flex flex-col text-[13px]'\n                    style={{\n                        gap: 8,\n                        margin: '12px 20px 0',\n                        padding: '12px 14px',\n                        borderRadius: 10,\n                        background: 'var(--v2-flag-bg)',\n                    }}\n                    data-slot='workbench-conflict'\n                >\n                    <p className='font-semibold'>{conflict === 'deleted' ? C.conflict.deleted : conflict === 'interrupted' ? C.conflict.interrupted : C.conflict.changed}</p>\n                    <p>{conflict === 'interrupted' ? C.conflict.interruptedText : C.conflict.changedText}</p>\n                    <div className='flex flex-wrap' style={{ gap: 8 }}>\n                        <Btn onClick={() => void resolve('useDisk')}>{C.conflict.useDisk}</Btn>\n                        <Btn onClick={() => void resolve('keepMine')}>{C.conflict.keepMine}</Btn>\n                    </div>\n                </div>\n            ) : null}\n            {doc.recovered && !conflict ? (\n                <div\n                    className='flex flex-col text-[13px]'\n                    style={{\n                        gap: 8,\n                        margin: '12px 20px 0',\n                        padding: '12px 14px',\n                        borderRadius: 10,\n                        background: 'var(--v2-acc-soft)',\n                    }}\n                    data-slot='workbench-recovered'\n                >\n                    <p className='font-semibold'>{C.recovered}</p>\n                    <p>{C.recoveredText}</p>\n                    <Btn className='self-start' onClick={() => void discard()}>\n                        {C.discardDraft}\n                    </Btn>\n                </div>\n            ) : null}\n            {notes.length ? (\n                <div\n                    className='flex flex-col text-[13px]'\n                    style={{\n                        gap: 4,\n                        margin: '12px 20px 0',\n                        padding: '12px 14px',\n                        borderRadius: 10,\n                        background: 'var(--v2-acc-soft)',\n                    }}\n                    data-slot='workbench-notes'\n                >\n                    <p className='font-semibold'>{C.notes}</p>\n                    <ul className='list-disc pl-5'>\n                        {notes.map((n, i) => (\n                            <li key={i}>{NOTE_TEXT(n)}</li>\n                        ))}\n                    </ul>\n                </div>\n            ) : null}\n            <div\n                className='flex flex-wrap items-center'\n                style={{\n                    gap: 8,\n                    padding: '16px 20px',\n                    borderBottom: '1px solid var(--v2-rule)',\n                }}\n                data-slot='workbench-request-line'\n            >\n                <div\n                    className='flex min-w-0 flex-grow overflow-hidden rounded-[8px] border'\n                    style={{\n                        height: 34,\n                        borderColor: 'var(--v2-rule)',\n                        background: 'var(--v2-paper)',\n                        flexBasis: 320,\n                    }}\n                >\n                    <span className='relative flex shrink-0 items-center' style={{ width: 86, borderRight: '1px solid var(--v2-rule)' }}>\n                        <select\n                            aria-label={C.method}\n                            value={fields.method}\n                            onChange={(e) => edit({ method: e.target.value })}\n                            className='h-full w-full min-h-0 appearance-none border-0 bg-transparent font-mono text-[12px] font-bold'\n                            style={{\n                                border: 0,\n                                minHeight: 0,\n                                borderRadius: 0,\n                                background: 'transparent',\n                                padding: '0 24px 0 10px',\n                                color: methodColor(fields.method),\n                            }}\n                        >\n                            {(METHODS.includes(fields.method) ? METHODS : [fields.method, ...METHODS]).map((m) => (\n                                <option key={m} value={m}>\n                                    {m}\n                                </option>\n                            ))}\n                        </select>\n                        <span className='pointer-events-none absolute' style={{ right: 8 }}>\n                            <Glyph name='chev' size={10} color='var(--v2-faint)' />\n                        </span>\n                    </span>\n                    <span className='flex min-w-0 flex-grow items-center' style={{ padding: '0 12px', gap: 4 }}>\n                        <UrlTemplateInput label={C.url} value={fields.url} onChange={(text) => edit({ url: text })} />\n                    </span>\n                </div>\n                <Btn tier='primary' className='h-[34px] px-[18px] text-[13px]' disabled={sending} onClick={() => void sendNow(null)}>\n                    {C.send}\n                </Btn>\n                <Btn className='h-[34px]' type='submit' disabled={saving}>\n                    {C.save}\n                </Btn>\n                {dirty && !doc.new && !doc.recovered ? (\n                    <Btn tier='tertiary' className='h-[34px]' onClick={() => void discard()}>\n                        {C.discardChanges}\n                    </Btn>\n                ) : null}\n                {!onStatusChange ? <span\n                    role='status'\n                    aria-live='polite'\n                    className='flex min-w-0 items-center rounded-[8px] border text-[12px]'\n                    style={{\n                        gap: 6,\n                        minHeight: 34,\n                        padding: '6px 12px',\n                        borderColor: 'var(--v2-rule)',\n                        background: 'var(--v2-inset)',\n                        color: 'var(--v2-soft)',\n                        maxWidth: '100%',\n                    }}\n                    data-slot='workbench-save-status'\n                    data-state={doc.new ? 'new' : dirty ? 'unsaved' : 'saved'}\n                >\n                    {status === '' || status === 'Saved' ? <Glyph name={dirty ? 'dot' : 'check'} size={12} color={dirty ? 'var(--v2-acc)' : 'var(--v2-ok)'} /> : null}\n                    <span className='min-w-0'>{status || state}</span>\n                </span> : null}\n            </div>\n            <div className='flex min-h-0 flex-grow' data-slot='workbench-columns'>\n                <div className='flex min-w-0 flex-col' style={{ flex: '1 1 360px', borderRight: '1px solid var(--v2-rule)' }}>\n                    <div\n                        role='tablist'\n                        aria-label={C.request}\n                        className='flex shrink-0 flex-wrap'\n                        style={{\n                            gap: 4,\n                            padding: '0 12px',\n                            borderBottom: '1px solid var(--v2-rule)',\n                        }}\n                    >\n                        {SUBS.map((s) => (\n                            <button\n                                key={s}\n                                type='button'\n                                role='tab'\n                                aria-selected={sub === s}\n                                aria-controls={`${ids}-sub-panel`}\n                                onClick={() => setSub(s)}\n                                className='min-h-0 shrink-0 text-[12.5px] font-semibold whitespace-nowrap'\n                                style={{\n                                    height: 38,\n                                    padding: '0 10px',\n                                    border: 0,\n                                    borderBottom: `2px solid ${sub === s ? 'var(--v2-acc)' : 'transparent'}`,\n                                    background: 'transparent',\n                                    color: sub === s ? 'var(--v2-ink)' : 'var(--v2-soft)',\n                                }}\n                            >\n                                {C.sub[s]}\n                                {extra(s) ? (\n                                    <span className='font-normal' style={{ fontSize: 12, ...faint }}>\n                                        {' '}\n                                        {extra(s)}\n                                    </span>\n                                ) : null}\n                            </button>\n                        ))}\n                    </div>\n                    <div role='tabpanel' id={`${ids}-sub-panel`} className='flex min-h-0 flex-grow flex-col overflow-auto' style={{ gap: 12, padding: '18px 20px' }}>\n                        <p className='text-[12px] leading-[1.45]' style={soft}>\n                            {C.subText[sub]}\n                        </p>\n                        {panel}\n                    </div>\n                </div>\n                <ResponsePane\n                    run={run}\n                    running={running}\n                    review={review}\n                    call={call}\n                    historyKey={historyKey}\n                    onDisplayed={setDisplayed}\n                    onApply={() => review && void sendNow(review.review)}\n                    onDismiss={() => void call({ kind: 'dismissReview' }).then(() => setStatus(''))}\n                />\n            </div>\n        </form>\n    )\n}\nimport { useEffect, useMemo, useRef, useState } from 'react'\nimport type { RunRecord, RunView, RunningView, SendReviewView } from '@prisma-airs/desktop-contracts'\nimport { type WorkbenchCall, resultText, runFailureText, runSummary, sizeText } from '../../modules/workbench/workbench-call'\nimport { clockOf } from '../copy'\nimport { Btn } from '../controls'\nimport { Glyph } from '../icons'\nimport { API_COPY as C } from './copy'\nimport { prettyJson } from './request-rows'\nimport { requestName } from './request-tree'\nimport { JsonText } from './json-presentation'\nimport type { DisplayedResponse } from './presentation-status'\n\ntype ResponseTab = 'body' | 'headers' | 'details' | 'history'\nconst TABS: ResponseTab[] = ['body', 'headers', 'details', 'history']\n\nconst faint = { color: 'var(--v2-faint)' }\nconst soft = { color: 'var(--v2-soft)' }\nconst MONO = \"ui-monospace, 'SF Mono', Menlo, monospace\"\nconst BOX = {\n    margin: '0 14px 12px',\n    border: '1px solid var(--v2-rule)',\n    borderRadius: 8,\n    background: 'var(--v2-paper)',\n}\n\n/** The status pill's tone: the code's class, a failure, or a run that never completed. */\nexport function tone(record: RunRecord): {\n    fg: string\n    bg: string\n    text: string\n    glyph: 'check' | 'alert' | 'ban' | 'x'\n} {\n    if (record.state === 'completed' && record.status !== null) {\n        const code = record.status\n        return code < 300\n            ? {\n                  fg: 'var(--v2-ok)',\n                  bg: 'var(--v2-ok-bg)',\n                  text: `${code} ${code === 200 ? 'OK' : ''}`.trim(),\n                  glyph: 'check',\n              }\n            : code < 500\n              ? {\n                    fg: 'var(--v2-flag)',\n                    bg: 'var(--v2-flag-bg)',\n                    text: String(code),\n                    glyph: 'alert',\n                }\n              : {\n                    fg: 'var(--v2-block)',\n                    bg: 'var(--v2-block-bg)',\n                    text: String(code),\n                    glyph: 'ban',\n                }\n    }\n    const text = record.state === 'interrupted' ? 'Interrupted' : record.state === 'cancelled' ? 'Cancelled' : record.state === 'running' ? 'Running' : 'Failed'\n    return { fg: 'var(--v2-block)', bg: 'var(--v2-block-bg)', text, glyph: 'x' }\n}\n\nexport function elapsedText(ms: number): string {\n    return ms < 1000 ? `${ms} ms` : `${(ms / 1000).toFixed(2)} s`\n}\n\ninterface Props {\n    /** The run Send produced for this request (null before the first send). */\n    run: RunView | null\n    running: RunningView[]\n    review: SendReviewView | null\n    call: WorkbenchCall\n    /** Changes when history may have changed (the collection, a send). */\n    historyKey: string\n    onApply: () => void\n    onDismiss: () => void\n    onDisplayed?: (response: DisplayedResponse | null) => void\n}\n\n/**\n * The response pane (R2App's right 40%): the status line, the Body,\n * Headers, Details and History tabs. A run shown from History is the\n * immutable record of what happened then; nothing here sends anything.\n */\nexport function ResponsePane({ run, running, review, call, historyKey, onApply, onDismiss, onDisplayed }: Props) {\n    const [tab, setTab] = useState<ResponseTab>('body')\n    const [pretty, setPretty] = useState(true)\n    const [fromHistory, setFromHistory] = useState<RunView | null>(null)\n    const [message, setMessage] = useState('')\n    // A new send shows its own run and returns to Body.\n    const runId = run?.record.id ?? null\n    useEffect(() => {\n        setFromHistory(null)\n        setMessage('')\n        if (runId) setTab('body')\n    }, [runId])\n    const shown = fromHistory ?? run\n    const record = shown?.record ?? null\n    const displayCallback = useRef(onDisplayed)\n    displayCallback.current = onDisplayed\n    useEffect(() => {\n        displayCallback.current?.(record ? { record, history: fromHistory !== null } : null)\n    }, [record, fromHistory])\n    const formatted = useMemo(() => shown?.preview != null ? prettyJson(shown.preview) : null, [shown?.preview])\n\n    const save = async () => {\n        if (!record) return\n        setMessage('')\n        const r = await call({ kind: 'saveResponse', run: record.id })\n        if (r.kind === 'responseSaved') setMessage(C.saved(sizeText(r.bytes), r.name))\n        else if (r.kind !== 'cancelled') setMessage(resultText(r) ?? '')\n    }\n    const copy = async () => {\n        if (shown?.preview == null) return\n        try {\n            await navigator.clipboard.writeText(shown.preview)\n            setMessage(C.copied)\n        } catch {\n            setMessage(C.copyFailed)\n        }\n    }\n\n    const first = running[0] ?? null\n    // Every transfer in flight is in view with its own Cancel, whatever response is being inspected (a run from\n    // History shown while a new send runs hid the progress and the cancellation behind the old record; the core\n    // runs several sends of one document at once, and only the first was shown).\n    const progress = running.map((r, i) => (\n        <span key={r.run} role='status' aria-live='polite' className='flex w-full flex-wrap items-center text-[12.5px]' style={{ gap: 8 }} data-slot='workbench-running'>\n            {C.sendingProgress(r.method, sizeText(r.bytes))}\n            <Btn className='h-7' aria-label={running.length > 1 ? `${C.cancel_} ${i + 1} of ${running.length}` : undefined} onClick={() => void call({ kind: 'cancel', run: r.run })}>\n                {C.cancel_}\n            </Btn>\n        </span>\n    ))\n    const head = record ? (\n        <>\n            {!onDisplayed ? <><span\n                className='inline-flex items-center rounded-[6px] font-bold'\n                style={{\n                    gap: 4,\n                    padding: '2px 9px',\n                    background: tone(record).bg,\n                    color: tone(record).fg,\n                }}\n                data-slot='response-status'\n            >\n                <Glyph name={tone(record).glyph} size={11} color={tone(record).fg} />\n                {tone(record).text}\n            </span>\n            <span style={soft}>{elapsedText(record.elapsedMs)}</span>\n            <span style={soft}>{sizeText(record.bytes)}</span></> : null}\n            <span className='ml-auto truncate text-[12px]' style={faint}>\n                {fromHistory ? `${requestName(record.relative)} · ${clockOf(record.at)}` : clockOf(record.at)}\n            </span>\n        </>\n    ) : first ? null : (\n        <span style={faint}>{C.noResponseYet}</span>\n    )\n\n    return (\n        <section\n            aria-label={C.pane}\n            data-slot='workbench-response-pane'\n            className='flex min-h-0 min-w-0 flex-col overflow-auto'\n            style={{ flex: '0 0 40%', minWidth: 'min(100%, 340px)', maxWidth: 440 }}\n        >\n            <div\n                className='flex flex-wrap items-center text-[13px]'\n                style={{\n                    gap: 10,\n                    minHeight: 48,\n                    padding: '9px 14px',\n                    borderBottom: '1px solid var(--v2-rule)',\n                }}\n                data-slot='response-head'\n            >\n                {progress}\n                {head}\n            </div>\n            {review ? (\n                <div\n                    role='alert'\n                    className='flex flex-col rounded-[10px] text-[13px]'\n                    style={{\n                        gap: 8,\n                        margin: '12px 14px 0',\n                        padding: '12px 14px',\n                        background: 'var(--v2-flag-bg)',\n                    }}\n                    data-slot='workbench-review'\n                >\n                    <p className='font-semibold'>{C.review.title(review.operation)}</p>\n                    <p className='break-all font-mono text-[12px]'>{`${review.method} ${review.url}`}</p>\n                    <p>{C.review.goes(review.destination)}</p>\n                    {review.headers.length ? (\n                        <ul className='font-mono text-[12px]'>\n                            {review.headers.map(([n, v], i) => (\n                                <li key={i} className='break-all'>{`${n}: ${v}`}</li>\n                            ))}\n                        </ul>\n                    ) : null}\n                    {review.body ? (\n                        <pre className='max-h-48 overflow-auto rounded-[8px] p-2 font-mono text-[12px] whitespace-pre-wrap' style={{ background: 'var(--v2-paper)' }}>\n                            {review.body}\n                        </pre>\n                    ) : null}\n                    {review.files.length ? <p>{C.review.files(review.files.join(', '))}</p> : null}\n                    <p className='text-[12px]' style={faint}>\n                        {C.review.expires(new Date(review.expires * 1000).toLocaleTimeString())}\n                    </p>\n                    <div className='flex flex-wrap' style={{ gap: 8 }}>\n                        <Btn tier='primary' onClick={onApply}>\n                            {C.review.apply}\n                        </Btn>\n                        <Btn onClick={onDismiss}>{C.review.dismiss}</Btn>\n                    </div>\n                </div>\n            ) : null}\n            <div\n                role='tablist'\n                aria-label={`${C.response} views`}\n                className='flex flex-wrap'\n                style={{\n                    gap: 2,\n                    padding: '0 10px',\n                    borderBottom: '1px solid var(--v2-rule)',\n                }}\n            >\n                {TABS.map((t) => (\n                    <button\n                        key={t}\n                        type='button'\n                        role='tab'\n                        aria-selected={tab === t}\n                        aria-controls={`response-panel-${t}`}\n                        onClick={() => setTab(t)}\n                        className='min-h-0 text-[12.5px] font-semibold'\n                        style={{\n                            height: 38,\n                            padding: '0 10px',\n                            border: 0,\n                            borderBottom: `2px solid ${tab === t ? 'var(--v2-acc)' : 'transparent'}`,\n                            background: 'transparent',\n                            color: tab === t ? 'var(--v2-ink)' : 'var(--v2-soft)',\n                        }}\n                    >\n                        {C.responseTabs[t]}\n                        {t === 'headers' && record?.headers.length ? (\n                            <span className='font-normal' style={{ fontSize: 12, ...faint }}>\n                                {' '}\n                                {record.headers.length}\n                            </span>\n                        ) : null}\n                    </button>\n                ))}\n            </div>\n            <div role='tabpanel' id={`response-panel-${tab}`} className='flex min-h-0 flex-grow flex-col'>\n                {tab === 'history' ? (\n                    <History\n                        call={call}\n                        revision={historyKey}\n                        onShow={(view) => {\n                            setFromHistory(view)\n                            setTab('body')\n                        }}\n                    />\n                ) : !shown || !record ? (\n                    <p className='text-[13px]' style={{ margin: '20px 14px', ...faint }} data-slot='workbench-no-response'>\n                        {C.noResponse}\n                    </p>\n                ) : (\n                    <section aria-label={C.response} data-slot='workbench-response' className='flex min-h-0 flex-grow flex-col text-[13px]'>\n                        <p className='sr-only' data-slot='workbench-run-summary'>\n                            {runSummary(record)}\n                        </p>\n                        {record.failure ? (\n                            <p role='alert' style={{ margin: '12px 14px 0' }}>\n                                {runFailureText(record.failure)}\n                            </p>\n                        ) : null}\n                        {record.uncertain ? (\n                            <p\n                                role='alert'\n                                className='rounded-[8px]'\n                                style={{\n                                    margin: '12px 14px 0',\n                                    padding: '10px 12px',\n                                    background: 'var(--v2-flag-bg)',\n                                }}\n                            >\n                                {C.uncertain}\n                            </p>\n                        ) : null}\n                        {record.redirect ? <p style={{ margin: '12px 14px 0' }}>{C.redirect(record.redirect)}</p> : null}\n                        {shown.tokenDropped ? <p style={{ margin: '12px 14px 0' }}>{C.tokenDropped}</p> : null}\n                        {tab === 'body' ? (\n                            <>\n                                <div className='flex flex-wrap items-center' style={{ gap: 10, padding: '12px 18px' }}>\n                                    <span className='text-[12px]' style={faint}>\n                                        {formatted !== null ? 'JSON' : shown.preview === null ? '' : 'Text'}\n                                    </span>\n                                    <span className='flex rounded-[7px] text-[12px]' style={{ padding: 2, background: 'var(--v2-inset)' }} role='group' aria-label='Body format'>\n                                        {(['pretty', 'raw'] as const).map((f) => (\n                                            <button\n                                                key={f}\n                                                type='button'\n                                                aria-pressed={pretty === (f === 'pretty')}\n                                                onClick={() => setPretty(f === 'pretty')}\n                                                className='min-h-0 rounded-[5px] font-semibold'\n                                                style={{\n                                                    padding: '2px 9px',\n                                                    border: 0,\n                                                    background: pretty === (f === 'pretty') ? 'var(--v2-paper)' : 'transparent',\n                                                    color: 'var(--v2-ink)',\n                                                }}\n                                            >\n                                                {f === 'pretty' ? C.pretty : C.raw}\n                                            </button>\n                                        ))}\n                                    </span>\n                                    <span className='ml-auto flex items-center' style={{ gap: 6 }}>\n                                        <Btn className='h-7' disabled={shown.preview == null} onClick={() => void copy()}>\n                                            {C.copy}\n                                        </Btn>\n                                        <Btn className='h-7' disabled={!record.stored} onClick={() => void save()}>\n                                            {C.saveResponse}\n                                        </Btn>\n                                    </span>\n                                </div>\n                                {shown.preview !== null && shown.preview !== '' ? (\n                                    pretty && formatted !== null ? (\n                                        <pre\n                                            role='region'\n                                            aria-label={C.responseBody}\n                                            data-slot='json-lines'\n                                            className='min-h-0 flex-grow overflow-auto text-[12px] leading-[1.75]'\n                                            style={{\n                                                ...BOX,\n                                                padding: '10px 0',\n                                                fontFamily: MONO,\n                                                color: 'var(--v2-ink)',\n                                            }}\n                                        >\n                                            <JsonText text={formatted} numbered />\n                                        </pre>\n                                    ) : (\n                                        <pre\n                                            role='region'\n                                            aria-label={C.responseBody}\n                                            className='min-h-0 flex-grow overflow-auto text-[12px] leading-[1.6] break-all whitespace-pre-wrap'\n                                            style={{\n                                                ...BOX,\n                                                padding: 12,\n                                                fontFamily: MONO,\n                                                color: 'var(--v2-ink)',\n                                            }}\n                                        >\n                                            {shown.preview}\n                                        </pre>\n                                    )\n                                ) : (\n                                    <p style={{ margin: '0 14px 12px', ...faint }}>{shown.preview === null && record.bytes > 0 ? C.notText : C.noBody}</p>\n                                )}\n                                {record.bytes > shown.previewBytes && shown.preview !== null ? (\n                                    <p className='text-[12px]' style={{ margin: '0 14px 12px', ...faint }}>\n                                        {C.firstBytes(sizeText(shown.previewBytes))}\n                                    </p>\n                                ) : null}\n                            </>\n                        ) : tab === 'headers' ? (\n                            record.headers.length ? (\n                                <div role='table' aria-label={C.responseHeaders} className='overflow-hidden text-[12px]' style={{ ...BOX, margin: '12px 14px', fontFamily: MONO }}>\n                                    {record.headers.map(([n, v], i) => (\n                                        <div\n                                            key={i}\n                                            role='row'\n                                            className='grid'\n                                            style={{\n                                                gridTemplateColumns: '1fr 1.6fr',\n                                                borderTop: i ? '1px solid var(--v2-rule)' : 0,\n                                            }}\n                                        >\n                                            <span role='cell' className='break-all' style={{ padding: '8px 10px', ...soft }}>\n                                                {n}\n                                            </span>\n                                            <span\n                                                role='cell'\n                                                className='break-all'\n                                                style={{\n                                                    padding: '8px 10px',\n                                                    borderLeft: '1px solid var(--v2-rule)',\n                                                }}\n                                            >\n                                                {v}\n                                            </span>\n                                        </div>\n                                    ))}\n                                </div>\n                            ) : (\n                                <p style={{ margin: '20px 14px', ...faint }}>No headers were recorded.</p>\n                            )\n                        ) : (\n                            <dl\n                                className='flex flex-col text-[12.5px]'\n                                style={{\n                                    ...BOX,\n                                    margin: '12px 14px',\n                                    padding: '12px 14px',\n                                    gap: 8,\n                                }}\n                                data-slot='response-details'\n                            >\n                                {(\n                                    [\n                                        [C.details.request, `${record.method} ${record.url}`],\n                                        [C.details.status, runSummary(record)],\n                                        [C.details.duration, elapsedText(record.elapsedMs)],\n                                        [C.details.size, sizeText(record.bytes)],\n                                        [C.details.when, new Date(record.at * 1000).toLocaleString()],\n                                        [C.details.credential, record.class === 'anonymous' ? C.details.anonymous : record.class],\n                                        [C.details.operation, record.operation ?? '—'],\n                                        [C.details.stored, record.stored ? C.details.yes : C.details.no],\n                                    ] as [string, string][]\n                                ).map(([k, v]) => (\n                                    <div key={k} className='flex justify-between' style={{ gap: 10 }}>\n                                        <dt style={faint}>{k}</dt>\n                                        <dd className='min-w-0 break-all text-right'>{v}</dd>\n                                    </div>\n                                ))}\n                            </dl>\n                        )}\n                    </section>\n                )}\n            </div>\n            <p role='status' aria-live='polite' className='text-[12px]' style={{ margin: '0 14px 10px', ...soft }} data-slot='workbench-response-saved'>\n                {message}\n            </p>\n        </section>\n    )\n}\n\n/** The collection's history: what was sent, never sent again. */\nfunction History({ call, revision, onShow }: { call: WorkbenchCall; revision: string; onShow: (run: RunView) => void }) {\n    const [runs, setRuns] = useState<RunRecord[]>([])\n    const [more, setMore] = useState(false)\n    const [message, setMessage] = useState('')\n    const generation = useRef(0)\n    useEffect(() => {\n        generation.current += 1\n        return () => { generation.current += 1 }\n    }, [revision])\n    const show = async (id: string) => {\n        const asked = ++generation.current\n        const x = await call({ kind: 'showRun', run: id })\n        if (asked !== generation.current) return\n        if (x.kind === 'ran') onShow(x.run)\n        else setMessage(resultText(x) ?? '')\n    }\n    useEffect(() => {\n        let live = true\n        void call({ kind: 'history', before: null }).then((r) => {\n            if (!live) return\n            if (r.kind === 'history') {\n                setRuns(r.runs)\n                setMore(r.more)\n            } else setMessage(resultText(r) ?? '')\n        })\n        return () => {\n            live = false\n        }\n    }, [call, revision])\n    const older = async () => {\n        const last = runs.at(-1)\n        if (!last) return\n        const r = await call({ kind: 'history', before: last.id })\n        if (r.kind === 'history') {\n            setRuns((x) => [...x, ...r.runs])\n            setMore(r.more)\n        }\n    }\n    const clear = async () => {\n        const r = await call({ kind: 'clearHistory' })\n        if (r.kind === 'done') {\n            setRuns([])\n            setMore(false)\n        } else setMessage(resultText(r) ?? '')\n    }\n    return (\n        <section aria-label='History' data-slot='workbench-history' className='flex flex-col text-[13px]' style={{ gap: 8, margin: '12px 14px' }}>\n            <p className='text-[12px]' style={soft}>\n                {C.historyLead}\n            </p>\n            {message ? <p role='alert'>{message}</p> : null}\n            {runs.length === 0 ? <p style={faint}>{C.historyEmpty}</p> : null}\n            <ul className='flex flex-col' style={{ gap: 8 }}>\n                {runs.map((r) => {\n                    const t = tone(r)\n                    const summary = `${r.method} ${r.relative.replace(/\\.request\\.toml$/, '')} · ${runSummary(r)} · ${new Date(r.at * 1000).toLocaleString()}`\n                    return (\n                        <li key={r.id}>\n                            <button\n                                type='button'\n                                aria-label={summary}\n                                onClick={() => void show(r.id)}\n                                className='flex w-full min-h-0 items-center rounded-[8px] border text-left'\n                                style={{\n                                    gap: 10,\n                                    padding: '10px 12px',\n                                    borderColor: 'var(--v2-rule)',\n                                    background: 'var(--v2-paper)',\n                                    color: 'var(--v2-ink)',\n                                }}\n                                data-slot='history-run'\n                            >\n                                <span className='rounded-[6px] text-[12px] font-bold' style={{ padding: '2px 8px', background: t.bg, color: t.fg }}>\n                                    {t.text}\n                                </span>\n                                <span className='min-w-0 flex-grow truncate'>{`${r.method} ${requestName(r.relative)} · ${new Date(r.at * 1000).toLocaleString()}`}</span>\n                                <span className='text-[12px]' style={faint}>\n                                    {elapsedText(r.elapsedMs)}\n                                </span>\n                            </button>\n                        </li>\n                    )\n                })}\n            </ul>\n            <div className='flex flex-wrap' style={{ gap: 8 }}>\n                {more ? <Btn onClick={() => void older()}>{C.older}</Btn> : null}\n                {runs.length ? (\n                    <Btn tier='tertiary' onClick={() => void clear()}>\n                        {C.clearHistory}\n                    </Btn>\n                ) : null}\n                <Btn tier='tertiary' onClick={() => void call({ kind: 'clearCookies' }).then((r) => setMessage(r.kind === 'done' ? C.cookiesCleared : (resultText(r) ?? '')))}>\n                    {C.clearCookies}\n                </Btn>\n            </div>\n        </section>\n    )\n}\n","exit_code":0,"status":"completed"}}
