{"type":"item.completed","item":{"id":"item_35","type":"command_execution","command":"/bin/zsh -lc \"cat tools/p10/candidate.py && sed -n '1,180p' tools/p11/standing.py && sed -n '329,394p' tools/p11/remediation.py && sed -n '1,160p' tools/p10/qualification.py\"","aggregated_output":"\"\"\"Candidate/source bindings shared by C45 qualification and actual reviews.\"\"\"\nfrom pathlib import Path\nimport ast\nimport os\nimport stat\nimport sys\nsys.path.insert(0,str(Path(__file__).resolve().parents[1]/'p09'))\nfrom phase_packet import source_inventory, file_identity, digest\nfrom qualification import read, sha, require\n\n\ndef bundle_hash(bundle):\n    entries=[]\n    for base, directories, files in os.walk(bundle,followlinks=False):\n        symlinks=[name for name in directories if (Path(base)/name).is_symlink()]\n        directories[:]=[name for name in directories if name not in symlinks]\n        for name in files+symlinks:\n            path=Path(base)/name;relative=str(path.relative_to(bundle))\n            if path.is_symlink():mode='symlink';value=__import__('hashlib').sha256(os.readlink(path).encode()).hexdigest()\n            else:mode='100755' if path.stat().st_mode & 0o111 else '100644';value=sha(path)\n            entries.append((relative,mode,value))\n    text=''.join(f'{name}\\0{mode}\\0{value}\\n' for name,mode,value in sorted(entries))\n    return __import__('hashlib').sha256(text.encode()).hexdigest()\n\n\ndef helper_closure(root, driver):\n    folder=root/'tools/native-acceptance';pending=[driver];seen=set()\n    while pending:\n        name=pending.pop()\n        if name in seen or not (folder/(name+'.py')).is_file():continue\n        seen.add(name);tree=ast.parse((folder/(name+'.py')).read_text())\n        for node in ast.walk(tree):\n            if isinstance(node,ast.Import):pending.extend(alias.name.split('.')[0] for alias in node.names)\n            elif isinstance(node,ast.ImportFrom) and node.module:pending.append(node.module.split('.')[0])\n    paths=['tools/native-acceptance/'+name+'.py' for name in seen]\n    # Native compiled helpers/servers are used through literal paths, not imports.\n    paths += [str(p.relative_to(root)) for p in folder.iterdir() if p.suffix in ['.swift','.js']]\n    paths += ['tools/p10/native.py','tools/p10/candidate.py','docs/planning/evidence/P09/native-controller/native_requirements.py']\n    return {name:sha(root/name) for name in sorted(set(paths))}\n\n\ndef verify_source(root, seal):\n    expected=read(root/seal)['files']\n    require(source_inventory(root)==expected,'sealed source membership/content changed')\n    return digest(expected)\n\n\ndef verify_candidate(root, value, historical=None):\n    prepared=read(root/value['prepare']['path'])\n    require(sha(root/value['prepare']['path'])==value['prepare']['sha256'],'preparation drift')\n    bundle=historical.application(value) if historical else root/prepared['bundle']\n    require(sha(bundle/'Contents/MacOS/prisma-airs-desktop')==value['executable_sha256']==prepared['executable_sha256'],'candidate executable drift')\n    require(bundle_hash(bundle)==value['bundle_sha256']==prepared['bundle_sha256'],'complete candidate bundle drift')\n    helper_root=historical.source(value['source_inventory_sha256']) if historical else root\n    for name,value_hash in value['helper_closure'].items():require(sha(helper_root/name)==value_hash,'candidate helper drift: '+name)\n    if value.get('build_origin'):\n        import platform\n        origin=value['build_origin'];path=root/origin['record']\n        require(sha(path)==origin['sha256'],'build origin proof drift')\n        audit=verify_build_reuse(root,read(path),value['runner_inputs'],platform.platform(),platform.node(),historical=historical)\n        require(audit==origin['audit'],'build reuse audit drift')\n    return value\n\n# Explicit helper/provenance-only transition after the baseline02 startup smoke.\n# No application/config/dependency path is permitted. Old raw build and failed\n# smoke remain immutable; this is not a new execution of that build.\nBUILD_REUSE_PATHS = {\n    'tools/p10/historical.py','tools/p10/test_historical.py',\n    'tools/p10/provenance_followup.py','tools/p10/qualification.py',\n    'tools/p10/review_gate.py','tools/p10/followup.py',\n    'crates/xtask/tests/controlled_live.rs',\n    'crates/xtask/tests/live_run/common.rs',\n    'crates/xtask/examples/c45_baseline.rs',\n    'tools/p10/packet.py','tools/p10/followup.py','tools/p10/test_followup.py',\n    'tools/native-acceptance/acceptance_c04.py',\n    'tools/native-acceptance/test_c04_current_frame.py',\n    'tools/native-acceptance/acceptance_c45.py',\n    'tools/p10/candidate.py', 'tools/p10/test_build_reuse.py',\n    'tools/p10/supervise.py', 'tools/p10/seal.py',\n    'tools/p10/finalize.py', 'tools/p10/native.py',\n    'apps/desktop/src-tauri/tests/permission_manifest.rs',\n    'tools/p10/continuation.py', 'tools/p10/test_continuation.py',\n    'tools/native-acceptance/acceptance_c32_current.py',\n    'tools/native-acceptance/test_c32_project_path.py',\n}\n\n\ndef verify_build_reuse(root, record, current_identity, platform_name, hostname, historical=None):\n    from qualification import bound\n    from stages import verify_completed\n    require(record['schema']=='airs-desktop/c45-helper-only-build-reuse/1','build reuse schema')\n    old=read(bound(root,record['original_candidate']))\n    before=read(bound(root,record['original_source']))['files']\n    after=read(bound(root,record['current_source']))['files']\n    changed=sorted(name for name in set(before)|set(after) if before.get(name)!=after.get(name))\n    require(changed==record['declared_changed_paths'] and set(changed)<=BUILD_REUSE_PATHS,'undeclared or application-affecting build-reuse delta')\n    if historical:\n        historical.source(digest(before));historical.source(digest(after))\n    else:require(source_inventory(root)==after,'current build-reuse source changed')\n    require(digest(before)==old['source_inventory_sha256'],'original source seal/candidate mismatch')\n    require(current_identity['dependencies']==old['runner_inputs']['dependencies'] and current_identity['build_flags']==old['runner_inputs']['build_flags'],'build dependency/toolchain/flags changed')\n    if not historical:require(old['conditions']['platform']==platform_name and old['conditions']['hostname']==hostname,'build execution conditions changed')\n    state_path=bound(root,record['original_build_stage']);state=read(state_path)\n    verify_completed(root,state_path.parent,state,state['argv'],digest(before))\n    prepared=read(bound(root,old['prepare']));bundle=historical.application(old) if historical else root/prepared['bundle']\n    require(sha(bundle/'Contents/MacOS/prisma-airs-desktop')==old['executable_sha256']==prepared['executable_sha256'],'retained executable changed')\n    require(bundle_hash(bundle)==old['bundle_sha256']==prepared['bundle_sha256'],'retained complete bundle changed')\n    return {'original_candidate_sha256':record['original_candidate']['sha256'],'original_build_stage_sha256':record['original_build_stage']['sha256'],'declared_helper_only_delta':changed,'executable_sha256':old['executable_sha256'],'bundle_sha256':old['bundle_sha256'],'new_build_executed':False,'meaning':'Exact unchanged application retained from actual baseline02 build; changed C45 selector and qualification provenance execute current affected verification.'}\n\"\"\"Durable, audited P11 standing for later production promotion.\n\nFinalization consumes completed executions and five real full-9 reviews. It\nnever assigns a score or completes a controller ledger. Historical validation\nuses the archived source/application, not this checkout's ignored target tree,\ninstalled application, toolchain, hostname, or current application source.\n\"\"\"\nfrom pathlib import Path\nimport json\nimport shutil\nimport subprocess\nimport sys\n\nsys.path.insert(0, str(Path(__file__).resolve().parent))\nsys.path.insert(0, str(Path(__file__).resolve().parents[1] / 'p10'))\nfrom candidate import bundle_hash, digest, file_identity\nfrom historical import Historical\nfrom qualification import bound, read, require, sha, verify as verify_coverage\nfrom review_gate import actual_review, release_prerequisites\n\nCHUNKS = ('C46', 'C47', 'C48', 'C49')\nSUBJECTS = (*CHUNKS, 'P11')\nBASE = Path('docs/planning/evidence/P11')\nACCEPTED = BASE / 'accepted'\nCOMPLETION = BASE / 'completion-proof.json'\nD2_SOURCE = BASE / 'source-history/D2'\nS2_SOURCE = BASE / 'source-history/S2'\nS3_SOURCE = BASE / 'source-history/S3'\nLFS_PATHS = (str(S3_SOURCE / 'resources/harness/darwin-arm64.tar.gz'),\n             str(S2_SOURCE / 'resources/harness/darwin-arm64.tar.gz'),\n             str(D2_SOURCE / 'resources/harness/darwin-arm64.tar.gz'),\n             str(ACCEPTED / 'application/Contents/MacOS/prisma-airs-desktop'),\n             str(ACCEPTED / 'application/Contents/Resources/harness/airs-harness'),\n             str(ACCEPTED / 'source/resources/harness/darwin-arm64.tar.gz'))\n\n\nclass ArchivedP11(Historical):\n    \"\"\"Explicit P11 archive context; historical C45 behavior is untouched.\"\"\"\n    def archive_path(self, name):\n        path = self.root / name\n        require(path.resolve().is_relative_to((self.root / ACCEPTED).resolve())\n                or path.resolve() in ((self.root / D2_SOURCE).resolve(), (self.root / S2_SOURCE).resolve(), (self.root / S3_SOURCE).resolve()),\n                'historical archive escapes accepted P11 evidence')\n        return path\n\n\ndef reference(root, path):\n    root = Path(root).resolve()\n    path = Path(path).resolve(strict=True)\n    require(path.is_relative_to(root.resolve()), 'P11 reference escapes checkout')\n    return {'path': str(path.relative_to(root)), 'sha256': sha(path)}\n\n\ndef identities(root, paths):\n    return {str(path.relative_to(root)): file_identity(path) for path in sorted(set(paths))}\n\n\ndef evidence_files(root, attempts):\n    paths = [p for p in (root / BASE).rglob('*')\n             if (p.is_file() or p.is_symlink()) and not p.is_relative_to(root / ACCEPTED)\n             and p != root / COMPLETION and '__pycache__' not in p.parts]\n    for subject, attempt in attempts.items():\n        paths.extend(p for p in (root / 'docs/planning/reviews' / subject / attempt).rglob('*')\n                     if (p.is_file() or p.is_symlink()) and '__pycache__' not in p.parts)\n    return paths\n\n\ndef latest_attempt(root, subject):\n    attempts = [p.name for p in (root / 'docs/planning/reviews' / subject).glob('attempt-*')\n                if p.is_dir() and p.name.removeprefix('attempt-').isdigit()]\n    require(attempts, 'missing actual P11 member/phase review: ' + subject)\n    return max(attempts, key=lambda name: int(name.removeprefix('attempt-')))\n\n\ndef require_archive_lfs(root):\n    result = subprocess.run(['/usr/bin/git', 'check-attr', '-z', 'filter', '--', *LFS_PATHS],\n                            cwd=root, capture_output=True, check=True)\n    fields = result.stdout.decode().strip('\\0').split('\\0')\n    require(len(fields) == len(LFS_PATHS) * 3\n            and all(fields[i:i+3] == [name, 'filter', 'lfs'] for i, name in zip(range(0, len(fields), 3), LFS_PATHS)),\n            'configure reviewed P11 archive Git LFS paths before finalization')\n\n\ndef audited_reviews(root, attempts, qualified, source):\n    root = Path(root).resolve()\n    require(set(attempts) == set(SUBJECTS), 'P11 requires exactly four member reviews and its phase review')\n    reviews = {}\n    for subject in SUBJECTS:\n        attempt = attempts[subject]\n        require(attempt == latest_attempt(root, subject), 'newer review attempt exists: ' + subject)\n        request = read(root / 'docs/planning/reviews' / subject / attempt / 'request.json')\n        require(request['qualification'] == qualified,\n                'P11 reviews do not bind one shared qualification: ' + subject)\n        reviews[subject] = actual_review(root, subject, attempt, source_root=source)\n        require(all(value >= 9 for value in reviews[subject]['scores'].values()),\n                'P11 promotion requires full-9 reviewed standing: ' + subject)\n    phase = read(root / 'docs/planning/reviews/P11' / attempts['P11'] / 'request.json')\n    require(phase['predecessors']['members'] == {name: reviews[name] for name in CHUNKS},\n            'phase review did not consume these exact four audited member reviews')\n    require(all(row['fingerprints']['source'] == qualified['verified']['source_inventory_sha256']\n                for row in reviews.values()), 'reviews bind a foreign qualified source')\n    return reviews\n\n\ndef verify(root):\n    \"\"\"Verify immutable historical standing; no current build directory needed.\"\"\"\n    root = Path(root).resolve()\n    path = root / COMPLETION\n    require(path.is_file(), 'P11 promotion requires actual accepted standing: ' + str(COMPLETION))\n    record = read(path)\n    require(record['schema'] == 'airs-desktop/p11-completion-proof/1'\n            and record['controller_complete'] is False, 'P11 standing schema/controller claim')\n    require(record['context']['path'] == str(ACCEPTED / 'historical-context.json'),\n            'P11 standing context is foreign')\n    history = ArchivedP11(root, record['context'])\n    qualified = record['qualification']\n    original = read(bound(root, {'path': qualified['record'], 'sha256': qualified['sha256']}))\n    require(original['schema'] == 'airs-desktop/p11-shared-qualification/1', 'foreign P11 qualification')\n    coverage = read(bound(root, original['coverage']))\n    source_hash = coverage['source_inventory_sha256']\n    source = history.source(source_hash)\n    seal = read(bound(root, original['source']))\n    require(digest(seal['files']) == source_hash, 'original P11 source seal differs')\n    import proof\n    result = proof.verify_coverage(root, coverage, historical=history)\n    require(result == qualified['verified'], 'archived P11 raw qualification differs')\n    candidate = read(bound(root, coverage['candidate']))\n    from candidate import verify_candidate\n    verify_candidate(root, candidate, historical=history)\n    require(coverage['candidate']['sha256'] == qualified['candidate_sha256'],\n            'P11 accepted candidate reference differs')\n    if 'review_remediation' not in original:\n        proof.validate_execution(root, read(bound(root, original['native_execution'])), candidate,\n            acceptance=bound(root, original['native_acceptance']) if 'native_acceptance' in original else None,\n            execution=bound(root, original['native_execution']))\n    inventory = read(bound(root, record['evidence']))['files']\n    require(inventory, 'P11 raw evidence inventory missing')\n    require(set(inventory) == {str(p.relative_to(root)) for p in evidence_files(root, record['attempts'])},\n            'P11 retained evidence membership differs')\n    for name, identity in inventory.items():\n        target = root / name\n        require(target.resolve().is_relative_to(root), 'P11 evidence escapes checkout')\n        require(file_identity(target) == identity,\n                'P11 retained evidence drift (hydrate pinned LFS objects if needed): ' + name)\n    reviews = audited_reviews(root, record['attempts'], qualified, source)\n    require(reviews == record['reviews'], 'P11 audited review standing changed')\n    baseline = release_prerequisites(root)\n    require(record['historical_standing'] == original['historical_standing'] == baseline,\n            'P11 historical baseline standing differs')\n    return {'schema': 'airs-desktop/p11-promotion-prerequisites/1',\n            'record': str(COMPLETION), 'sha256': sha(path),\n            'qualification': qualified, 'reviews': reviews, 'controller_complete': False}\n\n\ndef finalize(root, qualification_path, attempts):\n    \"\"\"Archive only after actual reviews; refuse every existing output path.\n\n    Large files under accepted/application and accepted/source/resources/harness\n    must have their reviewed explicit Git LFS rules before the qualified seal.\n    This function never runs a test, native driver, build, signing or publication.\n    \"\"\"\n    root = Path(root).resolve()\n    destination, completion = root / ACCEPTED, root / COMPLETION\n    require(not destination.exists() and not completion.exists(), 'preserve existing accepted P11 archive')\n    require_archive_lfs(root)\n    import proof\n    qualified = proof.verify(root, Path(qualification_path).resolve())\n    reviews = audited_reviews(root, attempts, qualified, root)\n    original = read(root / qualified['record'])\n    seal = read(bound(root, original['source']))\n    coverage = read(bound(root, original['coverage']))\n    candidate = read(bound(root, coverage['candidate']))\n    prepared = read(bound(root, candidate['prepare']))\n    evidence = identities(root, evidence_files(root, attempts))\n    destination.mkdir(parents=True, exist_ok=False)\n\n    def write(name, value):\n        path = destination / name\n        with path.open('x') as stream:\n            json.dump(value, stream, indent=2)\ndef verify_coverage(root, qualified, historical=None):\n    receipt = read(bound(root, qualified['review_remediation']))\n    candidate = read(bound(root, qualified['candidate']))\n    source = historical.source(qualified['source_inventory_sha256']) if historical else root\n    files = read(bound(root, receipt['current_source']))['files']\n    require(digest(files) == qualified['source_inventory_sha256']\n            and files == ({str(p.relative_to(source)): proof.file_identity(p) for p in source.rglob('*')\n                           if p.is_file() or p.is_symlink()} if historical else proof.source_inventory(root)),\n            'remediation current source differs')\n    require(receipt['schema'] == 'airs-desktop/p11-review-remediation/1'\n            and receipt['runner_inputs'] == candidate['runner_inputs'], 'remediation source binding missing')\n    original_record, original_coverage, history = source_transition(root, receipt, candidate, source, files)\n    source_qa(root, receipt['source_qa'], files)\n    originals = {r['id']: r for r in original_coverage['coverage']}\n    recovery(root, receipt['recovery'], receipt['baseline'], candidate, originals['C48-N03']['result'], files)\n    modes = {cid: 'executed' if cid in SOURCE_IDS | {'C48-N03'} else 'carried_unaffected' for cid in originals}\n    plan = read(bound(root, qualified['plan']))\n    proof.verify_plan(source, plan, modes)\n    rows = qualified['coverage']\n    require(len(rows) == len(originals) and {r['id'] for r in rows} == set(originals), 'remediation coverage missing/duplicated')\n    require(set(receipt['unaffected']) == set(originals)-SOURCE_IDS-{'C48-N03'}, 'unchanged-impact reason missing')\n    requirements = {r['id']: r for r in plan['requirements']}\n    for row in rows:\n        cid = row['id']; require(row['disposition'] == modes[cid], 'remediation disposition differs')\n        if cid in SOURCE_IDS | {'C48-N03'}:\n            expected = {'schema': 'airs-desktop/p11-affected-selector-result/1', 'required_id': cid,\n                'actual_evidence': selector_reference(receipt, cid),\n                'original_result': originals[cid]['result'],\n                'meaning': 'Actual affected selectors supplement the retained original registered goal. No full original command or unrelated native flow is claimed newly executed.'}\n            require(read(bound(root, row['result'])) == expected, 'affected goal lacks actual selector evidence')\n            continue\n        require(row['result'] == originals[cid]['result'] and receipt['unaffected'][cid], 'original result was relabelled')\n        original = read(bound(root, row['result'])); origin = read(bound(root, original['candidate']))\n        deps = dependencies(files, cid, requirements[cid].get('helper_paths', []))\n        require(requirements[cid].get('dependencies') == deps\n                and row['impact']['dependencies'] == deps\n                and row['impact']['reason'] == receipt['unaffected'][cid]\n                and row['impact']['original_candidate_sha256'] == original['candidate']['sha256'],\n                'remediation dependency scope/rationale differs')\n        impact = read(bound(root, row['impact']['proof']))\n        bindings = impact['file_bindings']\n        require(set(bindings) == set(deps) and deps\n                and impact['unchanged_dependencies'] == deps\n                and impact['current_source_inventory_sha256'] == qualified['source_inventory_sha256']\n                and impact['original_candidate_sha256'] == original['candidate']['sha256'],\n                'remediation dependency proof binding differs')\n        old_source = history.source(origin['source_inventory_sha256'])\n        for name in deps:\n            value = bindings[name]\n            require(value['original_sha256'] == value['current_sha256'] == sha(source/name) == sha(old_source/name),\n                    'carried dependency changed: ' + name)\n    # The old custom partial Check rows were already validated above in their\n    # archived source. Their failed full-run status must not be rewritten to\n    # satisfy the generic all-pass-run parser. Other original raw rows use it.\n    generic_ids = {cid for cid in originals if cid not in SOURCE_IDS | {'C48-N03'} and not cid.startswith('check:')}\n    runtime_plan = read(bound(root, qualified['runtime_plan']))\n    require(runtime_plan == dict(plan, requirements=[r for r in plan['requirements'] if r['id'] in generic_ids]),\n            'remediation generic coverage projection differs')\n    proof.coverage.verify(root, dict(qualified, plan=qualified['runtime_plan'],\n        coverage=[r for r in rows if r['id'] in generic_ids]), historical=historical)\n    return {'qualified': True, 'required': len(rows),\n            'dispositions': {m: sum(r['disposition'] == m for r in rows) for m in sorted(set(modes.values()))},\n            'candidate_sha256': qualified['candidate']['sha256'], 'source_inventory_sha256': qualified['source_inventory_sha256']}\n\n\ndef versioned_build(root, build, candidate):\n\"\"\"Explicit C45/P10 evidence accounting. Does not execute checks or assign scores.\n\nThe existing runners produce raw records; this consumer rejects omitted coverage,\nchanged evidence, unsupported retirement and affected checks carried as unchanged.\nHistorical results always retain their original candidate and execution bindings.\n\"\"\"\nfrom pathlib import Path\nimport hashlib\nimport json\n\n\ndef require(value, message):\n    if not value:\n        raise ValueError(message)\n\n\ndef read(path):\n    return json.loads(Path(path).read_text())\n\n\ndef sha(path):\n    return hashlib.sha256(Path(path).read_bytes()).hexdigest()\n\n\ndef digest(value):\n    return hashlib.sha256((json.dumps(value, sort_keys=True, separators=(\",\", \":\")) + \"\\n\").encode()).hexdigest()\n\n\ndef bound(root, reference):\n    path = root / reference[\"path\"]\n    require(path.resolve().is_relative_to(root.resolve()), \"evidence escapes checkout\")\n    require(sha(path) == reference[\"sha256\"], \"evidence hash drift: \" + str(path))\n    return path\n\n\nEXACT_FIELDS = (\"executable_sha256\", \"bundle_sha256\", \"build_flags\", \"conditions\")\n\n\ndef verify_raw(root, needed, execution, origin):\n    require(execution[\"argv\"] == needed[\"argv\"], \"execution command differs from approved plan\")\n    require(execution[\"cwd\"] == origin[\"execution_root\"], \"execution cwd differs from original candidate\")\n    raw_path = bound(root, execution[\"raw\"])\n    raw = read(raw_path)\n    if needed[\"kind\"] == \"native\":\n        require(raw[\"schema\"] == \"airs-v2/native-acceptance/1\" and raw[\"app\"][\"executable_sha256\"] == origin[\"executable_sha256\"], \"raw native candidate mismatch\")\n        checks = [check for check in raw[\"checks\"] if check[\"id\"] == needed[\"id\"]]\n        require(len(checks) == 1 and checks[0][\"result\"] == \"pass\" and checks[0].get(\"observation\") and checks[0].get(\"evidence\"), \"raw native assertion not passing\")\n        for name in checks[0][\"evidence\"]:\n            require(name in execution[\"evidence\"], \"native evidence missing from execution inventory\")\n            bound(root, {\"path\":name,\"sha256\":execution[\"evidence\"][name]})\n    elif needed[\"kind\"] == \"command\":\n        require(raw[\"schema\"] == \"airs-v2/run/1\" and raw[\"status\"] == \"passed\" and raw[\"failure\"] is None and raw[\"inputs_before\"] == raw[\"inputs_after\"], \"raw runner failed or inputs changed\")\n        require(raw[\"inputs_before\"] == origin[\"runner_inputs\"], \"runner input fingerprint does not bind original candidate\")\n        commands = [command for command in raw[\"commands\"] if command[\"label\"] == needed[\"label\"]]\n        require(len(commands) == 1, \"raw runner command missing/duplicated\")\n        command = commands[0]\n        require(command[\"status\"] == \"passed\" and command[\"exit_code\"] == 0 and command[\"argv\"] == needed[\"argv\"] and command[\"cwd\"] in [\".\", origin[\"execution_root\"]] and not command[\"note\"], \"raw runner command failed/differs\")\n        require(command[\"output_sha256\"] == execution[\"log\"][\"sha256\"] and str((raw_path.parent/command[\"log\"]).relative_to(root)) == execution[\"log\"][\"path\"], \"raw runner log binding\")\n        if needed.get(\"expects_tests\"):\n            require(command[\"tests\"] and command[\"tests\"][\"passed\"] > 0 and command[\"tests\"][\"failed\"] == 0, \"test command did not execute passing tests\")\n    else:\n        raise ValueError(\"unsupported required raw execution kind\")\n\n\ndef verify(root, record, historical=None):\n    require(record[\"schema\"] == \"airs-desktop/qualified-coverage/1\", \"coverage schema\")\n    plan = read(bound(root, record[\"plan\"]))\n    require(plan[\"schema\"] == \"airs-desktop/required-coverage/1\", \"plan schema\")\n    requirements = plan[\"requirements\"]\n    ids = [item[\"id\"] for item in requirements]\n    require(len(ids) == len(set(ids)) and ids, \"duplicate/empty required coverage\")\n    rows = record[\"coverage\"]\n    require(len(rows) == len(ids) and {r[\"id\"] for r in rows} == set(ids), \"missing/duplicate/unknown coverage\")\n    by_id = {item[\"id\"]: item for item in requirements}\n    candidate = read(bound(root, record[\"candidate\"]))\n    require(all(candidate.get(k) for k in EXACT_FIELDS) and candidate.get(\"helper_closure\"), \"candidate binding incomplete\")\n    require(candidate.get(\"source_inventory_sha256\") == record[\"source_inventory_sha256\"], \"candidate source binding\")\n    for row in rows:\n        needed = by_id[row[\"id\"]]\n        mode = row[\"disposition\"]\n        require(mode in [\"executed\", \"reused_exact\", \"carried_unaffected\", \"not_applicable\"], \"unsupported coverage disposition\")\n        if mode == \"not_applicable\":\n            decision = needed.get(\"retirement\")\n            require(decision and row.get(\"reason\") and row.get(\"decision\") == decision, \"unapproved assertion retirement\")\n            bound(root, decision)\n            continue\n        original = read(bound(root, row[\"result\"]))\n        require(original.get(\"status\") == \"pass\" and original.get(\"exit_code\") == 0, \"result is not an actual passing execution\")\n        require(original.get(\"execution_id\") and original.get(\"argv\") and original.get(\"cwd\") and original.get(\"started_utc\") and original.get(\"finished_utc\"), \"execution provenance missing\")\n        require(row[\"id\"] in original.get(\"required_ids\", []), \"result does not cover required assertion\")\n        bound(root, original[\"log\"])\n        origin = read(bound(root, original[\"candidate\"]))\n        require(all(origin.get(k) for k in EXACT_FIELDS) and origin.get(\"helper_closure\"), \"original candidate binding incomplete\")\n        verify_raw(root, needed, original, origin)\n        if mode in [\"executed\", \"reused_exact\"]:\n            if mode == \"reused_exact\":\n                require(not needed.get(\"must_execute\", needed.get(\"affected\", True)), \"changed check must execute\")\n            helpers = needed.get(\"helper_paths\")\n            if helpers is None:\n                require(origin[\"helper_closure\"] == candidate[\"helper_closure\"], \"relevant helper closure differs\")\n            else:\n                require(all(name in origin[\"helper_closure\"] and name in candidate[\"helper_closure\"] and origin[\"helper_closure\"][name] == candidate[\"helper_closure\"][name] for name in helpers), \"relevant helper closure differs\")\n            require(all(origin[k] == candidate[k] for k in EXACT_FIELDS), \"artifact/helper/flags/conditions differ\")\n            if mode == \"executed\":\n                require(origin[\"source_inventory_sha256\"] == record[\"source_inventory_sha256\"], \"execution is historical, not current\")\n        else:\n            require(not needed.get(\"affected\", True), \"affected check cannot be carried unchanged\")\n            rationale = row.get(\"impact\")\n            require(rationale and rationale.get(\"reason\") and rationale.get(\"dependencies\") == needed.get(\"dependencies\") and rationale.get(\"original_candidate_sha256\") == original[\"candidate\"][\"sha256\"], \"unchanged-impact proof missing\")\n            proof = read(bound(root, rationale[\"proof\"]))\n            bindings = proof.get(\"file_bindings\", {})\n            require(set(bindings) == set(needed[\"dependencies\"]) and bindings, \"dependency membership proof missing\")\n            current_files=historical.source(record['source_inventory_sha256']) if historical else root\n            original_files=historical.source(origin['source_inventory_sha256']) if historical else root\n            for dependency, binding in bindings.items():\n                require(binding[\"original_sha256\"] == binding[\"current_sha256\"] == sha(current_files/dependency), \"dependency changed: \" + dependency)\n                original_source = original_files/dependency if historical else bound(root, binding[\"original_file\"])\n                require(sha(original_source) == binding[\"original_sha256\"], \"original dependency proof mismatch\")\n            require(proof.get(\"unchanged_dependencies\") == needed[\"dependencies\"] and proof.get(\"current_source_inventory_sha256\") == record[\"source_inventory_sha256\"] and proof.get(\"original_candidate_sha256\") == original[\"candidate\"][\"sha256\"], \"impact proof does not bind current and original inputs\")\n    return {\"qualified\": True, \"required\": len(ids), \"dispositions\": {m: sum(r[\"disposition\"] == m for r in rows) for m in sorted({r[\"disposition\"] for r in rows})}, \"candidate_sha256\": record[\"candidate\"][\"sha256\"], \"source_inventory_sha256\": record[\"source_inventory_sha256\"]}\n","exit_code":0,"status":"completed"}}
