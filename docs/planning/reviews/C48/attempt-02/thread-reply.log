ry}\n                    </Btn>\n                ) : null}\n                <Btn tier='tertiary' onClick={() => void call({ kind: 'clearCookies' }).then((r) => setMessage(r.kind === 'done' ? C.cookiesCleared : (resultText(r) ?? '')))}>\n                    {C.clearCookies}\n                </Btn>\n            </div>\n        </section>\n    )\n}\ndiff --git a/apps/desktop/src/app.tsx b/apps/desktop/src/app.tsx\nindex 9aabf0d2..58236e3c 100644\n--- a/apps/desktop/src/app.tsx\n+++ b/apps/desktop/src/app.tsx\n@@ -103,6 +103,7 @@ export function App({ client }: { client: DesktopClient }) {\n                     // The shell's scope follows the snapshot before it renders: a\n                     // notification for another tenant or context is never surfaced.\n                     useShellStore.getState().setScope(next.active?.tenant ?? null, next.active?.context ?? null, next.switchBlocked?.review ?? null)\n+                    useShellStore.getState().observeWorkbench(next.active?.tenant ?? null, next.active?.context ?? null, next.workbench.collection?.scope ?? null)\n                     setSnapshot(next)\n                 },\n                 onMenu: (command) => onMenu.current(command),\n@@ -134,9 +135,10 @@ export function App({ client }: { client: DesktopClient }) {\n     }, [storage, resetFailed])\n \n     const appearance = snapshot?.appearance\n+    const colorTheme = snapshot?.colorTheme\n     // Apply the theme in the same commit as the snapshot, before paint, so\n     // the shell never shows a frame in the previous theme.\n-    useLayoutEffect(() => (appearance ? followAppearance(appearance) : undefined), [appearance])\n+    useLayoutEffect(() => (appearance ? followAppearance(appearance, colorTheme) : undefined), [appearance, colorTheme])\n \n     if (failure && !snapshot) {\n         return (\ndiff --git a/apps/desktop/src/v2/store.ts b/apps/desktop/src/v2/store.ts\nindex b6f136bf..405d567d 100644\n--- a/apps/desktop/src/v2/store.ts\n+++ b/apps/desktop/sr