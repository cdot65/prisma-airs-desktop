ative-acceptance/fixture_app.py:369:    def install_roots(self):\ntools/native-acceptance/fixture_app.py:374:    def start(self):\ntools/native-acceptance/fixture_app.py:383:    def stop(self):\ntools/native-acceptance/fixture_app.py:389:    def mode(self, reply, delay_ms=0):\ntools/native-acceptance/fixture_app.py:393:    def requests(self):\ntools/native-acceptance/fixture_app.py:404:    def __init__(self, directory):\ntools/native-acceptance/fixture_app.py:414:    def origin(self):\ntools/native-acceptance/fixture_app.py:417:    def install(self):\ntools/native-acceptance/fixture_app.py:425:    def start(self):\ntools/native-acceptance/fixture_app.py:434:    def stop(self):\ntools/native-acceptance/fixture_app.py:440:    def mode(self, **values):\ntools/native-acceptance/fixture_app.py:444:    def requests(self):\ntools/native-acceptance/fixture_app.py:452:def opened_urls():\ntools/native-acceptance/fixture_app.py:460:def keychain_accounts(service):\n\"\"\"Drives the production rfd sheets (NSOpenPanel / NSSavePanel) in the\nfixture build, which uses them when `fixture-native-sheets` exists in its\ndata root. The panels list the operator's own folders, so callers must not\nsave Accessibility trees while a panel is shown; every path typed here is a\ndriver-owned temporary directory.\n\"\"\"\n\nimport os\nimport time\n\nimport fixture_app as fx\n\nFLAG = os.path.join(fx.DATA, \"fixture-native-sheets\")\n\n\ndef enable():\n    os.makedirs(fx.DATA, exist_ok=True)\n    open(FLAG, \"w\").close()\n\n\ndef disable():\n    if os.path.exists(FLAG):\n        os.remove(FLAG)\n\n\ndef sheets(tree):\n    return sum(1 for n in tree if n.get(\"role\") == \"AXSheet\")\n\n\ndef wait_sheet(app, count=1, timeout=10):\n    return app.wait_for(lambda t: sheets(t) >= count, timeout)[1]\n\n\ndef wait_closed(app, timeout=10):\n    return app.wait_for(lambda t: sheets(t) == 0, timeout)[1]\n\n\ndef in_sheet(tree, label):\n    \"\"\"The `ax press` index of the last enabled button labelled `label`\n    inside a sheet, or None. `ax press` matches by label prefix across every\n    window in tree order, so a window button with the same label (Settings\n    has its own Save) is counted but never chosen.\"\"\"\n    found, matched, sheet = None, 0, None\n    for n in tree:\n        if sheet is not None and n.get(\"depth\", 0) <= sheet:\n            sheet = None\n        if n.get(\"role\") == \"AXSheet\":\n            sheet = n.get(\"depth\", 0)\n        elif n.get(\"role\") == \"AXButton\" and (n.get(\"label\") or \"\").startswith(label):\n            if sheet is not None and n.get(\"label\") == label and n.get(\"enabled\"):\n                found = matched\n            matched += 1\n    return found\n\n\ndef press(app, label, attempts=4):\n    \"\"\"AXPresses a panel button once it is enabled (panels settle late).\"\"\"\n    for _ in range(attempts):\n        tree, ready = app.wait_for(lambda t: in_sheet(t, label) is not None, 6)\n        nth = in_sheet(tree, label)\n        if nth is None:\n            continue\n        try:\n            app.ax(\"press\", \"AXButton\", label, nth)\n            return True\n        except RuntimeError:\n            time.sleep(1.0)\n            # A press that opens a confirmation (Replace) can report an\n            # error although it took effect: the button is then held.\n            if in_sheet(app.tree(), label) is None:\n                return True\n    return False\n\n\ndef go_to(app, path):\n    \"\"\"Opens Go to Folder in the shown panel and goes to `path`.\"\"\"\n    app.keys(\"g\", \"command down, shift down\")\n    if not wait_sheet(app, 2, 6):\n        raise RuntimeError(\"Go to Folder did not open\")\n    app.keys(\"a\", \"command down\")\n    app.keys(path)\n    time.sleep(1.5)\n    app.keycode(36)\n    app.wait_for(lambda t: sheets(t) == 1, 6)\n    time.sleep(1.0)\n\n\ndef save_as(app, directory, name=None, replace=False):\n    \"\"\"Saves into `directory` (optionally as `name`) through the shown save\n    panel; with `replace`, confirms replacing an existing file.\"\"\"\n    if not wait_sheet(app):\n        raise RuntimeError(\"no save panel\")\n    if name:\n        app.keys(\"a\", \"command down\")\n        app.keys(name)\n    go_to(app, directory.rstrip(\"/\") + \"/\")\n    if not press(app, \"Save\"):\n        raise RuntimeError(\"Save could not be pressed\")\n    if replace:\n        tree, shown = app.wait_for(lambda t: fx.App.node(t, \"AXButton\", \"Replace\") is not None, 6)\n        if not shown:\n            raise RuntimeError(\"no replace confirmation\")\n        press(app, \"Replace\")\n    return wait_closed(app)\n\n\ndef open_file(app, path):\n    \"\"\"Chooses `path` in the shown open panel.\"\"\"\n    if not wait_sheet(app):\n        raise RuntimeError(\"no open panel\")\n    go_to(app, path)\n    if not press(app, \"Open\"):\n        raise RuntimeError(\"Open could not be pressed\")\n    return wait_closed(app)\n\n\ndef cancel(app):\n    if not wait_sheet(app):\n        raise RuntimeError(\"no panel\")\n    press(app, \"Cancel\")\n    return wait_closed(app)\n\"\"\"Shared driving helpers for the prepared fixture app (C03 onward): process\ncontrol, the compiled Accessibility helper, frontmost-guarded keystrokes,\nfixture data-root hygiene and the synthetic scan endpoint.\n\nKeystrokes go through System Events only after the fixture app is confirmed\nfrontmost, so they can never reach another application. The fixture build\nkeeps data in its own Application Support directory and credentials in a\ndedicated fixture test keychain there; the login keychain and v1 data are\nnever touched.\n\"\"\"\n\nimport json\nimport hashlib\nimport stat\nimport os\nimport shutil\nimport signal\nimport socket\nimport subprocess\nimport time\nimport tempfile\nimport candidate_process as candidate\n\nHOME = os.path.expanduser(\"~\")\nDATA = os.path.join(HOME, \"Library/Application Support/io.cdot.airs-desktop.fixture\")\nKEYCHAIN = os.path.join(DATA, \"fixture-credentials.keychain-db\")\nROOTS = os.path.join(DATA, \"fixture-transport-roots.pem\")\n# Controlled prior-installation canaries only: never inspect real alpha/v2 roots.\n_PRIOR_SANDBOX = tempfile.TemporaryDirectory(prefix=\"airs-desktop-prior-canaries-\")\nV1_DATA = os.path.join(_PRIOR_SANDBOX.name, \"prior-installations\")\nfor _namespace in (\"alpha\", \"v2\"):\n    _directory = os.path.join(V1_DATA, _namespace)\n    os.makedirs(_directory)\n    for _name in (\"state.json\", \"sessions.canary\", \"approvals.canary\", \"credentials.canary\"):\n        with open(os.path.join(_directory, _name), \"wb\") as _file:\n            _file.write((\"SYNTHETIC-PRIOR-\" + _namespace + \":\" + _name).encode())\nPROCESS = \"Fixture.app/Contents/MacOS/prisma-airs-desktop\"\nTOOLS = os.path.dirname(os.path.abspath(__file__))\n\n\ndef sh(argv, **kw):\n    if os.path.basename(str(argv[0])) in (\"pkill\", \"killall\"):\n        raise RuntimeError(\"process-name signaling is forbidden; use candidate-owned PID controls\")\n    return subprocess.run(argv, capture_output=True, text=True, **kw)\n\ndef bind_candidate(bundle):\n    return candidate.bind(bundle)\n\ndef launch_candidate(bundle):\n    return candidate.bind(bundle).launch()\n\ndef stop_app():\n    return candidate.stop_app()\n\ndef stop_engines():\n    return candidate.stop_engines()\n\ndef signal_engine(pid, sig=signal.SIGKILL):\n    return candidate.signal_engine(pid,sig)\n\n\n\nclass App:\n    \"\"\"One fixture bundle driven through Accessibility.\"\"\"\n\n    def __init__(self, bundle, work, log):\n        self.bundle = bundle\n        self.candidate = candidate.bind(bundle)\n        self.log = log\n        self.ax_bin = os.path.join(work, \"ax\")\n        built = sh([\"swiftc\", \"-O\", os.path.join(TOOLS, \"ax.swift\"), \"-o\", self.ax_bin])\n        if built.returncode != 0:\n            raise SystemExit(f\"ax helper did not build: {built.stderr}\")\n        self.pid = None\n\n    def note(self, what, **data):\n        self.log.append({\"t\": time.strftime(\"%H:%M:%S\"), \"step\": what, **data})\n\n    # ---- process ----\n    @staticmethod\n    def running_pid():\n        return candidate.app_pid()\n\n    def quit(self):\n        pid = self.running_pid()\n        if pid:\n            try:\n                self.keys(\"q\", \"command down\")\n            except RuntimeError:\n                pass\n            for _ in range(40):\n                time.sleep(0.25)\n                if not self.running_pid():\n                    break\n        candidate.stop_app()\n","exit_code":0,"status":"completed"}}
