                           style={{\n                                border: 0,\n                                minHeight: 0,\n                                height: 24,\n                                padding: 0,\n                                borderRadius: 0,\n                                background: 'transparent',\n                                color: 'var(--v2-ink)',\n                            }}\n                        >\n                            <option value=''>{C.chips.noEnvironment}</option>\n                            {collection.environments.map((e) => (\n                                <option key={e.name} value={e.name}>\n                                    {e.name}\n                                </option>\n                            ))}\n                        </select>\n                        {environment ? <span style={faint}>{C.chips.envOrigin[environment.origin] ?? environment.origin}</span> : null}\n                    </label>\n                </div>\n            ) : null} />\n        </div>\n    )\n\n    const alerts = (\n        <>\n            {state.network !== 'live' ? (\n                <p className='text-[12px]' style={faint} data-slot='workbench-network'>\n                    {state.network === 'loopbackOnly' ? C.network.loopbackOnly : C.network.none}\n                </p>\n            ) : null}\n            {state.failure ? (\n                <p role='alert' className='rounded-[10px] text-[13px]' style={{ padding: '12px 14px', background: 'var(--v2-block-bg)' }}>\n                    {C.privateFailure(state.failure)}\n                </p>\n            ) : null}\n            {message && collection ? (\n                <p role='alert' className='text-[13px]' style={{ color: 'var(--v2-block)' }} data-slot='workbench-message'>\n                    {message}\n                </p>\n            ) : null}\n            {collection?.issues.length ? (\n                <div role='alert' className='rounded-[10px] text-[13px]' style={{ padding: '12px 14px', background: 'var(--v2-flag-bg)' }} data-slot='workbench-issues'>\n                    <p>{C.issues(collection.issues.length, collection.complete)}</p>\n                    <ul className='mt-1 list-disc pl-5 text-[12px]'>\n                        {collection.issues.slice(0, 10).map((i) => (\n                            <li key={`${i.relative}:${i.kind}`}>{`${i.relative}: ${i.kind}`}</li>\n                        ))}\n                    </ul>\n                </div>\n            ) : null}\n            {collection?.unsaved ? (\n                <p role='alert' className='rounded-[10px] text-[13px]' style={{ padding: '12px 14px', background: 'var(--v2-block-bg)' }}>\n                    {C.unsaved(collection.unsaved)}\n                </p>\n            ) : null}\n        </>\n    )\n\n    if (!state.available) {\n        return (\n            <section\n                aria-label={C.title}\n                data-slot='api-client-v2'\n                className='flex min-h-0 min-w-0 flex-grow flex-col'\n                style={{\n                    margin: 'calc(-1 * var(--v2-page-top)) calc(-1 * var(--v2-page-x)) -28px',\n                }}\n            >\n                {band}\n                <p role='alert' className='text-[13px]' style={{ padding: '20px var(--v2-page-x)' }}>\n                    {C.unavailable}\n                </p>\n            </section>\n        )\n    }\n\n    return (\n        <section\n            aria-label={C.title}\n            data-slot='api-client-v2'\n            className='flex min-h-0 min-w-0 flex-grow flex-col'\n            style={{\n                margin: 'calc(-1 * var(--v2-page-top)) calc(-1 * var(--v2-page-x)) -28px',\n            }}\n        >\n            {band}\n            {!collection ? (\n                <div className='flex flex-col' style={{ gap: 12, padding: '20px var(--v2-page-x)' }}>\n                    {alerts}\n                    {state.loaded ? (\n                        <Start state={state} run={run} message={startupFailure ? `${C.start.restoreFailed}${message ? ` ${message}` : ''}` : message} offerNew={offerNew} retry={startupFailure ? async () => { await restorePreferred() } : undefined} />\n                    ) : (\n                        <p role='status' className='text-[13px]' style={soft}>\n                            {C.opening}\n                        </p>\n                    )}\n                </div>\n            ) : (\n                <>\n                    <div className='flex min-h-0 flex-grow' data-slot='api-body'>\n                        <RequestTree\n                            collection={collection}\n                            onOpen={open}\n                            onCreate={async (kind, relative) => {\n                                // A new request's document is a load too: bound to this collection and the current generation.\n                                const load = kind === 'request' ? beginLoad(null) : null\n                                const r = await run(kind === 'request' ? { kind: 'newRequest', relative } : { kind: 'newFolder', relative })\n                                if (load) settleLoad(load, r, true)\n                                // The dialog says a refusal or a lost delivery itself (the page behind it is inert).\n                                return r.kind === 'document' || r.kind === 'done' || r.kind === 'cancelled' ? null : (resultText(r) ?? C.unknownFailure)\n                            }}\n                        />\n                        <div className='flex min-h-0 min-w-0 flex-grow flex-col' data-slot='api-main'>\n                            <div\n                                ref={tabStrip}\n                                role='tablist'\n                                aria-label={C.openRequests}\n                                className='flex min-w-0 shrink-0 items-end overflow-x-auto'\n                                onFocusCapture={(e) => (e.target as HTMLElement).scrollIntoView({ block: 'nearest', inline: 'nearest' })}\n                                style={{\n                                    minHeight: 36,\n                                    gap: 2,\n                                    padding: '0 8px',\n                                    borderBottom: '1px solid var(--v2-rule)',\n                                    background: 'var(--v2-side)',\n                                }}\n                                data-slot='workbench-tabs'\n                            >\n                                {collection.tabs.map((t) => {\n                                    const name = requestName(t.relative)\n                                    const on = t.id === collection.selected\n                                    const marks = [t.new ? 'new' : t.draft ? 'unsaved' : '', t.conflict ? `${t.conflict} on disk` : '', t.interrupted ? 'interrupted save' : '']\n                                        .filter(Boolean)\n                                        .join(', ')\n                                    return (\n                                        <span\n                                            key={t.id}\n                                            data-request-tab=''\n                                            className='flex shrink-0 items-center rounded-t-[7px] border border-b-0'\n                                            style={{\n                                                height: 30,\n                                                maxWidth: 240,\n                                                borderColor: on ? 'var(--v2-rule)' : 'transparent',\n                                                background: on ? 'var(--v2-bg)' : 'transparent',\n                                            }}\n                                        >\n                                            <button\n                                                type='button'\n                                                role='tab'\n                                                aria-selected={on}\n                                                aria-label={`${t.method} ${name}${marks ? ` (${marks})` : ''}`}\n                                                onClick={() => void run({ kind: 'selectTab', id: t.id })}\n                                                className='flex min-h-0 min-w-0 items-center text-[12px] whitespace-nowrap'\n                                                style={{\n                                                    gap: 7,\n                                                    height: 28,\n                                                    padding: '0 6px 0 12px',\n                                                    border: 0,\n                                                    background: 'transparent',\n                                                    color: 'var(--v2-ink)',\n                                                }}\n                                            >\n                                                <span className='font-mono text-[11px] font-bold' style={{ color: methodColor(t.method) }}>\n                                                    {t.method}\n                                                </span>\n                                                <span className='truncate'>{name}</span>\n                                                {t.draft || t.new ? (\n                                                    <span\n                                                        aria-hidden\n                                                        className='shrink-0 rounded-full'\n                                                        style={{\nexport function JsonBodyEditor({ id, value, readOnly, style, onChange }: { id: string; value: string; readOnly: boolean; style: CSSProperties; onChange: (text: string) => void }) {\n    const paint = useRef<HTMLPreElement>(null)\n    const input = useRef<HTMLTextAreaElement>(null)\n    const highlighted = value.length <= HIGHLIGHT_LIMIT\n    const sync = () => {\n        if (!input.current || !paint.current) return\n        // A non-overlay native scrollbar reduces the textarea's text width.\n        // Match that width before wrapping the inert color layer.\n        if (input.current.clientWidth > 0) paint.current.style.width = `${input.current.clientWidth + 2}px`\n        paint.current.scrollTop = input.current.scrollTop\n        paint.current.scrollLeft = input.current.scrollLeft\n    }\n    useLayoutEffect(() => {\n        sync()\n        if (!input.current || typeof ResizeObserver === 'undefined') return\n        const observer = new ResizeObserver(sync)\n        observer.observe(input.current)\n        return () => observer.disconnect()\n    }, [highlighted])\n    const shared: CSSProperties = { ...style, fontFamily: MONO, fontWeight: 400, letterSpacing: 'normal', whiteSpace: 'pre-wrap', overflowWrap: 'break-word', tabSize: 4 }\n    return <div className='relative min-w-0' data-slot='json-body-editor'>\n        {highlighted ? <pre ref={paint} aria-hidden='true' style={{ ...shared, position: 'absolute', inset: 0, margin: 0, height: '100%', overflow: 'hidden', pointerEvents: 'none', borderColor: 'transparent' }}><JsonText text={value} />{value.endsWith('\\n') ? ' ' : ''}</pre> : null}\n        <textarea ref={input} id={id} value={value} readOnly={readOnly} spellCheck={false} style={{ ...shared, display: 'block', position: 'relative', background: highlighted ? 'transparent' : style.background, color: highlighted ? 'transparent' : 'var(--v2-ink)', caretColor: 'var(--v2-ink)' }} onScroll={sync} onChange={(e) => onChange(e.target.value)} />\n    </div>\n}\n\n/** One complete template string, with noninteractive inline variable color. */\nexport function UrlTemplateInput({ label, value, onChange }: { label: string; value: string; onChange: (text: string) => void }) {\n    const paint = useRef<HTMLPreElement>(null)\n    const parts = value.split(/(\\{\\{[^{}]+\\}\\})/g)\n    const shared: CSSProperties = { fontFamily: MONO, fontSize: 12.5, lineHeight: '32px', letterSpacing: 'normal', padding: 0, border: 0, margin: 0 }\n    return <span className='relative min-w-0 flex-grow' data-slot='template-input'>\n        <pre ref={paint} aria-hidden='true' style={{ ...shared, position: 'absolute', inset: 0, overflow: 'hidden', whiteSpace: 'pre', pointerEvents: 'none', color: 'var(--v2-ink)' }}>{parts.map((part, i) => part.startsWith('{{') && part.endsWith('}}') ? <span key={i} data-variable='' style={{ color: 'var(--v2-acc)' }}>{part}</span> : part)}</pre>\n        <input aria-label={label} value={value} autoComplete='off' spellCheck={false} className='relative min-h-0 min-w-0 w-full bg-transparent' style={{ ...shared, borderRadius: 0, minHeight: 0, background: 'transparent', color: 'transparent', caretColor: 'var(--v2-ink)' }} onScroll={(e) => { if (paint.current) paint.current.scrollLeft = e.currentTarget.scrollLeft }} onChange={(e) => onChange(e.target.value)} />\n    </span>\n}\nimport type { RunRecord } from '@prisma-airs/desktop-contracts'\n\n/** The inspected response can be a collection-history entry from another request. */\nexport interface DisplayedResponse {\n    record: RunRecord\n    history: boolean\n}\n\n/** Presentation state only. No request/credential authority moves into the footer. */\nexport interface EditorStatus {\n    save: { text: string; state: 'new' | 'unsaved' | 'saved' }\n    response: DisplayedResponse | null\n}\nimport { create } from 'zustand'\n\nexport type ToastKind = 'ok' | 'info' | 'warn'\nimport type { AdminProductId, FeatureId, Intent, ManagementResource } from '@prisma-airs/desktop-contracts'\n\n/** What a contextual action asked the destination to select on arrival (C30), owned by the tenant it was followed in (I2). */\nexport interface Arrival {\n    tenant: string\n    feature: FeatureId\n    resource: ManagementResource | null\n    /** The item to filter to, by name. */\n    item: string | null\n    /** The Administration product to open (the rail's product children, C35). */\n    product?: AdminProductId\n    /** That product's tab to show, by the inventory's tab id (the tenant menu's workspace row, C35). */\n    tab?: string\n    /** Counts arrivals: a destination already open applies a new one. */\n    sequence: number\n}\n\n/** A Harness message kept for the operator: refused or never sent, or not confirmed (C32). */\nexport interface HarnessKept {\n    /** This record's own id: each attempt is its own record (C32). */\n    id: number\n    text: string\n    unconfirmed: boolean\n    /**\n     * For an unconfirmed send: the conversation it was sent to and the send's\n     * own ID. It is settled only when that conversation reports the core took\n     * that ID (`ConversationView.submissions`), never by matching text (C32).\n     */\n    conversation?: string\n    submission?: string\n}\n\n/** A Harness send the page dispatched, awaiting the core's word on it (C32): never shown, never sent again. */\nexport interface HarnessSent {\n    submission: string\n    conversation: string\n    text: string\n}\n\n/**\n * A Runtime case handed to the Playground (C33): Administration opens Runtime\n * Security's Playground tab with the case's fields; the operator runs the\n * scan there. Bound to the tenant it was opened in.\n */\nexport interface PlaygroundCase {\n    tenant: string\n    caseId: string\n    prefill: import('../modules/library/case-prefill').CasePrefill\n}\n\n/** A delivery the desktop did not confirm: kept until the operator retries or dismisses it (DESIGN-V2 §7). */\nexport interface Unconfirmed {\n    id: number\n    what: string\n    intent: Intent\n    /** The native context or captured switch source this delivery belongs to; retirement never rebinds it. */\n    context: string | null\n}\n\n/** An initial tenant selection captures even the absence of an active context. */\nexport function unconfirmedInContext(delivery: Pick<Unconfirmed, 'intent' | 'context'>, context: string | null): boolean {\n    return delivery.context === context || (delivery.context === null && delivery.intent.kind !== 'selectTenant')\n}\n\nfunction switchResolution(intent: Intent) {\n    return intent.kind === 'selectTenant' || intent.kind === 'completeTenantSetup' ? intent.resolution : null\n}\n\n/** A destructive switch is bound to its source, not its destination or setup draft. */\nexport function deliveryContext(intent: Intent): string | null {\n    const resolution = switchResolution(intent)\n    if (resolution) return resolution.context\n    return 'context' in intent && typeof intent.context === 'string' ? intent.context : null\n}\n\nexport interface Toast {\n    id: number\n    kind: ToastKind\n    text: string\n    /** An optional undo the toast offers (label + action). */\n    undo?: { label: string; run: () => void }\n    /** The tenant the toast speaks for (an item, a read): retired on leaving it (I2). */\n    tenant: string | null\n    /** The context it was raised under, when the action was context-bound: retired with it. */\n    context: string | null\n}\n\n/**\n * Transient shell presentation state (state-ownership.md \"UI\"): what is open,\n * the palette query, toasts and the modal stack. Nothing here survives a\n * reload and nothing here is authority: every durable fact is observed from\n * the Rust snapshot.\n */\n/** Unresolved preferred-collection recovery survives page navigation, but never a retired native scope or collection choice. */\ninterface WorkbenchRecovery {\n    tenant: string | null\n    context: string | null\n    collection: string | null\n    generation: number\n    pending: boolean\n    failed: boolean\n}\nconst initialWorkbenchRecovery = (): WorkbenchRecovery => ({ tenant: null, context: null, collection: null, generation: 0, pending: false, failed: false })\n\ninterface ShellStore {\n    /** The scope the shell shows now (set from each snapshot before it renders): what a notification must belong to. */\n    scope: { tenant: string | null; context: string | null; switchReview: string | null }\n    setScope(tenant: string | null, context: string | null, switchReview?: string | null): void\n    workbenchRecovery: WorkbenchRecovery\n    observeWorkbench(tenant: string | null, context: string | null, collection: string | null): void\n    beginWorkbenchRestore(tenant: string | null, context: string | null): number | null\n    finishWorkbenchRestore(tenant: string | null, context: string | null, generation: number, failed: boolean): void\n    resolveWorkbenchRestore(tenant: string | null, context: string | null, generation: number): void\n    paletteOpen: boolean\n    switcherOpen: boolean\n    /** The rail's Administration children shown or hidden (C35; the prototype's `adminNav`). */\n    adminNavOpen: boolean\n    setAdminNav(open: boolean): void\n    toasts: Toast[]\n    /** Open modal ids, bottom to top; only the last is interactive (I8). */\n    modals: string[]\n    /** The Inbox tab and item per tenant (I2: a switch round trip keeps it). */\n    inboxSelection: Record<string, { tab: 'all' | 'action' | 'updates' | 'snoozed'; item: string | null }>\n    selectInbox(tenant: string, selection: { tab: 'all' | 'action' | 'updates' | 'snoozed'; item: string | null }): void\n    /** Harness drafts, by `tenant|workspace|conversation` (C32): kept across navigation and tenant round trips, never shared between scopes, never sent by themselves. */\n    harnessDrafts: Record<string, string>\n    setHarnessDraft(scope: string, text: string): void\n    /** Per `tenant|workspace`: the operator chose a new investigation while one runs (C32). */\n    harnessFresh: Record<string, boolean>\n    setHarnessFresh(scope: string, fresh: boolean): void\n    /**\n     * Per `tenant|workspace`: messages kept for the operator (C32). `unconfirmed`\n     * ones may have been delivered (the desktop did not confirm it); the others\n     * were refused or never sent. Never sent by themselves.\n     */\n    harnessUnsent: Record<string, HarnessKept[]>\n    keepHarnessUnsent(scope: string, kept: Omit<HarnessKept, 'id'>): void\n    dropHarnessUnsent(scope: string, id: number): void\n    /**\n     * Per `tenant|workspace`: sends dispatched and not yet reported by their\n     * conversation (C32), so a send the core gives back keeps its text whatever\n     * order its receipt and the core's word arrive in. Newest 64.\n     */\n    harnessSent: Record<string, HarnessSent[]>\n    /** The case last handed to the Playground (C33); never runs anything by itself. */\n    playground: PlaygroundCase | null\n    openPlayground(target: Omit<PlaygroundCase, 'prefill'> & { prefill: Omit<PlaygroundCase['prefill'], 'nonce'> }): void\n    trackHarnessSend(scope: string, sent: HarnessSent): void\n    untrackHarnessSend(scope: string, submission: string): void\n    /** The last contextual action's target, consumed by the destination it names. */\n    arrival: Arrival | null\n    arrive(target: Omit<Arrival, 'sequence'>): void\n    /** Forgets an arrival that belongs to another tenant than `tenant`. */\n    scopeArrival(tenant: string | null): void\n    /** Drops unconfirmed deliveries bound to a context other than `context` (their authority retired). */\n    retireUnconfirmed(context: string | null): void\n    unconfirmed: Unconfirmed[]\n    /** Toast lifetime in ms (6 s; tests shorten it). */\n    toastMs: number\n    addUnconfirmed(what: string, intent: Intent, sourceContext?: string | null): number\n    clearUnconfirmed(id: number): void\n    openPalette(): void\n    closePalette(): void\n    setSwitcher(open: boolean): void\n    toast(text: string, kind?: ToastKind, undo?: Toast['undo'], tenant?: string | null, context?: string | null): number\n    /** Retires toasts that speak for another tenant than `tenant`. */\n    retireToasts(tenant: string | null): void\n    dismissToast(id: number): void\n    pushModal(id: string): void\n    popModal(id: string): void\n}\n\nlet nextToast = 1\nlet nextKept = 1\n\nexport const useShellStore = create<ShellStore>((set, get) => ({\n    scope: { tenant: null, context: null, switchReview: null },\n    setScope: (tenant, context, switchReview = null) =>\n        set((s) => ({\n            scope: { tenant, context, switchReview },\n            // Leaving a scope retires what spoke for it, however late it would have arrived.\n            toasts: s.toasts.filter((t) => (t.tenant === null || t.tenant === tenant) && (t.context === null || t.context === context)),\n            unconfirmed: s.unconfirmed.filter((u) => unconfirmedInContext(u, context) && (!switchResolution(u.intent) || switchResolution(u.intent)?.review === switchReview)),\n            arrival: s.arrival && s.arrival.tenant !== tenant ? null : s.arrival,\n        })),\n    workbenchRecovery: initialWorkbenchRecovery(),\n    observeWorkbench: (tenant, context, collection) => set((s) => {\n        const old = s.workbenchRecovery\n        if (old.tenant === tenant && old.context === context && old.collection === collection) return s\n        return { workbenchRecovery: { tenant, context, collection, generation: old.generation + 1, pending: false, failed: false } }\n    }),\n    beginWorkbenchRestore: (tenant, context) => {\n        const old = get().workbenchRecovery\n        if (old.tenant !== tenant || old.context !== context || old.collection !== null || old.pending) return null\n        const generation = old.generation + 1\n        set({ workbenchRecovery: { ...old, generation, pending: true } })\n        return generation\n    },\n    finishWorkbenchRestore: (tenant, context, generation, failed) => set((s) => {\n        const old = s.workbenchRecovery\n        if (old.tenant !== tenant || old.context !== context || old.generation !== generation || !old.pending) return s\n        return { workbenchRecovery: { ...old, pending: false, failed } }\n    }),\n    resolveWorkbenchRestore: (tenant, context, generation) => set((s) => {\n        const old = s.workbenchRecovery\n        if (old.tenant !== tenant || old.context !== context || old.generation !== generation) return s\n        return { workbenchRecovery: { ...old, generation: old.generation + 1, pending: false, failed: false } }\n    }),\n    paletteOpen: false,\n    switcherOpen: false,\n    adminNavOpen: true,\n    setAdminNav: (open) => set({ adminNavOpen: open }),\n    toasts: [],\n    modals: [],\n    inboxSelection: {},\n    selectInbox: (tenant, selection) => set((s) => ({ inboxSelection: { ...s.inboxSelection, [tenant]: selection } })),\n    harnessDrafts: {},\n    setHarnessDraft: (scope, text) => set((s) => ({ harnessDrafts: { ...s.harnessDrafts, [scope]: text } })),\n    harnessFresh: {},\n    setHarnessFresh: (scope, fresh) => set((s) => ({ harnessFresh: { ...s.harnessFresh, [scope]: fresh } })),\n    harnessUnsent: {},\n    keepHarnessUnsent: (scope, item) =>\n        set((s) => {\n            const kept = s.harnessUnsent[scope] ?? []\n            const record = { ...item, id: nextKept++ }\n            // An uncertain attempt is never removed or downgraded by a later one:\n            // only the core's word on its own send ID, or the operator, settles it.\n            // A not-sent record of the same text is superseded by a later attempt;\n            // not-sent records are kept once per text.\n            const others = kept.filter((k) => k.unconfirmed || k.text !== item.text)\n            return { harnessUnsent: { ...s.harnessUnsent, [scope]: [...others, record] } }\n        }),\n    dropHarnessUnsent: (scope, id) => set((s) => ({ harnessUnsent: { ...s.harnessUnsent, [scope]: (s.harnessUnsent[scope] ?? []).filter((k) => k.id !== id) } })),\n    harnessSent: {},\n    playground: null,\n    openPlayground: (target) => set((s) => ({ playground: { ...target, prefill: { ...target.prefill, nonce: (s.playground?.prefill.nonce ?? 0) + 1 } } })),\n    trackHarnessSend: (scope, sent) => set((s) => ({ harnessSent: { ...s.harnessSent, [scope]: [...(s.harnessSent[scope] ?? []), sent].slice(-64) } })),\n    untrackHarnessSend: (scope, submission) => set((s) => ({ harnessSent: { ...s.harnessSent, [scope]: (s.harnessSent[scope] ?? []).filter((t) => t.submission !== submission) } })),\n    arrival: null,\n    arrive: (target) => set((s) => ({ arrival: { ...target, sequence: (s.arrival?.sequence ?? 0) + 1 } })),\n    unconfirmed: [],\n    toastMs: 6000,\n    addUnconfirmed: (what, intent, context = deliveryContext(intent)) => {\n        const id = nextToast++\n        // A delivery bound to a context the shell no longer shows is moot: never surfaced (I2).\n        if (!unconfirmedInContext({ intent, context }, get().scope.context)) return id\n        const resolution = switchResolution(intent)\n        if (resolution && resolution.review !== get().scope.switchReview) return id\n        set((s) => ({ unconfirmed: [...s.unconfirmed, { id, what, intent, context }] }))\n        return id\n    },\n    scopeArrival: (tenant) => set((s) => (s.arrival && s.arrival.tenant !== tenant ? { arrival: null } : {})),\n    retireUnconfirmed: (context) => set((s) => ({ unconfirmed: s.unconfirmed.filter((u) => unconfirmedInContext(u, context)) })),\n    clearUnconfirmed: (id) => set((s) => ({ unconfirmed: s.unconfirmed.filter((u) => u.id !== id) })),\n    openPalette: () => set({ paletteOpen: true, switcherOpen: false }),\n    closePalette: () => set({ paletteOpen: false }),\n    setSwitcher: (open) => set({ switcherOpen: open, ...(open ? { paletteOpen: false } : {}) }),\n    toast: (text, kind = 'ok', undo, tenant = null, context = null) => {\n        const id = nextToast++\n        // A toast for a tenant or context the shell no longer shows is never surfaced (I2).\n        if (tenant !== null && tenant !== get().scope.tenant) return id\n        if (context !== null && context !== get().scope.context) return id\n        // One toast at a time: the newest replaces the rest (I10).\n        set({ toasts: [{ id, kind, text, undo, tenant, context }] })\n        return id\n    },\n    retireToasts: (tenant) => set((s) => ({ toasts: s.toasts.filter((t) => t.tenant === null || t.tenant === tenant) })),\n    dismissToast: (id) => set((s) => ({ toasts: s.toasts.filter((t) => t.id !== id) })),\n    pushModal: (id) => set((s) => ({ modals: s.modals.includes(id) ? s.modals : [...s.modals, id] })),\n    popModal: (id) => set((s) => ({ modals: s.modals.filter((m) => m !== id) })),\n}))\n\n/** Test seam: forget everything (each test starts from an empty store). */\nexport function resetShellStore() {\n    useShellStore.setState({ workbenchRecovery: initialWorkbenchRecovery(), scope: { tenant: null, context: null, switchReview: null }, paletteOpen: false, switcherOpen: false, adminNavOpen: true, toasts: [], modals: [], unconfirmed: [], toastMs: 6000, inboxSelection: {}, arrival: null, harnessDrafts: {}, harnessFresh: {}, harnessUnsent: {}, harnessSent: {}, playground: null })\n}\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_16","type":"command_execution","command":"/bin/zsh -lc \"sed -n '540,830p' apps/desktop/src/v2/workbench/api-client.tsx && cat apps/desktop/src/v2/workbench/response-pane.tsx\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_16","type":"command_execution","command":"/bin/zsh -lc \"sed -n '540,830p' apps/desktop/src/v2/workbench/api-client.tsx && cat apps/desktop/src/v2/workbench/response-pane.tsx\"","aggregated_output":"                                                        style={{\n                                                            width: 6,\n                                                            height: 6,\n                                                            background: 'var(--v2-acc)',\n                                                        }}\n                                                    />\n                                                ) : null}\n                                                {t.conflict || t.interrupted ? <Glyph name='alert' size={11} color='var(--v2-flag)' /> : null}\n                                            </button>\n                                            <button\n                                                type='button'\n                                                aria-label={C.closeTab(name)}\n                                                onClick={() => void close({ kind: 'tab', id: t.id, name })}\n                                                className='grid size-6 min-h-0 place-items-center rounded-[5px] text-[13px]'\n                                                style={{\n                                                    border: 0,\n                                                    background: 'transparent',\n                                                    ...faint,\n                                                }}\n                                            >\n                                                ×\n                                            </button>\n                                        </span>\n                                    )\n                                })}\n                            </div>\n                            {alerts !== null ? (\n                                <div className='flex flex-col empty:hidden' style={{ gap: 8, padding: '0 20px' }}>\n                                    {alerts}\n                                </div>\n                            ) : null}\n                            {loadFailure && doc?.id !== loadFailure.id ? (\n                                <div role='alert' className='flex flex-wrap items-center text-[13px]' style={{ gap: 10, margin: '16px 20px 0', padding: '12px 14px', borderRadius: 10, background: 'var(--v2-block-bg)' }} data-slot='workbench-load-failed'>\n                                    <span className='min-w-0 flex-grow'>{C.loadFailed(requestName(loadFailure.relative), loadFailure.text)}</span>\n                                    <Btn onClick={() => open({ id: loadFailure.id, relative: loadFailure.relative })}>{C.tryAgain}</Btn>\n                                </div>\n                            ) : null}\n                            {/* Scope ownership is checked in this commit, before passive effects clear the old document. */}\n                            {doc && docCollection.current === collectionId && selectedTab && doc.id === selectedTab.id ? (\n                                <RequestEditor\n                                    key={`${doc.id}:${doc.revision}:${doc.relative}:${docSeq}`}\n                                    initial={doc}\n                                    notes={notes}\n                                    call={call}\n                                    schemas={collection.schemas}\n                                    historyKey={`${collection.scope}:${state.running.length}`}\n                                    onStatusChange={(value) => {\n                                        if (statusOwner.current === editorOwner) setEditorStatus(value && editorOwner ? { owner: editorOwner, value } : null)\n                                    }}\n                                    onClosed={() => setDoc(null)}\n                                    register={(handle) => editors.current.set(doc.id, handle)}\n                                    context={snapshot.active?.context ?? null}\n                                    running={state.running.filter((r) => r.request === doc.id)}\n                                    review={state.review?.request === doc.id ? state.review : null}\n                                />\n                            ) : collection.tabs.length === 0 ? (\n                                <p className='text-[13px]' style={{ padding: '20px', ...soft }} data-slot='workbench-empty'>\n                                    {collection.requests.length === 0 ? C.noRequests : C.selectRequest}\n                                </p>\n                            ) : null}\n                            <div\n                                className='flex shrink-0 flex-wrap items-center text-[12px]'\n                                style={{\n                                    minHeight: 26,\n                                    gap: 14,\n                                    padding: '0 14px',\n                                    borderTop: '1px solid var(--v2-rule)',\n                                    background: 'var(--v2-side)',\n                                    ...faint,\n                                }}\n                                data-slot='api-footer'\n                            >\n                                <span className='flex items-center' style={{ gap: 5 }}>\n                                    <span\n                                        aria-hidden\n                                        className='rounded-full'\n                                        style={{\n                                            width: 6,\n                                            height: 6,\n                                            background: state.busy ? 'var(--v2-flag)' : 'var(--v2-ok)',\n                                        }}\n                                    />\n                                    {state.busy ? C.working : C.footer.ready}\n                                </span>\n                                {displayedStatus ? <span role='status' aria-live='polite' data-slot='workbench-save-status' data-state={displayedStatus.save.state}>{displayedStatus.save.text}</span> : null}\n                                {displayed ? <span role='status' aria-live='polite' className='flex min-w-0 flex-wrap items-center' style={{ gap: 8 }} data-slot='workbench-response-status' data-run={displayed.record.id} data-request={displayed.record.request}>\n                                    <span>{displayed.history ? 'History · ' : ''}{requestName(displayed.record.relative)} · {clockOf(displayed.record.at)}</span>\n                                    <span style={{ color: tone(displayed.record).fg }}>{tone(displayed.record).text}</span>\n                                    <span>{elapsedText(displayed.record.elapsedMs)}</span>\n                                    <span>{sizeText(displayed.record.bytes)}</span>\n                                </span> : null}\n                                <span className='ml-auto'>{C.footer.requests(collection.requests.length)}</span>\n                                {collection.archives ? <span>{C.footer.archives(collection.archives)}</span> : null}\n                            </div>\n                        </div>\n                    </div>\n                    {tool ? (\n                        <ToolsSheet\n                            tool={tool}\n                            state={state}\n                            collection={collection}\n                            run={run}\n                            onClose={() => setTool(null)}\n                            importCurl={async (text, relative) => {\n                                // A cURL import's draft is a load of this collection: begun before the call, settled against it.\n                                const load = beginLoad(null)\n                                const r = await run({ kind: 'importCurl', text, relative })\n                                settleLoad(load, r, true)\n                                return r\n                            }}\n                            onCreated={() => setTool(null)}\n                            returnFocus={chip.current}\n                        />\n                    ) : null}\n                </>\n            )}\n            {closing\n                ? createPortal(\n                      <Modal label={closing.kind === 'tab' ? C.closing.tab(closing.name) : C.closing.collection} width={480} onClose={() => setClosing(null)} data-slot='workbench-closing-dialog'>\n                          <div\n                              role='alertdialog'\n                              aria-label={closing.kind === 'tab' ? C.closing.tab(closing.name) : C.closing.collection}\n                              className='flex flex-col text-[13px]'\n                              style={{ gap: 12 }}\n                              data-slot='workbench-closing'\n                          >\n                              <h2 className='text-[17px] font-bold'>{closing.kind === 'tab' ? C.closing.tab(closing.name) : C.closing.collection}</h2>\n                              <p>{C.closing.text}</p>\n                              <div className='flex justify-end' style={{ gap: 8 }}>\n                                  <Btn onClick={() => setClosing(null)}>{C.closing.keep}</Btn>\n                                  <Btn tier='primary' onClick={() => void close(closing, true)}>\n                                      {C.closing.discard}\n                                  </Btn>\n                              </div>\n                          </div>\n                      </Modal>,\n                      document.body\n                  )\n                : null}\n        </section>\n    )\n}\n\n/** No collection open: open, create, the built-in, recents. */\nfunction Start({ state, run, message, offerNew, retry }: { state: WorkbenchState; run: Run; message: string; offerNew: boolean; retry?: () => Promise<void> }) {\n    return (\n        <div className='flex flex-col' style={{ gap: 14, maxWidth: 760 }} data-slot='workbench-start'>\n            <p className='text-[14px]'>{C.start.none}</p>\n            {message ? (\n                <div\n                    role='alert'\n                    className='flex flex-col rounded-[10px] text-[13px]'\n                    style={{\n                        gap: 8,\n                        padding: '12px 14px',\n                        background: 'var(--v2-flag-bg)',\n                    }}\n                    data-slot='workbench-message'\n                >\n                    <p>{message}</p>\n                    {retry ? <Btn tier='tertiary' className='self-start' onClick={() => void retry()}>{C.tryAgain}</Btn> : null}\n                    {offerNew ? (\n                        <Btn className='self-start' onClick={() => void run({ kind: 'createCollection' })}>\n                            {C.start.create}\n                        </Btn>\n                    ) : null}\n                </div>\n            ) : null}\n            <div className='flex flex-wrap' style={{ gap: 8 }}>\n                <Btn tier='primary' onClick={() => void run({ kind: 'openFolder' })}>\n                    {C.start.open}\n                </Btn>\n                <Btn onClick={() => void run({ kind: 'createCollection' })}>{C.start.create}</Btn>\n                <Btn onClick={() => void run({ kind: 'openBuiltIn' })}>{C.start.builtIn}</Btn>\n            </div>\n            <p className='text-[12px]' style={faint}>\n                {C.start.builtInNote}\n            </p>\n            {state.recent.length ? (\n                <section aria-label={C.start.recent} className='flex flex-col' style={{ gap: 6 }}>\n                    <h2 className='text-[15px] font-semibold'>Recent</h2>\n                    {state.recent.map((r) => (\n                        <Btn key={r.index} tier='tertiary' className='self-start' onClick={() => void run({ kind: 'openRecent', index: r.index })}>\n                            {`${r.name} (${r.folder})`}\n                        </Btn>\n                    ))}\n                </section>\n            ) : null}\n        </div>\n    )\n}\nimport { useEffect, useMemo, useRef, useState } from 'react'\nimport type { RunRecord, RunView, RunningView, SendReviewView } from '@prisma-airs/desktop-contracts'\nimport { type WorkbenchCall, resultText, runFailureText, runSummary, sizeText } from '../../modules/workbench/workbench-call'\nimport { clockOf } from '../copy'\nimport { Btn } from '../controls'\nimport { Glyph } from '../icons'\nimport { API_COPY as C } from './copy'\nimport { prettyJson } from './request-rows'\nimport { requestName } from './request-tree'\nimport { JsonText } from './json-presentation'\nimport type { DisplayedResponse } from './presentation-status'\n\ntype ResponseTab = 'body' | 'headers' | 'details' | 'history'\nconst TABS: ResponseTab[] = ['body', 'headers', 'details', 'history']\n\nconst faint = { color: 'var(--v2-faint)' }\nconst soft = { color: 'var(--v2-soft)' }\nconst MONO = \"ui-monospace, 'SF Mono', Menlo, monospace\"\nconst BOX = {\n    margin: '0 14px 12px',\n    border: '1px solid var(--v2-rule)',\n    borderRadius: 8,\n    background: 'var(--v2-paper)',\n}\n\n/** The status pill's tone: the code's class, a failure, or a run that never completed. */\nexport function tone(record: RunRecord): {\n    fg: string\n    bg: string\n    text: string\n    glyph: 'check' | 'alert' | 'ban' | 'x'\n} {\n    if (record.state === 'completed' && record.status !== null) {\n        const code = record.status\n        return code < 300\n            ? {\n                  fg: 'var(--v2-ok)',\n                  bg: 'var(--v2-ok-bg)',\n                  text: `${code} ${code === 200 ? 'OK' : ''}`.trim(),\n                  glyph: 'check',\n              }\n            : code < 500\n              ? {\n                    fg: 'var(--v2-flag)',\n                    bg: 'var(--v2-flag-bg)',\n                    text: String(code),\n                    glyph: 'alert',\n                }\n              : {\n                    fg: 'var(--v2-block)',\n                    bg: 'var(--v2-block-bg)',\n                    text: String(code),\n                    glyph: 'ban',\n                }\n    }\n    const text = record.state === 'interrupted' ? 'Interrupted' : record.state === 'cancelled' ? 'Cancelled' : record.state === 'running' ? 'Running' : 'Failed'\n    return { fg: 'var(--v2-block)', bg: 'var(--v2-block-bg)', text, glyph: 'x' }\n}\n\nexport function elapsedText(ms: number): string {\n    return ms < 1000 ? `${ms} ms` : `${(ms / 1000).toFixed(2)} s`\n}\n\ninterface Props {\n    /** The run Send produced for this request (null before the first send). */\n    run: RunView | null\n    running: RunningView[]\n    review: SendReviewView | null\n    call: WorkbenchCall\n    /** Changes when history may have changed (the collection, a send). */\n    historyKey: string\n    onApply: () => void\n    onDismiss: () => void\n    onDisplayed?: (response: DisplayedResponse | null) => void\n}\n\n/**\n * The response pane (R2App's right 40%): the status line, the Body,\n * Headers, Details and History tabs. A run shown from History is the\n * immutable record of what happened then; nothing here sends anything.\n */\nexport function ResponsePane({ run, running, review, call, historyKey, onApply, onDismiss, onDisplayed }: Props) {\n    const [tab, setTab] = useState<ResponseTab>('body')\n    const [pretty, setPretty] = useState(true)\n    const [fromHistory, setFromHistory] = useState<RunView | null>(null)\n    const [message, setMessage] = useState('')\n    // A new send shows its own run and returns to Body.\n    const runId = run?.record.id ?? null\n    useEffect(() => {\n        setFromHistory(null)\n        setMessage('')\n        if (runId) setTab('body')\n    }, [runId])\n    const shown = fromHistory ?? run\n    const record = shown?.record ?? null\n    const displayCallback = useRef(onDisplayed)\n    displayCallback.current = onDisplayed\n    useEffect(() => {\n        displayCallback.current?.(record ? { record, history: fromHistory !== null } : null)\n    }, [record, fromHistory])\n    const formatted = useMemo(() => shown?.preview != null ? prettyJson(shown.preview) : null, [shown?.preview])\n\n    const save = async () => {\n        if (!record) return\n        setMessage('')\n        const r = await call({ kind: 'saveResponse', run: record.id })\n        if (r.kind === 'responseSaved') setMessage(C.saved(sizeText(r.bytes), r.name))\n        else if (r.kind !== 'cancelled') setMessage(resultText(r) ?? '')\n    }\n    const copy = async () => {\n        if (shown?.preview == null) return\n        try {\n            await navigator.clipboard.writeText(shown.preview)\n            setMessage(C.copied)\n        } catch {\n            setMessage(C.copyFailed)\n        }\n    }\n\n    const first = running[0] ?? null\n    // Every transfer in flight is in view with its own Cancel, whatever response is being inspected (a run from\n    // History shown while a new send runs hid the progress and the cancellation behind the old record; the core\n    // runs several sends of one document at once, and only the first was shown).\n    const progress = running.map((r, i) => (\n        <span key={r.run} role='status' aria-live='polite' className='flex w-full flex-wrap items-center text-[12.5px]' style={{ gap: 8 }} data-slot='workbench-running'>\n            {C.sendingProgress(r.method, sizeText(r.bytes))}\n            <Btn className='h-7' aria-label={running.length > 1 ? `${C.cancel_} ${i + 1} of ${running.length}` : undefined} onClick={() => void call({ kind: 'cancel', run: r.run })}>\n                {C.cancel_}\n            </Btn>\n        </span>\n    ))\n    const head = record ? (\n        <>\n            {!onDisplayed ? <><span\n                className='inline-flex items-center rounded-[6px] font-bold'\n                style={{\n                    gap: 4,\n                    padding: '2px 9px',\n                    background: tone(record).bg,\n                    color: tone(record).fg,\n                }}\n                data-slot='response-status'\n            >\n                <Glyph name={tone(record).glyph} size={11} color={tone(record).fg} />\n                {tone(record).text}\n            </span>\n            <span style={soft}>{elapsedText(record.elapsedMs)}</span>\n            <span style={soft}>{sizeText(record.bytes)}</span></> : null}\n            <span className='ml-auto truncate text-[12px]' style={faint}>\n                {fromHistory ? `${requestName(record.relative)} · ${clockOf(record.at)}` : clockOf(record.at)}\n            </span>\n        </>\n    ) : first ? null : (\n        <span style={faint}>{C.noResponseYet}</span>\n    )\n\n    return (\n        <section\n            aria-label={C.pane}\n            data-slot='workbench-response-pane'\n            className='flex min-h-0 min-w-0 flex-col overflow-auto'\n            style={{ flex: '0 0 40%', minWidth: 'min(100%, 340px)', maxWidth: 440 }}\n        >\n            <div\n                className='flex flex-wrap items-center text-[13px]'\n                style={{\n                    gap: 10,\n                    minHeight: 48,\n                    padding: '9px 14px',\n                    borderBottom: '1px solid var(--v2-rule)',\n                }}\n                data-slot='response-head'\n            >\n                {progress}\n                {head}\n            </div>\n            {review ? (\n                <div\n                    role='alert'\n                    className='flex flex-col rounded-[10px] text-[13px]'\n                    style={{\n                        gap: 8,\n                        margin: '12px 14px 0',\n                        padding: '12px 14px',\n                        background: 'var(--v2-flag-bg)',\n                    }}\n                    data-slot='workbench-review'\n                >\n                    <p className='font-semibold'>{C.review.title(review.operation)}</p>\n                    <p className='break-all font-mono text-[12px]'>{`${review.method} ${review.url}`}</p>\n                    <p>{C.review.goes(review.destination)}</p>\n                    {review.headers.length ? (\n                        <ul className='font-mono text-[12px]'>\n                            {review.headers.map(([n, v], i) => (\n                                <li key={i} className='break-all'>{`${n}: ${v}`}</li>\n                            ))}\n                        </ul>\n                    ) : null}\n                    {review.body ? (\n                        <pre className='max-h-48 overflow-auto rounded-[8px] p-2 font-mono text-[12px] whitespace-pre-wrap' style={{ background: 'var(--v2-paper)' }}>\n                            {review.body}\n                        </pre>\n                    ) : null}\n                    {review.files.length ? <p>{C.review.files(review.files.join(', '))}</p> : null}\n                    <p className='text-[12px]' style={faint}>\n                        {C.review.expires(new Date(review.expires * 1000).toLocaleTimeString())}\n                    </p>\n                    <div className='flex flex-wrap' style={{ gap: 8 }}>\n                        <Btn tier='primary' onClick={onApply}>\n                            {C.review.apply}\n                        </Btn>\n                        <Btn onClick={onDismiss}>{C.review.dismiss}</Btn>\n                    </div>\n                </div>\n            ) : null}\n            <div\n                role='tablist'\n                aria-label={`${C.response} views`}\n                className='flex flex-wrap'\n                style={{\n                    gap: 2,\n                    padding: '0 10px',\n                    borderBottom: '1px solid var(--v2-rule)',\n                }}\n            >\n                {TABS.map((t) => (\n                    <button\n                        key={t}\n                        type='button'\n                        role='tab'\n                        aria-selected={tab === t}\n                        aria-controls={`response-panel-${t}`}\n                        onClick={() => setTab(t)}\n                        className='min-h-0 text-[12.5px] font-semibold'\n                        style={{\n                            height: 38,\n                            padding: '0 10px',\n                            border: 0,\n                            borderBottom: `2px solid ${tab === t ? 'var(--v2-acc)' : 'transparent'}`,\n                            background: 'transparent',\n                            color: tab === t ? 'var(--v2-ink)' : 'var(--v2-soft)',\n                        }}\n                    >\n                        {C.responseTabs[t]}\n                        {t === 'headers' && record?.headers.length ? (\n                            <span className='font-normal' style={{ fontSize: 12, ...faint }}>\n                                {' '}\n                                {record.headers.length}\n                            </span>\n                        ) : null}\n                    </button>\n                ))}\n            </div>\n            <div role='tabpanel' id={`response-panel-${tab}`} className='flex min-h-0 flex-grow flex-col'>\n                {tab === 'history' ? (\n                    <History\n                        call={call}\n                        revision={historyKey}\n                        onShow={(view) => {\n                            setFromHistory(view)\n                            setTab('body')\n                        }}\n                    />\n                ) : !shown || !record ? (\n                    <p className='text-[13px]' style={{ margin: '20px 14px', ...faint }} data-slot='workbench-no-response'>\n                        {C.noResponse}\n                    </p>\n                ) : (\n                    <section aria-label={C.response} data-slot='workbench-response' className='flex min-h-0 flex-grow flex-col text-[13px]'>\n                        <p className='sr-only' data-slot='workbench-run-summary'>\n                            {runSummary(record)}\n                        </p>\n                        {record.failure ? (\n                            <p role='alert' style={{ margin: '12px 14px 0' }}>\n                                {runFailureText(record.failure)}\n                            </p>\n                        ) : null}\n                        {record.uncertain ? (\n                            <p\n                                role='alert'\n                                className='rounded-[8px]'\n                                style={{\n                                    margin: '12px 14px 0',\n                                    padding: '10px 12px',\n                                    background: 'var(--v2-flag-bg)',\n                                }}\n                            >\n                                {C.uncertain}\n                            </p>\n                        ) : null}\n                        {record.redirect ? <p style={{ margin: '12px 14px 0' }}>{C.redirect(record.redirect)}</p> : null}\n                        {shown.tokenDropped ? <p style={{ margin: '12px 14px 0' }}>{C.tokenDropped}</p> : null}\n                        {tab === 'body' ? (\n                            <>\n                                <div className='flex flex-wrap items-center' style={{ gap: 10, padding: '12px 18px' }}>\n                                    <span className='text-[12px]' style={faint}>\n                                        {formatted !== null ? 'JSON' : shown.preview === null ? '' : 'Text'}\n                                    </span>\n                                    <span className='flex rounded-[7px] text-[12px]' style={{ padding: 2, background: 'var(--v2-inset)' }} role='group' aria-label='Body format'>\n                                        {(['pretty', 'raw'] as const).map((f) => (\n                                            <button\n                                                key={f}\n                                                type='button'\n                                                aria-pressed={pretty === (f === 'pretty')}\n                                                onClick={() => setPretty(f === 'pretty')}\n                                                className='min-h-0 rounded-[5px] font-semibold'\n                                                style={{\n                                                    padding: '2px 9px',\n                                                    border: 0,\n                                                    background: pretty === (f === 'pretty') ? 'var(--v2-paper)' : 'transparent',\n                                                    color: 'var(--v2-ink)',\n                                                }}\n                                            >\n                                                {f === 'pretty' ? C.pretty : C.raw}\n                                            </button>\n                                        ))}\n                                    </span>\n                                    <span className='ml-auto flex items-center' style={{ gap: 6 }}>\n                                        <Btn className='h-7' disabled={shown.preview == null} onClick={() => void copy()}>\n                                            {C.copy}\n                                        </Btn>\n                                        <Btn className='h-7' disabled={!record.stored} onClick={() => void save()}>\n                                            {C.saveResponse}\n                                        </Btn>\n                                    </span>\n                                </div>\n                                {shown.preview !== null && shown.preview !== '' ? (\n                                    pretty && formatted !== null ? (\n                                        <pre\n                                            role='region'\n                                            aria-label={C.responseBody}\n                                            data-slot='json-lines'\n                                            className='min-h-0 flex-grow overflow-auto text-[12px] leading-[1.75]'\n                                            style={{\n                                                ...BOX,\n                                                padding: '10px 0',\n                                                fontFamily: MONO,\n                                                color: 'var(--v2-ink)',\n                                            }}\n                                        >\n                                            <JsonText text={formatted} numbered />\n                                        </pre>\n                                    ) : (\n                                        <pre\n                                            role='region'\n                                            aria-label={C.responseBody}\n                                            className='min-h-0 flex-grow overflow-auto text-[12px] leading-[1.6] break-all whitespace-pre-wrap'\n                                            style={{\n                                                ...BOX,\n                                                padding: 12,\n                                                fontFamily: MONO,\n                                                color: 'var(--v2-ink)',\n                                            }}\n                                        >\n                                            {shown.preview}\n                                        </pre>\n                                    )\n                                ) : (\n                                    <p style={{ margin: '0 14px 12px', ...faint }}>{shown.preview === null && record.bytes > 0 ? C.notText : C.noBody}</p>\n                                )}\n                                {record.bytes > shown.previewBytes && shown.preview !== null ? (\n                                    <p className='text-[12px]' style={{ margin: '0 14px 12px', ...faint }}>\n                                        {C.firstBytes(sizeText(shown.previewBytes))}\n                                    </p>\n                                ) : null}\n                            </>\n                        ) : tab === 'headers' ? (\n                            record.headers.length ? (\n                                <div role='table' aria-label={C.responseHeaders} className='overflow-hidden text-[12px]' style={{ ...BOX, margin: '12px 14px', fontFamily: MONO }}>\n                                    {record.headers.map(([n, v], i) => (\n                                        <div\n                                            key={i}\n                                            role='row'\n                                            className='grid'\n                                            style={{\n                                                gridTemplateColumns: '1fr 1.6fr',\n                                                borderTop: i ? '1px solid var(--v2-rule)' : 0,\n                                            }}\n                                        >\n                                            <span role='cell' className='break-all' style={{ padding: '8px 10px', ...soft }}>\n                                                {n}\n                                            </span>\n                                            <span\n                                                role='cell'\n                                                className='break-all'\n   