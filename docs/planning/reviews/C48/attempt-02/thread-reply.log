 { name: 'History' }))\n293:    it('cannot replace the current collection footer with a previous collection send result sharing its request id', async () => {\n309:        await waitFor(() => expect(within(line()).getByRole('textbox', { name: 'URL' })).toHaveValue('https://other.invalid/current'))\n318:    it('shows the displayed response metrics in the footer, including another request selected from history', async () => {\n321:        const footer = document_().querySelector('[data-slot=\"api-footer\"]') as HTMLElement\n323:        await waitFor(() => expect(footer).toHaveTextContent('42 ms'))\n324:        expect(footer).toHaveTextContent('29 B')\n325:        expect(footer).toHaveTextContent('2 requests')\n328:        await user.click(within(pane).getByRole('tab', { name: 'History' }))\n330:        await waitFor(() => expect(footer).toHaveTextContent('17 ms'))\n331:        expect(footer).toHaveTextContent('20 B')\n332:        expect(footer).toHaveTextContent('health')\n333:        expect(footer).toHaveTextContent('History')\n334:        expect(footer).not.toHaveTextContent('42 ms')\n345:    it('offers explicit restore recovery without automatically opening SCM or creating a missing collection', async () => {\n364:    it.each(['missing', 'notCollection'] as const)('keeps %s preferred-folder recovery across Home and back until an explicit retry succeeds', async (detail) => {\n368:        let restored = false\n369:        let cancelled = false\n371:            ? cancelled ? { kind: 'cancelled' } : restored ? { kind: 'opened', name: 'AIRS' } : { kind: 'refused', problem: { kind: 'project', detail } }\n389:        // A failed alternative is not a successful choice and must not dismiss recovery.\n397:        cancelled = true\n401:        cancelled = false\n402:        restored = true\n438:    it('settles an in-flight restore after remount without duplicate loads and ignores its reply after context retirement', async () => {\n472:    it('draws the title row with the chips, the tree, the tabs, the request line, the sub-tabs, the response pane and the footer (V2-T14)', async () => {\n495:        expect(within(line()).getByRole('textbox', { name: 'URL' })).toHaveValue('http://127.0.0.1:8080/topics')\n498:        expect(document_().querySelector('[data-slot=\"api-footer\"] [data-slot=\"workbench-save-status\"]')).toHaveTextContent('Saved')\n513:        ).toEqual(['Body', 'Headers', 'Details', 'History'])\n514:        expect(document_().querySelector('[data-slot=\"api-footer\"]')).toHaveTextContent('ReadySaved2 requests2 earlier versions kept privately')\n597:        expect(within(headers).getByRole('textbox', { name: 'Value 1' })).toHaveValue('application/json')\n602:            fields: { query: 'q=  padded  \\nnote=hello world', headers: 'Accept: application/json\\nX-Note: hello world' },\n607:            fields: { query: 'q=  padded  \\nnote=hello world', headers: 'Accept: application/json\\nX-Note: hello world' },\n611:        expect(screen.getByRole('textbox', { name: /^Headers/ })).toHaveValue('Accept: application/json\\nX-Note: hello world')\n614:    it('shows the response under Body (pretty, then Raw), Headers, Details and History, where an older run is shown as recorded (I5)', async () => {\n621:        await user.type(within(line()).getByRole('textbox', { name: 'URL' }), '?x=1')\n624:        await user.clear(within(line()).getByRole('textbox', { name: 'URL' }))\n625:        await user.type(within(line()).getByRole('textbox', { name: 'URL' }), 'http://127.0.0.1:8080/topics')\n639:        expect(headers).toHaveTextContent('content-typeapplication/json')\n644:        await user.click(within(pane).getByRole('tab', { name: 'History' }))\n645:        const history = within(pane).getByRole('region', { name: 'History' })\n663:    it('keeps a transfer in flight, with Cancel request, in view while an older run from History is being inspected; Cancel dispatches the active run once, history stays as recorded, nothing is resent (attempt-03