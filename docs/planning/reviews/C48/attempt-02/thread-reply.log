{"type":"item.completed","item":{"id":"item_31","type":"command_execution","command":"/bin/zsh -lc \"sed -n '145,275p' crates/desktop-core/tests/workbench_documents/main.rs && sed -n '580,662p' crates/desktop-core/tests/workbench_execution/main.rs && rg -n 'def |ime|selection|footer|status|cancel|save_response|picker|cursor|json' tools/native-acceptance/acceptance_p11_api.py\"","aggregated_output":"fn with(doc: &Value, key: &str, value: &str) -> Value {\n    let mut f = fields(doc);\n    f[key] = json!(value);\n    f\n}\n\n#[tokio::test(flavor = \"multi_thread\")]\nasync fn refinement_startup_defaults_once_and_remembers_an_explicit_close() {\n    let mut desk = desk().await;\n    let first = desk.wb(json!({\"kind\": \"load\"})).await;\n    assert_eq!(first[\"kind\"], \"opened\", \"{first}\");\n    assert_eq!(desk.workbench()[\"collection\"][\"builtIn\"], true);\n    assert_eq!(\n        desk.workbench()[\"collection\"][\"requests\"]\n            .as_array()\n            .expect(\"requests\")\n            .len(),\n        193\n    );\n    assert_eq!(desk.wb(json!({\"kind\": \"load\"})).await[\"kind\"], \"done\");\n    assert_eq!(\n        desk.wb(json!({\"kind\": \"closeCollection\", \"discard\": false}))\n            .await[\"kind\"],\n        \"done\"\n    );\n    assert!(desk.workbench()[\"collection\"].is_null());\n    assert_eq!(desk.wb(json!({\"kind\": \"load\"})).await[\"kind\"], \"done\");\n    assert!(desk.workbench()[\"collection\"].is_null());\n    let handles = desk.adapters;\n    drop(desk.core);\n    let mut again = start(Some(&handles), CoreConfig::default()).await;\n    assert_eq!(again.wb(json!({\"kind\": \"load\"})).await[\"kind\"], \"done\");\n    assert!(\n        again.workbench()[\"collection\"].is_null(),\n        \"explicit close survives restart\"\n    );\n}\n\n#[tokio::test(flavor = \"multi_thread\")]\nasync fn refinement_startup_restores_custom_choice_and_does_not_replace_missing_or_changed_folders()\n{\n    let root = collection();\n    let mut desk = desk().await;\n    desk.open(&root).await;\n    let handles = desk.adapters;\n    drop(desk.core);\n    let mut again = start(Some(&handles), CoreConfig::default()).await;\n    let result = again.wb(json!({\"kind\": \"load\"})).await;\n    assert_eq!(result[\"kind\"], \"opened\", \"{result}\");\n    assert_eq!(again.workbench()[\"collection\"][\"id\"], \"c14\");\n    drop(again.core);\n    let moved = root.with_file_name(\"moved-api\");\n    std::fs::rename(&root, &moved).expect(\"move owned collection\");\n    let mut missing = start(Some(&handles), CoreConfig::default()).await;\n    assert_eq!(missing.wb(json!({\"kind\": \"load\"})).await[\"kind\"], \"refused\");\n    assert!(missing.workbench()[\"collection\"].is_null());\n    assert!(\n        !root.exists(),\n        \"startup must not recreate the missing folder\"\n    );\n    std::fs::rename(&moved, &root).expect(\"restore owned collection\");\n    assert_eq!(\n        missing.wb(json!({\"kind\": \"load\"})).await[\"kind\"],\n        \"opened\",\n        \"explicit Retry can restore the remembered choice\"\n    );\n    drop(missing.core);\n    let metadata = root.join(\"collection.toml\");\n    let original = std::fs::read_to_string(&metadata).expect(\"metadata\");\n    std::fs::write(\n        &metadata,\n        original.replace(\"id = \\\"c14\\\"\", \"id = \\\"replacement\\\"\"),\n    )\n    .expect(\"replace collection identity\");\n    let mut changed = start(Some(&handles), CoreConfig::default()).await;\n    assert_eq!(changed.wb(json!({\"kind\": \"load\"})).await[\"kind\"], \"refused\");\n    assert!(\n        changed.workbench()[\"collection\"].is_null(),\n        \"never silently open another collection at the old path\"\n    );\n    let profile = desktop_core::workbench::profile::load_profile(\n        &handles.workbench_root,\n        handles.vault.as_ref(),\n    )\n    .expect(\"private profile\");\n    assert!(\n        serde_json::to_value(profile)\n            .expect(\"profile\")\n            .to_string()\n            .contains(\"c14\"),\n        \"keep the remembered preference for recovery\"\n    );\n}\n\n#[tokio::test(flavor = \"multi_thread\")]\nasync fn refinement_startup_rejects_a_redirected_custom_root_even_with_the_same_collection_id() {\n    let root = collection();\n    let mut desk = desk().await;\n    desk.open(&root).await;\n    let handles = desk.adapters;\n    drop(desk.core);\n    let moved = root.with_file_name(\"redirected-api\");\n    std::fs::rename(&root, &moved).expect(\"move owned collection\");\n    std::os::unix::fs::symlink(&moved, &root).expect(\"redirect the remembered path\");\n    let before = project_bytes(&moved);\n    let mut again = start(Some(&handles), CoreConfig::default()).await;\n    let restored = again.wb(json!({\"kind\": \"load\"})).await;\n    assert_eq!(\n        restored[\"kind\"], \"refused\",\n        \"a copied or redirected folder can retain its collection id: {restored}\"\n    );\n    assert!(again.workbench()[\"collection\"].is_null());\n    assert_eq!(project_bytes(&moved), before);\n}\n\n#[tokio::test(flavor = \"multi_thread\")]\nasync fn saves_a_fresh_snapshot_keeping_the_files_layout_and_revisions() {\n    let root = collection();\n    let mut desk = desk().await;\n    assert_eq!(\n        desk.open(&root).await,\n        json!({\"kind\": \"opened\", \"name\": \"Items API\"})\n    );\n    let wb = desk.workbench();\n    assert_eq!(\n        wb[\"collection\"][\"requests\"][0][\"relative\"],\n        \"items/list.request.toml\"\n    );\n    assert_eq!(wb[\"collection\"][\"complete\"], true);\n    let doc = desk.request(\"items/list.request.toml\").await;\n    assert_eq!(doc[\"fields\"][\"headers\"], \"Accept: application/json\");\n        assert_eq!(\n            desk.wb(json!({\"kind\": \"cancel\", \"run\": run[\"run\"]})).await[\"kind\"],\n            \"done\"\n        );\n    }\n    for op in operations {\n        let r = desk.wait(op).await;\n        assert_eq!(r[\"run\"][\"record\"][\"state\"], \"cancelled\", \"{r}\");\n        assert_eq!(r[\"run\"][\"record\"][\"uncertain\"], true);\n    }\n    assert_eq!(http.seen().len(), 5);\n}\n\n#[tokio::test(flavor = \"multi_thread\")]\nasync fn refinement_response_suggestions_normalize_whitespace_without_renaming_the_chosen_destination()\n {\n    const BODY: &str = \"{\\\"integer\\\":9007199254740993,\\\"escaped\\\":\\\"\\\\u0061\\\"}\\r\\n\";\n    let http = Http::start(Arc::new(|_| Answer::ok(BODY))).await;\n    let root = collection(\n        &format!(\"base = \\\"{}\\\"\\n\", http.origin()),\n        &[(\n            \"My  request.request.toml\",\n            &request(\"response-name\", \"GET\", \"{{base}}/probe\", \"\"),\n        )],\n    );\n    let mut desk = desk().await;\n    desk.open(&root).await;\n    let r = desk.send_doc(\"My  request.request.toml\").await;\n    let run = r[\"run\"][\"record\"][\"id\"].clone();\n    let folder = temp(\"response name with spaces\");\n    let chosen = folder.join(\"My explicitly chosen name.json\");\n    desk.adapters.folders.reply_save(Some(chosen.clone()));\n    let saved = desk.wb(json!({\"kind\": \"saveResponse\", \"run\": run})).await;\n    assert_eq!(\n        desk.adapters.folders.suggested(),\n        [\"My-request-response.json\"]\n    );\n    assert_eq!(\n        saved,\n        json!({\"kind\": \"responseSaved\", \"bytes\": BODY.len(), \"name\": \"My explicitly chosen name.json\"})\n    );\n    assert_eq!(\n        std::fs::read(&chosen).expect(\"exact exported bytes\"),\n        BODY.as_bytes()\n    );\n}\n\n#[tokio::test(flavor = \"multi_thread\")]\nasync fn large_responses_stream_to_sealed_storage_and_save_exactly() {\n    const LEN: u64 = 20 * 1024 * 1024 + 7;\n    let http = Http::start(Arc::new(|_| Answer::Stream { len: LEN })).await;\n    let root = collection(\n        &format!(\"base = \\\"{}\\\"\\n\", http.origin()),\n        &[(\n            \"big.request.toml\",\n            &request(\"big\", \"GET\", \"{{base}}/big\", \"\"),\n        )],\n    );\n    let mut desk = desk().await;\n    desk.open(&root).await;\n    let r = desk.send_doc(\"big.request.toml\").await;\n    let record = &r[\"run\"][\"record\"];\n    assert_eq!(record[\"bytes\"], LEN, \"{record}\");\n    assert_eq!(record[\"stored\"], true);\n    assert_eq!(r[\"run\"][\"previewBytes\"], 256 * 1024);\n    assert!(\n        r[\"run\"][\"preview\"].is_null(),\n        \"binary bodies are not shown as text\"\n    );\n    let run = record[\"id\"].as_str().expect(\"id\").to_owned();\n    // Stored sealed: the pattern never appears on disk in the clear.\n    let sample: Vec<u8> = (0..4096u64).map(server::pattern).collect();\n    for f in files(&desk.adapters.workbench_root) {\n        assert!(\n            !contains(&std::fs::read(&f).expect(\"read\"), &sample),\n            \"{}\",\n            f.display()\n        );\n    }\n    // Saved exactly; never into the repository's .git or over a folder.\n    let out = temp(\"save\").join(\"big.bin\");\n    desk.adapters.folders.reply_save(Some(out.clone()));\n    let saved = desk.wb(json!({\"kind\": \"saveResponse\", \"run\": run})).await;\n3:No work runs at import time. All requests target this module's owned\n8:or third-party input-method qualification is claimed.\n12:import json\n17:import time\n36:    \"not_claimed_by_native\": [\n40:        \"AX selection offsets or general third-party input-method qualification\",\n41:        \"visual token, selection, caret or scrolling correctness without root capture review\",\n61:    def __init__(self):\n68:            def log_message(self, *_args):\n71:            def handle_request(self):\n88:                status = 201 if path == \"/fast\" else 200\n93:                    self.send_response(status)\n94:                    self.send_header(\"content-type\", \"application/json\")\n100:                    pass  # Retired/cancelled clients are expected in N02.\n113:    def requests(self, path=None):\n117:    def hold(self, path):\n121:    def release(self, path):\n125:    def stop(self):\n131:        self.thread.join(timeout=3)\n134:def _press(ctx, label):\n141:def _input(ctx, label):\n149:def _focus(ctx, label):\n157:def _clipboard_write(text):\n161:def _paste(ctx, label, text):\n169:def _copy_matches(ctx, expected):\n178:def _status_regions(tree):\n194:def _metrics(ctx, name, code, history=False):\n195:    def matches(tree):\n196:        for node, text in _status_regions(tree):\n207:    ctx.require(found, \"C48 displayed-response footer does not name the expected record\")\n211:def _workbench_count(data):\n215:    for name in (\"diagnostics.jsonl\", \"diagnostics.1.jsonl\"):\n220:            raise RuntimeError(\"C48 fixture diagnostics are not bounded regular files\")\n222:            event = json.loads(line).get(\"event\", {})\n227:def _quiet_count(ctx, data):\n228:    last, stable = None, time.monotonic()\n229:    deadline = time.monotonic() + 8\n230:    while time.monotonic() < deadline:\n233:            last, stable = count, time.monotonic()\n234:        elif time.monotonic() - stable >= 0.8:\n236:        time.sleep(0.1)\n237:    raise RuntimeError(\"C48 workbench did not become quiescent before Save\")\n240:def _save_once(ctx, data):\n243:    tree, saved = ctx.app.wait_for(lambda t: any(text.strip() == \"Saved\" for _n, text in _status_regions(t)), 12)\n248:def _request(root, filename, identity, method, url, body=False):\n249:    text = 'format_version = 1\\nid = %s\\nmethod = %s\\nurl = %s\\n' % (json.dumps(identity), json.dumps(method), json.dumps(url))\n251:        text += 'body = \"owned-body.json\"\\nbody_kind = \"json\"\\n'\n255:def _stage(root, origin, replacement=False):\n258:    (root / \"collection.toml\").write_text('format_version = 1\\nid = %s\\nname = %s\\n\\n[variables]\\nbase = %s\\ntag = \"owned\"\\n' % (json.dumps(COLLECTION_ID), json.dumps(name), json.dumps(origin)))\n262:    (root / \"owned-body.json\").write_text(BODY)\n263:    _request(root, MAIN, \"owned-main\", \"POST\", \"{{base}}/jso