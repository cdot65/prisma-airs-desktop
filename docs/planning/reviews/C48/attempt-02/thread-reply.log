{"type":"item.completed","item":{"id":"item_45","type":"command_execution","command":"/bin/zsh -lc \"git diff f1e58da5 -- apps/desktop/package.json NOTICE && sed -n '1,155p' crates/desktop-core/src/authority/workbench_domain/send.rs && sed -n '1680,1697p' crates/desktop-core/src/authority/workbench_domain/send.rs && sed -n '540,566p' apps/desktop/src/v2/v2-shell.tsx && cat docs/planning/evidence/P11/qualification-final-03/impact/test-C48-host-1.json | head -20 && sed -n '35,62p' tools/p09/phase_inputs.py\"","aggregated_output":"diff --git a/apps/desktop/package.json b/apps/desktop/package.json\nindex 291da68c..027e566e 100644\n--- a/apps/desktop/package.json\n+++ b/apps/desktop/package.json\n@@ -14,6 +14,7 @@\n     \"@ai-security-academy/presentation\": \"file:../../.work/academy/packages/presentation\",\n     \"@ai-security-academy/shared\": \"file:../../.work/academy/packages/shared\",\n     \"@codemirror/commands\": \"6.10.4\",\n+    \"@codemirror/lang-json\": \"6.0.2\",\n     \"@codemirror/lang-python\": \"6.2.1\",\n     \"@codemirror/lang-yaml\": \"6.1.3\",\n     \"@codemirror/language\": \"6.12.4\",\n//! API Client Send (C15, ADR 0004). A Send carries the editor's fresh\n//! snapshot; Rust renders it against the current environment layers,\n//! admits it natively before any secret is read, and builds and sends the\n//! actual request itself. Known tenant-credential changes stop at an exact\n//! review: Apply re-renders the same snapshot against the current files,\n//! must reproduce the reviewed digest, takes the operator's native\n//! confirmation, consumes the review and sends once. A review is bound to\n//! the credentials actually sent too: the authentication (username and\n//! secret references), each workbench secret's generation (replacing one\n//! starts a new generation) and the Cookie header the jar gives the\n//! request; any change needs a fresh review, and the request carries that\n//! admitted Cookie header rather than reading the jar again. Transfers run off the\n//! workbench lane (at most four at a time, each cancellable); their results\n//! go to history and nothing is ever sent again by itself.\n\nuse std::collections::{BTreeMap, BTreeSet};\nuse std::future::Future;\nuse std::path::{Path, PathBuf};\nuse std::pin::Pin;\nuse std::sync::atomic::{AtomicU64, Ordering};\nuse std::sync::{Arc, Mutex};\nuse std::time::Instant;\n\nuse serde::Serialize;\nuse sha2::{Digest, Sha256};\nuse tokio_util::sync::CancellationToken;\nuse ts_rs::TS;\nuse zeroize::Zeroizing;\n\nuse super::super::{ConfirmationRequest, Inner, ScanCapability, State, lock};\nuse super::{\n    WorkbenchProblem, WorkbenchRequest, WorkbenchResult, blocking, current, ensure_profile,\n    refused, with_open,\n};\nuse crate::context::{ContextRef, ReviewId};\nuse crate::tenants::Region;\nuse crate::vault::{RecordId, StorageMode, Vault, VaultError};\nuse crate::workbench::admission::{\n    self, Admitted, CredentialClass, Destinations, Network, OriginClass, Registered, SecretFailure,\n    SendRefusal,\n};\nuse crate::workbench::cookies::Jar;\nuse crate::workbench::document::Fields;\nuse crate::workbench::environments::{self, Layers};\nuse crate::workbench::execute::{self, Tokens, Transfer};\nuse crate::workbench::history::{self, BodyWriter, ExportFailure, RunRecord, RunState};\nuse crate::workbench::profile;\nuse crate::workbench::project;\nuse crate::workbench::render::{self, Body, PartValue, Plan, Secrets};\n\n/// Requests running at once (v1: 4).\npub const MAX_ACTIVE: usize = 4;\nconst REVIEW_BODY: usize = 4 * 1024;\n\n/// A finished (or shown) run.\n#[derive(Clone, Debug, PartialEq, Eq, Serialize, TS)]\n#[serde(rename_all = \"camelCase\")]\npub struct RunView {\n    pub record: RunRecord,\n    /// The body's first 256 KiB as text, when it is text.\n    pub preview: Option<String>,\n    pub preview_bytes: u32,\n    /// A 401 dropped the minted token: Send again for a new one.\n    pub token_dropped: bool,\n}\n\n/// A request in flight.\n#[derive(Clone, Debug, PartialEq, Eq, Serialize, TS)]\n#[serde(rename_all = \"camelCase\")]\npub struct RunningView {\n    pub run: String,\n    pub request: String,\n    pub method: String,\n    /// Bytes sent and received so far.\n    #[ts(type = \"number\")]\n    pub bytes: u64,\n}\n\n/// A tenant-credential change awaiting the operator (secrets masked).\n#[derive(Clone, Debug, PartialEq, Eq, Serialize, TS)]\n#[serde(rename_all = \"camelCase\")]\npub struct SendReviewView {\n    pub review: ReviewId,\n    pub request: String,\n    /// The catalogue operation.\n    pub operation: String,\n    pub method: String,\n    pub url: String,\n    pub headers: Vec<(String, String)>,\n    pub body: String,\n    #[ts(type = \"number\")]\n    pub body_bytes: u64,\n    /// Collection files the body sends (bound by their content).\n    pub files: Vec<String>,\n    /// The origin it goes to.\n    pub destination: String,\n    /// Seconds since the Unix epoch after which it cannot be applied.\n    #[ts(type = \"number\")]\n    pub expires: u64,\n}\n\nstruct Active {\n    cancel: CancellationToken,\n    progress: Arc<AtomicU64>,\n    request: String,\n    method: String,\n}\n\n/// The review owns every native presentation registered for it. Dropping it\n/// revokes queued callbacks before dismissing any already shown sheet.\nstruct ReviewPresentation {\n    owner: crate::presentation::PresentationOwner,\n    confirmer: Arc<dyn super::super::OperatorConfirmation>,\n    nonces: BTreeSet<u64>,\n}\nimpl Drop for ReviewPresentation {\n    fn drop(&mut self) {\n        self.owner.revoke();\n        for nonce in &self.nonces {\n            self.confirmer.dismiss(*nonce);\n        }\n    }\n}\n\nstruct Pending {\n    view: SendReviewView,\n    digest: String,\n    context: Option<ContextRef>,\n    created: Instant,\n    presented_in: Option<ContextRef>,\n    presentation: ReviewPresentation,\n}\n\n/// Send state held by the workbench.\n#[derive(Default)]\npub(in crate::authority) struct Sending {\n    runs: BTreeMap<String, Active>,\n    review: Option<Pending>,\n    consumed: Vec<ReviewId>,\n    tokens: Arc<Tokens>,\n    jars: BTreeMap<String, Arc<Mutex<Jar>>>,\n    /// Each collection's history once read this session.\n    histories: BTreeMap<String, Vec<RunRecord>>,\n    /// Workbench secrets replaced this session (by collection and\n    /// reference) and the generation each was replaced in.\n    secret_generations: BTreeMap<(String, String), u64>,\n    generation: u64,\n    /// Advanced by every reset: work planned in an earlier epoch was\n    /// retired and neither stores nor publishes anything.\n    epoch: u64,\n    /// Separate from the reset epoch: page retirement must not cancel or\n    /// discard outcomes of requests already dispatched.\n    page: crate::presentation::PresentationOwner,\n    /// Held shared by each private-storage step of a send and exclusively\n    /// by reset from before its purge to its end.\n        .next()\n        .unwrap_or(\"response\")\n        .trim_end_matches(\".request.toml\");\n    let name = name.split_whitespace().collect::<Vec<_>>().join(\"-\");\n    let json = record.headers.iter().any(|(n, v)| {\n        n.eq_ignore_ascii_case(\"content-type\") && v.to_ascii_lowercase().contains(\"json\")\n    });\n    let suggested = format!(\"{name}-response.{}\", if json { \"json\" } else { \"txt\" });\n    let Some(destination) = inner.adapters.folders.choose_save(suggested).await else {\n        return WorkbenchResult::Cancelled;\n    };\n    let name = destination\n        .file_name()\n        .map(|n| n.to_string_lossy().into_owned())\n        .unwrap_or_default();\n    let keychain = Arc::clone(&inner.adapters.keychain);\n    let private = root.to_path_buf();\n    let written = blocking(Err(ExportFailure::Io), move || {\n                                onNavigate={props.onNavigate}\n                                arrival={arrival && arrival.tenant === tenantNow && arrival.feature === 'administration' ? arrival : null}\n                            />\n                        ) : feature.id === 'harness' && feature.availability.state === 'available' ? (\n                            <Harness\n                                key={snapshot.active?.context ?? 'none'}\n\n                                snapshot={snapshot}\n                                dispatch={props.dispatch}\n                                onNavigate={props.onNavigate}\n                                arrival={arrival && arrival.tenant === tenantNow && arrival.feature === 'harness' ? arrival : null}\n                            />\n                        ) : feature.id === 'library' && feature.availability.state === 'available' ? (\n                            // Keyed by context: a new tenant starts at its first page, nothing inspected.\n                            <TestCases key={snapshot.active?.context ?? 'none'} snapshot={snapshot} dispatch={props.dispatch} onNavigate={props.onNavigate} />\n                        ) : feature.id === 'academy' && feature.availability.state === 'available' ? (\n                            // Not keyed by tenant: the learner generation is the account's, not the tenant's.\n                            <Academy snapshot={snapshot} client={props.client} onNavigate={props.onNavigate} />\n                        ) : feature.id === 'apiClient' && feature.availability.state === 'available' ? (\n                            // Not keyed by tenant: API Client documents are on this Mac.\n                            <ApiClient snapshot={snapshot} dispatch={props.dispatch} observe={observeWorkbench} />\n                        ) : (feature.id === 'runtime' || feature.id === 'gateway' || feature.id === 'redTeam') && feature.availability.state === 'available' ? (\n                            // C44: the product destinations (Go, the palette) open Administration on their product; the legacy views are gone.\n                            <Administration\n                                key={snapshot.active?.context ?? 'none'}\n\n                                snapshot={snapshot}\n{\n  \"file_bindings\": {\n    \"Cargo.lock\": {\n      \"original_sha256\": \"513de038ab408300d06721d75a2390d94c76312520505c82c6693eecace163c4\",\n      \"current_sha256\": \"513de038ab408300d06721d75a2390d94c76312520505c82c6693eecace163c4\",\n      \"original_file\": {\n        \"path\": \"docs/planning/evidence/P11/source-history/D2/Cargo.lock\",\n        \"sha256\": \"513de038ab408300d06721d75a2390d94c76312520505c82c6693eecace163c4\"\n      }\n    },\n    \"Cargo.toml\": {\n      \"original_sha256\": \"00971b61930b88ec18abd8d536d67ed14b9c1e1d65fabbafba479d293d3d46d4\",\n      \"current_sha256\": \"00971b61930b88ec18abd8d536d67ed14b9c1e1d65fabbafba479d293d3d46d4\",\n      \"original_file\": {\n        \"path\": \"docs/planning/evidence/P11/source-history/D2/Cargo.toml\",\n        \"sha256\": \"00971b61930b88ec18abd8d536d67ed14b9c1e1d65fabbafba479d293d3d46d4\"\n      }\n    },\n    \"crates/desktop-core/Cargo.toml\": {\n      \"original_sha256\": \"c61aab70870501455a80bc418447408b3e78eb59d50490ba23d2b68f5858ef01\",\n\n\ndef sha(path):\n    return hashlib.sha256(Path(path).read_bytes()).hexdigest()\n\n\ndef full_gate(verdict):\n    scores = verdict.get('scores', {})\n    require(set(scores) == DIMENSIONS and all(type(v) is int and v >= 9 and v <= 10 for v in scores.values()),\n            'member does not have all five scores at least 9')\n    require(verdict.get('recommendation') == 'pass', 'member recommendation is not pass')\n    for field in ['required_fixes', 'blockers', 'evidence_gaps']:\n        require(verdict.get(field) == [], 'member has missing/nonempty ' + field)\n\n\ndef verify_launch(root, out):\n    \"\"\"Audit requested isolation, observed feature probe and actual JSONL events.\"\"\"\n    invocation = read(out / 'invocation.json')\n    require(invocation['request_sha256'] == sha(out / 'request.json')\n            and invocation['schema_sha256'] == sha(root / 'docs/architecture/review-verdict.schema.json'),\n            'review invocation request/schema mismatch')\n    argv = invocation['command_without_prompt']\n    require(argv and argv[0] == 'codex' and argv.count('exec') == 1, 'review is not a fresh Codex exec')\n    for flag in ['--no-daemon', '--ephemeral', '--ignore-user-config', '--ignore-rules', '--json']:\n        require(argv.count(flag) == 1, 'review isolation flag missing/duplicated: ' + flag)\n    for flag, value in [('-a', 'never'), ('-s', 'read-only'), ('-m', invocation['model_requested']),\n                        ('--output-schema', 'docs/architecture/review-verdict.schema.json'),\n                        ('-o', str(out / 'verdict-returned.json'))]:\n","exit_code":0,"status":"completed"}}
