{"type":"item.started","item":{"id":"item_28","type":"command_execution","command":"/bin/zsh -lc \"sed -n '400,652p' crates/desktop-core/src/authority/workbench_domain.rs && sed -n '1,175p' crates/desktop-core/src/workbench/profile.rs && rg -n 'refinement_startup_|refinement_response_suggestions_' crates/desktop-core/tests/workbench_documents/main.rs crates/desktop-core/tests/workbench_execution/main.rs\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_28","type":"command_execution","command":"/bin/zsh -lc \"sed -n '400,652p' crates/desktop-core/src/authority/workbench_domain.rs && sed -n '1,175p' crates/desktop-core/src/workbench/profile.rs && rg -n 'refinement_startup_|refinement_response_suggestions_' crates/desktop-core/tests/workbench_documents/main.rs crates/desktop-core/tests/workbench_execution/main.rs\"","aggregated_output":"#[serde(rename_all = \"camelCase\")]\npub struct EnvironmentView {\n    pub name: String,\n    pub origin: Origin,\n}\n\n#[derive(Clone, Debug, PartialEq, Eq, Serialize, TS)]\n#[serde(rename_all = \"camelCase\")]\npub struct SecretView {\n    pub reference: String,\n    /// A value is stored on this Mac.\n    pub stored: bool,\n    /// A `tenant.*` reference: native tenant authority resolves it (C15).\n    pub managed: bool,\n}\n\n#[derive(Clone, Debug, PartialEq, Eq, Serialize, TS)]\n#[serde(rename_all = \"camelCase\")]\npub struct CollectionView {\n    pub id: String,\n    pub name: String,\n    pub folder: String,\n    /// Opaque identity of this root and collection id for presentation caches, not authority.\n    pub scope: String,\n    pub built_in: bool,\n    pub complete: bool,\n    pub requests: Vec<RequestEntry>,\n    pub folders: Vec<String>,\n    pub schemas: Vec<String>,\n    pub issues: Vec<Issue>,\n    pub environments: Vec<EnvironmentView>,\n    pub environment: Option<String>,\n    pub tabs: Vec<TabView>,\n    pub selected: Option<String>,\n    pub secrets: Vec<SecretView>,\n    /// The last private write failed (drafts may not be protected).\n    pub unsaved: Option<PrivateFailure>,\n    pub archives: u32,\n}\n\n#[derive(Clone, Debug, PartialEq, Eq, Serialize, TS)]\n#[serde(rename_all = \"camelCase\")]\npub struct WorkbenchView {\n    pub available: bool,\n    /// The private profile was read (or failed to open).\n    pub loaded: bool,\n    pub failure: Option<PrivateFailure>,\n    pub recent: Vec<RecentView>,\n    pub collection: Option<CollectionView>,\n    /// A previewed Insomnia export.\n    pub import: Option<Vec<ResourceView>>,\n    pub git: Option<GitView>,\n    /// A request is running on the lane.\n    pub busy: bool,\n    /// Edits exist that are not protected on this Mac yet.\n    pub unprotected: bool,\n    /// Requests in flight (C15).\n    pub running: Vec<RunningView>,\n    /// A tenant-credential change awaiting review.\n    pub review: Option<SendReviewView>,\n    /// Where this build sends API Client requests.\n    pub network: Network,\n}\n\n// ------------------------------------------------------------------ state\n\n#[derive(Default)]\nstruct Cell {\n    result: Mutex<Option<WorkbenchResult>>,\n    ready: Notify,\n}\n\n/// A single-use wait for one API Client request's result.\npub struct WorkbenchHandle(Arc<Cell>);\n\nimpl std::fmt::Debug for WorkbenchHandle {\n    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {\n        f.write_str(\"WorkbenchHandle\")\n    }\n}\n\nimpl WorkbenchHandle {\n    pub async fn result(self) -> WorkbenchResult {\n        loop {\n            let notified = self.0.ready.notified();\n            if let Some(result) = self.0.result.lock().ok().and_then(|r| r.clone()) {\n                return result;\n            }\n            notified.await;\n        }\n    }\n}\n\nstruct Call {\n    operation: OperationId,\n    page: crate::PresentationLease,\n    cell: Arc<Cell>,\n    settled: bool,\n    observed: bool,\n    /// Left the lane (a transfer or confirmation in progress).\n    later: bool,\n}\n\npub(super) struct Open {\n    root: PathBuf,\n    scope: String,\n    built_in: bool,\n    catalog: Catalog,\n    data: Scope,\n    unsaved: Option<PrivateFailure>,\n    documents: BTreeMap<String, Document>,\n    recovered: BTreeSet<String>,\n    conflicts: BTreeMap<String, ConflictKind>,\n    interrupted: BTreeSet<String>,\n}\n\n#[derive(Default)]\npub(super) struct Workbench {\n    pub(super) lane: Arc<tokio::sync::Mutex<()>>,\n    calls: Vec<Call>,\n    running: usize,\n    profile: Option<Profile>,\n    failure: Option<PrivateFailure>,\n    open: Option<Open>,\n    /// Documents with unprotected edits: the newest edit generation the\n    /// editor reported for each.\n    editing: BTreeMap<String, u32>,\n    import: Option<insomnia::Export>,\n    git: Option<GitView>,\n    /// Fixture builds: fail a Save after this many file writes.\n    pub(super) interrupt: Option<Interrupt>,\n    pub(in crate::authority) sending: send::Sending,\n}\n\nimpl Workbench {\n    /// Forgets everything held (reset).\n    pub(super) fn clear(&mut self) {\n        self.profile = None;\n        self.failure = None;\n        self.open = None;\n        self.editing.clear();\n        self.import = None;\n        self.git = None;\n        self.sending.clear();\n    }\n}\n\nfn folder_name(root: &std::path::Path) -> String {\n    root.file_name()\n        .map(|n| n.to_string_lossy().into_owned())\n        .unwrap_or_default()\n}\n\nimpl Open {\n    fn entry(&self, id: &str) -> Option<&RequestEntry> {\n        self.catalog.requests.iter().find(|r| r.id == id)\n    }\n\n    fn view(&self, id: &str) -> Option<DocumentView> {\n        let doc = self.documents.get(id)?;\n        let draft = self.data.drafts.get(id);\n        Some(DocumentView {\n            id: doc.id.clone(),\n            relative: doc.relative.clone(),\n            revision: doc.revision(),\n            fields: draft.map_or_else(|| doc.saved.clone(), |d| d.fields.clone()),\n            saved: doc.saved.clone(),\n            new: doc.new,\n            recovered: self.recovered.contains(id),\n            body_editable: doc.body_editable,\n            schema: doc.schema(),\n            conflict: self.conflicts.get(id).copied(),\n            interrupted: self.interrupted.contains(id),\n            metadata_dirty: doc.metadata_dirty,\n        })\n    }\n\n    fn open_tab(&mut self, id: &str) {\n        if !self.data.open.iter().any(|t| t == id) {\n            self.data.open.push(id.to_owned());\n        }\n        self.data.selected = Some(id.to_owned());\n    }\n\n    fn environments(&self) -> Vec<EnvironmentView> {\n        let mut names: BTreeMap<String, Origin> = BTreeMap::new();\n        for name in &self.catalog.environments {\n            names.insert(name.clone(), Origin::Shared);\n        }\n        for name in self\n            .data\n            .private\n            .keys()\n            .filter(|n| *n != environments::DEFAULTS)\n        {\n            names\n                .entry(name.clone())\n                .and_modify(|o| *o = Origin::Both)\n                .or_insert(Origin::Local);\n        }\n        names\n            .into_iter()\n            .map(|(name, origin)| EnvironmentView { name, origin })\n            .collect()\n    }\n}\n\nimpl State {\n    pub(super) fn admit_workbench(&mut self) -> Result<OperationId, Refusal> {\n        if self.workbench.calls.iter().filter(|c| !c.settled).count() >= 256 {\n            return Err(Refusal::Busy);\n        }\n        let operation = self.operations.reserve();\n        self.workbench.calls.push(Call {\n            operation: operation.clone(),\n            page: self.workbench.sending.page_lease(),\n            cell: Arc::default(),\n            settled: false,\n            observed: false,\n            later: false,\n        });\n        self.workbench.running += 1;\n        Ok(operation)\n    }\n\n    pub(super) fn settle_workbench(&mut self, operation: &OperationId, result: WorkbenchResult) {\n        self.workbench.running = self.workbench.running.saturating_sub(1);\n        if let Some(call) = self\n            .workbench\n            .calls\n            .iter_mut()\n            .find(|c| &c.operation == operation)\n        {\n            call.settled = true;\n            if let Ok(mut slot) = call.cell.result.lock() {\n                *slot = Some(result);\n            }\n            call.cell.ready.notify_waiters();\n        }\n        self.prune_workbench_calls();\n    }\n\n    fn prune_workbench_calls(&mut self) {\n        self.workbench.calls.retain(|c| !(c.settled && c.observed));\n        let settled = self.workbench.calls.iter().filter(|c| c.settled).count();\n        let mut excess = settled.saturating_sub(RETAINED_RESULTS);\n        self.workbench.calls.retain(|c| {\n            if excess > 0 && c.settled {\n                excess -= 1;\n                false\n            } else {\n                true\n            }\n//! The API Client's private profile on this Mac (C14): recent collections,\n//! the value-free index of stored secrets, the built-in collection's write\n//! record and, per collection, its tabs, selected environment, private\n//! environments, protected drafts, archived conflict versions and the save\n//! journal. Everything is sealed (XChaCha20-Poly1305) under one key in the\n//! credential Keychain namespace; reset removes the key and the folder.\n//! Project files stay in their collections and are never copied here except\n//! as archived conflict evidence.\n\nuse std::collections::BTreeMap;\nuse std::path::{Path, PathBuf};\n\nuse serde::de::DeserializeOwned;\nuse serde::{Deserialize, Serialize};\nuse sha2::{Digest, Sha256};\nuse ts_rs::TS;\n\nuse super::document::{Document, Fields};\nuse crate::vault::{RecordId, Vault, VaultError};\n\nconst SCHEMA: &str = \"prisma-airs-desktop-v2/api-client/1\";\npub const PROFILE_BYTES: usize = 1024 * 1024;\npub const SCOPE_BYTES: usize = 64 * 1024 * 1024;\npub const RECENT: usize = 8;\n/// Drafts kept per collection (closed tabs keep theirs).\npub const MAX_DRAFTS: usize = 64;\n/// Archived conflict versions kept per collection (oldest dropped).\npub const MAX_ARCHIVES: usize = 16;\n/// Archived file text kept per version.\npub const ARCHIVE_BYTES: usize = 1024 * 1024;\n\n/// Why the private profile could not be opened or saved (sanitized).\n#[derive(Clone, Copy, Debug, PartialEq, Eq, Serialize, TS)]\n#[serde(rename_all = \"camelCase\")]\npub enum PrivateFailure {\n    Locked,\n    Denied,\n    Unavailable,\n    /// A sealed file did not open under its key; it was kept aside.\n    Unreadable,\n}\n\n/// The credential-namespace record holding the profile key.\npub fn key_record() -> RecordId {\n    let digest = crate::offline::digest(\"api-client-profile-key\");\n    RecordId::parse(&format!(\"cr-{}\", &digest[..16])).expect(\"16 hex digits\")\n}\n\n/// The record holding one workbench secret value (never a tenant record:\n/// a different derivation and prefix in the digest).\npub fn secret_record(collection: &str, reference: &str) -> RecordId {\n    let digest = crate::offline::digest(&format!(\"api-client-secret:{collection}\\0{reference}\"));\n    RecordId::parse(&format!(\"cr-{}\", &digest[..16])).expect(\"16 hex digits\")\n}\n\n/// A collection's private scope: its folder and identity (v1).\npub fn scope(root: &Path, collection: &str) -> String {\n    let digest = Sha256::digest(format!(\"{}\\0{collection}\", root.display()).as_bytes());\n    hex::encode(&digest[..16])\n}\n\n#[derive(Clone, Debug, PartialEq, Eq, Serialize, Deserialize)]\npub struct Recent {\n    pub root: PathBuf,\n    pub id: String,\n    pub name: String,\n}\n\n#[derive(Clone, Debug, Default, PartialEq, Eq, Serialize, Deserialize)]\npub struct Profile {\n    pub recent: Vec<Recent>,\n    /// (collection, reference) pairs with a value in the Keychain.\n    pub secrets: Vec<(String, String)>,\n    /// Built-in collection files and the hash this desktop last wrote.\n    pub scm: BTreeMap<String, String>,\n    /// Absent in existing profiles: first use opens SCM. Closed is an\n    /// explicit preference, not another first-use marker.\n    #[serde(default)]\n    pub selection: Option<Selection>,\n}\n\n#[derive(Clone, Debug, PartialEq, Eq, Serialize, Deserialize)]\n#[serde(tag = \"kind\", rename_all = \"camelCase\", deny_unknown_fields)]\npub enum Selection {\n    BuiltIn,\n    Custom { root: PathBuf, id: String },\n    Closed,\n}\n\nimpl Profile {\n    pub fn remember(&mut self, recent: Recent) {\n        self.recent.retain(|r| r.root != recent.root);\n        self.recent.insert(0, recent);\n        self.recent.truncate(RECENT);\n    }\n}\n\n#[derive(Clone, Debug, PartialEq, Eq, Serialize, Deserialize)]\npub struct Draft {\n    pub document: Document,\n    pub fields: Fields,\n}\n\n/// Both versions kept before a conflict choice replaced either.\n#[derive(Clone, Debug, PartialEq, Eq, Serialize, Deserialize)]\npub struct Archive {\n    pub relative: String,\n    pub at: u64,\n    pub local: Fields,\n    pub disk_metadata: Option<String>,\n    pub disk_body: Option<String>,\n}\n\n#[derive(Clone, Debug, Default, PartialEq, Eq, Serialize, Deserialize)]\npub struct Scope {\n    pub open: Vec<String>,\n    pub selected: Option<String>,\n    pub environment: Option<String>,\n    /// Private environments by name (their TOML text).\n    pub private: BTreeMap<String, String>,\n    pub drafts: BTreeMap<String, Draft>,\n    pub archives: Vec<Archive>,\n}\n\nimpl Scope {\n    pub fn archive(&mut self, archive: Archive) {\n        self.archives.push(archive);\n        let excess = self.archives.len().saturating_sub(MAX_ARCHIVES);\n        self.archives.drain(..excess);\n    }\n}\n\n/// A save in progress: what each file held before and will hold after.\n#[derive(Clone, Debug, PartialEq, Eq, Serialize, Deserialize)]\npub struct Journal {\n    pub request: String,\n    pub relative: String,\n    pub files: Vec<(String, Option<String>, String)>,\n}\n\nfn failure(error: VaultError) -> PrivateFailure {\n    match error {\n        VaultError::Locked => PrivateFailure::Locked,\n        VaultError::Denied => PrivateFailure::Denied,\n        _ => PrivateFailure::Unavailable,\n    }\n}\n\n/// The profile key (created on first use when `create`).\npub(crate) fn key(keychain: &dyn Vault, create: bool) -> Result<Option<[u8; 32]>, PrivateFailure> {\n    let record = key_record();\n    let bytes = match keychain.get(&record) {\n        Ok(bytes) => bytes,\n        Err(VaultError::NotFound) if create => {\n            let fresh = crate::offline::new_key().ok_or(PrivateFailure::Unavailable)?;\n            keychain.put(&record, &fresh).map_err(failure)?;\n            fresh\n        }\n        Err(VaultError::NotFound) => return Ok(None),\n        Err(e) => return Err(failure(e)),\n    };\n    let key: [u8; 32] = bytes\n        .as_slice()\n        .try_into()\n        .map_err(|_| PrivateFailure::Unreadable)?;\n    Ok(Some(key))\n}\n\nfn path(root: &Path, name: &str) -> PathBuf {\n    let digest = crate::offline::digest(&format!(\"api-client:{name}\"));\n    root.join(format!(\"{}.sealed\", &digest[..32]))\n}\n\npub(crate) fn aad(name: &str) -> Vec<u8> {\n    format!(\"{SCHEMA}:{name}\").into_bytes()\ncrates/desktop-core/tests/workbench_documents/main.rs:152:async fn refinement_startup_defaults_once_and_remembers_an_explicit_close() {\ncrates/desktop-core/tests/workbench_documents/main.rs:184:async fn refinement_startup_restores_custom_choice_and_does_not_replace_missing_or_changed_folders()\ncrates/desktop-core/tests/workbench_documents/main.rs:240:async fn refinement_startup_rejects_a_redirected_custom_root_even_with_the_same_collection_id() {\ncrates/desktop-core/tests/workbench_execution/main.rs:594:async fn refinement_response_suggestions_normalize_whitespace_without_renaming_the_chosen_destination()\n","exit_code":0,"status":"completed"}}
