{"type":"item.started","item":{"id":"item_21","type":"command_execution","command":"/bin/zsh -lc \"sed -n '735,822p' tools/p11/proof.py && sed -n '1,115p' tools/p11/remediation.py && sed -n '221,414p' tools/p11/remediation.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_21","type":"command_execution","command":"/bin/zsh -lc \"sed -n '735,822p' tools/p11/proof.py && sed -n '1,115p' tools/p11/remediation.py && sed -n '221,414p' tools/p11/remediation.py\"","aggregated_output":"def verify(root, path):\n    record = read(path)\n    require(record['schema'] == 'airs-desktop/p11-shared-qualification/1', 'P11 proof schema')\n    require(set(record['runner_inputs']) == {'source', 'dependencies', 'build_flags'},\n            'P11 runner input keys differ')\n    require(record['runner_inputs']['source'] == xtask_source(root),\n            'current source does not match actual runner source fingerprint')\n    seal = read(bound(root, record['source']))\n    require(source_inventory(root) == seal['files'], 'P11 source changed after qualification')\n    qualified = read(bound(root, record['coverage']))\n    require(digest(seal['files']) == qualified['source_inventory_sha256'], 'P11 source binding')\n    if 'review_remediation' in record:\n        require(qualified.get('review_remediation') == record['review_remediation'],\n                'review remediation qualification binding differs')\n    elif 'helper_source_carry' in record:\n        validate_helper_source_carry(root, bound(root, record['helper_source_carry']), record['runner_inputs'])\n    elif 'impact_selection' in record:\n        validate_impact_selection(root, bound(root, record['impact_selection']), record['runner_inputs'])\n    else:\n        for kind in ('check', 'test'):\n            validate_run(root, bound(root, record['runs'][kind]), kind, record['runner_inputs'])\n    inputs = read(bound(root, record['fingerprint']))\n    require(record['runner_inputs'] == {key: inputs[key] for key in record['runner_inputs']},\n            'P11 observed current fingerprint mismatch')\n    current = current_fingerprints(root)\n    require(record['runner_inputs'] == {key: current[key] for key in record['runner_inputs']},\n            'current dependency/toolchain/build flags differ from executed checks')\n    result = verify_coverage(root, qualified)\n    candidate = read(bound(root, qualified['candidate']))\n    from candidate import verify_candidate\n    verify_candidate(root, candidate)\n    performed = read(bound(root, record['native_execution']))\n    if 'review_remediation' in record:\n        remedy = read(bound(root, record['review_remediation']))\n        recovery = read(bound(root, remedy['recovery']))\n        require(record['native_execution'] == recovery['raw']\n                and candidate['helper_closure'] == recovery['helper_closure'],\n                'affected recovery helper/execution membership changed')\n    else:\n        require(candidate['helper_closure'] == helper_closure(root, native_driver(root, performed)),\n                'P11 native helper membership changed')\n        validate_execution(root, performed, candidate,\n            acceptance=bound(root, record['native_acceptance']) if 'native_acceptance' in record else None,\n            execution=bound(root, record['native_execution']))\n    build_path = bound(root, record['build'])\n    build = read(build_path)\n    require(build['application_inputs_unchanged'] is True\n            and all(step['exit_code'] == 0 for step in build['steps']), 'fixture build failed/drifted')\n    if 'review_remediation' in record:\n        import remediation\n        remediation.versioned_build(root, build, candidate)\n    else:\n        require([step['argv'] for step in build['steps']] == [\n            ['pnpm', '--filter', '@prisma-airs/desktop-contracts', 'typecheck'],\n            ['pnpm', '--filter', '@prisma-airs/desktop', 'typecheck'],\n            ['cargo', 'run', '--locked', '-p', 'xtask', '--', 'native-prepare', '--phase', 'P11',\n             '--target', 'aarch64-apple-darwin', '--features', 'test-fixtures']],\n            'missing or changed fixture build invocation')\n    require(set(build['application_inputs_before']) == application_files(root),\n            'built application input membership differs or is incomplete')\n    require(read(build_path.parent / 'native-prepare.json') == read(bound(root, candidate['prepare'])),\n            'prepared candidate differs from retained actual build output')\n    for step in build['steps']:\n        log = (build_path.parent / step['log']).resolve()\n        require(log.is_relative_to(root.resolve()) and sha(log) == step['log_sha256'],\n                'fixture build log drift')\n    changed = [name for name, value in build['application_inputs_before'].items()\n               if sha(root / name) != value]\n    if changed:\n        carry_schema = read(bound(root, record['build_input_carry']))['schema']\n        if carry_schema == 'airs-desktop/rust-test-build-carry/1':\n            rust_test_carry(root, record, build_path, build, candidate, changed)\n        else:\n            frontend_test_carry(root, record, build_path, build, candidate, changed)\n    else:\n        require('build_input_carry' not in record, 'unnecessary or stale build carry')\n    baseline = read(bound(root, record['historical_baseline']))\n    require(record['historical_baseline']['path'] == 'docs/planning/evidence/P10/completion-proof.json'\n            and baseline['schema'] == 'airs-desktop/p10-completion-proof/1', 'missing accepted baseline')\n    from review_gate import release_prerequisites\n    require(record['historical_standing'] == release_prerequisites(root),\n            'actual historical standing drift')\n    return {'record': str(path.relative_to(root)), 'sha256': sha(path),\n            'verified': result, 'candidate_sha256': qualified['candidate']['sha256'],\n            'controller_complete': False}\n\n\ndef make(root, check, tests, fingerprint, prepare, native, execution, build, out,\n\"\"\"Dated P11 review fixes: affected executions plus explicit unchanged impact.\n\nOriginal runs/results/candidates remain immutable. This composes evidence; it\nnever executes tests, changes a verdict, or turns an old process into a new one.\n\"\"\"\nfrom pathlib import Path\nimport argparse\nimport copy\nfrom datetime import datetime\nimport hashlib\nimport json\nimport tarfile\n\nimport proof\nfrom standing import ArchivedP11\n\nread, bound, require, sha, digest = proof.read, proof.bound, proof.require, proof.sha, proof.digest\nBASELINE = 'docs/planning/evidence/P11/qualification-final-02/qualification.json'\nBUILD_HELPER = ('crates/xtask/examples/p11_native_candidate.rs',\n                '704087ca7cec096359e17731bea859a7c9bcf814e05856e5819af1f874610062')\n# Populated only from the frozen, reviewed P2 recovery patch. Other application\n# changes cannot use this one-off impact decision.\nAPP_DELTA = {'apps/desktop/src/app.tsx': ('9de8de88cb261f3b826d05ab2c2c1ca195a7dc1ba05f68e6bfbb60ad20fdef89',\n                              'c3492519fa99eebf5e4bc24bcd603a528d1b0a4ca4c958ebedef8c008714169e'),\n 'apps/desktop/src/v2/store.ts': ('e5569371c60bd473fab6f3a944d32b458a7878223e89d883918ca0d4e88d143d',\n                                  '8bc2feec3d7de4c6dc8ef31ab6233c88b8209218285917de0c50acd1e70225d8'),\n 'apps/desktop/src/v2/workbench/api-client.test.tsx': ('f154cef0337e4f9ded2949958cf995f30df806ea177a984a8e5b9de5f5b5b5c5',\n                                                       '161ad953f06049d464ef001857c3cb59fb221e62ff8d9e255c7a75a99d1cb548'),\n 'apps/desktop/src/v2/workbench/api-client.tsx': ('c510a3118520f2cbef52f310b70662f0a1cb06e5a42f71a9937088e847000116',\n                                                  'b95eb3953ff1e51b16012d38c982b4f71cebc39b12c294b383c2134346d43bde')}\nTEST_DELTA = {\n    'crates/desktop-core/tests/harness_tools/main.rs': (\n        'ad88285ee7ae6b2e3ee1e7828565f50659423fd27483b10f3511eb81a18c287f',\n        '7a72bcd6afd6a56edf20b04d1195794b32e0cda85d816f4bc886f99281584861'),\n    'crates/desktop-core/tests/ui_v2_inbox/main.rs': (\n        '0d19a3058ba5847fdec43860a53fb1454834bb867b398cd89331494ec8d3f443',\n        'd746a8ad524e38502daa9dbb1ffb6d4368a4d9324fe4b6fd5ba11b471b4d2811'),\n}\nSCROLL_FACTS = {'overflowing_fixture_history', 'lower_call_initially_below_viewport',\n                'lower_call_reached', 'drawer_content_moved', 'underlying_page_position_unchanged'}\n\n\ndef completed(raw):\n    try:\n        start = datetime.fromisoformat(raw['started_utc'].replace('Z', '+00:00'))\n        end = datetime.fromisoformat(raw['finished_utc'].replace('Z', '+00:00'))\n        return raw['exit_code'] == 0 and bool(raw['argv']) and start.tzinfo and end.tzinfo and start <= end\n    except (KeyError, TypeError, ValueError):\n        return False\n\n\ndef delta(before, after, declared):\n    changed = sorted(n for n in set(before) | set(after) if before.get(n) != after.get(n))\n    require(changed == declared and APP_DELTA, 'remediation delta is undeclared/unfrozen')\n    pairs = APP_DELTA | TEST_DELTA\n    for name in changed:\n        if name in pairs:\n            require(tuple(files.get(name, {}).get('sha256') for files in (before, after)) == pairs[name],\n                    'remediation is not the frozen review fix: ' + name)\n        elif name == BUILD_HELPER[0]:\n            require(name not in before and after[name].get('sha256') == BUILD_HELPER[1],\n                    'versioned build helper is not the frozen reviewed adapter')\n        else:\n            require(name.startswith(('tools/p11/', 'tools/native-acceptance/')) or name in (\n                '.gitattributes', 'docs/planning/refinements/2026-11-04/execution.md',\n                'crates/xtask/examples/p11_native_candidate.rs'),\n                'unrelated production/configuration change: ' + name)\n    require(set(pairs) <= set(changed), 'review fix source change missing')\n    return changed\n\n\ndef dependencies(files, cid, helper_paths=()):\n    \"\"\"Conservative closure, except the exact hash-pinned remediation paths.\"\"\"\n    roots = ('crates/desktop-core/', 'crates/xtask/src/', 'packages/desktop-contracts/',\n             'resources/', 'docs/architecture/', '.cargo/')\n    if cid.startswith('C') or '/frontend/' in cid or cid == 'test:C47/fixture':\n        roots += ('apps/desktop/',)\n    exact = {'Cargo.toml', 'Cargo.lock', 'rust-toolchain.toml', 'pnpm-lock.yaml',\n             'pnpm-workspace.yaml', 'package.json', 'crates/xtask/Cargo.toml'}\n    return sorted(({n for n in files if n in exact or n.startswith(roots)} | set(helper_paths))\n                  - set(APP_DELTA) - set(TEST_DELTA))\n\n\ndef preserved_bundle(root, reference, original):\n    record = read(bound(root, reference))\n    require(record['schema'] == 'airs-desktop/p11-preserved-candidate/1'\n            and record['old_qualification']['path'] == BASELINE\n            and record['original_prepare'] == original['prepare'], 'preserved candidate source differs')\n    archive = bound(root, record['archive'])\n    require(archive.stat().st_size == record['archive']['size'], 'preserved archive size differs')\n    entries, executable = [], None\n    with tarfile.open(archive) as stream:\n        members = stream.getmembers()\n        prefix = members[0].name.rstrip('/') + '/'\n        for item in members:\n            require(not item.name.startswith('/') and '..' not in Path(item.name).parts,\n                    'preserved archive path escapes application')\n            if item.isdir():\n                continue\n            require(item.name.startswith(prefix) and (item.isfile() or item.issym()),\n                    'unsupported preserved application member')\n            name = item.name[len(prefix):]\n            value = (hashlib.sha256(item.linkname.encode()).hexdigest() if item.issym()\n                     else hashlib.sha256(stream.extractfile(item).read()).hexdigest())\n            mode = 'symlink' if item.issym() else '100755' if item.mode & 0o111 else '100644'\n            entries.append((name, mode, value))\n            if name == 'Contents/MacOS/prisma-airs-desktop': executable = value\n    complete = hashlib.sha256(''.join(f'{n}\\0{m}\\0{v}\\n' for n, m, v in sorted(entries)).encode()).hexdigest()\n    require(complete == record['bundle_sha256'] == original['bundle_sha256']\n            and executable == record['executable_sha256'] == original['executable_sha256'],\n            'preserved original application bytes differ')\n\n\ndef scroll(root, reference, baseline, original, files):\n    supplement = read(bound(root, reference))\ndef selector_reference(receipt, cid):\n    return receipt['recovery'] if cid == 'C48-N03' else receipt['format'] if cid == 'check:C46/check/1' else receipt['source_qa']\n\n\ndef source_transition(root, receipt, candidate, source, files):\n    old_record = read(bound(root, receipt['baseline']))\n    require(receipt['baseline']['path'] == BASELINE, 'foreign remediation baseline')\n    old_coverage = read(bound(root, old_record['coverage']))\n    old_candidate = read(bound(root, old_coverage['candidate']))\n    before = read(bound(root, old_record['source']))['files']\n    delta(before, files, receipt['changed_paths'])\n    require(all(candidate[k] == old_candidate[k] for k in ('conditions', 'build_flags'))\n            and all(candidate['runner_inputs'][k] == old_record['runner_inputs'][k]\n                    for k in ('dependencies', 'build_flags')), 'remediation VM/toolchain/flags changed')\n    history = ArchivedP11(root, receipt['historical_context'])\n    require(history.source(digest(before)) == root/'docs/planning/evidence/P11/source-history/S3',\n            'original reviewed source context differs')\n    proof.verify_coverage(root, old_coverage, historical=history)\n    preserved_bundle(root, receipt['preserved_candidate'], old_candidate)\n    scroll(root, receipt['scroll'], receipt['baseline'], old_candidate, files)\n    rust_consumers(root, receipt['rust_consumers'], files)\n    affected_lints(root, receipt, files)\n    format_selector(root, receipt['format'], files, candidate['execution_root'])\n    covered = set()\n    require(receipt['helper_qa'], 'remediation affected helper QA missing')\n    for ref in receipt['helper_qa']:\n        qa = read(bound(root, ref)); bound(root, qa['log'])\n        require(qa['schema'] == 'airs-desktop/p11-helper-qa/1' and qa['argv']\n                and qa['exit_code'] == 0 and qa['tests']['passed'] > 0 and qa['tests']['failed'] == 0\n                and qa.get('source_before') == qa.get('source_after')\n                and qa['helper_files'] and all(files.get(n, {}).get('sha256') == value\n                    for n, value in qa['helper_files'].items()), 'remediation helper QA failed/drifted')\n        covered.update(qa['helper_files'])\n    require({n for n in receipt['changed_paths'] if n.endswith('.py')} <= covered,\n            'remediation changed helper lacks affected QA')\n    return old_record, old_coverage, history\n\n\ndef source_qa(root, reference, files):\n    supplement = read(bound(root, reference))\n    require(supplement['schema'] == 'airs-desktop/p11-c48-source-supplement/1'\n            and supplement['source_files'] == {n: files[n]['sha256'] for n in APP_DELTA},\n            'C48 affected source inputs differ')\n    producers = [read(bound(root, ref)) for ref in supplement['producer_receipts']]\n    originals = [row for producer in producers for key in ('final_checks', 'retained_prior_focused_checks')\n                 for row in producer.get(key, [])]\n    expected = {'C48/recovery-final02': 4, 'C48/typecheck-final02': None,\n        'C48/controllers-final': 20, 'C48/api-prior': 42, 'C48/shell-and-cases-prior': 45}\n    checks = supplement['checks']\n    require(len(checks) == len(expected) and {c['id'] for c in checks} == set(expected),\n            'C48 selected recovery/cross-consumer coverage missing')\n    earlier = {\n        'apps/desktop/src/v2/workbench/api-client.tsx': {\n            '50b881c165ce183abe845f4c572d687fe7bc4b0041a1a69c875394c55a67bb1d',\n            '0d1da0ed31d0ff86e4d46fb0392f08ad06945b30eb47c7cf97c114fba46e63d3'},\n        'apps/desktop/src/v2/workbench/api-client.test.tsx': {\n            '2d07b3ec2c0d340b30c4cf23877c05b548d30f34c7a4a98fe2dc72433f2f01eb',\n            '7a68e497d5056c30ebb8aa1f9f9c8216d7a28e979d86496ea74cbce9c255de03'}}\n    for item in checks:\n        require(item['exit_code'] == 0 and item.get('passed') == expected[item['id']]\n                and item['argv'] and item['cwd'], 'C48 selected command failed')\n        log = bound(root, item['log'])\n        require(any(all(old.get(k) == item.get(k) for k in ('argv', 'cwd', 'exit_code', 'passed'))\n                    and old['log_sha256'] == sha(log) for old in originals),\n                'C48 selection is not an original actual execution')\n        require(item['source_hashes'] and set(item['source_inputs']) == set(item['source_hashes']),\n                'C48 original source scope missing')\n        for name, value in item['source_hashes'].items():\n            require(sha(bound(root, item['source_inputs'][name])) == value\n                    and (files.get(name, {}).get('sha256') == value or value in earlier.get(name, set())),\n                    'C48 selected source delta is not the bounded recovery refinement')\n        if item['id'].endswith('final02'):\n            require(item['source_hashes'] == supplement['source_files'], 'final selector source was retagged')\n    return supplement\n\n\ndef recovery(root, reference, baseline, candidate, old_result, files):\n    supplement = read(bound(root, reference))\n    raw = read(bound(root, supplement['raw']))\n    bound(root, supplement['execution']); bound(root, supplement['source'])\n    needed = {'missing_restore_warning_visible', 'recovery_survives_home_back', 'retry_is_explicit',\n              'retry_recovers_when_root_restored', 'intentional_close_stays_closed'}\n    require(supplement['schema'] == 'airs-desktop/p11-recovery-supplement/1'\n            and supplement['baseline_qualification'] == baseline\n            and needed <= set(supplement['facts'])\n            and supplement['facts'] == raw['facts'] and all(v is True for v in raw['facts'].values()),\n            'affected recovery observations incomplete')\n    require(completed(raw) and raw['cwd'] == candidate['execution_root']\n            and supplement['prepare'] == candidate['prepare']\n            and raw['source_sha256'] == supplement['source']['sha256']\n            and all(supplement[k] == raw[k] == candidate[k] for k in ('executable_sha256', 'bundle_sha256'))\n            and raw['conditions'] == candidate['conditions'], 'recovery execution/candidate differs')\n    require(supplement['helper_closure'] == raw.get('helper_closure') and supplement['helper_closure']\n            and all(files.get(n, {}).get('sha256') == value\n            for n, value in supplement['helper_closure'].items()), 'recovery helper inputs changed')\n    require(supplement['retained_result'] == old_result and supplement['retained_reason'],\n            'old N03 first-use/save observations were lost or retagged')\n    require(supplement['captures'], 'recovery pixels missing')\n    for image in supplement['captures']:\n        bound(root, image)\n        require(image['visually_reviewed'] is True and image['accepted'] is True and not image['findings'],\n                'recovery capture not individually accepted')\n    return supplement\n\n\nSOURCE_IDS = {'check:C46/check/1', 'check:C46/check/4', 'test:C47/fixture', 'test:C48/frontend/1', 'test:C48/frontend/2'}\n\n\ndef verify_coverage(root, qualified, historical=None):\n    receipt = read(bound(root, qualified['review_remediation']))\n    candidate = read(bound(root, qualified['candidate']))\n    source = historical.source(qualified['source_inventory_sha256']) if historical else root\n    files = read(bound(root, receipt['current_source']))['files']\n    require(digest(files) == qualified['source_inventory_sha256']\n            and files == ({str(p.relative_to(source)): proof.file_identity(p) for p in source.rglob('*')\n                           if p.is_file() or p.is_symlink()} if historical else proof.source_inventory(root)),\n            'remediation current source differs')\n    require(receipt['schema'] == 'airs-desktop/p11-review-remediation/1'\n            and receipt['runner_inputs'] == candidate['runner_inputs'], 'remediation source binding missing')\n    original_record, original_coverage, history = source_transition(root, receipt, candidate, source, files)\n    source_qa(root, receipt['source_qa'], files)\n    originals = {r['id']: r for r in original_coverage['coverage']}\n    recovery(root, receipt['recovery'], receipt['baseline'], candidate, originals['C48-N03']['result'], files)\n    modes = {cid: 'executed' if cid in SOURCE_IDS | {'C48-N03'} else 'carried_unaffected' for cid in originals}\n    plan = read(bound(root, qualified['plan']))\n    proof.verify_plan(source, plan, modes)\n    rows = qualified['coverage']\n    require(len(rows) == len(originals) and {r['id'] for r in rows} == set(originals), 'remediation coverage missing/duplicated')\n    require(set(receipt['unaffected']) == set(originals)-SOURCE_IDS-{'C48-N03'}, 'unchanged-impact reason missing')\n    requirements = {r['id']: r for r in plan['requirements']}\n    for row in rows:\n        cid = row['id']; require(row['disposition'] == modes[cid], 'remediation disposition differs')\n        if cid in SOURCE_IDS | {'C48-N03'}:\n            expected = {'schema': 'airs-desktop/p11-affected-selector-result/1', 'required_id': cid,\n                'actual_evidence': selector_reference(receipt, cid),\n                'original_result': originals[cid]['result'],\n                'meaning': 'Actual affected selectors supplement the retained original registered goal. No full original command or unrelated native flow is claimed newly executed.'}\n            require(read(bound(root, row['result'])) == expected, 'affected goal lacks actual selector evidence')\n            continue\n        require(row['result'] == originals[cid]['result'] and receipt['unaffected'][cid], 'original result was relabelled')\n        original = read(bound(root, row['result'])); origin = read(bound(root, original['candidate']))\n        deps = dependencies(files, cid, requirements[cid].get('helper_paths', []))\n        require(requirements[cid].get('dependencies') == deps\n                and row['impact']['dependencies'] == deps\n                and row['impact']['reason'] == receipt['unaffected'][cid]\n                and row['impact']['original_candidate_sha256'] == original['candidate']['sha256'],\n                'remediation dependency scope/rationale differs')\n        impact = read(bound(root, row['impact']['proof']))\n        bindings = impact['file_bindings']\n        require(set(bindings) == set(deps) and deps\n                and impact['unchanged_dependencies'] == deps\n                and impact['current_source_inventory_sha256'] == qualified['source_inventory_sha256']\n                and impact['original_candidate_sha256'] == original['candidate']['sha256'],\n                'remediation dependency proof binding differs')\n        old_source = history.source(origin['source_inventory_sha256'])\n        for name in deps:\n            value = bindings[name]\n            require(value['original_sha256'] == value['current_sha256'] == sha(source/name) == sha(old_source/name),\n                    'carried dependency changed: ' + name)\n    # The old custom partial Check rows were already validated above in their\n    # archived source. Their failed full-run status must not be rewritten to\n    # satisfy the generic all-pass-run parser. Other original raw rows use it.\n    generic_ids = {cid for cid in originals if cid not in SOURCE_IDS | {'C48-N03'} and not cid.startswith('check:')}\n    runtime_plan = read(bound(root, qualified['runtime_plan']))\n    require(runtime_plan == dict(plan, requirements=[r for r in plan['requirements'] if r['id'] in generic_ids]),\n            'remediation generic coverage projection differs')\n    proof.coverage.verify(root, dict(qualified, plan=qualified['runtime_plan'],\n        coverage=[r for r in rows if r['id'] in generic_ids]), historical=historical)\n    return {'qualified': True, 'required': len(rows),\n            'dispositions': {m: sum(r['disposition'] == m for r in rows) for m in sorted(set(modes.values()))},\n            'candidate_sha256': qualified['candidate']['sha256'], 'source_inventory_sha256': qualified['source_inventory_sha256']}\n\n\ndef versioned_build(root, build, candidate):\n    path = candidate['prepare']['path']\n    prefix, suffix = 'docs/planning/evidence/P11/native-build-', '-vm/native-prepare.json'\n    number = path.removeprefix(prefix).removesuffix(suffix)\n    require(number.isdigit() and int(number) >= 5 and path == f'{prefix}{int(number):02}{suffix}',\n            'new build may not overwrite the original canonical preparation')\n    argv = ['cargo', 'run', '--locked', '-p', 'xtask', '--example', 'p11_native_candidate', '--', '--out', path]\n    commands = [step['argv'] for step in build['steps']]\n    require(commands and commands[-1] in (argv, argv[:2]+['--offline']+argv[2:])\n            and commands[:-1] in ([], [['pnpm', '--filter', '@prisma-airs/desktop-contracts', 'typecheck'],\n                ['pnpm', '--filter', '@prisma-airs/desktop', 'typecheck']])\n            and build['application_inputs_after'] == build['application_inputs_before'],\n            'versioned native build command/input recipe differs')\n    old = read(root/'docs/planning/evidence/P11/native-prepare.json')\n    current = read(bound(root, candidate['prepare']))\n    require(current['commands'] == old['commands'] and current['target'] == old['target']\n            and current['features'] == old['features'] and current['subject'] == 'P11',\n            'versioned build changed the fixture recipe')\n\n\ndef make(root, receipt_path, out):\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_22","type":"command_execution","command":"/bin/zsh -lc \"sed -n '223,471p' apps/desktop/src/v2/workbench/api-client.test.tsx && cat apps/desktop/src/v2/workbench/request-presentation.test.ts\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_22","type":"command_execution","command":"/bin/zsh -lc \"sed -n '223,471p' apps/desktop/src/v2/workbench/api-client.test.tsx && cat apps/desktop/src/v2/workbench/request-presentation.test.ts\"","aggregated_output":"    it('colors one complete editable URL template without duplicating its base variable', async () => {\n        const url = '{{scm_base}}/profiles/{{profile_id}}?value=hello%20world'\n        const { requests, user, line } = await open(board(), (r) => r.kind === 'openRequest' ? document({ url }) : null)\n        const input = within(line()).getByRole('textbox', { name: 'URL' })\n        expect(input).toHaveValue(url)\n        const template = input.closest('[data-slot=\"template-input\"]') as HTMLElement\n        expect(template).not.toBeNull()\n        expect(template.querySelectorAll('[data-variable]')).toHaveLength(2)\n        expect(template.textContent).toBe(url)\n        await user.click(input)\n        await user.keyboard('{Control>}a{/Control}')\n        await user.copy()\n        expect(await navigator.clipboard.readText()).toBe(url)\n        await user.keyboard('{Meta>}s{/Meta}')\n        await waitFor(() => expect(requests.filter((r) => r.kind === 'save')).toHaveLength(1))\n        expect(requests.filter((r) => r.kind === 'save')[0]).toMatchObject({ fields: { url } })\n        await user.click(within(line()).getByRole('button', { name: 'Send' }))\n        expect(requests.filter((r) => r.kind === 'send').at(-1)).toMatchObject({ fields: { url } })\n    })\n\n    it('colors JSON while Save, Send, response Copy and Save Response keep the original text and run', async () => {\n        const raw = '{\\r\\n \"integer\":9007199254740993,\"escaped\":\"\\\\u0061\\\\/\"\\r\\n}\\r\\n'\n        const response = { ...ran, preview: raw, previewBytes: raw.length, record: { ...ran.record, bytes: raw.length } }\n        const { user, requests, line } = await open(board(), (r) => r.kind === 'openRequest' ? document({ bodyKind: 'json', body: raw }) : r.kind === 'send' ? { kind: 'ran', run: response } : r.kind === 'saveResponse' ? { kind: 'responseSaved', bytes: raw.length, name: 'chosen.json' } : null)\n        await user.click(within(screen.getByRole('tablist', { name: 'Request' })).getByRole('tab', { name: /^Body/ }))\n        const body = screen.getByRole('textbox', { name: 'Body' })\n        const colored = body.closest('[data-slot=\"json-body-editor\"]') as HTMLElement\n        expect(colored.querySelector('[data-json-token*=\"propertyName\"]')).not.toBeNull()\n        await user.click(within(line()).getByRole('button', { name: 'Save' }))\n        await waitFor(() => expect(requests.filter((r) => r.kind === 'save')).toHaveLength(1))\n        expect(requests.filter((r) => r.kind === 'save').at(-1)).toMatchObject({ fields: { body: raw } })\n        await user.click(within(line()).getByRole('button', { name: 'Send' }))\n        await waitFor(() => expect(requests.filter((r) => r.kind === 'send')).toHaveLength(1))\n        expect(requests.filter((r) => r.kind === 'send').at(-1)).toMatchObject({ fields: { body: raw } })\n        const pane = screen.getByRole('region', { name: 'Response pane' })\n        expect(within(pane).getByLabelText('Response body')).toHaveTextContent('9007199254740993')\n        await user.click(within(pane).getByRole('button', { name: 'Copy' }))\n        expect(await navigator.clipboard.readText()).toBe(raw)\n        await user.click(within(pane).getByRole('button', { name: 'Save response…' }))\n        await waitFor(() => expect(requests.filter((r) => r.kind === 'saveResponse')).toEqual([{ kind: 'saveResponse', run: response.record.id }]))\n        await user.clear(body)\n        await user.paste('{\"unfinished\":')\n        expect(body).toHaveValue('{\"unfinished\":')\n        await user.keyboard('{Meta>}s{/Meta}')\n        await waitFor(() => expect(requests.filter((r) => r.kind === 'save')).toHaveLength(2))\n        expect(requests.filter((r) => r.kind === 'save').at(-1)).toMatchObject({ fields: { body: '{\"unfinished\":' } })\n    })\n\n    it('ignores an earlier history selection that resolves after the newer selected response', async () => {\n        const { user, native, requests } = await open()\n        const observe = native.observeWorkbench\n        const release = new Map<string, () => void>()\n        native.observeWorkbench = (operation) => {\n            const request = requests[Number(operation.replace('op-', '')) - 1]\n            if (request?.kind === 'showRun') return new Promise((resolve) => release.set(request.run, () => { void Promise.resolve(observe(operation)).then(resolve) }))\n            return observe(operation)\n        }\n        const pane = screen.getByRole('region', { name: 'Response pane' })\n        await user.click(within(pane).getByRole('tab', { name: 'History' }))\n        const choices = await within(pane).findAllByRole('button', { name: /^GET topics\\/list/ })\n        await user.click(choices[1]!)\n        await user.click(choices[0]!)\n        await waitFor(() => expect(release.size).toBe(2))\n        await act(async () => { release.get(ran.record.id)!() })\n        await waitFor(() => expect(document_().querySelector('[data-slot=\"workbench-response-status\"]')).toHaveAttribute('data-run', ran.record.id))\n        await act(async () => { release.get(older.record.id)!() })\n        expect(document_().querySelector('[data-slot=\"workbench-response-status\"]')).toHaveAttribute('data-run', ran.record.id)\n        expect(document_().querySelector('[data-slot=\"workbench-response-status\"]')).not.toHaveTextContent('17 ms')\n    })\n\n    it('cannot replace the current collection footer with a previous collection send result sharing its request id', async () => {\n        let replacement = false\n        const current = { ...ran, record: { ...ran.record, id: 'run-0000000000001234', status: 201, elapsedMs: 7 } }\n        const { user, native, requests, line } = await open(board(), (r) => r.kind === 'openRequest' && replacement ? document({ url: 'https://other.invalid/current' }) : r.kind === 'send' ? { kind: 'ran', run: current } : null)\n        const observe = native.observeWorkbench\n        let release: (() => void) | null = null\n        native.observeWorkbench = (operation) => {\n            const request = requests[Number(operation.replace('op-', '')) - 1]\n            if (request?.kind === 'send' && !replacement) return new Promise((resolve) => { release = () => resolve({ kind: 'workbench', result: { kind: 'ran', run: ran } }) })\n            return observe(operation)\n        }\n        await user.click(within(line()).getByRole('button', { name: 'Send' }))\n        await waitFor(() => expect(release).not.toBeNull())\n        replacement = true\n        const next = board()\n        await native.push({ ...next, workbench: { ...next.workbench, collection: { ...next.workbench.collection!, scope: '4'.repeat(32) } } })\n        await waitFor(() => expect(within(line()).getByRole('textbox', { name: 'URL' })).toHaveValue('https://other.invalid/current'))\n        await user.click(within(line()).getByRole('button', { name: 'Send' }))\n        await waitFor(() => expect(document_().querySelector('[data-slot=\"workbench-response-status\"]')).toHaveAttribute('data-run', current.record.id))\n        await act(async () => { release!() })\n        expect(document_().querySelector('[data-slot=\"workbench-response-status\"]')).toHaveAttribute('data-run', current.record.id)\n        expect(document_().querySelector('[data-slot=\"workbench-response-status\"]')).toHaveTextContent('7 ms')\n        expect(document_().querySelector('[data-slot=\"workbench-response-status\"]')).not.toHaveTextContent('42 ms')\n    })\n\n    it('shows the displayed response metrics in the footer, including another request selected from history', async () => {\n        const historical = { ...older, record: { ...older.record, request: 'health', relative: 'health.request.toml', status: 204 } }\n        const { user, line } = await open(board(), (r) => r.kind === 'history' ? { kind: 'history', runs: [historical.record], more: false } : r.kind === 'showRun' ? { kind: 'ran', run: historical } : null)\n        const footer = document_().querySelector('[data-slot=\"api-footer\"]') as HTMLElement\n        await user.click(within(line()).getByRole('button', { name: 'Send' }))\n        await waitFor(() => expect(footer).toHaveTextContent('42 ms'))\n        expect(footer).toHaveTextContent('29 B')\n        expect(footer).toHaveTextContent('2 requests')\n        expect(line()).not.toHaveTextContent('42 ms')\n        const pane = screen.getByRole('region', { name: 'Response pane' })\n        await user.click(within(pane).getByRole('tab', { name: 'History' }))\n        await user.click(await within(pane).findByRole('button', { name: /^GET health/ }))\n        await waitFor(() => expect(footer).toHaveTextContent('17 ms'))\n        expect(footer).toHaveTextContent('20 B')\n        expect(footer).toHaveTextContent('health')\n        expect(footer).toHaveTextContent('History')\n        expect(footer).not.toHaveTextContent('42 ms')\n    })\n\n    it('keeps open request tabs on one horizontally scrolling row', async () => {\n        await open()\n        const tabs = screen.getByRole('tablist', { name: 'Open requests' })\n        expect(tabs).not.toHaveClass('flex-wrap')\n        expect(tabs).toHaveClass('overflow-x-auto')\n        expect(within(tabs).getByRole('tab', { selected: true }).closest('[data-request-tab]')).toHaveClass('shrink-0')\n    })\n\n    it('offers explicit restore recovery without automatically opening SCM or creating a missing collection', async () => {\n        const base = fxApi()\n        const closed = { ...base, workbench: { ...base.workbench, collection: null } }\n        const native = scriptedNative({ ...closed, workbench: { ...closed.workbench, loaded: false } })\n        const requests = workbench(native, answers((r) => r.kind === 'load' ? { kind: 'refused', problem: { kind: 'project', detail: 'notCollection' } } : null))\n        const user = userEvent.setup()\n        render(<App client={new DesktopClient(native.transport)} />)\n        await waitFor(() => expect(requests.filter((r) => r.kind === 'load')).toHaveLength(1))\n        await native.push(closed)\n        expect(await screen.findByText(/The preferred collection could not be opened/)).toBeInTheDocument()\n        await user.click(screen.getByRole('button', { name: 'Try again' }))\n        await waitFor(() => expect(requests.filter((r) => r.kind === 'load')).toHaveLength(2))\n        expect(screen.getByRole('button', { name: 'Open collection…' })).toBeInTheDocument()\n        expect(screen.getByRole('button', { name: 'Open Strata Cloud Manager' })).toBeInTheDocument()\n        await native.push(closed)\n        expect(requests.filter((r) => r.kind === 'load')).toHaveLength(2)\n        expect(requests.filter((r) => ['openBuiltIn', 'createCollection', 'openFolder'].includes(r.kind))).toHaveLength(0)\n    })\n\n    it.each(['missing', 'notCollection'] as const)('keeps %s preferred-folder recovery across Home and back until an explicit retry succeeds', async (detail) => {\n        const base = fxApi()\n        const closed = { ...base, workbench: { ...base.workbench, collection: null } }\n        const native = scriptedNative({ ...closed, workbench: { ...closed.workbench, loaded: false } })\n        let restored = false\n        let cancelled = false\n        const requests = workbench(native, answers((r) => r.kind === 'load'\n            ? cancelled ? { kind: 'cancelled' } : restored ? { kind: 'opened', name: 'AIRS' } : { kind: 'refused', problem: { kind: 'project', detail } }\n            : r.kind === 'openFolder' ? { kind: 'refused', problem: { kind: 'project', detail: 'io' } } : null))\n        const user = userEvent.setup()\n        render(<App client={new DesktopClient(native.transport)} />)\n        await waitFor(() => expect(requests.filter((r) => r.kind === 'load')).toHaveLength(1))\n        await native.push(closed)\n        expect(await screen.findByText(/The preferred collection could not be opened/)).toBeInTheDocument()\n        const navigate = async (feature: 'home' | 'apiClient', label: string) => {\n            await user.click(within(screen.getByRole('navigation', { name: 'Destinations' })).getByRole('button', { name: new RegExp(label) }))\n            expect(native.dispatched.at(-1)).toEqual({ kind: 'navigate', feature })\n            await native.push({ ...native.current, activeFeature: feature })\n            await screen.findByRole('heading', { level: 1, name: label })\n        }\n        await navigate('home', 'Home')\n        await navigate('apiClient', 'API Client')\n        expect(screen.getByText(/The preferred collection could not be opened/)).toBeInTheDocument()\n        expect(screen.getByRole('button', { name: 'Try again' })).toBeInTheDocument()\n        expect(requests.filter((r) => r.kind === 'load')).toHaveLength(1)\n        // A failed alternative is not a successful choice and must not dismiss recovery.\n        await user.click(screen.getByRole('button', { name: 'Open collection…' }))\n        await waitFor(() => expect(requests.filter((r) => r.kind === 'openFolder')).toHaveLength(1))\n        expect(screen.getByText(/The preferred collection could not be opened/)).toBeInTheDocument()\n        expect(screen.getByRole('button', { name: 'Try again' })).toBeInTheDocument()\n        await user.click(screen.getByRole('button', { name: 'Try again' }))\n        await waitFor(() => expect(requests.filter((r) => r.kind === 'load')).toHaveLength(2))\n        expect(screen.getByRole('button', { name: 'Try again' })).toBeInTheDocument()\n        cancelled = true\n        await user.click(screen.getByRole('button', { name: 'Try again' }))\n        await waitFor(() => expect(requests.filter((r) => r.kind === 'load')).toHaveLength(3))\n        expect(screen.getByRole('button', { name: 'Try again' })).toBeInTheDocument()\n        cancelled = false\n        restored = true\n        let releaseRestore: (() => void) | undefined\n        if (detail === 'notCollection') {\n            const observe = native.observeWorkbench\n            native.observeWorkbench = async (operation) => {\n                native.observeWorkbench = observe\n                const result = await observe(operation)\n                await new Promise<void>((resolve) => { releaseRestore = resolve })\n                return result\n            }\n        }\n        await user.click(screen.getByRole('button', { name: 'Try again' }))\n        await waitFor(() => expect(requests.filter((r) => r.kind === 'load')).toHaveLength(4))\n        // Both native orders: an opened snapshot may precede the load result.\n        if (detail === 'notCollection') {\n            await waitFor(() => expect(releaseRestore).toBeDefined())\n            await native.push(base)\n            await act(async () => { releaseRestore!() })\n        } else await native.push(base)\n        expect(screen.queryByText(/The preferred collection could not be opened/)).not.toBeInTheDocument()\n        expect(document_().querySelector('[data-slot=workbench-message]')).toBeNull()\n        // The explicit Close preference must remain closed on remount, rather than restoring the default.\n        await user.click(screen.getByRole('button', { name: 'Collection AIRS' }))\n        await user.click(screen.getByRole('menuitem', { name: 'Close collection' }))\n        await waitFor(() => expect(requests.filter((r) => r.kind === 'closeCollection')).toHaveLength(1))\n        await native.push(closed)\n        await navigate('home', 'Home')\n        await navigate('apiClient', 'API Client')\n        expect(screen.getByText('No collection is open.')).toBeInTheDocument()\n        expect(screen.queryByRole('button', { name: 'Try again' })).not.toBeInTheDocument()\n        expect(screen.queryByText(/The preferred collection could not be opened/)).not.toBeInTheDocument()\n        expect(requests.filter((r) => r.kind === 'load')).toHaveLength(4)\n        expect(requests.filter((r) => ['openBuiltIn', 'createCollection'].includes(r.kind))).toHaveLength(0)\n        expect(requests.filter((r) => r.kind === 'openFolder')).toHaveLength(1)\n    })\n\n    it('settles an in-flight restore after remount without duplicate loads and ignores its reply after context retirement', async () => {\n        const base = fxApi()\n        const closed = { ...base, workbench: { ...base.workbench, collection: null } }\n        const native = scriptedNative({ ...closed, workbench: { ...closed.workbench, loaded: false } })\n        const requests = workbench(native, answers((r) => r.kind === 'load' ? { kind: 'refused', problem: { kind: 'project', detail: 'missing' } } : null))\n        const observe = native.observeWorkbench\n        let release: (() => void) | undefined\n        native.observeWorkbench = async (operation) => {\n            const result = await observe(operation)\n            await new Promise<void>((resolve) => { release = resolve })\n            return result\n        }\n        const user = userEvent.setup()\n        render(<App client={new DesktopClient(native.transport)} />)\n        await waitFor(() => expect(release).toBeDefined())\n        await native.push({ ...native.current, activeFeature: 'home' })\n        await native.push({ ...native.current, activeFeature: 'apiClient' })\n        expect(requests.filter((r) => r.kind === 'load')).toHaveLength(1)\n        await native.push(closed)\n        await act(async () => { release!() })\n        expect(await screen.findByText(/The preferred collection could not be opened/)).toBeInTheDocument()\n        release = undefined\n        await user.click(screen.getByRole('button', { name: 'Try again' }))\n        await waitFor(() => expect(release).toBeDefined())\n        const next = { ...closed, active: { ...closed.active!, context: `cx-${'b'.repeat(24)}` } }\n        await native.push({ ...next, activeFeature: 'home' })\n        await native.push(next)\n        await act(async () => { release!() })\n        expect(screen.getByText('No collection is open.')).toBeInTheDocument()\n        expect(screen.queryByRole('button', { name: 'Try again' })).not.toBeInTheDocument()\n        expect(screen.queryByText(/The preferred collection could not be opened/)).not.toBeInTheDocument()\n        expect(requests.filter((r) => r.kind === 'load')).toHaveLength(2)\n    })\n\nimport { describe, expect, it } from 'vitest'\nimport { prettyJson } from './request-rows'\n\ndescribe('API JSON presentation preserves JSON tokens', () => {\n    it('indents without rounding large numbers or rewriting string escapes', () => {\n        const raw = '{\"integer\":9007199254740993,\"decimal\":1.2300e+50,\"escaped\":\"\\\\u0061\\\\/\",\"duplicate\":1,\"duplicate\":2}'\n        const shown = prettyJson(raw)\n        expect(shown).toContain('9007199254740993')\n        expect(shown).toContain('1.2300e+50')\n        expect(shown).toContain('\"\\\\u0061\\\\/\"')\n        expect(shown?.match(/\"duplicate\"/g)).toHaveLength(2)\n        expect(raw).toBe('{\"integer\":9007199254740993,\"decimal\":1.2300e+50,\"escaped\":\"\\\\u0061\\\\/\",\"duplicate\":1,\"duplicate\":2}')\n    })\n\n    it('rejects invalid or truncated JSON instead of presenting a repaired response', () => {\n        for (const raw of ['', '  \\n', '{\"x\":', '{\"x\":1,}', 'true false', '[1,', '{\"x\":\"unterminated']) expect(prettyJson(raw)).toBeNull()\n    })\n\n    it('formats empty/nested containers and primitive values without changing their tokens', () => {\n        expect(prettyJson('[{},[],true,false,null,-0,1e3,\"a b\"]')).toBe('[\\n  {},\\n  [],\\n  true,\\n  false,\\n  null,\\n  -0,\\n  1e3,\\n  \"a b\"\\n]')\n        expect(prettyJson('  \"\\\\u0061\"  ')).toBe('\"\\\\u0061\"')\n    })\n\n    it('falls back to raw presentation for excessively large or deeply nested previews', () => {\n        expect(prettyJson(JSON.stringify('x'.repeat(256 * 1024)))).toBeNull()\n        expect(prettyJson('['.repeat(65) + '0' + ']'.repeat(65))).toBeNull()\n    })\n})\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_23","type":"agent_message","text":"The recovery fix now keeps the warning and Retry action across navigation, with guards against stale replies. Focused tests and native recovery observations cover that change. I’m checking collection persistence, footer ownership, exact export bytes and the evidence carry rules for the remaining C48 flows."}}
{"type":"item.started","item":{"id":"item_24","type":"command_execution","command":"/bin/zsh -lc \"cat apps/desktop/src/app.tsx && cat apps/desktop/src/modules/workbench/workbench-call.ts | head -100 && rg -n 'response_name|suggested|response.json|SaveResponse' crates/desktop-core/src/authority/workbench_domain* crates/desktop-core/src/workbench apps/desktop/src-tauri/src/adapters.rs && rg -n 'fn |selection|missing|replaced|startup|response|suggest' crates/desktop-core/tests/workbench_persistence.rs crates/desktop-core/tests/workbench_persistence/* crates/desktop-core/tests/ui_v2_workbench/*\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_24","type":"command_execution","command":"/bin/zsh -lc \"cat apps/desktop/src/app.tsx && cat apps/desktop/src/modules/workbench/workbench-call.ts | head -100 && rg -n 'response_name|suggested|response.json|SaveResponse' crates/desktop-core/src/authority/workbench_domain* crates/desktop-core/src/workbench apps/desktop/src-tauri/src/adapters.rs && rg -n 'fn |selection|missing|replaced|startup|response|suggest' crates/desktop-core/tests/workbench_persistence.rs crates/desktop-core/tests/workbench_persistence/* crates/desktop-core/tests/ui_v2_workbench/*\"","aggregated_output":"import { useCallback, useEffect, useLayoutEffect, useRef, useState } from 'react'\nimport {\n    DeliveryOutcomeUnknown,\n    type DesktopClient,\n    type FeatureId,\n    type Intent,\n    type MenuCommand,\n    type Refusal,\n    type ShellSnapshot,\n    type Theme,\n} from '@prisma-airs/desktop-contracts'\nimport { followAppearance } from './shell/appearance'\nimport { type DispatchOutcome, outcomeMessage } from './modules/tenants/dispatch'\nimport { V2Shell } from './v2/v2-shell'\nimport { Wizard } from './v2/wizard/wizard'\nimport { deliveryContext, useShellStore } from './v2/store'\nimport { SHELL_COPY } from './v2/copy'\nimport { forgetAcademyPresentation } from './modules/academy/presentation-storage'\nimport { SAVE_DOCUMENT_EVENT } from './v2/workbench/request-editor'\n\nexport function App({ client }: { client: DesktopClient }) {\n    const [snapshot, setSnapshot] = useState<ShellSnapshot | null>(null)\n    const snapshotRef = useRef<ShellSnapshot | null>(null)\n    snapshotRef.current = snapshot\n    const [failure, setFailure] = useState<string | null>(null)\n    const [pending, setPending] = useState(false)\n    const [status, setStatus] = useState('')\n\n    const dispatch = useCallback(\n        async (intent: Intent): Promise<DispatchOutcome> => {\n            try {\n                const response = await client.dispatch(intent)\n                return response.outcome === 'refusal'\n                    ? { kind: 'refused', refusal: response.refusal }\n                    : { kind: 'admitted', operation: response.receipt.operation }\n            } catch (error) {\n                return error instanceof DeliveryOutcomeUnknown ? { kind: 'unknown' } : { kind: 'failed' }\n            }\n        },\n        [client]\n    )\n\n    // v2 (C28): navigation is Rust-owned. The native menu, the sidebar and\n    // the palette all dispatch `navigate`; refusals reach the status surface.\n    const v2Navigate = useCallback(\n        async (feature: FeatureId) => {\n            useShellStore.getState().closePalette()\n            const intent: Intent = { kind: 'navigate', feature }\n            const outcome = await dispatch(intent)\n            if (outcome.kind === 'refused') useShellStore.getState().toast(SHELL_COPY.toastRefused('Navigation', outcome.refusal), 'warn')\n            // Unknown delivery is kept inline with Retry; never an expiring toast alone.\n            else if (outcome.kind === 'unknown') useShellStore.getState().addUnconfirmed('Navigation', intent)\n            else if (outcome.kind === 'failed') useShellStore.getState().toast(SHELL_COPY.toastFailed('Navigation'), 'warn')\n        },\n        [dispatch]\n    )\n    // Every v2 action's outcome reaches the shell's surfaces (DESIGN-V2 §7):\n    // a refusal or failed delivery as a warn toast naming what was asked, an\n    // unconfirmed delivery inline with Retry, never replayed on its own.\n    const v2Act = useCallback(\n        async (what: string, intent: Intent, quiet: Refusal[] = []): Promise<DispatchOutcome> => {\n            // A context-bound action speaks for the tenant it was sent in (I2).\n            const boundContext = deliveryContext(intent)\n            // A normal switch refusal still names its intended destination,\n            // but an uncertain switch must not offer Retry in another scope.\n            const retryContext = boundContext ?? (intent.kind === 'selectTenant' ? snapshotRef.current?.active?.context ?? null : null)\n            const bound = boundContext !== null ? (snapshotRef.current?.active?.tenant ?? null) : null\n            const outcome = await dispatch(intent)\n            if (outcome.kind === 'refused' && quiet.includes(outcome.refusal)) return outcome\n            if (outcome.kind === 'refused') useShellStore.getState().toast(SHELL_COPY.toastRefused(what, outcome.refusal, outcomeMessage(outcome)), 'warn', undefined, bound, boundContext)\n            else if (outcome.kind === 'unknown') useShellStore.getState().addUnconfirmed(what, intent, retryContext)\n            else if (outcome.kind === 'failed') useShellStore.getState().toast(SHELL_COPY.toastFailed(what), 'warn', undefined, bound, boundContext)\n            return outcome\n        },\n        [dispatch]\n    )\n    const v2Preference = useCallback(\n        async (what: string, intent: Intent, quiet: Refusal[] = []) => {\n            await v2Act(what, intent, quiet)\n        },\n        [v2Act]\n    )\n\n    const onMenu = useRef<(command: MenuCommand) => void>(() => undefined)\n    onMenu.current = (command: MenuCommand) => {\n        // Native navigation dismisses the modal palette first so focus can\n        // move to the new page heading instead of behind an open dialog.\n        if (command.kind === 'navigate') void v2Navigate(command.feature)\n        else if (command.kind === 'commandPalette') useShellStore.getState().openPalette()\n        // ⌘T: the tenant switcher opens; nothing switches until chosen.\n        else if (command.kind === 'tenantSwitcher') useShellStore.getState().setSwitcher(true)\n        // The open API Client request saves (its editor listens).\n        else if (command.kind === 'saveDocument') window.dispatchEvent(new Event(SAVE_DOCUMENT_EVENT))\n        else void v2Preference('The appearance change', { kind: 'setAppearance', theme: command.theme })\n    }\n\n    useEffect(() => {\n        let stop: (() => void) | undefined\n        let cancelled = false\n        client\n            .observeShell({\n                onSnapshot: (next) => {\n                    // The shell's scope follows the snapshot before it renders: a\n                    // notification for another tenant or context is never surfaced.\n                    useShellStore.getState().setScope(next.active?.tenant ?? null, next.active?.context ?? null, next.switchBlocked?.review ?? null)\n                    useShellStore.getState().observeWorkbench(next.active?.tenant ?? null, next.active?.context ?? null, next.workbench.collection?.scope ?? null)\n                    setSnapshot(next)\n                },\n                onMenu: (command) => onMenu.current(command),\n                onError: () => setFailure('The desktop sent an unexpected update.'),\n            })\n            .then(\n                (unsubscribe) => {\n                    if (cancelled) unsubscribe()\n                    else stop = unsubscribe\n                },\n                () => setFailure('The desktop shell could not be observed.')\n            )\n        return () => {\n            cancelled = true\n            stop?.()\n        }\n    }, [client])\n\n    // A completed reset also forgets Academy's WebView presentation state\n    // (completion latches keyed by account); a stopped reset keeps it.\n    const storage = snapshot?.storage\n    const resetFailed = Boolean(snapshot?.resetFailure)\n    const previousStorage = useRef(storage)\n    useEffect(() => {\n        if (previousStorage.current === 'resetting' && storage !== 'resetting' && !resetFailed) {\n            forgetAcademyPresentation()\n        }\n        previousStorage.current = storage\n    }, [storage, resetFailed])\n\n    const appearance = snapshot?.appearance\n    const colorTheme = snapshot?.colorTheme\n    // Apply the theme in the same commit as the snapshot, before paint, so\n    // the shell never shows a frame in the previous theme.\n    useLayoutEffect(() => (appearance ? followAppearance(appearance, colorTheme) : undefined), [appearance, colorTheme])\n\n    if (failure && !snapshot) {\n        return (\n            <main role='alert' className='text-academy-ink p-8'>\n                {failure}\n            </main>\n        )\n    }\n    if (!snapshot) {\n        return (\n            <main role='status' aria-live='polite' className='text-academy-ink-soft p-8'>\n                Starting Prisma AIRS Desktop…\n            </main>\n        )\n    }\n    if (snapshot.onboarding !== 'done') {\n        // First run: the wizard owns the window (D060: no alpha import; nothing leaves it before a tenant exists).\n        return (\n            <div data-v2-shell=''>\n                <Wizard\n                    snapshot={snapshot}\n                    dispatch={dispatch}\n                    observeManagement={(operation) => client.observeManagement(operation)}\n                    mode='firstRun'\n                    onClose={() => undefined}\n                    onNavigate={(feature) => void v2Navigate(feature)}\n                />\n            </div>\n        )\n    }\n    return (\n        <V2Shell\n            snapshot={snapshot}\n            appearancePending={pending}\n            status={failure ?? status}\n            onNavigate={(feature) => void v2Navigate(feature)}\n            onSetAppearance={(theme) => void v2Preference('The appearance change', { kind: 'setAppearance', theme })}\n            onSetShowCalls={(on) => void v2Preference('The preference change', { kind: 'setShowCalls', on })}\n            onSwitchTenant={(tenant, resolution) => {\n                // The target is captured now: a late refusal still names it. A\n                // pending-decision refusal is not a toast: the snapshot carries\n                // the guard the shell renders (I1).\n                const label = snapshot.tenants.find((t) => t.id === tenant)?.label ?? tenant\n                void v2Preference(SHELL_COPY.switchTo(label), { kind: 'selectTenant', tenant, resolution: resolution ?? null }, ['decisionPending'])\n            }}\n            onReadNow={() => {\n                // The palette's Read now is the same finite read of every chosen product (I4).\n                const active = snapshot.active\n                if (!active) return\n                const label = snapshot.tenants.find((t) => t.id === active.tenant)?.label ?? active.tenant\n                void v2Preference(SHELL_COPY.readOf(label), { kind: 'readTenant', context: active.context })\n            }}\n            onRetry={(what, intent) => void v2Preference(what, intent)}\n            onAct={v2Act}\n            dispatch={dispatch}\n            client={client}\n        />\n    )\n}\nimport type {\n    ExportFailure,\n    FieldProblem,\n    RenderProblem,\n    RunFailure,\n    RunRecord,\n    SaveRefusal,\n    SendRefusal,\n    WorkbenchProblem,\n    WorkbenchRequest,\n    WorkbenchResult,\n} from '@prisma-airs/desktop-contracts'\nimport { type Dispatch, outcomeMessage } from '../tenants/dispatch'\n\n/** Waits for the single result of an admitted API Client request. */\nexport type ObserveWorkbench = (operation: string) => Promise<WorkbenchResult>\n\n/** One API Client request: its result, or why it never ran. */\nexport type WorkbenchCall = (request: WorkbenchRequest) => Promise<WorkbenchResult | { kind: 'undelivered'; message: string }>\n\nexport function workbenchCall(dispatch: Dispatch, observe: ObserveWorkbench): WorkbenchCall {\n    return async (request) => {\n        const outcome = await dispatch({ kind: 'workbench', request })\n        if (outcome.kind !== 'admitted' || outcome.operation === null) {\n            return { kind: 'undelivered', message: outcomeMessage(outcome) ?? 'The request could not be delivered.' }\n        }\n        try {\n            return await observe(outcome.operation)\n        } catch {\n            return { kind: 'undelivered', message: 'The desktop did not report how the request ended. Check the request before trying again.' }\n        }\n    }\n}\n\nconst FIELD_TEXT: Record<FieldProblem['field'], string> = {\n    method: 'Method: use letters and hyphens only',\n    url: 'URL: enter one line',\n    headers: 'Headers: use Name: value',\n    query: 'Params: use name=value',\n    body: 'Body: this body cannot be written as text here',\n    bodyKind: 'Body kind',\n    settings: 'Auth and variables: only [auth] with references and [variables] are written',\n}\n\nexport function fieldText(problem: FieldProblem): string {\n    return problem.line === null ? FIELD_TEXT[problem.field] : `${FIELD_TEXT[problem.field]} (line ${problem.line})`\n}\n\nconst REFUSAL_TEXT: Record<Exclude<SaveRefusal['kind'], 'invalid'>, string> = {\n    conflict: 'Changed on disk since you opened it. Choose Use disk or Keep mine; both versions are kept privately first.',\n    incomplete: 'The collection changed or has problems to fix before saving.',\n    moved: 'This request was moved to another file. Reopen the collection.',\n    sharedBody: 'Another request now uses this body file; it was not changed.',\n    interrupted: 'An earlier save of this request was interrupted. Choose Use disk or Keep mine before saving.',\n    exists: 'A file already exists at this path; nothing was replaced.',\n    io: 'The files could not be written. Your edits are kept on this Mac.',\n}\n\nexport function saveRefusalText(refusal: SaveRefusal): string {\n    return refusal.kind === 'invalid' ? `Fix to save. ${fieldText(refusal.problem)}.` : REFUSAL_TEXT[refusal.kind]\n}\n\nconst DETAIL_TEXT: Record<string, string> = {\n    notCollection: \"That folder isn't empty and has no API Client collection (collection.toml). Choose an empty folder or a collection folder.\",\n    badPath: 'Use a path inside the collection: folder/name, no leading dot, slash or \"..\".',\n    exists: 'Something already exists there; nothing was replaced.',\n    notInRepository: 'Create a collection inside an existing Git repository.',\n    incomplete: 'Fix the collection problems listed first.',\n    missing: 'That file is missing.',\n    tooLarge: 'That file is larger than the limit.',\n    io: 'The file could not be read or written.',\n    locked: 'The Keychain is locked. Unlock it and try again.',\n    denied: 'macOS denied Keychain access.',\n    unavailable: 'Private API Client storage is unavailable.',\n    unreadable: 'Saved private API Client data did not open; it was kept aside.',\n    notText: 'Schemas are JSON or YAML text up to 4 MiB.',\n    conflict: 'Changed on disk since it was opened; reopen it.',\n    version: 'Only Insomnia v5 exports (schema 5.1) are supported.',\n    structure: 'The export has fields this import does not take.',\n    limit: 'The export has more resources or nesting than the import takes.',\n}\n\nconst CURL_TEXT: Record<string, string> = {\n    tooLarge: 'The command is larger than 1 MiB.',\n    notCurl: 'Paste one command that begins with curl.',\n    shell: 'Shell expansion, operators and comments are not supported; quote literal values.',\n    unclosed: 'A quote or escape is not closed.',\n    tooManyWords: 'The command has too many arguments.',\n    unsupportedOption: 'The command uses an option this import does not support.',\n    missingArgument: 'An option is missing its value.',\n    url: 'Give exactly one absolute http(s) URL.',\n    urlCredentials: 'Move credentials out of the URL before importing.',\n    queryCredentials: 'Move credential query parameters to a secret before importing.',\n    glob: 'URL glob expressions are not supported.',\n    template: 'Template syntax is not imported; add variables after conversion.',\n    bodyCredentials: 'The body has credential-named fields; remove them before importing.',\n    json: '--json data must be valid JSON.',\n    header: 'Headers must be single-line Name: value with a value.',\n    external: 'Files, stdin and interactive prompts are not supported.',\n    combination: 'These options cannot be combined.',\napps/desktop/src-tauri/src/adapters.rs:237:        fn choose_save(&self, suggested: String) -> BoxFuture<'static, Option<PathBuf>> {\napps/desktop/src-tauri/src/adapters.rs:239:                self.1.choose_save(suggested)\napps/desktop/src-tauri/src/adapters.rs:258:    /// Save a response body under a suggested name (the panel confirms\napps/desktop/src-tauri/src/adapters.rs:301:    fn choose_save(&self, suggested: String) -> BoxFuture<'static, Option<PathBuf>> {\napps/desktop/src-tauri/src/adapters.rs:302:        self.sheet(Sheet::Save(suggested))\napps/desktop/src-tauri/src/adapters.rs:452:            suggested: String,\napps/desktop/src-tauri/src/adapters.rs:456:                self.2.save(suggested, bytes)\napps/desktop/src-tauri/src/adapters.rs:458:                self.1.save(suggested, bytes)\napps/desktop/src-tauri/src/adapters.rs:639:            suggested: String,\napps/desktop/src-tauri/src/adapters.rs:647:                    write_owner_only(&dir.join(&suggested), &bytes, false)?;\napps/desktop/src-tauri/src/adapters.rs:648:                    Ok(Some(suggested))\napps/desktop/src-tauri/src/adapters.rs:703:        suggested: String,\napps/desktop/src-tauri/src/adapters.rs:710:            let extension = if suggested.ends_with(\".csv\") {\napps/desktop/src-tauri/src/adapters.rs:719:                    .set_file_name(&suggested)\ncrates/desktop-core/src/authority/workbench_domain.rs:157:    SaveResponse {\ncrates/desktop-core/src/authority/workbench_domain.rs:365:    SaveResponseFailed {\ncrates/desktop-core/src/authority/workbench_domain.rs:1056:        WorkbenchRequest::SaveResponse { run } => send::save_response(inner, &root, run).await,\ncrates/desktop-core/src/authority/workbench_domain/send.rs:1673:        return WorkbenchResult::SaveResponseFailed {\ncrates/desktop-core/src/authority/workbench_domain/send.rs:1687:    let suggested = format!(\"{name}-response.{}\", if json { \"json\" } else { \"txt\" });\ncrat