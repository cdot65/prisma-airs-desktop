{"type":"item.completed","item":{"id":"item_18","type":"command_execution","command":"/bin/zsh -lc \"sed -n '650,885p' crates/desktop-core/src/authority/workbench_domain.rs && sed -n '1320,1505p' crates/desktop-core/src/authority/workbench_domain.rs && sed -n '90,350p' apps/desktop/src/v2/workbench/request-editor.tsx && sed -n '95,140p' apps/desktop/src/v2/workbench/response-pane.tsx\"","aggregated_output":"            } else {\n                true\n            }\n        });\n    }\n\n    pub(super) fn observe_workbench(\n        &mut self,\n        operation: &OperationId,\n    ) -> Result<WorkbenchHandle, Refusal> {\n        let call = self\n            .workbench\n            .calls\n            .iter_mut()\n            .find(|c| &c.operation == operation && !c.observed)\n            .ok_or(Refusal::InvalidInput)?;\n        call.observed = true;\n        let handle = WorkbenchHandle(Arc::clone(&call.cell));\n        if call.settled {\n            self.prune_workbench_calls();\n        }\n        Ok(handle)\n    }\n\n    /// Edits that are not protected on this Mac (the close guard asks).\n    pub(super) fn workbench_unprotected(&self) -> bool {\n        !self.workbench.editing.is_empty()\n            || self\n                .workbench\n                .open\n                .as_ref()\n                .is_some_and(|o| o.unsaved.is_some() && !o.data.drafts.is_empty())\n    }\n\n    pub(super) fn workbench_view(&self) -> WorkbenchView {\n        let w = &self.workbench;\n        let collection = w.open.as_ref().map(|o| {\n            let tabs = o\n                .data\n                .open\n                .iter()\n                .filter_map(|id| {\n                    let doc = o.documents.get(id);\n                    let (relative, method, new) = match (doc, o.entry(id)) {\n                        (Some(d), _) => (\n                            d.relative.clone(),\n                            o.data.drafts.get(id).map_or_else(\n                                || d.saved.method.clone(),\n                                |dr| dr.fields.method.clone(),\n                            ),\n                            d.new,\n                        ),\n                        (None, Some(e)) => (e.relative.clone(), e.method.clone(), false),\n                        (None, None) => return None,\n                    };\n                    Some(TabView {\n                        id: id.clone(),\n                        relative,\n                        method,\n                        draft: o.data.drafts.contains_key(id),\n                        new,\n                        recovered: o.recovered.contains(id),\n                        conflict: o.conflicts.get(id).copied(),\n                        interrupted: o.interrupted.contains(id),\n                    })\n                })\n                .collect();\n            let profile = w.profile.as_ref();\n            let mut references: BTreeSet<String> = profile\n                .map(|p| {\n                    p.secrets\n                        .iter()\n                        .filter(|(c, _)| c == &o.catalog.id)\n                        .map(|(_, r)| r.clone())\n                        .collect()\n                })\n                .unwrap_or_default();\n            let mut texts: Vec<&str> = o.data.private.values().map(String::as_str).collect();\n            let settings: Vec<String> = o\n                .documents\n                .values()\n                .map(|d| {\n                    o.data\n                        .drafts\n                        .get(&d.id)\n                        .map_or_else(|| d.saved.settings.clone(), |dr| dr.fields.settings.clone())\n                })\n                .collect();\n            texts.extend(settings.iter().map(String::as_str));\n            references.extend(environments::references(&texts));\n            references.extend(o.catalog.references.iter().cloned());\n            let secrets = references\n                .into_iter()\n                .map(|reference| SecretView {\n                    stored: profile.is_some_and(|p| {\n                        p.secrets\n                            .iter()\n                            .any(|(c, r)| c == &o.catalog.id && r == &reference)\n                    }),\n                    managed: reference.starts_with(scm::MANAGED_PREFIX),\n                    reference,\n                })\n                .collect();\n            CollectionView {\n                id: o.catalog.id.clone(),\n                name: o.catalog.name.clone(),\n                folder: folder_name(&o.root),\n                scope: profile::scope(&o.root, &o.catalog.id),\n                built_in: o.built_in,\n                complete: o.catalog.complete,\n                requests: o.catalog.requests.clone(),\n                folders: o.catalog.folders.clone(),\n                schemas: o.catalog.schemas.clone(),\n                issues: o.catalog.issues.iter().take(200).cloned().collect(),\n                environments: o.environments(),\n                environment: o.data.environment.clone(),\n                tabs,\n                selected: o.data.selected.clone(),\n                secrets,\n                unsaved: o.unsaved,\n                archives: u32::try_from(o.data.archives.len()).unwrap_or(u32::MAX),\n            }\n        });\n        WorkbenchView {\n            available: self.workbench_root.is_some(),\n            loaded: w.profile.is_some() || w.failure.is_some(),\n            failure: w.failure,\n            recent: w\n                .profile\n                .as_ref()\n                .map(|p| {\n                    // An import's collections show once it commits (D050).\n                    p.recent\n                        .iter()\n                        .enumerate()\n                        .map(|(i, r)| RecentView {\n                            index: u32::try_from(i).unwrap_or(u32::MAX),\n                            name: r.name.clone(),\n                            folder: folder_name(&r.root),\n                        })\n                        .collect()\n                })\n                .unwrap_or_default(),\n            collection,\n            import: w.import.as_ref().map(insomnia::Export::view),\n            git: w.git.clone(),\n            busy: w.calls.iter().any(|c| !c.settled && !c.later),\n            unprotected: self.workbench_unprotected(),\n            running: w.sending.running(),\n            review: w.sending.review(),\n            network: self.workbench_network,\n        }\n    }\n}\n\n// ----------------------------------------------------------------- worker\n\nasync fn blocking<T: Send + 'static>(fallback: T, f: impl FnOnce() -> T + Send + 'static) -> T {\n    tokio::task::spawn_blocking(f).await.unwrap_or(fallback)\n}\n\n/// Runs one admitted request in its turn on the lane and settles it.\npub(super) async fn run(inner: Arc<Inner>, operation: OperationId, request: WorkbenchRequest) {\n    let Some(lane) = lock(&inner).ok().map(|s| Arc::clone(&s.workbench.lane)) else {\n        return;\n    };\n    let step = {\n        let _turn = lane.lock().await;\n        match request {\n            WorkbenchRequest::Send { .. } | WorkbenchRequest::Apply { .. } => {\n                let page = lock(&inner).ok().and_then(|s| {\n                    s.workbench\n                        .calls\n                        .iter()\n                        .find(|c| c.operation == operation)\n                        .map(|c| c.page.clone())\n                });\n                match page {\n                    Some(page) => send::begin(&inner, request, page).await,\n                    None => send::Step::Done(Box::new(refused(WorkbenchProblem::Unavailable))),\n                }\n            }\n            other => send::Step::Done(Box::new(execute(&inner, other).await)),\n        }\n    };\n    let result = match step {\n        send::Step::Done(result) => *result,\n        send::Step::Later(work) => {\n            if let Ok(mut state) = lock(&inner) {\n                if let Some(call) = state\n                    .workbench\n                    .calls\n                    .iter_mut()\n                    .find(|c| c.operation == operation)\n                {\n                    call.later = true;\n                }\n                state.changed();\n            }\n            work.await\n        }\n    };\n    if let Ok(mut state) = lock(&inner) {\n        state.settle_workbench(&operation, result);\n        state.changed();\n    }\n}\n\nasync fn execute(inner: &Arc<Inner>, request: WorkbenchRequest) -> WorkbenchResult {\n    let Some(root) = inner.adapters.workbench_root.clone() else {\n        return refused(WorkbenchProblem::Unavailable);\n    };\n    let profile = match ensure_profile(inner, &root).await {\n        Ok(p) => p,\n        Err(problem) => return refused(problem),\n    };\n    match request {\n        WorkbenchRequest::Load => {\n            // Load runs on initial entry, not whenever a collection closes.\n            // An explicit retry may repeat a failed restore, without opening\n            // a different collection or creating a missing custom folder.\n            if lock(inner).is_ok_and(|s| s.workbench.open.is_some()) {\n                return WorkbenchResult::Done;\n            }\n            match profile.selection.clone() {\n                None | Some(Selection::BuiltIn) => open_built_in(inner, &root, profile).await,\n                Some(Selection::Custom { root: folder, id }) => {\n                    open_at(inner, &root, folder, false, Some(id)).await\n                }\n                Some(Selection::Closed) => WorkbenchResult::Done,\n            }\n        }\n        WorkbenchRequest::OpenFolder => match inner.adapters.folders.choose_folder().await {\n            Some(folder) => {\n                // D057: an empty folder becomes a new collection in place;\n                // any other folder without collection.toml stays refused.\n                root,\n                &project::relative_path(&doc.relative, false)?,\n                project::METADATA_BYTES,\n            )\n            .ok()\n            .flatten()\n            .is_none() =>\n        {\n            Some(ConflictKind::Deleted)\n        }\n        _ => Some(ConflictKind::Changed),\n    }\n}\n\nfn read_opening(\n    private: &std::path::Path,\n    keychain: &dyn crate::vault::Vault,\n    folder: &std::path::Path,\n    expected_id: Option<&str>,\n) -> Result<Opening, WorkbenchProblem> {\n    let catalog = project::discover(folder).map_err(WorkbenchProblem::Project)?;\n    if expected_id.is_some_and(|id| id != catalog.id || catalog.root.as_path() != folder) {\n        return Err(WorkbenchProblem::Project(ProjectProblem::NotCollection));\n    }\n    let scope = profile::scope(&catalog.root, &catalog.id);\n    let mut data =\n        profile::load_scope(private, keychain, &scope).map_err(WorkbenchProblem::Private)?;\n    let journal =\n        profile::load_journal(private, keychain, &scope).map_err(WorkbenchProblem::Private)?;\n    let mut interrupted = BTreeSet::new();\n    let mut completed = BTreeSet::new();\n    let mut pending = Vec::new();\n    for entry in journal {\n        match profile::journal_state(&catalog.root, &entry) {\n            profile::JournalState::Interrupted => {\n                interrupted.insert(entry.request.clone());\n                pending.push(entry);\n            }\n            profile::JournalState::Completed => {\n                completed.insert(entry.request.clone());\n            }\n            profile::JournalState::NotStarted => {}\n        }\n    }\n    profile::store_journal(private, keychain, &scope, &pending)\n        .map_err(WorkbenchProblem::Private)?;\n    let mut documents = BTreeMap::new();\n    let mut conflicts = BTreeMap::new();\n    let drafts = std::mem::take(&mut data.drafts);\n    for (id, mut draft) in drafts {\n        // A save that completed before the journal was cleared: its files\n        // are the new baseline; the draft's fields stay as edits.\n        if completed.contains(&id)\n            && let Some(entry) = catalog.requests.iter().find(|r| r.id == id)\n            && let Ok(fresh) = document::open(&catalog.root, entry)\n        {\n            // Save protects its snapshot first: one fully written leaves a\n            // draft equal to the files, which is no edit.\n            if !fresh.dirty(&draft.fields) {\n                continue;\n            }\n            draft.document = fresh;\n        }\n        if let Some(kind) = conflict_of(&catalog.root, &draft.document) {\n            conflicts.insert(id.clone(), kind);\n        }\n        documents.insert(id.clone(), draft.document.clone());\n        data.drafts.insert(id, draft);\n    }\n    // Tabs naming nothing that exists any more are dropped.\n    data.open\n        .retain(|id| documents.contains_key(id) || catalog.requests.iter().any(|r| &r.id == id));\n    if data\n        .selected\n        .as_ref()\n        .is_some_and(|s| !data.open.contains(s))\n    {\n        data.selected = data.open.last().cloned();\n    }\n    Ok(Opening {\n        catalog,\n        data,\n        documents,\n        conflicts,\n        interrupted,\n        scope,\n    })\n}\n\nasync fn open_at(\n    inner: &Arc<Inner>,\n    root: &std::path::Path,\n    folder: PathBuf,\n    built_in: bool,\n    expected_id: Option<String>,\n) -> WorkbenchResult {\n    let keychain = Arc::clone(&inner.adapters.keychain);\n    let private = root.to_path_buf();\n    let opened = blocking(Err(WorkbenchProblem::Unavailable), move || {\n        read_opening(&private, keychain.as_ref(), &folder, expected_id.as_deref())\n    })\n    .await;\n    let opening = match opened {\n        Ok(o) => o,\n        Err(p) => return refused(p),\n    };\n    let name = opening.catalog.name.clone();\n    let recent = Recent {\n        root: opening.catalog.root.clone(),\n        id: opening.catalog.id.clone(),\n        name: name.clone(),\n    };\n    let profile = lock(inner).ok().and_then(|s| s.workbench.profile.clone());\n    if let Some(mut next) = profile {\n        next.selection = Some(if built_in {\n            Selection::BuiltIn\n        } else {\n            Selection::Custom {\n                root: recent.root.clone(),\n                id: recent.id.clone(),\n            }\n        });\n        if !built_in {\n            next.remember(recent);\n        }\n        if let Err(f) = store_profile(inner, root, next).await {\n            return refused(WorkbenchProblem::Private(f));\n        }\n    }\n    {\n        let Ok(mut state) = lock(inner) else {\n            return refused(WorkbenchProblem::Unavailable);\n        };\n        state.workbench.editing.clear();\n        state.workbench.sending.leave();\n        state.workbench.git = None;\n        state.workbench.import = None;\n        state.workbench.open = Some(Open {\n            root: opening.catalog.root.clone(),\n            recovered: opening.documents.keys().cloned().collect(),\n            scope: opening.scope,\n            built_in,\n            catalog: opening.catalog,\n            data: opening.data,\n            unsaved: None,\n            documents: opening.documents,\n            conflicts: opening.conflicts,\n            interrupted: opening.interrupted,\n        });\n    }\n    WorkbenchResult::Opened { name }\n}\n\nasync fn open_built_in(\n    inner: &Arc<Inner>,\n    root: &std::path::Path,\n    profile: Profile,\n) -> WorkbenchResult {\n    let folder = scm::folder(root);\n    let target = folder.clone();\n    let previous = profile.scm.clone();\n    let written = blocking(Err(ProjectProblem::Io), move || {\n        let _placement = crate::sessions::placement();\n        scm::refresh(&target, &previous)\n    })\n    .await;\n    let (record, _) = match written {\n        Ok(done) => done,\n        Err(p) => return refused(WorkbenchProblem::Project(p)),\n    };\n    let mut next = profile;\n    next.scm = record;\n    if let Err(f) = store_profile(inner, root, next).await {\n        return refused(WorkbenchProblem::Private(f));\n    }\n    open_at(inner, root, folder, true, None).await\n}\n\n/// Reads the collection's inventory again (after a write).\nasync fn rediscover(inner: &Arc<Inner>) {\n    let Some(folder) = collection_root(inner) else {\n        return;\n    };\n    let found = blocking(Err(ProjectProblem::Io), move || project::discover(&folder)).await;\n    if let (Ok(catalog), Ok(mut state)) = (found, lock(inner))\n        && let Some(open) = state.workbench.open.as_mut()\n * on one line with the save state beside them, the Params / Headers / Body\n * / Auth / Variables / Preview sub-tabs on the left and the response pane\n * on the right. The C14/C15 behaviour is the legacy editor's, ported: the\n * editor text lives here (React owns immediate input); Rust owns the\n * baseline and revision; Save and Send take the fields the editor holds at\n * that moment; typing pauses protect the snapshot on this Mac; a reply\n * never overwrites newer typing.\n */\nexport function RequestEditor({ initial, notes, call, schemas, historyKey, onClosed, register, context = null, running = [], review = null, onStatusChange }: Props) {\n    const ids = useId()\n    const [doc, setDoc] = useState(initial)\n    const [fields, setFields] = useState(initial.fields)\n    const fieldsRef = useRef(initial.fields)\n    const revisionRef = useRef(initial.revision)\n    const idRef = useRef(initial.id)\n    const timer = useRef<ReturnType<typeof setTimeout> | null>(null)\n    const editGen = useRef(0)\n    const markedGen = useRef(0)\n    const sentGen = useRef(0)\n    const ackGen = useRef(0)\n    const [status, setStatus] = useState('')\n    const [saving, setSaving] = useState(false)\n    const [preview, setPreview] = useState<Preview | null>(null)\n    const [run, setRun] = useState<RunView | null>(null)\n    const [displayed, setDisplayed] = useState<DisplayedResponse | null>(null)\n    const reportStatus = useRef(onStatusChange)\n    reportStatus.current = onStatusChange\n    const [sending, setSending] = useState(false)\n    const [sub, setSub] = useState<Sub>('params')\n    const [asText, setAsText] = useState<Record<RowKind, boolean>>({\n        query: false,\n        headers: false,\n    })\n    const [conflict, setConflict] = useState<'changed' | 'deleted' | 'interrupted' | null>(initial.interrupted ? 'interrupted' : initial.conflict)\n\n    const adopt = useCallback((next: DocumentView, editor: Fields | null) => {\n        setDoc(next)\n        revisionRef.current = next.revision\n        setConflict(next.interrupted ? 'interrupted' : next.conflict)\n        if (editor !== null) {\n            fieldsRef.current = editor\n            setFields(editor)\n        }\n    }, [])\n\n    const protect = useCallback((): Promise<boolean> => {\n        timer.current = null\n        const edit = editGen.current\n        sentGen.current = Math.max(sentGen.current, edit)\n        return call({\n            kind: 'protect',\n            id: idRef.current,\n            revision: revisionRef.current,\n            fields: fieldsRef.current,\n            edit,\n        }).then((r) => {\n            if (r.kind === 'protected') {\n                ackGen.current = Math.max(ackGen.current, edit)\n                return true\n            }\n            setStatus(resultText(r) ?? '')\n            return false\n        })\n    }, [call])\n\n    const flush = useCallback((): Promise<boolean> => {\n        const waiting = timer.current !== null\n        if (timer.current !== null) clearTimeout(timer.current)\n        if (waiting || editGen.current > ackGen.current) return protect()\n        return Promise.resolve(true)\n    }, [protect])\n\n    const abandon = useCallback(() => {\n        if (timer.current !== null) clearTimeout(timer.current)\n        timer.current = null\n        ackGen.current = editGen.current\n    }, [])\n\n    const registerRef = useRef(register)\n    registerRef.current = register\n    useEffect(() => {\n        registerRef.current?.({ flush, abandon })\n        return () => {\n            const left = flush()\n            registerRef.current?.({ flush: () => left, abandon: () => {} })\n        }\n    }, [flush, abandon])\n\n    // The status line's last word (a save's, a send's completion, a refusal) gives way to the state once the\n    // request is edited again; only an action still in flight keeps its line.\n    const settle = () => setStatus((s) => (s === C.sending || s === C.waitingReview || s === 'Saving…' ? s : ''))\n\n    const edit = (patch: Partial<Fields>) => {\n        const next = { ...fieldsRef.current, ...patch }\n        fieldsRef.current = next\n        setFields(next)\n        // Every edit, not only the one that first makes the request dirty: a send from an already dirty (or new)\n        // request left its completion standing through the next edits, since dirty never changed.\n        settle()\n        const generation = ++editGen.current\n        if (markedGen.current <= sentGen.current) {\n            markedGen.current = generation\n            void call({ kind: 'editing', id: idRef.current, edit: generation })\n        }\n        if (timer.current !== null) clearTimeout(timer.current)\n        timer.current = setTimeout(() => void protect(), PROTECT_DELAY_MS)\n    }\n\n    const reload = async () => {\n        const r = await call({ kind: 'openRequest', relative: doc.relative })\n        if (r.kind === 'document') adopt(r.document, r.document.fields)\n    }\n\n    const save = async () => {\n        const snapshot = fieldsRef.current\n        const edit = editGen.current\n        if (timer.current !== null) {\n            clearTimeout(timer.current)\n            timer.current = null\n        }\n        sentGen.current = Math.max(sentGen.current, edit)\n        setSaving(true)\n        setStatus('Saving…')\n        const r = await call({\n            kind: 'save',\n            id: idRef.current,\n            revision: revisionRef.current,\n            fields: snapshot,\n            edit,\n        })\n        setSaving(false)\n        if (r.kind === 'saved' || r.kind === 'unchanged') {\n            ackGen.current = Math.max(ackGen.current, edit)\n            adopt(r.document, null)\n            if (fieldsRef.current !== snapshot) {\n                setStatus('Saved. Edits made while saving are kept unsaved.')\n                void protect()\n            } else {\n                setStatus(r.kind === 'saved' ? 'Saved' : 'No changes to save')\n            }\n            return\n        }\n        if (r.kind === 'saveRefused') {\n            if (r.refusal.kind === 'conflict') setConflict('changed')\n            if (r.refusal.kind === 'interrupted' || r.refusal.kind === 'io') setConflict('interrupted')\n            setStatus(saveRefusalText(r.refusal))\n            return\n        }\n        if (r.kind === 'refused' && r.problem.kind === 'stale') await reload()\n        setStatus(resultText(r) ?? '')\n    }\n\n    const resolve = async (choice: 'useDisk' | 'keepMine') => {\n        const r = await call({\n            kind: 'resolve',\n            id: idRef.current,\n            revision: revisionRef.current,\n            fields: fieldsRef.current,\n            choice,\n        })\n        if (r.kind === 'closed') return onClosed(r.id)\n        if (r.kind === 'document') {\n            adopt(r.document, choice === 'useDisk' ? r.document.fields : null)\n            setStatus(choice === 'useDisk' ? 'Using the files on disk. Your version was kept privately.' : 'Your edits now apply to the files on disk. Save to write them.')\n            return\n        }\n        setStatus(resultText(r) ?? '')\n    }\n\n    const discard = async () => {\n        const r = await call({ kind: 'discardDraft', id: idRef.current })\n        if (r.kind === 'closed') return onClosed(r.id)\n        if (r.kind === 'document') {\n            ackGen.current = editGen.current\n            adopt(r.document, r.document.fields)\n            setStatus('Draft discarded')\n            return\n        }\n        setStatus(resultText(r) ?? '')\n    }\n\n    const associate = async (schema: string) => {\n        const r = await call({\n            kind: 'associateSchema',\n            id: idRef.current,\n            revision: revisionRef.current,\n            fields: fieldsRef.current,\n            schema: schema === '' ? null : schema,\n        })\n        if (r.kind === 'document') adopt(r.document, null)\n        else setStatus(resultText(r) ?? '')\n    }\n\n    const sendNow = async (reviewId: string | null) => {\n        const snapshot = fieldsRef.current\n        setSending(true)\n        setRun(null)\n        setStatus(reviewId ? C.waitingReview : C.sending)\n        const r = await call(\n            reviewId\n                ? {\n                      kind: 'apply',\n                      review: reviewId,\n                      id: idRef.current,\n                      revision: revisionRef.current,\n                      fields: snapshot,\n                      context,\n                  }\n                : {\n                      kind: 'send',\n                      id: idRef.current,\n                      revision: revisionRef.current,\n                      fields: snapshot,\n                      context,\n                  }\n        )\n        setSending(false)\n        if (r.kind === 'ran') {\n            setRun(r.run)\n            // Response metrics belong to the displayed response in the footer;\n            // the save state remains the state of the current editor text.\n            setStatus(onStatusChange ? '' : completionText(r.run.record))\n            return\n        }\n        if (r.kind === 'reviewRequired') {\n            setStatus(C.reviewBelow)\n            return\n        }\n        if (r.kind === 'refused' && r.problem.kind === 'stale') await reload()\n        setStatus(resultText(r) ?? '')\n    }\n\n    const readPreview = useCallback(async () => {\n        const r = await call({\n            kind: 'preview',\n            id: idRef.current,\n            fields: fieldsRef.current,\n        })\n        if (r.kind === 'preview') setPreview(r.preview)\n        else setStatus(resultText(r) ?? '')\n    }, [call])\n    // Variables and Preview read the rendered request when they open.\n    useEffect(() => {\n        if (sub === 'variables' || sub === 'preview') void readPreview()\n    }, [sub, readPreview])\n\n    const saveRef = useRef(save)\n    saveRef.current = save\n    useEffect(() => {\n        const onSave = () => void saveRef.current()\n        window.addEventListener(SAVE_DOCUMENT_EVENT, onSave)\n        return () => window.removeEventListener(SAVE_DOCUMENT_EVENT, onSave)\n    }, [])\n\n    const dirty = doc.new || doc.metadataDirty || !same(fields, doc.saved)\n    const name = requestName(doc.relative)\n    const state = doc.new ? C.state.new : dirty ? C.state.unsaved : C.state.saved\n    // Metadata changes the core reports (a schema association) make the request dirty without an edit here.\n    useEffect(() => {\n        if (dirty) setStatus((s) => (s === C.sending || s === C.waitingReview || s === 'Saving…' ? s : ''))\n    }, [dirty])\n    const record = shown?.record ?? null\n    const displayCallback = useRef(onDisplayed)\n    displayCallback.current = onDisplayed\n    useEffect(() => {\n        displayCallback.current?.(record ? { record, history: fromHistory !== null } : null)\n    }, [record, fromHistory])\n    const formatted = useMemo(() => shown?.preview != null ? prettyJson(shown.preview) : null, [shown?.preview])\n\n    const save = async () => {\n        if (!record) return\n        setMessage('')\n        const r = await call({ kind: 'saveResponse', run: record.id })\n        if (r.kind === 'responseSaved') setMessage(C.saved(sizeText(r.bytes), r.name))\n        else if (r.kind !== 'cancelled') setMessage(resultText(r) ?? '')\n    }\n    const copy = async () => {\n        if (shown?.preview == null) return\n        try {\n            await navigator.clipboard.writeText(shown.preview)\n            setMessage(C.copied)\n        } catch {\n            setMessage(C.copyFailed)\n        }\n    }\n\n    const first = running[0] ?? null\n    // Every transfer in flight is in view with its own Cancel, whatever response is being inspected (a run from\n    // History shown while a new send runs hid the progress and the cancellation behind the old record; the core\n    // runs several sends of one document at once, and only the first was shown).\n    const progress = running.map((r, i) => (\n        <span key={r.run} role='status' aria-live='polite' className='flex w-full flex-wrap items-center text-[12.5px]' style={{ gap: 8 }} data-slot='workbench-running'>\n            {C.sendingProgress(r.method, sizeText(r.bytes))}\n            <Btn className='h-7' aria-label={running.length > 1 ? `${C.cancel_} ${i + 1} of ${running.length}` : undefined} onClick={() => void call({ kind: 'cancel', run: r.run })}>\n                {C.cancel_}\n            </Btn>\n        </span>\n    ))\n    const head = record ? (\n        <>\n            {!onDisplayed ? <><span\n                className='inline-flex items-center rounded-[6px] font-bold'\n                style={{\n                    gap: 4,\n                    padding: '2px 9px',\n                    background: tone(record).bg,\n                    color: tone(record).fg,\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_19","type":"command_execution","command":"/bin/zsh -lc \"rg -n '\"'^'\"\\\\s*(it|test|describe)\\\\(' apps/desktop/src/v2/workbench/api-client.test.tsx apps/desktop/src/v2/workbench/request-presentation.test.ts crates/desktop-core/tests/workbench* apps/desktop/src/modules/workbench/*.test.tsx && rg -n 'recovery|late|Retry|startup|restore|footer|History|cancel|URL|json' apps/desktop/src/v2/workbench/api-client.test.tsx\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_19","type":"command_execution","command":"/bin/zsh -lc \"rg -n '\"'^'\"\\\\s*(it|test|describe)\\\\(' apps/desktop/src/v2/workbench/api-client.test.tsx apps/desktop/src/v2/workbench/request-presentation.test.ts crates/desktop-core/tests/workbench* apps/desktop/src/modules/workbench/*.test.tsx && rg -n 'recovery|late|Retry|startup|restore|footer|History|cancel|URL|json' apps/desktop/src/v2/workbench/api-client.test.tsx\"","aggregated_output":"apps/desktop/src/modules/workbench/request-send.test.tsx:180:describe('API Client Send', () => {\napps/desktop/src/modules/workbench/request-send.test.tsx:181:    it('sends the fields typed before the protection debounce, with the active context', async () => {\napps/desktop/src/modules/workbench/request-send.test.tsx:200:    it('shows a tenant change for review and applies the fresh snapshot with its review ID', async () => {\napps/desktop/src/modules/workbench/request-send.test.tsx:234:    it('explains refusals and uncertain outcomes, and never offers to resend', async () => {\napps/desktop/src/modules/workbench/request-send.test.tsx:254:    it('cancels a running request', async () => {\napps/desktop/src/modules/workbench/request-send.test.tsx:263:    it('lists history, shows a run and saves its response through the native sheet', async () => {\napps/desktop/src/v2/workbench/request-presentation.test.ts:4:describe('API JSON presentation preserves JSON tokens', () => {\napps/desktop/src/v2/workbench/request-presentation.test.ts:5:    it('indents without rounding large numbers or rewriting string escapes', () => {\napps/desktop/src/v2/workbench/request-presentation.test.ts:15:    it('rejects invalid or truncated JSON instead of presenting a repaired response', () => {\napps/desktop/src/v2/workbench/request-presentation.test.ts:19:    it('formats empty/nested containers and primitive values without changing their tokens', () => {\napps/desktop/src/v2/workbench/request-presentation.test.ts:24:    it('falls back to raw presentation for excessively large or deeply nested previews', () => {\napps/desktop/src/v2/workbench/api-client.test.tsx:222:describe('C41 API Client board', () => {\napps/desktop/src/v2/workbench/api-client.test.tsx:223:    it('colors one complete editable URL template without duplicating its base variable', async () => {\napps/desktop/src/v2/workbench/api-client.test.tsx:243:    it('colors JSON while Save, Send, response Copy and Save Response keep the original text and run', async () => {\napps/desktop/src/v2/workbench/api-client.test.tsx:271:    it('ignores an earlier history selection that resolves after the newer selected response', async () => {\napps/desktop/src/v2/workbench/api-client.test.tsx:293:    it('cannot replace the current collection footer with a previous collection send result sharing its request id', async () => {\napps/desktop/src/v2/workbench/api-client.test.tsx:318:    it('shows the displayed response metrics in the footer, including another request selected from history', async () => {\napps/desktop/src/v2/workbench/api-client.test.tsx:337:    it('keeps open request tabs on one horizontally scrolling row', async () => {\napps/desktop/src/v2/workbench/api-client.test.tsx:345:    it('offers explicit restore recovery without automatically opening SCM or creating a missing collection', async () => {\napps/desktop/src/v2/workbench/api-client.test.tsx:438:    it('settles an in-flight restore after remount without duplicate loads and ignores its reply after context retirement', async () => {\napps/desktop/src/v2/workbench/api-client.test.tsx:472:    it('draws the title row with the chips, the tree, the tabs, the request line, the sub-tabs, the response pane and the footer (V2-T14)', async () => {\napps/desktop/src/v2/workbench/api-client.test.tsx:517:    it('searches the tree flat, says when nothing matches and clears; a collapsed folder hides its requests', async () => {\napps/desktop/src/v2/workbench/api-client.test.tsx:540:    it('edits Params as rows that are written back as the file’s name=value lines, protected after the typing pause, and shown as text on request', async () => {\napps/desktop/src/v2/workbench/api-client.test.tsx:579:    it('keeps a value as typed, word by word, in Params and Headers, and leaves a padded query value verbatim when another row is edited: Save and Send carry the exact lines (attempt-02 R1)', async () => {\napps/desktop/src/v2/workbench/api-client.test.tsx:614:    it('shows the response under Body (pretty, then Raw), Headers, Details and History, where an older run is shown as recorded (I5)', async () => {\napps/desktop/src/v2/workbench/api-client.test.tsx:663:    it('keeps a transfer in flight, with Cancel request, in view while an older run from History is being inspected; Cancel dispatches the active run once, history stays as recorded, nothing is resent (attempt-03 R1)', async () => {\napps/desktop/src/v2/workbench/api-client.test.tsx:697:    it('shows every transfer in flight for the request with its own Cancel: two deferred sends across a tab round trip, each cancelled by its own id exactly once, nothing resent (attempt-04 R1)', async () => {\napps/desktop/src/v2/workbench/api-client.test.tsx:745:    it('an obsolete document result never replaces the current selection: two selections in flight resolve out of order and the later selection stays usable (attempt-05 R1)', async () => {\napps/desktop/src/v2/workbench/api-client.test.tsx:777:    it('a selected request whose load fails says why and offers Try again, which reopens it once; a lost delivery is said too (attempt-05 R2)', async () => {\napps/desktop/src/v2/workbench/api-client.test.tsx:812:    it('a tool\\'s failure is said inside its sheet, with the entered work and focus kept (attempt-05 R3)', async () => {\napps/desktop/src/v2/workbench/api-client.test.tsx:827:    it('a tree click\\'s late reply never replaces the current selection: the selection moves on while the reply is held, and its release changes nothing (attempt-06 R1)', async () => {\napps/desktop/src/v2/workbench/api-client.test.tsx:857:    it('closing and re-opening a collection while its selected request\\'s first load is held loads it afresh, and the old reply is ignored (attempt-06 R2)', async () => {\napps/desktop/src/v2/workbench/api-client.test.tsx:887:    it('a refused or undelivered creation is said inside the New request dialog, for a request and for a folder, with the path and focus kept (attempt-06 R3)', async () => {\napps/desktop/src/v2/workbench/api-client.test.tsx:908:    it('a cURL import\\'s late reply never replaces the current selection: held past the draft\\'s selection, the sheet closing and another selection, it is ignored (attempt-07 R1)', async () => {\napps/desktop/src/v2/workbench/api-client.test.tsx:946:    it('a cURL import\\'s reply held across a collection close and re-open is ignored; the re-opened selection loads afresh (attempt-07 R1)', async () => {\napps/desktop/src/v2/workbench/api-client.test.tsx:973:    it('an unselected tree entry whose load is refused, then lost, says so above the current editor, which stays; Try again reopens it once each time (attempt-07 R2)', async () => {\napps/desktop/src/v2/workbench/api-client.test.tsx:998:    it('a cURL import\\'s conversion report shows with its draft whether the result or the selecting snapshot arrives first; later selections stay protected (attempt-08 R2)', async () => {\napps/desktop/src/v2/workbench/api-client.test.tsx:1031:    it('a cURL import\\'s conversion report shows when the result arrives before the selecting snapshot (attempt-08 R2)', async () => {\napps/desktop/src/v2/workbench/api-client.test.tsx:1049:    it('typing while an environment or schema save is pending is kept: the reply brings the revision, the next Save sends the newer text (attempt-08 R1)', async () => {\napps/desktop/src/v2/workbench/api-client.test.tsx:1113:    it('returning to an edited request after its editor unmou