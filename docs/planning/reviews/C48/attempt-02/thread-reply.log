'URL' })).toHaveValue('http://127.0.0.1:8080/health')\n946:    it('a cURL import\\'s reply held across a collection close and re-open is ignored; the re-opened selection loads afresh (attempt-07 R1)', async () => {\n958:        await user.type(within(sheet).getByRole('textbox', { name: 'cURL command' }), 'curl http://127.0.0.1:8080/x')\n966:        await waitFor(() => expect(screen.getByRole('textbox', { name: 'URL' })).toHaveValue('http://127.0.0.1:8080/topics'))\n969:        expect(screen.getByRole('textbox', { name: 'URL' })).toHaveValue('http://127.0.0.1:8080/topics')\n987:        expect(within(line()).getByRole('textbox', { name: 'URL' })).toHaveValue('http://127.0.0.1:8080/topics')\n995:        expect(within(line()).getByRole('textbox', { name: 'URL' })).toHaveValue('http://127.0.0.1:8080/topics')\n998:    it('a cURL import\\'s conversion report shows with its draft whether the result or the selecting snapshot arrives first; later selections stay protected (attempt-08 R2)', async () => {\n1017:        await user.type(within(sheet).getByRole('textbox', { name: 'cURL command' }), 'curl -H \"Authorization: Bearer x\" http://127.0.0.1:8080/imported')\n1021:        await waitFor(() => expect(within(line()).getByRole('textbox', { name: 'URL', hidden: true })).toHaveValue('http://127.0.0.1:8080/imported'))\n1025:        // A later selection is still protected: list is selected and shown without the report.\n1027:        await waitFor(() => expect(within(line()).getByRole('textbox', { name: 'URL' })).toHaveValue('http://127.0.0.1:8080/topics'))\n1031:    it('a cURL import\\'s conversion report shows when the result arrives before the selecting snapshot (attempt-08 R2)', async () => {\n1038:        await user.type(within(sheet).getByRole('textbox', { name: 'cURL command' }), 'curl -u a:b http://127.0.0.1:8080/imported')\n1045:        await waitFor(() => expect(within(line()).getByRole('textbox', { name: 'URL' })).toHaveValue('http://127.0.0.1:8080/imported'))\n1097:        await user.type(within(schemas).getByRole('textbox', { name: 'New schema path (.json, .yaml or .yml)' }), 'topics.json')\n1099:        const schemaEditor = within(await within(schemas).findByRole('form', { name: 'Schema topics.json' })).getByRole('textbox')\n1110:        expect(requests.filter((r) => r.kind === 'saveSchema').at(-1)).toMatchObject({ kind: 'saveSchema', relative: 'topics.json', text: '{\"version\":2}3', revision: 'b'.repeat(64) })\n1137:        await user.clear(within(line()).getByRole('textbox', { name: 'URL' }))\n1138:        await user.type(within(line()).getByRole('textbox', { name: 'URL' }), 'http://127.0.0.1:8080/edited')\n1145:        await waitFor(() => expect(within(line()).getByRole('textbox', { name: 'URL' })).toHaveValue('http://127.0.0.1:8080/edited'))\n1152:        await waitFor(() => expect(within(line()).getByRole('textbox', { name: 'URL' })).toHaveValue('http://127.0.0.1:8080/edited'))\n1162:        const { user, requests, native } = await open({ ...base, workbench: { ...base.workbench, collection: { ...collection, schemas: ['existing.json'] } } }, (request) =>\n1182:        holdFor.add('schema:existing.json')\n1186:        await user.click(within(schemas).getByRole('button', { name: 'Edit existing.json' }))\n1188:        await user.type(within(schemas).getByRole('textbox', { name: 'New schema path (.json, .yaml or .yml)' }), 'draft.json')\n1190:        const draft = within(within(schemas).getByRole('form', { name: 'Schema draft.json' })).getByRole('textbox')\n1194:        expect(within(schemas).getByRole('form', { name: 'Schema draft.json' })).toBeInTheDocument()\n1196:        expect(within(schemas).queryByRole('form', { name: 'Schema existing.json' })).toBeNull()\n1198:        holdFor.add('schema:existing.json')\n1199:        await user.click(within(schemas).getByRole('button', { name: 'Edit existing.json' }))\n1201:        await user.click(within(within(schemas).getByRole('form', { name: 'Schema draft.json' })).getByRole('button', { name: 'Close' }))\n1288:        // The list request's editor (the form with the URL field) is not re-opened over the draft.\n1289:        expect(screen.queryAllByRole('form', { name: 'Request list' }).filter((f) => within(f).queryByRole('textbox', { name: 'URL' }))).toHaveLength(0)\n1299:            name: 'Close list without your latest edits?',\n1326:        expect(screen.queryByRole('textbox', { name: 'URL' })).toBeNull()\n1329:        await waitFor(() => expect(screen.getByRole('textbox', { name: 'URL' })).toHaveValue('http://127.0.0.1:8080/topics'))\n1339:    ])('replacing one collection directly with %s that selects the same request id loads the new collection\\u2019s document, never shows the old fields under it, and ignores the old collection\\u2019s late reply (attempt-03 R1)', async (_what, over) => {\n1375:                        committedUrlsUnderOther.push((screen.queryByRole('textbox', { name: 'URL' }) as HTMLInputElement | null)?.value ?? null)\n1383:        await waitFor(() => expect(screen.getByRole('textbox', { name: 'URL' })).toHaveValue('http://127.0.0.1:8080/topics'))\n1393:        await waitFor(() => expect(screen.getByRole('textbox', { name: 'URL' })).toHaveValue('http://127.0.0.1:8080/other'))\n1395:        // The old collection's held reply lands late: nothing changes and no failure is shown.\n1398:        expect(screen.getByRole('textbox', { name: 'URL' })).toHaveValue('http://127.0.0.1:8080/other')\n1482:        await user.type(within(line()).getByRole('textbox', { name: 'URL' }), '?x=1')\n1488:        await user.type(within(line()).getByRole('textbox', { name: 'URL' }), '&y=2')\n1517:        await user.type(within(line()).getByRole('textbox', { name: 'URL' }), '?x=1')\n","exit_code":0,"status":"completed"}}
