{"type":"item.started","item":{"id":"item_68","type":"command_execution","command":"/bin/zsh -lc \"cat apps/desktop/src-tauri/src/fixture_capture.rs && sed -n '152,204p' apps/desktop/src-tauri/src/menu.rs && rg -n -A10 -B8 'fixture:capture' apps/desktop/src-tauri/src/lib.rs\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_68","type":"command_execution","command":"/bin/zsh -lc \"cat apps/desktop/src-tauri/src/fixture_capture.rs && sed -n '152,204p' apps/desktop/src-tauri/src/menu.rs && rg -n -A10 -B8 'fixture:capture' apps/desktop/src-tauri/src/lib.rs\"","aggregated_output":"//! Fixture-only self-capture of the main window's WebView rendering.\n//!\n//! Native acceptance needs pixels (for example the keyboard focus ring), but\n//! screen capture requires a Screen Recording grant for the automation host.\n//! The app can instead snapshot its own WKWebView with\n//! `takeSnapshotWithConfiguration:completionHandler:`, which renders exactly\n//! what the window shows. This module compiles only with `test-fixtures`\n//! (distinct fixture identity); production builds contain neither the code\n//! nor its menu item. Captures go to a fixed temporary directory.\n#![allow(unsafe_code)]\n\nuse std::path::PathBuf;\n\nuse block2::RcBlock;\nuse objc2_app_kit::{NSBitmapImageFileType, NSBitmapImageRep, NSImage};\nuse objc2_foundation::{NSDictionary, NSError};\nuse objc2_web_kit::WKWebView;\nuse tauri::{Runtime, WebviewWindow};\n\n/// Directory receiving fixture captures.\npub fn capture_dir() -> PathBuf {\n    std::env::temp_dir().join(\"prisma-airs-desktop-fixture-captures\")\n}\n\n/// Snapshots the window's WebView to `<capture_dir>/capture-<millis>.png`.\npub fn capture<R: Runtime>(window: &WebviewWindow<R>) {\n    let millis = std::time::SystemTime::now()\n        .duration_since(std::time::UNIX_EPOCH)\n        .map(|d| d.as_millis())\n        .unwrap_or(0);\n    let dir = capture_dir();\n    let path = dir.join(format!(\"capture-{millis}.png\"));\n    let _ = window.with_webview(move |platform| {\n        let pointer = platform.inner().cast::<WKWebView>();\n        // SAFETY: on macOS Tauri's platform webview handle is the window's\n        // live WKWebView; with_webview runs this closure on the main thread\n        // while the webview exists.\n        let Some(webview) = (unsafe { pointer.as_ref() }) else {\n            return;\n        };\n        let handler = RcBlock::new(move |image: *mut NSImage, _error: *mut NSError| {\n            // SAFETY: WebKit passes either null or a valid NSImage for the\n            // duration of the completion handler.\n            let Some(image) = (unsafe { image.as_ref() }) else {\n                return;\n            };\n            if let Some(bytes) = png(image) {\n                let _ = std::fs::create_dir_all(&dir);\n                let _ = std::fs::write(&path, bytes);\n            }\n        });\n        // SAFETY: a nil configuration snapshots the visible bounds; the block\n        // is retained by WebKit until it is called.\n        unsafe { webview.takeSnapshotWithConfiguration_completionHandler(None, &handler) };\n    });\n}\n\nfn png(image: &NSImage) -> Option<Vec<u8>> {\n    let tiff = image.TIFFRepresentation()?;\n    let rep = NSBitmapImageRep::imageRepWithData(&tiff)?;\n    // SAFETY: an empty property dictionary is a valid PNG encoding request.\n    let data = unsafe {\n        rep.representationUsingType_properties(NSBitmapImageFileType::PNG, &NSDictionary::new())\n    }?;\n    Some(data.to_vec())\n}\n        &MenuItemBuilder::with_id(\"tenants\", \"Switch Tenant…\")\n            .accelerator(\"CmdOrCtrl+T\")\n            .build(app)?,\n    );\n    go = go.separator();\n    for (id, _, label, accelerator) in go_items() {\n        let mut item = MenuItemBuilder::with_id(id, menu_title(&label));\n        if let Some(accelerator) = accelerator {\n            item = item.accelerator(accelerator);\n        }\n        go = go.item(&item.build(app)?);\n    }\n    let window = SubmenuBuilder::new(app, \"Window\")\n        .minimize()\n        .maximize()\n        .separator()\n        .close_window()\n        .build()?;\n    let go = go.build()?;\n    let menu = MenuBuilder::new(app).items(&[&app_menu, &file, &edit, &view, &go, &window]);\n    // The fixture identity alone gets a capture menu for native acceptance.\n    #[cfg(all(feature = \"test-fixtures\", target_os = \"macos\"))]\n    let menu = menu.item(\n        &SubmenuBuilder::new(app, \"Fixture\")\n            .item(\n                &MenuItemBuilder::with_id(\"fixture:capture\", \"Capture Window\")\n                    .accelerator(\"CmdOrCtrl+Shift+9\")\n                    .build(app)?,\n            )\n            .item(\n                &MenuItemBuilder::with_id(\"fixture:lock-store\", \"Lock Credential Store\")\n                    .build(app)?,\n            )\n            .item(\n                &MenuItemBuilder::with_id(\"fixture:unlock-store\", \"Unlock Credential Store\")\n                    .build(app)?,\n            )\n            .item(&MenuItemBuilder::with_id(\"fixture:will-sleep\", \"Post Will Sleep\").build(app)?)\n            .build()?,\n    );\n    menu.build()\n}\n\npub fn on_event<R: Runtime>(app: &AppHandle<R>, event: MenuEvent) {\n    let id = event.id().as_ref();\n    #[cfg(all(feature = \"test-fixtures\", target_os = \"macos\"))]\n    if id == \"fixture:capture\" {\n        if let Some(window) = app.get_webview_window(crate::MAIN_WINDOW) {\n            crate::fixture_capture::capture(&window);\n        }\n        return;\n    }\n    #[cfg(all(feature = \"test-fixtures\", target_os = \"macos\"))]\n","exit_code":1,"status":"failed"}}
