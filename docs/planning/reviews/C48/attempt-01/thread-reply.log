n\"\"\"C45 fixture process ownership: exact bundle, executable and PID lifetime.\n\nNo process-name signaling, argument inspection, foreign adoption or installed-app\nlookup. macOS struct layout comes from the selected SDK sys/proc_info.h.\n\"\"\"\nfrom dataclasses import dataclass\nfrom pathlib import Path\nimport ctypes\nimport hashlib\nimport json\nimport os\nimport plistlib\nimport signal\nimport subprocess\nimport sys\nimport time\n\nFIXTURE_ID = 'io.cdot.airs-desktop.fixture'\nEXECUTABLE = 'prisma-airs-desktop'\n\n@dataclass(frozen=True)\nclass Identity:\n    pid: int\n    executable: str\n    birth: tuple\n    parent: int\n\nclass _BsdInfo(ctypes.Structure):\n    _fields_ = [('header', ctypes.c_uint32 * 12), ('comm', ctypes.c_char * 16),\n                ('name', ctypes.c_char * 32), ('misc', ctypes.c_uint32 * 5),\n                ('nice', ctypes.c_int32), ('seconds', ctypes.c_uint64), ('micros', ctypes.c_uint64)]\n\nclass MacProcesses:\n    def __init__(self):\n        if sys.platform != 'darwin':\n            raise RuntimeError('native process ownership requires macOS')\n        self.lib = ctypes.CDLL('/usr/lib/libproc.dylib', use_errno=True)\n        self.lib.proc_pidpath.argtypes = [ctypes.c_int, ctypes.c_void_p, ctypes.c_uint32]\n        self.lib.proc_pidpath.restype = ctypes.c_int\n        self.lib.proc_pidinfo.argtypes = [ctypes.c_int, ctypes.c_int, ctypes.c_uint64, ctypes.c_void_p, ctypes.c_int]\n        self.lib.proc_pidinfo.restype = ctypes.c_int\n\n    def snapshot(self, pid):\n        path = ctypes.create_string_buffer(4096)\n        info = _BsdInfo()\n        if self.lib.proc_pidpath(pid, path, len(path)) <= 0:\n            return None\n        if self.lib.proc_pidinfo(pid, 3, 0, ctypes.byref(info), ctypes.sizeof(info)) != ctypes.sizeof(info):\n            return None\n        if info.header[3] != pid:\n            return None\n        return Identity(pid, os.path.realpath(os.fsdecode(path.value)), (info.seconds, info.micros), info.header[4])\n\n    def pids(self):\n        return [int(p) for p in subprocess.check_output(['/bin/ps', '-axo', 'pid='], text=True).split()]\n\n    def send(self, pid, sig):\n        os.kill(pid, sig)\n\nclass Candidate:\n    def __init__(self, bundle, processes=None, record=None):\n        self.bundle = Path(bundle).resolve(strict=True)\n        info = plistlib.loads((self.bundle/'Contents/Info.plist').read_bytes())\n        if info.get('CFBundleIdentifier') != FIXTURE_ID or info.get('CFBundleExecutable') != EXECUTABLE:\n            raise ValueError('only the chosen C45 fixture bundle is allowed')\n        app_path=(self.bundle/'Contents/MacOS'/EXECUTABLE).resolve(strict=True)\n        engine_path=(self.bundle/'Contents/Resources/harness/airs-harness').resolve()\n        if not app_path.is_relative_to(self.bundle) or not engine_path.is_relative_to(self.bundle):\n            raise ValueError('candidate executable or engine escapes its fixture bundle')\n        self.app_path=str(app_path)\n        self.engine_path=str(engine_path)\n        self.processes = processes if processes is not None else MacProcesses()\n        self.record = Path(record) if record else None\n        self.app = None\n        self.engines_owned = {}\n        self.child = None\n\n    def matching(self, path):\n        return [s for pid in self.processes.pids() if (s := self.processes.snapshot(pid)) and s.executable == path]\n\n    def valid(self, identity):\n        if identity is None:return False\n        current=self.processes.snapshot(identity.pid)\n        return current is not None and (current.pid,current.executable,current.birth)==(identity.pid,identity.executable,identity.birth)\n\n    def publish(self):\n        if self.record:\n            def value(s):return dict(pid=s.pid, executable=s.executable, birth=s.birth, parent=s.parent)\n            data={'schema':'airs-desktop/candidate-processes/1','bundle':str(self.bundle),\n                  'app':value(self.app) if self.app else None,\n                  'engines':[value(s) for s in self.engines_owned.values()],\n                  'meaning':'Observed exact executable/PID birth identities owned by this driver; no process-name or installed-app lookup.'}\n            self.record.parent.mkdir(parents=True,exist_ok=True)\n            self.record.write_text(json.dumps(data,indent=2)+'\\n')\n\n    def app_pid(self):\n        matches = self.matching(self.app_path)\n        if len(matches)>1:\n            raise RuntimeError('multiple candidate processes; no UI or signal allowed')\n        if self.valid(self.app):return self.app.pid\n        if matches:\n            raise RuntimeError('candidate process is not owned by this driver; inspect durable ownership')\n        return None\n\n    def adopt_child(self, pid, parent):\n        identity=self.processes.snapshot(pid)\n        if not identity or identity.executable!=self.app_path or identity.parent!=parent:\n            raise RuntimeError('launched child identity does not match the bound fixture')\n        self.app=identity;self.publish();return pid\n\n    def launch(self):\n        if self.matching(self.app_path) or self.matching(self.engine_path):\n            raise RuntimeError('unowned candidate process exists; no automatic cleanup or duplicate writer')\n        self.child=subprocess.Popen([self.app_path], stdin=subprocess.DEVNULL,\n                                    stdout=subprocess.DEVNULL,stderr=subprocess.DEVNULL)\n        deadline=time.monotonic()+6\n        while time.monotonic()<deadline:\n            if self.child.poll() is not None:raise RuntimeError('fixture executable exited during launch')\n            s=self.processes.snapshot(self.child.pid)\n            if s and s.executable==self.app_path:return self.adopt_child(self.child.pid,os.getpid())\n            time.sleep(.05)\n        raise RuntimeError('fixture child identity was not observed')\n\n    def engines(self):\n        app_pid=self.app_pid()\n        for identity in self.matching(self.engine_path):\n            current=identity;seen=set()\n            while app_pid and current and current.pid not in seen:\n                if current.parent==app_pid:\n                    self.engines_owned[identity.pid]=identity;break\n                seen.add(current.pid);current=self.processes.snapshot(current.parent)\n        self.engines_owned={pid:s for pid,s in self.engines_owned.items() if self.valid(s)}\n        self.publish();return sorted(self.engines_owned)\n\n    def signal_identity(self, identity, sig):\n        if not self.valid(identity):return False\n        self.processes.send(identity.pid,sig);return True\n\n    def signal_app(self, sig=signal.SIGTERM):\n        self.engines()  # establish owned descendants before their parent exits\n        return self.signal_identity(self.app,sig)\n\n    def signal_engine(self,pid,sig=signal.SIGKILL):\n        self.engines();return self.signal_identity(self.engines_owned.get(pid),sig)\n\n    def stop_engines(self):\n        for pid in self.engines():self.signal_engine(pid)\n\n_bound = None\n\ndef bind(bundle):\n    global _bound\n    path=Path(bundle).resolve(strict=True)\n    if _bound is not None and _bound.bundle != path:\n        raise RuntimeError('one driver cannot switch fixture candidates')\n    if _bound is None:\n        prepare=os.environ.get('AIRS_NATIVE_PREPARE')\n        if prepare:\n            p=json.loads(Path(prepare).read_text());expected=(Path.cwd()/p['bundle']).resolve(strict=True)\n            if path!=expected:raise RuntimeError('bundle differs from declared native preparation')\n            executable=path/'Contents/MacOS'/EXECUTABLE\n            if hashlib.sha256(executable.read_bytes()).hexdigest()!=p['executable_sha256']:\n                raise RuntimeError('prepared executable changed')\n        _bound=Candidate(path,record=os.environ.get('AIRS_NATIVE_PROCESS_RECORD'))\n    return _bound\n\ndef current():\n    if _bound is not None:return _bound\n    prepare=os.environ.get('AIRS_NATIVE_PREPARE')\n    if prepare:return bind(Path.cwd()/json.loads(Path(prepare).read_text())['bundle'])\n    return None\n\ndef app_pid():\n    candidate=current();return candidate.app_pid() if candidate else None\n\ndef engine_pids():\n    candidate=current();return candidate.engines() if candidate else []\n\ndef stop_app(sig=signal.SIGTERM):\n    candidate=current()\n    if candidate:candidate.signal_app(sig)\n\ndef stop_engines():\n    candidate=current()\n    if candidate:candidate.stop_engines()\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_61","type":"command_execution","command":"/bin/zsh -lc \"sed -n '1,200p' apps/desktop/src/modules/workbench/document-save.test.tsx && rg -n 'Save|save-document|SAVE_DOCUMENT' apps/desktop/src apps/desktop/src-tauri/src | head -90\"","aggregated_output":"/**\n * API Client document Save through the real App, DesktopClient and shell\n * (C14): Save sends the fields the editor holds at the click (not a\n * debounced copy), invalid input is refused without touching the editor,\n * typing during a save stays and is protected against the new revision, a\n * stale revision reloads, conflicts offer Use disk / Keep mine with the\n * fresh snapshot, typing pauses and leaving a document protect drafts, and\n * a recovered draft can be discarded.\n */\nimport { act, render, screen, waitFor, within } from '@testing-library/react'\nimport userEvent from '@testing-library/user-event'\nimport { describe, expect, it } from 'vitest'\nimport {\n    type CollectionView,\n    DesktopClient,\n    type DocumentView,\n    type Fields,\n    type Intent,\n    type ShellSnapshot,\n    type TabView,\n    type WorkbenchRequest,\n    type WorkbenchResult,\n} from '@prisma-airs/desktop-contracts'\nimport { App } from '../../app'\nimport { baseSnapshot, type Native, scriptedNative, framed } from '../../test/native'\nimport { PROTECT_DELAY_MS, SAVE_DOCUMENT_EVENT } from '../../v2/workbench/request-editor'\n\nconst R1 = '1'.repeat(32)\nconst R2 = '2'.repeat(32)\n\nconst fields = (overrides: Partial<Fields> = {}): Fields => ({\n    method: 'GET',\n    url: 'https://a.example/items',\n    headers: 'Accept: application/json',\n    query: '',\n    body: '',\n    bodyKind: 'text',\n    settings: '',\n    ...overrides,\n})\n\nconst doc = (overrides: Partial<DocumentView> = {}): DocumentView => ({\n    id: 'list',\n    relative: 'items/list.request.toml',\n    revision: R1,\n    fields: fields(),\n    saved: fields(),\n    new: false,\n    recovered: false,\n    bodyEditable: true,\n    schema: null,\n    conflict: null,\n    interrupted: false,\n    metadataDirty: false,\n    ...overrides,\n})\n\nconst tab = (overrides: Partial<TabView> = {}): TabView => ({\n    id: 'list',\n    relative: 'items/list.request.toml',\n    method: 'GET',\n    draft: false,\n    new: false,\n    recovered: false,\n    conflict: null,\n    interrupted: false,\n    ...overrides,\n})\n\nconst collection = (overrides: Partial<CollectionView> = {}): CollectionView => ({\n    id: 'c14',\n    name: 'Items API',\n    folder: 'api',\n    scope: '1'.repeat(32),\n    builtIn: false,\n    complete: true,\n    requests: [\n        { relative: 'items/list.request.toml', id: 'list', method: 'GET', url: 'https://a.example/items' },\n        { relative: 'items/create.request.toml', id: 'create', method: 'POST', url: 'https://a.example/items' },\n    ],\n    folders: ['items'],\n    schemas: [],\n    issues: [],\n    environments: [],\n    environment: null,\n    tabs: [tab()],\n    selected: 'list',\n    secrets: [],\n    unsaved: null,\n    archives: 0,\n    ...overrides,\n})\n\nconst opened = (c: Partial<CollectionView> = {}): ShellSnapshot => ({\n    ...baseSnapshot,\n    workbench: { ...baseSnapshot.workbench, collection: collection(c) },\n})\n\ntype Answer = (request: WorkbenchRequest) => WorkbenchResult | Promise<WorkbenchResult>\n\n/** Records API Client requests and answers each from `answer`. */\nfunction workbench(native: Native, answer: Answer): WorkbenchRequest[] {\n    const requests: WorkbenchRequest[] = []\n    const pending = new Map<string, WorkbenchRequest>()\n    const respond = native.respond\n    native.respond = (intent: Intent) => {\n        if (intent.kind !== 'workbench') return respond(intent)\n        requests.push(intent.request)\n        const operation = `op-${requests.length}`\n        pending.set(operation, intent.request)\n        return { outcome: 'receipt', receipt: { kind: 'admitted', request: `rq-${requests.length}`, operation } }\n    }\n    native.observeWorkbench = async (operation) => {\n        const request = pending.get(operation)\n        if (!request) return { kind: 'refusal', refusal: 'invalidInput' }\n        return { kind: 'workbench', result: await answer(request) }\n    }\n    return requests\n}\n\n/** Answers like Rust for one document at R1 (saves move it to R2). */\nconst standard =\n    (held: DocumentView = doc()): Answer =>\n    (request) => {\n        switch (request.kind) {\n            case 'openRequest':\n                return { kind: 'document', document: held, notes: [] }\n            case 'save':\n                return { kind: 'saved', document: doc({ revision: R2, fields: request.fields, saved: request.fields }) }\n            case 'protect':\n                return { kind: 'protected', id: request.id }\n            default:\n                return { kind: 'done' }\n        }\n    }\n\nconst of = <K extends WorkbenchRequest['kind']>(requests: WorkbenchRequest[], kind: K) =>\n    requests.filter((r): r is Extract<WorkbenchRequest, { kind: K }> => r.kind === kind)\n\nasync function open(native: Native) {\n    const user = userEvent.setup()\n    render(<App client={new DesktopClient(native.transport)} />)\n    await native.push({ ...native.current, onboarding: 'done', activeFeature: 'apiClient' })\n    await screen.findByRole('heading', { level: 1, name: 'API Client' })\n    await screen.findByRole('form', { name: 'Request list' })\n    return user\n}\n\nconst url = () => screen.getByRole('textbox', { name: 'URL' }) as HTMLInputElement\n\ndescribe('API Client document Save', () => {\n    it('sends the fields typed before the protection debounce fires', async () => {\n        const native = framed(scriptedNative(opened()), 'apiClient')\n        const requests = workbench(native, standard())\n        const user = await open(native)\n        await user.clear(url())\n        await user.type(url(), 'https://b.example/new')\n        // Saved at once: well inside the debounce.\n        await user.click(screen.getByRole('button', { name: 'Save' }))\n        await waitFor(() => expect(document.querySelector('[data-slot=\"workbench-save-status\"]')).toHaveTextContent(/^Saved$/))\n        const saves = of(requests, 'save')\n        expect(saves).toHaveLength(1)\n        expect(saves[0]).toEqual({ kind: 'save', id: 'list', revision: R1, fields: fields({ url: 'https://b.example/new' }), edit: expect.any(Number) })\n        // The pending protection was replaced by the save; none followed.\n        await new Promise((r) => setTimeout(r, PROTECT_DELAY_MS + 50))\n        expect(of(requests, 'protect')).toHaveLength(0)\n        // ⌘S saves the current snapshot against the new revision.\n        await user.type(url(), '?x=1')\n        await user.keyboard('{Meta>}s{/Meta}')\n        await waitFor(() => expect(of(requests, 'save')).toHaveLength(2))\n        expect(of(requests, 'save')[1]).toMatchObject({ revision: R2, fields: { url: 'https://b.example/new?x=1' } })\n        // File > Save from the native menu (how ⌘S arrives in the app).\n        await user.type(url(), '&y=2')\n        await act(async () => void window.dispatchEvent(new Event(SAVE_DOCUMENT_EVENT)))\n        await waitFor(() => expect(of(requests, 'save')).toHaveLength(3))\n        expect(of(requests, 'save')[2]).toMatchObject({ fields: { url: 'https://b.example/new?x=1&y=2' } })\n    })\n\n    it('refuses invalid input without changing what the editor holds', async () => {\n        const native = framed(scriptedNative(opened()), 'apiClient')\n        const requests = workbench(native, (request) =>\n            request.kind === 'save'\n                ? { kind: 'saveRefused', refusal: { kind: 'invalid', problem: { field: 'headers', line: 2 } } }\n                : standard()(request)\n        )\n        const user = await open(native)\n        // C44: the v2 editor edits headers as rows; the Text toggle edits the file's lines.\n        await user.click(within(screen.getByRole('tablist', { name: 'Request' })).getByRole('tab', { name: /^Headers/ }))\n        await user.click(screen.getByRole('button', { name: 'Text' }))\n        const headers = screen.getByRole('textbox', { name: /^Headers/ })\n        await user.type(headers, '{Enter}not a header')\n        await user.click(screen.getByRole('button', { name: 'Save' }))\n        expect(await screen.findByText('Fix to save. Headers: use Name: value (line 2).')).toBeInTheDocument()\n        expect(headers).toHaveValue('Accept: application/json\\nnot a header')\n        expect(of(requests, 'save')[0]).toMatchObject({ fields: { headers: 'Accept: application/json\\nnot a header' } })\n        // C44: the v2 request line's status region carries the dirty state as data-state while a message shows.\n        expect(document.querySelector('[data-slot=\"workbench-save-status\"]')).toHaveAttribute('data-state', 'unsaved')\n    })\n\n    it('keeps text typed while a save is in flight and protects it against the new revision', async () => {\napps/desktop/src-tauri/src/menu.rs:60:        return Some(MenuCommand::SaveDocument);\napps/desktop/src-tauri/src/menu.rs:107:            &MenuItemBuilder::with_id(\"save\", \"Save\")\napps/desktop/src-tauri/src/adapters.rs:23:    Adapters, CredentialStore, FileSaver, FolderPicker, ImagePicker, ImportFile, ImportPicker,\napps/desktop/src-tauri/src/adapters.rs:68:            Arc::new(NativeSaver { app: app.clone() }),\napps/desktop/src-tauri/src/adapters.rs:194:/// NSOpenPanel / NSSavePanel.\napps/desktop/src-tauri/src/adapters.rs:258:    /// Save a response body under a suggested name (the panel confirms\napps/desktop/src-tauri/src/adapters.rs:260:    Save(String),\napps/desktop/src-tauri/src/adapters.rs:278:                    Sheet::Save(name) => dialog\napps/desktop/src-tauri/src/adapters.rs:279:                        .set_title(\"Save response\")\napps/desktop/src-tauri/src/adapters.rs:302:        self.sheet(Sheet::Save(suggested))\napps/desktop/src-tauri/s