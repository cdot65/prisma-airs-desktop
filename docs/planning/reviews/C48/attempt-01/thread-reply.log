{"type":"item.completed","item":{"id":"item_76","type":"command_execution","command":"/bin/zsh -lc \"sed -n '130,205p' crates/xtask/src/manifest.rs && sed -n '620,750p' crates/xtask/src/manifest.rs\"","aggregated_output":"    \"authority_security\",\n    \"validation\",\n    \"overall\",\n];\n\nimpl Manifest {\n    pub fn load(path: &Path) -> Result<Self> {\n        let manifest: Self = read_json(path)?;\n        manifest.validate()?;\n        Ok(manifest)\n    }\n\n    fn validate(&self) -> Result<()> {\n        if self.schema_version != 1 {\n            return Err(invalid(\"unsupported checks.json schema_version\"));\n        }\n        if self.target != \"aarch64-apple-darwin\" {\n            return Err(invalid(\"checks.json target must be aarch64-apple-darwin\"));\n        }\n        for n in 1..=Subject::LAST_CHUNK {\n            let id = Subject::Chunk(n).to_string();\n            if !self.chunks.contains_key(&id) {\n                return Err(invalid(format!(\"checks.json is missing chunk {id}\")));\n            }\n        }\n        if self.chunks.len() != usize::from(Subject::LAST_CHUNK) {\n            return Err(invalid(\"checks.json must define exactly C01-C49\"));\n        }\n        for (id, chunk) in &self.chunks {\n            let subject = Subject::parse(id)?;\n            let focused = matches!(subject, Subject::Chunk(n) if n >= 46);\n            if focused && chunk.check_commands.as_ref().is_none_or(Vec::is_empty) {\n                return Err(invalid(format!(\n                    \"{id} requires a nonempty explicit check_commands list (D063)\"\n                )));\n            }\n            if !focused && chunk.check_commands.is_some() {\n                return Err(invalid(format!(\n                    \"{id} cannot override historical common checks\"\n                )));\n            }\n            let fixed = subject.is_docs_only();\n            if chunk.docs_only != fixed {\n                return Err(invalid(format!(\n                    \"{id} docs_only must be {fixed}: the documentation-only policy (D058) is fixed in the controller and cannot be changed from checks.json\"\n                )));\n            }\n            if chunk.docs_only && !chunk.native_acceptance.starts_with(\"not applicable\") {\n                return Err(invalid(format!(\n                    \"{id} is docs_only but declares native acceptance; a documentation-only chunk states 'not applicable'\"\n                )));\n            }\n        }\n        let mut phase_members = Vec::new();\n        for n in 1..=Subject::LAST_PHASE {\n            let id = Subject::Phase(n).to_string();\n            let members = self\n                .phases\n                .get(&id)\n                .ok_or_else(|| invalid(format!(\"checks.json is missing phase {id}\")))?;\n            phase_members.extend(members.iter().cloned());\n        }\n        let expected: Vec<String> = (1..=Subject::LAST_CHUNK)\n            .map(|n| Subject::Chunk(n).to_string())\n            .collect();\n        if phase_members != expected || self.phases.len() != usize::from(Subject::LAST_PHASE) {\n            return Err(invalid(\"phases must partition C01-C49 in order\"));\n        }\n        let refinements: Vec<String> = (46..=49).map(|n| Subject::Chunk(n).to_string()).collect();\n        if self.phases.get(\"P11\") != Some(&refinements) {\n            return Err(invalid(\n                \"P11 must contain exactly C46-C49; historical phases cannot absorb refinement chunks\",\n            ));\n        }\n        for argv in self.all_static_commands() {\n            check_argv(argv)?;\n            \"e033aea4da6dd2008edc28f6064f402d2484224a2fc448454b4b037e0a0d91b8\"\n        );\n        assert_eq!(\n            digests.1,\n            \"9a02f2564ebbf745748de2b22f3749ff291b62283cecf10b14f67b02c27fd107\"\n        );\n    }\n\n    #[test]\n    fn p11_has_explicit_focused_checks_and_deduplicates_every_member() {\n        let manifest = approved();\n        let phase = Subject::parse(\"P11\").expect(\"registered P11\");\n        let checks = manifest.plan(phase, RunKind::Check).expect(\"P11 checks\");\n        let tests = manifest.plan(phase, RunKind::Test).expect(\"P11 tests\");\n        assert!(checks.iter().any(|c| c.label.starts_with(\"C46/\")));\n        assert!(\n            checks\n                .iter()\n                .any(|c| c.argv.iter().any(|a| a == \"workbench_documents\"))\n        );\n        for plan in [&checks, &tests] {\n            for command in plan.iter().filter(|c| !c.label.starts_with(\"setup/\")) {\n                assert!(\n                    [\"C46/\", \"C47/\", \"C48/\", \"C49/\"]\n                        .iter()\n                        .any(|p| command.label.starts_with(p)),\n                    \"unexpected historical command: {}\",\n                    command.label\n                );\n                assert!(!command.argv.iter().any(|a| matches!(\n                    a.as_str(),\n                    \"--workspace\" | \"--all-targets\" | \"imports_rollback\"\n                )));\n            }\n            let unique: std::collections::BTreeSet<_> = plan.iter().map(|c| &c.argv).collect();\n            assert_eq!(\n                plan.len(),\n                unique.len(),\n                \"phase runs each exact command once\"\n            );\n        }\n        assert!(\n            tests\n                .iter()\n                .any(|c| c.argv.iter().any(|a| a == \"color_theme\"))\n        );\n        assert_eq!(\n            manifest.native_members(phase).expect(\"native members\"),\n            [\"C46\", \"C47\", \"C48\", \"C49\"]\n        );\n        let (required, identifier) = crate::evidence::required_checks(\n            &Repo::discover().join(\"docs/architecture/native-checks.json\"),\n            &manifest.native_members(phase).expect(\"members\"),\n        )\n        .expect(\"all refinement inventories\");\n        let expected: Vec<String> = (46..=49)\n            .flat_map(|chunk| (1..=3).map(move |n| format!(\"C{chunk}-N{n:02}\")))\n            .collect();\n        assert_eq!(\n            required, expected,\n            \"none of the twelve current assertions is silently dropped\"\n        );\n        assert_eq!(identifier, crate::native::FIXTURE_IDENTIFIER);\n        let prepare = manifest\n            .plan(phase, RunKind::NativePrepare)\n            .expect(\"one candidate\");\n        assert_eq!(\n            prepare\n                .iter()\n                .filter(|c| c.label == \"native-prepare\")\n                .count(),\n            1\n        );\n    }\n\n    #[test]\n    fn focused_command_lists_are_required_and_cannot_override_historical_checks() {\n        let original: serde_json::Value =\n            crate::read_json(&Repo::discover().manifest()).expect(\"JSON\");\n        let validate = |value| {\n            serde_json::from_value::<Manifest>(value)\n                .and_then(|m| m.validate().map_err(serde::de::Error::custom))\n        };\n        validate(original.clone()).expect(\"positive control\");\n        let mut missing = original.clone();\n        missing[\"chunks\"][\"C46\"]\n            .as_object_mut()\n            .expect(\"chunk\")\n            .remove(\"check_commands\");\n        assert!(validate(missing).is_err());\n        for argv in [\n            json!([]),\n            json!([[]]),\n            json!([[\"sh\", \"-c\", \"true\"]]),\n            json!([[\"cargo\", \"check\", \"--all-features\"]]),\n        ] {\n            let mut invalid = original.clone();\n            invalid[\"chunks\"][\"C46\"][\"check_commands\"] = argv;\n            assert!(validate(invalid).is_err());\n        }\n        let mut historical = original.clone();\n        historical[\"chunks\"][\"C45\"][\"check_commands\"] =\n            json!([[\"cargo\", \"check\", \"-p\", \"desktop-core\"]]);\n        assert!(validate(historical).is_err());\n        let mut wrong_phase = original;\n        wrong_phase[\"phases\"][\"P10\"] = json!([\"C45\", \"C46\"]);\n        wrong_phase[\"phases\"][\"P11\"] = json!([\"C47\", \"C48\", \"C49\"]);\n        assert!(validate(wrong_phase).is_err());\n    }\n\n    #[test]\n    fn focused_check_changes_bind_new_subjects_without_rewriting_legacy_flags() {\n        let repo = Repo::discover();\n        let before = approved();\n        let mut changed = before.clone();\n        changed\n            .chunks\n            .get_mut(\"C46\")\n            .expect(\"C46\")\n            .check_commands\n            .as_mut()\n            .expect(\"explicit list\")\n            .push(vec![\n                \"cargo\".into(),\n                \"check\".into(),\n                \"-p\".into(),\n                \"xtask\".into(),\n            ]);\n        for subject in [Subject::Chunk(46), Subject::Phase(11)] {\n            assert_ne!(\n                fingerprint::build_flags(&repo, &before, subject).expect(\"before\"),\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_75","type":"command_execution","command":"/bin/zsh -lc \"sed -n '1,255p' crates/xtask/src/fingerprint.rs\"","aggregated_output":"//! Input fingerprints bound into review packets and receipts.\n//!\n//! * source: every tracked or untracked-but-not-ignored file (path, mode,\n//!   content or symlink target) plus the repository `.git/config`, minus a\n//!   narrow set of mutable evidence locations that are hashed separately.\n//! * dependencies: lockfiles, toolchain pin, the consumed immutable inputs\n//!   under `.inputs/`, and the resolved build-tool identities.\n//! * build_flags: the subject's manifest entries, Tauri configuration and\n//!   capability files, target and fixture-feature policy.\n//! * evidence: the subject's committed evidence directory.\n\nuse std::collections::BTreeMap;\nuse std::os::unix::fs::PermissionsExt;\nuse std::path::Path;\nuse std::process::Command;\n\nuse serde::{Deserialize, Serialize};\n\nuse crate::manifest::Manifest;\nuse crate::{Repo, Result, Subject, invalid, io_err, sha256_hex};\n\n/// Mutable locations excluded from the source fingerprint. Each is hashed\n/// independently (evidence fingerprint, receipts) so exclusion cannot hide\n/// application sources, lockfiles, tests or configuration.\npub const SOURCE_EXCLUSIONS: [&str; 3] = [\n    \"docs/planning/status.md\",\n    \"docs/planning/reviews/\",\n    \"docs/planning/evidence/\",\n];\n\n#[derive(Clone, Debug, PartialEq, Eq, Serialize, Deserialize)]\n#[serde(deny_unknown_fields)]\npub struct Fingerprints {\n    pub source: String,\n    pub dependencies: String,\n    pub build_flags: String,\n    pub evidence: String,\n}\n\n/// One entry of the source inventory.\n#[derive(Clone, Debug, PartialEq, Eq, Serialize, Deserialize)]\npub struct FileEntry {\n    pub path: String,\n    pub mode: String,\n    pub sha256: String,\n}\n\npub fn is_excluded(path: &str) -> bool {\n    SOURCE_EXCLUSIONS.iter().any(|excluded| {\n        if excluded.ends_with('/') {\n            path.starts_with(excluded)\n        } else {\n            path == *excluded\n        }\n    })\n}\n\n/// Lists source files via git: tracked plus untracked files not ignored.\npub fn source_inventory(repo: &Repo) -> Result<Vec<FileEntry>> {\n    let output = Command::new(\"/usr/bin/git\")\n        .args([\n            \"ls-files\",\n            \"-z\",\n            \"--cached\",\n            \"--others\",\n            \"--exclude-standard\",\n        ])\n        .current_dir(repo.root())\n        .env_clear()\n        .env(\"PATH\", \"/usr/bin:/bin\")\n        .env(\"HOME\", std::env::var(\"HOME\").unwrap_or_default())\n        .output()\n        .map_err(io_err(repo.root()))?;\n    if !output.status.success() {\n        return Err(invalid(\"git ls-files failed\"));\n    }\n    let mut paths: Vec<String> = output\n        .stdout\n        .split(|b| *b == 0)\n        .filter(|p| !p.is_empty())\n        .map(|p| String::from_utf8_lossy(p).into_owned())\n        .filter(|p| !is_excluded(p))\n        .collect();\n    paths.sort();\n    paths.dedup();\n    let mut entries = Vec::with_capacity(paths.len() + 1);\n    for path in paths {\n        entries.push(file_entry(repo.root(), &path)?);\n    }\n    entries.push(file_entry(repo.root(), \".git/config\")?);\n    Ok(entries)\n}\n\nfn file_entry(root: &Path, relative: &str) -> Result<FileEntry> {\n    let full = root.join(relative);\n    let Ok(meta) = std::fs::symlink_metadata(&full) else {\n        return Ok(FileEntry {\n            path: relative.to_owned(),\n            mode: \"deleted\".to_owned(),\n            sha256: String::new(),\n        });\n    };\n    if meta.file_type().is_symlink() {\n        let target = std::fs::read_link(&full).map_err(io_err(&full))?;\n        return Ok(FileEntry {\n            path: relative.to_owned(),\n            mode: \"symlink\".to_owned(),\n            sha256: sha256_hex(target.as_os_str().as_encoded_bytes()),\n        });\n    }\n    let bytes = std::fs::read(&full).map_err(io_err(&full))?;\n    let executable = meta.permissions().mode() & 0o111 != 0;\n    Ok(FileEntry {\n        path: relative.to_owned(),\n        mode: if executable { \"100755\" } else { \"100644\" }.to_owned(),\n        sha256: sha256_hex(&bytes),\n    })\n}\n\npub fn inventory_hash(entries: &[FileEntry]) -> String {\n    let text: String = entries\n        .iter()\n        .map(|e| format!(\"{}\\0{}\\0{}\\n\", e.path, e.mode, e.sha256))\n        .collect();\n    sha256_hex(text.as_bytes())\n}\n\npub fn source(repo: &Repo) -> Result<String> {\n    Ok(inventory_hash(&source_inventory(repo)?))\n}\n\n/// Hash of every regular file under a directory (relative paths, sorted).\npub fn tree_hash(dir: &Path) -> Result<String> {\n    tree_hash_excluding(dir, &[])\n}\n\n/// Like [`tree_hash`], skipping directories with the given names.\npub fn tree_hash_excluding(dir: &Path, skip: &[&str]) -> Result<String> {\n    let mut entries = Vec::new();\n    collect_tree(dir, dir, skip, &mut entries)?;\n    entries.sort_by(|a, b| a.path.cmp(&b.path));\n    Ok(inventory_hash(&entries))\n}\n\nfn collect_tree(root: &Path, dir: &Path, skip: &[&str], out: &mut Vec<FileEntry>) -> Result<()> {\n    let mut children: Vec<_> = std::fs::read_dir(dir)\n        .map_err(io_err(dir))?\n        .filter_map(|e| e.ok())\n        .collect();\n    children.sort_by_key(|e| e.file_name());\n    for child in children {\n        let path = child.path();\n        let relative = path\n            .strip_prefix(root)\n            .map_err(|_| invalid(\"path escaped its root\"))?\n            .to_string_lossy()\n            .into_owned();\n        let meta = std::fs::symlink_metadata(&path).map_err(io_err(&path))?;\n        if meta.is_dir() {\n            if skip.iter().any(|name| child.file_name() == *name) {\n                continue;\n            }\n            collect_tree(root, &path, skip, out)?;\n        } else {\n            out.push(file_entry(root, &relative)?);\n        }\n    }\n    Ok(())\n}\n\n/// Dependency inputs: lockfiles, toolchain pin, immutable inputs, tools.\npub fn dependencies(repo: &Repo, toolchain_hash: &str) -> Result<String> {\n    let mut parts: BTreeMap<String, String> = BTreeMap::new();\n    for file in [\n        \"Cargo.lock\",\n        \"pnpm-lock.yaml\",\n        \"rust-toolchain.toml\",\n        \".npmrc\",\n        \"docs/architecture/inputs.lock.json\",\n    ] {\n        let path = repo.join(file);\n        let digest = match std::fs::read(&path) {\n            Ok(bytes) => sha256_hex(&bytes),\n            Err(_) => \"absent\".to_owned(),\n        };\n        parts.insert(file.to_owned(), digest);\n    }\n    let inputs = repo.join(\".inputs\");\n    if inputs.is_dir() {\n        let mut names: Vec<_> = std::fs::read_dir(&inputs)\n            .map_err(io_err(&inputs))?\n            .filter_map(|e| e.ok())\n            .filter(|e| e.path().is_dir())\n            .map(|e| e.file_name().to_string_lossy().into_owned())\n            .collect();\n        names.sort();\n        for name in names {\n            parts.insert(format!(\".inputs/{name}\"), tree_hash(&inputs.join(&name))?);\n        }\n    }\n    for (label, hash) in consumed_shared(repo)? {\n        parts.insert(label, hash);\n    }\n    parts.insert(\"toolchain\".to_owned(), toolchain_hash.to_owned());\n    Ok(sha256_hex(\n        serde_json::to_string(&parts).unwrap_or_default().as_bytes(),\n    ))\n}\n\n/// Build flags: the subject's manifest entries and native configuration,\n/// as canonical JSON (sorted keys, compact) so independent tools can\n/// recompute it.\npub fn build_flags(repo: &Repo, manifest: &Manifest, subject: Subject) -> Result<String> {\n    use serde_json::{Value, json};\n    let mut parts: BTreeMap<String, Value> = BTreeMap::new();\n    let chunks = if subject.is_phase() {\n        manifest.phase_chunks(subject)?\n    } else {\n        vec![subject]\n    };\n    for chunk in chunks {\n        let entry = manifest.chunk(chunk)?;\n        let mut flags = json!({\n            \"fixture\": entry.fixture_command,\n            \"frontend\": entry.frontend_commands,\n            \"host\": entry.host_commands,\n            \"native_prepare\": entry.native_prepare,\n        });\n        // Keep historical canonical objects byte-for-byte equivalent. Only\n        // new chunks bind the D063 selected check list.\n        if let Some(selected) = &entry.check_commands {\n            flags[\"checks\"] = json!(selected);\n        }\n        parts.insert(format!(\"chunk/{chunk}\"), flags);\n    }\n    parts.insert(\"setup\".to_owned(), json!(manifest.setup_commands));\n    parts.insert(\n        \"phase_native\".to_owned(),\n        json!(manifest.phase_native_prepare),\n    );\n    parts.insert(\"common\".to_owned(), json!(manifest.common_commands));\n    parts.insert(\"shared\".to_owned(), json!(manifest.shared_source_commands));\n    parts.insert(\"artifact\".to_owned(), json!(manifest.artifact_build));\n    parts.insert(\"target\".to_owned(), json!(manifest.target));\n    parts.insert(\n        \"fixture_only\".to_owned(),\n        json!(manifest.fixture_only_features),\n    );\n    parts.insert(\n        \"production_features\".to_owned(),\n        json!(manifest.requested_production_features),\n    );\n    for file in BUILD_FLAG_FILES {\n        let digest = std::fs::read(repo.join(file))\n            .map(|b| sha256_hex(&b))\n","exit_code":0,"status":"completed"}}
