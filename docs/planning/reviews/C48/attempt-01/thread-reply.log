{"type":"item.completed","item":{"id":"item_43","type":"command_execution","command":"/bin/zsh -lc \"sed -n '1645,1735p' crates/desktop-core/src/authority/workbench_domain/send.rs && sed -n '1,190p' crates/desktop-core/src/workbench/profile.rs && sed -n '1410,1499p' crates/desktop-core/src/authority/workbench_domain.rs\"","aggregated_output":"                history::PREVIEW_BYTES,\n            )\n            .unwrap_or_default()\n        })\n        .await\n    } else {\n        Vec::new()\n    };\n    WorkbenchResult::Ran {\n        run: run_view(record, &preview, false),\n    }\n}\n\n/// Saves a stored response body where the operator chooses.\npub(super) async fn save_response(inner: &Arc<Inner>, root: &Path, run: String) -> WorkbenchResult {\n    let scope = match open_scope(inner) {\n        Ok(s) => s,\n        Err(r) => return *r,\n    };\n    match load_history(inner, root, &scope, epoch(inner)).await {\n        None => return retired(),\n        Some(Err(r)) => return refusal(r),\n        Some(Ok(())) => {}\n    }\n    let Some(record) = find_run(inner, &scope, &run) else {\n        return refused(WorkbenchProblem::Missing);\n    };\n    if !record.stored {\n        return WorkbenchResult::SaveResponseFailed {\n            failure: ExportFailure::Body,\n        };\n    }\n    let name = record\n        .relative\n        .rsplit('/')\n        .next()\n        .unwrap_or(\"response\")\n        .trim_end_matches(\".request.toml\");\n    let name = name.split_whitespace().collect::<Vec<_>>().join(\"-\");\n    let json = record.headers.iter().any(|(n, v)| {\n        n.eq_ignore_ascii_case(\"content-type\") && v.to_ascii_lowercase().contains(\"json\")\n    });\n    let suggested = format!(\"{name}-response.{}\", if json { \"json\" } else { \"txt\" });\n    let Some(destination) = inner.adapters.folders.choose_save(suggested).await else {\n        return WorkbenchResult::Cancelled;\n    };\n    let name = destination\n        .file_name()\n        .map(|n| n.to_string_lossy().into_owned())\n        .unwrap_or_default();\n    let keychain = Arc::clone(&inner.adapters.keychain);\n    let private = root.to_path_buf();\n    let written = blocking(Err(ExportFailure::Io), move || {\n        history::export(&private, keychain.as_ref(), &scope, &run, &destination)\n    })\n    .await;\n    match written {\n        Ok(bytes) => WorkbenchResult::ResponseSaved { bytes, name },\n        Err(failure) => WorkbenchResult::SaveResponseFailed { failure },\n    }\n}\n\n/// Clears the open collection's history (not while one of its requests\n/// runs) and, separately, its cookies.\npub(super) async fn clear(inner: &Arc<Inner>, root: &Path, cookies: bool) -> WorkbenchResult {\n    let scope = match open_scope(inner) {\n        Ok(s) => s,\n        Err(r) => return *r,\n    };\n    if cookies {\n        if let Some(jar) = jar(inner, root, &scope, epoch(inner)).await\n            && let Ok(mut j) = jar.lock()\n        {\n            j.clear();\n        }\n        let keychain = Arc::clone(&inner.adapters.keychain);\n        let private = root.to_path_buf();\n        let stored = blocking(false, move || {\n            profile::store_cookies(&private, keychain.as_ref(), &scope, &[]).is_ok()\n        })\n        .await;\n        return if stored {\n            WorkbenchResult::Done\n        } else {\n            refusal(SendRefusal::Private)\n        };\n    }\n    match load_history(inner, root, &scope, epoch(inner)).await {\n        None => return retired(),\n        Some(Err(r)) => return refusal(r),\n        Some(Ok(())) => {}\n//! The API Client's private profile on this Mac (C14): recent collections,\n//! the value-free index of stored secrets, the built-in collection's write\n//! record and, per collection, its tabs, selected environment, private\n//! environments, protected drafts, archived conflict versions and the save\n//! journal. Everything is sealed (XChaCha20-Poly1305) under one key in the\n//! credential Keychain namespace; reset removes the key and the folder.\n//! Project files stay in their collections and are never copied here except\n//! as archived conflict evidence.\n\nuse std::collections::BTreeMap;\nuse std::path::{Path, PathBuf};\n\nuse serde::de::DeserializeOwned;\nuse serde::{Deserialize, Serialize};\nuse sha2::{Digest, Sha256};\nuse ts_rs::TS;\n\nuse super::document::{Document, Fields};\nuse crate::vault::{RecordId, Vault, VaultError};\n\nconst SCHEMA: &str = \"prisma-airs-desktop-v2/api-client/1\";\npub const PROFILE_BYTES: usize = 1024 * 1024;\npub const SCOPE_BYTES: usize = 64 * 1024 * 1024;\npub const RECENT: usize = 8;\n/// Drafts kept per collection (closed tabs keep theirs).\npub const MAX_DRAFTS: usize = 64;\n/// Archived conflict versions kept per collection (oldest dropped).\npub const MAX_ARCHIVES: usize = 16;\n/// Archived file text kept per version.\npub const ARCHIVE_BYTES: usize = 1024 * 1024;\n\n/// Why the private profile could not be opened or saved (sanitized).\n#[derive(Clone, Copy, Debug, PartialEq, Eq, Serialize, TS)]\n#[serde(rename_all = \"camelCase\")]\npub enum PrivateFailure {\n    Locked,\n    Denied,\n    Unavailable,\n    /// A sealed file did not open under its key; it was kept aside.\n    Unreadable,\n}\n\n/// The credential-namespace record holding the profile key.\npub fn key_record() -> RecordId {\n    let digest = crate::offline::digest(\"api-client-profile-key\");\n    RecordId::parse(&format!(\"cr-{}\", &digest[..16])).expect(\"16 hex digits\")\n}\n\n/// The record holding one workbench secret value (never a tenant record:\n/// a different derivation and prefix in the digest).\npub fn secret_record(collection: &str, reference: &str) -> RecordId {\n    let digest = crate::offline::digest(&format!(\"api-client-secret:{collection}\\0{reference}\"));\n    RecordId::parse(&format!(\"cr-{}\", &digest[..16])).expect(\"16 hex digits\")\n}\n\n/// A collection's private scope: its folder and identity (v1).\npub fn scope(root: &Path, collection: &str) -> String {\n    let digest = Sha256::digest(format!(\"{}\\0{collection}\", root.display()).as_bytes());\n    hex::encode(&digest[..16])\n}\n\n#[derive(Clone, Debug, PartialEq, Eq, Serialize, Deserialize)]\npub struct Recent {\n    pub root: PathBuf,\n    pub id: String,\n    pub name: String,\n}\n\n#[derive(Clone, Debug, Default, PartialEq, Eq, Serialize, Deserialize)]\npub struct Profile {\n    pub recent: Vec<Recent>,\n    /// (collection, reference) pairs with a value in the Keychain.\n    pub secrets: Vec<(String, String)>,\n    /// Built-in collection files and the hash this desktop last wrote.\n    pub scm: BTreeMap<String, String>,\n    /// Absent in existing profiles: first use opens SCM. Closed is an\n    /// explicit preference, not another first-use marker.\n    #[serde(default)]\n    pub selection: Option<Selection>,\n}\n\n#[derive(Clone, Debug, PartialEq, Eq, Serialize, Deserialize)]\n#[serde(tag = \"kind\", rename_all = \"camelCase\", deny_unknown_fields)]\npub enum Selection {\n    BuiltIn,\n    Custom { root: PathBuf, id: String },\n    Closed,\n}\n\nimpl Profile {\n    pub fn remember(&mut self, recent: Recent) {\n        self.recent.retain(|r| r.root != recent.root);\n        self.recent.insert(0, recent);\n        self.recent.truncate(RECENT);\n    }\n}\n\n#[derive(Clone, Debug, PartialEq, Eq, Serialize, Deserialize)]\npub struct Draft {\n    pub document: Document,\n    pub fields: Fields,\n}\n\n/// Both versions kept before a conflict choice replaced either.\n#[derive(Clone, Debug, PartialEq, Eq, Serialize, Deserialize)]\npub struct Archive {\n    pub relative: String,\n    pub at: u64,\n    pub local: Fields,\n    pub disk_metadata: Option<String>,\n    pub disk_body: Option<String>,\n}\n\n#[derive(Clone, Debug, Default, PartialEq, Eq, Serialize, Deserialize)]\npub struct Scope {\n    pub open: Vec<String>,\n    pub selected: Option<String>,\n    pub environment: Option<String>,\n    /// Private environments by name (their TOML text).\n    pub private: BTreeMap<String, String>,\n    pub drafts: BTreeMap<String, Draft>,\n    pub archives: Vec<Archive>,\n}\n\nimpl Scope {\n    pub fn archive(&mut self, archive: Archive) {\n        self.archives.push(archive);\n        let excess = self.archives.len().saturating_sub(MAX_ARCHIVES);\n        self.archives.drain(..excess);\n    }\n}\n\n/// A save in progress: what each file held before and will hold after.\n#[derive(Clone, Debug, PartialEq, Eq, Serialize, Deserialize)]\npub struct Journal {\n    pub request: String,\n    pub relative: String,\n    pub files: Vec<(String, Option<String>, String)>,\n}\n\nfn failure(error: VaultError) -> PrivateFailure {\n    match error {\n        VaultError::Locked => PrivateFailure::Locked,\n        VaultError::Denied => PrivateFailure::Denied,\n        _ => PrivateFailure::Unavailable,\n    }\n}\n\n/// The profile key (created on first use when `create`).\npub(crate) fn key(keychain: &dyn Vault, create: bool) -> Result<Option<[u8; 32]>, PrivateFailure> {\n    let record = key_record();\n    let bytes = match keychain.get(&record) {\n        Ok(bytes) => bytes,\n        Err(VaultError::NotFound) if create => {\n            let fresh = crate::offline::new_key().ok_or(PrivateFailure::Unavailable)?;\n            keychain.put(&record, &fresh).map_err(failure)?;\n            fresh\n        }\n        Err(VaultError::NotFound) => return Ok(None),\n        Err(e) => return Err(failure(e)),\n    };\n    let key: [u8; 32] = bytes\n        .as_slice()\n        .try_into()\n        .map_err(|_| PrivateFailure::Unreadable)?;\n    Ok(Some(key))\n}\n\nfn path(root: &Path, name: &str) -> PathBuf {\n    let digest = crate::offline::digest(&format!(\"api-client:{name}\"));\n    root.join(format!(\"{}.sealed\", &digest[..32]))\n}\n\npub(crate) fn aad(name: &str) -> Vec<u8> {\n    format!(\"{SCHEMA}:{name}\").into_bytes()\n}\n\nfn load<T: DeserializeOwned + Default>(\n    root: &Path,\n    keychain: &dyn Vault,\n    name: &str,\n    limit: usize,\n) -> Result<T, PrivateFailure> {\n    use std::io::Read;\n    let file = path(root, name);\n    let mut sealed = Vec::new();\n    match std::fs::File::open(&file) {\n        Ok(f) => {\n            f.take(limit as u64 + 1024)\n                .read_to_end(&mut sealed)\n    inner: &Arc<Inner>,\n    root: &std::path::Path,\n    folder: PathBuf,\n    built_in: bool,\n    expected_id: Option<String>,\n) -> WorkbenchResult {\n    let keychain = Arc::clone(&inner.adapters.keychain);\n    let private = root.to_path_buf();\n    let opened = blocking(Err(WorkbenchProblem::Unavailable), move || {\n        read_opening(&private, keychain.as_ref(), &folder, expected_id.as_deref())\n    })\n    .await;\n    let opening = match opened {\n        Ok(o) => o,\n        Err(p) => return refused(p),\n    };\n    let name = opening.catalog.name.clone();\n    let recent = Recent {\n        root: opening.catalog.root.clone(),\n        id: opening.catalog.id.clone(),\n        name: name.clone(),\n    };\n    let profile = lock(inner).ok().and_then(|s| s.workbench.profile.clone());\n    if let Some(mut next) = profile {\n        next.selection = Some(if built_in {\n            Selection::BuiltIn\n        } else {\n            Selection::Custom {\n                root: recent.root.clone(),\n                id: recent.id.clone(),\n            }\n        });\n        if !built_in {\n            next.remember(recent);\n        }\n        if let Err(f) = store_profile(inner, root, next).await {\n            return refused(WorkbenchProblem::Private(f));\n        }\n    }\n    {\n        let Ok(mut state) = lock(inner) else {\n            return refused(WorkbenchProblem::Unavailable);\n        };\n        state.workbench.editing.clear();\n        state.workbench.sending.leave();\n        state.workbench.git = None;\n        state.workbench.import = None;\n        state.workbench.open = Some(Open {\n            root: opening.catalog.root.clone(),\n            recovered: opening.documents.keys().cloned().collect(),\n            scope: opening.scope,\n            built_in,\n            catalog: opening.catalog,\n            data: opening.data,\n            unsaved: None,\n            documents: opening.documents,\n            conflicts: opening.conflicts,\n            interrupted: opening.interrupted,\n        });\n    }\n    WorkbenchResult::Opened { name }\n}\n\nasync fn open_built_in(\n    inner: &Arc<Inner>,\n    root: &std::path::Path,\n    profile: Profile,\n) -> WorkbenchResult {\n    let folder = scm::folder(root);\n    let target = folder.clone();\n    let previous = profile.scm.clone();\n    let written = blocking(Err(ProjectProblem::Io), move || {\n        let _placement = crate::sessions::placement();\n        scm::refresh(&target, &previous)\n    })\n    .await;\n    let (record, _) = match written {\n        Ok(done) => done,\n        Err(p) => return refused(WorkbenchProblem::Project(p)),\n    };\n    let mut next = profile;\n    next.scm = record;\n    if let Err(f) = store_profile(inner, root, next).await {\n        return refused(WorkbenchProblem::Private(f));\n    }\n    open_at(inner, root, folder, true, None).await\n}\n\n/// Reads the collection's inventory again (after a write).\nasync fn rediscover(inner: &Arc<Inner>) {\n","exit_code":0,"status":"completed"}}
