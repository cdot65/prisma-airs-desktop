{"type":"item.completed","item":{"id":"item_26","type":"command_execution","command":"/bin/zsh -lc 'cat apps/desktop/src/v2/workbench/request-presentation.test.ts && git diff f1e58da5cdeb1c67eed650b186081661cefc2fa2 -- apps/desktop/src/v2/workbench/api-client.test.tsx'","aggregated_output":"import { describe, expect, it } from 'vitest'\nimport { prettyJson } from './request-rows'\n\ndescribe('API JSON presentation preserves JSON tokens', () => {\n    it('indents without rounding large numbers or rewriting string escapes', () => {\n        const raw = '{\"integer\":9007199254740993,\"decimal\":1.2300e+50,\"escaped\":\"\\\\u0061\\\\/\",\"duplicate\":1,\"duplicate\":2}'\n        const shown = prettyJson(raw)\n        expect(shown).toContain('9007199254740993')\n        expect(shown).toContain('1.2300e+50')\n        expect(shown).toContain('\"\\\\u0061\\\\/\"')\n        expect(shown?.match(/\"duplicate\"/g)).toHaveLength(2)\n        expect(raw).toBe('{\"integer\":9007199254740993,\"decimal\":1.2300e+50,\"escaped\":\"\\\\u0061\\\\/\",\"duplicate\":1,\"duplicate\":2}')\n    })\n\n    it('rejects invalid or truncated JSON instead of presenting a repaired response', () => {\n        for (const raw of ['', '  \\n', '{\"x\":', '{\"x\":1,}', 'true false', '[1,', '{\"x\":\"unterminated']) expect(prettyJson(raw)).toBeNull()\n    })\n\n    it('formats empty/nested containers and primitive values without changing their tokens', () => {\n        expect(prettyJson('[{},[],true,false,null,-0,1e3,\"a b\"]')).toBe('[\\n  {},\\n  [],\\n  true,\\n  false,\\n  null,\\n  -0,\\n  1e3,\\n  \"a b\"\\n]')\n        expect(prettyJson('  \"\\\\u0061\"  ')).toBe('\"\\\\u0061\"')\n    })\n\n    it('falls back to raw presentation for excessively large or deeply nested previews', () => {\n        expect(prettyJson(JSON.stringify('x'.repeat(256 * 1024)))).toBeNull()\n        expect(prettyJson('['.repeat(65) + '0' + ']'.repeat(65))).toBeNull()\n    })\n})\ndiff --git a/apps/desktop/src/v2/workbench/api-client.test.tsx b/apps/desktop/src/v2/workbench/api-client.test.tsx\nindex b34cdf01..7cf40470 100644\n--- a/apps/desktop/src/v2/workbench/api-client.test.tsx\n+++ b/apps/desktop/src/v2/workbench/api-client.test.tsx\n@@ -213,15 +213,158 @@ async function open(snapshot = board(), extra?: (request: WorkbenchRequest) => W\n     })\n     const line = () => document_().querySelector('[data-slot=\"workbench-request-line\"]') as HTMLElement\n     await waitFor(() => expect(line()).not.toBeNull())\n+    // The editor publishes its footer state through a passive effect after its first DOM commit.\n+    await waitFor(() => expect(document_().querySelector('[data-slot=\"workbench-save-status\"]')).not.toBeNull())\n     return { native, requests, user, tree, line }\n }\n const document_ = () => globalThis.document\n \n describe('C41 API Client board', () => {\n+    it('colors one complete editable URL template without duplicating its base variable', async () => {\n+        const url = '{{scm_base}}/profiles/{{profile_id}}?value=hello%20world'\n+        const { requests, user, line } = await open(board(), (r) => r.kind === 'openRequest' ? document({ url }) : null)\n+        const input = within(line()).getByRole('textbox', { name: 'URL' })\n+        expect(input).toHaveValue(url)\n+        const template = input.closest('[data-slot=\"template-input\"]') as HTMLElement\n+        expect(template).not.toBeNull()\n+        expect(template.querySelectorAll('[data-variable]')).toHaveLength(2)\n+        expect(template.textContent).toBe(url)\n+        await user.click(input)\n+        await user.keyboard('{Control>}a{/Control}')\n+        await user.copy()\n+        expect(await navigator.clipboard.readText()).toBe(url)\n+        await user.keyboard('{Meta>}s{/Meta}')\n+        await waitFor(() => expect(requests.filter((r) => r.kind === 'save')).toHaveLength(1))\n+        expect(requests.filter((r) => r.kind === 'save')[0]).toMatchObject({ fields: { url } })\n+        await user.click