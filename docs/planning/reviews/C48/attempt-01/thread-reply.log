{"type":"item.completed","item":{"id":"item_65","type":"command_execution","command":"/bin/zsh -lc \"sed -n '345,460p' apps/desktop/src/styles/tokens.css && cat apps/desktop/src/v2/workbench/calls-panel.tsx | head -110 && cat apps/desktop/src/v2/workbench/test-cases.tsx | head -105\"","aggregated_output":"     * layout but stay in the accessible name. */\n    [data-v2-rail] [data-v2-stack] {\n        flex-direction: column;\n        align-items: stretch;\n    }\n    [data-v2-rail] [data-v2-stack] > * {\n        width: 100%;\n    }\n    /* Collapsed: labels leave the layout but stay in the accessible name (rail and header). */\n    [data-v2-rail] [data-v2-label],\n    [data-v2-header] [data-v2-label] {\n        position: absolute;\n        width: 1px;\n        height: 1px;\n        overflow: hidden;\n        clip: rect(0 0 0 0);\n        white-space: nowrap;\n    }\n    /* Collapsed: the product children and the status rows leave the rail (C35). */\n    [data-v2-rail] [data-v2-collapse] {\n        display: none !important;\n    }\n    [data-v2-rail] [data-v2-stack] > * {\n        padding-left: 0 !important;\n        padding-right: 0 !important;\n    }\n    [data-v2-header] [data-v2-search] {\n        width: auto !important;\n        flex: 1 1 120px !important;\n        min-width: 0;\n    }\n    /* The Harness's rail and Decisions aside stack above and below the transcript when the page is narrow (C38).\n       Wide, the columns are one flex line bounded by the page, so each column scrolls on its own. */\n    [data-v2-shell] [data-slot='harness-columns'] {\n        flex-wrap: wrap;\n    }\n    [data-v2-shell] [data-slot='harness-rail'],\n    [data-v2-shell] [data-slot='harness-decisions'] {\n        flex: 1 1 100% !important;\n        border-left: 0 !important;\n        border-right: 0 !important;\n        border-bottom: 1px solid var(--v2-rule);\n    }\n    /* Home's attention and quick-action sections stack when the page is narrow (C36). */\n    [data-v2-shell] [data-slot='home-lower'] {\n        grid-template-columns: minmax(0, 1fr) !important;\n    }\n    /* The Inbox's list and detail cards stack when the page is narrow (C37): each card takes its\n       own height (the list up to half the viewport, scrolling inside) and the page scrolls. */\n    [data-v2-shell] [data-slot='inbox-columns'] {\n        grid-template-columns: minmax(0, 1fr) !important;\n        grid-template-rows: auto auto;\n        min-height: auto !important;\n        flex-grow: 0 !important;\n    }\n    [data-v2-shell] [data-slot='inbox-list'] {\n        min-height: 240px;\n        max-height: 50vh;\n    }\n}\n/* C39a attempt-01 R1: below the width that fits the inventory's columns (900×600 at 200% is 450 CSS px) the rows stack their cells. */\n@media (max-width: 760px) {\n    [data-v2-shell] [data-slot='administration-row'] {\n        grid-template-columns: minmax(0, 1fr) !important;\n        gap: 4px !important;\n    }\n    /* The header row leaves the picture but not the accessibility tree; each stacked cell shows its column's\n       name (C39b attempt-01 R4). */\n    [data-v2-shell] [data-slot='administration-table'] > [role='row']:first-child {\n        position: absolute;\n        width: 1px;\n        height: 1px;\n        overflow: hidden;\n        clip: rect(0 0 0 0);\n        white-space: nowrap;\n    }\n    [data-v2-shell] [data-slot='administration-row'] > [role='cell'][data-label]::before {\n        content: attr(data-label) ': ';\n        font-weight: 600;\n        color: var(--v2-faint);\n    }\n    [data-v2-shell] [data-slot='administration-row'] > [role='cell']:last-child {\n        justify-content: flex-start;\n    }\n}\n/* C39b attempt-01: below the width that fits a table's columns (900×600 at 200% is 450 CSS px) the v2 admin tables stack their cells and hide the header row. */\n@media (max-width: 760px) {\n    [data-v2-shell] [data-slot='admin-tab'] [role='table'] > [role='row'] {\n        grid-template-columns: minmax(0, 1fr) !important;\n        gap: 4px !important;\n    }\n    [data-v2-shell] [data-slot='admin-tab'] [role='table'] > [role='row']:first-child {\n        display: none;\n    }\n    [data-v2-shell] [data-slot='admin-tab'] [role='table'] [role='cell'] {\n        white-space: normal;\n    }\n}\n/* Narrower still (a 900-point window at 200%): the request tree sits above the editor instead of beside it. */\n@media (max-width: 760px) {\n    [data-v2-shell] [data-slot='api-body'] {\n        flex-wrap: wrap;\n    }\n    [data-v2-shell] [data-slot='request-tree'] {\n        width: 100% !important;\n        max-height: 40vh;\n        border-right: 0 !important;\n        border-bottom: 1px solid var(--v2-rule);\n    }\n}\n/* Test Cases (C40): below 760px (a 900-point window at 200%) each row is two lines: the case and its product, the\n   input, then the result and the action; the five-column grid cannot hold readable cells there. */\n@media (max-width: 760px) {\n    [data-v2-shell] [data-slot='cases-table'] [role='row'] {\n        grid-template-columns: minmax(0, 1fr) auto !important;\n        row-gap: 8px !important;\nimport type { CallView, ShellSnapshot } from '@prisma-airs/desktop-contracts'\nimport type { Dispatch } from '../../modules/tenants/dispatch'\nimport { CALLS_COPY as C } from './copy'\n\n/** How long a call took, as the API Client's completion says it. */\nconst durationOf = (ms: number) => (ms < 1000 ? `${ms} ms` : `${(ms / 1000).toFixed(1)} s`)\n\n/**\n * \"Show the calls\" (C33, DESIGN-V2 §3): beside every destination while the\n * Rust-owned preference is on, the calls this app made for the active\n * tenant, newest last, as the core recorded them: the request line without\n * its query, header names (never values), the credential by kind (the core\n * attached it), and the response status, duration and content type. No body\n * is ever kept. Rendered like the API Client's response line.\n */\nexport function CallsPanel({ snapshot, dispatch, onClose }: { snapshot: ShellSnapshot; dispatch: Dispatch; onClose?: () => void }) {\n    const calls = snapshot.calls\n    if (!snapshot.showCalls || calls === undefined) return null\n    return (\n        <aside aria-label={C.title} data-slot='calls-panel' className='flex min-w-0 flex-col gap-3 p-4 text-[13px]' style={{ width: '100%' }}>\n            <div className='flex items-center justify-between gap-2'>\n                <h2 className='text-[15px] font-semibold'>{C.title}</h2>\n                <button type='button' aria-label={onClose ? C.closeExplain : undefined} className='h-8 rounded-[7px] border px-3 text-[12px]' style={{ borderColor: 'var(--v2-rule)' }} onClick={() => (onClose ? onClose() : void dispatch({ kind: 'setShowCalls', on: false }))}>\n                    {onClose ? C.close : C.hide}\n                </button>\n            </div>\n            <p className='text-[12px]' style={{ color: 'var(--v2-soft)' }}>\n                {C.note}\n            </p>\n            {calls.length === 0 ? (\n                <p data-slot='calls-empty'>{C.empty}</p>\n            ) : (\n                <ol className='flex flex-col gap-2' data-slot='calls-list'>\n                    {calls.map((call) => (\n                        <CallItem key={call.sequence} call={call} />\n                    ))}\n                </ol>\n            )}\n        </aside>\n    )\n}\n\nfunction CallItem({ call }: { call: CallView }) {\n    const outcome = call.status !== null ? String(call.status) : C.failed\n    return (\n        <li className='flex flex-col gap-1 rounded-[10px] border p-3' style={{ borderColor: 'var(--v2-rule)' }} data-slot='call' data-purpose={call.purpose}>\n            <div className='flex flex-wrap items-baseline gap-x-2 text-[12px]' style={{ color: 'var(--v2-soft)' }}>\n                <span>{C.purpose[call.purpose]}</span>\n                <span>\n                    {outcome} · {durationOf(call.durationMs)}\n                </span>\n            </div>\n            <p className='break-all font-mono text-[12px]'>\n                <span className='font-semibold' style={{ color: 'var(--v2-get)' }}>\n                    {call.method}\n                </span>{' '}\n                {call.origin}\n                {call.path}\n                {call.query ? <span style={{ color: 'var(--v2-soft)' }}> ({C.query})</span> : null}\n            </p>\n            <p className='text-[12px]'>{C.credential[call.credential]}</p>\n            <details className='text-[12px]'>\n                <summary className='cursor-pointer'>\n                    {C.requestHeaders} · {C.bytes(call.requestBytes)}\n                </summary>\n                <p className='break-all font-mono'>{call.requestHeaders.join(', ')}</p>\n                <p className='mt-1' style={{ color: 'var(--v2-soft)' }}>\n                    {C.responseHeaders}\n                    {call.contentType ? ` · ${call.contentType}` : ''}\n                </p>\n                <p className='break-all font-mono'>{call.responseHeaders.join(', ')}</p>\n            </details>\n        </li>\n    )\n}\nimport { PageIntro } from '../page-intro'\nimport { forwardRef, useEffect, useId, useMemo, useRef, useState } from 'react'\nimport { createPortal } from 'react-dom'\nimport type { CaseProduct, CaseView, FeatureId, Intent, LibraryNotice, ShellSnapshot } from '@prisma-airs/desktop-contracts'\nimport { type Dispatch, outcomeMessage } from '../../modules/tenants/dispatch'\nimport { clockOf } from '../copy'\nimport { Btn, Field } from '../controls'\nimport { Glyph, type GlyphName } from '../icons'\nimport { Modal } from '../modal'\nimport { useShellStore } from '../store'\nimport { ADMIN_COPY } from '../admin/copy'\nimport { CASES_COPY as C, PRODUCT_LABEL } from './copy'\n\nexport interface TestCasesProps {\n    snapshot: ShellSnapshot\n    dispatch: Dispatch\n    onNavigate: (feature: FeatureId) => void\n}\n\n/** Cases shown per page (prototype `caseRows`). */\nexport const PAGE_SIZE = 20\n\nconst PRODUCTS: CaseProduct[] = ['runtime-security', 'ai-gateway', 'ai-red-teaming', 'model-security', 'skill-scanning']\nconst CASE_PROBLEM_TEXT = ADMIN_COPY.playground.caseProblem\n\n/** What a library notice says (the operation's established outcome). */\nfunction noticeText(notice: LibraryNotice): string {\n    switch (notice.kind) {\n        case 'saved':\n            return C.notice.saved(notice.name)\n        case 'imported':\n            return C.notice.imported(notice.added)\n        case 'examplesAdded':\n            return C.notice.examplesAdded(notice.added)\n        case 'copied':\n            return C.notice.copied(notice.tenant)\n        case 'catalogUnavailable':\n            return C.notice.catalogUnavailable\n        case 'fileUnreadable':\n            return C.notice.fileUnreadable\n    }\n}\n\n/** The result pill's colours and glyph by verdict (R2App: blocked, flagged, allowed; not determined as a flag). */\nconst TONE: Record<string, { fg: string; bg: string; glyph: GlyphName }> = {\n    block: { fg: 'var(--v2-block)', bg: 'var(--v2-block-bg)', glyph: 'ban' },\n    alert: { fg: 'var(--v2-flag)', bg: 'var(--v2-flag-bg)', glyph: 'alert' },\n    allow: { fg: 'var(--v2-ok)', bg: 'var(--v2-ok-bg)', glyph: 'check' },\n    unknown: { fg: 'var(--v2-flag)', bg: 'var(--v2-flag-bg)', glyph: 'info' },\n}\n\n/** The text a case is searched by: its name, pack and input. */\nconst haystack = (c: CaseView) => `${c.name} ${c.pack ?? ''} ${c.prompt} ${c.response}`.toLowerCase()\n\nconst faint = { color: 'var(--v2-faint)' }\nconst soft = { color: 'var(--v2-soft)' }\nconst GRID = 'minmax(0, 1.6fr) minmax(0, 1.2fr) minmax(0, 2.2fr) minmax(0, 176px) minmax(0, 190px)'\n\n/**\n * Test Cases as R2App draws it (C40): the title row with Load starter\n * packs… and New case, the Explain banner, one table card (search, product\n * pills with counts, the rows with the result pill and the action, the\n * footer with the range and pages), the packs and new-case dialogs and the\n * detail sheet. The C33 behaviour is unchanged: a Runtime Security case\n * opens in the Playground where the operator runs the scan; any other\n * product's case is inspected only. Nothing on this screen dispatches a\n * scan (V2-T15).\n */\nexport const TestCases = forwardRef<HTMLHeadingElement, TestCasesProps>(function TestCases({ snapshot, dispatch, onNavigate }, _ref) {\n    const tenant = snapshot.tenants.find((t) => t.id === snapshot.active?.tenant) ?? null\n    const context = snapshot.active?.context ?? null\n    const library = snapshot.library\n    const [query, setQuery] = useState('')\n    const [product, setProduct] = useState<CaseProduct | null>(null)\n    const [page, setPage] = useState(0)\n    const [inspected, setInspected] = useState<string | null>(null)\n    const [authoring, setAuthoring] = useState(false)\n    const [packs, setPacks] = useState(false)\n    const [menu, setMenu] = useState<string | null>(null)\n    const [message, setMessage] = useState<string | null>(null)\n    const others = snapshot.tenants.filter((t) => t.id !== tenant?.id)\n    const ready = library.state === 'ready'\n\n    /** Dispatches a library intent; a refusal the library itself explains (its problem) is not said twice. */\n    async function send(intent: Intent) {\n        const outcome = await dispatch(intent)\n        setMessage(outcome.kind === 'admitted' || (outcome.kind === 'refused' && outcome.refusal === 'invalidInput') ? null : outcomeMessage(outcome))\n        return outcome\n    }\n\n    // The library opens for the tenant shown (as the legacy view does).\n    useEffect(() => {\n        if (context) void dispatch({ kind: 'openLibrary', context })\n    }, [context, dispatch])\n\n    const cases = library.cases\n    const counts = useMemo(() => {\n        const by = new Map<CaseProduct, number>()\n        for (const c of cases) by.set(c.product, (by.get(c.product) ?? 0) + 1)\n        return by\n    }, [cases])\n    const needle = query.trim().toLowerCase()\n    const matching = cases.filter((c) => (product === null || c.product === product) && (needle === '' || haystack(c).includes(needle)))\n    const pages = Math.max(1, Math.ceil(matching.length / PAGE_SIZE))\n    const shownPage = Math.min(page, pages - 1)\n","exit_code":0,"status":"completed"}}
