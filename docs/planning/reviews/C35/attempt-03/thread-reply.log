                                                            className='flex h-[31px] min-h-0 w-full items-center gap-2 rounded-[7px] px-2 text-left text-[12.5px]'
                                                            style={{ background: shown ? 'var(--v2-inset)' : 'transparent', color: 'var(--v2-ink)', fontWeight: shown ? 600 : 400 }}
                                                        >
                                                            <Glyph name={PRODUCT_GLYPHS[p.id]} size={14} color='var(--v2-soft)' />
                                                            <span data-v2-label className='flex-grow truncate'>
                                                                {p.label}
                                                            </span>
                                                            {gated && (
                                                                <span data-v2-label className='rounded-full px-1.5 text-[12px] font-bold' style={{ padding: '1px 6px', background: 'var(--v2-acc-soft)', color: 'var(--v2-acc)' }}>
                                                                    {SHELL_COPY.newTag}
                                                                </span>
                                                            )}
                                                            {count > 0 && (
                                                                <span data-v2-label data-slot='product-badge' aria-label={SHELL_COPY.needAction(count)} className='text-[11px] font-semibold' style={{ color: 'var(--v2-faint)' }}>
                                                                    {count}
                                                                </span>
                                                            )}
                                                        </button>
                                                    </li>
                                                )
                                            })}
                                        </ul>
                                    )}
                                </li>
                            )
                        })}
                </ul>
                <div className='flex flex-col text-[12px]' data-slot='status-block' style={{ gap: 6, padding: '12px 10px 4px', marginTop: 8, borderTop: '1px solid var(--v2-rule)', color: 'var(--v2-soft)' }}>
                    <button
                        type='button'
                        data-v2-collapse=''
                        data-slot='connection'
                        data-tone={readStatus.tone}
                        title={`${readStatus.text} · ${HOME_COPY.readNow}`}
                        onClick={props.onReadNow}
                        disabled={!tenant}
                        className='flex min-h-0 w-full items-center rounded-[6px] text-left text-[12px]'
                        style={{ gap: 7, color: 'var(--v2-soft)' }}
                    >
                        <span aria-hidden='true' className='size-2 shrink-0 rounded-full' style={{ background: readStatus.tone === 'allowed' ? 'var(--v2-ok)' : readStatus.tone === 'blocked' ? 'var(--v2-block)' : readStatus.tone === 'flagged' ? 'var(--v2-flag)' : 'var(--v2-faint)' }} />
                        <span className='flex-grow'>{tenant ? SHELL_COPY.connected : SHELL_COPY.tenantNone}</span>
                        <span className='truncate text-right font-semibold' style={{ color: readStatus.tone === 'allowed' ? 'var(--v2-faint)' : readStatus.tone === 'info' ? 'var(--v2-faint)' : 'var(--v2-flag)' }}>
                            {readStatus.text}
                        </span>
                    </button>
                    {(
                        [
                            ['bot', SHELL_COPY.harnessRow, harnessText, 'harness-status'],
                            ['lock', SHELL_COPY.keychainRow, keychainText, 'keychain-status'],
                            ['clock', SHELL_COPY.jobsRow, jobsText, 'jobs-status'],
                        ] as const
                    ).map(([glyph, label, value, slot]) => (
                        <div key={slot} data-slot={slot} data-v2-collapse='' className='flex items-center text-[12px]' style={{ gap: 7, color: 'var(--v2-soft)' }}>
                            <Glyph name={glyph} size={12} stroke={2} />
                            <span className='flex-grow'>{label}</span>
                            <span className='truncate' style={{ color: 'var(--v2-faint)' }}>
                    <main className='flex-grow p-6'>
                        <ImportView snapshot={snapshot} dispatch={dispatch} />
                    </main>
                </div>
            )
        }
        return (
            <div data-v2-shell=''>
                <Wizard
                    snapshot={snapshot}
                    dispatch={dispatch}
                    observeManagement={(operation) => client.observeManagement(operation)}
                    mode='firstRun'
                    onClose={() => undefined}
                    onNavigate={(feature) => void v2Navigate(feature)}
                />
            </div>
        )
    }
    if (snapshot.uiVariant === 'v2') {
        return (
            <V2Shell
                snapshot={snapshot}
                appearancePending={pending}
                status={failure ?? status}
                onNavigate={(feature) => void v2Navigate(feature)}
                onSetAppearance={(theme) => void v2Preference('The appearance change', { kind: 'setAppearance', theme })}
                onSetShowCalls={(on) => void v2Preference('The preference change', { kind: 'setShowCalls', on })}
                onSwitchTenant={(tenant, resolution) => {
                    // The target is captured now: a late refusal still names it. A
                    // pending-decision refusal is not a toast: the snapshot carries
                    // the guard the shell renders (I1).
                    const label = snapshot.tenants.find((t) => t.id === tenant)?.label ?? tenant
                    void v2Preference(SHELL_COPY.switchTo(label), { kind: 'selectTenant', tenant, resolution: resolution ?? null }, ['decisionPending'])
                }}
                onReadNow={() => {
                    // The palette's Read now is the same finite read of every chosen product (I4).
                    const active = snapshot.active
                    if (!active) return
                    const label = snapshot.tenants.find((t) => t.id === active.tenant)?.label ?? active.tenant
                    void v2Preference(SHELL_COPY.readOf(label), { kind: 'readTenant', context: active.context })
                }}
                onRetry={(what, intent) => void v2Preference(what, intent)}
                onAct={v2Act}
                dispatch={dispatch}
                client={client}
            />
        )
    }
    return (
        <DesktopShell
            snapshot={snapshot}
            active={active ?? snapshot.features[0]?.id ?? 'settings'}
            paletteOpen={paletteOpen}
            appearancePending={pending}
            status={failure ?? status}
            onNavigate={setActive}
            onOpenPalette={() => setPaletteOpen(true)}
            onClosePalette={() => setPaletteOpen(false)}
            onSetAppearance={(theme) => void setAppearance(theme)}
            dispatch={dispatch}
            client={client}
        />
    )
}
import { GENERAL_THEMES, applyThemeAttribute, type GeneralThemeId } from '@ai-security-academy/presentation'
import type { Theme } from '@prisma-airs/desktop-contracts'

/** Maps the desktop preference to a general shared theme (never an earned skin). */
export function resolveTheme(theme: Theme, prefersDark: boolean): GeneralThemeId {
    if (theme === 'light') return GENERAL_THEMES.light
    if (theme === 'dark') return GENERAL_THEMES.dark
    return prefersDark ? GENERAL_THEMES.dark : GENERAL_THEMES.light
}

const darkQuery = () =>
    typeof window.matchMedia === 'function'
        ? window.matchMedia('(prefers-color-scheme: dark)')
        : null

/** Applies the preference now and follows OS changes while it is `system`. */
export function followAppearance(theme: Theme): () => void {
    const query = darkQuery()
    const apply = () => applyThemeAttribute(resolveTheme(theme, query?.matches ?? true))
    apply()
    if (theme !== 'system' || !query) return () => undefined
    query.addEventListener('change', apply)
    return () => query.removeEventListener('change', apply)
}
