                                className='flex h-8 items-center justify-between gap-2 rounded-[6px] px-2.5 text-left disabled:cursor-not-allowed'
                                style={{ color: onChangeWorkspace ? 'var(--v2-ink)' : 'var(--v2-faint)' }}
