+#!/usr/bin/env python3
+"""Composes a parity image: the prototype board on the left, the app's capture
+on the right, each shown at 1440×900, with a caption. Rendered by the headless
+browser (no image library is needed on this Mac).
+
+Usage: compose.py --left proto.png --right app.png --out composite.png
+       --title "Home · light" [--note "accessibility deviations…"]
+"""
+
+import argparse
+import base64
+import os
+import subprocess
+import sys
+import tempfile
+
+sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
+from dc_render import find_browser  # noqa: E402
+
+GAP, CAP = 24, 44
+
+
+def png_size(path):
+    import struct
+    with open(path, "rb") as f:
+        head = f.read(24)
+    return struct.unpack(">II", head[16:24])
+
+
+def data_url(path):
+    return "data:image/png;base64," + base64.b64encode(open(path, "rb").read()).decode("ascii")
+
+
+def main():
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--left", required=True)
+    ap.add_argument("--right", required=True)
+    ap.add_argument("--out", required=True)
+    ap.add_argument("--title", default="")
+    ap.add_argument("--note", default="")
+    ap.add_argument("--browser")
+    args = ap.parse_args()
+    # Each side is shown at the prototype's CSS size; the app capture (2x, window-sized) is scaled to the
+    # same width and its dead strip below the web area is cropped.
+    W, H = png_size(args.left)
+    width = W * 2 + GAP * 3
+    height = H + CAP * 2 + GAP
+    html = f"""<!doctype html><html><head><meta charset='utf-8'><style>
+html,body{{margin:0;background:#111;color:#eee;font:14px -apple-system,system-ui}}
+.row{{display:flex;gap:{GAP}px;padding:{GAP}px}}
+figure{{margin:0}} img{{display:block;width:{W}px;height:{H}px;object-fit:cover;object-position:top left;background:#fff}}
+figcaption{{height:{CAP}px;line-height:{CAP}px;font-weight:600}}
+.note{{padding:0 {GAP}px;height:{CAP}px;line-height:{CAP}px;color:#bbb;white-space:nowrap;overflow:hidden}}
+</style></head><body>
+<div class='row'>
+<figure><figcaption>Prototype · {args.title}</figcaption><img src='{data_url(args.left)}'></figure>
+<figure><figcaption>App · {args.title}</figcaption><img src='{data_url(args.right)}'></figure>
+</div>
+<div class='note'>{args.note}</div>
+</body></html>"""
+    with tempfile.TemporaryDirectory(prefix="parity-") as d:
+        path = os.path.join(d, "composite.html")
+        open(path, "w", encoding="utf-8").write(html)
+        cmd = [find_browser(args.browser), "--headless=new", "--disable-gpu", "--hide-scrollbars", "--force-device-scale-factor=1",
+               f"--window-size={width},{height}", f"--screenshot={os.path.abspath(args.out)}",
+               "--virtual-time-budget=1500", "--user-data-dir=" + os.path.join(d, "profile"), "file://" + path]
+        r = subprocess.run(cmd, capture_output=True, text=True, timeout=120)
+        if r.returncode != 0 or not os.path.exists(args.out):
+            sys.stderr.write(r.stderr[-2000:])
+            raise SystemExit("compose failed")
+    print(args.out)
+
+
+if __name__ == "__main__":
+    main()
diff --git a/tools/parity/dc-shim.js b/tools/parity/dc-shim.js
new file mode 100644
index 00000000..5f3b6c50
--- /dev/null
+++ b/tools/parity/dc-shim.js
@@ -0,0 +1,170 @@
+// A static renderer for the design prototype's component format (the
+// Claude Design `.dc.html` files under docs/architecture/ui-v2/prototype/),
+// enough to draw a board for a parity composite: the component's
+// `renderVals()` is evaluated once with its props and an empty state, and the
+// template is expanded. Event handlers are dropped (nothing is interactive),
+// `setState` after the first render is ignored, and timers never fire.
+//
+// Template features honoured, as the frozen files use them:
+//   {{path}} in text and attributes (a dotted path into the render values),
+//   <sc-if value="{{path}}">…</sc-if>, <sc-for list="{{path}}" as="x">…</sc-for>,
+//   <dc-import name="Other" attr="…"> (another component, attributes as props),
+//   <helmet> (its <style> is hoisted into <head>, interpolated).
+// Anything else is kept as plain markup.
+(function () {
+  'use strict';
+
+  class DCLogic {
+    constructor(props) {
+      this.props = props || {};
+      this.state = {};
+    }
+    setState(patch) {
+      // The first render reads an empty state; later patches are not re-rendered.
+      this.state = Object.assign({}, this.state, patch);
+    }
+  }
+  window.DCLogic = DCLogic;
+
+  const PATH = /^[A-Za-z_$][\w$]*(?:\.[A-Za-z_$][\w$]*)*$/;
+
+  function lookup(scopes, expr) {
+    const text = expr.trim();
+    if (text === 'true') return true;
+    if (text === 'false') return false;
+    if (text === 'null') return null;
+    if (/^-?\d+(\.\d+)?$/.test(text)) return Number(text);
+    if (PATH.test(text)) {
+      const parts = text.split('.');
+      for (let i = scopes.length - 1; i >= 0; i--) {
+        const scope = scopes[i];
+        if (scope && Object.prototype.hasOwnProperty.call(scope, parts[0])) {
+          let value = scope;
+          for (const part of parts) {
+            if (value === null || value === undefined) return undefined;
+            value = value[part];
+          }
+          return value;
+        }
+      }
+      return undefined;
+    }
+    // A JavaScript expression over the scopes (rare in the frozen files).
+    try {
+      const names = [];
+      const values = [];
+      for (const scope of scopes) {
+        for (const key of Object.keys(scope || {})) {
+          const at = names.indexOf(key);
+          if (at >= 0) values[at] = scope[key];
+          else {
+            names.push(key);
+            values.push(scope[key]);
+          }
+        }
+      }
+      return new Function(...names, 'return (' + text + ');')(...values);
+    } catch (e) {
+      return undefined;
+    }
+  }
+
+  function interpolate(scopes, text) {
+    return text.replace(/\{\{([^}]*)\}\}/g, (_, expr) => {
+      const value = lookup(scopes, expr);
+      return value === undefined || value === null ? '' : String(value);
+    });
+  }
+
+  function isHandler(name) {
+    return /^on[A-Z]/.test(name) || /^on[a-z]+$/.test(name);
+  }
+
+  // Expands a template subtree into `target` under the given scopes.
+  function expand(node, scopes, target, components) {
+    for (const child of Array.from(node.childNodes)) {
+      if (child.nodeType === Node.TEXT_NODE) {
+        target.appendChild(document.createTextNode(interpolate(scopes, child.data)));
+        continue;
+      }
+      if (child.nodeType !== Node.ELEMENT_NODE) continue;
+      const tag = child.tagName.toLowerCase();
+      if (tag === 'sc-if') {
+        const value = lookup(scopes, (child.getAttribute('value') || '').replace(/^\{\{|\}\}$/g, ''));
+        if (value) expand(child, scopes, target, components);
+        continue;
+      }
+      if (tag === 'sc-for') {
+        const list = lookup(scopes, (child.getAttribute('list') || '').replace(/^\{\{|\}\}$/g, ''));
+        const name = child.getAttribute('as') || 'item';
+        if (Array.isArray(list)) {
+          list.forEach((item, index) => {
+            const scope = {};
+            scope[name] = item;
+            scope[name + 'Index'] = index;
+            expand(child, scopes.concat([scope]), target, components);
+          });
+        }
+        continue;
+      }
+      if (tag === 'dc-import') {
+        const name = child.getAttribute('name');
+        const props = {};
+        for (const attr of Array.from(child.attributes)) {
+          if (attr.name === 'name' || attr.name.startsWith('hint-')) continue;
+          props[attr.name] = interpolate(scopes, attr.value);
+        }
+        const component = components[name];
+        if (component) {
+          const host = document.createElement('div');
+          host.setAttribute('data-dc-import', name);
+          render(component, props, host, components);
+          target.appendChild(host);
+        } else {
+          const missing = document.createElement('div');
+          missing.textContent = '[missing component ' + name + ']';
+          target.appendChild(missing);
+        }
+        continue;
+      }
+      // localName: the uppercase tagName would make an unknown (inline) element.
+      const out = document.createElementNS(child.namespaceURI, child.localName);
+      for (const attr of Array.from(child.attributes)) {
+        if (isHandler(attr.name) || attr.name.startsWith('hint-')) continue;
+        const value = interpolate(scopes, attr.value);
+        // A boolean attribute whose expression was false is left out.
+        if (/^(disabled|checked|selected|hidden|readonly|open)$/i.test(attr.name) && (value === '' || value === 'false')) continue;
+        out.setAttribute(attr.name, value);
+      }
+      expand(child, scopes, out, components);
+      target.appendChild(out);
+    }
+  }
+
+  // Renders one component (its template and logic) into `host`.
+  function render(component, props, host, components) {
+    const Logic = component.logic;
+    const instance = new Logic(props);
+    const vals = instance.renderVals() || {};
+    const scopes = [props, vals];
+    const template = document.createElement('template');
+    template.innerHTML = component.template;
+    const root = template.content;
+    for (const helmet of Array.from(root.querySelectorAll('helmet'))) {
+      for (const style of Array.from(helmet.querySelectorAll('style'))) {
+        const hoisted = document.createElement('style');
+        hoisted.textContent = interpolate(scopes, style.textContent || '');
+        document.head.appendChild(hoisted);
+      }
+      helmet.remove();
+    }
+    expand(root, scopes, host, components);
+  }
+
+  // Entry: `window.DC_RENDER = { root: 'R2App', props: {...}, components: {R2App: {template, logic}, …} }`.
+  window.dcRender = function (spec) {
+    const host = document.getElementById('dc-root');
+    render(spec.components[spec.root], spec.props, host, spec.components);
+    document.documentElement.setAttribute('data-dc-rendered', '1');
+  };
+})();
diff --git a/tools/parity/dc_render.py b/tools/parity/dc_render.py
new file mode 100644
index 00000000..fe1b9cee
--- /dev/null
+++ b/tools/parity/dc_render.py
@@ -0,0 +1,114 @@
+#!/usr/bin/env python3
+"""Renders a board of the frozen design prototype to a PNG with a headless
+browser, for the parity composites (docs/planning/p09-recut.md).
+
+The prototype files are Claude Design components whose runtime is not in the
+repository; tools/parity/dc-shim.js is a static stand-in that expands the
+template once from `renderVals()`. Nothing is interactive in the output.
+
+Usage: dc_render.py --board R2App --out home-light.png [--prop start=home]
+       [--prop theme=light] [--width 1440 --height 900]
+       [--browser /path/to/chrome-headless-shell]
+"""
+
+import argparse
+import glob
+import json
+import os
+import re
+import subprocess
+import sys
+import tempfile
+
+ROOT = os.path.dirname(os.path.dirname(os.path.dirname(os.path.abspath(__file__))))
+PROTOTYPE = os.path.join(ROOT, "docs/architecture/ui-v2/prototype")
+SHIM = os.path.join(os.path.dirname(os.path.abspath(__file__)), "dc-shim.js")
+
+
+def find_browser(explicit):
+    if explicit:
+        return explicit
+    candidates = glob.glob(os.path.expanduser("~/Library/Caches/ms-playwright/chromium_headless_shell-*/chrome-headless-shell-mac-arm64/chrome-headless-shell"))
+    candidates += ["/Applications/Google Chrome.app/Contents/MacOS/Google Chrome"]
+    for c in sorted(candidates, reverse=True):
+        if os.path.exists(c):
+            return c
+    raise SystemExit("no headless browser found; pass --browser")
+
+
+def component(name):
+    """A component's template (inside <x-dc>) and logic (the x-dc script)."""
+    text = open(os.path.join(PROTOTYPE, f"{name}.dc.html"), encoding="utf-8").read()
+    template = re.search(r"<x-dc>(.*)</x-dc>", text, re.S)
+    script = re.search(r"<script type=\"text/x-dc\"[^>]*>(.*?)</script>", text, re.S)
+    if not template or not script:
+        raise SystemExit(f"{name}: not a dc component")
+    logic = script.group(1)
+    if "class Component" not in logic:
+        raise SystemExit(f"{name}: no Component class")
+    imports = set(re.findall(r'<dc-import name="([A-Za-z0-9_]+)"', template.group(1)))
+    return template.group(1), logic, imports
+
+
+def page(root, props, width, height):
+    components = {}
+    pending = [root]
+    while pending:
+        name = pending.pop()
+        if name in components:
+            continue
+        template, logic, imports = component(name)
+        components[name] = (template, logic)
+        pending.extend(imports)
+    parts = [
+        "<!doctype html><html><head><meta charset='utf-8'>",
+        # The board's root is fixed at 1440×900 in its own style; the viewport's size wins so a
+        # capture of a shorter window compares like for like (the board lays out by flex).
+        "<style>html,body{margin:0;padding:0;background:#fff} #dc-root{width:%dpx;height:%dpx;overflow:hidden} #dc-root>[data-theme]{width:%dpx!important;height:%dpx!important;border-radius:0!important;border:0!important}</style>" % (width, height, width, height),
+        "<script>", open(SHIM, encoding="utf-8").read(), "</script>",
+        "</head><body><div id='dc-root'></div>",
+    ]
+    for name, (template, _) in components.items():
+        parts.append(f"<template id='tpl-{name}'>{template}</template>")
+    parts.append("<script>const COMPONENTS = {};</script>")
+    for name, (_, logic) in components.items():
+        # Each component's `class Component extends DCLogic` is scoped per IIFE.
+        parts.append("<script>(function(){ %s\nCOMPONENTS[%s] = { template: document.getElementById('tpl-%s').innerHTML, logic: Component }; })();</script>" % (logic, json.dumps(name), name))
+    parts.append("<script>window.dcRender({ root: %s, props: %s, components: COMPONENTS });</script>" % (json.dumps(root), json.dumps(props)))
+    parts.append("</body></html>")
+    return "\n".join(parts)
+
+
+def main():
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--board", required=True)
+    ap.add_argument("--out", required=True)
+    ap.add_argument("--prop", action="append", default=[])
