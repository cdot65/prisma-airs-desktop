#!/usr/bin/env python3
"""Composes a parity image: the prototype board on the left, the app's capture
on the right, each shown at 1440×900, with a caption. Rendered by the headless
browser (no image library is needed on this Mac).

Usage: compose.py --left proto.png --right app.png --out composite.png
       --title "Home · light" [--note "accessibility deviations…"]
"""

import argparse
import base64
import os
import subprocess
import sys
import tempfile

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
from dc_render import find_browser  # noqa: E402

GAP, CAP = 24, 44


def png_size(path):
    import struct
    with open(path, "rb") as f:
        head = f.read(24)
    return struct.unpack(">II", head[16:24])


def data_url(path):
    return "data:image/png;base64," + base64.b64encode(open(path, "rb").read()).decode("ascii")


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--left", required=True)
    ap.add_argument("--right", required=True)
    ap.add_argument("--out", required=True)
    ap.add_argument("--title", default="")
    ap.add_argument("--note", default="")
    ap.add_argument("--browser")
    args = ap.parse_args()
    # Each side is shown at the prototype's CSS size; the app capture (2x, window-sized) is scaled to the
    # same width and its dead strip below the web area is cropped.
    W, H = png_size(args.left)
    width = W * 2 + GAP * 3
    height = H + CAP * 2 + GAP
    html = f"""<!doctype html><html><head><meta charset='utf-8'><style>
html,body{{margin:0;background:#111;color:#eee;font:14px -apple-system,system-ui}}
.row{{display:flex;gap:{GAP}px;padding:{GAP}px}}
figure{{margin:0}} img{{display:block;width:{W}px;height:{H}px;object-fit:cover;object-position:top left;background:#fff}}
figcaption{{height:{CAP}px;line-height:{CAP}px;font-weight:600}}
.note{{padding:0 {GAP}px;height:{CAP}px;line-height:{CAP}px;color:#bbb;white-space:nowrap;overflow:hidden}}
</style></head><body>
<div class='row'>
<figure><figcaption>Prototype · {args.title}</figcaption><img src='{data_url(args.left)}'></figure>
<figure><figcaption>App · {args.title}</figcaption><img src='{data_url(args.right)}'></figure>
</div>
<div class='note'>{args.note}</div>
</body></html>"""
    with tempfile.TemporaryDirectory(prefix="parity-") as d:
        path = os.path.join(d, "composite.html")
        open(path, "w", encoding="utf-8").write(html)
        cmd = [find_browser(args.browser), "--headless=new", "--disable-gpu", "--hide-scrollbars", "--force-device-scale-factor=1",
               f"--window-size={width},{height}", f"--screenshot={os.path.abspath(args.out)}",
               "--virtual-time-budget=1500", "--user-data-dir=" + os.path.join(d, "profile"), "file://" + path]
        r = subprocess.run(cmd, capture_output=True, text=True, timeout=120)
        if r.returncode != 0 or not os.path.exists(args.out):
            sys.stderr.write(r.stderr[-2000:])
            raise SystemExit("compose failed")
    print(args.out)


if __name__ == "__main__":
    main()
#!/usr/bin/env python3
"""Captures the v2 app's destinations at 1440×900 in light and dark for the
parity composites (docs/planning/p09-recut.md), through the fixture window
with synthetic endpoints only, then composes each capture beside its
prototype board.

Run from the repository root after `xtask native-prepare --chunk <chunk>`.
Usage: capture_app.py --chunk C35 --screen home [--screen inbox …]
Writes docs/planning/evidence/<chunk>/parity/<screen>-<theme>.png plus the
raw app captures under parity/app/ and the prototype renders under
parity/proto/.
"""

import argparse
import json
import os
import shutil
import subprocess
import sys
import tempfile
import time

ROOT = os.getcwd()
TOOLS = os.path.join(ROOT, "tools/native-acceptance")
sys.path.insert(0, TOOLS)
import fixture_app as fx  # noqa: E402
import acceptance_c08 as c8  # noqa: E402
import acceptance_c28 as c28  # noqa: E402
import acceptance_c29 as c29  # noqa: E402

HERE = os.path.dirname(os.path.abspath(__file__))
LOG = []
TITLE_BAR = 28


def png_size(path):
    import struct
    with open(path, "rb") as f:
        head = f.read(24)
    return struct.unpack(">II", head[16:24])
# Destination → (Go menu item, heading to wait for, prototype start=)
SCREENS = {
    "home": ("Home", "Home", "home"),
    "inbox": ("Inbox", "Inbox", "inbox"),
    "harness": ("Harness", "Harness", "harness"),
    "academy": ("Academy", "Academy", "academy"),
    "cases": ("Test Cases", "Test Cases", "cases"),
    "api": ("API Client", "API Client", "api"),
    "admin": ("Administration", "Administration", "admin"),
}


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--chunk", required=True)
    ap.add_argument("--screen", action="append", default=[])
    ap.add_argument("--no-tenant", action="store_true", help="capture without creating a tenant")
    ap.add_argument("--prepare", help="native-prepare.json to take the bundle from (default: the chunk's)")
    ap.add_argument("--measure", action="append", default=[], help="print the geometry of nodes whose label starts with this (after sizing)")
    args = ap.parse_args()
    screens = args.screen or ["home"]
    evidence = os.path.join(ROOT, "docs/planning/evidence", args.chunk)
    parity = os.path.join(evidence, "parity")
    os.makedirs(os.path.join(parity, "app"), exist_ok=True)
    os.makedirs(os.path.join(parity, "proto"), exist_ok=True)
    prepared = json.load(open(args.prepare or os.path.join(evidence, "native-prepare.json")))
    json.dump({"bundle": prepared["bundle"], "executable_sha256": prepared["executable_sha256"], "from": os.path.relpath(args.prepare, ROOT) if args.prepare else "native-prepare.json"},
              open(os.path.join(parity, "bundle.json"), "w"), indent=2)
    bundle = os.path.join(ROOT, prepared["bundle"])
    work = tempfile.mkdtemp(prefix="airs-v2-parity-")
    c29.NATIVE = os.path.join(work, "native")
    os.makedirs(c29.NATIVE)
    if os.path.isdir(c29.CAPTURES):
        shutil.rmtree(c29.CAPTURES)
    app = fx.App(bundle, work, LOG)
    c29._APP = app
    app.quit()
    fx.sh(["pkill", "-f", fx.PROCESS])
    fx.clean_fixture_root()
    endpoint = fx.ScanEndpoint(os.path.join(work, "endpoint"), c8.SCAN_KEY)
    endpoint.install_roots()
    endpoint.start()
    mgmt = c8.MgmtEndpoint(os.path.join(work, "endpoint"), os.path.join(work, "mgmt"))
    mgmt.install()
    mgmt.start()
    mgmt.mode()
    out = []
    try:
        app.launch()
        pid = app.pid
        if not args.no_tenant:
            app.open_settings()
            app.type_into("AXTextField", "TSG ID (optional)", c8.TSG)
            app.create_custom_tenant("Northwind Health", endpoint.origin)
            app.save_key(c8.SCAN_KEY)
            c8.save_client(app)
        c29.press(app, "AXCheckBox", "Use the new interface")
        app.wait_for(lambda t: c29.nav(t, "Destinations") is not None, 15)
        # The web area is the board's 1440×900: the window sits at the screen's origin
        # (so macOS does not shrink it) and is taller by its title bar.
        fx.sh(["osascript", "-e", f'tell application "System Events" to tell (first application process whose unix id is {pid}) to set position of window 1 to {{0, 0}}'])
        c28.set_window_size(pid, 1440, 900 + TITLE_BAR)
        time.sleep(0.8)
        frame = c29.window_frame(pid)
        print("window", frame, file=sys.stderr)
        if args.measure:
            for n in app.tree():
                label = (n.get("label") or n.get("value") or "")
                if n.get("role") in ("AXWebArea",) or n.get("subrole") == "AXLandmarkNavigation" or any(label.startswith(m) for m in args.measure):
                    print("node", n.get("role"), n.get("subrole"), repr(label[:40]), n.get("pos"), n.get("size"), file=sys.stderr)
        for screen in screens:
            menu, heading, start = SCREENS[screen]
            app.menu("Go", menu)
            app.wait_for(lambda t: fx.App.node(t, "AXHeading", heading) is not None, 15)
            time.sleep(1.0)
            for theme in ("Light", "Dark"):
                c29.appearance(app, theme)
                time.sleep(0.6)
                cap = c29.capture(app, f"{screen}-{theme.lower()}")
                if not cap:
                    raise SystemExit(f"no capture for {screen} {theme}")
                app_png = os.path.join(parity, "app", f"{screen}-{theme.lower()}.png")
                shutil.copy(os.path.join(ROOT, cap), app_png)
                # The prototype is rendered at the web area's own CSS size, read from the
                # accessibility tree: the self-capture is window-sized and its bottom strip,
                # the title bar's height, is dead space the composite crops.
                web = next((n for n in app.tree() if n.get("role") == "AXWebArea" and n.get("size")), None)
                if web:
                    web_w, web_h = int(web["size"][0]), int(web["size"][1])
                else:
                    pw, ph = png_size(app_png)
                    scale = 2 if pw > 1600 else 1
                    web_w, web_h = pw // scale, ph // scale - TITLE_BAR
                proto_png = os.path.join(parity, "proto", f"{screen}-{theme.lower()}.png")
                subprocess.run([sys.executable, "-I", os.path.join(HERE, "dc_render.py"), "--board", "R2App", "--prop", f"start={start}",
                                "--prop", f"theme={theme.lower()}", "--width", str(web_w), "--height", str(web_h), "--out", proto_png], check=True, capture_output=True)
                composite = os.path.join(parity, f"{screen}-{theme.lower()}.png")
                subprocess.run([sys.executable, "-I", os.path.join(HERE, "compose.py"), "--left", proto_png, "--right", app_png,
                                "--out", composite, "--title", f"{heading} · {theme.lower()} · {web_w}×{web_h}"], check=True, capture_output=True)
                out.append(os.path.relpath(composite, ROOT))
            c29.appearance(app, "Match System")
        app.quit()
    finally:
        fx.sh(["pkill", "-f", fx.PROCESS])
        endpoint.stop()
        mgmt.stop()
        fx.clean_fixture_root()
        shutil.rmtree(work, ignore_errors=True)
    for p in out:
        print(p)


if __name__ == "__main__":
    main()
#!/usr/bin/env python3
"""Renders a board of the frozen design prototype to a PNG with a headless
browser, for the parity composites (docs/planning/p09-recut.md).

The prototype files are Claude Design components whose runtime is not in the
repository; tools/parity/dc-shim.js is a static stand-in that expands the
template once from `renderVals()`. Nothing is interactive in the output.

Usage: dc_render.py --board R2App --out home-light.png [--prop start=home]
       [--prop theme=light] [--width 1440 --height 900]
       [--browser /path/to/chrome-headless-shell]
"""

import argparse
import glob
import json
import os
import re
import subprocess
import sys
import tempfile

ROOT = os.path.dirname(os.path.dirname(os.path.dirname(os.path.abspath(__file__))))
PROTOTYPE = os.path.join(ROOT, "docs/architecture/ui-v2/prototype")
SHIM = os.path.join(os.path.dirname(os.path.abspath(__file__)), "dc-shim.js")


def find_browser(explicit):
    if explicit:
        return explicit
    candidates = glob.glob(os.path.expanduser("~/Library/Caches/ms-playwright/chromium_headless_shell-*/chrome-headless-shell-mac-arm64/chrome-headless-shell"))
    candidates += ["/Applications/Google Chrome.app/Contents/MacOS/Google Chrome"]
    for c in sorted(candidates, reverse=True):
        if os.path.exists(c):
            return c
    raise SystemExit("no headless browser found; pass --browser")


def component(name):
    """A component's template (inside <x-dc>) and logic (the x-dc script)."""
    text = open(os.path.join(PROTOTYPE, f"{name}.dc.html"), encoding="utf-8").read()
    template = re.search(r"<x-dc>(.*)</x-dc>", text, re.S)
    script = re.search(r"<script type=\"text/x-dc\"[^>]*>(.*?)</script>", text, re.S)
    if not template or not script:
        raise SystemExit(f"{name}: not a dc component")
    logic = script.group(1)
    if "class Component" not in logic:
        raise SystemExit(f"{name}: no Component class")
    imports = set(re.findall(r'<dc-import name="([A-Za-z0-9_]+)"', template.group(1)))
    return template.group(1), logic, imports


def page(root, props, width, height):
    components = {}
    pending = [root]
    while pending:
        name = pending.pop()
        if name in components:
            continue
        template, logic, imports = component(name)
        components[name] = (template, logic)
        pending.extend(imports)
    parts = [
        "<!doctype html><html><head><meta charset='utf-8'>",
        # The board's root is fixed at 1440×900 in its own style; the viewport's size wins so a
        # capture of a shorter window compares like for like (the board lays out by flex).
        "<style>html,body{margin:0;padding:0;background:#fff} #dc-root{width:%dpx;height:%dpx;overflow:hidden} #dc-root>[data-theme]{width:%dpx!important;height:%dpx!important;border-radius:0!important;border:0!important}</style>" % (width, height, width, height),
        "<script>", open(SHIM, encoding="utf-8").read(), "</script>",
        "</head><body><div id='dc-root'></div>",
    ]
    for name, (template, _) in components.items():
        parts.append(f"<template id='tpl-{name}'>{template}</template>")
    parts.append("<script>const COMPONENTS = {};</script>")
    for name, (_, logic) in components.items():
        # Each component's `class Component extends DCLogic` is scoped per IIFE.
        parts.append("<script>(function(){ %s\nCOMPONENTS[%s] = { template: document.getElementById('tpl-%s').innerHTML, logic: Component }; })();</script>" % (logic, json.dumps(name), name))
    parts.append("<script>window.dcRender({ root: %s, props: %s, components: COMPONENTS });</script>" % (json.dumps(root), json.dumps(props)))
    parts.append("</body></html>")
    return "\n".join(parts)


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--board", required=True)
    ap.add_argument("--out", required=True)
    ap.add_argument("--prop", action="append", default=[])
    ap.add_argument("--width", type=int, default=1440)
    ap.add_argument("--height", type=int, default=900)
    ap.add_argument("--browser")
    ap.add_argument("--keep-html", help="also write the generated page here")
    args = ap.parse_args()
    props = {}
    for p in args.prop:
        k, _, v = p.partition("=")
        props[k] = v
    html = page(args.board, props, args.width, args.height)
    if args.keep_html:
        open(args.keep_html, "w", encoding="utf-8").write(html)
    with tempfile.TemporaryDirectory(prefix="dc-render-") as d:
        path = os.path.join(d, "board.html")
        open(path, "w", encoding="utf-8").write(html)
        browser = find_browser(args.browser)
        cmd = [browser, "--headless=new", "--disable-gpu", "--hide-scrollbars", "--force-device-scale-factor=1",
               f"--window-size={args.width},{args.height}", f"--screenshot={os.path.abspath(args.out)}",
               "--virtual-time-budget=2000", "--user-data-dir=" + os.path.join(d, "profile"), "file://" + path]
        r = subprocess.run(cmd, capture_output=True, text=True, timeout=120)
        if r.returncode != 0 or not os.path.exists(args.out):
            sys.stderr.write(r.stderr[-2000:])
            raise SystemExit(f"render failed ({r.returncode})")
    print(args.out)


if __name__ == "__main__":
    main()

