6da2cc7623510393573f4771077c4de24b0cb26336c2439fb106ee8\", \"audit\": \"docs/planning/reviews/C30/attempt-12/post-review-audit.json\", \"audit_sha256\": \"00f40540847cceb52ffad681d59b72aa0bf64cc51446ab540282ec28346ac97b\", \"owner_decision\": \"docs/planning/reviews/C30/owner-override-2026-11-02.md\", \"owner_decision_sha256\": \"52b64aa1fecaff18059fd62bb301448869833412fa1b81c293cb2b7a20e153d6\", \"scores\": {\"architecture\": 9, \"behavior\": 9, \"authority_security\": 9, \"validation\": 8, \"overall\": 8}, \"recommendation\": \"fail\", \"full_gate_pass\": false, \"owner_closed\": true, \"standing\": \"complete by explicit owner decision; actual raw 9/9/9/8/8 unchanged; C30 R1/R2/E1/E2 closed for this exact baseline; no new capture or score claimed\"}]\nowner_decisions [{\"subject\": \"C30\", \"record\": \"docs/planning/reviews/C30/attempt-12/verdict-returned.json\", \"sha256\": \"f49d633701dcb7d606ca176f3edaeee8d435866e1ee0d142c540029c3035d2ec\", \"request\": \"docs/planning/reviews/C30/attempt-12/request.json\", \"request_sha256\": \"940ebc477172fab9d078c458cb88646cbf1ce62de0f82b1e83c0e9ab8e75326e\", \"receipt\": \"docs/planning/reviews/C30/attempt-12/receipt.json\", \"receipt_sha256\": \"5885351796da2cc7623510393573f4771077c4de24b0cb26336c2439fb106ee8\", \"audit\": \"docs/planning/reviews/C30/attempt-12/post-review-audit.json\", \"audit_sha256\": \"00f40540847cceb52ffad681d59b72aa0bf64cc51446ab540282ec28346ac97b\", \"owner_decision\": \"docs/planning/reviews/C30/owner-override-2026-11-02.md\", \"owner_decision_sha256\": \"52b64aa1fecaff18059fd62bb301448869833412fa1b81c293cb2b7a20e153d6\", \"scores\": {\"architecture\": 9, \"behavior\": 9, \"authority_security\": 9, \"validation\": 8, \"overall\": 8}, \"recommendation\": \"fail\", \"full_gate_pass\": false, \"owner_closed\": true, \"standing\": \"complete by explicit owner decision; actual raw 9/9/9/8/8 unchanged; C30 R1/R2/E1/E2 closed for this exact baseline; no new capture or score claimed\"}]\nfingerprint_notes \"Canonical sorted path/hash source inventory; complete current compiled-input digest; current attempt outputs excluded to prevent self-reference.\"\ncommands [{\"record\": \"docs/planning/evidence/P09/runs/run-attempt-07.json\", \"subject\": \"P09\", \"attempt\": \"attempt-07\", \"time\": \"2026-11-02T10:34:02+0000\", \"cwd\": \"/Users/cdot/development/redtail/prisma-airs-desktop-v2-current\", \"toolchain\": {\"rustc\": \"rustc 1.99.0 (b940084d7 2026-09-28)\", \"cargo\": \"cargo 1.99.0 (5f94df478 2026-08-27)\", \"node\": \"v24.21.0\", \"pnpm\": \"10.6.5\", \"rustup_active\": \"1.99.0-aarch64-apple-darwin (overridden by '/Users/cdot/development/redtail/prisma-airs-desktop-v2-current/rust-toolchain.toml')\"}, \"environment\": {\"PATH\": \"/Users/cdot/development/redtail/prisma-airs-desktop-v2-current/.tools/bin:/Users/admin/.cargo/bin:/Users/admin/.nvm/versions/node/v24.21.0/bin:/usr/bin:/bin:/usr/sbin:/sbin\", \"RUSTFLAGS\": null, \"CARGO_TARGET_DIR\": null, \"RUST_TEST_THREADS\": \"4\"}, \"build_flags\": {\"digest\": \"166488b352224eb230ddfca178064d76f43deecbb6c73fb6d9359f56632e1a1f\", \"covers\": \"checks.json, native-checks.json, toolchain.json, budgets.json, tauri.conf.json, tauri.fixture.conf.json, src-tauri/capabilities/*.json, rust-toolchain.toml\"}, \"inputs\": {\"procedure\": \"docs/planning/evidence/P09/runs/attempt-07/../hash-inputs.sh\", \"procedure_sha256\": \"0a4f9546e1aa4a812da6a946c6ee73d9a0e69c3fd4534dd3d480d5c804b53ea1\", \"before_inventory_sha256\": \"f5f26271b8823df8a2b5299417146784d345d4e04f8b59341706e6a41750210d\", \"before_digest\": \"f5f26271b8823df8a2b5299417146784d345d4e04f8b59341706e6a41750210d\", \"after_inventory_sha256\": \"f5f26271b8823df8a2b5299417146784d345d4e04f8b59341706e6a41750210d\", \"after_digest\": \"f5f26271b8823df8a2b5299417146784d345d4e04f8b59341706e6a41750210d\", \"unchanged\": true, \"members\": 18338}, \"runs\": {\"rustfmt\": {\"exit\": 0, \"log\": \"docs/planning/evidence/P09/runs/attempt-07/rustfmt.log\", \"log_sha2