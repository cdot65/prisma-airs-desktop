{"type":"item.completed","item":{"id":"item_38","type":"command_execution","command":"/bin/zsh -lc \"rg -n '\"'^'\"\\\\s*(it|test|describe)\\\\(' apps/desktop/src/v2/admin/administration.test.tsx; sed -n '182,313p' apps/desktop/src/features/administration/runtime-changes.tsx; rg -n 'Administration|active.*context' apps/desktop/src/v2/v2-shell.tsx\"","aggregated_output":"268:describe('v2 Administration', () => {\n269:    it('renders the inventory: unavailable products show their gate and nothing else, removed tabs do not exist, unavailable tabs have no rows or actions (V2-T19, V2-T20)', async () => {\n305:    it('labels creation and row actions per tab from the inventory: no \"New application…\", no key \"Edit…\" (V2-T20, gap 3)', async () => {\n331:    it('applies a review only when the typed name matches, in the review sheet (V2-T03)', async () => {\n409:    it('follows a rotation: Issued reveals only through the host and forgets the key on exit, Resumed has no secret controls, Complete shows both labelled timestamps (V2-T06, V2-T08, I6)', async () => {\n512:    it('Gateway keys rotate in place: never \"Issue additional key…\" or \"Finish rotation…\" (V2-T20)', async () => {\n521:    it('shows custom topic results apart from the detectors: an applied topic flags without suppressing an enabled detector (gap 2)', async () => {\n566:    it('V2-T20: every product and tab renders its disposition, its content, and exactly the admitted actions', async () => {\n642:    it('Gateway keys show their rows and rotate in place through the typed review; no staged rotation (V2-T20)', async () => {\n667:    it('V2-T21: the Red Team Targets tab shows identifiers and types only; a target name in the reply never renders', async () => {\n683:    it('a review exit ends the review in the core, also before its change settles and on unmount (V2-R06, I6)', async () => {\n711:    it('says only what each action established: an update read back absent is not \"Removed\"; reconciliation reads the reviewed item (R5)', async () => {\n733:    it('shows a response-only topic violation in its own labelled section beside unrelated detectors (R8)', async () => {\n774:    it('announces each rotation stage in one persistent status region, without moving focus, and toasts completion for its tenant (R9, I10)', async () => {\n792:    it('derives profile and topic relationships from one profile walk, and marks the keys of a rotation (R7)', async () => {\n809:    it('opens the old key’s removal only once the acknowledgement is recorded: refused, invalid, stale or unconfirmed never advance (R3)', async () => {\n839:    it('opens a Harness proposal’s native review in the review sheet with its exact draft; leaving discards it (R4)', async () => {\n890:    it('names what a confirmed change established: tenant, resource, returned name and revision, and the recorded readback time (R5)', async () => {\n923:    it('shows a failed second issuance apart from the rotation it leaves unchanged, with a manual retry and nothing resent (R2)', async () => {\n963:    it('gives every topic verdict an icon and words, for the prompt and the response, in the production Playground (R3, I9)', async () => {\n1012:    it('draws the product cards: description, headline figure from the read, status pill and alerts; Expand all and Collapse all (C39a)', async () => {\n1037:    it('draws the Runtime Overview from the read: three tiles and the 24-hour bars; the table footer names the count and the read time (C39a)', async () => {\n1057:    it('says when the chart was not read: the events tile names it and the bars are none (C39a)', async () => {\n1071:    it('draws the Gateway Overview from the tenant read: requests, error rate and cost of the chosen workspace, never invented (C39b)', async () => {\n1088:    it('saves, replaces and removes the chosen workspace\\u2019s inference key from the Gateway card\\u2019s Workspaces tab; the key never stays in the page (C44, the legacy Playground form is gone)', async () => {\n1128:    it('lists Gateway routes as a table with View per row and the inventory actions in the detail; the Red Team overview draws its tiles and ranked bars (C39b)', async () => {\n1148:    it('opens a change in the prototype’s sheet: the title with the review’s state, a close control, the change’s path (C39b)', async () => {\n1163:    it('keeps a Gateway draft typed within the save pause when the sheet is closed at once: the exact text is saved, nothing is applied (C39b attempt-01 R1)', async () => {\n1184:    it('the open sheet says what became of the Gateway draft from the current state: kept, rejected (incomplete JSON), not stored, and a save the desktop refused (C39b attempt-01 R2)', async () => {\n1217:    it('every Red Team tab drawn from the scan list says what that list is: a partial sample of the reported total on Scans, Targets, Attack results and Reports, not only Overview; a list that could not be read says so there too (C39b attempt-01 R3)', async () => {\n1255:describe('v2 Playground handlers (C39a E2)', () => {\n1258:    it('submits the fields as typed, says a refusal and an unconfirmed delivery without replaying, and cancels a running scan', async () => {\n1292:    it('saves a case from the fields as typed and says only what the library established', async () => {\n1309:describe('v2 inventory table reads (C39a E2, R2, R3)', () => {\n1338:    it('pages with Next page and First page, says the search is page-local, and starts again for a replaced context (E2, R3)', async () => {\n1363:    it('keeps the rows with their read time when a refresh is denied (E2)', async () => {\n1375:    it('a detail closed before its reply arrives stays closed and keeps focus where it was (R2)', async () => {\n * (no debounced copy), and Rust compares Apply's text with the reviewed\n * draft. While the native confirmation is open the editor is read-only and\n * the main window is held by the sheet.\n */\nexport function ChangeWorkbench({ change, review, staged = null, context, dispatch, onClose, onDraft, flushRef, note, requireTyped = false }: WorkbenchProps) {\n    const ids = useId()\n    const [typedText, setTypedText] = useState('')\n    const heading = useRef<HTMLHeadingElement>(null)\n    const editor = useRef<HTMLTextAreaElement>(null)\n    const keywords = useRef<HTMLTextAreaElement>(null)\n    const [useFile, setUseFile] = useState(false)\n    const dictionary = change.kind === 'dictionaries'\n    const parts = dictionary ? dictionaryParts(change.body) : null\n    const typed = useRef<HTMLInputElement>(null)\n    const [message, setMessage] = useState<string | null>(null)\n    const [busy, setBusy] = useState(false)\n    const mine =\n        review && review.kind === change.kind && review.action === change.action && review.target === change.target\n            ? review\n            : null\n    const confirming = mine?.state === 'confirming'\n    const blocked = (mine?.references.length ?? 0) > 0\n    const deletes = change.action === 'delete'\n\n    // The chosen file is used only once one is actually staged; a cancelled\n    // or failed choice leaves the typed keywords in use.\n    const fileReady = staged?.state === 'ready' && !!staged.token\n    const usingFile = useFile && fileReady\n    // Opening a change moves focus to it.\n    useEffect(() => {\n        heading.current?.focus()\n    }, [])\n    // Edited text is kept as a draft once typing pauses, and on close.\n    const pending = useRef<ReturnType<typeof setTimeout> | null>(null)\n    const kept = useRef(change.body)\n    // The latest text typed, kept apart from the textarea: React's unmount cleanup runs after the textarea is\n    // detached, so a flush there (or from the host's Close) reads this, never a gone node.\n    const latest = useRef<string | undefined>(undefined)\n    function keepDraft() {\n        if (pending.current) clearTimeout(pending.current)\n        pending.current = null\n        const text = editor.current?.value ?? latest.current\n        if (!onDraft || text === undefined || text === kept.current) return\n        kept.current = text\n        onDraft(text)\n    }\n    function edited(event?: React.FormEvent<HTMLTextAreaElement>) {\n        if (event) latest.current = event.currentTarget.value\n        if (!onDraft) return\n        if (pending.current) clearTimeout(pending.current)\n        pending.current = setTimeout(keepDraft, DRAFT_PAUSE_MS)\n    }\n    if (flushRef) flushRef.current = keepDraft\n    useEffect(() => () => keepDraft(), [])\n    const [awaitingFile, setAwaitingFile] = useState(false)\n    useEffect(() => {\n        if (!awaitingFile || staged?.state === 'choosing') return\n        setAwaitingFile(false)\n        setUseFile(staged?.state === 'ready')\n    }, [awaitingFile, staged?.state])\n\n    /** The draft as entered now, or null (with a message) when it cannot be sent. */\n    function draft(): ChangeDraft | null {\n        const text = editor.current?.value ?? ''\n        let body = deletes ? '{}' : text\n        if (dictionary && !deletes) {\n            // Read fresh from the fields. The metadata must be exactly one JSON\n            // object: it is parsed, never spliced into the body as text.\n            let metadata: unknown\n            try {\n                metadata = JSON.parse(text)\n            } catch {\n                metadata = null\n            }\n            if (typeof metadata !== 'object' || metadata === null || Array.isArray(metadata)) {\n                setMessage('The dictionary metadata must be one JSON object.')\n                return null\n            }\n            body = JSON.stringify(\n                usingFile && staged?.token\n                    ? { metadata, fileRef: staged.token }\n                    : { metadata, file: keywords.current?.value ?? '' }\n            )\n        }\n        const captured: ChangeDraft = { kind: change.kind, action: change.action, target: change.target, body }\n        if (change.workspace) captured.workspace = change.workspace\n        return captured\n    }\n\n    async function chooseFile() {\n        setAwaitingFile(true)\n        setMessage(outcomeMessage(await dispatch({ kind: 'chooseDictionaryFile', context })))\n    }\n\n    async function prepare() {\n        // The reviewed text is kept first, so a later settlement finds it.\n        keepDraft()\n        setMessage(null)\n        const captured = draft()\n        if (!captured) return\n        setBusy(true)\n        const outcome = await dispatch({ kind: 'reviewChange', context, draft: captured })\n        setBusy(false)\n        setMessage(outcomeMessage(outcome))\n    }\n\n    async function apply() {\n        if (!mine) return\n        setMessage(null)\n        const captured = draft()\n        if (!captured) return\n        setBusy(true)\n        const outcome = await dispatch({\n            kind: 'requestApply',\n            review: mine.review,\n            draft: captured,\n            confirmation: typed.current?.value ?? '',\n        })\n        setBusy(false)\n        if (outcome.kind === 'refused' && outcome.refusal === 'reviewInvalid') {\n            setMessage('The draft changed since it was reviewed, or the review expired. Review the change again.')\n        } else if (outcome.kind === 'refused' && outcome.refusal === 'invalidInput') {\n            setMessage(`Type ${mine.confirmation ?? 'the confirmation'} exactly to confirm.`)\n        } else setMessage(outcomeMessage(outcome))\n    }\n\n    async function discard() {\n        keepDraft()\n        if (mine) await dispatch({ kind: 'discardChange', review: mine.review })\n        onClose()\n    }\n\n6:import { Administration } from './admin/administration'\n25:/** C44: the product destinations the catalogue still lists (Go, the palette), opened as Administration's products. */\n71: * Administration products as children and needs-action badges, the status\n87:    const unconfirmed = unconfirmedAll.filter((u) => unconfirmedInContext(u, snapshot.active?.context ?? null))\n118:        useShellStore.getState().toast(line.text, line.tone === 'allowed' ? 'ok' : 'warn', undefined, tenantNow, snapshot.active?.context ?? null)\n130:        useShellStore.getState().toast(SNOOZE_COPY.toast(lastSnooze.title, lastSnooze.returnsAt), 'info', undefined, tenantNow, snapshot.active?.context ?? null)\n137:    const contextNow = snapshot.active?.context ?? null\n196:    // The tenant menu's workspace row: the Gateway's Workspaces tab in Administration, while a tenant is active.\n502:                            <Administration\n503:                                key={snapshot.active?.context ?? 'none'}\n514:                                key={snapshot.active?.context ?? 'none'}\n523:                            <TestCases key={snapshot.active?.context ?? 'none'} ref={heading} snapshot={snapshot} dispatch={props.dispatch} onNavigate={props.onNavigate} />\n531:                            // C44: the product destinations (Go, the palette) open Administration on their product; the legacy views are gone.\n532:                            <Administration\n533:                                key={snapshot.active?.context ?? 'none'}\n","exit_code":0,"status":"completed"}}
