l + '_inventory_sha256'], 'inventory record mismatch')\n432:    require(current == inputs['before_digest'], 'current compiled inputs differ from checks')\n440:            'input_digest': run['inputs']['before_digest'],\n{\n  \"subject\": \"P09\",\n  \"built_utc\": \"2026-11-02T06:57:11Z\",\n  \"bundle\": \"target/aarch64-apple-darwin/release/bundle/macos/Prisma AIRS Desktop v2 Fixture.app\",\n  \"identifier\": \"io.cdot.prisma-airs-desktop.v2.fixture\",\n  \"executable_sha256\": \"2791b5a1eaf6b9268e0574502c62a20f3027fd2b76ff9ed08289eef1f56147ea\",\n  \"bundle_sha256\": \"c673feed3aa0948e643a2c4bf23b793364fb6a6a12b1cbc2f0de877757c288f9\",\n  \"features\": [\n    \"test-fixtures\"\n  ],\n  \"target\": \"aarch64-apple-darwin\",\n  \"commands\": [\n    [\n      \"pnpm\",\n      \"--filter\",\n      \"@prisma-airs/desktop\",\n      \"build\"\n    ],\n    [\n      \"pnpm\",\n      \"--filter\",\n      \"@prisma-airs/desktop\",\n      \"exec\",\n      \"tauri\",\n      \"build\",\n      \"--ci\",\n      \"--no-sign\",\n      \"--target\",\n      \"aarch64-apple-darwin\",\n      \"--bundles\",\n      \"app\",\n      \"--features\",\n      \"test-fixtures\",\n      \"--config\",\n      \"src-tauri/tauri.fixture.conf.json\",\n      \"--config\",\n      \"src-tauri/tauri.harness.conf.json\"\n    ]\n  ]\n}\n{\n  \"schema\": \"airs-v2/p09-native-build-inputs/1\",\n  \"generation\": \"worf-07\",\n  \"source_head\": \"a1b707a438381b578cbf1862ee2341eeb07029c2\",\n  \"worktree_diff\": \"docs/planning/evidence/P09/preparations/worf-07/fixture-remediation.diff\",\n  \"worktree_diff_sha256\": \"e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855\",\n  \"prepare\": \"docs/planning/evidence/P09/native-prepare.json\",\n  \"prepare_sha256\": \"93beddb1f4bcb85b21ee8fa0290768b2aaa1c41d00387b3dda140a9ead4efb86\",\n  \"executable_sha256\": \"2791b5a1eaf6b9268e0574502c62a20f3027fd2b76ff9ed08289eef1f56147ea\",\n  \"bundle_sha256\": \"c673feed3aa0948e643a2c4bf23b793364fb6a6a12b1cbc2f