ion-06-complete-before-store-order-fix-20261102/native/cumulative/C07/storage-manifest.json\ndocs/planning/evidence/P09/native-history/Worf-generation-01-complete-20261101/native/cumulative/C07/storage-manifest.json\ndocs/planning/evidence/P09/native-history/C07-Worf-failed-02-20261101-resume-04/storage-manifest.json\ndocs/planning/evidence/P09/native-history/Worf-generation-05-complete-before-null-source-fix-20261102/native/cumulative/C07/storage-manifest.json\ndocs/planning/evidence/P09/native-history/Worf-generation-04-before-C30-authority-fix-20261102/native/cumulative/C07/storage-manifest.json\ndocs/planning/evidence/P09/native-history/Worf-generation-03-complete-before-clippy-order-fix-20261101/native/cumulative/C07/storage-manifest.json\ndocs/planning/evidence/C09/storage-manifest.json\ndocs/planning/evidence/C24/native-C07/storage-manifest.json\ndocs/planning/evidence/C12/storage-manifest.json\ndocs/planning/evidence/C23/native-C07/storage-manifest.json\ndocs/planning/evidence/P02/storage-manifest.json\ndocs/planning/evidence/P09/native-history/C07-Worf-failed-20261101-resume-04/storage-manifest.json\n","exit_code":0,"status":"completed"}}
