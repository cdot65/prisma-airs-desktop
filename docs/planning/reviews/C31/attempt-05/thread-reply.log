ademy-shared-presentation.md\",\n    \"docs/adr/0003-native-harness-and-scoped-identity.md\",\n    \"docs/adr/0004-managed-workbench-admission.md\",\n    \"docs/planning/IMPLEMENTATION-PLAN.md\",\n    \"docs/planning/decisions.md\",\n    \"docs/planning/dependencies.md\",\n    \"docs/planning/parity-matrix.md\",\n    \"docs/planning/test-catalogue.md\",\n    \"docs/planning/review-protocol.md\",\n    \"docs/planning/status.md\",\n    \"docs/planning/WORF-START-HERE.md\",\n    \"docs/planning/chunks/C28.md\",\n    \"docs/planning/chunks/C30.md\",\n    \"docs/architecture/checks.json\",\n    \"docs/architecture/native-checks.json\",\n    \"docs/architecture/review-verdict.schema.json\",\n    \"docs/architecture/ui-v2/DESIGN-V2.md\",\n    \"docs/architecture/ui-v2/invariants.md\",\n    \"docs/architecture/ui-v2/state-ownership.md\",\n    \"docs/architecture/ui-v2/provenance.md\",\n    \"docs/architecture/ui-v2/screens/boards.md\",\n    \"docs/architecture/ui-v2/screens/shell.md\",\n    \"docs/architecture/ui-v2/screens/inbox-reads.md\",\n    \"docs/architecture/ui-v2/screens/wizard.md\",\n    \"docs/architecture/ui-v2/screens/harness.md\",\n    \"docs/architecture/ui-v2/screens/academy.md\",\n    \"docs/architecture/ui-v2/screens/api-client-test-cases.md\",\n    \"docs/planning/reviews/C30/attempt-12/request.json\",\n    \"docs/planning/reviews/C30/attempt-12/source-inventory.json\",\n    \"docs/planning/reviews/C30/attempt-11/verdict-returned.json\",\n    \"docs/planning/reviews/C29/attempt-10/request.json\",\n    \"docs/planning/reviews/C29/attempt-10/source-inventory.json\",\n/// One Runtime API key rotation of a tenant (C31, I7), persisted so its two\n/// timestamps are stored once and survive reads, switches and relaunches.\n#[derive(Clone, Debug, PartialEq, Eq, Serialize, Deserialize, TS)]\n#[serde(rename_all = \"camelCase\")]\npub struct Rotation {\n    pub application: String,\n    pub old_key: KeyRef,\n    pub new_key: Option<KeyRef>,\n    pub issuance: RotationIssuance,\n    /// The change result that issued the key (its one-time secret lives\n    /// there, for the context it was applied in, never here). Session-only:\n    /// operation IDs restart with the core, so a relaunch never restores\n    /// this link (a reused ID must not point at another key; C31).\n    #[serde(skip)]\n    #[ts(skip)]\n    pub issued_by: Option<String>,\n    /// The key name the issuing review named: the only key that can confirm\n    /// an unconfirmed issuance.\n    #[serde(default)]\n    pub pending_name: Option<String>,\n    pub issued_at: u32,\n    /// The operator's local statement that the application uses the new key.\n    pub deployment_acknowledged_at: Option<u32>,\n    pub removal: RotationRemoval,\n    /// When the old key was read back absent (remote readback).\n    pub old_key_removed_at: Option<u32>,\n}\n\n/// Stable identifier of a top-level desktop feature destination.\n#[derive(Clone, Copy, Debug, PartialEq, Eq, Hash, Serialize, Deserialize, TS)]\n            record.cell.ready.notify_waiters();\n        }\n        for (operation, result) in setup_results {\n            self.setup_settled(&operation, &result);\n        }\n        for (context, result) in overviews {\n            self.overview_settled(&context, result);\n        }\n        for (context, product, result) in parts {\n            self.product_read_settled(&context, product, &result);\n        }\n        for read in key_pages {\n            match read {\n                KeyRead::Items(context, items, whole) => {\n                    if let Ok(tenant) = self.check_context(&context)\n                        && let Ok(items) = serde_json::from_str::<Vec<serde_json::Value>>(&items)\n                    {\n                        self.rotation_reconcile(&tenant, &items, whole);\n                    }\n                }\n                KeyRead::Absent(context, id) => {\n                    if let Ok(tenant) = self.check_context(&context) {\n                        self.rotation_key_absent(&tenant, &id);\n                    }\n                }\n            }\n        }\n        for (context, list) in listings {\n/// and its authentication (whatever header it generates, or an API key in\n/// the query).\nfn credential_sources(plan: &Plan) -> usize {\n    plan.headers\n        .iter()\n        .filter(|(n, _)| CREDENTIAL_HEADERS.contains(&n.to_ascii_lowercase().as_str()))\n        .count()\n        + usize::from(!matches!(plan.auth, Auth::None))\n}\n\n/// Whether the collection jar's Cookie header would be a second credential\n/// beside one `plan` sends itself (its Authorization, an explicit Cookie,\n/// an API key). At a registered origin that is refused like any other\n/// second credential; the jar is consulted only once admission has shown\n/// the request is not a tenant-credential one.\npub fn jar_cookie_is_ambiguous(plan: &Plan) -> bool {\n    credential_sources(plan) > 0\n}\n\n/// The catalogue operation `plan` is at a registered origin serving\n/// `classes` (one plain spelling of a known method and path), or denial.\nfn registered_operation(\n    plan: &Plan,\n    url: &url::Url,\n    classes: &BTreeSet<OriginClass>,\n) -> Result<Operation, SendRefusal> {\n    if !plan.url.plain().is_some_and(|t| plain_path(&t)) {\n        return Err(SendRefusal::UnknownEndpoint);\n    }\n    classes\n        .iter()\n        .find_map(|class| classify(&plan.method, *class, url.path()))\n        .ok_or(SendRefusal::UnknownEndpoint)\n}\n\n            return Err(SendRefusal::TokenDestination);\n        }\n        if destinations.api_origins.contains(&request_origin) {\n            OriginClass::Api\n        } else if destinations.token_origin.as_deref() == Some(request_origin.as_str()) {\n            OriginClass::Auth\n        } else {\n            return Err(SendRefusal::RequestDestination);\n        }\n    } else {\n        match &destinations.scan_origin {\n            None => return Err(SendRefusal::NoTenant),\n            Some(scan) if *scan == request_origin => OriginClass::Scan,\n            Some(_) => return Err(SendRefusal::RequestDestination),\n        }\n    };\n    // The URL as written (before normalization) must be one plain spelling.\n    if !plan.url.plain().is_some_and(|t| plain_path(&t)) {\n        return Err(SendRefusal::UnknownEndpoint);\n    }\n    let operation =\n        classify(&plan.method, class, url.path()).ok_or(SendRefusal::UnknownEndpoint)?;\n    Ok(Admitted {\n        class: CredentialClass::Managed,\n        url,\n        operation: Some(operation),\n    })\n}\n\n#[cfg(test)]\nmod tests {\n    use super::*;\n    use crate::workbench::document::Fields;\n    use crate::workbench::environments::Layers;\n    use crate::workbench::render::render;\n\n    const ORIGIN: &str = \"https://127.0.0.1:9443\";\n\n    fn destinations() -> Destinations {\n        let mut registered = Registered::default();\n        for class in [OriginClass::Api, OriginClass::Auth] {\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_70","type":"command_execution","command":"/bin/zsh -lc \"nl -ba apps/desktop/src/v2/admin/review-sheet.tsx | sed -n '267,277p'; cat docs/planning/review-protocol.md | head -68; sed -n '1,88p' docs/architecture/checks.json; cat docs/planning/reviews/C41/owner-override-2026-10-31.md | head -28; sed -n '1,28p' docs/planning/evidence/P09/native-controller/requirements.json\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_70","type":"command_execution","command":"/bin/zsh -lc \"nl -ba apps/desktop/src/v2/admin/review-sheet.tsx | sed -n '267,277p'; cat docs/planning/review-protocol.md | head -68; sed -n '1,88p' docs/architecture/checks.json; cat docs/planning/reviews/C41/owner-override-2026-10-31.md | head -28; sed -n '1,28p' docs/planning/evidence/P09/native-controller/requirements.json\"","aggregated_output":"   267\t                    </span>\n   268\t                    <button type='button' aria-label='Close review' onClick={close} className='ml-auto grid shrink-0 place-items-center rounded-[7px] border' style={{ width: 28, height: 28, minHeight: 0, borderColor: 'var(--v2-rule)', background: 'var(--v2-paper)', color: 'var(--v2-ink)' }}>\n   269\t                        <Glyph name='x' size={12} stroke={2.2} />\n   270\t                    </button>\n   271\t                </div>\n   272\t                {change ? (\n   273\t                    <p className='text-[14px]' style={{ color: 'var(--v2-soft)' }} data-slot='review-path'>\n   274\t                        {`${CHANGE_NOUN[change.kind].charAt(0).toUpperCase()}${CHANGE_NOUN[change.kind].slice(1)} › `}\n   275\t                        <b style={{ color: 'var(--v2-ink)' }}>{change.title}</b>\n   276\t                    </p>\n   277\t                ) : null}\n# Independent review and evidence protocol\n\nApplies to G00/G01 as planning/design reviews, every implementation chunk and\nevery phase. Scope the verdict honestly: a plan review evaluates the plan and\nfuture gates, not application code or tests that do not exist.\n\nG00/G01 were reviewed by Claude Code; those records are historical and cover\nonly their recorded inputs. Under D026, Claude Code implements and Codex is the\nindependent reviewer for C01–C26 and the phase reviews P01–P08.\n\n## Gate\n\nActual independent Codex review must score at least 9/10 overall and in each\ncritical dimension: architecture, behavior, authority_security, validation.\nNo blocking or required fixes may remain. Missing mandatory evidence, stale\ninputs, or a mismatched receipt prevents completion independently of scores.\n\nThe implementer cannot substitute its own score or edit the reviewer's verdict.\nDo not ask a reviewer to raise a score; fix findings and request a new review.\nRetain all attempts and explain remediation. Optional suggestions may remain\nonly when explicitly classified as nonrequired and consistent with the plan.\n\n## Dimensions\n\n- **Architecture:** depth at domain interfaces; locality; justified seams/real\n  adapters; authoritative ownership; no needless pass-through layers or hidden\n  cross-module coupling. Use the glossary and accepted ADRs.\n- **Behavior:** complete chunk requirements, exact working-v1 subset, correct\n  success/denied/empty/stale/partial/unknown outcomes, and no invented support.\n- **Authority/security:** context/credential isolation, review/approval binding,\n  trusted hosted assessment, protected storage, safe external destinations,\n  bounded execution, provenance, Node-free shipped backend, and secret hygiene.\n- **Validation:** meaningful production-interface tests; independent external\n  expectations; required native/live/artifact evidence; reproducibility, hashes,\n  explicit limitations, and causal failure cases. Test counts alone earn no score.\n\nScores below 9 require concrete findings with locations, impact, and acceptance\nconditions. Even a 9/10 verdict with a required fix cannot pass.\n\nOwner rule D034 (2026-10-18): a chunk may complete on a review scoring at least\n8 in every dimension with no blockers; its remaining findings are recorded as\naccepted failures. The reviewer still scores against the 9/10 gate above. At\nthe end of each phase every chunk accepted below 9 is remediated and\nre-reviewed until it passes the full gate, before the phase review.\n\n## Phase reviews\n\nAfter the last chunk of a phase completes, request a cumulative Codex review of\nthat phase (P01: C01–C03, P02: C04–C07, P03: C08–C12, P04: C13–C15, P05: C16–C18,\nP06: C19–C22, P07: C23–C24, P08: C25–C26). The phase packet binds the current\ncommitted tree, every chunk receipt in the phase and earlier phases' receipts,\nthe phase's integrated test/native results rerun against that tree, and the\ndiff since the previous phase. The reviewer assesses integration across the\nphase and the earlier features it affects. The same five-score threshold and\nempty required_fixes/blockers/evidence_gaps apply, with no owner acceptance\n(D034), and every member chunk must hold a passing 9/10 completion. The next phase does not\nbegin until its predecessor phase review passes. Historical chunk scores are\ninputs to assess, never a substitute.\n\n## Review transport\n\nThe controller writes an immutable request packet (request/attempt IDs, chunk or\nphase, scope, predecessor receipts, source/dependency/build-flag/evidence\nfingerprints, exact commands/results/evidence paths, diff, limitations, the\nverdict schema and one absolute verdict path), then delivers it:\n\n- Preferred: the owner-designated Codex thread, addressed by exact ID through\n  `codex queue --thread <id> --message <text>`; never `--last`. A prior\n{\n  \"schema_version\": 1,\n  \"status\": \"executable contract; C01 implements the runner and targets. Entries describe commands, not results.\",\n  \"target\": \"aarch64-apple-darwin\",\n  \"fixture_only_features\": [\n    \"test-fixtures\"\n  ],\n  \"setup_commands\": [\n    [\n      \"cargo\",\n      \"run\",\n      \"--locked\",\n      \"-p\",\n      \"xtask\",\n      \"--\",\n      \"shared-prepare\",\n      \"--input\",\n      \".inputs/academy\",\n      \"--scratch\",\n      \".work/academy\"\n    ],\n    [\n      \"pnpm\",\n      \"install\",\n      \"--frozen-lockfile\",\n      \"--ignore-scripts\"\n    ]\n  ],\n  \"common_commands\": [\n    [\n      \"cargo\",\n      \"run\",\n      \"--locked\",\n      \"-p\",\n      \"xtask\",\n      \"--\",\n      \"bindings\",\n      \"--check\"\n    ],\n    [\n      \"cargo\",\n      \"run\",\n      \"--locked\",\n      \"-p\",\n      \"xtask\",\n      \"--\",\n      \"ledger\",\n      \"--check\"\n    ],\n    [\n      \"cargo\",\n      \"run\",\n      \"--locked\",\n      \"-p\",\n      \"xtask\",\n      \"--\",\n      \"notices\",\n      \"--check\"\n    ],\n    [\n      \"pnpm\",\n      \"--filter\",\n      \"@prisma-airs/desktop-contracts\",\n      \"typecheck\"\n    ],\n    [\n      \"pnpm\",\n      \"--filter\",\n      \"@prisma-airs/desktop\",\n      \"typecheck\"\n    ],\n    [\n      \"pnpm\",\n      \"--filter\",\n      \"@prisma-airs/desktop\",\n      \"exec\",\n      \"vitest\",\n      \"run\",\n      \"--config\",\n      \"vitest.config.ts\"\n    ],\n    [\n      \"pnpm\",\n      \"--filter\",\n      \"@prisma-airs/desktop\",\n      \"build\"\n    ],\n    [\n# C41 — owner override, 2026-10-31\n\nThe owner's direction, verbatim: \"I am overriding the C41 score to all 9s because Codex isn't scoring correctly. The current implementation of C41 is now passing and does not need another run.\"\n\nWhat this record means:\n\n- C41 is complete at 9 in all five dimensions by the owner's decision, on the implementation at commit 3c6834e2 (branch c41-api): the pre-gate commit 70b4a920, the native-run fixes, and the remediations of attempts 01 to 09 (`remediation-attempt-0{1..9}.md`), every one with its component regressions (63 workbench tests passing, typecheck clean), native acceptance C41-N01 and N02 passing on the rebuilt bundle of attempt-09 and the full check runs of that attempt (`evidence/C41/runs/run-attempt-09.json`).\n- The Codex verdicts are retained unchanged under `attempt-01` to `attempt-09` (`verdict-returned.json`): attempt-09 scored architecture 9, behavior 8, authority_security 9, validation 8, overall 8 with no blockers. No verdict file is edited; the override is this record, not a score.\n- The attempt-09 findings (R1 a stale document remounted on return; R2 superseded environment and schema opens) are remediated in 3c6834e2 and were not re-reviewed: the owner judged a tenth run unnecessary. The queued attempt-10 gate was removed from the queue.\n- The acceptance under D034 stands on attempt-02 (`attempt-02/acceptance.md`); this override is the P09 push-to-9 outcome for C41 and is cited by the P09 phase review's packet so the reviewer can weigh it.\nsed: docs/planning/evidence/P09/native-controller/requirements.json: No such file or directory\n","exit_code":1,"status":"failed"}}
