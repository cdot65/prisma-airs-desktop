status() == Some(409) {\n                    ChangeFailure::Conflict\n                } else {\n                    ChangeFailure::Service {\n                        failure: ManagementFailure::from_sdk(&error),\n                    }\n                };\n                return Self::failed(outcome_of(&error), failure);\n            }\n            // The service accepted the write but its reply was unusable.\n            Err(PageError::Invalid) => {\n                return Self::failed(\n                    Outcome::Completed,\n                    ChangeFailure::Service {\n                        failure: ManagementFailure::InvalidResponse,\n                    },\n                );\n            }\n        };\n        let (response, secret) = take_secret(reply);\n        let mut output = ApplyOutput {\n            outcome: Outcome::Completed,\n            response: Some(response.to_string()),\n            secret,\n            ..ApplyOutput::default()\n        };\n        self.answered(&output);\n        let (readback, current) = readback(binding, mutation, before, &response, deadline).await;\n        output.readback = Some(readback);\n        output.current = current;\n        output\n    }\n\n    /// A Gateway change (C17): the baseline, the references and the review\n    /// digest must still match; then exactly one write (or the bounded\n    /// provisioning) and its readback. A one-time key is taken out of the\n    /// reply before anything else.\n    async fn apply_gateway(\n\n    async fn prepare(&self, deadline: Instant) -> Result<Prepared, ChangeFailure> {\n        let binding = self\n            .source\n            .bind()\n            .await\n            .map_err(|failure| ChangeFailure::Service { failure })?;\n        if let Some(bound) = &self.gateway {\n            let read =\n                gateway::baseline(binding, &self.draft, bound.scope.scope.as_ref(), deadline)\n                    .await\n                    .map_err(gateway_failure)?;\n            let digest = review_digest(\n                &self.tenant,\n                &self.source.client_id,\n                &self.draft,\n                read.before.as_ref(),\n                Some((bound, &read.references)),\n            );\n            return Ok(Prepared {\n                mutation: self.draft.clone(),\n                before: read.before,\n                digest,\n                references: read.references,\n            });\n        }\n        let (mutation, before) = baseline(binding, &self.draft, deadline).await?;\n        let digest = review_digest(\n            &self.tenant,\n            &self.source.client_id,\n            &mutation,\n            before.as_ref(),\n            None,\n        );\n        Ok(Prepared {\n            mutation,\n            before,\n            digest,\n            references: Vec::new(),\n        })\n    }\n}\n\n/// One confirmed change: re-read, compare, write once, read back.\ncrates/desktop-core/src/scanning.rs:198:    pub topics: TopicVerdict,\ncrates/desktop-core/src/scanning.rs:199:    pub response_topics: TopicVerdict,\ncrates/desktop-core/src/scanning.rs:208:pub struct TopicVerdict {\ncrates/desktop-core/src/scanning.rs:209:    /// The `topic_violation` flag as reported (absent when the service did\ncrates/desktop-core/src/scanning.rs:288:/// the response's wire form: the `topic_violation` flag and the topic\ncrates/desktop-core/src/scanning.rs:290:fn direction_topics(wire: &serde_json::Value, direction: &str) -> TopicVerdict {\ncrates/desktop-core/src/scanning.rs:305:        .and_then(|d| d.get(\"topic_guardrails_details\"));\ncrates/desktop-core/src/scanning.rs:306:    TopicVerdict {\ncrates/desktop-core/src/scanning.rs:309:            .and_then(|d| d.get(\"topic_violation\"))\n38:    rotations: RotationView[]\n45:    profiles: 'profiles',\n46:    topics: 'topics',\n57:    profiles: { kind: 'profiles', action: 'create', target: '', title: 'New security profile', body: pretty(TEMPLATES.profile) },\n58:    topics: { kind: 'topics', action: 'create', target: '', title: 'New custom topic', body: pretty(TEMPLATES.topic) },\n61:    dataProfiles: { kind: 'dataProfiles', action: 'create', target: '', title: 'New data profile', body: pretty(TEMPLATES.dataProfile) },\n108:/** The custom topics a security profile's policy names, by one walk of its JSON (C31). */\n109:export function topicRefs(profile: Item): { id: string | null; name: string | null }[] {\n118:        const id = typeof o.topic_id === 'string' ? o.topic_id : null\n119:        const name = typeof o.topic_name === 'string' ? o.topic_name : null\n123:    walk(profile.policy ?? profile, 0)\n128:    usedBy: (topicId: string | null, topicName: string) => string[]\n133:/** The profile ↔ topic relationship inventory: one read of the profiles (first 100), walked once (C31). */\n138:        if (resource !== 'topics') return\n140:        void readManagement(dispatch, observe, context, { kind: 'page', resource: 'profiles', offset: 0, limit: 100 }).then((outcome) => {\n147:            const profiles = JSON.parse(page.items) as Item[]\n150:            for (const profile of profiles) {\n151:                const name = typeof profile.profile_name === 'string' ? profile.profile_name : String(profile.profile_id ?? '')\n152:                for (const t of topicRefs(profile)) {\n158:                usedBy: (id, topicName) => [...new Set([...(id ? (byId.get(id) ?? []) : []), ...(byName.get(topicName) ?? [])])],\n166:        // eslint-disable-next-line react-hooks/exhaustive-deps -- re-derived with each topics read\n182:export function InventoryTable({ snapshot, context, dispatch, observe, resource, arrival = null, admitted, labels, onReview, rotations, onFinishRotation }: Props) {\n258:    // The table follows what changed it (C31): a settled change of this kind, or a rotation moving on, re-reads the page.\n262:        ...(resource === 'apiKeys' ? rotations.map((r) => `${r.application}:${r.stage}:${r.newKey?.id ?? ''}`) : []),\n291:        resource === 'profiles'\n292:            ? { heading: 'Topics', cell: (item) => listText(topicRefs(item).map((t) => t.name ?? t.id ?? '')) }\n293:            : resource === 'topics'\n295:                    heading: 'Used by',\n297:                        if (!relations) return 'Reading profiles…'\n300:                        return users.length > 0 ? listText(users) : relations.complete ? 'No profile' : 'None in the profiles read'\n307:                          const old = rotations.find((r) => r.oldKey.id === id && r.stage !== 'complete')\n309:                          const fresh = rotations.find((r) => r.newKey?.id === id && r.stage !== 'complete')\n443:                    rotation={(item) => {\n445:                        return rotations.find((r) => r.oldKey.id === id && r.stage !== 'complete') ?? null\n460:    rotation,\n469:    rotation: (item: Item) => RotationView | null\n473:    const inRotation = state.kind === 'shown' && state.item ? rotation(state.item) : null\n512:                    {info.id === 'profiles' ? (\n521:                    <Btn tier='primary' data-slot='finish-rotation' onClick={() => onFinishRotation(inRotation.application)}>\n","exit_code":0,"status":"completed"}}
