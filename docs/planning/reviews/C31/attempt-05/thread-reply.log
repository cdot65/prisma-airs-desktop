{"type":"item.completed","item":{"id":"item_60","type":"command_execution","command":"/bin/zsh -lc \"sed -n '45,100p' apps/desktop/src-tauri/src/native_confirmation.rs; sed -n '211,286p' apps/desktop/src-tauri/src/native_confirmation.rs; rg -n 'Exit|shutdown|beforeunload|visibilitychange|pagehide|unload' apps/desktop/src packages/desktop-contracts/src crates/desktop-core/src/authority.rs; sed -n '1,160p' apps/desktop/src/v2/modal.tsx; sed -n '20,64p' tools/p09/phase_inputs.py\"","aggregated_output":"    /// Resolves `nonce` once; false for an unknown or already resolved one.\n    pub fn complete(&self, nonce: u64, accepted: bool) -> bool {\n        let sender = self.pending.lock().ok().and_then(|mut p| p.remove(&nonce));\n        sender.is_some_and(|tx| tx.send(accepted).is_ok())\n    }\n\n    pub fn open_count(&self) -> usize {\n        self.pending.lock().map(|p| p.len()).unwrap_or(0)\n    }\n}\n\n/// Which reveal owns the one secret sheet. Every reveal takes a new\n/// generation; an older reveal's expiry or completion never ends or\n/// unregisters a newer reveal's sheet.\n#[derive(Debug, Default)]\npub struct SecretOwnership {\n    current: std::sync::atomic::AtomicU64,\n}\n\nimpl SecretOwnership {\n    pub const fn new() -> Self {\n        Self {\n            current: std::sync::atomic::AtomicU64::new(0),\n        }\n    }\n\n    /// A new reveal: it owns the sheet from now on.\n    pub fn begin(&self) -> u64 {\n        self.current\n            .fetch_add(1, std::sync::atomic::Ordering::SeqCst)\n            .wrapping_add(1)\n    }\n\n    /// Whether `generation` is still the sheet's reveal.\n    pub fn owns(&self, generation: u64) -> bool {\n        self.current.load(std::sync::atomic::Ordering::SeqCst) == generation\n    }\n}\n\n/// The receiver side of a confirmation: false if it was dropped.\npub async fn outcome(receiver: Option<oneshot::Receiver<bool>>) -> bool {\n    match receiver {\n        Some(rx) => rx.await.unwrap_or(false),\n        None => false,\n    }\n}\n\n#[cfg(target_os = \"macos\")]\npub use appkit::{NativeConfirmation, NativeSecrets};\n\n#[cfg(target_os = \"macos\")]\nmod appkit {\n    #![allow(unsafe_code)]\n\n    use std::cell::RefCell;\n    use std::collections::HashMap;\n    pub struct NativeSecrets<R: Runtime> {\n        pub app: AppHandle<R>,\n    }\n\n    /// The secret sheet's current reveal.\n    static SECRET_OWNER: super::SecretOwnership = super::SecretOwnership::new();\n\n    impl<R: Runtime> SecretPresenter for NativeSecrets<R> {\n        fn reveal(&self, label: String, secret: Zeroizing<String>) {\n            let app = self.app.clone();\n            let _ = self\n                .app\n                .run_on_main_thread(move || reveal(&app, &label, secret));\n        }\n\n        fn dismiss(&self) {\n            let _ = self.app.run_on_main_thread(|| end_sheet(SECRET_SHEET));\n        }\n    }\n\n    fn reveal<R: Runtime>(app: &AppHandle<R>, label: &str, secret: Zeroizing<String>) {\n        let Some(mtm) = MainThreadMarker::new() else {\n            return;\n        };\n        let Some(window) = main_window(app) else {\n            return;\n        };\n        end_sheet(SECRET_SHEET);\n        let generation = SECRET_OWNER.begin();\n        let alert = NSAlert::new(mtm);\n        alert.setMessageText(&NSString::from_str(label));\n        alert.setInformativeText(&NSString::from_str(\n            \"Shown once. Copy it now: it is not stored and cannot be shown again after you close this. \\\n             A copy is cleared from the clipboard after 60 seconds if it is still there. \\\n             The configured scan key is unchanged.\",\n        ));\n        let field = NSTextField::labelWithString(&NSString::from_str(&secret), mtm);\n        field.setSelectable(true);\n        field.setFrame(NSRect::new(\n            NSPoint::new(0.0, 0.0),\n            NSSize::new(360.0, 24.0),\n        ));\n        alert.setAccessoryView(Some(&field));\n        alert.addButtonWithTitle(&NSString::from_str(\"Copy and Close\"));\n        alert.addButtonWithTitle(&NSString::from_str(\"Close\"));\n        let held = std::cell::RefCell::new(Some(secret));\n        let shown_field = field.clone();\n        let handler = RcBlock::new(move |response: NSModalResponse| {\n            // The host's copy is dropped (zeroized) whatever the choice.\n            let secret = held.borrow_mut().take();\n            shown_field.setStringValue(&NSString::from_str(\"\"));\n            // Only this reveal's own registration is removed: a newer\n            // reveal may already own the sheet slot.\n            if SECRET_OWNER.owns(generation) {\n                SHEETS.with(|s| s.borrow_mut().remove(&SECRET_SHEET));\n            }\n            if response != NSAlertFirstButtonReturn {\n                return;\n            }\n            let Some(secret) = secret else { return };\n            let guard = ClipboardGuard::new(AppKitPasteboard::general());\n            if let Some(copied) = guard.copy(&secret) {\n                tauri::async_runtime::spawn(async move {\n                    tokio::time::sleep(CLEAR_AFTER).await;\n                    let _ = tokio::task::spawn_blocking(move || {\n                        ClipboardGuard::new(AppKitPasteboard::general()).cleanup(&copied)\n                    })\n                    .await;\n                });\n            }\n        });\n        alert.beginSheetModalForWindow_completionHandler(&window, Some(&handler));\n        SHEETS.with(|s| {\n            s.borrow_mut()\n                .insert(SECRET_SHEET, (window, alert.window()))\n        });\ncrates/desktop-core/src/authority.rs:3140:    pub fn shutdown(&self) {\napps/desktop/src/v2/admin/review-sheet.tsx:144:    const pendingExit = useRef<number | null>(null)\napps/desktop/src/v2/admin/review-sheet.tsx:146:        if (pendingExit.current !== null) window.clearTimeout(pendingExit.current)\napps/desktop/src/v2/admin/review-sheet.tsx:147:        pendingExit.current = null\napps/desktop/src/v2/admin/review-sheet.tsx:149:            pendingExit.current = window.setTimeout(() => exit.current(), 0)\nimport { useEffect, useId, useRef, type KeyboardEvent, type ReactNode } from 'react'\nimport { useShellStore } from './store'\n\ninterface ModalProps {\n    label: string\n    onClose: () => void\n    children: ReactNode\n    /** Width in CSS px (default 560). */\n    width?: number\n    /** Inner padding in CSS px (default 20); 0 for a dialog that lays itself out edge to edge. */\n    padding?: number\n    /** Distance from the top of the window in CSS px (default 4vh); the prototype's palette sits at 90. */\n    top?: number\n    /** Corner radius in CSS px (default 12; the palette's frame is 14). */\n    radius?: number\n    /** A sheet docked to the window's right edge under the header (R2App's review sheet, 620px wide, full height). */\n    sheet?: boolean\n    /**\n     * The control focus returns to on close when the opener itself will be gone\n     * by then (a menu item that closes with its menu as the dialog opens): an\n     * explicit surviving target instead of whatever had focus at mount.\n     */\n    returnFocus?: HTMLElement | null\n    'data-slot'?: string\n}\n\nconst FOCUSABLE = 'a[href], button:not([disabled]), input:not([disabled]), select:not([disabled]), textarea:not([disabled]), [tabindex]:not([tabindex=\"-1\"])'\n\n/**\n * One topmost modal (I8): dialogs register on a shell-wide stack; only the\n * last is interactive. Lower dialogs are inert and aria-hidden, Tab and\n * Shift-Tab stay inside the topmost dialog, Escape closes the topmost only,\n * focus moves into the dialog on open and back to the opener on close. The\n * page behind every dialog is made inert by the shell (`useModalsOpen`).\n * The dialog element handles its own keys; the topmost dialog also listens\n * on the window for Escape alone, for when focus has left it (a native\n * sheet returned focus elsewhere), and closes only itself.\n */\nexport function Modal({ label, onClose, children, width = 560, padding = 20, top, radius = 12, sheet = false, returnFocus = null, ...rest }: ModalProps) {\n    const id = useId()\n    const pushModal = useShellStore((s) => s.pushModal)\n    const popModal = useShellStore((s) => s.popModal)\n    const modals = useShellStore((s) => s.modals)\n    const topmost = modals.length > 0 && modals[modals.length - 1] === id\n    const dialog = useRef<HTMLDivElement>(null)\n    const opener = useRef<HTMLElement | null>(null)\n    const returnRef = useRef(returnFocus)\n    returnRef.current = returnFocus\n    const focusedOnce = useRef(false)\n\n    useEffect(() => {\n        opener.current = document.activeElement instanceof HTMLElement ? document.activeElement : null\n        pushModal(id)\n        return () => {\n            popModal(id)\n            // After the commit: the page behind is still inert during cleanup,\n            // and an inert ancestor refuses focus (observed in WebKit).\n            const target = returnRef.current ?? opener.current\n            queueMicrotask(() => {\n                // Only when nothing else took focus meanwhile (⌘T replacing the\n                // palette hands focus to the tenant list, which must keep it).\n                const active = document.activeElement\n                if (active && active !== document.body) return\n                // The opener may be gone (a \"Finish rotation…\" that completed):\n                // focus the page heading rather than leave it on nothing.\n                if (target?.isConnected) target.focus()\n                else document.querySelector<HTMLElement>('main h1[tabindex=\"-1\"]')?.focus()\n            })\n        }\n    }, [id, pushModal, popModal])\n\n    useEffect(() => {\n        // Initial focus goes into the dialog once, when it opens. Regaining the\n        // top after a higher dialog closes must not refocus: that dialog is\n        // restoring its own opener, which may be any control here.\n        if (!topmost || focusedOnce.current) return\n        const node = dialog.current\n        if (!node) return\n        focusedOnce.current = true\n        if (!node.contains(document.activeElement)) {\n            // A declared initial control first (wherever it sits), else the first focusable.\n            const first = node.querySelector<HTMLElement>('[autofocus]') ?? node.querySelector<HTMLElement>(FOCUSABLE)\n            ;(first ?? node).focus()\n        }\n    }, [topmost])\n\n    // Escape still closes the topmost dialog when focus has left it (a\n    // native sheet returning focus to the page body, a click on the scrim's\n    // edge): the dialog's own handler stops the event first when it has focus.\n    const closeRef = useRef(onClose)\n    closeRef.current = onClose\n    useEffect(() => {\n        if (!topmost) return\n        const onWindowKey = (event: globalThis.KeyboardEvent) => {\n            if (event.key !== 'Escape' || event.defaultPrevented) return\n            const node = dialog.current\n            if (node && node.contains(document.activeElement)) return\n            event.preventDefault()\n            closeRef.current()\n        }\n        window.addEventListener('keydown', onWindowKey)\n        return () => window.removeEventListener('keydown', onWindowKey)\n    }, [topmost])\n\n    const onKeyDown = (event: KeyboardEvent<HTMLDivElement>) => {\n        if (!topmost) return\n        if (event.key === 'Escape') {\n            event.preventDefault()\n            event.stopPropagation()\n            onClose()\n            return\n        }\n        if (event.key === 'Tab') {\n            // Keyboard interaction stays inside the topmost dialog.\n            const node = dialog.current\n            if (!node) return\n            const items = Array.from(node.querySelectorAll<HTMLElement>(FOCUSABLE)).filter((el) => !el.hasAttribute('hidden') && el.getAttribute('aria-hidden') !== 'true')\n            if (items.length === 0) {\n                event.preventDefault()\n                node.focus()\n                return\n            }\n            const first = items[0] as HTMLElement\n            const last = items[items.length - 1] as HTMLElement\n            const active = document.activeElement\n            if (event.shiftKey && (active === first || active === node)) {\n                event.preventDefault()\n                last.focus()\n            } else if (!event.shiftKey && active === last) {\n                event.preventDefault()\n                first.focus()\n            }\n        }\n    }\n\n    return (\n        <div\n            className={sheet ? 'fixed z-50 flex justify-end' : 'fixed inset-0 z-50 grid place-items-start justify-center'}\n            style={sheet ? { inset: 'var(--v2-header, 56px) 0 0 0' } : { paddingTop: top ?? '4vh' }}\n            data-v2-scrim=''\n            aria-hidden={topmost ? undefined : true}\n            inert={topmost ? undefined : true}\n            onMouseDown={() => topmost && onClose()}\n        >\n            <div\n                ref={dialog}\n                role='dialog'\n                aria-modal={topmost ? 'true' : undefined}\n                aria-label={label}\n                tabIndex={-1}\n                data-slot={rest['data-slot'] ?? 'modal'}\n                data-topmost={topmost ? 'true' : 'false'}\n                onKeyDown={onKeyDown}\n                onMouseDown={(e) => e.stopPropagation()}\n                className='border'\n                // Bounded to the viewport: a tall dialog scrolls inside itself, so its\n                // actions stay reachable at the minimum window size and 200% zoom.\n                style={\n                    sheet\n                        ? { width: `min(${width}px, 100vw)`, height: '100%', overflowY: 'auto', padding, borderRadius: 0, borderLeft: '1px solid var(--v2-rule)', boxShadow: '-18px 0 40px rgba(0,0,0,0.18)', background: 'var(--v2-bg)', borderWidth: 0, color: 'var(--v2-ink)' }\n    'C41': 'docs/planning/reviews/C41/owner-override-2026-10-31.md',\n}\nDIMENSIONS = {'architecture', 'behavior', 'authority_security', 'validation', 'overall'}\nREVIEW_DISABLED = {'hooks', 'plugins', 'apps', 'remote_plugin', 'browser_use', 'browser_use_external',\n                   'in_app_browser', 'computer_use', 'image_generation', 'multi_agent', 'skill_search',\n                   'skill_mcp_dependency_install', 'unbounded_connection_retries'}\n\n\ndef require(condition, message):\n    if not condition:\n        raise ValueError(message)\n\n\ndef read(path):\n    return json.loads(Path(path).read_text())\n\n\ndef sha(path):\n    return hashlib.sha256(Path(path).read_bytes()).hexdigest()\n\n\ndef full_gate(verdict):\n    scores = verdict.get('scores', {})\n    require(set(scores) == DIMENSIONS and all(type(v) is int and v >= 9 and v <= 10 for v in scores.values()),\n            'member does not have all five scores at least 9')\n    require(verdict.get('recommendation') == 'pass', 'member recommendation is not pass')\n    for field in ['required_fixes', 'blockers', 'evidence_gaps']:\n        require(verdict.get(field) == [], 'member has missing/nonempty ' + field)\n\n\ndef verify_launch(root, out):\n    \"\"\"Audit requested isolation, observed feature probe and actual JSONL events.\"\"\"\n    invocation = read(out / 'invocation.json')\n    require(invocation['request_sha256'] == sha(out / 'request.json')\n            and invocation['schema_sha256'] == sha(root / 'docs/architecture/review-verdict.schema.json'),\n            'review invocation request/schema mismatch')\n    argv = invocation['command_without_prompt']\n    require(argv and argv[0] == 'codex' and argv.count('exec') == 1, 'review is not a fresh Codex exec')\n    for flag in ['--no-daemon', '--ephemeral', '--ignore-user-config', '--ignore-rules', '--json']:\n        require(argv.count(flag) == 1, 'review isolation flag missing/duplicated: ' + flag)\n    for flag, value in [('-a', 'never'), ('-s', 'read-only'), ('-m', invocation['model_requested']),\n                        ('--output-schema', 'docs/architecture/review-verdict.schema.json'),\n                        ('-o', str(out / 'verdict-returned.json'))]:\n        require(argv.count(flag) == 1 and argv[argv.index(flag) + 1] == value, 'review argument mismatch: ' + flag)\n    require(not any('dangerously' in x or x in ['--approve-for-me', 'resume', 'fork', '--last'] for x in argv),\n","exit_code":0,"status":"completed"}}
