+/** Every string the v2 Administration, review and rotation surfaces show (C31). */
+export const ADMIN_COPY = {
+    title: 'Administration',
+    /** The chosen Gateway workspace's inference key (C18), kept in the Keychain; the wizard's tenant step saves it first, the Gateway card's Workspaces tab replaces or removes it (C44: the legacy Playground form is gone). */
+    workspaceKey: {
+        title: 'Workspace key',
+        hint: 'The inference key the Harness and the Gateway Playground send for this workspace, kept in the macOS Keychain. The key itself is never shown.',
+        endpoint: 'Inference endpoint',
+        endpointHint: 'The https address the workspace key is sent to.',
+        key: 'Workspace inference key',
+        save: 'Save workspace key',
+        replace: 'Replace workspace key',
+        remove: 'Remove workspace key',
+        saved: 'Workspace key saved in the Keychain.',
+        removed: 'Workspace key removed.',
+        errors: { endpoint: 'Enter the https address of the inference endpoint.', key: 'Enter the workspace inference key.' },
+        state: { missing: 'Not saved', storing: 'Saving…', ready: 'Saved in the Keychain', failed: 'Not saved' } as Record<string, string>,
+        otherWorkspace: (name: string) => `The saved key belongs to ${name}; saving one here replaces it.`,
+    },
+    lead: (tenant: string) => `${tenant} · every change is reviewed before it is applied`,
+    expandAll: 'Expand all',
+    collapseAll: 'Collapse all',
+    /** The product cards' one-line descriptions (R2App). */
+    description: {
+        runtimeSecurity: 'LLM and MCP guardrails: prompts, responses and tool calls are checked as they happen.',
+        redTeam: 'Automated testing of application, agent and model guardrails.',
+        modelSkill: 'Scans AI artifacts before they ship: models, Skills and codebases.',
+        gateway: 'LLM, MCP and Agent Gateway, integrated with Idira through AIS.',
+        agenticIdentity: 'Secures MCP tool invocations, with identities from Idira and enforcement in AI Gateway.',
+        agenticEndpoint: 'Discovers and governs the AI supply chain on endpoints (formerly Koi).',
+    } as Record<string, string>,
+    /** The product cards' headline metric labels. */
+    stat: {
+        runtimeSecurity: 'detections · 24h',
+        gateway: 'requests · today',
+        redTeam: 'scans · 30d',
+        modelSkill: 'findings · 30d',
+        agenticIdentity: 'tool calls · 24h',
+        agenticEndpoint: 'endpoints',
+    } as Record<string, string>,
+    /** The product cards' status pill, from the read's per-product state. */
+    status: {
+        ok: 'Connected',
+        incomplete: 'Partial',
+        needsRole: 'Needs a role',
+        failed: 'Failed',
+        pending: 'First read pending',
+        notRead: 'Not read here',
+        unavailable: 'Not available',
+    } as Record<string, string>,
+    alerts: (n: number) => (n === 1 ? '1 alert' : `${n} alerts`),
+    table: {
+        /** An inventory this desktop reads but never changes says so (the legacy Administration's wording, kept). */
+        readOnlyInventory: {
+            deploymentProfiles: 'Read only. Deployment profiles are used when creating API keys; they are not changed here.',
+            dlpCatalog: 'Read only. The DLP profiles AIRS provides are read here; they are not changed from the desktop.',
+        } as Partial<Record<string, string>>,
+        search: (tab: string) => `Search ${tab.toLowerCase()}`,
+        view: 'View',
+        details: (name: string) => `Details for ${name}`,
+        items: (n: number) => (n === 1 ? '1 item' : `${n} items`),
+        itemsOf: (n: number, total: number) => `${n} of ${total} items`,
+        read: (when: string) => `Read ${when}`,
+        reading: (what: string) => `Reading ${what.toLowerCase()}…`,
+        // The search covers the page that was read (C39a attempt-01 R3); other pages are reached with First page / Next page.
+        noMatch: (what: string, q: string, morePages = false) => `No ${what.toLowerCase()} on this page match “${q}”.${morePages ? ' Other pages are not searched: use First page and Next page.' : ''}`,
+        searchScope: 'Searches the page that was read.',
+        empty: (what: string) => `The service reports no ${what.toLowerCase()} in this tenant.`,
+        partial: (what: string) => `More ${what.toLowerCase()} follow. Rows not yet read are not shown and are not assumed absent.`,
+        stale: (when: string) => `Showing rows read at ${when}. They may be out of date.`,
+        firstPage: 'First page',
+        nextPage: 'Next page',
+        refresh: 'Refresh',
+        name: 'Name',
+        id: 'ID',
+        actions: 'Actions',
+        closeDetails: 'Close details',
+        readingDetails: 'Reading details…',
+        absent: 'The service’s complete inventory no longer contains this item.',
+        incomplete: (what: string) => `This item was not within the first 1,000 ${what.toLowerCase()}. The inventory is larger, so this does not mean it is absent.`,
+        localPreview: 'Directional settings and customized prompt-injection modes were local previews in the previous desktop. They are not read from or sent to the service here.',
+        finishRotation: 'Finish rotation…',
+        notReady: (tenant: string) => `${tenant} has no ready management client. Inventories need a separate OAuth client; scanning keeps working without one.`,
+    },
