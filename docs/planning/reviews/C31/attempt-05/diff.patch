+fn direction_topics(wire: &serde_json::Value, direction: &str) -> TopicVerdict {
+    let names = |list: Option<&serde_json::Value>| -> Vec<String> {
+        list.and_then(serde_json::Value::as_array)
+            .map(|items| {
