+/// Starts the change `draft` reviewed with `typed`, its write answered after
+/// `millis` (the reply `reply`), and returns once the write is on the wire.
+async fn apply_delayed(
+    desk: &mut Desk,
+    draft: &Value,
+    typed: &str,
+    method: &str,
+    path: &str,
+    millis: u64,
+    reply: Reply,
+) {
+    let writes = desk.writes().len();
