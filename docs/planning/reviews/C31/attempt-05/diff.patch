+        adapters: handles,
+        service,
+        server,
+        _ca,
+        results_seen: 0,
+    };
+    tokio::time::sleep(Duration::from_millis(300)).await;
+    desk.select("Tenant A").await;
+    desk.management_key().await;
+    desk.adapters.confirmer.auto(Some(true));
+    desk
+}
