) -> Result<Mutation, ChangeProblem> {
    let names: Vec<&str> = before
        .get("api_keys_dp_info")
        .and_then(Value::as_array)
        .map(|infos| {
            infos
                .iter()
                .filter_map(|i| i.get("dp_name").and_then(Value::as_str))
                .filter(|n| !n.trim().is_empty())
                .collect()
        })
