                            void onAct(SHELL_COPY.readOf(tenant!.label), {
                                kind: 'readTenant',
                                context: context!,
                            })
                        }
                    />
                )
            if (tab.label === 'Playground') return <RuntimeView key={key} snapshot={snapshot} dispatch={dispatch} onNavigate={onNavigate} embedded />
            const resource = (tab.label === 'DLP' ? dlp : tab.resource) as ManagementResource | null
            if (!resource) return null
            return (
                <div className='flex flex-col gap-3'>
                    {tab.label === 'DLP' ? (
                        <div role='radiogroup' aria-label={C.dlpResources} className='flex flex-wrap gap-1' data-slot='dlp-resources'>
                            {DLP.map((r) => (
                                <button
                                    key={r}
                                    type='button'
                                    role='radio'
                                    aria-checked={dlp === r}
                                    onClick={() => setDlp(r)}
                                    className='h-8 rounded-[7px] px-3 text-[13px]'
                                    style={{
                                        background: dlp === r ? 'var(--v2-sel)' : 'transparent',
                                        color: dlp === r ? 'var(--v2-sel-ink)' : 'var(--v2-ink)',
                                    }}
                                >
                                    {DLP_LABEL[r]}
                                </button>
                            ))}
                        </div>
                    ) : null}
                    <AdministrationView
                        key={`${key}-${resource}`}
                        snapshot={snapshot}
                        dispatch={dispatch}
                        observe={observe}
                        onNavigate={onNavigate}
                        arrival={arrival && arrival.resource === resource ? arrival : null}
                        pinned={resource}
                        embedded
                        labels={labelsOf(tab, tab.label === 'DLP' ? DLP_KIND[resource] : undefined)}
                        admitted={tab.actions}
                        onReview={(change) => setSheet({ change, rotation: null })}
                        rotations={snapshot.rotations}
                        onFinishRotation={(application) => setSheet({ change: null, rotation: application })}
                    />
                </div>
            )
        }
        if (product.id === 'gateway') {
            if (tab.label === 'MCP servers') return <McpTab snapshot={snapshot} dispatch={dispatch} />
            const gtab = tab.label === 'Keys' ? gatewayKeys : GATEWAY_TAB[tab.id]
            return (
                <div className='flex flex-col gap-3'>
                    {tab.label === 'Keys' ? (
                        <div role='radiogroup' aria-label={C.keyKinds} className='flex gap-1'>
                            {(['serviceKeys', 'userKeys'] as const).map((k) => (
                                <button
                                    key={k}
                                    type='button'
                                    role='radio'
                                    aria-checked={gatewayKeys === k}
                                    onClick={() => setGatewayKeys(k)}
                                    className='h-8 rounded-[7px] px-3 text-[13px]'
                                    style={{
                                        background: gatewayKeys === k ? 'var(--v2-sel)' : 'transparent',
                                        color: gatewayKeys === k ? 'var(--v2-sel-ink)' : 'var(--v2-ink)',
                                    }}
                                >
                                    {k === 'serviceKeys' ? C.serviceKeys : C.userKeys}
                                </button>
                            ))}
                        </div>
                    ) : null}
                    <GatewayView
                        key={`${context}-gateway`}
                        snapshot={snapshot}
                        dispatch={dispatch}
                        observe={observe}
                        onNavigate={onNavigate}
                        tab={gtab}
                        embedded
                        actions={tab.actions}
                        onReview={(change, extras) => setSheet({ change, rotation: null, ...extras })}
                    />
                </div>
            )
        }
        return (
            <div className='flex flex-col gap-2'>
                <p className='text-[12px]' style={{ color: 'var(--v2-soft)' }}>
                    {C.readOnly}
                </p>
                <RedTeamView
                    key={`${context}-${product.id}`}
                    snapshot={snapshot}
                    dispatch={dispatch}
                    observe={observe}
                    onNavigate={onNavigate}
                    tab={RED_TEAM_TAB(product)}
                    section={SECTION[product.id]?.[tab.id]}
                    embedded
                />
            </div>
        )
    }

    return (
        <section aria-labelledby='administration-heading' data-slot='administration-v2' className='flex min-w-0 flex-col gap-4'>
            <div>
                <h1 ref={ref} id='administration-heading' tabIndex={-1} className='font-bold' style={{ fontSize: 'var(--v2-title)' }}>
                    {C.title}
                </h1>
                <p className='mt-1 text-[13px]' style={{ color: 'var(--v2-soft)' }}>
                    {C.lead(tenant.label)}
                </p>
            </div>
            <ul className='flex flex-col gap-3' data-slot='admin-products'>
                {products.map((product) => {
                    const unavailable = product.availability.state === 'unavailable'
                    const expanded = !!open[product.id] && !unavailable
                    const tabs = product.tabs.filter((t) => t.disposition.kind !== 'removed')
                    const current = tabs.find((t) => t.id === tabOf[product.id]) ?? tabs[0]
                    const panel = `admin-${product.id}`
                    return (
                        <li
                            key={product.id}
                            data-slot='admin-product'
                            data-product={product.id}
                            className='min-w-0 rounded-[12px] border'
                            style={{
                                borderColor: 'var(--v2-rule)',
                                background: 'var(--v2-paper)',
                            }}
                        >
                            <h2 className='m-0'>
                                <button
                                    type='button'
                                    aria-expanded={unavailable ? undefined : expanded}
                                    aria-controls={unavailable ? undefined : panel}
                                    aria-disabled={unavailable || undefined}
                                    onClick={() => !unavailable && setOpen((o) => ({ ...o, [product.id]: !o[product.id] }))}
                                    className='flex w-full flex-wrap items-center gap-3 px-4 py-3 text-left text-[15px] font-semibold'
                                >
                                    <span className='flex-grow'>{product.label}</span>
                                    {unavailable ? (
                                        <Verdict tone='info' word={C.unavailableTab} />
                                    ) : product.readOnly ? (
                                        <span className='text-[12px] font-normal' style={{ color: 'var(--v2-soft)' }}>
                                            Read-only
                                        </span>
                                    ) : null}
                                </button>
                            </h2>
                            {unavailable && product.availability.state === 'unavailable' ? (
                                <p data-slot='admin-product-gate' className='px-4 pb-3 text-[13px]' style={{ color: 'var(--v2-soft)' }}>
                                    {product.availability.reason}
                                </p>
                            ) : null}
                            {expanded && current ? (
                                <div id={panel} className='flex min-w-0 flex-col gap-3 px-4 pb-4'>
                                    <div role='tablist' aria-label={C.tabs(product.label)} className='flex flex-wrap gap-1'>
                                        {tabs.map((t) => (
                                            <button
                                                key={t.id}
                                                type='button'
                                                role='tab'
                                                aria-selected={t.id === current.id}
                                                aria-controls={`${panel}-tab`}
                                                onClick={() => setTabOf((s) => ({ ...s, [product.id]: t.id }))}
                                                className='h-8 rounded-[7px] px-3 text-[13px]'
                                                style={{
                                                    background: t.id === current.id ? 'var(--v2-sel)' : 'transparent',
                                                    color:
                                                        t.id === current.id
                                                            ? 'var(--v2-sel-ink)'
                                                            : t.disposition.kind === 'unavailable'
                                                              ? 'var(--v2-faint)'
                                                              : 'var(--v2-ink)',
                                                }}
                                            >
                                                {t.label}
                                            </button>
                                        ))}
                                    </div>
                                    <div
                                        role='tabpanel'
                                        id={`${panel}-tab`}
                                        aria-label={current.label}
                                        data-slot='admin-tab'
                                        data-tab={current.id}
                                        data-disposition={current.disposition.kind}
                                        className='min-w-0'
                                    >
                                        {body(product, current)}
                                    </div>
                                </div>
                            ) : null}
                        </li>
                    )
                })}
            </ul>
            {/* The sheet is the topmost dialog (I8): rendered at the body, outside the page the modal stack hides. */}
            {sheet
                ? createPortal(
                      <ReviewSheet
                          snapshot={snapshot}
                          context={context}
                          dispatch={dispatch}
                          observe={observe}
                          change={sheet.change}
                          rotation={sheet.rotation}
                          onDraft={sheet.onDraft}
                          note={sheet.note}
                          onClose={() => setSheet(null)}
                      />,
                      document.body
                  )
                : null}
        </section>
    )
})

/** Runtime Overview: what the tenant's read established (C30), never invented figures. */
function RuntimeOverviewTab({ snapshot, onRead }: { snapshot: ShellSnapshot; onRead: () => void }) {
    const read = snapshot.overview.read
    const cell = (label: string, value: string) => (
        <div className='rounded-[10px] border px-3 py-2' style={{ borderColor: 'var(--v2-rule)' }}>
            <p className='text-[12px]' style={{ color: 'var(--v2-soft)' }}>
                {label}
            </p>
            <p className='text-[18px] font-semibold'>{value}</p>
        </div>
    )
    const n = (v: number | null | undefined) => (v === null || v === undefined ? C.overviewRuntime.notRead : v.toLocaleString())
    return (
        <div className='flex flex-col gap-3' data-slot='admin-runtime-overview'>
            <div className='grid gap-3' style={{ gridTemplateColumns: 'repeat(auto-fit, minmax(160px, 1fr))' }}>
                {cell(C.overviewRuntime.sessions, n(read?.summary.sessions))}
                {cell(C.overviewRuntime.violating, n(read?.summary.violating))}
                {cell(C.overviewRuntime.keys, read ? (read.keysFailure ? 'Unavailable' : read.keysComplete ? 'Complete' : 'Partial') : C.overviewRuntime.notRead)}
            </div>
            <div>
                <button type='button' onClick={onRead} className='h-8 rounded-[7px] border px-3 text-[13px]' style={{ borderColor: 'var(--v2-rule)' }}>
                    {C.overviewRuntime.readNow}
                </button>
            </div>
        </div>
    )
}

/** Gateway MCP servers: the chosen workspace's catalog (`GatewayRead::McpServers`, C22). */
function McpTab({ snapshot, dispatch }: { snapshot: ShellSnapshot; dispatch: Dispatch }) {
    const mcp = snapshot.harness.mcp
    const context = snapshot.active?.context ?? null
    const workspace = snapshot.gateway.selected?.reference ?? null
    if (!workspace) return <p className='text-[13px]'>{C.noWorkspace}</p>
    if (!mcp || mcp.servers.length === 0) {
        return (
            <div className='flex flex-col gap-2 text-[13px]'>
                <p>{C.mcpNotRead}</p>
                <div>
                    <button
                        type='button'
                        onClick={() => context && void dispatch({ kind: 'listMcpServers', context, workspace })}
                        className='h-8 rounded-[7px] border px-3 text-[13px]'
                        style={{ borderColor: 'var(--v2-rule)' }}
                    >
                        {C.readMcp}
                    </button>
                </div>
            </div>
        )
    }
    return (
        <table className='w-full text-left text-[13px]' data-slot='admin-mcp'>
            <thead>
                <tr>
                    <th scope='col' className='py-1 pr-3 font-medium'>
                        Server
                    </th>
                    <th scope='col' className='py-1 pr-3 font-medium'>
                        Namespace
                    </th>
                    <th scope='col' className='py-1 font-medium'>
                        Status
                    </th>
                </tr>
            </thead>
            <tbody>
                {mcp.servers.map((s) => (
                    <tr key={s.id}>
                        <td className='py-1 pr-3'>{s.name}</td>
                        <td className='py-1 pr-3 font-mono text-[12px]'>{s.namespace}</td>
                        <td className='py-1'>{s.status}</td>
                    </tr>
                ))}
            </tbody>
        </table>
    )
}
import { useEffect, useRef, useState } from 'react'
import type { RotationView } from '@prisma-airs/desktop-contracts'
import { clockOf } from '../copy'
import { Verdict } from '../verdict'
import { ADMIN_COPY as C } from './copy'

export interface RotationPanelProps {
    rotation: RotationView
    /** The tenant the panel was opened for: an announcement never outlives it. */
    tenant: string | null
    /** Hands the held one-time key to the host sheet (I6). */
    onReveal: (operation: string) => void
    onFinishLater: () => void
    onUpdated: () => void
    onIssueAnother: () => void
    onRemoveOld: () => void
    onReconcile: () => void
    busy: boolean
}

/**
 * The staged Runtime key rotation (C31, I7; screens/reviews-administration.md
 * stages 1–4): every stage is the core's (`RotationView.stage`). The secret
 * is offered only while the core still holds it for this context; once it is
 * not, the panel says so and offers another issuance. Two timestamps are
 * shown with distinct labels: the operator's own statement and the remote
 * readback.
 */
export function RotationPanel({ rotation: r, tenant, onReveal, onFinishLater, onUpdated, onIssueAnother, onRemoveOld, onReconcile, busy }: RotationPanelProps) {
    const btn = 'h-8 rounded-[7px] border px-3 text-[13px] disabled:opacity-60'
    const primary = 'h-8 rounded-[7px] px-3 text-[13px] font-semibold disabled:opacity-60'
    const primaryStyle = {
        background: 'var(--v2-acc)',
        color: 'var(--v2-acc-ink)',
    }
    const rule = { borderColor: 'var(--v2-rule)' }
    // One persistent live region (DESIGN-V2 §8): each observed stage change
    // is announced once, without moving focus; nothing is announced for a
    // tenant other than the one the panel opened for.
    const [opened] = useState(tenant)
    const announcement = tenant === opened ? C.rotation.announce[r.stage](r.application) : ''
    // A stage change replaces its controls; if the focused one went with it,
    // focus stays in the panel instead of falling out of the sheet.
    const panel = useRef<HTMLElement>(null)
    useEffect(() => {
        const active = document.activeElement
        if (panel.current && (!active || active === document.body)) panel.current.focus()
    }, [r.stage])
    return (
        <section
            ref={panel}
            tabIndex={-1}
            aria-label={C.rotation.title(r.application)}
            data-slot='rotation-panel'
            data-stage={r.stage}
            className='flex flex-col gap-3 rounded-[12px] border p-4'
            style={rule}
        >
            <p role='status' aria-live='polite' aria-atomic='true' className='sr-only' data-slot='rotation-status'>
                {announcement}
            </p>
            {r.unsaved ? (
                <p role='alert' data-slot='rotation-unsaved' className='text-[13px]' style={{ color: 'var(--v2-flag)' }}>
                    {C.rotation.unsaved}
                </p>
            ) : null}
            {r.stage === 'issued' ? (
                <>
                    <Verdict tone='flagged' word={C.rotation.issued} />
                    <p className='text-[13px]'>{C.rotation.issuedNote}</p>
                    <div className='flex flex-wrap gap-2'>
                        <button type='button' className={primary} style={primaryStyle} disabled={busy || !r.issuedBy} onClick={() => r.issuedBy && onReveal(r.issuedBy)}>
                            {C.rotation.reveal}
                        </button>
                        <button type='button' className={btn} style={rule} onClick={onFinishLater}>
                            {C.rotation.finishLater}
                        </button>
                        <button type='button' className={btn} style={rule} disabled={busy} onClick={onUpdated}>
                            {C.rotation.updated}
                        </button>
                    </div>
                </>
            ) : r.stage === 'resumed' ? (
                <>
                    <Verdict tone='flagged' word={C.rotation.resumed} />
                    <p className='text-[13px]'>{C.rotation.resumedNote(r.application)}</p>
                    <div className='flex flex-wrap gap-2'>
                        <button type='button' className={btn} style={rule} disabled={busy} onClick={onIssueAnother}>
                            {C.rotation.issueAnother}
                        </button>
                        <button type='button' className={primary} style={primaryStyle} disabled={busy} onClick={onUpdated}>
                            {C.rotation.updated}
                        </button>
                    </div>
                </>
            ) : r.stage === 'acknowledged' ? (
                <>
                    <Verdict tone='info' word={C.rotation.acknowledged(clockOf(r.deploymentAcknowledgedAt ?? 0))} />
                    <p className='text-[13px]'>{C.rotation.acknowledgedNote}</p>
                    {r.removalRejected ? (
                        <p role='alert' className='text-[13px]' style={{ color: 'var(--v2-block)' }}>
                            {C.rotation.rejected(r.removalRejected)}
                        </p>
                    ) : null}
                    <div>
                        <button type='button' className={primary} style={primaryStyle} disabled={busy} onClick={onRemoveOld}>
                            {C.rotation.removeOld(r.oldKey.name)}
                        </button>
                    </div>
                </>
            ) : r.stage === 'issuanceUnconfirmed' || r.stage === 'removalUnconfirmed' ? (
                <>
                    <Verdict tone='flagged' word={r.stage === 'issuanceUnconfirmed' ? C.rotation.issuanceUnconfirmed : C.rotation.removalUnconfirmed} />
                    <p className='text-[13px]'>{r.stage === 'issuanceUnconfirmed' ? C.rotation.issuanceUnconfirmedNote : C.rotation.removalUnconfirmedNote}</p>
                    <div className='flex flex-wrap gap-2'>
                        {r.stage === 'issuanceUnconfirmed' && r.issuedBy ? (
                            // The service answered with a key the readback has not confirmed yet: it is still shown once.
                            <button type='button' className={primary} style={primaryStyle} disabled={busy} onClick={() => r.issuedBy && onReveal(r.issuedBy)}>
                                {C.rotation.reveal}
                            </button>
                        ) : null}
                        <button type='button' className={btn} style={rule} disabled={busy} onClick={onReconcile}>
                            {C.applied.reconcile}
                        </button>
                    </div>
                </>
            ) : (
                <>
                    <Verdict tone='allowed' word={C.rotation.complete(clockOf(r.oldKeyRemovedAt ?? 0))} />
                    <p className='text-[13px]'>{C.rotation.completeNote}</p>
                </>
            )}
            {r.deploymentAcknowledgedAt !== null || r.oldKeyRemovedAt !== null ? (
                <table className='text-[12px]' data-slot='rotation-timestamps'>
                    <caption className='sr-only'>{C.rotation.timestamps}</caption>
                    <tbody>
                        <tr>
                            <th scope='row' className='pr-3 text-left font-medium'>
                                {C.rotation.acknowledgedAt}
                            </th>
                            <td>{r.deploymentAcknowledgedAt !== null ? clockOf(r.deploymentAcknowledgedAt) : '—'}</td>
                        </tr>
                        <tr>
                            <th scope='row' className='pr-3 text-left font-medium'>
                                {C.rotation.removedAt}
                            </th>
                            <td>{r.oldKeyRemovedAt !== null ? clockOf(r.oldKeyRemovedAt) : '—'}</td>
                        </tr>
                    </tbody>
                </table>
            ) : null}
        </section>
    )
}
