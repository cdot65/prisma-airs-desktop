pub fn outcome_of(error: &scm_sdk::Error) -> Outcome {
    match error.remote_outcome() {
        RemoteOutcome::NotSent => Outcome::NotSent,
        RemoteOutcome::Rejected => Outcome::Rejected,
        _ => Outcome::Unknown,
    }
}

