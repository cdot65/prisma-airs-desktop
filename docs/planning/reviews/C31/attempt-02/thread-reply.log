                                        </td>
                                    </tr>
                                )
                            })}
                        </tbody>
                    </table>
                    {needle.length > 0 && rows.length === 0 ? (
                        <p className='text-academy-ink-faint text-[12px]'>No rows on this page match the filter.</p>
                    ) : null}
