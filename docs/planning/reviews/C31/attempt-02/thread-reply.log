type ProgressSlot = Arc<Mutex<Progress>>;

pub(super) struct ChangeRecord {
    operation: OperationId,
    /// The review this change was applied from: ending that review ends the
    /// disclosure of whatever the change returns (C31, I6).
    review: Option<ReviewId>,
    context: ContextRef,
    kind: ChangeKind,
    action: ChangeAction,
    target: String,
    name: Option<String>,
    /// The item as reviewed, by name (a key version's source key), and the
    /// application a key change names (C31 rotations).
    source_name: Option<String>,
    application: Option<String>,
    slot: ApplySlot,
    output: Option<ApplyOutput>,
    secret: SecretState,
    workspace: Option<ListedWorkspace>,
    /// The workspace reference a Gateway change was reviewed under.
    reference: Option<WorkspaceRef>,
    progress: ProgressSlot,
    /// Kept on this Mac when the change settles uncertain (C17, T23).
    local: Option<LocalOrigin>,
    /// The operator ended the review before this change settled: its
    /// one-time secret is dropped the moment it lands (C31, I6).
    forget_on_settle: bool,
}

impl ChangeRecord {
    /// The tenant a Gateway change keeps its local record under.
    pub(super) fn tenant(&self) -> Option<&TenantId> {
        self.local.as_ref().map(|l| &l.tenant)
    }
}

/// What a Gateway change's local record keeps: the tenant, the workspace
/// label and the reviewed draft text (never a key, reply or authority).
pub(super) struct LocalOrigin {
    pub(super) tenant: TenantId,
        let context = context.clone();
        // A sheet opened before a confirmation began must not change the file
        // under it: end that confirmation, whose late completion then applies
        // nothing, and require a new review.
        if let Some(review) = self.change_review.as_mut()
            && let Phase::Confirming { nonce, .. } = review.phase
        {
            self.confirmer.dismiss(nonce);
            review.phase = Phase::Failed(ChangeProblem::StagedFile.into());
        }
        self.staging = match chosen {
            None => None,
            Some(Err(failure)) => Some(Staging::Failed(failure)),
            Some(Ok((name, bytes))) => Some(match staged_text(bytes) {
                Err(failure) => Staging::Failed(failure),
                Ok(text) => match nonce() {
                    Some(n) => Staging::Ready(StagedFile {
                        token: format!("sf-{n:016x}"),
                        context,
                        name,
                        text,
                    }),
                    None => Staging::Failed(StagedFileFailure::Unreadable),
                },
            }),
        };
    }

    pub(super) fn discard_change(&mut self, review: &ReviewId) -> Result<(), Refusal> {
        match &self.change_review {
            Some(r) if &r.id == review => {
                if let Phase::Confirming { nonce, .. } = r.phase {
                    self.confirmer.dismiss(nonce);
                }
                self.change_review = None;
                Ok(())
            }
            _ => {
                // An applied review: its exit retires every one-time secret
                // its changes returned or will return (I6), settled or not.
                let applied: Vec<OperationId> = self
                    .change_results
                    .iter()
                    .filter(|r| r.review.as_ref() == Some(review))
                    .map(|r| r.operation.clone())
                    .collect();
                if applied.is_empty() {
                    return Err(Refusal::ReviewInvalid);
                }
                for operation in &applied {
                    let _ = self.forget_secret(operation);
                }
                Ok(())
            }
        }
    }

    /// Hands the held one-time secret of an applied change to the native
    /// sheet, once: the core keeps no copy afterwards, so closing, copying
    /// or the sheet's expiry ends it for good (DESIGN: one reveal).
    pub(super) fn reveal_secret(
        &mut self,
        operation: &OperationId,
    ) -> Result<(String, Zeroizing<String>), Refusal> {
        let active = self.active_ref.clone();
        let record = self
            .change_results
            .iter_mut()
            .find(|r| &r.operation == operation && Some(&r.context) == active.as_ref())
            .ok_or(Refusal::InvalidInput)?;
        let secret = record
            .output
            .as_mut()
            .and_then(|o| o.secret.take())
            .ok_or(Refusal::CapabilityMissing)?;
        record.secret = SecretState::Shown;
        let what = if record.kind.gateway().is_some() {
            "New Gateway key"
        } else {
            "New API key"
        };
        let label = format!(
            "{what}{}",
            record
                .name
                .as_deref()
                .map(|n| format!(" for {n}"))
                .unwrap_or_default()
        );
        Ok((label, secret))
    }

    /// CancelChange: stops an applying change of the active context. The
    /// job reports what was sent; nothing is rolled back.
    pub(super) fn cancel_change(
        &mut self,
        operation: &OperationId,
    ) -> Result<Vec<crate::runtime::Start>, Refusal> {
        let active = self.active_ref.clone();
        self.change_results
            .iter()
            .find(|r| {
                &r.operation == operation
                    && r.output.is_none()
                    && Some(&r.context) == active.as_ref()
            })
            .ok_or(Refusal::InvalidInput)?;
        let (_, starts) = self.operations.cancel(
            operation,
            crate::runtime::StopReason::Cancelled,
            Instant::now(),
        );
        self.sync_changes();
        Ok(starts)
    }

    /// Another workspace was chosen (or none): every Gateway change bound
    /// to a different reference that has not dispatched its write never
    /// will. Queued work settles not sent when it runs; one already writing
    /// keeps its own outcome. A retired reference is never current again.
    pub(super) fn retire_scoped_applies(&mut self, keep: Option<&WorkspaceRef>) {
        for record in self.change_results.iter().filter(|r| r.output.is_none()) {
            if record.reference.as_ref().is_none_or(|r| Some(r) == keep) {
                continue;
            }
            if let Ok(mut progress) = record.progress.lock()
                && matches!(*progress, Progress::Waiting)
            {
                *progress = Progress::Retired;
            }
        }
    }

    pub(super) fn forget_secret(&mut self, operation: &OperationId) -> Result<(), Refusal> {
        let record = self
            .change_results
            .iter_mut()
            .find(|r| &r.operation == operation)
            .ok_or(Refusal::InvalidInput)?;
        if let Some(output) = record.output.as_mut() {
            output.secret = None;
        } else {
            // Not settled yet: whatever key it returns is dropped on arrival.
            record.forget_on_settle = true;
        }
        if record.secret == SecretState::Held {
            record.secret = SecretState::Forgotten;
        }
        self.secrets.dismiss();
        Ok(())
    }

    /// [`State::forget_secret`] by the operation's text (rotations keep it
    /// as text); an unknown operation has nothing to forget.
    pub(super) fn forget_secret_of(&mut self, operation: &str) {
        let found = self
            .change_results
            .iter()
            .find(|r| r.operation.as_str() == operation)
            .map(|r| r.operation.clone());
        if let Some(operation) = found {
            let _ = self.forget_secret(&operation);
        }
    }

    /// Settles prepared reviews and applied changes; drops everything bound
    /// to a retired context (an open confirmation is ended, held secrets
    /// are zeroized with their record).
    pub(super) fn sync_changes(&mut self) {
        let active = self.active_ref.clone();
        let retired = self.change_review.as_ref().is_some_and(|r| {
            self.secrets.dismiss();
        }
        let mut kept = Vec::new();
        // Settled Runtime changes of the active context drive key rotations (C31).
        let mut rotations: Vec<(TenantId, super::rotation_domain::SettledChange)> = Vec::new();
        let active_tenant = self.data.active.clone();
        for record in self
            .change_results
            .iter_mut()
            .chain(self.detached_changes.iter_mut())
            .filter(|r| r.output.is_none())
        {
            let settled = match self.operations.state(&record.operation) {
                Some(OperationState::Settled(settlement)) => Some(settlement.outcome),
                None => Some(Outcome::Unknown),
                Some(_) => None,
            };
            let Some(settled) = settled else {
                continue;
            };
            let output = record.slot.lock().ok().and_then(|mut s| s.take());
            // Work that never ran (cancelled while queued) settles NotSent.
            let mut output = output.unwrap_or(ApplyOutput {
                outcome: settled,
                failure: Some(ChangeFailure::Service {
                    failure: ManagementFailure::Cancelled,
                }),
                response: None,
                readback: None,
                current: None,
                secret: None,
                provisioning: None,
            });
            if Some(&record.context) != active.as_ref() {
                // A retired context's reply and one-time key go unread.
                output.secret = None;
                output.response = None;
                output.current = None;
            }
            record.secret = if record.forget_on_settle && output.secret.is_some() {
                output.secret = None;
                SecretState::Forgotten
            } else if output.secret.is_some() {
                SecretState::Held
            } else {
                SecretState::None
            };
            if let Some(local) = record.local.take() {
                kept.push(local_settlement(record, local, &output));
            }
            if Some(&record.context) == active.as_ref()
                && record.kind == ChangeKind::ApiKeys
                && let Some(tenant) = active_tenant.clone()
            {
                rotations.push((
                    tenant,
                    super::rotation_domain::SettledChange {
                        operation: record.operation.as_str().to_owned(),
                        kind: record.kind,
                        action: record.action,
                        target: record.target.clone(),
                        new_name: record.name.clone(),
                        source_name: record.source_name.clone(),
                        application: record.application.clone(),
                        outcome: output.outcome,
                        failure: output.failure.map(|f| format!("{f:?}")),
                        readback: output.readback,
                        current: output.current.clone(),
                    },
                ));
            }
            record.output = Some(output);
        }
        self.detached_changes.retain(|r| r.output.is_none());
        for (tenant, change) in rotations {
            self.rotation_settled(&tenant, change);
        }
        for (tenant, settled) in kept {
            self.gateway_local_settled(&tenant, settled);
        }
        let mut settled = 0;
        self.change_results.retain(|r| {
            if r.output.is_some() {
                settled += 1;
                settled <= RETAINED_RESULTS
            } else {
                true
            }
        });
    }

    /// Whether an applied change's one-time secret is still held for the
    /// active context (C31: a rotation's Reveal is offered only then).
    pub(super) fn secret_held(&self, operation: &str) -> bool {
        let active = self.active_ref.as_ref();
        self.change_results.iter().any(|r| {
            r.operation.as_str() == operation
                && Some(&r.context) == active
                && r.secret == SecretState::Held
        })
    }

    pub(super) fn changes_view(&self) -> ChangesView {
        let active = self.active_ref.as_ref();
        let review = self
            .change_review
            .as_ref()
            .filter(|r| Some(&r.context) == active)
            .map(|r| {
            effects.push(Effect::Start(starts));
            state.changed();
        }
        Intent::RequestApply {
            review,
            draft,
            confirmation,
        } => {
            let (nonce, request) = state.request_apply(&review, &draft, &confirmation)?;
            effects.push(Effect::Confirm {
                review,
                nonce,
                request,
            });
            state.changed();
        }
        Intent::ChooseDictionaryFile { context } => {
            let lease = state.lease();
            state.choose_dictionary_file(context, lease)?;
            effects.push(Effect::ChooseTextFile { lease });
            state.changed();
        }
        Intent::DiscardChange { review } => {
            state.discard_change(&review)?;
            state.changed();
        }
        Intent::RevealSecret { operation } => {
            let (label, secret) = state.reveal_secret(&operation)?;
            effects.push(Effect::RevealSecret { label, secret });
            // The key is no longer held: publish that, or the presentation
            // keeps offering a reveal that will be refused.
            state.changed();
        }
        Intent::ForgetSecret { operation } => {
            state.forget_secret(&operation)?;
            state.changed();
        }
        Intent::CancelChange { operation } => {
            let starts = state.cancel_change(&operation)?;
            effects.push(Effect::Start(starts));
            state.changed();
        }
        Intent::OpenGatewayLocal { context } => {
            if let Some(lease) = state.open_gateway_local(&context)? {
                effects.push(Effect::LoadGatewayLocal { lease });
            }
            state.changed();
        }
        Intent::SaveGatewayDraft { context, draft } => {
            let saved = state.save_gateway_draft(&context, draft);
            // A refused draft still publishes its problem.
            state.changed();
            let (tenant, generation) = saved?;
            effects.push(Effect::StoreGatewayLocal { tenant, generation });
        }
        Intent::DiscardGatewayLocal { context, id } => {
            let (tenant, generation) = state.discard_gateway_local(&context, &id)?;
            effects.push(Effect::StoreGatewayLocal { tenant, generation });
            state.changed();
        }
        Intent::ConfigureInferenceCredential {
            client_id,
            tsg,
            endpoints,
            transport,
            session,
            binding,
            investigation,
        })
    }

    /// Admits one management read for the active tenant's management
    /// capability.
    pub(super) fn admit_management(
        &mut self,
        context: ContextRef,
        request: ManagementRequest,
        keychain: Arc<dyn super::CredentialStore>,
        session_vault: Arc<SessionVault>,
    ) -> Result<(OperationId, Vec<crate::runtime::Start>), Refusal> {
        self.check_context(&context)?;
        if !request.is_valid() {
            return Err(Refusal::InvalidInput);
        }
        let gateway = self.gateway_admission(&context, &request)?;
        let source = self.binding_source(&context, keychain, session_vault)?;
        let overview = request == ManagementRequest::Overview;
        // Key reads reconcile rotations (C31): a page, or one key's detail
        // (a walk of the whole inventory, so its absence is authoritative).
        let api_keys_page = matches!(
            request,
            ManagementRequest::Page {
                resource: crate::management::ManagementResource::ApiKeys,
                ..
            } | ManagementRequest::Detail {
                resource: crate::management::ManagementResource::ApiKeys,
                ..
            }
        );
        let lists_workspaces = super::gateway_domain::lists_workspaces(&request);
        let (domain, workspace, scope) = match gateway {
            Some(g) => (g.domain, g.workspace, g.scope),
            // An overview also reads the chosen Gateway workspace's
            // activity (C18); it is labelled with that workspace.
            None if overview => (
                context.as_str().to_owned(),
                None,
                self.chosen_scope(&context),
            ),
            None => (context.as_str().to_owned(), None, None),
        };
        let slot: ResultSlot = Arc::default();
        let job = ManagementJob {
            source,
            request,
            slot: Arc::clone(&slot),
            workspace: scope,
        };
        let (operation, starts) =
            self.operations
                .admit(&domain, 0, job.into_work(), Instant::now())?;
        self.management_calls.push(ManagementRecord {
            operation: operation.clone(),
            context,
            slot,
            cell: Arc::default(),
            settled: false,
            if for_setup {
                // Consumed by the setup; nothing observes it.
                record.observed = true;
                setup_results.push((record.operation.clone(), result.clone()));
            }
            if let Ok(mut slot) = record.cell.result.lock() {
                *slot = Some(result);
            }
            record.cell.ready.notify_waiters();
        }
        for (operation, result) in setup_results {
            self.setup_settled(&operation, &result);
        }
        for (context, result) in overviews {
            self.overview_settled(&context, result);
        }
        for (context, product, result) in parts {
            self.product_read_settled(&context, product, &result);
        }
        for read in key_pages {
            match read {
                KeyRead::Items(context, items, whole) => {
                    if let Ok(tenant) = self.check_context(&context)
                        && let Ok(items) = serde_json::from_str::<Vec<serde_json::Value>>(&items)
                    {
                        self.rotation_reconcile(&tenant, &items, whole);
                    }
                }
                KeyRead::Absent(context, id) => {
                    if let Ok(tenant) = self.check_context(&context) {
                        self.rotation_key_absent(&tenant, &id);
                    }
                }
            }
        }
        for (context, list) in listings {
            self.gateway_listed(&context, &list);
        }
        let mut settled = 0;
        let mut keep = vec![true; self.management_calls.len()];
#[serde(rename_all = "camelCase")]
pub struct KeyRef {
    pub id: String,
    pub name: String,
}

/// Whether the additional key's issuance was confirmed by readback (C31).
#[derive(Clone, Copy, Debug, PartialEq, Eq, Serialize, Deserialize, TS)]
#[serde(rename_all = "camelCase")]
pub enum RotationIssuance {
    Confirmed,
    /// The version settled unknown: a key is confirmed only once the key
    /// inventory shows one for the application besides the old key.
    Unconfirmed,
}

/// Where the old key's removal stands (C31).
#[derive(Clone, Debug, PartialEq, Eq, Serialize, Deserialize, TS)]
#[serde(tag = "state", rename_all = "camelCase")]
pub enum RotationRemoval {
    Pending,
    /// Sent but not read back absent: reconciled by a complete inventory.
    Unconfirmed,
    /// Refused or failed: the reminder stays, the completion time unset.
    Rejected {
        reason: String,
    },
    Done,
}

/// One Runtime API key rotation of a tenant (C31, I7), persisted so its two
/// timestamps are stored once and survive reads, switches and relaunches.
#[derive(Clone, Debug, PartialEq, Eq, Serialize, Deserialize, TS)]
#[serde(rename_all = "camelCase")]
pub struct Rotation {
    pub application: String,
    pub old_key: KeyRef,
    pub new_key: Option<KeyRef>,
    pub issuance: RotationIssuance,
    /// The change result that issued the key (its one-time secret lives
    /// there, for the context it was applied in, never here).
    pub issued_by: Option<String>,
    /// The key name the issuing review named: the only key that can confirm
    /// an unconfirmed issuance.
    #[serde(default)]
    pub pending_name: Option<String>,
    pub issued_at: u32,
    /// The operator's local statement that the application uses the new key.
    pub deployment_acknowledged_at: Option<u32>,
    pub removal: RotationRemoval,
    /// When the old key was read back absent (remote readback).
    pub old_key_removed_at: Option<u32>,
}

/// Stable identifier of a top-level desktop feature destination.
#[derive(Clone, Copy, Debug, PartialEq, Eq, Hash, Serialize, Deserialize, TS)]
#[serde(rename_all = "camelCase")]
pub enum FeatureId {
    /// v2 only (C28): the tenant's Home.
    Home,
    /// v2 only (C28): the Inbox.
    Inbox,
    Runtime,
    Academy,
    Administration,
    Sessions,
    Library,
    RedTeam,
    ApiClient,
    Gateway,
    Harness,
    Import,
    Settings,
