import { forwardRef, useEffect, useId, useRef, useState } from 'react'
import { Button, Callout, Input } from '@ai-security-academy/presentation'
import { AlertTriangle, Info, Lock } from 'lucide-react'
import type {
    AdminAction,
    ContextRef,
    FeatureId,
    ManagementDetail,
    ManagementPage,
    ManagementResource,
    RotationView,
    ShellSnapshot,
} from '@prisma-airs/desktop-contracts'
import { PageHeading } from '../../shell/feature-view'
import { CHANGE_NOUN, type ChangeTarget, ChangeResults, ChangeWorkbench, TEMPLATES, isGatewayKind, pretty, verbOf } from './runtime-changes'
import type { Dispatch } from '../tenants/dispatch'
import {
    MANAGEMENT_FAILURE_TEXT,
    type ObserveManagement,
    RESOURCES,
    type ResourceInfo,
    fieldText,
    itemId,
    itemName,
    readManagement,
} from './management-read'

/** Rows per page (the native side accepts 1..=100). */
export const PAGE_SIZE = 25

interface Props {
    snapshot: ShellSnapshot
    dispatch: Dispatch
    observe: ObserveManagement
    onNavigate: (id: FeatureId) => void
    /** The inventory and item a contextual action asked for (C30): selected on arrival. */
    arrival?: { resource: ManagementResource | null; item: string | null; sequence: number } | null
    /** v2 (C31): one inventory, pinned (no picker); the shell renders it inside its Administration tab. */
    pinned?: ManagementResource
    /** v2 (C31): no page heading (the shell's accordion names the product and tab). */
    embedded?: boolean
    /** v2 (C31): the labels the Administration inventory gives each action (`AdminInventory`). */
    labels?: Partial<Record<ChangeTarget['action'], string>>
    /** v2 (C31): the tab's admitted actions; only these are offered (create above the table, the rest per row). */
    admitted?: AdminAction[]
    /** v2 (C31): changes open in the shell's review sheet instead of the inline workbench. */
    onReview?: (change: ChangeTarget) => void
    /** v2 (C31): rotations in progress, so an old key's row offers "Finish rotation…". */
    rotations?: RotationView[]
    onFinishRotation?: (application: string) => void
}

type Item = Record<string, unknown>

/** The last page the service returned, kept while a refresh fails. */
interface Shown {
    page: ManagementPage
    items: Item[]
    readAt: Date
}

type DetailState =
    | { kind: 'loading'; name: string }
    | { kind: 'shown'; name: string; detail: ManagementDetail; item: Item | null }
    | { kind: 'failed'; name: string; message: string }

const time = (date: Date) => date.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit', second: '2-digit' })

function rangeText(page: ManagementPage): string {
    if (page.count === 0) return page.offset === 0 ? 'No items' : `No items from ${page.offset + 1}`
    const first = page.offset + 1
    const last = page.offset + page.count
    if (page.total !== null) return `Items ${first}–${last} of ${page.total}`
    // Without a service total, an incomplete inventory only proves a minimum.
    return page.complete ? `Items ${first}–${last} of ${last}` : `Items ${first}–${last} of ${last}+`
}

/**
 * Read-only management inventories for the active tenant (C08). Every page
 * and detail is one explicit read through the tenant's separate management
 * client; nothing is cached across tenants or credential generations, a
 * failed refresh keeps the previous rows visibly marked with their age, and
 * an inventory is called empty or complete only when the service said so.
 */
export const AdministrationView = forwardRef<HTMLHeadingElement, Props>(function AdministrationView(
    { snapshot, dispatch, observe, onNavigate, arrival = null, pinned, embedded = false, labels, admitted, onReview, rotations = [], onFinishRotation },
    ref
) {
    const ids = useId()
    const tenant = snapshot.tenants.find((t) => t.id === snapshot.active?.tenant)
    const context: ContextRef | null = snapshot.active?.context ?? null
    const ready = tenant?.management.state === 'ready'
    const [resource, setResource] = useState<ManagementResource>(pinned ?? arrival?.resource ?? 'profiles')
    const [shown, setShown] = useState<Shown | null>(null)
    const [failure, setFailure] = useState<string | null>(null)
    const [loading, setLoading] = useState(false)
    const [filter, setFilter] = useState(arrival?.item ?? '')
    // A contextual action's item survives the inventory reset that its
    // arrival (or a resource change it asks for) triggers; a contextual
    // action while the view is already open selects its target too.
    const arrivalItem = useRef<string | null>(arrival?.item ?? null)
    const seenArrival = useRef(arrival?.sequence ?? 0)
    useEffect(() => {
        if (!arrival || arrival.sequence === seenArrival.current) return
        seenArrival.current = arrival.sequence
        arrivalItem.current = arrival.item
        if (arrival.resource) setResource(arrival.resource)
        setFilter(arrival.item ?? '')
    }, [arrival])
    const [detail, setDetail] = useState<DetailState | null>(null)
    const [change, setChange] = useState<ChangeTarget | null>(null)
    // A Harness proposal the operator opened into the review (C21) is shown
    // here with its exact draft, so Apply sends what was reviewed; it opens
