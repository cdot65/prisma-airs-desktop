import { type ReactNode, useEffect, useRef, useState } from 'react'
import type { ChangeKind, ChangeResultView, ContextRef, GatewayResource, ManagementRequest, ManagementResource, ShellSnapshot } from '@prisma-airs/desktop-contracts'
import { MANAGEMENT_FAILURE_TEXT, RESOURCES, itemName, readManagement, type ObserveManagement } from '../../features/administration/management-read'
import { type ChangeTarget, ChangeWorkbench, TEMPLATES, pretty, resultText } from '../../features/administration/runtime-changes'
import type { Dispatch } from '../../features/tenants/dispatch'
import { Modal } from '../modal'
import { useShellStore } from '../store'
import { Verdict } from '../verdict'
import { ADMIN_COPY as C } from './copy'
import { RotationPanel } from './rotation-panel'

export interface ReviewSheetProps {
    snapshot: ShellSnapshot
    context: ContextRef
    dispatch: Dispatch
    observe: ObserveManagement
    /** The change to review first (none when opening a rotation in progress). */
    change: ChangeTarget | null
    /** The application whose rotation this sheet follows (a key version, or "Finish rotation…"). */
    rotation: string | null
    /** A Gateway change keeps its edited text on this Mac as a draft (C17). */
    onDraft?: (body: string) => void
    note?: ReactNode
    onClose: () => void
}

const matches = (r: ChangeResultView, c: ChangeTarget) => r.kind === c.kind && r.action === c.action && r.target === c.target

const RUNTIME_RESOURCE: Partial<Record<ChangeKind, ManagementResource>> = {
    profiles: 'profiles',
    topics: 'topics',
    applications: 'applications',
    apiKeys: 'apiKeys',
    dataPatterns: 'dataPatterns',
    dataProfiles: 'dataProfiles',
    filteringProfiles: 'filteringProfiles',
    dictionaries: 'dictionaries',
}
const GATEWAY_RESOURCE: Partial<Record<ChangeKind, GatewayResource>> = {
    gatewayWorkspaces: 'workspaces',
    gatewayProviders: 'providers',
    gatewayRoutes: 'routes',
    gatewayGuardrails: 'guardrails',
    gatewayServiceKeys: 'serviceKeys',
    gatewayUserKeys: 'userKeys',
    gatewayIntegrations: 'integrations',
}

/** What an applied change established, for its action (C31): never success from a readback value alone. */
export type AppliedState = 'live' | 'removed' | 'unconfirmed' | 'failed'
export function appliedState(r: ChangeResultView): AppliedState {
    if (r.outcome === 'unknown') return 'unconfirmed'
    if (r.outcome !== 'completed') return 'failed'
    // The service accepted it; only the readback of this action confirms it.
    if (r.failure) return 'unconfirmed'
    if (r.action === 'delete') return r.readback === 'absent' ? 'removed' : 'unconfirmed'
    return r.readback === 'found' ? 'live' : 'unconfirmed'
}

/** What a reconciliation read of the reviewed item established now. */
type Reconciled = { state: 'reading' } | { state: 'read' } | { state: 'present' } | { state: 'absent' } | { state: 'partial' } | { state: 'failed'; message: string }

/**
 * The review surface (C31, I3, I6, I7): the reviewed change (diff, impact,
 * "Type <name> to confirm" with Apply disabled until it matches; the native
 * confirmation applies), then its applied panel from the core's result, or
 * the staged rotation panel for a Runtime key version. Every exit (Done,
 * Escape, the scrim, navigation, unmount) ends the reviews it opened in the
 * core, which retires any one-time key their changes returned or will
 * return; a key held for a rotation it resumed is forgotten too.
 */
export function ReviewSheet({ snapshot, context, dispatch, observe, change: initial, rotation: rotationApp, onDraft, note, onClose }: ReviewSheetProps) {
    const [change, setChange] = useState<ChangeTarget | null>(initial)
    const [application] = useState<string | null>(rotationApp ?? (initial?.kind === 'apiKeys' && initial.action === 'version' ? applicationOf(initial) : null))
    const [busy, setBusy] = useState(false)
    const [reconciled, setReconciled] = useState<Reconciled | null>(null)
    // Results present when this change was opened are not its outcome.
    const seen = useRef(new Set(snapshot.changes.results.map((r) => r.operation)))
    useEffect(() => {
        seen.current = new Set(snapshot.changes.results.map((r) => r.operation))
        setReconciled(null)
        // eslint-disable-next-line react-hooks/exhaustive-deps -- reset per opened change only
    }, [change])
    const result = change ? (snapshot.changes.results.find((r) => matches(r, change) && !seen.current.has(r.operation)) ?? null) : null
    const rotation = application ? (snapshot.rotations.find((r) => r.application === application) ?? null) : null
    // A key change of a rotation is followed by the rotation panel once it settles.
    const rotationStep = !!change && change.kind === 'apiKeys' && (change.action === 'version' || change.action === 'delete') && !!application
    const showWorkbench = !!change && !(result?.settled && rotationStep)

    // A completion is confirmed once more by a toast bound to this tenant and
    // context (I2, I10): it persists under Reduce Motion until dismissed.
    const announced = useRef(new Set<string>())
    const stage = rotation?.stage ?? null
    const settledState = result?.settled && !rotationStep ? appliedState(result) : null
    useEffect(() => {
        const say = (key: string, text: string) => {
            if (announced.current.has(key)) return
            announced.current.add(key)
            useShellStore.getState().toast(text, 'ok', undefined, snapshot.active?.tenant ?? null, context)
        }
        if (stage === 'complete' && rotation) say(`rotation-${rotation.application}`, C.rotation.completeToast(rotation.application))
        if (result && (settledState === 'live' || settledState === 'removed'))
            say(result.operation, settledState === 'live' ? C.applied.liveToast(change?.title ?? '') : C.applied.removedToast(change?.title ?? ''))
        // eslint-disable-next-line react-hooks/exhaustive-deps -- on each observed completion
    }, [stage, settledState])

    // Every review this sheet opened, so its exit can end each one in the core.
    const reviews = useRef(new Set<string>())
    const open = snapshot.changes.review?.review ?? null
    useEffect(() => {
        if (open && change) reviews.current.add(open)
    }, [open, change])
    const exit = useRef<() => void>(() => {})
    exit.current = () => {
        // I6: the core ends each review; an applied one retires the one-time
        // key its change returned, settled or still under way.
        for (const review of reviews.current) void dispatch({ kind: 'discardChange', review })
        reviews.current.clear()
        if (rotation?.issuedBy) void dispatch({ kind: 'forgetSecret', operation: rotation.issuedBy })
    }
    // Unmount (navigation, tenant switch, window close) is an exit too. The
    // deferred call lets a development re-mount cancel it.
    const pendingExit = useRef<number | null>(null)
    useEffect(() => {
        if (pendingExit.current !== null) window.clearTimeout(pendingExit.current)
        pendingExit.current = null
        return () => {
            pendingExit.current = window.setTimeout(() => exit.current(), 0)
        }
    }, [])

    function close() {
        exit.current()
        onClose()
    }

    async function updated() {
        if (!rotation) return
        setBusy(true)
        await dispatch({
            kind: 'acknowledgeDeployment',
            context,
            application: rotation.application,
        })
        setBusy(false)
        setChange(removeOld(rotation.oldKey.id, rotation.oldKey.name))
    }

    /** Reads the reviewed item itself (never a replay): its detail by ID, or the inventory by name for a creation. */
    async function reconcile(of: { kind: ChangeKind; target: string; name: string | null; workspace?: string | null }) {
        setBusy(true)
        setReconciled({ state: 'reading' })
        const runtime = RUNTIME_RESOURCE[of.kind]
        const gateway = GATEWAY_RESOURCE[of.kind]
        let request: ManagementRequest | null = null
        if (runtime) request = of.target ? { kind: 'detail', resource: runtime, id: of.target } : { kind: 'page', resource: runtime, offset: 0, limit: 100 }
        else if (gateway) {
            const workspace = gateway === 'workspaces' || gateway === 'integrations' ? null : (of.workspace ?? null)
            request = {
                kind: 'gateway',
                workspace,
                read: of.target ? { kind: 'detail', resource: gateway, id: of.target } : { kind: 'inventory', resource: gateway },
            }
        }
        if (!request) {
            setBusy(false)
            setReconciled({ state: 'failed', message: C.applied.cannotReconcile })
            return
        }
        const outcome = await readManagement(dispatch, observe, context, request)
        setBusy(false)
        if (outcome.kind === 'notAdmitted') return setReconciled({ state: 'failed', message: outcome.message })
        const r = outcome.result
        if (r.kind === 'failed')
            return setReconciled({
                state: 'failed',
                message: MANAGEMENT_FAILURE_TEXT[r.failure],
            })
        const found = r.kind === 'detail' ? r.detail.found : r.kind === 'gateway' && r.gateway.kind === 'detail' ? r.gateway.detail.found : null
        if (found)
            return setReconciled({
                state: found === 'found' ? 'present' : found === 'absent' ? 'absent' : 'partial',
            })
        // A rotation's issuance: the core matched the reviewed key name; the panel shows what it established.
        if (of.name === null) return setReconciled({ state: 'read' })
        // A creation: look for its name in what was read.
        let rows: Record<string, unknown>[] = []
        let complete = false
        if (r.kind === 'page') {
            rows = JSON.parse(r.page.items) as Record<string, unknown>[]
            complete = r.page.offset === 0 && r.page.complete
        } else if (r.kind === 'gateway' && r.gateway.kind === 'list') {
            rows = JSON.parse(r.gateway.list.rows) as Record<string, unknown>[]
            complete = r.gateway.list.complete
        }
        const info = RESOURCES.find((x) => x.id === runtime)
        const named = rows.some((row) => (info ? itemName(info, row) : String(row.name ?? '')) === of.name)
        setReconciled({
            state: named ? 'present' : complete ? 'absent' : 'partial',
        })
    }

    return (
        <Modal label={application ? C.rotation.title(application) : C.reviewTitle} onClose={close} width={760} data-slot='review-sheet'>
            <div className='flex flex-col gap-4'>
                <h2 className='text-[16px] font-semibold'>{application ? C.rotation.title(application) : (change?.title ?? C.reviewTitle)}</h2>
                {rotation ? (
                    <RotationPanel
                        rotation={rotation}
                        tenant={snapshot.active?.tenant ?? null}
                        busy={busy}
                        onReveal={(operation) => void dispatch({ kind: 'revealSecret', operation })}
                        onFinishLater={close}
                        onUpdated={() => void updated()}
                        onIssueAnother={() => setChange(issueAnother(rotation.oldKey.id, rotation.application))}
                        onRemoveOld={() => setChange(removeOld(rotation.oldKey.id, rotation.oldKey.name))}
                        onReconcile={() =>
                            void reconcile(
                                rotation.stage === 'removalUnconfirmed'
                                    ? {
                                          kind: 'apiKeys',
                                          target: rotation.oldKey.id,
                                          name: rotation.oldKey.name,
                                      }
                                    : { kind: 'apiKeys', target: '', name: null }
                            )
                        }
                    />
                ) : null}
                {showWorkbench && change ? (
                    <ChangeWorkbench
                        key={`${change.kind}-${change.action}-${change.target}-${change.draftId ?? ''}`}
                        change={change}
                        review={snapshot.changes.review}
                        staged={snapshot.changes.staged}
                        context={context}
                        dispatch={dispatch}
                        onClose={close}
                        onDraft={onDraft}
                        note={note}
                        requireTyped
                    />
                ) : null}
                {result && !rotationStep ? (
                    <Applied
                        result={result}
                        reconciled={reconciled}
                        busy={busy}
                        onDone={close}
                        onReconcile={() =>
                            void reconcile({
                                kind: result.kind,
                                target: result.target,
                                name: result.name,
                                workspace: change?.workspace ?? null,
                            })
                        }
                        onReveal={() =>
                            void dispatch({
                                kind: 'revealSecret',
                                operation: result.operation,
                            })
                        }
                    />
                ) : null}
                {result && rotationStep && !result.settled ? (
                    <p role='status' className='text-[13px]'>
                        {resultText(result)}
                    </p>
                ) : null}
                {result && rotationStep && result.settled && !rotation ? (
                    // Nothing was issued (or the rotation could not be named): the core's result, as it is.
                    <p role='alert' data-slot='rotation-not-started' className='text-[13px]' style={{ color: 'var(--v2-block)' }}>
                        {resultText(result)}
                    </p>
                ) : null}
                {rotation && reconciled ? <ReconcileNote reconciled={reconciled} /> : null}
            </div>
        </Modal>
    )
}

function ReconcileNote({ reconciled }: { reconciled: Reconciled }) {
    return (
        <p role='status' data-slot='reconciled' data-state={reconciled.state} className='text-[13px]'>
            {reconciled.state === 'reading'
                ? C.applied.reading
                : reconciled.state === 'read'
                  ? C.applied.readRotation
                  : reconciled.state === 'present'
                    ? C.applied.present
                    : reconciled.state === 'absent'
                      ? C.applied.absent
                      : reconciled.state === 'partial'
                        ? C.applied.partial
                        : C.applied.readFailed(reconciled.message)}
        </p>
    )
}

/** The applied panel of a non-rotation change: only what the core's readback established, for its action. */
function Applied({
    result,
    reconciled,
    busy,
    onDone,
    onReconcile,
    onReveal,
}: {
    result: ChangeResultView
    reconciled: Reconciled | null
    busy: boolean
    onDone: () => void
    onReconcile: () => void
    onReveal: () => void
}) {
    if (!result.settled) {
        return (
            <p role='status' className='text-[13px]' data-slot='applied'>
                {resultText(result)}
            </p>
        )
    }
    const state = appliedState(result)
    return (
        <section role='status' data-slot='applied' data-state={state} className='flex flex-col gap-2 rounded-[12px] border p-4' style={{ borderColor: 'var(--v2-rule)' }}>
            {state === 'live' ? (
                <Verdict tone='allowed' word={C.applied.live} />
            ) : state === 'removed' ? (
                <Verdict tone='allowed' word={C.applied.removed} />
            ) : state === 'unconfirmed' ? (
                <Verdict tone='flagged' word={C.applied.notConfirmed} />
            ) : (
                <Verdict tone='blocked' word={C.applied.failed} />
            )}
            <p className='text-[13px]'>{resultText(result)}</p>
            {result.secret === 'held' ? (
                <p className='text-[13px]' data-slot='applied-secret'>
                    {C.rotation.issuedNote}
                </p>
            ) : null}
            {reconciled ? <ReconcileNote reconciled={reconciled} /> : null}
            <div className='flex gap-2'>
                {result.secret === 'held' ? (
                    <button type='button' className='h-8 rounded-[7px] border px-3 text-[13px]' style={{ borderColor: 'var(--v2-rule)' }} onClick={onReveal}>
                        {C.rotation.reveal}
                    </button>
                ) : null}
                {state === 'unconfirmed' ? (
                    <button
                        type='button'
                        disabled={busy}
                        className='h-8 rounded-[7px] border px-3 text-[13px] disabled:opacity-60'
                        style={{ borderColor: 'var(--v2-rule)' }}
                        onClick={onReconcile}
                    >
                        {C.applied.reconcile}
                    </button>
                ) : null}
                <button
                    type='button'
                    className='h-8 rounded-[7px] px-3 text-[13px] font-semibold'
                    style={{ background: 'var(--v2-acc)', color: 'var(--v2-acc-ink)' }}
                    onClick={onDone}
                >
                    {C.applied.done}
                </button>
            </div>
        </section>
    )
}

function applicationOf(change: ChangeTarget): string | null {
    try {
        const body = JSON.parse(change.body) as { cust_app?: unknown }
        return typeof body.cust_app === 'string' && body.cust_app ? body.cust_app : null
    } catch {
        return null
    }
}

const issueAnother = (oldKey: string, application: string): ChangeTarget => ({
    kind: 'apiKeys',
    action: 'version',
    target: oldKey,
    title: `Issue additional key for ${application}`,
    body: pretty({ ...TEMPLATES.key, cust_app: application }),
})

const removeOld = (oldKey: string, name: string): ChangeTarget => ({
    kind: 'apiKeys',
    action: 'delete',
    target: oldKey,
    title: `Remove ${name}`,
    body: '{}',
})
import { useEffect, useRef, useState } from 'react'
import type { RotationView } from '@prisma-airs/desktop-contracts'
import { clockOf } from '../copy'
import { Verdict } from '../verdict'
import { ADMIN_COPY as C } from './copy'

export interface RotationPanelProps {
    rotation: RotationView
    /** The tenant the panel was opened for: an announcement never outlives it. */
    tenant: string | null
    /** Hands the held one-time key to the host sheet (I6). */
    onReveal: (operation: string) => void
    onFinishLater: () => void
    onUpdated: () => void
    onIssueAnother: () => void
    onRemoveOld: () => void
    onReconcile: () => void
    busy: boolean
}

/**
 * The staged Runtime key rotation (C31, I7; screens/reviews-administration.md
 * stages 1–4): every stage is the core's (`RotationView.stage`). The secret
 * is offered only while the core still holds it for this context; once it is
 * not, the panel says so and offers another issuance. Two timestamps are
 * shown with distinct labels: the operator's own statement and the remote
 * readback.
 */
export function RotationPanel({ rotation: r, tenant, onReveal, onFinishLater, onUpdated, onIssueAnother, onRemoveOld, onReconcile, busy }: RotationPanelProps) {
    const btn = 'h-8 rounded-[7px] border px-3 text-[13px] disabled:opacity-60'
    const primary = 'h-8 rounded-[7px] px-3 text-[13px] font-semibold disabled:opacity-60'
    const primaryStyle = {
        background: 'var(--v2-acc)',
        color: 'var(--v2-acc-ink)',
    }
    const rule = { borderColor: 'var(--v2-rule)' }
    // One persistent live region (DESIGN-V2 §8): each observed stage change
    // is announced once, without moving focus; nothing is announced for a
    // tenant other than the one the panel opened for.
    const [opened] = useState(tenant)
    const announcement = tenant === opened ? C.rotation.announce[r.stage](r.application) : ''
    // A stage change replaces its controls; if the focused one went with it,
    // focus stays in the panel instead of falling out of the sheet.
    const panel = useRef<HTMLElement>(null)
    useEffect(() => {
        const active = document.activeElement
        if (panel.current && (!active || active === document.body)) panel.current.focus()
    }, [r.stage])
    return (
        <section
            ref={panel}
            tabIndex={-1}
            aria-label={C.rotation.title(r.application)}
            data-slot='rotation-panel'
            data-stage={r.stage}
            className='flex flex-col gap-3 rounded-[12px] border p-4'
            style={rule}
        >
            <p role='status' aria-live='polite' aria-atomic='true' className='sr-only' data-slot='rotation-status'>
                {announcement}
            </p>
            {r.stage === 'issued' ? (
                <>
                    <Verdict tone='flagged' word={C.rotation.issued} />
                    <p className='text-[13px]'>{C.rotation.issuedNote}</p>
                    <div className='flex flex-wrap gap-2'>
                        <button type='button' className={primary} style={primaryStyle} disabled={busy || !r.issuedBy} onClick={() => r.issuedBy && onReveal(r.issuedBy)}>
                            {C.rotation.reveal}
                        </button>
                        <button type='button' className={btn} style={rule} onClick={onFinishLater}>
                            {C.rotation.finishLater}
                        </button>
                        <button type='button' className={btn} style={rule} disabled={busy} onClick={onUpdated}>
                            {C.rotation.updated}
                        </button>
                    </div>
                </>
            ) : r.stage === 'resumed' ? (
                <>
                    <Verdict tone='flagged' word={C.rotation.resumed} />
                    <p className='text-[13px]'>{C.rotation.resumedNote(r.application)}</p>
                    <div className='flex flex-wrap gap-2'>
                        <button type='button' className={btn} style={rule} disabled={busy} onClick={onIssueAnother}>
                            {C.rotation.issueAnother}
                        </button>
                        <button type='button' className={primary} style={primaryStyle} disabled={busy} onClick={onUpdated}>
                            {C.rotation.updated}
                        </button>
                    </div>
                </>
            ) : r.stage === 'acknowledged' ? (
                <>
                    <Verdict tone='info' word={C.rotation.acknowledged(clockOf(r.deploymentAcknowledgedAt ?? 0))} />
                    <p className='text-[13px]'>{C.rotation.acknowledgedNote}</p>
                    {r.removalRejected ? (
                        <p role='alert' className='text-[13px]' style={{ color: 'var(--v2-block)' }}>
                            {C.rotation.rejected(r.removalRejected)}
                        </p>
                    ) : null}
                    <div>
                        <button type='button' className={primary} style={primaryStyle} disabled={busy} onClick={onRemoveOld}>
                            {C.rotation.removeOld(r.oldKey.name)}
                        </button>
                    </div>
                </>
            ) : r.stage === 'issuanceUnconfirmed' || r.stage === 'removalUnconfirmed' ? (
                <>
                    <Verdict tone='flagged' word={r.stage === 'issuanceUnconfirmed' ? C.rotation.issuanceUnconfirmed : C.rotation.removalUnconfirmed} />
                    <p className='text-[13px]'>{r.stage === 'issuanceUnconfirmed' ? C.rotation.issuanceUnconfirmedNote : C.rotation.removalUnconfirmedNote}</p>
                    <div className='flex flex-wrap gap-2'>
                        {r.stage === 'issuanceUnconfirmed' && r.issuedBy ? (
                            // The service answered with a key the readback has not confirmed yet: it is still shown once.
                            <button type='button' className={primary} style={primaryStyle} disabled={busy} onClick={() => r.issuedBy && onReveal(r.issuedBy)}>
                                {C.rotation.reveal}
                            </button>
                        ) : null}
                        <button type='button' className={btn} style={rule} disabled={busy} onClick={onReconcile}>
                            {C.applied.reconcile}
                        </button>
                    </div>
                </>
            ) : (
                <>
                    <Verdict tone='allowed' word={C.rotation.complete(clockOf(r.oldKeyRemovedAt ?? 0))} />
                    <p className='text-[13px]'>{C.rotation.completeNote}</p>
                </>
            )}
            {r.deploymentAcknowledgedAt !== null || r.oldKeyRemovedAt !== null ? (
                <table className='text-[12px]' data-slot='rotation-timestamps'>
                    <caption className='sr-only'>{C.rotation.timestamps}</caption>
                    <tbody>
                        <tr>
                            <th scope='row' className='pr-3 text-left font-medium'>
                                {C.rotation.acknowledgedAt}
                            </th>
                            <td>{r.deploymentAcknowledgedAt !== null ? clockOf(r.deploymentAcknowledgedAt) : '—'}</td>
                        </tr>
                        <tr>
                            <th scope='row' className='pr-3 text-left font-medium'>
                                {C.rotation.removedAt}
                            </th>
                            <td>{r.oldKeyRemovedAt !== null ? clockOf(r.oldKeyRemovedAt) : '—'}</td>
                        </tr>
                    </tbody>
                </table>
            ) : null}
        </section>
    )
}
import { forwardRef, type ReactNode, useCallback, useEffect, useState } from 'react'
import { createPortal } from 'react-dom'
import type { AdminProduct, AdminTab, DesktopClient, FeatureId, ManagementResource, ShellSnapshot } from '@prisma-airs/desktop-contracts'
import { AdministrationView } from '../../features/administration/administration-view'
import type { ChangeTarget } from '../../features/administration/runtime-changes'
import { GatewayView, type GatewayTab } from '../../features/gateway/gateway-view'
import { RedTeamView, type RedTeamSection, type RedTeamTab } from '../../features/red-team/red-team-view'
import { RuntimeView } from '../../features/runtime/runtime-view'
import type { Dispatch } from '../../features/tenants/dispatch'
import type { Act } from '../inbox/inbox'
import type { Arrival } from '../store'
import { SHELL_COPY } from '../copy'
import { Verdict } from '../verdict'
import { ADMIN_COPY as C } from './copy'
import { ReviewSheet } from './review-sheet'

export interface AdministrationProps {
    snapshot: ShellSnapshot
    dispatch: Dispatch
    client: DesktopClient
    onAct: Act
    onNavigate: (feature: FeatureId) => void
    arrival: Arrival | null
}

const DLP: ManagementResource[] = ['dataPatterns', 'dictionaries', 'dataProfiles', 'filteringProfiles', 'dlpCatalog']
const DLP_LABEL: Record<string, string> = {
    dataPatterns: 'Data patterns',
    dictionaries: 'Dictionaries',
    dataProfiles: 'Data profiles',
    filteringProfiles: 'Data filtering profiles',
    dlpCatalog: 'DLP profiles (AIRS)',
}
const DLP_KIND: Partial<Record<ManagementResource, string>> = {
    dataPatterns: 'dataPatterns',
    dictionaries: 'dictionaries',
    dataProfiles: 'dataProfiles',
    filteringProfiles: 'filteringProfiles',
}
const GATEWAY_TAB: Record<string, GatewayTab> = {
    overview: 'usage',
    workspaces: 'workspace',
    routes: 'routes',
    providers: 'providers',
    guardrails: 'guardrails',
    integrations: 'integrations',
    logs: 'logs',
}
const RED_TEAM_TAB = (product: AdminProduct): RedTeamTab => (product.id === 'modelSkill' ? 'models' : 'redTeam')
/** Each read-only tab renders its own read surface (screens/administration-inventory.md). */
const SECTION: Record<string, Record<string, RedTeamSection>> = {
    redTeam: {
        overview: 'overview',
        targets: 'targets',
        scans: 'scans',
        'attack-results': 'attacks',
        reports: 'reports',
    },
    modelSkill: {
        overview: 'modelOverview',
        'model-scans': 'modelScans',
        'skill-scans': 'skillScans',
    },
}

interface Sheet {
    change: ChangeTarget | null
    rotation: string | null
    onDraft?: (body: string) => void
    note?: ReactNode
}

/**
 * Administration (C31, screens/reviews-administration.md): the accordion of
 * the products in `AdminInventory`, each tab rendered by its disposition.
 * Read and Change tabs render the retained views (the same reads and
 * reviewed changes), with the inventory's labels for exactly its actions;
 * Unavailable tabs and products show their gate and nothing else; Removed
 * tabs are not rendered. Every change opens the review sheet; a key rotation
 * follows the core's staged sequence there.
 */
export const Administration = forwardRef<HTMLHeadingElement, AdministrationProps>(function Administration(
    { snapshot, dispatch, client, onAct, onNavigate, arrival },
    ref
) {
    const tenant = snapshot.tenants.find((t) => t.id === snapshot.active?.tenant) ?? null
    const context = snapshot.active?.context ?? null
    const products = snapshot.administration?.products ?? []
    const [open, setOpen] = useState<Record<string, boolean>>({
        runtimeSecurity: true,
    })
    const [tabOf, setTabOf] = useState<Record<string, string>>({
        runtimeSecurity: 'custom-topics',
        gateway: 'routes',
        redTeam: 'scans',
        modelSkill: 'skill-scans',
    })
    const [dlp, setDlp] = useState<ManagementResource>('dataPatterns')
    const [gatewayKeys, setGatewayKeys] = useState<GatewayTab>('serviceKeys')
    const [sheet, setSheet] = useState<Sheet | null>(null)
    const observe = useCallback((operation: string) => client.observeManagement(operation), [client])

    // A contextual action (Inbox, Home) opens the product and tab it names (C30).
    useEffect(() => {
        if (!arrival || !arrival.resource) return
        const resource = arrival.resource
        const runtime = products.find((p) => p.id === 'runtimeSecurity')
        const tab = runtime?.tabs.find((t) => t.resource === resource) ?? (DLP.includes(resource) ? runtime?.tabs.find((t) => t.label === 'DLP') : undefined)
        if (!tab) return
        setOpen((o) => ({ ...o, runtimeSecurity: true }))
        setTabOf((s) => ({ ...s, runtimeSecurity: tab.id }))
        if (DLP.includes(resource)) setDlp(resource)
    }, [arrival, products])

    if (!tenant || !context) {
        return (
            <section aria-labelledby='administration-heading' data-slot='administration-v2'>
                <h1 ref={ref} id='administration-heading' tabIndex={-1} className='font-bold' style={{ fontSize: 'var(--v2-title)' }}>
                    {C.title}
                </h1>
                <p className='mt-2 text-[13px]'>{C.noTenant}</p>
            </section>
        )
    }

    const labelsOf = (tab: AdminTab, kind?: string) =>
        Object.fromEntries(tab.actions.filter((a) => !kind || a.kind === kind).map((a) => [a.action, a.label])) as Partial<Record<ChangeTarget['action'], string>>

    function body(product: AdminProduct, tab: AdminTab) {
        if (tab.disposition.kind === 'unavailable') {
            return (
                <div data-slot='admin-unavailable' className='rounded-[12px] border p-4 text-[13px]' style={{ borderColor: 'var(--v2-rule)' }}>
                    <Verdict tone='info' word={C.unavailableTab} />
                    <p className='mt-2' style={{ color: 'var(--v2-soft)' }}>
                        {tab.disposition.reason}
                    </p>
                </div>
            )
        }
        const key = `${context}-${product.id}-${tab.id}`
        if (product.id === 'runtimeSecurity') {
            if (tab.label === 'Overview')
                return (
                    <RuntimeOverviewTab
                        snapshot={snapshot}
                        onRead={() =>
                            void onAct(SHELL_COPY.readOf(tenant!.label), {
                                kind: 'readTenant',
                                context: context!,
                            })
                        }
                    />
                )
            if (tab.label === 'Playground') return <RuntimeView key={key} snapshot={snapshot} dispatch={dispatch} onNavigate={onNavigate} embedded />
            const resource = (tab.label === 'DLP' ? dlp : tab.resource) as ManagementResource | null
            if (!resource) return null
            return (
                <div className='flex flex-col gap-3'>
                    {tab.label === 'DLP' ? (
                        <div role='radiogroup' aria-label={C.dlpResources} className='flex flex-wrap gap-1' data-slot='dlp-resources'>
                            {DLP.map((r) => (
                                <button
                                    key={r}
                                    type='button'
                                    role='radio'
                                    aria-checked={dlp === r}
                                    onClick={() => setDlp(r)}
                                    className='h-8 rounded-[7px] px-3 text-[13px]'
                                    style={{
                                        background: dlp === r ? 'var(--v2-sel)' : 'transparent',
                                        color: dlp === r ? 'var(--v2-sel-ink)' : 'var(--v2-ink)',
                                    }}
                                >
                                    {DLP_LABEL[r]}
                                </button>
                            ))}
                        </div>
                    ) : null}
                    <AdministrationView
                        key={`${key}-${resource}`}
                        snapshot={snapshot}
                        dispatch={dispatch}
                        observe={observe}
                        onNavigate={onNavigate}
                        arrival={arrival && arrival.resource === resource ? arrival : null}
                        pinned={resource}
                        embedded
                        labels={labelsOf(tab, tab.label === 'DLP' ? DLP_KIND[resource] : undefined)}
                        admitted={tab.actions}
                        onReview={(change) => setSheet({ change, rotation: null })}
                        rotations={snapshot.rotations}
                        onFinishRotation={(application) => setSheet({ change: null, rotation: application })}
                    />
                </div>
            )
        }
        if (product.id === 'gateway') {
            if (tab.label === 'MCP servers') return <McpTab snapshot={snapshot} dispatch={dispatch} />
            const gtab = tab.label === 'Keys' ? gatewayKeys : GATEWAY_TAB[tab.id]
            return (
                <div className='flex flex-col gap-3'>
                    {tab.label === 'Keys' ? (
                        <div role='radiogroup' aria-label={C.keyKinds} className='flex gap-1'>
                            {(['serviceKeys', 'userKeys'] as const).map((k) => (
                                <button
                                    key={k}
                                    type='button'
                                    role='radio'
                                    aria-checked={gatewayKeys === k}
                                    onClick={() => setGatewayKeys(k)}
                                    className='h-8 rounded-[7px] px-3 text-[13px]'
                                    style={{
                                        background: gatewayKeys === k ? 'var(--v2-sel)' : 'transparent',
                                        color: gatewayKeys === k ? 'var(--v2-sel-ink)' : 'var(--v2-ink)',
                                    }}
                                >
                                    {k === 'serviceKeys' ? C.serviceKeys : C.userKeys}
                                </button>
                            ))}
                        </div>
                    ) : null}
                    <GatewayView
                        key={`${context}-gateway`}
                        snapshot={snapshot}
                        dispatch={dispatch}
                        observe={observe}
                        onNavigate={onNavigate}
                        tab={gtab}
                        embedded
                        actions={tab.actions}
                        onReview={(change, extras) => setSheet({ change, rotation: null, ...extras })}
                    />
                </div>
            )
        }
        return (
            <div className='flex flex-col gap-2'>
                <p className='text-[12px]' style={{ color: 'var(--v2-soft)' }}>
                    {C.readOnly}
                </p>
                <RedTeamView
                    key={`${context}-${product.id}`}
                    snapshot={snapshot}
                    dispatch={dispatch}
                    observe={observe}
                    onNavigate={onNavigate}
                    tab={RED_TEAM_TAB(product)}
                    section={SECTION[product.id]?.[tab.id]}
                    embedded
                />
            </div>
        )
    }

    return (
        <section aria-labelledby='administration-heading' data-slot='administration-v2' className='flex min-w-0 flex-col gap-4'>
            <div>
                <h1 ref={ref} id='administration-heading' tabIndex={-1} className='font-bold' style={{ fontSize: 'var(--v2-title)' }}>
                    {C.title}
                </h1>
                <p className='mt-1 text-[13px]' style={{ color: 'var(--v2-soft)' }}>
                    {C.lead(tenant.label)}
                </p>
            </div>
            <ul className='flex flex-col gap-3' data-slot='admin-products'>
                {products.map((product) => {
                    const unavailable = product.availability.state === 'unavailable'
                    const expanded = !!open[product.id] && !unavailable
                    const tabs = product.tabs.filter((t) => t.disposition.kind !== 'removed')
                    const current = tabs.find((t) => t.id === tabOf[product.id]) ?? tabs[0]
                    const panel = `admin-${product.id}`
                    return (
                        <li
                            key={product.id}
                            data-slot='admin-product'
                            data-product={product.id}
                            className='min-w-0 rounded-[12px] border'
                            style={{
                                borderColor: 'var(--v2-rule)',
                                background: 'var(--v2-paper)',
                            }}
                        >
                            <h2 className='m-0'>
                                <button
                                    type='button'
                                    aria-expanded={unavailable ? undefined : expanded}
                                    aria-controls={unavailable ? undefined : panel}
                                    aria-disabled={unavailable || undefined}
                                    onClick={() => !unavailable && setOpen((o) => ({ ...o, [product.id]: !o[product.id] }))}
                                    className='flex w-full flex-wrap items-center gap-3 px-4 py-3 text-left text-[15px] font-semibold'
                                >
                                    <span className='flex-grow'>{product.label}</span>
                                    {unavailable ? (
                                        <Verdict tone='info' word={C.unavailableTab} />
                                    ) : product.readOnly ? (
                                        <span className='text-[12px] font-normal' style={{ color: 'var(--v2-soft)' }}>
                                            Read-only
                                        </span>
                                    ) : null}
                                </button>
                            </h2>
                            {unavailable && product.availability.state === 'unavailable' ? (
                                <p data-slot='admin-product-gate' className='px-4 pb-3 text-[13px]' style={{ color: 'var(--v2-soft)' }}>
                                    {product.availability.reason}
                                </p>
                            ) : null}
                            {expanded && current ? (
                                <div id={panel} className='flex min-w-0 flex-col gap-3 px-4 pb-4'>
                                    <div role='tablist' aria-label={C.tabs(product.label)} className='flex flex-wrap gap-1'>
                                        {tabs.map((t) => (
                                            <button
                                                key={t.id}
                                                type='button'
                                                role='tab'
                                                aria-selected={t.id === current.id}
                                                aria-controls={`${panel}-tab`}
                                                onClick={() => setTabOf((s) => ({ ...s, [product.id]: t.id }))}
                                                className='h-8 rounded-[7px] px-3 text-[13px]'
                                                style={{
                                                    background: t.id === current.id ? 'var(--v2-sel)' : 'transparent',
                                                    color:
                                                        t.id === current.id
                                                            ? 'var(--v2-sel-ink)'
                                                            : t.disposition.kind === 'unavailable'
                                                              ? 'var(--v2-faint)'
                                                              : 'var(--v2-ink)',
                                                }}
                                            >
                                                {t.label}
                                            </button>
                                        ))}
                                    </div>
                                    <div
                                        role='tabpanel'
                                        id={`${panel}-tab`}
                                        aria-label={current.label}
                                        data-slot='admin-tab'
                                        data-tab={current.id}
                                        data-disposition={current.disposition.kind}
                                        className='min-w-0'
                                    >
                                        {body(product, current)}
                                    </div>
                                </div>
                            ) : null}
                        </li>
                    )
                })}
            </ul>
            {/* The sheet is the topmost dialog (I8): rendered at the body, outside the page the modal stack hides. */}
            {sheet
                ? createPortal(
                      <ReviewSheet
                          snapshot={snapshot}
                          context={context}
                          dispatch={dispatch}
                          observe={observe}
                          change={sheet.change}
                          rotation={sheet.rotation}
                          onDraft={sheet.onDraft}
                          note={sheet.note}
                          onClose={() => setSheet(null)}
                      />,
                      document.body
                  )
                : null}
        </section>
    )
})

/** Runtime Overview: what the tenant's read established (C30), never invented figures. */
function RuntimeOverviewTab({ snapshot, onRead }: { snapshot: ShellSnapshot; onRead: () => void }) {
    const read = snapshot.overview.read
    const cell = (label: string, value: string) => (
        <div className='rounded-[10px] border px-3 py-2' style={{ borderColor: 'var(--v2-rule)' }}>
            <p className='text-[12px]' style={{ color: 'var(--v2-soft)' }}>
                {label}
            </p>
            <p className='text-[18px] font-semibold'>{value}</p>
        </div>
    )
    const n = (v: number | null | undefined) => (v === null || v === undefined ? C.overviewRuntime.notRead : v.toLocaleString())
    return (
        <div className='flex flex-col gap-3' data-slot='admin-runtime-overview'>
            <div className='grid gap-3' style={{ gridTemplateColumns: 'repeat(auto-fit, minmax(160px, 1fr))' }}>
                {cell(C.overviewRuntime.sessions, n(read?.summary.sessions))}
                {cell(C.overviewRuntime.violating, n(read?.summary.violating))}
                {cell(C.overviewRuntime.keys, read ? (read.keysFailure ? 'Unavailable' : read.keysComplete ? 'Complete' : 'Partial') : C.overviewRuntime.notRead)}
            </div>
            <div>
                <button type='button' onClick={onRead} className='h-8 rounded-[7px] border px-3 text-[13px]' style={{ borderColor: 'var(--v2-rule)' }}>
                    {C.overviewRuntime.readNow}
                </button>
            </div>
        </div>
    )
}

/** Gateway MCP servers: the chosen workspace's catalog (`GatewayRead::McpServers`, C22). */
function McpTab({ snapshot, dispatch }: { snapshot: ShellSnapshot; dispatch: Dispatch }) {
    const mcp = snapshot.harness.mcp
    const context = snapshot.active?.context ?? null
    const workspace = snapshot.gateway.selected?.reference ?? null
    if (!workspace) return <p className='text-[13px]'>{C.noWorkspace}</p>
    if (!mcp || mcp.servers.length === 0) {
        return (
            <div className='flex flex-col gap-2 text-[13px]'>
                <p>{C.mcpNotRead}</p>
                <div>
                    <button
                        type='button'
                        onClick={() => context && void dispatch({ kind: 'listMcpServers', context, workspace })}
                        className='h-8 rounded-[7px] border px-3 text-[13px]'
                        style={{ borderColor: 'var(--v2-rule)' }}
                    >
                        {C.readMcp}
                    </button>
                </div>
            </div>
        )
    }
    return (
        <table className='w-full text-left text-[13px]' data-slot='admin-mcp'>
            <thead>
                <tr>
                    <th scope='col' className='py-1 pr-3 font-medium'>
                        Server
                    </th>
                    <th scope='col' className='py-1 pr-3 font-medium'>
                        Namespace
                    </th>
                    <th scope='col' className='py-1 font-medium'>
                        Status
                    </th>
                </tr>
            </thead>
            <tbody>
                {mcp.servers.map((s) => (
                    <tr key={s.id}>
                        <td className='py-1 pr-3'>{s.name}</td>
                        <td className='py-1 pr-3 font-mono text-[12px]'>{s.namespace}</td>
                        <td className='py-1'>{s.status}</td>
                    </tr>
                ))}
            </tbody>
        </table>
    )
}

