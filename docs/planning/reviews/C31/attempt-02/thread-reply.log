                    </Button>
                    <Button
                        type='button'
                        tier='secondary'
                        disabled={loading || page.complete || page.nextOffset === null}
                        onClick={() => page.nextOffset !== null && void load(page.nextOffset)}
                    >
                        Next page
                    </Button>
                </div>
            ) : null}

            {detail ? (
                <DetailPanel
                    state={detail}
                    info={info}
                    onClose={() => setDetail(null)}
                    onChange={openChange}
                    label={label}
                    admitted={admitted ? (c) => admitted.findIndex((a) => a.kind === c.kind && a.action === c.action && a.row) : undefined}
                    rotation={(item) => {
                        const id = itemId(info, item)
                        return rotations.find((r) => r.oldKey.id === id && r.stage !== 'complete') ?? null
                    }}
                    onFinishRotation={onFinishRotation}
                />
            ) : null}
            {change && !onReview ? (
                <ChangeWorkbench
                    key={`${change.kind}-${change.action}-${change.target}`}
                    change={change}
                    review={snapshot.changes.review}
                    staged={snapshot.changes.staged}
                    context={context}
                    dispatch={dispatch}
                    onClose={() => setChange(null)}
                />
            ) : null}
            {onReview ? null : <ChangeResults results={snapshot.changes.results.filter((r) => !isGatewayKind(r.kind))} dispatch={dispatch} />}
        </section>
    )
})

