   283	fn topics(response: &ScanResponse) -> TopicVerdict {
   284	    let violation = match &response.prompt_detected {
   285	        Optional::Value(flags) => match &flags.topic_violation {
   286	            Optional::Value(v) => Some(*v),
   287	            _ => None,
   288	        },
   289	        _ => None,
   290	    };
   291	    let names = |value: &Optional<Vec<String>>| -> Vec<String> {
   292	        match value {
   293	            Optional::Value(list) => list.iter().take(32).map(|s| shown(s)).collect(),
   294	            _ => Vec::new(),
   295	        }
   296	    };
   297	    let (blocked, allowed) = match &response.prompt_detection_details {
   298	        Optional::Value(details) => match &details.topic_guardrails_details {
   299	            Optional::Value(t) => (names(&t.blocked_topics), names(&t.allowed_topics)),
   300	            _ => (Vec::new(), Vec::new()),
   301	        },
   302	        _ => (Vec::new(), Vec::new()),
   303	    };
   304	    TopicVerdict {
   305	        violation,
   306	        blocked,
   307	        allowed,
   308	    }
   309	}
