sha=lambda p: hashlib.sha256(open(p,"rb").read()).hexdigest()
names=["rustfmt","clippy","clippy-default","notices","bindings","contracts-typecheck","desktop-typecheck","vitest","vitest-truth","core-lib","core-fixtures","host","xtask-lib","shell-controller","desktop-build"]
rec={"subject":"C31","attempt":attempt,"time":time.strftime("%Y-%m-%dT%H:%M:%S%z"),"cwd":os.getcwd(),
 "toolchain":{"rustc":ver(["rustc","-V"]),"cargo":ver(["cargo","-V"]),"node":ver(["node","-v"]),"pnpm":ver(["pnpm","-v"]),"rustup_active":ver(["rustup","show","active-toolchain"])},
