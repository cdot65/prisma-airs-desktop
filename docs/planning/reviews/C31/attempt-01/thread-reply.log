}

export type GatewayTab = Exclude<GatewayResource, 'workspaces'> | 'workspace' | 'prerequisites' | 'playground' | 'files' | 'usage' | 'logs' | 'limits'
type Tab = GatewayTab

const TABS: readonly [Tab, string][] = [
    ['workspace', 'Workspace'],
    ['providers', 'Providers'],
    ['routes', 'Routes'],
    ['guardrails', 'Guardrails'],
