+        "examples": ["c31 synthetic example"]});
+    let created = ctx
+        .change(
+            desk,
+            Change {
+                spec: spec("C31-topic-create", &["W08"]),
+                kind: "topics",
+                action: "create",
+                target: None,
+                body: topic.clone(),
+                scoped: false,
+                expect: "found",
+                creates: Some("topic"),
+            },
+        )
+        .await?;
+    let revision = created
+        .as_ref()
+        .map(|c| c["revision"].clone())
+        .filter(|r| !r.is_null())
+        .unwrap_or(json!(1));
+    let mut update = topic;
+    update["description"] = json!("C31 review apply, updated through the review");
+    update["revision"] = revision;
+    ctx.change(
+        desk,
+        Change {
+            spec: spec("C31-topic-review-apply", &["W08"]),
+            kind: "topics",
+            action: "update",
+            target: Some("topic"),
+            body: update,
+            scoped: false,
+            expect: "found",
+            creates: None,
+        },
+    )
+    .await?;
+    ctx.cleanup(desk, &[("topic", spec("C31-cleanup-topic", &["W08"]))])
+        .await
+}
