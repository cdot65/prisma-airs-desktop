import { useEffect, useRef, useState } from 'react'
import type { ChangeResultView, ContextRef, ShellSnapshot } from '@prisma-airs/desktop-contracts'
import { type ChangeTarget, ChangeWorkbench, TEMPLATES, pretty, resultText } from '../../features/administration/runtime-changes'
import type { Dispatch } from '../../features/tenants/dispatch'
import { Modal } from '../modal'
import { Verdict } from '../verdict'
import { ADMIN_COPY as C } from './copy'
import { RotationPanel } from './rotation-panel'

export interface ReviewSheetProps {
    snapshot: ShellSnapshot
    context: ContextRef
    dispatch: Dispatch
    /** The change to review first (none when opening a rotation in progress). */
    change: ChangeTarget | null
    /** The application whose rotation this sheet follows (a key version, or "Finish rotation…"). */
    rotation: string | null
    onClose: () => void
}

const matches = (r: ChangeResultView, c: ChangeTarget) => r.kind === c.kind && r.action === c.action && r.target === c.target

/**
 * The review surface (C31, I3, I6, I7): the reviewed change (diff, impact,
 * "Type <name> to confirm" with Apply disabled until it matches; the native
 * confirmation applies), then its applied panel from the core's result, or
 * the staged rotation panel for a Runtime key version. Leaving the sheet by
 * Done, Escape or the scrim forgets a one-time key the core still holds; a
 * tenant switch or context retirement drops it in the core.
 */
export function ReviewSheet({ snapshot, context, dispatch, change: initial, rotation: rotationApp, onClose }: ReviewSheetProps) {
    const [change, setChange] = useState<ChangeTarget | null>(initial)
    const [application, setApplication] = useState<string | null>(rotationApp ?? (initial?.kind === 'apiKeys' && initial.action === 'version' ? applicationOf(initial) : null))
    const [busy, setBusy] = useState(false)
    // Results present when this change was opened are not its outcome.
    const seen = useRef(new Set(snapshot.changes.results.map((r) => r.operation)))
    useEffect(() => {
        seen.current = new Set(snapshot.changes.results.map((r) => r.operation))
        // eslint-disable-next-line react-hooks/exhaustive-deps -- reset per opened change only
    }, [change])
    const result = change ? (snapshot.changes.results.find((r) => matches(r, change) && !seen.current.has(r.operation)) ?? null) : null
    const rotation = application ? (snapshot.rotations.find((r) => r.application === application) ?? null) : null
    // A key change of a rotation is followed by the rotation panel once it settles.
    const rotationStep = !!change && change.kind === 'apiKeys' && (change.action === 'version' || change.action === 'delete') && !!application
    const showWorkbench = !!change && !(result?.settled && rotationStep)

    function close() {
        // I6: a one-time key held for this rotation, or issued by the change
        // applied here, is forgotten on every exit.
        const held = snapshot.changes.results.filter((r) => r.secret === 'held' && (r.operation === rotation?.issuedBy || r.operation === result?.operation))
        for (const r of held) void dispatch({ kind: 'forgetSecret', operation: r.operation })
        if (snapshot.changes.review && change) void dispatch({ kind: 'discardChange', review: snapshot.changes.review.review })
        onClose()
    }

    async function updated() {
        if (!rotation) return
        setBusy(true)
        await dispatch({ kind: 'acknowledgeDeployment', context, application: rotation.application })
        setBusy(false)
        setChange(removeOld(rotation.oldKey.id, rotation.oldKey.name))
    }

    async function reconcile() {
        setBusy(true)
        await dispatch({ kind: 'management', context, request: { kind: 'page', resource: 'apiKeys', offset: 0, limit: 100 } })
        setBusy(false)
    }

    return (
        <Modal label={application ? C.rotation.title(application) : C.reviewTitle} onClose={close} width={760} data-slot='review-sheet'>
            <div className='flex flex-col gap-4'>
                <h2 className='text-[16px] font-semibold'>{application ? C.rotation.title(application) : (change?.title ?? C.reviewTitle)}</h2>
                {rotation ? (
                    <RotationPanel
                        rotation={rotation}
                        busy={busy}
                        onReveal={(operation) => void dispatch({ kind: 'revealSecret', operation })}
                        onFinishLater={close}
                        onUpdated={() => void updated()}
                        onIssueAnother={() => setChange(issueAnother(rotation.oldKey.id, rotation.application))}
                        onRemoveOld={() => setChange(removeOld(rotation.oldKey.id, rotation.oldKey.name))}
                        onReconcile={() => void reconcile()}
                    />
                ) : null}
                {showWorkbench && change ? (
                    <ChangeWorkbench
                        key={`${change.kind}-${change.action}-${change.target}`}
                        change={change}
                        review={snapshot.changes.review}
                        staged={snapshot.changes.staged}
                        context={context}
                        dispatch={dispatch}
                        onClose={close}
                        requireTyped
                    />
                ) : null}
                {result && !rotationStep ? (
                    <Applied result={result} onDone={close} onReconcile={() => void reconcile()} onReveal={() => void dispatch({ kind: 'revealSecret', operation: result.operation })} />
                ) : null}
                {result && rotationStep && !result.settled ? (
                    <p role='status' className='text-[13px]'>
                        {resultText(result)}
                    </p>
                ) : null}
                {result && rotationStep && result.settled && result.outcome !== 'completed' && !rotation ? (
                    <p role='alert' className='text-[13px]' style={{ color: 'var(--v2-block)' }}>
                        {resultText(result)}
                    </p>
                ) : null}
            </div>
        </Modal>
    )
}

/** The applied panel of a non-rotation change: only what the core's readback established. */
function Applied({ result, onDone, onReconcile, onReveal }: { result: ChangeResultView; onDone: () => void; onReconcile: () => void; onReveal: () => void }) {
    if (!result.settled) {
        return (
            <p role='status' className='text-[13px]' data-slot='applied'>
                {resultText(result)}
            </p>
        )
    }
    const live = result.outcome === 'completed' && (result.readback === 'found' || result.readback === 'absent')
    const unknown = result.outcome === 'unknown' || (result.outcome === 'completed' && !live)
    return (
        <section role='status' data-slot='applied' className='flex flex-col gap-2 rounded-[12px] border p-4' style={{ borderColor: 'var(--v2-rule)' }}>
            {live ? (
                <Verdict tone='allowed' word={result.readback === 'absent' ? C.applied.removed : C.applied.live} />
            ) : unknown ? (
                <Verdict tone='flagged' word={C.applied.notConfirmed} />
            ) : (
                <Verdict tone='blocked' word={C.applied.failed} />
            )}
            <p className='text-[13px]'>{resultText(result)}</p>
            {result.secret === 'held' ? (
                <p className='text-[13px]' data-slot='applied-secret'>
                    {C.rotation.issuedNote}
                </p>
            ) : null}
            <div className='flex gap-2'>
                {result.secret === 'held' ? (
                    <button type='button' className='h-8 rounded-[7px] border px-3 text-[13px]' style={{ borderColor: 'var(--v2-rule)' }} onClick={onReveal}>
                        {C.rotation.reveal}
                    </button>
                ) : null}
                {unknown ? (
                    <button type='button' className='h-8 rounded-[7px] border px-3 text-[13px]' style={{ borderColor: 'var(--v2-rule)' }} onClick={onReconcile}>
                        {C.applied.reconcile}
                    </button>
                ) : null}
                <button type='button' className='h-8 rounded-[7px] px-3 text-[13px] font-semibold' style={{ background: 'var(--v2-acc)', color: 'var(--v2-acc-ink)' }} onClick={onDone}>
                    {C.applied.done}
                </button>
            </div>
        </section>
    )
}

function applicationOf(change: ChangeTarget): string | null {
    try {
        const body = JSON.parse(change.body) as { cust_app?: unknown }
        return typeof body.cust_app === 'string' && body.cust_app ? body.cust_app : null
    } catch {
        return null
    }
}

const issueAnother = (oldKey: string, application: string): ChangeTarget => ({
    kind: 'apiKeys',
    action: 'version',
    target: oldKey,
    title: `Issue additional key for ${application}`,
    body: pretty({ ...TEMPLATES.key, cust_app: application }),
})

const removeOld = (oldKey: string, name: string): ChangeTarget => ({ kind: 'apiKeys', action: 'delete', target: oldKey, title: `Remove ${name}`, body: '{}' })
import type { RotationView } from '@prisma-airs/desktop-contracts'
import { clockOf } from '../copy'
import { Verdict } from '../verdict'
import { ADMIN_COPY as C } from './copy'

export interface RotationPanelProps {
    rotation: RotationView
    /** Hands the held one-time key to the host sheet (I6). */
    onReveal: (operation: string) => void
    onFinishLater: () => void
    onUpdated: () => void
    onIssueAnother: () => void
    onRemoveOld: () => void
    onReconcile: () => void
    busy: boolean
}

/**
 * The staged Runtime key rotation (C31, I7; screens/reviews-administration.md
 * stages 1–4): every stage is the core's (`RotationView.stage`). The secret
 * is offered only while the core still holds it for this context; once it is
 * not, the panel says so and offers another issuance. Two timestamps are
 * shown with distinct labels: the operator's own statement and the remote
 * readback.
 */
export function RotationPanel({ rotation: r, onReveal, onFinishLater, onUpdated, onIssueAnother, onRemoveOld, onReconcile, busy }: RotationPanelProps) {
    const btn = 'h-8 rounded-[7px] border px-3 text-[13px] disabled:opacity-60'
    const primary = 'h-8 rounded-[7px] px-3 text-[13px] font-semibold disabled:opacity-60'
    const primaryStyle = { background: 'var(--v2-acc)', color: 'var(--v2-acc-ink)' }
    const rule = { borderColor: 'var(--v2-rule)' }
    return (
        <section aria-label={C.rotation.title(r.application)} data-slot='rotation-panel' data-stage={r.stage} className='flex flex-col gap-3 rounded-[12px] border p-4' style={rule}>
            {r.stage === 'issued' ? (
                <>
                    <Verdict tone='flagged' word={C.rotation.issued} />
                    <p className='text-[13px]'>{C.rotation.issuedNote}</p>
                    <div className='flex flex-wrap gap-2'>
                        <button type='button' className={primary} style={primaryStyle} disabled={busy || !r.issuedBy} onClick={() => r.issuedBy && onReveal(r.issuedBy)}>
                            {C.rotation.reveal}
                        </button>
                        <button type='button' className={btn} style={rule} onClick={onFinishLater}>
                            {C.rotation.finishLater}
                        </button>
                        <button type='button' className={btn} style={rule} disabled={busy} onClick={onUpdated}>
                            {C.rotation.updated}
                        </button>
                    </div>
                </>
            ) : r.stage === 'resumed' ? (
                <>
                    <Verdict tone='flagged' word={C.rotation.resumed} />
                    <p className='text-[13px]'>{C.rotation.resumedNote(r.application)}</p>
                    <div className='flex flex-wrap gap-2'>
                        <button type='button' className={btn} style={rule} disabled={busy} onClick={onIssueAnother}>
                            {C.rotation.issueAnother}
                        </button>
                        <button type='button' className={primary} style={primaryStyle} disabled={busy} onClick={onUpdated}>
                            {C.rotation.updated}
                        </button>
                    </div>
                </>
            ) : r.stage === 'acknowledged' ? (
                <>
                    <Verdict tone='info' word={C.rotation.acknowledged(clockOf(r.deploymentAcknowledgedAt ?? 0))} />
                    <p className='text-[13px]'>{C.rotation.acknowledgedNote}</p>
                    {r.removalRejected ? (
                        <p role='alert' className='text-[13px]' style={{ color: 'var(--v2-block)' }}>
                            {C.rotation.rejected(r.removalRejected)}
                        </p>
                    ) : null}
                    <div>
                        <button type='button' className={primary} style={primaryStyle} disabled={busy} onClick={onRemoveOld}>
                            {C.rotation.removeOld(r.oldKey.name)}
                        </button>
                    </div>
                </>
            ) : r.stage === 'issuanceUnconfirmed' || r.stage === 'removalUnconfirmed' ? (
                <>
                    <Verdict tone='flagged' word={r.stage === 'issuanceUnconfirmed' ? C.rotation.issuanceUnconfirmed : C.rotation.removalUnconfirmed} />
                    <p className='text-[13px]'>{r.stage === 'issuanceUnconfirmed' ? C.rotation.issuanceUnconfirmedNote : C.rotation.removalUnconfirmedNote}</p>
                    <div>
                        <button type='button' className={btn} style={rule} disabled={busy} onClick={onReconcile}>
                            {C.applied.reconcile}
                        </button>
                    </div>
                </>
            ) : (
                <>
                    <Verdict tone='allowed' word={C.rotation.complete(clockOf(r.oldKeyRemovedAt ?? 0))} />
                    <p className='text-[13px]'>{C.rotation.completeNote}</p>
                </>
            )}
            {r.deploymentAcknowledgedAt !== null || r.oldKeyRemovedAt !== null ? (
                <table className='text-[12px]' data-slot='rotation-timestamps'>
                    <caption className='sr-only'>{C.rotation.timestamps}</caption>
                    <tbody>
                        <tr>
                            <th scope='row' className='pr-3 text-left font-medium'>
                                {C.rotation.acknowledgedAt}
                            </th>
                            <td>{r.deploymentAcknowledgedAt !== null ? clockOf(r.deploymentAcknowledgedAt) : '—'}</td>
                        </tr>
                        <tr>
                            <th scope='row' className='pr-3 text-left font-medium'>
                                {C.rotation.removedAt}
                            </th>
                            <td>{r.oldKeyRemovedAt !== null ? clockOf(r.oldKeyRemovedAt) : '—'}</td>
                        </tr>
                    </tbody>
                </table>
            ) : null}
        </section>
    )
}

