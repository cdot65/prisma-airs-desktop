export const Administration = forwardRef<HTMLHeadingElement, AdministrationProps>(function Administration({ snapshot, dispatch, client, onAct, onNavigate, arrival }, ref) {
    const tenant = snapshot.tenants.find((t) => t.id === snapshot.active?.tenant) ?? null
    const context = snapshot.active?.context ?? null
    const products = snapshot.administration?.products ?? []
    const [open, setOpen] = useState<Record<string, boolean>>({ runtimeSecurity: true })
    const [tabOf, setTabOf] = useState<Record<string, string>>({ runtimeSecurity: 'custom-topics', gateway: 'routes', redTeam: 'scans', modelSkill: 'skill-scans' })
    const [dlp, setDlp] = useState<ManagementResource>('dataPatterns')
    const [gatewayKeys, setGatewayKeys] = useState<GatewayTab>('serviceKeys')
