                    const expanded = !!open[product.id] && !unavailable
                    const tabs = product.tabs.filter((t) => t.disposition.kind !== 'removed')
                    const current = tabs.find((t) => t.id === tabOf[product.id]) ?? tabs[0]
                    const panel = `admin-${product.id}`
                    return (
