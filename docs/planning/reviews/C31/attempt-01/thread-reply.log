                    {tab.label === 'Keys' ? (
                        <div role='radiogroup' aria-label={C.keyKinds} className='flex gap-1'>
                            {(['serviceKeys', 'userKeys'] as const).map((k) => (
                                <button key={k} type='button' role='radio' aria-checked={gatewayKeys === k} onClick={() => setGatewayKeys(k)} className='h-8 rounded-[7px] px-3 text-[13px]' style={{ background: gatewayKeys === k ? 'var(--v2-sel)' : 'transparent', color: gatewayKeys === k ? 'var(--v2-sel-ink)' : 'var(--v2-ink)' }}>
                                    {k === 'serviceKeys' ? C.serviceKeys : C.userKeys}
