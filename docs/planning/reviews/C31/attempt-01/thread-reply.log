+                <p className='text-academy-ink-soft text-[12px]'>Not detected: no custom topic assigned to {profile} matched.</p>
+            ) : (
+                <p className='text-academy-ink-soft text-[12px]'>Not reported by the service for this scan.</p>
+            )}
+        </div>
+    )
