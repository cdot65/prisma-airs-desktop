+                    isString(t.label) &&
+                    isRecord(t.disposition) &&
+                    oneOf(TAB_DISPOSITIONS, t.disposition.kind) &&
+                    (t.disposition.kind === 'read' || t.disposition.kind === 'change' || isString(t.disposition.reason)) &&
