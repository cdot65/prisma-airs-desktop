+                    (t.disposition.kind === 'change' || t.actions.length === 0) &&
+                    (!p.readOnly || t.actions.length === 0) &&
+                    Array.isArray(t.denied) &&
+                    t.denied.every((d: unknown) => isPair(d) && isString((d as Record<string, unknown>).reason)) &&
