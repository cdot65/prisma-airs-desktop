tewayResource::ServiceKeys => {\ncrates/desktop-core/src/gateway_changes.rs:572:        GatewayResource::UserKeys => json(&gw.api_keys().list_user(&scoped()?, options).await?)?,\ncrates/desktop-core/src/gateway_changes.rs:603:        GatewayResource::ServiceKeys => json(&gw.api_keys().get_service(id, options).await?),\ncrates/desktop-core/src/gateway_changes.rs:604:        GatewayResource::UserKeys => json(&gw.api_keys().get_user(id, options).await?),\ncrates/desktop-core/src/gateway_changes.rs:688:        R::ServiceKeys | R::UserKeys => {}\ntype DetailState = { kind: 'loading'; id: string; name: string } | { kind: 'failed'; id: string; name: string; message: string } | { kind: 'shown'; id: string; name: string; detail: GatewayDetail }\ntype StartChange = (action: ChangeAction, target: string, name: string, body?: Record<string, unknown>) => void\n\nfunction InventoryPanel({ resource, held, onRefresh, read, onChange, actions }: { resource: GatewayResource; held: Held<GatewayList>; onRefresh: () => void; read: (r: GatewayRead, scoped: boolean) => Promise<ManagementResult | string>; onChange: StartChange; actions: AdminAction[] }) {\n    const create = actions.find((a) => a.kind === KIND[resource] && a.action === 'create' && !a.row)?.label\n    const what = LABEL[resource]\n    const [detail, setDetail] = useState<DetailState | null>(null)\n    const [filter, setFilter] = useState('')\n    const token = useRef(0)\n    const list = held.read\n    const needle = filter.trim().toLowerCase()\n    const rows = (list ? rowsOf(list) : []).filter((row) => needle.length === 0 || nameOf(row).toLowerCase().includes(needle) || String(row.id).toLowerCase().includes(needle))\n    async function open(row: Record<string, unknown>) {\n        const name = nameOf(row)\n        const id = String(row.id)\n        const mine = ++token.current\n        setDetail({ kind: 'loading', id, name })\n        const result = await read({ kind: 'detail', resource, id }, resource !== 'integrations')\n        if (mine !== token.current) return\n        const g = gatewayResult(result)\n        setDetail(g?.kind === 'detail' ? { kind: 'shown', id, name, detail: g.detail } : { kind: 'failed', id, name, message: resultFailure(result) })\n    }\n    function close() {\n        token.current += 1\n        setDetail(null)\n    }\n    return (\n        <div className='flex min-w-0 flex-col' style={{ gap: 14 }} data-slot='gateway-inventory'>\n            <div className='flex flex-wrap items-center' style={{ gap: 10 }}>\n                <label className='flex items-center rounded-[7px] text-[12px]' style={{ gap: 7, width: 280, maxWidth: '100%', height: 32, padding: '0 9px', background: 'var(--v2-inset)', color: 'var(--v2-faint)' }}>\n                    <Glyph name='search' size={12} />\n                    <input aria-label={C.table.search(what)} placeholder={C.table.search(what)} value={filter} onChange={(e) => setFilter(e.target.value)} autoComplete='off' spellCheck={false} className='min-h-0 min-w-0 flex-grow border-0 bg-transparent p-0 text-[13px]' style={{ border: 0, minHeight: 0, borderRadius: 0, background: 'transparent', color: 'var(--v2-ink)', height: 24 }} />\n                </label>\n                <Btn tier='tertiary' aria-disabled={held.loading} onClick={() => !held.loading && onRefresh()}>\n                    {`Refresh ${what}`}\n                </Btn>\n                {create ? (\n                    <Btn tier='primary' className='ml-auto' onClick={() => onChange('create', '', '')}>\n                        {create}\n                    </Btn>\n                ) : null}\n    shownId.current = state.id\n    useEffect(() => () => void (shownId.current = null), [])\n    useEffect(() => {\n        heading.current?.focus()\n    }, [state.kind])\n    const item: Record<string, unknown> | null = state.kind === 'shown' && state.detail.item ? (JSON.parse(state.detail.item) as Record<string, unknown>) : null\n    async function readModels(id: string) {\n        setModels((h) => ({ ...h, loading: true }))\n        const result = await read({ kind: 'integrationModels', id }, false)\n        if (shownId.current !== id) return\n        const g = gatewayResult(result)\n        setModels((h) => (g?.kind === 'models' && g.models.integration === id ? { read: g.models, loading: false, failure: null } : { ...h, loading: false, failure: resultFailure(result) }))\n    }\n    return (\n        <section aria-labelledby={headingId} data-slot='gateway-detail' className='flex flex-col rounded-[12px] border' style={{ gap: 12, padding: 18, ...cardStyle, background: 'var(--v2-paper)' }}>\n            <h2 id={headingId} ref={heading} tabIndex={-1} className='text-[15px] font-semibold outline-none'>\n                {state.name}\n            </h2>\n            {state.kind === 'loading' ? (\n                <p role='status' className='text-[13px]' style={soft}>\n                    Reading details…\n                </p>\n            ) : state.kind === 'failed' ? (\n                <p role='alert' className='text-[13px]' style={{ color: 'var(--v2-flag)' }}>\n                    {state.message}\n                </p>\n            ) : state.detail.found === 'absent' ? (\n                <p className='text-[13px]' data-slot='gateway-detail-absent'>\n                    The workspace’s complete inventory does not contain this item, so it is not shown.\n                </p>\n            ) : state.detail.found === 'incomplete' ? (\n                <p className='text-[13px]' data-slot='gateway-detail-incomplete'>\n                    This item was not in the part of the workspace’s inventory that could be read. It is not shown, and this does not mean it is absent.\n                </p>\n            ) : (\n                <>\n                    {item?.credential_bearing === true ? (\n                        <p className='rounded-[8px] text-[12px]' style={{ padding: '10px 12px', background: 'var(--v2-inset)', ...soft }} data-slot='gateway-credential-bearing'>\n                            This configuration carries credentials. Their values are not shown.\n                        </p>\n                    ) : null}\n                    <dl className='grid grid-cols-[minmax(8rem,auto)_1fr] gap-x-4 gap-y-1 text-[13px]' data-slot='gateway-detail-fields'>\n                        {Object.entries(item ?? {})\n                            .filter(([key]) => key !== 'credential_bearing')\n                            .map(([key, value]) => (\n                                <div key={key} className='contents'>\n                                    <dt className='font-mono text-[12px] break-all' style={soft}>\n                                        {key}\n    60\t\n    61\tdef gated_product(tree, product, gate):\n    62\t    nodes = product_nodes(tree, product)\n    63\t    header = product_header(tree, product)\n    64\t    words = \" \".join(str(n.get(\"label\") or n.get(\"value\") or \"\") for n in nodes)\n    65\t    controls = [n for n in nodes if n.get(\"role\") in\n    66\t                (\"AXButton\", \"AXRadioButton\", \"AXTab\", \"AXTextField\", \"AXTextArea\", \"AXCheckBox\", \"AXTable\")]\n    67\t    return bool(nodes and header and gate in words and len(controls) == 1 and controls[0] is header)\n    68\t\n    69\t\n    70\tdef gateway_key_state(tree, kind, require_detail=False):\n    71\t    nodes = product_nodes(tree, \"AI Gateway\")\n    72\t    detail = detail_nodes(tree, \"AI Gateway\")\n    73\t    tabs = [n.get(\"label\") for n in nodes if n.get(\"role\") in (\"AXRadioButton\", \"AXTab\")]\n    74\t    forbidden = sorted({n.get(\"label\") for n in nodes\n    75\t                        if n.get(\"role\") in (\"AXButton\", \"AXMenuItem\", \"AXLink\")\n    76\t                        and (n.get(\"label\") or \"\").startswith((\"Issue additional key\", \"Finish rotation\"))})\n    77\t    value = {\"card_present\": bool(nodes), \"kind\": kind,\n    78\t             \"table\": any(n.get(\"role\") == \"AXTable\" and n.get(\"label\") == kind for n in nodes),\n    79\t             \"gateway_tabs\": tabs, \"no_limits\": \"Keys\" in tabs and \"Limits\" not in tabs,\n    80\t             \"forbidden_actions\": forbidden, \"detail_open\": bool(detail),\n    81\t             \"detail_actions\": [n.get(\"label\") for n in detail if n.get(\"role\") == \"AXButton\"]}\n    82\t    value[\"ok\"] = bool(nodes and value[\"table\"] and value[\"no_limits\"] and not forbidden\n    83\t                       and (not require_detail or detail))\n    84\t    return value\n    85\t\n    86\t\n    87\tdef gateway_keys_complete(value):\n    88\t    kinds = value.get(\"kinds\", {})\n    89\t    if set(kinds) != {\"Service keys\", \"User keys\"}:\n    90\t        return False\n    91\t    if not kinds[\"Service keys\"].get(\"details\"):\n    92\t        return False\n    93\t    for kind, observed in kinds.items():\n    94\t        state = observed.get(\"list\", {})\n    95\t        details = observed.get(\"details\", [])\n    96\t        expected = observed.get(\"row_labels\")\n    97\t        def complete(row, require_detail):\n    98\t            tabs = row.get(\"gateway_tabs\")\n    99\t            return (row.get(\"kind\") == kind and row.get(\"ok\") is True\n   100\t                    and row.get(\"card_present\") is True and row.get(\"table\") is True\n   101\t                    and row.get(\"no_limits\") is True and row.get(\"forbidden_actions\") == []\n   102\t                    and isinstance(tabs, list) and \"Keys\" in tabs and \"Limits\" not in tabs\n   103\t                    and isinstance(row.get(\"detail_actions\"), list)\n   104\t                    and row.get(\"detail_open\") is require_detail\n   105\t                    and (not require_detail or \"Close details\" in row[\"detail_actions\"]))\n   106\t        if (not complete(state, False) or not isinstance(expected, list)\n   107\t                or len(set(expected)) != len(expected) or len(details) != len(expected)):\n   108\t            return False\n   109\t        if any(row.get(\"row\") != label or not complete(row, True)\n   110\t               for row, label in zip(details, expected)):\n   111\t            return False\n   112\t    return True\n   124\t            raise ValueError(\"Gateway Keys workspace did not settle\")\n   125\t    result = {\"kinds\": {}}\n   126\t    for kind in (\"Service keys\", \"User keys\"):\n   127\t        tree, ready = app.wait_for(lambda t: any(n.get(\"role\") in (\"AXRadioButton\", \"AXTab\")\n   128\t                                   and n.get(\"label\") == kind\n   129\t                                   for n in coverage.product_nodes(t, \"AI Gateway\")), 20)\n   130\t        if not ready:\n   131\t            raise ValueError(\"Gateway key-kind control did not settle: \" + kind)\n   132\t        nodes = coverage.product_nodes(tree, \"AI Gateway\")\n   133\t        choice = next((n for n in nodes if n.get(\"role\") in (\"AXRadioButton\", \"AXTab\")\n   134\t                       and n.get(\"label\") == kind), None)\n   135\t        coverage.act_on_node(app, tree, choice)\n   136\t        tree, _ = app.wait_for(lambda t: coverage.gateway_key_state(t, kind)[\"table\"], 20)\n   137\t        state = coverage.gateway_key_state(tree, kind)\n   138\t        slug = kind.lower().replace(\" \", \"-\")\n   139\t        state.update(tree=c29.save_tree(\"gateway-\" + slug, tree),\n   140\t                     capture=c29.capture(app, \"gateway-\" + slug))\n   141\t        rows = sorted({n[\"label\"] for n in coverage.product_nodes(tree, \"AI Gateway\")\n   142\t                       if n.get(\"role\") == \"AXButton\" and (n.get(\"label\") or \"\").startswith(\"Details for \")})\n   143\t        observed = {\"list\": state, \"row_labels\": rows, \"details\": []}\n   144\t        for index, label in enumerate(rows):\n   145\t            tree = app.tree()\n   146\t            node = next((n for n in coverage.product_nodes(tree, \"AI Gateway\")\n   147\t                         if n.get(\"role\") == \"AXButton\" and n.get(\"label\") == label), None)\n   148\t            coverage.act_on_node(app, tree, node)\n   149\t            tree, _ = app.wait_for(lambda t: bool(coverage.detail_nodes(t, \"AI Gateway\")), 12)\n   150\t            detail = coverage.gateway_key_state(tree, kind, require_detail=True)\n   151\t            detail.update(row=label, tree=c29.save_tree(f\"gateway-{slug}-detail-{index}\", tree),\n   152\t                          capture=c29.capture(app, f\"gateway-{slug}-detail-{index}\"))\n   153\t            observed[\"details\"].append(detail)\n   154\t            close = coverage.button(coverage.detail_nodes(tree, \"AI Gateway\"), \"Close details\")\n   155\t            coverage.act_on_node(app, tree, close)\n   156\t            app.wait_for(lambda t: not coverage.detail_nodes(t, \"AI Gateway\"), 8)\n   157\t        result[\"kinds\"][kind] = observed\n   158\t    return result\n   159\t\n   160\t\n   161\tdef gateway_key_evidence(value):\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_50","type":"command_execution","command":"/bin/zsh -lc \"sed -n '1,75p' tools/native-acceptance/mgmt_server.py; rg -n 'team-a-key|service_keys|service-keys|user_keys|user-keys|api-keys|api_keys' tools/native-acceptance/*server*.py | head -110; sed -n '700,805p' crates/desktop-core/src/gateway.rs; sed -n '1,120p' tools/p09/phase_packet_c31_transition.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_50","type":"command_execution","command":"/bin/zsh -lc \"sed -n '1,75p' tools/native-acceptance/mgmt_server.py; rg -n 'team-a-key|service_keys|service-keys|user_keys|user-keys|api-keys|api_keys' tools/native-acceptance/*server*.py | head -110; sed -n '700,805p' crates/desktop-core/src/gateway.rs; sed -n '1,120p' tools/p09/phase_packet_c31_transition.py\"","aggregated_output":"#!/usr/bin/env python3\n\"\"\"Synthetic Prisma AIRS management endpoint for C08 native acceptance. It\nserves HTTPS on localhost with the scan endpoint's disposable test CA\n(scan_server.py --make-certs), issues synthetic OAuth tokens at\n/oauth2/access_token, answers the AIRS management and DLP reads the desktop\nmakes under /aisec and /dlp according to a mode file read on every request,\nand appends one JSON line per request. It never contacts the network and\nonly ever sees synthetic credentials; secrets are compared, never logged.\n\n  mgmt_server.py --certs <dir with leaf.pem/leaf.key> --dir <scratch> --port <port>\n                 --client-id <synthetic id> --secret <synthetic secret> --tsg <digits>\n\nFiles in <scratch>: mode.json ({\"grant\": \"ok\"|\"deny\", \"profiles\": \"ok\"|\"deny\",\n\"topics\": \"ok\"|\"deny\"|\"empty\", \"profileCount\": n, \"delayMs\": {\"<path prefix>\": ms},\n\"topicDescription\": text (changes the stored topic, as another writer would)})\nand requests.jsonl.\n\nSessions reads (C11) serve a generated inventory of mode \"sessionCount\"\nsessions (default 60; every mode \"detectorEvery\"-th, default 7, reports\nprompt_injection), their sessions, transactions and scan content. Content\nreads are logged by scan ID only, never their text.\n\nHome/Inbox reads (C12): the sessions chart (mode \"chartStatus\", default\n200; two hourly buckets, one violating) and the API key inventory (mode\n\"keyExpiresInDays\" moves key-1's expiration). The public example catalog\nsnapshot is served at /cdot65/prisma-airs-test-cases/main/catalog.json\n(mode \"catalog\": \"ok\", \"bad\" or \"missing\"); it needs no credential.\n\nWrites (C09) change an in-memory inventory: topics create/update/delete,\nAPI key create/regenerate/delete (a one-time api_key in the reply). The log\nrecords each write's body field names, its authorship and auth-code match,\nand only a SHA-256 of any issued one-time key.\n\nGateway writes (C17) change an overlay the Gateway reads consult: provider\nrenames and deletes, created service keys (a one-time key in the reply,\nlogged only as a SHA-256), created IAM scopes and their bindings, and\nprovisioned workspaces. Modes gwLose (\"METHOD path\": apply, then close\nwithout a reply) and gwHang (\"METHOD path\": never reply) make a step's\noutcome unknown.\n\nGateway observation and inference (C18): the data plane answers usage\ncharts (requests, cost, tokens, latency: mode \"gwChartPoints\" hourly\npoints, default 24), the model groups (mode \"gwModelRows\", default 3),\nrequest logs (25 a page; a trace or status filter is honoured) and the\nusage- and rate-limit policies of a workspace (mode \"gwTelemetry\":\n\"ok\" or \"fail\" makes the cost chart answer 500). The runtime endpoint\nPOST /rt/v1/chat/completions streams a chat completion as server-sent\nevents according to mode \"chat\": \"text\" (two deltas), \"bulk\" (64 KiB in\n2,048 chunks of 32 bytes), \"paced\" (one 32-byte chunk every 10 ms, 2,048\ntimes), \"hang\" (one chunk, then nothing until the client goes away) or\n\"status:<code>\". POST /rt/v1/responses streams a Responses run (created, two text deltas,\ncompleted; mode \"responses\": \"incomplete\" ends it with response.incomplete\nfor max_output_tokens after one delta, \"failed\" with response.failed; the\nsame \"status:<code>\" refusals).\nThe log records the run's headers by name, the inference key only as a\nSHA-256, the trace and route, the body's field names and model and an\nattached input_file's ID, never the prompt. A Responses request from the\nnative Harness engine (C19: it carries instructions, tools and the\nx-codex-turn-metadata header) is answered as the engine expects (created,\noutput_item.added, text deltas \"Answer <n>: Hello from the synthetic\nGateway.\", output_item.done, completed with usage;\nmode \"harness\": \"short\", the default, \"paced\", one 32-byte delta every\n50 ms for about 20 s, until the client goes away, or \"kib\", a 1 KiB answer\nat full speed). C21: mode \"harnessTool\" ({namespace, name, arguments})\nmakes it ask for that tool call instead, until the request carries the\ncall's output (logged as \"toolOutput\": size, SHA-256, whether it carries\nthe management secret, and which \"toolMarkers\" it names); its log row says\n\"harness\": true and records the engine's sandbox mode from its turn\nmetadata. /rt/v1/files lists, uploads\n(multipart) and deletes the workspace's files (mode \"files\": \"ok\",\n\"status:<code>\" or \"lost\"); the log records an upload's file name, purpose,\nsize and SHA-256, never its content.\n\nWorkspace MCP (C22): GET /ai_gw/v2/mcp-servers lists Team A's two servers\n(Tools, Docs; mode \"mcpCatalog\": \"down\" answers 500, \"mcpUpdated\" changes\ntools/native-acceptance/mgmt_server.py:305:            return 200, {\"api_keys\": keys}\ntools/native-acceptance/mgmt_server.py:539:        if rest == \"/api-keys/service\":\ntools/native-acceptance/mgmt_server.py:541:                                + [k for k in created[\"api-keys/service\"] if k[\"workspace_id\"] == ws])\ntools/native-acceptance/mgmt_server.py:542:        for k in created[\"api-keys/service\"]:\ntools/native-acceptance/mgmt_server.py:543:            if rest == f\"/api-keys/service/{k['id']}\":\ntools/native-acceptance/mgmt_server.py:545:        if rest == \"/api-keys/user\":\ntools/native-acceptance/mgmt_server.py:773:            elif method == \"POST\" and path == \"/ai_gw/v2/api-keys/service\":\ntools/native-acceptance/mgmt_server.py:777:                gw[\"created\"][\"api-keys/service\"].append({\"id\": kid, \"name\": body.get(\"name\"), \"object\": \"api-key\",\ntools/native-acceptance/mgmt_server.py:1477:        self.gw = {\"renamed\": {}, \"deleted\": set(), \"created\": {\"api-keys/service\": []}, \"scopes\": {},\n    let resources = scope.get(\"resources\")?.as_array()?;\n    Some(\n        !slug.is_empty()\n            && resources.iter().any(|r| {\n                r.get(\"resource_type\").and_then(Value::as_str) == Some(\"workspace\")\n                    && r.get(\"resource_id\").and_then(Value::as_str) == Some(slug)\n            }),\n    )\n}\n\n/// Service keys among `list` whose scopes allow inference.\npub fn inference_keys(list: &GatewayList) -> u32 {\n    let rows: Vec<Value> = serde_json::from_str(&list.rows).unwrap_or_default();\n    let n = rows\n        .iter()\n        .filter(|r| {\n            r.get(\"scopes\")\n                .and_then(Value::as_array)\n                .is_some_and(|s| s.iter().any(|s| s.as_str() == Some(INFERENCE_SCOPE)))\n        })\n        .count();\n    u32::try_from(n).unwrap_or(u32::MAX)\n}\n\n// ---- Reads ----\n\nfn json<T: Serialize>(reply: &T) -> Result<Value, PageError> {\n    serde_json::to_value(reply).map_err(|_| PageError::Invalid)\n}\n\nfn scoped_query(\n    scope: Option<&WorkspaceScope>,\n) -> Result<AIGatewayWorkspaceScopedListOptions, PageError> {\n    scope\n        .map(|s| AIGatewayWorkspaceScopedListOptions::new(s.id.clone()))\n        .ok_or(PageError::Invalid)\n}\n\n/// One inventory reply as JSON.\nasync fn inventory(\n    gw: &AIGatewayClient,\n    resource: GatewayResource,\n    scope: Option<&WorkspaceScope>,\n    options: Option<&RequestOptions>,\n) -> Result<Value, PageError> {\n    match resource {\n        GatewayResource::Workspaces => json(\n            &gw.workspaces()\n                .list(&AIGatewayWorkspaceListOptions::default(), options)\n                .await?,\n        ),\n        GatewayResource::Integrations => json(&gw.integrations().list(options).await?),\n        GatewayResource::Providers => {\n            json(&gw.providers().list(&scoped_query(scope)?, options).await?)\n        }\n        GatewayResource::Routes => json(&gw.configs().list(&scoped_query(scope)?, options).await?),\n        GatewayResource::Guardrails => {\n            json(&gw.guardrails().list(&scoped_query(scope)?, options).await?)\n        }\n        GatewayResource::ServiceKeys => json(\n            &gw.api_keys()\n                .list_service(&scoped_query(scope)?, options)\n                .await?,\n        ),\n        GatewayResource::UserKeys => json(\n            &gw.api_keys()\n                .list_user(&scoped_query(scope)?, options)\n                .await?,\n        ),\n    }\n}\n\nasync fn item(\n    gw: &AIGatewayClient,\n    resource: GatewayResource,\n    id: &str,\n    options: Option<&RequestOptions>,\n) -> Result<Value, PageError> {\n    match resource {\n        GatewayResource::Workspaces => json(\n            &gw.workspaces()\n                .get(id, &AIGatewayWorkspaceGetOptions::default(), options)\n                .await?,\n        ),\n        GatewayResource::Integrations => json(&gw.integrations().get(id, options).await?),\n        GatewayResource::Providers => json(&gw.providers().get(id, options).await?),\n        GatewayResource::Routes => json(&gw.configs().get(id, options).await?),\n        GatewayResource::Guardrails => json(&gw.guardrails().get(id, options).await?),\n        GatewayResource::ServiceKeys => json(&gw.api_keys().get_service(id, options).await?),\n        GatewayResource::UserKeys => json(&gw.api_keys().get_user(id, options).await?),\n    }\n}\n\nasync fn read_list(\n    gw: &AIGatewayClient,\n    resource: GatewayResource,\n    scope: Option<&WorkspaceScope>,\n    options: Option<&RequestOptions>,\n) -> Result<GatewayList, PageError> {\n    let reply = inventory(gw, resource, scope, options).await?;\n    list(resource, &reply, scope.map(|s| s.id.as_str())).ok_or(PageError::Invalid)\n}\n\n/// One item: its reply must carry the requested ID; a workspace item must\n/// name the selected workspace, or (when it names none) appear in that\n/// workspace's inventory. Absence is claimed only from a complete one.\n\"\"\"Explicit C30 owner-closure P09 packet/audit variant.\n\nThe original phase_packet.py is unchanged; this named entrypoint uses the\nstrict owner-closure member verifier and discloses the exact exception.\nIndependent actual all-9 phase review remains mandatory.\n\"\"\"\nfrom pathlib import Path\nimport argparse\nimport hashlib\nimport json\nimport os\nimport stat\nimport subprocess\nimport time\n\nimport phase_inputs_c31_transition as inputs\nfrom c31_transition_policy import OWNER_SCORE\n\nPREVIOUS_PHASE = '6a7253c2'\n\n\ndef digest(value):\n    return hashlib.sha256((json.dumps(value, sort_keys=True, separators=(',', ':')) + '\\n').encode()).hexdigest()\n\n\ndef file_identity(path):\n    metadata = path.lstat()\n    value = {'mode': stat.S_IMODE(metadata.st_mode)}\n    if path.is_symlink():\n        value.update(kind='symlink', target=os.readlink(path))\n    else:\n        inputs.require(path.is_file(), 'unsupported source kind: ' + str(path))\n        value.update(kind='file', sha256=inputs.sha(path))\n    return value\n\n\ndef source_inventory(root):\n    names = subprocess.check_output(['git', 'ls-files', '-z', '--cached', '--others', '--exclude-standard'], cwd=root).decode().split('\\0')\n    excluded = ('docs/planning/evidence/', 'docs/planning/reviews/')\n    def active_tool(name):\n        return ((name.startswith('docs/planning/evidence/P09/native-controller/') and name.endswith('.py'))\n                or name in ['docs/planning/evidence/P09/runs/hash-inputs.sh', 'docs/planning/evidence/P09/runs/run-checks.sh'])\n    return {name: file_identity(root / name) for name in sorted(set(names))\n            if name and name != 'docs/planning/status.md' and (not name.startswith(excluded) or active_tool(name))\n            and ((root / name).exists() or (root / name).is_symlink())}\n\n\ndef live_evidence(root):\n    path = root / 'docs/planning/evidence/C29/live/L19-verify.json'\n    live = inputs.read(path)\n    inputs.require(live['status'] == 'pass' and live['temporary_local_credentials_removed'], 'L19 pass/cleanup missing')\n    inputs.require(live['budget']['total_reserved'] == 3 and live['budget']['refunded'] == 0, 'L19 charged budget changed')\n    receipt = root / live['native_receipt']\n    inputs.require(inputs.sha(receipt) == live['native_receipt_sha256'], 'L19 receipt hash mismatch')\n    raw = inputs.read(receipt)\n    inputs.require(raw['status'] == 'pass' and raw['local_credentials_removed'], 'L19 actual receipt not passing/cleaned')\n    archived = root / 'docs/planning/evidence/C29/live/L19/build-02/l19-qualification-executable.bin'\n    inputs.require(inputs.sha(archived) == raw['executable_sha256'], 'L19 historical executable mismatch')\n    return {'record': str(path.relative_to(root)), 'sha256': inputs.sha(path),\n            'native_receipt': str(receipt.relative_to(root)), 'native_receipt_sha256': inputs.sha(receipt),\n            'qualification_executable': str(archived.relative_to(root)), 'qualification_executable_sha256': inputs.sha(archived),\n            'live_calls_performed_by_this_verifier': 0, 'remaining_live_allowance': 0}\n\n\ndef evidence_inventory(root, run_path, verified):\n    files = set()\n    phase = root / 'docs/planning/evidence/P09'\n    prefixes = [phase / 'native', phase / 'parity', phase / 'screens', phase / 'preparations', phase / 'check-remediation', phase / 'performance', phase / 'phase-tooling-history', phase / 'phase-tooling-validation', run_path.parent / inputs.read(run_path)['attempt'],\n                root / 'docs/planning/evidence/C29/live/L19']\n    prefixes += list((phase / 'native-history').glob('*Worf*'))\n    for prefix in prefixes:\n        files.update(p for p in prefix.rglob('*') if p.is_file() and '__pycache__' not in p.parts)\n    files.update(phase / name for name in ['native-prepare.json', 'native-acceptance.json', 'execution.json'])\n    files.add(phase / 'native-build-inputs.json')\n    files.add(phase / 'workload-perf-C30.json')\n    files.add(run_path)\n    files.update(p for p in (phase / 'c31-transition-20261102').rglob('*') if p.is_file())\n    files.add(root / 'docs/planning/evidence/C29/live/L19-verify.json')\n    files.add(root / 'docs/planning/reviews/C44/legacy-retirements.md')\n    for member in verified['predecessors']:\n        for key in ['record', 'request', 'receipt', 'audit', 'owner_decision']:\n            if key in member:\n                files.add(root / member[key])\n        if 'record' in member:\n            directory = (root / member['record']).parent\n            for name in ['source-inventory.json', 'diff.patch', 'thread-reply.log']:\n                if (directory / name).is_file():\n                    files.add(directory / name)\n    return {str(p.relative_to(root)): file_identity(p) for p in sorted(files)}\n\n\ndef make(root, attempt, run_path, limitations):\n    inputs.require(attempt.startswith('attempt-') and attempt[8:].isdigit(), 'invalid phase attempt ID')\n    out = root / 'docs/planning/reviews/P09' / attempt\n    inputs.require(not out.exists(), 'preserve existing phase attempt; choose a fresh ID')\n    # No output folder is created until every current gate passes.\n    verified = inputs.verify(root, run_path)\n    live = live_evidence(root)\n    source = source_inventory(root)\n    evidence = evidence_inventory(root, run_path, verified)\n    run = inputs.read(run_path)\n    fingerprints = {'source': digest(source), 'dependencies': run['inputs']['before_digest'],\n                    'build_flags': run['build_flags']['digest'], 'evidence': digest(evidence)}\n    instructions = (root / 'docs/planning/prompts/review-phase.md').read_text().split('```text')[1].split('```')[0]\n    instructions = instructions.replace('PHASE_ID', 'P09').replace('CHUNK_LIST', ', '.join(inputs.MEMBERS)).strip()\n    request_id = 'P09-' + attempt + '-' + str(int(time.time()))\n    request = {'request_id': request_id, 'attempt_id': attempt, 'subject': 'P09', 'kind': 'phase',\n               'base_commit': subprocess.check_output(['git', 'rev-parse', 'HEAD'], cwd=root, text=True).strip(),\n               'transport': 'fresh in-process read-only Codex exec fallback; C26 controller remains open',\n               'scope': {'phase': 'P09 current integrated presentation, D058/D059; C34 superseded by C44',\n                         'files': sorted(source), 'measured_from': PREVIOUS_PHASE,\n                         'source_exclusions': ['docs/planning/evidence/**', 'docs/planning/reviews/**', 'docs/planning/status.md'],\n                         'exclusion_reason': 'Evidence and predecessor records bound separately; active native-controller Python and check-run shell sources are included despite their evidence directory. Current attempt outputs excluded from both inventories.'},\n               'fingerprints': fingerprints, 'predecessors': verified['predecessors'],\n               'source_transition': verified['native_acceptance']['source_transition'],\n               'owner_c30_score_record': OWNER_SCORE, 'owner_c30_score_record_sha256': inputs.sha(root / OWNER_SCORE),\n               'commands': [{'record': str(run_path.relative_to(root)), **run}],\n               'native_acceptance': verified['native_acceptance'], 'live_evidence': live,\n               'limitations': [\n                   'C26 remains open. This is the owner-approved fresh-exec fallback, not fabricated controller completion.',\n","exit_code":0,"status":"completed"}}
