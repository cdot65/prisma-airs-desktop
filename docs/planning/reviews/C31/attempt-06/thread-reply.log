  return observed\n   515\t        if rest == \"/workspaces\":\n   516\t            return 200, listing([workspace(w) for w in listed] + created_ws)\n   517\t        if rest.startswith(\"/workspaces/\"):\n   518\t            wid = rest[len(\"/workspaces/\"):]\n   519\t            base = workspace(wid) if wid in spaces else next((w for w in created_ws if w[\"id\"] == wid), None)\n   520\t            if base is None:\n   521\t                return 404, {\"error\": \"not found\"}\n   522\t            return 200, {**base, \"defaults\": {\"config_id\": route(GW_A)[\"id\"], \"allow_config_override\": True},\n   523\t                         \"usage_limits\": [{\"credit_limit\": 500, \"type\": \"cost\", \"current_usage\": 12}],\n   524\t                         \"rate_limits\": [{\"type\": \"requests\", \"unit\": \"rpm\", \"value\": 60}]}\n   525\t        if ws is not None and ws not in spaces:\n   526\t            return 200, listing([])\n   527\t\n   528\t        def shown(p):\n   529\t            return {**p, \"name\": renamed.get(p[\"id\"], p[\"name\"])}\n   530\t        if rest == \"/providers\":\n   531\t            # Team B's providers are a partial page: 1 of 5, more follow.\n   532\t            if ws == GW_A:\n   533\t                return 200, listing([shown(p) for p in (provider(ws, 1), provider(ws, 2)) if p[\"id\"] not in deleted])\n   534\t            return 200, listing([provider(ws, 1)], 5, True)\n   535\t        if rest == \"/configs\":\n   536\t            return 200, listing([route(ws)])\n   537\t        if rest == \"/guardrails\":\n   538\t            return 200, listing([guardrail(ws)])\n   539\t        if rest == \"/api-keys/service\":\n   540\t            return 200, listing([key(ws, 1, [\"completions.write\"]), key(ws, 2, [\"models.read\"])]\n   541\t                                + [k for k in created[\"api-keys/service\"] if k[\"workspace_id\"] == ws])\n   542\t        for k in created[\"api-keys/service\"]:\n   543\t            if rest == f\"/api-keys/service/{k['id']}\":\n   544\t                return 200, k\n   545\t        if rest == \"/api-keys/user\":\n   546\t            return 200, listing([key(ws, 3, [\"completions.write\"])])\n   547\t        for w in spaces:\n   548\t            r = route(w)\n   549\t            if rest == f\"/configs/{r['id']}\":\n   550\t                return 200, {**r, \"config\": json.dumps({\"strategy\": {\"mode\": \"fallback\"}, \"targets\": [\n   551\t                    {\"provider\": f\"@{spaces[w][1]}-provider-1\", \"api_key\": \"GW-PRIVATE-ROUTE-KEY\",\n   552\t                     \"forward_headers\": [\"x-trace\"]},\n   553\t                    {\"provider\": \"@backup\", \"weight\": 1}]}), \"format\": \"json\", \"type\": \"ROUTING\", \"version_id\": \"v-1\"}\n   554\t            g = guardrail(w)\n  3480\t                    // What an import writes waits while it (or its\n  3481\t                    // rollback) runs, until every receipt has settled, and\n  3482\t                    // while a receipt cannot be read (D050).\n  3483\t                    let result =\n  3484\t                        if state.v1_import_holds() && import_v1_domain::waits_for_import(&intent) {\n  3485\t                            Err(Refusal::Busy)\n  3486\t                        } else {\n  3487\t                            admit(\n  3488\t                                &mut state,\n  3489\t                                &self.inner.session,\n  3490\t                                &self.inner.adapters,\n  3491\t                                intent,\n  3492\t                                &mut effects,\n  3493\t                            )\n  3494\t                        };\n  3495\t                    if result.is_err() {\n  3496\t                        effects.clear();\n  3497\t                    }\n  3498\t                    // Settlements published by this intent are kept on\n  3499\t                    // this Mac whether or not the intent itself succeeded.\n  3500\t                    effects.extend(gateway_local_effects(&mut state));\n  3501\t                    // Learner records wait in the ledger for a confirmed\n  3502\t                    // save; once one has happened, let cleanup resume.\n  3503\t                    if !state.durability_unconfirmed && !state.data.learner_cleanup.is_empty() {\n  3504\t                        effects.push(Effect::Cleanup);\n  3505\t                    }\n  3506\t                    state\n  3507\t                        .operator_sessions\n  3508\t                        .record(&delivery, digest, result.clone());\n  3509\t                    (result, effects)\n  3510\t                }\n  3511\t            }\n  3512\t        };\n  3513\t        run_effects(&self.inner, effects);\n  3514\t        // Only the request's kind and the refusal's code (D051).\n  3515\t        self.inner\n  3516\t            .diagnostics\n  3517\t            .record(crate::diagnostics::Event::Intent {\n  3518\t                kind: kind.to_owned(),\n  3519\t                refusal: result.as_ref().err().map(refusal_code),\n  3520\t            });\n   150\t    }\n   151\t\n   152\t    impl<R: Runtime> OperatorConfirmation for NativeConfirmation<R> {\n   153\t        fn confirm(&self, nonce: u64, request: ConfirmationRequest) -> BoxFuture<'static, bool> {\n   154\t            let receiver = self.registry.open(nonce);\n   155\t            if receiver.is_some() {\n   156\t                let registry = Arc::clone(&self.registry);\n   157\t                let app = self.app.clone();\n   158\t                let presented = self.app.run_on_main_thread(move || {\n   159\t                    if !present(&app, nonce, &request, &registry) {\n   160\t                        registry.complete(nonce, false);\n   161\t                    }\n   162\t                });\n   163\t                if presented.is_err() {\n   164\t                    self.registry.complete(nonce, false);\n   165\t                }\n   166\t            }\n   167\t            Box::pin(outcome(receiver))\n   168\t        }\n   169\t\n   170\t        fn dismiss(&self, nonce: u64) {\n   171\t            self.registry.complete(nonce, false);\n   172\t            let _ = self.app.run_on_main_thread(move || end_sheet(nonce));\n   173\t        }\n   174\t    }\n   175\t\n   176\t    fn present<R: Runtime>(\n   177\t        app: &AppHandle<R>,\n   178\t        nonce: u64,\n   179\t        request: &ConfirmationRequest,\n   180\t        registry: &Arc<Registry>,\n   181\t    ) -> bool {\n   182\t        let Some(mtm) = MainThreadMarker::new() else {\n   183\t            return false;\n   184\t        };\n   185\t        let Some(window) = main_window(app) else {\n   186\t            return false;\n   187\t        };\n   188\t        let alert = NSAlert::new(mtm);\n   189\t        alert.setMessageText(&NSString::from_str(&request.title));\n   190\t        alert.setInformativeText(&NSString::from_str(&request.message));\n   191\t        let confirm = alert.addButtonWithTitle(&NSString::from_str(&request.confirm_label));\n   192\t        let cancel = alert.addButtonWithTitle(&NSString::from_str(\"Cancel\"));\n   193\t        if request.destructive {\n   194\t            alert.setAlertStyle(NSAlertStyle::Critical);\n   195\t            confirm.setHasDestructiveAction(true);\n   196\t            // Return cancels a destructive change; it must be chosen.\n   197\t            confirm.setKeyEquivalent(&NSString::from_str(\"\"));\n   198\t            cancel.setKeyEquivalent(&NSString::from_str(\"\\r\"));\n   199\t        }\n   200\t        let registry = Arc::clone(registry);\n   201\t        let handler = RcBlock::new(move |response: NSModalResponse| {\n   202\t            registry.complete(nonce, response == NSAlertFirstButtonReturn);\n   203\t            SHEETS.with(|s| s.borrow_mut().remove(&nonce));\n   204\t        });\n   205\t        alert.beginSheetModalForWindow_completionHandler(&window, Some(&handler));\n   206\t        SHEETS.with(|s| s.borrow_mut().insert(nonce, (window, alert.window())));\n   207\t        true\n   208\t    }\n   209\t\n   210\t    /// The transient one-time secret sheet for the main window.\n   211\t    pub struct NativeSecrets<R: Runtime> {\n   212\t        pub app: AppHandle<R>,\n   213\t    }\n   214\t\n   215\t    /// The secret sheet's current reveal.\n   216\t    static SECRET_OWNER: super::SecretOwnership = super::SecretOwnership::new();\n   217\t\n   218\t    impl<R: Runtime> SecretPresenter for NativeSecrets<R> {\n   219\t        fn reveal(&self, label: String, secret: Zeroizing<String>) {\n   220\t            let app = self.app.clone();\n   221\t            let _ = self\n   222\t                .app\n   223\t                .run_on_main_thread(move || reveal(&app, &label, secret));\n   224\t        }\n   225\t\n   226\t        fn dismiss(&self) {\n   227\t            let _ = self.app.run_on_main_thread(|| end_sheet(SECRET_SHEET));\n   228\t        }\n   229\t    }\n   230\t\n   231\t    fn reveal<R: Runtime>(app: &AppHandle<R>, label: &str, secret: Zeroizing<String>) {\n   232\t        let Some(mtm) = MainThreadMarker::new() else {\n   233\t            return;\n   234\t        };\n   235\t        let Some(window) = main_window(app) else {\n   236\t            return;\n   237\t        };\n   238\t        end_sheet(SECRET_SHEET);\n   239\t        let generation = SECRET_OWNER.begin();\n   240\t        let alert = NSAlert::new(mtm);\napps/desktop/src-tauri/capabilities/main.json\n{\n  \"$schema\": \"../gen/schemas/desktop-schema.json\",\n  \"identifier\": \"main-window\",\n  \"description\": \"The packaged main window may call only the two application commands.\",\n  \"local\": true,\n  \"windows\": [\"main\"],\n  \"webviews\": [\"main\"],\n  \"permissions\": [\"allow-desktop-dispatch\", \"allow-desktop-observe\"]\n}\n                .collect(),\n            prompt_detected: detections(&response.prompt_detected),\n            response_detected: detections(&response.response_detected),\n            topics: direction_topics(&wire, \"prompt\"),\n            response_topics: direction_topics(&wire, \"response\"),\n        }\n    }\n}\n\n/// The topic results of one direction (`prompt` or `response`), read from\n/// the response's wire form: the `topic_violation` flag and the topic\n/// guardrail's blocked and allowed names.\nfn direction_topics(wire: &serde_json::Value, direction: &str) -> TopicVerdict {\n    let names = |list: Option<&serde_json::Value>| -> Vec<String> {\n        list.and_then(serde_json::Value::as_array)\n            .map(|items| {\n                items\n                    .iter()\n                    .filter_map(serde_json::Value::as_str)\n                    .take(32)\n                    .map(shown)\n                    .collect()\n            })\n            .unwrap_or_default()\n    };\n    let details = wire\n        .get(format!(\"{direction}_detection_details\"))\n        .and_then(|d| d.get(\"topic_guardrails_details\"));\n    TopicVerdict {\n        violation: wire\n            .get(format!(\"{direction}_detected\"))\n            .and_then(|d| d.get(\"topic_violation\"))\n            .and_then(serde_json::Value::as_bool),\n        blocked: names(details.and_then(|d| d.get(\"blocked_topics\"))),\n        allowed: names(details.and_then(|d| d.get(\"allowed_topics\"))),\n    }\n}\n\n/// Why a scan did not produce a result (sanitized; no server text).\n#[derive(Clone, Copy, Debug, PartialEq, Eq, Serialize, TS)]\n#[serde(rename_all = \"camelCase\")]\npub enum ScanFailureKind {\n    Unauthorized,\n    Forbidden,\n    Conflict,\n    RateLimited,\n    BadRequest,\n    Unprocessable,\n    ServerError,\n    HttpOther,\n    Timeout,\n    Cancelled,\n}\n\n/**\n * The custom topic result, keyed apart from the detectors (C31, DESIGN-V2\n * §10 gap 2): a topic matched under the scan's profile is named; \"Not\n * detected\" says no assigned topic matched; an unreported verdict says so.\n * An applied topic never suppresses an enabled detector: both are shown.\n */\nfunction TopicVerdict({ result, topics, direction }: { result: ScanResultView; topics: ScanResultView['topics']; direction: 'prompt' | 'response' }) {\n    const profile = result.profileName ?? result.profileId ?? 'the scan profile'\n    const matched = topics.blocked.length > 0 || topics.allowed.length > 0 || topics.violation === true\n    return (\n        <div className='flex flex-col' style={{ gap: 4 }} data-slot='scan-topics' data-direction={direction} data-topic-verdict={topics.violation === null && !matched ? 'unreported' : matched ? 'flagged' : 'clear'}>\n            <h3 className='text-[13px] font-medium'>{direction === 'prompt' ? 'Custom topics · prompt' : 'Custom topics · response'}</h3>\n            {matched ? (\n                <ul className='flex flex-wrap' style={{ gap: 8 }}>\n                    {topics.blocked.map((t) => (\n                        <li key={`${direction}-b-${t}`}>\n                            <Pill tone='danger' glyph='ban' data-verdict='blocked'>\n                                {t}: flagged (blocked)\n                            </Pill>\n                        </li>\n                    ))}\n                    {topics.allowed.map((t) => (\n                        <li key={`${direction}-a-${t}`}>\n                            <Pill tone='warning' glyph='eye' data-verdict='monitor'>\n                                {t}: flagged (monitor only)\n                            </Pill>\n                        </li>\n                    ))}\n                    {topics.blocked.length === 0 && topics.allowed.length === 0 ? (\n                        <li>\n                            <Pill tone='danger' glyph='alert' data-verdict='unnamed'>\n                                A topic matched (the service named none)\n                            </Pill>\n                        </li>\n                    ) : null}\n                </ul>\n            ) : topics.violation === false ? (\n                <p className='flex items-center text-[12px]' style={{ gap: 4, color: 'var(--v2-soft)' }} data-verdict='clear'>\n                    <Glyph name='check' size={12} />\n                    Not detected: no custom topic assigned to {profile} matched.\n                </p>\n            ) : (\n                <p className='flex items-center text-[12px]' style={{ gap: 4, color: 'var(--v2-soft)' }} data-verdict='unreported'>\n                    <Glyph name='info' size={12} />\n                    Not reported by the service for this scan.\n                </p>\n            )}\n        </div>\n    )\n}\n\nfunction Detections({ title, items }: { title: string; items: Detection[] }) {\n    if (items.length === 0) return null\n    return (\n        <div className='flex flex-col' style={{ gap: 4 }} data-slot='scan-detections'>\n            <h3 className='text-[13px] font-medium'>{title}</h3>\n            <ul className='flex flex-wrap' style={{ gap: 8 }}>\n                {items.map((d) => (\n                    <li key={d.detector}>\n                        <Pill tone={d.detected ? 'danger' : 'default'}>\n                            {d.detector}: {d.detected ? 'detected' : 'not detected'}\n                        </Pill>\n","exit_code":0,"status":"completed"}}
