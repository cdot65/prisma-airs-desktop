{"type":"item.completed","item":{"id":"item_30","type":"command_execution","command":"/bin/zsh -lc 'cat tools/native-acceptance/administration_coverage.py tools/native-acceptance/test_administration_coverage.py; git diff e825c2f69cbcd19387142b80481faaad84690a07 -- tools/native-acceptance/legacy_assertions.py tools/native-acceptance/acceptance_c39.py'","aggregated_output":"\"\"\"Scoped Administration AX assertions shared by C31 and C39 native drivers.\n\nThe navigation rail and another expanded product are outside a product's\ninventory/detail authority. Missing card/table/detail never satisfies a\nnegative action assertion. This module performs no UI or endpoint operation.\n\"\"\"\n\n\ndef subtree(tree, node):\n    if node is None:\n        return []\n    start = next(i for i, candidate in enumerate(tree) if candidate is node)\n    end = next((i for i in range(start + 1, len(tree))\n                if tree[i].get(\"depth\", 0) <= node.get(\"depth\", 0)), len(tree))\n    return tree[start:end]\n\n\ndef product_nodes(tree, product):\n    heading = next((n for n in tree if n.get(\"role\") == \"AXHeading\"\n                    and (n.get(\"label\") or \"\").startswith(product + \" \")), None)\n    if heading is None:\n        return []\n    index = next(i for i, n in enumerate(tree) if n is heading)\n    parent = next((n for n in reversed(tree[:index]) if n.get(\"role\") == \"AXGroup\"\n                   and n.get(\"depth\", 0) < heading.get(\"depth\", 0)), None)\n    return subtree(tree, parent)\n\n\ndef product_header(tree, product):\n    nodes = product_nodes(tree, product)\n    heading = next((n for n in nodes if n.get(\"role\") == \"AXHeading\"\n                    and (n.get(\"label\") or \"\").startswith(product + \" \")), None)\n    return next((n for n in nodes if n.get(\"role\") == \"AXButton\"\n                 and heading and n.get(\"label\") == heading.get(\"label\")), None)\n\n\ndef button(nodes, label):\n    return next((n for n in nodes if n.get(\"role\") == \"AXButton\" and n.get(\"label\") == label), None)\n\n\ndef detail_nodes(tree, product):\n    nodes = product_nodes(tree, product)\n    for node in nodes:\n        if node.get(\"subrole\") == \"AXLandmarkRegion\":\n            detail = subtree(tree, node)\n            if button(detail, \"Close details\") is not None:\n                return detail\n    return []\n\n\ndef act_on_node(app, tree, node, action=\"press\"):\n    if node is None:\n        raise ValueError(\"required scoped AX node is missing\")\n    role, label = node[\"role\"], node[\"label\"]\n    matches = [n for n in tree if n.get(\"role\") == role\n               and (n.get(\"label\") or \"\").startswith(label)]\n    occurrence = next(i for i, candidate in enumerate(matches) if candidate is node)\n    return app.ax(action, role, label, occurrence)\n\n\ndef gated_product(tree, product, gate):\n    nodes = product_nodes(tree, product)\n    header = product_header(tree, product)\n    words = \" \".join(str(n.get(\"label\") or n.get(\"value\") or \"\") for n in nodes)\n    controls = [n for n in nodes if n.get(\"role\") in\n                (\"AXButton\", \"AXRadioButton\", \"AXTab\", \"AXTextField\", \"AXTextArea\", \"AXCheckBox\", \"AXTable\")]\n    return bool(nodes and header and gate in words and len(controls) == 1 and controls[0] is header)\n\n\ndef gateway_key_state(tree, kind, require_detail=False):\n    nodes = product_nodes(tree, \"AI Gateway\")\n    detail = detail_nodes(tree, \"AI Gateway\")\n    tabs = [n.get(\"label\") for n in nodes if n.get(\"role\") in (\"AXRadioButton\", \"AXTab\")]\n    forbidden = sorted({n.get(\"label\") for n in nodes\n                        if n.get(\"role\") in (\"AXButton\", \"AXMenuItem\", \"AXLink\")\n                        and (n.get(\"label\") or \"\").startswith((\"Issue additional key\", \"Finish rotation\"))})\n    value = {\"card_present\": bool(nodes), \"kind\": kind,\n             \"table\": any(n.get(\"role\") == \"AXTable\" and n.get(\"label\") == kind for n in nodes),\n             \"gateway_tabs\": tabs, \"no_limits\": \"Keys\" in tabs and \"Limits\" not in tabs,\n             \"forbidden_actions\": forbidden, \"detail_open\": bool(detail),\n             \"detail_actions\": [n.get(\"label\") for n in detail if n.get(\"role\") == \"AXButton\"]}\n    value[\"ok\"] = bool(nodes and value[\"table\"] and value[\"no_limits\"] and not forbidden\n                       and (not require_detail or detail))\n    return value\n\n\ndef gateway_keys_complete(value):\n    kinds = value.get(\"kinds\", {})\n    if set(kinds) != {\"Service keys\", \"User keys\"}:\n        return False\n    if not kinds[\"Service keys\"].get(\"details\"):\n        return False\n    for kind, observed in kinds.items():\n        state = observed.get(\"list\", {})\n        details = observed.get(\"details\", [])\n        expected = observed.get(\"row_labels\")\n        def complete(row, require_detail):\n            tabs = row.get(\"gateway_tabs\")\n            return (row.get(\"kind\") == kind and row.get(\"ok\") is True\n                    and row.get(\"card_present\") is True and row.get(\"table\") is True\n                    and row.get(\"no_limits\") is True and row.get(\"forbidden_actions\") == []\n                    and isinstance(tabs, list) and \"Keys\" in tabs and \"Limits\" not in tabs\n                    and isinstance(row.get(\"detail_actions\"), list)\n                    and row.get(\"detail_open\") is require_detail\n                    and (not require_detail or \"Close details\" in row[\"detail_actions\"]))\n        if (not complete(state, False) or not isinstance(expected, list)\n                or len(set(expected)) != len(expected) or len(details) != len(expected)):\n            return False\n        if any(row.get(\"row\") != label or not complete(row, True)\n               for row, label in zip(details, expected)):\n            return False\n    return True\n\"\"\"Focused AX scoping and enforced C31 requirement regressions; no UI calls.\"\"\"\nfrom pathlib import Path\nimport copy\nimport importlib.util\nimport sys\nimport unittest\n\nHERE = Path(__file__).resolve().parent\nROOT = HERE.parent.parent\nsys.path.insert(0, str(HERE))\nimport administration_coverage as coverage\n\n\ndef node(role, label, depth, **extra):\n    return dict(role=role, label=label, depth=depth, **extra)\n\n\ndef product(name, body):\n    heading = name + \" product description\"\n    return [node(\"AXGroup\", name + \" tabs Keys\", 2),\n            node(\"AXHeading\", heading, 3), node(\"AXButton\", heading, 4), *body]\n\n\ndef gateway_tree(forbidden=False, detail=True, kind=\"Service keys\"):\n    # A legitimate Runtime rotation and a similarly named navigation button\n    # coexist with Gateway. They are not Gateway inventory authority.\n    tree = [node(\"AXButton\", \"AI Gateway\", 1)]\n    tree += product(\"AI Runtime Security\", [\n        node(\"AXButton\", \"Issue additional key…\", 3),\n        node(\"AXButton\", \"Finish rotation…\", 3)])\n    body = [node(\"AXTabGroup\", \"AI Gateway tabs\", 3), node(\"AXRadioButton\", \"Keys\", 4),\n            node(\"AXRadioButton\", \"Service keys\", 3), node(\"AXRadioButton\", \"User keys\", 3),\n            node(\"AXTable\", kind, 3)]\n    if detail:\n        body += [node(\"AXGroup\", \"gateway-key-1\", 3, subrole=\"AXLandmarkRegion\"),\n                 node(\"AXHeading\", \"gateway-key-1\", 4), node(\"AXButton\", \"Remove…\", 4)]\n        if forbidden:\n            body.append(node(\"AXButton\", \"Issue additional key…\", 4))\n        body.append(node(\"AXButton\", \"Close details\", 4))\n    return tree + product(\"AI Gateway\", body)\n\n\ndef complete_observations():\n    result = {\"kinds\": {}}\n    for kind in (\"Service keys\", \"User keys\"):\n        list_state = coverage.gateway_key_state(gateway_tree(detail=False, kind=kind), kind)\n        detail = coverage.gateway_key_state(gateway_tree(kind=kind), kind, require_detail=True)\n        detail[\"row\"] = \"Details for gateway-key-1\"\n        result[\"kinds\"][kind] = {\"list\": list_state, \"row_labels\": [detail[\"row\"]], \"details\": [detail]}\n    return result\n\n\nclass AdministrationScoping(unittest.TestCase):\n    def test_runtime_rotation_does_not_taint_gateway(self):\n        state = coverage.gateway_key_state(gateway_tree(), \"Service keys\", require_detail=True)\n        self.assertTrue(state[\"ok\"])\n        self.assertEqual(state[\"forbidden_actions\"], [])\n        self.assertEqual(state[\"detail_actions\"], [\"Remove…\", \"Close details\"])\n\n    def test_gateway_rotation_action_is_rejected(self):\n        state = coverage.gateway_key_state(gateway_tree(forbidden=True), \"Service keys\", require_detail=True)\n        self.assertFalse(state[\"ok\"])\n        self.assertEqual(state[\"forbidden_actions\"], [\"Issue additional key…\"])\n\n    def test_missing_card_table_or_detail_is_not_negative_proof(self):\n        for tree in [[], gateway_tree(detail=False),\n                     [n for n in gateway_tree() if n[\"role\"] != \"AXTable\"]]:\n            with self.subTest(tree=tree):\n                self.assertFalse(coverage.gateway_key_state(tree, \"Service keys\", require_detail=True)[\"ok\"])\n\n    def test_header_action_uses_board_card_not_navigation_rail(self):\n        tree = gateway_tree()\n        header = coverage.product_header(tree, \"AI Gateway\")\n        self.assertEqual(header[\"label\"], \"AI Gateway product description\")\n        calls = []\n        class App:\n            def ax(self, *args):\n                calls.append(args)\n        coverage.act_on_node(App(), tree, header, \"focus\")\n        self.assertEqual(calls, [(\"focus\", \"AXButton\", \"AI Gateway product description\", 0)])\n\n    def test_gate_only_product_rejects_other_interactive_actions(self):\n        name = \"Agentic Identity Security\"\n        gate = \"needs an admitted \" + name + \" service\"\n        tree = product(name, [node(\"AXStaticText\", gate, 3)])\n        self.assertTrue(coverage.gated_product(tree, name, gate))\n        tree.append(node(\"AXButton\", \"New identity…\", 3))\n        self.assertFalse(coverage.gated_product(tree, name, gate))\n\n    def test_both_key_kinds_and_every_returned_detail_are_required(self):\n        value = complete_observations()\n        self.assertTrue(coverage.gateway_keys_complete(value))\n        bad = copy.deepcopy(value)\n        del bad[\"kinds\"][\"User keys\"]\n        self.assertFalse(coverage.gateway_keys_complete(bad))\n        bad = copy.deepcopy(value)\n        bad[\"kinds\"][\"Service keys\"][\"details\"] = []\n        self.assertFalse(coverage.gateway_keys_complete(bad))\n        bad = copy.deepcopy(value)\n        bad[\"kinds\"][\"User keys\"][\"row_labels\"].append(\"Details for missing-key\")\n        self.assertFalse(coverage.gateway_keys_complete(bad))\n\n    def test_missing_or_failed_assertion_fact_rejects_coverage(self):\n        value = complete_observations()\n        for kind in [\"Service keys\", \"User keys\"]:\n            for location in [\"list\", \"detail\"]:\n                original = value[\"kinds\"][kind][\"list\"] if location == \"list\" else value[\"kinds\"][kind][\"details\"][0]\n                for field in original:\n                    with self.subTest(kind=kind, location=location, missing=field):\n                        bad = copy.deepcopy(value)\n                        state = bad[\"kinds\"][kind][\"list\"] if location == \"list\" else bad[\"kinds\"][kind][\"details\"][0]\n                        del state[field]\n                        self.assertFalse(coverage.gateway_keys_complete(bad))\n            bad = copy.deepcopy(value)\n            bad[\"kinds\"][kind][\"details\"][0][\"forbidden_actions\"] = [\"Finish rotation…\"]\n            self.assertFalse(coverage.gateway_keys_complete(bad))\n\n\nclass RequiredNativeAssertions(unittest.TestCase):\n    @classmethod\n    def setUpClass(cls):\n        path = ROOT / \"docs/planning/evidence/P09/native-controller/native_requirements.py\"\n        spec = importlib.util.spec_from_file_location(\"c31_native_requirements\", path)\n        cls.requirements = importlib.util.module_from_spec(spec)\n        spec.loader.exec_module(cls.requirements)\n        cls.required = cls.requirements.load_requirements(ROOT)\n\n    def record(self, subject):\n        return {\"app\": {\"executable_sha256\": \"current-test-executable\"},\n                \"checks\": [{\"id\": cid, \"result\": \"pass\", \"evidence\": [\"tools/native-acceptance/legacy_assertions.py\"]}\n                           for cid in sorted(self.required[subject])]}\n\n    def test_all_original_c31_inventory_and_accessibility_checks_required(self):\n        self.assertEqual(self.required[\"C31\"], {\"C31-N01\", \"C31-N02\", \"C31-N03\", \"C31-N04\"})\n        self.assertTrue({\"C39-N01\", \"C39-N02\", \"C39-N03\", \"C39-N04\"} <= self.required[\"C39\"])\n\n    def test_missing_failed_or_stale_required_assertion_rejected(self):\n        for subject, ids in [(\"C31\", [\"C31-N01\", \"C31-N04\"]), (\"C39\", [\"C39-N03\", \"C39-N04\"])]:\n            baseline = self.record(subject)\n            errors, _ = self.requirements.assess_record(baseline, ROOT, \"current-test-executable\", self.required[subject])\n            self.assertEqual(errors, [])\n            for cid in ids:\n                for mutation in [\"missing\", \"fail\"]:\n                    with self.subTest(cid=cid, mutation=mutation):\n                        value = copy.deepcopy(baseline)\n                        if mutation == \"missing\":\n                            value[\"checks\"] = [c for c in value[\"checks\"] if c[\"id\"] != cid]\n                        else:\n                            next(c for c in value[\"checks\"] if c[\"id\"] == cid)[\"result\"] = \"fail\"\n                        errors, _ = self.requirements.assess_record(value, ROOT, \"current-test-executable\", self.required[subject])\n                        self.assertIn(cid + \" \" + mutation, errors)\n            errors, _ = self.requirements.assess_record(baseline, ROOT, \"different-executable\", self.required[subject])\n            self.assertIn(\"stale executable\", errors)\n\n\n\nclass GatewayWorkspacePrerequisite(unittest.TestCase):\n    def test_key_inspection_selects_the_required_workspace_before_key_controls(self):\n        from unittest.mock import patch\n        import acceptance_c31 as driver\n        class App:\n            def __init__(self):\n                self.workspace = False\n                self.kind = 'Service keys'\n                self.detail = False\n                self.actions = []\n            def tree(self):\n                if not self.workspace:\n                    return product('AI Gateway', [node('AXRadioButton', 'Keys', 3),\n                        node('AXRadioButton', 'Team A · us', 3),\n                        node('AXStaticText', 'Choose a workspace to read its configuration.', 3)])\n                tree = gateway_tree(detail=self.detail, kind=self.kind)\n                if not self.detail:\n                    tree.append(node('AXButton', 'Details for gateway-key-1', 3))\n                return tree\n            def wait_for(self, predicate, timeout=12):\n                tree = self.tree()\n                return tree, bool(predicate(tree))\n            def ax(self, action, role, label, occurrence=0):\n                self.actions.append(label)\n                if label.startswith('Team A'):\n                    self.workspace = True\n                elif label in ['Service keys', 'User keys']:\n                    self.kind = label\n                elif label.startswith('Details for '):\n                    self.detail = True\n                elif label == 'Close details':\n                    self.detail = False\n        app = App()\n        with patch.object(driver.c29, 'save_tree', return_value='synthetic-tree.json'), patch.object(driver.c29, 'capture', return_value='synthetic-capture.png'):\n            result = driver.gateway_key_checks(app)\n        self.assertTrue(coverage.gateway_keys_complete(result))\n        self.assertEqual(app.actions[0], 'Team A · us')\n        self.assertEqual(set(result['kinds']), {'Service keys', 'User keys'})\n\nif __name__ == \"__main__\":\n    unittest.main()\ndiff --git a/tools/native-acceptance/acceptance_c39.py b/tools/native-acceptance/acceptance_c39.py\nindex 0c7121f8..deef2041 100644\n--- a/tools/native-acceptance/acceptance_c39.py\n+++ b/tools/native-acceptance/acceptance_c39.py\n@@ -37,6 +37,7 @@ import acceptance_c28 as c28  # noqa: E402\n import acceptance_c29 as c29  # noqa: E402\n import v2_setup as v2s  # noqa: E402\n import acceptance_c31 as c31  # noqa: E402\n+import administration_coverage as coverage  # noqa: E402\n \n ROOT = os.getcwd()\n EVIDENCE = os.path.join(ROOT, \"docs/planning/evidence/C39\")\n@@ -376,7 +377,8 @@ def exercise(app, endpoint, mgmt, prepared, FINAL):\n     if views:\n         app.ax(\"press\", \"AXButton\", views[0][\"label\"][:60])\n         tree, n1[\"detail\"] = app.wait_for(lambda t: any(n.get(\"role\") == \"AXButton\" and (n.get(\"label\") or \"\") == \"Close details\" for n in t), 15)\n-        detail_buttons = [(n.get(\"label\") or \"\") for n in tree if n.get(\"role\") == \"AXButton\" and (n.get(\"label\") or \"\") in (\"Edit…\", \"Delete…\", \"Close details\")]\n+        detail_buttons = [(n.get(\"label\") or \"\") for n in coverage.detail_nodes(tree, \"AI Runtime Security\")\n+                          if n.get(\"role\") == \"AXButton\"]\n         n1[\"detail_actions\"] = detail_buttons\n         obs[\"tree_detail\"] = c29.save_tree(\"admin-detail\", tree)\n         c29.press(app, \"AXButton\", \"Close details\")\n@@ -479,7 +481,9 @@ def exercise(app, endpoint, mgmt, prepared, FINAL):\n     tree, n3[\"gateway_tabs\"] = app.wait_for(lambda t: tab_of(t, \"Workspaces\") is not None and tab_of(t, \"Routes\") is not None, 10)\n     t = tab_of(app.tr