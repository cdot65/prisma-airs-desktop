{"type":"item.completed","item":{"id":"item_55","type":"command_execution","command":"/bin/zsh -lc \"python3 -c 'import json; \nfor p in [\\\"docs/architecture/checks.json\\\",\\\"docs/architecture/native-checks.json\\\"]:\n r=json.load(open(p)); print(p,list(r)); print(json.dumps(r.get(\\\"chunks\\\",{}).get(\\\"C31\\\"),indent=2));\nr=json.load(open(\\\"docs/architecture/inputs.lock.json\\\")); print(\\\"INPUTS\\\",str(r)[:4500])'\"","aggregated_output":"docs/architecture/checks.json ['schema_version', 'status', 'target', 'fixture_only_features', 'setup_commands', 'common_commands', 'controller', 'shared_source_commands', 'artifact_build', 'chunks', 'phases', 'phase_native_prepare', 'invariants', 'requested_production_features', 'effective_features', 'controller_commands', 'reviewer', 'shared_lifecycle_contract', 'shared_source_required_chunks', 'shared_source_requirement', 'environment_contract']\n{\n  \"rust_target\": \"ui_v2_reviews\",\n  \"fixture_command\": [\n    \"cargo\",\n    \"test\",\n    \"--locked\",\n    \"-p\",\n    \"desktop-core\",\n    \"--features\",\n    \"test-fixtures\",\n    \"--test\",\n    \"ui_v2_reviews\"\n  ],\n  \"native_prepare\": [\n    \"cargo\",\n    \"run\",\n    \"--locked\",\n    \"-p\",\n    \"xtask\",\n    \"--\",\n    \"native-prepare\",\n    \"--chunk\",\n    \"C31\",\n    \"--target\",\n    \"aarch64-apple-darwin\",\n    \"--features\",\n    \"test-fixtures\"\n  ],\n  \"native_acceptance\": \"T09 relevant changed-UI checklist plus chunk-specific native assertions (including the UI v2 accessibility additions, DESIGN-V2 \\u00a78); real CUA/operator record required\",\n  \"live_requirement\": \"one prefixed review apply and read-back on the designated change-allowed tenant with cleanup (owner scope 2026-10-25)\",\n  \"host_commands\": [\n    [\n      \"cargo\",\n      \"test\",\n      \"--locked\",\n      \"-p\",\n      \"desktop-core\",\n      \"--features\",\n      \"test-fixtures\"\n    ],\n    [\n      \"cargo\",\n      \"test\",\n      \"--locked\",\n      \"-p\",\n      \"desktop-host\",\n      \"--features\",\n      \"test-fixtures\"\n    ]\n  ],\n  \"frontend_commands\": [\n    [\n      \"pnpm\",\n      \"--filter\",\n      \"@prisma-airs/desktop\",\n      \"exec\",\n      \"vitest\",\n      \"run\",\n      \"--config\",\n      \"vitest.config.ts\"\n    ]\n  ]\n}\ndocs/architecture/native-checks.json ['schema', 'description', 'fixture_identifier', 'chunks']\n[\n  {\n    \"id\": \"C31-N01\",\n    \"check\": \"Administration renders the core's inventory: Agentic Identity and Endpoint Security show their gate and nothing else; each tab offers exactly its admitted actions with per-tab labels (Custom topics 'New topic\\u2026', API keys 'New API key\\u2026', no 'New application\\u2026', an API key's 'Issue additional key\\u2026', 'Regenerate\\u2026' and 'Remove\\u2026' but never 'Edit\\u2026'); the Gateway tabs omit the removed Limits tab and its keys never offer 'Issue additional key\\u2026' or 'Finish rotation\\u2026'; Codebase scans is unavailable with its gate.\"\n  },\n  {\n    \"id\": \"C31-N02\",\n    \"check\": \"A custom topic edit opens the review sheet; Apply stays disabled until the typed name matches exactly (empty and wrong case refused); Apply opens the native confirmation titled for the topic; Return applies once; the applied panel says 'Live. The item was read back.'; Done closes the sheet.\"\n  },\n  {\n    \"id\": \"C31-N03\",\n    \"check\": \"The staged Runtime key rotation: 'Issue additional key\\u2026' reviewed with CREATE and confirmed natively issues one key and shows 'Additional key issued \\u00b7 old key still active'; Reveal opens the host secret sheet with the issued key (never in the web view); Escape ends the review; the Inbox lists the distinct reminder; 'Finish rotation\\u2026' resumes without any secret control; 'Application updated' records the local acknowledgement and opens the old key's removal review; its native Delete removes the key once and the panel reads 'Rotation complete \\u00b7 old key removed' with both labelled timestamps.\"\n  },\n  {\n    \"id\": \"C31-N04\",\n    \"check\": \"The accessibility additions (DESIGN-V2 \\u00a78) on the changed UI: the review sheet is the one topmost modal (the rail hidden beneath it) and Escape closes it with focus returned to the page; the rotation reminder leaves the Inbox once the old key is read back gone; Tab from a product header reaches its tabs; at the 900\\u00d7600 minimum and 200% zoom in both themes nothing on the Administration screen lies past the window's right edge; a focused review-sheet control shows its focus ring (pixels around it change against the unfocused capture); the applied result and the rotation's completion sit in polite status regions; with Reduce Motion on, the applied change's toast stays past 6 s until dismissed, and the system setting is restored.\"\n  }\n]\nINPUTS {'schema': 'airs-v2/inputs/1', 'academy': {'origin': 'ssh://git@git-ssh.cdot.io/cdot.io/ai-security-academy.git', 'branch': 'v2/desktop-presentation', 'base_commit': '7f3a28c4082a5bb278bbff5d79fab106c240155a', 'commit': '532809aa4bb2e1484e11ca9f7a414328260c7901', 'tree_sha256': '73e1c80889af89311b374808fce1f99386ced2fe95bc3a54429c40a72ce5530d', 'package_version': '0.176.0'}}\n","exit_code":0,"status":"completed"}}
