{"type":"item.completed","item":{"id":"item_43","type":"command_execution","command":"/bin/zsh -lc 'cat docs/planning/evidence/P09/native-controller/native_requirements.py; cat tools/p09/test_c31_transition.py tools/p09/seal-c31-transition.py tools/p09/audit-p09-checks-c31-transition.py'","aggregated_output":"\"\"\"Read the C44 gate's existing assertion map without changing its requirements.\"\"\"\nimport json\nimport re\nimport runpy\n\n\ndef load_requirements(root):\n    manifest = json.loads((root / 'docs/architecture/native-checks.json').read_text())['chunks']\n    data = runpy.run_path(str(root / 'tools/native-acceptance/legacy_assertions.py'))\n    assertions = data['ASSERTIONS']\n    legacy_ids = {c['id'] for chunk, checks in manifest.items()\n                  if re.fullmatch(r'C(0[1-9]|1\\d|2\\d|3[0-3])', chunk) for c in checks}\n    assert legacy_ids == set(assertions), 'legacy map differs from the full manifest'\n    targets = {t for kind, ts, _ in assertions.values()\n               if kind in (data['X'], data['S'], data['P']) for t in ts}\n    self_run = {lid.split('-')[0] for lid, (kind, _, _) in assertions.items() if kind == data['S']}\n    required = {chunk: {t for t in targets if t.startswith(chunk + '-')} for chunk in self_run}\n    # Some legacy ids are carried by a different self-run driver. Only drivers with actual targets run;\n    # the union check below still requires every mapped target to be covered.\n    required = {chunk: checks for chunk, checks in required.items() if checks}\n    for chunk in [f'C{i}' for i in range(35, 45)]:\n        required[chunk] = {c['id'] for c in manifest[chunk]}\n    assert all(required.values()), 'empty required native check set'\n    assert targets <= set().union(*required.values()), 'mapped native target has no driver'\n    return required\n\n\ndef assess_record(record, root, executable_sha256, required):\n    errors = []\n    if record.get('app', {}).get('executable_sha256') != executable_sha256:\n        errors.append('stale executable')\n    checks = {c['id']: c for c in record.get('checks', [])}\n    for cid in sorted(required):\n        check = checks.get(cid)\n        if check is None:\n            errors.append(cid + ' missing')\n        elif check['result'] != 'pass':\n            errors.append(cid + ' ' + check['result'])\n        else:\n            errors.extend(cid + ' missing evidence: ' + e for e in check['evidence'] if not (root / e).exists())\n    carried_elsewhere = [cid for cid, c in checks.items() if cid not in required and c['result'] != 'pass']\n    return errors, carried_elsewhere\n\"\"\"Fail-closed transition guard probes; no application/native/live actions.\"\"\"\nfrom pathlib import Path\nimport json\nimport tempfile\nimport unittest\nfrom unittest.mock import patch\nimport sys\nsys.path.insert(0, str(Path(__file__).resolve().parent))\nimport c31_transition_policy as policy\nimport phase_packet_owner_closure as packet\n\n\nclass TransitionGuards(unittest.TestCase):\n    def setUp(self):\n        self.tmp = tempfile.TemporaryDirectory()\n        self.addCleanup(self.tmp.cleanup)\n        self.root = Path(self.tmp.name)\n        self.directory = self.root / policy.PREFIX\n        self.directory.mkdir(parents=True)\n        self.old = {'README.md': {'kind': 'file', 'sha256': 'old', 'mode': 420}}\n        self.current = dict(self.old)\n        self.commit = 'a' * 40\n        self.seal = {'baseline_head': policy.BASE_HEAD, 'baseline_digest': policy.digest(self.old),\n                     'source_delta': {}, 'current_source_digest': policy.digest(self.current),\n                     'fix_commits': [self.commit, 'b' * 40],\n                     'focused_results': [{'exit': 0, 'record': 'preflight.json', 'sha256': 'result'}]}\n        (self.root / 'preflight.json').write_text(json.dumps({'command': ['test'], 'exit': 0}))\n        self.baseline = {'head': policy.BASE_HEAD, 'files': self.old, 'digest': policy.digest(self.old)}\n        (self.directory / 'baseline-source.json').write_text(json.dumps(self.baseline))\n        self.addCleanup(patch.stopall)\n        patch.object(policy, 'BASE_DIGEST', policy.digest(self.old)).start()\n        patch.object(packet, 'source_inventory', return_value=self.current).start()\n        patch.object(policy.subprocess, 'run').start().return_value.returncode = 0\n        patch.object(policy.subprocess, 'check_output', return_value='').start()\n        patch.object(policy.original, 'sha', side_effect=lambda p: policy.OWNER_SHA if str(p).endswith(policy.OWNER_SCORE) else 'result').start()\n\n    def verify(self):\n        (self.directory / policy.TRANSITION_RECORD).write_text(json.dumps(self.seal))\n        return policy.verify_transition(self.root)\n\n    def test_complete_declared_transition(self):\n        self.assertEqual(self.verify()['changed_paths'], [])\n\n    def test_undeclared_current_change_rejected(self):\n        self.current['README.md']['sha256'] = 'drift'\n        with self.assertRaisesRegex(ValueError, 'sealed C31 delta'):\n            self.verify()\n\n    def test_declared_unrelated_production_change_rejected(self):\n        self.current['apps/desktop/src/app.tsx'] = {'kind': 'file', 'sha256': 'bad', 'mode': 420}\n        self.seal['source_delta'] = {'apps/desktop/src/app.tsx': {'before': None, 'after': self.current['apps/desktop/src/app.tsx']}}\n        with self.assertRaisesRegex(ValueError, 'non-C31'):\n            self.verify()\n\n    def test_failed_focused_result_rejected(self):\n        self.seal['focused_results'][0]['exit'] = 1\n        with self.assertRaisesRegex(ValueError, 'preflight'):\n            self.verify()\n\n    def test_unintegrated_fix_rejected(self):\n        with patch.object(policy.subprocess, 'run') as run:\n            run.return_value.returncode = 1\n            with self.assertRaisesRegex(ValueError, 'not integrated'):\n                self.verify()\n\n    def test_fix_commit_unrelated_path_rejected(self):\n        with patch.object(policy.subprocess, 'check_output', return_value='apps/desktop/src/app.tsx\\n'):\n            with self.assertRaisesRegex(ValueError, 'unrelated source'):\n                self.verify()\n\n    def test_late_source_change_rejected(self):\n        self.verify()\n        self.current['new-source.rs'] = {'kind': 'file', 'sha256': 'new', 'mode': 420}\n        with self.assertRaisesRegex(ValueError, 'sealed C31 delta'):\n            policy.verify_transition(self.root)\n\n\n\nclass DriverContinuationGuards(unittest.TestCase):\n    root = Path(__file__).resolve().parents[2]\n\n    def current_digest(self):\n        return json.loads((self.root / policy.PREFIX / 'driver-amendment-01/equivalence.json').read_text())['after_digest']\n\n    def test_actual_complete_equivalence(self):\n        result = policy.verify_driver_amendment(self.root, self.current_digest())\n        self.assertEqual(result['retained_native_steps'], 10)\n\n    def test_changed_application_artifact_rejected(self):\n        original_sha = policy.original.sha\n        prep = json.loads((self.root / 'docs/planning/evidence/P09/native-prepare.json').read_text())\n        executable = self.root / prep['bundle'] / 'Contents/MacOS/prisma-airs-desktop-v2'\n        with patch.object(policy.original, 'sha', side_effect=lambda p: 'changed' if Path(p) == executable else original_sha(p)):\n            with self.assertRaisesRegex(ValueError, 'executable changed'):\n                policy.verify_driver_amendment(self.root, self.current_digest())\n\n    def test_changed_runtime_outside_the_one_function_rejected(self):\n        original_text = Path.read_text\n        driver = self.root / 'tools/native-acceptance/acceptance_c31.py'\n        def text(path, *args, **kwargs):\n            value = original_text(path, *args, **kwargs)\n            return value + '\\nUNRELATED_RUNTIME_CHANGE = True\\n' if path == driver else value\n        with patch.object(Path, 'read_text', text):\n            with self.assertRaisesRegex(ValueError, 'exceeds the Gateway'):\n                policy.verify_driver_amendment(self.root, self.current_digest())\n\n    def test_changed_retained_evidence_rejected(self):\n        read = policy.original.read\n        def changed(path):\n            value = read(path)\n            if str(path).endswith('driver-amendment-01/equivalence.json'):\n                value['completed_native_steps'][0]['record_sha256'] = 'wrong'\n            return value\n        with patch.object(policy.original, 'read', side_effect=changed):\n            with self.assertRaisesRegex(ValueError, 'retained G8 evidence changed'):\n                policy.verify_driver_amendment(self.root, self.current_digest())\n\nif __name__ == '__main__':\n    unittest.main()\n\"\"\"Seal the exact authorized C31 delta after focused preflight, before build.\n\nNo qualification result or review score is created here. Pass explicit fix\ncommits and actual passing preflight JSON records with command/exit fields.\n\"\"\"\nfrom pathlib import Path\nimport argparse\nimport json\nimport subprocess\nimport datetime\nimport sys\nsys.path.insert(0, str(Path(__file__).resolve().parent))\nimport c31_transition_policy as policy\nfrom phase_packet_owner_closure import source_inventory\n\nparser = argparse.ArgumentParser()\nparser.add_argument('--fix', action='append', required=True)\nparser.add_argument('--result', action='append', required=True)\nargs = parser.parse_args()\nroot = Path.cwd().resolve()\npath = root / policy.PREFIX / policy.TRANSITION_RECORD\nassert not path.exists(), 'preserve sealed transition'\nold = json.loads((root / policy.PREFIX / 'baseline-source.json').read_text())\ncurrent = source_inventory(root)\ndelta = {name: {'before': old['files'].get(name), 'after': current.get(name)}\n         for name in sorted(set(old['files']) | set(current)) if old['files'].get(name) != current.get(name)}\nassert set(delta) <= policy.FIX_PATHS | policy.ADMIN_PATHS, sorted(set(delta) - policy.FIX_PATHS - policy.ADMIN_PATHS)\nresults = []\nfor name in args.result:\n    value = json.loads((root / name).read_text())\n    assert value['exit'] == 0 and value['command'], 'focused result must be an actual successful command'\n    results.append({'record': name, 'sha256': policy.original.sha(root / name), 'exit': 0})\nvalue = {'schema': 'airs-v2/c31-source-transition/1',\n         'time': datetime.datetime.now(datetime.timezone.utc).isoformat(),\n         'baseline_head': policy.BASE_HEAD, 'baseline_digest': old['digest'],\n         'current_head': subprocess.check_output(['git', 'rev-parse', 'HEAD'], text=True).strip(),\n         'current_source_digest': policy.digest(current), 'source_delta': delta,\n         'fix_commits': args.fix, 'focused_results': results,\n         'meaning': 'Declared C31-only delta. Historical G7 is preserved; current application qualification and independent C31/C32/P09 reviews remain required.'}\npath.write_text(json.dumps(value, indent=2) + '\\n')\ntry:\n    print(json.dumps(policy.verify_transition(root), indent=2))\nexcept BaseException:\n    # Retain failed candidate for diagnosis; do not silently amend a seal.\n    raise\nfrom pathlib import Path\nimport datetime,hashlib,json,subprocess,sys\nroot=Path.cwd().resolve();attempt=sys.argv[1]\nsys.path.insert(0,str(root/'tools/p09'))\nimport phase_inputs_c31_transition as phase_inputs\nrecord=root/f'docs/planning/evidence/P09/runs/run-{attempt}.json'\nr=json.loads(record.read_text());out=record.parent/attempt/'post-check-audit.json'\nassert not out.exists(),'preserve prior post-check audits'\nsha=lambda p:hashlib.sha256(Path(p).read_bytes()).hexdigest()\nassert len(r['runs'])==18\nfor name,run in r['runs'].items():\n    assert run['exit']==0,name\n    assert sha(root/run['log'])==run['log_sha256'],name\nassert r['inputs']['unchanged'] and r['inputs']['before_digest']==r['inputs']['after_digest']\nscratch=root/'.evidence-private/p09-review'\nscratch.mkdir(parents=True,exist_ok=True)\npost=scratch/f'p09-post-{attempt}-inputs.sha256'\ndigest=subprocess.check_output(['/bin/bash',str(root/'docs/planning/evidence/P09/runs/hash-inputs.sh'),str(root),str(post)],text=True).strip()\nassert digest==r['inputs']['before_digest'],'compiled input drift'\ndef inv(p):\n    pairs=[line.split(None,1) for line in Path(p).read_text().splitlines()]\n    return {name.strip():digest for digest,name in pairs}\nbuilt=inv(root/'docs/planning/evidence/P09/runs/attempt-01/inputs-after.sha256');current=inv(post)\nchanges=[p for p in sorted(built.keys()|current.keys()) if built.get(p)!=current.get(p)]\n# The old preparation comparison is retained as provenance, never an exemption\n# list. Every current compiled input must match the fresh native build's actual\n# before/after seal, and all mapped native records must bind that executable.\nqualification=phase_inputs.verify_native(root)\nassert qualification['build_inputs']['input_digest']==digest,'checks differ from native build inputs'\nprep=json.loads((root/'docs/planning/evidence/P09/native-prepare.json').read_text())\nassert sha(root/prep['bundle']/'Contents/MacOS/prisma-airs-desktop-v2')==prep['executable_sha256']\nresult={'phase':'P09','check_attempt':attempt,'time':datetime.datetime.now(datetime.timezone.utc).isoformat(),\n        'check_runs_verified':18,'record_sha256':sha(record),'input_digest':digest,'members':r['inputs']['members'],'distinct_paths':len(current),\n        'compiled_inputs_unchanged':True,'fixture_executable_sha256':prep['executable_sha256'],\n        'changes_since_historical_preparation_inputs':changes,\n        'current_native_build_inputs_match':True,'native_build_inputs':qualification['build_inputs'],\n        'native_drivers_verified':len(qualification['records']),\n        'performance':qualification['performance'],\n        'native_complete':True,'phase_complete':False,\n        'limits':'Current check/native input audit only. Actual independent chunk and phase reviews remain required.'}\nout.write_text(json.dumps(result,indent=2)+'\\n');print(json.dumps(result,indent=2))\n","exit_code":0,"status":"completed"}}
