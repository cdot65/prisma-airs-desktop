avor = \"multi_thread\")]\n1065:async fn a_key_that_lands_after_the_review_closed_is_dropped_on_arrival() {\n1124:#[tokio::test(flavor = \"multi_thread\")]\n1125:async fn acknowledging_the_deployment_forgets_the_held_key() {\n1160:#[tokio::test(flavor = \"multi_thread\")]\n1161:async fn a_completed_version_whose_readback_missed_is_an_unconfirmed_issuance() {\n1208:#[tokio::test(flavor = \"multi_thread\")]\n1209:async fn leaving_an_applied_review_retires_its_held_key() {\n1244:#[tokio::test(flavor = \"multi_thread\")]\n1245:async fn a_key_detail_walk_reconciles_an_unconfirmed_removal() {\n1305:async fn apply_delayed(\n1334:async fn relaunched(desk: &Desk) -> ShellSnapshot {\n1367:#[tokio::test(flavor = \"multi_thread\")]\n1368:async fn a_switch_during_issuance_keeps_the_rotation_with_its_tenant() {\n1422:#[tokio::test(flavor = \"multi_thread\")]\n1423:async fn a_switch_during_removal_keeps_the_outcome_with_its_tenant() {\n1483:#[tokio::test(flavor = \"multi_thread\")]\n1484:async fn rotation_facts_survive_a_storage_failure_and_are_saved_on_recovery() {\n1574:async fn restart(old: Desk) -> Desk {\n1629:#[tokio::test(flavor = \"multi_thread\")]\n1630:async fn a_reused_operation_id_after_relaunch_never_links_another_key() {\napps/desktop/src/v2/modal.test.tsx:42:describe('modal stack (I8)', () => {\napps/desktop/src/v2/modal.test.tsx:43:    it('keeps only the topmost dialog interactive, traps Tab, closes top-first on Escape and restores each opener', async () => {\napps/desktop/src/v2/modal.test.tsx:83:    it('restores the exact non-first opener of a stacked dialog', async () => {\napps/desktop/src/v2/modal.test.tsx:104:    it('Escape closes only the topmost dialog even when focus has left it (a native sheet returned focus to the page)', async () => {\napps/desktop/src/v2/modal.test.tsx:116:    it('returns focus to the page heading when the opener no longer exists', async () => {\napps/desktop/src/v2/admin/administration.test.tsx:268:describe('v2 Administration', () => {\napps/desktop/src/v2/admin/administration.test.tsx:269:    it('renders the inventory: unavailable products show their gate and nothing else, removed tabs do not exist, unavailable tabs have no rows or actions (V2-T19, V2-T20)', async () => {\napps/desktop/src/v2/admin/administration.test.tsx:305:    it('labels creation and row actions per tab from the inventory: no \"New application…\", no key \"Edit…\" (V2-T20, gap 3)', async () => {\napps/desktop/src/v2/admin/administration.test.tsx:331:    it('applies a review only when the typed name matches, in the review sheet (V2-T03)', async () => {\napps/desktop/src/v2/admin/administration.test.tsx:409:    it('follows a rotation: Issued reveals only through the host and forgets the key on exit, Resumed has no secret controls, Complete shows both labelled timestamps (V2-T06, V2-T08, I6)', async () => {\napps/desktop/src/v2/admin/administration.test.tsx:512:    it('Gateway keys rotate in place: never \"Issue additional key…\" or \"Finish rotation…\" (V2-T20)', async () => {\napps/desktop/src/v2/admin/administration.test.tsx:521:    it('shows custom topic results apart from the detectors: an applied topic flags without suppressing an enabled detector (gap 2)', async () => {\napps/desktop/src/v2/admin/administration.test.tsx:566:    it('V2-T20: every product and tab renders its disposition, its content, and exactly the admitted actions', async () => {\napps/desktop/src/v2/admin/administration.test.tsx:572:        const creating = (b: HTMLElement) => /^(New |Provision )/.test(b.textContent ?? '')\napps/desktop/src/v2/admin/administration.test.tsx:604:                    expect(within(panel).queryAllByRole('button', { name: /…$/ }).filter((b) => !/attack results|Results for/.test(b.textContent ?? ''))).toEqual([])\napps/desktop/src/v2/admin/administration.test.tsx:642:    it('Gateway keys show their rows and rotate in place through the typed review; no staged rotation (V2-T20)', async () => {\napps/desktop/src/v2/admin/administration.test.tsx:667:    it('V2-T21: the Red Team Targets tab shows identifiers and types only; a target name in the reply never renders', async () => {\napps/desktop/src/v2/admin/administration.test.tsx:683:    it('a review exit ends the review in the core, also before its change settles and on unmount (V2-R06, I6)', async () => {\napps/desktop/src/v2/admin/administration.test.tsx:711:    it('says only what each action established: an update read back absent is not \"Removed\"; reconciliation reads the reviewed item (R5)', async () => {\napps/desktop/src/v2/admin/administration.test.tsx:733:    it('shows a response-only topic violation in its own labelled section beside unrelated detectors (R8)', async () => {\napps/desktop/src/v2/admin/administration.test.tsx:774:    it('announces each rotation stage in one persistent status region, without moving focus, and toasts completion for its tenant (R9, I10)', async () => {\napps/desktop/src/v2/admin/administration.test.tsx:792:    it('derives profile and topic relationships from one profile walk, and marks the keys of a rotation (R7)', async () => {\napps/desktop/src/v2/admin/administration.test.tsx:809:    it('opens the old key’s removal only once the acknowledgement is recorded: refused, invalid, stale or unconfirmed never advance (R3)', async () => {\napps/desktop/src/v2/admin/administration.test.tsx:839:    it('opens a Harness proposal’s native review in the review sheet with its exact draft; leaving discards it (R4)', async () => {\napps/desktop/src/v2/admin/administration.test.tsx:890:    it('names what a confirmed change established: tenant, resource, returned name and revision, and the recorded readback time (R5)', async () => {\napps/desktop/src/v2/admin/administration.test.tsx:923:    it('shows a failed second issuance apart from the rotation it leaves unchanged, with a manual retry and nothing resent (R2)', async () => {\napps/desktop/src/v2/admin/administration.test.tsx:963:    it('gives every topic verdict an icon and words, for the prompt and the response, in the production Playground (R3, I9)', async () => {\napps/desktop/src/v2/admin/administration.test.tsx:1012:    it('draws the product cards: description, headline figure from the read, status pill and alerts; Expand all and Collapse all (C39a)', async () => {\napps/desktop/src/v2/admin/administration.test.tsx:1037:    it('draws the Runtime Overview from the read: three tiles and the 24-hour bars; the table footer names the count and the read time (C39a)', async () => {\napps/desktop/src/v2/admin/administration.test.tsx:1057:    it('says when the chart was not read: the events tile names it and the bars are none (C39a)', async () => {\napps/desktop/src/v2/admin/administration.test.tsx:1071:    it('draws the Gateway Overview from the tenant read: requests, error rate and cost of the chosen workspace, never invented (C39b)', async () => {\napps/desktop/src/v2/admin/administration.test.tsx:1088:    it('saves, replaces and removes the chosen workspace\\u2019s inference key from the Gateway card\\u2019s Workspaces tab; the key never stays in the page (C44, the legacy Playground form is gone)', async () => {\napps/desktop/src/v2/admin/administration.test.tsx:1128:    it('lists Gateway routes as a table with View per row and the inventory actions in the detail; the Red Team overview draws its tiles and ranked bars (C39b)', async () => {\napps/desktop/src/v2/admin/administration.test.tsx:1148:    it('opens a change in the prototype’s sheet: the title with the review’s state, a close control, the change’s path (C39b)', async () => {\napps/desktop/src/v2/admin/administration.test.tsx:1163:    it('keeps a Gateway draft typed within the save pause when the sheet is closed at once: the exact text is saved, nothing is applied (C39b attempt-01 R1)', async () => {\napps/desktop/src/v2/admin/administration.test.tsx:1184:    it('the open sheet says what became of the Gateway draft from the current state: kept, rejected (incomplete JSON), not stored, and a save the desktop refused (C39b attempt-01 R2)', async () => {\napps/desktop/src/v2/admin/administration.test.tsx:1217:    it('every Red Team tab drawn from the scan list says what that list is: a partial sample of the reported total on Scans, Targets, Attack results and Reports, not only Overview; a list that could not be read says so there too (C39b attempt-01 R3)', async () => {\napps/desktop/src/v2/admin/administration.test.tsx:1255:describe('v2 Playground handlers (C39a E2)', () => {\napps/desktop/src/v2/admin/administration.test.tsx:1258:    it('submits the fields as typed, says a refusal and an unconfirmed delivery without replaying, and cancels a running scan', async () => {\napps/desktop/src/v2/admin/administration.test.tsx:1292:    it('saves a case from the fields as typed and says only what the library established', async () => {\napps/desktop/src/v2/admin/administration.test.tsx:1309:describe('v2 inventory table reads (C39a E2, R2, R3)', () => {\napps/desktop/src/v2/admin/administration.test.tsx:1338:    it('pages with Next page and First page, says the search is page-local, and starts again for a replaced context (E2, R3)', async () => {\napps/desktop/src/v2/admin/administration.test.tsx:1363:    it('keeps the rows with their read time when a refresh is denied (E2)', async () => {\napps/desktop/src/v2/admin/administration.test.tsx:1375:    it('a detail closed before its reply arrives stays closed and keeps focus where it was (R2)', async () => {\nimport { useEffect, useRef, useState } from 'react'\nimport type { RotationView } from '@prisma-airs/desktop-contracts'\nimport { clockOf } from '../copy'\nimport { Verdict } from '../verdict'\nimport { ADMIN_COPY as C } from './copy'\n\nexport interface RotationPanelProps {\n    rotation: RotationView\n    /** The tenant the panel was opened for: an announcement never outlives it. */\n    tenant: string | null\n    /** Hands the held one-time key to the host sheet (I6). */\n    onReveal: (operation: string) => void\n    onFinishLater: () => void\n    onUpdated: () => void\n    onIssueAnother: () => void\n    onRemoveOld: () => void\n    onReconcile: () => void\n    busy: boolean\n}\n\n/**\n * The staged Runtime key rotation (C31, I7; screens/reviews-administration.md\n * stages 1–4): every stage is the core's (`RotationView.stage`). The secret\n * is offered only while the core still holds it for this context; once it is\n * not, the panel says so and offers another issuance. Two timestamps are\n * shown with distinct labels: the operator's own statement and the remote\n * readback.\n */\nexport function RotationPanel({ rotation: r, tenant, onReveal, onFinishLater, onUpdated, onIssueAnother, onRemoveOld, onReconcile, busy }: RotationPanelProps) {\n    const btn = 'h-8 rounded-[7px] border px-3 text-[13px] disabled:opacity-60'\n    const primary = 'h-8 rounded-[7px] px-3 text-[13px] font-semibold disabled:opacity-60'\n    const primaryStyle = {\n        background: 'var(--v2-acc)',\n        color: 'var(--v2-acc-ink)',\n    }\n    const rule = { borderColor: 'var(--v2-rule)' }\n    // One persistent live region (DESIGN-V2 §8): each observed stage change\n    // is announced once, without moving focus; nothing is announced for a\n    // tenant other than the one the panel opened for.\n    const [opened] = useState(tenant)\n    const announcement = tenant === opened ? C.rotation.announce[r.stage](r.application) : ''\n    // A stage change replaces its controls; if the focused one went with it,\n    // focus stays in the panel instead of falling out of the sheet.\n    const panel = useRef<HTMLElement>(null)\n    useEffect(() => {\n        const active = document.activeElement\n        if (panel.current && (!active || active === document.body)) panel.current.focus()\n    }, [r.stage])\n    return (\n        <section\n            ref={panel}\n            tabIndex={-1}\n            aria-label={C.rotation.title(r.application)}\n            data-slot='rotation-panel'\n            data-stage={r.stage}\n            className='flex flex-col gap-3 rounded-[12px] border p-4'\n            style={rule}\n        >\n            <p role='status' aria-live='polite' aria-atomic='true' className='sr-only' data-slot='rotation-status'>\n                {announcement}\n            </p>\n            {r.unsaved ? (\n                <p role='alert' data-slot='rotation-unsaved' className='text-[13px]' style={{ color: 'var(--v2-flag)' }}>\n                    {C.rotation.unsaved}\n                </p>\n            ) : null}\n            {r.stage === 'issued' ? (\n                <>\n                    <Verdict tone='flagged' word={C.rotation.issued} />\n                    <p className='text-[13px]'>{C.rotation.issuedNote}</p>\n                    <div className='flex flex-wrap gap-2'>\n                        <button type='button' className={primary} style={primaryStyle} disabled={busy || !r.issuedBy} onClick={() => r.issuedBy && onReveal(r.issuedBy)}>\n                            {C.rotation.reveal}\n                        </button>\n                        <button type='button' className={btn} style={rule} onClick={onFinishLater}>\n                            {C.rotation.finishLater}\n                        </button>\n                        <button type='button' className={btn} style={rule} disabled={busy} onClick={onUpdated}>\n                            {C.rotation.updated}\n                        </button>\n                    </div>\n                </>\n            ) : r.stage === 'resumed' ? (\n                <>\n                    <Verdict tone='flagged' word={C.rotation.resumed} />\n                    <p className='text-[13px]'>{C.rotation.resumedNote(r.application)}</p>\n                    <div className='flex flex-wrap gap-2'>\n                        <button type='button' className={btn} style={rule} disabled={busy} onClick={onIssueAnother}>\n                            {C.rotation.issueAnother}\n                        </button>\n                        <button type='button' className={primary} style={primaryStyle} disabled={busy} onClick={onUpdated}>\n                            {C.rotation.updated}\n                        </button>\n                    </div>\n                </>\n            ) : r.stage === 'acknowledged' ? (\n                <>\n                    <Verdict tone='info' word={C.rotation.acknowledged(clockOf(r.deploymentAcknowledgedAt ?? 0))} />\n                    <p className='text-[13px]'>{C.rotation.acknowledgedNote}</p>\n                    {r.removalRejected ? (\n                        <p role='alert' className='text-[13px]' style={{ color: 'var(--v2-block)' }}>\n                            {C.rotation.rejected(r.removalRejected)}\n                        </p>\n                    ) : null}\n                    <div>\n                        <button type='button' className={primary} style={primaryStyle} disabled={busy} onClick={onRemoveOld}>\n                            {C.rotation.removeOld(r.oldKey.name)}\n                        </button>\n                    </div>\n                </>\n            ) : r.stage === 'issuanceUnconfirmed' || r.stage === 'removalUnconfirmed' ? (\n                <>\n                    <Verdict tone='flagged' word={r.stage === 'issuanceUnconfirmed' ? C.rotation.issuanceUnconfirmed : C.rotation.removalUnconfirmed} />\n                    <p className='text-[13px]'>{r.stage === 'issuanceUnconfirmed' ? C.rotation.issuanceUnconfirmedNote : C.rotation.removalUnconfirmedNote}</p>\n                    <div className='flex flex-wrap gap-2'>\n                        {r.stage === 'issuanceUnconfirmed' && r.issuedBy ? (\n                            // The service answered with a key the readback has not confirmed yet: it is still shown once.\n                            <button type='button' className={primary} style={primaryStyle} disabled={busy} onClick={() => r.issuedBy && onReveal(r.issuedBy)}>\n                                {C.rotation.reveal}\n                            </button>\n                        ) : null}\n                        <button type='button' className={btn} style={rule} disabled={busy} onClick={onReconcile}>\n                            {C.applied.reconcile}\n                        </button>\n                    </div>\n                </>\n            ) : (\n                <>\n                    <Verdict tone='allowed' word={C.rotation.complete(clockOf(r.oldKeyRemovedAt ?? 0))} />\n                    <p className='text-[13px]'>{C.rotation.completeNote}</p>\n                </>\n            )}\n            {r.deploymentAcknowledgedAt !== null || r.oldKeyRemovedAt !== null ? (\n                <table className='text-[12px]' data-slot='rotation-timestamps'>\n                    <caption className='sr-only'>{C.rotation.timestamps}</caption>\n                    <tbody>\n                        <tr>\n                            <th scope='row' className='pr-3 text-left font-medium'>\n                                {C.rotation.acknowledgedAt}\n                            </th>\n                            <td>{r.deploymentAcknowledgedAt !== null ? clockOf(r.deploymentAcknowledgedAt) : '—'}</td>\n                        </tr>\n                        <tr>\n                            <th scope='row' className='pr-3 text-left font-medium'>\n                                {C.rotation.removedAt}\n                            </th>\n                            <td>{r.oldKeyRemovedAt !== null ? clockOf(r.oldKeyRemovedAt) : '—'}</td>\n                        </tr>\n                    </tbody>\n                </table>\n            ) : null}\n        </section>\n    )\n}\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_39","type":"command_execution","command":"/bin/zsh -lc \"sed -n '550,833p' crates/desktop-core/tests/ui_v2_reviews/main.rs; sed -n '833,1055p' crates/desktop-core/tests/ui_v2_reviews/main.rs\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_39","type":"command_execution","command":"/bin/zsh -lc \"sed -n '550,833p' crates/desktop-core/tests/ui_v2_reviews/main.rs; sed -n '833,1055p' crates/desktop-core/tests/ui_v2_reviews/main.rs\"","aggregated_output":"#[tokio::test(flavor = \"multi_thread\")]\nasync fn the_inventory_offers_only_admitted_actions_and_the_core_refuses_the_denied_ones() {\n    let mut desk = desk().await;\n    // C44: one presentation; the inventory is always carried (the switch intent is accepted and ignored).\n    desk.send(json!({\"kind\": \"setUiVariant\", \"variant\": \"v2\"}))\n        .await\n        .expect(\"v2\");\n    let inventory = desk\n        .snap()\n        .administration\n        .expect(\"the v2 shell's inventory\");\n    assert_eq!(inventory.products.len(), 6);\n    let mut denied = Vec::new();\n    for product in &inventory.products {\n        if let desktop_core::admin_inventory::AdminAvailability::Unavailable { reason } =\n            &product.availability\n        {\n            assert!(product.tabs.is_empty(), \"{:?} has tabs\", product.id);\n            assert!(reason.contains(\"Not available in this release\"));\n            continue;\n        }\n        for tab in &product.tabs {\n            if product.read_only {\n                assert!(tab.actions.is_empty());\n            }\n            for a in &tab.actions {\n                assert!(desktop_core::changes::is_allowed(a.kind, a.action));\n            }\n            for d in &tab.denied {\n                assert!(!desktop_core::changes::is_allowed(d.kind, d.action));\n                denied.push((d.kind, d.action));\n            }\n        }\n    }\n    assert!(denied.contains(&(ChangeKind::ApiKeys, ChangeAction::Update)));\n    assert!(denied.contains(&(ChangeKind::Applications, ChangeAction::Create)));\n    assert!(denied.contains(&(ChangeKind::GatewayServiceKeys, ChangeAction::Version)));\n    // Every denied Runtime pair is refused by the review itself.\n    let context = desk.context();\n    for (kind, action) in denied.iter().filter(|(k, _)| k.gateway().is_none()) {\n        let draft = json!({\"kind\": kind, \"action\": action, \"target\": \"key-1\", \"body\": \"{}\"});\n        let outcome = desk\n            .send(json!({\"kind\": \"reviewChange\", \"context\": context, \"draft\": draft}))\n            .await;\n        match outcome {\n            Err(Refusal::InvalidInput) => {}\n            Err(other) => panic!(\"{kind:?} {action:?}: {other:?}\"),\n            Ok(_) => {\n                assert!(\n                    eventually(|| desk\n                        .snap()\n                        .changes\n                        .review\n                        .is_some_and(|r| r.state == ChangeReviewState::Failed))\n                    .await\n                );\n                let review = desk.snap().changes.review.expect(\"review\");\n                assert_eq!(\n                    review.failure,\n                    Some(ChangeFailure::Problem {\n                        problem: ChangeProblem::Unsupported\n                    }),\n                    \"{kind:?} {action:?}\"\n                );\n                desk.send(json!({\"kind\": \"discardChange\", \"review\": review.review}))\n                    .await\n                    .expect(\"discarded\");\n            }\n        }\n    }\n    assert!(desk.writes().is_empty(), \"nothing was sent\");\n}\n\n/// V2-R03 (I3): the typed name must match what the core expects, and a\n/// review of one tenant cannot apply after a switch to another.\n#[tokio::test(flavor = \"multi_thread\")]\nasync fn confirm_review_refuses_a_wrong_name_and_a_changed_tenant() {\n    let mut desk = desk().await;\n    desk.adapters.confirmer.auto(Some(true));\n    let draft = topic_update(\"Renamed\");\n    let review = desk.review(&draft).await;\n    assert_eq!(review.confirmation.as_deref(), Some(\"Finance\"));\n    assert_eq!(\n        desk.request(&review, &draft, \"finance\").await.err(),\n        Some(Refusal::InvalidInput),\n        \"the typed name must match exactly\"\n    );\n    assert!(desk.writes().is_empty());\n    // Another tenant: the review belongs to the first and is gone.\n    let origin = format!(\"https://localhost:{}\", desk.server.port);\n    desk.send(\n        json!({\"kind\": \"createTenant\", \"profile\": {\"label\": \"Other\", \"tsgId\": TSG,\n        \"destination\": {\"kind\": \"custom\", \"origin\": origin}}}),\n    )\n    .await\n    .expect(\"tenant\");\n    desk.select(\"Other\").await;\n    assert!(desk.snap().changes.review.is_none());\n    assert_eq!(\n        desk.request(&review, &draft, \"Finance\").await.err(),\n        Some(Refusal::ReviewInvalid)\n    );\n    assert!(desk.writes().is_empty());\n}\n\n/// V2-R07 / V2-T07 / V2-T08 (I7): the admitted sequence. An additional key\n/// read back starts the rotation (Issued while its secret is held, Resumed\n/// once it is not), the reminder is a distinct Inbox item on Home and in the\n/// Inbox, the deployment acknowledgement is a local timestamp stored once,\n/// the old key's delete read back absent completes it with the removal\n/// time, and both timestamps survive reads, a switch round trip and a\n/// relaunch.\n#[tokio::test(flavor = \"multi_thread\")]\nasync fn a_rotation_is_the_admitted_sequence_with_its_reminder_and_two_timestamps() {\n    let mut desk = desk().await;\n    desk.adapters.confirmer.auto(Some(true));\n    let draft = key_version(\"key-1\", \"Support bot\", \"Support key 2\");\n    let review = desk.review(&draft).await;\n    assert_eq!(review.confirmation.as_deref(), Some(\"CREATE\"));\n    desk.request(&review, &draft, \"CREATE\")\n        .await\n        .expect(\"requested\");\n    let issued = desk.settled().await;\n    assert_eq!(issued.outcome, Some(Outcome::Completed));\n    assert_eq!(issued.secret, SecretState::Held);\n    let snap = desk.snap();\n    let rotation = rotation_of(&snap, \"Support bot\").expect(\"rotation\");\n    assert_eq!(rotation.stage, desktop_core::RotationStage::Issued);\n    assert_eq!(rotation.old_key.id, \"key-1\");\n    assert_eq!(rotation.old_key.name, \"Support key\");\n    assert_eq!(\n        rotation.new_key.as_ref().map(|k| k.name.as_str()),\n        Some(\"Support key 2\")\n    );\n    assert_eq!(\n        rotation.issued_by.as_deref(),\n        Some(issued.operation.as_str())\n    );\n    assert_eq!(rotation.deployment_acknowledged_at, None);\n    assert_eq!(rotation.old_key_removed_at, None);\n    let item = reminder(&snap, \"Support bot\").expect(\"reminder\");\n    assert!(item.needs_action);\n    assert_eq!(item.kind, InboxKind::Rotation);\n    assert_eq!(item.action_label.as_deref(), Some(\"Finish rotation…\"));\n    assert_eq!(\n        item.target.as_ref().and_then(|t| t.item.clone()).as_deref(),\n        Some(\"Support key\")\n    );\n    assert!(\n        snap.overview\n            .attention\n            .iter()\n            .any(|i| i.id == \"rotation-Support bot\"),\n        \"on Home too\"\n    );\n    // The secret cleared: resumed, nothing to reveal.\n    desk.send(json!({\"kind\": \"forgetSecret\", \"operation\": issued.operation}))\n        .await\n        .expect(\"forgotten\");\n    let rotation = rotation_of(&desk.snap(), \"Support bot\").expect(\"rotation\");\n    assert_eq!(rotation.stage, desktop_core::RotationStage::Resumed);\n    assert_eq!(rotation.issued_by, None);\n    // The operator's local statement, timestamped once.\n    let context = desk.context();\n    desk.send(\n        json!({\"kind\": \"acknowledgeDeployment\", \"context\": context, \"application\": \"Support bot\"}),\n    )\n    .await\n    .expect(\"acknowledged\");\n    let rotation = rotation_of(&desk.snap(), \"Support bot\").expect(\"rotation\");\n    assert_eq!(rotation.stage, desktop_core::RotationStage::Acknowledged);\n    let acknowledged_at = rotation.deployment_acknowledged_at.expect(\"acknowledged\");\n    desk._core.advance_clock(120);\n    desk.send(\n        json!({\"kind\": \"acknowledgeDeployment\", \"context\": context, \"application\": \"Support bot\"}),\n    )\n    .await\n    .expect(\"acknowledged again\");\n    assert_eq!(\n        rotation_of(&desk.snap(), \"Support bot\")\n            .expect(\"rotation\")\n            .deployment_acknowledged_at,\n        Some(acknowledged_at),\n        \"stored once\"\n    );\n    // A read changes nothing of it.\n    read_keys(&mut desk).await;\n    assert_eq!(\n        rotation_of(&desk.snap(), \"Support bot\")\n            .expect(\"rotation\")\n            .deployment_acknowledged_at,\n        Some(acknowledged_at)\n    );\n    // Old key removed and read back absent: complete, with the readback time.\n    let delete = key_delete(\"key-1\");\n    let review = desk.review(&delete).await;\n    assert_eq!(review.confirmation.as_deref(), Some(\"Support key\"));\n    desk.request(&review, &delete, \"Support key\")\n        .await\n        .expect(\"requested\");\n    let removed = desk.settled().await;\n    assert_eq!(\n        (removed.outcome, removed.readback),\n        (Some(Outcome::Completed), Some(Readback::Absent))\n    );\n    let snap = desk.snap();\n    let rotation = rotation_of(&snap, \"Support bot\").expect(\"rotation\");\n    assert_eq!(rotation.stage, desktop_core::RotationStage::Complete);\n    let removed_at = rotation.old_key_removed_at.expect(\"removed at\");\n    assert!(removed_at >= acknowledged_at + 120);\n    assert!(\n        reminder(&snap, \"Support bot\").is_none(),\n        \"the reminder clears\"\n    );\n    assert!(\n        !snap\n            .overview\n            .attention\n            .iter()\n            .any(|i| i.id.starts_with(\"rotation-\"))\n    );\n    // Stable across a switch round trip.\n    let origin = format!(\"https://localhost:{}\", desk.server.port);\n    desk.send(\n        json!({\"kind\": \"createTenant\", \"profile\": {\"label\": \"Other\", \"tsgId\": TSG,\n        \"destination\": {\"kind\": \"custom\", \"origin\": origin}}}),\n    )\n    .await\n    .expect(\"tenant\");\n    desk.select(\"Other\").await;\n    assert!(\n        desk.snap().rotations.is_empty(),\n        \"another tenant's rotation is not shown\"\n    );\n    desk.select(\"Tenant A\").await;\n    let rotation = rotation_of(&desk.snap(), \"Support bot\").expect(\"rotation\");\n    assert_eq!(\n        (\n            rotation.deployment_acknowledged_at,\n            rotation.old_key_removed_at\n        ),\n        (Some(acknowledged_at), Some(removed_at))\n    );\n    // And a relaunch from the saved state.\n    let saved = desk.adapters.store.saved().expect(\"saved\");\n    assert!(\n        !format!(\"{saved:?}\").contains(ONE_TIME),\n        \"no secret persisted\"\n    );\n    let (mut adapters, _handles) =\n        fixtures::adapters_with(fixtures::ScriptedStore::with_state(saved));\n    adapters.keychain = desk.adapters.vault.clone();\n    let restarted = Core::new(\n        CoreConfig {\n            management: ManagementEndpoints::at_origin(&origin),\n            ..CoreConfig::default()\n        },\n        adapters,\n    );\n    restarted.start();\n    tokio::time::sleep(Duration::from_millis(500)).await;\n    let Observation::Shell { snapshot, .. } = restarted\n        .operator()\n        .observe(ViewScope::Shell)\n        .expect(\"observe\")\n    else {\n        unreachable!(\"shell scope\")\n    };\n    let rotation = rotation_of(&snapshot, \"Support bot\").expect(\"persisted rotation\");\n    assert_eq!(rotation.stage, desktop_core::RotationStage::Complete);\n    assert_eq!(\n        (\n            rotation.deployment_acknowledged_at,\n            rotation.old_key_removed_at\n        ),\n        (Some(acknowledged_at), Some(removed_at))\n    );\n}\n\n/// V2-R07 (a), (b): a failed issuance records nothing and reissues nothing;\n/// an unknown issuance is a rotation with no key confirmed and no reminder\n/// until the key inventory shows the application's new key.\n#[tokio::test(flavor = \"multi_thread\")]\nasync fn a_failed_or_unknown_issuance_claims_nothing_until_a_key_is_read_back() {\nasync fn a_failed_or_unknown_issuance_claims_nothing_until_a_key_is_read_back() {\n    let mut desk = desk().await;\n    desk.adapters.confirmer.auto(Some(true));\n    desk.service.lock().expect(\"service\").overrides.push((\n        \"POST\".into(),\n        \"/aisec/v1/mgmt/apikey\".into(),\n        raw(403, &json!({\"message\": \"SERVER-TEXT\"})),\n    ));\n    let draft = key_version(\"key-1\", \"Support bot\", \"Support key 2\");\n    let review = desk.review(&draft).await;\n    desk.request(&review, &draft, \"CREATE\")\n        .await\n        .expect(\"requested\");\n    let failed = desk.settled().await;\n    assert_eq!(failed.outcome, Some(Outcome::Rejected));\n    let snap = desk.snap();\n    assert!(snap.rotations.is_empty(), \"nothing issued, nothing kept\");\n    assert!(reminder(&snap, \"Support bot\").is_none());\n    assert_eq!(desk.writes().len(), 1, \"never reissued\");\n    // Unknown: the connection closed after the write was sent.\n    desk.service.lock().expect(\"service\").overrides.push((\n        \"POST\".into(),\n        \"/aisec/v1/mgmt/apikey\".into(),\n        Reply::Close,\n    ));\n    let review = desk.review(&draft).await;\n    desk.request(&review, &draft, \"CREATE\")\n        .await\n        .expect(\"requested\");\n    let unknown = desk.settled().await;\n    assert_eq!(unknown.outcome, Some(Outcome::Unknown));\n    let snap = desk.snap();\n    let rotation = rotation_of(&snap, \"Support bot\").expect(\"unconfirmed rotation\");\n    assert_eq!(\n        rotation.stage,\n        desktop_core::RotationStage::IssuanceUnconfirmed\n    );\n    assert_eq!(rotation.new_key, None);\n    assert!(\n        reminder(&snap, \"Support bot\").is_none(),\n        \"no reminder until a key is read back\"\n    );\n    assert_eq!(desk.writes().len(), 2, \"never reissued\");\n    // Another key of the application says nothing about this issuance.\n    desk.service.lock().expect(\"service\").keys.push(json!({\n        \"api_key_id\": \"key-8\", \"api_key_name\": \"Support key 8\", \"cust_app\": \"Support bot\",\n        \"api_key_last8\": \"yyyy8888\", \"expiration\": \"2027-01-01T00:00:00Z\", \"revoked\": false, \"auth_code\": \"STORED-CODE\"}));\n    read_keys(&mut desk).await;\n    let rotation = rotation_of(&desk.snap(), \"Support bot\").expect(\"rotation\");\n    assert_eq!(\n        rotation.stage,\n        desktop_core::RotationStage::IssuanceUnconfirmed,\n        \"only the reviewed key name confirms\"\n    );\n    assert!(reminder(&desk.snap(), \"Support bot\").is_none());\n    // Reconciliation: the inventory shows the key the review named.\n    desk.service.lock().expect(\"service\").keys.push(json!({\n        \"api_key_id\": \"key-9\", \"api_key_name\": \"Support key 2\", \"cust_app\": \"Support bot\",\n        \"api_key_last8\": \"zzzz9999\", \"expiration\": \"2027-01-01T00:00:00Z\", \"revoked\": false, \"auth_code\": \"STORED-CODE\"}));\n    read_keys(&mut desk).await;\n    let snap = desk.snap();\n    let rotation = rotation_of(&snap, \"Support bot\").expect(\"rotation\");\n    assert_eq!(\n        rotation.stage,\n        desktop_core::RotationStage::Resumed,\n        \"{rotation:?}\"\n    );\n    assert_eq!(\n        rotation.new_key.as_ref().map(|k| k.id.as_str()),\n        Some(\"key-9\")\n    );\n    assert!(reminder(&snap, \"Support bot\").is_some());\n}\n\n/// V2-R07 (c), (d): a rejected removal keeps the reminder, the old key and\n/// the stage, with the reason and no completion time; an unknown removal\n/// is reconciled by a complete inventory read without the old key.\n#[tokio::test(flavor = \"multi_thread\")]\nasync fn a_rejected_or_unknown_removal_keeps_the_reminder_until_the_key_is_read_back_gone() {\n    let mut desk = desk().await;\n    desk.adapters.confirmer.auto(Some(true));\n    let draft = key_version(\"key-1\", \"Support bot\", \"Support key 2\");\n    let review = desk.review(&draft).await;\n    desk.request(&review, &draft, \"CREATE\")\n        .await\n        .expect(\"requested\");\n    desk.settled().await;\n    let context = desk.context();\n    desk.send(\n        json!({\"kind\": \"acknowledgeDeployment\", \"context\": context, \"application\": \"Support bot\"}),\n    )\n    .await\n    .expect(\"acknowledged\");\n    // Rejected delete.\n    desk.service.lock().expect(\"service\").overrides.push((\n        \"DELETE\".into(),\n        \"/aisec/v1/mgmt/apikey/delete/\".into(),\n        raw(409, &json!({\"message\": \"SERVER-TEXT\"})),\n    ));\n    let delete = key_delete(\"key-1\");\n    let review = desk.review(&delete).await;\n    desk.request(&review, &delete, \"Support key\")\n        .await\n        .expect(\"requested\");\n    let rejected = desk.settled().await;\n    assert_eq!(rejected.outcome, Some(Outcome::Rejected));\n    let snap = desk.snap();\n    let rotation = rotation_of(&snap, \"Support bot\").expect(\"rotation\");\n    assert_eq!(\n        rotation.stage,\n        desktop_core::RotationStage::Acknowledged,\n        \"{rotation:?}\"\n    );\n    assert!(rotation.removal_rejected.is_some());\n    assert_eq!(rotation.old_key_removed_at, None);\n    assert!(reminder(&snap, \"Support bot\").is_some());\n    assert!(\n        desk.service\n            .lock()\n            .expect(\"service\")\n            .keys\n            .iter()\n            .any(|k| k[\"api_key_id\"] == \"key-1\"),\n        \"the old key stays\"\n    );\n    // Unknown delete: the connection closed.\n    desk.service.lock().expect(\"service\").overrides.push((\n        \"DELETE\".into(),\n        \"/aisec/v1/mgmt/apikey/delete/\".into(),\n        Reply::Close,\n    ));\n    let review = desk.review(&delete).await;\n    desk.request(&review, &delete, \"Support key\")\n        .await\n        .expect(\"requested\");\n    let unknown = desk.settled().await;\n    assert_eq!(unknown.outcome, Some(Outcome::Unknown));\n    let snap = desk.snap();\n    let rotation = rotation_of(&snap, \"Support bot\").expect(\"rotation\");\n    assert_eq!(\n        rotation.stage,\n        desktop_core::RotationStage::RemovalUnconfirmed\n    );\n    assert_eq!(rotation.old_key_removed_at, None);\n    assert!(\n        reminder(&snap, \"Support bot\").is_some(),\n        \"retained until reconciled\"\n    );\n    // A final page that is not the first establishes nothing.\n    desk.service\n        .lock()\n        .expect(\"service\")\n        .keys\n        .retain(|k| k[\"api_key_id\"] != \"key-1\");\n    read_keys_at(&mut desk, 1).await;\n    let rotation = rotation_of(&desk.snap(), \"Support bot\").expect(\"rotation\");\n    assert_eq!(\n        rotation.stage,\n        desktop_core::RotationStage::RemovalUnconfirmed,\n        \"absence needs the whole inventory in one read\"\n    );\n    // Reconciliation by a whole inventory read without the old key.\n    read_keys(&mut desk).await;\n    let snap = desk.snap();\n    let rotation = rotation_of(&snap, \"Support bot\").expect(\"rotation\");\n    assert_eq!(rotation.stage, desktop_core::RotationStage::Complete);\n    assert!(rotation.old_key_removed_at.is_some());\n    assert!(reminder(&snap, \"Support bot\").is_none());\n}\n\n/// V2-R06 (I6): a held one-time key is dropped by a tenant switch (the\n/// context retires with its results): the rotation resumes without a secret,\n/// Reveal refuses, and coming back revives nothing.\n#[tokio::test(flavor = \"multi_thread\")]\nasync fn a_held_secret_is_dropped_by_a_tenant_switch_and_never_revived() {\n    let mut desk = desk().await;\n    desk.adapters.confirmer.auto(Some(true));\n    let draft = key_version(\"key-1\", \"Support bot\", \"Support key 2\");\n    let review = desk.review(&draft).await;\n    desk.request(&review, &draft, \"CREATE\")\n        .await\n        .expect(\"requested\");\n    let issued = desk.settled().await;\n    assert_eq!(issued.secret, SecretState::Held);\n    assert_eq!(\n        rotation_of(&desk.snap(), \"Support bot\")\n            .expect(\"rotation\")\n            .stage,\n        desktop_core::RotationStage::Issued\n    );\n    let origin = format!(\"https://localhost:{}\", desk.server.port);\n    desk.send(\n        json!({\"kind\": \"createTenant\", \"profile\": {\"label\": \"Other\", \"tsgId\": TSG,\n        \"destination\": {\"kind\": \"custom\", \"origin\": origin}}}),\n    )\n    .await\n    .expect(\"tenant\");\n    desk.select(\"Other\").await;\n    assert!(\n        desk.snap().changes.results.is_empty(),\n        \"another context's results are not shown\"\n    );\n    desk.select(\"Tenant A\").await;\n    let snap = desk.snap();\n    assert!(\n        snap.changes.results.is_empty(),\n        \"the retired context's results are gone\"\n    );\n    let rotation = rotation_of(&snap, \"Support bot\").expect(\"rotation\");\n    assert_eq!(rotation.stage, desktop_core::RotationStage::Resumed);\n    assert_eq!(rotation.issued_by, None);\n    assert_eq!(\n        desk.send(json!({\"kind\": \"revealSecret\", \"operation\": issued.operation}))\n            .await\n            .err(),\n        Some(Refusal::InvalidInput)\n    );\n    assert!(desk.adapters.secrets.shown().is_empty());\n}\n\n/// The one-time key a version returns, as the service sends it.\nfn issued_key(id: &str, name: &str, secret: &str) -> Value {\n    json!({\"api_key_id\": id, \"api_key_name\": name, \"cust_app\": \"Support bot\",\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_40","type":"command_execution","command":"/bin/zsh -lc \"cat apps/desktop/src/v2/admin/administration.tsx; sed -n '1,190p' apps/desktop/src/v2/admin/inventory-table.tsx\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_40","type":"command_execution","command":"/bin/zsh -lc \"cat apps/desktop/src/v2/admin/administration.tsx; sed -n '1,190p' apps/desktop/src/v2/admin/inventory-table.tsx\"","aggregated_output":"import { forwardRef, type ReactNode, useCallback, useEffect, useRef, useState } from 'react'\nimport { createPortal } from 'react-dom'\nimport type { AdminProduct, AdminTab, DesktopClient, FeatureId, ManagementResource, ProductReadState, ShellSnapshot } from '@prisma-airs/desktop-contracts'\nimport { CHANGE_NOUN, type ChangeTarget, verbOf } from '../../features/administration/runtime-changes'\nimport type { Dispatch } from '../../features/tenants/dispatch'\nimport type { Act } from '../inbox/inbox'\nimport { type Arrival, useShellStore } from '../store'\nimport { SHELL_COPY } from '../copy'\nimport { Verdict } from '../verdict'\nimport { ADMIN_COPY as C } from './copy'\nimport { ReviewSheet } from './review-sheet'\nimport { InventoryTable } from './inventory-table'\nimport { Playground } from './playground'\nimport { type PillTone, ProductCard } from './product-card'\nimport { RuntimeOverview } from './runtime-overview'\nimport { GatewayProduct, type GatewayTabId } from './gateway-tabs'\nimport { ObservationProduct } from './observation-tabs'\nimport type { GlyphName } from '../icons'\nimport { Btn } from '../controls'\n\nexport interface AdministrationProps {\n    snapshot: ShellSnapshot\n    dispatch: Dispatch\n    client: DesktopClient\n    onAct: Act\n    onNavigate: (feature: FeatureId) => void\n    arrival: Arrival | null\n}\n\nconst DLP: ManagementResource[] = ['dataPatterns', 'dictionaries', 'dataProfiles', 'filteringProfiles', 'dlpCatalog']\nconst DLP_LABEL: Record<string, string> = {\n    dataPatterns: 'Data patterns',\n    dictionaries: 'Dictionaries',\n    dataProfiles: 'Data profiles',\n    filteringProfiles: 'Data filtering profiles',\n    dlpCatalog: 'DLP profiles (AIRS)',\n}\nconst DLP_KIND: Partial<Record<ManagementResource, string>> = {\n    dataPatterns: 'dataPatterns',\n    dictionaries: 'dictionaries',\n    dataProfiles: 'dataProfiles',\n    filteringProfiles: 'filteringProfiles',\n}\ninterface Sheet {\n    change: ChangeTarget | null\n    rotation: string | null\n    onDraft?: (body: string) => void\n    note?: ReactNode\n}\n\n/**\n * Administration (C31, screens/reviews-administration.md): the accordion of\n * the products in `AdminInventory`, each tab rendered by its disposition.\n * Read and Change tabs render the retained views (the same reads and\n * reviewed changes), with the inventory's labels for exactly its actions;\n * Unavailable tabs and products show their gate and nothing else; Removed\n * tabs are not rendered. Every change opens the review sheet; a key rotation\n * follows the core's staged sequence there.\n */\nexport const Administration = forwardRef<HTMLHeadingElement, AdministrationProps>(function Administration(\n    { snapshot, dispatch, client, onAct, onNavigate, arrival },\n    ref\n) {\n    const tenant = snapshot.tenants.find((t) => t.id === snapshot.active?.tenant) ?? null\n    const context = snapshot.active?.context ?? null\n    const products = snapshot.administration?.products ?? []\n    const [open, setOpen] = useState<Record<string, boolean>>({\n        runtimeSecurity: true,\n    })\n    const [tabOf, setTabOf] = useState<Record<string, string>>({\n        runtimeSecurity: 'custom-topics',\n        gateway: 'routes',\n        redTeam: 'scans',\n        modelSkill: 'skill-scans',\n    })\n    const [dlp, setDlp] = useState<ManagementResource>('dataPatterns')\n    const [sheet, setSheet] = useState<Sheet | null>(null)\n    const observe = useCallback((operation: string) => client.observeManagement(operation), [client])\n\n    // A Harness proposal the operator opened into a review (C21) arrives\n    // here: the sheet shows its exact draft under the native review, on the\n    // product and tab of its kind; typed confirmation and native approval\n    // still apply, and leaving the sheet discards the review.\n    const review = snapshot.changes.review\n    const proposed = snapshot.harness.conversation?.proposals.find((p) => p.state === 'inReview' && review !== null && p.review === review.review) ?? null\n    const shownProposal = useRef<string | null>(null)\n    useEffect(() => {\n        if (!proposed || shownProposal.current === proposed.review) return\n        shownProposal.current = proposed.review\n        const d = proposed.draft\n        for (const p of products) {\n            const t = p.tabs.find((x) => x.disposition.kind === 'change' && x.actions.some((a) => a.kind === d.kind))\n            if (!t) continue\n            setOpen((o) => ({ ...o, [p.id]: true }))\n            setTabOf((s) => ({ ...s, [p.id]: t.id }))\n            if (DLP.includes(d.kind as ManagementResource)) setDlp(d.kind as ManagementResource)\n            break\n        }\n        setSheet({\n            change: {\n                kind: d.kind,\n                action: d.action,\n                target: d.target,\n                title: `Proposed by the Harness: ${verbOf(d.kind, d.action).toLowerCase()} ${CHANGE_NOUN[d.kind]}${d.target ? ` ${d.target}` : ''}`,\n                body: d.body,\n            },\n            rotation: null,\n        })\n        // eslint-disable-next-line react-hooks/exhaustive-deps -- once per opened proposal review\n    }, [proposed])\n\n    // A Runtime case opened in the Playground from Test Cases (C33): Runtime\n    // Security's Playground tab, filled with the case.\n    const playground = useShellStore((s) => s.playground)\n    useEffect(() => {\n        if (!playground || playground.tenant !== tenant?.id) return\n        const tab = products.find((p) => p.id === 'runtimeSecurity')?.tabs.find((t) => t.label === 'Playground')\n        if (!tab) return\n        setOpen((o) => ({ ...o, runtimeSecurity: true }))\n        setTabOf((s) => ({ ...s, runtimeSecurity: tab.id }))\n        // eslint-disable-next-line react-hooks/exhaustive-deps -- once per handed case\n    }, [playground?.prefill.nonce, products.length])\n\n    // An arrival is consumed once, when its target is in the inventory (C35 attempt-02 R1):\n    // a fresh snapshot never re-applies it over what the operator chose since. The rail's\n    // product children and the tenant menu's \"Change Gateway workspace…\" name a product\n    // (and a tab); a contextual action (Inbox, Home) names a Runtime inventory (C30).\n    const consumedArrival = useRef<number | null>(null)\n    useEffect(() => {\n        if (!arrival || consumedArrival.current === arrival.sequence) return\n        if (arrival.product) {\n            const product = products.find((p) => p.id === arrival.product)\n            if (!product) return\n            consumedArrival.current = arrival.sequence\n            setOpen((o) => ({ ...o, [product.id]: true }))\n            const tab = arrival.tab ? product.tabs.find((t) => t.id === arrival.tab && t.disposition.kind !== 'removed') : undefined\n            if (tab) setTabOf((s) => ({ ...s, [product.id]: tab.id }))\n            return\n        }\n        if (!arrival.resource) {\n            consumedArrival.current = arrival.sequence\n            return\n        }\n        const resource = arrival.resource\n        const runtime = products.find((p) => p.id === 'runtimeSecurity')\n        const tab = runtime?.tabs.find((t) => t.resource === resource) ?? (DLP.includes(resource) ? runtime?.tabs.find((t) => t.label === 'DLP') : undefined)\n        if (!tab) return\n        consumedArrival.current = arrival.sequence\n        setOpen((o) => ({ ...o, runtimeSecurity: true }))\n        setTabOf((s) => ({ ...s, runtimeSecurity: tab.id }))\n        if (DLP.includes(resource)) setDlp(resource)\n    }, [arrival, products])\n\n    if (!tenant || !context) {\n        return (\n            <section aria-labelledby='administration-heading' data-slot='administration-v2'>\n                <h1 ref={ref} id='administration-heading' tabIndex={-1} className='font-bold' style={{ fontSize: 'var(--v2-title)' }}>\n                    {C.title}\n                </h1>\n                <p className='mt-2 text-[13px]'>{C.noTenant}</p>\n            </section>\n        )\n    }\n\n    const labelsOf = (tab: AdminTab, kind?: string) =>\n        Object.fromEntries(tab.actions.filter((a) => !kind || a.kind === kind).map((a) => [a.action, a.label])) as Partial<Record<ChangeTarget['action'], string>>\n\n    function body(product: AdminProduct, tab: AdminTab) {\n        if (tab.disposition.kind === 'unavailable') {\n            return (\n                <div data-slot='admin-unavailable' className='rounded-[12px] border p-4 text-[13px]' style={{ borderColor: 'var(--v2-rule)' }}>\n                    <Verdict tone='info' word={C.unavailableTab} />\n                    <p className='mt-2' style={{ color: 'var(--v2-soft)' }}>\n                        {tab.disposition.reason}\n                    </p>\n                </div>\n            )\n        }\n        const key = `${context}-${product.id}-${tab.id}`\n        if (product.id === 'runtimeSecurity') {\n            if (tab.label === 'Overview')\n                return (\n                    <RuntimeOverview\n                        snapshot={snapshot}\n                        onRead={() =>\n                            void onAct(SHELL_COPY.readOf(tenant!.label), {\n                                kind: 'readTenant',\n                                context: context!,\n                            })\n                        }\n                    />\n                )\n            if (tab.label === 'Playground') {\n                // A case handed over from Test Cases fills the form (C33); the operator runs it.\n                const handed = playground && playground.tenant === tenant!.id ? playground : null\n                return <Playground key={key} snapshot={snapshot} dispatch={dispatch} onNavigate={onNavigate} prefill={handed?.prefill ?? null} caseId={handed?.caseId ?? null} />\n            }\n            const resource = (tab.label === 'DLP' ? dlp : tab.resource) as ManagementResource | null\n            if (!resource) return null\n            return (\n                <div className='flex flex-col gap-3'>\n                    {tab.label === 'DLP' ? (\n                        <div role='radiogroup' aria-label={C.dlpResources} className='flex flex-wrap rounded-[8px] self-start' style={{ gap: 2, padding: 2, background: 'var(--v2-inset)' }} data-slot='dlp-resources'>\n                            {DLP.map((r) => (\n                                <button\n                                    key={r}\n                                    type='button'\n                                    role='radio'\n                                    aria-checked={dlp === r}\n                                    onClick={() => setDlp(r)}\n                                    className='h-7 min-h-0 rounded-[6px] px-3 text-[12px] font-semibold'\n                                    style={{\n                                        background: dlp === r ? 'var(--v2-paper)' : 'transparent',\n                                        boxShadow: dlp === r ? '0 1px 2px rgba(0,0,0,0.12)' : 'none',\n                                        color: 'var(--v2-ink)',\n                                    }}\n                                >\n                                    {DLP_LABEL[r]}\n                                </button>\n                            ))}\n                        </div>\n                    ) : null}\n                    <InventoryTable\n                        key={`${key}-${resource}`}\n                        snapshot={snapshot}\n                        context={context!}\n                        dispatch={dispatch}\n                        observe={observe}\n                        resource={resource}\n                        arrival={arrival && arrival.resource === resource ? arrival : null}\n                        labels={labelsOf(tab, tab.label === 'DLP' ? DLP_KIND[resource] : undefined)}\n                        admitted={tab.actions}\n                        onReview={(change) => setSheet({ change, rotation: null })}\n                        rotations={snapshot.rotations}\n                        onFinishRotation={(application) => setSheet({ change: null, rotation: application })}\n                    />\n                </div>\n            )\n        }\n        if (product.id === 'gateway') {\n            return (\n                <GatewayProduct\n                    key={`${context}-gateway`}\n                    snapshot={snapshot}\n                    context={context!}\n                    dispatch={dispatch}\n                    observe={observe}\n                    onNavigate={onNavigate}\n                    tab={tab.id as GatewayTabId}\n                    actions={tab.actions}\n                    onReview={(change, extras) => setSheet({ change, rotation: null, ...extras })}\n                    onRead={() => void onAct(SHELL_COPY.readOf(tenant!.label), { kind: 'readTenant', context: context! })}\n                />\n            )\n        }\n        return <ObservationProduct key={`${context}-${product.id}`} snapshot={snapshot} context={context!} dispatch={dispatch} observe={observe} product={product.id as 'redTeam' | 'modelSkill'} tab={tab.id} />\n    }\n\n    const PILL_WORD: Record<ProductReadState | 'unavailable', { tone: PillTone; glyph: GlyphName }> = {\n        ok: { tone: 'ok', glyph: 'check' },\n        incomplete: { tone: 'flag', glyph: 'alert' },\n        needsRole: { tone: 'flag', glyph: 'alert' },\n        failed: { tone: 'flag', glyph: 'alert' },\n        pending: { tone: 'faint', glyph: 'clock' },\n        notRead: { tone: 'faint', glyph: 'clock' },\n        unavailable: { tone: 'faint', glyph: 'ban' },\n    }\n    const reads = snapshot.inbox.read.products\n    const overview = snapshot.overview.read\n    const chrome = (product: AdminProduct) => {\n        const read = reads.find((r) => r.product === product.id)\n        const state: ProductReadState | 'unavailable' = product.availability.state === 'unavailable' ? 'unavailable' : (read?.state ?? 'notRead')\n        const alerts = snapshot.inbox.items.filter((e) => e.product === product.id && e.needsAction && e.hold === null).length\n        const value =\n            product.id === 'runtimeSecurity'\n                ? overview?.summary.detectionEvents ?? null\n                : product.id === 'gateway'\n                  ? overview?.gateway?.requests ?? null\n                  : null\n        return {\n            pill: { word: C.status[state] ?? state, ...PILL_WORD[state] },\n            stat: { value: value === null ? '—' : value.toLocaleString(), label: C.stat[product.id] ?? '', hot: product.id === 'runtimeSecurity' && value !== null && value > 0 },\n            alerts,\n        }\n    }\n    const available = products.filter((p) => p.availability.state === 'available')\n    const setAll = (value: boolean) => setOpen(Object.fromEntries(available.map((p) => [p.id, value])))\n    return (\n        <section aria-labelledby='administration-heading' data-slot='administration-v2' className='flex min-w-0 flex-col' style={{ gap: 14 }}>\n            <div className='flex flex-wrap items-end' style={{ gap: 12, marginBottom: 4 }}>\n                <div className='min-w-0'>\n                    <h1 ref={ref} id='administration-heading' tabIndex={-1} className='font-bold' style={{ fontSize: 'var(--v2-title)', letterSpacing: '-0.01em' }}>\n                        {C.title}\n                    </h1>\n                    <p className='text-[14px]' style={{ marginTop: 4, color: 'var(--v2-soft)' }} data-slot='admin-sub'>\n                        {C.lead(tenant.label)}\n                    </p>\n                </div>\n                <div className='ml-auto flex shrink-0' style={{ gap: 6 }}>\n                    <Btn onClick={() => setAll(true)}>{C.expandAll}</Btn>\n                    <Btn onClick={() => setAll(false)}>{C.collapseAll}</Btn>\n                </div>\n            </div>\n            <ul className='flex flex-col' style={{ gap: 14 }} data-slot='admin-products'>\n                {products.map((product) => {\n                    const tabs = product.tabs.filter((t) => t.disposition.kind !== 'removed')\n                    const current = tabs.find((t) => t.id === tabOf[product.id]) ?? tabs[0]\n                    const { pill, stat, alerts } = chrome(product)\n                    return (\n                        <ProductCard\n                            key={product.id}\n                            product={product}\n                            open={!!open[product.id]}\n                            onToggle={() => setOpen((o) => ({ ...o, [product.id]: !o[product.id] }))}\n                            stat={stat}\n                            pill={pill}\n                            alerts={alerts}\n                            tabs={tabs}\n                            current={current}\n                            onTab={(id) => setTabOf((s) => ({ ...s, [product.id]: id }))}\n                            note={product.readOnly && current?.label !== 'Overview' ? C.readOnly : null}\n                        >\n                            {current ? body(product, current) : null}\n                        </ProductCard>\n                    )\n                })}\n            </ul>\n            {/* The sheet is the topmost dialog (I8): rendered at the body, outside the page the modal stack hides. */}\n            {sheet\n                ? createPortal(\n                      <ReviewSheet\n                          snapshot={snapshot}\n                          context={context}\n                          dispatch={dispatch}\n                          observe={observe}\n                          change={sheet.change}\n                          rotation={sheet.rotation}\n                          onDraft={sheet.onDraft}\n                          note={sheet.note}\n                          onClose={() => setSheet(null)}\n                      />,\n                      document.body\n                  )\n                : null}\n        </section>\n    )\n})\nimport { useEffect, useId, useRef, useState } from 'react'\nimport type { AdminAction, ContextRef, ManagementDetail, ManagementPage, ManagementResource, RotationView, ShellSnapshot } from '@prisma-airs/desktop-contracts'\nimport { MANAGEMENT_FAILURE_TEXT, type ObserveManagement, RESOURCES, type ResourceInfo, fieldText, itemId, itemName, readManagement } from '../../features/administration/management-read'\nimport { type ChangeTarget, TEMPLATES, pretty } from '../../features/administration/runtime-changes'\nimport type { Dispatch } from '../../features/tenants/dispatch'\nimport { Glyph } from '../icons'\nimport { Btn } from '../controls'\nimport { ADMIN_COPY as C } from './copy'\n\n/** Rows per page (the native side accepts 1..=100). */\nexport const PAGE_SIZE = 25\n\ntype Item = Record<string, unknown>\n\ninterface Shown {\n    page: ManagementPage\n    items: Item[]\n    readAt: Date\n}\n\ntype DetailState =\n    | { kind: 'loading'; name: string }\n    | { kind: 'shown'; name: string; detail: ManagementDetail; item: Item | null }\n    | { kind: 'failed'; name: string; message: string }\n\ninterface Props {\n    snapshot: ShellSnapshot\n    context: ContextRef\n    dispatch: Dispatch\n    observe: ObserveManagement\n    resource: ManagementResource\n    /** The inventory and item a contextual action asked for (C30): selected on arrival. */\n    arrival?: { resource: ManagementResource | null; item: string | null; sequence: number } | null\n    /** The tab's admitted actions (`AdminInventory`): only these are offered. */\n    admitted: AdminAction[]\n    labels?: Partial<Record<ChangeTarget['action'], string>>\n    onReview: (change: ChangeTarget) => void\n    rotations: RotationView[]\n    onFinishRotation: (application: string) => void\n}\n\nconst time = (date: Date) => date.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' })\n\nconst CHANGE_KIND: Partial<Record<ManagementResource, ChangeTarget['kind']>> = {\n    profiles: 'profiles',\n    topics: 'topics',\n    applications: 'applications',\n    apiKeys: 'apiKeys',\n    dataPatterns: 'dataPatterns',\n    dataProfiles: 'dataProfiles',\n    filteringProfiles: 'filteringProfiles',\n    dictionaries: 'dictionaries',\n}\n\n/** The changes offered from an inventory's toolbar (v1's templates). */\nconst CREATE: Partial<Record<ManagementResource, ChangeTarget>> = {\n    profiles: { kind: 'profiles', action: 'create', target: '', title: 'New security profile', body: pretty(TEMPLATES.profile) },\n    topics: { kind: 'topics', action: 'create', target: '', title: 'New custom topic', body: pretty(TEMPLATES.topic) },\n    apiKeys: { kind: 'apiKeys', action: 'create', target: '', title: 'Create API key', body: pretty(TEMPLATES.key) },\n    dataPatterns: { kind: 'dataPatterns', action: 'create', target: '', title: 'New data pattern', body: pretty(TEMPLATES.pattern) },\n    dataProfiles: { kind: 'dataProfiles', action: 'create', target: '', title: 'New data profile', body: pretty(TEMPLATES.dataProfile) },\n    dictionaries: { kind: 'dictionaries', action: 'create', target: '', title: 'New dictionary', body: JSON.stringify(TEMPLATES.dictionary) },\n}\n\nconst ACTION_LABEL: Record<ChangeTarget['action'], string> = {\n    create: 'Create…',\n    update: 'Edit…',\n    delete: 'Delete…',\n    version: 'Add key version…',\n    rotate: 'Rotate…',\n    models: 'Models…',\n}\n\n/** The changes v1 offers for one item. */\nfunction itemChanges(info: ResourceInfo, item: Item, name: string): ChangeTarget[] {\n    const kind = CHANGE_KIND[info.id]\n    const id = itemId(info, item)\n    if (!kind || id === null) return []\n    if (kind === 'apiKeys') {\n        return [\n            { kind, action: 'rotate', target: id, title: `Rotate ${name}`, body: pretty(TEMPLATES.rotate) },\n            { kind, action: 'version', target: id, title: `Issue additional key for ${fieldText(item.cust_app)}`, body: pretty({ ...TEMPLATES.key, cust_app: item.cust_app ?? '' }) },\n            { kind, action: 'delete', target: id, title: `Delete ${name}`, body: '{}' },\n        ]\n    }\n    const edit: ChangeTarget = { kind, action: 'update', target: id, title: `Edit ${name}`, body: pretty(item) }\n    const remove: ChangeTarget = { kind, action: 'delete', target: id, title: `Delete ${name}`, body: '{}' }\n    switch (kind) {\n        case 'dictionaries': {\n            const metadata = Object.fromEntries(Object.entries(item).filter(([k]) => k !== 'id'))\n            return [{ ...edit, body: JSON.stringify({ metadata, file: '' }) }, remove]\n        }\n        case 'dataProfiles':\n        case 'filteringProfiles':\n            return [edit]\n        default:\n            return [edit, remove]\n    }\n}\n\n/** A short list for a table cell: the first three names and how many more. */\nfunction listText(names: string[]): string {\n    const shown = names.filter(Boolean)\n    if (shown.length === 0) return '—'\n    return shown.length <= 3 ? shown.join(', ') : `${shown.slice(0, 3).join(', ')} +${shown.length - 3}`\n}\n\n/** The custom topics a security profile's policy names, by one walk of its JSON (C31). */\nexport function topicRefs(profile: Item): { id: string | null; name: string | null }[] {\n    const found = new Map<string, { id: string | null; name: string | null }>()\n    const walk = (value: unknown, depth: number) => {\n        if (depth > 12 || value === null || typeof value !== 'object') return\n        if (Array.isArray(value)) {\n            for (const v of value) walk(v, depth + 1)\n            return\n        }\n        const o = value as Record<string, unknown>\n        const id = typeof o.topic_id === 'string' ? o.topic_id : null\n        const name = typeof o.topic_name === 'string' ? o.topic_name : null\n        if (id || name) found.set(id ?? `name:${name}`, { id, name })\n        for (const v of Object.values(o)) walk(v, depth + 1)\n    }\n    walk(profile.policy ?? profile, 0)\n    return [...found.values()]\n}\n\ninterface TopicRelations {\n    usedBy: (topicId: string | null, topicName: string) => string[]\n    complete: boolean\n    failure: string | null\n}\n\n/** The profile ↔ topic relationship inventory: one read of the profiles (first 100), walked once (C31). */\nfunction useTopicRelations(resource: ManagementResource, shown: Shown | null, context: ContextRef, dispatch: Dispatch, observe: ObserveManagement): TopicRelations | null {\n    const [relations, setRelations] = useState<TopicRelations | null>(null)\n    const readAt = shown?.readAt.getTime() ?? 0\n    useEffect(() => {\n        if (resource !== 'topics') return\n        let live = true\n        void readManagement(dispatch, observe, context, { kind: 'page', resource: 'profiles', offset: 0, limit: 100 }).then((outcome) => {\n            if (!live) return\n            if (outcome.kind === 'notAdmitted' || outcome.result.kind !== 'page') {\n                setRelations({ usedBy: () => [], complete: false, failure: outcome.kind === 'notAdmitted' ? outcome.message : 'failed' })\n                return\n            }\n            const page = outcome.result.page\n            const profiles = JSON.parse(page.items) as Item[]\n            const byId = new Map<string, string[]>()\n            const byName = new Map<string, string[]>()\n            for (const profile of profiles) {\n                const name = typeof profile.profile_name === 'string' ? profile.profile_name : String(profile.profile_id ?? '')\n                for (const t of topicRefs(profile)) {\n                    if (t.id) byId.set(t.id, [...(byId.get(t.id) ?? []), name])\n                    else if (t.name) byName.set(t.name, [...(byName.get(t.name) ?? []), name])\n                }\n            }\n            setRelations({\n                usedBy: (id, topicName) => [...new Set([...(id ? (byId.get(id) ?? []) : []), ...(byName.get(topicName) ?? [])])],\n                complete: page.offset === 0 && page.complete,\n                failure: null,\n            })\n        })\n        return () => {\n            live = false\n        }\n        // eslint-disable-next-line react-hooks/exhaustive-deps -- re-derived with each topics read\n    }, [resource, context, readAt])\n    return relations\n}\n\n/**\n * One management inventory as R2App's table draws it (C39): the search\n * field and the inventory's create action above a role=table grid (name,\n * ID, the inventory's own relation column, a View action per row), the\n * footer with the row count and the read time, paging, and the detail panel\n * with exactly the admitted item actions. Every page and detail is one\n * explicit read through the tenant's management client (C08): nothing is\n * cached across tenants or credential generations, a failed refresh keeps\n * the previous rows marked with their age, and an inventory is called empty\n * or complete only when the service said so.\n */\nexport function InventoryTable({ snapshot, context, dispatch, observe, resource, arrival = null, admitted, labels, onReview, rotations, onFinishRotation }: Props) {\n    const ids = useId()\n    const tenant = snapshot.tenants.find((t) => t.id === snapshot.active?.tenant)\n    const ready = tenant?.management.state === 'ready'\n    const info = RESOURCES.find((r) => r.id === resource) ?? (RESOURCES[0] as ResourceInfo)\n    const [shown, setShown] = useState<Shown | null>(null)\n    const [failure, setFailure] = useState<string | null>(null)\n    const [loading, setLoading] = useState(false)\n    const [filter, setFilter] = useState(arrival?.item ?? '')\n","exit_code":0,"status":"completed"}}
