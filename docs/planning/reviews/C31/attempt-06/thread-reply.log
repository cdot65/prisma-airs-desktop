ion;\n\nuse tokio::sync::oneshot;\n\n/// How long a revealed secret stays on screen.\npub const REVEAL_FOR: Duration = Duration::from_secs(60);\n\n/// Open confirmations by nonce: each resolves exactly once.\n#[derive(Default)]\npub struct Registry {\n    pending: Mutex<HashMap<u64, oneshot::Sender<bool>>>,\n}\n\nimpl Registry {\n    /// Opens confirmation `nonce`; `None` if that nonce is already open.\n    pub fn open(&self, nonce: u64) -> Option<oneshot::Receiver<bool>> {\n        let mut pending = self.pending.lock().ok()?;\n        if pending.contains_key(&nonce) {\n            return None;\n        }\n        let (tx, rx) = oneshot::channel();\n        pending.insert(nonce, tx);\n        Some(rx)\n    }\n\n    /// Resolves `nonce` once; false for an unknown or already resolved one.\n    pub fn complete(&self, nonce: u64, accepted: bool) -> bool {\n        let sender = self.pending.lock().ok().and_then(|mut p| p.remove(&nonce));\n        sender.is_some_and(|tx| tx.send(accepted).is_ok())\n    }\n\n    pub fn open_count(&self) -> usize {\n        self.pending.lock().map(|p| p.len()).unwrap_or(0)\n    }\n}\n\n/// Which reveal owns the one secret sheet. Every reveal takes a new\n/// generation; an older reveal's expiry or completion never ends or\n/// unregisters a newer reveal's sheet.\n#[derive(Debug, Default)]\npub struct SecretOwnership {\n    current: std::sync::atomic::AtomicU64,\n}\n\nimpl SecretOwnership {\n    pub const fn new() -> Self {\n        Self {\n            current: std::sync::atomic::AtomicU64::new(0),\n        }\n    }\n\n    /// A new reveal: it owns the sheet from now on.\n    pub fn begin(&self) -> u64 {\n        self.current\n            .fetch_add(1, std::sync::atomic::Ordering::SeqCst)\n            .wrapping_add(1)\n    }\n\n    /// Whether `generation` is still the sheet's reveal.\n    pub fn owns(&self, generation: u64) -> bool {\n        self.current.load(std::sync::atomic::Ordering::SeqCst) == generation\n    }\n}\n\n/// The receiver side of a confirmation: false if it was dropped.\npub async fn outcome(receiver: Option<oneshot::Receiver<bool>>) -> bool {\n    match receiver {\n        Some(rx) => rx.await.unwrap_or(false),\n        None => false,\n    }\n}\n\n#[cfg(target_os = \"macos\")]\npub use appkit::{NativeConfirmation, NativeSecrets};\n\n#[cfg(target_os = \"macos\")]\nmod appkit {\n    #![allow(unsafe_code)]\n\n    use std::cell::RefCell;\n    use std::collections::HashMap;\n    use std::sync::Arc;\n\n    use block2::RcBlock;\n    use desktop_core::{ConfirmationRequest, OperatorConfirmation, SecretPresenter};\n    use futures_util::future::BoxFuture;\n    use objc2::MainThreadMarker;\n    use objc2::rc::Retained;\n    use objc2_app_kit::{\n        NSAlert, NSAlertFirstButtonReturn, NSAlertStyle, NSModalResponse, NSTextField, NSWindow,\n    };\n    use objc2_foundation::{NSPoint, NSRect, NSSize, NSString};\n    use tauri::{AppHandle, Manager, Runtime};\n    use zeroize::Zeroizing;\n\n    use super::{REVEAL_FOR, Registry, outcome};\n    use crate::MAIN_WINDOW;\n    use crate::clipboard_secret::{AppKitPasteboard, CLEAR_AFTER, ClipboardGuard};\n\n    /// A shown sheet and the window it is attached to.\n    type Shown = (Retained<NSWindow>, Retained<NSWindow>);\n\n    thread_local! {\n        /// Shown sheets by key. Only touched on the main thread.\n        static SHEETS: RefCell<HashMap<u64, Shown>> = RefCell::new(HashMap::new());\n    }\n\n    /// The secret sheet's key in [`SHEETS`] (confirmation nonces are random\n    /// u64s; a collision with this key is not a concern in practice and\n    /// would only end the wrong sheet).\n    const SECRET_SHEET: u64 = u64::MAX;\n\n    fn main_window<R: Runtime>(app: &AppHandle<R>) -> Option<Retained<NSWindow>> {\n        let pointer = app.get_webview_window(MAIN_WINDOW)?.ns_window().ok()?;\n        // SAFETY: Tauri returns the main window's live NSWindow; retaining\n        // it keeps it valid while the sheet uses it.\n        unsafe { Retained::retain(pointer.cast::<NSWindow>()) }\n    }\n\n    fn end_sheet(key: u64) {\n        let shown = SHEETS.with(|s| s.borrow_mut().remove(&key));\n        if let Some((parent, sheet)) = shown {\n            parent.endSheet(&sheet);\n        }\n    }\n\n    /// The native operator confirmation for the main window.\n    pub struct NativeConfirmation<R: Runtime> {\n        pub app: AppHandle<R>,\n        pub registry: Arc<Registry>,\n    }\n\n    impl<R: Runtime> OperatorConfirmation for NativeConfirmation<R> {\n        fn confirm(&self, nonce: u64, request: ConfirmationRequest) -> BoxFuture<'static, bool> {\n            let receiver = self.registry.open(nonce);\n            if receiver.is_some() {\n                let registry = Arc::clone(&self.registry);\n                let app = self.app.clone();\n                let presented = self.app.run_on_main_thread(move || {\n                    if !present(&app, nonce, &request, &registry) {\n                        registry.complete(nonce, false);\n                    }\n                });\n                if presented.is_err() {\n                    self.registry.complete(nonce, false);\n                }\n            }\n            Box::pin(outcome(receiver))\n        }\n\n        fn dismiss(&self, nonce: u64) {\n            self.registry.complete(nonce, false);\n            let _ = self.app.run_on_main_thread(move || end_sheet(nonce));\n        }\n    }\n\n    fn present<R: Runtime>(\n        app: &AppHandle<R>,\n        nonce: u64,\n        request: &ConfirmationRequest,\n        registry: &Arc<Registry>,\n    ) -> bool {\n        let Some(mtm) = MainThreadMarker::new() else {\n            return false;\n        };\n        let Some(window) = main_window(app) else {\n            return false;\n        };\n        let alert = NSAlert::new(mtm);\n        alert.setMessageText(&NSString::from_str(&request.title));\n        alert.setInformativeText(&NSString::from_str(&request.message));\n        let confirm = alert.addButtonWithTitle(&NSString::from_str(&request.confirm_label));\n        let cancel = alert.addButtonWithTitle(&NSString::from_str(\"Cancel\"));\n        if request.destructive {\n            alert.setAlertStyle(NSAlertStyle::Critical);\n            confirm.setHasDestructiveAction(true);\n            // Return cancels a destructive change; it must be chosen.\n            confirm.setKeyEquivalent(&NSString::from_str(\"\"));\n            cancel.setKeyEquivalent(&NSString::from_str(\"\\r\"));\n        }\n        let registry = Arc::clone(registry);\n        let handler = RcBlock::new(move |response: NSModalResponse| {\n            registry.complete(nonce, response == NSAlertFirstButtonReturn);\n            SHEETS.with(|s| s.borrow_mut().remove(&nonce));\n        });\n        alert.beginSheetModalForWindow_completionHandler(&window, Some(&handler));\n        SHEETS.with(|s| s.borrow_mut().insert(nonce, (window, alert.window())));\n        true\n    }\n\n    /// The transient one-time secret sheet for the main window.\n    pub struct NativeSecrets<R: Runtime> {\n        pub app: AppHandle<R>,\n    }\n\n    /// The secret sheet's current reveal.\n    static SECRET_OWNER: super::SecretOwnership = super::SecretOwnership::new();\n\n    impl<R: Runtime> SecretPresenter for NativeSecrets<R> {\n        fn reveal(&self, label: String, secret: Zeroizing<String>) {\n            let app = self.app.clone();\n            let _ = self\n                .app\n                .run_on_main_thread(move || reveal(&app, &label, secret));\n        }\n\n        fn dismiss(&self) {\n            let _ = self.app.run_on_main_thread(|| end_sheet(SECRET_SHEET));\n        }\n    }\n\n    fn reveal<R: Runtime>(app: &AppHandle<R>, label: &str, secret: Zeroizing<String>) {\n        let Some(mtm) = MainThreadMarker::new() else {\n            return;\n        };\n        let Some(window) = main_window(app) else {\n            return;\n        };\n        end_sheet(SECRET_SHEET);\n        let generation = SECRET_OWNER.begin();\n        let alert = NSAlert::new(mtm);\n        alert.setMessageText(&NSString::from_str(label));\n        alert.setInformativeText(&NSString::from_str(\n            \"Shown once. Copy it now: it is not stored and cannot be shown again after you close this. \\\n             A copy is cleared from the clipboard after 60 seconds if it is still there. \\\n             The configured scan key is unchanged.\",\n        ));\n        let field = NSTextField::labelWithString(&NSString::from_str(&secret), mtm);\n        field.setSelectable(true);\n        field.setFrame(NSRect::new(\n            NSPoint::new(0.0, 0.0),\n            NSSize::new(360.0, 24.0),\n        ));\n        alert.setAccessoryView(Some(&field));\n        alert.addButtonWithTitle(&NSString::from_str(\"Copy and Close\"));\n        alert.addButtonWithTitle(&NSString::from_str(\"Close\"));\n        let held = std::cell::RefCell::new(Some(secret));\n        let shown_field = field.clone();\n        let handler = RcBlock::new(move |response: NSModalResponse| {\n            // The host's copy is dropped (zeroized) whatever the choice.\n            let secret = held.borrow_mut().take();\n            shown_field.setStringValue(&NSString::from_str(\"\"));\n            // Only this reveal's own registration is removed: a newer\n            // reveal may already own the sheet slot.\n            if SECRET_OWNER.owns(generation) {\n                SHEETS.with(|s| s.borrow_mut().remove(&SECRET_SHEET));\n            }\n            if response != NSAlertFirstButtonReturn {\n                return;\n            }\n            let Some(secret) = secret else { return };\n            let guard = ClipboardGuard::new(AppKitPasteboard::general());\n            if let Some(copied) = guard.copy(&secret) {\n                tauri::async_runtime::spawn(async move {\n                    tokio::time::sleep(CLEAR_AFTER).await;\n                    let _ = tokio::task::spawn_blocking(move || {\n                        ClipboardGuard::new(AppKitPasteboard::general()).cleanup(&copied)\n                    })\n                    .await;\n                });\n            }\n        });\n        alert.beginSheetModalForWindow_completionHandler(&window, Some(&handler));\n        SHEETS.with(|s| {\n            s.borrow_mut()\n                .insert(SECRET_SHEET, (window, alert.window()))\nimport { type ReactNode, useEffect, useRef, useState } from 'react'\nimport type { ChangeKind, ChangeResultView, ContextRef, GatewayResource, ManagementRequest, ManagementResource, ShellSnapshot } from '@prisma-airs/desktop-contracts'\nimport { MANAGEMENT_FAILURE_TEXT, RESOURCES, itemName, readManagement, type ObserveManagement } from '../../features/administration/management-read'\nimport { CHANGE_NOUN, type ChangeTarget, ChangeWorkbench, TEMPLATES, isGatewayKind, pretty, resultText } from '../../features/administration/runtime-changes'\nimport { DRAFT_PROBLEM_TEXT } from './gateway-tabs'\nimport { type Dispatch, type DispatchOutcome, outcomeMessage } from '../../features/tenants/dispatch'\nimport { clockOf } from '../copy'\nimport { Modal } from '../modal'\nimport { useShellStore } from '../store'\nimport { Verdict } from '../verdict'\nimport { Glyph } from '../icons'\nimport { ADMIN_COPY as C } from './copy'\nimport { RotationPanel } from './rotation-panel'\n\nexport interface ReviewSheetProps {\n    snapshot: ShellSnapshot\n    context: ContextRef\n    dispatch: Dispatch\n    observe: ObserveManagement\n    /** The change to review first (none when opening a rotation in progress). */\n    change: ChangeTarget | null\n    /** The application whose rotation this sheet follows (a key version, or \"Finish rotation…\"). */\n    rotation: string | null\n    /** A Gateway change keeps its edited text on this Mac as a draft (C17); the save's outcome is what the sheet reports. */\n    onDraft?: (body: string) => void | Promise<DispatchOutcome>\n    note?: ReactNode\n    onClose: () => void\n}\n\n/** What the open sheet says about the Gateway draft, from the current state: the last save's reply, then the core's word. */\nfunction draftNoteText(local: ShellSnapshot['gateway']['local'], saving: DraftSave): string {\n    if (saving === 'pending') return 'Keeping your edits on this Mac…'\n    if (saving === 'refused') return 'The desktop did not keep these edits as a draft; they stay only in this window.'\n    if (saving === 'unknown') return 'The desktop did not confirm that these edits were kept; what it holds is shown once it says.'\n    if (local.problem && DRAFT_PROBLEM_TEXT[local.problem]) return DRAFT_PROBLEM_TEXT[local.problem]!\n    if (local.unsaved) return 'Your edits could not be stored on this Mac (the local store is unavailable); they are kept only in this window until it is.'\n    return 'Your edits are kept on this Mac as a draft (never a review). Nothing is sent until you review and apply it.'\n}\ntype DraftSave = 'pending' | 'refused' | 'unknown' | null\n\nconst matches = (r: ChangeResultView, c: ChangeTarget) => r.kind === c.kind && r.action === c.action && r.target === c.target\n\nconst RUNTIME_RESOURCE: Partial<Record<ChangeKind, ManagementResource>> = {\n    profiles: 'profiles',\n    topics: 'topics',\n    applications: 'applications',\n    apiKeys: 'apiKeys',\n    dataPatterns: 'dataPatterns',\n    dataProfiles: 'dataProfiles',\n    filteringProfiles: 'filteringProfiles',\n    dictionaries: 'dictionaries',\n}\nconst GATEWAY_RESOURCE: Partial<Record<ChangeKind, GatewayResource>> = {\n    gatewayWorkspaces: 'workspaces',\n    gatewayProviders: 'providers',\n    gatewayRoutes: 'routes',\n    gatewayGuardrails: 'guardrails',\n    gatewayServiceKeys: 'serviceKeys',\n    gatewayUserKeys: 'userKeys',\n    gatewayIntegrations: 'integrations',\n}\n\n/** What an applied change established, for its action (C31): never success from a readback value alone. */\nexport type AppliedState = 'live' | 'removed' | 'unconfirmed' | 'failed'\nexport function appliedState(r: ChangeResultView): AppliedState {\n    if (r.outcome === 'unknown') return 'unconfirmed'\n    if (r.outcome !== 'completed') return 'failed'\n    // The service accepted it; only the readback of this action confirms it.\n    if (r.failure) return 'unconfirmed'\n    if (r.action === 'delete') return r.readback === 'absent' ? 'removed' : 'unconfirmed'\n    return r.readback === 'found' ? 'live' : 'unconfirmed'\n}\n\n/** What a reconciliation read of the reviewed item established now. */\ntype Reconciled = { state: 'reading' } | { state: 'read' } | { state: 'present' } | { state: 'absent' } | { state: 'partial' } | { state: 'failed'; message: string }\n\n/**\n * The review surface (C31, I3, I6, I7): the reviewed change (diff, impact,\n * \"Type <name> to confirm\" with Apply disabled until it matches; the native\n * confirmation applies), then its applied panel from the core's result, or\n * the staged rotation panel for a Runtime key version. Every exit (Done,\n * Escape, the scrim, navigation, unmount) ends the reviews it opened in the\n * core, which retires any one-time key their changes returned or will\n * return; a key held for a rotation it resumed is forgotten too.\n */\nexport function ReviewSheet({ snapshot, context, dispatch, observe, change: initial, rotation: rotationApp, onDraft, note, onClose }: ReviewSheetProps) {\n    const [change, setChange] = useState<ChangeTarget | null>(initial)\n    const [application] = useState<string | null>(rotationApp ?? (initial?.kind === 'apiKeys' && initial.action === 'version' ? applicationOf(initial) : null))\n    const [busy, setBusy] = useState(false)\n    // \"Application updated\" waits for the core's recorded acknowledgement\n    // before the old key's removal opens (Version → acknowledgement → Delete).\n    const [ackWaiting, setAckWaiting] = useState(false)\n    const [ackProblem, setAckProblem] = useState<string | null>(null)\n    const [reconciled, setReconciled] = useState<Reconciled | null>(null)\n    // Results present when this change was opened are not its outcome.\n    const seen = useRef(new Set(snapshot.changes.results.map((r) => r.operation)))\n    const [, setOpened] = useState(0)\n    useEffect(() => {\n        seen.current = new Set(snapshot.changes.results.map((r) => r.operation))\n        setReconciled(null)\n        // Render again without the results that belonged to the previous change.\n        setOpened((n) => n + 1)\n        // eslint-disable-next-line react-hooks/exhaustive-deps -- reset per opened change only\n    }, [change])\n    const result = change ? (snapshot.changes.results.find((r) => matches(r, change) && !seen.current.has(r.operation)) ?? null) : null\n    const rotation = application ? (snapshot.rotations.find((r) => r.application === application) ?? null) : null\n    // A key change of a rotation is followed by the rotation panel once it settles.\n    const rotationStep = !!change && change.kind === 'apiKeys' && (change.action === 'version' || change.action === 'delete') && !!application\n    const showWorkbench = !!change && !(result?.settled && rotationStep)\n\n    // A completion is confirmed once more by a toast bound to this tenant and\n    // context (I2, I10): it persists under Reduce Motion until dismissed.\n    const announced = useRef(new Set<string>())\n    const stage = rotation?.stage ?? null\n    const settledState = result?.settled && !rotationStep ? appliedState(result) : null\n    useEffect(() => {\n        const say = (key: string, text: string) => {\n            if (announced.current.has(key)) return\n            announced.current.add(key)\n            useShellStore.getState().toast(text, 'ok', undefined, snapshot.active?.tenant ?? null, context)\n        }\n        if (stage === 'complete' && rotation) say(`rotation-${rotation.application}`, C.rotation.completeToast(rotation.application))\n        if (result && (settledState === 'live' || settledState === 'removed'))\n            say(result.operation, settledState === 'live' ? C.applied.liveToast(change?.title ?? '') : C.applied.removedToast(change?.title ?? ''))\n        // eslint-disable-next-line react-hooks/exhaustive-deps -- on each observed completion\n    }, [stage, settledState])\n\n    // Every review this sheet opened, so its exit can end each one in the core.\n    const reviews = useRef(new Set<string>())\n    const open = snapshot.changes.review?.review ?? null\n    useEffect(() => {\n        if (open && change) reviews.current.add(open)\n    }, [open, change])\n    const exit = useRef<() => void>(() => {})\n    exit.current = () => {\n        // I6: the core ends each review; an applied one retires the one-time\n        // key its change returned, settled or still under way.\n        for (const review of reviews.current) void dispatch({ kind: 'discardChange', review })\n        reviews.current.clear()\n        if (rotation?.issuedBy) void dispatch({ kind: 'forgetSecret', operation: rotation.issuedBy })\n    }\n    // Unmount (navigation, tenant switch, window close) is an exit too. The\n    // deferred call lets a development re-mount cancel it.\n    const pendingExit = useRef<number | null>(null)\n    useEffect(() => {\n        if (pendingExit.current !== null) window.clearTimeout(pendingExit.current)\n        pendingExit.current = null\n        return () => {\n            pendingExit.current = window.setTimeout(() => exit.current(), 0)\n        }\n","exit_code":0,"status":"completed"}}
