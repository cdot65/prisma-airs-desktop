,\n  \"productName\": \"Prisma AIRS Desktop v2\",\n  \"version\": \"2.0.0\",\n  \"identifier\": \"io.cdot.prisma-airs-desktop.v2\",\n  \"build\": {\n    \"frontendDist\": \"../dist\",\n    \"beforeBuildCommand\": \"\"\n  },\n  \"app\": {\n    \"withGlobalTauri\": false,\n    \"windows\": [],\n    \"security\": {\n      \"csp\": {\n        \"default-src\": \"'self'\",\n        \"script-src\": \"'self'\",\n        \"style-src\": \"'self'\",\n        \"img-src\": \"'self' data:\",\n        \"font-src\": \"'self' data:\",\n        \"connect-src\": \"ipc: http://ipc.localhost\",\n        \"object-src\": \"'none'\",\n        \"base-uri\": \"'none'\",\n        \"form-action\": \"'none'\",\n        \"frame-ancestors\": \"'none'\",\n        \"frame-src\": \"'none'\",\n        \"worker-src\": \"'none'\"\n      },\n      \"dangerousDisableAssetCspModification\": false,\n      \"freezePrototype\": true,\n      \"capabilities\": [\"main-window\"]\n    }\n  },\n  \"bundle\": {\n    \"active\": true,\n    \"targets\": [\"app\", \"dmg\"],\n    \"category\": \"DeveloperTool\",\n    \"copyright\": \"Copyright 2026 cdot\",\n    \"license\": \"Apache-2.0\",\n    \"icon\": [\"icons/32x32.png\", \"icons/128x128.png\", \"icons/128x128@2x.png\", \"icons/icon.icns\", \"icons/icon.png\"],\n    \"macOS\": {\n      \"minimumSystemVersion\": \"13.0\",\n      \"hardenedRuntime\": true\n    }\n  }\n}\n//! Production OS adapters for the core: the Rust-owned data store, the\n//! Keychain credential store and the native profile-import sheet.\n//!\n//! The data root is the OS application-data directory for this build's\n//! bundle identifier (`io.cdot.prisma-airs-desktop.v2`, or `.fixture` in the\n//! fixture build), never a v1 directory. Fixture builds keep credentials in a\n//! dedicated test keychain inside that root under the fixture namespace, with\n//! OS prompts disabled so failures are deterministic; production uses the\n//! login Keychain. An adapter that cannot be opened is replaced by one that\n//! reports `Unavailable`; there is no fallback to plaintext or another store.\n\nuse std::io::Read;\nuse std::path::{Path, PathBuf};\nuse std::sync::Arc;\n\nuse desktop_core::avatar::MAX_SOURCE_BYTES;\nuse desktop_core::import::{ImportError, MAX_IMPORT_BYTES};\nuse desktop_core::store::{AppStore, FileStore, UnavailableStore};\nuse desktop_core::vault::UnavailableVault;\nuse desktop_core::{\n    Adapters, CredentialStore, FileSaver, FolderPicker, ImagePicker, ImportFile, ImportPicker,\n    PagePrinter, UrlOpener,\n};\nuse futures_util::future::BoxFuture;\nuse tauri::{AppHandle, Manager, Runtime};\nuse zeroize::Zeroizing;\n\nuse crate::MAIN_WINDOW;\n\n/// The fixture test keychain's file name inside the fixture data root.\npub const FIXTURE_KEYCHAIN: &str = \"fixture-credentials.keychain-db\";\n/// The fixture test keychain's password. It protects only synthetic fixture\n/// credentials in a keychain that exists solely for acceptance runs.\npub const FIXTURE_KEYCHAIN_PASSWORD: &str = \"prisma-airs-desktop-v2-fixture-keychain\";\n/// The staged fixture v1 keychain (C23) and its password: synthetic v1\n/// items only, created by the acceptance driver.\n#[cfg(feature = \"test-fixtures\")]\npub const FIXTURE_V1_KEYCHAIN: &str = \"fixture-v1.keychain-db\";\n#[cfg(feature = \"test-fixtures\")]\npub const FIXTURE_V1_KEYCHAIN_PASSWORD: &str = \"prisma-airs-desktop-v2-fixture-v1-keychain\";\n\n/// Builds the production adapters for the app's data root.\npub fn production<R: Runtime>(app: &AppHandle<R>) -> Adapters {\n    let root = app.path().app_data_dir().ok();\n    let store: Arc<dyn AppStore> = root\n        .as_deref()\n        .and_then(|dir| FileStore::open(dir).ok())\n        .map(|s| Arc::new(s) as Arc<dyn AppStore>)\n        .unwrap_or_else(|| Arc::new(UnavailableStore));\n    Adapters {\n        keychain: credential_store(root.as_deref()),\n        learner_keychain: learner_store(root.as_deref()),\n        store,\n        picker: Arc::new(NativePicker { app: app.clone() }),\n        opener: opener(root.as_deref()),\n        printer: printer(app, root.as_deref()),\n        images: images(app, root.as_deref()),\n        confirmer: confirmer(app),\n        secrets: secrets(app),\n        text_files: sheet_picker(\n            root.as_deref(),\n            text_files(app, root.as_deref()),\n            Arc::new(NativeTextPicker { app: app.clone() }),\n        ),\n        offline_root: root.as_ref().map(|r| r.join(\"academy-offline\")),\n        saver: sheet_saver(\n            root.as_deref(),\n            saver(app, root.as_deref()),\n            Arc::new(NativeSaver { app: app.clone() }),\n        ),\n        sessions_root: root.as_ref().map(|r| r.join(\"sessions\")),\n        case_files: sheet_picker(\n            root.as_deref(),\n            case_files(app, root.as_deref()),\n            Arc::new(NativeCasePicker { app: app.clone() }),\n        ),\n        library_root: root.as_ref().map(|r| r.join(\"library\")),\n        folders: folders(app, root.as_deref()),\n        workbench_files: sheet_picker(\n            root.as_deref(),\n            workbench_files(root.as_deref()),\n            Arc::new(NativeExportPicker { app: app.clone() }),\n        ),\n        workbench_root: root.as_ref().map(|r| r.join(\"api-client\")),\n        gateway_files: sheet_picker(\n            root.as_deref(),\n            gateway_files(app, root.as_deref()),\n            Arc::new(NativeUploadPicker { app: app.clone() }),\n        ),\n        harness: harness(app, root.as_deref()),\n        v1_source: v1_source(app),\n        import_root: root.as_ref().map(|r| r.join(\"imports\")),\n        logs_root: logs_root(app, root.as_deref()),\n    }\n}\n\n/// macOS's own logs folder for this app (D051), apart from the work in the\n/// data folder. Fixture builds keep it under their data root, which the\n/// acceptance drivers remove after each run.\n#[cfg(not(feature = \"test-fixtures\"))]\nfn logs_root<R: Runtime>(app: &AppHandle<R>, _: Option<&Path>) -> Option<PathBuf> {\n    app.path().app_log_dir().ok()\n}\n\n#[cfg(feature = \"test-fixtures\")]\nfn logs_root<R: Runtime>(_: &AppHandle<R>, root: Option<&Path>) -> Option<PathBuf> {\n    root.map(|r| r.join(\"fixture-logs\"))\n}\n\n/// v1's folder and Keychain service, read only (C23). Fixture builds read a\n/// staged copy under their data root and a staged file keychain, never a\n/// real v1 or the login Keychain.\n#[cfg(not(feature = \"test-fixtures\"))]\nfn v1_source<R: Runtime>(app: &AppHandle<R>) -> Option<desktop_core::import_v1::V1Source> {\n    let root = app.path().data_dir().ok()?.join(\"Prisma AIRS Desktop\");\n    let keychain = crate::keychain::V1KeychainSource::login().ok()?;\n    Some(desktop_core::import_v1::V1Source {\n        root,\n        keychain: Arc::new(keychain),\n    })\n}\n\n#[cfg(feature = \"test-fixtures\")]\nfn v1_source<R: Runtime>(app: &AppHandle<R>) -> Option<desktop_core::import_v1::V1Source> {\n    let data = app.path().app_data_dir().ok()?;\n    let keychain: Arc<dyn desktop_core::import_v1::V1Keychain> =\n        match crate::keychain::V1KeychainSource::file(\n            &data.join(FIXTURE_V1_KEYCHAIN),\n            FIXTURE_V1_KEYCHAIN_PASSWORD,\n            &data.join(\"fixture-v1-reads.log\"),\n/**\n * Academy learner source compiled into the desktop (C05). The learner\n * package (@ai-security-academy/learner) exports Academy's own pages; their\n * `@/` imports are Academy's source in the prepared, hash-verified input\n * (.work/academy, xtask shared-prepare). Every bare import that source makes\n * resolves to this app's pinned copy (`dedupe`), so one React, one React\n * Query and one router instance exist and versions follow the desktop lock.\n */\n// A file-system path without Node typings in the app's tsconfig (the\n// repository path has no characters that URL-encode other than these).\nexport const ACADEMY_SRC = decodeURIComponent(new URL('../../.work/academy/src', import.meta.url).pathname)\nconst CONTRACTS_ROOT = decodeURIComponent(new URL('../../packages/desktop-contracts/', import.meta.url).pathname)\n\n// node_modules may be shared with another worktree. Compile this checkout's IPC parser and bindings,\n// not the workspace package reached through that other checkout's dependency symlink.\nexport const desktopAliases = [\n    { find: /^@prisma-airs\\/desktop-contracts$/, replacement: `${CONTRACTS_ROOT}src/index.ts` },\n    { find: /^@prisma-airs\\/desktop-contracts\\/fixtures\\//, replacement: `${CONTRACTS_ROOT}fixtures/` },\n    { find: /^@\\//, replacement: `${ACADEMY_SRC}/` },\n]\n\nexport const academyDedupe = [\n    'react',\n    'react-dom',\n    '@ai-security-academy/presentation',\n    '@ai-security-academy/shared',\n    '@codemirror/commands',\n    '@codemirror/lang-python',\n    '@codemirror/lang-yaml',\n    '@codemirror/language',\n    '@codemirror/state',\n    '@codemirror/view',\n    '@dnd-kit/core',\n    '@excalidraw/excalidraw',\n    '@lezer/highlight',\n    '@radix-ui/react-dialog',\n    '@radix-ui/react-slot',\n    '@tanstack/react-query',\n    '@tanstack/react-router',\n    '@trpc/client',\n    '@trpc/react-query',\n    '@trpc/server',\n    'class-variance-authority',\n    'clsx',\n    'dompurify',\n    'lucide-react',\n    'mermaid',\n    'qrcode.react',\n    'sanitize-html',\n    'tailwind-merge',\n    'zustand',\n]\n","exit_code":0,"status":"completed"}}
