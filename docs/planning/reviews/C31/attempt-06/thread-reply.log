f.run_on_main_thread(move || {\n/Users/admin/.cargo/registry/src/index.crates.io-1949cf8c6b5b557f/tauri-2.12.4/src/window/mod.rs:1462:      self.run_on_main_thread(move || {\n/Users/admin/.cargo/registry/src/index.crates.io-1949cf8c6b5b557f/tauri-2.12.4/src/window/mod.rs:1494:      self.run_on_main_thread(move || {\n/Users/admin/.cargo/registry/src/index.crates.io-1949cf8c6b5b557f/tauri-2.12.4/src/window/mod.rs:1527:      self.run_on_main_thread(move || {\n/Users/admin/.cargo/registry/src/index.crates.io-1949cf8c6b5b557f/tauri-2.12.4/src/window/mod.rs:2005:      self.run_on_main_thread(move || {\n/Users/admin/.cargo/registry/src/index.crates.io-1949cf8c6b5b557f/tauri-2.12.4/src/window/mod.rs:2176:    self.run_on_main_thread(move || {\n/Users/admin/.cargo/registry/src/index.crates.io-1949cf8c6b5b557f/tauri-2.12.4/src/app.rs:438:    self.run_on_main_thread(move || {\n/Users/admin/.cargo/registry/src/index.crates.io-1949cf8c6b5b557f/tauri-2.12.4/src/app.rs:461:    self.run_on_main_thread(move || {\n/Users/admin/.cargo/registry/src/index.crates.io-1949cf8c6b5b557f/tauri-2.12.4/src/app.rs:496:  pub fn run_on_main_thread<F: FnOnce() + Send + 'static>(&self, f: F) -> crate::Result<()> {\n/Users/admin/.cargo/registry/src/index.crates.io-1949cf8c6b5b557f/tauri-2.12.4/src/app.rs:499:      .run_on_main_thread(f)\n/Users/admin/.cargo/registry/src/index.crates.io-1949cf8c6b5b557f/tauri-2.12.4/src/app.rs:700:    let _ = self.run_on_main_thread(move || {\n/Users/admin/.cargo/registry/src/index.crates.io-1949cf8c6b5b557f/tauri-2.12.4/src/app.rs:946:            let _ = self.run_on_main_thread(move || {\n/Users/admin/.cargo/registry/src/index.crates.io-1949cf8c6b5b557f/tauri-2.12.4/src/app.rs:1007:          self.run_on_main_thread(move || {\n/Users/admin/.cargo/registry/src/index.crates.io-1949cf8c6b5b557f/tauri-2.12.4/src/app.rs:1039:            self.run_on_main_thread(move || {\n/Users/admin/.cargo/registry/src/index.crates.io-1949cf8c6b5b557f/tauri-2.12.4/src/app.rs:1274:  pub fn run_on_main_thread<F: FnOnce() + Send + 'static>(&self, f: F) -> crate::Result<()> {\n/Users/admin/.cargo/registry/src/index.crates.io-1949cf8c6b5b557f/tauri-2.12.4/src/app.rs:1275:    self.app_handle().run_on_main_thread(f)\n            s.auto = answer;\n        }\n    }\n\n    /// Resolves the oldest held confirmation; false when none is held.\n    pub fn complete(&self, accepted: bool) -> bool {\n        let sender = self\n            .state\n            .lock()\n            .ok()\n            .and_then(|mut s| (!s.pending.is_empty()).then(|| s.pending.remove(0).1));\n        sender.is_some_and(|tx| tx.send(accepted).is_ok())\n    }\n\n    pub fn requests(&self) -> Vec<(u64, crate::authority::ConfirmationRequest)> {\n        self.state\n            .lock()\n            .map(|s| s.requests.clone())\n            .unwrap_or_default()\n    }\n\n    pub fn held(&self) -> usize {\n        self.state.lock().map(|s| s.pending.len()).unwrap_or(0)\n    }\n\n    pub fn dismissed(&self) -> Vec<u64> {\n        self.state\n            .lock()\n            .map(|s| s.dismissed.clone())\n            .unwrap_or_default()\n    }\n}\n\nimpl crate::authority::OperatorConfirmation for ScriptedConfirmer {\n    fn confirm(\n        &self,\n        nonce: u64,\n        request: crate::authority::ConfirmationRequest,\n    ) -> futures_util::future::BoxFuture<'static, bool> {\n        let Ok(mut s) = self.state.lock() else {\n            return Box::pin(async { false });\n        };\n        s.requests.push((nonce, request));\n        if let Some(answer) = s.auto {\n            return Box::pin(async move { answer });\n        }\n        let (tx, rx) = tokio::sync::oneshot::channel();\n        s.pending.push((nonce, tx));\n        Box::pin(async move { rx.await.unwrap_or(false) })\n    }\n\n    fn dismiss(&self, nonce: u64) {\n        if let Ok(mut s) = self.state.lock() {\n            s.dismissed.push(nonce);\n            if let Some(i) = s.pending.iter().position(|(n, _)| *n == nonce) {\n                let (_, tx) = s.pending.remove(i);\n                let _ = tx.send(false);\n            }\n        }\n    }\n}\n\n/// A scripted one-time secret sheet: records what it was asked to show.\n#[derive(Default)]\npub struct ScriptedSecrets {\n    shown: Mutex<Vec<(String, String)>>,\n    dismissals: Mutex<usize>,\n}\n\nimpl ScriptedSecrets {\n    pub fn shown(&self) -> Vec<(String, String)> {\n        self.shown.lock().map(|s| s.clone()).unwrap_or_default()\n    }\n\n    pub fn dismissals(&self) -> usize {\n        self.dismissals.lock().map(|d| *d).unwrap_or(0)\n    }\n}\n\nimpl crate::authority::SecretPresenter for ScriptedSecrets {\n    fn reveal(&self, label: String, secret: Zeroizing<String>) {\n        if let Ok(mut s) = self.shown.lock() {\n            s.push((label, secret.as_str().to_owned()));\n        }\n    }\n\n    fn dismiss(&self) {\n        if let Ok(mut d) = self.dismissals.lock() {\n            *d += 1;\n        }\n    }\n}\n\n/// What a scripted save sheet does with the next export.\n#[derive(Clone, Copy, Debug, Default, PartialEq, Eq)]\npub enum SaveScript {\n7:test renderer_reload_before_reveal_forgets_the_native_held_key ... ok\n8:test renderer_reload_during_confirmation_retires_the_native_review ... ok\n9:test renderer_reload_during_issuance_drops_the_late_key_without_replaying ... ok\n","exit_code":0,"status":"completed"}}
