y host and port (whatever the scheme, so plain HTTP to a\n/// registered host is classified too).\n#[derive(Clone, Debug, Default, PartialEq, Eq)]\npub struct Registered(std::collections::BTreeMap<String, BTreeSet<OriginClass>>);\n\nimpl Registered {\n    fn key(url: &url::Url) -> Option<String> {\n        Some(format!(\n            \"{}:{}\",\n            url.host_str()?.to_ascii_lowercase(),\n            url.port_or_known_default()?\n        ))\n    }\n\n    /// Registers `base`'s origin as serving `class`.\n    pub fn add(&mut self, base: &str, class: OriginClass) {\n        if let Some(key) = url::Url::parse(base).ok().as_ref().and_then(Self::key) {\n            self.0.entry(key).or_default().insert(class);\n        }\n    }\n\n    /// The classes `url`'s origin serves, if it is registered.\n    pub fn classes(&self, url: &url::Url) -> Option<&BTreeSet<OriginClass>> {\n        Self::key(url).and_then(|k| self.0.get(&k))\n    }\n\n    pub fn contains(&self, url: &url::Url) -> bool {\n        self.classes(url).is_some()\n    }\n}\n\n/// A known catalogue operation.\n#[derive(Clone, Debug, PartialEq, Eq)]\npub struct Operation {\n    pub index: usize,\n}\n\n/// The credentials `plan` itself sends: the editor's credential headers,\n/// and its authentication (whatever header it generates, or an API key in\n/// the query).\nfn credential_sources(plan: &Plan) -> usize {\n    plan.headers\n        .iter()\n        .filter(|(n, _)| CREDENTIAL_HEADERS.contains(&n.to_ascii_lowercase().as_str()))\n        .count()\n        + usize::from(!matches!(plan.auth, Auth::None))\n}\n\n/// Whether the collection jar's Cookie header would be a second credential\n/// beside one `plan` sends itself (its Authorization, an explicit Cookie,\n/// an API key). At a registered origin that is refused like any other\n/// second credential; the jar is consulted only once admission has shown\n/// the request is not a tenant-credential one.\npub fn jar_cookie_is_ambiguous(plan: &Plan) -> bool {\n    credential_sources(plan) > 0\n}\n\n/// The catalogue operation `plan` is at a registered origin serving\n/// `classes` (one plain spelling of a known method and path), or denial.\nfn registered_operation(\n    plan: &Plan,\n    url: &url::Url,\n    classes: &BTreeSet<OriginClass>,\n) -> Result<Operation, SendRefusal> {\n    if !plan.url.plain().is_some_and(|t| plain_path(&t)) {\n        return Err(SendRefusal::UnknownEndpoint);\n    }\n    classes\n        .iter()\n        .find_map(|class| classify(&plan.method, *class, url.path()))\n        .ok_or(SendRefusal::UnknownEndpoint)\n}\n\n/// Fills the tenant's TSG (plain text) into every `tenant.tsg_id` slot.\npub fn fill_tsg(plan: &mut Plan, tsg: &str) {\n    let fill = |t: &mut Template| {\ncrates/desktop-core/src/authority/workbench_domain.rs:5://! Save, Protect and Preview carry a fresh full snapshot with the revision\ncrates/desktop-core/src/authority/workbench_domain.rs:30:use crate::workbench::environments::{self, Origin, Preview};\ncrates/desktop-core/src/authority/workbench_domain.rs:136:    /// Send a reviewed tenant-credential change: the same snapshot must\ncrates/desktop-core/src/authority/workbench_domain.rs:137:    /// reproduce the review, and the operator confirms natively.\ncrates/desktop-core/src/authority/workbench_domain.rs:139:        review: ReviewId,\ncrates/desktop-core/src/authority/workbench_domain.rs:153:    /// A recorded run and its stored body's preview (nothing is sent).\ncrates/desktop-core/src/authority/workbench_domain.rs:164:    Preview {\ncrates/desktop-core/src/authority/workbench_domain.rs:214:    /// Choose an Insomnia export in the native file sheet and preview it.\ncrates/desktop-core/src/authority/workbench_domain.rs:216:    /// Create the selected resources of the previewed export.\ncrates/desktop-core/src/authority/workbench_domain.rs:328:    Preview {\ncrates/desktop-core/src/authority/workbench_domain.rs:329:        preview: Preview,\ncrates/desktop-core/src/authority/