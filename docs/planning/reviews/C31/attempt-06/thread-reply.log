d667acf513e4729b18e786bae80f604d43356005e4ecebf51bf505\"\n    },\n    {\n      \"subject\": \"C24\",\n      \"record\": \"docs/planning/evidence/P09/native/cumulative/C24/native-acceptance.json\",\n      \"record_sha256\": \"08825087b48848e361b54593fce046ec3dcd9ea98fe26d373979e6ec36fdef47\",\n      \"execution\": \"docs/planning/evidence/P09/native/cumulative/C24/execution.json\",\n      \"execution_sha256\": \"9bbba2cb6ac9cbed8c4be3d2e8d81d8cec1650e7d1743562e41d76e49a7d638b\",\n      \"log\": \".evidence-private/worf-agent/2026-11-02-c31-integration-01/native-08-c24.log\",\n      \"log_sha256\": \"2e50dc571ff7cb3551a02b408a9f16ace038800c0a4e6d2dbad496c22903ea5b\"\n    }\n  ],\n  \"affected_native_steps\": [\n    \"C31\",\n    \"C39\",\n    \"C44\"\n  ],\n  \"conditions\": \"Same guest, fixture application, identifier, bundle, flags and native helpers except the declared single Gateway key-check function. Failed C31 has no verdict and is archived; no passed step is restarted. Current18 checks have not yet run. No current C30 timing.\"\n}\n{\n  \"schema\": \"airs-v2/c31-source-transition/1\",\n  \"time\": \"2026-11-02T13:11:46.051212+00:00\",\n  \"baseline_head\": \"e825c2f69cbcd19387142b80481faaad84690a07\",\n  \"baseline_digest\": \"e441459dde8a4b13403f16f16e5abf100636421ff827f9955f37740500bbdc50\",\n  \"current_head\": \"e8939df295523b1cbee335e86b9dbe71e9b30d1c\",\n  \"current_source_digest\": \"36d18f099d50e25cb0f70f6d1438844b857be862adfb5176905e86c04ec3835a\",\n  \"source_delta\": {\n    \"apps/desktop/src-tauri/Cargo.toml\": {\n      \"before\": {\n        \"mode\": 420,\n        \"kind\": \"file\",\n        \"sha256\": \"1029adaed9c6068fc1e3f110058e9280083546eb596859313a6eded29e2e4f3f\"\n      },\n      \"after\": {\n        \"mode\": 420,\n        \"kind\": \"file\",\n        \"sha256\": \"e051d6781c547d0b1e9af95543926d03db46bfa373e5c53d915351b11435cc2a\"\n      }\n    },\n    \"apps/desktop/src-tauri/src/lib.rs\": {\n      \"before\": {\n        \"mode\": 42