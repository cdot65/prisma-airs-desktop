{"type":"item.started","item":{"id":"item_37","type":"command_execution","command":"/bin/zsh -lc \"sed -n '1,47p' tools/p11/standing.py; sed -n '1,145p' tools/p10/historical.py; sed -n '395,443p' tools/p11/remediation.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_37","type":"command_execution","command":"/bin/zsh -lc \"sed -n '1,47p' tools/p11/standing.py; sed -n '1,145p' tools/p10/historical.py; sed -n '395,443p' tools/p11/remediation.py\"","aggregated_output":"\"\"\"Durable, audited P11 standing for later production promotion.\n\nFinalization consumes completed executions and five real full-9 reviews. It\nnever assigns a score or completes a controller ledger. Historical validation\nuses the archived source/application, not this checkout's ignored target tree,\ninstalled application, toolchain, hostname, or current application source.\n\"\"\"\nfrom pathlib import Path\nimport json\nimport shutil\nimport subprocess\nimport sys\n\nsys.path.insert(0, str(Path(__file__).resolve().parent))\nsys.path.insert(0, str(Path(__file__).resolve().parents[1] / 'p10'))\nfrom candidate import bundle_hash, digest, file_identity\nfrom historical import Historical\nfrom qualification import bound, read, require, sha, verify as verify_coverage\nfrom review_gate import actual_review, release_prerequisites\n\nCHUNKS = ('C46', 'C47', 'C48', 'C49')\nSUBJECTS = (*CHUNKS, 'P11')\nBASE = Path('docs/planning/evidence/P11')\nACCEPTED = BASE / 'accepted'\nCOMPLETION = BASE / 'completion-proof.json'\nD2_SOURCE = BASE / 'source-history/D2'\nS2_SOURCE = BASE / 'source-history/S2'\nS3_SOURCE = BASE / 'source-history/S3'\nLFS_PATHS = (str(S3_SOURCE / 'resources/harness/darwin-arm64.tar.gz'),\n             str(S2_SOURCE / 'resources/harness/darwin-arm64.tar.gz'),\n             str(D2_SOURCE / 'resources/harness/darwin-arm64.tar.gz'),\n             str(ACCEPTED / 'application/Contents/MacOS/prisma-airs-desktop'),\n             str(ACCEPTED / 'application/Contents/Resources/harness/airs-harness'),\n             str(ACCEPTED / 'source/resources/harness/darwin-arm64.tar.gz'))\n\n\nclass ArchivedP11(Historical):\n    \"\"\"Explicit P11 archive context; historical C45 behavior is untouched.\"\"\"\n    def archive_path(self, name):\n        path = self.root / name\n        require(path.resolve().is_relative_to((self.root / ACCEPTED).resolve())\n                or path.resolve() in ((self.root / D2_SOURCE).resolve(), (self.root / S2_SOURCE).resolve(), (self.root / S3_SOURCE).resolve()),\n                'historical archive escapes accepted P11 evidence')\n        return path\n\n\ndef reference(root, path):\n\"\"\"Explicit immutable source/application context for historical qualification.\n\nThis validates what actually ran, not reuse on a current builder. Current reuse\ncontinues to check its own source, helpers, dependencies and machine conditions.\nThe caller must bind this context by hash in the qualified/release proof.\n\"\"\"\nfrom pathlib import Path\nfrom qualification import read,sha,require,bound\nfrom candidate import file_identity,digest,bundle_hash\n\n\nclass Historical:\n    def __init__(self,root,reference):\n        self.root=root;self.reference=reference;self.record=read(bound(root,reference));self.checked={}\n        require(self.record['schema']=='airs-desktop/historical-qualification-context/1','historical context schema')\n\n    def archive_path(self,name):\n        path=self.root/name\n        require(path.resolve().is_relative_to((self.root/'docs/planning/evidence/C45').resolve()),'historical archive escapes C45 evidence')\n        return path\n\n    def source(self,fingerprint):\n        entry=self.record['sources'].get(fingerprint);require(entry,'historical source archive missing')\n        if fingerprint not in self.checked:\n            seal=read(bound(self.root,entry['seal']));files=seal['files'];require(digest(files)==fingerprint,'historical source inventory binding')\n            folder=self.archive_path(entry['path'])\n            actual={str(p.relative_to(folder)):file_identity(p) for p in folder.rglob('*') if p.is_file() or p.is_symlink()}\n            require(actual==files,'historical source archive membership/content drift')\n            self.checked[fingerprint]=folder\n        return self.checked[fingerprint]\n\n    def application(self,candidate):\n        entry=self.record['applications'].get(candidate['bundle_sha256']);require(entry,'historical application archive missing')\n        folder=self.archive_path(entry['path'])\n        require(bundle_hash(folder)==candidate['bundle_sha256'],'historical complete bundle drift')\n        require(sha(folder/'Contents/MacOS/prisma-airs-desktop')==entry['executable_sha256']==candidate['executable_sha256'],'historical executable drift')\n        return folder\n    path = candidate['prepare']['path']\n    prefix, suffix = 'docs/planning/evidence/P11/native-build-', '-vm/native-prepare.json'\n    number = path.removeprefix(prefix).removesuffix(suffix)\n    require(number.isdigit() and int(number) >= 5 and path == f'{prefix}{int(number):02}{suffix}',\n            'new build may not overwrite the original canonical preparation')\n    argv = ['cargo', 'run', '--locked', '-p', 'xtask', '--example', 'p11_native_candidate', '--', '--out', path]\n    commands = [step['argv'] for step in build['steps']]\n    require(commands and commands[-1] in (argv, argv[:2]+['--offline']+argv[2:])\n            and commands[:-1] in ([], [['pnpm', '--filter', '@prisma-airs/desktop-contracts', 'typecheck'],\n                ['pnpm', '--filter', '@prisma-airs/desktop', 'typecheck']])\n            and build['application_inputs_after'] == build['application_inputs_before'],\n            'versioned native build command/input recipe differs')\n    old = read(root/'docs/planning/evidence/P11/native-prepare.json')\n    current = read(bound(root, candidate['prepare']))\n    require(current['commands'] == old['commands'] and current['target'] == old['target']\n            and current['features'] == old['features'] and current['subject'] == 'P11',\n            'versioned build changed the fixture recipe')\n\n\ndef make(root, receipt_path, out):\n    require(not out.exists(), 'preserve previous remediation qualification')\n    receipt = read(receipt_path)\n    files = read(bound(root, receipt['current_source']))['files']\n    old = read(bound(root, receipt['baseline']))\n    original = read(bound(root, old['coverage']))\n    prepared = read(bound(root, receipt['prepare']))\n    native = read(bound(root, receipt['recovery']))\n    candidate = dict(source_inventory_sha256=digest(files), execution_root=str(root),\n        runner_inputs=receipt['runner_inputs'], dependency_fingerprint=receipt['runner_inputs']['dependencies'],\n        prepare=receipt['prepare'], executable_sha256=prepared['executable_sha256'],\n        bundle_sha256=prepared['bundle_sha256'], build_flags={'target': prepared['target'], 'features': prepared['features']},\n        conditions=read(bound(root, native['raw']))['conditions'], helper_closure=native['helper_closure'])\n    history = ArchivedP11(root, receipt['historical_context'])\n    out.mkdir(parents=True)\n    def write(name, value):\n        p = out/name; p.parent.mkdir(parents=True, exist_ok=True)\n        with p.open('x') as stream: json.dump(value, stream, indent=2); stream.write('\\n')\n        return proof.reference(root, p)\n    candidate_ref = write('candidate.json', candidate)\n    requirements = copy.deepcopy(read(bound(root, original['plan']))['requirements'])\n    by_id = {r['id']: r for r in requirements}; rows = []\n    for original_row in original['coverage']:\n        cid = original_row['id']; needed = by_id[cid]\n        affected = cid in SOURCE_IDS | {'C48-N03'}\n        needed.update(affected=affected, must_execute=affected)\n        if affected:\n            result = write('results/'+cid.replace(':', '-').replace('/', '-')+'.json', {\n                'schema': 'airs-desktop/p11-affected-selector-result/1', 'required_id': cid,\n                'actual_evidence': selector_reference(receipt, cid),\n","exit_code":0,"status":"completed"}}
