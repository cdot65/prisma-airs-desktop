{"type":"item.completed","item":{"id":"item_31","type":"command_execution","command":"/bin/zsh -lc \"sed -n '1,220p' tools/p11/native.py; sed -n '1,170p' tools/native-acceptance/acceptance_p11_keyboard.py\"","aggregated_output":"\"\"\"P11 per-assertion native origins. Never synthesizes a passing process run.\"\"\"\nfrom pathlib import Path\nimport argparse\nimport importlib.util\nimport json\nimport platform\nimport sys\nimport time\n\nsys.path.insert(0, str(Path(__file__).resolve().parents[1]/'p10'))\nfrom qualification import bound, read, require, sha\nfrom candidate import helper_closure\n\n\ndef reference(root, path):\n    path = Path(path).resolve()\n    require(path.is_relative_to(root.resolve()), 'native evidence escapes checkout')\n    return {'path': str(path.relative_to(root)), 'sha256': sha(path)}\n\n\ndef inventory_root(root):\n    archived = root/'docs/planning/evidence/P11/source-history/S2'\n    return archived if archived.is_dir() else root\n\n\ndef inventory(root):\n    chunks = read(inventory_root(root)/'docs/architecture/native-checks.json')['chunks']\n    return {row['id']: row['check'] for chunk in ('C46', 'C47', 'C48', 'C49') for row in chunks[chunk]}\n\n\ndef c46_helpers(root):\n    archived = root/'docs/planning/evidence/P11/source-history/S2'\n    paths = set(helper_closure(archived if archived.is_dir() else root, 'acceptance_p11_setup'))\n    paths.add('tools/native-acceptance/acceptance_p11.py')\n    require('tools/native-acceptance/acceptance_p11_api.py' not in paths,\n            'C46 scope unexpectedly depends on changed API helper')\n    return sorted(paths)\n\n\n\ndef positive_rows(raw):\n    return {row['id']: row for row in raw['checks']\n            if row['facts'] and all(value is True for value in row['facts'].values())}\n\n\ndef excluded_checks(raw):\n    return [{'id': row['id'],\n             'failed_facts': sorted(name for name, value in row['facts'].items() if value is not True),\n             'reason': 'Measured assertion was not completed; a later positive replacement is required.'}\n            for row in raw['checks'] if row['id'] not in positive_rows(raw)]\n\n\ndef artifact_carry(root, raw, candidate, prior_refs):\n    \"\"\"Only the diagnosed N01 layout facts/captures may support its repair.\"\"\"\n    carry = raw.get('artifact_carry')\n    if not carry: return {}\n    require(carry['assertion'] == 'C47-N01' and carry['observations'] in prior_refs,\n            'unapproved native artifact carry')\n    path = bound(root, carry['observations'])\n    old = read(path)\n    rows = [row for row in old['checks'] if row['id'] == 'C47-N01']\n    require(len(rows) == 1 and rows[0]['facts'].get('named_actions_keyboard_reachable') is False\n            and all(value is True for name, value in rows[0]['facts'].items()\n                    if name != 'named_actions_keyboard_reachable'),\n            'N01 carry does not retain the original isolated keyboard failure')\n    require(old['executable_sha256'] == candidate['executable_sha256']\n            and old['bundle_sha256'] == candidate['bundle_sha256']\n            and old['binding']['conditions'] == candidate['conditions']\n            and all(candidate['helper_closure'].get(name) == digest\n                    for name, digest in old['helper_closure'].items()),\n            'N01 retained layout artifact/helper/VM conditions differ')\n    allowed = set(rows[0]['evidence']+rows[0]['visual'])\n    repaired = [row for row in raw['checks'] if row['id'] == 'C47-N01']\n    matrices = [name for name in rows[0]['evidence'] if Path(name).name == 'shell-layout-measurements.json']\n    require(len(repaired) == 1 and len(matrices) == 1\n            and matrices[0] in repaired[0]['evidence']\n            and set(rows[0]['visual']) <= set(repaired[0]['visual'])\n            and {matrices[0], *rows[0]['visual']} <= set(carry['artifact_sha256']),\n            'N01 repair omitted retained matrix or capture review scope')\n    require(carry['artifact_sha256'] and set(carry['artifact_sha256']) <= allowed,\n            'N01 carry includes unrelated artifacts')\n    for name, digest in carry['artifact_sha256'].items():\n        require((root/name).resolve().is_relative_to(path.parent)\n                and old['artifact_sha256'].get(name) == digest == sha(root/name),\n                'retained N01 layout artifact changed')\n    return carry['artifact_sha256']\n\n\ndef origins(root, selection, candidate):\n    require(selection['schema'] == 'airs-desktop/p11-native-selection/1'\n            and selection['native_inventory_sha256'] == sha(inventory_root(root)/'docs/architecture/native-checks.json'),\n            'native selection scope differs')\n    prepare = read(bound(root, selection['prepare']))\n    require(prepare['executable_sha256'] == candidate['executable_sha256']\n            and prepare['bundle_sha256'] == candidate['bundle_sha256'], 'native candidate differs')\n    context = read(bound(root, selection['source_context']))\n    require(all(context[key] == candidate[key] for key in\n                ('executable_sha256', 'bundle_sha256', 'build_flags', 'conditions')),\n            'completed native assertion conditions changed')\n    require(len(selection['origins']) >= 2, 'native continuation needs its actual contributing runs')\n    selected, prior_refs = {}, []\n    for i, origin in enumerate(selection['origins']):\n        path = bound(root, origin['observations'])\n        raw = read(path)\n        final = i == len(selection['origins'])-1\n        all_rows = {row['id']: row for row in raw['checks']}\n        rows = positive_rows(raw)\n        ids = sorted(rows)\n        require(len(all_rows) == len(raw['checks']) and origin['ids'] == ids\n                and origin.get('excluded_checks', []) == excluded_checks(raw)\n                and set(ids) <= set(inventory(root))-set(selected)\n                and origin['disposition'] == ('executed' if final else 'reused_exact'),\n                'native origin membership or disposition differs')\n        if i == 0: require(ids == ['C46-N01'], 'initial completed setup scope differs')\n        driver = Path(raw['argv'][1]).name\n        require(raw['schema'] == 'airs-desktop/p11-native-observations/1' and raw['subject'] == 'P11'\n                and raw['execution_id'] == path.parent.name and raw['performed_by']\n                and len(raw['argv']) >= 2 and Path(raw['argv'][0]).name.lower() in ('python3', 'python')\n                and raw['argv'][1] in [\n                    'tools/native-acceptance/acceptance_p11.py',\n                    'tools/native-acceptance/acceptance_p11_resume.py',\n                    'tools/native-acceptance/acceptance_p11_continue.py',\n                    'tools/native-acceptance/acceptance_p11_finish.py', 'tools/native-acceptance/acceptance_p11_last.py',\n                    'tools/native-acceptance/acceptance_p11_verify.py', 'tools/native-acceptance/acceptance_p11_warn.py']\n                and (i != 0 or driver == 'acceptance_p11.py'),\n                'native origin execution identity differs')\n        require(raw['executable_sha256'] == candidate['executable_sha256']\n                and raw['bundle_sha256'] == candidate['bundle_sha256']\n                and raw['host'] == candidate['conditions']['platform'],\n                'native origin artifact/platform changed')\n        require(raw['binding']['prepare']['sha256'] == selection['prepare']['sha256']\n                and raw['binding']['native_inventory_sha256'] == selection['native_inventory_sha256']\n                and raw['binding']['helper_closure'] == raw['helper_closure'],\n                'native origin aliases differ')\n        require(time.strptime(raw['finished_utc'], '%Y-%m-%dT%H:%M:%SZ')\n                >= time.strptime(raw['started_utc'], '%Y-%m-%dT%H:%M:%SZ'), 'native origin time invalid')\n        if not final:\n            require(raw['complete'] is False and raw['status'] == 'failed' and raw['exit_code'] == 1\n                    and raw['errors'], 'original failed process provenance was relabelled')\n        else:\n            require(raw['complete'] is True and raw['status'] == 'observed' and raw['exit_code'] == 0\n                    and not raw['errors'] and set(ids) == set(inventory(root))-set(selected),\n                    'remaining native execution did not complete')\n        if i == 0:\n            require(raw['helper_closure'] == context['helper_closure'],\n                    'completed run differs from bound S2 helper context')\n            paths = c46_helpers(root)\n        else:\n            admission = raw['continuation']\n            admitted_origins = admission.get('origins', [admission['observations']])\n            require(raw['binding']['conditions'] == candidate['conditions']\n                    and admitted_origins == prior_refs\n                    and admission['observations'] == prior_refs[-1]\n                    and sorted(admission['completed_ids']) == sorted(selected)\n                    and sorted(admission['remaining_ids']) == sorted(set(inventory(root))-set(selected))\n                    and admission['fixture_state_semantically_equal'] is True\n                    and admission['certificate_generation_or_install_executed'] is False,\n                    'native continuation admission/provenance differs')\n            admission_path = path.parent/'resume-preconditions.json'\n            require(raw['artifact_sha256'].get(str(admission_path.relative_to(root))) == sha(admission_path)\n                    and read(admission_path) == admission, 'recorded admission proof differs')\n            # All 07 driver files remain unchanged; no scope is silently dropped.\n            paths = sorted(raw['helper_closure'])\n        require(origin['helper_paths'] == paths and all(\n            raw['helper_closure'].get(name) == candidate['helper_closure'].get(name)\n            for name in paths), 'relevant native helper changed')\n        if final:\n            require(raw['helper_closure'] == candidate['helper_closure'], 'current native driver closure differs')\n        for artifact, digest in raw['artifact_sha256'].items():\n            file = (root/artifact).resolve()\n            require(file.is_relative_to(path.parent) and sha(file) == digest, 'native origin artifact changed')\n        combined_artifacts = dict(raw['artifact_sha256'])\n        combined_artifacts.update(artifact_carry(root, raw, candidate, prior_refs))\n        for check_id, row in rows.items():\n            require(row['facts'] and all(value is True for value in row['facts'].values()),\n                    'native assertion has incomplete or failed facts')\n            for name in row['evidence']+row['visual']:\n                require(name in combined_artifacts and sha(root/name) == combined_artifacts[name],\n                        'native row evidence was not captured by its contributing run')\n            selected[check_id] = dict(raw_path=path, raw=raw, row=row,\n                                     helper_paths=paths, disposition=origin['disposition'])\n        prior_refs.append(origin['observations'])\n    return selected\n\n\ndef review_captures(root, selection, candidate, selected):\n    review = read(bound(root, selection['visual_review']))\n    require(review['schema'] == 'airs-desktop/p11-visual-review/2'\n            and review['observations'] == [origin['observations'] for origin in selection['origins']]\n            and review['executable_sha256'] == candidate['executable_sha256']\n            and review['bundle_sha256'] == candidate['bundle_sha256'] and review['performed_by'],\n            'capture review does not bind both actual origins/candidate')\n    wanted = {(image, cid) for cid, item in selected.items() for image in item['row']['visual']}\n    images = {(row['path'], row['assertion']): row for row in review['captures']}\n    require(len(images) == len(review['captures']) and set(images) == wanted,\n            'capture-specific review membership differs')\n    for (name, _), row in images.items():\n        require(row['sha256'] == sha(root/name) and row['accepted'] is True and not row['findings'],\n                'capture review failed or image changed')\n\ndef validate(root, acceptance_path, execution_path, candidate):\n    \"\"\"Per-row process outcome remains distinct from the completed assertion.\"\"\"\n    selection = read(execution_path)\n    selected = origins(root, selection, candidate)\n    review_captures(root, selection, candidate, selected)\n    acceptance = read(acceptance_path)\n    require(acceptance['schema'] == 'airs-v2/native-acceptance/1' and acceptance['subject'] == 'P11'\n            and acceptance['method'] == 'cua' and acceptance['app']['fixture'] is True\n            and acceptance['app']['executable_sha256'] == candidate['executable_sha256'],\n            'final native acceptance candidate differs')\n    checks = {row['id']: row for row in acceptance['checks']}\n    require(len(checks) == len(acceptance['checks']) and set(checks) == set(selected),\n            'final native check membership differs')\n    for cid, item in selected.items():\n        row = checks[cid]\n        evidence = set(item['row']['evidence']+item['row']['visual']+\n            [str(item['raw_path'].relative_to(root)), str(execution_path.relative_to(root)),\n             selection['visual_review']['path']])\n        require(row['result'] == 'pass' and row['observation'] and evidence <= set(row['evidence']),\n                'final native row lost its actual origin/evidence')\n\"\"\"C47-N01: retain the frozen matrix and measure only its two unfinished API focus paths.\"\"\"\nimport copy\nimport hashlib\nimport json\nfrom pathlib import Path\n\nimport acceptance_c29 as c29\nimport acceptance_p11_shell as shell\nimport acceptance_p11_geometry as geometry\n\nROOT = Path.cwd().resolve()\nFLAGS = ('one_named_header_h1', 'navigation_focus', 'main_inside_window', 'academy_location')\nEXPECTED_FACTS = {\n    'all_destinations_have_one_named_header_h1': True,\n    'navigation_focus_observed': True,\n    'main_frames_measured_inside_window': True,\n    'named_actions_keyboard_reachable': False,\n    'academy_hierarchy_retained': True,\n}\nVIEWS = (('Light', 1440, 820, 0, 100), ('Dark', 900, 600, 10, 200))\n\n\ndef require(value, message):\n    if not value:\n        raise RuntimeError(message)\n\n\ndef sha(path):\n    return hashlib.sha256(Path(path).read_bytes()).hexdigest()\n\n\ndef bound(root, ref):\n    path = (root / ref['path']).resolve()\n    require(path.is_relative_to(root.resolve()) and sha(path) == ref['sha256'],\n            'prior keyboard evidence escapes or changed')\n    return path\n\n\ndef inspect_prior(ctx, prior, root=ROOT):\n    raw_path = bound(root, prior['observations'])\n    matrix_path = bound(root, prior['measurements'])\n    raw = json.loads(raw_path.read_text())\n    require(raw['schema'] == 'airs-desktop/p11-native-observations/1' and raw['subject'] == 'P11'\n            and raw['status'] == 'failed' and raw['exit_code'] == 1 and raw['complete'] is False,\n            'original failed matrix process must remain failed')\n    require(raw['binding']['helper_closure'] == raw['helper_closure']\n            and all(raw[key] == raw['binding'][key] == ctx.prepared[key]\n                    for key in ('executable_sha256', 'bundle_sha256'))\n            and raw['binding']['prepare']['sha256'] == ctx.binding['prepare']['sha256']\n            and raw['binding']['native_inventory_sha256'] == ctx.binding['native_inventory_sha256']\n            and raw['host'] == ctx.binding['conditions']['platform'],\n            'prior matrix candidate, platform or binding changed')\n    for name, digest in raw['helper_closure'].items():\n        file = (root / name).resolve()\n        require(file.is_relative_to(root) and file.is_file()\n                and ctx.closure.get(name) == digest == sha(file), 'prior matrix helper bytes changed')\n    for name, digest in raw['artifact_sha256'].items():\n        artifact = (root / name).resolve()\n        require(artifact.is_relative_to(raw_path.parent) and sha(artifact) == digest,\n                'prior matrix artifact changed')\n    rows = [row for row in raw['checks'] if row['id'] == 'C47-N01']\n    require(len(rows) == 1 and rows[0]['facts'] == EXPECTED_FACTS,\n            'prior N01 had a different failed fact')\n    row = rows[0]\n    relative = str(matrix_path.relative_to(root))\n    require(relative in row['evidence'] and raw['artifact_sha256'].get(relative) == prior['measurements']['sha256'],\n            'matrix is not bound by the original N01')\n    matrix = json.loads(matrix_path.read_text())\n    expected = {(page, theme, zoom) for page in shell.PAGES for theme, _, _, _, zoom in VIEWS}\n    require(len(matrix) == 16 and {(r['page'], r['theme'], r['zoom']) for r in matrix} == expected,\n            'frozen matrix membership changed')\n    for item in matrix:\n        require(all(item.get(flag) is True for flag in FLAGS), 'frozen non-keyboard measurement failed')\n        require(item['requested'] == ([1440, 820] if item['theme'] == 'Light' else [900, 600]),\n                'frozen matrix viewport changed')\n        require(item['named_action_keyboard_visible'] is (item['page'] != 'API Client'),\n                'frozen matrix has an unexpected keyboard result')\n    require(len(row['visual']) == len(set(row['visual'])) == 16\n            and all(name in raw['artifact_sha256'] for name in row['visual']),\n            'original matrix captures missing')\n    return raw, row, matrix\n\n\nclass TraversalFailure(RuntimeError):\n    def __init__(self, reason, record):\n        super().__init__('API keyboard traversal failed: ' + reason)\n        self.record = dict(record, failure=reason)\n\n\ndef focus_key(tree, node):\n    semantic = lambda value: (value.get('role'), value.get('label'), value.get('subrole'), value.get('depth'))\n    peers = [value for value in tree if semantic(value) == semantic(node)]\n    return (*semantic(node), next((i for i, value in enumerate(peers) if value is node), 0))\n\n\ndef traverse(initial, tab, tree_now, focused, frame):\n    \"\"\"One finite measured focus cycle, bounded by the actual AX tree size.\"\"\"\n    collection = [n for n in initial if n.get('role') == 'AXPopUpButton'\n                  and (n.get('label') or '').startswith('Collection ')]\n    require(len(collection) == 1, 'API Collection selector is missing or ambiguous')\n    require(sum(n.get('role') == 'AXPopUpButton' and n.get('label') == 'Environment'\n                for n in initial) == 1, 'API Environment selector is missing or ambiguous')\n    labels = {'collection': ('AXPopUpButton', collection[0]['label']),\n              'environment': ('AXPopUpButton', 'Environment')}\n    limit = 2 * max(1, len(initial))\n    trace, seen, reached = [], set(), {}\n    record = {'initial_ax_elements': len(initial), 'element_bound': limit,\n              'expected_header_selectors': labels, 'trace': trace, 'reached': reached}\n    for step in range(1, limit + 1):\n        tab()\n        tree = tree_now()\n        node = focused(tree)\n        if not node:\n            trace.append({'step': step, 'focused': None})\n            continue\n        key = focus_key(tree, node)\n        if key in seen:\n            raise TraversalFailure('focus_cycle', record)\n        seen.add(key)\n        viewport = frame()\n        inside = bool(node.get('enabled') is not False and node.get('size')\n                      and all(value > 0 for value in node['size']) and c29.inside(viewport, node))\n        entry = {'step': step, 'role': node.get('role'), 'label': node.get('label'),\n                 'pos': node.get('pos'), 'size': node.get('size'), 'window': viewport,\n                 'inside_window': inside}\n        trace.append(entry)\n        pair = (node.get('role'), node.get('label'))\n        goals = [name for name, expected in labels.items() if pair == expected]\n        if pair in (('AXTextField', 'URL'), ('AXButton', 'Send')):\n            goals.append('request_action')\n        for goal in goals:\n            if not inside:\n                raise TraversalFailure('focused_goal_outside_window', record)\n            reached[goal] = dict(entry)\n        if set(reached) == {'collection', 'environment', 'request_action'}:\n            record['steps'] = step\n            return record, node\n    raise TraversalFailure('ax_element_bound', record)\n\n\ndef run(ctx, prior):\n    raw, old_row, matrix = inspect_prior(ctx, prior)\n    proof = ctx.save('c47-keyboard-prior-binding', {\n        'prior_raw': prior['observations'], 'prior_measurements': prior['measurements'],\n        'original_execution_id': raw['execution_id'], 'original_process_exit_code': raw['exit_code'],\n        'original_failed_facts': old_row['facts'],\n        'disposition': 'Retain original non-keyboard and fourteen keyboard measurements; '\n                       'replace only the two failed API keyboard measurements with new observations.'})\n    corrected = copy.deepcopy(matrix)\n    evidence, captures, replacements = [prior['measurements']['path'], proof], [], []\n    for theme, width, height, zoom, percent in VIEWS:\n        name = 'c47-api-keyboard-' + theme.lower() + '-' + str(percent)\n        ctx.app.menu('View', 'Actual Size')\n        ctx.app.front()\n        geometry.size_window(ctx, width, height)\n        c29.appearance(ctx.app, theme)\n        if zoom:\n            c29.zoom(ctx.app, zoom)\n        ctx.navigate('API Client')\n        ctx.app.ax('focus', 'AXHeading', 'API Client')\n        initial = ctx.app.tree()\n        start = ctx.app.focused(initial) or {}\n        ctx.require(start.get('role') == 'AXHeading' and start.get('label') == 'API Client',\n                    'API header did not receive actual native focus')\n        try:\n            trace, node = traverse(initial, lambda: ctx.app.keycode(48), ctx.app.tree,\n                                   ctx.app.focused, ctx.frame)\n        except TraversalFailure as error:\n            ctx.save(name + '-trace', error.record)\n            raise\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_32","type":"agent_message","text":"The earlier review’s drawer-scrolling gap now has a native supplement: it records lower call entries becoming visible while the page anchor stays fixed. I’m verifying its process and artifact bindings, and the rationale for carrying that evidence to the current candidate.\n"}}
{"type":"item.started","item":{"id":"item_33","type":"command_execution","command":"/bin/zsh -lc \"sed -n '45,105p' tools/p11/standing.py; sed -n '220,300p' tools/p11/remediation.py; cat docs/planning/evidence/P11/c47-scroll-supplement-01/state.json; cat docs/planning/evidence/P11/c47-scroll-supplement-01/raw/candidate-processes.json\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_33","type":"command_execution","command":"/bin/zsh -lc \"sed -n '45,105p' tools/p11/standing.py; sed -n '220,300p' tools/p11/remediation.py; cat docs/planning/evidence/P11/c47-scroll-supplement-01/state.json; cat docs/planning/evidence/P11/c47-scroll-supplement-01/raw/candidate-processes.json\"","aggregated_output":"\n\ndef reference(root, path):\n    root = Path(root).resolve()\n    path = Path(path).resolve(strict=True)\n    require(path.is_relative_to(root.resolve()), 'P11 reference escapes checkout')\n    return {'path': str(path.relative_to(root)), 'sha256': sha(path)}\n\n\ndef identities(root, paths):\n    return {str(path.relative_to(root)): file_identity(path) for path in sorted(set(paths))}\n\n\ndef evidence_files(root, attempts):\n    paths = [p for p in (root / BASE).rglob('*')\n             if (p.is_file() or p.is_symlink()) and not p.is_relative_to(root / ACCEPTED)\n             and p != root / COMPLETION and '__pycache__' not in p.parts]\n    for subject, attempt in attempts.items():\n        paths.extend(p for p in (root / 'docs/planning/reviews' / subject / attempt).rglob('*')\n                     if (p.is_file() or p.is_symlink()) and '__pycache__' not in p.parts)\n    return paths\n\n\ndef latest_attempt(root, subject):\n    attempts = [p.name for p in (root / 'docs/planning/reviews' / subject).glob('attempt-*')\n                if p.is_dir() and p.name.removeprefix('attempt-').isdigit()]\n    require(attempts, 'missing actual P11 member/phase review: ' + subject)\n    return max(attempts, key=lambda name: int(name.removeprefix('attempt-')))\n\n\ndef require_archive_lfs(root):\n    result = subprocess.run(['/usr/bin/git', 'check-attr', '-z', 'filter', '--', *LFS_PATHS],\n                            cwd=root, capture_output=True, check=True)\n    fields = result.stdout.decode().strip('\\0').split('\\0')\n    require(len(fields) == len(LFS_PATHS) * 3\n            and all(fields[i:i+3] == [name, 'filter', 'lfs'] for i, name in zip(range(0, len(fields), 3), LFS_PATHS)),\n            'configure reviewed P11 archive Git LFS paths before finalization')\n\n\ndef audited_reviews(root, attempts, qualified, source):\n    root = Path(root).resolve()\n    require(set(attempts) == set(SUBJECTS), 'P11 requires exactly four member reviews and its phase review')\n    reviews = {}\n    for subject in SUBJECTS:\n        attempt = attempts[subject]\n        require(attempt == latest_attempt(root, subject), 'newer review attempt exists: ' + subject)\n        request = read(root / 'docs/planning/reviews' / subject / attempt / 'request.json')\n        require(request['qualification'] == qualified,\n                'P11 reviews do not bind one shared qualification: ' + subject)\n        reviews[subject] = actual_review(root, subject, attempt, source_root=source)\n        require(all(value >= 9 for value in reviews[subject]['scores'].values()),\n                'P11 promotion requires full-9 reviewed standing: ' + subject)\n    phase = read(root / 'docs/planning/reviews/P11' / attempts['P11'] / 'request.json')\n    require(phase['predecessors']['members'] == {name: reviews[name] for name in CHUNKS},\n            'phase review did not consume these exact four audited member reviews')\n    require(all(row['fingerprints']['source'] == qualified['verified']['source_inventory_sha256']\n                for row in reviews.values()), 'reviews bind a foreign qualified source')\n    return reviews\n\n\ndef verify(root):\n\ndef selector_reference(receipt, cid):\n    return receipt['recovery'] if cid == 'C48-N03' else receipt['format'] if cid == 'check:C46/check/1' else receipt['source_qa']\n\n\ndef source_transition(root, receipt, candidate, source, files):\n    old_record = read(bound(root, receipt['baseline']))\n    require(receipt['baseline']['path'] == BASELINE, 'foreign remediation baseline')\n    old_coverage = read(bound(root, old_record['coverage']))\n    old_candidate = read(bound(root, old_coverage['candidate']))\n    before = read(bound(root, old_record['source']))['files']\n    delta(before, files, receipt['changed_paths'])\n    require(all(candidate[k] == old_candidate[k] for k in ('conditions', 'build_flags'))\n            and all(candidate['runner_inputs'][k] == old_record['runner_inputs'][k]\n                    for k in ('dependencies', 'build_flags')), 'remediation VM/toolchain/flags changed')\n    history = ArchivedP11(root, receipt['historical_context'])\n    require(history.source(digest(before)) == root/'docs/planning/evidence/P11/source-history/S3',\n            'original reviewed source context differs')\n    proof.verify_coverage(root, old_coverage, historical=history)\n    preserved_bundle(root, receipt['preserved_candidate'], old_candidate)\n    scroll(root, receipt['scroll'], receipt['baseline'], old_candidate, files)\n    rust_consumers(root, receipt['rust_consumers'], files)\n    affected_lints(root, receipt, files)\n    format_selector(root, receipt['format'], files, candidate['execution_root'])\n    covered = set()\n    require(receipt['helper_qa'], 'remediation affected helper QA missing')\n    for ref in receipt['helper_qa']:\n        qa = read(bound(root, ref)); bound(root, qa['log'])\n        require(qa['schema'] == 'airs-desktop/p11-helper-qa/1' and qa['argv']\n                and qa['exit_code'] == 0 and qa['tests']['passed'] > 0 and qa['tests']['failed'] == 0\n                and qa.get('source_before') == qa.get('source_after')\n                and qa['helper_files'] and all(files.get(n, {}).get('sha256') == value\n                    for n, value in qa['helper_files'].items()), 'remediation helper QA failed/drifted')\n        covered.update(qa['helper_files'])\n    require({n for n in receipt['changed_paths'] if n.endswith('.py')} <= covered,\n            'remediation changed helper lacks affected QA')\n    return old_record, old_coverage, history\n\n\ndef source_qa(root, reference, files):\n    supplement = read(bound(root, reference))\n    require(supplement['schema'] == 'airs-desktop/p11-c48-source-supplement/1'\n            and supplement['source_files'] == {n: files[n]['sha256'] for n in APP_DELTA},\n            'C48 affected source inputs differ')\n    producers = [read(bound(root, ref)) for ref in supplement['producer_receipts']]\n    originals = [row for producer in producers for key in ('final_checks', 'retained_prior_focused_checks')\n                 for row in producer.get(key, [])]\n    expected = {'C48/recovery-final02': 4, 'C48/typecheck-final02': None,\n        'C48/controllers-final': 20, 'C48/api-prior': 42, 'C48/shell-and-cases-prior': 45}\n    checks = supplement['checks']\n    require(len(checks) == len(expected) and {c['id'] for c in checks} == set(expected),\n            'C48 selected recovery/cross-consumer coverage missing')\n    earlier = {\n        'apps/desktop/src/v2/workbench/api-client.tsx': {\n            '50b881c165ce183abe845f4c572d687fe7bc4b0041a1a69c875394c55a67bb1d',\n            '0d1da0ed31d0ff86e4d46fb0392f08ad06945b30eb47c7cf97c114fba46e63d3'},\n        'apps/desktop/src/v2/workbench/api-client.test.tsx': {\n            '2d07b3ec2c0d340b30c4cf23877c05b548d30f34c7a4a98fe2dc72433f2f01eb',\n            '7a68e497d5056c30ebb8aa1f9f9c8216d7a28e979d86496ea74cbce9c255de03'}}\n    for item in checks:\n        require(item['exit_code'] == 0 and item.get('passed') == expected[item['id']]\n                and item['argv'] and item['cwd'], 'C48 selected command failed')\n        log = bound(root, item['log'])\n        require(any(all(old.get(k) == item.get(k) for k in ('argv', 'cwd', 'exit_code', 'passed'))\n                    and old['log_sha256'] == sha(log) for old in originals),\n                'C48 selection is not an original actual execution')\n        require(item['source_hashes'] and set(item['source_inputs']) == set(item['source_hashes']),\n                'C48 original source scope missing')\n        for name, value in item['source_hashes'].items():\n            require(sha(bound(root, item['source_inputs'][name])) == value\n                    and (files.get(name, {}).get('sha256') == value or value in earlier.get(name, set())),\n                    'C48 selected source delta is not the bounded recovery refinement')\n        if item['id'].endswith('final02'):\n            require(item['source_hashes'] == supplement['source_files'], 'final selector source was retagged')\n    return supplement\n\n\ndef recovery(root, reference, baseline, candidate, old_result, files):\n    supplement = read(bound(root, reference))\n    raw = read(bound(root, supplement['raw']))\n    bound(root, supplement['execution']); bound(root, supplement['source'])\n{\n  \"host\": \"worf-vm\",\n  \"state\": \"finished\",\n  \"argv\": [\n    \"/usr/bin/python3\",\n    \".evidence-private/explain-scroll-01/probe.py\"\n  ],\n  \"started_utc\": \"2026-11-04T17:50:38Z\",\n  \"orchestrator_sha256\": \"62dbf83d7cd9f7a50a7802370d9e28cd86083c8898a9df8d11f0a0e82277ab20\",\n  \"native_assertions_observed\": 0,\n  \"driver_pid\": 75524,\n  \"last_activated_pid\": 75535,\n  \"latest_evidence\": \"receipt.json\",\n  \"exit_code\": 0,\n  \"finished_utc\": \"2026-11-04T17:50:52Z\"\n}\n{\n  \"schema\": \"airs-desktop/candidate-processes/1\",\n  \"bundle\": \"/Users/cdot/development/redtail/p09-queue/refinement-20261104/tooling/targets/core/aarch64-apple-darwin/release/bundle/macos/Prisma AIRS Desktop Fixture.app\",\n  \"app\": {\n    \"pid\": 75535,\n    \"executable\": \"/Users/cdot/development/redtail/p09-queue/refinement-20261104/tooling/targets/core/aarch64-apple-darwin/release/bundle/macos/Prisma AIRS Desktop Fixture.app/Contents/MacOS/prisma-airs-desktop\",\n    \"birth\": [\n      1793814640,\n      156122\n    ],\n    \"parent\": 75524\n  },\n  \"engines\": [],\n  \"meaning\": \"Observed exact executable/PID birth identities owned by this driver; no process-name or installed-app lookup.\"\n}\n","exit_code":0,"status":"completed"}}
