{"type":"item.completed","item":{"id":"item_22","type":"command_execution","command":"/bin/zsh -lc \"sed -n '674,806p' tools/p11/proof.py; sed -n '300,397p' tools/p11/remediation.py; rg -n '\"'^def (source_inventory|digest|file_identity)'\"' tools/p09/phase_packet.py\"","aggregated_output":"def verify_coverage(root, qualified, historical=None):\n    \"\"\"P11 check selection plus the unchanged generic test/native consumer.\"\"\"\n    if 'review_remediation' in qualified:\n        import remediation\n        return remediation.verify_coverage(root, qualified, historical=historical)\n    if 'impact_selection' in qualified:\n        return verify_impact_coverage(root, qualified, historical=historical)\n    if 'check_selection' not in qualified:\n        source = historical.source(qualified['source_inventory_sha256']) if historical else root\n        verify_plan(source, read(bound(root, qualified['plan'])))\n        require(all(row['disposition'] == 'executed' for row in qualified['coverage']),\n                'changed P11 coverage was not executed')\n        return coverage.verify(root, qualified, historical=historical)\n    candidate = read(bound(root, qualified['candidate']))\n    source = historical.source(qualified['source_inventory_sha256']) if historical else root\n    check_source = read(bound(root, qualified['check_source']))\n    require(digest(check_source['files']) == qualified['source_inventory_sha256'],\n            'check selection source does not bind qualified source')\n    selection = validate_check_selection(root, bound(root, qualified['check_selection']),\n        candidate['runner_inputs'], source=source,\n        files=check_source['files'] if historical else None)\n    require(qualified['check_source'] == selection['selection']['current_source'],\n            'check selection source reference differs')\n    require(selection['selection']['execution_root'] == candidate['execution_root'],\n            'check selection original execution root differs from candidate')\n    selected = {'check:' + row['needed']['label']: row for row in selection['selected']\n                if not row['needed']['label'].startswith('setup/')}\n    plan = read(bound(root, qualified['plan']))\n    verify_plan(source, plan, {cid: row['disposition'] for cid, row in selected.items()})\n    rows = qualified['coverage']\n    require(len(rows) == len(plan['requirements']) and {r['id'] for r in rows}\n            == {r['id'] for r in plan['requirements']}, 'check coverage membership differs')\n    for row in rows:\n        if row['id'] not in selected:\n            continue\n        chosen = selected[row['id']]\n        raw, actual, path = chosen['raw'], chosen['actual'], chosen['path']\n        result = read(bound(root, row['result']))\n        require(row['disposition'] == chosen['disposition'] and result == {\n            'status': 'pass', 'exit_code': 0, 'execution_id': raw['run_id'],\n            'argv': actual['argv'], 'cwd': selection['selection']['execution_root'],\n            'started_utc': raw['started_utc'], 'finished_utc': raw['finished_utc'],\n            'required_ids': [row['id']], 'log': reference(root, path.parent / actual['log']),\n            'candidate': qualified['candidate'], 'raw': reference(root, path),\n            'original_runner_inputs': raw['inputs_before'],\n            'reason': chosen['reason'], 'evidence': {}}, 'check result changed original execution binding')\n    runtime_plan = read(bound(root, qualified['runtime_plan']))\n    require(runtime_plan == dict(plan, requirements=[r for r in plan['requirements'] if r['id'] not in selected]),\n            'runtime plan does not match test/native subset')\n    runtime = dict(qualified, plan=qualified['runtime_plan'],\n                   coverage=[row for row in rows if row['id'] not in selected])\n    require(all(row['disposition'] == 'executed' for row in runtime['coverage']),\n            'changed P11 test/native coverage was not executed')\n    result = coverage.verify(root, runtime, historical=historical)\n    result['required'] += len(selected)\n    for row in selected.values():\n        mode = row['disposition']\n        result['dispositions'][mode] = result['dispositions'].get(mode, 0) + 1\n    return result\n\n\ndef verify(root, path):\n    record = read(path)\n    require(record['schema'] == 'airs-desktop/p11-shared-qualification/1', 'P11 proof schema')\n    require(set(record['runner_inputs']) == {'source', 'dependencies', 'build_flags'},\n            'P11 runner input keys differ')\n    require(record['runner_inputs']['source'] == xtask_source(root),\n            'current source does not match actual runner source fingerprint')\n    seal = read(bound(root, record['source']))\n    require(source_inventory(root) == seal['files'], 'P11 source changed after qualification')\n    qualified = read(bound(root, record['coverage']))\n    require(digest(seal['files']) == qualified['source_inventory_sha256'], 'P11 source binding')\n    if 'review_remediation' in record:\n        require(qualified.get('review_remediation') == record['review_remediation'],\n                'review remediation qualification binding differs')\n    elif 'helper_source_carry' in record:\n        validate_helper_source_carry(root, bound(root, record['helper_source_carry']), record['runner_inputs'])\n    elif 'impact_selection' in record:\n        validate_impact_selection(root, bound(root, record['impact_selection']), record['runner_inputs'])\n    else:\n        for kind in ('check', 'test'):\n            validate_run(root, bound(root, record['runs'][kind]), kind, record['runner_inputs'])\n    inputs = read(bound(root, record['fingerprint']))\n    require(record['runner_inputs'] == {key: inputs[key] for key in record['runner_inputs']},\n            'P11 observed current fingerprint mismatch')\n    current = current_fingerprints(root)\n    require(record['runner_inputs'] == {key: current[key] for key in record['runner_inputs']},\n            'current dependency/toolchain/build flags differ from executed checks')\n    result = verify_coverage(root, qualified)\n    candidate = read(bound(root, qualified['candidate']))\n    from candidate import verify_candidate\n    verify_candidate(root, candidate)\n    performed = read(bound(root, record['native_execution']))\n    if 'review_remediation' in record:\n        remedy = read(bound(root, record['review_remediation']))\n        recovery = read(bound(root, remedy['recovery']))\n        require(record['native_execution'] == recovery['raw']\n                and candidate['helper_closure'] == recovery['helper_closure'],\n                'affected recovery helper/execution membership changed')\n    else:\n        require(candidate['helper_closure'] == helper_closure(root, native_driver(root, performed)),\n                'P11 native helper membership changed')\n        validate_execution(root, performed, candidate,\n            acceptance=bound(root, record['native_acceptance']) if 'native_acceptance' in record else None,\n            execution=bound(root, record['native_execution']))\n    build_path = bound(root, record['build'])\n    build = read(build_path)\n    require(build['application_inputs_unchanged'] is True\n            and all(step['exit_code'] == 0 for step in build['steps']), 'fixture build failed/drifted')\n    if 'review_remediation' in record:\n        import remediation\n        remediation.versioned_build(root, build, candidate)\n    else:\n        require([step['argv'] for step in build['steps']] == [\n            ['pnpm', '--filter', '@prisma-airs/desktop-contracts', 'typecheck'],\n            ['pnpm', '--filter', '@prisma-airs/desktop', 'typecheck'],\n            ['cargo', 'run', '--locked', '-p', 'xtask', '--', 'native-prepare', '--phase', 'P11',\n             '--target', 'aarch64-apple-darwin', '--features', 'test-fixtures']],\n            'missing or changed fixture build invocation')\n    require(set(build['application_inputs_before']) == application_files(root),\n            'built application input membership differs or is incomplete')\n    require(read(build_path.parent / 'native-prepare.json') == read(bound(root, candidate['prepare'])),\n            'prepared candidate differs from retained actual build output')\n    for step in build['steps']:\n        log = (build_path.parent / step['log']).resolve()\n        require(log.is_relative_to(root.resolve()) and sha(log) == step['log_sha256'],\n                'fixture build log drift')\n    changed = [name for name, value in build['application_inputs_before'].items()\n               if sha(root / name) != value]\n    if changed:\n        carry_schema = read(bound(root, record['build_input_carry']))['schema']\n        if carry_schema == 'airs-desktop/rust-test-build-carry/1':\n            rust_test_carry(root, record, build_path, build, candidate, changed)\n    bound(root, supplement['execution']); bound(root, supplement['source'])\n    needed = {'missing_restore_warning_visible', 'recovery_survives_home_back', 'retry_is_explicit',\n              'retry_recovers_when_root_restored', 'intentional_close_stays_closed'}\n    require(supplement['schema'] == 'airs-desktop/p11-recovery-supplement/1'\n            and supplement['baseline_qualification'] == baseline\n            and needed <= set(supplement['facts'])\n            and supplement['facts'] == raw['facts'] and all(v is True for v in raw['facts'].values()),\n            'affected recovery observations incomplete')\n    require(completed(raw) and raw['cwd'] == candidate['execution_root']\n            and supplement['prepare'] == candidate['prepare']\n            and raw['source_sha256'] == supplement['source']['sha256']\n            and all(supplement[k] == raw[k] == candidate[k] for k in ('executable_sha256', 'bundle_sha256'))\n            and raw['conditions'] == candidate['conditions'], 'recovery execution/candidate differs')\n    require(supplement['helper_closure'] == raw.get('helper_closure') and supplement['helper_closure']\n            and all(files.get(n, {}).get('sha256') == value\n            for n, value in supplement['helper_closure'].items()), 'recovery helper inputs changed')\n    require(supplement['retained_result'] == old_result and supplement['retained_reason'],\n            'old N03 first-use/save observations were lost or retagged')\n    require(supplement['captures'], 'recovery pixels missing')\n    for image in supplement['captures']:\n        bound(root, image)\n        require(image['visually_reviewed'] is True and image['accepted'] is True and not image['findings'],\n                'recovery capture not individually accepted')\n    return supplement\n\n\nSOURCE_IDS = {'check:C46/check/1', 'check:C46/check/4', 'test:C47/fixture', 'test:C48/frontend/1', 'test:C48/frontend/2'}\n\n\ndef verify_coverage(root, qualified, historical=None):\n    receipt = read(bound(root, qualified['review_remediation']))\n    candidate = read(bound(root, qualified['candidate']))\n    source = historical.source(qualified['source_inventory_sha256']) if historical else root\n    files = read(bound(root, receipt['current_source']))['files']\n    require(digest(files) == qualified['source_inventory_sha256']\n            and files == ({str(p.relative_to(source)): proof.file_identity(p) for p in source.rglob('*')\n                           if p.is_file() or p.is_symlink()} if historical else proof.source_inventory(root)),\n            'remediation current source differs')\n    require(receipt['schema'] == 'airs-desktop/p11-review-remediation/1'\n            and receipt['runner_inputs'] == candidate['runner_inputs'], 'remediation source binding missing')\n    original_record, original_coverage, history = source_transition(root, receipt, candidate, source, files)\n    source_qa(root, receipt['source_qa'], files)\n    originals = {r['id']: r for r in original_coverage['coverage']}\n    recovery(root, receipt['recovery'], receipt['baseline'], candidate, originals['C48-N03']['result'], files)\n    modes = {cid: 'executed' if cid in SOURCE_IDS | {'C48-N03'} else 'carried_unaffected' for cid in originals}\n    plan = read(bound(root, qualified['plan']))\n    proof.verify_plan(source, plan, modes)\n    rows = qualified['coverage']\n    require(len(rows) == len(originals) and {r['id'] for r in rows} == set(originals), 'remediation coverage missing/duplicated')\n    require(set(receipt['unaffected']) == set(originals)-SOURCE_IDS-{'C48-N03'}, 'unchanged-impact reason missing')\n    requirements = {r['id']: r for r in plan['requirements']}\n    for row in rows:\n        cid = row['id']; require(row['disposition'] == modes[cid], 'remediation disposition differs')\n        if cid in SOURCE_IDS | {'C48-N03'}:\n            expected = {'schema': 'airs-desktop/p11-affected-selector-result/1', 'required_id': cid,\n                'actual_evidence': selector_reference(receipt, cid),\n                'original_result': originals[cid]['result'],\n                'meaning': 'Actual affected selectors supplement the retained original registered goal. No full original command or unrelated native flow is claimed newly executed.'}\n            require(read(bound(root, row['result'])) == expected, 'affected goal lacks actual selector evidence')\n            continue\n        require(row['result'] == originals[cid]['result'] and receipt['unaffected'][cid], 'original result was relabelled')\n        original = read(bound(root, row['result'])); origin = read(bound(root, original['candidate']))\n        deps = dependencies(files, cid, requirements[cid].get('helper_paths', []))\n        require(requirements[cid].get('dependencies') == deps\n                and row['impact']['dependencies'] == deps\n                and row['impact']['reason'] == receipt['unaffected'][cid]\n                and row['impact']['original_candidate_sha256'] == original['candidate']['sha256'],\n                'remediation dependency scope/rationale differs')\n        impact = read(bound(root, row['impact']['proof']))\n        bindings = impact['file_bindings']\n        require(set(bindings) == set(deps) and deps\n                and impact['unchanged_dependencies'] == deps\n                and impact['current_source_inventory_sha256'] == qualified['source_inventory_sha256']\n                and impact['original_candidate_sha256'] == original['candidate']['sha256'],\n                'remediation dependency proof binding differs')\n        old_source = history.source(origin['source_inventory_sha256'])\n        for name in deps:\n            value = bindings[name]\n            require(value['original_sha256'] == value['current_sha256'] == sha(source/name) == sha(old_source/name),\n                    'carried dependency changed: ' + name)\n    # The old custom partial Check rows were already validated above in their\n    # archived source. Their failed full-run status must not be rewritten to\n    # satisfy the generic all-pass-run parser. Other original raw rows use it.\n    generic_ids = {cid for cid in originals if cid not in SOURCE_IDS | {'C48-N03'} and not cid.startswith('check:')}\n    runtime_plan = read(bound(root, qualified['runtime_plan']))\n    require(runtime_plan == dict(plan, requirements=[r for r in plan['requirements'] if r['id'] in generic_ids]),\n            'remediation generic coverage projection differs')\n    proof.coverage.verify(root, dict(qualified, plan=qualified['runtime_plan'],\n        coverage=[r for r in rows if r['id'] in generic_ids]), historical=historical)\n    return {'qualified': True, 'required': len(rows),\n            'dispositions': {m: sum(r['disposition'] == m for r in rows) for m in sorted(set(modes.values()))},\n            'candidate_sha256': qualified['candidate']['sha256'], 'source_inventory_sha256': qualified['source_inventory_sha256']}\n\n\ndef versioned_build(root, build, candidate):\n    path = candidate['prepare']['path']\n    prefix, suffix = 'docs/planning/evidence/P11/native-build-', '-vm/native-prepare.json'\n    number = path.removeprefix(prefix).removesuffix(suffix)\n16:def digest(value):\n20:def file_identity(path):\n31:def source_inventory(root):\n","exit_code":0,"status":"completed"}}
