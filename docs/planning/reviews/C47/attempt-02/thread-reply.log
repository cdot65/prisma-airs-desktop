{"type":"item.completed","item":{"id":"item_35","type":"command_execution","command":"/bin/zsh -lc \"rg -n '\"'^class Archived|''^    def |subprocess|mkdir|write|extract'\"' tools/p11/standing.py; cat apps/desktop/src/shell/feature-body.tsx; sed -n '40,96p' apps/desktop/src/app.tsx; sed -n '250,345p' crates/desktop-core/src/transport.rs; sed -n '1840,1882p' crates/desktop-core/src/authority.rs; sed -n '3608,3638p' crates/desktop-core/src/authority.rs\"","aggregated_output":"11:import subprocess\n37:class ArchivedP11(Historical):\n39:    def archive_path(self, name):\n76:    result = subprocess.run(['/usr/bin/git', 'check-attr', '-z', 'filter', '--', *LFS_PATHS],\n175:    destination.mkdir(parents=True, exist_ok=False)\n177:    def write(name, value):\n181:            stream.write('\\n')\n185:    source.mkdir()\n191:        archived.parent.mkdir(parents=True, exist_ok=True)\n200:    source_seal = write('source-seal.json', seal)\n220:    context = write('historical-context.json', {\n226:    evidence_ref = write('evidence-inventory.json', {'files': evidence})\n235:        stream.write('\\n')\nimport { forwardRef, useCallback } from 'react'\nimport type { DesktopClient, FeatureEntry, FeatureId, ShellSnapshot, Theme } from '@prisma-airs/desktop-contracts'\nimport { SessionsView } from '../modules/sessions/sessions-view'\nimport type { Dispatch } from '../modules/tenants/dispatch'\nimport { SettingsView, UnavailableView } from './feature-view'\n\nexport interface FeatureBodyProps {\n    feature: FeatureEntry\n    snapshot: ShellSnapshot\n    appearancePending: boolean\n    onSetAppearance: (theme: Theme) => void\n    onNavigate: (id: FeatureId) => void\n    dispatch: Dispatch\n    /** The native client, for management observations. */\n    client: DesktopClient\n}\n\n/**\n * The destinations the v2 shell frames without a board of their own (C44):\n * Settings, Sessions & Reports and the reviewed v1 import, keyed by the\n * active context where a view must never outlive its credential. Every\n * other destination is a v2 screen; the legacy shell and its views are gone.\n */\nexport const FeatureBody = forwardRef<HTMLHeadingElement, FeatureBodyProps>(function FeatureBody(props, heading) {\n    const { feature, snapshot } = props\n    const client = props.client\n    const observeManagement = useCallback((operation: string) => client.observeManagement(operation), [client])\n    return (\n        <>\n            {feature.id === 'settings' ? (\n                <SettingsView\n                    ref={heading}\n                    snapshot={snapshot}\n                    pending={props.appearancePending}\n                    onSetAppearance={props.onSetAppearance}\n                    dispatch={props.dispatch}\n                    observeManagement={observeManagement}\n                />\n            ) : feature.id === 'sessions' && feature.availability.state === 'available' ? (\n                <SessionsView\n                    // A new tenant or management credential remounts the view:\n                    // revealed content never outlives its credential.\n                    key={snapshot.active?.context ?? 'none'}\n                    ref={heading}\n                    snapshot={snapshot}\n                    dispatch={props.dispatch}\n                    observe={observeManagement}\n                    onNavigate={props.onNavigate}\n                />\n            ) : (\n                <UnavailableView ref={heading} feature={feature} />\n            )}\n        </>\n    )\n})\n        [client]\n    )\n\n    // v2 (C28): navigation is Rust-owned. The native menu, the sidebar and\n    // the palette all dispatch `navigate`; refusals reach the status surface.\n    const v2Navigate = useCallback(\n        async (feature: FeatureId) => {\n            useShellStore.getState().closePalette()\n            const intent: Intent = { kind: 'navigate', feature }\n            const outcome = await dispatch(intent)\n            if (outcome.kind === 'refused') useShellStore.getState().toast(SHELL_COPY.toastRefused('Navigation', outcome.refusal), 'warn')\n            // Unknown delivery is kept inline with Retry; never an expiring toast alone.\n            else if (outcome.kind === 'unknown') useShellStore.getState().addUnconfirmed('Navigation', intent)\n            else if (outcome.kind === 'failed') useShellStore.getState().toast(SHELL_COPY.toastFailed('Navigation'), 'warn')\n        },\n        [dispatch]\n    )\n    // Every v2 action's outcome reaches the shell's surfaces (DESIGN-V2 §7):\n    // a refusal or failed delivery as a warn toast naming what was asked, an\n    // unconfirmed delivery inline with Retry, never replayed on its own.\n    const v2Act = useCallback(\n        async (what: string, intent: Intent, quiet: Refusal[] = []): Promise<DispatchOutcome> => {\n            // A context-bound action speaks for the tenant it was sent in (I2).\n            const boundContext = deliveryContext(intent)\n            // A normal switch refusal still names its intended destination,\n            // but an uncertain switch must not offer Retry in another scope.\n            const retryContext = boundContext ?? (intent.kind === 'selectTenant' ? snapshotRef.current?.active?.context ?? null : null)\n            const bound = boundContext !== null ? (snapshotRef.current?.active?.tenant ?? null) : null\n            const outcome = await dispatch(intent)\n            if (outcome.kind === 'refused' && quiet.includes(outcome.refusal)) return outcome\n            if (outcome.kind === 'refused') useShellStore.getState().toast(SHELL_COPY.toastRefused(what, outcome.refusal, outcomeMessage(outcome)), 'warn', undefined, bound, boundContext)\n            else if (outcome.kind === 'unknown') useShellStore.getState().addUnconfirmed(what, intent, retryContext)\n            else if (outcome.kind === 'failed') useShellStore.getState().toast(SHELL_COPY.toastFailed(what), 'warn', undefined, bound, boundContext)\n            return outcome\n        },\n        [dispatch]\n    )\n    const v2Preference = useCallback(\n        async (what: string, intent: Intent, quiet: Refusal[] = []) => {\n            await v2Act(what, intent, quiet)\n        },\n        [v2Act]\n    )\n\n    const onMenu = useRef<(command: MenuCommand) => void>(() => undefined)\n    onMenu.current = (command: MenuCommand) => {\n        // Native navigation dismisses the modal palette first so focus can\n        // move to the new page heading instead of behind an open dialog.\n        if (command.kind === 'navigate') void v2Navigate(command.feature)\n        else if (command.kind === 'commandPalette') useShellStore.getState().openPalette()\n        // ⌘T: the tenant switcher opens; nothing switches until chosen.\n        else if (command.kind === 'tenantSwitcher') useShellStore.getState().setSwitcher(true)\n        // The open API Client request saves (its editor listens).\n        else if (command.kind === 'saveDocument') window.dispatchEvent(new Event(SAVE_DOCUMENT_EVENT))\n        else void v2Preference('The appearance change', { kind: 'setAppearance', theme: command.theme })\n    }\n\n#[serde(rename_all = \"camelCase\")]\npub enum CallCredential {\n    ScanKey,\n    ManagementClient,\n    WorkspaceKey,\n}\n\n/// Whose call it was and why (C33).\n#[derive(Clone, Debug)]\npub struct CallTag {\n    pub tenant: String,\n    pub purpose: CallPurpose,\n    pub credential: CallCredential,\n}\n\n/// One call as \"Show the calls\" shows it (C33): the request line without its\n/// query, header names (never values) and sizes, and the response status,\n/// duration and content type. Bodies are never kept: a response can carry\n/// an issued key or a token, and request bodies carry tenant content.\n#[derive(Clone, Debug, PartialEq, Eq, serde::Serialize, ts_rs::TS)]\n#[serde(rename_all = \"camelCase\")]\npub struct CallView {\n    /// Increasing per app run.\n    #[ts(type = \"number\")]\n    pub sequence: u64,\n    pub purpose: CallPurpose,\n    pub credential: CallCredential,\n    pub method: String,\n    /// `https://host[:port]`.\n    pub origin: String,\n    pub path: String,\n    /// The URL carried a query (withheld).\n    pub query: bool,\n    /// Request header names, sorted; the credential header is named but\n    /// its value is the core's alone.\n    pub request_headers: Vec<String>,\n    #[ts(type = \"number\")]\n    pub request_bytes: u64,\n    /// The response status; absent when the call failed before one.\n    pub status: Option<u16>,\n    /// Until the response head (or the failure).\n    #[ts(type = \"number\")]\n    pub duration_ms: u64,\n    pub content_type: Option<String>,\n    pub response_headers: Vec<String>,\n}\n\n/// Calls recorded for \"Show the calls\", newest last (C33): in memory only,\n/// the newest [`MAX_CALLS`] of the app run.\n#[derive(Clone, Default)]\npub struct CallLog(Arc<Mutex<CallRecords>>);\n\n#[derive(Default)]\nstruct CallRecords {\n    next: u64,\n    calls: VecDeque<(String, CallView)>,\n}\n\n/// Calls the log keeps (all tenants together).\npub const MAX_CALLS: usize = 200;\n/// Calls a tenant's view shows, newest last.\npub const MAX_SHOWN_CALLS: usize = 50;\n\nimpl CallLog {\n    fn record(&self, tenant: &str, call: impl FnOnce(u64) -> CallView) {\n        if let Ok(mut log) = self.0.lock() {\n            log.next += 1;\n            let view = call(log.next);\n            log.calls.push_back((tenant.to_owned(), view));\n            while log.calls.len() > MAX_CALLS {\n                log.calls.pop_front();\n            }\n        }\n    }\n\n    /// A tenant's newest calls, oldest first.\n    pub fn for_tenant(&self, tenant: &str) -> Vec<CallView> {\n        let Ok(log) = self.0.lock() else {\n            return Vec::new();\n        };\n        let mut shown: Vec<CallView> = log\n            .calls\n            .iter()\n            .rev()\n            .filter(|(t, _)| t == tenant)\n            .take(MAX_SHOWN_CALLS)\n            .map(|(_, c)| c.clone())\n            .collect();\n        shown.reverse();\n        shown\n    }\n\n    /// Forgets a tenant's calls (it was removed).\n    pub fn forget(&self, tenant: &str) {\n        if let Ok(mut log) = self.0.lock() {\n            log.calls.retain(|(t, _)| t != tenant);\n    }\n\n    /// The operator's choice, else on until onboarding completes (C33).\n    fn show_calls(&self) -> bool {\n        self.data\n            .show_calls\n            .unwrap_or(self.shown_onboarding() != features::OnboardingState::Done)\n    }\n\n    /// The active destination: the last admitted `navigate` while it stays\n    /// in the current catalogue, else the presentation's first sidebar entry.\n    fn active_feature(&self) -> FeatureId {\n        self.active_feature\n            .filter(|f| features::catalogue().iter().any(|e| e.id == *f))\n            .unwrap_or_else(features::default_feature)\n    }\n\n    fn snapshot(&self) -> ShellSnapshot {\n        ShellSnapshot {\n            revision: self.revision.to_string(),\n            appearance: self.appearance(),\n            color_theme: self.color_theme(),\n            onboarding: self.shown_onboarding(),\n            active_feature: self.active_feature(),\n            show_calls: self.show_calls(),\n            calls: self\n                .data\n                .active\n                .as_ref()\n                .filter(|_| self.show_calls())\n                .map(|t| self.calls.for_tenant(t.as_str())),\n            switch_blocked: self.switch_blocked.clone(),\n            setup: self.setup_view(),\n            features: features::catalogue(),\n            fixture_build: cfg!(feature = \"test-fixtures\"),\n            storage: self.storage,\n            // An import's tenants show once it commits (D050).\n            tenants: self\n                .data\n                .tenants\n                .iter()\n                .map(|t| self.warning_recheck_view(tenant_view(t)))\n                .collect(),\n            if current != next {\n                let before = state.data.clone();\n                state.data.onboarding = Some(next);\n                if state.storage == StorageHealth::Ready\n                    && let Err(e) = state.save_with(&before)\n                {\n                    return Err(e);\n                }\n                state.changed();\n            }\n        }\n        Intent::SetShowCalls { on } => {\n            // The operator's choice holds from now on, onboarding or not (C33).\n            if state.data.show_calls != Some(on) {\n                let before = state.data.clone();\n                state.data.show_calls = Some(on);\n                if state.storage == StorageHealth::Ready\n                    && let Err(e) = state.save_with(&before)\n                {\n                    return Err(e);\n                }\n                state.changed();\n            }\n        }\n        Intent::BeginTenantSetup { mode, profile } => {\n            state.require_storage()?;\n            let before = state.data.clone();\n            state.begin_setup(mode, profile)?;\n            state.save_with(&before)?;\n            state.changed();\n        }\n","exit_code":0,"status":"completed"}}
