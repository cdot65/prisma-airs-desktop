py.ts                        |   3 +-\n apps/desktop/src/v2/explain-drawer.tsx             |  48 ++++\n apps/desktop/src/v2/harness/harness.test.tsx       |   5 +-\n apps/desktop/src/v2/harness/harness.tsx            |  26 +-\n apps/desktop/src/v2/home.tsx                       |  19 +-\n apps/desktop/src/v2/icons.tsx                      |   3 +-\n apps/desktop/src/v2/inbox/inbox.tsx                |  49 +++-\n apps/desktop/src/v2/inbox/setup-warning.test.tsx   | 105 ++++++++\n apps/desktop/src/v2/modal.tsx                      |  29 ++-\n apps/desktop/src/v2/page-intro.tsx                 |  22 ++\n .../src/v2/settings/management-credential.test.tsx |   6 +-\n .../src/v2/settings/refinement-settings.test.tsx   |  92 +++++++\n .../src/v2/settings/setup-warning-history.test.tsx |  40 +++\n apps/desktop/src/v2/setup-warning-history.tsx      |  40 +++\n apps/desktop/src/v2/shell-refinement.test.tsx      | 118 +++++++++\n apps/desktop/src/v2/store.ts                       |  41 ++-\n apps/desktop/src/v2/v2-shell.test.tsx              |  26 ++\n apps/desktop/src/v2/v2-shell.tsx                   |  97 ++++---\n apps/desktop/src/v2/wizard/copy.ts                 |  34 +--\n apps/desktop/src/v2/wizard/fixtures.ts             |  30 ++-\n apps/desktop/src/v2/wizard/wizard-boards.test.tsx  |  12 +-\n apps/desktop/src/v2/wizard/wizard.test.tsx         |  53 ++--\n apps/desktop/src/v2/wizard/wizard.tsx              |  14 +-\n apps/desktop/src/v2/workbench/api-client.test.tsx  | 284 +++++++++++++++++++--\n apps/desktop/src/v2/workbench/api-client.tsx       |  99 +++++--\n apps/desktop/src/v2/workbench/calls-panel.tsx      |   8 +-\n apps/desktop/src/v2/workbench/copy.ts              |   7 +-\n .../desktop/src/v2/workbench/json-presentation.tsx | 125 +++++++++\n .../src/v2/workbench/presentation-status.ts        |  13 +\n apps/desktop/src/v2/workbench/request-editor.tsx   |  58 ++---\n .../src/v2/workbench/request-presentation.test.ts  |  28 ++\n apps/desktop/src/v2/workbench/request-rows.ts      |   8 +-\n apps/desktop/src/v2/workbench/response-pane.tsx    |  46 ++--\n apps/desktop/src/v2/workbench/test-cases.tsx       |  37 +--\n apps/desktop/src/v2/workbench/workbench.test.tsx   |  10 +-\n 60 files changed, 1905 insertions(+), 645 deletions(-)\nimport { useEffect, useRef, type KeyboardEvent } from 'react'\nimport type { ShellSnapshot } from '@prisma-airs/desktop-contracts'\nimport type { Dispatch } from '../modules/tenants/dispatch'\nimport { useShellStore } from './store'\nimport { CallsPanel } from './workbench/calls-panel'\n\n/** Nonmodal: only this drawer owns its Escape; navigation and the page stay live. */\nexport function ExplainDrawer({ snapshot, dispatch, onClose, returnFocus, modalOpen }: { snapshot: ShellSnapshot; dispatch: Dispatch; onClose: () => void; returnFocus: HTMLElement | null; modalOpen: boolean }) {\n    const panel = useRef<HTMLDivElement>(null)\n    const restoreFocus = useRef(false)\n    const focusWithin = useRef(false)\n    const close = () => {\n        restoreFocus.current = Boolean(panel.current?.contains(document.activeElement))\n        onClose()\n    }\n    useEffect(() => {\n        // An explicit open moves focus; a persisted preference on launch does not.\n        if (returnFocus && useShellStore.getState().modals.length === 0) panel.current?.querySelector<HTMLButtonElement>('button')?.focus()\n        return () => {\n            if (!restoreFocus.current && !focusWithin.current) return\n            queueMicrotask(() => {\n                if (useShellStore.getState().modals.length > 0 || (document.activeElement && document.activeElement !== document.body)) return\n                if (returnFocus?.isConnected) returnFocus.focus()\n                else document.querySelector<HTMLElement>('[data-slot=\"page-heading\"]')?.focus()\n            })\n        }\n    }, [returnFocus])\n    const onKeyDown = (event: KeyboardEvent<HTMLDivElement>) => {\n        if (event.key !== 'Escape' || event.defaultPrevented || modalOpen) return\n        event.preventDefault()\n        event.stopPropagation()\n        close()\n    }\n    return (\n        <div\n            ref={panel}\n            id='explain-drawer'\n            data-slot='explain-drawer'\n            data-desktop-theme=''\n            onKeyDown={onKeyDown}\n            onFocusCapture={() => { focusWithin.current = true }}\n            onBlurCapture={(event) => { focusWithin.current = event.relatedTarget instanceof Node && event.currentTarget.contains(event.relatedTarget) }}\n            style={{ position: 'absolute', zIndex: 30, top: 0, right: 0, bottom: 0, width: 'min(420px, 100%)', overflowY: 'auto', background: 'var(--v2-paper)', borderLeft: '1px solid var(--v2-rule)', boxShadow: '-12px 0 28px rgba(0,0,0,0.16)' }}\n        >\n            <CallsPanel snapshot={snapshot} dispatch={dispatch} onClose={close} />\n        </div>\n    )\n}\nimport type { ReactNode } from 'react'\n\n/** A page's description and controls; its title belongs to the shell header. */\nexport function PageIntro({ description, actions, status, className = '' }: { description: ReactNode; actions?: ReactNode; status?: ReactNode; className?: string }) {\n    return (\n        <div data-slot='page-intro' className={`flex min-w-0 flex-wrap items-center ${className}`} style={{ gap: '10px 16px' }}>\n            <div data-slot='page-description' className='min-w-0 text-[14px]' style={{ flex: '1 1 20rem', maxWidth: '52rem', color: 'var(--v2-soft)', overflowWrap: 'anywhere' }}>\n                {description}\n            </div>\n            {actions && (\n                <div data-slot='page-actions' className='ml-auto flex min-w-0 flex-wrap items-center' style={{ maxWidth: '100%', gap: 8 }}>\n                    {actions}\n                </div>\n            )}\n            {status && (\n                <div data-slot='page-intro-status' className='w-full min-w-0'>\n                    {status}\n                </div>\n            )}\n        </div>\n    )\n}\n     621 apps/desktop/src/v2/v2-shell.tsx\n      55 apps/desktop/src/styles.css\n    1033 tools/p11/proof.py\n     131 tools/p11/review.py\n     482 tools/p11/remediation.py\n    2322 total\n","exit_code":0,"status":"completed"}}
