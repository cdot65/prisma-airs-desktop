{"type":"item.completed","item":{"id":"item_40","type":"command_execution","command":"/bin/zsh -lc \"cat apps/desktop/src/v2/modal.test.tsx; sed -n '1,95p' apps/desktop/src/v2/v2-shell.test.tsx; rg -n 'showCalls|Show the calls|appearance|navigation|focus|sun' apps/desktop/src/v2/v2-shell.test.tsx; sed -n '1,44p' apps/desktop/src/app.tsx; sed -n '284,376p' apps/desktop/src/v2/workbench/api-client.tsx; sed -n '1,70p' apps/desktop/src/v2/icons.tsx\"","aggregated_output":"/**\n * I8 at the shared modal boundary: two stacked dialogs keep keyboard\n * interaction inside the topmost, the lower one is inert and hidden, Escape\n * closes only the top, and each opener gets its focus back.\n */\nimport { render, screen, waitFor } from '@testing-library/react'\nimport userEvent from '@testing-library/user-event'\nimport { beforeEach, describe, expect, it } from 'vitest'\nimport { useState } from 'react'\nimport { Modal } from './modal'\nimport { resetShellStore, useShellStore } from './store'\n\nfunction Stack() {\n    const [outer, setOuter] = useState(false)\n    const [inner, setInner] = useState(false)\n    return (\n        <div>\n            <button type='button' onClick={() => setOuter(true)}>\n                Open outer\n            </button>\n            <button type='button'>Page control</button>\n            {outer && (\n                <Modal label='Outer' onClose={() => setOuter(false)}>\n                    <button type='button' onClick={() => setInner(true)}>\n                        Open inner\n                    </button>\n                    <button type='button'>Outer second</button>\n                </Modal>\n            )}\n            {inner && (\n                <Modal label='Inner' onClose={() => setInner(false)}>\n                    <input aria-label='Inner field' />\n                    <button type='button'>Inner done</button>\n                </Modal>\n            )}\n        </div>\n    )\n}\n\nbeforeEach(() => resetShellStore())\n\ndescribe('modal stack (I8)', () => {\n    it('keeps only the topmost dialog interactive, traps Tab, closes top-first on Escape and restores each opener', async () => {\n        const user = userEvent.setup()\n        render(<Stack />)\n        const openOuter = screen.getByRole('button', { name: 'Open outer' })\n        openOuter.focus()\n        await user.keyboard('{Enter}')\n        const outer = screen.getByRole('dialog', { name: 'Outer' })\n        expect(outer).toHaveAttribute('aria-modal', 'true')\n        expect(screen.getByRole('button', { name: 'Open inner' })).toHaveFocus()\n        // Tab wraps inside the outer dialog.\n        await user.tab()\n        expect(screen.getByRole('button', { name: 'Outer second' })).toHaveFocus()\n        await user.tab()\n        expect(screen.getByRole('button', { name: 'Open inner' })).toHaveFocus()\n        await user.tab({ shift: true })\n        expect(screen.getByRole('button', { name: 'Outer second' })).toHaveFocus()\n        // Open the inner dialog: the outer one becomes inert and hidden.\n        await user.click(screen.getByRole('button', { name: 'Open inner' }))\n        const inner = screen.getByRole('dialog', { name: 'Inner' })\n        expect(inner).toHaveAttribute('aria-modal', 'true')\n        expect(outer).not.toHaveAttribute('aria-modal')\n        expect(outer).toHaveAttribute('data-topmost', 'false')\n        expect(outer.parentElement).toHaveAttribute('aria-hidden', 'true')\n        expect(outer.parentElement).toHaveAttribute('inert')\n        expect(useShellStore.getState().modals).toHaveLength(2)\n        expect(screen.getByRole('textbox', { name: 'Inner field' })).toHaveFocus()\n        await user.tab()\n        await user.tab()\n        expect(screen.getByRole('textbox', { name: 'Inner field' })).toHaveFocus()\n        // Escape closes the inner dialog only; focus returns to its opener.\n        await user.keyboard('{Escape}')\n        expect(screen.queryByRole('dialog', { name: 'Inner' })).toBeNull()\n        expect(screen.getByRole('dialog', { name: 'Outer' })).toHaveAttribute('aria-modal', 'true')\n        expect(screen.getByRole('button', { name: 'Open inner' })).toHaveFocus()\n        await user.keyboard('{Escape}')\n        expect(screen.queryByRole('dialog')).toBeNull()\n        expect(openOuter).toHaveFocus()\n        expect(useShellStore.getState().modals).toHaveLength(0)\n    })\n\n    it('restores the exact non-first opener of a stacked dialog', async () => {\n        const user = userEvent.setup()\n        render(<Stack />)\n        await user.click(screen.getByRole('button', { name: 'Open outer' }))\n        // Open the inner dialog from the outer dialog's second control.\n        const second = screen.getByRole('button', { name: 'Outer second' })\n        second.focus()\n        await user.keyboard('{Enter}')\n        expect(screen.queryByRole('dialog', { name: 'Inner' })).toBeNull()\n        // 'Outer second' does nothing on Enter; open inner via its own control but with\n        // the opener recorded as 'Outer second' by focusing it right before the click.\n        second.focus()\n        const openInner = screen.getByRole('button', { name: 'Open inner' })\n        openInner.addEventListener('mousedown', (e) => e.preventDefault(), { once: true })\n        await user.click(openInner)\n        expect(screen.getByRole('dialog', { name: 'Inner' })).toHaveAttribute('aria-modal', 'true')\n        await user.keyboard('{Escape}')\n        expect(screen.queryByRole('dialog', { name: 'Inner' })).toBeNull()\n        await waitFor(() => expect(screen.getByRole('button', { name: 'Outer second' })).toHaveFocus())\n    })\n\n    it('Escape closes only the topmost dialog even when focus has left it (a native sheet returned focus to the page)', async () => {\n        const user = userEvent.setup()\n        render(<Stack />)\n        await user.click(screen.getByRole('button', { name: 'Open outer' }))\n        await user.click(screen.getByRole('button', { name: 'Open inner' }))\n        ;(document.activeElement as HTMLElement | null)?.blur()\n        expect(document.activeElement).toBe(document.body)\n        await user.keyboard('{Escape}')\n        await waitFor(() => expect(screen.queryByRole('dialog', { name: 'Inner' })).toBeNull())\n        expect(screen.getByRole('dialog', { name: 'Outer' })).toBeInTheDocument()\n    })\n\n    it('returns focus to the page heading when the opener no longer exists', async () => {\n        const user = userEvent.setup()\n        function Gone() {\n            const [open, setOpen] = useState(false)\n            const [opener, setOpener] = useState(true)\n            return (\n                <main>\n                    <h1 tabIndex={-1}>Page</h1>\n                    {opener && (\n                        <button type='button' onClick={() => setOpen(true)}>\n                            Open once\n                        </button>\n                    )}\n                    {open && (\n                        <Modal label='Once' onClose={() => setOpen(false)}>\n                            <button type='button' onClick={() => setOpener(false)}>\n                                Finish\n                            </button>\n                        </Modal>\n                    )}\n                </main>\n            )\n        }\n        render(<Gone />)\n        await user.click(screen.getByRole('button', { name: 'Open once' }))\n        await user.click(screen.getByRole('button', { name: 'Finish' }))\n        await user.keyboard('{Escape}')\n        await waitFor(() => expect(screen.queryByRole('dialog', { name: 'Once' })).toBeNull())\n        await waitFor(() => expect(screen.getByRole('heading', { name: 'Page' })).toHaveFocus())\n    })\n})\n/**\n * The production App over a scripted native transport, rendering the v2\n * shell (C28): the Rust catalogue drives the sidebar, every navigation is a\n * `navigate` intent, the palette and tenant switcher dispatch, preferences\n * dispatch, refusals reach the status surface as warn toasts, and the\n * accessibility invariants I8–I10 hold.\n */\nimport { act, render, screen, waitFor, within } from '@testing-library/react'\nimport userEvent from '@testing-library/user-event'\nimport { beforeEach, describe, expect, it } from 'vitest'\nimport { DesktopClient, type RuntimeOverview } from '@prisma-airs/desktop-contracts'\nimport { App } from '../app'\nimport { scriptedNative, tenant, type Native } from '../test/native'\nimport { fxHome, fxHomeDark, fxSwitcher } from './fixtures'\nimport { DeliveryOutcomeUnknown } from '@prisma-airs/desktop-contracts'\nimport { resetShellStore, useShellStore } from './store'\n\nasync function launch(snapshot = fxHome()): Promise<Native> {\n    const native = scriptedNative(snapshot)\n    render(<App client={new DesktopClient(native.transport)} />)\n    await screen.findByRole('navigation', { name: 'Destinations' })\n    return native\n}\n\nconst rail = () => within(screen.getByRole('navigation', { name: 'Destinations' }))\n/** The catalogue as a build without the Inbox would list it (an unavailable destination). */\nconst withUnavailableInbox = (snapshot: ReturnType<typeof fxHome>) => ({\n    ...snapshot,\n    features: snapshot.features.map((f) => (f.id === 'inbox' ? { ...f, availability: { state: 'unavailable' as const, reason: 'The Inbox arrives in C30', plannedChunk: 'C30' } } : f)),\n})\nconst intents = (native: Native) => native.dispatched.map((i) => i.kind)\n\nbeforeEach(() => {\n    resetShellStore()\n    document.documentElement.removeAttribute('data-theme')\n})\n\ndescribe('v2 shell', () => {\n    it.each(['prismaAirs', 'gruvbox'] as const)('keeps Settings Add outside inert shell ancestors in %s', async (colorTheme) => {\n        const user = userEvent.setup()\n        const native = await launch({ ...fxSwitcher(), activeFeature: 'settings', colorTheme })\n        await screen.findByRole('heading', { level: 1, name: 'Settings' })\n        const opener = screen.getByRole('button', { name: 'Add tenant…' })\n        await user.click(opener)\n        const dialog = document.querySelector<HTMLElement>('[data-slot=\"settings-add-tenant-sheet\"]')\n        expect(dialog).not.toBeNull()\n        expect(dialog).toHaveAttribute('aria-modal', 'true')\n        expect(dialog?.closest('[inert], [aria-hidden=\"true\"]')).toBeNull()\n        const host = dialog?.closest('[data-slot=\"desktop-modal-host\"]')\n        expect(host).toHaveAttribute('data-desktop-theme')\n        expect(host?.closest('[inert], [aria-hidden=\"true\"]')).toBeNull()\n        expect(host?.closest('[data-v2-shell]')).not.toBeNull()\n        expect(document.querySelector('[data-slot=\"app-main\"]')?.closest('[inert]')).not.toBeNull()\n        const visible = screen.getByRole('dialog', { name: 'Add a tenant' })\n        expect(within(visible).getByRole('heading', { name: 'Connect your tenant' })).toBeInTheDocument()\n        const field = within(visible).getByRole('textbox', { name: /Display name/ })\n        await user.type(field, 'Uncommitted local draft')\n        expect(field).toHaveValue('Uncommitted local draft')\n        await user.keyboard('{Escape}')\n        await waitFor(() => expect(screen.queryByRole('dialog')).toBeNull())\n        await waitFor(() => expect(opener).toHaveFocus())\n        expect(native.dispatched.filter((intent) => intent.kind !== 'navigate')).toEqual([])\n    })\n\n    it('renders the sidebar from the Rust catalogue with the menu shortcuts and marks an unavailable destination', async () => {\n        await launch(withUnavailableInbox(fxHome()))\n        const items = rail().getAllByRole('button').filter((b) => b.hasAttribute('data-inset-focus'))\n        expect(items.map((b) => b.textContent)).toEqual([\n            'Home⌘1',\n            'Inbox⌘2',\n            'Harness⌘3',\n            'Academy⌘4',\n            'Test Cases⌘5',\n            'API Client⌘6',\n            'Administration⌘7',\n        ])\n        expect(items[0]).toHaveAttribute('aria-current', 'page')\n        expect(items[1]).toHaveAttribute('aria-disabled', 'true')\n        expect(items[1]).toHaveAccessibleDescription('Not available: The Inbox arrives in C30')\n        expect(screen.getByRole('heading', { level: 1, name: 'Home' })).toBeInTheDocument()\n        expect(document.querySelector('[data-v2-shell]')).not.toBeNull()\n    })\n\n    it('dispatches navigate for the sidebar, the native menu and Home cards, never local state', async () => {\n        const user = userEvent.setup()\n        const native = await launch(withUnavailableInbox(fxHome()))\n        await user.click(rail().getByRole('button', { name: /Harness/ }))\n        expect(native.dispatched.at(-1)).toEqual({ kind: 'navigate', feature: 'harness' })\n        // The page changes only when the core reports it.\n        expect(screen.getByRole('heading', { level: 1, name: 'Home' })).toBeInTheDocument()\n        await native.push({ ...native.current, activeFeature: 'harness' })\n        expect(rail().getByRole('button', { name: /Harness/ })).toHaveAttribute('aria-current', 'page')\n        // An unavailable destination dispatches nothing.\n        await user.click(rail().getByRole('button', { name: /Inbox/ }))\n        expect(intents(native).filter((k) => k === 'navigate')).toHaveLength(1)\n3: * shell (C28): the Rust catalogue drives the sidebar, every navigation is a\n21:    await screen.findByRole('navigation', { name: 'Destinations' })\n25:const rail = () => within(screen.getByRole('navigation', { name: 'Destinations' }))\n67:        const items = rail().getAllByRole('button').filter((b) => b.hasAttribute('data-inset-focus'))\n102:    it('reports a refused navigation on the status surface as a warn toast', async () => {\n175:    it('dispatches the appearance and show-the-calls preferences from the rail toggle and the header switch', async () => {\n179:        // media query is shown dark, as the follower applies it (shell/appearance.ts).\n180:        expect(rail().getByRole('switch', { name: 'Switch light or dark appearance' })).toHaveAttribute('aria-checked', 'true')\n181:        await user.click(rail().getByRole('switch', { name: 'Switch light or dark appearance' }))\n183:        await native.push({ ...native.current, appearance: 'light' })\n184:        expect(rail().getByRole('switch', { name: 'Switch light or dark appearance' })).toHaveAttribute('aria-checked', 'false')\n185:        await user.click(rail().getByRole('switch', { name: 'Switch light or dark appearance' }))\n188:        const explain = screen.getByRole('switch', { name: 'Show the calls' })\n194:        expect(screen.queryByRole('navigation', { name: 'Features' })).toBeNull()\n195:        expect(screen.getByRole('navigation', { name: 'Destinations' })).toBeInTheDocument()\n226:    it('keeps one topmost modal: the palette over the switcher, Escape closes only the top, focus returns', async () => {\n230:        trigger.focus()\n287:    it('opens the tenant switcher from the native ⌘T command without switching, and returns focus to the trigger on Escape', async () => {\n329:    it('hands focus to the tenant list when ⌘T replaces an open palette, and Escape returns it to the trigger', async () => {\n344:    it('routes appearance through the same recovery path from the rail and the native menu', async () => {\n348:        await user.click(rail().getByRole('switch', { name: 'Switch light or dark appearance' }))\n350:        const toast = await screen.findByText(/^The appearance change was refused \\(deniedStore\\)\\./)\n353:        expect(rail().getByRole('switch', { name: 'Switch light or dark appearance' })).toHaveAttribute('aria-checked', 'true')\n359:        expect(strip).toHaveTextContent('The appearance change was sent but the desktop did not confirm it.')\n369:    it('focuses the tenant list after ⌘T even when focus inside an inert rail is refused, as WebKit does', async () => {\n373:        // WebKit refuses focus inside an inert subtree; jsdom does not, so refuse it here.\n374:        const descriptor = Object.getOwnPropertyDescriptor(HTMLElement.prototype, 'focus') as PropertyDescriptor\n375:        const realFocus = HTMLElement.prototype.focus\n376:        Object.defineProperty(HTMLElement.prototype, 'focus', {\n393:            Object.defineProperty(HTMLElement.prototype, 'focus', descriptor)\n567:    it('follows an OS appearance change while the preference is system: the toggle updates without a new snapshot and its next click picks the opposite (R2)', async () => {\n585:            const native = await launch({ ...fxHome(), appearance: 'system' })\n586:            const toggle = () => rail().getByRole('switch', { name: 'Switch light or dark appearance' })\n646:    it('lets Tab reach the palette’s \"Ask the Harness instead\" fallback, Enter opens the Harness once, and Escape returns focus to the search button (R4)', async () => {\n658:        const navigations = () => native.dispatched.filter((i) => i.kind === 'navigate' && i.feature === 'harness').length\n659:        const before = navigations()\n661:        expect(navigations()).toBe(before + 1)\n663:        // Escape from the fallback closes the palette and restores the opener's focus.\nimport { useCallback, useEffect, useLayoutEffect, useRef, useState } from 'react'\nimport {\n    DeliveryOutcomeUnknown,\n    type DesktopClient,\n    type FeatureId,\n    type Intent,\n    type MenuCommand,\n    type Refusal,\n    type ShellSnapshot,\n    type Theme,\n} from '@prisma-airs/desktop-contracts'\nimport { followAppearance } from './shell/appearance'\nimport { type DispatchOutcome, outcomeMessage } from './modules/tenants/dispatch'\nimport { V2Shell } from './v2/v2-shell'\nimport { Wizard } from './v2/wizard/wizard'\nimport { deliveryContext, useShellStore } from './v2/store'\nimport { SHELL_COPY } from './v2/copy'\nimport { forgetAcademyPresentation } from './modules/academy/presentation-storage'\nimport { SAVE_DOCUMENT_EVENT } from './v2/workbench/request-editor'\n\nexport function App({ client }: { client: DesktopClient }) {\n    const [snapshot, setSnapshot] = useState<ShellSnapshot | null>(null)\n    const snapshotRef = useRef<ShellSnapshot | null>(null)\n    snapshotRef.current = snapshot\n    const [failure, setFailure] = useState<string | null>(null)\n    const [pending, setPending] = useState(false)\n    const [status, setStatus] = useState('')\n\n    const dispatch = useCallback(\n        async (intent: Intent): Promise<DispatchOutcome> => {\n            try {\n                const response = await client.dispatch(intent)\n                return response.outcome === 'refusal'\n                    ? { kind: 'refused', refusal: response.refusal }\n                    : { kind: 'admitted', operation: response.receipt.operation }\n            } catch (error) {\n                return error instanceof DeliveryOutcomeUnknown ? { kind: 'unknown' } : { kind: 'failed' }\n            }\n        },\n        [client]\n    )\n\n    // v2 (C28): navigation is Rust-owned. The native menu, the sidebar and\n    // the palette all dispatch `navigate`; refusals reach the status surface.\n    statusOwner.current = editorOwner\n    const displayedStatus = editorStatus?.owner === editorOwner ? editorStatus.value : null\n    const displayed = displayedStatus?.response ?? null\n    useEffect(() => { tabStrip.current?.querySelector('[role=\"tab\"][aria-selected=\"true\"]')?.scrollIntoView({ block: 'nearest', inline: 'nearest' }) }, [collectionKey, selected])\n\n    const band = (\n        <div\n            data-slot='page-header-v2'\n            className='flex shrink-0 flex-wrap items-end'\n            style={{\n                gap: 12,\n                padding: 'var(--v2-page-top) var(--v2-page-x) 18px',\n                borderBottom: '1px solid var(--v2-rule)',\n            }}\n        >\n            <PageIntro className='w-full' description={<span data-slot='api-lead'>{collection ? C.description : C.leadNone}</span>} actions={collection ? (\n                <div className='ml-auto flex min-w-0 max-w-full flex-wrap items-center' style={{ gap: 8 }} data-slot='api-chips'>\n                    <span className='relative'>\n                        <button\n                            ref={chip}\n                            type='button'\n                            aria-haspopup='menu'\n                            aria-expanded={menu}\n                            aria-label={`${C.chips.collection} ${collection.name}`}\n                            className={CHIP}\n                            style={chipStyle}\n                            onClick={(e) => {\n                                e.stopPropagation()\n                                setMenu((m) => !m)\n                            }}\n                            data-slot='collection-chip'\n                        >\n                            <Glyph name='folder' size={13} color='var(--v2-ink)' />\n                            <span style={faint}>{C.chips.collection}</span>\n                            <b>{collection.name}</b>\n                            <span style={faint}>{where}</span>\n                            <Glyph name='chev' size={10} color='var(--v2-faint)' />\n                        </button>\n                        {menu ? (\n                            <div\n                                role='menu'\n                                aria-label={C.menu}\n                                className='absolute top-full right-0 z-10 mt-1 flex min-w-52 flex-col rounded-[10px] border p-1 text-[13px]'\n                                style={{\n                                    borderColor: 'var(--v2-rule)',\n                                    background: 'var(--v2-paper)',\n                                    boxShadow: '0 12px 30px rgba(0,0,0,0.18)',\n                                }}\n                                data-slot='collection-menu'\n                            >\n                                <button type='button' role='menuitem' className='rounded-[7px] px-3 py-1.5 text-left' onClick={() => void run({ kind: 'refresh' })}>\n                                    {C.refresh}\n                                </button>\n                                {TOOLS.map((t) => (\n                                    <button key={t} type='button' role='menuitem' className='rounded-[7px] px-3 py-1.5 text-left' aria-haspopup='dialog' onClick={() => setTool(t)}>\n                                        {C.tools[t]}\n                                    </button>\n                                ))}\n                                <button type='button' role='menuitem' className='rounded-[7px] px-3 py-1.5 text-left' onClick={() => void close({ kind: 'collection' })}>\n                                    {C.closeCollection}\n                                </button>\n                            </div>\n                        ) : null}\n                    </span>\n                    <label className={CHIP} style={chipStyle} data-slot='environment-chip'>\n                        <span\n                            aria-hidden\n                            className='rounded-full'\n                            style={{\n                                width: 8,\n                                height: 8,\n                                background: environment ? 'var(--v2-ok)' : 'var(--v2-faint)',\n                            }}\n                        />\n                        <span style={faint}>{C.chips.environment}</span>\n                        <select\n                            aria-label={C.chips.environment}\n                            value={collection.environment ?? ''}\n                            onChange={(e) =>\n                                void run({\n                                    kind: 'selectEnvironment',\n                                    name: e.target.value === '' ? null : e.target.value,\n                                })\n                            }\n                            className='min-h-0 border-0 bg-transparent font-bold'\n                            style={{\n                                border: 0,\n                                minHeight: 0,\n                                height: 24,\n                                padding: 0,\n                                borderRadius: 0,\n                                background: 'transparent',\n                                color: 'var(--v2-ink)',\nimport type { AdminProductId, FeatureId } from '@prisma-airs/desktop-contracts'\n\n/**\n * The prototype's own icon paths (R2App.dc.html `I`), 24-unit stroked\n * outlines, so the shell's glyphs match the design exactly (C35).\n */\nexport const PATHS = {\n    shield: 'M12 3l8 3v6c0 4.5-3.4 8.3-8 9-4.6-.7-8-4.5-8-9V6z',\n    cross: 'M12 3v4M12 17v4M3 12h4M17 12h4M12 5a7 7 0 1 0 0 14 7 7 0 0 0 0-14z',\n    box: 'M3 7l9-4 9 4v10l-9 4-9-4zM3 7l9 4 9-4M12 11v10',\n    route: 'M4 12h12M12 6l6 6-6 6M4 5v14',\n    idcard: 'M3 5h18v14H3zM8 9.5a2 2 0 1 0 0 4 2 2 0 0 0 0-4zM5 17c.6-1.4 1.7-2 3-2s2.4.6 3 2M14 10h4M14 14h4',\n    laptop: 'M5 5h14v10H5zM2 19h20',\n    home: 'M3 11l9-7 9 7M5 10v10h14V10',\n    inbox: 'M3 13h5l1 3h6l1-3h5M5 5h14l2 8v6H3v-6z',\n    bot: 'M12 3v3M7 7h10a3 3 0 0 1 3 3v6a3 3 0 0 1-3 3H7a3 3 0 0 1-3-3v-6a3 3 0 0 1 3-3zM9 12h.01M15 12h.01',\n    code: 'M8 6l-5 6 5 6M16 6l5 6-5 6M14 4l-4 16',\n    cap: 'M2 9l10-5 10 5-10 5zM6 11v5c3 2.5 9 2.5 12 0v-5',\n    cases: 'M9 3h6v4H9zM7 5H5v16h14V5h-2M8 12h8M8 16h5',\n    sliders: 'M4 6h9M17 6h3M4 12h3M11 12h9M4 18h11M19 18h1M15 4v4M9 10v4M17 16v4',\n    search: 'M11 4a7 7 0 1 0 0 14 7 7 0 0 0 0-14zM21 21l-5-5',\n    chev: 'M6 9l6 6 6-6',\n    chevR: 'M9 6l6 6-6 6',\n    lock: 'M6 11h12v10H6zM8 11V8a4 4 0 0 1 8 0v3',\n    moon: 'M20 14A8 8 0 1 1 10 4a6 6 0 0 0 10 10z',\n    check: 'M5 12l5 5L20 7',\n    x: 'M6 6l12 12M18 6L6 18',\n    alert: 'M12 3l10 18H2zM12 10v5M12 18h.01',\n    ban: 'M12 3a9 9 0 1 0 0 18 9 9 0 0 0 0-18zM5.6 5.6l12.8 12.8',\n    info: 'M12 3a9 9 0 1 0 0 18 9 9 0 0 0 0-18zM12 11v6M12 7h.01',\n    plug: 'M9 2v6M15 2v6M6 8h12v4a6 6 0 0 1-12 0zM12 18v4',\n    send: 'M4 12l16-8-6 16-3-7z',\n    key: 'M14 10a4 4 0 1 0-1 2.6L20 20M17 17l2-2',\n    clock: 'M12 3a9 9 0 1 0 0 18 9 9 0 0 0 0-18zM12 7v5l3 2',\n    folder: 'M3 6h6l2 2h10v11H3z',\n    eye: 'M2 12s4-7 10-7 10 7 10 7-4 7-10 7S2 12 2 12zM12 9a3 3 0 1 0 0 6 3 3 0 0 0 0-6z',\n    dot: 'M12 9a3 3 0 1 0 0 6 3 3 0 0 0 0-6z',\n    play: 'M7 4l13 8-13 8z',\n    sun: 'M12 2v2.25M12 19.75V22M2 12h2.25M19.75 12H22M4.93 4.93l1.59 1.59M17.48 17.48l1.59 1.59M4.93 19.07l1.59-1.59M17.48 6.52l1.59-1.59',\n} as const\n\nexport type GlyphName = keyof typeof PATHS\n\n/** The destinations' glyphs, as the prototype's NAV draws them. */\nexport const FEATURE_GLYPHS: Partial<Record<FeatureId, GlyphName>> = {\n    home: 'home',\n    inbox: 'inbox',\n    harness: 'bot',\n    academy: 'cap',\n    library: 'cases',\n    apiClient: 'code',\n    administration: 'sliders',\n    runtime: 'shield',\n    gateway: 'route',\n    redTeam: 'cross',\n    sessions: 'clock',\n    settings: 'sliders',\n}\n\n/** The Administration products' glyphs (the prototype's PRODUCTS). */\nexport const PRODUCT_GLYPHS: Record<AdminProductId, GlyphName> = {\n    runtimeSecurity: 'shield',\n    redTeam: 'cross',\n    modelSkill: 'box',\n    gateway: 'route',\n    agenticIdentity: 'idcard',\n    agenticEndpoint: 'laptop',\n}\n\nexport function Glyph({ name, size = 16, stroke = 1.8, color, className }: { name: GlyphName; size?: number; stroke?: number; color?: string; className?: string }) {\n","exit_code":0,"status":"completed"}}
