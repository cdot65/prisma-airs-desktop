index 00000000..6cc2bfb8
--- /dev/null
+++ b/tools/native-acceptance/acceptance_p11_geometry.py
@@ -0,0 +1,49 @@
+"""Exact shell viewport sizing, independent of a platform title-bar constant."""
+import math
+import time
+import acceptance_p11_shell as shell
+
+
+def _measure(ctx):
+    frame = ctx.frame()
+    areas = [n for n in ctx.app.tree() if n.get('role') == 'AXWebArea']
+    ctx.require(len(areas) == 1, 'shell geometry requires one owned WebArea')
+    viewport = areas[0].get('size')
+    ctx.require(isinstance(viewport, list) and len(viewport) == 2 and
+                all(type(n) in (int, float) and math.isfinite(n) and n > 0 for n in viewport),
+                'shell viewport geometry is invalid')
+    chrome = [frame[2] - viewport[0], frame[3] - viewport[1]]
+    ctx.require(all(math.isfinite(n) and 0 <= n <= 200 for n in chrome),
+                'shell native chrome geometry is invalid')
+    return frame, viewport, chrome
+
+
+def size_window(ctx, width, height):
+    ctx.require(all(type(n) in (int, float) and math.isfinite(n) and n > 0 for n in (width, height)),
+                'invalid required shell viewport')
+    for attempt in range(1, 4):
+        _frame, _viewport, chrome = _measure(ctx)
+        try:
+            # Leave placement alone: macOS can clamp y=0 to its menu bar,
+            # and combining that move with a small resize lost the size change.
+            ctx.resize(width + chrome[0], height + chrome[1])
+        except RuntimeError as error:
+            if not str(error).startswith('owned window resize did not reach requested geometry:'):
+                raise
+        time.sleep(.8)  # Same bounded WebKit settle as the original shell helper.
+        frame, viewport, actual_chrome = _measure(ctx)
+        ctx.log.append({'action': 'shell-viewport-measurement', 'attempt': attempt,
+                        'required_viewport': [width, height], 'actual_viewport': viewport,
+                        'actual_chrome': actual_chrome, 'window_frame': frame})
+        if viewport == [width, height]:
+            return frame
+    raise RuntimeError(f'required shell viewport was not reached: {[width, height]} != {viewport}')
+
+
+def run_shell(ctx):
+    original = shell.size_window
+    shell.size_window = size_window
+    try:
+        return shell.run(ctx)
+    finally:
+        shell.size_window = original
diff --git a/tools/native-acceptance/acceptance_p11_keyboard.py b/tools/native-acceptance/acceptance_p11_keyboard.py
new file mode 100644
index 00000000..80bea3e6
--- /dev/null
+++ b/tools/native-acceptance/acceptance_p11_keyboard.py
@@ -0,0 +1,194 @@
+"""C47-N01: retain the frozen matrix and measure only its two unfinished API focus paths."""
+import copy
+import hashlib
+import json
+from pathlib import Path
+
+import acceptance_c29 as c29
+import acceptance_p11_shell as shell
+import acceptance_p11_geometry as geometry
+
+ROOT = Path.cwd().resolve()
+FLAGS = ('one_named_header_h1', 'navigation_focus', 'main_inside_window', 'academy_location')
+EXPECTED_FACTS = {
+    'all_destinations_have_one_named_header_h1': True,
+    'navigation_focus_observed': True,
+    'main_frames_measured_inside_window': True,
+    'named_actions_keyboard_reachable': False,
+    'academy_hierarchy_retained': True,
+}
+VIEWS = (('Light', 1440, 820, 0, 100), ('Dark', 900, 600, 10, 200))
+
+
+def require(value, message):
+    if not value:
+        raise RuntimeError(message)
+
+
+def sha(path):
+    return hashlib.sha256(Path(path).read_bytes()).hexdigest()
+
+
+def bound(root, ref):
+    path = (root / ref['path']).resolve()
+    require(path.is_relative_to(root.resolve()) and sha(path) == ref['sha256'],
+            'prior keyboard evidence escapes or changed')
+    return path
+
+
+def inspect_prior(ctx, prior, root=ROOT):
+    raw_path = bound(root, prior['observations'])
+    matrix_path = bound(root, prior['measurements'])
+    raw = json.loads(raw_path.read_text())
+    require(raw['schema'] == 'airs-desktop/p11-native-observations/1' and raw['subject'] == 'P11'
+            and raw['status'] == 'failed' and raw['exit_code'] == 1 and raw['complete'] is False,
+            'original failed matrix process must remain failed')
+    require(raw['binding']['helper_closure'] == raw['helper_closure']
+            and all(raw[key] == raw['binding'][key] == ctx.prepared[key]
+                    for key in ('executable_sha256', 'bundle_sha256'))
+            and raw['binding']['prepare']['sha256'] == ctx.binding['prepare']['sha256']
+            and raw['binding']['native_inventory_sha256'] == ctx.binding['native_inventory_sha256']
+            and raw['host'] == ctx.binding['conditions']['platform'],
+            'prior matrix candidate, platform or binding changed')
+    for name, digest in raw['helper_closure'].items():
+        file = (root / name).resolve()
+        require(file.is_relative_to(root) and file.is_file()
+                and ctx.closure.get(name) == digest == sha(file), 'prior matrix helper bytes changed')
+    for name, digest in raw['artifact_sha256'].items():
+        artifact = (root / name).resolve()
+        require(artifact.is_relative_to(raw_path.parent) and sha(artifact) == digest,
+                'prior matrix artifact changed')
+    rows = [row for row in raw['checks'] if row['id'] == 'C47-N01']
+    require(len(rows) == 1 and rows[0]['facts'] == EXPECTED_FACTS,
+            'prior N01 had a different failed fact')
+    row = rows[0]
+    relative = str(matrix_path.relative_to(root))
+    require(relative in row['evidence'] and raw['artifact_sha256'].get(relative) == prior['measurements']['sha256'],
+            'matrix is not bound by the original N01')
+    matrix = json.loads(matrix_path.read_text())
+    expected = {(page, theme, zoom) for page in shell.PAGES for theme, _, _, _, zoom in VIEWS}
+    require(len(matrix) == 16 and {(r['page'], r['theme'], r['zoom']) for r in matrix} == expected,
+            'frozen matrix membership changed')
+    for item in matrix:
+        require(all(item.get(flag) is True for flag in FLAGS), 'frozen non-keyboard measurement failed')
+        require(item['requested'] == ([1440, 820] if item['theme'] == 'Light' else [900, 600]),
+                'frozen matrix viewport changed')
+        require(item['named_action_keyboard_visible'] is (item['page'] != 'API Client'),
+                'frozen matrix has an unexpected keyboard result')
+    require(len(row['visual']) == len(set(row['visual'])) == 16
+            and all(name in raw['artifact_sha256'] for name in row['visual']),
+            'original matrix captures missing')
+    return raw, row, matrix
+
+
+class TraversalFailure(RuntimeError):
+    def __init__(self, reason, record):
+        super().__init__('API keyboard traversal failed: ' + reason)
+        self.record = dict(record, failure=reason)
+
+
+def focus_key(tree, node):
+    semantic = lambda value: (value.get('role'), value.get('label'), value.get('subrole'), value.get('depth'))
+    peers = [value for value in tree if semantic(value) == semantic(node)]
+    return (*semantic(node), next((i for i, value in enumerate(peers) if value is node), 0))
+
+
+def traverse(initial, tab, tree_now, focused, frame):
+    """One finite measured focus cycle, bounded by the actual AX tree size."""
+    collection = [n for n in initial if n.get('role') == 'AXPopUpButton'
+                  and (n.get('label') or '').startswith('Collection ')]
+    require(len(collection) == 1, 'API Collection selector is missing or ambiguous')
+    require(sum(n.get('role') == 'AXPopUpButton' and n.get('label') == 'Environment'
+                for n in initial) == 1, 'API Environment selector is missing or ambiguous')
+    labels = {'collection': ('AXPopUpButton', collection[0]['label']),
+              'environment': ('AXPopUpButton', 'Environment')}
+    limit = 2 * max(1, len(initial))
+    trace, seen, reached = [], set(), {}
+    record = {'initial_ax_elements': len(initial), 'element_bound': limit,
+              'expected_header_selectors': labels, 'trace': trace, 'reached': reached}
+    for step in range(1, limit + 1):
+        tab()
+        tree = tree_now()
+        node = focused(tree)
+        if not node:
+            trace.append({'step': step, 'focused': None})
+            continue
+        key = focus_key(tree, node)
+        if key in seen:
+            raise TraversalFailure('focus_cycle', record)
+        seen.add(key)
+        viewport = frame()
+        inside = bool(node.get('enabled') is not False and node.get('size')
+                      and all(value > 0 for value in node['size']) and c29.inside(viewport, node))
+        entry = {'step': step, 'role': node.get('role'), 'label': node.get('label'),
+                 'pos': node.get('pos'), 'size': node.get('size'), 'window': viewport,
+                 'inside_window': inside}
+        trace.append(entry)
+        pair = (node.get('role'), node.get('label'))
+        goals = [name for name, expected in labels.items() if pair == expected]
+        if pair in (('AXTextField', 'URL'), ('AXButton', 'Send')):
+            goals.append('request_action')
+        for goal in goals:
+            if not inside:
+                raise TraversalFailure('focused_goal_outside_window', record)
+            reached[goal] = dict(entry)
+        if set(reached) == {'collection', 'environment', 'request_action'}:
+            record['steps'] = step
+            return record, node
+    raise TraversalFailure('ax_element_bound', record)
+
+
+def run(ctx, prior):
+    raw, old_row, matrix = inspect_prior(ctx, prior)
+    proof = ctx.save('c47-keyboard-prior-binding', {
+        'prior_raw': prior['observations'], 'prior_measurements': prior['measurements'],
+        'original_execution_id': raw['execution_id'], 'original_process_exit_code': raw['exit_code'],
+        'original_failed_facts': old_row['facts'],
+        'disposition': 'Retain original non-keyboard and fourteen keyboard measurements; '
+                       'replace only the two failed API keyboard measurements with new observations.'})
+    corrected = copy.deepcopy(matrix)
+    evidence, captures, replacements = [prior['measurements']['path'], proof], [], []
+    for theme, width, height, zoom, percent in VIEWS:
+        name = 'c47-api-keyboard-' + theme.lower() + '-' + str(percent)
+        ctx.app.menu('View', 'Actual Size')
+        ctx.app.front()
+        geometry.size_window(ctx, width, height)
+        c29.appearance(ctx.app, theme)
+        if zoom:
+            c29.zoom(ctx.app, zoom)
+        ctx.navigate('API Client')
+        ctx.app.ax('focus', 'AXHeading', 'API Client')
+        initial = ctx.app.tree()
+        start = ctx.app.focused(initial) or {}
+        ctx.require(start.get('role') == 'AXHeading' and start.get('label') == 'API Client',
+                    'API header did not receive actual native focus')
+        try:
+            trace, node = traverse(initial, lambda: ctx.app.keycode(48), ctx.app.tree,
+                                   ctx.app.focused, ctx.frame)
+        except TraversalFailure as error:
+            ctx.save(name + '-trace', error.record)
+            raise
+        trace_ref = ctx.save(name + '-trace', trace)
+        evidence += [trace_ref, ctx.save(name + '-focused', ctx.app.tree())]
+        captures.append(ctx.capture(name))
+        item = next(r for r in corrected if r['page'] == 'API Client'
+                    and r['theme'] == theme and r['zoom'] == percent)
+        item['named_action_keyboard_visible'] = True
+        item['focused_action'] = node
+        replacements.append({'page': 'API Client', 'theme': theme, 'zoom': percent,
+                             'prior_keyboard_visible': False, 'new_trace': trace_ref,
+                             'collection_and_environment_keyboard_visible': True})
+    evidence.append(ctx.save('c47-keyboard-supplement-measurements', {
+        'prior_raw': prior['observations'], 'prior_measurements': prior['measurements'],
+        'replacements': replacements, 'derived_measurements': corrected,
+        'meaning': 'New derived N01 evidence. The original failed raw row and matrix are unchanged.'}))
+    facts = {'all_destinations_have_one_named_header_h1': all(r['one_named_header_h1'] for r in corrected),
+             'navigation_focus_observed': all(r['navigation_focus'] for r in corrected),
+             'main_frames_measured_inside_window': all(r['main_inside_window'] for r in corrected),
+             'named_actions_keyboard_reachable': all(r['named_action_keyboard_visible'] for r in corrected),
+             'academy_hierarchy_retained': all(r['academy_location'] for r in corrected),
+             'api_header_selectors_keyboard_visible': len(replacements) == 2}
+    ctx.app.menu('View', 'Actual Size')
+    ctx.resize(1440, 900)
+    return {'id': 'C47-N01', 'facts': facts, 'evidence': evidence,
+            'visual': [*old_row['visual'], *captures]}
diff --git a/tools/native-acceptance/acceptance_p11_last.py b/tools/native-acceptance/acceptance_p11_last.py
new file mode 100644
index 00000000..90ed5365
--- /dev/null
+++ b/tools/native-acceptance/acceptance_p11_last.py
@@ -0,0 +1,246 @@
+#!/usr/bin/env python3
+"""Run only the unfinished shell and warning assertions."""
+import argparse
+import json
+import os
+from pathlib import Path
+import platform
+import sys
+import tempfile
+import time
+
+import acceptance_p11 as core
+import acceptance_p11_resume as prior_driver
+import acceptance_p11_finish as completed_driver
+import acceptance_p11_geometry as geometry
+import acceptance_p11_credentials as credentials
+import acceptance_p11_roles as roles
+import acceptance_p11_api as api
+import acceptance_p11_settings as settings
+import acceptance_p11_shell as shell
+import acceptance_p11_setup as setup
+
+ROOT = core.ROOT
+C46 = 'C46-N01'
+
+
+def relevant_c46(root=ROOT):
+    paths = set(core._binding.helper_closure(root, 'acceptance_p11_setup'))
+    paths.add('tools/native-acceptance/acceptance_p11.py')
+    if 'tools/native-acceptance/acceptance_p11_api.py' in paths:
+        raise RuntimeError('C46 dependency closure unexpectedly includes API helper')
+    return sorted(paths)
+
+
+def inspect_chain(paths, prepare, work, state_path):
+    """Validate both failed runs and latest state before any new native action."""
+    require = core.Context.require
+    require(len(paths) >= 2, 'continuation requires its ordered prior observation chain')
+    if work.is_symlink(): raise RuntimeError('resume work cannot be a symlink')
+    work = work.resolve()
+    require(work.parent == Path(tempfile.gettempdir()).resolve() and work.name.startswith('airs-p11-owned-')
+            and work.is_dir() and work.stat().st_uid == os.getuid(), 'unowned continuation work')
+    prepared = json.loads(prepare.read_text())
+    completed = set()
+    current = core._binding.helper_closure(ROOT, 'acceptance_p11_last')
+    raws = []
+    prior_refs = []
+    for index, path in enumerate(paths):
+        path = path.resolve(); raw = json.loads(path.read_text())
+        require(raw['schema'] == 'airs-desktop/p11-native-observations/1'
+                and raw['subject'] == 'P11' and raw['status'] == 'failed'
+                and raw['exit_code'] == 1 and raw['complete'] is False and raw['errors'],
+                'prior process outcome must remain failed')
+        require(raw['host'] == platform.platform()
+                and raw['executable_sha256'] == prepared['executable_sha256']
+                and raw['bundle_sha256'] == prepared['bundle_sha256']
+                and raw['binding']['prepare']['sha256'] == core.sha(prepare)
+                and raw['binding']['native_inventory_sha256'] == core.sha(ROOT/'docs/architecture/native-checks.json'),
+                'prior native artifact/platform/prepare differs')
+        for name, digest in raw['artifact_sha256'].items():
+            artifact = (ROOT/name).resolve()
+            require(artifact.is_relative_to(path.parent) and core.sha(artifact) == digest,
+                    'prior immutable native artifact changed')
+        if index == 0:
+            require([row['id'] for row in raw['checks']] == ['C46-N01'], 'initial setup scope differs')
+        else:
+            admission = raw['continuation']
+            require(admission.get('origins', [admission['observations']]) == prior_refs
+                    and sorted(admission['completed_ids']) == sorted(completed)
+                    and sorted(admission['remaining_ids']) == sorted(set(core.inventory())-completed),
+                    'prior observation chain is inconsistent')
+        for row in raw['checks']:
+            require(row['id'] not in completed and row['facts']
+                    and all(value is True for value in row['facts'].values()),
+                    'prior completed assertion missing, duplicated or failed')
+            paths_in_scope = relevant_c46() if index == 0 else sorted(raw['helper_closure'])
+            for name in paths_in_scope:
+                require(raw['helper_closure'].get(name) == current.get(name) == core.sha(ROOT/name),
+                        'prior relevant helper changed: '+name)
+            completed.add(row['id'])
+        raws.append(raw)
+        prior_refs.append({'path': str(path.relative_to(ROOT)), 'sha256': core.sha(path)})
+    require(completed and completed < set(core.inventory()), 'no unfinished native assertion remains')
+    latest = paths[-1].resolve()
+    require(raws[-1]['continuation']['work'] == str(work), 'prior continuation work differs')
+    state_file = latest.parent/'fixture-state-final.json'
+    require(raws[-1]['artifact_sha256'].get(str(state_file.relative_to(ROOT))) == core.sha(state_file),
+            'latest final fixture state is not bound')
+    state = json.loads(state_path.read_text())
+    require(state == json.loads(state_file.read_text()), 'fixture state changed since latest failed run')
+    return raws[-1], state
+
+
+class LastContext(completed_driver.FinishContext):
+    pass
+
+
+
+def restored_context(args):
+    import fixture_app as fx
+    import acceptance_c08 as c8
+    prepared, bundle = core.verify_prepare(args.prepare.resolve())
+    previous, state = inspect_chain(args.previous, args.prepare, args.work, Path(fx.DATA)/'state.json')
+    if prepared['executable_sha256'] != previous['executable_sha256'] or prepared['bundle_sha256'] != previous['bundle_sha256']:
+        raise RuntimeError('resume app artifact differs')
+    work = args.work.resolve()
+    guard_files = ['scan/ca.pem', 'scan/leaf.pem', 'scan/leaf.key', 'scan/mode.json',
+                   'mgmt/mode.json', 'mgmt/issued.json', 'mgmt/idp-key.pem',
+                   'academy/ca.pem', 'academy/leaf.pem', 'academy/leaf.key',
+                   'academy/mode.json', 'academy/catalog.json']
+    for name in guard_files:
+        file = work/name
+        if not file.is_file() or file.is_symlink() or file.stat().st_uid != os.getuid():
+            raise RuntimeError('owned fixture input missing: '+name)
+    expected_roots = (work/'scan/ca.pem').read_bytes()+b'\n'+(work/'academy/ca.pem').read_bytes()
+    if Path(fx.ROOTS).read_bytes() != expected_roots:
+        raise RuntimeError('installed owned trust roots differ from retained CAs')
+    prior_inputs = previous['continuation']
+    if core.sha(fx.ROOTS) != prior_inputs['installed_roots_sha256']:
+        raise RuntimeError('owned trust roots changed since previous admission')
+    for name in guard_files:
+        if name.endswith(('.pem', '.key')) or name == 'academy/catalog.json':
+            if core.sha(work/name) != prior_inputs['owned_inputs_sha256'][name]:
+                raise RuntimeError('retained owned certificate/catalog changed: '+name)
+    if Path(c8.MGMT_ORIGIN_FILE).read_text().strip() != 'https://localhost:62780' or (Path(fx.DATA)/'fixture-academy-origin').read_text().strip() != 'https://localhost:62781':
+        raise RuntimeError('retained management/Academy origins changed')
+    ctx = LastContext.__new__(LastContext)  # no new scratch root or reset
+    ctx.prepare_path, ctx.prepared, ctx.bundle = args.prepare.resolve(), prepared, bundle
+    ctx.out = args.out.resolve(); ctx.out.mkdir(parents=True, exist_ok=False)
+    ctx.work, ctx.log, ctx.rows, ctx.errors, ctx.artifacts = work, [], {}, [], {}
+    ctx.fixture_root_owned = False
+    ctx.argv = [sys.executable, *sys.argv]
+    ctx.argv_source = 'sys.executable + sys.argv'
+    ctx.started = time.strftime('%Y-%m-%dT%H:%M:%SZ', time.gmtime())
+    ctx.execution_exit_code = 1
+    ctx.app = ctx.scan = ctx.mgmt = ctx.academy = None
+    ctx.closure = core._binding.helper_closure(ROOT, 'acceptance_p11_last')
+    ctx.binding = dict(previous['binding'], helper_closure=ctx.closure,
+                       conditions={'platform': platform.platform(), 'hostname': platform.node()})
+    tenant = next(t for t in state['tenants'] if t['label'] == 'P11 Northwind')
+    warning = next(w for group in state['tenantWarnings'] if group['tenant'] == tenant['id']
+                   for w in group['warnings'] if w['product'] == 'modelSkill')
+    ctx.state = {'bootstrap_tenant': 'P11 Northwind', 'spare_tenant': 'P11 Secondary',
+                 'bootstrap_tenant_id': tenant['id'], 'original_supply_chain_warning': warning,
+                 'scan_absent': True}
+    ctx.continuation = {'observations': {'path': str(args.previous[-1].resolve().relative_to(ROOT)),
+                                         'sha256': core.sha(args.previous[-1])},
+                        'origins': [{'path': str(path.resolve().relative_to(ROOT)), 'sha256': core.sha(path)} for path in args.previous],
+                        'completed_ids': sorted({row['id'] for path in args.previous for row in json.loads(path.read_text())['checks']}),
+                        'remaining_ids': sorted(set(core.inventory())-{row['id'] for path in args.previous for row in json.loads(path.read_text())['checks']}),
+                        'work': str(work), 'fixture_state_semantically_equal': True,
+                        'owned_inputs_sha256': {name: core.sha(work/name) for name in guard_files},
+                        'installed_roots_sha256': core.sha(fx.ROOTS),
+                        'certificate_generation_or_install_executed': False}
+    ctx.save('resume-preconditions', ctx.continuation)
+    # Restore only existing server state. Constructors/install/mode are forbidden.
+    ctx.scan = fx.ScanEndpoint.__new__(fx.ScanEndpoint)
+    ctx.scan.dir, ctx.scan.key, ctx.scan.port, ctx.scan.proc = str(work/'scan'), c8.SCAN_KEY, fx.free_port(), None
+    ctx.mgmt = c8.MgmtEndpoint.__new__(c8.MgmtEndpoint)
+    ctx.mgmt.certs, ctx.mgmt.dir, ctx.mgmt.port, ctx.mgmt.proc = str(work/'scan'), str(work/'mgmt'), 62780, None
+    ctx.academy = fx.AcademyEndpoint.__new__(fx.AcademyEndpoint)
+    ctx.academy.dir, ctx.academy.port, ctx.academy.proc = str(work/'academy'), 62781, None
+    return ctx
+
+
+def execute(args):
+    import fixture_app as fx
+    if not os.environ.get('AIRS_NATIVE_ORCHESTRATOR'):
+        raise RuntimeError('set AIRS_NATIVE_ORCHESTRATOR to the actual VM UI operator')
+    ctx = restored_context(args)
+    os.environ['AIRS_NATIVE_PROCESS_RECORD'] = str(ctx.out/'candidate-processes.json')
+    offsets = {}
+    original_sh = fx.sh
+    def checked_sh(argv, **kwargs):
+        result = original_sh(argv, **kwargs)
+        if Path(str(argv[0])).name == 'osascript' and result.returncode != 0:
+            raise RuntimeError('System Events transport rejected owned native input')
+        return result
+    fx.sh = checked_sh
+    try:
+        ctx.app = fx.App(str(ctx.bundle), str(ctx.work), ctx.log)
+        candidate = ctx.app.candidate
+        ctx.require(not candidate.matching(candidate.app_path) and not candidate.matching(candidate.engine_path),
+                    'unowned fixture process exists; refusing resume')
+        ctx.fixture_root_owned = True
+        for name, endpoint in [('scan', ctx.scan), ('management', ctx.mgmt), ('academy', ctx.academy)]:
+            offsets[name] = len(endpoint.requests())
+            endpoint.start()
+        ctx.save('endpoint-history-offsets', offsets)
+        ctx.app.launch()
+        completed = set(ctx.continuation['completed_ids'])
+        ctx.require({'C46-N01', 'C48-N01', 'C48-N02', 'C48-N03',
+                     'C49-N01', 'C49-N02', 'C49-N03'} <= completed,
+                    'last slice starts after completed setup/API/Settings assertions')
+        shell_ids = {'C47-N01', 'C47-N02', 'C47-N03'}
+        warning_ids = {'C46-N02', 'C46-N03'}
+        ctx.require(not (completed & shell_ids) or shell_ids <= completed,
+                    'partly completed shell group needs an explicitly scoped next slice')
+        ctx.require(not (completed & warning_ids) or warning_ids <= completed,
+                    'partly completed warning group needs an explicitly scoped next slice')
+        if not shell_ids <= completed: geometry.run_shell(ctx)
+        if not warning_ids <= completed: setup.warning_flows(ctx)
+        core.verify_prepare(ctx.prepare_path)
+        ctx.require(core._binding.helper_closure(ROOT, 'acceptance_p11_last') == ctx.closure,
+                    'resume helper changed during execution')
+        ctx.require(set(ctx.rows) == set(ctx.continuation['remaining_ids'])
+                    and all(value is True for row in ctx.rows.values() for value in row['facts'].values()),
+                    'unfinished native facts remain incomplete')
+        ctx.execution_exit_code = 0
+    except BaseException as error:
+        ctx.execution_exit_code = 130 if isinstance(error, KeyboardInterrupt) else 1
+        ctx.errors.append({'type': type(error).__name__, 'message': str(error)})
+        if ctx.app:
+            try: ctx.save('failure-tree')
+            except Exception: pass
+    finally:
+        if ctx.fixture_root_owned:
+            for name, endpoint in [('management', ctx.mgmt), ('scan', ctx.scan), ('academy', ctx.academy)]:
+                try:
+                    ctx.save(name+'-requests', {'prior_count': offsets.get(name, 0),
+                        'new_requests': endpoint.requests()[offsets.get(name, 0):]})
+                except Exception as error:
+                    ctx.errors.append({'type': type(error).__name__, 'message': str(error)})
+            try:
+                fx.stop_app(); fx.stop_engines()
+                ctx.save('fixture-state-final', ctx.fixture_state())
+            except Exception as error:
+                ctx.errors.append({'type': type(error).__name__, 'message': str(error)})
+        for endpoint in (ctx.academy, ctx.mgmt, ctx.scan):
+            try: endpoint.stop()
+            except Exception as error:
+                ctx.errors.append({'type': type(error).__name__, 'message': 'owned endpoint teardown: '+str(error)})
+        if ctx.errors and ctx.execution_exit_code == 0: ctx.execution_exit_code = 1
+        raw = ctx.observations(not ctx.errors and ctx.execution_exit_code == 0)
+        raw['continuation'] = ctx.continuation
+        core.write_new(ctx.out/'observations.json', raw)
+    return ctx.execution_exit_code
+
+
+if __name__ == '__main__':
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('--previous', type=Path, nargs='+', required=True)
+    parser.add_argument('--work', type=Path, required=True)
+    parser.add_argument('--prepare', type=Path, required=True)
+    parser.add_argument('--out', type=Path, required=True)
+    raise SystemExit(execute(parser.parse_args()))
diff --git a/tools/native-acceptance/acceptance_p11_resume.py b/tools/native-acceptance/acceptance_p11_resume.py
new file mode 100644
index 00000000..6240f7cc
--- /dev/null
+++ b/tools/native-acceptance/acceptance_p11_resume.py
@@ -0,0 +1,199 @@
+#!/usr/bin/env python3
+"""Resume the first unfinished P11 slice; never repeat completed setup."""
+import argparse
+import json
+import os
+from pathlib import Path
+import platform
+import sys
+import tempfile
+import time
+
+import acceptance_p11 as core
+import acceptance_p11_api as api
+import acceptance_p11_settings as settings
+import acceptance_p11_shell as shell
+import acceptance_p11_setup as setup
+
+ROOT = core.ROOT
+C46 = 'C46-N01'
+
+
+def relevant_c46(root=ROOT):
+    paths = set(core._binding.helper_closure(root, 'acceptance_p11_setup'))
+    paths.add('tools/native-acceptance/acceptance_p11.py')
+    if 'tools/native-acceptance/acceptance_p11_api.py' in paths:
+        raise RuntimeError('C46 dependency closure unexpectedly includes API helper')
+    return sorted(paths)
+
+
+def inspect_previous(path, prepare, work, state_path):
+    """Pure admission checks; no app, endpoint, certificate or vault operation."""
+    if work.is_symlink(): raise RuntimeError('resume work cannot be a symlink')
+    path, work = path.resolve(), work.resolve()
+    raw = json.loads(path.read_text())
+    require = core.Context.require
+    require(raw['schema'] == 'airs-desktop/p11-native-observations/1'
+            and raw['subject'] == 'P11' and raw['status'] == 'failed'
+            and raw['exit_code'] == 1 and raw['complete'] is False,
+            'only the failed first-unfinished API attempt may resume')
+    require(len(raw['checks']) == 1 and raw['checks'][0]['id'] == C46
+            and raw['checks'][0]['facts']
+            and all(value is True for value in raw['checks'][0]['facts'].values()),
+            'completed C46 facts missing; setup is not eligible for reuse')
+    require(raw['host'] == platform.platform(), 'resume must use the same native platform')
+    require(core.sha(ROOT/'docs/architecture/native-checks.json') == raw['binding']['native_inventory_sha256'], 'native scope changed')
+    require(core.sha(prepare) == raw['binding']['prepare']['sha256'],
+            'resume preparation differs')
+    for name in relevant_c46():
+        require(core.sha(ROOT/name) == raw['helper_closure'].get(name),
+                'completed C46 helper changed: ' + name)
+    for name, digest in raw['artifact_sha256'].items():
+        artifact = (ROOT/name).resolve()
+        require(artifact.is_relative_to(path.parent) and core.sha(artifact) == digest,
+                'prior immutable native artifact changed')
+    require(work.parent == Path(tempfile.gettempdir()).resolve()
+            and work.name.startswith('airs-p11-owned-') and work.is_dir()
+            and not work.is_symlink() and work.stat().st_uid == os.getuid(),
+            'resume work directory is not this user owned fixture')
+    previous_state = path.parent/'fixture-state-final.json'
+    require(raw['artifact_sha256'].get(str(previous_state.relative_to(ROOT))) == core.sha(previous_state),
+            'prior final fixture state is not bound')
+    state = json.loads(state_path.read_text())
+    require(state == json.loads(previous_state.read_text()), 'fixture state changed since failed attempt')
+    return raw, state
+
+
+def restored_context(args):
+    import fixture_app as fx
+    import acceptance_c08 as c8
+    prepared, bundle = core.verify_prepare(args.prepare.resolve())
+    previous, state = inspect_previous(args.previous, args.prepare, args.work, Path(fx.DATA)/'state.json')
+    if prepared['executable_sha256'] != previous['executable_sha256'] or prepared['bundle_sha256'] != previous['bundle_sha256']:
+        raise RuntimeError('resume app artifact differs')
+    work = args.work.resolve()
+    guard_files = ['scan/ca.pem', 'scan/leaf.pem', 'scan/leaf.key', 'scan/mode.json',
+                   'mgmt/mode.json', 'mgmt/issued.json', 'mgmt/idp-key.pem',
+                   'academy/ca.pem', 'academy/leaf.pem', 'academy/leaf.key',
+                   'academy/mode.json', 'academy/catalog.json']
+    for name in guard_files:
+        file = work/name
+        if not file.is_file() or file.is_symlink() or file.stat().st_uid != os.getuid():
+            raise RuntimeError('owned fixture input missing: '+name)
+    expected_roots = (work/'scan/ca.pem').read_bytes()+b'\n'+(work/'academy/ca.pem').read_bytes()
+    if Path(fx.ROOTS).read_bytes() != expected_roots:
+        raise RuntimeError('installed owned trust roots differ from retained CAs')
+    if Path(c8.MGMT_ORIGIN_FILE).read_text().strip() != 'https://localhost:62780' or (Path(fx.DATA)/'fixture-academy-origin').read_text().strip() != 'https://localhost:62781':
+        raise RuntimeError('retained management/Academy origins changed')
+    ctx = core.Context.__new__(core.Context)  # no new scratch root or reset
+    ctx.prepare_path, ctx.prepared, ctx.bundle = args.prepare.resolve(), prepared, bundle
+    ctx.out = args.out.resolve(); ctx.out.mkdir(parents=True, exist_ok=False)
+    ctx.work, ctx.log, ctx.rows, ctx.errors, ctx.artifacts = work, [], {}, [], {}
+    ctx.fixture_root_owned = False
+    ctx.argv = [sys.executable, *sys.argv]
+    ctx.argv_source = 'sys.executable + sys.argv'
+    ctx.started = time.strftime('%Y-%m-%dT%H:%M:%SZ', time.gmtime())
+    ctx.execution_exit_code = 1
+    ctx.app = ctx.scan = ctx.mgmt = ctx.academy = None
+    ctx.closure = core._binding.helper_closure(ROOT, 'acceptance_p11_resume')
+    ctx.binding = dict(previous['binding'], helper_closure=ctx.closure,
+                       conditions={'platform': platform.platform(), 'hostname': platform.node()})
+    tenant = next(t for t in state['tenants'] if t['label'] == 'P11 Northwind')
+    warning = next(w for group in state['tenantWarnings'] if group['tenant'] == tenant['id']
+                   for w in group['warnings'] if w['product'] == 'modelSkill')
+    ctx.state = {'bootstrap_tenant': 'P11 Northwind', 'spare_tenant': 'P11 Secondary',
+                 'bootstrap_tenant_id': tenant['id'], 'original_supply_chain_warning': warning,
+                 'scan_absent': True}
+    ctx.continuation = {'observations': {'path': str(args.previous.resolve().relative_to(ROOT)),
+                                         'sha256': core.sha(args.previous)},
+                        'completed_ids': [C46], 'remaining_ids': sorted(set(core.inventory())-{C46}),
+                        'work': str(work), 'fixture_state_semantically_equal': True,
+                        'owned_inputs_sha256': {name: core.sha(work/name) for name in guard_files},
+                        'installed_roots_sha256': core.sha(fx.ROOTS),
+                        'certificate_generation_or_install_executed': False}
+    ctx.save('resume-preconditions', ctx.continuation)
+    # Restore only existing server state. Constructors/install/mode are forbidden.
+    ctx.scan = fx.ScanEndpoint.__new__(fx.ScanEndpoint)
+    ctx.scan.dir, ctx.scan.key, ctx.scan.port, ctx.scan.proc = str(work/'scan'), c8.SCAN_KEY, fx.free_port(), None
+    ctx.mgmt = c8.MgmtEndpoint.__new__(c8.MgmtEndpoint)
+    ctx.mgmt.certs, ctx.mgmt.dir, ctx.mgmt.port, ctx.mgmt.proc = str(work/'scan'), str(work/'mgmt'), 62780, None
+    ctx.academy = fx.AcademyEndpoint.__new__(fx.AcademyEndpoint)
+    ctx.academy.dir, ctx.academy.port, ctx.academy.proc = str(work/'academy'), 62781, None
+    return ctx
+
+
+def execute(args):
+    import fixture_app as fx
+    if not os.environ.get('AIRS_NATIVE_ORCHESTRATOR'):
+        raise RuntimeError('set AIRS_NATIVE_ORCHESTRATOR to the actual VM UI operator')
+    ctx = restored_context(args)
+    os.environ['AIRS_NATIVE_PROCESS_RECORD'] = str(ctx.out/'candidate-processes.json')
+    offsets = {}
+    original_sh = fx.sh
+    def checked_sh(argv, **kwargs):
+        result = original_sh(argv, **kwargs)
+        if Path(str(argv[0])).name == 'osascript' and result.returncode != 0:
+            raise RuntimeError('System Events transport rejected owned native input')
+        return result
+    fx.sh = checked_sh
+    try:
+        ctx.app = fx.App(str(ctx.bundle), str(ctx.work), ctx.log)
+        candidate = ctx.app.candidate
+        ctx.require(not candidate.matching(candidate.app_path) and not candidate.matching(candidate.engine_path),
+                    'unowned fixture process exists; refusing resume')
+        ctx.fixture_root_owned = True
+        for name, endpoint in [('scan', ctx.scan), ('management', ctx.mgmt), ('academy', ctx.academy)]:
+            offsets[name] = len(endpoint.requests())
+            endpoint.start()
+        ctx.save('endpoint-history-offsets', offsets)
+        ctx.app.launch()
+        api.run(ctx, prior_first_use={'observations': ctx.continuation['observations'],
+            'evidence': {'path': str((args.previous.resolve().parent/'c48-first-use.json').relative_to(ROOT)),
+                         'sha256': core.sha(args.previous.resolve().parent/'c48-first-use.json')}})
+        settings.run(ctx)
+        shell.run(ctx)
+        setup.warning_flows(ctx)
+        core.verify_prepare(ctx.prepare_path)
+        ctx.require(core._binding.helper_closure(ROOT, 'acceptance_p11_resume') == ctx.closure,
+                    'resume helper changed during execution')
+        ctx.require(set(ctx.rows) == set(ctx.continuation['remaining_ids'])
+                    and all(value is True for row in ctx.rows.values() for value in row['facts'].values()),
+                    'unfinished native facts remain incomplete')
+        ctx.execution_exit_code = 0
+    except BaseException as error:
+        ctx.execution_exit_code = 130 if isinstance(error, KeyboardInterrupt) else 1
+        ctx.errors.append({'type': type(error).__name__, 'message': str(error)})
+        if ctx.app:
+            try: ctx.save('failure-tree')
+            except Exception: pass
+    finally:
+        if ctx.fixture_root_owned:
+            for name, endpoint in [('management', ctx.mgmt), ('scan', ctx.scan), ('academy', ctx.academy)]:
+                try:
+                    ctx.save(name+'-requests', {'prior_count': offsets.get(name, 0),
+                        'new_requests': endpoint.requests()[offsets.get(name, 0):]})
+                except Exception as error:
+                    ctx.errors.append({'type': type(error).__name__, 'message': str(error)})
+            try:
+                fx.stop_app(); fx.stop_engines()
+                ctx.save('fixture-state-final', ctx.fixture_state())
+            except Exception as error:
+                ctx.errors.append({'type': type(error).__name__, 'message': str(error)})
+        for endpoint in (ctx.academy, ctx.mgmt, ctx.scan):
+            try: endpoint.stop()
+            except Exception as error:
+                ctx.errors.append({'type': type(error).__name__, 'message': 'owned endpoint teardown: '+str(error)})
+        if ctx.errors and ctx.execution_exit_code == 0: ctx.execution_exit_code = 1
+        raw = ctx.observations(not ctx.errors and ctx.execution_exit_code == 0)
+        raw['continuation'] = ctx.continuation
+        core.write_new(ctx.out/'observations.json', raw)
+    return ctx.execution_exit_code
+
+
+if __name__ == '__main__':
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('--previous', type=Path, required=True)
+    parser.add_argument('--work', type=Path, required=True)
+    parser.add_argument('--prepare', type=Path, required=True)
+    parser.add_argument('--out', type=Path, required=True)
+    raise SystemExit(execute(parser.parse_args()))
