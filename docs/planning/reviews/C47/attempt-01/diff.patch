     }
+    let output = std::process::Command::new("/usr/bin/python3")
+        .args(["-I", "tools/p11/standing.py", "release-prerequisites"])
+        .current_dir(repo.root())
+        .env_clear()
+        .env("PATH", crate::git_path())
+        .output()
+        .map_err(crate::io_err(&repo.join("tools/p11/standing.py")))?;
+    if !output.status.success() {
+        return Err(invalid(format!(
+            "release requires genuine archived P11 member and phase proofs: {}",
+            String::from_utf8_lossy(&output.stderr)
+        )));
+    }
     Ok(())
 }
