ies the dark theme attribute the tokens key on', async () => {\n200:        expect(document.documentElement.dataset.theme).toBe('gruvbox')\n226:    it('keeps one topmost modal: the palette over the switcher, Escape closes only the top, focus returns', async () => {\n230:        trigger.focus()\n235:        expect(useShellStore.getState().modals).toHaveLength(1)\n287:    it('opens the tenant switcher from the native ⌘T command without switching, and returns focus to the trigger on Escape', async () => {\n329:    it('hands focus to the tenant list when ⌘T replaces an open palette, and Escape returns it to the trigger', async () => {\n349:        expect(native.dispatched.at(-1)).toEqual({ kind: 'setAppearance', theme: 'light' })\n357:        await native.pushMenu({ kind: 'setAppearance', theme: 'light' })\n365:        expect(native.dispatched.at(-1)).toEqual({ kind: 'setAppearance', theme: 'light' })\n369:    it('focuses the tenant list after ⌘T even when focus inside an inert rail is refused, as WebKit does', async () => {\n373:        // WebKit refuses focus inside an inert subtree; jsdom does not, so refuse it here.\n374:        const descriptor = Object.getOwnPropertyDescriptor(HTMLElement.prototype, 'focus') as PropertyDescriptor\n375:        const realFocus = HTMLElement.prototype.focus\n376:        Object.defineProperty(HTMLElement.prototype, 'focus', {\n393:            Object.defineProperty(HTMLElement.prototype, 'focus', descriptor)\n408:        await screen.findByRole('heading', { level: 1, name: 'Settings' })\n412:    it('makes toast controls inert and hidden while a modal is topmost, usable again after', async () => {\n589:            expect(native.dispatched.at(-1)).toEqual({ kind: 'setAppearance', theme: 'dark' })\n595:            expect(native.dispatched.at(-1)).toEqual({ kind: 'setAppearance', theme: 'light' })\n601:            expect(native.dispatched.at(-1)).toEqual({ kind: 'setAppearance', theme: 'dark' })\n646:    it('lets Tab reach the palette’s \"Ask the Harness instead\" fallback, Enter opens the Harness once, and Escape returns focus to the search button (R4)', async () => {\n658:        const navigations = () => native.dispatched.filter((i) => i.kind === 'navigate' && i.feature === 'harness').length\n659:        const before = navigations()\n661:        expect(navigations()).toBe(before + 1)\n663:        // Escape from the fallback closes the palette and restores the opener's focus.\n\"\"\"C45 fixture process ownership: exact bundle, executable and PID lifetime.\n\nNo process-name signaling, argument inspection, foreign adoption or installed-app\nlookup. macOS struct layout comes from the selected SDK sys/proc_info.h.\n\"\"\"\nfrom dataclasses import dataclass\nfrom pathlib import Path\nimport ctypes\nimport hashlib\nimport json\nimport os\nimport plistlib\nimport signal\nimport subprocess\nimport sys\nimport time\n\nFIXTURE_ID = 'io.cdot.airs-desktop.fixture'\nEXECUTABLE = 'prisma-airs-desktop'\n\n@dataclass(frozen=True)\nclass Identity:\n    pid: int\n    executable: str\n    birth: tuple\n    parent: int\n\nclass _BsdInfo(ctypes.Structure):\n    _fields_ = [('header', ctypes.c_uint32 * 12), ('comm', ctypes.c_char * 16),\n                ('name', ctypes.c_char * 32), ('misc', ctypes.c_uint32 * 5),\n                ('nice', ctypes.c_int32), ('seconds', ctypes.c_uint64), ('micros', ctypes.c_uint64)]\n\nclass MacProcesses:\n    def __init__(self):\n        if sys.platform != 'darwin':\n            raise RuntimeError('native process ownership requires macOS')\n        self.lib = ctypes.CDLL('/usr/lib/libproc.dylib', use_errno=True)\n        self.lib.proc_pidpath.argtypes = [ctypes.c_int, ctypes.c_void_p, ctypes.c_uint32]\n        self.lib.proc_pidpath.restype = ctypes.c_int\n        self.lib.proc_pidinfo.argtypes = [ctypes.c_int, ctypes.c_int, ctypes.c_uint64, ctypes.c_void_p, ctypes.c_int]\n        self.lib.proc_pidinfo.restype = ctypes.c_int\n\n    def snapshot(self, pid):\n        path = ctypes.create_string_buffer(4096)\n        info = _BsdInfo()\n        if self.lib.proc_pidpath(pid, path, len(path)) <= 0:\n            return None\n        if self.lib.proc_pidinfo(pid, 3, 0, ctypes.byref(info), ctypes.sizeof(info)) != ctypes.sizeof(info):\n            return None\n        if info.header[3] != pid:\n            return None\n        return Identity(pid, os.path.realpath(os.fsdecode(path.value)), (info.seconds, info.micros), info.header[4])\n\n    def pids(self):\n        return [int(p) for p in subprocess.check_output(['/bin/ps', '-axo', 'pid='], text=True).split()]\n\n    def send(self, pid, sig):\n        os.kill(pid, sig)\n\nclass Candidate:\n    def __init__(self, bundle, processes=None, record=None):\n        self.bundle = Path(bundle).resolve(strict=True)\n        info = plistlib.loads((self.bundle/'Contents/Info.plist').read_bytes())\n        if info.get('CFBundleIdentifier') != FIXTURE_ID or info.get('CFBundleExecutable') != EXECUTABLE:\n            raise ValueError('only the chosen C45 fixture bundle is allowed')\n        app_path=(self.bundle/'Contents/MacOS'/EXECUTABLE).resolve(strict=True)\n        engine_path=(self.bundle/'Contents/Resources/harness/airs-harness').resolve()\n        if not app_path.is_relative_to(self.bundle) or not engine_path.is_relative_to(self.bundle):\n            raise ValueError('candidate executable or engine escapes its fixture bundle')\n        self.app_path=str(app_path)\n        self.engine_path=str(engine_path)\n        self.processes = processes if processes is not None else MacProcesses()\n        self.record = Path(record) if record else None\n        self.app = None\n        self.engines_owned = {}\n        self.child = None\n\n    def matching(self, path):\n        return [s for pid in self.processes.pids() if (s := self.processes.snapshot(pid)) and s.executable == path]\n\n    def valid(self, identity):\n        if identity is None:return False\n        current=self.processes.snapshot(identity.pid)\n        return current is not None and (current.pid,current.executable,current.birth)==(identity.pid,identity.executable,identity.birth)\n\n    def publish(self):\n        if self.record:\n            def value(s):return dict(pid=s.pid, executable=s.executable, birth=s.birth, parent=s.parent)\n            data={'schema':'airs-desktop/candidate-processes/1','bundle':str(self.bundle),\n                  'app':value(self.app) if self.app else None,\n                  'engines':[value(s) for s in self.engines_owned.values()],\n                  'meaning':'Observed exact executable/PID birth identities owned by this driver; no process-name or installed-app lookup.'}\n            self.record.parent.mkdir(parents=True,exist_ok=True)\n            self.record.write_text(json.dumps(data,indent=2)+'\\n')\n\n    def app_pid(self):\n        matches = self.matching(self.app_path)\n        if len(matches)>1:\n            raise RuntimeError('multiple candidate processes; no UI or signal allowed')\n        if self.valid(self.app):return self.app.pid\n# Refinement qualification checkpoint — 2026-11-04\n\nAt this checkpoint, all four implementation streams are integrated and all\n**12 required P11 native assertions have passing observations**. Independent\nchunk/phase reviews and a new production prerelease remain next. No review score,\nstable acceptance or new publication is claimed here. Later bound review and\nstanding receipts are authoritative for acceptance.\n\nThe owner-approved 17-item scope and decisions are in [plan.md](plan.md).\nThe integration base is Forgejo main\n`f1e58da5cdeb1c67eed650b186081661cefc2fa2`.\n\n| Stream | Implemented behavior | Native observations |\n| --- | --- | --- |\n| C46 | Required management OAuth before a new tenant is committed; separate optional Scan Key; metadata-only Edit; source-specific warning rechecks/history and Supply Chain routing | N01 in attempt06; N02–N03 in attempt12 |\n| C47 | Header H1 and compact page introductions/actions; nonmodal Explain; removed header Ask Harness; improved sun icon | N02–N03 in attempt10; N01 derived in attempt11 from the unchanged attempt10 layout matrix and two new API keyboard traces |\n| C48 | Colored JSON/URL editing; scoped footer; scrolling tabs; remembered collection choice; safe response filename suggestions | N01–N03 in attempt07 |\n| C49 | Compact Settings cards; independent Appearance/Theme; isolated Add flow; Academy palette isolation; credential and metadata controls | N01 in attempt07, N02 in attempt08, N03 in attempt09 |\n\nAll interactive development, local checks/builds and native UI run inside the\ndedicated `admin@worf-vm` VM, in branch `refinement/20261104-vm`.\nKirk's old native launcher is retired. The earlier Kirk source checks retain\ntheir original host, source, command and outcome bindings; they are not reported\nas VM executions.\n\n## Candidate and focused source verification\n\nThe current fixture is the actual VM build\n[Native build04](../../evidence/P11/native-build-04-vm), including the Modal\ncomposition fix. Its executable SHA256 is\n`099669efc96b8b54bc300dda33295be6271e81b59b9d11128434330e8073434d`;\nthe complete bundle SHA256 is\n`eb9f93a1a4394574ca36e0c0affdd2c9206dfb5b3496649368cb24079394c7f5`.\nThe earlier `3239facd…` candidate and every original build/failed run remain\nhistorical evidence; they are not the current artifact.\n\nThe VM's affected verification executed formatting/typechecking and all twelve\nregistered frontend test groups: **379 passing tests**. The original complete\nsource Test run had **439 passing executions** on Kirk. Its eight unchanged\nRust test commands (62 executions), other unaffected checks and their original\nbindings are retained with explicit dependency/tool/impact proofs. They were\nnot rerun merely for the VM move, test/helper changes or a new source fingerprint.\n\nThe real Settings Add failure was fixed by moving desktop dialogs outside inert\npage ancestors and preserving opener focus. Both themed App regressions passed.\nThe Administration eager-review test was corrected to await its dialog.\nApplication code and artifact bytes have stayed unchanged throughout the later\ndriver/provenance corrections.\n\nThe final current Python helper verification passed **75/75 tests**, with no\nskips, source drift or application/Rust/Node-suite replay. Its raw record is\n[helper-qa-final-02](../../evidence/P11/helper-qa-final-02/record.json).\n\n## Native evidence and visibility\n\nThe [native selection](../../evidence/P11/native-final-01/native-selection.json)\npreserves all seven actual origins, attempts06–12. Failed overall process exits\nremain failed. Only completed assertions with all facts true are selected.\nAttempt10's false keyboard fact remains explicitly excluded; attempt11 retains\nits unchanged sixteen layout measurements and supplies two actual API keyboard\ntraces. Both traces reached the required controls after 56 tab stops, beyond the\nold driver's arbitrary 24-stop limit.\n\nLater corrections were confined to driver assumptions: AX whitespace/roles,\nreselecting session storage after form remount, measuring actual native chrome,\nthe current Manage API keys label, and split latest-check paragraph text.\nPassing assertions were carried with exact app/helper/condition proofs; no\nunrelated native or Rust suite was replayed.\n\nAttempt12 exited **0**, completed both remaining warning assertions and recorded\nno errors. A denied recheck remained active; a matching successful recheck\nresolved the finding while preserving its original reason/date. The original\nhistory screenshot shows its Settings container. A separate\n[read-only visibility supplement](../../evidence/P11/warning-history-visual-01/receipt.json)\nshows the original dated warning, latest Passed result and resolution time.\n","exit_code":0,"status":"completed"}}
