ing/evidence/P11/qualification-final-02/results/check-C46-check-7.json\ndocs/planning/evidence/P11/qualification-final-02/results/test-C46-frontend-3.json\ndocs/planning/evidence/P11/qualification-final-02/results/test-C47-fixture.json\ndocs/planning/evidence/P11/qualification-final-02/results/test-C46-frontend-2.json\ndocs/planning/evidence/P11/qualification-final-02/results/check-C46-check-6.json\ndocs/planning/evidence/P11/qualification-final-02/results/test-C46-fixture.json\ndocs/planning/evidence/P11/qualification-final-02/results/test-C47-frontend-2.json\ndocs/planning/evidence/P11/qualification-final-02/results/check-C46-check-1.json\ndocs/planning/evidence/P11/qualification-final-02/results/test-C46-frontend-5.json\ndocs/planning/evidence/P11/qualification-final-02/results/C46-N03.json\ndocs/planning/evidence/P11/qualification-final-02/results/C47-N03.json\ndocs/planning/evidence/P11/qualification-final-02/results/test-C48-frontend-2.json\ndocs/planning/evidence/P11/qualification-final-02/results/C49-N01.json\ndocs/planning/evidence/P11/qualification-final-02/results/C48-N01.json\ndocs/planning/evidence/P11/qualification-final-02/results/C46-N02.json\ndocs/planning/evidence/P11/qualification-final-02/results/C47-N02.json\ndocs/planning/evidence/P11/qualification-final-02/results/test-C46-frontend-4.json\ndocs/planning/evidence/P11/qualification-final-02/results/test-C47-frontend-3.json\ndocs/planning/evidence/P11/qualification-final-02/candidate.json\ndocs/planning/evidence/P11/qualification-final-02/runtime-required-coverage.json\ndocs/planning/evidence/P11/qualification-final-02/qualification.json\nAGENTS.md\ndocs/planning/evidence/P10/source-archive/AGENTS.md\ndocs/planning/evidence/P11/source-history/S2/AGENTS.md\ndocs/planning/evidence/P11/source-history/D2/AGENTS.md\ndocs/planning/evidence/C45/activation-20261102-g11/p09-source/AGENTS.md\ndocs/planning/evidence/C45/attempt-02-followup/sources/e2234e2a59f854967708cc570be4cdbaac33336af713c5f2d7f3b09c7aa8