{"type":"item.completed","item":{"id":"item_43","type":"command_execution","command":"/bin/zsh -lc \"sed -n '1,200p' tools/p10/candidate.py; sed -n '390,475p' tools/p11/proof.py; rg -n '\"'^def test|    def test'\"' tools/p11/test_native.py tools/p11/test_proof.py\"","aggregated_output":"\"\"\"Candidate/source bindings shared by C45 qualification and actual reviews.\"\"\"\nfrom pathlib import Path\nimport ast\nimport os\nimport stat\nimport sys\nsys.path.insert(0,str(Path(__file__).resolve().parents[1]/'p09'))\nfrom phase_packet import source_inventory, file_identity, digest\nfrom qualification import read, sha, require\n\n\ndef bundle_hash(bundle):\n    entries=[]\n    for base, directories, files in os.walk(bundle,followlinks=False):\n        symlinks=[name for name in directories if (Path(base)/name).is_symlink()]\n        directories[:]=[name for name in directories if name not in symlinks]\n        for name in files+symlinks:\n            path=Path(base)/name;relative=str(path.relative_to(bundle))\n            if path.is_symlink():mode='symlink';value=__import__('hashlib').sha256(os.readlink(path).encode()).hexdigest()\n            else:mode='100755' if path.stat().st_mode & 0o111 else '100644';value=sha(path)\n            entries.append((relative,mode,value))\n    text=''.join(f'{name}\\0{mode}\\0{value}\\n' for name,mode,value in sorted(entries))\n    return __import__('hashlib').sha256(text.encode()).hexdigest()\n\n\ndef helper_closure(root, driver):\n    folder=root/'tools/native-acceptance';pending=[driver];seen=set()\n    while pending:\n        name=pending.pop()\n        if name in seen or not (folder/(name+'.py')).is_file():continue\n        seen.add(name);tree=ast.parse((folder/(name+'.py')).read_text())\n        for node in ast.walk(tree):\n            if isinstance(node,ast.Import):pending.extend(alias.name.split('.')[0] for alias in node.names)\n            elif isinstance(node,ast.ImportFrom) and node.module:pending.append(node.module.split('.')[0])\n    paths=['tools/native-acceptance/'+name+'.py' for name in seen]\n    # Native compiled helpers/servers are used through literal paths, not imports.\n    paths += [str(p.relative_to(root)) for p in folder.iterdir() if p.suffix in ['.swift','.js']]\n    paths += ['tools/p10/native.py','tools/p10/candidate.py','docs/planning/evidence/P09/native-controller/native_requirements.py']\n    return {name:sha(root/name) for name in sorted(set(paths))}\n\n\ndef verify_source(root, seal):\n    expected=read(root/seal)['files']\n    require(source_inventory(root)==expected,'sealed source membership/content changed')\n    return digest(expected)\n\n\ndef verify_candidate(root, value, historical=None):\n    prepared=read(root/value['prepare']['path'])\n    require(sha(root/value['prepare']['path'])==value['prepare']['sha256'],'preparation drift')\n    bundle=historical.application(value) if historical else root/prepared['bundle']\n    require(sha(bundle/'Contents/MacOS/prisma-airs-desktop')==value['executable_sha256']==prepared['executable_sha256'],'candidate executable drift')\n    require(bundle_hash(bundle)==value['bundle_sha256']==prepared['bundle_sha256'],'complete candidate bundle drift')\n    helper_root=historical.source(value['source_inventory_sha256']) if historical else root\n    for name,value_hash in value['helper_closure'].items():require(sha(helper_root/name)==value_hash,'candidate helper drift: '+name)\n    if value.get('build_origin'):\n        import platform\n        origin=value['build_origin'];path=root/origin['record']\n        require(sha(path)==origin['sha256'],'build origin proof drift')\n        audit=verify_build_reuse(root,read(path),value['runner_inputs'],platform.platform(),platform.node(),historical=historical)\n        require(audit==origin['audit'],'build reuse audit drift')\n    return value\n\n# Explicit helper/provenance-only transition after the baseline02 startup smoke.\n# No application/config/dependency path is permitted. Old raw build and failed\n# smoke remain immutable; this is not a new execution of that build.\nBUILD_REUSE_PATHS = {\n    'tools/p10/historical.py','tools/p10/test_historical.py',\n    'tools/p10/provenance_followup.py','tools/p10/qualification.py',\n    'tools/p10/review_gate.py','tools/p10/followup.py',\n    'crates/xtask/tests/controlled_live.rs',\n    'crates/xtask/tests/live_run/common.rs',\n    'crates/xtask/examples/c45_baseline.rs',\n    'tools/p10/packet.py','tools/p10/followup.py','tools/p10/test_followup.py',\n    'tools/native-acceptance/acceptance_c04.py',\n    'tools/native-acceptance/test_c04_current_frame.py',\n    'tools/native-acceptance/acceptance_c45.py',\n    'tools/p10/candidate.py', 'tools/p10/test_build_reuse.py',\n    'tools/p10/supervise.py', 'tools/p10/seal.py',\n    'tools/p10/finalize.py', 'tools/p10/native.py',\n    'apps/desktop/src-tauri/tests/permission_manifest.rs',\n    'tools/p10/continuation.py', 'tools/p10/test_continuation.py',\n    'tools/native-acceptance/acceptance_c32_current.py',\n    'tools/native-acceptance/test_c32_project_path.py',\n}\n\n\ndef verify_build_reuse(root, record, current_identity, platform_name, hostname, historical=None):\n    from qualification import bound\n    from stages import verify_completed\n    require(record['schema']=='airs-desktop/c45-helper-only-build-reuse/1','build reuse schema')\n    old=read(bound(root,record['original_candidate']))\n    before=read(bound(root,record['original_source']))['files']\n    after=read(bound(root,record['current_source']))['files']\n    changed=sorted(name for name in set(before)|set(after) if before.get(name)!=after.get(name))\n    require(changed==record['declared_changed_paths'] and set(changed)<=BUILD_REUSE_PATHS,'undeclared or application-affecting build-reuse delta')\n    if historical:\n        historical.source(digest(before));historical.source(digest(after))\n    else:require(source_inventory(root)==after,'current build-reuse source changed')\n    require(digest(before)==old['source_inventory_sha256'],'original source seal/candidate mismatch')\n    require(current_identity['dependencies']==old['runner_inputs']['dependencies'] and current_identity['build_flags']==old['runner_inputs']['build_flags'],'build dependency/toolchain/flags changed')\n    if not historical:require(old['conditions']['platform']==platform_name and old['conditions']['hostname']==hostname,'build execution conditions changed')\n    state_path=bound(root,record['original_build_stage']);state=read(state_path)\n    verify_completed(root,state_path.parent,state,state['argv'],digest(before))\n    prepared=read(bound(root,old['prepare']));bundle=historical.application(old) if historical else root/prepared['bundle']\n    require(sha(bundle/'Contents/MacOS/prisma-airs-desktop')==old['executable_sha256']==prepared['executable_sha256'],'retained executable changed')\n    require(bundle_hash(bundle)==old['bundle_sha256']==prepared['bundle_sha256'],'retained complete bundle changed')\n    return {'original_candidate_sha256':record['original_candidate']['sha256'],'original_build_stage_sha256':record['original_build_stage']['sha256'],'declared_helper_only_delta':changed,'executable_sha256':old['executable_sha256'],'bundle_sha256':old['bundle_sha256'],'new_build_executed':False,'meaning':'Exact unchanged application retained from actual baseline02 build; changed C45 selector and qualification provenance execute current affected verification.'}\n    require(set(old_tools) == set(new_tools) == set(audited) == set(comparisons) == names,\n            'tool transition membership differs')\n    for name in names:\n        before, after, joined = old_tools[name], new_tools[name], comparisons[name]\n        require(before['sha256'] == joined['old_sha256']\n                and after['sha256'] == joined['new_sha256'] == audited[name]['sha256'],\n                'tool transition audit does not bind actual executables')\n        if name in ('rustc', 'cargo'):\n            require(before['version'] == after['version'], 'selected Rust version changed')\n        else:\n            # Historical rustup-resolved identities recorded no version string.\n            require(before['sha256'] == after['sha256'], 'actual compiler or JS tool changed')\n\n\ndef validate_impact_selection(root, path, runner_inputs, source=None, files=None):\n    \"\"\"Dated Kirk-to-VM/frontend fix accounting; never creates a passing raw run.\"\"\"\n    record = read(path)\n    require(record['schema'] == 'airs-desktop/p11-impact-selection/1'\n            and record['runner_inputs'] == runner_inputs and record['reason'],\n            'impact selection binding missing')\n    before = read(bound(root, record['baseline_source']))\n    after = read(bound(root, record['current_source']))\n    require(after['files'] == (source_inventory(root) if files is None else files),\n            'impact selection current source differs')\n    require(inventory_source(after) == runner_inputs['source'], 'impact source fingerprint differs')\n    changed = sorted(name for name in set(before['files']) | set(after['files'])\n                     if before['files'].get(name) != after['files'].get(name))\n    require(changed and changed == record['changed_paths'], 'impact delta differs')\n    origin = read(bound(root, record['baseline_candidate']))\n    require(origin['source_inventory_sha256'] == digest(before['files'])\n            and origin['runner_inputs']['source'] == inventory_source(before),\n            'baseline source-check context differs')\n    baseline_root = root / D2_SOURCE\n    require({str(p.relative_to(baseline_root)): file_identity(p)\n             for p in baseline_root.rglob('*') if p.is_file() or p.is_symlink()} == before['files'],\n            'D2 source archive membership/content differs')\n    baseline_check = validate_check_selection(root, bound(root, record['baseline_check']),\n        origin['runner_inputs'], source=baseline_root, files=before['files'])\n    baseline_test = validate_run(root, bound(root, record['baseline_test']), 'test',\n                                 origin['runner_inputs'], source=baseline_root)\n    dependencies = carry_dependencies(before['files'])\n    require(dependencies and dependencies == carry_dependencies(after['files'])\n            and dependencies == record['dependencies']\n            and all(before['files'][name] == after['files'][name] for name in dependencies),\n            'carried dependency membership/content changed')\n    plans = {kind: command_plan(source or root, kind) for kind in ('check', 'test')}\n    labels = {'check': list(IMPACT_CHECKS), 'test': [\n        row['label'] for row in plans['test'] if row['argv'][:2] != ['cargo', 'test']\n        and not row['label'].startswith('setup/')]}\n    require(record['affected'] == labels, 'affected frontend/check selection differs')\n    current = {kind: validate_run(root, bound(root, record['current_runs'][kind]), kind,\n                                  runner_inputs, labels=labels[kind], source=source)\n               for kind in ('check', 'test')}\n    require(current['check']['toolchain'] == current['test']['toolchain'],\n            'affected runs used different tools')\n    verify_tool_transition(root, record['tool_transition'], baseline_test, current['test'])\n    baseline_choices = {'check': baseline_check['selected'], 'test': [\n        {'needed': needed, 'actual': actual, 'raw': baseline_test,\n         'path': bound(root, record['baseline_test'])}\n        for needed, actual in zip(command_plan(baseline_root, 'test'), baseline_test['commands'])]}\n    choices = {}\n    for kind in ('check', 'test'):\n        old = {row['needed']['label']: row for row in baseline_choices[kind]}\n        fresh = {row['label']: row for row in current[kind]['commands']}\n        choices[kind] = []\n        for needed in plans[kind]:\n            if needed['label'].startswith('setup/'):\n                continue\n            label = needed['label']\n            if label in fresh:\n                choice = dict(needed=needed, actual=fresh[label], raw=current[kind],\n                              path=bound(root, record['current_runs'][kind]),\n                              disposition='executed', reason=None)\n            else:\n                require(label in old and old[label]['needed']['argv'] == needed['argv'],\n                        'carried command was not in the original approved plan')\n                choice = dict(old[label], needed=needed, disposition='carried_unaffected',\n                              reason=record['reason'])\n            choices[kind].append(choice)\n    return {'record': record, 'choices': choices, 'origin': origin,\n            'dependencies': dependencies}\n\n\n\nS2_SOURCE = Path('docs/planning/evidence/P11/source-history/S2')\n\ntools/p11/test_native.py:104:    def test_failed_process_can_contribute_only_its_completed_assertion(self):\ntools/p11/test_native.py:119:    def test_helper_and_candidate_drift_cannot_reuse_completed_assertion(self):\ntools/p11/test_native.py:128:    def test_capture_and_admission_proofs_are_bound_without_live_state_reads(self):\ntools/p11/test_native.py:139:    def test_manifest_consumer_survives_fresh_clone_without_app_or_current_host(self):\ntools/p11/test_native.py:150:    def test_three_real_process_origins_retain_five_completed_rows(self):\ntools/p11/test_native.py:199:    def test_positive_selector_preserves_failed_measurement_explicitly(self):\ntools/p11/test_native.py:208:    def test_repaired_keyboard_fact_binds_retained_matrix_and_all_old_pixels(self):\ntools/p11/test_native.py:237:    def test_state_artifact_helper_and_process_drift_fail_before_ui(self):\ntools/p11/test_proof.py:44:    def test_exact_plan_and_logs_are_required(self):\ntools/p11/test_proof.py:67:    def test_no_legacy_common_replay_or_unselected_rust_suite(self):\ntools/p11/test_proof.py:79:    def test_every_new_native_assertion_must_be_present_and_affected(self):\ntools/p11/t