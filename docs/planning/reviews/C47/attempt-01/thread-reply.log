{"type":"item.completed","item":{"id":"item_9","type":"command_execution","command":"/bin/zsh -lc 'cat apps/desktop/src/v2/explain-drawer.tsx apps/desktop/src/v2/page-intro.tsx apps/desktop/src/v2/modal.tsx'","aggregated_output":"import { useEffect, useRef, type KeyboardEvent } from 'react'\nimport type { ShellSnapshot } from '@prisma-airs/desktop-contracts'\nimport type { Dispatch } from '../modules/tenants/dispatch'\nimport { useShellStore } from './store'\nimport { CallsPanel } from './workbench/calls-panel'\n\n/** Nonmodal: only this drawer owns its Escape; navigation and the page stay live. */\nexport function ExplainDrawer({ snapshot, dispatch, onClose, returnFocus, modalOpen }: { snapshot: ShellSnapshot; dispatch: Dispatch; onClose: () => void; returnFocus: HTMLElement | null; modalOpen: boolean }) {\n    const panel = useRef<HTMLDivElement>(null)\n    const restoreFocus = useRef(false)\n    const focusWithin = useRef(false)\n    const close = () => {\n        restoreFocus.current = Boolean(panel.current?.contains(document.activeElement))\n        onClose()\n    }\n    useEffect(() => {\n        // An explicit open moves focus; a persisted preference on launch does not.\n        if (returnFocus && useShellStore.getState().modals.length === 0) panel.current?.querySelector<HTMLButtonElement>('button')?.focus()\n        return () => {\n            if (!restoreFocus.current && !focusWithin.current) return\n            queueMicrotask(() => {\n                if (useShellStore.getState().modals.length > 0 || (document.activeElement && document.activeElement !== document.body)) return\n                if (returnFocus?.isConnected) returnFocus.focus()\n                else document.querySelector<HTMLElement>('[data-slot=\"page-heading\"]')?.focus()\n            })\n        }\n    }, [returnFocus])\n    const onKeyDown = (event: KeyboardEvent<HTMLDivElement>) => {\n        if (event.key !== 'Escape' || event.defaultPrevented || modalOpen) return\n        event.preventDefault()\n        event.stopPropagation()\n        close()\n    }\n    return (\n        <div\n            ref={panel}\n            id='explain-drawer'\n            data-slot='explain-drawer'\n            data-desktop-theme=''\n            onKeyDown={onKeyDown}\n            onFocusCapture={() => { focusWithin.current = true }}\n            onBlurCapture={(event) => { focusWithin.current = event.relatedTarget instanceof Node && event.currentTarget.contains(event.relatedTarget) }}\n            style={{ position: 'absolute', zIndex: 30, top: 0, right: 0, bottom: 0, width: 'min(420px, 100%)', overflowY: 'auto', background: 'var(--v2-paper)', borderLeft: '1px solid var(--v2-rule)', boxShadow: '-12px 0 28px rgba(0,0,0,0.16)' }}\n        >\n            <CallsPanel snapshot={snapshot} dispatch={dispatch} onClose={close} />\n        </div>\n    )\n}\nimport type { ReactNode } from 'react'\n\n/** A page's description and controls; its title belongs to the shell header. */\nexport function PageIntro({ description, actions, status, className = '' }: { description: ReactNode; actions?: ReactNode; status?: ReactNode; className?: string }) {\n    return (\n        <div data-slot='page-intro' className={`flex min-w-0 flex-wrap items-center ${className}`} style={{ gap: '10px 16px' }}>\n            <div data-slot='page-description' className='min-w-0 text-[14px]' style={{ flex: '1 1 20rem', maxWidth: '52rem', color: 'var(--v2-soft)', overflowWrap: 'anywhere' }}>\n                {description}\n            </div>\n            {actions && (\n                <div data-slot='page-actions' className='ml-auto flex min-w-0 flex-wrap items-center' style={{ maxWidth: '100%', gap: 8 }}>\n                    {actions}\n                </div>\n            )}\n            {status && (\n                <div data-slot='page-intro-status' className='w-full min-w-0'>\n                    {status}\n                </div>\n            )}\n        </div>\n    )\n}\nimport { createContext, useContext, useEffect, useId, useLayoutEffect, useRef, useState, type KeyboardEvent, type ReactNode } from 'react'\nimport { createPortal } from 'react-dom'\nimport { useShellStore } from './store'\n\n// Undefined preserves standalone use; null means the shell host is mounting.\nconst DesktopModalHostContext = createContext<HTMLElement | null | undefined>(undefined)\n\n/** Desktop-owned dialogs stay inside the shell palette, outside its inert page. */\nexport function DesktopModalHost({ children }: { children: ReactNode }) {\n    const [host, setHost] = useState<HTMLDivElement | null>(null)\n    return (\n        <DesktopModalHostContext.Provider value={host}>\n            {children}\n            <div ref={setHost} data-slot='desktop-modal-host' data-desktop-theme='' className='contents' />\n        </DesktopModalHostContext.Provider>\n    )\n}\n\ninterface ModalProps {\n    label: string\n    onClose: () => void\n    children: ReactNode\n    /** Width in CSS px (default 560). */\n    width?: number\n    /** Inner padding in CSS px (default 20); 0 for a dialog that lays itself out edge to edge. */\n    padding?: number\n    /** Distance from the top of the window in CSS px (default 4vh); the prototype's palette sits at 90. */\n    top?: number\n    /** Corner radius in CSS px (default 12; the palette's frame is 14). */\n    radius?: number\n    /** A sheet docked to the window's right edge under the header (R2App's review sheet, 620px wide, full height). */\n    sheet?: boolean\n    /**\n     * The control focus returns to on close when the opener itself will be gone\n     * by then (a menu item that closes with its menu as the dialog opens): an\n     * explicit surviving target instead of whatever had focus at mount.\n     */\n    returnFocus?: HTMLElement | null\n    'data-slot'?: string\n}\n\nconst FOCUSABLE = 'a[href], button:not([disabled]), input:not([disabled]), select:not([disabled]), textarea:not([disabled]), [tabindex]:not([tabindex=\"-1\"])'\n\n/**\n * One topmost modal (I8): dialogs register on a shell-wide stack; only the\n * last is interactive. Lower dialogs are inert and aria-hidden, Tab and\n * Shift-Tab stay inside the topmost dialog, Escape closes the topmost only,\n * focus moves into the dialog on open and back to the opener on close. The\n * page behind every dialog is made inert by the shell (`useModalsOpen`).\n * The dialog element handles its own keys; the topmost dialog also listens\n * on the window for Escape alone, for when focus has left it (a native\n * sheet returned focus elsewhere), and closes only itself.\n */\nexport function Modal({ label, onClose, children, width = 560, padding = 20, top, radius = 12, sheet = false, returnFocus = null, ...rest }: ModalProps) {\n    const host = useContext(DesktopModalHostContext)\n    const id = useId()\n    const pushModal = useShellStore((s) => s.pushModal)\n    const popModal = useShellStore((s) => s.popModal)\n    const modals = useShellStore((s) => s.modals)\n    const topmost = modals.length > 0 && modals[modals.length - 1] === id\n    const dialog = useRef<HTMLDivElement>(null)\n    const opener = useRef<HTMLElement | null>(null)\n    const returnRef = useRef(returnFocus)\n    returnRef.current = returnFocus\n    const focusedOnce = useRef(false)\n\n    // Capture before a child wizard's passive heading-focus effect runs.\n    useLayoutEffect(() => {\n        opener.current = document.activeElement instanceof HTMLElement ? document.activeElement : null\n        pushModal(id)\n        return () => {\n            popModal(id)\n            // After the commit: the page behind is still inert during cleanup,\n            // and an inert ancestor refuses focus (observed in WebKit).\n            const target = returnRef.current ?? opener.current\n            queueMicrotask(() => {\n                // Only when nothing else took focus meanwhile (⌘T replacing the\n                // palette hands focus to the tenant list, which must keep it).\n                const active = document.activeElement\n                if (active && active !== document.body) return\n                // The opener may be gone (a \"Finish rotation…\" that completed):\n                // focus the page heading rather than leave it on nothing.\n                if (target?.isConnected) target.focus()\n                else document.querySelector<HTMLElement>('[data-slot=\"page-heading\"], main h1[tabindex=\"-1\"]')?.focus()\n            })\n        }\n    }, [id, pushModal, popModal])\n\n    useEffect(() => {\n        // Initial focus goes into the dialog once, when it opens. Regaining the\n        // top after a higher dialog closes must not refocus: that dialog is\n        // restoring its own opener, which may be any control here.\n        if (!topmost || focusedOnce.current) return\n        const node = dialog.current\n        if (!node) return\n        focusedOnce.current = true\n        if (!node.contains(document.activeElement)) {\n            // A declared initial control first (wherever it sits), else the first focusable.\n            const first = node.querySelector<HTMLElement>('[autofocus]') ?? node.querySelector<HTMLElement>(FOCUSABLE)\n            ;(first ?? node).focus()\n        }\n    }, [topmost, host])\n\n    // Escape still closes the topmost dialog when focus has left it (a\n    // native sheet returning focus to the page body, a click on the scrim's\n    // edge): the dialog's own handler stops the event first when it has focus.\n    const closeRef = useRef(onClose)\n    closeRef.current = onClose\n    useEffect(() => {\n        if (!topmost) return\n        const onWindowKey = (event: globalThis.KeyboardEvent) => {\n            if (event.key !== 'Escape' || event.defaultPrevented) return\n            const node = dialog.current\n            if (node && node.contains(document.activeElement)) return\n            event.preventDefault()\n            closeRef.current()\n        }\n        window.addEventListener('keydown', onWindowKey)\n        return () => window.removeEventListener('keydown', onWindowKey)\n    }, [topmost])\n\n    const onKeyDown = (event: KeyboardEvent<HTMLDivElement>) => {\n        if (!topmost) return\n        if (event.key === 'Escape') {\n            event.preventDefault()\n            event.stopPropagation()\n            onClose()\n            return\n        }\n        if (event.key === 'Tab') {\n            // Keyboard interaction stays inside the topmost dialog.\n            const node = dialog.current\n            if (!node) return\n            const items = Array.from(node.querySelectorAll<HTMLElement>(FOCUSABLE)).filter((el) => !el.hasAttribute('hidden') && el.getAttribute('aria-hidden') !== 'true')\n            if (items.length === 0) {\n                event.preventDefault()\n                node.focus()\n                return\n            }\n            const first = items[0] as HTMLElement\n            const last = items[items.length - 1] as HTMLElement\n            const active = document.activeElement\n            if (event.shiftKey && (active === first || active === node)) {\n                event.preventDefault()\n                last.focus()\n            } else if (!event.shiftKey && active === last) {\n                event.preventDefault()\n                first.focus()\n            }\n        }\n    }\n\n    const content = (\n        <div\n            className={sheet ? 'fixed z-50 flex justify-end' : 'fixed inset-0 z-50 grid place-items-start justify-center'}\n            style={sheet ? { inset: 'var(--v2-header, 56px) 0 0 0' } : { paddingTop: top ?? '4vh' }}\n            data-v2-scrim=''\n            data-desktop-theme=''\n            aria-hidden={topmost ? undefined : true}\n            inert={topmost ? undefined : true}\n            onMouseDown={() => topmost && onClose()}\n        >\n            <div\n                ref={dialog}\n                role='dialog'\n                aria-modal={topmost ? 'true' : undefined}\n                aria-label={label}\n                tabIndex={-1}\n                data-slot={rest['data-slot'] ?? 'modal'}\n                data-topmost={topmost ? 'true' : 'false'}\n                onKeyDown={onKeyDown}\n                onMouseDown={(e) => e.stopPropagation()}\n                className='border'\n                // Bounded to the viewport: a tall dialog scrolls inside itself, so its\n                // actions stay reachable at the minimum window size and 200% zoom.\n                style={\n                    sheet\n                        ? { width: `min(${width}px, 100vw)`, height: '100%', overflowY: 'auto', padding, borderRadius: 0, borderLeft: '1px solid var(--v2-rule)', boxShadow: '-18px 0 40px rgba(0,0,0,0.18)', background: 'var(--v2-bg)', borderWidth: 0, color: 'var(--v2-ink)' }\n                        : { width: `min(${width}px, 92vw)`, maxHeight: '92vh', overflowY: 'auto', padding, borderRadius: radius, boxShadow: '0 24px 60px rgba(0,0,0,0.3)', background: 'var(--v2-paper)', borderColor: 'var(--v2-rule)', color: 'var(--v2-ink)' }\n                }\n            >\n                {children}\n            </div>\n        </div>\n    )\n    return host === undefined ? content : host ? createPortal(content, host) : null\n}\n\n/** Whether any modal is open: the shell makes the page behind it inert. */\nexport function useModalsOpen(): boolean {\n    return useShellStore((s) => s.modals.length > 0)\n}\n","exit_code":0,"status":"completed"}}
