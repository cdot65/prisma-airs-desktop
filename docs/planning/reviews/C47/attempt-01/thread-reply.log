    ctx.navigate('Inbox')\n   100\t    navigation_live = ctx.app.node(ctx.app.tree(), 'AXButton', 'Close Explain') is not None\n   101\t    # Escape on the page belongs to the page, not the nonmodal drawer.\n   102\t    ctx.app.ax('focus', 'AXHeading', 'Inbox')\n   103\t    ctx.app.keycode(53)\n   104\t    page_escape_kept = ctx.app.node(ctx.app.tree(), 'AXButton', 'Close Explain') is not None\n   105\t    ctx.press('AXButton', 'Search or go to')\n   106\t    ctx.text('Command palette')\n   107\t    ctx.app.keycode(53)\n   108\t    modal_priority = ctx.app.node(ctx.app.tree(), 'AXButton', 'Close Explain') is not None\n   109\t    ctx.app.ax('focus', 'AXButton', 'Close Explain')\n   110\t    ctx.app.keycode(53)\n   111\t    tree, closed = ctx.app.wait_for(lambda t: ctx.app.node(t, 'AXButton', 'Close Explain') is None, 8)\n   112\t    focus_back = (ctx.app.focused(tree) or {}).get('label') == 'Show the calls'\n   113\t    ctx.press_any('Show the calls')\n   114\t    ctx.press('AXButton', 'Close Explain')\n   115\t    tree, close_button = ctx.app.wait_for(lambda t: ctx.app.node(t, 'AXButton', 'Close Explain') is None, 8)\n   116\t    ctx.press_any('Show the calls')\n   117\t    setup.switch(ctx, ctx.state['spare_tenant'])\n   118\t    tree = ctx.app.tree()\n   119\t    tree, tenant_closed = ctx.app.wait_for(lambda t: ctx.app.node(t, 'AXButton', 'Close Explain') is None, 8)\n   120\t    setup.switch(ctx, ctx.state['bootstrap_tenant'])\n   121\t    retired = ctx.app.node(ctx.app.tree(), 'AXButton', 'Close Explain') is None\n   122\t    evidence = ctx.save('explain-native-observations', {'before_main': before, 'after_main': after, 'final_tree': ctx.app.tree()})\n   123\t    ctx.record('C47-N02', {'overlay_did_not_change_main_width': same_width, 'page_refresh_remained_usable': control_live,\n   124\t                          'navigation_remained_usable': navigation_live, 'page_escape_did_not_close_drawer': page_escape_kept,\n   125\t                          'modal_escape_preserved_drawer': modal_priority, 'drawer_escape_closed': closed,\n   126\t                          'focus_returned_to_explain': focus_back, 'close_button_worked': close_button,\n   127\t                          'tenant_change_closed_and_retired_drawer': tenant_closed and retired}, [evidence], [drawer_capture])\n   128\t    theme_images = []\n   129\t    no_ask, sidebar, next_action = [], [], []\n   130\t    for appearance, expected in (('Dark', 'light'), ('Light', 'dark')):\n     7\t/** Nonmodal: only this drawer owns its Escape; navigation and the page stay live. */\n     8\texport function ExplainDrawer({ snapshot, dispatch, onClose, returnFocus, modalOpen }: { snapshot: ShellSnapshot; dispatch: Dispatch; onClose: () => void; returnFocus: HTMLElement | null; modalOpen: boolean }) {\n     9\t    const panel = useRef<HTMLDivElement>(null)\n    10\t    const restoreFocus = useRef(false)\n    11\t    const focusWithin = useRef(false)\n    12\t    const close = () => {\n    13\t        restoreFocus.current = Boolean(panel.current?.contains(document.activeElement))\n    14\t        onClose()\n    15\t    }\n    16\t    useEffect(() => {\n    17\t        // An explicit open moves focus; a persisted preference on launch does not.\n    18\t        if (returnFocus && useShellStore.getState().modals.length === 0) panel.current?.querySelector<HTMLButtonElement>('button')?.focus()\n    19\t        return () => {\n    20\t            if (!restoreFocus.current && !focusWithin.current) return\n    21\t            queueMicrotask(() => {\n    22\t                if (useShellStore.getState().modals.length > 0 || (document.activeElement && document.activeElement !== document.body)) return\n    23\t                if (returnFocus?.isConnected) returnFocus.focus()\n    24\t                else document.querySelector<HTMLElement>('[data-slot=\"page-heading\"]')?.focus()\n    25\t            })\n    26\t        }\n    27\t    }, [returnFocus])\n    28\t    const onKeyDown = (event: KeyboardEvent<HTMLDivElement>) => {\n    29\t        if (event.key !== 'Escape' || event.defaultPrevented || modalOpen) return\n    30\t        event.preventDefault()\n    31\t        event.stopPropagation()\n    32\t        close()\n    33\t    }\n    34\t    return (\n    35\t        <div\n    36\t            ref={panel}\n    37\t            id='explain-drawer'\n    38\t            data-slot='explain-drawer'\n    39\t            data-desktop-theme=''\n    40\t            onKeyDown={onKeyDown}\n    41\t            onFocusCapture={() => { focusWithin.current = true }}\n    42\t            onBlurCapture={(event) => { focusWithin.current = event.relatedTarget instanceof Node && event.currentTarget.contains(event.relatedTarget) }}\n    43\t            style={{ position: 'absolute', zIndex: 30, top: 0, right: 0, bottom: 0, width: 'min(420px, 100%)', overflowY: 'auto', background: 'var(--v2-paper)', borderLeft: '1px solid var(--v2-rule)', boxShadow: '-12px 0 28px rgba(0,0,0,0.16)' }}\n    44\t        >\n    45\t            <CallsPanel snapshot={snapshot} dispatch={dispatch} onClose={close} />\n    46\t        </div>\n    47\t    )\n    48\t}\n{\n  \"schema\": \"airs-desktop/p11-helper-qa/1\",\n  \"argv\": [\n    \"/Library/Developer/CommandLineTools/usr/bin/python3\",\n    \"docs/planning/evidence/P11/helper-qa-final-02/run.py\"\n  ],\n  \"cwd\": \"/Users/cdot/development/redtail/p09-queue/refinement-20261104/core\",\n  \"started_utc\": \"2026-11-04T17:11:20.862867+00:00\",\n  \"finished_utc\": \"2026-11-04T17:11:24.082200+00:00\",\n  \"exit_code\": 0,\n  \"tests\": {\n    \"passed\": 75,\n    \"failed\": 0\n  },\n  \"skipped\": 0,\n  \"log\": {\n    \"path\": \"docs/planning/evidence/P11/helper-qa-final-02/qa.log\",\n    \"sha256\": \"b12cf4692c507a3c875a7302e8efd34b3d3016633f07f6dceedf04b107816af3\"\n  },\n  \"helper_files\": {\n    \"tools/native-acceptance/acceptance_p11_api.py\": \"bcf93c6c13ecfa04e877eebc51bf30424c806688ef4c3aff04129a4e830eebb8\",\n    \"tools/nativ