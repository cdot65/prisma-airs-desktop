{"type":"item.completed","item":{"id":"item_37","type":"command_execution","command":"/bin/zsh -lc \"sed -n '42,100p' apps/desktop/src/v2/icons.tsx; sed -n '275,348p' apps/desktop/src/v2/workbench/api-client.tsx; cat apps/desktop/src/v2/modal.test.tsx\"","aggregated_output":"export type GlyphName = keyof typeof PATHS\n\n/** The destinations' glyphs, as the prototype's NAV draws them. */\nexport const FEATURE_GLYPHS: Partial<Record<FeatureId, GlyphName>> = {\n    home: 'home',\n    inbox: 'inbox',\n    harness: 'bot',\n    academy: 'cap',\n    library: 'cases',\n    apiClient: 'code',\n    administration: 'sliders',\n    runtime: 'shield',\n    gateway: 'route',\n    redTeam: 'cross',\n    sessions: 'clock',\n    settings: 'sliders',\n}\n\n/** The Administration products' glyphs (the prototype's PRODUCTS). */\nexport const PRODUCT_GLYPHS: Record<AdminProductId, GlyphName> = {\n    runtimeSecurity: 'shield',\n    redTeam: 'cross',\n    modelSkill: 'box',\n    gateway: 'route',\n    agenticIdentity: 'idcard',\n    agenticEndpoint: 'laptop',\n}\n\nexport function Glyph({ name, size = 16, stroke = 1.8, color, className }: { name: GlyphName; size?: number; stroke?: number; color?: string; className?: string }) {\n    return (\n        <svg width={size} height={size} viewBox='0 0 24 24' fill='none' stroke={color ?? 'currentColor'} strokeWidth={stroke} strokeLinecap='round' strokeLinejoin='round' aria-hidden='true' className={className} style={{ flexShrink: 0 }}>\n            {name === 'sun' && <circle cx='12' cy='12' r='3.5' />}\n            <path d={PATHS[name]} />\n        </svg>\n    )\n}\n        >\n            <PageIntro className='w-full' description={<span data-slot='api-lead'>{collection ? C.description : C.leadNone}</span>} actions={collection ? (\n                <div className='ml-auto flex min-w-0 max-w-full flex-wrap items-center' style={{ gap: 8 }} data-slot='api-chips'>\n                    <span className='relative'>\n                        <button\n                            ref={chip}\n                            type='button'\n                            aria-haspopup='menu'\n                            aria-expanded={menu}\n                            aria-label={`${C.chips.collection} ${collection.name}`}\n                            className={CHIP}\n                            style={chipStyle}\n                            onClick={(e) => {\n                                e.stopPropagation()\n                                setMenu((m) => !m)\n                            }}\n                            data-slot='collection-chip'\n                        >\n                            <Glyph name='folder' size={13} color='var(--v2-ink)' />\n                            <span style={faint}>{C.chips.collection}</span>\n                            <b>{collection.name}</b>\n                            <span style={faint}>{where}</span>\n                            <Glyph name='chev' size={10} color='var(--v2-faint)' />\n                        </button>\n                        {menu ? (\n                            <div\n                                role='menu'\n                                aria-label={C.menu}\n                                className='absolute top-full right-0 z-10 mt-1 flex min-w-52 flex-col rounded-[10px] border p-1 text-[13px]'\n                                style={{\n                                    borderColor: 'var(--v2-rule)',\n                                    background: 'var(--v2-paper)',\n                                    boxShadow: '0 12px 30px rgba(0,0,0,0.18)',\n                                }}\n                                data-slot='collection-menu'\n                            >\n                                <button type='button' role='menuitem' className='rounded-[7px] px-3 py-1.5 text-left' onClick={() => void run({ kind: 'refresh' })}>\n                                    {C.refresh}\n                                </button>\n                                {TOOLS.map((t) => (\n                                    <button key={t} type='button' role='menuitem' className='rounded-[7px] px-3 py-1.5 text-left' aria-haspopup='dialog' onClick={() => setTool(t)}>\n                                        {C.tools[t]}\n                                    </button>\n                                ))}\n                                <button type='button' role='menuitem' className='rounded-[7px] px-3 py-1.5 text-left' onClick={() => void close({ kind: 'collection' })}>\n                                    {C.closeCollection}\n                                </button>\n                            </div>\n                        ) : null}\n                    </span>\n                    <label className={CHIP} style={chipStyle} data-slot='environment-chip'>\n                        <span\n                            aria-hidden\n                            className='rounded-full'\n                            style={{\n                                width: 8,\n                                height: 8,\n                                background: environment ? 'var(--v2-ok)' : 'var(--v2-faint)',\n                            }}\n                        />\n                        <span style={faint}>{C.chips.environment}</span>\n                        <select\n                            aria-label={C.chips.environment}\n                            value={collection.environment ?? ''}\n                            onChange={(e) =>\n                                void run({\n                                    kind: 'selectEnvironment',\n                                    name: e.target.value === '' ? null : e.target.value,\n                                })\n                            }\n                            className='min-h-0 border-0 bg-transparent font-bold'\n                            style={{\n                                border: 0,\n                                minHeight: 0,\n/**\n * I8 at the shared modal boundary: two stacked dialogs keep keyboard\n * interaction inside the topmost, the lower one is inert and hidden, Escape\n * closes only the top, and each opener gets its focus back.\n */\nimport { render, screen, waitFor } from '@testing-library/react'\nimport userEvent from '@testing-library/user-event'\nimport { beforeEach, describe, expect, it } from 'vitest'\nimport { useState } from 'react'\nimport { Modal } from './modal'\nimport { resetShellStore, useShellStore } from './store'\n\nfunction Stack() {\n    const [outer, setOuter] = useState(false)\n    const [inner, setInner] = useState(false)\n    return (\n        <div>\n            <button type='button' onClick={() => setOuter(true)}>\n                Open outer\n            </button>\n            <button type='button'>Page control</button>\n            {outer && (\n                <Modal label='Outer' onClose={() => setOuter(false)}>\n                    <button type='button' onClick={() => setInner(true)}>\n                        Open inner\n                    </button>\n                    <button type='button'>Outer second</button>\n                </Modal>\n            )}\n            {inner && (\n                <Modal label='Inner' onClose={() => setInner(false)}>\n                    <input aria-label='Inner field' />\n                    <button type='button'>Inner done</button>\n                </Modal>\n            )}\n        </div>\n    )\n}\n\nbeforeEach(() => resetShellStore())\n\ndescribe('modal stack (I8)', () => {\n    it('keeps only the topmost dialog interactive, traps Tab, closes top-first on Escape and restores each opener', async () => {\n        const user = userEvent.setup()\n        render(<Stack />)\n        const openOuter = screen.getByRole('button', { name: 'Open outer' })\n        openOuter.focus()\n        await user.keyboard('{Enter}')\n        const outer = screen.getByRole('dialog', { name: 'Outer' })\n        expect(outer).toHaveAttribute('aria-modal', 'true')\n        expect(screen.getByRole('button', { name: 'Open inner' })).toHaveFocus()\n        // Tab wraps inside the outer dialog.\n        await user.tab()\n        expect(screen.getByRole('button', { name: 'Outer second' })).toHaveFocus()\n        await user.tab()\n        expect(screen.getByRole('button', { name: 'Open inner' })).toHaveFocus()\n        await user.tab({ shift: true })\n        expect(screen.getByRole('button', { name: 'Outer second' })).toHaveFocus()\n        // Open the inner dialog: the outer one becomes inert and hidden.\n        await user.click(screen.getByRole('button', { name: 'Open inner' }))\n        const inner = screen.getByRole('dialog', { name: 'Inner' })\n        expect(inner).toHaveAttribute('aria-modal', 'true')\n        expect(outer).not.toHaveAttribute('aria-modal')\n        expect(outer).toHaveAttribute('data-topmost', 'false')\n        expect(outer.parentElement).toHaveAttribute('aria-hidden', 'true')\n        expect(outer.parentElement).toHaveAttribute('inert')\n        expect(useShellStore.getState().modals).toHaveLength(2)\n        expect(screen.getByRole('textbox', { name: 'Inner field' })).toHaveFocus()\n        await user.tab()\n        await user.tab()\n        expect(screen.getByRole('textbox', { name: 'Inner field' })).toHaveFocus()\n        // Escape closes the inner dialog only; focus returns to its opener.\n        await user.keyboard('{Escape}')\n        expect(screen.queryByRole('dialog', { name: 'Inner' })).toBeNull()\n        expect(screen.getByRole('dialog', { name: 'Outer' })).toHaveAttribute('aria-modal', 'true')\n        expect(screen.getByRole('button', { name: 'Open inner' })).toHaveFocus()\n        await user.keyboard('{Escape}')\n        expect(screen.queryByRole('dialog')).toBeNull()\n        expect(openOuter).toHaveFocus()\n        expect(useShellStore.getState().modals).toHaveLength(0)\n    })\n\n    it('restores the exact non-first opener of a stacked dialog', async () => {\n        const user = userEvent.setup()\n        render(<Stack />)\n        await user.click(screen.getByRole('button', { name: 'Open outer' }))\n        // Open the inner dialog from the outer dialog's second control.\n        const second = screen.getByRole('button', { name: 'Outer second' })\n        second.focus()\n        await user.keyboard('{Enter}')\n        expect(screen.queryByRole('dialog', { name: 'Inner' })).toBeNull()\n        // 'Outer second' does nothing on Enter; open inner via its own control but with\n        // the opener recorded as 'Outer second' by focusing it right before the click.\n        second.focus()\n        const openInner = screen.getByRole('button', { name: 'Open inner' })\n        openInner.addEventListener('mousedown', (e) => e.preventDefault(), { once: true })\n        await user.click(openInner)\n        expect(screen.getByRole('dialog', { name: 'Inner' })).toHaveAttribute('aria-modal', 'true')\n        await user.keyboard('{Escape}')\n        expect(screen.queryByRole('dialog', { name: 'Inner' })).toBeNull()\n        await waitFor(() => expect(screen.getByRole('button', { name: 'Outer second' })).toHaveFocus())\n    })\n\n    it('Escape closes only the topmost dialog even when focus has left it (a native sheet returned focus to the page)', async () => {\n        const user = userEvent.setup()\n        render(<Stack />)\n        await user.click(screen.getByRole('button', { name: 'Open outer' }))\n        await user.click(screen.getByRole('button', { name: 'Open inner' }))\n        ;(document.activeElement as HTMLElement | null)?.blur()\n        expect(document.activeElement).toBe(document.body)\n        await user.keyboard('{Escape}')\n        await waitFor(() => expect(screen.queryByRole('dialog', { name: 'Inner' })).toBeNull())\n        expect(screen.getByRole('dialog', { name: 'Outer' })).toBeInTheDocument()\n    })\n\n    it('returns focus to the page heading when the opener no longer exists', async () => {\n        const user = userEvent.setup()\n        function Gone() {\n            const [open, setOpen] = useState(false)\n            const [opener, setOpener] = useState(true)\n            return (\n                <main>\n                    <h1 tabIndex={-1}>Page</h1>\n                    {opener && (\n                        <button type='button' onClick={() => setOpen(true)}>\n                            Open once\n                        </button>\n                    )}\n                    {open && (\n                        <Modal label='Once' onClose={() => setOpen(false)}>\n                            <button type='button' onClick={() => setOpener(false)}>\n                                Finish\n                            </button>\n                        </Modal>\n                    )}\n                </main>\n            )\n        }\n        render(<Gone />)\n        await user.click(screen.getByRole('button', { name: 'Open once' }))\n        await user.click(screen.getByRole('button', { name: 'Finish' }))\n        await user.keyboard('{Escape}')\n        await waitFor(() => expect(screen.queryByRole('dialog', { name: 'Once' })).toBeNull())\n        await waitFor(() => expect(screen.getByRole('heading', { name: 'Page' })).toHaveFocus())\n    })\n})\n","exit_code":0,"status":"completed"}}
