{"type":"item.started","item":{"id":"item_44","type":"command_execution","command":"/bin/zsh -lc \"cat tools/native-acceptance/test_p11_keyboard.py; sed -n '1,120p' tools/native-acceptance/acceptance_p11.py; sed -n '125,270p' tools/native-acceptance/acceptance_p11.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_44","type":"command_execution","command":"/bin/zsh -lc \"cat tools/native-acceptance/test_p11_keyboard.py; sed -n '1,120p' tools/native-acceptance/acceptance_p11.py; sed -n '125,270p' tools/native-acceptance/acceptance_p11.py\"","aggregated_output":"\"\"\"Pure driver regressions; these fixtures never execute UI or claim native passes.\"\"\"\nimport unittest\nfrom unittest.mock import MagicMock, call, patch\n\nimport acceptance_p11_keyboard as keyboard\nimport acceptance_p11_shell as original\n\n\ndef node(role, label, pos=(10, 10)):\n    return {'role': role, 'label': label, 'pos': list(pos), 'size': [100, 20],\n            'depth': 5, 'focused': False, 'enabled': True}\n\n\nclass FakeApp:\n    def __init__(self, nodes):\n        self.nodes, self.index = nodes, -1\n\n    def ax(self, *_):\n        self.index = -1\n\n    def keycode(self, code):\n        assert code == 48\n        self.index = (self.index + 1) % len(self.nodes)\n\n    def tree(self):\n        for i, item in enumerate(self.nodes):\n            item['focused'] = i == self.index\n        return self.nodes\n\n    @staticmethod\n    def focused(tree):\n        return next((item for item in tree if item['focused']), None)\n\n\nclass KeyboardTests(unittest.TestCase):\n    @staticmethod\n    def frame():\n        return [0, 0, 500, 500]\n\n    def walk(self, app):\n        return keyboard.traverse(app.tree(), lambda: app.keycode(48), app.tree,\n                                 app.focused, self.frame)\n\n    def test_actual_frozen_24_tab_cap_misses_later_request_action(self):\n        controls = [node('AXPopUpButton', 'Collection P11 API'),\n                    node('AXPopUpButton', 'Environment')]\n        controls += [node('AXButton', 'Close tab owned-%02d' % i) for i in range(26)]\n        controls += [node('AXTextField', 'URL')]\n        app = FakeApp(controls)\n        context = type('Context', (), {'app': app, 'frame': self.frame})()\n        old_passed, old_focus = original.focus_visible(context, 'API Client')\n        self.assertFalse(old_passed)\n        self.assertTrue(old_focus['label'].startswith('Close tab'))\n        app.ax('focus', 'AXHeading', 'API Client')\n        trace, focused = self.walk(app)\n        self.assertEqual(trace['steps'], 29)\n        self.assertGreater(trace['steps'], 24)\n        self.assertEqual(set(trace['reached']), {'collection', 'environment', 'request_action'})\n        self.assertEqual(focused['label'], 'URL')\n        self.assertTrue(all(row['inside_window'] for row in trace['reached'].values()))\n\n    def test_wrong_label_does_not_count_and_a_real_cycle_stops(self):\n        app = FakeApp([node('AXPopUpButton', 'Collection P11 API'),\n                       node('AXPopUpButton', 'Environment'), node('AXButton', 'URL details')])\n        with self.assertRaises(keyboard.TraversalFailure) as caught:\n            self.walk(app)\n        self.assertEqual(caught.exception.record['failure'], 'focus_cycle')\n        self.assertNotIn('request_action', caught.exception.record['reached'])\n\n    def test_focused_goal_must_have_positive_geometry_inside_actual_window(self):\n        for bad in [node('AXPopUpButton', 'Collection P11 API', (600, 10)),\n                    dict(node('AXPopUpButton', 'Collection P11 API'), size=[0, 0])]:\n            app = FakeApp([bad, node('AXPopUpButton', 'Environment'), node('AXTextField', 'URL')])\n            with self.subTest(bad=bad), self.assertRaises(keyboard.TraversalFailure) as caught:\n                self.walk(app)\n            self.assertEqual(caught.exception.record['failure'], 'focused_goal_outside_window')\n\n    def test_changing_focus_nodes_still_have_finite_ax_element_bound(self):\n        initial = [node('AXPopUpButton', 'Collection P11 API'), node('AXPopUpButton', 'Environment')]\n        state = {'step': 0}\n        def tab():\n            state['step'] += 1\n        def tree():\n            return [dict(node('AXButton', 'unrelated-%s' % state['step']), focused=True)]\n        with self.assertRaises(keyboard.TraversalFailure) as caught:\n            keyboard.traverse(initial, tab, tree, FakeApp.focused, self.frame)\n        self.assertEqual(caught.exception.record['failure'], 'ax_element_bound')\n        self.assertEqual(state['step'], 2 * len(initial))\n\n\n    def test_run_routes_both_viewports_through_measured_geometry_not_old_shell_sizer(self):\n        ctx = MagicMock()\n        ctx.app.focused.return_value = {'role': 'AXHeading', 'label': 'API Client'}\n        ctx.save.side_effect = lambda name, *_: name + '.json'\n        ctx.capture.side_effect = lambda name: name + '.png'\n        old = {'facts': keyboard.EXPECTED_FACTS, 'visual': []}\n        matrix = [dict(page='API Client', theme=theme, zoom=zoom,\n                       named_action_keyboard_visible=False, **{flag: True for flag in keyboard.FLAGS})\n                  for theme, zoom in [('Light', 100), ('Dark', 200)]]\n        prior = {'observations': {'path': 'original.json'}, 'measurements': {'path': 'matrix.json'}}\n        with patch.object(keyboard, 'inspect_prior', return_value=(\n                {'execution_id': 'pure-route-fixture', 'exit_code': 1}, old, matrix)), \\\n             patch.object(keyboard, 'traverse', return_value=({}, node('AXTextField', 'URL'))), \\\n             patch.object(keyboard.c29, 'appearance'), patch.object(keyboard.c29, 'zoom'), \\\n             patch.object(keyboard.geometry, 'size_window') as measured, \\\n             patch.object(keyboard.shell, 'size_window', side_effect=AssertionError('old sizing bug replayed')):\n            keyboard.run(ctx, prior)\n        self.assertEqual(measured.call_args_list, [call(ctx, 1440, 820), call(ctx, 900, 600)])\n\n\nif __name__ == '__main__':\n    unittest.main()\n#!/usr/bin/env python3\n\"\"\"Affected P11 native flow, with immutable raw observations and separate visual review.\n\nExecute only against --prepare's exact fixture bundle. --finalize performs no UI:\nit binds measured facts, actual P11 test records, and capture-specific visual review.\nNo old scan-only setup helper, installed app lookup, or process-name signaling.\n\"\"\"\nimport argparse\nimport ast\nimport hashlib\nimport importlib.util\nimport json\nimport math\nimport os\nfrom pathlib import Path\nimport platform\nimport plistlib\nimport re\nimport sys\nimport tempfile\nimport time\nfrom typing import TYPE_CHECKING\n\n# Literal subprocess server inputs must join candidate.helper_closure's AST graph.\nif TYPE_CHECKING:\n    import mgmt_server, scan_server, academy_server, academy_catalog\n\nROOT = Path.cwd().resolve()\nTOOLS = Path(__file__).resolve().parent\nsys.path.insert(0, str(TOOLS))\nsys.path.insert(0, str(ROOT/'tools/p10'))\n_spec = importlib.util.spec_from_file_location('p11_candidate_bindings', ROOT/'tools/p10/candidate.py')\n_binding = importlib.util.module_from_spec(_spec)\n_spec.loader.exec_module(_binding)\n\n\ndef sha(path):\n    return hashlib.sha256(Path(path).read_bytes()).hexdigest()\n\n\ndef write_new(path, value):\n    path = Path(path)\n    with path.open('x') as stream:\n        json.dump(value, stream, indent=2)\n        stream.write('\\n')\n\n\ndef inventory():\n    chunks = json.loads((ROOT/'docs/architecture/native-checks.json').read_text())['chunks']\n    return {row['id']: row['check'] for chunk in ('C46', 'C47', 'C48', 'C49') for row in chunks[chunk]}\n\n\ndef verify_prepare(path):\n    prepared = json.loads(path.read_text())\n    bundle = (ROOT/prepared['bundle']).resolve(strict=True)\n    info = plistlib.loads((bundle/'Contents/Info.plist').read_bytes())\n    if prepared['identifier'] != 'io.cdot.airs-desktop.fixture' or info.get('CFBundleIdentifier') != prepared['identifier']:\n        raise RuntimeError('only the explicitly prepared fixture identity is allowed')\n    if info.get('CFBundleExecutable') != 'prisma-airs-desktop':\n        raise RuntimeError('unexpected fixture executable')\n    if sha(bundle/'Contents/MacOS/prisma-airs-desktop') != prepared['executable_sha256']:\n        raise RuntimeError('prepared executable drift')\n    if _binding.bundle_hash(bundle) != prepared['bundle_sha256']:\n        raise RuntimeError('complete prepared bundle drift')\n    return prepared, bundle\n\n\nclass Context:\n    def __init__(self, prepare, out):\n        self.prepare_path, self.out = prepare.resolve(), out.resolve()\n        self.prepared, self.bundle = verify_prepare(self.prepare_path)\n        self.out.mkdir(parents=True, exist_ok=False)\n        self.work = Path(tempfile.mkdtemp(prefix='airs-p11-owned-'))\n        self.log, self.rows, self.errors, self.artifacts = [], {}, [], {}\n        self.fixture_root_owned = False\n        self.argv = list(getattr(sys, \"orig_argv\", [sys.executable, *sys.argv]))\n        self.argv_source = \"sys.orig_argv\" if hasattr(sys, \"orig_argv\") else \"sys.executable + sys.argv (Python has no orig_argv)\"\n        self.state = {'bootstrap_tenant': 'P11 Northwind', 'spare_tenant': 'P11 Secondary', 'scan_absent': True}\n        self.closure = _binding.helper_closure(ROOT, 'acceptance_p11')\n        self.binding = {'prepare': {'path': str(self.prepare_path), 'sha256': sha(self.prepare_path)},\n                        'bundle': str(self.bundle), 'executable_sha256': self.prepared['executable_sha256'],\n                        'bundle_sha256': self.prepared['bundle_sha256'], 'helper_closure': self.closure,\n                        'native_inventory_sha256': sha(ROOT/'docs/architecture/native-checks.json')}\n        self.started = time.strftime('%Y-%m-%dT%H:%M:%SZ', time.gmtime())\n        self.execution_exit_code = 1\n        self.app = self.mgmt = self.scan = self.academy = None\n\n    @staticmethod\n    def require(condition, message):\n        if not condition:\n            raise RuntimeError(message)\n\n    def relative(self, path):\n        return str(Path(path).resolve().relative_to(ROOT))\n\n    def save(self, name, tree=None):\n        self.require(re.fullmatch(r'[A-Za-z0-9_.-]+', name), 'unsafe evidence name')\n        path = self.out/(name+'.json')\n        write_new(path, self.app.tree() if tree is None else tree)\n        relative = self.relative(path)\n        self.artifacts[relative] = sha(path)\n        return relative\n\n    def capture(self, name):\n        import acceptance_c29 as c29\n        self.require(not (self.out/'captures'/(name+'.png')).exists(), 'capture already exists')\n        c29.NATIVE = str(self.out)\n        path = c29.capture(self.app, name)\n        self.require(path, 'fixture window did not produce a capture')\n        self.artifacts[path] = sha(ROOT/path)\n        return path\n\n    def frame(self):\n        # App.ax revalidates this prepared candidate's executable/PID before\n        # each request; Swift also checks the selected AXWindow's PID and role.\n        frame = json.loads(self.app.ax('frame'))\n        self.require(isinstance(frame, list) and len(frame) == 4 and\n                     all(type(n) in (int, float) and math.isfinite(n) for n in frame) and\n                     frame[2] > 0 and frame[3] > 0, 'owned window returned an invalid frame')\n        return frame\n                     all(type(n) in (int, float) and math.isfinite(n) for n in values) and\n                     width > 0 and height > 0, 'invalid owned window resize request')\n        self.app.front()\n        self.app.ax('resize', *values)\n        deadline = time.monotonic() + 3\n        while True:\n            frame = self.frame()\n            sized = abs(frame[2]-width) <= 2 and abs(frame[3]-height) <= 2\n            # macOS may clamp the requested position below its menu bar.\n            # Retain measured placement; only size is the requested invariant.\n            if sized:\n                self.log.append({'action': 'owned-window-resize', 'pid': self.app.pid,\n                                 'requested': values, 'measured': frame,\n                                 'utc': time.strftime('%Y-%m-%dT%H:%M:%SZ', time.gmtime())})\n                return frame\n            self.require(time.monotonic() < deadline, f'owned window resize did not reach requested geometry: {values} != {frame}')\n            time.sleep(.1)\n\n    def press(self, role, label, timeout=12):\n        tree, ready = self.app.wait_for(lambda t: self.app.node(t, role, label) is not None, timeout)\n        self.require(ready, f'missing {role} {label}')\n        node = self.app.node(tree, role, label)\n        self.require(node.get('enabled') is not False, f'disabled {role} {label}')\n        self.app.ax('press', role, label)\n        time.sleep(.3)\n        return self.app.tree()\n\n    def press_any(self, label, timeout=12):\n        roles = ('AXButton', 'AXCheckBox', 'AXRadioButton', 'AXPopUpButton')\n        tree, ready = self.app.wait_for(lambda t: any(self.app.node(t, r, label) for r in roles), timeout)\n        self.require(ready, f'missing control {label}')\n        role = next(r for r in roles if self.app.node(tree, r, label))\n        return self.press(role, label, timeout)\n\n    def text(self, fragment, timeout=15):\n        tree, ready = self.app.wait_for(lambda t: self.app.has_text(t, fragment), timeout)\n        self.require(ready, f'missing fixture text {fragment}')\n        return tree\n\n    def heading(self, label, timeout=15):\n        tree, ready = self.app.wait_for(lambda t: self.app.node(t, 'AXHeading', label) is not None, timeout)\n        self.require(ready, f'missing heading {label}')\n        return tree\n\n    def navigate(self, label):\n        self.app.menu('Go', label)\n        return self.heading(label)\n\n    def fixture_state(self):\n        import fixture_app as fx\n        return json.loads((Path(fx.DATA)/'state.json').read_text())\n\n    def wait_state(self, predicate, message, timeout=15):\n        deadline = time.monotonic()+timeout\n        while time.monotonic() < deadline:\n            value = self.fixture_state()\n            if predicate(value):\n                return value\n            time.sleep(.2)\n        raise RuntimeError(message)\n\n    def record(self, check_id, facts, evidence, visual=None):\n        self.require(check_id in inventory() and check_id not in self.rows, 'unknown or repeated assertion')\n        self.require(bool(facts) and all(type(value) is bool for value in facts.values()), 'facts must be measured booleans')\n        for path in evidence + list(visual or []):\n            self.require((ROOT/path).resolve().is_relative_to(self.out) and (ROOT/path).is_file(), 'evidence must be inside this immutable attempt')\n            self.artifacts[path] = sha(ROOT/path)\n        self.rows[check_id] = {'id': check_id, 'facts': facts, 'evidence': evidence, 'visual': list(visual or [])}\n        self.partial()\n\n    def partial(self):\n        # This file is progress, never acceptance; final raw record uses exclusive creation.\n        (self.out/'observations.partial.json').write_text(json.dumps(self.observations(False), indent=2)+'\\n')\n\n    def observations(self, complete):\n        return {'schema': 'airs-desktop/p11-native-observations/1', 'subject': 'P11', 'complete': complete,\n                'argv': self.argv, 'argv_source': self.argv_source, 'started_utc': self.started, 'finished_utc': time.strftime('%Y-%m-%dT%H:%M:%SZ', time.gmtime()),\n                'performed_by': os.environ.get('AIRS_NATIVE_ORCHESTRATOR'), 'host': platform.platform(),\n                'execution_id': self.out.name, 'status': 'observed' if complete else 'failed', 'exit_code': self.execution_exit_code,\n                'executable_sha256': self.prepared['executable_sha256'], 'bundle_sha256': self.prepared['bundle_sha256'], 'helper_closure': self.closure,\n                'binding': self.binding, 'artifact_sha256': self.artifacts, 'checks': list(self.rows.values()), 'errors': self.errors, 'log': self.log,\n                'meaning': 'Actual fixture AX/keyboard/geometry observations. Pixels and production-interface results need separate bound review; no unrun assertion is a pass.'}\n\n\ndef execute(args):\n    import fixture_app as fx\n    import acceptance_c08 as c8\n    import academy_catalog\n    import acceptance_p11_setup as setup\n    import acceptance_p11_api as api\n    import acceptance_p11_settings as settings\n    import acceptance_p11_shell as shell\n    original_sh = fx.sh\n\n    def checked_sh(argv, **kwargs):\n        result = original_sh(argv, **kwargs)\n        if Path(str(argv[0])).name == 'osascript' and result.returncode != 0:\n            # Never echo a script or its possibly secret-bearing input.\n            denied = 'not allowed' in result.stderr.lower() or 'not authorized' in result.stderr.lower()\n            raise RuntimeError('System Events transport failed: exit ' + str(result.returncode)\n                               + (' (permission denied)' if denied else ' (command rejected)'))\n        return result\n\n    fx.sh = checked_sh\n    if not os.environ.get('AIRS_NATIVE_ORCHESTRATOR'):\n        raise RuntimeError('set AIRS_NATIVE_ORCHESTRATOR to the actual UI operator')\n    ctx = Context(args.prepare, args.out)\n    os.environ['AIRS_NATIVE_PROCESS_RECORD'] = str(ctx.out/'candidate-processes.json')\n    try:\n        ctx.app = fx.App(str(ctx.bundle), str(ctx.work), ctx.log)\n        candidate = ctx.app.candidate\n        ctx.require(not candidate.matching(candidate.app_path) and not candidate.matching(candidate.engine_path), 'unowned prepared fixture process exists; refusing data cleanup or adoption')\n        ctx.fixture_root_owned = True\n        fx.clean_fixture_root()\n        ctx.scan = fx.ScanEndpoint(str(ctx.work/'scan'), c8.SCAN_KEY)\n        ctx.scan.install_roots()\n        ctx.scan.start()\n        ctx.mgmt = c8.MgmtEndpoint(str(ctx.work/'scan'), str(ctx.work/'mgmt'))\n        ctx.mgmt.install()\n        ctx.mgmt.start()\n        ctx.academy = fx.AcademyEndpoint(str(ctx.work/'academy'))\n        (Path(ctx.academy.dir)/'catalog.json').write_text(json.dumps(academy_catalog.build(str(ROOT))))\n        ctx.academy.install()\n        ctx.academy.start()\n        # Both trust anchors are generated by this attempt, never system/login roots.\n        Path(fx.ROOTS).write_bytes((ctx.work/'scan/ca.pem').read_bytes()+b'\\n'+(ctx.work/'academy/ca.pem').read_bytes())\n        setup.bootstrap(ctx)\n        api.run(ctx)  # first API entry must occur here, before shell page matrix\n        settings.run(ctx)\n        shell.run(ctx)\n        setup.warning_flows(ctx)\n        verify_prepare(ctx.prepare_path)\n        ctx.require(_binding.helper_closure(ROOT, 'acceptance_p11') == ctx.closure, 'native helper changed during execution')\n        ctx.require(set(ctx.rows) == set(inventory()), 'some native assertions were never reached')\n        ctx.require(all(value for row in ctx.rows.values() for value in row['facts'].values()), 'one or more measured native facts failed')\n        ctx.execution_exit_code = 0\n    except BaseException as error:\n        ctx.execution_exit_code = 130 if isinstance(error, KeyboardInterrupt) else (error.code if isinstance(error, SystemExit) and isinstance(error.code, int) else 1)\n        ctx.errors.append({'type': type(error).__name__, 'message': str(error)})\n        if ctx.app:\n            try:\n                ctx.save('failure-tree')\n            except Exception:\n                pass\n    finally:\n        if ctx.fixture_root_owned:\n","exit_code":0,"status":"completed"}}
