                       snapshot={snapshot}\n                                dispatch={props.dispatch}\n                                client={props.client}\n                                onAct={props.onAct}\n                                onNavigate={props.onNavigate}\n                                arrival={arrival && arrival.tenant === tenantNow && arrival.feature === 'administration' ? arrival : null}\n                            />\n                        ) : feature.id === 'harness' && feature.availability.state === 'available' ? (\n                            <Harness\n                                key={snapshot.active?.context ?? 'none'}\n\n                                snapshot={snapshot}\n                                dispatch={props.dispatch}\n                                onNavigate={props.onNavigate}\n                                arrival={arrival && arrival.tenant === tenantNow && arrival.feature === 'harness' ? arrival : null}\n                            />\n                        ) : feature.id === 'library' && feature.availability.state === 'available' ? (\n                            // Keyed by context: a new tenant starts at its first page, nothing inspected.\n                            <TestCases key={snapshot.active?.context ?? 'none'} snapshot={snapshot} dispatch={props.dispatch} onNavigate={props.onNavigate} />\n                        ) : feature.id === 'academy' && feature.availability.state === 'available' ? (\n                            // Not keyed by tenant: the learner generation is the account's, not the tenant's.\n                            <Academy snapshot={snapshot} client={props.client} onNavigate={props.onNavigate} />\n                        ) : feature.id === 'apiClient' && feature.availability.state === 'available' ? (\n                            // Not keyed by tenant: API Client documents are on this Mac.\n                            <ApiClient snapshot={snapshot} dispatch={props.dispatch} observe={observeWorkbench} />\n                        ) : (feature.id === 'runtime' || feature.id === 'gateway' || feature.id === 'redTeam') && feature.availability.state === 'available' ? (\n                            // C44: the product destinations (Go, the palette) open Administration on their product; the legacy views are gone.\n                            <Administration\n                                key={snapshot.active?.context ?? 'none'}\n\n                                snapshot={snapshot}\n                                dispatch={props.dispatch}\n                                client={props.client}\n                                onAct={props.onAct}\n                                onNavigate={props.onNavigate}\n                                arrival={tenantNow ? { tenant: tenantNow, feature: 'administration', resource: null, item: null, ...PRODUCT_DESTINATION[feature.id] } : null}\n                            />\n                        ) : (\n                            <FeatureBody\n\n                                feature={feature}\n                                snapshot={snapshot}\n                                appearancePending={props.appearancePending}\n                                onSetAppearance={props.onSetAppearance}\n                                onNavigate={props.onNavigate}\n                                dispatch={props.dispatch}\n                                client={props.client}\n                            />\n                        )}\n                        <p role='status' aria-live='polite' data-slot='shell-status' className='mt-4 text-[13px]' style={{ color: 'var(--v2-soft)' }}>\n                            {props.status}\n                        </p>\n                    </main>\n                    {explainOpen && snapshot.calls !== undefined && <ExplainDrawer snapshot={snapshot} dispatch={props.dispatch} onClose={() => setExplain(false)} returnFocus={explainOpener.current} modalOpen={modalOpen} />}\n                </div>\n            </div>\n            {paletteOpen && (\n                <Palette snapshot={snapshot} onNavigate={props.onNavigate} onSwitchTenant={props.onSwitchTenant} onReadNow={props.onReadNow} onClose={closePalette} />\n            )}\n            {guard && guardTarget && (\n                <SwitchGuard target={guardTarget} completion={false} binding={guard} onStay={() => void props.dispatch({ kind: 'dismissSwitchGuard' })} onResolve={(resolution) => props.onSwitchTenant(guard.to, resolution)} />\n            )}\n            {adding && (\n                <Modal label='Add a tenant' onClose={() => setCloseRequests((n) => n + 1)} width={1160} padding={0} data-slot='add-tenant-sheet'>\n                    <Wizard\n                        snapshot={snapshot}\n                        dispatch={props.dispatch}\n                        observeManagement={(operation) => props.client.observeManagement(operation)}\n                        mode='add'\n                        onClose={closeSheet}\n                        closeRequests={closeRequests}\n                        onNavigate={(feature) => {\n                            setAdding(false)\n                            props.onNavigate(feature)\n                        }}\n                    />\n                </Modal>\n            )}\n            {/* Toasts are background siblings of a modal too (I8): inert and hidden while one is open. */}\n            <div aria-hidden={modalOpen ? true : undefined} inert={modalOpen ? true : undefined}>\n                <Toasts />\n            </div>\n            </DesktopModalHost>\n        </div>\n    )\n}\nimport type { CallView, ShellSnapshot } from '@prisma-airs/desktop-contracts'\nimport type { Dispatch } from '../../modules/tenants/dispatch'\nimport { CALLS_COPY as C } from './copy'\n\n/** How long a call took, as the API Client's completion says it. */\nconst durationOf = (ms: number) => (ms < 1000 ? `${ms} ms` : `${(ms / 1000).toFixed(1)} s`)\n\n/**\n * \"Show the calls\" (C33, DESIGN-V2 §3): beside every destination while the\n * Rust-owned preference is on, the calls this app made for the active\n * tenant, newest last, as the core recorded them: the request line without\n * its query, header names (never values), the credential by kind (the core\n * attached it), and the response status, duration and content type. No body\n * is ever kept. Rendered like the API Client's response line.\n */\nexport function CallsPanel({ snapshot, dispatch, onClose }: { snapshot: ShellSnapshot; dispatch: Dispatch; onClose?: () => void }) {\n    const calls = snapshot.calls\n    if (!snapshot.showCalls || calls === undefined) return null\n    return (\n        <aside aria-label={C.title} data-slot='calls-panel' className='flex min-w-0 flex-col gap-3 p-4 text-[13px]' style={{ width: '100%' }}>\n            <div className='flex items-center justify-between gap-2'>\n                <h2 className='text-[15px] font-semibold'>{C.title}</h2>\n                <button type='button' aria-label={onClose ? C.closeExplain : undefined} className='h-8 rounded-[7px] border px-3 text-[12px]' style={{ borderColor: 'var(--v2-rule)' }} onClick={() => (onClose ? onClose() : void dispatch({ kind: 'setShowCalls', on: false }))}>\n                    {onClose ? C.close : C.hide}\n                </button>\n            </div>\n            <p className='text-[12px]' style={{ color: 'var(--v2-soft)' }}>\n                {C.note}\n            </p>\n            {calls.length === 0 ? (\n                <p data-slot='calls-empty'>{C.empty}</p>\n            ) : (\n                <ol className='flex flex-col gap-2' data-slot='calls-list'>\n                    {calls.map((call) => (\n                        <CallItem key={call.sequence} call={call} />\n                    ))}\n                </ol>\n            )}\n        </aside>\n    )\n}\n\nfunction CallItem({ call }: { call: CallView }) {\n    const outcome = call.status !== null ? String(call.status) : C.failed\n    return (\n        <li className='flex flex-col gap-1 rounded-[10px] border p-3' style={{ borderColor: 'var(--v2-rule)' }} data-slot='call' data-purpose={call.purpose}>\n            <div className='flex flex-wrap items-baseline gap-x-2 text-[12px]' style={{ color: 'var(--v2-soft)' }}>\n                <span>{C.purpose[call.purpose]}</span>\n                <span>\n                    {outcome} · {durationOf(call.durationMs)}\n                </span>\n            </div>\n            <p className='break-all font-mono text-[12px]'>\n                <span className='font-semibold' style={{ color: 'var(--v2-get)' }}>\n                    {call.method}\n                </span>{' '}\n                {call.origin}\n                {call.path}\n                {call.query ? <span style={{ color: 'var(--v2-soft)' }}> ({C.query})</span> : null}\n            </p>\n            <p className='text-[12px]'>{C.credential[call.credential]}</p>\n            <details className='text-[12px]'>\n                <summary className='cursor-pointer'>\n                    {C.requestHeaders} · {C.bytes(call.requestBytes)}\n                </summary>\n                <p className='break-all font-mono'>{call.requestHeaders.join(', ')}</p>\n                <p className='mt-1' style={{ color: 'var(--v2-soft)' }}>\n                    {C.responseHeaders}\n                    {call.contentType ? ` · ${call.contentType}` : ''}\n                </p>\n                <p className='break-all font-mono'>{call.responseHeaders.join(', ')}</p>\n            </details>\n        </li>\n    )\n}\n","exit_code":0,"status":"completed"}}
