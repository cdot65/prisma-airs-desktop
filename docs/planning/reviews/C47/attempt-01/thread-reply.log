{"type":"item.completed","item":{"id":"item_19","type":"command_execution","command":"/bin/zsh -lc 'cat tools/native-acceptance/acceptance_p11_shell.py tools/native-acceptance/acceptance_p11_keyboard.py'","aggregated_output":"\"\"\"P11 shell native observations; exact fixture process and keyboard only.\"\"\"\nimport time\nimport acceptance_c29 as c29\nimport acceptance_c41 as c41\nimport acceptance_p11_setup as setup\n\nSOURCE_REQUIREMENTS = {\n    'frontend': ['src/v2/shell-refinement.test.tsx', 'src/v2/v2-shell.test.tsx', 'src/v2/modal.test.tsx', 'src/v2/home.test.tsx', 'src/v2/inbox/inbox.test.tsx', 'src/v2/admin/administration.test.tsx', 'src/v2/harness/harness.test.tsx', 'src/v2/academy/academy.test.tsx', 'src/v2/workbench/workbench.test.tsx', 'src/modules/sessions/sessions-view.test.tsx'],\n    'rust': [],\n}\n\nPAGES = ('Home', 'Inbox', 'Test Cases', 'API Client', 'Administration', 'Settings', 'Harness', 'Academy')\nACTIONS = {'Home': ('Refresh',), 'Inbox': ('Refresh',), 'Test Cases': ('Load packs', 'New case'),\n           'API Client': ('URL', 'Send'), 'Administration': ('Expand all', 'Collapse all'),\n           'Settings': ('Appearance', 'Theme'), 'Harness': ('New investigation',), 'Academy': ('Learn', 'Open Runtime')}\n\n\ndef title(tree, label):\n    return [n for n in tree if n.get('role') == 'AXHeading' and n.get('label') == label and n.get('value') == 1]\n\n\ndef main_region(tree):\n    return next((n for n in tree if n.get('subrole') == 'AXLandmarkMain'), None)\n\n\ndef focus_visible(ctx, label):\n    ctx.app.ax('focus', 'AXHeading', label)\n    for _ in range(24):\n        ctx.app.keycode(48)\n        tree = ctx.app.tree()\n        focused = ctx.app.focused(tree)\n        if focused and any((focused.get('label') or '').startswith(name) for name in ACTIONS[label]):\n            return c29.inside(ctx.frame(), focused), focused\n    return False, ctx.app.focused(ctx.app.tree())\n\n\ndef size_window(ctx, width, height):\n    # Preserve C41's viewport-height adjustment, using the candidate-owned\n    # AX window instead of System Events' sometimes-empty window list.\n    requested = [width, height+c41.TITLE_BAR]\n    for _ in range(3):\n        ctx.resize(*requested, position=(0, 0))\n        time.sleep(.8)\n        measured = c41.geometry(ctx.app.tree())\n        viewport = measured['viewport'] or measured['web']\n        if not viewport or viewport[1] == height:\n            break\n        requested[1] += height-viewport[1]\n    return ctx.frame()\n\n\ndef run(ctx):\n    setup.switch(ctx, ctx.state['bootstrap_tenant'])\n    layouts, artifacts, pictures = [], [], []\n    ctx.navigate('Inbox')  # ensure the first Home entry is an actual navigation\n    # One paired matrix: ordinary light and narrow/effective200% dark on\n    # every changed destination. C49 independently exercises all4palettes.\n    for theme, width, height, zoom in (('Light', 1440, 820, 0), ('Dark', 900, 600, 10)):\n        ctx.app.menu('View', 'Actual Size')\n        ctx.app.front()\n        size_window(ctx, width, height)\n        c29.appearance(ctx.app, theme)\n        if zoom:\n            c29.zoom(ctx.app, zoom)\n        for page in PAGES:\n            tree = ctx.navigate(page)\n            tree, focused = ctx.app.wait_for(lambda t: bool((ctx.app.focused(t) or {}).get('label') == page), 8)\n            headers = title(tree, page)\n            main = main_region(tree)\n            reachable, control = focus_visible(ctx, page)\n            current = ctx.app.tree()\n            name = 'shell-'+page.lower().replace(' ', '-')+'-'+theme.lower()+'-'+('200' if zoom else '100')\n            artifacts.append(ctx.save(name, current))\n            pictures.append(ctx.capture(name))\n            layouts.append({'page': page, 'theme': theme, 'zoom': 200 if zoom else 100,\n                            'requested': [width, height], 'geometry': c41.geometry(current),\n                            'one_named_header_h1': len(headers) == 1, 'navigation_focus': focused,\n                            'main': main, 'main_inside_window': c29.inside(ctx.frame(), main),\n                            'named_action_keyboard_visible': reachable, 'focused_action': control,\n                            'academy_location': page != 'Academy' or ctx.app.has_text(current, 'Academy location')})\n    matrix = ctx.save('shell-layout-measurements', layouts)\n    ctx.record('C47-N01', {'all_destinations_have_one_named_header_h1': all(r['one_named_header_h1'] for r in layouts),\n                          'navigation_focus_observed': all(r['navigation_focus'] for r in layouts),\n                          'main_frames_measured_inside_window': all(r['main_inside_window'] for r in layouts),\n                          'named_actions_keyboard_reachable': all(r['named_action_keyboard_visible'] for r in layouts),\n                          'academy_hierarchy_retained': all(r['academy_location'] for r in layouts)}, [matrix, *artifacts], pictures)\n    ctx.app.menu('View', 'Actual Size')\n    ctx.resize(1440, 900)\n    ctx.navigate('Home')\n    before = main_region(ctx.app.tree())\n    ctx.press_any('Show the calls')\n    ctx.text('The calls')\n    opened = ctx.app.tree()\n    after = main_region(opened)\n    same_width = bool(before and after and abs(before['size'][0]-after['size'][0]) <= 1)\n    drawer_capture = ctx.capture('explain-overlay')\n    ctx.press('AXButton', 'Refresh')\n    control_live = ctx.app.node(ctx.app.tree(), 'AXButton', 'Close Explain') is not None\n    ctx.navigate('Inbox')\n    navigation_live = ctx.app.node(ctx.app.tree(), 'AXButton', 'Close Explain') is not None\n    # Escape on the page belongs to the page, not the nonmodal drawer.\n    ctx.app.ax('focus', 'AXHeading', 'Inbox')\n    ctx.app.keycode(53)\n    page_escape_kept = ctx.app.node(ctx.app.tree(), 'AXButton', 'Close Explain') is not None\n    ctx.press('AXButton', 'Search or go to')\n    ctx.text('Command palette')\n    ctx.app.keycode(53)\n    modal_priority = ctx.app.node(ctx.app.tree(), 'AXButton', 'Close Explain') is not None\n    ctx.app.ax('focus', 'AXButton', 'Close Explain')\n    ctx.app.keycode(53)\n    tree, closed = ctx.app.wait_for(lambda t: ctx.app.node(t, 'AXButton', 'Close Explain') is None, 8)\n    focus_back = (ctx.app.focused(tree) or {}).get('label') == 'Show the calls'\n    ctx.press_any('Show the calls')\n    ctx.press('AXButton', 'Close Explain')\n    tree, close_button = ctx.app.wait_for(lambda t: ctx.app.node(t, 'AXButton', 'Close Explain') is None, 8)\n    ctx.press_any('Show the calls')\n    setup.switch(ctx, ctx.state['spare_tenant'])\n    tree = ctx.app.tree()\n    tree, tenant_closed = ctx.app.wait_for(lambda t: ctx.app.node(t, 'AXButton', 'Close Explain') is None, 8)\n    setup.switch(ctx, ctx.state['bootstrap_tenant'])\n    retired = ctx.app.node(ctx.app.tree(), 'AXButton', 'Close Explain') is None\n    evidence = ctx.save('explain-native-observations', {'before_main': before, 'after_main': after, 'final_tree': ctx.app.tree()})\n    ctx.record('C47-N02', {'overlay_did_not_change_main_width': same_width, 'page_refresh_remained_usable': control_live,\n                          'navigation_remained_usable': navigation_live, 'page_escape_did_not_close_drawer': page_escape_kept,\n                          'modal_escape_preserved_drawer': modal_priority, 'drawer_escape_closed': closed,\n                          'focus_returned_to_explain': focus_back, 'close_button_worked': close_button,\n                          'tenant_change_closed_and_retired_drawer': tenant_closed and retired}, [evidence], [drawer_capture])\n    theme_images = []\n    no_ask, sidebar, next_action = [], [], []\n    for appearance, expected in (('Dark', 'light'), ('Light', 'dark')):\n        c29.appearance(ctx.app, appearance)\n        tree = ctx.navigate('Home')\n        no_ask.append(not any(n.get('role') == 'AXButton' and n.get('label') == 'Ask Harness' for n in tree))\n        sidebar.append(ctx.app.node(tree, 'AXButton', 'Harness') is not None)\n        switch = ctx.app.node(tree, 'AXCheckBox', 'Switch light or dark appearance')\n        ctx.require(switch, 'appearance switch absent')\n        if switch:\n            ctx.app.ax('focus', 'AXCheckBox', 'Switch light or dark appearance')\n        theme_images.append(ctx.capture('shell-sun-'+appearance.lower()))\n        ctx.press_any('Switch light or dark appearance')\n        ctx.wait_state(lambda value: value['appearance'] == expected, 'appearance next action did not persist')\n        next_action.append(True)\n    ctx.record('C47-N03', {'redundant_ask_harness_absent': all(no_ask), 'sidebar_harness_retained': all(sidebar), 'labelled_next_action_worked': all(next_action),\n                          'appearance_control_present': all(ctx.app.node(ctx.app.tree(), role, 'Switch light or dark appearance') is not None for role in ('AXCheckBox',))},\n               [ctx.save('shell-sun-labels', {'next_action_labels': next_action, 'tree': ctx.app.tree()})], theme_images)\n    c29.appearance(ctx.app, 'Match System')\n    ctx.navigate('Home')\n\"\"\"C47-N01: retain the frozen matrix and measure only its two unfinished API focus paths.\"\"\"\nimport copy\nimport hashlib\nimport json\nfrom pathlib import Path\n\nimport acceptance_c29 as c29\nimport acceptance_p11_shell as shell\nimport acceptance_p11_geometry as geometry\n\nROOT = Path.cwd().resolve()\nFLAGS = ('one_named_header_h1', 'navigation_focus', 'main_inside_window', 'academy_location')\nEXPECTED_FACTS = {\n    'all_destinations_have_one_named_header_h1': True,\n    'navigation_focus_observed': True,\n    'main_frames_measured_inside_window': True,\n    'named_actions_keyboard_reachable': False,\n    'academy_hierarchy_retained': True,\n}\nVIEWS = (('Light', 1440, 820, 0, 100), ('Dark', 900, 600, 10, 200))\n\n\ndef require(value, message):\n    if not value:\n        raise RuntimeError(message)\n\n\ndef sha(path):\n    return hashlib.sha256(Path(path).read_bytes()).hexdigest()\n\n\ndef bound(root, ref):\n    path = (root / ref['path']).resolve()\n    require(path.is_relative_to(root.resolve()) and sha(path) == ref['sha256'],\n            'prior keyboard evidence escapes or changed')\n    return path\n\n\ndef inspect_prior(ctx, prior, root=ROOT):\n    raw_path = bound(root, prior['observations'])\n    matrix_path = bound(root, prior['measurements'])\n    raw = json.loads(raw_path.read_text())\n    require(raw['schema'] == 'airs-desktop/p11-native-observations/1' and raw['subject'] == 'P11'\n            and raw['status'] == 'failed' and raw['exit_code'] == 1 and raw['complete'] is False,\n            'original failed matrix process must remain failed')\n    require(raw['binding']['helper_closure'] == raw['helper_closure']\n            and all(raw[key] == raw['binding'][key] == ctx.prepared[key]\n                    for key in ('executable_sha256', 'bundle_sha256'))\n            and raw['binding']['prepare']['sha256'] == ctx.binding['prepare']['sha256']\n            and raw['binding']['native_inventory_sha256'] == ctx.binding['native_inventory_sha256']\n            and raw['host'] == ctx.binding['conditions']['platform'],\n            'prior matrix candidate, platform or binding changed')\n    for name, digest in raw['helper_closure'].items():\n        file = (root / name).resolve()\n        require(file.is_relative_to(root) and file.is_file()\n                and ctx.closure.get(name) == digest == sha(file), 'prior matrix helper bytes changed')\n    for name, digest in raw['artifact_sha256'].items():\n        artifact = (root / name).resolve()\n        require(artifact.is_relative_to(raw_path.parent) and sha(artifact) == digest,\n                'prior matrix artifact changed')\n    rows = [row for row in raw['checks'] if row['id'] == 'C47-N01']\n    require(len(rows) == 1 and rows[0]['facts'] == EXPECTED_FACTS,\n            'prior N01 had a different failed fact')\n    row = rows[0]\n    relative = str(matrix_path.relative_to(root))\n    require(relative in row['evidence'] and raw['artifact_sha256'].get(relative) == prior['measurements']['sha256'],\n            'matrix is not bound by the original N01')\n    matrix = json.loads(matrix_path.read_text())\n    expected = {(page, theme, zoom) for page in shell.PAGES for theme, _, _, _, zoom in VIEWS}\n    require(len(matrix) == 16 and {(r['page'], r['theme'], r['zoom']) for r in matrix} == expected,\n            'frozen matrix membership changed')\n    for item in matrix:\n        require(all(item.get(flag) is True for flag in FLAGS), 'frozen non-keyboard measurement failed')\n        require(item['requested'] == ([1440, 820] if item['theme'] == 'Light' else [900, 600]),\n                'frozen matrix viewport changed')\n        require(item['named_action_keyboard_visible'] is (item['page'] != 'API Client'),\n                'frozen matrix has an unexpected keyboard result')\n    require(len(row['visual']) == len(set(row['visual'])) == 16\n            and all(name in raw['artifact_sha256'] for name in row['visual']),\n            'original matrix captures missing')\n    return raw, row, matrix\n\n\nclass TraversalFailure(RuntimeError):\n    def __init__(self, reason, record):\n        super().__init__('API keyboard traversal failed: ' + reason)\n        self.record = dict(record, failure=reason)\n\n\ndef focus_key(tree, node):\n    semantic = lambda value: (value.get('role'), value.get('label'), value.get('subrole'), value.get('depth'))\n    peers = [value for value in tree if semantic(value) == semantic(node)]\n    return (*semantic(node), next((i for i, value in enumerate(peers) if value is node), 0))\n\n\ndef traverse(initial, tab, tree_now, focused, frame):\n    \"\"\"One finite measured focus cycle, bounded by the actual AX tree size.\"\"\"\n    collection = [n for n in initial if n.get('role') == 'AXPopUpButton'\n                  and (n.get('label') or '').startswith('Collection ')]\n    require(len(collection) == 1, 'API Collection selector is missing or ambiguous')\n    require(sum(n.get('role') == 'AXPopUpButton' and n.get('label') == 'Environment'\n                for n in initial) == 1, 'API Environment selector is missing or ambiguous')\n    labels = {'collection': ('AXPopUpButton', collection[0]['label']),\n              'environment': ('AXPopUpButton', 'Environment')}\n    limit = 2 * max(1, len(initial))\n    trace, seen, reached = [], set(), {}\n    record = {'initial_ax_elements': len(initial), 'element_bound': limit,\n              'expected_header_selectors': labels, 'trace': trace, 'reached': reached}\n    for step in range(1, limit + 1):\n        tab()\n        tree = tree_now()\n        node = focused(tree)\n        if not node:\n            trace.append({'step': step, 'focused': None})\n            continue\n        key = focus_key(tree, node)\n        if key in seen:\n            raise TraversalFailure('focus_cycle', record)\n        seen.add(key)\n        viewport = frame()\n        inside = bool(node.get('enabled') is not False and node.get('size')\n                      and all(value > 0 for value in node['size']) and c29.inside(viewport, node))\n        entry = {'step': step, 'role': node.get('role'), 'label': node.get('label'),\n                 'pos': node.get('pos'), 'size': node.get('size'), 'window': viewport,\n                 'inside_window': inside}\n        trace.append(entry)\n        pair = (node.get('role'), node.get('label'))\n        goals = [name for name, expected in labels.items() if pair == expected]\n        if pair in (('AXTextField', 'URL'), ('AXButton', 'Send')):\n            goals.append('request_action')\n        for goal in goals:\n            if not inside:\n                raise TraversalFailure('focused_goal_outside_window', record)\n            reached[goal] = dict(entry)\n        if set(reached) == {'collection', 'environment', 'request_action'}:\n            record['steps'] = step\n            return record, node\n    raise TraversalFailure('ax_element_bound', record)\n\n\ndef run(ctx, prior):\n    raw, old_row, matrix = inspect_prior(ctx, prior)\n    proof = ctx.save('c47-keyboard-prior-binding', {\n        'prior_raw': prior['observations'], 'prior_measurements': prior['measurements'],\n        'original_execution_id': raw['execution_id'], 'original_process_exit_code': raw['exit_code'],\n        'original_failed_facts': old_row['facts'],\n        'disposition': 'Retain original non-keyboard and fourteen keyboard measurements; '\n                       'replace only the two failed API keyboard measurements with new observations.'})\n    corrected = copy.deepcopy(matrix)\n    evidence, captures, replacements = [prior['measurements']['path'], proof], [], []\n    for theme, width, height, zoom, percent in VIEWS:\n        name = 'c47-api-keyboard-' + theme.lower() + '-' + str(percent)\n        ctx.app.menu('View', 'Actual Size')\n        ctx.app.front()\n        geometry.size_window(ctx, width, height)\n        c29.appearance(ctx.app, theme)\n        if zoom:\n            c29.zoom(ctx.app, zoom)\n        ctx.navigate('API Client')\n        ctx.app.ax('focus', 'AXHeading', 'API Client')\n        initial = ctx.app.tree()\n        start = ctx.app.focused(initial) or {}\n        ctx.require(start.get('role') == 'AXHeading' and start.get('label') == 'API Client',\n                    'API header did not receive actual native focus')\n        try:\n            trace, node = traverse(initial, lambda: ctx.app.keycode(48), ctx.app.tree,\n                                   ctx.app.focused, ctx.frame)\n        except TraversalFailure as error:\n            ctx.save(name + '-trace', error.record)\n            raise\n        trace_ref = ctx.save(name + '-trace', trace)\n        evidence += [trace_ref, ctx.save(name + '-focused', ctx.app.tree())]\n        captures.append(ctx.capture(name))\n        item = next(r for r in corrected if r['page'] == 'API Client'\n                    and r['theme'] == theme and r['zoom'] == percent)\n        item['named_action_keyboard_visible'] = True\n        item['focused_action'] = node\n        replacements.append({'page': 'API Client', 'theme': theme, 'zoom': percent,\n                             'prior_keyboard_visible': False, 'new_trace': trace_ref,\n                             'collection_and_environment_keyboard_visible': True})\n    evidence.append(ctx.save('c47-keyboard-supplement-measurements', {\n        'prior_raw': prior['observations'], 'prior_measurements': prior['measurements'],\n        'replacements': replacements, 'derived_measurements': corrected,\n        'meaning': 'New derived N01 evidence. The original failed raw row and matrix are unchanged.'}))\n    facts = {'all_destinations_have_one_named_header_h1': all(r['one_named_header_h1'] for r in corrected),\n             'navigation_focus_observed': all(r['navigation_focus'] for r in corrected),\n             'main_frames_measured_inside_window': all(r['main_inside_window'] for r in corrected),\n             'named_actions_keyboard_reachable': all(r['named_action_keyboard_visible'] for r in corrected),\n             'academy_hierarchy_retained': all(r['academy_location'] for r in corrected),\n             'api_header_selectors_keyboard_visible': len(replacements) == 2}\n    ctx.app.menu('View', 'Actual Size')\n    ctx.resize(1440, 900)\n    return {'id': 'C47-N01', 'facts': facts, 'evidence': evidence,\n            'visual': [*old_row['visual'], *captures]}\n","exit_code":0,"status":"completed"}}
