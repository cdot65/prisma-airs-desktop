{"type":"item.completed","item":{"id":"item_32","type":"command_execution","command":"/bin/zsh -lc \"sed -n '1,210p' apps/desktop/src/app.tsx; sed -n '1840,1885p' crates/desktop-core/src/authority.rs; sed -n '3605,3640p' crates/desktop-core/src/authority.rs; sed -n '260,345p' crates/desktop-core/src/transport.rs; sed -n '445,520p' crates/desktop-core/src/transport.rs\"","aggregated_output":"import { useCallback, useEffect, useLayoutEffect, useRef, useState } from 'react'\nimport {\n    DeliveryOutcomeUnknown,\n    type DesktopClient,\n    type FeatureId,\n    type Intent,\n    type MenuCommand,\n    type Refusal,\n    type ShellSnapshot,\n    type Theme,\n} from '@prisma-airs/desktop-contracts'\nimport { followAppearance } from './shell/appearance'\nimport { type DispatchOutcome, outcomeMessage } from './modules/tenants/dispatch'\nimport { V2Shell } from './v2/v2-shell'\nimport { Wizard } from './v2/wizard/wizard'\nimport { deliveryContext, useShellStore } from './v2/store'\nimport { SHELL_COPY } from './v2/copy'\nimport { forgetAcademyPresentation } from './modules/academy/presentation-storage'\nimport { SAVE_DOCUMENT_EVENT } from './v2/workbench/request-editor'\n\nexport function App({ client }: { client: DesktopClient }) {\n    const [snapshot, setSnapshot] = useState<ShellSnapshot | null>(null)\n    const snapshotRef = useRef<ShellSnapshot | null>(null)\n    snapshotRef.current = snapshot\n    const [failure, setFailure] = useState<string | null>(null)\n    const [pending, setPending] = useState(false)\n    const [status, setStatus] = useState('')\n\n    const dispatch = useCallback(\n        async (intent: Intent): Promise<DispatchOutcome> => {\n            try {\n                const response = await client.dispatch(intent)\n                return response.outcome === 'refusal'\n                    ? { kind: 'refused', refusal: response.refusal }\n                    : { kind: 'admitted', operation: response.receipt.operation }\n            } catch (error) {\n                return error instanceof DeliveryOutcomeUnknown ? { kind: 'unknown' } : { kind: 'failed' }\n            }\n        },\n        [client]\n    )\n\n    // v2 (C28): navigation is Rust-owned. The native menu, the sidebar and\n    // the palette all dispatch `navigate`; refusals reach the status surface.\n    const v2Navigate = useCallback(\n        async (feature: FeatureId) => {\n            useShellStore.getState().closePalette()\n            const intent: Intent = { kind: 'navigate', feature }\n            const outcome = await dispatch(intent)\n            if (outcome.kind === 'refused') useShellStore.getState().toast(SHELL_COPY.toastRefused('Navigation', outcome.refusal), 'warn')\n            // Unknown delivery is kept inline with Retry; never an expiring toast alone.\n            else if (outcome.kind === 'unknown') useShellStore.getState().addUnconfirmed('Navigation', intent)\n            else if (outcome.kind === 'failed') useShellStore.getState().toast(SHELL_COPY.toastFailed('Navigation'), 'warn')\n        },\n        [dispatch]\n    )\n    // Every v2 action's outcome reaches the shell's surfaces (DESIGN-V2 §7):\n    // a refusal or failed delivery as a warn toast naming what was asked, an\n    // unconfirmed delivery inline with Retry, never replayed on its own.\n    const v2Act = useCallback(\n        async (what: string, intent: Intent, quiet: Refusal[] = []): Promise<DispatchOutcome> => {\n            // A context-bound action speaks for the tenant it was sent in (I2).\n            const boundContext = deliveryContext(intent)\n            // A normal switch refusal still names its intended destination,\n            // but an uncertain switch must not offer Retry in another scope.\n            const retryContext = boundContext ?? (intent.kind === 'selectTenant' ? snapshotRef.current?.active?.context ?? null : null)\n            const bound = boundContext !== null ? (snapshotRef.current?.active?.tenant ?? null) : null\n            const outcome = await dispatch(intent)\n            if (outcome.kind === 'refused' && quiet.includes(outcome.refusal)) return outcome\n            if (outcome.kind === 'refused') useShellStore.getState().toast(SHELL_COPY.toastRefused(what, outcome.refusal, outcomeMessage(outcome)), 'warn', undefined, bound, boundContext)\n            else if (outcome.kind === 'unknown') useShellStore.getState().addUnconfirmed(what, intent, retryContext)\n            else if (outcome.kind === 'failed') useShellStore.getState().toast(SHELL_COPY.toastFailed(what), 'warn', undefined, bound, boundContext)\n            return outcome\n        },\n        [dispatch]\n    )\n    const v2Preference = useCallback(\n        async (what: string, intent: Intent, quiet: Refusal[] = []) => {\n            await v2Act(what, intent, quiet)\n        },\n        [v2Act]\n    )\n\n    const onMenu = useRef<(command: MenuCommand) => void>(() => undefined)\n    onMenu.current = (command: MenuCommand) => {\n        // Native navigation dismisses the modal palette first so focus can\n        // move to the new page heading instead of behind an open dialog.\n        if (command.kind === 'navigate') void v2Navigate(command.feature)\n        else if (command.kind === 'commandPalette') useShellStore.getState().openPalette()\n        // ⌘T: the tenant switcher opens; nothing switches until chosen.\n        else if (command.kind === 'tenantSwitcher') useShellStore.getState().setSwitcher(true)\n        // The open API Client request saves (its editor listens).\n        else if (command.kind === 'saveDocument') window.dispatchEvent(new Event(SAVE_DOCUMENT_EVENT))\n        else void v2Preference('The appearance change', { kind: 'setAppearance', theme: command.theme })\n    }\n\n    useEffect(() => {\n        let stop: (() => void) | undefined\n        let cancelled = false\n        client\n            .observeShell({\n                onSnapshot: (next) => {\n                    // The shell's scope follows the snapshot before it renders: a\n                    // notification for another tenant or context is never surfaced.\n                    useShellStore.getState().setScope(next.active?.tenant ?? null, next.active?.context ?? null, next.switchBlocked?.review ?? null)\n                    setSnapshot(next)\n                },\n                onMenu: (command) => onMenu.current(command),\n                onError: () => setFailure('The desktop sent an unexpected update.'),\n            })\n            .then(\n                (unsubscribe) => {\n                    if (cancelled) unsubscribe()\n                    else stop = unsubscribe\n                },\n                () => setFailure('The desktop shell could not be observed.')\n            )\n        return () => {\n            cancelled = true\n            stop?.()\n        }\n    }, [client])\n\n    // A completed reset also forgets Academy's WebView presentation state\n    // (completion latches keyed by account); a stopped reset keeps it.\n    const storage = snapshot?.storage\n    const resetFailed = Boolean(snapshot?.resetFailure)\n    const previousStorage = useRef(storage)\n    useEffect(() => {\n        if (previousStorage.current === 'resetting' && storage !== 'resetting' && !resetFailed) {\n            forgetAcademyPresentation()\n        }\n        previousStorage.current = storage\n    }, [storage, resetFailed])\n\n    const appearance = snapshot?.appearance\n    const colorTheme = snapshot?.colorTheme\n    // Apply the theme in the same commit as the snapshot, before paint, so\n    // the shell never shows a frame in the previous theme.\n    useLayoutEffect(() => (appearance ? followAppearance(appearance, colorTheme) : undefined), [appearance, colorTheme])\n\n    if (failure && !snapshot) {\n        return (\n            <main role='alert' className='text-academy-ink p-8'>\n                {failure}\n            </main>\n        )\n    }\n    if (!snapshot) {\n        return (\n            <main role='status' aria-live='polite' className='text-academy-ink-soft p-8'>\n                Starting Prisma AIRS Desktop…\n            </main>\n        )\n    }\n    if (snapshot.onboarding !== 'done') {\n        // First run: the wizard owns the window (D060: no alpha import; nothing leaves it before a tenant exists).\n        return (\n            <div data-v2-shell=''>\n                <Wizard\n                    snapshot={snapshot}\n                    dispatch={dispatch}\n                    observeManagement={(operation) => client.observeManagement(operation)}\n                    mode='firstRun'\n                    onClose={() => undefined}\n                    onNavigate={(feature) => void v2Navigate(feature)}\n                />\n            </div>\n        )\n    }\n    return (\n        <V2Shell\n            snapshot={snapshot}\n            appearancePending={pending}\n            status={failure ?? status}\n            onNavigate={(feature) => void v2Navigate(feature)}\n            onSetAppearance={(theme) => void v2Preference('The appearance change', { kind: 'setAppearance', theme })}\n            onSetShowCalls={(on) => void v2Preference('The preference change', { kind: 'setShowCalls', on })}\n            onSwitchTenant={(tenant, resolution) => {\n                // The target is captured now: a late refusal still names it. A\n                // pending-decision refusal is not a toast: the snapshot carries\n                // the guard the shell renders (I1).\n                const label = snapshot.tenants.find((t) => t.id === tenant)?.label ?? tenant\n                void v2Preference(SHELL_COPY.switchTo(label), { kind: 'selectTenant', tenant, resolution: resolution ?? null }, ['decisionPending'])\n            }}\n            onReadNow={() => {\n                // The palette's Read now is the same finite read of every chosen product (I4).\n                const active = snapshot.active\n                if (!active) return\n                const label = snapshot.tenants.find((t) => t.id === active.tenant)?.label ?? active.tenant\n                void v2Preference(SHELL_COPY.readOf(label), { kind: 'readTenant', context: active.context })\n            }}\n            onRetry={(what, intent) => void v2Preference(what, intent)}\n            onAct={v2Act}\n            dispatch={dispatch}\n            client={client}\n        />\n    )\n}\n    }\n\n    /// The operator's choice, else on until onboarding completes (C33).\n    fn show_calls(&self) -> bool {\n        self.data\n            .show_calls\n            .unwrap_or(self.shown_onboarding() != features::OnboardingState::Done)\n    }\n\n    /// The active destination: the last admitted `navigate` while it stays\n    /// in the current catalogue, else the presentation's first sidebar entry.\n    fn active_feature(&self) -> FeatureId {\n        self.active_feature\n            .filter(|f| features::catalogue().iter().any(|e| e.id == *f))\n            .unwrap_or_else(features::default_feature)\n    }\n\n    fn snapshot(&self) -> ShellSnapshot {\n        ShellSnapshot {\n            revision: self.revision.to_string(),\n            appearance: self.appearance(),\n            color_theme: self.color_theme(),\n            onboarding: self.shown_onboarding(),\n            active_feature: self.active_feature(),\n            show_calls: self.show_calls(),\n            calls: self\n                .data\n                .active\n                .as_ref()\n                .filter(|_| self.show_calls())\n                .map(|t| self.calls.for_tenant(t.as_str())),\n            switch_blocked: self.switch_blocked.clone(),\n            setup: self.setup_view(),\n            features: features::catalogue(),\n            fixture_build: cfg!(feature = \"test-fixtures\"),\n            storage: self.storage,\n            // An import's tenants show once it commits (D050).\n            tenants: self\n                .data\n                .tenants\n                .iter()\n                .map(|t| self.warning_recheck_view(tenant_view(t)))\n                .collect(),\n            active: match (&self.data.active, &self.active_ref) {\n                (Some(tenant), Some(context)) => Some(ActiveContext {\n                    tenant: tenant.clone(),\n            if !allowed {\n                return Err(Refusal::InvalidInput);\n            }\n            if current != next {\n                let before = state.data.clone();\n                state.data.onboarding = Some(next);\n                if state.storage == StorageHealth::Ready\n                    && let Err(e) = state.save_with(&before)\n                {\n                    return Err(e);\n                }\n                state.changed();\n            }\n        }\n        Intent::SetShowCalls { on } => {\n            // The operator's choice holds from now on, onboarding or not (C33).\n            if state.data.show_calls != Some(on) {\n                let before = state.data.clone();\n                state.data.show_calls = Some(on);\n                if state.storage == StorageHealth::Ready\n                    && let Err(e) = state.save_with(&before)\n                {\n                    return Err(e);\n                }\n                state.changed();\n            }\n        }\n        Intent::BeginTenantSetup { mode, profile } => {\n            state.require_storage()?;\n            let before = state.data.clone();\n            state.begin_setup(mode, profile)?;\n            state.save_with(&before)?;\n            state.changed();\n        }\n        Intent::UpdateTenantSetup { context, profile } => {\n            state.require_storage()?;\n    pub tenant: String,\n    pub purpose: CallPurpose,\n    pub credential: CallCredential,\n}\n\n/// One call as \"Show the calls\" shows it (C33): the request line without its\n/// query, header names (never values) and sizes, and the response status,\n/// duration and content type. Bodies are never kept: a response can carry\n/// an issued key or a token, and request bodies carry tenant content.\n#[derive(Clone, Debug, PartialEq, Eq, serde::Serialize, ts_rs::TS)]\n#[serde(rename_all = \"camelCase\")]\npub struct CallView {\n    /// Increasing per app run.\n    #[ts(type = \"number\")]\n    pub sequence: u64,\n    pub purpose: CallPurpose,\n    pub credential: CallCredential,\n    pub method: String,\n    /// `https://host[:port]`.\n    pub origin: String,\n    pub path: String,\n    /// The URL carried a query (withheld).\n    pub query: bool,\n    /// Request header names, sorted; the credential header is named but\n    /// its value is the core's alone.\n    pub request_headers: Vec<String>,\n    #[ts(type = \"number\")]\n    pub request_bytes: u64,\n    /// The response status; absent when the call failed before one.\n    pub status: Option<u16>,\n    /// Until the response head (or the failure).\n    #[ts(type = \"number\")]\n    pub duration_ms: u64,\n    pub content_type: Option<String>,\n    pub response_headers: Vec<String>,\n}\n\n/// Calls recorded for \"Show the calls\", newest last (C33): in memory only,\n/// the newest [`MAX_CALLS`] of the app run.\n#[derive(Clone, Default)]\npub struct CallLog(Arc<Mutex<CallRecords>>);\n\n#[derive(Default)]\nstruct CallRecords {\n    next: u64,\n    calls: VecDeque<(String, CallView)>,\n}\n\n/// Calls the log keeps (all tenants together).\npub const MAX_CALLS: usize = 200;\n/// Calls a tenant's view shows, newest last.\npub const MAX_SHOWN_CALLS: usize = 50;\n\nimpl CallLog {\n    fn record(&self, tenant: &str, call: impl FnOnce(u64) -> CallView) {\n        if let Ok(mut log) = self.0.lock() {\n            log.next += 1;\n            let view = call(log.next);\n            log.calls.push_back((tenant.to_owned(), view));\n            while log.calls.len() > MAX_CALLS {\n                log.calls.pop_front();\n            }\n        }\n    }\n\n    /// A tenant's newest calls, oldest first.\n    pub fn for_tenant(&self, tenant: &str) -> Vec<CallView> {\n        let Ok(log) = self.0.lock() else {\n            return Vec::new();\n        };\n        let mut shown: Vec<CallView> = log\n            .calls\n            .iter()\n            .rev()\n            .filter(|(t, _)| t == tenant)\n            .take(MAX_SHOWN_CALLS)\n            .map(|(_, c)| c.clone())\n            .collect();\n        shown.reverse();\n        shown\n    }\n\n    /// Forgets a tenant's calls (it was removed).\n    pub fn forget(&self, tenant: &str) {\n        if let Ok(mut log) = self.0.lock() {\n            log.calls.retain(|(t, _)| t != tenant);\n        .map(|start| chunk.slice(start..(start + MAX_CHUNK_BYTES).min(chunk.len())))\n        .collect()\n}\n\nimpl Transport for NativeTransport {\n    fn send<'a>(\n        &'a self,\n        request: TransportRequest,\n    ) -> BoxFuture<'a, scm_sdk::Result<TransportResponse>> {\n        Box::pin(async move {\n            let started = Instant::now();\n            // What may be recorded of the request: never a value of any header,\n            // never the query, never the body (C33).\n            let recorded = self.log.as_ref().and_then(|_| {\n                recorded_request(\n                    request.method(),\n                    request.url(),\n                    request.headers(),\n                    request.body().len() as u64,\n                )\n            });\n            let sent = self\n                .client\n                .request(request.method().clone(), request.url().clone())\n                .headers(request.headers().clone())\n                .body(request.body().clone())\n                .send()\n                .await;\n            if let (\n                Some((log, tag)),\n                Some((method, origin, path, query, request_headers, request_bytes)),\n            ) = (&self.log, recorded)\n            {\n                let (status, content_type, response_headers) = match &sent {\n                    Ok(r) => (\n                        Some(r.status().as_u16()),\n                        r.headers()\n                            .get(http::header::CONTENT_TYPE)\n                            .and_then(|v| v.to_str().ok())\n                            .map(|v| v.chars().take(CALL_CONTENT_TYPE_LIMIT).collect()),\n                        header_names(r.headers()),\n                    ),\n                    Err(_) => (None, None, Vec::new()),\n                };\n                let duration_ms = u64::try_from(started.elapsed().as_millis()).unwrap_or(u64::MAX);\n                log.record(&tag.tenant, |sequence| CallView {\n                    sequence,\n                    purpose: tag.purpose,\n                    credential: tag.credential,\n                    method,\n                    origin,\n                    path,\n                    query,\n                    request_headers,\n                    request_bytes,\n                    status,\n                    duration_ms,\n                    content_type,\n                    response_headers,\n                });\n            }\n            let response = sent.map_err(|_| transport_error())?;\n            let status = response.status();\n            let headers = response.headers().clone();\n            if !headers_within_limits(&headers) {\n                return Err(Error::new(ErrorKind::Limit));\n            }\n            let body = response\n                .bytes_stream()\n                .map(|chunk| match chunk {\n                    Ok(chunk) => {\n                        futures_util::stream::iter(bounded(chunk).into_iter().map(Ok)).left_stream()\n                    }\n                    Err(_) => {\n                        futures_util::stream::iter(vec![Err(transport_error())]).right_stream()\n                    }\n","exit_code":0,"status":"completed"}}
