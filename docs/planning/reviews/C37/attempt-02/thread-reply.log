        expect(native.dispatched.at(-1)).toEqual({ kind: 'snoozeItem', context: 'cx-aaaaaaaaaaaaaaaaaaaaaaaa', id: 'runtime-key:k1' })
        // An admitted recheck announces the product it rereads.
