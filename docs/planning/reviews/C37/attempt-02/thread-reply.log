        expect(within(tablist).getAllByRole('tab').map((t) => t.textContent)).toEqual(['All 4', 'Needs action 2', 'Updates 1', 'Snoozed 1'])
        expect(screen.getByRole('region', { name: 'Inbox list' })).toBeInTheDocument()
