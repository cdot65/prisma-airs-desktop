    48	def labelled(tree, roles, label):
    49	    return next((n for n in tree if n.get("role") in roles and (n.get("label") or "").strip() == label), None)
    50	
    51	
    52	def starts(tree, roles, prefix):
    53	    return next((n for n in tree if n.get("role") in roles and (n.get("label") or "").startswith(prefix)), None)
    54	
    55	
    56	def region(tree, label):
    57	    return next((n for n in tree if n.get("subrole") in ("AXLandmarkRegion", "AXLandmarkComplementary") and (n.get("label") or "") == label), None)
    58	
    59	
    60	def within(tree, node):
    61	    if not node:
    62	        return []
    63	    i = tree.index(node)
    64	    out = []
    65	    for m in tree[i + 1:]:
    66	        if m.get("depth", 0) <= node.get("depth", 0):
    67	            break
    68	        out.append(m)
    69	    return out
    70	
    71	
    72	def texts(nodes):
    73	    return " ".join((n.get("label") or n.get("value") or "") for n in nodes)
    74	
    75	
    76	def tab_node(tree, label):
    77	    return next((n for n in tree if n.get("role") in ("AXRadioButton", "AXTab", "AXButton") and (n.get("label") or "").startswith(label)), None)
    78	
    79	
    80	def rows_of(tree, list_node):
    81	    """The list's row buttons: every button in the list card that is not a tab."""
    82	    return [n for n in within(tree, list_node) if n.get("role") == "AXButton" and not (n.get("label") or "").split(" ")[0] in ("All", "Needs", "Updates", "Snoozed", "Open")]
    83	
    84	
    85	def size_window(app, pid, w, h):
    86	    fx.sh(["osascript", "-e", f'tell application "System Events" to tell (first application process whose unix id is {pid}) to set position of window 1 to {{0, 0}}'])
    87	    c28.set_window_size(pid, w, h + TITLE_BAR)
    88	    time.sleep(0.8)
    89	    return c29.window_frame(pid)
    90	
    91	
    92	def geometry_of(tree):
    93	    web = next((n for n in tree if n.get("role") == "AXWebArea" and n.get("size")), None)
    94	    scroll = next((n for n in tree if n.get("role") == "AXScrollArea" and n.get("size")), None)
    95	    return {"web": [int(web["size"][0]), int(web["size"][1])] if web else None,
    96	            "viewport": [int(scroll["size"][0]), int(scroll["size"][1])] if scroll else None}
    97	
