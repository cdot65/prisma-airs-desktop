   152	def exercise(app, endpoint, mgmt, prepared, FINAL):
   153	    global NATIVE
   154	    obs = {"captures": {}}
   155	    app.launch()
   156	    pid = app.pid
   157	    app.open_settings()
   158	    app.type_into("AXTextField", "TSG ID (optional)", c8.TSG)
   159	    app.create_custom_tenant("Northwind Health", endpoint.origin)
   160	    app.save_key(c8.SCAN_KEY)
   161	    c8.save_client(app)
   162	    c29.press(app, "AXCheckBox", "Use the new interface")
   163	    app.wait_for(lambda t: c29.nav(t, "Destinations") is not None, 15)
   164	    size_window(app, pid, 1440, 900)
   165	    app.menu("Go", "Inbox")
   166	    c29.heading(app, "Inbox")
   167	    c29.appearance(app, "Light")
   168	    time.sleep(0.6)
   169	
   170	    # ---- N01: the list card, the detail card, the empty states and the holds ------------
   171	    n1 = {}
   172	    tree = app.tree()
   173	    n1["heading"] = fx.App.node(tree, "AXHeading", "Inbox") is not None
   174	    n1["sub_before"] = texts([n for n in tree if n.get("subrole") == "AXApplicationStatus"] and within(tree, next(n for n in tree if n.get("subrole") == "AXApplicationStatus")))
   175	    n1["empty_before"] = "First read pending" in texts(tree)
   176	    obs["captures"]["inbox-empty"] = {"light": c29.capture(app, "inbox-empty-light")}
   177	    # The read lands; rows appear newest first.
   178	    c29.press(app, "AXButton", "Read now")
   179	    _, n1["read_landed"] = app.wait_for(lambda t: app.has_text(t, "sources read at") or app.has_text(t, "All sources read"), 40)
   180	    time.sleep(0.8)
   181	    tree = app.tree()
   182	    obs["tree_inbox"] = c29.save_tree("inbox", tree)
   183	    status = next((n for n in tree if n.get("subrole") == "AXApplicationStatus"), None)
   184	    n1["sub"] = texts(within(tree, status)) if status else ""
   185	    n1["sub_ok"] = "Everything that needs you in Northwind Health · newest first" in n1["sub"]
   186	    n1["tabs"] = {t: (tab_node(tree, t) or {}).get("label") for t in TABS}
   187	    n1["tabs_ok"] = all(n1["tabs"].values()) and all(re.search(r"\d+$", (l or "")) for l in n1["tabs"].values())
   188	    list_node = region(tree, "Inbox list")
   189	    n1["list_region"] = list_node is not None
   190	    rows = rows_of(tree, list_node)
   191	    n1["rows"] = [r.get("label") for r in rows]
   192	    n1["rows_ok"] = len(rows) >= 1
   193	    n1["severity_words"] = bool(rows) and all(any(w in (r.get("label") or "") for w in ("Critical", "Warning", "Info")) for r in rows)
   194	    foot = next(((n.get("label") or n.get("value") or "") for n in within(tree, list_node) if n.get("role") == "AXStaticText" and ("sources read at" in (n.get("label") or n.get("value") or "") or "No source reads" in (n.get("label") or n.get("value") or ""))), None)
   195	    n1["footer"] = foot
   196	    # Select the first row: the detail card fills.
   197	    app.ax("press", "AXButton", rows[0]["label"][:60]) if rows else None
   198	    time.sleep(0.6)
   199	    tree = app.tree()
   200	    detail = region(tree, "Details")
   201	    inside = within(tree, detail)
   202	    n1["detail_region"] = detail is not None
   203	    dtext = texts(inside)
   204	    title = (rows[0]["label"] or "").split("\n")[0] if rows else ""
   205	    n1["detail_title"] = any(n.get("role") == "AXHeading" and (n.get("label") or "") and (n.get("label") or "") in (rows[0]["label"] or "") for n in inside) if rows else False
   206	    n1["detail_severity"] = any(w in dtext for w in ("Critical", "Warning", "Info"))
   207	    facts = next((n for n in inside if (n.get("label") or "") == "Facts"), None)
   208	    n1["facts"] = facts is not None and len([n for n in within(tree, facts) if n.get("role") == "AXStaticText"]) >= 2
   209	    # Acknowledge carries aria-pressed (it toggles to "Mark as needing action"), so it exposes as a check box.
   210	    n1["detail_actions"] = {"Acknowledge": starts(inside, CONTROLS, "Acknowledge") is not None, "Snooze 24 hours": starts(inside, ("AXButton",), "Snooze 24 hours") is not None}
   211	    n1["detail_action_own"] = any(n.get("role") == "AXButton" and not (n.get("label") or "").startswith(("Acknowledge", "Snooze", "Unsnooze", "Mark as")) for n in inside)
   212	    obs["tree_detail"] = c29.save_tree("inbox-detail", tree)
   213	    obs["captures"]["inbox"] = {"light": c29.capture(app, "inbox-light")}
   214	    c29.appearance(app, "Dark")
   215	    obs["captures"]["inbox"]["dark"] = c29.capture(app, "inbox-dark")
   216	    c29.appearance(app, "Light")
   217	    # The C30 holds, from the detail card: snooze (the core's time in the row, the detail and the toast), unsnooze, acknowledge.
   218	    snooze = starts(inside, ("AXButton",), "Snooze 24 hours")
   219	    if snooze:
   220	        app.ax("press", "AXButton", snooze["label"])
   221	        tree, toasted = app.wait_for(lambda t: any("snoozed · returns" in x for x in app.texts(t)), 10)
   222	        toast_text = next((x for x in app.texts(tree) if "snoozed · returns" in x), "")
   223	        n1["snooze_toast"] = toasted
   224	        returns_toast = toast_text.split("returns ", 1)[1].rstrip("×").strip() if "returns " in toast_text else None
   225	        tab = tab_node(app.tree(), "Snoozed")
   226	        app.ax("press", tab["role"], tab["label"]) if tab else None
   227	        time.sleep(0.6)
   228	        tree = app.tree()
   229	        row = next((n for n in rows_of(tree, region(tree, "Inbox list")) if "Returns " in (n.get("label") or "")), None)
   230	        # The row's name ends with the entry's own time after the return wording: "Returns tomorrow 03:16 03:16".
   231	        row_returns = re.sub(r"\s+\d\d:\d\d$", "", row["label"].split("Returns ", 1)[1].strip()) if row and "Returns " in row["label"] else None
   232	        app.ax("press", "AXButton", row["label"][:60]) if row else None
   233	        time.sleep(0.5)
   234	        tree = app.tree()
   235	        pane_returns = next(((n.get("label") or "")[len("Returns "):] for n in within(tree, region(tree, "Details")) if n.get("role") == "AXStaticText" and (n.get("label") or "").startswith("Returns ")), None)
   236	        n1["snooze_times"] = {"toast": returns_toast, "row": row_returns, "pane": pane_returns}
   237	        n1["snooze_same"] = bool(returns_toast) and returns_toast == row_returns == pane_returns
   238	        c29.press(app, "AXButton", "Unsnooze")
   239	        _, n1["unsnoozed"] = app.wait_for(lambda t: starts(t, ("AXButton",), "Snooze 24 hours") is not None, 8)
   240	        tab = tab_node(app.tree(), "All")
   241	        app.ax("press", tab["role"], tab["label"]) if tab else None
   242	        time.sleep(0.5)
   243	        # Re-open the row in All (the detail follows the selected entry), then Acknowledge from the detail.
   244	        tree = app.tree()
   245	        back_row = next((n for n in rows_of(tree, region(tree, "Inbox list")) if title in (n.get("label") or "")), None)
   246	        app.ax("press", "AXButton", back_row["label"][:60]) if back_row else None
   247	        tree, has_ack = app.wait_for(lambda t: labelled(t, CONTROLS, "Acknowledge") is not None, 8)
   248	        obs["tree_before_ack"] = c29.save_tree("inbox-before-acknowledge", tree)
   249	        n1["ack_offered"] = has_ack
   250	        if has_ack:
   251	            ack = labelled(tree, CONTROLS, "Acknowledge")
   252	            app.ax("press", ack["role"], "Acknowledge")
   253	            tree, n1["acknowledged"] = app.wait_for(lambda t: app.has_text(t, "Acknowledged") and labelled(t, CONTROLS, "Mark as needing action") is not None, 8)
   254	            if n1["acknowledged"]:
   255	                mark = labelled(tree, CONTROLS, "Mark as needing action")
   256	                app.ax("press", mark["role"], "Mark as needing action")
   257	                _, n1["unmarked"] = app.wait_for(lambda t: labelled(t, CONTROLS, "Acknowledge") is not None, 8)
   258	    obs["n1"] = n1
   259	
   260	    # ---- N02: keyboard, ring, Enter on a row, layouts ------------------------------------
   261	    n2 = {}
   262	    # From Read now (the heading's Tab did not move focus in the fixture): the tabs, the rows, the detail's actions.
   263	    app.ax("focus", "AXButton", "Read now")
   264	    time.sleep(0.3)
   265	    walk = [(((f or {}).get("label")) or "")[:44] for f in app.tab_walk(14)]
   266	    n2["walk"] = walk
   267	    order = []
   268	    for key in ("All", rows[0]["label"][:12] if rows else "", "Acknowledge"):
   269	        idx = next((i for i, l in enumerate(walk) if key and l.startswith(key)), None)
   270	        order.append((key, idx))
   271	    n2["order"] = order
   272	    n2["reach_in_order"] = all(i is not None for _, i in order) and [i for _, i in order] == sorted(i for _, i in order)
   273	    plain = c29.capture(app, "row-ring-plain")
   274	    n2["ring"] = c31.ring_on(app, rows[0]["label"], plain, "row-ring") if rows else {"diff": 0}
   275	    ring_ok = (n2["ring"].get("diff") or 0) > 40
   276	    if rows:
   277	        app.ax("focus", "AXButton", rows[0]["label"][:60])
   278	        time.sleep(0.3)
   279	        app.keycode(36)
   280	        _, n2["enter_opens"] = app.wait_for(lambda t: region(t, "Details") is not None and any(n.get("role") == "AXHeading" and (n.get("label") or "") in (rows[0]["label"] or "") for n in within(t, region(t, "Details"))), 8)
   281	    layouts = {}
   282	    size_window(app, pid, 1440, 900)
   283	    for theme in ("Light", "Dark"):
   284	        c29.appearance(app, theme)
   285	        o, tree = overflow(app)
   286	        g = geometry_of(tree)
   287	        o["geometry"] = g
   288	        o["width_1440"] = bool(g["web"] and g["web"][0] == 1440)
   289	        name = f"inbox-{g['web'][0]}x{g['web'][1]}-{theme.lower()}"
   290	        o["capture"] = c29.capture(app, name)
   291	        o["tree"] = c29.save_tree(name, tree)
   292	        layouts[name] = o
   293	    size_window(app, pid, 900, 600)
   294	    c29.zoom(app, 10)
   295	    for theme in ("Light", "Dark"):
   296	        c29.appearance(app, theme)
   297	        o, tree = overflow(app)
   298	        g = geometry_of(tree)
   299	        vp = g["viewport"] or g["web"]
   300	        o["geometry"] = g
   301	        o["window_900x600"] = bool(vp and vp[0] == 900 and vp[1] == 600)
   302	        name = f"inbox-{vp[0]}x{vp[1]}-200-{theme.lower()}"
   303	        o["capture"] = c29.capture(app, name)
   304	        o["tree"] = c29.save_tree(name, tree)
   305	        layouts[name] = o
   306	    c29.zoom(app, -10)
   307	    c29.appearance(app, "Match System")
   308	    size_window(app, pid, 1440, 900)
   309	    n2["layouts"] = layouts
   310	    obs["captures"]["layouts"] = {k: v["capture"] for k, v in layouts.items()}
   311	    obs["n2"] = n2
   312	    app.quit()
   313	
   314	    run_path = os.path.join(NATIVE, "observations.json")
   315	    with open(run_path, "w") as f:
   316	        json.dump(json.loads(json.dumps({"observations": obs, "log": LOG}).replace(rel(NATIVE), rel(FINAL))), f, indent=1)
   317	    run_rel = rel(run_path)
   318	    inventory = {c["id"]: c["check"] for c in json.load(open(os.path.join(ROOT, "docs/architecture/native-checks.json")))["chunks"]["C37"]}
   319	    checks = []
