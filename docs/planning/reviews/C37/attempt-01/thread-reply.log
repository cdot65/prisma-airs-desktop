    99	def overflow(app):
   100	    tree = app.tree()
   101	    win = next((n for n in tree if n.get("role") == "AXWindow"), None)
   102	    nodes = [n for n in tree if n.get("pos") and n.get("size") and n["size"][0] > 0
   103	             and n.get("role") in ("AXButton", "AXStaticText", "AXTextField", "AXSearchField", "AXCheckBox", "AXPopUpButton", "AXLink", "AXHeading", "AXRadioButton")]
   104	    right = max(n["pos"][0] + n["size"][0] for n in nodes) if nodes and win else None
   105	    hbars = [n for n in tree if n.get("role") == "AXScrollBar" and (n.get("orientation") == "horizontal" or (n.get("size") and n["size"][0] > n["size"][1]))]
   106	    return {"overflow_px": max(0, right - (win["pos"][0] + win["size"][0])) if right is not None else None, "horizontal_scrollbars": len(hbars)}, tree
