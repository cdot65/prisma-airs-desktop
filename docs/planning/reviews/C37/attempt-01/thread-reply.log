   322	        checks.append({"id": cid, "description": inventory[cid], "result": "pass" if passed else "fail", "observation": observation, "evidence": [e for e in evidence if e]})
   323	
   324	    caps = lambda name: [v for v in obs["captures"].get(name, {}).values() if v]  # noqa: E731
   325	    holds_ok = n1.get("snooze_toast") and n1.get("snooze_same") and n1.get("unsnoozed") and n1.get("acknowledged") and n1.get("unmarked")
   326	    n1_ok = (n1["heading"] and n1["empty_before"] and n1.get("read_landed") and n1["sub_ok"] and n1["tabs_ok"] and n1["list_region"] and n1["rows_ok"] and n1["severity_words"]
   327	             and bool(n1["footer"]) and n1["detail_region"] and n1["detail_title"] and n1["detail_severity"] and n1["facts"] and all(n1["detail_actions"].values()) and n1["detail_action_own"] and holds_ok)
   328	    add("C37-N01", n1_ok,
   329	        f"heading {n1['heading']}; empty state before any read named it {n1['empty_before']}; Read now landed {n1.get('read_landed')}; line '{n1['sub']}' ({n1['sub_ok']}); tabs {n1['tabs']} ({n1['tabs_ok']}); rows {n1['rows']} with severity words {n1['severity_words']}; footer '{n1['footer']}'; detail: title {n1['detail_title']}, severity {n1['detail_severity']}, facts grid {n1['facts']}, own action {n1['detail_action_own']}, actions {n1['detail_actions']}; holds: snooze toast {n1.get('snooze_toast')} times {n1.get('snooze_times')} same {n1.get('snooze_same')}, unsnoozed {n1.get('unsnoozed')}, acknowledged {n1.get('acknowledged')}, unmarked {n1.get('unmarked')}",
   330	        [run_rel, obs["tree_inbox"], obs["tree_detail"]] + caps("inbox-empty") + caps("inbox"))
