   117	def run():
   118	    global NATIVE
   119	    prepared = json.load(open(os.path.join(EVIDENCE, "native-prepare.json")))
   120	    bundle = os.path.join(ROOT, prepared["bundle"])
   121	    exe = os.path.join(bundle, "Contents/MacOS/prisma-airs-desktop-v2")
   122	    if c8.sha256(exe) != prepared["executable_sha256"]:
   123	        raise SystemExit("prepared executable changed since native-prepare")
   124	    work = tempfile.mkdtemp(prefix="airs-v2-c37-acceptance-")
   125	    FINAL = NATIVE
   126	    NATIVE = NATIVE + ".staging"
   127	    if os.path.isdir(NATIVE):
   128	        shutil.rmtree(NATIVE)
   129	    os.makedirs(NATIVE)
   130	    c29.NATIVE = NATIVE
   131	    if os.path.isdir(c29.CAPTURES):
   132	        shutil.rmtree(c29.CAPTURES)
   133	    app = fx.App(bundle, work, LOG)
   134	    c29._APP = app
   135	    app.quit()
   136	    fx.clean_fixture_root()
   137	    endpoint = fx.ScanEndpoint(os.path.join(work, "endpoint"), c8.SCAN_KEY)
   138	    endpoint.install_roots()
   139	    endpoint.start()
   140	    mgmt = c8.MgmtEndpoint(os.path.join(work, "endpoint"), os.path.join(work, "mgmt"))
   141	    mgmt.install()
   142	    mgmt.start()
   143	    mgmt.mode()
   144	    try:
   145	        return exercise(app, endpoint, mgmt, prepared, FINAL)
   146	    finally:
   147	        endpoint.stop()
   148	        mgmt.stop()
   149	        shutil.rmtree(work, ignore_errors=True)
