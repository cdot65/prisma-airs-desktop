+    assert!(!state.contains(SECRET));
+    // Nor the snapshot the presentation sees.
+    assert!(!desk.json().to_string().contains(SECRET));
+    let events = desk.json()["diagnostics"]["events"]
+        .as_u64()
+        .expect("count");
+    assert!(events >= 7, "{events}");
+}
