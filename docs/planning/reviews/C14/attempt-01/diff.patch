@@ -0,0 +1,876 @@
+//! Request documents (C14). The presentation owns the editor text; Rust
+//! owns what was read from disk (the baseline), the revision that names it
+//! and whether a captured snapshot can be written faithfully. A request's
+//! metadata is edited through `toml_edit`, so comments, row decoration,
+//! extension keys and CRLF line endings survive a Save (v1).
+
+use std::collections::BTreeMap;
+use std::io::Read;
+use std::path::Path;
+
+use serde::{Deserialize, Serialize};
+use sha2::{Digest, Sha256};
+use toml_edit::{ArrayOfTables, DocumentMut, Item, Table, Value};
+use ts_rs::TS;
+
+use super::project::{self, ProjectProblem, REQUEST_SUFFIX};
+
+/// Body text the editor holds (larger or non-text bodies are kept as they
+/// are and cannot be edited here).
+pub const BODY_BYTES: usize = 4 * 1024 * 1024;
+pub const URL_CHARS: usize = 8_192;
+pub const METHOD_CHARS: usize = 32;
+pub const BODY_KINDS: [&str; 5] = ["text", "json", "form", "multipart", "file"];
+/// Built-in methods (others: letters and `-` only, as v1's custom method).
+pub const METHODS: [&str; 7] = ["GET", "POST", "PUT", "PATCH", "DELETE", "HEAD", "OPTIONS"];
+
+/// The editable snapshot of a request, exactly as the editor holds it.
+#[derive(Clone, Debug, PartialEq, Eq, Serialize, Deserialize, TS)]
+#[serde(rename_all = "camelCase", deny_unknown_fields)]
+pub struct Fields {
+    pub method: String,
+    pub url: String,
+    /// One `Name: value` row per line; `# ` disables a row.
+    pub headers: String,
+    /// One `name=value` row per line; `# ` disables a row.
+    pub query: String,
+    pub body: String,
+    pub body_kind: String,
+    /// `[auth]` and `[variables]` TOML; values are references, never
+    /// credentials.
+    pub settings: String,
+}
+
+impl Default for Fields {
+    fn default() -> Self {
+        Self {
+            method: "GET".into(),
+            url: "https://example.com/".into(),
+            headers: String::new(),
+            query: String::new(),
+            body: String::new(),
+            body_kind: "text".into(),
+            settings: String::new(),
+        }
+    }
+}
+
+/// Which part of a snapshot cannot be written faithfully.
+#[derive(Clone, Copy, Debug, PartialEq, Eq, Serialize, TS)]
+#[serde(rename_all = "camelCase")]
+pub enum FieldName {
+    Method,
+    Url,
+    Headers,
+    Query,
+    Body,
+    BodyKind,
+    Settings,
+}
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq, Serialize, TS)]
+#[serde(rename_all = "camelCase")]
+pub struct FieldProblem {
+    pub field: FieldName,
+    /// The 1-based row, for row fields.
+    pub line: Option<u32>,
+}
+
+impl FieldProblem {
+    fn at(field: FieldName, line: Option<usize>) -> Self {
+        Self {
+            field,
+            line: line.map(|l| u32::try_from(l + 1).unwrap_or(u32::MAX)),
+        }
+    }
+}
+
+/// One parsed row of a rows field.
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct Row {
+    pub name: String,
+    pub value: String,
+    pub enabled: bool,
+}
+
+/// `Name: value` rows (blank lines skipped).
+pub fn header_rows(text: &str) -> Result<Vec<Row>, FieldProblem> {
+    rows(text, ':', FieldName::Headers, true)
+}
+
+/// `name=value` rows (blank lines skipped; values kept verbatim).
+pub fn query_rows(text: &str) -> Result<Vec<Row>, FieldProblem> {
+    rows(text, '=', FieldName::Query, false)
+}
+
+fn rows(text: &str, split: char, field: FieldName, trim: bool) -> Result<Vec<Row>, FieldProblem> {
+    text.lines()
+        .enumerate()
+        .filter(|(_, l)| !l.trim().is_empty())
+        .map(|(i, line)| {
+            let (enabled, line) = match line.strip_prefix("# ") {
+                Some(rest) => (false, rest),
+                None => (true, line),
+            };
+            let (name, value) = line
+                .split_once(split)
+                .ok_or(FieldProblem::at(field, Some(i)))?;
+            let name = name.trim();
+            if name.is_empty() || name.starts_with("# ") || name.contains(['\r', '=']) {
+                return Err(FieldProblem::at(field, Some(i)));
+            }
+            Ok(Row {
+                name: name.to_owned(),
+                value: if trim { value.trim() } else { value }.to_owned(),
+                enabled,
+            })
+        })
+        .collect()
+}
+
+pub(crate) fn valid_reference(value: &str) -> bool {
+    !value.is_empty()
+        && value.len() <= 128
+        && value
+            .bytes()
+            .all(|b| b.is_ascii_alphanumeric() || b"-_.".contains(&b))
+}
+
+pub(crate) fn valid_variable(name: &str) -> bool {
+    !name.is_empty()
+        && name.len() <= 128
+        && name
+            .bytes()
+            .all(|b| b.is_ascii_alphanumeric() || b"_.-".contains(&b))
+}
+
+/// `[variables]`: strings or `{secret = "reference"}` only.
+pub(crate) fn variables_ok(doc: &DocumentMut) -> bool {
+    let Some(variables) = doc.get("variables") else {
+        return true;
+    };
+    let Some(table) = variables.as_table_like() else {
+        return false;
+    };
+    table.iter().all(|(name, value)| {
+        valid_variable(name)
+            && (value.is_str()
+                || (value.as_table_like().is_some_and(|t| t.len() == 1)
+                    && value
+                        .get("secret")
+                        .and_then(Item::as_str)
+                        .is_some_and(valid_reference)))
+    })
+}
+
+const AUTH_KEYS: [&str; 9] = [
+    "kind",
+    "secret",
+    "username",
+    "name",
+    "location",
+    "token_url",
+    "client_id",
+    "client_secret",
+    "scope",
+];
+pub const AUTH_KINDS: [&str; 5] = ["none", "basic", "bearer", "api-key", "oauth2"];
+
+/// Request settings: only `[auth]` (named references, never inline
+/// credentials) and `[variables]`.
+pub fn settings_ok(text: &str) -> Option<DocumentMut> {
+    let doc: DocumentMut = text.parse().ok()?;
+    if !doc.iter().all(|(k, _)| matches!(k, "auth" | "variables")) || !variables_ok(&doc) {
+        return None;
+    }
+    if let Some(auth) = doc.get("auth") {
+        let table = auth.as_table_like()?;
+        if !table
+            .iter()
+            .all(|(k, v)| AUTH_KEYS.contains(&k) && v.is_str())
+        {
+            return None;
+        }
+        if let Some(kind) = auth.get("kind").and_then(Item::as_str)
+            && !AUTH_KINDS.contains(&kind)
+        {
+            return None;
+        }
+        if let Some(secret) = auth.get("secret").and_then(Item::as_str)
+            && !valid_reference(secret)
+        {
+            return None;
+        }
+    }
+    Some(doc)
+}
+
+fn method_ok(method: &str) -> bool {
+    !method.is_empty()
+        && method.len() <= METHOD_CHARS
+        && method.bytes().all(|b| b.is_ascii_alphabetic() || b == b'-')
+}
+
+/// Whether `fields` can be written faithfully (the first problem if not).
+/// Malformed JSON in a JSON body is kept as typed (v1: a warning).
+pub fn check(fields: &Fields) -> Result<(), FieldProblem> {
+    if !method_ok(&fields.method) {
+        return Err(FieldProblem::at(FieldName::Method, None));
+    }
+    if fields.url.trim().is_empty()
+        || fields.url.chars().count() > URL_CHARS
+        || fields.url.contains(['\r', '\n'])
+    {
+        return Err(FieldProblem::at(FieldName::Url, None));
+    }
+    header_rows(&fields.headers)?;
+    query_rows(&fields.query)?;
+    if !BODY_KINDS.contains(&fields.body_kind.as_str()) {
+        return Err(FieldProblem::at(FieldName::BodyKind, None));
+    }
+    if fields.body.len() > BODY_BYTES {
+        return Err(FieldProblem::at(FieldName::Body, None));
+    }
+    if fields.body_kind == "multipart" && !fields.body.is_empty() && !multipart_ok(&fields.body) {
+        return Err(FieldProblem::at(FieldName::Body, None));
+    }
+    if !fields.settings.trim().is_empty() && settings_ok(&fields.settings).is_none() {
+        return Err(FieldProblem::at(FieldName::Settings, None));
+    }
+    Ok(())
+}
+
+/// v1's multipart body: `[[parts]]` rows with `name` and exactly one of
+/// `value` or `file` (collection-relative), optional `mime`.
+fn multipart_ok(text: &str) -> bool {
+    let Ok(doc) = text.parse::<DocumentMut>() else {
+        return false;
+    };
+    if !doc.iter().all(|(k, _)| k == "parts") {
+        return false;
+    }
+    let Some(parts) = doc.get("parts").and_then(Item::as_array_of_tables) else {
+        return false;
+    };
+    parts.iter().all(|row| {
+        row.iter()
+            .all(|(k, v)| matches!(k, "name" | "value" | "file" | "mime") && v.is_str())
+            && row.get("name").and_then(Item::as_str).is_some()
+            && (row.contains_key("value") != row.contains_key("file"))
+            && row
+                .get("file")
+                .and_then(Item::as_str)
+                .is_none_or(|f| project::relative_path(f, false).is_some())
+    })
+}
+
+/// A file's content hash (`None` when absent), streamed without a limit.
+pub fn hash_file(root: &Path, relative: &str) -> Result<Option<String>, ProjectProblem> {
+    let rel = project::relative_path(relative, false).ok_or(ProjectProblem::BadPath)?;
+    let path = project::destination(root, &rel)?;
+    let mut file = match std::fs::symlink_metadata(&path) {
+        Err(e) if e.kind() == std::io::ErrorKind::NotFound => return Ok(None),
+        Err(_) => return Err(ProjectProblem::Io),
+        Ok(m) if !m.is_file() => return Err(ProjectProblem::Io),
+        Ok(_) => std::fs::File::open(&path).map_err(|_| ProjectProblem::Io)?,
+    };
+    let mut hash = Sha256::new();
+    let mut buffer = vec![0u8; 64 * 1024];
+    loop {
+        let n = file.read(&mut buffer).map_err(|_| ProjectProblem::Io)?;
+        if n == 0 {
+            break;
+        }
+        hash.update(&buffer[..n]);
+    }
+    Ok(Some(hex::encode(hash.finalize())))
+}
+
+pub(crate) fn hash_bytes(bytes: &[u8]) -> String {
+    hex::encode(Sha256::digest(bytes))
+}
+
+/// What a document was read from: each file's hash (`None`: absent).
+pub type Baseline = BTreeMap<String, Option<String>>;
+
+/// The revision naming a baseline.
+pub fn revision(baseline: &Baseline) -> String {
+    let mut hash = Sha256::new();
+    for (path, digest) in baseline {
+        hash.update(path.as_bytes());
+        hash.update([0]);
+        match digest {
+            Some(d) => {
+                hash.update([1]);
+                hash.update(d.as_bytes());
+            }
+            None => hash.update([0]),
+        }
+    }
+    hex::encode(&hash.finalize()[..16])
+}
+
+/// A request document held by Rust.
+#[derive(Clone, Debug, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(rename_all = "camelCase")]
+pub struct Document {
+    pub id: String,
+    pub relative: String,
+    /// The metadata text at the baseline (or as created).
+    pub syntax: String,
+    pub baseline: Baseline,
+    pub saved: Fields,
+    /// Never written yet.
+    pub new: bool,
+    /// The body is text within the editor limit.
+    pub body_editable: bool,
+    /// A changed reference (independent body copy) still to be saved.
+    pub metadata_dirty: bool,
+}
+
+/// Why a document could not be opened.
+pub fn open(root: &Path, entry: &project::RequestEntry) -> Result<Document, ProjectProblem> {
+    let rel = project::relative_path(&entry.relative, false).ok_or(ProjectProblem::BadPath)?;
+    let bytes = project::read_optional(root, &rel, project::METADATA_BYTES)?
+        .ok_or(ProjectProblem::Missing)?;
+    let syntax = String::from_utf8(bytes.clone()).map_err(|_| ProjectProblem::Missing)?;
+    let doc: DocumentMut = syntax.parse().map_err(|_| ProjectProblem::Missing)?;
+    let mut baseline = Baseline::from([(entry.relative.clone(), Some(hash_bytes(&bytes)))]);
+    let mut body = String::new();
+    let mut body_editable = true;
+    if let Some(reference) = doc.get("body").and_then(Item::as_str) {
+        let digest = hash_file(root, reference)?;
+        let rel = project::relative_path(reference, false).ok_or(ProjectProblem::BadPath)?;
+        match project::read_optional(root, &rel, BODY_BYTES) {
+            Ok(Some(bytes)) => match String::from_utf8(bytes) {
+                Ok(text) => body = text,
+                Err(_) => body_editable = false,
+            },
+            Err(ProjectProblem::TooLarge) => body_editable = false,
+            Ok(None) => return Err(ProjectProblem::Missing),
+            Err(e) => return Err(e),
+        }
+        baseline.insert(reference.to_owned(), digest);
+    }
+    let saved = Fields {
+        method: entry.method.clone(),
+        url: entry.url.clone(),
+        headers: rows_from(&doc, "headers", ": ").ok_or(ProjectProblem::Missing)?,
+        query: rows_from(&doc, "query", "=").ok_or(ProjectProblem::Missing)?,
+        body,
+        body_kind: doc
+            .get("body_kind")
+            .and_then(Item::as_str)
+            .unwrap_or("text")
+            .to_owned(),
+        settings: settings_from(&doc),
+    };
+    Ok(Document {
+        id: entry.id.clone(),
+        relative: entry.relative.clone(),
+        syntax,
+        baseline,
+        saved,
+        new: false,
+        body_editable,
+        metadata_dirty: false,
+    })
+}
+
+fn rows_from(doc: &DocumentMut, key: &str, join: &str) -> Option<String> {
+    let Some(item) = doc.get(key) else {
+        return Some(String::new());
+    };
+    let rows = item.as_array_of_tables()?;
+    let mut lines = Vec::new();
+    for row in rows {
+        let name = row.get("name").and_then(Item::as_str)?;
+        let value = row.get("value").and_then(Item::as_str)?;
+        let enabled = match row.get("enabled") {
+            Some(v) => v.as_bool()?,
+            None => true,
+        };
+        if name.contains(['\r', '\n']) || value.contains(['\r', '\n']) || name.starts_with("# ") {
+            return None;
+        }
+        if join == "=" && name.contains('=') {
+            return None;
+        }
+        lines.push(format!(
+            "{}{name}{join}{value}",
+            if enabled { "" } else { "# " }
+        ));
+    }
+    Some(lines.join("\n"))
+}
+
+fn settings_from(doc: &DocumentMut) -> String {
+    let mut settings = DocumentMut::new();
+    for key in ["auth", "variables"] {
+        if let Some(item) = doc.get(key) {
+            settings[key] = item.clone();
+        }
+    }
+    settings.to_string()
+}
+
+fn field_value(doc: &mut DocumentMut, name: &str, value: &str) {
+    if doc.get(name).and_then(Item::as_str) == Some(value) {
+        return;
+    }
+    let mut replacement = Value::from(value);
+    if let Some(old) = doc.get(name).and_then(Item::as_value) {
+        *replacement.decor_mut() = old.decor().clone();
+    }
+    doc[name] = Item::Value(replacement);
+}
+
+/// Rewrites a rows array, keeping each surviving row's decoration and
+/// extension keys (exact matches first, then by name).
+fn edit_rows(doc: &mut DocumentMut, key: &str, rows: Vec<Row>) {
+    let old = doc.get(key).and_then(Item::as_array_of_tables).cloned();
+    let mut used = std::collections::BTreeSet::new();
+    let mut out = ArrayOfTables::new();
+    for row in rows {
+        let find = |exact: bool, used: &std::collections::BTreeSet<usize>| {
+            old.as_ref().and_then(|rows| {
+                rows.iter()
+                    .enumerate()
+                    .find(|(i, r)| {
+                        !used.contains(i)
+                            && r.get("name").and_then(Item::as_str) == Some(row.name.as_str())
+                            && (!exact
+                                || (r.get("value").and_then(Item::as_str)
+                                    == Some(row.value.as_str())
+                                    && r.get("enabled").and_then(Item::as_bool).unwrap_or(true)
+                                        == row.enabled))
+                    })
+                    .map(|(i, _)| i)
+            })
+        };
+        let matched = find(true, &used).or_else(|| find(false, &used));
+        let mut table = matched
+            .and_then(|i| {
+                used.insert(i);
+                old.as_ref().and_then(|rows| rows.get(i)).cloned()
+            })
+            .unwrap_or_else(Table::new);
+        for (k, v) in [("name", row.name), ("value", row.value)] {
+            let decor = table
+                .get(k)
+                .and_then(Item::as_value)
+                .map(|v| v.decor().clone());
+            let mut value = Value::from(v);
+            if let Some(decor) = decor {
+                *value.decor_mut() = decor;
+            }
+            table[k] = Item::Value(value);
+        }
+        if !row.enabled || table.contains_key("enabled") {
+            table["enabled"] = toml_edit::value(row.enabled);
+        }
+        table.set_position(None);
+        out.push(table);
+    }
+    if out.is_empty() {
+        doc.remove(key);
+    } else {
+        doc[key] = Item::ArrayOfTables(out);
+    }
+}
+
+impl Document {
+    pub fn revision(&self) -> String {
+        revision(&self.baseline)
+    }
+
+    /// The body sidecar this document writes, if any.
+    pub fn body_reference(&self) -> Option<String> {
+        self.syntax
+            .parse::<DocumentMut>()
+            .ok()?
+            .get("body")
+            .and_then(Item::as_str)
+            .map(str::to_owned)
+    }
+
+    pub fn schema(&self) -> Option<String> {
+        self.syntax
+            .parse::<DocumentMut>()
+            .ok()?
+            .get("schema")
+            .and_then(Item::as_str)
+            .map(str::to_owned)
+    }
+
+    pub fn dirty(&self, fields: &Fields) -> bool {
+        self.new || self.metadata_dirty || fields != &self.saved
+    }
+
+    /// The metadata text `fields` saves as (call after `check`).
+    pub fn edited_syntax(&self, fields: &Fields) -> Option<String> {
+        let mut doc: DocumentMut = self.syntax.parse().ok()?;
+        field_value(&mut doc, "method", &fields.method);
+        field_value(&mut doc, "url", &fields.url);
+        if fields.body_kind != self.saved.body_kind || (self.new && fields.body_kind != "text") {
+            field_value(&mut doc, "body_kind", &fields.body_kind);
+        }
+        if fields.headers != self.saved.headers {
+            edit_rows(&mut doc, "headers", header_rows(&fields.headers).ok()?);
+        }
+        if fields.query != self.saved.query {
+            edit_rows(&mut doc, "query", query_rows(&fields.query).ok()?);
+        }
+        if fields.settings != self.saved.settings {
+            let mut settings = if fields.settings.trim().is_empty() {
+                DocumentMut::new()
+            } else {
+                settings_ok(&fields.settings)?
+            };
+            for key in ["auth", "variables"] {
+                match settings.remove(key) {
+                    Some(item) => doc[key] = item,
+                    None => {
+                        doc.remove(key);
+                    }
+                }
+            }
+        }
+        let text = doc.to_string();
+        Some(if self.syntax.contains("\r\n") {
+            text.replace("\r\n", "\n").replace('\n', "\r\n")
+        } else {
+            text
+        })
+    }
+
+    /// Sets (or clears) the schema association; the schema file itself is
+    /// separately owned and never rewritten by a request Save.
+    pub fn associate_schema(&mut self, schema: Option<&str>) -> bool {
+        let Ok(mut doc) = self.syntax.parse::<DocumentMut>() else {
+            return false;
+        };
+        match schema {
+            Some(s) => field_value(&mut doc, "schema", s),
+            None => {
+                doc.remove("schema");
+            }
+        }
+        let edited = doc.to_string();
+        if edited != self.syntax {
+            self.syntax = edited;
+            self.metadata_dirty = true;
+        }
+        true
+    }
+}
+
+/// A new, unsaved request at `relative` (a `.request.toml` path) with an
+/// independent body sidecar beside it.
+pub fn create(relative: &str) -> Result<Document, ProjectProblem> {
+    if !relative.ends_with(REQUEST_SUFFIX) || project::relative_path(relative, true).is_none() {
+        return Err(ProjectProblem::BadPath);
+    }
+    let id = project::new_id().ok_or(ProjectProblem::Io)?;
+    let body = format!("{}.body.txt", relative.trim_end_matches(REQUEST_SUFFIX));
+    let mut doc = DocumentMut::new();
+    doc["format_version"] = toml_edit::value(1);
+    doc["id"] = toml_edit::value(id.as_str());
+    doc["method"] = toml_edit::value("GET");
+    doc["url"] = toml_edit::value("https://example.com/");
+    doc["body"] = toml_edit::value(body.as_str());
+    Ok(Document {
+        id,
+        relative: relative.to_owned(),
+        syntax: doc.to_string(),
+        baseline: Baseline::from([(relative.to_owned(), None), (body, None)]),
+        saved: Fields::default(),
+        new: true,
+        body_editable: true,
+        metadata_dirty: false,
+    })
+}
+
+/// Why a Save did not write.
+#[derive(Clone, Copy, Debug, PartialEq, Eq, Serialize, TS)]
+#[serde(tag = "kind", rename_all = "camelCase")]
+pub enum SaveRefusal {
+    /// The snapshot cannot be written faithfully ("Fix to save").
+    Invalid { problem: FieldProblem },
+    /// The files changed on disk since the baseline.
+    Conflict,
+    /// The collection changed or its inventory is incomplete.
+    Incomplete,
+    /// The request's identity moved to another file.
+    Moved,
+    /// Another request now uses this body file.
+    SharedBody,
+    /// An earlier save of this request was interrupted.
+    Interrupted,
+    /// Something already exists at a new request's path.
+    Exists,
+    /// The files could not be written.
+    Io,
+}
+
+/// One planned file change of a Save.
+#[derive(Clone, Debug, PartialEq, Eq, Serialize, Deserialize)]
+pub struct Change {
+    pub relative: String,
+    pub before: Option<String>,
+    pub after: String,
+    #[serde(skip)]
+    pub bytes: Vec<u8>,
+}
+
+/// Whether the files on disk still equal the baseline (and no other body
+/// reference appeared in the metadata).
+pub fn unchanged_on_disk(root: &Path, document: &Document) -> Result<bool, ProjectProblem> {
+    for (path, digest) in &document.baseline {
+        if &hash_file(root, path)? != digest {
+            return Ok(false);
+        }
+    }
+    if !document.new
+        && let Some(bytes) = project::read_optional(
+            root,
+            &project::relative_path(&document.relative, false).ok_or(ProjectProblem::BadPath)?,
+            project::METADATA_BYTES,
+        )?
+        && let Some(reference) = project::parse_metadata(&bytes)
+            .and_then(|d| d.get("body").and_then(Item::as_str).map(str::to_owned))
+        && !document.baseline.contains_key(&reference)
+    {
+        return Ok(false);
+    }
+    Ok(true)
+}
+
+/// Plans a Save of `fields`: the refusal, or the file changes (body first,
+/// metadata last). Read-only.
+pub fn plan(
+    root: &Path,
+    catalog: &project::Catalog,
+    collection: &str,
+    document: &Document,
+    fields: &Fields,
+) -> Result<Vec<Change>, SaveRefusal> {
+    check(fields).map_err(|problem| SaveRefusal::Invalid { problem })?;
+    if !catalog.complete || catalog.id != collection {
+        return Err(SaveRefusal::Incomplete);
+    }
+    if catalog
+        .requests
+        .iter()
+        .any(|r| r.id == document.id && r.relative != document.relative)
+    {
+        return Err(SaveRefusal::Moved);
+    }
+    match unchanged_on_disk(root, document) {
+        Ok(true) => {}
+        Ok(false) => {
+            return Err(if document.new {
+                SaveRefusal::Exists
+            } else {
+                SaveRefusal::Conflict
+            });
+        }
+        Err(_) => return Err(SaveRefusal::Io),
+    }
+    if !document.dirty(fields) {
+        return Ok(Vec::new());
+    }
+    let reference = document.body_reference();
+    let mut changes = Vec::new();
+    let body_changed = document.new || fields.body != document.saved.body;
+    if body_changed {
+        if !document.body_editable {
+            return Err(SaveRefusal::Invalid {
+                problem: FieldProblem::at(FieldName::Body, None),
+            });
+        }
+        let Some(reference) = &reference else {
+            return Err(SaveRefusal::Invalid {
+                problem: FieldProblem::at(FieldName::Body, None),
+            });
+        };
+        if shared(root, catalog, &document.id, reference) {
+            return Err(SaveRefusal::SharedBody);
+        }
+        let bytes = fields.body.clone().into_bytes();
+        changes.push(Change {
+            relative: reference.clone(),
+            before: document.baseline.get(reference).cloned().flatten(),
+            after: hash_bytes(&bytes),
+            bytes,
+        });
+    }
+    let edited = document
+        .edited_syntax(fields)
+        .ok_or(SaveRefusal::Invalid {
+            problem: FieldProblem::at(FieldName::Settings, None),
+        })?
+        .into_bytes();
+    let before = document.baseline.get(&document.relative).cloned().flatten();
+    if before.as_deref() != Some(hash_bytes(&edited).as_str()) {
+        changes.push(Change {
+            relative: document.relative.clone(),
+            before,
+            after: hash_bytes(&edited),
+            bytes: edited,
+        });
+    }
+    Ok(changes)
+}
+
+/// Whether another request in the collection references `body`.
+fn shared(root: &Path, catalog: &project::Catalog, id: &str, body: &str) -> bool {
+    catalog.requests.iter().filter(|r| r.id != id).any(|r| {
+        project::relative_path(&r.relative, false)
+            .and_then(|rel| project::read_optional(root, &rel, project::METADATA_BYTES).ok())
+            .flatten()
+            .and_then(|b| project::parse_metadata(&b))
+            .and_then(|d| d.get("body").and_then(Item::as_str).map(str::to_owned))
+            .is_some_and(|other| other == body)
+    })
+}
+
+/// The document after its planned changes were written.
+pub fn committed(document: &Document, fields: &Fields, changes: &[Change]) -> Document {
+    let mut next = document.clone();
+    for change in changes {
+        next.baseline
+            .insert(change.relative.clone(), Some(change.after.clone()));
+        if change.relative == document.relative {
+            next.syntax = String::from_utf8_lossy(&change.bytes).into_owned();
+        }
+    }
+    next.saved = fields.clone();
+    next.new = false;
+    next.metadata_dirty = false;
+    next
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn rows_round_trip_and_report_their_line() {
+        assert_eq!(
+            header_rows("A: 1\n\n# B: two words ").expect("fixture"),
+            vec![
+                Row {
+                    name: "A".into(),
+                    value: "1".into(),
+                    enabled: true
+                },
+                Row {
+                    name: "B".into(),
+                    value: "two words".into(),
+                    enabled: false
+                },
+            ]
+        );
+        assert_eq!(
+            header_rows("A: 1\nbroken").expect_err("fixture"),
+            FieldProblem {
+                field: FieldName::Headers,
+                line: Some(2)
+            }
+        );
+        assert_eq!(
+            query_rows("q= spaced ").expect("fixture")[0].value,
+            " spaced "
+        );
+        assert!(query_rows("=v").is_err());
+    }
+
+    #[test]
+    fn settings_hold_references_never_credentials() {
+        assert!(settings_ok("[auth]\nkind = \"bearer\"\nsecret = \"token\"\n").is_some());
+        assert!(settings_ok("[variables]\nhost = \"x\"\nkey = { secret = \"k\" }\n").is_some());
+        assert!(settings_ok("[auth]\nkind = \"bearer\"\ntoken = \"abc\"\n").is_none());
+        assert!(settings_ok("[auth]\nkind = \"digest\"\n").is_none());
+        assert!(settings_ok("[auth]\nsecret = \"bad ref\"\n").is_none());
+        assert!(settings_ok("[variables]\nkey = { secret = \"k\", value = \"v\" }\n").is_none());
+        assert!(settings_ok("[environment]\n").is_none());
+        assert!(settings_ok("[auth\n").is_none());
+    }
+
+    #[test]
+    fn checks_name_the_field_that_cannot_be_written() {
+        let ok = Fields::default();
+        assert_eq!(check(&ok), Ok(()));
+        let field = |f: Fields| check(&f).expect_err("fixture").field;
+        assert_eq!(
+            field(Fields {
+                method: "G T".into(),
+                ..ok.clone()
+            }),
+            FieldName::Method
+        );
+        assert_eq!(
+            field(Fields {
+                url: " ".into(),
+                ..ok.clone()
+            }),
+            FieldName::Url
+        );
+        assert_eq!(
+            field(Fields {
+                body_kind: "xml".into(),
+                ..ok.clone()
+            }),
+            FieldName::BodyKind
+        );
+        assert_eq!(
+            field(Fields {
+                body_kind: "multipart".into(),
+                body: "[[parts]]\nvalue = \"x\"\n".into(),
+                ..ok.clone()
+            }),
+            FieldName::Body
+        );
+        assert_eq!(
+            check(&Fields {
+                body_kind: "json".into(),
+                body: "{not json".into(),
+                ..ok.clone()
+            }),
+            Ok(())
+        );
+    }
+
+    #[test]
+    fn edits_keep_comments_extensions_and_line_endings() {
+        let syntax = "# kept\r\nformat_version = 1\r\nid = \"a\"\r\nmethod = \"GET\" # verb\r\nurl = \"https://a/\"\r\nx-ext = 3\r\n\r\n[[headers]]\r\nname = \"A\"\r\nvalue = \"1\"\r\nnote = \"kept\"\r\n";
+        let doc = Document {
+            id: "a".into(),
+            relative: "a.request.toml".into(),
+            syntax: syntax.into(),
+            baseline: Baseline::new(),
+            saved: Fields {
+                method: "GET".into(),
+                url: "https://a/".into(),
+                headers: "A: 1".into(),
+                ..Fields::default()
+            },
+            new: false,
+            body_editable: true,
+            metadata_dirty: false,
+        };
+        let fields = Fields {
+            method: "POST".into(),
+            headers: "B: 2\nA: 1".into(),
+            ..doc.saved.clone()
+        };
+        let edited = doc.edited_syntax(&fields).expect("fixture");
+        assert!(edited.starts_with("# kept\r\n"));
+        assert!(edited.contains("method = \"POST\" # verb\r\n"));
+        assert!(edited.contains("x-ext = 3"));
+        assert!(edited.contains("note = \"kept\""));
+        assert!(!edited.replace("\r\n", "").contains('\n'));
+        assert!(edited.find("\"B\"").expect("fixture") < edited.find("\"A\"").expect("fixture"));
+    }
+}
diff --git a/crates/desktop-core/src/workbench/environments.rs b/crates/desktop-core/src/workbench/environments.rs
new file mode 100644
index 0000000..bcfd509
--- /dev/null
+++ b/crates/desktop-core/src/workbench/environments.rs
@@ -0,0 +1,375 @@
+//! Environments and variables (C14, v1's rules). Shared environments are
+//! `environments/<name>.toml` files in the collection; private ones live
+//! only on this Mac (sealed with the workbench profile) and are never
+//! committed. A variable is a plain string or `{secret = "reference"}`;
+//! files hold the reference, never the value. Precedence (later wins):
+//! collection defaults, private `_defaults`, the selected shared
+//! environment, the selected private environment, the request's own
+//! `[variables]`. The preview resolves `{{name}}` one level deep with every
+//! secret masked; nothing here sends anything.
+
+use std::collections::BTreeMap;
+
+use serde::Serialize;
+use toml_edit::{DocumentMut, Item};
+use ts_rs::TS;
+
+use super::document::{self, Fields};
+
+/// Environment files (v1: 1 MiB).
+pub const ENVIRONMENT_BYTES: usize = 1024 * 1024;
+/// Private environments kept per collection.
+pub const MAX_PRIVATE: usize = 128;
+/// The reserved private environment applied under every selection.
+pub const DEFAULTS: &str = "_defaults";
+
+pub fn valid_name(name: &str) -> bool {
+    !name.is_empty()
+        && name.len() <= 128
+        && name
+            .bytes()
+            .all(|b| b.is_ascii_alphanumeric() || b"_-".contains(&b))
+}
+
+/// An environment's text: `format_version = 1` and `[variables]` only.
+pub fn text_ok(text: &str) -> Option<DocumentMut> {
+    let doc: DocumentMut = text.parse().ok()?;
+    (super::project::format_one(&doc)
+        && doc
+            .iter()
+            .all(|(k, _)| matches!(k, "format_version" | "variables"))
+        && document::variables_ok(&doc))
+    .then_some(doc)
+}
+
+pub fn new_text() -> String {
+    "format_version = 1\n\n[variables]\n".to_owned()
+}
+
+/// Where an environment comes from.
+#[derive(Clone, Copy, Debug, PartialEq, Eq, Serialize, TS)]
+#[serde(rename_all = "camelCase")]
+pub enum Origin {
+    Shared,
+    Local,
+    Both,
+}
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq, Serialize, TS)]
+#[serde(rename_all = "camelCase")]
+pub enum Layer {
+    Collection,
+    LocalDefaults,
+    Shared,
+    Local,
+    Request,
+}
+
+#[derive(Clone, Debug, PartialEq, Eq)]
+enum Value {
+    Plain(String),
+    Secret(String),
+}
+
+/// One effective variable (a secret's value never appears).
+#[derive(Clone, Debug, PartialEq, Eq, Serialize, TS)]
+#[serde(rename_all = "camelCase")]
+pub struct VariableView {
+    pub name: String,
+    pub layer: Layer,
+    /// The secret reference, for secret variables.
+    pub secret: Option<String>,
+    /// Whether that secret has a value on this Mac.
+    pub stored: Option<bool>,
+}
+
+/// The layers a preview resolves with (texts as read or held).
+#[derive(Clone, Debug, Default)]
+pub struct Layers {
+    pub collection: Option<String>,
+    pub local_defaults: Option<String>,
+    pub shared: Option<String>,
+    pub local: Option<String>,
+}
+
+/// The request as it would be prepared, with every secret masked.
+#[derive(Clone, Debug, PartialEq, Eq, Serialize, TS)]
+#[serde(rename_all = "camelCase")]
+pub struct Preview {
+    pub method: String,
+    pub url: String,
+    pub headers: Vec<(String, String)>,
+    pub query: Vec<(String, String)>,
+    pub body_kind: String,
+    /// The first 4 KiB of the rendered body.
+    pub body: String,
+    pub body_bytes: u32,
+    pub variables: Vec<VariableView>,
+    /// Variables used but not defined.
+    pub unresolved: Vec<String>,
+    /// Secret references used but without a value on this Mac.
+    pub missing_secrets: Vec<String>,
+    /// The auth kind and the references it names (never values).
+    pub auth: Option<String>,
+    pub auth_references: Vec<String>,
+    /// The request cannot be prepared as typed.
+    pub problem: Option<document::FieldProblem>,
+    /// A JSON body that does not parse (sent as typed).
+    pub json_warning: bool,
+}
+
+pub const MASK: &str = "••••••";
+const PREVIEW_BODY: usize = 4 * 1024;
+
+fn layer_values(text: &str, layer: Layer, into: &mut BTreeMap<String, (Value, Layer)>) {
+    let Ok(doc) = text.parse::<DocumentMut>() else {
+        return;
+    };
+    let Some(table) = doc.get("variables").and_then(Item::as_table_like) else {
+        return;
+    };
+    for (name, value) in table.iter() {
+        let value = match value.as_str() {
+            Some(v) => Value::Plain(v.to_owned()),
+            None => match value.get("secret").and_then(Item::as_str) {
+                Some(r) => Value::Secret(r.to_owned()),
+                None => continue,
+            },
+        };
+        into.insert(name.to_owned(), (value, layer));
+    }
+}
+
+/// `{{name}}` substitution, one level, `{{{` escapes a brace (v1).
+fn substitute(
+    text: &str,
+    values: &BTreeMap<String, (Value, Layer)>,
+    used: &mut Vec<String>,
+    unresolved: &mut Vec<String>,
+) -> String {
+    let mut out = String::new();
+    let mut rest = text;
+    while let Some(start) = rest.find("{{") {
+        if rest[start + 2..].starts_with('{') {
+            out.push_str(&rest[..start + 1]);
+            rest = &rest[start + 1..];
+            continue;
+        }
+        out.push_str(&rest[..start]);
+        let Some(end) = rest[start + 2..].find("}}") else {
+            out.push_str(&rest[start..]);
+            return out;
+        };
+        let raw = &rest[start + 2..start + 2 + end];
+        let name = raw.trim();
+        match values.get(name) {
+            Some((Value::Plain(v), _)) if !v.contains("{{") => {
+                used.push(name.to_owned());
+                out.push_str(v);
+            }
+            Some((Value::Secret(_), _)) => {
+                used.push(name.to_owned());
+                out.push_str(MASK);
+            }
+            _ => {
+                if document::valid_variable(name) && !unresolved.iter().any(|u| u == name) {
+                    unresolved.push(name.to_owned());
+                }
+                out.push_str("{{");
+                out.push_str(raw);
+                out.push_str("}}");
+            }
+        }
+        rest = &rest[start + 2 + end + 2..];
+    }
+    out.push_str(rest);
+    out
+}
+
+/// Previews `fields` under `layers`; `stored` says whether a secret
+/// reference has a value on this Mac.
+pub fn preview(fields: &Fields, layers: &Layers, stored: &dyn Fn(&str) -> bool) -> Preview {
+    let mut values = BTreeMap::new();
+    for (text, layer) in [
+        (&layers.collection, Layer::Collection),
+        (&layers.local_defaults, Layer::LocalDefaults),
+        (&layers.shared, Layer::Shared),
+        (&layers.local, Layer::Local),
+        (&Some(fields.settings.clone()), Layer::Request),
+    ] {
+        if let Some(text) = text {
+            layer_values(text, layer, &mut values);
+        }
+    }
+    let mut used = Vec::new();
+    let mut unresolved = Vec::new();
+    let problem = document::check(fields).err();
+    let mut sub = |t: &str| substitute(t, &values, &mut used, &mut unresolved);
+    let url = sub(&fields.url);
+    let headers = document::header_rows(&fields.headers)
+        .unwrap_or_default()
+        .into_iter()
+        .filter(|r| r.enabled)
+        .map(|r| (sub(&r.name), sub(&r.value)))
+        .collect();
+    let query = document::query_rows(&fields.query)
+        .unwrap_or_default()
+        .into_iter()
+        .filter(|r| r.enabled)
+        .map(|r| (sub(&r.name), sub(&r.value)))
+        .collect();
+    let body = if fields.body_kind == "file" {
+        String::new()
+    } else {
+        sub(&fields.body)
+    };
+    let (auth, auth_references) = match document::settings_ok(&fields.settings) {
+        Some(doc) => match doc.get("auth") {
+            Some(a) => (
+                a.get("kind").and_then(Item::as_str).map(str::to_owned),
+                // `secret` names a reference; `client_secret` (OAuth) is a
+                // single `{{variable}}` that must hold one.
+                a.get("secret")
+                    .and_then(Item::as_str)
+                    .map(str::to_owned)
+                    .into_iter()
+                    .chain(
+                        a.get("client_secret")
+                            .and_then(Item::as_str)
+                            .and_then(|v| v.strip_prefix("{{")?.strip_suffix("}}"))
+                            .and_then(|name| match values.get(name.trim()) {
+                                Some((Value::Secret(r), _)) => Some(r.clone()),
+                                _ => None,
+                            }),
+                    )
+                    .collect(),
+            ),
+            None => (None, Vec::new()),
+        },
+        None => (None, Vec::new()),
+    };
+    used.sort();
+    used.dedup();
+    let variables: Vec<VariableView> = values
+        .iter()
+        .map(|(name, (value, layer))| VariableView {
+            name: name.clone(),
+            layer: *layer,
+            secret: match value {
+                Value::Secret(r) => Some(r.clone()),
+                Value::Plain(_) => None,
+            },
+            stored: match value {
+                Value::Secret(r) => Some(stored(r)),
+                Value::Plain(_) => None,
+            },
+        })
+        .collect();
+    let mut missing_secrets: Vec<String> = variables
+        .iter()
+        .filter(|v| used.contains(&v.name) && v.stored == Some(false))
+        .filter_map(|v| v.secret.clone())
+        .collect();
+    if auth.as_deref() != Some("none") {
+        for r in &auth_references {
+            if document::valid_reference(r) && !stored(r) && !missing_secrets.contains(r) {
+                missing_secrets.push(r.clone());
+            }
+        }
+    }
+    Preview {
+        method: fields.method.clone(),
+        url,
+        headers,
+        query,
+        body_kind: fields.body_kind.clone(),
+        body_bytes: u32::try_from(body.len()).unwrap_or(u32::MAX),
+        body: body.chars().take(PREVIEW_BODY).collect(),
+        variables,
+        unresolved,
+        missing_secrets,
+        auth,
+        auth_references,
+        problem,
+        json_warning: fields.body_kind == "json"
+            && serde_json::from_str::<serde_json::Value>(&fields.body).is_err(),
+    }
+}
+
+/// The secret references a document names (`[variables]` secrets and
+/// `[auth] secret`).
+pub fn references_in(doc: &DocumentMut, into: &mut std::collections::BTreeSet<String>) {
+    if let Some(table) = doc.get("variables").and_then(Item::as_table_like) {
+        for (_, v) in table.iter() {
+            if let Some(r) = v.get("secret").and_then(Item::as_str)
+                && document::valid_reference(r)
+            {
+                into.insert(r.to_owned());
+            }
+        }
+    }
+    if let Some(r) = doc
+        .get("auth")
+        .and_then(|a| a.get("secret"))
+        .and_then(Item::as_str)
+        && document::valid_reference(r)
+    {
+        into.insert(r.to_owned());
+    }
+}
+
+/// The secret references texts name (for the Secrets list).
+pub fn references(texts: &[&str]) -> Vec<String> {
+    let mut found = std::collections::BTreeSet::new();
+    for text in texts {
+        if let Ok(doc) = text.parse::<DocumentMut>() {
+            references_in(&doc, &mut found);
+        }
+    }
+    found.into_iter().collect()
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn layers_apply_in_order_and_secrets_stay_masked() {
+        let layers = Layers {
+            collection: Some("format_version = 1\nid = \"c\"\n[variables]\nhost = \"col\"\nkeep = \"c\"\n".into()),
+            local_defaults: Some("format_version = 1\n[variables]\nhost = \"defaults\"\n".into()),
+            shared: Some("format_version = 1\n[variables]\nhost = \"shared\"\ntoken = { secret = \"tok\" }\n".into()),
+            local: Some("format_version = 1\n[variables]\nhost = \"local\"\n".into()),
+        };
+        let fields = Fields {
+            url: "https://{{host}}/{{keep}}/{{nope}}".into(),
+            headers: "Authorization: Bearer {{token}}".into(),
+            settings: "[variables]\nkeep = \"req\"\n".into(),
+            ..Fields::default()
+        };
+        let p = preview(&fields, &layers, &|r| r == "other");
+        assert_eq!(p.url, "https://local/req/{{nope}}");
+        assert_eq!(
+            p.headers,
+            vec![("Authorization".into(), format!("Bearer {MASK}"))]
+        );
+        assert_eq!(p.unresolved, ["nope"]);
+        assert_eq!(p.missing_secrets, ["tok"]);
+        assert!(!format!("{p:?}").contains("secret-value"));
+        let host = p
+            .variables
+            .iter()
+            .find(|v| v.name == "host")
+            .expect("fixture");
+        assert_eq!(host.layer, Layer::Local);
+    }
+
+    #[test]
+    fn environment_texts_hold_variables_only() {
+        assert!(text_ok(&new_text()).is_some());
+        assert!(text_ok("format_version = 1\n[variables]\nk = { secret = \"r\" }\n").is_some());
+        assert!(text_ok("format_version = 2\n").is_none());
+        assert!(text_ok("format_version = 1\n[auth]\n").is_none());
+        assert!(valid_name("dev-1") && !valid_name("a b") && !valid_name(""));
+    }
+}
diff --git a/crates/desktop-core/src/workbench/git.rs b/crates/desktop-core/src/workbench/git.rs
new file mode 100644
index 0000000..b5efca8
--- /dev/null
+++ b/crates/desktop-core/src/workbench/git.rs
@@ -0,0 +1,295 @@
+//! The read-only Git view of an open collection (C14, v1: branch, HEAD,
+//! upstream and changes). Local editing, saving and previews work without
+//! Git. `git` runs from an absolute path only (never a PATH lookup or the
+//! `/usr/bin` shim that offers to install developer tools), with an empty
+//! environment, no system or global configuration, optional locks off and
+//! every repository-configurable program disabled (fsmonitor, hooks), for
+//! at most 5 s and 1 MiB of output.
+
+use std::io::Read;
+use std::path::{Path, PathBuf};
+use std::process::{Command, Stdio};
+use std::time::{Duration, Instant};
+
+use serde::Serialize;
+use ts_rs::TS;
+
+pub const TIMEOUT: Duration = Duration::from_secs(5);
+pub const OUTPUT_BYTES: usize = 1024 * 1024;
+pub const MAX_CHANGES: usize = 500;
+
+/// Absolute locations tried in order.
+pub const CANDIDATES: [&str; 4] = [
+    "/opt/homebrew/bin/git",
+    "/usr/local/bin/git",
+    "/Library/Developer/CommandLineTools/usr/bin/git",
+    "/Applications/Xcode.app/Contents/Developer/usr/bin/git",
+];
+
+pub fn locate() -> Option<PathBuf> {
+    CANDIDATES
+        .iter()
+        .map(PathBuf::from)
+        .find(|p| std::fs::metadata(p).is_ok_and(|m| m.is_file()))
+}
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq, Serialize, TS)]
+#[serde(rename_all = "camelCase")]
+pub enum GitState {
+    /// No Git installation was found at a known location.
+    Unavailable,
+    /// The collection is not inside a Git working tree.
+    NotRepository,
+    Ready,
+    /// Git failed or took too long.
+    Failed,
+}
+
+#[derive(Clone, Debug, PartialEq, Eq, Serialize, TS)]
+#[serde(rename_all = "camelCase")]
+pub struct GitChange {
+    /// Repository-relative.
+    pub path: String,
+    /// Porcelain v2 `XY` (or `??` untracked, `!!` ignored, `u` unmerged).
+    pub status: String,
+}
+
+#[derive(Clone, Debug, PartialEq, Eq, Serialize, TS)]
+#[serde(rename_all = "camelCase")]
+pub struct GitView {
+    pub state: GitState,
+    pub branch: Option<String>,
+    pub head: Option<String>,
+    pub upstream: Option<String>,
+    pub ahead: Option<u32>,
+    pub behind: Option<u32>,
+    pub changes: Vec<GitChange>,
+    pub truncated: bool,
+}
+
+impl GitView {
+    fn of(state: GitState) -> Self {
+        Self {
+            state,
+            branch: None,
+            head: None,
+            upstream: None,
+            ahead: None,
+            behind: None,
+            changes: Vec::new(),
+            truncated: false,
+        }
+    }
+}
+
+/// Runs one hardened, bounded, read-only git command in `root`.
+fn run(git: &Path, root: &Path, args: &[&str]) -> Option<(bool, Vec<u8>)> {
+    let mut child = Command::new(git)
+        .arg("-C")
+        .arg(root)
+        .args([
+            "-c",
+            "core.fsmonitor=false",
+            "-c",
+            "core.hooksPath=/dev/null",
+            "-c",
+            "core.untrackedCache=false",
+            "-c",
+            "status.showUntrackedFiles=normal",
+            "--no-optional-locks",
+        ])
+        .args(args)
+        .env_clear()
+        .env("GIT_CONFIG_NOSYSTEM", "1")
+        .env("GIT_CONFIG_GLOBAL", "/dev/null")
+        .env("GIT_TERMINAL_PROMPT", "0")
+        .env("GIT_OPTIONAL_LOCKS", "0")
+        .env("LC_ALL", "C")
+        .stdin(Stdio::null())
+        .stdout(Stdio::piped())
+        .stderr(Stdio::null())
+        .spawn()
+        .ok()?;
+    let mut stdout = child.stdout.take()?;
+    let reader = std::thread::spawn(move || {
+        let mut out = Vec::new();
+        let _ = (&mut stdout)
+            .take(OUTPUT_BYTES as u64 + 1)
+            .read_to_end(&mut out);
+        out
+    });
+    let started = Instant::now();
+    let status = loop {
+        match child.try_wait() {
+            Ok(Some(status)) => break Some(status),
+            Ok(None) if started.elapsed() < TIMEOUT => {
+                std::thread::sleep(Duration::from_millis(10))
+            }
+            _ => {
+                let _ = child.kill();
+                let _ = child.wait();
+                break None;
+            }
+        }
+    };
+    let out = reader.join().ok()?;
+    let status = status?;
+    if out.len() > OUTPUT_BYTES {
+        return None;
+    }
+    Some((status.success(), out))
+}
+
+/// Parses `git status --porcelain=v2 --branch -z` output.
+pub fn parse(out: &[u8]) -> GitView {
+    let mut view = GitView::of(GitState::Ready);
+    let text = String::from_utf8_lossy(out);
+    let mut records = text.split('\0').peekable();
+    while let Some(record) = records.next() {
+        if let Some(header) = record.strip_prefix("# ") {
+            let (key, rest) = header.split_once(' ').unwrap_or((header, ""));
+            match key {
+                "branch.oid" if rest != "(initial)" => {
+                    view.head = Some(rest.chars().take(12).collect());
+                }
+                "branch.head" if rest != "(detached)" => view.branch = Some(rest.to_owned()),
+                "branch.upstream" => view.upstream = Some(rest.to_owned()),
+                "branch.ab" => {
+                    let mut parts = rest.split(' ');
+                    view.ahead = parts
+                        .next()
+                        .and_then(|a| a.trim_start_matches('+').parse().ok());
+                    view.behind = parts
+                        .next()
+                        .and_then(|b| b.trim_start_matches('-').parse().ok());
+                }
+                _ => {}
+            }
+            continue;
+        }
+        let (status, path) = match record.chars().next() {
+            Some('1') => {
+                let fields: Vec<&str> = record.splitn(9, ' ').collect();
+                (fields.get(1).copied(), fields.get(8).copied())
+            }
+            Some('2') => {
+                let fields: Vec<&str> = record.splitn(10, ' ').collect();
+                // The original path follows as its own record.
+                records.next();
+                (fields.get(1).copied(), fields.get(9).copied())
+            }
+            Some('u') => {
+                let fields: Vec<&str> = record.splitn(11, ' ').collect();
+                (Some("u"), fields.get(10).copied())
+            }
+            Some('?') => (Some("??"), record.get(2..)),
+            Some('!') => (Some("!!"), record.get(2..)),
+            _ => (None, None),
+        };
+        if let (Some(status), Some(path)) = (status, path) {
+            if view.changes.len() >= MAX_CHANGES {
+                view.truncated = true;
+                continue;
+            }
+            view.changes.push(GitChange {
+                path: path.chars().take(1024).collect(),
+                status: status.to_owned(),
+            });
+        }
+    }
+    view
+}
+
+/// Reads the view for the collection at `root`.
+pub fn read(git: Option<&Path>, root: &Path) -> GitView {
+    let Some(git) = git else {
+        return GitView::of(GitState::Unavailable);
+    };
+    match run(git, root, &["rev-parse", "--is-inside-work-tree"]) {
+        Some((true, out)) if out.starts_with(b"true") => {}
+        Some(_) => return GitView::of(GitState::NotRepository),
+        None => return GitView::of(GitState::Failed),
+    }
+    match run(
+        git,
+        root,
+        &["status", "--porcelain=v2", "--branch", "-z", "--", "."],
+    ) {
+        Some((true, out)) => parse(&out),
+        _ => GitView::of(GitState::Failed),
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn porcelain_v2_records_are_parsed() {
+        let out = b"# branch.oid 0123456789abcdef0123\0# branch.head main\0# branch.upstream origin/main\0# branch.ab +2 -1\x001 .M N... 100644 100644 100644 aaa bbb a.request.toml\x002 R. N... 100644 100644 100644 aaa bbb R100 new.toml\0old.toml\0? untracked.txt\0";
+        let view = parse(out);
+        assert_eq!(view.branch.as_deref(), Some("main"));
+        assert_eq!(view.head.as_deref(), Some("0123456789ab"));
+        assert_eq!((view.ahead, view.behind), (Some(2), Some(1)));
+        assert_eq!(
+            view.changes,
+            vec![
+                GitChange {
+                    path: "a.request.toml".into(),
+                    status: ".M".into()
+                },
+                GitChange {
+                    path: "new.toml".into(),
+                    status: "R.".into()
+                },
+                GitChange {
+                    path: "untracked.txt".into(),
+                    status: "??".into()
+                },
+            ]
+        );
+    }
+
+    #[test]
+    fn repository_hooks_and_fsmonitor_never_run() {
+        let Some(git) = locate() else { return };
+        let d = crate::workbench::testdir::Dir::new();
+        let ok = |args: &[&str]| {
+            Command::new(&git)
+                .arg("-C")
+                .arg(d.path())
+                .args(args)
+                .env_clear()
+                .env("GIT_CONFIG_NOSYSTEM", "1")
+                .env("GIT_CONFIG_GLOBAL", "/dev/null")
+                .stdout(Stdio::null())
+                .stderr(Stdio::null())
+                .status()
+                .expect("fixture")
+                .success()
+        };
+        assert!(ok(&["init", "-q"]));
+        let marker = d.path().join("ran");
+        let script = d.path().join("monitor.sh");
+        std::fs::write(&script, format!("#!/bin/sh\ntouch {}\n", marker.display()))
+            .expect("fixture");
+        use std::os::unix::fs::PermissionsExt;
+        std::fs::set_permissions(&script, std::fs::Permissions::from_mode(0o755)).expect("fixture");
+        assert!(ok(&[
+            "config",
+            "core.fsmonitor",
+            script.to_str().expect("fixture")
+        ]));
+        std::fs::write(d.path().join("a.txt"), "x").expect("fixture");
+        let view = read(Some(&git), d.path());
+        assert_eq!(view.state, GitState::Ready);
+        assert!(view.changes.iter().any(|c| c.path == "a.txt"));
+        assert!(!marker.exists(), "a repository-configured program ran");
+        let elsewhere = crate::workbench::testdir::Dir::new();
+        assert_eq!(
+            read(Some(&git), elsewhere.path()).state,
+            GitState::NotRepository
+        );
+        assert_eq!(read(None, d.path()).state, GitState::Unavailable);
+    }
+}
diff --git a/crates/desktop-core/src/workbench/insomnia.rs b/crates/desktop-core/src/workbench/insomnia.rs
new file mode 100644
index 0000000..0e0b474
--- /dev/null
+++ b/crates/desktop-core/src/workbench/insomnia.rs
@@ -0,0 +1,1040 @@
+//! Insomnia import (C14, v1's rules): only `collection.insomnia.rest/5.0`
+//! exports with `schema_version: 5.1`, YAML or JSON, at most 1 MiB and
+//! bounded once expanded (depth 64, 50,000 nodes, 16 MiB of text). The
+//! export is data: scripts, template expressions, plugins, path parameters
+//! and non-default request settings refuse that request; credentials become
+//! secret references (no value is stored). The operator selects what to
+//! create; requests become unsaved drafts and environments new shared
+//! environment files (never replacing a file).
+
+use std::cell::Cell;
+use std::collections::{BTreeMap, BTreeSet};
+use std::fmt;
+use std::rc::Rc;
+
+use serde::Serialize;
+use serde::de::{self, DeserializeSeed, MapAccess, SeqAccess, Visitor};
+use serde_json::{Map, Number, Value};
+use sha2::{Digest, Sha256};
+use toml_edit::{DocumentMut, InlineTable, Item, Table, value};
+use ts_rs::TS;
+
+use super::curl::credential_name;
+use super::document::{self, Fields};
+
+pub const EXPORT_BYTES: usize = 1024 * 1024;
+const MAX_NODES: usize = 50_000;
+const MAX_DEPTH: usize = 64;
+const EXPANDED_BYTES: usize = 16 * 1024 * 1024;
+const MAX_RESOURCES: usize = 1_000;
+const MAX_FOLDER_DEPTH: usize = 24;
+const MAX_ENVIRONMENTS: usize = 128;
+const ENVIRONMENT_BYTES: usize = 1024 * 1024;
+
+/// Why a whole export was refused.
+#[derive(Clone, Copy, Debug, PartialEq, Eq, Serialize, TS)]
+#[serde(rename_all = "camelCase")]
+pub enum ExportProblem {
+    TooLarge,
+    /// Not YAML/JSON within the limits (tags, duplicate or complex keys).
+    Unreadable,
+    /// Another format or schema version.
+    Version,
+    /// Unknown top-level fields or a malformed collection.
+    Structure,
+    /// More resources or folder nesting than the import takes.
+    Limit,
+}
+
+/// Why one resource cannot be converted.
+#[derive(Clone, Copy, Debug, PartialEq, Eq, Serialize, TS)]
+#[serde(rename_all = "camelCase")]
+pub enum ResourceProblem {
+    /// Unsupported fields, including scripts.
+    Fields,
+    PathParameters,
+    /// Non-default request settings (redirects, cookies, rendering).
+    Settings,
+    Method,
+    Url,
+    /// Template expressions, plugins or unclosed variables.
+    Template,
+    Header,
+    Parameter,
+    /// A literal credential in a query, form or JSON field, or the URL.
+    Credential,
+    Body,
+    Json,
+    Auth,
+    /// No-auth under folder authentication, or disabled authentication.
+    AuthReview,
+    /// Auth together with an Authorization header.
+    AuthCombination,
+    /// Inside a folder that was refused.
+    Folder,
+    /// The generated path is too long.
+    Path,
+    /// Nested, cyclic or oversized environment values.
+    Environment,
+}
+
+/// One converted request or environment, or why not.
+#[derive(Clone, Debug, PartialEq, Eq, Serialize, TS)]
+#[serde(rename_all = "camelCase")]
+pub struct ResourceView {
+    pub index: u32,
+    pub label: String,
+    pub relative: String,
+    pub environment: bool,
+    pub problem: Option<ResourceProblem>,
+}
+
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct Export {
+    pub source_sha256: String,
+    pub collection: String,
+    pub requests: Vec<(String, String, Result<Fields, ResourceProblem>)>,
+    pub environments: Vec<(String, String, Result<String, ResourceProblem>)>,
+}
+
+impl Export {
+    pub fn view(&self) -> Vec<ResourceView> {
+        let requests = self
+            .requests
+            .iter()
+            .map(|(l, r, f)| (l, r, false, f.as_ref().err()));
+        let envs = self
+            .environments
+            .iter()
+            .map(|(l, r, t)| (l, r, true, t.as_ref().err()));
+        requests
+            .chain(envs)
+            .enumerate()
+            .map(
+                |(i, (label, relative, environment, problem))| ResourceView {
+                    index: u32::try_from(i).unwrap_or(u32::MAX),
+                    label: label.clone(),
+                    relative: relative.clone(),
+                    environment,
+                    problem: problem.copied(),
+                },
+            )
+            .collect()
+    }
+}
+
+// ------------------------------------------------------------ bounded YAML
+
+#[derive(Clone)]
+struct Seed {
+    nodes: Rc<Cell<usize>>,
+    bytes: Rc<Cell<usize>>,
+    depth: usize,
+}
+
+impl Seed {
+    fn child(&self) -> Result<Self, &'static str> {
+        if self.depth >= MAX_DEPTH || self.nodes.get() >= MAX_NODES {
+            return Err("limit");
+        }
+        self.nodes.set(self.nodes.get() + 1);
+        Ok(Self {
+            depth: self.depth + 1,
+            ..self.clone()
+        })
+    }
+    fn string<E: de::Error>(&self, text: &str) -> Result<(), E> {
+        let size = self.bytes.get().saturating_add(text.len());
+        if size > EXPANDED_BYTES {
+            return Err(E::custom("limit"));
+        }
+        self.bytes.set(size);
+        Ok(())
+    }
+}
+
+impl<'de> DeserializeSeed<'de> for Seed {
+    type Value = Value;
+    fn deserialize<D: de::Deserializer<'de>>(self, d: D) -> Result<Value, D::Error> {
+        d.deserialize_any(self)
+    }
+}
+
+impl<'de> Visitor<'de> for Seed {
+    type Value = Value;
+    fn expecting(&self, f: &mut fmt::Formatter) -> fmt::Result {
+        f.write_str("bounded JSON-compatible YAML")
+    }
+    fn visit_bool<E: de::Error>(self, v: bool) -> Result<Value, E> {
+        Ok(Value::Bool(v))
+    }
+    fn visit_i64<E: de::Error>(self, v: i64) -> Result<Value, E> {
+        Ok(Value::Number(v.into()))
+    }
+    fn visit_u64<E: de::Error>(self, v: u64) -> Result<Value, E> {
+        Ok(Value::Number(v.into()))
+    }
+    fn visit_f64<E: de::Error>(self, v: f64) -> Result<Value, E> {
+        Number::from_f64(v)
+            .map(Value::Number)
+            .ok_or_else(|| E::custom("number"))
+    }
+    fn visit_unit<E: de::Error>(self) -> Result<Value, E> {
+        Ok(Value::Null)
+    }
+    fn visit_none<E: de::Error>(self) -> Result<Value, E> {
+        Ok(Value::Null)
+    }
+    fn visit_str<E: de::Error>(self, v: &str) -> Result<Value, E> {
+        self.string(v)?;
+        Ok(Value::String(v.into()))
+    }
+    fn visit_string<E: de::Error>(self, v: String) -> Result<Value, E> {
+        self.string(&v)?;
+        Ok(Value::String(v))
+    }
+    fn visit_seq<A: SeqAccess<'de>>(self, mut a: A) -> Result<Value, A::Error> {
+        let mut values = Vec::new();
+        loop {
+            let seed = self.child().map_err(de::Error::custom)?;
+            match a.next_element_seed(seed)? {
+                Some(v) => values.push(v),
+                None => break,
+            }
+        }
+        Ok(Value::Array(values))
+    }
+    fn visit_map<A: MapAccess<'de>>(self, mut a: A) -> Result<Value, A::Error> {
+        let mut values = Map::new();
+        loop {
+            let seed = self.child().map_err(de::Error::custom)?;
+            let Some(key) = a.next_key_seed(seed)? else {
+                break;
+            };
+            let Value::String(key) = key else {
+                return Err(de::Error::custom("key"));
+            };
+            if values.contains_key(&key) {
+                return Err(de::Error::custom("duplicate"));
+            }
+            let child = self.child().map_err(de::Error::custom)?;
+            values.insert(key, a.next_value_seed(child)?);
+        }
+        Ok(Value::Object(values))
+    }
+}
+
+/// Parses within the limits. Parser messages may quote source values, so
+/// they are never surfaced.
+fn bounded(text: &str) -> Result<Value, ExportProblem> {
+    if text.len() > EXPORT_BYTES {
+        return Err(ExportProblem::TooLarge);
+    }
+    let mut documents = serde_yaml_ng::Deserializer::from_str(text);
+    let d = documents.next().ok_or(ExportProblem::Unreadable)?;
+    let seed = Seed {
+        nodes: Rc::new(Cell::new(0)),
+        bytes: Rc::new(Cell::new(0)),
+        depth: 0,
+    };
+    let value = seed.deserialize(d).map_err(|_| ExportProblem::Unreadable)?;
+    if documents.next().is_some() {
+        return Err(ExportProblem::Unreadable);
+    }
+    Ok(value)
+}
+
+// ------------------------------------------------------------- conversion
+
+fn label(v: &Value, fallback: &str) -> String {
+    v.get("name")
+        .and_then(Value::as_str)
+        .unwrap_or(fallback)
+        .chars()
+        .filter(|c| !c.is_control())
+        .take(160)
+        .collect()
+}
+
+/// A bounded slug; URL-shaped names keep only the host (v1).
+fn slug(label: &str) -> String {
+    let safe = if label.starts_with("http://") || label.starts_with("https://") {
+        url::Url::parse(label)
+            .ok()
+            .and_then(|u| u.host_str().map(str::to_owned))
+            .unwrap_or_else(|| "request".into())
+    } else {
+        label.into()
+    };
+    let mut slug = String::new();
+    for byte in safe.bytes() {
+        let byte = byte.to_ascii_lowercase();
+        if byte.is_ascii_alphanumeric() {
+            slug.push(byte as char);
+        } else if !slug.is_empty() && !slug.ends_with('-') {
+            slug.push('-');
+        }
+        if slug.len() >= 40 {
+            break;
+        }
+    }
+    slug.truncate(slug.trim_end_matches('-').len());
+    if slug.is_empty() {
+        "resource".into()
+    } else {
+        slug
+    }
+}
+
+fn reference(digest: &str, scope: &str) -> String {
+    let d = hex::encode(Sha256::digest(format!("{digest}\0{scope}").as_bytes()));
+    format!("import-{}", &d[..32])
+}
+
+/// `{{ _.name }}` becomes `{{name}}`; any other expression is refused.
+fn translate(text: &str) -> Result<String, ResourceProblem> {
+    if text.contains("{%") {
+        return Err(ResourceProblem::Template);
+    }
+    let mut out = String::new();
+    let mut rest = text;
+    while let Some(start) = rest.find("{{") {
+        out.push_str(&rest[..start]);
+        let tail = &rest[start + 2..];
+        let end = tail.find("}}").ok_or(ResourceProblem::Template)?;
+        let raw = tail[..end].trim();
+        let name = raw.strip_prefix("_.").unwrap_or(raw);
+        if !document::valid_variable(name) {
+            return Err(ResourceProblem::Template);
+        }
+        out.push_str(&format!("{{{{{name}}}}}"));
+        rest = &tail[end + 2..];
+    }
+    out.push_str(rest);
+    Ok(out)
+}
+
+fn keys(v: &Value, allowed: &[&str]) -> bool {
+    v.as_object()
+        .is_some_and(|m| m.keys().all(|k| allowed.contains(&k.as_str())))
+}
+
+fn string<'a>(v: &'a Value, k: &str, problem: ResourceProblem) -> Result<&'a str, ResourceProblem> {
+    v.get(k).and_then(Value::as_str).ok_or(problem)
+}
+
+fn rows<'a>(v: &'a Value, k: &str) -> Result<&'a [Value], ResourceProblem> {
+    match v.get(k) {
+        None => Ok(&[]),
+        Some(v) => v
+            .as_array()
+            .map(Vec::as_slice)
+            .ok_or(ResourceProblem::Fields),
+    }
+}
+
+fn disabled(v: &Value) -> Result<bool, ResourceProblem> {
+    match v.get("disabled") {
+        None => Ok(false),
+        Some(v) => v.as_bool().ok_or(ResourceProblem::Fields),
+    }
+}
+
+/// A value that is only a variable (optionally after Bearer/Basic).
+fn managed_credential(text: &str) -> bool {
+    let text = text
+        .strip_prefix("Bearer ")
+        .or_else(|| text.strip_prefix("Basic "))
+        .unwrap_or(text);
+    text.strip_prefix("{{")
+        .and_then(|v| v.strip_suffix("}}"))
+        .is_some_and(document::valid_variable)
+}
+
+fn literal_secrets(v: &Value) -> bool {
+    match v {
+        Value::Object(m) => m.iter().any(|(k, v)| {
+            (credential_name(k) && !v.as_str().is_some_and(managed_credential))
+                || literal_secrets(v)
+        }),
+        Value::Array(a) => a.iter().any(literal_secrets),
+        _ => false,
+    }
+}
+
+const ROW_KEYS: [&str; 5] = ["id", "name", "value", "disabled", "description"];
+
+fn parameter_rows(v: &Value, k: &str) -> Result<String, ResourceProblem> {
+    let mut out = Vec::new();
+    for row in rows(v, k)? {
+        if !keys(row, &ROW_KEYS) {
+            return Err(ResourceProblem::Parameter);
+        }
+        let name = string(row, "name", ResourceProblem::Parameter)?;
+        let text = translate(string(row, "value", ResourceProblem::Parameter)?)?;
+        if name.is_empty()
+            || name.contains(['\r', '\n', '='])
+            || name.starts_with("# ")
+            || text.contains(['\r', '\n'])
+        {
+            return Err(ResourceProblem::Parameter);
+        }
+        if credential_name(name) && !managed_credential(&text) {
+            return Err(ResourceProblem::Credential);
+        }
+        out.push(format!(
+            "{}{name}={text}",
+            if disabled(row)? { "# " } else { "" }
+        ));
+    }
+    Ok(out.join("\n"))
+}
+
+fn headers_have(text: &str, name: &str) -> bool {
+    text.lines().any(|s| {
+        s.trim_start_matches("# ")
+            .split_once(':')
+            .is_some_and(|(n, _)| n.eq_ignore_ascii_case(name))
+    })
+}
+
+fn validate_url(text: &str) -> Result<(), ResourceProblem> {
+    if text.chars().any(char::is_control) {
+        return Err(ResourceProblem::Url);
+    }
+    // Variables become placeholders: a leading variable stands for an origin.
+    let mut surrogate = String::new();
+    let mut rest = text;
+    while let Some(start) = rest.find("{{") {
+        surrogate.push_str(&rest[..start]);
+        let end = rest[start..].find("}}").ok_or(ResourceProblem::Template)? + start;
+        surrogate.push_str(if start == 0 && surrogate.is_empty() {
+            "https://example.invalid"
+        } else {
+            "placeholder"
+        });
+        rest = &rest[end + 2..];
+    }
+    surrogate.push_str(rest);
+    let url = url::Url::parse(&surrogate).map_err(|_| ResourceProblem::Url)?;
+    if !["http", "https"].contains(&url.scheme()) || url.host_str().is_none() {
+        return Err(ResourceProblem::Url);
+    }
+    if !url.username().is_empty()
+        || url.password().is_some()
+        || url.query_pairs().any(|(k, _)| credential_name(&k))
+    {
+        return Err(ResourceProblem::Credential);
+    }
+    Ok(())
+}
+
+fn request_settings(v: Option<&Value>) -> Result<(), ResourceProblem> {
+    let Some(v) = v else { return Ok(()) };
+    let object = v.as_object().ok_or(ResourceProblem::Settings)?;
+    for (k, v) in object {
+        let ok = match k.as_str() {
+            "encodeUrl" | "rebuildPath" | "renderRequestBody" => v.as_bool() == Some(true),
+            "followRedirects" => v.as_str() == Some("global"),
+            "cookies" => v.as_object().is_some_and(|m| {
+                m.len() == 2
+                    && m.get("send").and_then(Value::as_bool) == Some(true)
+                    && m.get("store").and_then(Value::as_bool) == Some(true)
+            }),
+            _ => false,
+        };
+        if !ok {
+            return Err(ResourceProblem::Settings);
+        }
+    }
+    Ok(())
+}
+
+fn body(source: &Value, fields: &mut Fields) -> Result<(), ResourceProblem> {
+    let Some(body) = source.get("body") else {
+        return Ok(());
+    };
+    if !keys(body, &["mimeType", "text", "params"]) {
+        return Err(ResourceProblem::Body);
+    }
+    let mime = string(body, "mimeType", ResourceProblem::Body)?;
+    match mime {
+        "application/x-www-form-urlencoded" => {
+            if body.get("text").is_some() {
+                return Err(ResourceProblem::Body);
+            }
+            fields.body_kind = "form".into();
+            fields.body = parameter_rows(body, "params")?;
+        }
+        "application/json" | "text/plain" | "application/xml" | "text/xml" => {
+            if body.get("params").is_some() {
+                return Err(ResourceProblem::Body);
+            }
+            let text = translate(body.get("text").and_then(Value::as_str).unwrap_or(""))?;
+            if mime == "application/json" {
+                let json: Value = serde_json::from_str(&text).map_err(|_| ResourceProblem::Json)?;
+                if literal_secrets(&json) {
+                    return Err(ResourceProblem::Credential);
+                }
+                fields.body_kind = "json".into();
+            }
+            fields.body = text;
+        }
+        _ => return Err(ResourceProblem::Body),
+    }
+    if !headers_have(&fields.headers, "content-type") {
+        if !fields.headers.is_empty() {
+            fields.headers.push('\n');
+        }
+        fields.headers.push_str(&format!("Content-Type: {mime}"));
+    }
+    if fields.body.len() > document::BODY_BYTES {
+        return Err(ResourceProblem::Body);
+    }
+    Ok(())
+}
+
+fn auth(
+    source: &Value,
+    inherited: Option<(&Value, &str)>,
+    own: &str,
+    headers: &str,
+    doc: &mut DocumentMut,
+) -> Result<(), ResourceProblem> {
+    let Some(auth) = source.get("authentication").or(inherited.map(|(v, _)| v)) else {
+        return Ok(());
+    };
+    let kind = string(auth, "type", ResourceProblem::Auth)?;
+    if kind == "none" {
+        return if inherited.is_some() {
+            Err(ResourceProblem::AuthReview)
+        } else {
+            Ok(())
+        };
+    }
+    if headers_have(headers, "authorization") {
+        return Err(ResourceProblem::AuthCombination);
+    }
+    let reference = if source.get("authentication").is_none() {
+        inherited.map(|(_, r)| r).unwrap_or(own)
+    } else {
+        own
+    };
+    let mut table = Table::new();
+    match kind {
+        "basic" => {
+            if !keys(auth, &["type", "username", "password", "disabled"]) {
+                return Err(ResourceProblem::Auth);
+            }
+            table["kind"] = value("basic");
+            table["username"] = value(translate(string(auth, "username", ResourceProblem::Auth)?)?);
+        }
+        "bearer" => {
+            if !keys(auth, &["type", "token", "prefix", "disabled"])
+                || auth
+                    .get("prefix")
+                    .is_some_and(|v| v.as_str() != Some("Bearer"))
+            {
+                return Err(ResourceProblem::Auth);
+            }
+            table["kind"] = value("bearer");
+        }
+        "oauth2" => {
+            if !keys(
+                auth,
+                &[
+                    "type",
+                    "grantType",
+                    "accessTokenUrl",
+                    "clientId",
+                    "clientSecret",
+                    "credentialsInBody",
+                    "scope",
+                ],
+            ) || string(auth, "grantType", ResourceProblem::Auth)? != "client_credentials"
+                || auth
+                    .get("credentialsInBody")
+                    .is_some_and(|v| v.as_bool() == Some(true))
+            {
+                return Err(ResourceProblem::Auth);
+            }
+            table["kind"] = value("oauth2");
+            let token_url = match auth.get("accessTokenUrl").and_then(Value::as_str) {
+                Some(u) if !u.trim().is_empty() => translate(u)?,
+                _ => "{{token_url}}".into(),
+            };
+            table["token_url"] = value(token_url);
+            let client_id = match auth.get("clientId").and_then(Value::as_str) {
+                Some(id) if !id.trim().is_empty() => translate(id)?,
+                _ => "{{client_id}}".into(),
+            };
+            table["client_id"] = value(client_id);
+            if let Some(scope) = auth
+                .get("scope")
+                .and_then(Value::as_str)
+                .filter(|s| !s.is_empty())
+            {
+                table["scope"] = value(translate(scope)?);
+            }
+        }
+        "apikey" => {
+            if !keys(auth, &["type", "key", "value", "addTo", "disabled"]) {
+                return Err(ResourceProblem::Auth);
+            }
+            let name = string(auth, "key", ResourceProblem::Auth)?;
+            let location = string(auth, "addTo", ResourceProblem::Auth)?;
+            if !["header", "query"].contains(&location)
+                || name.is_empty()
+                || name.contains(['\r', '\n'])
+                || (location == "header" && http::HeaderName::from_bytes(name.as_bytes()).is_err())
+            {
+                return Err(ResourceProblem::Auth);
+            }
+            table["kind"] = value("api-key");
+            table["name"] = value(name);
+            table["location"] = value(location);
+        }
+        _ => return Err(ResourceProblem::Auth),
+    }
+    if auth
+        .get("disabled")
+        .is_some_and(|v| v.as_bool() == Some(true))
+    {
+        return Err(ResourceProblem::AuthReview);
+    }
+    table["secret"] = value(reference);
+    doc["auth"] = Item::Table(table);
+    Ok(())
+}
+
+const REQUEST_KEYS: [&str; 10] = [
+    "name",
+    "meta",
+    "url",
+    "method",
+    "headers",
+    "parameters",
+    "body",
+    "authentication",
+    "settings",
+    "pathParameters",
+];
+
+fn request(
+    source: &Value,
+    inherited: Option<(&Value, &str)>,
+    own: &str,
+) -> Result<Fields, ResourceProblem> {
+    if !keys(source, &REQUEST_KEYS) {
+        return Err(ResourceProblem::Fields);
+    }
+    if source
+        .get("pathParameters")
+        .is_some_and(|v| !v.as_array().is_some_and(Vec::is_empty))
+    {
+        return Err(ResourceProblem::PathParameters);
+    }
+    request_settings(source.get("settings"))?;
+    let method = string(source, "method", ResourceProblem::Method)?;
+    if method.is_empty()
+        || method.len() > document::METHOD_CHARS
+        || !method.bytes().all(|b| b.is_ascii_alphabetic() || b == b'-')
+    {
+        return Err(ResourceProblem::Method);
+    }
+    let url = translate(string(source, "url", ResourceProblem::Url)?)?;
+    validate_url(&url)?;
+    let mut fields = Fields {
+        method: method.into(),
+        url,
+        ..Fields::default()
+    };
+    let mut doc = DocumentMut::new();
+    let mut headers = Vec::new();
+    for row in rows(source, "headers")? {
+        if !keys(row, &ROW_KEYS) {
+            return Err(ResourceProblem::Header);
+        }
+        let name = string(row, "name", ResourceProblem::Header)?;
+        let text = translate(string(row, "value", ResourceProblem::Header)?)?;
+        if http::HeaderName::from_bytes(name.as_bytes()).is_err() || text.contains(['\r', '\n']) {
+            return Err(ResourceProblem::Header);
+        }
+        let text = if credential_name(name) && !managed_credential(&text) {
+            if doc.get("variables").is_none() {
+                doc["variables"] = Item::Table(Table::new());
+            }
+            let variable = format!("import_header_{}", headers.len());
+            let mut entry = InlineTable::new();
+            entry.insert(
+                "secret",
+                reference(own, &format!("header-{}", headers.len())).into(),
+            );
+            doc["variables"][&variable] = value(entry);
+            format!("{{{{{variable}}}}}")
+        } else {
+            text
+        };
+        headers.push(format!(
+            "{}{name}: {text}",
+            if disabled(row)? { "# " } else { "" }
+        ));
+    }
+    fields.headers = headers.join("\n");
+    fields.query = parameter_rows(source, "parameters")?;
+    body(source, &mut fields)?;
+    auth(source, inherited, own, &fields.headers, &mut doc)?;
+    fields.settings = if doc.is_empty() {
+        String::new()
+    } else {
+        doc.to_string()
+    };
+    document::check(&fields).map_err(|_| ResourceProblem::Fields)?;
+    Ok(fields)
+}
+
+fn walk(
+    items: &[Value],
+    parent: &str,
+    depth: usize,
+    export: &mut Export,
+    folders: &mut usize,
+    inherited: Option<(&Value, &str)>,
+    refused: bool,
+) -> Result<(), ExportProblem> {
+    if depth > MAX_FOLDER_DEPTH || export.requests.len() + *folders + items.len() > MAX_RESOURCES {
+        return Err(ExportProblem::Limit);
+    }
+    for item in items {
+        if let Some(children) = item.get("children") {
+            *folders += 1;
+            let relative = format!(
+                "{parent}/folder-{:04}-{}",
+                *folders,
+                slug(&label(item, "folder"))
+            );
+            let auth_type = item
+                .get("authentication")
+                .and_then(|v| v.get("type"))
+                .and_then(Value::as_str);
+            let refuse = refused
+                || (inherited.is_some() && auth_type == Some("none"))
+                || !keys(item, &["name", "meta", "children", "authentication"])
+                || !children.is_array();
+            let own = reference(&export.source_sha256, &format!("folder-auth/{relative}"));
+            let auth = item
+                .get("authentication")
+                .filter(|_| auth_type != Some("none"))
+                .map(|v| (v, own.as_str()))
+                .or(inherited);
+            if let Some(children) = children.as_array() {
+                walk(
+                    children,
+                    &relative,
+                    depth + 1,
+                    export,
+                    folders,
+                    auth,
+                    refuse,
+                )?;
+            }
+        } else {
+            let relative = format!(
+                "{parent}/request-{:04}-{}{}",
+                export.requests.len() + 1,
+                slug(&label(item, "request")),
+                super::project::REQUEST_SUFFIX
+            );
+            let own = reference(&export.source_sha256, &format!("request-auth/{relative}"));
+            let result = if relative.len() > super::project::MAX_PATH {
+                Err(ResourceProblem::Path)
+            } else if refused {
+                Err(ResourceProblem::Folder)
+            } else {
+                request(item, inherited, &own)
+            };
+            export
+                .requests
+                .push((label(item, "Request"), relative, result));
+        }
+    }
+    Ok(())
+}
+
+fn scalar(v: &Value) -> Result<String, ResourceProblem> {
+    match v {
+        Value::String(s) => Ok(s.clone()),
+        Value::Bool(_) | Value::Number(_) => Ok(v.to_string()),
+        Value::Null => Ok(String::new()),
+        _ => Err(ResourceProblem::Environment),
+    }
+}
+
+fn environment_data(v: &Value) -> Result<BTreeMap<String, Value>, ResourceProblem> {
+    if !keys(v, &["name", "meta", "data", "subEnvironments"]) {
+        return Err(ResourceProblem::Fields);
+    }
+    match v.get("data") {
+        None => Ok(BTreeMap::new()),
+        Some(d) => Ok(d
+            .as_object()
+            .ok_or(ResourceProblem::Environment)?
+            .iter()
+            .map(|(k, v)| (k.clone(), v.clone()))
+            .collect()),
+    }
+}
+
+/// Expands `{{name}}` references between environment values (32 deep, no
+/// cycles, 1 MiB), refusing values derived from credentials.
+fn expand(
+    name: &str,
+    values: &BTreeMap<String, Value>,
+    visiting: &mut BTreeSet<String>,
+    memo: &mut BTreeMap<String, String>,
+) -> Result<String, ResourceProblem> {
+    if let Some(text) = memo.get(name) {
+        return Ok(text.clone());
+    }
+    if visiting.len() >= 32 || !visiting.insert(name.into()) {
+        return Err(ResourceProblem::Environment);
+    }
+    let raw = scalar(values.get(name).ok_or(ResourceProblem::Environment)?)?;
+    let text = translate(&raw)?;
+    let mut out = String::new();
+    let mut rest = text.as_str();
+    while let Some(start) = rest.find("{{") {
+        out.push_str(&rest[..start]);
+        let tail = &rest[start + 2..];
+        let end = tail.find("}}").ok_or(ResourceProblem::Template)?;
+        let dependency = &tail[..end];
+        if credential_name(dependency) {
+            return Err(ResourceProblem::Credential);
+        }
+        out.push_str(&expand(dependency, values, visiting, memo)?);
+        if out.len() > ENVIRONMENT_BYTES {
+            return Err(ResourceProblem::Environment);
+        }
+        rest = &tail[end + 2..];
+    }
+    out.push_str(rest);
+    visiting.remove(name);
+    memo.insert(name.into(), out.clone());
+    Ok(out)
+}
+
+fn render(
+    values: &BTreeMap<String, Value>,
+    digest: &str,
+    scope: &str,
+) -> Result<String, ResourceProblem> {
+    let mut doc = DocumentMut::new();
+    doc["format_version"] = value(1);
+    doc["variables"] = Item::Table(Table::new());
+    let mut visiting = BTreeSet::new();
+    let mut memo = BTreeMap::new();
+    for key in values.keys() {
+        if !document::valid_variable(key) {
+            return Err(ResourceProblem::Environment);
+        }
+        if credential_name(key) {
+            let mut entry = InlineTable::new();
+            entry.insert(
+                "secret",
+                reference(digest, &format!("environment/{scope}/{key}")).into(),
+            );
+            doc["variables"][key.as_str()] = value(entry);
+        } else {
+            let text = expand(key, values, &mut visiting, &mut memo)?;
+            doc["variables"][key.as_str()] = value(text);
+        }
+    }
+    let text = doc.to_string();
+    if text.len() > ENVIRONMENT_BYTES {
+        return Err(ResourceProblem::Environment);
+    }
+    Ok(text)
+}
+
+fn environments(source: Option<&Value>, export: &mut Export) -> Result<(), ExportProblem> {
+    let Some(source) = source else { return Ok(()) };
+    let add = |source: &Value,
+               values: Result<BTreeMap<String, Value>, ResourceProblem>,
+               scope: &str,
+               export: &mut Export| {
+        let relative = format!(
+            "environments/insomnia-env-{}-{}.toml",
+            export.environments.len() + 1,
+            slug(&label(source, "environment"))
+        );
+        let digest = export.source_sha256.clone();
+        let result = values.and_then(|v| render(&v, &digest, scope));
+        export
+            .environments
+            .push((label(source, "Environment"), relative, result));
+    };
+    let base = environment_data(source);
+    add(source, base.clone(), "base", export);
+    if let Some(children) = source.get("subEnvironments") {
+        let children = children.as_array().ok_or(ExportProblem::Structure)?;
+        if children.len() > MAX_ENVIRONMENTS {
+            return Err(ExportProblem::Limit);
+        }
+        for (index, child) in children.iter().enumerate() {
+            let nested = child
+                .get("subEnvironments")
+                .is_some_and(|v| !v.as_array().is_some_and(Vec::is_empty));
+            let values = if nested {
+                Err(ResourceProblem::Environment)
+            } else {
+                base.clone().and_then(|mut values| {
+                    values.extend(environment_data(child)?);
+                    Ok(values)
+                })
+            };
+            add(child, values, &format!("sub-{index}"), export);
+        }
+    }
+    Ok(())
+}
+
+/// Reads an export (data only; nothing is created here).
+pub fn parse(text: &str) -> Result<Export, ExportProblem> {
+    let value = bounded(text)?;
+    if value.get("type").and_then(Value::as_str) != Some("collection.insomnia.rest/5.0")
+        || value.get("schema_version").and_then(Value::as_str) != Some("5.1")
+    {
+        return Err(ExportProblem::Version);
+    }
+    if !keys(
+        &value,
+        &[
+            "type",
+            "schema_version",
+            "name",
+            "meta",
+            "collection",
+            "cookieJar",
+            "environments",
+        ],
+    ) {
+        return Err(ExportProblem::Structure);
+    }
+    let mut export = Export {
+        source_sha256: hex::encode(Sha256::digest(text.as_bytes())),
+        collection: label(&value, "Collection"),
+        requests: Vec::new(),
+        environments: Vec::new(),
+    };
+    let items = value
+        .get("collection")
+        .and_then(Value::as_array)
+        .ok_or(ExportProblem::Structure)?;
+    let mut folders = 0;
+    walk(items, "insomnia", 0, &mut export, &mut folders, None, false)?;
+    environments(value.get("environments"), &mut export)?;
+    Ok(export)
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    const EXPORT: &str = r#"type: collection.insomnia.rest/5.0
+schema_version: "5.1"
+name: Sample
+collection:
+  - name: Items
+    authentication:
+      type: bearer
+      token: "{{ _.token }}"
+    children:
+      - name: List items
+        method: GET
+        url: "{{ _.base }}/items"
+        headers:
+          - name: X-Api-Key
+            value: literal-secret-value
+        parameters:
+          - name: limit
+            value: "10"
+      - name: Script
+        method: GET
+        url: https://a.example/
+        scripts:
+          preRequest: "alert(1)"
+  - name: Create
+    method: POST
+    url: https://a.example/items
+    body:
+      mimeType: application/json
+      text: '{"name": "{{ _.name }}"}'
+environments:
+  name: Base
+  data:
+    base: https://a.example
+    token: also-secret
+  subEnvironments:
+    - name: Prod
+      data:
+        base: https://prod.example
+"#;
+
+    #[test]
+    fn converts_supported_requests_and_refuses_scripts() {
+        let export = parse(EXPORT).expect("fixture");
+        assert_eq!(export.requests.len(), 3);
+        let (_, relative, list) = &export.requests[0];
+        assert_eq!(
+            relative,
+            "insomnia/folder-0001-items/request-0001-list-items.request.toml"
+        );
+        let list = list.as_ref().expect("fixture");
+        assert_eq!(list.url, "{{base}}/items");
+        assert!(list.headers.contains("X-Api-Key: {{import_header_0}}"));
+        assert!(list.settings.contains("kind = \"bearer\""));
+        assert_eq!(list.query, "limit=10");
+        assert_eq!(export.requests[1].2, Err(ResourceProblem::Fields));
+        assert_eq!(
+            export.requests[2].2.as_ref().expect("fixture").body_kind,
+            "json"
+        );
+        let text = format!("{export:?}");
+        assert!(!text.contains("literal-secret-value") && !text.contains("also-secret"));
+        let prod = export.environments[1].2.as_ref().expect("fixture");
+        assert!(prod.contains("base = \"https://prod.example\""));
+        assert!(prod.contains("token = { secret = \"import-"));
+    }
+
+    #[test]
+    fn refuses_other_formats_and_oversized_structures() {
+        assert_eq!(
+            parse("type: other\n").map(|_| ()),
+            Err(ExportProblem::Version)
+        );
+        assert_eq!(parse("a: [").map(|_| ()), Err(ExportProblem::Unreadable));
+        assert_eq!(
+            parse("a: 1\na: 2\n").map(|_| ()),
+            Err(ExportProblem::Unreadable)
+        );
+        let bomb = "a: &a [x,x,x,x,x,x,x,x,x,x]\nb: &b [*a,*a,*a,*a,*a,*a,*a,*a,*a,*a]\nc: &c [*b,*b,*b,*b,*b,*b,*b,*b,*b,*b]\nd: &d [*c,*c,*c,*c,*c,*c,*c,*c,*c,*c]\ne: [*d,*d,*d,*d,*d,*d,*d,*d,*d,*d]\n";
+        assert_eq!(parse(bomb).map(|_| ()), Err(ExportProblem::Unreadable));
+        assert_eq!(
+            parse(&" ".repeat(EXPORT_BYTES + 1)).map(|_| ()),
+            Err(ExportProblem::TooLarge)
+        );
+        let extra = "type: collection.insomnia.rest/5.0\nschema_version: \"5.1\"\ncollection: []\nplugins: []\n";
+        assert_eq!(parse(extra).map(|_| ()), Err(ExportProblem::Structure));
+    }
+
+    #[test]
+    fn templates_other_than_simple_variables_are_refused() {
+        assert_eq!(
+            translate("{{ _.a }}/{{b}}").expect("fixture"),
+            "{{a}}/{{b}}"
+        );
+        assert_eq!(translate("{% now %}"), Err(ResourceProblem::Template));
+        assert_eq!(translate("{{ a | upper }}"), Err(ResourceProblem::Template));
+        assert_eq!(translate("{{ a"), Err(ResourceProblem::Template));
+    }
+}
