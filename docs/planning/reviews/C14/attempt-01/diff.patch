+            {collection.secrets.map((s, i) =>
+                s.managed ? (
+                    <p key={s.reference}>
+                        <span className='font-mono'>{s.reference}</span>: managed by the tenant in Settings (resolved only by tenant authority when sending
+                        arrives).
+                    </p>
