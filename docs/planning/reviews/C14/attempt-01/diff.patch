+    )
+    .expect("fixture");
+    let r = desk
+        .wb(json!({"kind": "save", "id": "list", "revision": doc["revision"], "fields": mine}))
+        .await;
+    assert_eq!(
+        r,
+        json!({"kind": "saveRefused", "refusal": {"kind": "conflict"}})
