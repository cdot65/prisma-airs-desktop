724:     const startRead = (tid, isFresh, name) => { if (this._rt && this._rt[tid]) return; this._rt = this._rt || {}; this._rt[tid] = setTimeout(() => { delete this._rt[tid]; const st2 = this.state || {}; const T2 = st2.byTenant || {}; const t2 = T2[tid] || {}; const n = (t2.reads || 0) + 1; const at = '07:' + String(42 + n * 3).padStart(2, '0'); const x = (st2.added || []).find((y) => y.id === tid); const nw = x ? Object.keys(x.warnings || {}).filter((k) => !(t2.warnCleared || {})[k]).length : 0;
801:     const switchPatch = (id, x) => { const okP = (pid) => !x.products || x.products.indexOf(pid) >= 0; const firstP = (PRODUCTS.find((p) => okP(p.id)) || {}).id || null; return Object.assign({}, close, (dec === 'pending' && hasConvoEarly) ? tPatch(archiveActive()) : {}, { tenant: id, guard: null, review: false, reviewApplied: false, sheet: false, typed: '', reviewTenant: null, sel: null, detail: null, casePage: 0, ncOpen: false, credOpen: false, packsOpen: false,
804:     const requestSwitch = (id) => { if (id === cur.id) return set({ tenantOpen: false, overlayDone: true }); if (guarded) return set({ guard: id, tenantOpen: false, overlayDone: true }); switchTo(id); };
