//! Fixture native builds for acceptance (`native-prepare`) and the `native`
//! gate that requires an actual acceptance record for the prepared bytes.

use std::path::{Path, PathBuf};

use serde::{Deserialize, Serialize};

use crate::env::Environment;
use crate::evidence::NativeAcceptance;
use crate::fingerprint;
use crate::manifest::Manifest;
use crate::runner::Artifact;
use crate::{Repo, Result, Subject, invalid, io_err, now_utc, read_json, sha256_hex, write_json};

pub const FIXTURE_IDENTIFIER: &str = "io.cdot.prisma-airs-desktop.v2.fixture";
pub const PRODUCTION_IDENTIFIER: &str = "io.cdot.prisma-airs-desktop.v2";
const EXECUTABLE: &str = "prisma-airs-desktop-v2";

#[derive(Clone, Debug, PartialEq, Eq, Serialize, Deserialize)]
#[serde(deny_unknown_fields)]
pub struct Prepared {
    pub subject: String,
    pub built_utc: String,
    pub bundle: String,
    pub identifier: String,
    pub executable_sha256: String,
    pub bundle_sha256: String,
    pub features: Vec<String>,
    pub target: String,
    pub commands: Vec<Vec<String>>,
}

fn run(env: &Environment, repo: &Repo, argv: &[&str]) -> Result<()> {
    let argv: Vec<String> = argv.iter().map(|s| (*s).to_owned()).collect();
    let status = env
        .command(&argv, repo.root())?
        .status()
        .map_err(io_err(repo.root()))?;
    if status.success() {
        Ok(())
    } else {
        Err(invalid(format!("{} failed with {status}", argv.join(" "))))
    }
}

/// The fixed fixture build commands (frontend then Tauri app bundle).
pub fn build_commands(target: &str) -> Vec<Vec<&str>> {
    vec![
        vec!["pnpm", "--filter", "@prisma-airs/desktop", "build"],
        vec![
            "pnpm",
            "--filter",
            "@prisma-airs/desktop",
            "exec",
            "tauri",
            "build",
            "--ci",
            "--no-sign",
            "--target",
            target,
            "--bundles",
            "app",
            "--features",
            "test-fixtures",
            "--config",
            "src-tauri/tauri.fixture.conf.json",
            // The sealed Harness engine as a bundle resource (C19, D046).
            "--config",
            "src-tauri/tauri.harness.conf.json",
        ],
    ]
}

pub fn bundle_path(repo: &Repo, target: &str, product: &str) -> PathBuf {
    repo.join(format!(
        "target/{target}/release/bundle/macos/{product}.app"
    ))
}

pub fn plist_value(bundle: &Path, key: &str) -> Result<String> {
    let plist = bundle.join("Contents/Info.plist");
    let output = std::process::Command::new("/usr/bin/plutil")
        .args(["-extract", key, "raw", "-o", "-"])
        .arg(&plist)
        .env_clear()
        .output()
        .map_err(io_err(&plist))?;
    if !output.status.success() {
        return Err(invalid(format!(
            "cannot read {key} from {}",
            plist.display()
        )));
    }
    Ok(String::from_utf8_lossy(&output.stdout).trim().to_owned())
}

pub fn prepare(
    repo: &Repo,
    manifest: &Manifest,
    env: &Environment,
    subject: Subject,
    target: &str,
    features: &[String],
) -> Result<Prepared> {
    if target != manifest.target {
        return Err(invalid(format!(
            "target {target} is not the manifest target {}",
            manifest.target
        )));
    }
    if features != manifest.fixture_only_features.as_slice() {
        return Err(invalid(
            "native-prepare requires exactly the fixture-only features",
        ));
    }
    // The sealed engine the fixture configuration bundles (C19).
    crate::harness::unpack(repo)?;
    let commands = build_commands(target);
    for argv in &commands {
        run(env, repo, argv)?;
    }
    let bundle = bundle_path(repo, target, "Prisma AIRS Desktop v2 Fixture");
    let identifier = plist_value(&bundle, "CFBundleIdentifier")?;
    if identifier != FIXTURE_IDENTIFIER {
        return Err(invalid(format!(
            "fixture bundle has identifier {identifier}"
        )));
    }
    let executable = bundle.join("Contents/MacOS").join(EXECUTABLE);
    let bytes = std::fs::read(&executable).map_err(io_err(&executable))?;
    let prepared = Prepared {
        subject: subject.to_string(),
        built_utc: now_utc(),
        bundle: bundle
            .strip_prefix(repo.root())
            .unwrap_or(&bundle)
            .display()
            .to_string(),
        identifier,
        executable_sha256: sha256_hex(&bytes),
        bundle_sha256: fingerprint::tree_hash(&bundle)?,
        features: features.to_vec(),
        target: target.to_owned(),
        commands: commands
            .iter()
            .map(|argv| argv.iter().map(|s| (*s).to_owned()).collect())
            .collect(),
    };
    write_json(
        &repo.evidence_dir(subject).join("native-prepare.json"),
        &prepared,
    )?;
    Ok(prepared)
}

/// The prepared bundle as it exists now.
#[derive(Clone, Debug, PartialEq, Eq)]
pub struct CurrentBundle {
    pub executable_sha256: Option<String>,
    pub bundle_sha256: Option<String>,
    pub identifier: Option<String>,
}

pub fn current_state(repo: &Repo, prepared: &Prepared) -> CurrentBundle {
    let bundle = repo.join(&prepared.bundle);
    CurrentBundle {
        executable_sha256: std::fs::read(bundle.join("Contents/MacOS").join(EXECUTABLE))
            .ok()
            .map(|bytes| sha256_hex(&bytes)),
        bundle_sha256: bundle
            .is_dir()
            .then(|| fingerprint::tree_hash(&bundle).ok())
            .flatten(),
        identifier: plist_value(&bundle, "CFBundleIdentifier").ok(),
    }
}

/// Artifact entries recorded on the native-prepare run.
pub fn artifacts(repo: &Repo, subject: Subject) -> Result<Vec<Artifact>> {
    let prepared: Prepared = read_json(&repo.evidence_dir(subject).join("native-prepare.json"))?;
    Ok(vec![
        Artifact {
            name: "fixture-executable".to_owned(),
            path: format!("{}/Contents/MacOS/{EXECUTABLE}", prepared.bundle),
            sha256: prepared.executable_sha256,
        },
        Artifact {
            name: "fixture-bundle".to_owned(),
            path: prepared.bundle,
            sha256: prepared.bundle_sha256,
        },
    ])
}

/// Reasons the subject's native acceptance is not yet established for the
/// executable just prepared (the evidence index here is the evidence
/// directory as it exists now; review binds it by hash).
pub fn acceptance_status(
    repo: &Repo,
    manifest: &Manifest,
    subject: Subject,
    executable_sha256: &str,
) -> Vec<String> {
    if manifest.docs_only(subject) {
        // D058: nothing native to accept for a documentation-only chunk.
        return Vec::new();
    }
    let path = repo.evidence_dir(subject).join("native-acceptance.json");
    let Ok(bytes) = std::fs::read(&path) else {
        return vec![format!(
            "blocked: {} is missing; record actual CUA/operator native acceptance for executable {executable_sha256}",
            path.display()
        )];
    };
    let members = match manifest.native_members(subject) {
        Ok(members) => members,
        Err(e) => return vec![e.to_string()],
    };
    let (required_checks, fixture_identifier) = match crate::evidence::required_checks(
        &repo.join("docs/architecture/native-checks.json"),
        &members,
    ) {
        Ok(found) => found,
        Err(e) => return vec![e.to_string()],
    };
    let mut evidence_files = std::collections::BTreeSet::new();
    let mut stack = vec![repo.evidence_dir(subject)];
    while let Some(dir) = stack.pop() {
        for entry in std::fs::read_dir(&dir)
            .into_iter()
            .flatten()
            .filter_map(|e| e.ok())
        {
            let p = entry.path();
            if p.is_dir() {
                stack.push(p);
            } else if let Ok(rel) = p.strip_prefix(repo.root()) {
                evidence_files.insert(rel.display().to_string());
            }
        }
    }
    let prepared: Option<Prepared> =
        read_json(&repo.evidence_dir(subject).join("native-prepare.json")).ok();
    let current = prepared.as_ref().map(|p| current_state(repo, p));
    let expect = crate::evidence::NativeExpectation {
        required_checks,
        fixture_identifier,
        prepared_executable_sha256: executable_sha256.to_owned(),
        prepared_bundle: prepared.as_ref().map(|p| p.bundle.clone()),
        prepared_bundle_sha256: prepared.as_ref().map(|p| p.bundle_sha256.clone()),
        prepared_identifier: prepared.as_ref().map(|p| p.identifier.clone()),
        current_executable_sha256: current.as_ref().and_then(|c| c.executable_sha256.clone()),
        current_bundle_sha256: current.as_ref().and_then(|c| c.bundle_sha256.clone()),
        current_identifier: current.and_then(|c| c.identifier),
        evidence_files,
    };
    match NativeAcceptance::parse(&bytes) {
        Ok(record) => record.failures(&subject.to_string(), &expect),
        Err(e) => vec![e.to_string()],
    }
}
//! The append-only completion ledger, generations and predecessor rules.
//!
//! `complete` is a read-only validation of the current inputs against a
//! review receipt followed by one appended line. Lines are never edited.
//! Each subject's completions carry a generation; `reopen` appends an
//! invalidation for the subject's current generation and for every later
//! completed subject, after which a new review completes a new generation.
//! A subject counts as complete only when its latest generation has a
//! completion, a commit bound to the same receipt, no invalidation, and a
//! receipt file whose bytes still match the ledger.
//!
//! Owner acceptance (D032): the owner may accept a review below the 9/10
//! threshold. `complete --owner-accept REASON` then accepts the newest
//! receipt only if every score is at least [`OWNER_MINIMUM_SCORE`], it has no
//! blockers, and nothing but the threshold (scores, required fixes, evidence
//! gaps, the recommendation) fails: the packet, verdict, transport,
//! fingerprints, runs and native evidence must all still check. The completion records the reason and every accepted
//! failure; verdicts are never edited.

use std::io::Write;
use std::path::{Path, PathBuf};
use std::process::Command;

use serde::{Deserialize, Serialize};

use crate::evidence;
use crate::fingerprint::{self, Fingerprints};
use crate::gate::{self, NativeBase, Receipt};
use crate::manifest::{Command as PlannedCommand, Manifest};
use crate::native::{self, Prepared};
use crate::runner::RunKind;
use crate::{Repo, Result, Subject, invalid, io_err, now_utc, read_json, sha256_hex};

#[derive(Clone, Debug, PartialEq, Eq, Serialize, Deserialize)]
#[serde(tag = "kind", rename_all = "lowercase", deny_unknown_fields)]
pub enum Entry {
    Completion {
        subject: String,
        generation: u32,
        receipt_id: String,
        receipt: String,
        receipt_sha256: String,
        fingerprints: Fingerprints,
        completed_utc: String,
        #[serde(default, skip_serializing_if = "Option::is_none")]
        owner_acceptance: Option<OwnerAcceptance>,
    },
    Commit {
        subject: String,
        generation: u32,
        receipt_id: String,
        commit: String,
        tree: String,
        source: String,
        verified_utc: String,
    },
    Invalidation {
        subject: String,
        generation: u32,
        reason: String,
        invalidated_utc: String,
    },
}

/// The lowest score an owner may accept (D032); since D034 the chunk gate.
pub const OWNER_MINIMUM_SCORE: u8 = 8;

/// Whether `subject`'s current completion was accepted below the threshold
/// (D032/D034): such a chunk must be raised to a passing review before its
/// phase completes.
pub fn owner_accepted(entries: &[Entry], subject: Subject) -> bool {
    matches!(
        latest_completion(entries, subject),
        Some(Entry::Completion {
            owner_acceptance: Some(_),
            ..
        })
    )
}

/// The owner's acceptance of a review below the threshold, as recorded.
#[derive(Clone, Debug, PartialEq, Eq, Serialize, Deserialize)]
#[serde(deny_unknown_fields)]
pub struct OwnerAcceptance {
    pub decision: String,
    pub reason: String,
    pub minimum_score: u8,
    pub accepted_failures: Vec<String>,
}

/// The gate failures an owner may accept for `receipt` (the threshold
/// alone), or why it cannot be accepted.
pub fn owner_acceptable(
    receipt: &Receipt,
    failures: &[String],
) -> std::result::Result<Vec<String>, String> {
    let named = receipt.scores.named();
    if let Some((name, score)) = named.iter().find(|(_, s)| *s < OWNER_MINIMUM_SCORE) {
        return Err(format!(
            "score {name}={score} is below the owner minimum {OWNER_MINIMUM_SCORE}"
        ));
    }
    if receipt.blockers > 0 {
        return Err("blockers remain".to_owned());
    }
    let mut threshold: Vec<String> = named
        .iter()
        .filter(|(_, s)| *s < gate::MINIMUM_SCORE)
        .map(|(name, s)| format!("score {name}={s} is below {}", gate::MINIMUM_SCORE))
        .collect();
    if receipt.required_fixes > 0 {
        threshold.push(format!("{} required fixes remain", receipt.required_fixes));
    }
    if receipt.evidence_gaps > 0 {
        threshold.push(format!("{} evidence gaps remain", receipt.evidence_gaps));
    }
    threshold.push("reviewer recommendation is fail".to_owned());
    let other: Vec<&String> = failures.iter().filter(|f| !threshold.contains(f)).collect();
    if !other.is_empty() {
        return Err(format!(
            "failures other than the threshold remain: {}",
            other
                .iter()
                .map(|f| f.as_str())
                .collect::<Vec<_>>()
                .join("; ")
        ));
    }
    Ok(failures.to_vec())
}

pub fn read_ledger(path: &Path) -> Result<Vec<Entry>> {
    let Ok(text) = std::fs::read_to_string(path) else {
        return Ok(Vec::new());
    };
    text.lines()
        .filter(|l| !l.trim().is_empty())
        .map(|l| {
            serde_json::from_str(l)
                .map_err(|e| invalid(format!("corrupt completion ledger line: {e}")))
        })
        .collect()
}

fn append(path: &Path, entry: &Entry) -> Result<()> {
    let line = serde_json::to_string(entry).map_err(|e| invalid(e.to_string()))?;
    if let Some(parent) = path.parent() {
        std::fs::create_dir_all(parent).map_err(io_err(parent))?;
    }
    let mut file = std::fs::OpenOptions::new()
        .create(true)
        .append(true)
        .open(path)
        .map_err(io_err(path))?;
    writeln!(file, "{line}").map_err(io_err(path))
}

/// The latest completion generation of a subject and its entry.
fn latest_completion(entries: &[Entry], subject: Subject) -> Option<&Entry> {
    let id = subject.to_string();
    entries
        .iter()
        .filter(|e| matches!(e, Entry::Completion { subject, .. } if *subject == id))
        .max_by_key(|e| match e {
            Entry::Completion { generation, .. } => *generation,
            _ => 0,
        })
}

fn highest_generation(entries: &[Entry], subject: Subject) -> u32 {
    let id = subject.to_string();
    entries
        .iter()
        .filter_map(|e| match e {
            Entry::Completion {
                subject,
                generation,
                ..
            } if *subject == id => Some(*generation),
            _ => None,
        })
        .max()
        .unwrap_or(0)
}

/// Why `subject` is not currently complete (empty when it is).
pub fn completion_problems(repo: &Repo, entries: &[Entry], subject: Subject) -> Vec<String> {
    let id = subject.to_string();
    let Some(Entry::Completion {
        generation,
        receipt_id,
        receipt,
        receipt_sha256,
        owner_acceptance,
        ..
    }) = latest_completion(entries, subject)
    else {
        return vec![format!("{subject} has no completion")];
    };
    let mut problems = Vec::new();
    // Completion recognition applies the same rule as completion: a phase or
    // documentation-only chunk (D058) is never recognised through owner
    // acceptance, whatever the ledger line says.
    // The policy is fixed in `Subject` (D058), so recognition never depends on
    // loading a manifest and cannot fail open.
    let strict = subject.is_phase() || subject.is_docs_only();
    if strict && owner_acceptance.is_some() {
        problems.push(format!(
            "{subject} completion records owner acceptance, which {} does not allow",
            if subject.is_phase() { "D034" } else { "D058" }
        ));
    }
    let effective_owner = if strict {
        None
    } else {
        owner_acceptance.as_ref()
    };
    if entries.iter().any(|e| matches!(e, Entry::Invalidation { subject, generation: g, .. } if *subject == id && g == generation)) {
        problems.push(format!("{subject} generation {generation} was invalidated"));
    }
    let committed = entries.iter().any(|e| {
        matches!(e, Entry::Commit { subject, generation: g, receipt_id: r, .. } if *subject == id && g == generation && r == receipt_id)
    });
    if !committed {
        problems.push(format!(
            "{subject} generation {generation} has no verified commit"
        ));
    }
    match std::fs::read(repo.join(receipt)) {
        Err(_) => problems.push(format!("{subject} receipt {receipt} is missing")),
        Ok(bytes) => {
            if sha256_hex(&bytes) != *receipt_sha256 {
                problems.push(format!(
                    "{subject} receipt {receipt} was changed after completion"
                ));
            } else if let Ok(parsed) = serde_json::from_slice::<Receipt>(&bytes) {
                let minimum = if effective_owner.is_some() {
                    OWNER_MINIMUM_SCORE
                } else {
                    gate::MINIMUM_SCORE
                };
                let scores_ok = parsed.scores.named().iter().all(|(_, s)| *s >= minimum);
                let accepted = match effective_owner {
                    // Owner-accepted (D032): the threshold alone may fail.
                    Some(_) => scores_ok && parsed.blockers == 0,
                    None => {
                        parsed.passed
                            && scores_ok
                            && parsed.required_fixes + parsed.blockers + parsed.evidence_gaps == 0
                    }
                };
                if !accepted {
                    problems.push(format!(
                        "{subject} receipt does not record a passing review"
                    ));
                }
            } else {
                problems.push(format!("{subject} receipt is malformed"));
            }
        }
    }
    problems
}

pub fn is_completed(repo: &Repo, entries: &[Entry], subject: Subject) -> bool {
    completion_problems(repo, entries, subject).is_empty()
}

/// Subjects that must be complete (reviewed and committed) before `subject`.
pub fn predecessors(manifest: &Manifest, subject: Subject) -> Result<Vec<Subject>> {
    match subject {
        Subject::Chunk(1) => Ok(Vec::new()),
        Subject::Chunk(n) => {
            let mut required = vec![Subject::Chunk(n - 1)];
            let phase = manifest.phase_of(subject)?;
            let previous_phase = manifest.phase_of(Subject::Chunk(n - 1))?;
            if phase != previous_phase {
                required.push(previous_phase);
            }
            Ok(required)
        }
        Subject::Phase(_) => manifest.phase_chunks(subject),
    }
}

/// The historical planning gate C01 depends on (reviewed by Claude, D019).
pub fn g01_receipt(repo: &Repo) -> PathBuf {
    repo.join("docs/planning/reviews/G01/attempt-05/receipt.json")
}

pub fn check_g01(repo: &Repo) -> Result<()> {
    let receipt: serde_json::Value = read_json(&g01_receipt(repo))?;
    let passed = receipt.get("passed").and_then(|v| v.as_bool()) == Some(true);
    let scores_ok = receipt
        .get("scores")
        .and_then(|s| s.as_object())
        .is_some_and(|s| s.len() == 5 && s.values().all(|v| v.as_u64().is_some_and(|n| n >= 9)));
    if passed && scores_ok {
        Ok(())
    } else {
        Err(invalid(
            "historical G01 receipt does not record a passing design gate",
        ))
    }
}

pub fn require_predecessors(repo: &Repo, manifest: &Manifest, subject: Subject) -> Result<()> {
    if subject == Subject::Chunk(1) {
        return check_g01(repo);
    }
    let entries = read_ledger(&repo.completion_ledger())?;
    for required in predecessors(manifest, subject)? {
        let problems = completion_problems(repo, &entries, required);
        if !problems.is_empty() {
            return Err(invalid(format!(
                "{subject} requires {required}: {}",
                problems.join("; ")
            )));
        }
    }
    Ok(())
}

/// Every chunk and every phase needs check, test and native-prepare runs;
/// a phase's native evidence is for its integrated tree. A documentation-only
/// chunk (D058) has nothing to prepare natively and needs check and test only.
pub fn required_runs(manifest: &Manifest, subject: Subject) -> Vec<RunKind> {
    if manifest.docs_only(subject) {
        vec![RunKind::Check, RunKind::Test]
    } else {
        vec![RunKind::Check, RunKind::Test, RunKind::NativePrepare]
    }
}

/// Owner acceptance below the threshold (D034) applies to application
/// chunks only: phases and documentation-only chunks (D058) need the full
/// 9/10 gate.
pub fn owner_acceptance_allowed(manifest: &Manifest, subject: Subject) -> Result<()> {
    if subject.is_phase() {
        return Err(invalid(format!(
            "{subject} is a phase review: D034 requires 9/10 with no owner acceptance"
        )));
    }
    if manifest.docs_only(subject) {
        return Err(invalid(format!(
            "{subject} is a documentation-only chunk: D058 requires 9/10 in every dimension with no owner acceptance"
        )));
    }
    Ok(())
}

/// Approved command plans, one per required run kind.
pub type Plans = Vec<(RunKind, Vec<PlannedCommand>)>;

/// The approved command plans and native requirements for a subject.
pub fn expectations(
    repo: &Repo,
    manifest: &Manifest,
    subject: Subject,
) -> Result<(Plans, Option<NativeBase>)> {
    let plans = required_runs(manifest, subject)
        .into_iter()
        .map(|kind| Ok((kind, manifest.plan(subject, kind)?)))
        .collect::<Result<Vec<_>>>()?;
    if manifest.docs_only(subject) {
        return Ok((plans, None));
    }
    let members = manifest.native_members(subject)?;
    let (required_checks, fixture_identifier) =
        evidence::required_checks(&repo.join("docs/architecture/native-checks.json"), &members)?;
    let prepared =
        read_json::<Prepared>(&repo.evidence_dir(subject).join("native-prepare.json")).ok();
    let current = prepared.as_ref().map(|p| native::current_state(repo, p));
    Ok((
        plans,
        Some(NativeBase {
            required_checks,
            fixture_identifier,
            prepared_bundle: prepared.as_ref().map(|p| p.bundle.clone()),
            prepared_bundle_sha256: prepared.as_ref().map(|p| p.bundle_sha256.clone()),

