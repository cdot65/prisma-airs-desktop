ts-rs = { version = "=12.0.1", default-features = false, features = ["serde-compat", "no-serde-warnings"] }
sha2 = "=0.10.9"
hex = "=0.4.3"

[workspace.lints.rust]
# `deny`, not `forbid`: the fixture-only WebView capture module opts in locally.
unsafe_code = "deny"

[workspace.lints.clippy]
dbg_macro = "deny"
todo = "deny"
unwrap_used = "warn"

# The Harness verifies the 320 MiB engine's SHA-256 before every start (C19);
# unoptimized, that alone takes about ten seconds in test builds.
[profile.dev.package.sha2]
opt-level = 3

[profile.release]
lto = "thin"
codegen-units = 1
# No `strip`: on macOS 27 the stripped proc-macro dylibs fail dyld validation
# ("mis-aligned LINKEDIT string pool"). Release builds carry no debuginfo.
[toolchain]
channel = "1.99.0"
targets = ["aarch64-apple-darwin"]
components = ["rustfmt", "clippy"]
profile = "minimal"

