//! Adversarial tests for the C01 review/completion controller.
//!
//! Each case starts from a fully consistent passing attempt and breaks one
//! invariant. The valid baseline must pass, so every rejection below is caused
//! by the single mutation it names.

use std::path::{Path, PathBuf};
use std::process::Command;

use xtask::gate::{self, GateInputs, NativeBase, Receipt, fixtures};
use xtask::manifest::Manifest;
use xtask::runner::{self, RunKind, Status};
use xtask::verdict::Verdict;
use xtask::{Repo, Subject, complete, fingerprint, ledger, transport};

/// A named JSON mutation applied to an otherwise valid document.
type Mutation = (&'static str, Box<dyn Fn(&mut serde_json::Value)>);

fn sha(bytes: &[u8]) -> String {
    use sha2::{Digest, Sha256};
    hex::encode(Sha256::digest(bytes))
}

fn rejected(inputs: &GateInputs, needle: &str) {
    let failures = gate::evaluate(inputs);
    assert!(
        failures.iter().any(|f| f.contains(needle)),
        "expected a failure containing {needle:?}, got {failures:?}"
    );
}

fn with_verdict(edit: impl FnOnce(&mut Verdict)) -> GateInputs {
    let mut verdict = fixtures::verdict();
    edit(&mut verdict);
    fixtures::assemble(
        &verdict,
        &[
            fixtures::run(RunKind::Check),
            fixtures::run(RunKind::Test),
            fixtures::run(RunKind::NativePrepare),
        ],
        &fixtures::native(),
    )
}

fn receipt_of(inputs: &GateInputs) -> Receipt {
    serde_json::from_slice(&inputs.receipt_bytes).expect("receipt")
}

fn set_receipt(inputs: &mut GateInputs, receipt: &Receipt) {
    inputs.receipt_bytes = fixtures::to_bytes(receipt);
}

#[test]
fn consistent_attempt_passes() {
    assert_eq!(gate::evaluate(&fixtures::valid()), Vec::<String>::new());
}

#[test]
fn score_eight_in_any_dimension_is_rejected() {
    for dimension in [
        "architecture",
        "behavior",
        "authority_security",
        "validation",
        "overall",
    ] {
        let inputs = with_verdict(|v| match dimension {
            "architecture" => v.scores.architecture = 8,
            "behavior" => v.scores.behavior = 8,
            "authority_security" => v.scores.authority_security = 8,
            "validation" => v.scores.validation = 8,
            _ => v.scores.overall = 8,
        });
        rejected(&inputs, &format!("score {dimension}=8 is below 9"));
    }
}

#[test]
fn required_fix_blocker_or_gap_rejects_despite_nines() {
    rejected(
        &with_verdict(|v| v.required_fixes.push("fix".into())),
        "required fixes remain",
    );
    rejected(
        &with_verdict(|v| v.blockers.push("blocker".into())),
        "blockers remain",
    );
    rejected(
        &with_verdict(|v| v.evidence_gaps.push("gap".into())),
        "evidence gaps remain",
    );
    rejected(
        &with_verdict(|v| v.recommendation = xtask::verdict::Recommendation::Fail),
        "recommendation is fail",
    );
}

#[test]
fn malformed_verdicts_are_rejected() {
    let base = fixtures::valid();
    let mut value: serde_json::Value =
        serde_json::from_slice(base.verdict_bytes.as_ref().expect("verdict")).expect("json");
    let cases: Vec<Mutation> = vec![
        (
            "extra field",
            Box::new(|v| v["approved"] = serde_json::json!(true)),
        ),
        (
            "missing field",
            Box::new(|v| {
                v.as_object_mut().expect("object").remove("evidence_gaps");
            }),
        ),
        (
            "score out of range",
            Box::new(|v| v["scores"]["overall"] = serde_json::json!(11)),
        ),
        (
            "non-integer score",
            Box::new(|v| v["scores"]["overall"] = serde_json::json!(9.5)),
        ),
        (
            "string score",
            Box::new(|v| v["scores"]["overall"] = serde_json::json!("10")),
        ),
        (
            "unknown recommendation",
            Box::new(|v| v["recommendation"] = serde_json::json!("approve")),
        ),
    ];
    for (name, mutate) in cases {
        let mut broken = value.clone();
        mutate(&mut broken);
        let bytes = serde_json::to_vec_pretty(&broken).expect("bytes");
        let mut inputs = fixtures::valid();
        let mut receipt = receipt_of(&inputs);
        receipt.verdict_sha256 = sha(&bytes);
        set_receipt(&mut inputs, &receipt);
        inputs.verdict_bytes = Some(bytes);
        let failures = gate::evaluate(&inputs);
        assert!(
            failures
                .iter()
                .any(|f| f.contains("strict schema") || f.contains("outside 1..=10")),
            "{name}: {failures:?}"
        );
    }
    value["scores"]["overall"] = serde_json::json!(9);
}

#[test]
fn edited_verdict_after_receipt_is_rejected() {
    let mut inputs = fixtures::valid();
    let mut verdict: Verdict =
        serde_json::from_slice(inputs.verdict_bytes.as_ref().expect("verdict")).expect("parse");
    verdict.scores.overall = 10;
    inputs.verdict_bytes = Some(fixtures::to_bytes(&verdict));
    rejected(&inputs, "edited verdict");
}

#[test]
fn edited_packet_and_raw_output_are_rejected() {
    let mut inputs = fixtures::valid();
    inputs.packet_bytes.extend_from_slice(b" ");
    rejected(&inputs, "edited packet");

    let mut inputs = fixtures::valid();
    if let Some(raw) = inputs.raw_output_bytes.as_mut() {
        raw.extend_from_slice(b"forged");
    }
    rejected(&inputs, "raw reviewer output was edited");

    let mut inputs = fixtures::valid();
    inputs.raw_output_bytes = None;
    rejected(&inputs, "raw reviewer output is missing");
}

#[test]
fn queue_acknowledgement_without_verdict_is_rejected() {
    let mut inputs = fixtures::valid();
    inputs.verdict_bytes = None;
    rejected(&inputs, "submission is not review");
}

#[test]
fn mismatched_request_or_fingerprints_are_rejected() {
    rejected(
        &with_verdict(|v| v.request_id = "rq-other".into()),
        "request_id does not match",
    );
    rejected(
        &with_verdict(|v| v.attempt_id = "attempt-09".into()),
        "attempt_id does not match",
    );
    rejected(
        &with_verdict(|v| v.subject = "C02".into()),
        "subject does not match",
    );
    rejected(
        &with_verdict(|v| v.fingerprints.source = "0".repeat(64)),
        "differ from the frozen packet",
    );
}

#[test]
fn receipt_scores_must_match_the_verdict() {
    let mut inputs = fixtures::valid();
    let mut receipt = receipt_of(&inputs);
    receipt.scores.validation = 10;
    set_receipt(&mut inputs, &receipt);
    rejected(&inputs, "receipt scores differ from the verdict");
}

#[test]
fn stale_inputs_are_rejected() {
    let mut inputs = fixtures::valid();
    inputs.current.source = "9".repeat(64);
    rejected(&inputs, "source changed since review");

    let mut inputs = fixtures::valid();
    inputs.current.dependencies = "9".repeat(64);
    rejected(&inputs, "dependencies or toolchain changed");

    let mut inputs = fixtures::valid();
    inputs.current.build_flags = "9".repeat(64);
    rejected(&inputs, "build flags/features changed");

    let mut inputs = fixtures::valid();
    inputs.current.evidence = "9".repeat(64);
    })
}

/// The native acceptance record the packet binds. Every application chunk
/// and phase needs one; a documentation-only chunk (D058) has nothing native
/// to accept, which the packet states as a limitation instead of a fabricated
/// record. `native_pending` is the explicitly requested early review whose
/// missing record is stated to the reviewer and fails the gate by
/// construction.
pub fn native_acceptance_reference(
    repo: &Repo,
    manifest: &Manifest,
    subject: Subject,
    native_pending: Option<String>,
    limitations: &mut Vec<String>,
) -> Result<Option<HashedPath>> {
    if manifest.docs_only(subject) {
        limitations.push(format!(
            "{subject} is a documentation-only chunk (D058): no native preparation or acceptance applies; the gate requires 9/10 in every dimension with no owner acceptance"
        ));
        return Ok(None);
    }
    let native_path = repo.evidence_dir(subject).join("native-acceptance.json");
    if native_path.is_file() {
        return Ok(Some(hashed(repo, &native_path)?));
    }
    if let Some(reason) = native_pending {
        limitations.push(format!(
            "MANDATORY NATIVE ACCEPTANCE IS MISSING ({reason}); this attempt cannot pass the gate"
        ));
        return Ok(None);
    }
    Err(invalid(
        "native acceptance record is missing; mandatory native evidence is blocked, not optional",
    ))
}

/// Latest passing run of each required kind executed against `fingerprints`.
fn select_runs(
    repo: &Repo,
    subject: Subject,
    fingerprints: &Fingerprints,
) -> Result<(Vec<RunRef>, Option<String>)> {
    let runs = runner::load_runs(repo, subject)?;
    let manifest = Manifest::load(&repo.manifest())?;
    let mut selected = Vec::new();
    let mut executable = None;
    for kind in complete::required_runs(&manifest, subject) {
        let found = runs.iter().rev().find(|(_, r)| {
            r.kind == kind
                && r.status == Status::Passed
                && r.inputs_before.source == fingerprints.source
                && r.inputs_before.dependencies == fingerprints.dependencies
                && r.inputs_before.build_flags == fingerprints.build_flags
        });
        let Some((path, record)) = found else {
            return Err(invalid(format!(
                "no passing {kind:?} run against the current inputs; run it before requesting review"
            )));
        };
        if kind == RunKind::NativePrepare {
            executable = record
                .artifacts
                .iter()
                .find(|a| a.name == "fixture-executable")
                .map(|a| a.sha256.clone());
        }
        let bytes = std::fs::read(path).map_err(io_err(path))?;
        selected.push(RunRef {
            kind,
            run_id: record.run_id.clone(),
            path: rel(repo, path),
            sha256: sha256_hex(&bytes),
        });
    }
    Ok((selected, executable))
}

/// Hashes every evidence file for the subject outside `runs/` (run records
/// are bound individually through [`RunRef`]).
fn evidence_files(repo: &Repo, subject: Subject) -> Result<Vec<HashedPath>> {
    let dir = repo.evidence_dir(subject);
    let mut out = Vec::new();
    let mut stack = vec![dir.clone()];
    while let Some(current) = stack.pop() {
        let Ok(entries) = std::fs::read_dir(&current) else {
            continue;
        };
        for entry in entries.filter_map(|e| e.ok()) {
            let path = entry.path();
            if path.is_dir() {
                if path != dir.join("runs") {
                    stack.push(path);
                }
            } else {
                out.push(hashed(repo, &path)?);
            }
        }
    }
    out.sort_by(|a, b| a.path.cmp(&b.path));
    Ok(out)
        let receipt = entries.iter().rev().find_map(|e| match e {
            Entry::Completion {
                subject: s,
                receipt,
                ..
            } if *s == required.to_string() => Some(receipt.clone()),
            _ => None,
        });
        let receipt =
            receipt.ok_or_else(|| invalid(format!("{required} has no completion receipt")))?;
        refs.push(PredecessorRef {
            subject: required.to_string(),
            receipt: hashed(repo, &repo.join(receipt))?,
        });
    }
    Ok(refs)
}

pub struct Outcome {
    pub receipt: PathBuf,
    pub passed: bool,
    pub failures: Vec<String>,
}

pub fn review(
    repo: &Repo,
    manifest: &Manifest,
    env: &Environment,
    subject: Subject,
    choice: TransportChoice,
    limitations: Vec<String>,
    native_pending: Option<String>,
) -> Result<Outcome> {
    let mut limitations = limitations;
    complete::require_predecessors(repo, manifest, subject)?;
    fingerprint::verify_consumed_shared(repo)?;
    let reviewer = &manifest.reviewer;
    let codex = Codex::resolve(env, reviewer, repo.root())?;
    let fingerprints = fingerprint::all(repo, manifest, subject, &env.toolchain_hash())?;
    let (runs, executable) = select_runs(repo, subject, &fingerprints)?;
    let native_acceptance =
        native_acceptance_reference(repo, manifest, subject, native_pending, &mut limitations)?;
    let reviews = repo.reviews_dir(subject);
    expire_pending(&reviews, "superseded by a new review attempt")?;

    let mut choice = choice;
    loop {
        let (attempt_id, attempt_dir) = next_attempt(&reviews)?;
        let request_id = format!(
            "rq-{subject}-{}-{}",
            now_utc().replace([':', '-'], ""),
            random_hex(4)?
        );
        let inventory = fingerprint::source_inventory(repo)?;
        let inventory_path = attempt_dir.join("source-inventory.json");
        write_new(
            &inventory_path,
            &serde_json::to_vec_pretty(&inventory).unwrap_or_default(),
        )?;
        let base = base_commit(repo, subject)?;
        let diff = write_diff(repo, &base, &attempt_dir.join("diff.patch"))?;
        let (message_template, review_instructions, instruction_files) =
            instructions(repo, manifest, subject)?;
        let verdict_path = attempt_dir.join("verdict.json");
        let packet_path = attempt_dir.join("request.json");
        let packet = Packet {
            schema: gate::PACKET_SCHEMA.to_owned(),
            request_id: request_id.clone(),
            attempt_id: attempt_id.clone(),
            subject: subject.to_string(),
            kind: if subject.is_phase() { "phase" } else { "chunk" }.to_owned(),
            created_utc: now_utc(),
            repository: repo.root().display().to_string(),
            base_commit: base,
            scope: if subject.is_phase() {
                format!("cumulative phase review of {subject} and the earlier features it affects")
            } else {
                format!("implementation chunk {subject}")
            },
            instructions: instruction_files,
            predecessors: predecessor_refs(repo, manifest, subject)?,
            fingerprints: fingerprints.clone(),
            source_inventory: hashed(repo, &inventory_path)?,
            runs: runs.clone(),
            evidence_files: evidence_files(repo, subject)?,
            native_acceptance: native_acceptance.clone(),
            native_executable_sha256: executable.clone(),
            diff,
            limitations: limitations.clone(),
            verdict_schema: hashed(repo, &repo.verdict_schema())?,
            verdict_path: verdict_path.display().to_string(),
            review_instructions,
        };
        let packet_bytes =
            serde_json::to_vec_pretty(&packet).map_err(|e| invalid(e.to_string()))?;
        write_new(&packet_path, &packet_bytes)?;
        let message = message_template
            .replace("REQUEST_PACKET_PATH", &packet_path.display().to_string())
            .replace("VERDICT_PATH", &verdict_path.display().to_string());

        let use_thread = match choice {
            TransportChoice::Fresh => false,
            TransportChoice::Thread => true,
            TransportChoice::Auto => {
                match transport::handshake(
                    env,
                    reviewer,
                    repo.root(),
                    &repo.transport_dir(),
                    Duration::from_secs(300),
                ) {
                    Ok(route) => {
                        eprintln!("handshake confirmed: {}", route.display());
                        true
                    }
                    Err(error) => {
                        eprintln!("handshake failed ({error}); using a fresh Codex reviewer");
                        false
                    }
                }
            }
        };

        let submitted_utc = now_utc();
        let (kind, thread, raw_output, model, exit_code, timed_out) = if use_thread {
            let ack = transport::queue(env, reviewer, repo.root(), &message)?;
            write_json(&attempt_dir.join("queue-ack.json"), &ack)?;
            eprintln!(
                "submitted to thread {} ({}); waiting for verdict",
                reviewer.preferred_transport.thread, ack.stdout
            );
