[package]
name = "xtask"
version = "2.0.0"
description = "Build-time check, review and artifact controller for Prisma AIRS Desktop v2"
edition.workspace = true
rust-version.workspace = true
license.workspace = true
publish.workspace = true

[features]
default = []
# Exposes deterministic controller fixtures to its integration tests.
test-fixtures = []

[dependencies]
desktop-core = { path = "../desktop-core" }
serde.workspace = true
serde_json.workspace = true
sha2.workspace = true
hex.workspace = true
thiserror.workspace = true
# The controlled live runner (C25) drives the production core.
tokio = { workspace = true, features = ["rt", "rt-multi-thread", "time"] }
zeroize = { version = "=1.9.1", features = ["std"] }
url = "=2.5.8"

[dev-dependencies]
# Synthetic TLS endpoints for the live runner's fixture tests (already
# locked through desktop-core's tests).
tokio = { workspace = true, features = ["rt", "rt-multi-thread", "time", "macros", "net", "io-util"] }
rcgen = { version = "=0.14.10", default-features = false, features = ["aws_lc_rs", "pem"] }
rustls = { version = "=0.23.46", default-features = false, features = ["aws_lc_rs", "std", "tls12"] }
tokio-rustls = { version = "=0.26.6", default-features = false, features = ["aws_lc_rs", "tls12"] }
time = "=0.3.55"
# The workspace MCP plane fixture (shared with desktop-core's tests).
base64 = "=0.22.1"

[lints]
workspace = true

[[test]]
name = "shell_controller"
required-features = ["test-fixtures"]

[[test]]
name = "controlled_live"
required-features = ["test-fixtures"]

[[test]]
name = "signed_artifact"
required-features = ["test-fixtures"]

[[test]]
name = "live_run"
path = "tests/live_run/main.rs"
required-features = ["test-fixtures"]
[package]
name = "desktop-core"
version = "2.0.0"
description = "Prisma AIRS Desktop v2 application core: native authority, context and outcomes"
edition.workspace = true
rust-version.workspace = true
license.workspace = true
publish.workspace = true

[features]
default = []
# Deterministic fixtures for integration tests. Never enabled by shipping builds.
test-fixtures = ["dep:libc"]

[dependencies]
serde.workspace = true
serde_json.workspace = true
thiserror.workspace = true
tokio = { workspace = true, features = ["sync", "rt", "time", "macros"] }
ts-rs.workspace = true
sha2.workspace = true
hex.workspace = true
getrandom = "=0.4.3"
zeroize = { version = "=1.9.1", features = ["std"] }
# D027/D033: the published SDK, scan and management families, with the
# app-owned transport.
scm-sdk = { version = "=0.2.4", default-features = false, features = ["scan", "management", "red-team", "model-security", "agentguard", "gateway"] }
# DESIGN "Native transport policy": rustls with the platform verifier, explicit
# proxy modes, gzip only; redirects and retries are disabled per client.
reqwest = { version = "=0.13.5", default-features = false, features = ["rustls", "http2", "gzip", "stream", "system-proxy"] }
bytes = "=1.12.1"
http = "=1.5.0"
futures-util = { version = "=0.3.34", default-features = false, features = ["std"] }
url = "=2.5.8"
tokio-util = { version = "=0.7.20", default-features = false }
# Reviewed extra roots are validated as X.509 trust anchors before use.
rustls-pki-types = { version = "=1.15.1", features = ["std"] }
rustls-webpki = { version = "=0.103.15", default-features = false, features = ["std", "aws-lc-rs"] }
# The learner's avatar is decoded with bounds, oriented and re-encoded as a
# 512 px JPEG before upload and on readback (as v1 did); decoders only.
image = { version = "=0.25.10", default-features = false, features = ["png", "jpeg", "webp"] }
# Offline Academy work is sealed with XChaCha20-Poly1305 (v1's cipher crate).
chacha20poly1305 = { version = "=0.10.1", default-features = false, features = ["alloc"] }
# API Client projects (C14): v1's TOML project files edited in place with
# their comments and layout kept, and Insomnia v5 exports (YAML or JSON).
toml_edit = { version = "=0.25.17", default-features = false, features = ["parse", "display"] }
serde_yaml_ng = "=0.10.0"
# API Client execution (C15): Set-Cookie parsing for the bounded,
# host-only cookie jar (already locked through the desktop host).
cookie = { version = "=0.18.2", default-features = false }
# Harness company sign-in (C20, D047): verified JWT decoding with the
# aws-lc-rs provider the transport already ships; JWKs only (no PEM).
jsonwebtoken = { version = "=11.1.0", default-features = false, features = ["aws_lc_rs"] }
base64 = "=0.22.1"
# The fixture sidecar launcher's process group (test-fixtures only; already
# locked through tokio).
libc = { version = "=0.2.191", optional = true }

[dev-dependencies]
tokio = { workspace = true, features = ["sync", "macros", "rt", "rt-multi-thread", "net", "io-util", "time", "test-util"] }
# Synthetic TLS endpoints and proxies for the native transport contracts.
rcgen = { version = "=0.14.10", default-features = false, features = ["aws_lc_rs", "pem"] }
rustls = { version = "=0.23.46", default-features = false, features = ["aws_lc_rs", "std", "tls12"] }
tokio-rustls = { version = "=0.26.6", default-features = false, features = ["aws_lc_rs", "tls12"] }
flate2 = "=1.1.10"
time = "=0.3.55"

