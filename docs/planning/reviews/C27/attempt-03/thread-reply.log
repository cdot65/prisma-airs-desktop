//! The approved command manifest (`docs/architecture/checks.json`).
//!
//! Parsing is strict: unknown fields fail, every command is a non-empty argv
//! array whose program is on a fixed allowlist, and placeholders may appear
//! only where the controller substitutes validated values. Completion state is
//! never read from the manifest; it lives in the append-only ledger.

use std::collections::BTreeMap;
use std::path::Path;

use serde::Deserialize;

use crate::runner::RunKind;
use crate::{Result, Subject, invalid, read_json};

/// Programs a manifest command may start.
const PROGRAMS: [&str; 2] = ["cargo", "pnpm"];

pub type Argv = Vec<String>;

#[derive(Clone, Debug, Deserialize)]
#[serde(deny_unknown_fields)]
pub struct Manifest {
    pub schema_version: u32,
    pub status: String,
    pub target: String,
    pub fixture_only_features: Vec<String>,
    /// Materialize locked inputs before a run's fingerprint is taken.
    pub setup_commands: Vec<Argv>,
    pub common_commands: Vec<Argv>,
    pub controller: String,
    pub shared_source_commands: Vec<Argv>,
    pub artifact_build: Argv,
    pub chunks: BTreeMap<String, Chunk>,
    pub phases: BTreeMap<String, Vec<String>>,
    /// Integrated fixture build for a phase's cumulative native acceptance.
    pub phase_native_prepare: Argv,
    pub invariants: Vec<String>,
    pub requested_production_features: Vec<String>,
    pub effective_features: String,
    pub controller_commands: BTreeMap<String, Argv>,
    pub reviewer: Reviewer,
    pub shared_lifecycle_contract: String,
    pub shared_source_required_chunks: Vec<String>,
    pub shared_source_requirement: String,
    pub environment_contract: serde_json::Value,
}

#[derive(Clone, Debug, Deserialize)]
#[serde(deny_unknown_fields)]
pub struct Chunk {
    pub rust_target: String,
    pub fixture_command: Argv,
    pub native_prepare: Argv,
    pub native_acceptance: String,
    pub live_requirement: String,
    /// D058: a documentation-only chunk (C27) has no application change, so
    /// no native preparation or acceptance applies and owner acceptance below
    /// 9/10 is refused. Every other chunk keeps the full gate.
    #[serde(default)]
    pub docs_only: bool,
    #[serde(default)]
    pub frontend_commands: Vec<Argv>,
    #[serde(default)]
    pub host_commands: Vec<Argv>,
}

#[derive(Clone, Debug, Deserialize)]
#[serde(deny_unknown_fields)]
pub struct Reviewer {
    pub decision: String,
    pub identity: String,
    pub executable: String,
    pub verdict_schema: String,
    pub threshold: BTreeMap<String, u8>,
    pub preferred_transport: PreferredTransport,
    pub fallback_transport: FallbackTransport,
    pub wait: Wait,
    pub freeze: String,
    pub expiry: String,
}

#[derive(Clone, Debug, Deserialize)]
#[serde(deny_unknown_fields)]
pub struct PreferredTransport {
    pub kind: String,
    pub thread: String,
    pub argv: Argv,
    pub submit_timeout_seconds: u64,
    pub requires: String,
    pub forbidden: Vec<String>,
    pub note: String,
}

#[derive(Clone, Debug, Deserialize)]
#[serde(deny_unknown_fields)]
pub struct FallbackTransport {
    pub kind: String,
    pub argv: Argv,
    pub stdin: String,
    pub capture: Vec<String>,
    pub forbidden: Vec<String>,
}

#[derive(Clone, Debug, Deserialize)]
#[serde(deny_unknown_fields)]
pub struct Wait {
    pub poll_seconds: u64,
    pub max_wait_seconds: u64,
    pub progress_every_seconds: u64,
}

/// One concrete command the controller will run for a subject.
#[derive(Clone, Debug, PartialEq, Eq)]
pub struct Command {
    /// Stable label used in evidence (`common/3`, `fixture`, `host/1`, ...).
    pub label: String,
    pub argv: Argv,
    /// Whether the command must report at least one executed test.
    pub expects_tests: bool,
}

pub const DIMENSIONS: [&str; 5] = [
    "architecture",
    "behavior",
    "authority_security",
    "validation",
    "overall",
];

impl Manifest {
    pub fn load(path: &Path) -> Result<Self> {
        let manifest: Self = read_json(path)?;
        manifest.validate()?;
        Ok(manifest)
    }

    fn validate(&self) -> Result<()> {
        if self.schema_version != 1 {
            return Err(invalid("unsupported checks.json schema_version"));
        }
        if self.target != "aarch64-apple-darwin" {
            return Err(invalid("checks.json target must be aarch64-apple-darwin"));
        }
        for n in 1..=Subject::LAST_CHUNK {
            let id = Subject::Chunk(n).to_string();
            if !self.chunks.contains_key(&id) {
                return Err(invalid(format!("checks.json is missing chunk {id}")));
            }
        }
        if self.chunks.len() != usize::from(Subject::LAST_CHUNK) {
            return Err(invalid("checks.json must define exactly C01-C34"));
        }
        for (id, chunk) in &self.chunks {
            let fixed = Subject::parse(id)?.is_docs_only();
            if chunk.docs_only != fixed {
                return Err(invalid(format!(
                    "{id} docs_only must be {fixed}: the documentation-only policy (D058) is fixed in the controller and cannot be changed from checks.json"
                )));
            }
            if chunk.docs_only && !chunk.native_acceptance.starts_with("not applicable") {
                return Err(invalid(format!(
                    "{id} is docs_only but declares native acceptance; a documentation-only chunk states 'not applicable'"
                )));
            }
        }
        let mut phase_members = Vec::new();
        for n in 1..=Subject::LAST_PHASE {
            let id = Subject::Phase(n).to_string();
            let members = self
                .phases
                .get(&id)
                .ok_or_else(|| invalid(format!("checks.json is missing phase {id}")))?;
            phase_members.extend(members.iter().cloned());
        }
        let expected: Vec<String> = (1..=Subject::LAST_CHUNK)
            .map(|n| Subject::Chunk(n).to_string())
            .collect();
        if phase_members != expected || self.phases.len() != usize::from(Subject::LAST_PHASE) {
            return Err(invalid("phases must partition C01-C34 in order"));
        }
        for argv in self.all_static_commands() {
            check_argv(argv)?;
        }
        for (name, argv) in &self.controller_commands {
            check_argv(argv).map_err(|e| invalid(format!("controller command {name}: {e}")))?;
        }
        for dimension in DIMENSIONS {
            if self.reviewer.threshold.get(dimension) != Some(&9) {
                return Err(invalid(format!(
                    "reviewer threshold for {dimension} must be exactly 9 (D019/D026)"
                )));
            }
        }
        if self.reviewer.threshold.len() != DIMENSIONS.len() {
            return Err(invalid("reviewer threshold has unexpected dimensions"));
        }
        if self.reviewer.identity != "codex" {
            return Err(invalid("reviewer identity must be codex (D026)"));
        }
        self.check_transports()
    }

    fn check_transports(&self) -> Result<()> {
        let preferred = &self.reviewer.preferred_transport;
        let fallback = &self.reviewer.fallback_transport;
        for argv in [&preferred.argv, &fallback.argv] {
            if argv.first().map(String::as_str) != Some("{codex}") {
                return Err(invalid(
                    "reviewer argv must start with the resolved {codex}",
                ));
            }
        }
        let banned = |argv: &Argv, forbidden: &[String]| {
            argv.iter()
                .any(|a| forbidden.iter().any(|f| a == f || a.contains(f.as_str())))
        };
        if banned(&preferred.argv, &preferred.forbidden)
            || banned(&fallback.argv, &fallback.forbidden)
        {
            return Err(invalid("reviewer argv contains a forbidden flag"));
        }
        if !preferred
            .argv
            .windows(2)
            .any(|w| w[0] == "--thread" && w[1] == preferred.thread)
        {
            return Err(invalid("preferred transport must address its exact thread"));
        }
        for required in [
            "--sandbox",
            "read-only",
            "--ephemeral",
            "--ignore-user-config",
            "--ignore-rules",
            "--output-schema",
        ] {
            if !fallback.argv.iter().any(|a| a == required) {
                return Err(invalid(format!("fallback transport must pass {required}")));
            }
        }
        Ok(())
    }

    fn all_static_commands(&self) -> impl Iterator<Item = &Argv> {
        self.setup_commands
            .iter()
            .chain(self.common_commands.iter())
            .chain(self.shared_source_commands.iter())
            .chain(std::iter::once(&self.artifact_build))
            .chain(std::iter::once(&self.phase_native_prepare))
            .chain(self.chunks.values().flat_map(|c| {
                std::iter::once(&c.fixture_command)
                    .chain(std::iter::once(&c.native_prepare))
                    .chain(c.frontend_commands.iter())
                    .chain(c.host_commands.iter())
            }))
    }

    pub fn chunk(&self, subject: Subject) -> Result<&Chunk> {
        self.chunks
            .get(&subject.to_string())
            .ok_or_else(|| invalid(format!("no manifest entry for {subject}")))
    }

    /// Chunks belonging to a phase, in order.
    pub fn phase_chunks(&self, phase: Subject) -> Result<Vec<Subject>> {
        self.phases
            .get(&phase.to_string())
            .ok_or_else(|| invalid(format!("no phase {phase}")))?
            .iter()
            .map(|c| Subject::parse(c))
            .collect()
    }

    /// Chunks whose native checks a subject's acceptance must cover: the
    /// chunk itself, or every member of a phase.
    pub fn native_members(&self, subject: Subject) -> Result<Vec<String>> {
        if subject.is_phase() {
            Ok(self
                .phase_chunks(subject)?
                .iter()
                .filter(|c| !self.docs_only(**c))
                .map(Subject::to_string)
                .collect())
        } else if self.docs_only(subject) {
            Ok(Vec::new())
        } else {
            Ok(vec![subject.to_string()])
        }
    }

    /// Whether `subject` is a documentation-only chunk (D058): no native
    /// preparation or acceptance, no owner acceptance below the threshold.
    /// Phases are never documentation-only.
    pub fn docs_only(&self, subject: Subject) -> bool {
        // The policy is fixed in `Subject`; validation guarantees checks.json
        // agrees, so a manifest can neither widen nor disable it.
        subject.is_docs_only()
    }

    /// The phase containing a chunk.
    pub fn phase_of(&self, chunk: Subject) -> Result<Subject> {
        let id = chunk.to_string();
        self.phases
            .iter()
            .find(|(_, members)| members.contains(&id))
            .map(|(phase, _)| Subject::parse(phase))
            .ok_or_else(|| invalid(format!("{chunk} belongs to no phase")))?
    }

    pub fn requires_shared_source(&self, chunk: Subject) -> bool {
        self.shared_source_required_chunks
            .contains(&chunk.to_string())
    }

    /// Commands `check` runs for a chunk, in order.
    pub fn check_commands(&self, chunk: Subject) -> Vec<Command> {
        let mut commands: Vec<Command> = self
            .common_commands
            .iter()
            .enumerate()
            .map(|(i, argv)| Command {
                label: format!("common/{}", i + 1),
                argv: argv.clone(),
                expects_tests: is_test_runner(argv),
            })
            .collect();
        if self.requires_shared_source(chunk) {
            commands.extend(
                self.shared_source_commands
                    .iter()
                    .enumerate()
                    .map(|(i, argv)| Command {
                        label: format!("shared/{}", i + 1),
                        argv: argv.clone(),
                        expects_tests: is_test_runner(argv),
                    }),
            );
        }
        commands
    }

    /// Named fixture targets `test` runs for a chunk; each must execute tests.
    pub fn test_commands(&self, chunk: Subject) -> Result<Vec<Command>> {
        let entry = self.chunk(chunk)?;
        let mut commands = vec![Command {
            label: "fixture".to_owned(),
            argv: entry.fixture_command.clone(),
            expects_tests: true,
        }];
        commands.extend(
            entry
                .host_commands
                .iter()
                .enumerate()
                .map(|(i, argv)| Command {
                    label: format!("host/{}", i + 1),
                    argv: argv.clone(),
                    expects_tests: true,
                }),
        );
        commands.extend(
            entry
                .frontend_commands
                .iter()
                .enumerate()
                .map(|(i, argv)| Command {
                    label: format!("frontend/{}", i + 1),
                    argv: argv.clone(),
                    expects_tests: true,
                }),
        );
        Ok(commands)
    }
}

fn is_test_runner(argv: &Argv) -> bool {
    argv.iter().any(|a| a == "vitest")
        || (argv.first().map(String::as_str) == Some("cargo")
            && argv.get(1).map(String::as_str) == Some("test"))
}

fn check_argv(argv: &Argv) -> Result<()> {
    let program = argv
        .first()
        .ok_or_else(|| invalid("manifest command is an empty argv"))?;
    if !PROGRAMS.contains(&program.as_str()) {
        return Err(invalid(format!(
            "manifest program {program:?} is not allowlisted"
        )));
    }
    for arg in argv {
        if arg.contains('\0') || arg.contains('\n') {
            return Err(invalid("manifest argument contains a control character"));
        }
        // Only the controller's own validated substitutions may appear.
        if arg.contains('{') && !matches!(arg.as_str(), "{chunk}" | "{phase}") {
            return Err(invalid(format!(
                "unexpected placeholder in manifest argument {arg:?}"
            )));
        }
    }
    if argv.iter().any(|a| a == "--all-features") {
        return Err(invalid(
            "--all-features is prohibited; features are explicit",
        ));
    }
    Ok(())
}
            _ => None,
        })
        .max()
        .unwrap_or(0)
}

/// Why `subject` is not currently complete (empty when it is).
pub fn completion_problems(repo: &Repo, entries: &[Entry], subject: Subject) -> Vec<String> {
    let id = subject.to_string();
    let Some(Entry::Completion {
        generation,
        receipt_id,
        receipt,
        receipt_sha256,
        owner_acceptance,
        ..
    }) = latest_completion(entries, subject)
    else {
        return vec![format!("{subject} has no completion")];
    };
    let mut problems = Vec::new();
    // Completion recognition applies the same rule as completion: a phase or
    // documentation-only chunk (D058) is never recognised through owner
    // acceptance, whatever the ledger line says.
    // The policy is fixed in `Subject` (D058), so recognition never depends on
    // loading a manifest and cannot fail open.
    let strict = subject.is_phase() || subject.is_docs_only();
    if strict && owner_acceptance.is_some() {
        problems.push(format!(
            "{subject} completion records owner acceptance, which {} does not allow",
            if subject.is_phase() { "D034" } else { "D058" }
        ));
    }
    let effective_owner = if strict {
        None
    } else {
        owner_acceptance.as_ref()
    };
    if entries.iter().any(|e| matches!(e, Entry::Invalidation { subject, generation: g, .. } if *subject == id && g == generation)) {
        problems.push(format!("{subject} generation {generation} was invalidated"));
    }
    let committed = entries.iter().any(|e| {
        matches!(e, Entry::Commit { subject, generation: g, receipt_id: r, .. } if *subject == id && g == generation && r == receipt_id)
    });
    if !committed {
        problems.push(format!(
            "{subject} generation {generation} has no verified commit"
        ));
    }
    match std::fs::read(repo.join(receipt)) {
        Err(_) => problems.push(format!("{subject} receipt {receipt} is missing")),
        Ok(bytes) => {
            if sha256_hex(&bytes) != *receipt_sha256 {
                problems.push(format!(
                    "{subject} receipt {receipt} was changed after completion"
                ));
            } else if let Ok(parsed) = serde_json::from_slice::<Receipt>(&bytes) {
                let minimum = if effective_owner.is_some() {
                    OWNER_MINIMUM_SCORE
                } else {
                    gate::MINIMUM_SCORE
                };
                let scores_ok = parsed.scores.named().iter().all(|(_, s)| *s >= minimum);
                let accepted = match effective_owner {
                    // Owner-accepted (D032): the threshold alone may fail.
                    Some(_) => scores_ok && parsed.blockers == 0,
                    None => {
                        parsed.passed
                            && scores_ok
                            && parsed.required_fixes + parsed.blockers + parsed.evidence_gaps == 0
                    }
                };
                if !accepted {
                    problems.push(format!(
                        "{subject} receipt does not record a passing review"
                    ));
                }
            } else {
                problems.push(format!("{subject} receipt is malformed"));
            }
        }
    }
    problems
}

pub fn is_completed(repo: &Repo, entries: &[Entry], subject: Subject) -> bool {
    completion_problems(repo, entries, subject).is_empty()
}

/// Subjects that must be complete (reviewed and committed) before `subject`.
pub fn predecessors(manifest: &Manifest, subject: Subject) -> Result<Vec<Subject>> {
    match subject {
        Subject::Chunk(1) => Ok(Vec::new()),
        Subject::Chunk(n) => {
            let mut required = vec![Subject::Chunk(n - 1)];
            let phase = manifest.phase_of(subject)?;
            let previous_phase = manifest.phase_of(Subject::Chunk(n - 1))?;
            if phase != previous_phase {
                required.push(previous_phase);
            }
            Ok(required)
        }
        Subject::Phase(_) => manifest.phase_chunks(subject),
    }
}

/// The historical planning gate C01 depends on (reviewed by Claude, D019).
pub fn g01_receipt(repo: &Repo) -> PathBuf {
    repo.join("docs/planning/reviews/G01/attempt-05/receipt.json")
}

    } else {
        vec![RunKind::Check, RunKind::Test, RunKind::NativePrepare]
    }
}

/// Owner acceptance below the threshold (D034) applies to application
/// chunks only: phases and documentation-only chunks (D058) need the full
/// 9/10 gate.
pub fn owner_acceptance_allowed(manifest: &Manifest, subject: Subject) -> Result<()> {
    if subject.is_phase() {
        return Err(invalid(format!(
            "{subject} is a phase review: D034 requires 9/10 with no owner acceptance"
        )));
    }
    if manifest.docs_only(subject) {
        return Err(invalid(format!(
            "{subject} is a documentation-only chunk: D058 requires 9/10 in every dimension with no owner acceptance"
        )));
    }
    Ok(())
}

/// Approved command plans, one per required run kind.
pub type Plans = Vec<(RunKind, Vec<PlannedCommand>)>;

/// The approved command plans and native requirements for a subject.
pub fn expectations(
    repo: &Repo,
    manifest: &Manifest,
    subject: Subject,
) -> Result<(Plans, Option<NativeBase>)> {
    let plans = required_runs(manifest, subject)
        .into_iter()
        .map(|kind| Ok((kind, manifest.plan(subject, kind)?)))
        .collect::<Result<Vec<_>>>()?;
    if manifest.docs_only(subject) {
        return Ok((plans, None));
    }
    let members = manifest.native_members(subject)?;
    let (required_checks, fixture_identifier) =
        evidence::required_checks(&repo.join("docs/architecture/native-checks.json"), &members)?;
    let prepared =
        read_json::<Prepared>(&repo.evidence_dir(subject).join("native-prepare.json")).ok();
    let current = prepared.as_ref().map(|p| native::current_state(repo, p));
    Ok((
        plans,
        Some(NativeBase {
            required_checks,
            fixture_identifier,
            prepared_bundle: prepared.as_ref().map(|p| p.bundle.clone()),
            prepared_bundle_sha256: prepared.as_ref().map(|p| p.bundle_sha256.clone()),
            prepared_identifier: prepared.as_ref().map(|p| p.identifier.clone()),
            current_executable_sha256: current.as_ref().and_then(|c| c.executable_sha256.clone()),
            current_bundle_sha256: current.as_ref().and_then(|c| c.bundle_sha256.clone()),
            current_identifier: current.and_then(|c| c.identifier),
        }),
    ))
}

/// Evaluates one receipt exactly as `complete` does.
pub fn evaluate_receipt(
    repo: &Repo,
    manifest: &Manifest,
    subject: Subject,
    receipt: &Path,
    current: Fingerprints,
) -> Result<Vec<String>> {
    let (plans, native) = expectations(repo, manifest, subject)?;
    let inputs = gate::load(repo.root(), receipt, current, plans, native)?;
    let mut failures = gate::evaluate(&inputs);
    if subject == Subject::Chunk(1) {
        failures.extend(bootstrap_failures(receipt, &inputs.receipt_bytes));
    }
    Ok(failures)
}

/// Bootstrap evidence for C01: the independent reference validator and the
/// controller agree on this exact receipt and on every adversarial mutation.
/// It lives in the attempt directory, outside the hash-bound evidence.
#[derive(Clone, Debug, Deserialize)]
struct Bootstrap {
    receipt_sha256: String,
    reference_accepted: bool,
    controller_accepted: bool,
    adversarial_cases: usize,
    adversarial_agreement: bool,
}

fn bootstrap_failures(receipt: &Path, receipt_bytes: &[u8]) -> Vec<String> {
    let path = gate::attempt_dir_of(receipt).join("bootstrap/result.json");
    let Ok(record) = read_json::<Bootstrap>(&path) else {
        return vec![
            "C01 bootstrap: independent reference validation result is missing".to_owned(),
        ];
    };
    let mut failures = Vec::new();
    if record.receipt_sha256 != sha256_hex(receipt_bytes) {
        failures.push("C01 bootstrap result is for a different receipt".to_owned());
    }
    if !record.reference_accepted || !record.controller_accepted {
        failures.push("C01 bootstrap: the validators did not both accept the receipt".to_owned());
    }
    if !record.adversarial_agreement || record.adversarial_cases == 0 {
        failures
            .push("C01 bootstrap: validators did not agree on every adversarial case".to_owned());
    }
    failures
}

/// Validates the newest passing receipt and appends a completion line.
pub fn complete(
    repo: &Repo,
    manifest: &Manifest,
    subject: Subject,
    current: Fingerprints,
) -> Result<Entry> {
    complete_with(repo, manifest, subject, current, None)
}

/// [`complete`], or with `owner_accept` the newest receipt the owner may
/// accept below the threshold (D032).
pub fn complete_with(
    repo: &Repo,
    manifest: &Manifest,
    subject: Subject,
    current: Fingerprints,
    owner_accept: Option<&str>,
) -> Result<Entry> {
    if owner_accept.is_some_and(|r| r.trim().is_empty()) {
        return Err(invalid("--owner-accept needs the owner's reason"));
    }
    // D034: chunks may complete at 8/10; phases and documentation-only
    // chunks (D058) always need the full gate.
    if owner_accept.is_some() {
        owner_acceptance_allowed(manifest, subject)?;
    }
    if let Subject::Phase(_) = subject {
        let entries = read_ledger(&repo.completion_ledger())?;
        // D034: every chunk accepted below 9 is raised before sign-off.
        let below: Vec<String> = manifest
            .phase_chunks(subject)?
            .into_iter()
            .filter(|c| owner_accepted(&entries, *c))
            .map(|c| c.to_string())
            .collect();
        if !below.is_empty() {
            return Err(invalid(format!(
                "{subject} cannot complete: {} must first pass a 9/10 review (D034)",
                below.join(", ")
            )));
        }
    }
    require_predecessors(repo, manifest, subject)?;
    let ledger = repo.completion_ledger();
    let entries = read_ledger(&ledger)?;
    // An owner-accepted chunk may be raised to a passing review as a new
    // generation without reopening later chunks (D034); it is never
    // owner-accepted again.
    let raising = owner_accepted(&entries, subject) && owner_accept.is_none();
    if is_completed(repo, &entries, subject) && !raising {
        return Err(invalid(format!(
            "{subject} is already complete; reopen it before completing a new generation"
        )));
    }
    let mut attempts: Vec<PathBuf> = std::fs::read_dir(repo.reviews_dir(subject))
        .map_err(io_err(&repo.reviews_dir(subject)))?
        .filter_map(|e| e.ok())
        .map(|e| e.path().join("receipt.json"))
        .filter(|p| p.is_file())
        .collect();
    attempts.sort();
    let mut last_failures = vec!["no review receipt exists".to_owned()];
    for receipt_path in attempts.iter().rev() {
        let failures = evaluate_receipt(repo, manifest, subject, receipt_path, current.clone())?;
        let bytes = std::fs::read(receipt_path).map_err(io_err(receipt_path))?;
        let receipt: Receipt =
            serde_json::from_slice(&bytes).map_err(|e| invalid(e.to_string()))?;
        let owner_acceptance = match (owner_accept, failures.is_empty()) {
            (_, true) => None,
            (Some(reason), false) => match owner_acceptable(&receipt, &failures) {
                Ok(accepted) => Some(OwnerAcceptance {
                    decision: "D034".to_owned(),
                    reason: reason.trim().to_owned(),
                    minimum_score: OWNER_MINIMUM_SCORE,
                    accepted_failures: accepted,
                }),
                Err(why) => {
                    last_failures = vec![format!("owner acceptance refused: {why}")];
                    // Only the newest receipt may be owner-accepted.
                    break;
                }
            },
            (None, false) => {
                last_failures = failures;
                continue;
            }
        };
        if entries.iter().any(|e| matches!(e, Entry::Completion { receipt_id, .. } if *receipt_id == receipt.receipt_id)) {
            return Err(invalid("duplicate receipt ID; a receipt can complete only once"));
        }
        let entry = Entry::Completion {
            subject: subject.to_string(),
            generation: highest_generation(&entries, subject) + 1,
            receipt_id: receipt.receipt_id,
            receipt: receipt_path
                .strip_prefix(repo.root())
                .unwrap_or(receipt_path)
                .display()
                .to_string(),
            receipt_sha256: sha256_hex(&bytes),
            fingerprints: current,
            completed_utc: now_utc(),
            owner_acceptance,
        };
        append(&ledger, &entry)?;
        return Ok(entry);

