      ['2', 'AIS has its own section. Should it sit under AI Gateway instead, since enforcement happens there?'],
      ['3', 'Products appear under Administration. Should they also be top-level sidebar entries?']
    ].map(([n, t]) => ({ n, t }));
    return { rows, qs };
  }
}
</script>
