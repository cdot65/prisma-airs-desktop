//! Reviewed Runtime changes (C09): the exact v1 write subset for security
//! profiles, custom topics, applications and API keys, its validation and
//! normalization, the review baseline digest, the before/after preview and
//! the handling of one-time secrets in write responses. Gateway changes
//! (C17) share the kinds, drafts and review flow; their rules live in
//! [`crate::gateway_changes`].
//!
//! Working v1 (74754c02, read-only): `bridge/src/protocol.ts`
//! `validateMutation` (allowed actions, target and body rules, SDK schema
//! parsing), `bridge/src/runtime.ts` (authorship, key creation checks, the
//! baseline and review digests, confirmation text, preview and impact) and
//! `bridge/src/operations.ts` `mutateLive` (the SDK call per action).
//! Nothing here performs IO.

use serde::{Deserialize, Serialize};
use serde_json::{Map, Value};
use sha2::{Digest, Sha256};
use ts_rs::TS;
use zeroize::Zeroizing;

use crate::context::WorkspaceRef;
use crate::gateway::GatewayResource;
use crate::management::{ManagementResource, redact};

/// Largest draft body accepted (bytes of JSON text).
pub const MAX_BODY_BYTES: usize = 1024 * 1024;
/// Longest target identifier (v1).
pub const MAX_TARGET: usize = 256;
/// Longest custom topic description in code points (v1).
pub const MAX_TOPIC_DESCRIPTION: usize = 240;
/// Key rotation intervals v1 offers (days).
pub const ROTATION_DAYS: [u64; 3] = [30, 90, 180];
/// Largest dictionary keyword file in UTF-16 units (v1's 64 Ki limit).
pub const MAX_DICTIONARY_FILE: usize = 64 * 1024;

/// What a change applies to.
#[derive(Clone, Copy, Debug, PartialEq, Eq, Hash, Serialize, Deserialize, TS)]
#[serde(rename_all = "camelCase")]
pub enum ChangeKind {
    Profiles,
    Topics,
    Applications,
    ApiKeys,
    /// DLP (C10).
    DataPatterns,
    DataProfiles,
    FilteringProfiles,
    Dictionaries,
    /// Gateway (C17): workspaces (provisioned, updated, archived).
    GatewayWorkspaces,
    /// Within the chosen workspace.
    GatewayProviders,
    GatewayRoutes,
    GatewayGuardrails,
    GatewayServiceKeys,
    GatewayUserKeys,
    /// Tenant-wide (admin plane).
    GatewayIntegrations,
}

impl ChangeKind {
    /// The Runtime or DLP inventory a change's baseline is read from (none
    /// for a Gateway change).
    pub fn resource(self) -> Option<ManagementResource> {
        Some(match self {
            Self::Profiles => ManagementResource::Profiles,
            Self::Topics => ManagementResource::Topics,
            Self::Applications => ManagementResource::Applications,
            Self::ApiKeys => ManagementResource::ApiKeys,
            Self::DataPatterns => ManagementResource::DataPatterns,
            Self::DataProfiles => ManagementResource::DataProfiles,
            Self::FilteringProfiles => ManagementResource::FilteringProfiles,
            Self::Dictionaries => ManagementResource::Dictionaries,
            _ => return None,
        })
    }

    /// The Gateway inventory a Gateway change applies to.
    pub fn gateway(self) -> Option<GatewayResource> {
        Some(match self {
            Self::GatewayWorkspaces => GatewayResource::Workspaces,
            Self::GatewayProviders => GatewayResource::Providers,
            Self::GatewayRoutes => GatewayResource::Routes,
            Self::GatewayGuardrails => GatewayResource::Guardrails,
            Self::GatewayServiceKeys => GatewayResource::ServiceKeys,
            Self::GatewayUserKeys => GatewayResource::UserKeys,
            Self::GatewayIntegrations => GatewayResource::Integrations,
            _ => return None,
        })
    }

    /// DLP items are read and written by their own identifier (`id`).
    pub fn is_dlp(self) -> bool {
        matches!(
            self,
            Self::DataPatterns | Self::DataProfiles | Self::FilteringProfiles | Self::Dictionaries
        )
    }

    /// The field naming an item for the operator (and the typed confirmation).
    pub fn name_field(self) -> &'static str {
        match self {
            Self::Profiles => "profile_name",
            Self::Topics => "topic_name",
            Self::Applications => "app_name",
            Self::ApiKeys => "api_key_name",
            Self::DataPatterns
            | Self::DataProfiles
            | Self::FilteringProfiles
            | Self::Dictionaries
            | Self::GatewayWorkspaces
            | Self::GatewayProviders
            | Self::GatewayRoutes
            | Self::GatewayGuardrails
            | Self::GatewayServiceKeys
            | Self::GatewayUserKeys
            | Self::GatewayIntegrations => "name",
        }
    }
}

/// The action of a change (v1's allowed matrix).
#[derive(Clone, Copy, Debug, PartialEq, Eq, Hash, Serialize, Deserialize, TS)]
#[serde(rename_all = "camelCase")]
pub enum ChangeAction {
    Create,
    Update,
    Delete,
    /// An additional API key for an existing application.
    Version,
    /// Regenerate an API key.
    Rotate,
    /// Replace a Gateway integration's model list (C17).
    Models,
}

/// The operator's captured draft, exactly as entered.
#[derive(Clone, Debug, PartialEq, Eq, Serialize, Deserialize, TS)]
#[serde(rename_all = "camelCase", deny_unknown_fields)]
pub struct ChangeDraft {

fn noun(kind: ChangeKind) -> &'static str {
    match kind {
        ChangeKind::Profiles => "security profile",
        ChangeKind::Topics => "custom topic",
        ChangeKind::Applications => "application",
        ChangeKind::ApiKeys => "API key",
        ChangeKind::DataPatterns => "data pattern",
        ChangeKind::DataProfiles => "data profile",
        ChangeKind::FilteringProfiles => "data filtering profile",
        ChangeKind::Dictionaries => "dictionary",
        ChangeKind::GatewayWorkspaces => "Gateway workspace",
        ChangeKind::GatewayProviders => "Gateway provider",
        ChangeKind::GatewayRoutes => "Gateway route",
        ChangeKind::GatewayGuardrails => "Gateway guardrail",
        ChangeKind::GatewayServiceKeys => "Gateway service key",
        ChangeKind::GatewayUserKeys => "Gateway user key",
        ChangeKind::GatewayIntegrations => "Gateway integration",
    }
}

