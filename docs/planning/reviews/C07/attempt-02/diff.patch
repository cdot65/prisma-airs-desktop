+        assert_eq!(value["locked"], true, "{value}");
+        assert_eq!(value["lockReason"], reason);
+        assert_eq!(
+            value["draft"]["debrief"], "LEARNER-WORK",
+            "the learner's work stays"
+        );
+        assert!(
+            !value.to_string().contains(AUTHORED),
+            "no authored definition: {value}"
