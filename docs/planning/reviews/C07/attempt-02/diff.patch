+    let online = desk
+        .call("desktop.attempt.get", "query", Some(input))
+        .await
+        .expect("admitted");
+    assert!(
+        matches!(online, AcademyCallResult::Data { .. }),
+        "{online:?}"
+    );
+    desk.script.lock().expect("script").unreachable = true;
+    let offline = desk
+        .call("desktop.attempt.get", "query", Some(input))
+        .await
+        .expect("admitted");
