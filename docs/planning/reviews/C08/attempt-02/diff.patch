+    struct Switch(
+        Option<PathBuf>,
+        Arc<dyn ImportPicker>,
+        Arc<dyn ImportPicker>,
+    );
+    impl ImportPicker for Switch {
+        fn choose(&self) -> BoxFuture<'static, Option<Result<ImportFile, ImportError>>> {
+            if self.0.as_ref().is_some_and(|flag| flag.exists()) {
+                self.2.choose()
+            } else {
+                self.1.choose()
+            }
