+WEBKIT_DIRS = [os.path.join(fx.HOME, "Library/WebKit/io.cdot.prisma-airs-desktop.v2.fixture"),
+               os.path.join(fx.HOME, "Library/Caches/io.cdot.prisma-airs-desktop.v2.fixture")]
