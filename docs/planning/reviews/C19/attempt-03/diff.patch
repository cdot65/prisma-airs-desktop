+    def harness_stream(self, rid, record, pace, serial):
+        """C19: a Responses stream the native engine accepts."""
+        srv = self.server
+
+        def event(obj):
+            return f"event: {obj['type']}\ndata: {json.dumps(obj)}\n\n".encode()
