+                    entries: [
+                        { id: 'u-1', role: 'operator', text: 'Say hello', state: 'complete' },
+                        { id: 'u-1/msg_1', role: 'assistant', text: 'Hello fr', state: 'streaming' },
+                    ],
+                }),
+            })
+        )
