+    let names: Vec<String> = spec
+        .env
+        .iter()
+        .map(|(k, _)| k.to_string_lossy().into_owned())
+        .collect();
+    assert!(
+        names.iter().all(|n| ENV_NAMES.contains(&n.as_str())),
