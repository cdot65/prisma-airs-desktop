@@ -0,0 +1,146 @@
+//! The native Harness (C19, D046): the pinned Rust engine (9331a58,
+//! `airs-desktop/1`) run directly as a desktop-owned sidecar.
+//!
+//! One conversation at a time. It is bound at its start to the tenant
+//! context, the chosen Gateway workspace and the workspace inference key
+//! stored for it (sent only to the runtime endpoint stored with it); a
+//! change to any of them, ending it, sleep or quitting stops it. The
+//! engine is verified against the compiled pin before it is started, gets
+//! no inherited environment, no argument but `desktop-server` and no
+//! credential except in the one bootstrap frame on stdin. It runs in its
+//! own process group with its own ephemeral runtime home; stopping it
+//! closes its input, waits a bounded grace period, then kills the group
+//! and reaps it, and removes the home. Nothing of the conversation is
+//! written to disk (protected history is C20); tools, approvals and
+//! project access are C21, workspace MCP servers C22.
+
+pub mod engine;
+pub mod protocol;
+pub mod session;
+pub mod sidecar;
+
+use serde::Serialize;
+use ts_rs::TS;
+
+/// Why a conversation failed or could not start (sanitized: never the
+/// engine's own text, which may echo model or tool output).
+#[derive(Clone, Copy, Debug, PartialEq, Eq, Serialize, TS, thiserror::Error)]
+#[serde(rename_all = "camelCase")]
+pub enum HarnessFailure {
+    /// The bundled engine is missing, is not the pinned one or was changed.
+    #[error("engine unavailable")]
+    EngineUnavailable,
+    #[error("credential missing")]
+    CredentialMissing,
+    #[error("credential locked")]
+    CredentialLocked,
+    #[error("credential denied")]
+    CredentialDenied,
+    /// The process could not be started, or its runtime home created.
+    #[error("start failed")]
+    StartFailed,
+    /// The engine refused the bootstrap (or its receipt named another
+    /// binding).
+    #[error("bootstrap rejected")]
+    BootstrapRejected,
+    /// No receipt within the bootstrap bound.
+    #[error("timed out")]
+    Timeout,
+    /// A malformed, unexpected or duplicate frame.
+    #[error("protocol")]
+    Protocol,
+    /// A frame, the output or the stream exceeded its bound.
+    #[error("bounds")]
+    Bounds,
+    /// The engine ended or stopped answering on its own.
+    #[error("engine exited")]
+    Exited,
+    /// The engine refused a request (a thread or turn could not start).
+    #[error("refused")]
+    Refused,
+    /// The Gateway or model ended the answer with an error.
+    #[error("turn failed")]
+    TurnFailed,
+    /// The process could not be stopped and reaped within its bound.
+    #[error("cleanup failed")]
+    CleanupFailed,
+}
+
+/// Where a conversation stands.
+#[derive(Clone, Copy, Debug, Default, PartialEq, Eq, Serialize, TS)]
+#[serde(rename_all = "camelCase")]
+pub enum HarnessPhase {
+    /// Verifying and starting the engine.
+    #[default]
+    Starting,
+    Ready,
+    /// A turn is being answered.
+    Answering,
+    /// Stopping the answer.
+    Interrupting,
+    /// Stopping the engine.
+    Ending,
+    Ended,
+    Failed,
+}
+
+/// Who wrote an entry.
+#[derive(Clone, Copy, Debug, PartialEq, Eq, Serialize, TS)]
+#[serde(rename_all = "camelCase")]
+pub enum HarnessRole {
+    Operator,
+    Assistant,
+}
+
+/// How an entry stands.
+#[derive(Clone, Copy, Debug, PartialEq, Eq, Serialize, TS)]
+#[serde(rename_all = "camelCase")]
+pub enum EntryState {
+    Streaming,
+    Complete,
+    /// The answer was stopped before it was finished.
+    Interrupted,
+    /// The answer reached its bound; the rest was not kept.
+    Truncated,
+    Failed,
+}
+
+#[derive(Clone, Debug, PartialEq, Eq, Serialize, TS)]
+#[serde(rename_all = "camelCase")]
+pub struct HarnessEntry {
+    pub id: String,
+    pub role: HarnessRole,
+    pub text: String,
+    pub state: EntryState,
+}
+
+/// How the engine was stopped.
+#[derive(Clone, Copy, Debug, PartialEq, Eq, Serialize, TS)]
+#[serde(rename_all = "camelCase")]
+pub enum Cleanup {
+    /// It exited after its input was closed.
+    Graceful,
+    /// It was killed after the grace period, and reaped.
+    Forced,
+    /// It could not be reaped within the bound.
+    Failed,
+}
+
+/// Tokens the engine reported for the conversation so far.
+#[derive(Clone, Copy, Debug, Default, PartialEq, Eq, Serialize, TS)]
+#[serde(rename_all = "camelCase")]
+pub struct HarnessUsage {
+    #[ts(type = "number")]
+    pub input: u64,
+    #[ts(type = "number")]
+    pub output: u64,
+    #[ts(type = "number")]
+    pub total: u64,
+}
+
+/// Entries kept for one conversation (memory only).
+pub const MAX_ENTRIES: usize = 200;
+/// Text kept for one conversation, all entries together.
+pub const MAX_TRANSCRIPT_BYTES: usize = 1024 * 1024;
+/// One answer's text; past it the answer is stopped and marked truncated.
+pub const MAX_ANSWER_BYTES: usize = 256 * 1024;
diff --git a/crates/desktop-core/src/harness/engine.rs b/crates/desktop-core/src/harness/engine.rs
new file mode 100644
index 0000000..95ef928
--- /dev/null
+++ b/crates/desktop-core/src/harness/engine.rs
@@ -0,0 +1,165 @@
+//! The compiled engine pin (`resources/harness/pin.json`, made by
+//! `tools/harness/seal.py`) and the check every start makes before the
+//! engine runs or any credential is read: the bundled executable is a
+//! regular file (not a link), unchanged while it is read, and its SHA-256
+//! is the pinned one.
+
+use std::io::Read;
+use std::path::{Path, PathBuf};
+
+use serde::Deserialize;
+use sha2::{Digest, Sha256};
+
+use super::HarnessFailure;
+
+const PIN: &str = include_str!("../../../../resources/harness/pin.json");
+/// Larger than the pinned engine (about 320 MiB), and bounded.
+const MAX_EXECUTABLE_BYTES: u64 = 1024 * 1024 * 1024;
+
+#[derive(Clone, Debug, Deserialize, PartialEq, Eq)]
+#[serde(rename_all = "camelCase")]
+pub struct Pin {
+    pub version: u32,
+    pub protocol: String,
+    pub runtime_version: String,
+    pub engine_commit: String,
+    pub executable: String,
+    pub binary_sha256: String,
+    pub resources_sha256: String,
+}
+
+/// The pin this build was compiled with.
+pub fn pin() -> Pin {
+    serde_json::from_str(PIN).expect("the compiled engine pin parses")
+}
+
+/// The engine bundled with the app, by its path (the host resolves it
+/// inside the app's resources; the presentation never supplies it).
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct Engine {
+    pub executable: PathBuf,
+}
+
+/// File identity, to notice a replacement while the file is read.
+fn identity(meta: &std::fs::Metadata) -> (u64, u64, u64, i128) {
+    use std::os::unix::fs::MetadataExt;
+    (
+        meta.dev(),
+        meta.ino(),
+        meta.len(),
+        i128::from(meta.mtime()) * 1_000_000_000 + i128::from(meta.mtime_nsec()),
+    )
+}
+
+/// Verifies `engine` against `pin`. Blocking (it reads the whole file).
+pub fn verify(engine: &Engine, pin: &Pin) -> Result<(), HarnessFailure> {
+    let path: &Path = &engine.executable;
+    let unavailable = |_| HarnessFailure::EngineUnavailable;
+    if !path.is_absolute()
+        || path.file_name().and_then(|n| n.to_str()) != Some(pin.executable.as_str())
+    {
+        return Err(HarnessFailure::EngineUnavailable);
+    }
+    let before = std::fs::symlink_metadata(path).map_err(unavailable)?;
+    if !before.file_type().is_file() || before.len() > MAX_EXECUTABLE_BYTES {
+        return Err(HarnessFailure::EngineUnavailable);
+    }
+    if path.canonicalize().map_err(unavailable)? != path {
+        return Err(HarnessFailure::EngineUnavailable);
+    }
+    let mut file = std::fs::File::open(path).map_err(unavailable)?;
+    let mut hash = Sha256::new();
+    let mut buf = vec![0u8; 1024 * 1024];
+    let mut total = 0u64;
+    loop {
+        let n = file.read(&mut buf).map_err(unavailable)?;
+        if n == 0 {
+            break;
+        }
+        total += n as u64;
+        if total > MAX_EXECUTABLE_BYTES {
+            return Err(HarnessFailure::EngineUnavailable);
+        }
+        hash.update(&buf[..n]);
+    }
+    let after = std::fs::symlink_metadata(path).map_err(unavailable)?;
+    if identity(&before) != identity(&after) || total != before.len() {
+        return Err(HarnessFailure::EngineUnavailable);
+    }
+    if hex::encode(hash.finalize()) != pin.binary_sha256 {
+        return Err(HarnessFailure::EngineUnavailable);
+    }
+    Ok(())
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn the_compiled_pin_names_the_reviewed_engine() {
+        let p = pin();
+        assert_eq!(p.version, 1);
+        assert_eq!(p.protocol, super::super::protocol::PROTOCOL);
+        assert_eq!(p.engine_commit, "9331a5839bc6a763d94dee7584746f58bbbe1181");
+        assert_eq!(p.executable, "airs-harness");
+        assert_eq!(
+            p.binary_sha256,
+            "f8e49cee8b0905818c9271e91b2ca8f39b67075e602e5db7db683f9d37aee50c"
+        );
+    }
+
+    #[test]
+    fn only_the_pinned_bytes_at_a_real_path_verify() {
+        let dir = std::env::temp_dir()
+            .canonicalize()
+            .expect("fixture")
+            .join(format!("airs-engine-{}", std::process::id()));
+        std::fs::create_dir_all(&dir).expect("fixture");
+        let exe = dir.join("airs-harness");
+        std::fs::write(&exe, b"not the engine").expect("fixture");
+        let mut p = pin();
+        let engine = Engine {
+            executable: exe.clone(),
+        };
+        assert_eq!(verify(&engine, &p), Err(HarnessFailure::EngineUnavailable));
+        p.binary_sha256 = hex::encode(Sha256::digest(b"not the engine"));
+        assert_eq!(verify(&engine, &p), Ok(()));
+        // Another name, a relative path, a link or a directory never verify.
+        let other = dir.join("other");
+        std::fs::write(&other, b"not the engine").expect("fixture");
+        assert!(verify(&Engine { executable: other }, &p).is_err());
+        assert!(
+            verify(
+                &Engine {
+                    executable: "airs-harness".into()
+                },
+                &p
+            )
+            .is_err()
+        );
+        let link_dir = dir.join("link");
+        std::fs::create_dir_all(&link_dir).expect("fixture");
+        let link = link_dir.join("airs-harness");
+        let _ = std::fs::remove_file(&link);
+        std::os::unix::fs::symlink(&exe, &link).expect("fixture");
+        assert!(verify(&Engine { executable: link }, &p).is_err());
+        // The real file reached through a linked folder is not its own path.
+        let linked = dir.join("linked");
+        let _ = std::fs::remove_file(&linked);
+        std::os::unix::fs::symlink(&dir, &linked).expect("fixture");
+        assert!(
+            verify(
+                &Engine {
+                    executable: linked.join("airs-harness")
+                },
+                &p
+            )
+            .is_err()
+        );
+        let as_dir = dir.join("d").join("airs-harness");
+        std::fs::create_dir_all(&as_dir).expect("fixture");
+        assert!(verify(&Engine { executable: as_dir }, &p).is_err());
+        std::fs::remove_dir_all(&dir).expect("fixture");
+    }
+}
diff --git a/crates/desktop-core/src/harness/protocol.rs b/crates/desktop-core/src/harness/protocol.rs
new file mode 100644
index 0000000..8728914
--- /dev/null
+++ b/crates/desktop-core/src/harness/protocol.rs
@@ -0,0 +1,487 @@
+//! The pinned engine's `airs-desktop/1` wire (engine 9331a58, D046): one
+//! JSON object per line in each direction. The bootstrap frame is the only
+//! one that carries a credential; it is encoded into a single zeroizing
+//! buffer of the frame's bound, so no partial copy of the key is freed
+//! without being cleared. Every incoming frame is parsed and bounded here
+//! before any of it reaches a view.
+
+use serde::Deserialize;
+use serde_json::{Map, Value, json};
+use zeroize::{Zeroize, Zeroizing};
+
+use super::HarnessFailure;
+
+/// The bootstrap frame and its receipt (the engine's `FRAME_LIMIT`).
+pub const FRAME_LIMIT: usize = 64 * 1024;
+/// Any later frame (the engine's `REPLAY_LIMIT`).
+pub const EVENT_LIMIT: usize = 4 * 1024 * 1024;
+pub const PROTOCOL: &str = "airs-desktop/1";
+/// The engine's credential bound (it refuses a longer key).
+pub const MAX_KEY_BYTES: usize = 16 * 1024;
+/// The engine accepts at most eight 8 KiB text items per turn; v1's native
+/// prompt bound is 32 KiB.
+pub const MAX_PROMPT_BYTES: usize = 32 * 1024;
+const TEXT_ITEM_BYTES: usize = 8 * 1024;
+
+/// What a conversation is bound to, as the engine names it. The engine
+/// echoes it in its receipt, and the receipt must match exactly.
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct Binding {
+    pub tenant: String,
+    pub workspace: String,
+    pub credential: String,
+    pub credential_epoch: u64,
+    pub endpoint: String,
+}
+
+/// A UUID derived from a native identifier for one purpose (the engine
+/// requires UUIDs; v2 identifiers are not). SHA-256 of the domain and the
+/// identifier, shaped as an RFC 9562 version 8 UUID.
+pub fn derived_uuid(domain: &str, id: &str) -> String {
+    use sha2::{Digest, Sha256};
+    let mut h = Sha256::new();
+    h.update(b"airs-v2/harness/");
+    h.update(domain.as_bytes());
+    h.update([0]);
+    h.update(id.as_bytes());
+    let mut b: [u8; 16] = h.finalize()[..16].try_into().expect("16 bytes");
+    b[6] = (b[6] & 0x0f) | 0x80;
+    b[8] = (b[8] & 0x3f) | 0x80;
+    let x = hex::encode(b);
+    format!(
+        "{}-{}-{}-{}-{}",
+        &x[..8],
+        &x[8..12],
+        &x[12..16],
+        &x[16..20],
+        &x[20..]
+    )
+}
+
+/// A lowercase hyphenated UUID that is not nil.
+pub fn is_uuid(text: &str) -> bool {
+    text.len() == 36
+        && text.bytes().enumerate().all(|(i, b)| match i {
+            8 | 13 | 18 | 23 => b == b'-',
+            _ => b.is_ascii_hexdigit() && !b.is_ascii_uppercase(),
+        })
+        && text.bytes().any(|b| b != b'0' && b != b'-')
+}
+
+/// The bootstrap frame with its newline, in one zeroizing buffer that
+/// never grows past [`FRAME_LIMIT`].
+pub fn bootstrap(binding: &Binding, key: &str) -> Result<Zeroizing<Vec<u8>>, HarnessFailure> {
+    if key.is_empty() || key.len() > MAX_KEY_BYTES || key.chars().any(char::is_control) {
+        return Err(HarnessFailure::CredentialMissing);
+    }
+    let mut value = json!({"id":0,"method":"desktop/bootstrap","params":{"v":1,
+        "tenantId":binding.tenant,"workspaceId":binding.workspace,
+        "credentialId":binding.credential,"credentialEpoch":binding.credential_epoch,
+        "gatewayEndpoint":binding.endpoint,"apiKey":key,
+        "projectPath":null,"localAccess":"readOnly","gatewayConfig":null,"model":null}});
+    let mut frame = Frame(Zeroizing::new(Vec::with_capacity(FRAME_LIMIT)), false);
+    let written = serde_json::to_writer(&mut frame, &value);
+    if let Some(Value::String(secret)) = value["params"].get_mut("apiKey") {
+        secret.zeroize();
+    }
+    if frame.1 || written.is_err() {
+        return Err(HarnessFailure::Protocol);
+    }
+    frame.0.push(b'\n');
+    Ok(frame.0)
+}
+
+/// Bytes being encoded; refuses to reach the limit instead of reallocating.
+struct Frame(Zeroizing<Vec<u8>>, bool);
+
+impl std::io::Write for Frame {
+    fn write(&mut self, bytes: &[u8]) -> std::io::Result<usize> {
+        if self.0.len() + bytes.len() >= FRAME_LIMIT {
+            self.1 = true;
+            return Err(std::io::ErrorKind::OutOfMemory.into());
+        }
+        self.0.extend_from_slice(bytes);
+        Ok(bytes.len())
+    }
+    fn flush(&mut self) -> std::io::Result<()> {
+        Ok(())
+    }
+}
+
+/// The engine's answer to the bootstrap.
+#[derive(Debug, Deserialize)]
+#[serde(rename_all = "camelCase", deny_unknown_fields)]
+pub struct Receipt {
+    pub v: u8,
+    pub protocol: String,
+    pub runtime_version: String,
+    pub tenant_id: String,
+    pub workspace_id: String,
+    pub credential_id: String,
+    pub credential_epoch: u64,
+    #[serde(default)]
+    pub mcp_servers: Vec<Value>,
+}
+
+impl Receipt {
+    /// It names exactly this binding, the pinned protocol and runtime, and
+    /// no MCP server (none is granted before C22).
+    pub fn matches(&self, binding: &Binding, runtime_version: &str) -> bool {
+        self.v == 1
+            && self.protocol == PROTOCOL
+            && self.runtime_version == runtime_version
+            && self.tenant_id == binding.tenant
+            && self.workspace_id == binding.workspace
+            && self.credential_id == binding.credential
+            && self.credential_epoch == binding.credential_epoch
+            && self.mcp_servers.is_empty()
+    }
+}
+
+/// The host's requests. There is deliberately no shell, file, login or
+/// Apply method here.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum Method {
+    Initialize,
+    ThreadStart,
+    TurnStart,
+    TurnInterrupt,
+}
+
+impl Method {
+    pub fn as_str(self) -> &'static str {
+        match self {
+            Self::Initialize => "initialize",
+            Self::ThreadStart => "thread/start",
+            Self::TurnStart => "turn/start",
+            Self::TurnInterrupt => "turn/interrupt",
+        }
+    }
+}
+
+/// One encoded host frame with its newline. No `Debug`: a prompt can be
+/// sensitive.
+pub struct Outbound(pub Zeroizing<Vec<u8>>);
+
+fn encode(value: &Value) -> Result<Outbound, HarnessFailure> {
+    let mut bytes =
+        Zeroizing::new(serde_json::to_vec(value).map_err(|_| HarnessFailure::Protocol)?);
+    if bytes.len() >= FRAME_LIMIT {
+        return Err(HarnessFailure::Bounds);
+    }
+    bytes.push(b'\n');
+    Ok(Outbound(bytes))
+}
+
+pub fn request(id: u64, method: Method, params: Value) -> Result<Outbound, HarnessFailure> {
+    if id == 0 || !params.is_object() {
+        return Err(HarnessFailure::Protocol);
+    }
+    encode(&json!({"id":id,"method":method.as_str(),"params":params}))
+}
+
+pub fn initialized() -> Outbound {
+    Outbound(Zeroizing::new(b"{\"method\":\"initialized\"}\n".to_vec()))
+}
+
+/// A reply to one of the engine's requests.
+pub fn reply(id: &RequestId, result: Value) -> Result<Outbound, HarnessFailure> {
+    encode(&json!({"id":id.to_value(),"result":result}))
+}
+
+/// A JSON-RPC refusal of one of the engine's requests.
+pub fn refuse(id: &RequestId, code: i32) -> Result<Outbound, HarnessFailure> {
+    encode(
+        &json!({"id":id.to_value(),"error":{"code":code,"message":"Not available in Prisma AIRS Desktop"}}),
+    )
+}
+
+pub fn initialize_params(version: &str) -> Value {
+    json!({"clientInfo":{"name":"prisma_airs_desktop","title":"Prisma AIRS Desktop","version":version},
+        "capabilities":{"experimentalApi":true}})
+}
+
+/// A read-only conversation with no project, no tools and no local
+/// environment (C19). Tools and project access arrive with C21.
+pub fn thread_params() -> Value {
+    json!({"ephemeral":true,"approvalPolicy":"on-request","approvalsReviewer":"user",
+        "sandbox":"read-only","dynamicTools":[],"cwd":null,"environments":[]})
+}
+
+/// The prompt as at most eight 8 KiB text items, split on UTF-8 boundaries.
+pub fn turn_params(thread: &str, prompt: &str) -> Result<Value, HarnessFailure> {
+    if prompt.trim().is_empty() || prompt.len() > MAX_PROMPT_BYTES {
+        return Err(HarnessFailure::Bounds);
+    }
+    let mut input = Vec::new();
+    let mut rest = prompt;
+    while !rest.is_empty() {
+        let mut end = rest.len().min(TEXT_ITEM_BYTES);
+        while !rest.is_char_boundary(end) {
+            end -= 1;
+        }
+        input.push(json!({"type":"text","text":&rest[..end]}));
+        rest = &rest[end..];
+    }
+    Ok(json!({"threadId":thread,"input":input}))
+}
+
+/// A JSON-RPC id the engine used.
+#[derive(Clone, Debug, PartialEq, Eq, Hash)]
+pub enum RequestId {
+    Number(u64),
+    Text(String),
+}
+
+impl RequestId {
+    fn parse(value: Value) -> Option<Self> {
+        match value {
+            Value::Number(n) => n.as_u64().map(Self::Number),
+            Value::String(s)
+                if !s.is_empty() && s.len() <= 128 && !s.chars().any(char::is_control) =>
+            {
+                Some(Self::Text(s))
+            }
+            _ => None,
+        }
+    }
+    fn to_value(&self) -> Value {
+        match self {
+            Self::Number(n) => json!(n),
+            Self::Text(s) => json!(s),
+        }
+    }
+}
+
+/// One frame from the engine, shape-checked.
+#[derive(Debug)]
+pub enum Incoming {
+    Response {
+        id: RequestId,
+        result: Value,
+    },
+    Failure {
+        id: RequestId,
+        code: Option<i64>,
+    },
+    Request {
+        id: RequestId,
+        method: String,
+        params: Value,
+    },
+    Notification {
+        method: String,
+        params: Value,
+    },
+}
+
+impl Incoming {
+    pub fn decode(line: &[u8]) -> Result<Self, HarnessFailure> {
+        if line.is_empty() || line.len() > EVENT_LIMIT {
+            return Err(HarnessFailure::Bounds);
+        }
+        let value: Value = serde_json::from_slice(line).map_err(|_| HarnessFailure::Protocol)?;
+        let Value::Object(mut map) = value else {
+            return Err(HarnessFailure::Protocol);
+        };
+        if map.keys().any(|k| {
+            !matches!(
+                k.as_str(),
+                "id" | "method" | "params" | "result" | "error" | "jsonrpc"
+            )
+        }) {
+            return Err(HarnessFailure::Protocol);
+        }
+        if map.remove("jsonrpc").is_some_and(|v| v != "2.0") {
+            return Err(HarnessFailure::Protocol);
+        }
+        let id = match map.remove("id") {
+            Some(v) => Some(RequestId::parse(v).ok_or(HarnessFailure::Protocol)?),
+            None => None,
+        };
+        let take = |map: &mut Map<String, Value>, k: &str| map.remove(k);
+        let (method, params, result, error) = (
+            take(&mut map, "method"),
+            take(&mut map, "params"),
+            take(&mut map, "result"),
+            take(&mut map, "error"),
+        );
+        match (id, method, params, result, error) {
+            (Some(id), None, None, Some(result), None) => Ok(Self::Response { id, result }),
+            (Some(id), None, None, None, Some(Value::Object(e))) => Ok(Self::Failure {
+                id,
+                code: e.get("code").and_then(Value::as_i64),
+            }),
+            (id, Some(Value::String(method)), params, None, None)
+                if !method.is_empty()
+                    && method.len() <= 128
+                    && !method.chars().any(char::is_control) =>
+            {
+                let params = params.unwrap_or_else(|| json!({}));
+                if !params.is_object() {
+                    return Err(HarnessFailure::Protocol);
+                }
+                Ok(match id {
+                    Some(id) => Self::Request { id, method, params },
+                    None => Self::Notification { method, params },
+                })
+            }
+            _ => Err(HarnessFailure::Protocol),
+        }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn binding() -> Binding {
+        Binding {
+            tenant: derived_uuid("tenant", "tn-0123456789abcdef"),
+            workspace: "16f7e90d-382a-4e78-b577-1b01eb5f8297".into(),
+            credential: derived_uuid("credential", "cr-0011223344556677"),
+            credential_epoch: 1,
+            endpoint: "https://gateway.example/rt/v1".into(),
+        }
+    }
+
+    #[test]
+    fn bootstrap_and_receipt_name_the_same_binding() {
+        let b = binding();
+        assert!(is_uuid(&b.tenant) && is_uuid(&b.credential) && is_uuid(&b.workspace));
+        assert_ne!(b.tenant, derived_uuid("credential", "tn-0123456789abcdef"));
+        assert!(!is_uuid("00000000-0000-0000-0000-000000000000"));
+        assert!(!is_uuid("16F7E90D-382A-4E78-B577-1B01EB5F8297"));
+        let frame = bootstrap(&b, "gw-key").expect("fixture");
+        assert_eq!(frame.last(), Some(&b'\n'));
+        let v: Value = serde_json::from_slice(&frame).expect("fixture");
+        assert_eq!(v["method"], "desktop/bootstrap");
+        assert_eq!(v["params"]["apiKey"], "gw-key");
+        assert_eq!(v["params"]["localAccess"], "readOnly");
+        assert_eq!(v["params"]["projectPath"], Value::Null);
+        assert!(v["params"].get("mcpServers").is_none());
+        let receipt = |tenant: &str, mcp: Value| -> Receipt {
+            serde_json::from_value(
+                json!({"v":1,"protocol":PROTOCOL,"runtimeVersion":"0.1.7-desktop.2",
+                "tenantId":tenant,"workspaceId":b.workspace,"credentialId":b.credential,
+                "credentialEpoch":1,"mcpServers":mcp}),
+            )
+            .expect("fixture")
+        };
+        assert!(receipt(&b.tenant, json!([])).matches(&b, "0.1.7-desktop.2"));
+        assert!(!receipt(&b.tenant, json!([])).matches(&b, "0.1.8"));
+        assert!(!receipt(&b.credential, json!([])).matches(&b, "0.1.7-desktop.2"));
+        assert!(
+            !receipt(&b.tenant, json!([{"name":"x","serverId":"y"}]))
+                .matches(&b, "0.1.7-desktop.2")
+        );
+        // An unknown receipt field is not a receipt.
+        assert!(
+            serde_json::from_value::<Receipt>(
+                json!({"v":1,"protocol":PROTOCOL,"runtimeVersion":"r",
+            "tenantId":"t","workspaceId":"w","credentialId":"c","credentialEpoch":1,"extra":1})
+            )
+            .is_err()
+        );
+    }
+
+    #[test]
+    fn credentials_and_frames_are_bounded() {
+        let b = binding();
+        assert_eq!(
+            bootstrap(&b, "").err(),
+            Some(HarnessFailure::CredentialMissing)
+        );
+        assert_eq!(
+            bootstrap(&b, "a\nb").err(),
+            Some(HarnessFailure::CredentialMissing)
+        );
+        assert_eq!(
+            bootstrap(&b, &"k".repeat(MAX_KEY_BYTES + 1)).err(),
+            Some(HarnessFailure::CredentialMissing)
+        );
+        assert!(bootstrap(&b, &"k".repeat(MAX_KEY_BYTES)).is_ok());
+        let mut long = b.clone();
+        long.endpoint = format!("https://{}.example/v1", "a".repeat(FRAME_LIMIT));
+        assert_eq!(bootstrap(&long, "k").err(), Some(HarnessFailure::Protocol));
+        assert_eq!(turn_params("t", "  ").err(), Some(HarnessFailure::Bounds));
+        assert_eq!(
+            turn_params("t", &"x".repeat(MAX_PROMPT_BYTES + 1)).err(),
+            Some(HarnessFailure::Bounds)
+        );
+        // Split on character boundaries into at most eight items.
+        let prompt = "é".repeat(MAX_PROMPT_BYTES / 2);
+        let items = turn_params("t", &prompt).expect("fixture")["input"]
+            .as_array()
+            .expect("fixture")
+            .clone();
+        assert!(items.len() <= 8);
+        assert_eq!(
+            items
+                .iter()
+                .map(|i| i["text"].as_str().expect("fixture"))
+                .collect::<String>(),
+            prompt
+        );
+        assert_eq!(
+            request(0, Method::TurnStart, json!({})).err(),
+            Some(HarnessFailure::Protocol)
+        );
+        assert_eq!(
+            request(1, Method::TurnStart, json!([])).err(),
+            Some(HarnessFailure::Protocol)
+        );
+    }
+
+    #[test]
+    fn incoming_frames_have_one_shape_each() {
+        let ok = |s: &str| Incoming::decode(s.as_bytes());
+        assert!(matches!(
+            ok(r#"{"id":3,"result":{}}"#),
+            Ok(Incoming::Response {
+                id: RequestId::Number(3),
+                ..
+            })
+        ));
+        assert!(matches!(
+            ok(r#"{"id":3,"error":{"code":-32600}}"#),
+            Ok(Incoming::Failure {
+                code: Some(-32600),
+                ..
+            })
+        ));
+        assert!(matches!(
+            ok(r#"{"method":"turn/started","params":{}}"#),
+            Ok(Incoming::Notification { .. })
+        ));
+        assert!(matches!(
+            ok(r#"{"id":"a","method":"item/tool/call","params":{}}"#),
+            Ok(Incoming::Request { .. })
+        ));
+        for bad in [
+            "",
+            "[]",
+            "not json",
+            r#"{"id":1}"#,
+            r#"{"id":1,"result":{},"error":{}}"#,
+            r#"{"method":""}"#,
+            r#"{"method":"x","params":[]}"#,
+            r#"{"id":-1,"result":{}}"#,
+            r#"{"id":1.5,"result":{}}"#,
+            r#"{"id":1,"result":{},"other":1}"#,
+            r#"{"jsonrpc":"1.0","id":1,"result":{}}"#,
+            r#"{"id":1,"error":"text"}"#,
+            r#"{"id":1,"method":"x","result":{}}"#,
+        ] {
+            assert!(Incoming::decode(bad.as_bytes()).is_err(), "{bad}");
+        }
+        let big = format!(
+            r#"{{"method":"x","params":{{"t":"{}"}}}}"#,
+            "a".repeat(EVENT_LIMIT)
+        );
+        assert_eq!(
+            Incoming::decode(big.as_bytes()).err(),
+            Some(HarnessFailure::Bounds)
+        );
+    }
+}
