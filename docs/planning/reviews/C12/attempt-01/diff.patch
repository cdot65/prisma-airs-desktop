+    let mut desk = desk.restart().await;
+    let context = desk.context();
+    desk.send(json!({"kind": "openLibrary", "context": context}))
+        .await
+        .expect("open");
+    assert!(eventually(|| desk.snap().library.state == LibraryState::Failed).await);
