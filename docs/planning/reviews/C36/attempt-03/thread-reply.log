//! Input fingerprints bound into review packets and receipts.
//!
//! * source: every tracked or untracked-but-not-ignored file (path, mode,
//!   content or symlink target) plus the repository `.git/config`, minus a
//!   narrow set of mutable evidence locations that are hashed separately.
//! * dependencies: lockfiles, toolchain pin, the consumed immutable inputs
//!   under `.inputs/`, and the resolved build-tool identities.
//! * build_flags: the subject's manifest entries, Tauri configuration and
//!   capability files, target and fixture-feature policy.
//! * evidence: the subject's committed evidence directory.

use std::collections::BTreeMap;
use std::os::unix::fs::PermissionsExt;
use std::path::Path;
use std::process::Command;

use serde::{Deserialize, Serialize};

use crate::manifest::Manifest;
use crate::{Repo, Result, Subject, invalid, io_err, sha256_hex};

/// Mutable locations excluded from the source fingerprint. Each is hashed
/// independently (evidence fingerprint, receipts) so exclusion cannot hide
/// application sources, lockfiles, tests or configuration.
pub const SOURCE_EXCLUSIONS: [&str; 3] = [
    "docs/planning/status.md",
    "docs/planning/reviews/",
    "docs/planning/evidence/",
];

#[derive(Clone, Debug, PartialEq, Eq, Serialize, Deserialize)]
#[serde(deny_unknown_fields)]
pub struct Fingerprints {
    pub source: String,
    pub dependencies: String,
    pub build_flags: String,
    pub evidence: String,
}

/// One entry of the source inventory.
#[derive(Clone, Debug, PartialEq, Eq, Serialize, Deserialize)]
pub struct FileEntry {
    pub path: String,
    pub mode: String,
    pub sha256: String,
}

pub fn is_excluded(path: &str) -> bool {
    SOURCE_EXCLUSIONS.iter().any(|excluded| {
        if excluded.ends_with('/') {
            path.starts_with(excluded)
        } else {
            path == *excluded
        }
    })
}

/// Lists source files via git: tracked plus untracked files not ignored.
pub fn source_inventory(repo: &Repo) -> Result<Vec<FileEntry>> {
    let output = Command::new("/usr/bin/git")
        .args([
            "ls-files",
            "-z",
            "--cached",
            "--others",
            "--exclude-standard",
        ])
        .current_dir(repo.root())
        .env_clear()
        .env("PATH", "/usr/bin:/bin")
        .env("HOME", std::env::var("HOME").unwrap_or_default())
        .output()
        .map_err(io_err(repo.root()))?;
    if !output.status.success() {
        return Err(invalid("git ls-files failed"));
    }
    let mut paths: Vec<String> = output
        .stdout
        .split(|b| *b == 0)
        .filter(|p| !p.is_empty())
        .map(|p| String::from_utf8_lossy(p).into_owned())
        .filter(|p| !is_excluded(p))
        .collect();
    paths.sort();
    paths.dedup();
    let mut entries = Vec::with_capacity(paths.len() + 1);
    for path in paths {
        entries.push(file_entry(repo.root(), &path)?);
    }
    entries.push(file_entry(repo.root(), ".git/config")?);
    Ok(entries)
}

fn file_entry(root: &Path, relative: &str) -> Result<FileEntry> {
    let full = root.join(relative);
    let Ok(meta) = std::fs::symlink_metadata(&full) else {
        return Ok(FileEntry {
            path: relative.to_owned(),
            mode: "deleted".to_owned(),
            sha256: String::new(),
        });
    };
    if meta.file_type().is_symlink() {
        let target = std::fs::read_link(&full).map_err(io_err(&full))?;
        return Ok(FileEntry {
            path: relative.to_owned(),
            mode: "symlink".to_owned(),
            sha256: sha256_hex(target.as_os_str().as_encoded_bytes()),
        });
    }
    let bytes = std::fs::read(&full).map_err(io_err(&full))?;
    let executable = meta.permissions().mode() & 0o111 != 0;
    Ok(FileEntry {
        path: relative.to_owned(),
        mode: if executable { "100755" } else { "100644" }.to_owned(),
        sha256: sha256_hex(&bytes),
    })
}

pub fn inventory_hash(entries: &[FileEntry]) -> String {
    let text: String = entries
        .iter()
        .map(|e| format!("{}\0{}\0{}\n", e.path, e.mode, e.sha256))
        .collect();
    sha256_hex(text.as_bytes())
}

pub fn source(repo: &Repo) -> Result<String> {
    Ok(inventory_hash(&source_inventory(repo)?))
}

/// Hash of every regular file under a directory (relative paths, sorted).
pub fn tree_hash(dir: &Path) -> Result<String> {
    tree_hash_excluding(dir, &[])
}

/// Like [`tree_hash`], skipping directories with the given names.
pub fn tree_hash_excluding(dir: &Path, skip: &[&str]) -> Result<String> {
    let mut entries = Vec::new();
    collect_tree(dir, dir, skip, &mut entries)?;
    entries.sort_by(|a, b| a.path.cmp(&b.path));
    Ok(inventory_hash(&entries))
}

fn collect_tree(root: &Path, dir: &Path, skip: &[&str], out: &mut Vec<FileEntry>) -> Result<()> {
    let mut children: Vec<_> = std::fs::read_dir(dir)
        .map_err(io_err(dir))?
        .filter_map(|e| e.ok())
        .collect();
    children.sort_by_key(|e| e.file_name());
    for child in children {
        let path = child.path();
        let relative = path
            .strip_prefix(root)
            .map_err(|_| invalid("path escaped its root"))?
            .to_string_lossy()
            .into_owned();
        let meta = std::fs::symlink_metadata(&path).map_err(io_err(&path))?;
        if meta.is_dir() {
            if skip.iter().any(|name| child.file_name() == *name) {
                continue;
            }
            collect_tree(root, &path, skip, out)?;
        } else {
            out.push(file_entry(root, &relative)?);
        }
    }
    Ok(())
}

/// Dependency inputs: lockfiles, toolchain pin, immutable inputs, tools.
pub fn dependencies(repo: &Repo, toolchain_hash: &str) -> Result<String> {
    let mut parts: BTreeMap<String, String> = BTreeMap::new();
    for file in [
        "Cargo.lock",
        "pnpm-lock.yaml",
        "rust-toolchain.toml",
        ".npmrc",
        "docs/architecture/inputs.lock.json",
    ] {
        let path = repo.join(file);
        let digest = match std::fs::read(&path) {
            Ok(bytes) => sha256_hex(&bytes),
            Err(_) => "absent".to_owned(),
        };
        parts.insert(file.to_owned(), digest);
    }
    let inputs = repo.join(".inputs");
    if inputs.is_dir() {
        let mut names: Vec<_> = std::fs::read_dir(&inputs)
            .map_err(io_err(&inputs))?
            .filter_map(|e| e.ok())
            .filter(|e| e.path().is_dir())
            .map(|e| e.file_name().to_string_lossy().into_owned())
            .collect();
        names.sort();
        for name in names {
            parts.insert(format!(".inputs/{name}"), tree_hash(&inputs.join(&name))?);
        }
    }
    for (label, hash) in consumed_shared(repo)? {
        parts.insert(label, hash);
    }
    parts.insert("toolchain".to_owned(), toolchain_hash.to_owned());
    Ok(sha256_hex(
        serde_json::to_string(&parts).unwrap_or_default().as_bytes(),
    ))
}

/// Build flags: the subject's manifest entries and native configuration,
/// as canonical JSON (sorted keys, compact) so independent tools can
/// recompute it.
pub fn build_flags(repo: &Repo, manifest: &Manifest, subject: Subject) -> Result<String> {
    use serde_json::{Value, json};
    let mut parts: BTreeMap<String, Value> = BTreeMap::new();
    let chunks = if subject.is_phase() {
        manifest.phase_chunks(subject)?
    } else {
        vec![subject]
    };
    for chunk in chunks {
        let entry = manifest.chunk(chunk)?;
        parts.insert(
            format!("chunk/{chunk}"),
            // Keys in sorted order so the canonical form is independent of
            // serde_json's map ordering features.
            json!({
                "fixture": entry.fixture_command,
                "frontend": entry.frontend_commands,
                "host": entry.host_commands,
                "native_prepare": entry.native_prepare,
            }),
        );
    }
    parts.insert("setup".to_owned(), json!(manifest.setup_commands));
    parts.insert(
        "phase_native".to_owned(),
        json!(manifest.phase_native_prepare),
    );
    parts.insert("common".to_owned(), json!(manifest.common_commands));
    parts.insert("shared".to_owned(), json!(manifest.shared_source_commands));
    parts.insert("artifact".to_owned(), json!(manifest.artifact_build));
    parts.insert("target".to_owned(), json!(manifest.target));
    parts.insert(
        "fixture_only".to_owned(),
        json!(manifest.fixture_only_features),
    );
    parts.insert(
        "production_features".to_owned(),
        json!(manifest.requested_production_features),
    while let Some(d) = stack.pop() {
        for entry in std::fs::read_dir(&d).map_err(io_err(&d))? {
            let entry = entry.map_err(io_err(&d))?;
            let meta = std::fs::symlink_metadata(entry.path()).map_err(io_err(&entry.path()))?;
            if meta.is_dir() {
                stack.push(entry.path());
            } else if meta.is_file() {
                total += meta.len();
            }
        }
    }
    Ok(total)
}

/// Builds the complete unsigned production app and DMG with the sealed
/// Harness engine as a bundle resource (C19, D046): the frontend, then
/// `tauri build` with `tauri.harness.conf.json`. Returns the app and DMG.
pub fn build_production(repo: &Repo, env: &Environment, target: &str) -> Result<ProductionBuild> {
    // The sealed engine the production app ships with (C19).
    crate::harness::unpack(repo)?;
    let commands: Vec<Vec<String>> = [
        vec!["pnpm", "--filter", "@prisma-airs/desktop", "build"],
        vec![
            "pnpm",
            "--filter",
            "@prisma-airs/desktop",
            "exec",
            "tauri",
            "build",
            "--ci",
            "--no-sign",
            "--target",
            target,
            "--bundles",
            "app,dmg",
            // The sealed Harness engine as a bundle resource (C19, D046).
            "--config",
            "src-tauri/tauri.harness.conf.json",
        ],
    ]
    .iter()
    .map(|argv| argv.iter().map(|s| (*s).to_owned()).collect())
    .collect();
    for argv in &commands {
        let status = env
            .command(argv, repo.root())?
            .status()
            .map_err(io_err(repo.root()))?;
        if !status.success() {
            return Err(invalid(format!("{} failed with {status}", argv.join(" "))));
        }
    }
    let app = bundle_path(repo, target, PRODUCT);
    let identifier = plist_value(&app, "CFBundleIdentifier")?;
    if identifier != crate::native::PRODUCTION_IDENTIFIER {
        return Err(invalid(format!(
            "the production bundle has identifier {identifier}"
        )));
    }
    let version = plist_value(&app, "CFBundleShortVersionString")?;
    let dmg = repo.join(format!(
        "target/{target}/release/bundle/dmg/{PRODUCT}_{version}_aarch64.dmg"
    ));
    Ok(ProductionBuild {
        app,
        dmg,
        identifier,
        commands,
    })
}

/// A production build: the app, its DMG, the bundle identifier and the
/// commands that built them.
pub struct ProductionBuild {
    pub app: PathBuf,
    pub dmg: PathBuf,
    pub identifier: String,
    pub commands: Vec<Vec<String>>,
}

const MIB: f64 = 1024.0 * 1024.0;

/// Builds the complete unsigned production app and DMG, the sealed Harness
/// engine included (C19, D046; budgets.json version 5), and records their
/// sizes.
pub fn footprint(
    repo: &Repo,
    manifest: &Manifest,
    env: &Environment,
    subject: Subject,
) -> Result<Footprint> {
    let Some(chunk) = required(repo, manifest, subject)? else {
        return Err(invalid(format!(
            "{subject} does not contain the chunk that registered the budgets"
        )));
    };
    let (_, record, sha) = registration(repo, &chunk)?;
    let started_utc = now_utc();
    if started_utc < record.registered_utc {
        return Err(invalid("the clock is before the budget registration"));
    }
    let target = manifest.target.as_str();
    let ProductionBuild {
        app,
        dmg,
        identifier,
        commands,
    } = build_production(repo, env, target)?;
    let dmg_bytes = std::fs::read(&dmg).map_err(io_err(&dmg))?;
    let relative = |p: &Path| {
        p.strip_prefix(repo.root())
            .unwrap_or(p)
            .display()
            .to_string()
    };
    let mut metrics = BTreeMap::new();
    metrics.insert(
        "app-bundle-bytes".to_owned(),
        Metric {
            unit: "MiB".to_owned(),
            samples: vec![file_bytes(&app)? as f64 / MIB],
        },
    );
    metrics.insert(
        "dmg-bytes".to_owned(),
        Metric {
    --v2-block-bg: #3d1f1c;
    --v2-flag: #fabd2f;
    --v2-flag-bg: #3a3019;
    --v2-ok: #b8bb26;
    --v2-ok-bg: #2b2f17;
    --v2-get: #83a598;
}

/* The v2 shell root: body background, type and the visible focus ring
 * (invariant: accent-colour ring on every focusable control; inset variant
 * where a control declares it). */
[data-v2-shell] {
    background: var(--v2-bg);
    color: var(--v2-ink);
    font-size: var(--v2-text);
    font-family: -apple-system, BlinkMacSystemFont, 'SF Pro Text', system-ui, sans-serif;
    min-height: 100vh;
}
/* The destination heading takes focus after navigation for assistive technology; it is not a control, so no ring (C35). */
[data-v2-shell] h1[tabindex='-1']:focus {
    outline: none;
}
/* A page inside the shell's main region: the prototype's 32/44 margins, scrolling by itself. */
[data-v2-shell] [data-v2-page] {
    padding: var(--v2-page-top) var(--v2-page-x) 28px;
    overflow-y: auto;
    min-height: 0;
    flex-grow: 1;
    min-width: 0;
}
[data-v2-shell] :focus-visible {
    outline: 2px solid var(--v2-acc);
    outline-offset: 2px;
}
[data-v2-shell] [data-inset-focus]:focus-visible {
    outline-offset: -4px;
}
[data-v2-shell] input,
[data-v2-shell] select,
[data-v2-shell] textarea {
    border: 1px solid var(--v2-ctl);
    border-radius: var(--v2-radius-control);
    background: var(--v2-bg);
    color: var(--v2-ink);
    min-height: var(--v2-control);
}
/* Rail collapses to icons below 1280 CSS px; nothing scrolls horizontally. */
[data-v2-shell] {
    overflow-x: hidden;
}
@media (max-width: 1279px) {
    [data-v2-rail] {
        width: 64px !important;
    }
    /* Collapsed: one 32px control per row; icons stay, labels leave the
     * layout but stay in the accessible name. */
    [data-v2-rail] [data-v2-stack] {
        flex-direction: column;
        align-items: stretch;
    }
    [data-v2-rail] [data-v2-stack] > * {
        width: 100%;
    }
    /* Collapsed: labels leave the layout but stay in the accessible name (rail and header). */
    [data-v2-rail] [data-v2-label],
    [data-v2-header] [data-v2-label] {
        position: absolute;
        width: 1px;
        height: 1px;
        overflow: hidden;
        clip: rect(0 0 0 0);
        white-space: nowrap;
    }
    /* Collapsed: the product children and the status rows leave the rail (C35). */
    [data-v2-rail] [data-v2-collapse] {
        display: none !important;
    }
    [data-v2-rail] [data-v2-stack] > * {
        padding-left: 0 !important;
        padding-right: 0 !important;
    }
    [data-v2-header] [data-v2-search] {
        width: auto !important;
        flex: 1 1 120px !important;
        min-width: 0;
    }
    /* Home's attention and quick-action sections stack when the page is narrow (C36). */
    [data-v2-shell] [data-slot='home-lower'] {
        grid-template-columns: minmax(0, 1fr) !important;
    }
}
/* The selected destination is accent-filled, so its ring is the ink-on-accent
