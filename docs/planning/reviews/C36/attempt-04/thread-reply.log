    # ---- N01: the board's regions from one read ------------------------------------
    n1 = {}
    tree = app.tree()
    n1["heading"] = fx.App.node(tree, "AXHeading", "Home") is not None
    status = next((n for n in tree if n.get("subrole") == "AXApplicationStatus"), None)
