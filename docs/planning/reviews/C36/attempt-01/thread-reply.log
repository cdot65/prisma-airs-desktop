   101	/** The products the read reports on (the inventory ids with an admitted service). */
   102	const readIdOf = (id: AdminProductId): ProductId | null => (id === 'agenticIdentity' || id === 'agenticEndpoint' ? null : id)
   103	
   104	const dollars = (cents: number) => `$${(cents / 100).toFixed(2)}`
   105	const count = (n: number) => n.toLocaleString('en-US')
