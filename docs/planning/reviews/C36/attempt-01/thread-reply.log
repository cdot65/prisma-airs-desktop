    const tomorrow = new Date(today.getTime() + 86_400_000)
    const day = dayOf(d) === dayOf(today) ? 'today' : dayOf(d) === dayOf(tomorrow) ? 'tomorrow' : d.toLocaleDateString(undefined, { month: 'short', day: 'numeric' })
    return `${day} ${clockOf(seconds)}`
}

