    63	/**
    64	 * The one line under the greeting (R2App `homeSub`): the product count, the
    65	 * core's read-status line (I4: pending, reading, finished with its coverage,
    66	 * or failed, exactly as `readLine` says it) and the needs-action count.
    67	 */
    68	export function homeSub(snapshot: ShellSnapshot, tenant: string, products: number, needing: number): string {
    69	    const parts = [HOME_COPY.sub.products(products), readLine(snapshot, tenant).text]
    70	    if (needing > 0) parts.push(HOME_COPY.sub.needAction(needing))
    71	    return parts.join(' · ')
    72	}
