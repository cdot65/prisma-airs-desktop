    74	type Pill = { word: string; bg: string; fg: string; glyph: GlyphName }
    75	const PILLS: Record<'ok' | 'partial' | 'role' | 'pending' | 'failed' | 'gated', Pill> = {
    76	    ok: { word: HOME_COPY.pill.connected, bg: 'var(--v2-ok-bg)', fg: 'var(--v2-ok)', glyph: 'check' },
    77	    partial: { word: HOME_COPY.pill.partial, bg: 'var(--v2-flag-bg)', fg: 'var(--v2-flag)', glyph: 'alert' },
    78	    role: { word: HOME_COPY.pill.needsRole, bg: 'var(--v2-flag-bg)', fg: 'var(--v2-flag)', glyph: 'alert' },
    79	    pending: { word: HOME_COPY.pill.connecting, bg: 'var(--v2-inset)', fg: 'var(--v2-soft)', glyph: 'clock' },
    80	    failed: { word: HOME_COPY.pill.failed, bg: 'var(--v2-block-bg)', fg: 'var(--v2-block)', glyph: 'ban' },
    81	    gated: { word: HOME_COPY.pill.unavailable, bg: 'var(--v2-inset)', fg: 'var(--v2-faint)', glyph: 'lock' },
    82	}
    83	
    84	interface Card {
    85	    id: AdminProductId
    86	    /** The read can be asked for again (a role granted, a failure, partial coverage): the C30 recheck. */
    87	    recheck: ProductId | null
    88	    name: string
    89	    pill: Pill
    90	    value: string
    91	    valueColor: string
    92	    metric: string
    93	    spark: { h: number; hot: boolean }[]
    94	    sub: string
    95	    subColor: string
    96	    subGlyph: GlyphName
    97	    isNew: boolean
    98	    gated: boolean
