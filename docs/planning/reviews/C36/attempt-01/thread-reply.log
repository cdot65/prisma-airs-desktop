    15	 * What the empty attention list may say (I4): an all-clear only after a
    16	 * complete read; otherwise the unread, in-progress, failed or partial
    17	 * coverage is named instead.
    18	 */
    19	export function attentionEmpty(snapshot: ShellSnapshot): string {
    20	    const read = snapshot.inbox.read
    21	    if (read.state === 'pending') return HOME_COPY.firstRead
    22	    if (read.state === 'reading' && read.lastReadAt === null) return HOME_COPY.reading
    23	    if (read.state === 'failed' && read.failedAt !== null) {
    24	        return read.lastReadAt === null ? READ_COPY.failed(clockOf(read.failedAt)) : HOME_COPY.clearSoFar(READ_COPY.failedKept(clockOf(read.failedAt), clockOf(read.lastReadAt)))
    25	    }
    26	    // A read in progress shows the cached read until the new one lands: its age stays named (C12).
    27	    const stale = read.lastReadAt !== null && !snapshot.overview.fresh
    28	    if (read.state === 'reading' && read.lastReadAt !== null) return HOME_COPY.clearSoFar(stale ? READ_COPY.readingStaleQualifier(clockOf(read.lastReadAt)) : READ_COPY.readingQualifier(clockOf(read.lastReadAt)))
    29	    if (read.sourcesMissing.length > 0) return HOME_COPY.clearSoFar(READ_COPY.unread(read.sourcesMissing.length))
    30	    // A healthy empty read older than the freshness window is a gap, not an all-clear (C12).
    31	    if (stale) return HOME_COPY.clearSoFar(READ_COPY.staleQualifier(clockOf(read.lastReadAt ?? 0)))
    32	    return HOME_COPY.allClear
    33	}
