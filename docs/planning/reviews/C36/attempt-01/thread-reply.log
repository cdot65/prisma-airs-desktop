    35	/** The read-status line (I4): first read pending, reading, finished (with partial coverage), or failed. */
    36	export function readLine(snapshot: ShellSnapshot, tenant: string | null): { text: string; tone: 'info' | 'flagged' | 'allowed' | 'blocked' } {
    37	    const read = snapshot.inbox.read
    38	    if (!tenant) return { text: HOME_COPY.noTenant, tone: 'info' }
    39	    if (read.state === 'reading' && read.lastReadAt === null) return { text: HOME_COPY.reading, tone: 'info' }
    40	    // Reading again: the cached read stays shown, with its age, until the new one lands.
    41	    if (read.state === 'reading' && read.lastReadAt !== null) {
    42	        const when = clockOf(read.lastReadAt)
    43	        return snapshot.overview.fresh ? { text: READ_COPY.readingKept(when), tone: 'info' } : { text: READ_COPY.readingStale(when), tone: 'flagged' }
    44	    }
    45	    // A failed read is failed, attempted or not before: never "pending", never an all-clear.
    46	    if (read.state === 'failed' && read.failedAt !== null) {
    47	        return read.lastReadAt === null ? { text: READ_COPY.failed(clockOf(read.failedAt)), tone: 'blocked' } : { text: READ_COPY.failedKept(clockOf(read.failedAt), clockOf(read.lastReadAt)), tone: 'blocked' }
    48	    }
    49	    if (read.state === 'pending' || (read.lastReadAt === null && read.settledAt === null)) return { text: HOME_COPY.firstRead, tone: 'info' }
    50	    // A settled attempt that established nothing (every source needs a role)
    51	    // is announced for when it settled, never as a first read still pending.
    52	    const when = clockOf(read.lastReadAt ?? read.settledAt ?? 0)
    53	    const needsRole = read.products.filter((p) => p.state === 'needsRole').length
    54	    if (needsRole > 0) return { text: READ_COPY.finishedNeedsRole(when, needsRole), tone: 'flagged' }
    55	    if (read.sourcesMissing.length > 0) return { text: READ_COPY.finishedIncomplete(when, read.sourcesMissing.length), tone: 'flagged' }
    56	    // Expired coverage stays distinct from healthy-empty (C12): the cached read is kept, its age named.
    57	    if (read.lastReadAt !== null && !snapshot.overview.fresh) return { text: READ_COPY.stale(when), tone: 'flagged' }
    58	    const activity = snapshot.overview.read?.summary.sessions
    59	    if (activity === 0 && snapshot.inbox.items.length === 0) return { text: READ_COPY.finishedNoActivity(when, tenant), tone: 'allowed' }
    60	    return { text: READ_COPY.finished(when), tone: 'allowed' }
    61	}
