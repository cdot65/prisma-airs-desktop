   107	/**
   108	 * One card per Administration product (R2App `cards`), from the core only:
   109	 * Runtime's headline is the read's detection events over its chart; the
   110	 * Gateway's is the chosen workspace's day; Red Teaming and model/skill scans
   111	 * carry their read state (the core publishes no figures for them); the two
   112	 * gated products carry their gate. Nothing scripted is drawn.
   113	 */
   114	export function cardOf(snapshot: ShellSnapshot, product: AdminProduct, attention: InboxEntry[]): Card {
   115	    const readId = readIdOf(product.id)
   116	    const read = snapshot.inbox.read
   117	    const state: ProductRead | undefined = readId ? read.products.find((p) => p.product === readId) : undefined
   118	    const recheck = readId && state && (state.state === 'needsRole' || state.state === 'failed' || state.state === 'incomplete') ? readId : null
   119	    const base = { id: product.id, name: product.label, isNew: product.availability.state === 'unavailable', gated: product.availability.state === 'unavailable', recheck }
   120	    const blank = (pill: Pill, sub: string, subColor = 'var(--v2-faint)', subGlyph: GlyphName = 'clock'): Card => ({ ...base, pill, value: '—', valueColor: 'var(--v2-faint)', metric: HOME_COPY.metric[product.id] ?? '', spark: [], sub, subColor, subGlyph })
   121	    if (product.availability.state === 'unavailable') return blank(PILLS.gated, product.availability.reason, 'var(--v2-faint)', 'lock')
   122	    if (!state || state.state === 'pending' || state.state === 'notRead') return blank(PILLS.pending, read.state === 'reading' ? HOME_COPY.reading : HOME_COPY.firstRead)
   123	    if (state.state === 'needsRole') return blank(PILLS.role, HOME_COPY.cardNeedsRole(state.detail), 'var(--v2-flag)', 'alert')
   124	    if (state.state === 'failed') return blank(PILLS.failed, state.detail ?? READ_COPY.productState.failed ?? 'Failed', 'var(--v2-block)', 'ban')
   125	    const pill = state.state === 'incomplete' ? PILLS.partial : PILLS.ok
   126	    const worst = attention.find((e) => e.product === readId)
   127	    const overview = snapshot.overview.read
   128	    if (product.id === 'runtimeSecurity' && overview) {
   129	        const events = overview.summary.detectionEvents
   130	        const buckets = overview.chart?.buckets ?? []
   131	        const max = Math.max(1, ...buckets.map((b) => b.violating))
   132	        const spark = buckets.slice(-12).map((b) => ({ h: Math.max(2, Math.round((b.violating / max) * 38)), hot: b.violating > 0 }))
   133	        const violating = overview.summary.violating ?? 0
   134	        return {
   135	            ...base,
   136	            pill,
   137	            value: events === null ? '—' : count(events),
   138	            valueColor: events !== null && events > 0 ? 'var(--v2-block)' : 'var(--v2-ink)',
   139	            metric: HOME_COPY.metric.runtimeSecurity,
   140	            spark,
   141	            sub: worst ? worst.title : violating > 0 ? HOME_COPY.runtimeViolating(violating) : HOME_COPY.noDetections,
   142	            subColor: worst ? (worst.severity === 'bad' ? 'var(--v2-block)' : 'var(--v2-flag)') : 'var(--v2-soft)',
   143	            subGlyph: worst ? (worst.severity === 'bad' ? 'ban' : 'alert') : 'check',
   144	        }
   145	    }
   146	    if (product.id === 'gateway' && overview?.gateway) {
   147	        const g = overview.gateway
   148	        const requests = g.requests
   149	        const errors = g.errors
   150	        const rate = requests && errors !== null && requests > 0 ? (errors / requests) * 100 : null
   151	        return {
   152	            ...base,
   153	            pill: g.partial ? PILLS.partial : pill,
   154	            value: requests === null ? '—' : count(requests),
   155	            valueColor: 'var(--v2-ink)',
   156	            metric: g.cost === null ? HOME_COPY.metric.gateway : `${HOME_COPY.metric.gateway} · ${dollars(g.cost)}`,
   157	            spark: [],
   158	            sub: worst ? worst.title : rate === null ? HOME_COPY.gatewayNoErrors(g.workspaceName) : HOME_COPY.gatewayErrorRate(rate),
   159	            subColor: worst ? (worst.severity === 'bad' ? 'var(--v2-block)' : 'var(--v2-flag)') : rate !== null && rate > 5 ? 'var(--v2-block)' : 'var(--v2-soft)',
   160	            subGlyph: worst ? (worst.severity === 'bad' ? 'ban' : 'alert') : rate !== null && rate > 5 ? 'ban' : 'check',
   161	        }
   162	    }
   163	    // Read-state cards: the read's coverage is the figure the core has.
   164	    return {
   165	        ...base,
   166	        pill,
   167	        value: state.sourcesTotal > 0 ? `${state.sourcesRead}/${state.sourcesTotal}` : '—',
   168	        valueColor: 'var(--v2-ink)',
   169	        metric: HOME_COPY.metric[product.id] ?? READ_COPY.sources(state.sourcesRead, state.sourcesTotal),
   170	        spark: [],
   171	        sub: worst ? worst.title : state.detail ?? (state.state === 'incomplete' ? HOME_COPY.partialRead(state.sourcesRead, state.sourcesTotal) : HOME_COPY.readOnly),
   172	        subColor: worst ? (worst.severity === 'bad' ? 'var(--v2-block)' : 'var(--v2-flag)') : state.state === 'incomplete' ? 'var(--v2-flag)' : 'var(--v2-soft)',
   173	        subGlyph: worst ? (worst.severity === 'bad' ? 'ban' : 'alert') : state.state === 'incomplete' ? 'alert' : 'check',
   174	    }
   175	}
   176	
   177	const severityTile = (e: InboxEntry): { glyph: GlyphName; fg: string; bg: string } =>
