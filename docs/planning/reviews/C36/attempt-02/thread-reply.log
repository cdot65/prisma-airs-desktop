import { forwardRef, useEffect } from 'react'
import type { FeatureId, InboxEntry, Intent, ShellSnapshot } from '@prisma-airs/desktop-contracts'
import type { DispatchOutcome } from '../../features/tenants/dispatch'
import { INBOX_COPY as C, READ_COPY, SHELL_COPY, SNOOZE_COPY, clockOf } from '../copy'
import { useShellStore } from '../store'
import { Verdict, type VerdictTone } from '../verdict'

/**
 * Sends one intent and reports its outcome on the shell's surfaces (DESIGN-V2
 * §7): a refusal or failed delivery as a warn toast naming `what`, an
 * unconfirmed delivery inline with Retry (never replayed on its own).
 */
export type Act = (what: string, intent: Intent) => Promise<DispatchOutcome>

export interface InboxProps {
    snapshot: ShellSnapshot
    onAct: Act
    onNavigate: (feature: FeatureId) => void
}

export type InboxTab = 'all' | 'action' | 'updates' | 'snoozed'
const TABS: InboxTab[] = ['all', 'action', 'updates', 'snoozed']

export const toneOf = (severity: InboxEntry['severity']): VerdictTone => (severity === 'bad' ? 'blocked' : severity === 'warn' ? 'flagged' : 'info')

/** Where an entry's action leads (C30): the destination the core names. */
export function destinationFeature(entry: InboxEntry): FeatureId | null {
    return entry.target?.feature ?? null
}

/**
 * Follows an entry's contextual action: the target's inventory and item are
 * handed to the destination (it selects them on arrival), then the shell
 * navigates through the core.
 */
export function follow(entry: InboxEntry, tenant: string, onNavigate: (feature: FeatureId) => void) {
    const target = entry.target
    if (!target) return
    // The target belongs to the tenant it was followed in (I2): another tenant never inherits it.
    useShellStore.getState().arrive({ tenant, feature: target.feature, resource: target.resource, item: target.item })
    onNavigate(target.feature)
}

/** The tenant-named description of a hold action, for its outcome report. */
export function holdWhat(kind: 'acknowledgeItem' | 'snoozeItem' | 'unsnoozeItem', title: string): string {
    return kind === 'acknowledgeItem' ? SHELL_COPY.acknowledgmentOf(title) : kind === 'snoozeItem' ? SHELL_COPY.snoozeOf(title) : SHELL_COPY.unsnoozeOf(title)
}

/** Which tab an entry belongs to; held entries are never "needs action". */
export function tabOf(entry: InboxEntry): InboxTab {
    if (entry.hold?.kind === 'snooze') return 'snoozed'
    if (entry.needsAction && !entry.hold) return 'action'
    return 'updates'
}

/**
 * The Inbox (C30, screens/inbox-reads.md): the active tenant's entries from
 * the core's Inbox scope, in tabs with counts, a detail pane with the facts,
 * the explanation and the contextual actions. Acknowledge and snooze are
 * core intents on the entry; the snooze return time is the core's and the
 * label is the one Home uses (I11). The selected tab and item are kept per
 * tenant across a switch (I2) and cleared when the tenant is deleted.
 */
export const Inbox = forwardRef<HTMLHeadingElement, InboxProps>(function Inbox({ snapshot, onAct, onNavigate }, ref) {
    const tenant = snapshot.tenants.find((t) => t.id === snapshot.active?.tenant) ?? null
    const context = snapshot.active?.context ?? null
    const tenantKey = tenant?.id ?? 'none'
    const selection = useShellStore((s) => s.inboxSelection[tenantKey])
    const selectInbox = useShellStore((s) => s.selectInbox)
    const tab: InboxTab = selection?.tab ?? 'all'
    const selectedId = selection?.item ?? null
    const items = snapshot.inbox.items
    const counts: Record<InboxTab, number> = { all: items.length, action: 0, updates: 0, snoozed: 0 }
    for (const e of items) counts[tabOf(e)] += 1
    const visible = items.filter((e) => tab === 'all' || tabOf(e) === tab)
    const selected = items.find((e) => e.id === selectedId) ?? null
    useEffect(() => {
        if (selectedId && !items.some((e) => e.id === selectedId)) selectInbox(tenantKey, { tab, item: null })
    }, [items, selectedId, selectInbox, tenantKey, tab])
    const read = snapshot.inbox.read

    // Holds are core intents; their outcomes reach the shell's surfaces. A
    // snooze's return time is the core's: the shell announces it from the
    // receipt the snapshot carries (the same toast whether asked here or on Home).
    const act = (entry: InboxEntry, kind: 'acknowledgeItem' | 'snoozeItem' | 'unsnoozeItem') => context && void onAct(holdWhat(kind, entry.title), { kind, context, id: entry.id })
    const readNow = () => context && tenant && void onAct(SHELL_COPY.readOf(tenant.label), { kind: 'readTenant', context })

    // Never attempted, in progress, failed, partial, expired and healthy-empty
    // reads stay distinct (I4, C12). Entries the core supplies (a setup
    // warning before any read) are listed whatever the read status.
    const failedUnread = read.state === 'failed' && read.lastReadAt === null && read.failedAt !== null
    const stale = (read.state === 'done' || read.state === 'reading') && read.lastReadAt !== null && !snapshot.overview.fresh
    const readingAgain = read.state === 'reading' && read.lastReadAt !== null
    const empty = !tenant
        ? C.emptyPending
        : items.length === 0 && read.state === 'reading'
          ? C.emptyReading
          : items.length === 0 && read.state === 'pending'
            ? C.emptyPending
            : items.length === 0 && failedUnread
              ? C.emptyFailed(clockOf(read.failedAt ?? 0))
              : items.length === 0 && read.lastReadAt === null && read.settledAt !== null
                ? C.emptyUnread(clockOf(read.settledAt), read.sourcesMissing.length)
                : visible.length === 0
                  ? tab === 'all' || tab === 'action'
                      ? stale
                          ? C.emptyStale(clockOf(read.lastReadAt ?? 0))
                          : C.emptyClear
                      : C.emptyTab
                  : null
    const partialLine =
        read.state === 'failed' && read.failedAt !== null && read.lastReadAt !== null
            ? C.failedKept(clockOf(read.failedAt), clockOf(read.lastReadAt))
            : (read.lastReadAt ?? read.settledAt) !== null && read.sourcesMissing.length > 0
              ? C.partial(read.products.reduce((n, p) => n + p.sourcesRead, 0), read.products.reduce((n, p) => n + p.sourcesTotal, 0), clockOf(read.lastReadAt ?? read.settledAt ?? 0))
              : readingAgain
                ? stale
                    ? C.readingStale(clockOf(read.lastReadAt ?? 0))
                    : C.readingKept(clockOf(read.lastReadAt ?? 0))
                : stale
                  ? C.stale(clockOf(read.lastReadAt ?? 0))
                  : null

    return (
        <section aria-labelledby='inbox-heading' data-slot='inbox' className='flex min-h-0 flex-col gap-4'>
            <div className='flex items-end justify-between gap-4'>
                <div>
                    <h1 ref={ref} id='inbox-heading' tabIndex={-1} className='font-bold' style={{ fontSize: 'var(--v2-title)' }}>
                        {C.title}
                    </h1>
                    {partialLine && (
                        <p role='status' className='mt-1 text-[13px]' style={{ color: 'var(--v2-soft)' }}>
                            {partialLine}
                        </p>
                    )}
                </div>
                {context && (
                    <button type='button' onClick={readNow} disabled={read.state === 'reading'} className='h-8 rounded-[7px] border px-3 text-[13px] disabled:opacity-60' style={{ borderColor: 'var(--v2-rule)' }}>
                        {C.readNow}
                    </button>
                )}
            </div>
            <div role='tablist' aria-label={C.title} className='flex gap-1'>
                {TABS.map((t) => (
                    <button
                        key={t}
                        role='tab'
                        type='button'
                        aria-selected={tab === t}
                        onClick={() => selectInbox(tenantKey, { tab: t, item: selectedId })}
//! Runtime Home/Inbox state inside the authority (C12, C30): each opened
//! tenant's last overview read (kept when a refresh fails, marked with its
//! failure, and kept across a switch away and back, I2), the finite outcomes
//! of its other products' Home reads, its read bookkeeping, and the
//! operator's attention holds per tenant. A healthy empty source, a failed
//! one and one not yet read stay distinct; "all clear" is claimed only from
//! a fresh read of both sources with nothing open and no gap.
//!
//! A read is admitted under a context; its reply is recorded only while that
//! context is current (a retired context's reply is withdrawn and never
//! shown), but the tenant's recorded read outlives the context it was made
//! under: switching A → B → A shows A's cached read again until a new one
//! lands.

use serde::{Deserialize, Serialize};
use ts_rs::TS;

use super::{Refusal, State};
use crate::context::ContextRef;
use crate::features::ProductId;
use crate::management::{ManagementFailure, ManagementResult};
use crate::observation::{FRESH_SECS, HOLD_LIMIT, InboxItem, RuntimeOverview, SNOOZE_SECS, level};
use crate::tenants::TenantId;

/// How the operator set an attention item aside.
#[derive(Clone, Copy, Debug, PartialEq, Eq, Serialize, Deserialize, TS)]
#[serde(rename_all = "camelCase")]
pub enum HoldKind {
    /// Hidden until its level rises above the acknowledged level.
    Acknowledge,
    /// Hidden for 24 hours.
    Snooze,
}

#[derive(Clone, Debug, PartialEq, Eq)]
pub(super) struct Hold {
    pub(super) id: String,
    pub(super) kind: HoldKind,
    pub(super) level: u8,
    pub(super) until: u32,
}

/// What Needs attention can say (v1 faces, Runtime only).
#[derive(Clone, Copy, Debug, PartialEq, Eq, Serialize, TS)]
#[serde(rename_all = "camelCase")]
pub enum AttentionFace {
    /// Something needs attention.
    Items,
    /// Nothing has been read yet.
    FirstLaunch,
    /// A fresh, complete read of every source with nothing open.
    AllClear,
    /// Nothing open, but a source failed, is stale, partial or unknown.
    Gap,
}

#[derive(Clone, Debug, PartialEq, Eq, Serialize, TS)]
#[serde(rename_all = "camelCase")]
pub struct HeldItem {
    pub item: InboxItem,
    pub kind: HoldKind,
    /// When a snoozed item returns (seconds since the epoch), computed
    /// here (C30, I11); none for an acknowledgment.
    pub returns_at: Option<u32>,
}

#[derive(Clone, Debug, PartialEq, Eq, Serialize, TS)]
#[serde(rename_all = "camelCase")]
pub struct OverviewView {
    /// The last overview read for this tenant (kept when a refresh fails).
    pub read: Option<RuntimeOverview>,
    pub refreshing: bool,
    /// The last refresh failed (the shown read, if any, is older).
    pub failure: Option<ManagementFailure>,
    /// When the last refresh failed (seconds since the epoch).
    pub failed_at: Option<u32>,
    /// The read is younger than ten minutes.
    pub fresh: bool,
    /// Attention items not set aside (actionable, above normal).
    pub attention: Vec<InboxItem>,
    pub held: Vec<HeldItem>,
    pub face: AttentionFace,
}

/// The snooze the operator placed last in this session, announced once by
/// the presentation with the return time computed here (C30, I11).
#[derive(Clone, Debug, PartialEq, Eq, Serialize, TS)]
#[serde(rename_all = "camelCase")]
pub struct SnoozeReceipt {
    pub id: String,
    pub title: String,
    pub returns_at: u32,
    /// Counts snoozes placed on this tenant in this session: a change is a
    /// new snooze, however many snapshots repeat it.
    pub sequence: u32,
}

/// The finite outcome of one product's Home read (Red Team, model and
/// skill): which of its sources were established, by name, and the worst
/// failure. A listing counts as established only when its page is the
/// whole inventory (not capped, nothing beyond the first page).
#[derive(Clone, Debug, PartialEq, Eq)]
pub(super) struct ProductOutcome {
    pub(super) read_at: u32,
    pub(super) sources_read: u32,
    pub(super) sources_total: u32,
    /// The sources not established, by name.
    pub(super) missing: Vec<String>,
    pub(super) needs_role: bool,
    pub(super) failure: Option<ManagementFailure>,
    pub(super) detail: String,
}

/// A product read that established nothing (every source failed, or the
/// read never reached the service): kept apart from the last outcome that
/// did establish something, which stays shown as older.
/// The overview's time-dependent state, compared by the deadline ticker.
#[derive(Clone, Debug, PartialEq, Eq)]
pub(super) struct OverviewSignature {
    pub(super) fresh: bool,
    pub(super) face: AttentionFace,
    pub(super) attention: Vec<String>,
    /// The holds in effect now (an expired snooze drops out).
    pub(super) holds: Vec<String>,
}

#[derive(Clone, Debug, PartialEq, Eq)]
pub(super) struct FailedAttempt {
    pub(super) at: u32,
    pub(super) needs_role: bool,
    pub(super) failure: Option<ManagementFailure>,
    pub(super) detail: String,
}

/// One tenant's Home reads, kept for the session.
pub(super) struct OverviewRecord {
    pub(super) tenant: TenantId,
    pub(super) read: Option<RuntimeOverview>,
    pub(super) failure: Option<ManagementFailure>,
    pub(super) failed_at: Option<u32>,
    /// Home read parts under way, each with the context it was admitted
    /// under (the overview and each other product). Per-operation
    /// bookkeeping, separate from the cached data: a part admitted under a
    /// context the tenant no longer has is withdrawn when it lands and never
    /// counts, however the tenant was switched meanwhile.
    parts: Vec<ContextRef>,
    pub(super) red_team: Option<ProductOutcome>,
    pub(super) model_skill: Option<ProductOutcome>,
    /// The latest attempt of each, when it established nothing (cleared by
    /// an attempt that did).
    pub(super) red_team_failed: Option<FailedAttempt>,
    pub(super) model_skill_failed: Option<FailedAttempt>,
    /// Completed reads of this tenant in this session.
    pub(super) generation: u32,
    /// The product a `recheckProduct` asked for, until its read lands.
    pub(super) rechecking: Option<ProductId>,
    snoozes: u32,
    pub(super) last_snooze: Option<SnoozeReceipt>,
}

impl OverviewRecord {
    fn new(tenant: TenantId) -> Self {
        Self {
            tenant,
            read: None,
            failure: None,
            failed_at: None,
            parts: Vec::new(),
            red_team: None,
            model_skill: None,
            red_team_failed: None,
            model_skill_failed: None,
            generation: 0,
            rechecking: None,
            snoozes: 0,
            last_snooze: None,
        }
    }

    /// Reading: a part admitted under the tenant's current context is
    /// still under way.
    pub(super) fn refreshing(&self, current: Option<&ContextRef>) -> bool {
        self.parts.iter().any(|c| Some(c) == current)
    }

    /// A product's read settled: an outcome that established at least one
    /// source replaces the retained outcome (and clears any failure); one
    /// that established nothing is kept as the latest failed attempt, the
    /// retained outcome staying shown as older.
    fn settle_product(&mut self, product: ProductId, outcome: ProductOutcome) {
        let (slot, failed) = match product {
            ProductId::RedTeam => (&mut self.red_team, &mut self.red_team_failed),
            ProductId::ModelSkill => (&mut self.model_skill, &mut self.model_skill_failed),
            ProductId::RuntimeSecurity | ProductId::Gateway => return,
        };
        if outcome.sources_read > 0 {
            *slot = Some(outcome);
            *failed = None;
        } else {
            *failed = Some(FailedAttempt {
                at: outcome.read_at,
                needs_role: outcome.needs_role,
                failure: outcome.failure,
                detail: outcome.detail,
            });
        }
    }

