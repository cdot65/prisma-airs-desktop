import { forwardRef } from 'react'
import type { AdminProduct, AdminProductId, FeatureId, InboxEntry, ProductId, ProductRead, ShellSnapshot } from '@prisma-airs/desktop-contracts'
import { HOME_COPY, INBOX_COPY, READ_COPY, SHELL_COPY, SNOOZE_COPY, clockOf } from './copy'
import { Glyph, PRODUCT_GLYPHS, type GlyphName } from './icons'
import { type Act, destinationFeature, follow, holdWhat } from './inbox/inbox'
import { useShellStore } from './store'

export interface HomeProps {
    snapshot: ShellSnapshot
    onAct: Act
    onNavigate: (id: FeatureId) => void
}

/**
 * What the empty attention list may say (I4): an all-clear only after a
 * complete read; otherwise the unread, in-progress, failed or partial
 * coverage is named instead.
 */
export function attentionEmpty(snapshot: ShellSnapshot): string {
    const read = snapshot.inbox.read
    if (read.state === 'pending') return HOME_COPY.firstRead
    if (read.state === 'reading' && read.lastReadAt === null) return HOME_COPY.reading
    if (read.state === 'failed' && read.failedAt !== null) {
        return read.lastReadAt === null ? READ_COPY.failed(clockOf(read.failedAt)) : HOME_COPY.clearSoFar(READ_COPY.failedKept(clockOf(read.failedAt), clockOf(read.lastReadAt)))
    }
    // A read in progress shows the cached read until the new one lands: its age stays named (C12).
    const stale = read.lastReadAt !== null && !snapshot.overview.fresh
    if (read.state === 'reading' && read.lastReadAt !== null) return HOME_COPY.clearSoFar(stale ? READ_COPY.readingStaleQualifier(clockOf(read.lastReadAt)) : READ_COPY.readingQualifier(clockOf(read.lastReadAt)))
    if (read.sourcesMissing.length > 0) return HOME_COPY.clearSoFar(READ_COPY.unread(read.sourcesMissing.length))
    // A healthy empty read older than the freshness window is a gap, not an all-clear (C12).
    if (stale) return HOME_COPY.clearSoFar(READ_COPY.staleQualifier(clockOf(read.lastReadAt ?? 0)))
    return HOME_COPY.allClear
}

/** The read-status line (I4): first read pending, reading, finished (with partial coverage), or failed. */
export function readLine(snapshot: ShellSnapshot, tenant: string | null): { text: string; tone: 'info' | 'flagged' | 'allowed' | 'blocked' } {
    const read = snapshot.inbox.read
    if (!tenant) return { text: HOME_COPY.noTenant, tone: 'info' }
    if (read.state === 'reading' && read.lastReadAt === null) return { text: HOME_COPY.reading, tone: 'info' }
    // Reading again: the cached read stays shown, with its age, until the new one lands.
    if (read.state === 'reading' && read.lastReadAt !== null) {
        const when = clockOf(read.lastReadAt)
        return snapshot.overview.fresh ? { text: READ_COPY.readingKept(when), tone: 'info' } : { text: READ_COPY.readingStale(when), tone: 'flagged' }
    }
    // A failed read is failed, attempted or not before: never "pending", never an all-clear.
    if (read.state === 'failed' && read.failedAt !== null) {
        return read.lastReadAt === null ? { text: READ_COPY.failed(clockOf(read.failedAt)), tone: 'blocked' } : { text: READ_COPY.failedKept(clockOf(read.failedAt), clockOf(read.lastReadAt)), tone: 'blocked' }
    }
    if (read.state === 'pending' || (read.lastReadAt === null && read.settledAt === null)) return { text: HOME_COPY.firstRead, tone: 'info' }
    // A settled attempt that established nothing (every source needs a role)
    // is announced for when it settled, never as a first read still pending.
    const when = clockOf(read.lastReadAt ?? read.settledAt ?? 0)
    const needsRole = read.products.filter((p) => p.state === 'needsRole').length
    if (needsRole > 0) return { text: READ_COPY.finishedNeedsRole(when, needsRole), tone: 'flagged' }
    if (read.sourcesMissing.length > 0) return { text: READ_COPY.finishedIncomplete(when, read.sourcesMissing.length), tone: 'flagged' }
    // Expired coverage stays distinct from healthy-empty (C12): the cached read is kept, its age named.
    if (read.lastReadAt !== null && !snapshot.overview.fresh) return { text: READ_COPY.stale(when), tone: 'flagged' }
    const activity = snapshot.overview.read?.summary.sessions
    if (activity === 0 && snapshot.inbox.items.length === 0) return { text: READ_COPY.finishedNoActivity(when, tenant), tone: 'allowed' }
    return { text: READ_COPY.finished(when), tone: 'allowed' }
}

/**
 * The one line under the greeting (R2App `homeSub`): the product count, the
 * core's read-status line (I4: pending, reading, finished with its coverage,
 * or failed, exactly as `readLine` says it) and the needs-action count.
 */
export function homeSub(snapshot: ShellSnapshot, tenant: string, products: number, needing: number): string {
    const parts = [HOME_COPY.sub.products(products), readLine(snapshot, tenant).text]
    if (needing > 0) parts.push(HOME_COPY.sub.needAction(needing))
    return parts.join(' · ')
}

type Pill = { word: string; bg: string; fg: string; glyph: GlyphName }
const PILLS: Record<'ok' | 'partial' | 'role' | 'pending' | 'failed' | 'gated', Pill> = {
    ok: { word: HOME_COPY.pill.connected, bg: 'var(--v2-ok-bg)', fg: 'var(--v2-ok)', glyph: 'check' },
    partial: { word: HOME_COPY.pill.partial, bg: 'var(--v2-flag-bg)', fg: 'var(--v2-flag)', glyph: 'alert' },
    role: { word: HOME_COPY.pill.needsRole, bg: 'var(--v2-flag-bg)', fg: 'var(--v2-flag)', glyph: 'alert' },
    pending: { word: HOME_COPY.pill.connecting, bg: 'var(--v2-inset)', fg: 'var(--v2-soft)', glyph: 'clock' },
    failed: { word: HOME_COPY.pill.failed, bg: 'var(--v2-block-bg)', fg: 'var(--v2-block)', glyph: 'ban' },
    gated: { word: HOME_COPY.pill.unavailable, bg: 'var(--v2-inset)', fg: 'var(--v2-faint)', glyph: 'lock' },
}

interface Card {
    id: AdminProductId
    /** The read can be asked for again (a role granted, a failure, partial coverage): the C30 recheck. */
    recheck: ProductId | null
    name: string
    pill: Pill
    value: string
    valueColor: string
    metric: string
    spark: { h: number; hot: boolean }[]
    sub: string
    subColor: string
    subGlyph: GlyphName
    isNew: boolean
    gated: boolean
}

/** The products the read reports on (the inventory ids with an admitted service). */
const readIdOf = (id: AdminProductId): ProductId | null => (id === 'agenticIdentity' || id === 'agenticEndpoint' ? null : id)

const dollars = (cents: number) => `$${(cents / 100).toFixed(2)}`
const count = (n: number) => n.toLocaleString('en-US')

/**
 * One card per Administration product (R2App `cards`), from the core only:
 * Runtime's headline is the read's detection events over its chart; the
 * Gateway's is the chosen workspace's day; Red Teaming and model/skill scans
 * carry their read state (the core publishes no figures for them); the two
 * gated products carry their gate. Nothing scripted is drawn.
 */
export function cardOf(snapshot: ShellSnapshot, product: AdminProduct, attention: InboxEntry[]): Card {
    const readId = readIdOf(product.id)
    const read = snapshot.inbox.read
    const state: ProductRead | undefined = readId ? read.products.find((p) => p.product === readId) : undefined
    const recheck = readId && state && (state.state === 'needsRole' || state.state === 'failed' || state.state === 'incomplete') ? readId : null
    const base = { id: product.id, name: product.label, isNew: product.availability.state === 'unavailable', gated: product.availability.state === 'unavailable', recheck }
    const blank = (pill: Pill, sub: string, subColor = 'var(--v2-faint)', subGlyph: GlyphName = 'clock'): Card => ({ ...base, pill, value: '—', valueColor: 'var(--v2-faint)', metric: HOME_COPY.metric[product.id] ?? '', spark: [], sub, subColor, subGlyph })
    if (product.availability.state === 'unavailable') return blank(PILLS.gated, product.availability.reason, 'var(--v2-faint)', 'lock')
    if (!state || state.state === 'pending' || state.state === 'notRead') return blank(PILLS.pending, read.state === 'reading' ? HOME_COPY.reading : HOME_COPY.firstRead)
    if (state.state === 'needsRole') return blank(PILLS.role, HOME_COPY.cardNeedsRole(state.detail), 'var(--v2-flag)', 'alert')
    if (state.state === 'failed') return blank(PILLS.failed, state.detail ?? READ_COPY.productState.failed ?? 'Failed', 'var(--v2-block)', 'ban')
    const pill = state.state === 'incomplete' ? PILLS.partial : PILLS.ok
    const worst = attention.find((e) => e.product === readId)
    const overview = snapshot.overview.read
    // The worst attention item is the last line when there is one; else the line states what the
    // read established, and names what it could not (R1): unknown is never an all-clear.
    const worstLine = worst ? { sub: worst.title, subColor: worst.severity === 'bad' ? 'var(--v2-block)' : 'var(--v2-flag)', subGlyph: (worst.severity === 'bad' ? 'ban' : 'alert') as GlyphName } : null
    if (product.id === 'runtimeSecurity' && overview) {
        const events = overview.summary.detectionEvents
        const buckets = overview.chart?.buckets ?? []
        const max = Math.max(1, ...buckets.map((b) => b.violating))
        const spark = buckets.slice(-12).map((b) => ({ h: Math.max(2, Math.round((b.violating / max) * 38)), hot: b.violating > 0 }))
        const violating = overview.summary.violating
        const line =
            worstLine ??
            (overview.chart === null || overview.chartFailure !== null
                ? { sub: HOME_COPY.chartNotRead, subColor: 'var(--v2-flag)', subGlyph: 'alert' as GlyphName }
                : violating === null
                  ? { sub: HOME_COPY.activityUnknown, subColor: 'var(--v2-flag)', subGlyph: 'alert' as GlyphName }
                  : violating > 0
                    ? { sub: HOME_COPY.runtimeViolating(violating), subColor: 'var(--v2-soft)', subGlyph: 'check' as GlyphName }
                    : { sub: HOME_COPY.noDetections, subColor: 'var(--v2-soft)', subGlyph: 'check' as GlyphName })
        return {
            ...base,
            pill,
            value: events === null ? '—' : count(events),
            valueColor: events !== null && events > 0 ? 'var(--v2-block)' : 'var(--v2-ink)',
            metric: HOME_COPY.metric.runtimeSecurity,
            spark,
            ...line,
        }
    }
    if (product.id === 'gateway') {
        const g = overview?.gateway ?? null
        if (!g) {
            // No workspace chosen (or no read yet): no day to draw, and the gate said (R2).
            return { ...base, pill, value: '—', valueColor: 'var(--v2-faint)', metric: HOME_COPY.metric.gateway, spark: [], ...(worstLine ?? { sub: HOME_COPY.gatewayNoWorkspace, subColor: 'var(--v2-faint)', subGlyph: 'route' as GlyphName }) }
        }
        const requests = g.requests
        const errors = g.errors
        const rate = requests !== null && errors !== null && requests > 0 ? (errors / requests) * 100 : null
        const line =
            worstLine ??
            (g.usageFailure !== null || requests === null
                ? { sub: HOME_COPY.usageNotRead(g.workspaceName), subColor: 'var(--v2-flag)', subGlyph: 'alert' as GlyphName }
                : errors === null
                  ? { sub: HOME_COPY.errorsUnknown(g.workspaceName), subColor: 'var(--v2-flag)', subGlyph: 'alert' as GlyphName }
                  : rate === null
                    ? { sub: HOME_COPY.gatewayNoRequests(g.workspaceName), subColor: 'var(--v2-soft)', subGlyph: 'check' as GlyphName }
                    : { sub: HOME_COPY.gatewayErrorRate(rate), subColor: rate > 5 ? 'var(--v2-block)' : 'var(--v2-soft)', subGlyph: (rate > 5 ? 'ban' : 'check') as GlyphName })
        return {
            ...base,
            pill: g.partial ? PILLS.partial : pill,
            value: requests === null ? '—' : count(requests),
            valueColor: 'var(--v2-ink)',
            metric: g.cost === null ? HOME_COPY.metric.gateway : `${HOME_COPY.metric.gateway} · ${dollars(g.cost)}`,
            spark: [],
            ...line,
        }
    }
    // Read-state cards: the read's coverage is the figure the core has.
    return {
        ...base,
        pill,
        value: state.sourcesTotal > 0 ? `${state.sourcesRead}/${state.sourcesTotal}` : '—',
        valueColor: 'var(--v2-ink)',
        metric: HOME_COPY.metric[product.id] ?? READ_COPY.sources(state.sourcesRead, state.sourcesTotal),
        spark: [],
        sub: worst ? worst.title : state.detail ?? (state.state === 'incomplete' ? HOME_COPY.partialRead(state.sourcesRead, state.sourcesTotal) : HOME_COPY.readOnly),
        subColor: worst ? (worst.severity === 'bad' ? 'var(--v2-block)' : 'var(--v2-flag)') : state.state === 'incomplete' ? 'var(--v2-flag)' : 'var(--v2-soft)',
        subGlyph: worst ? (worst.severity === 'bad' ? 'ban' : 'alert') : state.state === 'incomplete' ? 'alert' : 'check',
    }
}

const severityTile = (e: InboxEntry): { glyph: GlyphName; fg: string; bg: string } =>
    e.severity === 'bad' ? { glyph: 'ban', fg: 'var(--v2-block)', bg: 'var(--v2-block-bg)' } : e.severity === 'warn' ? { glyph: 'alert', fg: 'var(--v2-flag)', bg: 'var(--v2-flag-bg)' } : { glyph: 'info', fg: 'var(--v2-soft)', bg: 'var(--v2-inset)' }

/**
 * Home as the prototype draws it (R2App start=home, C36): the greeting row
 * with the read summary and Refresh, the Explain banner while the calls are
 * shown, the six product cards, then Needs attention beside Quick actions.
 * Every figure reads the snapshot; every action is a core intent whose
 * outcome reaches the shell's surfaces (DESIGN-V2 §7).
 */
export const Home = forwardRef<HTMLHeadingElement, HomeProps>(function Home({ snapshot, onAct, onNavigate }, ref) {
    const tenant = snapshot.tenants.find((t) => t.id === snapshot.active?.tenant) ?? null
    const context = snapshot.active?.context ?? null
    const read = snapshot.inbox.read
    const products = snapshot.administration?.products ?? []
    const attention = snapshot.inbox.items.filter((e) => e.needsAction && !e.hold)
    const shown = attention.slice(0, 5)
    const needsRole = read.products.find((p) => p.state === 'needsRole') ?? null
    const account = snapshot.harness.signIn?.account && snapshot.harness.signIn.failure === null ? snapshot.harness.signIn.account : null
    const readNow = () => context && tenant && void onAct(SHELL_COPY.readOf(tenant.label), { kind: 'readTenant', context })
    const hold = (kind: 'acknowledgeItem' | 'snoozeItem', id: string, title: string) => context && void onAct(holdWhat(kind, title), { kind, context, id })
    // A recheck re-reads one product (C30); its admission is announced for the product.
    const recheck = async (product: ProductId) => {
        if (!context || !tenant) return
        const label = READ_COPY.products[product] ?? product
        const outcome = await onAct(SHELL_COPY.recheckOf(label, tenant.label), { kind: 'recheckProduct', context, product })
        if (outcome.kind === 'admitted') useShellStore.getState().toast(READ_COPY.recheck(label), 'info', undefined, tenant.id, context)
    }
    const openProduct = (id: AdminProductId, tab?: string) => {
        if (tenant) useShellStore.getState().arrive({ tenant: tenant.id, feature: 'administration', resource: null, item: null, product: id, tab })
        onNavigate('administration')
    }
    const quick: { label: string; sub: string; key: string; glyph: GlyphName; go: () => void }[] = [
        { label: HOME_COPY.quick.prompt, sub: HOME_COPY.quick.promptSub, key: '', glyph: 'play', go: () => openProduct('runtimeSecurity', 'playground') },
        { label: HOME_COPY.quick.harness, sub: HOME_COPY.quick.harnessSub, key: '⌘3', glyph: 'bot', go: () => onNavigate('harness') },
        { label: HOME_COPY.quick.request, sub: HOME_COPY.quick.requestSub, key: '⌘6', glyph: 'send', go: () => onNavigate('apiClient') },
        { label: HOME_COPY.quick.learn, sub: HOME_COPY.quick.learnSub, key: '⌘4', glyph: 'cap', go: () => onNavigate('academy') },
    ]
    const button32 = 'flex h-8 min-h-0 items-center rounded-[7px] border text-[12px] whitespace-nowrap'
    return (
        <section aria-labelledby='home-heading' data-slot='home' className='flex flex-col' style={{ gap: 20 }}>
            <div className='flex items-end' style={{ gap: 12 }}>
                <div className='flex flex-col' style={{ gap: 2 }}>
                    <h1 ref={ref} id='home-heading' tabIndex={-1} className='font-bold' style={{ fontSize: 'var(--v2-title)', letterSpacing: '-0.01em' }}>
                        {account ? HOME_COPY.greeting(account) : HOME_COPY.title}
                    </h1>
                    <p role='status' aria-live='polite' data-slot='read-status' data-tone={readLine(snapshot, tenant?.label ?? null).tone} className='text-[14px]' style={{ marginTop: 4, color: 'var(--v2-soft)' }}>
                        {tenant ? homeSub(snapshot, tenant.label, products.length, attention.length) : HOME_COPY.noTenant}
                    </p>
                </div>
                {context && (
                    <button type='button' aria-live='polite' onClick={readNow} disabled={read.state === 'reading'} className={`${button32} ml-auto px-3.5 text-[13px] disabled:opacity-60`} style={{ borderColor: 'var(--v2-rule)', background: 'var(--v2-paper)', color: 'var(--v2-ink)' }}>
                        {read.state === 'reading' ? HOME_COPY.reading : HOME_COPY.refresh}
                    </button>
                )}
            </div>
            {snapshot.showCalls && (
                <div data-slot='home-explain' className='flex gap-2 rounded-[10px] text-[13px] leading-[1.45]' style={{ padding: '12px 14px', background: 'var(--v2-acc-soft)', maxWidth: 860 }}>
                    <Glyph name='info' size={15} stroke={2} color='var(--v2-acc)' className='mt-px' />
                    <span>{HOME_COPY.explain}</span>
                </div>
            )}
            {/* Three columns at the board's width (each card at least 300px); fewer when the page is narrower (the collapsed rail, 200% zoom). */}
            {tenant && products.length > 0 && (
                <ul data-slot='cards' aria-label={HOME_COPY.cards} className='grid' style={{ gridTemplateColumns: 'repeat(auto-fit, minmax(min(100%, 300px), 1fr))', gap: 16 }}>
                    {products.map((product) => {
                        const c = cardOf(snapshot, product, attention)
                        return (
                            // The card is one button (the prototype's); a Recheck control, when the read allows one,
                            // sits beside the card's last line above the stretched button, never inside it.
                            <li key={c.id} className='relative flex'>
                                <button
                                    type='button'
                                    data-slot='card'
                                    data-product={c.id}
                                    aria-label={`${c.name}: ${c.pill.word}, ${c.value} ${c.metric}, ${c.sub}${c.isNew ? ` · ${SHELL_COPY.newTag}` : ''}`}
                                    onClick={() => openProduct(c.id)}
                                    className='flex w-full flex-col rounded-[12px] border text-left after:absolute after:inset-0 after:rounded-[12px] after:content-[""]'
                                    style={{ gap: 10, padding: '18px 20px', borderColor: 'var(--v2-rule)', background: 'var(--v2-paper)', color: 'var(--v2-ink)' }}
                                >
                                    <span className='flex w-full items-center' style={{ gap: 9 }}>
                                        <span className='grid size-7 shrink-0 place-items-center rounded-[8px]' style={{ background: 'var(--v2-inset)', color: 'var(--v2-soft)' }}>
                                            <Glyph name={PRODUCT_GLYPHS[c.id]} size={15} />
                                        </span>
                                        <b className='min-w-0 flex-grow truncate text-[13px]'>{c.name}</b>
                                        <span className='flex shrink-0 items-center gap-1 rounded-full text-[12px] font-semibold whitespace-nowrap' style={{ padding: '2px 8px', background: c.pill.bg, color: c.pill.fg }}>
                                            <Glyph name={c.pill.glyph} size={10} stroke={2.6} />
                                            {c.pill.word}
                                        </span>
                                    </span>
                                    <span className='flex w-full items-end' style={{ gap: 12 }}>
                                        <span className='flex min-w-0 flex-1 flex-col'>
                                            <span className='text-[26px] font-bold tabular-nums' style={{ letterSpacing: '-0.02em', color: c.valueColor }}>
                                                {c.value}
                                            </span>
                                            <span className='text-[12px] leading-[1.35]' style={{ color: 'var(--v2-faint)' }}>
                                                {c.metric}
                                            </span>
                                        </span>
                                        <span aria-hidden='true' className='ml-auto flex h-[38px] w-[110px] shrink-0 items-end' style={{ gap: 3 }}>
                                            {c.spark.map((b, i) => (
                                                <span key={i} className='flex-1' style={{ height: b.h, borderRadius: '2px 2px 0 0', background: b.hot ? 'var(--v2-block)' : 'var(--v2-acc)' }} />
                                            ))}
                                        </span>
                                    </span>
                                    <span className='flex w-full items-center gap-1.5 text-[12px] font-semibold' style={{ paddingTop: 8, borderTop: '1px solid var(--v2-rule)', color: c.subColor }}>
                                        <Glyph name={c.subGlyph} size={12} stroke={2.2} />
                                        <span className='min-w-0 flex-grow truncate'>{c.sub}</span>
                                        {c.isNew && (
                                            <span className='shrink-0 rounded-full text-[12px] font-bold' style={{ padding: '1px 6px', background: 'var(--v2-acc-soft)', color: 'var(--v2-acc)' }}>
                                                {SHELL_COPY.newTag}
                                            </span>
                                        )}
                                    </span>
                                </button>
                                {c.recheck && context && (
                                    <button
                                        type='button'
                                        onClick={() => void recheck(c.recheck!)}
                                        disabled={read.state === 'reading'}
                                        className='absolute right-5 bottom-[14px] z-10 h-7 rounded-[7px] border px-2.5 text-[12px] disabled:opacity-60'
                                        style={{ borderColor: 'var(--v2-rule)', background: 'var(--v2-bg)', color: 'var(--v2-ink)' }}
                                    >
                                        {HOME_COPY.recheck}
                                    </button>
                                )}
                            </li>
                        )
                    })}
                </ul>
            )}
            <div data-slot='home-lower' className='grid' style={{ gridTemplateColumns: 'minmax(0, 1.75fr) minmax(0, 1fr)', gap: 16 }}>
                <section aria-label={HOME_COPY.attention} data-slot='attention-section' className='flex flex-col rounded-[12px] border' style={{ padding: '4px 0', borderColor: 'var(--v2-rule)', background: 'var(--v2-paper)' }}>
                    <div className='flex items-center' style={{ padding: '16px 18px 10px' }}>
                        <h2 className='text-[13px] font-bold'>
                            {HOME_COPY.attention}{' '}
                            <span className='font-normal' style={{ color: 'var(--v2-faint)' }}>
                                {attention.length > 0 ? attention.length : ''}
                            </span>
                        </h2>
                        <button type='button' onClick={() => onNavigate('inbox')} className='ml-auto text-[12px] font-semibold' style={{ color: 'var(--v2-acc)' }}>
                            {HOME_COPY.openInbox}
                        </button>
                    </div>
                    {shown.length === 0 ? (
                        <div className='flex flex-col items-center text-center leading-[1.5]' style={{ gap: 12, padding: '28px 18px', borderTop: '1px solid var(--v2-rule)', color: 'var(--v2-faint)' }}>
                            <span>{attentionEmpty(snapshot)}</span>
                            {needsRole && (
                                <button type='button' onClick={() => openProduct(needsRole.product)} className={`${button32} px-3.5 font-semibold`} style={{ borderColor: 'var(--v2-flag)', background: 'var(--v2-flag-bg)', color: 'var(--v2-flag)' }}>
                                    {HOME_COPY.openRoleIssue}
                                </button>
                            )}
                        </div>
                    ) : (
                        <ul data-slot='attention' className='flex flex-col'>
                            {shown.map((e) => {
                                const tile = severityTile(e)
                                return (
                                    <li key={e.id} className='flex items-center' style={{ gap: 12, padding: '12px 18px', borderTop: '1px solid var(--v2-rule)' }}>
                                        <span aria-hidden='true' className='grid size-7 shrink-0 place-items-center rounded-[8px]' style={{ background: tile.bg, color: tile.fg }}>
                                            <Glyph name={tile.glyph} size={14} stroke={2} />
                                        </span>
                                        <div className='min-w-0 flex-grow'>
                                            <div className='font-semibold'>{e.title}</div>
                                            {/* The severity is a word as well as a colour and an icon (I9). */}
                                            <div className='truncate text-[12px]' style={{ color: 'var(--v2-faint)' }}>
                                                <span data-slot='severity' className='font-semibold' style={{ color: tile.fg }}>
                                                    {INBOX_COPY.severity[e.severity]}
                                                </span>
                                                {' · '}
                                                {[e.product ? READ_COPY.products[e.product] : null, e.source, e.detail].filter(Boolean).join(' · ')}
                                            </div>
                                        </div>
                                        {destinationFeature(e) && e.actionLabel && tenant && (
                                            <button type='button' onClick={() => follow(e, tenant.id, onNavigate)} className={`${button32} px-3`} style={{ borderColor: 'var(--v2-rule)', background: 'var(--v2-bg)', color: 'var(--v2-ink)' }}>
                                                {e.actionLabel}
                                            </button>
                                        )}
                                        <button type='button' aria-label={`${HOME_COPY.acknowledge}: ${e.title}`} title={HOME_COPY.acknowledge} onClick={() => hold('acknowledgeItem', e.id, e.title)} className='grid size-8 min-h-0 place-items-center rounded-[7px] border' style={{ borderColor: 'var(--v2-rule)', background: 'var(--v2-bg)', color: 'var(--v2-ink)' }}>
                                            <Glyph name='check' size={12} stroke={2.2} />
                                        </button>
                                        <button type='button' aria-label={`${SNOOZE_COPY.offer}: ${e.title}`} title={SNOOZE_COPY.offer} onClick={() => hold('snoozeItem', e.id, e.title)} className='grid size-8 min-h-0 place-items-center rounded-[7px] border' style={{ borderColor: 'var(--v2-rule)', background: 'var(--v2-bg)', color: 'var(--v2-ink)' }}>
                                            <Glyph name='clock' size={12} stroke={2} />
                                        </button>
                                    </li>
                                )
                            })}
                        </ul>
                    )}
                </section>
                <section aria-label={HOME_COPY.quickActions} data-slot='quick-actions' className='flex flex-col rounded-[12px] border' style={{ padding: '4px 0', borderColor: 'var(--v2-rule)', background: 'var(--v2-paper)' }}>
                    <h2 className='text-[13px] font-bold' style={{ padding: '16px 18px 10px' }}>
                        {HOME_COPY.quickActions}
                    </h2>
                    {quick.map((q) => (
                        <button key={q.label} type='button' data-inset-focus='' onClick={q.go} className='flex items-center text-left' style={{ gap: 12, padding: '12px 18px', borderTop: '1px solid var(--v2-rule)', color: 'var(--v2-ink)' }}>
                            <span aria-hidden='true' className='grid size-7 shrink-0 place-items-center rounded-[8px]' style={{ background: 'var(--v2-acc-soft)', color: 'var(--v2-acc)' }}>
                                <Glyph name={q.glyph} size={14} stroke={1.9} />
                            </span>
                            <span className='flex-grow'>
                                <b className='font-semibold'>{q.label}</b>
                                <br />
                                <span className='text-[12px]' style={{ color: 'var(--v2-faint)' }}>
                                    {q.sub}
                                </span>
                            </span>
                            <span className='text-[12px]' style={{ color: 'var(--v2-faint)' }}>
                                {q.key}
                            </span>
                        </button>
                    ))}
                </section>
            </div>
        </section>
    )
})
/**
 * Home as the prototype draws it (R2App start=home, C36), over the
 * production App and a scripted native transport: one card per
 * Administration product from the core's read, the attention list with its
 * core intents, the quick actions, the Explain banner and Refresh.
 */
import { render, screen, within } from '@testing-library/react'
import userEvent from '@testing-library/user-event'
import { beforeEach, describe, expect, it } from 'vitest'
import { DesktopClient, type ShellSnapshot } from '@prisma-airs/desktop-contracts'
import { App } from '../app'
import { scriptedNative, type Native } from '../test/native'
import { fxFresh, fxInbox } from './fixtures'
import { resetShellStore, useShellStore } from './store'

async function launch(snapshot: ShellSnapshot): Promise<Native> {
    const native = scriptedNative(snapshot)
    render(<App client={new DesktopClient(native.transport)} />)
    await screen.findByRole('navigation', { name: 'Destinations' })
    return native
}

const WS = { id: '16f7e90d-382a-4e78-b577-1b01eb5f8297', name: 'Team A', slug: 'team-a', scopeName: 'scope-team-a' }

/** The Inbox fixture's tenant on Home, with a Runtime chart and the Gateway's day. */
function fxHomeRead(): ShellSnapshot {
    const base = fxInbox()
    const read = base.overview.read!
    return {
        ...base,
        activeFeature: 'home',
        overview: {
            ...base.overview,
            read: {
                ...read,
                chart: { bucketSeconds: 3600, buckets: [0, 1, 0, 2, 0, 0, 1, 3, 0, 1, 2, 4].map((v, i) => ({ time: `t${i}`, total: 10 + v, violating: v, detections: null })) },
                summary: { sessions: 120, violating: 14, benign: 106, detectionEvents: 14 },
                gateway: { workspace: WS.id, workspaceName: WS.name, requests: 1284, errors: 211, cost: 312, partial: false, usageFailure: null, limitsFailure: null, policies: 2 },
            },
        },
    }
}

const card = (id: string) => document.querySelector(`[data-slot="card"][data-product="${id}"]`) as HTMLElement

beforeEach(() => resetShellStore())

describe('v2 Home', () => {
    it('draws one card per Administration product from the read: Runtime’s detection events and chart, the Gateway’s day, read states, and the two gates', async () => {
        const native = await launch(fxHomeRead())
        expect(screen.getByRole('heading', { level: 1, name: 'Home' })).toBeInTheDocument()
        expect(document.querySelector('[data-slot="read-status"]')?.textContent).toMatch(/^6 products · Read finished at \d\d:\d\d · 1 source partial · 2 need action$/)
        const cards = screen.getByRole('list', { name: 'Product cards' })
        expect(within(cards).getAllByRole('listitem')).toHaveLength(6)
        // Runtime Security: the summary's detection events, the chart as bars, the worst attention item as the line below.
        const rt = card('runtimeSecurity')
        expect(rt).toHaveTextContent('AI Runtime Security')
        expect(rt).toHaveTextContent('Connected')
        expect(rt).toHaveTextContent('14')
        expect(rt).toHaveTextContent('detection events')
        expect(rt.querySelectorAll('[aria-hidden="true"] span').length).toBe(12)
        expect(rt).toHaveTextContent('Runtime expires in 5 days')
        // The Gateway: requests and cost from the workspace's day; the error rate flagged above 5%.
        const gw = card('gateway')
        expect(gw).toHaveTextContent('Partial')
        expect(gw).toHaveTextContent('1,284')
        expect(gw).toHaveTextContent('requests · today · $3.12')
        // The worst attention item for the product is its last line; without one, the day's error rate.
        expect(gw).toHaveTextContent('AI Gateway: setup warning')
        await native.push({ ...native.current, inbox: { ...native.current.inbox, items: native.current.inbox.items.filter((e) => e.product !== 'gateway') } })
        expect(card('gateway')).toHaveTextContent('Error rate 16.4% today')
        // A partial read may be rechecked (C30); the admitted recheck is announced for the product.
        expect(screen.getAllByRole('button', { name: 'Recheck' })).toHaveLength(1)
        // Products the core reads without figures carry their read state.
        expect(card('redTeam')).toHaveTextContent('Connecting')
        expect(card('modelSkill')).toHaveTextContent('Connecting')
        // The gated products carry their gate and the New tag, never a figure.
        const ais = card('agenticIdentity')
        expect(ais).toHaveTextContent('Not available')
        expect(ais).toHaveTextContent('New')
        expect(ais).toHaveTextContent('—')
        expect(card('agenticEndpoint')).toHaveTextContent('Not available in this release')
    })

    it('opens a card’s product in Administration through the arrival, never local state', async () => {
        const user = userEvent.setup()
        const native = await launch(fxHomeRead())
        await user.click(card('gateway'))
        expect(native.dispatched.at(-1)).toEqual({ kind: 'navigate', feature: 'administration' })
        expect(useShellStore.getState().arrival).toMatchObject({ feature: 'administration', product: 'gateway', tenant: 'tn-0123456789abcdef' })
        await native.push({ ...native.current, activeFeature: 'administration' })
        const gateway = document.querySelector('[data-slot="admin-product"][data-product="gateway"]') as HTMLElement
        expect(within(gateway).getByRole('button', { name: /AI Gateway/ })).toHaveAttribute('aria-expanded', 'true')
    })

    it('lists what needs attention with the item’s action, Acknowledge and Snooze as core intents, beside the quick actions', async () => {
        const user = userEvent.setup()
        const native = await launch(fxHomeRead())
        const attention = screen.getByRole('region', { name: 'Needs attention' })
        expect(within(attention).getByRole('heading', { level: 2 })).toHaveTextContent('Needs attention 2')
        const rows = within(attention).getAllByRole('listitem')
        expect(rows).toHaveLength(2)
        expect(rows[0]).toHaveTextContent('Runtime expires in 5 days')
        expect(rows[0]).toHaveTextContent('AI Runtime Security')
        await user.click(within(rows[0]!).getByRole('button', { name: 'Acknowledge: Runtime expires in 5 days' }))
        expect(native.dispatched.at(-1)).toEqual({ kind: 'acknowledgeItem', context: 'cx-aaaaaaaaaaaaaaaaaaaaaaaa', id: 'runtime-key:k1' })
        await user.click(within(rows[0]!).getByRole('button', { name: /^Snooze.*Runtime expires in 5 days/ }))
        expect(native.dispatched.at(-1)).toEqual({ kind: 'snoozeItem', context: 'cx-aaaaaaaaaaaaaaaaaaaaaaaa', id: 'runtime-key:k1' })
        // The item's own action follows its target.
        await user.click(within(rows[0]!).getByRole('button', { name: 'Open API keys' }))
        expect(native.dispatched.at(-1)).toEqual({ kind: 'navigate', feature: 'administration' })
        expect(useShellStore.getState().arrival).toMatchObject({ feature: 'administration', resource: 'apiKeys' })
        await user.click(within(attention).getByRole('button', { name: 'Open the Inbox' }))
        expect(native.dispatched.at(-1)).toEqual({ kind: 'navigate', feature: 'inbox' })
        // Quick actions.
        const quick = screen.getByRole('region', { name: 'Quick actions' })
        expect(within(quick).getAllByRole('button').map((b) => b.textContent)).toEqual([
            expect.stringContaining('Test a prompt'),
            expect.stringContaining('Ask the Harness'),
            expect.stringContaining('Send a request'),
            expect.stringContaining('Keep learning'),
        ])
        await user.click(within(quick).getByRole('button', { name: /Send a request/ }))
        expect(native.dispatched.at(-1)).toEqual({ kind: 'navigate', feature: 'apiClient' })
        await user.click(within(quick).getByRole('button', { name: /Test a prompt/ }))
        expect(native.dispatched.at(-1)).toEqual({ kind: 'navigate', feature: 'administration' })
        expect(useShellStore.getState().arrival).toMatchObject({ feature: 'administration', product: 'runtimeSecurity' })
    })

    it('shows the Explain banner only while the calls are shown, and Refresh reads the tenant and waits while reading', async () => {
        const user = userEvent.setup()
        const native = await launch(fxHomeRead())
        expect(document.querySelector('[data-slot="home-explain"]')).not.toBeNull()
        await native.push({ ...native.current, showCalls: false })
        expect(document.querySelector('[data-slot="home-explain"]')).toBeNull()
        await user.click(screen.getByRole('button', { name: 'Refresh' }))
        expect(native.dispatched.at(-1)).toEqual({ kind: 'readTenant', context: 'cx-aaaaaaaaaaaaaaaaaaaaaaaa' })
        await native.push({ ...native.current, inbox: { ...native.current.inbox, read: { ...native.current.inbox.read, state: 'reading' } } })
        expect(screen.getByRole('button', { name: 'Reading…' })).toBeDisabled()
    })

    it('never turns unknown coverage into an all-clear: a failed chart, a failed usage read, an unknown error count and no workspace are named (R1, R2)', async () => {
        const base = fxHomeRead()
        const read = base.overview.read!
        // A failed chart with a usable key inventory: the Runtime card names the gap, not "no detections".
        const native = await launch({ ...base, inbox: { ...base.inbox, items: [] }, overview: { ...base.overview, read: { ...read, chart: null, chartFailure: 'unavailable', summary: { sessions: null, violating: null, benign: null, detectionEvents: null } } } })
        expect(card('runtimeSecurity')).toHaveTextContent('Sessions chart not read')
        expect(card('runtimeSecurity')).toHaveTextContent('—')
        expect(card('runtimeSecurity')).not.toHaveTextContent('No detections')
        // The Gateway's usage read failed: no "No errors".
        await native.push({ ...native.current, overview: { ...native.current.overview, read: { ...read, gateway: { ...read.gateway!, requests: null, errors: null, cost: null, usageFailure: 'unavailable' } } }, inbox: { ...native.current.inbox, items: [] } })
        expect(card('gateway')).toHaveTextContent('Usage not read · Team A')
        expect(card('gateway')).not.toHaveTextContent('No errors')
        // Requests known, errors unknown: said so.
        await native.push({ ...native.current, overview: { ...native.current.overview, read: { ...read, gateway: { ...read.gateway!, errors: null, usageFailure: null } } } })
        expect(card('gateway')).toHaveTextContent('1,284')
        expect(card('gateway')).toHaveTextContent('Error count unknown · Team A')
        // No workspace chosen: an unknown figure under the request metric, and the gate.
        await native.push({ ...native.current, overview: { ...native.current.overview, read: { ...read, gateway: null } } })
        expect(card('gateway')).toHaveTextContent('—')
        expect(card('gateway')).toHaveTextContent('requests · today')
        expect(card('gateway')).toHaveTextContent('No Gateway workspace chosen')
        expect(card('gateway')).not.toHaveTextContent('0/2')
    })

    it('names the severity of each attention row in words as well as colour and icon (I9, R4)', async () => {
        await launch(fxHomeRead())
        const rows = within(screen.getByRole('region', { name: 'Needs attention' })).getAllByRole('listitem')
        expect(rows[0]!.querySelector('[data-slot="severity"]')).toHaveTextContent('Warning')
        expect(rows.map((r) => r.querySelector('[data-slot="severity"]')?.textContent)).toEqual(['Warning', 'Warning'])
    })

    it('"Test a prompt" opens the Runtime Playground tab itself, even after another Runtime tab was chosen (R3)', async () => {
        const user = userEvent.setup()
        const native = await launch(fxHomeRead())
        const runtime = () => document.querySelector('[data-slot="admin-product"][data-product="runtimeSecurity"]') as HTMLElement
        // Visit Administration first and choose another Runtime tab.
        await user.click(card('runtimeSecurity'))
        await native.push({ ...native.current, activeFeature: 'administration' })
        await user.click(within(runtime()).getByRole('tab', { name: 'API keys' }))
        expect(within(runtime()).getByRole('tab', { name: 'API keys' })).toHaveAttribute('aria-selected', 'true')
        await native.push({ ...native.current, activeFeature: 'home' })
        await user.click(within(screen.getByRole('region', { name: 'Quick actions' })).getByRole('button', { name: /Test a prompt/ }))
        expect(native.dispatched.at(-1)).toEqual({ kind: 'navigate', feature: 'administration' })
        expect(useShellStore.getState().arrival).toMatchObject({ product: 'runtimeSecurity', tab: 'playground' })
        await native.push({ ...native.current, activeFeature: 'administration' })
        // The product's own tab (the Playground panel has tabs of its own).
        expect(within(runtime()).getAllByRole('tab', { name: 'Playground' })[0]).toHaveAttribute('aria-selected', 'true')
    })

    it('a fresh tenant shows first read pending on every card and an empty attention list, never sample data (I12)', async () => {
        await launch({ ...fxFresh(), activeFeature: 'home' })
        expect(document.querySelector('[data-slot="read-status"]')?.textContent).toContain('First read pending')
        for (const id of ['runtimeSecurity', 'gateway', 'redTeam', 'modelSkill']) {
            expect(card(id)).toHaveTextContent('Connecting')
            expect(card(id)).toHaveTextContent('First read pending')
            expect(card(id)).toHaveTextContent('—')
        }
        const attention = screen.getByRole('region', { name: 'Needs attention' })
        expect(within(attention).queryAllByRole('listitem')).toHaveLength(0)
        expect(attention).toHaveTextContent('First read pending')
    })
})
//! C36 (D059): the overview contract Home draws its cards from, through the
//! production authority interface against a synthetic management plane:
//! one read yields the Runtime summary and chart the card's figure and bars
//! come from (detection events summed only from usable breakdowns, buckets
//! kept in order), the Gateway day only when a workspace is selected, the
//! per-product read states the pills follow, the needs-action entries the
//! attention list shows minus the operator's holds, and a recheck admitted
//! only for a product the read lists. Nothing here is a new core capability.

#[allow(dead_code)]
#[path = "../context_credentials/support.rs"]
mod support;

use std::sync::{Arc, Mutex};
use std::time::Duration;

use desktop_core::features::ProductId;
use desktop_core::fixtures::{self, Handles};
use desktop_core::management::ManagementEndpoints;
use desktop_core::transport::{ProxyMode, TransportPolicy};
use desktop_core::{
    AuthorityHandle, Core, CoreConfig, Delivery, Intent, Observation, ProductReadState, ReadState,
    Receipt, Refusal, ScanState, ShellSnapshot, ViewScope,
};
use serde_json::{Value, json};

use crate::support::{Reply, Seen, TestCa, TlsServer, eventually};

const CLIENT_ID: &str = "synthetic-client@1234567890.iam.panserviceaccount.com";
const CLIENT_SECRET: &str = "synthetic-client-secret-c36";
const TSG: &str = "1234567890";

/// The synthetic plane: a chart of `buckets` (violating counts; each bucket
/// reports a breakdown totalling its violating count unless `no_breakdown`),
/// an API key inventory, and the other products' sources answering plainly.
struct Script {
    buckets: Vec<u32>,
    no_breakdown: bool,
    chart_status: u16,
    keys: Vec<Value>,
}

impl Script {
    fn route(&mut self, seen: &Seen) -> Reply {
        let target = seen.request_line.split(' ').nth(1).unwrap_or("").to_owned();
        let path = target.split('?').next().unwrap_or("").to_owned();
        if path == "/oauth2/access_token" {
            return raw(
                200,
                &json!({"access_token": "mgmt-access", "token_type": "Bearer", "expires_in": 3600}),
            );
        }
        if path == "/aisec/v1/mgmt/dashboard/v2/sessions/sessionschart" {
            let buckets: Vec<Value> = self
                .buckets
                .iter()
                .enumerate()
                .map(|(i, v)| {
                    let mut b = json!({"time": format!("2026-10-19T{:02}:00:00Z", i), "total": 10 + v, "violating": v});
                    if !self.no_breakdown {
                        b["detection_type_violation_breakdown"] =
                            json!([{"detection_type": "pi", "violation_breakdown": {"total": v}}]);
                    }
                    b
                })
                .collect();
            return raw(
                self.chart_status,
                &json!({"bucket_size_seconds": 3600, "buckets": buckets}),
            );
        }
        if path == format!("/aisec/v1/mgmt/apikeys/tsg/{TSG}") {
            let keys: Vec<Value> = self
                .keys
                .iter()
                .map(|k| {
                    let mut k = k.clone();
                    for (field, value) in [
                        ("api_key_last8", json!("abcd1234")),
                        ("auth_code", json!("SYNTHETIC-AUTH-CODE")),
                        ("cust_app", json!("Support bot")),
                        ("revoked", json!(false)),
                    ] {
                        if k.get(field).is_none() {
                            k[field] = value;
                        }
                    }
                    k
                })
                .collect();
            return raw(200, &json!({"api_keys": keys}));
        }
        if path == "/ai-red-teaming/data-plane/v1/dashboard/scan-statistics" {
            return raw(
                200,
                &json!({"total_scans": 3, "targets_scanned": 2,
                    "scan_status": [{"name": "COMPLETED", "count": 3}],
                    "risk_profile": [{"risk_rating": "LOW", "total": 2}],
                    "targets_scanned_by_type": [{"name": "APPLICATION", "count": 2}]}),
            );
        }
        if path == "/ai-red-teaming/data-plane/v1/scan" {
            return raw(
                200,
                &json!({"data": [{"uuid": "00000001-2222-4333-8444-555555555555", "status": "COMPLETED",
                    "job_type": "STATIC", "target_id": "66666666-7777-4888-8999-aaaaaaaaaaaa",
                    "target_type": "APPLICATION", "created_at": "2026-10-18T10:00:00Z"}],
                    "pagination": {"total_items": 1}}),
            );
        }
        if path == "/aims/data/v1/scans" {
            return raw(
                200,
                &json!({"scans": [{"uuid": "00000001-3333-4333-8444-555555555555", "eval_outcome": "ALLOWED",
                    "created_at": "2026-10-18T10:00:00Z"}], "pagination": {"total_items": 1}}),
            );
        }
        if path == "/aiag/data/v1/stats/scans" {
            return raw(
                200,
                &json!({"unique_skills_scanned": {"count": 1, "percent_change": null},
                    "total_vulnerabilities_found": {"count": 0, "percent_change": null},
                    "top_vulnerability": null}),
            );
        }
        if path == "/aiag/data/v1/scans" {
            return raw(
                200,
                &json!({"scans": [{"uuid": "00000001-4444-4333-8444-555555555555", "name": "AG-PRIVATE-SKILL",
                    "status": "COMPLETED", "eval_outcome": "ALLOWED", "artifact_type": "skill",
                    "summary": {"vulnerability_count": 0, "attack_chain_count": 0},
                    "created_at": "2026-10-18T10:00:00Z"}], "pagination": {"total_items": 1}}),
            );
        }
        raw(404, &json!({"error": "not found"}))
    }
}

fn raw(status: u16, body: &Value) -> Reply {
    let body = serde_json::to_vec(body).expect("json");
    Reply::Raw {
        head: format!(
            "HTTP/1.1 {status} Status\r\ncontent-type: application/json\r\ncontent-length: {}\r\nconnection: close",
            body.len()
        ),
        body,
    }
}

struct Desk {
    _core: Core,
    handle: AuthorityHandle,
    session: String,
    sequence: u64,
    _adapters: Handles,
    script: Arc<Mutex<Script>>,
    _server: TlsServer,
}

async fn desk(buckets: Vec<u32>) -> Desk {
    let ca = TestCa::new("airs-v2 c36 ca");
    let script = Arc::new(Mutex::new(Script {
        buckets,
        no_breakdown: false,
        chart_status: 200,
        keys: vec![],
    }));
    let routed = Arc::clone(&script);
    let server = TlsServer::start(
        ca.leaf(&["localhost"]),
        Reply::Route(Arc::new(move |seen| {
            routed.lock().expect("script").route(seen)
        })),
    )
    .await;
    let origin = format!("https://localhost:{}", server.port);
    let (adapters, handles) = fixtures::adapters();
    let config = CoreConfig {
        management: ManagementEndpoints::at_origin(&origin),
        deadline_tick: Duration::from_millis(100),
        ..CoreConfig::default()
    };
    let core = Core::new(config, adapters);
    core.start();
    core.set_transport_policy(TransportPolicy {
        revision: 2,
        proxy: ProxyMode::Direct,
        extra_roots: vec![ca.pem.as_bytes().to_vec()],
    })
    .expect("policy");
    let handle = core.operator();
    let session = handle.register_delivery_session().expect("session").nonce;
    let mut desk = Desk {
        _core: core,
        handle,
        session,
        sequence: 0,
        _adapters: handles,
        script,
        _server: server,
    };
    desk.send(
        json!({"kind": "createTenant", "profile": {"label": "Northwind Health", "tsgId": TSG,
        "destination": {"kind": "custom", "origin": origin}}}),
    )
    .await
    .expect("tenant");
    let id = desk.snap().tenants[0].id.as_str().to_owned();
    desk.send(json!({"kind": "selectTenant", "tenant": id}))
        .await
        .expect("selected");
    let context = desk.context();
    desk.send(
        json!({"kind": "configureManagementCredential", "context": context, "mode": "keychain",
        "clientId": CLIENT_ID, "secret": CLIENT_SECRET}),
    )
    .await
    .expect("management key");
    assert!(
        eventually(|| desk
            .snap()
            .tenants
            .iter()
            .any(|t| t.management.state == ScanState::Ready))
        .await
    );
    desk
}

impl Desk {
    async fn send(&mut self, intent: Value) -> Result<Receipt, Refusal> {
        let intent: Intent = serde_json::from_value(intent).expect("intent");
        self.sequence += 1;
        self.handle
            .dispatch(
                Delivery {
                    session: self.session.clone(),
                    sequence: self.sequence,
                },
                intent,
            )
            .await
    }

    fn snap(&self) -> ShellSnapshot {
        match self.handle.observe(ViewScope::Shell).expect("observe") {
            Observation::Shell { snapshot, .. } => snapshot,
            _ => unreachable!("shell scope"),
        }
    }

    fn context(&self) -> String {
        self.snap()
            .active
            .expect("active")
            .context
            .as_str()
            .to_owned()
    }

    fn script(&self) -> std::sync::MutexGuard<'_, Script> {
        self.script.lock().expect("script")
    }

    /// `readTenant`, waited to completion.
    async fn read(&mut self) -> ShellSnapshot {
        let context = self.context();
        let before = self.snap().inbox.read.generation;
        self.send(json!({"kind": "readTenant", "context": context}))
            .await
            .expect("read admitted");
        assert!(
            eventually(|| {
                let s = self.snap();
                s.inbox.read.generation != before && !s.overview.refreshing
            })
            .await,
            "the read completed"
        );
        self.snap()
    }
}

#[tokio::test(flavor = "multi_thread")]
async fn the_runtime_card_draws_the_summary_and_the_chart_of_one_read() {
    let mut desk = desk(vec![0, 2, 1, 4]).await;
    let snap = desk.read().await;
    let read = snap.overview.read.expect("a read");
    // The figure: detection events summed from every bucket's usable breakdown.
    assert_eq!(read.summary.detection_events, Some(7));
    assert_eq!(read.summary.violating, Some(7));
    assert_eq!(read.summary.sessions, Some(47));
    // The bars: the buckets as the service reported them, in order.
    let chart = read.chart.expect("chart");
    let violating: Vec<u32> = chart.buckets.iter().map(|b| b.violating).collect();
    assert_eq!(violating, [0, 2, 1, 4]);
    assert_eq!(chart.bucket_seconds, 3600);
    // No Gateway workspace is selected: the Gateway card has no day to draw.
    assert!(read.gateway.is_none());
    // The pill follows the product's read state.
    let runtime = snap
        .inbox
        .read
        .products
        .iter()
        .find(|p| p.product == ProductId::RuntimeSecurity)
        .expect("runtime read");
    assert_eq!(runtime.state, ProductReadState::Ok);
    assert_eq!(snap.inbox.read.state, ReadState::Done);
    assert!(snap.inbox.read.last_read_at.is_some());
    // Without usable breakdowns the figure is unknown, never zero (the card shows an em dash).
    desk.script().no_breakdown = true;
    let snap = desk.read().await;
    let read = snap.overview.read.expect("a read");
    assert_eq!(read.summary.detection_events, None);
    assert_eq!(read.summary.violating, Some(7));
}

#[tokio::test(flavor = "multi_thread")]
async fn the_attention_list_is_the_needs_action_entries_minus_the_operators_holds() {
    let mut desk = desk(vec![3]).await;
    let snap = desk.read().await;
    // Violating sessions make the activity entry something to act on.
    let needing: Vec<&str> = snap
        .inbox
        .items
        .iter()
        .filter(|i| i.needs_action && i.hold.is_none())
        .map(|i| i.id.as_str())
        .collect();
    assert_eq!(needing, ["runtime-activity"]);
    assert_eq!(snap.overview.attention.len(), 1);
    // Acknowledged from the card list: held, so Home's count drops; the entry itself stays.
    let context = desk.context();
    desk.send(json!({"kind": "acknowledgeItem", "context": context, "id": "runtime-activity"}))
        .await
        .expect("acknowledged");
    let snap = desk.snap();
    let entry = snap
        .inbox
        .items
        .iter()
        .find(|i| i.id == "runtime-activity")
        .expect("entry kept");
    assert!(entry.hold.is_some());
    assert!(
        snap.inbox
            .items
            .iter()
            .all(|i| !(i.needs_action && i.hold.is_none()))
    );
    // A quiet chart leaves nothing to act on: the empty state names the read.
    desk.script().buckets = vec![0, 0];
    let snap = desk.read().await;
    assert!(
        snap.inbox
            .items
            .iter()
            .all(|i| !(i.needs_action && i.hold.is_none()))
    );
    assert_eq!(snap.inbox.read.state, ReadState::Done);
}

#[tokio::test(flavor = "multi_thread")]
async fn a_recheck_is_admitted_only_for_a_product_the_read_lists_and_a_failed_source_is_partial() {
    let mut desk = desk(vec![1]).await;
    let snap = desk.read().await;
    let listed: Vec<ProductId> = snap.inbox.read.products.iter().map(|p| p.product).collect();
    assert!(listed.contains(&ProductId::RuntimeSecurity));
    // A failed chart: the product is partial and its card offers a recheck, which names it until the read lands.
    desk.script().chart_status = 503;
    let snap = desk.read().await;
    let runtime = snap
        .inbox
        .read
        .products
        .iter()
        .find(|p| p.product == ProductId::RuntimeSecurity)
        .expect("runtime read");
    assert_eq!(runtime.state, ProductReadState::Incomplete);
    assert!(
        snap.inbox
            .read
            .sources_missing
            .contains(&"sessions chart".to_owned())
    );
    desk.script().chart_status = 200;
    let context = desk.context();
    let before = desk.snap().inbox.read.generation;
    desk.send(json!({"kind": "recheckProduct", "context": context, "product": "runtimeSecurity"}))
        .await
        .expect("recheck admitted");
    assert_eq!(
        desk.snap().inbox.read.rechecking,
        Some(ProductId::RuntimeSecurity)
    );
    assert!(eventually(|| desk.snap().inbox.read.generation != before).await);
    let snap = desk.snap();
    let runtime = snap
        .inbox
        .read
        .products
        .iter()
        .find(|p| p.product == ProductId::RuntimeSecurity)
        .expect("runtime read");
    assert_eq!(runtime.state, ProductReadState::Ok);
    assert_eq!(snap.inbox.read.rechecking, None);
    // A product the read does not list is not a card that can be rechecked: refused, no request.
    for product in listed_absent(&snap) {
        let outcome = desk
            .send(json!({"kind": "recheckProduct", "context": context, "product": product}))
            .await;
        assert_eq!(outcome, Err(Refusal::InvalidInput), "{product}");
    }
    // The gated products have no read state at all: they are not even a product id.
    assert!(
        serde_json::from_value::<Intent>(
            json!({"kind": "recheckProduct", "context": context, "product": "agenticIdentity"})
        )
        .is_err()
    );
}

/// The admitted products the read does not list for this tenant.
fn listed_absent(snap: &ShellSnapshot) -> Vec<&'static str> {
    let listed: Vec<ProductId> = snap.inbox.read.products.iter().map(|p| p.product).collect();
    [
        (ProductId::RuntimeSecurity, "runtimeSecurity"),
        (ProductId::Gateway, "gateway"),
        (ProductId::RedTeam, "redTeam"),
        (ProductId::ModelSkill, "modelSkill"),
    ]
    .into_iter()
    .filter(|(id, _)| !listed.contains(id))
    .map(|(_, name)| name)
    .collect()
}

