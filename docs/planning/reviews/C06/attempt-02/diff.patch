+def png(width=8, height=8):
+    """A small valid PNG (solid colour), so the WebView renders it."""
+    import struct
+    import zlib
+
+    def chunk(kind, data):
+        return struct.pack(">I", len(data)) + kind + data + struct.pack(">I", zlib.crc32(kind + data) & 0xFFFFFFFF)
+    rows = b"".join(b"\x00" + b"\x2b\x6c\xb0" * width for _ in range(height))
+    return (b"\x89PNG\r\n\x1a\n" + chunk(b"IHDR", struct.pack(">IIBBBBB", width, height, 8, 2, 0, 0, 0))
+            + chunk(b"IDAT", zlib.compress(rows)) + chunk(b"IEND", b""))
+
+
+def timer_text(tree):
+    """The text inside the assessment timer ('Time remaining'), e.g. '59:58';
+    None when no timer is shown."""
+    for i, n in enumerate(tree):
+        if (n.get("label") or "") == "Time remaining":
+            text = ""
+            for m in tree[i + 1:]:
+                if m.get("depth", 0) <= n.get("depth", 0):
+                    break
+                text += m.get("label") or ""
+            return text
+    return None
