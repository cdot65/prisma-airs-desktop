+fn origin(desk: &Desk) -> String {
+    desk.script.lock().expect("script").origin.clone()
+}
+
+fn failed(failure: CallFailure, outcome: Outcome) -> AcademyCallResult {
+    AcademyCallResult::Failed { failure, outcome }
