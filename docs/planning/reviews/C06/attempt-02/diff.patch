+        .images
+        .reply(Some(Ok(("me.png".into(), png()))));
+    {
+        let mut script = desk.script.lock().expect("script");
+        script.trpc = vec![
+            (
+                "settings.avatarUploadUrl".into(),
+                200,
+                presigned(format!("{origin}/upload/u.png?sig=2")),
+            ),
+            (
+                "settings.confirmAvatar".into(),
+                503,
+                error(503, "INTERNAL_SERVER_ERROR", "upstream"),
+            ),
+        ];
+        script.files = vec![("/upload/u.png".into(), 200, "text/plain".into(), Vec::new())];
+    }
+    let reply = host(
+        &mut desk,
+        json!({"kind": "uploadAvatar", "learner": learner}),
+    )
+    .await
+    .expect("admitted");
+    assert!(
+        matches!(
+            reply,
+            AcademyCallResult::Error {
+                http_status: 503,
+                outcome: Outcome::Unknown,
+                ..
+            }
+        ),
+        "{reply:?}"
+    );
+    assert_eq!(trpc_requests(&desk, "settings.confirmAvatar").len(), 1);
+}
+
+#[tokio::test(flavor = "multi_thread")]
+async fn only_a_signed_in_current_learner_may_upload_an_avatar() {
+    let mut desk = desk().await;
+    let guest = desk.current_learner();
+    assert_eq!(
+        desk.send(json!({"kind": "uploadAvatar", "learner": guest}))
+            .await
+            .err(),
+        Some(Refusal::CapabilityMissing)
+    );
+    desk.sign_in().await;
+    assert_eq!(
+        desk.send(json!({"kind": "uploadAvatar", "learner": guest}))
+            .await
+            .err(),
+        Some(Refusal::StaleContext)
+    );
+    assert_eq!(desk.adapters.images.opened(), 0);
+}
+
+#[tokio::test(flavor = "multi_thread")]
+async fn the_avatar_is_read_back_from_academys_origin_as_a_data_url_only() {
+    let mut desk = desk().await;
+    desk.sign_in().await;
+    let origin = origin(&desk);
+    let learner = desk.learner();
+    desk.script.lock().expect("script").files = vec![
+        (
+            "/api/avatars/user_2fixture.png".into(),
+            200,
+            "image/png".into(),
+            png(),
+        ),
+        (
+            "/api/avatars/user_2other.png".into(),
+            200,
+            "text/html".into(),
+            b"<script>x</script>".to_vec(),
+        ),
+    ];
+    let reply = host(
+        &mut desk,
+        json!({"kind": "loadAcademyImage", "learner": learner, "url": format!("{origin}/api/avatars/user_2fixture.png?v=7")}),
+    )
+    .await
+    .expect("admitted");
+    let AcademyCallResult::Data { data: returned } = reply else {
+        panic!("{reply:?}")
+    };
+    let src = serde_json::from_str::<Value>(&returned).expect("json")["json"]["src"]
+        .as_str()
+        .expect("src")
+        .to_owned();
+    assert_eq!(
+        src,
+        "data:image/png;base64,iVBORw0KGgpzeW50aGV0aWMgYXZhdGFyIHBpeGVscw=="
+    );
+    let read = desk.requests("/api/avatars/user_2fixture.png");
+    assert_eq!(read.len(), 1);
+    assert_eq!(read[0].header("authorization"), None, "avatars are public");
+    // A reply that is not the image it claims to be is not shown.
+    let reply = host(
+        &mut desk,
+        json!({"kind": "loadAcademyImage", "learner": learner, "url": format!("{origin}/api/avatars/user_2other.png")}),
+    )
+    .await
+    .expect("admitted");
+    assert_eq!(
+        reply,
+        failed(CallFailure::InvalidResponse, Outcome::Rejected)
+    );
+    // Any other address is refused before a request.
+    for url in [
+        "https://cdn.example/api/avatars/user_2fixture.png".to_owned(),
+        format!("{origin}/api/trpc/settings.get"),
+        format!("{origin}/api/avatars/user_2fixture.svg"),
+    ] {
+        assert_eq!(
+            desk.send(json!({"kind": "loadAcademyImage", "learner": learner, "url": url}))
+                .await
+                .err(),
+            Some(Refusal::InvalidInput),
+            "{url}"
+        );
+    }
+    assert_eq!(desk.requests("/api/avatars/").len(), 2);
+    assert!(trpc_requests(&desk, "settings.get").is_empty());
+}
