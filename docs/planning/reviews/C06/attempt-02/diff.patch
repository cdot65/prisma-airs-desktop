+
+    add("C06-N11", o["zoom"]["clear"] and o["min_size"]["clear"],
+        f"200% zoom: {o['zoom']['found']} in window {o['zoom']['window']}, clear: {o['zoom']['clear']}; minimum size: {o['min_size']['found']} in window {o['min_size']['window']}, clear: {o['min_size']['clear']}",
