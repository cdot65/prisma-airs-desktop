+impl AcademyClient {
+    /// Stores an avatar at a presigned upload destination: a single PUT of
+    /// the bytes with their content type and no credential (the signature
+    /// is in the URL). The caller has checked the destination.
+    pub async fn put_upload(
+        &self,
+        url: Url,
+        content_type: &str,
+        bytes: Vec<u8>,
+        timeout: Duration,
+    ) -> Result<(), CallFailure> {
+        let response = self
+            .http
+            .put(url)
+            .timeout(timeout)
+            .header("content-type", content_type)
+            .body(bytes)
+            .send()
+            .await
+            .map_err(|_| CallFailure::UploadFailed)?;
+        if response.status().is_success() {
+            Ok(())
+        } else {
+            Err(CallFailure::UploadFailed)
+        }
+    }
+
+    /// Reads one public Academy image without a credential: its declared
+    /// content type and at most `limit` bytes. The caller has checked the
+    /// address.
+    pub async fn get_image(
+        &self,
+        url: Url,
+        limit: usize,
+        timeout: Duration,
+    ) -> Result<(String, Vec<u8>), CallFailure> {
+        let response = self
+            .http
+            .get(url)
+            .timeout(timeout)
+            .header("accept", "image/jpeg, image/png, image/webp")
+            .send()
+            .await
+            .map_err(|e| {
+                if e.is_timeout() {
+                    CallFailure::Timeout
+                } else {
+                    CallFailure::Network
+                }
+            })?;
+        if response.status().as_u16() != 200 {
+            return Err(CallFailure::InvalidResponse);
+        }
+        let content_type = response
+            .headers()
+            .get("content-type")
+            .and_then(|v| v.to_str().ok())
+            .map(|v| {
+                v.split(';')
+                    .next()
+                    .unwrap_or("")
+                    .trim()
+                    .to_ascii_lowercase()
+            })
+            .unwrap_or_default();
+        let body = bounded_body(response, limit)
+            .await
+            .map_err(|()| CallFailure::InvalidResponse)?;
+        Ok((content_type, body))
+    }
+}
