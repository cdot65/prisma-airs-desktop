from an earlier load is obsolete (two selections\n    // in flight resolving out of order replaced the current request's document with the earlier one's).\n    const loadGen = useRef(0)\n    // A load that failed, by request id, with its reason: shown in place of the editor with Try again (no automatic retry).\n    const [loadFailure, setLoadFailure] = useState<{ id: string; relative: string; text: string } | null>(null)\n    const [editorStatus, setEditorStatus] = useState<{ owner: string; value: EditorStatus } | null>(null)\n    const statusOwner = useRef<string | null>(null)\n    const tabStrip = useRef<HTMLDivElement>(null)\n    const tenant = snapshot.active?.tenant ?? null\n    const context = snapshot.active?.context ?? null\n    const startupFailure = useShellStore((s) => s.workbenchRecovery.tenant === tenant && s.workbenchRecovery.context === context && s.workbenchRecovery.failed)\n    const startupMessage = useShellStore((s) => s.workbenchRecovery.tenant === tenant && s.workbenchRecovery.context === context ? s.workbenchRecovery.message : '')\n    const restorePreferred = useCallback(async () => {\n        const recovery = useShellStore.getState()\n        const generation = recovery.beginWorkbenchRestore(tenant, context)\n        if (generation === null) return { kind: 'cancelled' } as const\n        const action = ++messageAction.current\n        const result = await call({ kind: 'load' })\n        const current = useShellStore.getState().workbenchRecovery\n        // A successful retry retires its prior alternative-open message, even if the opened snapshot arrived first.\n        // Another action, context or collection generation must keep its own message.\n        const currentChoice = current.generation === generation || (current.collection !== null && current.generation === generation + 1)\n        if (action === messageAction.current && current.tenant === tenant && current.context === context && currentChoice && (result.kind === 'opened' || result.kind === 'done')) {\n            setMessage('')\n            setOfferNew(false)\n        }\n        // Admission/delivery/observation failure is still unresolved, including on the first load.\n        // Only a positive owned result may retire recovery; keep sanitized text with its scope.\n        const resolved = result.kind === 'opened' || result.kind === 'done'\n        const deliveryMessage = result.kind === 'undelivered' ? resultText(result) ?? '' : result.kind === 'cancelled' ? recovery.workbenchRecovery.message : ''\n        recovery.finishWorkbenchRestore(tenant, context, generation, !resolved, deliveryMessage)\n        return result\n    }, [call, tenant, context])\n    const editors = useRef(new Map<string, EditorHandle>())\n    const [closing, setClosing] = useState<Closing | null>(null)\n    // The Collection chip: where focus returns when its menu or a tool it opened closes (the menu item is gone by then).\n    const chip = useRef<HTMLButtonElement>(null)\n\n    // A refusal stays shown until the next action that succeeds (a cancelled sheet keeps it).\n    const run: Run = async (request) => {\n        if (request.kind !== 'load') ++messageAction.current\n        const generation = useShellStore.getState().workbenchRecovery.generation\n        const r = request.kind === 'load' ? await restorePreferred() : await call(request)\n        if (request.kind === 'load') return r\n        if (['openFolder', 'openRecent', 'openBuiltIn', 'createCollection', 'closeCollection'].includes(request.kind) && ['done', 'opened', 'created'].includes(r.kind)) {\n            useShellStore.getState().resolveWorkbenchRestore(tenant, context, generation)\n        }\n        const text = resultText(r)\n        if (text) {\n            setMessage(text)\n            setOfferNew(r.kind === 'refused' && r.problem.kind === 'project' && r.problem.detail === 'notCollection')\n        } else if (r.kind !== 'cancelled') {\n            setMessage('')\n            setOfferNew(false)\n        }\n        return r\n    }\n\n    // Closing protects the latest typing first. If that fails, or Rust still\n    // sees unprotected edits, the operator chooses: keep editing, or close\n    // and discard them.\n    const close = async (target: Closing, discard = false) => {\n        setClosing(null)\n        const handles = target.kind === 'tab' ? [editors.current.get(target.id)] : [...editors.current.values()]\n        if (discard) {\n            for (const h of handles) h?.abandon()\n        } else {\n            const kept = await Promise.all(handles.map((h) => (h ? h.flush() : Promise.resolve(true))))\n            if (kept.includes(false)) {\n                setClosing(target)\n                return\n            }\n        }\n        const r = await run(target.kind === 'tab' ? { kind: 'closeTab', id: target.id, discard } : { kind: 'closeCollection', discard })\n        if (r.kind === 'refused' && r.problem.kind === 'unprotected') {\n            setClosing(target)\n            return\n        }\n        if (r.kind === 'closed' || r.kind === 'done') {\n            if (target.kind === 'tab') editors.current.delete(target.id)\n            else editors.current.clear()\n        }\n    }\n\n    // Every document-producing call is a load bound to the collection it was asked of and to a generation; a reply\n    // from an earlier generation, or from a collection no longer open, is dropped (a late reply replaced the current\n    // request's document, or resurrected a closed one).\n    // Rust derives this opaque scope from the full root and collection id. The displayed folder is only a basename:\n    // two clones can have the same id and basename under different parents (attempt-05 R1).\n    const collectionKey = collection?.scope ?? null\n    const collectionRef = useRef<string | null>(collectionKey)\n    collectionRef.current = collectionKey\n    const selectedRef = useRef<string | null>(collection?.selected ?? null)\n    useEffect(() => {\n        if (!selectedTab || followed.current === selectedTab.id) return\n        followed.current = selectedTab.id\n        // A load of another request still in flight is obsolete once the selection moves on: its reply must not land.\n        if (loading.current !== null && loading.current !== selectedTab.id) {\n            loadGen.current += 1\n            loading.current = null\n        }\n        const reusable = doc?.id === selectedTab.id && docCollection.current === collectionId && staleDoc.current !== selectedTab.id\n        if (reusable || loading.current === selectedTab.id) return\n        // A stale document is not shown while its reload is in flight: remounted, its editor would start from the old\n        // fields and keep them when the fresh document arrived under the same key.\n        if (doc?.id === selectedTab.id) setDoc(null)\n        openRef.current(selectedTab)\n    }, [selectedTab, doc, collectionId])\n    // Recorded after the selection was followed, so that effect sees which editor was up before this render.\n    useEffect(() => {\n        if (editorUp && doc) {\n            editorFor.current = doc.id\n            staleDoc.current = null\n        } else if (editorFor.current !== null) {\n            staleDoc.current = editorFor.current\n            editorFor.current = null\n        }\n    }, [editorUp, doc])\n    const loaded = state.loaded\n    useEffect(() => {\n        if (!loaded && !useShellStore.getState().workbenchRecovery.failed) void restorePreferred()\n    }, [loaded, restorePreferred])\n    // The collection menu closes on Escape (focus back on the chip) and on a click elsewhere.\n    useEffect(() => {\n        if (!menu) return\n        const onKey = (e: KeyboardEvent) => {\n            if (e.key !== 'Escape') return\n            setMenu(false)\n            chip.current?.focus()\n        }\n        const onClick = () => setMenu(false)\n        window.addEventListener('keydown', onKey)\n        window.addEventListener('click', onClick)\n        return () => {\n            window.removeEventListener('keydown', onKey)\n            window.removeEventListener('click', onClick)\n        }\n    }, [menu])\n\n    const where = collection ? (collection.builtIn ? C.chips.builtIn : collection.folder) : ''\nimport { createContext, useContext, useEffect, useId, useLayoutEffect, useRef, useState, type KeyboardEvent, type ReactNode } from 'react'\nimport { createPortal } from 'react-dom'\nimport { useShellStore } from './store'\n\n// Undefined preserves standalone use; null means the shell host is mounting.\nconst DesktopModalHostContext = createContext<HTMLElement | null | undefined>(undefined)\n\n/** Desktop-owned dialogs stay inside the shell palette, outside its inert page. */\nexport function DesktopModalHost({ children }: { children: ReactNode }) {\n    const [host, setHost] = useState<HTMLDivElement | null>(null)\n    return (\n        <DesktopModalHostContext.Provider value={host}>\n            {children}\n            <div ref={setHost} data-slot='desktop-modal-host' data-desktop-theme='' className='contents' />\n        </DesktopModalHostContext.Provider>\n    )\n}\n\ninterface ModalProps {\n    label: string\n    onClose: () => void\n    children: ReactNode\n    /** Width in CSS px (default 560). */\n    width?: number\n    /** Inner padding in CSS px (default 20); 0 for a dialog that lays itself out edge to edge. */\n    padding?: number\n    /** Distance from the top of the window in CSS px (default 4vh); the prototype's palette sits at 90. */\n    top?: number\n    /** Corner radius in CSS px (default 12; the palette's frame is 14). */\n    radius?: number\n    /** A sheet docked to the window's right edge under the header (R2App's review sheet, 620px wide, full height). */\n    sheet?: boolean\n    /**\n     * The control focus returns to on close when the opener itself will be gone\n     * by then (a menu item that closes with its menu as the dialog opens): an\n     * explicit surviving target instead of whatever had focus at mount.\n     */\n    returnFocus?: HTMLElement | null\n    'data-slot'?: string\n}\n\nconst FOCUSABLE = 'a[href], button:not([disabled]), input:not([disabled]), select:not([disabled]), textarea:not([disabled]), [tabindex]:not([tabindex=\"-1\"])'\n\n/**\n * One topmost modal (I8): dialogs register on a shell-wide stack; only the\n * last is interactive. Lower dialogs are inert and aria-hidden, Tab and\n * Shift-Tab stay inside the topmost dialog, Escape closes the topmost only,\n * focus moves into the dialog on open and back to the opener on close. The\n * page behind every dialog is made inert by the shell (`useModalsOpen`).\n * The dialog element handles its own keys; the topmost dialog also listens\n * on the window for Escape alone, for when focus has left it (a native\n * sheet returned focus elsewhere), and closes only itself.\n */\nexport function Modal({ label, onClose, children, width = 560, padding = 20, top, radius = 12, sheet = false, returnFocus = null, ...rest }: ModalProps) {\n    const host = useContext(DesktopModalHostContext)\n    const id = useId()\n    const pushModal = useShellStore((s) => s.pushModal)\n    const popModal = useShellStore((s) => s.popModal)\n    const modals = useShellStore((s) => s.modals)\n    const topmost = modals.length > 0 && modals[modals.length - 1] === id\n    const dialog = useRef<HTMLDivElement>(null)\n    const opener = useRef<HTMLElement | null>(null)\n    const returnRef = useRef(returnFocus)\n    returnRef.current = returnFocus\n    const focusedOnce = useRef(false)\n\n    // Capture before a child wizard's passive heading-focus effect runs.\n    useLayoutEffect(() => {\n        opener.current = document.activeElement instanceof HTMLElement ? document.activeElement : null\n        pushModal(id)\n        return () => {\n            popModal(id)\n            // After the commit: the page behind is still inert during cleanup,\n            // and an inert ancestor refuses focus (observed in WebKit).\n            const target = returnRef.current ?? opener.current\n            queueMicrotask(() => {\n                // Only when nothing else took focus meanwhile (⌘T replacing the\n                // palette hands focus to the tenant list, which must keep it).\n                const active = document.activeElement\n                if (active && active !== document.body) return\n                // The opener may be gone (a \"Finish rotation…\" that completed):\n                // focus the page heading rather than leave it on nothing.\n                if (target?.isConnected) target.focus()\n                else document.querySelector<HTMLElement>('[data-slot=\"page-heading\"], main h1[tabindex=\"-1\"]')?.focus()\n            })\n        }\n    }, [id, pushModal, popModal])\n\n    useEffect(() => {\n        // Initial focus goes into the dialog once, when it opens. Regaining the\n        // top after a higher dialog closes must not refocus: that dialog is\n        // restoring its own opener, which may be any control here.\n        if (!topmost || focusedOnce.current) return\n        const node = dialog.current\n        if (!node) return\n        focusedOnce.current = true\n        if (!node.contains(document.activeElement)) {\n            // A declared initial control first (wherever it sits), else the first focusable.\n            const first = node.querySelector<HTMLElement>('[autofocus]') ?? node.querySelector<HTMLElement>(FOCUSABLE)\n            ;(first ?? node).focus()\n        }\n    }, [topmost, host])\n\n    // Escape still closes the topmost dialog when focus has left it (a\n    // native sheet returning focus to the page body, a click on the scrim's\n    // edge): the dialog's own handler stops the event first when it has focus.\n    const closeRef = useRef(onClose)\n    closeRef.current = onClose\n    useEffect(() => {\n        if (!topmost) return\n        const onWindowKey = (event: globalThis.KeyboardEvent) => {\n            if (event.key !== 'Escape' || event.defaultPrevented) return\n            const node = dialog.current\n            if (node && node.contains(document.activeElement)) return\n            event.preventDefault()\n            closeRef.current()\n        }\n        window.addEventListener('keydown', onWindowKey)\n        return () => window.removeEventListener('keydown', onWindowKey)\n    }, [topmost])\n\n    const onKeyDown = (event: KeyboardEvent<HTMLDivElement>) => {\n        if (!topmost) return\n        if (event.key === 'Escape') {\n            event.preventDefault()\n            event.stopPropagation()\n            onClose()\n            return\n        }\n        if (event.key === 'Tab') {\n            // Keyboard interaction stays inside the topmost dialog.\n            const node = dialog.current\n            if (!node) return\n            const items = Array.from(node.querySelectorAll<HTMLElement>(FOCUSABLE)).filter((el) => !el.hasAttribute('hidden') && el.getAttribute('aria-hidden') !== 'true')\n            if (items.length === 0) {\n                event.preventDefault()\n                node.focus()\n                return\n            }\n            const first = items[0] as HTMLElement\n            const last = items[items.length - 1] as HTMLElement\n            const active = document.activeElement\n            if (event.shiftKey && (active === first || active === node)) {\n                event.preventDefault()\n                last.focus()\n            } else if (!event.shiftKey && active === last) {\n                event.preventDefault()\n                first.focus()\n            }\n        }\n    }\n\n    const content = (\n        <div\n            className={sheet ? 'fixed z-50 flex justify-end' : 'fixed inset-0 z-50 grid place-items-start justify-center'}\n        pendingExplainOpen.current = on ? tenantNow : undefined\n        if (on) {\n            setExplainTenant(tenantNow)\n            explainOpener.current = explainButton.current\n        }\n        props.onSetShowCalls(on)\n    }\n    useEffect(() => {\n        const previous = seenExplain.current\n        seenExplain.current = { tenant: tenantNow, open: explainOpen && snapshot.calls !== undefined }\n        if (previous.tenant !== tenantNow) {\n            explainOpener.current = null\n            const wasOpening = pendingExplainOpen.current === previous.tenant\n            pendingExplainOpen.current = undefined\n            setExplainTenant(undefined)\n            if (previous.open || wasOpening) props.onSetShowCalls(false)\n        }\n    }, [tenantNow, snapshot.calls, explainOpen, props.onSetShowCalls])\n    const seenGeneration = useRef<{ tenant: string | null; generation: number }>({ tenant: tenantNow, generation: read.generation })\n    useEffect(() => {\n        const seen = seenGeneration.current\n        seenGeneration.current = { tenant: tenantNow, generation: read.generation }\n        if (seen.tenant !== tenantNow || read.generation === seen.generation) return\n        const tenant = snapshot.tenants.find((t) => t.id === tenantNow)\n        const line = readLine(snapshot, tenant?.label ?? null)\n        useShellStore.getState().toast(line.text, line.tone === 'allowed' ? 'ok' : 'warn', undefined, tenantNow, snapshot.active?.context ?? null)\n    }, [read.generation, tenantNow, snapshot])\n    // A snooze is announced once, from the receipt the core issues for it\n    // (I11): the return time is the core's, wherever the snooze was asked\n    // for. Holds a tenant already had, or a read rediscovers, are not news.\n    const lastSnooze = snapshot.inbox.lastSnooze\n    const seenSnooze = useRef<{ tenant: string | null; sequence: number }>({ tenant: tenantNow, sequence: lastSnooze?.sequence ?? 0 })\n    useEffect(() => {\n        const seen = seenSnooze.current\n        const sequence = lastSnooze?.sequence ?? 0\n        seenSnooze.current = { tenant: tenantNow, sequence }\n        if (seen.tenant !== tenantNow || !lastSnooze || sequence === seen.sequence) return\n        useShellStore.getState().toast(SNOOZE_COPY.toast(lastSnooze.title, lastSnooze.returnsAt), 'info', undefined, tenantNow, snapshot.active?.context ?? null)\n    }, [lastSnooze, tenantNow, snapshot.active])\n    // Presentation state follows its tenant (I2): an arrival another tenant\n    // asked for is forgotten, a toast that spoke for another tenant's item or\n    // read is retired (however long Reduce Motion would have kept it), and an\n    // unconfirmed delivery bound to a retired context is dropped (it can\n    // never be revived, let alone rebound).\n    const contextNow = snapshot.active?.context ?? null\n    useEffect(() => {\n        useShellStore.getState().scopeArrival(tenantNow)\n        useShellStore.getState().retireToasts(tenantNow)\n        useShellStore.getState().retireUnconfirmed(contextNow)\n    }, [tenantNow, contextNow])\n    // The guard for a switch asked here (I1); a setup draft's completion\n    // renders the same guard inside the wizard, which re-sends the completion.\n    const guard = snapshot.switchBlocked && !snapshot.switchBlocked.completion ? snapshot.switchBlocked : null\n    const guardTarget = guard ? snapshot.tenants.find((t) => t.id === guard.to)?.label ?? guard.to : null\n\n    useEffect(() => {\n        // Move focus to the new page heading after navigation (not on launch).\n        if (firstRender.current) {\n            firstRender.current = false\n            return\n        }\n        heading.current?.focus()\n    }, [active])\n\n    const observeWorkbench = useCallback((operation: string) => props.client.observeWorkbench(operation), [props.client])\n\n    if (!feature) return null\n                        )}\n                        <p role='status' aria-live='polite' data-slot='shell-status' className='mt-4 text-[13px]' style={{ color: 'var(--v2-soft)' }}>\n                            {props.status}\n                        </p>\n                    </main>\n                    {explainOpen && snapshot.calls !== undefined && <ExplainDrawer snapshot={snapshot} dispatch={props.dispatch} onClose={() => setExplain(false)} returnFocus={explainOpener.current} modalOpen={modalOpen} />}\n                </div>\n            </div>\n            {paletteOpen && (\n                <Palette snapshot={snapshot} onNavigate={props.onNavigate} onSwitchTenant={props.onSwitchTenant} onReadNow={props.onReadNow} onClose={closePalette} />\n            )}\n            {guard && guardTarget && (\n                <SwitchGuard target={guardTarget} completion={false} binding={guard} onStay={() => void props.dispatch({ kind: 'dismissSwitchGuard' })} onResolve={(resolution) => props.onSwitchTenant(guard.to, resolution)} />\n            )}\n            {adding && (\n                <Modal label='Add a tenant' onClose={() => setCloseRequests((n) => n + 1)} width={1160} padding={0} data-slot='add-tenant-sheet'>\n                    <Wizard\n                        snapshot={snapshot}\n                        dispatch={props.dispatch}\n                        observeManagement={(operation) => props.client.observeManagement(operation)}\n                        mode='add'\n                        onClose={closeSheet}\n                        closeRequests={closeRequests}\n                        onNavigate={(feature) => {\n                            setAdding(false)\n                            props.onNavigate(feature)\n                        }}\n                    />\n                </Modal>\n            )}\n            {/* Toasts are background siblings of a modal too (I8): inert and hidden while one is open. */}\n            <div aria-hidden={modalOpen ? true : undefined} inert={modalOpen ? true : undefined}>\n                <Toasts />\n            </div>\n            </DesktopModalHost>\n        </div>\n    )\n}\n","exit_code":0,"status":"completed"}}
