{"type":"item.completed","item":{"id":"item_31","type":"command_execution","command":"/bin/zsh -lc \"sed -n '220,328p' tools/p11/remediation.py; cat docs/planning/evidence/P11/review-carry-qa-01/record.json; python3 -c 'import json;from pathlib import Path\nfor f in [\\\"docs/planning/evidence/P11/recovery-native-04/supplement.json\\\",\\\"docs/planning/evidence/P11/native-attempt-12-vm/observations.json\\\",\\\"docs/planning/evidence/P11/c47-scroll-supplement-01/supplement.json\\\"]:\n p=Path(f)\n if p.exists():\n  d=json.loads(p.read_text());print(f);print(\\\"keys\\\",list(d)); print(\\\"captures\\\",d.get(\\\"captures\\\")); print(\\\"facts\\\",d.get(\\\"facts\\\"))'\"","aggregated_output":"\ndef selector_reference(receipt, cid):\n    return receipt['recovery'] if cid == 'C48-N03' else receipt['format'] if cid == 'check:C46/check/1' else receipt['source_qa']\n\n\ndef source_transition(root, receipt, candidate, source, files):\n    old_record = read(bound(root, receipt['baseline']))\n    require(receipt['baseline']['path'] == BASELINE, 'foreign remediation baseline')\n    old_coverage = read(bound(root, old_record['coverage']))\n    old_candidate = read(bound(root, old_coverage['candidate']))\n    before = read(bound(root, old_record['source']))['files']\n    delta(before, files, receipt['changed_paths'])\n    require(all(candidate[k] == old_candidate[k] for k in ('conditions', 'build_flags'))\n            and all(candidate['runner_inputs'][k] == old_record['runner_inputs'][k]\n                    for k in ('dependencies', 'build_flags')), 'remediation VM/toolchain/flags changed')\n    history = ArchivedP11(root, receipt['historical_context'])\n    require(history.source(digest(before)) == root/'docs/planning/evidence/P11/source-history/S3',\n            'original reviewed source context differs')\n    proof.verify_coverage(root, old_coverage, historical=history)\n    preserved_bundle(root, receipt['preserved_candidate'], old_candidate)\n    scroll(root, receipt['scroll'], receipt['baseline'], old_candidate, files)\n    rust_consumers(root, receipt['rust_consumers'], files)\n    affected_lints(root, receipt, files)\n    format_selector(root, receipt['format'], files, candidate['execution_root'])\n    covered = set()\n    require(receipt['helper_qa'], 'remediation affected helper QA missing')\n    for ref in receipt['helper_qa']:\n        qa = read(bound(root, ref)); bound(root, qa['log'])\n        require(qa['schema'] == 'airs-desktop/p11-helper-qa/1' and qa['argv']\n                and qa['exit_code'] == 0 and qa['tests']['passed'] > 0 and qa['tests']['failed'] == 0\n                and qa.get('source_before') == qa.get('source_after')\n                and qa['helper_files'] and all(files.get(n, {}).get('sha256') == value\n                    for n, value in qa['helper_files'].items()), 'remediation helper QA failed/drifted')\n        covered.update(qa['helper_files'])\n    require({n for n in receipt['changed_paths'] if n.endswith('.py')} <= covered,\n            'remediation changed helper lacks affected QA')\n    return old_record, old_coverage, history\n\n\ndef undelivered_qa(root, supplement, files, retained=False):\n    import review_carry\n    original = read(bound(root, {'path': review_carry.OLD_QUALIFICATION,\n                                'sha256': review_carry.OLD_QUALIFICATION_SHA}))\n    require(supplement['baseline_source'] == original['source'], 'undelivered QA baseline differs')\n    before = read(bound(root, supplement['baseline_source']))['files']\n    review_carry.impact_delta(before, files, sorted(n for n in set(before)|set(files) if before.get(n) != files.get(n)))\n    source_qa(root, supplement['baseline_qa'], before)\n    producer = read(bound(root, supplement['producer_receipt']))\n    prior = supplement.get('prior_undelivered')\n    if prior:\n        require(prior == {'path': 'docs/planning/evidence/P11/retained-qa/c48-undelivered-01/supplement.json',\n            'sha256': 'fcae2aa0294ebad3e643e728d99aa1588b523e3048fe9c7e0e78c47fa34ec3b8'},\n            'unapproved retained undelivered-source stage')\n        undelivered_qa(root, read(bound(root, prior)), files, retained=True)\n    expected = supplement['source_files'] if retained else {n: files[n]['sha256'] for n in review_carry.RETRY_DELTA}\n    require(supplement['source_files'] == producer['source_files'] == expected\n            and len(supplement['checks']) == 2, 'current undelivered QA source/coverage differs')\n    count = 4 if prior else 8\n    for item, label in zip(supplement['checks'], ('green', 'typecheck') if prior else ('green-02', 'typecheck-02')):\n        raw = read(bound(root, item['record'])); log = bound(root, item['log'])\n        require(completed(raw) and raw['argv'] == item['argv']\n                and item['record']['sha256'] == producer['command_records'][label]['sha256']\n                and raw['log_sha256'] == sha(log)\n                and raw['source_before'] == raw['source_after'] == expected\n                and item['source_hashes'] == expected and set(item['source_inputs']) == set(expected),\n                'undelivered source selector failed or lost its original execution binding')\n        for name, ref in item['source_inputs'].items():\n            require(name in expected and sha(bound(root, ref)) == expected[name], 'undelivered original input differs')\n        if label.startswith('green'):\n            require(item['passed'] == producer['actual_outcomes'][label]['passed'] == count\n                    and producer['actual_outcomes'][label]['failed'] == 0\n                    and str(count)+' passed' in log.read_text(), 'undelivered regression coverage missing')\n    return supplement\n\n\ndef source_qa(root, reference, files):\n    supplement = read(bound(root, reference))\n    if supplement['schema'] == 'airs-desktop/p11-undelivered-source-supplement/1':\n        return undelivered_qa(root, supplement, files)\n    require(supplement['schema'] == 'airs-desktop/p11