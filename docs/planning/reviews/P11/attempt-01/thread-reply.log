{"type":"item.completed","item":{"id":"item_32","type":"command_execution","command":"/bin/zsh -lc 'cat tools/p11/native.py'","aggregated_output":"\"\"\"P11 per-assertion native origins. Never synthesizes a passing process run.\"\"\"\nfrom pathlib import Path\nimport argparse\nimport importlib.util\nimport json\nimport platform\nimport sys\nimport time\n\nsys.path.insert(0, str(Path(__file__).resolve().parents[1]/'p10'))\nfrom qualification import bound, read, require, sha\nfrom candidate import helper_closure\n\n\ndef reference(root, path):\n    path = Path(path).resolve()\n    require(path.is_relative_to(root.resolve()), 'native evidence escapes checkout')\n    return {'path': str(path.relative_to(root)), 'sha256': sha(path)}\n\n\ndef inventory_root(root):\n    archived = root/'docs/planning/evidence/P11/source-history/S2'\n    return archived if archived.is_dir() else root\n\n\ndef inventory(root):\n    chunks = read(inventory_root(root)/'docs/architecture/native-checks.json')['chunks']\n    return {row['id']: row['check'] for chunk in ('C46', 'C47', 'C48', 'C49') for row in chunks[chunk]}\n\n\ndef c46_helpers(root):\n    archived = root/'docs/planning/evidence/P11/source-history/S2'\n    paths = set(helper_closure(archived if archived.is_dir() else root, 'acceptance_p11_setup'))\n    paths.add('tools/native-acceptance/acceptance_p11.py')\n    require('tools/native-acceptance/acceptance_p11_api.py' not in paths,\n            'C46 scope unexpectedly depends on changed API helper')\n    return sorted(paths)\n\n\n\ndef positive_rows(raw):\n    return {row['id']: row for row in raw['checks']\n            if row['facts'] and all(value is True for value in row['facts'].values())}\n\n\ndef excluded_checks(raw):\n    return [{'id': row['id'],\n             'failed_facts': sorted(name for name, value in row['facts'].items() if value is not True),\n             'reason': 'Measured assertion was not completed; a later positive replacement is required.'}\n            for row in raw['checks'] if row['id'] not in positive_rows(raw)]\n\n\ndef artifact_carry(root, raw, candidate, prior_refs):\n    \"\"\"Only the diagnosed N01 layout facts/captures may support its repair.\"\"\"\n    carry = raw.get('artifact_carry')\n    if not carry: return {}\n    require(carry['assertion'] == 'C47-N01' and carry['observations'] in prior_refs,\n            'unapproved native artifact carry')\n    path = bound(root, carry['observations'])\n    old = read(path)\n    rows = [row for row in old['checks'] if row['id'] == 'C47-N01']\n    require(len(rows) == 1 and rows[0]['facts'].get('named_actions_keyboard_reachable') is False\n            and all(value is True for name, value in rows[0]['facts'].items()\n                    if name != 'named_actions_keyboard_reachable'),\n            'N01 carry does not retain the original isolated keyboard failure')\n    require(old['executable_sha256'] == candidate['executable_sha256']\n            and old['bundle_sha256'] == candidate['bundle_sha256']\n            and old['binding']['conditions'] == candidate['conditions']\n            and all(candidate['helper_closure'].get(name) == digest\n                    for name, digest in old['helper_closure'].items()),\n            'N01 retained layout artifact/helper/VM conditions differ')\n    allowed = set(rows[0]['evidence']+rows[0]['visual'])\n    repaired = [row for row in raw['checks'] if row['id'] == 'C47-N01']\n    matrices = [name for name in rows[0]['evidence'] if Path(name).name == 'shell-layout-measurements.json']\n    require(len(repaired) == 1 and len(matrices) == 1\n            and matrices[0] in repaired[0]['evidence']\n            and set(rows[0]['visual']) <= set(repaired[0]['visual'])\n            and {matrices[0], *rows[0]['visual']} <= set(carry['artifact_sha256']),\n            'N01 repair omitted retained matrix or capture review scope')\n    require(carry['artifact_sha256'] and set(carry['artifact_sha256']) <= allowed,\n            'N01 carry includes unrelated artifacts')\n    for name, digest in carry['artifact_sha256'].items():\n        require((root/name).resolve().is_relative_to(path.parent)\n                and old['artifact_sha256'].get(name) == digest == sha(root/name),\n                'retained N01 layout artifact changed')\n    return carry['artifact_sha256']\n\n\ndef origins(root, selection, candidate):\n    require(selection['schema'] == 'airs-desktop/p11-native-selection/1'\n            and selection['native_inventory_sha256'] == sha(inventory_root(root)/'docs/architecture/native-checks.json'),\n            'native selection scope differs')\n    prepare = read(bound(root, selection['prepare']))\n    require(prepare['executable_sha256'] == candidate['executable_sha256']\n            and prepare['bundle_sha256'] == candidate['bundle_sha256'], 'native candidate differs')\n    context = read(bound(root, selection['source_context']))\n    require(all(context[key] == candidate[key] for key in\n                ('executable_sha256', 'bundle_sha256', 'build_flags', 'conditions')),\n            'completed native assertion conditions changed')\n    require(len(selection['origins']) >= 2, 'native continuation needs its actual contributing runs')\n    selected, prior_refs = {}, []\n    for i, origin in enumerate(selection['origins']):\n        path = bound(root, origin['observations'])\n        raw = read(path)\n        final = i == len(selection['origins'])-1\n        all_rows = {row['id']: row for row in raw['checks']}\n        rows = positive_rows(raw)\n        ids = sorted(rows)\n        require(len(all_rows) == len(raw['checks']) and origin['ids'] == ids\n                and origin.get('excluded_checks', []) == excluded_checks(raw)\n                and set(ids) <= set(inventory(root))-set(selected)\n                and origin['disposition'] == ('executed' if final else 'reused_exact'),\n                'native origin membership or disposition differs')\n        if i == 0: require(ids == ['C46-N01'], 'initial completed setup scope differs')\n        driver = Path(raw['argv'][1]).name\n        require(raw['schema'] == 'airs-desktop/p11-native-observations/1' and raw['subject'] == 'P11'\n                and raw['execution_id'] == path.parent.name and raw['performed_by']\n                and len(raw['argv']) >= 2 and Path(raw['argv'][0]).name.lower() in ('python3', 'python')\n                and raw['argv'][1] in [\n                    'tools/native-acceptance/acceptance_p11.py',\n                    'tools/native-acceptance/acceptance_p11_resume.py',\n                    'tools/native-acceptance/acceptance_p11_continue.py',\n                    'tools/native-acceptance/acceptance_p11_finish.py', 'tools/native-acceptance/acceptance_p11_last.py',\n                    'tools/native-acceptance/acceptance_p11_verify.py', 'tools/native-acceptance/acceptance_p11_warn.py']\n                and (i != 0 or driver == 'acceptance_p11.py'),\n                'native origin execution identity differs')\n        require(raw['executable_sha256'] == candidate['executable_sha256']\n                and raw['bundle_sha256'] == candidate['bundle_sha256']\n                and raw['host'] == candidate['conditions']['platform'],\n                'native origin artifact/platform changed')\n        require(raw['binding']['prepare']['sha256'] == selection['prepare']['sha256']\n                and raw['binding']['native_inventory_sha256'] == selection['native_inventory_sha256']\n                and raw['binding']['helper_closure'] == raw['helper_closure'],\n                'native origin aliases differ')\n        require(time.strptime(raw['finished_utc'], '%Y-%m-%dT%H:%M:%SZ')\n                >= time.strptime(raw['started_utc'], '%Y-%m-%dT%H:%M:%SZ'), 'native origin time invalid')\n        if not final:\n            require(raw['complete'] is False and raw['status'] == 'failed' and raw['exit_code'] == 1\n                    and raw['errors'], 'original failed process provenance was relabelled')\n        else:\n            require(raw['complete'] is True and raw['status'] == 'observed' and raw['exit_code'] == 0\n                    and not raw['errors'] and set(ids) == set(inventory(root))-set(selected),\n                    'remaining native execution did not complete')\n        if i == 0:\n            require(raw['helper_closure'] == context['helper_closure'],\n                    'completed run differs from bound S2 helper context')\n            paths = c46_helpers(root)\n        else:\n            admission = raw['continuation']\n            admitted_origins = admission.get('origins', [admission['observations']])\n            require(raw['binding']['conditions'] == candidate['conditions']\n                    and admitted_origins == prior_refs\n                    and admission['observations'] == prior_refs[-1]\n                    and sorted(admission['completed_ids']) == sorted(selected)\n                    and sorted(admission['remaining_ids']) == sorted(set(inventory(root))-set(selected))\n                    and admission['fixture_state_semantically_equal'] is True\n                    and admission['certificate_generation_or_install_executed'] is False,\n                    'native continuation admission/provenance differs')\n            admission_path = path.parent/'resume-preconditions.json'\n            require(raw['artifact_sha256'].get(str(admission_path.relative_to(root))) == sha(admission_path)\n                    and read(admission_path) == admission, 'recorded admission proof differs')\n            # All 07 driver files remain unchanged; no scope is silently dropped.\n            paths = sorted(raw['helper_closure'])\n        require(origin['helper_paths'] == paths and all(\n            raw['helper_closure'].get(name) == candidate['helper_closure'].get(name)\n            for name in paths), 'relevant native helper changed')\n        if final:\n            require(raw['helper_closure'] == candidate['helper_closure'], 'current native driver closure differs')\n        for artifact, digest in raw['artifact_sha256'].items():\n            file = (root/artifact).resolve()\n            require(file.is_relative_to(path.parent) and sha(file) == digest, 'native origin artifact changed')\n        combined_artifacts = dict(raw['artifact_sha256'])\n        combined_artifacts.update(artifact_carry(root, raw, candidate, prior_refs))\n        for check_id, row in rows.items():\n            require(row['facts'] and all(value is True for value in row['facts'].values()),\n                    'native assertion has incomplete or failed facts')\n            for name in row['evidence']+row['visual']:\n                require(name in combined_artifacts and sha(root/name) == combined_artifacts[name],\n                        'native row evidence was not captured by its contributing run')\n            selected[check_id] = dict(raw_path=path, raw=raw, row=row,\n                                     helper_paths=paths, disposition=origin['disposition'])\n        prior_refs.append(origin['observations'])\n    return selected\n\n\ndef review_captures(root, selection, candidate, selected):\n    review = read(bound(root, selection['visual_review']))\n    require(review['schema'] == 'airs-desktop/p11-visual-review/2'\n            and review['observations'] == [origin['observations'] for origin in selection['origins']]\n            and review['executable_sha256'] == candidate['executable_sha256']\n            and review['bundle_sha256'] == candidate['bundle_sha256'] and review['performed_by'],\n            'capture review does not bind both actual origins/candidate')\n    wanted = {(image, cid) for cid, item in selected.items() for image in item['row']['visual']}\n    images = {(row['path'], row['assertion']): row for row in review['captures']}\n    require(len(images) == len(review['captures']) and set(images) == wanted,\n            'capture-specific review membership differs')\n    for (name, _), row in images.items():\n        require(row['sha256'] == sha(root/name) and row['accepted'] is True and not row['findings'],\n                'capture review failed or image changed')\n\ndef validate(root, acceptance_path, execution_path, candidate):\n    \"\"\"Per-row process outcome remains distinct from the completed assertion.\"\"\"\n    selection = read(execution_path)\n    selected = origins(root, selection, candidate)\n    review_captures(root, selection, candidate, selected)\n    acceptance = read(acceptance_path)\n    require(acceptance['schema'] == 'airs-v2/native-acceptance/1' and acceptance['subject'] == 'P11'\n            and acceptance['method'] == 'cua' and acceptance['app']['fixture'] is True\n            and acceptance['app']['executable_sha256'] == candidate['executable_sha256'],\n            'final native acceptance candidate differs')\n    checks = {row['id']: row for row in acceptance['checks']}\n    require(len(checks) == len(acceptance['checks']) and set(checks) == set(selected),\n            'final native check membership differs')\n    for cid, item in selected.items():\n        row = checks[cid]\n        evidence = set(item['row']['evidence']+item['row']['visual']+\n            [str(item['raw_path'].relative_to(root)), str(execution_path.relative_to(root)),\n             selection['visual_review']['path']])\n        require(row['result'] == 'pass' and row['observation'] and evidence <= set(row['evidence']),\n                'final native row lost its actual origin/evidence')\n    return selected\n\n\ndef finalize(args):\n    root = Path.cwd().resolve()\n    previous, continuation = [path.resolve() for path in args.previous], args.continuation.resolve()\n    last = read(continuation)\n    prepare = Path(last['binding']['prepare']['path']).resolve()\n    prepared = read(prepare)\n    candidate = dict(executable_sha256=prepared['executable_sha256'],\n        bundle_sha256=prepared['bundle_sha256'],\n        helper_closure=helper_closure(root, Path(last['argv'][1]).stem),\n        build_flags={'target': prepared['target'], 'features': prepared['features']},\n        conditions=last['binding']['conditions'])\n    selection = dict(schema='airs-desktop/p11-native-selection/1',\n        prepare=reference(root, prepare), source_context=reference(root, args.source_context),\n        native_inventory_sha256=sha(inventory_root(root)/'docs/architecture/native-checks.json'),\n        visual_review=reference(root, args.visual_review), origins=[\n            dict(observations=reference(root, path), ids=sorted(positive_rows(read(path))), excluded_checks=excluded_checks(read(path)),\n                 disposition='reused_exact' if i < len(previous) else 'executed',\n                 helper_paths=c46_helpers(root) if i == 0 else sorted(read(path)['helper_closure']))\n            for i, path in enumerate([*previous, continuation])])\n    selected = origins(root, selection, candidate)\n    review_captures(root, selection, candidate, selected)\n    out = args.out.resolve()\n    require(out.is_relative_to(root) and not out.exists(), 'preserve existing native finalization')\n    out.mkdir(parents=True)\n    selection_path, acceptance_path = out/'native-selection.json', out/'native-acceptance.json'\n    selection_path.write_text(json.dumps(selection, indent=2)+'\\n')\n    checks = []\n    for cid, description in inventory(root).items():\n        item = selected[cid]\n        checks.append(dict(id=cid, description=description, result='pass',\n            observation='Completed measured assertion '+cid+' from '+item['raw']['execution_id']+\n                '; contributing process exit '+str(item['raw']['exit_code'])+\n                ' remains recorded. Capture-specific visual review is separately bound. '\n                'Source boundaries require the separate qualification; no source suite is relabelled.',\n            evidence=[str(selection_path.relative_to(root)), str(item['raw_path'].relative_to(root)),\n                      selection['visual_review']['path'], *item['row']['evidence'], *item['row']['visual']]))\n    acceptance_path.write_text(json.dumps(dict(schema='airs-v2/native-acceptance/1', subject='P11',\n        recorded_utc=time.strftime('%Y-%m-%dT%H:%M:%SZ', time.gmtime()), method='cua',\n        performed_by=last['performed_by'], host=last['host'],\n        app={'bundle': prepared['bundle'], 'identifier': prepared['identifier'],\n             'executable_sha256': prepared['executable_sha256'], 'fixture': True},\n        checks=checks, limitations=[\n            'Synthetic VM fixture only; no stable/live or Linux acceptance.',\n            'C46-N01 completed in an overall failed earlier process. Its failure is preserved.',\n            'This is per-assertion evidence accounting, not a passing composite process.']),\n        indent=2)+'\\n')\n    validate(root, acceptance_path, selection_path, candidate)\n    return 0\n\n\nif __name__ == '__main__':\n    parser = argparse.ArgumentParser(description=__doc__)\n    parser.add_argument('action', choices=['finalize'])\n    parser.add_argument('--previous', type=Path, nargs='+', required=True)\n    for name in ('continuation', 'visual-review', 'source-context', 'out'):\n        parser.add_argument('--'+name, type=Path, required=True)\n    raise SystemExit(finalize(parser.parse_args()))\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_33","type":"command_execution","command":"/bin/zsh -lc \"sed -n '1,210p' tools/native-acceptance/acceptance_p11_shell.py; sed -n '1,150p' tools/native-acceptance/acceptance_p11_settings.py; sed -n '1,110p' tools/native-acceptance/acceptance_p11_setup.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_33","type":"command_execution","command":"/bin/zsh -lc \"sed -n '1,210p' tools/native-acceptance/acceptance_p11_shell.py; sed -n '1,150p' tools/native-acceptance/acceptance_p11_settings.py; sed -n '1,110p' tools/native-acceptance/acceptance_p11_setup.py\"","aggregated_output":"\"\"\"P11 shell native observations; exact fixture process and keyboard only.\"\"\"\nimport time\nimport acceptance_c29 as c29\nimport acceptance_c41 as c41\nimport acceptance_p11_setup as setup\n\nSOURCE_REQUIREMENTS = {\n    'frontend': ['src/v2/shell-refinement.test.tsx', 'src/v2/v2-shell.test.tsx', 'src/v2/modal.test.tsx', 'src/v2/home.test.tsx', 'src/v2/inbox/inbox.test.tsx', 'src/v2/admin/administration.test.tsx', 'src/v2/harness/harness.test.tsx', 'src/v2/academy/academy.test.tsx', 'src/v2/workbench/workbench.test.tsx', 'src/modules/sessions/sessions-view.test.tsx'],\n    'rust': [],\n}\n\nPAGES = ('Home', 'Inbox', 'Test Cases', 'API Client', 'Administration', 'Settings', 'Harness', 'Academy')\nACTIONS = {'Home': ('Refresh',), 'Inbox': ('Refresh',), 'Test Cases': ('Load packs', 'New case'),\n           'API Client': ('URL', 'Send'), 'Administration': ('Expand all', 'Collapse all'),\n           'Settings': ('Appearance', 'Theme'), 'Harness': ('New investigation',), 'Academy': ('Learn', 'Open Runtime')}\n\n\ndef title(tree, label):\n    return [n for n in tree if n.get('role') == 'AXHeading' and n.get('label') == label and n.get('value') == 1]\n\n\ndef main_region(tree):\n    return next((n for n in tree if n.get('subrole') == 'AXLandmarkMain'), None)\n\n\ndef focus_visible(ctx, label):\n    ctx.app.ax('focus', 'AXHeading', label)\n    for _ in range(24):\n        ctx.app.keycode(48)\n        tree = ctx.app.tree()\n        focused = ctx.app.focused(tree)\n        if focused and any((focused.get('label') or '').startswith(name) for name in ACTIONS[label]):\n            return c29.inside(ctx.frame(), focused), focused\n    return False, ctx.app.focused(ctx.app.tree())\n\n\ndef size_window(ctx, width, height):\n    # Preserve C41's viewport-height adjustment, using the candidate-owned\n    # AX window instead of System Events' sometimes-empty window list.\n    requested = [width, height+c41.TITLE_BAR]\n    for _ in range(3):\n        ctx.resize(*requested, position=(0, 0))\n        time.sleep(.8)\n        measured = c41.geometry(ctx.app.tree())\n        viewport = measured['viewport'] or measured['web']\n        if not viewport or viewport[1] == height:\n            break\n        requested[1] += height-viewport[1]\n    return ctx.frame()\n\n\ndef run(ctx):\n    setup.switch(ctx, ctx.state['bootstrap_tenant'])\n    layouts, artifacts, pictures = [], [], []\n    ctx.navigate('Inbox')  # ensure the first Home entry is an actual navigation\n    # One paired matrix: ordinary light and narrow/effective200% dark on\n    # every changed destination. C49 independently exercises all4palettes.\n    for theme, width, height, zoom in (('Light', 1440, 820, 0), ('Dark', 900, 600, 10)):\n        ctx.app.menu('View', 'Actual Size')\n        ctx.app.front()\n        size_window(ctx, width, height)\n        c29.appearance(ctx.app, theme)\n        if zoom:\n            c29.zoom(ctx.app, zoom)\n        for page in PAGES:\n            tree = ctx.navigate(page)\n            tree, focused = ctx.app.wait_for(lambda t: bool((ctx.app.focused(t) or {}).get('label') == page), 8)\n            headers = title(tree, page)\n            main = main_region(tree)\n            reachable, control = focus_visible(ctx, page)\n            current = ctx.app.tree()\n            name = 'shell-'+page.lower().replace(' ', '-')+'-'+theme.lower()+'-'+('200' if zoom else '100')\n            artifacts.append(ctx.save(name, current))\n            pictures.append(ctx.capture(name))\n            layouts.append({'page': page, 'theme': theme, 'zoom': 200 if zoom else 100,\n                            'requested': [width, height], 'geometry': c41.geometry(current),\n                            'one_named_header_h1': len(headers) == 1, 'navigation_focus': focused,\n                            'main': main, 'main_inside_window': c29.inside(ctx.frame(), main),\n                            'named_action_keyboard_visible': reachable, 'focused_action': control,\n                            'academy_location': page != 'Academy' or ctx.app.has_text(current, 'Academy location')})\n    matrix = ctx.save('shell-layout-measurements', layouts)\n    ctx.record('C47-N01', {'all_destinations_have_one_named_header_h1': all(r['one_named_header_h1'] for r in layouts),\n                          'navigation_focus_observed': all(r['navigation_focus'] for r in layouts),\n                          'main_frames_measured_inside_window': all(r['main_inside_window'] for r in layouts),\n                          'named_actions_keyboard_reachable': all(r['named_action_keyboard_visible'] for r in layouts),\n                          'academy_hierarchy_retained': all(r['academy_location'] for r in layouts)}, [matrix, *artifacts], pictures)\n    ctx.app.menu('View', 'Actual Size')\n    ctx.resize(1440, 900)\n    ctx.navigate('Home')\n    before = main_region(ctx.app.tree())\n    ctx.press_any('Show the calls')\n    ctx.text('The calls')\n    opened = ctx.app.tree()\n    after = main_region(opened)\n    same_width = bool(before and after and abs(before['size'][0]-after['size'][0]) <= 1)\n    drawer_capture = ctx.capture('explain-overlay')\n    ctx.press('AXButton', 'Refresh')\n    control_live = ctx.app.node(ctx.app.tree(), 'AXButton', 'Close Explain') is not None\n    ctx.navigate('Inbox')\n    navigation_live = ctx.app.node(ctx.app.tree(), 'AXButton', 'Close Explain') is not None\n    # Escape on the page belongs to the page, not the nonmodal drawer.\n    ctx.app.ax('focus', 'AXHeading', 'Inbox')\n    ctx.app.keycode(53)\n    page_escape_kept = ctx.app.node(ctx.app.tree(), 'AXButton', 'Close Explain') is not None\n    ctx.press('AXButton', 'Search or go to')\n    ctx.text('Command palette')\n    ctx.app.keycode(53)\n    modal_priority = ctx.app.node(ctx.app.tree(), 'AXButton', 'Close Explain') is not None\n    ctx.app.ax('focus', 'AXButton', 'Close Explain')\n    ctx.app.keycode(53)\n    tree, closed = ctx.app.wait_for(lambda t: ctx.app.node(t, 'AXButton', 'Close Explain') is None, 8)\n    focus_back = (ctx.app.focused(tree) or {}).get('label') == 'Show the calls'\n    ctx.press_any('Show the calls')\n    ctx.press('AXButton', 'Close Explain')\n    tree, close_button = ctx.app.wait_for(lambda t: ctx.app.node(t, 'AXButton', 'Close Explain') is None, 8)\n    ctx.press_any('Show the calls')\n    setup.switch(ctx, ctx.state['spare_tenant'])\n    tree = ctx.app.tree()\n    tree, tenant_closed = ctx.app.wait_for(lambda t: ctx.app.node(t, 'AXButton', 'Close Explain') is None, 8)\n    setup.switch(ctx, ctx.state['bootstrap_tenant'])\n    retired = ctx.app.node(ctx.app.tree(), 'AXButton', 'Close Explain') is None\n    evidence = ctx.save('explain-native-observations', {'before_main': before, 'after_main': after, 'final_tree': ctx.app.tree()})\n    ctx.record('C47-N02', {'overlay_did_not_change_main_width': same_width, 'page_refresh_remained_usable': control_live,\n                          'navigation_remained_usable': navigation_live, 'page_escape_did_not_close_drawer': page_escape_kept,\n                          'modal_escape_preserved_drawer': modal_priority, 'drawer_escape_closed': closed,\n                          'focus_returned_to_explain': focus_back, 'close_button_worked': close_button,\n                          'tenant_change_closed_and_retired_drawer': tenant_closed and retired}, [evidence], [drawer_capture])\n    theme_images = []\n    no_ask, sidebar, next_action = [], [], []\n    for appearance, expected in (('Dark', 'light'), ('Light', 'dark')):\n        c29.appearance(ctx.app, appearance)\n        tree = ctx.navigate('Home')\n        no_ask.append(not any(n.get('role') == 'AXButton' and n.get('label') == 'Ask Harness' for n in tree))\n        sidebar.append(ctx.app.node(tree, 'AXButton', 'Harness') is not None)\n        switch = ctx.app.node(tree, 'AXCheckBox', 'Switch light or dark appearance')\n        ctx.require(switch, 'appearance switch absent')\n        if switch:\n            ctx.app.ax('focus', 'AXCheckBox', 'Switch light or dark appearance')\n        theme_images.append(ctx.capture('shell-sun-'+appearance.lower()))\n        ctx.press_any('Switch light or dark appearance')\n        ctx.wait_state(lambda value: value['appearance'] == expected, 'appearance next action did not persist')\n        next_action.append(True)\n    ctx.record('C47-N03', {'redundant_ask_harness_absent': all(no_ask), 'sidebar_harness_retained': all(sidebar), 'labelled_next_action_worked': all(next_action),\n                          'appearance_control_present': all(ctx.app.node(ctx.app.tree(), role, 'Switch light or dark appearance') is not None for role in ('AXCheckBox',))},\n               [ctx.save('shell-sun-labels', {'next_action_labels': next_action, 'tree': ctx.app.tree()})], theme_images)\n    c29.appearance(ctx.app, 'Match System')\n    ctx.navigate('Home')\n\"\"\"C49 affected native observations; invoked only by acceptance_p11.run.\n\nAll input belongs to the orchestrator's fixture. Captures require independent\nvisual review. Native observations do not prove before-await secret clearing,\nidentity authority, rollback, contrast ratios, or earned-skin authorization;\nthe finalizer must also bind the named production-interface regressions.\nThis module has no standalone execution path and never reads a real vault.\n\"\"\"\n\nimport time\n\n\nSOURCE_REQUIREMENTS = {\n    \"frontend\": [\n        \"src/v2/settings/refinement-settings.test.tsx\",\n        \"src/modules/tenants/credential-entry.test.tsx\",\n        \"src/v2/settings/management-credential.test.tsx\",\n        \"src/shell/appearance.test.ts\",\n        \"src/shell/palette-contrast.test.ts\",\n        \"src/v2/academy/academy.test.tsx\",\n    ],\n    \"rust\": [\"refinement_metadata\", \"color_theme\", \"ui_v2_setup_reads\", \"ui_v2_onboarding\"],\n    \"not_claimed_by_native\": [\n        \"secret clearing occurs before awaiting dispatch\",\n        \"stale context and cross-profile authority are rejected\",\n        \"failed persistence and cancellation roll back safely\",\n        \"measured palette contrast and Academy earned-skin authority\",\n    ],\n}\n\n\ndef _node(ctx, role, label, tree=None, nth=0):\n    node = ctx.app.node(ctx.app.tree() if tree is None else tree, role, label, nth)\n    ctx.require(node is not None, f\"C49 missing {role} {label}\")\n    return node\n\n\ndef _value(ctx, role, label, nth=0):\n    return str(_node(ctx, role, label, nth=nth).get(\"value\") or \"\")\n\n\ndef _select(ctx, label, options, selected):\n    \"\"\"Choose a native HTML select with real keys, then verify the AX value.\"\"\"\n    ctx.require(selected in options, \"unknown C49 select option\")\n    _node(ctx, \"AXPopUpButton\", label)\n    ctx.app.ax(\"focus\", \"AXPopUpButton\", label)\n    ctx.app.keycode(49)  # Space opens the focused select's native menu.\n    ctx.app.keycode(115)  # Home, followed by the declared option index.\n    for _ in range(options.index(selected)):\n        ctx.app.keycode(125)\n    ctx.app.keycode(36)\n    tree, ready = ctx.app.wait_for(\n        lambda t: str((ctx.app.node(t, \"AXPopUpButton\", label) or {}).get(\"value\") or \"\") == selected\n    )\n    ctx.require(ready, f\"C49 {label} did not select {selected}\")\n    return tree\n\n\ndef _replace_text(ctx, label, value):\n    ctx.app.ax(\"focus\", \"AXTextField\", label)\n    ctx.app.keys(\"a\", \"command down\")\n    ctx.app.keycode(51)\n    ctx.app.type_into(\"AXTextField\", label, value)\n\n\ndef _radio(ctx, label, nth=0):\n    node = _node(ctx, \"AXRadioButton\", label, nth=nth)\n    ctx.require(node.get(\"enabled\") is not False, f\"disabled radio {label}\")\n    ctx.app.ax(\"press\", \"AXRadioButton\", label, nth)\n    tree, selected = ctx.app.wait_for(\n        lambda t: (ctx.app.node(t, \"AXRadioButton\", label, nth) or {}).get(\"value\") in (1, \"1\")\n    )\n    ctx.require(selected, f\"radio not selected: {label}\")\n    return tree\n\n\ndef _resize(ctx, width, height):\n    ctx.resize(width, height)\n    time.sleep(.6)\n\n\ndef _zoom(ctx, doubled=False):\n    ctx.app.menu(\"View\", \"Actual Size\")\n    if doubled:\n        # Host::zoom increments by 0.1 from reset 1.0; ten steps request 2.0.\n        for _ in range(10):\n            ctx.app.menu(\"View\", \"Zoom In\")\n\n\ndef _inside(window, control):\n    if not all(n.get(\"pos\") and n.get(\"size\") for n in (window, control)):\n        return False\n    x, y = window[\"pos\"]\n    w, h = window[\"size\"]\n    px, py = control[\"pos\"]\n    pw, ph = control[\"size\"]\n    return pw > 0 and ph > 0 and x - 2 <= px and y - 2 <= py and px + pw <= x + w + 2 and py + ph <= y + h + 2\n\n\ndef _keyboard_cards(ctx):\n    wanted = {\"Theme\", \"AIRS API key\", \"Client ID\", \"Client secret\", \"Save key\",\n              \"Change destination…\", \"Tenant to update\", \"Edit\", \"Delete\", \"Add tenant…\"}\n    reached, trace = set(), []\n    ctx.app.ax(\"focus\", \"AXPopUpButton\", \"Appearance\")\n    for _ in range(70):\n        ctx.app.keycode(48)\n        tree = ctx.app.tree()\n        focused = ctx.app.focused(tree)\n        window = ctx.app.node(tree, \"AXWindow\", \"\") or {}\n        if focused:\n            label = focused.get(\"label\") or \"\"\n            matches = {label_ for label_ in wanted if label == label_ or label.startswith(label_ + \" \")}\n            visible = _inside(window, focused)\n            trace.append({\"role\": focused.get(\"role\"), \"label\": label, \"inside_window\": visible,\n                          \"pos\": focused.get(\"pos\"), \"size\": focused.get(\"size\")})\n            if visible:\n                reached.update(matches)\n        if reached == wanted:\n            break\n    evidence = ctx.save(\"c49-keyboard-200-percent\", {\"requested_zoom\": 2.0, \"wanted\": sorted(wanted),\n        \"reached\": sorted(reached), \"trace\": trace, \"meaning\": \"AX geometry and keyboard reach; pixels require review\"})\n    ctx.require(reached == wanted, f\"C49 unreachable controls at narrow/200%: {sorted(wanted - reached)}\")\n    return evidence, reached == wanted\n\n\ndef _settings(ctx):\n    return ctx.navigate(\"Settings\")\n\n\ndef _academy_reader(ctx):\n    \"\"\"From the current synthetic catalog, through guest learner links only.\"\"\"\n    ctx.press(\"AXCheckBox\", \"Courses\")\n    ctx.press(\"AXLink\", \"COURSE Runtime Security Foundations\")\n    ctx.text(\"Runtime Security Foundations\")\n    ctx.press(\"AXLink\", \"Scanning at runtime: part 1\")\n    return ctx.text(\"Lesson 1 of Scanning at runtime opens here\")\n\n\ndef _themes(ctx, original_appearance, original_theme):\n    evidence, captures = [], []\n    options = [\"Match system\", \"Light\", \"Dark\"]\n    for theme in (\"Prisma AIRS\", \"Gruvbox\"):\n        for appearance in (\"Light\", \"Dark\"):\n            _settings(ctx)\n            _select(ctx, \"Appearance\", options, appearance)\n            tree = _select(ctx, \"Theme\", [\"Prisma AIRS\", \"Gruvbox\"], theme)\n            name = f\"c49-{theme.lower().replace(' ', '-')}-{appearance.lower()}\"\n            evidence.append(ctx.save(name, tree))\n            captures.append(ctx.capture(name))\n    # The alternate theme and explicit appearance must survive a real restart.\n\"\"\"P11 required-OAuth setup and warning flows. Called only by the owned driver.\"\"\"\nfrom pathlib import Path\nimport time\nimport acceptance_c08 as c8\nimport fixture_app as fx\n\nSOURCE_REQUIREMENTS = {\n    'frontend': ['src/v2/inbox/setup-warning.test.tsx', 'src/contracts/setup-warning-contract.test.ts', 'src/v2/settings/setup-warning-history.test.tsx'],\n    'rust': ['setup_warning_recheck', 'ui_v2_setup_reads', 'ui_v2_onboarding', 'context_retirement_prunes_checks_without_waiting_for_a_management_reply', 'models_scope_bindings_and_inference_keys'],\n}\n\n\ndef enabled(app, label):\n    node = app.node(app.tree(), 'AXButton', label)\n    return bool(node and node.get('enabled') is not False)\n\n\ndef _visible_identity_fields(ctx, tree):\n    window = ctx.app.node(tree, 'AXWindow', '')\n    if not window or not window.get('pos') or not window.get('size'):\n        return False\n    x, y = window['pos']\n    width, height = window['size']\n    for label in ('Display name', 'TSG ID'):\n        field = ctx.app.node(tree, 'AXTextField', label)\n        if (not field or not str(field.get('label') or '').startswith(label) or field.get('enabled') is False\n                or not field.get('pos') or not field.get('size')):\n            return False\n        px, py = field['pos']\n        pw, ph = field['size']\n        if not (pw > 0 and ph > 0 and x <= px and y <= py and px+pw <= x+width and py+ph <= y+height):\n            return False\n    return True\n\n\ndef _type_ready_identity(ctx, label, value, deadline, evidence):\n    # Activate only the candidate-owned process before any focus/input. A\n    # transient AX focus failure may be retried, never the text delivery.\n    ctx.app.front()\n    while time.monotonic() < deadline:\n        ctx.require(ctx.app.pid == ctx.app.running_pid(), 'owned fixture identity changed during draft readiness')\n        tree = ctx.app.tree()\n        if not _visible_identity_fields(ctx, tree):\n            time.sleep(.15)\n            continue\n        try:\n            ctx.app.ax('focus', 'AXTextField', label)\n        except RuntimeError as error:\n            if not str(error).startswith('ax focus '):\n                raise\n            ctx.log.append({'step': 'draft-focus-not-ready', 'field': label,\n                            'utc': time.strftime('%Y-%m-%dT%H:%M:%SZ', time.gmtime()), 'error': str(error)})\n            # The next iteration must obtain a fresh positive field tree.\n            continue\n        tree = ctx.app.tree()\n        focused = ctx.app.focused(tree) or {}\n        if not (_visible_identity_fields(ctx, tree) and focused.get('role') == 'AXTextField'\n                and str(focused.get('label') or '').startswith(label)):\n            time.sleep(.15)\n            continue\n        ctx.require(time.monotonic() < deadline, 'draft identity readiness exceeded15seconds before input')\n        ctx.require(str((ctx.app.node(tree, 'AXTextField', label) or {}).get('value') or '') == '',\n                    'new draft identity field is unexpectedly nonempty; refusing duplicate text')\n        sequence = ctx.state.setdefault('draft_readiness_sequence', 0)+1\n        ctx.state['draft_readiness_sequence'] = sequence\n        path = ctx.save(f'draft-identity-ready-{sequence}', tree)\n        evidence.append(path)\n        ctx.log.append({'step': 'draft-identity-ready', 'field': label, 'evidence': path,\n                        'utc': time.strftime('%Y-%m-%dT%H:%M:%SZ', time.gmtime())})\n        # No app.type_into call here: it would issue a second unchecked focus.\n        # keys() rechecks the owned/frontmost PID; text is sent exactly once.\n        ctx.app.keys(value)\n        tree, arrived = ctx.app.wait_for(lambda t: str((ctx.app.node(t, 'AXTextField', label) or {}).get('value') or '') == value,\n                                        max(.01, deadline-time.monotonic()))\n        ctx.require(arrived, 'draft identity text did not arrive exactly; no automatic input replay')\n        return\n    raise RuntimeError('draft identity fields/focus did not become ready within15seconds: '+label)\n\n\ndef draft(ctx, name):\n    ctx.heading('Connect your tenant')\n    deadline = time.monotonic()+15\n    evidence = ctx.state.setdefault('draft_readiness_evidence', [])\n    _type_ready_identity(ctx, 'Display name', name, deadline, evidence)\n    _type_ready_identity(ctx, 'TSG ID', c8.TSG, deadline, evidence)\n    ctx.press('AXButton', 'Draft tenant')\n    ctx.text(name+' is drafted. Add its management client below.')\n    return not enabled(ctx.app, 'Save the management client to continue')\n\n\ndef client(ctx):\n    ctx.app.type_into('AXTextField', 'Client ID', c8.CLIENT_ID)\n    ctx.app.type_into('AXTextField', 'Client secret', c8.SECRET, secure=True)\n    ctx.press('AXButton', 'Save management client')\n    ctx.text('Management client saved.')\n    ctx.require(ctx.app.node(ctx.app.tree(), 'AXButton', 'Replace management client'), 'management credential did not settle')\n\n\ndef verification(ctx, model=False):\n    ctx.press('AXButton', 'Continue')\n    ctx.heading('Which products will you manage?')\n    if model:\n        node = ctx.app.node(ctx.app.tree(), 'AXCheckBox', 'AI Supply Chain Security')\n        ctx.require(node, 'Supply Chain product choice absent')\n        if node.get('value') not in (True, 1, '1', 'true'):\n            ctx.press('AXCheckBox', 'AI Supply Chain Security')\n    ctx.press('AXButton', 'Continue')\n    ctx.heading('Check the connection')\n    ctx.press('AXButton', 'Run the checks')\n\n","exit_code":0,"status":"completed"}}
