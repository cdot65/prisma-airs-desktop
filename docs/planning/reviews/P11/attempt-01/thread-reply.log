: 'Management client secret saved in secure storage.',\n            }\n        case 'failed':\n            return { tone: 'danger', text: failure ? FAILURE_TEXT[failure] : 'The management client could not be saved.' }\n    }\n}\n\ninterface Props {\n    tenant: TenantView\n    context: ContextRef\n    dispatch: Dispatch\n    observe: ObserveManagement\n}\n\n/**\n * The tenant's separate management OAuth client (C08). It never replaces or\n * reads the scan key. The secret is read from its field at submission and\n * the field is cleared before the request is awaited; it is never held in\n * React state, storage or any snapshot. Verify authenticates the stored OAuth client without reading product inventories.\n */\nexport function ManagementCredentialForm({ tenant, context, dispatch, observe }: Props) {\n    const [mode, setMode] = useState<StorageMode>('keychain')\n    const [message, setMessage] = useState<string | null>(null)\n    const [verified, setVerified] = useState<string | null>(null)\n    const [busy, setBusy] = useState(false)\n    const secretRef = useRef<HTMLInputElement>(null)\n    const clientRef = useRef<HTMLInputElement>(null)\n    const ids = useId()\n    const shown = status(tenant)\n    const view = tenant.management\n    const hasClient = view.state === 'ready' || view.state === 'failed'\n    const noTsg = tenant.tsgId === null\n\n    async function submit(event: FormEvent<HTMLFormElement>) {\n        event.preventDefault()\n        const secretField = secretRef.current\n        const clientField = clientRef.current\n        if (!secretField || !clientField) return\n        const secret = secretField.value\n        secretField.value = ''\n        const clientId = clientField.value.trim()\n        setVerified(null)\n        if (clientId.length === 0) {\n            setMessage('Enter the client ID.')\n            clientField.focus()\n            return\n        }\n        if (secret.length === 0) {\n            setMessage('Enter the client secret.')\n            secretField.focus()\n            return\n        }\n        setBusy(true)\n        setMessage(null)\n        const outcome = await dispatch({ kind: 'configureManagementCredential', context, mode, clientId, secret })\n        setBusy(false)\n        setMessage(outcomeMessage(outcome))\n    }\n\n    async function verify() {\n        setBusy(true)\n        setMessage(null)\n        setVerified(null)\n        const outcome = await readManagement(dispatch, observe, context, { kind: 'verify' })\n        setBusy(false)\n        if (outcome.kind === 'notAdmitted') setMessage(outcome.message)\n        else if (outcome.result.kind === 'verified') setVerified('Management OAuth authentication succeeded.')\n        else if (outcome.result.kind === 'failed') setMessage(MANAGEMENT_FAILURE_TEXT[outcome.result.failure])\n        else setMessage('The service returned a reply the desktop could not use.')\n    }\n\n    async function remove() {\n        setBusy(true)\n        setMessage(null)\n        setVerified(null)\n        const outcome = await dispatch({ kind: 'removeManagementCredential', context })\n        setBusy(false)\n        setMessage(outcomeMessage(outcome))\n    }\n\n    return (\n        <section aria-labelledby={`${ids}-heading`} data-slot='management-credential' className='settings-card'>\n            <h3 id={`${ids}-heading`} className='text-academy-ink text-[14px] font-semibold'>\n                Management client\n            </h3>\n            <Callout\n                tone={shown.tone}\nimport { type FormEvent, useId, useRef, useState } from 'react'\nimport { Button, Callout, Input } from '@ai-security-academy/presentation'\nimport { AlertTriangle, CheckCircle2, Info } from 'lucide-react'\nimport type { ContextRef, StorageMode, TenantView, VaultError } from '@prisma-airs/desktop-contracts'\nimport { type Dispatch, outcomeMessage } from './dispatch'\n\nconst FAILURE_TEXT: Record<VaultError, string> = {\n    locked: 'Secure storage is locked. Unlock it and enter the key again, or keep it for this session only.',\n    denied: 'The system did not allow access to secure storage. Enter the key again, or keep it for this session only.',\n    unavailable: 'The credential store is not available. Enter the key again, or keep it for this session only.',\n    notFound: 'The stored key is missing. Enter it again.',\n    corrupt: 'The stored key could not be read. Enter it again.',\n}\n\nfunction scanStatus(tenant: TenantView): { tone: 'default' | 'success' | 'danger'; text: string } {\n    const { state, mode, failure } = tenant.scan\n    switch (state) {\n        case 'missing':\n            return { tone: 'default', text: 'No scan key. Enter this tenant’s AIRS API key to enable scans.' }\n        case 'storing':\n            return { tone: 'default', text: 'Saving the scan key…' }\n        case 'ready':\n            return {\n                tone: 'success',\n                text: mode === 'session' ? 'Scan key held for this session only.' : 'Scan key saved in secure storage.',\n            }\n        case 'failed':\n            return { tone: 'danger', text: failure ? FAILURE_TEXT[failure] : 'The scan key could not be saved.' }\n    }\n}\n\ninterface Props {\n    tenant: TenantView\n    context: ContextRef\n    dispatch: Dispatch\n}\n\n/**\n * Scan-key entry for the active tenant. The key is read from the field at\n * the moment of submission and the field is cleared before the request is\n * awaited; it is never held in React state, storage or any snapshot. (A\n * JavaScript string cannot be reliably zeroized; the native side keeps it.)\n */\nexport function ScanKeyForm({ tenant, context, dispatch }: Props) {\n    const [mode, setMode] = useState<StorageMode>('keychain')\n    const [message, setMessage] = useState<string | null>(null)\n    const [busy, setBusy] = useState(false)\n    const keyRef = useRef<HTMLInputElement>(null)\n    const keyId = useId()\n    const hintId = useId()\n    const modeLegend = useId()\n    const status = scanStatus(tenant)\n    const hasKey = tenant.scan.state === 'ready' || tenant.scan.state === 'failed'\n\n    async function submit(event: FormEvent<HTMLFormElement>) {\n        event.preventDefault()\n        const field = keyRef.current\n        if (!field) return\n        const key = field.value\n        field.value = ''\n        if (key.length === 0) {\n            setMessage('Enter the scan key.')\n            field.focus()\n            return\n        }\n        setBusy(true)\n        setMessage(null)\n        const outcome = await dispatch({ kind: 'configureScanCredential', context, mode, key })\n        setBusy(false)\n        setMessage(outcomeMessage(outcome))\n    }\n\n    async function remove() {\n        setBusy(true)\n        setMessage(null)\n        const outcome = await dispatch({ kind: 'removeScanCredential', context })\n        setBusy(false)\n        setMessage(outcomeMessage(outcome))\n    }\n\n    return (\n        <section aria-labelledby={`${keyId}-heading`} data-slot='scan-key' className='settings-card'>\n            <h3 id={`${keyId}-heading`} className='text-academy-ink text-[14px] font-semibold'>\n                Scan key\n            </h3>\n            <Callout\n                tone={status.tone}\n                icon={status.tone === 'success' ? CheckCircle2 : status.tone === 'danger' ? AlertTriangle : Info}\n                role='status'\n                aria-live='polite'\n                data-slot='scan-status'\n            >\n                {status.text}\n            </Callout>\n            <form onSubmit={(e) => void submit(e)} className='flex flex-col gap-3' aria-busy={busy}>\n                <label htmlFor={keyId} className='text-academy-ink text-[13px] font-medium'>\n                    AIRS API key\n                </label>\n                <Input\n                    ref={keyRef}\n                    id={keyId}\n                    name='scan-key'\n3667:        Intent::CompleteTenantSetup {\n3692:       