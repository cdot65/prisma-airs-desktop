{"type":"item.completed","item":{"id":"item_44","type":"command_execution","command":"/bin/zsh -lc \"sed -n '1,105p' tools/native-acceptance/acceptance_p11.py; sed -n '105,206p' tools/native-acceptance/acceptance_p11.py; rg -n '\"'^def |SOURCE_REQUIREMENTS'\"' tools/native-acceptance/acceptance_p11_api.py; sed -n '1,120p' tools/native-acceptance/acceptance_p11_keyboard.py; sed -n '1,90p' tools/native-acceptance/acceptance_p11_credentials.py\"","aggregated_output":"#!/usr/bin/env python3\n\"\"\"Affected P11 native flow, with immutable raw observations and separate visual review.\n\nExecute only against --prepare's exact fixture bundle. --finalize performs no UI:\nit binds measured facts, actual P11 test records, and capture-specific visual review.\nNo old scan-only setup helper, installed app lookup, or process-name signaling.\n\"\"\"\nimport argparse\nimport ast\nimport hashlib\nimport importlib.util\nimport json\nimport math\nimport os\nfrom pathlib import Path\nimport platform\nimport plistlib\nimport re\nimport sys\nimport tempfile\nimport time\nfrom typing import TYPE_CHECKING\n\n# Literal subprocess server inputs must join candidate.helper_closure's AST graph.\nif TYPE_CHECKING:\n    import mgmt_server, scan_server, academy_server, academy_catalog\n\nROOT = Path.cwd().resolve()\nTOOLS = Path(__file__).resolve().parent\nsys.path.insert(0, str(TOOLS))\nsys.path.insert(0, str(ROOT/'tools/p10'))\n_spec = importlib.util.spec_from_file_location('p11_candidate_bindings', ROOT/'tools/p10/candidate.py')\n_binding = importlib.util.module_from_spec(_spec)\n_spec.loader.exec_module(_binding)\n\n\ndef sha(path):\n    return hashlib.sha256(Path(path).read_bytes()).hexdigest()\n\n\ndef write_new(path, value):\n    path = Path(path)\n    with path.open('x') as stream:\n        json.dump(value, stream, indent=2)\n        stream.write('\\n')\n\n\ndef inventory():\n    chunks = json.loads((ROOT/'docs/architecture/native-checks.json').read_text())['chunks']\n    return {row['id']: row['check'] for chunk in ('C46', 'C47', 'C48', 'C49') for row in chunks[chunk]}\n\n\ndef verify_prepare(path):\n    prepared = json.loads(path.read_text())\n    bundle = (ROOT/prepared['bundle']).resolve(strict=True)\n    info = plistlib.loads((bundle/'Contents/Info.plist').read_bytes())\n    if prepared['identifier'] != 'io.cdot.airs-desktop.fixture' or info.get('CFBundleIdentifier') != prepared['identifier']:\n        raise RuntimeError('only the explicitly prepared fixture identity is allowed')\n    if info.get('CFBundleExecutable') != 'prisma-airs-desktop':\n        raise RuntimeError('unexpected fixture executable')\n    if sha(bundle/'Contents/MacOS/prisma-airs-desktop') != prepared['executable_sha256']:\n        raise RuntimeError('prepared executable drift')\n    if _binding.bundle_hash(bundle) != prepared['bundle_sha256']:\n        raise RuntimeError('complete prepared bundle drift')\n    return prepared, bundle\n\n\nclass Context:\n    def __init__(self, prepare, out):\n        self.prepare_path, self.out = prepare.resolve(), out.resolve()\n        self.prepared, self.bundle = verify_prepare(self.prepare_path)\n        self.out.mkdir(parents=True, exist_ok=False)\n        self.work = Path(tempfile.mkdtemp(prefix='airs-p11-owned-'))\n        self.log, self.rows, self.errors, self.artifacts = [], {}, [], {}\n        self.fixture_root_owned = False\n        self.argv = list(getattr(sys, \"orig_argv\", [sys.executable, *sys.argv]))\n        self.argv_source = \"sys.orig_argv\" if hasattr(sys, \"orig_argv\") else \"sys.executable + sys.argv (Python has no orig_argv)\"\n        self.state = {'bootstrap_tenant': 'P11 Northwind', 'spare_tenant': 'P11 Secondary', 'scan_absent': True}\n        self.closure = _binding.helper_closure(ROOT, 'acceptance_p11')\n        self.binding = {'prepare': {'path': str(self.prepare_path), 'sha256': sha(self.prepare_path)},\n                        'bundle': str(self.bundle), 'executable_sha256': self.prepared['executable_sha256'],\n                        'bundle_sha256': self.prepared['bundle_sha256'], 'helper_closure': self.closure,\n                        'native_inventory_sha256': sha(ROOT/'docs/architecture/native-checks.json')}\n        self.started = time.strftime('%Y-%m-%dT%H:%M:%SZ', time.gmtime())\n        self.execution_exit_code = 1\n        self.app = self.mgmt = self.scan = self.academy = None\n\n    @staticmethod\n    def require(condition, message):\n        if not condition:\n            raise RuntimeError(message)\n\n    def relative(self, path):\n        return str(Path(path).resolve().relative_to(ROOT))\n\n    def save(self, name, tree=None):\n        self.require(re.fullmatch(r'[A-Za-z0-9_.-]+', name), 'unsafe evidence name')\n        path = self.out/(name+'.json')\n        write_new(path, self.app.tree() if tree is None else tree)\n        relative = self.relative(path)\n        self.artifacts[relative] = sha(path)\n        return relative\n\n    def capture(self, name):\n        import acceptance_c29 as c29\n        import acceptance_c29 as c29\n        self.require(not (self.out/'captures'/(name+'.png')).exists(), 'capture already exists')\n        c29.NATIVE = str(self.out)\n        path = c29.capture(self.app, name)\n        self.require(path, 'fixture window did not produce a capture')\n        self.artifacts[path] = sha(ROOT/path)\n        return path\n\n    def frame(self):\n        # App.ax revalidates this prepared candidate's executable/PID before\n        # each request; Swift also checks the selected AXWindow's PID and role.\n        frame = json.loads(self.app.ax('frame'))\n        self.require(isinstance(frame, list) and len(frame) == 4 and\n                     all(type(n) in (int, float) and math.isfinite(n) for n in frame) and\n                     frame[2] > 0 and frame[3] > 0, 'owned window returned an invalid frame')\n        return frame\n\n    def resize(self, width, height, position=None):\n        values = [width, height] + ([] if position is None else list(position))\n        self.require(len(values) in (2, 4) and\n                     all(type(n) in (int, float) and math.isfinite(n) for n in values) and\n                     width > 0 and height > 0, 'invalid owned window resize request')\n        self.app.front()\n        self.app.ax('resize', *values)\n        deadline = time.monotonic() + 3\n        while True:\n            frame = self.frame()\n            sized = abs(frame[2]-width) <= 2 and abs(frame[3]-height) <= 2\n            # macOS may clamp the requested position below its menu bar.\n            # Retain measured placement; only size is the requested invariant.\n            if sized:\n                self.log.append({'action': 'owned-window-resize', 'pid': self.app.pid,\n                                 'requested': values, 'measured': frame,\n                                 'utc': time.strftime('%Y-%m-%dT%H:%M:%SZ', time.gmtime())})\n                return frame\n            self.require(time.monotonic() < deadline, f'owned window resize did not reach requested geometry: {values} != {frame}')\n            time.sleep(.1)\n\n    def press(self, role, label, timeout=12):\n        tree, ready = self.app.wait_for(lambda t: self.app.node(t, role, label) is not None, timeout)\n        self.require(ready, f'missing {role} {label}')\n        node = self.app.node(tree, role, label)\n        self.require(node.get('enabled') is not False, f'disabled {role} {label}')\n        self.app.ax('press', role, label)\n        time.sleep(.3)\n        return self.app.tree()\n\n    def press_any(self, label, timeout=12):\n        roles = ('AXButton', 'AXCheckBox', 'AXRadioButton', 'AXPopUpButton')\n        tree, ready = self.app.wait_for(lambda t: any(self.app.node(t, r, label) for r in roles), timeout)\n        self.require(ready, f'missing control {label}')\n        role = next(r for r in roles if self.app.node(tree, r, label))\n        return self.press(role, label, timeout)\n\n    def text(self, fragment, timeout=15):\n        tree, ready = self.app.wait_for(lambda t: self.app.has_text(t, fragment), timeout)\n        self.require(ready, f'missing fixture text {fragment}')\n        return tree\n\n    def heading(self, label, timeout=15):\n        tree, ready = self.app.wait_for(lambda t: self.app.node(t, 'AXHeading', label) is not None, timeout)\n        self.require(ready, f'missing heading {label}')\n        return tree\n\n    def navigate(self, label):\n        self.app.menu('Go', label)\n        return self.heading(label)\n\n    def fixture_state(self):\n        import fixture_app as fx\n        return json.loads((Path(fx.DATA)/'state.json').read_text())\n\n    def wait_state(self, predicate, message, timeout=15):\n        deadline = time.monotonic()+timeout\n        while time.monotonic() < deadline:\n            value = self.fixture_state()\n            if predicate(value):\n                return value\n            time.sleep(.2)\n        raise RuntimeError(message)\n\n    def record(self, check_id, facts, evidence, visual=None):\n        self.require(check_id in inventory() and check_id not in self.rows, 'unknown or repeated assertion')\n        self.require(bool(facts) and all(type(value) is bool for value in facts.values()), 'facts must be measured booleans')\n        for path in evidence + list(visual or []):\n            self.require((ROOT/path).resolve().is_relative_to(self.out) and (ROOT/path).is_file(), 'evidence must be inside this immutable attempt')\n            self.artifacts[path] = sha(ROOT/path)\n        self.rows[check_id] = {'id': check_id, 'facts': facts, 'evidence': evidence, 'visual': list(visual or [])}\n        self.partial()\n\n    def partial(self):\n        # This file is progress, never acceptance; final raw record uses exclusive creation.\n        (self.out/'observations.partial.json').write_text(json.dumps(self.observations(False), indent=2)+'\\n')\n\n    def observations(self, complete):\n        return {'schema': 'airs-desktop/p11-native-observations/1', 'subject': 'P11', 'complete': complete,\n                'argv': self.argv, 'argv_source': self.argv_source, 'started_utc': self.started, 'finished_utc': time.strftime('%Y-%m-%dT%H:%M:%SZ', time.gmtime()),\n                'performed_by': os.environ.get('AIRS_NATIVE_ORCHESTRATOR'), 'host': platform.platform(),\n                'execution_id': self.out.name, 'status': 'observed' if complete else 'failed', 'exit_code': self.execution_exit_code,\n                'executable_sha256': self.prepared['executable_sha256'], 'bundle_sha256': self.prepared['bundle_sha256'], 'helper_closure': self.closure,\n                'binding': self.binding, 'artifact_sha256': self.artifacts, 'checks': list(self.rows.values()), 'errors': self.errors, 'log': self.log,\n                'meaning': 'Actual fixture AX/keyboard/geometry observations. Pixels and production-interface results need separate bound review; no unrun assertion is a pass.'}\n22:SOURCE_REQUIREMENTS = {\n134:def _press(ctx, label):\n141:def _input(ctx, label):\n149:def _focus(ctx, label):\n157:def _clipboard_write(text):\n161:def _paste(ctx, label, text):\n169:def _copy_matches(ctx, expected):\n178:def _status_regions(tree):\n194:def _metrics(ctx, name, code, history=False):\n211:def _workbench_count(data):\n227:def _quiet_count(ctx, data):\n240:def _save_once(ctx, data):\n248:def _request(root, filename, identity, method, url, body=False):\n255:def _stage(root, origin, replacement=False):\n270:def _close_collection(ctx, name):\n277:def _open_collection(ctx, data, root, name=COLLECTION_NAME):\n285:def _open_request(ctx, filename, method=\"GET\"):\n290:def _json_body_tab(ctx):\n297:def _restart(ctx):\n303:def _history(ctx, prefix):\n311:def _visible(tree, node):\n318:def _prior_first_use(ctx, binding):\n358:def run(ctx, *, prior_first_use=None):\n374:        source_requirements = ctx.save(\"c48-source-boundary-requirements\", SOURCE_REQUIREMENTS)\n375:        ctx.state[\"c48_source_requirements\"] = SOURCE_REQUIREMENTS\n\"\"\"C47-N01: retain the frozen matrix and measure only its two unfinished API focus paths.\"\"\"\nimport copy\nimport hashlib\nimport json\nfrom pathlib import Path\n\nimport acceptance_c29 as c29\nimport acceptance_p11_shell as shell\nimport acceptance_p11_geometry as geometry\n\nROOT = Path.cwd().resolve()\nFLAGS = ('one_named_header_h1', 'navigation_focus', 'main_inside_window', 'academy_location')\nEXPECTED_FACTS = {\n    'all_destinations_have_one_named_header_h1': True,\n    'navigation_focus_observed': True,\n    'main_frames_measured_inside_window': True,\n    'named_actions_keyboard_reachable': False,\n    'academy_hierarchy_retained': True,\n}\nVIEWS = (('Light', 1440, 820, 0, 100), ('Dark', 900, 600, 10, 200))\n\n\ndef require(value, message):\n    if not value:\n        raise RuntimeError(message)\n\n\ndef sha(path):\n    return hashlib.sha256(Path(path).read_bytes()).hexdigest()\n\n\ndef bound(root, ref):\n    path = (root / ref['path']).resolve()\n    require(path.is_relative_to(root.resolve()) and sha(path) == ref['sha256'],\n            'prior keyboard evidence escapes or changed')\n    return path\n\n\ndef inspect_prior(ctx, prior, root=ROOT):\n    raw_path = bound(root, prior['observations'])\n    matrix_path = bound(root, prior['measurements'])\n    raw = json.loads(raw_path.read_text())\n    require(raw['schema'] == 'airs-desktop/p11-native-observations/1' and raw['subject'] == 'P11'\n            and raw['status'] == 'failed' and raw['exit_code'] == 1 and raw['complete'] is False,\n            'original failed matrix process must remain failed')\n    require(raw['binding']['helper_closure'] == raw['helper_closure']\n            and all(raw[key] == raw['binding'][key] == ctx.prepared[key]\n                    for key in ('executable_sha256', 'bundle_sha256'))\n            and raw['binding']['prepare']['sha256'] == ctx.binding['prepare']['sha256']\n            and raw['binding']['native_inventory_sha256'] == ctx.binding['native_inventory_sha256']\n            and raw['host'] == ctx.binding['conditions']['platform'],\n            'prior matrix candidate, platform or binding changed')\n    for name, digest in raw['helper_closure'].items():\n        file = (root / name).resolve()\n        require(file.is_relative_to(root) and file.is_file()\n                and ctx.closure.get(name) == digest == sha(file), 'prior matrix helper bytes changed')\n    for name, digest in raw['artifact_sha256'].items():\n        artifact = (root / name).resolve()\n        require(artifact.is_relative_to(raw_path.parent) and sha(artifact) == digest,\n                'prior matrix artifact changed')\n    rows = [row for row in raw['checks'] if row['id'] == 'C47-N01']\n    require(len(rows) == 1 and rows[0]['facts'] == EXPECTED_FACTS,\n            'prior N01 had a different failed fact')\n    row = rows[0]\n    relative = str(matrix_path.relative_to(root))\n    require(relative in row['evidence'] and raw['artifact_sha256'].get(relative) == prior['measurements']['sha256'],\n            'matrix is not bound by the original N01')\n    matrix = json.loads(matrix_path.read_text())\n    expected = {(page, theme, zoom) for page in shell.PAGES for theme, _, _, _, zoom in VIEWS}\n    require(len(matrix) == 16 and {(r['page'], r['theme'], r['zoom']) for r in matrix} == expected,\n            'frozen matrix membership changed')\n    for item in matrix:\n        require(all(item.get(flag) is True for flag in FLAGS), 'frozen non-keyboard measurement failed')\n        require(item['requested'] == ([1440, 820] if item['theme'] == 'Light' else [900, 600]),\n                'frozen matrix viewport changed')\n        require(item['named_action_keyboard_visible'] is (item['page'] != 'API Client'),\n                'frozen matrix has an unexpected keyboard result')\n    require(len(row['visual']) == len(set(row['visual'])) == 16\n            and all(name in raw['artifact_sha256'] for name in row['visual']),\n            'original matrix captures missing')\n    return raw, row, matrix\n\n\nclass TraversalFailure(RuntimeError):\n    def __init__(self, reason, record):\n        super().__init__('API keyboard traversal failed: ' + reason)\n        self.record = dict(record, failure=reason)\n\n\ndef focus_key(tree, node):\n    semantic = lambda value: (value.get('role'), value.get('label'), value.get('subrole'), value.get('depth'))\n    peers = [value for value in tree if semantic(value) == semantic(node)]\n    return (*semantic(node), next((i for i, value in enumerate(peers) if value is node), 0))\n\n\ndef traverse(initial, tab, tree_now, focused, frame):\n    \"\"\"One finite measured focus cycle, bounded by the actual AX tree size.\"\"\"\n    collection = [n for n in initial if n.get('role') == 'AXPopUpButton'\n                  and (n.get('label') or '').startswith('Collection ')]\n    require(len(collection) == 1, 'API Collection selector is missing or ambiguous')\n    require(sum(n.get('role') == 'AXPopUpButton' and n.get('label') == 'Environment'\n                for n in initial) == 1, 'API Environment selector is missing or ambiguous')\n    labels = {'collection': ('AXPopUpButton', collection[0]['label']),\n              'environment': ('AXPopUpButton', 'Environment')}\n    limit = 2 * max(1, len(initial))\n    trace, seen, reached = [], set(), {}\n    record = {'initial_ax_elements': len(initial), 'element_bound': limit,\n              'expected_header_selectors': labels, 'trace': trace, 'reached': reached}\n    for step in range(1, limit + 1):\n        tab()\n        tree = tree_now()\n        node = focused(tree)\n        if not node:\n            trace.append({'step': step, 'focused': None})\n            continue\n        key = focus_key(tree, node)\n        if key in seen:\n            raise TraversalFailure('focus_cycle', record)\n        seen.add(key)\n        viewport = frame()\n\"\"\"Scoped scan-session precondition for the unfinished C49 credential flow.\"\"\"\nimport acceptance_p11_settings as settings\n\n\ndef run(ctx, bootstrap):\n    # The finish driver removes any leftover fixture scan key before entry.\n    # Credential saves rotate context and remount the form with keychain as\n    # its default, so select session anew before EACH synthetic secret entry.\n    original = ctx.app.type_into\n    submitted = 0\n\n    def type_into(role, label, text, *args, **kwargs):\n        nonlocal submitted\n        if (role, label) == ('AXTextField', 'AIRS API key') and isinstance(text, str) and text.startswith('synthetic-c49-session-key-'):\n            ctx.require(submitted < 2 and text == f'synthetic-c49-session-key-{submitted + 1}',\n                        'unexpected C49 synthetic scan-key sequence')\n            settings._radio(ctx, 'For this session only', 0)  # includes selected-state verification\n            submitted += 1\n            ctx.log.append({'action': 'c49-scan-session-mode-before-input', 'ordinal': submitted})\n        return original(role, label, text, *args, **kwargs)\n\n    ctx.app.type_into = type_into\n    try:\n        result = settings._tenant_controls(ctx, bootstrap)\n        ctx.require(submitted == 2, 'C49 requires both session-key submissions')\n        return result\n    finally:\n        ctx.app.type_into = original\n","exit_code":0,"status":"completed"}}
