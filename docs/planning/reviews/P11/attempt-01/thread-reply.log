{"type":"item.completed","item":{"id":"item_46","type":"command_execution","command":"/bin/zsh -lc \"sed -n '1,140p' tools/native-acceptance/test_acceptance_p11_api.py; sed -n '1,98p' tools/native-acceptance/test_acceptance_p11_geometry.py; sed -n '1,138p' apps/desktop/src/v2/shell-refinement.test.tsx; cat apps/desktop/src/v2/workbench/request-presentation.test.ts\"","aggregated_output":"\"\"\"Pure replay of native AX evidence; never launches apps or endpoints.\"\"\"\nimport argparse\nimport copy\nimport hashlib\nimport json\nfrom pathlib import Path\nimport unittest\n\nimport acceptance_p11_api as api\n\nRAW_TREE = Path('docs/planning/evidence/P11/native-attempt-06-vm/failure-tree.json')\n\nclass App:\n    def __init__(self, tree): self.value = tree\n    def wait_for(self, predicate, timeout): return self.value, bool(predicate(self.value))\n    @staticmethod\n    def has_text(tree, text): return any(text in str(n.get('label') or '') or text in str(n.get('value') or '') for n in tree)\n\nclass Context:\n    def __init__(self, tree): self.app = App(tree); self.state = {}; self.saved = []\n    def save(self, name, value): self.saved.append((name, value)); return 'new-attempt/' + name + '.json'\n    @staticmethod\n    def require(condition, message):\n        if not condition: raise RuntimeError(message)\n\nclass FooterReplay(unittest.TestCase):\n    @classmethod\n    def setUpClass(cls): cls.tree = json.loads(RAW_TREE.read_text())\n\n    def test_captured_split_footer_names_current_record(self):\n        self.assertIs(api._metrics(Context(self.tree), 'My request', 200), self.tree)\n\n    def test_wrong_request_is_not_accepted(self):\n        with self.assertRaises(RuntimeError): api._metrics(Context(self.tree), 'Other request', 200)\n\n    def test_wrong_status_is_not_accepted(self):\n        with self.assertRaises(RuntimeError): api._metrics(Context(self.tree), 'My request', 201)\n\n    def test_current_record_is_not_history(self):\n        with self.assertRaises(RuntimeError): api._metrics(Context(self.tree), 'My request', 200, True)\n\n    def test_history_prefix_keeps_its_own_binding(self):\n        tree = copy.deepcopy(self.tree)\n        node = next(n for n in tree if n.get('label') == 'My request')\n        node['label'] = node['value'] = 'History · My request'\n        self.assertIs(api._metrics(Context(tree), 'My request', 200, True), tree)\n        with self.assertRaises(RuntimeError): api._metrics(Context(tree), 'My request', 200, False)\n\n    def test_status_from_another_region_cannot_satisfy_name(self):\n        tree = [\n            {'depth': 0, 'subrole': 'AXApplicationStatus'},\n            {'depth': 1, 'label': 'My request'},\n            {'depth': 1, 'label': ' · '},\n            {'depth': 1, 'label': '201'},\n            {'depth': 0, 'subrole': 'AXApplicationStatus'},\n            {'depth': 1, 'label': 'Other request · 15:23'},\n            {'depth': 1, 'label': '200 OK'},\n        ]\n        with self.assertRaises(RuntimeError): api._metrics(Context(tree), 'My request', 200)\n        self.assertIs(api._metrics(Context(tree), 'My request', 201), tree)\n\nclass FirstUseCarry(unittest.TestCase):\n    def setUp(self):\n        observations = RAW_TREE.parent / 'observations.json'\n        evidence = RAW_TREE.parent / 'c48-first-use.json'\n        self.binding = {kind: {'path': path.as_posix(), 'sha256': hashlib.sha256(path.read_bytes()).hexdigest()}\n                        for kind, path in [('observations', observations), ('evidence', evidence)]}\n        original = json.loads(observations.read_text())\n        self.ctx = Context([])\n        self.ctx.prepared = {key: original[key] for key in ('executable_sha256', 'bundle_sha256')}\n\n    def test_actual_first_use_keeps_original_provenance(self):\n        passed, local = api._prior_first_use(self.ctx, self.binding)\n        self.assertTrue(passed)\n        self.assertEqual(local, 'new-attempt/c48-first-use-carry.json')\n        carry = self.ctx.saved[-1][1]\n        self.assertEqual(carry['observations'], self.binding['observations'])\n        self.assertEqual(carry['evidence'], self.binding['evidence'])\n        self.assertEqual(carry['original']['execution_id'], RAW_TREE.parent.name)\n        self.assertIn('not a new first-use execution', carry['meaning'])\n\n    def test_hash_drift_is_rejected(self):\n        self.binding['evidence']['sha256'] = '0' * 64\n        with self.assertRaises(RuntimeError): api._prior_first_use(self.ctx, self.binding)\n        self.assertEqual(self.ctx.saved, [])\n\n    def test_other_application_artifact_is_rejected(self):\n        self.ctx.prepared['executable_sha256'] = '0' * 64\n        with self.assertRaises(RuntimeError): api._prior_first_use(self.ctx, self.binding)\n        self.assertEqual(self.ctx.saved, [])\n\n    def test_non_first_use_tree_is_rejected(self):\n        self.binding['evidence'] = {'path': RAW_TREE.as_posix(), 'sha256': hashlib.sha256(RAW_TREE.read_bytes()).hexdigest()}\n        with self.assertRaises(RuntimeError): api._prior_first_use(self.ctx, self.binding)\n        self.assertEqual(self.ctx.saved, [])\n\n    def test_escape_reference_is_rejected(self):\n        self.binding['evidence']['path'] = '../not-P11-evidence.json'\n        with self.assertRaises(RuntimeError): api._prior_first_use(self.ctx, self.binding)\n        self.assertEqual(self.ctx.saved, [])\n\nif __name__ == '__main__':\n    parser = argparse.ArgumentParser()\n    parser.add_argument('--tree', type=Path, default=RAW_TREE)\n    args, remaining = parser.parse_known_args()\n    RAW_TREE = args.tree\n    unittest.main(argv=[__file__, *remaining])\n\"\"\"Pure sizing policy replay; no AX action or application starts.\"\"\"\nimport copy\nimport json\nfrom pathlib import Path\nimport unittest\nfrom unittest.mock import patch\nimport acceptance_p11_geometry as geometry\n\nRAW=Path('docs/planning/evidence/P11/native-attempt-09-vm/failure-tree.json')\nclass App:\n    def __init__(self,ctx):self.ctx=ctx\n    def tree(self):\n        frame=self.ctx.value\n        size=self.ctx.fixed_viewport or [frame[2],frame[3]-32]\n        return [{'role':'AXWebArea','size':size}]\nclass Context:\n    def __init__(self,fixed=None):\n        tree=json.loads(RAW.read_text());self.value=next(n['pos']+n['size'] for n in tree if n.get('role')=='AXWindow')\n        self.fixed_viewport=fixed;self.app=App(self);self.log=[];self.calls=[]\n    def frame(self):return list(self.value)\n    @staticmethod\n    def require(ok,message):\n        if not ok:raise RuntimeError(message)\n    def resize(self,width,height,position=None):\n        self.calls.append((width,height,position))\n        if position is not None:raise AssertionError('repeated clamped position is forbidden')\n        self.value[2:]=[width,height]\n\nclass GeometryPolicy(unittest.TestCase):\n    def test_actual09_chrome_is32_and820_is_exact(self):\n        ctx=Context()\n        self.assertEqual(geometry._measure(ctx)[2],[0,32])\n        with patch.object(geometry.time,'sleep'):frame=geometry.size_window(ctx,1440,820)\n        self.assertEqual(ctx.calls,[(1440,852,None)])\n        self.assertEqual(frame,[0,30,1440,852])\n        self.assertEqual(ctx.log[-1]['actual_viewport'],[1440,820])\n    def test_narrow600_viewport_is_not_outer600(self):\n        ctx=Context()\n        with patch.object(geometry.time,'sleep'):geometry.size_window(ctx,900,600)\n        self.assertEqual(ctx.calls,[(900,632,None)])\n        self.assertEqual(ctx.log[-1]['actual_viewport'],[900,600])\n    def test_wrong_viewport_never_passes(self):\n        ctx=Context(fixed=[1440,816])\n        with patch.object(geometry.time,'sleep'):\n            with self.assertRaisesRegex(RuntimeError,'required shell viewport'):geometry.size_window(ctx,1440,820)\n        self.assertEqual(len(ctx.calls),3)\n    def test_foreign_identity_error_is_not_retried(self):\n        ctx=Context()\n        with patch.object(ctx,'resize',side_effect=RuntimeError('fixture identity changed')) as resize:\n            with self.assertRaisesRegex(RuntimeError,'identity changed'):geometry.size_window(ctx,1440,820)\n        self.assertEqual(resize.call_count,1)\n    def test_shell_hook_restored_on_failure(self):\n        original=geometry.shell.size_window\n        with patch.object(geometry.shell,'run',side_effect=RuntimeError('owned failure')):\n            with self.assertRaisesRegex(RuntimeError,'owned failure'):geometry.run_shell(Context())\n        self.assertIs(geometry.shell.size_window,original)\n\nif __name__=='__main__':unittest.main()\nimport { render, screen, waitFor, within } from '@testing-library/react'\nimport userEvent from '@testing-library/user-event'\nimport { beforeEach, describe, expect, it } from 'vitest'\nimport { DesktopClient, type ShellSnapshot } from '@prisma-airs/desktop-contracts'\nimport { App } from '../app'\nimport { scriptedNative } from '../test/native'\nimport { fxHome, fxSwitcher } from './fixtures'\nimport { resetShellStore } from './store'\n\nasync function launch(snapshot: ShellSnapshot = fxHome()) {\n    const native = scriptedNative(snapshot)\n    render(<App client={new DesktopClient(native.transport)} />)\n    await screen.findByRole('navigation', { name: 'Destinations' })\n    return native\n}\n\nbeforeEach(() => resetShellStore())\n\ndescribe('refined shell page and Explain ownership', () => {\n    it('puts the sole page title and navigation focus in the header while retaining the sidebar Harness action', async () => {\n        const native = await launch(fxSwitcher())\n        const header = document.querySelector('[data-slot=\"app-header\"]') as HTMLElement\n        const home = within(header).getByRole('heading', { level: 1, name: 'Home' })\n        expect(screen.getAllByRole('heading', { level: 1 })).toEqual([home])\n        expect(screen.getByRole('main')).toHaveAttribute('aria-labelledby', home.id)\n        expect(within(header).queryByRole('button', { name: 'Ask Harness' })).toBeNull()\n        expect(within(screen.getByRole('navigation', { name: 'Destinations' })).getByRole('button', { name: /Harness/ })).toBeInTheDocument()\n        expect(screen.getByRole('main').querySelector('[data-slot=\"page-intro\"] [data-slot=\"page-actions\"]')).not.toBeNull()\n        await native.push({ ...native.current, activeFeature: 'inbox' })\n        const inbox = within(header).getByRole('heading', { level: 1, name: 'Inbox' })\n        await waitFor(() => expect(inbox).toHaveFocus())\n        expect(screen.getAllByRole('heading', { level: 1 })).toEqual([inbox])\n        expect(within(screen.getByRole('main')).getByRole('button', { name: 'Refresh' })).toBeInTheDocument()\n    })\n\n    it.each(['administration', 'library', 'harness', 'academy', 'sessions'] as const)('keeps %s outer descriptions beneath the shared title without another page H1', async (activeFeature) => {\n        await launch({ ...fxSwitcher(), activeFeature })\n        expect(screen.getAllByRole('heading', { level: 1 })).toHaveLength(1)\n        expect(screen.getByRole('main').querySelector('[data-slot=\"page-intro\"]')).not.toBeNull()\n    })\n\n    it('keeps Explain outside page layout and lets navigation continue while it is open', async () => {\n        const user = userEvent.setup()\n        const native = await launch({ ...fxHome(), showCalls: true, calls: [] })\n        const panel = screen.getByRole('complementary', { name: 'The calls' })\n        const drawer = panel.closest('[data-slot=\"explain-drawer\"]')\n        expect(drawer).not.toBeNull()\n        expect(drawer).toHaveStyle({ position: 'absolute', overflowY: 'auto' })\n        expect(drawer).not.toHaveAttribute('aria-modal', 'true')\n        expect(screen.getByRole('main')).not.toHaveAttribute('inert')\n        await user.click(within(screen.getByRole('navigation', { name: 'Destinations' })).getByRole('button', { name: /Inbox/ }))\n        expect(native.dispatched.at(-1)).toEqual({ kind: 'navigate', feature: 'inbox' })\n        await native.push({ ...native.current, activeFeature: 'inbox' })\n        expect(screen.getByRole('complementary', { name: 'The calls' })).toBeInTheDocument()\n        expect(screen.getByRole('heading', { level: 1, name: 'Inbox' })).toHaveFocus()\n    })\n\n    it('gives Explain its own Close/Escape and yields to a higher dialog without trapping the page', async () => {\n        const user = userEvent.setup()\n        const native = await launch({ ...fxHome(), showCalls: false, calls: undefined })\n        const explain = screen.getByRole('switch', { name: 'Show the calls' })\n        await user.click(explain)\n        expect(native.dispatched.at(-1)).toEqual({ kind: 'setShowCalls', on: true })\n        await native.push({ ...native.current, showCalls: true, calls: [] })\n        const close = screen.getByRole('button', { name: 'Close Explain' })\n        await waitFor(() => expect(close).toHaveFocus())\n        await user.click(screen.getByRole('button', { name: /Search or go to/ }))\n        expect(screen.getByRole('dialog', { name: 'Command palette' })).toBeInTheDocument()\n        const before = native.dispatched.filter((i) => i.kind === 'setShowCalls').length\n        await user.keyboard('{Escape}')\n        expect(screen.queryByRole('dialog', { name: 'Command palette' })).toBeNull()\n        expect(native.dispatched.filter((i) => i.kind === 'setShowCalls')).toHaveLength(before)\n        expect(screen.getByRole('complementary', { name: 'The calls' })).toBeInTheDocument()\n        screen.getByRole('heading', { level: 1, name: 'Home' }).focus()\n        await user.keyboard('{Escape}')\n        expect(native.dispatched.filter((i) => i.kind === 'setShowCalls')).toHaveLength(before)\n        close.focus()\n        await user.keyboard('{Escape}')\n        expect(native.dispatched.at(-1)).toEqual({ kind: 'setShowCalls', on: false })\n        await native.push({ ...native.current, showCalls: false, calls: undefined })\n        await waitFor(() => expect(explain).toHaveFocus())\n    })\n\n    it('does not send a preference mutation when a tenant change has no visible Explain panel to close', async () => {\n        const native = await launch({ ...fxSwitcher(), showCalls: true, calls: undefined })\n        const other = native.current.tenants[1]!\n        await native.push({ ...native.current, active: { tenant: other.id, context: 'cx-bbbbbbbbbbbbbbbbbbbbbbbb' } })\n        expect(native.dispatched.filter((intent) => intent.kind === 'setShowCalls')).toEqual([])\n    })\n\n    it('retires a pending Explain open when the active tenant changes before its native reply', async () => {\n        const user = userEvent.setup()\n        const native = await launch({ ...fxSwitcher(), showCalls: false, calls: undefined })\n        await user.click(screen.getByRole('switch', { name: 'Show the calls' }))\n        const other = native.current.tenants[1]!\n        await native.push({ ...native.current, active: { tenant: other.id, context: 'cx-bbbbbbbbbbbbbbbbbbbbbbbb' } })\n        await waitFor(() => expect(native.dispatched.at(-1)).toEqual({ kind: 'setShowCalls', on: false }))\n        await native.push({ ...native.current, showCalls: true, calls: [] })\n        expect(screen.queryByRole('complementary', { name: 'The calls' })).toBeNull()\n    })\n\n    it('hides the previous tenant’s drawer immediately until the operator opens it again', async () => {\n        const user = userEvent.setup()\n        const native = await launch({ ...fxSwitcher(), showCalls: true, calls: [] })\n        expect(screen.getByRole('complementary', { name: 'The calls' })).toBeInTheDocument()\n        screen.getByRole('button', { name: 'Close Explain' }).focus()\n        const other = native.current.tenants.find((t) => t.id !== native.current.active?.tenant)!\n        await native.push({ ...native.current, active: { tenant: other.id, context: 'cx-bbbbbbbbbbbbbbbbbbbbbbbb' } })\n        expect(screen.queryByRole('complementary', { name: 'The calls' })).toBeNull()\n        await waitFor(() => expect(native.dispatched.at(-1)).toEqual({ kind: 'setShowCalls', on: false }))\n        await waitFor(() => expect(screen.getByRole('heading', { level: 1, name: 'Home' })).toHaveFocus())\n        // An unrelated snapshot before the native preference reply cannot revive it.\n        await native.push({ ...native.current, appearance: native.current.appearance })\n        expect(screen.queryByRole('complementary', { name: 'The calls' })).toBeNull()\n        await user.click(screen.getByRole('switch', { name: 'Show the calls' }))\n        expect(screen.getByRole('complementary', { name: 'The calls' })).toBeInTheDocument()\n    })\n})\nimport { describe, expect, it } from 'vitest'\nimport { prettyJson } from './request-rows'\n\ndescribe('API JSON presentation preserves JSON tokens', () => {\n    it('indents without rounding large numbers or rewriting string escapes', () => {\n        const raw = '{\"integer\":9007199254740993,\"decimal\":1.2300e+50,\"escaped\":\"\\\\u0061\\\\/\",\"duplicate\":1,\"duplicate\":2}'\n        const shown = prettyJson(raw)\n        expect(shown).toContain('9007199254740993')\n        expect(shown).toContain('1.2300e+50')\n        expect(shown).toContain('\"\\\\u0061\\\\/\"')\n        expect(shown?.match(/\"duplicate\"/g)).toHaveLength(2)\n        expect(raw).toBe('{\"integer\":9007199254740993,\"decimal\":1.2300e+50,\"escaped\":\"\\\\u0061\\\\/\",\"duplicate\":1,\"duplicate\":2}')\n    })\n\n    it('rejects invalid or truncated JSON instead of presenting a repaired response', () => {\n        for (const raw of ['', '  \\n', '{\"x\":', '{\"x\":1,}', 'true false', '[1,', '{\"x\":\"unterminated']) expect(prettyJson(raw)).toBeNull()\n    })\n\n    it('formats empty/nested containers and primitive values without changing their tokens', () => {\n        expect(prettyJson('[{},[],true,false,null,-0,1e3,\"a b\"]')).toBe('[\\n  {},\\n  [],\\n  true,\\n  false,\\n  null,\\n  -0,\\n  1e3,\\n  \"a b\"\\n]')\n        expect(prettyJson('  \"\\\\u0061\"  ')).toBe('\"\\\\u0061\"')\n    })\n\n    it('falls back to raw presentation for excessively large or deeply nested previews', () => {\n        expect(prettyJson(JSON.stringify('x'.repeat(256 * 1024)))).toBeNull()\n        expect(prettyJson('['.repeat(65) + '0' + ']'.repeat(65))).toBeNull()\n    })\n})\n","exit_code":0,"status":"completed"}}
