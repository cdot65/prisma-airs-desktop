{"type":"item.completed","item":{"id":"item_36","type":"command_execution","command":"/bin/zsh -lc \"sed -n '974,1125p' crates/desktop-core/tests/ui_v2_setup_reads/main.rs; sed -n '1,110p' apps/desktop/src/v2/settings/refinement-settings.test.tsx; sed -n '340,491p' apps/desktop/src/v2/workbench/api-client.test.tsx\"","aggregated_output":"async fn refinement_oauth_authentication_does_not_require_profile_permission() {\n    let mut desk = desk().await;\n    desk.script.lock().expect(\"script\").routes.insert(\n        format!(\"/aisec/v1/mgmt/profiles/tsg/{TSG}\"),\n        (403, json!({\"error\": \"profile permission denied\"})),\n    );\n    desk.send(\n        json!({\"kind\": \"beginTenantSetup\", \"mode\": \"firstRun\", \"profile\": {\n            \"label\": \"OAuth only\", \"tsgId\": TSG,\n            \"destination\": {\"kind\": \"region\", \"region\": \"europe\"}\n        }}),\n    )\n    .await\n    .expect(\"draft\");\n    let context = desk.draft_context();\n    desk.send(\n        json!({\"kind\": \"configureManagementCredential\", \"context\": context,\n            \"mode\": \"keychain\", \"clientId\": CLIENT_ID, \"secret\": CLIENT_SECRET\n        }),\n    )\n    .await\n    .expect(\"management credential\");\n    assert!(eventually(|| desk.setup().tenant.management.state == ScanState::Ready).await);\n    let context = desk.draft_context();\n    desk.send(json!({\"kind\": \"verifyTenantSetup\", \"context\": context}))\n        .await\n        .expect(\"verify\");\n    let verify = desk.verified().await;\n    let auth = verify\n        .steps\n        .iter()\n        .find(|s| s.line == VerifyLine::ManagementClient)\n        .expect(\"auth line\");\n    assert_eq!(\n        auth.state,\n        VerifyState::Pass,\n        \"OAuth succeeds independently of Runtime profile permission: {}\",\n        auth.reason\n    );\n    assert!(\n        !verify.blocking && desk.setup().completable,\n        \"a missing scan key does not block authenticated first-run\"\n    );\n    assert!(!desk.setup().scan_required);\n    assert!(\n        desk._server\n            .seen()\n            .iter()\n            .all(|request| !request.request_line.contains(\"/profiles/\")),\n        \"authentication must not inventory Runtime profiles\"\n    );\n    desk.send(json!({\"kind\": \"completeTenantSetup\", \"context\": context, \"packs\": []}))\n        .await\n        .expect(\"complete\");\n    let snapshot = desk.snap();\n    assert_eq!(snapshot.tenants.len(), 1);\n    assert_eq!(snapshot.tenants[0].scan.state, ScanState::Missing);\n    assert_eq!(\n        snapshot.onboarding,\n        desktop_core::features::OnboardingState::Done\n    );\n}\n\n#[tokio::test]\nasync fn refinement_missing_oauth_cannot_complete_an_add_draft() {\n    let mut desk = desk().await;\n    desk.send(\n        json!({\"kind\": \"beginTenantSetup\", \"mode\": \"add\", \"profile\": {\n            \"label\": \"No OAuth\", \"tsgId\": TSG,\n            \"destination\": {\"kind\": \"region\", \"region\": \"europe\"}\n        }}),\n    )\n    .await\n    .expect(\"draft\");\n    let context = desk.draft_context();\n    desk.send(json!({\"kind\": \"verifyTenantSetup\", \"context\": context}))\n        .await\n        .expect(\"verify\");\n    let verify = desk.verified().await;\n    assert!(\n        verify.blocking && !desk.setup().completable,\n        \"missing management OAuth must block Add as well as first-run\"\n    );\n    assert_eq!(\n        desk.send(json!({\"kind\": \"completeTenantSetup\", \"context\": context, \"packs\": []}))\n            .await,\n        Err(Refusal::InvalidInput)\n    );\n    assert!(desk.snap().tenants.is_empty());\n    assert!(\n        desk._server.seen().is_empty(),\n        \"missing credentials initiate no network call\"\n    );\n}\n\n#[tokio::test]\nasync fn refinement_invalid_oauth_cannot_complete_an_add_draft() {\n    let mut desk = desk().await;\n    desk.script.lock().expect(\"script\").token_status = 401;\n    desk.send(\n        json!({\"kind\": \"beginTenantSetup\", \"mode\": \"add\", \"profile\": {\n            \"label\": \"Invalid OAuth\", \"tsgId\": TSG,\n            \"destination\": {\"kind\": \"region\", \"region\": \"europe\"}\n        }}),\n    )\n    .await\n    .expect(\"draft\");\n    let context = desk.draft_context();\n    desk.send(\n        json!({\"kind\": \"configureManagementCredential\", \"context\": context,\n            \"mode\": \"keychain\", \"clientId\": CLIENT_ID, \"secret\": CLIENT_SECRET\n        }),\n    )\n    .await\n    .expect(\"management credential\");\n    assert!(eventually(|| desk.setup().tenant.management.state == ScanState::Ready).await);\n    let context = desk.draft_context();\n    desk.send(json!({\"kind\": \"verifyTenantSetup\", \"context\": context}))\n        .await\n        .expect(\"verify\");\n    let verify = desk.verified().await;\n    assert!(\n        verify.blocking && !desk.setup().completable,\n        \"invalid OAuth is a blocking authentication failure, not an optional product warning\"\n    );\n    assert_eq!(\n        desk.send(json!({\"kind\": \"completeTenantSetup\", \"context\": context, \"packs\": []}))\n            .await,\n        Err(Refusal::InvalidInput)\n    );\n    assert!(desk.snap().tenants.is_empty());\n}\n\n#[tokio::test]\nasync fn refinement_production_policy_rejects_the_legacy_create_tenant_bypass() {\n    // This uses the same actor/intent path as production, with the fixture-only\n    // compatibility capability explicitly disabled as it is in shipping builds.\n    let mut desk = desk_with_fixture_creation(false).await;\n    assert_eq!(\n        desk.send(json!({\"kind\": \"createTenant\", \"profile\": {\n            \"label\": \"Bypass\", \"tsgId\": TSG,\n            \"destination\": {\"kind\": \"region\", \"region\": \"europe\"}\n        }}))\n        .await,\n        Err(Refusal::InvalidInput)\n    );\n    assert!(desk.snap().tenants.is_empty());\n    assert!(desk.snap().active.is_none());\n    assert!(desk._server.seen().is_empty());\n}\n\nasync fn issuer_failure_keeps_its_cause(status: u16, expected: ManagementFailure) {\nimport { render, screen, within } from '@testing-library/react'\nimport userEvent from '@testing-library/user-event'\nimport { describe, expect, it, vi } from 'vitest'\nimport type { SetupMode, SetupView } from '@prisma-airs/desktop-contracts'\nimport { SettingsView } from '../../shell/feature-view'\nimport { Wizard } from '../wizard/wizard'\nimport { draft, setupView } from '../wizard/fixtures'\nimport { fxHome, fxSwitcher } from '../fixtures'\nimport { TenantsSettings } from '../../modules/tenants/tenants-settings'\n\nconst dispatch = () => vi.fn().mockResolvedValue({ kind: 'admitted', operation: null })\n\ndescribe('compact settings contracts', () => {\n    it('changes palette independently from appearance', async () => {\n        const user = userEvent.setup()\n        const send = dispatch()\n        const appearance = vi.fn()\n        render(<SettingsView snapshot={{ ...fxHome(), colorTheme: 'prismaAirs', appearance: 'light' }} pending={false} onSetAppearance={appearance} dispatch={send} observeManagement={vi.fn()} />)\n        await user.selectOptions(screen.getByRole('combobox', { name: 'Theme' }), 'gruvbox')\n        expect(send).toHaveBeenCalledWith({ kind: 'setColorTheme', theme: 'gruvbox' })\n        expect(appearance).not.toHaveBeenCalled()\n        await user.selectOptions(screen.getByRole('combobox', { name: 'Appearance' }), 'dark')\n        expect(appearance).toHaveBeenCalledWith('dark')\n    })\n\n    it('edits only the explicitly selected profile metadata', async () => {\n        const user = userEvent.setup()\n        const send = dispatch()\n        const snapshot = fxSwitcher()\n        render(<TenantsSettings snapshot={snapshot} dispatch={send} observeManagement={vi.fn()} />)\n        const card = within(document.querySelector('[data-slot=\"update-tenant\"]') as HTMLElement)\n        await user.selectOptions(card.getByRole('combobox', { name: 'Tenant to update' }), snapshot.tenants[1]!.id)\n        await user.click(card.getByRole('button', { name: 'Edit' }))\n        await user.clear(card.getByRole('textbox', { name: 'Display name' }))\n        await user.type(card.getByRole('textbox', { name: 'Display name' }), 'Renamed')\n        await user.selectOptions(card.getByRole('combobox', { name: 'Environment' }), 'staging')\n        await user.click(card.getByRole('button', { name: 'Save changes' }))\n        expect(send).toHaveBeenCalledWith({ kind: 'editTenant', tenant: snapshot.tenants[1]!.id, label: 'Renamed', environment: 'staging' })\n        expect(send.mock.calls).toHaveLength(1)\n    })\n\n    it('does not carry a delete confirmation to a different profile after removal', async () => {\n        const user = userEvent.setup()\n        const send = dispatch()\n        const snapshot = fxSwitcher()\n        const view = render(<TenantsSettings snapshot={snapshot} dispatch={send} observeManagement={vi.fn()} />)\n        const card = () => within(document.querySelector('[data-slot=\"update-tenant\"]') as HTMLElement)\n        await user.click(card().getByRole('button', { name: 'Delete' }))\n        expect(card().getByRole('button', { name: /Confirm deleting Northwind/ })).toBeInTheDocument()\n        view.rerender(<TenantsSettings snapshot={{ ...snapshot, tenants: [snapshot.tenants[1]!] }} dispatch={send} observeManagement={vi.fn()} />)\n        expect(card().queryByRole('button', { name: /Confirm deleting/ })).not.toBeInTheDocument()\n        expect(card().getByRole('button', { name: 'Delete' })).toBeInTheDocument()\n        expect(send).not.toHaveBeenCalled()\n    })\n\n    it('opens Add as an isolated wizard rather than creating a credential-free profile', async () => {\n        const user = userEvent.setup()\n        const send = dispatch()\n        render(<TenantsSettings snapshot={fxSwitcher()} dispatch={send} observeManagement={vi.fn()} />)\n        await user.click(screen.getByRole('button', { name: 'Add tenant…' }))\n        expect(screen.getByRole('dialog', { name: 'Add a tenant' })).toBeInTheDocument()\n        expect(screen.queryByRole('radio', { name: 'Custom HTTPS endpoint' })).not.toBeInTheDocument()\n        expect(send).not.toHaveBeenCalled()\n    })\n})\n\ndescribe.each<SetupMode>(['firstRun', 'add'])('required OAuth in %s setup', (mode) => {\n    it('cannot continue with only a Scan Key and no management client', () => {\n        const setup = { ...setupView({ mode, tenant: draft({ scan: { state: 'ready', mode: 'keychain', failure: null } }) }), scanRequired: false, managementRequired: true } as SetupView\n        render(<Wizard snapshot={{ ...fxHome(), setup }} dispatch={dispatch()} observeManagement={vi.fn()} mode={mode} initial={{ step: 'tenant' }} onClose={vi.fn()} onNavigate={vi.fn()} />)\n        expect(screen.getByRole('button', { name: 'Save the management client to continue' })).toBeDisabled()\n    })\n\n    it('can reach verification with a management client and no Scan Key', () => {\n        const setup = { ...setupView({ mode, tenant: draft({ management: { state: 'ready', mode: 'keychain', failure: null, clientId: 'synthetic-client', tokenOrigin: 'https://auth.apps.paloaltonetworks.com' } }) }), scanRequired: false, managementRequired: true } as SetupView\n        render(<Wizard snapshot={{ ...fxHome(), setup }} dispatch={dispatch()} observeManagement={vi.fn()} mode={mode} initial={{ step: 'tenant' }} onClose={vi.fn()} onNavigate={vi.fn()} />)\n        expect(screen.getByRole('button', { name: 'Continue' })).toBeEnabled()\n        expect(screen.getByText(/^OAuth authentication is required before/)).toBeInTheDocument()\n    })\n\n    it('clears an entered client secret when the draft context changes', async () => {\n        const user = userEvent.setup()\n        const setup = { ...setupView({ mode, tenant: draft() }), scanRequired: false, managementRequired: true } as SetupView\n        const props = { dispatch: dispatch(), observeManagement: vi.fn(), mode, initial: { step: 'tenant' as const }, onClose: vi.fn(), onNavigate: vi.fn() }\n        const view = render(<Wizard {...props} snapshot={{ ...fxHome(), setup }} />)\n        const secret = screen.getByLabelText('Client secret') as HTMLInputElement\n        await user.type(secret, 'synthetic-never-submitted-secret')\n        view.rerender(<Wizard {...props} snapshot={{ ...fxHome(), setup: { ...setup, context: 'cx-another-draft-context' } }} />)\n        expect(secret.value).toBe('')\n        expect(props.dispatch).not.toHaveBeenCalled()\n    })\n})\n        expect(tabs).not.toHaveClass('flex-wrap')\n        expect(tabs).toHaveClass('overflow-x-auto')\n        expect(within(tabs).getByRole('tab', { selected: true }).closest('[data-request-tab]')).toHaveClass('shrink-0')\n    })\n\n    it('offers explicit restore recovery without automatically opening SCM or creating a missing collection', async () => {\n        const base = fxApi()\n        const closed = { ...base, workbench: { ...base.workbench, collection: null } }\n        const native = scriptedNative({ ...closed, workbench: { ...closed.workbench, loaded: false } })\n        const requests = workbench(native, answers((r) => r.kind === 'load' ? { kind: 'refused', problem: { kind: 'project', detail: 'notCollection' } } : null))\n        const user = userEvent.setup()\n        render(<App client={new DesktopClient(native.transport)} />)\n        await waitFor(() => expect(requests.filter((r) => r.kind === 'load')).toHaveLength(1))\n        await native.push(closed)\n        expect(await screen.findByText(/The preferred collection could not be opened/)).toBeInTheDocument()\n        await user.click(screen.getByRole('button', { name: 'Try again' }))\n        await waitFor(() => expect(requests.filter((r) => r.kind === 'load')).toHaveLength(2))\n        expect(screen.getByRole('button', { name: 'Open collection…' })).toBeInTheDocument()\n        expect(screen.getByRole('button', { name: 'Open Strata Cloud Manager' })).toBeInTheDocument()\n        await native.push(closed)\n        expect(requests.filter((r) => r.kind === 'load')).toHaveLength(2)\n        expect(requests.filter((r) => ['openBuiltIn', 'createCollection', 'openFolder'].includes(r.kind))).toHaveLength(0)\n    })\n\n    it.each(['missing', 'notCollection'] as const)('keeps %s preferred-folder recovery across Home and back until an explicit retry succeeds', async (detail) => {\n        const base = fxApi()\n        const closed = { ...base, workbench: { ...base.workbench, collection: null } }\n        const native = scriptedNative({ ...closed, workbench: { ...closed.workbench, loaded: false } })\n        let restored = false\n        let cancelled = false\n        const requests = workbench(native, answers((r) => r.kind === 'load'\n            ? cancelled ? { kind: 'cancelled' } : restored ? { kind: 'opened', name: 'AIRS' } : { kind: 'refused', problem: { kind: 'project', detail } }\n            : r.kind === 'openFolder' ? { kind: 'refused', problem: { kind: 'project', detail: 'io' } } : null))\n        const user = userEvent.setup()\n        render(<App client={new DesktopClient(native.transport)} />)\n        await waitFor(() => expect(requests.filter((r) => r.kind === 'load')).toHaveLength(1))\n        await native.push(closed)\n        expect(await screen.findByText(/The preferred collection could not be opened/)).toBeInTheDocument()\n        const navigate = async (feature: 'home' | 'apiClient', label: string) => {\n            await user.click(within(screen.getByRole('navigation', { name: 'Destinations' })).getByRole('button', { name: new RegExp(label) }))\n            expect(native.dispatched.at(-1)).toEqual({ kind: 'navigate', feature })\n            await native.push({ ...native.current, activeFeature: feature })\n            await screen.findByRole('heading', { level: 1, name: label })\n        }\n        await navigate('home', 'Home')\n        await navigate('apiClient', 'API Client')\n        expect(screen.getByText(/The preferred collection could not be opened/)).toBeInTheDocument()\n        expect(screen.getByRole('button', { name: 'Try again' })).toBeInTheDocument()\n        expect(requests.filter((r) => r.kind === 'load')).toHaveLength(1)\n        // A failed alternative is not a successful choice and must not dismiss recovery.\n        await user.click(screen.getByRole('button', { name: 'Open collection…' }))\n        await waitFor(() => expect(requests.filter((r) => r.kind === 'openFolder')).toHaveLength(1))\n        expect(screen.getByText(/The preferred collection could not be opened/)).toBeInTheDocument()\n        expect(screen.getByRole('button', { name: 'Try again' })).toBeInTheDocument()\n        await user.click(screen.getByRole('button', { name: 'Try again' }))\n        await waitFor(() => expect(requests.filter((r) => r.kind === 'load')).toHaveLength(2))\n        expect(screen.getByRole('button', { name: 'Try again' })).toBeInTheDocument()\n        cancelled = true\n        await user.click(screen.getByRole('button', { name: 'Try again' }))\n        await waitFor(() => expect(requests.filter((r) => r.kind === 'load')).toHaveLength(3))\n        expect(screen.getByRole('button', { name: 'Try again' })).toBeInTheDocument()\n        cancelled = false\n        restored = true\n        let releaseRestore: (() => void) | undefined\n        if (detail === 'notCollection') {\n            const observe = native.observeWorkbench\n            native.observeWorkbench = async (operation) => {\n                native.observeWorkbench = observe\n                const result = await observe(operation)\n                await new Promise<void>((resolve) => { releaseRestore = resolve })\n                return result\n            }\n        }\n        await user.click(screen.getByRole('button', { name: 'Try again' }))\n        await waitFor(() => expect(requests.filter((r) => r.kind === 'load')).toHaveLength(4))\n        // Both native orders: an opened snapshot may precede the load result.\n        if (detail === 'notCollection') {\n            await waitFor(() => expect(releaseRestore).toBeDefined())\n            await native.push(base)\n            await act(async () => { releaseRestore!() })\n        } else await native.push(base)\n        expect(screen.queryByText(/The preferred collection could not be opened/)).not.toBeInTheDocument()\n        expect(document_().querySelector('[data-slot=workbench-message]')).toBeNull()\n        // The explicit Close preference must remain closed on remount, rather than restoring the default.\n        await user.click(screen.getByRole('button', { name: 'Collection AIRS' }))\n        await user.click(screen.getByRole('menuitem', { name: 'Close collection' }))\n        await waitFor(() => expect(requests.filter((r) => r.kind === 'closeCollection')).toHaveLength(1))\n        await native.push(closed)\n        await navigate('home', 'Home')\n        await navigate('apiClient', 'API Client')\n        expect(screen.getByText('No collection is open.')).toBeInTheDocument()\n        expect(screen.queryByRole('button', { name: 'Try again' })).not.toBeInTheDocument()\n        expect(screen.queryByText(/The preferred collection could not be opened/)).not.toBeInTheDocument()\n        expect(requests.filter((r) => r.kind === 'load')).toHaveLength(4)\n        expect(requests.filter((r) => ['openBuiltIn', 'createCollection'].includes(r.kind))).toHaveLength(0)\n        expect(requests.filter((r) => r.kind === 'openFolder')).toHaveLength(1)\n    })\n\n    it.each([['initial', 'busy'], ['initial', 'lost'], ['retry', 'busy'], ['retry', 'lost']] as const)('keeps %s restore delivery recovery actionable after %s across Home and back', async (stage, failure) => {\n        const base = fxApi()\n        const closed = { ...base, workbench: { ...base.workbench, collection: null } }\n        const native = scriptedNative({ ...closed, workbench: { ...closed.workbench, loaded: false } })\n        let mode: 'missing' | 'busy' | 'lost' | 'opened' = stage === 'initial' ? failure : 'missing'\n        const requests = workbench(native, answers((r) => r.kind === 'load'\n            ? mode === 'opened' ? { kind: 'opened', name: 'AIRS' } : { kind: 'refused', problem: { kind: 'project', detail: 'missing' } }\n            : null))\n        const respond = native.respond\n        native.respond = (intent) => intent.kind === 'workbench' && intent.request.kind === 'load' && mode === 'busy'\n            ? { outcome: 'refusal', refusal: 'busy' } : respond(intent)\n        const observe = native.observeWorkbench\n        native.observeWorkbench = (operation) => {\n            const request = requests.find((_, i) => `op-${i + 1}` === operation)\n            return request?.kind === 'load' && mode === 'lost' ? Promise.reject(new Error('private observation detail must not surface')) : observe(operation)\n        }\n        const loads = () => native.dispatched.filter((intent) => intent.kind === 'workbench' && intent.request.kind === 'load').length\n        const user = userEvent.setup()\n        render(<App client={new DesktopClient(native.transport)} />)\n        await waitFor(() => expect(loads()).toBe(1))\n        if (stage === 'retry') {\n            await native.push(closed)\n            await screen.findByRole('button', { name: 'Try again' })\n            mode = failure\n            await user.click(screen.getByRole('button', { name: 'Try again' }))\n        }\n        const count = stage === 'initial' ? 1 : 2\n        const outcome = failure === 'busy' ? 'The desktop is busy with a previous request. Try again in a moment.' : 'The desktop did not report how the request ended. Check the request before trying again.'\n        const warning = () => document_().querySelector('[data-slot=workbench-message]') as HTMLElement\n        await waitFor(() => expect(warning()).toHaveTextContent(outcome))\n        expect(warning()).toHaveTextContent('The preferred collection could not be opened.')\n        expect(screen.getByRole('button', { name: 'Try again' })).toBeInTheDocument()\n        expect(screen.getByText('No collection is open.')).toBeInTheDocument()\n        expect(loads()).toBe(count)\n        // The initial failure deliberately leaves Rust's loaded=false snapshot unchanged.\n        for (const [feature, label] of [['home', 'Home'], ['apiClient', 'API Client']] as const) {\n            await user.click(within(screen.getByRole('navigation', { name: 'Destinations' })).getByRole('button', { name: new RegExp(label) }))\n            await native.push({ ...native.current, activeFeature: feature })\n            await screen.findByRole('heading', { level: 1, name: label })\n        }\n        expect(warning()).toHaveTextContent(outcome)\n        expect(screen.getByRole('button', { name: 'Try again' })).toBeInTheDocument()\n        expect(loads()).toBe(count)\n        expect(screen.queryByText(/private observation detail/)).not.toBeInTheDocument()\n        mode = 'opened'\n        await user.click(screen.getByRole('button', { name: 'Try again' }))\n        await waitFor(() => expect(loads()).toBe(count + 1))\n        await native.push(base)\n        expect(document_().querySelector('[data-slot=workbench-message]')).toBeNull()\n        expect(screen.queryByRole('button', { name: 'Try again' })).not.toBeInTheDocument()\n        expect(native.dispatched.filter((intent) => intent.kind === 'workbench' && ['openBuiltIn', 'createCollection', 'openFolder'].includes(intent.request.kind))).toHaveLength(0)\n    })\n\n    it('uses only the restore warning for a core refusal after an undelivered load', async () => {\n","exit_code":0,"status":"completed"}}
