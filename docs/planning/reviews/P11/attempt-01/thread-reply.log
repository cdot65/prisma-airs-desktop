didate, source, files)\n    source_qa(root, receipt['source_qa'], files)\n    originals = {r['id']: r for r in original_coverage['coverage']}\n    recovery(root, receipt['recovery'], receipt['baseline'], candidate, originals['C48-N03']['result'], files)\n    modes = {cid: 'executed' if cid in SOURCE_IDS | {'C48-N03'} else 'carried_unaffected' for cid in originals}\n    plan = read(bound(root, qualified['plan']))\n    proof.verify_plan(source, plan, modes)\n    rows = qualified['coverage']\n    require(len(rows) == len(originals) and {r['id'] for r in rows} == set(originals), 'remediation coverage missing/duplicated')\n    require(set(receipt['unaffected']) == set(originals)-SOURCE_IDS-{'C48-N03'}, 'unchanged-impact reason missing')\n    requirements = {r['id']: r for r in plan['requirements']}\n    for row in rows:\n        cid = row['id']; require(row['disposition'] == modes[cid], 'remediation disposition differs')\n        if cid in SOURCE_IDS | {'C48-N03'}:\n            expected = {'schema': 'airs-desktop/p11-affected-selector-result/1', 'required_id': cid,\n                'actual_evidence': selector_reference(receipt, cid),\n                'original_result': originals[cid]['result'],\n                'meaning': 'Actual affected selectors supplement the retained original registered goal. No full original command or unrelated native flow is claimed newly executed.'}\n            require(read(bound(root, row['result'])) == expected, 'affected goal lacks actual selector evidence')\n            continue\n        require(row['result'] == originals[cid]['result'] and receipt['unaffected'][cid], 'original result was relabelled')\n        original = read(bound(root, row['result'])); origin = read(bound(root, original['candidate']))\n        deps = dependencies(files, cid, requirements[cid].get('helper_paths', []))\n        require(requirements[cid].get('dependencies') == deps\n                and row['impact']['dependencies'] == deps\n                and row['impact']['reason'] == receipt['unaffected'][cid]\n                and row['impact']['original_candidate_sha256'] == original['candidate']['sha256'],\n                'remediation dependency scope/rationale differs')\n        impact = read(bound(root, row['impact']['proof']))\n        bindings = impact['file_bindings']\n        require(set(bindings) == set(deps) and deps\n                and impact['unchanged_dependencies'] == deps\n                and impact['current_source_inventory_sha256'] == qualified['source_inventory_sha256']\n                and impact['original_candidate_sha256'] == original['candidate']['sha256'],\n                'remediation dependency proof binding differs')\n        old_source = history.source(origin['source_inventory_sha256'])\n        for name in deps:\n            value = bindings[name]\n            require(value['original_sha256'] == value['current_sha256'] == sha(source/name) == sha(old_source/name),\n                    'carried dependency changed: ' + name)\n    # The old custom partial Check rows were already validated above in their\n    # archived source. Their failed full-run status must not be rewritten to\n    # satisfy the generic all-pass-run parser. Other original raw rows use it.\n    generic_ids = {cid for cid in originals if cid not in SOURCE_IDS | {'C48-N03'} and not cid.startswith('check:')}\n    runtime_plan = read(bound(root, qualified['runtime_plan']))\n    require(runtime_plan == dict(plan, requirements=[r for r in plan['requirements'] if r['id'] in generic_ids]),\n            'remediation generic coverage projection differs')\n    proof.coverage.verify(root, dict(qualified, plan=qualified['runtime_plan'],\n        coverage=[r for r in rows if r['id'] in generic_ids]), historical=historical)\n    return {'qualified': True, 'required': len(rows),\n            'dispositions': {m: sum(r['disposition'] == m for r in rows) for m in sorted(set(modes.values()))},\n            'candidate_sha256': qualified['candidate']['sha256'], 'source_inventory_sha256': qualified['source_inventory_sha256']}\n\n\ndef versioned_build(root, build, candidate):\n    path = candidate['prepare']['path']\n    prefix, suffix = 'docs/planning/evidence/P11/native-build-', '-vm/native-prepare.json'\n    number = path.removeprefix(prefix).removesuffix(suffix)\n    require(number.isdigit() and int(number) >= 5 and path == f'{prefix}{int(number):02}{suffix}',\n            'new build may not overwrite the original canonical preparation')\n    argv = ['cargo', 'run', '--locked', '-p', 'xtask', '--example', 'p11_native_candidate', '--', '--out', path]\n    commands = [step['argv'] for step in build['steps']]\n    require(commands and commands[-1] in (argv, argv[:2]+['--offline']+argv[2:])\n            and commands[:-1] in ([], [['pnpm', '--filter', '@prisma-airs/desktop-contracts', 'typecheck'],\n                ['pnpm', '--filter', '@prisma-airs/desktop', 'typecheck']])\n            and build['application_inputs_after'] == build['application_inputs_before'],\n            'versioned native build command/input recipe differs')\n    old = read(root/'docs/planning/evidence/P11/native-prepare.json')\n    current = read(bound(root, candidate['prepare']))\n    require(current['commands'] == old['commands'] and current['target'] == old['target']\n            and current['features'] == old['features'] and current['subject'] == 'P11',\n            'versioned build changed the fixture recipe')\n\n\ndef make(root, receipt_path, out):\n    require(not out.exists(), 'preserve previous remediation qualification')\n    receipt = read(receipt_path)\n    files = read(bound(root, receipt['current_source']))['files']\n    old = read(bound(root, receipt['baseline']))\n    original = read(bound(root, old['coverage']))\n    prepared = read(bound(root, receipt['prepare']))\n    native = read(bound(root, receipt['recovery']))\n    candidate = dict(source_inventory_sha256=digest(files), execution_root=str(root),\n        runner_inputs=receipt['runner_inputs'], dependency_fingerprint=receipt['runner_inputs']['dependencies'],\n        prepare=receipt['prepare'], executable_sha256=prepared['executable_sha256'],\n        bundle_sha256=prepared['bundle_sha256'], build_flags={'target': prepared['target'], 'features': prepared['features']},\n        conditions=read(bound(root, native['raw']))['conditions'], helper_closure=native['helper_closure'])\n    history = ArchivedP11(root, receipt['historical_context'])\n    out.mkdir(parents=True)\n    def write(name, value):\n        p = out/name; p.parent.mkdir(parents=True, exist_ok=True)\n        with p.open('x') as stream: json.dump(value, stream, indent=2); stream.write('\\n')\n        return proof.reference(root, p)\n    candidate_ref = write('candidate.json', candidate)\n    requirements = copy.deepcopy(read(bound(root, original['plan']))['requirements'])\n    by_id = {r['id']: r for r in requirements}; rows = []\n    for original_row in original['coverage']:\n        cid = original_row['id']; needed = by_id[cid]\n        affected = cid in SOURCE_IDS | {'C48-N03'}\n        needed.update(affected=affected, must_execute=affected)\n        if affected:\n            result = write('results/'+cid.replace(':', '-').replace('/', '-')+'.json', {\n                'schema': 'airs-desktop/p11-affected-selector-result/1', 'required_id': cid,\n                'actual_evidence': selector_reference(receipt, cid),\n                'original_result': original_row['result'],\n                'meaning': 'Actual affected selectors supplement the retained original registered goal. No full original command or unrelated native flow is claimed newly executed.'})\n            rows.append(dict(id=cid, disposition='executed', result=result))\n            continue\n        result = read(bound(root, original_row['result'])); origin = read(bound(root, result['candidate']))\n        deps = dependencies(files, cid, needed.get('helper_paths', [])); needed['dependencies'] = deps\n        old_source = history.source(origin['source_inventory_sha256'])\n        bindings = {name: {'original_sha256': sha(old_source/name), 'current_sha256': sha(root/name),\n            'original_file': proof.reference(root, old_source/name)} for name in deps}\n        impact = write('impact/'+cid.replace(':', '-').replace('/', '-')+'.json', {\n            'file_bindings': bindings, 'unchanged_dependencies': deps,\n            'current_source_inventory_sha256': digest(files), 'original_candidate_sha256': result['candidate']['sha256']})\n        rows.append(dict(id=cid, disposition='carried_unaffected', result=original_row['result'], impact={\n            'reason': receipt['unaffected'][cid], 'dependencies': deps, 'proof': impact,\n            'original_candidate_sha256': result['candidate']['sha256']}))\n    plan = {'schema': 'airs-desktop/required-coverage/1', 'subject': 'P11', 'requirements': requirements}\n    plan_ref = write('required-coverage.json', plan)\n    generic_ids = {r['id'] for r in rows if r['disposition'] == 'carried_unaffected' and not r['id'].startswith('check:')}\n    runtime = write('runtime-required-coverage.json', dict(plan,\n        requirements=[r for r in requirements if r['id'] in generic_ids]))\n    qualified = write('coverage.json', {'schema': 'airs-desktop/qualified-coverage/1', 'plan': plan_ref,\n        'candidate': candidate_ref, 'source_inventory_sha256': digest(files), 'coverage': rows,\n        'runtime_plan': runtime, 'review_remediation': proof.reference(root, receipt_path)})\n    record = {'schema': 'airs-desktop/p11-shared-qualification/1', 'source': receipt['current_source'],\n        'coverage': qualified, 'runner_inputs': receipt['runner_inputs'], 'fingerprint': receipt['fingerprint'],\n        'native_execution': native['raw'], 'build': receipt['build'], 'runs': old['runs'],\n        'historical_baseline': old['historical_baseline'], 'historical_standing': old['historical_standing'],\n        'review_remediation': proof.reference(root, receipt_path), 'controller_complete': False,\n        'historical_use': 'Original qualification02 results/artifacts remain bound. Only explicit affected source selectors and native recovery execute anew; unrelated results retain original process/source/artifact provenance.'}\n    path = write('qualification.json', record)\n    return proof.verify(root, root/path['path'])\n\n\nif __name__ == '__main__':\n    parser = argparse.ArgumentParser(description=__doc__)\n    parser.add_argument('receipt', type=Path)\n    parser.add_argument('--out', required=True, type=Path)\n    args = parser.parse_args()\n    print(json.dumps(make(Path.cwd().resolve(), args.receipt.resolve(), args.out.resolve()), indent=2))\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_15","type":"command_execution","command":"/bin/zsh -lc \"sed -n '1,65p' tools/p09/phase_packet.py; sed -n '735,821p' tools/p11/proof.py; sed -n '1,175p' tools/p11/standing.py; cat docs/planning/reviews/C48/attempt-03/verdict-returned.json\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_15","type":"command_execution","command":"/bin/zsh -lc \"sed -n '1,65p' tools/p09/phase_packet.py; sed -n '735,821p' tools/p11/proof.py; sed -n '1,175p' tools/p11/standing.py; cat docs/planning/reviews/C48/attempt-03/verdict-returned.json\"","aggregated_output":"\"\"\"Current P09 packet and post-review audit; independent review remains external.\"\"\"\nfrom pathlib import Path\nimport argparse\nimport hashlib\nimport json\nimport os\nimport stat\nimport subprocess\nimport time\n\nimport phase_inputs as inputs\n\nPREVIOUS_PHASE = '6a7253c2'\n\n\ndef digest(value):\n    return hashlib.sha256((json.dumps(value, sort_keys=True, separators=(',', ':')) + '\\n').encode()).hexdigest()\n\n\ndef file_identity(path):\n    metadata = path.lstat()\n    value = {'mode': stat.S_IMODE(metadata.st_mode)}\n    if path.is_symlink():\n        value.update(kind='symlink', target=os.readlink(path))\n    else:\n        inputs.require(path.is_file(), 'unsupported source kind: ' + str(path))\n        value.update(kind='file', sha256=inputs.sha(path))\n    return value\n\n\ndef source_inventory(root):\n    names = subprocess.check_output(['git', 'ls-files', '-z', '--cached', '--others', '--exclude-standard'], cwd=root).decode().split('\\0')\n    excluded = ('docs/planning/evidence/', 'docs/planning/reviews/')\n    def active_tool(name):\n        return ((name.startswith('docs/planning/evidence/P09/native-controller/') and name.endswith('.py'))\n                or name in ['docs/planning/evidence/P09/runs/hash-inputs.sh', 'docs/planning/evidence/P09/runs/run-checks.sh'])\n    return {name: file_identity(root / name) for name in sorted(set(names))\n            if name and name != 'docs/planning/status.md' and (not name.startswith(excluded) or active_tool(name))\n            and ((root / name).exists() or (root / name).is_symlink())}\n\n\ndef live_evidence(root):\n    path = root / 'docs/planning/evidence/C29/live/L19-verify.json'\n    live = inputs.read(path)\n    inputs.require(live['status'] == 'pass' and live['temporary_local_credentials_removed'], 'L19 pass/cleanup missing')\n    inputs.require(live['budget']['total_reserved'] == 3 and live['budget']['refunded'] == 0, 'L19 charged budget changed')\n    receipt = root / live['native_receipt']\n    inputs.require(inputs.sha(receipt) == live['native_receipt_sha256'], 'L19 receipt hash mismatch')\n    raw = inputs.read(receipt)\n    inputs.require(raw['status'] == 'pass' and raw['local_credentials_removed'], 'L19 actual receipt not passing/cleaned')\n    archived = root / 'docs/planning/evidence/C29/live/L19/build-02/l19-qualification-executable.bin'\n    inputs.require(inputs.sha(archived) == raw['executable_sha256'], 'L19 historical executable mismatch')\n    return {'record': str(path.relative_to(root)), 'sha256': inputs.sha(path),\n            'native_receipt': str(receipt.relative_to(root)), 'native_receipt_sha256': inputs.sha(receipt),\n            'qualification_executable': str(archived.relative_to(root)), 'qualification_executable_sha256': inputs.sha(archived),\n            'live_calls_performed_by_this_verifier': 0, 'remaining_live_allowance': 0}\n\n\ndef evidence_inventory(root, run_path, verified):\n    files = set()\n    phase = root / 'docs/planning/evidence/P09'\n    prefixes = [phase / 'native', phase / 'parity', phase / 'screens', phase / 'preparations', phase / 'check-remediation', phase / 'performance', phase / 'phase-tooling-history', phase / 'phase-tooling-validation', run_path.parent / inputs.read(run_path)['attempt'],\n                root / 'docs/planning/evidence/C29/live/L19']\n    prefixes += list((phase / 'native-history').glob('*Worf*'))\n    for prefix in prefixes:\ndef verify(root, path):\n    record = read(path)\n    require(record['schema'] == 'airs-desktop/p11-shared-qualification/1', 'P11 proof schema')\n    require(set(record['runner_inputs']) == {'source', 'dependencies', 'build_flags'},\n            'P11 runner input keys differ')\n    require(record['runner_inputs']['source'] == xtask_source(root),\n            'current source does not match actual runner source fingerprint')\n    seal = read(bound(root, record['source']))\n    require(source_inventory(root) == seal['files'], 'P11 source changed after qualification')\n    qualified = read(bound(root, record['coverage']))\n    require(digest(seal['files']) == qualified['source_inventory_sha256'], 'P11 source binding')\n    if 'review_remediation' in record:\n        require(qualified.get('review_remediation') == record['review_remediation'],\n                'review remediation qualification binding differs')\n    elif 'helper_source_carry' in record:\n        validate_helper_source_carry(root, bound(root, record['helper_source_carry']), record['runner_inputs'])\n    elif 'impact_selection' in record:\n        validate_impact_selection(root, bound(root, record['impact_selection']), record['runner_inputs'])\n    else:\n        for kind in ('check', 'test'):\n            validate_run(root, bound(root, record['runs'][kind]), kind, record['runner_inputs'])\n    inputs = read(bound(root, record['fingerprint']))\n    require(record['runner_inputs'] == {key: inputs[key] for key in record['runner_inputs']},\n            'P11 observed current fingerprint mismatch')\n    current = current_fingerprints(root)\n    require(record['runner_inputs'] == {key: current[key] for key in record['runner_inputs']},\n            'current dependency/toolchain/build flags differ from executed checks')\n    result = verify_coverage(root, qualified)\n    candidate = read(bound(root, qualified['candidate']))\n    from candidate import verify_candidate\n    verify_candidate(root, candidate)\n    performed = read(bound(root, record['native_execution']))\n    if 'review_remediation' in record:\n        remedy = read(bound(root, record['review_remediation']))\n        recovery = read(bound(root, remedy['recovery']))\n        require(record['native_execution'] == recovery['raw']\n                and candidate['helper_closure'] == recovery['helper_closure'],\n                'affected recovery helper/execution membership changed')\n    else:\n        require(candidate['helper_closure'] == helper_closure(root, native_driver(root, performed)),\n                'P11 native helper membership changed')\n        validate_execution(root, performed, candidate,\n            acceptance=bound(root, record['native_acceptance']) if 'native_acceptance' in record else None,\n            execution=bound(root, record['native_execution']))\n    build_path = bound(root, record['build'])\n    build = read(build_path)\n    require(build['application_inputs_unchanged'] is True\n            and all(step['exit_code'] == 0 for step in build['steps']), 'fixture build failed/drifted')\n    if 'review_remediation' in record:\n        import remediation\n        remediation.versioned_build(root, build, candidate)\n    else:\n        require([step['argv'] for step in build['steps']] == [\n            ['pnpm', '--filter', '@prisma-airs/desktop-contracts', 'typecheck'],\n            ['pnpm', '--filter', '@prisma-airs/desktop', 'typecheck'],\n            ['cargo', 'run', '--locked', '-p', 'xtask', '--', 'native-prepare', '--phase', 'P11',\n             '--target', 'aarch64-apple-darwin', '--features', 'test-fixtures']],\n            'missing or changed fixture build invocation')\n    require(set(build['application_inputs_before']) == application_files(root),\n            'built application input membership differs or is incomplete')\n    require(read(build_path.parent / 'native-prepare.json') == read(bound(root, candidate['prepare'])),\n            'prepared candidate differs from retained actual build output')\n    for step in build['steps']:\n        log = (build_path.parent / step['log']).resolve()\n        require(log.is_relative_to(root.resolve()) and sha(log) == step['log_sha256'],\n                'fixture build log drift')\n    changed = [name for name, value in build['application_inputs_before'].items()\n               if sha(root / name) != value]\n    if changed:\n        carry_schema = read(bound(root, record['build_input_carry']))['schema']\n        if carry_schema == 'airs-desktop/rust-test-build-carry/1':\n            rust_test_carry(root, record, build_path, build, candidate, changed)\n        else:\n            frontend_test_carry(root, record, build_path, build, candidate, changed)\n    else:\n        require('build_input_carry' not in record, 'unnecessary or stale build carry')\n    baseline = read(bound(root, record['historical_baseline']))\n    require(record['historical_baseline']['path'] == 'docs/planning/evidence/P10/completion-proof.json'\n            and baseline['schema'] == 'airs-desktop/p10-completion-proof/1', 'missing accepted baseline')\n    from review_gate import release_prerequisites\n    require(record['historical_standing'] == release_prerequisites(root),\n            'actual historical standing drift')\n    return {'record': str(path.relative_to(root)), 'sha256': sha(path),\n            'verified': result, 'candidate_sha256': qualified['candidate']['sha256'],\n            'controller_complete': False}\n\n\n\"\"\"Durable, audited P11 standing for later production promotion.\n\nFinalization consumes completed executions and five real full-9 reviews. It\nnever assigns a score or completes a controller ledger. Historical validation\nuses the archived source/application, not this checkout's ignored target tree,\ninstalled application, toolchain, hostname, or current application source.\n\"\"\"\nfrom pathlib import Path\nimport json\nimport shutil\nimport subprocess\nimport sys\n\nsys.path.insert(0, str(Path(__file__).resolve().parent))\nsys.path.insert(0, str(Path(__file__).resolve().parents[1] / 'p10'))\nfrom candidate import bundle_hash, digest, file_identity\nfrom historical import Historical\nfrom qualification import bound, read, require, sha, verify as verify_coverage\nfrom review_gate import actual_review, release_prerequisites\n\nCHUNKS = ('C46', 'C47', 'C48', 'C49')\nSUBJECTS = (*CHUNKS, 'P11')\nBASE = Path('docs/planning/evidence/P11')\nACCEPTED = BASE / 'accepted'\nCOMPLETION = BASE / 'completion-proof.json'\nD2_SOURCE = BASE / 'source-history/D2'\nS2_SOURCE = BASE / 'source-history/S2'\nS3_SOURCE = BASE / 'source-history/S3'\nS4_SOURCE = BASE / 'source-history/S4'\nS4_APPLICATION = BASE / 'review-carry-baseline-01/application'\nLFS_PATHS = (str(S4_SOURCE / 'resources/harness/darwin-arm64.tar.gz'),\n             str(S4_APPLICATION / 'Contents/MacOS/prisma-airs-desktop'),\n             str(S4_APPLICATION / 'Contents/Resources/harness/airs-harness'),\n             str(S3_SOURCE / 'resources/harness/darwin-arm64.tar.gz'),\n             str(S2_SOURCE / 'resources/harness/darwin-arm64.tar.gz'),\n             str(D2_SOURCE / 'resources/harness/darwin-arm64.tar.gz'),\n             str(ACCEPTED / 'application/Contents/MacOS/prisma-airs-desktop'),\n             str(ACCEPTED / 'application/Contents/Resources/harness/airs-harness'),\n             str(ACCEPTED / 'source/resources/harness/darwin-arm64.tar.gz'))\n\n\nclass ArchivedP11(Historical):\n    \"\"\"Explicit P11 archive context; historical C45 behavior is untouched.\"\"\"\n    def archive_path(self, name):\n        path = self.root / name\n        require(path.resolve().is_relative_to((self.root / ACCEPTED).resolve())\n                or path.resolve() in ((self.root / D2_SOURCE).resolve(), (self.root / S2_SOURCE).resolve(), (self.root / S3_SOURCE).resolve(),\n                (self.root / S4_SOURCE).resolve(), (self.root / S4_APPLICATION).resolve()),\n                'historical archive escapes accepted P11 evidence')\n        return path\n\n\ndef reference(root, path):\n    root = Path(root).resolve()\n    path = Path(path).resolve(strict=True)\n    require(path.is_relative_to(root.resolve()), 'P11 reference escapes checkout')\n    return {'path': str(path.relative_to(root)), 'sha256': sha(path)}\n\n\ndef identities(root, paths):\n    return {str(path.relative_to(root)): file_identity(path) for path in sorted(set(paths))}\n\n\ndef evidence_files(root, attempts):\n    paths = [p for p in (root / BASE).rglob('*')\n             if (p.is_file() or p.is_symlink()) and not p.is_relative_to(root / ACCEPTED)\n             and p != root / COMPLETION and '__pycache__' not in p.parts]\n    for subject, attempt in attempts.items():\n        paths.extend(p for p in (root / 'docs/planning/reviews' / subject / attempt).rglob('*')\n                     if (p.is_file() or p.is_symlink()) and '__pycache__' not in p.parts)\n    return paths\n\n\ndef latest_attempt(root, subject):\n    attempts = [p.name for p in (root / 'docs/planning/reviews' / subject).glob('attempt-*')\n                if p.is_dir() and p.name.removeprefix('attempt-').isdigit()]\n    require(attempts, 'missing actual P11 member/phase review: ' + subject)\n    return max(attempts, key=lambda name: int(name.removeprefix('attempt-')))\n\n\ndef require_archive_lfs(root):\n    result = subprocess.run(['/usr/bin/git', 'check-attr', '-z', 'filter', '--', *LFS_PATHS],\n                            cwd=root, capture_output=True, check=True)\n    fields = result.stdout.decode().strip('\\0').split('\\0')\n    require(len(fields) == len(LFS_PATHS) * 3\n            and all(fields[i:i+3] == [name, 'filter', 'lfs'] for i, name in zip(range(0, len(fields), 3), LFS_PATHS)),\n            'configure reviewed P11 archive Git LFS paths before finalization')\n\n\ndef audited_reviews(root, attempts, qualified, source):\n    root = Path(root).resolve()\n    require(set(attempts) == set(SUBJECTS), 'P11 requires exactly four member reviews and its phase review')\n    phase = read(root / 'docs/planning/reviews/P11' / attempts['P11'] / 'request.json')\n    carry = None\n    if 'review_carry' in phase:\n        import review_carry\n        carry = review_carry.validate(root, bound(root, phase['review_carry']), qualified, source_root=source)\n    reviews = {}\n    for subject in SUBJECTS:\n        attempt = attempts[subject]\n        require(attempt == latest_attempt(root, subject), 'newer review attempt exists: ' + subject)\n        request = read(root / 'docs/planning/reviews' / subject / attempt / 'request.json')\n        if carry and subject in carry['members']:\n            reviews[subject] = carry['members'][subject]\n            require(attempt == reviews[subject]['attempt'], 'carried original member attempt changed')\n        else:\n            require(request['qualification'] == qualified,\n                    ('current C48/phase qualification differs: ' if carry else\n                     'P11 reviews do not bind one shared qualification: ') + subject)\n            reviews[subject] = actual_review(root, subject, attempt, source_root=source)\n        require(all(value >= 9 for value in reviews[subject]['scores'].values()),\n                'P11 promotion requires full-9 reviewed standing: ' + subject)\n    require(phase['predecessors']['members'] == {name: reviews[name] for name in CHUNKS},\n            'phase review did not consume these exact four audited member reviews')\n    if carry:\n        require(phase['predecessors']['member_review_carry'] == carry['proof']\n                and phase['predecessors']['member_dispositions'] == {\n                    name: 'carried_unaffected' if name in carry['members'] else 'executed' for name in CHUNKS},\n                'phase lost explicit mixed-member qualification proof')\n    else:\n        require(all(row['fingerprints']['source'] == qualified['verified']['source_inventory_sha256']\n                    for row in reviews.values()), 'reviews bind a foreign qualified source')\n    return reviews\n\n\ndef verify(root):\n    \"\"\"Verify immutable historical standing; no current build directory needed.\"\"\"\n    root = Path(root).resolve()\n    path = root / COMPLETION\n    require(path.is_file(), 'P11 promotion requires actual accepted standing: ' + str(COMPLETION))\n    record = read(path)\n    require(record['schema'] == 'airs-desktop/p11-completion-proof/1'\n            and record['controller_complete'] is False, 'P11 standing schema/controller claim')\n    require(record['context']['path'] == str(ACCEPTED / 'historical-context.json'),\n            'P11 standing context is foreign')\n    history = ArchivedP11(root, record['context'])\n    qualified = record['qualification']\n    original = read(bound(root, {'path': qualified['record'], 'sha256': qualified['sha256']}))\n    require(original['schema'] == 'airs-desktop/p11-shared-qualification/1', 'foreign P11 qualification')\n    coverage = read(bound(root, original['coverage']))\n    source_hash = coverage['source_inventory_sha256']\n    source = history.source(source_hash)\n    seal = read(bound(root, original['source']))\n    require(digest(seal['files']) == source_hash, 'original P11 source seal differs')\n    import proof\n    result = proof.verify_coverage(root, coverage, historical=history)\n    require(result == qualified['verified'], 'archived P11 raw qualification differs')\n    candidate = read(bound(root, coverage['candidate']))\n    from candidate import verify_candidate\n    verify_candidate(root, candidate, historical=history)\n    require(coverage['candidate']['sha256'] == qualified['candidate_sha256'],\n            'P11 accepted candidate reference differs')\n    if 'review_remediation' not in original:\n        proof.validate_execution(root, read(bound(root, original['native_execution'])), candidate,\n            acceptance=bound(root, original['native_acceptance']) if 'native_acceptance' in original else None,\n            execution=bound(root, original['native_execution']))\n    inventory = read(bound(root, record['evidence']))['files']\n    require(inventory, 'P11 raw evidence inventory missing')\n    require(set(inventory) == {str(p.relative_to(root)) for p in evidence_files(root, record['attempts'])},\n            'P11 retained evidence membership differs')\n    for name, identity in inventory.items():\n        target = root / name\n        require(target.resolve().is_relative_to(root), 'P11 evidence escapes checkout')\n        require(file_identity(target) == identity,\n                'P11 retained evidence drift (hydrate pinned LFS objects if needed): ' + name)\n    reviews = audited_reviews(root, record['attempts'], qualified, source)\n    require(reviews == record['reviews'], 'P11 audited review standing changed')\n    baseline = release_prerequisites(root)\n    require(record['historical_standing'] == original['historical_standing'] == baseline,\n            'P11 historical baseline standing differs')\n    return {'schema': 'airs-desktop/p11-promotion-prerequisites/1',\n            'record': str(COMPLETION), 'sha256': sha(path),\n            'qualification': qualified, 'reviews': reviews, 'controller_complete': False}\n\n\n{\n  \"request_id\": \"C48-attempt-03-1793832805\",\n  \"attempt_id\": \"attempt-03\",\n  \"subject\": \"C48\",\n  \"fingerprints\": {\n    \"source\": \"74569d24e8bbbaf1da407dba48cd6d3794e34e3c23315bb63dbd0abb86951a57\",\n    \"dependencies\": \"2c489f82dc23ebf9680a9cb5977071253b226b29c8f019f1fb43db4ff3384326\",\n    \"build_flags\": \"2b29a1e96f4c6f878a15a50ae4e202d789ff6d5c93a7519fc8c3e2e32e06d432\",\n    \"evidence\": \"abe2ec878605efed7f65cc81880ace8115ebb744768748286e665d5d97f48802\"\n  },\n  \"scores\": {\n    \"architecture\": 9,\n    \"behavior\": 9,\n    \"authority_security\": 9,\n    \"validation\": 9,\n    \"overall\": 9\n  },\n  \"required_fixes\": [],\n  \"blockers\": [],\n  \"evidence_gaps\": [],\n  \"optional_suggestions\": [],\n  \"limitations\": [\n    \"Read-only review. No source changes, builds, application test suites, UI actions, external services, credential access or permission changes were performed. Only inventory, coverage and artifact validators executed.\",\n    \"All 1,211 source and 7,425 evidence entries matched. Source fingerprints, 660 application build inputs, current executable, complete bundle and helper bindings verified. Coverage validation passed all 41 requirements: six executed and 35 carried unaffected.\",\n    \"The prior recovery finding is addressed. The bounded carry is justified for unchanged editor, footer, tabs, Save/Send and picker behavior. Earlier eight-test recovery evidence and the final four-test follow-up retain distinct source bindings; current native recovery binds build08. Historical failures and cleanup corrections remain explicit.\",\n    \"This verdict consumes qualification-final-04 for C48 only. Prior C46/C47/C49 reviews require their separate explicit carry proof at phase review; they are not reissued by this verdict.\",\n    \"controller_complete remains false. Historical C30/C41 owner standing remains distinct. P11 phase review, C26 stable installed/live acceptance and Linux first-platform qualification remain open.\"\n  ],\n  \"inspected_files\": [\n    \"docs/architecture/review-verdict.schema.json\",\n    \"docs/architecture/checks.json\",\n    \"docs/architecture/native-checks.json\",\n    \"docs/planning/reviews/C48/attempt-03/request.json\",\n    \"docs/planning/reviews/C48/attempt-03/source-inventory.json\",\n    \"docs/planning/reviews/C48/attempt-03/evidence-inventory.json\",\n    \"docs/planning/reviews/C48/attempt-02/verdict-returned.json\",\n    \"docs/planning/chunks/C48.md\",\n    \"docs/planning/refinements/2026-11-04/plan.md\",\n    \"docs/planning/refinements/2026-11-04/verification.md\",\n    \"docs/planning/refinements/2026-11-04/execution.md\",\n    \"docs/planning/verification-policy.md\",\n    \"apps/desktop/package.json\",\n    \"apps/desktop/src/app.tsx\",\n    \"apps/desktop/src/v2/store.ts\",\n    \"apps/desktop/src/v2/v2-shell.tsx\",\n    \"apps/desktop/src/v2/workbench/api-client.tsx\",\n    \"apps/desktop/src/v2/workbench/api-client.test.tsx\",\n    \"apps/desktop/src/v2/workbench/json-presentation.tsx\",\n    \"apps/desktop/sr