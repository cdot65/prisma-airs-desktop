use std::sync::Arc;\n\nuse desktop_core::ImportError;\nuse desktop_core::avatar::MAX_SOURCE_BYTES;\n/// A bounded generic file read; current collection formats are unchanged.\nconst MAX_PICKED_FILE_BYTES: usize = 1024 * 1024;\nuse desktop_core::store::{AppStore, FileStore, UnavailableStore};\nuse desktop_core::vault::UnavailableVault;\nuse desktop_core::{\n    Adapters, CredentialStore, FileSaver, FolderPicker, ImagePicker, ImportFile, ImportPicker,\n    PagePrinter, UrlOpener,\n};\nuse futures_util::future::BoxFuture;\nuse tauri::{AppHandle, Manager, Runtime};\nuse zeroize::Zeroizing;\n\nuse crate::MAIN_WINDOW;\n\n/// The fixture test keychain's file name inside the fixture data root.\npub const FIXTURE_KEYCHAIN: &str = \"fixture-credentials.keychain-db\";\n/// The fixture test keychain's password. It protects only synthetic fixture\n/// credentials in a keychain that exists solely for acceptance runs.\npub const FIXTURE_KEYCHAIN_PASSWORD: &str = \"prisma-airs-desktop-v2-fixture-keychain\";\n/// Builds the production adapters for the app's data root.\npub fn production<R: Runtime>(app: &AppHandle<R>) -> Adapters {\n    let candidate_root = app.path().app_data_dir().ok();\n    // An unavailable, symlinked or already leased root authorizes no other\n    // file adapter. In particular it must not open a fixture keychain or\n    // private subdirectory through a rejected root.\n    let opened = candidate_root\n        .as_deref()\n        .and_then(|dir| FileStore::open(dir).ok());\n    let root = opened.as_ref().and(candidate_root);\n    let store: Arc<dyn AppStore> = opened\n        .map(|s| Arc::new(s) as Arc<dyn AppStore>)\n        .unwrap_or_else(|| Arc::new(UnavailableStore));\n    Adapters {\n        keychain: credential_store(root.as_deref()),\n        learner_keychain: learner_store(root.as_deref()),\n        store,\n        opener: opener(root.as_deref()),\n        printer: printer(app, root.as_deref()),\n        images: images(app, root.as_deref()),\n        confirmer: confirmer(app),\n        secrets: secrets(app),\n        text_files: sheet_picker(\n            root.as_deref(),\n            text_files(app, root.as_deref()),\n            Arc::new(NativeTextPicker { app: app.clone() }),\n        ),\n        offline_root: root.as_ref().map(|r| r.join(\"academy-offline\")),\n        saver: sheet_saver(\n            root.as_deref(),\n            saver(app, root.as_deref()),\n            Arc::new(NativeSaver { app: app.clone() }),\n        ),\n        sessions_root: root.as_ref().map(|r| r.join(\"sessions\")),\n        case_files: sheet_picker(\n            root.as_deref(),\n            case_files(app, root.as_deref()),\n            Arc::new(NativeCasePicker { app: app.clone() }),\n        ),\n        library_root: root.as_ref().map(|r| r.join(\"library\")),\n        folders: folders(app, root.as_deref()),\n        workbench_files: sheet_picker(\n            root.as_deref(),\n            workbench_files(root.as_deref()),\n            Arc::new(NativeExportPicker { app: app.clone() }),\n        ),\n        workbench_root: root.as_ref().map(|r| r.join(\"api-client\")),\n        gateway_files: sheet_picker(\n            root.as_deref(),\n            gateway_files(app, root.as_deref()),\n            Arc::new(NativeUploadPicker { app: app.clone() }),\n        ),\n        harness: harness(app, root.as_deref()),\n        logs_root: logs_root(app, root.as_deref()),\n    }\n}\n\n/// macOS's own logs folder for this app (D051), apart from the work in the\n/// data folder. Fixture builds keep it under their data root, which the\n/// acceptance drivers remove after each run.\n#[cfg(not(feature = \"test-fixtures\"))]\nfn logs_root<R: Runtime>(app: &AppHandle<R>, root: Option<&Path>) -> Option<PathBuf> {\n    root?;\n    app.path().app_log_dir().ok()\n}\n\n#[cfg(feature = \"test-fixtures\")]\nfn logs_root<R: Runtime>(_: &AppHandle<R>, root: Option<&Path>) -> Option<PathBuf> {\n    root.map(|r| r.join(\"fixture-logs\"))\n}\n\n/// The bundled Harness engine (`Contents/Resources/harness/airs-harness`),\n/// its OS launcher and where its ephemeral runtime homes are made. A build\n/// without the engine resource offers no Harness.\nfn harness<R: Runtime>(\n    app: &AppHandle<R>,\n    root: Option<&Path>,\n) -> desktop_core::harness::sidecar::HarnessAdapters {\n    use desktop_core::harness::{engine::Engine, sidecar::HarnessAdapters};\n    let engine = app\n        .path()\n        .resource_dir()\n        .ok()\n        .map(|r| {\n            r.join(\"harness\")\n                .join(desktop_core::harness::engine::pin().executable)\n        })\n        .and_then(|p| p.canonicalize().ok())\n        .filter(|p| p.is_file())\n        .map(|executable| Engine { executable });\n    #[cfg(target_os = \"macos\")]\n    let launcher: Arc<dyn desktop_core::harness::sidecar::SidecarLauncher> =\n        Arc::new(crate::sidecar::OsLauncher);\n    #[cfg(not(target_os = \"macos\"))]\n    let launcher: Arc<dyn desktop_core::harness::sidecar::SidecarLauncher> =\n        Arc::new(desktop_core::harness::sidecar::UnavailableLauncher);\n    HarnessAdapters {\n        launcher,\n        engine,\n        runtime_root: root.map(|r| r.join(\"harness-runtime\")),\n        history_root: root.map(|r| r.join(\"harness-history\")),\n        #[cfg(feature = \"test-fixtures\")]\n        fixture: None,\n        #[cfg(feature = \"test-fixtures\")]\n        save_gate: None,\n    }\n}\n16:use desktop_core::{AuthorityHandle, Core, CoreConfig, Observation, Refusal, Update, ViewScope};\n28:#[cfg(all(feature = \"test-fixtures\", target_os = \"macos\"))]\n29:pub mod fixture_capture;\n191:/// this with fixture adapters; the app builds its core in `setup`).\n196:/// A core over deterministic fixture adapters, for host tests.\n197:#[cfg(feature = \"test-fixtures\")]\n198:pub fn fixture_core() -> (Core, desktop_core::fixtures::Handles) {\n199:    fixture_core_with(CoreConfig::default())\n202:/// A fixture core with a given configuration (for example the synthetic\n204:#[cfg(feature = \"test-fixtures\")]\n205:pub fn fixture_core_with(config: CoreConfig) -> (Core, desktop_core::fixtures::Handles) {\n206:    let (adapters, handles) = desktop_core::fixtures::adapters();\n233:    if cfg!(feature = \"test-fixtures\") {\n396:            let mut config = CoreConfig {\n398:                workbench_network: if cfg!(feature = \"test-fixtures\") {\n403:                ..CoreConfig::default()\n405:            #[cfg(feature = \"test-fixtures\")]\n406:            if let Some(origin) = adapters::fixture_academy_origin(app.handle()) {\n409:            #[cfg(feature = \"test-fixtures\")]\n410:            if let Some(origin) = adapters::fixture_management_origin(app.handle()) {\n412:                    desktop_core::management::ManagementEndpoints::at_origin(&origin);\n414:            #[cfg(feature = \"test-fixtures\")]\n415:            if let Some(catalog) = adapters::fixture_case_catalog(app.handle()) {\n419:            #[cfg(feature = \"test-fixtures\")]\n420:            if let Some(policy) = adapters::fixture_transport(app.handle()) {\nimport type {\n    ExportFailure,\n    FieldProblem,\n    RenderProblem,\n    RunFailure,\n    RunRecord,\n    SaveRefusal,\n    SendRefusal,\n    WorkbenchProblem,\n    WorkbenchRequest,\n    WorkbenchResult,\n} from '@prisma-airs/desktop-contracts'\nimport { type Dispatch, outcomeMessage } from '../tenants/dispatch'\n\n/** Waits for the single result of an admitted API Client request. */\nexport type ObserveWorkbench = (operation: string) => Promise<WorkbenchResult>\n\n/** One API Client request: its result, or why it never ran. */\nexport type WorkbenchCall = (request: WorkbenchRequest) => Promise<WorkbenchResult | { kind: 'undelivered'; message: string }>\n\nexport function workbenchCall(dispatch: Dispatch, observe: ObserveWorkbench): WorkbenchCall {\n    return async (request) => {\n        const outcome = await dispatch({ kind: 'workbench', request })\n        if (outcome.kind !== 'admitted' || outcome.operation === null) {\n            return { kind: 'undelivered', message: outcomeMessage(outcome) ?? 'The request could not be delivered.' }\n        }\n        try {\n            return await observe(outcome.operation)\n        } catch {\n            return { kind: 'undelivered', message: 'The desktop did not report how the request ended. Check the request before trying again.' }\n        }\n    }\n}\n\nconst FIELD_TEXT: Record<FieldProblem['field'], string> = {\n    method: 'Method: use letters and hyphens only',\n    url: 'URL: enter one line',\n    headers: 'Headers: use Name: value',\n    query: 'Params: use name=value',\n    body: 'Body: this body cannot be written as text here',\n    bodyKind: 'Body kind',\n    settings: 'Auth and variables: only [auth] with references and [variables] are written',\n}\n\nexport function fieldText(problem: FieldProblem): string {\n    return problem.line === null ? FIELD_TEXT[problem.field] : `${FIELD_TEXT[problem.field]} (line ${problem.line})`\n}\n\nconst REFUSAL_TEXT: Record<Exclude<SaveRefusal['kind'], 'invalid'>, string> = {\n    conflict: 'Changed on disk since you opened it. Choose Use disk or Keep mine; both versions are kept privately first.',\n    incomplete: 'The collection changed or has problems to fix before saving.',\n    moved: 'This request was moved to another file. Reopen the collection.',\n    sharedBody: 'Another request now uses this body file; it was not changed.',\n    interrupted: 'An earlier save of this request was interrupted. Choose Use disk or Keep mine before saving.',\n    exists: 'A file already exists at this path; nothing was replaced.',\n    io: 'The files could not be written. Your edits are kept on this Mac.',\n}\n\nexport function saveRefusalText(refusal: SaveRefusal): string {\n    return refusal.kind === 'invalid' ? `Fix to save. ${fieldText(refusal.problem)}.` : REFUSAL_TEXT[refusal.kind]\n}\n\nconst DETAIL_TEXT: Record<string, string> = {\n    notCollection: \"That folder isn't empty and has no API Client collection (collection.toml). Choose an empty folder or a collection folder.\",\n    badPath: 'Use a path inside the collection: folder/name, no leading dot, slash or \"..\".',\n    exists: 'Something already exists there; nothing was replaced.',\n    notInRepository: 'Create a collection inside an existing Git repository.',\n    incomplete: 'Fix the collection problems listed first.',\n    missing: 'That file is missing.',\n    tooLarge: 'That file is larger than the limit.',\n    io: 'The file could not be read or written.',\n    locked: 'The Keychain is locked. Unlock it and try again.',\n    denied: 'macOS denied Keychain access.',\n    unavailable: 'Private API Client storage is unavailable.',\n    unreadable: 'Saved private API Client data did not open; it was kept aside.',\n    notText: 'Schemas are JSON or YAML text up to 4 MiB.',\n    conflict: 'Changed on disk since it was opened; reopen it.',\n    version: 'Only Insomnia v5 exports (schema 5.1) are supported.',\n    structure: 'The export has fields this import does not take.',\n    limit: 'The export has more resources or nesting than the import takes.',\n}\n\nconst CURL_TEXT: Record<string, string> = {\n    tooLarge: 'The command is larger than 1 MiB.',\n    notCurl: 'Paste one command that begins with curl.',\n    shell: 'Shell expansion, operators and comments are not supported; quote literal values.',\n    unclosed: 'A quote or escape is not closed.',\n    tooManyWords: 'The command has too many arguments.',\n    unsupportedOption: 'The command uses an option this import does not support.',\n    missingArgument: 'An option is missing its value.',\n    url: 'Give exactly one absolute http(s) URL.',\n    urlCredentials: 'Move credentials out of the URL before importing.',\n    queryCredentials: 'Move credential query parameters to a secret before importing.',\n    glob: 'URL glob expressions are not supported.',\n    template: 'Template syntax is not imported