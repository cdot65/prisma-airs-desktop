e/P10/completion-proof.json\", \"sha256\": \"8c419736c23462daeb7346d5f5ca9f6a0659d297bb4c570581cab69fddd1b806\"}\nhistorical_standing {\"p09\": {\"subject\": \"P09\", \"attempt\": \"attempt-02\", \"request_sha256\": \"866c77d4bd484cf9878cfc9ccd89d808153e6c3bb9738f14ca572eeff0960ec9\", \"verdict_sha256\": \"6a0677e997c3112fdaf04e8eda3c4d7619719aa457590fa797bac9bd340fd0e2\", \"audit_sha256\": \"e9ca3aa0fdc996e9b9a2961ba50cc2a53bb15e593cd403d8559b13d28c39c400\", \"receipt_sha256\": \"16cf4e88f0e0975f06ccdccfd2d0af369760aca650398a08143461425cccf10d\", \"scores\": {\"architecture\": 9, \"behavior\": 9, \"authority_security\": 9, \"validation\": 9, \"overall\": 9}, \"fingerprints\": {\"source\": \"d8671203522596d4460eafa9f622696494c471d469d1ab321177db6fb9f1e253\", \"dependencies\": \"5d7e1ee69e4ea217b57a2d9d2cfde8fbdd33739719fd870f3f9f9f5d984a52b2\", \"build_flags\": \"166488b352224eb230ddfca178064d76f43deecbb6c73fb6d9359f56632e1a1f\", \"evidence\": \"fce4adbd792aad81e9066f7d2a9921901799e788462fc501e4061ea0b460676f\"}}, \"p10\": {\"subject\": \"P10\", \"attempt\": \"attempt-01\", \"request_\nreview_remediation {\"path\": \"docs/planning/evidence/P11/remediation-selection-03/receipt.json\", \"sha256\": \"a90c97f681424c98067e654d011daf1faea282f1360ec979f74599e9d3e6e6d7\"}\ncontroller_complete false\nhistorical_use \"Original qualification02 results/artifacts remain bound. Only explicit affected source selectors and native recovery execute anew; unrelated results retain original process/source/artifact provenance.\"\ndocs/planning/evidence/P11/member-review-carry-01/receipt.json\nschema \"airs-desktop/p11-member-review-carry/1\"\nrecorded_utc \"2026-11-04T22:49:09.066254+00:00\"\noriginal_qualification {\"record\": \"docs/planning/evidence/P11/qualification-final-03/qualification.json\", \"sha256\": \"21eb4c44168ce7ce5cd3e01484399fba397b788176e310e5d15df696cebbb218\", \"verified\": {\"qualified\": true, \"required\": 41, \"dispositions\": {\"carried_unaffected\": 35, \"executed\": 6}, \"candidate_sha256\": \"c319afc16976f7094136837f93bcab6936dc137e2b7cd974403949c88c01e458\", \"source_inventory_sha256\": \"ab37b2720a2eea849c06ca93750be8e0e7984c49fb90380d465300f65cc1dec5\"}, \"candidate_sha256\": \"c319afc16976f7094136837f93bcab6936dc137e2b7cd974403949c88c01e458\", \"controller_complete\": false}\ncurrent_qualification {\"record\": \"docs/planning/evidence/P11/qualification-final-04/qualification.json\", \"sha256\": \"e34765810f58717392047ffe1a252628534dd5bec213fc1a6775016e93f64231\", \"verified\": {\"qualified\": true, \"required\": 41, \"dispositions\": {\"carried_unaffected\": 35, \"executed\": 6}, \"candidate_sha256\": \"26ee8f126d0b1b8c96e3d0f297cde5517379730c3c1557cc524c9795ec6d11f2\", \"source_inventory_sha256\": \"74569d24e8bbbaf1da407dba48cd6d3794e34e3c23315bb63dbd0abb86951a57\"}, \"candidate_sha256\": \"26ee8f126d0b1b8c96e3d0f297cde5517379730c3c1557cc524c9795ec6d11f2\", \"controller_complete\": false}\noriginal_source {\"path\": \"docs/planning/evidence/P11/remediation-selection-02/source-current.json\", \"sha256\": \"802017c8632e05febf7c7f047f249e79b23e20c37e1260492095e15194b3916e\"}\ncurrent_source {\"path\": \"docs/planning/evidence/P11/remediation-selection-03/source-current.json\", \"sha256\": \"ba1b15f1b1f8f33423531c1ecedd005bf98d1ed558b2a1373fee2e92320a0545\"}\noriginal_source_archive \"docs/planning/evidence/P11/source-history/S4\"\noriginal_application \"docs/planning/evidence/P11/review-carry-baseline-01/application\"\napplication_preservation {\"path\": \"docs/planning/evidence/P11/review-carry-baseline-01/application-preservation.json\", \"sha256\": \"745d8f6b9ae307cdaededd886e7b98f4746b014564390158473ab95690646515\"}\nchanged_paths [\".gitattributes\", \"apps/desktop/src/v2/store.ts\", \"apps/desktop/src/v2/workbench/api-client.test.tsx\", \"apps/desktop/src/v2/workbench/api-client.tsx\", \"docs/planning/refinements/2026-11-04/execution.md\", \"tools/p11/README.md\", \"tools/p11/remediation.py\", \"tools/p11/review