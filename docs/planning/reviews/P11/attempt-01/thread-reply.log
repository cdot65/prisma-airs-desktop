s\": {\"mode\": 420, \"kind\": \"file\", \"sha256\": \"f28e37e8667cbe\nmembers {\"C46\": {\"review\": {\"subject\": \"C46\", \"attempt\": \"attempt-02\", \"request_sha256\": \"cf131db66cdac35e824f01e06ad5a05d39a42f502e862cb8d1186827e8a20f3a\", \"verdict_sha256\": \"002ee808931223db7a4f885abc5817c17750cf59cb3f2a124b17e90b13ed23d0\", \"audit_sha256\": \"5b1c7020785b05555956c74c0d7f4fce424e86f5b287e0c674274706b4993f0b\", \"receipt_sha256\": \"2474d974a2f7148646551b2f76a85315aa9b7f2ffe925038629f76d777529751\", \"scores\": {\"architecture\": 9, \"behavior\": 9, \"authority_security\": 9, \"validation\": 9, \"overall\": 9}, \"fingerprints\": {\"source\": \"ab37b2720a2eea849c06ca93750be8e0e7984c49fb90380d465300f65cc1dec5\", \"dependencies\": \"2c489f82dc23ebf9680a9cb5977071253b226b29c8f019f1fb43db4ff3384326\", \"build_flags\": \"2b29a1e96f4c6f878a15a50ae4e202d789ff6d5c93a7519fc8c3e2e32e06d432\", \"evidence\": \"479874685c5f74764deb4701d2a999f142c2e63f852fb38289e87710477cb37a\"}}, \"reason\": \"The exact three-file delta changes onl\nlimitations [\"Original C46/C47/C49 source/qualification/app/review/audit/transport bindings and scores are verbatim. No old review was rerun, rescored or relabelled current.\", \"C48 attempt03 and P11 phase must be fresh actual full-nine reviews on qualification04. The phase explicitly reviews current source/integration/carry logic.\", \"Fixture-only signing/access admission changes are separately recorded by the current qualification; no original OS condition or old artifact is claimed identical to the current app.\"]\n","exit_code":0,"status":"completed"}}
