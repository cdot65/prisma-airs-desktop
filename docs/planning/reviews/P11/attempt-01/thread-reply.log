{"type":"item.completed","item":{"id":"item_37","type":"command_execution","command":"/bin/zsh -lc \"sed -n '160,273p' crates/xtask/src/fingerprint.rs; sed -n '1,140p' tools/p11/test_review_carry.py; sed -n '176,274p' tools/p11/standing.py\"","aggregated_output":"            if skip.iter().any(|name| child.file_name() == *name) {\n                continue;\n            }\n            collect_tree(root, &path, skip, out)?;\n        } else {\n            out.push(file_entry(root, &relative)?);\n        }\n    }\n    Ok(())\n}\n\n/// Dependency inputs: lockfiles, toolchain pin, immutable inputs, tools.\npub fn dependencies(repo: &Repo, toolchain_hash: &str) -> Result<String> {\n    let mut parts: BTreeMap<String, String> = BTreeMap::new();\n    for file in [\n        \"Cargo.lock\",\n        \"pnpm-lock.yaml\",\n        \"rust-toolchain.toml\",\n        \".npmrc\",\n        \"docs/architecture/inputs.lock.json\",\n    ] {\n        let path = repo.join(file);\n        let digest = match std::fs::read(&path) {\n            Ok(bytes) => sha256_hex(&bytes),\n            Err(_) => \"absent\".to_owned(),\n        };\n        parts.insert(file.to_owned(), digest);\n    }\n    let inputs = repo.join(\".inputs\");\n    if inputs.is_dir() {\n        let mut names: Vec<_> = std::fs::read_dir(&inputs)\n            .map_err(io_err(&inputs))?\n            .filter_map(|e| e.ok())\n            .filter(|e| e.path().is_dir())\n            .map(|e| e.file_name().to_string_lossy().into_owned())\n            .collect();\n        names.sort();\n        for name in names {\n            parts.insert(format!(\".inputs/{name}\"), tree_hash(&inputs.join(&name))?);\n        }\n    }\n    for (label, hash) in consumed_shared(repo)? {\n        parts.insert(label, hash);\n    }\n    parts.insert(\"toolchain\".to_owned(), toolchain_hash.to_owned());\n    Ok(sha256_hex(\n        serde_json::to_string(&parts).unwrap_or_default().as_bytes(),\n    ))\n}\n\n/// Build flags: the subject's manifest entries and native configuration,\n/// as canonical JSON (sorted keys, compact) so independent tools can\n/// recompute it.\npub fn build_flags(repo: &Repo, manifest: &Manifest, subject: Subject) -> Result<String> {\n    use serde_json::{Value, json};\n    let mut parts: BTreeMap<String, Value> = BTreeMap::new();\n    let chunks = if subject.is_phase() {\n        manifest.phase_chunks(subject)?\n    } else {\n        vec![subject]\n    };\n    for chunk in chunks {\n        let entry = manifest.chunk(chunk)?;\n        let mut flags = json!({\n            \"fixture\": entry.fixture_command,\n            \"frontend\": entry.frontend_commands,\n            \"host\": entry.host_commands,\n            \"native_prepare\": entry.native_prepare,\n        });\n        // Keep historical canonical objects byte-for-byte equivalent. Only\n        // new chunks bind the D063 selected check list.\n        if let Some(selected) = &entry.check_commands {\n            flags[\"checks\"] = json!(selected);\n        }\n        parts.insert(format!(\"chunk/{chunk}\"), flags);\n    }\n    parts.insert(\"setup\".to_owned(), json!(manifest.setup_commands));\n    parts.insert(\n        \"phase_native\".to_owned(),\n        json!(manifest.phase_native_prepare),\n    );\n    parts.insert(\"common\".to_owned(), json!(manifest.common_commands));\n    parts.insert(\"shared\".to_owned(), json!(manifest.shared_source_commands));\n    parts.insert(\"artifact\".to_owned(), json!(manifest.artifact_build));\n    parts.insert(\"target\".to_owned(), json!(manifest.target));\n    parts.insert(\n        \"fixture_only\".to_owned(),\n        json!(manifest.fixture_only_features),\n    );\n    parts.insert(\n        \"production_features\".to_owned(),\n        json!(manifest.requested_production_features),\n    );\n    for file in BUILD_FLAG_FILES {\n        let digest = std::fs::read(repo.join(file))\n            .map(|b| sha256_hex(&b))\n            .unwrap_or_else(|_| \"absent\".to_owned());\n        parts.insert(file.to_owned(), json!(digest));\n    }\n    Ok(sha256_hex(\n        serde_json::to_string(&parts).unwrap_or_default().as_bytes(),\n    ))\n}\n\n/// Native configuration files whose bytes are part of the build flags.\npub const BUILD_FLAG_FILES: [&str; 7] = [\n    \"apps/desktop/src-tauri/tauri.conf.json\",\n    \"apps/desktop/src-tauri/tauri.fixture.conf.json\",\n    \"apps/desktop/src-tauri/tauri.harness.conf.json\",\n    \"apps/desktop/src-tauri/capabilities/main.json\",\n    \"apps/desktop/src-tauri/Cargo.toml\",\n    \"Cargo.toml\",\n    \"docs/architecture/native-checks.json\",\n];\n\"\"\"Pure review-carry adversarial fixtures; never actual review evidence.\"\"\"\nfrom pathlib import Path\nimport copy\nimport json\nimport tempfile\nimport unittest\nfrom unittest.mock import patch\n\nimport review_carry as carry\nimport review\n\n\nclass ReviewCarryTests(unittest.TestCase):\n    def setUp(self):\n        self.temp = tempfile.TemporaryDirectory()\n        self.addCleanup(self.temp.cleanup)\n        self.root = Path(self.temp.name).resolve()\n        self.name = 'apps/desktop/src/v2/workbench/api-client.tsx'\n        self.patch = patch.object(carry, 'RETRY_DELTA', {self.name: ('old', 'new')})\n        self.patch.start(); self.addCleanup(self.patch.stop)\n\n    def test_only_exact_declared_retry_delta_can_carry(self):\n        before = {self.name: {'sha256': 'old'}, 'Cargo.lock': {'sha256': 'same'}}\n        after = {self.name: {'sha256': 'new'}, 'Cargo.lock': {'sha256': 'same'}}\n        self.assertEqual(carry.impact_delta(before, after, [self.name]), [self.name])\n        for kind in ('undeclared', 'different-fix', 'unrelated-behavior', 'configuration', 'deleted'):\n            changed, declared = copy.deepcopy(after), [self.name]\n            if kind == 'undeclared': declared = []\n            elif kind == 'different-fix': changed[self.name]['sha256'] = 'other'\n            elif kind == 'unrelated-behavior':\n                changed['apps/desktop/src/v2/settings.tsx'] = {'sha256': 'other'}\n                declared = sorted([self.name, 'apps/desktop/src/v2/settings.tsx'])\n            elif kind == 'configuration':\n                changed['Cargo.lock']['sha256'] = 'other'; declared = sorted([self.name, 'Cargo.lock'])\n            else: changed.pop(self.name)\n            with self.subTest(kind=kind), self.assertRaises(ValueError):\n                carry.impact_delta(before, changed, declared)\n\n    def test_dependency_closure_keeps_all_resources_and_unmodified_consumers(self):\n        names = [self.name, 'resources/harness/pin', 'resources/another-package.bin',\n                 'apps/desktop/src/app.tsx', 'crates/desktop-core/tests/harness_tools/main.rs',\n                 'packages/desktop-contracts/src/index.ts', 'Cargo.lock']\n        selected = carry.dependencies(dict.fromkeys(names, {}))\n        self.assertNotIn(self.name, selected)\n        self.assertEqual(set(selected), set(names)-{self.name})\n        files = {n: {'sha256': 'unchanged-'+n} for n in names}\n        identities = {n: files[n] for n in selected}\n        carry.unchanged(files, files, selected, identities)\n        altered = copy.deepcopy(files); altered['resources/another-package.bin']['sha256'] = 'changed'\n        with self.assertRaises(ValueError): carry.unchanged(files, altered, selected, identities)\n        with self.assertRaises(ValueError): carry.unchanged(files, files, selected[:-1], identities)\n\n    def test_qualification_and_subject_set_are_bound(self):\n        qualified = {'record': 'fixture-current', 'verified': {'qualified': True}}\n        original = {'record': carry.OLD_QUALIFICATION, 'sha256': carry.OLD_QUALIFICATION_SHA}\n        record = {'schema': 'airs-desktop/p11-member-review-carry/1',\n                  'members': dict.fromkeys(carry.CARRIED, {}), 'current_qualification': qualified,\n                  'original_qualification': original}\n        self.assertEqual(carry.qualification_bindings(record, qualified), original)\n        for kind in ('affected-subject', 'phase-subject', 'old-qualification', 'current-qualification', 'unqualified'):\n            altered = copy.deepcopy(record)\n            if kind == 'affected-subject': altered['members']['C48'] = altered['members'].pop('C49')\n            elif kind == 'phase-subject': altered['members']['P11'] = altered['members'].pop('C49')\n            elif kind == 'old-qualification': altered['original_qualification']['sha256'] = 'foreign'\n            elif kind == 'current-qualification': altered['current_qualification']['record'] = 'foreign'\n            else: altered['current_qualification']['verified']['qualified'] = False\n            with self.subTest(kind=kind), self.assertRaises(ValueError):\n                carry.qualification_bindings(altered, qualified)\n\n    def test_original_full_nine_member_cannot_be_rescored_or_retargeted(self):\n        qualification = {'record': 'fixture-original-qualification'}\n        scores = dict.fromkeys(('architecture', 'behavior', 'authority_security', 'validation', 'overall'), 9)\n        original = {'subject': 'C46', 'attempt': 'attempt-02', 'scores': scores,\n                    'verdict_sha256': 'fixture-original-verdict'}\n        entry = {'review': original, 'reason': 'Pure validator fixture: scoped C48-only retry change.'}\n        folder = self.root/'docs/planning/reviews/C46/attempt-02'; folder.mkdir(parents=True)\n        request = {'subject': 'C46', 'qualification': qualification}\n        def save(value): (folder/'request.json').write_text(json.dumps(value))\n        save(request)\n        with patch.object(carry, 'actual_review', return_value=original) as actual:\n            self.assertEqual(carry.member(self.root, 'C46', entry, qualification, self.root/'old-source'), original)\n            self.assertFalse(actual.call_args.kwargs['evidence'])\n        for kind in ('C48', 'P11', 'wrong-subject', 'wrong-qualification', 'changed-original', 'score-eight'):\n            altered, outcome, subject = copy.deepcopy(entry), copy.deepcopy(original), 'C46'; save(request)\n            if kind in ('C48', 'P11'): subject = kind\n            elif kind == 'wrong-subject': altered['review']['subject'] = 'C47'\n            elif kind == 'wrong-qualification': save(dict(request, qualification={'record': 'foreign'}))\n            elif kind == 'changed-original': outcome['verdict_sha256'] = 'changed'\n            else: altered['review']['scores']['overall'] = outcome['scores']['overall'] = 8\n            with self.subTest(kind=kind), patch.object(carry, 'actual_review', return_value=outcome), self.assertRaises(ValueError):\n                carry.member(self.root, subject, altered, qualification, self.root/'old-source')\n\n    def test_phase_packet_describes_mixed_original_members_without_retagging(self):\n        # Temporary metadata-only fixture; no actual review/qualification is fabricated.\n        folder = self.root/'docs/planning/evidence/P11'; folder.mkdir(parents=True)\n        qualified = {'record': 'fixture-qualified', 'meaning': 'pure validator fixture'}\n        qualification = self.root/'qualification.json'\n        qualification.write_text(json.dumps({'runner_inputs': {'dependencies': 'fixture', 'build_flags': 'fixture'}}))\n        carry_path = self.root/'carry.json'; carry_path.write_text('pure validator fixture')\n        with patch.object(review.proof, 'verify', return_value=qualified), \\\n             patch.object(review, 'predecessors', return_value={'meaning': 'pure predecessor fixture'}), \\\n             patch.object(review.proof, 'source_inventory', return_value={}), \\\n             patch.object(review.subprocess, 'run'):\n            request = review.make(self.root, 'P11', 'attempt-01', qualification, review_carry=carry_path)\n        message = (self.root/'docs/planning/reviews/P11/attempt-01/message.txt').read_text()\n        self.assertEqual(request['review_carry'], review.proof.reference(self.root, carry_path))\n        self.assertIn('qualification03', request['limitations'][1])\n        self.assertIn('three explicitly carried original qualification03', message)\n        self.assertIn('do not relabel those members current', message)\n\n\nif __name__ == '__main__':\n    unittest.main()\ndef finalize(root, qualification_path, attempts):\n    \"\"\"Archive only after actual reviews; refuse every existing output path.\n\n    Large files under accepted/application and accepted/source/resources/harness\n    must have their reviewed explicit Git LFS rules before the qualified seal.\n    This function never runs a test, native driver, build, signing or publication.\n    \"\"\"\n    root = Path(root).resolve()\n    destination, completion = root / ACCEPTED, root / COMPLETION\n    require(not destination.exists() and not completion.exists(), 'preserve existing accepted P11 archive')\n    require_archive_lfs(root)\n    import proof\n    qualified = proof.verify(root, Path(qualification_path).resolve())\n    reviews = audited_reviews(root, attempts, qualified, root)\n    original = read(root / qualified['record'])\n    seal = read(bound(root, original['source']))\n    coverage = read(bound(root, original['coverage']))\n    candidate = read(bound(root, coverage['candidate']))\n    prepared = read(bound(root, candidate['prepare']))\n    evidence = identities(root, evidence_files(root, attempts))\n    destination.mkdir(parents=True, exist_ok=False)\n\n    def write(name, value):\n        path = destination / name\n        with path.open('x') as stream:\n            json.dump(value, stream, indent=2)\n            stream.write('\\n')\n        return reference(root, path)\n\n    source = destination / 'source'\n    source.mkdir()\n    for name, identity in seal['files'].items():\n        original_file, archived = root / name, source / name\n        require(original_file.resolve().is_relative_to(root) or original_file.is_symlink(),\n                'source path escapes checkout')\n        require(archived.resolve().is_relative_to(source), 'source archive path escapes destination')\n        archived.parent.mkdir(parents=True, exist_ok=True)\n        if identity['kind'] == 'symlink':\n            archived.symlink_to(identity['target'])\n        else:\n            shutil.copy2(original_file, archived)\n        require(file_identity(archived) == identity, 'source changed while archiving: ' + name)\n    application = destination / 'application'\n    shutil.copytree(root / prepared['bundle'], application, symlinks=True)\n    require(bundle_hash(application) == candidate['bundle_sha256'], 'application changed while archiving')\n    source_seal = write('source-seal.json', seal)\n    sources = {coverage['source_inventory_sha256']: {\n        'path': str(source.relative_to(root)), 'seal': source_seal}}\n    if 'impact_selection' in original:\n        impact = read(bound(root, original['impact_selection']))\n        baseline = read(bound(root, impact['baseline_source']))\n        sources[digest(baseline['files'])] = {\n            'path': str(D2_SOURCE), 'seal': impact['baseline_source']}\n    if 'helper_source_carry' in original:\n        helper = read(bound(root, original['helper_source_carry']))\n        baseline = read(bound(root, helper['baseline_source']))\n        sources[digest(baseline['files'])] = {\n            'path': str(S2_SOURCE), 'seal': helper['baseline_source']}\n    if 'review_remediation' in original:\n        remedy = read(bound(root, original['review_remediation']))\n        prior = read(bound(root, remedy['historical_context']))\n        for fingerprint, value in prior['sources'].items():\n            require(fingerprint not in sources or sources[fingerprint] == value,\n                    'remediation historical source conflicts with accepted source')\n            sources[fingerprint] = value\n    applications = {candidate['bundle_sha256']: {\n        'path': str(application.relative_to(root)), 'executable_sha256': candidate['executable_sha256']}}\n    phase = read(root / 'docs/planning/reviews/P11' / attempts['P11'] / 'request.json')\n    if 'review_carry' in phase:\n        carry = read(bound(root, phase['review_carry']))\n        old_source = read(bound(root, carry['original_source']))\n        sources[digest(old_source['files'])] = {'path': str(S4_SOURCE), 'seal': carry['original_source']}\n        old_q = read(bound(root, {'path': carry['original_qualification']['record'],\n                                 'sha256': carry['original_qualification']['sha256']}))\n        old_coverage = read(bound(root, old_q['coverage']))\n        old_candidate = read(bound(root, old_coverage['candidate']))\n        applications[old_candidate['bundle_sha256']] = {\n            'path': str(S4_APPLICATION), 'executable_sha256': old_candidate['executable_sha256']}\n    context = write('historical-context.json', {\n        'schema': 'airs-desktop/historical-qualification-context/1',\n        'sources': sources,\n        'applications': applications})\n    evidence_ref = write('evidence-inventory.json', {'files': evidence})\n    record = {'schema': 'airs-desktop/p11-completion-proof/1',\n              'qualification': qualified, 'attempts': attempts, 'reviews': reviews,\n              'context': context, 'evidence': evidence_ref,\n              'historical_standing': original['historical_standing'],\n              'controller_complete': False,\n              'meaning': ('Actual full-nine C48/current phase plus explicitly carried original qualification03 C46/C47/C49 full-nine reviews. No old review is relabelled current. ' if 'review_carry' in phase else 'Actual audited full-nine members and phase on one qualification. ') + 'Historical sources, candidates, artifacts and raw outcomes remain bound; no controller ledger or production acceptance is claimed.'}\n    with completion.open('x') as stream:\n        json.dump(record, stream, indent=2)\n        stream.write('\\n')\n    return verify(root)\n\n\nif __name__ == '__main__':\n    require(sys.argv[1:] == ['release-prerequisites'],\n            'usage: standing.py release-prerequisites; finalize is an explicit API after actual reviews')\n    print(json.dumps(verify(Path.cwd()), indent=2))\n","exit_code":0,"status":"completed"}}
