ent).map_err(io_err(parent))?;\n    }\n    let mut file = std::fs::OpenOptions::new()\n        .create(true)\n        .append(true)\n        .open(path)\n        .map_err(io_err(path))?;\n    writeln!(file, \"{line}\").map_err(io_err(path))\n}\n\n/// The latest completion generation of a subject and its entry.\nfn latest_completion(entries: &[Entry], subject: Subject) -> Option<&Entry> {\n    let id = subject.to_string();\n    entries\n        .iter()\n        .filter(|e| matches!(e, Entry::Completion { subject, .. } if *subject == id))\n        .max_by_key(|e| match e {\n            Entry::Completion { generation, .. } => *generation,\n            _ => 0,\n        })\n}\n\nfn highest_generation(entries: &[Entry], subject: Subject) -> u32 {\n    let id = subject.to_string();\n    entries\n        .iter()\n        .filter_map(|e| match e {\n            Entry::Completion {\n                subject,\n                generation,\n                ..\n            } if *subject == id => Some(*generation),\n            _ => None,\n        })\n        .max()\n        .unwrap_or(0)\n}\n    if owner_accept.is_some_and(|r| r.trim().is_empty()) {\n        return Err(invalid(\"--owner-accept needs the owner's reason\"));\n    }\n    // D034: chunks may complete at 8/10; phases and documentation-only\n    // chunks (D058) always need the full gate.\n    if owner_accept.is_some() {\n        owner_acceptance_allowed(manifest, subject)?;\n    }\n    if let Subject::Phase(_) = subject {\n        let entries = read_ledger(&repo.completion_ledger())?;\n        // D034: every chunk accepted below 9 is raised before sign-off.\n        let below: Vec<String> = manifest\n            .phase_chunks(subject)?\n            .into_iter()\n            .filter(|c| owner_accepted(&entries, *c))\n            .map(|c| c.to_string())\n            .collect();\n        if !below.is_empty() {\n            return Err(invalid(format!(\n                \"{subject} cannot complete: {} must first pass a 9/10 review (D034)\",\n                below.join(\", \")\n            )));\n        }\n    }\n    require_predecessors(repo, manifest, subject)?;\n    let ledger = repo.completion_ledger();\n    let entries = read_ledger(&ledger)?;\n    // An owner-accepted chunk may be raised to a passing review as a new\n","exit_code":0,"status":"completed"}}
