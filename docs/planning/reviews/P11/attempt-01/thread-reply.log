{"type":"item.completed","item":{"id":"item_28","type":"command_execution","command":"/bin/zsh -lc \"cat apps/desktop/src/shell/appearance.ts docs/architecture/desktop-themes.md apps/desktop/src/shell/{academy-theme-boundary.test.ts,palette-contrast.test.ts}; sed -n '1,205p' apps/desktop/src/styles/tokens.css; git diff f1e58da5cdeb1c67eed650b186081661cefc2fa2 -- apps/desktop/src/v2/academy/academy.tsx\"","aggregated_output":"import { GENERAL_THEMES, applyThemeAttribute, type GeneralThemeId } from '@ai-security-academy/presentation'\nimport type { ColorTheme, Theme } from '@prisma-airs/desktop-contracts'\n\n/** Maps the desktop preference to a general shared theme (never an earned skin). */\nexport function resolveTheme(theme: Theme, prefersDark: boolean): GeneralThemeId {\n    if (theme === 'light') return GENERAL_THEMES.light\n    if (theme === 'dark') return GENERAL_THEMES.dark\n    return prefersDark ? GENERAL_THEMES.dark : GENERAL_THEMES.light\n}\n\nconst darkQuery = () =>\n    typeof window.matchMedia === 'function'\n        ? window.matchMedia('(prefers-color-scheme: dark)')\n        : null\n\n/** Applies the preference now and follows OS changes while it is `system`. */\nexport function followAppearance(theme: Theme, colorTheme: ColorTheme = 'prismaAirs'): () => void {\n    const query = darkQuery()\n    const apply = () => {\n        const general = resolveTheme(theme, query?.matches ?? true)\n        // Academy keeps its general palette, including portals attached to body.\n        applyThemeAttribute(general)\n        document.documentElement.dataset.appearance = general === GENERAL_THEMES.dark ? 'dark' : 'light'\n        document.documentElement.dataset.colorTheme = colorTheme\n    }\n    apply()\n    if (theme !== 'system' || !query) return () => undefined\n    query.addEventListener('change', apply)\n    return () => query.removeEventListener('change', apply)\n}\n# Desktop color themes\n\nThe desktop owns two independent preferences: appearance (`system`, `light`,\n`dark`) and color theme (`prismaAirs`, `gruvbox`). Prisma AIRS is the default.\nNeither preference updates an Academy account or unlocks an earned cosmetic.\n\nExisting state without `colorTheme` defaults to Prisma AIRS and retains its\nappearance. The default is omitted when saving; an alternate theme is saved as\nan explicit field. Invalid theme values remain a storage error, rather than\nsilently overwriting the preference. Existing atomic storage writes apply.\n\nOlder binaries use strict field validation and can reject state written with a\nnew preference. Opening an upgraded data directory with an older release is\nunsupported; this change does not claim downgrade compatibility or silently\nreset data. Preserve the state before any explicitly requested downgrade.\n\nThe document's general Academy theme continues to follow appearance. Desktop\npalette tokens are independent, and shared presentation colors are adapted only\ninside desktop theme scopes. Academy content and its portals keep the general\nAcademy palette. Earned Academy themes remain under Academy's existing rules.\nimport { afterEach, beforeEach, describe, expect, it } from 'vitest'\nimport tokens from '../styles/tokens.css?raw'\n\n// Inspect the real stylesheet's selector participation. jsdom cannot resolve\n// inherited CSS variables or qualify native computed colors and focus pixels.\nlet stylesheet: HTMLStyleElement\nlet fixture: HTMLDivElement\nlet rules: CSSStyleRule[]\n\nbeforeEach(() => {\n    stylesheet = document.createElement('style')\n    stylesheet.textContent = tokens\n    document.head.append(stylesheet)\n    rules = [...stylesheet.sheet!.cssRules].filter((rule): rule is CSSStyleRule => rule.type === CSSRule.STYLE_RULE)\n    fixture = document.createElement('div')\n    fixture.innerHTML = `\n        <div data-v2-shell>\n            <header data-desktop-theme><button id=\"header\">Explain</button></header>\n            <nav data-desktop-theme><button id=\"rail\" data-inset-focus aria-current=\"page\">Settings</button></nav>\n            <main data-desktop-theme><section class=\"settings-card\">\n                <input id=\"desktop-input\"><select id=\"desktop-select\"><option>Light</option></select>\n                <textarea id=\"desktop-textarea\"></textarea><button id=\"desktop-button\">Save</button>\n            </section></main>\n            <main><section data-slot=\"academy-pages\">\n                <input id=\"academy-input\"><select id=\"academy-select\"><option>General theme</option></select>\n                <textarea id=\"academy-textarea\"></textarea><button id=\"academy-button\">Continue</button>\n            </section></main>\n        </div>\n        <div data-v2-scrim data-desktop-theme><div role=\"dialog\"><input id=\"dialog-input\"><button id=\"dialog-button\">Apply</button></div></div>\n        <div data-slot=\"wizard\" data-desktop-theme><input id=\"wizard-input\"><button id=\"wizard-button\">Continue</button></div>\n        <div data-academy-portal><input id=\"academy-portal-input\"><button id=\"academy-portal-button\">Close</button></div>`\n    document.body.append(fixture)\n})\n\nafterEach(() => {\n    stylesheet.remove()\n    fixture.remove()\n})\n\nfunction desktopRulesFor(id: string, properties: string[]): string[] {\n    const control = fixture.querySelector<HTMLElement>(`#${id}`)!\n    control.focus()\n    return rules.filter((rule) => properties.some((property) => rule.style.getPropertyValue(property).includes('var(--v2-')) && control.matches(rule.selectorText)).map((rule) => rule.selectorText)\n}\n\ndescribe('desktop CSS ownership at the Academy boundary', () => {\n    it.each(['academy-input', 'academy-select', 'academy-textarea', 'academy-portal-input'])('leaves %s form colors to Academy', (id) => {\n        expect(desktopRulesFor(id, ['background', 'color', 'border'])).toEqual([])\n    })\n\n    it.each(['academy-input', 'academy-select', 'academy-textarea', 'academy-button', 'academy-portal-button'])('leaves %s focus treatment to Academy', (id) => {\n        expect(desktopRulesFor(id, ['outline', 'outline-color'])).toEqual([])\n    })\n\n    it.each(['desktop-input', 'desktop-select', 'desktop-textarea', 'dialog-input', 'wizard-input'])('keeps desktop form colors on %s', (id) => {\n        expect(desktopRulesFor(id, ['background', 'color', 'border']).length).toBeGreaterThan(0)\n    })\n\n    it.each(['header', 'rail', 'desktop-button', 'dialog-button', 'wizard-button'])('keeps desktop focus treatment on %s', (id) => {\n        expect(desktopRulesFor(id, ['outline']).length).toBeGreaterThan(0)\n        if (id === 'rail') expect(desktopRulesFor(id, ['outline-color']).length).toBeGreaterThan(0)\n    })\n})\nimport { describe, expect, it } from 'vitest'\nimport tokens from '../styles/tokens.css?raw'\n\nfunction declarations(selector: string): Record<string, string> {\n    const start = tokens.indexOf(`${selector} {`)\n    if (start < 0) throw new Error(`Missing palette: ${selector}`)\n    const body = tokens.slice(start, tokens.indexOf('}', start))\n    return Object.fromEntries([...body.matchAll(/--v2-([\\w-]+): (#[\\da-f]{6});/g)].map((m) => [m[1]!, m[2]!]))\n}\n\nconst luminance = (hex: string) => {\n    const values = [1, 3, 5].map((at) => parseInt(hex.slice(at, at + 2), 16) / 255).map((c) => c <= 0.04045 ? c / 12.92 : ((c + 0.055) / 1.055) ** 2.4)\n    return values[0]! * 0.2126 + values[1]! * 0.7152 + values[2]! * 0.0722\n}\nconst contrast = (a: string, b: string) => {\n    const [low, high] = [luminance(a), luminance(b)].sort((x, y) => x - y)\n    return (high! + 0.05) / (low! + 0.05)\n}\n\ndescribe.each(['prismaAirs', 'gruvbox'])('%s palette contrast', (family) => {\n    it.each(['light', 'dark'])('%s retains readable text and visible controls', (appearance) => {\n        const palette = {\n            ...declarations(':root'),\n            ...(appearance === 'dark' ? declarations(\":root[data-appearance='dark']\") : {}),\n            ...(family === 'gruvbox' ? declarations(`:root[data-color-theme='gruvbox'][data-appearance='${appearance}']`) : {}),\n        }\n        for (const surface of ['bg', 'paper', 'inset']) {\n            for (const ink of ['ink', 'soft', 'faint']) expect(contrast(palette[ink]!, palette[surface]!), `${ink} on ${surface}`).toBeGreaterThanOrEqual(4.5)\n            for (const control of ['ctl', 'acc']) expect(contrast(palette[control]!, palette[surface]!), `${control} on ${surface}`).toBeGreaterThanOrEqual(3)\n        }\n        expect(contrast(palette['acc-ink']!, palette.acc!)).toBeGreaterThanOrEqual(4.5)\n        for (const status of ['block', 'flag', 'ok']) expect(contrast(palette[status]!, palette[`${status}-bg`]!)).toBeGreaterThanOrEqual(4.5)\n    })\n})\n/*\n * Desktop tokens: independent palette family and light/dark appearance.\n * Light/dark mode and the selected family paint --v2-* tokens. Root\n * data-theme keeps Academy's existing general palette. Shared controls\n * receive desktop aliases only inside explicit data-desktop-theme scopes.\n */\n:root {\n    --v2-color-scheme: light;\n    --v2-bg: #f5f6f8;\n    --v2-side: #eef0f3;\n    --v2-paper: #ffffff;\n    --v2-inset: #e9edf2;\n    --v2-rule: #d4d9e1;\n    --v2-ctl: #7b8494;\n    --v2-ink: #17212f;\n    --v2-soft: #435166;\n    --v2-faint: #5c687b;\n    --v2-acc: #b83b16;\n    --v2-acc-ink: #ffffff;\n    --v2-acc-soft: #fce6de;\n    --v2-block: #b42318;\n    --v2-block-bg: #fbe4e1;\n    --v2-flag: #815200;\n    --v2-flag-bg: #fff0c9;\n    --v2-ok: #1a6b40;\n    --v2-ok-bg: #def3e6;\n    --v2-sel: var(--v2-acc);\n    --v2-sel-ink: var(--v2-acc-ink);\n    --v2-get: #245e8f;\n\n    --v2-page-top: 32px;\n    --v2-page-x: 44px;\n    --v2-title: 26px;\n    --v2-card-pad: 20px;\n    /* Grid and card gaps (the prototype's 16–20px; 12px is only inside rows). */\n    --v2-gap: 16px;\n    --v2-gap-row: 12px;\n    /* The prototype's base text is 13px; 14px is the subtitle size. */\n    --v2-text: 13px;\n    --v2-text-1: 14px;\n    --v2-text-2: 12px;\n    --v2-h2: 13px;\n    --v2-control: 32px;\n    --v2-radius-control: 7px;\n    --v2-radius-card: 12px;\n    --v2-rail: 244px;\n    --v2-header: 56px;\n    --v2-reading: 860px;\n    /* Overlay widths (R2App): tenant menu, palette, review sheet, detail sheet, dialogs. */\n    --v2-menu: 360px;\n    --v2-palette: 640px;\n    --v2-sheet: 620px;\n    --v2-detail: 520px;\n    --v2-dialog: 560px;\n    --v2-scrim: rgba(0, 0, 0, 0.22);\n    --v2-scrim-deep: rgba(0, 0, 0, 0.34);\n}\n\n:root[data-appearance='dark'] {\n    --v2-color-scheme: dark;\n    --v2-bg: #151b25;\n    --v2-side: #101620;\n    --v2-paper: #1e2734;\n    --v2-inset: #263243;\n    --v2-rule: #37465b;\n    --v2-ctl: #8190a5;\n    --v2-ink: #f0f3f8;\n    --v2-soft: #c7d0dd;\n    --v2-faint: #aab8cb;\n    --v2-acc: #ff9a70;\n    --v2-acc-ink: #26190f;\n    --v2-acc-soft: #4b2e25;\n    --v2-block: #ff9b94;\n    --v2-block-bg: #492a31;\n    --v2-flag: #f7c567;\n    --v2-flag-bg: #40351e;\n    --v2-ok: #8ddbb1;\n    --v2-ok-bg: #1a3d32;\n    --v2-get: #8cc8ff;\n}\n\n:root[data-color-theme='gruvbox'][data-appearance='light'] {\n    --v2-color-scheme: light;\n    --v2-bg: #fbf1c7;\n    --v2-side: #f2e5bc;\n    --v2-paper: #fff8df;\n    --v2-inset: #ebdbb2;\n    --v2-rule: #d5c4a1;\n    --v2-ctl: #85745b;\n    --v2-ink: #282828;\n    --v2-soft: #504945;\n    --v2-faint: #665c54;\n    --v2-acc: #a3390c;\n    --v2-acc-ink: #ffffff;\n    --v2-acc-soft: #f5d7ac;\n    --v2-block: #9d201b;\n    --v2-block-bg: #f8d7c3;\n    --v2-flag: #785500;\n    --v2-flag-bg: #f5e4a9;\n    --v2-ok: #426421;\n    --v2-ok-bg: #e3ebbb;\n    --v2-get: #076678;\n}\n\n:root[data-color-theme='gruvbox'][data-appearance='dark'] {\n    --v2-color-scheme: dark;\n    --v2-bg: #1d2021;\n    --v2-side: #161919;\n    --v2-paper: #282828;\n    --v2-inset: #32302f;\n    --v2-rule: #3c3836;\n    --v2-ctl: #8a7f70;\n    --v2-ink: #ebdbb2;\n    --v2-soft: #d5c4a1;\n    --v2-faint: #bdae93;\n    --v2-acc: #fe8019;\n    --v2-acc-ink: #1d2021;\n    --v2-acc-soft: #4a2f1a;\n    --v2-block: #ff6b57;\n    --v2-block-bg: #3d1f1c;\n    --v2-flag: #fabd2f;\n    --v2-flag-bg: #3a3019;\n    --v2-ok: #b8bb26;\n    --v2-ok-bg: #2b2f17;\n    --v2-get: #83a598;\n}\n\n/* The v2 shell root: body background, type and the visible focus ring\n * (invariant: accent-colour ring on every focusable control; inset variant\n * where a control declares it). */\n[data-v2-shell] {\n    background: var(--v2-bg);\n    color: var(--v2-ink);\n    font-size: var(--v2-text);\n    font-family: -apple-system, BlinkMacSystemFont, 'SF Pro Text', system-ui, sans-serif;\n    min-height: 100vh;\n}\n/* The destination heading takes focus after navigation for assistive technology; it is not a control, so no ring (C35). */\n[data-v2-shell] h1[tabindex='-1']:focus {\n    outline: none;\n}\n/* A page inside the shell's main region: the prototype's 32/44 margins, scrolling by itself. */\n[data-v2-shell] [data-v2-page] {\n    padding: var(--v2-page-top) var(--v2-page-x) 28px;\n    overflow-y: auto;\n    min-height: 0;\n    flex-grow: 1;\n    min-width: 0;\n}\n/* Shell ancestry includes Academy; desktop control styling needs ownership. */\n[data-desktop-theme] :focus-visible {\n    outline: 2px solid var(--v2-acc);\n    outline-offset: 2px;\n}\n[data-desktop-theme] [data-inset-focus]:focus-visible {\n    outline-offset: -4px;\n}\n[data-desktop-theme] input,\n[data-desktop-theme] select,\n[data-desktop-theme] textarea {\n    border: 1px solid var(--v2-ctl);\n    border-radius: var(--v2-radius-control);\n    background: var(--v2-bg);\n    color: var(--v2-ink);\n    min-height: var(--v2-control);\n}\n/* Rail collapses to icons below 1280 CSS px; nothing scrolls horizontally. */\n[data-v2-shell] {\n    overflow-x: hidden;\n}\n@media (max-width: 1279px) {\n    [data-v2-rail] {\n        width: 64px !important;\n    }\n    /* Collapsed: one 32px control per row; icons stay, labels leave the\n     * layout but stay in the accessible name. */\n    [data-v2-rail] [data-v2-stack] {\n        flex-direction: column;\n        align-items: stretch;\n    }\n    [data-v2-rail] [data-v2-stack] > * {\n        width: 100%;\n    }\n    /* Collapsed: labels leave the layout but stay in the accessible name (rail and header). */\n    [data-v2-rail] [data-v2-label],\n    [data-v2-header] [data-v2-label] {\n        position: absolute;\n        width: 1px;\n        height: 1px;\n        overflow: hidden;\n        clip: rect(0 0 0 0);\n        white-space: nowrap;\n    }\n    /* Collapsed: the product children and the status rows leave the rail (C35). */\n    [data-v2-rail] [data-v2-collapse] {\n        display: none !important;\n    }\n    [data-v2-rail] [data-v2-stack] > * {\n        padding-left: 0 !important;\n        padding-right: 0 !important;\n    }\n    [data-v2-header] [data-v2-search] {\n        width: auto !important;\n        flex: 1 1 120px !important;\n        min-width: 0;\ndiff --git a/apps/desktop/src/v2/academy/academy.tsx b/apps/desktop/src/v2/academy/academy.tsx\nindex 0bb73878..1f298283 100644\n--- a/apps/desktop/src/v2/academy/academy.tsx\n+++ b/apps/desktop/src/v2/academy/academy.tsx\n@@ -1,3 +1,4 @@\n+import { PageIntro } from '../page-intro'\n import { createContext, forwardRef, lazy, Suspense, useCallback, useContext, useEffect, useImperativeHandle, useMemo, useRef, useState } from 'react'\n import { useQuery, useQueryClient } from '@tanstack/react-query'\n import { createMemoryHistory, createRootRoute, createRoute, createRouter, Link, Outlet, redirect, RouterProvider } from '@tanstack/react-router'\n@@ -577,7 +578,7 @@ function AcademyRoutes({\n }\n \n /**\n- * The Academy as R2App draws it (C42): the title row with the learner's\n+ * The Academy as R2App draws it (C42): the description row with the learner's\n  * pills, the 1.4fr/1fr frame (Academy's own learner pages on the left,\n  * the learner's place on the right) and the Learning paths row, around\n  * the hosted learner pages with the Rust-owned theme. Signed out, the\n@@ -593,7 +594,7 @@ export const Academy = forwardRef<HTMLHeadingElement, AcademyProps>(function Aca\n             focus: () => {\n                 const heading = target?.querySelector('[data-slot=\"academy-pages\"] h1')\n                 if (heading instanceof HTMLElement) focusHeading(heading)\n-                else target?.querySelector<HTMLElement>('h1')?.focus()\n+                else (document.querySelector<HTMLElement>('[data-slot=\"page-heading\"]') ?? target)?.focus()\n             },\n         } as unknown as HTMLHeadingElement\n     })\n@@ -605,44 +606,39 @@ export const Academy = forwardRef<HTMLHeadingElement, AcademyProps>(function Aca\n     const unreachable = !offline.reachable && offline.state !== 'signedOut'\n \n     const band = (\n-        <div data-slot='page-header-v2' className='flex flex-wrap items-end' style={{ gap: 12 }}>\n-            <div className='min-w-0'>\n-                <h1 id='academy-heading' tabIndex={-1} className='font-bold' style={{ fontSize: 'var(--v2-title)', letterSpacing: '-0.01em' }}>\n-                    {C.title}\n-                </h1>\n-                <p className='text-[14px]' style={{ marginTop: 4, ...soft }}>\n-                    {C.lead}\n-                </p>\n-            </div>\n-            <span className='ml-auto flex flex-wrap items-center' style={{ gap: 8 }} data-slot='academy-pills'>\n-                <span\n-                    className='flex items-center rounded-full text-[13px] font-semibold'\n-                    style={{ height: 26, padding: '0 12px', gap: 6, background: displayName ? 'var(--v2-acc-soft)' : 'var(--v2-inset)', color: displayName ? 'var(--v2-acc)' : 'var(--v2-soft)' }}\n-                    data-slot='academy-account'\n-                >\n-                    <Glyph name={displayName ? 'cap' : 'eye'} size={12} color='currentColor' />\n-                    {displayName ? C.signedIn(displayName) : C.guest}\n-                </span>\n-                {unreachable ? (\n-                    <span\n-                        className='flex items-center rounded-full text-[13px] font-semibold'\n-                        style={{ height: 26, padding: '0 12px', gap: 6, background: 'var(--v2-flag-bg)', color: 'var(--v2-flag)' }}\n-                        data-slot='academy-offline-pill'\n-                    >\n-                        {C.offline}\n-                    </span>\n-                ) : null}\n-                {accountId && offline.downloads.length ? (\n+        <PageIntro\n+            description={C.lead}\n+            actions={\n+                <span className='ml-auto flex flex-wrap items-center' style={{ gap: 8 }} data-slot='academy-pills'>\n                     <span\n                         className='flex items-center rounded-full text-[13px] font-semibold'\n-                        style={{ height: 26, padding: '0 12px', background: 'var(--v2-inset)', color: 'var(--v2-soft)' }}\n-                        data-slot='academy-downloads-pill'\n+                        style={{ height: 26, padding: '0 12px', gap: 6, background: displayName ? 'var(--v2-acc-soft)' : 'var(--v2-inset)', color: displayName ? 'var(--v2-acc)' : 'var(--v2-soft)' }}\n+                        data-slot='academy-account'\n                     >\n-                        {C.downloads(offline.downloads.length)}\n+                        <Glyph name={displayName ? 'cap' : 'eye'} size={12} color='currentColor' />\n+                        {displayName ? C.signedIn(displayName) : C.guest}\n                     </span>\n-                ) : null}\n-            </span>\n-        </div>\n+                    {unreachable ? (\n+                        <span\n+                            className='flex items-center rounded-full text-[13px] font-semibold'\n+                            style={{ height: 26, padding: '0 12px', gap: 6, background: 'var(--v2-flag-bg)', color: 'var(--v2-flag)' }}\n+                            data-slot='academy-offline-pill'\n+                        >\n+                            {C.offline}\n+                        </span>\n+                    ) : null}\n+                    {accountId && offline.downloads.length ? (\n+                        <span\n+                            className='flex items-center rounded-full text-[13px] font-semibold'\n+                            style={{ height: 26, padding: '0 12px', background: 'var(--v2-inset)', color: 'var(--v2-soft)' }}\n+                            data-slot='academy-downloads-pill'\n+                        >\n+                            {C.downloads(offline.downloads.length)}\n+                        </span>\n+                    ) : null}\n+                </span>\n+            }\n+        />\n     )\n \n     const place = (\n","exit_code":0,"status":"completed"}}
