\"26ee8f126d0b1b8c96e3d0f297cde5517379730c3c1557cc524c9795ec6d11f2\", \"controller_complete\": false}\npredecessors {\"accepted_baseline\": {\"p09\": {\"subject\": \"P09\", \"attempt\": \"attempt-02\", \"request_sha256\": \"866c77d4bd484cf9878cfc9ccd89d808153e6c3bb9738f14ca572eeff0960ec9\", \"verdict_sha256\": \"6a0677e997c3112fdaf04e8eda3c4d7619719aa457590fa797bac9bd340fd0e2\", \"audit_sha256\": \"e9ca3aa0fdc996e9b9a2961ba50cc2a53bb15e593cd403d8559b13d28c39c400\", \"receipt_sha256\": \"16cf4e88f0e0975f06ccdccfd2d0af369760aca650398a08143461425cccf10d\", \"scores\": {\"architecture\": 9, \"behavior\": 9, \"authority_security\": 9, \"validation\": 9, \"overall\": 9}, \"fingerprints\": {\"source\": \"d8671203522596d4460eafa9f622696494c471d469d1ab321177db6fb9f1e253\", \"dependencies\": \"5d7e1ee69e4ea217b57a2d9d2cfde8fbdd33739719fd870f3f9f9f5d984a52b2\", \"build_flags\": \"166488b352224eb230ddfca178064d76f43deecbb6c73fb6d9359f56632e1a1f\", \"evidence\": \"fce4adbd792aad81e9066f7d2a9921901799e788462fc501e4061ea0b460676f\"}}, \"p10\": {\"subject\": \"P10\", \"attempt\": \"\nscope <class 'dict'> 3\nlimitations [\"Fresh read-only configured-model review; not cryptographic provider authorship.\", \"Current C48 and phase review this qualification. C46/C47/C49 retain actual full-nine qualification03 reviews via explicit unchanged-impact carry; their original source, qualification, verdict, audit and artifact bindings remain unchanged. This phase reviews all current source, integration and the new carry logic.\", \"D062 selects changed-flow coverage. Original P09/P10 results and owner standing are unchanged; no old artifact is claimed byte-identical to the new candidate.\", \"No new live calls or actual remote warning diagnosis. Stable installed acceptance and Linux platform qualification remain separate.\", \"controller_complete:false; actual review receipts supplement the historical ledger without fabricated standard-controller completion.\"]\nreview_carry {\"path\": \"docs/p