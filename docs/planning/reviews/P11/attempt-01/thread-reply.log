{"type":"item.completed","item":{"id":"item_50","type":"command_execution","command":"/bin/zsh -lc \"sed -n '404,610p' tools/p11/proof.py\"","aggregated_output":"def validate_impact_selection(root, path, runner_inputs, source=None, files=None):\n    \"\"\"Dated Kirk-to-VM/frontend fix accounting; never creates a passing raw run.\"\"\"\n    record = read(path)\n    require(record['schema'] == 'airs-desktop/p11-impact-selection/1'\n            and record['runner_inputs'] == runner_inputs and record['reason'],\n            'impact selection binding missing')\n    before = read(bound(root, record['baseline_source']))\n    after = read(bound(root, record['current_source']))\n    require(after['files'] == (source_inventory(root) if files is None else files),\n            'impact selection current source differs')\n    require(inventory_source(after) == runner_inputs['source'], 'impact source fingerprint differs')\n    changed = sorted(name for name in set(before['files']) | set(after['files'])\n                     if before['files'].get(name) != after['files'].get(name))\n    require(changed and changed == record['changed_paths'], 'impact delta differs')\n    origin = read(bound(root, record['baseline_candidate']))\n    require(origin['source_inventory_sha256'] == digest(before['files'])\n            and origin['runner_inputs']['source'] == inventory_source(before),\n            'baseline source-check context differs')\n    baseline_root = root / D2_SOURCE\n    require({str(p.relative_to(baseline_root)): file_identity(p)\n             for p in baseline_root.rglob('*') if p.is_file() or p.is_symlink()} == before['files'],\n            'D2 source archive membership/content differs')\n    baseline_check = validate_check_selection(root, bound(root, record['baseline_check']),\n        origin['runner_inputs'], source=baseline_root, files=before['files'])\n    baseline_test = validate_run(root, bound(root, record['baseline_test']), 'test',\n                                 origin['runner_inputs'], source=baseline_root)\n    dependencies = carry_dependencies(before['files'])\n    require(dependencies and dependencies == carry_dependencies(after['files'])\n            and dependencies == record['dependencies']\n            and all(before['files'][name] == after['files'][name] for name in dependencies),\n            'carried dependency membership/content changed')\n    plans = {kind: command_plan(source or root, kind) for kind in ('check', 'test')}\n    labels = {'check': list(IMPACT_CHECKS), 'test': [\n        row['label'] for row in plans['test'] if row['argv'][:2] != ['cargo', 'test']\n        and not row['label'].startswith('setup/')]}\n    require(record['affected'] == labels, 'affected frontend/check selection differs')\n    current = {kind: validate_run(root, bound(root, record['current_runs'][kind]), kind,\n                                  runner_inputs, labels=labels[kind], source=source)\n               for kind in ('check', 'test')}\n    require(current['check']['toolchain'] == current['test']['toolchain'],\n            'affected runs used different tools')\n    verify_tool_transition(root, record['tool_transition'], baseline_test, current['test'])\n    baseline_choices = {'check': baseline_check['selected'], 'test': [\n        {'needed': needed, 'actual': actual, 'raw': baseline_test,\n         'path': bound(root, record['baseline_test'])}\n        for needed, actual in zip(command_plan(baseline_root, 'test'), baseline_test['commands'])]}\n    choices = {}\n    for kind in ('check', 'test'):\n        old = {row['needed']['label']: row for row in baseline_choices[kind]}\n        fresh = {row['label']: row for row in current[kind]['commands']}\n        choices[kind] = []\n        for needed in plans[kind]:\n            if needed['label'].startswith('setup/'):\n                continue\n            label = needed['label']\n            if label in fresh:\n                choice = dict(needed=needed, actual=fresh[label], raw=current[kind],\n                              path=bound(root, record['current_runs'][kind]),\n                              disposition='executed', reason=None)\n            else:\n                require(label in old and old[label]['needed']['argv'] == needed['argv'],\n                        'carried command was not in the original approved plan')\n                choice = dict(old[label], needed=needed, disposition='carried_unaffected',\n                              reason=record['reason'])\n            choices[kind].append(choice)\n    return {'record': record, 'choices': choices, 'origin': origin,\n            'dependencies': dependencies}\n\n\n\nS2_SOURCE = Path('docs/planning/evidence/P11/source-history/S2')\n\n\ndef validate_helper_source_carry(root, path, runner_inputs, source=None, files=None):\n    \"\"\"Reuse source QA only across a fully enumerated helper/proof-only change.\"\"\"\n    record = read(path)\n    require(record['schema'] == 'airs-desktop/p11-helper-source-carry/1'\n            and record['runner_inputs'] == runner_inputs and record['reason'], 'helper carry binding missing')\n    before = read(bound(root, record['baseline_source']))\n    after = read(bound(root, record['current_source']))\n    require(after['files'] == (source_inventory(root) if files is None else files)\n            and inventory_source(after) == runner_inputs['source'], 'helper carry current source differs')\n    archive = root / S2_SOURCE\n    require({str(p.relative_to(archive)): file_identity(p) for p in archive.rglob('*')\n             if p.is_file() or p.is_symlink()} == before['files'], 'S2 archive membership/content differs')\n    changed = sorted(name for name in set(before['files']) | set(after['files'])\n                     if before['files'].get(name) != after['files'].get(name))\n    allowed = lambda name: (name.startswith(('tools/native-acceptance/', 'tools/p11/'))\n        or name in ('.gitattributes', 'AGENTS.md', 'crates/xtask/examples/p11_affected.rs',\n                    'docs/planning/refinements/2026-11-04/execution.md'))\n    require(changed and changed == record['changed_paths'] and all(allowed(n) for n in changed),\n            'undeclared or application-affecting helper carry delta')\n    app_names = lambda mapping: {n for n in mapping if any(n == prefix or n.startswith(prefix + '/')\n                                                           for prefix in APPLICATION_INPUTS)}\n    names = app_names(before['files'])\n    require(names and names == app_names(after['files'])\n            and all(before['files'][name] == after['files'][name] for name in names),\n            'application input membership/content changed across helper carry')\n    origin = read(bound(root, record['baseline_candidate']))\n    require(origin['source_inventory_sha256'] == digest(before['files'])\n            and origin['runner_inputs']['source'] == inventory_source(before)\n            and all(origin['runner_inputs'][key] == runner_inputs[key]\n                    for key in ('dependencies', 'build_flags')), 'helper carry source/dependencies/flags differ')\n    require(record['conditions'] == origin['conditions'], 'helper carry VM conditions differ')\n    if files is None:\n        require(record['conditions'] == {'platform': platform.platform(), 'hostname': platform.node()},\n                'helper carry current VM differs')\n    selected = validate_impact_selection(root, bound(root, record['impact_selection']),\n        origin['runner_inputs'], source=archive, files=before['files'])\n    require(selected['record']['current_source'] == record['baseline_source'],\n            'helper carry does not join original QA source')\n    covered = set()\n    require(record['qa'], 'helper-only changes need affected pure QA')\n    for ref in record['qa']:\n        qa = read(bound(root, ref))\n        require(qa['schema'] == 'airs-desktop/p11-helper-qa/1' and qa['argv']\n                and qa['cwd'] == origin['execution_root'] and qa['exit_code'] == 0\n                and qa['tests']['passed'] > 0 and qa['tests']['failed'] == 0,\n                'helper pure QA failed or provenance missing')\n        bound(root, qa['log'])\n        require(qa['helper_files'] and all(name in after['files']\n                and after['files'][name].get('sha256') == value\n                for name, value in qa['helper_files'].items()), 'helper QA input drift')\n        if 'source_before' in qa or 'source_after' in qa:\n            require(qa.get('source_before') == qa.get('source_after'), 'helper QA inputs changed during execution')\n        covered.update(qa['helper_files'])\n    require({n for n in changed if n.endswith('.py')} <= covered, 'changed helper lacks affected pure QA')\n    for kind in ('check', 'test'):\n        for choice in selected['choices'][kind]:\n            if choice['disposition'] == 'executed':\n                choice['disposition'] = 'reused_exact'\n                choice['reason'] = record['reason']\n    return {'record': record, 'selection': selected, 'origin': origin}\n\n\ndef verify_impact_coverage(root, qualified, historical=None):\n    candidate = read(bound(root, qualified['candidate']))\n    source = historical.source(qualified['source_inventory_sha256']) if historical else root\n    seal = read(bound(root, qualified['impact_source']))\n    require(digest(seal['files']) == qualified['source_inventory_sha256'],\n            'impact selection does not bind qualified source')\n    reuse = (validate_helper_source_carry(root, bound(root, qualified['helper_source_carry']),\n        candidate['runner_inputs'], source=source, files=seal['files'] if historical else None)\n        if 'helper_source_carry' in qualified else None)\n    selected = (reuse['selection'] if reuse else validate_impact_selection(root,\n        bound(root, qualified['impact_selection']), candidate['runner_inputs'],\n        source=source, files=seal['files'] if historical else None))\n    require(qualified['impact_source'] == (reuse['record']['current_source'] if reuse else\n            selected['record']['current_source']), 'impact source reference differs')\n    if reuse:\n        require(qualified['impact_selection'] == reuse['record']['impact_selection'],\n                'helper carry original impact selection differs')\n        require(all(candidate[key] == reuse['origin'][key] for key in coverage.EXACT_FIELDS),\n                'helper carry application/flags/conditions changed')\n    check_choices = {'check:' + row['needed']['label']: row for row in selected['choices']['check']\n                     if row['disposition'] != 'reused_exact'}\n    modes = {kind + ':' + row['needed']['label']: row['disposition']\n             for kind in ('check', 'test') for row in selected['choices'][kind]}\n    per_native = (native_origins(root, bound(root, qualified['native_acceptance']),\n        bound(root, qualified['native_selection']), candidate) if 'native_selection' in qualified else {})\n    require(not per_native or reuse is not None, 'native continuation lacks helper-source transition')\n    modes.update({cid: origin['disposition'] for cid, origin in per_native.items()})\n    plan = read(bound(root, qualified['plan']))\n    verify_plan(source, plan, modes)\n    for cid, origin in per_native.items():\n        needed = next(row for row in plan['requirements'] if row['id'] == cid)\n        require(needed['argv'] == origin['raw']['argv']\n                and needed['helper_paths'] == origin['helper_paths'], 'native per-row requirement drift')\n    require(all(row.get('dependencies') == selected['dependencies']\n                for row in plan['requirements'] if modes.get(row['id']) == 'carried_unaffected'),\n            'impact dependency plan differs from conservative closure')\n    rows = qualified['coverage']\n    require(len(rows) == len(plan['requirements']) and {r['id'] for r in rows}\n            == {r['id'] for r in plan['requirements']}, 'impact coverage membership differs')\n    test_choices = {'test:' + row['needed']['label']: row for row in selected['choices']['test']}\n    if reuse:\n        test_choices.update({'check:' + row['needed']['label']: row for row in selected['choices']['check']\n                             if row['disposition'] == 'reused_exact'})\n    for row in rows:\n        if row['id'] in per_native:\n            origin = per_native[row['id']]\n            raw = origin['raw']\n            result = read(bound(root, row['result']))\n            native_candidate = (reuse['record']['baseline_candidate']\n                if row['id'] == 'C46-N01' and origin['disposition'] == 'reused_exact' and reuse\n                else result['candidate'] if origin['disposition'] == 'reused_exact' else qualified['candidate'])\n            if origin['disposition'] == 'reused_exact' and row['id'] != 'C46-N01':\n                require(read(bound(root, native_candidate)) == equivalent_native_origin(\n                    root, origin['raw_path'], raw, candidate, source),\n                    'native original helper equivalence context differs')\n            require(row['disposition'] == origin['disposition']\n                    and result['status'] == 'pass' and result['exit_code'] == 0\n                    and result['process_exit_code'] == raw['exit_code']\n                    and result['execution_id'] == raw['execution_id'] and result['argv'] == raw['argv']\n                    and result['started_utc'] == raw['started_utc'] and result['finished_utc'] == raw['finished_utc']\n                    and result['log'] == reference(root, origin['raw_path'])\n                    and result['candidate'] == native_candidate\n                    and result['raw'] == qualified['native_acceptance'],\n                    'native per-row original execution drift')\n            continue\n        if row['id'] in test_choices:\n            choice = test_choices[row['id']]\n            raw, actual, path = choice['raw'], choice['actual'], choice['path']\n            carried = choice['disposition'] == 'carried_unaffected'\n            require(row['disposition'] == choice['disposition']\n                    and read(bound(root, row['result'])) == {\n                'status': 'pass', 'exit_code': 0, 'execution_id': raw['run_id'],\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_51","type":"command_execution","command":"/bin/zsh -lc \"sed -n '75,128p' tools/p10/qualification.py; sed -n '1,90p' apps/desktop/src/v2/settings/setup-warning-history.test.tsx; sed -n '1,125p' apps/desktop/src/v2/inbox/setup-warning.test.tsx; rg -n '\"'^    def test'\"' tools/p11/test_{native,proof,standing}.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_51","type":"command_execution","command":"/bin/zsh -lc \"sed -n '75,128p' tools/p10/qualification.py; sed -n '1,90p' apps/desktop/src/v2/settings/setup-warning-history.test.tsx; sed -n '1,125p' apps/desktop/src/v2/inbox/setup-warning.test.tsx; rg -n '\"'^    def test'\"' tools/p11/test_{native,proof,standing}.py\"","aggregated_output":"    candidate = read(bound(root, record[\"candidate\"]))\n    require(all(candidate.get(k) for k in EXACT_FIELDS) and candidate.get(\"helper_closure\"), \"candidate binding incomplete\")\n    require(candidate.get(\"source_inventory_sha256\") == record[\"source_inventory_sha256\"], \"candidate source binding\")\n    for row in rows:\n        needed = by_id[row[\"id\"]]\n        mode = row[\"disposition\"]\n        require(mode in [\"executed\", \"reused_exact\", \"carried_unaffected\", \"not_applicable\"], \"unsupported coverage disposition\")\n        if mode == \"not_applicable\":\n            decision = needed.get(\"retirement\")\n            require(decision and row.get(\"reason\") and row.get(\"decision\") == decision, \"unapproved assertion retirement\")\n            bound(root, decision)\n            continue\n        original = read(bound(root, row[\"result\"]))\n        require(original.get(\"status\") == \"pass\" and original.get(\"exit_code\") == 0, \"result is not an actual passing execution\")\n        require(original.get(\"execution_id\") and original.get(\"argv\") and original.get(\"cwd\") and original.get(\"started_utc\") and original.get(\"finished_utc\"), \"execution provenance missing\")\n        require(row[\"id\"] in original.get(\"required_ids\", []), \"result does not cover required assertion\")\n        bound(root, original[\"log\"])\n        origin = read(bound(root, original[\"candidate\"]))\n        require(all(origin.get(k) for k in EXACT_FIELDS) and origin.get(\"helper_closure\"), \"original candidate binding incomplete\")\n        verify_raw(root, needed, original, origin)\n        if mode in [\"executed\", \"reused_exact\"]:\n            if mode == \"reused_exact\":\n                require(not needed.get(\"must_execute\", needed.get(\"affected\", True)), \"changed check must execute\")\n            helpers = needed.get(\"helper_paths\")\n            if helpers is None:\n                require(origin[\"helper_closure\"] == candidate[\"helper_closure\"], \"relevant helper closure differs\")\n            else:\n                require(all(name in origin[\"helper_closure\"] and name in candidate[\"helper_closure\"] and origin[\"helper_closure\"][name] == candidate[\"helper_closure\"][name] for name in helpers), \"relevant helper closure differs\")\n            require(all(origin[k] == candidate[k] for k in EXACT_FIELDS), \"artifact/helper/flags/conditions differ\")\n            if mode == \"executed\":\n                require(origin[\"source_inventory_sha256\"] == record[\"source_inventory_sha256\"], \"execution is historical, not current\")\n        else:\n            require(not needed.get(\"affected\", True), \"affected check cannot be carried unchanged\")\n            rationale = row.get(\"impact\")\n            require(rationale and rationale.get(\"reason\") and rationale.get(\"dependencies\") == needed.get(\"dependencies\") and rationale.get(\"original_candidate_sha256\") == original[\"candidate\"][\"sha256\"], \"unchanged-impact proof missing\")\n            proof = read(bound(root, rationale[\"proof\"]))\n            bindings = proof.get(\"file_bindings\", {})\n            require(set(bindings) == set(needed[\"dependencies\"]) and bindings, \"dependency membership proof missing\")\n            current_files=historical.source(record['source_inventory_sha256']) if historical else root\n            original_files=historical.source(origin['source_inventory_sha256']) if historical else root\n            for dependency, binding in bindings.items():\n                require(binding[\"original_sha256\"] == binding[\"current_sha256\"] == sha(current_files/dependency), \"dependency changed: \" + dependency)\n                original_source = original_files/dependency if historical else bound(root, binding[\"original_file\"])\n                require(sha(original_source) == binding[\"original_sha256\"], \"original dependency proof mismatch\")\n            require(proof.get(\"unchanged_dependencies\") == needed[\"dependencies\"] and proof.get(\"current_source_inventory_sha256\") == record[\"source_inventory_sha256\"] and proof.get(\"original_candidate_sha256\") == original[\"candidate\"][\"sha256\"], \"impact proof does not bind current and original inputs\")\n    return {\"qualified\": True, \"required\": len(ids), \"dispositions\": {m: sum(r[\"disposition\"] == m for r in rows) for m in sorted({r[\"disposition\"] for r in rows})}, \"candidate_sha256\": record[\"candidate\"][\"sha256\"], \"source_inventory_sha256\": record[\"source_inventory_sha256\"]}\nimport { render, screen, within } from '@testing-library/react'\nimport userEvent from '@testing-library/user-event'\nimport { beforeEach, describe, expect, it } from 'vitest'\nimport { DesktopClient } from '@prisma-airs/desktop-contracts'\nimport { App } from '../../app'\nimport { scriptedNative } from '../../test/native'\nimport { fxInbox } from '../fixtures'\nimport { resetShellStore } from '../store'\n\nbeforeEach(() => resetShellStore())\n\ndescribe('dated setup warning history', () => {\n    it('keeps the original outcome/date beside a later resolution and distinguishes unknown-scope checks', async () => {\n        const base = fxInbox()\n        const warnings = [\n            { id: 'vw-21', product: 'modelSkill' as const, reason: 'Original model source was forbidden.', recordedSecs: 1_790_000_000, recheck: { checkedSecs: 1_790_000_100, state: 'pass' as const, reason: 'Matching source reads passed.', equivalent: true, basis: 'recordedScope' as const }, resolvedSecs: 1_790_000_100 },\n            { id: 'vw-22', product: 'gateway' as const, reason: 'Original Gateway workspace IAM check failed.', recordedSecs: 1_790_000_001, recheck: { checkedSecs: 1_790_000_101, state: 'pass' as const, reason: 'Current workspace read passed.', equivalent: false, basis: 'unknown' as const } },\n        ]\n        const native = scriptedNative({ ...base, activeFeature: 'settings', tenants: base.tenants.map((t, i) => i === 0 ? { ...t, setupWarnings: warnings } : t) })\n        const user = userEvent.setup()\n        render(<App client={new DesktopClient(native.transport)} />)\n        const diagnostics = await screen.findByRole('group', { name: 'Diagnostics' })\n        const history = within(diagnostics).getByRole('region', { name: 'Setup check history' })\n        expect(within(history).getByText('Original model source was forbidden.')).toBeInTheDocument()\n        expect(within(history).getByText('Matching source reads passed.')).toBeInTheDocument()\n        expect(Array.from(history.querySelectorAll('[data-warning=\"vw-21\"] time')).map((time) => time.getAttribute('datetime'))).toEqual([new Date(1_790_000_000_000).toISOString(), new Date(1_790_000_100_000).toISOString(), new Date(1_790_000_100_000).toISOString()])\n        expect(history.querySelector('[data-warning=\"vw-21\"] [data-state=\"resolved\"]')).not.toBeNull()\n        expect(within(history).getByText('Original Gateway workspace IAM check failed.')).toBeInTheDocument()\n        expect(history.querySelector('[data-warning=\"vw-22\"] [data-state=\"active\"]')).not.toBeNull()\n        expect(within(history).getByText(/scope could not be matched/i)).toBeInTheDocument()\n        expect(native.dispatched.filter((i) => i.kind === 'exportDiagnostics' || i.kind === 'clearDiagnostics')).toHaveLength(0)\n        await user.click(within(diagnostics).getByRole('button', { name: 'Export diagnostics…' }))\n        expect(native.dispatched.at(-1)).toEqual({ kind: 'exportDiagnostics' })\n        await user.click(within(diagnostics).getByRole('button', { name: 'Clear diagnostics' }))\n        expect(native.dispatched.at(-1)).toEqual({ kind: 'clearDiagnostics' })\n        await native.push({ ...native.current, diagnostics: { ...native.current.diagnostics, events: 0, clear: 'cleared' } })\n        expect(within(history).getByText('Original model source was forbidden.')).toBeInTheDocument()\n        expect(within(history).getByText('Original Gateway workspace IAM check failed.')).toBeInTheDocument()\n    })\n})\nimport { render, screen, waitFor, within } from '@testing-library/react'\nimport userEvent from '@testing-library/user-event'\nimport { beforeEach, describe, expect, it } from 'vitest'\nimport { DesktopClient, type ShellSnapshot } from '@prisma-airs/desktop-contracts'\nimport { App } from '../../app'\nimport { scriptedNative } from '../../test/native'\nimport { fxInbox } from '../fixtures'\nimport { resetShellStore, useShellStore } from '../store'\nimport { follow } from './inbox'\n\nconst warning = {\n    id: 'vw-12', product: 'modelSkill' as const, reason: 'Model scans: forbidden; Skill scans: available.', recordedSecs: 1_790_000_000,\n    check: { version: 1 as const, line: 'modelSkill' as const, tsgId: '1762204418', origin: 'https://api.scm.paloaltonetworks.com', workspace: null },\n}\nfunction warned(): ShellSnapshot {\n    const base = fxInbox()\n    const entry = { ...base.inbox.items.find((e) => e.kind === 'setupWarning')!, id: warning.id, product: 'modelSkill' as const, title: 'Supply chain setup warning', detail: warning.reason, target: { feature: 'administration' as const, product: 'modelSkill' as const, resource: null, item: null }, actionLabel: 'Open AI Supply Chain Security' }\n    return { ...base, tenants: base.tenants.map((t, i) => i === 0 ? { ...t, setupWarnings: [warning], management: { state: 'ready', mode: 'keychain', failure: null, clientId: 'public-client@1762204418.iam.panserviceaccount.com', tokenOrigin: 'https://auth.apps.paloaltonetworks.com' } } : t), inbox: { ...base.inbox, items: [entry] } }\n}\nbeforeEach(() => resetShellStore())\n\ndescribe('setup warning presentation', () => {\n    it('preserves the product through the Inbox action and opens that Administration section', async () => {\n        const snapshot = warned()\n        follow(snapshot.inbox.items[0]!, snapshot.active!.tenant, () => {})\n        expect(useShellStore.getState().arrival).toMatchObject({ product: 'modelSkill', feature: 'administration' })\n        const native = scriptedNative(snapshot)\n        const user = userEvent.setup()\n        render(<App client={new DesktopClient(native.transport)} />)\n        await screen.findByRole('heading', { name: 'Inbox', level: 1 })\n        await user.click(within(screen.getByRole('list', { name: 'Inbox items' })).getByRole('button', { name: /Supply chain setup warning/ }))\n        await user.click(screen.getByRole('button', { name: 'Open AI Supply Chain Security' }))\n        await native.push({ ...native.current, activeFeature: 'administration' })\n        const product = document.querySelector('[data-product=\"modelSkill\"]') as HTMLElement\n        await waitFor(() => expect(within(product).getByRole('button', { name: /AI Supply Chain Security/ })).toHaveAttribute('aria-expanded', 'true'))\n        expect(within(product).getByRole('tab', { name: 'Model scans' })).toBeInTheDocument()\n    })\n\n    it('rechecks only the selected warning and shows native pending and failed results without clearing it locally', async () => {\n        const native = scriptedNative(warned())\n        const user = userEvent.setup()\n        render(<App client={new DesktopClient(native.transport)} />)\n        await screen.findByRole('heading', { name: 'Inbox', level: 1 })\n        await user.click(within(screen.getByRole('list', { name: 'Inbox items' })).getByRole('button', { name: /Supply chain setup warning/ }))\n        await user.click(screen.getByRole('button', { name: 'Recheck setup' }))\n        expect(native.dispatched.at(-1)).toEqual({ kind: 'recheckSetupWarning', context: native.current.active!.context, warning: warning.id })\n        const update = async (state: 'pending' | 'warning') => native.push({ ...native.current, tenants: native.current.tenants.map((t, i) => i === 0 ? { ...t, setupWarnings: [{ ...warning, recheck: { checkedSecs: 1_790_000_100, state, reason: state === 'pending' ? 'Checking original scope.' : 'Model scans still need a role.', equivalent: state !== 'pending', basis: state === 'pending' ? 'unknown' as const : 'recordedScope' as const } }] } : t) })\n        await update('pending')\n        expect(screen.getByRole('button', { name: 'Recheck setup' })).toBeDisabled()\n        await user.click(screen.getByRole('button', { name: 'Recheck setup' }))\n        expect(native.dispatched.filter((i) => i.kind === 'recheckSetupWarning')).toHaveLength(1)\n        expect(screen.getByText('Checking original scope.')).toBeInTheDocument()\n        expect(screen.queryByText(/original scope could not be matched/i)).toBeNull()\n        await update('warning')\n        expect(screen.getByText('Model scans still need a role.')).toBeInTheDocument()\n        expect(screen.getByRole('button', { name: 'Recheck setup' })).not.toBeDisabled()\n        expect(within(screen.getByRole('list', { name: 'Inbox items' })).getByRole('button', { name: /Supply chain setup warning/ })).toBeInTheDocument()\n        const checked = { ...warning, recheck: { checkedSecs: 1_790_000_101, state: 'pass' as const, reason: 'Current product read passed.', equivalent: false, basis: 'unknown' as const } }\n        await native.push({ ...native.current, tenants: native.current.tenants.map((t, i) => i === 0 ? { ...t, setupWarnings: [checked] } : t) })\n        expect(screen.getByText(/original scope could not be matched/i)).toBeInTheDocument()\n        expect(within(screen.getByRole('list', { name: 'Inbox items' })).getByRole('button', { name: /Supply chain setup warning/ })).toBeInTheDocument()\n        const resolved = { ...checked, recheck: {