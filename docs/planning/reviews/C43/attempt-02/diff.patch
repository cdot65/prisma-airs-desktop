diff --git a/apps/desktop/src/styles/tokens.css b/apps/desktop/src/styles/tokens.css
index e6cbdff4..fad4a2f3 100644
--- a/apps/desktop/src/styles/tokens.css
+++ b/apps/desktop/src/styles/tokens.css
@@ -222,3 +222,73 @@
         border-top: 1px solid var(--v2-rule);
     }
 }
+/* The wizard's product cards (C43): the card is a label around a visually hidden native checkbox; the card shows
+   the control's focus ring and its chosen state. */
+[data-slot='product-card']:has(> input:focus-visible) {
+    outline: 2px solid var(--v2-acc);
+    outline-offset: 2px;
+}
+/* The wizard's Environment segmented control (C43): native radios inside labels; the segment shows the ring. */
+[data-slot='environment-choice']:has(> input:focus-visible) {
+    outline: 2px solid var(--v2-acc);
+    outline-offset: 1px;
+}
+/* The wizard (C43) below 760px (a 900-point window at 200%): the rail is a compact strip above the step (the step
+   marks keep their names for assistive technology but show their numbers), every grid is one column, and the step
+   scrolls between the strip and the pinned footer. */
+@media (max-width: 760px) {
+    [data-v2-shell] [data-slot='wizard'],
+    [data-slot='wizard'] {
+        flex-direction: column;
+    }
+    [data-slot='wizard'] > nav {
+        width: 100% !important;
+        flex: 0 0 auto;
+        padding: 10px 12px 8px !important;
+        border-right: 0 !important;
+        border-bottom: 1px solid var(--v2-rule);
+    }
+    [data-slot='wizard'] > nav > div:first-child {
+        margin-bottom: 8px !important;
+    }
+    [data-slot='wizard'] > nav > ol {
+        flex-direction: row;
+        flex-wrap: wrap;
+        gap: 4px !important;
+    }
+    [data-slot='wizard'] > nav > ol button {
+        width: auto;
+        height: 32px !important;
+        padding: 0 6px !important;
+        gap: 0 !important;
+    }
+    [data-slot='wizard'] > nav > ol button > span:not(:first-child) {
+        position: absolute;
+        width: 1px;
+        height: 1px;
+        overflow: hidden;
+        clip: rect(0 0 0 0);
+        white-space: nowrap;
+    }
+    [data-slot='wizard'] > nav > [data-slot='privacy-note'] {
+        display: none;
+    }
+    [data-slot='wizard'] > nav > [data-slot='theme-button'] {
+        margin-top: 6px !important;
+    }
+    [data-slot='wizard'] main .grid {
+        grid-template-columns: minmax(0, 1fr) !important;
+    }
+    /* The strip drops the brand row (the sheet is already named), and the footer's hint or status keeps to two
+       lines: at 900×600 and 200% the add sheet is 279 CSS px tall, and a long hint made the footer taller than the
+       sheet, pushing its primary below the window. */
+    [data-slot='wizard'] > nav > div:first-child {
+        display: none;
+    }
+    [data-slot='wizard-footer'] [data-slot='wizard-status'] > span {
+        display: -webkit-box;
+        -webkit-line-clamp: 2;
+        -webkit-box-orient: vertical;
+        overflow: hidden;
+    }
+}
