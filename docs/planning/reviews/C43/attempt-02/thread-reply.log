    async function finish(resolution: SwitchResolution | null = null) {
        if (!setup) return
        setFinishing(true)
        const outcome = await dispatch({ kind: 'completeTenantSetup', context: setup.context, packs: selectedPacks, resolution })
        if (outcome.kind === 'admitted') {
