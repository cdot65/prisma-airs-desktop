+/* The wizard's product cards (C43): the card is a label around a visually hidden native checkbox; the card shows
+   the control's focus ring and its chosen state. */
+[data-slot='product-card']:has(> input:focus-visible) {
+    outline: 2px solid var(--v2-acc);
+    outline-offset: 2px;
+}
+/* The wizard's Environment segmented control (C43): native radios inside labels; the segment shows the ring. */
