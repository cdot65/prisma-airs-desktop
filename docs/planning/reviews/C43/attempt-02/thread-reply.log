        }
        if (group[i] === el) {
            return;
        }
        if (isDisabled.isDisabled(group[i])) {
            continue;
        }
        focus.focusElement(group[i]);
        instance.dispatchUIEvent(group[i], 'click');
        return;
    }
}

exports.walkRadio = walkRadio;

