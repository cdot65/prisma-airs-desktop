index 0000000..bc2f1b3
--- /dev/null
+++ b/crates/desktop-core/src/harness/history.rs
@@ -0,0 +1,508 @@
+//! Protected Harness history (C20, D047).
+//!
+//! A conversation is saved after each turn, as one sealed record: its
+//! transcript, the binding it ran under, and the engine's own replay with
+//! the engine context it was exported for (`desktop/history/read`). Records
+//! are kept per scope (tenant and Gateway workspace) under
+//! `<root>/<tenant digest>/<scope digest>/<conversation>.sealed`, sealed with
+//! XChaCha20-Poly1305 under a random per-scope key held in the Keychain;
+//! the associated data binds the schema, the scope and the conversation.
+//! A tenant's scopes share one directory, removed with the tenant.
+//! Writes replace a record atomically (0600 in a 0700 directory). A record
+//! that does not open is named unreadable and left for the operator to
+//! delete, never rewritten. Nothing is ever written in plaintext: without
+//! the key (locked, denied, missing) history is unavailable.
+//!
+//! These are blocking functions, run off the authority lock.
+
+use std::path::{Path, PathBuf};
+
+use serde::{Deserialize, Serialize};
+use serde_json::Value;
+use ts_rs::TS;
+use zeroize::Zeroizing;
+
+use super::{HarnessEntry, HarnessUsage, MAX_ENTRIES};
+use crate::vault::{RecordId, Vault, VaultError};
+
+pub const SCHEMA: &str = "prisma-airs-desktop-v2/harness-history/1";
+/// Saved conversations per scope.
+pub const MAX_CONVERSATIONS: usize = 16;
+/// The largest sealed record (the engine's replay is at most 4 MiB).
+pub const MAX_RECORD_BYTES: usize = 8 * 1024 * 1024;
+pub const MAX_TITLE_CHARS: usize = 80;
+const SUFFIX: &str = ".sealed";
+
+/// Why history could not be read or written.
+#[derive(Clone, Copy, Debug, PartialEq, Eq, Serialize, TS, thiserror::Error)]
+#[serde(rename_all = "camelCase")]
+pub enum HistoryFailure {
+    #[error("the Keychain is locked")]
+    Locked,
+    #[error("Keychain access was denied")]
+    Denied,
+    #[error("history storage is unavailable")]
+    Unavailable,
+    #[error("history is full for this workspace")]
+    Full,
+    #[error("the conversation is too large to save")]
+    TooLarge,
+    #[error("the saved conversation cannot be read")]
+    Unreadable,
+    #[error("the saved conversation no longer exists")]
+    Missing,
+}
+
+impl From<VaultError> for HistoryFailure {
+    fn from(error: VaultError) -> Self {
+        match error {
+            VaultError::Locked => Self::Locked,
+            VaultError::Denied => Self::Denied,
+            _ => Self::Unavailable,
+        }
+    }
+}
+
+/// Which credential a conversation ran with.
+#[derive(Clone, Copy, Debug, PartialEq, Eq, Serialize, Deserialize, TS)]
+#[serde(rename_all = "camelCase")]
+pub enum CredentialSource {
+    WorkspaceKey,
+    CompanySignIn,
+}
+
+/// The binding a conversation ran under (its engine identity).
+#[derive(Clone, Debug, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(rename_all = "camelCase", deny_unknown_fields)]
+pub struct SavedBinding {
+    pub tenant: String,
+    pub workspace: String,
+    pub credential: String,
+    pub credential_epoch: u64,
+    pub endpoint: String,
+    pub source: CredentialSource,
+}
+
+/// One saved conversation.
+#[derive(Clone, Serialize, Deserialize)]
+#[serde(rename_all = "camelCase", deny_unknown_fields)]
+pub struct Record {
+    pub schema: String,
+    /// The conversation's own ID (a UUID; also the record's file name).
+    pub id: String,
+    pub title: String,
+    /// Wall-clock seconds since the epoch.
+    pub created: u64,
+    pub updated: u64,
+    pub binding: SavedBinding,
+    pub entries: Vec<HarnessEntry>,
+    pub usage: Option<HarnessUsage>,
+    /// The engine's context binding, exactly as exported.
+    pub context: Value,
+    /// The engine's replay, exactly as exported.
+    pub replay: Value,
+}
+
+/// What the list shows of a record.
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub enum Listed {
+    Saved {
+        id: String,
+        title: String,
+        updated: u64,
+        entries: usize,
+        binding: SavedBinding,
+    },
+    /// Present but not openable with this scope's key.
+    Unreadable { id: String },
+}
+
+/// One scope's history: where it lives and the Keychain record of its key.
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct Scope {
+    pub dir: PathBuf,
+    pub key_record: RecordId,
+    digest: String,
+}
+
+impl Scope {
+    /// The scope of a tenant's Gateway workspace under `root`.
+    pub fn new(root: &Path, tenant: &str, workspace: &str) -> Self {
+        let digest = crate::offline::digest(&format!("harness-history:{tenant}:{workspace}"));
+        let key = crate::offline::digest(&format!("harness-history-key:{tenant}:{workspace}"));
+        Self {
+            dir: tenant_dir(root, tenant).join(&digest[..32]),
+            key_record: RecordId::parse(&format!("cr-{}", &key[..16])).expect("16 hex digits"),
+            digest,
+        }
+    }
+
+    fn aad(&self, id: &str) -> Vec<u8> {
+        format!("{SCHEMA}:{}:{id}", self.digest).into_bytes()
+    }
+
+    fn path(&self, id: &str) -> Option<PathBuf> {
+        super::protocol::is_uuid(id).then(|| self.dir.join(format!("{id}{SUFFIX}")))
+    }
+
+    /// The IDs of the records present, oldest name first.
+    fn ids(&self) -> Result<Vec<String>, HistoryFailure> {
+        let entries = match std::fs::read_dir(&self.dir) {
+            Ok(entries) => entries,
+            Err(e) if e.kind() == std::io::ErrorKind::NotFound => return Ok(Vec::new()),
+            Err(_) => return Err(HistoryFailure::Unavailable),
+        };
+        let mut ids: Vec<String> = entries
+            .filter_map(Result::ok)
+            .filter(|e| e.file_type().is_ok_and(|t| t.is_file()))
+            .filter_map(|e| {
+                e.file_name()
+                    .to_str()?
+                    .strip_suffix(SUFFIX)
+                    .filter(|id| super::protocol::is_uuid(id))
+                    .map(str::to_owned)
+            })
+            .collect();
+        ids.sort();
+        Ok(ids)
+    }
+}
+
+/// Where all of a tenant's scopes live.
+pub fn tenant_dir(root: &Path, tenant: &str) -> PathBuf {
+    root.join(&crate::offline::digest(&format!("harness-history-tenant:{tenant}"))[..32])
+}
+
+/// The scope's key, if one was ever made.
+fn key(vault: &dyn Vault, scope: &Scope) -> Result<Option<Zeroizing<[u8; 32]>>, HistoryFailure> {
+    match vault.get(&scope.key_record) {
+        Ok(bytes) => {
+            let key: [u8; 32] = bytes
+                .as_slice()
+                .try_into()
+                .map_err(|_| HistoryFailure::Unreadable)?;
+            Ok(Some(Zeroizing::new(key)))
+        }
+        Err(VaultError::NotFound) => Ok(None),
+        Err(error) => Err(error.into()),
+    }
+}
+
+/// The scope's key, made and stored on first use.
+fn key_or_new(vault: &dyn Vault, scope: &Scope) -> Result<Zeroizing<[u8; 32]>, HistoryFailure> {
+    if let Some(key) = key(vault, scope)? {
+        return Ok(key);
+    }
+    let mut fresh = Zeroizing::new([0u8; 32]);
+    getrandom::fill(&mut *fresh).map_err(|_| HistoryFailure::Unavailable)?;
+    vault.put(&scope.key_record, &*fresh)?;
+    Ok(fresh)
+}
+
+fn open_record(key: &[u8; 32], scope: &Scope, id: &str) -> Result<Record, HistoryFailure> {
+    let path = scope.path(id).ok_or(HistoryFailure::Missing)?;
+    let meta = match std::fs::symlink_metadata(&path) {
+        Ok(meta) => meta,
+        Err(e) if e.kind() == std::io::ErrorKind::NotFound => return Err(HistoryFailure::Missing),
+        Err(_) => return Err(HistoryFailure::Unavailable),
+    };
+    if !meta.is_file() || meta.len() > (MAX_RECORD_BYTES + 64) as u64 {
+        return Err(HistoryFailure::Unreadable);
+    }
+    let sealed = std::fs::read(&path).map_err(|_| HistoryFailure::Unavailable)?;
+    let plain = crate::sessions::open(key, &scope.aad(id), &sealed)
+        .map(Zeroizing::new)
+        .ok_or(HistoryFailure::Unreadable)?;
+    let record: Record = serde_json::from_slice(&plain).map_err(|_| HistoryFailure::Unreadable)?;
+    if record.schema != SCHEMA || record.id != id || !valid(&record) {
+        return Err(HistoryFailure::Unreadable);
+    }
+    Ok(record)
+}
+
+fn valid(record: &Record) -> bool {
+    record.title.chars().count() <= MAX_TITLE_CHARS
+        && record.entries.len() <= MAX_ENTRIES
+        && record.updated >= record.created
+}
+
+/// Every record of the scope, newest first. Without a key there is
+/// nothing saved (records made under a lost key are unreadable).
+pub fn list(vault: &dyn Vault, scope: &Scope) -> Result<Vec<Listed>, HistoryFailure> {
+    let ids = scope.ids()?;
+    if ids.is_empty() {
+        return Ok(Vec::new());
+    }
+    let key = key(vault, scope)?;
+    let mut listed: Vec<(u64, Listed)> = ids
+        .into_iter()
+        .map(
+            |id| match key.as_deref().map(|k| open_record(k, scope, &id)) {
+                Some(Ok(record)) => (
+                    record.updated,
+                    Listed::Saved {
+                        id,
+                        title: record.title,
+                        updated: record.updated,
+                        entries: record.entries.len(),
+                        binding: record.binding,
+                    },
+                ),
+                _ => (0, Listed::Unreadable { id }),
+            },
+        )
+        .collect();
+    listed.sort_by_key(|l| std::cmp::Reverse(l.0));
+    Ok(listed.into_iter().map(|(_, l)| l).collect())
+}
+
+/// One record, opened.
+pub fn read(vault: &dyn Vault, scope: &Scope, id: &str) -> Result<Record, HistoryFailure> {
+    let key = key(vault, scope)?.ok_or(HistoryFailure::Unreadable)?;
+    open_record(&key, scope, id)
+}
+
+/// Saves `record`, replacing its earlier version. A new conversation is
+/// refused once the scope holds [`MAX_CONVERSATIONS`]: saved work is never
+/// evicted to make room.
+pub fn save(vault: &dyn Vault, scope: &Scope, record: &Record) -> Result<(), HistoryFailure> {
+    let path = scope.path(&record.id).ok_or(HistoryFailure::Unavailable)?;
+    if !valid(record) || record.schema != SCHEMA {
+        return Err(HistoryFailure::Unavailable);
+    }
+    let ids = scope.ids()?;
+    if !ids.contains(&record.id) && ids.len() >= MAX_CONVERSATIONS {
+        return Err(HistoryFailure::Full);
+    }
+    let plain =
+        Zeroizing::new(serde_json::to_vec(record).map_err(|_| HistoryFailure::Unavailable)?);
+    if plain.len() > MAX_RECORD_BYTES {
+        return Err(HistoryFailure::TooLarge);
+    }
+    let key = key_or_new(vault, scope)?;
+    let sealed = crate::sessions::seal(&key, &scope.aad(&record.id), &plain)
+        .ok_or(HistoryFailure::Unavailable)?;
+    crate::sessions::write_private(&path, &sealed).map_err(|_| HistoryFailure::Unavailable)
+}
+
+/// Deletes one record.
+pub fn delete(scope: &Scope, id: &str) -> Result<(), HistoryFailure> {
+    let path = scope.path(id).ok_or(HistoryFailure::Missing)?;
+    match std::fs::remove_file(path) {
+        Ok(()) => Ok(()),
+        Err(e) if e.kind() == std::io::ErrorKind::NotFound => Err(HistoryFailure::Missing),
+        Err(_) => Err(HistoryFailure::Unavailable),
+    }
+}
+
+/// Removes a scope's records and its key (its tenant was removed).
+pub fn purge(vault: &dyn Vault, scope: &Scope) -> Result<(), HistoryFailure> {
+    match std::fs::remove_dir_all(&scope.dir) {
+        Ok(()) => {}
+        Err(e) if e.kind() == std::io::ErrorKind::NotFound => {}
+        Err(_) => return Err(HistoryFailure::Unavailable),
+    }
+    match vault.delete(&scope.key_record) {
+        Ok(()) | Err(VaultError::NotFound) => Ok(()),
+        Err(error) => Err(error.into()),
+    }
+}
+
+/// A title from the first message: one line, at most [`MAX_TITLE_CHARS`].
+pub fn title(first: &str) -> String {
+    let line: String = first
+        .split_whitespace()
+        .collect::<Vec<_>>()
+        .join(" ")
+        .chars()
+        .filter(|c| !c.is_control())
+        .collect();
+    if line.chars().count() <= MAX_TITLE_CHARS {
+        return line;
+    }
+    let mut short: String = line.chars().take(MAX_TITLE_CHARS - 1).collect();
+    short.push('…');
+    short
+}
+
+/// The transcript as Markdown, plain text or JSON (no replay, no binding
+/// secrets: the replay stays in the sealed store).
+pub mod export {
+    use super::Record;
+    use crate::harness::HarnessRole;
+
+    fn speaker(role: HarnessRole) -> &'static str {
+        match role {
+            HarnessRole::Operator => "You",
+            HarnessRole::Assistant => "Harness",
+        }
+    }
+
+    pub fn markdown(record: &Record) -> String {
+        let mut out = format!("# {}\n\n", record.title.replace('\n', " "));
+        for entry in &record.entries {
+            out.push_str(&format!("## {}\n\n{}\n\n", speaker(entry.role), entry.text));
+        }
+        out
+    }
+
+    pub fn text(record: &Record) -> String {
+        let mut out = format!("{}\n\n", record.title);
+        for entry in &record.entries {
+            out.push_str(&format!("{}:\n{}\n\n", speaker(entry.role), entry.text));
+        }
+        out
+    }
+
+    pub fn json(record: &Record) -> String {
+        serde_json::to_string_pretty(&serde_json::json!({
+            "title": record.title,
+            "created": record.created,
+            "updated": record.updated,
+            "workspace": record.binding.workspace,
+            "endpoint": record.binding.endpoint,
+            "entries": record.entries,
+        }))
+        .unwrap_or_default()
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::harness::{EntryState, HarnessRole};
+    use crate::vault::SessionVault;
+
+    fn root() -> PathBuf {
+        let mut bytes = [0u8; 8];
+        getrandom::fill(&mut bytes).expect("fixture");
+        std::env::temp_dir()
+            .canonicalize()
+            .expect("fixture")
+            .join(format!("airs-history-{}", hex::encode(bytes)))
+    }
+
+    fn record(id: &str, text: &str) -> Record {
+        Record {
+            schema: SCHEMA.to_owned(),
+            id: id.to_owned(),
+            title: title(text),
+            created: 1,
+            updated: 2,
+            binding: SavedBinding {
+                tenant: "t".into(),
+                workspace: "w".into(),
+                credential: "c".into(),
+                credential_epoch: 1,
+                endpoint: "https://gateway.example".into(),
+                source: CredentialSource::WorkspaceKey,
+            },
+            entries: vec![HarnessEntry {
+                id: "u-1".into(),
+                role: HarnessRole::Operator,
+                text: text.to_owned(),
+                state: EntryState::Complete,
+            }],
+            usage: None,
+            context: serde_json::json!({"c": 1}),
+            replay: serde_json::json!({"r": text}),
+        }
+    }
+
+    fn id(n: u8) -> String {
+        format!("8f0c3a52-5d1e-8b2a-9c4d-1e2f3a4b5c{n:02x}")
+    }
+
+    #[test]
+    fn a_record_is_sealed_and_opens_only_in_its_own_scope_and_name() {
+        let root = root();
+        let vault = SessionVault::default();
+        let a = Scope::new(&root, "tn-a", "ws-1");
+        let b = Scope::new(&root, "tn-a", "ws-2");
+        assert_ne!(a.dir, b.dir);
+        assert_ne!(a.key_record, b.key_record);
+        assert!(a.dir.starts_with(tenant_dir(&root, "tn-a")));
+        save(&vault, &a, &record(&id(1), "periwinkle canary")).expect("saved");
+        let path = a.path(&id(1)).expect("path");
+        let sealed = std::fs::read(&path).expect("sealed");
+        assert!(!sealed.windows(10).any(|w| w == b"periwinkle"));
+        use std::os::unix::fs::PermissionsExt;
+        assert_eq!(
+            std::fs::metadata(&path).expect("meta").permissions().mode() & 0o777,
+            0o600
+        );
+        assert_eq!(
+            read(&vault, &a, &id(1)).expect("read").entries[0].text,
+            "periwinkle canary"
+        );
+        // The same bytes under another name or in another scope (even with
+        // that scope's key equal) do not open.
+        std::fs::copy(&path, a.path(&id(2)).expect("path")).expect("copy");
+        assert_eq!(
+            read(&vault, &a, &id(2)).err(),
+            Some(HistoryFailure::Unreadable)
+        );
+        let key = vault.get(&a.key_record).expect("key");
+        vault.put(&b.key_record, &key).expect("key");
+        std::fs::create_dir_all(&b.dir).expect("dir");
+        std::fs::copy(&path, b.path(&id(1)).expect("path")).expect("copy");
+        assert_eq!(
+            read(&vault, &b, &id(1)).err(),
+            Some(HistoryFailure::Unreadable)
+        );
+        // A tampered byte does not open; the list names it unreadable.
+        let mut tampered = sealed.clone();
+        let last = tampered.len() - 1;
+        tampered[last] ^= 1;
+        std::fs::write(&path, &tampered).expect("tamper");
+        assert!(
+            list(&vault, &a)
+                .expect("list")
+                .contains(&Listed::Unreadable { id: id(1) })
+        );
+        purge(&vault, &a).expect("purge");
+        assert!(!a.dir.exists());
+        assert_eq!(vault.get(&a.key_record).err(), Some(VaultError::NotFound));
+        std::fs::remove_dir_all(&root).expect("cleanup");
+    }
+
+    #[test]
+    fn a_full_scope_refuses_new_records_and_ids_are_uuids() {
+        let root = root();
+        let vault = SessionVault::default();
+        let scope = Scope::new(&root, "tn-a", "ws-1");
+        for n in 0..MAX_CONVERSATIONS as u8 {
+            save(&vault, &scope, &record(&id(n), "x")).expect("saved");
+        }
+        assert_eq!(
+            save(&vault, &scope, &record(&id(99), "x")),
+            Err(HistoryFailure::Full)
+        );
+        // An existing record is still replaced.
+        save(&vault, &scope, &record(&id(0), "y")).expect("replaced");
+        assert_eq!(list(&vault, &scope).expect("list").len(), MAX_CONVERSATIONS);
+        assert!(save(&vault, &scope, &record("../escape", "x")).is_err());
+        assert_eq!(
+            read(&vault, &scope, "../escape").err(),
+            Some(HistoryFailure::Missing)
+        );
+        let big = Record {
+            replay: serde_json::json!({"r": "z".repeat(MAX_RECORD_BYTES)}),
+            ..record(&id(0), "x")
+        };
+        assert_eq!(save(&vault, &scope, &big), Err(HistoryFailure::TooLarge));
+        assert_eq!(title(&"w ".repeat(100)).chars().count(), MAX_TITLE_CHARS);
+        assert_eq!(title("one\nline\ttitle"), "one line title");
+        std::fs::remove_dir_all(&root).expect("cleanup");
+    }
+
+    #[test]
+    fn exports_carry_the_transcript_only() {
+        let r = record(&id(1), "periwinkle");
+        let json: serde_json::Value = serde_json::from_str(&export::json(&r)).expect("json");
+        assert!(json.get("replay").is_none() && json.get("context").is_none());
+        assert_eq!(json["entries"][0]["text"], "periwinkle");
+        assert!(export::markdown(&r).contains("## You\n\nperiwinkle"));
+        assert!(!export::text(&r).contains("\"r\""));
+    }
+}
diff --git a/crates/desktop-core/src/harness/identity.rs b/crates/desktop-core/src/harness/identity.rs
new file mode 100644
index 0000000..7e13a9c
--- /dev/null
+++ b/crates/desktop-core/src/harness/identity.rs
@@ -0,0 +1,832 @@
+//! Company sign-in for the Harness Gateway credential (C20, D047).
+//!
+//! OpenID Connect authorization code with PKCE (S256) through the system
+//! browser and a loopback callback ([`super::callback`]); the desktop is a
+//! public client. The provider is the issuer the operator entered: its
+//! discovery document must name exactly that issuer and only HTTPS
+//! endpoints on the issuer's origin, so metadata never grants a new
+//! destination. Replies are bounded, redirects refused (client policy) and
+//! transient provider failures read as `Network`.
+//!
+//! Both the ID token and the Gateway access token are JWTs verified against
+//! the issuer's JWKS before anything is kept: asymmetric algorithms only,
+//! the key's type and curve matching the header, issuer, audience,
+//! authorized party, nonce (ID token) and expiry, not-before and issued-at
+//! with a bounded skew judged on the wall clock the caller supplies. An
+//! unknown key ID allows one bounded JWKS refresh. Opaque access tokens are
+//! refused: no introspection contract exists (D047).
+
+use std::time::Duration;
+
+use base64::Engine as _;
+use jsonwebtoken::jwk::{AlgorithmParameters, EllipticCurve, Jwk, JwkSet, PublicKeyUse};
+use jsonwebtoken::{Algorithm, DecodingKey, Validation};
+use serde::Serialize;
+use serde_json::{Map, Value};
+use sha2::{Digest, Sha256};
+use ts_rs::TS;
+use url::Url;
+use zeroize::Zeroizing;
+
+const REPLY_LIMIT: usize = 128 * 1024;
+const JWKS_LIMIT: usize = 64 * 1024;
+const MAX_KEYS: usize = 32;
+const TOKEN_LIMIT: usize = 16 * 1024;
+const TIMEOUT: Duration = Duration::from_secs(30);
+/// Clock skew allowed on `exp`, `nbf` and `iat`.
+pub const SKEW: u64 = 30;
+/// The smallest RSA modulus accepted (2048 bits).
+const MIN_RSA_BYTES: usize = 256;
+const ALGORITHMS: [Algorithm; 9] = [
+    Algorithm::RS256,
+    Algorithm::RS384,
+    Algorithm::RS512,
+    Algorithm::PS256,
+    Algorithm::PS384,
+    Algorithm::PS512,
+    Algorithm::ES256,
+    Algorithm::ES384,
+    Algorithm::EdDSA,
+];
+
+/// Why company sign-in or a renewal failed (sanitized; no provider text).
+#[derive(Clone, Copy, Debug, PartialEq, Eq, Serialize, TS, thiserror::Error)]
+#[serde(rename_all = "camelCase")]
+pub enum SignInFailure {
+    #[error("the identity provider's configuration is not usable")]
+    InvalidConfig,
+    #[error("the identity provider could not be reached")]
+    Network,
+    #[error("the identity provider returned an invalid response")]
+    InvalidResponse,
+    #[error("sign-in was declined")]
+    Denied,
+    #[error("the browser did not return in time")]
+    TimedOut,
+    #[error("sign-in was cancelled")]
+    Cancelled,
+    #[error("the browser could not be opened")]
+    BrowserUnavailable,
+    #[error("the sign-in callback could not be opened")]
+    CallbackUnavailable,
+    #[error("a token did not verify")]
+    InvalidToken,
+    #[error("the Gateway token is not a signed JWT")]
+    OpaqueToken,
+    #[error("the token is for another Gateway workspace")]
+    WrongWorkspace,
+    #[error("a different account signed in")]
+    DifferentAccount,
+    #[error("the session expired")]
+    SessionExpired,
+    #[error("the session could not be kept")]
+    StoreFailed,
+}
+
+/// What the operator entered for the Gateway's identity provider.
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct SsoConfig {
+    /// Exactly as the provider names itself (`iss`), without a trailing `/`.
+    pub issuer: String,
+    pub client_id: String,
+    /// The Gateway audience the access token must carry.
+    pub audience: String,
+}
+
+fn https(text: &str) -> Option<Url> {
+    let url = Url::parse(text).ok()?;
+    (url.scheme() == "https"
+        && url.host_str().is_some_and(|h| !h.is_empty())
+        && url.username().is_empty()
+        && url.password().is_none()
+        && url.fragment().is_none())
+    .then_some(url)
+}
+
+fn printable(text: &str, max: usize) -> bool {
+    !text.is_empty() && text.len() <= max && text.bytes().all(|b| b.is_ascii_graphic())
+}
+
+impl SsoConfig {
+    /// A configuration with an `https` issuer (no credentials, query or
+    /// fragment), a client ID and an audience of printable ASCII.
+    pub fn parse(issuer: &str, client_id: &str, audience: &str) -> Option<Self> {
+        let issuer = issuer.trim().trim_end_matches('/');
+        if issuer.len() > 2048 {
+            return None;
+        }
+        let url = https(issuer)?;
+        if url.query().is_some() || !printable(client_id, 256) || !printable(audience, 512) {
+            return None;
+        }
+        Some(Self {
+            issuer: issuer.to_owned(),
+            client_id: client_id.to_owned(),
+            audience: audience.to_owned(),
+        })
+    }
+
+    fn origin(&self) -> String {
+        https(&self.issuer)
+            .map(|u| u.origin().ascii_serialization())
+            .unwrap_or_default()
+    }
+}
+
+/// The provider's endpoints, from its discovery document.
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct Provider {
+    pub authorization: Url,
+    pub token: Url,
+    pub jwks: Url,
+    pub revocation: Option<Url>,
+    /// `offline_access` is listed, so it is asked for.
+    pub offline_access: bool,
+    /// RFC 9207: the callback must then carry `iss`.
+    pub iss_in_callback: bool,
+}
+
+/// Tokens from a code exchange or a refresh.
+pub struct Tokens {
+    pub access: Zeroizing<String>,
+    pub id_token: Option<Zeroizing<String>>,
+    pub refresh: Option<Zeroizing<String>>,
+}
+
+/// One browser sign-in attempt: its secrets and the URL to open.
+pub struct Attempt {
+    pub state: Zeroizing<String>,
+    pub nonce: Zeroizing<String>,
+    pub verifier: Zeroizing<String>,
+    pub redirect: String,
+    pub url: Url,
+}
+
+/// The verified account behind an ID token.
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct Account {
+    pub subject: String,
+    /// `preferred_username`, else `email`, else the subject.
+    pub label: String,
+}
+
+/// A verified Gateway access token and when it stops being usable.
+pub struct Access {
+    pub token: Zeroizing<String>,
+    pub subject: String,
+    /// Wall-clock seconds since the epoch.
+    pub expires: u64,
+    pub issued: u64,
+}
+
+impl Access {
+    /// Renew before `expires - min(120 s, lifetime / 2)` (DESIGN).
+    pub fn renew_at(&self) -> u64 {
+        let lifetime = self.expires.saturating_sub(self.issued);
+        self.expires.saturating_sub((lifetime / 2).min(120))
+    }
+}
+
+fn random(bytes: usize) -> Option<Zeroizing<String>> {
+    let mut raw = Zeroizing::new(vec![0u8; bytes]);
+    getrandom::fill(&mut raw).ok()?;
+    Some(Zeroizing::new(
+        base64::engine::general_purpose::URL_SAFE_NO_PAD.encode(&*raw),
+    ))
+}
+
+/// Starts an attempt whose callback is `http://127.0.0.1:{port}/callback`.
+pub fn attempt(provider: &Provider, config: &SsoConfig, port: u16) -> Option<Attempt> {
+    let state = random(32)?;
+    let nonce = random(32)?;
+    let verifier = random(48)?;
+    let challenge = base64::engine::general_purpose::URL_SAFE_NO_PAD
+        .encode(Sha256::digest(verifier.as_bytes()));
+    let redirect = format!("http://127.0.0.1:{port}/callback");
+    let scope = if provider.offline_access {
+        "openid offline_access"
+    } else {
+        "openid"
+    };
+    let mut url = provider.authorization.clone();
+    url.query_pairs_mut()
+        .append_pair("response_type", "code")
+        .append_pair("client_id", &config.client_id)
+        .append_pair("redirect_uri", &redirect)
+        .append_pair("scope", scope)
+        .append_pair("state", &state)
+        .append_pair("nonce", &nonce)
+        .append_pair("code_challenge", &challenge)
+        .append_pair("code_challenge_method", "S256");
+    Some(Attempt {
+        state,
+        nonce,
+        verifier,
+        redirect,
+        url,
+    })
+}
+
+/// Reads a whole body up to `limit` bytes.
+async fn bounded_body(response: reqwest::Response, limit: usize) -> Result<Vec<u8>, ()> {
+    use futures_util::StreamExt;
+    if response.content_length().is_some_and(|n| n > limit as u64) {
+        return Err(());
+    }
+    let mut body = Vec::new();
+    let mut stream = response.bytes_stream();
+    while let Some(chunk) = stream.next().await {
+        let chunk = chunk.map_err(|_| ())?;
+        if body.len() + chunk.len() > limit {
+            return Err(());
+        }
+        body.extend_from_slice(&chunk);
+    }
+    Ok(body)
+}
+
+fn transient(status: u16) -> bool {
+    matches!(status, 500 | 502 | 503 | 504)
+}
+
+fn string(value: Option<&Value>, max: usize) -> Option<&str> {
+    value
+        .and_then(Value::as_str)
+        .filter(|s| !s.is_empty() && s.len() <= max)
+}
+
+fn token(value: Option<&Value>) -> Option<Zeroizing<String>> {
+    string(value, TOKEN_LIMIT)
+        .filter(|s| s.bytes().all(|b| b.is_ascii_graphic()))
+        .map(|s| Zeroizing::new(s.to_owned()))
+}
+
+/// The provider's identity endpoints over the app-owned HTTP client.
+#[derive(Clone)]
+pub struct IdentityClient {
+    http: reqwest::Client,
+}
+
+impl IdentityClient {
+    pub fn new(http: reqwest::Client) -> Self {
+        Self { http }
+    }
+
+    async fn json(
+        &self,
+        request: reqwest::RequestBuilder,
+        limit: usize,
+    ) -> Result<(u16, Map<String, Value>), SignInFailure> {
+        let response = request
+            .timeout(TIMEOUT)
+            .header("accept", "application/json")
+            .send()
+            .await
+            .map_err(|_| SignInFailure::Network)?;
+        let status = response.status().as_u16();
+        if (300..400).contains(&status) {
+            return Err(SignInFailure::InvalidResponse);
+        }
+        let invalid = if transient(status) {
+            SignInFailure::Network
+        } else {
+            SignInFailure::InvalidResponse
+        };
+        let body = bounded_body(response, limit).await.map_err(|()| invalid)?;
+        // Revocation may answer with an empty success.
+        if body.iter().all(u8::is_ascii_whitespace) {
+            return Ok((status, Map::new()));
+        }
+        match serde_json::from_slice::<Value>(&body) {
+            Ok(Value::Object(map)) => Ok((status, map)),
+            _ => Err(invalid),
+        }
+    }
+
+    async fn form(
+        &self,
+        url: &Url,
+        values: &[(&str, &str)],
+    ) -> Result<(u16, Map<String, Value>), SignInFailure> {
+        let body = url::form_urlencoded::Serializer::new(String::new())
+            .extend_pairs(values)
+            .finish();
+        self.json(
+            self.http
+                .post(url.clone())
+                .header("content-type", "application/x-www-form-urlencoded")
+                .body(body),
+            REPLY_LIMIT,
+        )
+        .await
+    }
+
+    /// OpenID discovery: the document must name exactly the configured
+    /// issuer, support the code flow with S256, and keep every endpoint
+    /// HTTPS on the issuer's origin.
+    pub async fn discover(&self, config: &SsoConfig) -> Result<Provider, SignInFailure> {
+        let (status, body) = self
+            .json(
+                self.http.get(format!(
+                    "{}/.well-known/openid-configuration",
+                    config.issuer
+                )),
+                REPLY_LIMIT,
+            )
+            .await?;
+        if transient(status) {
+            return Err(SignInFailure::Network);
+        }
+        let invalid = SignInFailure::InvalidConfig;
+        if status != 200 || string(body.get("issuer"), 2048) != Some(config.issuer.as_str()) {
+            return Err(invalid);
+        }
+        let origin = config.origin();
+        let endpoint = |key: &str| {
+            string(body.get(key), 2048)
+                .and_then(https)
+                .filter(|u| u.origin().ascii_serialization() == origin)
+        };
+        let listed = |key: &str, want: &str| {
+            body.get(key)
+                .and_then(Value::as_array)
+                .is_some_and(|items| items.iter().any(|v| v.as_str() == Some(want)))
+        };
+        if !listed("code_challenge_methods_supported", "S256")
+            || !listed("response_types_supported", "code")
+        {
+            return Err(invalid);
+        }
+        Ok(Provider {
+            authorization: endpoint("authorization_endpoint").ok_or(invalid)?,
+            token: endpoint("token_endpoint").ok_or(invalid)?,
+            jwks: endpoint("jwks_uri").ok_or(invalid)?,
+            revocation: match body.get("revocation_endpoint") {
+                None | Some(Value::Null) => None,
+                Some(_) => Some(endpoint("revocation_endpoint").ok_or(invalid)?),
+            },
+            offline_access: listed("scopes_supported", "offline_access"),
+            iss_in_callback: body.get("authorization_response_iss_parameter_supported")
+                == Some(&Value::Bool(true)),
+        })
+    }
+
+    /// The issuer's signing keys.
+    pub async fn keys(&self, provider: &Provider) -> Result<JwkSet, SignInFailure> {
+        let (status, body) = self
+            .json(self.http.get(provider.jwks.clone()), JWKS_LIMIT)
+            .await?;
+        if transient(status) {
+            return Err(SignInFailure::Network);
+        }
+        if status != 200 {
+            return Err(SignInFailure::InvalidConfig);
+        }
+        let keys = body
+            .get("keys")
+            .and_then(Value::as_array)
+            .filter(|k| k.len() <= MAX_KEYS)
+            .ok_or(SignInFailure::InvalidConfig)?;
+        // A key this verifier cannot read is skipped, never fatal: providers
+        // publish encryption and symmetric entries too.
+        let keys = keys
+            .iter()
+            .filter_map(|k| serde_json::from_value::<Jwk>(k.clone()).ok())
+            .collect();
+        Ok(JwkSet { keys })
+    }
+
+    fn tokens(status: u16, body: &Map<String, Value>) -> Result<Tokens, SignInFailure> {
+        if !(200..300).contains(&status) {
+            return Err(match (status, string(body.get("error"), 128)) {
+                (_, Some("invalid_grant" | "access_denied" | "unauthorized_client")) => {
+                    SignInFailure::Denied
+                }
+                (s, _) if transient(s) => SignInFailure::Network,
+                _ => SignInFailure::InvalidResponse,
+            });
+        }
+        if !string(body.get("token_type"), 32).is_some_and(|t| t.eq_ignore_ascii_case("bearer")) {
+            return Err(SignInFailure::InvalidResponse);
+        }
+        let access = token(body.get("access_token")).ok_or(SignInFailure::InvalidResponse)?;
+        let id_token = match body.get("id_token") {
+            None | Some(Value::Null) => None,
+            v => Some(token(v).ok_or(SignInFailure::InvalidResponse)?),
+        };
+        let refresh = match body.get("refresh_token") {
+            None | Some(Value::Null) => None,
+            v => Some(token(v).ok_or(SignInFailure::InvalidResponse)?),
+        };
+        Ok(Tokens {
+            access,
+            id_token,
+            refresh,
+        })
+    }
+
+    /// Exchanges the callback's code (with the PKCE verifier).
+    pub async fn exchange(
+        &self,
+        provider: &Provider,
+        config: &SsoConfig,
+        attempt: &Attempt,
+        code: &str,
+    ) -> Result<Tokens, SignInFailure> {
+        let (status, body) = self
+            .form(
+                &provider.token,
+                &[
+                    ("grant_type", "authorization_code"),
+                    ("client_id", &config.client_id),
+                    ("code", code),
+                    ("redirect_uri", &attempt.redirect),
+                    ("code_verifier", &attempt.verifier),
+                ],
+            )
+            .await?;
+        let tokens = Self::tokens(status, &body)?;
+        if tokens.id_token.is_none() {
+            return Err(SignInFailure::InvalidResponse);
+        }
+        Ok(tokens)
+    }
+
+    /// Renews the access token. A refused refresh means signing in again.
+    pub async fn refresh(
+        &self,
+        provider: &Provider,
+        config: &SsoConfig,
+        refresh_token: &str,
+    ) -> Result<Tokens, SignInFailure> {
+        let (status, body) = self
+            .form(
+                &provider.token,
+                &[
+                    ("grant_type", "refresh_token"),
+                    ("client_id", &config.client_id),
+                    ("refresh_token", refresh_token),
+                ],
+            )
+            .await?;
+        Self::tokens(status, &body).map_err(|failure| match failure {
+            SignInFailure::Denied => SignInFailure::SessionExpired,
+            other => other,
+        })
+    }
+
+    /// Revokes a refresh token (best effort by the caller).
+    pub async fn revoke(
+        &self,
+        provider: &Provider,
+        config: &SsoConfig,
+        refresh_token: &str,
+    ) -> Result<(), SignInFailure> {
+        let Some(url) = &provider.revocation else {
+            return Ok(());
+        };
+        let (status, _) = self
+            .form(
+                url,
+                &[
+                    ("client_id", &config.client_id),
+                    ("token", refresh_token),
+                    ("token_type_hint", "refresh_token"),
+                ],
+            )
+            .await?;
+        if (200..300).contains(&status) {
+            Ok(())
+        } else {
+            Err(SignInFailure::InvalidResponse)
+        }
+    }
+}
+
+/// The decoding key for `kid` and `alg`, if the set has a matching
+/// signature key of the right type, curve and size.
+fn decoding_key(keys: &JwkSet, kid: Option<&str>, alg: Algorithm) -> Option<DecodingKey> {
+    keys.keys.iter().find_map(|jwk| {
+        if kid.is_some() && jwk.common.key_id.as_deref() != kid {
+            return None;
+        }
+        if matches!(jwk.common.public_key_use, Some(ref u) if *u != PublicKeyUse::Signature) {
+            return None;
+        }
+        if let Some(declared) = jwk.common.key_algorithm
+            && declared.to_string() != format!("{alg:?}")
+        {
+            return None;
+        }
+        let fits = match (&jwk.algorithm, alg) {
+            (
+                AlgorithmParameters::RSA(rsa),
+                Algorithm::RS256
+                | Algorithm::RS384
+                | Algorithm::RS512
+                | Algorithm::PS256
+                | Algorithm::PS384
+                | Algorithm::PS512,
+            ) => base64::engine::general_purpose::URL_SAFE_NO_PAD
+                .decode(rsa.n.as_bytes())
+                .is_ok_and(|n| n.len() >= MIN_RSA_BYTES),
+            (AlgorithmParameters::EllipticCurve(ec), Algorithm::ES256) => {
+                ec.curve == EllipticCurve::P256
+            }
+            (AlgorithmParameters::EllipticCurve(ec), Algorithm::ES384) => {
+                ec.curve == EllipticCurve::P384
+            }
+            (AlgorithmParameters::OctetKeyPair(okp), Algorithm::EdDSA) => {
+                okp.curve == EllipticCurve::Ed25519
+            }
+            _ => false,
+        };
+        fits.then(|| DecodingKey::from_jwk(jwk).ok()).flatten()
+    })
+}
+
+/// Why one verification did not pass: an unknown key may be fetched again.
+enum Unverified {
+    UnknownKey,
+    Invalid,
+}
+
+/// Checks the signature with the set's key; claims are checked by the
+/// caller against the supplied clock.
+fn verified_claims(token: &str, keys: &JwkSet) -> Result<Map<String, Value>, Unverified> {
+    if token.len() > TOKEN_LIMIT || token.split('.').count() != 3 {
+        return Err(Unverified::Invalid);
+    }
+    let header = jsonwebtoken::decode_header(token).map_err(|_| Unverified::Invalid)?;
+    // Only asymmetric algorithms: never `none` and never a shared secret.
+    if !ALGORITHMS.contains(&header.alg) {
+        return Err(Unverified::Invalid);
+    }
+    let key =
+        decoding_key(keys, header.kid.as_deref(), header.alg).ok_or(Unverified::UnknownKey)?;
+    let mut validation = Validation::new(header.alg);
+    validation.algorithms = vec![header.alg];
+    // Time and audience are judged below on the caller's clock.
+    validation.validate_exp = false;
+    validation.validate_nbf = false;
+    validation.validate_aud = false;
+    validation.required_spec_claims.clear();
+    jsonwebtoken::decode::<Map<String, Value>>(token, &key, &validation)
+        .map(|data| data.claims)
+        .map_err(|_| Unverified::Invalid)
+}
+
+fn audience_has(claims: &Map<String, Value>, want: &str) -> (bool, usize) {
+    match claims.get("aud") {
+        Some(Value::String(one)) => (one == want, 1),
+        Some(Value::Array(many)) => (many.iter().any(|v| v.as_str() == Some(want)), many.len()),
+        _ => (false, 0),
+    }
+}
+
+/// `exp` in the future, `nbf` and `iat` not after now (each with skew).
+fn timely(claims: &Map<String, Value>, now: u64) -> Option<(u64, u64)> {
+    let exp = claims.get("exp")?.as_u64()?;
+    let iat = claims.get("iat")?.as_u64()?;
+    if exp + SKEW <= now || iat > now + SKEW || iat >= exp {
+        return None;
+    }
+    if let Some(nbf) = claims.get("nbf")
+        && nbf.as_u64()? > now + SKEW
+    {
+        return None;
+    }
+    Some((exp, iat))
+}
