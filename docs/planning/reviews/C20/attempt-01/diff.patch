+        assert!(!text.contains(secret), "{secret}");
+    }
+    let out = dispatch(
+        &mut h,
+        json!({"kind": "signOutHarness", "context": context}),
+    );
+    assert_eq!(out["outcome"], "receipt");
+    assert!(wait_shell(&h, |v| v["harness"]["signIn"]["account"].is_null())["harness"]["signIn"]["account"].is_null());
+}
