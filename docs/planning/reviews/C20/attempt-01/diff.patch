diff --git a/apps/desktop/src/features/harness/history-panel.tsx b/apps/desktop/src/features/harness/history-panel.tsx
new file mode 100644
index 0000000..4e4b08a
--- /dev/null
+++ b/apps/desktop/src/features/harness/history-panel.tsx
@@ -0,0 +1,252 @@
+import { useEffect, useId, useRef, useState } from 'react'
+import { Button } from '@ai-security-academy/presentation'
+import type {
+    ContextRef,
+    HarnessHistoryView,
+    HistoryFailure,
+    HistoryFormat,
+    NotContinuable,
+    SelectedWorkspace,
+} from '@prisma-airs/desktop-contracts'
+import type { Dispatch } from '../tenants/dispatch'
+
+/** Why protected history could not be read or written. */
+export const HISTORY_FAILURE_TEXT: Record<HistoryFailure, string> = {
+    locked: 'The Keychain is locked, so saved conversations cannot be read or saved. Nothing was written unencrypted.',
+    denied: 'macOS did not allow access to the history key. Nothing was written unencrypted.',
+    unavailable: 'Saved conversations are not available on this Mac right now.',
+    full: 'This workspace already keeps 16 saved conversations. Delete one to keep new conversations.',
+    tooLarge: 'This conversation is too large to save.',
+    unreadable: 'This saved conversation cannot be read with this workspace’s key.',
+    missing: 'That saved conversation no longer exists.',
+}
+
+const NOT_CONTINUABLE_TEXT: Record<NotContinuable, string> = {
+    running: 'This is the conversation running now.',
+    otherCredential:
+        'It ran with another key, sign-in or endpoint than this workspace uses now, so it can be read and exported but not continued.',
+    engineUnavailable: 'The Harness engine is not bundled with this build.',
+}
+
+const FORMATS: readonly [HistoryFormat, string][] = [
+    ['markdown', 'Markdown'],
+    ['text', 'Plain text'],
+    ['json', 'JSON'],
+]
+
+export function savedAt(seconds: number): string {
+    return new Date(seconds * 1000).toLocaleString(undefined, { dateStyle: 'medium', timeStyle: 'short' })
+}
+
+interface Props {
+    context: ContextRef
+    selected: SelectedWorkspace
+    history: HarnessHistoryView | null
+    /** A conversation is running (one at a time). */
+    running: boolean
+    dispatch: Dispatch
+    onMessage: (message: string | null) => void
+}
+
+/**
+ * The chosen workspace's saved conversations (C20): saved encrypted on this
+ * Mac after every answer. One can be read, exported, deleted, or continued
+ * in a new engine when it ran with the credential this workspace uses now.
+ */
+export function HistoryPanel({ context, selected, history, running, dispatch, onMessage }: Props) {
+    const ids = useId()
+    const [format, setFormat] = useState<HistoryFormat>('markdown')
+    const [confirming, setConfirming] = useState<string | null>(null)
+    const openedRef = useRef<HTMLHeadingElement>(null)
+    const listRef = useRef<HTMLHeadingElement>(null)
+    const workspace = selected.reference
+
+    // Read the list whenever the chosen workspace changes.
+    useEffect(() => {
+        void dispatch({ kind: 'listHarnessHistory', context, workspace })
+    }, [dispatch, context, workspace])
+
+    const opened = history?.opened ?? null
+    const wasOpened = useRef<string | null>(opened?.id ?? null)
+    useEffect(() => {
+        const was = wasOpened.current
+        wasOpened.current = opened?.id ?? null
+        if (opened && opened.id !== was) openedRef.current?.focus()
+        if (!opened && was !== null) listRef.current?.focus()
+    }, [opened])
+
+    async function send(intent: Parameters<Dispatch>[0]): Promise<boolean> {
+        onMessage(null)
+        const outcome = await dispatch(intent)
+        if (outcome.kind !== 'admitted') onMessage('That was not done.')
+        return outcome.kind === 'admitted'
+    }
+
+    const busy = history?.busy ?? false
+    const exportState = history?.export ?? null
+    return (
+        <section aria-labelledby={`${ids}-heading`} className='flex flex-col gap-3' data-slot='harness-history'>
+            <h2 ref={listRef} tabIndex={-1} id={`${ids}-heading`} className='text-[15px] font-semibold'>
+                Saved conversations
+            </h2>
+            <p className='text-academy-ink-faint text-[12px]'>
+                {`Conversations in ${selected.workspace.name} are saved on this Mac after every answer, encrypted with a key kept in the Keychain. Up to 16 are kept; nothing is deleted to make room.`}
+            </p>
+            {history === null || history.state === 'loading' ? (
+                <p role='status' className='text-[13px]'>
+                    Reading saved conversations…
+                </p>
+            ) : history.state === 'failed' && history.failure ? (
+                <p role='alert' className='text-academy-accent-warn text-[13px]'>
+                    {HISTORY_FAILURE_TEXT[history.failure]}
+                </p>
+            ) : history.conversations.length === 0 && history.unreadable.length === 0 ? (
+                <p className='text-[13px]'>No saved conversations in this workspace.</p>
+            ) : (
+                <ul role='list' aria-label='Saved conversations' className='flex flex-col gap-2' data-slot='harness-history-list'>
+                    {history.conversations.map((c) => (
+                        <li key={c.id} className='border-academy-rule flex flex-wrap items-center gap-3 rounded-[12px] border p-3'>
+                            <span className='flex min-w-0 flex-1 flex-col'>
+                                <span className='truncate text-[14px]'>{c.title || 'Untitled conversation'}</span>
+                                <span className='text-academy-ink-faint text-[12px]'>
+                                    {`${c.entries} messages · ${savedAt(c.updated)} · ${c.source === 'companySignIn' ? 'company sign-in' : 'workspace key'}`}
+                                </span>
+                            </span>
+                            <Button
+                                type='button'
+                                tier='secondary'
+                                size='sm'
+                                disabled={busy}
+                                aria-label={`Open ${c.title || 'untitled conversation'}`}
+                                onClick={() => void send({ kind: 'openHarnessHistory', context, workspace, id: c.id })}
+                            >
+                                Open
+                            </Button>
+                        </li>
+                    ))}
+                    {history.unreadable.map((id) => (
+                        <li key={id} className='border-academy-rule flex flex-wrap items-center gap-3 rounded-[12px] border p-3'>
+                            <span className='text-academy-ink-faint flex-1 text-[13px]'>{HISTORY_FAILURE_TEXT.unreadable}</span>
+                            <Button
+                                type='button'
+                                tier='tertiary'
+                                size='sm'
+                                disabled={busy}
+                                onClick={() => void send({ kind: 'deleteHarnessHistory', context, workspace, id })}
+                            >
+                                Delete unreadable conversation
+                            </Button>
+                        </li>
+                    ))}
+                </ul>
+            )}
+            {history?.full ? <p className='text-academy-accent-warn text-[13px]'>{HISTORY_FAILURE_TEXT.full}</p> : null}
+            {history?.problem ? (
+                <p role='alert' className='text-academy-accent-warn text-[13px]' data-slot='harness-history-problem'>
+                    {HISTORY_FAILURE_TEXT[history.problem]}
+                </p>
+            ) : null}
+            {opened ? (
+                <section aria-labelledby={`${ids}-opened`} className='flex flex-col gap-3' data-slot='harness-history-opened'>
+                    <h3 ref={openedRef} tabIndex={-1} id={`${ids}-opened`} className='text-[14px] font-semibold'>
+                        {opened.title || 'Untitled conversation'}
+                    </h3>
+                    <p className='text-academy-ink-faint text-[12px]'>{`Saved ${savedAt(opened.updated)}`}</p>
+                    <ol role='list' aria-label='Saved messages' className='flex flex-col gap-2'>
+                        {opened.entries.map((e) => (
+                            <li key={e.id} className='border-academy-rule rounded-[12px] border p-3'>
+                                <p className='text-academy-ink-faint text-[12px] font-semibold'>{e.role === 'operator' ? 'You' : 'Harness'}</p>
+                                <p className='text-[14px] whitespace-pre-wrap'>{e.text}</p>
+                            </li>
+                        ))}
+                    </ol>
+                    {opened.notContinuable ? <p className='text-[13px]'>{NOT_CONTINUABLE_TEXT[opened.notContinuable]}</p> : null}
+                    <div className='flex flex-wrap items-end gap-2'>
+                        {opened.notContinuable === null ? (
+                            <Button
+                                type='button'
+                                tier='primary'
+                                size='sm'
+                                disabled={busy || running}
+                                onClick={() => void send({ kind: 'resumeHarness', context, workspace, id: opened.id })}
+                            >
+                                Continue this conversation
+                            </Button>
+                        ) : null}
+                        <label className='flex flex-col gap-1 text-[12px]'>
+                            <span>Export as</span>
+                            <select
+                                value={format}
+                                onChange={(event) => setFormat(event.target.value as HistoryFormat)}
+                                className='border-academy-rule rounded-[8px] border p-1 text-[13px]'
+                            >
+                                {FORMATS.map(([value, label]) => (
+                                    <option key={value} value={value}>
+                                        {label}
+                                    </option>
+                                ))}
+                            </select>
+                        </label>
+                        <Button
+                            type='button'
+                            tier='secondary'
+                            size='sm'
+                            disabled={exportState?.state === 'saving'}
+                            onClick={() => void send({ kind: 'exportHarnessHistory', context, workspace, id: opened.id, format })}
+                        >
+                            Export…
+                        </Button>
+                        {confirming === opened.id ? (
+                            <>
+                                <Button
+                                    type='button'
+                                    tier='secondary'
+                                    size='sm'
+                                    disabled={busy}
+                                    onClick={async () => {
+                                        setConfirming(null)
+                                        await send({ kind: 'deleteHarnessHistory', context, workspace, id: opened.id })
+                                    }}
+                                >
+                                    Delete permanently
+                                </Button>
+                                <Button type='button' tier='tertiary' size='sm' onClick={() => setConfirming(null)}>
+                                    Keep it
+                                </Button>
+                            </>
+                        ) : (
+                            <Button
+                                type='button'
+                                tier='tertiary'
+                                size='sm'
+                                disabled={busy || opened.notContinuable === 'running'}
+                                onClick={() => setConfirming(opened.id)}
+                            >
+                                Delete…
+                            </Button>
+                        )}
+                        <Button type='button' tier='tertiary' size='sm' onClick={() => void send({ kind: 'closeHarnessHistory', context, workspace })}>
+                            Close
+                        </Button>
+                    </div>
+                    {confirming === opened.id ? (
+                        <p role='alert' className='text-[13px]'>
+                            Delete this saved conversation from this Mac? It cannot be recovered.
+                        </p>
+                    ) : null}
+                    {exportState ? (
+                        <p role='status' className='text-[13px]' data-slot='harness-export'>
+                            {exportState.state === 'saving'
+                                ? 'Choose where to save the transcript…'
+                                : exportState.state === 'saved'
+                                  ? `Saved ${exportState.name ?? 'the transcript'}.`
+                                  : exportState.state === 'cancelled'
+                                    ? 'Export cancelled.'
+                                    : 'The transcript could not be saved.'}
+                        </p>
+                    ) : null}
+                </section>
+            ) : null}
+        </section>
+    )
+}
diff --git a/apps/desktop/src/features/harness/sign-in-panel.tsx b/apps/desktop/src/features/harness/sign-in-panel.tsx
new file mode 100644
index 0000000..90e1560
--- /dev/null
+++ b/apps/desktop/src/features/harness/sign-in-panel.tsx
@@ -0,0 +1,219 @@
+import { type FormEvent, useId, useState } from 'react'
+import { Button, Input } from '@ai-security-academy/presentation'
+import type {
+    ContextRef,
+    CredentialSource,
+    HarnessSignInView,
+    SelectedWorkspace,
+    SignInFailure,
+    SignInStep,
+} from '@prisma-airs/desktop-contracts'
+import type { Dispatch } from '../tenants/dispatch'
+
+/** Why company sign-in or its renewal failed, as the operator reads it. */
+export const SIGN_IN_FAILURE_TEXT: Record<SignInFailure, string> = {
+    invalidConfig:
+        'The identity provider’s configuration could not be used: it must name this issuer, support PKCE with S256 and keep its endpoints on the issuer’s own address.',
+    network: 'The identity provider could not be reached. Try again.',
+    invalidResponse: 'The identity provider returned something this app does not accept.',
+    denied: 'Sign-in was declined.',
+    timedOut: 'The browser did not come back within five minutes.',
+    cancelled: 'Sign-in was cancelled.',
+    browserUnavailable: 'The browser could not be opened.',
+    callbackUnavailable: 'The sign-in callback could not be opened on this Mac.',
+    invalidToken: 'A token from the identity provider did not verify (signature, issuer, audience, client or time).',
+    opaqueToken: 'The identity provider’s Gateway token is not a signed JWT, which this app requires.',
+    wrongWorkspace: 'The token is for another Gateway workspace.',
+    differentAccount: 'A different account signed in. Sign out first to use another account.',
+    sessionExpired: 'Your sign-in has expired. Sign in again to send.',
+    storeFailed: 'The sign-in could not be kept in the Keychain.',
+}
+
+const STEP_TEXT: Record<SignInStep, string> = {
+    contacting: 'Contacting the identity provider…',
+    browser: 'Continue in your browser. This app is waiting for it to come back.',
+    completing: 'Verifying the sign-in…',
+}
+
+interface Props {
+    context: ContextRef
+    selected: SelectedWorkspace
+    signIn: HarnessSignInView | null
+    /** The workspace key is stored for the chosen workspace. */
+    keyHere: boolean
+    /** A conversation is running (changing the credential ends it). */
+    running: boolean
+    dispatch: Dispatch
+    onMessage: (message: string | null) => void
+}
+
+/**
+ * Which credential the Harness answers with (C20): the workspace inference
+ * key, or a company sign-in through the browser whose Gateway token is
+ * renewed before it is sent.
+ */
+export function SignInPanel({ context, selected, signIn, keyHere, running, dispatch, onMessage }: Props) {
+    const ids = useId()
+    const here = signIn !== null && signIn.workspace.id === selected.workspace.id
+    const [editing, setEditing] = useState(false)
+    const [busy, setBusy] = useState(false)
+    const source: CredentialSource = here && signIn.selected ? 'companySignIn' : 'workspaceKey'
+
+    async function send(intent: Parameters<Dispatch>[0]): Promise<boolean> {
+        onMessage(null)
+        setBusy(true)
+        try {
+            const outcome = await dispatch(intent)
+            if (outcome.kind !== 'admitted') onMessage('That was not done. Check the values and try again.')
+            return outcome.kind === 'admitted'
+        } finally {
+            setBusy(false)
+        }
+    }
+
+    async function configure(event: FormEvent<HTMLFormElement>) {
+        event.preventDefault()
+        const form = new FormData(event.currentTarget)
+        const value = (name: string) => String(form.get(name) ?? '').trim()
+        const saved = await send({
+            kind: 'configureHarnessSignIn',
+            context,
+            workspace: selected.reference,
+            endpoint: value('endpoint'),
+            issuer: value('issuer'),
+            clientId: value('client'),
+            audience: value('audience'),
+        })
+        if (saved) setEditing(false)
+    }
+
+    const signedIn = here && signIn.account !== null
+    const step = here ? signIn.step : null
+    return (
+        <section aria-labelledby={`${ids}-heading`} className='flex flex-col gap-3' data-slot='harness-credential'>
+            <h2 id={`${ids}-heading`} className='text-[15px] font-semibold'>
+                Gateway credential
+            </h2>
+            {here ? (
+                <fieldset className='flex flex-col gap-1' disabled={busy}>
+                    <legend className='text-academy-ink text-[13px] font-medium'>Answer with</legend>
+                    {(
+                        [
+                            ['workspaceKey', 'The workspace inference key', keyHere ? 'Stored in AI Gateway' : 'Not stored for this workspace'],
+                            ['companySignIn', 'Company sign-in', signedIn ? `Signed in as ${signIn.account}` : 'Not signed in'],
+                        ] as const
+                    ).map(([value, label, hint]) => (
+                        <label key={value} className='flex min-h-11 cursor-pointer items-center gap-3'>
+                            <input
+                                type='radio'
+                                name={`${ids}-source`}
+                                value={value}
+                                checked={source === value}
+                                onChange={() => void send({ kind: 'chooseHarnessCredential', context, source: value })}
+                                className='size-4 accent-[var(--academy-accent)]'
+                            />
+                            <span className='flex flex-col'>
+                                <span className='text-academy-ink text-[13px]'>{label}</span>
+                                <span className='text-academy-ink-faint text-[12px]'>{hint}</span>
+                            </span>
+                        </label>
+                    ))}
+                    {running ? <p className='text-academy-ink-faint text-[12px]'>Changing the credential ends the running conversation.</p> : null}
+                </fieldset>
+            ) : null}
+            {!here && !editing ? (
+                <Button type='button' tier='tertiary' size='sm' className='self-start' onClick={() => setEditing(true)}>
+                    Set up company sign-in
+                </Button>
+            ) : here && !editing ? (
+                <div className='flex flex-col gap-2' data-slot='harness-sign-in'>
+                    <dl className='grid grid-cols-[auto_1fr] gap-x-4 gap-y-1 text-[13px]'>
+                        <dt className='text-academy-ink-faint'>Identity provider</dt>
+                        <dd className='font-mono text-[12px] break-all'>{signIn.issuer}</dd>
+                        <dt className='text-academy-ink-faint'>Client ID</dt>
+                        <dd className='font-mono text-[12px] break-all'>{signIn.clientId}</dd>
+                        <dt className='text-academy-ink-faint'>Gateway audience</dt>
+                        <dd className='font-mono text-[12px] break-all'>{signIn.audience}</dd>
+                        <dt className='text-academy-ink-faint'>Gateway endpoint</dt>
+                        <dd className='font-mono text-[12px] break-all'>{signIn.endpoint}</dd>
+                    </dl>
+                    {step ? (
+                        <p role='status' className='text-[13px]' data-slot='harness-sign-in-step'>
+                            {STEP_TEXT[step]}
+                        </p>
+                    ) : null}
+                    {signIn.failure ? (
+                        <p role='alert' className='text-academy-accent-warn text-[13px]' data-slot='harness-sign-in-failure'>
+                            {SIGN_IN_FAILURE_TEXT[signIn.failure]}
+                        </p>
+                    ) : null}
+                    <div className='flex flex-wrap gap-2'>
+                        {step ? (
+                            <Button type='button' tier='secondary' size='sm' onClick={() => void send({ kind: 'cancelHarnessSignIn', context })}>
+                                Cancel sign-in
+                            </Button>
+                        ) : (
+                            <Button type='button' tier='primary' size='sm' disabled={busy} onClick={() => void send({ kind: 'signInHarness', context })}>
+                                {signedIn ? 'Sign in again' : 'Sign in with your browser'}
+                            </Button>
+                        )}
+                        {signedIn ? (
+                            <Button type='button' tier='secondary' size='sm' disabled={busy} onClick={() => void send({ kind: 'signOutHarness', context })}>
+                                Sign out
+                            </Button>
+                        ) : (
+                            <Button type='button' tier='tertiary' size='sm' disabled={busy || step !== null} onClick={() => setEditing(true)}>
+                                Change identity provider
+                            </Button>
+                        )}
+                        <Button
+                            type='button'
+                            tier='tertiary'
+                            size='sm'
+                            disabled={busy}
+                            onClick={() => void send({ kind: 'removeHarnessSignIn', context })}
+                        >
+                            Remove company sign-in
+                        </Button>
+                    </div>
+                </div>
+            ) : (
+                <form className='flex flex-col gap-2' onSubmit={(event) => void configure(event)} data-slot='harness-sign-in-form'>
+                    <p className='text-academy-ink-faint text-[12px]'>
+                        {`Use your company’s identity provider for ${selected.workspace.name} instead of the workspace key. The Gateway token is a signed JWT verified against the provider’s keys, kept in memory, and renewed before it expires; only the refresh token is kept, in the Keychain.`}
+                    </p>
+                    {(
+                        [
+                            ['endpoint', 'Gateway endpoint', here ? signIn.endpoint : '', 'https://'],
+                            ['issuer', 'Identity provider (issuer URL)', here ? signIn.issuer : '', 'https://'],
+                            ['client', 'Client ID', here ? signIn.clientId : '', ''],
+                            ['audience', 'Gateway audience', here ? signIn.audience : '', ''],
+                        ] as const
+                    ).map(([name, label, value, placeholder]) => (
+                        <label key={name} className='flex flex-col gap-1 text-[13px]'>
+                            <span className='text-academy-ink font-medium'>{label}</span>
+                            <Input
+                                name={name}
+                                defaultValue={value}
+                                placeholder={placeholder}
+                                autoCapitalize='off'
+                                autoCorrect='off'
+                                spellCheck={false}
+                                required
+                                maxLength={2048}
+                            />
+                        </label>
+                    ))}
+                    <div className='flex flex-wrap gap-2'>
+                        <Button type='submit' tier='secondary' size='sm' disabled={busy}>
+                            Save company sign-in
+                        </Button>
+                        <Button type='button' tier='tertiary' size='sm' onClick={() => setEditing(false)}>
+                            Cancel
+                        </Button>
+                    </div>
+                </form>
+            )}
+        </section>
+    )
+}
