+    let id = ready(&mut desk, &reference).await;
+    assert_eq!(started(&desk, "tools").await["status"], "ready");
+    desk.gateway.lock().expect("gateway").answer = Answer::Short;
+    desk.say(&id, "Hello.").await.expect("sent");
+    turn_ended(&mut desk, 2).await;
