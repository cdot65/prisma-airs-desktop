/* ─────────────────────────────────────────────────────────────────────────
 * AI SECURITY ACADEMY · DESIGN TOKENS (@ai-security-academy/presentation)
 *
 * Ported from the design handoff:
 *   - colors_and_type.css → structural tokens (fonts, radii, spacing, easing,
 *     durations). Theme-invariant; declared once on :root.
 *   - The --academy-* color contract ships two GENERAL themes here: Gruvbox
 *     dark is the :root default (mirrored under [data-theme='gruvbox']) and
 *     Paper is the light alternate ([data-theme='paper']). Defaulting on
 *     :root keeps the first CSS paint dark with zero JS.
 *   - Earned skins (Vegas Afterglow, Phosphor, Noir, Solar Flare) are Academy
 *     gamification and live in the web app (src/styles/earned-themes.css),
 *     never in this package.
 *
 * Components consume var(--academy-*) tokens (directly or via the Tailwind
 * `academy-*` utilities wired in ./theme.css) — never hex literals. Font
 * families are named here; each consumer loads the font files itself.
 * ───────────────────────────────────────────────────────────────────────── */

:root {
    /* ── Structural (theme-invariant) ── */
    --academy-font-display:
        'Inter Variable', 'Inter', system-ui, -apple-system, sans-serif;
    --academy-font-body:
        'Inter Variable', 'Inter', system-ui, -apple-system, sans-serif;
    --academy-font-mono:
        'JetBrains Mono Variable', 'JetBrains Mono', ui-monospace,
        'SFMono-Regular', monospace;
    --academy-handwriting: 'Caveat Variable', 'Caveat', cursive;

    --academy-radius-sm: 6px;
    --academy-radius-md: 9px;
    --academy-radius-lg: 12px;
    --academy-radius-xl: 16px;

    --academy-space-1: 4px;
    --academy-space-2: 8px;
    --academy-space-3: 12px;
    --academy-space-4: 16px;
    --academy-space-5: 24px;
    --academy-space-6: 32px;
    --academy-space-7: 48px;
    --academy-space-8: 64px;

    /* Canonical content-column width — every routed screen fills the shell's
     * centered container (app-shell reads this as its default maxWidth), so
     * page-to-page transitions keep one seamless content edge. Pages must NOT
     * re-cap their roots; reading-measure caps inside (e.g. the lesson
     * article's 760px) are fine. */
    --academy-content-max: 1040px;

    --academy-ease: cubic-bezier(0.2, 0.9, 0.3, 1);
    --academy-ease-in: cubic-bezier(0.4, 0, 1, 1);
    --academy-dur-1: 120ms;
    --academy-dur-2: 180ms;
    --academy-dur-3: 280ms;
    --academy-dur-4: 420ms;

    /* ── Accent hue — THE one runtime accent knob (R40/F25) ──────────────────
     * theme/accent.ts writes ONLY this token when the learner picks an accent
     * (orange 40 · aqua 150 · yellow 85 · blue 240 · mauve 355). Each theme
     * block below fixes the perceptual weight (--academy-accent-l/-c) and
     * derives --academy-accent(-soft/-ring) via oklch(), so a recolor is a
     * pure hue rotation and a theme flip re-derives the accent with zero JS.
     * Every pickable hue passes AA in every theme block — enforced by the
     * ratio suite in src/styles/__tests__/theme-tokens.test.ts. */
    --academy-accent-h: 40;

    /* Focus indicator (WCAG 2.4.7 / 1.4.11) — accent nudged toward ink so the
     * ring holds ≥3:1 on every surface across all theme blocks (dark palettes
     * brighten it toward ink; light palettes darken it). Derived at usage time,
     * so it tracks the runtime hue + theme automatically. */
    --academy-focus-ring: color-mix(
        in srgb,
        var(--academy-accent) 84%,
        var(--academy-ink)
    );
}

/* ── Gruvbox dark (hard contrast) — the DEFAULT color theme ── */
