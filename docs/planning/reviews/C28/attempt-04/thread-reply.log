import { GENERAL_THEMES, applyThemeAttribute, type GeneralThemeId } from '@ai-security-academy/presentation'
import type { Theme } from '@prisma-airs/desktop-contracts'

/** Maps the desktop preference to a general shared theme (never an earned skin). */
export function resolveTheme(theme: Theme, prefersDark: boolean): GeneralThemeId {
    if (theme === 'light') return GENERAL_THEMES.light
    if (theme === 'dark') return GENERAL_THEMES.dark
    return prefersDark ? GENERAL_THEMES.dark : GENERAL_THEMES.light
}

const darkQuery = () =>
    typeof window.matchMedia === 'function'
        ? window.matchMedia('(prefers-color-scheme: dark)')
        : null

/** Applies the preference now and follows OS changes while it is `system`. */
export function followAppearance(theme: Theme): () => void {
    const query = darkQuery()
    const apply = () => applyThemeAttribute(resolveTheme(theme, query?.matches ?? true))
    apply()
    if (theme !== 'system' || !query) return () => undefined
    query.addEventListener('change', apply)
    return () => query.removeEventListener('change', apply)
}
    --academy-content-max: 1040px;

    --academy-ease: cubic-bezier(0.2, 0.9, 0.3, 1);
    --academy-ease-in: cubic-bezier(0.4, 0, 1, 1);
    --academy-dur-1: 120ms;
    --academy-dur-2: 180ms;
    --academy-dur-3: 280ms;
    --academy-dur-4: 420ms;

    /* ── Accent hue — THE one runtime accent knob (R40/F25) ──────────────────
     * theme/accent.ts writes ONLY this token when the learner picks an accent
     * (orange 40 · aqua 150 · yellow 85 · blue 240 · mauve 355). Each theme
     * block below fixes the perceptual weight (--academy-accent-l/-c) and
     * derives --academy-accent(-soft/-ring) via oklch(), so a recolor is a
     * pure hue rotation and a theme flip re-derives the accent with zero JS.
     * Every pickable hue passes AA in every theme block — enforced by the
     * ratio suite in src/styles/__tests__/theme-tokens.test.ts. */
    --academy-accent-h: 40;

    /* Focus indicator (WCAG 2.4.7 / 1.4.11) — accent nudged toward ink so the
     * ring holds ≥3:1 on every surface across all theme blocks (dark palettes
     * brighten it toward ink; light palettes darken it). Derived at usage time,
     * so it tracks the runtime hue + theme automatically. */
    --academy-focus-ring: color-mix(
        in srgb,
        var(--academy-accent) 84%,
        var(--academy-ink)
    );
}

/* ── Gruvbox dark (hard contrast) — the DEFAULT color theme ── */
:root,
[data-theme='gruvbox'] {
    color-scheme: dark;

    /* Surfaces */
    --academy-bg: #1d2021;
    --academy-bg-rail: #171a1a;
    --academy-bg-inset: rgba(0, 0, 0, 0.28);
    --academy-paper: #282828;
    --academy-paper-deep: #32302f;

