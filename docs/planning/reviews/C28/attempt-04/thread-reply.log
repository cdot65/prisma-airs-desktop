@import './styles/tokens.css';

/* Self-hosted fonts: the packaged CSP allows only bundled font files. */
@import '@fontsource-variable/inter/index.css';
@import '@fontsource-variable/jetbrains-mono/index.css';

/* Academy-owned shared presentation (ADR 0002): general tokens and themes,
 * the base focus ring/interaction helpers, and the Tailwind token layer.
 * Earned Academy skins are gamification and are not imported here. */
