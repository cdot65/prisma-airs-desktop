                    ref={heading}
                    snapshot={snapshot}
                    dispatch={props.dispatch}
                    onNavigate={props.onNavigate}
                    prefill={prefill}
                />
            ) : (
                <UnavailableView ref={heading} feature={feature} />
            )}
        </>
    )
})

