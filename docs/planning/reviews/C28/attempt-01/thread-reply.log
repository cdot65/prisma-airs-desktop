        expect(within(palette).getByRole('combobox')).toHaveFocus()
        expect(useShellStore.getState().modals).toHaveLength(1)
        await user.keyboard('{Escape}')
        expect(screen.queryByRole('dialog')).toBeNull()
        expect(trigger).toHaveFocus()
