import { useEffect, useId, useMemo, useRef, useState, type KeyboardEvent } from 'react'
import type { FeatureEntry, FeatureId, ShellSnapshot } from '@prisma-airs/desktop-contracts'
import { SHELL_COPY } from './copy'
import { Modal } from './modal'

export type PaletteEntry =
    | { kind: 'navigate'; id: string; label: string; feature: FeatureEntry }
    | { kind: 'switch'; id: string; label: string; tenant: string }
    | { kind: 'readNow'; id: string; label: string }

export interface PaletteProps {
    snapshot: ShellSnapshot
    onNavigate: (id: FeatureId) => void
    onSwitchTenant: (tenant: string) => void
    onReadNow: () => void
    onClose: () => void
}

/** The palette's entries come from the Rust inventory and the tenant list: never a TS-only registry. */
export function paletteEntries(snapshot: ShellSnapshot): PaletteEntry[] {
    const destinations: PaletteEntry[] = snapshot.features.map((feature) => ({
        kind: 'navigate',
        id: `go:${feature.id}`,
        label: feature.label,
        feature,
    }))
    // Tenants are identified as the switcher identifies them: label, environment and TSG (labels may repeat).
    const tenants: PaletteEntry[] = snapshot.tenants
        .filter((t) => t.id !== snapshot.active?.tenant)
        .map((t) => ({
            kind: 'switch',
            id: `tenant:${t.id}`,
            label: SHELL_COPY.paletteSwitch(`${t.label} · ${t.destination.kind === 'region' ? t.destination.region : 'custom'}${t.tsgId ? ` · TSG ${t.tsgId}` : ''}`),
            tenant: t.id,
        }))
    const actions: PaletteEntry[] = snapshot.active ? [{ kind: 'readNow', id: 'action:read', label: SHELL_COPY.paletteReadNow }] : []
    return [...destinations, ...tenants, ...actions]
}

export function Palette(props: PaletteProps) {
    const [query, setQuery] = useState('')
    const [index, setIndex] = useState(0)
    const input = useRef<HTMLInputElement>(null)
    const listId = useId()
    const entries = useMemo(() => paletteEntries(props.snapshot), [props.snapshot])
    const matches = useMemo(() => {
        const q = query.trim().toLowerCase()
        return q ? entries.filter((e) => e.label.toLowerCase().includes(q)) : entries
    }, [entries, query])
    useEffect(() => input.current?.focus(), [])
    const activeId = matches[index] ? `${listId}-${matches[index].id}` : undefined
    useEffect(() => {
        if (activeId) document.getElementById(activeId)?.scrollIntoView({ block: 'nearest' })
    }, [activeId])

    const choose = (entry: PaletteEntry | undefined) => {
        if (!entry) return
        if (entry.kind === 'navigate' && entry.feature.availability.state !== 'available') return
        props.onClose()
        if (entry.kind === 'navigate') props.onNavigate(entry.feature.id)
        else if (entry.kind === 'switch') props.onSwitchTenant(entry.tenant)
        else props.onReadNow()
    }
    const onKeyDown = (event: KeyboardEvent<HTMLInputElement>) => {
        if (event.key === 'ArrowDown') {
            event.preventDefault()
            setIndex((i) => Math.min(i + 1, Math.max(matches.length - 1, 0)))
        } else if (event.key === 'ArrowUp') {
            event.preventDefault()
            setIndex((i) => Math.max(i - 1, 0))
        } else if (event.key === 'End') {
            event.preventDefault()
            setIndex(Math.max(matches.length - 1, 0))
        } else if (event.key === 'Home') {
            event.preventDefault()
            setIndex(0)
        } else if (event.key === 'Enter') {
            event.preventDefault()
            choose(matches[index])
        } else if (event.key === 'Tab') {
            event.preventDefault()
            input.current?.focus()
        }
    }
    return (
        <Modal label={SHELL_COPY.paletteLabel} onClose={props.onClose} data-slot='command-palette'>
            <input
                ref={input}
                role='combobox'
                aria-expanded='true'
                aria-controls={listId}
                aria-activedescendant={activeId}
                aria-autocomplete='list'
                aria-label={SHELL_COPY.paletteInput}
                placeholder={SHELL_COPY.palette}
                value={query}
                onKeyDown={onKeyDown}
                onChange={(e) => {
                    setQuery(e.target.value)
                    setIndex(0)
                }}
                className='w-full px-3 text-[15px]'
            />
            <ul id={listId} role='listbox' aria-label={SHELL_COPY.paletteLabel} className='mt-2 flex max-h-[50vh] flex-col overflow-auto'>
                {matches.map((entry, i) => {
                    const unavailable = entry.kind === 'navigate' && entry.feature.availability.state === 'unavailable'
                    return (
                        <li
                            key={entry.id}
                            id={`${listId}-${entry.id}`}
                            role='option'
                            aria-selected={i === index}
                            aria-current={i === index ? 'true' : undefined}
                            aria-disabled={unavailable || undefined}
                            onMouseEnter={() => setIndex(i)}
                            onClick={() => choose(entry)}
                            className='flex min-h-10 cursor-pointer items-center justify-between rounded-[7px] px-3 text-[14px]'
                            style={{ background: i === index ? 'var(--v2-inset)' : 'transparent', color: unavailable ? 'var(--v2-faint)' : 'var(--v2-ink)' }}
                        >
                            <span>{entry.label}</span>
                            {entry.kind === 'navigate' && entry.feature.shortcut !== null && (
                                <kbd className='text-[11px]' style={{ color: 'var(--v2-faint)' }}>
                                    ⌘{entry.feature.shortcut}
                                </kbd>
                            )}
                            {unavailable && entry.feature.availability.state === 'unavailable' && (
                                <span className='text-[11px] uppercase' style={{ color: 'var(--v2-faint)' }}>
                                    {entry.feature.availability.plannedChunk}
                                </span>
                            )}
                        </li>
                    )
                })}
                {matches.length === 0 && (
                    <li className='px-3 py-2 text-[13px]' style={{ color: 'var(--v2-faint)' }}>
                        {SHELL_COPY.paletteEmpty}
                    </li>
                )}
            </ul>
        </Modal>
    )
}
import { useEffect, useId, useRef, type KeyboardEvent, type ReactNode } from 'react'
import { useShellStore } from './store'

interface ModalProps {
    label: string
    onClose: () => void
    children: ReactNode
    /** Width in CSS px (default 560). */
    width?: number
    'data-slot'?: string
}

const FOCUSABLE = 'a[href], button:not([disabled]), input:not([disabled]), select:not([disabled]), textarea:not([disabled]), [tabindex]:not([tabindex="-1"])'

/**
 * One topmost modal (I8): dialogs register on a shell-wide stack; only the
 * last is interactive. Lower dialogs are inert and aria-hidden, Tab and
 * Shift-Tab stay inside the topmost dialog, Escape closes the topmost only,
 * focus moves into the dialog on open and back to the opener on close. The
 * page behind every dialog is made inert by the shell (`useModalsOpen`).
 * No global key listener: the dialog element handles its own keys.
 */
export function Modal({ label, onClose, children, width = 560, ...rest }: ModalProps) {
    const id = useId()
    const pushModal = useShellStore((s) => s.pushModal)
    const popModal = useShellStore((s) => s.popModal)
    const modals = useShellStore((s) => s.modals)
    const topmost = modals.length > 0 && modals[modals.length - 1] === id
    const dialog = useRef<HTMLDivElement>(null)
    const opener = useRef<HTMLElement | null>(null)
    const focusedOnce = useRef(false)

    useEffect(() => {
        opener.current = document.activeElement instanceof HTMLElement ? document.activeElement : null
        pushModal(id)
        return () => {
            popModal(id)
            // After the commit: the page behind is still inert during cleanup,
            // and an inert ancestor refuses focus (observed in WebKit).
            const target = opener.current
            queueMicrotask(() => {
                // Only when nothing else took focus meanwhile (⌘T replacing the
                // palette hands focus to the tenant list, which must keep it).
                const active = document.activeElement
                if (!active || active === document.body) target?.focus()
            })
        }
    }, [id, pushModal, popModal])

    useEffect(() => {
        // Initial focus goes into the dialog once, when it opens. Regaining the
        // top after a higher dialog closes must not refocus: that dialog is
        // restoring its own opener, which may be any control here.
        if (!topmost || focusedOnce.current) return
        const node = dialog.current
        if (!node) return
        focusedOnce.current = true
        if (!node.contains(document.activeElement)) {
            const first = node.querySelector<HTMLElement>('[autofocus], ' + FOCUSABLE)
            ;(first ?? node).focus()
        }
    }, [topmost])

    const onKeyDown = (event: KeyboardEvent<HTMLDivElement>) => {
        if (!topmost) return
        if (event.key === 'Escape') {
            event.preventDefault()
            event.stopPropagation()
            onClose()
            return
        }
        if (event.key === 'Tab') {
            // Keyboard interaction stays inside the topmost dialog.
            const node = dialog.current
            if (!node) return
            const items = Array.from(node.querySelectorAll<HTMLElement>(FOCUSABLE)).filter((el) => !el.hasAttribute('hidden') && el.getAttribute('aria-hidden') !== 'true')
            if (items.length === 0) {
                event.preventDefault()
                node.focus()
                return
            }
            const first = items[0] as HTMLElement
            const last = items[items.length - 1] as HTMLElement
            const active = document.activeElement
            if (event.shiftKey && (active === first || active === node)) {
                event.preventDefault()
                last.focus()
            } else if (!event.shiftKey && active === last) {
                event.preventDefault()
                first.focus()
            }
        }
    }

    return (
        <div
            className='fixed inset-0 z-50 grid place-items-start justify-center pt-[10vh]'
            data-v2-scrim=''
            aria-hidden={topmost ? undefined : true}
            inert={topmost ? undefined : true}
            onMouseDown={() => topmost && onClose()}
        >
            <div
                ref={dialog}
                role='dialog'
                aria-modal={topmost ? 'true' : undefined}
                aria-label={label}
                tabIndex={-1}
                data-slot={rest['data-slot'] ?? 'modal'}
                data-topmost={topmost ? 'true' : 'false'}
                onKeyDown={onKeyDown}
                onMouseDown={(e) => e.stopPropagation()}
                className='rounded-[12px] border p-5 shadow-2xl'
                style={{ width: `min(${width}px, 92vw)`, background: 'var(--v2-paper)', borderColor: 'var(--v2-rule)', color: 'var(--v2-ink)' }}
            >
                {children}
            </div>
        </div>
    )
}

/** Whether any modal is open: the shell makes the page behind it inert. */
export function useModalsOpen(): boolean {
    return useShellStore((s) => s.modals.length > 0)
}
import { create } from 'zustand'

export type ToastKind = 'ok' | 'info' | 'warn'
import type { Intent } from '@prisma-airs/desktop-contracts'

/** A delivery the desktop did not confirm: kept until the operator retries or dismisses it (DESIGN-V2 §7). */
export interface Unconfirmed {
    id: number
    what: string
    intent: Intent
}

export interface Toast {
    id: number
    kind: ToastKind
    text: string
    /** An optional undo the toast offers (label + action). */
    undo?: { label: string; run: () => void }
}

/**
 * Transient shell presentation state (state-ownership.md "UI"): what is open,
 * the palette query, toasts and the modal stack. Nothing here survives a
 * reload and nothing here is authority: every durable fact is observed from
 * the Rust snapshot.
 */
interface ShellStore {
    paletteOpen: boolean
    switcherOpen: boolean
    toasts: Toast[]
    /** Open modal ids, bottom to top; only the last is interactive (I8). */
    modals: string[]
    unconfirmed: Unconfirmed[]
    /** Toast lifetime in ms (6 s; tests shorten it). */
    toastMs: number
    addUnconfirmed(what: string, intent: Intent): number
    clearUnconfirmed(id: number): void
    openPalette(): void
    closePalette(): void
    setSwitcher(open: boolean): void
    toast(text: string, kind?: ToastKind, undo?: Toast['undo']): number
    dismissToast(id: number): void
    pushModal(id: string): void
    popModal(id: string): void
}

let nextToast = 1

export const useShellStore = create<ShellStore>((set) => ({
    paletteOpen: false,
    switcherOpen: false,
    toasts: [],
    modals: [],
    unconfirmed: [],
    toastMs: 6000,
    addUnconfirmed: (what, intent) => {
        const id = nextToast++
        set((s) => ({ unconfirmed: [...s.unconfirmed, { id, what, intent }] }))
        return id
    },
    clearUnconfirmed: (id) => set((s) => ({ unconfirmed: s.unconfirmed.filter((u) => u.id !== id) })),
    openPalette: () => set({ paletteOpen: true, switcherOpen: false }),
    closePalette: () => set({ paletteOpen: false }),
    setSwitcher: (open) => set({ switcherOpen: open, ...(open ? { paletteOpen: false } : {}) }),
    toast: (text, kind = 'ok', undo) => {
        const id = nextToast++
        // One toast at a time: the newest replaces the rest (I10).
        set({ toasts: [{ id, kind, text, undo }] })
        return id
    },
    dismissToast: (id) => set((s) => ({ toasts: s.toasts.filter((t) => t.id !== id) })),
    pushModal: (id) => set((s) => ({ modals: s.modals.includes(id) ? s.modals : [...s.modals, id] })),
    popModal: (id) => set((s) => ({ modals: s.modals.filter((m) => m !== id) })),
}))

/** Test seam: forget everything (each test starts from an empty store). */
export function resetShellStore() {
    useShellStore.setState({ paletteOpen: false, switcherOpen: false, toasts: [], modals: [], unconfirmed: [], toastMs: 6000 })
}
import { useEffect } from 'react'
import { CircleAlert, CircleCheck, Info } from 'lucide-react'
import { SHELL_COPY } from './copy'
import { useShellStore, type Toast } from './store'

const reducedMotion = () =>
    typeof window.matchMedia === 'function' && window.matchMedia('(prefers-reduced-motion: reduce)').matches

const ICONS = { ok: CircleCheck, info: Info, warn: CircleAlert } as const
const COLORS = { ok: 'var(--v2-ok)', info: 'var(--v2-get)', warn: 'var(--v2-flag)' } as const

/**
 * The one status surface's transient layer (I10): kinds ok/info/warn with
 * icon and word, a 6 s expiry, and persistence until dismissed when the OS
 * asks for reduced motion. Everything a toast says is derivable from an
 * observed scope; a toast never carries authority.
 */
export function Toasts() {
    const toasts = useShellStore((s) => s.toasts)
    const dismiss = useShellStore((s) => s.dismissToast)
    return (
        <div data-slot='toasts' className='pointer-events-none fixed inset-x-0 bottom-6 z-40 flex justify-center px-4'>
            {toasts.map((toast) => (
                <ToastView key={toast.id} toast={toast} onDismiss={() => dismiss(toast.id)} />
            ))}
        </div>
    )
}

function ToastView({ toast, onDismiss }: { toast: Toast; onDismiss: () => void }) {
    // The deadline is the toast's, not the render's: re-renders (snapshot
    // updates) never restart it.
    useEffect(() => {
        if (reducedMotion()) return
        const timer = window.setTimeout(() => useShellStore.getState().dismissToast(toast.id), useShellStore.getState().toastMs)
        return () => window.clearTimeout(timer)
    }, [toast.id])
    const Icon = ICONS[toast.kind]
    return (
        <div
            role='status'
            aria-live='polite'
            data-slot='toast'
            data-kind={toast.kind}
            className='pointer-events-auto flex max-w-[640px] items-center gap-3 rounded-[12px] border px-4 py-3 text-[13px] shadow-lg'
            style={{ background: 'var(--v2-paper)', borderColor: 'var(--v2-rule)', color: 'var(--v2-ink)' }}
        >
            <Icon aria-hidden='true' size={16} strokeWidth={2.4} style={{ color: COLORS[toast.kind] }} />
            <span className='sr-only'>{SHELL_COPY.toastPrefix[toast.kind]}</span>
            <span className='flex-grow'>{toast.text}</span>
            {toast.undo && (
                <button
                    type='button'
                    onClick={() => {
                        toast.undo?.run()
                        onDismiss()
                    }}
                    className='h-8 rounded-[7px] border px-3 text-[12px] font-semibold'
                    style={{ borderColor: 'var(--v2-rule)' }}
                >
                    {toast.undo.label}
                </button>
            )}
            <button type='button' aria-label='Dismiss' onClick={onDismiss} className='h-8 w-8 rounded-[7px] text-[16px] leading-none'>
                ×
            </button>
        </div>
    )
}

