+/// lands and where navigation falls back after a variant change.
+pub fn default_feature(variant: UiVariant) -> FeatureId {
+    catalogue_for(variant)
+        .into_iter()
+        .find(|e| e.sidebar)
+        .map(|e| e.id)
+        .unwrap_or(FeatureId::Settings)
