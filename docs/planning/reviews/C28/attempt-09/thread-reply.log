/**
 * I8 at the shared modal boundary: two stacked dialogs keep keyboard
 * interaction inside the topmost, the lower one is inert and hidden, Escape
 * closes only the top, and each opener gets its focus back.
 */
import { render, screen, waitFor } from '@testing-library/react'
import userEvent from '@testing-library/user-event'
import { beforeEach, describe, expect, it } from 'vitest'
import { useState } from 'react'
import { Modal } from './modal'
import { resetShellStore, useShellStore } from './store'

function Stack() {
    const [outer, setOuter] = useState(false)
    const [inner, setInner] = useState(false)
    return (
        <div>
            <button type='button' onClick={() => setOuter(true)}>
                Open outer
            </button>
            <button type='button'>Page control</button>
            {outer && (
                <Modal label='Outer' onClose={() => setOuter(false)}>
                    <button type='button' onClick={() => setInner(true)}>
                        Open inner
                    </button>
                    <button type='button'>Outer second</button>
                </Modal>
            )}
            {inner && (
                <Modal label='Inner' onClose={() => setInner(false)}>
                    <input aria-label='Inner field' />
                    <button type='button'>Inner done</button>
                </Modal>
            )}
        </div>
    )
}

beforeEach(() => resetShellStore())

describe('modal stack (I8)', () => {
    it('keeps only the topmost dialog interactive, traps Tab, closes top-first on Escape and restores each opener', async () => {
        const user = userEvent.setup()
        render(<Stack />)
        const openOuter = screen.getByRole('button', { name: 'Open outer' })
        openOuter.focus()
        await user.keyboard('{Enter}')
        const outer = screen.getByRole('dialog', { name: 'Outer' })
        expect(outer).toHaveAttribute('aria-modal', 'true')
        expect(screen.getByRole('button', { name: 'Open inner' })).toHaveFocus()
        // Tab wraps inside the outer dialog.
        await user.tab()
        expect(screen.getByRole('button', { name: 'Outer second' })).toHaveFocus()
        await user.tab()
        expect(screen.getByRole('button', { name: 'Open inner' })).toHaveFocus()
        await user.tab({ shift: true })
        expect(screen.getByRole('button', { name: 'Outer second' })).toHaveFocus()
        // Open the inner dialog: the outer one becomes inert and hidden.
        await user.click(screen.getByRole('button', { name: 'Open inner' }))
        const inner = screen.getByRole('dialog', { name: 'Inner' })
        expect(inner).toHaveAttribute('aria-modal', 'true')
        expect(outer).not.toHaveAttribute('aria-modal')
        expect(outer).toHaveAttribute('data-topmost', 'false')
        expect(outer.parentElement).toHaveAttribute('aria-hidden', 'true')
        expect(outer.parentElement).toHaveAttribute('inert')
        expect(useShellStore.getState().modals).toHaveLength(2)
        expect(screen.getByRole('textbox', { name: 'Inner field' })).toHaveFocus()
        await user.tab()
        await user.tab()
        expect(screen.getByRole('textbox', { name: 'Inner field' })).toHaveFocus()
        // Escape closes the inner dialog only; focus returns to its opener.
        await user.keyboard('{Escape}')
        expect(screen.queryByRole('dialog', { name: 'Inner' })).toBeNull()
        expect(screen.getByRole('dialog', { name: 'Outer' })).toHaveAttribute('aria-modal', 'true')
        expect(screen.getByRole('button', { name: 'Open inner' })).toHaveFocus()
        await user.keyboard('{Escape}')
        expect(screen.queryByRole('dialog')).toBeNull()
        expect(openOuter).toHaveFocus()
        expect(useShellStore.getState().modals).toHaveLength(0)
    })

    it('restores the exact non-first opener of a stacked dialog', async () => {
        const user = userEvent.setup()
        render(<Stack />)
        await user.click(screen.getByRole('button', { name: 'Open outer' }))
        // Open the inner dialog from the outer dialog's second control.
        const second = screen.getByRole('button', { name: 'Outer second' })
        second.focus()
        await user.keyboard('{Enter}')
        expect(screen.queryByRole('dialog', { name: 'Inner' })).toBeNull()
        // 'Outer second' does nothing on Enter; open inner via its own control but with
        // the opener recorded as 'Outer second' by focusing it right before the click.
        second.focus()
        const openInner = screen.getByRole('button', { name: 'Open inner' })
        openInner.addEventListener('mousedown', (e) => e.preventDefault(), { once: true })
        await user.click(openInner)
        expect(screen.getByRole('dialog', { name: 'Inner' })).toHaveAttribute('aria-modal', 'true')
        await user.keyboard('{Escape}')
        expect(screen.queryByRole('dialog', { name: 'Inner' })).toBeNull()
        await waitFor(() => expect(screen.getByRole('button', { name: 'Outer second' })).toHaveFocus())
    })
})
import { render, screen } from '@testing-library/react'
import { describe, expect, it } from 'vitest'
import { Verdict } from './verdict'

describe('verdict (I9)', () => {
    it('is colour plus icon plus word, with the word as the accessible text', () => {
        render(<Verdict tone='blocked' word='Blocked' reason='Prompt injection · high confidence' />)
        const verdict = screen.getByText('Blocked').closest('[data-slot="verdict"]') as HTMLElement
        expect(verdict).toHaveAttribute('data-tone', 'blocked')
        expect(verdict.style.color).toBe('var(--v2-block)')
        expect(verdict.querySelector('svg')).toHaveAttribute('aria-hidden', 'true')
        expect(verdict).toHaveTextContent('Blocked · Prompt injection · high confidence')
    })
    it.each([['flagged', '--v2-flag'], ['allowed', '--v2-ok'], ['info', '--v2-soft']] as const)('%s uses its own token', (tone, token) => {
        render(<Verdict tone={tone} word={tone} />)
        const verdict = screen.getByText(tone).closest('[data-slot="verdict"]') as HTMLElement
        expect(verdict.style.color).toBe(`var(${token})`)
    })
})
/**
 * The production App over a scripted native transport, rendering the v2
 * shell (C28): the Rust catalogue drives the sidebar, every navigation is a
 * `navigate` intent, the palette and tenant switcher dispatch, preferences
 * dispatch, refusals reach the status surface as warn toasts, and the
 * accessibility invariants I8–I10 hold.
 */
import { act, render, screen, waitFor, within } from '@testing-library/react'
import userEvent from '@testing-library/user-event'
import { beforeEach, describe, expect, it } from 'vitest'
import { DesktopClient, type RuntimeOverview } from '@prisma-airs/desktop-contracts'
import { App } from '../app'
import { scriptedNative, tenant, type Native } from '../test/native'
import { fxHome, fxHomeDark, fxSwitcher } from './fixtures'
import { DeliveryOutcomeUnknown } from '@prisma-airs/desktop-contracts'
import { resetShellStore, useShellStore } from './store'

async function launch(snapshot = fxHome()): Promise<Native> {
    const native = scriptedNative(snapshot)
    render(<App client={new DesktopClient(native.transport)} />)
    await screen.findByRole('navigation', { name: 'Destinations' })
    return native
}

const rail = () => within(screen.getByRole('navigation', { name: 'Destinations' }))
const intents = (native: Native) => native.dispatched.map((i) => i.kind)

beforeEach(() => {
    resetShellStore()
    document.documentElement.removeAttribute('data-theme')
})

describe('v2 shell', () => {
    it('renders the sidebar from the Rust catalogue with the menu shortcuts and marks the unavailable Inbox', async () => {
        await launch()
        const items = rail().getAllByRole('button').filter((b) => b.hasAttribute('data-inset-focus'))
        expect(items.map((b) => b.textContent)).toEqual([
            'Home⌘1',
            'Inbox⌘2',
            'Harness⌘3',
            'Academy⌘4',
            'Test Cases⌘5',
            'API Client⌘6',
            'Administration⌘7',
        ])
        expect(items[0]).toHaveAttribute('aria-current', 'page')
        expect(items[1]).toHaveAttribute('aria-disabled', 'true')
        expect(items[1]).toHaveAccessibleDescription('Not available: The Inbox arrives in C30')
        expect(screen.getByRole('heading', { level: 1, name: 'Home' })).toBeInTheDocument()
        expect(document.querySelector('[data-v2-shell]')).not.toBeNull()
    })

    it('dispatches navigate for the sidebar, the native menu and Home cards, never local state', async () => {
        const user = userEvent.setup()
