}

/* The v2 shell root: body background, type and the visible focus ring
 * (invariant: accent-colour ring on every focusable control; inset variant
 * where a control declares it). */
[data-v2-shell] {
    background: var(--v2-bg);
    color: var(--v2-ink);
    font-size: var(--v2-text);
    min-height: 100vh;
}
[data-v2-shell] :focus-visible {
    outline: 2px solid var(--v2-acc);
    outline-offset: 2px;
}
[data-v2-shell] [data-inset-focus]:focus-visible {
    outline-offset: -4px;
}
[data-v2-shell] input,
[data-v2-shell] select,
[data-v2-shell] textarea {
    border: 1px solid var(--v2-ctl);
    border-radius: var(--v2-radius-control);
    background: var(--v2-bg);
    color: var(--v2-ink);
    min-height: var(--v2-control);
}
/* Rail collapses to icons below 1280 CSS px; nothing scrolls horizontally. */
[data-v2-shell] {
