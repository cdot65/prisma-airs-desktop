    finally:
        if had_key:
            sh(["defaults", "write", "com.apple.universalaccess", "reduceMotion", "-bool", "true" if prior == "1" else "false"])
        else:
            sh(["defaults", "delete", "com.apple.universalaccess", "reduceMotion"])
        time.sleep(1)
    obs["rm_restored"] = reduce_motion() == (had_key and prior == "1")
    pid = app.launch()
