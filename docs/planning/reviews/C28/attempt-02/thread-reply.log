import { useEffect, useRef } from 'react'
import { Moon, Sun, SunMoon } from 'lucide-react'
import type { DesktopClient, FeatureId, Intent, ShellSnapshot, Theme } from '@prisma-airs/desktop-contracts'
import type { Dispatch } from '../features/tenants/dispatch'
import { FeatureBody } from '../shell/feature-body'
import { FEATURE_ICONS } from '../shell/icons'
import { SHELL_COPY } from './copy'
import { Home } from './home'
import { Palette } from './palette'
import { useShellStore } from './store'
import { TenantSwitcher } from './tenant-switcher'
import { Toasts } from './toasts'
import { useModalsOpen } from './modal'

export interface V2ShellProps {
    snapshot: ShellSnapshot
    appearancePending: boolean
    status: string
    onNavigate: (id: FeatureId) => void
    onSetAppearance: (theme: Theme) => void
    onSetShowCalls: (on: boolean) => void
    onReturnToClassic: () => void
    onSwitchTenant: (tenant: string) => void
    onReadNow: () => void
    /** Re-sends a delivery the desktop did not confirm, only on the operator's click. */
    onRetry: (what: string, intent: Intent) => void
    dispatch: Dispatch
    client: DesktopClient
}

const THEMES: { value: Theme; label: string; icon: typeof Sun }[] = [
    { value: 'system', label: SHELL_COPY.appearanceSystem, icon: SunMoon },
    { value: 'light', label: SHELL_COPY.appearanceLight, icon: Sun },
    { value: 'dark', label: SHELL_COPY.appearanceDark, icon: Moon },
]

/**
 * The "Refined Native" shell (C28, DESIGN-V2): a 244px rail with the tenant
 * switcher on top, the Rust navigation inventory (labels and ⌘ hints come
 * from the same catalogue the native menu is built from), appearance and
 * "show the calls" preferences, one status surface and the modal stack.
 * Every destination other than Home renders the same FeatureBody the legacy
 * shell renders, so behaviour is identical whichever shell frames it.
 */
export function V2Shell(props: V2ShellProps) {
    const { snapshot } = props
    const paletteOpen = useShellStore((s) => s.paletteOpen)
    const openPalette = useShellStore((s) => s.openPalette)
    const closePalette = useShellStore((s) => s.closePalette)
    const unconfirmed = useShellStore((s) => s.unconfirmed)
    const clearUnconfirmed = useShellStore((s) => s.clearUnconfirmed)
    const modalOpen = useModalsOpen()
    const heading = useRef<HTMLHeadingElement>(null)
    const firstRender = useRef(true)
    const active = snapshot.activeFeature
    const feature = snapshot.features.find((f) => f.id === active) ?? snapshot.features[0]

    useEffect(() => {
        // Move focus to the new page heading after navigation (not on launch).
        if (firstRender.current) {
            firstRender.current = false
            return
        }
        heading.current?.focus()
    }, [active])

    if (!feature) return null
    return (
        <div data-v2-shell='' className='flex min-h-screen'>
            <nav
                data-v2-rail=''
                aria-label={SHELL_COPY.navLabel}
                aria-hidden={modalOpen ? true : undefined}
                inert={modalOpen ? true : undefined}
                className='sticky top-0 flex h-screen shrink-0 flex-col gap-2 overflow-y-auto p-3'
                style={{ width: 'var(--v2-rail)', background: 'var(--v2-side)', borderRight: '1px solid var(--v2-rule)' }}
            >
                <TenantSwitcher snapshot={snapshot} onSwitch={props.onSwitchTenant} onAdd={() => props.onNavigate('settings')} />
                <ul className='mt-2 flex flex-col gap-0.5'>
                    {snapshot.features
                        .filter((f) => f.sidebar)
                        .map((f) => {
                            const Icon = FEATURE_ICONS[f.id]
                            const current = f.id === feature.id
                            const unavailable = f.availability.state === 'unavailable'
                            const reason = f.availability.state === 'unavailable' ? f.availability.reason : ''
                            return (
                                <li key={f.id}>
                                    <button
                                        type='button'
                                        aria-current={current ? 'page' : undefined}
                                        aria-disabled={unavailable || undefined}
                                        aria-describedby={unavailable ? `${f.id}-hint` : undefined}
                                        title={unavailable ? SHELL_COPY.unavailableHint(reason) : f.shortcut !== null ? `${f.label} (⌘${f.shortcut})` : f.label}
                                        onClick={() => !unavailable && props.onNavigate(f.id)}
                                        data-inset-focus=''
                                        className='flex min-h-9 w-full items-center gap-2.5 rounded-[7px] px-2.5 text-left text-[14px] font-medium'
                                        style={{
                                            background: current ? 'var(--v2-sel)' : 'transparent',
                                            color: current ? 'var(--v2-sel-ink)' : unavailable ? 'var(--v2-faint)' : 'var(--v2-ink)',
                                        }}
                                    >
                                        <Icon aria-hidden='true' size={16} />
                                        <span data-v2-label className='flex-grow truncate'>
                                            {f.label}
                                        </span>
                                        {f.shortcut !== null && (
                                            <kbd data-v2-label className='text-[11px]' aria-label={`Command ${f.shortcut}`} style={{ opacity: 0.75 }}>
                                                ⌘{f.shortcut}
                                            </kbd>
                                        )}
                                    </button>
                                    {unavailable && (
                                        <span id={`${f.id}-hint`} className='sr-only'>
                                            {SHELL_COPY.unavailableHint(reason)}
                                        </span>
                                    )}
                                </li>
                            )
                        })}
                </ul>
                <button
                    type='button'
                    data-slot='palette-trigger'
                    onClick={openPalette}
                    className='mt-1 flex min-h-9 items-center justify-between rounded-[7px] border px-2.5 text-[12px]'
                    style={{ borderColor: 'var(--v2-rule)', color: 'var(--v2-faint)' }}
                >
                    <span data-v2-label>{SHELL_COPY.palette}</span>
                    <kbd aria-label='Command K'>⌘K</kbd>
                </button>
                <div className='mt-auto flex flex-col gap-2 pt-3' style={{ borderTop: '1px solid var(--v2-rule)' }}>
                    <fieldset aria-busy={props.appearancePending} className='flex gap-1'>
                        <legend className='sr-only'>{SHELL_COPY.appearance}</legend>
                        {THEMES.map((t) => (
                            <button
                                key={t.value}
                                type='button'
                                aria-pressed={snapshot.appearance === t.value}
                                aria-label={t.label}
                                title={t.label}
                                onClick={() => props.onSetAppearance(t.value)}
                                className='grid size-8 place-items-center rounded-[7px] border'
                                style={{
                                    borderColor: 'var(--v2-rule)',
                                    background: snapshot.appearance === t.value ? 'var(--v2-acc-soft)' : 'transparent',
                                }}
                            >
                                <t.icon aria-hidden='true' size={14} />
                            </button>
                        ))}
                    </fieldset>
                    <label className='flex min-h-8 items-center gap-2 text-[12px]'>
                        <input
                            type='checkbox'
                            aria-label={SHELL_COPY.showCalls}
                            aria-describedby='v2-show-calls-hint'
                            checked={snapshot.showCalls}
                            onChange={(e) => props.onSetShowCalls(e.target.checked)}
                            className='size-4 min-h-0'
                        />
                        <span data-v2-label>{SHELL_COPY.showCalls}</span>
                        <span id='v2-show-calls-hint' className='sr-only'>
                            {SHELL_COPY.showCallsHint}
                        </span>
                    </label>
                    <button type='button' onClick={props.onReturnToClassic} title={SHELL_COPY.classic} aria-label={SHELL_COPY.classic} className='text-left text-[12px] underline' style={{ color: 'var(--v2-faint)' }}>
                        <span data-v2-label>{SHELL_COPY.classic}</span>
                    </button>
                    {snapshot.fixtureBuild && (
                        <p data-slot='build-identity' className='font-mono text-[10px] tracking-[0.14em] uppercase' style={{ color: 'var(--v2-flag)' }}>
                            {SHELL_COPY.fixture}
                        </p>
                    )}
                </div>
            </nav>
            <main
                data-slot='app-main'
                className='min-w-0 flex-grow'
                style={{ padding: 'var(--v2-page-top) var(--v2-page-x) 28px' }}
                aria-hidden={modalOpen ? true : undefined}
                inert={modalOpen ? true : undefined}
            >
                {unconfirmed.length > 0 && (
                    <ul data-slot='unconfirmed' aria-label='Not confirmed' className='mb-4 flex flex-col gap-2'>
                        {unconfirmed.map((u) => (
                            <li key={u.id} role='status' className='flex items-center gap-3 rounded-[12px] border px-4 py-2 text-[13px]' style={{ borderColor: 'var(--v2-flag)', background: 'var(--v2-flag-bg)', color: 'var(--v2-ink)' }}>
                                <span className='flex-grow'>{SHELL_COPY.unconfirmed(u.what)}</span>
                                <button
                                    type='button'
                                    onClick={() => {
                                        clearUnconfirmed(u.id)
                                        props.onRetry(u.what, u.intent)
                                    }}
                                    className='h-8 rounded-[7px] px-3 text-[12px] font-semibold'
                                    style={{ background: 'var(--v2-acc)', color: 'var(--v2-acc-ink)' }}
                                >
                                    {SHELL_COPY.retry}
                                </button>
                                <button type='button' onClick={() => clearUnconfirmed(u.id)} className='h-8 rounded-[7px] border px-3 text-[12px]' style={{ borderColor: 'var(--v2-rule)' }}>
                                    {SHELL_COPY.dismiss}
                                </button>
                            </li>
                        ))}
                    </ul>
                )}
                {feature.id === 'home' ? (
                    <Home ref={heading} snapshot={snapshot} onNavigate={props.onNavigate} />
                ) : (
                    <FeatureBody
                        ref={heading}
                        feature={feature}
                        snapshot={snapshot}
                        appearancePending={props.appearancePending}
                        onSetAppearance={props.onSetAppearance}
                        onNavigate={props.onNavigate}
                        dispatch={props.dispatch}
                        client={props.client}
                    />
                )}
                <p role='status' aria-live='polite' data-slot='shell-status' className='mt-4 pb-6 text-[13px]' style={{ color: 'var(--v2-soft)' }}>
                    {props.status}
                </p>
            </main>
            {paletteOpen && (
                <Palette snapshot={snapshot} onNavigate={props.onNavigate} onSwitchTenant={props.onSwitchTenant} onReadNow={props.onReadNow} onClose={closePalette} />
            )}
            <Toasts />
        </div>
    )
}
import { create } from 'zustand'

export type ToastKind = 'ok' | 'info' | 'warn'
import type { Intent } from '@prisma-airs/desktop-contracts'

/** A delivery the desktop did not confirm: kept until the operator retries or dismisses it (DESIGN-V2 §7). */
export interface Unconfirmed {
    id: number
    what: string
    intent: Intent
}

export interface Toast {
    id: number
    kind: ToastKind
    text: string
    /** An optional undo the toast offers (label + action). */
    undo?: { label: string; run: () => void }
}

/**
 * Transient shell presentation state (state-ownership.md "UI"): what is open,
 * the palette query, toasts and the modal stack. Nothing here survives a
 * reload and nothing here is authority: every durable fact is observed from
 * the Rust snapshot.
 */
interface ShellStore {
    paletteOpen: boolean
    switcherOpen: boolean
    toasts: Toast[]
    /** Open modal ids, bottom to top; only the last is interactive (I8). */
    modals: string[]
    unconfirmed: Unconfirmed[]
    /** Toast lifetime in ms (6 s; tests shorten it). */
    toastMs: number
    addUnconfirmed(what: string, intent: Intent): number
    clearUnconfirmed(id: number): void
    openPalette(): void
    closePalette(): void
    setSwitcher(open: boolean): void
    toast(text: string, kind?: ToastKind, undo?: Toast['undo']): number
    dismissToast(id: number): void
    pushModal(id: string): void
    popModal(id: string): void
}

let nextToast = 1

export const useShellStore = create<ShellStore>((set) => ({
    paletteOpen: false,
    switcherOpen: false,
    toasts: [],
    modals: [],
    unconfirmed: [],
    toastMs: 6000,
    addUnconfirmed: (what, intent) => {
        const id = nextToast++
        set((s) => ({ unconfirmed: [...s.unconfirmed, { id, what, intent }] }))
        return id
    },
    clearUnconfirmed: (id) => set((s) => ({ unconfirmed: s.unconfirmed.filter((u) => u.id !== id) })),
    openPalette: () => set({ paletteOpen: true, switcherOpen: false }),
    closePalette: () => set({ paletteOpen: false }),
    setSwitcher: (open) => set({ switcherOpen: open, ...(open ? { paletteOpen: false } : {}) }),
    toast: (text, kind = 'ok', undo) => {
        const id = nextToast++
        // One toast at a time: the newest replaces the rest (I10).
        set({ toasts: [{ id, kind, text, undo }] })
        return id
    },
    dismissToast: (id) => set((s) => ({ toasts: s.toasts.filter((t) => t.id !== id) })),
    pushModal: (id) => set((s) => ({ modals: s.modals.includes(id) ? s.modals : [...s.modals, id] })),
    popModal: (id) => set((s) => ({ modals: s.modals.filter((m) => m !== id) })),
}))

/** Test seam: forget everything (each test starts from an empty store). */
export function resetShellStore() {
    useShellStore.setState({ paletteOpen: false, switcherOpen: false, toasts: [], modals: [], unconfirmed: [], toastMs: 6000 })
}
import { useEffect, useId, useRef, type KeyboardEvent, type ReactNode } from 'react'
import { useShellStore } from './store'

interface ModalProps {
    label: string
    onClose: () => void
    children: ReactNode
    /** Width in CSS px (default 560). */
    width?: number
    'data-slot'?: string
}

const FOCUSABLE = 'a[href], button:not([disabled]), input:not([disabled]), select:not([disabled]), textarea:not([disabled]), [tabindex]:not([tabindex="-1"])'

/**
 * One topmost modal (I8): dialogs register on a shell-wide stack; only the
 * last is interactive. Lower dialogs are inert and aria-hidden, Tab and
 * Shift-Tab stay inside the topmost dialog, Escape closes the topmost only,
 * focus moves into the dialog on open and back to the opener on close. The
 * page behind every dialog is made inert by the shell (`useModalsOpen`).
 * No global key listener: the dialog element handles its own keys.
 */
export function Modal({ label, onClose, children, width = 560, ...rest }: ModalProps) {
    const id = useId()
    const pushModal = useShellStore((s) => s.pushModal)
    const popModal = useShellStore((s) => s.popModal)
    const modals = useShellStore((s) => s.modals)
    const topmost = modals.length > 0 && modals[modals.length - 1] === id
    const dialog = useRef<HTMLDivElement>(null)
    const opener = useRef<HTMLElement | null>(null)

    useEffect(() => {
        opener.current = document.activeElement instanceof HTMLElement ? document.activeElement : null
        pushModal(id)
        return () => {
            popModal(id)
            // After the commit: the page behind is still inert during cleanup,
            // and an inert ancestor refuses focus (observed in WebKit).
            const target = opener.current
            queueMicrotask(() => target?.focus())
        }
    }, [id, pushModal, popModal])

    useEffect(() => {
        if (!topmost) return
        const node = dialog.current
        if (!node) return
        if (!node.contains(document.activeElement)) {
            const first = node.querySelector<HTMLElement>('[autofocus], ' + FOCUSABLE)
            ;(first ?? node).focus()
        }
    }, [topmost])

    const onKeyDown = (event: KeyboardEvent<HTMLDivElement>) => {
        if (!topmost) return
        if (event.key === 'Escape') {
            event.preventDefault()
            event.stopPropagation()
            onClose()
            return
        }
        if (event.key === 'Tab') {
            // Keyboard interaction stays inside the topmost dialog.
            const node = dialog.current
            if (!node) return
            const items = Array.from(node.querySelectorAll<HTMLElement>(FOCUSABLE)).filter((el) => !el.hasAttribute('hidden') && el.getAttribute('aria-hidden') !== 'true')
            if (items.length === 0) {
                event.preventDefault()
                node.focus()
                return
            }
            const first = items[0] as HTMLElement
            const last = items[items.length - 1] as HTMLElement
            const active = document.activeElement
            if (event.shiftKey && (active === first || active === node)) {
                event.preventDefault()
                last.focus()
            } else if (!event.shiftKey && active === last) {
                event.preventDefault()
                first.focus()
            }
        }
    }

    return (
        <div
            className='fixed inset-0 z-50 grid place-items-start justify-center pt-[10vh]'
            data-v2-scrim=''
            aria-hidden={topmost ? undefined : true}
            inert={topmost ? undefined : true}
            onMouseDown={() => topmost && onClose()}
        >
            <div
                ref={dialog}
                role='dialog'
                aria-modal={topmost ? 'true' : undefined}
                aria-label={label}
                tabIndex={-1}
                data-slot={rest['data-slot'] ?? 'modal'}
                data-topmost={topmost ? 'true' : 'false'}
                onKeyDown={onKeyDown}
                onMouseDown={(e) => e.stopPropagation()}
                className='rounded-[12px] border p-5 shadow-2xl'
                style={{ width: `min(${width}px, 92vw)`, background: 'var(--v2-paper)', borderColor: 'var(--v2-rule)', color: 'var(--v2-ink)' }}
            >
                {children}
            </div>
        </div>
    )
}

/** Whether any modal is open: the shell makes the page behind it inert. */
export function useModalsOpen(): boolean {
    return useShellStore((s) => s.modals.length > 0)
}
import { useEffect, useId, useMemo, useRef, useState, type KeyboardEvent } from 'react'
import type { FeatureEntry, FeatureId, ShellSnapshot } from '@prisma-airs/desktop-contracts'
import { SHELL_COPY } from './copy'
import { Modal } from './modal'

export type PaletteEntry =
    | { kind: 'navigate'; id: string; label: string; feature: FeatureEntry }
    | { kind: 'switch'; id: string; label: string; tenant: string }
    | { kind: 'readNow'; id: string; label: string }

export interface PaletteProps {
    snapshot: ShellSnapshot
    onNavigate: (id: FeatureId) => void
    onSwitchTenant: (tenant: string) => void
    onReadNow: () => void
    onClose: () => void
}

/** The palette's entries come from the Rust inventory and the tenant list: never a TS-only registry. */
export function paletteEntries(snapshot: ShellSnapshot): PaletteEntry[] {
    const destinations: PaletteEntry[] = snapshot.features.map((feature) => ({
        kind: 'navigate',
        id: `go:${feature.id}`,
        label: feature.label,
        feature,
    }))
    const tenants: PaletteEntry[] = snapshot.tenants
        .filter((t) => t.id !== snapshot.active?.tenant)
        .map((t) => ({ kind: 'switch', id: `tenant:${t.id}`, label: SHELL_COPY.paletteSwitch(t.label), tenant: t.id }))
    const actions: PaletteEntry[] = snapshot.active ? [{ kind: 'readNow', id: 'action:read', label: SHELL_COPY.paletteReadNow }] : []
    return [...destinations, ...tenants, ...actions]
}

export function Palette(props: PaletteProps) {
    const [query, setQuery] = useState('')
    const [index, setIndex] = useState(0)
    const input = useRef<HTMLInputElement>(null)
    const listId = useId()
    const entries = useMemo(() => paletteEntries(props.snapshot), [props.snapshot])
    const matches = useMemo(() => {
        const q = query.trim().toLowerCase()
        return q ? entries.filter((e) => e.label.toLowerCase().includes(q)) : entries
    }, [entries, query])
    useEffect(() => input.current?.focus(), [])
    const activeId = matches[index] ? `${listId}-${matches[index].id}` : undefined
    useEffect(() => {
        if (activeId) document.getElementById(activeId)?.scrollIntoView({ block: 'nearest' })
    }, [activeId])

    const choose = (entry: PaletteEntry | undefined) => {
        if (!entry) return
        if (entry.kind === 'navigate' && entry.feature.availability.state !== 'available') return
        props.onClose()
        if (entry.kind === 'navigate') props.onNavigate(entry.feature.id)
        else if (entry.kind === 'switch') props.onSwitchTenant(entry.tenant)
        else props.onReadNow()
    }
    const onKeyDown = (event: KeyboardEvent<HTMLInputElement>) => {
        if (event.key === 'ArrowDown') {
            event.preventDefault()
            setIndex((i) => Math.min(i + 1, Math.max(matches.length - 1, 0)))
        } else if (event.key === 'ArrowUp') {
            event.preventDefault()
            setIndex((i) => Math.max(i - 1, 0))
        } else if (event.key === 'Enter') {
            event.preventDefault()
            choose(matches[index])
        } else if (event.key === 'Tab') {
            event.preventDefault()
            input.current?.focus()
        }
    }
    return (
        <Modal label={SHELL_COPY.paletteLabel} onClose={props.onClose} data-slot='command-palette'>
            <input
                ref={input}
                role='combobox'
                aria-expanded='true'
                aria-controls={listId}
                aria-activedescendant={activeId}
                aria-autocomplete='list'
                aria-label={SHELL_COPY.paletteInput}
                placeholder={SHELL_COPY.palette}
                value={query}
                onKeyDown={onKeyDown}
                onChange={(e) => {
                    setQuery(e.target.value)
                    setIndex(0)
                }}
                className='w-full px-3 text-[15px]'
            />
            <ul id={listId} role='listbox' aria-label={SHELL_COPY.paletteLabel} className='mt-2 flex max-h-[50vh] flex-col overflow-auto'>
                {matches.map((entry, i) => {
                    const unavailable = entry.kind === 'navigate' && entry.feature.availability.state === 'unavailable'
                    return (
                        <li
                            key={entry.id}
                            id={`${listId}-${entry.id}`}
                            role='option'
                            aria-selected={i === index}
                            aria-disabled={unavailable || undefined}
                            onMouseEnter={() => setIndex(i)}
                            onClick={() => choose(entry)}
                            className='flex min-h-10 cursor-pointer items-center justify-between rounded-[7px] px-3 text-[14px]'
                            style={{ background: i === index ? 'var(--v2-inset)' : 'transparent', color: unavailable ? 'var(--v2-faint)' : 'var(--v2-ink)' }}
                        >
                            <span>{entry.label}</span>
                            {entry.kind === 'navigate' && entry.feature.shortcut !== null && (
                                <kbd className='text-[11px]' style={{ color: 'var(--v2-faint)' }}>
                                    ⌘{entry.feature.shortcut}
                                </kbd>
                            )}
                            {unavailable && entry.feature.availability.state === 'unavailable' && (
                                <span className='text-[11px] uppercase' style={{ color: 'var(--v2-faint)' }}>
                                    {entry.feature.availability.plannedChunk}
                                </span>
                            )}
                        </li>
                    )
                })}
                {matches.length === 0 && (
                    <li className='px-3 py-2 text-[13px]' style={{ color: 'var(--v2-faint)' }}>
                        {SHELL_COPY.paletteEmpty}
                    </li>
                )}
            </ul>
        </Modal>
    )
}
import { useEffect, useRef } from 'react'
import { ChevronDown } from 'lucide-react'
import type { ShellSnapshot } from '@prisma-airs/desktop-contracts'
import { SHELL_COPY } from './copy'
import { useShellStore } from './store'

export interface TenantSwitcherProps {
    snapshot: ShellSnapshot
    onSwitch: (tenant: string) => void
    onAdd: () => void
    collapsed?: boolean
}

function environment(snapshot: ShellSnapshot, id: string | undefined): string {
    const tenant = snapshot.tenants.find((t) => t.id === id)
    if (!tenant) return ''
    return tenant.destination.kind === 'region' ? tenant.destination.region : 'custom'
}

/**
 * Slack-style tenant switcher at the top of the sidebar: the tenant is always
 * visible; switching dispatches the one `selectTenant` intent (the C30 guard
 * renders from the core's refusal). "Add a tenant…" opens the wizard (C29);
 * until then it leads to Settings.
 */
export function TenantSwitcher({ snapshot, onSwitch, onAdd, collapsed }: TenantSwitcherProps) {
    const open = useShellStore((s) => s.switcherOpen)
    const setOpen = useShellStore((s) => s.setSwitcher)
    const active = snapshot.tenants.find((t) => t.id === snapshot.active?.tenant)
    const list = useRef<HTMLUListElement>(null)
    const trigger = useRef<HTMLButtonElement>(null)
    const wasOpen = useRef(false)
    useEffect(() => {
        if (open) list.current?.querySelector<HTMLElement>('button')?.focus()
        else if (wasOpen.current) trigger.current?.focus()
        wasOpen.current = open
    }, [open])
    return (
        <div data-slot='tenant-switcher' className='relative'>
            <button
                ref={trigger}
                type='button'
                aria-haspopup='listbox'
                aria-expanded={open}
                aria-label={SHELL_COPY.tenantSwitcher}
                title={active ? `${active.label} · ${environment(snapshot, active.id)}` : SHELL_COPY.tenantNone}
                onClick={() => setOpen(!open)}
                className='flex min-h-11 w-full items-center gap-2 rounded-[7px] px-2.5 text-left'
                style={{ background: 'var(--v2-paper)', border: '1px solid var(--v2-rule)' }}
            >
                <span
                    aria-hidden='true'
                    className='grid size-7 shrink-0 place-items-center rounded-[7px] text-[12px] font-bold'
                    style={{ background: 'var(--v2-acc)', color: 'var(--v2-acc-ink)' }}
                >
                    {(active?.label ?? '?').slice(0, 1).toUpperCase()}
                </span>
                {!collapsed && (
                    <span data-v2-label className='flex min-w-0 flex-grow flex-col'>
                        <span className='truncate text-[14px] font-semibold'>{active?.label ?? SHELL_COPY.tenantNone}</span>
                        {active && (
                            <span className='text-[11px] uppercase tracking-wide' style={{ color: 'var(--v2-faint)' }}>
                                {environment(snapshot, active.id)}
                                {active.tsgId ? ` · TSG ${active.tsgId}` : ''}
                            </span>
                        )}
                    </span>
                )}
                <ChevronDown aria-hidden='true' size={14} />
            </button>
            {open && (
                <ul
                    ref={list}
                    role='listbox'
                    aria-label={SHELL_COPY.tenantSwitcher}
                    onKeyDown={(e) => {
                        if (e.key === 'Escape') {
                            e.preventDefault()
                            setOpen(false)
                        }
                    }}
                    className='absolute left-0 right-0 top-full z-30 mt-1 flex flex-col gap-0.5 rounded-[12px] border p-1.5 shadow-xl'
                    style={{ background: 'var(--v2-paper)', borderColor: 'var(--v2-rule)' }}
                >
                    {snapshot.tenants.map((t) => {
                        const selected = t.id === snapshot.active?.tenant
                        return (
                            <li key={t.id} role='option' aria-selected={selected}>
                                <button
                                    type='button'
                                    onClick={() => {
                                        setOpen(false)
                                        if (!selected) onSwitch(t.id)
                                    }}
                                    className='flex min-h-9 w-full items-center justify-between rounded-[7px] px-2.5 text-left text-[13px]'
                                    style={selected ? { background: 'var(--v2-sel)', color: 'var(--v2-sel-ink)' } : undefined}
                                >
                                    <span className='truncate font-medium'>{t.label}</span>
                                    <span className='text-[11px] uppercase'>{environment(snapshot, t.id)}</span>
                                </button>
                            </li>
                        )
                    })}
                    <li role='option' aria-selected={false}>
                        <button
                            type='button'
                            onClick={() => {
                                setOpen(false)
                                onAdd()
                            }}
                            className='flex min-h-9 w-full items-center rounded-[7px] px-2.5 text-left text-[13px] font-semibold'
                            style={{ color: 'var(--v2-acc)' }}
                        >
                            {SHELL_COPY.addTenant}
                        </button>
                    </li>
                </ul>
            )}
        </div>
    )
}
import { useEffect } from 'react'
import { CircleAlert, CircleCheck, Info } from 'lucide-react'
import { SHELL_COPY } from './copy'
import { useShellStore, type Toast } from './store'

const reducedMotion = () =>
    typeof window.matchMedia === 'function' && window.matchMedia('(prefers-reduced-motion: reduce)').matches

const ICONS = { ok: CircleCheck, info: Info, warn: CircleAlert } as const
const COLORS = { ok: 'var(--v2-ok)', info: 'var(--v2-get)', warn: 'var(--v2-flag)' } as const

/**
 * The one status surface's transient layer (I10): kinds ok/info/warn with
 * icon and word, a 6 s expiry, and persistence until dismissed when the OS
 * asks for reduced motion. Everything a toast says is derivable from an
 * observed scope; a toast never carries authority.
 */
export function Toasts() {
    const toasts = useShellStore((s) => s.toasts)
    const dismiss = useShellStore((s) => s.dismissToast)
    return (
        <div data-slot='toasts' className='pointer-events-none fixed inset-x-0 bottom-6 z-40 flex justify-center px-4'>
            {toasts.map((toast) => (
                <ToastView key={toast.id} toast={toast} onDismiss={() => dismiss(toast.id)} />
            ))}
        </div>
    )
}

function ToastView({ toast, onDismiss }: { toast: Toast; onDismiss: () => void }) {
    // The deadline is the toast's, not the render's: re-renders (snapshot
    // updates) never restart it.
    useEffect(() => {
        if (reducedMotion()) return
        const timer = window.setTimeout(() => useShellStore.getState().dismissToast(toast.id), useShellStore.getState().toastMs)
        return () => window.clearTimeout(timer)
    }, [toast.id])
    const Icon = ICONS[toast.kind]
    return (
        <div
            role='status'
            aria-live='polite'
            data-slot='toast'
            data-kind={toast.kind}
            className='pointer-events-auto flex max-w-[640px] items-center gap-3 rounded-[12px] border px-4 py-3 text-[13px] shadow-lg'
            style={{ background: 'var(--v2-paper)', borderColor: 'var(--v2-rule)', color: 'var(--v2-ink)' }}
        >
            <Icon aria-hidden='true' size={16} strokeWidth={2.4} style={{ color: COLORS[toast.kind] }} />
            <span className='sr-only'>{SHELL_COPY.toastPrefix[toast.kind]}</span>
            <span className='flex-grow'>{toast.text}</span>
            {toast.undo && (
                <button
                    type='button'
                    onClick={() => {
                        toast.undo?.run()
                        onDismiss()
                    }}
                    className='h-8 rounded-[7px] border px-3 text-[12px] font-semibold'
                    style={{ borderColor: 'var(--v2-rule)' }}
                >
                    {toast.undo.label}
                </button>
            )}
            <button type='button' aria-label='Dismiss' onClick={onDismiss} className='h-8 w-8 rounded-[7px] text-[16px] leading-none'>
                ×
            </button>
        </div>
    )
}
import { forwardRef } from 'react'
import type { FeatureId, ShellSnapshot } from '@prisma-airs/desktop-contracts'
import { FEATURE_ICONS } from '../shell/icons'
import { HOME_COPY } from './copy'
import { Verdict } from './verdict'

export interface HomeProps {
    snapshot: ShellSnapshot
    onNavigate: (id: FeatureId) => void
}

function clock(seconds: number): string {
    const d = new Date(seconds * 1000)
    return `${String(d.getHours()).padStart(2, '0')}:${String(d.getMinutes()).padStart(2, '0')}`
}

/**
 * Home (C28 skeleton; attention items and product read cards land in C30):
 * the destination title row, the tenant line, the one read-status line
 * derived from the observed overview, the tenant's capabilities, and the
 * destinations. Nothing here is invented: every line reads the snapshot.
 */
export const Home = forwardRef<HTMLHeadingElement, HomeProps>(function Home({ snapshot, onNavigate }, ref) {
    const tenant = snapshot.tenants.find((t) => t.id === snapshot.active?.tenant) ?? null
    const overview = snapshot.overview
    const readLine = !tenant
        ? HOME_COPY.noTenant
        : overview.refreshing && !overview.read
          ? HOME_COPY.reading
          : overview.face === 'firstLaunch' || !overview.read
            ? HOME_COPY.firstRead
            : overview.failure && overview.failedAt
              ? HOME_COPY.readFailed(clock(overview.failedAt))
              : HOME_COPY.readAt(clock(overview.read.readAt))
    const readTone = !tenant || overview.face === 'firstLaunch' || !overview.read ? 'info' : overview.failure ? 'flagged' : 'allowed'
    const capabilities = tenant
        ? [
              { label: HOME_COPY.scan, state: tenant.scan.state },
              { label: HOME_COPY.management, state: tenant.management.state },
              { label: HOME_COPY.inference, state: tenant.inference.state },
          ]
        : []
    return (
        <section aria-labelledby='home-heading' data-slot='home' style={{ maxWidth: 'var(--v2-reading)' }}>
            <div className='flex flex-col gap-1'>
                <h1 ref={ref} id='home-heading' tabIndex={-1} className='font-bold' style={{ fontSize: 'var(--v2-title)' }}>
                    {HOME_COPY.title}
                </h1>
                {tenant && (
                    <p className='text-[13px]' style={{ color: 'var(--v2-soft)' }}>
                        {tenant.label}
                        {tenant.tsgId ? ` · TSG ${tenant.tsgId}` : ''}
                    </p>
                )}
                <p role='status' aria-live='polite' data-slot='read-status' className='mt-1 text-[13px]'>
                    <Verdict tone={readTone} word={readLine} />
                </p>
            </div>
            <div className='mt-6 rounded-[12px] border p-5' style={{ borderColor: 'var(--v2-rule)', background: 'var(--v2-paper)' }}>
                <h2 className='text-[15px] font-semibold'>Needs attention</h2>
                <p className='mt-2 text-[13px]' style={{ color: 'var(--v2-faint)' }}>
                    {overview.attention.length === 0 ? HOME_COPY.allClear : HOME_COPY.inboxSoon}
                </p>
            </div>
            {capabilities.length > 0 && (
                <div className='mt-6'>
                    <h2 className='text-[15px] font-semibold'>{HOME_COPY.capabilities}</h2>
                    <ul className='mt-3 grid gap-3' style={{ gridTemplateColumns: 'repeat(auto-fill, minmax(220px, 1fr))' }}>
                        {capabilities.map((c) => (
                            <li key={c.label} className='rounded-[12px] border p-4' style={{ borderColor: 'var(--v2-rule)', background: 'var(--v2-paper)' }}>
                                <p className='text-[13px] font-semibold'>{c.label}</p>
                                <p className='mt-2'>
                                    <Verdict
                                        tone={c.state === 'ready' ? 'allowed' : c.state === 'failed' ? 'blocked' : 'info'}
                                        word={HOME_COPY.state[c.state] ?? c.state}
                                    />
                                </p>
                            </li>
                        ))}
                    </ul>
                </div>
            )}
            <div className='mt-6'>
                <h2 className='text-[15px] font-semibold'>{HOME_COPY.destinations}</h2>
                <ul className='mt-3 grid gap-3' style={{ gridTemplateColumns: 'repeat(auto-fill, minmax(200px, 1fr))' }}>
                    {snapshot.features
                        .filter((f) => f.sidebar && f.id !== 'home')
                        .map((f) => {
                            const Icon = FEATURE_ICONS[f.id]
                            const unavailable = f.availability.state === 'unavailable'
                            return (
                                <li key={f.id}>
                                    <button
                                        type='button'
                                        disabled={unavailable}
                                        onClick={() => onNavigate(f.id)}
                                        className='flex min-h-11 w-full items-center gap-3 rounded-[12px] border px-4 text-left text-[14px] font-medium disabled:opacity-60'
                                        style={{ borderColor: 'var(--v2-rule)', background: 'var(--v2-paper)' }}
                                    >
                                        <Icon aria-hidden='true' size={16} />
                                        <span className='flex-grow'>{f.label}</span>
                                        {unavailable && f.availability.state === 'unavailable' && (
                                            <span className='text-[11px] uppercase' style={{ color: 'var(--v2-faint)' }}>
                                                {f.availability.plannedChunk}
                                            </span>
                                        )}
                                    </button>
                                </li>
                            )
                        })}
                </ul>
            </div>
        </section>
    )
})
import type { LucideIcon } from 'lucide-react'
import { CircleAlert, CircleCheck, CircleSlash, Info } from 'lucide-react'

export type VerdictTone = 'blocked' | 'flagged' | 'allowed' | 'info'

const TONES: Record<VerdictTone, { icon: LucideIcon; fg: string; bg: string }> = {
    blocked: { icon: CircleSlash, fg: 'var(--v2-block)', bg: 'var(--v2-block-bg)' },
    flagged: { icon: CircleAlert, fg: 'var(--v2-flag)', bg: 'var(--v2-flag-bg)' },
    allowed: { icon: CircleCheck, fg: 'var(--v2-ok)', bg: 'var(--v2-ok-bg)' },
    info: { icon: Info, fg: 'var(--v2-soft)', bg: 'var(--v2-inset)' },
}

/**
 * A verdict or severity is colour plus icon plus word, never colour alone
 * (invariant I9). The word is the accessible name; the icon is decorative.
 */
export function Verdict({ tone, word, reason }: { tone: VerdictTone; word: string; reason?: string }) {
    const { icon: Icon, fg, bg } = TONES[tone]
    return (
        <span
            data-slot='verdict'
            data-tone={tone}
            style={{ color: fg, background: bg }}
            className='inline-flex min-h-7 items-center gap-1.5 rounded-[7px] px-2 text-[12px] font-semibold'
        >
            <Icon aria-hidden='true' size={14} strokeWidth={2.4} />
            <span>{word}</span>
            {reason && <span className='font-normal opacity-90'> · {reason}</span>}
        </span>
    )
}
