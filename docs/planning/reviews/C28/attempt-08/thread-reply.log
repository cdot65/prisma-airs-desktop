/* ─────────────────────────────────────────────────────────────────────────
 * Shared base + interaction helpers (ADR 0002)
 *
 * General presentation every consumer needs: the global keyboard focus ring
 * (WCAG 2.4.7) and body base, the nav/icon-button hover helpers applied by the
 * shared shell and controls, the `ax-pulse` keyframe behind StatusChip's live
 * dot, and the reduced-motion clamp. Academy-only reward/shift animations stay
 * in the web app's animations.css.
 * ───────────────────────────────────────────────────────────────────────── */

@layer base {
    /* ── Global focus indicator (WCAG 2.4.7) ────────────────────────────────
     * Every interactive element gets a 2px accent ring with a 2px offset on
     * keyboard focus. `:where()` keeps specificity at the pseudo-class floor
     * so a component with a bespoke focus treatment can still opt out with an
     * `outline-none` utility (utilities layer wins the cascade). */
    :where(
        a,
        button,
        input,
        select,
        textarea,
        summary,
        [tabindex]
    ):focus-visible {
        outline: 2px solid var(--academy-focus-ring);
        outline-offset: 2px;
    }

    body {
        background: var(--academy-bg);
        color: var(--academy-ink);
        font-family: var(--academy-font-body);
        -webkit-font-smoothing: antialiased;
        text-rendering: optimizeLegibility;
    }
}

@keyframes ax-pulse {
    0%,
    100% {
        opacity: 1;
        transform: scale(1);
    }
    50% {
        opacity: 0.4;
        transform: scale(0.8);
    }
}

/* Interaction helpers — applied by the shared shell/controls. */
.ax-nav {
    text-decoration: none;
    transition:
        color var(--academy-dur-1) var(--academy-ease),
        background var(--academy-dur-1) var(--academy-ease);
}
.ax-nav:hover {
    color: var(--academy-ink) !important;
    background: var(--academy-bg-inset) !important;
}

.ax-icbtn {
    transition:
        background var(--academy-dur-1),
        color var(--academy-dur-1);
}
.ax-icbtn:hover {
    background: var(--academy-paper-deep) !important;
    color: var(--academy-ink) !important;
}

@media (prefers-reduced-motion: reduce) {
    *,
    *::before,
    *::after {
        animation-duration: 0.001ms !important;
        animation-iteration-count: 1 !important;
        transition-duration: 0.001ms !important;
    }
}
