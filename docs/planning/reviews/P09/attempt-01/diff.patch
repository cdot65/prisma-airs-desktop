+import type { ReactNode } from 'react'
+import type { AdminProduct, AdminTab } from '@prisma-airs/desktop-contracts'
+import { Glyph, PRODUCT_GLYPHS, type GlyphName } from '../icons'
+import { ADMIN_COPY as C } from './copy'
+
