+      primary: pr.ok ? pr.go : () => {}, primaryDisabled: !pr.ok, primaryLabel: step === 'done' && s.opened === 'opening' ? 'Opening…' : step === 'done' && s.opened === 'done' ? 'Prisma AIRS is open' : pr.label,
