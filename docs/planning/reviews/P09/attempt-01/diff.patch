+                                            ? C.mcpFailed(MANAGEMENT_FAILURE_TEXT[mcpView.failure])
+                                            : `${C.mcpHeading(mcpServers.filter((s) => s.enabled).length, mcpServers.length)}${mcpView.complete ? '' : ` · ${C.mcpPartial}`}`}
+                                </div>
+                                {mcpShown.map((s) => {
+                                    const st = mcpStanding(s)
+                                    return (
+                                        <div key={s.id} className='flex items-center justify-between gap-2'>
+                                            <span className='truncate'>{s.name}</span>
+                                            <span className='shrink-0 font-semibold' style={{ color: st.tone === 'ok' ? 'var(--v2-ok)' : st.tone === 'flag' ? 'var(--v2-flag)' : 'var(--v2-faint)' }}>
+                                                {st.word}
+                                            </span>
+                                        </div>
+                                    )
+                                })}
+                                {mcpServers.length > mcpShown.length ? (
+                                    <div style={{ color: 'var(--v2-faint)' }} data-slot='harness-mcp-more'>
+                                        {C.mcpMore(mcpServers.length - mcpShown.length)}
+                                    </div>
+                                ) : null}
+                            </div>
+                        ) : null}
+                        {context ? (
+                            <section data-slot='harness-setup' aria-labelledby='harness-setup-toggle' className='rounded-[12px] border p-3' style={{ borderColor: 'var(--v2-rule)', background: 'var(--v2-paper)' }}>
+                                <h2 className='m-0'>
+                                    <button id='harness-setup-toggle' type='button' aria-expanded={setupOpen} aria-controls='harness-setup-panels' className='flex w-full items-center justify-between text-left text-[13px] font-bold' onClick={() => setSetupOpen((o) => !o)}>
+                                        <span>{C.setup}</span>
+                                        <Glyph name={setupOpen ? 'chev' : 'chevR'} size={12} stroke={2.2} color='var(--v2-faint)' />
+                                    </button>
+                                </h2>
+                                <div id='harness-setup-panels' hidden={!setupOpen} className='mt-3 flex flex-col gap-4'>
+                                    {selected ? <SignInPanel context={context} selected={selected} signIn={signIn} keyHere={keyHere} running={running} dispatch={dispatch} onMessage={setProblem} /> : null}
+                                    <ProjectPanel context={context} project={snapshot.harness.project} refused={snapshot.harness.projectRefused} running={running} dispatch={dispatch} onMessage={setProblem} />
+                                    {selected ? <McpPanel context={context} selected={selected} mcp={snapshot.harness.mcp} running={running} dispatch={dispatch} onMessage={setProblem} /> : null}
+                                </div>
+                            </section>
+                        ) : null}
+                        {context ? (
+                            <div data-slot='harness-history' className='rounded-[12px] border p-3' style={{ borderColor: 'var(--v2-rule)', background: 'var(--v2-paper)' }}>
+                                <HistoryPanel context={context} selected={selected} history={history} running={running} dispatch={dispatch} onMessage={setProblem} />
+                            </div>
+                        ) : null}
+                    </div>
+                </aside>
+            </div>
+        </section>
+    )
+})
+
+/**
+ * How the conversation stands, in words the C19–C22 Harness used (R5): a
+ * failure names itself; a stopped, cut, failed or refused answer is never
+ * shown as complete; an engine that could not be removed says so.
+ */
+function outcomeOf(c: ConversationView): { tone: VerdictTone; word: string; text: string } | null {
+    if (c.phase === 'failed') return { tone: 'blocked', word: C.outcome.failed, text: c.failure ? HARNESS_FAILURE_TEXT[c.failure] : conversationText(c) }
+    if (c.cleanup === 'failed') return { tone: 'blocked', word: C.outcome.cleanup, text: HARNESS_FAILURE_TEXT.cleanupFailed }
+    if (c.phase === 'ended') return { tone: 'info', word: C.outcome.ended, text: conversationText(c) }
+    if (c.lastTurn && c.lastTurn !== 'completed' && c.phase === 'ready') {
+        return { tone: c.lastTurn === 'failed' ? 'blocked' : 'flagged', word: C.outcome.turn[c.lastTurn] ?? c.lastTurn, text: TURN_TEXT[c.lastTurn] }
+    }
+    return null
+}
+
+function Transcript({ entries }: { entries: HarnessEntry[] }) {
+    return (
+        <ol className='flex flex-col' style={{ gap: 18 }}>
+            {entries.map((e) => {
+                const mine = e.role === 'operator'
+                return (
+                    <li
+                        key={e.id}
+                        data-slot='harness-entry'
+                        data-role={e.role}
+                        data-state={e.state}
+                        className='flex shrink-0 flex-col gap-1'
+                        style={mine ? { alignSelf: 'flex-end', maxWidth: '70%' } : { maxWidth: '82%' }}
+                    >
+                        <span className='text-[12px] font-medium' style={{ color: 'var(--v2-faint)' }}>
+                            {C.role[e.role] ?? e.role}
+                            {C.entryState[e.state] ? ` · ${C.entryState[e.state]}` : ''}
+                        </span>
+                        <p
+                            className='text-[13px] leading-[1.45] whitespace-pre-wrap'
+                            style={mine ? { padding: '10px 14px', borderRadius: '14px 14px 4px 14px', background: 'var(--v2-acc)', color: 'var(--v2-acc-ink)' } : { lineHeight: 1.5 }}
+                        >
+                            {e.text}
+                        </p>
+                    </li>
+                )
+            })}
+        </ol>
+    )
+}
+
+/**
+ * One decision, as the core classified it (R1): a read-only call is decided
+ * here; anything that may change things says what, and approving it opens
+ * the system confirmation, which alone lets it run.
+ */
+function Decision({ approval: a, busy, onDecide }: { approval: HarnessApproval; busy: boolean; onDecide: (allow: boolean) => void }) {
+    const what = a.server && a.tool ? `${a.server}.${a.tool}` : (a.command ?? a.files.join(', '))
+    // Absent (a snapshot before C32) counts as may-change: never a false assurance.
+    const readOnly = a.effect === 'readOnly'
+    return (
+        <section aria-label={C.decision} data-slot='harness-decision' data-kind={a.kind} data-effect={a.effect ?? 'mayChange'} className='flex flex-col rounded-[12px] border' style={{ gap: 12, padding: 18, borderColor: readOnly ? 'var(--v2-rule)' : 'var(--v2-flag)', background: 'var(--v2-paper)' }}>
+            <div className='flex items-center gap-2'>
+                <Glyph name='plug' size={16} />
+                <b className='text-[13px]'>{C.decision}</b>
+                <span className='ml-auto rounded-full text-[12px] whitespace-nowrap' style={{ padding: '2px 8px', background: 'var(--v2-inset)', color: 'var(--v2-soft)' }}>
+                    {readOnly ? C.readOnlyWord : C.mayChangeWord}
+                </span>
+            </div>
+            <p className='text-[13px]'>{C.asks(C.kind[a.kind] ?? a.kind, what)}</p>
+            {a.arguments ? (
+                <pre className='overflow-x-auto rounded-[8px] p-2.5 font-mono text-[12px] leading-[1.55]' style={{ background: 'var(--v2-inset)' }}>
+                    {a.arguments}
+                </pre>
+            ) : null}
+            <div className='flex flex-col text-[12px]' style={{ gap: 5 }}>
+                {a.cwd ? <p>{C.inFolder(a.cwd)}</p> : null}
+                {a.reason ? <p>{a.reason}</p> : null}
+            </div>
+            <p className='rounded-[8px] text-[12px] leading-[1.45]' style={{ padding: '8px 10px', background: 'var(--v2-acc-soft)' }}>
+                {readOnly ? (C.readOnlyNote[a.kind] ?? C.readOnlyNote.desktopRead) : (C.mayChangeNote[a.kind] ?? C.mayChangeNote.mcpTool)}
+            </p>
+            <div className='flex gap-2'>
+                <button type='button' disabled={busy} className='h-8 min-h-0 flex-grow rounded-[7px] text-[13px] font-semibold disabled:opacity-60' style={{ background: 'var(--v2-acc)', color: 'var(--v2-acc-ink)' }} onClick={() => onDecide(true)}>
+                    {readOnly ? C.approveOnce : C.approveNative}
+                </button>
+                <button type='button' disabled={busy} className='h-8 min-h-0 flex-grow rounded-[7px] border text-[13px] disabled:opacity-60' style={{ borderColor: 'var(--v2-rule)', background: 'var(--v2-paper)' }} onClick={() => onDecide(false)}>
+                    {C.decline}
+                </button>
+            </div>
+        </section>
+    )
+}
+
+function applicationOf(p: ProposalView): string | null {
+    try {
+        const body = JSON.parse(p.draft.body) as { cust_app?: unknown }
+        return typeof body.cust_app === 'string' ? body.cust_app : null
+    } catch {
+        return null
+    }
+}
+
+/** The Harness's proposals as follow-ups: each opens only as the operator's own review, and only while its conversation runs. */
+function FollowUps({
+    proposals,
+    rotations,
+    busy,
+    open,
+    onOpen,
+    onDismiss,
+}: {
+    proposals: ProposalView[]
+    rotations: RotationView[]
+    busy: boolean
+    open: boolean
+    onOpen: (p: ProposalView) => void
+    onDismiss: (p: ProposalView) => void
+}) {
+    return (
+        <section aria-label={C.followUps} data-slot='harness-follow-ups' className='flex flex-col gap-2 rounded-[12px] border p-3' style={{ borderColor: 'var(--v2-rule)' }}>
+            <h2 className='text-[14px] font-semibold'>{C.followUps}</h2>
+            <p className='text-[12px]' style={{ color: 'var(--v2-soft)' }}>
+                {open ? C.followUpNote : C.followUpEnded}
+            </p>
+            <ul className='flex flex-col gap-2'>
+                {proposals.map((p) => {
+                    // A key rotation's hand-off says where the rotation stands (I7).
+                    const app = p.draft.kind === 'apiKeys' && p.draft.action === 'version' ? applicationOf(p) : null
+                    const rotation = app ? (rotations.find((r) => r.application === app) ?? null) : null
+                    const stateTone: VerdictTone = p.state === 'staged' ? 'info' : p.state === 'inReview' ? 'flagged' : 'allowed'
+                    return (
+                        <li key={p.id} data-slot='follow-up' data-kind={p.draft.kind} data-action={p.draft.action} data-state={p.state} className='flex flex-col gap-1 text-[13px]'>
+                            <span className='font-medium'>{p.summary}</span>
+                            {app ? (
+                                <span data-slot='follow-up-rotation' className='text-[12px]'>
+                                    {rotation ? (C.rotation[rotation.stage] ?? rotation.stage) : C.rotation.none}
+                                </span>
+                            ) : null}
+                            {p.state !== 'staged' ? <Verdict tone={stateTone} word={p.state === 'inReview' ? C.inReview : p.state === 'closed' ? C.closed : C.dismissed} /> : null}
+                            {open && (p.state === 'staged' || p.state === 'inReview') ? (
+                                <div className='flex flex-wrap gap-2'>
+                                    <button
+                                        type='button'
+                                        disabled={busy}
+                                        className='h-8 rounded-[7px] px-3 text-[13px] font-semibold disabled:opacity-60'
+                                        style={{ background: 'var(--v2-acc)', color: 'var(--v2-acc-ink)' }}
+                                        onClick={() => onOpen(p)}
+                                    >
+                                        {p.state === 'staged' ? C.openReview : C.goToReview}
+                                    </button>
+                                    {p.state === 'staged' ? (
+                                        <button type='button' disabled={busy} className='h-8 rounded-[7px] border px-3 text-[13px] disabled:opacity-60' style={{ borderColor: 'var(--v2-rule)' }} onClick={() => onDismiss(p)}>
+                                            {C.dismiss}
+                                        </button>
+                                    ) : null}
+                                </div>
+                            ) : null}
+                        </li>
+                    )
+                })}
+            </ul>
+        </section>
+    )
+}
diff --git a/apps/desktop/src/v2/harness/panels/controls.tsx b/apps/desktop/src/v2/harness/panels/controls.tsx
new file mode 100644
index 00000000..e71f1336
--- /dev/null
+++ b/apps/desktop/src/v2/harness/panels/controls.tsx
@@ -0,0 +1,30 @@
+import type { ButtonHTMLAttributes, InputHTMLAttributes } from 'react'
+
+/** The prototype's 32px controls (R2App): a primary accent button, a bordered secondary, a plain tertiary. */
+export function Btn({ tier = 'secondary', className = '', style, ...rest }: ButtonHTMLAttributes<HTMLButtonElement> & { tier?: 'primary' | 'secondary' | 'tertiary' }) {
+    const look =
+        tier === 'primary'
+            ? { background: 'var(--v2-acc)', color: 'var(--v2-acc-ink)', border: 0 }
+            : tier === 'secondary'
+              ? { background: 'var(--v2-paper)', color: 'var(--v2-ink)', border: '1px solid var(--v2-rule)' }
+              : { background: 'transparent', color: 'var(--v2-soft)', border: '1px solid var(--v2-rule)' }
+    return (
+        <button
+            type='button'
+            {...rest}
+            className={`flex h-8 min-h-0 items-center justify-center rounded-[7px] px-3 text-[12px] whitespace-nowrap disabled:cursor-not-allowed disabled:opacity-60 ${tier === 'primary' ? 'font-semibold' : ''} ${className}`}
+            style={{ ...look, ...style }}
+        />
+    )
+}
+
+/** A 32px text field with the prototype's control border. */
+export function Field({ className = '', style, ...rest }: InputHTMLAttributes<HTMLInputElement>) {
+    return (
+        <input
+            {...rest}
+            className={`h-8 min-h-0 rounded-[7px] border px-2.5 text-[13px] ${className}`}
+            style={{ borderColor: 'var(--v2-ctl)', background: 'var(--v2-paper)', color: 'var(--v2-ink)', ...style }}
+        />
+    )
+}
diff --git a/apps/desktop/src/v2/harness/panels/history.tsx b/apps/desktop/src/v2/harness/panels/history.tsx
new file mode 100644
index 00000000..34ce4015
--- /dev/null
+++ b/apps/desktop/src/v2/harness/panels/history.tsx
@@ -0,0 +1,233 @@
+import { useEffect, useId, useRef, useState } from 'react'
+import type { ContextRef, HarnessHistoryView, HistoryFormat, SelectedWorkspace } from '@prisma-airs/desktop-contracts'
+import type { Dispatch } from '../../../features/tenants/dispatch'
+import { HISTORY_FAILURE_TEXT, HISTORY_FORMATS, NOT_CONTINUABLE_TEXT, actionOutcomeText, savedAt } from '../text'
+import { Btn } from './controls'
+
+interface Props {
+    context: ContextRef
+    /** None while no workspace is chosen (as when AI Gateway cannot be read). */
+    selected: SelectedWorkspace | null
+    history: HarnessHistoryView | null
+    /** A conversation is running (one at a time). */
+    running: boolean
+    dispatch: Dispatch
+    onMessage: (message: string | null) => void
+}
+
+const faint = { color: 'var(--v2-faint)' }
+const warn = { color: 'var(--v2-flag)' }
+const card = { borderColor: 'var(--v2-rule)' }
+
+/**
+ * The chosen workspace's saved conversations (C20), as a v2 panel (C38):
+ * saved encrypted on this Mac after every answer. One can be read,
+ * exported, deleted, or continued in a new engine when it ran with the
+ * credential this workspace uses now. With no workspace chosen, the last
+ * chosen one's, read from this Mac only (T23): read, exported and deleted,
+ * never continued.
+ */
+const CHECK = 'Check the conversations shown here before trying again.'
+
+export function HistoryPanel({ context, selected, history, running, dispatch, onMessage }: Props) {
+    const ids = useId()
+    const [format, setFormat] = useState<HistoryFormat>('markdown')
+    const [confirming, setConfirming] = useState<string | null>(null)
+    const openedRef = useRef<HTMLHeadingElement>(null)
+    const listRef = useRef<HTMLHeadingElement>(null)
+    const workspace = selected?.reference ?? null
+    // Without a chosen workspace there may be none saved on this Mac either.
+    const [none, setNone] = useState(false)
+
+    // Read the list whenever the chosen workspace changes.
+    useEffect(() => {
+        let current = true
+        setNone(false)
+        void dispatch({ kind: 'listHarnessHistory', context, workspace }).then((outcome) => {
+            if (current) setNone(workspace === null && outcome.kind !== 'admitted')
+        })
+        return () => {
+            current = false
+        }
+    }, [dispatch, context, workspace])
+
+    const opened = history?.opened ?? null
+    const wasOpened = useRef<string | null>(opened?.id ?? null)
+    useEffect(() => {
+        const was = wasOpened.current
+        wasOpened.current = opened?.id ?? null
+        if (opened && opened.id !== was) openedRef.current?.focus()
+        if (!opened && was !== null) listRef.current?.focus()
+    }, [opened])
+
+    // An unknown delivery stays Not confirmed naming the action (a deletion is permanent and may have happened;
+    // the conversations shown here are the state to reconcile with); a refusal says its own reason.
+    async function send(intent: Parameters<Dispatch>[0], action: string): Promise<boolean> {
+        onMessage(null)
+        const outcome = await dispatch(intent)
+        onMessage(actionOutcomeText(outcome, action, CHECK))
+        return outcome.kind === 'admitted'
+    }
+
+    const busy = history?.busy ?? false
+    const exportState = history?.export ?? null
+    if (none || (selected === null && history !== null && !history.local)) return null
+    return (
+        <section aria-labelledby={`${ids}-heading`} className='flex flex-col gap-3' data-slot='harness-history'>
+            <h2 ref={listRef} tabIndex={-1} id={`${ids}-heading`} className='text-[13px] font-bold'>
+                Saved conversations
+            </h2>
+            <p className='text-[12px]' style={faint}>
+                {selected
+                    ? `Conversations in ${selected.workspace.name} are saved on this Mac after every answer, encrypted with a key kept in the Keychain. Up to 16 are kept; nothing is deleted to make room.`
+                    : 'AI Gateway’s workspaces are not available, so these are the conversations saved on this Mac for the workspace you chose last. They can be read, exported and deleted here; continuing one needs that workspace from AI Gateway.'}
+            </p>
+            {history === null || history.state === 'loading' ? (
+                <p role='status' className='text-[13px]'>
+                    Reading saved conversations…
+                </p>
+            ) : history.state === 'failed' && history.failure ? (
+                <p role='alert' className='text-[13px]' style={warn}>
+                    {HISTORY_FAILURE_TEXT[history.failure]}
+                </p>
+            ) : history.conversations.length === 0 && history.unreadable.length === 0 ? (
+                <p className='text-[13px]'>No saved conversations in this workspace.</p>
+            ) : (
+                <ul role='list' aria-label='Saved conversations' className='flex flex-col gap-2' data-slot='harness-history-list'>
+                    {history.conversations.map((c) => (
+                        <li key={c.id} className='flex flex-wrap items-center gap-3 rounded-[10px] border p-2.5' style={card}>
+                            <span className='flex min-w-0 flex-1 flex-col'>
+                                <span className='truncate text-[13px] font-semibold'>{c.title || 'Untitled conversation'}</span>
+                                <span className='text-[12px]' style={faint}>
+                                    {`${c.entries} messages · ${savedAt(c.updated)} · ${c.source === 'companySignIn' ? 'company sign-in' : 'workspace key'}`}
+                                </span>
+                            </span>
+                            <Btn disabled={busy} aria-label={`Open ${c.title || 'untitled conversation'}`} onClick={() => void send({ kind: 'openHarnessHistory', context, workspace, id: c.id }, 'opening the conversation')}>
+                                Open
+                            </Btn>
+                        </li>
+                    ))}
+                    {history.unreadable.map((id) => (
+                        <li key={id} className='flex flex-wrap items-center gap-3 rounded-[10px] border p-2.5' style={card}>
+                            <span className='flex-1 text-[13px]' style={faint}>
+                                {HISTORY_FAILURE_TEXT.unreadable}
+                            </span>
+                            {/* Its key may be missing only for now (C20 F5): deleting asks first. */}
+                            {confirming === id ? (
+                                <>
+                                    <span role='alert' className='w-full text-[13px]'>
+                                        Delete this unreadable conversation from this Mac? If its key comes back it could be read again; once deleted it cannot be recovered.
+                                    </span>
+                                    <Btn
+                                        disabled={busy}
+                                        onClick={async () => {
+                                            setConfirming(null)
+                                            await send({ kind: 'deleteHarnessHistory', context, workspace, id }, 'deleting the unreadable conversation')
+                                        }}
+                                    >
+                                        Delete permanently
+                                    </Btn>
+                                    <Btn tier='tertiary' onClick={() => setConfirming(null)}>
+                                        Keep it
+                                    </Btn>
+                                </>
+                            ) : (
+                                <Btn tier='tertiary' disabled={busy} onClick={() => setConfirming(id)}>
+                                    Delete unreadable conversation…
+                                </Btn>
+                            )}
+                        </li>
+                    ))}
+                </ul>
+            )}
+            {history?.full ? (
+                <p className='text-[13px]' style={warn}>
+                    {HISTORY_FAILURE_TEXT.full}
+                </p>
+            ) : null}
+            {history?.problem ? (
+                <p role='alert' className='text-[13px]' style={warn} data-slot='harness-history-problem'>
+                    {HISTORY_FAILURE_TEXT[history.problem]}
+                </p>
+            ) : null}
+            {opened ? (
+                <section aria-labelledby={`${ids}-opened`} className='flex flex-col gap-3' data-slot='harness-history-opened'>
+                    <h3 ref={openedRef} tabIndex={-1} id={`${ids}-opened`} className='text-[13px] font-semibold'>
+                        {opened.title || 'Untitled conversation'}
+                    </h3>
+                    <p className='text-[12px]' style={faint}>{`Saved ${savedAt(opened.updated)}`}</p>
+                    <ol role='list' aria-label='Saved messages' className='flex flex-col gap-2'>
+                        {opened.entries.map((e) => (
+                            <li key={e.id} className='rounded-[10px] border p-2.5' style={card}>
+                                <p className='text-[12px] font-semibold' style={faint}>
+                                    {e.role === 'operator' ? 'You' : 'Harness'}
+                                </p>
+                                <p className='text-[13px] whitespace-pre-wrap'>{e.text}</p>
+                            </li>
+                        ))}
+                    </ol>
+                    {opened.notContinuable ? <p className='text-[13px]'>{NOT_CONTINUABLE_TEXT[opened.notContinuable]}</p> : null}
+                    <div className='flex flex-wrap items-end gap-2'>
+                        {opened.notContinuable === null && workspace !== null ? (
+                            <Btn tier='primary' disabled={busy || running} onClick={() => void send({ kind: 'resumeHarness', context, workspace, id: opened.id }, 'continuing the conversation')}>
+                                Continue this conversation
+                            </Btn>
+                        ) : null}
+                        <label className='flex flex-col gap-1 text-[12px]'>
+                            <span>Export as</span>
+                            <select value={format} onChange={(event) => setFormat(event.target.value as HistoryFormat)} className='h-8 min-h-0 rounded-[7px] border px-2 text-[13px]' style={{ borderColor: 'var(--v2-ctl)', background: 'var(--v2-paper)' }}>
+                                {HISTORY_FORMATS.map(([value, label]) => (
+                                    <option key={value} value={value}>
+                                        {label}
+                                    </option>
+                                ))}
+                            </select>
+                        </label>
+                        <Btn disabled={exportState?.state === 'saving'} onClick={() => void send({ kind: 'exportHarnessHistory', context, workspace, id: opened.id, format }, 'exporting the conversation')}>
+                            Export…
+                        </Btn>
+                        {confirming === opened.id ? (
+                            <>
+                                <Btn
+                                    disabled={busy}
+                                    onClick={async () => {
+                                        setConfirming(null)
+                                        await send({ kind: 'deleteHarnessHistory', context, workspace, id: opened.id }, 'deleting the conversation')
+                                    }}
+                                >
+                                    Delete permanently
+                                </Btn>
+                                <Btn tier='tertiary' onClick={() => setConfirming(null)}>
+                                    Keep it
+                                </Btn>
+                            </>
+                        ) : (
+                            <Btn tier='tertiary' disabled={busy || opened.notContinuable === 'running'} onClick={() => setConfirming(opened.id)}>
+                                Delete…
+                            </Btn>
+                        )}
+                        <Btn tier='tertiary' onClick={() => void send({ kind: 'closeHarnessHistory', context, workspace }, 'closing the conversation')}>
+                            Close
+                        </Btn>
+                    </div>
+                    {confirming === opened.id ? (
+                        <p role='alert' className='text-[13px]'>
+                            Delete this saved conversation from this Mac? It cannot be recovered.
+                        </p>
+                    ) : null}
+                    {exportState ? (
+                        <p role='status' className='text-[13px]' data-slot='harness-export'>
+                            {exportState.state === 'saving'
+                                ? 'Choose where to save the transcript…'
+                                : exportState.state === 'saved'
+                                  ? `Saved ${exportState.name ?? 'the transcript'}.`
+                                  : exportState.state === 'cancelled'
+                                    ? 'Export cancelled.'
+                                    : 'The transcript could not be saved.'}
+                        </p>
+                    ) : null}
+                </section>
+            ) : null}
+        </section>
+    )
+}
diff --git a/apps/desktop/src/v2/harness/panels/mcp.tsx b/apps/desktop/src/v2/harness/panels/mcp.tsx
new file mode 100644
index 00000000..0cf25913
--- /dev/null
+++ b/apps/desktop/src/v2/harness/panels/mcp.tsx
@@ -0,0 +1,181 @@
+import { useEffect, useId, useState } from 'react'
+import type { ContextRef, HarnessMcpView, McpServerView, Refusal, SelectedWorkspace } from '@prisma-airs/desktop-contracts'
+import { MANAGEMENT_FAILURE_TEXT } from '../../../features/administration/management-read'
+import type { Dispatch } from '../../../features/tenants/dispatch'
+import { MCP_MAX_ON, MCP_SIGN_IN_FAILURE_TEXT, MCP_STEP_TEXT, actionOutcomeText } from '../text'
+import { Btn } from './controls'
+
+function standing(s: McpServerView): string {
+    if (!s.supported) return 'This server’s identifier is not one the Harness engine accepts; it cannot be used.'
+    if (s.expired) return MCP_SIGN_IN_FAILURE_TEXT[s.expired]
+    if (s.stale) return 'Signed in for an earlier version of this server. Sign in again to use it.'
+    if (s.signedIn) return 'Signed in.'
+    return 'Not signed in: its tools will be unavailable until you sign in.'
+}
+
+/** The aside's one-line standing (R2App's "Signed in" column). */
+export function mcpStanding(s: McpServerView): { word: string; tone: 'ok' | 'flag' | 'faint' } {
+    if (!s.supported) return { word: 'Not usable', tone: 'faint' }
+    if (s.expired) return { word: 'Sign-in expired', tone: 'flag' }
+    if (s.stale) return { word: 'Sign in again', tone: 'flag' }
+    if (s.signedIn) return { word: 'Signed in', tone: 'ok' }
+    return { word: 'Not signed in', tone: 'faint' }
+}
+
+interface Props {
+    context: ContextRef
+    selected: SelectedWorkspace
+    mcp: HarnessMcpView | null
+    /** A conversation is running (changing its servers ends it). */
+    running: boolean
+    dispatch: Dispatch
+    onMessage: (message: string | null) => void
+}
+
+const faint = { color: 'var(--v2-faint)' }
+
+/**
+ * The chosen workspace's MCP servers (C22, D049), as a v2 panel (C38): read
+ * from its Gateway catalog, turned on for new conversations (at most
+ * eight), each signed in to in the browser by this app. The engine only
+ * ever gets each server's token in memory, and asks before every tool call.
+ */
+const CHECK = 'Check the servers shown here before trying again.'
+
+// The panel's own wording only for the refusals whose meaning this action fixes (crates/desktop-core/src/authority/
+// harness_mcp.rs): turning a server on is refused as invalidInput when it is not a supported catalog server and as busy
+// at the eight-server bound; starting a sign-in is refused as invalidInput for an unknown server and as busy while
+// another sign-in is in progress. Every other refusal (storage denied or locked, a retired context, …) keeps its own
+// reason and recovery, and turning a server off has no special wording (attempt-03 R1).
+const ENABLE_REFUSED: Partial<Record<Refusal, string>> = {
+    invalidInput: 'That was not done. Only servers in this workspace’s catalog that the engine accepts can be turned on.',
+    busy: 'That was not done. At most eight servers can be on.',
+}
+const SIGN_IN_REFUSED: Partial<Record<Refusal, string>> = {
+    invalidInput: 'Sign-in could not start. The server is not in this workspace’s catalog.',
+    busy: 'Sign-in could not start. Another sign-in is in progress.',
+}
+
+export function McpPanel({ context, selected, mcp, running, dispatch, onMessage }: Props) {
+    const ids = useId()
+    const [busy, setBusy] = useState(false)
+    const workspace = selected.reference
+    const here = mcp !== null && mcp.workspace === selected.workspace.id
+
+    // Read the catalog whenever the chosen workspace changes.
+    useEffect(() => {
+        void dispatch({ kind: 'listMcpServers', context, workspace })
+    }, [dispatch, context, workspace])
+
+    // An unknown delivery stays Not confirmed naming the action (a sign-out or a change of which servers are on
+    // may have happened; the catalog shown here is the state to reconcile with); a refusal says this panel's
+    // reason for that refusal kind when the action fixes its meaning, else the refusal's own.
+    async function send(intent: Parameters<Dispatch>[0], action: string, refused?: Partial<Record<Refusal, string>>) {
+        onMessage(null)
+        setBusy(true)
+        try {
+            onMessage(actionOutcomeText(await dispatch(intent), action, CHECK, (refusal) => refused?.[refusal]))
+        } finally {
+            setBusy(false)
+        }
+    }
+
+    const servers = here ? mcp.servers : []
+    const on = servers.filter((s) => s.enabled).length
+    const signingIn = servers.some((s) => s.step !== null)
+    return (
+        <section aria-labelledby={`${ids}-heading`} className='flex flex-col gap-2 rounded-[12px] border p-3' style={{ borderColor: 'var(--v2-rule)' }} data-slot='harness-mcp'>
+            <h2 id={`${ids}-heading`} className='text-[13px] font-bold'>
+                Workspace MCP servers
+            </h2>
+            <p className='text-[12px]' style={faint}>
+                Servers published in this workspace’s AI Gateway. The Harness asks you before every tool call, and each server’s sign-in stays with this app.
+            </p>
+            {!here || mcp.state === 'loading' ? (
+                <p role='status' className='text-[13px]'>
+                    Reading the workspace’s MCP servers…
+                </p>
+            ) : null}
+            {here && mcp.failure ? (
+                <p role='alert' className='text-[13px]' style={{ color: 'var(--v2-flag)' }}>
+                    {`The MCP servers could not be read: ${MANAGEMENT_FAILURE_TEXT[mcp.failure]}`}
+                </p>
+            ) : null}
+            {here && mcp.state !== 'loading' && servers.length === 0 && !mcp.failure ? <p className='text-[13px]'>No MCP servers are published in this workspace.</p> : null}
+            {here && !mcp.complete && servers.length > 0 ? (
+                <p className='text-[12px]' style={faint}>
+                    Only the first 500 servers are shown.
+                </p>
+            ) : null}
+            {servers.length > 0 ? (
+                <ul role='list' aria-label='MCP servers' className='flex flex-col gap-2'>
+                    {servers.map((s) => {
+                        const holdsSignIn = s.signedIn || s.stale || s.expired !== null
+                        return (
+                            <li key={s.id} className='rounded-[8px] border p-2' style={{ borderColor: 'var(--v2-rule)' }} data-slot='harness-mcp-server'>
+                                <label className='flex items-start gap-2 text-[13px] font-semibold'>
+                                    <input
+                                        type='checkbox'
+                                        className='mt-[3px] size-4 min-h-0'
+                                        checked={s.enabled}
+                                        disabled={busy || !s.supported || (!s.enabled && on >= MCP_MAX_ON)}
+                                        aria-describedby={`${ids}-${s.id}-standing`}
+                                        onChange={(event) =>
+                                            void send(
+                                                { kind: 'enableMcpServer', context, workspace, server: s.id, enabled: event.target.checked },
+                                                event.target.checked ? `turning ${s.name} on` : `turning ${s.name} off`,
+                                                event.target.checked ? ENABLE_REFUSED : undefined
+                                            )
+                                        }
+                                    />
+                                    {`Use ${s.name} in new conversations`}
+                                </label>
+                                <p className='font-mono text-[11px] break-all'>{`${s.namespace} · ${s.url}`}</p>
+                                <p id={`${ids}-${s.id}-standing`} className='text-[12px]'>
+                                    {standing(s)}
+                                </p>
+                                {s.step ? (
+                                    <p role='status' className='text-[12px]'>
+                                        {MCP_STEP_TEXT[s.step]}
+                                    </p>
+                                ) : null}
+                                {s.failure ? (
+                                    <p role='alert' className='text-[12px]' style={{ color: 'var(--v2-flag)' }}>
+                                        {MCP_SIGN_IN_FAILURE_TEXT[s.failure]}
+                                    </p>
+                                ) : null}
+                                <div className='mt-1 flex flex-wrap gap-2'>
+                                    {s.step ? (
+                                        <Btn tier='tertiary' onClick={() => void send({ kind: 'cancelMcpSignIn', context }, 'cancelling the sign-in')}>
+                                            Cancel sign-in
+                                        </Btn>
+                                    ) : (
+                                        <Btn
+                                            disabled={busy || !s.supported || signingIn}
+                                            onClick={() => void send({ kind: 'signInMcpServer', context, workspace, server: s.id }, `starting the sign-in to ${s.name}`, SIGN_IN_REFUSED)}
+                                        >
+                                            {holdsSignIn ? `Sign in to ${s.name} again` : `Sign in to ${s.name}`}
+                                        </Btn>
+                                    )}
+                                    {holdsSignIn ? (
+                                        <Btn tier='tertiary' disabled={busy} onClick={() => void send({ kind: 'signOutMcpServer', context, workspace, server: s.id }, `signing out of ${s.name}`)}>
+                                            {`Sign out of ${s.name}`}
+                                        </Btn>
+                                    ) : null}
+                                </div>
+                            </li>
+                        )
+                    })}
+                </ul>
+            ) : null}
+            {running ? (
+                <p className='text-[12px]' style={faint}>
+                    Turning a server off, signing in again or signing out ends the running conversation that uses it.
+                </p>
+            ) : null}
+            <Btn tier='tertiary' className='self-start' disabled={here && mcp.state === 'loading'} onClick={() => void send({ kind: 'listMcpServers', context, workspace }, 'reading the servers')}>
+                Read the servers again
+            </Btn>
+        </section>
+    )
+}
diff --git a/apps/desktop/src/v2/harness/panels/project.tsx b/apps/desktop/src/v2/harness/panels/project.tsx
new file mode 100644
