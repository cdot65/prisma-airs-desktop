+
+def rel(path):
+    return os.path.relpath(path, ROOT)
+
+
+def labels(tree, roles, prefix):
+    roles = (roles,) if isinstance(roles, str) else roles
+    out = []
+    for n in tree:
+        label = n.get("label") or ""
+        if n.get("role") in roles and label.startswith(prefix) and label not in out:
+            out.append(label)
+    return out
+
+
+def dialog(tree, label):
+    return next((n for n in tree if (n.get("label") or "") == label and n.get("subrole") in ("AXDialog", "AXApplicationDialog")), None)
+
+
+def within(tree, node):
+    if not node:
+        return []
+    i = tree.index(node)
+    out = []
+    for m in tree[i + 1:]:
+        if m.get("depth", 0) <= node.get("depth", 0):
+            break
+        out.append(m)
+    return out
+
+
+def frame(n):
+    return (n["pos"][0], n["pos"][1], n["pos"][0] + n["size"][0], n["pos"][1] + n["size"][1]) if n and n.get("pos") and n.get("size") else None
+
+
+def contained(n, outer, slack=1):
+    a, b = frame(n), frame(outer)
+    return bool(a and b) and a[0] >= b[0] - slack and a[1] >= b[1] - slack and a[2] <= b[2] + slack and a[3] <= b[3] + slack
+
+
+def geometry(tree):
+    web = next((n for n in tree if n.get("role") == "AXWebArea" and n.get("size")), None)
+    scroll = next((n for n in tree if n.get("role") == "AXScrollArea" and n.get("size")), None)
+    win = next((n for n in tree if n.get("role") == "AXWindow"), None)
+    return {"web": [int(web["size"][0]), int(web["size"][1])] if web else None,
+            "viewport": [int(scroll["size"][0]), int(scroll["size"][1])] if scroll else None,
+            "window": win.get("size") if win else None}
+
+
+def size_window(app, pid, w, h):
+    fx.sh(["osascript", "-e", f'tell application "System Events" to tell (first application process whose unix id is {pid}) to set position of window 1 to {{0, 0}}'])
+    requested = [w, h + TITLE_BAR]
+    for _ in range(3):
+        c28.set_window_size(pid, requested[0], requested[1])
+        time.sleep(0.8)
+        g = geometry(app.tree())
+        vp = g["viewport"] or g["web"]
+        if not vp or vp[1] == h:
+            break
+        requested = [requested[0], requested[1] + (h - vp[1])]
+    return c29.window_frame(pid)
+
+
+def overflow(app):
+    tree = app.tree()
+    win = next((n for n in tree if n.get("role") == "AXWindow"), None)
+    nodes = [n for n in tree if n.get("pos") and n.get("size") and n["size"][0] > 0
+             and n.get("role") in ("AXButton", "AXStaticText", "AXTextField", "AXTextArea", "AXSearchField", "AXCheckBox", "AXPopUpButton", "AXLink", "AXHeading", "AXRadioButton")]
+    right = max(n["pos"][0] + n["size"][0] for n in nodes) if nodes and win else None
+    hbars = [n for n in tree if n.get("role") == "AXScrollBar" and (n.get("orientation") == "horizontal" or (n.get("size") and n["size"][0] > n["size"][1]))]
+    return {"overflow_px": max(0, right - (win["pos"][0] + win["size"][0])) if right is not None else None, "horizontal_scrollbars": len(hbars)}, tree
+
+
+def table_usable(tree, zoom):
+    """The cases table at this zoom: the header row, the first row's action and the footer inside the card, the
+    row's action control at least 32 CSS px."""
+    table = next((n for n in tree if n.get("role") == "AXTable" and (n.get("label") or "") == "Test Cases"), None)
+    card = next((n for n in tree if n.get("role") == "AXGroup" and n.get("pos") and n.get("size") and table and contained(table, n) and n["size"][1] > table["size"][1] - 1 and n["size"][0] >= table["size"][0] - 1), None)
+    action = next((n for n in tree if n.get("role") in BTN and (n.get("label") or "").startswith(("Open in Playground:", "Inspect:"))), None)
+    foot = next((n for n in tree if n.get("role") == "AXButton" and (n.get("label") or "") == "Next page"), None)
+    out = {"table": table is not None, "action_size": action.get("size") if action else None, "action_ok": bool(action and action["size"][0] >= 32 * zoom - 1 and action["size"][1] >= 32 * zoom - 1),
+           "foot": foot is not None, "zoom": zoom}
+    if table and action:
+        out["action_inside"] = contained(action, table) or (card is not None and contained(action, card))
+    else:
+        out["action_inside"] = False
+    # Readable regions (attempt-01 R1/E2, attempt-02 R1): the header words and one case row's four regions, bound
+    # to that row by its action's label (the case name): the name, the input, the result (the verdict button or
+    # "Not run") and the action each exist, are at least 24 CSS px wide and none overlaps another.
+    def box(n):
+        return (n["pos"][0], n["pos"][1], n["pos"][0] + n["size"][0], n["pos"][1] + n["size"][1]) if n and n.get("pos") and n.get("size") else None
+
+    def apart(a, b):
+        return not (a[0] < b[2] and b[0] < a[2] and a[1] < b[3] and b[1] < a[3])
+
+    inside = [n for n in tree if table and n.get("pos") and n.get("size") and contained(n, table)] if table else []
+    texts = [n for n in inside if n.get("role") == "AXStaticText" and (n.get("label") or n.get("value"))]
+    label_of = lambda n: (n.get("label") or n.get("value") or "")  # noqa: E731
+    headers = [next((n for n in texts if label_of(n) == h), None) for h in ("Case", "Product", "Input or specification", "Last result")]
+    case_name = (action.get("label") or "").split(": ", 1)[1] if action and ": " in (action.get("label") or "") else None
+    # The row is the AXRow holding the action; its regions are its cells in column order (name, product, input,
+    # result, action), not guessed from text lengths (the longest text was the pack's name, never the input).
+    row_node = next((n for n in tree if n.get("role") == "AXRow" and action and n.get("pos") and n.get("size") and contained(action, n)), None)
+    cells = [n for n in tree if row_node and n.get("role") == "AXCell" and n.get("pos") and n.get("size") and contained(n, row_node)]
+    out["row_cells"] = len(cells)
+    cell_texts = lambda i: [n for n in texts if len(cells) > i and contained(n, cells[i], slack=2)] if cells else []  # noqa: E731
+    name = next((n for n in cell_texts(0) if case_name and label_of(n) == case_name), None)
+    result = next((n for n in tree if len(cells) > 3 and n.get("pos") and n.get("size") and contained(n, cells[3], slack=2) and ((n.get("role") in BTN and label_of(n).endswith(f"Show the result of {case_name}")) or (n.get("role") == "AXStaticText" and label_of(n) == "Not run"))), None)
+    inputs = [n for n in cell_texts(2) if n is not result]
+    input_text = inputs[0] if inputs else None
+    regions = {"name": name, "input": input_text, "result": result, "action": action, **{f"header_{i}": h for i, h in enumerate(headers)}}
+    out["regions"] = {k: label_of(v)[:40] if v else None for k, v in regions.items()}
+    present = {k: box(v) for k, v in regions.items() if v}
+    out["regions_present"] = len(present) == len(regions)
+    out["regions_wide"] = all(b[2] - b[0] >= 24 * zoom and b[3] - b[1] >= 8 * zoom for b in present.values())
+    keys = list(present)
+    overlaps = [(a, b) for i, a in enumerate(keys) for b in keys[i + 1:] if not apart(present[a], present[b])]
+    out["overlaps"] = overlaps
+    out["readable"] = len(cells) >= 5 and out["regions_present"] and out["regions_wide"] and not overlaps
+    out["ok"] = out["table"] and out["action_ok"] and out["foot"] and out["action_inside"] and out["readable"]
+    return out
+
