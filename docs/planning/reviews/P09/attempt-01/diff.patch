+    obs["n2"] = n2
+
+    # ---- N03: the staged rotation ----
+    n3 = {}
+    press_tab(app, "API keys")
+    app.wait_for(lambda t: fx.App.node(t, "AXButton", "Details for Runtime") is not None, 12)
