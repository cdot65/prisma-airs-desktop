+    ));
+    nonsecret["airs_cleanup_path"] = json!("/aisec/v1/mgmt/topic/{created_id}");
+    nonsecret["airs_created_id_field"] = json!("topic_id");
+    nonsecret["airs_created_name_field"] = json!("topic_name");
+    value
+}
