+}
+
+#[tokio::test]
+async fn the_catalogue_is_v2_whatever_variant_is_asked_for_and_survives_a_restart() {
+    // C44: `setUiVariant` is accepted and changes nothing (older presentations and drivers still send it).
+    let mut desk = Desk::new();
