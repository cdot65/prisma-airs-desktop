+                        {failure}
+                    </p>
+                ) : null}
+                {tool === 'environments' ? (
+                    <Environments collection={collection} run={run} />
+                ) : tool === 'secrets' ? (
+                    <Secrets collection={collection} run={run} />
+                ) : tool === 'schemas' ? (
+                    <Schemas collection={collection} run={run} />
+                ) : tool === 'import' ? (
+                    <Import state={state} run={run} importCurl={importCurl} onCreated={onCreated} />
