+                ) : empty ? (
+                    <div className='text-center text-[13px]' style={{ padding: '24px 18px', borderTop: '1px solid var(--v2-rule)', color: 'var(--v2-faint)' }} data-slot='administration-empty'>
+                        {C.table.empty(info.label)}
+                    </div>
