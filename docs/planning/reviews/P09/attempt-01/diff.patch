+/// An 8×8 PNG: the synthetic avatar (re-encoded by the core before upload).
+const AVATAR_PNG: &[u8] = &[
+    0x89, 0x50, 0x4E, 0x47, 0x0D, 0x0A, 0x1A, 0x0A, 0x00, 0x00, 0x00, 0x0D, 0x49, 0x48, 0x44, 0x52,
+    0x00, 0x00, 0x00, 0x08, 0x00, 0x00, 0x00, 0x08, 0x08, 0x02, 0x00, 0x00, 0x00, 0x4B, 0x6D, 0x29,
+    0xDC, 0x00, 0x00, 0x00, 0x11, 0x49, 0x44, 0x41, 0x54, 0x78, 0xDA, 0x63, 0xD0, 0xCE, 0xD9, 0x80,
+    0x15, 0x31, 0x0C, 0x2D, 0x09, 0x00, 0xD0, 0x59, 0x51, 0xC1, 0x19, 0x34, 0xF9, 0xFA, 0x00, 0x00,
+    0x00, 0x00, 0x49, 0x45, 0x4E, 0x44, 0xAE, 0x42, 0x60, 0x82,
+];
+
+pub(crate) struct Shared {
+    pub families: Vec<(String, Outcomes)>,
+    pub stop: Option<Stop>,
+}
+
+struct Ctx<'r, 'a> {
+    run: &'r mut Run<'a>,
+    outcomes: BTreeMap<String, Outcomes>,
+    stop: Option<Stop>,
+}
+
+impl Ctx<'_, '_> {
+    fn settle(
+        &mut self,
+        family: &str,
+        spec: Spec,
+        started: String,
+        inputs: BTreeMap<String, Value>,
+        found: Found,
+    ) -> Result<()> {
+        let outcomes = self.outcomes.entry(family.to_owned()).or_default();
+        let stop = self
+            .run
+            .settle(family, spec, started, inputs, found, None, outcomes)?;
+        if self.stop.is_none()
+            || (stop.as_ref().is_some_and(|s| s.reconcile)
+                && self.stop.as_ref().is_some_and(|s| !s.reconcile))
+        {
+            self.stop = stop;
+        }
+        Ok(())
+    }
+
+    fn block(&mut self, family: &str, spec: Spec, reason: &str) -> Result<()> {
+        self.settle(
+            family,
+            spec,
+            now_utc(),
+            BTreeMap::new(),
+            Found::blocked(reason),
+        )
+    }
+}
+
+fn state(j: &Value) -> String {
+    j["academy"]["state"].as_str().unwrap_or("").to_owned()
+}
+
+fn account_hash(j: &Value) -> Option<String> {
+    j["academy"]["accountId"].as_str().map(|a| {
+        let digest = Sha256::digest(a.as_bytes());
+        hex::encode(digest)
+    })
+}
+
+fn learner(j: &Value) -> Value {
+    j["learner"].clone()
+}
+
+fn public_inputs(run: &Run<'_>, family: &str) -> BTreeMap<String, Value> {
+    let mut inputs = run.inputs(family, &[]);
+    // Per-call receipts record redacted templates and assertion summaries.
+    // An authentication receipt must not serialize the raw program again.
+    inputs.retain(|name, _| !name.starts_with("call."));
+    inputs
+}
+
+/// Starts the device sign-in and waits for the operator to approve it.
+async fn sign_in(run: &Run<'_>, desk: &mut Desk, family: &str) -> Result<(Found, Option<String>)> {
+    desk.send_json(json!({"kind": "startAcademySignIn"}))
+        .await?;
+    let awaiting = desk
+        .until(desk.settle, |j| {
+            matches!(state(j).as_str(), "awaitingApproval" | "failed")
+        })
+        .await;
+    match awaiting {
+        Some(j) if state(&j) == "awaitingApproval" => {}
+        Some(j) => {
+            return Ok((
+                Found::failed("the sign-in could not start")
+                    .with("academy", j["academy"]["failure"].clone()),
+                None,
+            ));
+        }
+        None => return Ok((Found::failed("the sign-in did not start in time"), None)),
+    }
+    // The core opens the verification page through the host; the operator
+    // completes it there.
+    desk.send_json(json!({"kind": "openAcademyVerification"}))
+        .await?;
+    let bound = run.operator_timeout(family);
+    let (completed, step) = {
+        let desk = &*desk;
+        operator_step(
+            run.operator.as_ref(),
+            "academy-device-sign-in",
+            "approve the Academy device sign-in with the designated test learner",
+            None,
+            bound,
+            // A failed sign-in ends the wait; the core's state judges it.
+            async || {
+                desk.json()
+                    .map(|j| matches!(state(&j).as_str(), "signedIn" | "failed"))
+                    .unwrap_or(false)
+            },
+        )
+        .await
+    };
+    let j = desk.json()?;
+    let signed_in = completed && state(&j) == "signedIn";
+    let mut found = Found::check(
+        signed_in,
+        "the operator approved the device sign-in and the core shows the learner signed in",
+        if completed {
+            "the device sign-in failed"
+        } else {
+            "the device sign-in was not completed within the bound"
+        },
+    )
+    .with("state", json!(state(&j)))
+    .with("failure", j["academy"]["failure"].clone())
+    .with("vault", j["academy"]["vault"].clone());
+    found.operator_step = Some(step);
+    let hash = account_hash(&j);
+    if let Some(h) = &hash {
+        found = found
+            .with("account_sha256", json!(h))
+            .with("account_sha256_prefix", json!(&h[..16]));
+    }
+    Ok((found, hash))
+}
+
+/// One designated learner call: its label, procedure, kind and input.
+struct Call {
+    label: String,
+    /// The workflows this call is evidence for, as its entry names them.
+    workflows: &'static [&'static str],
+    procedure: String,
+    kind: ProcedureKind,
+    input: Option<String>,
+    /// What the hosted answer must hold, beyond answering with data.
+    expect: Vec<Expect>,
+}
+
+/// Parses the family's `call.*` entries, each `<workflows> <procedure>
+/// [<input>] ?? <expectation> [ && <expectation>]`: the workflow IDs (comma-separated, among those the family may
+/// claim) the call is evidence for, the procedure, and its input. A call
+/// counts only for the workflows it names.
+fn program(run: &Run<'_>, family: &str) -> std::result::Result<Vec<Call>, String> {
+    let Ok(f) = run.family(family) else {
+        return Ok(Vec::new());
+    };
+    let allowed = claimable(family);
+    let mut calls = Vec::new();
+    let mut earlier = BTreeSet::new();
+    let mut receipt_labels = BTreeSet::new();
+    for (key, value) in &f.nonsecret {
+        let Some(label) = key.strip_prefix("call.") else {
+            continue;
+        };
+        // Labels become receipt filenames. Keep them single, bounded path
+        // components rather than letting manifest data select a write path.
+        if label.is_empty()
+            || label.len() > 96
+            || !label
+                .bytes()
+                .all(|c| c.is_ascii_alphanumeric() || matches!(c, b'-' | b'_'))
+        {
+            return Err(
+                "a call label must be 1-96 ASCII letters, digits, hyphens or underscores"
+                    .to_owned(),
+            );
+        }
+        if !receipt_labels.insert(label.to_ascii_lowercase()) {
+            return Err("call labels must be unique ignoring case on macOS filesystems".to_owned());
+        }
+        let (value, expect) = match value.split_once(" ?? ") {
+            Some((v, e)) => (v, e),
+            None => (value.as_str(), ""),
+        };
+        let expect = expect
+            .split(" && ")
+            .filter(|e| !e.trim().is_empty())
+            .map(|text| Expect::parse(text, &earlier))
+            .collect::<std::result::Result<Vec<_>, _>>()
+            .map_err(|e| format!("{key}: {e}"))?;
+        let (tags, rest) = value
+            .split_once(' ')
+            .ok_or_else(|| format!("{key} names no workflow and procedure"))?;
+        let mut workflows = Vec::new();
+        for tag in tags.split(',').filter(|_| tags != "observe") {
+            let w = allowed
+                .iter()
+                .find(|w| **w == tag)
+                .ok_or_else(|| format!("{key}: {tag} is not a workflow {family} may claim"))?;
+            workflows.push(*w);
+        }
+        let (procedure, input) = match rest.trim().split_once(' ') {
+            Some((p, i)) => (p.to_owned(), Some(i.trim().to_owned())),
+            None => (rest.trim().to_owned(), None),
+        };
+        let kind = LEARNER_PROCEDURES
+            .iter()
+            .find(|(p, _)| *p == procedure)
+            .map(|(_, k)| *k)
+            .ok_or_else(|| format!("{procedure} is not a learner procedure"))?;
+        if tags == "observe" && kind == ProcedureKind::Mutation {
+            return Err(format!(
+                "{key}: observe is read-only and grants no workflow credit"
+            ));
+        }
+        if kind == ProcedureKind::Mutation && !f.permitted_operations.contains(&procedure) {
+            return Err(format!(
+                "{procedure} changes learner state but is not a permitted operation of {family}"
+            ));
+        }
+        if kind == ProcedureKind::Mutation && !account_designated(run, family) {
+            return Err(format!(
+                "{key}: a mutation requires expected_account_sha256 for the designated test learner"
+            ));
+        }
+        if expect.is_empty() {
+            return Err(format!("{key}: an explicit result expectation is required"));
+        }
+        if procedure == "progress.checkInline" && !expect.iter().any(Expect::is_grading_verdict) {
+            return Err(format!(
+                "{key}: inline grading requires /correct=true or /correct=false, not only a boolean shape"
+            ));
+        }
+        if let Some(input) = &input {
+            let value = serde_json::from_str::<Value>(input)
+                .map_err(|_| format!("{key}: the input is not JSON"))?;
+            validate_input(&value, &earlier).map_err(|e| format!("{key}: {e}"))?;
+        }
+        earlier.insert(label.to_owned());
+        calls.push(Call {
+            label: label.to_owned(),
+            workflows: Box::leak(workflows.into_boxed_slice()),
+            procedure,
+            kind,
+            input,
+            expect,
+        });
+    }
+    contracts::validate(&calls)?;
+    Ok(calls)
+}
+
+/// A successful read is useful evidence, but cannot close an interactive row.
+/// These checkpoints describe ordered minimums, not a substitute for each
+/// call's designated result assertions or the broader native acceptance.
+fn workflow_steps(workflow: &str) -> &'static [&'static str] {
+    match workflow {
+        "W53" => &["exam.start", "exam.submissionState", "certificate.mine"],
+        "W65" => &[
+            "shift.start",
+            "shift.serve",
+            "shift.answer",
+            "shift.decide",
+            "shift.debrief",
+        ],
+        "W66" => &[
+            "certificate.mine",
+            "progress.courseSummary",
+            "progress.resetCourse",
+            "progress.courseSummary",
+            "certificate.mine",
+        ],
+        _ => &[],
+    }
+}
+
+fn account_designated(run: &Run<'_>, family: &str) -> bool {
+    run.nonsecret(family, "expected_account_sha256")
+        .is_some_and(|h| {
+            h.len() == 64
+                && h.bytes()
+                    .all(|b| b.is_ascii_digit() || (b'a'..=b'f').contains(&b))
+        })
+}
+
+fn result_found(result: &Value) -> Found {
+    let kind = result["kind"].as_str().unwrap_or("");
+    Found::check(
+        kind == "data",
+        "the hosted procedure answered",
+        "the hosted procedure did not answer with data",
+    )
+    .with("result", json!(kind))
+    .with("http_status", result["httpStatus"].clone())
+    .with("failure", result["failure"].clone())
+    .with("outcome", result["outcome"].clone())
+}
+
+fn mutation_found(result: &Value) -> Found {
+    let mut found = result_found(result);
+    if result["outcome"] == "unknown" {
+        found.cleanup = "the learner mutation may have applied; inspect its remote state before any explicit retry".to_owned();
+        found = found.stopping(
+            "a learner mutation may or may not have taken effect; reconciliation required",
+            true,
+        );
+    }
+    found
+}
+
+fn unsettled_call(kind: ProcedureKind, daily_unsettled: bool) -> Found {
+    let reconcile = kind == ProcedureKind::Mutation || daily_unsettled;
+    let mut found =
+        Found::failed("the learner call could not be observed or did not settle within its bound")
+            .stopping("the learner call did not settle", reconcile);
+    if reconcile {
+        found.cleanup = "a dispatched mutation or unfinished Daily run may remain; inspect remote state before retrying".to_owned();
+    }
+    found
+}
+
+async fn call(
+    desk: &mut Desk,
+    procedure: &str,
+    kind: ProcedureKind,
+    input: Option<&str>,
+) -> Result<Value> {
+    let learner = learner(&desk.json()?);
+    desk.academy(
+        json!({"kind": "academyCall", "learner": learner, "procedure": procedure,
+        "procedureKind": if kind == ProcedureKind::Mutation { "mutation" } else { "query" },
+        "input": input}),
+    )
+    .await
+}
+
+fn leak(name: String) -> &'static str {
+    Box::leak(name.into_boxed_str())
+}
+
+async fn avatar_change(desk: &mut Desk) -> Found {
+    let learner = match desk.json() {
+        Ok(snapshot) => learner(&snapshot),
+        Err(_) => {
+            return Found::failed("the learner could not be read before avatar upload")
+                .stopping("avatar upload was not dispatched", false);
+        }
+    };
+    let uploaded = match desk
+        .academy(json!({"kind":"uploadAvatar","learner":learner}))
+        .await
+    {
+        Ok(result) => result,
+        Err(_) => return unsettled_call(ProcedureKind::Mutation, false),
+    };
+    let found = mutation_found(&uploaded);
+    if found.outcome != "passed" {
+        // An uncertain upload must not be followed by another mutation.
+        return found;
+    }
+    let removed = match call(desk, "settings.removeAvatar", ProcedureKind::Mutation, None).await {
+        Ok(result) => result,
+        Err(_) => return unsettled_call(ProcedureKind::Mutation, false),
+    };
+    let mut found = mutation_found(&removed)
+        .with("upload", uploaded["kind"].clone())
+        .with("remove", removed["kind"].clone());
+    if found.outcome == "passed" {
+        found.detail =
+            "a synthetic avatar was bounded, re-encoded and uploaded, then removed".to_owned();
+        found.cleanup = "removed with settings.removeAvatar".to_owned();
+    } else {
+        found.cleanup = "avatar upload was confirmed but removal was not; inspect the test account before retrying".to_owned();
+        found = found.stopping(
+            "avatar cleanup was not confirmed; reconciliation required",
+            true,
+        );
+    }
+    found
+}
+
+pub(crate) async fn run(run: &mut Run<'_>, families: &[String]) -> Result<Shared> {
+    let mut ctx = Ctx {
+        run,
+        outcomes: BTreeMap::new(),
+        stop: None,
+    };
+    let wants = |f: &str| families.iter().any(|x| x == f);
+    let origin = FAMILIES
+        .iter()
+        .filter(|f| wants(f))
+        .find_map(|f| ctx.run.nonsecret(f, "academy_origin"));
+    let lead = FAMILIES.iter().copied().find(|f| wants(f)).unwrap_or("L11");
+    let offline = if wants("L14") {
+        Some(ctx.run.folder("offline")?)
+    } else {
+        None
+    };
+    let mut desk = ctx.run.desk(DeskOptions {
+        offline_root: offline,
+        academy_origin: origin.filter(|o| o.starts_with("https://")),
+        image: wants("L13").then(|| AVATAR_PNG.to_vec()),
+        ..DeskOptions::default()
+    })?;
+
+    let started = now_utc();
+    let (found, account) = sign_in(ctx.run, &mut desk, lead).await?;
+    let signed_in = found.outcome == "passed";
+    let sign_in_family = if wants("L11") { "L11" } else { lead };
+    ctx.settle(
+        sign_in_family,
+        SIGN_IN,
+        started,
+        public_inputs(ctx.run, sign_in_family),
+        found,
+    )?;
+    if !signed_in {
+        for family in families {
+            let spec = Spec {
+                id: leak(format!("{family}-after-sign-in")),
+                workflows: &[],
+            };
+            ctx.block(family, spec, "the learner was not signed in")?;
+        }
+        return Ok(finish(ctx, families));
+    }
+
+    // A browser can silently approve as its existing account. A designated
+    // identity must therefore be checked against the core's signed-in identity,
+    // before any learner program or optional avatar mutation is dispatched.
+    for family in families {
+        if let Some(expected) = ctx.run.nonsecret(family, "expected_account_sha256")
+            && (!account_designated(ctx.run, family) || account.as_deref() != Some(&expected))
+        {
+            let found = Found::blocked(
+                "the signed-in Academy account does not match the designated learner",
+            )
+            .stopping(
+                "unexpected Academy account; no learner program was sent",
+                false,
+            );
+            ctx.settle(
+                family,
+                Spec {
+                    id: leak(format!("{family}-account-binding")),
+                    workflows: &[],
+                },
+                now_utc(),
+                BTreeMap::new(),
+                found,
+            )?;
+            desk.send_json(json!({"kind":"signOutAcademy"})).await?;
+            return Ok(finish(ctx, families));
+        }
+    }
+
+    if wants("L11") {
+        let started = now_utc();
+        let me = call(&mut desk, "desktop.me", ProcedureKind::Query, None).await?;
+        // Academy's access check takes the courses to check (the designated
+        // course, when there is one).
+        let courses: Vec<String> = ctx.run.nonsecret("L14", "course_id").into_iter().collect();
+        let input = json!({"json": {"courseIds": courses}}).to_string();
+        let access = call(
+            &mut desk,
+            "desktop.access",
+            ProcedureKind::Query,
+            Some(&input),
+        )
+        .await?;
+        let found = Found::check(
+            me["kind"] == "data" && access["kind"] == "data",
+            "protected learner procedures were admitted with the signed-in learner's token",
+            "a protected learner procedure was not admitted",
+        )
+        .with("desktop.me", me["kind"].clone())
+        .with("desktop.access", access["kind"].clone());
+        ctx.settle(
+            "L11",
+            ADMISSION,
+            started,
+            public_inputs(ctx.run, "L11"),
+            found,
+        )?;
+    }
+
+    for family in ["L12", "L13", "L14"] {
+        if !wants(family) || ctx.stop.is_some() {
+            continue;
+        }
+        match program(ctx.run, family) {
+            Err(e) => {
+                let spec = Spec {
+                    id: leak(format!("{family}-calls")),
+                    workflows: &[],
+                };
+                ctx.block(family, spec, &e)?;
+            }
+            Ok(calls) => {
+                if calls.is_empty() && family != "L14" {
+                    let spec = Spec {
+                        id: leak(format!("{family}-calls")),
+                        workflows: &[],
+                    };
+                    ctx.block(
+                        family,
+                        spec,
+                        &format!("{family} designates no call.* procedures"),
+                    )?;
+                }
+                let mut answers: BTreeMap<String, Value> = BTreeMap::new();
+                let mut failed_workflows = BTreeSet::new();
+                let mut daily_unsettled = false;
+                let mut planned: BTreeMap<&str, usize> = BTreeMap::new();
+                for workflow in calls
+                    .iter()
+                    .flat_map(|c| c.workflows.iter().copied())
+                    .filter(|w| !workflow_steps(w).is_empty())
+                {
+                    *planned.entry(workflow).or_default() += 1;
+                }
+                let mut coverage: BTreeMap<&str, Vec<String>> =
+                    planned.keys().map(|w| (*w, Vec::new())).collect();
+                for designated in calls {
+                    let cleanup = contracts::cleanup(&designated);
+                    let Call {
+                        label,
+                        workflows,
+                        procedure,
+                        kind,
+                        input,
+                        expect,
+                    } = designated;
+                    if ctx.stop.is_some() {
+                        break;
+                    }
+                    let spec = Spec {
+                        id: leak(format!("{family}-call-{label}")),
+                        workflows,
+                    };
+                    let started = now_utc();
+                    let mut inputs = BTreeMap::new();
+                    inputs.insert("procedure".to_owned(), json!(procedure));
+                    // Record the designated template, never values copied out of
+                    // a protected hosted answer into the outgoing request.
+                    inputs.insert("input".to_owned(), receipt_input(&input));
+                    if kind == ProcedureKind::Mutation
+                        && !cleanup
+                        && workflows.iter().any(|w| failed_workflows.contains(w))
+                    {
+                        failed_workflows.extend(workflows.iter().copied());
+                        ctx.settle(
+                            family,
+                            spec,
+                            started,
+                            inputs,
+                            Found::blocked(
+                                "an earlier checkpoint of this workflow failed; mutation not sent",
+                            ),
+                        )?;
+                        continue;
+                    }
+                    let resolved = input
+                        .as_deref()
+                        .map(|text| {
+                            let value = serde_json::from_str(text).expect("program validated JSON");
+                            resolve_input(value, &answers).map(|value| value.to_string())
+                        })
+                        .transpose();
+                    let input = match resolved {
+                        Ok(input) if expect.iter().all(|e| e.ready(&answers)) => input,
+                        _ => {
+                            failed_workflows.extend(workflows.iter().copied());
+                            let mut found = Found::blocked(
+                                "an earlier validated result is unavailable; call not sent",
+                            );
+                            if cleanup && daily_unsettled {
+                                found.cleanup = "hand-off dependency unavailable; the spent Daily run needs reconciliation or the server stale sweep".to_owned();
+                                found = found.stopping("Daily hand-off could not be dispatched; reconcile the active run", true);
+                            }
+                            ctx.settle(family, spec, started, inputs, found)?;
+                            if ctx.stop.is_some() {
+                                break;
+                            }
+                            continue;
+                        }
+                    };
+                    // Charged before it is sent: an exhausted budget sends nothing.
+                    if let Err(e) = ctx.run.guard.spend(family, "calls", 1) {
+                        failed_workflows.extend(workflows.iter().copied());
+                        let mut found = Found::blocked(e.clone())
+                            .stopping(format!("unexpected cost: {e}"), daily_unsettled);
+                        if daily_unsettled {
+                            found.cleanup = "budget exhausted after Daily start; no extra call was sent; reconcile the active run or allow Academy's stale sweep".to_owned();
+                        }
+                        ctx.settle(family, spec, started, inputs, found)?;
+                        break;
+                    }
+                    let result = match call(&mut desk, &procedure, kind, input.as_deref()).await {
+                        Ok(result) => result,
+                        Err(_error) => {
+                            failed_workflows.extend(workflows.iter().copied());
+                            let found = unsettled_call(kind, daily_unsettled);
+                            ctx.settle(family, spec, started, inputs, found)?;
+                            break;
+                        }
+                    };
+                    if procedure == "shift.start"
+                        && (result["kind"] == "data" || result["outcome"] == "unknown")
+                    {
+                        // Track the effect even when its answer fails assertions
+                        // and cannot be used as a dependency for later calls.
+                        daily_unsettled = true;
+                    }
+                    let mut found = if kind == ProcedureKind::Mutation {
+                        mutation_found(&result)
+                    } else {
+                        result_found(&result)
+                    };
+                    if found.outcome == "passed" {
+                        if let Some(got) = answer(&result) {
+                            let observed: Vec<Value> =
+                                expect.iter().map(|e| e.observe(&got, &answers)).collect();
+                            let passed = observed.iter().all(|o| o["passed"] == true);
+                            found = Found::check(
+                                passed,
+                                "the hosted procedure answered and its result held",
+                                "the hosted answer did not hold its designated expectations",
+                            )
+                            .with("assertions", json!(observed));
+                            if passed {
+                                answers.insert(label.clone(), got);
+                                for workflow in workflows {
+                                    if let Some(steps) = coverage.get_mut(workflow) {
+                                        steps.push(procedure.clone());
+                                    }
+                                }
+                            }
+                        } else {
+                            found = Found::failed(
+                                "the hosted data response has no valid SuperJSON answer",
+                            );
+                        }
+                    }
+                    if kind == ProcedureKind::Mutation && found.stop.is_none() {
+                        found.cleanup =
+                            "synthetic coursework on a test account (owner-designated)".to_owned();
+                    }
+                    if found.outcome != "passed" {
+                        failed_workflows.extend(workflows.iter().copied());
+                    }
+                    if cleanup {
+                        if found.outcome == "passed" {
+                            daily_unsettled = false;
+                            found.cleanup =
+                                "the same Daily run was handed off at a completed stage boundary"
+                                    .to_owned();
+                        } else {
+                            found.cleanup = "hand-off was not confirmed; the spent Daily run may remain active until Academy's stale sweep; reconciliation required".to_owned();
+                            found = found.stopping(
+                                "Daily hand-off was not confirmed; reconcile the active run",
+                                true,
+                            );
+                        }
+                    }
+                    ctx.settle(family, spec, started, inputs, found)?;
+                }
+                if daily_unsettled && !ctx.stop.as_ref().is_some_and(|s| s.reconcile) {
+                    let mut found = Found::failed(
+                        "a Daily run started or may have started without a confirmed hand-off",
+                    )
+                    .stopping("unsettled Daily run; reconciliation required", true);
+                    found.cleanup = "no additional calls were sent; inspect the active test-learner run or allow Academy's stale sweep".to_owned();
+                    ctx.settle(
+                        family,
+                        Spec {
+                            id: leak(format!("{family}-daily-reconciliation")),
+                            workflows: &["W65"],
+                        },
+                        now_utc(),
+                        BTreeMap::new(),
+                        found,
+                    )?;
+                }
+                for (workflow, completed) in coverage {
+                    let required = workflow_steps(workflow);
+                    let mut remaining = required.iter();
+                    let mut next = remaining.next();
+                    for procedure in &completed {
+                        if next.is_some_and(|n| *n == procedure) {
+                            next = remaining.next();
+                        }
+                    }
+                    let found = Found::check(next.is_none() && !failed_workflows.contains(workflow)
+                        && completed.len() == planned[workflow],
+                        "the interactive workflow's ordered checkpoints passed their result assertions",
+                        "the interactive workflow is incomplete; successful reads do not close it")
+                        .with("required_procedures", json!(required))
+                        .with("planned_calls",json!(planned[workflow]))
+                        .with("validated_calls",json!(completed.len()))
+                        .with("validated_procedures", json!(completed));
+                    ctx.settle(
+                        family,
+                        Spec {
+                            id: leak(format!("{family}-workflow-{workflow}")),
+                            workflows: Box::leak(vec![workflow].into_boxed_slice()),
+                        },
+                        now_utc(),
+                        BTreeMap::new(),
+                        found,
+                    )?;
+                }
+            }
+        }
+    }
+
+    if wants("L13") && ctx.stop.is_none() {
+        let started = now_utc();
+        let permitted = ctx
+            .run
+            .family("L13")
+            .map(|f| {
+                f.permitted_operations
+                    .iter()
+                    .any(|o| o == "settings.removeAvatar")
+            })
+            .unwrap_or(false);
+        let found = if !account_designated(ctx.run, "L13") {
+            Found::blocked(
+                "an avatar mutation requires expected_account_sha256 for the designated test learner",
+            )
+        } else if !permitted {
+            Found::blocked(
+                "an avatar upload needs settings.removeAvatar among L13's permitted operations, to undo it",
+            )
+        } else if let Err(e) = ctx.run.guard.spend("L13", "calls", 2) {
+            // The upload and its removal, charged before either is sent.
+            Found::blocked(e.clone()).stopping(format!("unexpected cost: {e}"), false)
+        } else {
+            avatar_change(&mut desk).await
+        };
+        ctx.settle("L13", AVATAR, started, BTreeMap::new(), found)?;
+    }
+
+    if wants("L14") && ctx.stop.is_none() {
+        l14(&mut ctx, &mut desk).await?;
+    }
+
+    if wants("L11") && ctx.stop.is_none() {
+        let started = now_utc();
+        let before = learner(&desk.json()?);
+        desk.send_json(json!({"kind": "signOutAcademy"})).await?;
+        let out = desk
+            .until(desk.settle, |j| state(j) == "signedOut")
+            .await
+            .is_some();
+        // The retired learner reference is refused by the core afterwards.
+        let refused = desk
+            .send_json(
+                json!({"kind": "academyCall", "learner": before, "procedure": "desktop.me",
+                "procedureKind": "query", "input": null}),
+            )
+            .await
+            .is_err();
+        let found = Found::check(
+            out && refused,
+            "signed out: the session was deleted, its refresh token revoked, and the old learner is refused",
+            "sign-out did not retire the learner",
+        );
+        ctx.settle("L11", SIGN_OUT, started, BTreeMap::new(), found)?;
+
+        let started = now_utc();
+        let found = if ctx.run.nonsecret("L11", "second_account").as_deref() == Some("designated") {
+            let (found, second) = sign_in(ctx.run, &mut desk, "L11").await?;
+            let switched = found.outcome == "passed" && second.is_some() && second != account;
+            let mut found = Found {
+                outcome: if switched { "passed" } else { "failed" },
+                detail: if switched {
+                    "a second test learner signed in; the account changed and nothing of the first carried over".to_owned()
+                } else {
+                    "the second sign-in did not show a different account".to_owned()
+                },
+                ..found
+            };
+            desk.send_json(json!({"kind": "signOutAcademy"})).await?;
+            found.cleanup = "signed out again".to_owned();
+            found
+        } else {
+            Found::blocked("L11 designates no second_account for the account switch")
+        };
+        ctx.settle("L11", SWITCH, started, BTreeMap::new(), found)?;
+    } else if ctx.stop.is_none() {
+        desk.send_json(json!({"kind": "signOutAcademy"})).await?;
+    }
+    Ok(finish(ctx, families))
+}
+
+async fn l14(ctx: &mut Ctx<'_, '_>, desk: &mut Desk) -> Result<()> {
+    let Some(course) = ctx.run.nonsecret("L14", "course_id") else {
+        for spec in [DOWNLOAD, DRAFT, DENIAL] {
+            ctx.block("L14", spec, "L14 designates no course_id")?;
+        }
+        return Ok(());
+    };
+    let started = now_utc();
+    let learner_ref = learner(&desk.json()?);
+    let downloaded = desk
+        .academy(json!({"kind": "downloadCourse", "learner": learner_ref, "courseId": course}))
+        .await?;
+    let mut found = result_found(&downloaded);
+    found.detail = if found.outcome == "passed" {
+        "the client-safe course was downloaded under its lease and sealed for this account"
+            .to_owned()
+    } else {
+        "the course could not be downloaded".to_owned()
+    };
+    found.cleanup = "removed at the end of the family".to_owned();
+    let mut inputs = BTreeMap::new();
+    inputs.insert("course_id".to_owned(), json!(course));
+    ctx.settle("L14", DOWNLOAD, started, inputs.clone(), found)?;
+
+    let started = now_utc();
+    let found = match ctx.run.nonsecret("L14", "attempt_id") {
+        None => Found::blocked("L14 designates no attempt_id"),
+        Some(attempt) => {
+            let base: u32 = ctx
+                .run
+                .nonsecret("L14", "base_version")
+                .and_then(|b| b.parse().ok())
+                .unwrap_or(0);
+            let draft = "C25 synthetic local draft";
+            // Lab work is a JSON object, as the learner page keeps it.
+            let saved = desk
+                .academy(
+                    json!({"kind": "saveLocalDraft", "learner": learner_ref, "attemptId": attempt,
+                    "baseVersion": base, "draft": json!({"c25": draft}).to_string()}),
+                )
+                .await?;
+            let loaded = desk
+                .academy(
+                    json!({"kind": "loadLocalDraft", "learner": learner_ref, "attemptId": attempt}),
+                )
+                .await?;
+            let kept = loaded["data"].as_str().is_some_and(|d| d.contains(draft));
+            let _ = desk
+                .academy(json!({"kind": "clearLocalDraft", "learner": learner_ref, "attemptId": attempt}))
+                .await;
+            let mut found = Found::check(
+                saved["kind"] == "data" && kept,
+                "the draft was sealed locally for this account and read back; nothing was submitted",
+                "the local draft was not kept",
+            )
+            .with("save", json!({"kind": saved["kind"], "failure": saved["failure"]}))
+            .with("load", json!({"kind": loaded["kind"], "failure": loaded["failure"]}));
+            found.cleanup = "cleared from this Mac".to_owned();
+            found
+        }
+    };
+    ctx.settle("L14", DRAFT, started, inputs.clone(), found)?;
+
+    // The operator changes the account's access; the core must then refuse.
+    let started = now_utc();
+    let found = if ctx.run.nonsecret("L14", "access_change").as_deref() != Some("designated") {
+        Found::blocked("L14 designates no access_change the operator can make")
+    } else {
+        let bound = ctx.run.operator_timeout("L14");
+        let course = course.clone();
+        let denied = {
+            let desk_ref = &mut *desk;
+            let learner = learner_ref.clone();
+            let mut last = Value::Null;
+            let (done, step) = operator_step(
+                ctx.run.operator.as_ref(),
+                "academy-access-change",
+                "remove the designated test learner's access to the designated course now",
+                None,
+                bound,
+                async || {
+                    tokio::time::sleep(std::time::Duration::from_secs(1)).await;
+                    match desk_ref
+                        .academy(json!({"kind": "downloadCourse", "learner": learner, "courseId": course}))
+                        .await
+                    {
+                        Ok(r) => {
+                            // Academy withdrew the course (no longer
+                            // downloadable) or refused the learner.
+                            let refused = (r["kind"] == "failed"
+                                && r["failure"] == "notDownloadable")
+                                || (r["kind"] == "error"
+                                    && matches!(r["httpStatus"].as_u64(), Some(401 | 403 | 404)));
+                            last = r;
+                            refused
+                        }
+                        Err(_) => false,
+                    }
+                },
+            )
+            .await;
+            (done, step, last)
+        };
+        let (done, step, last) = denied;
+        let mut found = Found::check(
+            done,
+            "after the operator's access change, Academy refused the course and nothing stale was served",
+            "Academy kept serving the course after the access change",
+        )
+        .with("last", json!({"kind": last["kind"], "failure": last["failure"], "http_status": last["httpStatus"]}));
+        found.operator_step = Some(step);
+        found
+    };
+    ctx.settle("L14", DENIAL, started, inputs, found)?;
+    let _ = desk
+        .academy(json!({"kind": "removeDownload", "learner": learner_ref, "courseId": course}))
+        .await;
+    Ok(())
+}
+
+fn finish(ctx: Ctx<'_, '_>, families: &[String]) -> Shared {
+    let Ctx {
+        mut outcomes, stop, ..
+    } = ctx;
+    Shared {
+        families: families
+            .iter()
+            .map(|f| (f.clone(), outcomes.remove(f).unwrap_or_default()))
+            .collect(),
+        stop,
+    }
+}
diff --git a/crates/xtask/src/live_academy/assertions.rs b/crates/xtask/src/live_academy/assertions.rs
new file mode 100644
index 00000000..7f214b6f
--- /dev/null
+++ b/crates/xtask/src/live_academy/assertions.rs
@@ -0,0 +1,411 @@
+//! Assertions and data dependencies for an operator-designated Academy program.
+//! Hosted values stay in memory; receipts expose scalar verdicts or fingerprints.
+
+use std::collections::{BTreeMap, BTreeSet};
+
+use serde_json::{Value, json};
+
+#[derive(Debug)]
+pub(super) enum Expect {
+    Kind(String, String),
+    Equals(String, Value),
+    Same(String, String, String),
+    OneOf(String, Vec<Value>),
+}
+
+fn pointer_valid(pointer: &str) -> bool {
+    if !pointer.is_empty() && !pointer.starts_with('/') {
+        return false;
+    }
+    let mut chars = pointer.chars();
+    while let Some(c) = chars.next() {
+        if c == '~' && !matches!(chars.next(), Some('0' | '1')) {
+            return false;
+        }
+    }
+    true
+}
+
+fn reference_valid(label: &str, pointer: &str, earlier: &BTreeSet<String>) -> Result<(), String> {
+    if !earlier.contains(label) {
+        return Err("a reference must name an earlier call in the same family".to_owned());
+    }
+    if !pointer_valid(pointer) {
+        return Err("invalid JSON pointer in call reference".to_owned());
+    }
+    Ok(())
+}
+
+impl Expect {
+    pub fn parse(text: &str, earlier: &BTreeSet<String>) -> Result<Self, String> {
+        let text = text.trim();
+        let assertion = if let Some((ptr, rest)) = text.split_once(" in ") {
+            let values: Vec<Value> = serde_json::from_str(rest)
+                .map_err(|_| "membership expects a nonempty JSON array".to_owned())?;
+            if values.is_empty() || values.iter().any(|v| !v.is_string()) {
+                return Err("membership expects a nonempty array of strings".to_owned());
+            }
+            Self::OneOf(ptr.to_owned(), values)
+        } else if let Some((ptr, rest)) = text.split_once('=') {
+            if let Some(other) = rest.strip_prefix('@') {
+                let (label, ptr2) = other
+                    .find('/')
+                    .map_or((other, ""), |i| (&other[..i], &other[i..]));
+                reference_valid(label, ptr2, earlier)?;
+                Self::Same(ptr.to_owned(), label.to_owned(), ptr2.to_owned())
+            } else {
+                Self::Equals(
+                    ptr.to_owned(),
+                    serde_json::from_str(rest)
+                        .map_err(|_| "the expected value is not JSON".to_owned())?,
+                )
+            }
+        } else {
+            match text.rsplit_once(':') {
+                Some((ptr, kind))
+                    if [
+                        "bool",
+                        "array",
+                        "number",
+                        "object",
+                        "string",
+                        "nonempty-array",
+                        "nonempty-string",
+                        "positive-number",
+                    ]
+                    .contains(&kind) =>
+                {
+                    Self::Kind(ptr.to_owned(), kind.to_owned())
+                }
+                _ => return Err("not an expectation".to_owned()),
+            }
+        };
+        if !pointer_valid(assertion.pointer()) {
+            return Err("invalid JSON pointer in expectation".to_owned());
+        }
+        Ok(assertion)
+    }
+
+    fn pointer(&self) -> &str {
+        match self {
+            Self::Kind(p, _) | Self::Equals(p, _) | Self::Same(p, _, _) | Self::OneOf(p, _) => p,
+        }
+    }
+
+    pub fn ready(&self, earlier: &BTreeMap<String, Value>) -> bool {
+        match self {
+            Self::Same(_, label, pointer) => earlier
+                .get(label)
+                .and_then(|v| v.pointer(pointer))
+                .is_some(),
+            _ => true,
+        }
+    }
+
+    pub fn is_grading_verdict(&self) -> bool {
+        matches!(self, Self::Equals(pointer, Value::Bool(_)) if pointer == "/correct")
+    }
+
+    pub fn equals(&self, pointer: &str, value: &Value) -> bool {
+        matches!(self, Self::Equals(p, v) if p == pointer && v == value)
+    }
+
+    pub fn kind(&self, pointer: &str, kind: &str) -> bool {
+        matches!(self, Self::Kind(p, k) if p == pointer && k == kind)
+    }
+
+    pub fn same(&self, pointer: &str, label: &str, earlier_pointer: &str) -> bool {
+        matches!(self, Self::Same(p, l, ep) if p == pointer && l == label && ep == earlier_pointer)
+    }
+
+    pub fn graded_shift_outcome(&self) -> bool {
+        match self {
+            Self::Equals(p, v) => {
+                p == "/outcome" && [json!("correct"), json!("incorrect")].contains(v)
+            }
+            Self::OneOf(p, values) => {
+                p == "/outcome"
+                    && values
+                        .iter()
+                        .all(|v| [json!("correct"), json!("incorrect")].contains(v))
+            }
+            _ => false,
+        }
+    }
+
+    pub fn checks_number(&self, pointer: &str) -> bool {
+        self.kind(pointer, "number")
+            || self.kind(pointer, "positive-number")
+            || matches!(self, Self::Equals(p, Value::Number(_)) if p == pointer)
+    }
+
+    /// Private strings/containers are summarized without reversible fingerprints.
+    pub fn observe(&self, answer: &Value, earlier: &BTreeMap<String, Value>) -> Value {
+        let actual = answer.pointer(self.pointer());
+        let (passed, expected) = match self {
+            Self::Kind(_, kind) => (
+                actual.is_some_and(|v| match kind.as_str() {
+                    "bool" => v.is_boolean(),
+                    "array" => v.is_array(),
+                    "number" => v.is_number(),
+                    "object" => v.is_object(),
+                    "string" => v.is_string(),
+                    "nonempty-array" => v.as_array().is_some_and(|a| !a.is_empty()),
+                    "nonempty-string" => v.as_str().is_some_and(|s| !s.is_empty()),
+                    "positive-number" => v.as_f64().is_some_and(|n| n > 0.0),
+                    _ => false,
+                }),
+                json!({"kind": kind}),
+            ),
+            Self::Equals(_, want) => (actual == Some(want), shown_value(Some(want))),
+            Self::Same(_, label, pointer) => {
+                let want = earlier.get(label).and_then(|v| v.pointer(pointer));
+                (
+                    actual.is_some() && actual == want,
+                    json!({"call": label, "pointer": pointer, "value": shown_value(want)}),
+                )
+            }
+            Self::OneOf(_, values) => (
+                actual.is_some_and(|v| values.contains(v)),
+                json!({"one_of": values.iter().map(|v| shown_value(Some(v))).collect::<Vec<_>>()}),
+            ),
+        };
+        json!({"pointer": self.pointer(), "passed": passed,
+            "actual": shown_value(actual), "expected": expected})
+    }
+}
+
+fn input_reference(value: &serde_json::Map<String, Value>) -> Result<Option<(&str, &str)>, String> {
+    if !value.contains_key("$call") {
+        return Ok(None);
+    }
+    if value.len() != 2 {
+        return Err("a call reference contains exactly $call and pointer".to_owned());
+    }
+    match (
+        value["$call"].as_str(),
+        value.get("pointer").and_then(Value::as_str),
+    ) {
+        (Some(label), Some(pointer)) => Ok(Some((label, pointer))),
+        _ => Err("a call reference needs string $call and pointer fields".to_owned()),
+    }
+}
+
+pub(super) fn validate_input(value: &Value, earlier: &BTreeSet<String>) -> Result<(), String> {
+    match value {
+        Value::Object(map) => {
+            if let Some((label, pointer)) = input_reference(map)? {
+                return reference_valid(label, pointer, earlier);
+            }
+            for v in map.values() {
+                validate_input(v, earlier)?;
+            }
+        }
+        Value::Array(values) => {
+            for v in values {
+                validate_input(v, earlier)?;
+            }
+        }
+        _ => {}
+    }
+    Ok(())
+}
+
+/// Exact JSON objects are references; strings are never interpolated or evaluated.
+pub(super) fn resolve_input(
+    value: Value,
+    earlier: &BTreeMap<String, Value>,
+) -> Result<Value, String> {
+    Ok(match value {
+        Value::Object(map) => {
+            if let Some((label, pointer)) = input_reference(&map)? {
+                return earlier
+                    .get(label)
+                    .and_then(|v| v.pointer(pointer))
+                    .cloned()
+                    .ok_or_else(|| {
+                        "an earlier validated result is unavailable; call not sent".to_owned()
+                    });
+            }
+            Value::Object(
+                map.into_iter()
+                    .map(|(k, v)| Ok((k, resolve_input(v, earlier)?)))
+                    .collect::<Result<_, String>>()?,
+            )
+        }
+        Value::Array(values) => Value::Array(
+            values
+                .into_iter()
+                .map(|v| resolve_input(v, earlier))
+                .collect::<Result<_, _>>()?,
+        ),
+        v => v,
+    })
+}
+
+/// The transport's SuperJSON envelope must really contain an answer. Missing
+/// `json` and malformed JSON must never be converted into an asserted null.
+pub(super) fn answer(result: &Value) -> Option<Value> {
+    let data: Value = serde_json::from_str(result["data"].as_str()?).ok()?;
+    data.get("json").cloned()
+}
+
+fn shown_value(value: Option<&Value>) -> Value {
+    match value {
+        None => json!({"present": false}),
+        Some(v) if v.is_boolean() || v.is_number() || v.is_null() => {
+            json!({"present": true, "value": v})
+        }
+        Some(v) => {
+            let text = v.to_string();
+            json!({"present": true, "bytes": text.len(),
+                "array_len": v.as_array().map(Vec::len)})
+        }
+    }
+}
+
+/// Preserve the operator's references, but never publish authored answers.
+pub(super) fn receipt_input(input: &Option<String>) -> Value {
+    let Some(input) = input else {
+        return Value::Null;
+    };
+    let Ok(mut value) = serde_json::from_str::<Value>(input) else {
+        return Value::Null;
+    };
+    for pointer in ["/json/answer", "/json/values"] {
+        if let Some(answer) = value.pointer_mut(pointer) {
+            *answer = json!({"redacted":true});
+        }
+    }
+    json!(value.to_string())
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn pointers_and_dependencies_are_validated_before_dispatch() {
+        let earlier = BTreeSet::from(["01-before".to_owned()]);
+        for text in [
+            "/x=@future",
+            "/x=@01-before/bad~",
+            "bad=true",
+            "/bad~2=true",
+            ":unknown",
+        ] {
+            assert!(Expect::parse(text, &earlier).is_err(), "{text}");
+        }
+        assert!(Expect::parse("/a~1b~0c=@01-before", &earlier).is_ok());
+        for input in [
+            json!({"$call":"future", "pointer":""}),
+            json!({"$call":"01-before"}),
+            json!({"$call":"01-before", "pointer":"", "extra":true}),
+        ] {
+            assert!(validate_input(&input, &earlier).is_err());
+        }
+    }
+
+    #[test]
+    fn equality_does_not_confuse_missing_null_or_boolean_shape_with_a_verdict() {
+        let earlier = BTreeSet::new();
+        let empty = BTreeMap::new();
+        let correct =
+            Expect::parse("/correct=true", &earlier).expect("valid fixture assertion or reference");
+        for response in [
+            json!({}),
+            json!({"correct":false}),
+            json!({"correct":"true"}),
+        ] {
+            assert_eq!(correct.observe(&response, &empty)["passed"], false);
+        }
+        assert_eq!(
+            correct.observe(&json!({"correct":true}), &empty)["passed"],
+            true
+        );
+        let null =
+            Expect::parse("/value=null", &earlier).expect("valid fixture assertion or reference");
+        assert_eq!(null.observe(&json!({}), &empty)["passed"], false);
+        assert_eq!(null.observe(&json!({"value":null}), &empty)["passed"], true);
+        assert!(answer(&json!({"data":"{}"})).is_none());
+        assert!(answer(&json!({"data":"not JSON"})).is_none());
+        assert_eq!(
+            answer(&json!({"data":"{\"json\":null}"})),
+            Some(Value::Null)
+        );
+    }
+
+    #[test]
+    fn dependencies_preserve_json_types_and_values_never_enter_receipts() {
+        let names = BTreeSet::from(["01-start".to_owned()]);
+        let earlier = BTreeMap::from([(
+            "01-start".to_owned(),
+            json!({"id":"private-id", "order":2, "certs":[{"name":"Private Learner"}]}),
+        )]);
+        let input = json!({"json":{"id":{"$call":"01-start", "pointer":"/id"}, "order":{"$call":"01-start", "pointer":"/order"}}});
+        validate_input(&input, &names).expect("valid fixture assertion or reference");
+        assert_eq!(
+            resolve_input(input, &earlier).expect("valid fixture assertion or reference"),
+            json!({"json":{"id":"private-id", "order":2}})
+        );
+        let expect = Expect::parse("/certs=@01-start/certs", &names)
+            .expect("valid fixture assertion or reference");
+        let observed = expect.observe(&earlier["01-start"], &earlier);
+        assert_eq!(observed["passed"], true);
+        assert!(!observed.to_string().contains("Private Learner"));
+        assert!(
+            !Expect::parse("/certs=@01-start/certs", &names)
+                .expect("valid fixture assertion or reference")
+                .ready(&BTreeMap::new())
+        );
+        assert!(
+            resolve_input(json!({"$call":"01-start", "pointer":"/missing"}), &earlier).is_err()
+        );
+        assert_eq!(
+            Expect::parse(":nonempty-array", &names)
+                .expect("valid fixture assertion or reference")
+                .observe(&json!([]), &earlier)["passed"],
+            false
+        );
+    }
+
+    #[test]
+    fn membership_accepts_only_the_designated_graded_outcomes() {
+        let expected = Expect::parse("/outcome in [\"correct\",\"incorrect\"]", &BTreeSet::new())
+            .expect("membership");
+        for (value, passes) in [
+            ("correct", true),
+            ("incorrect", true),
+            ("ungraded", false),
+            ("breached", false),
+        ] {
+            assert_eq!(
+                expected.observe(&json!({"outcome":value}), &BTreeMap::new())["passed"],
+                passes
+            );
+        }
+        for invalid in ["/outcome in []", "/outcome in [true]", "/outcome in null"] {
+            assert!(Expect::parse(invalid, &BTreeSet::new()).is_err());
+        }
+        let private =
+            Expect::parse("/name=\"Private Learner\"", &BTreeSet::new()).expect("literal");
+        let receipt = private.observe(&json!({"name":"Private Learner"}), &BTreeMap::new());
+        assert!(!receipt.to_string().contains("Private Learner"));
+        assert!(!receipt.to_string().contains("sha256"));
+    }
+
+    #[test]
+    fn receipt_templates_and_membership_never_publish_authored_answers() {
+        let input=Some(json!({"json":{"questionId":"q-1","answer":"PRIVATE-ANSWER","values":["PRIVATE-CHOICE"]}}).to_string());
+        let recorded = receipt_input(&input).to_string();
+        assert!(!recorded.contains("PRIVATE-ANSWER"));
+        assert!(!recorded.contains("PRIVATE-CHOICE"));
+        assert!(recorded.contains("questionId"));
+        let expect =
+            Expect::parse("/name in [\"PRIVATE-NAME\"]", &BTreeSet::new()).expect("membership");
+        let recorded = expect
+            .observe(&json!({"name":"PRIVATE-NAME"}), &BTreeMap::new())
+            .to_string();
+        assert!(!recorded.contains("PRIVATE-NAME"));
+    }
+}
diff --git a/crates/xtask/src/live_academy/contracts.rs b/crates/xtask/src/live_academy/contracts.rs
new file mode 100644
index 00000000..ffa6f49e
--- /dev/null
+++ b/crates/xtask/src/live_academy/contracts.rs
@@ -0,0 +1,440 @@
+//! Minimum evidence contracts for the interactive Academy qualification rows.
+//! Reject weak plans before dispatch; private manifests choose test data, not
+//! whether a boolean shape is enough to prove a destructive reset worked.
+
+use serde_json::{Value, json};
+
+use super::Call;
+
+fn input(call: &Call) -> Value {
+    call.input
+        .as_deref()
+        .and_then(|s| serde_json::from_str(s).ok())
+        .unwrap_or(Value::Null)
+}
+
+fn reference(call: &Call, pointer: &str, label: &str, source: &str) -> bool {
+    input(call).pointer(pointer) == Some(&json!({"$call": label, "pointer": source}))
+}
+
+fn equals(call: &Call, pointer: &str, value: Value) -> bool {
+    call.expect.iter().any(|e| e.equals(pointer, &value))
+}
+
+fn kind(call: &Call, pointer: &str, kind: &str) -> bool {
+    call.expect.iter().any(|e| e.kind(pointer, kind))
+}
+
+fn same(call: &Call, pointer: &str, label: &str, source: &str) -> bool {
+    call.expect.iter().any(|e| e.same(pointer, label, source))
+}
+
+/// Only an explicitly scoped hand-off may proceed after a failed checkpoint.
+/// The normal reference, account and budget checks still apply.
+pub(super) fn cleanup(call: &Call) -> bool {
+    call.procedure == "shift.decide" && input(call)["json"]["choice"] == "hand_off"
+}
+
+pub(super) fn validate(calls: &[Call]) -> Result<(), String> {
+    for call in calls {
+        let required = match call.procedure.as_str() {
+            "progress.resetCourse" => Some("W66"),
+            "exam.start" => Some("W53"),
+            "shift.start" | "shift.serve" | "shift.answer" | "shift.decide" => Some("W65"),
+            _ => None,
+        };
+        if required.is_some_and(|workflow| !call.workflows.contains(&workflow)) {
+            return Err(format!(
+                "{}: the procedure requires its interactive workflow contract",
+                call.label
+            ));
+        }
+    }
+    for workflow in ["W53", "W65", "W66"] {
+        let row: Vec<&Call> = calls
+            .iter()
+            .filter(|c| c.workflows.contains(&workflow))
+            .collect();
+        if row.is_empty() {
+            continue;
+        }
+        let unique: &[(&str, usize)] = match workflow {
+            "W53" => &[("exam.start", 1), ("exam.submissionState", 1)],
+            "W65" => &[
+                ("shift.start", 1),
+                ("shift.decide", 1),
+                ("shift.debrief", 1),
+            ],
+            "W66" => &[
+                ("progress.resetCourse", 1),
+                ("progress.courseSummary", 2),
+                ("certificate.mine", 2),
+            ],
+            _ => &[],
+        };
+        if unique.iter().any(|(procedure, count)| {
+            row.iter().filter(|c| c.procedure == *procedure).count() > *count
+        }) {
+            return Err(format!(
+                "{workflow}: duplicate critical checkpoints are not permitted"
+            ));
+        }
+        let mut iter = row.iter().copied();
+        let mut ordered = Vec::new();
+        for procedure in super::workflow_steps(workflow) {
+            ordered.push(iter.find(|c| c.procedure == *procedure).ok_or_else(|| {
+                format!("{workflow}: the program lacks ordered interactive checkpoints")
+            })?);
+        }
+        let valid = match workflow {
+            "W53" => exam(&ordered),
+            "W65" => shift(&row, &ordered),
+            "W66" => reset(&ordered),
+            _ => false,
+        };
+        if !valid {
+            return Err(format!(
+                "{workflow}: the program lacks required outcome assertions or identity references; see academy-2.1-follow-up.md"
+            ));
+        }
+    }
+    Ok(())
+}
+
+fn exam(steps: &[&Call]) -> bool {
+    let (start, state, certificates) = (steps[0], steps[1], steps[2]);
+    kind(start, "/attemptId", "nonempty-string")
+        && kind(start, "/deadline", "nonempty-string")
+        && kind(start, "/timeLimitSeconds", "positive-number")
+        && reference(state, "/json/attemptId", &start.label, "/attemptId")
+        && same(state, "/attemptId", &start.label, "/attemptId")
+        && equals(state, "/status", json!("in-progress"))
+        && (kind(certificates, "", "array") || kind(certificates, "", "nonempty-array"))
+}
+
+fn shift(row: &[&Call], steps: &[&Call]) -> bool {
+    let start = steps[0];
+    if input(start)["json"]["daily"] != true
+        || !kind(start, "/shiftId", "nonempty-string")
+        || !equals(start, "/alertsAnswered", json!(0))
+        || !equals(start, "/atBoundary", json!(false))
+    {
+        return false;
+    }
+    let mut served = Vec::new();
+    for call in row {
+        if !call.procedure.starts_with("shift.") || call.procedure == "shift.start" {
+            continue;
+        }
+        // These other read procedures do not take a shift ID.
+        if [
+            "shift.daily",
+            "shift.dailyBoard",
+            "shift.history",
+            "shift.eligibility",
+            "shift.getActive",
+            "shift.dailyGhost",
+            "shift.yesterday",
+        ]
+        .contains(&call.procedure.as_str())
+        {
+            continue;
+        }
+        if !reference(call, "/json/shiftId", &start.label, "/shiftId") {
+            return false;
+        }
+        let valid = match call.procedure.as_str() {
+            "shift.serve" => {
+                served.push(*call);
+                same(call, "/shift/shiftId", &start.label, "/shiftId")
+                    && call
+                        .expect
+                        .iter()
+                        .any(|e| e.checks_number("/shift/alertOrder"))
+                    && equals(call, "/breachResolved", json!(false))
+            }
+            "shift.answer" => {
+                served.last().is_some_and(|serve| {
+                    reference(call, "/json/order", &serve.label, "/shift/alertOrder")
+                }) && call.expect.iter().any(|e| e.graded_shift_outcome())
+            }
+            "shift.decide" => {
+                cleanup(call)
+                    && same(call, "/shiftId", &start.label, "/shiftId")
+                    && equals(call, "/status", json!("handed_off"))
+            }
+            "shift.debrief" => {
+                kind(call, "/themes", "nonempty-array") && kind(call, "/links", "array")
+            }
+            _ => true,
+        };
+        if !valid {
+            return false;
+        }
+    }
+    true
+}
+
+fn reset(steps: &[&Call]) -> bool {
+    let (certs, before, reset, after, certs_after) =
+        (steps[0], steps[1], steps[2], steps[3], steps[4]);
+    let course = input(before)["json"]["courseId"].clone();
+    if !course.as_str().is_some_and(|c| !c.is_empty())
+        || input(reset)["json"]["courseId"] != course
+        || input(after)["json"]["courseId"] != course
+    {
+        return false;
+    }
+    let counts = ["units", "quizzes", "labs", "objectives"];
+    kind(certs, "", "nonempty-array")
+        && equals(before, "/hasProgress", json!(true))
+        && counts
+            .iter()
+            .any(|c| kind(before, &format!("/{c}"), "positive-number"))
+        && counts.iter().all(|c| {
+            let pointer = format!("/{c}");
+            (kind(before, &pointer, "number") || kind(before, &pointer, "positive-number"))
+                && same(reset, &format!("/cleared/{c}"), &before.label, &pointer)
+                && equals(after, &pointer, json!(0))
+        })
+        && equals(after, "/hasProgress", json!(false))
+        && same(certs_after, "", &certs.label, "")
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::live_academy::assertions::Expect;
+    use desktop_core::learner::LEARNER_PROCEDURES;
+    use std::collections::BTreeSet;
+
+    fn call(
+        label: &str,
+        workflow: &str,
+        procedure: &str,
+        input: Value,
+        expectations: &[&str],
+    ) -> Call {
+        let names = ["start", "certs", "before", "serve"]
+            .map(str::to_owned)
+            .into_iter()
+            .collect::<BTreeSet<_>>();
+        Call {
+            label: label.to_owned(),
+            workflows: match workflow {
+                "W53" => &["W53"],
+                "W65" => &["W65"],
+                _ => &["W66"],
+            },
+            procedure: procedure.to_owned(),
+            kind: LEARNER_PROCEDURES
+                .iter()
+                .find(|(p, _)| *p == procedure)
+                .expect("procedure")
+                .1,
+            input: (!input.is_null()).then(|| input.to_string()),
+            expect: expectations
+                .iter()
+                .map(|e| Expect::parse(e, &names).expect("assertion"))
+                .collect(),
+        }
+    }
+
+    fn exam_plan() -> Vec<Call> {
+        vec![
+            call(
+                "start",
+                "W53",
+                "exam.start",
+                json!({"json":{"consent":true}}),
+                &[
+                    "/attemptId:nonempty-string",
+                    "/deadline:nonempty-string",
+                    "/timeLimitSeconds:positive-number",
+                ],
+            ),
+            call(
+                "state",
+                "W53",
+                "exam.submissionState",
+                json!({"json":{"attemptId":{"$call":"start","pointer":"/attemptId"}}}),
+                &["/attemptId=@start/attemptId", "/status=\"in-progress\""],
+            ),
+            call("certs", "W53", "certificate.mine", Value::Null, &[":array"]),
+        ]
+    }
+
+    fn shift_plan() -> Vec<Call> {
+        let id = json!({"$call":"start","pointer":"/shiftId"});
+        vec![
+            call(
+                "start",
+                "W65",
+                "shift.start",
+                json!({"json":{"daily":true}}),
+                &[
+                    "/shiftId:nonempty-string",
+                    "/alertsAnswered=0",
+                    "/atBoundary=false",
+                ],
+            ),
+            call(
+                "serve",
+                "W65",
+                "shift.serve",
+                json!({"json":{"shiftId":id}}),
+                &[
+                    "/shift/shiftId=@start/shiftId",
+                    "/shift/alertOrder:number",
+                    "/breachResolved=false",
+                ],
+            ),
+            call(
+                "answer",
+                "W65",
+                "shift.answer",
+                json!({"json":{"shiftId":id,"order":{"$call":"serve","pointer":"/shift/alertOrder"},"values":["999999"]}}),
+                &["/outcome in [\"correct\",\"incorrect\"]"],
+            ),
+            call(
+                "decide",
+                "W65",
+                "shift.decide",
+                json!({"json":{"shiftId":id,"choice":"hand_off"}}),
+                &["/shiftId=@start/shiftId", "/status=\"handed_off\""],
+            ),
+            call(
+                "debrief",
+                "W65",
+                "shift.debrief",
+                json!({"json":{"shiftId":id}}),
+                &["/themes:nonempty-array", "/links:array"],
+            ),
+        ]
+    }
+
+    fn reset_plan() -> Vec<Call> {
+        let course = json!({"json":{"courseId":"test-course"}});
+        vec![
+            call(
+                "certs",
+                "W66",
+                "certificate.mine",
+                Value::Null,
+                &[":nonempty-array"],
+            ),
+            call(
+                "before",
+                "W66",
+                "progress.courseSummary",
+                course.clone(),
+                &[
+                    "/hasProgress=true",
+                    "/units:positive-number",
+                    "/quizzes:number",
+                    "/labs:number",
+                    "/objectives:number",
+                ],
+            ),
+            call(
+                "reset",
+                "W66",
+                "progress.resetCourse",
+                course.clone(),
+                &[
+                    "/cleared/units=@before/units",
+                    "/cleared/quizzes=@before/quizzes",
+                    "/cleared/labs=@before/labs",
+                    "/cleared/objectives=@before/objectives",
+                ],
+            ),
+            call(
+                "after",
+                "W66",
+                "progress.courseSummary",
+                course,
+                &[
+                    "/hasProgress=false",
+                    "/units=0",
+                    "/quizzes=0",
+                    "/labs=0",
+                    "/objectives=0",
+                ],
+            ),
+            call(
+                "after-certs",
+                "W66",
+                "certificate.mine",
+                Value::Null,
+                &["=@certs"],
+            ),
+        ]
+    }
+
+    #[test]
+    fn every_mandatory_outcome_assertion_is_required_individually() {
+        for factory in [exam_plan, shift_plan, reset_plan] {
+            let mut plan = factory();
+            assert!(validate(&plan).is_ok());
+            for i in 0..plan.len() {
+                for j in 0..plan[i].expect.len() {
+                    let removed = plan[i].expect.remove(j);
+                    assert!(
+                        validate(&plan).is_err(),
+                        "{} assertion {j}",
+                        plan[i].procedure
+                    );
+                    plan[i].expect.insert(j, removed);
+                }
+            }
+        }
+    }
+
+    #[test]
+    fn identity_references_and_critical_occurrences_cannot_be_weakened() {
+        for factory in [exam_plan, shift_plan, reset_plan] {
+            let mut plan = factory();
+            let critical = plan
+                .iter()
+                .position(|c| {
+                    matches!(
+                        c.procedure.as_str(),
+                        "exam.start" | "shift.start" | "progress.resetCourse"
+                    )
+                })
+                .expect("critical call");
+            let workflow = plan[critical].workflows;
+            plan[critical].workflows = &["W54"];
+            assert!(validate(&plan).is_err());
+            plan[critical].workflows = workflow;
+            let mut duplicate = factory().remove(critical);
+            duplicate.label = "duplicate".to_owned();
+            plan.push(duplicate);
+            assert!(validate(&plan).is_err());
+        }
+        let mut plan = shift_plan();
+        for i in 1..plan.len() {
+            let original = plan[i].input.take();
+            plan[i].input = Some(json!({"json":{"shiftId":"unbound-id"}}).to_string());
+            assert!(validate(&plan).is_err(), "{}", plan[i].procedure);
+            plan[i].input = original;
+        }
+        let mut plan = reset_plan();
+        plan[3].input = Some(json!({"json":{"courseId":"different-course"}}).to_string());
+        assert!(validate(&plan).is_err());
+        let mut plan = exam_plan();
+        plan[1].input = Some(json!({"json":{"attemptId":"unbound-id"}}).to_string());
+        assert!(validate(&plan).is_err());
+        let mut plan = shift_plan();
+        plan[0].input = Some(json!({"json":{"daily":false}}).to_string());
+        assert!(validate(&plan).is_err());
+        let mut plan = shift_plan();
+        let mut changed = input(&plan[2]);
+        changed["json"]["order"] = json!(999);
+        plan[2].input = Some(changed.to_string());
+        assert!(validate(&plan).is_err());
+        let mut plan = reset_plan();
+        plan[2].input = Some(json!({"json":{"courseId":"different-course"}}).to_string());
+        assert!(validate(&plan).is_err());
+    }
+}
diff --git a/crates/xtask/src/live_adapters.rs b/crates/xtask/src/live_adapters.rs
new file mode 100644
index 00000000..0a6e61be
--- /dev/null
+++ b/crates/xtask/src/live_adapters.rs
@@ -0,0 +1,268 @@
+//! OS adapters for the controlled live runner (C25).
+//!
+//! The runner drives the production core, but not the desktop host: there
+//! is no window, Keychain write or saved document. Credentials are session
+//! records (zeroized on removal) and the document lives in memory. The
+//! host's interactive parts are narrowed to what a scoped run needs:
+//!
+//! - a page the core opens (device sign-in, company or MCP sign-in) is
+//!   handed to the [`Operator`], who completes it in the browser; the runner
+//!   never completes it and learns the result only from the core;
+//! - a native confirmation is accepted only when the runner armed it for
+//!   the one change it just reviewed (and checked against its scope);
+//! - a one-time secret shown to the host is dropped (zeroized) unseen;
+//! - the folder sheets answer with the run's own scratch folder, every
+//!   other sheet as cancelled.
+
+use std::future::Future;
+use std::path::PathBuf;
+use std::pin::Pin;
+use std::sync::{Arc, Mutex};
+
+use desktop_core::import::ImportError;
+use desktop_core::store::MemoryStore;
+use desktop_core::vault::{RecordId, SessionVault, Vault, VaultError};
+use desktop_core::{
+    Adapters, ConfirmationRequest, CredentialStore, FileSaver, FolderPicker, ImagePicker,
+    ImportFile, ImportPicker, OperatorConfirmation, PagePrinter, SecretPresenter, UrlOpener,
+};
+use zeroize::Zeroizing;
+
+type Boxed<T> = Pin<Box<dyn Future<Output = T> + Send + 'static>>;
+
+/// The person running a live check: completes browser steps and access
+/// changes the runner asks for. The runner only ever observes the core.
+pub trait Operator: Send + Sync {
+    /// Asks the operator to do `instruction`; `url` is a page the core
+    /// produced (the issuer's verification or authorization page).
+    fn prompt(&self, instruction: &str, url: Option<&url::Url>);
+}
+
+/// The terminal: the instruction on stderr and the page in the default
+/// browser (as the desktop host does).
+pub struct TerminalOperator;
+
+impl Operator for TerminalOperator {
+    fn prompt(&self, instruction: &str, url: Option<&url::Url>) {
+        eprintln!("OPERATOR STEP: {instruction}");
+        if let Some(url) = url {
+            eprintln!("  page: {url}");
+            if url.scheme() == "https" || url.host_str() == Some("127.0.0.1") {
+                let _ = std::process::Command::new("/usr/bin/open")
+                    .arg(url.as_str())
+                    .status();
+            }
+        }
+    }
+}
+
+/// Native confirmations: accepted only once armed, once per arming.
+#[derive(Default)]
+pub struct Confirmations {
+    armed: Mutex<u32>,
+    shown: Mutex<Vec<(String, bool)>>,
+}
+
+impl Confirmations {
+    /// Accept the next confirmation the core opens.
+    pub fn arm(&self) {
+        if let Ok(mut armed) = self.armed.lock() {
+            *armed = 1;
+        }
+    }
+
+    pub fn disarm(&self) {
+        if let Ok(mut armed) = self.armed.lock() {
+            *armed = 0;
+        }
+    }
+
+    /// The titles shown so far and whether each was accepted.
+    pub fn shown(&self) -> Vec<(String, bool)> {
+        self.shown.lock().map(|s| s.clone()).unwrap_or_default()
+    }
+}
+
+/// What a desk's host offers.
+#[derive(Clone)]
+pub struct Host {
+    pub operator: Arc<dyn Operator>,
+    pub confirmations: Arc<Confirmations>,
+    /// Answered by the folder sheets (the run's scratch collection).
+    pub folder: Option<PathBuf>,
+    pub offline_root: Option<PathBuf>,
+    pub workbench_root: Option<PathBuf>,
+    /// Where the save sheet puts a response body (a run-owned folder).
+    pub save_dir: Option<PathBuf>,
+    /// What the image sheet answers with (a synthetic avatar).
+    pub image: Option<Vec<u8>>,
+}
+
+/// Session-only credentials for one run.
+#[derive(Default)]
+struct RunVault(SessionVault);
+
+impl Vault for RunVault {
+    fn put(&self, record: &RecordId, secret: &[u8]) -> Result<(), VaultError> {
+        self.0.put(record, secret)
+    }
+
+    fn get(&self, record: &RecordId) -> Result<Zeroizing<Vec<u8>>, VaultError> {
+        self.0.get(record)
+    }
+
+    fn delete(&self, record: &RecordId) -> Result<(), VaultError> {
+        self.0.delete(record)
+    }
+}
+
+impl CredentialStore for RunVault {
+    fn purge(&self) -> Result<(), VaultError> {
+        self.0.clear();
+        Ok(())
+    }
+}
+
+struct Sheets {
+    operator: Arc<dyn Operator>,
+    confirmations: Arc<Confirmations>,
+    folder: Option<PathBuf>,
+    save_dir: Option<PathBuf>,
+    image: Option<Vec<u8>>,
+}
+
+impl ImportPicker for Sheets {
+    fn choose(&self) -> Boxed<Option<Result<ImportFile, ImportError>>> {
+        Box::pin(async { None })
+    }
+}
+
+impl UrlOpener for Sheets {
+    fn open(&self, url: &url::Url) -> bool {
+        self.operator.prompt(
+            "complete this sign-in in the browser with the designated test identity",
+            Some(url),
+        );
+        true
+    }
+}
+
+impl PagePrinter for Sheets {
+    fn print(&self) -> bool {
+        false
+    }
+}
+
+impl ImagePicker for Sheets {
+    fn choose_image(&self) -> Boxed<Option<Result<ImportFile, ImportError>>> {
+        let file = self.image.clone().map(|bytes| {
+            Ok(ImportFile {
+                name: "c25-avatar.png".to_owned(),
+                bytes: Zeroizing::new(bytes),
+            })
+        });
+        Box::pin(async move { file })
+    }
+}
+
+impl OperatorConfirmation for Sheets {
+    fn confirm(&self, _nonce: u64, request: ConfirmationRequest) -> Boxed<bool> {
+        let accepted = self
+            .confirmations
+            .armed
+            .lock()
+            .map(|mut armed| {
+                let ok = *armed > 0;
+                *armed = 0;
+                ok
+            })
+            .unwrap_or(false);
+        if let Ok(mut shown) = self.confirmations.shown.lock() {
+            shown.push((request.title, accepted));
+        }
+        Box::pin(async move { accepted })
+    }
+
+    fn dismiss(&self, _nonce: u64) {}
+}
+
+impl SecretPresenter for Sheets {
+    fn reveal(&self, _label: String, secret: Zeroizing<String>) {
+        drop(secret);
+    }
+
+    fn dismiss(&self) {}
+}
+
+impl FileSaver for Sheets {
+    fn save(&self, _suggested: String, _bytes: Vec<u8>) -> Boxed<Result<Option<String>, ()>> {
+        Box::pin(async { Ok(None) })
+    }
+}
+
+impl FolderPicker for Sheets {
+    fn choose_folder(&self) -> Boxed<Option<PathBuf>> {
+        let folder = self.folder.clone();
+        Box::pin(async move { folder })
+    }
+
+    fn choose_new(&self) -> Boxed<Option<PathBuf>> {
+        Box::pin(async { None })
+    }
+
+    fn choose_project(&self) -> Boxed<Option<PathBuf>> {
+        Box::pin(async { None })
+    }
+
+    fn choose_save(&self, suggested: String) -> Boxed<Option<PathBuf>> {
+        let name: String = suggested
+            .chars()
+            .filter(|c| c.is_ascii_alphanumeric() || "._-".contains(*c))
+            .take(64)
+            .collect();
+        let path = self.save_dir.as_ref().map(|d| {
+            d.join(if name.is_empty() {
+                "response.bin".to_owned()
+            } else {
+                name
+            })
+        });
+        Box::pin(async move { path })
+    }
+}
+
+/// The adapters one live core runs with.
+pub fn adapters(host: &Host) -> Adapters {
+    let sheets = Arc::new(Sheets {
+        operator: Arc::clone(&host.operator),
+        confirmations: Arc::clone(&host.confirmations),
+        folder: host.folder.clone(),
+        save_dir: host.save_dir.clone(),
+        image: host.image.clone(),
+    });
+    Adapters {
+        keychain: Arc::new(RunVault::default()),
+        learner_keychain: Arc::new(RunVault::default()),
+        store: Arc::new(MemoryStore::new()),
+        picker: sheets.clone(),
+        opener: sheets.clone(),
+        printer: sheets.clone(),
+        images: sheets.clone(),
+        confirmer: sheets.clone(),
+        secrets: sheets.clone(),
+        text_files: sheets.clone(),
+        offline_root: host.offline_root.clone(),
+        saver: sheets.clone(),
+        sessions_root: None,
+        case_files: sheets.clone(),
+        library_root: None,
+        folders: sheets.clone(),
+        workbench_files: sheets.clone(),
+        gateway_files: sheets,
+        workbench_root: host.workbench_root.clone(),
+        harness: desktop_core::harness::sidecar::HarnessAdapters::unavailable(),
+        v1_source: None,
+        import_root: None,
+        logs_root: None,
+    }
+}
diff --git a/crates/xtask/src/live_changes.rs b/crates/xtask/src/live_changes.rs
new file mode 100644
index 00000000..6328751c
--- /dev/null
+++ b/crates/xtask/src/live_changes.rs
@@ -0,0 +1,1103 @@
+//! Mutating families (C25): L03 Runtime changes, L04 DLP and L08 Gateway
+//! changes, each through the production change review: `reviewChange`
+//! (Rust reads the baseline and normalizes the draft), `requestApply` with
+//! the exact typed confirmation, and the native confirmation, which the
+//! runner arms for that one reviewed change only. Every created resource is
+//! named under the family's disposable prefix, every update or delete
+//! targets a resource this run created (or, for a replace, a designated one
+//! written back with its own current body), one-time secrets are forgotten
+//! unseen, and every creation is deleted again and read back as absent. An
+//! outcome that may or may not have taken effect stops the run and leaves
+//! what was created for reconciliation instead of guessing.
+
+use std::collections::BTreeMap;
+
+use desktop_core::management::ManagementResult;
+use serde_json::{Value, json};
+
+use crate::live_run::{
+    Desk, DeskOptions, FamilyResult, Found, Outcomes, Run, Spec, Stop, disposable, sanitize_id,
+};
+use crate::{Result, invalid, now_utc};
+
+/// Names in a body that must sit under the disposable prefix (an IAM
+/// `scope_name` is checked against its underscore form in `names_ok`).
+const NAME_FIELDS: [&str; 5] = [
+    "topic_name",
+    "profile_name",
+    "api_key_name",
+    "cust_app",
+    "name",
+];
+
+fn id_field(kind: &str) -> &'static str {
+    match kind {
+        "topics" => "topic_id",
+        "profiles" => "profile_id",
+        "apiKeys" => "api_key_id",
+        "applications" => "customer_appId",
+        _ => "id",
+    }
+}
+
+/// A created resource the run must delete again.
+#[derive(Clone, Debug)]
+struct Created {
+    label: &'static str,
+    kind: &'static str,
+    id: String,
+    scoped: bool,
+}
+
+/// What one applied change produced.
+pub(crate) enum Applied {
+    /// The review failed; nothing was sent.
+    Review(Value),
+    Settled {
+        result: Value,
+        confirmation: Option<String>,
+    },
+}
+
+/// Reviews `draft`, applies it with the review's own confirmation text and
+/// the armed native confirmation, and waits for the result to settle.
+pub(crate) async fn apply(desk: &mut Desk, draft: &Value) -> Result<Applied> {
+    let context = desk.context_text()?;
+    desk.send_json(json!({"kind": "reviewChange", "context": context, "draft": draft}))
+        .await?;
+    let snap = desk
+        .until(desk.settle, |j| {
+            matches!(
+                j["changes"]["review"]["state"].as_str(),
+                Some("ready" | "failed")
+            )
+        })
+        .await
+        .ok_or_else(|| invalid("the review did not settle"))?;
+    let review = snap["changes"]["review"].clone();
+    if review["state"] == "failed" {
+        return Ok(Applied::Review(review["failure"].clone()));
+    }
+    let typed = review["confirmation"]
+        .as_str()
+        .unwrap_or("CREATE")
+        .to_owned();
+    let before = snap["changes"]["results"]
+        .as_array()
+        .map(Vec::len)
+        .unwrap_or(0);
+    desk.confirmations.arm();
+    let sent = desk
+        .send_json(
+            json!({"kind": "requestApply", "review": review["review"], "draft": draft,
+            "confirmation": typed}),
+        )
+        .await;
+    if let Err(e) = sent {
+        desk.confirmations.disarm();
+        return Err(e);
+    }
+    let settled = desk
+        .until(desk.settle, |j| {
+            j["changes"]["results"]
+                .as_array()
+                .is_some_and(|r| r.len() > before && r[0]["settled"] == true)
+        })
+        .await;
+    desk.confirmations.disarm();
+    let confirmation = desk.confirmations.shown().last().map(|(t, _)| t.clone());
+    match settled {
+        Some(j) => Ok(Applied::Settled {
+            result: j["changes"]["results"][0].clone(),
+            confirmation,
+        }),
+        None => Ok(Applied::Settled {
+            result: json!({"outcome": "unknown", "settled": false}),
+            confirmation,
+        }),
+    }
+}
+
+/// Forgets an applied change's one-time secret, unseen.
+async fn forget(desk: &mut Desk, result: &Value) -> Result<Value> {
+    if result["secret"] != "held" {
+        return Ok(result["secret"].clone());
+    }
+    desk.send_json(json!({"kind": "forgetSecret", "operation": result["operation"]}))
+        .await?;
+    let operation = result["operation"].clone();
+    let forgotten = desk
+        .until(desk.settle, |j| {
+            j["changes"]["results"].as_array().is_some_and(|r| {
+                r.iter()
+                    .any(|x| x["operation"] == operation && x["secret"] == "forgotten")
+            })
+        })
+        .await
+        .is_some();
+    Ok(json!(if forgotten {
+        "held, then forgotten unseen"
+    } else {
+        "still held"
+    }))
+}
+
+fn current(result: &Value) -> Value {
+    result["current"]
+        .as_str()
+        .and_then(|s| serde_json::from_str(s).ok())
+        .unwrap_or(Value::Null)
+}
+
+fn text(value: &Value) -> Option<String> {
+    match value {
+        Value::String(s) => Some(s.clone()),
+        Value::Number(n) => Some(n.to_string()),
+        _ => None,
+    }
+}
+
+struct Ctx<'r, 'a> {
+    run: &'r mut Run<'a>,
+    id: &'static str,
+    prefix: Option<String>,
+    outcomes: Outcomes,
+    created: Vec<Created>,
+    stop: Option<Stop>,
+}
+
+/// One planned change.
+struct Change {
+    spec: Spec,
+    kind: &'static str,
+    action: &'static str,
+    /// The created resource's label (update, delete, rotate), or none.
+    target: Option<&'static str>,
+    body: Value,
+    /// Within the selected Gateway workspace.
+    scoped: bool,
+    expect: &'static str,
+    /// Remember what this creates under this label.
+    creates: Option<&'static str>,
+}
+
+impl Ctx<'_, '_> {
+    fn stopped(&self) -> bool {
+        self.stop.is_some()
+    }
+
+    fn settle(
+        &mut self,
+        spec: Spec,
+        started: String,
+        inputs: BTreeMap<String, Value>,
+        found: Found,
+    ) -> Result<()> {
+        let stop = self.run.settle(
+            self.id,
+            spec,
+            started,
+            inputs,
+            found,
+            None,
+            &mut self.outcomes,
+        )?;
+        if self.stop.is_none() {
+            self.stop = stop;
+        }
+        Ok(())
+    }
+
+    fn block(&mut self, spec: Spec, reason: &str) -> Result<()> {
+        self.settle(spec, now_utc(), BTreeMap::new(), Found::blocked(reason))
+    }
+
+    /// Names in a create body must be under the prefix.
+    fn names_ok(&self, body: &Value) -> std::result::Result<(), String> {
+        let mut names = Vec::new();
+        for field in NAME_FIELDS {
+            if let Some(n) = body.get(field).and_then(Value::as_str) {
+                names.push(n.to_owned());
+            }
+        }
+        if let Some(n) = body["metadata"]["name"].as_str() {
+            names.push(n.to_owned());
+        }
+        if names.is_empty() {
+            return Err("a create names nothing to check against the prefix".to_owned());
+        }
+        for name in names {
+            disposable(self.prefix.as_deref(), &name)?;
+        }
+        // An IAM scope name allows only letters, digits and underscores
+        // (the service refuses hyphens), so it carries the prefix with its
+        // hyphens as underscores.
+        if let Some(scope) = body.get("scope_name").and_then(Value::as_str) {
+            let prefix = self.prefix.as_deref().unwrap_or_default().replace('-', "_");
+            if prefix.is_empty() || !scope.starts_with(&prefix) {
+                return Err(format!(
+                    "the IAM scope {scope} does not start with {prefix}"
+                ));
+            }
+        }
+        Ok(())
+    }
+
+    fn target(&self, label: &str) -> Option<Created> {
+        self.created
+            .iter()
+            .rev()
+            .find(|c| c.label == label)
+            .cloned()
+    }
+
+    /// Applies one change and records it.
+    async fn change(&mut self, desk: &mut Desk, change: Change) -> Result<Option<Value>> {
+        if self.stopped() {
+            return Ok(None);
+        }
+        let started = now_utc();
+        let target = match change.target {
+            None => String::new(),
+            Some(label) => match self.target(label) {
+                Some(c) => c.id,
+                None => {
+                    self.block(
+                        change.spec,
+                        &format!("nothing labelled {label} was created in this run"),
+                    )?;
+                    return Ok(None);
+                }
+            },
+        };
+        if change.action == "create"
+            && let Err(e) = self.names_ok(&change.body)
+        {
+            self.settle(change.spec, started, BTreeMap::new(), Found::blocked(e))?;
+            return Ok(None);
+        }
+        let mut draft = json!({"kind": change.kind, "action": change.action, "target": target,
+            "body": change.body.to_string()});
+        if change.scoped {
+            draft["workspace"] = json!(desk.workspace_ref());
+        }
+        let mut inputs = BTreeMap::new();
+        inputs.insert("kind".to_owned(), json!(change.kind));
+        inputs.insert("action".to_owned(), json!(change.action));
+        if !target.is_empty() {
+            inputs.insert("target".to_owned(), json!(sanitize_id(&target)));
+        }
+        inputs.insert("body".to_owned(), change.body.clone());
+        let (result, confirmation) = match apply(desk, &draft).await? {
+            // A cleanup whose target the review's complete inventory walk
+            // did not find is already absent (an application goes with its
+            // last key); an incomplete walk reports a different problem.
+            Applied::Review(failure)
+                if change.action == "delete"
+                    && change.expect == "absent"
+                    && failure["problem"] == "notFound" =>
+            {
+                let mut found = Found::passed(
+                    "already absent: the review's complete inventory walk found nothing to delete",
+                )
+                .with("review_failure", failure);
+                found.readback = "absent".to_owned();
+                self.settle(change.spec, started, inputs, found)?;
+                return Ok(None);
+            }
+            Applied::Review(failure) => {
+                let found = Found::failed("the review refused the draft; nothing was sent")
+                    .with("review_failure", failure);
+                self.settle(change.spec, started, inputs, found)?;
+                return Ok(None);
+            }
+            Applied::Settled {
+                result,
+                confirmation,
+            } => (result, confirmation),
+        };
+        let outcome = result["outcome"].as_str().unwrap_or("unknown");
+        let readback = result["readback"].as_str().unwrap_or("none").to_owned();
+        let mut found = match outcome {
+            "completed" if readback == change.expect => Found::passed(format!(
+                "applied once after the native confirmation; read back {readback}"
+            )),
+            "completed" => Found::failed(format!(
+                "the write completed but its readback was {readback}, not {}",
+                change.expect
+            ))
+            .stopping("the resulting state is not verified", true),
+            "unknown" => Found::failed("the write may or may not have taken effect")
+                .stopping("an uncertain outcome", true),
+            other => Found::failed(format!(
+                "the service did not apply it ({other}); nothing changed"
+            )),
+        }
+        .with("outcome", json!(outcome))
+        .with("failure", result["failure"].clone())
+        .with("confirmation_title", json!(confirmation));
+        found.readback = readback;
+        if let Some(steps) = result.get("provisioning").filter(|p| !p.is_null()) {
+            // Every step of a multi-step provisioning must have settled and
+            // been read back; otherwise what exists must be reconciled.
+            let settled = ["scope", "workspace", "binding"]
+                .iter()
+                .all(|k| steps[*k] == "completed")
+                && steps["scopeRead"] == "found"
+                && steps["workspaceRead"] == "found"
+                && steps["boundRead"] == true;
+            if !settled && found.outcome == "passed" {
+                found = Found::failed("the provisioning did not settle every step")
+                    .stopping("a partially provisioned workspace must be reconciled", true);
+            }
+            found = found.with("provisioning", steps.clone());
+        }
+        if result["secret"] != "none" && !result["secret"].is_null() {
+            let secret = forget(desk, &result).await?;
+            found = found.with("one_time_secret", secret);
+        }
+        let mut created_id = None;
+        if outcome == "completed"
+            && let Some(label) = change.creates
+        {
+            let now = current(&result);
+            let id = text(&now[id_field(change.kind)])
+                .or_else(|| text(&result["provisioning"]["workspaceId"]));
+            if let Some(id) = id {
+                found = found.id("created_id", &id);
+                self.created.push(Created {
+                    label,
+                    kind: change.kind,
+                    id: id.clone(),
+                    scoped: change.scoped,
+                });
+                created_id = Some(id);
+            }
+        }
+        found.cleanup = if change.creates.is_some() {
+            "deleted at the end of the family and read back as absent".to_owned()
+        } else if change.action == "delete" {
+            "this is the cleanup".to_owned()
+        } else {
+            "nothing created".to_owned()
+        };
+        self.settle(change.spec, started, inputs, found)?;
+        let _ = created_id;
+        Ok((outcome == "completed").then(|| current(&result)))
+    }
+
+    /// Deletes every created resource, newest first, unless the run stopped
+    /// on an uncertain outcome (then they are left for reconciliation).
+    async fn cleanup(&mut self, desk: &mut Desk, specs: &[(&'static str, Spec)]) -> Result<()> {
+        let created = std::mem::take(&mut self.created);
+        if let Some(stop) = &self.stop
+            && stop.reconcile
+        {
+            let left: Vec<String> = created
+                .iter()
+                .map(|c| format!("{} {}", c.kind, sanitize_id(&c.id)))
+                .collect();
+            for (_, spec) in specs {
+                let found =
+                    Found::blocked("not run: an uncertain outcome must be reconciled first")
+                        .with("left_for_reconciliation", json!(left));
+                self.run.settle(
+                    self.id,
+                    *spec,
+                    now_utc(),
+                    BTreeMap::new(),
+                    found,
+                    None,
+                    &mut self.outcomes,
+                )?;
+            }
+            return Ok(());
+        }
+        for (label, spec) in specs {
+            let Some(item) = created.iter().rev().find(|c| c.label == *label).cloned() else {
+                self.run.settle(
+                    self.id,
+                    *spec,
+                    now_utc(),
+                    BTreeMap::new(),
+                    Found::blocked(format!("nothing labelled {label} was created")),
+                    None,
+                    &mut self.outcomes,
+                )?;
+                continue;
+            };
+            self.created = vec![item.clone()];
+            // A key change carries its rotation policy, deletes included
+            // (the review checks it on every key change, as v1 did).
+            let body = if item.kind == "apiKeys" {
+                json!({"rotation_time_interval": 30, "rotation_time_unit": "days"})
+            } else {
+                json!({})
+            };
+            self.change(
+                desk,
+                Change {
+                    spec: *spec,
+                    kind: item.kind,
+                    action: "delete",
+                    target: Some(item.label),
+                    body,
+                    scoped: item.scoped,
+                    expect: "absent",
+                    creates: None,
+                },
+            )
+            .await?;
+        }
+        self.created.clear();
+        Ok(())
+    }
+
+    /// Replaces a designated resource with its own current body: the write
+    /// path is exercised and nothing changes.
+    async fn replace_same(
+        &mut self,
+        desk: &mut Desk,
+        spec: Spec,
+        kind: &'static str,
+        resource: &str,
+        key: &str,
+    ) -> Result<()> {
+        // `<resource>_blocked` (a reason) records the write-back as blocked.
+        let blocked = format!("{}_blocked", key.trim_end_matches("_id"));
+        if let Some(reason) = self.run.nonsecret(self.id, &blocked) {
+            return self.block(spec, &reason);
+        }
+        let Some(id) = self.run.nonsecret(self.id, key) else {
+            return self.block(spec, &format!("{} designates no {key}", self.id));
+        };
+        let detail = desk
+            .read(json!({"kind": "detail", "resource": resource, "id": id}))
+            .await?;
+        let body = match &detail {
+            ManagementResult::Detail { detail } => serde_json::to_value(detail)
+                .ok()
+                .and_then(|d| {
+                    d["item"]
+                        .as_str()
+                        .and_then(|s| serde_json::from_str::<Value>(s).ok())
+                })
+                .map(|mut item| {
+                    if let Some(o) = item.as_object_mut() {
+                        for server in [
+                            "id",
+                            "created_at",
+                            "updated_at",
+                            "created_by",
+                            "updated_by",
+                            "status",
+                        ] {
+                            o.remove(server);
+                        }
+                    }
+                    item
+                }),
+            _ => None,
+        };
+        let Some(body) = body else {
+            return self.settle(
+                spec,
+                now_utc(),
+                BTreeMap::new(),
+                Found::failed("the designated resource could not be read to write it back"),
+            );
+        };
+        self.created.push(Created {
+            label: "designated",
+            kind,
+            id,
+            scoped: false,
+        });
+        self.change(
+            desk,
+            Change {
+                spec,
+                kind,
+                action: "update",
+                target: Some("designated"),
+                body,
+                scoped: false,
+                expect: "found",
+                creates: None,
+            },
+        )
+        .await?;
+        self.created.retain(|c| c.label != "designated");
+        Ok(())
+    }
+}
+
+pub(crate) async fn run(run: &mut Run<'_>, id: &str) -> Result<FamilyResult> {
+    let id: &'static str = match id {
+        "L03" => "L03",
+        "L04" => "L04",
+        _ => "L08",
+    };
+    let prefix = run.prefix(id);
+    let mut ctx = Ctx {
+        run,
+        id,
+        prefix,
+        outcomes: Vec::new(),
+        created: Vec::new(),
+        stop: None,
+    };
+    let mut desk = match ctx.run.management_desk(id, DeskOptions::default()).await? {
+        Ok(d) => d,
+        Err(e) => {
+            ctx.block(
+                Spec {
+                    id: leak(format!("{id}-setup")),
+                    workflows: &[],
+                },
+                &e,
+            )?;
+            return Ok(FamilyResult {
+                outcomes: ctx.outcomes,
+                stop: None,
+            });
+        }
+    };
+    match id {
+        "L03" if ctx.run.subject == crate::subject::Subject::Chunk(31) => {
+            c31_topic(&mut ctx, &mut desk).await?
+        }
+        "L03" => l03(&mut ctx, &mut desk).await?,
+        "L04" => l04(&mut ctx, &mut desk).await?,
+        _ => l08(&mut ctx, &mut desk).await?,
+    }
+    Ok(FamilyResult {
+        outcomes: ctx.outcomes,
+        stop: ctx.stop,
+    })
+}
+
+/// A setup check's name lives for the run (one per family at most).
+fn leak(name: String) -> &'static str {
+    Box::leak(name.into_boxed_str())
+}
+
+fn spec(id: &'static str, workflows: &'static [&'static str]) -> Spec {
+    Spec { id, workflows }
+}
+
+async fn l03(ctx: &mut Ctx<'_, '_>, desk: &mut Desk) -> Result<()> {
+    let p = ctx.prefix.clone().unwrap_or_default();
+    let topic = json!({"topic_name": format!("{p}topic"), "description": "C25 disposable topic",
+        "examples": ["c25 synthetic example"]});
+    let created = ctx
+        .change(
+            desk,
+            Change {
+                spec: spec("L03-topic-create", &["W08"]),
+                kind: "topics",
+                action: "create",
+                target: None,
+                body: topic.clone(),
+                scoped: false,
+                expect: "found",
+                creates: Some("topic"),
+            },
+        )
+        .await?;
+    // The update names the revision the service read back.
+    let revision = created
+        .as_ref()
+        .map(|c| c["revision"].clone())
+        .filter(|r| !r.is_null())
+        .unwrap_or(json!(1));
+    let mut update = topic.clone();
+    update["description"] = json!("C25 disposable topic, updated");
+    update["revision"] = revision;
+    ctx.change(
+        desk,
+        Change {
+            spec: spec("L03-topic-update", &["W08"]),
+            kind: "topics",
+            action: "update",
+            target: Some("topic"),
+            body: update,
+            scoped: false,
+            expect: "found",
+            creates: None,
+        },
+    )
+    .await?;
+    // The service requires a default policy: the new profile copies the
+    // policy of a designated template profile (`profile_template`, else
+    // L01's scan profile), as the editor's duplicate does.
+    let template = ctx
+        .run
+        .nonsecret("L03", "profile_template")
+        .or_else(|| ctx.run.nonsecret("L01", "profile_name"));
+    let policy = match &template {
+        None => None,
+        Some(name) => {
+            let page = desk
+                .read(json!({"kind": "page", "resource": "profiles", "offset": 0, "limit": 100}))
+                .await?;
+            match &page {
+                ManagementResult::Page { page } => serde_json::from_str::<Vec<Value>>(&page.items)
+                    .unwrap_or_default()
+                    .into_iter()
+                    .find(|p| p["profile_name"].as_str() == Some(name.as_str()))
+                    .map(|p| p["policy"].clone())
+                    .filter(|p| p.is_object()),
+                _ => None,
+            }
+        }
+    };
+    match policy {
+        None => ctx.block(
+            spec("L03-profile-create", &["W07"]),
+            "no template profile's policy could be read (designate profile_template)",
+        )?,
+        Some(policy) => {
+            ctx.change(
+                desk,
+                Change {
+                    spec: spec("L03-profile-create", &["W07"]),
+                    kind: "profiles",
+                    action: "create",
+                    target: None,
+                    // Active: the service's inventory omits inactive
+                    // profiles, so an inactive one could not be read back
+                    // or cleaned up (C25 live finding).
+                    body: json!({"profile_name": format!("{p}profile"), "active": true,
+                    "policy": policy}),
+                    scoped: false,
+                    expect: "found",
+                    creates: Some("profile"),
+                },
+            )
+            .await?;
+        }
+    }
+    match ctx.run.nonsecret("L03", "deployment_profile") {
+        None => {
+            ctx.block(
+                spec("L03-key-create", &["W10", "W11"]),
+                "L03 designates no deployment_profile",
+            )?;
+            ctx.block(
+                spec("L03-key-rotate", &["W10", "W11"]),
+                "no key was created",
+            )?;
+            ctx.block(
+                spec("L03-application-update", &["W09"]),
+                "no application was created",
+            )?;
+        }
+        Some(dp) => {
+            let app = format!("{p}app");
+            let env = ctx
+                .run
+                .nonsecret("L03", "app_environment")
+                .unwrap_or_else(|| "staging".to_owned());
+            let cloud = ctx
+                .run
+                .nonsecret("L03", "app_cloud_provider")
+                .unwrap_or_else(|| "aws".to_owned());
+            ctx.change(
+                desk,
+                Change {
+                    spec: spec("L03-key-create", &["W10", "W11"]),
+                    kind: "apiKeys",
+                    action: "create",
+                    target: None,
+                    body: json!({"cust_app": app, "cust_env": env, "cust_cloud_provider": cloud,
+                    "api_key_name": format!("{p}key"), "dp_name": dp, "revoked": false,
+                    "rotation_time_interval": 30, "rotation_time_unit": "days"}),
+                    scoped: false,
+                    expect: "found",
+                    creates: Some("key"),
+                },
+            )
+            .await?;
+            ctx.change(
+                desk,
+                Change {
+                    spec: spec("L03-key-rotate", &["W10", "W11"]),
+                    kind: "apiKeys",
+                    action: "rotate",
+                    target: Some("key"),
+                    body: json!({"rotation_time_interval": 90, "rotation_time_unit": "days"}),
+                    scoped: false,
+                    expect: "found",
+                    creates: None,
+                },
+            )
+            .await?;
+            // Rotation replaces the key's ID: find it again by name so its
+            // cleanup names the current key.
+            if !ctx.stopped() {
+                let page = desk
+                    .read(json!({"kind": "page", "resource": "apiKeys", "offset": 0, "limit": 100}))
+                    .await?;
+                let key_name = format!("{p}key");
+                let current = match &page {
+                    ManagementResult::Page { page } => {
+                        serde_json::from_str::<Vec<Value>>(&page.items)
+                            .unwrap_or_default()
+                            .into_iter()
+                            .find(|k| k["api_key_name"].as_str() == Some(key_name.as_str()))
+                            .and_then(|k| text(&k["api_key_id"]))
+                    }
+                    _ => None,
+                };
+                if let Some(id) = current
+                    && let Some(key) = ctx.created.iter_mut().rev().find(|c| c.label == "key")
+                {
+                    key.id = id;
+                }
+            }
+            // The key's creation made its application; find it by name.
+            if !ctx.stopped() {
+                let page = desk
+                    .read(json!({"kind": "page", "resource": "applications", "offset": 0, "limit": 100}))
+                    .await?;
+                let app_id = match &page {
+                    ManagementResult::Page { page } => {
+                        serde_json::from_str::<Vec<Value>>(&page.items)
+                            .unwrap_or_default()
+                            .into_iter()
+                            .find(|a| a["app_name"].as_str() == Some(app.as_str()))
+                            .and_then(|a| text(&a["customer_appId"]))
+                    }
+                    _ => None,
+                };
+                match app_id {
+                    Some(id) => {
+                        ctx.created.push(Created {
+                            label: "application",
+                            kind: "applications",
+                            id,
+                            scoped: false,
+                        });
+                        ctx.change(desk, Change {
+                            spec: spec("L03-application-update", &["W09"]),
+                            kind: "applications", action: "update", target: Some("application"),
+                            // A real change: the environment moves off the
+                            // one the key's creation recorded.
+                            body: json!({"app_name": app, "cloud_provider": cloud,
+                                "environment": if env == "development" { "staging" } else { "development" }}),
+                            scoped: false, expect: "found", creates: None,
+                        })
+                        .await?;
+                    }
+                    None => ctx.settle(
+                        spec("L03-application-update", &["W09"]),
+                        now_utc(),
+                        BTreeMap::new(),
+                        Found::failed("the key's application is not listed"),
+                    )?,
+                }
+            }
+        }
+    }
+    ctx.cleanup(
+        desk,
+        &[
+            ("key", spec("L03-cleanup-key", &["W10"])),
+            ("application", spec("L03-cleanup-application", &["W09"])),
+            ("profile", spec("L03-cleanup-profile", &["W07"])),
+            ("topic", spec("L03-cleanup-topic", &["W08"])),
+        ],
+    )
+    .await
+}
+
+/// C31's live row, inside L03's designation (create, update and delete
+/// disposable `airs-v2-c25-*` topics): one topic review applied after the
+/// native confirmation and read back, then removed and read back absent.
+async fn c31_topic(ctx: &mut Ctx<'_, '_>, desk: &mut Desk) -> Result<()> {
+    let p = ctx.prefix.clone().unwrap_or_default();
+    let topic = json!({"topic_name": format!("{p}c31-topic"), "description": "C31 review apply",
+        "examples": ["c31 synthetic example"]});
+    let created = ctx
+        .change(
+            desk,
+            Change {
+                spec: spec("C31-topic-create", &["W08"]),
+                kind: "topics",
+                action: "create",
+                target: None,
+                body: topic.clone(),
+                scoped: false,
+                expect: "found",
+                creates: Some("topic"),
+            },
+        )
+        .await?;
+    let revision = created
+        .as_ref()
+        .map(|c| c["revision"].clone())
+        .filter(|r| !r.is_null())
+        .unwrap_or(json!(1));
+    let mut update = topic;
+    update["description"] = json!("C31 review apply, updated through the review");
+    update["revision"] = revision;
+    ctx.change(
+        desk,
+        Change {
+            spec: spec("C31-topic-review-apply", &["W08"]),
+            kind: "topics",
+            action: "update",
+            target: Some("topic"),
+            body: update,
+            scoped: false,
+            expect: "found",
+            creates: None,
+        },
+    )
+    .await?;
+    ctx.cleanup(desk, &[("topic", spec("C31-cleanup-topic", &["W08"]))])
+        .await
+}
+
+async fn l04(ctx: &mut Ctx<'_, '_>, desk: &mut Desk) -> Result<()> {
+    let p = ctx.prefix.clone().unwrap_or_default();
+    // The service needs the regex rules and confidence levels a custom
+    // pattern detects with (the shape of the tenant's own custom patterns).
+    let pattern = json!({"name": format!("{p}pattern"), "type": "custom",
+        "description": "C25 disposable pattern",
+        "detection_config": {"technique": "regex", "supported_confidence_levels": ["high", "low"]},
+        "matching_rules": {"proximity_distance": 200,
+            "regexes": [{"regex": "airs-v2-c25-[0-9]{6}", "weight": 1}]}});
+    ctx.change(
+        desk,
+        Change {
+            spec: spec("L04-pattern-create", &["W13"]),
+            kind: "dataPatterns",
+            action: "create",
+            target: None,
+            body: pattern.clone(),
+            scoped: false,
+            expect: "found",
+            creates: Some("pattern"),
+        },
+    )
+    .await?;
+    let mut replaced = pattern;
+    replaced["description"] = json!("C25 disposable pattern, replaced");
+    ctx.change(
+        desk,
+        Change {
+            spec: spec("L04-pattern-replace", &["W13"]),
+            kind: "dataPatterns",
+            action: "update",
+            target: Some("pattern"),
+            body: replaced,
+            scoped: false,
+            expect: "found",
+            creates: None,
+        },
+    )
+    .await?;
+    let category = ctx
+        .run
+        .nonsecret("L04", "dictionary_category")
+        .unwrap_or_else(|| "Confidential".to_owned());
+    let region = ctx
+        .run
+        .nonsecret("L04", "dictionary_region")
+        .unwrap_or_else(|| "United States".to_owned());
+    let metadata = |file: &str| {
+        json!({"name": format!("{p}dictionary"), "original_file_name": file,
+        "category": category, "region_name": region})
+    };
+    ctx.change(desk, Change {
+        spec: spec("L04-dictionary-create", &["W16"]),
+        kind: "dictionaries", action: "create", target: None,
+        body: json!({"metadata": metadata("c25-keywords.txt"), "file": "c25-synthetic-keyword\n"}),
+        scoped: false, expect: "found", creates: Some("dictionary"),
+    })
+    .await?;
+    ctx.change(desk, Change {
+        spec: spec("L04-dictionary-replace", &["W16"]),
+        kind: "dictionaries", action: "update", target: Some("dictionary"),
+        body: json!({"metadata": metadata("c25-keywords-2.txt"), "file": "c25-synthetic-keyword-2\n"}),
+        scoped: false, expect: "found", creates: None,
+    })
+    .await?;
+    if !ctx.stopped() {
+        ctx.replace_same(
+            desk,
+            spec("L04-data-profile-replace", &["W14"]),
+            "dataProfiles",
+            "dataProfiles",
+            "data_profile_id",
+        )
+        .await?;
+    }
+    if !ctx.stopped() {
+        ctx.replace_same(
+            desk,
+            spec("L04-filtering-profile-replace", &["W15"]),
+            "filteringProfiles",
+            "filteringProfiles",
+            "filtering_profile_id",
+        )
+        .await?;
+    }
+    if !ctx.stopped() {
+        let started = now_utc();
+        let page = desk
+            .read(
+                json!({"kind": "page", "resource": "deploymentProfiles", "offset": 0, "limit": 25}),
+            )
+            .await?;
+        let found = Found::check(
+            matches!(page, ManagementResult::Page { .. }),
+            "the deployment profile catalog was read (catalog-only, no deployment writes)",
+            "the deployment catalog could not be read",
+        )
+        .with("page", crate::live_run::summarize(&page));
+        ctx.settle(
+            spec("L04-deployment-catalog", &["W12"]),
+            started,
+            BTreeMap::new(),
+            found,
+        )?;
+    }
+    ctx.cleanup(
+        desk,
+        &[
+            ("dictionary", spec("L04-cleanup-dictionary", &["W16"])),
+            ("pattern", spec("L04-cleanup-pattern", &["W13"])),
+        ],
+    )
+    .await
+}
+
+async fn l08(ctx: &mut Ctx<'_, '_>, desk: &mut Desk) -> Result<()> {
+    let p = ctx.prefix.clone().unwrap_or_default();
+    // `provision_blocked` (a reason) records provisioning as blocked and
+    // runs the route and key changes in the designated workspace instead.
+    let workspace = match ctx.run.nonsecret("L08", "provision_blocked") {
+        Some(reason) => {
+            ctx.block(spec("L08-provision-workspace", &["W37", "W39"]), &reason)?;
+            ctx.run.nonsecret("L08", "workspace_id")
+        }
+        None => {
+            ctx.change(
+                desk,
+                Change {
+                    spec: spec("L08-provision-workspace", &["W37", "W39"]),
+                    kind: "gatewayWorkspaces",
+                    action: "create",
+                    target: None,
+                    body: json!({"name": format!("{p}ws"),
+                    "scope_name": format!("{}scope", p.replace('-', "_")),
+                    "existing_scope": false}),
+                    scoped: false,
+                    expect: "found",
+                    creates: Some("workspace"),
+                },
+            )
+            .await?;
+            ctx.target("workspace").map(|c| c.id)
+        }
+    };
+    let selected = match workspace {
+        Some(ws) if !ctx.stopped() => desk.select_workspace(&ws).await.is_ok(),
+        _ => false,
+    };
+    if selected {
+        match ctx.run.nonsecret("L08", "route_provider") {
+            None => {
+                ctx.block(
+                    spec("L08-route-create", &["W37"]),
+                    "L08 designates no route_provider",
+                )?;
+                ctx.block(spec("L08-route-update", &["W37"]), "no route was created")?;
+            }
+            Some(provider) => {
+                // A single-target routing config naming the integration as
+                // `@slug` (the Gateway's model catalog form).
+                let target = if provider.starts_with('@') {
+                    provider.clone()
+                } else {
+                    format!("@{provider}")
+                };
+                let config = json!({"strategy": {"mode": "single"},
+                    "targets": [{"provider": target}]});
+                ctx.change(
+                    desk,
+                    Change {
+                        spec: spec("L08-route-create", &["W37"]),
+                        kind: "gatewayRoutes",
+                        action: "create",
+                        target: None,
+                        body: json!({"name": format!("{p}route"), "config": config}),
+                        scoped: true,
+                        expect: "found",
+                        creates: Some("route"),
+                    },
+                )
+                .await?;
+                ctx.change(
+                    desk,
+                    Change {
+                        spec: spec("L08-route-update", &["W37"]),
+                        kind: "gatewayRoutes",
+                        action: "update",
+                        target: Some("route"),
+                        body: json!({"name": format!("{p}route-2")}),
+                        scoped: true,
+                        expect: "found",
+                        creates: None,
+                    },
+                )
+                .await?;
+            }
+        }
+        ctx.change(desk, Change {
+            spec: spec("L08-service-key-create", &["W38"]),
+            kind: "gatewayServiceKeys", action: "create", target: None,
+            body: json!({"name": format!("{p}key"), "scopes": ["completions.write"], "type": "service"}),
+            scoped: true, expect: "found", creates: Some("key"),
+        })
+        .await?;
+        ctx.change(
+            desk,
+            Change {
+                spec: spec("L08-service-key-rotate", &["W38"]),
+                kind: "gatewayServiceKeys",
+                action: "rotate",
+                target: Some("key"),
+                body: json!({"key_transition_period_ms": 3_600_000}),
+                scoped: true,
+                expect: "found",
+                creates: None,
+            },
+        )
+        .await?;
+    } else {
+        for name in [
+            "L08-route-create",
+            "L08-route-update",
+            "L08-service-key-create",
+            "L08-service-key-rotate",
+        ] {
+            ctx.block(
+                spec(name, &["W37", "W38"]),
+                "the provisioned workspace could not be selected",
+            )?;
+        }
+    }
+    ctx.cleanup(
+        desk,
+        &[
+            ("key", spec("L08-cleanup-service-key", &["W38"])),
+            ("route", spec("L08-cleanup-route", &["W37"])),
+            ("workspace", spec("L08-cleanup-workspace", &["W39"])),
+        ],
+    )
+    .await
+}
diff --git a/crates/xtask/src/live_inference.rs b/crates/xtask/src/live_inference.rs
new file mode 100644
index 00000000..94af4f6b
--- /dev/null
+++ b/crates/xtask/src/live_inference.rs
@@ -0,0 +1,345 @@
+//! L09 Gateway inference (C25): bounded streamed runs through the
+//! production Playground (`configureInferenceCredential`, `runInference`,
+//! `stopInference`) in the designated workspace, with its own inference key
+//! (never the management client). Each run is charged against the `runs`
+//! budget before it starts; the tokens the Gateway reports are charged to
+//! `tokens` afterwards and a run over the cap stops the family. The core
+//! sends only to the configured Gateway endpoint; there is no upstream
+//! fallback for the runner to take.
+
+use std::collections::BTreeMap;
+
+use serde_json::{Value, json};
+
+use crate::live_run::{Desk, DeskOptions, FamilyResult, Found, Outcomes, Run, Spec, Stop};
+use crate::{Result, now_utc};
+
+const STREAM: Spec = Spec {
+    id: "L09-stream",
+    workflows: &["W40"],
+};
+const CANCEL: Spec = Spec {
+    id: "L09-cancel",
+    workflows: &["W40"],
+};
+const ERROR: Spec = Spec {
+    id: "L09-error-recovery",
+    workflows: &["W40"],
+};
+
+/// A short synthetic prompt (bounded output).
+const PROMPT: &str = "Reply with the single word: ready.";
+/// A prompt that streams long enough to be stopped.
+const LONG: &str = "Count from 1 to 200, one number per line.";
+
+/// `prompt` made unique to this run, so a Gateway response cache cannot
+/// answer it: a cached answer is replayed as one chunk without
+/// `finish_reason`, which the SDK's stream contract refuses (C25).
+fn fresh(prompt: &str) -> String {
+    format!("{prompt} (C25 run {})", now_utc())
+}
+
+async fn start(desk: &mut Desk, reference: &str, run: Value) -> Result<Value> {
+    let context = desk.context_text()?;
+    desk.admit(
+        json!({"kind": "runInference", "context": context, "workspace": reference, "run": run}),
+    )
+    .await
+    .map(|op| json!(op))
+}
+
+fn playground(j: &Value) -> Value {
+    j["gateway"]["playground"].clone()
+}
+
+async fn ended(desk: &Desk) -> Value {
+    desk.until(desk.settle, |j| {
+        playground(j)["state"]
+            .as_str()
+            .is_some_and(|s| s != "running")
+    })
+    .await
+    .map(|j| playground(&j))
+    .unwrap_or_else(|| json!({"state": "running"}))
+}
+
+fn shown(view: &Value) -> Found {
+    Found::new("passed", "")
+        .with("state", view["state"].clone())
+        .with("outcome", view["outcome"].clone())
+        .with("failure", view["failure"].clone())
+        .with("sent", view["sent"].clone())
+        .with("answered", view["answered"].clone())
+        .with("served_model", view["servedModel"].clone())
+        .with("finish", view["finish"].clone())
+        .with("usage", view["usage"].clone())
+        .with("output_chars", json!(view["output"].as_str().map(str::len)))
+}
+
+fn ids(mut found: Found, view: &Value) -> Found {
+    if let Some(trace) = view["trace"].as_str() {
+        found = found.id("trace", trace);
+    }
+    if let Some(response) = view["responseId"].as_str() {
+        found = found.id("response_id", response);
+    }
+    found
+}
+
+struct Ctx<'r, 'a> {
+    run: &'r mut Run<'a>,
+    outcomes: Outcomes,
+    stop: Option<Stop>,
+}
+
+impl Ctx<'_, '_> {
+    fn settle(
+        &mut self,
+        spec: Spec,
+        started: String,
+        inputs: BTreeMap<String, Value>,
+        found: Found,
+    ) -> Result<()> {
+        let stop = self.run.settle(
+            "L09",
+            spec,
+            started,
+            inputs,
+            found,
+            Some("L09"),
+            &mut self.outcomes,
+        )?;
+        if self.stop.is_none() {
+            self.stop = stop;
+        }
+        Ok(())
+    }
+
+    fn block(&mut self, specs: &[Spec], reason: &str) -> Result<()> {
+        for spec in specs {
+            self.settle(*spec, now_utc(), BTreeMap::new(), Found::blocked(reason))?;
+        }
+        Ok(())
+    }
+
+    /// Charges one run; a run over the cap is never started.
+    fn charge(&mut self) -> std::result::Result<(), String> {
+        self.run.guard.spend("L09", "runs", 1)
+    }
+
+    /// Charges the tokens the Gateway reported; over the cap stops.
+    fn tokens(&mut self, view: &Value) -> Option<String> {
+        let total = view["usage"]["total"].as_u64()?;
+        self.run.guard.report("L09", "tokens", total).err()
+    }
+}
+
+pub(crate) async fn run(run: &mut Run<'_>, _id: &str) -> Result<FamilyResult> {
+    let mut ctx = Ctx {
+        run,
+        outcomes: Vec::new(),
+        stop: None,
+    };
+    let all = [STREAM, CANCEL, ERROR];
+    let (Some(workspace), Some(endpoint), Some(model)) = (
+        ctx.run.nonsecret("L09", "workspace_id"),
+        ctx.run.nonsecret("L09", "inference_endpoint"),
+        ctx.run.nonsecret("L09", "model"),
+    ) else {
+        ctx.block(&all, "L09 needs workspace_id, inference_endpoint and model")?;
+        return Ok(FamilyResult {
+            outcomes: ctx.outcomes,
+            stop: None,
+        });
+    };
+    let route = ctx.run.nonsecret("L09", "route");
+    let mut desk = match ctx
+        .run
+        .management_desk("L09", DeskOptions::default())
+        .await?
+    {
+        Ok(d) => d,
+        Err(e) => {
+            ctx.block(&all, &e)?;
+            return Ok(FamilyResult {
+                outcomes: ctx.outcomes,
+                stop: None,
+            });
+        }
+    };
+    let reference = match desk.select_workspace(&workspace).await {
+        Ok(r) => r,
+        Err(e) => {
+            ctx.block(&all, &e.to_string())?;
+            return Ok(FamilyResult {
+                outcomes: ctx.outcomes,
+                stop: None,
+            });
+        }
+    };
+    let Some(key) = ctx.run.secret("L09", "inference_key")? else {
+        ctx.block(&all, "L09 designates no inference_key credential")?;
+        return Ok(FamilyResult {
+            outcomes: ctx.outcomes,
+            stop: None,
+        });
+    };
+    let context = desk.context_text()?;
+    desk.send_json(
+        json!({"kind": "configureInferenceCredential", "context": context,
+        "mode": "session", "workspace": reference, "endpoint": endpoint, "secret": (*key).clone()}),
+    )
+    .await?;
+    if desk
+        .until(desk.settle, |j| {
+            j["tenants"]
+                .as_array()
+                .is_some_and(|t| t.iter().any(|t| t["inference"]["state"] == "ready"))
+        })
+        .await
+        .is_none()
+    {
+        ctx.block(
+            &all,
+            "the inference key could not be stored for this session",
+        )?;
+        return Ok(FamilyResult {
+            outcomes: ctx.outcomes,
+            stop: None,
+        });
+    }
+    let mut inputs = ctx.run.inputs("L09", &["client_secret", "inference_key"]);
+    inputs.insert("endpoint".to_owned(), json!(endpoint));
+
+    // A complete streamed answer.
+    let started = now_utc();
+    let found = match ctx.charge() {
+        Err(e) => Found::blocked(e.clone()).stopping(format!("unexpected cost: {e}"), false),
+        Ok(()) => {
+            start(
+                &mut desk,
+                &reference,
+                json!({"model": model, "route": route, "prompt": fresh(PROMPT)}),
+            )
+            .await?;
+            let view = ended(&desk).await;
+            let mut found = shown(&view);
+            let complete = view["state"] == "completed" && view["outcome"] == "completed";
+            found.outcome = if complete { "passed" } else { "failed" };
+            found.detail = if complete {
+                "a streamed answer through the designated Gateway route, with the model it served"
+                    .to_owned()
+            } else {
+                "the run did not complete".to_owned()
+            };
+            if view["state"] == "running" {
+                found = found.stopping(
+                    "the run did not end in time; it may still be consuming",
+                    true,
+                );
+            } else if let Some(over) = ctx.tokens(&view) {
+                found = found.stopping(format!("unexpected cost: {over}"), false);
+            }
+            ids(found, &view)
+        }
+    };
+    ctx.settle(STREAM, started, inputs.clone(), found)?;
+    if ctx.stop.is_some() {
+        return Ok(FamilyResult {
+            outcomes: ctx.outcomes,
+            stop: ctx.stop,
+        });
+    }
+
+    // Stopped after the first output arrives.
+    let started = now_utc();
+    let found = match ctx.charge() {
+        Err(e) => Found::blocked(e.clone()).stopping(format!("unexpected cost: {e}"), false),
+        Ok(()) => {
+            start(
+                &mut desk,
+                &reference,
+                json!({"model": model, "route": route, "prompt": fresh(LONG)}),
+            )
+            .await?;
+            let streaming = desk
+                .until(desk.settle, |j| {
+                    let p = playground(j);
+                    p["output"].as_str().is_some_and(|o| !o.is_empty()) || p["state"] != "running"
+                })
+                .await
+                .map(|j| playground(&j))
+                .unwrap_or_default();
+            if streaming["state"] == "running" {
+                desk.send_json(
+                    json!({"kind": "stopInference", "operation": streaming["operation"]}),
+                )
+                .await?;
+            }
+            let view = ended(&desk).await;
+            let mut found = shown(&view);
+            let stopped = view["state"] == "stopped";
+            found.outcome = if stopped { "passed" } else { "failed" };
+            found.detail = if stopped {
+                "the stream was stopped by the operator's Stop; whether it was charged is reported as unknown, never assumed".to_owned()
+            } else {
+                "the run ended before it could be stopped".to_owned()
+            };
+            if let Some(over) = ctx.tokens(&view) {
+                found = found.stopping(format!("unexpected cost: {over}"), false);
+            }
+            ids(found, &view)
+        }
+    };
+    ctx.settle(CANCEL, started, inputs.clone(), found)?;
+    if ctx.stop.is_some() {
+        return Ok(FamilyResult {
+            outcomes: ctx.outcomes,
+            stop: ctx.stop,
+        });
+    }
+
+    // A model the route does not serve: refused, nothing sent elsewhere,
+    // and the Playground recovers for the next run.
+    let started = now_utc();
+    let missing = ctx
+        .run
+        .nonsecret("L09", "unavailable_model")
+        .unwrap_or_else(|| "c25-unavailable-model".to_owned());
+    let found = match ctx.charge() {
+        Err(e) => Found::blocked(e.clone()).stopping(format!("unexpected cost: {e}"), false),
+        Ok(()) => {
+            start(
+                &mut desk,
+                &reference,
+                json!({"model": missing, "prompt": PROMPT}),
+            )
+            .await?;
+            let view = ended(&desk).await;
+            let mut found = shown(&view);
+            let refused = view["state"] == "failed" && view["servedModel"].is_null();
+            let context = desk.context_text()?;
+            let cleared = desk
+                .send_json(json!({"kind": "clearInference", "operation": view["operation"]}))
+                .await
+                .is_ok();
+            found.outcome = if refused && cleared {
+                "passed"
+            } else {
+                "failed"
+            };
+            found.detail = if refused {
+                "the Gateway refused the unknown model; no answer and no other model were shown, and the run was cleared".to_owned()
+            } else {
+                "an unknown model did not fail as expected".to_owned()
+            };
+            let _ = context;
+            ids(found, &view)
+        }
+    };
+    ctx.settle(ERROR, started, inputs, found)?;
+    Ok(FamilyResult {
+        outcomes: ctx.outcomes,
+        stop: ctx.stop,
+    })
+}
diff --git a/crates/xtask/src/live_mcp.rs b/crates/xtask/src/live_mcp.rs
new file mode 100644
index 00000000..31bd6366
--- /dev/null
+++ b/crates/xtask/src/live_mcp.rs
@@ -0,0 +1,365 @@
+//! L17 Workspace MCP (C25) through the production intents: the selected
+//! workspace's catalog (`listMcpServers`), the desktop's own OAuth sign-in
+//! to a designated server (`signInMcpServer`; the operator completes the
+//! authorization page, and the core's loopback callback finishes it), a
+//! scope or grant change the operator makes (the catalog then shows the
+//! sign-in stale), and revocation (`signOutMcpServer`). Tool calls, their
+//! approval and denial, and token refresh happen inside the native Harness
+//! engine and are recorded as needing the desktop app.
+
+use std::collections::BTreeMap;
+use std::time::Duration;
+
+use serde_json::{Value, json};
+
+use crate::live_run::{
+    Desk, DeskOptions, FamilyResult, Found, Outcomes, Run, Spec, Stop, operator_step,
+};
+use crate::{Result, now_utc};
+
+const DISCOVERY: Spec = Spec {
+    id: "L17-discovery",
+    workflows: &["W47"],
+};
+const SIGN_IN: Spec = Spec {
+    id: "L17-sign-in",
+    workflows: &["W47"],
+};
+const SCOPE: Spec = Spec {
+    id: "L17-scope-change",
+    workflows: &["W48"],
+};
+const REVOKE: Spec = Spec {
+    id: "L17-revocation",
+    workflows: &["W48"],
+};
+const APPROVED: Spec = Spec {
+    id: "L17-approved-read-call",
+    workflows: &["W48"],
+};
+const DENIED: Spec = Spec {
+    id: "L17-denied-call",
+    workflows: &["W48"],
+};
+const REFRESH: Spec = Spec {
+    id: "L17-refresh",
+    workflows: &["W48"],
+};
+
+fn view(j: &Value) -> Value {
+    j["harness"]["mcp"].clone()
+}
+
+fn server<'a>(v: &'a Value, id: &str) -> &'a Value {
+    v["servers"]
+        .as_array()
+        .and_then(|s| s.iter().find(|s| s["id"] == id))
+        .unwrap_or(&Value::Null)
+}
+
+async fn list(desk: &mut Desk, reference: &str) -> Result<Value> {
+    let context = desk.context_text()?;
+    desk.send_json(json!({"kind": "listMcpServers", "context": context, "workspace": reference}))
+        .await?;
+    Ok(desk
+        .until(desk.settle, |j| view(j)["state"] != "loading")
+        .await
+        .map(|j| view(&j))
+        .unwrap_or_default())
+}
+
+struct Ctx<'r, 'a> {
+    run: &'r mut Run<'a>,
+    outcomes: Outcomes,
+    stop: Option<Stop>,
+}
+
+impl Ctx<'_, '_> {
+    fn settle(
+        &mut self,
+        spec: Spec,
+        started: String,
+        inputs: BTreeMap<String, Value>,
+        found: Found,
+    ) -> Result<()> {
+        let stop = self.run.settle(
+            "L17",
+            spec,
+            started,
+            inputs,
+            found,
+            None,
+            &mut self.outcomes,
+        )?;
+        if self.stop.is_none() {
+            self.stop = stop;
+        }
+        Ok(())
+    }
+
+    fn block(&mut self, specs: &[Spec], reason: &str) -> Result<()> {
+        for spec in specs {
+            self.settle(*spec, now_utc(), BTreeMap::new(), Found::blocked(reason))?;
+        }
+        Ok(())
+    }
+}
+
+pub(crate) async fn run(run: &mut Run<'_>, _id: &str) -> Result<FamilyResult> {
+    let mut ctx = Ctx {
+        run,
+        outcomes: Vec::new(),
+        stop: None,
+    };
+    let remote = [DISCOVERY, SIGN_IN, SCOPE, REVOKE];
+    for spec in [APPROVED, DENIED, REFRESH] {
+        let found = Found::native(
+            "MCP tool calls, their native approval or denial, and token refresh run inside the \
+             Harness engine, which only the desktop app launches; run this with the native \
+             acceptance driver against the designated server",
+        );
+        ctx.settle(spec, now_utc(), BTreeMap::new(), found)?;
+    }
+    let designated_server = ctx.run.nonsecret("L17", "mcp_server_id");
+    let server_name = ctx.run.nonsecret("L17", "mcp_server_name");
+    let (Some(workspace), true, Some(endpoint)) = (
+        ctx.run.nonsecret("L17", "workspace_id"),
+        designated_server.is_some() || server_name.is_some(),
+        ctx.run.nonsecret("L17", "inference_endpoint"),
+    ) else {
+        ctx.block(
+            &remote,
+            "L17 needs workspace_id, mcp_server_id (or mcp_server_name) and inference_endpoint",
+        )?;
+        return Ok(FamilyResult {
+            outcomes: ctx.outcomes,
+            stop: None,
+        });
+    };
+    let mut desk = match ctx
+        .run
+        .management_desk("L17", DeskOptions::default())
+        .await?
+    {
+        Ok(d) => d,
+        Err(e) => {
+            ctx.block(&remote, &e)?;
+            return Ok(FamilyResult {
+                outcomes: ctx.outcomes,
+                stop: None,
+            });
+        }
+    };
+    let reference = match desk.select_workspace(&workspace).await {
+        Ok(r) => r,
+        Err(e) => {
+            ctx.block(&remote, &e.to_string())?;
+            return Ok(FamilyResult {
+                outcomes: ctx.outcomes,
+                stop: None,
+            });
+        }
+    };
+    let Some(key) = ctx.run.secret("L17", "inference_key")? else {
+        ctx.block(&remote, "L17 designates no inference_key credential")?;
+        return Ok(FamilyResult {
+            outcomes: ctx.outcomes,
+            stop: None,
+        });
+    };
+    let context = desk.context_text()?;
+    desk.send_json(
+        json!({"kind": "configureInferenceCredential", "context": context,
+        "mode": "session", "workspace": reference, "endpoint": endpoint, "secret": (*key).clone()}),
+    )
+    .await?;
+    let _ = desk
+        .until(desk.settle, |j| {
+            j["tenants"]
+                .as_array()
+                .is_some_and(|t| t.iter().any(|t| t["inference"]["state"] == "ready"))
+        })
+        .await;
+    let mut inputs = ctx.run.inputs("L17", &["client_secret", "inference_key"]);
+    inputs.insert("endpoint".to_owned(), json!(endpoint));
+
+    let started = now_utc();
+    let v = list(&mut desk, &reference).await?;
+    // The designated server, or the one catalog server whose name contains
+    // `mcp_server_name` (case-insensitive); more than one match is refused.
+    let (server_id, discovered) = match designated_server {
+        Some(id) => (id, None),
+        None => {
+            let needle = server_name.clone().unwrap_or_default().to_lowercase();
+            let matches: Vec<&Value> = v["servers"]
+                .as_array()
+                .map(|s| {
+                    s.iter()
+                        .filter(|s| {
+                            s["name"]
+                                .as_str()
+                                .is_some_and(|n| n.to_lowercase().contains(&needle))
+                        })
+                        .collect()
+                })
+                .unwrap_or_default();
+            match matches.as_slice() {
+                [only] => (
+                    only["id"].as_str().unwrap_or_default().to_owned(),
+                    Some(json!({"by": "mcp_server_name", "name": only["name"]})),
+                ),
+                other => {
+                    let names: Vec<Value> = v["servers"]
+                        .as_array()
+                        .map(|s| s.iter().map(|s| s["name"].clone()).collect())
+                        .unwrap_or_default();
+                    (
+                        String::new(),
+                        Some(json!({"by": "mcp_server_name", "matches": other.len(),
+                            "catalog_names": names})),
+                    )
+                }
+            }
+        }
+    };
+    let listed = !server_id.is_empty() && !server(&v, &server_id).is_null();
+    let mut found = Found::check(
+        v["state"] == "ready" && listed,
+        "the workspace's MCP catalog was read and lists the designated server (its upstream URL is never kept)",
+        "the catalog was not read or does not list exactly one designated server",
+    )
+    .with("state", v["state"].clone())
+    .with("servers", json!(v["servers"].as_array().map(Vec::len)));
+    if let Some(d) = discovered {
+        found = found.with("discovered", d);
+    }
+    if !server_id.is_empty() {
+        found = found.id("mcp_server_id", &server_id);
+    }
+    ctx.settle(DISCOVERY, started, inputs.clone(), found)?;
+    if !listed {
+        ctx.block(
+            &[SIGN_IN, SCOPE, REVOKE],
+            "the designated server is not in the catalog",
+        )?;
+        return Ok(FamilyResult {
+            outcomes: ctx.outcomes,
+            stop: ctx.stop,
+        });
+    }
+    // `operator_present = no`: the browser and console steps wait for a run
+    // with the operator; they are recorded blocked, never attempted.
+    if ctx.run.nonsecret("L17", "operator_present").as_deref() == Some("no") {
+        ctx.block(
+            &[SIGN_IN, SCOPE, REVOKE],
+            "the operator was not present for the sign-in; run L17 again with the operator",
+        )?;
+        return Ok(FamilyResult {
+            outcomes: ctx.outcomes,
+            stop: ctx.stop,
+        });
+    }
+
+    let started = now_utc();
+    let context = desk.context_text()?;
+    desk.send_json(
+        json!({"kind": "signInMcpServer", "context": context, "workspace": reference,
+        "server": server_id}),
+    )
+    .await?;
+    let bound = ctx.run.operator_timeout("L17");
+    let (done, step) = {
+        let desk = &desk;
+        let id = server_id.clone();
+        operator_step(
+            ctx.run.operator.as_ref(),
+            "mcp-sign-in",
+            "authorize the desktop for the designated MCP server with the designated test identity",
+            None,
+            bound,
+            async || {
+                desk.json()
+                    .map(|j| server(&view(&j), &id)["signedIn"] == true)
+                    .unwrap_or(false)
+            },
+        )
+        .await
+    };
+    let mut found = Found::check(
+        done,
+        "the operator authorized the server; the desktop exchanged its own code and holds the grant (memory and v2 Keychain only)",
+        "the MCP sign-in was not completed within the bound",
+    );
+    found.operator_step = Some(step);
+    ctx.settle(SIGN_IN, started, inputs.clone(), found)?;
+    if !done {
+        ctx.block(&[SCOPE, REVOKE], "the server was not signed in")?;
+        return Ok(FamilyResult {
+            outcomes: ctx.outcomes,
+            stop: ctx.stop,
+        });
+    }
+
+    let started = now_utc();
+    let found = if ctx.run.nonsecret("L17", "scope_change").as_deref() != Some("designated") {
+        Found::blocked("L17 designates no scope_change the operator can make")
+    } else {
+        let bound = ctx.run.operator_timeout("L17");
+        let (done, step) = {
+            let desk = &mut desk;
+            let id = server_id.clone();
+            let reference = reference.clone();
+            operator_step(
+                ctx.run.operator.as_ref(),
+                "mcp-scope-change",
+                "change the designated MCP server's scope or grant in the Gateway now",
+                None,
+                bound,
+                async || {
+                    tokio::time::sleep(Duration::from_secs(2)).await;
+                    match list(desk, &reference).await {
+                        Ok(v) => {
+                            let s = server(&v, &id);
+                            s["stale"] == true || s["signedIn"] == false
+                        }
+                        Err(_) => false,
+                    }
+                },
+            )
+            .await
+        };
+        let mut found = Found::check(
+            done,
+            "after the operator's change, the catalog showed the sign-in stale and it no longer counted",
+            "the changed scope or grant was not noticed",
+        );
+        found.operator_step = Some(step);
+        found
+    };
+    ctx.settle(SCOPE, started, inputs.clone(), found)?;
+
+    let started = now_utc();
+    let context = desk.context_text()?;
+    desk.send_json(
+        json!({"kind": "signOutMcpServer", "context": context, "workspace": reference,
+        "server": server_id}),
+    )
+    .await?;
+    let out = desk
+        .until(desk.settle, |j| {
+            server(&view(j), &server_id)["signedIn"] == false
+        })
+        .await
+        .is_some();
+    let mut found = Found::check(
+        out,
+        "signed out: the desktop revoked the tokens and deleted their item",
+        "the sign-out did not take effect",
+    );
+    found.cleanup = "the grant was revoked".to_owned();
+    ctx.settle(REVOKE, started, inputs, found)?;
+    Ok(FamilyResult {
+        outcomes: ctx.outcomes,
+        stop: ctx.stop,
+    })
+}
diff --git a/crates/xtask/src/live_reads.rs b/crates/xtask/src/live_reads.rs
new file mode 100644
index 00000000..a7564c2e
--- /dev/null
+++ b/crates/xtask/src/live_reads.rs
@@ -0,0 +1,1235 @@
+//! Read-only families (C25) through the production `management` intent:
+//! L02 management identity and inventories, L05 sessions, L06 Red Team and
+//! Model/skill observations, L07 Gateway reads and L10 operational
+//! observation. Each family signs in with its own designated management
+//! OAuth client (session-only); receipts record result shapes and sanitized
+//! identifiers, never item content.
+
+use std::collections::BTreeMap;
+
+use desktop_core::management::{DetailFound, ManagementFailure, ManagementResult};
+use serde_json::{Value, json};
+
+use crate::live_run::{DeskOptions, FamilyResult, Found, Outcomes, Run, Spec, summarize};
+use crate::{Result, now_utc};
+
+const INVENTORIES: [&str; 10] = [
+    "profiles",
+    "topics",
+    "applications",
+    "apiKeys",
+    "deploymentProfiles",
+    "dlpCatalog",
+    "dataProfiles",
+    "dataPatterns",
+    "filteringProfiles",
+    "dictionaries",
+];
+
+const GATEWAY_SCOPED: [&str; 5] = [
+    "providers",
+    "routes",
+    "guardrails",
+    "serviceKeys",
+    "userKeys",
+];
+
+fn page_items(result: &ManagementResult) -> Vec<Value> {
+    match result {
+        ManagementResult::Page { page } => serde_json::from_str(&page.items).unwrap_or_default(),
+        _ => Vec::new(),
+    }
+}
+
+fn id_of(item: &Value, field: &str) -> Option<String> {
+    item.get(field).and_then(|v| match v {
+        Value::String(s) => Some(s.clone()),
+        Value::Number(n) => Some(n.to_string()),
+        _ => None,
+    })
+}
+
+fn ok(result: &ManagementResult) -> bool {
+    !matches!(result, ManagementResult::Failed { .. })
+}
+
+fn denied(result: &ManagementResult) -> bool {
+    matches!(
+        result,
+        ManagementResult::Failed {
+            failure: ManagementFailure::Denied,
+            ..
+        }
+    )
+}
+
+/// Runs `reads` on the desk and records one check from their summaries;
+/// passes when every read succeeded.
+async fn reads(
+    desk: &mut crate::live_run::Desk,
+    requests: Vec<(String, Value)>,
+) -> Result<(bool, Vec<(String, ManagementResult)>, Value)> {
+    let mut all = true;
+    let mut results = Vec::new();
+    let mut shown = serde_json::Map::new();
+    for (label, request) in requests {
+        let result = desk.read(request).await?;
+        all &= ok(&result);
+        shown.insert(label.clone(), summarize(&result));
+        results.push((label, result));
+    }
+    Ok((all, results, Value::Object(shown)))
+}
+
+struct Ctx<'r, 'a> {
+    run: &'r mut Run<'a>,
+    id: String,
+    outcomes: Outcomes,
+    stop: Option<crate::live_run::Stop>,
+}
+
+impl Ctx<'_, '_> {
+    fn record(
+        &mut self,
+        spec: Spec,
+        started: String,
+        inputs: BTreeMap<String, Value>,
+        found: Found,
+    ) -> Result<()> {
+        let stop = self.run.settle(
+            &self.id,
+            spec,
+            started,
+            inputs,
+            found,
+            None,
+            &mut self.outcomes,
+        )?;
+        if self.stop.is_none() {
+            self.stop = stop;
+        }
+        Ok(())
+    }
+
+    fn block_all(&mut self, specs: &[Spec], reason: &str) -> Result<()> {
+        for spec in specs {
+            self.record(*spec, now_utc(), BTreeMap::new(), Found::blocked(reason))?;
+        }
+        Ok(())
+    }
+}
+
+pub(crate) async fn run(run: &mut Run<'_>, id: &str) -> Result<FamilyResult> {
+    let mut ctx = Ctx {
+        run,
+        id: id.to_owned(),
+        outcomes: Vec::new(),
+        stop: None,
+    };
+    match id {
+        "L02" => l02(&mut ctx).await?,
+        "L05" => l05(&mut ctx).await?,
+        "L06" => l06(&mut ctx).await?,
+        "L07" => l07(&mut ctx).await?,
+        _ => l10(&mut ctx).await?,
+    }
+    Ok(FamilyResult {
+        outcomes: ctx.outcomes,
+        stop: ctx.stop,
+    })
+}
+
+const L02_VERIFY: Spec = Spec {
+    id: "L02-verify",
+    workflows: &["W02"],
+};
+const L02_INVENTORIES: Spec = Spec {
+    id: "L02-inventories",
+    workflows: &["W07", "W08", "W09", "W10", "W12"],
+};
+const L02_PAGINATION: Spec = Spec {
+    id: "L02-pagination",
+    workflows: &["W07"],
+};
+const L02_DETAIL: Spec = Spec {
+    id: "L02-detail",
+    workflows: &["W07"],
+};
+const L02_DENIED: Spec = Spec {
+    id: "L02-least-privilege-denied",
+    workflows: &["W02"],
+};
+
+async fn l02(ctx: &mut Ctx<'_, '_>) -> Result<()> {
+    let all = [L02_VERIFY, L02_INVENTORIES, L02_PAGINATION, L02_DETAIL];
+    let inputs = ctx.run.inputs("L02", &["client_secret"]);
+    let mut desk = match ctx
+        .run
+        .management_desk("L02", DeskOptions::default())
+        .await?
+    {
+        Ok(d) => d,
+        Err(e) => {
+            ctx.block_all(&all, &e)?;
+            ctx.block_all(&[L02_DENIED], &e)?;
+            return Ok(());
+        }
+    };
+    let started = now_utc();
+    let verify = desk.read(json!({"kind": "verify"})).await?;
+    let found = Found::check(
+        matches!(verify, ManagementResult::Verified),
+        "the management client was granted a token and read one profile",
+        "the management client could not be verified",
+    )
+    .with("verify", summarize(&verify))
+    .with("scan_key_used", json!(false));
+    ctx.record(L02_VERIFY, started, inputs.clone(), found)?;
+
+    let started = now_utc();
+    let requests = INVENTORIES
+        .iter()
+        .map(|r| {
+            (
+                (*r).to_owned(),
+                json!({"kind": "page", "resource": r, "offset": 0, "limit": 25}),
+            )
+        })
+        .collect();
+    let (all_ok, results, shown) = reads(&mut desk, requests).await?;
+    let found = Found::check(
+        all_ok,
+        "every supported Runtime and DLP inventory returned a page",
+        "an inventory could not be read",
+    )
+    .with("pages", shown);
+    ctx.record(L02_INVENTORIES, started, inputs.clone(), found)?;
+
+    let started = now_utc();
+    let first = desk
+        .read(json!({"kind": "page", "resource": "profiles", "offset": 0, "limit": 1}))
+        .await?;
+    let found = match &first {
+        ManagementResult::Page { page } => match page.next_offset {
+            Some(next) => {
+                let second = desk
+                    .read(
+                        json!({"kind": "page", "resource": "profiles", "offset": next, "limit": 1}),
+                    )
+                    .await?;
+                let a = page_items(&first)
+                    .first()
+                    .and_then(|i| id_of(i, "profile_id"));
+                let b = page_items(&second)
+                    .first()
+                    .and_then(|i| id_of(i, "profile_id"));
+                Found::check(
+                    ok(&second) && a.is_some() && a != b,
+                    "the second page continued where the first ended",
+                    "the second page did not advance",
+                )
+                .with("first", summarize(&first))
+                .with("second", summarize(&second))
+            }
+            None => Found::blocked(
+                "the profile inventory has a single page; pagination needs at least two profiles",
+            )
+            .with("first", summarize(&first)),
+        },
+        _ => Found::failed("the first profile page could not be read")
+            .with("first", summarize(&first)),
+    };
+    ctx.record(L02_PAGINATION, started, inputs.clone(), found)?;
+
+    let started = now_utc();
+    let target = results
+        .iter()
+        .find(|(r, _)| r == "profiles")
+        .and_then(|(_, res)| page_items(res).first().and_then(|i| id_of(i, "profile_id")));
+    let found = match target {
+        Some(target) => {
+            let detail = desk
+                .read(json!({"kind": "detail", "resource": "profiles", "id": target}))
+                .await?;
+            Found::check(
+                matches!(&detail, ManagementResult::Detail { detail } if detail.found == DetailFound::Found),
+                "the profile was found by its bounded inventory walk",
+                "the profile detail could not be read",
+            )
+            .with("detail", summarize(&detail))
+            .id("profile_id", &target)
+        }
+        None => Found::blocked("no profile is listed to read in detail"),
+    };
+    ctx.record(L02_DETAIL, started, inputs, found)?;
+    drop(desk);
+
+    // A designated, more restricted principal must be refused: a read of
+    // `restricted_denied_resource` when one is designated, otherwise a
+    // write (a read-only principal reads, so only its write can be denied).
+    match ctx.run.nonsecret("L02", "restricted_denied_resource") {
+        Some(resource) => l02_read_denied(ctx, &resource).await,
+        None => l02_write_denied(ctx).await,
+    }
+}
+
+async fn l02_read_denied(ctx: &mut Ctx<'_, '_>, resource: &str) -> Result<()> {
+    let started = now_utc();
+    let mut inputs = ctx.run.inputs("L02", &["restricted_client_secret"]);
+    inputs.insert("mode".to_owned(), json!("read"));
+    let found = match ctx
+        .run
+        .management_desk_as(
+            "L02",
+            "restricted_client_id",
+            "restricted_client_secret",
+            DeskOptions::default(),
+        )
+        .await?
+    {
+        Err(e) => Found::blocked(e),
+        Ok(mut desk) => {
+            let read = desk
+                .read(json!({"kind": "page", "resource": resource, "offset": 0, "limit": 1}))
+                .await?;
+            if ok(&read) {
+                Found::failed("unexpected authority: the restricted principal read the inventory")
+                    .with("read", summarize(&read))
+                    .stopping("unexpected authority", false)
+            } else {
+                Found::check(
+                    denied(&read),
+                    "the service denied the restricted principal; nothing was shown",
+                    "the read failed, but not as a permission denial",
+                )
+                .with("read", summarize(&read))
+            }
+        }
+    };
+    ctx.record(L02_DENIED, started, inputs, found)
+}
+
+/// A change failure that is the service refusing the principal.
+fn permission_denied(failure: &Value) -> bool {
+    failure["kind"] == "service"
+        && matches!(failure["failure"].as_str(), Some("denied" | "unauthorized"))
+}
+
+/// The topic named `name`, found by a bounded walk of the topic inventory:
+/// its ID when present, `Ok(None)` when the whole inventory was read
+/// without it, `Err` when the walk could not finish.
+async fn find_topic(
+    desk: &mut crate::live_run::Desk,
+    name: &str,
+) -> Result<std::result::Result<Option<String>, String>> {
+    let mut offset = 0u32;
+    for _ in 0..20 {
+        let page = desk
+            .read(json!({"kind": "page", "resource": "topics", "offset": offset, "limit": 50}))
+            .await?;
+        let ManagementResult::Page { page: listed } = &page else {
+            return Ok(Err("the topic inventory could not be read".to_owned()));
+        };
+        let items = page_items(&page);
+        if let Some(item) = items.iter().find(|t| t["topic_name"] == name) {
+            return Ok(Ok(id_of(item, "topic_id").or_else(|| Some(String::new()))));
+        }
+        match listed.next_offset {
+            Some(next) if !listed.complete && next > offset => offset = next,
+            _ if listed.complete || items.is_empty() => return Ok(Ok(None)),
+            _ => return Ok(Err("the topic inventory did not advance".to_owned())),
+        }
+    }
+    Ok(Err(
+        "the topic inventory is longer than the bounded walk".to_owned()
+    ))
+}
+
+/// The restricted principal attempts a reviewed create of a disposable
+/// topic through the production change path; the service must refuse it.
+/// The full principal then reads the topics back and deletes the topic if
+/// it exists after all, which stops the run as unexpected authority.
+async fn l02_write_denied(ctx: &mut Ctx<'_, '_>) -> Result<()> {
+    let started = now_utc();
+    let mut inputs = ctx.run.inputs("L02", &["restricted_client_secret"]);
+    inputs.insert("mode".to_owned(), json!("write"));
+    let Some(prefix) = ctx.run.prefix("L02").filter(|p| !p.is_empty()) else {
+        let found = Found::blocked(
+            "a write denial needs L02's disposable_prefix (or designate restricted_denied_resource for a read denial)",
+        );
+        return ctx.record(L02_DENIED, started, inputs, found);
+    };
+    let name = format!("{prefix}lp-{}", crate::random_hex(4)?);
+    if let Err(e) = crate::live_run::disposable(Some(&prefix), &name) {
+        return ctx.record(L02_DENIED, started, inputs, Found::blocked(e));
+    }
+    let body = json!({"topic_name": name, "description": "C25 least-privilege probe",
+        "examples": ["c25 synthetic example"]});
+    inputs.insert("kind".to_owned(), json!("topics"));
+    inputs.insert("action".to_owned(), json!("create"));
+    inputs.insert("body".to_owned(), body.clone());
+    let mut restricted = match ctx
+        .run
+        .management_desk_as(
+            "L02",
+            "restricted_client_id",
+            "restricted_client_secret",
+            DeskOptions::default(),
+        )
+        .await?
+    {
+        Ok(d) => d,
+        Err(e) => return ctx.record(L02_DENIED, started, inputs, Found::blocked(e)),
+    };
+    let draft = json!({"kind": "topics", "action": "create", "target": "",
+        "body": body.to_string()});
+    let applied = crate::live_changes::apply(&mut restricted, &draft).await?;
+    drop(restricted);
+    let (refused, outcome, failure) = match &applied {
+        crate::live_changes::Applied::Review(failure) => (
+            permission_denied(failure),
+            "review".to_owned(),
+            failure.clone(),
+        ),
+        crate::live_changes::Applied::Settled { result, .. } => (
+            result["outcome"] == "rejected" && permission_denied(&result["failure"]),
+            result["outcome"].as_str().unwrap_or("unknown").to_owned(),
+            result["failure"].clone(),
+        ),
+    };
+
+    // The full principal reads back whether the topic exists.
+    let mut full = match ctx
+        .run
+        .management_desk("L02", DeskOptions::default())
+        .await?
+    {
+        Ok(d) => d,
+        Err(e) => {
+            let found = Found::failed(format!(
+                "the full principal could not read back the probe topic: {e}"
+            ))
+            .with("outcome", json!(outcome))
+            .with("failure", failure)
+            .stopping("the probe's effect is not verified", true);
+            return ctx.record(L02_DENIED, started, inputs, found);
+        }
+    };
+    let mut found = match find_topic(&mut full, &name).await? {
+        Err(e) => Found::failed(format!("the probe's readback did not finish: {e}"))
+            .stopping("the probe's effect is not verified", true),
+        Ok(None) if refused => {
+            let mut f = Found::passed(
+                "the service refused the restricted principal's write; the full principal read the topics back and none was created",
+            );
+            f.readback = "absent".to_owned();
+            f
+        }
+        Ok(None) if outcome == "unknown" => {
+            let mut f = Found::failed(
+                "the restricted write's outcome is unknown; no topic was read back, so it is not shown to be refused",
+            )
+            .stopping("an uncertain outcome", true);
+            f.readback = "absent".to_owned();
+            f
+        }
+        Ok(None) => {
+            let mut f =
+                Found::failed("the write was not applied, but not refused as a permission denial");
+            f.readback = "absent".to_owned();
+            f
+        }
+        Ok(Some(id)) => {
+            // It exists: the restricted principal has write authority.
+            let mut cleanup =
+                "the probe topic exists but has no ID to delete; reconcile it".to_owned();
+            let mut reconcile = true;
+            if !id.is_empty() {
+                let delete = json!({"kind": "topics", "action": "delete", "target": id,
+                    "body": "{}"});
+                if let crate::live_changes::Applied::Settled { result, .. } =
+                    crate::live_changes::apply(&mut full, &delete).await?
+                    && result["outcome"] == "completed"
+                    && result["readback"] == "absent"
+                {
+                    cleanup = "deleted by the full principal and read back as absent".to_owned();
+                    reconcile = false;
+                } else {
+                    cleanup = "the full principal's delete did not settle as absent; reconcile it"
+                        .to_owned();
+                }
+            }
+            let mut f = Found::failed(
+                "unexpected authority: the restricted principal's write created the topic",
+            )
+            .id("created_id", &id)
+            .stopping("unexpected authority", reconcile);
+            f.readback = "found".to_owned();
+            f.cleanup = cleanup;
+            f
+        }
+    };
+    found = found
+        .with("outcome", json!(outcome))
+        .with("failure", failure)
+        .with("probe_name", json!(name));
+    if found.cleanup == "nothing created" {
+        found.cleanup = "nothing was created; the full principal read the topics back".to_owned();
+    }
+    drop(full);
+    ctx.record(L02_DENIED, started, inputs, found)
+}
+
+const L05_INVENTORY: Spec = Spec {
+    id: "L05-inventory",
+    workflows: &["W17"],
+};
+const L05_SESSION: Spec = Spec {
+    id: "L05-session-detail",
+    workflows: &["W17"],
+};
+const L05_SEARCH: Spec = Spec {
+    id: "L05-search",
+    workflows: &["W18"],
+};
+const L05_CONTENT: Spec = Spec {
+    id: "L05-content-reveal",
+    workflows: &["W19"],
+};
+
+async fn l05(ctx: &mut Ctx<'_, '_>) -> Result<()> {
+    let all = [L05_INVENTORY, L05_SESSION, L05_SEARCH, L05_CONTENT];
+    let inputs = ctx.run.inputs("L05", &["client_secret"]);
+    let mut desk = match ctx
+        .run
+        .management_desk("L05", DeskOptions::default())
+        .await?
+    {
+        Ok(d) => d,
+        Err(e) => return ctx.block_all(&all, &e),
+    };
+    let started = now_utc();
+    let page = desk
+        .read(json!({"kind": "page", "resource": "sessions", "offset": 0, "limit": 25}))
+        .await?;
+    let found = Found::check(
+        ok(&page),
+        "the 24-hour sessions inventory returned a page with its completeness",
+        "the sessions inventory could not be read",
+    )
+    .with("page", summarize(&page));
+    ctx.record(L05_INVENTORY, started, inputs.clone(), found)?;
+
+    // Only a synthetic session is opened (never another customer's
+    // content): the designated one, or else the newest session of the app
+    // name L01's synthetic scans carry.
+    let designated = (
+        ctx.run.nonsecret("L05", "session_id"),
+        ctx.run.nonsecret("L05", "session_app_id"),
+        ctx.run.nonsecret("L05", "session_app_name"),
+    );
+    let (session, app_id, app_name, discovered) = match designated {
+        (Some(session), Some(app_id), Some(app_name)) => (session, app_id, app_name, None),
+        _ => match discover_session(ctx, &mut desk).await? {
+            Ok((session, app_id, app_name, how)) => (session, app_id, app_name, Some(how)),
+            Err(reason) => {
+                return ctx.block_all(&[L05_SESSION, L05_SEARCH, L05_CONTENT], &reason);
+            }
+        },
+    };
+    let started = now_utc();
+    let detail = desk
+        .read(
+            json!({"kind": "session", "sessionId": session, "appId": app_id, "appName": app_name}),
+        )
+        .await?;
+    let which = if discovered.is_some() {
+        "discovered synthetic"
+    } else {
+        "designated"
+    };
+    let mut found = Found::check(
+        matches!(detail, ManagementResult::Session { .. }),
+        format!("the {which} session's actions were read"),
+        format!("the {which} session could not be read"),
+    )
+    .with("session", summarize(&detail))
+    .id("session_id", &session);
+    if let Some(how) = &discovered {
+        found = found.with("discovered", how.clone());
+    }
+    // The scan to open: the designated one, except that a discovered
+    // session uses one of its own scans when the designated one is not in
+    // it.
+    let actions: Vec<String> = match &detail {
+        ManagementResult::Session { session } => serde_json::from_str::<Value>(&session.session)
+            .ok()
+            .and_then(|v| v["session_actions"].as_array().cloned())
+            .unwrap_or_default()
+            .iter()
+            .filter_map(|a| id_of(a, "scan_id"))
+            .collect(),
+        _ => Vec::new(),
+    };
+    let designated_scan = ctx.run.nonsecret("L05", "scan_id");
+    let scan_target = match (&discovered, designated_scan) {
+        (None, scan) => scan,
+        (Some(_), Some(scan)) if actions.contains(&scan) => Some(scan),
+        (Some(_), _) => actions.first().cloned(),
+    };
+    if let Some(scan) = scan_target.clone() {
+        let tx = desk
+            .read(
+                json!({"kind": "transaction", "sessionId": session, "appId": app_id,
+                "appName": app_name, "scanId": scan, "subRequest": 0}),
+            )
+            .await?;
+        if !matches!(tx, ManagementResult::Transaction { .. }) {
+            found = Found::failed("the designated transaction's metadata could not be read")
+                .id("session_id", &session);
+        }
+        found = found
+            .with("transaction", summarize(&tx))
+            .id("scan_id", &scan);
+    }
+    ctx.record(L05_SESSION, started, inputs.clone(), found)?;
+
+    // The app searches by scan ID (a UUID), by a `ses…` session ID or by
+    // detector name (v1); AIRS session IDs are the caller's trace IDs, so
+    // the session's own scan is the query.
+    let started = now_utc();
+    let found = match scan_target.clone() {
+        None => Found::blocked("the session lists no scan to search for"),
+        Some(scan) => match desk.read(json!({"kind": "search", "query": scan})).await {
+            Err(e) => Found::failed(format!("the search was refused: {e}")).id("scan_id", &scan),
+            Ok(search) => Found::check(
+                matches!(search, ManagementResult::Search { .. }),
+                "the bounded search by the session's scan ID completed and states its completeness",
+                "the search failed",
+            )
+            .with("search", summarize(&search))
+            .id("scan_id", &scan),
+        },
+    };
+    ctx.record(L05_SEARCH, started, inputs.clone(), found)?;
+
+    let started = now_utc();
+    let found = match (
+        scan_target,
+        ctx.run.nonsecret("L05", "reveal_content").as_deref(),
+    ) {
+        (Some(scan), Some("synthetic")) => {
+            let content = desk
+                .read(json!({"kind": "content", "scanId": scan, "subRequest": 0}))
+                .await?;
+            let lengths = match &content {
+                ManagementResult::Content { content } => serde_json::to_value(content)
+                    .ok()
+                    .map(|v| {
+                        json!({
+                            "prompt_chars": v["prompt"].as_str().map(str::len),
+                            "response_chars": v["response"].as_str().map(str::len),
+                        })
+                    })
+                    .unwrap_or(Value::Null),
+                _ => Value::Null,
+            };
+            Found::check(
+                matches!(content, ManagementResult::Content { .. }),
+                "the synthetic scan's content was revealed on explicit request (only its length is recorded)",
+                "the content could not be revealed",
+            )
+            .with("content", summarize(&content))
+            .with("lengths", lengths)
+        }
+        _ => Found::blocked(
+            "content is revealed only for a synthetic scan when reveal_content = synthetic",
+        ),
+    };
+    ctx.record(L05_CONTENT, started, inputs, found)?;
+    Ok(())
+}
+
+/// The timestamp fields a session row may carry, most telling first.
+const SESSION_TIMES: [&str; 7] = [
+    "last_seen",
+    "last_updated",
+    "updated_at",
+    "end_time",
+    "start_time",
+    "created_at",
+    "timestamp",
+];
+
+/// Pages of the sessions inventory walked to find a synthetic session.
+const SESSION_PAGES: u32 = 8;
+
+/// The newest session whose application name is the one L01's synthetic
+/// scans carry: its session ID, application ID and name, and how it was
+/// chosen. Sessions of any other application are never chosen.
+async fn discover_session(
+    ctx: &mut Ctx<'_, '_>,
+    desk: &mut crate::live_run::Desk,
+) -> Result<std::result::Result<(String, String, String, Value), String>> {
+    let Some(app) = ctx.run.nonsecret("L01", "app_name") else {
+        return Ok(Err(
+            "L05 designates no synthetic session, and L01 names no app_name to discover one by"
+                .to_owned(),
+        ));
+    };
+    let mut matches = Vec::new();
+    let mut offset = 0u32;
+    let mut walked = 0u32;
+    while walked < SESSION_PAGES {
+        walked += 1;
+        let page = desk
+            .read(json!({"kind": "page", "resource": "sessions", "offset": offset, "limit": 50}))
+            .await?;
+        let ManagementResult::Page { page: listed } = &page else {
+            return Ok(Err("the sessions inventory could not be walked".to_owned()));
+        };
+        let items = page_items(&page);
+        matches.extend(
+            items
+                .iter()
+                .filter(|s| s["application_name"] == app.as_str())
+                .cloned(),
+        );
+        match listed.next_offset {
+            Some(next) if !listed.complete && next > offset && !items.is_empty() => offset = next,
+            _ => break,
+        }
+    }
+    if matches.is_empty() {
+        return Ok(Err(format!(
+            "L05 designates no synthetic session and none of application {app} is in the last 24 hours ({walked} page(s) walked)"
+        )));
+    }
+    let field = SESSION_TIMES
+        .iter()
+        .find(|f| matches.iter().all(|m| m[**f].is_string()));
+    let chosen = match field {
+        Some(f) => matches
+            .iter()
+            .max_by(|a, b| a[*f].as_str().cmp(&b[*f].as_str()))
+            .cloned(),
+        None => matches.first().cloned(),
+    }
+    .unwrap_or(Value::Null);
+    let (Some(session), Some(app_id)) = (
+        id_of(&chosen, "session_id"),
+        id_of(&chosen, "application_id").or_else(|| id_of(&chosen, "app_id")),
+    ) else {
+        return Ok(Err(format!(
+            "the newest session of application {app} names no session or application ID"
+        )));
+    };
+    let how = json!({
+        "by": "app_name",
+        "app_name": app,
+        "candidates": matches.len(),
+        "chosen_by": field.map_or("first in the service's order".to_owned(), |f| format!("newest {f}")),
+    });
+    Ok(Ok((session, app_id, app, how)))
+}
+
+const L06_RED_TEAM: Spec = Spec {
+    id: "L06-red-team",
+    workflows: &["W23"],
+};
+const L06_SUPPLY: Spec = Spec {
+    id: "L06-model-and-skills",
+    workflows: &["W24"],
+};
+const L06_ATTACKS: Spec = Spec {
+    id: "L06-attack-report",
+    workflows: &["W23"],
+};
+
+async fn l06(ctx: &mut Ctx<'_, '_>) -> Result<()> {
+    let all = [L06_RED_TEAM, L06_SUPPLY, L06_ATTACKS];
+    let inputs = ctx.run.inputs("L06", &["client_secret"]);
+    let mut desk = match ctx
+        .run
+        .management_desk("L06", DeskOptions::default())
+        .await?
+    {
+        Ok(d) => d,
+        Err(e) => return ctx.block_all(&all, &e),
+    };
+    let started = now_utc();
+    let red = desk.read(json!({"kind": "redTeam", "window": 30})).await?;
+    let found = Found::check(
+        matches!(red, ManagementResult::RedTeam { .. }),
+        "existing Red Teaming statistics and scans were read (no scan was started)",
+        "the Red Teaming observation could not be read",
+    )
+    .with("red_team", summarize(&red));
+    ctx.record(L06_RED_TEAM, started, inputs.clone(), found)?;
+
+    let started = now_utc();
+    let supply = desk.read(json!({"kind": "supplyChain"})).await?;
+    let found = Found::check(
+        matches!(supply, ManagementResult::SupplyChain { .. }),
+        "existing Model Security scans and skill statistics were read, with partial sources disclosed",
+        "the Model/skill observation could not be read",
+    )
+    .with("supply_chain", summarize(&supply));
+    ctx.record(L06_SUPPLY, started, inputs.clone(), found)?;
+
+    let started = now_utc();
+    // The attack report's scan: the designated one, or else the newest
+    // completed scan the read-only list shows (no scan is ever started).
+    let designated = ctx.run.nonsecret("L06", "red_team_scan_id");
+    let discovered = match (&designated, &red) {
+        (None, ManagementResult::RedTeam { observation }) => observation
+            .scans
+            .as_ref()
+            .and_then(|scans| {
+                scans
+                    .rows
+                    .iter()
+                    .filter(|r| {
+                        r.status
+                            .as_deref()
+                            .is_some_and(|s| s.eq_ignore_ascii_case("completed"))
+                    })
+                    .max_by(|a, b| a.created_at.cmp(&b.created_at))
+            })
+            .map(|r| r.id.clone()),
+        _ => None,
+    };
+    let found = match designated.or_else(|| discovered.clone()) {
+        Some(scan) => {
+            let attacks = desk
+                .read(json!({"kind": "attacks", "scanId": scan, "page": 0, "received": 0}))
+                .await?;
+            let mut f = Found::check(
+                matches!(attacks, ManagementResult::Attacks { .. }),
+                "the scan's first attack page was read with its completeness",
+                "the attack report could not be read",
+            )
+            .with("attacks", summarize(&attacks))
+            .id("red_team_scan_id", &scan);
+            if discovered.is_some() {
+                f = f.with(
+                    "discovered",
+                    json!({"by": "newest completed scan in the read-only list"}),
+                );
+            }
+            f
+        }
+        None => Found::blocked(
+            "L06 designates no red_team_scan_id and the read-only list shows no completed scan",
+        ),
+    };
+    ctx.record(L06_ATTACKS, started, inputs, found)?;
+    Ok(())
+}
+
+const L07_WORKSPACES: Spec = Spec {
+    id: "L07-workspaces",
+    workflows: &["W34"],
+};
+const L07_INVENTORIES: Spec = Spec {
+    id: "L07-inventories",
+    workflows: &["W35"],
+};
+const L07_PREREQUISITES: Spec = Spec {
+    id: "L07-prerequisites",
+    workflows: &["W36"],
+};
+const L07_DENIED: Spec = Spec {
+    id: "L07-least-privilege-denied",
+    workflows: &["W34"],
+};
+
+async fn l07(ctx: &mut Ctx<'_, '_>) -> Result<()> {
+    let all = [L07_WORKSPACES, L07_INVENTORIES, L07_PREREQUISITES];
+    let inputs = ctx.run.inputs("L07", &["client_secret"]);
+    let Some(workspace) = ctx.run.nonsecret("L07", "workspace_id") else {
+        ctx.block_all(&all, "L07 designates no workspace_id")?;
+        return l07_denied(ctx).await;
+    };
+    let mut desk = match ctx
+        .run
+        .management_desk("L07", DeskOptions::default())
+        .await?
+    {
+        Ok(d) => d,
+        Err(e) => {
+            ctx.block_all(&all, &e)?;
+            return l07_denied(ctx).await;
+        }
+    };
+    let started = now_utc();
+    let found = match desk.select_workspace(&workspace).await {
+        Ok(_) => Found::passed("the designated workspace was listed and selected natively")
+            .id("workspace_id", &workspace),
+        Err(e) => Found::failed(e.to_string()),
+    };
+    let selected = found.outcome == "passed";
+    ctx.record(L07_WORKSPACES, started, inputs.clone(), found)?;
+    if !selected {
+        ctx.block_all(
+            &[L07_INVENTORIES, L07_PREREQUISITES],
+            "the designated workspace could not be selected",
+        )?;
+        return l07_denied(ctx).await;
+    }
+    let reference = desk.workspace_ref();
+    let started = now_utc();
+    let mut requests: Vec<(String, Value)> = GATEWAY_SCOPED
+        .iter()
+        .map(|r| {
+            (
+                (*r).to_owned(),
+                json!({"kind": "gateway", "workspace": reference,
+                       "read": {"kind": "inventory", "resource": r}}),
+            )
+        })
+        .collect();
+    requests.push((
+        "integrations".to_owned(),
+        json!({"kind": "gateway", "workspace": null,
+               "read": {"kind": "inventory", "resource": "integrations"}}),
+    ));
+    let (all_ok, _, shown) = reads(&mut desk, requests).await?;
+    let found = Found::check(
+        all_ok,
+        "every Gateway inventory of the selected workspace, and the tenant's integrations, was read",
+        "a Gateway inventory could not be read",
+    )
+    .with("inventories", shown);
+    ctx.record(L07_INVENTORIES, started, inputs.clone(), found)?;
+
+    let started = now_utc();
+    let pre = desk
+        .read(json!({"kind": "gateway", "workspace": reference, "read": {"kind": "prerequisites"}}))
+        .await?;
+    let found = Found::check(
+        ok(&pre),
+        "the routing, provider, key and IAM prerequisites were read for the selected workspace",
+        "the prerequisites could not be read",
+    )
+    .with("prerequisites", summarize(&pre));
+    ctx.record(L07_PREREQUISITES, started, inputs, found)?;
+    drop(desk);
+    l07_denied(ctx).await
+}
+
+/// The first object anywhere in `value` whose `name` is `name`.
+fn named<'a>(value: &'a Value, name: &str) -> Option<&'a Value> {
+    match value {
+        Value::Object(map) => {
+            if map.get("name").and_then(Value::as_str) == Some(name) {
+                return Some(value);
+            }
+            map.values().find_map(|v| named(v, name))
+        }
+        Value::Array(items) => items.iter().find_map(|v| named(v, name)),
+        _ => None,
+    }
+}
+
+/// Whether the selected workspace lists a service key named `name`.
+async fn find_service_key(
+    desk: &mut crate::live_run::Desk,
+    name: &str,
+) -> Result<std::result::Result<Option<String>, String>> {
+    let reference = desk.workspace_ref();
+    let read = desk
+        .read(json!({"kind": "gateway", "workspace": reference,
+            "read": {"kind": "inventory", "resource": "serviceKeys"}}))
+        .await?;
+    // The list's rows are a JSON array carried as text.
+    let ManagementResult::Gateway {
+        gateway: desktop_core::gateway::GatewayResult::List { list },
+    } = &read
+    else {
+        return Ok(Err("the service key inventory could not be read".to_owned()));
+    };
+    let Ok(rows) = serde_json::from_str::<Value>(&list.rows) else {
+        return Ok(Err(
+            "the service key inventory's rows could not be parsed".to_owned()
+        ));
+    };
+    if let Some(key) = named(&rows, name) {
+        return Ok(Ok(Some(id_of(key, "id").unwrap_or_default())));
+    }
+    if !list.complete {
+        return Ok(Err("the service key inventory is incomplete".to_owned()));
+    }
+    Ok(Ok(None))
+}
+
+/// The restricted principal attempts a reviewed create of a disposable
+/// service key in the designated workspace; the service must refuse it.
+/// A read-only principal may list workspaces, so its least privilege is
+/// shown by a refused write (as for L02). The full principal then reads
+/// the keys back and deletes the probe if it exists after all, which stops
+/// the run as unexpected authority. A designated
+/// `restricted_denied_resource` keeps the read-denial mode.
+async fn l07_denied(ctx: &mut Ctx<'_, '_>) -> Result<()> {
+    if ctx
+        .run
+        .nonsecret("L07", "restricted_denied_resource")
+        .is_some()
+    {
+        return l07_read_denied(ctx).await;
+    }
+    let started = now_utc();
+    let mut inputs = ctx.run.inputs("L07", &["restricted_client_secret"]);
+    inputs.insert("mode".to_owned(), json!("write"));
+    let Some(prefix) = ctx.run.prefix("L07").filter(|p| !p.is_empty()) else {
+        let found = Found::blocked(
+            "a write denial needs L07's disposable_prefix (or designate restricted_denied_resource for a read denial)",
+        );
+        return ctx.record(L07_DENIED, started, inputs, found);
+    };
+    let Some(workspace) = ctx.run.nonsecret("L07", "workspace_id") else {
+        return ctx.record(
+            L07_DENIED,
+            started,
+            inputs,
+            Found::blocked("L07 names no workspace_id"),
+        );
+    };
+    let name = format!("{prefix}lp-{}", crate::random_hex(4)?);
+    if let Err(e) = crate::live_run::disposable(Some(&prefix), &name) {
+        return ctx.record(L07_DENIED, started, inputs, Found::blocked(e));
+    }
+    let body = json!({"name": name, "scopes": ["completions.write"], "type": "service"});
+    inputs.insert("kind".to_owned(), json!("gatewayServiceKeys"));
+    inputs.insert("action".to_owned(), json!("create"));
+    inputs.insert("body".to_owned(), body.clone());
+    let mut restricted = match ctx
+        .run
+        .management_desk_as(
+            "L07",
+            "restricted_client_id",
+            "restricted_client_secret",
+            DeskOptions::default(),
+        )
+        .await?
+    {
+        Ok(d) => d,
+        Err(e) => return ctx.record(L07_DENIED, started, inputs, Found::blocked(e)),
+    };
+    if restricted.select_workspace(&workspace).await.is_err() {
+        let found = Found::blocked("the restricted principal could not select the workspace");
+        return ctx.record(L07_DENIED, started, inputs, found);
+    }
+    let mut draft = json!({"kind": "gatewayServiceKeys", "action": "create", "target": "",
+        "body": body.to_string()});
+    draft["workspace"] = json!(restricted.workspace_ref());
+    let applied = crate::live_changes::apply(&mut restricted, &draft).await?;
+    drop(restricted);
+    let (refused, outcome, failure) = match &applied {
+        crate::live_changes::Applied::Review(failure) => (
+            permission_denied(failure),
+            "review".to_owned(),
+            failure.clone(),
+        ),
+        crate::live_changes::Applied::Settled { result, .. } => (
+            result["outcome"] == "rejected" && permission_denied(&result["failure"]),
+            result["outcome"].as_str().unwrap_or("unknown").to_owned(),
+            result["failure"].clone(),
+        ),
+    };
+    let mut full = match ctx
+        .run
+        .management_desk("L07", DeskOptions::default())
+        .await?
+    {
+        Ok(d) => d,
+        Err(e) => {
+            let found = Found::failed(format!(
+                "the full principal could not read back the probe key: {e}"
+            ))
+            .with("outcome", json!(outcome))
+            .with("failure", failure)
+            .stopping("the probe's effect is not verified", true);
+            return ctx.record(L07_DENIED, started, inputs, found);
+        }
+    };
+    if full.select_workspace(&workspace).await.is_err() {
+        let found = Found::failed("the full principal could not select the workspace to read back")
+            .with("outcome", json!(outcome))
+            .stopping("the probe's effect is not verified", true);
+        return ctx.record(L07_DENIED, started, inputs, found);
+    }
+    let mut found = match find_service_key(&mut full, &name).await? {
+        Err(e) => Found::failed(format!("the probe's readback did not finish: {e}"))
+            .stopping("the probe's effect is not verified", true),
+        Ok(None) if refused => {
+            let mut f = Found::passed(
+                "the service refused the restricted principal's write; the full principal read the service keys back and none was created",
+            );
+            f.readback = "absent".to_owned();
+            f
+        }
+        Ok(None) if outcome == "unknown" => {
+            let mut f = Found::failed(
+                "the restricted write's outcome is unknown; no key was read back, so it is not shown to be refused",
+            )
+            .stopping("an uncertain outcome", true);
+            f.readback = "absent".to_owned();
+            f
+        }
+        Ok(None) => {
+            let mut f =
+                Found::failed("the write was not applied, but not refused as a permission denial");
+            f.readback = "absent".to_owned();
+            f
+        }
+        Ok(Some(id)) => {
+            let mut cleanup =
+                "the probe key exists but has no ID to delete; reconcile it".to_owned();
+            let mut reconcile = true;
+            if !id.is_empty() {
+                let mut delete = json!({"kind": "gatewayServiceKeys", "action": "delete",
+                    "target": id, "body": "{}"});
+                delete["workspace"] = json!(full.workspace_ref());
+                if let crate::live_changes::Applied::Settled { result, .. } =
+                    crate::live_changes::apply(&mut full, &delete).await?
+                    && result["outcome"] == "completed"
+                    && result["readback"] == "absent"
+                {
+                    cleanup = "deleted by the full principal and read back as absent".to_owned();
+                    reconcile = false;
+                } else {
+                    cleanup = "the full principal's delete did not settle as absent; reconcile it"
+                        .to_owned();
+                }
+            }
+            let mut f = Found::failed(
+                "unexpected authority: the restricted principal's write created the service key",
+            )
+            .id("created_id", &id)
+            .stopping("unexpected authority", reconcile);
+            f.readback = "found".to_owned();
+            f.cleanup = cleanup;
+            f
+        }
+    };
+    found = found
+        .with("outcome", json!(outcome))
+        .with("failure", failure)
+        .with("probe_name", json!(name));
+    ctx.record(L07_DENIED, started, inputs, found)
+}
+
+async fn l07_read_denied(ctx: &mut Ctx<'_, '_>) -> Result<()> {
+    let started = now_utc();
+    let inputs = ctx.run.inputs("L07", &["restricted_client_secret"]);
+    let found = match ctx
+        .run
+        .management_desk_as(
+            "L07",
+            "restricted_client_id",
+            "restricted_client_secret",
+            DeskOptions::default(),
+        )
+        .await?
+    {
+        Err(e) => Found::blocked(e),
+        Ok(mut desk) => {
+            let read = desk
+                .read(json!({"kind": "gateway", "workspace": null,
+                    "read": {"kind": "inventory", "resource": "workspaces"}}))
+                .await?;
+            if ok(&read) {
+                Found::failed(
+                    "unexpected authority: the restricted principal listed the workspaces",
+                )
+                .with("read", summarize(&read))
+                .stopping("unexpected authority", false)
+            } else {
+                Found::check(
+                    denied(&read),
+                    "the service denied the restricted principal",
+                    "the read failed, but not as a permission denial",
+                )
+                .with("read", summarize(&read))
+            }
+        }
+    };
+    ctx.record(L07_DENIED, started, inputs, found)
+}
