+pub fn scratch() -> PathBuf {
+    let dir = std::env::temp_dir().join(format!(
+        "airs-v2-live-run-{}-{}",
+        std::process::id(),
+        NEXT.fetch_add(1, Ordering::SeqCst)
+    ));
+    std::fs::create_dir_all(&dir).expect("scratch");
+    dir
