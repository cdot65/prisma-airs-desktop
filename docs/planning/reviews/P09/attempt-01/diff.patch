+    let snap = snapshot(&h, 20);
+    assert_eq!(
+        snap["tenants"].as_array().map(Vec::len),
+        Some(0),
+        "a draft is not a tenant"
+    );
+    assert!(snap["active"].is_null());
+    let setup = &snap["setup"];
+    assert_eq!(setup["mode"], "add");
