+            initial.dropped_procedure = Some(procedure);
+        }
+        let (family, program, permitted, check) = match procedure {
+            "exam.start" => (
+                "L13",
+                scope("https://localhost")["families"]["L13"]["nonsecret"].clone(),
+                vec!["exam.start", "settings.removeAvatar"],
