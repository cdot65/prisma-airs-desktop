+/*
+ * UI v2 "Refined Native" tokens (docs/architecture/ui-v2/tokens.md, C28).
+ * The only place a v2 colour, size or rhythm value lives. Light values on
+ * :root; dark values follow the shared theme attribute the desktop already
+ * sets (`data-theme="gruvbox"` is the dark general theme, `paper` the light
+ * one). Academy's --academy-* variables are untouched: the embedded learner
+ * view keeps them.
+ */
+:root {
+    --v2-bg: #f6f2e9;
+    --v2-side: #ebe5d8;
+    --v2-paper: #fbf8f1;
+    --v2-inset: #efe9dd;
+    --v2-rule: #e0d9ca;
+    --v2-ctl: #857d6e;
+    --v2-ink: #14141a;
+    --v2-soft: #4a463c;
+    --v2-faint: #635d50;
+    --v2-acc: #a33d15;
+    --v2-acc-ink: #ffffff;
+    --v2-acc-soft: #f4dfd3;
+    --v2-block: #b42318;
+    --v2-block-bg: #fbe4e1;
+    --v2-flag: #8a5300;
+    --v2-flag-bg: #faeed5;
+    --v2-ok: #1f6f3a;
+    --v2-ok-bg: #def0e3;
+    --v2-sel: var(--v2-acc);
+    --v2-sel-ink: var(--v2-acc-ink);
+    --v2-get: #245e8f;
+
+    --v2-page-top: 32px;
+    --v2-page-x: 44px;
+    --v2-title: 26px;
+    --v2-card-pad: 20px;
+    /* Grid and card gaps (the prototype's 16–20px; 12px is only inside rows). */
+    --v2-gap: 16px;
+    --v2-gap-row: 12px;
+    /* The prototype's base text is 13px; 14px is the subtitle size. */
+    --v2-text: 13px;
+    --v2-text-1: 14px;
+    --v2-text-2: 12px;
+    --v2-h2: 13px;
+    --v2-control: 32px;
+    --v2-radius-control: 7px;
+    --v2-radius-card: 12px;
+    --v2-rail: 244px;
+    --v2-header: 56px;
+    --v2-reading: 860px;
+    /* Overlay widths (R2App): tenant menu, palette, review sheet, detail sheet, dialogs. */
+    --v2-menu: 360px;
+    --v2-palette: 640px;
+    --v2-sheet: 620px;
+    --v2-detail: 520px;
+    --v2-dialog: 560px;
+    --v2-scrim: rgba(0, 0, 0, 0.22);
+    --v2-scrim-deep: rgba(0, 0, 0, 0.34);
+}
+
+:root[data-theme='gruvbox'] {
+    --v2-bg: #1d2021;
+    --v2-side: #161919;
+    --v2-paper: #282828;
+    --v2-inset: #32302f;
+    --v2-rule: #3c3836;
