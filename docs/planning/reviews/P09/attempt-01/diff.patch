+NATIVE = os.path.join(EVIDENCE, "native" if SUBJECT == "C37" else "native-C37")
+RECORD = os.path.join(EVIDENCE, "native-acceptance.json" if SUBJECT == "C37" else "native-acceptance-C37.json")
