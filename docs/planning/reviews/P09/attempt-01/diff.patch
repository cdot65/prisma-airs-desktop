+            Subject::Chunk(34),
+            Subject::Phase(9),
+        ] {
+            assert!(!other.is_docs_only(), "{other}");
+        }
+    }
+}
diff --git a/crates/xtask/tests/controlled_live.rs b/crates/xtask/tests/controlled_live.rs
