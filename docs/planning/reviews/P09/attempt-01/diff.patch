--- /dev/null
+++ b/tools/p09/audit-remedial-review.py
@@ -0,0 +1,72 @@
+from pathlib import Path
+import datetime,hashlib,json,subprocess,sys
+
+root=Path.cwd().resolve();subject,attempt=sys.argv[1:3];out=root/f'docs/planning/reviews/{subject}/{attempt}'
+sys.path.insert(0,str(root/'tools/p09'))
+import phase_inputs
+def read(p):return json.loads(Path(p).read_text())
+def sha(p):return hashlib.sha256(Path(p).read_bytes()).hexdigest()
+def validate(value,schema,where='$'):
+    kind=schema.get('type');types={'object':dict,'array':list,'string':str,'integer':int}
+    if kind:assert type(value) is types[kind],where
+    if kind=='object':
+        assert set(schema.get('required',[]))<=set(value),where
+        properties=schema.get('properties',{})
+        if schema.get('additionalProperties') is False:assert set(value)<=set(properties),where
+        for k,v in value.items():
+            if k in properties:validate(v,properties[k],where+'.'+k)
+    if kind=='array':
+        for n,v in enumerate(value):validate(v,schema['items'],where+f'[{n}]')
+    if kind=='integer':assert schema.get('minimum',value)<=value<=schema.get('maximum',value),where
+    if 'enum' in schema:assert value in schema['enum'],where
+r=read(out/'request.json');v=read(out/'verdict-returned.json');validate(v,read(root/'docs/architecture/review-verdict.schema.json'))
+transport=phase_inputs.verify_launch(root,out)
+assert r['subject']==v['subject']==subject and r['attempt_id']==v['attempt_id']==attempt
+assert r['request_id']==v['request_id'] and r['fingerprints']==v['fingerprints']
+i=read(out/'source-inventory.json');assert set(i['files'])==set(r['scope']['files'])
+for p,h in i['files'].items():assert sha(root/p)==h,'source drift '+p
+source=hashlib.sha256(''.join(f'{p} {h}\n' for p,h in sorted(i['files'].items())).encode()).hexdigest()
+assert source==i['source_fingerprint']==r['fingerprints']['source']
+command=r['commands'][0];run=read(root/command['record']);assert sha(root/command['record'])==r['fingerprints']['evidence']
+assert len(run['runs'])==18
+for name,x in run['runs'].items():assert x['exit']==0 and sha(root/x['log'])==x['log_sha256'],name
+assert run['inputs']['before_digest']==run['inputs']['after_digest']==r['fingerprints']['dependencies']
+assert run['build_flags']['digest']==r['fingerprints']['build_flags']
+n=r['native_acceptance'];assert sha(root/n['prepare'])==n['prepare_sha256']
+current=read(root/n['prepare']);assert sha(root/current['bundle']/'Contents/MacOS/prisma-airs-desktop-v2')==current['executable_sha256']
+for native in n['mapped_records']:
+    p=root/native['record'];assert sha(p)==native['sha256'];record=read(p)
+    assert sha(root/native['prepare'])==native['prepare_sha256']
+    prep=read(root/native['prepare']);assert record['app']['executable_sha256']==prep['executable_sha256']==native['executable_sha256']
+    assert record['app']['executable_sha256']==current['executable_sha256'],'new reviews require the current integrated native bundle'
+    checks={c['id']:c for c in record['checks']}
+    for t in native['required_targets']:assert checks[t]['result']=='pass' and all((root/e).exists() for e in checks[t]['evidence'])
+    if native['subject']=='C43':
+        sys.path.insert(0,str(root/'tools/native-acceptance'))
+        import wizard_coverage
+        assert not wizard_coverage.problems(read(p.parent/'native/observations.json')['observations'],root)
+assert sha(root/n['live_row'])==n['live_row_sha256'];live=read(root/n['live_row']);assert live['status']=='pass'
+raw=read(root/live['native_receipt']);assert sha(root/live['native_receipt'])==live['native_receipt_sha256']
+assert raw['status']=='pass' and raw['local_credentials_removed']
+build=read((root/live['native_receipt']).with_name('build.json'))
+# The raw build record keeps its historical absolute path. The archived
+# executable provides the same exact byte check after cloning on Worf.
+qualification_exe=Path(build['bundle'])/'Contents/MacOS/prisma-airs-desktop-v2'
+if not qualification_exe.is_file():
+    qualification_exe=root/'docs/planning/evidence/C29/live/L19/build-02/l19-qualification-executable.bin'
+assert sha(qualification_exe)==raw['executable_sha256']
+scratch=root/'.evidence-private/p09-review'
+scratch.mkdir(parents=True,exist_ok=True)
+post=scratch/f'post-{subject}-{attempt}-inputs.sha256'
+digest=subprocess.check_output(['/bin/bash',str(root/'docs/planning/evidence/P09/runs/hash-inputs.sh'),str(root),str(post)],text=True).strip()
+assert digest==r['fingerprints']['dependencies']
+qualification=phase_inputs.verify_native(root)
+assert qualification['build_inputs']['input_digest']==digest
+result={'subject':subject,'attempt':attempt,'time':datetime.datetime.now(datetime.timezone.utc).isoformat(),
+        'transport':transport,
+        'raw_verdict_sha256':sha(out/'verdict-returned.json'),'request_sha256':sha(out/'request.json'),
+        'source_files_verified':len(i['files']),'check_runs_verified':18,'compiled_inputs_unchanged':True,
+        'live_row_pass_verified':True,'scores':v['scores'],
+        'd034_eligible':min(v['scores'].values())>=8 and not v['blockers'],
+        'full_gate_pass':min(v['scores'].values())>=9 and v['recommendation']=='pass' and not any(v[k] for k in ['required_fixes','blockers','evidence_gaps'])}
+(out/'post-review-audit.json').write_text(json.dumps(result,indent=2)+'\n');print(json.dumps(result,indent=2))
diff --git a/tools/p09/c31_owner_completion.py b/tools/p09/c31_owner_completion.py
new file mode 100644
index 00000000..fe02a5b3
--- /dev/null
+++ b/tools/p09/c31_owner_completion.py
@@ -0,0 +1,111 @@
+"""Owner's single final C31 review cap; raw independent results never change."""
+from pathlib import Path
+import hashlib
+import json
+import phase_inputs as original
+
+DECISION = 'docs/planning/C31-conditional-owner-override-2026-11-02.md'
+DECISION_SHA = '210576fcfce83b3c1862318df06330054cd302bfafb5e1815ec94a2938240291'
+ACTIVATION = 'docs/planning/reviews/C31/owner-activation-2026-11-02.json'
+DIMENSIONS = {'architecture', 'behavior', 'authority_security', 'validation', 'overall'}
+
+
+def first_final_verdict(root):
+    for directory in sorted((Path(root) / 'docs/planning/reviews/C31').glob('attempt-*'),
+                            key=lambda p: int(p.name.split('-')[-1])):
+        if int(directory.name.split('-')[-1]) <= 6:
+            continue
+        for name in ['verdict-returned.json', 'verdict.json']:
+            path = directory / name
+            if path.is_file():
+                value = original.read(path)
+                original.require(value.get('subject') == 'C31' and value.get('attempt_id') == directory.name,
+                                 'wrong C31 final verdict identity')
+                scores = value.get('scores', {})
+                original.require(set(scores) == DIMENSIONS and all(type(n) is int and 1 <= n <= 10 for n in scores.values()),
+                                 'final C31 verdict has no actual numeric scores')
+                return path, value
+    raise ValueError('no completed actual C31 verdict after attempt-06; transport failure is not a score')
+
+
+def bindings(root):
+    root = Path(root)
+    require, read, sha = original.require, original.read, original.sha
+    require(sha(root / DECISION) == DECISION_SHA, 'C31 conditional owner decision changed')
+    path, verdict = first_final_verdict(root)
+    require(any(n < 9 for n in verdict['scores'].values()), 'owner condition not triggered by actual scores')
+    directory = path.parent
+    request = read(directory / 'request.json')
+    audit = read(directory / 'post-review-audit.json')
+    receipt = read(directory / 'receipt.json')
+    for key in ['subject', 'attempt_id', 'request_id', 'fingerprints']:
+        require(request[key] == verdict[key], 'C31 final request/verdict mismatch: ' + key)
+    policy = request['c31_final_review_policy']
+    require(policy['decision'] == DECISION and policy['decision_sha256'] == DECISION_SHA
+            and policy['last_completed_at_direction'] == 'attempt-06', 'final review did not bind owner cap')
+    require(DECISION in request['scope']['files'], 'owner cap not frozen in final review source')
+    require(audit['raw_verdict_sha256'] == sha(path) and audit['request_sha256'] == sha(directory / 'request.json')
+            and audit['scores'] == verdict['scores'] and audit['full_gate_pass'] is False
+            and audit['compiled_inputs_unchanged'] is True, 'C31 raw audit missing or altered')
+    require(receipt['verdict_sha256'] == sha(path) and receipt['request_sha256'] == sha(directory / 'request.json')
+            and receipt['post_review_audit_sha256'] == sha(directory / 'post-review-audit.json')
+            and receipt['scores'] == verdict['scores'] and receipt['recommendation'] == verdict['recommendation']
+            and receipt['fingerprints'] == verdict['fingerprints'] and receipt['full_gate_pass'] is False,
+            'C31 raw receipt missing or altered')
+    for key in ['required_fixes', 'blockers', 'evidence_gaps']:
+        require(receipt[key] == verdict[key], 'accepted C31 findings changed: ' + key)
+    inventory = read(directory / 'source-inventory.json')
+    require(set(inventory['files']) == set(request['scope']['files']), 'C31 final frozen scope membership drift')
+    for name, value in inventory['files'].items():
+        require(sha(root / name) == value, 'C31 final reviewed input drift: ' + name)
+    aggregate = hashlib.sha256(''.join(f'{name} {value}\n' for name, value in sorted(inventory['files'].items())).encode()).hexdigest()
+    require(aggregate == inventory['source_fingerprint'] == verdict['fingerprints']['source'], 'C31 final source aggregate drift')
+    require(audit['transport'] == original.verify_launch(root, directory), 'C31 final actual transport binding drift')
+    transition = request['source_transition']
+    require(sha(root / transition['record']) == transition['sha256'], 'C31 final remediation source seal drift')
+    import phase_inputs_c31_transition as current
+    from c31_transition_policy import verify_transition
+    require(transition == verify_transition(root), 'C31 final qualified source transition drift')
+    qualified = current.verify_native(root)
+    require(qualified['build_inputs']['input_digest'] == request['fingerprints']['dependencies'],
+            'C31 final native/check input binding drift')
+    current.verify_checks(root, root / request['commands'][0]['record'])
+    records = {key: {'record': str((directory / name).relative_to(root)), 'sha256': sha(directory / name)}
+               for key, name in [('verdict', path.name), ('request', 'request.json'), ('source_inventory', 'source-inventory.json'),
+                                 ('audit', 'post-review-audit.json'), ('receipt', 'receipt.json'),
+                                 ('invocation', 'invocation.json'), ('thread_reply', 'thread-reply.log')]}
+    return {'decision': DECISION, 'decision_sha256': DECISION_SHA, 'attempt': verdict['attempt_id'],
+            'request_id': verdict['request_id'], 'actual_scores': verdict['scores'],
+            'actual_recommendation': verdict['recommendation'],
+            'accepted_findings': {key: verdict[key] for key in ['required_fixes', 'blockers', 'evidence_gaps']},
+            'fingerprints': verdict['fingerprints'], 'source_transition': transition, 'bindings': records,
+            'transport': audit['transport'], 'qualified_native': qualified,
+            'check_record': request['commands'][0]['record'],
+            'check_record_sha256': sha(root / request['commands'][0]['record']),
+            'owner_scores': {key: 9 for key in DIMENSIONS}, 'raw_full_gate_pass': False,
+            'owner_complete': True, 'further_c31_cycles_authorized': False}
+
+
+def activate(root):
+    root = Path(root)
+    value = bindings(root)
+    path = root / ACTIVATION
+    with path.open('x') as output:
+        json.dump(value, output, indent=2); output.write('\n')
+    return verify(root)
+
+
+def verify(root):
+    root = Path(root)
+    value = bindings(root)
+    original.require(original.read(root / ACTIVATION) == value, 'C31 owner activation binding changed')
+    records = value['bindings']
+    return {'subject': 'C31', 'owner_closed': True, 'owner_complete': True, 'full_gate_pass': False,
+            'scores': value['actual_scores'], 'owner_scores': value['owner_scores'],
+            'recommendation': value['actual_recommendation'], 'accepted_findings': value['accepted_findings'],
+            'owner_decision': DECISION, 'owner_decision_sha256': DECISION_SHA,
+            'activation': ACTIVATION, 'activation_sha256': original.sha(root / ACTIVATION),
+            'record': records['verdict']['record'], 'sha256': records['verdict']['sha256'],
+            **{key: records[key]['record'] for key in ['request', 'audit', 'receipt']},
+            **{key + '_sha256': records[key]['sha256'] for key in ['request', 'audit', 'receipt']},
+            'standing': 'Owner conditional C31 all-nine completion activated by the first actual post-fix numeric verdict after attempt06; raw score/findings/blockers/gaps/recommendation/audit unchanged. No further C31 scoring cycle or reopening these findings through P09 is authorized. C32/P09 still require actual independent full-nine gates.'}
diff --git a/tools/p09/c31_transition_policy.py b/tools/p09/c31_transition_policy.py
new file mode 100644
index 00000000..a9a4a296
--- /dev/null
+++ b/tools/p09/c31_transition_policy.py
@@ -0,0 +1,245 @@
+"""Explicit C31-only transition from G7; historical qualification is never current.
+
+Original owner_closure_policy.py and all raw reviews remain immutable. The
+transition manifest is sealed only after both declared fixes and preflight.
+"""
+from pathlib import Path
+import hashlib
+import json
+import subprocess
+import owner_closure_policy as baseline
+import phase_inputs as original
+
+PREFIX = 'docs/planning/evidence/P09/c31-transition-20261102/'
+TRANSITION_RECORD = 'transition-final-01.json'
+BASE_HEAD = 'e825c2f69cbcd19387142b80481faaad84690a07'
+BASE_DIGEST = 'e441459dde8a4b13403f16f16e5abf100636421ff827f9955f37740500bbdc50'
+OWNER_SCORE = 'docs/planning/C30-owner-score-override-2026-11-02.md'
+OWNER_SHA = 'c150ebb6a35d8b1bdb6965a5780b96b88f393ed2994cdd3a11da2b4d20bd1a5e'
+FIX_PATHS = {
+    'crates/desktop-core/src/lib.rs',
+    'crates/desktop-core/src/presentation.rs',
+    'apps/desktop/src-tauri/src/native_confirmation.rs',
+    'tools/native-acceptance/mgmt_server.py',
+    'crates/desktop-core/src/authority.rs',
+    'crates/desktop-core/src/authority/change_domain.rs',
+    'crates/desktop-core/src/delivery.rs',
+    'crates/desktop-host/src/lib.rs',
+    'apps/desktop/src-tauri/src/lib.rs',
+    'apps/desktop/src-tauri/Cargo.toml',
+    'crates/desktop-host/Cargo.toml',
+    'crates/desktop-host/tests/renderer_review_lifecycle.rs',
+    'apps/desktop/src-tauri/tests/renderer_review_lifecycle.rs',
+    'tools/native-acceptance/acceptance_c31.py',
+    'tools/native-acceptance/acceptance_c39.py',
+    'tools/native-acceptance/legacy_assertions.py',
+    'tools/native-acceptance/administration_coverage.py',
+    'tools/native-acceptance/test_administration_coverage.py',
+}
+ADMIN_PATHS = {
+    '.gitattributes',
+    'docs/planning/C31-conditional-owner-override-2026-11-02.md',
+    'tools/p09/c31_owner_completion.py',
+    'tools/p09/test_c31_owner_completion.py',
+    'tools/p09/c31_transition_policy.py',
+    'tools/p09/phase_inputs_c31_transition.py',
+    'tools/p09/phase_packet_c31_transition.py',
+    'tools/p09/make-c31-transition-packet.py',
+    'tools/p09/audit-c31-transition-review.py',
+    'tools/p09/make-phase-packet-c31-transition.py',
+    'tools/p09/audit-phase-review-c31-transition.py',
+    'tools/p09/seal-c31-transition.py',
+    'tools/p09/test_c31_transition.py',
+    'tools/p09/audit-p09-checks-c31-transition.py',
+    'tools/p09/README.md',
+}
+
+
+def digest(value):
+    return hashlib.sha256((json.dumps(value, sort_keys=True, separators=(',', ':')) + '\n').encode()).hexdigest()
+
+
+def verify_transition(root):
+    from phase_packet_owner_closure import source_inventory
+    root = Path(root).resolve()
+    require, read, sha = original.require, original.read, original.sha
+    old = read(root / PREFIX / 'baseline-source.json')
+    require(old['head'] == BASE_HEAD and digest(old['files']) == old['digest'] == BASE_DIGEST,
+            'C31 transition baseline changed')
+    seal_path = root / PREFIX / TRANSITION_RECORD
+    seal = read(seal_path)
+    require(seal['baseline_head'] == BASE_HEAD and seal['baseline_digest'] == BASE_DIGEST,
+            'wrong transition baseline')
+    require(subprocess.run(['git', 'merge-base', '--is-ancestor', BASE_HEAD, 'HEAD'],
+                           cwd=root, capture_output=True).returncode == 0, 'baseline not integrated')
+    current = source_inventory(root)
+    changed = {name: {'before': old['files'].get(name), 'after': current.get(name)}
+               for name in sorted(set(old['files']) | set(current))
+               if old['files'].get(name) != current.get(name)}
+    require(changed == seal['source_delta'], 'current source differs from declared sealed C31 delta')
+    require(set(changed) <= FIX_PATHS | ADMIN_PATHS, 'undeclared non-C31 source change')
+    require(digest(current) == seal['current_source_digest'], 'current full source digest mismatch')
+    commit_paths = set()
+    require(len(seal['fix_commits']) >= 2, 'both collaborator fixes must be declared')
+    for commit in seal['fix_commits']:
+        require(subprocess.run(['git', 'merge-base', '--is-ancestor', commit, 'HEAD'],
+                               cwd=root, capture_output=True).returncode == 0, 'fix commit not integrated')
+        names = subprocess.check_output(['git', 'diff-tree', '--no-commit-id', '--name-only', '-r', commit],
+                                        cwd=root, text=True).splitlines()
+        require(all(name in FIX_PATHS or name.startswith('docs/planning/evidence/C31/remediation-attempt-05/') for name in names), 'fix commit changes unrelated source')
+        commit_paths.update(names)
+    require(set(changed) & FIX_PATHS <= commit_paths, 'production/driver delta lacks declared fix commit')
+    for item in seal['focused_results']:
+        focused = read(root / item['record'])
+        require(focused['exit'] == 0 and bool(focused['command']), 'focused command did not pass')
+        if 'log' in focused:
+            require(sha(root / focused['log']) == focused['log_sha256'], 'focused result log changed')
+        require(item['exit'] == 0 and sha(root / item['record']) == item['sha256'],
+                'focused preflight result missing/changed')
+    require(bool(seal['focused_results']), 'no focused preflight results')
+    require(sha(root / OWNER_SCORE) == OWNER_SHA, 'owner all-nine decision changed')
+    return {'record': PREFIX + TRANSITION_RECORD, 'sha256': sha(seal_path),
+            'baseline_head': BASE_HEAD, 'baseline_source_digest': BASE_DIGEST,
+            'current_source_digest': digest(current), 'changed_paths': sorted(changed),
+            'fix_commits': seal['fix_commits'], 'standing': 'C31-only production and native-driver remediation plus explicit administrative provenance; current qualification required'}
+
+
+def verify_c30_owner_closure(root):
+    root = Path(root).resolve()
+    require, read, sha = original.require, original.read, original.sha
+    for name, expected in baseline.PINNED.items():
+        require(sha(root / name) == expected, 'historical C30 record changed: ' + name)
+    latest, verdict = original.latest_verdict(root, 'C30')
+    require(latest == root / baseline.ATTEMPT / 'verdict-returned.json', 'C30 has unexpected later review')
+    require(verdict['scores'] == baseline.SCORES and verdict['recommendation'] == 'fail', 'raw C30 verdict changed')
+    transition = verify_transition(root)
+    result = {'subject': 'C30', 'owner_closed': True, 'scores': verdict['scores'],
+              'recommendation': 'fail', 'full_gate_pass': False,
+              'owner_scores': {key: 9 for key in baseline.SCORES},
+              'owner_decision': OWNER_SCORE, 'owner_decision_sha256': OWNER_SHA,
+              'transition': transition,
+              'standing': 'Owner all-nine C30 standing continues across declared unrelated C31 delta; raw independent 9/9/9/8/8 remains historical. No C30 requalification or independent passing score claimed.'}
+    for key, name in [('record', 'verdict-returned.json'), ('request', 'request.json'),
+                      ('receipt', 'receipt.json'), ('audit', 'post-review-audit.json')]:
+        result[key] = baseline.ATTEMPT + '/' + name
+        result['sha256' if key == 'record' else key + '_sha256'] = sha(root / result[key])
+    return result
+
+
+def historical_c29(root):
+    root = Path(root)
+    require, read, sha = original.require, original.read, original.sha
