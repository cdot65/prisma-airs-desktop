+import { Fragment, useEffect, useId, useMemo, useRef, useState, type KeyboardEvent } from 'react'
+import type { FeatureEntry, FeatureId, ShellSnapshot } from '@prisma-airs/desktop-contracts'
+import { ENVIRONMENT_LABELS, SHELL_COPY } from './copy'
+import { FEATURE_GLYPHS, Glyph, type GlyphName } from './icons'
+import { Modal } from './modal'
+
+export type PaletteEntry =
+    | { kind: 'navigate'; id: string; label: string; feature: FeatureEntry }
+    | { kind: 'switch'; id: string; label: string; tenant: string }
+    | { kind: 'readNow'; id: string; label: string }
+
+export interface PaletteProps {
+    snapshot: ShellSnapshot
+    onNavigate: (id: FeatureId) => void
+    onSwitchTenant: (tenant: string) => void
+    onReadNow: () => void
+    onClose: () => void
+}
+
+/** The palette's entries come from the Rust inventory and the tenant list: never a TS-only registry. */
+export function paletteEntries(snapshot: ShellSnapshot): PaletteEntry[] {
+    const destinations: PaletteEntry[] = snapshot.features.map((feature) => ({
+        kind: 'navigate',
+        id: `go:${feature.id}`,
+        label: feature.label,
+        feature,
+    }))
+    // Tenants are identified as the switcher identifies them: label, environment and TSG (labels may repeat).
+    const tenants: PaletteEntry[] = snapshot.tenants
+        .filter((t) => t.id !== snapshot.active?.tenant)
+        .map((t) => ({
+            kind: 'switch',
+            id: `tenant:${t.id}`,
+            label: SHELL_COPY.paletteSwitch(`${t.label} · ${ENVIRONMENT_LABELS[t.environment]}${t.tsgId ? ` · TSG ${t.tsgId}` : ''}`),
+            tenant: t.id,
+        }))
+    const actions: PaletteEntry[] = snapshot.active ? [{ kind: 'readNow', id: 'action:read', label: SHELL_COPY.paletteReadNow }] : []
+    return [...destinations, ...tenants, ...actions]
+}
+
+const glyphOf = (entry: PaletteEntry): GlyphName => (entry.kind === 'navigate' ? (FEATURE_GLYPHS[entry.feature.id] ?? 'chevR') : entry.kind === 'switch' ? 'idcard' : 'play')
+const groupOf = (entry: PaletteEntry) => (entry.kind === 'navigate' ? SHELL_COPY.paletteGroups.destinations : entry.kind === 'switch' ? SHELL_COPY.paletteGroups.tenants : SHELL_COPY.paletteGroups.actions)
+
+/**
+ * The command palette (R2App, C35): a 640px dialog with a 50px search row,
+ * grouped rows (glyph, label, hint) and a footer of key hints. Entries are
+ * the core's destinations, the other tenants and the read action.
+ */
+export function Palette(props: PaletteProps) {
+    const [query, setQuery] = useState('')
+    const [index, setIndex] = useState(0)
+    const input = useRef<HTMLInputElement>(null)
+    const listId = useId()
+    const entries = useMemo(() => paletteEntries(props.snapshot), [props.snapshot])
+    const matches = useMemo(() => {
+        const q = query.trim().toLowerCase()
+        return q ? entries.filter((e) => e.label.toLowerCase().includes(q)) : entries
+    }, [entries, query])
+    useEffect(() => input.current?.focus(), [])
+    const activeId = matches[index] ? `${listId}-${matches[index].id}` : undefined
+    useEffect(() => {
+        if (activeId) document.getElementById(activeId)?.scrollIntoView({ block: 'nearest' })
+    }, [activeId])
+
+    const choose = (entry: PaletteEntry | undefined) => {
+        if (!entry) return
+        if (entry.kind === 'navigate' && entry.feature.availability.state !== 'available') return
+        props.onClose()
+        if (entry.kind === 'navigate') props.onNavigate(entry.feature.id)
+        else if (entry.kind === 'switch') props.onSwitchTenant(entry.tenant)
+        else props.onReadNow()
+    }
+    const onKeyDown = (event: KeyboardEvent<HTMLInputElement>) => {
+        if (event.key === 'ArrowDown') {
+            event.preventDefault()
+            setIndex((i) => Math.min(i + 1, Math.max(matches.length - 1, 0)))
+        } else if (event.key === 'ArrowUp') {
+            event.preventDefault()
+            setIndex((i) => Math.max(i - 1, 0))
+        } else if (event.key === 'End') {
+            event.preventDefault()
+            setIndex(Math.max(matches.length - 1, 0))
+        } else if (event.key === 'Home') {
+            event.preventDefault()
+            setIndex(0)
+        } else if (event.key === 'Enter') {
+            event.preventDefault()
+            choose(matches[index])
+        }
+        // Tab is the Modal's: it cycles the dialog's controls (the input, and the
+        // "Ask the Harness instead" button when nothing matches).
+    }
+    let lastGroup = ''
+    return (
+        <Modal label={SHELL_COPY.paletteLabel} onClose={props.onClose} width={640} padding={0} top={90} radius={14} data-slot='command-palette'>
+            <div className='flex h-[50px] items-center gap-2.5 px-4' style={{ borderBottom: '1px solid var(--v2-rule)' }}>
+                <Glyph name='search' size={16} color='var(--v2-faint)' />
+                <input
+                    ref={input}
+                    role='combobox'
+                    aria-expanded='true'
+                    aria-controls={listId}
+                    aria-activedescendant={activeId}
+                    aria-autocomplete='list'
+                    aria-label={SHELL_COPY.paletteInput}
+                    placeholder={SHELL_COPY.searchOrGo}
+                    value={query}
+                    onKeyDown={onKeyDown}
+                    onChange={(e) => {
+                        setQuery(e.target.value)
+                        setIndex(0)
+                    }}
+                    className='min-h-0 flex-grow border-0 bg-transparent px-0 text-[15px] outline-none'
+                    style={{ border: 0, background: 'transparent' }}
+                />
+                <kbd className='text-[12px]' style={{ color: 'var(--v2-faint)' }}>
+                    Esc
+                </kbd>
+            </div>
+            <ul id={listId} role='listbox' aria-label={SHELL_COPY.paletteLabel} className='flex flex-col overflow-auto' style={{ padding: '6px 8px 8px', maxHeight: 'min(620px, 60vh)' }}>
+                {matches.map((entry, i) => {
+                    const unavailable = entry.kind === 'navigate' && entry.feature.availability.state === 'unavailable'
+                    const group = groupOf(entry)
+                    const heading = group !== lastGroup
+                    lastGroup = group
+                    return (
+                        <Fragment key={entry.id}>
+                            {heading && (
+                                <li role='presentation' className='text-[12px] font-semibold' style={{ padding: '8px 8px 4px', color: 'var(--v2-faint)' }}>
+                                    {group}
+                                </li>
+                            )}
+                            <li
+                                id={`${listId}-${entry.id}`}
+                                role='option'
+                                aria-selected={i === index}
+                                aria-current={i === index ? 'true' : undefined}
+                                aria-disabled={unavailable || undefined}
+                                onMouseEnter={() => setIndex(i)}
+                                onClick={() => choose(entry)}
+                                className='flex h-[34px] cursor-pointer items-center gap-2.5 rounded-[7px] px-2.5 text-[13px]'
+                                style={{ background: i === index ? 'var(--v2-inset)' : 'transparent', color: unavailable ? 'var(--v2-faint)' : 'var(--v2-ink)' }}
+                            >
+                                <Glyph name={glyphOf(entry)} size={14} color={unavailable ? 'var(--v2-faint)' : 'var(--v2-soft)'} />
+                                <span className='font-semibold'>{entry.label}</span>
+                                <span className='flex-grow' />
+                                {entry.kind === 'navigate' && entry.feature.shortcut !== null && (
+                                    <kbd className='text-[12px]' style={{ color: 'var(--v2-faint)' }}>
+                                        ⌘{entry.feature.shortcut}
+                                    </kbd>
+                                )}
+                                {unavailable && entry.feature.availability.state === 'unavailable' && (
+                                    <span className='text-[11px] uppercase' style={{ color: 'var(--v2-faint)' }}>
+                                        {entry.feature.availability.plannedChunk}
+                                    </span>
+                                )}
+                            </li>
+                        </Fragment>
+                    )
+                })}
+                {matches.length === 0 && (
+                    <li className='flex items-center gap-2.5' style={{ padding: '16px 10px', color: 'var(--v2-faint)' }}>
+                        <span className='flex-grow'>{SHELL_COPY.paletteEmpty}</span>
+                        <button
+                            type='button'
+                            onClick={() => {
+                                props.onClose()
+                                props.onNavigate('harness')
+                            }}
+                            className='h-8 rounded-[7px] border px-3 font-semibold'
+                            style={{ borderColor: 'var(--v2-rule)', background: 'var(--v2-bg)', color: 'var(--v2-ink)' }}
+                        >
+                            {SHELL_COPY.paletteAsk}
+                        </button>
+                    </li>
+                )}
+            </ul>
+            <div className='flex gap-4 px-4 py-2 text-[12px]' style={{ borderTop: '1px solid var(--v2-rule)', background: 'var(--v2-side)', color: 'var(--v2-faint)' }}>
+                <span>{SHELL_COPY.paletteHints.move}</span>
+                <span>{SHELL_COPY.paletteHints.open}</span>
+            </div>
+        </Modal>
+    )
+}
diff --git a/apps/desktop/src/v2/settings/management-credential.test.tsx b/apps/desktop/src/v2/settings/management-credential.test.tsx
new file mode 100644
index 00000000..872152a9
--- /dev/null
+++ b/apps/desktop/src/v2/settings/management-credential.test.tsx
@@ -0,0 +1,116 @@
+/**
+ * Production management-client onboarding through the real App, DesktopClient
+ * and the one presentation (C44): Settings is reached as the v2 shell reaches
+ * it, and the same assertions as the C08 suite hold: a separate credential
+ * from the scan key, the secret captured at submission and cleared before
+ * awaiting, verification as one management read, TSG requirement and removal.
+ * The legacy suite stays as the owner's uncommitted file; this one runs.
+ */
+import { render, screen, within } from '@testing-library/react'
+import userEvent from '@testing-library/user-event'
+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest'
+import { DesktopClient, type TenantView } from '@prisma-airs/desktop-contracts'
+import { App } from '../../app'
+import { baseSnapshot, framed, type Native, scriptedNative, tenant, withTenant } from '../../test/native'
+
+const CONTEXT = 'cx-aaaaaaaaaaaaaaaaaaaaaaaa'
+const CLIENT_ID = 'svc@1234567890.iam.panserviceaccount.com'
+const SECRET = 'synthetic-management-secret-0042'
+const readyManagement: TenantView['management'] = {
+    state: 'ready',
+    mode: 'keychain',
+    failure: null,
+    clientId: CLIENT_ID,
+    tokenOrigin: 'https://auth.apps.paloaltonetworks.com',
+}
+
+async function openSettings(native: Native) {
+    const user = userEvent.setup()
+    render(<App client={new DesktopClient(framed(native, 'settings').transport)} />)
+    await screen.findByRole('heading', { level: 1, name: 'Settings' })
+    return user
+}
+
+const section = () => document.querySelector<HTMLElement>('[data-slot="management-credential"]') as HTMLElement
+const secretField = () => within(section()).getByLabelText('Client secret') as HTMLInputElement
+const clientField = () => within(section()).getByLabelText('Client ID') as HTMLInputElement
+
+let setItem: ReturnType<typeof vi.spyOn>
+beforeEach(() => {
+    setItem = vi.spyOn(Storage.prototype, 'setItem')
+})
+afterEach(() => setItem.mockRestore())
+
+describe('management client onboarding', () => {
+    it('saves a separate client, clearing the secret before awaiting and keeping it out of storage', async () => {
+        const native = scriptedNative(withTenant(baseSnapshot, tenant({ scan: { state: 'ready', mode: 'keychain', failure: null } }), CONTEXT))
+        let admit: (value: unknown) => void = () => undefined
+        native.respond = () => new Promise((resolve) => (admit = resolve))
+        const user = await openSettings(native)
+        expect(within(section()).getByRole('status')).toHaveTextContent('Scans do not need one')
+        await user.type(clientField(), CLIENT_ID)
+        await user.type(secretField(), SECRET)
+        await user.click(within(section()).getByRole('radio', { name: /For this session only/ }))
+        await user.click(within(section()).getByRole('button', { name: 'Save client' }))
+        expect(secretField().value).toBe('')
+        expect(native.dispatched).toEqual([{ kind: 'configureManagementCredential', context: CONTEXT, mode: 'session', clientId: CLIENT_ID, secret: SECRET }])
+        admit({ outcome: 'receipt', receipt: { kind: 'admitted', request: 'rq-1', operation: null } })
+        // The scan key is never part of a management intent.
+        expect(native.dispatched.some((i) => i.kind === 'configureScanCredential')).toBe(false)
+        for (const call of setItem.mock.calls) expect(JSON.stringify(call)).not.toContain(SECRET)
+        expect(native.delivered.join('\n')).not.toContain(SECRET)
+    })
+
+    it('requires a client ID and a secret before dispatching', async () => {
+        const native = scriptedNative(withTenant(baseSnapshot, tenant(), CONTEXT))
+        const user = await openSettings(native)
+        await user.click(within(section()).getByRole('button', { name: 'Save client' }))
+        expect(within(section()).getByRole('alert')).toHaveTextContent('Enter the client ID.')
+        await user.type(clientField(), CLIENT_ID)
+        await user.click(within(section()).getByRole('button', { name: 'Save client' }))
+        expect(within(section()).getByRole('alert')).toHaveTextContent('Enter the client secret.')
+        expect(native.dispatched).toEqual([])
+    })
+
+    it('needs a TSG ID on the tenant profile', async () => {
+        const native = scriptedNative(withTenant(baseSnapshot, tenant({ tsgId: null }), CONTEXT))
+        await openSettings(native)
+        expect(screen.getByText(/has no TSG ID/)).toBeInTheDocument()
+        expect(within(section()).getByRole('button', { name: 'Save client' })).toBeDisabled()
+    })
+
+    it('points to the Harness for company sign-in (SSO)', async () => {
+        const native = scriptedNative(withTenant(baseSnapshot, tenant(), CONTEXT))
+        await openSettings(native)
+        expect(within(section()).getByText('Company sign-in (SSO) for the Harness is set up per Gateway workspace, in Harness.')).toBeInTheDocument()
+    })
+
+    it('verifies with one management read and reports failures faithfully', async () => {
+        const native = scriptedNative(withTenant(baseSnapshot, tenant({ management: readyManagement }), CONTEXT))
+        let answer: unknown = { kind: 'management', result: { kind: 'verified' } }
+        native.respond = () => ({ outcome: 'receipt', receipt: { kind: 'admitted', request: 'rq-1', operation: 'op-7' } })
+        const observed: string[] = []
+        native.observeManagement = (operation) => {
+            observed.push(operation)
+            return answer
+        }
+        const user = await openSettings(native)
+        expect(within(section()).getByRole('status')).toHaveTextContent('saved in the Keychain')
+        expect(within(section()).getByText(`Client ID: ${CLIENT_ID}`)).toBeInTheDocument()
+        await user.click(within(section()).getByRole('button', { name: 'Verify' }))
+        expect(await within(section()).findByText('The management client can read this tenant.')).toBeInTheDocument()
+        expect(native.dispatched).toEqual([{ kind: 'management', context: CONTEXT, request: { kind: 'verify' } }])
+        expect(observed).toEqual(['op-7'])
+        answer = { kind: 'management', result: { kind: 'failed', failure: 'unauthorized', outcome: 'rejected' } }
+        await user.click(within(section()).getByRole('button', { name: 'Verify' }))
+        expect(await within(section()).findByRole('alert')).toHaveTextContent('was not accepted')
+        expect(within(section()).queryByText('The management client can read this tenant.')).toBeNull()
+    })
+
+    it('removes only the management client', async () => {
+        const native = scriptedNative(withTenant(baseSnapshot, tenant({ scan: { state: 'ready', mode: 'keychain', failure: null }, management: readyManagement }), CONTEXT))
+        const user = await openSettings(native)
+        await user.click(within(section()).getByRole('button', { name: 'Remove management client' }))
+        expect(native.dispatched).toEqual([{ kind: 'removeManagementCredential', context: CONTEXT }])
+    })
+})
diff --git a/apps/desktop/src/v2/store.ts b/apps/desktop/src/v2/store.ts
new file mode 100644
index 00000000..67f214a9
--- /dev/null
+++ b/apps/desktop/src/v2/store.ts
@@ -0,0 +1,240 @@
+import { create } from 'zustand'
+
+export type ToastKind = 'ok' | 'info' | 'warn'
+import type { AdminProductId, FeatureId, Intent, ManagementResource } from '@prisma-airs/desktop-contracts'
+
+/** What a contextual action asked the destination to select on arrival (C30), owned by the tenant it was followed in (I2). */
+export interface Arrival {
+    tenant: string
+    feature: FeatureId
+    resource: ManagementResource | null
+    /** The item to filter to, by name. */
+    item: string | null
+    /** The Administration product to open (the rail's product children, C35). */
+    product?: AdminProductId
+    /** That product's tab to show, by the inventory's tab id (the tenant menu's workspace row, C35). */
+    tab?: string
+    /** Counts arrivals: a destination already open applies a new one. */
+    sequence: number
+}
+
+/** A Harness message kept for the operator: refused or never sent, or not confirmed (C32). */
+export interface HarnessKept {
+    /** This record's own id: each attempt is its own record (C32). */
+    id: number
+    text: string
+    unconfirmed: boolean
+    /**
+     * For an unconfirmed send: the conversation it was sent to and the send's
+     * own ID. It is settled only when that conversation reports the core took
+     * that ID (`ConversationView.submissions`), never by matching text (C32).
+     */
+    conversation?: string
+    submission?: string
+}
+
+/** A Harness send the page dispatched, awaiting the core's word on it (C32): never shown, never sent again. */
+export interface HarnessSent {
+    submission: string
+    conversation: string
+    text: string
+}
+
+/**
+ * A Runtime case handed to the Playground (C33): Administration opens Runtime
+ * Security's Playground tab with the case's fields; the operator runs the
+ * scan there. Bound to the tenant it was opened in.
+ */
+export interface PlaygroundCase {
+    tenant: string
+    caseId: string
+    prefill: import('../features/library/library-view').CasePrefill
+}
+
+/** A delivery the desktop did not confirm: kept until the operator retries or dismisses it (DESIGN-V2 §7). */
+export interface Unconfirmed {
+    id: number
+    what: string
+    intent: Intent
+    /** The native context or captured switch source this delivery belongs to; retirement never rebinds it. */
+    context: string | null
+}
+
+/** An initial tenant selection captures even the absence of an active context. */
+export function unconfirmedInContext(delivery: Pick<Unconfirmed, 'intent' | 'context'>, context: string | null): boolean {
+    return delivery.context === context || (delivery.context === null && delivery.intent.kind !== 'selectTenant')
+}
+
+function switchResolution(intent: Intent) {
+    return intent.kind === 'selectTenant' || intent.kind === 'completeTenantSetup' ? intent.resolution : null
+}
+
+/** A destructive switch is bound to its source, not its destination or setup draft. */
+export function deliveryContext(intent: Intent): string | null {
+    const resolution = switchResolution(intent)
+    if (resolution) return resolution.context
+    return 'context' in intent && typeof intent.context === 'string' ? intent.context : null
+}
+
+export interface Toast {
+    id: number
+    kind: ToastKind
+    text: string
+    /** An optional undo the toast offers (label + action). */
+    undo?: { label: string; run: () => void }
+    /** The tenant the toast speaks for (an item, a read): retired on leaving it (I2). */
+    tenant: string | null
+    /** The context it was raised under, when the action was context-bound: retired with it. */
+    context: string | null
+}
+
+/**
+ * Transient shell presentation state (state-ownership.md "UI"): what is open,
+ * the palette query, toasts and the modal stack. Nothing here survives a
+ * reload and nothing here is authority: every durable fact is observed from
+ * the Rust snapshot.
+ */
+interface ShellStore {
+    /** The scope the shell shows now (set from each snapshot before it renders): what a notification must belong to. */
+    scope: { tenant: string | null; context: string | null; switchReview: string | null }
+    setScope(tenant: string | null, context: string | null, switchReview?: string | null): void
+    paletteOpen: boolean
+    switcherOpen: boolean
+    /** The rail's Administration children shown or hidden (C35; the prototype's `adminNav`). */
+    adminNavOpen: boolean
+    setAdminNav(open: boolean): void
+    toasts: Toast[]
+    /** Open modal ids, bottom to top; only the last is interactive (I8). */
+    modals: string[]
+    /** The Inbox tab and item per tenant (I2: a switch round trip keeps it). */
+    inboxSelection: Record<string, { tab: 'all' | 'action' | 'updates' | 'snoozed'; item: string | null }>
+    selectInbox(tenant: string, selection: { tab: 'all' | 'action' | 'updates' | 'snoozed'; item: string | null }): void
+    /** Harness drafts, by `tenant|workspace|conversation` (C32): kept across navigation and tenant round trips, never shared between scopes, never sent by themselves. */
+    harnessDrafts: Record<string, string>
+    setHarnessDraft(scope: string, text: string): void
+    /** Per `tenant|workspace`: the operator chose a new investigation while one runs (C32). */
+    harnessFresh: Record<string, boolean>
+    setHarnessFresh(scope: string, fresh: boolean): void
+    /**
+     * Per `tenant|workspace`: messages kept for the operator (C32). `unconfirmed`
+     * ones may have been delivered (the desktop did not confirm it); the others
+     * were refused or never sent. Never sent by themselves.
+     */
+    harnessUnsent: Record<string, HarnessKept[]>
+    keepHarnessUnsent(scope: string, kept: Omit<HarnessKept, 'id'>): void
+    dropHarnessUnsent(scope: string, id: number): void
+    /**
+     * Per `tenant|workspace`: sends dispatched and not yet reported by their
+     * conversation (C32), so a send the core gives back keeps its text whatever
+     * order its receipt and the core's word arrive in. Newest 64.
+     */
+    harnessSent: Record<string, HarnessSent[]>
+    /** The case last handed to the Playground (C33); never runs anything by itself. */
+    playground: PlaygroundCase | null
+    openPlayground(target: Omit<PlaygroundCase, 'prefill'> & { prefill: Omit<PlaygroundCase['prefill'], 'nonce'> }): void
+    trackHarnessSend(scope: string, sent: HarnessSent): void
+    untrackHarnessSend(scope: string, submission: string): void
+    /** The last contextual action's target, consumed by the destination it names. */
+    arrival: Arrival | null
+    arrive(target: Omit<Arrival, 'sequence'>): void
+    /** Forgets an arrival that belongs to another tenant than `tenant`. */
+    scopeArrival(tenant: string | null): void
+    /** Drops unconfirmed deliveries bound to a context other than `context` (their authority retired). */
+    retireUnconfirmed(context: string | null): void
+    unconfirmed: Unconfirmed[]
+    /** Toast lifetime in ms (6 s; tests shorten it). */
+    toastMs: number
+    addUnconfirmed(what: string, intent: Intent, sourceContext?: string | null): number
+    clearUnconfirmed(id: number): void
+    openPalette(): void
+    closePalette(): void
+    setSwitcher(open: boolean): void
+    toast(text: string, kind?: ToastKind, undo?: Toast['undo'], tenant?: string | null, context?: string | null): number
+    /** Retires toasts that speak for another tenant than `tenant`. */
+    retireToasts(tenant: string | null): void
+    dismissToast(id: number): void
+    pushModal(id: string): void
+    popModal(id: string): void
+}
+
+let nextToast = 1
+let nextKept = 1
+
+export const useShellStore = create<ShellStore>((set, get) => ({
+    scope: { tenant: null, context: null, switchReview: null },
+    setScope: (tenant, context, switchReview = null) =>
+        set((s) => ({
+            scope: { tenant, context, switchReview },
+            // Leaving a scope retires what spoke for it, however late it would have arrived.
+            toasts: s.toasts.filter((t) => (t.tenant === null || t.tenant === tenant) && (t.context === null || t.context === context)),
+            unconfirmed: s.unconfirmed.filter((u) => unconfirmedInContext(u, context) && (!switchResolution(u.intent) || switchResolution(u.intent)?.review === switchReview)),
+            arrival: s.arrival && s.arrival.tenant !== tenant ? null : s.arrival,
+        })),
+    paletteOpen: false,
+    switcherOpen: false,
+    adminNavOpen: true,
+    setAdminNav: (open) => set({ adminNavOpen: open }),
+    toasts: [],
+    modals: [],
+    inboxSelection: {},
+    selectInbox: (tenant, selection) => set((s) => ({ inboxSelection: { ...s.inboxSelection, [tenant]: selection } })),
+    harnessDrafts: {},
+    setHarnessDraft: (scope, text) => set((s) => ({ harnessDrafts: { ...s.harnessDrafts, [scope]: text } })),
+    harnessFresh: {},
+    setHarnessFresh: (scope, fresh) => set((s) => ({ harnessFresh: { ...s.harnessFresh, [scope]: fresh } })),
+    harnessUnsent: {},
+    keepHarnessUnsent: (scope, item) =>
+        set((s) => {
+            const kept = s.harnessUnsent[scope] ?? []
+            const record = { ...item, id: nextKept++ }
+            // An uncertain attempt is never removed or downgraded by a later one:
+            // only the core's word on its own send ID, or the operator, settles it.
+            // A not-sent record of the same text is superseded by a later attempt;
+            // not-sent records are kept once per text.
+            const others = kept.filter((k) => k.unconfirmed || k.text !== item.text)
+            return { harnessUnsent: { ...s.harnessUnsent, [scope]: [...others, record] } }
+        }),
+    dropHarnessUnsent: (scope, id) => set((s) => ({ harnessUnsent: { ...s.harnessUnsent, [scope]: (s.harnessUnsent[scope] ?? []).filter((k) => k.id !== id) } })),
+    harnessSent: {},
+    playground: null,
+    openPlayground: (target) => set((s) => ({ playground: { ...target, prefill: { ...target.prefill, nonce: (s.playground?.prefill.nonce ?? 0) + 1 } } })),
+    trackHarnessSend: (scope, sent) => set((s) => ({ harnessSent: { ...s.harnessSent, [scope]: [...(s.harnessSent[scope] ?? []), sent].slice(-64) } })),
+    untrackHarnessSend: (scope, submission) => set((s) => ({ harnessSent: { ...s.harnessSent, [scope]: (s.harnessSent[scope] ?? []).filter((t) => t.submission !== submission) } })),
+    arrival: null,
+    arrive: (target) => set((s) => ({ arrival: { ...target, sequence: (s.arrival?.sequence ?? 0) + 1 } })),
+    unconfirmed: [],
+    toastMs: 6000,
+    addUnconfirmed: (what, intent, context = deliveryContext(intent)) => {
+        const id = nextToast++
+        // A delivery bound to a context the shell no longer shows is moot: never surfaced (I2).
+        if (!unconfirmedInContext({ intent, context }, get().scope.context)) return id
+        const resolution = switchResolution(intent)
+        if (resolution && resolution.review !== get().scope.switchReview) return id
+        set((s) => ({ unconfirmed: [...s.unconfirmed, { id, what, intent, context }] }))
+        return id
+    },
+    scopeArrival: (tenant) => set((s) => (s.arrival && s.arrival.tenant !== tenant ? { arrival: null } : {})),
+    retireUnconfirmed: (context) => set((s) => ({ unconfirmed: s.unconfirmed.filter((u) => unconfirmedInContext(u, context)) })),
+    clearUnconfirmed: (id) => set((s) => ({ unconfirmed: s.unconfirmed.filter((u) => u.id !== id) })),
+    openPalette: () => set({ paletteOpen: true, switcherOpen: false }),
+    closePalette: () => set({ paletteOpen: false }),
+    setSwitcher: (open) => set({ switcherOpen: open, ...(open ? { paletteOpen: false } : {}) }),
+    toast: (text, kind = 'ok', undo, tenant = null, context = null) => {
+        const id = nextToast++
+        // A toast for a tenant or context the shell no longer shows is never surfaced (I2).
+        if (tenant !== null && tenant !== get().scope.tenant) return id
+        if (context !== null && context !== get().scope.context) return id
+        // One toast at a time: the newest replaces the rest (I10).
+        set({ toasts: [{ id, kind, text, undo, tenant, context }] })
+        return id
+    },
+    retireToasts: (tenant) => set((s) => ({ toasts: s.toasts.filter((t) => t.tenant === null || t.tenant === tenant) })),
+    dismissToast: (id) => set((s) => ({ toasts: s.toasts.filter((t) => t.id !== id) })),
+    pushModal: (id) => set((s) => ({ modals: s.modals.includes(id) ? s.modals : [...s.modals, id] })),
+    popModal: (id) => set((s) => ({ modals: s.modals.filter((m) => m !== id) })),
+}))
+
+/** Test seam: forget everything (each test starts from an empty store). */
+export function resetShellStore() {
+    useShellStore.setState({ scope: { tenant: null, context: null, switchReview: null }, paletteOpen: false, switcherOpen: false, adminNavOpen: true, toasts: [], modals: [], unconfirmed: [], toastMs: 6000, inboxSelection: {}, arrival: null, harnessDrafts: {}, harnessFresh: {}, harnessUnsent: {}, harnessSent: {}, playground: null })
+}
