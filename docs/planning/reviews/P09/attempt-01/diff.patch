+        detail = coverage.gateway_key_state(gateway_tree(kind=kind), kind, require_detail=True)
+        detail["row"] = "Details for gateway-key-1"
+        result["kinds"][kind] = {"list": list_state, "row_labels": [detail["row"]], "details": [detail]}
+    return result
