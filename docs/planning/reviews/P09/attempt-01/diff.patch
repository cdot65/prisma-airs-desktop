+import acceptance_c29 as c29  # noqa: E402  (shell helpers: captures, matrix, switcher)
+import native_sheets as sheets  # noqa: E402
+
+ROOT = os.getcwd()
+SUBJECT = os.environ.get("AIRS_NATIVE_SUBJECT", "C30")
