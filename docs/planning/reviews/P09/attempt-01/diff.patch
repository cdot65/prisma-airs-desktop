+impl Browser {
+    pub fn new(act: impl Fn(&str, Option<&url::Url>) + Send + Sync + 'static) -> Arc<Self> {
+        Arc::new(Self {
+            prompts: Mutex::new(Vec::new()),
+            act: Box::new(act),
+        })
