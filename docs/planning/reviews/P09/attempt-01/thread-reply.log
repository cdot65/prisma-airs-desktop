 let operation = desk.snap().changes.results[0].operation.clone();\n    assert!(\n        !desk.snap().changes.results[0].settled,\n        \"reply still pending\"\n    );\n    desk.retire();\n    desk.register();\n    let result = desk.settled().await;\n    assert_eq!(\n        result.operation, operation,\n        \"the original work remains observable\"\n    );\n    assert_eq!(\n        result.outcome,\n        Some(desktop_core::runtime::Outcome::Completed),\n        \"remote completion preserved\"\n    );\n    assert_eq!(\n        result.secret,\n        SecretState::Forgotten,\n        \"reply after page exit never acquires disclosure authority\"\n    );\n    assert!(\n        desk.send(json!({\"kind\":\"revealSecret\",\"operation\":operation}))\n            .is_err()\n    );\n    assert!(desk.adapters.secrets.shown().is_empty());\n    let rotation = desk\n        .snap()\n        .rotations\n        .into_iter()\n        .find(|rotation| rotation.application == \"Support bot\")\n        .expect(\"rotation facts retained\");\n    assert_eq!(rotation.stage, desktop_core::RotationStage::Resumed);\n    assert_eq!(rotation.issued_by, None);\n    assert_eq!(desk.writes(), 1, \"original write was never replayed\");\n}\n\n#[tokio::test(flavor = \"multi_thread\")]\n            .secrets\n            .push(SecretTask::Scoped(task));\n    }\n    fn dismiss(&self) {\n        self.owner.begin();\n    }\n}\nimpl desktop_core::OperatorConfirmation for QueuedNative {\n    fn confirm(\n        &self,\n        nonce: u64,\n        request: desktop_core::ConfirmationRequest,\n    ) -> futures_util::future::BoxFuture<'static, bool> {\n        if !self\n            .queue_confirms\n            .load(std::sync::atomic::Ordering::Acquire)\n        {\n            self.confirm_entries\n                .fetch_add(1, std::sync::atomic::Ordering::Release);\n            return Box::pin(async { true });\n        }\n        let receiver = self.registry.open(nonce);\n        self.state\n            .lock()\n            .expect(\"queue\")\n            .confirmations\n            .push(ConfirmationTask::Legacy(nonce, request));\n        self.confirm_entries\n            .fetch_add(1, std::sync::atomic::Ordering::Release);\n        Box::pin(desktop_host::native_confirmation::outcome(receiver))\n    }\n    fn confirm_scoped(\n        &self,\n        nonce: u64,\n        request: desktop_core::ConfirmationRequest,\n        lease: desktop_core::PresentationLease,\n    ) -> futures_util::future::BoxFuture<'static, bool> {\n        if !lease.is_current() {\n            self.confirm_entries\n                .fetch_add(1, std::sync::atomic::Ordering::Release);\n            return Box::pin(async { false });\n        }\n        if !self\n            .queue_confirms\n            .load(std::sync::atomic::Ordering::Acquire)\n        {\n            self.confirm_entries\n                .fetch_add(1, std::sync::atomic::Ordering::Release);\n            return Box::pin(async { true });\n        }\n        let receiver = self.registry.open(nonce);\n        let task =\n            desktop_host::native_confirmation::ConfirmationPresentation::new(nonce, request, lease);\n        self.state\n            .lock()\n            .expect(\"queue\")\n            .confirmations\n            .push(ConfirmationTask::Scoped(task));\n        self.confirm_entries\n            .fetch_add(1, std::sync::atomic::Ordering::Release);\n        Box::pin(desktop_host::native_confirmation::outcome(receiver))\n    }\n    fn dismiss(&self, nonce: u64) {\n        self.registry.complete(nonce, false);\n    }\n}\n\nasync fn cross_teardown(secret: bool, before_effect: bool) {\n    let native = Arc::new(QueuedNative::default());\n    let mut desk = Desk::with_presenter(false, Some(Arc::clone(&native))).await;\n    let review = desk.review().await;\n    let original = if secret {\n        desk.apply(&review);\n        Some(desk.settled().await)\n    } else {\n        native\n            .queue_confirms\n            .store(true, std::sync::atomic::Ordering::Release);\n        None\n    };\n    let confirm_before = native\n        .confirm_entries\n        .load(std::sync::atomic::Ordering::Acquire);\n    let gate = before_effect.then(|| desk.core.operator().hold_next_native_presentation());\n    let intent = if let Some(result) = &original {\n        json!({\"kind\":\"revealSecret\",\"operation\":result.operation})\n    } else {\n        json!({\"kind\":\"requestApply\",\"review\":review.review,\"draft\":draft(),\"confirmation\":\"CREATE\"})\n    };\n    let dispatch = desk.send_thread(intent);\n    if let Some(gate) = &gate {\n        assert!(\n            eventually(|| gate.entered()).await,\n            \"real admission completed; effect not executed\"\n        );\n    } else {\n        assert!(\n            eventually(|| if secret {\n                native.secret_count() == 1\n            } else {\n                native.confirmation_count() == 1\n            })\n            .await,\n            \"real native callback queued\"\n        );\n    }\n    desk.retire();\n    desk.register();\n    if let Some(gate) = gate {\n        gate.release();\n    }\n    dispatch\n        .join()\n        .expect(\"dispatch thread\")\n        .expect(\"original admission receipt\");\n    if !secret {\n        assert!(\n            eventually(|| native\n                .confirm_entries\n                .load(std::sync::atomic::Ordering::Acquire)\n                > confirm_before)\n            .await,\n            \"native adapter has made its queue/refusal decision\"\n        );\n    }\n    native.drain();\n    {\n        let state = native.state.lock().expect(\"queue\");\n        assert_eq!(\n            state.shown_secrets, 0,\n            \"departed page's admitted/queued key must never be presented\"\n        );\n        assert_eq!(\n            state.copied_secrets, 0,\n            \"departed page's key must never be copied\"\n        );\n        assert_eq!(\n            state.shown_confirmations, 0,\n            \"departed page's confirmation must never be presented\"\n        );\n    }\n    assert_eq!(native.registry.open_count(), 0, \"no stale pending nonce\");\n    assert_eq!(desk.writes(), usize::from(secret), \"no mutation replay\");\n    if let Some(original) = original {\n        let result = &desk.snap().changes.results[0];\n        assert_eq!(result.operation, original.operation);\n        assert_eq!(\n            result.outcome,\n            Some(desktop_core::runtime::Outcome::Completed)\n        );\n        assert!(\n            desk.send(json!({\"kind\":\"revealSecret\",\"operation\":original.operation}))\n                .is_err()\n        );\n    }\n    native\n        .queue_confirms\n        .store(false, std::sync::atomic::Ordering::Release);\n    let fresh = desk.review_draft(draft_named(\"Support key 3\")).await;\n    desk.apply_draft(&fresh, draft_named(\"Support key 3\"));\n    let fresh = desk.settled().await;\n    assert_eq!(\n        fresh.outcome,\n        Some(desktop_core::runtime::Outcome::Completed)\n    );\n    assert_eq!(\n        desk.writes(),\n        usize::from(secret) + 1,\n        \"only explicit fresh-page work writes\"\n    );\n    desk.send(json!({\"kind\":\"revealSecret\",\"operation\":fresh.operation}))\n        .expect(\"fresh reveal\");\n    native.drain();\n    let state = native.state.lock().expect(\"queue\");\n    assert_eq!(state.shown_secrets, 1, \"fresh-page presentation works\");\n    assert_eq!(state.copied_secrets, 1, \"fresh-page explicit copy works\");\n}\n\n#[tokio::test(flavor = \"multi_thread\")]\nasync fn scoped_secret_admitted_before_teardown_cannot_present_after_effect_release() {\n    cross_teardown(true, true).await;\n}\n#[tokio::test(flavor = \"multi_thread\")]\nasync fn scoped_secret_queued_before_teardown_cannot_present_or_copy() {\n    cross_teardown(true, false).await;\n}\n#[tokio::test(flavor = \"multi_thread\")]\nasync fn scoped_confirmation_admitted_before_teardown_cannot_present_after_effect_release() {\n    cross_teardown(false, true).await;\n}\n#[tokio::test(flavor = \"multi_thread\")]\n        outputs(&desk)\n            .last()\n            .is_some_and(|o| o.contains(\"declined this read\"))\n    );\n    desk.end(&id).await;\n    desk.send(json!({\"kind\": \"clearHarness\", \"conversation\": id}))\n        .await\n        .expect(\"cleared\");\n    // A command with changes allowed: the sheet refused, nothing runs.\n    let dir = project();\n    choose_project(&mut desk, &dir).await;\n    let context = desk.context();\n    desk.send(json!({\"kind\": \"setHarnessWrite\", \"context\": context, \"write\": true}))\n        .await\n        .expect(\"write\");\n    let reference = desk.json()[\"gateway\"][\"selected\"][\"reference\"]\n        .as_str()\n        .expect(\"ref\")\n        .to_owned();\n    let id = desk.start(&reference).await.expect(\"started\");\n    assert!(settle_for(30, || desk.conversation()[\"phase\"] == \"ready\").await);\n    tool(\n        &desk,\n        None,\n        \"exec_command\",\n        json!({\"cmd\": \"echo c32 > c32.txt\"}),\n    );\n    desk.say(&id, \"Write a file.\").await.expect(\"sent\");\n    assert!(\n        settle_for(40, || desk.conversation()[\"approvals\"]\n            .as_array()\n            .is_some_and(|a| a.len() == 1))\n        .await\n    );\n    let change = desk.conversation()[\"approvals\"][0].clone();\n    assert_eq!(change[\"kind\"], \"command\");\n    assert_eq!(change[\"effect\"], \"mayChange\");\n    desk.adapters.confirmer.auto(Some(false));\n    desk.send(json!({\"kind\": \"decideHarnessApproval\", \"conversation\": id, \"approval\": change[\"id\"], \"allow\": true}))\n        .await\n        .expect(\"asked natively\");\n    tokio::time::sleep(Duration::from_millis(800)).await;\n    assert_eq!(\n        desk.conversation()[\"approvals\"][0][\"id\"],\n        change[\"id\"],\n        \"still pending: in-page consent alone does not run it\"\n    );\n    assert!(!dir.join(\"c32.txt\").exists(), \"nothing ran\");\n    // Accepted in the native sheet: it runs once.\n    desk.adapters.confirmer.auto(Some(true));\n    desk.send(json!({\"kind\": \"decideHarnessApproval\", \"conversation\": id, \"approval\": change[\"id\"], \"allow\": true}))\n        .await\n        .expect(\"asked natively\");\n    answered_with(&mut desk, |c| {\n        c[\"phase\"] == \"ready\"\n            && c[\"approvals\"].as_array().is_some_and(Vec::is_empty)\n            && c[\"lastTurn\"].is_string()\n    })\n    .await;\n    assert!(\n        settle(|| dir.join(\"c32.txt\").exists()).await,\n        \"it ran after the native confirmation\"\n    );\n    desk.end(&id).await;\n}\n\n/// C32 (R7): the mcp lifecycle's read is the desktop's own `mcpServers`\n/// tool: it waits for the operator's decision in the page and, allowed,\n/// reads the conversation workspace's MCP catalog (`GatewayRead::McpServers`)\n/// and gives the engine the servers it lists.\n#[tokio::test(flavor = \"multi_thread\", worker_threads = 4)]\nasync fn the_mcp_catalog_is_read_for_the_engine_only_once_the_operator_allows_it() {\n    let mut desk = desk().await;\n    let fast = desk\n        .gateway\n        .lock()\n        .expect(\"gateway\")\n        .hook\n        .clone()\n        .expect(\"hook\");\n    desk.gateway.lock().expect(\"gateway\").hook = Some(Arc::new(move |seen| {\n        let target = seen.request_line.split(' ').nth(1)?;\n        if target.starts_with(&format!(\"{DATA}/mcp-servers\")) {\n            return Some(json_reply(\n                200,\n                &json!({\"object\": \"list\", \"total\": 1, \"data\": [\n                {\"id\": \"mcp-1\", \"name\": \"scratch-tools\", \"slug\": \"scratch-tools\",\n                 \"url\": \"https://mcp.example/scratch-tools/mcp\", \"status\": \"active\",\n                 \"workspace_id\": WS_A, \"last_updated_at\": \"2026-10-28T00:00:00Z\", \"auth_type\": \"oauth\",\n                 \"object\": \"mcp_server\"}]}),\n            ));\n        }\n        fast(seen)\n    }));\n    let id = ready(&mut desk).await;\n    tool(&desk, Some(\"airs_desktop\"), \"mcpServers\", json!({}));\n    desk.say(&id, \"Which MCP servers does this workspace have?\")\n        .await\n        .expect(\"sent\");\n    assert!(\n        settle_for(40, || desk.conversation()[\"approvals\"]\n            .as_array()\n            .is_some_and(|a| a.len() == 1))\n        .await\n    );\n    let read = desk.conversation()[\"approvals\"][0].clone();\n    assert_eq!(\n        (\n            read[\"kind\"].as_str(),\n            read[\"tool\"].as_str(),\n            read[\"effect\"].as_str()\n        ),\n        (Some(\"desktopRead\"), Some(\"mcpServers\"), Some(\"readOnly\"))\n    );\n    assert!(\n        desk.requests(&format!(\"{DATA}/mcp-servers\")).is_empty(),\n        \"nothing read before the decision\"\n    );\n    desk.send(json!({\"kind\": \"decideHarnessApproval\", \"conversation\": id, \"approval\": read[\"id\"], \"allow\": true}))\n        .await\n        .expect(\"allowed\");\n    let c = answered_with(&mut desk, |c| {\n        c[\"phase\"] == \"ready\" && c[\"lastTurn\"].is_string()\n    })\n    .await;\n    assert_eq!(\n        desk.requests(&format!(\"{DATA}/mcp-servers\")).len(),\n        1,\n        \"read once\"\n    );\n    assert_eq!(entry(&c, \"tool\").expect(\"entry\")[\"state\"], \"complete\");\n    assert!(\n        outputs(&desk)\n            .last()\n            .is_some_and(|o| o.contains(\"scratch-tools\")),\n        \"{:?}\",\n        outputs(&desk)\n    );\n    desk.end(&id).await;\n}\n\n/// C32 (attempt-02 optional): a native confirmation still open when its\n/// conversation ends is dismissed, and an acceptance that arrives late runs\n/// nothing.\n#[tokio::test(flavor = \"multi_thread\", worker_threads = 4)]\nasync fn a_confirmation_that_outlives_its_conversation_runs_nothing() {\n    let mut desk = desk().await;\n    let dir = project();\n    choose_project(&mut desk, &dir).await;\n    let context = desk.context();\n    desk.send(json!({\"kind\": \"setHarnessWrite\", \"context\": context, \"write\": true}))\n        .await\n        .expect(\"write\");\n    let id = ready(&mut desk).await;\n    tool(\n        &desk,\n        None,\n        \"exec_command\",\n        json!({\"cmd\": \"echo late > late.txt\"}),\n    );\n    desk.say(&id, \"Write a file.\").await.expect(\"sent\");\n    assert!(\n        settle_for(40, || desk.conversation()[\"approvals\"]\n            .as_array()\n            .is_some_and(|a| a.len() == 1))\n        .await\n    );\n    let change = desk.conversation()[\"approvals\"][0].clone();\n    assert_eq!(change[\"effect\"], \"mayChange\");\n    // The sheet stays open: the operator has not answered yet.\n    desk.adapters.confirmer.auto(None);\n    desk.send(json!({\"kind\": \"decideHarnessApproval\", \"conversation\": id, \"approval\": change[\"id\"], \"allow\": true}))\n        .await\n        .expect(\"asked natively\");\n    assert!(\n        settle(|| desk.adapters.confirmer.held() == 1).await,\n        \"the sheet is shown\"\n    );\n    let nonce = desk\n        .adapters\n        .confirmer\n        .requests()\n        .last()\n        .expect(\"a request\")\n        .0;\n    // The conversation ends while the sheet is open: it is dismissed.\n    desk.end(&id).await;\n    assert!(\n        settle(|| desk.adapters.confirmer.dismissed().contains(&nonce)).await,\n        \"dismissed with its conversation\"\n    );\n    // A late acceptance runs nothing.\n    let _ = desk.adapters.confirmer.complete(true);\n    tokio::time::sleep(Duration::from_millis(800)).await;\n    assert!(!dir.join(\"late.txt\").exists(), \"nothing ran\");\n}\n\n#[tokio::test(flavor = \"multi_thread\", worker_threads = 4)]\nasync fn the_opening_message_is_kept_whole_beside_its_shortened_title() {\n    // A contextual restart prefills the opening question, never the title\n    // (screens/harness.md; attempt-12 R1).\n    let mut desk = desk().await;\n    let id = ready(&mut desk).await;\n    let opening = format!(\n        \"Investigate the Finance topic.\\nList every key that expires before the audit, {}and explain.\",\n        \"with its owner and its application, \".repeat(4)\n    );\n    assert!(opening.chars().count() > 160);\n    desk.say(&id, &opening).await.expect(\"sent\");\n    let c = answered_with(&mut desk, |c| {\n        c[\"phase\"] == \"ready\" && c[\"lastTurn\"] == \"completed\"\n    })\n    .await;\n    assert_eq!(c[\"opening\"], opening.as_str(), \"{c}\");\n    assert!(settle(|| !desk.conversation()[\"savedAt\"].is_null()).await);\n    let history = c[\"historyId\"].as_str().expect(\"id\").to_owned();\n    desk.say(&id, \"And the second question?\")\n        .await\n        .expect(\"sent\");\n    let _ = answered_with(&mut desk, |c| {\n        c[\"phase\"] == \"ready\" && c[\"entries\"].as_array().is_some_and(|e| e.len() >= 4)\n    })\n    .await;\n    desk.end(&id).await;\n    // Ended, it still shows its opening whole.\n    assert_eq!(desk.conversation()[\"opening\"], opening.as_str());\n    // Saved: listed by a shortened one-line title, opened with the opening whole.\n    let context = desk.context();\n    let workspace = desk.json()[\"gateway\"][\"selected\"][\"reference\"].clone();\n    desk.send(json!({\"kind\": \"listHarnessHistory\", \"context\": context, \"workspace\": workspace}))\n        .await\n        .expect(\"list\");\n    assert!(settle(|| desk.json()[\"harness\"][\"history\"][\"state\"] == \"ready\").await);\n    let listed = desk.json()[\"harness\"][\"history\"][\"conversations\"].clone();\n    let title = listed\n        .as_array()\n        .and_then(|l| l.iter().find(|c| c[\"id\"] == history.as_str()))\n        .and_then(|c| c[\"title\"].as_str())\n        .expect(\"listed\")\n        .to_owned();\n    assert!(title.ends_with('…') && !title.contains('\\n'), \"{title}\");\n","exit_code":0,"status":"completed"}}
