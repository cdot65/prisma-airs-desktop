{"type":"item.completed","item":{"id":"item_30","type":"command_execution","command":"/bin/zsh -lc \"sed -n '260,719p' apps/desktop/src/v2/workbench/api-client.tsx\"","aggregated_output":"            <div className='min-w-0'>\n                <h1 ref={ref} id='workbench-heading' tabIndex={-1} className='font-bold' style={{ fontSize: 'var(--v2-title)', letterSpacing: '-0.01em' }}>\n                    {C.title}\n                </h1>\n                <p className='text-[14px]' style={{ marginTop: 4, ...soft }} data-slot='api-lead'>\n                    {collection ? C.lead(collection.name, tenant ? `${where} · ${tenant.label}` : where) : C.leadNone}\n                </p>\n            </div>\n            {collection ? (\n                <div className='ml-auto flex min-w-0 max-w-full flex-wrap items-center' style={{ gap: 8 }} data-slot='api-chips'>\n                    <span className='relative'>\n                        <button\n                            ref={chip}\n                            type='button'\n                            aria-haspopup='menu'\n                            aria-expanded={menu}\n                            aria-label={`${C.chips.collection} ${collection.name}`}\n                            className={CHIP}\n                            style={chipStyle}\n                            onClick={(e) => {\n                                e.stopPropagation()\n                                setMenu((m) => !m)\n                            }}\n                            data-slot='collection-chip'\n                        >\n                            <Glyph name='folder' size={13} color='var(--v2-ink)' />\n                            <span style={faint}>{C.chips.collection}</span>\n                            <b>{collection.name}</b>\n                            <span style={faint}>{where}</span>\n                            <Glyph name='chev' size={10} color='var(--v2-faint)' />\n                        </button>\n                        {menu ? (\n                            <div\n                                role='menu'\n                                aria-label={C.menu}\n                                className='absolute top-full right-0 z-10 mt-1 flex min-w-52 flex-col rounded-[10px] border p-1 text-[13px]'\n                                style={{\n                                    borderColor: 'var(--v2-rule)',\n                                    background: 'var(--v2-paper)',\n                                    boxShadow: '0 12px 30px rgba(0,0,0,0.18)',\n                                }}\n                                data-slot='collection-menu'\n                            >\n                                <button type='button' role='menuitem' className='rounded-[7px] px-3 py-1.5 text-left' onClick={() => void run({ kind: 'refresh' })}>\n                                    {C.refresh}\n                                </button>\n                                {TOOLS.map((t) => (\n                                    <button key={t} type='button' role='menuitem' className='rounded-[7px] px-3 py-1.5 text-left' aria-haspopup='dialog' onClick={() => setTool(t)}>\n                                        {C.tools[t]}\n                                    </button>\n                                ))}\n                                <button type='button' role='menuitem' className='rounded-[7px] px-3 py-1.5 text-left' onClick={() => void close({ kind: 'collection' })}>\n                                    {C.closeCollection}\n                                </button>\n                            </div>\n                        ) : null}\n                    </span>\n                    <label className={CHIP} style={chipStyle} data-slot='environment-chip'>\n                        <span\n                            aria-hidden\n                            className='rounded-full'\n                            style={{\n                                width: 8,\n                                height: 8,\n                                background: environment ? 'var(--v2-ok)' : 'var(--v2-faint)',\n                            }}\n                        />\n                        <span style={faint}>{C.chips.environment}</span>\n                        <select\n                            aria-label={C.chips.environment}\n                            value={collection.environment ?? ''}\n                            onChange={(e) =>\n                                void run({\n                                    kind: 'selectEnvironment',\n                                    name: e.target.value === '' ? null : e.target.value,\n                                })\n                            }\n                            className='min-h-0 border-0 bg-transparent font-bold'\n                            style={{\n                                border: 0,\n                                minHeight: 0,\n                                height: 24,\n                                padding: 0,\n                                borderRadius: 0,\n                                background: 'transparent',\n                                color: 'var(--v2-ink)',\n                            }}\n                        >\n                            <option value=''>{C.chips.noEnvironment}</option>\n                            {collection.environments.map((e) => (\n                                <option key={e.name} value={e.name}>\n                                    {e.name}\n                                </option>\n                            ))}\n                        </select>\n                        {environment ? <span style={faint}>{C.chips.envOrigin[environment.origin] ?? environment.origin}</span> : null}\n                    </label>\n                </div>\n            ) : null}\n        </div>\n    )\n\n    const alerts = (\n        <>\n            {state.network !== 'live' ? (\n                <p className='text-[12px]' style={faint} data-slot='workbench-network'>\n                    {state.network === 'loopbackOnly' ? C.network.loopbackOnly : C.network.none}\n                </p>\n            ) : null}\n            {state.failure ? (\n                <p role='alert' className='rounded-[10px] text-[13px]' style={{ padding: '12px 14px', background: 'var(--v2-block-bg)' }}>\n                    {C.privateFailure(state.failure)}\n                </p>\n            ) : null}\n            {message && collection ? (\n                <p role='alert' className='text-[13px]' style={{ color: 'var(--v2-block)' }} data-slot='workbench-message'>\n                    {message}\n                </p>\n            ) : null}\n            {collection?.issues.length ? (\n                <div role='alert' className='rounded-[10px] text-[13px]' style={{ padding: '12px 14px', background: 'var(--v2-flag-bg)' }} data-slot='workbench-issues'>\n                    <p>{C.issues(collection.issues.length, collection.complete)}</p>\n                    <ul className='mt-1 list-disc pl-5 text-[12px]'>\n                        {collection.issues.slice(0, 10).map((i) => (\n                            <li key={`${i.relative}:${i.kind}`}>{`${i.relative}: ${i.kind}`}</li>\n                        ))}\n                    </ul>\n                </div>\n            ) : null}\n            {collection?.unsaved ? (\n                <p role='alert' className='rounded-[10px] text-[13px]' style={{ padding: '12px 14px', background: 'var(--v2-block-bg)' }}>\n                    {C.unsaved(collection.unsaved)}\n                </p>\n            ) : null}\n        </>\n    )\n\n    if (!state.available) {\n        return (\n            <section\n                aria-labelledby='workbench-heading'\n                data-slot='api-client-v2'\n                className='flex min-h-0 min-w-0 flex-grow flex-col'\n                style={{\n                    margin: 'calc(-1 * var(--v2-page-top)) calc(-1 * var(--v2-page-x)) -28px',\n                }}\n            >\n                {band}\n                <p role='alert' className='text-[13px]' style={{ padding: '20px var(--v2-page-x)' }}>\n                    {C.unavailable}\n                </p>\n            </section>\n        )\n    }\n\n    return (\n        <section\n            aria-labelledby='workbench-heading'\n            data-slot='api-client-v2'\n            className='flex min-h-0 min-w-0 flex-grow flex-col'\n            style={{\n                margin: 'calc(-1 * var(--v2-page-top)) calc(-1 * var(--v2-page-x)) -28px',\n            }}\n        >\n            {band}\n            {!collection ? (\n                <div className='flex flex-col' style={{ gap: 12, padding: '20px var(--v2-page-x)' }}>\n                    {alerts}\n                    {state.loaded ? (\n                        <Start state={state} run={run} message={message} offerNew={offerNew} />\n                    ) : (\n                        <p role='status' className='text-[13px]' style={soft}>\n                            {C.opening}\n                        </p>\n                    )}\n                </div>\n            ) : (\n                <>\n                    <div className='flex min-h-0 flex-grow' data-slot='api-body'>\n                        <RequestTree\n                            collection={collection}\n                            onOpen={open}\n                            onCreate={async (kind, relative) => {\n                                // A new request's document is a load too: bound to this collection and the current generation.\n                                const load = kind === 'request' ? beginLoad(null) : null\n                                const r = await run(kind === 'request' ? { kind: 'newRequest', relative } : { kind: 'newFolder', relative })\n                                if (load) settleLoad(load, r, true)\n                                // The dialog says a refusal or a lost delivery itself (the page behind it is inert).\n                                return r.kind === 'document' || r.kind === 'done' || r.kind === 'cancelled' ? null : (resultText(r) ?? C.unknownFailure)\n                            }}\n                        />\n                        <div className='flex min-h-0 min-w-0 flex-grow flex-col' data-slot='api-main'>\n                            <div\n                                role='tablist'\n                                aria-label={C.openRequests}\n                                className='flex shrink-0 flex-wrap items-end'\n                                style={{\n                                    minHeight: 36,\n                                    gap: 2,\n                                    padding: '0 8px',\n                                    borderBottom: '1px solid var(--v2-rule)',\n                                    background: 'var(--v2-side)',\n                                }}\n                                data-slot='workbench-tabs'\n                            >\n                                {collection.tabs.map((t) => {\n                                    const name = requestName(t.relative)\n                                    const on = t.id === collection.selected\n                                    const marks = [t.new ? 'new' : t.draft ? 'unsaved' : '', t.conflict ? `${t.conflict} on disk` : '', t.interrupted ? 'interrupted save' : '']\n                                        .filter(Boolean)\n                                        .join(', ')\n                                    return (\n                                        <span\n                                            key={t.id}\n                                            className='flex items-center rounded-t-[7px] border border-b-0'\n                                            style={{\n                                                height: 30,\n                                                maxWidth: 240,\n                                                borderColor: on ? 'var(--v2-rule)' : 'transparent',\n                                                background: on ? 'var(--v2-bg)' : 'transparent',\n                                            }}\n                                        >\n                                            <button\n                                                type='button'\n                                                role='tab'\n                                                aria-selected={on}\n                                                aria-label={`${t.method} ${name}${marks ? ` (${marks})` : ''}`}\n                                                onClick={() => void run({ kind: 'selectTab', id: t.id })}\n                                                className='flex min-h-0 min-w-0 items-center text-[12px] whitespace-nowrap'\n                                                style={{\n                                                    gap: 7,\n                                                    height: 28,\n                                                    padding: '0 6px 0 12px',\n                                                    border: 0,\n                                                    background: 'transparent',\n                                                    color: 'var(--v2-ink)',\n                                                }}\n                                            >\n                                                <span className='font-mono text-[11px] font-bold' style={{ color: methodColor(t.method) }}>\n                                                    {t.method}\n                                                </span>\n                                                <span className='truncate'>{name}</span>\n                                                {t.draft || t.new ? (\n                                                    <span\n                                                        aria-hidden\n                                                        className='shrink-0 rounded-full'\n                                                        style={{\n                                                            width: 6,\n                                                            height: 6,\n                                                            background: 'var(--v2-acc)',\n                                                        }}\n                                                    />\n                                                ) : null}\n                                                {t.conflict || t.interrupted ? <Glyph name='alert' size={11} color='var(--v2-flag)' /> : null}\n                                            </button>\n                                            <button\n                                                type='button'\n                                                aria-label={C.closeTab(name)}\n                                                onClick={() => void close({ kind: 'tab', id: t.id, name })}\n                                                className='grid size-6 min-h-0 place-items-center rounded-[5px] text-[13px]'\n                                                style={{\n                                                    border: 0,\n                                                    background: 'transparent',\n                                                    ...faint,\n                                                }}\n                                            >\n                                                ×\n                                            </button>\n                                        </span>\n                                    )\n                                })}\n                            </div>\n                            {alerts !== null ? (\n                                <div className='flex flex-col empty:hidden' style={{ gap: 8, padding: '0 20px' }}>\n                                    {alerts}\n                                </div>\n                            ) : null}\n                            {loadFailure && doc?.id !== loadFailure.id ? (\n                                <div role='alert' className='flex flex-wrap items-center text-[13px]' style={{ gap: 10, margin: '16px 20px 0', padding: '12px 14px', borderRadius: 10, background: 'var(--v2-block-bg)' }} data-slot='workbench-load-failed'>\n                                    <span className='min-w-0 flex-grow'>{C.loadFailed(requestName(loadFailure.relative), loadFailure.text)}</span>\n                                    <Btn onClick={() => open({ id: loadFailure.id, relative: loadFailure.relative })}>{C.tryAgain}</Btn>\n                                </div>\n                            ) : null}\n                            {/* Scope ownership is checked in this commit, before passive effects clear the old document. */}\n                            {doc && docCollection.current === collectionId && selectedTab && doc.id === selectedTab.id ? (\n                                <RequestEditor\n                                    key={`${doc.id}:${doc.revision}:${doc.relative}:${docSeq}`}\n                                    initial={doc}\n                                    notes={notes}\n                                    call={call}\n                                    schemas={collection.schemas}\n                                    historyKey={`${collection.id}:${state.running.length}`}\n                                    onClosed={() => setDoc(null)}\n                                    register={(handle) => editors.current.set(doc.id, handle)}\n                                    context={snapshot.active?.context ?? null}\n                                    running={state.running.filter((r) => r.request === doc.id)}\n                                    review={state.review?.request === doc.id ? state.review : null}\n                                />\n                            ) : collection.tabs.length === 0 ? (\n                                <p className='text-[13px]' style={{ padding: '20px', ...soft }} data-slot='workbench-empty'>\n                                    {collection.requests.length === 0 ? C.noRequests : C.selectRequest}\n                                </p>\n                            ) : null}\n                            <div\n                                className='flex shrink-0 items-center text-[12px]'\n                                style={{\n                                    height: 26,\n                                    gap: 14,\n                                    padding: '0 14px',\n                                    borderTop: '1px solid var(--v2-rule)',\n                                    background: 'var(--v2-side)',\n                                    ...faint,\n                                }}\n                                data-slot='api-footer'\n                            >\n                                <span className='flex items-center' style={{ gap: 5 }}>\n                                    <span\n                                        aria-hidden\n                                        className='rounded-full'\n                                        style={{\n                                            width: 6,\n                                            height: 6,\n                                            background: state.busy ? 'var(--v2-flag)' : 'var(--v2-ok)',\n                                        }}\n                                    />\n                                    {state.busy ? C.working : C.footer.ready}\n                                </span>\n                                <span className='ml-auto'>{C.footer.requests(collection.requests.length)}</span>\n                                {collection.archives ? <span>{C.footer.archives(collection.archives)}</span> : null}\n                            </div>\n                        </div>\n                    </div>\n                    {tool ? (\n                        <ToolsSheet\n                            tool={tool}\n                            state={state}\n                            collection={collection}\n                            run={run}\n                            onClose={() => setTool(null)}\n                            importCurl={async (text, relative) => {\n                                // A cURL import's draft is a load of this collection: begun before the call, settled against it.\n                                const load = beginLoad(null)\n                                const r = await run({ kind: 'importCurl', text, relative })\n                                settleLoad(load, r, true)\n                                return r\n                            }}\n                            onCreated={() => setTool(null)}\n                            returnFocus={chip.current}\n                        />\n                    ) : null}\n                </>\n            )}\n            {closing\n                ? createPortal(\n                      <Modal label={closing.kind === 'tab' ? C.closing.tab(closing.name) : C.closing.collection} width={480} onClose={() => setClosing(null)} data-slot='workbench-closing-dialog'>\n                          <div\n                              role='alertdialog'\n                              aria-label={closing.kind === 'tab' ? C.closing.tab(closing.name) : C.closing.collection}\n                              className='flex flex-col text-[13px]'\n                              style={{ gap: 12 }}\n                              data-slot='workbench-closing'\n                          >\n                              <h2 className='text-[17px] font-bold'>{closing.kind === 'tab' ? C.closing.tab(closing.name) : C.closing.collection}</h2>\n                              <p>{C.closing.text}</p>\n                              <div className='flex justify-end' style={{ gap: 8 }}>\n                                  <Btn onClick={() => setClosing(null)}>{C.closing.keep}</Btn>\n                                  <Btn tier='primary' onClick={() => void close(closing, true)}>\n                                      {C.closing.discard}\n                                  </Btn>\n                              </div>\n                          </div>\n                      </Modal>,\n                      document.body\n                  )\n                : null}\n        </section>\n    )\n})\n\n/** No collection open: open, create, the built-in, recents and the v1 profile import. */\nfunction Start({ state, run, message, offerNew }: { state: WorkbenchState; run: Run; message: string; offerNew: boolean }) {\n    const [chosen, setChosen] = useState<number[]>([])\n    return (\n        <div className='flex flex-col' style={{ gap: 14, maxWidth: 760 }} data-slot='workbench-start'>\n            <p className='text-[14px]'>{C.start.none}</p>\n            {message ? (\n                <div\n                    role='alert'\n                    className='flex flex-col rounded-[10px] text-[13px]'\n                    style={{\n                        gap: 8,\n                        padding: '12px 14px',\n                        background: 'var(--v2-flag-bg)',\n                    }}\n                    data-slot='workbench-message'\n                >\n                    <p>{message}</p>\n                    {offerNew ? (\n                        <Btn className='self-start' onClick={() => void run({ kind: 'createCollection' })}>\n                            {C.start.create}\n                        </Btn>\n                    ) : null}\n                </div>\n            ) : null}\n            <div className='flex flex-wrap' style={{ gap: 8 }}>\n                <Btn tier='primary' onClick={() => void run({ kind: 'openFolder' })}>\n                    {C.start.open}\n                </Btn>\n                <Btn onClick={() => void run({ kind: 'createCollection' })}>{C.start.create}</Btn>\n                <Btn onClick={() => void run({ kind: 'openBuiltIn' })}>{C.start.builtIn}</Btn>\n            </div>\n            <p className='text-[12px]' style={faint}>\n                {C.start.builtInNote}\n            </p>\n            {state.recent.length ? (\n                <section aria-label={C.start.recent} className='flex flex-col' style={{ gap: 6 }}>\n                    <h2 className='text-[15px] font-semibold'>Recent</h2>\n                    {state.recent.map((r) => (\n                        <Btn key={r.index} tier='tertiary' className='self-start' onClick={() => void run({ kind: 'openRecent', index: r.index })}>\n                            {`${r.name} (${r.folder})`}\n                        </Btn>\n                    ))}\n                </section>\n            ) : null}\n            {state.adoption ? (\n                <section\n                    aria-label='v1 API Client profile'\n                    className='flex flex-col rounded-[12px] border text-[13px]'\n                    style={{\n                        gap: 8,\n                        padding: 16,\n                        borderColor: 'var(--v2-rule)',\n                        background: 'var(--v2-paper)',\n                    }}\n                    data-slot='workbench-adoption'\n                >\n                    <h2 className='text-[15px] font-semibold'>{C.start.adoption}</h2>\n                    <p style={soft}>{C.start.adoptionLead}</p>\n                    {state.adoption.length === 0 ? <p>{C.start.adoptionNone}</p> : null}\n                    {state.adoption.map((c) => (\n                        <label key={c.index} className='flex items-center' style={{ gap: 8 }}>\n                            <input type='checkbox' checked={chosen.includes(c.index)} onChange={(e) => setChosen((x) => (e.target.checked ? [...x, c.index] : x.filter((i) => i !== c.index)))} />\n                            {`${c.name} (${c.folder}) · ${c.environments.length} private environments${c.skipped ? ` · ${c.skipped} left out` : ''}`}\n                        </label>\n                    ))}\n                    <div className='flex flex-wrap' style={{ gap: 8 }}>\n                        <Btn tier='primary' disabled={chosen.length === 0} onClick={() => void run({ kind: 'adopt', selected: chosen })}>\n                            {C.start.importSelected}\n                        </Btn>\n                        <Btn onClick={() => void run({ kind: 'dismissAdoption' })}>{C.start.startEmpty}</Btn>\n                    </div>\n                </section>\n            ) : !state.adoptionSettled ? (\n                <Btn tier='tertiary' className='self-start' onClick={() => void run({ kind: 'readAdoption' })}>\n                    {C.start.readAdoption}\n                </Btn>\n            ) : null}\n        </div>\n    )\n}\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_31","type":"command_execution","command":"/bin/zsh -lc \"cat docs/architecture/ui-v2/DESIGN-V2.md; cat apps/desktop/src/v2/academy/academy.tsx; sed -n '1,180p' apps/desktop/src/v2/modal.tsx\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_31","type":"command_execution","command":"/bin/zsh -lc \"cat docs/architecture/ui-v2/DESIGN-V2.md; cat apps/desktop/src/v2/academy/academy.tsx; sed -n '1,180p' apps/desktop/src/v2/modal.tsx\"","aggregated_output":"# UI v2 \"Refined Native\" — design specification\n\nStatus: C27 deliverable, reviewed at the 9/10 bar (D058). This document and\nits companions ([tokens](tokens.md), [state ownership](state-ownership.md),\n[invariants](invariants.md), [screens](screens/), [provenance](provenance.md))\nare what every P09 chunk is judged against. The existing\n[DESIGN.md](../DESIGN.md) remains authoritative for the native authority\ninterface, transport, Academy presentation ownership and the Harness; this\ndocument changes only how the desktop presents those.\n\n## 1. Scope and deliverable\n\nThe reviewed prototype is extracted in three layers, in order:\n\n1. **Spec** (C27, this folder): tokens, screen inventory, state ownership,\n   invariants, interaction contracts, copy, provenance, acceptance criteria.\n2. **TypeScript presentation** (C28–C29, then per-destination chunks): the new\n   shell and screens in `apps/desktop`, built against wire fixtures and the\n   mock runtime, behind a Rust-owned `ui_variant` flag.\n3. **Rust contract** (within each destination chunk): the intents, scopes and\n   refusals the screens need, implemented over existing desktop-core services\n   and exported through ts-rs.\n\nThe first implementation slice is the shell plus the first-run wizard and\nadd-tenant sheet (C28–C29). Harness, Inbox/reads, reviews/Administration, API\nClient, Test Cases and the Academy embed follow (C30–C34). The legacy shell,\nits feature-view switch, the flag and the legacy native acceptance scripts are\nremoved in C34; the phase is not complete while any destination renders only\nin the legacy shell.\n\n## 2. Frozen reference\n\nCanvas https://claude.ai/artifact/2SEXT1XMHdZkxHvdw8oaYL, page \"Refined Native\nv2\", version 134. The six R2 files are copied verbatim under\n[prototype/](prototype/) with SHA-256 hashes in `MANIFEST.sha256`. They are\nimmutable inputs. Codex scored the prototype 8/10 on rounds 4–16; the five\nopen round-16 items are carried as known gaps (§10) and closed in\nimplementation, not by further prototype rounds.\n\n## 3. Architecture fit\n\n- **Authority** stays with desktop-core (D014). The UI dispatches intents and\n  observes scopes through the existing two-command Tauri bridge. Every\n  prototype state field is assigned in [state-ownership.md](state-ownership.md);\n  no persisted or tenant-sensitive state is UI-owned (UI state is transient\n  presentation state only), and no state goes to browser storage.\n- **Contract**: new intents, scopes and refusals are Rust types with ts-rs\n  derives, regenerated by `xtask bindings`. A hand-written parser is added to\n  the contracts client only where runtime validation beyond the type is needed.\n- **Shell flag**: `ShellSnapshot.ui_variant` (`legacy` | `v2`) and\n  `ShellSnapshot.onboarding` (`needed` | `inProgress` | `done`) are Rust-owned,\n  fixture-able and seedable by native acceptance. The React root switches on\n  them.\n- **Navigation inventory**: one Rust list (feature ids with availability,\n  label, shortcut index and sidebar membership) feeds the native menu, the\n  sidebar and the command palette. Feature ids gain `home` and `inbox`;\n  `library` is shown as \"Test Cases\"; `gateway` and `redTeam` render inside\n  Administration's accordion; `sessions`, `import` and `settings` stay\n  reachable from the palette and Administration.\n- **Shortcuts** ⌘1–⌘9 are defined by the native menu, which dispatches\n  `navigate`; the sidebar displays the menu's truth.\n- **Transient state**: a small zustand store per screen family (shell, wizard,\n  inbox, admin, harness, workbench); React state only for form fields.\n- **Tokens**: local `--v2-*` custom properties ([tokens.md](tokens.md));\n  Academy variables untouched for the embedded learner view.\n- **Copy**: one `copy.ts` per screen family exporting constants; tests assert\n  exact strings. The voice is the wizard's: this app is built entirely on\n  Palo Alto Networks' public APIs and exists to show application builders what\n  those interfaces make possible; it explains the API call as you go.\n- **Show the calls**: a Rust-owned preference reveals, for each action, the\n  request and response as the diagnostics module already redacts them\n  (credential ids in place of secrets, a note that the core attaches the real\n  header). Default on until onboarding completes.\n\n## 4. Layout rhythm\n\nShared by every destination, the wizard and the add-tenant sheet:\n\n- 32px top and 44px side page margins; 26px/700 titles; 18–20px card\n  padding; 10–12px gaps; 32px controls; 14px body, 12px secondary (11px only\n  pills, eyebrows and mono badges); 860px reading cap; 244px rail (first-run\n  wizard rail 320px).\n- Minimum window 1180×720. Below 1280 wide the rail collapses to icons with\n  tooltips; nothing scrolls horizontally.\n- Tool workspaces (Harness, API Client) have a title row like every other\n  destination; no destination is exempt from the rhythm.\n\n## 5. Destinations\n\n| Sidebar | Feature id | Shortcut | Contract |\n|---|---|---|---|\n| Home | `home` (new) | ⌘1 | [screens/shell.md](screens/shell.md) |\n| Inbox | `inbox` (new) | ⌘2 | [screens/inbox-reads.md](screens/inbox-reads.md) |\n| Harness | `harness` | ⌘3 | [screens/harness.md](screens/harness.md) |\n| Academy | `academy` | ⌘4 | [screens/academy.md](screens/academy.md) |\n| Test Cases | `library` | ⌘5 | [screens/api-client-test-cases.md](screens/api-client-test-cases.md) |\n| API Client | `apiClient` | ⌘6 | same |\n| Administration | `administration` (+ `gateway`, `redTeam` inside) | ⌘7 | [screens/reviews-administration.md](screens/reviews-administration.md) |\n| Tenant switcher | — | ⌘T | [screens/shell.md](screens/shell.md) |\n| Command palette | — | ⌘K | same |\n| First-run wizard, add-tenant sheet | — | — | [screens/wizard.md](screens/wizard.md) |\n\nRed Team is read-only everywhere. Gamification appears only inside the Academy\nembed. Product availability is governed by §6.\n\n## 6. Products, admitted services and the unsupported boundary\n\nThe prototype shows six products. Only a product with an admitted service in\ndesktop-core is verified, inventoried or changed; the rest render as\nunavailable. Nothing in P09 adds a product API.\n\n| Product | Admitted reads | Admitted changes | P09 treatment |\n|---|---|---|---|\n| AI Runtime Security | `ManagementResource` (profiles, topics, applications, API keys, deployment profiles, DLP catalog/profiles/patterns, filtering profiles, dictionaries, sessions); scan (`scan.rs`) | `ChangeKind` Profiles, Topics, Applications, ApiKeys, DataPatterns, DataProfiles, FilteringProfiles, Dictionaries with `ChangeAction` Create/Version/Rotate/Delete/… (`changes.rs`) | Full: Administration tabs, reviews, Playground, Inbox items |\n| AI Gateway | `GatewayRead` (inventory, detail, integration models, prerequisites, observe, MCP servers) | Gateway `ChangeKind`s (workspaces, providers, routes, guardrails, service/user keys, integrations) | Full, inside Administration; Harness lifecycle 2 reads `McpServers` |\n| AI Red Teaming | `red_team.rs` reads (scan inventory, statistics, static reports; C13) | none (execution stays a disabled preview) | Read-only card and tabs; Test Cases \"Inspect\" only |\n| Model/skill observability (AI Supply Chain in the prototype) | C13 model/skill reads | none | Read-only; shown under its C13 name, never as a scanning product |\n| Agentic Identity Security | none | none | **Not available in this release**: card and accordion entry with the dependency gate (\"needs an admitted AIS service; see D058\"); not selectable in the wizard; never verified; no inventory, no policy review |\n| Agentic Endpoint Security | none | none | Same as AIS; the prototype's AES policy review, discovered-AI table and warning demo are fixtures only and are not implemented |\n\nThe per-tab and per-action mapping, including the restricted Runtime and\nGateway change matrices (for example no application Create, no API-key\nUpdate, no data-profile Delete) and every removed or unavailable prototype\ntab, is enumerated in\n[screens/administration-inventory.md](screens/administration-inventory.md).\n\nRules: an unavailable product or tab never produces a verification result, an\nInbox item, an inventory row or a review. The wizard's verify step lists it\nas \"Not available\" (not pass, warning or fail). Test V2-T19 asserts that the\nadmin inventory for an unavailable product has no tabs and no actions, and\nV2-R10 asserts that no intent exists that would mutate it; V2-T20 and V2-R11\ncover unavailable tabs and denied actions within admitted products.\n\n## 7. Error presentation\n\n- **Refusal** (core refused an intent): warn toast with the refusal reason and\n  the tenant named; never a modal. Guard-type refusals (tenant switch with a\n  pending decision) render their dialog from the refusal payload.\n- **Delivery unknown**: inline \"not confirmed\" state on the control that\n  dispatched, with Retry; the control is not reset.\n- **Contract violation**: generic warn toast; detail to diagnostics.\n\n## 8. Accessibility additions\n\nThe native acceptance checklist gains four items that every P09 chunk's\nacceptance script asserts: accent-colour focus ring on every focusable\ncontrol (inset variant where declared); `role=\"status\"` live regions for read\nstatus, API send completion and review apply; one topmost modal with\n`aria-hidden` siblings and focus return; toasts persist under Reduce Motion.\nExisting requirements (keyboard-only, VoiceOver attributes, 150%/200% zoom,\ncontrast AA) continue to apply to every changed screen.\n\n## 9. Budgets\n\nExisting `budgets.json` entries carry unchanged. New: a tenant switch renders\nthe new tenant's Home from cached scopes within 100 ms, with read status\nshowing pending until the read lands (measured by the C30 workload).\n\n## 10. Known gaps carried from the prototype\n\nCodex round 16 (score 8) left five items, closed by the chunk named:\n\n1. Secret disclosure survives a tenant switch with the key review open → I6, C31.\n2. Applied injection-override examples show \"Not demonstrated\" → topic\n   verdicts keyed separately from detectors, profile-aware, C31.\n3. Administration creation labels from a per-product single value → per-tab\n   `AdminInventory` capability and label, C31.\n4. Home snooze tooltip hard-codes \"Snooze 24 hours\" → shared item\n   `snoozeLabel`, I11, C30.\n5. API Client Send announces nothing → `role=\"status\"` completion region, C33.\n\n## 11. Verification\n\n- Behaviour: Vitest + Testing Library component tests, one named fixture per\n  prototype wrapper board; the board → initial props → test id table is in\n  [screens/boards.md](screens/boards.md), so reviewed-state coverage can be\n  audited without reconstructing canvas wrappers.\n- Contract: Rust integration tests per invariant (`V2-Rxx`).\n- Native: the existing Accessibility-API scripts, extended per chunk, plus a\n  screenshot evidence set per chunk at 100% and 200% zoom in both themes filed\n  under `evidence/Cxx/screens/`.\n- Live: only C29 (wizard verify against Vulture, reads only) and C31 (review\n  apply against Redtail under the `airs-v2-c25-` prefix) run live, inside the\n  scope the owner designated on 2026-10-25. Every other chunk runs on fixtures\n  and the mock runtime.\n- Review: C27 at 9/10 in every dimension, enforced by the controller (a\n  `docs_only` chunk refuses owner acceptance and needs no native\n  preparation); C28–C34 may complete at 8 under D034 and are raised to 9\n  before the P09 phase review.\n- Legacy native scripts removed in C34 are first mapped, assertion by\n  assertion, to replacement native-check ids (C34 milestone 2), so the\n  cumulative P09 gate keeps exercising every earlier authority and\n  accessibility requirement.\nimport { createContext, forwardRef, lazy, Suspense, useCallback, useContext, useEffect, useImperativeHandle, useMemo, useRef, useState } from 'react'\nimport { useQuery, useQueryClient } from '@tanstack/react-query'\nimport { createMemoryHistory, createRootRoute, createRoute, createRouter, Link, Outlet, redirect, RouterProvider } from '@tanstack/react-router'\nimport {\n    AssessmentIntroPage,\n    AssessmentPage,\n    CertificatePage,\n    CompletionMoments,\n    CoursePage,\n    currentCourseSlug,\n    DossierPage,\n    HomePage,\n    IdentityPracticalPage,\n    LEARNER_ACCOUNT_NAV,\n    LEARNER_NAV,\n    LearnerAccountPage,\n    LearnPage,\n    MyCertificatePage,\n    NotificationsPage,\n    OnboardingPage,\n    OrientationPage,\n    PathLandingPage,\n    ProgramHubPage,\n    ShiftEntryPage,\n    ShopPage,\n    UnitPage,\n    useLearnerPageHeader,\n    WeeklyBoardPage,\n} from '@ai-security-academy/learner'\nimport type { DesktopClient, FeatureId, ShellSnapshot } from '@prisma-airs/desktop-contracts'\nimport { LearnerProvider, useLearnerTrpc } from '../../features/academy/learner-provider'\nimport { DownloadsPage, OfflineNotice, OfflineWorkProvider } from '../../features/academy/offline-work'\nimport { Btn } from '../controls'\nimport { Glyph, type GlyphName } from '../icons'\nimport { ACADEMY_COPY as C } from './copy'\n\nexport interface AcademyProps {\n    snapshot: ShellSnapshot\n    client: DesktopClient\n    onNavigate: (id: FeatureId) => void\n    /** The learner path to open (default `/learn`). */\n    initialPath?: string\n}\n\n// Fixture builds only; never loaded otherwise.\nconst LearnerCallProbe = lazy(() => import('../../features/academy/learner-call-probe'))\n\nconst faint = { color: 'var(--v2-faint)' }\nconst soft = { color: 'var(--v2-soft)' }\nconst CARD = { background: 'var(--v2-paper)', border: '1px solid var(--v2-rule)', borderRadius: 12 }\n\n/** The Rust-owned appearance as the learner host's theme. */\nexport function themeFor(appearance: ShellSnapshot['appearance']): 'gruvbox' | 'paper' {\n    if (appearance === 'dark') return 'gruvbox'\n    if (appearance === 'light') return 'paper'\n    return typeof window !== 'undefined' && window.matchMedia?.('(prefers-color-scheme: dark)').matches ? 'gruvbox' : 'paper'\n}\n\n/** A learning path as Academy's catalog lists it (the fields the row draws). */\ninterface PathRow {\n    id: string\n    slug: string\n    title: string\n    /** The path's one-line summary, as `paths.list` names it. */\n    tagline: string\n    familyKey: string | null\n    unitCount: number\n    unitsDone: number\n    estMinutes: number | null\n    locked: boolean\n}\n\n/**\n * The learner's place (the right card's state lines), provided by `Academy`\n * from the snapshot and read by the router's root on every render, so the\n * card follows the snapshot while the router (memoised per generation)\n * stays mounted.\n */\nconst PlaceContext = createContext<React.ReactNode>(null)\n\n/**\n * The React Query key Academy's own `trpc.paths.list.useQuery()` uses\n * (tRPC react-query: the procedure path split, then `{ type: 'query' }`\n * with no input). Sharing it means one cache entry per generation: the\n * embed's prefetch fills it, and `utils.paths.list.invalidate()` after a\n * course reset or an enrollment change refetches this row too. The entry\n * holds the procedure's raw reply; the row reads it through `pathRows`.\n */\nexport const PATHS_LIST_KEY = [['paths', 'list'], { type: 'query' }] as const\n\n/** Academy's mutations that move a path's progress (tRPC mutation keys: the procedure path). */\nexport const PROGRESS_MUTATIONS: readonly (readonly string[])[] = [\n    ['units', 'complete'],\n    ['units', 'submitKnowledgeCheck'],\n    // A desktop lab's submission completes its unit when it passes (the hosted grade decides).\n    ['desktop', 'attempt', 'submit'],\n]\n\nfunction pathRows(rows: unknown): PathRow[] {\n    if (!Array.isArray(rows)) return []\n    return rows.flatMap((r) => {\n        if (!r || typeof r !== 'object') return []\n        const o = r as Record<string, unknown>\n        if (typeof o.id !== 'string' || typeof o.slug !== 'string' || typeof o.title !== 'string') return []\n        return [\n            {\n                id: o.id,\n                slug: o.slug,\n                title: o.title,\n                tagline: typeof o.tagline === 'string' ? o.tagline : '',\n                familyKey: typeof o.familyKey === 'string' ? o.familyKey : null,\n                unitCount: typeof o.unitCount === 'number' ? o.unitCount : 0,\n                unitsDone: typeof o.unitsDone === 'number' ? o.unitsDone : 0,\n                estMinutes: typeof o.estMinutes === 'number' ? o.estMinutes : null,\n                locked: o.locked === true,\n            },\n        ]\n    })\n}\n\nconst FAMILY_GLYPH: Record<string, GlyphName> = { 'prisma-airs': 'shield', runtime: 'shield', gateway: 'route', 'red-teaming': 'cross', models: 'box', skills: 'code' }\n\n/**\n * Builds the in-memory learner router (one per mounted generation), the\n * legacy destination's routes: reading routes serve guests too; account\n * routes ask a guest to sign in. The root draws the prototype's frame\n * around the page: the page on the left, the learner's place on the right,\n * the Learning paths row beneath.\n */\nfunction academyRouter(onNavigate: (id: FeatureId) => void, initialPath: string, signedIn: boolean) {\n    const root = createRootRoute({\n        component: () => {\n            const place = useContext(PlaceContext)\n            return (\n                <>\n                    <div className='grid min-w-0' style={{ gridTemplateColumns: 'minmax(0, 1.4fr) minmax(0, 1fr)', gap: 16 }} data-slot='academy-frame'>\n                        <section aria-label={C.pages} className='flex min-w-0 flex-col' style={{ ...CARD, padding: '20px 22px', gap: 10 }} data-slot='academy-pages'>\n                            <LearnerTrail />\n                            <LearnerStatus />\n                            <Outlet />\n                        </section>\n                        <section aria-label={C.place} className='flex min-w-0 flex-col self-start' style={{ ...CARD, padding: '20px 22px', gap: 10 }} data-slot='academy-place'>\n                            <span className='text-[11px] font-bold tracking-[0.05em] uppercase' style={faint}>\n                                {C.place}\n                            </span>\n                            {place}\n                            <AcademyNav signedIn={signedIn} />\n                            <OfflineNotice />\n                        </section>\n                    </div>\n                    <PathsRow />\n                </>\n            )\n        },\n        notFoundComponent: () => <NotInThisBuild />,\n    })\n    const signInFirst = () => <SignInHere onNavigate={onNavigate} />\n    const account = (path: string, Page: () => React.ReactNode) => createRoute({ getParentRoute: () => root, path, component: signedIn ? () => <>{Page()}</> : signInFirst })\n    const index = account('/', () => <HomePage />)\n    const program = account('/program', () => <ProgramHubPage />)\n    const downloads = account('/downloads', () => <DownloadsPage />)\n    const assessment = account('/assessment', () => <AssessmentPage />)\n    const assessmentIntro = account('/assessment/intro', () => <AssessmentIntroPage />)\n    const identityPractical = account('/assessment/identity-practical', () => <IdentityPracticalPage />)\n    const exam = createRoute({\n        getParentRoute: () => root,\n        path: '/exam',\n        beforeLoad: () => {\n            throw redirect({ to: '/assessment', replace: true })\n        },\n    })\n    const certificates = account('/certificate', () => <MyCertificatePage />)\n    const certificate = createRoute({\n        getParentRoute: () => root,\n        path: '/certificate/$certId',\n        component: signedIn\n            ? function CertificateRoute() {\n                  return <CertificatePage certId={certificate.useParams().certId} />\n              }\n            : signInFirst,\n    })\n    const shift = account('/shift', () => <ShiftEntryPage />)\n    const dossier = account('/dossier', () => <DossierPage />)\n    const leaderboard = account('/leaderboard', () => <WeeklyBoardPage />)\n    const settings = account('/settings', () => <LearnerAccountPage />)\n    const notifications = account('/notifications', () => <NotificationsPage />)\n    const shop = account('/shop', () => <ShopPage />)\n    const orientation = account('/orientation', () => <OrientationPage />)\n    const onboarding = account('/onboarding', () => <OnboardingPage />)\n    const learn = createRoute({ getParentRoute: () => root, path: '/learn', component: LearnPage })\n    const paths = createRoute({\n        getParentRoute: () => root,\n        path: '/paths',\n        beforeLoad: () => {\n            throw redirect({ to: '/learn', replace: true })\n        },\n    })\n    const path = createRoute({\n        getParentRoute: () => root,\n        path: '/paths/$pathSlug',\n        component: function PathRoute() {\n            return <PathLandingPage pathSlug={path.useParams().pathSlug} />\n        },\n    })\n    const course = createRoute({\n        getParentRoute: () => root,\n        path: '/courses/$courseSlug',\n        beforeLoad: ({ params }) => {\n            const current = currentCourseSlug(params.courseSlug)\n            if (current) throw redirect({ to: '/courses/$courseSlug', params: { courseSlug: current }, replace: true })\n        },\n        component: function CourseRoute() {\n            return <CoursePage courseSlug={course.useParams().courseSlug} />\n        },\n    })\n    const unit = createRoute({\n        getParentRoute: () => root,\n        path: '/units/$unitId',\n        component: function UnitRoute() {\n            return <UnitPage unitId={unit.useParams().unitId} />\n        },\n    })\n    const signIn = createRoute({ getParentRoute: () => root, path: '/sign-in', component: () => <SignInHere onNavigate={onNavigate} /> })\n    return createRouter({\n        routeTree: root.addChildren([\n            index,\n            learn,\n            paths,\n            path,\n            course,\n            unit,\n            signIn,\n            program,\n            assessment,\n            assessmentIntro,\n            identityPractical,\n            exam,\n            certificates,\n            certificate,\n            shift,\n            dossier,\n            leaderboard,\n            settings,\n            notifications,\n            shop,\n            orientation,\n            onboarding,\n            downloads,\n        ]),\n        history: createMemoryHistory({ initialEntries: [initialPath] }),\n        defaultPreload: false,\n        defaultErrorComponent: PageFailed,\n    })\n}\n\n/** Academy's own sections (guests see Learn only) and, signed in, Downloads, Notifications and Settings. */\nfunction AcademyNav({ signedIn }: { signedIn: boolean }) {\n    const items = LEARNER_NAV.filter((item) => signedIn || item.to === '/learn')\n    return (\n        <nav aria-label={C.sections} data-slot='academy-nav' className='flex flex-wrap items-center' style={{ gap: 4 }}>\n            {items.map((item) => (\n                <NavLink key={item.to} to={item.to} label={item.label} />\n            ))}\n            {signedIn ? (\n                <span data-slot='academy-account-nav' className='flex flex-wrap' style={{ gap: 4 }}>\n                    <NavLink to='/downloads' label={C.downloadsLink} />\n                    {LEARNER_ACCOUNT_NAV.map((item) => (\n                        <NavLink key={item.to} to={item.to} label={item.label} />\n                    ))}\n                </span>\n            ) : null}\n        </nav>\n    )\n}\n\nfunction NavLink({ to, label }: { to: string; label: string }) {\n    return (\n        <Link\n            to={to}\n            activeOptions={{ exact: to === '/' }}\n            activeProps={{ 'aria-current': 'page', style: { background: 'var(--v2-acc-soft)', color: 'var(--v2-ink)' } }}\n            className='inline-flex h-8 items-center rounded-[7px] px-3 text-[13px] font-medium'\n            style={{ color: 'var(--v2-soft)' }}\n        >\n            {label}\n        </Link>\n    )\n}\n\n/** Session-critical status a learner page publishes (the assessment's timer), kept in view. */\nfunction LearnerStatus() {\n    const { status } = useLearnerPageHeader()\n    if (!status) return null\n    return (\n        <div data-slot='academy-status' className='sticky top-0 z-10 flex min-h-11 items-center justify-end gap-3 py-2' style={{ background: 'var(--v2-paper)' }}>\n            {status}\n        </div>\n    )\n}\n\n/** The trail each learner page publishes (Learn › Course › Unit), as links within the destination. */\nfunction LearnerTrail() {\n    const { breadcrumbs } = useLearnerPageHeader()\n    if (breadcrumbs.length === 0) return null\n    return (\n        <nav aria-label='Academy location' data-slot='academy-trail'>\n            <ol className='flex flex-wrap items-center text-[13px]' style={{ gap: 4, ...soft }}>\n                {breadcrumbs.map((crumb, index) => {\n                    const last = index === breadcrumbs.length - 1\n                    return (\n                        <li key={`${index}-${crumb.label}`} className='flex items-center' style={{ gap: 4 }}>\n                            {crumb.to && !last ? (\n                                <Link to={crumb.to} className='inline-flex min-h-8 items-center underline'>\n                                    {crumb.label}\n                                </Link>\n                            ) : (\n                                <span aria-current={last ? 'page' : undefined} style={last ? { color: 'var(--v2-ink)' } : undefined}>\n                                    {crumb.label}\n                                </span>\n                            )}\n                            {last ? null : <span aria-hidden='true'>›</span>}\n                        </li>\n                    )\n                })}\n            </ol>\n        </nav>\n    )\n}\n\n/** The Learning paths row: Academy's paths as its catalog lists them for this generation, read through the learner client. */\nfunction PathsRow() {\n    const trpc = useLearnerTrpc() as unknown as { paths: { list: { query(): Promise<unknown> } } }\n    const queryClient = useQueryClient()\n    const query = useQuery({\n        queryKey: PATHS_LIST_KEY,\n        queryFn: () => trpc.paths.list.query(),\n    })\n    // The row stays mounted across the learner's routes, and Academy's own completion hooks refresh the unit,\n    // course and dashboard rollups but not paths.list. A unit completion or a knowledge-check submission that\n    // settles in this generation's cache rereads the row: on success for the new counts, on an error (an\n    // uncertain outcome included) to read Academy's truth back without replaying the mutation.\n    useEffect(\n        () =>\n            queryClient.getMutationCache().subscribe((event) => {\n                if (event.type !== 'updated' || (event.action.type !== 'success' && event.action.type !== 'error')) return\n                const key = event.mutation.options.mutationKey?.[0]\n                if (Array.isArray(key) && PROGRESS_MUTATIONS.some((m) => m.length === key.length && m.every((p, i) => p === key[i]))) {\n                    void queryClient.invalidateQueries({ queryKey: PATHS_LIST_KEY })\n                }\n            }),\n        [queryClient]\n    )\n    const rows = pathRows(query.data)\n    return (\n        <section aria-labelledby='academy-paths' className='flex flex-col' style={{ gap: 12 }} data-slot='academy-paths'>\n            <h2 id='academy-paths' className='text-[15px] font-bold' style={{ marginTop: 6 }}>\n                {C.paths}\n            </h2>\n            {query.isPending ? (\n                <p role='status' className='text-[13px]' style={faint}>\n                    {C.pathsReading}\n                </p>\n            ) : query.isError ? (\n                <p role='alert' className='text-[13px]' style={faint}>\n                    {C.pathsFailed}\n                </p>\n            ) : rows.length === 0 ? (\n                <p className='text-[13px]' style={faint}>\n                    {C.pathsEmpty}\n                </p>\n            ) : (\n                <div className='grid' style={{ gridTemplateColumns: 'repeat(auto-fill, minmax(260px, 1fr))', gap: 16 }} data-slot='academy-path-cards'>\n                    {rows.map((p) => {\n                        const pct = p.unitCount > 0 ? Math.round((100 * p.unitsDone) / p.unitCount) : 0\n                        return (\n                            <Link\n                                key={p.id}\n                                to='/paths/$pathSlug'\n                                params={{ pathSlug: p.slug }}\n                                aria-label={C.openPath(p.title)}\n                                className='flex min-w-0 flex-col'\n                                style={{ ...CARD, padding: '18px 20px', gap: 10, color: 'var(--v2-ink)' }}\n                                data-slot='academy-path'\n                            >\n                                <span className='flex items-center' style={{ gap: 9 }}>\n                                    <span className='grid shrink-0 place-items-center rounded-[8px]' style={{ width: 28, height: 28, background: 'var(--v2-inset)', color: 'var(--v2-soft)' }}>\n                                        <Glyph name={FAMILY_GLYPH[p.familyKey ?? ''] ?? 'cap'} size={14} color='var(--v2-soft)' />\n                                    </span>\n                                    <b className='min-w-0 truncate'>{p.title}</b>\n                                    {p.locked ? (\n                                        <span className='ml-auto text-[12px]' style={faint}>\n                                            {C.pathLocked}\n                                        </span>\n                                    ) : null}\n                                </span>\n                                <span className='text-[12px]' style={{ minHeight: 32, ...soft }}>\n                                    {p.tagline}\n                                </span>\n                                <span\n                                    className='rounded-full'\n                                    style={{ height: 5, background: 'var(--v2-inset)' }}\n                                    role='progressbar'\n                                    aria-valuemin={0}\n                                    aria-valuemax={100}\n                                    aria-valuenow={pct}\n                                    aria-label={`${p.title} progress`}\n                                >\n                                    <span className='block h-full rounded-full' style={{ width: `${pct}%`, background: 'var(--v2-acc)' }} />\n                                </span>\n                                <span className='text-[12px]' style={faint}>\n                                    {C.pathMeta(p.unitCount, p.unitsDone, p.estMinutes)}\n                                </span>\n                            </Link>\n                        )\n                    })}\n                </div>\n            )}\n        </section>\n    )\n}\n\nfunction SignInHere({ onNavigate }: { onNavigate: (id: FeatureId) => void }) {\n    return (\n        <section aria-labelledby='academy-sign-in' className='flex flex-col' style={{ gap: 12, padding: '20px 0' }}>\n            <h1 id='academy-sign-in' className='text-[22px] font-bold'>\n                {C.signInTitle}\n            </h1>\n            <p className='text-[14px]' style={soft}>\n                {C.signInText}\n            </p>\n            <div className='flex items-center' style={{ gap: 10 }}>\n                <Btn tier='primary' onClick={() => onNavigate('settings')}>\n                    {C.openSettings}\n                </Btn>\n                <Link to='/learn' className='text-[13px] underline' style={soft}>\n                    {C.backToCatalog}\n                </Link>\n            </div>\n        </section>\n    )\n}\n\nfunction PageFailed() {\n    return (\n        <section aria-labelledby='academy-failed' className='flex flex-col' style={{ gap: 12, padding: '20px 0' }}>\n            <h1 id='academy-failed' className='text-[22px] font-bold'>\n                {C.failedTitle}\n            </h1>\n            <p className='text-[14px]' style={soft}>\n                {C.failedText}\n            </p>\n            <Link to='/learn' className='text-[13px] underline'>\n                {C.backToCatalog}\n            </Link>\n        </section>\n    )\n}\n\nfunction NotInThisBuild() {\n    return (\n        <section aria-labelledby='academy-later' className='flex flex-col' style={{ gap: 12, padding: '20px 0' }}>\n            <h1 id='academy-later' className='text-[22px] font-bold'>\n                {C.notHereTitle}\n            </h1>\n            <p className='rounded-[10px] text-[13px]' style={{ padding: '12px 14px', background: 'var(--v2-acc-soft)' }}>\n                {C.notHereText}\n            </p>\n            <Link to='/learn' className='text-[13px] underline'>\n                {C.backToCatalog}\n            </Link>\n        </section>\n    )\n}\n\nfunction focusHeading(heading: HTMLElement) {\n    if (!heading.hasAttribute('tabindex')) heading.setAttribute('tabindex', '-1')\n    heading.focus()\n}\n\n/** Moves focus to the page heading after each navigation (keyboard and VoiceOver users). */\nfunction useHeadingFocus(container: React.RefObject<HTMLElement | null>, router: ReturnType<typeof academyRouter>) {\n    useEffect(() => {\n        let tries = 0\n        let frame = 0\n        const tryFocus = () => {\n            const active = document.activeElement\n            if (active && active !== document.body && !container.current?.contains(active)) return\n            const heading = container.current?.querySelector('[data-slot=\"academy-pages\"] h1')\n            if (heading instanceof HTMLElement) {\n                focusHeading(heading)\n            } else if (tries++ < 300) {\n                frame = requestAnimationFrame(tryFocus)\n            }\n        }\n        const unsubscribe = router.subscribe('onResolved', ({ pathChanged }) => {\n            if (!pathChanged) return\n            tries = 0\n            cancelAnimationFrame(frame)\n            frame = requestAnimationFrame(tryFocus)\n        })\n        return () => {\n            unsubscribe()\n            cancelAnimationFrame(frame)\n        }\n    }, [container, router])\n}\n\n/**\n * Lesson bodies are server-compiled HTML whose links are plain anchors. A\n * learner path routes within the destination; an in-page anchor scrolls;\n * any other address stays out of the window and the learner is told.\n */\nfunction useLessonLinks(router: ReturnType<typeof academyRouter>) {\n    const [notice, setNotice] = useState<string | null>(null)\n    const onClick = useCallback(\n        (event: React.MouseEvent<HTMLElement>) => {\n            if (event.defaultPrevented) return\n            const anchor = (event.target as Element | null)?.closest?.('a[href]')\n            if (!anchor || !event.currentTarget.contains(anchor)) return\n            event.preventDefault()\n            const href = anchor.getAttribute('href') ?? ''\n            if (href.startsWith('#')) {\n                const target = href.length > 1 ? event.currentTarget.querySelector(`[id=\"${CSS.escape(href.slice(1))}\"]`) : null\n                target?.scrollIntoView({ block: 'start' })\n                setNotice(null)\n                return\n            }\n            let url: URL\n            try {\n                url = new URL(href, window.location.href)\n            } catch {\n                setNotice(C.linkUnopenable)\n                return\n            }\n            if (url.origin === window.location.origin) {\n                setNotice(null)\n                void router.navigate({ to: `${url.pathname}${url.search}${url.hash}` })\n            } else if (url.protocol === 'https:' || url.protocol === 'http:') {\n                setNotice(C.linkOutside(url.host, url.href))\n            } else {\n                setNotice(C.linkUnopenable)\n            }\n        },\n        [router]\n    )\n    return { notice, onClick }\n}\n\nfunction AcademyRoutes({\n    onNavigate,\n    container,\n    initialPath,\n    signedIn,\n    learner,\n}: {\n    onNavigate: (id: FeatureId) => void\n    container: React.RefObject<HTMLElement | null>\n    initialPath: string\n    signedIn: boolean\n    /** The generation: the router (and its history) is rebuilt per learner reference. */\n    learner: string\n}) {\n    const navigate = useRef(onNavigate)\n    navigate.current = onNavigate\n    // eslint-disable-next-line react-hooks/exhaustive-deps -- `learner` keys the router to the generation\n    const router = useMemo(() => academyRouter((id) => navigate.current(id), initialPath, signedIn), [initialPath, signedIn, learner])\n    useHeadingFocus(container, router)\n    const links = useLessonLinks(router)\n    return (\n        <div onClick={links.onClick} className='flex min-w-0 flex-col' style={{ gap: 20 }}>\n            <p role='status' aria-live='polite' data-slot='academy-link-notice' className='text-[13px] empty:hidden' style={soft}>\n                {links.notice}\n            </p>\n            <RouterProvider router={router} />\n        </div>\n    )\n}\n\n/**\n * The Academy as R2App draws it (C42): the title row with the learner's\n * pills, the 1.4fr/1fr frame (Academy's own learner pages on the left,\n * the learner's place on the right) and the Learning paths row, around\n * the hosted learner pages with the Rust-owned theme. Signed out, the\n * guest generation reads the public catalog; signed in, the account\n * generation. Learner effects mount only here. The embed's content is\n * Academy's own (P19); nothing here signs in or sends on its own.\n */\nexport const Academy = forwardRef<HTMLHeadingElement, AcademyProps>(function Academy({ snapshot, client, onNavigate, initialPath = '/learn' }, ref) {\n    const container = useRef<HTMLElement>(null)\n    useImperativeHandle(ref, () => {\n        const target = container.current\n        return {\n            focus: () => {\n                const heading = target?.querySelector('[data-slot=\"academy-pages\"] h1')\n                if (heading instanceof HTMLElement) focusHeading(heading)\n                else target?.querySelector<HTMLElement>('h1')?.focus()\n            },\n        } as unknown as HTMLHeadingElement\n    })\n    const learner = snapshot.learner\n    const view = snapshot.academy\n    const offline = snapshot.academyOffline\n    const accountId = view.state === 'signedIn' ? view.accountId : null\n    const displayName = view.state === 'signedIn' ? view.displayName : null\n    const unreachable = !offline.reachable && offline.state !== 'signedOut'\n\n    const band = (\n        <div data-slot='page-header-v2' className='flex flex-wrap items-end' style={{ gap: 12 }}>\n            <div className='min-w-0'>\n                <h1 id='academy-heading' tabIndex={-1} className='font-bold' style={{ fontSize: 'var(--v2-title)', letterSpacing: '-0.01em' }}>\n                    {C.title}\n                </h1>\n                <p className='text-[14px]' style={{ marginTop: 4, ...soft }}>\n                    {C.lead}\n                </p>\n            </div>\n            <span className='ml-auto flex flex-wrap items-center' style={{ gap: 8 }} data-slot='academy-pills'>\n                <span\n                    className='flex items-center rounded-full text-[13px] font-semibold'\n                    style={{ height: 26, padding: '0 12px', gap: 6, background: displayName ? 'var(--v2-acc-soft)' : 'var(--v2-inset)', color: displayName ? 'var(--v2-acc)' : 'var(--v2-soft)' }}\n                    data-slot='academy-account'\n                >\n                    <Glyph name={displayName ? 'cap' : 'eye'} size={12} color='currentColor' />\n                    {displayName ? C.signedIn(displayName) : C.guest}\n                </span>\n                {unreachable ? (\n                    <span\n                        className='flex items-center rounded-full text-[13px] font-semibold'\n                        style={{ height: 26, padding: '0 12px', gap: 6, background: 'var(--v2-flag-bg)', color: 'var(--v2-flag)' }}\n                        data-slot='academy-offline-pill'\n                    >\n                        {C.offline}\n                    </span>\n                ) : null}\n                {accountId && offline.downloads.length ? (\n                    <span\n                        className='flex items-center rounded-full text-[13px] font-semibold'\n                        style={{ height: 26, padding: '0 12px', background: 'var(--v2-inset)', color: 'var(--v2-soft)' }}\n                        data-slot='academy-downloads-pill'\n                    >\n                        {C.downloads(offline.downloads.length)}\n                    </span>\n                ) : null}\n            </span>\n        </div>\n    )\n\n    const place = (\n        <>\n            {displayName ? (\n                <p className='text-[13px]' style={soft}>\n                    {C.signedInNote(displayName)}\n                </p>\n            ) : (\n                <>\n                    <p className='text-[13px]' style={soft} data-slot='academy-guest'>\n                        {C.guestNote}\n                    </p>\n                    <Btn className='self-start' onClick={() => onNavigate('settings')}>\n                        {C.openSettings}\n                    </Btn>\n                </>\n            )}\n            {accountId && offline.localDrafts.length ? (\n                <p className='text-[12px]' style={faint} data-slot='academy-drafts'>\n                    {C.drafts(offline.localDrafts.length)}\n                </p>\n            ) : null}\n        </>\n    )\n\n    if (!learner) {\n        return (\n            <section ref={container} tabIndex={-1} aria-label={C.region} data-slot='academy-v2' className='flex min-w-0 flex-col' style={{ gap: 20 }}>\n                {band}\n                <p role='status' className='text-[13px]' style={soft}>\n                    {C.starting}\n                </p>\n            </section>\n        )\n    }\n    return (\n        <section ref={container} tabIndex={-1} aria-label={C.region} data-slot='academy-v2' className='flex min-w-0 flex-col outline-none' style={{ gap: 20 }}>\n            {band}\n            <LearnerProvider client={client} learner={learner} accountId={accountId} displayName={displayName} theme={themeFor(snapshot.appearance)} webOrigin={snapshot.academyOrigin}>\n                <OfflineWorkProvider value={{ client, learner, offline }}>\n                    <PlaceContext.Provider value={place}>\n                        <AcademyRoutes onNavigate={onNavigate} container={container} initialPath={initialPath} signedIn={accountId !== null} learner={learner} />\n                    </PlaceContext.Provider>\n                </OfflineWorkProvider>\n                <CompletionMoments />\n                {snapshot.fixtureBuild ? (\n                    <Suspense fallback={null}>\n                        <LearnerCallProbe />\n                    </Suspense>\n                ) : null}\n            </LearnerProvider>\n        </section>\n    )\n})\nimport { useEffect, useId, useRef, type KeyboardEvent, type ReactNode } from 'react'\nimport { useShellStore } from './store'\n\ninterface ModalProps {\n    label: string\n    onClose: () => void\n    children: ReactNode\n    /** Width in CSS px (default 560). */\n    width?: number\n    /** Inner padding in CSS px (default 20); 0 for a dialog that lays itself out edge to edge. */\n    padding?: number\n    /** Distance from the top of the window in CSS px (default 4vh); the prototype's palette sits at 90. */\n    top?: number\n    /** Corner radius in CSS px (default 12; the palette's frame is 14). */\n    radius?: number\n    /** A sheet docked to the window's right edge under the header (R2App's review sheet, 620px wide, full height). */\n    sheet?: boolean\n    /**\n     * The control focus returns to on close when the opener itself will be gone\n     * by then (a menu item that closes with its menu as the dialog opens): an\n     * explicit surviving target instead of whatever had focus at mount.\n     */\n    returnFocus?: HTMLElement | null\n    'data-slot'?: string\n}\n\nconst FOCUSABLE = 'a[href], button:not([disabled]), input:not([disabled]), select:not([disabled]), textarea:not([disabled]), [tabindex]:not([tabindex=\"-1\"])'\n\n/**\n * One topmost modal (I8): dialogs register on a shell-wide stack; only the\n * last is interactive. Lower dialogs are inert and aria-hidden, Tab and\n * Shift-Tab stay inside the topmost dialog, Escape closes the topmost only,\n * focus moves into the dialog on open and back to the opener on close. The\n * page behind every dialog is made inert by the shell (`useModalsOpen`).\n * The dialog element handles its own keys; the topmost dialog also listens\n * on the window for Escape alone, for when focus has left it (a native\n * sheet returned focus elsewhere), and closes only itself.\n */\nexport function Modal({ label, onClose, children, width = 560, padding = 20, top, radius = 12, sheet = false, returnFocus = null, ...rest }: ModalProps) {\n    const id = useId()\n    const pushModal = useShellStore((s) => s.pushModal)\n    const popModal = useShellStore((s) => s.popModal)\n    const modals = useShellStore((s) => s.modals)\n    const topmost = modals.length > 0 && modals[modals.length - 1] === id\n    const dialog = useRef<HTMLDivElement>(null)\n    const opener = useRef<HTMLElement | null>(null)\n    const returnRef = useRef(returnFocus)\n    returnRef.current = returnFocus\n    const focusedOnce = useRef(false)\n\n    useEffect(() => {\n        opener.current = document.activeElement instanceof HTMLElement ? document.activeElement : null\n        pushModal(id)\n        return () => {\n            popModal(id)\n            // After the commit: the page behind is still inert during cleanup,\n            // and an inert ancestor refuses focus (observed in WebKit).\n            const target = returnRef.current ?? opener.current\n            queueMicrotask(() => {\n                // Only when nothing else took focus meanwhile (⌘T replacing the\n                // palette hands focus to the tenant list, which must keep it).\n                const active = document.activeElement\n                if (active && active !== document.body) return\n                // The opener may be gone (a \"Finish rotation…\" that completed):\n                // focus the page heading rather than leave it on nothing.\n                if (target?.isConnected) target.focus()\n                else document.querySelector<HTMLElement>('main h1[tabindex=\"-1\"]')?.focus()\n            })\n        }\n    }, [id, pushModal, popModal])\n\n    useEffect(() => {\n        // Initial focus goes into the dialog once, when it opens. Regaining the\n        // top after a higher dialog closes must not refocus: that dialog is\n        // restoring its own opener, which may be any control here.\n        if (!topmost || focusedOnce.current) return\n        const node = dialog.current\n        if (!node) return\n        focusedOnce.current = true\n        if (!node.contains(document.activeElement)) {\n            // A declared initial control first (wherever it sits), else the first focusable.\n            const first = node.querySelector<HTMLElement>('[autofocus]') ?? node.querySelector<HTMLElement>(FOCUSABLE)\n            ;(first ?? node).focus()\n        }\n    }, [topmost])\n\n    // Escape still closes the topmost dialog when focus has left it (a\n    // native sheet returning focus to the page body, a click on the scrim's\n    // edge): the dialog's own handler stops the event first when it has focus.\n    const closeRef = useRef(onClose)\n    closeRef.current = onClose\n    useEffect(() => {\n        if (!topmost) return\n        const onWindowKey = (event: globalThis.KeyboardEvent) => {\n            if (event.key !== 'Escape' || event.defaultPrevented) return\n            const node = dialog.current\n            if (node && node.contains(document.activeElement)) return\n            event.preventDefault()\n            closeRef.current()\n        }\n        window.addEventListener('keydown', onWindowKey)\n        return () => window.removeEventListener('keydown', onWindowKey)\n    }, [topmost])\n\n    const onKeyDown = (event: KeyboardEvent<HTMLDivElement>) => {\n        if (!topmost) return\n        if (event.key === 'Escape') {\n            event.preventDefault()\n            event.stopPropagation()\n            onClose()\n            return\n        }\n        if (event.key === 'Tab') {\n            // Keyboard interaction stays inside the topmost dialog.\n            const node = dialog.current\n            if (!node) return\n            const items = Array.from(node.querySelectorAll<HTMLElement>(FOCUSABLE)).filter((el) => !el.hasAttribute('hidden') && el.getAttribute('aria-hidden') !== 'true')\n            if (items.length === 0) {\n                event.preventDefault()\n                node.focus()\n                return\n            }\n            const first = items[0] as HTMLElement\n            const last = items[items.length - 1] as HTMLElement\n            const active = document.activeElement\n            if (event.shiftKey && (active === first || active === node)) {\n                event.preventDefault()\n                last.focus()\n            } else if (!event.shiftKey && active === last) {\n                event.preventDefault()\n                first.focus()\n            }\n        }\n    }\n\n    return (\n        <div\n            className={sheet ? 'fixed z-50 flex justify-end' : 'fixed inset-0 z-50 grid place-items-start justify-center'}\n            style={sheet ? { inset: 'var(--v2-header, 56px) 0 0 0' } : { paddingTop: top ?? '4vh' }}\n            data-v2-scrim=''\n            aria-hidden={topmost ? undefined : true}\n            inert={topmost ? undefined : true}\n            onMouseDown={() => topmost && onClose()}\n        >\n            <div\n                ref={dialog}\n                role='dialog'\n                aria-modal={topmost ? 'true' : undefined}\n                aria-label={label}\n                tabIndex={-1}\n                data-slot={rest['data-slot'] ?? 'modal'}\n                data-topmost={topmost ? 'true' : 'false'}\n                onKeyDown={onKeyDown}\n                onMouseDown={(e) => e.stopPropagation()}\n                className='border'\n                // Bounded to the viewport: a tall dialog scrolls inside itself, so its\n                // actions stay reachable at the minimum window size and 200% zoom.\n                style={\n                    sheet\n                        ? { width: `min(${width}px, 100vw)`, height: '100%', overflowY: 'auto', padding, borderRadius: 0, borderLeft: '1px solid var(--v2-rule)', boxShadow: '-18px 0 40px rgba(0,0,0,0.18)', background: 'var(--v2-bg)', borderWidth: 0, color: 'var(--v2-ink)' }\n                        : { width: `min(${width}px, 92vw)`, maxHeight: '92vh', overflowY: 'auto', padding, borderRadius: radius, boxShadow: '0 24px 60px rgba(0,0,0,0.3)', background: 'var(--v2-paper)', borderColor: 'var(--v2-rule)', color: 'var(--v2-ink)' }\n                }\n            >\n                {children}\n            </div>\n        </div>\n    )\n}\n\n/** Whether any modal is open: the shell makes the page be