{"type":"item.completed","item":{"id":"item_60","type":"command_execution","command":"/bin/zsh -lc \"rg -n 'review|apply|reload|confirm|send|managed|mutation' tools/native-acceptance/acceptance_c41.py; sed -n '1,230p' crates/desktop-core/tests/ui_v2_api/main.rs; sed -n '1815,1865p' crates/desktop-core/tests/workbench_execution/main.rs; rg -n 'on_page_load|PageLoadEvent' apps/desktop/src-tauri/tests/renderer_review_lifecycle.rs; cat docs/planning/evidence/C29/live/L19-verify.json\"","aggregated_output":"14:region with the body outside it, a later send reflecting the service's\n16:+, a Params row written as a line and read by Preview, the collection\n124:    send = fx.App.node(tree, \"AXButton\", \"Send\")\n129:    out = {\"find\": find is not None, \"url\": url is not None, \"send_size\": send.get(\"size\") if send else None,\n130:           \"send_ok\": bool(send and send[\"size\"][0] >= 32 * zoom - 1 and send[\"size\"][1] >= 32 * zoom - 1), \"response_tabs\": body_tab is not None, \"zoom\": zoom}\n131:    out[\"ok\"] = out[\"find\"] and out[\"url\"] and out[\"send_ok\"] and out[\"response_tabs\"]\n266:    n1[\"send\"] = fx.App.node(tree, \"AXButton\", \"Send\") is not None\n269:    n1[\"sub_tabs\"] = [l for l in (\"Params\", \"Headers\", \"Body\", \"Auth\", \"Variables\", \"Preview\") if any(n.get(\"role\") in TABS and (n.get(\"label\") or \"\").startswith(l) for n in tree)]\n305:    # The service changes; a new send reflects it; History lists both and the older one is exactly the first.\n326:    # A Params row, added in the table and read by Preview as the query.\n337:    preview = next((n for n in tree if n.get(\"role\") in TABS and (n.get(\"label\") or \"\") == \"Preview\"), None)\n338:    app.ax(\"press\", preview[\"role\"], \"Preview\")\n339:    tree, n1[\"preview_query\"] = app.wait_for(lambda t: any(\"/topics?page=1\" in x for x in app.texts(t)), 10)\n340:    obs[\"tree_preview\"] = c29.save_tree(\"api-preview\", tree)\n426:    n2[\"key_status\"] = [r for r in c31.status_texts(tree) if \"list ·\" in r or \"not send\" in r or \"not done\" in r][:3]\n480:    n1_ok = (all(n1.get(k) for k in (\"screen\", \"start\", \"opened\", \"chip\", \"environment_chip\", \"lead\", \"folder\", \"root_request\", \"find\", \"plus\", \"select_prompt\", \"request\", \"tab\", \"method\", \"send\", \"save\", \"saved_state\",\n481:                                     \"no_response\", \"status\", \"body_shown\", \"status_pill\", \"raw_exact\", \"response_headers\", \"second\", \"history\", \"old_unchanged\", \"unsaved\", \"saved\", \"preview_query\", \"file_has_row\",\n486:        f\"request opened {n1['request']}: tab {n1['tab']}, Method {n1['method']}, URL {n1.get('url_value')!r}, Send {n1['send']}, Save {n1['save']}, state Saved {n1['saved_state']}, sub-tabs {n1['sub_tabs']}, response tabs {n1['response_tabs']}, no response yet {n1['no_response']}; \"\n487:        f\"Send announced {n1.get('status_text')!r} in a status region {n1['status']} with the body outside it {n1['body_shown']} (pill {n1['status_pill']}), exact under Raw {n1['raw_exact']}, Headers {n1['response_headers']}; after the service changed a new send reflected it {n1['second']}; History listed {n1['entries']} runs and the older one showed exactly the first response {n1['old_unchanged']}; \"\n488:        f\"a Params row unsaved {n1['unsaved']} (status {n1.get('unsaved_seen')}) then saved {n1['saved']}, Preview read ?page=1 {n1['preview_query']}, the file holds the line {n1['file_has_row']}; + opened the dialog {n1['new_dialog']} and a new tab {n1['new_tab']}; the chip menu {n1['menu']} opened Environments {n1['sheet']} docked at 620px {n1['sheet_docked']}; from the keyboard Space on the chip, Tab {n1['keyboard_sheet']['escape_walk']} and Space opened the sheet (focus in it on {n1['keyboard_sheet'].get('escape_focus_in_sheet')!r}), Escape closed it and focus returned to {n1['keyboard_sheet'].get('escape_focus_after')!r}, the close control likewise to {n1['keyboard_sheet'].get('button_focus_after')!r} ({n1['sheet_focus_back']}); {n1['sent_total']} requests reached the loopback service; composites {sorted(n1['parity'].values())}\",\n489:        [run_rel, obs[\"tree_start\"], obs[\"tree_opened\"], obs[\"tree_request\"], obs[\"tree_sent\"], obs[\"tree_history\"], obs[\"tree_preview\"], obs[\"tree_new\"], obs[\"tree_sheet\"], obs.get(\"tree_focus_escape\"), obs.get(\"tree_focus_button\")] + caps(\"api-sent\") + caps(\"api-history\") + caps(\"api-sheet\") + sorted(n1[\"parity\"].values()))\n//! C41: the API Client as the R2App board draws it, through the production\n//! authority interface against a loopback service (screens/api-client-\n//! test-cases.md, docs/planning/chunks/C41.md). What the board draws from:\n//! the collection view's requests, folders, tabs and selection as requests\n//! open and drafts are created; the Params rows the table edits are the\n//! file's `name=value` lines, read back by Preview and sent as the query;\n//! History lists the runs newest first and a shown run is the record as it\n//! was (I5). Nothing here sends by itself: every request is a workbench\n//! intent the operator's view would send.\n\n#[path = \"../workbench_execution/server.rs\"]\n#[allow(dead_code)]\nmod server;\n#[path = \"../context_credentials/support.rs\"]\n#[allow(dead_code)]\nmod support;\n\nuse std::path::{Path, PathBuf};\nuse std::sync::Arc;\n\nuse desktop_core::fixtures::{self, Handles};\nuse desktop_core::runtime::OperationId;\nuse desktop_core::{\n    AuthorityHandle, Core, CoreConfig, Delivery, Intent, Observation, Receipt, Refusal,\n    ShellSnapshot, ViewScope,\n};\nuse serde_json::{Value, json};\nuse server::{Answer, Http};\n\nstruct Desk {\n    #[allow(dead_code)]\n    core: Core,\n    handle: AuthorityHandle,\n    session: String,\n    sequence: u64,\n    adapters: Handles,\n}\n\nimpl Desk {\n    async fn send(&mut self, intent: Value) -> Result<Receipt, Refusal> {\n        let intent: Intent = serde_json::from_value(intent).expect(\"intent\");\n        self.sequence += 1;\n        self.handle\n            .dispatch(\n                Delivery {\n                    session: self.session.clone(),\n                    sequence: self.sequence,\n                },\n                intent,\n            )\n            .await\n    }\n\n    async fn wb(&mut self, request: Value) -> Value {\n        let Receipt::Admitted { operation, .. } = self\n            .send(json!({\"kind\": \"workbench\", \"request\": request}))\n            .await\n            .expect(\"admitted\");\n        self.wait(operation.expect(\"operation\")).await\n    }\n\n    async fn wait(&self, operation: OperationId) -> Value {\n        let Observation::Workbench(handle) = self\n            .handle\n            .observe(ViewScope::Workbench(operation))\n            .expect(\"observe\")\n        else {\n            unreachable!(\"workbench scope\")\n        };\n        serde_json::to_value(handle.result().await).expect(\"json\")\n    }\n\n    fn snap(&self) -> ShellSnapshot {\n        match self.handle.observe(ViewScope::Shell).expect(\"observe\") {\n            Observation::Shell { snapshot, .. } => snapshot,\n            _ => unreachable!(\"shell scope\"),\n        }\n    }\n\n    fn collection(&self) -> Value {\n        serde_json::to_value(self.snap()).expect(\"json\")[\"workbench\"][\"collection\"].clone()\n    }\n\n    async fn open(&mut self, root: &Path) {\n        self.adapters.folders.reply(Some(root.to_path_buf()));\n        let r = self.wb(json!({\"kind\": \"openFolder\"})).await;\n        assert_eq!(r[\"kind\"], \"opened\", \"{r}\");\n    }\n\n    async fn document(&mut self, relative: &str) -> Value {\n        let r = self\n            .wb(json!({\"kind\": \"openRequest\", \"relative\": relative}))\n            .await;\n        assert_eq!(r[\"kind\"], \"document\", \"{r}\");\n        r[\"document\"].clone()\n    }\n\n    async fn send_fields(&mut self, doc: &Value, fields: &Value) -> Value {\n        self.wb(json!({\"kind\": \"send\", \"id\": doc[\"id\"], \"revision\": doc[\"revision\"], \"fields\": fields, \"context\": null}))\n            .await\n    }\n}\n\nasync fn start() -> Desk {\n    let (adapters, handles) = fixtures::adapters();\n    let core = Core::new(CoreConfig::default(), adapters);\n    core.start();\n    let handle = core.operator();\n    let session = handle.register_delivery_session().expect(\"session\").nonce;\n    Desk {\n        core,\n        handle,\n        session,\n        sequence: 0,\n        adapters: handles,\n    }\n}\n\nfn temp(name: &str) -> PathBuf {\n    let mut n = [0u8; 8];\n    getrandom::fill(&mut n).expect(\"fixture\");\n    let p = std::env::temp_dir()\n        .canonicalize()\n        .expect(\"fixture\")\n        .join(format!(\"airs-v2-c41-{name}-{}\", hex::encode(n)));\n    std::fs::create_dir_all(&p).expect(\"fixture\");\n    p\n}\n\n/// A collection inside a Git repository: a folder with one request, and a\n/// root request (what the tree lists).\nfn collection(origin: &str) -> PathBuf {\n    let repo = temp(\"repo\");\n    std::fs::create_dir(repo.join(\".git\")).expect(\"fixture\");\n    let root = repo.join(\"api\");\n    std::fs::create_dir_all(root.join(\"topics\")).expect(\"fixture\");\n    std::fs::write(\n        root.join(\"collection.toml\"),\n        format!(\"format_version = 1\\nid = \\\"c41\\\"\\nname = \\\"Topics API\\\"\\n\\n[variables]\\nbase = \\\"{origin}\\\"\\n\"),\n    )\n    .expect(\"fixture\");\n    std::fs::write(\n        root.join(\"topics/list.request.toml\"),\n        \"format_version = 1\\nid = \\\"list\\\"\\nmethod = \\\"GET\\\"\\nurl = \\\"{{base}}/topics\\\"\\n\",\n    )\n    .expect(\"fixture\");\n    std::fs::write(\n        root.join(\"health.request.toml\"),\n        \"format_version = 1\\nid = \\\"health\\\"\\nmethod = \\\"GET\\\"\\nurl = \\\"{{base}}/health\\\"\\n\",\n    )\n    .expect(\"fixture\");\n    root\n}\n\nfn topics_service() -> impl std::future::Future<Output = Http> {\n    Http::start(Arc::new(|_| Answer::ok(r#\"{\"custom_topics\":[\"Finance\"]}\"#)))\n}\n\nfn names(v: &Value, key: &str) -> Vec<String> {\n    v.as_array()\n        .expect(\"array\")\n        .iter()\n        .map(|x| x[key].as_str().expect(key).to_owned())\n        .collect()\n}\n\n#[tokio::test(flavor = \"multi_thread\")]\nasync fn cloned_collection_roots_have_distinct_view_scopes_even_with_the_same_id_and_basename() {\n    let a = collection(\"http://127.0.0.1:8081\");\n    let b = collection(\"http://127.0.0.1:8082\");\n    let mut desk = start().await;\n    // Persist the same request selection in each copy, then replace A directly with B.\n    desk.open(&b).await;\n    desk.document(\"topics/list.request.toml\").await;\n    desk.open(&a).await;\n    desk.document(\"topics/list.request.toml\").await;\n    let first = desk.collection();\n    desk.open(&b).await;\n    let second = desk.collection();\n    assert_eq!(first[\"id\"], second[\"id\"]);\n    assert_eq!(first[\"folder\"], \"api\");\n    assert_eq!(first[\"folder\"], second[\"folder\"]);\n    assert_eq!(first[\"selected\"], \"list\");\n    assert_eq!(first[\"selected\"], second[\"selected\"]);\n    assert_ne!(\n        first[\"scope\"], second[\"scope\"],\n        \"the renderer must distinguish these roots\"\n    );\n    for view in [&first, &second] {\n        let scope = view[\"scope\"].as_str().expect(\"opaque collection scope\");\n        assert_eq!(scope.len(), 32);\n        assert!(scope.bytes().all(|b| b.is_ascii_hexdigit()));\n    }\n    desk.open(&a).await;\n    assert_eq!(\n        desk.collection()[\"scope\"],\n        first[\"scope\"],\n        \"scope is stable for the same root and id\"\n    );\n    drop(desk);\n    std::fs::remove_dir_all(a.parent().expect(\"fixture parent\")).expect(\"cleanup\");\n    std::fs::remove_dir_all(b.parent().expect(\"fixture parent\")).expect(\"cleanup\");\n}\n\n#[tokio::test(flavor = \"multi_thread\")]\nasync fn the_tree_tabs_and_selection_the_board_draws_from() {\n    let http = topics_service().await;\n    let root = collection(&http.origin());\n    let mut desk = start().await;\n    desk.open(&root).await;\n    // The tree: the folder and both requests; nothing open yet.\n    let c = desk.collection();\n    assert_eq!(\n        names(&c[\"requests\"], \"relative\"),\n        vec![\"health.request.toml\", \"topics/list.request.toml\"],\n        \"{c}\"\n    );\n    assert!(\n        c[\"folders\"]\n            .as_array()\n            .expect(\"folders\")\n            .iter()\n            .any(|f| f == \"topics\"),\n        \"{c}\"\n    );\n    assert_eq!(c[\"tabs\"].as_array().expect(\"tabs\").len(), 0);\n    assert!(c[\"selected\"].is_null());\n    // Opening a request: one tab, selected, not a draft.\n    let list = desk.document(\"topics/list.request.toml\").await;\n    assert_eq!(list[\"fields\"][\"method\"], \"GET\");\n    let stale = json!({\"kind\": \"sendRefused\", \"refusal\": {\"kind\": \"reviewStale\"}});\n    desk.adapters.confirmer.auto(Some(true));\n    // Reviewed, then Applied with another username or secret reference.\n    for (id, changed) in [(\"basic\", basic(\"bob\")), (\"bearer\", bearer(\"other-token\"))] {\n        let doc = desk.doc(&format!(\"{id}.request.toml\")).await;\n        let review = desk.send_doc(&format!(\"{id}.request.toml\")).await;\n        assert_eq!(review[\"kind\"], \"reviewRequired\", \"{review}\");\n        let r = desk\n            .wb(\n                json!({\"kind\": \"apply\", \"review\": review[\"review\"][\"review\"], \"id\": id,\n                       \"revision\": doc[\"revision\"], \"fields\": with(&doc, \"settings\", &changed),\n                       \"context\": desk.context()}),\n            )\n            .await;\n        assert_eq!(r, stale, \"{id}\");\n    }\n    // The referenced secret replaced after review, or while the native\n    // confirmation is held.\n    let doc = desk.doc(\"bearer.request.toml\").await;\n    let apply = |review: &Value, context: Option<String>| {\n        json!({\"kind\": \"apply\", \"review\": review[\"review\"][\"review\"], \"id\": \"bearer\",\n               \"revision\": doc[\"revision\"], \"fields\": doc[\"fields\"], \"context\": context})\n    };\n    let review = desk.send_doc(\"bearer.request.toml\").await;\n    desk.secret(\"dev-token\", \"second-value\").await;\n    let r = desk.wb(apply(&review, desk.context())).await;\n    assert_eq!(r, stale, \"replaced after review\");\n    let review = desk.send_doc(\"bearer.request.toml\").await;\n    desk.adapters.confirmer.auto(None);\n    let op = desk.start_wb(apply(&review, desk.context())).await;\n    assert!(support::eventually(|| desk.adapters.confirmer.held() == 1).await);\n    desk.secret(\"dev-token\", \"third-value\").await;\n    assert!(desk.adapters.confirmer.complete(true));\n    assert_eq!(desk.wait(op).await, stale, \"replaced while confirming\");\n    desk.adapters.confirmer.auto(Some(true));\n    // Cookies: a new session cookie or a cleared jar after review.\n    assert_eq!(\n        desk.send_doc(\"one.request.toml\").await[\"run\"][\"record\"][\"status\"],\n        200\n    );\n    let bare = desk.doc(\"bare.request.toml\").await;\n    let apply_bare = |review: &Value, context: Option<String>| {\n        json!({\"kind\": \"apply\", \"review\": review[\"review\"][\"review\"], \"id\": \"bare\",\n               \"revision\": bare[\"revision\"], \"fields\": bare[\"fields\"], \"context\": context})\n    };\n    let review = desk.send_doc(\"bare.request.toml\").await;\n    assert_eq!(\n        desk.send_doc(\"two.request.toml\").await[\"run\"][\"record\"][\"status\"],\n        200\n    );\n    assert_eq!(\n{\n  \"schema\": \"airs-v2/live-row/1\",\n  \"subject\": \"C29\",\n  \"row\": \"verify against Vulture (reads only)\",\n  \"status\": \"pass\",\n  \"recorded_utc\": \"2026-11-01T13:38:19.467214+00:00\",\n  \"family\": \"L19\",\n  \"native_receipt\": \"docs/planning/evidence/C29/live/L19/attempt-03/receipt.json\",\n  \"native_receipt_sha256\": \"0d0b66212cd1483dbcab073050750de80e3277d29c875697302609e34855c202\",\n  \"manifest_sha256\": \"a2dd7b01ed289ed164859ac0daf6e582100de555d29eefb01fa13df87d0bdbe1\",\n  \"client_id\": \"prisma-airs-cli@1852583913.iam.panserviceaccount.com\",\n  \"tsg_id\": \"1852583913\",\n  \"operation\": \"one management credential verification through the first-run wizard (C29): one latest security-profile probe with limit=1; discard profile contents; no other inventory browsing or writes\",\n  \"executable_sha256\": \"8fb5a476b2a25adf2842286faa69e5393f5812ac3d7b65f87564eb0f05b54dca\",\n  \"source_inputs_sha256\": \"217a81f9ed49219bae0fa7946b9684ca6d2469b3c7f607d91b0c48816f09284c\",\n  \"current_source_match\": \"docs/planning/evidence/C29/live/L19/current-source-match.json\",\n  \"budget\": {\n    \"original_grant_reserved\": 2,\n    \"additional_explicit_owner_grant_cap\": 1,\n    \"additional_grant_reserved\": 1,\n    \"total_reserved\": 3,\n    \"refunded\": 0,\n    \"additional_grant_record\": \"docs/planning/evidence/C29/live/L19/additional-grant-01.json\"\n  },\n  \"temporary_local_credentials_removed\": true,\n  \"http_request_count_observed\": false,\n  \"limitations\": [\n    \"Request bound comes from the inspected production verifier (limit=1, latest=true, SDK retries=0) and exactly one wizard intent; no TLS interception or response body capture.\"\n  ],\n  \"historical_blocked_record\": \"docs/planning/evidence/C29/live/blocked.json (retained unchanged; superseded by this authorized actual run)\"\n}\n","exit_code":0,"status":"completed"}}
