36\t        Err(result) => return *result,\n   937\t    };\n   938\t    let (planned, digest) = blocking((None, Err(SendRefusal::Private)), move || {\n   939\t        let d = digest(&planned);\n   940\t        (Some(planned), d)\n   941\t    })\n   942\t    .await;\n   943\t    let (Some(mut planned), Ok((digest, pins))) = (planned, digest) else {\n   944\t        return refusal(SendRefusal::ReviewStale);\n   945\t    };\n   946\t    // The files go as they were when this matched the review.\n   947\t    planned.pins = pins;\n   948\t    {\n   949\t        let Ok(mut state) = lock(&inner) else {\n   950\t            return refused(WorkbenchProblem::Unavailable);\n   951\t        };\n   952\t        if state.workbench.sending.epoch != planned.epoch {\n   953\t            return retired();\n   954\t        }\n   955\t        let lifetime = state.review_lifetime;\n   956\t        if let Err(r) = check_review(&mut state, &view.review, &planned, &digest, lifetime) {\n   957\t            state.changed();\n   958\t            return refusal(r);\n   959\t        }\n   960\t        // Consumed with admission: a second Apply finds it gone.\n   961\t        state.workbench.sending.review = None;\n   962\t        state.workbench.sending.consumed.push(view.review.clone());\n   963\t        let excess = state.workbench.sending.consumed.len().saturating_sub(256);\n   964\t        state.workbench.sending.consumed.drain(..excess);\n   965\t        state.changed();\n   225\t                    .ok()?\n   226\t                    .header(&admitted.url, history::now() as i64)\n   227\t            });\n   228\t        Credentials { secrets, cookie }\n   229\t    }\n   230\t\n   231\t    /// The active context changed (tenant switch, credential replacement,\n   232\t    /// reset): a review bound to another context is retired for good.\n   233\t    pub(in crate::authority) fn retire(&mut self, keep: Option<&ContextRef>) {\n   234\t        let retired = self\n   235\t            .review\n   236\t            .as_ref()\n   237\t            .is_some_and(|p| p.context.is_some() && p.context.as_ref() != keep);\n   238\t        if retired && let Some(p) = self.review.take() {\n   239\t            self.consumed.push(p.view.review);\n   240\t        }\n   241\t    }\n   242\t}\n   243\t\n  1440\t            token.cancel();\n  1441\t            WorkbenchResult::Done\n  1442\t        }\n  1443\t        None => refused(WorkbenchProblem::Missing),\n  1444\t    }\n  1445\t}\n  1446\t\n  1447\tpub(super) fn dismiss_review(inner: &Arc<Inner>) -> WorkbenchResult {\n  1448\t    if let Ok(mut state) = lock(inner) {\n  1449\t        state.workbench.sending.review = None;\n  1450\t        state.changed();\n  1451\t    }\n  1452\t    WorkbenchResult::Done\n  1453\t}\n  1454\t\n  1455\tfn open_scope(inner: &Arc<Inner>) -> Result<String, Box<WorkbenchResult>> {\n  1456\t    with_open(inner, |o| Ok(o.scope.clone())).map_err(|p| Box::new(refused(p)))\n  1457\t}\n  1458\t\n  1459\t/// A page of the open collection's history, newest first.\n  1460\tpub(super) async fn history_page(\n  1461\t    inner: &Arc<Inner>,\n  1462\t    root: &Path,\n  1463\t    before: Option<String>,\n   903\t        };\n   904\t    }\n   905\t\n   906\t    /// A native page exit ends its configuration editor and every one-time\n   907\t    /// disclosure, including keys whose admitted issuance has not settled.\n   908\t    /// The operations and their remote outcomes remain owned by the core.\n   909\t    pub(super) fn retire_renderer_reviews(&mut self) {\n   910\t        if let Some(review) = self.change_review_id() {\n   911\t            let _ = self.discard_change(&review);\n   912\t        }\n   913\t        let operations: Vec<_> = self\n   914\t            .change_results\n   915\t            .iter()\n   916\t            .map(|record| record.operation.clone())\n   917\t            .collect();\n   918\t        for operation in operations {\n   919\t            let _ = self.forget_secret(&operation);\n   920\t        }\n   921\t        // A sheet may already hold the sole copy after RevealSecret consumed it.\n   922\t        self.secrets.dismiss();\n   923\t    }\n   924\t\n# API Client and Test Cases\n\nSource: `R2App` (`REQ`, `hist`, `send`, `rawJson`, `CASES`, `packCases`,\n`caseRows` lines 1033–1037, `runScan`). Chunk: C33. Both are re-skins of the\nexisting workbench (C14–C15) and library (C12) modules to the layout rhythm.\nNo new remote capability is introduced.\n\n## API Client\n\n- Title row, request tabs (named requests per product), method/URL line with\n  the `get` colour, Send (32px), response pane with status, duration and\n  body; history list of immutable snapshots (I5) from the existing workbench\n  history.\n- After Send, a compact `role=\"status\"` region announces \"<request> · <code>\n  · <duration>\"; the JSON body is outside the live region.\n- Generic requests never bypass AIRS mutation authority (existing C15 rule):\n  a request that would change configuration is refused by the core as today.\n- The \"Show the calls\" panel reuses this response renderer.\n\n## Test Cases\n\n- Title row, filter by product, search, paged table (name, product, input,\n  last result as verdict colour + icon + word), pack-sourced cases carry\n  their pack name.\n- **Runtime-only execution boundary** (prototype lines 1035–1037, parity\n  matrix). A Runtime Security case offers \"Open in Playground\": it sets the\n  Playground's prompt, direction and profile and the operator runs the scan\n  there; the result is stored for the case as a local Playground run. A case\n  for any other product offers \"Inspect\" only: it opens the specification\n  and the recorded result, states which product runs it, and never\n  dispatches a scan or claims execution. Red Team cases say \"hand the spec\n  to a scan\"; no scan is started from this screen.\n- Starter-pack cases selected in the wizard are written at onboarding\n  completion as library entries with `Not run` results.\n\n## Fixtures and tests\n\n- Boards R2Api, R2Cases. Tests V2-R05, V2-T05; V2-T14 status region updates\n  after Send with the body outside the live region; V2-T15 non-Runtime rows\n  render Inspect, never Open in Playground, and clicking Inspect dispatches\n  no scan intent (asserted on the mock runtime); V2-T16 paging and filter.\nhost's save-response sheet and the destination's Send, review, response\nand History views. D041 records the decisions; ADR 0004 the policy.\n\n- **Pipeline.** `send { id, revision, fields, context }` takes its turn on\n  the workbench lane: the document's revision is checked, the snapshot is\n  rendered (secrets stay slots naming their references), the tenant's TSG\n  is filled in and `admission::admit` classifies the request and its\n  destinations for the build's network mode, before any secret is read.\n  Ordinary and known-read requests then leave the lane: secrets are read,\n  `execute::prepare` builds the request and `execute::send` streams the\n  response into sealed history; the single result is the run.\n- **Reviews.** A known tenant change returns `reviewRequired` with a masked\n  view and a digest of everything bound; `apply { review, … }` re-plans the\n  same snapshot after the native confirmation, compares the digest,\n  consumes the review and sends once.\n- **Registered origins.** `Destinations.registered` holds every configured\n  management, token and workbench API origin, the four AIRS scan regions\n  and each tenant's scan destination (by host and port), built with or\n  without an active tenant. A request there is classified whatever its\n  credential (manual header, collection secret or none): known mutations\n  are reviewed, unknown operations denied; URL user-info and Host or\n  forwarding headers, the editor's or one its authentication generates\n  (an API-key header named Host), are refused there and for every managed\n  request; there a method override or a second credential (Authorization,\n  Proxy-Authorization, Cookie or x-pan-token, the request's own\n  authentication whatever header it generates, an API key in the query, or\n  the collection jar's Cookie for the URL, read at planning) is refused\n  too, while one manual Authorization or the session cookie alone still\n  goes; a generic redirect never enters one.\n- **Context binding.** A context change (switch, credential replacement,\n  reset) retires the pending review for good; Apply checks the active\n  context; a managed or reviewed request re-checks its context and the\n  tenant's credential records before its secrets are read, before a token\n  is minted and before the request is sent (a redirect's later hops follow\n  a request already sent), ending `retired` with nothing sent.\n- **Credential binding.** A review's digest also binds the authentication\n  in full (Basic username, Basic/Bearer/API-key secret references), each\n  workbench secret's generation this session (Set secret starts a new one\n  before the Keychain record changes) and the hash of the Cookie header the\n  collection's jar gives the URL. Apply, after the native confirmation,\n  must reproduce it; a reviewed request also re-checks these before it is\n  sent and carries the admitted Cookie header on its first hop instead of\n  reading the jar again.\n- **Reset fence.** Each send keeps the reset epoch it was admitted in,\n  sampled before its first await; reset advances the epoch when admitted.\n  A send retired during planning loads no jar, publishes no review and\n  registers no run. A send's private-storage steps (history and\n  cookie loads and writes, the response body file, pruning) each hold a\n  shared fence and run only in their epoch. Reset holds the fence\n  exclusively through its purge, so no retired send recreates the folder,\n  its key, history, bodies or cookies, or republishes its record (it ends\n  `noCollection`).\n- **Redaction.** Response headers and redirect targets are redacted of the\n  secrets used and of the credentials derived from them on the wire (the\n  minted bearer, Basic encodings).\n- **Views.** `WorkbenchView.running` (four at most, with bytes moved),\n","exit_code":0,"status":"completed"}}
