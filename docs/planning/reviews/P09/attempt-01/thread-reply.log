{"type":"item.completed","item":{"id":"item_55","type":"command_execution","command":"/bin/zsh -lc \"head -35 tools/native-acceptance/legacy_assertions.py; tail -20 tools/native-acceptance/legacy_assertions.py; cat tools/p09/test_c32_production_policy.py | head -110; sed -n '1,140p' tools/native-acceptance/acceptance_c32_current.py\"","aggregated_output":"\"\"\"Where every pre-P09 native assertion stands on the one presentation (C44).\n\nEach legacy check id maps to a kind and its targets:\n  x  exercised: the named v2 checks assert the same requirement on the C44 bundle (their results bind the gate).\n  s  self: the legacy driver itself runs on the one presentation through legacy_v2 (run_on_v2.py <cNN> legacy).\n  p  ported: the requirement was added to the named v2 check in C44 (a new fact in that driver's record).\n  r  retired: the requirement concerns the legacy shell or a surface the one presentation does not have (D059: the\n     prototype is the specification; D060: no import from the alpha; the owner on 2026-10-31: the application is\n     driven by the new UI alone). Where the behaviour survives in the core, the retirement names the suite that holds\n     it (crates/desktop-core/tests/<name>, run by the gate's core-fixtures step); that suite result does not stand in\n     for a native assertion and the map says so.\nThe note says which fact of the target carries the requirement. The gate (acceptance_c44.py) fails when an exercised,\nself or ported target is missing or failing on this bundle, or a retirement has no reason.\n\"\"\"\n\nX, S, P, R = \"x\", \"s\", \"p\", \"r\"\n\nASSERTIONS = {\n    # ---- C01 the legacy shell's basics → the v2 shell (C35), the Go menu and the carried-over facts (C44) ----\n    \"C01-N01\": (X, [\"C44-N01\", \"C35-N01\"], \"the fixture app launches from the prepared bundle (every destination opened from the Go menu); the header names the destination\"),\n    \"C01-N02\": (X, [\"C44-N01\", \"C35-N01\"], \"the Go menu opens every destination; Settings from the status block's ⌘, button; View › Appearance switches the theme for every composite (c29.appearance)\"),\n    \"C01-N03\": (X, [\"C35-N03\", \"C36-N02\"], \"Tab reaches the Destinations rail with the focus ring; Enter on a card opens its product\"),\n    \"C01-N04\": (X, [\"C35-N02\"], \"the palette opens with its search row, typing narrows the rows, Enter navigates, Escape closes\"),\n    \"C01-N05\": (P, [\"C44-N01\"], \"⌘2 opens the Inbox and ⌘, opens Settings through the native menu (a fact added to C44-N01)\"),\n    \"C01-N06\": (X, [\"C39-N01\", \"C43-N01\"], \"the gated products show their gate (Not available) and the New tag; the wizard marks AIS and AES unavailable\"),\n    \"C01-N07\": (X, [\"C35-N01\", \"C36-N01\"], \"the rail's theme toggle and View › Appearance switch the shown appearance (light and dark captures)\"),\n    \"C01-N08\": (X, [\"C35-N01\", \"C35-N03\"], \"the Destinations navigation landmark with named destinations and ⌘ hints; headings per destination\"),\n    \"C01-N09\": (X, [\"C35-N03\"], \"900×600 with no horizontal overflow and the rail collapsed\"),\n    \"C01-N10\": (X, [\"C35-N03\"], \"200% zoom rows of the T09 matrix\"),\n    \"C01-N11\": (P, [\"C44-N01\"], \"the built stylesheet carries the shared prefers-reduced-motion clamp (a fact added to C44-N01); no v2 control depends on motion\"),\n    \"C01-N12\": (P, [\"C44-N01\"], \"no learner chrome word (XP, streak, credits, badge, earned skins) in any destination's tree outside Academy (a fact added to C44-N01)\"),\n    \"C01-N13\": (P, [\"C44-N01\"], \"15 s of startup with a configured tenant open no internet socket from the app or its WebKit processes (a fact added to C44-N01; C24-N03 self-run asserts the same)\"),\n    # ---- C02 tenants and Settings → the wizard (C43), the shared setup and the carried-over facts (C44) ----\n    \"C02-N01\": (X, [\"C43-N01\", \"C44-N01\"], \"the wizard's tenant form creates the tenant; every driver's setup creates its tenant through Settings' form and makes it active before the destinations open\"),\n    \"C02-N02\": (X, [\"C43-N01\", \"C44-N01\"], \"the scan key card saves the key (Required); no plaintext secret in any destination's tree\"),\n    \"C30-N02\": (X, [\"C36-N01\", \"C37-N01\"], \"'First read pending' on Home and in the Inbox; Read now runs the read\"),\n    \"C30-N03\": (X, [\"C37-N01\"], \"snooze, acknowledge and unsnooze with the core's return time stated the same everywhere\"),\n    \"C30-N04\": (X, [\"C37-N02\"], \"Tab from Read now reaches the tabs and rows; Enter opens a row's detail\"),\n    # ---- C31 Administration → C39 ----\n    \"C31-N01\": (S, [\"C31-N01\", \"C39-N01\", \"C39-N03\"], \"C31-N01 requires each Runtime tab's exact admitted actions, gate-only Agentic products, no Gateway Limits tab and both Gateway key lists plus every returned detail without Runtime rotation actions; C39-N01/N03 bind the current board and other-product inventories on the same bundle\"),\n    \"C31-N02\": (S, [\"C31-N02\", \"C39-N02\"], \"acceptance_c31.py through legacy_v2: the custom topic edit through the review sheet, Apply on the exact name, the native confirmation, applied once; C39-N02 asserts the same on the board\"),\n    \"C31-N03\": (S, [\"C31-N03\"], \"acceptance_c31.py through legacy_v2: Issue additional key… reviewed and confirmed natively, the issued key revealed through the host's secret sheet, the review exit, the Inbox reminder and its resumption, the old key's removal (invariants I6/I7)\"),\n    \"C31-N04\": (S, [\"C31-N04\", \"C39-N02\", \"C39-N04\"], \"C31-N04 requires the sole topmost modal, Escape focus return, cleared rotation reminder, product-header Tab reach, minimum/200% themes, review-control ring, polite applied/rotation results and Reduce Motion toast persistence/dismissal/restoration; C39-N02/N04 require current review geometry and measured board keyboard/layout facts on the same bundle\"),\n    # ---- C32 Harness in v2 → C38 ----\n    \"C32-N01\": (X, [\"C38-N01\"], \"the title band names tenant, engine and workspace; a fresh tenant's first send starts a conversation\"),\n    \"C32-N02\": (S, [\"C32-N02\", \"C38-N01\", \"C38-N02\", \"C38-N03\"], \"C32 current native driver requires embedded project selection, read-only command decline/approve, write-capable native Cancel/Allow and isolated three-path guard with initial/final focus; C38 retains the board checks\"),\n    \"C32-N03\": (S, [\"C32-N03\", \"C38-N01\"], \"C32 current native driver requires the approved MCP read, proposal-only typed review and review-exit follow-up, explicit End with saved transcript, ended rail/status, engine exit and next conversation\"),\n    \"C32-N04\": (S, [\"C32-N04\", \"C38-N02\"], \"C32 current native driver requires composer keyboard reach, New investigation focus ring, both minimum/200% themes and ended-toast persistence/dismissal/Reduce Motion restoration; C38 retains board geometry\"),\n    # ---- C33 Test Cases, API Client, Show the calls → C40, C41, C35 ----\n    \"C33-N01\": (X, [\"C40-N01\"], \"the starter packs with Not run; the product filter and search; Inspect for a non-Runtime case\"),\n    \"C33-N02\": (X, [\"C41-N01\"], \"Send announces request · code · duration in the status region with the body outside it; History keeps both runs\"),\n    \"C33-N03\": (X, [\"C35-N01\", \"C36-N01\", \"C40-N01\"], \"the Explain switch shows and hides the calls panel and the Explain banner\"),\n    \"C33-N04\": (X, [\"C40-N02\", \"C41-N02\"], \"the two screens' keyboard and layout matrices\"),\n    \"C33-N05\": (X, [\"C40-N01\"], \"a case and a specification saved, a case removed, Export… saved and cancelled, the exported file imported, a case copied to another tenant\"),\n}\nfrom pathlib import Path\nimport unittest\nfrom c32_production_policy import authority_projection,bundle_digest\nimport tempfile\n\nROOT=Path(__file__).resolve().parents[2]\nOLD=ROOT/'docs/planning/evidence/P09/native-history/Worf-generation-09-complete-before-C32-scoped-confirmation-20261102/reviewed-source/authority.rs'\n\nclass HarnessBoundary(unittest.TestCase):\n    def test_actual_delta_only_harness(self):\n        self.assertEqual(authority_projection(OLD.read_text()),authority_projection((ROOT/'crates/desktop-core/src/authority.rs').read_text()))\n    def test_other_presentation_branch_change_rejected(self):\n        old=OLD.read_text();new=(ROOT/'crates/desktop-core/src/authority.rs').read_text()\n        new=new.replace('Effect::RevealSecret {','Effect::UnexpectedSecret {',1)\n        self.assertNotEqual(authority_projection(old),authority_projection(new))\n    def test_unrelated_state_change_rejected(self):\n        old=OLD.read_text();new=(ROOT/'crates/desktop-core/src/authority.rs').read_text().replace('    cleaning: bool,','    cleaning: u64,',1)\n        self.assertNotEqual(authority_projection(old),authority_projection(new))\n    def test_missing_or_ambiguous_harness_marker_rejected(self):\n        for text in ['',OLD.read_text()+'\\n    ConfirmHarness { nonce: u64 }']:\n            with self.assertRaises(ValueError):authority_projection(text)\n\nclass BundleIntegrity(unittest.TestCase):\n    def test_bytes_mode_and_symlink_targets_bound(self):\n        with tempfile.TemporaryDirectory() as work:\n            root=Path(work);file=root/'app';file.write_text('first');file.chmod(0o755);link=root/'link';link.symlink_to('app');before=bundle_digest(root)\n            file.write_text('second');self.assertNotEqual(before,bundle_digest(root));file.write_text('first');self.assertEqual(before,bundle_digest(root))\n            file.chmod(0o644);self.assertNotEqual(before,bundle_digest(root));file.chmod(0o755);link.unlink();link.symlink_to('other');self.assertNotEqual(before,bundle_digest(root))\n\nif __name__=='__main__':unittest.main()\n#!/usr/bin/env python3\n\"\"\"C32 native acceptance: the Harness in the v2 shell, driven through the\nreal fixture window with the real pinned engine against the synthetic\nGateway service that plays the model.\n\nRun from the repository root after `xtask native-prepare --chunk C32`.\nRequires the macOS Accessibility grant. Synthetic services only; the fixture\ndata root and the project folder are removed at the end.\n\nChecks (docs/architecture/native-checks.json, C32): the screen and a fresh\ntenant's first send starting a user conversation (N01); a decision in the\npage with the tenant-switch guard through the switcher, the palette and the\nGo menu, then decline and approve (N02); a proposal followed up only as the\noperator's review in Administration, ending the conversation, and the next\nsend starting a new one (N03); keyboard reach and the 900x600 / 200% layout\nin both themes (N04).\n\"\"\"\n\nimport json\nimport os\nimport secrets\nimport shutil\nimport sys\nimport tempfile\nimport time\n\nsys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))\nimport fixture_app as fx  # noqa: E402\nimport acceptance_c08 as c8  # noqa: E402\nimport acceptance_c09 as c9  # noqa: E402\nimport acceptance_c16 as c16  # noqa: E402\nimport acceptance_c19 as c19  # noqa: E402\nimport acceptance_c28 as c28  # noqa: E402\nimport acceptance_c29 as c29  # noqa: E402\nimport acceptance_c31 as c31  # noqa: E402  (focus ring and status-region helpers)\nimport c32_coverage\nimport v2_setup as v2s\nimport acceptance_c38 as c38\nimport native_sheets as sheets  # noqa: E402\n\nROOT = os.getcwd()\nSUBJECT = os.environ.get(\"AIRS_NATIVE_SUBJECT\", \"C32\")\nEVIDENCE = os.path.join(ROOT, os.environ[\"AIRS_C32_EVIDENCE\"])\nNATIVE = os.path.join(EVIDENCE, \"native\" if SUBJECT == \"C32\" else \"native-C32\")\nRECORD = os.path.join(EVIDENCE, \"native-acceptance.json\" if SUBJECT == \"C32\" else \"native-acceptance-C32.json\")\nINFERENCE_KEY = \"SYNTHETIC-C32-HARNESS-KEY\"\nMARKERS = [\"Profile 0\", \"WROTE\", \"Operation not permitted\", \"fork\", \"Failed to write file\", \"unavailable\", \"unsupported\"]\nTOPIC = \"11111111-1111-4111-8111-111111111111\"\nFIRST = \"Which profiles block prompt injection?\"\nLOG = []\nACTIVE_OBS = {}\nGUARD = \"A Harness decision is waiting\"\n\n\ndef rel(path):\n    return os.path.relpath(path, ROOT)\n\n\ndef dialog(tree, label):\n    return next((n for n in tree if (n.get(\"label\") or n.get(\"title\") or \"\") == label and (n.get(\"subrole\") in (\"AXDialog\", \"AXApplicationDialog\") or n.get(\"role\") in (\"AXDialog\", \"AXSheet\", \"AXGroup\"))), None)\n\n\ndef ask(mgmt, name, arguments, namespace=\"airs_desktop\"):\n    \"\"\"The next turn's model asks for this one tool call.\"\"\"\n    tool = {\"name\": name, \"arguments\": json.dumps(arguments)}\n    if namespace:\n        tool[\"namespace\"] = namespace\n    mgmt.mode(harnessTool=tool, toolMarkers=MARKERS)\n\n\ndef plain(mgmt):\n    \"\"\"The next turns answer with text only.\"\"\"\n    mgmt.mode(harnessTool=None, toolMarkers=MARKERS)\n\n\ndef send(app, text):\n    app.type_into(\"AXTextArea\", \"Message\", text)\n    c29.press(app, \"AXButton\", \"Send\")\n\n\ndef answers(app, tree=None):\n    return sum(c19.ANSWER in x for x in app.texts(tree if tree is not None else app.tree()))\n\n\ndef main():\n    try:\n        return run()\n    finally:\n        sheets.disable()\n        fx.sh([\"pkill\", \"-f\", fx.PROCESS])\n        fx.sh([\"pkill\", \"-9\", \"-f\", c19.ENGINE])\n        fx.clean_fixture_root()\n\n\ndef run(exercise_fn=None):\n    global NATIVE\n    prepared = json.load(open(os.path.join(EVIDENCE, \"native-prepare.json\")))\n    bundle = os.path.join(ROOT, prepared[\"bundle\"])\n    exe = os.path.join(bundle, \"Contents/MacOS/prisma-airs-desktop-v2\")\n    if c8.sha256(exe) != prepared[\"executable_sha256\"]:\n        raise SystemExit(\"prepared executable changed since native-prepare\")\n    work = tempfile.mkdtemp(prefix=\"airs-v2-c32-acceptance-\")\n    base = os.path.join(ROOT, \"target\", f\"native-c32-{secrets.token_hex(6)}\")\n    project = os.path.join(base, \"agent-demo\")\n    os.makedirs(project)\n    for n in range(3):\n        with open(os.path.join(project, f\"file-{n}.txt\"), \"w\") as f:\n            f.write(f\"content {n}\\n\")\n    FINAL = NATIVE\n    NATIVE = NATIVE + \".staging\"\n    if os.path.isdir(NATIVE):\n        shutil.rmtree(NATIVE)\n    os.makedirs(NATIVE)\n    c29.NATIVE = NATIVE\n    c19.NATIVE = NATIVE\n    if os.path.isdir(c29.CAPTURES):\n        shutil.rmtree(c29.CAPTURES)\n    app = fx.App(bundle, work, LOG)\n    c29._APP = app\n    app.quit()\n    fx.sh([\"pkill\", \"-9\", \"-f\", c19.ENGINE])\n    fx.clean_fixture_root()\n    endpoint = fx.ScanEndpoint(os.path.join(work, \"endpoint\"), c8.SCAN_KEY)\n    endpoint.install_roots()\n    endpoint.start()\n    mgmt = c8.MgmtEndpoint(os.path.join(work, \"endpoint\"), os.path.join(work, \"mgmt\"))\n    mgmt.install()\n    mgmt.start()\n    mgmt.mode()\n    try:\n        return (exercise_fn or exercise)(app, endpoint, mgmt, prepared, project, FINAL)\n    finally:\n        with open(os.path.join(NATIVE, \"checkpoint.json\"), \"w\") as f:\n            json.dump({\"observations\": ACTIVE_OBS, \"log\": LOG}, f, indent=2)\n        endpoint.stop()\n        mgmt.stop()\n        shutil.rmtree(work, ignore_errors=True)\n        shutil.rmtree(base, ignore_errors=True)\n\n\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_56","type":"command_execution","command":"/bin/zsh -lc 'cat Cargo.toml crates/desktop-core/Cargo.toml apps/desktop/src-tauri/Cargo.toml apps/desktop/src-tauri/capabilities/main.json apps/desktop/src-tauri/tauri.conf.json resources/harness/pin.json; cat docs/architecture/ui-v2/screens/{harness,reviews-administration,inbox-reads,shell,wizard,academy}.md'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_56","type":"command_execution","command":"/bin/zsh -lc 'cat Cargo.toml crates/desktop-core/Cargo.toml apps/desktop/src-tauri/Cargo.toml apps/desktop/src-tauri/capabilities/main.json apps/desktop/src-tauri/tauri.conf.json resources/harness/pin.json; cat docs/architecture/ui-v2/screens/{harness,reviews-administration,inbox-reads,shell,wizard,academy}.md'","aggregated_output":"[workspace]\nresolver = \"3\"\nmembers = [\"crates/desktop-core\", \"crates/xtask\", \"apps/desktop/src-tauri\"]\n# Staged inputs (Academy scratch, the extracted SDK package) are standalone.\nexclude = [\".work\", \".inputs\"]\n\n[workspace.package]\nedition = \"2024\"\nrust-version = \"1.99\"\nlicense = \"Apache-2.0\"\npublish = false\n\n[workspace.dependencies]\nserde = { version = \"=1.0.229\", features = [\"derive\"] }\nserde_json = \"=1.0.154\"\nthiserror = \"=2.0.21\"\ntokio = { version = \"=1.53.3\", default-features = false }\nts-rs = { version = \"=12.0.1\", default-features = false, features = [\"serde-compat\", \"no-serde-warnings\"] }\nsha2 = \"=0.10.9\"\nhex = \"=0.4.3\"\n\n[workspace.lints.rust]\n# `deny`, not `forbid`: the fixture-only WebView capture module opts in locally.\nunsafe_code = \"deny\"\n\n[workspace.lints.clippy]\ndbg_macro = \"deny\"\ntodo = \"deny\"\nunwrap_used = \"warn\"\n\n# The Harness verifies the 320 MiB engine's SHA-256 before every start (C19);\n# unoptimized, that alone takes about ten seconds in test builds.\n[profile.dev.package.sha2]\nopt-level = 3\n\n[profile.release]\nlto = \"thin\"\ncodegen-units = 1\n# No `strip`: on macOS 27 the stripped proc-macro dylibs fail dyld validation\n# (\"mis-aligned LINKEDIT string pool\"). Release builds carry no debuginfo.\n[package]\nname = \"desktop-core\"\nversion = \"2.0.0\"\ndescription = \"Prisma AIRS Desktop v2 application core: native authority, context and outcomes\"\nedition.workspace = true\nrust-version.workspace = true\nlicense.workspace = true\npublish.workspace = true\n\n[features]\ndefault = []\n# Deterministic fixtures for integration tests. Never enabled by shipping builds.\ntest-fixtures = [\"dep:libc\"]\n\n[dependencies]\nserde.workspace = true\nserde_json.workspace = true\nthiserror.workspace = true\ntokio = { workspace = true, features = [\"sync\", \"rt\", \"time\", \"macros\"] }\nts-rs.workspace = true\nsha2.workspace = true\nhex.workspace = true\ngetrandom = \"=0.4.3\"\nzeroize = { version = \"=1.9.1\", features = [\"std\"] }\n# D027/D033: the published SDK, scan and management families, with the\n# app-owned transport.\nscm-sdk = { version = \"=0.2.4\", default-features = false, features = [\"scan\", \"management\", \"red-team\", \"model-security\", \"agentguard\", \"gateway\"] }\n# DESIGN \"Native transport policy\": rustls with the platform verifier, explicit\n# proxy modes, gzip only; redirects and retries are disabled per client.\nreqwest = { version = \"=0.13.5\", default-features = false, features = [\"rustls\", \"http2\", \"gzip\", \"stream\", \"system-proxy\"] }\nbytes = \"=1.12.1\"\nhttp = \"=1.5.0\"\nfutures-util = { version = \"=0.3.34\", default-features = false, features = [\"std\"] }\nurl = \"=2.5.8\"\ntokio-util = { version = \"=0.7.20\", default-features = false }\n# Reviewed extra roots are validated as X.509 trust anchors before use.\nrustls-pki-types = { version = \"=1.15.1\", features = [\"std\"] }\nrustls-webpki = { version = \"=0.103.15\", default-features = false, features = [\"std\", \"aws-lc-rs\"] }\n# The learner's avatar is decoded with bounds, oriented and re-encoded as a\n# 512 px JPEG before upload and on readback (as v1 did); decoders only.\nimage = { version = \"=0.25.10\", default-features = false, features = [\"png\", \"jpeg\", \"webp\"] }\n# Offline Academy work is sealed with XChaCha20-Poly1305 (v1's cipher crate).\nchacha20poly1305 = { version = \"=0.10.1\", default-features = false, features = [\"alloc\"] }\n# API Client projects (C14): v1's TOML project files edited in place with\n# their comments and layout kept, and Insomnia v5 exports (YAML or JSON).\ntoml_edit = { version = \"=0.25.17\", default-features = false, features = [\"parse\", \"display\"] }\nserde_yaml_ng = \"=0.10.0\"\n# API Client execution (C15): Set-Cookie parsing for the bounded,\n# host-only cookie jar (already locked through the desktop host).\ncookie = { version = \"=0.18.2\", default-features = false }\n# Harness company sign-in (C20, D047): verified JWT decoding with the\n# aws-lc-rs provider the transport already ships; JWKs only (no PEM).\njsonwebtoken = { version = \"=11.1.0\", default-features = false, features = [\"aws_lc_rs\"] }\nbase64 = \"=0.22.1\"\n# The fixture sidecar launcher's process group (test-fixtures only; already\n# locked through tokio).\nlibc = { version = \"=0.2.191\", optional = true }\n\n[dev-dependencies]\ntokio = { workspace = true, features = [\"sync\", \"macros\", \"rt\", \"rt-multi-thread\", \"net\", \"io-util\", \"time\", \"test-util\"] }\n# Synthetic TLS endpoints and proxies for the native transport contracts.\nrcgen = { version = \"=0.14.10\", default-features = false, features = [\"aws_lc_rs\", \"pem\"] }\nrustls = { version = \"=0.23.46\", default-features = false, features = [\"aws_lc_rs\", \"std\", \"tls12\"] }\ntokio-rustls = { version = \"=0.26.6\", default-features = false, features = [\"aws_lc_rs\", \"tls12\"] }\nflate2 = \"=1.1.10\"\ntime = \"=0.3.55\"\n\n[[test]]\nname = \"context_credentials\"\npath = \"tests/context_credentials/main.rs\"\nrequired-features = [\"test-fixtures\"]\n\n[[test]]\nname = \"ui_v2_shell\"\npath = \"tests/ui_v2_shell/main.rs\"\nrequired-features = [\"test-fixtures\"]\n\n[[test]]\nname = \"ui_v2_onboarding\"\npath = \"tests/ui_v2_onboarding/main.rs\"\nrequired-features = [\"test-fixtures\"]\n\n[[test]]\nname = \"ui_v2_setup_reads\"\npath = \"tests/ui_v2_setup_reads/main.rs\"\nrequired-features = [\"test-fixtures\"]\n\n[[test]]\nname = \"ui_v2_inbox\"\npath = \"tests/ui_v2_inbox/main.rs\"\nrequired-features = [\"test-fixtures\"]\n\n[[test]]\nname = \"ui_v2_reviews\"\npath = \"tests/ui_v2_reviews/main.rs\"\nrequired-features = [\"test-fixtures\"]\n\n[[test]]\nname = \"ui_v2_harness\"\npath = \"tests/ui_v2_harness/main.rs\"\nrequired-features = [\"test-fixtures\"]\n\n[[test]]\nname = \"ui_v2_workbench\"\npath = \"tests/ui_v2_workbench/main.rs\"\nrequired-features = [\"test-fixtures\"]\n\n[[test]]\nname = \"ui_v2_shell_port\"\npath = \"tests/ui_v2_shell_port/main.rs\"\nrequired-features = [\"test-fixtures\"]\n\n[[test]]\nname = \"ui_v2_home\"\npath = \"tests/ui_v2_home/main.rs\"\nrequired-features = [\"test-fixtures\"]\n\n[[test]]\nname = \"ui_v2_harness_port\"\npath = \"tests/ui_v2_harness_port/main.rs\"\nrequired-features = [\"test-fixtures\"]\n\n[[test]]\nname = \"ui_v2_admin\"\npath = \"tests/ui_v2_admin/main.rs\"\nrequired-features = [\"test-fixtures\"]\n\n[[test]]\nname = \"ui_v2_api\"\npath = \"tests/ui_v2_api/main.rs\"\nrequired-features = [\"test-fixtures\"]\n\n[[test]]\nname = \"ui_v2_academy\"\npath = \"tests/ui_v2_academy/main.rs\"\nrequired-features = [\"test-fixtures\"]\n\n[[test]]\nname = \"ui_v2_wizard\"\npath = \"tests/ui_v2_wizard/main.rs\"\nrequired-features = [\"test-fixtures\"]\n\n[[test]]\nname = \"ui_v2_closure\"\npath = \"tests/ui_v2_closure/main.rs\"\nrequired-features = [\"test-fixtures\"]\n\n[[test]]\nname = \"ui_v2_inbox_port\"\npath = \"tests/ui_v2_inbox_port/main.rs\"\nrequired-features = [\"test-fixtures\"]\n\n[[test]]\nname = \"sync_scan\"\npath = \"tests/sync_scan/main.rs\"\nrequired-features = [\"test-fixtures\"]\n\n[[test]]\nname = \"academy_identity\"\npath = \"tests/academy_identity/main.rs\"\nrequired-features = [\"test-fixtures\"]\n\n[[test]]\nname = \"academy_learner\"\npath = \"tests/academy_learner/main.rs\"\nrequired-features = [\"test-fixtures\"]\n\n[[test]]\nname = \"academy_program\"\npath = \"tests/academy_program/main.rs\"\nrequired-features = [\"test-fixtures\"]\n\n[[test]]\nname = \"academy_offline\"\npath = \"tests/academy_offline/main.rs\"\nrequired-features = [\"test-fixtures\"]\n\n[[test]]\nname = \"management_reads\"\npath = \"tests/management_reads/main.rs\"\nrequired-features = [\"test-fixtures\"]\n\n[[test]]\nname = \"runtime_changes\"\npath = \"tests/runtime_changes/main.rs\"\nrequired-features = [\"test-fixtures\"]\n\n[[test]]\nname = \"dlp_subset\"\npath = \"tests/dlp_subset/main.rs\"\nrequired-features = [\"test-fixtures\"]\n\n[[test]]\nname = \"sessions_reports\"\npath = \"tests/sessions_reports/main.rs\"\nrequired-features = [\"test-fixtures\"]\n\n[[test]]\nname = \"library_observation\"\npath = \"tests/library_observation/main.rs\"\nrequired-features = [\"test-fixtures\"]\n\n[[test]]\nname = \"workbench_documents\"\npath = \"tests/workbench_documents/main.rs\"\nrequired-features = [\"test-fixtures\"]\n\n[[test]]\nname = \"workbench_execution\"\npath = \"tests/workbench_execution/main.rs\"\nrequired-features = [\"test-fixtures\"]\n\n[[test]]\nname = \"redteam_model_reads\"\npath = \"tests/redteam_model_reads/main.rs\"\nrequired-features = [\"test-fixtures\"]\n\n[[test]]\nname = \"gateway_reads\"\npath = \"tests/gateway_reads/main.rs\"\nrequired-features = [\"test-fixtures\"]\n\n[[test]]\nname = \"gateway_changes\"\npath = \"tests/gateway_changes/main.rs\"\nrequired-features = [\"test-fixtures\"]\n\n[[test]]\nname = \"gateway_inference\"\npath = \"tests/gateway_inference/main.rs\"\nrequired-features = [\"test-fixtures\"]\n\n[[test]]\nname = \"harness_identity_history\"\npath = \"tests/harness_identity_history/main.rs\"\nrequired-features = [\"test-fixtures\"]\n\n[[test]]\nname = \"harness_tools\"\npath = \"tests/harness_tools/main.rs\"\nrequired-features = [\"test-fixtures\"]\n\n[[test]]\nname = \"workspace_mcp\"\npath = \"tests/workspace_mcp/main.rs\"\nrequired-features = [\"test-fixtures\"]\n\n[[test]]\nname = \"native_quality\"\npath = \"tests/native_quality/main.rs\"\nrequired-features = [\"test-fixtures\"]\n\n[[test]]\nname = \"imports_rollback\"\npath = \"tests/imports_rollback/main.rs\"\nrequired-features = [\"test-fixtures\"]\n\n[[test]]\nname = \"harness_process\"\npath = \"tests/harness_process/main.rs\"\nrequired-features = [\"test-fixtures\"]\n\n# A scripted stand-in for the engine's desktop-server (C19 protocol and\n# lifecycle failures the real engine cannot be made to produce).\n[[bin]]\nname = \"harness-fixture-sidecar\"\npath = \"src/bin/harness_fixture_sidecar.rs\"\nrequired-features = [\"test-fixtures\"]\n\n[lints]\nworkspace = true\n[package]\nname = \"desktop-host\"\nversion = \"2.0.0\"\ndescription = \"Prisma AIRS Desktop v2 native host: window/origin admission and OS adapters\"\nedition.workspace = true\nrust-version.workspace = true\nlicense.workspace = true\npublish.workspace = true\ndefault-run = \"prisma-airs-desktop-v2\"\n\n[lib]\nname = \"desktop_host\"\npath = \"src/lib.rs\"\n\n[[bin]]\nname = \"prisma-airs-desktop-v2\"\npath = \"src/main.rs\"\n\n[features]\ndefault = []\n# Distinct fixture identity and the Tauri mock runtime for admission tests.\n# Never enabled by the shipping artifact build.\ntest-fixtures = [\n    \"desktop-core/test-fixtures\",\n    \"tauri/test\",\n    \"dep:objc2-web-kit\",\n]\n\n[build-dependencies]\ntauri-build = { version = \"=2.7.3\", default-features = false, features = [\"config-json\"] }\n\n[dependencies]\ndesktop-core = { path = \"../../../crates/desktop-core\" }\nurl = \"=2.5.8\"\ntauri = { version = \"=2.12.4\", default-features = false, features = [\"wry\", \"common-controls-v6\", \"compression\"] }\nserde.workspace = true\nserde_json.workspace = true\ntokio = { workspace = true, features = [\"sync\", \"macros\", \"rt\", \"time\"] }\nfutures-util = { version = \"=0.3.34\", default-features = false, features = [\"std\"] }\nzeroize = { version = \"=1.9.1\", features = [\"std\"] }\ngetrandom = \"=0.4.3\"\n\n# Classic login Keychain credential adapter (DESIGN \"protected storage\") and\n# the native file sheet for profile import.\n[target.'cfg(target_os = \"macos\")'.dependencies.security-framework]\nversion = \"=3.7.0\"\n[target.'cfg(target_os = \"macos\")'.dependencies.security-framework-sys]\nversion = \"=2.17.0\"\n[target.'cfg(target_os = \"macos\")'.dependencies.core-foundation]\nversion = \"=0.10.1\"\n[target.'cfg(target_os = \"macos\")'.dependencies.rfd]\nversion = \"=0.17.2\"\ndefault-features = false\n\n# AppKit: the native operator confirmation and one-time secret sheets and\n# the clipboard (C09, D035); fixture-only WebView self-capture (WebKit).\n[target.'cfg(target_os = \"macos\")'.dependencies]\nobjc2 = { version = \"=0.6.5\" }\nobjc2-foundation = { version = \"=0.3.2\", default-features = false, features = [\"std\", \"NSData\", \"NSDictionary\", \"NSError\", \"NSString\", \"NSGeometry\", \"NSNotification\", \"NSOperation\", \"block2\"] }\nobjc2-app-kit = { version = \"=0.3.2\", default-features = false, features = [\"std\", \"NSImage\", \"NSImageRep\", \"NSBitmapImageRep\", \"NSAlert\", \"NSApplication\", \"NSButton\", \"NSControl\", \"NSResponder\", \"NSView\", \"NSWindow\", \"NSTextField\", \"NSPasteboard\", \"NSWorkspace\", \"block2\"] }\nobjc2-web-kit = { version = \"=0.3.2\", optional = true, default-features = false, features = [\"std\", \"WKWebView\", \"WKSnapshotConfiguration\", \"block2\", \"objc2-app-kit\"] }\nblock2 = { version = \"=0.6.2\" }\n# The Harness sidecar's process group and exit observed without reaping\n# (C19; already locked through tokio and Tauri).\nlibc = \"=0.2.191\"\n\n[dev-dependencies]\ntokio = { workspace = true, features = [\"sync\", \"macros\", \"rt\", \"rt-multi-thread\", \"net\", \"io-util\", \"time\"] }\ngetrandom = \"=0.4.3\"\n# The synthetic Academy endpoint for browser_callback (same pins as desktop-core).\nrcgen = { version = \"=0.14.10\", default-features = false, features = [\"aws_lc_rs\", \"pem\"] }\nrustls = { version = \"=0.23.46\", default-features = false, features = [\"aws_lc_rs\", \"std\", \"tls12\"] }\ntokio-rustls = { version = \"=0.26.6\", default-features = false, features = [\"aws_lc_rs\", \"tls12\"] }\ntime = \"=0.3.55\"\n# The synthetic OpenID provider for browser_callback (C20; same pins as\n# desktop-core).\njsonwebtoken = { version = \"=11.1.0\", default-features = false, features = [\"aws_lc_rs\"] }\nbase64 = \"=0.22.1\"\nsha2.workspace = true\n\n[lints]\nworkspace = true\n\n# Host admission tests use Tauri's mock runtime, available only with fixtures.\n[[test]]\nname = \"ipc_admission\"\nrequired-features = [\"test-fixtures\"]\n\n[[test]]\nname = \"permission_manifest\"\nrequired-features = [\"test-fixtures\"]\n\n[[test]]\nname = \"keychain_access\"\nrequired-features = [\"test-fixtures\"]\n\n[[test]]\nname = \"browser_callback\"\nrequired-features = [\"test-fixtures\"]\n\n[[test]]\nname = \"native_confirmation\"\nrequired-features = [\"test-fixtures\"]\n\n[[test]]\nname = \"clipboard_secret\"\nrequired-features = [\"test-fixtures\"]\n\n[[test]]\nname = \"sidecar_supervision\"\nrequired-features = [\"test-fixtures\"]\n\n[[test]]\nname = \"renderer_review_lifecycle\"\nrequired-features = [\"test-fixtures\"]\n{\n  \"$schema\": \"../gen/schemas/desktop-schema.json\",\n  \"identifier\": \"main-window\",\n  \"description\": \"The packaged main window may call only the two application commands.\",\n  \"local\": true,\n  \"windows\": [\"main\"],\n  \"webviews\": [\"main\"],\n  \"permissions\": [\"allow-desktop-dispatch\", \"allow-desktop-observe\"]\n}\n{\n  \"$schema\": \"https://schema.tauri.app/config/2\",\n  \"productName\": \"Prisma AIRS Desktop v2\",\n  \"version\": \"2.0.0\",\n  \"identifier\": \"io.cdot.prisma-airs-desktop.v2\",\n  \"build\": {\n    \"frontendDist\": \"../dist\",\n    \"beforeBuildCommand\": \"\"\n  },\n  \"app\": {\n    \"withGlobalTauri\": false,\n    \"windows\": [],\n    \"security\": {\n      \"csp\": {\n        \"default-src\": \"'self'\",\n        \"script-src\": \"'self'\",\n        \"style-src\": \"'self'\",\n        \"img-src\": \"'self' data:\",\n        \"font-src\": \"'self' data:\",\n        \"connect-src\": \"ipc: http://ipc.localhost\",\n        \"object-src\": \"'none'\",\n        \"base-uri\": \"'none'\",\n        \"form-action\": \"'none'\",\n        \"frame-ancestors\": \"'none'\",\n        \"frame-src\": \"'none'\",\n        \"worker-src\": \"'none'\"\n      },\n      \"dangerousDisableAssetCspModification\": false,\n      \"freezePrototype\": true,\n      \"capabilities\": [\"main-window\"]\n    }\n  },\n  \"bundle\": {\n    \"active\": true,\n    \"targets\": [\"app\", \"dmg\"],\n    \"category\": \"DeveloperTool\",\n    \"copyright\": \"Copyright 2026 cdot\",\n    \"license\": \"Apache-2.0\",\n    \"icon\": [\"icons/32x32.png\", \"icons/128x128.png\", \"icons/128x128@2x.png\", \"icons/icon.icns\", \"icons/icon.png\"],\n    \"macOS\": {\n      \"minimumSystemVersion\": \"13.0\",\n      \"hardenedRuntime\": true\n    }\n  }\n}\n{\n  \"archive\": \"resources/harness/darwin-arm64.tar.gz\",\n  \"archiveBytes\": 113497192,\n  \"archiveSha256\": \"10729706be0bf2ec2bae1d21155fe866b047960e73881583397887c083fce173\",\n  \"binarySha256\": \"383bcfb5f8d36d2367793a594ceeaf89a5c0fd618d6436397e9c2e22a682c1c5\",\n  \"engineCommit\": \"9331a5839bc6a763d94dee7584746f58bbbe1181\",\n  \"executable\": \"airs-harness\",\n  \"files\": 1618,\n  \"protocol\": \"airs-desktop/1\",\n  \"resourcesSha256\": \"1c0a1eb83c82ffe4b2dc22f8ec4c6bc6a61fecc326ca70969de9c14ca62b3ac4\",\n  \"runtimeVersion\": \"0.1.7-desktop.2\",\n  \"signing\": {\n    \"identity\": \"Developer ID Application: Calvin Remsburg (G5QLZ5A8TA)\",\n    \"options\": \"runtime\",\n    \"signedUtc\": \"2026-10-25T21:23:45Z\",\n    \"teamIdentifier\": \"G5QLZ5A8TA\",\n    \"timestamp\": true,\n    \"unsignedBinarySha256\": \"f8e49cee8b0905818c9271e91b2ca8f39b67075e602e5db7db683f9d37aee50c\"\n  },\n  \"source\": {\n    \"buildInfoSha256\": \"a22d963e7bedf212c3190ef78ebc4d885e99cac87e87a53ed297f694b692cbc6\",\n    \"v1Archive\": \"packaging/harness/darwin-arm64.tar.gz\",\n    \"v1ArchiveSha256\": \"e79f564a5210241488a49c4756ff061dff3d336e23709f5fb7adfd4bde0928aa\",\n    \"v1Commit\": \"74754c02b19d87187b6dca81f64550a669b0f841\"\n  },\n  \"version\": 1\n}\n# Harness\n\nSource: `R2App` (`CONVOS` blocks/mcp/keys at lines 760–790, `decs`, `ended`,\n`archiveActive`, `sendDraft`, `startNewConvo`, `convoHint`, `follows`),\nboards R2Harness, R2Harness2, R2Harness3. Chunk: C32.\n\nThe screen is a re-skin of the existing Harness engine, sessions, decisions,\nMCP and sign-in modules (C19–C22); the conversation, decision and project\nauthority model is unchanged. D014's Harness restrictions hold: a proposal\nnever authorises Apply.\n\n## Layout\n\n- Title row \"Harness\" with tenant and engine status; left rail of\n  conversations (lifecycle seeds appear only on non-fresh fixture tenants;\n  user conversations titled from their first message; archived ones marked\n  ended); main transcript; one composer per tenant and workspace (its draft kept across navigation, tenant round trips and a conversation's retirement), with messages that reached no conversation, or whose delivery was not confirmed, kept apart for recovery and never sent by themselves (provenance P50).\n- Prerequisites checklist (tenant, management client, Gateway workspace,\n  company sign-in) stays visible until satisfied (D057 F05).\n\n## Lifecycles (fixture conversations)\n\nAll three are **read-only** tool-call lifecycles in the prototype; none\nwrites to a tenant from the Harness.\n\n1. **blocks** — \"Why were 14 prompts blocked on claims-triage overnight?\":\n   read-only tool call `list_security_events` (in-page Approve once /\n   Decline), result summary, recommendation, follow-up \"Open the review\"\n   that opens the injection-override topic review in Administration\n   (Runtime Security, `ChangeKind::Topics`).\n2. **mcp** — \"Which laptops run an MCP server that is not on the allow\n   list?\": in the prototype the read-only call targets an AES inventory.\n   AES has no admitted service (DESIGN-V2 §6), so the implemented fixture\n   reads the workspace MCP server inventory the core already exposes\n   (`GatewayRead::McpServers`, C22) and its follow-up opens a Gateway\n   guardrail review (`ChangeKind::GatewayGuardrails`). Recorded as\n   deviation P16.\n3. **keys** — \"Which API keys expire before the audit, and can you rotate\n   them?\": read-only key inventory; the Harness refuses to rotate (\"rotation\n   is a write; it goes through Administration and a review\") and hands off\n   to the key rotation flow. The follow-up text reflects the rotation stage\n   (additional key issued / old key removed).\n\nEach has approve, decline, end and follow-up paths. Declining records the\ndecision and the assistant's declined text; ending seals the session\n(`endConversation` → archive id) and the rail shows it ended.\n\nTool-call approval stays as C21/C22 built it: the core decides from the\ntool's write flag whether the host's native confirmation sheet is required;\nread-only calls use the in-page bar. No P09 fixture exercises a write-capable\ncall; the native sheet path is covered by the existing C21 tests.\n\n## Rules\n\n- A fresh tenant's first send creates a user conversation (I12); sending in\n  an ended conversation creates a new one.\n- Contextual navigation into an ended conversation shows a hint with \"Open\n  the saved transcript\" (archived transcript detail) and \"Start a new\n  investigation\" (new conversation prefilled with the opening question). The\n  hint clears on any navigation.\n- A pending decision blocks tenant switch (I1).\n\n## Fixtures and tests\n\n- Boards R2Harness (blocks), R2Harness2 (mcp), R2Harness3 (keys). Tests\n  V2-R01, V2-T01, T13; V2-T17 approve/decline/end/follow-up per lifecycle;\n  V2-T18 the keys lifecycle never dispatches a mutation from the Harness.\n# Reviews, Administration and key rotation\n\nSource: `R2App` (`REVIEWS` line 826, `rvKind`, `canApply`, `doApply`,\n`appliedKey`, `appliedOther`, `TOPICS`, `PROFILES`, `verdictFor`, `T` admin\ntables, API keys row actions). Chunk: C31. Every change goes through the\nexisting Configuration review (`changes.rs`, D014): the review binds tenant,\ncredentials, resource and draft, and changed context invalidates it.\n\n## Administration\n\n- Accordion of the products in DESIGN-V2 §6. Each admitted product expands to\n  tabs from `AdminInventory`, generated from the complete table in\n  [administration-inventory.md](administration-inventory.md): every tab is\n  mapped to an admitted read and every creation or row action to an admitted\n  `ChangeKind` + `ChangeAction` with its label, and every denied action,\n  unavailable tab and removed tab is named there. A product or tab with no\n  admitted service renders as **Not available in this release** with the\n  dependency it waits on; it never shows invented inventory and never offers\n  a mutation (V2-T20, V2-R11).\n- Tables: columns per tab, row actions \"Edit…\", \"Rotate…\", \"Finish\n  rotation…\", \"View\", \"Results\". Read-only products (Red Team, Model/skill)\n  never offer a change.\n- Security profiles and Custom topics derive \"Used by\" from one topic\n  inventory; detector ids and topic keys are distinct types.\n\n## Review (I3)\n\n- Opened by `openReview{kind, action, resource}`; the scope carries tenant,\n  resource, before/after diff lines, impact (from `changes::impact`), and the\n  typed-name requirement.\n- The UI shows the diff, impact, a text field \"Type <name> to confirm\" and\n  Apply (disabled until match). `confirmReview{review_id, typed}` is\n  validated in the core: wrong name, different tenant or changed context\n  refuses with the reason, and the UI shows a warn toast naming the tenant.\n- Applied panel (non-key): \"Live. The item was read back.\" with name,\n  revision, time, tenant. Done. Unknown outcome renders the existing\n  \"not confirmed\" state with the reconciliation step, never a success.\n- Any review exit (Done, Escape, tenant switch, context retirement) calls\n  `ForgetSecret` for any held one-time key and resets `secretVisible` (I6).\n\n## Key rotation (I6, I7) — supported sequence\n\nThe prototype promised a grace period with a later revocation and a secret\nrecoverable from the Keychain. The retained core supports neither as one\noperation: `ChangeAction::Rotate` regenerates a key in place (no grace), and\n`ChangeAction::Version` creates an additional key while the existing one is\nunchanged (`changes.rs` 842–846, `management.rs` 980–988). Issued keys are\nheld per result for the active context only and never persisted\n(DESIGN.md \"Secrets\"). The implemented flow therefore uses the two admitted\noperations in sequence and never stores a secret. It applies to Runtime\nSecurity API keys only: Gateway service and user keys admit `Rotate`\n(regenerate in place) and not `Version`, so they get the plain \"Rotate…\"\nreview with the existing one-time reveal and no staged sequence\n(administration-inventory.md):\n\n1. **Issue an additional key** — review `ApiKeys · Version` for the\n   application. On apply the core reads the key back, holds the one-time\n   secret in the zeroizing buffer, and the panel reads **Additional key\n   issued · old key still active**: Reveal (host `RevealSecret` sheet, 60 s,\n   selectable label) and Copy (host clipboard with marker, cleared after\n   60 s); note \"Shown once. Not stored by this app; if lost, issue another\n   key\"; actions **Finish later** / **Application updated**. Side effects:\n   Inbox item `rotation-<application>` (Needs action, \"Update\n   support-copilot with the new key, then remove the old key\"), with a\n   snooze that returns in 24 hours and no invented deadline; the key table\n   shows both keys, the old one marked \"Replace after deployment\".\n2. **Resumed** — panel reads **Rotation in progress · secret no longer\n   available**: \"The new key was shown once when it was issued and this app\n   does not keep it. If support-copilot does not have it, issue another key.\"\n   Actions: **Issue another key** (returns to step 1) / **Application\n   updated**.\n3. **Application updated** — records a *local* deployment acknowledgement\n   with its time (\"Deployment acknowledged 07:51 by you on this Mac\"; this is\n   the operator's statement, not remote evidence) and opens the review\n   `ApiKeys · Delete` for the old key.\n4. **Old key removed** — on apply the core performs the delete and reads\n   back; absent is the expected readback and the panel reads **Rotation\n   complete · old key removed 07:52** with the readback time stored once and\n   never recomputed. The Inbox item clears and the completion toast fires.\n   An unknown delete outcome shows the reconciliation state and keeps the\n   Inbox item.\n\nTwo timestamps are kept and labelled distinctly: `deployment_acknowledged_at`\n(local statement) and `old_key_removed_at` (remote readback). Neither is\nderived from read counts. `ChangeAction::Rotate` (regenerate in place) stays\navailable from the key row as \"Regenerate…\" with the existing impact text\n\"Replaces this key; update every integration using it\"; it is not called\nrotation in the UI.\n\n## Playground verdicts\n\n- Detector results and topic matches are independent. A profile without the\n  detector, or without the topic assigned, yields \"Not detected\" with the\n  reason; monitor-only turns Blocked into Flagged; applying a topic never\n  suppresses an enabled detector. The applied topic's example prompts\n  classify under the topic and show Flagged when assigned.\n\n## Fixtures and tests\n\n- Boards R2Admin, R2Review. Tests V2-R03 (confirmReview refusals), V2-R06\n  (held key dropped on every review exit, tenant switch and context\n  retirement; Reveal after drop refuses), V2-R07 (rotation state machine:\n  Version → acknowledge → Delete → readback, with these named failure\n  cases: (a) failed issuance: refusal shown, no key held, no Inbox item;\n  (b) unknown issuance (uncertain Version outcome): state \"issuance not\n  confirmed\" with the existing reconciliation read of the application's key\n  inventory, no automatic reissue, no Inbox item until a key is read back;\n  (c) rejected or failed Delete: the reminder stays, the old key stays listed,\n  `old_key_removed_at` stays unset and the panel stays at stage 3 with the\n  refusal reason; (d) unknown Delete outcome: \"removal not confirmed\" with\n  reconciliation by readback, reminder retained; (e) both timestamps stable\n  across reads and tenant switches), V2-T03, T06 (resumed panel has no secret\n  controls), T07 (Inbox item lifecycle), T08 (timestamps labelled and\n  stable), V2-T19 (unavailable product renders no inventory and no action).\n- Live (C31 only): one topic review apply and read-back against the\n  change-allowed tenant under the `airs-v2-c25-` prefix, with cleanup. Key\n  issuance and deletion are not run live in P09; they are covered by the\n  C09 fixtures and the existing C25 L-rows.\n# Inbox and reads\n\nSource: `R2App` (`ITEMS`, `visibleItems`, `ack`, `snoozed`, `snooze`,\n`inboxRows`, `sel`, `startRead`, `recheck`, `toGo`). Chunk: C30.\n\n## Inbox\n\n- Tabs All / Needs action / Updates / Snoozed with counts. Rows: severity\n  (colour + icon + word), title, product, source line (\"API keys · cached\",\n  \"rotated 07:46\"), when, acknowledged mark. Selecting opens the detail pane:\n  body, facts table, \"Why this matters\" explanation, action button (navigates\n  with context), Acknowledge / Mark as needing action, Snooze or Unsnooze.\n- Empty states distinguish \"first read pending\" from \"nothing needs action\"\n  and name partial sources (\"3 of 6 sources were read at 07:45\").\n- Snooze: per item, core-computed return time, 24 hours for every item in\n  P09 (the prototype's deadline-bound rotation snooze is not carried: no\n  admitted operation has a grace deadline, P20). The label, toast and\n  Snoozed-tab \"Returns …\" text all state the same time (I11). The\n  `deadline` field stays optional for a future item that has a real one.\n- Contextual navigation: an item's action carries a target (screen, product,\n  tab, conversation). Into an ended conversation it sets a transient hint\n  offering \"Open the saved transcript\" and \"Start a new investigation\".\n\n## Reads (I4)\n\n- `readTenant` runs a finite read of every selected product; `ReadStatus`\n  carries per-product state (pending, ok, partial, needsRole), last-read\n  time and counts. First read on a fresh tenant shows pending everywhere.\n- Completion toast: ok \"Read finished at 07:45 · all sources complete\" or\n  warn \"· 3 sources partial\"; for fresh tenants \"· 1 product still needs a\n  role\" or \"· no activity yet in <tenant>\". `recheckProduct` after a role is\n  granted shows an info toast and re-reads.\n\n## Core contract\n\n- Scope `InboxItem{id, kind, severity, title, product, source, when, body,\n  facts, action_target, explanation, deadline?, snooze_return?, acknowledged}`\n  per tenant; intents `acknowledgeItem`, `snoozeItem`, `unsnoozeItem`,\n  `readTenant`, `recheckProduct`.\n- The rotation reminder (`rotation-<application>`) is a distinct item id from\n  the expiry alert and clears only when the old key's deletion is read back\n  (I7). Items exist only for admitted products (DESIGN-V2 §6).\n\n## Fixtures and tests\n\n- Board R2Inbox. Tests V2-R02, R04, R08, R09; V2-T04, T12, T13; V2-N02.\n# Shell, Home, tenant switcher, palette, toasts\n\nSource: `prototype/R2App.dc.html` (sidebar markup, `nav`, `switchPatch`,\n`requestSwitch`, `palette*`, `toast*`, `top`, Home section). Chunk: C28 (shell,\nHome skeleton), C30 (Home attention list backed by Inbox scope).\n\n## Sidebar\n\n- Top: tenant switcher button showing tenant name and environment pill;\n  ⌘T opens the list. Entries: every tenant (name, environment, TSG), then\n  \"Add a tenant…\". Selected tenant uses `sel/selInk`.\n- Destinations in the order of DESIGN-V2 §5 with icon, label, shortcut hint.\n  Unavailable destinations render disabled with their availability reason as\n  a tooltip and accessible description, never hidden.\n- Bottom: appearance toggle (light/dark/system) and \"Show the calls\" toggle,\n  both dispatching their Rust preference.\n- Collapses to icons below 1280px window width.\n\n## Home\n\n- Title \"Home\" with the tenant name and environment beneath; last-read line\n  from `ReadStatus` (\"Read finished at 07:45 · all sources complete\" or\n  \"· 3 sources partial\", warn-styled when partial; \"First read pending\" on a\n  fresh tenant).\n- \"Needs attention\": up to five Inbox items of kind Needs action, each with\n  severity (colour + icon + word), title, product, action button that\n  navigates with context, Acknowledge, and Snooze whose tooltip and\n  accessible name are the item's `snoozeLabel`.\n- Product cards for admitted, licensed products with their read state;\n  unlicensed products are listed once as \"Not licensed in this tenant\" and\n  unavailable products once as \"Not available in this release\" (DESIGN-V2\n  §6), never hidden.\n- Playground card (Runtime Security scan): prompt, direction, profile select,\n  verdict panel (word + icon + reason + plain explanation). Verdicts are\n  profile-aware: a detector not enabled, or a topic not assigned, reads \"Not\n  detected\" with the reason; monitor-only turns Blocked into Flagged with the\n  profile named.\n\n## Tenant switch (I1, I2)\n\n- `switchTenant{tenant_id, resolution?}`; the core refuses with\n  `SwitchBlocked{pending: {conversation, decision}}` when a Harness decision is\n  pending. The UI renders the guard dialog (Archive and switch / Discard and\n  switch / Stay) from that payload and re-dispatches with `resolution`. Initial\n  focus is on Stay, the safe default (Enter on arrival never ends the\n  conversation); Archive and switch stays the visually primary action.\n- Every entry point (switcher, palette, menu, wizard completion) uses the same\n  intent. After a switch the new tenant's Home renders from cached scopes within\n  100 ms with read status pending until the read lands.\n\n## Command palette\n\n- ⌘K. Entries: destinations from the Rust inventory, tenants, and three actions\n  (Navigate, Switch tenant, Read now). Typing filters; Enter dispatches; Escape\n  closes and restores focus. Native menu navigation while the palette is open\n  closes it first.\n\n## Toasts (I10)\n\n- Kinds ok, info, warn with icon and colour; one visible at a time, newest\n  replaces; 6 s expiry (persist under Reduce Motion); optional Undo action\n  (snooze). A toast never carries information absent from an observed scope.\n\n## Modals (I8)\n\n- Stack order kept in the shell store; only the topmost is interactive;\n  siblings get `aria-hidden`; Escape closes the topmost; focus returns to the\n  opener. Detail sheets (transcripts, facts) are modals in this stack.\n\n## Fixtures and tests\n\n- Fixture boards: R2Palette, R2Tenants, R2Dark, R2App default.\n- V2-T01, T02, T09, T10, T11; V2-N01, N03, N04, N05.\n# First-run wizard and add-tenant sheet\n\nSource: `prototype/R2Onboard.dc.html` (steps, `ERR`, `touch`, `vsig`,\n`verify`, `opened`, `railCtx`, `mode=\"add\"`), `R2App` `addtenant` overlay.\nChunk: C29. Realises D013 (scan-key-first onboarding).\n\n## Steps (first run)\n\n1. **Welcome** — explains that the app is built entirely on Palo Alto\n   Networks' public APIs and exists to show application builders what those\n   interfaces make possible; three cards: Built on the public APIs / See the\n   calls as you go / Learn by doing. Continue.\n2. **Tenant** — name, environment (select), region (select), TSG id, then\n   three credential sections in this order (D013, deviation P17):\n   **Scan key** (required on first run): \"Add scan key…\" opens the host\n   secret sheet and returns a vault id shown as a masked indicator.\n   **Management client** (optional): client id field plus \"Add client\n   secret…\" (host secret sheet); without it Administration is read-only and\n   says so. **Gateway** (optional toggle): workspace name, endpoint URL,\n   \"Add workspace key…\". Secondary action \"Import from Prisma AIRS Desktop\n   v1\" fills name/environment/TSG from the import intent; secrets are always\n   re-entered. Validation per field on blur with\n   `aria-invalid` and `aria-describedby`; the Continue button names what is\n   missing. After this step the rail shows \"Name · Environment · TSG …\" under\n   its title.\n3. **Products** — cards for the products in DESIGN-V2 §6. Admitted products\n   show licence state read from the tenant and are selectable; Red Team and\n   Model/skill are marked read-only; Agentic Identity Security and Agentic\n   Endpoint Security are shown as \"Not available in this release\" and cannot\n   be selected (P18).\n4. **Verify** — dispatch `verifyTenantSetup`; per-product rows fill as\n   `VerifyStep` results stream (pass / warning / fail with reason) using the\n   existing reads for each admitted product (scan capability check, a\n   management read when a client is present, Gateway prerequisites).\n   Unavailable products show \"Not available\", never a result. The warning\n   and failed rows are fixtures on admitted products. Fail offers \"Fix and verify\n   again\" (returns to Tenant) or \"Continue with warnings\"; warnings become\n   Inbox items on completion.\n5. **Starter packs** (optional) — test-case packs per selected product with\n   counts.\n6. **Academy account** (optional) — sign in or skip; the trust copy states\n   exactly what syncs (Academy progress only).\n7. **Done** — summary; \"Open Prisma AIRS\" is finite (`opening` → done) and\n   dispatches `completeOnboarding`.\n\n## Add-tenant sheet (`mode=\"add\"`)\n\n- 1160×780 sheet over the shell, rail 244px, no Welcome or Academy steps,\n  Cancel at every step; completion dispatches `addTenant` then `switchTenant`.\n  Cancel discards everything except a credential already written by the\n  secret sheet, which is shown in Administration as unattached and can be\n  removed there.\n\n## Core contract\n\n- `verifyTenantSetup{draft}` → stream of `VerifyStep{product, state, reason}`\n  then `VerifyDone{warnings}`.\n- `completeOnboarding{name, env, region, tsg, scan_credential_id,\n  management: {client_id, credential_id}?, gateway: {ws, endpoint,\n  credential_id}?, products, packs, academy_opt_in, warnings}` writes the tenant profile, product\n  selection, packs and Inbox warning items; sets `onboarding=done`.\n- `addTenant{...same minus academy}`.\n- The core never receives a secret through these intents; `credential_ids`\n  reference vault records created by the host secret sheet.\n\n## Fixtures and tests\n\n- Boards: see [boards.md](boards.md) (`fx.on.*`, `fx.addTenant`).\n- Tests: step validation and invalidation signature; streaming verify order;\n  cancel semantics; `onboarding` transitions; V2-N02.\n- Live (C29 only): verify against Vulture, reads only, under the designated\n  scope.\n# Academy embed\n\nSource: `R2App` Academy section, board R2Academy. Chunk: C34.\n\nThe Academy learner view (react-query, react-router, Academy ShellFrame) is\nhosted inside the new shell unchanged: the new sidebar replaces its outer\nframe, its inner routing and tests stay intact. Gamification appears only\nhere. The wizard's Academy step is the only other Academy surface.\n\nTokens: Academy's `--academy-*` variables remain its own; within the embed\nscope the shell aliases nothing. The embed receives the Rust-owned theme.\n\nTests: existing Academy presentation tests unchanged; one shell test that the\nembed mounts under `academy` and receives theme changes.\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_57","type":"command_execution","command":"/bin/zsh -lc \"cat docs/architecture/ui-v2/state-ownership.md docs/architecture/ui-v2/screens/administration-inventory.md; sed -n '830,920p' docs/planning/decisions.md; cat docs/planning/reviews/P09/attempt-01/invocation.json; head -35 docs/planning/reviews/P09/attempt-01/diff.patch\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_57","type":"command_execution","command":"/bin/zsh -lc \"cat docs/architecture/ui-v2/state-ownership.md docs/architecture/ui-v2/screens/administration-inventory.md; sed -n '830,920p' docs/planning/decisions.md; cat docs/planning/reviews/P09/attempt-01/invocation.json; head -35 docs/planning/reviews/P09/attempt-01/diff.patch\"","aggregated_output":"# State ownership\n\nEvery state key the frozen prototype actually holds is listed here, by file\nand by the name the prototype uses, with its owner, where it lives, its\nlifetime, and whether the implementation keeps, renames, derives or drops it.\n\n- **Core** — Rust-owned in desktop-core, exposed through `observe`\n  (persisted in the store or session-held), never in browser storage.\n- **UI** — transient presentation state in a per-screen-family zustand store\n  (shell, wizard, inbox, admin, harness, workbench) or React form state.\n  Lost on reload by design.\n- **Host** — never leaves the native host (secret sheet, clipboard).\n- **Dropped** — not implemented; the reason is in [provenance.md](provenance.md).\n\nThe inventory was produced from `grep -o` over `s.*`, `ts.*` and `f.*` in\n`prototype/R2App.dc.html` and `prototype/R2Onboard.dc.html` (version 134)\nand reconciled by hand; a key missing here is a specification defect.\n\n## R2Onboard — wizard and add-tenant sheet (`s.*`, `s.f.*`)\n\n| Prototype key | Meaning | Owner | Where / intent | Lifetime | Disposition |\n|---|---|---|---|---|---|\n| `s.idx`, `s.path`, `s.vi` | current step, step path, visited steps | UI | wizard store | until the wizard closes | kept; `onboarding=inProgress` is set in core when the welcome step is left |\n| `s.f.name` | tenant display name | UI → Core | `completeOnboarding`/`addTenant` | written at completion | kept |\n| `s.env`, `s.region` | environment, region selects | UI → Core | same | same | kept |\n| `s.f.tsg` | TSG id (10 digits) | UI → Core | same | same | kept |\n| `s.f.clientId`, `s.f.secret` | management OAuth client id and secret (required in the prototype) | id: UI → Core; secret: **Host** | id in `addTenant`; secret entered only in the host secret sheet, vault record id returned | secret never in the web layer | **changed** (deviation P17): management credentials become an optional second section under D013; the id is kept, the secret field is replaced by \"Add management client…\" |\n| `s.scanOn`, `s.f.scanKey` | scan key toggle and value | toggle: UI; key: **Host** | \"Add scan key…\" opens the host secret sheet; required for first run (D013) | never in the web layer | **changed** (P1, P17): toggle removed on first run (the scan key is required); kept in add mode |\n| `s.gwOn`, `s.f.ws`, `s.f.endpoint`, `s.f.gwKey` | Gateway section toggle, workspace name, endpoint URL, workspace key | toggle/ws/endpoint: UI → Core; key: **Host** | `addTenant.gateway{ws, endpoint}`; key via secret sheet | — | kept; key path changed (P1) |\n| `s.tried`, `s.vsig`, `s.vsStale` | validation attempted, validation signature, stale flag | UI (tried) / Core (signature, stale) | wizard component; `setup.verify.stale`, `setup.completable` | per step / per draft | kept; the signature and the completion gate moved to the core so the presentation cannot complete over stale results |\n| `s.vs` | verify results per product | Core | `ShellSnapshot.setup.verify` (streamed `VerifyStep`s from `verifyTenantSetup`, with `done`/`failed`/`stale`) | until the draft completes or is discarded | kept; computed in core, including staleness against a signature of the draft's inputs |\n| `s.aesFixed`, `s.failCleared` | AES warning demo acknowledged; failed row cleared | UI | wizard store | per run | **changed**: AES is not an admitted product (P18); the warning demo becomes a generic \"warning row\" fixture on an admitted product |\n| `s.prods` | selected products | UI → Core | `completeOnboarding.products` | written at completion | kept; unavailable products are not selectable (P18) |\n| `s.packs`, `s.casesState` | starter packs selected, pack state | UI → Core | `completeTenantSetup.products` → the bundled catalog's cases as library entries named by their starter pack, Not run (P55) | written at completion | kept |\n| `s.acad`, `s.af` (`f.email`, `f.dname`), `s.streaks`, `s.remind` | local Academy account form, streaks, reminders | **Dropped** / Core (Academy) | Academy identity is hosted (D004–D006, C04); the step signs in or skips | — | **changed** (P19): no local account, streaks or reminders in the wizard |\n| `s.help` | help popover open | UI | wizard store | transient | kept |\n| `s.opened` | \"Open Prisma AIRS\" progress | UI | mirrors the `onboarding` transition | transient | kept |\n| `s.theme` | theme prop | Core | `appearance` | — | kept (observed) |\n\n## R2App — shell (`s.*`)\n\n| Prototype key | Meaning | Owner | Where | Lifetime | Disposition |\n|---|---|---|---|---|---|\n| `s.tenant`, `s.byTenant` | active tenant; per-tenant state bag | Core | `ShellSnapshot.active`, per-tenant scopes below | persisted | kept; the bag is replaced by scopes |\n| `s.screen` | destination | Core | `navigate` intent, `ShellSnapshot.features` | session | kept; feature ids gain `home`, `inbox` |\n| `s.theme` | theme | Core | `appearance` | persisted | kept |\n| `s.wizard`, `s.added` | first-run wizard open; add-tenant sheet result | Core / UI | `ShellSnapshot.onboarding`; sheet result is a toast | — | kept |\n| `s.overlayDone` | prototype overlay bookkeeping | **Dropped** | canvas-only | — | dropped |\n| `s.palette`, `s.pq` | palette open, query | UI | shell store | transient | kept |\n| `s.tenantOpen`, `s.guard` | switcher open; switch guard | UI | shell store; guard content from the `SwitchBlocked` refusal (`to`, `pending`, `completion`), rendered by the shell for a switch and by the wizard for a setup completion | transient | kept (I1); completion is the same guarded path (P36) |\n| `s.toast`, `s.toastKind`, `s.undo` | toast text, kind, undo target | UI | shell store, timer | ≤ 6 s | kept (I10) |\n| `s.detail`, `s.sheet` | detail sheet; confirm sheet | UI | shell store modal stack | transient | kept (I8) |\n| `s.explain` | explain-mode toggle | UI | shell store | transient | kept |\n| `s.sel`, `s.itab` | Inbox selection, tab | UI | shell store, keyed by tenant id | transient; a switch round trip keeps it (I2) | kept |\n| `s.product`, `s.exp`, `s.ptab`, `s.allOpen`, `s.adminNav`, `s.adminQ`, `s.tree` | Administration product, expanded set, tab per product, expand-all, nav mode, search, tree | UI | admin store | transient | kept |\n| `s.review`, `s.reviewKind`, `s.reviewFrom`, `s.reviewTenant`, `s.reviewApplied` | review open, kind, origin, bound tenant, applied | Core | `Review` scope (tenant-bound, invalidated on context change) | session | kept; the UI holds only \"open\" |\n| `s.typed` | typed confirmation | UI | admin store | until review exit | kept (I3) |\n| `s.secretVisible` | reveal toggle | **Host** | `RevealSecret` sheet; UI holds nothing | 60 s sheet | **changed** (P2): no web reveal state |\n| `s.credOpen`, `s.credVal` | credential dialog open, value | Host | credential entry is the host secret sheet | — | **changed** (P1): no web credential value |\n| `s.packsOpen`, `s.packPick` | starter-pack dialog, picks | UI → Core | library intent | transient | kept |\n| `s.ncOpen`, `s.ncName`, `s.ncPid`, `s.ncInput`, `s.ncDir` | new-case dialog fields | UI → Core | `createCase` (existing library) | transient | kept |\n| `s.casePage`, `s.caseQ`, `s.cfil` | Test Cases paging, search, filter | UI | Test Cases screen state (keyed by context) | transient | kept |\n| `s.req`, `s.reqQ`, `s.fmt`, `s.rtab`, `s.rsub` | API Client request, search, body format, response tab, sub-tab | UI | workbench store | transient | kept |\n| `s.quiz` | Academy quiz state | **Dropped** | hosted Academy owns it (P19) | — | dropped |\n| `s.convoHint` | ended-conversation hint | UI | harness store; cleared by any navigation; its opening question is the core's `opening` (the conversation's, or the opened saved record's), never the title (P51) | transient | kept |\n| (none; DESIGN-V2 §3) | \"Show the calls\" preference and panel | Core | `ShellSnapshot.showCalls` (the operator's choice once made, else on until onboarding completes) and `ShellSnapshot.calls` (the active tenant's calls this app run: request line, credential kind, header names, status, duration; never a value, query or body) (P54) | preference persisted; calls in memory for the app run | added |\n| `ts.activeCase` hand-off | the case opened in the Playground | UI → Core | shell store `playground` (tenant, case, fields) → Runtime Playground prefill; the scan names the case (`scan.case`) and the core records its result (P55, P56) | until the next hand-off | kept |\n\n## R2App — per-tenant (`ts.*`)\n\n| Prototype key | Meaning | Owner | Where | Lifetime | Disposition |\n|---|---|---|---|---|---|\n| `ts.reading`, `ts.reads`, `ts.firstRead`, `ts.lastRead`, `ts.warnCleared`, `ts.capsScan` | read in progress, count, first read done, last-read time, warning cleared, scan capability | Core | `ReadStatus` scope, from the tenant's read record (one per opened tenant, kept across a switch round trip, P37) | session, per tenant | kept (I4); `reads` count is not shown and never feeds a timestamp |\n| `ts.ack`, `ts.snoozed` | acknowledgments, snoozes with return | Core | `InboxEntry.hold` (`acknowledge`, or `snooze` with `returnsAt` computed in the core); intents `acknowledgeItem`/`snoozeItem`/`unsnoozeItem`; the last snooze's `SnoozeReceipt` on the Inbox scope is what the toast announces, once (P38) | session, per tenant (as v1's holds) | kept (I11); not persisted across a relaunch, as the retained holds were not |\n| `ts.prompt`, `ts.dir`, `ts.profile`, `ts.model`, `ts.app`, `ts.kind`, `ts.scanned`, `ts.scanDir`, `ts.scanProfile`, `ts.results`, `ts.activeCase`, `ts.activeInput`, `ts.activeDir` | Playground prompt, direction, profile, model, app, classified kind, scanned flag, scan selectors, per-case results, active case | prompt/dir/profile/model/app: UI; scan result + per-case results: Core | workbench store; `ScanRecordView` (existing) and library case results | prompt transient; results persisted per tenant | kept; verdict computed by the existing scan path, never by a UI classifier (the prototype's `classify` is fixture-only) |\n| `ts.extraCases`, `ts.packs` | user-created cases, packs | Core | library | persisted | kept |\n| `ts.hist` | API responses | Core | workbench history | persisted | kept (I5) |\n| `ts.topicRev`, `ts.topicDesc`, `ts.injApplied`, `ts.aesApplied`, `ts.aesRev` | applied review results | Core | read back from the product scopes after apply | — | kept for Runtime topics; `aes*` **dropped** (P18) |\n| `ts.keyRotated`, `ts.keySecretClosed`, `ts.keyDeployed`, `ts.keyDoneAt` | rotation stage | Core | `Tenant.rotations` → `ShellSnapshot.rotations: RotationView{stage, oldKey, newKey, issuedBy, deploymentAcknowledgedAt, oldKeyRemovedAt, removalRejected}`; stage derived (issuanceUnconfirmed, issued, resumed, acknowledged, removalUnconfirmed, complete); intent `acknowledgeDeployment` | per tenant, persisted (timestamps stored once, and the reviewed key name that alone confirms an unconfirmed issuance); the held secret only on its change result, for its context | **changed** (P20, P41): supported Version → Delete sequence; see screens/reviews-administration.md |\n| `ts.follows` | follow-up status per conversation | Core | sessions | persisted | kept |\n| `ts.convo`, `ts.userConvos`, `ts.msgsBy`, `ts.decs`, `ts.ended`, `ts.archived` | current conversation, user conversations, messages, decisions, ended flags, archives | Core | existing harness sessions and decisions | persisted, protected | kept |\n| `ts.draft` | composer draft | UI | shell store per tenant and workspace ID (`harnessDrafts`), with kept messages (`harnessUnsent`: not sent, or not confirmed until their own conversation reports the core took their send ID, `ConversationView.submissions`) | transient | kept |\n\n## Credential entry paths (native)\n\n| Credential | Entry | Storage | Readable by the web layer |\n|---|---|---|---|\n| Scan API key | webview password field read through a ref, cleared at once, sent once as `EnteredSecret` inside `configureScanCredential` (P25) | vault (`cr-` record), Keychain v2 namespace | state and mode only (`ScanView`), never the value |\n| Management client secret | same path, `configureManagementCredential` (optional section) | vault | client id and state only |\n| Gateway workspace key | same path, `configureInferenceCredential` | vault | state only |\n| Issued API key (rotation) | `RevealSecret` host sheet / host clipboard | held per result for the active context, never persisted; retired by the review's exit (`DiscardChange` on the applied review, also before the change settles), by acknowledging the deployment, or by a context change | never |\n# Administration inventory: every prototype product, tab and action\n\nSource: `prototype/R2App.dc.html` `PRODUCTS` (tabs, `single`, `readOnly`),\nthe `T` tables (`rt:Security profiles`, `rt:Custom topics`, `rt:API keys`,\n`gw:Routes`, `rtm:Scans`, `sc:Skill scans`, `ais:Tool policies`,\n`aes:Discovered AI`, `aes:Policies`) and row actions (line 1099). Admitted\noperations are the retained core's: `ManagementResource` reads and\n`changes::allowed(kind, action)` (`changes.rs` 253–268), `GatewayRead` and\n`gateway_changes::allowed` (`gateway_changes.rs`), and the C13 read-only\nobservation functions in `red_team.rs`. The `AdminInventory` scope (C31) is\ngenerated from this table and tested against it (V2-T20); the core refuses\nany (kind, action) outside the matrices (existing `allowed`, V2-R11).\n\nDispositions: **Read** (admitted read, rows shown), **Change** (admitted\nreviewed change with the exact actions), **Unavailable** (no admitted\nservice: tab renders \"Not available in this release\" with the gate, no rows,\nno actions), **Removed** (prototype tab not carried, with reason).\n\n## AI Runtime Security (`rt`)\n\nReads: `ManagementResource::{Profiles, Topics, Applications, ApiKeys,\nDeploymentProfiles, DlpCatalog, DataProfiles, DataPatterns,\nFilteringProfiles, Dictionaries, Sessions}`.\n\n| Tab | Disposition | Reads | Admitted actions (`ChangeKind` · `ChangeAction`) | Denied in the UI (never offered) | Fixture / contract |\n|---|---|---|---|---|---|\n| Overview | Read | counts from the reads above; `ScanRecordView` | — | — | C08/C12 fixtures |\n| Playground | Read + scan | `scan.rs` (existing synchronous scan) | — | — | C03 scan fixtures |\n| Security profiles | Change | Profiles | Profiles · Create (\"New profile…\"), Update (\"Edit…\"), Delete | — | C09 fixtures |\n| Custom topics | Change | Topics | Topics · Create (\"New topic…\"), Update (\"Edit…\"), Delete | — | C09 fixtures |\n| Applications | Change | Applications | Applications · Update (\"Edit…\"), Delete | **Create** (not admitted; no \"New application…\") | C09 |\n| API keys | Change | ApiKeys | ApiKeys · Create (\"New API key…\"), Version (\"Issue additional key…\"), Rotate (\"Regenerate…\"), Delete (\"Remove…\") | **Update** (not admitted; no \"Edit…\") | C09 one-time secrets |\n| DLP | Change | DlpCatalog, DataPatterns, DataProfiles, FilteringProfiles, Dictionaries | DataPatterns · Create/Update/Delete; Dictionaries · Create/Update/Delete; DataProfiles · Create/Update; FilteringProfiles · Update | **DataProfiles · Delete**, **FilteringProfiles · Create/Delete**, **DlpCatalog · any** | C10 fixtures |\n| Deployment profiles | Read | DeploymentProfiles | — | any change | C08 |\n\n## AI Gateway (`gw`)\n\nReads: `GatewayRead::{Inventory, Detail, IntegrationModels, Prerequisites,\nObserve, McpServers}`.\n\n| Tab | Disposition | Reads | Admitted actions | Denied in the UI | Fixture / contract |\n|---|---|---|---|---|---|\n| Overview | Read | Observe, Prerequisites | — | — | C16/C18 |\n| Workspaces | Change | Inventory/Detail (workspaces) | GatewayWorkspaces · Create (\"New workspace…\"), Update, Delete | Rotate | C16/C17 |\n| Routes | Change | Inventory/Detail (routes) | GatewayRoutes · Create (\"New route…\"), Update, Delete | Version | C17 |\n| Providers | Change | Inventory/Detail (providers) | GatewayProviders · Create (\"New provider…\"), Update, Delete | Models | C17 |\n| Guardrails | Change | Inventory/Detail (guardrails) | GatewayGuardrails · Create (\"New guardrail…\"), Update, Delete | — | C17 |\n| Keys | Change | Inventory (service keys, user keys) | GatewayServiceKeys / GatewayUserKeys · Create (\"New key…\"), Update (\"Edit…\"), Rotate (\"Rotate…\", regenerates in place: `GatewayApiKeyRotateRequestSchema`, one-time reveal through the host, no staged sequence), Delete (\"Remove…\") | **Version** (not admitted: no \"Issue additional key…\", no \"Finish rotation…\", no rotation reminder) | C17 |\n| Integrations (prototype folds into Providers) | Change | IntegrationModels | GatewayIntegrations · Create, Update, Delete, Models (\"Replace model list…\") | Rotate | C17 |\n| Limits | **Removed** | — | — | — | the prototype's route budget limits have no admitted read or change; budgets appear in Routes detail only when the service returns them (C16) |\n| Logs | Read | Observe (telemetry) | — | any creation (no \"New…\" on an activity tab) | C18 |\n| MCP servers (in AIS in the prototype) | Read | McpServers | — | — | C22; used by Harness lifecycle 2 (P16) |\n\n## AI Red Teaming (`rtm`, read-only, `readOnly: true`)\n\nReads: `red_team.rs` — `statistics`, `red_team_scans`, `attacks` (paged).\n\n| Tab | Disposition | Reads | Actions | Fixture |\n|---|---|---|---|---|\n| Overview | Read | statistics | none | C13 |\n| Targets | Read (identifiers and types only) | `target_id` and `target_type` as carried by `red_team_scans` (`red_team.rs` 56–66); target names are not admitted by the C13 privacy boundary and are never shown | none; \"Results\" opens the scan | C13; deviation P22; V2-T21 asserts no target name appears in the rendered tab or in any scope the tab reads |\n| Scans | Read | red_team_scans | none | C13 |\n| Attack results | Read | attacks | none | C13 |\n| Reports | Read | static reports (existing C13 metadata-only) | none; no execution | C13 |\n\nNew scans, re-runs and \"hand the spec to a scan\" never dispatch anything;\nTest Cases \"Inspect\" applies (P21).\n\n## Model/skill observability (`sc`, \"AI Supply Chain\" in the prototype)\n\nReads: `red_team.rs` — `model_scans`, `skill_scans` (pseudonymised),\n`skill_statistics`.\n\n| Tab | Disposition | Reads | Actions | Fixture |\n|---|---|---|---|---|\n| Overview | Read | skill_statistics, model_scans counts | none | C13 |\n| Model scans | Read | model_scans | none | C13 |\n| Skill scans | Read | skill_scans | none | C13 |\n| Codebase scans | **Unavailable** | none admitted | none | gate: an admitted codebase-scan read |\n| Policies | **Unavailable** (`single: 'policy'` not carried) | none | none; no \"New policy…\" | gate: an admitted supply-chain policy service |\n\nThe product is shown under its C13 name (\"Model and skill scans\"), not as\na scanning product.\n\n## Agentic Identity Security (`ais`) — Unavailable\n\n| Tab | Disposition |\n|---|---|\n| Overview, Tool policies, Identities (Idira), Invocation log | **Unavailable**: \"Not available in this release · needs an admitted AIS service (D058)\". No rows, no \"New policy…\", no review. |\n| MCP servers | carried as a Gateway tab (above) because the read is `GatewayRead::McpServers` |\n\n## Agentic Endpoint Security (`aes`) — Unavailable\n\n| Tab | Disposition |\n|---|---|\n| Overview, Endpoints, Discovered AI, Extensions & packages, Policies | **Unavailable** with the same notice. The prototype's `REVIEWS.aes` policy review, the `aes:Discovered AI` and `aes:Policies` tables and the wizard AES warning demo are fixtures only and are not implemented. |\n\n## Row actions\n\n| Prototype action | Carried as | Condition |\n|---|---|---|\n| Edit… | review `Update` | admitted Update for the tab's kind |\n| Rotate… (Runtime API keys) | review `ApiKeys · Version` labelled \"Issue additional key…\" (the staged rotation sequence of screens/reviews-administration.md) and, separately, `ApiKeys · Rotate` labelled \"Regenerate…\" | Runtime Security API keys only |\n| Rotate… (Gateway keys) | review `GatewayServiceKeys`/`GatewayUserKeys · Rotate` labelled \"Rotate…\": regenerate in place with the existing one-time reveal; no additional-key step, no acknowledgement, no Inbox reminder | Gateway service and user keys only; `Version` is not admitted for Gateway keys |\n| Finish rotation… | opens the Runtime rotation panel (local acknowledgement, then review `ApiKeys · Delete` of the old key) | Runtime rotation in progress only |\n| View | detail sheet (read) | always for Read tabs |\n| Results | detail of a read-only scan | Red Team / Model-skill |\n\n## Tests\n\n- V2-T20: for every (product, tab) above, the rendered tab matches its\n  disposition: Read/Change tabs show rows and exactly the listed actions;\n  Unavailable tabs show the notice and no rows or actions; Removed tabs do\n  not exist.\n- V2-R11: the core refuses every (kind, action) pair in the \"Denied\" column\n  (already enforced by `allowed`; the test pins the matrix so a UI label\n  cannot outrun it), including `GatewayServiceKeys`/`GatewayUserKeys ·\n  Version`.\n- V2-T20 additionally asserts that Gateway key rows render \"Rotate…\" and\n  never \"Issue additional key…\" or \"Finish rotation…\", and that no Gateway\n  rotation creates an Inbox reminder.\n- V2-T21: the Red Team Targets tab renders identifiers and types only; a\n  fixture scan reply carrying a `target_name` field is rendered without it\n  and the field never reaches the `AdminInventory` scope.\n  tenant authority and are never stored, resolved or sent here.\n- **Imports.** cURL (v1's lexer and option list; credentials become secret\n  references; credential-named query, JSON or form fields are refused) and\n  Insomnia v5 / schema 5.1 exports (YAML or JSON through `serde_yaml_ng`\n  0.10.0, bounded to 1 MiB, depth 64, 50,000 nodes and 16 MiB expanded;\n  scripts, template expressions, path parameters and non-default settings\n  refuse that request). Imported requests are unsaved drafts; imported\n  environments are new shared files and never replace one; the source is\n  only read.\n- **Git view.** Read-only branch, HEAD, upstream and changed paths from an\n  absolute `git` (never PATH or the `/usr/bin` shim), with an empty\n  environment, no system or global configuration, fsmonitor and hooks\n  disabled, no optional locks, 5 s and 1 MiB. v1's hosting links and saved\n  diff are not reproduced here.\n- **Profile adoption.** v1's API Client profile (recent collections and\n  their private environments) is previewed and imported on request; the\n  source is only read; secret values, drafts, history and cookies do not\n  transfer (D015). v1's separate \"Import Rusty profile\" migration is not\n  reproduced.\n- **Built-in collection.** v1's sanitized catalog (193 request\n  specifications, `src/api_client/scm/catalog.json` at 74754c02, SHA-256\n  914a9ee7…037a8c) is written to the private folder and opened as an\n  ordinary collection; a refresh replaces or removes a file only while it is\n  exactly as last written. These are generic specifications, not dedicated\n  workflows or live qualification.\n- **Close guard.** Quitting (the app's own Quit item, since AppKit's\n  predefined one bypasses the event loop) or closing the window first waits\n  300 ms for intents already sent, then, while edits are not protected,\n  asks in a native sheet (Quit anyway / Cancel). File > Save (Cmd+S) is a\n  native menu item, because WKWebView receives Command shortcuts only\n  through menus.\n- **Not done here.** Nothing is sent: execution, history, cookies,\n  downloads, OAuth tokens and admission of managed requests arrive in C15.\n\n## D041 — API Client execution and managed-request admission (ADR 0004)\n\nDecided in C15 (implementer decision, recorded for review).\n\n- **Fresh input, Rust-built requests.** Send and Apply carry the editor's\n  full snapshot and the revision it was edited from (a different revision is\n  refused, as Save). Rust renders it against the current environment layers\n  (v1's precedence, one-level `{{name}}`, `{{{` escape; unresolved, unclosed\n  and nested names refused), builds the actual request itself and sends it;\n  the presentation never supplies a prepared or approved request. Bodies are\n  v1's text, JSON (application/json unless set), form, multipart (64 MiB per\n  file, 128 MiB in all, an explicit Content-Type refused) and stored files\n  (64 MiB), streamed from the collection.\n- **Credential classes.** Decided from the secret references the rendered\n  request would use, never from a collection or request identity:\n  anonymous, workbench (Keychain secrets of the collection) or managed (a\n  native tenant credential). Managed references are `tenant.client_id`,\n  `tenant.client_secret`, `tenant.api_key` and `tenant.tsg_id` (filled in as\n  text); any other `tenant.*` reference is refused, and workbench secrets\n  never ride with tenant credentials. The built-in collection now names\n  these instead of v1's per-tenant `tenant.select` environments.\n- **Admission before any secret is read.** The OAuth client pair goes only\n  into an `oauth2` grant whose token URL is exactly the management\n  capability's token URL (or the catalogue's `/auth/v1/oauth2/access_token`\n  at the same, stored token origin); the scan key only as the `x-pan-token`\n  header to the tenant's stored scan origin. Requests with tenant\n  credentials use HTTPS, an admitted API origin (the configured management\n  endpoints plus `api.sase.paloaltonetworks.com`, the catalogue's host) and\n  no Authorization, Cookie, x-pan-token or method-override headers of the\n  operator's. Their method and path must be one of the 193 built-in\n  catalogue operations (variables are single path segments; encoded\n  separators or dots, empty, dot and parameter segments are refused before\n  normalization). Known reads are sent; known mutations (81) need a review;\n  any other method or path is denied, whatever it is presented as.\n- **Registered Prisma origins** (attempt-01 R1, R2). The configured\n  management, token and workbench API origins, the AIRS scan regions and\n  every tenant's scan destination are registered by host and port with or\n  without an active tenant or ready credential. Requests there are\n  classified whatever their credential: a manual Authorization header, a\n  collection secret or none still needs a review for a known mutation, and\n  any unknown operation is denied. Generic redirects never enter a\n  registered origin (the 3xx is the result). URL user-info and Host,\n  Forwarded, X-Forwarded-Host, X-Original-URL and X-Rewrite-URL headers are\n  refused for managed and registered-origin requests before any secret,\n  whether the editor wrote them or the authentication generates them (an\n  API-key header's name). At a registered origin a method override\n  (X-HTTP-Method-Override, X-HTTP-Method, X-Method-Override) and more than\n  one credential are refused as well. Credentials are the editor's\n  Authorization, Proxy-Authorization, Cookie or x-pan-token headers, the\n  request's authentication (whatever header it generates, or an API key in\n  the query) and the collection jar's Cookie header for the URL. The jar is\n  read when the request is planned, before any secret, and the Cookie it\n  gives is the one the first hop sends. One credential still goes: a\n  manual Authorization, or the session cookie alone (P04 push, attempt-02\n  R2 and attempt-03).\n- **Context binding** (attempt-01 R3). Every context change retires the\n  pending review permanently; Apply also checks that its context is the\n{\n  \"command_without_prompt\": [\n    \"codex\",\n    \"--no-daemon\",\n    \"-a\",\n    \"never\",\n    \"--disable\",\n    \"hooks\",\n    \"--disable\",\n    \"plugins\",\n    \"--disable\",\n    \"apps\",\n    \"--disable\",\n    \"remote_plugin\",\n    \"--disable\",\n    \"browser_use\",\n    \"--disable\",\n    \"browser_use_external\",\n    \"--disable\",\n    \"in_app_browser\",\n    \"--disable\",\n    \"computer_use\",\n    \"--disable\",\n    \"image_generation\",\n    \"--disable\",\n    \"multi_agent\",\n    \"--disable\",\n    \"skill_search\",\n    \"--disable\",\n    \"skill_mcp_dependency_install\",\n    \"--disable\",\n    \"unbounded_connection_retries\",\n    \"exec\",\n    \"-s\",\n    \"read-only\",\n    \"--skip-git-repo-check\",\n    \"--ephemeral\",\n    \"--ignore-user-config\",\n    \"--ignore-rules\",\n    \"-m\",\n    \"gpt-6.1-sol\",\n    \"--json\",\n    \"--color\",\n    \"never\",\n    \"-c\",\n    \"web_search=\\\"disabled\\\"\",\n    \"-c\",\n    \"model_reasoning_effort=\\\"xhigh\\\"\",\n    \"--output-schema\",\n    \"docs/architecture/review-verdict.schema.json\",\n    \"-o\",\n    \"/Users/cdot/development/redtail/prisma-airs-desktop-v2-current/docs/planning/reviews/P09/attempt-01/verdict-returned.json\"\n  ],\n  \"model_requested\": \"gpt-6.1-sol\",\n  \"harness_version_observed\": \"codex-cli 0.166.0\",\n  \"request_sha256\": \"30745ab58916d4e78aa8f92f05c3cafff0b2864c467ebc94b7fbe9926399d88a\",\n  \"schema_sha256\": \"fa5ddc9b8371a97cdfb8055387e31916fad002859f88fc6f21340844ee2a1875\",\n  \"feature_probe_sha256\": \"bb4d01d583993c8e3c431e0437092e6c288e9b5da919595063853d37e2d89862\",\n  \"restricted_features_observed\": {\n    \"hooks\": \"false\",\n    \"plugins\": \"false\",\n    \"apps\": \"false\",\n    \"remote_plugin\": \"false\",\n    \"browser_use\": \"false\",\n    \"browser_use_external\": \"false\",\n    \"in_app_browser\": \"false\",\n    \"computer_use\": \"false\",\n    \"image_generation\": \"false\",\n    \"multi_agent\": \"false\",\n    \"skill_search\": \"false\