       self.data\n            .active\n            .as_ref()\n            .and_then(|id| self.tenant(id))\n            .map(|t| t.setup_warnings.iter().map(setup_warning_item).collect())\n            .unwrap_or_default()\n    }\n\n    /// The products the active tenant chose (Runtime Security until a setup\n    /// chooses more).\n    pub(super) fn selected_products(&self, tenant: &TenantId) -> Vec<ProductId> {\n        self.tenant(tenant)\n            .map(|t| {\n                if t.products.is_empty() {\n                    vec![ProductId::RuntimeSecurity]\n                } else {\n                    t.products.clone()\n                }\n            })\n            .unwrap_or_default()\n    }\n\n    /// The per-product read status (I4) from the overview read, the other\n    /// products' finite outcomes and the tenant's chosen products. Coverage\n    /// a read did not establish is named in `sources_missing`, so nothing\n    /// unread is ever announced as complete.\n    pub(super) fn read_status(&self, overview: &OverviewView) -> ReadStatus {\n        let products = self\n            .data\n            .active\n            .as_ref()\n            .map(|id| self.selected_products(id))\n            .unwrap_or_default();\n        let record = self.active_record();\n        // A refresh in which no source answered is shown by the overview for\n        // its gaps (C12) but established nothing: it is not a read.\n        let read = overview.read.as_ref().filter(|r| {\n            !(overview.failure.is_some() && r.chart.is_none() && r.keys_failure.is_some())\n        });\n        let outcomes_read = record.is_some_and(|r| r.red_team.is_some() || r.model_skill.is_some());\n        // The latest failed attempts across the chosen products; a missing\n        // role is a settled attempt reported on the product, not a failed read.\n        let attempts: Vec<&FailedAttempt> = record\n            .map(|r| {\n                [\n                    (ProductId::RedTeam, r.red_team_failed.as_ref()),\n                    (ProductId::ModelSkill, r.model_skill_failed.as_ref()),\n                ]\n                .into_iter()\n                .filter(|(p, _)| products.contains(p))\n                .filter_map(|(_, f)| f)\n                .collect()\n            })\n            .unwrap_or_default();\n        let product_failures: Vec<&FailedAttempt> =\n            attempts.iter().copied().filter(|f| !f.needs_role).collect();\n        let failed_at = overview\n            .failed_at\n            .into_iter()\n            .chain(product_failures.iter().map(|f| f.at))\n            .max();\n        // Attempted: something settled for this tenant, established or not.\n        let attempted =\n            read.is_some() || outcomes_read || overview.failure.is_some() || !attempts.is_empty();\n        // A failed read is failed, however little it established: never\n        // \"pending\" (it was attempted) and never \"done\".\n        let state = if overview.refreshing {\n            ReadState::Reading\n        } else if overview.failure.is_some() || !product_failures.is_empty() {\n            ReadState::Failed\n        } else if !attempted {\n            ReadState::Pending\n        } else {\n            ReadState::Done\n        };\n        let failed_without_data = |product: ProductId, sources_missing: &mut Vec<String>| {\n3869-            // A first-run draft is over once the desktop has a tenant (C29).\n3870-            let retired = state.end_first_run_setup();\n3871-            state.save_with(&before)?;\n3872-            for old in retired {\n3873-                let _ = session.delete(&old);\n3874-            }\n3875-            effects.push(Effect::Cleanup);\n3876-            if select {\n3877-                effects.push(Effect::Start(state.reissue_context()));\n3878-            }\n3879-            state.changed();\n3880-        }\n3881:        Intent::SelectTenant { tenant, resolution } => {\n3882-            state.require_storage()?;\n3883-            // A tenant an unsettled import wrote is not there yet (D050); a\n3884-            // setup draft is not a tenant until it completes (C29).\n3885-            if !state.committed_tenant(&tenant) || state.v1_hides_tenant(&tenant) {\n3886-                return Err(Refusal::InvalidInput);\n3887-            }\n3888-            if resolution.is_some() && state.data.active.as_ref() == Some(&tenant) {\n3889-                return Err(Refusal::StaleContext);\n3890-            }\n3891-            // The one switch path (I1): a pending Harness decision refuses\n3892-            // it until the operator resolves the conversation.\n3893-            let resolution = match state.guard_switch(&tenant, resolution, None) {\n--\n4389-            conversation,\n4390-            approval,\n4391-            allow,\n4392-        } => {\n4393-            // Allowing a decision that may change things opens the native\n4394-            // confirmation; only its private completion lets it run (C32).\n4395-            if let Some(harness_tools::NativeDecisionConfirmation {\n4396-                nonce,\n4397-                request,\n4398-                presentation,\n4399-            }) = state.decide_harness_approval(&conversation, &approval, allow)?\n4400-            {\n4401:                effects.push(Effect::ConfirmHarness {\n4402-                    conversation,\n4403-                    approval,\n4404-                    nonce,\n4405-                    request,\n4406-                    presentation,\n4407-                });\n4408-            }\n4409-            state.changed();\n4410-        }\n4411-        Intent::ReviewHarnessProposal {\n4412-            conversation,\n4413-            proposal,\n--\n5145-    let bytes = Zeroizing::new(serde_json::to_vec(intent).unwrap_or_default());\n5146-    let mut hasher = Sha256::new();\n5147-    hasher.update(salt);\n5148-    hasher.update(bytes.as_slice());\n5149-    hasher.finalize().into()\n5150-}\n5151-\n5152-fn run_effects(inner: &Arc<Inner>, effects: Vec<Effect>) {\n5153-    for effect in effects {\n5154-        #[cfg(any(test, feature = \"test-fixtures\"))]\n5155-        if matches!(\n5156-            &effect,\n5157:            Effect::Confirm { .. } | Effect::RevealSecret { .. } | Effect::ConfirmHarness { .. }\n5158-        ) {\n5159-            let gate = inner\n5160-                .presentation_gate\n5161-                .lock()\n5162-                .ok()\n5163-                .and_then(|mut gate| gate.take());\n5164-            if let Some(gate) = gate {\n5165-                gate.pause();\n5166-            }\n5167-        }\n5168-        match effect {\n5169-            Effect::Harness(start) => {\n--\n5354-                presentation,\n5355-            } => {\n5356-                let inner = Arc::clone(inner);\n5357-                tokio::spawn(async move {\n5358-                    let accepted = inner\n5359-                        .adapters\n5360-                        .confirmer\n5361-                        .confirm_scoped(nonce, request, presentation)\n5362-                        .await;\n5363-                    settle_confirmation(&inner, &review, nonce, accepted);\n5364-                });\n5365-            }\n5366:            Effect::ConfirmHarness {\n5367-                conversation,\n5368-                approval,\n5369-                nonce,\n5370-                request,\n5371-                presentation,\n5372-            } => {\n5373-                let inner = Arc::clone(inner);\n5374-                tokio::spawn(async move {\n5375-                    let accepted = inner\n5376-                        .adapters\n5377-                        .confirmer\n5378-                        .confirm_scoped(nonce, request, presentation)\n//! Runtime API key rotation (C31, screens/reviews-administration.md, I6, I7):\n//! the admitted sequence additional key (`ApiKeys · Version`) → local\n//! deployment acknowledgement → old key `Delete` with readback. The core owns\n//! the state per tenant (persisted), drives it from the applied change\n//! results it already settles, and raises the reminder as a distinct Inbox\n//! item until the old key is read back absent. Two timestamps are stored\n//! once and labelled distinctly: when the operator acknowledged the\n//! deployment (a local statement) and when the old key was read back gone.\n//! A failed issuance records nothing; an unknown one is a rotation whose key\n//! is not confirmed until the key inventory shows it; a rejected or unknown\n//! removal keeps the reminder and the completion time unset.\n\nuse serde::Serialize;\nuse serde_json::Value;\nuse ts_rs::TS;\n\nuse super::change_domain::Readback;\nuse super::{Data, Refusal, State, StorageHealth};\nuse crate::changes::{ChangeAction, ChangeKind};\nuse crate::context::ContextRef;\nuse crate::features::{KeyRef, Rotation, RotationIssuance, RotationRemoval};\nuse crate::observation::{Fact, InboxDestination, InboxItem, Tone};\nuse crate::runtime::Outcome;\nuse crate::store::StoreError;\nuse crate::tenants::TenantId;\n\n/// Where a rotation stands, as the panel shows it (derived, never stored).\n#[derive(Clone, Copy, Debug, PartialEq, Eq, Serialize, TS)]\n#[serde(rename_all = \"camelCase\")]\npub enum RotationStage {\n    /// The additional key's issuance settled unknown: nothing confirms a key\n    /// exists until the key inventory is read back.\n    IssuanceUnconfirmed,\n    /// Issued; the one-time secret is still held for this context.\n    Issued,\n    /// Issued earlier; the secret is no longer available.\n    Resumed,\n    /// The operator stated the application was updated.\n    Acknowledged,\n    /// The old key's removal settled unknown: reconciled by readback.\n    RemovalUnconfirmed,\n    /// The old key was read back absent.\n    Complete,\n}\n\n/// One rotation as the presentation shows it.\n#[derive(Clone, Debug, PartialEq, Eq, Serialize, TS)]\n#[serde(rename_all = \"camelCase\")]\npub struct RotationView {\n    pub application: String,\n    pub old_key: KeyRef,\n    pub new_key: Option<KeyRef>,\n    pub stage: RotationStage,\n    /// The change result that issued the key, while this context holds its\n    /// one-time secret (reveal through the host).\n    pub issued_by: Option<String>,\n    pub issued_at: u32,\n    pub deployment_acknowledged_at: Option<u32>,\n    pub old_key_removed_at: Option<u32>,\n    /// Why the last removal was rejected, if it was.\n    pub removal_rejected: Option<String>,\n    /// What the service established is not yet saved on this Mac (storage\n    /// failed); it is retried on every publication (C31).\n    pub unsaved: bool,\n}\n\n/// What a settled change tells the rotation state (built by the change\n/// domain from its record and output).\npub(super) struct SettledChange {\n    pub(super) operation: String,\n    pub(super) kind: ChangeKind,\n    pub(super) action: ChangeAction,\n    pub(super) target: String,\n    /// The draft's item name (the new key a version names).\n    pub(super) new_name: Option<String>,\n    /// The reviewed item's name (the old key of a version) and the\n    /// application the change named.\n    pub(super) source_name: Option<String>,\n    pub(super) application: Option<String>,\n    pub(super) outcome: Outcome,\n    pub(super) failure: Option<String>,\n    pub(super) readback: Option<Readback>,\n    pub(super) current: Option<String>,\n}\n\n/// The Inbox reminder's id for an application's rotation.\npub fn rotation_item_id(application: &str) -> String {\n    format!(\"rotation-{application}\")\n}\n\nfn key_ref(item: &Value) -> Option<KeyRef> {\n    let id = item.get(\"api_key_id\").and_then(Value::as_str)?.to_owned();\n    let name = item\n        .get(\"api_key_name\")\n        .and_then(Value::as_str)\n        .unwrap_or(\"\")\n        .to_owned();\n    Some(KeyRef { id, name })\n}\n\nfn application_of(item: &Value) -> Option<String> {\n    item.get(\"cust_app\")\n        .and_then(Value::as_str)\n        .filter(|s| !s.is_empty())\n        .map(str::to_owned)\n}\n\nimpl State {\n    fn rotations_mut(&mut self, tenant: &TenantId) -> Option<&mut Vec<Rotation>> {\n        self.data\n            .tenants\n            .iter_mut()\n            .find(|t| &t.profile.id == tenant)\n            .map(|t| &mut t.rotations)\n    }\n\n    /// Applies a settled Runtime change to the active tenant's rotations\n    /// (C31): a key version that read back starts one (replacing an earlier\n    /// rotation of the same application), a version that settled unknown\n    /// starts an unconfirmed one, a failed version records nothing; a delete\n    /// of a rotation's old key completes it when read back absent, keeps it\n    /// with the reason when rejected, and marks it unconfirmed when unknown.\n    pub(super) fn rotation_settled(&mut self, tenant: &TenantId, change: SettledChange) {\n        if change.kind != ChangeKind::ApiKeys {\n            return;\n        }\n        let clock = self.clock();\n        let before = self.data.clone();\n        let Some(rotations) = self.rotations_mut(tenant) else {\n            return;\n        };\n        let changed = match change.action {\n            ChangeAction::Version => {\n                let current = change\n                    .current\n                    .as_deref()\n                    .and_then(|c| serde_json::from_str::<Value>(c).ok());\n                let found = change.outcome == Outcome::Completed\n                    && change.failure.is_none()\n                    && change.readback == Some(Readback::Found);\n                let new_key = current.as_ref().and_then(key_ref).filter(|_| found);\n                let application = current\n                    .as_ref()\n                    .and_then(application_of)\n                    .or_else(|| change.application.clone());\n                let sent = matches!(change.outcome, Outcome::Completed | Outcome::Unknown);\n                match (sent, application) {\n                    // Sent: the rotation starts (or restarts). Confirmed only\n                    // when the readback found the key the review named; a\n                    // completed write whose readback did not establish it,\n                    // or an unknown one, is an unconfirmed issuance that only\n                    // a key of that exact name can confirm later.\n                    (true, Some(application)) => {\n                        rotations.retain(|r| r.application != application);\n                        let confirmed = new_key.is_some();\n                        rotations.push(Rotation {\n                            application,\n                            old_key: KeyRef {\n                                id: change.target.clone(),\n                                name: change.source_name.clone().unwrap_or_default(),\n                            },\n                            new_key,\n                            issuance: if confirmed {\n                                RotationIssuance::Confirmed\n                            } else {\n                                RotationIssuance::Unconfirmed\n                            },\n                            issued_by: Some(change.operation.clone()),\n                            pending_name: change.new_name.clone(),\n                            issued_at: clock,\n                            deployment_acknowledged_at: None,\n                            removal: RotationRemoval::Pending,\n                            old_key_removed_at: None,\n                        });\n                        true\n                    }\n                    // Refused or not sent: nothing issued, nothing kept.\n                    _ => false,\n                }\n            }\n            ChangeAction::Delete => {\n                let Some(rotation) = rotations.iter_mut().find(|r| r.old_key.id == change.target)\n                else {\n                    return;\n                };\n                match (change.outcome, change.failure.as_deref(), change.readback) {\n                    (Outcome::Completed, None, Some(Readback::Absent)) => {\n                        rotation.removal = RotationRemoval::Done;\n                        rotation.old_key_removed_at = Some(clock);\n                    }\n                    (Outcome::Completed, None, _) | (Outcome::Unknown, _, _) => {\n                        // Sent, but the key was not read back gone: reconciled\n                        // by a later whole-inventory read; the reminder stays.\n                        rotation.removal = RotationRemoval::Unconfirmed;\n                    }\n                    (_, failure, _) => {\n                        rotation.removal = RotationRemoval::Rejected {\n                            reason: failure.unwrap_or(\"not sent\").to_owned(),\n                        };\n                    }\n                }\n                true\n            }\n            _ => false,\n        };\n        if changed {\n            self.keep_rotation_fact(&before);\n        }\n    }\n\n    /// A complete key inventory page settles what rotations could not\n    /// confirm: an unconfirmed issuance is confirmed by a key of the\n    /// application other than the old one; an unconfirmed removal is done\n    /// once the old key is absent from the whole inventory.\n    pub(super) fn rotation_reconcile(&mut self, tenant: &TenantId, items: &[Value], whole: bool) {\n        let clock = self.clock();\n        let before = self.data.clone();\n        let Some(rotations) = self.rotations_mut(tenant) else {\n            return;\n        };\n        let mut changed = false;\n        for rotation in rotations.iter_mut() {\n            // Only the key this attempt named confirms its issuance: a key the\n            // application already had says nothing about it.\n            if rotation.issuance == RotationIssuance::Unconfirmed\n                && let Some(name) = rotation.pending_name.clone()\n            {\n                let found = items.iter().find(|k| {\n                    application_of(k).as_deref() == Some(rotation.application.as_str())\n                        && k.get(\"api_key_name\").and_then(Value::as_str) == Some(name.as_str())\n                        && key_ref(k).is_some_and(|key| key.id != rotation.old_key.id)\n                });\n                if let Some(key) = found.and_then(key_ref) {\n                    rotation.new_key = Some(key);\n                    rotation.issuance = RotationIssuance::Confirmed;\n                    changed = true;\n                }\n            }\n            // Absence is established only by the whole inventory in one read.\n            if rotation.removal == RotationRemoval::Unconfirmed && whole {\n                let present = items\n                    .iter()\n                    .any(|k| key_ref(k).is_some_and(|key| key.id == rotation.old_key.id));\n                if !present {\n                    rotation.removal = RotationRemoval::Done;\n                    rotation.old_key_removed_at = Some(clock);\n                    changed = true;\n                }\n            }\n        }\n        if changed {\n            self.keep_rotation_fact(&before);\n        }\n    }\n\n    /// A detail read walked the whole key inventory without this key: a\n    /// removal that was sent but not read back gone is now established.\n    pub(super) fn rotation_key_absent(&mut self, tenant: &TenantId, id: &str) {\n        let clock = self.clock();\n        let before = self.data.clone();\n        let Some(rotations) = self.rotations_mut(tenant) else {\n            return;\n        };\n        let mut changed = false;\n        for rotation in rotations\n            .iter_mut()\n            .filter(|r| r.old_key.id == id && r.removal == RotationRemoval::Unconfirmed)\n        {\n            rotation.removal = RotationRemoval::Done;\n            rotation.old_key_removed_at = Some(clock);\n            changed = true;\n        }\n        if changed {\n            self.keep_rotation_fact(&before);\n        }\n    }\n\n    /// The operator's statement that the application now uses the new key\n    /// (a local fact, timestamped once).\n    pub(super) fn acknowledge_deployment(\n        &mut self,\n        context: &ContextRef,\n        application: &str,\n    ) -> Result<Option<(String, String)>, Refusal> {\n        let tenant = self.check_context(context)?;\n        let clock = self.clock();\n        let rotations = self.rotations_mut(&tenant).ok_or(Refusal::StaleContext)?;\n        let rotation = rotations\n            .iter_mut()\n            .find(|r| r.application == application)\n            .ok_or(Refusal::InvalidInput)?;\n        if rotation.new_key.is_none() || rotation.removal == RotationRemoval::Done {\n            return Err(Refusal::InvalidInput);\n        }\n        if rotation.deployment_acknowledged_at.is_none() {\n            rotation.deployment_acknowledged_at = Some(clock);\n        }\n        // The operator says the application has the key: once this is\n        // recorded, its one-time copy is no longer needed here (I6).\n        Ok(rotation\n            .issued_by\n            .clone()\n            .map(|operation| (operation, rotation.old_key.id.clone())))\n    }\n\n    /// Saves a rotation fact the service established. Unlike an intent's\n    /// save, a failure keeps the fact in memory (it happened remotely and\n    /// must not be forgotten), reports it, and every later publication\n    /// retries the save; nothing remote is replayed.\n    pub(super) fn keep_rotation_fact(&mut self, _before: &Data) {\n        let saved = match self.storage {\n            StorageHealth::Ready => self.store.save(&self.persisted()),\n            _ => Err(StoreError::Unavailable),\n        };\n        match saved {\n            Ok(()) => {\n                self.durability_unconfirmed = false;\n                self.rotation_unsaved = false;\n            }\n            Err(StoreError::Unconfirmed) => {\n                self.durability_unconfirmed = true;\n                self.rotation_unsaved = false;\n            }\n            Err(_) => self.rotation_unsaved = true,\n        }\n    }\n\n    /// Retries an unsaved rotation fact (each publication; C31).\n    pub(super) fn retry_rotation_save(&mut self) {\n        if self.rotation_unsaved {\n            let data = self.data.clone();\n            self.keep_rotation_fact(&data);\n        }\n    }\n\n    /// The active tenant's rotations as the presentation shows them.\n    pub(super) fn rotations_view(&self) -> Vec<RotationView> {\n        let Some(tenant) = self.data.active.as_ref().and_then(|id| self.tenant(id)) else {\n            return Vec::new();\n        };\n        tenant\n            .rotations\n            .iter()\n            .map(|r| {\n                let secret = r\n                    .issued_by\n                    .as_deref()\n                    .is_some_and(|op| self.issuance_held(op, &r.old_key.id));\n                let stage = match (\n                    &r.removal,\n                    r.deployment_acknowledged_at,\n                    r.new_key.is_some(),\n                ) {\n                    (RotationRemoval::Done, _, _) => RotationStage::Complete,\n                    (RotationRemoval::Unconfirmed, _, _) => RotationStage::RemovalUnconfirmed,\n                    (_, _, false) => RotationStage::IssuanceUnconfirmed,\n                    (_, Some(_), true) => RotationStage::Acknowledged,\n                    (_, None, true) if secret => RotationStage::Issued,\n                    (_, None, true) => RotationStage::Resumed,\n                };\n                RotationView {\n                    application: r.application.clone(),\n                    old_key: r.old_key.clone(),\n                    new_key: r.new_key.clone(),\n                    stage,\n                    // Offered only while the core holds the key and the stage\n                    // is one that may reveal it (issued, or issued but not yet\n                    // confirmed by readback).\n                    issued_by: r.issued_by.clone().filter(|_| {\n                        secret\n                            && matches!(\n                                stage,\n                                RotationStage::Issued | RotationStage::IssuanceUnconfirmed\n                            )\n                    }),\n                    issued_at: r.issued_at,\n                    deployment_acknowledged_at: r.deployment_acknowledged_at,\n                    old_key_removed_at: r.old_key_removed_at,\n                    unsaved: self.rotation_unsaved,\n                    removal_rejected: match &r.removal {\n                        RotationRemoval::Rejected { reason } => Some(reason.clone()),\n                        _ => None,\n                    },\n                }\n            })\n            .collect()\n    }\n\n    /// The reminder items of rotations in progress (I7): one per application\n    /// with a confirmed new key and the old key not yet read back gone.\n    pub(super) fn rotation_items(&self) -> Vec<InboxItem> {\n        let Some(tenant) = self.data.active.as_ref().and_then(|id| self.tenant(id)) else {\n            return Vec::new();\n        };\n        tenant\n            .rotations\n            .iter()\n            .filter(|r| r.new_key.is_some() && r.removal != RotationRemoval::Done)\n            .map(|r| InboxItem {\n                id: rotation_item_id(&r.application),\n                title: format!(\n                    \"Update {} with the new key, then remove the old key\",\n                    r.application\n                ),\n                detail: format!(\n                    \"An additional key was issued for {}. Once the application uses it, finish the rotation by removing the old key {}.\",\n                    r.application, r.old_key.name\n                ),\n                source: \"API keys · rotation\".to_owned(),\n                action: true,\n                tone: Tone::Warn,\n                destination: InboxDestination::ApiKeys,\n                action_label: \"Finish rotation…\".to_owned(),\n                facts: vec![\n                    Fact {\n                        label: \"Application\".to_owned(),\n                        value: r.application.clone(),\n                    },\n                    Fact {\n                        label: \"New key\".to_owned(),\n                        value: r.new_key.as_ref().map(|k| k.name.clone()).unwrap_or_default(),\n                    },\n                    Fact {\n                        label: \"Old key\".to_owned(),\n                        value: r.old_key.name.clone(),\n                    },\n                ],\n                per_mille: None,\n            })\n            .collect()\n    }\n}\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_28","type":"command_execution","command":"/bin/zsh -lc \"cat docs/planning/evidence/P09/runs/hash-inputs.sh docs/planning/evidence/P09/runs/run-checks.sh; python3 -c 'import json,hashlib; from pathlib import Path; b=Path(\\\"docs/planning/reviews/P09/attempt-01\\\");\nfor n in [\\\"source-inventory.json\\\",\\\"evidence-inventory.json\\\"]:\n d=json.loads((b/n).read_text()); print(n,hashlib.sha256((json.dumps(d[\\\"files\\\"],sort_keys=True,separators=(\\\",\\\",\\\":\\\"))+\\\"\\\\n\\\").encode()).hexdigest())\nr=json.load(open(\\\"docs/planning/reviews/P09/attempt-01/request.json\\\")); print(\\\"predecessor verdicts:\\\")\nfor m in r[\\\"predecessors\\\"]:\n if \\\"record\\\" in m:\n  v=json.load(open(m[\\\"record\\\"])); print(m[\\\"subject\\\"],v.get(\\\"scores\\\"),\\\"fixes\\\",v.get(\\\"required_fixes\\\"),\\\"gaps\\\",v.get(\\\"evidence_gaps\\\"),\\\"blockers\\\",v.get(\\\"blockers\\\"))'\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_28","type":"command_execution","command":"/bin/zsh -lc \"cat docs/planning/evidence/P09/runs/hash-inputs.sh docs/planning/evidence/P09/runs/run-checks.sh; python3 -c 'import json,hashlib; from pathlib import Path; b=Path(\\\"docs/planning/reviews/P09/attempt-01\\\");\nfor n in [\\\"source-inventory.json\\\",\\\"evidence-inventory.json\\\"]:\n d=json.loads((b/n).read_text()); print(n,hashlib.sha256((json.dumps(d[\\\"files\\\"],sort_keys=True,separators=(\\\",\\\",\\\":\\\"))+\\\"\\\\n\\\").encode()).hexdigest())\nr=json.load(open(\\\"docs/planning/reviews/P09/attempt-01/request.json\\\")); print(\\\"predecessor verdicts:\\\")\nfor m in r[\\\"predecessors\\\"]:\n if \\\"record\\\" in m:\n  v=json.load(open(m[\\\"record\\\"])); print(m[\\\"subject\\\"],v.get(\\\"scores\\\"),\\\"fixes\\\",v.get(\\\"required_fixes\\\"),\\\"gaps\\\",v.get(\\\"evidence_gaps\\\"),\\\"blockers\\\",v.get(\\\"blockers\\\"))'\"","aggregated_output":"#!/bin/bash\n# Deterministic inventory of the inputs P09's checks compile, test or build:\n# the Rust crates and host, the desktop app sources and configuration, the\n# contracts package sources and fixtures, the Academy shared source actually\n# consumed (.work/academy/src and its installed packages, staged from\n# .inputs/academy), the native acceptance tools, the lockfiles, the workspace\n# and toolchain manifests, the harness pin and every docs/architecture/*.json.\n# Generated Python bytecode caches are excluded; the captured pending-tree fixture\n# consumed by the L19 driver regression is explicitly included.\n# Every listed path must exist: a missing one fails the inventory (exit 2)\n# instead of producing a partial digest.\n# Usage: hash-inputs.sh <repo-root> <inventory-out>; prints the digest.\nset -euo pipefail\ncd \"$1\"\nDIRS=(crates apps/desktop/src apps/desktop/src-tauri packages/desktop-contracts/src packages/desktop-contracts/fixtures tools/native-acceptance tools/parity tools/academy .work/academy/src .work/academy/packages .inputs/academy)\nFILES=(docs/planning/evidence/C29/live/L19/attempt-01/wizard-verify.json Cargo.toml Cargo.lock rust-toolchain.toml pnpm-lock.yaml package.json pnpm-workspace.yaml resources/harness/pin.json apps/desktop/package.json apps/desktop/index.html packages/desktop-contracts/package.json packages/desktop-contracts/tsconfig.json)\nfor p in \"${DIRS[@]}\"; do [ -d \"$p\" ] || { echo \"inventory: missing directory $p\" >&2; exit 2; }; done\nfor p in \"${FILES[@]}\"; do [ -f \"$p\" ] || { echo \"inventory: missing file $p\" >&2; exit 2; }; done\n{\n  find \"${DIRS[@]}\" -type f -not -path '*/__pycache__/*' -not -path '*/target/*' -not -path '*/node_modules/*' -not -path '*/gen/schemas/*' -not -path '*/.git/*' -print0 | sort -z | xargs -0 shasum -a 256\n  shasum -a 256 \"${FILES[@]}\" apps/desktop/*.ts apps/desktop/*.json docs/architecture/*.json\n} | LC_ALL=C sort -k2 > \"$2\"\n[ -s \"$2\" ] || { echo \"inventory: empty\" >&2; exit 2; }\nshasum -a 256 \"$2\" | cut -d' ' -f1\n#!/bin/bash\n# P09 check runs with a source-bound record. Usage: run-checks.sh <attempt>\n# Runs on the approved toolchain (rustup 1.99.0, node 24.21.0, repo pnpm).\nset -o pipefail\nATTEMPT=${1:-attempt-01}\ncd \"$(dirname \"$0\")/../../../../..\"\nexport PATH=\"$PWD/.tools/bin:$HOME/.cargo/bin:$HOME/.nvm/versions/node/v24.21.0/bin:/usr/bin:/bin:/usr/sbin:/sbin\"\nunset RUSTFLAGS CARGO_BUILD_RUSTFLAGS CARGO_TARGET_DIR\n# Timing-sensitive suites (4 s \"eventually\" waits, engine bootstraps) flake when ten test threads\n# per binary share this Mac with the owner's browser and a second session; four threads per\n# binary keep the same tests and assertions, only less contention. Recorded in the run record.\nexport RUST_TEST_THREADS=4\nR=docs/planning/evidence/P09/runs\nE=$R/$ATTEMPT\nif [ -e \"$E\" ] || [ -e \"$R/run-$ATTEMPT.json\" ]; then\n  echo \"Refusing to overwrite retained P09 check evidence: $ATTEMPT; choose a fresh attempt.\" >&2\n  exit 2\nfi\nmkdir -p \"$E\"\n# Flake logs are same-input retries of this run only: earlier runs' logs are removed first.\nrm -f $E/core-fixtures.flake-*.log $E/host.flake-*.log\nBEFORE=$($R/hash-inputs.sh \"$PWD\" $E/inputs-before.sha256) || { echo \"input inventory failed; run invalid\"; exit 2; }\n[ -n \"$BEFORE\" ] || { echo \"input inventory produced no digest; run invalid\"; exit 2; }\n# Configuration and build flags the controller fingerprints: itemised and hashed together.\nBUILD_FLAGS=$(shasum -a 256 docs/architecture/checks.json docs/architecture/native-checks.json docs/architecture/toolchain.json docs/architecture/budgets.json apps/desktop/src-tauri/tauri.conf.json apps/desktop/src-tauri/tauri.fixture.conf.json apps/desktop/src-tauri/capabilities/*.json rust-toolchain.toml 2>/dev/null | shasum -a 256 | cut -d' ' -f1)\nexport BUILD_FLAGS\nrun() { local name=$1; shift; local log=$E/$name.log; echo \"\\$ $*\" > \"$log\"; \"$@\" >> \"$log\" 2>&1; local rc=$?; echo \"EXIT $rc\" >> \"$log\"; echo \"$name exit=$rc\"; echo $rc > $E/$name.exit; }\nrun rustfmt cargo fmt --all -- --check\nrun clippy cargo clippy --locked -p desktop-core -p desktop-host -p xtask --features test-fixtures --all-targets -- -D warnings\nrun clippy-default cargo clippy --locked --workspace --all-targets -- -D warnings\nrun notices cargo run --locked -q -p xtask -- notices --check\nrun bindings cargo run --locked -q -p xtask -- bindings --check\nrun contracts-typecheck pnpm --filter @prisma-airs/desktop-contracts exec tsc --noEmit\nrun desktop-typecheck pnpm --filter @prisma-airs/desktop exec tsc --noEmit\nrun vitest pnpm --filter @prisma-airs/desktop exec vitest run --config vitest.config.ts\nrun vitest-truth pnpm --filter @prisma-airs/desktop exec vitest run --config vitest.truth.config.ts\nrun core-lib cargo test --locked -p desktop-core --lib\nrun core-fixtures cargo test --locked -p desktop-core --features test-fixtures\n# A timing-sensitive test (Harness-engine turns, or the transport's connection-release\n# check) can flake under the full-suite load: the exact same\n# command is retried on the same frozen inputs, every failed run kept as evidence.\nfor try in 1 2; do\n  if [ \"$(cat $E/core-fixtures.exit)\" != \"0\" ]; then\n    cp $E/core-fixtures.log $E/core-fixtures.flake-$try.log\n    run core-fixtures cargo test --locked -p desktop-core --features test-fixtures\n  fi\ndone\n# The chunk's registered fixture command (docs/architecture/checks.json P09), exactly as the manifest runs it.\nrun fixture-command cargo test --locked -p desktop-core --features test-fixtures --test ui_v2_closure --test ui_v2_shell_port --test ui_v2_home --test ui_v2_inbox_port --test ui_v2_harness_port --test ui_v2_admin --test ui_v2_api --test ui_v2_academy --test ui_v2_wizard\nrun host cargo test --locked -p desktop-host --features test-fixtures\n# The host's Academy device-flow tests (browser_callback.rs, outside this chunk) wait 5 s for a\n# state and flake under load: the same command is retried on the same frozen inputs, every\n# failed run kept as evidence.\nfor try in 1 2; do\n  if [ \"$(cat $E/host.exit)\" != \"0\" ]; then\n    cp $E/host.log $E/host.flake-$try.log\n    run host cargo test --locked -p desktop-host --features test-fixtures\n  fi\ndone\nrun xtask-lib cargo test --locked -p xtask --lib\nrun shell-controller cargo test --locked -p xtask --features test-fixtures --test shell_controller\nrun desktop-build pnpm --filter @prisma-airs/desktop build\nrun l19-offline cargo test --locked -p xtask --features test-fixtures --test controlled_live --test live_run\n# Offline unittest only: retained/synthetic AX settlement and tempfile budget\n# ledgers. Imports pure helpers; never calls the live driver's guarded main(),\n# resolves credentials, launches the qualification app, or sends a product call.\nrun l19-native-driver python3 -I tools/native-acceptance/test_live_c29_l19.py\nAFTER=$($R/hash-inputs.sh \"$PWD\" $E/inputs-after.sha256) || { echo \"input inventory failed after the runs; run invalid\"; exit 2; }\n[ -n \"$AFTER\" ] || { echo \"input inventory produced no digest after the runs; run invalid\"; exit 2; }\npython3 -I - \"$E\" \"$BEFORE\" \"$AFTER\" \"$ATTEMPT\" <<'PY'\nimport json,sys,subprocess,os,time,hashlib\nE,b,a,attempt=sys.argv[1:5]\ndef ver(c):\n    try: return subprocess.check_output(c,text=True,stderr=subprocess.STDOUT).strip()\n    except Exception as e: return str(e)\nsha=lambda p: hashlib.sha256(open(p,\"rb\").read()).hexdigest()\nnames=[\"rustfmt\",\"clippy\",\"clippy-default\",\"notices\",\"bindings\",\"contracts-typecheck\",\"desktop-typecheck\",\"vitest\",\"vitest-truth\",\"core-lib\",\"core-fixtures\",\"fixture-command\",\"host\",\"xtask-lib\",\"shell-controller\",\"desktop-build\",\"l19-offline\",\"l19-native-driver\"]\nrec={\"subject\":\"P09\",\"attempt\":attempt,\"time\":time.strftime(\"%Y-%m-%dT%H:%M:%S%z\"),\"cwd\":os.getcwd(),\n \"toolchain\":{\"rustc\":ver([\"rustc\",\"-V\"]),\"cargo\":ver([\"cargo\",\"-V\"]),\"node\":ver([\"node\",\"-v\"]),\"pnpm\":ver([\"pnpm\",\"-v\"]),\"rustup_active\":ver([\"rustup\",\"show\",\"active-toolchain\"])},\n \"environment\":{\"PATH\":os.environ[\"PATH\"],\"RUSTFLAGS\":os.environ.get(\"RUSTFLAGS\"),\"CARGO_TARGET_DIR\":os.environ.get(\"CARGO_TARGET_DIR\"),\"RUST_TEST_THREADS\":os.environ.get(\"RUST_TEST_THREADS\")},\n \"build_flags\":{\"digest\":os.environ.get(\"BUILD_FLAGS\"),\"covers\":\"checks.json, native-checks.json, toolchain.json, budgets.json, tauri.conf.json, tauri.fixture.conf.json, src-tauri/capabilities/*.json, rust-toolchain.toml\"},\"inputs\":{\"procedure\":f\"{E}/../hash-inputs.sh\",\"procedure_sha256\":sha(f\"{E}/../hash-inputs.sh\"),\"before_inventory_sha256\":sha(f\"{E}/inputs-before.sha256\"),\"before_digest\":b,\"after_inventory_sha256\":sha(f\"{E}/inputs-after.sha256\"),\"after_digest\":a,\"unchanged\":a==b,\"members\":sum(1 for _ in open(f\"{E}/inputs-before.sha256\"))},\n \"runs\":{}}\nfor n in names:\n    log=f\"{E}/{n}.log\"\n    rec[\"runs\"][n]={\"exit\":int(open(f\"{E}/{n}.exit\").read().strip()),\"log\":log,\"log_sha256\":sha(log),\"summary\":[l.strip() for l in open(log,errors=\"replace\") if l.startswith(\"test result\") or \"Test Files\" in l or \"Tests  \" in l or l.startswith(\"EXIT\")][-4:]}\njson.dump(rec,open(f\"{E}/../run-{attempt}.json\",\"w\"),indent=2)\nprint(json.dumps({k:v[\"exit\"] for k,v in rec[\"runs\"].items()}),\"inputs unchanged:\",a==b,\"members:\",rec[\"inputs\"][\"members\"])\nPY\nsource-inventory.json 2ced3ba55ff87ea3652028dc3c25937375322eaafef4b6956e1e3133afeca265\nevidence-inventory.json faa63b41870df92ead981cce70edf1b1a89973a1c5caaa7fe0b024e2bbde4377\npredecessor verdicts:\nC27 {'architecture': 9, 'behavior': 9, 'authority_security': 9, 'validation': 9, 'overall': 9} fixes [] gaps [] blockers []\nC28 {'architecture': 9, 'behavior': 9, 'authority_security': 9, 'validation': 9, 'overall': 9} fixes [] gaps [] blockers []\nC29 {'architecture': 9, 'behavior': 9, 'authority_security': 9, 'validation': 9, 'overall': 9} fixes [] gaps [] blockers []\nC30 {'architecture': 9, 'behavior': 9, 'authority_security': 9, 'validation': 8, 'overall': 8} fixes [\"R1 — tools/native-acceptance/legacy_assertions.py:330 and tools/native-acceptance/acceptance_c37.py:366: the replacement for C30-N03 drops its mandatory capture matrix. docs/architecture/native-checks.json requires every hold-workflow step captured in light and dark at 100% and 200%; the current driver exercises holds once, then captures ordinary populated layouts separately. Current C36/C37 records establish useful behavior but contain no complete themed/zoomed snooze, acknowledge and unsnooze capture sequence. This check was not retired by the owner's C44 retirement decision. Acceptance: complete the replacement coverage and mapping, retain source-bound observations and captures for every required hold step in all four combinations, and make missing coverage fail qualification. Preserve historical records.\", 'R2 — tools/native-acceptance/legacy_assertions.py:331, tools/native-acceptance/acceptance_c37.py:143 and tools/native-acceptance/acceptance_c38.py:425: C30-N04 is mapped to a narrower replacement. The current checks do not establish Escape returning guard focus to the switcher, viewport containment of every focused Inbox detail action at 900×600/200% in both themes, or the specified native snooze-toast persistence after relaunch with Reduce Motion enabled. The mapper can therefore report coverage while these required assertions are absent. Acceptance: restore these assertions in the replacement drivers, retain the focused AX observations and snooze-toast persistence/dismissal evidence with system-setting restoration, and require their results in the C30 mapping.'] gaps [\"E1 — Current C36/C37 evidence lacks C30-N03's complete hold-step capture matrix. The historical C30 record belongs to executable ab1f940ef078fae3476fd15290489fab1138fbc9eb613fe4db4890297432f85e, whereas current preparation names 2791b5a1eaf6b9268e0574502c62a20f3027fd2b76ff9ed08289eef1f56147ea; historical captures do not establish current qualification.\", \"E2 — Current mapped evidence does not cover the remaining C30-N04 scenarios listed in R2. C31's retained observations demonstrate applied-change toast persistence under Reduce Motion, and C38 demonstrates guard dismissal and preserved decisions, but neither supplies the missing C30 scenario evidence. Passing component tests and mapped target IDs do not establish those unperformed native assertions.\"] blockers []\nC31 {'architecture': 9, 'behavior': 9, 'authority_security': 9, 'validation': 9, 'overall': 9} fixes [] gaps [] blockers []\nC32 {'architecture': 9, 'behavior': 9, 'authority_security': 9, 'validation': 9, 'overall': 9} fixes [] gaps [] blockers []\nC35 {'architecture': 9, 'behavior': 9, 'authority_security': 9, 'validation': 9, 'overall': 9} fixes [] gaps [] blockers []\nC36 {'architecture': 9, 'behavior': 9, 'authority_security': 9, 'validation': 9, 'overall': 9} fixes [] gaps [] blockers []\nC37 {'architecture': 9, 'behavior': 9, 'authority_security': 9, 'validation': 9, 'overall': 9} fixes [] gaps [] blockers []\nC38 {'architecture': 9, 'behavior': 9, 'authority_security': 9, 'validation': 9, 'overall': 9} fixes [] gaps [] blockers []\nC39 {'architecture': 9, 'behavior': 9, 'authority_security': 9, 'validation': 9, 'overall': 9} fixes [] gaps [] blockers []\nC40 {'architecture': 9, 'behavior': 9, 'authority_security': 9, 'validation': 9, 'overall': 9} fixes [] gaps [] blockers []\nC41 {'architecture': 9, 'behavior': 8, 'authority_security': 9, 'validation': 8, 'overall': 8} fixes [\"R1 — apps/desktop/src/v2/workbench/api-client.tsx:178–188, especially the doc.id shortcut at line 186: returning to a request can remount an obsolete DocumentView. RequestEditor owns newer fields/revisions internally, while the parent retains its original document. Reproduced against the production component in memory: edit A's URL, receive successful protection, select B and lose its load observation, then select A. The URL reverted from /edited to /topics and A had only one openRequest call. Save can then remove the protected draft because those old fields equal the saved baseline (workbench_domain.rs:1828–1839); Send can use the old request. Reload the authoritative document when returning after its editor unmounts, or retain an up-to-date document without reviving an obsolete snapshot. Acceptance: regression tests cover A edited/protected or saved, B's load pending/refused/undelivered, and return to A; latest fields and revision survive and explicit Save/Send receive them, with no automatic send.\", 'R2 — apps/desktop/src/v2/workbench/tools-sheet.tsx:242 and 251: schema-open replies unconditionally replace the editor even after a newer editor action. Reproduced against ToolsSheet in memory: hold openSchema(existing.json), create draft.json, type {\"newWork\":true}, then release the old result. The draft editor disappeared and was replaced by existing.json\\'s text; the unsaved work was lost. Bind loads to the current editor generation and retire them on New, Close, or another selection. The environment loader at lines 94–102 has the same unguarded replacement pattern and needs equivalent protection. Acceptance: deferred opens superseded by a new schema, closing the editor, or a newer environment/schema selection cannot reopen or replace the current editor or its typing; add component regressions alongside the save-reply tests.'] gaps [] blockers []\nC42 {'architecture': 9, 'behavior': 9, 'authority_security': 9, 'validation': 9, 'overall': 9} fixes [] gaps [] blockers []\nC43 {'architecture': 9, 'behavior': 9, 'authority_security': 9, 'validation': 9, 'overall': 9} fixes [] gaps [] blockers []\nC44 {'architecture': 9, 'behavior': 9, 'authority_security': 9, 'validation': 9, 'overall': 9} fixes [] gaps [] blockers []\nP01 {'architecture': 9, 'behavior': 9, 'authority_security': 9, 'validation': 9, 'overall': 9} fixes [] gaps [] blockers []\nP02 {'architecture': 9, 'behavior': 9, 'authority_security': 9, 'validation': 9, 'overall': 9} fixes [] gaps [] blockers []\nP03 {'architecture': 9, 'behavior': 9, 'authority_security': 9, 'validation': 9, 'overall': 9} fixes [] gaps [] blockers []\nP04 {'architecture': 9, 'behavior': 9, 'authority_security': 9, 'validation': 9, 'overall': 9} fixes [] gaps [] blockers []\nP05 {'architecture': 9, 'behavior': 9, 'authority_security': 9, 'validation': 9, 'overall': 9} fixes [] gaps [] blockers []\nP06 {'architecture': 9, 'behavior': 9, 'authority_security': 9, 'validation': 9, 'overall': 9} fixes [] gaps [] blockers []\nP07 {'architecture': 9, 'behavior': 9, 'authority_security': 9, 'validation': 9, 'overall': 9} fixes [] gaps [] blockers []\n","exit_code":0,"status":"completed"}}
