{"type":"item.completed","item":{"id":"item_53","type":"command_execution","command":"/bin/zsh -lc \"sed -n '460,700p' crates/desktop-core/src/authority/workbench_domain.rs; sed -n '215,280p' apps/desktop/src-tauri/src/lib.rs; cat docs/planning/evidence/P09/runs/attempt-10/host.log | tail -65; cat docs/planning/evidence/P09/runs/attempt-10/core-fixtures.log | tail -55\"","aggregated_output":"    pub loaded: bool,\n    pub failure: Option<PrivateFailure>,\n    pub recent: Vec<RecentView>,\n    pub collection: Option<CollectionView>,\n    /// A previewed Insomnia export.\n    pub import: Option<Vec<ResourceView>>,\n    pub adoption: Option<Vec<CandidateView>>,\n    pub adoption_settled: bool,\n    pub git: Option<GitView>,\n    /// A request is running on the lane.\n    pub busy: bool,\n    /// Edits exist that are not protected on this Mac yet.\n    pub unprotected: bool,\n    /// Requests in flight (C15).\n    pub running: Vec<RunningView>,\n    /// A tenant-credential change awaiting review.\n    pub review: Option<SendReviewView>,\n    /// Where this build sends API Client requests.\n    pub network: Network,\n}\n\n// ------------------------------------------------------------------ state\n\n#[derive(Default)]\nstruct Cell {\n    result: Mutex<Option<WorkbenchResult>>,\n    ready: Notify,\n}\n\n/// A single-use wait for one API Client request's result.\npub struct WorkbenchHandle(Arc<Cell>);\n\nimpl std::fmt::Debug for WorkbenchHandle {\n    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {\n        f.write_str(\"WorkbenchHandle\")\n    }\n}\n\nimpl WorkbenchHandle {\n    pub async fn result(self) -> WorkbenchResult {\n        loop {\n            let notified = self.0.ready.notified();\n            if let Some(result) = self.0.result.lock().ok().and_then(|r| r.clone()) {\n                return result;\n            }\n            notified.await;\n        }\n    }\n}\n\nstruct Call {\n    operation: OperationId,\n    cell: Arc<Cell>,\n    settled: bool,\n    observed: bool,\n    /// Left the lane (a transfer or confirmation in progress).\n    later: bool,\n}\n\npub(super) struct Open {\n    root: PathBuf,\n    scope: String,\n    built_in: bool,\n    catalog: Catalog,\n    data: Scope,\n    unsaved: Option<PrivateFailure>,\n    documents: BTreeMap<String, Document>,\n    recovered: BTreeSet<String>,\n    conflicts: BTreeMap<String, ConflictKind>,\n    interrupted: BTreeSet<String>,\n}\n\n#[derive(Default)]\npub(super) struct Workbench {\n    pub(super) lane: Arc<tokio::sync::Mutex<()>>,\n    calls: Vec<Call>,\n    running: usize,\n    profile: Option<Profile>,\n    failure: Option<PrivateFailure>,\n    open: Option<Open>,\n    /// Documents with unprotected edits: the newest edit generation the\n    /// editor reported for each.\n    editing: BTreeMap<String, u32>,\n    import: Option<insomnia::Export>,\n    adoption: Option<Vec<adoption::Candidate>>,\n    git: Option<GitView>,\n    /// Fixture builds: fail a Save after this many file writes.\n    pub(super) interrupt: Option<Interrupt>,\n    pub(in crate::authority) sending: send::Sending,\n}\n\nimpl Workbench {\n    /// Forgets everything held (reset).\n    pub(super) fn clear(&mut self) {\n        self.profile = None;\n        self.failure = None;\n        self.open = None;\n        self.editing.clear();\n        self.import = None;\n        self.adoption = None;\n        self.git = None;\n        self.sending.clear();\n    }\n}\n\nfn folder_name(root: &std::path::Path) -> String {\n    root.file_name()\n        .map(|n| n.to_string_lossy().into_owned())\n        .unwrap_or_default()\n}\n\nimpl Open {\n    fn entry(&self, id: &str) -> Option<&RequestEntry> {\n        self.catalog.requests.iter().find(|r| r.id == id)\n    }\n\n    fn view(&self, id: &str) -> Option<DocumentView> {\n        let doc = self.documents.get(id)?;\n        let draft = self.data.drafts.get(id);\n        Some(DocumentView {\n            id: doc.id.clone(),\n            relative: doc.relative.clone(),\n            revision: doc.revision(),\n            fields: draft.map_or_else(|| doc.saved.clone(), |d| d.fields.clone()),\n            saved: doc.saved.clone(),\n            new: doc.new,\n            recovered: self.recovered.contains(id),\n            body_editable: doc.body_editable,\n            schema: doc.schema(),\n            conflict: self.conflicts.get(id).copied(),\n            interrupted: self.interrupted.contains(id),\n            metadata_dirty: doc.metadata_dirty,\n        })\n    }\n\n    fn open_tab(&mut self, id: &str) {\n        if !self.data.open.iter().any(|t| t == id) {\n            self.data.open.push(id.to_owned());\n        }\n        self.data.selected = Some(id.to_owned());\n    }\n\n    fn environments(&self) -> Vec<EnvironmentView> {\n        let mut names: BTreeMap<String, Origin> = BTreeMap::new();\n        for name in &self.catalog.environments {\n            names.insert(name.clone(), Origin::Shared);\n        }\n        for name in self\n            .data\n            .private\n            .keys()\n            .filter(|n| *n != environments::DEFAULTS)\n        {\n            names\n                .entry(name.clone())\n                .and_modify(|o| *o = Origin::Both)\n                .or_insert(Origin::Local);\n        }\n        names\n            .into_iter()\n            .map(|(name, origin)| EnvironmentView { name, origin })\n            .collect()\n    }\n}\n\nimpl State {\n    pub(super) fn admit_workbench(&mut self) -> Result<OperationId, Refusal> {\n        if self.workbench.calls.iter().filter(|c| !c.settled).count() >= 256 {\n            return Err(Refusal::Busy);\n        }\n        let operation = self.operations.reserve();\n        self.workbench.calls.push(Call {\n            operation: operation.clone(),\n            cell: Arc::default(),\n            settled: false,\n            observed: false,\n            later: false,\n        });\n        self.workbench.running += 1;\n        Ok(operation)\n    }\n\n    pub(super) fn settle_workbench(&mut self, operation: &OperationId, result: WorkbenchResult) {\n        self.workbench.running = self.workbench.running.saturating_sub(1);\n        if let Some(call) = self\n            .workbench\n            .calls\n            .iter_mut()\n            .find(|c| &c.operation == operation)\n        {\n            call.settled = true;\n            if let Ok(mut slot) = call.cell.result.lock() {\n                *slot = Some(result);\n            }\n            call.cell.ready.notify_waiters();\n        }\n        self.prune_workbench_calls();\n    }\n\n    fn prune_workbench_calls(&mut self) {\n        self.workbench.calls.retain(|c| !(c.settled && c.observed));\n        let settled = self.workbench.calls.iter().filter(|c| c.settled).count();\n        let mut excess = settled.saturating_sub(RETAINED_RESULTS);\n        self.workbench.calls.retain(|c| {\n            if excess > 0 && c.settled {\n                excess -= 1;\n                false\n            } else {\n                true\n            }\n        });\n    }\n\n    pub(super) fn observe_workbench(\n        &mut self,\n        operation: &OperationId,\n    ) -> Result<WorkbenchHandle, Refusal> {\n        let call = self\n            .workbench\n            .calls\n            .iter_mut()\n            .find(|c| &c.operation == operation && !c.observed)\n            .ok_or(Refusal::InvalidInput)?;\n        call.observed = true;\n        let handle = WorkbenchHandle(Arc::clone(&call.cell));\n        if call.settled {\n            self.prune_workbench_calls();\n        }\n        Ok(handle)\n    }\n\n    /// Edits that are not protected on this Mac (the close guard asks).\n    pub(super) fn workbench_unprotected(&self) -> bool {\n        !self.workbench.editing.is_empty()\n            || self\n                .workbench\n                .open\n                .as_ref()\n                .is_some_and(|o| o.unsaved.is_some() && !o.data.drafts.is_empty())\n    }\n\n\n/// Installs host state for an existing core plus the commands (tests use\n/// this with fixture adapters; the app builds its core in `setup`).\npub fn install<R: Runtime>(builder: tauri::Builder<R>, core: &Core) -> tauri::Builder<R> {\n    commands(builder.manage(Host::new(core)))\n}\n\n/// A core over deterministic fixture adapters, for host tests.\n#[cfg(feature = \"test-fixtures\")]\npub fn fixture_core() -> (Core, desktop_core::fixtures::Handles) {\n    fixture_core_with(CoreConfig::default())\n}\n\n/// A fixture core with a given configuration (for example the synthetic\n/// Academy origin).\n#[cfg(feature = \"test-fixtures\")]\npub fn fixture_core_with(config: CoreConfig) -> (Core, desktop_core::fixtures::Handles) {\n    let (adapters, handles) = desktop_core::fixtures::adapters();\n    (Core::new(config, adapters), handles)\n}\n\n/// Builds the packaged main window with its navigation policy: it may only\n/// display packaged assets; remote navigation, new windows and downloads are\n/// refused, so remote content can never acquire command authority.\npub fn main_window<R: Runtime, M: Manager<R>>(manager: &M) -> tauri::Result<WebviewWindow<R>> {\n    let builder =\n        WebviewWindowBuilder::new(manager, MAIN_WINDOW, WebviewUrl::App(\"index.html\".into()))\n            .title(product_title())\n            .inner_size(1280.0, 820.0)\n            .min_inner_size(900.0, 600.0)\n            .on_navigation(is_packaged_origin)\n            .on_new_window(|_, _| NewWindowResponse::Deny)\n            .on_download(|_, _| false)\n            .on_page_load(|webview, payload| {\n                // The departing page owns no surviving observations, review\n                // confirmation or one-time disclosure, even without JS cleanup.\n                if payload.event() == PageLoadEvent::Started {\n                    webview.state::<Host>().retire_webview(webview.label());\n                }\n            });\n    builder.build()\n}\n\nfn product_title() -> &'static str {\n    if cfg!(feature = \"test-fixtures\") {\n        \"Prisma AIRS Desktop v2 (Fixture)\"\n    } else {\n        \"Prisma AIRS Desktop v2\"\n    }\n}\n\n/// True for the packaged asset origin served by Tauri's custom protocol.\npub fn is_packaged_origin(url: &Url) -> bool {\n    url.scheme() == \"tauri\" && url.host_str() == Some(\"localhost\") && url.port().is_none()\n}\n\n/// Defense in depth beyond the capability grant: the caller must be the main\n/// webview of the main window currently showing packaged content.\nfn admit_caller<R: Runtime>(webview: &Webview<R>) -> Result<(), Refusal> {\n    if webview.label() != MAIN_WINDOW || webview.window().label() != MAIN_WINDOW {\n        return Err(Refusal::CapabilityMissing);\n    }\n    match webview.url() {\n        Ok(url) if is_packaged_origin(&url) => Ok(()),\n        _ => Err(Refusal::CapabilityMissing),\n    }\ntest an_item_this_process_is_not_trusted_for_is_denied_not_locked ... ok\ntest records_round_trip_in_the_v2_namespace_without_touching_the_search_list ... ok\ntest the_classic_login_keychain_api_is_available_read_only ... ok\ntest purge_removes_only_the_v2_namespace ... ok\ntest a_locked_keychain_reports_locked_and_recovers_after_unlock ... ok\n\ntest result: ok. 6 passed; 0 failed; 0 ignored; 0 measured; 0 filtered out; finished in 0.94s\n\n     Running tests/native_confirmation.rs (target/debug/deps/native_confirmation-0c48de9d93a714cb)\n\nrunning 5 tests\ntest first_reveal_and_clipboard_timers_are_separate ... ok\ntest an_older_reveal_never_ends_or_unregisters_a_newer_sheet ... ok\ntest a_dismissed_or_abandoned_confirmation_is_a_denial ... ok\ntest a_confirmation_resolves_once_and_only_for_its_nonce ... ok\ntest no_wire_intent_can_carry_an_approval ... ok\n\ntest result: ok. 5 passed; 0 failed; 0 ignored; 0 measured; 0 filtered out; finished in 0.00s\n\n     Running tests/permission_manifest.rs (target/debug/deps/permission_manifest-26f4c3384d694a29)\n\nrunning 6 tests\ntest capability_directory_holds_only_the_reviewed_grant ... ok\ntest production_csp_permits_packaged_assets_and_ipc_only ... ok\ntest identities_are_independent_and_fixture_config_relaxes_nothing ... ok\ntest the_harness_overlay_only_bundles_the_sealed_engine ... ok\ntest shipping_builds_exclude_fixture_features_and_commands ... ok\ntest only_the_two_application_commands_are_registered_and_granted ... ok\n\ntest result: ok. 6 passed; 0 failed; 0 ignored; 0 measured; 0 filtered out; finished in 0.01s\n\n     Running tests/renderer_review_lifecycle.rs (target/debug/deps/renderer_review_lifecycle-13d2a3dce7eb986e)\n\nrunning 10 tests\ntest renderer_reload_before_reveal_forgets_the_native_held_key ... ok\ntest renderer_delivery_recovery_and_other_webviews_do_not_end_a_live_review ... ok\ntest renderer_reload_during_confirmation_retires_the_native_review ... ok\ntest scoped_confirmation_queued_before_teardown_cannot_present ... ok\ntest scoped_confirmation_admitted_before_teardown_cannot_present_after_effect_release ... ok\ntest scoped_old_callbacks_drained_last_cannot_retire_fresh_page_presentation ... ok\ntest scoped_review_exit_revokes_a_queued_secret_without_retiring_the_page ... ok\ntest scoped_secret_admitted_before_teardown_cannot_present_after_effect_release ... ok\ntest scoped_secret_queued_before_teardown_cannot_present_or_copy ... ok\ntest renderer_reload_during_issuance_drops_the_late_key_without_replaying ... ok\n\ntest result: ok. 10 passed; 0 failed; 0 ignored; 0 measured; 0 filtered out; finished in 1.75s\n\n     Running tests/sidecar_supervision.rs (target/debug/deps/sidecar_supervision-5bc0e61441b4204d)\n\nrunning 5 tests\ntest dropping_an_unreaped_sidecar_kills_and_reaps_its_group ... ok\ntest only_absolute_paths_are_launched ... ok\ntest nothing_is_inherited_and_stderr_is_discarded ... ok\ntest closing_input_ends_a_reader_and_exit_is_seen_before_reaping ... ok\ntest killing_the_group_takes_descendants_with_it ... ok\n\ntest result: ok. 5 passed; 0 failed; 0 ignored; 0 measured; 0 filtered out; finished in 0.03s\n\n   Doc-tests desktop_host\n\nrunning 0 tests\n\ntest result: ok. 0 passed; 0 failed; 0 ignored; 0 measured; 0 filtered out; finished in 0.00s\n\nEXIT 0\ntest result: ok. 20 passed; 0 failed; 0 ignored; 0 measured; 0 filtered out; finished in 7.23s\n\n     Running tests/workbench_execution/main.rs (target/debug/deps/workbench_execution-217590b5a67bd6f3)\n\nrunning 18 tests\ntest canary_secrets_never_reach_records_or_private_files ... ok\ntest generated_overrides_and_extra_credentials_never_reach_a_registered_origin ... ok\ntest known_tenant_changes_need_an_exact_confirmed_review_and_are_sent_once ... ok\ntest history_survives_restarts_and_interrupted_runs_are_never_replayed ... ok\ntest a_jar_cookie_is_a_credential_at_a_registered_origin ... ok\ntest lost_responses_cancels_and_the_bound_never_resend ... ok\ntest redirects_follow_origin_rules_and_credentials_never_cross ... ok\ntest registered_prisma_origins_are_classified_whatever_the_credential ... ok\ntest reset_during_planning_retires_the_send_before_anything_goes ... ok\ntest offline_then_reconnected_sends_nothing_by_itself ... ok\ntest reset_retires_running_sends_and_nothing_they_held_is_kept ... ok\ntest sends_the_fresh_snapshot_with_v1_auth_bodies_and_cookies ... ok\ntest reviews_are_bound_to_the_credentials_and_cookies_actually_sent ... ok\ntest tenant_credentials_are_admitted_before_any_secret_is_read ... ok\ntest wire_credentials_are_redacted_wherever_runs_are_kept ... ok\ntest trust_and_proxies_follow_the_native_transport_policy ... ok\ntest a_tenant_change_retires_reviews_and_unsent_requests ... ok\ntest large_responses_stream_to_sealed_storage_and_save_exactly ... ok\n\ntest result: ok. 18 passed; 0 failed; 0 ignored; 0 measured; 0 filtered out; finished in 3.97s\n\n     Running tests/workspace_mcp/main.rs (target/debug/deps/workspace_mcp-f2895498a1739ee9)\n\nrunning 16 tests\ntest a_catalog_that_cannot_be_read_blocks_remote_use_until_read_again ... ok\ntest a_pe