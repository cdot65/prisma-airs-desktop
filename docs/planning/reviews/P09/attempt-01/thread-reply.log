{"type":"item.started","item":{"id":"item_64","type":"command_execution","command":"/bin/zsh -c \"python3 -B -c 'import json,hashlib,stat,os; from pathlib import Path; base=Path(\\\"docs/planning/reviews/P09/attempt-01\\\");\nfor name in [\\\"source-inventory.json\\\",\\\"evidence-inventory.json\\\"]:\n d=json.loads((base/name).read_text()); bad=[]\n for n,v in d[\\\"files\\\"].items():\n  p=Path(n)\n  try:\n   s=p.lstat(); actual={\\\"mode\\\":stat.S_IMODE(s.st_mode),\\\"kind\\\":\\\"symlink\\\",\\\"target\\\":os.readlink(p)} if p.is_symlink() else {\\\"mode\\\":stat.S_IMODE(s.st_mode),\\\"kind\\\":\\\"file\\\",\\\"sha256\\\":hashlib.file_digest(p.open(\\\"rb\\\"),\\\"sha256\\\").hexdigest()}\n   if actual\"'!=v: bad.append(n)\n  except OSError: bad.append(n)\n print(name,\"final mismatches\",bad,\"fingerprint\",hashlib.sha256((json.dumps(d[\"files\"],sort_keys=True,separators=(\",\",\":\"))+\"'\"\\\\n\\\").encode()).hexdigest())'; git status --short\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
