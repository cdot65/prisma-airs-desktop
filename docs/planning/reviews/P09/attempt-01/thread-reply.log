{"type":"item.completed","item":{"id":"item_43","type":"command_execution","command":"/bin/zsh -lc \"cat tools/native-acceptance/test_c32_native_audit.py tools/native-acceptance/test_administration_coverage.py; sed -n '120,182p' crates/xtask/src/fingerprint.rs; sed -n '250,300p' tools/p09/phase_inputs_c32_production.py\"","aggregated_output":"import copy\nimport json\nfrom pathlib import Path\nimport tempfile\nimport unittest\nfrom c32_native_audit import PREFIX, report\nfrom test_c32_coverage import complete\n\n\nclass NativeAggregation(unittest.TestCase):\n    def setUp(self):\n        self.work=tempfile.TemporaryDirectory();self.addCleanup(self.work.cleanup);self.root=Path(self.work.name)\n        self.original=self.root/PREFIX/'native-attempt-02';self.follow=self.root/PREFIX/'native-attempt-03';(self.original/'native').mkdir(parents=True);(self.follow/'native.staging').mkdir(parents=True)\n        app={'executable_sha256':'fixture','identifier':'fixture-id'}\n        self.raw={'app':app,'checks':[{'id':f'C32-N0{i}','description':'native requirement','result':'pass' if i==1 else 'fail'} for i in range(1,5)]}\n        obs=complete();obs['n3']['ended_announced']=False;obs['n4']['send_reached']=False\n        self.write(self.original/'native-acceptance.json',self.raw);self.write(self.original/'native/observations.json',{'observations':obs})\n        self.write(self.root/'keyboard.json',[{'role':'AXButton','label':'Send','focused':True}]);self.write(self.root/'ended.json',[{'subrole':'AXApplicationStatus','depth':0},{'label':'Ended','depth':1}])\n        self.extra={'app':app,'keyboard':{'before':{'role':'AXTextArea','label':'Message'},'after':{'role':'AXButton','label':'Send'},'send_reached':True,'tree':'keyboard.json'},'ended_status':{'tree':'ended.json','status_regions':['Ended'],'ended_announced':True,'engine_gone':True,'saved_transcript':True,'rail_ended':True}}\n        self.path=self.follow/'native.staging/followup-observations.json';self.write(self.path,self.extra)\n    def write(self,path,value):path.write_text(json.dumps(value))\n    def test_new_aggregate_preserves_raw_failing_results(self):\n        before=(self.original/'native-acceptance.json').read_bytes();v=report(self.root)\n        self.assertTrue(all(c['result']=='pass' for c in v['checks']));self.assertEqual(v['raw_results']['C32-N02'],'fail');self.assertEqual(before,(self.original/'native-acceptance.json').read_bytes())\n    def test_missing_or_failed_followup_rejected(self):\n        for k in ['ended_announced','engine_gone','saved_transcript','rail_ended']:\n            x=copy.deepcopy(self.extra);x['ended_status'][k]=False;self.write(self.path,x)\n            with self.subTest(fact=k),self.assertRaises(AssertionError):report(self.root)\n    def test_wrong_bundle_rejected(self):\n        self.extra['app']=dict(self.extra['app'],executable_sha256='different');self.write(self.path,self.extra)\n        with self.assertRaises(AssertionError):report(self.root)\n    def test_native_focused_node_required(self):\n        self.write(self.root/'keyboard.json',[{'role':'AXButton','label':'Send','focused':False}])\n        with self.assertRaises(AssertionError):report(self.root)\n    def test_native_status_region_required(self):\n        self.write(self.root/'ended.json',[{'label':'Ended','depth':0}])\n        with self.assertRaises(AssertionError):report(self.root)\n\nif __name__=='__main__':unittest.main()\n\"\"\"Focused AX scoping and enforced C31 requirement regressions; no UI calls.\"\"\"\nfrom pathlib import Path\nimport copy\nimport importlib.util\nimport sys\nimport unittest\n\nHERE = Path(__file__).resolve().parent\nROOT = HERE.parent.parent\nsys.path.insert(0, str(HERE))\nimport administration_coverage as coverage\n\n\ndef node(role, label, depth, **extra):\n    return dict(role=role, label=label, depth=depth, **extra)\n\n\ndef product(name, body):\n    heading = name + \" product description\"\n    return [node(\"AXGroup\", name + \" tabs Keys\", 2),\n            node(\"AXHeading\", heading, 3), node(\"AXButton\", heading, 4), *body]\n\n\ndef gateway_tree(forbidden=False, detail=True, kind=\"Service keys\"):\n    # A legitimate Runtime rotation and a similarly named navigation button\n    # coexist with Gateway. They are not Gateway inventory authority.\n    tree = [node(\"AXButton\", \"AI Gateway\", 1)]\n    tree += product(\"AI Runtime Security\", [\n        node(\"AXButton\", \"Issue additional key…\", 3),\n        node(\"AXButton\", \"Finish rotation…\", 3)])\n    body = [node(\"AXTabGroup\", \"AI Gateway tabs\", 3), node(\"AXRadioButton\", \"Keys\", 4),\n            node(\"AXRadioButton\", \"Service keys\", 3), node(\"AXRadioButton\", \"User keys\", 3),\n            node(\"AXTable\", kind, 3)]\n    if detail:\n        body += [node(\"AXGroup\", \"gateway-key-1\", 3, subrole=\"AXLandmarkRegion\"),\n                 node(\"AXHeading\", \"gateway-key-1\", 4), node(\"AXButton\", \"Edit gateway-key-1\", 4),\n                 node(\"AXButton\", \"Rotate gateway-key-1\", 4), node(\"AXButton\", \"Remove gateway-key-1\", 4)]\n        if forbidden:\n            body.append(node(\"AXButton\", \"Issue additional key…\", 4))\n        body.append(node(\"AXButton\", \"Close details\", 4))\n    return tree + product(\"AI Gateway\", body)\n\n\ndef complete_observations():\n    result = {\"kinds\": {}}\n    for kind in (\"Service keys\", \"User keys\"):\n        list_state = coverage.gateway_key_state(gateway_tree(detail=False, kind=kind), kind)\n        detail = coverage.gateway_key_state(gateway_tree(kind=kind), kind, require_detail=True)\n        detail[\"row\"] = \"Details for gateway-key-1\"\n        result[\"kinds\"][kind] = {\"list\": list_state, \"row_labels\": [detail[\"row\"]], \"details\": [detail]}\n    return result\n\n\nclass AdministrationScoping(unittest.TestCase):\n    def test_runtime_rotation_does_not_taint_gateway(self):\n        state = coverage.gateway_key_state(gateway_tree(), \"Service keys\", require_detail=True)\n        self.assertTrue(state[\"ok\"])\n        self.assertEqual(state[\"forbidden_actions\"], [])\n        self.assertEqual(state[\"detail_actions\"], [\"Edit gateway-key-1\", \"Rotate gateway-key-1\", \"Remove gateway-key-1\", \"Close details\"])\n\n    def test_gateway_rotation_action_is_rejected(self):\n        state = coverage.gateway_key_state(gateway_tree(forbidden=True), \"Service keys\", require_detail=True)\n        self.assertFalse(state[\"ok\"])\n        self.assertEqual(state[\"forbidden_actions\"], [\"Issue additional key…\"])\n\n    def test_missing_card_table_or_detail_is_not_negative_proof(self):\n        for tree in [[], gateway_tree(detail=False),\n                     [n for n in gateway_tree() if n[\"role\"] != \"AXTable\"]]:\n            with self.subTest(tree=tree):\n                self.assertFalse(coverage.gateway_key_state(tree, \"Service keys\", require_detail=True)[\"ok\"])\n\n    def test_header_action_uses_board_card_not_navigation_rail(self):\n        tree = gateway_tree()\n        header = coverage.product_header(tree, \"AI Gateway\")\n        self.assertEqual(header[\"label\"], \"AI Gateway product description\")\n        calls = []\n        class App:\n            def ax(self, *args):\n                calls.append(args)\n        coverage.act_on_node(App(), tree, header, \"focus\")\n        self.assertEqual(calls, [(\"focus\", \"AXButton\", \"AI Gateway product description\", 0)])\n\n    def test_gate_only_product_rejects_other_interactive_actions(self):\n        name = \"Agentic Identity Security\"\n        gate = \"needs an admitted \" + name + \" service\"\n        tree = product(name, [node(\"AXStaticText\", gate, 3)])\n        self.assertTrue(coverage.gated_product(tree, name, gate))\n        tree.append(node(\"AXButton\", \"New identity…\", 3))\n        self.assertFalse(coverage.gated_product(tree, name, gate))\n\n    def test_both_key_kinds_and_every_returned_detail_are_required(self):\n        value = complete_observations()\n        self.assertTrue(coverage.gateway_keys_complete(value))\n        bad = copy.deepcopy(value)\n        del bad[\"kinds\"][\"User keys\"]\n        self.assertFalse(coverage.gateway_keys_complete(bad))\n        bad = copy.deepcopy(value)\n        bad[\"kinds\"][\"Service keys\"][\"details\"] = []\n        self.assertFalse(coverage.gateway_keys_complete(bad))\n        bad = copy.deepcopy(value)\n        bad[\"kinds\"][\"User keys\"][\"row_labels\"].append(\"Details for missing-key\")\n        self.assertFalse(coverage.gateway_keys_complete(bad))\n\n    def test_missing_or_failed_assertion_fact_rejects_coverage(self):\n        value = complete_observations()\n        for kind in [\"Service keys\", \"User keys\"]:\n            for location in [\"list\", \"detail\"]:\n                original = value[\"kinds\"][kind][\"list\"] if location == \"list\" else value[\"kinds\"][kind][\"details\"][0]\n                for field in original:\n                    with self.subTest(kind=kind, location=location, missing=field):\n                        bad = copy.deepcopy(value)\n                        state = bad[\"kinds\"][kind][\"list\"] if location == \"list\" else bad[\"kinds\"][kind][\"details\"][0]\n                        del state[field]\n                        self.assertFalse(coverage.gateway_keys_complete(bad))\n            bad = copy.deepcopy(value)\n            bad[\"kinds\"][kind][\"details\"][0][\"forbidden_actions\"] = [\"Finish rotation…\"]\n            self.assertFalse(coverage.gateway_keys_complete(bad))\n\n\nclass RequiredNativeAssertions(unittest.TestCase):\n    @classmethod\n    def setUpClass(cls):\n        path = ROOT / \"docs/planning/evidence/P09/native-controller/native_requirements.py\"\n        spec = importlib.util.spec_from_file_location(\"c31_native_requirements\", path)\n        cls.requirements = importlib.util.module_from_spec(spec)\n        spec.loader.exec_module(cls.requirements)\n        cls.required = cls.requirements.load_requirements(ROOT)\n\n    def record(self, subject):\n        return {\"app\": {\"executable_sha256\": \"current-test-executable\"},\n                \"checks\": [{\"id\": cid, \"result\": \"pass\", \"evidence\": [\"tools/native-acceptance/legacy_assertions.py\"]}\n                           for cid in sorted(self.required[subject])]}\n\n    def test_all_original_c31_inventory_and_accessibility_checks_required(self):\n        self.assertEqual(self.required[\"C31\"], {\"C31-N01\", \"C31-N02\", \"C31-N03\", \"C31-N04\"})\n        self.assertTrue({\"C39-N01\", \"C39-N02\", \"C39-N03\", \"C39-N04\"} <= self.required[\"C39\"])\n\n    def test_missing_failed_or_stale_required_assertion_rejected(self):\n        for subject, ids in [(\"C31\", [\"C31-N01\", \"C31-N04\"]), (\"C39\", [\"C39-N03\", \"C39-N04\"])]:\n            baseline = self.record(subject)\n            errors, _ = self.requirements.assess_record(baseline, ROOT, \"current-test-executable\", self.required[subject])\n            self.assertEqual(errors, [])\n            for cid in ids:\n                for mutation in [\"missing\", \"fail\"]:\n                    with self.subTest(cid=cid, mutation=mutation):\n                        value = copy.deepcopy(baseline)\n                        if mutation == \"missing\":\n                            value[\"checks\"] = [c for c in value[\"checks\"] if c[\"id\"] != cid]\n                        else:\n                            next(c for c in value[\"checks\"] if c[\"id\"] == cid)[\"result\"] = \"fail\"\n                        errors, _ = self.requirements.assess_record(value, ROOT, \"current-test-executable\", self.required[subject])\n                        self.assertIn(cid + \" \" + mutation, errors)\n            errors, _ = self.requirements.assess_record(baseline, ROOT, \"different-executable\", self.required[subject])\n            self.assertIn(\"stale executable\", errors)\n\n\n\nclass GatewayWorkspacePrerequisite(unittest.TestCase):\n    def test_key_inspection_selects_the_required_workspace_before_key_controls(self):\n        from unittest.mock import patch\n        import acceptance_c31 as driver\n        class App:\n            def __init__(self):\n                self.workspace = False\n                self.kind = 'Service keys'\n                self.detail = False\n                self.actions = []\n            def tree(self):\n                if not self.workspace:\n                    return product('AI Gateway', [node('AXRadioButton', 'Keys', 3),\n                        node('AXRadioButton', 'Team A · us', 3),\n                        node('AXStaticText', 'Choose a workspace to read its configuration.', 3)])\n                tree = gateway_tree(detail=self.detail, kind=self.kind)\n                if not self.detail:\n                    tree.append(node('AXButton', 'Details for gateway-key-1', 3))\n                return tree\n            def wait_for(self, predicate, timeout=12):\n                tree = self.tree()\n                return tree, bool(predicate(tree))\n            def ax(self, action, role, label, occurrence=0):\n                self.actions.append(label)\n                if label.startswith('Team A'):\n                    self.workspace = True\n                elif label in ['Service keys', 'User keys']:\n                    self.kind = label\n                elif label.startswith('Details for '):\n                    self.detail = True\n                elif label == 'Close details':\n                    self.detail = False\n        app = App()\n        with patch.object(driver.c29, 'save_tree', return_value='synthetic-tree.json'), patch.object(driver.c29, 'capture', return_value='synthetic-capture.png'):\n            result = driver.gateway_key_checks(app)\n        self.assertTrue(coverage.gateway_keys_complete(result))\n        self.assertEqual(app.actions[0], 'Team A · us')\n        self.assertEqual(set(result['kinds']), {'Service keys', 'User keys'})\n\n\nclass SuccessfulGatewayDetails(unittest.TestCase):\n    def test_error_loading_absent_and_incomplete_details_cannot_prove_restrictions(self):\n        for message in ['The service did not find this resource.', 'Reading details…',\n                        'The workspace’s complete inventory does not contain this item, so it is not shown.',\n                        'This item was not in the part of the workspace’s inventory that could be read. It is not shown, and this does not mean it is absent.']:\n            with self.subTest(message=message):\n                tree = gateway_tree()\n                tree.insert(-1, node('AXStaticText', message, 4))\n                self.assertFalse(coverage.gateway_key_state(tree, 'Service keys', require_detail=True)['ok'])\n\n    def test_every_listed_key_has_a_successful_scoped_detail_fixture(self):\n        import threading\n        from types import SimpleNamespace\n        import mgmt_server\n        handler = object.__new__(mgmt_server.Handler)\n        handler.server = SimpleNamespace(lock=threading.Lock(), gw={'workspaces': [], 'archived': set(),\n            'deleted': set(), 'created': {'api-keys/service': []}, 'renamed': {}, 'scopes': {}})\n        for resource in ['service', 'user']:\n            status, listing = handler.gateway('/ai_gw/v2/api-keys/' + resource,\n                                              {'workspace_id': mgmt_server.GW_A}, {})\n            self.assertEqual(status, 200)\n            self.assertTrue(listing['data'])\n            for item in listing['data']:\n                status, detail = handler.gateway('/ai_gw/v2/api-keys/' + resource + '/' + item['id'],\n                                                {'workspace_id': mgmt_server.GW_A}, {})\n                self.assertEqual(status, 200, (resource, item['id']))\n                self.assertEqual(detail['id'], item['id'])\n                self.assertEqual(detail['name'], item['name'])\n                self.assertEqual(detail['workspace_id'], mgmt_server.GW_A)\n                self.assertTrue({'id', 'name', 'object', 'status', 'key', 'scopes', 'workspace_id'} <= set(detail))\n\nif __name__ == \"__main__\":\n    unittest.main()\npub fn inventory_hash(entries: &[FileEntry]) -> String {\n    let text: String = entries\n        .iter()\n        .map(|e| format!(\"{}\\0{}\\0{}\\n\", e.path, e.mode, e.sha256))\n        .collect();\n    sha256_hex(text.as_bytes())\n}\n\npub fn source(repo: &Repo) -> Result<String> {\n    Ok(inventory_hash(&source_inventory(repo)?))\n}\n\n/// Hash of every regular file under a directory (relative paths, sorted).\npub fn tree_hash(dir: &Path) -> Result<String> {\n    tree_hash_excluding(dir, &[])\n}\n\n/// Like [`tree_hash`], skipping directories with the given names.\npub fn tree_hash_excluding(dir: &Path, skip: &[&str]) -> Result<String> {\n    let mut entries = Vec::new();\n    collect_tree(dir, dir, skip, &mut entries)?;\n    entries.sort_by(|a, b| a.path.cmp(&b.path));\n    Ok(inventory_hash(&entries))\n}\n\nfn collect_tree(root: &Path, dir: &Path, skip: &[&str], out: &mut Vec<FileEntry>) -> Result<()> {\n    let mut children: Vec<_> = std::fs::read_dir(dir)\n        .map_err(io_err(dir))?\n        .filter_map(|e| e.ok())\n        .collect();\n    children.sort_by_key(|e| e.file_name());\n    for child in children {\n        let path = child.path();\n        let relative = path\n            .strip_prefix(root)\n            .map_err(|_| invalid(\"path escaped its root\"))?\n            .to_string_lossy()\n            .into_owned();\n        let meta = std::fs::symlink_metadata(&path).map_err(io_err(&path))?;\n        if meta.is_dir() {\n            if skip.iter().any(|name| child.file_name() == *name) {\n                continue;\n            }\n            collect_tree(root, &path, skip, out)?;\n        } else {\n            out.push(file_entry(root, &relative)?);\n        }\n    }\n    Ok(())\n}\n\n/// Dependency inputs: lockfiles, toolchain pin, immutable inputs, tools.\npub fn dependencies(repo: &Repo, toolchain_hash: &str) -> Result<String> {\n    let mut parts: BTreeMap<String, String> = BTreeMap::new();\n    for file in [\n        \"Cargo.lock\",\n        \"pnpm-lock.yaml\",\n        \"rust-toolchain.toml\",\n        \".npmrc\",\n        \"docs/architecture/inputs.lock.json\",\n    ] {\n        let path = repo.join(file);\n        let digest = match std::fs::read(&path) {\n                subject + ': unexplained driver exit')\n        require(execution['schema'] == 'airs-v2/p09-native-execution/1'\n                and execution['source_root'] == str(root)\n                and execution['driver_subject'] == subject and execution['phase'] == 'P09'\n                and execution['executable_sha256'] == prepared['executable_sha256']\n                and execution['raw_record_sha256'] == sha(path)\n                and execution['required_check_errors'] == errors and execution['superseded_raw_checks'] == carried,\n                subject + ': execution binding mismatch')\n        for field, source in [('controller_sha256', controller / 'run-p09-native-c32.py'),\n                              ('requirements_sha256', controller / 'native_requirements.py'),\n                              ('driver_sha256', root / 'tools/native-acceptance' / ('acceptance_c32_current.py' if subject=='C32' else 'acceptance_' + subject.lower() + '.py'))]:\n            require(execution[field] == sha(source), subject + ': execution source drift: ' + field)\n        require(subprocess.run(['git', 'merge-base', '--is-ancestor', execution['source_head'], 'HEAD'],\n                               cwd=root, capture_output=True).returncode == 0, subject + ': native source is not an integrated ancestor')\n        if subject == 'C43':\n            errors = wizard_coverage.problems(read(directory / 'native/observations.json')['observations'], root)\n            require(not errors, 'C43 retained coverage: ' + str(errors))\n        records.append({'subject': subject, 'record': str(path.relative_to(root)), 'sha256': sha(path),\n                        'started_utc': execution['started_utc'], 'finished_utc': execution['finished_utc'],\n                        'execution': str((directory / 'execution.json').relative_to(root)),\n                        'execution_sha256': sha(directory / 'execution.json'),\n                        'required_targets': sorted(required), 'superseded_raw_checks': carried,\n                        'executable_sha256': prepared['executable_sha256']})\n    ordered = sorted(records, key=lambda record: datetime.datetime.fromisoformat(record['started_utc']))\n    require([record['subject'] for record in ordered[:2]] == ['C36', 'C43'] and ordered[-1]['subject'] == 'C44',\n            'native order requires C36/C43 first and cumulative C44 last')\n    for index, record in enumerate(ordered):\n        start = datetime.datetime.fromisoformat(record['started_utc'])\n        end = datetime.datetime.fromisoformat(record['finished_utc'])\n        require(start <= end, 'invalid native execution interval')\n        if index:\n            require(datetime.datetime.fromisoformat(ordered[index - 1]['finished_utc']) <= start, 'native UI writers overlap')\n    return {'prepare': str((phase / 'native-prepare.json').relative_to(root)),\n            'prepare_sha256': sha(phase / 'native-prepare.json'), 'build_inputs': build, 'records': records,\n            'performance': historical_performance(root), 'source_transition': verify_transition(root)}\n\n\ndef verify_checks(root, record_path):\n    run = read(record_path)\n    baseline = read(root / 'docs/planning/evidence/P09/runs/run-attempt-02.json')\n    require(run['subject'] == 'P09' and set(run['runs']) == set(baseline['runs']) and len(run['runs']) == 18,\n            'phase requires the exact 18 P09 checks')\n    require(Path(run['cwd']).resolve() == root, 'check run is not from this active clone')\n    for name, prefix in [('rustc', 'rustc 1.99.0 '), ('cargo', 'cargo 1.99.0 '), ('node', 'v24.21.0'), ('pnpm', '10.6.5')]:\n        require(run['toolchain'][name] == prefix if name in ['node', 'pnpm'] else run['toolchain'][name].startswith(prefix),\n                'check toolchain mismatch: ' + name)\n    for name, result in run['runs'].items():\n        require(result['exit'] == 0 and sha(root / result['log']) == result['log_sha256'], 'failed/stale check: ' + name)\n    inputs = run['inputs']\n    require(inputs['unchanged'] and inputs['before_digest'] == inputs['after_digest'], 'check input drift')\n    procedure = root / 'docs/planning/evidence/P09/runs/hash-inputs.sh'\n","exit_code":0,"status":"completed"}}
