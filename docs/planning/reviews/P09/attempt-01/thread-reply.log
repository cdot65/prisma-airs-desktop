{"type":"item.completed","item":{"id":"item_34","type":"command_execution","command":"/bin/zsh -lc \"sed -n '3510,3590p' crates/desktop-core/src/authority.rs; sed -n '3881,3920p' crates/desktop-core/src/authority.rs; sed -n '1,220p' crates/desktop-core/src/presentation.rs; rg -n 'presentation|forget_secret|discard_change|RequestApply|request_apply|sync_changes|retire' crates/desktop-core/src/authority/change_domain.rs\"","aggregated_output":"    /// Admits or refuses one delivered Intent. Admission never awaits remote\n    /// IO, Keychain calls or an operator answer while holding the state.\n    pub async fn dispatch(&self, delivery: Delivery, intent: Intent) -> Result<Receipt, Refusal> {\n        let kind = intent.kind();\n        let (result, effects) = {\n            let mut state = lock(&self.inner)?;\n            let digest = intent_digest(&state.salt, &intent);\n            match state.operator_sessions.check(&delivery, &digest) {\n                Admit::Refused(refusal) => return Err(refusal),\n                Admit::Duplicate(result) => return result,\n                Admit::Fresh => {\n                    let mut effects = Vec::new();\n                    // What an import writes waits while it (or its\n                    // rollback) runs, until every receipt has settled, and\n                    // while a receipt cannot be read (D050).\n                    let result =\n                        if state.v1_import_holds() && import_v1_domain::waits_for_import(&intent) {\n                            Err(Refusal::Busy)\n                        } else {\n                            admit(\n                                &mut state,\n                                &self.inner.session,\n                                &self.inner.adapters,\n                                intent,\n                                &mut effects,\n                            )\n                        };\n                    if result.is_err() {\n                        effects.clear();\n                    }\n                    // Settlements published by this intent are kept on\n                    // this Mac whether or not the intent itself succeeded.\n                    effects.extend(gateway_local_effects(&mut state));\n                    // Learner records wait in the ledger for a confirmed\n                    // save; once one has happened, let cleanup resume.\n                    if !state.durability_unconfirmed && !state.data.learner_cleanup.is_empty() {\n                        effects.push(Effect::Cleanup);\n                    }\n                    state\n                        .operator_sessions\n                        .record(&delivery, digest, result.clone());\n                    (result, effects)\n                }\n            }\n        };\n        run_effects(&self.inner, effects);\n        // Only the request's kind and the refusal's code (D051).\n        self.inner\n            .diagnostics\n            .record(crate::diagnostics::Event::Intent {\n                kind: kind.to_owned(),\n                refusal: result.as_ref().err().map(refusal_code),\n            });\n        result\n    }\n\n    /// Returns the current redacted snapshot and subscribes to its updates\n    /// atomically, so no update between them is lost.\n    pub fn observe(&self, scope: ViewScope) -> Result<Observation, Refusal> {\n        let mut state = lock(&self.inner)?;\n        match scope {\n            ViewScope::Shell => {\n                let snapshot = state.snapshot();\n                let updates = state.subscribers.subscribe().ok_or(Refusal::Busy)?;\n                Ok(Observation::Shell { snapshot, updates })\n            }\n            ViewScope::AcademyCall(operation) => Ok(Observation::AcademyCall(\n                state.observe_academy_call(&operation)?,\n            )),\n            ViewScope::Management(operation) => Ok(Observation::Management(\n                state.observe_management(&operation)?,\n            )),\n            ViewScope::Workbench(operation) => {\n                Ok(Observation::Workbench(state.observe_workbench(&operation)?))\n            }\n        }\n    }\n\n    /// Live observers registered with the core (retired ones are pruned).\n    pub fn observer_count(&self) -> usize {\n        lock(&self.inner)\n        Intent::SelectTenant { tenant, resolution } => {\n            state.require_storage()?;\n            // A tenant an unsettled import wrote is not there yet (D050); a\n            // setup draft is not a tenant until it completes (C29).\n            if !state.committed_tenant(&tenant) || state.v1_hides_tenant(&tenant) {\n                return Err(Refusal::InvalidInput);\n            }\n            if resolution.is_some() && state.data.active.as_ref() == Some(&tenant) {\n                return Err(Refusal::StaleContext);\n            }\n            // The one switch path (I1): a pending Harness decision refuses\n            // it until the operator resolves the conversation.\n            let resolution = match state.guard_switch(&tenant, resolution, None) {\n                Ok(resolution) => resolution,\n                Err(refusal) => {\n                    state.changed();\n                    return Err(refusal);\n                }\n            };\n            let before = state.data.clone();\n            state.data.active = Some(tenant);\n            state.save_with(&before)?;\n            if let Some(resolution) = resolution {\n                resolution.resolve(state)?;\n            }\n            effects.extend(state.take_history_jobs());\n            effects.push(Effect::Start(state.reissue_context()));\n            // The new tenant's Home is what a switch shows (C30, shell.md).\n            if state.ui_variant() == features::UiVariant::V2 {\n                state.active_feature = Some(FeatureId::Home);\n            }\n            state.changed();\n        }\n        Intent::DismissSwitchGuard => {\n            state.switch_blocked = None;\n            state.changed();\n        }\n        Intent::ReadTenant { context } => {\n            let tenant = state.check_context(&context)?;\n            let products = state.selected_products(&tenant);\n//! Native-only revocable ownership carried from admission to presentation.\nuse std::sync::{\n    Arc,\n    atomic::{AtomicBool, Ordering},\n};\n\n/// A native callback may present or copy only while its original owner lives.\n/// This token is never a wire value, persisted record or mutation authority.\n#[derive(Clone, Debug)]\npub struct PresentationLease(Arc<AtomicBool>);\nimpl Default for PresentationLease {\n    fn default() -> Self {\n        Self(Arc::new(AtomicBool::new(true)))\n    }\n}\nimpl PresentationLease {\n    pub fn is_current(&self) -> bool {\n        self.0.load(Ordering::Acquire)\n    }\n    pub(crate) fn revoke(&self) {\n        self.0.store(false, Ordering::Release);\n    }\n}\n#[derive(Debug, Default)]\npub(crate) struct PresentationOwner(PresentationLease);\nimpl PresentationOwner {\n    pub(crate) fn lease(&self) -> PresentationLease {\n        self.0.clone()\n    }\n    pub(crate) fn revoke(&self) {\n        self.0.revoke();\n    }\n}\nimpl Drop for PresentationOwner {\n    fn drop(&mut self) {\n        self.revoke();\n    }\n}\n\n/// Fixture-only pause after real admission releases its lock, before a native\n/// presentation effect runs. It adds no IPC route and never pauses ordinary work.\n#[cfg(any(test, feature = \"test-fixtures\"))]\n#[derive(Default)]\npub struct PresentationGate {\n    entered: AtomicBool,\n    released: std::sync::Mutex<bool>,\n    wake: std::sync::Condvar,\n}\n#[cfg(any(test, feature = \"test-fixtures\"))]\nimpl PresentationGate {\n    pub fn entered(&self) -> bool {\n        self.entered.load(Ordering::Acquire)\n    }\n    pub fn release(&self) {\n        if let Ok(mut go) = self.released.lock() {\n            *go = true;\n            self.wake.notify_all();\n        }\n    }\n    pub(crate) fn pause(&self) {\n        self.entered.store(true, Ordering::Release);\n        if let Ok(go) = self.released.lock() {\n            // A broken fixture cannot strand the process after an assertion.\n            let _ = self\n                .wake\n                .wait_timeout_while(go, std::time::Duration::from_secs(15), |go| !*go);\n        }\n    }\n}\n4://! and baseline digest. RequestApply compares freshly captured input with\n37:use crate::presentation::{PresentationLease, PresentationOwner};\n133:/// The review the presentation may show (no secrets).\n159:/// One applied change as the presentation may show it (never the secret).\n278:    presentation: PresentationOwner,\n332:/// workspace replaced before the write retires it (nothing may be sent),\n352:    presentation: PresentationOwner,\n379:    /// rotation even after the context retired (without its secret; C31).\n551:                    presentation: PresentationOwner::default(),\n580:            presentation: PresentationOwner::default(),\n595:    /// RequestApply: the freshly captured `draft` and typed `confirmation`\n598:    pub(super) fn request_apply(\n674:        Ok((nonce, request, current.presentation.lease()))\n679:    /// returns the review to ready (another RequestApply is needed).\n785:                presentation: PresentationOwner::default(),\n909:    pub(super) fn retire_renderer_reviews(&mut self) {\n911:            let _ = self.discard_change(&review);\n919:            let _ = self.forget_secret(&operation);\n925:    pub(super) fn discard_change(&mut self, review: &ReviewId) -> Result<(), Refusal> {\n935:                // An applied review: its exit retires every one-time secret\n947:                    let _ = self.forget_secret(operation);\n986:        Ok((label, secret, record.presentation.lease()))\n1009:        self.sync_changes();\n1016:    /// keeps its own outcome. A retired reference is never current again.\n1017:    pub(super) fn retire_scoped_applies(&mut self, keep: Option<&WorkspaceRef>) {\n1030:    pub(super) fn forget_secret(&mut self, operation: &OperationId) -> Result<(), Refusal> {\n1036:        record.presentation.revoke();\n1060:            let _ = self.forget_secret(&operation);\n1065:    /// to a retired context (an open confirmation is ended, held secrets\n1067:    pub(super) fn sync_changes(&mut self) {\n1070:        let retired = self.change_review.as_ref().is_some_and(|r| {\n1078:            if active.as_ref() != Some(&review.context) || retired {\n1120:                record.presentation.revoke();\n1160:            // its secret) is kept before a retired context's reply is dropped.\n1163:                // A retired context's reply and one-time key go unread.\n1787:    /// first (checked and marked under one lock that retirement takes too).\n","exit_code":0,"status":"completed"}}
