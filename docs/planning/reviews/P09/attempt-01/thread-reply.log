{"type":"item.completed","item":{"id":"item_29","type":"command_execution","command":"/bin/zsh -lc \"sed -n '1,260p' apps/desktop/src/v2/workbench/api-client.tsx; sed -n '1,260p' apps/desktop/src/v2/admin/review-sheet.tsx\"","aggregated_output":"import { forwardRef, useEffect, useMemo, useRef, useState } from 'react'\nimport { createPortal } from 'react-dom'\nimport type { DocumentView, ImportNote, ShellSnapshot, WorkbenchView as WorkbenchState } from '@prisma-airs/desktop-contracts'\nimport type { Dispatch } from '../../features/tenants/dispatch'\nimport { type ObserveWorkbench, type WorkbenchCall, resultText, workbenchCall } from '../../features/workbench/workbench-call'\nimport { Btn } from '../controls'\nimport { Glyph } from '../icons'\nimport { Modal } from '../modal'\nimport { API_COPY as C, methodColor } from './copy'\nimport { type EditorHandle, RequestEditor } from './request-editor'\nimport { RequestTree, requestName } from './request-tree'\nimport { type Run, type Tool, ToolsSheet } from './tools-sheet'\n\nexport interface ApiClientProps {\n    snapshot: ShellSnapshot\n    dispatch: Dispatch\n    observe: ObserveWorkbench\n}\n\ntype Closing = { kind: 'tab'; id: string; name: string } | { kind: 'collection' }\nconst TOOLS: Tool[] = ['environments', 'secrets', 'schemas', 'import', 'git']\nconst faint = { color: 'var(--v2-faint)' }\nconst soft = { color: 'var(--v2-soft)' }\n// A chip never widens the title row: it shrinks and truncates within it (a 900-point window at 200% overflowed by its width).\nconst CHIP = 'flex h-8 max-w-full min-h-0 min-w-0 items-center truncate rounded-[7px] border text-[13px]'\nconst chipStyle = {\n    gap: 8,\n    padding: '0 12px',\n    borderColor: 'var(--v2-rule)',\n    background: 'var(--v2-paper)',\n    color: 'var(--v2-ink)',\n}\n\n/**\n * The API Client as R2App draws it (C41): the title row with the\n * Collection and Environment chips, the 286px request tree, the open\n * requests' tabs, the request line, sub-tabs and response pane, the\n * footer. New components over the workbench intents: the C14/C15\n * behaviour (local-first collections, drafts protected on this Mac,\n * reviewed tenant-credential changes, immutable history) is unchanged.\n * Rust owns each document's revision, conflicts and the private drafts;\n * nothing in this view sends a request by itself.\n */\nexport const ApiClient = forwardRef<HTMLHeadingElement, ApiClientProps>(function ApiClient({ snapshot, dispatch, observe }, ref) {\n    const call = useMemo(() => workbenchCall(dispatch, observe), [dispatch, observe])\n    const state = snapshot.workbench\n    const collection = state.collection\n    const tenant = snapshot.tenants.find((t) => t.id === snapshot.active?.tenant) ?? null\n    const [message, setMessage] = useState('')\n    const [offerNew, setOfferNew] = useState(false)\n    const [tool, setTool] = useState<Tool | null>(null)\n    const [menu, setMenu] = useState(false)\n    const [doc, setDoc] = useState<DocumentView | null>(null)\n    // Counts documents arriving from the core: the editor is keyed by it, so a reloaded document always starts a fresh\n    // editor (the same id and revision under one key kept the old editor's fields).\n    const [docSeq, setDocSeq] = useState(0)\n    const [notes, setNotes] = useState<ImportNote[]>([])\n    const loading = useRef<string | null>(null)\n    // Each load of the selected request has a generation; a result from an earlier load is obsolete (two selections\n    // in flight resolving out of order replaced the current request's document with the earlier one's).\n    const loadGen = useRef(0)\n    // A load that failed, by request id, with its reason: shown in place of the editor with Try again (no automatic retry).\n    const [loadFailure, setLoadFailure] = useState<{ id: string; relative: string; text: string } | null>(null)\n    const editors = useRef(new Map<string, EditorHandle>())\n    const [closing, setClosing] = useState<Closing | null>(null)\n    // The Collection chip: where focus returns when its menu or a tool it opened closes (the menu item is gone by then).\n    const chip = useRef<HTMLButtonElement>(null)\n\n    // A refusal stays shown until the next action that succeeds (a cancelled sheet keeps it).\n    const run: Run = async (request) => {\n        const r = await call(request)\n        const text = resultText(r)\n        if (text) {\n            setMessage(text)\n            setOfferNew(r.kind === 'refused' && r.problem.kind === 'project' && r.problem.detail === 'notCollection')\n        } else if (r.kind !== 'cancelled') {\n            setMessage('')\n            setOfferNew(false)\n        }\n        return r\n    }\n\n    // Closing protects the latest typing first. If that fails, or Rust still\n    // sees unprotected edits, the operator chooses: keep editing, or close\n    // and discard them.\n    const close = async (target: Closing, discard = false) => {\n        setClosing(null)\n        const handles = target.kind === 'tab' ? [editors.current.get(target.id)] : [...editors.current.values()]\n        if (discard) {\n            for (const h of handles) h?.abandon()\n        } else {\n            const kept = await Promise.all(handles.map((h) => (h ? h.flush() : Promise.resolve(true))))\n            if (kept.includes(false)) {\n                setClosing(target)\n                return\n            }\n        }\n        const r = await run(target.kind === 'tab' ? { kind: 'closeTab', id: target.id, discard } : { kind: 'closeCollection', discard })\n        if (r.kind === 'refused' && r.problem.kind === 'unprotected') {\n            setClosing(target)\n            return\n        }\n        if (r.kind === 'closed' || r.kind === 'done') {\n            if (target.kind === 'tab') editors.current.delete(target.id)\n            else editors.current.clear()\n        }\n    }\n\n    // Every document-producing call is a load bound to the collection it was asked of and to a generation; a reply\n    // from an earlier generation, or from a collection no longer open, is dropped (a late reply replaced the current\n    // request's document, or resurrected a closed one).\n    // Rust derives this opaque scope from the full root and collection id. The displayed folder is only a basename:\n    // two clones can have the same id and basename under different parents (attempt-05 R1).\n    const collectionKey = collection?.scope ?? null\n    const collectionRef = useRef<string | null>(collectionKey)\n    collectionRef.current = collectionKey\n    const selectedRef = useRef<string | null>(collection?.selected ?? null)\n    selectedRef.current = collection?.selected ?? null\n    // A cURL import's conversion report that arrived after the core had already selected its draft (the selection's\n    // own load superseded the import): kept for that draft, shown when its document shows.\n    const lateNotes = useRef<{ id: string; notes: ImportNote[] } | null>(null)\n    // The collection the shown document was loaded from: another collection's document is never reused for a request\n    // with the same id (attempt-03 R1).\n    const docCollection = useRef<string | null>(null)\n    type Load = { gen: number; asked: string | null; id: string | null; relative: string | null }\n    const beginLoad = (id: string | null, relative: string | null = null): Load => {\n        const gen = ++loadGen.current\n        loading.current = id\n        setLoadFailure(null)\n        return { gen, asked: collectionRef.current, id, relative }\n    }\n    /** Shows a load's document if the load is still current; a failure of a selected request's load is shown with its reason. */\n    const settleLoad = (load: Load, r: Awaited<ReturnType<WorkbenchCall>> | null, keepNotes: boolean): boolean => {\n        if (load.asked === null || load.asked !== collectionRef.current) return false\n        if (load.gen !== loadGen.current) {\n            // Superseded, but a current import's report is not lost: when the reply's document is the selected request\n            // (its snapshot came first and its own load took over), its notes are shown with that document.\n            if (keepNotes && r?.kind === 'document' && r.notes.length > 0 && selectedRef.current === r.document.id) {\n                // Shown now if that document is already up (the editor renders only for the selected document), else\n                // when its own load lands.\n                lateNotes.current = { id: r.document.id, notes: r.notes }\n                setNotes(r.notes)\n            }\n            return false\n        }\n        if (loading.current === load.id) loading.current = null\n        if (r?.kind === 'document') {\n            setDoc(r.document)\n            docCollection.current = load.asked\n            setDocSeq((n) => n + 1)\n            setNotes(keepNotes ? r.notes : lateNotes.current?.id === r.document.id ? lateNotes.current.notes : [])\n            if (lateNotes.current && lateNotes.current.id !== r.document.id) lateNotes.current = null\n            return true\n        }\n        // The failure names the request it was for: the core keeps the previous selection when a read fails, so a\n        // tree entry's failure must show without that request ever being selected.\n        if (load.id !== null && load.relative !== null && r?.kind !== 'cancelled') setLoadFailure({ id: load.id, relative: load.relative, text: (r && resultText(r)) ?? C.unknownFailure })\n        return false\n    }\n\n    const selected = collection?.selected ?? null\n    const selectedTab = collection?.tabs.find((t) => t.id === selected) ?? null\n    // The core's selection is followed when it changes, not re-asserted against the document shown: after + the\n    // draft is shown from the core's reply before the snapshot naming it selected arrives, and re-opening the\n    // previously selected request in between made the core select that one again (the draft's tab lost).\n    const followed = useRef<string | null>(null)\n    // Following is scoped to one open collection: closing it forgets the followed selection, so the same\n    // collection re-opened with its persisted selection opens that request again (the editor was left blank).\n    const collectionId = collectionKey\n    useEffect(() => {\n        // A collection boundary (closed, re-opened, or replaced by another collection) retires every load in flight\n        // (its reply is ignored), the loading marker and the document shown: the editor never shows one collection's\n        // fields under another, even when both select a request with the same id (attempt-03 R1), and the new\n        // collection's selected request is loaded afresh.\n        followed.current = null\n        loadGen.current += 1\n        loading.current = null\n        setLoadFailure(null)\n        setDoc(null)\n        setNotes([])\n        lateNotes.current = null\n    }, [collectionId])\n    // Opens a request (the selected tab, or a tree entry); only the latest load's reply counts.\n    const open = (tab: { id: string; relative: string }) => {\n        const load = beginLoad(tab.id, tab.relative)\n        void call({ kind: 'openRequest', relative: tab.relative }).then(\n            (r) => settleLoad(load, r, false),\n            () => settleLoad(load, null, false)\n        )\n    }\n    const openRef = useRef(open)\n    openRef.current = open\n    // The document whose editor is up: the editor owns newer fields and revisions, so once it has unmounted (the\n    // selection moved away) the retained DocumentView is obsolete and a return to that request reloads it from the\n    // core (the old snapshot remounted could be saved over a protected draft, or sent).\n    const editorFor = useRef<string | null>(null)\n    // The document whose editor was up and has since unmounted: obsolete, reloaded on return. A document that never\n    // had its editor up (an import's or a draft's reply shown ahead of its snapshot) is fresh and is reused.\n    const staleDoc = useRef<string | null>(null)\n    const editorUp = doc !== null && selectedTab !== null && doc.id === selectedTab.id\n    useEffect(() => {\n        if (!selectedTab || followed.current === selectedTab.id) return\n        followed.current = selectedTab.id\n        // A load of another request still in flight is obsolete once the selection moves on: its reply must not land.\n        if (loading.current !== null && loading.current !== selectedTab.id) {\n            loadGen.current += 1\n            loading.current = null\n        }\n        const reusable = doc?.id === selectedTab.id && docCollection.current === collectionId && staleDoc.current !== selectedTab.id\n        if (reusable || loading.current === selectedTab.id) return\n        // A stale document is not shown while its reload is in flight: remounted, its editor would start from the old\n        // fields and keep them when the fresh document arrived under the same key.\n        if (doc?.id === selectedTab.id) setDoc(null)\n        openRef.current(selectedTab)\n    }, [selectedTab, doc, collectionId])\n    // Recorded after the selection was followed, so that effect sees which editor was up before this render.\n    useEffect(() => {\n        if (editorUp && doc) {\n            editorFor.current = doc.id\n            staleDoc.current = null\n        } else if (editorFor.current !== null) {\n            staleDoc.current = editorFor.current\n            editorFor.current = null\n        }\n    }, [editorUp, doc])\n    const loaded = state.loaded\n    useEffect(() => {\n        if (!loaded) void call({ kind: 'load' })\n    }, [loaded, call])\n    // The collection menu closes on Escape (focus back on the chip) and on a click elsewhere.\n    useEffect(() => {\n        if (!menu) return\n        const onKey = (e: KeyboardEvent) => {\n            if (e.key !== 'Escape') return\n            setMenu(false)\n            chip.current?.focus()\n        }\n        const onClick = () => setMenu(false)\n        window.addEventListener('keydown', onKey)\n        window.addEventListener('click', onClick)\n        return () => {\n            window.removeEventListener('keydown', onKey)\n            window.removeEventListener('click', onClick)\n        }\n    }, [menu])\n\n    const where = collection ? (collection.builtIn ? C.chips.builtIn : collection.folder) : ''\n    const environment = collection?.environments.find((e) => e.name === collection.environment) ?? null\n\n    const band = (\n        <div\n            data-slot='page-header-v2'\n            className='flex shrink-0 flex-wrap items-end'\n            style={{\n                gap: 12,\n                padding: 'var(--v2-page-top) var(--v2-page-x) 18px',\n                borderBottom: '1px solid var(--v2-rule)',\n            }}\n        >\n            <div className='min-w-0'>\nimport { type ReactNode, useEffect, useRef, useState } from 'react'\nimport type { ChangeKind, ChangeResultView, ContextRef, GatewayResource, ManagementRequest, ManagementResource, ShellSnapshot } from '@prisma-airs/desktop-contracts'\nimport { MANAGEMENT_FAILURE_TEXT, RESOURCES, itemName, readManagement, type ObserveManagement } from '../../features/administration/management-read'\nimport { CHANGE_NOUN, type ChangeTarget, ChangeWorkbench, TEMPLATES, isGatewayKind, pretty, resultText } from '../../features/administration/runtime-changes'\nimport { DRAFT_PROBLEM_TEXT } from './gateway-tabs'\nimport { type Dispatch, type DispatchOutcome, outcomeMessage } from '../../features/tenants/dispatch'\nimport { clockOf } from '../copy'\nimport { Modal } from '../modal'\nimport { useShellStore } from '../store'\nimport { Verdict } from '../verdict'\nimport { Glyph } from '../icons'\nimport { ADMIN_COPY as C } from './copy'\nimport { RotationPanel } from './rotation-panel'\n\nexport interface ReviewSheetProps {\n    snapshot: ShellSnapshot\n    context: ContextRef\n    dispatch: Dispatch\n    observe: ObserveManagement\n    /** The change to review first (none when opening a rotation in progress). */\n    change: ChangeTarget | null\n    /** The application whose rotation this sheet follows (a key version, or \"Finish rotation…\"). */\n    rotation: string | null\n    /** A Gateway change keeps its edited text on this Mac as a draft (C17); the save's outcome is what the sheet reports. */\n    onDraft?: (body: string) => void | Promise<DispatchOutcome>\n    note?: ReactNode\n    onClose: () => void\n}\n\n/** What the open sheet says about the Gateway draft, from the current state: the last save's reply, then the core's word. */\nfunction draftNoteText(local: ShellSnapshot['gateway']['local'], saving: DraftSave): string {\n    if (saving === 'pending') return 'Keeping your edits on this Mac…'\n    if (saving === 'refused') return 'The desktop did not keep these edits as a draft; they stay only in this window.'\n    if (saving === 'unknown') return 'The desktop did not confirm that these edits were kept; what it holds is shown once it says.'\n    if (local.problem && DRAFT_PROBLEM_TEXT[local.problem]) return DRAFT_PROBLEM_TEXT[local.problem]!\n    if (local.unsaved) return 'Your edits could not be stored on this Mac (the local store is unavailable); they are kept only in this window until it is.'\n    return 'Your edits are kept on this Mac as a draft (never a review). Nothing is sent until you review and apply it.'\n}\ntype DraftSave = 'pending' | 'refused' | 'unknown' | null\n\nconst matches = (r: ChangeResultView, c: ChangeTarget) => r.kind === c.kind && r.action === c.action && r.target === c.target\n\nconst RUNTIME_RESOURCE: Partial<Record<ChangeKind, ManagementResource>> = {\n    profiles: 'profiles',\n    topics: 'topics',\n    applications: 'applications',\n    apiKeys: 'apiKeys',\n    dataPatterns: 'dataPatterns',\n    dataProfiles: 'dataProfiles',\n    filteringProfiles: 'filteringProfiles',\n    dictionaries: 'dictionaries',\n}\nconst GATEWAY_RESOURCE: Partial<Record<ChangeKind, GatewayResource>> = {\n    gatewayWorkspaces: 'workspaces',\n    gatewayProviders: 'providers',\n    gatewayRoutes: 'routes',\n    gatewayGuardrails: 'guardrails',\n    gatewayServiceKeys: 'serviceKeys',\n    gatewayUserKeys: 'userKeys',\n    gatewayIntegrations: 'integrations',\n}\n\n/** What an applied change established, for its action (C31): never success from a readback value alone. */\nexport type AppliedState = 'live' | 'removed' | 'unconfirmed' | 'failed'\nexport function appliedState(r: ChangeResultView): AppliedState {\n    if (r.outcome === 'unknown') return 'unconfirmed'\n    if (r.outcome !== 'completed') return 'failed'\n    // The service accepted it; only the readback of this action confirms it.\n    if (r.failure) return 'unconfirmed'\n    if (r.action === 'delete') return r.readback === 'absent' ? 'removed' : 'unconfirmed'\n    return r.readback === 'found' ? 'live' : 'unconfirmed'\n}\n\n/** What a reconciliation read of the reviewed item established now. */\ntype Reconciled = { state: 'reading' } | { state: 'read' } | { state: 'present' } | { state: 'absent' } | { state: 'partial' } | { state: 'failed'; message: string }\n\n/**\n * The review surface (C31, I3, I6, I7): the reviewed change (diff, impact,\n * \"Type <name> to confirm\" with Apply disabled until it matches; the native\n * confirmation applies), then its applied panel from the core's result, or\n * the staged rotation panel for a Runtime key version. Every exit (Done,\n * Escape, the scrim, navigation, unmount) ends the reviews it opened in the\n * core, which retires any one-time key their changes returned or will\n * return; a key held for a rotation it resumed is forgotten too.\n */\nexport function ReviewSheet({ snapshot, context, dispatch, observe, change: initial, rotation: rotationApp, onDraft, note, onClose }: ReviewSheetProps) {\n    const [change, setChange] = useState<ChangeTarget | null>(initial)\n    const [application] = useState<string | null>(rotationApp ?? (initial?.kind === 'apiKeys' && initial.action === 'version' ? applicationOf(initial) : null))\n    const [busy, setBusy] = useState(false)\n    // \"Application updated\" waits for the core's recorded acknowledgement\n    // before the old key's removal opens (Version → acknowledgement → Delete).\n    const [ackWaiting, setAckWaiting] = useState(false)\n    const [ackProblem, setAckProblem] = useState<string | null>(null)\n    const [reconciled, setReconciled] = useState<Reconciled | null>(null)\n    // Results present when this change was opened are not its outcome.\n    const seen = useRef(new Set(snapshot.changes.results.map((r) => r.operation)))\n    const [, setOpened] = useState(0)\n    useEffect(() => {\n        seen.current = new Set(snapshot.changes.results.map((r) => r.operation))\n        setReconciled(null)\n        // Render again without the results that belonged to the previous change.\n        setOpened((n) => n + 1)\n        // eslint-disable-next-line react-hooks/exhaustive-deps -- reset per opened change only\n    }, [change])\n    const result = change ? (snapshot.changes.results.find((r) => matches(r, change) && !seen.current.has(r.operation)) ?? null) : null\n    const rotation = application ? (snapshot.rotations.find((r) => r.application === application) ?? null) : null\n    // A key change of a rotation is followed by the rotation panel once it settles.\n    const rotationStep = !!change && change.kind === 'apiKeys' && (change.action === 'version' || change.action === 'delete') && !!application\n    const showWorkbench = !!change && !(result?.settled && rotationStep)\n\n    // A completion is confirmed once more by a toast bound to this tenant and\n    // context (I2, I10): it persists under Reduce Motion until dismissed.\n    const announced = useRef(new Set<string>())\n    const stage = rotation?.stage ?? null\n    const settledState = result?.settled && !rotationStep ? appliedState(result) : null\n    useEffect(() => {\n        const say = (key: string, text: string) => {\n            if (announced.current.has(key)) return\n            announced.current.add(key)\n            useShellStore.getState().toast(text, 'ok', undefined, snapshot.active?.tenant ?? null, context)\n        }\n        if (stage === 'complete' && rotation) say(`rotation-${rotation.application}`, C.rotation.completeToast(rotation.application))\n        if (result && (settledState === 'live' || settledState === 'removed'))\n            say(result.operation, settledState === 'live' ? C.applied.liveToast(change?.title ?? '') : C.applied.removedToast(change?.title ?? ''))\n        // eslint-disable-next-line react-hooks/exhaustive-deps -- on each observed completion\n    }, [stage, settledState])\n\n    // Every review this sheet opened, so its exit can end each one in the core.\n    const reviews = useRef(new Set<string>())\n    const open = snapshot.changes.review?.review ?? null\n    useEffect(() => {\n        if (open && change) reviews.current.add(open)\n    }, [open, change])\n    const exit = useRef<() => void>(() => {})\n    exit.current = () => {\n        // I6: the core ends each review; an applied one retires the one-time\n        // key its change returned, settled or still under way.\n        for (const review of reviews.current) void dispatch({ kind: 'discardChange', review })\n        reviews.current.clear()\n        if (rotation?.issuedBy) void dispatch({ kind: 'forgetSecret', operation: rotation.issuedBy })\n    }\n    // Unmount (navigation, tenant switch, window close) is an exit too. The\n    // deferred call lets a development re-mount cancel it.\n    const pendingExit = useRef<number | null>(null)\n    useEffect(() => {\n        if (pendingExit.current !== null) window.clearTimeout(pendingExit.current)\n        pendingExit.current = null\n        return () => {\n            pendingExit.current = window.setTimeout(() => exit.current(), 0)\n        }\n    }, [])\n\n    // The workbench's draft flush, called before the sheet removes it (Close, Escape, the scrim): React's own\n    // cleanup would read a detached editor (C39b attempt-01 R1).\n    const flush = useRef<(() => void) | null>(null)\n    function close() {\n        flush.current?.()\n        exit.current()\n        onClose()\n    }\n    // The Gateway draft's save as the sheet last saw it (C39b attempt-01 R2); the core's word (problem, unsaved)\n    // is read from the snapshot on every render.\n    const [draftSave, setDraftSave] = useState<DraftSave>(null)\n    const keepDraft = onDraft\n        ? (body: string) => {\n              const r = onDraft(body)\n              if (r && typeof (r as Promise<DispatchOutcome>).then === 'function') {\n                  setDraftSave('pending')\n                  void (r as Promise<DispatchOutcome>).then((o) => setDraftSave(o.kind === 'admitted' ? null : o.kind === 'refused' || o.kind === 'failed' ? 'refused' : 'unknown'))\n              }\n          }\n        : undefined\n    const gatewayNote =\n        change && isGatewayKind(change.kind) && change.action !== 'delete' ? (\n            <p className='text-[12px]' style={{ color: draftSave || snapshot.gateway.local.problem || snapshot.gateway.local.unsaved ? 'var(--v2-flag)' : 'var(--v2-faint)' }} data-slot='gateway-draft-note' data-state={draftSave ?? (snapshot.gateway.local.problem ? 'rejected' : snapshot.gateway.local.unsaved ? 'unsaved' : 'kept')}>\n                {draftNoteText(snapshot.gateway.local, draftSave)}\n            </p>\n        ) : null\n\n    async function updated() {\n        if (!rotation) return\n        setBusy(true)\n        setAckProblem(null)\n        const outcome = await dispatch({ kind: 'acknowledgeDeployment', context, application: rotation.application })\n        setBusy(false)\n        if (outcome.kind === 'refused' || outcome.kind === 'failed') {\n            setAckProblem(outcomeMessage(outcome) ?? C.rotation.ackRefused)\n            return\n        }\n        // Admitted, or not confirmed: only the observed acknowledgement opens the removal.\n        if (outcome.kind === 'unknown') setAckProblem(C.rotation.ackUnknown)\n        setAckWaiting(true)\n    }\n    const acknowledgedAt = rotation?.deploymentAcknowledgedAt ?? null\n    useEffect(() => {\n        if (!ackWaiting || acknowledgedAt === null || !rotation) return\n        setAckWaiting(false)\n        setAckProblem(null)\n        setChange(removeOld(rotation.oldKey.id, rotation.oldKey.name))\n        // eslint-disable-next-line react-hooks/exhaustive-deps -- once the acknowledgement is observed\n    }, [ackWaiting, acknowledgedAt])\n\n    /** Reads the reviewed item itself (never a replay): its detail by ID, or the inventory by name for a creation. */\n    async function reconcile(of: { kind: ChangeKind; target: string; name: string | null; workspace?: string | null }) {\n        setBusy(true)\n        setReconciled({ state: 'reading' })\n        const runtime = RUNTIME_RESOURCE[of.kind]\n        const gateway = GATEWAY_RESOURCE[of.kind]\n        let request: ManagementRequest | null = null\n        if (runtime) request = of.target ? { kind: 'detail', resource: runtime, id: of.target } : { kind: 'page', resource: runtime, offset: 0, limit: 100 }\n        else if (gateway) {\n            const workspace = gateway === 'workspaces' || gateway === 'integrations' ? null : (of.workspace ?? null)\n            request = {\n                kind: 'gateway',\n                workspace,\n                read: of.target ? { kind: 'detail', resource: gateway, id: of.target } : { kind: 'inventory', resource: gateway },\n            }\n        }\n        if (!request) {\n            setBusy(false)\n            setReconciled({ state: 'failed', message: C.applied.cannotReconcile })\n            return\n        }\n        const outcome = await readManagement(dispatch, observe, context, request)\n        setBusy(false)\n        if (outcome.kind === 'notAdmitted') return setReconciled({ state: 'failed', message: outcome.message })\n        const r = outcome.result\n        if (r.kind === 'failed')\n            return setReconciled({\n                state: 'failed',\n                message: MANAGEMENT_FAILURE_TEXT[r.failure],\n            })\n        const found = r.kind === 'detail' ? r.detail.found : r.kind === 'gateway' && r.gateway.kind === 'detail' ? r.gateway.detail.found : null\n        if (found)\n            return setReconciled({\n                state: found === 'found' ? 'present' : found === 'absent' ? 'absent' : 'partial',\n            })\n        // A rotation's issuance: the core matched the reviewed key name; the panel shows what it established.\n        if (of.name === null) return setReconciled({ state: 'read' })\n        // A creation: look for its name in what was read.\n        let rows: Record<string, unknown>[] = []\n        let complete = false\n        if (r.kind === 'page') {\n            rows = JSON.parse(r.page.items) as Record<string, unknown>[]\n            complete = r.page.offset === 0 && r.page.complete\n        } else if (r.kind === 'gateway' && r.gateway.kind === 'list') {\n            rows = JSON.parse(r.gateway.list.rows) as Record<string, unknown>[]\n            complete = r.gateway.list.complete\n        }\n        const info = RESOURCES.find((x) => x.id === runtime)\n        const named = rows.some((row) => (info ? itemName(info, row) : String(row.name ?? '')) === of.name)\n        setReconciled({\n            state: named ? 'present' : complete ? 'absent' : 'partial',\n        })\n    }\n\n    return (\n        <Modal label={application ? C.rotation.title(application) : C.reviewTitle} onClose={close} width={620} padding={30} sheet data-slot='review-sheet'>\n            <div className='flex flex-col' style={{ gap: 18 }}>\n                {/* R2App's review sheet (C39b): the title with the review's state, a close control, and the change's path. */}\n","exit_code":0,"status":"completed"}}
