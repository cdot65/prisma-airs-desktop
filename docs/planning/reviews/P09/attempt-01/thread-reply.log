ctual G10 current qualification required for C32 production ownership change; unchanged C31 subject retains actual all9 with original scope archived, no re-review or score loop. Source outside declared Harness and administrative delta unchanged.\"\n    }\n  },\n  \"live_evidence\": {\n    \"record\": \"docs/planning/evidence/C29/live/L19-verify.json\",\n    \"sha256\": \"52c8cc9ebf3a10c4667f4b746fd52da7baecf30f8e6c588e3ae786fc522c9714\",\n    \"native_receipt\": \"docs/planning/evidence/C29/live/L19/attempt-03/receipt.json\",\n    \"native_receipt_sha256\": \"0d0b66212cd1483dbcab073050750de80e3277d29c875697302609e34855c202\",\n    \"qualification_executable\": \"docs/planning/evidence/C29/live/L19/build-02/l19-qualification-executable.bin\",\n    \"qualification_executable_sha256\": \"8fb5a476b2a25adf2842286faa69e5393f5812ac3d7b65f87564eb0f05b54dca\",\n    \"live_calls_performed_by_this_verifier\": 0,\n    \"remaining_live_allowance\": 0\n  },\n  \"verdict_schema\": \"docs/architecture/review-verdict.schema.json\",\n  \"verdict_path\": \"/Users/cdot/development/redtail/prisma-airs-desktop-v2-current/docs/planning/reviews/P09/attempt-01/verdict.json\"\n}\n","exit_code":0,"status":"completed"}}
