\\"superseded\\\",carried)\nprint(\\\"native drivers\\\",len(required),\\\"errors\\\",errors); files=[\\\"docs/architecture/checks.json\\\",\\\"docs/architecture/native-checks.json\\\",\\\"docs/architecture/toolchain.json\\\",\\\"docs/architecture/budgets.json\\\",\\\"apps/desktop/src-tauri/tauri.conf.json\\\",\\\"apps/desktop/src-tauri/tauri.fixture.conf.json\\\"]+[str(x) for x in sorted(Path(\\\"apps/desktop/src-tauri/capabilities\\\").glob(\\\"*.json\\\"))]+[\\\"rust-toolchain.toml\\\"]; flags=\\\"\\\".join(hashlib.sha256(Path(f).read_bytes()).hexdigest()+\\\"  \\\"+f+\\\"\\\\n\\\" for f in files); print(\\\"build_flags\\\",hashlib.sha256(flags.encode()).hexdigest())'\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
