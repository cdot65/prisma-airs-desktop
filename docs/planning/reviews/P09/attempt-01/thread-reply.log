      \"tools/p09/phase_inputs_c32_production.py\",\n      \"tools/p09/phase_packet_c32_production.py\",\n      \"tools/p09/test_c32_production_policy.py\"\n    ],\n    \"standing\": \"Actual G10 current qualification required for C32 production ownership change; unchanged C31 subject retains actual all9 with original scope archived, no re-review or score loop. Source outside declared Harness and administrative delta unchanged.\"\n  },\n  \"commands\": [\n    {\n      \"record\": \"docs/planning/evidence/P09/runs/run-attempt-10.json\",\n      \"subject\": \"P09\",\n      \"attempt\": \"attempt-10\",\n      \"time\": \"2026-11-02T19:56:44+0000\",\n      \"cwd\": \"/Users/cdot/development/redtail/prisma-airs-desktop-v2-current\",\n      \"toolchain\": {\n        \"rustc\": \"rustc 1.99.0 (b940084d7 2026-09-28)\",\n        \"cargo\": \"cargo 1.99.0 (5f94df478 2026-08-27)\",\n        \"node\": \"v24.21.0\",\n        \"pnpm\": \"10.6.5\",\n        \"rustup_active\": \"1.99.0-aarch64-apple-darwin (overridden by '/Users/cdot/development/redtail/prisma-airs-desktop-v2-current/rust-toolchain.toml')\"\n      },\n      \"environment\": {\n        \"PATH\": \"/Users/cdot/development/redtail/prisma-airs-desktop-v2-current/.tools/bin:/Users/admin/.cargo/bin:/Users/admin/.nvm/versions/node/v24.21.0/bin:/usr/bin:/bin:/usr/sbin:/sbin\",\n        \"RUSTFLAGS\": null,\n        \"CARGO_TARGET_DIR\": null,\n        \"RUST_TEST_THREADS\": \"4\"\n      },\n      \"build_flags\": {\n        \"digest\": \"166488b352224eb230ddfca178064d76f43deecbb6c73fb6d9359f56632e1a1f\",\n        \"covers\": \"checks.json, native-checks.json, toolchain.json, budgets.json, tauri.conf.json, tauri.fixture.conf.json, src-tauri/capabilities/*.json, rust-toolchain.toml\"\n      },\n      \"inputs\": {\n        \"procedure\": \"docs/planning/evidence/P09/runs/attempt-10/../hash-inputs.sh\",\n        \"procedure_sha256\": \"0a4f9546e1aa4a812da6a946c6ee73d9a0e69c3fd4534dd3d480d5c804b53ea1\",\n        \"before_inven