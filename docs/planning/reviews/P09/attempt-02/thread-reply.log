{"type":"item.completed","item":{"id":"item_51","type":"command_execution","command":"/bin/zsh -lc \"rg -n 'fn (begin_setup|discard_setup|complete_setup|completable_setup|verify|begin_verify|update_setup|setup_signature)|struct Setup|ready|stale' crates/desktop-core/src/authority/setup_domain.rs; sed -n '625,815p' crates/desktop-core/src/authority/setup_domain.rs; sed -n '15,100p' crates/desktop-core/src/authority/harness_tools.rs; rg -n 'fn decide_harness_approval|fn settle_harness_confirmation|PresentationOwner|presentation' crates/desktop-core/src/authority/harness_tools.rs; sed -n '180,310p' crates/desktop-core/src/authority/harness_tools.rs; sed -n '130,190p' apps/desktop/src/v2/admin/review-sheet.tsx\"","aggregated_output":"32:pub(super) struct Setup {\n178:    pub(super) fn begin_setup(\n262:    /// delete); verification results go stale through the signature.\n263:    pub(super) fn update_setup(\n312:    /// and the credential records. Results for another digest are stale.\n313:    fn setup_signature(setup: &Setup) -> u64 {\n350:    pub(super) fn begin_verify(\n362:        let management_ready = matches!(setup.tenant.management, ScanCapability::Ready { .. });\n414:        let management = if management_ready {\n475:            let (state_, reason, operation) = if !management_ready {\n734:    fn verify_view(setup: &Setup) -> Option<VerifyView> {\n768:            stale: run.signature != Self::setup_signature(setup),\n779:            .is_some_and(|v| v.done && !v.blocking && !v.stale);\n816:    pub(super) fn completable_setup(\n823:        if !view.done || view.blocking || view.stale {\n840:    pub(super) fn complete_setup(\n889:    pub(super) fn discard_setup(&mut self, context: &ContextRef) -> Result<Vec<RecordId>, Refusal> {\n                            \"Workspace {}: {} route(s), {} provider(s), {} inference key(s) readable.\",\n                            prerequisites.workspace,\n                            prerequisites.routes.as_ref().map_or(0, |l| l.count),\n                            prerequisites.providers.as_ref().map_or(0, |l| l.count),\n                            prerequisites.inference_keys\n                        ),\n                    )\n                } else if lists_failed < sources.len() {\n                    (\n                        VerifyState::Warning,\n                        format!(\n                            \"Workspace {}: partial; {}\",\n                            prerequisites.workspace,\n                            failed.join(\"; \")\n                        ),\n                    )\n                } else {\n                    (\n                        VerifyState::Fail,\n                        format!(\n                            \"Workspace {}: {}\",\n                            prerequisites.workspace,\n                            failed.join(\"; \")\n                        ),\n                    )\n                }\n            }\n            (VerifyLine::RedTeam, ManagementResult::RedTeam { observation }) => {\n                match (&observation.scans, &observation.statistics) {\n                    (Some(scans), Some(_)) => (\n                        VerifyState::Pass,\n                        format!(\n                            \"Red Team scans and statistics readable ({} scans listed).\",\n                            scans.rows.len()\n                        ),\n                    ),\n                    (Some(scans), None) => (\n                        VerifyState::Warning,\n                        format!(\n                            \"Red Team scans readable ({} listed); statistics did not: {}\",\n                            scans.rows.len(),\n                            observation\n                                .statistics_failure\n                                .map_or(\"no reason\", failure_reason)\n                        ),\n                    ),\n                    (None, Some(_)) => (\n                        VerifyState::Warning,\n                        format!(\n                            \"Statistics read; the scan list did not: {}\",\n                            observation\n                                .scans_failure\n                                .map_or(\"no reason\", failure_reason)\n                        ),\n                    ),\n                    (None, None) => (\n                        VerifyState::Fail,\n                        observation\n                            .scans_failure\n                            .or(observation.statistics_failure)\n                            .map_or(\"The Red Team reads returned nothing.\", failure_reason)\n                            .to_owned(),\n                    ),\n                }\n            }\n            (VerifyLine::ModelSkill, ManagementResult::SupplyChain { observation }) => {\n                let ok = [\n                    observation.models.is_some(),\n                    observation.skills.is_some(),\n                    observation.skill_statistics.is_some(),\n                ];\n                let readable = ok.iter().filter(|b| **b).count();\n                if readable == 3 {\n                    (\n                        VerifyState::Pass,\n                        format!(\n                            \"Model and skill scans readable ({} models, {} skills).\",\n                            observation.models.as_ref().map_or(0, |m| m.rows.len()),\n                            observation.skills.as_ref().map_or(0, |s| s.rows.len())\n                        ),\n                    )\n                } else if readable > 0 {\n                    (\n                        VerifyState::Warning,\n                        format!(\"{readable} of 3 model and skill sources readable.\"),\n                    )\n                } else {\n                    (\n                        VerifyState::Fail,\n                        observation\n                            .models_failure\n                            .or(observation.skills_failure)\n                            .map_or(\n                                \"The model and skill reads returned nothing.\",\n                                failure_reason,\n                            )\n                            .to_owned(),\n                    )\n                }\n            }\n            _ => (\n                VerifyState::Fail,\n                \"The service returned a reply the desktop could not use.\".to_owned(),\n            ),\n        };\n        step.step.state = state;\n        step.step.reason = reason;\n    }\n\n    fn verify_view(setup: &Setup) -> Option<VerifyView> {\n        let run = setup.verify.as_ref()?;\n        let steps: Vec<VerifyStep> = run.steps.iter().map(|s| s.step.clone()).collect();\n        let done = steps.iter().all(|s| s.state != VerifyState::Pending);\n        let failed = steps.iter().any(|s| s.state == VerifyState::Fail);\n        // Only a required line blocks: the scan key on first run. An optional\n        // service that failed is carried as a warning the operator can\n        // continue over (and the Inbox shows).\n        let blocking = steps\n            .iter()\n            .any(|s| s.state == VerifyState::Fail && s.line == VerifyLine::ScanKey);\n        let warnings = steps\n            .iter()\n            .filter_map(|s| {\n                let product = s.product?;\n                match s.state {\n                    VerifyState::Warning => Some(VerifyWarning {\n                        product,\n                        reason: s.reason.clone(),\n                    }),\n                    VerifyState::Fail if s.line != VerifyLine::ScanKey => Some(VerifyWarning {\n                        product,\n                        reason: format!(\"Failed: {}\", s.reason),\n                    }),\n                    _ => None,\n                }\n            })\n            .collect();\n        Some(VerifyView {\n            generation: run.generation,\n            steps,\n            done,\n            failed,\n            blocking,\n            stale: run.signature != Self::setup_signature(setup),\n            warnings,\n        })\n    }\n\n    /// The draft as the shell shows it.\n    pub(super) fn setup_view(&self) -> Option<SetupView> {\n        let setup = self.data.setup.as_ref()?;\n        let verify = Self::verify_view(setup);\n        let completable = verify\n            .as_ref()\n            .is_some_and(|v| v.done && !v.blocking && !v.stale);\n        let packs = setup\n            .products\n            .iter()\n            .map(|p| PackView {\n                product: *p,\n                count: case_products(*p)\n                    .iter()\n                    .map(|cp| {\n                        pack_counts()\n                            .iter()\n                            .find(|(c, _)| c == cp)\n                            .map_or(0, |(_, n)| *n)\n                    })\n                    .sum(),\n            })\n            .collect();\n        Some(SetupView {\n            mode: setup.mode,\n            context: setup.context.clone(),\n            tenant: super::tenant_view(&setup.tenant),\n            products: setup.products.clone(),\n            scan_required: setup.mode == SetupMode::FirstRun,\n            packs,\n            workspace: self.setup_workspace(&setup.context),\n            verify,\n            completable,\n        })\n    }\n\n    /// Commits the draft: it becomes a tenant with its products and the\n    /// verify warnings, is made active, and a first run's onboarding is\n    /// done. Refused unless the current inputs were verified without a\n    /// failure (the presentation cannot skip or forge a check).\n    /// Whether the draft under `context` may complete with `packs` now (the\n    /// checks of [`State::complete_setup`], without changing anything):\n    /// the draft tenant's id when it may.\n//! for commands and file changes are decided by the operator, by the\n//! desktop's own id for this run and turn; a stale id is refused.\n\nuse std::sync::Arc;\nuse std::time::Duration;\n\nuse serde::Serialize;\nuse serde_json::{Value, json};\nuse tokio::sync::mpsc;\nuse tokio_util::sync::CancellationToken;\nuse ts_rs::TS;\n\nuse super::harness_domain::RenewJob;\nuse super::{Effect, Inner, Refusal, State, lock};\nuse crate::changes::ChangeDraft;\nuse crate::context::{ContextRef, ReviewId};\nuse crate::harness::HarnessPhase;\nuse crate::harness::session::{Command, ToolRequest, ToolSink};\nuse crate::harness::tools::{self, ToolCall, UNAVAILABLE};\nuse crate::management::ManagementRequest;\nuse crate::runtime::OperationId;\nuse crate::store::StoredProject;\nuse crate::tenants::TenantId;\n\n/// Proposals one conversation may hold.\npub const MAX_PROPOSALS: usize = 8;\n/// How long a tool's read may take before it is answered as unavailable.\nconst TOOL_TIMEOUT: Duration = Duration::from_secs(60);\n\n/// Folders never offered as a project (relative to the home folder, or\n/// absolute).\nconst REFUSED_HOME: [&str; 9] = [\n    \".ssh\", \".aws\", \".gnupg\", \".config\", \".kube\", \".docker\", \"Library\", \".azure\", \".netrc\",\n];\nconst REFUSED_ROOTS: [&str; 11] = [\n    \"/System\",\n    \"/usr\",\n    \"/bin\",\n    \"/sbin\",\n    \"/private/etc\",\n    \"/private/var/db\",\n    \"/private/var/root\",\n    \"/Library\",\n    \"/Applications\",\n    \"/dev\",\n    \"/cores\",\n];\n\n/// Whether `path` (canonical) may be a Harness project: an absolute\n/// directory, neither the root, the home folder itself, a credential or\n/// configuration folder in it, an operating-system folder, nor the app's\n/// own data.\npub fn project_allowed(\n    path: &std::path::Path,\n    home: Option<&std::path::Path>,\n    data: Option<&std::path::Path>,\n) -> bool {\n    let Some(text) = path.to_str() else {\n        return false;\n    };\n    if !path.is_absolute() || text.len() > 4096 || path.parent().is_none() || !path.is_dir() {\n        return false;\n    }\n    if REFUSED_ROOTS.iter().any(|r| path.starts_with(r)) {\n        return false;\n    }\n    if let Some(home) = home\n        && (path == home || REFUSED_HOME.iter().any(|d| path.starts_with(home.join(d))))\n    {\n        return false;\n    }\n    if let Some(data) = data\n        && (path.starts_with(data) || data.starts_with(path))\n    {\n        return false;\n    }\n    true\n}\n\n/// The selected project, as the presentation sees it.\n#[derive(Clone, Debug, PartialEq, Eq, Serialize, TS)]\n#[serde(rename_all = \"camelCase\")]\npub struct HarnessProjectView {\n    pub path: String,\n    /// Changes in it are allowed, each with the operator's approval.\n    pub write: bool,\n94:/// The selected project, as the presentation sees it.\n134:/// Native presentation ownership belongs to the admitted Harness decision.\n139:    _presentation: crate::presentation::PresentationOwner,\n145:    pub(super) presentation: crate::PresentationLease,\n235:    pub(super) fn decide_harness_approval(\n261:            let owner = crate::presentation::PresentationOwner::default();\n262:            let presentation = owner.lease();\n267:                _presentation: owner,\n272:                presentation,\n282:    pub(super) fn settle_harness_confirmation(\n            let home = std::env::var_os(\"HOME\").map(std::path::PathBuf::from);\n            project_allowed(\n                canonical,\n                home.as_deref(),\n                self.harness_data_root.as_deref(),\n            )\n        });\n        let Some(canonical) = allowed else {\n            // Said in the view: the sheet has already closed.\n            self.harness_project_refused = Some((tenant, chosen.display().to_string()));\n            return Err(Refusal::InvalidInput);\n        };\n        self.harness_project_refused = None;\n        let path = canonical.to_str().ok_or(Refusal::InvalidInput)?.to_owned();\n        let before = self.data.clone();\n        if let Some(t) = self.tenant_mut(&tenant) {\n            // A new project starts read-only.\n            t.harness_project = Some(StoredProject {\n                tenant: tenant.clone(),\n                path,\n                write: false,\n            });\n        }\n        self.save_with(&before)\n    }\n\n    pub(super) fn clear_harness_project(&mut self, context: &ContextRef) -> Result<(), Refusal> {\n        self.require_storage()?;\n        let tenant = self.check_context(context)?;\n        self.harness_project_refused = None;\n        let before = self.data.clone();\n        if let Some(t) = self.tenant_mut(&tenant) {\n            t.harness_project = None;\n        }\n        self.save_with(&before)\n    }\n\n    /// Allows (or stops allowing) changes in the selected project.\n    pub(super) fn set_harness_write(\n        &mut self,\n        context: &ContextRef,\n        write: bool,\n    ) -> Result<(), Refusal> {\n        self.require_storage()?;\n        let tenant = self.check_context(context)?;\n        let before = self.data.clone();\n        let project = self\n            .tenant_mut(&tenant)\n            .and_then(|t| t.harness_project.as_mut())\n            .ok_or(Refusal::CapabilityMissing)?;\n        project.write = write;\n        self.save_with(&before)\n    }\n\n    /// The operator's decision on a pending approval.\n    pub(super) fn decide_harness_approval(\n        &mut self,\n        conversation: &OperationId,\n        approval: &str,\n        allow: bool,\n    ) -> Result<Option<NativeDecisionConfirmation>, Refusal> {\n        let c = self.harness_live(conversation)?;\n        let Some(pending) = c\n            .progress_approvals()\n            .into_iter()\n            .find(|a| a.id == approval)\n        else {\n            return Err(Refusal::StaleContext);\n        };\n        // A call that cannot run any more (an MCP server whose sign-in lapsed)\n        // is declined at once, as before C32: no sheet is shown for it.\n        if allow\n            && pending.effect == crate::harness::ApprovalEffect::MayChange\n            && self.approval_usable(conversation, &pending)\n        {\n            // In-page consent never authorises a change: the native sheet\n            // does (C32). One at a time; the decision stays pending.\n            if self.harness_confirming.is_some() {\n                return Err(Refusal::Busy);\n            }\n            let nonce = super::change_domain::nonce().ok_or(Refusal::Busy)?;\n            let owner = crate::presentation::PresentationOwner::default();\n            let presentation = owner.lease();\n            self.harness_confirming = Some(PendingConfirmation {\n                conversation: conversation.clone(),\n                approval: approval.to_owned(),\n                nonce,\n                _presentation: owner,\n            });\n            return Ok(Some(NativeDecisionConfirmation {\n                nonce,\n                request: harness_confirmation(&pending),\n                presentation,\n            }));\n        }\n        self.decide_now(conversation, &pending, allow)?;\n        Ok(None)\n    }\n\n    /// The native confirmation of a decision settled: allowed, the decision\n    /// is sent if it is still pending in the same conversation; refused or\n    /// stale, nothing is sent and the decision stays for the operator.\n    pub(super) fn settle_harness_confirmation(\n        &mut self,\n        conversation: &OperationId,\n        approval: &str,\n        nonce: u64,\n        accepted: bool,\n    ) {\n        if self\n            .harness_confirming\n            .as_ref()\n            .map(|p| (&p.conversation, p.approval.as_str(), p.nonce))\n            != Some((conversation, approval, nonce))\n        {\n            return;\n        }\n        self.harness_confirming = None;\n        if !accepted {\n            return;\n        }\n        let Ok(c) = self.harness_live(conversation) else {\n            return;\n        };\n        let Some(pending) = c\n            .progress_approvals()\n            .into_iter()\n            .find(|a| a.id == approval)\n        else {\n            return;\n        };\n    const open = snapshot.changes.review?.review ?? null\n    useEffect(() => {\n        if (open && change) reviews.current.add(open)\n    }, [open, change])\n    const exit = useRef<() => void>(() => {})\n    exit.current = () => {\n        // I6: the core ends each review; an applied one retires the one-time\n        // key its change returned, settled or still under way.\n        for (const review of reviews.current) void dispatch({ kind: 'discardChange', review })\n        reviews.current.clear()\n        if (rotation?.issuedBy) void dispatch({ kind: 'forgetSecret', operation: rotation.issuedBy })\n    }\n    // Unmount (navigation, tenant switch, window close) is an exit too. The\n    // deferred call lets a development re-mount cancel it.\n    const pendingExit = useRef<number | null>(null)\n    useEffect(() => {\n        if (pendingExit.current !== null) window.clearTimeout(pendingExit.current)\n        pendingExit.current = null\n        return () => {\n            pendingExit.current = window.setTimeout(() => exit.current(), 0)\n        }\n    }, [])\n\n    // The workbench's draft flush, called before the sheet removes it (Close, Escape, the scrim): React's own\n    // cleanup would read a detached editor (C39b attempt-01 R1).\n    const flush = useRef<(() => void) | null>(null)\n    function close() {\n        flush.current?.()\n        exit.current()\n        onClose()\n    }\n    // The Gateway draft's save as the sheet last saw it (C39b attempt-01 R2); the core's word (problem, unsaved)\n    // is read from the snapshot on every render.\n    const [draftSave, setDraftSave] = useState<DraftSave>(null)\n    const keepDraft = onDraft\n        ? (body: string) => {\n              const r = onDraft(body)\n              if (r && typeof (r as Promise<DispatchOutcome>).then === 'function') {\n                  setDraftSave('pending')\n                  void (r as Promise<DispatchOutcome>).then((o) => setDraftSave(o.kind === 'admitted' ? null : o.kind === 'refused' || o.kind === 'failed' ? 'refused' : 'unknown'))\n              }\n          }\n        : undefined\n    const gatewayNote =\n        change && isGatewayKind(change.kind) && change.action !== 'delete' ? (\n            <p className='text-[12px]' style={{ color: draftSave || snapshot.gateway.local.problem || snapshot.gateway.local.unsaved ? 'var(--v2-flag)' : 'var(--v2-faint)' }} data-slot='gateway-draft-note' data-state={draftSave ?? (snapshot.gateway.local.problem ? 'rejected' : snapshot.gateway.local.unsaved ? 'unsaved' : 'kept')}>\n                {draftNoteText(snapshot.gateway.local, draftSave)}\n            </p>\n        ) : null\n\n    async function updated() {\n        if (!rotation) return\n        setBusy(true)\n        setAckProblem(null)\n        const outcome = await dispatch({ kind: 'acknowledgeDeployment', context, application: rotation.application })\n        setBusy(false)\n        if (outcome.kind === 'refused' || outcome.kind === 'failed') {\n            setAckProblem(outcomeMessage(outcome) ?? C.rotation.ackRefused)\n            return\n        }\n        // Admitted, or not confirmed: only the observed acknowledgement opens the removal.\n","exit_code":0,"status":"completed"}}
