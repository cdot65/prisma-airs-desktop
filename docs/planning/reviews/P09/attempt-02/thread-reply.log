{"type":"item.completed","item":{"id":"item_50","type":"command_execution","command":"/bin/zsh -lc \"cat crates/desktop-core/tests/ui_v2_workbench/main.rs | head -250; cat apps/desktop/src/v2/workbench/response-pane.tsx | head -180; sed -n '145,210p' apps/desktop/src/v2/store.ts; sed -n '335,370p' apps/desktop/src/v2/workbench/api-client.tsx; sed -n '1,130p' apps/desktop/src/v2/admin/review-sheet.tsx\"","aggregated_output":"//! C33: API Client and Test Cases in the v2 shell, and \"Show the calls\",\n//! through the production authority interface against loopback fixture\n//! servers (screens/api-client-test-cases.md; invariant I5): an API\n//! response kept in history never changes after a later configuration\n//! change, while a new send reflects it (V2-R05, V2-T05); starter packs are\n//! named and not run until a Playground scan opened from the case records\n//! its verdict, only while the case still holds what was scanned; and the\n//! calls made on the tenant's behalf are shown only while chosen, without\n//! any secret, query or body.\n\n#[path = \"../workbench_execution/server.rs\"]\n#[allow(dead_code)]\nmod server;\n#[path = \"../context_credentials/support.rs\"]\n#[allow(dead_code)]\nmod support;\n\nuse std::path::{Path, PathBuf};\nuse std::sync::{Arc, Mutex};\nuse std::time::Duration;\n\nuse desktop_core::fixtures::{self, Handles};\nuse desktop_core::management::ManagementEndpoints;\nuse desktop_core::runtime::OperationId;\nuse desktop_core::store::PersistedState;\nuse desktop_core::transport::{ProxyMode, TransportPolicy};\nuse desktop_core::{\n    AuthorityHandle, Core, CoreConfig, Delivery, Intent, LibraryState, Observation, Receipt,\n    Refusal, ScanState, ShellSnapshot, ViewScope,\n};\nuse serde_json::{Value, json};\nuse server::{Answer, Http};\nuse sha2::{Digest, Sha256};\nuse support::{Reply, Seen, TestCa, TlsServer, eventually};\n\nconst SCAN_KEY: &str = \"SYNTHETIC-SCAN-KEY-c33-0001\";\nconst CLIENT_ID: &str = \"c33@1234567890.iam.panserviceaccount.com\";\nconst CLIENT_SECRET: &str = \"SYNTHETIC-CLIENT-SECRET-c33\";\nconst TSG: &str = \"1234567890\";\n\nstruct Desk {\n    core: Core,\n    handle: AuthorityHandle,\n    session: String,\n    sequence: u64,\n    adapters: Handles,\n}\n\nimpl Desk {\n    async fn send(&mut self, intent: Value) -> Result<Receipt, Refusal> {\n        let intent: Intent = serde_json::from_value(intent).expect(\"intent\");\n        self.sequence += 1;\n        self.handle\n            .dispatch(\n                Delivery {\n                    session: self.session.clone(),\n                    sequence: self.sequence,\n                },\n                intent,\n            )\n            .await\n    }\n\n    async fn wb(&mut self, request: Value) -> Value {\n        let Receipt::Admitted { operation, .. } = self\n            .send(json!({\"kind\": \"workbench\", \"request\": request}))\n            .await\n            .expect(\"admitted\");\n        self.wait(operation.expect(\"operation\")).await\n    }\n\n    async fn wait(&self, operation: OperationId) -> Value {\n        let Observation::Workbench(handle) = self\n            .handle\n            .observe(ViewScope::Workbench(operation))\n            .expect(\"observe\")\n        else {\n            unreachable!(\"workbench scope\")\n        };\n        serde_json::to_value(handle.result().await).expect(\"json\")\n    }\n\n    fn snap(&self) -> ShellSnapshot {\n        match self.handle.observe(ViewScope::Shell).expect(\"observe\") {\n            Observation::Shell { snapshot, .. } => snapshot,\n            _ => unreachable!(\"shell scope\"),\n        }\n    }\n\n    fn json(&self) -> Value {\n        serde_json::to_value(self.snap()).expect(\"json\")\n    }\n\n    fn context(&self) -> String {\n        self.snap()\n            .active\n            .expect(\"active\")\n            .context\n            .as_str()\n            .to_owned()\n    }\n\n    async fn open(&mut self, root: &Path) {\n        self.adapters.folders.reply(Some(root.to_path_buf()));\n        let r = self.wb(json!({\"kind\": \"openFolder\"})).await;\n        assert_eq!(r[\"kind\"], \"opened\", \"{r}\");\n    }\n\n    async fn send_doc(&mut self, relative: &str) -> Value {\n        let r = self\n            .wb(json!({\"kind\": \"openRequest\", \"relative\": relative}))\n            .await;\n        assert_eq!(r[\"kind\"], \"document\", \"{r}\");\n        let doc = r[\"document\"].clone();\n        self.wb(json!({\"kind\": \"send\", \"id\": doc[\"id\"], \"revision\": doc[\"revision\"], \"fields\": doc[\"fields\"], \"context\": null}))\n            .await\n    }\n\n    async fn show(&mut self, run: &Value) -> Value {\n        self.wb(json!({\"kind\": \"showRun\", \"run\": run})).await\n    }\n\n    async fn open_library(&mut self) {\n        let context = self.context();\n        self.send(json!({\"kind\": \"openLibrary\", \"context\": context}))\n            .await\n            .expect(\"open\");\n        assert!(eventually(|| self.snap().library.state == LibraryState::Ready).await);\n    }\n\n    fn cases(&self) -> Vec<Value> {\n        self.json()[\"library\"][\"cases\"]\n            .as_array()\n            .cloned()\n            .unwrap_or_default()\n    }\n}\n\nasync fn start(adapters: (desktop_core::Adapters, Handles), config: CoreConfig) -> Desk {\n    let (adapters, handles) = adapters;\n    let core = Core::new(config, adapters);\n    core.start();\n    let handle = core.operator();\n    let session = handle.register_delivery_session().expect(\"session\").nonce;\n    Desk {\n        core,\n        handle,\n        session,\n        sequence: 0,\n        adapters: handles,\n    }\n}\n\nfn temp(name: &str) -> PathBuf {\n    let mut n = [0u8; 8];\n    getrandom::fill(&mut n).expect(\"fixture\");\n    let p = std::env::temp_dir()\n        .canonicalize()\n        .expect(\"fixture\")\n        .join(format!(\"airs-v2-c33-{name}-{}\", hex::encode(n)));\n    std::fs::create_dir_all(&p).expect(\"fixture\");\n    p\n}\n\n/// A collection inside a Git repository with one request.\nfn collection(origin: &str) -> PathBuf {\n    let repo = temp(\"repo\");\n    std::fs::create_dir(repo.join(\".git\")).expect(\"fixture\");\n    let root = repo.join(\"api\");\n    std::fs::create_dir_all(&root).expect(\"fixture\");\n    std::fs::write(\n        root.join(\"collection.toml\"),\n        format!(\"format_version = 1\\nid = \\\"c33\\\"\\nname = \\\"Topics\\\"\\n\\n[variables]\\nbase = \\\"{origin}\\\"\\n\"),\n    )\n    .expect(\"fixture\");\n    std::fs::write(\n        root.join(\"topics.request.toml\"),\n        \"format_version = 1\\nid = \\\"topics\\\"\\nmethod = \\\"GET\\\"\\nurl = \\\"{{base}}/topics\\\"\\n\",\n    )\n    .expect(\"fixture\");\n    root\n}\n\nfn sha(text: &str) -> String {\n    hex::encode(Sha256::digest(text.as_bytes()))\n}\n\n#[tokio::test(flavor = \"multi_thread\")]\nasync fn an_api_response_in_history_never_changes_while_a_new_send_reflects_the_change() {\n    // V2-R05, V2-T05 (I5): a topic applied after the first send.\n    let topics = Arc::new(Mutex::new(vec![\"Finance\"]));\n    let served = Arc::clone(&topics);\n    let http = Http::start(Arc::new(move |_| {\n        let names = served.lock().expect(\"topics\").clone();\n        Answer::ok(&json!({\"custom_topics\": names}).to_string())\n    }))\n    .await;\n    let root = collection(&http.origin());\n    let mut desk = start(fixtures::adapters(), CoreConfig::default()).await;\n    desk.open(&root).await;\n    let first = desk.send_doc(\"topics.request.toml\").await;\n    let first_run = first[\"run\"][\"record\"][\"id\"].clone();\n    let before = desk.show(&first_run).await;\n    let kept = before[\"run\"][\"preview\"]\n        .as_str()\n        .expect(\"preview\")\n        .to_owned();\n    assert_eq!(kept, r#\"{\"custom_topics\":[\"Finance\"]}\"#);\n    // The topic is applied: the service now answers with it.\n    topics.lock().expect(\"topics\").push(\"Travel\");\n    let second = desk.send_doc(\"topics.request.toml\").await;\n    let second_run = second[\"run\"][\"record\"][\"id\"].clone();\n    assert_ne!(second_run, first_run);\n    let after = desk.show(&second_run).await;\n    assert_eq!(\n        after[\"run\"][\"preview\"],\n        r#\"{\"custom_topics\":[\"Finance\",\"Travel\"]}\"#\n    );\n    // The earlier response is exactly as it was, record and body.\n    let again = desk.show(&first_run).await;\n    assert_eq!(\n        sha(again[\"run\"][\"preview\"].as_str().expect(\"preview\")),\n        sha(&kept)\n    );\n    assert_eq!(again[\"run\"][\"record\"], before[\"run\"][\"record\"]);\n    let page = desk.wb(json!({\"kind\": \"history\", \"before\": null})).await;\n    let runs = page[\"runs\"].as_array().expect(\"runs\");\n    assert_eq!(runs.len(), 2, \"{page}\");\n    // A restart reads the same snapshot again; nothing is resent.\n    let handles = desk.adapters;\n    drop(desk.core);\n    let (mut adapters, mut kept_handles) = fixtures::adapters();\n    adapters.keychain = handles.vault.clone();\n    kept_handles.vault = handles.vault.clone();\n    adapters.workbench_root = Some(handles.workbench_root.clone());\n    kept_handles.workbench_root = handles.workbench_root.clone();\n    let mut again = start((adapters, kept_handles), CoreConfig::default()).await;\n    again.open(&root).await;\n    let reread = again.show(&first_run).await;\n    assert_eq!(reread[\"run\"][\"preview\"].as_str().map(sha), Some(sha(&kept)));\n    assert_eq!(http.seen().len(), 2);\n}\n\n/// What the synthetic Runtime and management endpoints answer.\nstruct Script {\n    action: &'static str,\n    scan_id: String,\n}\n\n/// A long response header name the service may send: one past the call\nimport { useEffect, useState } from 'react'\nimport type { RunRecord, RunView, RunningView, SendReviewView } from '@prisma-airs/desktop-contracts'\nimport { type WorkbenchCall, resultText, runFailureText, runSummary, sizeText } from '../../features/workbench/workbench-call'\nimport { clockOf } from '../copy'\nimport { Btn } from '../controls'\nimport { Glyph } from '../icons'\nimport { API_COPY as C } from './copy'\nimport { prettyJson } from './request-rows'\nimport { requestName } from './request-tree'\n\ntype ResponseTab = 'body' | 'headers' | 'details' | 'history'\nconst TABS: ResponseTab[] = ['body', 'headers', 'details', 'history']\n\nconst faint = { color: 'var(--v2-faint)' }\nconst soft = { color: 'var(--v2-soft)' }\nconst MONO = \"ui-monospace, 'SF Mono', Menlo, monospace\"\nconst BOX = {\n    margin: '0 14px 12px',\n    border: '1px solid var(--v2-rule)',\n    borderRadius: 8,\n    background: 'var(--v2-paper)',\n}\n\n/** The status pill's tone: the code's class, a failure, or a run that never completed. */\nfunction tone(record: RunRecord): {\n    fg: string\n    bg: string\n    text: string\n    glyph: 'check' | 'alert' | 'ban' | 'x'\n} {\n    if (record.state === 'completed' && record.status !== null) {\n        const code = record.status\n        return code < 300\n            ? {\n                  fg: 'var(--v2-ok)',\n                  bg: 'var(--v2-ok-bg)',\n                  text: `${code} ${code === 200 ? 'OK' : ''}`.trim(),\n                  glyph: 'check',\n              }\n            : code < 500\n              ? {\n                    fg: 'var(--v2-flag)',\n                    bg: 'var(--v2-flag-bg)',\n                    text: String(code),\n                    glyph: 'alert',\n                }\n              : {\n                    fg: 'var(--v2-block)',\n                    bg: 'var(--v2-block-bg)',\n                    text: String(code),\n                    glyph: 'ban',\n                }\n    }\n    const text = record.state === 'interrupted' ? 'Interrupted' : record.state === 'cancelled' ? 'Cancelled' : record.state === 'running' ? 'Running' : 'Failed'\n    return { fg: 'var(--v2-block)', bg: 'var(--v2-block-bg)', text, glyph: 'x' }\n}\n\nexport function elapsedText(ms: number): string {\n    return ms < 1000 ? `${ms} ms` : `${(ms / 1000).toFixed(2)} s`\n}\n\ninterface Props {\n    /** The run Send produced for this request (null before the first send). */\n    run: RunView | null\n    running: RunningView[]\n    review: SendReviewView | null\n    call: WorkbenchCall\n    /** Changes when history may have changed (the collection, a send). */\n    historyKey: string\n    onApply: () => void\n    onDismiss: () => void\n}\n\n/**\n * The response pane (R2App's right 40%): the status line, the Body,\n * Headers, Details and History tabs. A run shown from History is the\n * immutable record of what happened then; nothing here sends anything.\n */\nexport function ResponsePane({ run, running, review, call, historyKey, onApply, onDismiss }: Props) {\n    const [tab, setTab] = useState<ResponseTab>('body')\n    const [pretty, setPretty] = useState(true)\n    const [fromHistory, setFromHistory] = useState<RunView | null>(null)\n    const [message, setMessage] = useState('')\n    // A new send shows its own run and returns to Body.\n    const runId = run?.record.id ?? null\n    useEffect(() => {\n        setFromHistory(null)\n        setMessage('')\n        if (runId) setTab('body')\n    }, [runId])\n    const shown = fromHistory ?? run\n    const record = shown?.record ?? null\n    const formatted = shown?.preview != null ? prettyJson(shown.preview) : null\n\n    const save = async () => {\n        if (!record) return\n        setMessage('')\n        const r = await call({ kind: 'saveResponse', run: record.id })\n        if (r.kind === 'responseSaved') setMessage(C.saved(sizeText(r.bytes), r.name))\n        else if (r.kind !== 'cancelled') setMessage(resultText(r) ?? '')\n    }\n    const copy = async () => {\n        if (shown?.preview == null) return\n        try {\n            await navigator.clipboard.writeText(shown.preview)\n            setMessage(C.copied)\n        } catch {\n            setMessage(C.copyFailed)\n        }\n    }\n\n    const first = running[0] ?? null\n    // Every transfer in flight is in view with its own Cancel, whatever response is being inspected (a run from\n    // History shown while a new send runs hid the progress and the cancellation behind the old record; the core\n    // runs several sends of one document at once, and only the first was shown).\n    const progress = running.map((r, i) => (\n        <span key={r.run} role='status' aria-live='polite' className='flex w-full flex-wrap items-center text-[12.5px]' style={{ gap: 8 }} data-slot='workbench-running'>\n            {C.sendingProgress(r.method, sizeText(r.bytes))}\n            <Btn className='h-7' aria-label={running.length > 1 ? `${C.cancel_} ${i + 1} of ${running.length}` : undefined} onClick={() => void call({ kind: 'cancel', run: r.run })}>\n                {C.cancel_}\n            </Btn>\n        </span>\n    ))\n    const head = record ? (\n        <>\n            <span\n                className='inline-flex items-center rounded-[6px] font-bold'\n                style={{\n                    gap: 4,\n                    padding: '2px 9px',\n                    background: tone(record).bg,\n                    color: tone(record).fg,\n                }}\n                data-slot='response-status'\n            >\n                <Glyph name={tone(record).glyph} size={11} color={tone(record).fg} />\n                {tone(record).text}\n            </span>\n            <span style={soft}>{elapsedText(record.elapsedMs)}</span>\n            <span style={soft}>{sizeText(record.bytes)}</span>\n            <span className='ml-auto truncate text-[12px]' style={faint}>\n                {fromHistory ? `${requestName(record.relative)} · ${clockOf(record.at)}` : clockOf(record.at)}\n            </span>\n        </>\n    ) : first ? null : (\n        <span style={faint}>{C.noResponseYet}</span>\n    )\n\n    return (\n        <section\n            aria-label={C.pane}\n            data-slot='workbench-response-pane'\n            className='flex min-h-0 min-w-0 flex-col overflow-auto'\n            style={{ flex: '0 0 40%', minWidth: 'min(100%, 340px)', maxWidth: 440 }}\n        >\n            <div\n                className='flex flex-wrap items-center text-[13px]'\n                style={{\n                    gap: 10,\n                    minHeight: 48,\n                    padding: '9px 14px',\n                    borderBottom: '1px solid var(--v2-rule)',\n                }}\n                data-slot='response-head'\n            >\n                {progress}\n                {head}\n            </div>\n            {review ? (\n                <div\n                    role='alert'\n                    className='flex flex-col rounded-[10px] text-[13px]'\n                    style={{\n                        gap: 8,\n                        margin: '12px 14px 0',\n                        padding: '12px 14px',\n                        background: 'var(--v2-flag-bg)',\n                    }}\n                    data-slot='workbench-review'\n                >\n    /** Toast lifetime in ms (6 s; tests shorten it). */\n    toastMs: number\n    addUnconfirmed(what: string, intent: Intent, sourceContext?: string | null): number\n    clearUnconfirmed(id: number): void\n    openPalette(): void\n    closePalette(): void\n    setSwitcher(open: boolean): void\n    toast(text: string, kind?: ToastKind, undo?: Toast['undo'], tenant?: string | null, context?: string | null): number\n    /** Retires toasts that speak for another tenant than `tenant`. */\n    retireToasts(tenant: string | null): void\n    dismissToast(id: number): void\n    pushModal(id: string): void\n    popModal(id: string): void\n}\n\nlet nextToast = 1\nlet nextKept = 1\n\nexport const useShellStore = create<ShellStore>((set, get) => ({\n    scope: { tenant: null, context: null, switchReview: null },\n    setScope: (tenant, context, switchReview = null) =>\n        set((s) => ({\n            scope: { tenant, context, switchReview },\n            // Leaving a scope retires what spoke for it, however late it would have arrived.\n            toasts: s.toasts.filter((t) => (t.tenant === null || t.tenant === tenant) && (t.context === null || t.context === context)),\n            unconfirmed: s.unconfirmed.filter((u) => unconfirmedInContext(u, context) && (!switchResolution(u.intent) || switchResolution(u.intent)?.review === switchReview)),\n            arrival: s.arrival && s.arrival.tenant !== tenant ? null : s.arrival,\n        })),\n    paletteOpen: false,\n    switcherOpen: false,\n    adminNavOpen: true,\n    setAdminNav: (open) => set({ adminNavOpen: open }),\n    toasts: [],\n    modals: [],\n    inboxSelection: {},\n    selectInbox: (tenant, selection) => set((s) => ({ inboxSelection: { ...s.inboxSelection, [tenant]: selection } })),\n    harnessDrafts: {},\n    setHarnessDraft: (scope, text) => set((s) => ({ harnessDrafts: { ...s.harnessDrafts, [scope]: text } })),\n    harnessFresh: {},\n    setHarnessFresh: (scope, fresh) => set((s) => ({ harnessFresh: { ...s.harnessFresh, [scope]: fresh } })),\n    harnessUnsent: {},\n    keepHarnessUnsent: (scope, item) =>\n        set((s) => {\n            const kept = s.harnessUnsent[scope] ?? []\n            const record = { ...item, id: nextKept++ }\n            // An uncertain attempt is never removed or downgraded by a later one:\n            // only the core's word on its own send ID, or the operator, settles it.\n            // A not-sent record of the same text is superseded by a later attempt;\n            // not-sent records are kept once per text.\n            const others = kept.filter((k) => k.unconfirmed || k.text !== item.text)\n            return { harnessUnsent: { ...s.harnessUnsent, [scope]: [...others, record] } }\n        }),\n    dropHarnessUnsent: (scope, id) => set((s) => ({ harnessUnsent: { ...s.harnessUnsent, [scope]: (s.harnessUnsent[scope] ?? []).filter((k) => k.id !== id) } })),\n    harnessSent: {},\n    playground: null,\n    openPlayground: (target) => set((s) => ({ playground: { ...target, prefill: { ...target.prefill, nonce: (s.playground?.prefill.nonce ?? 0) + 1 } } })),\n    trackHarnessSend: (scope, sent) => set((s) => ({ harnessSent: { ...s.harnessSent, [scope]: [...(s.harnessSent[scope] ?? []), sent].slice(-64) } })),\n    untrackHarnessSend: (scope, submission) => set((s) => ({ harnessSent: { ...s.harnessSent, [scope]: (s.harnessSent[scope] ?? []).filter((t) => t.submission !== submission) } })),\n    arrival: null,\n    arrive: (target) => set((s) => ({ arrival: { ...target, sequence: (s.arrival?.sequence ?? 0) + 1 } })),\n    unconfirmed: [],\n    toastMs: 6000,\n    addUnconfirmed: (what, intent, context = deliveryContext(intent)) => {\n        const id = nextToast++\n        // A delivery bound to a context the shell no longer shows is moot: never surfaced (I2).\n        if (!unconfirmedInContext({ intent, context }, get().scope.context)) return id\n                                })\n                            }\n                            className='min-h-0 border-0 bg-transparent font-bold'\n                            style={{\n                                border: 0,\n                                minHeight: 0,\n                                height: 24,\n                                padding: 0,\n                                borderRadius: 0,\n                                background: 'transparent',\n                                color: 'var(--v2-ink)',\n                            }}\n                        >\n                            <option value=''>{C.chips.noEnvironment}</option>\n                            {collection.environments.map((e) => (\n                                <option key={e.name} value={e.name}>\n                                    {e.name}\n                                </option>\n                            ))}\n                        </select>\n                        {environment ? <span style={faint}>{C.chips.envOrigin[environment.origin] ?? environment.origin}</span> : null}\n                    </label>\n                </div>\n            ) : null}\n        </div>\n    )\n\n    const alerts = (\n        <>\n            {state.network !== 'live' ? (\n                <p className='text-[12px]' style={faint} data-slot='workbench-network'>\n                    {state.network === 'loopbackOnly' ? C.network.loopbackOnly : C.network.none}\n                </p>\n            ) : null}\n            {state.failure ? (\n                <p role='alert' className='rounded-[10px] text-[13px]' style={{ padding: '12px 14px', background: 'var(--v2-block-bg)' }}>\nimport { type ReactNode, useEffect, useRef, useState } from 'react'\nimport type { ChangeKind, ChangeResultView, ContextRef, GatewayResource, ManagementRequest, ManagementResource, ShellSnapshot } from '@prisma-airs/desktop-contracts'\nimport { MANAGEMENT_FAILURE_TEXT, RESOURCES, itemName, readManagement, type ObserveManagement } from '../../features/administration/management-read'\nimport { CHANGE_NOUN, type ChangeTarget, ChangeWorkbench, TEMPLATES, isGatewayKind, pretty, resultText } from '../../features/administration/runtime-changes'\nimport { DRAFT_PROBLEM_TEXT } from './gateway-tabs'\nimport { type Dispatch, type DispatchOutcome, outcomeMessage } from '../../features/tenants/dispatch'\nimport { clockOf } from '../copy'\nimport { Modal } from '../modal'\nimport { useShellStore } from '../store'\nimport { Verdict } from '../verdict'\nimport { Glyph } from '../icons'\nimport { ADMIN_COPY as C } from './copy'\nimport { RotationPanel } from './rotation-panel'\n\nexport interface ReviewSheetProps {\n    snapshot: ShellSnapshot\n    context: ContextRef\n    dispatch: Dispatch\n    observe: ObserveManagement\n    /** The change to review first (none when opening a rotation in progress). */\n    change: ChangeTarget | null\n    /** The application whose rotation this sheet follows (a key version, or \"Finish rotation…\"). */\n    rotation: string | null\n    /** A Gateway change keeps its edited text on this Mac as a draft (C17); the save's outcome is what the sheet reports. */\n    onDraft?: (body: string) => void | Promise<DispatchOutcome>\n    note?: ReactNode\n    onClose: () => void\n}\n\n/** What the open sheet says about the Gateway draft, from the current state: the last save's reply, then the core's word. */\nfunction draftNoteText(local: ShellSnapshot['gateway']['local'], saving: DraftSave): string {\n    if (saving === 'pending') return 'Keeping your edits on this Mac…'\n    if (saving === 'refused') return 'The desktop did not keep these edits as a draft; they stay only in this window.'\n    if (saving === 'unknown') return 'The desktop did not confirm that these edits were kept; what it holds is shown once it says.'\n    if (local.problem && DRAFT_PROBLEM_TEXT[local.problem]) return DRAFT_PROBLEM_TEXT[local.problem]!\n    if (local.unsaved) return 'Your edits could not be stored on this Mac (the local store is unavailable); they are kept only in this window until it is.'\n    return 'Your edits are kept on this Mac as a draft (never a review). Nothing is sent until you review and apply it.'\n}\ntype DraftSave = 'pending' | 'refused' | 'unknown' | null\n\nconst matches = (r: ChangeResultView, c: ChangeTarget) => r.kind === c.kind && r.action === c.action && r.target === c.target\n\nconst RUNTIME_RESOURCE: Partial<Record<ChangeKind, ManagementResource>> = {\n    profiles: 'profiles',\n    topics: 'topics',\n    applications: 'applications',\n    apiKeys: 'apiKeys',\n    dataPatterns: 'dataPatterns',\n    dataProfiles: 'dataProfiles',\n    filteringProfiles: 'filteringProfiles',\n    dictionaries: 'dictionaries',\n}\nconst GATEWAY_RESOURCE: Partial<Record<ChangeKind, GatewayResource>> = {\n    gatewayWorkspaces: 'workspaces',\n    gatewayProviders: 'providers',\n    gatewayRoutes: 'routes',\n    gatewayGuardrails: 'guardrails',\n    gatewayServiceKeys: 'serviceKeys',\n    gatewayUserKeys: 'userKeys',\n    gatewayIntegrations: 'integrations',\n}\n\n/** What an applied change established, for its action (C31): never success from a readback value alone. */\nexport type AppliedState = 'live' | 'removed' | 'unconfirmed' | 'failed'\nexport function appliedState(r: ChangeResultView): AppliedState {\n    if (r.outcome === 'unknown') return 'unconfirmed'\n    if (r.outcome !== 'completed') return 'failed'\n    // The service accepted it; only the readback of this action confirms it.\n    if (r.failure) return 'unconfirmed'\n    if (r.action === 'delete') return r.readback === 'absent' ? 'removed' : 'unconfirmed'\n    return r.readback === 'found' ? 'live' : 'unconfirmed'\n}\n\n/** What a reconciliation read of the reviewed item established now. */\ntype Reconciled = { state: 'reading' } | { state: 'read' } | { state: 'present' } | { state: 'absent' } | { state: 'partial' } | { state: 'failed'; message: string }\n\n/**\n * The review surface (C31, I3, I6, I7): the reviewed change (diff, impact,\n * \"Type <name> to confirm\" with Apply disabled until it matches; the native\n * confirmation applies), then its applied panel from the core's result, or\n * the staged rotation panel for a Runtime key version. Every exit (Done,\n * Escape, the scrim, navigation, unmount) ends the reviews it opened in the\n * core, which retires any one-time key their changes returned or will\n * return; a key held for a rotation it resumed is forgotten too.\n */\nexport function ReviewSheet({ snapshot, context, dispatch, observe, change: initial, rotation: rotationApp, onDraft, note, onClose }: ReviewSheetProps) {\n    const [change, setChange] = useState<ChangeTarget | null>(initial)\n    const [application] = useState<string | null>(rotationApp ?? (initial?.kind === 'apiKeys' && initial.action === 'version' ? applicationOf(initial) : null))\n    const [busy, setBusy] = useState(false)\n    // \"Application updated\" waits for the core's recorded acknowledgement\n    // before the old key's removal opens (Version → acknowledgement → Delete).\n    const [ackWaiting, setAckWaiting] = useState(false)\n    const [ackProblem, setAckProblem] = useState<string | null>(null)\n    const [reconciled, setReconciled] = useState<Reconciled | null>(null)\n    // Results present when this change was opened are not its outcome.\n    const seen = useRef(new Set(snapshot.changes.results.map((r) => r.operation)))\n    const [, setOpened] = useState(0)\n    useEffect(() => {\n        seen.current = new Set(snapshot.changes.results.map((r) => r.operation))\n        setReconciled(null)\n        // Render again without the results that belonged to the previous change.\n        setOpened((n) => n + 1)\n        // eslint-disable-next-line react-hooks/exhaustive-deps -- reset per opened change only\n    }, [change])\n    const result = change ? (snapshot.changes.results.find((r) => matches(r, change) && !seen.current.has(r.operation)) ?? null) : null\n    const rotation = application ? (snapshot.rotations.find((r) => r.application === application) ?? null) : null\n    // A key change of a rotation is followed by the rotation panel once it settles.\n    const rotationStep = !!change && change.kind === 'apiKeys' && (change.action === 'version' || change.action === 'delete') && !!application\n    const showWorkbench = !!change && !(result?.settled && rotationStep)\n\n    // A completion is confirmed once more by a toast bound to this tenant and\n    // context (I2, I10): it persists under Reduce Motion until dismissed.\n    const announced = useRef(new Set<string>())\n    const stage = rotation?.stage ?? null\n    const settledState = result?.settled && !rotationStep ? appliedState(result) : null\n    useEffect(() => {\n        const say = (key: string, text: string) => {\n            if (announced.current.has(key)) return\n            announced.current.add(key)\n            useShellStore.getState().toast(text, 'ok', undefined, snapshot.active?.tenant ?? null, context)\n        }\n        if (stage === 'complete' && rotation) say(`rotation-${rotation.application}`, C.rotation.completeToast(rotation.application))\n        if (result && (settledState === 'live' || settledState === 'removed'))\n            say(result.operation, settledState === 'live' ? C.applied.liveToast(change?.title ?? '') : C.applied.removedToast(change?.title ?? ''))\n        // eslint-disable-next-line react-hooks/exhaustive-deps -- on each observed completion\n    }, [stage, settledState])\n\n    // Every review this sheet opened, so its exit can end each one in the core.\n    const reviews = useRef(new Set<string>())\n    const open = snapshot.changes.review?.review ?? null\n","exit_code":0,"status":"completed"}}
