{"type":"item.completed","item":{"id":"item_57","type":"command_execution","command":"/bin/zsh -lc \"sed -n '2498,2599p' crates/desktop-core/src/authority.rs; sed -n '350,430p' crates/desktop-core/tests/ui_v2_onboarding/main.rs; sed -n '75,120p' crates/desktop-core/src/authority/management_domain.rs\"","aggregated_output":"        }\n        if let Some(draft) = self.setup_tenant_for(context) {\n            return Ok(draft);\n        }\n        match (&self.active_ref, &self.data.active) {\n            (Some(current), Some(tenant)) if current == context => Ok(tenant.clone()),\n            _ => Err(Refusal::StaleContext),\n        }\n    }\n\n    fn require_storage(&self) -> Result<(), Refusal> {\n        match self.storage {\n            StorageHealth::Ready => Ok(()),\n            StorageHealth::Resetting => Err(Refusal::Busy),\n            StorageHealth::Corrupt | StorageHealth::Unavailable => Err(Refusal::DeniedStore),\n        }\n    }\n\n    /// Retires a tenant's scan credential in `data`. Keychain records join\n    /// the durable cleanup ledger; a session record is returned so the caller\n    /// deletes it once the change is committed.\n    fn retire_credential(&mut self, tenant: &TenantId) -> Option<RecordId> {\n        self.retire_class(tenant, CredentialClass::Scan)\n    }\n\n    /// [`State::retire_credential`] for either credential class.\n    fn retire_class(&mut self, tenant: &TenantId, class: CredentialClass) -> Option<RecordId> {\n        let t = self.tenant_mut(tenant)?;\n        if class == CredentialClass::Management {\n            t.management_client = None;\n        }\n        if class == CredentialClass::Inference {\n            t.inference_target = None;\n        }\n        match std::mem::replace(t.capability_mut(class), ScanCapability::Missing) {\n            ScanCapability::Ready {\n                record,\n                mode: StorageMode::Keychain,\n                ..\n            } => {\n                self.data.pending_cleanup.push(record);\n                None\n            }\n            ScanCapability::Ready {\n                record,\n                mode: StorageMode::Session,\n                ..\n            } => Some(record),\n            // An in-flight write is already in the ledger (Keychain) or is\n            // discarded by its stale completion (session).\n            ScanCapability::Storing { .. }\n            | ScanCapability::Failed { .. }\n            | ScanCapability::Missing => None,\n        }\n    }\n\n    /// Saves the current data. A failure before the replacement changed\n    /// nothing: memory is restored to `before` and the intent is refused. A\n    /// replacement whose durability was not confirmed is kept (it is what a\n    /// restart would most likely load) and reported in the snapshot.\n    fn save_with(&mut self, before: &Data) -> Result<(), Refusal> {\n        let saved = match self.storage {\n            StorageHealth::Ready => self.store.save(&self.persisted()),\n            StorageHealth::Resetting => {\n                self.data = before.clone();\n                return Err(Refusal::Busy);\n            }\n            StorageHealth::Corrupt | StorageHealth::Unavailable => {\n                self.data = before.clone();\n                return Err(Refusal::DeniedStore);\n            }\n        };\n        match saved {\n            Ok(()) => {\n                self.durability_unconfirmed = false;\n                // The saved state includes every rotation fact held in memory.\n                self.rotation_unsaved = false;\n                Ok(())\n            }\n            Err(StoreError::Unconfirmed) => {\n                self.durability_unconfirmed = true;\n                self.rotation_unsaved = false;\n                Ok(())\n            }\n            Err(error) => {\n                self.data = before.clone();\n                Err(store_refusal(error))\n            }\n        }\n    }\n\n    /// Saves again to confirm durability after an unconfirmed save. Only a\n    /// confirmed write-ahead may authorize a protected-storage write.\n    fn confirm_durable(&mut self) -> bool {\n        match self.store.save(&self.persisted()) {\n            Ok(()) => {\n                self.durability_unconfirmed = false;\n                true\n            }\n            Err(_) => false,\n        }\n    }\n        \"a fresh context, not the draft's\"\n    );\n    assert_eq!(snap.onboarding, OnboardingState::Done);\n    assert_eq!(snap.active_feature, desktop_core::features::FeatureId::Home);\n    // The draft's context is retired with it.\n    assert_eq!(\n        desk.send(json!({\"kind\": \"verifyTenantSetup\", \"context\": context}))\n            .await,\n        Err(Refusal::StaleContext)\n    );\n    let saved = desk.adapters.store.saved().expect(\"saved\");\n    assert!(saved.tenant_draft.is_none());\n    assert_eq!(saved.tenant_warnings.len(), 1);\n    let desk = desk.restart();\n    let snap = desk.snap();\n    assert_eq!(snap.onboarding, OnboardingState::Done);\n    assert_eq!(snap.tenants[0].setup_warnings.len(), 2, \"restored\");\n}\n\n#[tokio::test]\nasync fn add_mode_keeps_the_shell_untouched_until_completion_and_discard_cleans_up() {\n    let mut desk = Desk::new();\n    desk.send(json!({\"kind\": \"createTenant\", \"profile\": {\n        \"label\": \"First\", \"tsgId\": \"1111111111\", \"destination\": {\"kind\": \"region\", \"region\": \"europe\"}}}))\n        .await\n        .expect(\"first tenant\");\n    let before = desk.snap();\n    let first = before.active.clone().expect(\"active\");\n    assert_eq!(\n        before.onboarding,\n        OnboardingState::Done,\n        \"an existing tenant means no wizard\"\n    );\n    assert_eq!(\n        desk.send(\n            json!({\"kind\": \"beginTenantSetup\", \"mode\": \"firstRun\", \"profile\": {\n            \"label\": \"X\", \"tsgId\": null, \"destination\": {\"kind\": \"region\", \"region\": \"europe\"}}})\n        )\n        .await,\n        Err(Refusal::InvalidInput),\n        \"first run is impossible once a tenant exists\"\n    );\n    let context = desk.begin(\"add\", \"Second\").await;\n    desk.send(json!({\"kind\": \"configureScanCredential\", \"context\": context, \"mode\": \"keychain\", \"key\": KEY}))\n        .await\n        .expect(\"key in the Keychain\");\n    desk.settled(true).await;\n    let context = desk.context();\n    let records = desk.adapters.vault.records();\n    assert_eq!(records.len(), 1, \"one Keychain record for the draft\");\n    let during = desk.snap();\n    assert_eq!(during.tenants.len(), 1, \"the shell still lists one tenant\");\n    assert_eq!(\n        during.active,\n        Some(first.clone()),\n        \"the active tenant and context are untouched\"\n    );\n    assert!(\n        !during.setup.as_ref().expect(\"setup\").scan_required,\n        \"add mode: the key is optional\"\n    );\n    // Discard: nothing changed, and the draft's record is queued for cleanup.\n    desk.send(json!({\"kind\": \"discardTenantSetup\", \"context\": context}))\n        .await\n        .expect(\"discarded\");\n    let after = desk.snap();\n    assert!(after.setup.is_none());\n    assert_eq!(after.tenants.len(), 1);\n    assert_eq!(after.active, Some(first));\n    let saved = desk.adapters.store.saved().expect(\"saved\");\n    assert!(saved.tenant_draft.is_none());\n    assert!(\n        saved\n            .credentials\n            .iter()\n            .all(|c| c.tenant == before.tenants[0].id)\n    );\n    assert!(\n        saved.pending_cleanup.contains(&records[0])\n            || !desk.adapters.vault.records().contains(&records[0]),\n        \"the draft's Keychain record is being removed\"\n}\n\n/// The binding of one credential generation (context): its session and\n/// its lazily built clients.\npub(super) struct GenerationBinding {\n    context: ContextRef,\n    session: Session,\n    cell: BindingCell,\n    pub(super) investigation: Arc<Investigation>,\n}\n\nimpl State {\n    fn management_binding(\n        &mut self,\n        context: &ContextRef,\n        persistence: impl FnOnce() -> Option<Persistence>,\n    ) -> (Session, BindingCell, Arc<Investigation>) {\n        if let Some(b) = self\n            .management_bindings\n            .iter()\n            .find(|b| &b.context == context)\n        {\n            return (\n                b.session.clone(),\n                Arc::clone(&b.cell),\n                Arc::clone(&b.investigation),\n            );\n        }\n        let binding = GenerationBinding {\n            context: context.clone(),\n            session: Session::new(),\n            cell: BindingCell::default(),\n            investigation: Investigation::new(persistence()),\n        };\n        let triple = (\n            binding.session.clone(),\n            Arc::clone(&binding.cell),\n            Arc::clone(&binding.investigation),\n        );\n        self.management_bindings.push(binding);\n        triple\n    }\n\n    /// The active context's investigation, when its binding exists.\n    pub(super) fn investigation(&self, context: &ContextRef) -> Option<Arc<Investigation>> {\n        self.management_bindings\n","exit_code":0,"status":"completed"}}
