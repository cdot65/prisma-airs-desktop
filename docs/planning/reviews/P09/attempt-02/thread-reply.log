{"type":"item.completed","item":{"id":"item_28","type":"command_execution","command":"/bin/zsh -lc \"sed -n '113,148p' tools/p09/c32_production_policy.py; sed -n '215,315p' tools/p09/phase_inputs_p09_workbench.py; sed -n '1,210p' apps/desktop/src-tauri/src/native_confirmation.rs; sed -n '95,170p' apps/desktop/src-tauri/src/lib.rs\"","aggregated_output":"    for key, name in [('record', 'verdict-returned.json'), ('request', 'request.json'),\n                      ('receipt', 'receipt.json'), ('audit', 'post-review-audit.json')]:\n        result[key] = baseline.ATTEMPT + '/' + name\n        result['sha256' if key == 'record' else key + '_sha256'] = sha(root / result[key])\n    return result\n\n\n\ndef bundle_digest(bundle):\n    import os\n    bundle=Path(bundle);entries=[]\n    for path in sorted(bundle.rglob('*')):\n        if path.is_dir() and not path.is_symlink():continue\n        name=str(path.relative_to(bundle))\n        if path.is_symlink():mode='symlink';h=hashlib.sha256(os.readlink(path).encode()).hexdigest()\n        else:mode='100755' if path.stat().st_mode & 0o111 else '100644';h=original.sha(path)\n        entries.append(f'{name}\\0{mode}\\0{h}\\n')\n    return hashlib.sha256(''.join(entries).encode()).hexdigest()\n    with tempfile.TemporaryDirectory(prefix='p09-native-inputs-') as scratch:\n        current = subprocess.check_output(['/bin/bash', str(procedure), str(root), str(Path(scratch) / 'inputs.sha256')], text=True).strip()\n    amendment = None\n    require(current == value['before_digest'], 'G11 current native build input drift')\n    return {'record': str(path.relative_to(root)), 'sha256': sha(path),\n            'generation': build['generation'], 'input_digest': current,\n            'original_build_input_digest': value['before_digest'], 'driver_amendment': amendment}\n\n\ndef verify_native(root):\n    controller = root / 'docs/planning/evidence/P09/native-controller'\n    sys.path.insert(0, str(controller))\n    from native_requirements import load_requirements, assess_record\n    sys.path.insert(0, str(root / 'tools/native-acceptance'))\n    import wizard_coverage\n    phase = root / 'docs/planning/evidence/P09'\n    prepared = read(phase / 'native-prepare.json')\n    require(prepared['subject'] == 'P09' and prepared['features'] == ['test-fixtures']\n            and prepared['target'] == 'aarch64-apple-darwin', 'wrong prepared subject/features/target')\n    executable = root / prepared['bundle'] / 'Contents/MacOS/prisma-airs-desktop-v2'\n    require(sha(executable) == prepared['executable_sha256'], 'prepared executable drift')\n    from p09_workbench_policy import bundle_digest\n    require(bundle_digest(root/prepared['bundle'])==prepared['bundle_sha256'], 'current complete bundle drift')\n    build = native_build(root, prepared)\n    records = []\n    for subject, required in sorted(load_requirements(root).items()):\n        directory = phase if subject == 'C44' else phase / 'native/cumulative' / subject\n        path = directory / 'native-acceptance.json'\n        record, execution = read(path), read(directory / 'execution.json')\n        require(record['subject'] == subject, subject + ': wrong record subject')\n        ids = [check['id'] for check in record['checks']]\n        require(len(ids) == len(set(ids)), subject + ': duplicate native check IDs')\n        require(sha(directory / 'native-prepare.json') == sha(phase / 'native-prepare.json'), subject + ': preparation mismatch')\n        errors, carried = assess_record(record, root, prepared['executable_sha256'], required)\n        require(not errors, subject + ': required native checks fail: ' + str(errors))\n        allowed_carried = {'C24': {'C24-N06'}, 'C31': {'C31-N01', 'C31-N04'}}\n        require(set(carried) <= allowed_carried.get(subject, set()), subject + ': unapproved superseded raw check')\n        require(execution['driver_return_code'] == 0 or (execution['driver_return_code'] == 1 and bool(carried)),\n                subject + ': unexplained driver exit')\n        require(execution['schema'] == 'airs-v2/p09-native-execution/1'\n                and execution['source_root'] == str(root)\n                and execution['driver_subject'] == subject and execution['phase'] == 'P09'\n                and execution['executable_sha256'] == prepared['executable_sha256']\n                and execution['raw_record_sha256'] == sha(path)\n                and execution['required_check_errors'] == errors and execution['superseded_raw_checks'] == carried,\n                subject + ': execution binding mismatch')\n        for field, source in [('controller_sha256', controller / 'run-p09-native-c32.py'),\n                              ('requirements_sha256', controller / 'native_requirements.py'),\n                              ('driver_sha256', root / 'tools/native-acceptance' / ('acceptance_c32_current.py' if subject=='C32' else 'acceptance_' + subject.lower() + '.py'))]:\n            require(execution[field] == sha(source), subject + ': execution source drift: ' + field)\n        require(subprocess.run(['git', 'merge-base', '--is-ancestor', execution['source_head'], 'HEAD'],\n                               cwd=root, capture_output=True).returncode == 0, subject + ': native source is not an integrated ancestor')\n        if subject == 'C43':\n            errors = wizard_coverage.problems(read(directory / 'native/observations.json')['observations'], root)\n            require(not errors, 'C43 retained coverage: ' + str(errors))\n        records.append({'subject': subject, 'record': str(path.relative_to(root)), 'sha256': sha(path),\n                        'started_utc': execution['started_utc'], 'finished_utc': execution['finished_utc'],\n                        'execution': str((directory / 'execution.json').relative_to(root)),\n                        'execution_sha256': sha(directory / 'execution.json'),\n                        'required_targets': sorted(required), 'superseded_raw_checks': carried,\n                        'executable_sha256': prepared['executable_sha256']})\n    ordered = sorted(records, key=lambda record: datetime.datetime.fromisoformat(record['started_utc']))\n    require([record['subject'] for record in ordered[:2]] == ['C36', 'C43'] and ordered[-1]['subject'] == 'C44',\n            'native order requires C36/C43 first and cumulative C44 last')\n    for index, record in enumerate(ordered):\n        start = datetime.datetime.fromisoformat(record['started_utc'])\n        end = datetime.datetime.fromisoformat(record['finished_utc'])\n        require(start <= end, 'invalid native execution interval')\n        if index:\n            require(datetime.datetime.fromisoformat(ordered[index - 1]['finished_utc']) <= start, 'native UI writers overlap')\n    return {'prepare': str((phase / 'native-prepare.json').relative_to(root)),\n            'prepare_sha256': sha(phase / 'native-prepare.json'), 'build_inputs': build, 'records': records,\n            'performance': historical_performance(root), 'source_transition': verify_transition(root)}\n\n\ndef verify_checks(root, record_path):\n    run = read(record_path)\n    baseline = read(root / 'docs/planning/evidence/P09/runs/run-attempt-02.json')\n    require(run['subject'] == 'P09' and set(run['runs']) == set(baseline['runs']) and len(run['runs']) == 18,\n            'phase requires the exact 18 P09 checks')\n    require(Path(run['cwd']).resolve() == root, 'check run is not from this active clone')\n    for name, prefix in [('rustc', 'rustc 1.99.0 '), ('cargo', 'cargo 1.99.0 '), ('node', 'v24.21.0'), ('pnpm', '10.6.5')]:\n        require(run['toolchain'][name] == prefix if name in ['node', 'pnpm'] else run['toolchain'][name].startswith(prefix),\n                'check toolchain mismatch: ' + name)\n    for name, result in run['runs'].items():\n        require(result['exit'] == 0 and sha(root / result['log']) == result['log_sha256'], 'failed/stale check: ' + name)\n    inputs = run['inputs']\n    require(inputs['unchanged'] and inputs['before_digest'] == inputs['after_digest'], 'check input drift')\n    procedure = root / 'docs/planning/evidence/P09/runs/hash-inputs.sh'\n    require(sha(procedure) == inputs['procedure_sha256'], 'inventory procedure drift')\n    flags = ['docs/architecture/' + p for p in ['checks.json', 'native-checks.json', 'toolchain.json', 'budgets.json']]\n    flags += ['apps/desktop/src-tauri/tauri.conf.json', 'apps/desktop/src-tauri/tauri.fixture.conf.json']\n    flags += sorted(str(p.relative_to(root)) for p in (root / 'apps/desktop/src-tauri/capabilities').glob('*.json'))\n    flags += ['rust-toolchain.toml']\n    flag_inventory = subprocess.check_output(['/usr/bin/shasum', '-a', '256', *flags], cwd=root)\n    require(hashlib.sha256(flag_inventory).hexdigest() == run['build_flags']['digest'], 'current build flags differ from checks')\n    directory = record_path.parent / run['attempt']\n    for label in ['before', 'after']:\n        digest = sha(directory / ('inputs-' + label + '.sha256'))\n        require(digest == inputs[label + '_digest'] == inputs[label + '_inventory_sha256'], 'inventory record mismatch')\n    audit = read(directory / 'post-check-audit.json')\n//! The native operator confirmation and the one-time secret sheet (ADR 0001,\n//! DESIGN \"Fresh editor input and Configuration review\").\n//!\n//! Both are AppKit `NSAlert` sheets attached to the main window, built and\n//! presented on the main thread; they are never a WebView or JS dialog, and\n//! a sheet makes the main window modal, so the editor and navigation are\n//! held while it is open. A confirmation's completion handler resolves a\n//! private, nonce-bound future the core awaits: nothing about it is\n//! serialized to the renderer, an unknown nonce is ignored and a nonce\n//! resolves once. Retiring a review ends its sheet actively.\n//!\n//! The secret sheet shows the key in a selectable, non-editable field with\n//! \"Copy and Close\" and \"Close\". It ends itself after [`REVEAL_FOR`] (first\n//! reveal expiry), clearing the field and dropping (zeroizing) the host's\n//! copy; a copy is cleaned from the clipboard after\n//! [`crate::clipboard_secret::CLEAR_AFTER`] only if it is still ours.\n\nuse std::collections::HashMap;\nuse std::sync::Mutex;\nuse std::time::Duration;\n\nuse tokio::sync::oneshot;\n\n/// How long a revealed secret stays on screen.\npub const REVEAL_FOR: Duration = Duration::from_secs(60);\n\n/// Open confirmations by nonce: each resolves exactly once.\n#[derive(Default)]\npub struct Registry {\n    pending: Mutex<HashMap<u64, oneshot::Sender<bool>>>,\n}\n\nimpl Registry {\n    /// Opens confirmation `nonce`; `None` if that nonce is already open.\n    pub fn open(&self, nonce: u64) -> Option<oneshot::Receiver<bool>> {\n        let mut pending = self.pending.lock().ok()?;\n        if pending.contains_key(&nonce) {\n            return None;\n        }\n        let (tx, rx) = oneshot::channel();\n        pending.insert(nonce, tx);\n        Some(rx)\n    }\n\n    /// Resolves `nonce` once; false for an unknown or already resolved one.\n    pub fn complete(&self, nonce: u64, accepted: bool) -> bool {\n        let sender = self.pending.lock().ok().and_then(|mut p| p.remove(&nonce));\n        sender.is_some_and(|tx| tx.send(accepted).is_ok())\n    }\n\n    pub fn is_pending(&self, nonce: u64) -> bool {\n        self.pending\n            .lock()\n            .map(|pending| pending.contains_key(&nonce))\n            .unwrap_or(false)\n    }\n\n    pub fn open_count(&self) -> usize {\n        self.pending.lock().map(|p| p.len()).unwrap_or(0)\n    }\n}\n\n/// Which reveal owns the one secret sheet. Every reveal takes a new\n/// generation; an older reveal's expiry or completion never ends or\n/// unregisters a newer reveal's sheet.\n#[derive(Debug, Default)]\npub struct SecretOwnership {\n    current: std::sync::atomic::AtomicU64,\n}\n\nimpl SecretOwnership {\n    pub const fn new() -> Self {\n        Self {\n            current: std::sync::atomic::AtomicU64::new(0),\n        }\n    }\n\n    /// A new reveal: it owns the sheet from now on.\n    pub fn begin(&self) -> u64 {\n        self.current\n            .fetch_add(1, std::sync::atomic::Ordering::SeqCst)\n            .wrapping_add(1)\n    }\n\n    /// Whether `generation` is still the sheet's reveal.\n    pub fn owns(&self, generation: u64) -> bool {\n        self.current.load(std::sync::atomic::Ordering::SeqCst) == generation\n    }\n}\n\n/// The same revocation check is used immediately before AppKit presentation\n/// and again in its explicit copy callback.\n#[derive(Clone)]\npub struct SecretCopyPermit {\n    lease: desktop_core::PresentationLease,\n    generation: u64,\n}\nimpl SecretCopyPermit {\n    pub fn allowed(&self, owner: &SecretOwnership) -> bool {\n        self.lease.is_current() && owner.owns(self.generation)\n    }\n}\n\n/// An admitted secret waiting for the main-thread queue. Its revocable owner\n/// is captured at admission; a refused callback cannot claim the sheet slot.\n/// Dropping a refused task zeroizes its key.\npub struct SecretPresentation {\n    label: String,\n    secret: zeroize::Zeroizing<String>,\n    lease: desktop_core::PresentationLease,\n}\nimpl SecretPresentation {\n    pub fn new(\n        label: String,\n        secret: zeroize::Zeroizing<String>,\n        lease: desktop_core::PresentationLease,\n    ) -> Self {\n        Self {\n            label,\n            secret,\n            lease,\n        }\n    }\n    pub fn run(\n        self,\n        owner: &SecretOwnership,\n        show: impl FnOnce(String, zeroize::Zeroizing<String>, SecretCopyPermit),\n    ) -> bool {\n        if !self.lease.is_current() {\n            return false;\n        }\n        let permit = SecretCopyPermit {\n            lease: self.lease,\n            generation: owner.begin(),\n        };\n        if !permit.allowed(owner) {\n            return false;\n        }\n        show(self.label, self.secret, permit);\n        true\n    }\n}\n\npub struct ConfirmationPermit {\n    lease: desktop_core::PresentationLease,\n    nonce: u64,\n}\nimpl ConfirmationPermit {\n    pub fn complete(&self, registry: &Registry, accepted: bool) -> bool {\n        registry.complete(self.nonce, accepted && self.lease.is_current())\n    }\n}\n/// Production queue entry shared by AppKit and deterministic host regressions.\npub struct ConfirmationPresentation {\n    nonce: u64,\n    request: desktop_core::ConfirmationRequest,\n    lease: desktop_core::PresentationLease,\n}\nimpl ConfirmationPresentation {\n    pub fn new(\n        nonce: u64,\n        request: desktop_core::ConfirmationRequest,\n        lease: desktop_core::PresentationLease,\n    ) -> Self {\n        Self {\n            nonce,\n            request,\n            lease,\n        }\n    }\n    pub fn run(\n        self,\n        registry: &Registry,\n        show: impl FnOnce(u64, desktop_core::ConfirmationRequest, ConfirmationPermit),\n    ) -> bool {\n        if !self.lease.is_current() || !registry.is_pending(self.nonce) {\n            registry.complete(self.nonce, false);\n            return false;\n        }\n        show(\n            self.nonce,\n            self.request,\n            ConfirmationPermit {\n                lease: self.lease,\n                nonce: self.nonce,\n            },\n        );\n        true\n    }\n}\n\n/// The receiver side of a confirmation: false if it was dropped.\npub async fn outcome(receiver: Option<oneshot::Receiver<bool>>) -> bool {\n    match receiver {\n        Some(rx) => rx.await.unwrap_or(false),\n        None => false,\n    }\n}\n\n#[cfg(target_os = \"macos\")]\npub use appkit::{NativeConfirmation, NativeSecrets};\n\n#[cfg(target_os = \"macos\")]\nmod appkit {\n    #![allow(unsafe_code)]\n\n    use std::cell::RefCell;\n    use std::collections::HashMap;\n    use std::sync::Arc;\n\n            *current = Some(variant);\n        }\n        if app.menu().is_some() {\n            let _ = menu::rebuild(app, variant);\n        }\n    }\n\n    /// The presentation the Go menu was last reconciled with.\n    pub fn menu_variant(&self) -> Option<desktop_core::features::UiVariant> {\n        self.menu_variant.lock().ok().and_then(|v| *v)\n    }\n\n    /// Forwards a native menu selection to every live shell observation.\n    pub fn menu_command(&self, command: MenuCommand) {\n        let _ = self.menu.send(command);\n    }\n\n    /// Live observation tasks held for a webview.\n    pub fn active_observations(&self, webview: &str) -> usize {\n        self.observations\n            .lock()\n            .map(|o| {\n                o.tasks\n                    .iter()\n                    .filter(|t| t.webview == webview && !t.handle.inner().is_finished())\n                    .count()\n            })\n            .unwrap_or(0)\n    }\n\n    /// Core subscribers still registered (after pruning retired ones).\n    pub fn core_observers(&self) -> usize {\n        self.operator.observer_count()\n    }\n\n    /// Ends a webview's observations on page reload and window destruction.\n    /// The main page also loses its reviews and disclosures; admitted business\n    /// work and its remote outcomes remain observable by the replacement page.\n    pub fn retire_webview(&self, webview: &str) {\n        if webview == MAIN_WINDOW {\n            let _ = self.operator.retire_renderer();\n        }\n        if let Ok(mut observations) = self.observations.lock() {\n            observations.tasks.retain(|task| {\n                if task.webview == webview {\n                    task.handle.abort();\n                    false\n                } else {\n                    true\n                }\n            });\n        }\n    }\n\n    fn close(&self, webview: &str, token: &str) {\n        if let Ok(mut observations) = self.observations.lock() {\n            observations.tasks.retain(|task| {\n                if task.webview == webview && task.token == token {\n                    task.handle.abort();\n                    false\n                } else {\n                    true\n                }\n            });\n        }\n    }\n\n    /// Registers an observation task. Re-observing on the same channel token\n    /// replaces that task. At the per-webview cap the new observation is\n    /// refused (`Busy`); live observations are never silently evicted.\n    fn register(\n        &self,\n        webview: &str,\n        token: &str,\n        start: impl FnOnce(u64, Arc<Mutex<Observations>>) -> JoinHandle<()>,\n    ) -> Result<(), Refusal> {\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_29","type":"command_execution","command":"/bin/zsh -lc \"sed -n '1711,1996p' docs/planning/decisions.md; sed -n '2213,2390p' docs/planning/decisions.md; cat docs/planning/WORF-START-HERE.md\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_29","type":"command_execution","command":"/bin/zsh -lc \"sed -n '1711,1996p' docs/planning/decisions.md; sed -n '2213,2390p' docs/planning/decisions.md; cat docs/planning/WORF-START-HERE.md\"","aggregated_output":"## D048 — Harness desktop tools, project folder, approvals and proposals\n\nDecided in C21 (implementer decision for the C21 milestones, recorded for\nreview).\n\n**Desktop tools.** The engine is given one dynamic-tool namespace,\n`airs_desktop`, and nothing else of the desktop. Its tools are typed:\n- `inventory`, `detail`: the Runtime Security inventories C08 reads.\n  The DLP catalog is not offered.\n- `session`, `search`: C11's investigation reads. Session content is\n  already stripped by the management layer.\n- `redTeam`, `supplyChain`: C13's observation reads.\n- `scan`: one C03 scan with a profile named by the model, through the\n  tenant's own scan key.\n- `cases`: the C12 library's names and expectations.\n- `proposeChange`: stages a change for the operator to review (below).\n\nEvery call goes through the same admission as the operator's own reads:\n`admit_management`, `admit_scan` and the library. The call runs under the\nconversation's context and is refused once that context is stale. The\ndesktop holds the credentials. Results are JSON:\n- JSON carried as text is opened first: at most 4 layers deep and 4 MiB.\n  Text still encoded past those bounds is replaced by a note, never\n  passed on unchecked (P06, C21 reviews F2 and R2-F2);\n- field names that carry credentials are removed at any depth (14\n  names, case- and dash-insensitive);\n- the conversation's key is redacted;\n- a longer result becomes `{\"cut\": note, \"partial\": text}`, shortened\n  until the whole envelope, escaping included, fits 24 KiB (P06, C21\n  review R2-F4).\n\nA call is parsed into a closed set:\n- `deny_unknown_fields`;\n- arguments of at most 40 KiB, pages of at most 50 and scan text of at\n  most 16 KiB;\n- any credential-like argument name is refused.\n\nThe desktop runs a call only when it belongs to the turn being answered,\nand only once per call ID; a repeat is a protocol failure. Anything else\nis answered \"This tool or its arguments are unavailable.\" and nothing\nruns. At most 8 calls or approvals wait at a time. A call has 60 s, and\nthe engine's pending tool calls are dropped with the turn (interrupt or\nend). Each call carries its run and turn lease. When the turn ends, the\ncall is cancelled, and so is the runtime operation it admitted (P06, C21\nreviews F1 and R2-F1): queued work settles NotSent and sends nothing;\nwork already dispatched keeps its own outcome; no result is sent late. This follows C19's rule that a reply to a request the engine forgot\nis fatal.\n\n**Proposals, never Apply.** `proposeChange` accepts Runtime and DLP kinds\nonly, with create, update or delete. Gateway changes need the operator's\nown workspace review (C17). Before staging, the proposal passes the same\nstatic checks a review makes, through the tenant's management client\n(`changes::normalize`). Nothing is read or sent at that point.\n- A conversation holds at most 8 proposals, numbered `P-1`… The model is\n  told that nothing was applied.\n- Review opens the proposal with the operator's existing\n  `review_change`. It is refused (`Busy`) while any change review is\n  open, so the operator's own draft or review is never replaced.\n- Administration shows the opened review with the proposal's exact\n  draft, so Apply sends what was reviewed. Only the operator's\n  `RequestApply` and the native confirmation (C09) write.\n- A proposal reads `inReview` only while its review is the open one, then\n  `closed`. Dismissed proposals are hidden.\n\n**Project folder and access.** The operator chooses one folder per tenant\nin the native \"Choose project folder\" sheet. The folder is stored as\nnonsecret state with a write flag that is off by default. These folders\nare refused:\n- the home folder itself, and `.ssh`, `.aws`, `.gnupg`, `.config`, `.kube`,\n  `.docker`, `Library`, `.azure` and `.netrc` under it;\n- `/System`, `/usr`, `/bin`, `/sbin`, `/private/etc`, `/private/var/db`,\n  `/private/var/root`, `/Library`, `/Applications`, `/dev` and `/cores`;\n- this app's data root, and any folder containing it.\n\nThe folder and its access are part of the engine binding:\n- The bootstrap carries `projectPath` and `localAccess`\n  (`readOnly`/`workspaceWrite`).\n- The thread carries `cwd` and the `read-only` or `workspace-write`\n  sandbox.\n- Without a folder, the thread has no local environment.\n\nChanging the folder or its access retires the running conversation. A\nsaved conversation whose folder or access differs reads `otherProject` and\ncannot be continued: a new conversation is needed. Restoring a compatible\none restores no approval, and no command is run again.\n\n**Approvals.** The engine's command and file-change requests wait for the\noperator under the desktop's own token, 12 random bytes. A token is valid\nonly for that run and turn and is cleared at interrupt and at turn end, so\na stale or repeated decision is refused. A request is declined at once,\nwithout asking, when any of these holds:\n- there is no folder;\n- it is a file change while changes are off;\n- it asks for added permissions, network access or another root;\n- it belongs to another turn;\n- what it would do cannot be shown whole: a command longer than 8 KiB (or\n  none), or a file change whose every file is not named whole (none\n  named, a change without a path, more than 64 files or a path past\n  1 KiB) (P06, C21 reviews F3 and R2-F3: never shown cut or partial);\n- 8 decisions are already waiting.\n\nThe pinned engine's own desktop sandbox enforces the rest. The negative\nprobes are recorded:\n- one process, with exec replacement only, so children and pipelines fail\n  with \"fork: Operation not permitted\";\n- no network;\n- reads outside the folder fail with \"Operation not permitted\";\n- writes only inside the folder, and only with `workspaceWrite`.\n\nThe engine's own patch writer (`apply_patch`) names its files only with\nthe change item, which may reach the desktop before or after the approval\nrequest. Asked first, the request is declined at once; asked after, the\napproval shows the named files whole. Approved, the patch still fails to\nwrite in this build: it runs in the engine's narrower helper sandbox (the\nengine is not changed). Allowed shell commands are what change the folder.\nBoth orders are exercised (harness_tools, native C21-N04).\n\n**Renewal with changes allowed.** When a company sign-in renewal\n(D047) would restart an engine that may change the folder, the message is\nheld (`confirmWrite`). Allow renews, restarts and restores with the same\naccess, then sends. Not now gives the message back, and nothing is\nrestarted, restored or sent.\n\n**Out of scope here:** MCP servers and their token rotation (C22);\nimported history (C23); live management, Gateway and model qualification\n(C25).\n\n## D049 — Workspace MCP servers for the Harness: catalog, desktop OAuth, grants and approval\n\nDecided in C22 (implementer decision for the C22 milestones, recorded for\nreview).\n\n**Catalog.** The chosen Gateway workspace's MCP servers are read through\nthe tenant's management client, as one more scoped Gateway read:\n- `GET /mcp-servers?workspace_id`, zero-based pages of 100, at most five.\n- Only the workspace's own servers are kept.\n- A server's URL must be HTTPS with a host and no credentials, query or\n  fragment. It is kept as the `url` crate canonicalizes it, which is what\n  the engine stores.\n- Repeated IDs are dropped, and the upstream (`mcp_integration_url`) is\n  never kept.\n\nA server's revision is SHA-256 over a versioned domain and the\nlength-prefixed ID, slug, URL, status and update time. Its engine namespace\nis derived from its slug, as v1 derived it. A shared or reserved name gets a\nsuffix from the server's ID hash, wide enough to tell the group apart, so\nthe result does not depend on catalog order. An ID the engine cannot take\nis shown and never granted.\n\n**Sign-in is the desktop's, never the engine's.**\n- The server must answer an unauthenticated `initialize` with `401` and a\n  `resource_metadata` challenge on its own origin.\n- The protected-resource metadata (RFC 9728) must name exactly the URL.\n- Its authorization server must be on the same HTTPS origin, and that\n  server's metadata (RFC 8414) must name itself. It must offer the code\n  flow with S256 and a public client (`none`) and client registration, and\n  keep every endpoint on that origin.\n- A client is registered for each attempt (RFC 7591).\n- The browser goes to authorize with:\n  - PKCE S256 and a 256-bit `state`;\n  - `resource` set to the URL (RFC 8707);\n  - the shared one-attempt `127.0.0.1` loopback (D047);\n  - only `mcp:servers:read`, `mcp:tools:list` and `mcp:tools:call`, as\n    offered (never a wildcard).\n- The code is exchanged, and later refreshed, with `resource`.\n- Replies are at most 64 KiB and redirects are refused.\n- An access token must be a bearer of 16-16384 visible ASCII bytes, as the\n  engine requires.\n- These requests are written by hand over the app's own client, like\n  D047's: `oauth2`/`openidconnect` do not cover RFC 9728/8414/7591 discovery\n  and registration, and D028's reasons hold.\n\n**Grants.** A sign-in is a grant: a new UUID bound to the server's URL and\nrevision at that moment. Its tokens, issue time and expiry are a Keychain\nitem.\n- Writing it, and each rotation, follows the full credential-store\n  contract. The record joins the cleanup ledger, confirmed durable, and is\n  reserved as in flight before it is written. It leaves the ledger only in\n  the save that names it, so a stale or failed write is never left\n  untracked.\n- The in-flight reservation ends under the same lock as that settlement\n  (P06, C22 review F4), so cleanup can never delete a record between its\n  write and the save that names it. Company sign-in (D047) uses the same\n  functions.\n- A refresh renews inside `min(120 s, lifetime/2)` and rotates the item.\n  One renewal runs at a time per grant, and it completes even if its caller\n  goes away.\n- Signing out, removing the tenant or resetting deletes the item through\n  the ledger, then revokes both tokens at the server (best effort).\n- Signing out of a server also ends a sign-in to it that is under way\n  (P06, C22 review F3). A late callback or token reply then installs\n  nothing, and its tokens are revoked.\n\n**A conversation's scope** is fixed at its start:\n- the servers turned on (at most eight per workspace) that are in the\n  loaded catalog, in catalog order;\n- each with its grant only if that grant was made for the server's current\n  URL and revision.\n\nWith any server on, the catalog must have been read successfully, with no\nread under way, or nothing starts (`Busy`). A failed or pending read keeps\nthe last catalog for display only (P06, C22 review F2). Until a read\nsucceeds:\n- no conversation starts or continues from history (`otherMcp`);\n- a running conversation sends nothing (its message stays in the box);\n- every MCP approval is declined natively.\n\nA changed revision or URL in the last catalog read still retires the\nconversation.\nThe bootstrap carries `mcpServers` in scope order. Each server gets its\ntoken, or the 32-byte placeholder `airs-desktop-mcp-sign-in-expired` when\nthere is no current sign-in, so the scope stays the same and that server\nfails to start while inference goes on. The receipt must echo exactly the\nscope's `{name, serverId}` in order. Tokens that do not fit the 64 KiB frame\nfail the start with `mcpTooLarge` and are never truncated.\n\n**What retires a conversation.** Any of these retires a conversation whose\nscope holds the server:\n- signing out;\n- signing in again (a new grant, even for the same URL);\n- turning the server off;\n- a new catalog revision or URL;\n- removing the tenant.\n\nAn expired sign-in does not. Grants and revisions are not in the engine's\ncontext, so the desktop checks them, as D048 checks the folder.\n\n**Approval.** An elicitation from the engine is held for the operator only\nwhen all of these hold:\n- it is form mode, with `codex_approval_kind: mcp_tool_call`;\n- its `airs_desktop_item_id` names an `mcpToolCall` the engine started in\n  this turn, on the same server, for a server in the scope;\n- that call has not been asked before;\n- the server holds a current token;\n- fewer than eight decisions are waiting.\n\nThe card shows the server, the tool and the arguments of the call as the\nengine started it, never the request's own `_meta`. Anything else is\ndeclined at once with a transcript notice; the engine's reserved-key\nforgeries never arrive. The operator's Approve once or Decline is sent as\nexactly `{\"action\":\"accept\"}` or `{\"action\":\"decline\"}`. When an approval\nis decided, the desktop checks again that the server's grant is the scope's\nand is unexpired, both by failure and by the token's own expiry against\nthe clock (P06, C22 review F1). A call held across expiry, sleep\nincluded, or first offered after it, is declined whatever the operator\nchose. Pending\napprovals end with the turn or an interrupt, and no late reply is sent.\nCalls, results and errors are bounded, and every token is redacted.\n\n**Rotation.** Before a message, the scope's tokens are renewed when one is\ninside its margin. Only if what the engine holds changed (a fingerprint\nover the server IDs and tokens) is it restarted, restoring the last export\nand then sending. An MCP-only rotation keeps the conversation's confirmed\naccess to its folder (D048). When the Gateway credential is renewed too,\none restart does both and D048's re-confirmation applies.\n\n**History.** A saved conversation records its scope. One whose scope\ndiffers from what a new conversation would get now, or cannot be checked\nbecause the catalog is not loaded, reads `otherMcp` and cannot be\ncontinued.\n\n**Offline and reconnecting (T23).** A turn that a stop (sleep, quit or\nending the conversation) cuts short while it is open is saved as it\nstood. This includes a turn whose call has settled while it waits for the\nmodel's next answer (C22 review R3-F1). Its unfinished\nentries read `interrupted`, so an approved call that may have run at the\nserver is recorded with an unknown outcome. The record keeps the last\nexport, which does not hold that turn, so continuing restores only what\nthe engine had (P06, C22 review G1). With no export (the first turn, or\nafter one was refused) it is saved without a restore point. It reads\n`notRestorable` and can be read and exported but never continued, so no\ncontext is invented (C22 review R2-F1). Pending MCP approvals and calls live\nonly with the conversation in memory. A relaunch, offline or not, never\nrestores, re-asks or resubmits them. Servers' enablement and sign-ins are\nkept (the state document and the Keychain), and nothing is called until\nthe operator starts a conversation again (P06,\n`a_pending_mcp_call_never_survives_going_offline_or_runs_on_reconnect`).\n\n**Fixtures.** The integration tests and the native driver serve the MCP\nplane over loopback HTTPS that the engine trusts through the app's own\nroots (`CODEX_CA_CERTIFICATE`). The engine's `--allow-http-loopback` is\nnever passed.\n\n**Out of scope here:** v1 history and MCP-state import (C23); live\nGateway MCP sign-in, denial, refresh and revocation qualification (C25).\n\n## D051 — Local redacted diagnostics: typed events, retention, export and reset\n\nDecided in C24 (implementer decision for C24 milestone 3, recorded for\nreview; it implements D021).\n\n**What is kept.** Typed events only, each a fixed name, a code or a number:\n- the app started (its version, whether it is a fixture build);\n- a request was admitted, or refused with its refusal code (the request's\n  kind, never its contents: `Intent::kind` names the variant without\n  formatting it);\n- the saved document could not be read (its health);\n- a reset finished or failed at a stage;\n- the app panicked, with its source location only (a Rust source file of\n  this repository, relative, lower case, and its line; any other location,\n  a dependency's or the standard library's, is recorded as `external` with\n  line 0, since such a path can name the build machine's folders). Never\n  the panic message: it may hold anything;\n- the operator cleared the diagnostics.\n\nEvery field is checked against the values the app records for that event,\nwhen it is recorded and again when a line is read back or exported:\n- a request kind is one of `INTENT_KINDS`, which the same table as\n  `Intent::kind` generates, so the two cannot differ;\n- a refusal code, a storage health and a reset outcome (`done`, or\n  `failed-` and a reset stage) are the serialized names of those enums'\n  variants, each listed beside an exhaustive match so a new variant does not\n  build until it is listed;\n- a version is `major.minor.patch` in digits;\n- a panic location is `external` or a repository source file as above.\n\nA character set alone is not taken as redaction: a token-shaped canary, or a\nsingle ordinary word, in any field is never written, and a stored line that\nholds one (edited or foreign) is not exported, while the app's own events\nstay.\n\n**Where and how long.**\n- In macOS's logs folder for the app (`~/Library/Logs/<identifier>`), apart\n  from the work in the data folder; 0700 folder, 0600 files, never through\n  a link. Fixture builds keep it under their data root (`fixture-logs/`),\n  which acceptance runs remove.\n- Two files of at most 256 KiB each: the current file is rotated once full\n  and replaces the previous one.\n- Lines older than 14 days are dropped when the app opens the log.\n- Writing never stops the app: a failure to write is ignored.\n\n**Export and clearing.**\n- Nothing leaves the Mac by itself. There is no network sink, crash\n  reporter or analytics anywhere in the app (D021).\n- Settings › Diagnostics states what is kept and for how long, with the\n  count. Export saves a JSON document (schema, app version, fixture flag,\n  export time, events) through the native save sheet, re-checking every\n  line; an edited or foreign line is not exported.\n- Clear removes every line, keeping only the record of clearing. If a file\n  cannot be removed, what it holds is counted again from disk (and still\n  exported), no clearing is recorded, and the view says the clearing did\n  not remove everything (`clear: failed`); a later clearing that can\n  removes it.\n- Local-data reset removes the folder with the rest of the data; the reset's\n  own outcome is the first new line.\n\n**Out of scope here:** diagnostics from the presentation (it logs nothing),\nsystem logs macOS keeps on its own, and uploading anything (never).\n\n## D052 — C25 scope reduction: Gateway workspace provisioning (W37, W39)\n\nOwner decision, 2026-10-25, recorded in C25.\n\n**Reduced:** the live requirement of L08's workspace provisioning, the IAM\nscope binding step of W37 and its cleanup in W39, is withdrawn from C25.\nEvery other part of L08 stays required and passed live: route create,\nupdate and delete, and service key create, rotate and delete.\n\n**Why:** Redtail's IAM refuses the binding with HTTP 400 `invalid\nresource_type: workspace`, on PUT and on POST. The request is the SDK's\nexact binding (`resource_type: workspace` and the workspace slug, as every\nexisting binding in the tenant has), and the service account is superuser\non the tenant and on every scope. So no access the owner can grant unblocks\nit; the existing bindings were made by the Gateway console. The app's\npartial-result handling was itself shown live: the scope and workspace it\ncreated were kept, reported and reconciled (`evidence/C25/live/reconciliation.jsonl`).\n\n**Not reduced:** the source, fixture and native evidence for W37 and W39\n(C17), and the row's live requirement in any later release once the service\naccepts the binding.\n\n## D053 — C25 scope reduction: five blocked live checks\n\nOwner decision, 2026-10-25, recorded in C25 (\"drop it\" for each). The live\nrequirement of these checks is withdrawn from C25. Their source, fixture\nand native evidence stays required and is unchanged; each returns as a live\nrequirement in a later release once its cause is gone.\n\n| Row | Check | Why it could not pass |\n|---|---|---|\n| W49 | L11-account-switch | No second Academy test learner exists. Sign-in, protected admission and sign-out with revocation passed live |\n| W56 | L14-access-change-denied | Denial needs an entitled course whose access is withdrawn during the run; the course download under its lease and the local draft passed live |\n| W48 | L17-scope-change | Changing the shared `strata-cloud-manager` server's scope or grant is outside the `airs-v2-c25-*` change scope. Discovery, OAuth sign-in and revocation passed live; tool calls, approval, denial and refresh stay with the signed app (C26) |\n| W14 | L04-data-profile-replace | The DLP service answers HTTP 400 to every data profile and data pattern read or write by ID, predefined profiles included |\n| W15 | L04-filtering-profile-replace | The SDK request contract refuses the values the service stores (`direction` `c2s`/`s2c`, lower-case `log_severity`); an SDK follow-up. The app's own defect here (editing as read) was fixed and shown natively (C25-N01) |\n\n## D054 — scm-sdk 0.2.4\n\nOwner direction, 2026-10-25, recorded in C25 (\"my scm sdk is on 0.2.4 …\nupdate it\"). desktop-core pins `scm-sdk = \"=0.2.4\"` (crates.io), replacing\n0.1.0. The app built against it unchanged; the notice inventory was\nregenerated; every suite, the C25 gates and the operator-free live families\nran again on it. The upgrade did not change the two SDK contract\nmismatches C25 recorded (filtering profile `direction` and `log_severity`;\na cached Gateway stream chunk without `finish_reason`), which stay SDK\nfollow-ups.\n\n## D055 — C25 review attempt-01: deferrals and a waived cleanup\n\nOwner decisions, 2026-10-25, recorded after Codex C25 attempt-01.\n\n1. **L16 and L17's Harness-run checks are C26's.** L16 (the Harness over\n   Gateway inference, key and company sign-in, history and proposals; rows\n   W42–W45) and L17's MCP tool call, native approval, denial and refresh\n   (W48) run inside the Harness engine, which runs only in the signed app.\n   C25 does not claim them. They are required in C26's signed-app\n   acceptance and must pass there before a stable release; this is a\n   deferral, not a reduction.\n2. **The inactive `airs-v2-c25-profile` cleanup is waived.** The service\n   omits inactive profiles from every list and no endpoint finds one by\n   name; the owner looked in the console too. It is an inactive, unused\n   test profile in Redtail. The reconciliation log records the waiver.\n3. **W56's live explicit lab submit is withdrawn from C25.** It would\n   leave a graded submission on the owner's Academy account. Its source,\n   fixture and native evidence stay required; the download under lease,\n   the local draft and sign-out with revocation passed live.\n\n## D056 — Academy live follow-ups move to 2.1.0; stable is 2.0.0\n\nOwner decisions, 2026-10-25 (\"i don't care about the academy flows for\nnow, mark it as a followup in version 2.1.0, let's instead focus on\nshipping 2.0.0\"; the release version chosen as 2.0.0).\n\n1. **The stable release is 2.0.0.** The earlier 0.2.0 build, signed and\n   notarized, is the previous version for C26's manual update and\n   rollback checks.\n2. **C25-R2-F1 and C25-R2-G1 are 2.1.0 follow-ups.** They are interactive\n   live Academy flows for W53 (an exam started) and W65 (the Daily Incident\n   started and answered), and live runs asserting each Academy call's own\n   result. That result is the inline check's grading verdict, progress\n   cleared by a course reset, and certificates unchanged across it. The\n   runner already supports these assertions (`call.*` entries take\n   `?? <pointer> …` expectations, tested); the 2.1.0 work designates and\n   runs them. C25 stays complete at its D034 chunk gate. The P08 phase\n   sign-off does not raise C25 on these items.\n\n## D057 — C26 attempt 01: installed-acceptance defects and the Git rule\n\nC26 installed acceptance, attempt 01 (airsTest, 2026-10-26, record in\n`evidence/C26/installed/attempt-01/record.json`) passed install, signature,\nnotarization, staple, engine pin, update (U1, U2) and F01–F03 on the\nreal 2.0.0 bytes, and failed F04, F05 and F06. The tester stopped there;\nF07–F09, tamper and rollback did not run. C26 is not complete on this\nattempt; the defects are fixed, a new signed build is produced, and the\nwhole kit is run again.\n\n1. **F04 (Gateway Playground).** Text fields written without classes had\n   no visible edge after Tailwind's reset, so the endpoint, key and prompt\n   fields could not be seen. Fixed app-wide by a zero-specificity base\n   style for text fields, selects and text areas; the Run button now says\n   what is missing, and the Inference prerequisites tab reflects the\n   stored key instead of stale copy.\n2. **F05 (Harness company sign-in).** Company sign-in was reachable only\n   after tenant, management client and Gateway workspace, and nothing\n   before that mentioned it. The Harness now shows a \"what you need first\"\n   checklist, an always-visible company sign-in section (disabled with its\n   reason until a workspace is chosen) and specific save refusals.\n3. **F06 (API Client).** Revises the D040 rule \"a new collection\n   is created only inside a Git repository (v1)\": Git is optional. A new\n   collection can be created in any folder the user chooses; opening an\n   empty folder initialises a collection there; a non-empty folder without\n   `collection.toml` is still refused, now visibly, with a next step. The\n   Git tab works unchanged when the collection is inside a repository.\n\n# Continue the current desktop work in the Worf VM\n\nThis is the 2026-11-01 continuation guide. It supersedes the old sibling\n`p09-queue/handoff` instructions about Geordi, rsync and the older C44 worktree.\nThe target is the existing macOS VM on **Worf**. Kirk's local Tart VM `airs`\nwas only a bootstrap experiment; it produced no passing P09 native acceptance.\nIts Python permission prompt is not a prerequisite for this Git migration.\n\n## Get the current source\n\nFrom an empty development directory in the Worf VM:\n\n```sh\ngit clone --branch main ssh://git@git-ssh.cdot.io/cdot/prisma-airs-desktop-v2.git\ncd prisma-airs-desktop-v2\ngit lfs install --local\ngit lfs pull\npython3 -I tools/p09/verify-migration.py\ngit rev-parse HEAD origin/main\n```\n\nFor an existing clean clone, use `git fetch origin`, `git switch main`,\n`git pull --ff-only origin main`, then `git lfs pull` and the same verification.\nPreserve local modifications before changing an existing checkout.\nThe verification checks the latest application/tooling source, all 221 previously\npending main files, every retained worktree file mapping, required commit ancestry\nand the historical L19 executable. It intentionally describes this migration\ncheckpoint; later intentional implementation changes will change its hashes.\n\nAll chunk branch tips are retained as remote branches. C37/C39/C39b/C40/C41/\nC42/C43/C44 were already merged. The C29 live and C44 scope commits were applied\nas equivalent cherry-picks. The older `p09-merge` history and detached dry merge\nare preserved as refs rather than replacing the newer integrated source.\nThe audit and exact file mapping are in\n[worktree-preservation/2026-11-01](worktree-preservation/2026-11-01/README.md).\nNo original worktree was deleted or reset.\n\n## Prepare build inputs\n\nUse macOS Apple Silicon with a logged-in GUI account and Xcode Command Line\nTools/Swift. The contracted toolchain is Rust **1.99.0** (rustfmt, clippy,\n`aarch64-apple-darwin`), Node **24.21.0** in its NVM directory, pnpm **10.6.5**,\nPython 3, and Git LFS. Install those in the VM before running the following:\n\n```sh\nmkdir -p .tools/bin\ncorepack enable pnpm --install-directory .tools/bin\nexport PATH=\"$PWD/.tools/bin:$HOME/.cargo/bin:$HOME/.nvm/versions/node/v24.21.0/bin:/usr/bin:/bin:/usr/sbin:/sbin\"\ncargo fetch --locked\ngit clone --branch v2/desktop-presentation ssh://git@git-ssh.cdot.io/cdot.io/ai-security-academy.git ../ai-security-academy\ncargo run --locked -p xtask -- fetch-inputs --source ../ai-security-academy\ncargo run --locked -p xtask -- shared-prepare --input .inputs/academy --scratch .work/academy\npnpm install --frozen-lockfile --ignore-scripts\npnpm --dir .work/academy install --frozen-lockfile --ignore-scripts\ncargo run --locked -p xtask -- shared-lifecycle --allowlist docs/architecture/shared-lifecycle.json --scratch .work/academy\npnpm --dir .work/academy exec playwright install chromium --only-shell\n```\n\n`fetch-inputs` uses the locked Academy commit **532809aa4bb2e1484e11ca9f7a414328260c7901**,\nnot the evolving branch tip. Keep the input lock unchanged for the move.\nThe Rust SCM SDK is the locked crates.io dependency; the Harness is the pinned\nrepository LFS archive. Neither needs an external source worktree. Recreate\nbuild/dependency directories here; do not restore Kirk's absolute symlinks.\n\nUse **Terminal.app** as the guest GUI execution context. Resolve its actual\nAccessibility/System Events permission prompts in the VM. A 1920×1200 display\nis suitable for the native matrix. Configure the Codex CLI/model in the VM for\nfresh read-only reviews; host authentication files are not part of this transfer.\nThe owner's planning skill is preserved at `tools/p09/skills/grill-me/SKILL.md`\nand can be installed under the guest's `~/.codex/skills/grill-me/`.\n\n## Exact current standing and next work\n\n- **C44 attempt-05: 9/9/9/9/9**, no required fixes/blockers/gaps; merged. Its\n  opaque collection scope, render-time stale-editor retirement, packet isolation\n  and complete legacy-map guard are in current source.\n- **L19: actual Vulture wizard verification passed** on attempt-03 after the\n  separately approved local credential correction. The original two reads and\n  separately approved third are charged, with **no remaining live allowance**.\n  Do not repeat the live probe. Redacted receipts and the exact historical\n  executable (LFS) are retained; raw build paths/receipts/verdicts are unchanged.\n- **C29 attempt-07: 9/9/9/8/8**, no blockers, accepted under D034 with R1/R2/E1/E2.\n  Commit `03e572be` restores Gateway/key setup, rejected/fixed/stale verification,\n  keyed Cancel/Keychain cleanup, relaunch/import/confinement checks and the full\n  **24-behavior, 48-row** wizard matrix. Syntax and completeness-map checks pass.\n  The new native flow has **not** passed yet.\n- **P09 check attempt-02: all 18 checks passed** on unchanged inputs (541 frontend\n  tests, 15 live-scope tests, 57 synthetic live-run tests, four L19 driver tests).\n  Those records are Kirk history. The current app/build inputs match those tested\n  bytes, including the owner work now committed for this move.\n- C30/C31/C32 still need their predecessor-dependent re-reviews after C29 reaches\n  full 9. The P09 phase review follows full native/check/member completion.\n\nArchive the retained Kirk P09 preparation/incomplete native generation in a new\nhistory directory before creating the Worf generation. Keep all verdict folders\nimmutable and choose fresh check/review attempt IDs. Then run:\n\n```sh\ncargo run --locked -p xtask -- native-prepare --phase P09 --target aarch64-apple-darwin --features test-fixtures\npython3 -I docs/planning/evidence/P09/native-controller/run-p09-native.py c36\npython3 -I docs/planning/evidence/P09/native-controller/run-p09-native.py c43\n```\n\nC36 proves the guest driver context; C43 proves the restored C29 native coverage.\nContinue the other required drivers serially using the retained native controller\nplan and assertion requirements. Every record must bind the newly prepared\nexecutable. C44's cumulative driver runs last. Historical C24-N06 and C31-N01/N04\naggregates remain superseded as the map states; their old raw failures are not\nrewritten or counted as passing checks.\n\nUse a fresh P09 check attempt (next currently `attempt-03`) and the portable\nhelpers in [tools/p09](../../tools/p09/README.md) for C29 attempt-08, then C30,\nC31 and C32 in order. Report every actual score and apply D034's 8-then-9 rule.\nThe copied phase packet builder is explicitly a disabled draft; finish its\ncurrent-P09 native/predecessor verification before using it for the phase review.\nC26 still requires the documented manual review fallback; do not manufacture\ncontroller completion.\n\nAfter the P09 phase passes at 9, execute the owner-approved\n[C45/P10 brief](C45-draft.md): Prisma AIRS Desktop, version 1.0.0,\n`io.cdot.airs-desktop` / `.fixture`, fresh setup with no alpha/v2 migration,\nlegacy/variant/import cleanup, chunk 8→9 and phase 9. C45 has not started.\nThe preserved pending 2.0.0 version/release work is superseded at that later\nchunk, not silently renamed during migration. October C26 installed/signing\nrecords and `docs/release/2.0.0.md` are historical/draft; pushing source neither\npublishes a release nor clears their remaining gates.\n\nPrivate live manifests, Keychains, CLI tenant TOMLs, signing keys and authentication\nprofiles stay outside Git. They are not needed for the next fixture gates.\n","exit_code":0,"status":"completed"}}
