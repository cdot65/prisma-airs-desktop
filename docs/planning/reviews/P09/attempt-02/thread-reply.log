{"type":"item.started","item":{"id":"item_31","type":"command_execution","command":"/bin/zsh -lc \"cat apps/desktop/src/app.tsx | head -230; sed -n '1,260p' apps/desktop/src/v2/workbench/api-client.tsx; cat apps/desktop/src/v2/academy/academy.tsx; rg -n '\"'^#|P09|attempt-02|attempt-01|C31|C32'\"' docs/planning/status.md | tail -65\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_31","type":"command_execution","command":"/bin/zsh -lc \"cat apps/desktop/src/app.tsx | head -230; sed -n '1,260p' apps/desktop/src/v2/workbench/api-client.tsx; cat apps/desktop/src/v2/academy/academy.tsx; rg -n '\"'^#|P09|attempt-02|attempt-01|C31|C32'\"' docs/planning/status.md | tail -65\"","aggregated_output":"import { useCallback, useEffect, useLayoutEffect, useRef, useState } from 'react'\nimport {\n    DeliveryOutcomeUnknown,\n    type DesktopClient,\n    type FeatureId,\n    type Intent,\n    type MenuCommand,\n    type Refusal,\n    type ShellSnapshot,\n    type Theme,\n} from '@prisma-airs/desktop-contracts'\nimport { followAppearance } from './shell/appearance'\nimport { type DispatchOutcome, outcomeMessage } from './features/tenants/dispatch'\nimport { V2Shell } from './v2/v2-shell'\nimport { Wizard } from './v2/wizard/wizard'\nimport { deliveryContext, useShellStore } from './v2/store'\nimport { SHELL_COPY } from './v2/copy'\nimport { forgetAcademyPresentation } from './features/academy/presentation-storage'\nimport { SAVE_DOCUMENT_EVENT } from './v2/workbench/request-editor'\n\nexport function App({ client }: { client: DesktopClient }) {\n    const [snapshot, setSnapshot] = useState<ShellSnapshot | null>(null)\n    const snapshotRef = useRef<ShellSnapshot | null>(null)\n    snapshotRef.current = snapshot\n    const [failure, setFailure] = useState<string | null>(null)\n    const [pending, setPending] = useState(false)\n    const [status, setStatus] = useState('')\n\n    const dispatch = useCallback(\n        async (intent: Intent): Promise<DispatchOutcome> => {\n            try {\n                const response = await client.dispatch(intent)\n                return response.outcome === 'refusal'\n                    ? { kind: 'refused', refusal: response.refusal }\n                    : { kind: 'admitted', operation: response.receipt.operation }\n            } catch (error) {\n                return error instanceof DeliveryOutcomeUnknown ? { kind: 'unknown' } : { kind: 'failed' }\n            }\n        },\n        [client]\n    )\n\n    // v2 (C28): navigation is Rust-owned. The native menu, the sidebar and\n    // the palette all dispatch `navigate`; refusals reach the status surface.\n    const v2Navigate = useCallback(\n        async (feature: FeatureId) => {\n            useShellStore.getState().closePalette()\n            const intent: Intent = { kind: 'navigate', feature }\n            const outcome = await dispatch(intent)\n            if (outcome.kind === 'refused') useShellStore.getState().toast(SHELL_COPY.toastRefused('Navigation', outcome.refusal), 'warn')\n            // Unknown delivery is kept inline with Retry; never an expiring toast alone.\n            else if (outcome.kind === 'unknown') useShellStore.getState().addUnconfirmed('Navigation', intent)\n            else if (outcome.kind === 'failed') useShellStore.getState().toast(SHELL_COPY.toastFailed('Navigation'), 'warn')\n        },\n        [dispatch]\n    )\n    // Every v2 action's outcome reaches the shell's surfaces (DESIGN-V2 §7):\n    // a refusal or failed delivery as a warn toast naming what was asked, an\n    // unconfirmed delivery inline with Retry, never replayed on its own.\n    const v2Act = useCallback(\n        async (what: string, intent: Intent, quiet: Refusal[] = []): Promise<DispatchOutcome> => {\n            // A context-bound action speaks for the tenant it was sent in (I2).\n            const boundContext = deliveryContext(intent)\n            // A normal switch refusal still names its intended destination,\n            // but an uncertain switch must not offer Retry in another scope.\n            const retryContext = boundContext ?? (intent.kind === 'selectTenant' ? snapshotRef.current?.active?.context ?? null : null)\n            const bound = boundContext !== null ? (snapshotRef.current?.active?.tenant ?? null) : null\n            const outcome = await dispatch(intent)\n            if (outcome.kind === 'refused' && quiet.includes(outcome.refusal)) return outcome\n            if (outcome.kind === 'refused') useShellStore.getState().toast(SHELL_COPY.toastRefused(what, outcome.refusal, outcomeMessage(outcome)), 'warn', undefined, bound, boundContext)\n            else if (outcome.kind === 'unknown') useShellStore.getState().addUnconfirmed(what, intent, retryContext)\n            else if (outcome.kind === 'failed') useShellStore.getState().toast(SHELL_COPY.toastFailed(what), 'warn', undefined, bound, boundContext)\n            return outcome\n        },\n        [dispatch]\n    )\n    const v2Preference = useCallback(\n        async (what: string, intent: Intent, quiet: Refusal[] = []) => {\n            await v2Act(what, intent, quiet)\n        },\n        [v2Act]\n    )\n\n    const onMenu = useRef<(command: MenuCommand) => void>(() => undefined)\n    onMenu.current = (command: MenuCommand) => {\n        // Native navigation dismisses the modal palette first so focus can\n        // move to the new page heading instead of behind an open dialog.\n        if (command.kind === 'navigate') void v2Navigate(command.feature)\n        else if (command.kind === 'commandPalette') useShellStore.getState().openPalette()\n        // ⌘T: the tenant switcher opens; nothing switches until chosen.\n        else if (command.kind === 'tenantSwitcher') useShellStore.getState().setSwitcher(true)\n        // The open API Client request saves (its editor listens).\n        else if (command.kind === 'saveDocument') window.dispatchEvent(new Event(SAVE_DOCUMENT_EVENT))\n        else void v2Preference('The appearance change', { kind: 'setAppearance', theme: command.theme })\n    }\n\n    useEffect(() => {\n        let stop: (() => void) | undefined\n        let cancelled = false\n        client\n            .observeShell({\n                onSnapshot: (next) => {\n                    // The shell's scope follows the snapshot before it renders: a\n                    // notification for another tenant or context is never surfaced.\n                    useShellStore.getState().setScope(next.active?.tenant ?? null, next.active?.context ?? null, next.switchBlocked?.review ?? null)\n                    setSnapshot(next)\n                },\n                onMenu: (command) => onMenu.current(command),\n                onError: () => setFailure('The desktop sent an unexpected update.'),\n            })\n            .then(\n                (unsubscribe) => {\n                    if (cancelled) unsubscribe()\n                    else stop = unsubscribe\n                },\n                () => setFailure('The desktop shell could not be observed.')\n            )\n        return () => {\n            cancelled = true\n            stop?.()\n        }\n    }, [client])\n\n    // A completed reset also forgets Academy's WebView presentation state\n    // (completion latches keyed by account); a stopped reset keeps it.\n    const storage = snapshot?.storage\n    const resetFailed = Boolean(snapshot?.resetFailure)\n    const previousStorage = useRef(storage)\n    useEffect(() => {\n        if (previousStorage.current === 'resetting' && storage !== 'resetting' && !resetFailed) {\n            forgetAcademyPresentation()\n        }\n        previousStorage.current = storage\n    }, [storage, resetFailed])\n\n    const appearance = snapshot?.appearance\n    // Apply the theme in the same commit as the snapshot, before paint, so\n    // the shell never shows a frame in the previous theme.\n    useLayoutEffect(() => (appearance ? followAppearance(appearance) : undefined), [appearance])\n\n    if (failure && !snapshot) {\n        return (\n            <main role='alert' className='text-academy-ink p-8'>\n                {failure}\n            </main>\n        )\n    }\n    if (!snapshot) {\n        return (\n            <main role='status' aria-live='polite' className='text-academy-ink-soft p-8'>\n                Starting Prisma AIRS Desktop…\n            </main>\n        )\n    }\n    if (snapshot.onboarding !== 'done') {\n        // First run: the wizard owns the window (D060: no alpha import; nothing leaves it before a tenant exists).\n        return (\n            <div data-v2-shell=''>\n                <Wizard\n                    snapshot={snapshot}\n                    dispatch={dispatch}\n                    observeManagement={(operation) => client.observeManagement(operation)}\n                    mode='firstRun'\n                    onClose={() => undefined}\n                    onNavigate={(feature) => void v2Navigate(feature)}\n                />\n            </div>\n        )\n    }\n    return (\n        <V2Shell\n            snapshot={snapshot}\n            appearancePending={pending}\n            status={failure ?? status}\n            onNavigate={(feature) => void v2Navigate(feature)}\n            onSetAppearance={(theme) => void v2Preference('The appearance change', { kind: 'setAppearance', theme })}\n            onSetShowCalls={(on) => void v2Preference('The preference change', { kind: 'setShowCalls', on })}\n            onSwitchTenant={(tenant, resolution) => {\n                // The target is captured now: a late refusal still names it. A\n                // pending-decision refusal is not a toast: the snapshot carries\n                // the guard the shell renders (I1).\n                const label = snapshot.tenants.find((t) => t.id === tenant)?.label ?? tenant\n                void v2Preference(SHELL_COPY.switchTo(label), { kind: 'selectTenant', tenant, resolution: resolution ?? null }, ['decisionPending'])\n            }}\n            onReadNow={() => {\n                // The palette's Read now is the same finite read of every chosen product (I4).\n                const active = snapshot.active\n                if (!active) return\n                const label = snapshot.tenants.find((t) => t.id === active.tenant)?.label ?? active.tenant\n                void v2Preference(SHELL_COPY.readOf(label), { kind: 'readTenant', context: active.context })\n            }}\n            onRetry={(what, intent) => void v2Preference(what, intent)}\n            onAct={v2Act}\n            dispatch={dispatch}\n            client={client}\n        />\n    )\n}\nimport { forwardRef, useEffect, useMemo, useRef, useState } from 'react'\nimport { createPortal } from 'react-dom'\nimport type { DocumentView, ImportNote, ShellSnapshot, WorkbenchView as WorkbenchState } from '@prisma-airs/desktop-contracts'\nimport type { Dispatch } from '../../features/tenants/dispatch'\nimport { type ObserveWorkbench, type WorkbenchCall, resultText, workbenchCall } from '../../features/workbench/workbench-call'\nimport { Btn } from '../controls'\nimport { Glyph } from '../icons'\nimport { Modal } from '../modal'\nimport { API_COPY as C, methodColor } from './copy'\nimport { type EditorHandle, RequestEditor } from './request-editor'\nimport { RequestTree, requestName } from './request-tree'\nimport { type Run, type Tool, ToolsSheet } from './tools-sheet'\n\nexport interface ApiClientProps {\n    snapshot: ShellSnapshot\n    dispatch: Dispatch\n    observe: ObserveWorkbench\n}\n\ntype Closing = { kind: 'tab'; id: string; name: string } | { kind: 'collection' }\nconst TOOLS: Tool[] = ['environments', 'secrets', 'schemas', 'import', 'git']\nconst faint = { color: 'var(--v2-faint)' }\nconst soft = { color: 'var(--v2-soft)' }\n// A chip never widens the title row: it shrinks and truncates within it (a 900-point window at 200% overflowed by its width).\nconst CHIP = 'flex h-8 max-w-full min-h-0 min-w-0 items-center truncate rounded-[7px] border text-[13px]'\nconst chipStyle = {\n    gap: 8,\n    padding: '0 12px',\n    borderColor: 'var(--v2-rule)',\n    background: 'var(--v2-paper)',\n    color: 'var(--v2-ink)',\n}\n\n/**\n * The API Client as R2App draws it (C41): the title row with the\n * Collection and Environment chips, the 286px request tree, the open\n * requests' tabs, the request line, sub-tabs and response pane, the\n * footer. New components over the workbench intents: the C14/C15\n * behaviour (local-first collections, drafts protected on this Mac,\n * reviewed tenant-credential changes, immutable history) is unchanged.\n * Rust owns each document's revision, conflicts and the private drafts;\n * nothing in this view sends a request by itself.\n */\nexport const ApiClient = forwardRef<HTMLHeadingElement, ApiClientProps>(function ApiClient({ snapshot, dispatch, observe }, ref) {\n    const call = useMemo(() => workbenchCall(dispatch, observe), [dispatch, observe])\n    const state = snapshot.workbench\n    const collection = state.collection\n    const tenant = snapshot.tenants.find((t) => t.id === snapshot.active?.tenant) ?? null\n    const [message, setMessage] = useState('')\n    const [offerNew, setOfferNew] = useState(false)\n    const [tool, setTool] = useState<Tool | null>(null)\n    const [menu, setMenu] = useState(false)\n    const [doc, setDoc] = useState<DocumentView | null>(null)\n    // Counts documents arriving from the core: the editor is keyed by it, so a reloaded document always starts a fresh\n    // editor (the same id and revision under one key kept the old editor's fields).\n    const [docSeq, setDocSeq] = useState(0)\n    const [notes, setNotes] = useState<ImportNote[]>([])\n    const loading = useRef<string | null>(null)\n    // Each load of the selected request has a generation; a result from an earlier load is obsolete (two selections\n    // in flight resolving out of order replaced the current request's document with the earlier one's).\n    const loadGen = useRef(0)\n    // A load that failed, by request id, with its reason: shown in place of the editor with Try again (no automatic retry).\n    const [loadFailure, setLoadFailure] = useState<{ id: string; relative: string; text: string } | null>(null)\n    const editors = useRef(new Map<string, EditorHandle>())\n    const [closing, setClosing] = useState<Closing | null>(null)\n    // The Collection chip: where focus returns when its menu or a tool it opened closes (the menu item is gone by then).\n    const chip = useRef<HTMLButtonElement>(null)\n\n    // A refusal stays shown until the next action that succeeds (a cancelled sheet keeps it).\n    const run: Run = async (request) => {\n        const r = await call(request)\n        const text = resultText(r)\n        if (text) {\n            setMessage(text)\n            setOfferNew(r.kind === 'refused' && r.problem.kind === 'project' && r.problem.detail === 'notCollection')\n        } else if (r.kind !== 'cancelled') {\n            setMessage('')\n            setOfferNew(false)\n        }\n        return r\n    }\n\n    // Closing protects the latest typing first. If that fails, or Rust still\n    // sees unprotected edits, the operator chooses: keep editing, or close\n    // and discard them.\n    const close = async (target: Closing, discard = false) => {\n        setClosing(null)\n        const handles = target.kind === 'tab' ? [editors.current.get(target.id)] : [...editors.current.values()]\n        if (discard) {\n            for (const h of handles) h?.abandon()\n        } else {\n            const kept = await Promise.all(handles.map((h) => (h ? h.flush() : Promise.resolve(true))))\n            if (kept.includes(false)) {\n                setClosing(target)\n                return\n            }\n        }\n        const r = await run(target.kind === 'tab' ? { kind: 'closeTab', id: target.id, discard } : { kind: 'closeCollection', discard })\n        if (r.kind === 'refused' && r.problem.kind === 'unprotected') {\n            setClosing(target)\n            return\n        }\n        if (r.kind === 'closed' || r.kind === 'done') {\n            if (target.kind === 'tab') editors.current.delete(target.id)\n            else editors.current.clear()\n        }\n    }\n\n    // Every document-producing call is a load bound to the collection it was asked of and to a generation; a reply\n    // from an earlier generation, or from a collection no longer open, is dropped (a late reply replaced the current\n    // request's document, or resurrected a closed one).\n    // Rust derives this opaque scope from the full root and collection id. The displayed folder is only a basename:\n    // two clones can have the same id and basename under different parents (attempt-05 R1).\n    const collectionKey = collection?.scope ?? null\n    const collectionRef = useRef<string | null>(collectionKey)\n    collectionRef.current = collectionKey\n    const selectedRef = useRef<string | null>(collection?.selected ?? null)\n    selectedRef.current = collection?.selected ?? null\n    // A cURL import's conversion report that arrived after the core had already selected its draft (the selection's\n    // own load superseded the import): kept for that draft, shown when its document shows.\n    const lateNotes = useRef<{ id: string; notes: ImportNote[] } | null>(null)\n    // The collection the shown document was loaded from: another collection's document is never reused for a request\n    // with the same id (attempt-03 R1).\n    const docCollection = useRef<string | null>(null)\n    type Load = { gen: number; asked: string | null; id: string | null; relative: string | null }\n    const beginLoad = (id: string | null, relative: string | null = null): Load => {\n        const gen = ++loadGen.current\n        loading.current = id\n        setLoadFailure(null)\n        return { gen, asked: collectionRef.current, id, relative }\n    }\n    /** Shows a load's document if the load is still current; a failure of a selected request's load is shown with its reason. */\n    const settleLoad = (load: Load, r: Awaited<ReturnType<WorkbenchCall>> | null, keepNotes: boolean): boolean => {\n        if (load.asked === null || load.asked !== collectionRef.current) return false\n        if (load.gen !== loadGen.current) {\n            // Superseded, but a current import's report is not lost: when the reply's document is the selected request\n            // (its snapshot came first and its own load took over), its notes are shown with that document.\n            if (keepNotes && r?.kind === 'document' && r.notes.length > 0 && selectedRef.current === r.document.id) {\n                // Shown now if that document is already up (the editor renders only for the selected document), else\n                // when its own load lands.\n                lateNotes.current = { id: r.document.id, notes: r.notes }\n                setNotes(r.notes)\n            }\n            return false\n        }\n        if (loading.current === load.id) loading.current = null\n        if (r?.kind === 'document') {\n            setDoc(r.document)\n            docCollection.current = load.asked\n            setDocSeq((n) => n + 1)\n            setNotes(keepNotes ? r.notes : lateNotes.current?.id === r.document.id ? lateNotes.current.notes : [])\n            if (lateNotes.current && lateNotes.current.id !== r.document.id) lateNotes.current = null\n            return true\n        }\n        // The failure names the request it was for: the core keeps the previous selection when a read fails, so a\n        // tree entry's failure must show without that request ever being selected.\n        if (load.id !== null && load.relative !== null && r?.kind !== 'cancelled') setLoadFailure({ id: load.id, relative: load.relative, text: (r && resultText(r)) ?? C.unknownFailure })\n        return false\n    }\n\n    const selected = collection?.selected ?? null\n    const selectedTab = collection?.tabs.find((t) => t.id === selected) ?? null\n    // The core's selection is followed when it changes, not re-asserted against the document shown: after + the\n    // draft is shown from the core's reply before the snapshot naming it selected arrives, and re-opening the\n    // previously selected request in between made the core select that one again (the draft's tab lost).\n    const followed = useRef<string | null>(null)\n    // Following is scoped to one open collection: closing it forgets the followed selection, so the same\n    // collection re-opened with its persisted selection opens that request again (the editor was left blank).\n    const collectionId = collectionKey\n    useEffect(() => {\n        // A collection boundary (closed, re-opened, or replaced by another collection) retires every load in flight\n        // (its reply is ignored), the loading marker and the document shown: the editor never shows one collection's\n        // fields under another, even when both select a request with the same id (attempt-03 R1), and the new\n        // collection's selected request is loaded afresh.\n        followed.current = null\n        loadGen.current += 1\n        loading.current = null\n        setLoadFailure(null)\n        setDoc(null)\n        setNotes([])\n        lateNotes.current = null\n    }, [collectionId])\n    // Opens a request (the selected tab, or a tree entry); only the latest load's reply counts.\n    const open = (tab: { id: string; relative: string }) => {\n        const load = beginLoad(tab.id, tab.relative)\n        void call({ kind: 'openRequest', relative: tab.relative }).then(\n            (r) => settleLoad(load, r, false),\n            () => settleLoad(load, null, false)\n        )\n    }\n    const openRef = useRef(open)\n    openRef.current = open\n    // The document whose editor is up: the editor owns newer fields and revisions, so once it has unmounted (the\n    // selection moved away) the retained DocumentView is obsolete and a return to that request reloads it from the\n    // core (the old snapshot remounted could be saved over a protected draft, or sent).\n    const editorFor = useRef<string | null>(null)\n    // The document whose editor was up and has since unmounted: obsolete, reloaded on return. A document that never\n    // had its editor up (an import's or a draft's reply shown ahead of its snapshot) is fresh and is reused.\n    const staleDoc = useRef<string | null>(null)\n    const editorUp = doc !== null && selectedTab !== null && doc.id === selectedTab.id\n    useEffect(() => {\n        if (!selectedTab || followed.current === selectedTab.id) return\n        followed.current = selectedTab.id\n        // A load of another request still in flight is obsolete once the selection moves on: its reply must not land.\n        if (loading.current !== null && loading.current !== selectedTab.id) {\n            loadGen.current += 1\n            loading.current = null\n        }\n        const reusable = doc?.id === selectedTab.id && docCollection.current === collectionId && staleDoc.current !== selectedTab.id\n        if (reusable || loading.current === selectedTab.id) return\n        // A stale document is not shown while its reload is in flight: remounted, its editor would start from the old\n        // fields and keep them when the fresh document arrived under the same key.\n        if (doc?.id === selectedTab.id) setDoc(null)\n        openRef.current(selectedTab)\n    }, [selectedTab, doc, collectionId])\n    // Recorded after the selection was followed, so that effect sees which editor was up before this render.\n    useEffect(() => {\n        if (editorUp && doc) {\n            editorFor.current = doc.id\n            staleDoc.current = null\n        } else if (editorFor.current !== null) {\n            staleDoc.current = editorFor.current\n            editorFor.current = null\n        }\n    }, [editorUp, doc])\n    const loaded = state.loaded\n    useEffect(() => {\n        if (!loaded) void call({ kind: 'load' })\n    }, [loaded, call])\n    // The collection menu closes on Escape (focus back on the chip) and on a click elsewhere.\n    useEffect(() => {\n        if (!menu) return\n        const onKey = (e: KeyboardEvent) => {\n            if (e.key !== 'Escape') return\n            setMenu(false)\n            chip.current?.focus()\n        }\n        const onClick = () => setMenu(false)\n        window.addEventListener('keydown', onKey)\n        window.addEventListener('click', onClick)\n        return () => {\n            window.removeEventListener('keydown', onKey)\n            window.removeEventListener('click', onClick)\n        }\n    }, [menu])\n\n    const where = collection ? (collection.builtIn ? C.chips.builtIn : collection.folder) : ''\n    const environment = collection?.environments.find((e) => e.name === collection.environment) ?? null\n\n    const band = (\n        <div\n            data-slot='page-header-v2'\n            className='flex shrink-0 flex-wrap items-end'\n            style={{\n                gap: 12,\n                padding: 'var(--v2-page-top) var(--v2-page-x) 18px',\n                borderBottom: '1px solid var(--v2-rule)',\n            }}\n        >\n            <div className='min-w-0'>\nimport { createContext, forwardRef, lazy, Suspense, useCallback, useContext, useEffect, useImperativeHandle, useMemo, useRef, useState } from 'react'\nimport { useQuery, useQueryClient } from '@tanstack/react-query'\nimport { createMemoryHistory, createRootRoute, createRoute, createRouter, Link, Outlet, redirect, RouterProvider } from '@tanstack/react-router'\nimport {\n    AssessmentIntroPage,\n    AssessmentPage,\n    CertificatePage,\n    CompletionMoments,\n    CoursePage,\n    currentCourseSlug,\n    DossierPage,\n    HomePage,\n    IdentityPracticalPage,\n    LEARNER_ACCOUNT_NAV,\n    LEARNER_NAV,\n    LearnerAccountPage,\n    LearnPage,\n    MyCertificatePage,\n    NotificationsPage,\n    OnboardingPage,\n    OrientationPage,\n    PathLandingPage,\n    ProgramHubPage,\n    ShiftEntryPage,\n    ShopPage,\n    UnitPage,\n    useLearnerPageHeader,\n    WeeklyBoardPage,\n} from '@ai-security-academy/learner'\nimport type { DesktopClient, FeatureId, ShellSnapshot } from '@prisma-airs/desktop-contracts'\nimport { LearnerProvider, useLearnerTrpc } from '../../features/academy/learner-provider'\nimport { DownloadsPage, OfflineNotice, OfflineWorkProvider } from '../../features/academy/offline-work'\nimport { Btn } from '../controls'\nimport { Glyph, type GlyphName } from '../icons'\nimport { ACADEMY_COPY as C } from './copy'\n\nexport interface AcademyProps {\n    snapshot: ShellSnapshot\n    client: DesktopClient\n    onNavigate: (id: FeatureId) => void\n    /** The learner path to open (default `/learn`). */\n    initialPath?: string\n}\n\n// Fixture builds only; never loaded otherwise.\nconst LearnerCallProbe = lazy(() => import('../../features/academy/learner-call-probe'))\n\nconst faint = { color: 'var(--v2-faint)' }\nconst soft = { color: 'var(--v2-soft)' }\nconst CARD = { background: 'var(--v2-paper)', border: '1px solid var(--v2-rule)', borderRadius: 12 }\n\n/** The Rust-owned appearance as the learner host's theme. */\nexport function themeFor(appearance: ShellSnapshot['appearance']): 'gruvbox' | 'paper' {\n    if (appearance === 'dark') return 'gruvbox'\n    if (appearance === 'light') return 'paper'\n    return typeof window !== 'undefined' && window.matchMedia?.('(prefers-color-scheme: dark)').matches ? 'gruvbox' : 'paper'\n}\n\n/** A learning path as Academy's catalog lists it (the fields the row draws). */\ninterface PathRow {\n    id: string\n    slug: string\n    title: string\n    /** The path's one-line summary, as `paths.list` names it. */\n    tagline: string\n    familyKey: string | null\n    unitCount: number\n    unitsDone: number\n    estMinutes: number | null\n    locked: boolean\n}\n\n/**\n * The learner's place (the right card's state lines), provided by `Academy`\n * from the snapshot and read by the router's root on every render, so the\n * card follows the snapshot while the router (memoised per generation)\n * stays mounted.\n */\nconst PlaceContext = createContext<React.ReactNode>(null)\n\n/**\n * The React Query key Academy's own `trpc.paths.list.useQuery()` uses\n * (tRPC react-query: the procedure path split, then `{ type: 'query' }`\n * with no input). Sharing it means one cache entry per generation: the\n * embed's prefetch fills it, and `utils.paths.list.invalidate()` after a\n * course reset or an enrollment change refetches this row too. The entry\n * holds the procedure's raw reply; the row reads it through `pathRows`.\n */\nexport const PATHS_LIST_KEY = [['paths', 'list'], { type: 'query' }] as const\n\n/** Academy's mutations that move a path's progress (tRPC mutation keys: the procedure path). */\nexport const PROGRESS_MUTATIONS: readonly (readonly string[])[] = [\n    ['units', 'complete'],\n    ['units', 'submitKnowledgeCheck'],\n    // A desktop lab's submission completes its unit when it passes (the hosted grade decides).\n    ['desktop', 'attempt', 'submit'],\n]\n\nfunction pathRows(rows: unknown): PathRow[] {\n    if (!Array.isArray(rows)) return []\n    return rows.flatMap((r) => {\n        if (!r || typeof r !== 'object') return []\n        const o = r as Record<string, unknown>\n        if (typeof o.id !== 'string' || typeof o.slug !== 'string' || typeof o.title !== 'string') return []\n        return [\n            {\n                id: o.id,\n                slug: o.slug,\n                title: o.title,\n                tagline: typeof o.tagline === 'string' ? o.tagline : '',\n                familyKey: typeof o.familyKey === 'string' ? o.familyKey : null,\n                unitCount: typeof o.unitCount === 'number' ? o.unitCount : 0,\n                unitsDone: typeof o.unitsDone === 'number' ? o.unitsDone : 0,\n                estMinutes: typeof o.estMinutes === 'number' ? o.estMinutes : null,\n                locked: o.locked === true,\n            },\n        ]\n    })\n}\n\nconst FAMILY_GLYPH: Record<string, GlyphName> = { 'prisma-airs': 'shield', runtime: 'shield', gateway: 'route', 'red-teaming': 'cross', models: 'box', skills: 'code' }\n\n/**\n * Builds the in-memory learner router (one per mounted generation), the\n * legacy destination's routes: reading routes serve guests too; account\n * routes ask a guest to sign in. The root draws the prototype's frame\n * around the page: the page on the left, the learner's place on the right,\n * the Learning paths row beneath.\n */\nfunction academyRouter(onNavigate: (id: FeatureId) => void, initialPath: string, signedIn: boolean) {\n    const root = createRootRoute({\n        component: () => {\n            const place = useContext(PlaceContext)\n            return (\n                <>\n                    <div className='grid min-w-0' style={{ gridTemplateColumns: 'minmax(0, 1.4fr) minmax(0, 1fr)', gap: 16 }} data-slot='academy-frame'>\n                        <section aria-label={C.pages} className='flex min-w-0 flex-col' style={{ ...CARD, padding: '20px 22px', gap: 10 }} data-slot='academy-pages'>\n                            <LearnerTrail />\n                            <LearnerStatus />\n                            <Outlet />\n                        </section>\n                        <section aria-label={C.place} className='flex min-w-0 flex-col self-start' style={{ ...CARD, padding: '20px 22px', gap: 10 }} data-slot='academy-place'>\n                            <span className='text-[11px] font-bold tracking-[0.05em] uppercase' style={faint}>\n                                {C.place}\n                            </span>\n                            {place}\n                            <AcademyNav signedIn={signedIn} />\n                            <OfflineNotice />\n                        </section>\n                    </div>\n                    <PathsRow />\n                </>\n            )\n        },\n        notFoundComponent: () => <NotInThisBuild />,\n    })\n    const signInFirst = () => <SignInHere onNavigate={onNavigate} />\n    const account = (path: string, Page: () => React.ReactNode) => createRoute({ getParentRoute: () => root, path, component: signedIn ? () => <>{Page()}</> : signInFirst })\n    const index = account('/', () => <HomePage />)\n    const program = account('/program', () => <ProgramHubPage />)\n    const downloads = account('/downloads', () => <DownloadsPage />)\n    const assessment = account('/assessment', () => <AssessmentPage />)\n    const assessmentIntro = account('/assessment/intro', () => <AssessmentIntroPage />)\n    const identityPractical = account('/assessment/identity-practical', () => <IdentityPracticalPage />)\n    const exam = createRoute({\n        getParentRoute: () => root,\n        path: '/exam',\n        beforeLoad: () => {\n            throw redirect({ to: '/assessment', replace: true })\n        },\n    })\n    const certificates = account('/certificate', () => <MyCertificatePage />)\n    const certificate = createRoute({\n        getParentRoute: () => root,\n        path: '/certificate/$certId',\n        component: signedIn\n            ? function CertificateRoute() {\n                  return <CertificatePage certId={certificate.useParams().certId} />\n              }\n            : signInFirst,\n    })\n    const shift = account('/shift', () => <ShiftEntryPage />)\n    const dossier = account('/dossier', () => <DossierPage />)\n    const leaderboard = account('/leaderboard', () => <WeeklyBoardPage />)\n    const settings = account('/settings', () => <LearnerAccountPage />)\n    const notifications = account('/notifications', () => <NotificationsPage />)\n    const shop = account('/shop', () => <ShopPage />)\n    const orientation = account('/orientation', () => <OrientationPage />)\n    const onboarding = account('/onboarding', () => <OnboardingPage />)\n    const learn = createRoute({ getParentRoute: () => root, path: '/learn', component: LearnPage })\n    const paths = createRoute({\n        getParentRoute: () => root,\n        path: '/paths',\n        beforeLoad: () => {\n            throw redirect({ to: '/learn', replace: true })\n        },\n    })\n    const path = createRoute({\n        getParentRoute: () => root,\n        path: '/paths/$pathSlug',\n        component: function PathRoute() {\n            return <PathLandingPage pathSlug={path.useParams().pathSlug} />\n        },\n    })\n    const course = createRoute({\n        getParentRoute: () => root,\n        path: '/courses/$courseSlug',\n        beforeLoad: ({ params }) => {\n            const current = currentCourseSlug(params.courseSlug)\n            if (current) throw redirect({ to: '/courses/$courseSlug', params: { courseSlug: current }, replace: true })\n        },\n        component: function CourseRoute() {\n            return <CoursePage courseSlug={course.useParams().courseSlug} />\n        },\n    })\n    const unit = createRoute({\n        getParentRoute: () => root,\n        path: '/units/$unitId',\n        component: function UnitRoute() {\n            return <UnitPage unitId={unit.useParams().unitId} />\n        },\n    })\n    const signIn = createRoute({ getParentRoute: () => root, path: '/sign-in', component: () => <SignInHere onNavigate={onNavigate} /> })\n    return createRouter({\n        routeTree: root.addChildren([\n            index,\n            learn,\n            paths,\n            path,\n            course,\n            unit,\n            signIn,\n            program,\n            assessment,\n            assessmentIntro,\n            identityPractical,\n            exam,\n            certificates,\n            certificate,\n            shift,\n            dossier,\n            leaderboard,\n            settings,\n            notifications,\n            shop,\n            orientation,\n            onboarding,\n            downloads,\n        ]),\n        history: createMemoryHistory({ initialEntries: [initialPath] }),\n        defaultPreload: false,\n        defaultErrorComponent: PageFailed,\n    })\n}\n\n/** Academy's own sections (guests see Learn only) and, signed in, Downloads, Notifications and Settings. */\nfunction AcademyNav({ signedIn }: { signedIn: boolean }) {\n    const items = LEARNER_NAV.filter((item) => signedIn || item.to === '/learn')\n    return (\n        <nav aria-label={C.sections} data-slot='academy-nav' className='flex flex-wrap items-center' style={{ gap: 4 }}>\n            {items.map((item) => (\n                <NavLink key={item.to} to={item.to} label={item.label} />\n            ))}\n            {signedIn ? (\n                <span data-slot='academy-account-nav' className='flex flex-wrap' style={{ gap: 4 }}>\n                    <NavLink to='/downloads' label={C.downloadsLink} />\n                    {LEARNER_ACCOUNT_NAV.map((item) => (\n                        <NavLink key={item.to} to={item.to} label={item.label} />\n                    ))}\n                </span>\n            ) : null}\n        </nav>\n    )\n}\n\nfunction NavLink({ to, label }: { to: string; label: string }) {\n    return (\n        <Link\n            to={to}\n            activeOptions={{ exact: to === '/' }}\n            activeProps={{ 'aria-current': 'page', style: { background: 'var(--v2-acc-soft)', color: 'var(--v2-ink)' } }}\n            className='inline-flex h-8 items-center rounded-[7px] px-3 text-[13px] font-medium'\n            style={{ color: 'var(--v2-soft)' }}\n        >\n            {label}\n        </Link>\n    )\n}\n\n/** Session-critical status a learner page publishes (the assessment's timer), kept in view. */\nfunction LearnerStatus() {\n    const { status } = useLearnerPageHeader()\n    if (!status) return null\n    return (\n        <div data-slot='academy-status' className='sticky top-0 z-10 flex min-h-11 items-center justify-end gap-3 py-2' style={{ background: 'var(--v2-paper)' }}>\n            {status}\n        </div>\n    )\n}\n\n/** The trail each learner page publishes (Learn › Course › Unit), as links within the destination. */\nfunction LearnerTrail() {\n    const { breadcrumbs } = useLearnerPageHeader()\n    if (breadcrumbs.length === 0) return null\n    return (\n        <nav aria-label='Academy location' data-slot='academy-trail'>\n            <ol className='flex flex-wrap items-center text-[13px]' style={{ gap: 4, ...soft }}>\n                {breadcrumbs.map((crumb, index) => {\n                    const last = index === breadcrumbs.length - 1\n                    return (\n                        <li key={`${index}-${crumb.label}`} className='flex items-center' style={{ gap: 4 }}>\n                            {crumb.to && !last ? (\n                                <Link to={crumb.to} className='inline-flex min-h-8 items-center underline'>\n                                    {crumb.label}\n                                </Link>\n                            ) : (\n                                <span aria-current={last ? 'page' : undefined} style={last ? { color: 'var(--v2-ink)' } : undefined}>\n                                    {crumb.label}\n                                </span>\n                            )}\n                            {last ? null : <span aria-hidden='true'>›</span>}\n                        </li>\n                    )\n                })}\n            </ol>\n        </nav>\n    )\n}\n\n/** The Learning paths row: Academy's paths as its catalog lists them for this generation, read through the learner client. */\nfunction PathsRow() {\n    const trpc = useLearnerTrpc() as unknown as { paths: { list: { query(): Promise<unknown> } } }\n    const queryClient = useQueryClient()\n    const query = useQuery({\n        queryKey: PATHS_LIST_KEY,\n        queryFn: () => trpc.paths.list.query(),\n    })\n    // The row stays mounted across the learner's routes, and Academy's own completion hooks refresh the unit,\n    // course and dashboard rollups but not paths.list. A unit completion or a knowledge-check submission that\n    // settles in this generation's cache rereads the row: on success for the new counts, on an error (an\n    // uncertain outcome included) to read Academy's truth back without replaying the mutation.\n    useEffect(\n        () =>\n            queryClient.getMutationCache().subscribe((event) => {\n                if (event.type !== 'updated' || (event.action.type !== 'success' && event.action.type !== 'error')) return\n                const key = event.mutation.options.mutationKey?.[0]\n                if (Array.isArray(key) && PROGRESS_MUTATIONS.some((m) => m.length === key.length && m.every((p, i) => p === key[i]))) {\n                    void queryClient.invalidateQueries({ queryKey: PATHS_LIST_KEY })\n                }\n            }),\n        [queryClient]\n    )\n    const rows = pathRows(query.data)\n    return (\n        <section aria-labelledby='academy-paths' className='flex flex-col' style={{ gap: 12 }} data-slot='academy-paths'>\n            <h2 id='academy-paths' className='text-[15px] font-bold' style={{ marginTop: 6 }}>\n                {C.paths}\n            </h2>\n            {query.isPending ? (\n                <p role='status' className='text-[13px]' style={faint}>\n                    {C.pathsReading}\n                </p>\n            ) : query.isError ? (\n                <p role='alert' className='text-[13px]' style={faint}>\n                    {C.pathsFailed}\n                </p>\n            ) : rows.length === 0 ? (\n                <p className='text-[13px]' style={faint}>\n                    {C.pathsEmpty}\n                </p>\n            ) : (\n                <div className='grid' style={{ gridTemplateColumns: 'repeat(auto-fill, minmax(260px, 1fr))', gap: 16 }} data-slot='academy-path-cards'>\n                    {rows.map((p) => {\n                        const pct = p.unitCount > 0 ? Math.round((100 * p.unitsDone) / p.unitCount) : 0\n                        return (\n                            <Link\n                                key={p.id}\n                                to='/paths/$pathSlug'\n                                params={{ pathSlug: p.slug }}\n                                aria-label={C.openPath(p.title)}\n                                className='flex min-w-0 flex-col'\n                                style={{ ...CARD, padding: '18px 20px', gap: 10, color: 'var(--v2-ink)' }}\n                                data-slot='academy-path'\n                            >\n                                <span className='flex items-center' style={{ gap: 9 }}>\n                                    <span className='grid shrink-0 place-items-center rounded-[8px]' style={{ width: 28, height: 28, background: 'var(--v2-inset)', color: 'var(--v2-soft)' }}>\n                                        <Glyph name={FAMILY_GLYPH[p.familyKey ?? ''] ?? 'cap'} size={14} color='var(--v2-soft)' />\n                                    </span>\n                                    <b className='min-w-0 truncate'>{p.title}</b>\n                                    {p.locked ? (\n                                        <span className='ml-auto text-[12px]' style={faint}>\n                                            {C.pathLocked}\n                                        </span>\n                                    ) : null}\n                                </span>\n                                <span className='text-[12px]' style={{ minHeight: 32, ...soft }}>\n                                    {p.tagline}\n                                </span>\n                                <span\n                                    className='rounded-full'\n                                    style={{ height: 5, background: 'var(--v2-inset)' }}\n                                    role='progressbar'\n                                    aria-valuemin={0}\n                                    aria-valuemax={100}\n                                    aria-valuenow={pct}\n                                    aria-label={`${p.title} progress`}\n                                >\n                                    <span className='block h-full rounded-full' style={{ width: `${pct}%`, background: 'var(--v2-acc)' }} />\n                                </span>\n                                <span className='text-[12px]' style={faint}>\n                                    {C.pathMeta(p.unitCount, p.unitsDone, p.estMinutes)}\n                                </span>\n                            </Link>\n                        )\n                    })}\n                </div>\n            )}\n        </section>\n    )\n}\n\nfunction SignInHere({ onNavigate }: { onNavigate: (id: FeatureId) => void }) {\n    return (\n        <section aria-labelledby='academy-sign-in' className='flex flex-col' style={{ gap: 12, padding: '20px 0' }}>\n            <h1 id='academy-sign-in' className='text-[22px] font-bold'>\n                {C.signInTitle}\n            </h1>\n            <p className='text-[14px]' style={soft}>\n                {C.signInText}\n            </p>\n            <div className='flex items-center' style={{ gap: 10 }}>\n                <Btn tier='primary' onClick={() => onNavigate('settings')}>\n                    {C.openSettings}\n                </Btn>\n                <Link to='/learn' className='text-[13px] underline' style={soft}>\n                    {C.backToCatalog}\n                </Link>\n            </div>\n        </section>\n    )\n}\n\nfunction PageFailed() {\n    return (\n        <section aria-labelledby='academy-failed' className='flex flex-col' style={{ gap: 12, padding: '20px 0' }}>\n            <h1 id='academy-failed' className='text-[22px] font-bold'>\n                {C.failedTitle}\n            </h1>\n            <p className='text-[14px]' style={soft}>\n                {C.failedText}\n            </p>\n            <Link to='/learn' className='text-[13px] underline'>\n                {C.backToCatalog}\n            </Link>\n        </section>\n    )\n}\n\nfunction NotInThisBuild() {\n    return (\n        <section aria-labelledby='academy-later' className='flex flex-col' style={{ gap: 12, padding: '20px 0' }}>\n            <h1 id='academy-later' className='text-[22px] font-bold'>\n                {C.notHereTitle}\n            </h1>\n            <p className='rounded-[10px] text-[13px]' style={{ padding: '12px 14px', background: 'var(--v2-acc-soft)' }}>\n                {C.notHereText}\n            </p>\n            <Link to='/learn' className='text-[13px] underline'>\n                {C.backToCatalog}\n            </Link>\n        </section>\n    )\n}\n\nfunction focusHeading(heading: HTMLElement) {\n    if (!heading.hasAttribute('tabindex')) heading.setAttribute('tabindex', '-1')\n    heading.focus()\n}\n\n/** Moves focus to the page heading after each navigation (keyboard and VoiceOver users). */\nfunction useHeadingFocus(container: React.RefObject<HTMLElement | null>, router: ReturnType<typeof academyRouter>) {\n    useEffect(() => {\n        let tries = 0\n        let frame = 0\n        const tryFocus = () => {\n            const active = document.activeElement\n            if (active && active !== document.body && !container.current?.contains(active)) return\n            const heading = container.current?.querySelector('[data-slot=\"academy-pages\"] h1')\n            if (heading instanceof HTMLElement) {\n                focusHeading(heading)\n            } else if (tries++ < 300) {\n                frame = requestAnimationFrame(tryFocus)\n            }\n        }\n        const unsubscribe = router.subscribe('onResolved', ({ pathChanged }) => {\n            if (!pathChanged) return\n            tries = 0\n            cancelAnimationFrame(frame)\n            frame = requestAnimationFrame(tryFocus)\n        })\n        return () => {\n            unsubscribe()\n            cancelAnimationFrame(frame)\n        }\n    }, [container, router])\n}\n\n/**\n * Lesson bodies are server-compiled HTML whose links are plain anchors. A\n * learner path routes within the destination; an in-page anchor scrolls;\n * any other address stays out of the window and the learner is told.\n */\nfunction useLessonLinks(router: ReturnType<typeof academyRouter>) {\n    const [notice, setNotice] = useState<string | null>(null)\n    const onClick = useCallback(\n        (event: React.MouseEvent<HTMLElement>) => {\n            if (event.defaultPrevented) return\n            const anchor = (event.target as Element | null)?.closest?.('a[href]')\n            if (!anchor || !event.currentTarget.contains(anchor)) return\n            event.preventDefault()\n            const href = anchor.getAttribute('href') ?? ''\n            if (href.startsWith('#')) {\n                const target = href.length > 1 ? event.currentTarget.querySelector(`[id=\"${CSS.escape(href.slice(1))}\"]`) : null\n                target?.scrollIntoView({ block: 'start' })\n                setNotice(null)\n                return\n            }\n            let url: URL\n            try {\n                url = new URL(href, window.location.href)\n            } catch {\n                setNotice(C.linkUnopenable)\n                return\n            }\n            if (url.origin === window.location.origin) {\n                setNotice(null)\n                void router.navigate({ to: `${url.pathname}${url.search}${url.hash}` })\n            } else if (url.protocol === 'https:' || url.protocol === 'http:') {\n                setNotice(C.linkOutside(url.host, url.href))\n            } else {\n                setNotice(C.linkUnopenable)\n            }\n        },\n        [router]\n    )\n    return { notice, onClick }\n}\n\nfunction AcademyRoutes({\n    onNavigate,\n    container,\n    initialPath,\n    signedIn,\n    learner,\n}: {\n    onNavigate: (id: FeatureId) => void\n    container: React.RefObject<HTMLElement | null>\n    initialPath: string\n    signedIn: boolean\n    /** The generation: the router (and its history) is rebuilt per learner reference. */\n    learner: string\n}) {\n    const navigate = useRef(onNavigate)\n    navigate.current = onNavigate\n    // eslint-disable-next-line react-hooks/exhaustive-deps -- `learner` keys the router to the generation\n    const router = useMemo(() => academyRouter((id) => navigate.current(id), initialPath, signedIn), [initialPath, signedIn, learner])\n    useHeadingFocus(container, router)\n    const links = useLessonLinks(router)\n    return (\n        <div onClick={links.onClick} className='flex min-w-0 flex-col' style={{ gap: 20 }}>\n            <p role='status' aria-live='polite' data-slot='academy-link-notice' className='text-[13px] empty:hidden' style={soft}>\n                {links.notice}\n            </p>\n            <RouterProvider router={router} />\n        </div>\n    )\n}\n\n/**\n * The Academy as R2App draws it (C42): the title row with the learner's\n * pills, the 1.4fr/1fr frame (Academy's own learner pages on the left,\n * the learner's place on the right) and the Learning paths row, around\n * the hosted learner pages with the Rust-owned theme. Signed out, the\n * guest generation reads the public catalog; signed in, the account\n * generation. Learner effects mount only here. The embed's content is\n * Academy's own (P19); nothing here signs in or sends on its own.\n */\nexport const Academy = forwardRef<HTMLHeadingElement, AcademyProps>(function Academy({ snapshot, client, onNavigate, initialPath = '/learn' }, ref) {\n    const container = useRef<HTMLElement>(null)\n    useImperativeHandle(ref, () => {\n        const target = container.current\n        return {\n            focus: () => {\n                const heading = target?.querySelector('[data-slot=\"academy-pages\"] h1')\n                if (heading instanceof HTMLElement) focusHeading(heading)\n                else target?.querySelector<HTMLElement>('h1')?.focus()\n            },\n        } as unknown as HTMLHeadingElement\n    })\n    const learner = snapshot.learner\n    const view = snapshot.academy\n    const offline = snapshot.academyOffline\n    const accountId = view.state === 'signedIn' ? view.accountId : null\n    const displayName = view.state === 'signedIn' ? view.displayName : null\n    const unreachable = !offline.reachable && offline.state !== 'signedOut'\n\n    const band = (\n        <div data-slot='page-header-v2' className='flex flex-wrap items-end' style={{ gap: 12 }}>\n            <div className='min-w-0'>\n                <h1 id='academy-heading' tabIndex={-1} className='font-bold' style={{ fontSize: 'var(--v2-title)', letterSpacing: '-0.01em' }}>\n                    {C.title}\n                </h1>\n                <p className='text-[14px]' style={{ marginTop: 4, ...soft }}>\n                    {C.lead}\n                </p>\n            </div>\n            <span className='ml-auto flex flex-wrap items-center' style={{ gap: 8 }} data-slot='academy-pills'>\n                <span\n                    className='flex items-center rounded-full text-[13px] font-semibold'\n                    style={{ height: 26, padding: '0 12px', gap: 6, background: displayName ? 'var(--v2-acc-soft)' : 'var(--v2-inset)', color: displayName ? 'var(--v2-acc)' : 'var(--v2-soft)' }}\n                    data-slot='academy-account'\n                >\n                    <Glyph name={displayName ? 'cap' : 'eye'} size={12} color='currentColor' />\n                    {displayName ? C.signedIn(displayName) : C.guest}\n                </span>\n                {unreachable ? (\n                    <span\n                        className='flex items-center rounded-full text-[13px] font-semibold'\n                        style={{ height: 26, padding: '0 12px', gap: 6, background: 'var(--v2-flag-bg)', color: 'var(--v2-flag)' }}\n                        data-slot='academy-offline-pill'\n                    >\n                        {C.offline}\n                    </span>\n                ) : null}\n                {accountId && offline.downloads.length ? (\n                    <span\n                        className='flex items-center rounded-full text-[13px] font-semibold'\n                        style={{ height: 26, padding: '0 12px', background: 'var(--v2-inset)', color: 'var(--v2-soft)' }}\n                        data-slot='academy-downloads-pill'\n                    >\n                        {C.downloads(offline.downloads.length)}\n                    </span>\n                ) : null}\n            </span>\n        </div>\n    )\n\n    const place = (\n        <>\n            {displayName ? (\n                <p className='text-[13px]' style={soft}>\n                    {C.signedInNote(displayName)}\n                </p>\n            ) : (\n                <>\n                    <p className='text-[13px]' style={soft} data-slot='academy-guest'>\n                        {C.guestNote}\n                    </p>\n                    <Btn className='self-start' onClick={() => onNavigate('settings')}>\n                        {C.openSettings}\n                    </Btn>\n                </>\n            )}\n            {accountId && offline.localDrafts.length ? (\n                <p className='text-[12px]' style={faint} data-slot='academy-drafts'>\n                    {C.drafts(offline.localDrafts.length)}\n                </p>\n            ) : null}\n        </>\n    )\n\n    if (!learner) {\n        return (\n            <section ref={container} tabIndex={-1} aria-label={C.region} data-slot='academy-v2' className='flex min-w-0 flex-col' style={{ gap: 20 }}>\n                {band}\n                <p role='status' className='text-[13px]' style={soft}>\n                    {C.starting}\n                </p>\n            </section>\n        )\n    }\n    return (\n        <section ref={container} tabIndex={-1} aria-label={C.region} data-slot='academy-v2' className='flex min-w-0 flex-col outline-none' style={{ gap: 20 }}>\n            {band}\n            <LearnerProvider client={client} learner={learner} accountId={accountId} displayName={displayName} theme={themeFor(snapshot.appearance)} webOrigin={snapshot.academyOrigin}>\n                <OfflineWorkProvider value={{ client, learner, offline }}>\n                    <PlaceContext.Provider value={place}>\n                        <AcademyRoutes onNavigate={onNavigate} container={container} initialPath={initialPath} signedIn={accountId !== null} learner={learner} />\n                    </PlaceContext.Provider>\n                </OfflineWorkProvider>\n                <CompletionMoments />\n                {snapshot.fixtureBuild ? (\n                    <Suspense fallback={null}>\n                        <LearnerCallProbe />\n                    </Suspense>\n                ) : null}\n            </LearnerProvider>\n        </section>\n    )\n})\n1:# Current state\n9:completed on 2026-10-24. P08/C26 remains open; the owner-authorized P09\n13:under `evidence/P09/native-history/Worf-generation-01-complete-20261101`.\n20:fresh checks and C29–C32/P09 reviews. C24-N06 and C31-N01/N04 remain superseded raw\n35:| C03 | **Complete** (generation 1): Codex attempt-02 scored 9 in all five dimensions; committed as 1b69852 and verified against the reviewed source fingerprint | Attempt-01 (9/8/8/8/8) remediated (`reviews/C03/remediation-attempt-01.md`); budgets v3 acknowledged; C24 owns the typed-input memory observation |\n36:| P01 | **Complete**: Codex phase attempt-02 scored 9 in all five dimensions; committed as 80d6c51 and verified against the reviewed source fingerprint | Attempt-01 (9/8/9/8/8) remediated (`reviews/P01/remediation-attempt-01.md`); 38/38 integrated native checks; budgets re-measured on the P01 bundle |\n41:| P02 | **Complete**: Codex phase attempt-01 scored 9 in all five dimensions; committed as 3decccc and verified against the reviewed source fingerprint | Integrated native checks for C04–C07 and the workload budget on the P02 bundle |\n47:| P03 | **Complete**: Codex phase attempt-02 scored 9 in all five dimensions; committed as bbbad43 and verified against the reviewed source fingerprint | Attempt-01 R1 (context-bound Playground handoff) remediated (`reviews/P03/follow-ups.md`); integrated native checks for C08–C12, the C11 workload and 129/129 mutation probes on the P03 bundle |\n55:| 