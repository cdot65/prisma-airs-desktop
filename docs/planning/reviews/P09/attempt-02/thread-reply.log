{"type":"item.completed","item":{"id":"item_55","type":"command_execution","command":"/bin/zsh -lc \"rg -n 'dismissReview|review|unmount|context' apps/desktop/src/v2/workbench/request-editor.tsx | head -60; sed -n '170,300p' apps/desktop/src/v2/workbench/request-editor.tsx; sed -n '815,925p' crates/desktop-core/src/authority/setup_domain.rs; sed -n '265,325p' apps/desktop/src-tauri/src/native_confirmation.rs; cat tools/p09/test_c32_production_policy.py | head -95\"","aggregated_output":"2:import type { DocumentView, Fields, ImportNote, Preview, RunView, RunningView, SendReviewView } from '@prisma-airs/desktop-contracts'\n16:type Sub = 'params' | 'headers' | 'body' | 'auth' | 'variables' | 'preview'\n17:const SUBS: Sub[] = ['params', 'headers', 'body', 'auth', 'variables', 'preview']\n80:    context?: string | null\n82:    review?: SendReviewView | null\n88: * / Auth / Variables / Preview sub-tabs on the left and the response pane\n95:export function RequestEditor({ initial, notes, call, schemas, historyKey, onClosed, register, context = null, running = [], review = null }: Props) {\n109:    const [preview, setPreview] = useState<Preview | null>(null)\n277:    const sendNow = async (reviewId: string | null) => {\n281:        setStatus(reviewId ? C.waitingReview : C.sending)\n283:            reviewId\n286:                      review: reviewId,\n290:                      context,\n297:                      context,\n306:        if (r.kind === 'reviewRequired') {\n307:            setStatus(C.reviewBelow)\n314:    const readPreview = useCallback(async () => {\n316:            kind: 'preview',\n320:        if (r.kind === 'preview') setPreview(r.preview)\n323:    // Variables and Preview read the rendered request when they open.\n325:        if (sub === 'variables' || sub === 'preview') void readPreview()\n326:    }, [sub, readPreview])\n564:                {preview ? (\n565:                    preview.variables.length ? (\n586:                            {preview.variables.map((v) => (\n631:                {preview?.unresolved.length ? <p role='alert' className='text-[13px]'>{`Unresolved variables: ${preview.unresolved.join(', ')}`}</p> : null}\n632:                <Btn className='self-start' onClick={() => void readPreview()}>\n633:                    {C.readPreview}\n638:                {preview ? (\n639:                    <section aria-label='Request preview' data-slot='workbench-preview' className='flex flex-col text-[13px]' style={{ gap: 8 }}>\n642:                            aria-label={C.sub.preview}\n652:                                `${preview.method} ${preview.url}${preview.query.length ? `?${preview.query.map(([n, v]) => `${n}=${v}`).join('&')}` : ''}`,\n653:                                ...preview.headers.map(([n, v]) => `${n}: ${v}`),\n654:                                ...(preview.body ? ['', preview.body] : []),\n657:                        {preview.auth && preview.auth !== 'none' ? <p>{`Authentication: ${preview.auth}`}</p> : null}\n658:                        {preview.unresolved.length ? <p role='alert'>{`Unresolved variables: ${preview.unresolved.join(', ')}`}</p> : null}\n659:                        {preview.missingSecrets.length ? <p role='alert'>{`Secrets without a value on this Mac: ${preview.missingSecrets.join(', ')}`}</p> : null}\n660:                        {preview.problem ? <p role='alert'>{fieldText(preview.problem)}</p> : null}\n661:                        {preview.jsonWarning ? <p>The JSON body does not parse; it is kept exactly as typed.</p> : null}\n665:                    <Btn onClick={() => void readPreview()}>{C.readPreview}</Btn>\n667:                        {C.previewHint}\n912:                    review={review}\n915:                    onApply={() => review && void sendNow(review.review)}\n916:                    onDismiss={() => void call({ kind: 'dismissReview' }).then(() => setStatus(''))}\n    }, [flush, abandon])\n\n    // The status line's last word (a save's, a send's completion, a refusal) gives way to the state once the\n    // request is edited again; only an action still in flight keeps its line.\n    const settle = () => setStatus((s) => (s === C.sending || s === C.waitingReview || s === 'Saving…' ? s : ''))\n\n    const edit = (patch: Partial<Fields>) => {\n        const next = { ...fieldsRef.current, ...patch }\n        fieldsRef.current = next\n        setFields(next)\n        // Every edit, not only the one that first makes the request dirty: a send from an already dirty (or new)\n        // request left its completion standing through the next edits, since dirty never changed.\n        settle()\n        const generation = ++editGen.current\n        if (markedGen.current <= sentGen.current) {\n            markedGen.current = generation\n            void call({ kind: 'editing', id: idRef.current, edit: generation })\n        }\n        if (timer.current !== null) clearTimeout(timer.current)\n        timer.current = setTimeout(() => void protect(), PROTECT_DELAY_MS)\n    }\n\n    const reload = async () => {\n        const r = await call({ kind: 'openRequest', relative: doc.relative })\n        if (r.kind === 'document') adopt(r.document, r.document.fields)\n    }\n\n    const save = async () => {\n        const snapshot = fieldsRef.current\n        const edit = editGen.current\n        if (timer.current !== null) {\n            clearTimeout(timer.current)\n            timer.current = null\n        }\n        sentGen.current = Math.max(sentGen.current, edit)\n        setSaving(true)\n        setStatus('Saving…')\n        const r = await call({\n            kind: 'save',\n            id: idRef.current,\n            revision: revisionRef.current,\n            fields: snapshot,\n            edit,\n        })\n        setSaving(false)\n        if (r.kind === 'saved' || r.kind === 'unchanged') {\n            ackGen.current = Math.max(ackGen.current, edit)\n            adopt(r.document, null)\n            if (fieldsRef.current !== snapshot) {\n                setStatus('Saved. Edits made while saving are kept unsaved.')\n                void protect()\n            } else {\n                setStatus(r.kind === 'saved' ? 'Saved' : 'No changes to save')\n            }\n            return\n        }\n        if (r.kind === 'saveRefused') {\n            if (r.refusal.kind === 'conflict') setConflict('changed')\n            if (r.refusal.kind === 'interrupted' || r.refusal.kind === 'io') setConflict('interrupted')\n            setStatus(saveRefusalText(r.refusal))\n            return\n        }\n        if (r.kind === 'refused' && r.problem.kind === 'stale') await reload()\n        setStatus(resultText(r) ?? '')\n    }\n\n    const resolve = async (choice: 'useDisk' | 'keepMine') => {\n        const r = await call({\n            kind: 'resolve',\n            id: idRef.current,\n            revision: revisionRef.current,\n            fields: fieldsRef.current,\n            choice,\n        })\n        if (r.kind === 'closed') return onClosed(r.id)\n        if (r.kind === 'document') {\n            adopt(r.document, choice === 'useDisk' ? r.document.fields : null)\n            setStatus(choice === 'useDisk' ? 'Using the files on disk. Your version was kept privately.' : 'Your edits now apply to the files on disk. Save to write them.')\n            return\n        }\n        setStatus(resultText(r) ?? '')\n    }\n\n    const discard = async () => {\n        const r = await call({ kind: 'discardDraft', id: idRef.current })\n        if (r.kind === 'closed') return onClosed(r.id)\n        if (r.kind === 'document') {\n            ackGen.current = editGen.current\n            adopt(r.document, r.document.fields)\n            setStatus('Draft discarded')\n            return\n        }\n        setStatus(resultText(r) ?? '')\n    }\n\n    const associate = async (schema: string) => {\n        const r = await call({\n            kind: 'associateSchema',\n            id: idRef.current,\n            revision: revisionRef.current,\n            fields: fieldsRef.current,\n            schema: schema === '' ? null : schema,\n        })\n        if (r.kind === 'document') adopt(r.document, null)\n        else setStatus(resultText(r) ?? '')\n    }\n\n    const sendNow = async (reviewId: string | null) => {\n        const snapshot = fieldsRef.current\n        setSending(true)\n        setRun(null)\n        setStatus(reviewId ? C.waitingReview : C.sending)\n        const r = await call(\n            reviewId\n                ? {\n                      kind: 'apply',\n                      review: reviewId,\n                      id: idRef.current,\n                      revision: revisionRef.current,\n                      fields: snapshot,\n                      context,\n                  }\n                : {\n                      kind: 'send',\n                      id: idRef.current,\n                      revision: revisionRef.current,\n                      fields: snapshot,\n                      context,\n                  }\n        )\n        setSending(false)\n    /// the draft tenant's id when it may.\n    pub(super) fn completable_setup(\n        &self,\n        context: &ContextRef,\n        packs: &[ProductId],\n    ) -> Result<TenantId, Refusal> {\n        let setup = self.setup_for(context)?;\n        let view = Self::verify_view(setup).ok_or(Refusal::InvalidInput)?;\n        if !view.done || view.blocking || view.stale {\n            return Err(Refusal::InvalidInput);\n        }\n        if setup.mode == SetupMode::FirstRun\n            && !matches!(setup.tenant.scan, ScanCapability::Ready { .. })\n        {\n            return Err(Refusal::InvalidInput);\n        }\n        if packs.iter().any(|p| !setup.products.contains(p)) {\n            return Err(Refusal::InvalidInput);\n        }\n        if self.data.tenants.len() >= MAX_TENANTS {\n            return Err(Refusal::Busy);\n        }\n        Ok(setup.tenant.profile.id.clone())\n    }\n\n    pub(super) fn complete_setup(\n        &mut self,\n        context: &ContextRef,\n        packs: Vec<ProductId>,\n        recorded_secs: u32,\n    ) -> Result<Completed, Refusal> {\n        self.completable_setup(context, &packs)?;\n        let setup = self.setup_for(context)?;\n        let view = Self::verify_view(setup).ok_or(Refusal::InvalidInput)?;\n        // Stage only Data before persistence. Authority retirement is\n        // irreversible and waits for the handler's successful save.\n        let retired_workspace = self.setup_workspace_reference();\n        let Some(mut setup) = self.data.setup.take() else {\n            return Err(Refusal::StaleContext);\n        };\n        let first_run = setup.mode == SetupMode::FirstRun;\n        setup.tenant.products = setup.products.clone();\n        for (n, w) in view.warnings.into_iter().take(MAX_WARNINGS).enumerate() {\n            setup\n                .tenant\n                .setup_warnings\n                .push(crate::features::SetupWarning {\n                    id: format!(\"vw-{}\", n + 1),\n                    product: w.product,\n                    reason: w.reason,\n                    recorded_secs,\n                });\n        }\n        let id = setup.tenant.profile.id.clone();\n        self.data.tenants.push(setup.tenant);\n        self.data.active = Some(id.clone());\n        if first_run {\n            self.data.onboarding = Some(OnboardingState::Done);\n        }\n        let packs = packs\n            .iter()\n            .flat_map(|p| case_products(*p).iter().copied())\n            .collect();\n        Ok(Completed {\n            tenant: id,\n            first_run,\n            packs,\n            retired_workspace,\n        })\n    }\n\n    /// Drops the draft. Its Keychain records go to the cleanup queue; the\n    /// returned session records are the caller's to delete. No tenant,\n    /// selection or onboarding state changes.\n    pub(super) fn discard_setup(&mut self, context: &ContextRef) -> Result<Vec<RecordId>, Refusal> {\n        let id = self.setup_for(context)?.tenant.profile.id.clone();\n        let mut retired = Vec::new();\n        for class in [\n            CredentialClass::Scan,\n            CredentialClass::Management,\n            CredentialClass::Inference,\n        ] {\n            retired.extend(self.retire_class(&id, class));\n        }\n        self.retire_setup_authority();\n        self.data.setup = None;\n        Ok(retired)\n    }\n\n    /// Nothing bound to the draft's context outlives the draft: the cached\n    /// management binding (SDK clients, token cache), the reads queued or in\n    /// flight under its context and under its chosen workspace reference.\n    /// Late replies are withdrawn by the pipeline (the context is gone).\n    fn retire_setup_authority(&mut self) {\n        let Some((context, reference)) = self.data.setup.as_ref().map(|s| {\n            (\n                s.context.clone(),\n                s.gateway.selection.as_ref().map(|w| w.reference.clone()),\n            )\n        }) else {\n            return;\n        };\n        self.retire_setup_context(&context, reference.as_ref());\n    }\n\n    /// Retire a committed draft only after its state replacement succeeded.\n    pub(super) fn retire_setup_context(\n        &mut self,\n        context: &ContextRef,\n        reference: Option<&WorkspaceRef>,\n    ) {\n            self.confirm_scoped(nonce, request, desktop_core::PresentationLease::default())\n        }\n\n        fn confirm_scoped(\n            &self,\n            nonce: u64,\n            request: ConfirmationRequest,\n            lease: desktop_core::PresentationLease,\n        ) -> BoxFuture<'static, bool> {\n            if !lease.is_current() {\n                return Box::pin(async { false });\n            }\n            let receiver = self.registry.open(nonce);\n            if receiver.is_some() {\n                if !lease.is_current() {\n                    self.registry.complete(nonce, false);\n                    return Box::pin(outcome(receiver));\n                }\n                let task = ConfirmationPresentation::new(nonce, request, lease);\n                let registry = Arc::clone(&self.registry);\n                let app = self.app.clone();\n                let presented = self.app.run_on_main_thread(move || {\n                    task.run(&registry, |nonce, request, permit| {\n                        if !present(&app, nonce, &request, &registry, permit) {\n                            registry.complete(nonce, false);\n                        }\n                    });\n                });\n                if presented.is_err() {\n                    self.registry.complete(nonce, false);\n                }\n            }\n            Box::pin(outcome(receiver))\n        }\n\n        fn dismiss(&self, nonce: u64) {\n            self.registry.complete(nonce, false);\n            let _ = self.app.run_on_main_thread(move || end_sheet(nonce));\n        }\n    }\n\n    fn present<R: Runtime>(\n        app: &AppHandle<R>,\n        nonce: u64,\n        request: &ConfirmationRequest,\n        registry: &Arc<Registry>,\n        permit: ConfirmationPermit,\n    ) -> bool {\n        let Some(mtm) = MainThreadMarker::new() else {\n            return false;\n        };\n        let Some(window) = main_window(app) else {\n            return false;\n        };\n        let alert = NSAlert::new(mtm);\n        alert.setMessageText(&NSString::from_str(&request.title));\n        alert.setInformativeText(&NSString::from_str(&request.message));\n        let confirm = alert.addButtonWithTitle(&NSString::from_str(&request.confirm_label));\n        let cancel = alert.addButtonWithTitle(&NSString::from_str(\"Cancel\"));\n        if request.destructive {\n            alert.setAlertStyle(NSAlertStyle::Critical);\nfrom pathlib import Path\nimport unittest\nfrom c32_production_policy import authority_projection,bundle_digest\nimport tempfile\n\nROOT=Path(__file__).resolve().parents[2]\nOLD=ROOT/'docs/planning/evidence/P09/native-history/Worf-generation-09-complete-before-C32-scoped-confirmation-20261102/reviewed-source/authority.rs'\n\nclass HarnessBoundary(unittest.TestCase):\n    def test_actual_delta_only_harness(self):\n        self.assertEqual(authority_projection(OLD.read_text()),authority_projection((ROOT/'crates/desktop-core/src/authority.rs').read_text()))\n    def test_other_presentation_branch_change_rejected(self):\n        old=OLD.read_text();new=(ROOT/'crates/desktop-core/src/authority.rs').read_text()\n        new=new.replace('Effect::RevealSecret {','Effect::UnexpectedSecret {',1)\n        self.assertNotEqual(authority_projection(old),authority_projection(new))\n    def test_unrelated_state_change_rejected(self):\n        old=OLD.read_text();new=(ROOT/'crates/desktop-core/src/authority.rs').read_text().replace('    cleaning: bool,','    cleaning: u64,',1)\n        self.assertNotEqual(authority_projection(old),authority_projection(new))\n    def test_missing_or_ambiguous_harness_marker_rejected(self):\n        for text in ['',OLD.read_text()+'\\n    ConfirmHarness { nonce: u64 }']:\n            with self.assertRaises(ValueError):authority_projection(text)\n\nclass BundleIntegrity(unittest.TestCase):\n    def test_bytes_mode_and_symlink_targets_bound(self):\n        with tempfile.TemporaryDirectory() as work:\n            root=Path(work);file=root/'app';file.write_text('first');file.chmod(0o755);link=root/'link';link.symlink_to('app');before=bundle_digest(root)\n            file.write_text('second');self.assertNotEqual(before,bundle_digest(root));file.write_text('first');self.assertEqual(before,bundle_digest(root))\n            file.chmod(0o644);self.assertNotEqual(before,bundle_digest(root));file.chmod(0o755);link.unlink();link.symlink_to('other');self.assertNotEqual(before,bundle_digest(root))\n\nif __name__=='__main__':unittest.main()\n","exit_code":0,"status":"completed"}}
