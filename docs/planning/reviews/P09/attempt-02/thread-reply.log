     ]\n        },\n        \"shell-controller\": {\n          \"exit\": 0,\n          \"log\": \"docs/planning/evidence/P09/runs/attempt-11/shell-controller.log\",\n          \"log_sha256\": \"ea9ab78598d3586a26c8545e0d3f8a8d4c4b43031a42b239958d6fa3e0aafb92\",\n          \"summary\": [\n            \"test result: ok. 46 passed; 0 failed; 0 ignored; 0 measured; 0 filtered out; finished in 0.10s\",\n            \"EXIT 0\"\n          ]\n        },\n        \"desktop-build\": {\n          \"exit\": 0,\n          \"log\": \"docs/planning/evidence/P09/runs/attempt-11/desktop-build.log\",\n          \"log_sha256\": \"a99115cdbc78ae7724685f4657e236907ef669e202a712866d61cba6f1bc9629\",\n          \"summary\": [\n            \"EXIT 0\"\n          ]\n        },\n        \"l19-offline\": {\n          \"exit\": 0,\n          \"log\": \"docs/planning/evidence/P09/runs/attempt-11/l19-offline.log\",\n          \"log_sha256\": \"327b192d375eafe63017dd05735873972d3aeb9b21ff6ec547fa74d42843e5bb\",\n          \"summary\": [\n            \"test result: ok. 15 passed; 0 failed; 0 ignored; 0 measured; 0 filtered out; finished in 0.01s\",\n            \"test result: ok. 57 passed; 0 failed; 0 ignored; 0 measured; 0 filtered out; finished in 30.35s\",\n            \"EXIT 0\"\n          ]\n        },\n        \"l19-native-driver\": {\n          \"exit\": 0,\n          \"log\": \"docs/planning/evidence/P09/runs/attempt-11/l19-native-driver.log\",\n          \"log_sha256\": \"db627b3f4da28a2df98ac36cd5fba5b549ab3e71e9c7a8c65cb500bff1e43cdb\",\n          \"summary\": [\n            \"EXIT 0\"\n          ]\n        }\n      }\n    }\n  ]\n}\nsource-inventory.json {'files': {'.gitattributes': {'mode': 420, 'kind': 'file', 'sha256': '144b1848b959aa274059b675388c4f0fbc24817b2c68b3e1fac532e5d3c23689'}, '.gitignore': {'mode': 420, 'kind': 'file', 'sha256': 'b3c79229d737aed139c03f169f29478bbc0315e10bbd3533a306a70f83d24f8f'}, '.npmrc': {'mode': 420, 'kind': 'file', 'sha256': '39ca3c99b39732635600edb6a