{"type":"item.completed","item":{"id":"item_46","type":"command_execution","command":"/bin/zsh -lc \"sed -n '325,425p' crates/desktop-core/src/authority/workbench_domain/send.rs; sed -n '475,670p' crates/desktop-core/src/authority/workbench_domain/send.rs; sed -n '598,750p' crates/desktop-core/src/authority/change_domain.rs; rg -n 'retire|page|shown|expired|confirm|scope|stale' crates/desktop-core/tests/workbench_execution/main.rs | tail -50; sed -n '1110,1240p' crates/desktop-core/tests/workbench_execution/main.rs\"","aggregated_output":"            Region::Europe,\n            Region::India,\n            Region::Singapore,\n        ] {\n            registered.add(region.origin(), OriginClass::Scan);\n        }\n        for tenant in &self.data.tenants {\n            registered.add(tenant.profile.destination.origin(), OriginClass::Scan);\n        }\n        registered\n    }\n\n    /// Where `context`'s tenant credentials may go, and their records.\n    fn send_destinations(\n        &self,\n        context: Option<&ContextRef>,\n    ) -> Result<(Destinations, Option<Managed>), SendRefusal> {\n        let registered = self.registered_origins();\n        let Some(context) = context else {\n            return Ok((\n                Destinations {\n                    registered,\n                    ..Destinations::default()\n                },\n                None,\n            ));\n        };\n        let tenant = self\n            .check_context(context)\n            .map_err(|_| SendRefusal::NoTenant)?;\n        let current = self.tenant(&tenant).ok_or(SendRefusal::NoTenant)?;\n        let endpoints = &self.management_endpoints;\n        let token_origin = endpoints.token_origin();\n        let mut destinations = Destinations {\n            tsg: current.profile.tsg_id.clone(),\n            registered,\n            ..Destinations::default()\n        };\n        let mut managed = Managed {\n            tenant: tenant.as_str().to_owned(),\n            client_id: None,\n            management: None,\n            scan: None,\n        };\n        if let ScanCapability::Ready {\n            record,\n            mode,\n            destination,\n        } = &current.management\n            && token_origin.as_deref() == Some(destination.as_str())\n            && let Some(client) = &current.management_client\n        {\n            destinations.management = true;\n            destinations.token_urls = vec![\n                endpoints.token.clone(),\n                format!(\"{destination}{}\", admission::CATALOGUE_TOKEN_PATH),\n            ];\n            destinations.token_origin = Some(destination.clone());\n            for base in [\n                &endpoints.api,\n                &endpoints.dlp,\n                &endpoints.red_team_data,\n                &endpoints.red_team_mgmt,\n                &endpoints.red_team_broker,\n                &endpoints.model_data,\n                &endpoints.model_mgmt,\n                &endpoints.agentguard_data,\n                &endpoints.agentguard_mgmt,\n                &endpoints.gateway_data,\n                &endpoints.gateway_admin,\n                &endpoints.gateway_iam,\n            ] {\n                if let Ok(u) = url::Url::parse(base) {\n                    destinations\n                        .api_origins\n                        .insert(u.origin().ascii_serialization());\n                }\n            }\n            destinations\n                .api_origins\n                .extend(self.workbench_api_origins.iter().cloned());\n            managed.client_id = Some(client.clone());\n            managed.management = Some((record.clone(), *mode));\n        }\n        if let ScanCapability::Ready {\n            record,\n            mode,\n            destination,\n        } = &current.scan\n        {\n            destinations.scan_origin = Some(destination.clone());\n            managed.scan = Some((record.clone(), *mode));\n        }\n        Ok((destinations, Some(managed)))\n    }\n}\n\n/// The credentials a planned request sends besides its tenant ones.\n#[derive(Clone, Debug, Default, PartialEq, Eq)]\nstruct Credentials {\n    /// Each workbench secret reference it uses and that secret's\n            o.data.private.get(environments::DEFAULTS).cloned(),\n        ))\n    })\n    .map_err(|p| Box::new(refused(p)))?;\n    #[cfg(feature = \"test-fixtures\")]\n    {\n        let (hold, waiting) = lock(inner)\n            .map_err(|_| Box::new(refused(WorkbenchProblem::Unavailable)))?\n            .workbench\n            .sending\n            .planning();\n        waiting.fetch_add(1, Ordering::SeqCst);\n        drop(hold.lock().await);\n        waiting.fetch_sub(1, Ordering::SeqCst);\n    }\n    let (doc, folder, collection, scope, env, local, defaults) = found;\n    let reference = doc.body_reference();\n    let stored_body = if fields.body_kind == \"file\" {\n        if fields.body != doc.saved.body {\n            return Err(Box::new(refusal(SendRefusal::Body {\n                problem: admission::BodyProblem::Unsaved,\n            })));\n        }\n        reference.clone()\n    } else if doc.body_editable {\n        None\n    } else {\n        reference.clone()\n    };\n    let read_folder = folder.clone();\n    let rendered = blocking(Err(SendRefusal::Private), move || {\n        let read = |relative: &str| {\n            project::relative_path(relative, false)\n                .and_then(|r| {\n                    project::read_optional(&read_folder, &r, environments::ENVIRONMENT_BYTES)\n                        .ok()\n                        .flatten()\n                })\n                .and_then(|b| String::from_utf8(b).ok())\n        };\n        let layers = Layers {\n            collection: read(\"collection.toml\"),\n            local_defaults: defaults,\n            shared: env\n                .as_ref()\n                .and_then(|e| read(&format!(\"environments/{e}.toml\"))),\n            local,\n        };\n        render::render(&fields, &layers, stored_body.as_deref())\n            .map_err(|problem| SendRefusal::Render { problem })\n    })\n    .await;\n    let mut plan = rendered.map_err(|r| Box::new(refusal(r)))?;\n    let (destinations, managed, network) = {\n        let state = lock(inner).map_err(|_| Box::new(refused(WorkbenchProblem::Unavailable)))?;\n        let (d, m) = state\n            .send_destinations(context.as_ref())\n            .map_err(|r| Box::new(refusal(r)))?;\n        (d, m, state.workbench_network)\n    };\n    if let Some(tsg) = &destinations.tsg\n        && plan.references().contains(admission::TSG_ID)\n    {\n        admission::fill_tsg(&mut plan, tsg);\n    }\n    let admitted =\n        admission::admit(&plan, network, &destinations).map_err(|r| Box::new(refusal(r)))?;\n    if admitted.class != CredentialClass::Managed {\n        // Loaded now so the Cookie header it would send is known.\n        if jar(inner, root, &scope, epoch).await.is_none() {\n            return Err(Box::new(retired()));\n        }\n    }\n    let credentials = lock(inner)\n        .map_err(|_| Box::new(refused(WorkbenchProblem::Unavailable)))?\n        .workbench\n        .sending\n        .credentials(&collection, &scope, &plan, &admitted);\n    // At a registered origin the jar's Cookie counts toward the one\n    // credential, decided here, before any secret is read or anything sent.\n    if admitted.class != CredentialClass::Managed\n        && admitted.operation.is_some()\n        && credentials.cookie.is_some()\n        && admission::jar_cookie_is_ambiguous(&plan)\n    {\n        return Err(Box::new(refusal(SendRefusal::AmbiguousCredential)));\n    }\n    Ok(Planned {\n        relative: doc.relative.clone(),\n        request: doc.id,\n        plan,\n        admitted,\n        folder,\n        collection,\n        scope,\n        managed,\n        context,\n        pins: BTreeMap::new(),\n        credentials,\n        epoch,\n    })\n}\n\nfn bound_body(\n    body: &Body,\n    folder: &Path,\n    files: &mut BTreeMap<String, String>,\n) -> Result<serde_json::Value, SendRefusal> {\n    let mut hash = |relative: &str| {\n        let digest = crate::workbench::document::hash_file(folder, relative)\n            .ok()\n            .flatten()\n            .ok_or(SendRefusal::Body {\n                problem: admission::BodyProblem::Missing,\n            })?;\n        files.insert(relative.to_owned(), digest.clone());\n        Ok::<_, SendRefusal>(digest)\n    };\n    Ok(match body {\n        Body::None => serde_json::Value::Null,\n        Body::Text { text, json } => serde_json::json!({\"text\": text.bound(), \"json\": json}),\n        Body::Form(rows) => {\n            serde_json::json!({\"form\": rows.iter().map(|(n, v)| [n.bound(), v.bound()]).collect::<Vec<_>>()})\n        }\n        Body::Multipart(parts) => {\n            let mut out = Vec::new();\n            for p in parts {\n                out.push(match &p.value {\n                    PartValue::Text(t) => serde_json::json!({\"name\": p.name, \"value\": t.bound()}),\n                    PartValue::File { relative, mime } => {\n                        serde_json::json!({\"name\": p.name, \"file\": relative, \"sha256\": hash(relative)?, \"mime\": mime})\n                    }\n                });\n            }\n            serde_json::json!({\"multipart\": out})\n        }\n        Body::File { relative } => serde_json::json!({\"file\": relative, \"sha256\": hash(relative)?}),\n    })\n}\n\n/// What a review is bound to: the tenant credential and destination, the\n/// exact expanded request (secrets by reference, files by content) and the\n/// other credentials it sends (authentication in full, each workbench\n/// secret's generation, the admitted Cookie header by its hash). The\n/// files' hashes come back as the pins a send must keep to.\nfn digest(p: &Planned) -> Result<(String, BTreeMap<String, String>), SendRefusal> {\n    let mut files = BTreeMap::new();\n    let plan = &p.plan;\n    let managed = p.managed.as_ref();\n    let auth = match &plan.auth {\n        render::Auth::OAuth2 {\n            token_url,\n            client_id,\n            scope,\n            secret,\n        } => serde_json::json!([\n            \"oauth2\",\n            token_url.bound(),\n            client_id.bound(),\n            scope.bound(),\n            secret\n        ]),\n        render::Auth::ApiKey {\n            name,\n            query,\n            secret,\n        } => serde_json::json!([\"api-key\", name, query, secret]),\n        render::Auth::Basic { username, secret } => {\n            serde_json::json!([\"basic\", username.bound(), secret])\n        }\n        render::Auth::Bearer { secret } => serde_json::json!([\"bearer\", secret]),\n        render::Auth::None => serde_json::json!([\"none\"]),\n    };\n    let cookie = p\n        .credentials\n        .cookie\n        .as_ref()\n        .map(|c| hex::encode(Sha256::digest(c.as_bytes())));\n    let bound = serde_json::json!({\n        \"tenant\": managed.map(|m| m.tenant.clone()),\n        \"client\": managed.and_then(|m| m.client_id.clone()),\n        \"management\": managed.and_then(|m| m.management.as_ref().map(|(r, _)| r.as_str().to_owned())),\n        \"scan\": managed.and_then(|m| m.scan.as_ref().map(|(r, _)| r.as_str().to_owned())),\n        \"context\": p.context.as_ref().map(ContextRef::as_str),\n        \"operation\": p.admitted.operation.as_ref().map(|o| o.index),\n        \"method\": plan.method,\n        \"url\": plan.url.bound(),\n        \"query\": plan.query.iter().map(|(n, v)| [n.bound(), v.bound()]).collect::<Vec<_>>(),\n        \"headers\": plan.headers.iter().map(|(n, v)| [n.clone(), v.bound()]).collect::<Vec<_>>(),\n        \"auth\": auth,\n        \"secrets\": p.credentials.secrets,\n        \"cookie\": cookie,\n        \"body\": bound_body(&plan.body, &p.folder, &mut files)?,\n        \"variables\": plan.used,\n        \"request\": p.request,\n    });\n    pub(super) fn request_apply(\n        &mut self,\n        review: &ReviewId,\n        draft: &ChangeDraft,\n        typed: &str,\n    ) -> Result<(u64, ConfirmationRequest, PresentationLease), Refusal> {\n        if self.consumed_reviews.contains(review) {\n            return Err(Refusal::ReviewConsumed);\n        }\n        let active = self.active_ref.clone();\n        let lifetime = self.review_lifetime;\n        let label = self\n            .change_review\n            .as_ref()\n            .and_then(|r| self.tenant(&r.tenant))\n            .map(|t| t.profile.label.clone())\n            .unwrap_or_default();\n        let current = self\n            .change_review\n            .as_mut()\n            .filter(|r| &r.id == review)\n            .ok_or(Refusal::ReviewInvalid)?;\n        if active.as_ref() != Some(&current.context) || current.created.elapsed() > lifetime {\n            return Err(Refusal::ReviewInvalid);\n        }\n        let prepared = match &current.phase {\n            Phase::Ready(prepared) => prepared.clone(),\n            Phase::Confirming { .. } => return Err(Refusal::Busy),\n            _ => return Err(Refusal::ReviewInvalid),\n        };\n        // Fresh input must be exactly what was reviewed (client authorship\n        // is re-applied, so the comparison is of normalized drafts).\n        let author = current\n            .draft\n            .body\n            .get(match current.draft.action {\n                ChangeAction::Create | ChangeAction::Version => \"created_by\",\n                _ => \"updated_by\",\n            })\n            .and_then(Value::as_str)\n            .unwrap_or_default()\n            .to_owned();\n        let context = current.context.clone();\n        let bound = current.gateway.clone();\n        let fresh = match &bound {\n            // A Gateway draft must still name the reference it was reviewed\n            // under, and that selection must still be current.\n            Some(bound) => {\n                if draft.workspace != bound.scope.reference\n                    || !self.workspace_current(bound.scope.reference.as_ref())\n                    || !prepared.references.is_empty()\n                {\n                    return Err(Refusal::ReviewInvalid);\n                }\n                gateway::normalize(draft, &bound.tsg, bound.workspace())\n                    .map_err(|_| Refusal::ReviewInvalid)?\n            }\n            None => match self.resolve_staged(&context, draft) {\n                Ok(draft) => normalize(&draft, &author).map_err(|_| Refusal::ReviewInvalid)?,\n                Err(_) => return Err(Refusal::ReviewInvalid),\n            },\n        };\n        let Some(current) = self.change_review.as_mut().filter(|r| &r.id == review) else {\n            return Err(Refusal::ReviewInvalid);\n        };\n        if fresh != current.draft {\n            return Err(Refusal::ReviewInvalid);\n        }\n        let expected = confirmation(&prepared.mutation, prepared.before.as_ref());\n        if expected.as_deref() != Some(typed) {\n            return Err(Refusal::InvalidInput);\n        }\n        let nonce = nonce().ok_or(Refusal::ShuttingDown)?;\n        let shown = bound.as_ref().and_then(|b| b.scope.shown.as_ref());\n        let request = confirmation_request(&label, &prepared, shown);\n        current.phase = Phase::Confirming { nonce, prepared };\n        Ok((nonce, request, current.presentation.lease()))\n    }\n\n    /// The native confirmation's private completion. Only the open\n    /// confirmation `nonce` of a current review is honored, once; a denial\n    /// returns the review to ready (another RequestApply is needed).\n    pub(super) fn settle_confirmation(\n        &mut self,\n        review: &ReviewId,\n        nonce: u64,\n        accepted: bool,\n        keychain: Arc<dyn super::CredentialStore>,\n        session_vault: Arc<SessionVault>,\n    ) -> Vec<crate::runtime::Start> {\n        let active = self.active_ref.clone();\n        let Some(current) = self.change_review.as_mut().filter(|r| &r.id == review) else {\n            return Vec::new();\n        };\n        if !matches!(&current.phase, Phase::Confirming { nonce: n, .. } if *n == nonce)\n            || active.as_ref() != Some(&current.context)\n        {\n            return Vec::new();\n        }\n        let expired = current.created.elapsed() > self.review_lifetime;\n        let Phase::Confirming { prepared, .. } =\n            std::mem::replace(&mut current.phase, Phase::Failed(ChangeFailure::Conflict))\n        else {\n            return Vec::new();\n        };\n        // A denial, or a confirmation that outlived the review, applies\n        // nothing; the review stays (an expired one shows as expired).\n        if !accepted || expired {\n            current.phase = Phase::Ready(prepared);\n            return Vec::new();\n        }\n        let (context, tenant, draft, bound) = (\n            current.context.clone(),\n            current.tenant.clone(),\n            current.draft.clone(),\n            current.gateway.clone(),\n        );\n        // Admission and consumption are one step: if the change cannot be\n        // started, the review is not consumed and the operator sees why.\n        let source = match self.binding_source(&context, keychain, session_vault) {\n            Ok(source) => source,\n            Err(_) => {\n                if let Some(r) = self.change_review.as_mut() {\n                    r.phase = Phase::Failed(ChangeFailure::Service {\n                        failure: ManagementFailure::CredentialMissing,\n                    });\n                }\n                return Vec::new();\n            }\n        };\n        let slot: ApplySlot = Arc::default();\n        let name = item_name(draft.kind, &prepared.mutation.body).or_else(|| {\n            prepared\n                .before\n                .as_ref()\n                .and_then(|b| item_name(draft.kind, b))\n        });\n        let source_name = prepared\n            .before\n            .as_ref()\n            .and_then(|b| item_name(draft.kind, b));\n        let application = [&prepared.mutation.body]\n            .into_iter()\n            .chain(prepared.before.iter())\n            .find_map(|v| v.get(\"cust_app\").and_then(Value::as_str))\n            .filter(|s| !s.is_empty())\n            .map(str::to_owned);\n        let workspace = bound.as_ref().and_then(|b| b.scope.shown.clone());\n        let reference = bound.as_ref().and_then(|b| b.scope.reference.clone());\n        let local = bound.as_ref().map(|_| LocalOrigin {\n            tenant: tenant.clone(),\n            workspace: workspace.clone(),\n            body: draft.body.to_string(),\n1181:    let (_, confirmation) = desk\n1183:        .confirmer\n1187:        .expect(\"confirmed\");\n1189:        confirmation.destructive && confirmation.message.contains(\"/iam/v1/access_policies/abc\")\n1197:    // A body file changed after review: stale.\n1215:    let stale_context = desk.context();\n1218:        .wb(json!({\"kind\": \"apply\", \"review\": r[\"review\"][\"review\"], \"id\": \"create\", \"revision\": doc[\"revision\"], \"fields\": fields, \"context\": stale_context}))\n1386:    // The manual-credential review, confirmed, is sent once as written.\n1391:    desk.adapters.confirmer.auto(Some(true));\n1416:async fn a_tenant_change_retires_reviews_and_unsent_requests() {\n1450:    assert_eq!(r[\"run\"][\"record\"][\"failure\"], \"retired\", \"{r}\");\n1453:    // Held at the native confirmation (after the review was planned): a\n1461:    desk.adapters.confirmer.auto(None);\n1463:    assert!(support::eventually(|| desk.adapters.confirmer.held() == 1).await);\n1465:    assert_eq!(desk.workbench()[\"review\"], Value::Null, \"retired at once\");\n1467:        desk.adapters.confirmer.held(),\n1469:        \"retired native confirmation\"\n1472:        !desk.adapters.confirmer.complete(true),\n1478:    desk.adapters.confirmer.auto(Some(true));\n1484:    // Replacing the tenant's credential retires a review the same way.\n1564:        let page = d.wb(json!({\"kind\": \"history\", \"before\": null})).await;\n1565:        let shown = d.wb(json!({\"kind\": \"showRun\", \"run\": run})).await;\n1566:        for text in [r.to_string(), page.to_string(), shown.to_string()] {\n1587:    let page = again.wb(json!({\"kind\": \"history\", \"before\": null})).await;\n1588:    assert_eq!(page[\"runs\"].as_array().map(Vec::len), Some(1), \"{page}\");\n1589:    assert!(!leaks(&page.to_string()), \"{page}\");\n1626:    desk.adapters.confirmer.auto(Some(true));\n1642:    let page = desk.wb(json!({\"kind\": \"history\", \"before\": null})).await;\n1643:    let kept = page[\"runs\"]\n1823:    let stale = json!({\"kind\": \"sendRefused\", \"refusal\": {\"kind\": \"reviewStale\"}});\n1824:    desk.adapters.confirmer.auto(Some(true));\n1837:        assert_eq!(r, stale, \"{id}\");\n1840:    // confirmation is held.\n1849:    assert_eq!(r, stale, \"replaced after review\");\n1851:    desk.adapters.confirmer.auto(None);\n1853:    assert!(support::eventually(|| desk.adapters.confirmer.held() == 1).await);\n1855:    assert!(desk.adapters.confirmer.complete(true));\n1856:    assert_eq!(desk.wait(op).await, stale, \"replaced while confirming\");\n1857:    desk.adapters.confirmer.auto(Some(true));\n1875:        stale,\n1885:        stale,\n2047:async fn reset_during_planning_retires_the_send_before_anything_goes() {\n2094:    // Planning resumes in the epoch reset retired.\n2103:    assert_eq!(http.seen().len(), sent, \"the retired Send never went\");\n2118:    let page = again.wb(json!({\"kind\": \"history\", \"before\": null})).await;\n2119:    assert_eq!(page[\"runs\"], json!([]), \"{page}\");\n2136:async fn reset_retires_running_sends_and_nothing_they_held_is_kept() {\n2204:    // run retired: nothing came back.\n2240:    let page = again.wb(json!({\"kind\": \"history\", \"before\": null})).await;\n2241:    assert_eq!(page[\"runs\"], json!([]), \"{page}\");\n    let doc = desk.doc(\"read.request.toml\").await;\n    let mut scan = with(&doc, \"url\", &format!(\"{origin}/v1/scan/results\"));\n    scan[\"settings\"] = json!(\"\");\n    scan[\"headers\"] = json!(\"x-pan-token: {{key}}\");\n    let r = desk.send_fields(&doc, &scan).await;\n    assert_eq!(r[\"run\"][\"record\"][\"status\"], 200, \"{r}\");\n}\n\n#[tokio::test(flavor = \"multi_thread\")]\nasync fn known_tenant_changes_need_an_exact_confirmed_review_and_are_sent_once() {\n    let Tenant {\n        mut desk,\n        server,\n        origin,\n        ..\n    } = tenant().await;\n    let root = managed_collection(\n        &origin,\n        &[\n            (\"del\", \"DELETE\", \"/iam/v1/access_policies/abc\"),\n            (\"create\", \"POST\", \"/iam/v1/access_policies\"),\n        ],\n    );\n    std::fs::write(root.join(\"policy.json\"), \"{\\\"name\\\":\\\"p\\\"}\").expect(\"fixture\");\n    desk.open(&root).await;\n    let doc = desk.doc(\"del.request.toml\").await;\n    let r = desk.send_doc(\"del.request.toml\").await;\n    assert_eq!(r[\"kind\"], \"reviewRequired\", \"{r}\");\n    let review = r[\"review\"].clone();\n    assert_eq!(review[\"method\"], \"DELETE\");\n    assert_eq!(review[\"destination\"], origin);\n    assert!(server.seen().is_empty(), \"a review sends nothing\");\n    assert_eq!(desk.workbench()[\"review\"], review);\n    let context = desk.context();\n    let apply = |review: &Value, fields: &Value| json!({\"kind\": \"apply\", \"review\": review, \"id\": \"del\", \"revision\": doc[\"revision\"], \"fields\": fields, \"context\": context});\n    // A forged review, then a changed snapshot: refused before any sheet\n    // (were one shown, it would be declined).\n    desk.adapters.confirmer.auto(Some(false));\n    let r = desk\n        .wb(apply(&json!(\"rv-0000000000000000\"), &doc[\"fields\"]))\n        .await;\n    assert_eq!(\n        r,\n        json!({\"kind\": \"sendRefused\", \"refusal\": {\"kind\": \"reviewMissing\"}})\n    );\n    let changed = with(&doc, \"url\", \"{{scm_base}}/iam/v1/access_policies/other\");\n    let r = desk.wb(apply(&review[\"review\"], &changed)).await;\n    assert_eq!(\n        r,\n        json!({\"kind\": \"sendRefused\", \"refusal\": {\"kind\": \"reviewStale\"}})\n    );\n    // The operator declines natively: nothing is sent, the review stays.\n    desk.adapters.confirmer.auto(Some(false));\n    let r = desk.wb(apply(&review[\"review\"], &doc[\"fields\"])).await;\n    assert_eq!(\n        r,\n        json!({\"kind\": \"sendRefused\", \"refusal\": {\"kind\": \"declined\"}})\n    );\n    assert!(server.seen().is_empty());\n    // Confirmed: sent exactly once, then the review is consumed.\n    desk.adapters.confirmer.auto(Some(true));\n    let r = desk.wb(apply(&review[\"review\"], &doc[\"fields\"])).await;\n    assert_eq!(r[\"run\"][\"record\"][\"status\"], 200, \"{r}\");\n    let deletes = |server: &TlsServer| {\n        server\n            .seen()\n            .iter()\n            .filter(|s| s.request_line.starts_with(\"DELETE\"))\n            .count()\n    };\n    assert_eq!(deletes(&server), 1);\n    let (_, confirmation) = desk\n        .adapters\n        .confirmer\n        .requests()\n        .last()\n        .cloned()\n        .expect(\"confirmed\");\n    assert!(\n        confirmation.destructive && confirmation.message.contains(\"/iam/v1/access_policies/abc\")\n    );\n    let r = desk.wb(apply(&review[\"review\"], &doc[\"fields\"])).await;\n    assert_eq!(\n        r,\n        json!({\"kind\": \"sendRefused\", \"refusal\": {\"kind\": \"reviewConsumed\"}})\n    );\n    assert_eq!(deletes(&server), 1);\n    // A body file changed after review: stale.\n    let doc = desk.doc(\"create.request.toml\").await;\n    let mut fields = doc[\"fields\"].clone();\n    fields[\"bodyKind\"] = json!(\"multipart\");\n    fields[\"body\"] = json!(\"[[parts]]\\nname = \\\"p\\\"\\nfile = \\\"policy.json\\\"\\n\");\n    let r = desk.send_fields(&doc, &fields).await;\n    assert_eq!(r[\"kind\"], \"reviewRequired\", \"{r}\");\n    std::fs::write(root.join(\"policy.json\"), \"{\\\"name\\\":\\\"changed\\\"}\").expect(\"fixture\");\n    let context = desk.context();\n    let r = desk\n        .wb(json!({\"kind\": \"apply\", \"review\": r[\"review\"][\"review\"], \"id\": \"create\", \"revision\": doc[\"revision\"], \"fields\": fields, \"context\": context}))\n        .await;\n    assert_eq!(\n        r,\n        json!({\"kind\": \"sendRefused\", \"refusal\": {\"kind\": \"reviewStale\"}})\n    );\n    // Another tenant: the review's context is gone.\n    let r = desk.send_fields(&doc, &fields).await;\n    let stale_context = desk.context();\n    select(&mut desk, \"Tenant B\").await;\n    let r = desk\n        .wb(json!({\"kind\": \"apply\", \"review\": r[\"review\"][\"review\"], \"id\": \"create\", \"revision\": doc[\"revision\"], \"fields\": fields, \"context\": stale_context}))\n        .await;\n    assert_eq!(\n        r,\n        json!({\"kind\": \"sendRefused\", \"refusal\": {\"kind\": \"noTenant\"}})\n    );\n    assert_eq!(\n        server\n            .seen()\n            .iter()\n            .filter(|s| s.request_line.starts_with(\"POST /iam\"))\n            .count(),\n        0\n    );\n}\n\n#[tokio::test(flavor = \"multi_thread\")]\nasync fn trust_and_proxies_follow_the_native_transport_policy() {\n    // A certificate from an authority the policy does not trust.\n    let untrusted = TestCa::new(\"airs-v2 c15 untrusted\");\n    let tls = TlsServer::start(\n        untrusted.leaf(&[\"127.0.0.1\"]),\n        Reply::Raw {\n","exit_code":0,"status":"completed"}}
