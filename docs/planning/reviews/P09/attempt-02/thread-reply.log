itchResolution::Discard { context, review } => (context, review),\ncrates/desktop-core/src/authority/inbox_domain.rs:389:            let blocked = self.switch_blocked.as_ref().ok_or(Refusal::StaleContext)?;\ncrates/desktop-core/src/authority/inbox_domain.rs:390:            if self.active_ref.as_ref() != Some(context)\ncrates/desktop-core/src/authority/inbox_domain.rs:391:                || &blocked.context != context\ncrates/desktop-core/src/authority/inbox_domain.rs:394:                || blocked.target_context.as_ref() != target_context\ncrates/desktop-core/src/authority/inbox_domain.rs:409:            self.switch_blocked = None;\ncrates/desktop-core/src/authority/inbox_domain.rs:412:        self.switch_blocked = Some(SwitchBlocked {\ncrates/desktop-core/src/authority/inbox_domain.rs:415:            completion: target_context.is_some(),\ncrates/desktop-core/src/authority/inbox_domain.rs:416:            context: self.active_ref.clone().ok_or(Refusal::StaleContext)?,\ncrates/desktop-core/src/authority/inbox_domain.rs:417:            review: ReviewId::issue().ok_or(Refusal::ShuttingDown)?,\ncrates/desktop-core/src/authority/inbox_domain.rs:418:            target_context: target_context.cloned(),\ncrates/desktop-core/src/authority/inbox_domain.rs:424:    pub(super) fn setup_warning_items(&self) -> Vec<InboxItem> {\ncrates/desktop-core/src/authority/inbox_domain.rs:435:    pub(super) fn selected_products(&self, tenant: &TenantId) -> Vec<ProductId> {\ncrates/desktop-core/src/authority/inbox_domain.rs:451:    pub(super) fn read_status(&self, overview: &OverviewView) -> ReadStatus {\ncrates/desktop-core/src/authority/inbox_domain.rs:697:    pub(super) fn inbox_view(&self, overview: &OverviewView) -> InboxView {\n7:## Module ownership\n42:## 1. Native authority interface\n160:### C03 implementation: the first synchronous scan\n262:### Native transport policy\n303:### C02 implementation: contexts, credentials and transport\n410:## Fresh editor input and Configuration review\n481:## Tauri contract and admission\n518:## 2. Academy-owned shared presentation\n565:### C04 implementation: Academy identity and learner transport\n654:### C05 implementation: Academy catalog, lessons and knowledge checks\n756:### C06 implementation: graded workflows, Program and the learner account\n874:### C07 implementation: encrypted offline work\n997:### C08 implementation: management onboarding and Runtime/DLP reads\n1091:### C09 implementation: reviewed Runtime changes and one-time secrets\n1160:### C10 implementation: supported DLP authoring and multipart workflows\n1202:### C11 implementation: Sessions investigations and metadata-only reports\n1251:### C12 implementation: Case Library and Runtime Home/Inbox observations\n1288:### C13 implementation: Red Team and Model/skill observation\n1338:### C14 implementation: API Client projects and documents\n1366:### API Client execution (C15)\n1429:### C16 implementation: Gateway workspace and configuration reads\n1470:### C17 implementation: reviewed Gateway changes and provisioning\n1533:### C18 implementation: Gateway inference, observation and Home/Inbox\n1630:### C19 implementation: the native Harness runtime and lifecycle\n1678:### C20 implementation: company sign-in, renewal and protected history\n1738:### C21 implementation: desktop tools, project folder, approvals and proposals\n1792:### C22 implementation: workspace MCP servers\n1849:## 3. Native Harness, identity and protected storage\n1886:### Harness refresh and in-session continuity\n1935:### MCP token rotation and native conversation scope\n2053:## 4. Managed workbench execution\n2107:## Validation and remaining gates\n    // own load superseded the import): kept for that draft, shown when its document shows.\n    const lateNotes = useRef<{ id: string; notes: ImportNote[] } | null>(null)\n    // The collection the shown document was loaded from: another collection's document is never reused for a request\n    // with the same id (attempt-03 R1).\n    const docCollection = useRef<string | null>(null)\n    type Load = { gen: number; asked: string | null; id: string | null; relative: string | null }\n    const beginLoad = (id: string | null, relative: string | null = null): Load => {\n        const gen = ++loadGen.current\n        loading.current = id\n        setLoadFailure(null)\n        return { gen, asked: collectionRef.current, id, relative }\n    }\n    /** Shows a load's document if the load is still current; a failure of a selected request's load is shown with its reason. */\n    const settleLoad = (load: Load, r: Awaited<ReturnType<WorkbenchCall>> | null, keepNotes: boolean): boolean => {\n        if (load.asked === null || load.asked !== collectionRef.current) return false\n        if (load.gen !== loadGen.current) {\n            // Superseded, but a current import's report is not lost: when the reply's document is the selected request\n            // (its snapshot came first and its own load took over), its notes are shown with that document.\n            if (keepNotes && r?.kind === 'document' && r.notes.length > 0 && selectedRef.current === r.document.id) {\n                // Shown now if that document is already up (the editor renders only for the selected document), else\n                // when its own load lands.\n                lateNotes.current = { id: r.document.id, notes: r.notes }\n                setNotes(r.notes)\n            }\n            return false\n        }\n        if (loading.current === load.id) loading.current = null\n        if (r?.kind === 'document') {\n            setDoc(r.document)\n            docCollection.current = load.asked\n            setDocSeq((n) => n + 1)\n            setNotes(keepNotes ? r.notes : lateNotes.current?.id === r.document.id ? lateNotes.current.notes : [])\n            if (lateNotes.current && lateNotes.current.id !== r.document.id) lateNotes.current = null\n            return true\n        }\n        // The failure names the request it was for: the core keeps the previous selection when a read fails, so a\n        // tree entry's failure must show without that request ever being selected.\n        if (load.id !== null && load.relative !== null && r?.kind !== 'cancelled') setLoadFailure({ id: load.id, relative: load.relative, text: (r && resultText(r)) ?? C.unknownFailure })\n        return false\n    }\n\n    const selected = collection?.selected ?? null\n    const selectedTab = collection?.tabs.find((t) => t.id === selected) ?? null\n    // The core's selection is followed when it changes, not re-asserted against the document shown: after + the\n    // draft is shown from the core's reply before the snapshot naming it selected arrives, and re-opening the\n    // previously selected request in between made the core select that one again (the draft's tab lost).\n    const followed = useRef<string | null>(null)\n    // Following is scoped to one open collection: closing it forgets the followed selection, so the same\n    // collection re-opened with its persisted selection opens that request again (the editor was left blank).\n    const collectionId = collectionKey\n    useEffect(() => {\n        // A collection boundary (closed, re-opened, or replaced by another collection) retires every load in flight\n        // (its reply is ignored), the loading marker and the document shown: the editor never shows one collection's\n        // fields under another, even when both select a request with the same id (attempt-03 R1), and the new\n        // collection's selected request is loaded afresh.\n        followed.current = null\n        loadGen.current += 1\n        loading.current = null\n        setLoadFailure(null)\n        setDoc(null)\n        setNotes([])\n        lateNotes.current = null\n    }, [collectionId])\n    // Opens a request (the selected tab, or a tree entry); only the latest load's reply counts.\n    const open = (tab: { id: string; relative: string }) => {\n        const load = beginLoad(tab.id, tab.relative)\n        void call({ kind: 'openRequest', relative: tab.relative }).then(\n            (r) => settleLoad(load, r, false),\n            () => settleLoad(load, null, false)\n        )\n    }\n    const openRef = useRef(open)\n    openRef.current = open\n    // The document whose editor is up: the editor owns newer fields and revisions, so once it has unmounted (the\n    // selection moved away) the retained DocumentView is obsolete and a return to that request reloads it from the\n    // core (the old snapshot remounted could be saved over a protected draft, or sent).\n    const editorFor = useRef<string | null>(null)\n    // The document whose editor was up and has since unmounted: obsolete, reloaded on return. A document that never\n    // had its editor up (an import's or a draft's reply shown ahead of its snapshot) is fresh and is reused.\n    const staleDoc = useRef<string | null>(null)\n    const editorUp = doc !== null && selectedTab !== null && doc.id === selectedTab.id\n    useEffect(() => {\n        if (!selectedTab || followed.current === selectedTab.id) return\n        followed.current = selectedTab.id\n        // A load of another request still in flight is obsolete once the selection moves on: its reply must not land.\n        if (loading.current !== null && loading.current !== selectedTab.id) {\n            loadGen.current += 1\n            loading.current = null\n        }\n        const reusable = doc?.id === selectedTab.id && docCollection.current === collectionId && staleDoc.current !== selectedTab.id\n        if (reusable || loading.current === selectedTab.id) return\n        // A stale document is not shown while its reload is in flight: remounted, its editor would start from the old\n        // fields and keep them when the fresh document arrived under the same key.\n        if (doc?.id === selectedTab.id) setDoc(null)\n        openRef.current(selectedTab)\n    }, [selectedTab, doc, collectionId])\n    // Recorded after the selection was followed, so that effect sees which editor was up before this render.\n    useEffect(() => {\n        if (editorUp && doc) {\n            editorFor.current = doc.id\n            staleDoc.current = null\n        } else if (editorFor.current !== null) {\n            staleDoc.current = editorFor.current\n            editorFor.current = null\n        }\n    }, [editorUp, doc])\n    const loaded = state.loaded\n    useEffect(() => {\n        if (!loaded) void call({ kind: 'load' })\n    }, [loaded, call])\n    // The collection menu closes on Escape (focus back on the chip) and on a click elsewhere.\n    useEffect(() => {\n        if (!menu) return\n        const onKey = (e: KeyboardEvent) => {\n            if (e.key !== 'Escape') return\n            setMenu(false)\n            chip.current?.focus()\n        }\n        const onClick = () => setMenu(false)\n        window.addEventListener('keydown', onKey)\n        window.addEventListener('click', onClick)\n        return () => {\n            window.removeEventListener('keydown', onKey)\n            window.removeEventListener('click', onClick)\n        }\n    }, [menu])\n# API Client and Test Cases\n\nSource: `R2App` (`REQ`, `hist`, `send`, `rawJson`, `CASES`, `packCases`,\n`caseRows` lines 1033–1037, `runScan`). Chunk: C33. Both are re-skins of the\nexisting workbench (C14–C15) and library (C12) modules to the layout rhythm.\nNo new remote capability is introduced.\n\n## API Client\n\n- Title row, request tabs (named requests per product), method/URL line with\n  the `get` colour, Send (32px), response pane with status, duration and\n  body; history list of immutable snapshots (I5) from the existing workbench\n  history.\n- After Send, a compact `role=\"status\"` region announces \"<request> · <code>\n  · <duration>\"; the JSON body is outside the live region.\n- Generic requests never bypass AIRS mutation authority (existing C15 rule):\n  a request that would change configuration is refused by the core as today.\n- The \"Show the calls\" panel reuses this response renderer.\n\n## Test Cases\n\n- Title row, filter by product, search, paged table (name, product, input,\n  last result as verdict colour + icon + word), pack-sourced cases carry\n  their pack name.\n- **Runtime-only execution boundary** (prototype lines 1035–1037, parity\n  matrix). A Runtime Security case offers \"Open in Playground\": it sets the\n  Playground's prompt, direction and profile and the operator runs the scan\n  there; the result is stored for the case as a local Playground run. A case\n  for any other product offers \"Inspect\" only: it opens the specification\n  and the recorded result, states which product runs it, and never\n  dispatches a scan or claims execution. Red Team cases say \"hand the spec\n  to a scan\"; no scan is started from this screen.\n- Starter-pack cases selected in the wizard are written at onboarding\n  completion as library entries with `Not run` results.\n\n## Fixtures and tests\n\n- Boards R2Api, R2Cases. Tests V2-R05, V2-T05; V2-T14 status region updates\n  after Send with the body outside the live region; V2-T15 non-Runtime rows\n  render Inspect, never Open in Playground, and clicking Inspect dispatches\n  no scan intent (asserted on the mock runtime); V2-T16 paging and filter.\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_33","type":"command_execution","command":"/bin/zsh -lc \"sed -n '1,275p' docs/planning/decisions.md; sed -n '1997,2212p' docs/planning/decisions.md; cat docs/architecture/ui-v2/provenance.md | tail -130\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_33","type":"command_execution","command":"/bin/zsh -lc \"sed -n '1,275p' docs/planning/decisions.md; sed -n '1997,2212p' docs/planning/decisions.md; cat docs/architecture/ui-v2/provenance.md | tail -130\"","aggregated_output":"# Interview decisions\n\n## D001 — Distribution and billing\n\nAccepted in interview round 1, Q1.\n\nThe product should support public distribution. The owner explicitly has no\ncommercial requirement and expects all billing constructs to be removed.\nDo not carry the earlier recommendation for future commercial flexibility into\nthe requirements as an accepted goal.\n\nThis is a product requirement, not a conclusion that every upstream module may\nbe copied or that a fork-retention condition can be removed. D008 settles\nselective adaptation; individual imports still require provenance evaluation.\nPreserve the learning fork's license and historical rebrand evidence.\n\n## D002 — Functional replacement\n\nAccepted in interview round 1, Q2.\n\nV2 should ultimately cover every working v1 workflow, including Harness, Academy,\ntenant administration, scanning, Gateway, reporting, and saved cases. Deliver\nthrough prioritized, testable slices. Explicitly classify existing previews and\nunfinished functionality rather than silently treating them as production work.\n\nThe owner proposed bringing the React Academy presentation into the application.\nRound 2 clarified that this means the same remote learning interactions with\nportable React presentation, rather than a rewrite of the hosted learning backend.\nSee D004–D006 for the clarified scope and UI direction.\n\n## D003 — First release platform\n\nAccepted in interview round 1, Q3.\n\nThe first supported release targets macOS Apple Silicon and ships as a signed,\nnotarized DMG. Intel Mac, Windows, and Linux belong to explicit later milestones.\nKeep portability in the design without representing untested targets as supported.\n\n## D004 — Academy learning integration\n\nAccepted/clarified in interview round 2, responses numbered 4 and 5.\n\nThe current desktop app already interacts with the remote Academy. V2 should\npreserve those remote interactions while sharing the existing React learner\npresentation. Academy remains the source of truth for its learner presentation\nand hosted learning backend. Desktop authentication and navigation need adapters;\nthe exact packaging/integration mechanism remains to be designed and reviewed.\nHosted grading, assessment timing, awards, and access authority remain hosted.\n\nThe response numbered 4 clarified Academy integration. It did not independently\nsettle the previous question about the extent of cdot-framework backend code reuse;\nthat decision remained open until D008 rather than being inferred from an\nunrelated answer.\n\n## D005 — Shared desktop visual foundation\n\nDirection accepted in interview round 2, response numbered 5.\n\nAcademy's React components, themes, and shell layout are the preferred UI/UX\nfoundation for the broader desktop application. Verify actual reusability during\nthe architecture review. Do not create a parallel, diverging copy of its learner\npresentation merely to achieve a shared appearance.\n\nThis direction does not approve importing the web authenticated entry point,\nmanager routes, browser session assumptions, or learning-specific global state\ninto the desktop root. The plan must distinguish shared presentation modules from\nAcademy feature behavior.\n\n## D006 — Gamification is Academy-local\n\nAccepted in interview round 2, response numbered 6.\n\nRemove financial billing constructs from v2. Preserve the Academy's learning\ngamification as part of that feature; do not apply XP, earned cosmetic credits,\nshops, awards, or progression to other desktop features. Academy is one feature of\nthe broader application. Sharing its shell, theme, or controls does not justify\nmounting its gamification state or account effects across the application.\n\n## D007 — Desktop delivery scope\n\nAccepted in interview round 2, response numbered 7.\n\nDesktop is the scope of v2. No browser application or speculative web adapter is\nan implementation deliverable. Do not introduce a new hosted AIRS application\nmerely because the presentation is React. Existing remote Academy and Prisma\nproduct interactions remain required where their workflows need them.\n\n## D008 — Focused Tauri/Rust desktop foundation\n\nAccepted in interview round 3, Q8 (owner: \"yes to all\").\n\nUse a Tauri Rust host with a focused Rust application core and direct calls to\n`scm-sdk-rs`. Selectively adapt useful cdot-framework modules and architecture\npatterns after suitability/provenance checks. Do not ship its media generation,\nbilling, MySQL, Redis, or inherited application server as desktop dependencies.\nThis settles the previously open backend foundation direction.\n\n## D009 — First complete workflow\n\nAccepted in interview round 3, Q9.\n\nProve an Academy-derived desktop shell, explicit tenant credential configuration,\na Runtime Security scan through the Rust SDK, and verdict presentation together.\nAcceptance includes success, denied access, timeout, cancellation, and tenant\nswitching during a request. Select an accepted SDK capability/revision for this\nslice; do not depend on unrelated SDK families being complete.\n\n## D010 — No bundled Node/Bun backend runtime\n\nAccepted in interview round 3, Q10.\n\nThe shipped application contains no Node/Bun runtime or TypeScript backend\nworkers, including Academy, Harness, and MCP authentication workers. React's\nJavaScript runs in the WebView. Build-time JavaScript tooling is distinct from a\nshipped backend runtime.\n\nPreserve the existing native Rust Harness engine and evaluate whether the managed\nCLI can be omitted after replacing host workers and resealing the package. Do not\ninfer that a full CLI or agent-engine rewrite is necessary. User-approved external\ndevelopment tools are a separate concern, not permission to smuggle a required\nbackend runtime into the distribution.\n\n## D011 — V1 coexistence and reviewed import\n\nAccepted in interview round 3, Q11.\n\nV2 installs alongside v1 with a separate application identity, protected credential\nentries, and local data. Offer explicit reviewed imports rather than sharing\nmutable state. Preserve v1 throughout validation and exercise import rollback.\nAcademy uses the same remote learner account and progress. D015 settles import\ncategories and fresh-sign-in direction; exact identity strings and history\ncompatibility still require specification and qualification.\n\n## D012 — Dedicated v2 repository\n\nAccepted in interview round 4, Q12, with exact owner-specified destination:\n\n- Repository: `ssh://git@git-ssh.cdot.io/cdot/prisma-airs-desktop-v2.git`.\n- Checkout: `/Users/cdot/development/redtail/prisma-airs-desktop-v2`.\n\nKeep v1 intact as behavioral reference. Academy, the SDK, native Harness, and\ncdot-framework remain independently maintained inputs, consumed at pinned\nrevisions or through reviewed shared presentation modules.\n\nRead-only preflight found the new checkout already initialized on `main`, with\nthe exact origin and no worktree files. The remote advertised no branches.\nPlanning records were moved here from the framework checkout. This does not\nauthorize application implementation before the agreed planning/architecture gates.\n\n## D013 — Scan-key-first onboarding\n\nAccepted in interview round 4, Q13.\n\nThe first scan supports an explicit scanning API key without requiring management\nOAuth credentials. Support scan-only tenants. Management credentials are separate\nand added for administration workflows; a management registration does not\nimplicitly supply scan authentication. Additional scan credential modes must be\nspecified and tested when needed, not inferred from an SDK constructor.\n\n## D014 — Rust application authority\n\nAccepted in interview round 4, Q14.\n\nRust owns tenant context, credential access, request lifecycles, and permission\nto apply configuration changes. React presents drafts, reviews, and results.\nConfiguration review binds the tenant, credentials, resource, and draft; changed\ncontext invalidates it. Harness proposals enter the same operator review flow\nand cannot authorize Apply. Initially preserve the existing Harness project/tool\nrestrictions; expansion would require a separate explicit design decision.\n\n## D015 — Import work, reestablish authentication\n\nAccepted in interview round 4, Q15.\n\nImport selected user-authored work and settings, including saved cases, reports,\nAcademy drafts, API Client projects, and historical conversations. Require fresh\ncredential setup and sign-in. Regenerate disposable caches/downloads. Imported\nconversations are inspectable history until resumption compatibility is validated;\nold pending approvals and authentication sessions never transfer.\n\nReading protected source work for an explicitly selected import is distinct from\ntransferring its old authentication credentials. Define restartable import\nreceipts, version/account checks, rollback, and source-preservation tests.\n\n## D016 — Explicit offline behavior\n\nAccepted in interview round 4, Q16.\n\nOffline mode supports local drafts, saved work, history, and valid downloaded\nAcademy content. Online operations require explicit retry after reconnection.\nDo not silently replay configuration changes, scans, grading submissions, or\nother remote actions. Preserve unknown/uncertain outcomes rather than asserting\nthat cancellation or disconnection undid remote work.\n\n## D017 — Operational usage/cost administration\n\nAccepted in interview round 4, Q17 (owner: \"absolutely\").\n\nRetain Gateway usage, cost, budget, and limit views as Prisma AIRS administrative\nfunctionality. These describe the systems the operator manages. They do not add\ndesktop checkout, invoices, paid subscriptions, or monetization machinery.\n\n## D018 — Ordered capability delivery\n\nAccepted in interview round 5, Q18.\n\nAfter the scan proof, deliver Academy; Runtime/DLP/Sessions/Library; existing Red\nTeam/Model Security reads and API Client; Gateway; Harness/MCP; imports and final\npackage qualification. Split groups into small independently testable/reviewable\nchunks with explicit SDK prerequisites. The implementation plan assigns C01–C26.\n\n## D019 — Independent multidimensional review\n\nAccepted in interview round 5, Q19.\n\nActual independent Claude Code review must score at least 9/10 overall and in\narchitecture, behavior, authority/security, and validation. No required fixes or\nmissing mandatory evidence. Preserve reviewed revisions/dependency pins, raw\nverdicts, commands/results, remediation and review attempts. No aggregate score\ncompensates for a weak critical dimension. Scores are not executable evidence.\nD026 changes the reviewer identity from C01 onward and adds phase reviews; the\nthresholds and evidence requirements of this decision are unchanged.\n\n## D020 — Native quality and measured budgets\n\nAccepted in interview round 5, Q20.\n\nmacOS menus/shortcuts, keyboard navigation, focus, VoiceOver, and shared Academy\nthemes are release requirements. Measure startup, responsiveness, memory, and\npackage size. Establish named workload-specific numeric budgets during the first\ncomplete slice before broad feature rollout. Do not invent passing measurements.\n\n## D021 — Local redacted diagnostics\n\nAccepted in interview round 5, Q21.\n\nDesktop diagnostics are local/redacted with explicit export; no automatic analytics\nor crash upload. Credentials/raw customer content stay out of diagnostic logs.\nProtected conversation/case storage is intentional product behavior, distinct\nfrom diagnostics. Existing hosted operations keep their normal server records.\n\n## D022 — Stable release and preview distinction\n\nAccepted in interview round 5, Q22.\n\nStable v2 requires agreed working-v1 parity, controlled live acceptance, verified\nNode-free installed application, signing/notarization, coexistence/import/rollback\nchecks and no missing mandatory evidence. Earlier preview DMGs may demonstrate\nreviewed milestones with incomplete scope clearly identified. Keep v1 available.\n\n## D023 — Manual signed updates first\n\nAccepted in interview round 5, Q23.\n\nThe initial release uses manually installed signed DMG updates with documented\nrollback. An in-app updater is a separate later design/signing/validation milestone.\n\n## D024 — New-source distribution terms\n\nAccepted on 2026-10-16 through the architecture-work question:\n\"Apache-2.0: public source with upstream notices retained (Recommended)\".\nApply Apache-2.0 to newly authored owner-controlled v2 material. Upstream code\nretains its own terms/notices; this does not relicense Academy or the framework.\nThe product still has no billing/monetization requirement.\n\n## D025 — Architecture selection and report rendering\n\nAccepted on 2026-10-16: \"All four: Rust authority → shared presentation → native\nHarness → workbench admission (Recommended)\". The owner also confirmed \"Yes,\nit renders\" for the four candidate cards and before/after diagrams. This is\nowner visual confirmation; browser automation remained unable to inspect local\nHTML. Record implementation recommendations and independent review separately;\ncandidate selection is not a passing implementation/package test.\n\n## D026 — Codex independent review of every chunk and phase\n## D050 — Reviewed v1 import: source contract, mapping, receipts and rollback\n\nDecided in C23 (implementer decision for the C23 milestones, recorded for\nreview).\n\n**Source.** v1 (74754c02) has no whole-application export, so the import\nreads v1's own storage, read only:\n- **Files** under v1's folder: `~/Library/Application Support/Prisma AIRS\n  Desktop/` in production builds; fixture builds use `fixture-v1/` under\n  their data root and never a real v1.\n- **Keychain items** in v1's service `io.cdot.prisma-airs-desktop`,\n  through a type that can only read (no add, change or delete exists). In\n  production builds it is the login Keychain, and macOS asks before each\n  item is read; that prompt is the platform grant for a protected read.\n  Fixture builds read a staged file keychain without prompting and never\n  the login Keychain.\n- Every path component is checked without following links, files are\n  opened `O_NOFOLLOW`, and only exact names are read: digest-named Academy\n  folders and `attempt-<digest>.bin` records. Nothing is created in v1's\n  folder; v1's Academy `.lock` files are never opened.\n\n**Source lock.** v1 holds `.desktop-instance.lock` exclusively while it\nruns. The import takes it shared, never creating it, from the review until\nthe import settles. v1 running is `sourceLocked`, and v1 cannot start\nduring a review. Each item records the SHA-256 of what it was read from.\nBefore an item is written, a file it came from is read again, and changed\nbytes are `sourceChanged`: nothing of it is written.\n\n**Limits.**\n\n| Source | Limit |\n|---|---|\n| `tenants.json` | 128 KiB, version 1, at most 64 tenants |\n| `fpfn-reports.json` | 4 MiB, version 1 |\n| `appearance.json` | 4 KiB |\n| A credentials item | 64 KiB |\n| A cases item | 256 KiB, at most 32 cases |\n| A history item | 8 MiB, archive and snapshots version 1 |\n| An Academy record | 16 MiB, at most 4,096 entries per account |\n\nOver a limit is `tooLarge`, another version is `unsupportedVersion`, and\nunreadable or unauthenticated data is `corrupt`. A selected category that\nis missing, unreadable or denied is shown blocked with its reason: nothing\nis silently skipped.\n\n**Two steps.**\n- Inspecting reads files only and counts what they show. What only a\n  Keychain read could tell is shown as not yet counted.\n- Planning reads protected items only for the selected categories, and\n  only for v1 tenants given a target.\n\n**Mapping.**\n\n| v1 | Imported | Not imported |\n|---|---|---|\n| `tenants.json` tenant | A new keyless tenant (label and TSG ID, C02's validation), or the operator's choice of an existing tenant with the same TSG ID | Environment, storage mode, credential reference, Gateway key references and preferences |\n| `credentials-{ref}` | Only the scan endpoint, as a destination: a region's origin, or a plain HTTPS origin | Every secret field (decoded only into a one-field structure), other endpoints. An unmappable or unreadable endpoint leaves the default region, and the item says why |\n| `appearance.json` | Light, dark or system | Theme family, time zone |\n| `navigation.json` | — | Not read (no v2 equivalent; shown) |\n| `cases-{tenant}` | Cases, rebound to the v2 tenant and validated (D038) | Session-only tenants (none stored), accounts v1 was retiring |\n| `fpfn-reports.json` | Reports | A sub-request beyond v2's range (counted) |\n| `academy-local/…` with its key | Unsaved drafts of the signed-in account, with v1's draft version as base | Downloads (Academy gives them again), saved or conflicting attempts |\n| `api-client/` | Recent collections, as C14's adoption adds them | Private environments: adopted through the API Client (C14). Secrets, drafts, history |\n| `harness-history-{ref}` | Each conversation's transcript, inspect-only | v1's engine replay, options, credential references. Approvals are shown declined, \"not transferred\" |\n\nNo credential, session, sign-in or approval is ever transferred:\n- imported tenants start with every capability missing;\n- Academy drafts need the same account signed in (its digest equals v1's\n  folder name; signed out is `signInRequired`, another account is\n  `accountMismatch`);\n- an existing tenant can be a target only when its TSG ID equals v1's.\n\n**Imported conversations.**\n- Each is saved with `origin: importedV1`, no restore point, and a binding\n  that can never equal a live one.\n- It reads `imported`: it can be read and exported, never continued.\n- Its scope is noted before its first write like any history save, and the\n  16-conversation cap holds (`destinationFull`; nothing is evicted).\n\n**Review.**\n- Each item is `ready`, `alreadyPresent` (v2 holds exactly v1's content\n  under the same identity), `conflict` (v2 holds different content; it is\n  never overwritten) or `blocked` with its reason.\n- Items show how many entries are new, present, in conflict or not\n  imported.\n- A review is used once. New tenants get their identity at review, so the\n  review, the receipt and a resumed import name the same tenant.\n\n**Receipts: the import's commit record.**\n- An import writes a receipt in two copies, `<data root>/imports/<id>.json`\n  and then `<data root>/imports.copy/<id>.json`: each 0600, replaced\n  atomically, and synced with its directory. A note is recorded only when\n  both copies and their directories are synced; anything less is\n  `notRecorded`, and nothing is written on it. A receipt is read from its\n  first copy, or from its second when the first is damaged or its folder\n  cannot be listed (the second is written last, so it never runs ahead of\n  the first). A missing folder holds no receipts; one that exists but\n  cannot be listed (or an entry of which cannot be read) is not taken for\n  empty, and a missing folder never stands in for an unreadable one.\n- The commit binding: while a receipt has not settled, every note also\n  writes a copy of it into the saved document (`openImports`), after both\n  files; settling removes the copy. A note is recorded only once that save\n  is confirmed durable. At launch, an unsettled receipt its files no longer\n  give (both damaged, or neither folder listable) is taken from the\n  document, so what it names stays hidden and its rollback runs; a copy\n  whose files say it settled is dropped (the files are newer). Losing the\n  document itself already makes local storage unavailable, and then\n  nothing local is shown or written. The field is present only while an\n  import is unsettled.\n- A document copy is checked as a receipt file is, when the document is\n  loaded: the current receipt schema, a valid ID named once, at most\n  `MAX_RECEIPTS` copies, and unsettled (the field's invariant). Any other\n  copy makes the document inconsistent, so it loads as damaged: nothing\n  in it is shown, published or saved, no rollback is driven by it, and the\n  document, the receipt files and the owner stores stay as they were for\n  the operator.\n- Inside the section that makes each owner write (the local-data writer\n  with the placement lock for cases and reports, the API Client's lane, the\n  saved document for tenants and appearance, the account's offline store\n  for drafts), the item is first noted `writing` with exactly the entries\n  it is about to add: only what that owner does not hold at that moment.\n  No other writer comes between the note and the write. The item is then\n  noted `applied` with the entries its owner confirms it added (`written`,\n  each with its content hash), kept apart from what it intended.\n- What an import adds is marked as its own where the owner allows: a new\n  tenant's identity is issued at review; a conversation is saved with\n  `origin: importedV1` and only while its scope holds no record of that\n  ID; a draft only while its attempt has no draft, with the receipt's ID\n  in it. A matching hash alone never makes an entry the import's.\n- Until the receipt is noted `applied`, every entry it names is hidden\n  from every view (tenants, appearance, the case library, reports, the\n  Harness history list, the API Client's recent list, Academy's kept\n  drafts and their reads) and the views show the previous generation. The\n  `applied` note is the commit: the receipt and its entries are published\n  together, in one step. Nothing it names gives authority meanwhile either:\n  its new tenant cannot be selected or be the active one, is not offered\n  as an existing target, and its conversation cannot be opened or resumed\n  by its ID.\n- Intents that write or export what an import writes wait (`busy`) while\n  an import or its rollback runs and until every receipt has settled\n  (`applied` or `rolledBack`): a rollback that could not finish (its\n  owner refused, at launch or later) keeps its receipt unsettled and what\n  it names hidden, and the wait lasts until a retried rollback settles it.\n  Nothing else can therefore write an entry the receipt names, so treating\n  an item that stopped while `writing` as having written its entries\n  never claims another writer's work.\n- A settled receipt readable in neither file, or receipt folders that\n  cannot be listed with nothing standing in, leave the inventory unknown\n  (what they named is committed or undone, so nothing is staged by them).\n  The app fails closed all the same: the same intents wait, no new import\n  or Import Again starts, and the import view names the lost record or\n  says the folders cannot be read, by alert. Restoring access and\n  reopening the app lists them again (a launch rollback's own writes\n  restore its folders' permissions, and the inventory is read again when\n  it ends). A lost record is released only by the operator removing it\n  (`forgetV1ImportReceipt`), which leaves whatever that import wrote as it\n  is and no longer roll-backable.\n- An import is whole or nothing. An item that cannot be written (its\n  source changed, its owner refused, its note was not recorded) rolls the\n  whole import back at once, without asking.\n- An import the app ended during is rolled back at the next launch, before\n  any intent is admitted: what it wrote, and what an item noted `writing`\n  may have written, is removed where v2 holds exactly that. The receipt\n  then reads undone (`interrupted`), and Import Again (`resumeV1Import`)\n  reads v1 again, requires the same bytes, and writes every item anew,\n  again only what v2 does not hold.\n- At most eight receipts are kept. A new import waits while one is\n  unsettled or eight are kept, so the ability to roll back is never\n  dropped silently.\n- Reset waits for an import or rollback under way, then removes receipts\n  with the data they describe.\n\nHow this meets the import contract of DESIGN §3 (\"reencrypt selected work\ninto a new v2 generation … atomically commit … preserve the previous\ngeneration for rollback … an interrupted import cannot expose a partially\ncommitted generation\"): v2 has no single store to swap, so each owner keeps\nits own sealed files and the receipt is the import's manifest. The staged\nentries are written through each owner but are not part of any view until\nthe receipt commits, and commit publication is one step; the previous\ngeneration is everything v2 held, which the import never overwrites (a\ndifferent entry under the same identity is a conflict); and an interrupted\nimport is rolled back before anything can see or build on it.\n\n**Writes go through each owner.**\n- Tenants and appearance: the saved document.\n- Cases and reports: the local-data writer that library and report\n  writes, tenant deletion and reset take, under the placement lock. An\n  open library or book is changed in memory and written as its newest\n  generation; one that opened during the write gets the same change in\n  memory, and one still loading reads again.\n- Drafts: the planned account's own offline store, only while that\n  account is signed in (another account, or none, is `accountMismatch` or\n  `signInRequired`, at review, at write and at rollback).\n- Collections: the API Client's lane.\n- Conversations: an admitted history save.\n\n**Rollback** (after the native confirmation for an applied import; at\nonce for one that failed or that the app ended during):\n- Its entries are hidden while it runs and go together.\n- Removes each entry only while v2 still holds exactly what the receipt\n  wrote, checked inside the owner's own section (a draft only for its\n  account, with the receipt's mark; a conversation only with its import\n  origin). One changed since is kept (`keptChanged`), one already removed\n  is `gone`.\n- Tenants go last, through Delete Tenant, and only while nothing else of\n  them exists: no credential, sign-in, project, server, case, report or\n  conversation.\n- A rollback that cannot finish (its note not recorded, or an entry it\n  cannot check now, such as a draft while another account is signed in)\n  stays unsettled and hidden; it finishes when asked again or at the next\n  launch.\n\n**Out of scope here:** private API Client environments (C14's adoption\nkeeps them); v1 settings with no v2 equivalent; live qualification against\na real v1 profile (C25).\n\n# Provenance and intentional deviations\n\nEvery fixture file and screen contract cites the frozen prototype file and the\nprototype state names it derives from. This file lists where the\nimplementation deliberately differs from the prototype and why. Anything not\nlisted here is expected to match the prototype's behaviour and spacing.\n\nFrozen reference: canvas https://claude.ai/artifact/2SEXT1XMHdZkxHvdw8oaYL,\npage \"Refined Native v2\", version 134 (version id 1793059808-4929, published\n2026-10-26). Files and hashes: [prototype/MANIFEST.sha256](prototype/MANIFEST.sha256).\n\n| # | Prototype | Implementation | Reason |\n|---|---|---|---|\n| P1 | Wizard tenant step draws the scan key, management client secret and Gateway workspace key as text fields (`R2Onboard` `f.scanKey`, `f.secret`, `f.gwKey`) | \"Add scan key…\" button opens the host's native secret sheet; the step then shows a masked indicator and the vault record id | The web layer never holds a secret (D014, C09 reveal ownership). Visual delta: button plus masked state instead of a field |\n| P2 | Rotation panel renders the secret in a readonly input with Reveal/Copy (`R2App` `secretShown`) | Reveal shows the secret in the host secret sheet; Copy goes through the host clipboard; both consume a one-time disclosure token | Invariant I6; same reason as P1 |\n| P3 | State lives in one component with `byTenant` (`R2App` `TS/ts/tPatch`) | Core-owned scopes per [state-ownership.md](state-ownership.md) | D014 authority; prototype state model is normative for invariants only |\n| P4 | ⌘1–⌘9 are advertised but not bound (canvas rule: no global key handlers) | Native menu defines the shortcuts and dispatches `navigate` | Host owns menus; works under VoiceOver and shows in the menu bar |\n| P5 | Sidebar lists Home, Inbox, Harness, Academy, Test Cases, API Client, Administration | Same, backed by Rust feature ids `home`, `inbox`, `harness`, `academy`, `library`, `apiClient`, `administration`; `gateway` and `redTeam` move inside Administration; `sessions`, `import`, `settings` reachable from the palette and Administration | One Rust inventory feeds menu, sidebar and palette |\n| P6 | Wizard boards are 1440×900 with a fixed 320px rail | Minimum window 1180×720; rail collapses to icons below 1280 wide | 13-inch displays |\n| P7 | Toasts expire on timers always | Persist until dismissed under Reduce Motion | Native acceptance Reduce Motion check |\n| P8 | Inbox items, Harness lifecycles, API responses, cases and Academy progress are invented in-component data | Wire fixtures in `packages/desktop-contracts/fixtures/wire`, content derived from the prototype data | Fixtures are the contract test surface; prototype data is never shipped |\n| P9 | `TOPICS.injo` added in round 16 as a separate key from detector `inj` | Core topic inventory keys are a distinct type from detector ids | Carries the round-16 fix into the type system |\n| P10 | Administration creation label is a per-product single value | Per-tab creation capability and label in `AdminInventory` | Round 16 finding: wrong label on API keys, Security profiles and Logs tabs |\n| P11 | Home snooze button hard-codes \"Snooze 24 hours\" | Item-specific `snoozeLabel` shared by Home and Inbox | Round 16 finding; invariant I11 |\n| P12 | API Client Send has no live completion status | Compact `role=\"status\"` region with request name, response code and duration; JSON body outside the live region | Round 16 finding |\n| P13 | Tenant switch with an open applied key review leaves disclosure open | Any review exit, including switch, finalises disclosure | Round 16 finding; invariant I6 |\n| P14 | Applied injection-override examples show \"Not demonstrated\" in the Playground | Topic examples classify under the topic key with a profile-aware verdict | Round 16 finding |\n| P15 | Import from v1 is a separate destination | Also offered on the wizard tenant step as a secondary action; credentials re-entered via the secret sheet | First run is where an upgrading user needs it |\n| P16 | Harness lifecycle 2 (mcp) reads an AES endpoint inventory (`CONVOS.mcp.tool` = `aes-inventory/get_endpoints`) and its follow-up is an AES policy review | The fixture reads the workspace MCP server inventory the core already exposes (`GatewayRead::McpServers`, C22) and the follow-up opens a Gateway guardrail review (`ChangeKind::GatewayGuardrails`) | AES has no admitted service (P18); the lifecycle stays read-only as in the prototype |\n| P17 | Wizard tenant step requires a management OAuth client id and secret (`ERR.clientId`, `ERR.secret`) and makes the scan key optional (`scanOn`) | First run requires the scan key and makes the management client an optional second section; add mode keeps both optional. Secrets enter only through the host secret sheet | D013 (scan-key-first; management credentials are separate and never imply scan authentication) |\n| P18 | Six products are verified, inventoried and administered (AIS tool policies, AES discovered AI and policies, AES policy review `REVIEWS.aes`) | Only products with an admitted service are verified, inventoried or changed: Runtime Security (`ManagementResource`, `ChangeKind`), Gateway (`GatewayRead`, Gateway `ChangeKind`s), Red Team and Model/skill reads (C13, read-only). Agentic Identity Security and Agentic Endpoint Security render as \"Not available in this release\" with their dependency gate; no inventory, verification result or mutation is invented for them | The existing interfaces do not supply those product APIs; fixtures cannot establish a capability (parity matrix, C13 rule) |\n| P19 | Wizard Academy step creates a local account with streaks, reminders and a quiz (`s.acad`, `s.af`, `s.streaks`, `s.remind`, `s.quiz`) | The step signs in to the hosted Academy identity or skips; the embedded learner view owns progress and gamification | D004–D006, C04 |\n| P20 | Key rotation issues a new key with a 24-hour grace period, a later revocation and a secret recoverable from the Keychain (`REVIEWS.key`, `keyRotated/keySecretClosed/keyDeployed/keyDoneAt`) | Two admitted operations in sequence: `ApiKeys · Version` (additional key, one-time reveal through the existing `RevealSecret` host sheet, never persisted) → local deployment acknowledgement → `ApiKeys · Delete` of the old key with readback. Two distinct timestamps; a lost secret means \"issue another key\" | `changes.rs` 842–846 and `management.rs` 980–988 define Rotate (regenerate, no grace) and Version (additional key); DESIGN.md \"Secrets\" forbids persisting issued keys |\n| P21 | Test Cases \"Run\" was described in the first spec draft as scanning any case | Runtime-only \"Open in Playground\"; \"Inspect\" for every other product, which never dispatches a scan | Prototype lines 1035–1037 and the parity matrix (no invented execution) |\n| P22 | Red Team Targets tab lists target names (`rtm` tables) | Targets shows `target_id` and `target_type` only | The C13 contract (`red_team.rs` 5–8, 56–66) deliberately keeps target names out of the core's reads; the privacy boundary is not widened for presentation |\n| P23 | One rotation flow for every key | Staged Version → Delete rotation for Runtime API keys only; Gateway keys use `Rotate` (regenerate in place) | `gateway_changes::allowed` admits Rotate, not Version, for Gateway keys |\n| P24 | Minimum window 1180×720 (DESIGN-V2 §4, tokens.md) | The host keeps `min_inner_size(900, 600)` until C34 because C01-N09 (re-run cumulatively by C24-N06) pins the legacy minimum; the v2 shell is laid out to stay usable without horizontal scroll at 900×600 (rail collapsed to icons below 1280 CSS px) and C28-N07 asserts it at that size. C34 raises the minimum together with the legacy-script retirement | Legacy native acceptance must keep passing while both shells exist (D058 §5) |\n| P25 | Revision of P1/P2: \"secrets enter only through a host secret sheet\" | The retained, reviewed entry path (C02/C09) is a webview password field read through a ref, cleared immediately and sent once inside the intent as `EnteredSecret` (zeroized, never in React state, never logged); the host owns the *reveal* sheet (`RevealSecret`) and the clipboard. C29 uses exactly this path for the scan key, management secret and Gateway key; no new host entry sheet is built | The C27 spec assumed an entry sheet the host does not have; the reviewed pattern already satisfies D014 and the C24 canary checks (no secret in any AX tree or file) |\n| P26 | `verifyTenantSetup` as one core intent streaming `VerifyStep`s (wizard.md) | Implemented as specified: `verifyTenantSetup{context}` runs in the core over the draft, admits the reads it needs through the management pipeline (management verify; the chosen Gateway workspace's prerequisites, or only the listing when none is chosen, reported as incomplete coverage; Red Team; model/skill) and settles each line from the result; AIS/AES are listed as not available and never read; the lines, `done`, `failed`, `blocking` and `stale` stream through `ShellSnapshot.setup.verify`. The scan key has no admitted read: its line is `stored`, never `pass`. Only the scan key (first run) blocks; an optional service's failure is carried as a warning the operator may continue over | Attempt-01 composed the reads in the presentation; attempt-02 read only the workspace listing and blocked on every failure — both rejected |\n| P27 | Add-tenant Cancel writes nothing except an already-vaulted credential | The wizard works on a core-owned draft (`beginTenantSetup`) with its own context and its own Gateway listing and choice; credentials attach to the draft; nothing is listed as a tenant (a draft id is refused by `selectTenant`/`deleteTenant`), the active tenant and its Gateway choice are untouched until `completeTenantSetup` commits the draft in one step and switches once. Every change to the draft's credentials or profile retires its context (and the binding, reads and listing under it). Cancel (`discardTenantSetup`) drops the draft, retires the binding and every read under its context and workspace reference, and queues its Keychain records for cleanup; the sheet closes only once the core admits it (a creation still pending or unconfirmed is awaited and whatever it produced is discarded). A relaunch, or a tenant committed outside the wizard during first run, does the same | Stronger than the spec's leftover credential: no orphan secrets and no cached authority surviving a replaced credential |\n| P28 | Gateway workspace key entered on the wizard tenant step | Implemented: an optional section reads the workspaces through the management client (`management` gateway inventory on the draft context), `selectGatewayWorkspace` chooses one, and `configureInferenceCredential` saves the endpoint and key for it | The admitted sequence (list → select → key) runs on the draft like on a tenant |\n| P29 | \"Import from v1\" fills the tenant step in place | The action navigates to the reviewed import destination (C23), which renders on its own during first run with a 'Back to setup' control; the wizard resumes afterwards | The import review flow is itself reviewed and must not be duplicated inside the wizard |\n| P30 | The wizard opens whenever onboarding is not done | The shell shows onboarding as done whenever a tenant already exists (an upgrade, or a tenant created before the v2 shell was chosen); the stored state is untouched. A first run is one with no tenant yet; a relaunch mid-setup reopens at the Tenant step with a fresh draft (the previous draft's credentials are cleaned up) | Existing users must never be sent through the wizard; a half-made draft is never a tenant |\n| P31 | Products step shows licence state read from the tenant | No admitted service reports licensing (DESIGN-V2 §6); each card shows what it reads with (scan key / management client, saved or not) and, once verified, that product's verify result; a note says licence state is not readable through the public APIs | Nothing may be inferred about licensing from reads that do not report it |\n| P32 | First-run import returns to the wizard | A v1 import during first run commits its tenants through the reviewed C23 flow; the desktop then has a tenant, so the first-run draft ends (its credentials are cleaned up) and the shell opens on the imported tenant; its scan key is added in Administration (the reviewed C08/C09 credential setup) | A tenant that exists is never sent back through a first-run wizard (P30), and the wizard cannot wrap an existing tenant without duplicating it |\n| P33 | `ReadStatus` as its own core scope with per-product states from dedicated reads | `readTenant` admits one finite read per chosen product through the existing management pipeline: the Runtime overview the shell already owns (sessions chart, key inventory, the chosen Gateway workspace's usage and limits), the Red Team statistics and scan list (C13's read), the model scans, skill statistics and skill scans (C13's read); each settles into the tenant's read record as a per-source outcome (read, needs a role, failed); a source counts as read only when it established what it is for: a listing whose page is the inventory (not capped, nothing beyond the first page), a sessions chart with consistent totals, a key page with every expiration reported, Gateway usage with the day's requests and errors both known; anything less is named in `sourcesMissing` (the same gaps the Inbox shows). A product attempt that established nothing (every source failed, or the read never reached the service) is kept as the latest failed attempt beside the product's last outcome that did, which stays shown as older; the read is failed while such an attempt is the latest (a missing role is a settled attempt reported on the product, not a failed read). Once anything was attempted, every chosen source nothing has reached yet is named as unread coverage too, and `settledAt` carries the time of the latest attempt so a completion that established nothing is announced for when it settled, never as a first read still pending. A healthy empty read older than the ten-minute window (`OverviewView.fresh`, C12) is a gap: Home and the Inbox keep the cached read and name its age instead of an all-clear, never re-reading on their own; a refresh in progress keeps that read and its age named until the new read lands (admission restores nothing). A chosen Gateway with no workspace is unread coverage, named in `sourcesMissing`; `recheckProduct` re-reads one chosen product. The read completes (one generation) when every part admitted under the tenant's current context has landed; a read in which no source answered is a failed read (`failed`, with `failedAt`), never pending and never done, and a failed refresh keeps the earlier read labelled as older | No second read pipeline, and Home never claims coverage a read did not establish (I4): revised after the C30 attempt-01 review, which found selected Red Team and model/skill products left unread and a workspace-less Gateway announced as complete |\n| P34 | Inbox items with `kind`, `severity` and `explanation` per item | `InboxEntry` carries the overview item (Runtime, Gateway) or the C29 setup warning with its hold (listed, with every action, whatever the read status: a warning exists before any read); the explanation is per kind in the presentation's copy, not invented per item; `deadline` is absent (P20). Its action carries an `InboxTarget` (destination, product, Administration inventory, item name): a key item opens Administration on the API keys inventory filtered to the key, a setup warning opens where it is fixed (Settings for the scan key or management client, AI Gateway, AI Red Teaming) | The admitted reads report no per-item explanation or deadline; the target was added after the attempt-01 review found actions landing on the destination's default view |\n| P35 | Guard offers \"Archive and switch\" / \"Discard and switch\" | Archive ends the conversation (its protected history stays as C20 saved it); Discard ends it, removes its protected history record (after any save under way, under the same lock the sink holds) and refuses every later save of it (the turn the stop cuts short), then drops it once its task returns; both then switch once; the pending approval is never decided for the operator; the dialog's initial focus is Stay, the safe default (Enter on arrival ends nothing). A save admitted before the discard (the turn the engine's end cut short) re-checks the tombstone under the history hold before it writes, so it can never write the discarded transcript back after the removal. A removal that fails (storage unavailable, access denied) is never implied to have succeeded: the record stays listed and the workspace's history reports the failure, through unrelated opens and removals, until the operator removes the record | The engine is stopped either way: a switch retires its binding (C20); the difference is whether the transcript is kept, which the dialog promises and the attempt-01 review found unkept |\n| P36 | Completing \"Add a tenant\" switches to the new tenant | `completeTenantSetup{resolution?}` goes through the same guard as `selectTenant`: a pending Harness decision refuses it with `switchBlocked{to: <draft id>, completion: true}`, nothing is committed or retired, the draft stays, and the wizard renders the one guard dialog and re-sends the completion with the resolution | Wizard completion is listed among the entry points of the single guarded switch path (shell.md, I1); the attempt-01 review found it bypassing the guard |\n| P37 | Scopes are per tenant and a switch round trip shows the cached state | Each opened tenant owns its read record in the core (its last overview, the other products' outcomes, generation, recheck, snooze receipt) for the session; a switch away and back shows it again without a new read. Per-operation bookkeeping is separate from the cached data: each read part is tracked with the context it was admitted under, \"reading\" means a part under the current context is open, a part under a retired context is withdrawn when it lands (never recorded, never counted), so a read held open across a switch round trip can never leave the tenant reading. The presentation's own transient state follows the tenant too: the shell store carries the shown scope (set from each snapshot before it renders); a toast for a tenant's item or read and an unconfirmed delivery bound to a context are refused at insertion when that scope is no longer shown (a refusal or lost delivery arriving after a switch), retired on leaving it (however long Reduce Motion would keep them) and filtered at render; a contextual arrival belongs to the tenant it was followed in | I2 names the tenant, not the context, as the owner of its cached scopes; the attempt-01 review found the overview bound to the context and lost across A → B → A |\n| P38 | Snooze toast states the core-computed return time | The core issues a `SnoozeReceipt{id, title, returnsAt, sequence}` on the tenant's Inbox scope for the last snooze placed in the session; the shell announces a new sequence once, in the tenant it was placed in, and never a hold a switch or a reread merely rediscovers; a snooze ends at its return time whether or not its entry is actionable, and the core's deadline ticker publishes the expiry (the holds in effect are part of the overview's time signature) | I11 wants one source for the return time and one announcement per snooze; diffing holds between snapshots announced old holds after a switch (attempt-01 review) |\n| P39 | `AdminInventory` generated from screens/administration-inventory.md | Implemented as a Rust table (`admin_inventory::inventory`) carried on `ShellSnapshot.administration` in the v2 shell only (null in the legacy shell, whose literal snapshot and leak canary are unchanged; the presentation's fixture copy is pinned to the table by a core test); a unit test and the `ui_v2_reviews` suite pin every offered (kind, action) to `changes::is_allowed` and every denied pair to its refusal, so a label can never outrun the core. Read and Change tabs render the retained views (the same reads and reviewed changes) embedded under the accordion with the inventory's labels; Unavailable tabs and products show their gate and nothing else; Removed tabs are not rendered. The Gateway MCP servers tab lists the chosen workspace's catalog through `listMcpServers` | One source of truth for dispositions, checked against the matrices the core enforces (V2-T20, V2-R11) |\n| P40 | `openReview`/`confirmReview{typed}` intents | The retained review intents are the review (`reviewChange` binds tenant, context, credentials and the read baseline; `requestApply{confirmation}` validates the typed name in the core and opens the native confirmation, whose private completion alone applies). The v2 sheet disables Apply until the typed text equals the review's name and renders the applied panel only from the core's result and readback | The C09 review already carries every binding I3 asks for; new intents would duplicate it |\n| P41 | Rotation state per tenant with two stored timestamps | `Tenant.rotations` (persisted, never a secret): driven from settled `ApiKeys` results of the active context (a Version read back starts one; an unknown Version starts an unconfirmed one; a failed one records nothing; the old key's Delete read back absent completes it; a rejected Delete keeps it with the reason; an unknown one is reconciled by a complete key inventory read), plus `acknowledgeDeployment{application}` stored once. The reminder is the Inbox item `rotation-<application>` while a key is confirmed and the old one not read back gone. The one-time secret stays on its change result for the context it was applied in: Reveal is offered only while the core holds it; any sheet exit forgets it and a context change drops it | The issued secret must never be persisted (I6) while the stage and timestamps must survive reads, switches and relaunches (I7) |\n| P42 | Playground topic examples classify under the topic | The scan result carries `topics{violation, blocked, allowed}` from the service's `topic_violation` flag and `topic_guardrails_details`, shown apart from the detector flags: a matched topic is \"flagged (blocked)\" or \"flagged (monitor only)\", no match under the profile is \"Not detected\", an unreported verdict says so; detectors stay listed beside it. The prototype's local classifier is not carried: verdicts come from the service | The desktop never invents a verdict (DESIGN-V2 §10 gap 2 closed with service data) |\n| P43 | C31 live row runs through `xtask live-run` | `live-run --family L03 --subject C31` runs the C31 topic routine inside L03's designation and writes its receipts and run record under evidence/C31/live, leaving C25's receipts untouched (the consumption ledger stays C25's single ledger) | The live row needs the reviewed runner and the owner's designation, not a second harness |\n| P44 | Lifecycle conversations are seeded data in the prototype (`CONVOS`) | The three lifecycles are fixtures in the contracts package (`fixtures/wire/harness-lifecycle-{blocks,mcp,keys}.json`), one `ConversationView` per step (asking, approved, declined, ended) plus the saved transcript. Each read is one of the desktop's own read tools (`desktopRead`, `effect: readOnly`): blocks `search`, mcp `mcpServers`, keys `inventory` of API keys. They are regression inputs and boards only: a real tenant never shows them (I12) | The core decides approvals; fixtures must be shapes the core emits, validated by `parseShellSnapshot` |\n| P45 | The mcp and keys follow-ups open a guardrail review and the key rotation flow | `proposeChange` admits, besides the Runtime and DLP kinds, an API key `version` (the hand-off of a rotation: it opens the C31 review sheet and its staged sequence) and a guardrail of the conversation's own Gateway workspace (create or update only), staged with that workspace's reference so its review is bound to it; Gateway deletes and every other Gateway change, and a key rotation in place, stay refused. The follow-up of a key hand-off shows the rotation stage from `ShellSnapshot.rotations`. The mcp lifecycle's guardrail is described as what it is (a pii-check guardrail on all messages while the unlisted server is reviewed); no guardrail expresses an MCP allow list | A proposal only ever opens the operator's own review (D014); the follow-ups must be core-owned, not page-invented |\n| P46 | `endConversation` returns an archive id | `endHarness` keeps its receipt; the ended conversation names its saved transcript (`ConversationView.historyId`, the protected history record, shown only with save evidence: `savedAt` set and no `saveFailure`) and the rail marks it ended; \"Open the saved transcript\" opens that record | The archive already exists as the C20 protected history; a second id would duplicate it |\n| P47 | The mcp lifecycle reads `GatewayRead::McpServers` (P16) | A new desktop read tool `mcpServers` reads the conversation workspace's MCP catalog (`GatewayRead::McpServers`, the read the MCP panel uses) for the engine, decided in the page like every desktop read | The prototype's AES inventory has no admitted service; the Gateway catalog is the admitted read P16 named |\n| P48 | Read-only tool calls are approved in the page (C21 assumed) | Every desktop read tool (inventory, detail, session, search, Red Teaming, model observation, scan, test cases, MCP catalog) now waits for the operator's decision in the page (`ApprovalKind::DesktopRead`, `effect: readOnly`); declined, nothing is read and the engine is told so. Staging a proposal reads nothing and still runs at once. Before C32 these reads ran without asking | The lifecycles' approve and decline paths, and the operator's control over what tenant data reaches the model |\n| P49 | The core decides from the tool's write flag whether the native confirmation is required (C21 assumed) | No such branch existed: every decision was in-page. The core now classifies each decision (`HarnessApproval.effect`): a desktop read, or a command while the project is read-only, is `readOnly`; a file change, a command with changes allowed and any workspace MCP tool (whose effect the desktop cannot know; tools carry no trusted annotations) is `mayChange`, and allowing it opens the native confirmation (`Effect::ConfirmHarness`), whose private completion alone sends the allow; refused, the decision stays pending; a stale one is dismissed. In TypeScript `effect` is optional only so pre-C32 snapshots type-check, and absent is treated as `mayChange` | In-page consent must never authorise a change (D058, C32) |\n| P50 | A composer draft per conversation | One composer per tenant and workspace (by the stable workspace ID): its draft survives navigation, tenant round trips and the retirement of the conversation it was typed for. A message the core did not take is kept under \"Not sent\"; one whose delivery was not confirmed under \"Not confirmed\". Each send carries the presentation's own ID (`sendHarness.submission`, 32 hex): the core takes each ID at most once (a repeated delivery after a lost receipt sends nothing again) and reports the sends it took with the message each became and where each stands (`ConversationView.submissions`, newest 64): `pending` (taken, a sign-in renewal or the write confirmation under way: it may still be given back), `delivered` (its message entered the transcript, recorded by the engine session apart from the transcript's bounds) or `returned` (given back, or failed without an engine). Only `delivered` and `returned` settle anything; a tracked send whose conversation is no longer shown before its final word (retired, cleared, another tenant or workspace meanwhile) is kept as Not confirmed with its text. A \"Not confirmed\" record is settled only by its own conversation reporting its own ID: delivered, it leaves the list (and the box, if it holds exactly that text); given back, it leaves the list and its exact text stays in the box or is kept under Not sent, never cleared; an admitted send is likewise tracked until its conversation reports it, and its receipt never clears text the core already gave back, whichever arrives first; never by matching text, another send's entry, another conversation, or the transcript (which drops its oldest entries past 200 entries or 1 MiB). The core numbers a conversation's messages and never reuses an ID, also when restored. Nothing is sent by itself | A conversation's draft must stay recoverable after the core retires the conversation (C32 reviews) |\n| P51 | A new investigation prefilled with the ended conversation's opening question | The rail titles the current conversation from its kept opening too, so its title never changes as the transcript drops its oldest entries. A contextual arrival stays pending, bound to its tenant and workspace, until the conversation or the history resolves it (\"Finding that investigation…\" while the saved conversations are listed); listed without it, or not listable, the page says so; navigation, a new arrival, another workspace or a restart cancels it. The opening question is the conversation's opening message, whole, kept by the core apart from its title (a one-line, shortened label for lists): `ConversationView.opening` and `OpenedConversationView.opening`, captured when the first message (`u-1`) enters the transcript, saved with the record, restored with it and kept after the transcript drops its oldest entries. An archived conversation's record is read for it when the restart is asked for (nothing is filled in meanwhile); choosing another investigation, sending, opening a transcript, a new arrival or another workspace retires that read (a late result changes nothing); otherwise it settles by the core's receipt for the record (`HarnessHistoryView.lastOpen`: id, admission order, failure), newer than any open settled before it was asked for, never by a busy edge or a changed error. When it is not known (a record saved before C32 whose transcript no longer holds its first message) or the record cannot be read, the page says so and never fills in the title instead; a draft in the box is kept under Not sent and nothing is sent | The title is shortened (72 or 80 characters, one line) and lost the rest of a long or multi-line question; the attempt-12 review found the restart prefilling it |\n| P52 | The API Client re-skinned to the prototype's layout (request tree, tabs, method/URL line, 40% response pane) | The v2 API Client presents the C14/C15 workbench in the v2 layout through a layout context its wrapper provides (`shell/presentation.ts` `V2Layout`): the page heading becomes the v2 title row (no kicker), and the request editor puts the method, URL, Send and Save on one compact line with the request details beside a response pane (stacked when narrow). Collections, tabs, history, reviews and execution are the existing components and authority, unchanged; the legacy shell keeps its layout. Send's completion is announced in the editor's status region as \"<request> · <code> · <duration>\", the body outside it, in the response pane (known gap 5, V2-T14). The collection tree and tab strip keep the workbench's own arrangement | The workbench view itself is held by uncommitted owner work in this tree and is not edited; its layout is changed only through the components it renders |\n| P53 | \"Generic requests … refused by the core as today\" (screens/api-client-test-cases.md) | Unchanged C15 authority: a request to a known tenant operation that would change configuration needs its exact, natively confirmed review (`ReviewRequired`) before it is sent; an unknown operation at a registered origin is refused (`UnknownEndpoint`) | The screen text summarised both as refused; the core's existing rule is the authority and C33 does not change it |\n| P54 | Show the calls reveals each action's request and response \"as the diagnostics module already redacts them\" | The diagnostics module records typed events only. The core now records, in memory for the app run, each call it makes on a tenant's behalf through its transport (scans, management reads and changes with their token requests, AI Gateway inference): purpose, the credential by kind (the core attaches it), method, origin and path without the query (a query is marked withheld), header names (never values), request size, status or failure, duration and response content type, newest 50 per tenant (`ShellSnapshot.calls`, only while the preference is on; forgotten with the tenant), bounded as the contract accepts them (header names of at most 64 characters, at most 128, path cut at 2048 characters, method of at most 16, status 100-999, HTTPS origins only; `CALL_*_LIMIT`). Bodies are never kept: a response can carry an issued key or a token and requests carry tenant content. The API Client's own requests keep their existing redacted history. The preference is the operator's once chosen (`show_calls_chosen`), otherwise on until onboarding completes | The prototype has no calls panel; DESIGN-V2 §3 asked for it; secrets must never reach a snapshot (I6) |\n| P55 | Test Cases with per-case results and pack names (prototype `results`, `packCases`) | A case carries its starter pack's name (set when the bundled catalog's cases are added, at onboarding completion or by Add starter packs) and its last result: the verdict of a Playground scan opened from the case, recorded by the core when the scan settles and only while the case still holds the prompt and response that were scanned (`TestCase.result`, `Intent::Scan.case`). Neither is ever exported or imported (v1's file format is unchanged); a copy to another tenant drops the result. A case can be named by a scan only if it is a Runtime Security case of the tenant's open library (otherwise the scan is refused before anything is sent); a result stored on any other case is dropped when the library is read. Absent result: Not run. The library's workflows are kept in the v2 screen: New case, Add starter packs, Add public examples, Import…, Export…, Remove and explicit Copy to another tenant, with the library's unsaved, failure, problem and notice states and their recovery (Save again, Open the library again). Search and the product filter run over name, pack and input; pages of 20 (at most 32 cases per tenant, v1's limit) | The library had no result or pack; the prototype's results were UI state |\n| P56 | \"Open in Playground\" sets the Playground's prompt, direction and profile | It hands the case's profile, prompt, response and application to Administration's Runtime Playground (the v2 home of the Runtime scan form) and opens that tab; the operator runs the scan there, and that scan names the case. The scan form has no separate direction: a case's prompt and response are its directions. Nothing is scanned by opening it, and Inspect dispatches nothing | The Runtime scan form (C03) is the admitted execution surface; direction is expressed by which fields hold text |\n\nP10–P14 are the five round-16 Codex items carried as known gaps (see\n[DESIGN-V2.md](DESIGN-V2.md) \"Known gaps\"). P16–P21 were added after the C27\nattempt-01 review (R3–R6); P22–P23 after attempt-03 (F3a, F3b); P24–P25 were recorded in C28 and P26–P32 in C29 and P33–P38 in C30 and P39–P43 in C31, P44–P51 in C32 and P52–P56 in C33 when implementation met the host as it is (P26–P28 revised after the C29 attempt-01 review; P26–P27 again, and P32 added, after attempt-02; P33–P35 revised and P36–P38 added after the C30 attempt-01 review).\n","exit_code":0,"status":"completed"}}
