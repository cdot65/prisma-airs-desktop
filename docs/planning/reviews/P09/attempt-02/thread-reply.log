{"type":"item.completed","item":{"id":"item_22","type":"command_execution","command":"/bin/zsh -lc 'git show 66d50db0 -- crates/desktop-core/src/authority.rs crates/desktop-core/src/authority/workbench_domain.rs crates/desktop-core/src/authority/workbench_domain/send.rs apps/desktop/src-tauri/tests/workbench_review_lifecycle.rs crates/desktop-core/tests/workbench_execution/main.rs'","aggregated_output":"commit 66d50db03d9566617643948b776c1b2f695ee9d6\nAuthor: admin <admin@worf-vm.mongoose-truck.ts.net>\nDate:   Mon Nov 2 20:49:05 2026 +0000\n\n    Retire API Client mutation reviews with their renderer and native presentation\n\ndiff --git a/apps/desktop/src-tauri/tests/workbench_review_lifecycle.rs b/apps/desktop/src-tauri/tests/workbench_review_lifecycle.rs\nnew file mode 100644\nindex 00000000..45a222a9\n--- /dev/null\n+++ b/apps/desktop/src-tauri/tests/workbench_review_lifecycle.rs\n@@ -0,0 +1,448 @@\n+//! P09 integrated API Client mutation review lifecycle: production Host/IPC,\n+//! real authority/HTTPS dispatch and the same queued presentation permits\n+//! used by AppKit. Synthetic data/services only; no renderer cleanup timer.\n+#[allow(dead_code)]\n+#[path = \"../../../../crates/desktop-core/tests/context_credentials/support.rs\"]\n+mod support;\n+\n+use desktop_core::fixtures::{self, Handles};\n+use desktop_core::management::ManagementEndpoints;\n+use desktop_core::runtime::OperationId;\n+use desktop_core::transport::{ProxyMode, TransportPolicy};\n+use desktop_core::{Core, CoreConfig, Observation, ShellSnapshot, ViewScope};\n+use desktop_host::native_confirmation::{\n+    ConfirmationPermit, ConfirmationPresentation, Registry, outcome,\n+};\n+use serde_json::{Value, json};\n+use std::collections::BTreeMap;\n+use std::path::PathBuf;\n+use std::sync::atomic::{AtomicUsize, Ordering};\n+use std::sync::{Arc, Mutex};\n+use support::{Reply, TestCa, TlsServer, eventually};\n+use tauri::ipc::{CallbackFn, InvokeBody};\n+use tauri::test::{INVOKE_KEY, MockRuntime, get_ipc_response, mock_builder};\n+use tauri::webview::InvokeRequest;\n+use tauri::{App, Manager, WebviewWindow};\n+\n+#[derive(Default)]\n+struct QueuedConfirmations {\n+    registry: Registry,\n+    queued: Mutex<Vec<ConfirmationPresentation>>,\n+    shown: Mutex<BTreeMap<u64, ConfirmationPermit>>,\n+}\n+impl QueuedConfirmations {\n+    fn drain(&self) {\n+        for task in std::mem::take(&mut *self.queued.lock().expect(\"queued\")) {\n+            task.run(&self.registry, |nonce, _request, permit| {\n+                self.shown.lock().expect(\"shown\").insert(nonce, permit);\n+            });\n+        }\n+    }\n+    fn answer(&self, accepted: bool) {\n+        for (_, permit) in std::mem::take(&mut *self.shown.lock().expect(\"shown\")) {\n+            permit.complete(&self.registry, accepted);\n+        }\n+    }\n+    fn queued(&self) -> usize {\n+        self.queued.lock().expect(\"queue\").len()\n+    }\n+    fn shown(&self) -> usize {\n+        self.shown.lock().expect(\"shown\").len()\n+    }\n+}\n+impl desktop_core::OperatorConfirmation for QueuedConfirmations {\n+    fn confirm(\n+        &self,\n+        nonce: u64,\n+        request: desktop_core::ConfirmationRequest,\n+    ) -> futures_util::future::BoxFuture<'static, bool> {\n+        // Matches production unscoped confirmation: a fresh live lease.\n+        self.confirm_scoped(nonce, request, desktop_core::PresentationLease::default())\n+    }\n+    fn confirm_scoped(\n+        &self,\n+        nonce: u64,\n+        request: desktop_core::ConfirmationRequest,\n+        lease: desktop_core::PresentationLease,\n+    ) -> futures_util::future::BoxFuture<'static, bool> {\n+        if !lease.is_current() {\n+            return Box::pin(async { false });\n+        }\n+        let receiver = self.registry.open(nonce);\n+        self.queued\n+            .lock()\n+            .expect(\"queue\")\n+            .push(ConfirmationPresentation::new(nonce, request, lease));\n+        Box::pin(outcome(receiver))\n+    }\n+    fn dismiss(&self, nonce: u64) {\n+        self.registry.complete(nonce, false);\n+        self.shown.lock().expect(\"shown\").remove(&nonce);\n+    }\n+}\n+\n+struct Desk {\n+    core: Core,\n+    app: App<MockRuntime>,\n+    window: WebviewWindow<MockRuntime>,\n+    adapters: Handles,\n+    native: Arc<QueuedConfirmations>,\n+    writes: Arc<AtomicUsize>,\n+    _server: TlsServer,\n+    _ca: TestCa,\n+    root: PathBuf,\n+    session: String,\n+    sequence: u64,\n+}\n+impl Desk {\n+    async fn new(delay: u64) -> Self {\n+        let ca = TestCa::new(\"P09 Workbench page fixture\");\n+        let writes = Arc::new(AtomicUsize::new(0));\n+        let count = Arc::clone(&writes);\n+        let server = TlsServer::start(\n+            ca.leaf(&[\"localhost\"]),\n+            Reply::Route(Arc::new(move |seen| {\n+                if seen\n+                    .request_line\n+                    .starts_with(\"DELETE /iam/v1/access_policies/\")\n+                {\n+                    count.fetch_add(1, Ordering::AcqRel);\n+                    let reply = Reply::ok(b\"{\\\"deleted\\\":true}\");\n+                    if delay > 0 {\n+                        Reply::Delayed {\n+                            millis: delay,\n+                            then: Box::new(reply),\n+                        }\n+                    } else {\n+                        reply\n+                    }\n+                } else {\n+                    Reply::ok(b\"{}\")\n+                }\n+            })),\n+        )\n+        .await;\n+        let origin = format!(\"https://localhost:{}\", server.port);\n+        let (mut adapters, handles) = fixtures::adapters();\n+        let native = Arc::new(QueuedConfirmations::default());\n+        adapters.confirmer = native.clone();\n+        let core = Core::new(\n+            CoreConfig {\n+                management: ManagementEndpoints::at_origin(&origin),\n+                workbench_api_origins: vec![origin.clone()],\n+                ..CoreConfig::default()\n+            },\n+            adapters,\n+        );\n+        core.start();\n+        core.set_transport_policy(TransportPolicy {\n+            revision: 2,\n+            proxy: ProxyMode::Direct,\n+            extra_roots: vec![ca.pem.as_bytes().to_vec()],\n+        })\n+        .expect(\"transport\");\n+        let app = desktop_host::install(mock_builder(), &core)\n+            .build(tauri::generate_context!())\n+            .expect(\"production host\");\n+        let window = desktop_host::main_window(&app).expect(\"main window\");\n+        let root = handles.workbench_root.join(\"page-review-repository\");\n+        std::fs::create_dir_all(root.join(\".git\")).expect(\"fixture repo\");\n+        std::fs::write(\n+            root.join(\"collection.toml\"),\n+            \"format_version = 1\\nid = \\\"page-lifecycle\\\"\\nname = \\\"Page lifecycle\\\"\\n\",\n+        )\n+        .expect(\"collection\");\n+        std::fs::write(root.join(\"change.request.toml\"),format!(\"format_version = 1\\nid = \\\"change\\\"\\nmethod = \\\"DELETE\\\"\\nurl = \\\"{origin}/iam/v1/access_policies/synthetic\\\"\\n\")).expect(\"request\");\n+        let mut desk = Self {\n+            core,\n+            app,\n+            window,\n+            adapters: handles,\n+            native,\n+            writes,\n+            _server: server,\n+            _ca: ca,\n+            root,\n+            session: String::new(),\n+            sequence: 0,\n+        };\n+        desk.register();\n+        desk.send(json!({\"kind\":\"createTenant\",\"profile\":{\"label\":\"Tenant A\",\"tsgId\":\"1234567890\",\"destination\":{\"kind\":\"custom\",\"origin\":origin}}})).expect(\"tenant\");\n+        desk\n+    }\n+    fn call(&self, cmd: &str, body: Value) -> Result<Value, Value> {\n+        get_ipc_response(\n+            &self.window,\n+            InvokeRequest {\n+                cmd: cmd.into(),\n+                callback: CallbackFn(0),\n+                error: CallbackFn(1),\n+                url: \"tauri://localhost\".parse().expect(\"origin\"),\n+                body: InvokeBody::Raw(serde_json::to_vec(&body).expect(\"JSON\")),\n+                headers: Default::default(),\n+                invoke_key: INVOKE_KEY.to_owned(),\n+            },\n+        )\n+        .map(|r| r.deserialize::<Value>().expect(\"reply\"))\n+    }\n+    fn register(&mut self) {\n+        let r = self\n+            .call(\n+                \"desktop_observe\",\n+                json!({\"protocol\":1,\"scope\":{\"kind\":\"deliverySession\"}}),\n+            )\n+            .expect(\"session\");\n+        self.session = r[\"session\"].as_str().expect(\"nonce\").to_owned();\n+        self.sequence = 0;\n+    }\n+    fn send(&mut self, intent: Value) -> Result<Value, Value> {\n+        self.sequence += 1;\n+        let response=self.call(\"desktop_dispatch\",json!({\"protocol\":1,\"session\":self.session,\"sequence\":self.sequence.to_string(),\"intent\":intent}))?;\n+        if response[\"outcome\"] == \"refusal\" {\n+            Err(response[\"refusal\"].clone())\n+        } else {\n+            Ok(response)\n+        }\n+    }\n+    fn start(&mut self, request: Value) -> OperationId {\n+        let r = self\n+            .send(json!({\"kind\":\"workbench\",\"request\":request}))\n+            .expect(\"IPC admission\");\n+        serde_json::from_value(r[\"receipt\"][\"operation\"].clone()).expect(\"operation\")\n+    }\n+    async fn wait(&self, id: OperationId) -> Value {\n+        let Observation::Workbench(task) = self\n+            .core\n+            .operator()\n+            .observe(ViewScope::Workbench(id))\n+            .expect(\"operation observation\")\n+        else {\n+            panic!(\"workbench observation\")\n+        };\n+        serde_json::to_value(task.result().await).expect(\"result\")\n+    }\n+    async fn wb(&mut self, request: Value) -> Value {\n+        let op = self.start(request);\n+        self.wait(op).await\n+    }\n+    fn snap(&self) -> ShellSnapshot {\n+        let Observation::Shell { snapshot, .. } = self\n+            .core\n+            .operator()\n+            .observe(ViewScope::Shell)\n+            .expect(\"snapshot\")\n+        else {\n+            panic!(\"shell\")\n+        };\n+        snapshot\n+    }\n+    async fn review(&mut self) -> (Value, Value) {\n+        if self.snap().workbench.collection.is_none() {\n+            self.adapters.folders.reply(Some(self.root.clone()));\n+            assert_eq!(\n+                self.wb(json!({\"kind\":\"openFolder\"})).await[\"kind\"],\n+                \"opened\"\n+            );\n+        }\n+        let doc = self\n+            .wb(json!({\"kind\":\"openRequest\",\"relative\":\"change.request.toml\"}))\n+            .await[\"document\"]\n+            .clone();\n+        let context = self.snap().active.map(|a| a.context);\n+        let r=self.wb(json!({\"kind\":\"send\",\"id\":doc[\"id\"],\"revision\":doc[\"revision\"],\"fields\":doc[\"fields\"],\"context\":context})).await;\n+        assert_eq!(r[\"kind\"], \"reviewRequired\", \"{r}\");\n+        (doc, r[\"review\"].clone())\n+    }\n+    fn apply(&mut self, doc: &Value, review: &Value) -> OperationId {\n+        let context = self.snap().active.map(|a| a.context);\n+        self.start(json!({\"kind\":\"apply\",\"review\":review[\"review\"],\"id\":doc[\"id\"],\"revision\":doc[\"revision\"],\"fields\":doc[\"fields\"],\"context\":context}))\n+    }\n+    fn reload(&mut self) {\n+        self.app\n+            .state::<desktop_host::Host>()\n+            .retire_webview(\"main\");\n+        self.register();\n+    }\n+}\n+\n+async fn retired_page(shown: bool) {\n+    let mut desk = Desk::new(0).await;\n+    let (doc, review) = desk.review().await;\n+    let op = desk.apply(&doc, &review);\n+    assert!(\n+        eventually(|| desk.native.queued() == 1).await,\n+        \"native effect registered\"\n+    );\n+    if shown {\n+        desk.native.drain();\n+        assert_eq!(desk.native.shown(), 1);\n+    }\n+    desk.reload();\n+    desk.native.drain();\n+    let stale_shown = desk.native.shown();\n+    desk.native.answer(true);\n+    let result = desk.wait(op).await;\n+    assert_eq!(\n+        desk.writes.load(Ordering::Acquire),\n+        0,\n+        \"retired page must never authorize a mutation: {result}\"\n+    );\n+    assert_eq!(\n+        stale_shown, 0,\n+        \"retired review must not retain/show its native sheet\"\n+    );\n+    assert!(\n+        desk.snap().workbench.review.is_none(),\n+        \"retired review gone\"\n+    );\n+    let (doc, review) = desk.review().await;\n+    let fresh = desk.apply(&doc, &review);\n+    assert!(eventually(|| desk.native.queued() > 0).await);\n+    desk.native.drain();\n+    assert_eq!(desk.native.shown(), 1, \"explicit fresh-page review works\");\n+    desk.native.answer(true);\n+    let result = desk.wait(fresh).await;\n+    assert_eq!(result[\"kind\"], \"ran\", \"{result}\");\n+    assert_eq!(\n+        desk.writes.load(Ordering::Acquire),\n+        1,\n+        \"fresh request sent exactly once\"\n+    );\n+}\n+#[tokio::test(flavor = \"multi_thread\", worker_threads = 4)]\n+async fn queued_mutation_confirmation_is_revoked_by_main_page_reload() {\n+    retired_page(false).await;\n+}\n+#[tokio::test(flavor = \"multi_thread\", worker_threads = 4)]\n+async fn shown_mutation_confirmation_is_revoked_by_main_page_reload() {\n+    retired_page(true).await;\n+}\n+\n+#[derive(Clone, Copy, Debug)]\n+enum Retirement {\n+    Dismiss,\n+    Replace,\n+    Leave,\n+    Context,\n+}\n+async fn other_retirements(shown: bool) {\n+    for reason in [\n+        Retirement::Dismiss,\n+        Retirement::Replace,\n+        Retirement::Leave,\n+        Retirement::Context,\n+    ] {\n+        let mut desk = Desk::new(0).await;\n+        let (doc, review) = desk.review().await;\n+        let op = desk.apply(&doc, &review);\n+        assert!(eventually(|| desk.native.queued() == 1).await);\n+        if shown {\n+            desk.native.drain();\n+            assert_eq!(desk.native.shown(), 1);\n+        }\n+        match reason {\n+            Retirement::Dismiss => {\n+                desk.wb(json!({\"kind\":\"dismissReview\"})).await;\n+            }\n+            Retirement::Replace => {\n+                let (_doc, replacement) = desk.review().await;\n+                assert_ne!(replacement[\"review\"], review[\"review\"]);\n+            }\n+            Retirement::Leave => {\n+                desk.wb(json!({\"kind\":\"closeCollection\",\"discard\":true}))\n+                    .await;\n+            }\n+            Retirement::Context => {\n+                let active = desk.snap().active.expect(\"active\").tenant;\n+                desk.send(json!({\"kind\":\"deleteTenant\",\"tenant\":active}))\n+                    .expect(\"context retired\");\n+            }\n+        }\n+        desk.native.drain();\n+        let stale_shown = desk.native.shown();\n+        desk.native.answer(true);\n+        let result = desk.wait(op).await;\n+        assert_eq!(\n+            desk.writes.load(Ordering::Acquire),\n+            0,\n+            \"{reason:?} cannot authorize a mutation: {result}\"\n+        );\n+        assert_eq!(stale_shown, 0, \"{reason:?} must suppress/dismiss its sheet\");\n+    }\n+}\n+#[tokio::test(flavor = \"multi_thread\", worker_threads = 4)]\n+async fn queued_confirmations_retire_with_dismissal_replacement_collection_and_context() {\n+    other_retirements(false).await;\n+}\n+#[tokio::test(flavor = \"multi_thread\", worker_threads = 4)]\n+async fn shown_confirmations_retire_with_dismissal_replacement_collection_and_context() {\n+    other_retirements(true).await;\n+}\n+\n+#[tokio::test(flavor = \"multi_thread\", worker_threads = 4)]\n+async fn page_reload_before_native_registration_never_opens_or_sends() {\n+    let mut desk = Desk::new(0).await;\n+    let (doc, review) = desk.review().await;\n+    let gate = desk.core.operator().hold_next_native_presentation();\n+    let op = desk.apply(&doc, &review);\n+    assert!(\n+        eventually(|| gate.entered()).await,\n+        \"real review accepted; native adapter not entered yet\"\n+    );\n+    desk.reload();\n+    gate.release();\n+    let result = desk.wait(op).await;\n+    assert_eq!(\n+        desk.native.queued(),\n+        0,\n+        \"retired admission never registers a callback\"\n+    );\n+    assert_eq!(desk.native.shown(), 0);\n+    assert_eq!(desk.writes.load(Ordering::Acquire), 0, \"{result}\");\n+}\n+\n+#[tokio::test(flavor = \"multi_thread\", worker_threads = 4)]\n+async fn a_review_planned_after_its_page_retires_never_resurrects() {\n+    let mut desk = Desk::new(0).await;\n+    let (doc, _review) = desk.review().await;\n+    desk.wb(json!({\"kind\":\"dismissReview\"})).await;\n+    let held = desk.core.hold_send_planning().await;\n+    let context = desk.snap().active.map(|a| a.context);\n+    let op=desk.start(json!({\"kind\":\"send\",\"id\":doc[\"id\"],\"revision\":doc[\"revision\"],\"fields\":doc[\"fields\"],\"context\":context}));\n+    assert!(eventually(|| desk.core.sends_held_in_planning() > 0).await);\n+    desk.reload();\n+    drop(held);\n+    let result = desk.wait(op).await;\n+    assert_ne!(\n+        result[\"kind\"], \"reviewRequired\",\n+        \"old page cannot publish a fresh live review\"\n+    );\n+    assert!(desk.snap().workbench.review.is_none());\n+    assert_eq!(desk.writes.load(Ordering::Acquire), 0);\n+}\n+\n+#[tokio::test(flavor = \"multi_thread\", worker_threads = 4)]\n+async fn a_dispatched_mutation_keeps_its_outcome_across_page_reload() {\n+    let mut desk = Desk::new(800).await;\n+    let (doc, review) = desk.review().await;\n+    let op = desk.apply(&doc, &review);\n+    assert!(eventually(|| desk.native.queued() == 1).await);\n+    desk.native.drain();\n+    desk.native.answer(true);\n+    assert!(\n+        eventually(|| desk.writes.load(Ordering::Acquire) == 1).await,\n+        \"request actually dispatched before teardown\"\n+    );\n+    desk.reload();\n+    let result = desk.wait(op).await;\n+    assert_eq!(result[\"kind\"], \"ran\", \"{result}\");\n+    assert_eq!(result[\"run\"][\"record\"][\"status\"], 200);\n+    assert_eq!(result[\"run\"][\"record\"][\"stored\"], true);\n+    let id = result[\"run\"][\"record\"][\"id\"].as_str().expect(\"run id\");\n+    let history = desk.wb(json!({\"kind\":\"history\",\"before\":null})).await;\n+    assert!(\n+        history.to_string().contains(id),\n+        \"new page reads the original outcome: {history}\"\n+    );\n+    assert_eq!(desk.writes.load(Ordering::Acquire), 1, \"no replay\");\n+}\ndiff --git a/crates/desktop-core/src/authority.rs b/crates/desktop-core/src/authority.rs\nindex e7de4952..6cf9b680 100644\n--- a/crates/desktop-core/src/authority.rs\n+++ b/crates/desktop-core/src/authority.rs\n@@ -3503,6 +3503,7 @@ impl AuthorityHandle {\n         let mut state = lock(&self.inner)?;\n         state.operator_sessions.retire();\n         state.retire_renderer_reviews();\n+        state.workbench.sending.retire_renderer_review();\n         state.changed();\n         Ok(())\n     }\ndiff --git a/crates/desktop-core/src/authority/workbench_domain.rs b/crates/desktop-core/src/authority/workbench_domain.rs\nindex bf4187ba..99dd3ce7 100644\n--- a/crates/desktop-core/src/authority/workbench_domain.rs\n+++ b/crates/desktop-core/src/authority/workbench_domain.rs\n@@ -509,6 +509,7 @@ impl WorkbenchHandle {\n \n struct Call {\n     operation: OperationId,\n+    page: crate::PresentationLease,\n     cell: Arc<Cell>,\n     settled: bool,\n     observed: bool,\n@@ -630,6 +631,7 @@ impl State {\n         let operation = self.operations.reserve();\n         self.workbench.calls.push(Call {\n             operation: operation.clone(),\n+            page: self.workbench.sending.page_lease(),\n             cell: Arc::default(),\n             settled: false,\n             observed: false,\n@@ -840,7 +842,17 @@ p