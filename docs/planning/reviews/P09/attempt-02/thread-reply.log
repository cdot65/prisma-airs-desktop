{"type":"item.completed","item":{"id":"item_47","type":"command_execution","command":"/bin/zsh -lc \"head -90 tools/native-acceptance/wizard_coverage.py; cat docs/planning/evidence/C29/live/L19-verify.json; rg --files docs/planning/evidence/C31/live | head -20; sed -n '1,115p' tools/native-acceptance/legacy_assertions.py; sed -n '1,100p' docs/planning/evidence/C44/legacy-script-map.md\"","aggregated_output":"\"\"\"Independent completeness check for the retained C29 native assertions.\n\nThe expected axes come from C29-N06/T09, rather than the rows a driver happens\nto emit. Missing behavior or a missing capture cannot be reported as exercised.\n\"\"\"\nimport argparse\nimport hashlib\nimport itertools\nimport json\nfrom pathlib import Path\n\nSTEPS = {\n    'firstRun': ['welcome', 'tenant', 'products', 'verify', 'packs', 'academy', 'done'],\n    'add': ['tenant', 'products', 'verify', 'packs', 'done'],\n}\nBEHAVIOR = [\n    'welcome_relaunch', 'profile_edit_saved', 'profile_edit_key_kept',\n    'gateway_listed', 'workspace_chosen', 'workspace_key_saved',\n    'rejected_client_failed', 'failed_client_continuable', 'failed_scan_stored_not_pass',\n    'credential_fix_returns_tenant', 'correct_client_saved', 'workspace_rechosen_after_fix',\n    'verification_passed', 'gateway_verification_passed', 'product_edit_marked_stale',\n    'stale_continuation_closed', 'stale_rerun_clean', 'home_relaunch',\n    'starter_cases_imported', 'secret_confinement',\n    'keyed_draft_saved', 'cancelled_rows_unchanged', 'cancelled_active_unchanged', 'cancelled_key_deleted',\n]\n\n\ndef problems(observations, root):\n    coverage = observations.get('c29_native_coverage', {})\n    behavior = coverage.get('behavior', {})\n    failures = ['missing/failed retained behavior: ' + key for key in BEHAVIOR if behavior.get(key) is not True]\n    rows = coverage.get('layouts', {})\n    expected = {(mode, step, theme, zoom) for mode, steps in STEPS.items()\n                for step, theme, zoom in itertools.product(steps, ['Light', 'Dark'], [1, 2])}\n    seen = set()\n    for name, row in rows.items():\n        axis = (row.get('mode'), row.get('step'), row.get('theme'), row.get('zoom'))\n        if axis in seen:\n            failures.append('duplicate matrix row: ' + str(axis))\n        seen.add(axis)\n        zoom = row.get('zoom')\n        requested = (1440, 900) if zoom == 1 else (900, 600)\n        geometry = row.get('geometry', {})\n        web = geometry.get('web') or []\n        viewport = geometry.get('viewport') or web\n        if not (len(web) == 2 and len(viewport) == 2 and web[0] == requested[0]\n                and viewport[0] == requested[0] and (zoom == 1 or viewport[1] == requested[1])):\n            failures.append(name + ': wrong measured geometry')\n        primary = row.get('primary', {})\n        height = (primary.get('size') or [0, 0])[1]\n        if not (primary.get('inside') and zoom in (1, 2) and height >= 32 * zoom):\n            failures.append(name + ': primary outside window or too small')\n        if row.get('overflow_px') != 0 or row.get('horizontal_scrollbars') != 0:\n            failures.append(name + ': horizontal overflow')\n        if row.get('dialog') != (row.get('mode') == 'add'):\n            failures.append(name + ': wrong modal ownership')\n        keyboard = row.get('keyboard', {})\n        if not (keyboard.get('primary_reached') and keyboard.get('walk') and keyboard.get('contained')):\n            failures.append(name + ': keyboard traversal missing/incomplete')\n        for field in ['capture', 'tree']:\n            path = Path(root) / row.get(field, '')\n            if not row.get(field) or not path.is_file():\n                failures.append(name + ': missing ' + field)\n            elif hashlib.sha256(path.read_bytes()).hexdigest() != row.get(field + '_sha256'):\n                failures.append(name + ': hash mismatch for ' + field)\n    failures.extend('missing matrix row: ' + str(axis) for axis in sorted(expected - seen))\n    failures.extend('unexpected matrix row: ' + str(axis) for axis in sorted(seen - expected))\n    return failures\n\n\ndef main():\n    parser = argparse.ArgumentParser()\n    parser.add_argument('observations', type=Path)\n    parser.add_argument('--root', type=Path, default=Path.cwd())\n    args = parser.parse_args()\n    data = json.loads(args.observations.read_text())\n    errors = problems(data['observations'], args.root)\n    print(json.dumps({'retained_C29_native_coverage': 'fail' if errors else 'pass', 'errors': errors}, indent=2))\n    return 1 if errors else 0\n\n\nif __name__ == '__main__':\n    raise SystemExit(main())\n{\n  \"schema\": \"airs-v2/live-row/1\",\n  \"subject\": \"C29\",\n  \"row\": \"verify against Vulture (reads only)\",\n  \"status\": \"pass\",\n  \"recorded_utc\": \"2026-11-01T13:38:19.467214+00:00\",\n  \"family\": \"L19\",\n  \"native_receipt\": \"docs/planning/evidence/C29/live/L19/attempt-03/receipt.json\",\n  \"native_receipt_sha256\": \"0d0b66212cd1483dbcab073050750de80e3277d29c875697302609e34855c202\",\n  \"manifest_sha256\": \"a2dd7b01ed289ed164859ac0daf6e582100de555d29eefb01fa13df87d0bdbe1\",\n  \"client_id\": \"prisma-airs-cli@1852583913.iam.panserviceaccount.com\",\n  \"tsg_id\": \"1852583913\",\n  \"operation\": \"one management credential verification through the first-run wizard (C29): one latest security-profile probe with limit=1; discard profile contents; no other inventory browsing or writes\",\n  \"executable_sha256\": \"8fb5a476b2a25adf2842286faa69e5393f5812ac3d7b65f87564eb0f05b54dca\",\n  \"source_inputs_sha256\": \"217a81f9ed49219bae0fa7946b9684ca6d2469b3c7f607d91b0c48816f09284c\",\n  \"current_source_match\": \"docs/planning/evidence/C29/live/L19/current-source-match.json\",\n  \"budget\": {\n    \"original_grant_reserved\": 2,\n    \"additional_explicit_owner_grant_cap\": 1,\n    \"additional_grant_reserved\": 1,\n    \"total_reserved\": 3,\n    \"refunded\": 0,\n    \"additional_grant_record\": \"docs/planning/evidence/C29/live/L19/additional-grant-01.json\"\n  },\n  \"temporary_local_credentials_removed\": true,\n  \"http_request_count_observed\": false,\n  \"limitations\": [\n    \"Request bound comes from the inspected production verifier (limit=1, latest=true, SDK retries=0) and exactly one wizard intent; no TLS interception or response body capture.\"\n  ],\n  \"historical_blocked_record\": \"docs/planning/evidence/C29/live/blocked.json (retained unchanged; superseded by this authorized actual run)\"\n}\ndocs/planning/evidence/C31/live/run.json\ndocs/planning/evidence/C31/live/L03/C31-topic-review-apply.json\ndocs/planning/evidence/C31/live/L03/C31-topic-create.json\ndocs/planning/evidence/C31/live/L03/C31-cleanup-topic.json\n\"\"\"Where every pre-P09 native assertion stands on the one presentation (C44).\n\nEach legacy check id maps to a kind and its targets:\n  x  exercised: the named v2 checks assert the same requirement on the C44 bundle (their results bind the gate).\n  s  self: the legacy driver itself runs on the one presentation through legacy_v2 (run_on_v2.py <cNN> legacy).\n  p  ported: the requirement was added to the named v2 check in C44 (a new fact in that driver's record).\n  r  retired: the requirement concerns the legacy shell or a surface the one presentation does not have (D059: the\n     prototype is the specification; D060: no import from the alpha; the owner on 2026-10-31: the application is\n     driven by the new UI alone). Where the behaviour survives in the core, the retirement names the suite that holds\n     it (crates/desktop-core/tests/<name>, run by the gate's core-fixtures step); that suite result does not stand in\n     for a native assertion and the map says so.\nThe note says which fact of the target carries the requirement. The gate (acceptance_c44.py) fails when an exercised,\nself or ported target is missing or failing on this bundle, or a retirement has no reason.\n\"\"\"\n\nX, S, P, R = \"x\", \"s\", \"p\", \"r\"\n\n