{"type":"item.completed","item":{"id":"item_42","type":"command_execution","command":"/bin/zsh -lc \"sed -n '360,424p' crates/desktop-core/src/authority/inbox_domain.rs; rg -n 'fn select_tenant|guard_switch|retire_renderer_reviews|ConfirmHarness|confirm_scoped|NativePresentation' crates/desktop-core/src/authority.rs crates/desktop-core/src/authority/{change_domain,harness_domain,harness_tools,setup_domain}.rs; sed -n '880,960p' crates/desktop-core/src/authority/change_domain.rs; rg -n 'check_context|confirmation|apply_nonce|fn request_apply' crates/desktop-core/src/authority/change_domain.rs | head -35; sed -n '275,390p' crates/desktop-core/src/authority/rotation_domain.rs; cat crates/desktop-core/tests/ui_v2_closure/main.rs\"","aggregated_output":"}\n\nimpl State {\n    /// The decision the active tenant's conversation is waiting for, if any.\n    pub(super) fn pending_decision(&self) -> Option<PendingDecisionRef> {\n        let conversation = self.live_bound_harness()?;\n        let approvals = self.bound_approvals();\n        let first = approvals.first()?;\n        Some(PendingDecisionRef {\n            conversation: conversation.as_str().to_owned(),\n            decision: first.id.clone(),\n        })\n    }\n\n    /// Admits a tenant switch, or refuses it while a decision is pending\n    /// (I1): the refusal carries the guard the presentation renders.\n    pub(super) fn guard_switch(\n        &mut self,\n        to: &TenantId,\n        resolution: Option<SwitchResolution>,\n        target_context: Option<&ContextRef>,\n    ) -> Result<Option<GuardedSwitch>, Refusal> {\n        if let Some(resolution) = resolution {\n            let (context, review) = match &resolution {\n                SwitchResolution::Archive { context, review }\n                | SwitchResolution::Discard { context, review } => (context, review),\n            };\n            // A resolution names one native refusal, never whichever\n            // conversation happens to be pending when a lost delivery retries.\n            let blocked = self.switch_blocked.as_ref().ok_or(Refusal::StaleContext)?;\n            if self.active_ref.as_ref() != Some(context)\n                || &blocked.context != context\n                || &blocked.review != review\n                || &blocked.to != to\n                || blocked.target_context.as_ref() != target_context\n                || Some(&blocked.pending) != self.pending_decision().as_ref()\n            {\n                return Err(Refusal::StaleContext);\n            }\n            let id = self.live_bound_harness().ok_or(Refusal::StaleContext)?;\n            // Validation alone changes no conversation, guard or history.\n            // A definite store refusal can restore Data and leave all of\n            // this unresolved work exactly as it was.\n            return Ok(Some(match resolution {\n                SwitchResolution::Archive { .. } => GuardedSwitch::Archive(id),\n                SwitchResolution::Discard { .. } => GuardedSwitch::Discard(id),\n            }));\n        }\n        let Some(pending) = self.pending_decision() else {\n            self.switch_blocked = None;\n            return Ok(None);\n        };\n        self.switch_blocked = Some(SwitchBlocked {\n            to: to.clone(),\n            pending,\n            completion: target_context.is_some(),\n            context: self.active_ref.clone().ok_or(Refusal::StaleContext)?,\n            review: ReviewId::issue().ok_or(Refusal::ShuttingDown)?,\n            target_context: target_context.cloned(),\n        });\n        Err(Refusal::DecisionPending)\n    }\n\n    /// The active tenant's setup warnings as items.\n    pub(super) fn setup_warning_items(&self) -> Vec<InboxItem> {\ncrates/desktop-core/src/authority/change_domain.rs:909:    pub(super) fn retire_renderer_reviews(&mut self) {\ncrates/desktop-core/src/authority.rs:411:    ConfirmHarnessWrite {\ncrates/desktop-core/src/authority.rs:849:    ConfirmHarnessWrite => \"confirmHarnessWrite\",\ncrates/desktop-core/src/authority.rs:1466:    fn confirm_scoped(\ncrates/desktop-core/src/authority.rs:2741:    ConfirmHarness {\ncrates/desktop-core/src/authority.rs:3505:        state.retire_renderer_reviews();\ncrates/desktop-core/src/authority.rs:3805:            let resolution = match state.guard_switch(&draft, resolution, Some(&context)) {\ncrates/desktop-core/src/authority.rs:3894:            let resolution = match state.guard_switch(&tenant, resolution, None) {\ncrates/desktop-core/src/authority.rs:4402:                effects.push(Effect::ConfirmHarness {\ncrates/desktop-core/src/authority.rs:4433:        Intent::ConfirmHarnessWrite {\ncrates/desktop-core/src/authority.rs:5158:            Effect::Confirm { .. } | Effect::RevealSecret { .. } | Effect::ConfirmHarness { .. }\ncrates/desktop-core/src/authority.rs:5362:                        .confirm_scoped(nonce, request, presentation)\ncrates/desktop-core/src/authority.rs:5367:            Effect::ConfirmHarness {\ncrates/desktop-core/src/authority.rs:5379:                        .confirm_scoped(nonce, request, presentation)\n        // under it: end that confirmation, whose late completion then applies\n        // nothing, and require a new review.\n        if let Some(review) = self.change_review.as_mut()\n            && let Phase::Confirming { nonce, .. } = review.phase\n        {\n            self.confirmer.dismiss(nonce);\n            review.phase = Phase::Failed(ChangeProblem::StagedFile.into());\n        }\n        self.staging = match chosen {\n            None => None,\n            Some(Err(failure)) => Some(Staging::Failed(failure)),\n            Some(Ok((name, bytes))) => Some(match staged_text(bytes) {\n                Err(failure) => Staging::Failed(failure),\n                Ok(text) => match nonce() {\n                    Some(n) => Staging::Ready(StagedFile {\n                        token: format!(\"sf-{n:016x}\"),\n                        context,\n                        name,\n                        text,\n                    }),\n                    None => Staging::Failed(StagedFileFailure::Unreadable),\n                },\n            }),\n        };\n    }\n\n    /// A native page exit ends its configuration editor and every one-time\n    /// disclosure, including keys whose admitted issuance has not settled.\n    /// The operations and their remote outcomes remain owned by the core.\n    pub(super) fn retire_renderer_reviews(&mut self) {\n        if let Some(review) = self.change_review_id() {\n            let _ = self.discard_change(&review);\n        }\n        let operations: Vec<_> = self\n            .change_results\n            .iter()\n            .map(|record| record.operation.clone())\n            .collect();\n        for operation in operations {\n            let _ = self.forget_secret(&operation);\n        }\n        // A sheet may already hold the sole copy after RevealSecret consumed it.\n        self.secrets.dismiss();\n    }\n\n    pub(super) fn discard_change(&mut self, review: &ReviewId) -> Result<(), Refusal> {\n        match &self.change_review {\n            Some(r) if &r.id == review => {\n                if let Phase::Confirming { nonce, .. } = r.phase {\n                    self.confirmer.dismiss(nonce);\n                }\n                self.change_review = None;\n                Ok(())\n            }\n            _ => {\n                // An applied review: its exit retires every one-time secret\n                // its changes returned or will return (I6), settled or not.\n                let applied: Vec<OperationId> = self\n                    .change_results\n                    .iter()\n                    .filter(|r| r.review.as_ref() == Some(review))\n                    .map(|r| r.operation.clone())\n                    .collect();\n                if applied.is_empty() {\n                    return Err(Refusal::ReviewInvalid);\n                }\n                for operation in &applied {\n                    let _ = self.forget_secret(operation);\n                }\n                Ok(())\n            }\n        }\n    }\n\n    /// Hands the held one-time secret of an applied change to the native\n    /// sheet, once: the core keeps no copy afterwards, so closing, copying\n    /// or the sheet's expiry ends it for good (DESIGN: one reveal).\n    pub(super) fn reveal_secret(\n        &mut self,\n        operation: &OperationId,\n    ) -> Result<(String, Zeroizing<String>, PresentationLease), Refusal> {\n5://! the stored draft and opens the native operator confirmation; only its\n27:    ChangeAction, ChangeDraft, ChangeKind, ChangeProblem, Mutation, confirmation, digest, impact,\n93:    /// The native confirmation is open; the editor is held.\n151:    pub confirmation: Option<String>,\n519:        let tenant = self.check_context(&context)?;\n521:        // A newly captured draft invalidates a pending confirmation: its sheet\n595:    /// RequestApply: the freshly captured `draft` and typed `confirmation`\n597:    /// native confirmation `nonce`.\n598:    pub(super) fn request_apply(\n666:        let expected = confirmation(&prepared.mutation, prepared.before.as_ref());\n672:        let request = confirmation_request(&label, &prepared, shown);\n677:    /// The native confirmation's private completion. Only the open\n678:    /// confirmation `nonce` of a current review is honored, once; a denial\n680:    pub(super) fn settle_confirmation(\n703:        // A denial, or a confirmation that outlived the review, applies\n850:        self.check_context(&context)?;\n851:        // The native confirmation holds the editor lease: the file a pending\n879:        // A sheet opened before a confirmation began must not change the file\n880:        // under it: end that confirmation, whose late completion then applies\n1065:    /// to a retired context (an open confirmation is ended, held secrets\n1290:                    confirmation: prepared\n1291:                        .and_then(|p| confirmation(&p.mutation, p.before.as_ref())),\n1403:/// The native confirmation's text: Rust's stored review, not renderer text.\n1404:fn confirmation_request(\n        }\n    }\n\n    /// The operator's statement that the application now uses the new key\n    /// (a local fact, timestamped once).\n    pub(super) fn acknowledge_deployment(\n        &mut self,\n        context: &ContextRef,\n        application: &str,\n    ) -> Result<Option<(String, String)>, Refusal> {\n        let tenant = self.check_context(context)?;\n        let clock = self.clock();\n        let rotations = self.rotations_mut(&tenant).ok_or(Refusal::StaleContext)?;\n        let rotation = rotations\n            .iter_mut()\n            .find(|r| r.application == application)\n            .ok_or(Refusal::InvalidInput)?;\n        if rotation.new_key.is_none() || rotation.removal == RotationRemoval::Done {\n            return Err(Refusal::InvalidInput);\n        }\n        if rotation.deployment_acknowledged_at.is_none() {\n            rotation.deployment_acknowledged_at = Some(clock);\n        }\n        // The operator says the application has the key: once this is\n        // recorded, its one-time copy is no longer needed here (I6).\n        Ok(rotation\n            .issued_by\n            .clone()\n            .map(|operation| (operation, rotation.old_key.id.clone())))\n    }\n\n    /// Saves a rotation fact the service established. Unlike an intent's\n    /// save, a failure keeps the fact in memory (it happened remotely and\n    /// must not be forgotten), reports it, and every later publication\n    /// retries the save; nothing remote is replayed.\n    pub(super) fn keep_rotation_fact(&mut self, _before: &Data) {\n        let saved = match self.storage {\n            StorageHealth::Ready => self.store.save(&self.persisted()),\n            _ => Err(StoreError::Unavailable),\n        };\n        match saved {\n            Ok(()) => {\n                self.durability_unconfirmed = false;\n                self.rotation_unsaved = false;\n            }\n            Err(StoreError::Unconfirmed) => {\n                self.durability_unconfirmed = true;\n                self.rotation_unsaved = false;\n            }\n            Err(_) => self.rotation_unsaved = true,\n        }\n    }\n\n    /// Retries an unsaved rotation fact (each publication; C31).\n    pub(super) fn retry_rotation_save(&mut self) {\n        if self.rotation_unsaved {\n            let data = self.data.clone();\n            self.keep_rotation_fact(&data);\n        }\n    }\n\n    /// The active tenant's rotations as the presentation shows them.\n    pub(super) fn rotations_view(&self) -> Vec<RotationView> {\n        let Some(tenant) = self.data.active.as_ref().and_then(|id| self.tenant(id)) else {\n            return Vec::new();\n        };\n        tenant\n            .rotations\n            .iter()\n            .map(|r| {\n                let secret = r\n                    .issued_by\n                    .as_deref()\n                    .is_some_and(|op| self.issuance_held(op, &r.old_key.id));\n                let stage = match (\n                    &r.removal,\n                    r.deployment_acknowledged_at,\n                    r.new_key.is_some(),\n                ) {\n                    (RotationRemoval::Done, _, _) => RotationStage::Complete,\n                    (RotationRemoval::Unconfirmed, _, _) => RotationStage::RemovalUnconfirmed,\n                    (_, _, false) => RotationStage::IssuanceUnconfirmed,\n                    (_, Some(_), true) => RotationStage::Acknowledged,\n                    (_, None, true) if secret => RotationStage::Issued,\n                    (_, None, true) => RotationStage::Resumed,\n                };\n                RotationView {\n                    application: r.application.clone(),\n                    old_key: r.old_key.clone(),\n                    new_key: r.new_key.clone(),\n                    stage,\n                    // Offered only while the core holds the key and the stage\n                    // is one that may reveal it (issued, or issued but not yet\n                    // confirmed by readback).\n                    issued_by: r.issued_by.clone().filter(|_| {\n                        secret\n                            && matches!(\n                                stage,\n                                RotationStage::Issued | RotationStage::IssuanceUnconfirmed\n                            )\n                    }),\n                    issued_at: r.issued_at,\n                    deployment_acknowledged_at: r.deployment_acknowledged_at,\n                    old_key_removed_at: r.old_key_removed_at,\n                    unsaved: self.rotation_unsaved,\n                    removal_rejected: match &r.removal {\n                        RotationRemoval::Rejected { reason } => Some(reason.clone()),\n                        _ => None,\n                    },\n                }\n            })\n            .collect()\n    }\n\n    /// The reminder items of rotations in progress (I7): one per application\n    /// with a confirmed new key and the old key not yet read back gone.\n//! C44: one presentation. Through the production authority interface: the\n//! snapshot always says the v2 presentation with the v2 catalogue, whatever\n//! an older store persisted; `SetUiVariant` (sent by older presentations\n//! and drivers) is accepted and changes nothing; navigation resolves against\n//! the v2 catalogue only, so every destination the legacy shell reached is\n//! still a destination here (the product entries open Administration's\n//! products in the shell); a fresh store starts in the first-run wizard.\n\nuse desktop_core::features::{FeatureId, OnboardingState, UiVariant};\nuse desktop_core::fixtures::{self, ScriptedStore};\nuse desktop_core::store::PersistedState;\nuse desktop_core::{\n    AuthorityHandle, Core, CoreConfig, Delivery, Intent, Observation, Receipt, Refusal,\n    ShellSnapshot, ViewScope,\n};\nuse serde_json::json;\n\nstruct Desk {\n    _core: Core,\n    handle: AuthorityHandle,\n    session: String,\n    sequence: u64,\n}\n\nimpl Desk {\n    fn from_state(state: PersistedState) -> Self {\n        let (adapters, _handles) = fixtures::adapters_with(ScriptedStore::with_state(state));\n        let core = Core::new(CoreConfig::default(), adapters);\n        core.start();\n        let handle = core.operator();\n        let session = handle.register_delivery_session().expect(\"session\").nonce;\n        Self {\n            _core: core,\n            handle,\n            session,\n            sequence: 0,\n        }\n    }\n\n    async fn send(&mut self, intent: serde_json::Value) -> Result<Receipt, Refusal> {\n        let intent: Intent = serde_json::from_value(intent).expect(\"intent\");\n        self.sequence += 1;\n        self.handle\n            .dispatch(\n                Delivery {\n                    session: self.session.clone(),\n                    sequence: self.sequence,\n                },\n                intent,\n            )\n            .await\n    }\n\n    fn snap(&self) -> ShellSnapshot {\n        match self.handle.observe(ViewScope::Shell).expect(\"observe\") {\n            Observation::Shell { snapshot, .. } => snapshot,\n            _ => unreachable!(\"shell scope\"),\n        }\n    }\n}\n\nfn v2_ids(snap: &ShellSnapshot) -> Vec<FeatureId> {\n    snap.features.iter().map(|f| f.id).collect()\n}\n\n#[tokio::test]\nasync fn an_older_store_that_persisted_the_legacy_presentation_still_gets_v2() {\n    let state = PersistedState {\n        ui_variant: UiVariant::Legacy,\n        onboarding: OnboardingState::Done,\n        ..Default::default()\n    };\n    let mut desk = Desk::from_state(state);\n    let snap = desk.snap();\n    assert_eq!(snap.ui_variant, UiVariant::V2);\n    assert_eq!(\n        v2_ids(&snap)[..7],\n        [\n            FeatureId::Home,\n            FeatureId::Inbox,\n            FeatureId::Harness,\n            FeatureId::Academy,\n            FeatureId::Library,\n            FeatureId::ApiClient,\n            FeatureId::Administration\n        ]\n    );\n    // The switch intent is accepted and changes nothing.\n    desk.send(json!({\"kind\": \"setUiVariant\", \"variant\": \"legacy\"}))\n        .await\n        .expect(\"accepted\");\n    let after = desk.snap();\n    assert_eq!(after.ui_variant, UiVariant::V2);\n    assert_eq!(v2_ids(&after), v2_ids(&snap));\n}\n\n#[tokio::test]\nasync fn every_destination_the_legacy_shell_reached_is_a_v2_destination() {\n    let state = PersistedState {\n        onboarding: OnboardingState::Done,\n        ..Default::default()\n    };\n    let mut desk = Desk::from_state(state);\n    for feature in [\n        \"home\",\n        \"inbox\",\n        \"harness\",\n        \"academy\",\n        \"library\",\n        \"apiClient\",\n        \"administration\",\n        \"runtime\",\n        \"gateway\",\n        \"redTeam\",\n        \"sessions\",\n        \"settings\",\n    ] {\n        desk.send(json!({\"kind\": \"navigate\", \"feature\": feature}))\n            .await\n            .unwrap_or_else(|r| panic!(\"{feature}: {r:?}\"));\n        let snap = desk.snap();\n        assert_eq!(\n            serde_json::to_value(snap.active_feature).expect(\"json\"),\n            json!(feature)\n        );\n    }\n}\n\n#[tokio::test]\nasync fn a_fresh_store_starts_in_the_first_run_wizard_of_the_only_presentation() {\n    let desk = Desk::from_state(PersistedState::default());\n    let snap = desk.snap();\n    assert_eq!(snap.ui_variant, UiVariant::V2);\n    assert_eq!(snap.onboarding, OnboardingState::Needed);\n    assert!(snap.tenants.is_empty());\n}\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_43","type":"command_execution","command":"/bin/zsh -lc \"sed -n '1,120p' docs/architecture/ui-v2/state-ownership.md; sed -n '1,110p' docs/architecture/ui-v2/screens/reviews-administration.md; sed -n '1,95p' docs/architecture/ui-v2/screens/harness.md; sed -n '1,95p' docs/architecture/ui-v2/screens/wizard.md; cat docs/architecture/ui-v2/prototype/MANIFEST.sha256; sed -n '1,72p' docs/planning/p09-recut.md\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_43","type":"command_execution","command":"/bin/zsh -lc \"sed -n '1,120p' docs/architecture/ui-v2/state-ownership.md; sed -n '1,110p' docs/architecture/ui-v2/screens/reviews-administration.md; sed -n '1,95p' docs/architecture/ui-v2/screens/harness.md; sed -n '1,95p' docs/architecture/ui-v2/screens/wizard.md; cat docs/architecture/ui-v2/prototype/MANIFEST.sha256; sed -n '1,72p' docs/planning/p09-recut.md\"","aggregated_output":"# State ownership\n\nEvery state key the frozen prototype actually holds is listed here, by file\nand by the name the prototype uses, with its owner, where it lives, its\nlifetime, and whether the implementation keeps, renames, derives or drops it.\n\n- **Core** — Rust-owned in desktop-core, exposed through `observe`\n  (persisted in the store or session-held), never in browser storage.\n- **UI** — transient presentation state in a per-screen-family zustand store\n  (shell, wizard, inbox, admin, harness, workbench) or React form state.\n  Lost on reload by design.\n- **Host** — never leaves the native host (secret sheet, clipboard).\n- **Dropped** — not implemented; the reason is in [provenance.md](provenance.md).\n\nThe inventory was produced from `grep -o` over `s.*`, `ts.*` and `f.*` in\n`prototype/R2App.dc.html` and `prototype/R2Onboard.dc.html` (version 134)\nand reconciled by hand; a key missing here is a specification defect.\n\n## R2Onboard — wizard and add-tenant sheet (`s.*`, `s.f.*`)\n\n| Prototype key | Meaning | Owner | Where / intent | Lifetime | Disposition |\n|---|---|---|---|---|---|\n| `s.idx`, `s.path`, `s.vi` | current step, step path, visited steps | UI | wizard store | until the wizard closes | kept; `onboarding=inProgress` is set in core when the welcome step is left |\n| `s.f.name` | tenant display name | UI → Core | `completeOnboarding`/`addTenant` | written at completion | kept |\n| `s.env`, `s.region` | environment, region selects | UI → Core | same | same | kept |\n| `s.f.tsg` | TSG id (10 digits) | UI → Core | same | same | kept |\n| `s.f.clientId`, `s.f.secret` | management OAuth client id and secret (required in the prototype) | id: UI → Core; secret: **Host** | id in `addTenant`; secret entered only in the host secret sheet, vault record id returned | secret never in the web layer | **changed** (deviation P17): management credentials become an optional second section under D013; the id is kept, the secret field is replaced by \"Add management client…\" |\n| `s.scanOn`, `s.f.scanKey` | scan key toggle and value | toggle: UI; key: **Host** | \"Add scan key…\" opens the host secret sheet; required for first run (D013) | never in the web layer | **changed** (P1, P17): toggle removed on first run (the scan key is required); kept in add mode |\n| `s.gwOn`, `s.f.ws`, `s.f.endpoint`, `s.f.gwKey` | Gateway section toggle, workspace name, endpoint URL, workspace key | toggle/ws/endpoint: UI → Core; key: **Host** | `addTenant.gateway{ws, endpoint}`; key via secret sheet | — | kept; key path changed (P1) |\n| `s.tried`, `s.vsig`, `s.vsStale` | validation attempted, validation signature, stale flag | UI (tried) / Core (signature, stale) | wizard component; `setup.verify.stale`, `setup.completable` | per step / per draft | kept; the signature and the completion gate moved to the core so the presentation cannot complete over stale results |\n| `s.vs` | verify results per product | Core | `ShellSnapshot.setup.verify` (streamed `VerifyStep`s from `verifyTenantSetup`, with `done`/`failed`/`stale`) | until the draft completes or is discarded | kept; computed in core, including staleness against a signature of the draft's inputs |\n| `s.aesFixed`, `s.failCleared` | AES warning demo acknowledged; failed row cleared | UI | wizard store | per run | **changed**: AES is not an admitted product (P18); the warning demo becomes a generic \"warning row\" fixture on an admitted product |\n| `s.prods` | selected products | UI → Core | `completeOnboarding.products` | written at completion | kept; unavailable products are not selectable (P18) |\n| `s.packs`, `s.casesState` | starter packs selected, pack state | UI → Core | `completeTenantSetup.products` → the bundled catalog's cases as library entries named by their starter pack, Not run (P55) | written at completion | kept |\n| `s.acad`, `s.af` (`f.email`, `f.dname`), `s.streaks`, `s.remind` | local Academy account form, streaks, reminders | **Dropped** / Core (Academy) | Academy identity is hosted (D004–D006, C04); the step signs in or skips | — | **changed** (P19): no local account, streaks or reminders in the wizard |\n| `s.help` | help popover open | UI | wizard store | transient | kept |\n| `s.opened` | \"Open Prisma AIRS\" progress | UI | mirrors the `onboarding` transition | transient | kept |\n| `s.theme` | theme prop | Core | `appearance` | — | kept (observed) |\n\n## R2App — shell (`s.*`)\n\n| Prototype key | Meaning | Owner | Where | Lifetime | Disposition |\n|---|---|---|---|---|---|\n| `s.tenant`, `s.byTenant` | active tenant; per-tenant state bag | Core | `ShellSnapshot.active`, per-tenant scopes below | persisted | kept; the bag is replaced by scopes |\n| `s.screen` | destination | Core | `navigate` intent, `ShellSnapshot.features` | session | kept; feature ids gain `home`, `inbox` |\n| `s.theme` | theme | Core | `appearance` | persisted | kept |\n| `s.wizard`, `s.added` | first-run wizard open; add-tenant sheet result | Core / UI | `ShellSnapshot.onboarding`; sheet result is a toast | — | kept |\n| `s.overlayDone` | prototype overlay bookkeeping | **Dropped** | canvas-only | — | dropped |\n| `s.palette`, `s.pq` | palette open, query | UI | shell store | transient | kept |\n| `s.tenantOpen`, `s.guard` | switcher open; switch guard | UI | shell store; guard content from the `SwitchBlocked` refusal (`to`, `pending`, `completion`), rendered by the shell for a switch and by the wizard for a setup completion | transient | kept (I1); completion is the same guarded path (P36) |\n| `s.toast`, `s.toastKind`, `s.undo` | toast text, kind, undo target | UI | shell store, timer | ≤ 6 s | kept (I10) |\n| `s.detail`, `s.sheet` | detail sheet; confirm sheet | UI | shell store modal stack | transient | kept (I8) |\n| `s.explain` | explain-mode toggle | UI | shell store | transient | kept |\n| `s.sel`, `s.itab` | Inbox selection, tab | UI | shell store, keyed by tenant id | transient; a switch round trip keeps it (I2) | kept |\n| `s.product`, `s.exp`, `s.ptab`, `s.allOpen`, `s.adminNav`, `s.adminQ`, `s.tree` | Administration product, expanded set, tab per product, expand-all, nav mode, search, tree | UI | admin store | transient | kept |\n| `s.review`, `s.reviewKind`, `s.reviewFrom`, `s.reviewTenant`, `s.reviewApplied` | review open, kind, origin, bound tenant, applied | Core | `Review` scope (tenant-bound, invalidated on context change) | session | kept; the UI holds only \"open\" |\n| `s.typed` | typed confirmation | UI | admin store | until review exit | kept (I3) |\n| `s.secretVisible` | reveal toggle | **Host** | `RevealSecret` sheet; UI holds nothing | 60 s sheet | **changed** (P2): no web reveal state |\n| `s.credOpen`, `s.credVal` | credential dialog open, value | Host | credential entry is the host secret sheet | — | **changed** (P1): no web credential value |\n| `s.packsOpen`, `s.packPick` | starter-pack dialog, picks | UI → Core | library intent | transient | kept |\n| `s.ncOpen`, `s.ncName`, `s.ncPid`, `s.ncInput`, `s.ncDir` | new-case dialog fields | UI → Core | `createCase` (existing library) | transient | kept |\n| `s.casePage`, `s.caseQ`, `s.cfil` | Test Cases paging, search, filter | UI | Test Cases screen state (keyed by context) | transient | kept |\n| `s.req`, `s.reqQ`, `s.fmt`, `s.rtab`, `s.rsub` | API Client request, search, body format, response tab, sub-tab | UI | workbench store | transient | kept |\n| `s.quiz` | Academy quiz state | **Dropped** | hosted Academy owns it (P19) | — | dropped |\n| `s.convoHint` | ended-conversation hint | UI | harness store; cleared by any navigation; its opening question is the core's `opening` (the conversation's, or the opened saved record's), never the title (P51) | transient | kept |\n| (none; DESIGN-V2 §3) | \"Show the calls\" preference and panel | Core | `ShellSnapshot.showCalls` (the operator's choice once made, else on until onboarding completes) and `ShellSnapshot.calls` (the active tenant's calls this app run: request line, credential kind, header names, status, duration; never a value, query or body) (P54) | preference persisted; calls in memory for the app run | added |\n| `ts.activeCase` hand-off | the case opened in the Playground | UI → Core | shell store `playground` (tenant, case, fields) → Runtime Playground prefill; the scan names the case (`scan.case`) and the core records its result (P55, P56) | until the next hand-off | kept |\n\n## R2App — per-tenant (`ts.*`)\n\n| Prototype key | Meaning | Owner | Where | Lifetime | Disposition |\n|---|---|---|---|---|---|\n| `ts.reading`, `ts.reads`, `ts.firstRead`, `ts.lastRead`, `ts.warnCleared`, `ts.capsScan` | read in progress, count, first read done, last-read time, warning cleared, scan capability | Core | `ReadStatus` scope, from the tenant's read record (one per opened tenant, kept across a switch round trip, P37) | session, per tenant | kept (I4); `reads` count is not shown and never feeds a timestamp |\n| `ts.ack`, `ts.snoozed` | acknowledgments, snoozes with return | Core | `InboxEntry.hold` (`acknowledge`, or `snooze` with `returnsAt` computed in the core); intents `acknowledgeItem`/`snoozeItem`/`unsnoozeItem`; the last snooze's `SnoozeReceipt` on the Inbox scope is what the toast announces, once (P38) | session, per tenant (as v1's holds) | kept (I11); not persisted across a relaunch, as the retained holds were not |\n| `ts.prompt`, `ts.dir`, `ts.profile`, `ts.model`, `ts.app`, `ts.kind`, `ts.scanned`, `ts.scanDir`, `ts.scanProfile`, `ts.results`, `ts.activeCase`, `ts.activeInput`, `ts.activeDir` | Playground prompt, direction, profile, model, app, classified kind, scanned flag, scan selectors, per-case results, active case | prompt/dir/profile/model/app: UI; scan result + per-case results: Core | workbench store; `ScanRecordView` (existing) and library case results | prompt transient; results persisted per tenant | kept; verdict computed by the existing scan path, never by a UI classifier (the prototype's `classify` is fixture-only) |\n| `ts.extraCases`, `ts.packs` | user-created cases, packs | Core | library | persisted | kept |\n| `ts.hist` | API responses | Core | workbench history | persisted | kept (I5) |\n| `ts.topicRev`, `ts.topicDesc`, `ts.injApplied`, `ts.aesApplied`, `ts.aesRev` | applied review results | Core | read back from the product scopes after apply | — | kept for Runtime topics; `aes*` **dropped** (P18) |\n| `ts.keyRotated`, `ts.keySecretClosed`, `ts.keyDeployed`, `ts.keyDoneAt` | rotation stage | Core | `Tenant.rotations` → `ShellSnapshot.rotations: RotationView{stage, oldKey, newKey, issuedBy, deploymentAcknowledgedAt, oldKeyRemovedAt, removalRejected}`; stage derived (issuanceUnconfirmed, issued, resumed, acknowledged, removalUnconfirmed, complete); intent `acknowledgeDeployment` | per tenant, persisted (timestamps stored once, and the reviewed key name that alone confirms an unconfirmed issuance); the held secret only on its change result, for its context | **changed** (P20, P41): supported Version → Delete sequence; see screens/reviews-administration.md |\n| `ts.follows` | follow-up status per conversation | Core | sessions | persisted | kept |\n| `ts.convo`, `ts.userConvos`, `ts.msgsBy`, `ts.decs`, `ts.ended`, `ts.archived` | current conversation, user conversations, messages, decisions, ended flags, archives | Core | existing harness sessions and decisions | persisted, protected | kept |\n| `ts.draft` | composer draft | UI | shell store per tenant and workspace ID (`harnessDrafts`), with kept messages (`harnessUnsent`: not sent, or not confirmed until their own conversation reports the core took their send ID, `ConversationView.submissions`) | transient | kept |\n\n## Credential entry paths (native)\n\n| Credential | Entry | Storage | Readable by the web layer |\n|---|---|---|---|\n| Scan API key | webview password field read through a ref, cleared at once, sent once as `EnteredSecret` inside `configureScanCredential` (P25) | vault (`cr-` record), Keychain v2 namespace | state and mode only (`ScanView`), never the value |\n| Management client secret | same path, `configureManagementCredential` (optional section) | vault | client id and state only |\n| Gateway workspace key | same path, `configureInferenceCredential` | vault | state only |\n| Issued API key (rotation) | `RevealSecret` host sheet / host clipboard | held per result for the active context, never persisted; retired by the review's exit (`DiscardChange` on the applied review, also before the change settles), by acknowledging the deployment, or by a context change | never |\n# Reviews, Administration and key rotation\n\nSource: `R2App` (`REVIEWS` line 826, `rvKind`, `canApply`, `doApply`,\n`appliedKey`, `appliedOther`, `TOPICS`, `PROFILES`, `verdictFor`, `T` admin\ntables, API keys row actions). Chunk: C31. Every change goes through the\nexisting Configuration review (`changes.rs`, D014): the review binds tenant,\ncredentials, resource and draft, and changed context invalidates it.\n\n## Administration\n\n- Accordion of the products in DESIGN-V2 §6. Each admitted product expands to\n  tabs from `AdminInventory`, generated from the complete table in\n  [administration-inventory.md](administration-inventory.md): every tab is\n  mapped to an admitted read and every creation or row action to an admitted\n  `ChangeKind` + `ChangeAction` with its label, and every denied action,\n  unavailable tab and removed tab is named there. A product or tab with no\n  admitted service renders as **Not available in this release** with the\n  dependency it waits on; it never shows invented inventory and never offers\n  a mutation (V2-T20, V2-R11).\n- Tables: columns per tab, row actions \"Edit…\", \"Rotate…\", \"Finish\n  rotation…\", \"View\", \"Results\". Read-only products (Red Team, Model/skill)\n  never offer a change.\n- Security profiles and Custom topics derive \"Used by\" from one topic\n  inventory; detector ids and topic keys are distinct types.\n\n## Review (I3)\n\n- Opened by `openReview{kind, action, resource}`; the scope carries tenant,\n  resource, before/after diff lines, impact (from `changes::impact`), and the\n  typed-name requirement.\n- The UI shows the diff, impact, a text field \"Type <name> to confirm\" and\n  Apply (disabled until match). `confirmReview{review_id, typed}` is\n  validated in the core: wrong name, different tenant or changed context\n  refuses with the reason, and the UI shows a warn toast naming the tenant.\n- Applied panel (non-key): \"Live. The item was read back.\" with name,\n  revision, time, tenant. Done. Unknown outcome renders the existing\n  \"not confirmed\" state with the reconciliation step, never a success.\n- Any review exit (Done, Escape, tenant switch, context retirement) calls\n  `ForgetSecret` for any held one-time key and resets `secretVisible` (I6).\n\n## Key rotation (I6, I7) — supported sequence\n\nThe prototype promised a grace period with a later revocation and a secret\nrecoverable from the Keychain. The retained core supports neither as one\noperation: `ChangeAction::Rotate` regenerates a key in place (no grace), and\n`ChangeAction::Version` creates an additional key while the existing one is\nunchanged (`changes.rs` 842–846, `management.rs` 980–988). Issued keys are\nheld per result for the active context only and never persisted\n(DESIGN.md \"Secrets\"). The implemented flow therefore uses the two admitted\noperations in sequence and never stores a secret. It applies to Runtime\nSecurity API keys only: Gateway service and user keys admit `Rotate`\n(regenerate in place) and not `Version`, so they get the plain \"Rotate…\"\nreview with the existing one-time reveal and no staged sequence\n(administration-inventory.md):\n\n1. **Issue an additional key** — review `ApiKeys · Version` for the\n   application. On apply the core reads the key back, holds the one-time\n   secret in the zeroizing buffer, and the panel reads **Additional key\n   issued · old key still active**: Reveal (host `RevealSecret` sheet, 60 s,\n   selectable label) and Copy (host clipboard with marker, cleared after\n   60 s); note \"Shown once. Not stored by this app; if lost, issue another\n   key\"; actions **Finish later** / **Application updated**. Side effects:\n   Inbox item `rotation-<application>` (Needs action, \"Update\n   support-copilot with the new key, then remove the old key\"), with a\n   snooze that returns in 24 hours and no invented deadline; the key table\n   shows both keys, the old one marked \"Replace after deployment\".\n2. **Resumed** — panel reads **Rotation in progress · secret no longer\n   available**: \"The new key was shown once when it was issued and this app\n   does not keep it. If support-copilot does not have it, issue another key.\"\n   Actions: **Issue another key** (returns to step 1) / **Application\n   updated**.\n3. **Application updated** — records a *local* deployment acknowledgement\n   with its time (\"Deployment acknowledged 07:51 by you on this Mac\"; this is\n   the operator's statement, not remote evidence) and opens the review\n   `ApiKeys · Delete` for the old key.\n4. **Old key removed** — on apply the core performs the delete and reads\n   back; absent is the expected readback and the panel reads **Rotation\n   complete · old key removed 07:52** with the readback time stored once and\n   never recomputed. The Inbox item clears and the completion toast fires.\n   An unknown delete outcome shows the reconciliation state and keeps the\n   Inbox item.\n\nTwo timestamps are kept and labelled distinctly: `deployment_acknowledged_at`\n(local statement) and `old_key_removed_at` (remote readback). Neither is\nderived from read counts. `ChangeAction::Rotate` (regenerate in place) stays\navailable from the key row as \"Regenerate…\" with the existing impact text\n\"Replaces this key; update every integration using it\"; it is not called\nrotation in the UI.\n\n## Playground verdicts\n\n- Detector results and topic matches are independent. A profile without the\n  detector, or without the topic assigned, yields \"Not detected\" with the\n  reason; monitor-only turns Blocked into Flagged; applying a topic never\n  suppresses an enabled detector. The applied topic's example prompts\n  classify under the topic and show Flagged when assigned.\n\n## Fixtures and tests\n\n- Boards R2Admin, R2Review. Tests V2-R03 (confirmReview refusals), V2-R06\n  (held key dropped on every review exit, tenant switch and context\n  retirement; Reveal after drop refuses), V2-R07 (rotation state machine:\n  Version → acknowledge → Delete → readback, with these named failure\n  cases: (a) failed issuance: refusal shown, no key held, no Inbox item;\n  (b) unknown issuance (uncertain Version outcome): state \"issuance not\n  confirmed\" with the existing reconciliation read of the application's key\n  inventory, no automatic reissue, no Inbox item until a key is read back;\n  (c) rejected or failed Delete: the reminder stays, the old key stays listed,\n  `old_key_removed_at` stays unset and the panel stays at stage 3 with the\n  refusal reason; (d) unknown Delete outcome: \"removal not confirmed\" with\n# Harness\n\nSource: `R2App` (`CONVOS` blocks/mcp/keys at lines 760–790, `decs`, `ended`,\n`archiveActive`, `sendDraft`, `startNewConvo`, `convoHint`, `follows`),\nboards R2Harness, R2Harness2, R2Harness3. Chunk: C32.\n\nThe screen is a re-skin of the existing Harness engine, sessions, decisions,\nMCP and sign-in modules (C19–C22); the conversation, decision and project\nauthority model is unchanged. D014's Harness restrictions hold: a proposal\nnever authorises Apply.\n\n## Layout\n\n- Title row \"Harness\" with tenant and engine status; left rail of\n  conversations (lifecycle seeds appear only on non-fresh fixture tenants;\n  user conversations titled from their first message; archived ones marked\n  ended); main transcript; one composer per tenant and workspace (its draft kept across navigation, tenant round trips and a conversation's retirement), with messages that reached no conversation, or whose delivery was not confirmed, kept apart for recovery and never sent by themselves (provenance P50).\n- Prerequisites checklist (tenant, management client, Gateway workspace,\n  company sign-in) stays visible until satisfied (D057 F05).\n\n## Lifecycles (fixture conversations)\n\nAll three are **read-only** tool-call lifecycles in the prototype; none\nwrites to a tenant from the Harness.\n\n1. **blocks** — \"Why were 14 prompts blocked on claims-triage overnight?\":\n   read-only tool call `list_security_events` (in-page Approve once /\n   Decline), result summary, recommendation, follow-up \"Open the review\"\n   that opens the injection-override topic review in Administration\n   (Runtime Security, `ChangeKind::Topics`).\n2. **mcp** — \"Which laptops run an MCP server that is not on the allow\n   list?\": in the prototype the read-only call targets an AES inventory.\n   AES has no admitted service (DESIGN-V2 §6), so the implemented fixture\n   reads the workspace MCP server inventory the core already exposes\n   (`GatewayRead::McpServers`, C22) and its follow-up opens a Gateway\n   guardrail review (`ChangeKind::GatewayGuardrails`). Recorded as\n   deviation P16.\n3. **keys** — \"Which API keys expire before the audit, and can you rotate\n   them?\": read-only key inventory; the Harness refuses to rotate (\"rotation\n   is a write; it goes through Administration and a review\") and hands off\n   to the key rotation flow. The follow-up text reflects the rotation stage\n   (additional key issued / old key removed).\n\nEach has approve, decline, end and follow-up paths. Declining records the\ndecision and the assistant's declined text; ending seals the session\n(`endConversation` → archive id) and the rail shows it ended.\n\nTool-call approval stays as C21/C22 built it: the core decides from the\ntool's write flag whether the host's native confirmation sheet is required;\nread-only calls use the in-page bar. No P09 fixture exercises a write-capable\ncall; the native sheet path is covered by the existing C21 tests.\n\n## Rules\n\n- A fresh tenant's first send creates a user conversation (I12); sending in\n  an ended conversation creates a new one.\n- Contextual navigation into an ended conversation shows a hint with \"Open\n  the saved transcript\" (archived transcript detail) and \"Start a new\n  investigation\" (new conversation prefilled with the opening question). The\n  hint clears on any navigation.\n- A pending decision blocks tenant switch (I1).\n\n## Fixtures and tests\n\n- Boards R2Harness (blocks), R2Harness2 (mcp), R2Harness3 (keys). Tests\n  V2-R01, V2-T01, T13; V2-T17 approve/decline/end/follow-up per lifecycle;\n  V2-T18 the keys lifecycle never dispatches a mutation from the Harness.\n# First-run wizard and add-tenant sheet\n\nSource: `prototype/R2Onboard.dc.html` (steps, `ERR`, `touch`, `vsig`,\n`verify`, `opened`, `railCtx`, `mode=\"add\"`), `R2App` `addtenant` overlay.\nChunk: C29. Realises D013 (scan-key-first onboarding).\n\n## Steps (first run)\n\n1. **Welcome** — explains that the app is built entirely on Palo Alto\n   Networks' public APIs and exists to show application builders what those\n   interfaces make possible; three cards: Built on the public APIs / See the\n   calls as you go / Learn by doing. Continue.\n2. **Tenant** — name, environment (select), region (select), TSG id, then\n   three credential sections in this order (D013, deviation P17):\n   **Scan key** (required on first run): \"Add scan key…\" opens the host\n   secret sheet and returns a vault id shown as a masked indicator.\n   **Management client** (optional): client id field plus \"Add client\n   secret…\" (host secret sheet); without it Administration is read-only and\n   says so. **Gateway** (optional toggle): workspace name, endpoint URL,\n   \"Add workspace key…\". Secondary action \"Import from Prisma AIRS Desktop\n   v1\" fills name/environment/TSG from the import intent; secrets are always\n   re-entered. Validation per field on blur with\n   `aria-invalid` and `aria-describedby`; the Continue button names what is\n   missing. After this step the rail shows \"Name · Environment · TSG …\" under\n   its title.\n3. **Products** — cards for the products in DESIGN-V2 §6. Admitted products\n   show licence state read from the tenant and are selectable; Red Team and\n   Model/skill are marked read-only; Agentic Identity Security and Agentic\n   Endpoint Security are shown as \"Not available in this release\" and cannot\n   be selected (P18).\n4. **Verify** — dispatch `verifyTenantSetup`; per-product rows fill as\n   `VerifyStep` results stream (pass / warning / fail with reason) using the\n   existing reads for each admitted product (scan capability check, a\n   management read when a client is present, Gateway prerequisites).\n   Unavailable products show \"Not available\", never a result. The warning\n   and failed rows are fixtures on admitted products. Fail offers \"Fix and verify\n   again\" (returns to Tenant) or \"Continue with warnings\"; warnings become\n   Inbox items on completion.\n5. **Starter packs** (optional) — test-case packs per selected product with\n   counts.\n6. **Academy account** (optional) — sign in or skip; the trust copy states\n   exactly what syncs (Academy progress only).\n7. **Done** — summary; \"Open Prisma AIRS\" is finite (`opening` → done) and\n   dispatches `completeOnboarding`.\n\n## Add-tenant sheet (`mode=\"add\"`)\n\n- 1160×780 sheet over the shell, rail 244px, no Welcome or Academy steps,\n  Cancel at every step; completion dispatches `addTenant` then `switchTenant`.\n  Cancel discards everything except a credential already written by the\n  secret sheet, which is shown in Administration as unattached and can be\n  removed there.\n\n## Core contract\n\n- `verifyTenantSetup{draft}` → stream of `VerifyStep{product, state, reason}`\n  then `VerifyDone{warnings}`.\n- `completeOnboarding{name, env, region, tsg, scan_credential_id,\n  management: {client_id, credential_id}?, gateway: {ws, endpoint,\n  credential_id}?, products, packs, academy_opt_in, warnings}` writes the tenant profile, product\n  selection, packs and Inbox warning items; sets `onboarding=done`.\n- `addTenant{...same minus academy}`.\n- The core never receives a secret through these intents; `credential_ids`\n  reference vault records created by the host secret sheet.\n\n## Fixtures and tests\n\n- Boards: see [boards.md](boards.md) (`fx.on.*`, `fx.addTenant`).\n- Tests: step validation and invalidation signature; streaming verify order;\n  cancel semantics; `onboarding` transitions; V2-N02.\n- Live (C29 only): verify against Vulture, reads only, under the designated\n  scope.\nce90fce7789c485b67fac300ecfa81e831bf23bc26da8cca2b7ff3dd45712638  R2App.dc.html\n5f8c08d8c439c402b27bbf5eb896884966fb4f794c1c85fcd62c2d9f17268b1d  R2Harness.dc.html\nbdd59a833b9896c851021bc815cd61a21d88f21f345f3da96b2395f053275ccb  R2Harness2.dc.html\n0700f12e8b74c5c8d822bab01dec53c52eda60eb47dd79ecb93b3c8b7e156076  R2Harness3.dc.html\n2fec0565909fb6d1889655ebf3db1222f93a3a152edf6785e899e03a892c1eda  R2Onboard.dc.html\nafe2f2ef3ee68207a2d2487b43b89a4aeb3625f8ec792996a9a4da936485658b  R2Rationale.dc.html\n# P09 re-cut: port the prototype, one gate per screen\n\nAgreed with the owner on 2026-10-29 after C32 took twenty review rounds while\nthe built v2 screens never matched the design. This supersedes the chunking\nof C33–C34 in `IMPLEMENTATION-PLAN.md`; the specification\n(`docs/architecture/ui-v2/`) and the core work of C27–C33 stand.\n\n## The bar\n\n- **The prototype is the spec.** `docs/architecture/ui-v2/prototype/` (Refined\n  Native v2, version 134, checksums in `MANIFEST.sha256`) is the reference for\n  every screen; the canvas is not consulted.\n- **A screen is done when it matches its board.** Side by side at 1440 wide in\n  light and dark (the board is drawn at 1440×900; where the display cannot\n  give a 900px web area both sides are rendered at the window's measured web\n  area, named in the composite's caption, 1440×800 on the current Mac), with\n  real core data wired, and the fast checks (typecheck,\n  Vitest, the affected Rust suites) passing. Parity is structural: regions,\n  widths, spacing, type scale, tokens and component shapes. Content differs;\n  accessibility corrections (focus rings, contrast, status regions) may deviate\n  and are noted. The owner judges each composite.\n- **Composites** live at `docs/planning/evidence/<chunk>/parity/<board>-<theme>.png`\n  (prototype left, app right) with `notes.md` listing deviations, produced by\n  `tools/parity/compose.py` (headless render of the prototype board beside the\n  fixture app's own capture).\n- **One heavy gate per chunk**, after the owner's parity approval: rebuild,\n  native acceptance, the full Rust fixture suite and the Codex review, accepted\n  at **8**. The phase review (after C44) is **9**; the C29 live Vulture row runs\n  before it once the owner designates the L19 family.\n- **No legacy views inside v2.** Each screen is new components over the\n  existing core intents and `ShellSnapshot`; the legacy feature components stay\n  untouched for the legacy shell until C44 removes it.\n- **Cadence.** The shell is approved before any screen inside it. After that\n  a chunk's composite is posted and work moves to the next chunk; the owner's\n  notes are applied as they arrive.\n\n## Chunks\n\n| Chunk | Screen | Board(s) | Notes |\n|---|---|---|---|\n| C33 | core: case results and packs, call log, submissions | — | committed without a receipt; its two screens are superseded by C40/C41 |\n| C35 | Shell | R2App any start | 56px header (title, 260px search, Explain switch = `showCalls`, Harness button); nav with product children and badges; status block; tenant menu 360px; palette 640px; tokens: text 13px, gaps, scrims, header/section/overlay sizes; Classic switch moves to Settings |\n| C36 | Home | start=home | 3-column product cards with sparklines; Needs attention beside Quick actions |\n| C37 | Inbox | start=inbox | fix-up: 430px list column, 3-column facts grid |\n| C38 | Harness | start=harness (+ convo boards) | title band; 244px rail; transcript with 46px composer; 350px Decisions aside; own setup panels |\n| C39a | Administration: Runtime Security | start=admin | section + tab strip; overview stat grid with sparkline; Playground form; generic tables over the management reads |\n| C39b | Administration: other products | start=admin, start=review | the remaining products on the same pattern; the review sheet (620px) |\n| C40 | Test Cases | start=cases | explain banner; one table card; packs and new-case dialogs (560px); detail sheet (520px) |\n| C41 | API Client | start=api | full port: title row with chips; 286px request tree; open-request tabs; request sub-tabs; response pane |\n| C42 | Academy | start=academy | prototype chrome around the hosted learner embed; composite judged on the chrome |\n| C43 | Wizard | R2Onboard (all steps, mode=add) | re-port of the presentation over the existing state machine: pinned footer, 320/244px rail, section cards, segmented control, switch; model-driven extras housed in the prototype's cards |\n| C44 | Legacy shell removal + phase review | — | on a branch; then the P09 review at 9 |\n\nEach chunk brief under `docs/planning/chunks/` names the board, the regions\nto port, the core intents and snapshot fields it reads, the native checks and\nthe test ids. The controller registers C35–C44 with a bar of 8.\n\n## Fast loop\n\nWhile building: `pnpm --filter @prisma-airs/desktop exec tsc --noEmit`,\n`vitest run` for the desktop app, and `cargo test -p desktop-core --features\ntest-fixtures --test <suite>` for suites the change touches. The rebuild and\nnative run happen only at the gate, or when the composite needs a fresh capture.\nReviews run from a separate worktree so work continues meanwhile.\n\n## First moves\n\n1. Commit C33 as it stands (core, tests, the superseded screens).\n2. Commit this re-cut: chunk briefs, controller registration, checks.\n3. Build `tools/parity/compose.py` and run it on the current shell: the first\n   composite is the baseline gap.\n4. C35.\n","exit_code":0,"status":"completed"}}
