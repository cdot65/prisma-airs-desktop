+//! L09 Gateway inference (C25): bounded streamed runs through the
+//! production Playground (`configureInferenceCredential`, `runInference`,
+//! `stopInference`) in the designated workspace, with its own inference key
+//! (never the management client). Each run is charged against the `runs`
+//! budget before it starts; the tokens the Gateway reports are charged to
+//! `tokens` afterwards and a run over the cap stops the family. The core
+//! sends only to the configured Gateway endpoint; there is no upstream
+//! fallback for the runner to take.
+
+use std::collections::BTreeMap;
+
+use serde_json::{Value, json};
+
+use crate::live_run::{Desk, DeskOptions, FamilyResult, Found, Outcomes, Run, Spec, Stop};
+use crate::{Result, now_utc};
+
+const STREAM: Spec = Spec {
+    id: "L09-stream",
+    workflows: &["W40"],
+};
+const CANCEL: Spec = Spec {
+    id: "L09-cancel",
+    workflows: &["W40"],
+};
+const ERROR: Spec = Spec {
+    id: "L09-error-recovery",
+    workflows: &["W40"],
+};
+
+/// A short synthetic prompt (bounded output).
+const PROMPT: &str = "Reply with the single word: ready.";
+/// A prompt that streams long enough to be stopped.
+const LONG: &str = "Count from 1 to 200, one number per line.";
+
+/// `prompt` made unique to this run, so a Gateway response cache cannot
+/// answer it: a cached answer is replayed as one chunk without
+/// `finish_reason`, which the SDK's stream contract refuses (C25).
+fn fresh(prompt: &str) -> String {
+    format!("{prompt} (C25 run {})", now_utc())
+}
+
+async fn start(desk: &mut Desk, reference: &str, run: Value) -> Result<Value> {
+    let context = desk.context_text()?;
+    desk.admit(
+        json!({"kind": "runInference", "context": context, "workspace": reference, "run": run}),
+    )
+    .await
+    .map(|op| json!(op))
+}
+
+fn playground(j: &Value) -> Value {
+    j["gateway"]["playground"].clone()
+}
+
+async fn ended(desk: &Desk) -> Value {
+    desk.until(desk.settle, |j| {
+        playground(j)["state"]
+            .as_str()
+            .is_some_and(|s| s != "running")
+    })
+    .await
+    .map(|j| playground(&j))
+    .unwrap_or_else(|| json!({"state": "running"}))
+}
+
+fn shown(view: &Value) -> Found {
+    Found::new("passed", "")
+        .with("state", view["state"].clone())
+        .with("outcome", view["outcome"].clone())
+        .with("failure", view["failure"].clone())
+        .with("sent", view["sent"].clone())
+        .with("answered", view["answered"].clone())
+        .with("served_model", view["servedModel"].clone())
+        .with("finish", view["finish"].clone())
+        .with("usage", view["usage"].clone())
+        .with("output_chars", json!(view["output"].as_str().map(str::len)))
+}
+
+fn ids(mut found: Found, view: &Value) -> Found {
+    if let Some(trace) = view["trace"].as_str() {
+        found = found.id("trace", trace);
+    }
+    if let Some(response) = view["responseId"].as_str() {
+        found = found.id("response_id", response);
+    }
+    found
+}
+
+struct Ctx<'r, 'a> {
+    run: &'r mut Run<'a>,
+    outcomes: Outcomes,
+    stop: Option<Stop>,
+}
+
+impl Ctx<'_, '_> {
+    fn settle(
+        &mut self,
+        spec: Spec,
+        started: String,
+        inputs: BTreeMap<String, Value>,
+        found: Found,
+    ) -> Result<()> {
+        let stop = self.run.settle(
+            "L09",
+            spec,
+            started,
+            inputs,
+            found,
+            Some("L09"),
+            &mut self.outcomes,
+        )?;
+        if self.stop.is_none() {
+            self.stop = stop;
+        }
+        Ok(())
+    }
+
+    fn block(&mut self, specs: &[Spec], reason: &str) -> Result<()> {
+        for spec in specs {
+            self.settle(*spec, now_utc(), BTreeMap::new(), Found::blocked(reason))?;
+        }
+        Ok(())
+    }
+
+    /// Charges one run; a run over the cap is never started.
+    fn charge(&mut self) -> std::result::Result<(), String> {
+        self.run.guard.spend("L09", "runs", 1)
+    }
+
+    /// Charges the tokens the Gateway reported; over the cap stops.
+    fn tokens(&mut self, view: &Value) -> Option<String> {
+        let total = view["usage"]["total"].as_u64()?;
+        self.run.guard.report("L09", "tokens", total).err()
+    }
+}
+
+pub(crate) async fn run(run: &mut Run<'_>, _id: &str) -> Result<FamilyResult> {
+    let mut ctx = Ctx {
+        run,
+        outcomes: Vec::new(),
+        stop: None,
+    };
+    let all = [STREAM, CANCEL, ERROR];
+    let (Some(workspace), Some(endpoint), Some(model)) = (
+        ctx.run.nonsecret("L09", "workspace_id"),
+        ctx.run.nonsecret("L09", "inference_endpoint"),
+        ctx.run.nonsecret("L09", "model"),
+    ) else {
+        ctx.block(&all, "L09 needs workspace_id, inference_endpoint and model")?;
+        return Ok(FamilyResult {
+            outcomes: ctx.outcomes,
+            stop: None,
+        });
+    };
+    let route = ctx.run.nonsecret("L09", "route");
+    let mut desk = match ctx
+        .run
+        .management_desk("L09", DeskOptions::default())
+        .await?
+    {
+        Ok(d) => d,
+        Err(e) => {
+            ctx.block(&all, &e)?;
+            return Ok(FamilyResult {
+                outcomes: ctx.outcomes,
+                stop: None,
+            });
+        }
+    };
+    let reference = match desk.select_workspace(&workspace).await {
+        Ok(r) => r,
+        Err(e) => {
+            ctx.block(&all, &e.to_string())?;
+            return Ok(FamilyResult {
+                outcomes: ctx.outcomes,
+                stop: None,
+            });
+        }
+    };
+    let Some(key) = ctx.run.secret("L09", "inference_key")? else {
+        ctx.block(&all, "L09 designates no inference_key credential")?;
+        return Ok(FamilyResult {
+            outcomes: ctx.outcomes,
+            stop: None,
+        });
+    };
+    let context = desk.context_text()?;
+    desk.send_json(
+        json!({"kind": "configureInferenceCredential", "context": context,
+        "mode": "session", "workspace": reference, "endpoint": endpoint, "secret": (*key).clone()}),
+    )
+    .await?;
+    if desk
+        .until(desk.settle, |j| {
+            j["tenants"]
+                .as_array()
+                .is_some_and(|t| t.iter().any(|t| t["inference"]["state"] == "ready"))
+        })
+        .await
+        .is_none()
+    {
+        ctx.block(
+            &all,
+            "the inference key could not be stored for this session",
+        )?;
+        return Ok(FamilyResult {
+            outcomes: ctx.outcomes,
+            stop: None,
+        });
+    }
+    let mut inputs = ctx.run.inputs("L09", &["client_secret", "inference_key"]);
+    inputs.insert("endpoint".to_owned(), json!(endpoint));
+
+    // A complete streamed answer.
+    let started = now_utc();
+    let found = match ctx.charge() {
+        Err(e) => Found::blocked(e.clone()).stopping(format!("unexpected cost: {e}"), false),
+        Ok(()) => {
+            start(
+                &mut desk,
+                &reference,
+                json!({"model": model, "route": route, "prompt": fresh(PROMPT)}),
+            )
+            .await?;
+            let view = ended(&desk).await;
+            let mut found = shown(&view);
+            let complete = view["state"] == "completed" && view["outcome"] == "completed";
+            found.outcome = if complete { "passed" } else { "failed" };
+            found.detail = if complete {
+                "a streamed answer through the designated Gateway route, with the model it served"
+                    .to_owned()
+            } else {
+                "the run did not complete".to_owned()
+            };
+            if view["state"] == "running" {
+                found = found.stopping(
+                    "the run did not end in time; it may still be consuming",
+                    true,
+                );
+            } else if let Some(over) = ctx.tokens(&view) {
+                found = found.stopping(format!("unexpected cost: {over}"), false);
+            }
+            ids(found, &view)
+        }
+    };
+    ctx.settle(STREAM, started, inputs.clone(), found)?;
+    if ctx.stop.is_some() {
+        return Ok(FamilyResult {
+            outcomes: ctx.outcomes,
+            stop: ctx.stop,
+        });
+    }
+
+    // Stopped after the first output arrives.
+    let started = now_utc();
+    let found = match ctx.charge() {
+        Err(e) => Found::blocked(e.clone()).stopping(format!("unexpected cost: {e}"), false),
+        Ok(()) => {
+            start(
+                &mut desk,
+                &reference,
+                json!({"model": model, "route": route, "prompt": fresh(LONG)}),
+            )
+            .await?;
+            let streaming = desk
+                .until(desk.settle, |j| {
+                    let p = playground(j);
+                    p["output"].as_str().is_some_and(|o| !o.is_empty()) || p["state"] != "running"
+                })
+                .await
+                .map(|j| playground(&j))
+                .unwrap_or_default();
+            if streaming["state"] == "running" {
+                desk.send_json(
+                    json!({"kind": "stopInference", "operation": streaming["operation"]}),
+                )
+                .await?;
+            }
+            let view = ended(&desk).await;
+            let mut found = shown(&view);
+            let stopped = view["state"] == "stopped";
+            found.outcome = if stopped { "passed" } else { "failed" };
+            found.detail = if stopped {
+                "the stream was stopped by the operator's Stop; whether it was charged is reported as unknown, never assumed".to_owned()
+            } else {
+                "the run ended before it could be stopped".to_owned()
+            };
+            if let Some(over) = ctx.tokens(&view) {
+                found = found.stopping(format!("unexpected cost: {over}"), false);
+            }
+            ids(found, &view)
+        }
+    };
+    ctx.settle(CANCEL, started, inputs.clone(), found)?;
+    if ctx.stop.is_some() {
+        return Ok(FamilyResult {
+            outcomes: ctx.outcomes,
+            stop: ctx.stop,
+        });
+    }
+
+    // A model the route does not serve: refused, nothing sent elsewhere,
+    // and the Playground recovers for the next run.
+    let started = now_utc();
+    let missing = ctx
+        .run
+        .nonsecret("L09", "unavailable_model")
+        .unwrap_or_else(|| "c25-unavailable-model".to_owned());
+    let found = match ctx.charge() {
+        Err(e) => Found::blocked(e.clone()).stopping(format!("unexpected cost: {e}"), false),
+        Ok(()) => {
+            start(
+                &mut desk,
+                &reference,
+                json!({"model": missing, "prompt": PROMPT}),
+            )
+            .await?;
+            let view = ended(&desk).await;
+            let mut found = shown(&view);
+            let refused = view["state"] == "failed" && view["servedModel"].is_null();
+            let context = desk.context_text()?;
+            let cleared = desk
+                .send_json(json!({"kind": "clearInference", "operation": view["operation"]}))
+                .await
+                .is_ok();
+            found.outcome = if refused && cleared {
+                "passed"
+            } else {
+                "failed"
+            };
+            found.detail = if refused {
+                "the Gateway refused the unknown model; no answer and no other model were shown, and the run was cleared".to_owned()
+            } else {
+                "an unknown model did not fail as expected".to_owned()
+            };
+            let _ = context;
+            ids(found, &view)
+        }
+    };
+    ctx.settle(ERROR, started, inputs, found)?;
+    Ok(FamilyResult {
+        outcomes: ctx.outcomes,
+        stop: ctx.stop,
+    })
+}
diff --git a/crates/xtask/src/live_mcp.rs b/crates/xtask/src/live_mcp.rs
new file mode 100644
index 00000000..31bd6366
--- /dev/null
+++ b/crates/xtask/src/live_mcp.rs
@@ -0,0 +1,365 @@
+//! L17 Workspace MCP (C25) through the production intents: the selected
+//! workspace's catalog (`listMcpServers`), the desktop's own OAuth sign-in
+//! to a designated server (`signInMcpServer`; the operator completes the
+//! authorization page, and the core's loopback callback finishes it), a
+//! scope or grant change the operator makes (the catalog then shows the
+//! sign-in stale), and revocation (`signOutMcpServer`). Tool calls, their
+//! approval and denial, and token refresh happen inside the native Harness
+//! engine and are recorded as needing the desktop app.
+
+use std::collections::BTreeMap;
+use std::time::Duration;
+
+use serde_json::{Value, json};
+
+use crate::live_run::{
+    Desk, DeskOptions, FamilyResult, Found, Outcomes, Run, Spec, Stop, operator_step,
+};
+use crate::{Result, now_utc};
+
+const DISCOVERY: Spec = Spec {
+    id: "L17-discovery",
+    workflows: &["W47"],
+};
+const SIGN_IN: Spec = Spec {
+    id: "L17-sign-in",
+    workflows: &["W47"],
+};
+const SCOPE: Spec = Spec {
+    id: "L17-scope-change",
+    workflows: &["W48"],
+};
+const REVOKE: Spec = Spec {
+    id: "L17-revocation",
+    workflows: &["W48"],
+};
+const APPROVED: Spec = Spec {
+    id: "L17-approved-read-call",
+    workflows: &["W48"],
+};
+const DENIED: Spec = Spec {
+    id: "L17-denied-call",
+    workflows: &["W48"],
+};
+const REFRESH: Spec = Spec {
+    id: "L17-refresh",
+    workflows: &["W48"],
+};
+
+fn view(j: &Value) -> Value {
+    j["harness"]["mcp"].clone()
+}
+
+fn server<'a>(v: &'a Value, id: &str) -> &'a Value {
+    v["servers"]
+        .as_array()
+        .and_then(|s| s.iter().find(|s| s["id"] == id))
+        .unwrap_or(&Value::Null)
+}
+
+async fn list(desk: &mut Desk, reference: &str) -> Result<Value> {
+    let context = desk.context_text()?;
+    desk.send_json(json!({"kind": "listMcpServers", "context": context, "workspace": reference}))
+        .await?;
+    Ok(desk
+        .until(desk.settle, |j| view(j)["state"] != "loading")
+        .await
+        .map(|j| view(&j))
+        .unwrap_or_default())
+}
+
+struct Ctx<'r, 'a> {
+    run: &'r mut Run<'a>,
+    outcomes: Outcomes,
+    stop: Option<Stop>,
+}
+
+impl Ctx<'_, '_> {
+    fn settle(
+        &mut self,
+        spec: Spec,
+        started: String,
+        inputs: BTreeMap<String, Value>,
+        found: Found,
+    ) -> Result<()> {
+        let stop = self.run.settle(
+            "L17",
+            spec,
+            started,
+            inputs,
+            found,
+            None,
+            &mut self.outcomes,
+        )?;
+        if self.stop.is_none() {
+            self.stop = stop;
+        }
+        Ok(())
+    }
+
+    fn block(&mut self, specs: &[Spec], reason: &str) -> Result<()> {
+        for spec in specs {
+            self.settle(*spec, now_utc(), BTreeMap::new(), Found::blocked(reason))?;
+        }
+        Ok(())
+    }
+}
+
+pub(crate) async fn run(run: &mut Run<'_>, _id: &str) -> Result<FamilyResult> {
+    let mut ctx = Ctx {
+        run,
+        outcomes: Vec::new(),
+        stop: None,
+    };
+    let remote = [DISCOVERY, SIGN_IN, SCOPE, REVOKE];
+    for spec in [APPROVED, DENIED, REFRESH] {
+        let found = Found::native(
+            "MCP tool calls, their native approval or denial, and token refresh run inside the \
+             Harness engine, which only the desktop app launches; run this with the native \
+             acceptance driver against the designated server",
+        );
+        ctx.settle(spec, now_utc(), BTreeMap::new(), found)?;
+    }
+    let designated_server = ctx.run.nonsecret("L17", "mcp_server_id");
+    let server_name = ctx.run.nonsecret("L17", "mcp_server_name");
+    let (Some(workspace), true, Some(endpoint)) = (
+        ctx.run.nonsecret("L17", "workspace_id"),
+        designated_server.is_some() || server_name.is_some(),
+        ctx.run.nonsecret("L17", "inference_endpoint"),
+    ) else {
+        ctx.block(
+            &remote,
+            "L17 needs workspace_id, mcp_server_id (or mcp_server_name) and inference_endpoint",
+        )?;
+        return Ok(FamilyResult {
+            outcomes: ctx.outcomes,
+            stop: None,
+        });
+    };
+    let mut desk = match ctx
+        .run
+        .management_desk("L17", DeskOptions::default())
+        .await?
+    {
+        Ok(d) => d,
+        Err(e) => {
+            ctx.block(&remote, &e)?;
+            return Ok(FamilyResult {
+                outcomes: ctx.outcomes,
+                stop: None,
+            });
+        }
+    };
+    let reference = match desk.select_workspace(&workspace).await {
+        Ok(r) => r,
+        Err(e) => {
+            ctx.block(&remote, &e.to_string())?;
+            return Ok(FamilyResult {
+                outcomes: ctx.outcomes,
+                stop: None,
+            });
+        }
+    };
+    let Some(key) = ctx.run.secret("L17", "inference_key")? else {
+        ctx.block(&remote, "L17 designates no inference_key credential")?;
+        return Ok(FamilyResult {
+            outcomes: ctx.outcomes,
+            stop: None,
+        });
+    };
+    let context = desk.context_text()?;
+    desk.send_json(
+        json!({"kind": "configureInferenceCredential", "context": context,
+        "mode": "session", "workspace": reference, "endpoint": endpoint, "secret": (*key).clone()}),
+    )
+    .await?;
+    let _ = desk
+        .until(desk.settle, |j| {
+            j["tenants"]
+                .as_array()
+                .is_some_and(|t| t.iter().any(|t| t["inference"]["state"] == "ready"))
+        })
+        .await;
+    let mut inputs = ctx.run.inputs("L17", &["client_secret", "inference_key"]);
+    inputs.insert("endpoint".to_owned(), json!(endpoint));
+
+    let started = now_utc();
+    let v = list(&mut desk, &reference).await?;
+    // The designated server, or the one catalog server whose name contains
+    // `mcp_server_name` (case-insensitive); more than one match is refused.
+    let (server_id, discovered) = match designated_server {
+        Some(id) => (id, None),
+        None => {
+            let needle = server_name.clone().unwrap_or_default().to_lowercase();
+            let matches: Vec<&Value> = v["servers"]
+                .as_array()
+                .map(|s| {
+                    s.iter()
+                        .filter(|s| {
+                            s["name"]
+                                .as_str()
+                                .is_some_and(|n| n.to_lowercase().contains(&needle))
+                        })
+                        .collect()
+                })
+                .unwrap_or_default();
+            match matches.as_slice() {
+                [only] => (
+                    only["id"].as_str().unwrap_or_default().to_owned(),
+                    Some(json!({"by": "mcp_server_name", "name": only["name"]})),
+                ),
+                other => {
+                    let names: Vec<Value> = v["servers"]
+                        .as_array()
+                        .map(|s| s.iter().map(|s| s["name"].clone()).collect())
+                        .unwrap_or_default();
+                    (
+                        String::new(),
+                        Some(json!({"by": "mcp_server_name", "matches": other.len(),
+                            "catalog_names": names})),
+                    )
+                }
+            }
+        }
+    };
+    let listed = !server_id.is_empty() && !server(&v, &server_id).is_null();
+    let mut found = Found::check(
+        v["state"] == "ready" && listed,
+        "the workspace's MCP catalog was read and lists the designated server (its upstream URL is never kept)",
+        "the catalog was not read or does not list exactly one designated server",
+    )
+    .with("state", v["state"].clone())
+    .with("servers", json!(v["servers"].as_array().map(Vec::len)));
+    if let Some(d) = discovered {
+        found = found.with("discovered", d);
+    }
+    if !server_id.is_empty() {
+        found = found.id("mcp_server_id", &server_id);
+    }
+    ctx.settle(DISCOVERY, started, inputs.clone(), found)?;
+    if !listed {
+        ctx.block(
+            &[SIGN_IN, SCOPE, REVOKE],
+            "the designated server is not in the catalog",
+        )?;
+        return Ok(FamilyResult {
+            outcomes: ctx.outcomes,
+            stop: ctx.stop,
+        });
+    }
+    // `operator_present = no`: the browser and console steps wait for a run
+    // with the operator; they are recorded blocked, never attempted.
+    if ctx.run.nonsecret("L17", "operator_present").as_deref() == Some("no") {
+        ctx.block(
+            &[SIGN_IN, SCOPE, REVOKE],
+            "the operator was not present for the sign-in; run L17 again with the operator",
+        )?;
+        return Ok(FamilyResult {
+            outcomes: ctx.outcomes,
+            stop: ctx.stop,
+        });
+    }
+
+    let started = now_utc();
+    let context = desk.context_text()?;
+    desk.send_json(
+        json!({"kind": "signInMcpServer", "context": context, "workspace": reference,
+        "server": server_id}),
+    )
+    .await?;
+    let bound = ctx.run.operator_timeout("L17");
+    let (done, step) = {
+        let desk = &desk;
+        let id = server_id.clone();
+        operator_step(
+            ctx.run.operator.as_ref(),
+            "mcp-sign-in",
+            "authorize the desktop for the designated MCP server with the designated test identity",
+            None,
+            bound,
+            async || {
+                desk.json()
+                    .map(|j| server(&view(&j), &id)["signedIn"] == true)
+                    .unwrap_or(false)
+            },
+        )
+        .await
+    };
+    let mut found = Found::check(
+        done,
+        "the operator authorized the server; the desktop exchanged its own code and holds the grant (memory and v2 Keychain only)",
+        "the MCP sign-in was not completed within the bound",
+    );
+    found.operator_step = Some(step);
+    ctx.settle(SIGN_IN, started, inputs.clone(), found)?;
+    if !done {
+        ctx.block(&[SCOPE, REVOKE], "the server was not signed in")?;
+        return Ok(FamilyResult {
+            outcomes: ctx.outcomes,
+            stop: ctx.stop,
+        });
+    }
+
+    let started = now_utc();
+    let found = if ctx.run.nonsecret("L17", "scope_change").as_deref() != Some("designated") {
+        Found::blocked("L17 designates no scope_change the operator can make")
+    } else {
+        let bound = ctx.run.operator_timeout("L17");
+        let (done, step) = {
+            let desk = &mut desk;
+            let id = server_id.clone();
+            let reference = reference.clone();
+            operator_step(
+                ctx.run.operator.as_ref(),
+                "mcp-scope-change",
+                "change the designated MCP server's scope or grant in the Gateway now",
+                None,
+                bound,
+                async || {
+                    tokio::time::sleep(Duration::from_secs(2)).await;
+                    match list(desk, &reference).await {
+                        Ok(v) => {
+                            let s = server(&v, &id);
+                            s["stale"] == true || s["signedIn"] == false
+                        }
+                        Err(_) => false,
+                    }
+                },
+            )
+            .await
+        };
+        let mut found = Found::check(
+            done,
+            "after the operator's change, the catalog showed the sign-in stale and it no longer counted",
+            "the changed scope or grant was not noticed",
+        );
+        found.operator_step = Some(step);
+        found
+    };
+    ctx.settle(SCOPE, started, inputs.clone(), found)?;
+
+    let started = now_utc();
+    let context = desk.context_text()?;
+    desk.send_json(
+        json!({"kind": "signOutMcpServer", "context": context, "workspace": reference,
+        "server": server_id}),
+    )
+    .await?;
+    let out = desk
+        .until(desk.settle, |j| {
+            server(&view(j), &server_id)["signedIn"] == false
+        })
+        .await
+        .is_some();
+    let mut found = Found::check(
+        out,
+        "signed out: the desktop revoked the tokens and deleted their item",
+        "the sign-out did not take effect",
+    );
+    found.cleanup = "the grant was revoked".to_owned();
+    ctx.settle(REVOKE, started, inputs, found)?;
+    Ok(FamilyResult {
+        outcomes: ctx.outcomes,
+        stop: ctx.stop,
+    })
+}
diff --git a/crates/xtask/src/live_reads.rs b/crates/xtask/src/live_reads.rs
new file mode 100644
index 00000000..a7564c2e
--- /dev/null
+++ b/crates/xtask/src/live_reads.rs
@@ -0,0 +1,1235 @@
+//! Read-only families (C25) through the production `management` intent:
+//! L02 management identity and inventories, L05 sessions, L06 Red Team and
+//! Model/skill observations, L07 Gateway reads and L10 operational
+//! observation. Each family signs in with its own designated management
+//! OAuth client (session-only); receipts record result shapes and sanitized
+//! identifiers, never item content.
+
+use std::collections::BTreeMap;
+
+use desktop_core::management::{DetailFound, ManagementFailure, ManagementResult};
+use serde_json::{Value, json};
+
+use crate::live_run::{DeskOptions, FamilyResult, Found, Outcomes, Run, Spec, summarize};
+use crate::{Result, now_utc};
+
+const INVENTORIES: [&str; 10] = [
+    "profiles",
+    "topics",
+    "applications",
+    "apiKeys",
+    "deploymentProfiles",
+    "dlpCatalog",
+    "dataProfiles",
+    "dataPatterns",
+    "filteringProfiles",
+    "dictionaries",
+];
+
+const GATEWAY_SCOPED: [&str; 5] = [
+    "providers",
+    "routes",
+    "guardrails",
+    "serviceKeys",
+    "userKeys",
+];
+
+fn page_items(result: &ManagementResult) -> Vec<Value> {
+    match result {
+        ManagementResult::Page { page } => serde_json::from_str(&page.items).unwrap_or_default(),
+        _ => Vec::new(),
+    }
+}
+
+fn id_of(item: &Value, field: &str) -> Option<String> {
+    item.get(field).and_then(|v| match v {
+        Value::String(s) => Some(s.clone()),
+        Value::Number(n) => Some(n.to_string()),
+        _ => None,
+    })
+}
+
+fn ok(result: &ManagementResult) -> bool {
+    !matches!(result, ManagementResult::Failed { .. })
+}
+
+fn denied(result: &ManagementResult) -> bool {
+    matches!(
+        result,
+        ManagementResult::Failed {
+            failure: ManagementFailure::Denied,
+            ..
+        }
+    )
+}
+
+/// Runs `reads` on the desk and records one check from their summaries;
+/// passes when every read succeeded.
+async fn reads(
+    desk: &mut crate::live_run::Desk,
+    requests: Vec<(String, Value)>,
+) -> Result<(bool, Vec<(String, ManagementResult)>, Value)> {
+    let mut all = true;
+    let mut results = Vec::new();
+    let mut shown = serde_json::Map::new();
+    for (label, request) in requests {
+        let result = desk.read(request).await?;
+        all &= ok(&result);
+        shown.insert(label.clone(), summarize(&result));
+        results.push((label, result));
+    }
+    Ok((all, results, Value::Object(shown)))
+}
+
+struct Ctx<'r, 'a> {
+    run: &'r mut Run<'a>,
+    id: String,
+    outcomes: Outcomes,
+    stop: Option<crate::live_run::Stop>,
+}
+
+impl Ctx<'_, '_> {
+    fn record(
+        &mut self,
+        spec: Spec,
+        started: String,
+        inputs: BTreeMap<String, Value>,
+        found: Found,
+    ) -> Result<()> {
+        let stop = self.run.settle(
+            &self.id,
+            spec,
+            started,
+            inputs,
+            found,
+            None,
+            &mut self.outcomes,
+        )?;
+        if self.stop.is_none() {
+            self.stop = stop;
+        }
+        Ok(())
+    }
+
+    fn block_all(&mut self, specs: &[Spec], reason: &str) -> Result<()> {
+        for spec in specs {
+            self.record(*spec, now_utc(), BTreeMap::new(), Found::blocked(reason))?;
+        }
+        Ok(())
+    }
+}
+
+pub(crate) async fn run(run: &mut Run<'_>, id: &str) -> Result<FamilyResult> {
+    let mut ctx = Ctx {
+        run,
+        id: id.to_owned(),
+        outcomes: Vec::new(),
+        stop: None,
+    };
+    match id {
+        "L02" => l02(&mut ctx).await?,
+        "L05" => l05(&mut ctx).await?,
+        "L06" => l06(&mut ctx).await?,
+        "L07" => l07(&mut ctx).await?,
+        _ => l10(&mut ctx).await?,
+    }
+    Ok(FamilyResult {
+        outcomes: ctx.outcomes,
+        stop: ctx.stop,
+    })
+}
+
+const L02_VERIFY: Spec = Spec {
+    id: "L02-verify",
+    workflows: &["W02"],
+};
+const L02_INVENTORIES: Spec = Spec {
+    id: "L02-inventories",
+    workflows: &["W07", "W08", "W09", "W10", "W12"],
+};
+const L02_PAGINATION: Spec = Spec {
+    id: "L02-pagination",
+    workflows: &["W07"],
+};
+const L02_DETAIL: Spec = Spec {
+    id: "L02-detail",
+    workflows: &["W07"],
+};
+const L02_DENIED: Spec = Spec {
+    id: "L02-least-privilege-denied",
+    workflows: &["W02"],
+};
+
+async fn l02(ctx: &mut Ctx<'_, '_>) -> Result<()> {
+    let all = [L02_VERIFY, L02_INVENTORIES, L02_PAGINATION, L02_DETAIL];
+    let inputs = ctx.run.inputs("L02", &["client_secret"]);
+    let mut desk = match ctx
+        .run
+        .management_desk("L02", DeskOptions::default())
+        .await?
+    {
+        Ok(d) => d,
+        Err(e) => {
+            ctx.block_all(&all, &e)?;
+            ctx.block_all(&[L02_DENIED], &e)?;
+            return Ok(());
+        }
+    };
+    let started = now_utc();
+    let verify = desk.read(json!({"kind": "verify"})).await?;
+    let found = Found::check(
+        matches!(verify, ManagementResult::Verified),
+        "the management client was granted a token and read one profile",
+        "the management client could not be verified",
+    )
+    .with("verify", summarize(&verify))
+    .with("scan_key_used", json!(false));
+    ctx.record(L02_VERIFY, started, inputs.clone(), found)?;
+
+    let started = now_utc();
+    let requests = INVENTORIES
+        .iter()
+        .map(|r| {
+            (
+                (*r).to_owned(),
+                json!({"kind": "page", "resource": r, "offset": 0, "limit": 25}),
+            )
+        })
+        .collect();
+    let (all_ok, results, shown) = reads(&mut desk, requests).await?;
+    let found = Found::check(
+        all_ok,
+        "every supported Runtime and DLP inventory returned a page",
+        "an inventory could not be read",
+    )
+    .with("pages", shown);
+    ctx.record(L02_INVENTORIES, started, inputs.clone(), found)?;
+
+    let started = now_utc();
+    let first = desk
+        .read(json!({"kind": "page", "resource": "profiles", "offset": 0, "limit": 1}))
+        .await?;
+    let found = match &first {
+        ManagementResult::Page { page } => match page.next_offset {
+            Some(next) => {
+                let second = desk
+                    .read(
+                        json!({"kind": "page", "resource": "profiles", "offset": next, "limit": 1}),
+                    )
+                    .await?;
+                let a = page_items(&first)
+                    .first()
+                    .and_then(|i| id_of(i, "profile_id"));
+                let b = page_items(&second)
+                    .first()
+                    .and_then(|i| id_of(i, "profile_id"));
+                Found::check(
+                    ok(&second) && a.is_some() && a != b,
+                    "the second page continued where the first ended",
+                    "the second page did not advance",
+                )
+                .with("first", summarize(&first))
+                .with("second", summarize(&second))
+            }
+            None => Found::blocked(
+                "the profile inventory has a single page; pagination needs at least two profiles",
+            )
+            .with("first", summarize(&first)),
+        },
+        _ => Found::failed("the first profile page could not be read")
+            .with("first", summarize(&first)),
+    };
+    ctx.record(L02_PAGINATION, started, inputs.clone(), found)?;
+
+    let started = now_utc();
+    let target = results
+        .iter()
+        .find(|(r, _)| r == "profiles")
+        .and_then(|(_, res)| page_items(res).first().and_then(|i| id_of(i, "profile_id")));
+    let found = match target {
+        Some(target) => {
+            let detail = desk
+                .read(json!({"kind": "detail", "resource": "profiles", "id": target}))
+                .await?;
+            Found::check(
+                matches!(&detail, ManagementResult::Detail { detail } if detail.found == DetailFound::Found),
+                "the profile was found by its bounded inventory walk",
+                "the profile detail could not be read",
+            )
+            .with("detail", summarize(&detail))
+            .id("profile_id", &target)
+        }
+        None => Found::blocked("no profile is listed to read in detail"),
+    };
+    ctx.record(L02_DETAIL, started, inputs, found)?;
+    drop(desk);
+
+    // A designated, more restricted principal must be refused: a read of
+    // `restricted_denied_resource` when one is designated, otherwise a
+    // write (a read-only principal reads, so only its write can be denied).
+    match ctx.run.nonsecret("L02", "restricted_denied_resource") {
+        Some(resource) => l02_read_denied(ctx, &resource).await,
+        None => l02_write_denied(ctx).await,
+    }
+}
+
+async fn l02_read_denied(ctx: &mut Ctx<'_, '_>, resource: &str) -> Result<()> {
+    let started = now_utc();
+    let mut inputs = ctx.run.inputs("L02", &["restricted_client_secret"]);
+    inputs.insert("mode".to_owned(), json!("read"));
+    let found = match ctx
+        .run
+        .management_desk_as(
+            "L02",
+            "restricted_client_id",
+            "restricted_client_secret",
+            DeskOptions::default(),
+        )
+        .await?
+    {
+        Err(e) => Found::blocked(e),
+        Ok(mut desk) => {
+            let read = desk
+                .read(json!({"kind": "page", "resource": resource, "offset": 0, "limit": 1}))
+                .await?;
+            if ok(&read) {
+                Found::failed("unexpected authority: the restricted principal read the inventory")
+                    .with("read", summarize(&read))
+                    .stopping("unexpected authority", false)
+            } else {
+                Found::check(
+                    denied(&read),
+                    "the service denied the restricted principal; nothing was shown",
+                    "the read failed, but not as a permission denial",
+                )
+                .with("read", summarize(&read))
+            }
+        }
+    };
+    ctx.record(L02_DENIED, started, inputs, found)
+}
+
+/// A change failure that is the service refusing the principal.
+fn permission_denied(failure: &Value) -> bool {
+    failure["kind"] == "service"
+        && matches!(failure["failure"].as_str(), Some("denied" | "unauthorized"))
+}
+
+/// The topic named `name`, found by a bounded walk of the topic inventory:
+/// its ID when present, `Ok(None)` when the whole inventory was read
+/// without it, `Err` when the walk could not finish.
+async fn find_topic(
+    desk: &mut crate::live_run::Desk,
+    name: &str,
+) -> Result<std::result::Result<Option<String>, String>> {
+    let mut offset = 0u32;
+    for _ in 0..20 {
+        let page = desk
+            .read(json!({"kind": "page", "resource": "topics", "offset": offset, "limit": 50}))
+            .await?;
+        let ManagementResult::Page { page: listed } = &page else {
+            return Ok(Err("the topic inventory could not be read".to_owned()));
+        };
+        let items = page_items(&page);
+        if let Some(item) = items.iter().find(|t| t["topic_name"] == name) {
+            return Ok(Ok(id_of(item, "topic_id").or_else(|| Some(String::new()))));
+        }
+        match listed.next_offset {
+            Some(next) if !listed.complete && next > offset => offset = next,
+            _ if listed.complete || items.is_empty() => return Ok(Ok(None)),
+            _ => return Ok(Err("the topic inventory did not advance".to_owned())),
+        }
+    }
+    Ok(Err(
+        "the topic inventory is longer than the bounded walk".to_owned()
+    ))
+}
+
+/// The restricted principal attempts a reviewed create of a disposable
+/// topic through the production change path; the service must refuse it.
+/// The full principal then reads the topics back and deletes the topic if
+/// it exists after all, which stops the run as unexpected authority.
+async fn l02_write_denied(ctx: &mut Ctx<'_, '_>) -> Result<()> {
+    let started = now_utc();
+    let mut inputs = ctx.run.inputs("L02", &["restricted_client_secret"]);
+    inputs.insert("mode".to_owned(), json!("write"));
+    let Some(prefix) = ctx.run.prefix("L02").filter(|p| !p.is_empty()) else {
+        let found = Found::blocked(
+            "a write denial needs L02's disposable_prefix (or designate restricted_denied_resource for a read denial)",
+        );
+        return ctx.record(L02_DENIED, started, inputs, found);
+    };
+    let name = format!("{prefix}lp-{}", crate::random_hex(4)?);
+    if let Err(e) = crate::live_run::disposable(Some(&prefix), &name) {
+        return ctx.record(L02_DENIED, started, inputs, Found::blocked(e));
+    }
+    let body = json!({"topic_name": name, "description": "C25 least-privilege probe",
+        "examples": ["c25 synthetic example"]});
+    inputs.insert("kind".to_owned(), json!("topics"));
+    inputs.insert("action".to_owned(), json!("create"));
+    inputs.insert("body".to_owned(), body.clone());
+    let mut restricted = match ctx
+        .run
+        .management_desk_as(
+            "L02",
+            "restricted_client_id",
+            "restricted_client_secret",
+            DeskOptions::default(),
+        )
+        .await?
+    {
+        Ok(d) => d,
+        Err(e) => return ctx.record(L02_DENIED, started, inputs, Found::blocked(e)),
+    };
+    let draft = json!({"kind": "topics", "action": "create", "target": "",
+        "body": body.to_string()});
+    let applied = crate::live_changes::apply(&mut restricted, &draft).await?;
+    drop(restricted);
+    let (refused, outcome, failure) = match &applied {
+        crate::live_changes::Applied::Review(failure) => (
+            permission_denied(failure),
+            "review".to_owned(),
+            failure.clone(),
+        ),
+        crate::live_changes::Applied::Settled { result, .. } => (
+            result["outcome"] == "rejected" && permission_denied(&result["failure"]),
+            result["outcome"].as_str().unwrap_or("unknown").to_owned(),
+            result["failure"].clone(),
+        ),
+    };
+
+    // The full principal reads back whether the topic exists.
+    let mut full = match ctx
+        .run
+        .management_desk("L02", DeskOptions::default())
+        .await?
+    {
+        Ok(d) => d,
+        Err(e) => {
+            let found = Found::failed(format!(
+                "the full principal could not read back the probe topic: {e}"
+            ))
+            .with("outcome", json!(outcome))
+            .with("failure", failure)
+            .stopping("the probe's effect is not verified", true);
+            return ctx.record(L02_DENIED, started, inputs, found);
+        }
+    };
+    let mut found = match find_topic(&mut full, &name).await? {
+        Err(e) => Found::failed(format!("the probe's readback did not finish: {e}"))
+            .stopping("the probe's effect is not verified", true),
+        Ok(None) if refused => {
+            let mut f = Found::passed(
+                "the service refused the restricted principal's write; the full principal read the topics back and none was created",
+            );
+            f.readback = "absent".to_owned();
+            f
+        }
+        Ok(None) if outcome == "unknown" => {
+            let mut f = Found::failed(
+                "the restricted write's outcome is unknown; no topic was read back, so it is not shown to be refused",
+            )
+            .stopping("an uncertain outcome", true);
+            f.readback = "absent".to_owned();
+            f
+        }
+        Ok(None) => {
+            let mut f =
+                Found::failed("the write was not applied, but not refused as a permission denial");
+            f.readback = "absent".to_owned();
+            f
+        }
+        Ok(Some(id)) => {
+            // It exists: the restricted principal has write authority.
+            let mut cleanup =
+                "the probe topic exists but has no ID to delete; reconcile it".to_owned();
+            let mut reconcile = true;
+            if !id.is_empty() {
+                let delete = json!({"kind": "topics", "action": "delete", "target": id,
+                    "body": "{}"});
+                if let crate::live_changes::Applied::Settled { result, .. } =
+                    crate::live_changes::apply(&mut full, &delete).await?
+                    && result["outcome"] == "completed"
+                    && result["readback"] == "absent"
+                {
+                    cleanup = "deleted by the full principal and read back as absent".to_owned();
+                    reconcile = false;
+                } else {
+                    cleanup = "the full principal's delete did not settle as absent; reconcile it"
+                        .to_owned();
+                }
+            }
+            let mut f = Found::failed(
+                "unexpected authority: the restricted principal's write created the topic",
+            )
+            .id("created_id", &id)
+            .stopping("unexpected authority", reconcile);
+            f.readback = "found".to_owned();
+            f.cleanup = cleanup;
+            f
+        }
+    };
+    found = found
+        .with("outcome", json!(outcome))
+        .with("failure", failure)
+        .with("probe_name", json!(name));
+    if found.cleanup == "nothing created" {
+        found.cleanup = "nothing was created; the full principal read the topics back".to_owned();
+    }
+    drop(full);
+    ctx.record(L02_DENIED, started, inputs, found)
+}
+
+const L05_INVENTORY: Spec = Spec {
+    id: "L05-inventory",
+    workflows: &["W17"],
+};
+const L05_SESSION: Spec = Spec {
+    id: "L05-session-detail",
+    workflows: &["W17"],
+};
+const L05_SEARCH: Spec = Spec {
+    id: "L05-search",
+    workflows: &["W18"],
+};
+const L05_CONTENT: Spec = Spec {
+    id: "L05-content-reveal",
+    workflows: &["W19"],
+};
+
+async fn l05(ctx: &mut Ctx<'_, '_>) -> Result<()> {
+    let all = [L05_INVENTORY, L05_SESSION, L05_SEARCH, L05_CONTENT];
+    let inputs = ctx.run.inputs("L05", &["client_secret"]);
+    let mut desk = match ctx
+        .run
+        .management_desk("L05", DeskOptions::default())
+        .await?
+    {
+        Ok(d) => d,
+        Err(e) => return ctx.block_all(&all, &e),
+    };
+    let started = now_utc();
+    let page = desk
+        .read(json!({"kind": "page", "resource": "sessions", "offset": 0, "limit": 25}))
+        .await?;
+    let found = Found::check(
+        ok(&page),
+        "the 24-hour sessions inventory returned a page with its completeness",
+        "the sessions inventory could not be read",
+    )
+    .with("page", summarize(&page));
+    ctx.record(L05_INVENTORY, started, inputs.clone(), found)?;
+
+    // Only a synthetic session is opened (never another customer's
+    // content): the designated one, or else the newest session of the app
+    // name L01's synthetic scans carry.
+    let designated = (
+        ctx.run.nonsecret("L05", "session_id"),
+        ctx.run.nonsecret("L05", "session_app_id"),
+        ctx.run.nonsecret("L05", "session_app_name"),
+    );
+    let (session, app_id, app_name, discovered) = match designated {
+        (Some(session), Some(app_id), Some(app_name)) => (session, app_id, app_name, None),
+        _ => match discover_session(ctx, &mut desk).await? {
+            Ok((session, app_id, app_name, how)) => (session, app_id, app_name, Some(how)),
+            Err(reason) => {
+                return ctx.block_all(&[L05_SESSION, L05_SEARCH, L05_CONTENT], &reason);
+            }
+        },
+    };
+    let started = now_utc();
+    let detail = desk
+        .read(
+            json!({"kind": "session", "sessionId": session, "appId": app_id, "appName": app_name}),
+        )
+        .await?;
+    let which = if discovered.is_some() {
+        "discovered synthetic"
+    } else {
+        "designated"
+    };
+    let mut found = Found::check(
+        matches!(detail, ManagementResult::Session { .. }),
+        format!("the {which} session's actions were read"),
+        format!("the {which} session could not be read"),
+    )
+    .with("session", summarize(&detail))
+    .id("session_id", &session);
+    if let Some(how) = &discovered {
+        found = found.with("discovered", how.clone());
+    }
+    // The scan to open: the designated one, except that a discovered
+    // session uses one of its own scans when the designated one is not in
+    // it.
+    let actions: Vec<String> = match &detail {
+        ManagementResult::Session { session } => serde_json::from_str::<Value>(&session.session)
+            .ok()
+            .and_then(|v| v["session_actions"].as_array().cloned())
+            .unwrap_or_default()
+            .iter()
+            .filter_map(|a| id_of(a, "scan_id"))
+            .collect(),
+        _ => Vec::new(),
+    };
+    let designated_scan = ctx.run.nonsecret("L05", "scan_id");
+    let scan_target = match (&discovered, designated_scan) {
+        (None, scan) => scan,
+        (Some(_), Some(scan)) if actions.contains(&scan) => Some(scan),
+        (Some(_), _) => actions.first().cloned(),
+    };
+    if let Some(scan) = scan_target.clone() {
+        let tx = desk
+            .read(
+                json!({"kind": "transaction", "sessionId": session, "appId": app_id,
+                "appName": app_name, "scanId": scan, "subRequest": 0}),
+            )
+            .await?;
+        if !matches!(tx, ManagementResult::Transaction { .. }) {
+            found = Found::failed("the designated transaction's metadata could not be read")
+                .id("session_id", &session);
+        }
+        found = found
+            .with("transaction", summarize(&tx))
+            .id("scan_id", &scan);
+    }
+    ctx.record(L05_SESSION, started, inputs.clone(), found)?;
+
+    // The app searches by scan ID (a UUID), by a `ses…` session ID or by
+    // detector name (v1); AIRS session IDs are the caller's trace IDs, so
+    // the session's own scan is the query.
+    let started = now_utc();
+    let found = match scan_target.clone() {
+        None => Found::blocked("the session lists no scan to search for"),
+        Some(scan) => match desk.read(json!({"kind": "search", "query": scan})).await {
+            Err(e) => Found::failed(format!("the search was refused: {e}")).id("scan_id", &scan),
+            Ok(search) => Found::check(
+                matches!(search, ManagementResult::Search { .. }),
+                "the bounded search by the session's scan ID completed and states its completeness",
+                "the search failed",
+            )
+            .with("search", summarize(&search))
+            .id("scan_id", &scan),
+        },
+    };
+    ctx.record(L05_SEARCH, started, inputs.clone(), found)?;
+
+    let started = now_utc();
+    let found = match (
+        scan_target,
+        ctx.run.nonsecret("L05", "reveal_content").as_deref(),
+    ) {
+        (Some(scan), Some("synthetic")) => {
+            let content = desk
+                .read(json!({"kind": "content", "scanId": scan, "subRequest": 0}))
+                .await?;
+            let lengths = match &content {
+                ManagementResult::Content { content } => serde_json::to_value(content)
+                    .ok()
+                    .map(|v| {
+                        json!({
+                            "prompt_chars": v["prompt"].as_str().map(str::len),
+                            "response_chars": v["response"].as_str().map(str::len),
+                        })
+                    })
+                    .unwrap_or(Value::Null),
+                _ => Value::Null,
+            };
+            Found::check(
+                matches!(content, ManagementResult::Content { .. }),
+                "the synthetic scan's content was revealed on explicit request (only its length is recorded)",
+                "the content could not be revealed",
+            )
+            .with("content", summarize(&content))
+            .with("lengths", lengths)
+        }
+        _ => Found::blocked(
+            "content is revealed only for a synthetic scan when reveal_content = synthetic",
+        ),
+    };
+    ctx.record(L05_CONTENT, started, inputs, found)?;
+    Ok(())
+}
+
+/// The timestamp fields a session row may carry, most telling first.
+const SESSION_TIMES: [&str; 7] = [
+    "last_seen",
+    "last_updated",
+    "updated_at",
+    "end_time",
+    "start_time",
+    "created_at",
+    "timestamp",
+];
+
+/// Pages of the sessions inventory walked to find a synthetic session.
+const SESSION_PAGES: u32 = 8;
+
+/// The newest session whose application name is the one L01's synthetic
+/// scans carry: its session ID, application ID and name, and how it was
+/// chosen. Sessions of any other application are never chosen.
+async fn discover_session(
+    ctx: &mut Ctx<'_, '_>,
+    desk: &mut crate::live_run::Desk,
+) -> Result<std::result::Result<(String, String, String, Value), String>> {
+    let Some(app) = ctx.run.nonsecret("L01", "app_name") else {
+        return Ok(Err(
+            "L05 designates no synthetic session, and L01 names no app_name to discover one by"
+                .to_owned(),
+        ));
+    };
+    let mut matches = Vec::new();
+    let mut offset = 0u32;
+    let mut walked = 0u32;
+    while walked < SESSION_PAGES {
+        walked += 1;
+        let page = desk
+            .read(json!({"kind": "page", "resource": "sessions", "offset": offset, "limit": 50}))
+            .await?;
+        let ManagementResult::Page { page: listed } = &page else {
+            return Ok(Err("the sessions inventory could not be walked".to_owned()));
+        };
+        let items = page_items(&page);
+        matches.extend(
+            items
+                .iter()
+                .filter(|s| s["application_name"] == app.as_str())
+                .cloned(),
+        );
+        match listed.next_offset {
+            Some(next) if !listed.complete && next > offset && !items.is_empty() => offset = next,
+            _ => break,
+        }
+    }
+    if matches.is_empty() {
+        return Ok(Err(format!(
+            "L05 designates no synthetic session and none of application {app} is in the last 24 hours ({walked} page(s) walked)"
+        )));
+    }
+    let field = SESSION_TIMES
+        .iter()
+        .find(|f| matches.iter().all(|m| m[**f].is_string()));
+    let chosen = match field {
+        Some(f) => matches
+            .iter()
+            .max_by(|a, b| a[*f].as_str().cmp(&b[*f].as_str()))
+            .cloned(),
+        None => matches.first().cloned(),
+    }
+    .unwrap_or(Value::Null);
+    let (Some(session), Some(app_id)) = (
+        id_of(&chosen, "session_id"),
+        id_of(&chosen, "application_id").or_else(|| id_of(&chosen, "app_id")),
+    ) else {
+        return Ok(Err(format!(
+            "the newest session of application {app} names no session or application ID"
+        )));
+    };
+    let how = json!({
+        "by": "app_name",
+        "app_name": app,
+        "candidates": matches.len(),
+        "chosen_by": field.map_or("first in the service's order".to_owned(), |f| format!("newest {f}")),
+    });
+    Ok(Ok((session, app_id, app, how)))
+}
