+//! The controlled live runner (C25): drives each designated family's checks
+//! through the production application core (`desktop_core::Core`, its
+//! authority intents, the app-owned transport and the published SDK), never
+//! a parallel client, and writes one redacted receipt per check.
+//!
+//! The runner refuses a manifest `live::check` rejects and every blocked
+//! family. A secret is resolved only when its check needs it, held in
+//! memory (zeroized on drop) and never logged or written: a receipt that
+//! would contain one is refused. Budgets are charged before each request
+//! and a request over its cap is never sent. An unexpected tenant,
+//! authority or cost, or an outcome that may or may not have taken effect,
+//! stops the run at once; the stopping receipt says it needs reconciliation.
+//! A browser step (device, company or MCP sign-in) or an access change is
+//! the operator's: the runner prompts, then waits a bounded time for the
+//! core to show the result, and records the step.
+//!
+//! A run against a local fake service is recorded as `fixture` evidence,
+//! never as live evidence.
+
+use std::collections::BTreeMap;
+use std::path::{Path, PathBuf};
+use std::sync::Arc;
+use std::time::Duration;
+
+use desktop_core::context::ContextRef;
+use desktop_core::management::{ManagementEndpoints, ManagementResult};
+use desktop_core::tenants::{Destination, Region};
+use desktop_core::transport::{ProxyMode, TransportPolicy};
+use desktop_core::{
+    AuthorityHandle, Core, CoreConfig, Delivery, Intent, Observation, Receipt, ShellSnapshot,
+    ViewScope,
+};
+use serde::{Deserialize, Serialize};
+use serde_json::{Value, json};
+use zeroize::Zeroizing;
+
+use crate::live::{self, Family, LiveManifest, SecretRef};
+use crate::live_adapters::{Confirmations, Host, Operator, TerminalOperator};
+use crate::{Repo, Result, Subject, invalid, io_err, now_utc, random_hex, write_json};
+
+pub const RECEIPT_SCHEMA: &str = "airs-v2/live-receipt/1";
+pub const RUN_SCHEMA: &str = "airs-v2/live-run/1";
+
+/// Families whose checks need the native desktop app rather than xtask.
+pub const NATIVE_ONLY: [&str; 1] = ["L16"];
+
+/// How long the operator has for a browser step or an access change unless
+/// the family sets `operator_timeout_secs`.
+const OPERATOR_TIMEOUT: Duration = Duration::from_secs(300);
+
+/// What kind of evidence a run produces.
+#[derive(Clone, Debug)]
+pub enum Evidence {
+    /// The designated services, with the production transport policy.
+    Live,
+    /// Local fake services; its receipts are `fixture` and never close a
+    /// live requirement.
+    Fixture(FixtureTargets),
+}
+
+/// Where a fixture run's services are (a live run never overrides these).
+#[derive(Clone, Debug, Default)]
+pub struct FixtureTargets {
+    /// Trusted roots (PEM) for the fake services' certificates.
+    pub extra_roots: Vec<Vec<u8>>,
+    /// The management, DLP, Red Team and Gateway planes, all at one origin.
+    pub management: Option<String>,
+    /// The Academy origin (otherwise a family's `academy_origin`).
+    pub academy: Option<String>,
+    /// How long a fixture run waits for anything (default 10 s).
+    pub settle: Option<Duration>,
+}
+
+impl Evidence {
+    pub fn fixture(extra_roots: Vec<Vec<u8>>) -> Self {
+        Evidence::Fixture(FixtureTargets {
+            extra_roots,
+            ..FixtureTargets::default()
+        })
+    }
+
+    pub(crate) fn class(&self) -> &'static str {
+        match self {
+            Evidence::Live => "live",
+            Evidence::Fixture(_) => "fixture",
+        }
+    }
+
+    fn settle(&self) -> Duration {
+        match self {
+            Evidence::Live => Duration::from_secs(90),
+            Evidence::Fixture(f) => f.settle.unwrap_or(Duration::from_secs(10)),
+        }
+    }
+}
+
+/// Resolves a secret reference at the moment of use.
+pub trait Resolve: Send + Sync {
+    fn resolve(&self, reference: &SecretRef) -> Result<Zeroizing<String>>;
+}
+
+/// The macOS Keychain (through `security`, value to memory only) or an
+/// owner-only file.
+pub struct SystemResolver;
+
+impl Resolve for SystemResolver {
+    fn resolve(&self, reference: &SecretRef) -> Result<Zeroizing<String>> {
+        let bytes = match reference {
+            SecretRef::Keychain { service, account } => {
+                let out = std::process::Command::new("/usr/bin/security")
+                    .args(["find-generic-password", "-s", service, "-a", account, "-w"])
+                    .stdin(std::process::Stdio::null())
+                    .stderr(std::process::Stdio::null())
+                    .output()
+                    .map_err(|_| {
+                        invalid(format!("security could not run for {service}/{account}"))
+                    })?;
+                if !out.status.success() {
+                    return Err(invalid(format!(
+                        "no Keychain item {service}/{account} (or access was refused)"
+                    )));
+                }
+                Zeroizing::new(out.stdout)
+            }
+            SecretRef::File { path } => Zeroizing::new(
+                std::fs::read(path).map_err(|_| invalid(format!("cannot read {path}")))?,
+            ),
+        };
+        let text = std::str::from_utf8(&bytes)
+            .map_err(|_| invalid("a secret is not UTF-8"))?
+            .trim_end_matches(['\n', '\r']);
+        if text.is_empty() {
+            return Err(invalid("a secret reference resolved to nothing"));
+        }
+        Ok(Zeroizing::new(text.to_owned()))
+    }
+}
+
+/// Why the run stopped: further checks would not be safe.
+#[derive(Clone, Debug, PartialEq, Eq, Serialize, Deserialize)]
+pub struct Stop {
+    pub family: String,
+    pub check: String,
+    pub reason: String,
+    /// The outcome may or may not have taken effect; an operator must
+    /// reconcile it before anything else runs.
+    pub reconcile: bool,
+}
+
+/// The consumption ledger's schema.
+pub const CONSUMPTION_SCHEMA: &str = "airs-v2/live-consumption/1";
+
+/// The live consumption ledger beside the receipts: append-only and never
+/// reset, so a manifest's caps bound every run together. Fixture runs keep
+/// their own ledger and never charge this one.
+pub const LIVE_LEDGER: &str = "consumption.jsonl";
+pub const FIXTURE_LEDGER: &str = "consumption-fixture.jsonl";
+
+/// One line of the consumption ledger. `kind` is `spend` (charged before a
+/// request), `report` (consumption the service reported afterwards) or
+/// `note` (spend outside the runner, recorded by an operator).
+#[derive(Clone, Debug, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct Charge {
+    pub schema: String,
+    pub recorded_utc: String,
+    /// The run (its start time and a random suffix), or `operator-note`.
+    pub run: String,
+    pub manifest_sha256: String,
+    pub family: String,
+    pub budget: String,
+    pub n: u64,
+    pub kind: String,
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    pub reason: Option<String>,
+}
+
+/// Where a guard records what it charges.
+struct Ledger {
+    path: PathBuf,
+    run: String,
+    sha: String,
+}
+
+impl Ledger {
+    /// Appends one charge durably; nothing is charged if it cannot.
+    fn append(&self, family: &str, budget: &str, n: u64, kind: &str) -> Result<()> {
+        use std::io::Write;
+        let charge = Charge {
+            schema: CONSUMPTION_SCHEMA.to_owned(),
+            recorded_utc: now_utc(),
+            run: self.run.clone(),
+            manifest_sha256: self.sha.clone(),
+            family: family.to_owned(),
+            budget: budget.to_owned(),
+            n,
+            kind: kind.to_owned(),
+            reason: None,
+        };
+        let mut line = serde_json::to_vec(&charge).map_err(|e| invalid(e.to_string()))?;
+        line.push(b'\n');
+        if let Some(parent) = self.path.parent() {
+            std::fs::create_dir_all(parent).map_err(io_err(parent))?;
+        }
+        let mut file = std::fs::OpenOptions::new()
+            .create(true)
+            .append(true)
+            .open(&self.path)
+            .map_err(io_err(&self.path))?;
+        file.write_all(&line).map_err(io_err(&self.path))?;
+        file.sync_all().map_err(io_err(&self.path))
+    }
+}
+
+/// Every charge in a consumption ledger (none when it does not exist). A
+/// line that does not parse fails: spend that cannot be counted is never
+/// taken for none.
+pub fn read_charges(path: &Path) -> Result<Vec<Charge>> {
+    let text = match std::fs::read_to_string(path) {
+        Ok(text) => text,
+        Err(e) if e.kind() == std::io::ErrorKind::NotFound => return Ok(Vec::new()),
+        Err(e) => return Err(io_err(path)(e)),
+    };
+    text.lines()
+        .enumerate()
+        .filter(|(_, l)| !l.trim().is_empty())
+        .map(|(i, l)| {
+            let charge: Charge = serde_json::from_str(l)
+                .map_err(|e| invalid(format!("{} line {}: {e}", path.display(), i + 1)))?;
+            if charge.schema != CONSUMPTION_SCHEMA {
+                return Err(invalid(format!(
+                    "{} line {}: schema {}",
+                    path.display(),
+                    i + 1,
+                    charge.schema
+                )));
+            }
+            Ok(charge)
+        })
+        .collect()
+}
+
+/// Budget caps and disposable names, enforced before any request.
+#[derive(Default)]
+pub struct Guard {
+    /// (family, budget key) → (limit, spent in earlier runs, spent now).
+    spent: BTreeMap<(String, String), (u64, u64, u64)>,
+    ledger: Option<Ledger>,
+}
+
+impl Guard {
+    pub fn new(manifest: &LiveManifest) -> Self {
+        let mut spent = BTreeMap::new();
+        for (id, family) in &manifest.families {
+            for (key, limit) in &family.budget {
+                spent.insert((id.clone(), key.clone()), (*limit, 0, 0));
+            }
+        }
+        Self {
+            spent,
+            ledger: None,
+        }
+    }
+
+    /// A guard that counts every charge already in the ledger at `path`
+    /// against the caps and appends each new one there before it is
+    /// spent. Earlier spend counts whichever manifest version it was made
+    /// under: a revised scope does not refill a budget.
+    pub fn with_ledger(manifest: &LiveManifest, path: &Path, run: &str, sha: &str) -> Result<Self> {
+        let mut guard = Self::new(manifest);
+        for charge in read_charges(path)? {
+            if let Some((_, prior, _)) = guard.spent.get_mut(&(charge.family, charge.budget)) {
+                *prior = prior.saturating_add(charge.n);
+            }
+        }
+        guard.ledger = Some(Ledger {
+            path: path.to_path_buf(),
+            run: run.to_owned(),
+            sha: sha.to_owned(),
+        });
+        Ok(guard)
+    }
+
+    /// Charges `n` of `family`'s `key` budget, or refuses (nothing charged)
+    /// when that would exceed the cap across every run, the budget was
+    /// never set, or the charge cannot be recorded.
+    pub fn spend(&mut self, family: &str, key: &str, n: u64) -> std::result::Result<(), String> {
+        let Some((limit, prior, used)) = self.spent.get_mut(&(family.to_owned(), key.to_owned()))
+        else {
+            return Err(format!("{family} has no {key} budget"));
+        };
+        let total = prior.saturating_add(*used);
+        if total.saturating_add(n) > *limit {
+            return Err(format!(
+                "{family} {key} budget exhausted ({total} of {limit} used across runs; {n} more refused)"
+            ));
+        }
+        if let Some(ledger) = &self.ledger {
+            ledger
+                .append(family, key, n, "spend")
+                .map_err(|e| format!("{family} {key} charge could not be recorded: {e}"))?;
+        }
+        *used += n;
+        Ok(())
+    }
+
+    /// Records consumption the service reported after the fact (inference
+    /// tokens); refuses (but records) when it went over the cap.
+    pub fn report(&mut self, family: &str, key: &str, n: u64) -> std::result::Result<(), String> {
+        let Some((limit, prior, used)) = self.spent.get_mut(&(family.to_owned(), key.to_owned()))
+        else {
+            return Err(format!("{family} has no {key} budget"));
+        };
+        *used = used.saturating_add(n);
+        if let Some(ledger) = &self.ledger {
+            ledger
+                .append(family, key, n, "report")
+                .map_err(|e| format!("{family} {key} consumption could not be recorded: {e}"))?;
+        }
+        let total = prior.saturating_add(*used);
+        if total > *limit {
+            return Err(format!(
+                "{family} {key} over its cap ({total} of {limit} across runs)"
+            ));
+        }
+        Ok(())
+    }
+
+    /// Consumption across every run against each cap for `family`.
+    pub fn consumption(&self, family: &str) -> BTreeMap<String, Value> {
+        self.spent
+            .iter()
+            .filter(|((f, _), _)| f == family)
+            .map(|((_, k), (limit, prior, used))| {
+                (
+                    k.clone(),
+                    json!({"used": prior.saturating_add(*used), "limit": limit}),
+                )
+            })
+            .collect()
+    }
+}
+
+/// Whether `name` may be created for a family: only under its designated
+/// disposable prefix (a family without one creates nothing).
+pub fn disposable(prefix: Option<&str>, name: &str) -> std::result::Result<(), String> {
+    match prefix {
+        None => Err(format!(
+            "{name}: this family has no disposable prefix and creates nothing"
+        )),
+        Some("") => Err("an empty disposable prefix designates nothing".to_owned()),
+        Some(p) if name.starts_with(p) && name.len() > p.len() => Ok(()),
+        Some(p) => Err(format!("{name} is not under the disposable prefix {p}")),
+    }
+}
+
+/// A remote identifier as recorded: identifier characters only, bounded.
+pub fn sanitize_id(id: &str) -> String {
+    if !id.is_empty()
+        && id.len() <= 128
+        && id
+            .chars()
+            .all(|c| c.is_ascii_alphanumeric() || "._:-".contains(c))
+    {
+        id.to_owned()
+    } else {
+        "<unrecognized>".to_owned()
+    }
+}
+
+#[derive(Clone, Debug, Serialize, Deserialize)]
+pub struct CheckReceipt {
+    pub schema: String,
+    pub evidence: String,
+    pub family: String,
+    pub check: String,
+    pub workflows: Vec<String>,
+    pub environment: String,
+    pub manifest_sha256: String,
+    pub started_utc: String,
+    pub finished_utc: String,
+    /// The exact non-secret inputs; credentials appear by name only.
+    pub inputs: BTreeMap<String, Value>,
+    /// `passed`, `failed`, `blocked`, `needs-reconciliation` or
+    /// `native-app-required`.
+    pub outcome: String,
+    pub detail: String,
+    pub observed: BTreeMap<String, Value>,
+    /// Sanitized remote request/trace identifiers.
+    pub ids: BTreeMap<String, String>,
+    pub readback: String,
+    pub cleanup: String,
+    pub consumption: BTreeMap<String, Value>,
+    /// A step the operator completed (or did not) outside the runner.
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    pub operator_step: Option<Value>,
+    /// What produced the receipt: [`implementation`].
+    #[serde(default, skip_serializing_if = "BTreeMap::is_empty")]
+    pub implementation: BTreeMap<String, String>,
+}
+
+#[derive(Clone, Debug, Serialize, Deserialize)]
+pub struct FamilyRun {
+    pub id: String,
+    /// `passed`, `failed`, `stopped`, `blocked` or `needs-native-app`.
+    pub status: String,
+    pub checks: Vec<String>,
+}
+
+#[derive(Clone, Debug, Serialize, Deserialize)]
+pub struct RunRecord {
+    pub schema: String,
+    pub evidence: String,
+    pub manifest_sha256: String,
+    pub started_utc: String,
+    pub finished_utc: String,
+    pub families: Vec<FamilyRun>,
+    pub stopped: Option<Stop>,
+    /// What produced the run: [`implementation`].
+    #[serde(default, skip_serializing_if = "BTreeMap::is_empty")]
+    pub implementation: BTreeMap<String, String>,
+}
+
+/// The implementation a run executed: the repository's source fingerprint
+/// (every source file, evidence and reviews excluded), the resolved
+/// dependency lockfile and the runner binary itself. A live run refuses to
+/// start without them; a fixture run outside a repository marks the source
+/// unavailable.
+pub(crate) fn implementation(repo: &Repo, live: bool) -> Result<BTreeMap<String, String>> {
+    let mut out = BTreeMap::new();
+    match crate::fingerprint::source(repo) {
+        Ok(source) => {
+            out.insert("source_fingerprint".to_owned(), source);
+        }
+        Err(e) if live => return Err(invalid(format!("the source fingerprint: {e}"))),
+        Err(_) => {
+            out.insert("source_fingerprint".to_owned(), "unavailable".to_owned());
+        }
+    }
+    let lock = repo.join("Cargo.lock");
+    match std::fs::read(&lock) {
+        Ok(bytes) => {
+            out.insert("cargo_lock_sha256".to_owned(), crate::sha256_hex(&bytes));
+        }
+        Err(e) if live => return Err(invalid(format!("Cargo.lock: {e}"))),
+        Err(_) => {}
+    }
+    let exe = std::env::current_exe().map_err(|e| invalid(format!("the runner binary: {e}")))?;
+    let bytes = std::fs::read(&exe).map_err(io_err(&exe))?;
+    out.insert("runner_sha256".to_owned(), crate::sha256_hex(&bytes));
+    Ok(out)
+}
+
+impl RunRecord {
+    pub fn passed(&self) -> bool {
+        self.stopped.is_none() && self.families.iter().all(|f| f.status == "passed")
+    }
+}
+
+/// What a check found, before it becomes a receipt.
+pub(crate) struct Found {
+    pub outcome: &'static str,
+    pub detail: String,
+    pub observed: BTreeMap<String, Value>,
+    pub ids: BTreeMap<String, String>,
+    pub stop: Option<(String, bool)>,
+    pub readback: String,
+    pub cleanup: String,
+    pub operator_step: Option<Value>,
+}
+
+impl Found {
+    pub fn new(outcome: &'static str, detail: impl Into<String>) -> Self {
+        Self {
+            outcome,
+            detail: detail.into(),
+            observed: BTreeMap::new(),
+            ids: BTreeMap::new(),
+            stop: None,
+            readback: "not applicable: the check creates no remote resource".to_owned(),
+            cleanup: "nothing created".to_owned(),
+            operator_step: None,
+        }
+    }
+
+    pub fn passed(detail: impl Into<String>) -> Self {
+        Self::new("passed", detail)
+    }
+
+    pub fn failed(detail: impl Into<String>) -> Self {
+        Self::new("failed", detail)
+    }
+
+    pub fn blocked(detail: impl Into<String>) -> Self {
+        Self::new("blocked", detail)
+    }
+
+    pub fn native(detail: impl Into<String>) -> Self {
+        Self::new("native-app-required", detail)
+    }
+
+    pub fn check(ok: bool, passed: impl Into<String>, failed: impl Into<String>) -> Self {
+        if ok {
+            Self::passed(passed)
+        } else {
+            Self::failed(failed)
+        }
+    }
+
+    pub fn stopping(mut self, reason: impl Into<String>, reconcile: bool) -> Self {
+        self.stop = Some((reason.into(), reconcile));
+        if reconcile {
+            self.outcome = "needs-reconciliation";
+        }
+        self
+    }
+
+    pub fn with(mut self, key: &str, value: Value) -> Self {
+        self.observed.insert(key.to_owned(), value);
+        self
+    }
+
+    pub fn id(mut self, key: &str, value: &str) -> Self {
+        self.ids.insert(key.to_owned(), sanitize_id(value));
+        self
+    }
+}
+
+/// A check's identity and the workflow rows it evidences.
+#[derive(Clone, Copy)]
+pub(crate) struct Spec {
+    pub id: &'static str,
+    pub workflows: &'static [&'static str],
+}
+
+pub(crate) type Outcomes = Vec<(String, String)>;
+
+/// What one family produced.
+pub(crate) struct FamilyResult {
+    pub outcomes: Outcomes,
+    pub stop: Option<Stop>,
+}
+
+/// Options for one desk (a production core with this run's host).
+#[derive(Clone, Default)]
+pub(crate) struct DeskOptions {
+    /// API Client requests may go to the network (production hosts).
+    pub workbench_live: bool,
+    pub folder: Option<PathBuf>,
+    pub offline_root: Option<PathBuf>,
+    pub workbench_root: Option<PathBuf>,
+    pub save_dir: Option<PathBuf>,
+    pub image: Option<Vec<u8>>,
+    pub academy_origin: Option<String>,
+}
+
+/// A production core with in-memory OS adapters.
+pub(crate) struct Desk {
+    core: Core,
+    handle: AuthorityHandle,
+    session: String,
+    sequence: u64,
+    pub settle: Duration,
+    pub confirmations: Arc<Confirmations>,
+}
+
+impl Desk {
+    pub async fn send(&mut self, intent: Intent) -> Result<Receipt> {
+        self.sequence += 1;
+        self.handle
+            .dispatch(
+                Delivery {
+                    session: self.session.clone(),
+                    sequence: self.sequence,
+                },
+                intent,
+            )
+            .await
+            .map_err(|r| invalid(format!("refused: {r}")))
+    }
+
+    /// Sends an intent written as JSON (the presentation's wire form). The
+    /// JSON is consumed, so a secret in it moves into the intent.
+    pub async fn send_json(&mut self, intent: Value) -> Result<Receipt> {
+        let intent: Intent =
+            serde_json::from_value(intent).map_err(|e| invalid(format!("intent: {e}")))?;
+        self.send(intent).await
+    }
+
+    /// Sends and returns the admitted operation.
+    pub async fn admit(&mut self, intent: Value) -> Result<desktop_core::runtime::OperationId> {
+        match self.send_json(intent).await? {
+            Receipt::Admitted {
+                operation: Some(operation),
+                ..
+            } => Ok(operation),
+            Receipt::Admitted { .. } => Err(invalid("admitted without an operation")),
+        }
+    }
+
+    pub fn snap(&self) -> Result<ShellSnapshot> {
+        match self.handle.observe(ViewScope::Shell) {
+            Ok(Observation::Shell { snapshot, .. }) => Ok(snapshot),
+            _ => Err(invalid("the shell snapshot is unavailable")),
+        }
+    }
+
+    pub fn json(&self) -> Result<Value> {
+        serde_json::to_value(self.snap()?).map_err(|e| invalid(format!("snapshot: {e}")))
+    }
+
+    pub fn context(&self) -> Result<ContextRef> {
+        self.snap()?
+            .active
+            .map(|a| a.context)
+            .ok_or_else(|| invalid("no active tenant"))
+    }
+
+    pub fn context_text(&self) -> Result<String> {
+        Ok(self.context()?.as_str().to_owned())
+    }
+
+    /// Waits up to the desk's bound for `ready`.
+    pub async fn wait(&self, ready: impl FnMut(&ShellSnapshot) -> bool) -> Result<ShellSnapshot> {
+        self.wait_for(self.settle, ready).await
+    }
+
+    pub async fn wait_for(
+        &self,
+        bound: Duration,
+        mut ready: impl FnMut(&ShellSnapshot) -> bool,
+    ) -> Result<ShellSnapshot> {
+        let deadline = tokio::time::Instant::now() + bound;
+        loop {
+            let snap = self.snap()?;
+            if ready(&snap) {
+                return Ok(snap);
+            }
+            if tokio::time::Instant::now() >= deadline {
+                return Err(invalid("timed out waiting for the core"));
+            }
+            tokio::time::sleep(Duration::from_millis(25)).await;
+        }
+    }
+
+    /// Like [`Desk::wait`] over the snapshot's JSON (no error on timeout).
+    pub async fn until(
+        &self,
+        bound: Duration,
+        mut ready: impl FnMut(&Value) -> bool,
+    ) -> Option<Value> {
+        let deadline = tokio::time::Instant::now() + bound;
+        loop {
+            if let Ok(json) = self.json()
+                && ready(&json)
+            {
+                return Some(json);
+            }
+            if tokio::time::Instant::now() >= deadline {
+                return None;
+            }
+            tokio::time::sleep(Duration::from_millis(25)).await;
+        }
+    }
+
+    /// Creates and selects a tenant (no credential).
+    pub async fn tenant(
+        &mut self,
+        label: &str,
+        tsg: Option<&str>,
+        destination: &Destination,
+    ) -> Result<()> {
+        let before = self.snap()?.tenants.len();
+        self.send_json(json!({"kind": "createTenant", "profile": {
+            "label": label, "tsgId": tsg, "destination": destination}}))
+            .await?;
+        let snap = self.wait(|s| s.tenants.len() > before).await?;
+        let id = snap
+            .tenants
+            .iter()
+            .find(|t| t.label == label)
+            .map(|t| t.id.clone())
+            .ok_or_else(|| invalid("the created tenant is not listed"))?;
+        self.send(Intent::SelectTenant { tenant: id.clone() })
+            .await?;
+        self.wait(|s| s.active.as_ref().is_some_and(|a| a.tenant == id))
+            .await?;
+        Ok(())
+    }
+
+    fn active_tenant(&self, snap: &ShellSnapshot) -> Option<desktop_core::TenantView> {
+        let active = snap.active.as_ref()?;
+        snap.tenants.iter().find(|t| t.id == active.tenant).cloned()
+    }
+
+    /// The active tenant's scan key, for this session only.
+    pub async fn scan_key(&mut self, key: &Zeroizing<String>) -> Result<()> {
+        let context = self.context_text()?;
+        self.send_json(
+            json!({"kind": "configureScanCredential", "context": context,
+            "mode": "session", "key": (**key).clone()}),
+        )
+        .await?;
+        self.wait(|s| {
+            self.active_tenant(s)
+                .is_some_and(|t| t.scan.state == desktop_core::ScanState::Ready)
+        })
+        .await?;
+        Ok(())
+    }
+
+    /// The active tenant's management OAuth client, for this session only.
+    pub async fn management_key(
+        &mut self,
+        client_id: &str,
+        secret: &Zeroizing<String>,
+    ) -> Result<()> {
+        let context = self.context_text()?;
+        self.send_json(
+            json!({"kind": "configureManagementCredential", "context": context,
+            "mode": "session", "clientId": client_id, "secret": (**secret).clone()}),
+        )
+        .await?;
+        self.wait(|s| {
+            self.active_tenant(s)
+                .is_some_and(|t| t.management.state == desktop_core::ScanState::Ready)
+        })
+        .await?;
+        Ok(())
+    }
+
+    /// Whether the active tenant has a management capability.
+    pub fn management_configured(&self) -> Result<bool> {
+        let snap = self.snap()?;
+        Ok(self
+            .active_tenant(&snap)
+            .is_some_and(|t| t.management.state != desktop_core::ScanState::Missing))
+    }
+
+    /// One management read (verify, page, detail, sessions, Red Team,
+    /// Gateway…) through the `management` intent, and its single result.
+    pub async fn read(&mut self, request: Value) -> Result<ManagementResult> {
+        let context = self.context_text()?;
+        let operation = self
+            .admit(json!({"kind": "management", "context": context, "request": request}))
+            .await?;
+        let Ok(Observation::Management(handle)) =
+            self.handle.observe(ViewScope::Management(operation))
+        else {
+            return Err(invalid("the management result cannot be observed"));
+        };
+        tokio::time::timeout(self.settle, handle.result())
+            .await
+            .map_err(|_| invalid("the management read did not settle in time"))
+    }
+
+    /// One API Client request through the `workbench` intent, and its
+    /// result (as JSON).
+    pub async fn workbench(&mut self, request: Value) -> Result<Value> {
+        let operation = self
+            .admit(json!({"kind": "workbench", "request": request}))
+            .await?;
+        let Ok(Observation::Workbench(handle)) =
+            self.handle.observe(ViewScope::Workbench(operation))
+        else {
+            return Err(invalid("the API Client result cannot be observed"));
+        };
+        let result = tokio::time::timeout(self.settle, handle.result())
+            .await
+            .map_err(|_| invalid("the API Client request did not settle in time"))?;
+        serde_json::to_value(result).map_err(|e| invalid(format!("result: {e}")))
+    }
+
+    /// One learner call through the `academyCall` intent family, and its
+    /// result (as JSON).
+    pub async fn academy(&mut self, intent: Value) -> Result<Value> {
+        let operation = self.admit(intent).await?;
+        let Ok(Observation::AcademyCall(handle)) =
+            self.handle.observe(ViewScope::AcademyCall(operation))
+        else {
+            return Err(invalid("the learner call cannot be observed"));
+        };
+        let result = tokio::time::timeout(self.settle, handle.result())
+            .await
+            .map_err(|_| invalid("the learner call did not settle in time"))?;
+        serde_json::to_value(result).map_err(|e| invalid(format!("result: {e}")))
+    }
+
+    /// The selected Gateway workspace's native reference, if any.
+    pub fn workspace_ref(&self) -> Option<String> {
+        self.json().ok()?["gateway"]["selected"]["reference"]
+            .as_str()
+            .map(str::to_owned)
+    }
+
+    /// Lists the Gateway workspaces and selects `workspace`; returns its
+    /// reference.
+    pub async fn select_workspace(&mut self, workspace: &str) -> Result<String> {
+        let listed = self
+            .read(json!({"kind": "gateway", "workspace": null,
+                "read": {"kind": "inventory", "resource": "workspaces"}}))
+            .await?;
+        if let ManagementResult::Failed { failure, .. } = listed {
+            return Err(invalid(format!(
+                "the workspaces could not be listed: {failure:?}"
+            )));
+        }
+        let context = self.context_text()?;
+        self.send_json(json!({"kind": "selectGatewayWorkspace", "context": context,
+            "workspace": workspace}))
+            .await?;
+        let found = self
+            .until(self.settle, |j| {
+                j["gateway"]["selected"]["workspace"]["id"].as_str() == Some(workspace)
+            })
+            .await;
+        found
+            .and_then(|j| {
+                j["gateway"]["selected"]["reference"]
+                    .as_str()
+                    .map(str::to_owned)
+            })
+            .ok_or_else(|| invalid(format!("workspace {workspace} could not be selected")))
+    }
+}
+
+impl Drop for Desk {
+    fn drop(&mut self) {
+        self.core.shutdown();
+    }
+}
+
+/// One run's state.
+pub(crate) struct Run<'a> {
+    pub repo: &'a Repo,
+    pub manifest: &'a LiveManifest,
+    pub sha: &'a str,
+    pub evidence: &'a Evidence,
+    resolver: &'a dyn Resolve,
+    pub operator: Arc<dyn Operator>,
+    pub guard: Guard,
+    secrets: Vec<Zeroizing<String>>,
+    /// Run-owned folders (collections, offline work), removed at the end.
+    pub scratch: PathBuf,
+    /// What this run executes ([`implementation`]), in every receipt.
+    pub implementation: BTreeMap<String, String>,
+}
+
+impl Run<'_> {
+    pub fn family(&self, id: &str) -> Result<&Family> {
+        self.manifest
+            .families
+            .get(id)
+            .ok_or_else(|| invalid(format!("{id} is missing from the manifest")))
+    }
+
+    pub fn designated(&self, id: &str) -> bool {
+        self.manifest
+            .families
+            .get(id)
+            .is_some_and(|f| f.status == "designated")
+    }
+
+    pub fn nonsecret(&self, family: &str, key: &str) -> Option<String> {
+        self.manifest
+            .families
+            .get(family)?
+            .nonsecret
+            .get(key)
+            .cloned()
+    }
+
+    pub fn prefix(&self, family: &str) -> Option<String> {
+        self.manifest
+            .families
+            .get(family)?
+            .disposable_prefix
+            .clone()
+    }
+
+    /// Resolves a credential now; `None` when the family names none.
+    pub fn secret(&mut self, family: &str, name: &str) -> Result<Option<Zeroizing<String>>> {
+        let Some(reference) = self.family(family)?.credentials.get(name).cloned() else {
+            return Ok(None);
+        };
+        let value = self.resolver.resolve(&reference)?;
+        self.secrets.push(value.clone());
+        Ok(Some(value))
+    }
+
+    pub fn operator_timeout(&self, family: &str) -> Duration {
+        let bound = self
+            .nonsecret(family, "operator_timeout_secs")
+            .and_then(|s| s.parse::<u64>().ok())
+            .map(Duration::from_secs)
+            .unwrap_or(OPERATOR_TIMEOUT);
+        match self.evidence {
+            Evidence::Live => bound,
+            Evidence::Fixture(f) => f.settle.unwrap_or(Duration::from_secs(10)).min(bound),
+        }
+    }
+
+    /// A fresh production core for one family.
+    pub fn desk(&self, options: DeskOptions) -> Result<Desk> {
+        let mut config = CoreConfig::default();
+        if options.workbench_live && matches!(self.evidence, Evidence::Live) {
+            config.workbench_network = desktop_core::workbench::admission::Network::Live;
+        }
+        if let Some(origin) = &options.academy_origin {
+            config.academy_origin = origin.clone();
+        }
+        if let Evidence::Fixture(f) = self.evidence {
+            if let Some(origin) = &f.management {
+                config.management = ManagementEndpoints::at_origin(origin);
+            }
+            if let Some(origin) = &f.academy {
+                config.academy_origin = origin.clone();
+            }
+        }
+        let confirmations = Arc::new(Confirmations::default());
+        let host = Host {
+            operator: Arc::clone(&self.operator),
+            confirmations: Arc::clone(&confirmations),
+            folder: options.folder,
+            offline_root: options.offline_root,
+            workbench_root: options.workbench_root,
+            save_dir: options.save_dir,
+            image: options.image,
+        };
+        let core = Core::new(config, crate::live_adapters::adapters(&host));
+        core.start();
+        if let Evidence::Fixture(f) = self.evidence {
+            core.set_transport_policy(TransportPolicy {
+                revision: 2,
+                proxy: ProxyMode::Direct,
+                extra_roots: f.extra_roots.clone(),
+            })
+            .map_err(|e| invalid(format!("transport policy: {e}")))?;
+        }
+        let handle = core.operator();
+        let session = handle
+            .register_delivery_session()
+            .map_err(|e| invalid(format!("delivery session: {e:?}")))?
+            .nonce;
+        Ok(Desk {
+            core,
+            handle,
+            session,
+            sequence: 0,
+            settle: self.evidence.settle(),
+            confirmations,
+        })
+    }
+
+    /// A new run-owned folder.
+    pub fn folder(&self, name: &str) -> Result<PathBuf> {
+        let dir = self.scratch.join(format!("{name}-{}", random_hex(4)?));
+        std::fs::create_dir_all(&dir).map_err(crate::io_err(&dir))?;
+        dir.canonicalize().map_err(crate::io_err(&dir))
+    }
+
+    /// The family's tenant destination: `region` or `origin` (US region by
+    /// default for families that only manage, never scan).
+    pub fn destination(&self, family: &str) -> std::result::Result<Destination, String> {
+        let f = self
+            .manifest
+            .families
+            .get(family)
+            .ok_or_else(|| format!("{family} is missing"))?;
+        destination(f, true)
+    }
+
+    /// Writes the receipt, refusing one that contains any resolved secret.
+    pub fn record(
+        &self,
+        family: &str,
+        spec: Spec,
+        started: String,
+        inputs: BTreeMap<String, Value>,
+        found: &Found,
+        budget: Option<&str>,
+    ) -> Result<()> {
+        let receipt = CheckReceipt {
+            schema: RECEIPT_SCHEMA.to_owned(),
+            evidence: self.evidence.class().to_owned(),
+            family: family.to_owned(),
+            check: spec.id.to_owned(),
+            workflows: spec.workflows.iter().map(|w| (*w).to_owned()).collect(),
+            environment: self.family(family)?.environment.clone(),
+            manifest_sha256: self.sha.to_owned(),
+            started_utc: started,
+            finished_utc: now_utc(),
+            inputs,
+            outcome: found.outcome.to_owned(),
+            detail: found.detail.clone(),
+            observed: found.observed.clone(),
+            ids: found.ids.clone(),
+            readback: found.readback.clone(),
+            cleanup: found.cleanup.clone(),
+            // The caps this check was charged against (L18 may share L01's).
+            consumption: self.guard.consumption(budget.unwrap_or(family)),
+            operator_step: found.operator_step.clone(),
+            implementation: self.implementation.clone(),
+        };
+        let bytes =
+            serde_json::to_vec_pretty(&receipt).map_err(|e| invalid(format!("receipt: {e}")))?;
+        let text = String::from_utf8_lossy(&bytes);
+        if self
+            .secrets
+            .iter()
+            .any(|s| s.len() >= 4 && text.contains(s.as_str()))
+        {
+            return Err(invalid(format!(
+                "{family}/{}: the receipt would contain a secret; nothing was written",
+                spec.id
+            )));
+        }
+        write_json(
+            &self
+                .repo
+                .evidence_dir(Subject::Chunk(25))
+                .join("live")
+                .join(family)
+                .join(format!("{}.json", spec.id)),
+            &receipt,
+        )
+    }
+
+    /// Records `found` and folds it into `outcomes`; returns whether the run
+    /// must stop.
+    #[allow(clippy::too_many_arguments)]
+    pub fn settle(
+        &self,
+        family: &str,
+        spec: Spec,
+        started: String,
+        inputs: BTreeMap<String, Value>,
+        found: Found,
+        budget: Option<&str>,
+        outcomes: &mut Outcomes,
+    ) -> Result<Option<Stop>> {
+        self.record(family, spec, started, inputs, &found, budget)?;
+        outcomes.push((spec.id.to_owned(), found.outcome.to_owned()));
+        Ok(found.stop.map(|(reason, reconcile)| Stop {
+            family: family.to_owned(),
+            check: spec.id.to_owned(),
+            reason,
+            reconcile,
+        }))
+    }
+
+    /// The family's non-secret inputs, with the named credentials (by name).
+    pub fn inputs(&self, family: &str, credentials: &[&str]) -> BTreeMap<String, Value> {
+        let mut inputs: BTreeMap<String, Value> = self
+            .manifest
+            .families
+            .get(family)
+            .map(|f| {
+                f.nonsecret
+                    .iter()
+                    .map(|(k, v)| (k.clone(), Value::String(v.clone())))
+                    .collect()
+            })
+            .unwrap_or_default();
+        if !credentials.is_empty() {
+            inputs.insert(
+                "credentials".to_owned(),
+                json!(
+                    credentials
+                        .iter()
+                        .map(|c| format!("{family}.{c}"))
+                        .collect::<Vec<_>>()
+                ),
+            );
+        }
+        inputs.insert("storage".to_owned(), json!("session"));
+        inputs
+    }
+
+    /// Opens a desk with the family's tenant and management client; on a
+    /// missing input, a blocked reason.
+    pub async fn management_desk(
+        &mut self,
+        family: &str,
+        options: DeskOptions,
+    ) -> Result<std::result::Result<Desk, String>> {
+        self.management_desk_as(family, "client_id", "client_secret", options)
+            .await
+    }
+
+    /// As [`Run::management_desk`] with another principal's names.
+    pub async fn management_desk_as(
+        &mut self,
+        family: &str,
+        id_key: &str,
+        secret_key: &str,
+        options: DeskOptions,
+    ) -> Result<std::result::Result<Desk, String>> {
+        let Some(client_id) = self.nonsecret(family, id_key) else {
+            return Ok(Err(format!("{family} names no {id_key}")));
+        };
+        let Some(tsg) = self.nonsecret(family, "tsg_id") else {
+            return Ok(Err(format!("{family} names no tsg_id")));
+        };
+        let destination = match self.destination(family) {
+            Ok(d) => d,
+            Err(e) => return Ok(Err(e)),
+        };
+        let Some(secret) = self.secret(family, secret_key)? else {
+            return Ok(Err(format!(
+                "{family} designates no {secret_key} credential"
+            )));
+        };
+        let mut desk = self.desk(options)?;
+        desk.tenant(&format!("C25 {family}"), Some(&tsg), &destination)
+            .await?;
+        desk.management_key(&client_id, &secret).await?;
+        Ok(Ok(desk))
+    }
+}
+
+pub(crate) fn destination(
+    family: &Family,
+    default_us: bool,
+) -> std::result::Result<Destination, String> {
+    match (
+        family.nonsecret.get("region"),
+        family.nonsecret.get("origin"),
+    ) {
+        (Some(r), None) => Ok(Destination::Region {
+            region: match r.as_str() {
+                "us" => Region::UnitedStates,
+                "eu" => Region::Europe,
+                "in" => Region::India,
+                "sg" => Region::Singapore,
+                other => return Err(format!("unknown region {other}")),
+            },
+        }),
+        (None, Some(o)) => Destination::Custom { origin: o.clone() }
+            .validate()
+            .ok_or_else(|| format!("{o} is not an HTTPS origin")),
+        (None, None) if default_us => Ok(Destination::Region {
+            region: Region::UnitedStates,
+        }),
+        _ => Err("exactly one of region or origin is required".to_owned()),
+    }
+}
+
+/// Waits for an operator step: prompts, then polls `done` (the core's own
+/// state) until it holds or the bound passes. The result says what the
+/// operator was asked and how long it took; the runner never completes it.
+pub(crate) async fn operator_step(
+    operator: &dyn Operator,
+    kind: &str,
+    instruction: &str,
+    url: Option<&url::Url>,
+    bound: Duration,
+    mut done: impl AsyncFnMut() -> bool,
+) -> (bool, Value) {
+    let prompted = now_utc();
+    operator.prompt(instruction, url);
+    let start = tokio::time::Instant::now();
+    let mut completed = false;
+    while start.elapsed() < bound {
+        if done().await {
+            completed = true;
+            break;
+        }
+        tokio::time::sleep(Duration::from_millis(100)).await;
+    }
+    (
+        completed,
+        json!({"kind": kind, "instruction": instruction, "prompted_utc": prompted,
+               "completed": completed, "finished_utc": now_utc(),
+               "bound_secs": bound.as_secs(),
+               "judged_by": "the core's own state; the runner never supplies the result"}),
+    )
+}
+
+/// A management result as recorded: its kind and shape, never item content.
+pub(crate) fn summarize(result: &ManagementResult) -> Value {
+    match result {
+        ManagementResult::Verified => json!({"result": "verified"}),
+        ManagementResult::Page { page } => json!({"result": "page",
+            "resource": page.resource, "offset": page.offset, "limit": page.limit,
+            "count": page.count, "next_offset": page.next_offset,
+            "complete": page.complete, "total": page.total}),
+        ManagementResult::Failed { failure, outcome } => {
+            json!({"result": "failed", "failure": failure, "outcome": outcome})
+        }
+        ManagementResult::Gateway {
+            gateway: desktop_core::gateway::GatewayResult::List { list },
+        } => json!({"result": "gatewayList", "resource": list.resource, "count": list.count,
+            "total": list.total, "complete": list.complete}),
+        other => {
+            let kind = serde_json::to_value(other)
+                .ok()
+                .and_then(|v| v.get("kind").and_then(Value::as_str).map(str::to_owned))
+                .unwrap_or_else(|| "other".to_owned());
+            json!({"result": kind})
+        }
+    }
+}
+
+fn summary_status(id: &str, outcomes: &Outcomes, stop: &Option<Stop>) -> FamilyRun {
+    let status = if stop.as_ref().is_some_and(|s| s.family == id) {
+        "stopped"
+    } else if outcomes.iter().all(|(_, o)| o == "passed") && !outcomes.is_empty() {
+        "passed"
+    } else if outcomes.iter().any(|(_, o)| o == "failed") {
+        "failed"
+    } else if outcomes.iter().any(|(_, o)| o == "native-app-required")
+        && outcomes
+            .iter()
+            .all(|(_, o)| o == "passed" || o == "native-app-required")
+    {
+        "needs-native-app"
+    } else {
+        "blocked"
+    };
+    FamilyRun {
+        id: id.to_owned(),
+        status: status.to_owned(),
+        checks: outcomes.iter().map(|(c, o)| format!("{c}: {o}")).collect(),
+    }
+}
+
+/// Runs `families` (every designated family when empty) and writes
+/// `evidence/C25/live/run.json`. Refuses a manifest `live::check` rejects
+/// and any requested family that is blocked.
+pub async fn run(
+    repo: &Repo,
+    manifest: &LiveManifest,
+    sha: &str,
+    resolver: &dyn Resolve,
+    operator: Arc<dyn Operator>,
+    evidence: Evidence,
+    families: &[String],
+) -> Result<RunRecord> {
+    let failures = live::check(repo, manifest);
+    if !failures.is_empty() {
+        return Err(invalid(format!(
+            "the live manifest is not acceptable: {}",
+            failures.join("; ")
+        )));
+    }
+    let requested: Vec<String> = if families.is_empty() {
+        manifest
+            .families
+            .iter()
+            .filter(|(_, f)| f.status == "designated")
+            .map(|(id, _)| id.clone())
+            .collect()
+    } else {
+        families.to_vec()
+    };
+    for id in &requested {
+        match manifest.families.get(id) {
+            None => return Err(invalid(format!("{id} is not a live family"))),
+            Some(f) if f.status != "designated" => {
+                return Err(invalid(format!("{id} is blocked: {}", f.reason)));
+            }
+            Some(_) => {}
+        }
+    }
+    let implementation = implementation(repo, matches!(evidence, Evidence::Live))?;
+    let started = now_utc();
+    let scratch = std::env::temp_dir()
+        .canonicalize()
+        .map_err(|e| invalid(format!("temporary directory: {e}")))?
+        .join(format!("airs-v2-live-{}", random_hex(6)?));
+    let mut run = Run {
+        repo,
+        manifest,
+        sha,
+        evidence: &evidence,
+        resolver,
+        operator,
+        guard: Guard::with_ledger(
+            manifest,
+            &repo
+                .evidence_dir(Subject::Chunk(25))
+                .join("live")
+                .join(match &evidence {
+                    Evidence::Live => LIVE_LEDGER,
+                    Evidence::Fixture(_) => FIXTURE_LEDGER,
+                }),
+            // Runs may start within the same second.
+            &format!("{started}/{}", random_hex(4)?),
+            sha,
+        )?,
+        secrets: Vec::new(),
+        scratch,
+        implementation: implementation.clone(),
+    };
+    let run_implementation = implementation;
+    // Each requested family's earlier receipts move to live/history/ so a
+    // check this run does not reach never shows an older run's result.
+    let live_dir = repo.evidence_dir(Subject::Chunk(25)).join("live");
+    let history = live_dir.join("history").join(started.replace(':', ""));
+    for id in &requested {
+        let dir = live_dir.join(id);
+        let Ok(entries) = std::fs::read_dir(&dir) else {
+            continue;
+        };
+        for entry in entries.flatten() {
+            let path = entry.path();
+            if path.extension().and_then(|e| e.to_str()) == Some("json") {
+                let to = history.join(id);
+                std::fs::create_dir_all(&to).map_err(io_err(&to))?;
+                let target = to.join(entry.file_name());
+                std::fs::rename(&path, &target).map_err(io_err(&path))?;
+            }
+        }
+    }
+    let mut results = Vec::new();
+    let mut stopped: Option<Stop> = None;
+    // The Academy families share one learner sign-in.
+    let academy: Vec<String> = requested
+        .iter()
+        .filter(|id| crate::live_academy::FAMILIES.contains(&id.as_str()))
+        .cloned()
+        .collect();
+    let mut academy_done = false;
+    for id in &requested {
+        if stopped.is_some() {
+            results.push(FamilyRun {
+                id: id.clone(),
+                status: "blocked".to_owned(),
+                checks: vec!["not run: the run stopped".to_owned()],
+            });
+            continue;
+        }
+        let result = match id.as_str() {
+            "L01" | "L18" => crate::live_scan::run(&mut run, id).await?,
+            "L02" | "L05" | "L06" | "L07" | "L10" => crate::live_reads::run(&mut run, id).await?,
+            "L03" | "L04" | "L08" => crate::live_changes::run(&mut run, id).await?,
+            "L09" => crate::live_inference::run(&mut run, id).await?,
+            "L15" => crate::live_workbench::run(&mut run, id).await?,
+            "L16" => native_family(&mut run, id)?,
+            "L17" => crate::live_mcp::run(&mut run, id).await?,
+            _ if academy.contains(id) => {
+                if academy_done {
+                    continue;
+                }
+                academy_done = true;
+                let shared = crate::live_academy::run(&mut run, &academy).await?;
+                for (family, outcomes) in shared.families {
+                    results.push(summary_status(&family, &outcomes, &shared.stop));
+                }
+                stopped = shared.stop;
+                continue;
+            }
+            _ => return Err(invalid(format!("{id} has no runner"))),
+        };
+        results.push(summary_status(id, &result.outcomes, &result.stop));
+        stopped = result.stop;
+    }
+    let _ = std::fs::remove_dir_all(&run.scratch);
+    let record = RunRecord {
+        schema: RUN_SCHEMA.to_owned(),
+        evidence: evidence.class().to_owned(),
+        manifest_sha256: sha.to_owned(),
+        started_utc: started,
+        finished_utc: now_utc(),
+        families: results,
+        stopped,
+        implementation: run_implementation,
+    };
+    write_json(
+        &repo
+            .evidence_dir(Subject::Chunk(25))
+            .join("live")
+            .join("run.json"),
+        &record,
+    )?;
+    Ok(record)
+}
+
+/// L16: the native Harness engine runs only inside the desktop app.
+fn native_family(run: &mut Run<'_>, id: &str) -> Result<FamilyResult> {
+    const CHECKS: [Spec; 4] = [
+        Spec {
+            id: "L16-engine-conversation",
+            workflows: &["W42"],
+        },
+        Spec {
+            id: "L16-company-sign-in",
+            workflows: &["W43"],
+        },
+        Spec {
+            id: "L16-history-restart",
+            workflows: &["W44"],
+        },
+        Spec {
+            id: "L16-proposal-review",
+            workflows: &["W45"],
+        },
+    ];
+    let mut outcomes = Vec::new();
+    for spec in CHECKS {
+        let found = Found::native(
+            "the sealed Harness engine is launched only by the desktop host (its process-group \
+             launcher and bundled engine resource); protected disk, process and sandbox \
+             assertions need the signed app. Run this check with the native acceptance driver \
+             against the designated scope.",
+        );
+        run.settle(
+            id,
+            spec,
+            now_utc(),
+            run.inputs(id, &[]),
+            found,
+            None,
+            &mut outcomes,
+        )?;
+    }
+    Ok(FamilyResult {
+        outcomes,
+        stop: None,
+    })
+}
+
+/// `xtask live-run`: a live run against the designated services.
+pub fn main(repo: &Repo, scope: &std::path::Path, families: &[String]) -> Result<RunRecord> {
+    let (manifest, sha) = live::load(repo, scope)?;
+    let runtime = tokio::runtime::Builder::new_multi_thread()
+        .enable_all()
+        .build()
+        .map_err(|e| invalid(format!("runtime: {e}")))?;
+    runtime.block_on(run(
+        repo,
+        &manifest,
+        &sha,
+        &SystemResolver,
+        Arc::new(TerminalOperator),
+        Evidence::Live,
+        families,
+    ))
+}
diff --git a/crates/xtask/src/live_scan.rs b/crates/xtask/src/live_scan.rs
new file mode 100644
index 00000000..3cea398a
--- /dev/null
+++ b/crates/xtask/src/live_scan.rs
@@ -0,0 +1,366 @@
+//! L01 Runtime scan and L18 scope isolation (C25), through the `scan`
+//! intent of the production core with a session-only scan key.
+
+use std::collections::BTreeMap;
+
+use desktop_core::ScanRecordView;
+use desktop_core::runtime::Outcome;
+use desktop_core::scanning::{ScanFailureKind, Verdict};
+use desktop_core::tenants::Destination;
+use serde_json::{Value, json};
+
+use crate::live_run::{DeskOptions, FamilyResult, Found, Run, Spec, destination};
+use crate::{Result, invalid, now_utc};
+
+/// A synthetic, benign prompt: no customer or operator content is scanned.
+const DEFAULT_PROMPT: &str =
+    "Prisma AIRS Desktop v2 controlled live check: a synthetic benign prompt.";
+
+const L01_SCAN: Spec = Spec {
+    id: "L01-scan",
+    workflows: &["W01", "W02", "W04", "W06", "W22"],
+};
+const L01_DENIED: Spec = Spec {
+    id: "L01-denied",
+    workflows: &["W02", "W05"],
+};
+const L18_SCAN: Spec = Spec {
+    id: "L18-own-scope",
+    workflows: &["W03", "W32"],
+};
+const L18_OWN_ID: Spec = Spec {
+    id: "L18-own-profile-id",
+    workflows: &["W03", "W32"],
+};
+const L18_CROSS: Spec = Spec {
+    id: "L18-cross-scope-denied",
+    workflows: &["W03", "W32"],
+};
+
+/// One planned scan: whose key goes toward whose destination, whether the
+/// service must refuse it, and which budget pays for it. `by_profile_id`
+/// names the destination's profile by the ID its own scan answered with,
+/// not by the configured name: tenants in one region share an endpoint and
+/// may each have a profile of the same name, so only the ID identifies the
+/// other scope's profile.
+#[derive(Clone, Copy)]
+struct Step {
+    spec: Spec,
+    key_family: &'static str,
+    key_name: &'static str,
+    dest_family: &'static str,
+    expect_denied: bool,
+    by_profile_id: bool,
+    budget: &'static str,
+}
+
+fn profile(run: &Run<'_>, family: &str) -> std::result::Result<Value, String> {
+    match (
+        run.nonsecret(family, "profile_name"),
+        run.nonsecret(family, "profile_id"),
+    ) {
+        (Some(name), None) => Ok(json!({"kind": "name", "name": name})),
+        (None, Some(id)) => Ok(json!({"kind": "id", "id": id})),
+        _ => Err("exactly one of profile_name or profile_id is required".to_owned()),
+    }
+}
+
+/// What a settled scan shows, as recorded.
+fn observe(record: &ScanRecordView, mut found: Found) -> Found {
+    found = found.with("outcome", json!(record.outcome));
+    if let Some(result) = &record.result {
+        found = found
+            .with("verdict", json!(result.verdict))
+            .with("action", json!(result.action))
+            .with("category", json!(result.category))
+            .with("timeout", json!(result.timeout))
+            .with("service_error", json!(result.service_error))
+            .with("profile_name", json!(result.profile_name))
+            .id("scan_id", &result.scan_id)
+            .id("report_id", &result.report_id);
+        if let Some(tr) = &result.tr_id {
+            found = found.id("tr_id", tr);
+        }
+        if let Some(p) = &result.profile_id {
+            found = found.id("profile_id", p);
+        }
+    }
+    if let Some(failure) = &record.failure {
+        found = found
+            .with("failure", json!(failure.kind))
+            .with("status", json!(failure.status));
+    }
+    found
+}
+
+/// A settled scan that may have reached the service without a reliable
+/// outcome: its consumption is uncertain.
+fn uncertain(record: &ScanRecordView) -> bool {
+    record.outcome == Some(Outcome::Unknown) || record.discarded
+}
+
+/// Another scope's key refused for this scope's profile, with no result. A
+/// key outside the profile's tenant is told the profile does not exist
+/// (400) on a shared regional endpoint, or refused as a credential.
+fn refused(record: &ScanRecordView) -> bool {
+    denied(record)
+        || (record.result.is_none()
+            && record.failure.as_ref().is_some_and(|f| {
+                matches!(
+                    f.kind,
+                    ScanFailureKind::BadRequest | ScanFailureKind::Unprocessable
+                )
+            }))
+}
+
+fn denied(record: &ScanRecordView) -> bool {
+    record.result.is_none()
+        && record.failure.as_ref().is_some_and(|f| {
+            matches!(
+                f.kind,
+                ScanFailureKind::Unauthorized
+                    | ScanFailureKind::Forbidden
+                    | ScanFailureKind::CredentialDenied
+            )
+        })
+}
+
+async fn scan(desk: &mut crate::live_run::Desk, draft: Value) -> Result<ScanRecordView> {
+    let context = desk.context_text()?;
+    let operation = desk
+        .admit(json!({"kind": "scan", "context": context, "draft": draft}))
+        .await?;
+    let snap = desk
+        .wait(|s| {
+            s.scans.iter().any(|r| {
+                r.operation == operation && r.progress == desktop_core::ScanProgress::Settled
+            })
+        })
+        .await?;
+    snap.scans
+        .into_iter()
+        .find(|r| r.operation == operation)
+        .ok_or_else(|| invalid("the settled scan is not listed"))
+}
+
+/// A check's finding, its inputs and the profile ID its scan answered with.
+type Stepped = (Found, BTreeMap<String, Value>, Option<String>);
+
+async fn step(run: &mut Run<'_>, step: Step, target: Option<&str>) -> Result<Stepped> {
+    let dest: Destination = match destination(run.family(step.dest_family)?, false) {
+        Ok(d) => d,
+        Err(e) => return Ok((Found::blocked(e), BTreeMap::new(), None)),
+    };
+    let mut inputs = run.inputs(step.dest_family, &[]);
+    inputs.insert("endpoint".to_owned(), json!(dest.origin()));
+    inputs.insert(
+        "credential".to_owned(),
+        json!(format!("{}.{}", step.key_family, step.key_name)),
+    );
+    inputs
+        .entry("prompt".to_owned())
+        .or_insert_with(|| json!(DEFAULT_PROMPT));
+    let profile = if step.by_profile_id {
+        let Some(id) = target else {
+            return Ok((
+                Found::blocked(format!(
+                    "{}'s own scan answered with no profile ID to aim at",
+                    step.dest_family
+                )),
+                inputs,
+                None,
+            ));
+        };
+        inputs.insert("profile_id".to_owned(), json!(id));
+        inputs.remove("profile_name");
+        json!({"kind": "id", "id": id})
+    } else {
+        match profile(run, step.dest_family) {
+            Ok(p) => p,
+            Err(e) => return Ok((Found::blocked(e), inputs, None)),
+        }
+    };
+    let Some(key) = run.secret(step.key_family, step.key_name)? else {
+        return Ok((
+            Found::blocked(format!(
+                "{} designates no {} credential",
+                step.key_family, step.key_name
+            )),
+            inputs,
+            None,
+        ));
+    };
+    if let Err(e) = run.guard.spend(step.budget, "scans", 1) {
+        return Ok((
+            Found::blocked(e.clone()).stopping(format!("unexpected cost: {e}"), false),
+            inputs,
+            None,
+        ));
+    }
+    let mut desk = run.desk(DeskOptions::default())?;
+    desk.tenant(&format!("C25 {}", step.spec.id), None, &dest)
+        .await?;
+    desk.scan_key(&key).await?;
+    let draft = json!({
+        "profile": profile,
+        "prompt": run.nonsecret(step.dest_family, "prompt").unwrap_or_else(|| DEFAULT_PROMPT.to_owned()),
+        "response": "",
+        "appName": run.nonsecret(step.dest_family, "app_name"),
+    });
+    let record = scan(&mut desk, draft).await?;
+    let answered = record.result.as_ref().and_then(|r| r.profile_id.clone());
+    let management = desk.management_configured()?;
+    drop(desk);
+    let cleanup = "a local session-only tenant; removed with the run's core, no remote resource";
+    if uncertain(&record) {
+        let mut found = observe(
+            &record,
+            Found::failed(
+                "the scan may have reached the service without a reliable outcome; its \
+                 consumption is uncertain",
+            ),
+        )
+        .stopping("an uncertain outcome", true);
+        found.cleanup = cleanup.to_owned();
+        return Ok((found, inputs, answered));
+    }
+    let mut found = if step.expect_denied {
+        if record.result.is_some() {
+            Found::failed("unexpected authority: a credential that must be denied completed a scan")
+                .stopping("unexpected authority", false)
+        } else {
+            if step.by_profile_id {
+                Found::check(
+                    refused(&record),
+                    "the service refused this key for the other scope's profile and nothing \
+                     was shown as a result",
+                    "the request failed, but not as a refusal of the other scope's profile",
+                )
+            } else {
+                Found::check(
+                    denied(&record),
+                    "the service refused the credential and nothing was shown as a result",
+                    "the request failed, but not as a credential denial",
+                )
+            }
+        }
+    } else {
+        match &record.result {
+            None => Found::failed("the designated key did not complete a scan"),
+            Some(result) => {
+                let expected = if step.by_profile_id {
+                    target.map(str::to_owned)
+                } else {
+                    run.nonsecret(step.dest_family, "expected_profile_id")
+                };
+                if let Some(expected) = expected
+                    && result.profile_id.as_deref() != Some(expected.as_str())
+                {
+                    Found::failed(format!(
+                        "unexpected authority: the service answered for another profile than {expected}"
+                    ))
+                    .stopping("unexpected tenant or authority", false)
+                } else {
+                    let complete = record.outcome == Some(Outcome::Completed)
+                        && !result.timeout
+                        && !result.service_error
+                        && result.verdict != Verdict::Unknown;
+                    Found::check(
+                        complete,
+                        "a complete verdict for the explicit profile, with no management capability configured",
+                        "the scan settled incomplete (timeout, service error or unknown verdict)",
+                    )
+                }
+            }
+        }
+        .with("management_configured", json!(management))
+    };
+    found = observe(&record, found);
+    found.cleanup = cleanup.to_owned();
+    Ok((found, inputs, answered))
+}
+
+pub(crate) async fn run(run: &mut Run<'_>, id: &str) -> Result<FamilyResult> {
+    let s = |spec, key_family, key_name, dest_family, expect_denied, by_profile_id, budget| Step {
+        spec,
+        key_family,
+        key_name,
+        dest_family,
+        expect_denied,
+        by_profile_id,
+        budget,
+    };
+    let mut plan = Vec::new();
+    let mut blocked = Vec::new();
+    match id {
+        "L01" => {
+            plan.push(s(L01_SCAN, "L01", "scan_key", "L01", false, false, "L01"));
+            plan.push(s(
+                L01_DENIED,
+                "L01",
+                "denied_scan_key",
+                "L01",
+                true,
+                false,
+                "L01",
+            ));
+        }
+        _ => {
+            let budget = if run.family("L18")?.budget.contains_key("scans") {
+                "L18"
+            } else {
+                "L01"
+            };
+            plan.push(s(L18_SCAN, "L18", "scan_key", "L18", false, false, budget));
+            // L18's own key names its profile by the ID it answered with, so
+            // that request shape is shown to work before L01's key tries it.
+            plan.push(s(L18_OWN_ID, "L18", "scan_key", "L18", false, true, budget));
+            if run.designated("L01") {
+                // L01's key aimed at L18's profile ID must be refused.
+                plan.push(s(L18_CROSS, "L01", "scan_key", "L18", true, true, budget));
+            } else {
+                blocked.push(L18_CROSS);
+            }
+        }
+    }
+    let mut outcomes = Vec::new();
+    // The profile ID L18's own scan answered with.
+    let mut target: Option<String> = None;
+    for planned in plan {
+        let started = now_utc();
+        let (found, inputs, answered) = step(run, planned, target.as_deref()).await?;
+        if planned.spec.id == L18_SCAN.id {
+            target = answered;
+        }
+        if let Some(stop) = run.settle(
+            id,
+            planned.spec,
+            started,
+            inputs,
+            found,
+            Some(planned.budget),
+            &mut outcomes,
+        )? {
+            return Ok(FamilyResult {
+                outcomes,
+                stop: Some(stop),
+            });
+        }
+    }
+    for spec in blocked {
+        let found = Found::blocked("L01 is not designated, so no other scope's key can be tried");
+        run.settle(
+            id,
+            spec,
+            now_utc(),
+            BTreeMap::new(),
+            found,
+            None,
+            &mut outcomes,
+        )?;
+    }
+    Ok(FamilyResult {
+        outcomes,
+        stop: None,
+    })
+}
diff --git a/crates/xtask/src/live_workbench.rs b/crates/xtask/src/live_workbench.rs
new file mode 100644
index 00000000..c5339508
--- /dev/null
+++ b/crates/xtask/src/live_workbench.rs
@@ -0,0 +1,677 @@
+//! L15 API Client (C25) through the production `workbench` intent: a
+//! run-owned collection (in a scratch folder the folder sheet answers with)
+//! sends to the designated HTTPS endpoint (headers, cookies, a multipart
+//! upload, a download saved through the save sheet, a stored secret) and to
+//! the tenant's AIRS API through a managed collection: an approved read,
+//! and a reversible write that is held for review until the runner's armed
+//! native confirmation applies it, then removed the same way.
+
+use std::collections::BTreeMap;
+use std::path::Path;
+
+use desktop_core::management::ManagementEndpoints;
+use serde_json::{Value, json};
+
+use crate::live_run::{
+    Desk, DeskOptions, Evidence, FamilyResult, Found, Outcomes, Run, Spec, Stop,
+};
+use crate::{Result, invalid, io_err, now_utc};
+
+const HEADERS: Spec = Spec {
+    id: "L15-headers-and-query",
+    workflows: &["W29"],
+};
+const COOKIES: Spec = Spec {
+    id: "L15-cookies",
+    workflows: &["W29"],
+};
+const UPLOAD: Spec = Spec {
+    id: "L15-multipart-upload",
+    workflows: &["W29"],
+};
+const DOWNLOAD: Spec = Spec {
+    id: "L15-download",
+    workflows: &["W30"],
+};
+const SECRET: Spec = Spec {
+    id: "L15-stored-secret",
+    workflows: &["W27"],
+};
+const AIRS_READ: Spec = Spec {
+    id: "L15-airs-read",
+    workflows: &["W31", "W32"],
+};
+const AIRS_WRITE: Spec = Spec {
+    id: "L15-airs-reviewed-write",
+    workflows: &["W32", "W33"],
+};
+
+/// Where a cleanup path takes the created resource's ID.
+const CREATED_ID: &str = "{created_id}";
+
+const UPLOAD_BYTES: &[u8] = b"c25-upload synthetic file\n";
+
+fn request(id: &str, method: &str, url: &str, extra: &str) -> String {
+    format!("format_version = 1\nid = \"{id}\"\nmethod = \"{method}\"\nurl = \"{url}\"\n{extra}")
+}
+
+fn write(path: &Path, text: &[u8]) -> Result<()> {
+    if let Some(parent) = path.parent() {
+        std::fs::create_dir_all(parent).map_err(io_err(parent))?;
+    }
+    std::fs::write(path, text).map_err(io_err(path))
+}
+
+/// A collection inside a Git repository folder (as v1 requires).
+fn collection(
+    root: &Path,
+    id: &str,
+    variables: &str,
+    files: &[(String, Vec<u8>)],
+) -> Result<std::path::PathBuf> {
+    std::fs::create_dir_all(root.join(".git")).map_err(io_err(root))?;
+    let api = root.join("api");
+    write(
+        &api.join("collection.toml"),
+        format!("format_version = 1\nid = \"{id}\"\nname = \"C25 live checks\"\n\n[variables]\n{variables}").as_bytes(),
+    )?;
+    for (relative, bytes) in files {
+        write(&api.join(relative), bytes)?;
+    }
+    Ok(api)
+}
+
+fn toml_string(text: &str) -> String {
+    serde_json::to_string(text).unwrap_or_else(|_| "\"\"".to_owned())
+}
+
+struct Ctx<'r, 'a> {
+    run: &'r mut Run<'a>,
+    outcomes: Outcomes,
+    stop: Option<Stop>,
+}
+
+impl Ctx<'_, '_> {
+    fn settle(
+        &mut self,
+        spec: Spec,
+        started: String,
+        inputs: BTreeMap<String, Value>,
+        found: Found,
+    ) -> Result<()> {
+        let stop = self.run.settle(
+            "L15",
+            spec,
+            started,
+            inputs,
+            found,
+            None,
+            &mut self.outcomes,
+        )?;
+        if self.stop.is_none() {
+            self.stop = stop;
+        }
+        Ok(())
+    }
+
+    fn block(&mut self, specs: &[Spec], reason: &str) -> Result<()> {
+        for spec in specs {
+            self.settle(*spec, now_utc(), BTreeMap::new(), Found::blocked(reason))?;
+        }
+        Ok(())
+    }
+}
+
+async fn open(desk: &mut Desk) -> Result<()> {
+    let opened = desk.workbench(json!({"kind": "openFolder"})).await?;
+    if opened["kind"] != "opened" {
+        return Err(invalid(format!(
+            "the collection did not open: {}",
+            opened["kind"]
+        )));
+    }
+    Ok(())
+}
+
+async fn doc(desk: &mut Desk, relative: &str) -> Result<Value> {
+    let r = desk
+        .workbench(json!({"kind": "openRequest", "relative": relative}))
+        .await?;
+    if r["kind"] != "document" {
+        return Err(invalid(format!("{relative} did not open: {}", r["kind"])));
+    }
+    Ok(r["document"].clone())
+}
+
+async fn send(
+    desk: &mut Desk,
+    doc: &Value,
+    fields: &Value,
+    context: Option<String>,
+) -> Result<Value> {
+    desk.workbench(
+        json!({"kind": "send", "id": doc["id"], "revision": doc["revision"],
+        "fields": fields, "context": context}),
+    )
+    .await
+}
+
+fn status(r: &Value) -> Option<u64> {
+    r["run"]["record"]["status"].as_u64()
+}
+
+fn ok(r: &Value) -> bool {
+    r["kind"] == "ran" && status(r).is_some_and(|s| (200..300).contains(&s))
+}
+
+fn preview_has(r: &Value, needle: &str) -> bool {
+    r["run"]["preview"].as_str().is_some_and(|p| {
+        p.to_ascii_lowercase()
+            .contains(&needle.to_ascii_lowercase())
+    })
+}
+
+fn shown(r: &Value) -> Found {
+    let mut found = Found::new("passed", "")
+        .with("result", r["kind"].clone())
+        .with("status", r["run"]["record"]["status"].clone())
+        .with("bytes", r["run"]["record"]["bytes"].clone());
+    if let Some(id) = r["run"]["record"]["id"].as_str() {
+        found = found.id("run_id", id);
+    }
+    found
+}
+
+fn verdict(mut found: Found, ok: bool, passed: &str, failed: &str) -> Found {
+    found.outcome = if ok { "passed" } else { "failed" };
+    found.detail = if ok { passed } else { failed }.to_owned();
+    found
+}
+
+pub(crate) async fn run(run: &mut Run<'_>, _id: &str) -> Result<FamilyResult> {
+    let mut ctx = Ctx {
+        run,
+        outcomes: Vec::new(),
+        stop: None,
+    };
+    let plain = [HEADERS, COOKIES, UPLOAD, DOWNLOAD, SECRET];
+    match ctx.run.nonsecret("L15", "endpoint") {
+        None => ctx.block(&plain, "L15 designates no HTTPS endpoint")?,
+        Some(endpoint) if !endpoint.starts_with("https://") => {
+            ctx.block(&plain, "the designated endpoint must be HTTPS")?;
+        }
+        Some(endpoint) => {
+            let echoes = ctx.run.nonsecret("L15", "echo").as_deref() != Some("no");
+            if !echoes {
+                ctx.block(
+                    &[HEADERS, COOKIES, UPLOAD, SECRET],
+                    "the designated endpoint does not echo requests, so what was sent cannot be observed",
+                )?;
+            }
+            plain_checks(&mut ctx, &endpoint, echoes).await?;
+        }
+    }
+    if ctx.stop.is_none() {
+        airs_checks(&mut ctx).await?;
+    }
+    Ok(FamilyResult {
+        outcomes: ctx.outcomes,
+        stop: ctx.stop,
+    })
+}
+
+async fn plain_checks(ctx: &mut Ctx<'_, '_>, endpoint: &str, echoes: bool) -> Result<()> {
+    let path = |key: &str, default: &str| {
+        ctx.run
+            .nonsecret("L15", key)
+            .unwrap_or_else(|| default.to_owned())
+    };
+    let headers_path = path("headers_path", "/headers");
+    let cookie_set = path("cookie_set_path", "/cookies/set?c25=1");
+    let cookie_echo = path("cookie_echo_path", "/cookies");
+    let upload_path = path("upload_path", "/post");
+    let download_path = path("download_path", "/bytes/2048");
+    let auth_path = path("auth_path", "/bearer");
+    let root = ctx.run.folder("collection")?;
+    let saves = ctx.run.folder("downloads")?;
+    let private = ctx.run.folder("workbench")?;
+    let files = vec![
+        (
+            "headers.request.toml".to_owned(),
+            request("headers", "GET", &format!("{{{{base}}}}{headers_path}"), "").into_bytes(),
+        ),
+        (
+            "cookie-set.request.toml".to_owned(),
+            request("cookieset", "GET", &format!("{{{{base}}}}{cookie_set}"), "").into_bytes(),
+        ),
+        (
+            "cookie-echo.request.toml".to_owned(),
+            request(
+                "cookieecho",
+                "GET",
+                &format!("{{{{base}}}}{cookie_echo}"),
+                "",
+            )
+            .into_bytes(),
+        ),
+        (
+            "upload.request.toml".to_owned(),
+            request(
+                "upload",
+                "POST",
+                &format!("{{{{base}}}}{upload_path}"),
+                "body_kind = \"multipart\"\n",
+            )
+            .into_bytes(),
+        ),
+        (
+            "download.request.toml".to_owned(),
+            request(
+                "download",
+                "GET",
+                &format!("{{{{base}}}}{download_path}"),
+                "",
+            )
+            .into_bytes(),
+        ),
+        (
+            "auth.request.toml".to_owned(),
+            request(
+                "auth",
+                "GET",
+                &format!("{{{{base}}}}{auth_path}"),
+                "[auth]\nkind = \"bearer\"\nsecret = \"c25-endpoint-token\"\n",
+            )
+            .into_bytes(),
+        ),
+        ("data/c25.bin".to_owned(), UPLOAD_BYTES.to_vec()),
+    ];
+    let api = collection(
+        &root,
+        "c25-live",
+        &format!("base = {}\n", toml_string(endpoint)),
+        &files,
+    )?;
+    let mut desk = ctx.run.desk(DeskOptions {
+        workbench_live: true,
+        folder: Some(api),
+        workbench_root: Some(private),
+        save_dir: Some(saves.clone()),
+        ..DeskOptions::default()
+    })?;
+    open(&mut desk).await?;
+    let mut inputs = ctx.run.inputs("L15", &[]);
+    inputs.insert("endpoint".to_owned(), json!(endpoint));
+
+    if echoes {
+        echoed(ctx, &mut desk, &inputs).await?;
+    }
+
+    let started = now_utc();
+    let d = doc(&mut desk, "download.request.toml").await?;
+    let r = send(&mut desk, &d, &d["fields"].clone(), None).await?;
+    let found = match r["run"]["record"]["id"].as_str() {
+        Some(run_id) if ok(&r) => {
+            let saved = desk
+                .workbench(json!({"kind": "saveResponse", "run": run_id}))
+                .await?;
+            let bytes = saved["bytes"].as_u64();
+            let on_disk = std::fs::read_dir(&saves)
+                .map(|d| {
+                    d.flatten()
+                        .filter_map(|e| e.metadata().ok())
+                        .map(|m| m.len())
+                        .sum::<u64>()
+                })
+                .unwrap_or(0);
+            verdict(
+                shown(&r)
+                    .with("saved", saved["kind"].clone())
+                    .with("saved_bytes", json!(bytes)),
+                saved["kind"] == "responseSaved" && bytes.is_some_and(|b| b > 0 && b == on_disk),
+                "the stored body was saved exactly through the save sheet",
+                "the response could not be saved exactly",
+            )
+        }
+        _ => verdict(
+            shown(&r),
+            false,
+            "",
+            "the download request did not complete",
+        ),
+    };
+    let mut found = found;
+    found.cleanup = "the saved file is in a run-owned folder removed after the run".to_owned();
+    ctx.settle(DOWNLOAD, started, inputs.clone(), found)?;
+    if !echoes {
+        return Ok(());
+    }
+
+    let started = now_utc();
+    let found = match ctx.run.secret("L15", "endpoint_token")? {
+        None => Found::blocked("L15 designates no endpoint_token credential"),
+        Some(token) => {
+            let set = desk
+                .workbench(json!({"kind": "setSecret", "reference": "c25-endpoint-token", "value": (*token).clone()}))
+                .await?;
+            let d = doc(&mut desk, "auth.request.toml").await?;
+            let r = send(&mut desk, &d, &d["fields"].clone(), None).await?;
+            let _ = desk
+                .workbench(json!({"kind": "removeSecret", "reference": "c25-endpoint-token"}))
+                .await;
+            verdict(
+                shown(&r).with("stored", set["kind"].clone()),
+                set["kind"] == "done" && ok(&r),
+                "a private secret was stored, used as bearer auth and removed; it appears in no record",
+                "the stored secret was not accepted by the endpoint",
+            )
+        }
+    };
+    inputs.insert("credentials".to_owned(), json!(["L15.endpoint_token"]));
+    ctx.settle(SECRET, started, inputs, found)?;
+    Ok(())
+}
+
+/// Headers, cookies and a multipart upload: each needs an endpoint that
+/// echoes what it received.
+async fn echoed(
+    ctx: &mut Ctx<'_, '_>,
+    desk: &mut Desk,
+    inputs: &BTreeMap<String, Value>,
+) -> Result<()> {
+    let started = now_utc();
+    let d = doc(desk, "headers.request.toml").await?;
+    let mut fields = d["fields"].clone();
+    fields["headers"] = json!("X-C25-Check: headers");
+    fields["query"] = json!("c25=query");
+    let r = send(desk, &d, &fields, None).await?;
+    let found = verdict(
+        shown(&r),
+        ok(&r) && preview_has(&r, "x-c25-check"),
+        "the request carried exactly the typed header and query, and the endpoint echoed the header",
+        "the endpoint did not answer 2xx with the typed header",
+    );
+    ctx.settle(HEADERS, started, inputs.clone(), found)?;
+
+    let started = now_utc();
+    let d = doc(desk, "cookie-set.request.toml").await?;
+    let first = send(desk, &d, &d["fields"].clone(), None).await?;
+    let d = doc(desk, "cookie-echo.request.toml").await?;
+    let second = send(desk, &d, &d["fields"].clone(), None).await?;
+    let found = verdict(
+        shown(&second).with("set_status", first["run"]["record"]["status"].clone()),
+        status(&first).is_some_and(|s| s < 400) && ok(&second) && preview_has(&second, "c25"),
+        "the cookie one response set was sent with the next request to its origin",
+        "the cookie was not carried to the next request",
+    );
+    ctx.settle(COOKIES, started, inputs.clone(), found)?;
+
+    let started = now_utc();
+    let d = doc(desk, "upload.request.toml").await?;
+    let mut fields = d["fields"].clone();
+    fields["body"] = json!(
+        "[[parts]]\nname = \"note\"\nvalue = \"c25-upload\"\n[[parts]]\nname = \"file\"\nfile = \"data/c25.bin\"\nmime = \"application/octet-stream\"\n"
+    );
+    let r = send(desk, &d, &fields, None).await?;
+    let found = verdict(
+        shown(&r),
+        ok(&r) && preview_has(&r, "c25-upload"),
+        "a multipart body with a collection file was uploaded and echoed",
+        "the multipart upload was not accepted",
+    );
+    ctx.settle(UPLOAD, started, inputs.clone(), found)
+}
+
+async fn airs_checks(ctx: &mut Ctx<'_, '_>) -> Result<()> {
+    let Some(read_path) = ctx.run.nonsecret("L15", "airs_read_path") else {
+        return ctx.block(&[AIRS_READ, AIRS_WRITE], "L15 designates no airs_read_path");
+    };
+    let endpoints = match ctx.run.evidence {
+        Evidence::Fixture(f) => f
+            .management
+            .as_deref()
+            .map(ManagementEndpoints::at_origin)
+            .unwrap_or_default(),
+        Evidence::Live => ManagementEndpoints::default(),
+    };
+    let api = url::Url::parse(&endpoints.api)
+        .map_err(|_| invalid("the management API URL is not valid"))?
+        .origin()
+        .ascii_serialization();
+    let write = (
+        ctx.run.nonsecret("L15", "airs_write_method"),
+        ctx.run.nonsecret("L15", "airs_write_path"),
+        ctx.run.nonsecret("L15", "airs_write_body"),
+        ctx.run.nonsecret("L15", "airs_cleanup_path"),
+    );
+    const OAUTH: &str = "[auth]\nkind = \"oauth2\"\ntoken_url = \"{{token_url}}\"\nclient_id = \"{{client_id}}\"\nclient_secret = \"{{client_secret}}\"\nscope = \"tsg_id:{{tsg_id}}\"\n";
+    let mut files = vec![(
+        "read.request.toml".to_owned(),
+        request(
+            "read",
+            "GET",
+            &format!("{{{{scm_base}}}}{read_path}"),
+            OAUTH,
+        )
+        .into_bytes(),
+    )];
+    if let (Some(method), Some(path), Some(body), Some(cleanup)) = &write {
+        files.push((
+            "write.request.toml".to_owned(),
+            request(
+                "write",
+                method,
+                &format!("{{{{scm_base}}}}{path}"),
+                &format!("body_kind = \"json\"\n{OAUTH}"),
+            )
+            .into_bytes(),
+        ));
+        files.push((
+            "cleanup.request.toml".to_owned(),
+            request(
+                "cleanup",
+                "DELETE",
+                &format!("{{{{scm_base}}}}{cleanup}"),
+                OAUTH,
+            )
+            .into_bytes(),
+        ));
+        let _ = body;
+    }
+    let root = ctx.run.folder("managed")?;
+    let private = ctx.run.folder("workbench-managed")?;
+    let variables = format!(
+        "scm_base = {}\ntoken_url = {}\ntsg_id = {{ secret = \"tenant.tsg_id\" }}\nclient_id = {{ secret = \"tenant.client_id\" }}\nclient_secret = {{ secret = \"tenant.client_secret\" }}\n",
+        toml_string(&api),
+        toml_string(&endpoints.token)
+    );
+    let collection_root = collection(&root, "prisma-airs-scm", &variables, &files)?;
+    let mut desk = match ctx
+        .run
+        .management_desk(
+            "L15",
+            DeskOptions {
+                workbench_live: true,
+                folder: Some(collection_root),
+                workbench_root: Some(private),
+                ..DeskOptions::default()
+            },
+        )
+        .await?
+    {
+        Ok(d) => d,
+        Err(e) => return ctx.block(&[AIRS_READ, AIRS_WRITE], &e),
+    };
+    open(&mut desk).await?;
+    let context = Some(desk.context_text()?);
+    let mut inputs = ctx.run.inputs("L15", &["client_secret"]);
+    inputs.insert("airs_api".to_owned(), json!(api));
+
+    let started = now_utc();
+    let d = doc(&mut desk, "read.request.toml").await?;
+    let r = send(&mut desk, &d, &d["fields"].clone(), context.clone()).await?;
+    let found = verdict(
+        shown(&r),
+        ok(&r),
+        "an approved AIRS read was admitted with the tenant's management credential and answered",
+        "the AIRS read was not admitted or not answered",
+    );
+    ctx.settle(AIRS_READ, started, inputs.clone(), found)?;
+
+    let started = now_utc();
+    let (Some(_), Some(path), Some(body), Some(cleanup)) = write else {
+        return ctx.settle(AIRS_WRITE, started, inputs, Found::blocked(
+            "L15 designates no reversible write (airs_write_method, airs_write_path, airs_write_body, airs_cleanup_path)",
+        ));
+    };
+    let prefix = ctx.run.prefix("L15");
+    let prefix = prefix.filter(|p| !p.is_empty());
+    // The cleanup names the prefix itself, or the created resource's ID,
+    // taken from the write's response only when the name it reports there
+    // carries the prefix.
+    let created = (
+        ctx.run.nonsecret("L15", "airs_created_id_field"),
+        ctx.run.nonsecret("L15", "airs_created_name_field"),
+    );
+    let by_id = cleanup.contains(CREATED_ID) && created.0.is_some() && created.1.is_some();
+    let named = prefix
+        .as_deref()
+        .is_some_and(|p| body.contains(p) && (cleanup.contains(p) || by_id));
+    if !named {
+        return ctx.settle(
+            AIRS_WRITE,
+            started,
+            inputs,
+            Found::blocked(
+                "the write body and its cleanup path must both name the family's disposable prefix",
+            ),
+        );
+    }
+    let (mut found, response) = applied(
+        &mut desk,
+        "write.request.toml",
+        Some(&body),
+        None,
+        context.clone(),
+    )
+    .await?;
+    let mut cleanup_url = None;
+    if found.outcome == "passed" && by_id {
+        let reported = created_resource(&response, &created);
+        match reported {
+            Some((id, name)) if prefix.as_deref().is_some_and(|p| name.starts_with(p)) => {
+                found = found.id("created_id", &id);
+                cleanup_url = Some(id);
+            }
+            _ => {
+                found = verdict(
+                    found,
+                    false,
+                    "",
+                    "the write's response named no created resource under the prefix, so its cleanup has no target",
+                )
+                .stopping("the created resource could not be identified: reconcile it", true);
+            }
+        }
+    }
+    if found.outcome == "passed" {
+        let url = match cleanup_url {
+            Some(id) => {
+                let d = doc(&mut desk, "cleanup.request.toml").await?;
+                d["fields"]["url"]
+                    .as_str()
+                    .map(|u| u.replace(CREATED_ID, &id))
+            }
+            None => None,
+        };
+        let (removed, _) = applied(&mut desk, "cleanup.request.toml", None, url, context).await?;
+        found = found.with("cleanup", json!(removed.outcome)).with(
+            "cleanup_status",
+            removed
+                .observed
+                .get("status")
+                .cloned()
+                .unwrap_or(Value::Null),
+        );
+        found.cleanup = if removed.outcome == "passed" {
+            "the created resource was deleted through the same reviewed path".to_owned()
+        } else {
+            "the cleanup request did not complete: reconcile the created resource".to_owned()
+        };
+        if removed.outcome != "passed" {
+            found = found.stopping("the write's cleanup did not complete", true);
+        }
+    }
+    inputs.insert("write_path".to_owned(), json!(path));
+    ctx.settle(AIRS_WRITE, started, inputs, found)
+}
+
+/// Sends a managed mutation, expects it held for review (nothing sent),
+/// then applies it with the armed native confirmation.
+async fn applied(
+    desk: &mut Desk,
+    relative: &str,
+    body: Option<&str>,
+    url: Option<String>,
+    context: Option<String>,
+) -> Result<(Found, Value)> {
+    let d = doc(desk, relative).await?;
+    let mut fields = d["fields"].clone();
+    if let Some(body) = body {
+        fields["body"] = json!(body);
+    }
+    if let Some(url) = url {
+        fields["url"] = json!(url);
+    }
+    let held = send(desk, &d, &fields, context.clone()).await?;
+    if held["kind"] != "reviewRequired" {
+        let found = verdict(
+            shown(&held),
+            false,
+            "",
+            "unexpected: the mutation was not held for review",
+        );
+        return Ok((found, held));
+    }
+    desk.confirmations.arm();
+    let r = desk
+        .workbench(
+            json!({"kind": "apply", "review": held["review"]["review"], "id": d["id"],
+            "revision": d["revision"], "fields": fields, "context": context}),
+        )
+        .await;
+    desk.confirmations.disarm();
+    let r = r?;
+    let mut found = verdict(
+        shown(&r).with("held_for_review", json!(true)),
+        ok(&r),
+        "held for review (nothing sent), then sent once after the native confirmation",
+        "the reviewed mutation did not complete",
+    );
+    if r["kind"] == "ran" && status(&r).is_none() {
+        found = found.stopping("the mutation's outcome is unknown", true);
+    }
+    if let Some(dest) = held["review"]["destination"].as_str() {
+        found = found.with("destination", json!(dest));
+    }
+    Ok((found, r))
+}
+
+/// The created resource's ID and name, from the write's JSON response
+/// preview, at the designated fields.
+fn created_resource(
+    response: &Value,
+    fields: &(Option<String>, Option<String>),
+) -> Option<(String, String)> {
+    let (Some(id_field), Some(name_field)) = fields else {
+        return None;
+    };
+    let body: Value = serde_json::from_str(response["run"]["preview"].as_str()?).ok()?;
+    let id = body.get(id_field)?.as_str()?.to_owned();
+    let name = body.get(name_field)?.as_str()?.to_owned();
+    (!id.is_empty()
+        && id
+            .chars()
+            .all(|c| c.is_ascii_alphanumeric() || c == '-' || c == '_'))
+    .then_some((id, name))
+}
diff --git a/crates/xtask/src/signing.rs b/crates/xtask/src/signing.rs
new file mode 100644
index 00000000..5d215dc9
--- /dev/null
+++ b/crates/xtask/src/signing.rs
@@ -0,0 +1,604 @@
+//! Developer ID signing for the release (C26).
+//!
+//! Signing rewrites a Mach-O's bytes, and the app checks the bundled
+//! Harness engine against the SHA-256 compiled from `resources/harness/
+//! pin.json` before it starts it. So the engine is signed once, at sealing
+//! time (`harness-sign`, then `tools/harness/seal.py --signed-engine`), and
+//! its signed hash becomes the pin; the release signing below never signs
+//! the engine again and refuses a bundle whose engine is not the pinned one.
+//!
+//! Release order (`release-sign`): verify the engine's signature and pin,
+//! sign the main executable and then the app, notarize and staple the app,
+//! build the DMG from the stapled app, sign it, notarize and staple it, and
+//! assess both. Each stage's hashes are recorded; nothing is uploaded or
+//! published beyond the notary submissions.
+
+use std::path::{Path, PathBuf};
+use std::process::Command;
+
+use serde::{Deserialize, Serialize};
+
+use crate::{Result, invalid, io_err, now_utc, sha256_hex, write_json};
+
+pub const SIGNING_SCHEMA: &str = "airs-v2/engine-signing/1";
+pub const RELEASE_SCHEMA: &str = "airs-v2/release-signing/1";
+/// The ad-hoc identity: no certificate, no timestamp (tests only).
+pub const AD_HOC: &str = "-";
+
+/// `codesign` arguments for one file: hardened runtime, a secure timestamp
+/// for a real identity (an ad-hoc signature cannot be timestamped).
+pub fn codesign_args(identity: &str, path: &Path) -> Vec<String> {
+    let mut argv = vec![
+        "/usr/bin/codesign".to_owned(),
+        "--force".to_owned(),
+        "--sign".to_owned(),
+        identity.to_owned(),
+        "--options".to_owned(),
+        "runtime".to_owned(),
+    ];
+    argv.push(if identity == AD_HOC {
+        "--timestamp=none".to_owned()
+    } else {
+        "--timestamp".to_owned()
+    });
+    argv.push(path.display().to_string());
+    argv
+}
+
+/// Runs an argv with only the system tools on PATH. HOME is kept: the
+/// signing identity and the notary profile live in the operator's Keychain.
+fn run(argv: &[String]) -> Result<std::process::Output> {
+    let (program, args) = argv.split_first().ok_or_else(|| invalid("empty command"))?;
+    let mut command = Command::new(program);
+    command
+        .args(args)
+        .env_clear()
+        .env("PATH", "/usr/bin:/bin:/usr/sbin:/sbin");
+    if let Some(home) = std::env::var_os("HOME") {
+        command.env("HOME", home);
+    }
+    let output = command.output().map_err(io_err(Path::new(program)))?;
+    if !output.status.success() {
+        return Err(invalid(format!(
+            "{} failed with {}: {}",
+            argv.join(" "),
+            output.status,
+            String::from_utf8_lossy(&output.stderr).trim()
+        )));
+    }
+    Ok(output)
+}
+
+fn file_sha256(path: &Path) -> Result<String> {
+    Ok(sha256_hex(&std::fs::read(path).map_err(io_err(path))?))
+}
+
+/// `codesign --verify --strict` of a signed file or bundle.
+pub fn verify(path: &Path) -> Result<()> {
+    run(&[
+        "/usr/bin/codesign".to_owned(),
+        "--verify".to_owned(),
+        "--strict".to_owned(),
+        "--verbose=2".to_owned(),
+        path.display().to_string(),
+    ])
+    .map(|_| ())
+}
+
+/// The signature's team identifier (`None` for an ad-hoc signature).
+pub fn team_identifier(path: &Path) -> Result<Option<String>> {
+    let output = run(&[
+        "/usr/bin/codesign".to_owned(),
+        "-dv".to_owned(),
+        "--verbose=2".to_owned(),
+        path.display().to_string(),
+    ])?;
+    let text = String::from_utf8_lossy(&output.stderr);
+    Ok(text
+        .lines()
+        .find_map(|l| l.strip_prefix("TeamIdentifier="))
+        .map(str::trim)
+        .filter(|t| *t != "not set" && !t.is_empty())
+        .map(str::to_owned))
+}
+
+/// What `harness-sign` produced: the unsigned provenance and the signed
+/// bytes the reseal pins.
+#[derive(Clone, Debug, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct EngineSigning {
+    pub schema: String,
+    pub signed_utc: String,
+    pub identity: String,
+    pub team_identifier: Option<String>,
+    pub options: String,
+    pub timestamp: bool,
+    pub unsigned_sha256: String,
+    pub signed_sha256: String,
+}
+
+/// Copies the engine at `source` to `out/airs-harness`, signs and verifies
+/// the copy, and writes `out/signing.json`. The source must be the pinned
+/// unsigned engine (`expected_unsigned`); `out` must not be the committed
+/// resources folder.
+pub fn sign_engine(
+    source: &Path,
+    expected_unsigned: &str,
+    out: &Path,
+    identity: &str,
+) -> Result<EngineSigning> {
+    if identity.trim().is_empty() {
+        return Err(invalid("a signing identity is required"));
+    }
+    if out.components().any(|c| c.as_os_str() == "resources") {
+        return Err(invalid(
+            "the signed engine is staged outside resources/; seal.py reseals it",
+        ));
+    }
+    let unsigned = file_sha256(source)?;
+    if unsigned != expected_unsigned {
+        return Err(invalid(format!(
+            "{} is not the pinned unsigned engine ({unsigned})",
+            source.display()
+        )));
+    }
+    std::fs::create_dir_all(out).map_err(io_err(out))?;
+    let target = out.join("airs-harness");
+    std::fs::copy(source, &target).map_err(io_err(&target))?;
+    {
+        use std::os::unix::fs::PermissionsExt;
+        std::fs::set_permissions(&target, std::fs::Permissions::from_mode(0o755))
+            .map_err(io_err(&target))?;
+    }
+    run(&codesign_args(identity, &target))?;
+    verify(&target)?;
+    let signed = file_sha256(&target)?;
+    if signed == unsigned {
+        return Err(invalid("signing left the engine's bytes unchanged"));
+    }
+    let record = EngineSigning {
+        schema: SIGNING_SCHEMA.to_owned(),
+        signed_utc: now_utc(),
+        identity: identity.to_owned(),
+        team_identifier: team_identifier(&target)?,
+        options: "runtime".to_owned(),
+        timestamp: identity != AD_HOC,
+        unsigned_sha256: unsigned,
+        signed_sha256: signed,
+    };
+    write_json(&out.join("signing.json"), &record)?;
+    Ok(record)
+}
+
+/// One planned release step.
+#[derive(Clone, Debug, PartialEq, Eq, Serialize, Deserialize)]
+pub struct Step {
+    pub label: String,
+    pub argv: Vec<String>,
+}
+
+/// The release inputs: the built app, where the DMG goes, the identity and
+/// the notary Keychain profile.
+#[derive(Clone, Debug)]
+pub struct Release {
+    pub app: PathBuf,
+    pub executable: String,
+    pub dmg: PathBuf,
+    pub volume: String,
+    pub identity: String,
+    pub profile: String,
+}
+
+impl Release {
+    fn engine(&self) -> PathBuf {
+        self.app.join("Contents/Resources/harness/airs-harness")
+    }
+
+    fn app_zip(&self) -> PathBuf {
+        self.dmg.with_extension("app.zip")
+    }
+
+    fn s(path: &Path) -> String {
+        path.display().to_string()
+    }
+
+    /// Signing steps (no network): the main executable, then the app.
+    pub fn sign_steps(&self) -> Vec<Step> {
+        let exe = self.app.join("Contents/MacOS").join(&self.executable);
+        vec![
+            Step {
+                label: "sign main executable".to_owned(),
+                argv: codesign_args(&self.identity, &exe),
+            },
+            Step {
+                label: "sign app".to_owned(),
+                argv: codesign_args(&self.identity, &self.app),
+            },
+        ]
+    }
+
+    /// Notarize and staple the app, build and sign the DMG from it,
+    /// notarize and staple the DMG, and assess both.
+    pub fn notary_steps(&self) -> Vec<Step> {
+        let notarize = |path: &Path| {
+            vec![
+                "/usr/bin/xcrun".to_owned(),
+                "notarytool".to_owned(),
+                "submit".to_owned(),
+                Self::s(path),
+                "--keychain-profile".to_owned(),
+                self.profile.clone(),
+                "--wait".to_owned(),
+            ]
+        };
+        let staple = |path: &Path| {
+            vec![
+                "/usr/bin/xcrun".to_owned(),
+                "stapler".to_owned(),
+                "staple".to_owned(),
+                Self::s(path),
+            ]
+        };
+        let mut dmg_sign = codesign_args(&self.identity, &self.dmg);
+        // A disk image carries no hardened-runtime flag.
+        dmg_sign.retain(|a| a != "--options" && a != "runtime");
+        vec![
+            Step {
+                label: "zip app for notarization".to_owned(),
+                argv: vec![
+                    "/usr/bin/ditto".to_owned(),
+                    "-c".to_owned(),
+                    "-k".to_owned(),
+                    "--keepParent".to_owned(),
+                    Self::s(&self.app),
+                    Self::s(&self.app_zip()),
+                ],
+            },
+            Step {
+                label: "notarize app".to_owned(),
+                argv: notarize(&self.app_zip()),
+            },
+            Step {
+                label: "staple app".to_owned(),
+                argv: staple(&self.app),
+            },
+            Step {
+                label: "build dmg".to_owned(),
+                argv: vec![
+                    "/usr/bin/hdiutil".to_owned(),
+                    "create".to_owned(),
+                    "-volname".to_owned(),
+                    self.volume.clone(),
+                    "-srcfolder".to_owned(),
+                    Self::s(&self.app),
+                    "-ov".to_owned(),
+                    "-format".to_owned(),
+                    "UDZO".to_owned(),
+                    Self::s(&self.dmg),
+                ],
+            },
+            Step {
+                label: "sign dmg".to_owned(),
+                argv: dmg_sign,
+            },
+            Step {
+                label: "notarize dmg".to_owned(),
+                argv: notarize(&self.dmg),
+            },
+            Step {
+                label: "staple dmg".to_owned(),
+                argv: staple(&self.dmg),
+            },
+            Step {
+                label: "assess app".to_owned(),
+                argv: vec![
+                    "/usr/sbin/spctl".to_owned(),
+                    "-a".to_owned(),
+                    "-vv".to_owned(),
+                    "-t".to_owned(),
+                    "exec".to_owned(),
+                    Self::s(&self.app),
+                ],
+            },
+            Step {
+                label: "assess dmg".to_owned(),
+                argv: vec![
+                    "/usr/sbin/spctl".to_owned(),
+                    "-a".to_owned(),
+                    "-vv".to_owned(),
+                    "-t".to_owned(),
+                    "open".to_owned(),
+                    "--context".to_owned(),
+                    "context:primary-signature".to_owned(),
+                    Self::s(&self.dmg),
+                ],
+            },
+            Step {
+                label: "validate dmg staple".to_owned(),
+                argv: vec![
+                    "/usr/bin/xcrun".to_owned(),
+                    "stapler".to_owned(),
+                    "validate".to_owned(),
+                    Self::s(&self.dmg),
+                ],
+            },
+        ]
+    }
+
+    /// Every step, in order.
+    pub fn plan(&self) -> Vec<Step> {
+        let mut steps = self.sign_steps();
+        steps.extend(self.notary_steps());
+        steps
+    }
+}
+
+/// Hashes recorded at each stage of a release signing.
+#[derive(Clone, Debug, Default, PartialEq, Eq, Serialize, Deserialize)]
+pub struct Stages {
+    pub app_tree_sha256: Option<String>,
+    pub executable_sha256: Option<String>,
+    pub engine_sha256: Option<String>,
+    pub dmg_sha256: Option<String>,
+}
+
+#[derive(Clone, Debug, PartialEq, Eq, Serialize, Deserialize)]
+pub struct ReleaseRecord {
+    pub schema: String,
+    pub started_utc: String,
+    pub finished_utc: String,
+    pub identity: String,
+    pub team_identifier: Option<String>,
+    pub profile: String,
+    pub steps: Vec<Step>,
+    pub notarized: bool,
+    pub before_signing: Stages,
+    pub after_signing: Stages,
+    pub stapled: Stages,
+}
+
+fn stages(release: &Release, dmg: bool) -> Result<Stages> {
+    let exe = release.app.join("Contents/MacOS").join(&release.executable);
+    Ok(Stages {
+        app_tree_sha256: Some(crate::fingerprint::tree_hash(&release.app)?),
+        executable_sha256: Some(file_sha256(&exe)?),
+        engine_sha256: Some(file_sha256(&release.engine())?),
+        dmg_sha256: if dmg && release.dmg.exists() {
+            Some(file_sha256(&release.dmg)?)
+        } else {
+            None
+        },
+    })
+}
+
+/// Signs `release` and, with `notarize`, notarizes, staples and assesses
+/// it. Refuses before signing anything when the bundled engine is not the
+/// pinned (`engine_pin`) signed engine or its signature does not verify.
+pub fn execute(release: &Release, engine_pin: &str, notarize: bool) -> Result<ReleaseRecord> {
+    let started = now_utc();
+    let engine = release.engine();
+    let engine_hash = file_sha256(&engine)?;
+    if engine_hash != engine_pin {
+        return Err(invalid(format!(
+            "the bundled engine ({engine_hash}) is not the pinned engine ({engine_pin}); \
+             sign it at sealing time (harness-sign, seal.py --signed-engine) and rebuild"
+        )));
+    }
+    verify(&engine).map_err(|e| {
+        invalid(format!(
+            "the bundled engine's signature does not verify: {e}"
+        ))
+    })?;
+    let before = stages(release, false)?;
+    let mut steps = release.sign_steps();
+    for step in &steps {
+        run(&step.argv)?;
+    }
+    verify(&release.app)?;
+    let after = stages(release, false)?;
+    if after.engine_sha256 != before.engine_sha256 {
+        return Err(invalid("signing the app changed the engine's bytes"));
+    }
+    let mut stapled = Stages::default();
+    if notarize {
+        let notary = release.notary_steps();
+        for step in &notary {
+            run(&step.argv)?;
+        }
+        steps.extend(notary);
+        stapled = stages(release, true)?;
+    }
+    Ok(ReleaseRecord {
+        schema: RELEASE_SCHEMA.to_owned(),
+        started_utc: started,
+        finished_utc: now_utc(),
+        identity: release.identity.clone(),
+        team_identifier: team_identifier(&release.app)?,
+        profile: release.profile.clone(),
+        steps,
+        notarized: notarize,
+        before_signing: before,
+        after_signing: after,
+        stapled,
+    })
+}
+
+#[cfg(test)]
+mod tests {
+    use super::{AD_HOC, Release, codesign_args, execute, file_sha256, sign_engine, verify};
+    use std::path::{Path, PathBuf};
+
+    fn scratch(name: &str) -> PathBuf {
+        let dir = std::env::temp_dir().join(format!(
+            "airs-v2-signing-{name}-{}-{}",
+            std::process::id(),
+            crate::random_hex(4).expect("random")
+        ));
+        std::fs::create_dir_all(&dir).expect("scratch");
+        dir
+    }
+
+    /// A Mach-O to sign: a copy of a system tool.
+    fn macho(path: &Path) {
+        std::fs::create_dir_all(path.parent().expect("parent")).expect("dir");
+        std::fs::copy("/usr/bin/true", path).expect("copy");
+    }
+
+    fn release(app: &Path, dir: &Path, identity: &str) -> Release {
+        Release {
+            app: app.to_path_buf(),
+            executable: "fake".to_owned(),
+            dmg: dir.join("Fake.dmg"),
+            volume: "Fake".to_owned(),
+            identity: identity.to_owned(),
+            profile: "prisma-airs-desktop".to_owned(),
+        }
+    }
+
+    #[test]
+    fn a_real_identity_is_timestamped_and_an_ad_hoc_one_is_not() {
+        let p = Path::new("/x/airs-harness");
+        let real = codesign_args("Developer ID Application: Example (TEAM123456)", p);
+        assert_eq!(
+            real[1..],
+            [
+                "--force",
+                "--sign",
+                "Developer ID Application: Example (TEAM123456)",
+                "--options",
+                "runtime",
+                "--timestamp",
+                "/x/airs-harness"
+            ]
+        );
+        assert!(codesign_args(AD_HOC, p).contains(&"--timestamp=none".to_owned()));
+    }
+
+    #[test]
+    fn the_release_plan_signs_inside_out_never_re_signs_the_engine_and_staples_both() {
+        let dir = Path::new("/rel");
+        let app = dir.join("Fake.app");
+        let plan = release(&app, dir, "Developer ID Application: Example (TEAM123456)").plan();
+        let labels: Vec<&str> = plan.iter().map(|s| s.label.as_str()).collect();
+        assert_eq!(
+            labels,
+            [
+                "sign main executable",
+                "sign app",
+                "zip app for notarization",
+                "notarize app",
+                "staple app",
+                "build dmg",
+                "sign dmg",
+                "notarize dmg",
+                "staple dmg",
+                "assess app",
+                "assess dmg",
+                "validate dmg staple"
+            ]
+        );
+        assert!(
+            plan.iter()
+                .all(|s| !s.argv.iter().any(|a| a.ends_with("airs-harness"))),
+            "the engine is signed at sealing time only"
+        );
+        assert_eq!(
+            plan[0].argv.last().map(String::as_str),
+            Some("/rel/Fake.app/Contents/MacOS/fake")
+        );
+        let notarize = &plan[3].argv;
+        assert!(
+            notarize
+                .windows(2)
+                .any(|w| w == ["--keychain-profile", "prisma-airs-desktop"])
+        );
+        assert!(notarize.contains(&"--wait".to_owned()));
+        assert!(!plan[6].argv.contains(&"runtime".to_owned()));
+    }
+
+    #[test]
+    fn the_engine_is_signed_once_from_its_pinned_unsigned_bytes() {
+        let dir = scratch("engine");
+        let source = dir.join("src/airs-harness");
+        macho(&source);
+        let unsigned = file_sha256(&source).expect("hash");
+        let out = dir.join("signed");
+        assert!(sign_engine(&source, &"0".repeat(64), &out, AD_HOC).is_err());
+        assert!(sign_engine(&source, &unsigned, &dir.join("resources/harness"), AD_HOC).is_err());
+        let record = sign_engine(&source, &unsigned, &out, AD_HOC).expect("signed");
+        assert_eq!(record.unsigned_sha256, unsigned);
+        assert_ne!(record.signed_sha256, unsigned);
+        assert_eq!(
+            file_sha256(&out.join("airs-harness")).expect("hash"),
+            record.signed_sha256
+        );
+        assert_eq!(
+            file_sha256(&source).expect("hash"),
+            unsigned,
+            "source untouched"
+        );
+        assert_eq!((record.team_identifier, record.timestamp), (None, false));
+        verify(&out.join("airs-harness")).expect("verifies");
+        assert!(out.join("signing.json").exists());
+        let _ = std::fs::remove_dir_all(&dir);
+    }
+
+    #[test]
+    fn release_signing_keeps_the_pinned_engine_and_refuses_another() {
+        let dir = scratch("release");
+        let app = dir.join("Fake.app");
+        std::fs::create_dir_all(app.join("Contents")).expect("bundle");
+        std::fs::write(
+            app.join("Contents/Info.plist"),
+            r#"<?xml version="1.0" encoding="UTF-8"?>
+<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
+<plist version="1.0"><dict>
+<key>CFBundleExecutable</key><string>fake</string>
+<key>CFBundleIdentifier</key><string>io.cdot.airs-v2.signing-test</string>
+<key>CFBundlePackageType</key><string>APPL</string>
+</dict></plist>
+"#,
+        )
+        .expect("plist");
+        macho(&app.join("Contents/MacOS/fake"));
+        let staged = dir.join("staged");
+        let source = dir.join("src/airs-harness");
+        macho(&source);
+        let unsigned = file_sha256(&source).expect("hash");
+        let signed = sign_engine(&source, &unsigned, &staged, AD_HOC).expect("engine");
+        let engine = app.join("Contents/Resources/harness/airs-harness");
+        std::fs::create_dir_all(engine.parent().expect("parent")).expect("dir");
+        std::fs::copy(staged.join("airs-harness"), &engine).expect("engine");
+        let rel = release(&app, &dir, AD_HOC);
+        let exe_before = file_sha256(&app.join("Contents/MacOS/fake")).expect("hash");
+
+        // An engine other than the pinned one is refused before anything is signed.
+        assert!(execute(&rel, &unsigned, false).is_err());
+        assert_eq!(
+            file_sha256(&app.join("Contents/MacOS/fake")).expect("hash"),
+            exe_before
+        );
+
+        let record = execute(&rel, &signed.signed_sha256, false).expect("signed");
+        assert!(!record.notarized);
+        assert_eq!(
+            record.before_signing.engine_sha256.as_deref(),
+            Some(signed.signed_sha256.as_str())
+        );
+        assert_eq!(
+            record.after_signing.engine_sha256,
+            record.before_signing.engine_sha256
+        );
+        assert_ne!(
+            record.after_signing.executable_sha256,
+            record.before_signing.executable_sha256
+        );
+        assert_ne!(
+            record.after_signing.app_tree_sha256,
+            record.before_signing.app_tree_sha256
+        );
+        assert_eq!(record.steps.len(), 2);
+        verify(&app).expect("app verifies");
+        let _ = std::fs::remove_dir_all(&dir);
+    }
+}
