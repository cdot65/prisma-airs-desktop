diff --git a/crates/xtask/src/live.rs b/crates/xtask/src/live.rs
new file mode 100644
index 00000000..33a6f361
--- /dev/null
+++ b/crates/xtask/src/live.rs
@@ -0,0 +1,474 @@
+//! The controlled live scope (C25): the owner-approved private execution
+//! manifest and the access report derived from it.
+//!
+//! The manifest names accounts, environments, permitted operations, budgets
+//! and cleanup for every live family L01–L18 (`docs/planning/live-checks.md`,
+//! `release-contract.md`). It lives outside the repository, readable only by
+//! its owner, and names each secret by where it is stored, never by value.
+//! Validation never resolves a secret. A family without designated access is
+//! blocked, never dropped: every required workflow row reports which of its
+//! families are blocked.
+
+use std::collections::BTreeMap;
+use std::path::Path;
+
+use serde::{Deserialize, Serialize};
+
+use crate::ledger::Ledger;
+use crate::{Repo, Result, invalid, io_err, now_utc, read_json, sha256_hex, write_json};
+
+pub const SCHEMA: &str = "airs-v2/live-manifest/1";
+pub const REPORT_SCHEMA: &str = "airs-v2/live-scope/1";
+pub const REPORT: &str = "docs/planning/evidence/C25/live-scope.json";
+const LEDGER: &str = "docs/architecture/workflow-ledger.json";
+/// Keychain services a manifest may name: v2 test items only.
+pub const V2_SERVICE_PREFIX: &str = "io.cdot.prisma-airs-desktop.v2.";
+/// v1's own Keychain service, which C25 never touches.
+pub const V1_SERVICE: &str = "io.cdot.prisma-airs-desktop";
+pub const NO_MANIFEST: &str = "no owner-approved live manifest";
+
+/// Families whose operations change remote state: each needs disposable
+/// names and cleanup.
+pub const MUTATING: [&str; 5] = ["L03", "L04", "L08", "L13", "L17"];
+/// Families that consume scans, inference or assessments: each needs a
+/// budget.
+pub const CONSUMING: [&str; 5] = ["L01", "L09", "L12", "L13", "L16"];
+
+pub fn families() -> Vec<String> {
+    (1..=18).map(|n| format!("L{n:02}")).collect()
+}
+
+#[derive(Clone, Debug, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct Approval {
+    pub approved_by: String,
+    pub approved_utc: String,
+    pub decision: String,
+}
+
+#[derive(Clone, Debug, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct Environment {
+    pub kind: String,
+}
+
+/// Where a secret is stored. The manifest never holds the value.
+#[derive(Clone, Debug, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(tag = "kind", rename_all = "lowercase", deny_unknown_fields)]
+pub enum SecretRef {
+    Keychain { service: String, account: String },
+    File { path: String },
+}
+
+impl SecretRef {
+    fn reference(&self) -> String {
+        match self {
+            Self::Keychain { service, account } => format!("keychain:{service}/{account}"),
+            Self::File { path } => format!("file:{path}"),
+        }
+    }
+}
+
+#[derive(Clone, Debug, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct Family {
+    pub status: String,
+    #[serde(default)]
+    pub reason: String,
+    #[serde(default)]
+    pub environment: String,
+    #[serde(default)]
+    pub credentials: BTreeMap<String, SecretRef>,
+    #[serde(default)]
+    pub nonsecret: BTreeMap<String, String>,
+    #[serde(default)]
+    pub permitted_operations: Vec<String>,
+    #[serde(default)]
+    pub disposable_prefix: Option<String>,
+    #[serde(default)]
+    pub budget: BTreeMap<String, u64>,
+    #[serde(default)]
+    pub cleanup: Vec<String>,
+    #[serde(default)]
+    pub irreversible_exclusions: Vec<String>,
+}
+
+impl Family {
+    fn designated(&self) -> bool {
+        self.status == "designated"
+    }
+}
+
+#[derive(Clone, Debug, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct LiveManifest {
+    pub schema: String,
+    /// Free text for the operator; never read as scope.
+    #[serde(default)]
+    pub note: String,
+    pub owner_approval: Approval,
+    pub environments: BTreeMap<String, Environment>,
+    pub families: BTreeMap<String, Family>,
+}
+
+/// A nonsecret key that names a secret.
+fn secret_name(key: &str) -> bool {
+    key.to_ascii_lowercase()
+        .split(|c: char| !c.is_ascii_alphanumeric())
+        .any(|t| {
+            matches!(
+                t,
+                "secret"
+                    | "password"
+                    | "passwd"
+                    | "token"
+                    | "key"
+                    | "apikey"
+                    | "credential"
+                    | "credentials"
+                    | "privatekey"
+            )
+        })
+}
+
+/// A nonsecret value that looks like a secret: a PEM block, a signed token
+/// (JWT), or a long mixed-case alphanumeric run. URLs, numeric IDs and
+/// lowercase UUIDs are not.
+fn secret_value(value: &str) -> bool {
+    if value.contains("-----BEGIN") {
+        return true;
+    }
+    if value.starts_with("eyJ") && value.matches('.').count() >= 2 {
+        return true;
+    }
+    value
+        .split(|c: char| !(c.is_ascii_alphanumeric() || "_-+/=".contains(c)))
+        .any(|run| {
+            run.len() >= 32
+                && run.bytes().any(|b| b.is_ascii_uppercase())
+                && run.bytes().any(|b| b.is_ascii_lowercase())
+                && run.bytes().any(|b| b.is_ascii_digit())
+        })
+}
+
+fn inside(repo: &Repo, path: &Path) -> bool {
+    let root = repo
+        .root()
+        .canonicalize()
+        .unwrap_or(repo.root().to_path_buf());
+    let full = path.canonicalize().unwrap_or(path.to_path_buf());
+    full.starts_with(&root) || path.starts_with(repo.root())
+}
+
+/// Reasons the manifest is not an acceptable scope (empty when it is).
+pub fn check(repo: &Repo, manifest: &LiveManifest) -> Vec<String> {
+    let mut failures = Vec::new();
+    if manifest.schema != SCHEMA {
+        failures.push(format!("schema {} is not {SCHEMA}", manifest.schema));
+    }
+    let a = &manifest.owner_approval;
+    if [&a.approved_by, &a.approved_utc, &a.decision]
+        .iter()
+        .any(|v| v.trim().is_empty())
+    {
+        failures.push("the owner approval is incomplete".to_owned());
+    }
+    for (name, env) in &manifest.environments {
+        if env.kind != "staging" && env.kind != "test" {
+            failures.push(format!(
+                "environment {name} is {}; only staging or test is allowed",
+                env.kind
+            ));
+        }
+    }
+    let ids = families();
+    for id in &ids {
+        if !manifest.families.contains_key(id) {
+            failures.push(format!(
+                "{id} is missing; an undesignated family is blocked, not omitted"
+            ));
+        }
+    }
+    for (id, family) in &manifest.families {
+        if !ids.contains(id) {
+            failures.push(format!("{id} is not a live family"));
+            continue;
+        }
+        for (key, value) in &family.nonsecret {
+            if secret_name(key) {
+                failures.push(format!(
+                    "{id} nonsecret {key} names a secret; use a credential reference"
+                ));
+            } else if secret_value(value) {
+                failures.push(format!("{id} nonsecret {key} looks like a secret value"));
+            }
+        }
+        for (name, secret) in &family.credentials {
+            match secret {
+                SecretRef::Keychain { service, account } => {
+                    if service == V1_SERVICE || !service.starts_with(V2_SERVICE_PREFIX) {
+                        failures.push(format!(
+                            "{id} credential {name} names Keychain service {service}; only {V2_SERVICE_PREFIX}* test items"
+                        ));
+                    }
+                    if account.trim().is_empty() {
+                        failures.push(format!("{id} credential {name} has no Keychain account"));
+                    }
+                }
+                SecretRef::File { path } => {
+                    let p = Path::new(path);
+                    if !p.is_absolute() {
+                        failures.push(format!("{id} credential {name} file path is not absolute"));
+                    } else if inside(repo, p) {
+                        failures.push(format!(
+                            "{id} credential {name} file is inside the repository"
+                        ));
+                    }
+                }
+            }
+        }
+        match family.status.as_str() {
+            "blocked" => {
+                if family.reason.trim().is_empty() {
+                    failures.push(format!("{id} is blocked without a reason"));
+                }
+            }
+            "designated" => {
+                if !manifest.environments.contains_key(&family.environment) {
+                    failures.push(format!(
+                        "{id} names unknown environment {:?}",
+                        family.environment
+                    ));
+                }
+                if family.permitted_operations.is_empty() {
+                    failures.push(format!("{id} is designated with no permitted operations"));
+                }
+                if MUTATING.contains(&id.as_str())
+                    && (family
+                        .disposable_prefix
+                        .as_deref()
+                        .is_none_or(|p| p.trim().is_empty())
+                        || family.cleanup.is_empty())
+                {
+                    failures.push(format!(
+                        "{id} changes remote state and needs a disposable prefix and cleanup"
+                    ));
+                }
+                if CONSUMING.contains(&id.as_str()) && family.budget.is_empty() {
+                    failures.push(format!("{id} consumes service capacity and needs a budget"));
+                }
+            }
+            other => failures.push(format!("{id} status {other} is not designated or blocked")),
+        }
+    }
+    if let (Some(l01), Some(l18)) = (manifest.families.get("L01"), manifest.families.get("L18"))
+        && l01.designated()
+        && l18.designated()
+    {
+        if l01.environment == l18.environment {
+            failures
+                .push("L18 shares L01's environment; isolation needs a distinct scope".to_owned());
+        }
+        if l18
+            .credentials
+            .values()
+            .any(|s| l01.credentials.values().any(|t| t == s))
+        {
+            failures.push(
+                "L18 shares a credential reference with L01; isolation needs distinct credentials"
+                    .to_owned(),
+            );
+        }
+    }
+    failures
+}
+
+/// Reads and checks a private manifest file; returns it with its sha256.
+pub fn load(repo: &Repo, path: &Path) -> Result<(LiveManifest, String)> {
+    if inside(repo, path) {
+        return Err(invalid(format!(
+            "{} is inside the repository; the live manifest is private",
+            path.display()
+        )));
+    }
+    #[cfg(unix)]
+    {
+        use std::os::unix::fs::PermissionsExt;
+        let mode = std::fs::metadata(path)
+            .map_err(io_err(path))?
+            .permissions()
+            .mode();
+        if mode & 0o077 != 0 {
+            return Err(invalid(format!(
+                "{} is readable by group or others (mode {:o}); use 0600",
+                path.display(),
+                mode & 0o777
+            )));
+        }
+    }
+    let bytes = std::fs::read(path).map_err(io_err(path))?;
+    let manifest: LiveManifest =
+        serde_json::from_slice(&bytes).map_err(|source| crate::Error::Json {
+            path: path.to_path_buf(),
+            source,
+        })?;
+    let failures = check(repo, &manifest);
+    if !failures.is_empty() {
+        return Err(invalid(format!(
+            "the live manifest is not acceptable: {}",
+            failures.join("; ")
+        )));
+    }
+    Ok((manifest, sha256_hex(&bytes)))
+}
+
+#[derive(Clone, Debug, PartialEq, Eq, Serialize, Deserialize)]
+pub struct CredentialName {
+    pub name: String,
+    pub reference: String,
+}
+
+#[derive(Clone, Debug, PartialEq, Eq, Serialize, Deserialize)]
+pub struct FamilyAccess {
+    pub id: String,
+    pub status: String,
+    pub reason: String,
+    pub environment: String,
+    pub environment_kind: Option<String>,
+    pub credentials: Vec<CredentialName>,
+}
+
+#[derive(Clone, Debug, PartialEq, Eq, Serialize, Deserialize)]
+pub struct RowAccess {
+    pub id: String,
+    pub workflow: String,
+    pub families: Vec<String>,
+    pub access_status: String,
+    pub blocked_families: Vec<String>,
+    pub owner: Option<String>,
+}
+
+#[derive(Clone, Debug, PartialEq, Eq, Serialize, Deserialize)]
+pub struct Summary {
+    pub families_designated: usize,
+    pub families_blocked: usize,
+    pub rows_required: usize,
+    pub rows_designated: usize,
+    pub rows_blocked: usize,
+    pub rows_owned_by_c26: usize,
+}
+
+#[derive(Clone, Debug, PartialEq, Eq, Serialize, Deserialize)]
+pub struct Report {
+    pub schema: String,
+    pub generated_utc: String,
+    pub manifest_sha256: Option<String>,
+    pub owner_approval: Option<Approval>,
+    pub families: Vec<FamilyAccess>,
+    pub rows: Vec<RowAccess>,
+    pub summary: Summary,
+}
+
+fn row_families(live_column: &str) -> Vec<String> {
+    let mut out: Vec<String> = live_column
+        .split(|c: char| !c.is_ascii_alphanumeric())
+        .filter(|t| {
+            t.len() == 3 && t.starts_with('L') && t[1..].bytes().all(|b| b.is_ascii_digit())
+        })
+        .map(str::to_owned)
+        .collect();
+    out.sort();
+    out.dedup();
+    out
+}
+
+/// Maps every required ledger row to its families' access under `scope`
+/// (none: every family blocked).
+pub fn report(ledger: &Ledger, scope: Option<(&LiveManifest, &str)>) -> Report {
+    let families: Vec<FamilyAccess> = self::families()
+        .into_iter()
+        .map(
+            |id| match scope.and_then(|(m, _)| m.families.get(&id).map(|f| (m, f))) {
+                Some((m, f)) => FamilyAccess {
+                    status: f.status.clone(),
+                    reason: f.reason.clone(),
+                    environment: f.environment.clone(),
+                    environment_kind: m.environments.get(&f.environment).map(|e| e.kind.clone()),
+                    credentials: f
+                        .credentials
+                        .iter()
+                        .map(|(name, s)| CredentialName {
+                            name: name.clone(),
+                            reference: s.reference(),
+                        })
+                        .collect(),
+                    id,
+                },
+                None => FamilyAccess {
+                    id,
+                    status: "blocked".to_owned(),
+                    reason: NO_MANIFEST.to_owned(),
+                    environment: String::new(),
+                    environment_kind: None,
+                    credentials: Vec::new(),
+                },
+            },
+        )
+        .collect();
+    let designated = |id: &str| {
+        families
+            .iter()
+            .any(|f| f.id == id && f.status == "designated")
+    };
+    let rows: Vec<RowAccess> = ledger
+        .rows
+        .iter()
+        .filter(|r| r.live.requirement == "required")
+        .map(|r| {
+            let fams = row_families(&r.live_column);
+            let blocked: Vec<String> = fams.iter().filter(|f| !designated(f)).cloned().collect();
+            let (access_status, owner) = if fams.is_empty() {
+                ("final-artifact".to_owned(), Some("C26".to_owned()))
+            } else if blocked.is_empty() {
+                ("designated".to_owned(), None)
+            } else {
+                ("blocked-by-access".to_owned(), None)
+            };
+            RowAccess {
+                id: r.id.clone(),
+                workflow: r.workflow.clone(),
+                families: fams,
+                access_status,
+                blocked_families: blocked,
+                owner,
+            }
+        })
+        .collect();
+    let count = |s: &str| rows.iter().filter(|r| r.access_status == s).count();
+    let summary = Summary {
+        families_designated: families.iter().filter(|f| f.status == "designated").count(),
+        families_blocked: families.iter().filter(|f| f.status != "designated").count(),
+        rows_required: rows.len(),
+        rows_designated: count("designated"),
+        rows_blocked: count("blocked-by-access"),
+        rows_owned_by_c26: count("final-artifact"),
+    };
+    Report {
+        schema: REPORT_SCHEMA.to_owned(),
+        generated_utc: now_utc(),
+        manifest_sha256: scope.map(|(_, sha)| sha.to_owned()),
+        owner_approval: scope.map(|(m, _)| m.owner_approval.clone()),
+        families,
+        rows,
+        summary,
+    }
+}
+
+/// Validates the scope (if any) and writes the C25 access report.
+pub fn run(repo: &Repo, scope: Option<&Path>) -> Result<Report> {
+    let ledger: Ledger = read_json(&repo.join(LEDGER))?;
+    let loaded = scope.map(|p| load(repo, p)).transpose()?;
+    let record = report(&ledger, loaded.as_ref().map(|(m, sha)| (m, sha.as_str())));
+    write_json(&repo.join(REPORT), &record)?;
+    Ok(record)
+}
diff --git a/crates/xtask/src/live_academy.rs b/crates/xtask/src/live_academy.rs
new file mode 100644
index 00000000..83e551e0
--- /dev/null
+++ b/crates/xtask/src/live_academy.rs
@@ -0,0 +1,657 @@
+//! Academy families (C25), sharing one learner sign-in: L11 identity and
+//! access, L12 learning, L13 assessment and account, L14 local work.
+//!
+//! The device sign-in is the operator's: the core starts it and opens
+//! Academy's verification page (through the host's browser adapter); the
+//! operator approves it with the designated test identity, and the runner
+//! only waits, bounded, for the core to show the account signed in. Learner
+//! calls go through the production `academyCall` intent and the offline
+//! intents; which procedures a family calls, with which synthetic inputs,
+//! is the family's `call.*` entries, and a mutation must also be listed in
+//! its permitted operations. No credential of a learner is ever seen here.
+
+use std::collections::BTreeMap;
+
+use desktop_core::learner::{LEARNER_PROCEDURES, ProcedureKind};
+use serde_json::{Value, json};
+use sha2::{Digest, Sha256};
+
+use crate::live_run::{Desk, DeskOptions, Found, Outcomes, Run, Spec, Stop, operator_step};
+use crate::{Result, now_utc};
+
+pub const FAMILIES: [&str; 4] = ["L11", "L12", "L13", "L14"];
+
+const SIGN_IN: Spec = Spec {
+    id: "L11-device-sign-in",
+    workflows: &["W49"],
+};
+const ADMISSION: Spec = Spec {
+    id: "L11-protected-admission",
+    workflows: &["W49"],
+};
+const SWITCH: Spec = Spec {
+    id: "L11-account-switch",
+    workflows: &["W49"],
+};
+const SIGN_OUT: Spec = Spec {
+    id: "L11-sign-out-revoke",
+    workflows: &["W49"],
+};
+const AVATAR: Spec = Spec {
+    id: "L13-avatar",
+    workflows: &["W54"],
+};
+
+/// The workflows each family's calls may claim.
+fn claimable(family: &str) -> &'static [&'static str] {
+    match family {
+        "L12" => &["W50", "W51", "W52", "W65"],
+        "L13" => &["W52", "W53", "W54", "W65", "W66"],
+        "L14" => &["W55", "W56"],
+        _ => &[],
+    }
+}
+const DOWNLOAD: Spec = Spec {
+    id: "L14-download-lease",
+    workflows: &["W55"],
+};
+const DRAFT: Spec = Spec {
+    id: "L14-local-draft",
+    workflows: &["W55"],
+};
+const DENIAL: Spec = Spec {
+    id: "L14-access-change-denied",
+    workflows: &["W56"],
+};
+
+/// An 8×8 PNG: the synthetic avatar (re-encoded by the core before upload).
+const AVATAR_PNG: &[u8] = &[
+    0x89, 0x50, 0x4E, 0x47, 0x0D, 0x0A, 0x1A, 0x0A, 0x00, 0x00, 0x00, 0x0D, 0x49, 0x48, 0x44, 0x52,
+    0x00, 0x00, 0x00, 0x08, 0x00, 0x00, 0x00, 0x08, 0x08, 0x02, 0x00, 0x00, 0x00, 0x4B, 0x6D, 0x29,
+    0xDC, 0x00, 0x00, 0x00, 0x11, 0x49, 0x44, 0x41, 0x54, 0x78, 0xDA, 0x63, 0xD0, 0xCE, 0xD9, 0x80,
+    0x15, 0x31, 0x0C, 0x2D, 0x09, 0x00, 0xD0, 0x59, 0x51, 0xC1, 0x19, 0x34, 0xF9, 0xFA, 0x00, 0x00,
+    0x00, 0x00, 0x49, 0x45, 0x4E, 0x44, 0xAE, 0x42, 0x60, 0x82,
+];
+
+pub(crate) struct Shared {
+    pub families: Vec<(String, Outcomes)>,
+    pub stop: Option<Stop>,
+}
+
+struct Ctx<'r, 'a> {
+    run: &'r mut Run<'a>,
+    outcomes: BTreeMap<String, Outcomes>,
+    stop: Option<Stop>,
+}
+
+impl Ctx<'_, '_> {
+    fn settle(
+        &mut self,
+        family: &str,
+        spec: Spec,
+        started: String,
+        inputs: BTreeMap<String, Value>,
+        found: Found,
+    ) -> Result<()> {
+        let outcomes = self.outcomes.entry(family.to_owned()).or_default();
+        let stop = self
+            .run
+            .settle(family, spec, started, inputs, found, None, outcomes)?;
+        if self.stop.is_none() {
+            self.stop = stop;
+        }
+        Ok(())
+    }
+
+    fn block(&mut self, family: &str, spec: Spec, reason: &str) -> Result<()> {
+        self.settle(
+            family,
+            spec,
+            now_utc(),
+            BTreeMap::new(),
+            Found::blocked(reason),
+        )
+    }
+}
+
+fn state(j: &Value) -> String {
+    j["academy"]["state"].as_str().unwrap_or("").to_owned()
+}
+
+fn account_hash(j: &Value) -> Option<String> {
+    j["academy"]["accountId"].as_str().map(|a| {
+        let digest = Sha256::digest(a.as_bytes());
+        hex::encode(&digest[..8])
+    })
+}
+
+fn learner(j: &Value) -> Value {
+    j["learner"].clone()
+}
+
+/// Starts the device sign-in and waits for the operator to approve it.
+async fn sign_in(run: &Run<'_>, desk: &mut Desk, family: &str) -> Result<(Found, Option<String>)> {
+    desk.send_json(json!({"kind": "startAcademySignIn"}))
+        .await?;
+    let awaiting = desk
+        .until(desk.settle, |j| {
+            matches!(state(j).as_str(), "awaitingApproval" | "failed")
+        })
+        .await;
+    match awaiting {
+        Some(j) if state(&j) == "awaitingApproval" => {}
+        Some(j) => {
+            return Ok((
+                Found::failed("the sign-in could not start")
+                    .with("academy", j["academy"]["failure"].clone()),
+                None,
+            ));
+        }
+        None => return Ok((Found::failed("the sign-in did not start in time"), None)),
+    }
+    // The core opens the verification page through the host; the operator
+    // completes it there.
+    desk.send_json(json!({"kind": "openAcademyVerification"}))
+        .await?;
+    let bound = run.operator_timeout(family);
+    let (completed, step) = {
+        let desk = &*desk;
+        operator_step(
+            run.operator.as_ref(),
+            "academy-device-sign-in",
+            "approve the Academy device sign-in with the designated test learner",
+            None,
+            bound,
+            // A failed sign-in ends the wait; the core's state judges it.
+            async || {
+                desk.json()
+                    .map(|j| matches!(state(&j).as_str(), "signedIn" | "failed"))
+                    .unwrap_or(false)
+            },
+        )
+        .await
+    };
+    let j = desk.json()?;
+    let signed_in = completed && state(&j) == "signedIn";
+    let mut found = Found::check(
+        signed_in,
+        "the operator approved the device sign-in and the core shows the learner signed in",
+        if completed {
+            "the device sign-in failed"
+        } else {
+            "the device sign-in was not completed within the bound"
+        },
+    )
+    .with("state", json!(state(&j)))
+    .with("failure", j["academy"]["failure"].clone())
+    .with("vault", j["academy"]["vault"].clone());
+    found.operator_step = Some(step);
+    let hash = account_hash(&j);
+    if let Some(h) = &hash {
+        found = found.with("account_sha256_prefix", json!(h));
+    }
+    Ok((found, hash))
+}
+
+/// One designated learner call: its label, procedure, kind and input.
+struct Call {
+    label: String,
+    /// The workflows this call is evidence for, as its entry names them.
+    workflows: &'static [&'static str],
+    procedure: String,
+    kind: ProcedureKind,
+    input: Option<String>,
+}
+
+/// Parses the family's `call.*` entries, each `<workflows> <procedure>
+/// [<input>]`: the workflow IDs (comma-separated, among those the family may
+/// claim) the call is evidence for, the procedure, and its input. A call
+/// counts only for the workflows it names.
+fn program(run: &Run<'_>, family: &str) -> std::result::Result<Vec<Call>, String> {
+    let Ok(f) = run.family(family) else {
+        return Ok(Vec::new());
+    };
+    let allowed = claimable(family);
+    let mut calls = Vec::new();
+    for (key, value) in &f.nonsecret {
+        let Some(label) = key.strip_prefix("call.") else {
+            continue;
+        };
+        let (tags, rest) = value
+            .split_once(' ')
+            .ok_or_else(|| format!("{key} names no workflow and procedure"))?;
+        let mut workflows = Vec::new();
+        for tag in tags.split(',') {
+            let w = allowed
+                .iter()
+                .find(|w| **w == tag)
+                .ok_or_else(|| format!("{key}: {tag} is not a workflow {family} may claim"))?;
+            workflows.push(*w);
+        }
+        let (procedure, input) = match rest.trim().split_once(' ') {
+            Some((p, i)) => (p.to_owned(), Some(i.trim().to_owned())),
+            None => (rest.trim().to_owned(), None),
+        };
+        let kind = LEARNER_PROCEDURES
+            .iter()
+            .find(|(p, _)| *p == procedure)
+            .map(|(_, k)| *k)
+            .ok_or_else(|| format!("{procedure} is not a learner procedure"))?;
+        if kind == ProcedureKind::Mutation && !f.permitted_operations.contains(&procedure) {
+            return Err(format!(
+                "{procedure} changes learner state but is not a permitted operation of {family}"
+            ));
+        }
+        if let Some(input) = &input
+            && serde_json::from_str::<Value>(input).is_err()
+        {
+            return Err(format!("{key}: the input is not JSON"));
+        }
+        calls.push(Call {
+            label: label.to_owned(),
+            workflows: Box::leak(workflows.into_boxed_slice()),
+            procedure,
+            kind,
+            input,
+        });
+    }
+    Ok(calls)
+}
+
+fn result_found(result: &Value) -> Found {
+    let kind = result["kind"].as_str().unwrap_or("");
+    let mut found = Found::check(
+        kind == "data",
+        "the hosted procedure answered",
+        "the hosted procedure did not answer with data",
+    )
+    .with("result", json!(kind))
+    .with("http_status", result["httpStatus"].clone())
+    .with("failure", result["failure"].clone())
+    .with("outcome", result["outcome"].clone());
+    if kind == "error" && result["outcome"] == "unknown" {
+        found = found.stopping("a learner mutation may or may not have taken effect", true);
+    }
+    found
+}
+
+async fn call(
+    desk: &mut Desk,
+    procedure: &str,
+    kind: ProcedureKind,
+    input: Option<&str>,
+) -> Result<Value> {
+    let learner = learner(&desk.json()?);
+    desk.academy(
+        json!({"kind": "academyCall", "learner": learner, "procedure": procedure,
+        "procedureKind": if kind == ProcedureKind::Mutation { "mutation" } else { "query" },
+        "input": input}),
+    )
+    .await
+}
+
+fn leak(name: String) -> &'static str {
+    Box::leak(name.into_boxed_str())
+}
+
+pub(crate) async fn run(run: &mut Run<'_>, families: &[String]) -> Result<Shared> {
+    let mut ctx = Ctx {
+        run,
+        outcomes: BTreeMap::new(),
+        stop: None,
+    };
+    let wants = |f: &str| families.iter().any(|x| x == f);
+    let origin = FAMILIES
+        .iter()
+        .filter(|f| wants(f))
+        .find_map(|f| ctx.run.nonsecret(f, "academy_origin"));
+    let lead = FAMILIES.iter().copied().find(|f| wants(f)).unwrap_or("L11");
+    let offline = if wants("L14") {
+        Some(ctx.run.folder("offline")?)
+    } else {
+        None
+    };
+    let mut desk = ctx.run.desk(DeskOptions {
+        offline_root: offline,
+        academy_origin: origin.filter(|o| o.starts_with("https://")),
+        image: wants("L13").then(|| AVATAR_PNG.to_vec()),
+        ..DeskOptions::default()
+    })?;
+
+    let started = now_utc();
+    let (found, account) = sign_in(ctx.run, &mut desk, lead).await?;
+    let signed_in = found.outcome == "passed";
+    let sign_in_family = if wants("L11") { "L11" } else { lead };
+    ctx.settle(
+        sign_in_family,
+        SIGN_IN,
+        started,
+        ctx.run.inputs(sign_in_family, &[]),
+        found,
+    )?;
+    if !signed_in {
+        for family in families {
+            let spec = Spec {
+                id: leak(format!("{family}-after-sign-in")),
+                workflows: &[],
+            };
+            ctx.block(family, spec, "the learner was not signed in")?;
+        }
+        return Ok(finish(ctx, families));
+    }
+
+    if wants("L11") {
+        let started = now_utc();
+        let me = call(&mut desk, "desktop.me", ProcedureKind::Query, None).await?;
+        // Academy's access check takes the courses to check (the designated
+        // course, when there is one).
+        let courses: Vec<String> = ctx.run.nonsecret("L14", "course_id").into_iter().collect();
+        let input = json!({"json": {"courseIds": courses}}).to_string();
+        let access = call(
+            &mut desk,
+            "desktop.access",
+            ProcedureKind::Query,
+            Some(&input),
+        )
+        .await?;
+        let found = Found::check(
+            me["kind"] == "data" && access["kind"] == "data",
+            "protected learner procedures were admitted with the signed-in learner's token",
+            "a protected learner procedure was not admitted",
+        )
+        .with("desktop.me", me["kind"].clone())
+        .with("desktop.access", access["kind"].clone());
+        ctx.settle("L11", ADMISSION, started, ctx.run.inputs("L11", &[]), found)?;
+    }
+
+    for family in ["L12", "L13", "L14"] {
+        if !wants(family) || ctx.stop.is_some() {
+            continue;
+        }
+        match program(ctx.run, family) {
+            Err(e) => {
+                let spec = Spec {
+                    id: leak(format!("{family}-calls")),
+                    workflows: &[],
+                };
+                ctx.block(family, spec, &e)?;
+            }
+            Ok(calls) => {
+                if calls.is_empty() && family != "L14" {
+                    let spec = Spec {
+                        id: leak(format!("{family}-calls")),
+                        workflows: &[],
+                    };
+                    ctx.block(
+                        family,
+                        spec,
+                        &format!("{family} designates no call.* procedures"),
+                    )?;
+                }
+                for Call {
+                    label,
+                    workflows,
+                    procedure,
+                    kind,
+                    input,
+                } in calls
+                {
+                    if ctx.stop.is_some() {
+                        break;
+                    }
+                    let spec = Spec {
+                        id: leak(format!("{family}-call-{label}")),
+                        workflows,
+                    };
+                    let started = now_utc();
+                    let mut inputs = BTreeMap::new();
+                    inputs.insert("procedure".to_owned(), json!(procedure));
+                    inputs.insert("input".to_owned(), json!(input));
+                    // Charged before it is sent: an exhausted budget sends nothing.
+                    if let Err(e) = ctx.run.guard.spend(family, "calls", 1) {
+                        let found = Found::blocked(e.clone())
+                            .stopping(format!("unexpected cost: {e}"), false);
+                        ctx.settle(family, spec, started, inputs, found)?;
+                        break;
+                    }
+                    let result = call(&mut desk, &procedure, kind, input.as_deref()).await?;
+                    let mut found = result_found(&result);
+                    if kind == ProcedureKind::Mutation {
+                        found.cleanup =
+                            "synthetic coursework on a test account (owner-designated)".to_owned();
+                    }
+                    ctx.settle(family, spec, started, inputs, found)?;
+                }
+            }
+        }
+    }
+
+    if wants("L13") && ctx.stop.is_none() {
+        let started = now_utc();
+        let permitted = ctx
+            .run
+            .family("L13")
+            .map(|f| {
+                f.permitted_operations
+                    .iter()
+                    .any(|o| o == "settings.removeAvatar")
+            })
+            .unwrap_or(false);
+        let found = if !permitted {
+            Found::blocked(
+                "an avatar upload needs settings.removeAvatar among L13's permitted operations, to undo it",
+            )
+        } else if let Err(e) = ctx.run.guard.spend("L13", "calls", 2) {
+            // The upload and its removal, charged before either is sent.
+            Found::blocked(e.clone()).stopping(format!("unexpected cost: {e}"), false)
+        } else {
+            let learner = learner(&desk.json()?);
+            let uploaded = desk
+                .academy(json!({"kind": "uploadAvatar", "learner": learner}))
+                .await?;
+            let removed = call(
+                &mut desk,
+                "settings.removeAvatar",
+                ProcedureKind::Mutation,
+                None,
+            )
+            .await?;
+            let mut found = Found::check(
+                uploaded["kind"] == "data" && removed["kind"] == "data",
+                "a synthetic avatar was bounded, re-encoded and uploaded, then removed",
+                "the avatar upload or its removal did not complete",
+            )
+            .with("upload", uploaded["kind"].clone())
+            .with("upload_failure", uploaded["failure"].clone())
+            .with("remove", removed["kind"].clone());
+            found.cleanup = "removed with settings.removeAvatar".to_owned();
+            found
+        };
+        ctx.settle("L13", AVATAR, started, BTreeMap::new(), found)?;
+    }
+
+    if wants("L14") && ctx.stop.is_none() {
+        l14(&mut ctx, &mut desk).await?;
+    }
+
+    if wants("L11") && ctx.stop.is_none() {
+        let started = now_utc();
+        let before = learner(&desk.json()?);
+        desk.send_json(json!({"kind": "signOutAcademy"})).await?;
+        let out = desk
+            .until(desk.settle, |j| state(j) == "signedOut")
+            .await
+            .is_some();
+        // The retired learner reference is refused by the core afterwards.
+        let refused = desk
+            .send_json(
+                json!({"kind": "academyCall", "learner": before, "procedure": "desktop.me",
+                "procedureKind": "query", "input": null}),
+            )
+            .await
+            .is_err();
+        let found = Found::check(
+            out && refused,
+            "signed out: the session was deleted, its refresh token revoked, and the old learner is refused",
+            "sign-out did not retire the learner",
+        );
+        ctx.settle("L11", SIGN_OUT, started, BTreeMap::new(), found)?;
+
+        let started = now_utc();
+        let found = if ctx.run.nonsecret("L11", "second_account").as_deref() == Some("designated") {
+            let (found, second) = sign_in(ctx.run, &mut desk, "L11").await?;
+            let switched = found.outcome == "passed" && second.is_some() && second != account;
+            let mut found = Found {
+                outcome: if switched { "passed" } else { "failed" },
+                detail: if switched {
+                    "a second test learner signed in; the account changed and nothing of the first carried over".to_owned()
+                } else {
+                    "the second sign-in did not show a different account".to_owned()
+                },
+                ..found
+            };
+            desk.send_json(json!({"kind": "signOutAcademy"})).await?;
+            found.cleanup = "signed out again".to_owned();
+            found
+        } else {
+            Found::blocked("L11 designates no second_account for the account switch")
+        };
+        ctx.settle("L11", SWITCH, started, BTreeMap::new(), found)?;
+    } else if ctx.stop.is_none() {
+        desk.send_json(json!({"kind": "signOutAcademy"})).await?;
+    }
+    Ok(finish(ctx, families))
+}
+
+async fn l14(ctx: &mut Ctx<'_, '_>, desk: &mut Desk) -> Result<()> {
+    let Some(course) = ctx.run.nonsecret("L14", "course_id") else {
+        for spec in [DOWNLOAD, DRAFT, DENIAL] {
+            ctx.block("L14", spec, "L14 designates no course_id")?;
+        }
+        return Ok(());
+    };
+    let started = now_utc();
+    let learner_ref = learner(&desk.json()?);
+    let downloaded = desk
+        .academy(json!({"kind": "downloadCourse", "learner": learner_ref, "courseId": course}))
+        .await?;
+    let mut found = result_found(&downloaded);
+    found.detail = if found.outcome == "passed" {
+        "the client-safe course was downloaded under its lease and sealed for this account"
+            .to_owned()
+    } else {
+        "the course could not be downloaded".to_owned()
+    };
+    found.cleanup = "removed at the end of the family".to_owned();
+    let mut inputs = BTreeMap::new();
+    inputs.insert("course_id".to_owned(), json!(course));
+    ctx.settle("L14", DOWNLOAD, started, inputs.clone(), found)?;
+
+    let started = now_utc();
+    let found = match ctx.run.nonsecret("L14", "attempt_id") {
+        None => Found::blocked("L14 designates no attempt_id"),
+        Some(attempt) => {
+            let base: u32 = ctx
+                .run
+                .nonsecret("L14", "base_version")
+                .and_then(|b| b.parse().ok())
+                .unwrap_or(0);
+            let draft = "C25 synthetic local draft";
+            // Lab work is a JSON object, as the learner page keeps it.
+            let saved = desk
+                .academy(
+                    json!({"kind": "saveLocalDraft", "learner": learner_ref, "attemptId": attempt,
+                    "baseVersion": base, "draft": json!({"c25": draft}).to_string()}),
+                )
+                .await?;
+            let loaded = desk
+                .academy(
+                    json!({"kind": "loadLocalDraft", "learner": learner_ref, "attemptId": attempt}),
+                )
+                .await?;
+            let kept = loaded["data"].as_str().is_some_and(|d| d.contains(draft));
+            let _ = desk
+                .academy(json!({"kind": "clearLocalDraft", "learner": learner_ref, "attemptId": attempt}))
+                .await;
+            let mut found = Found::check(
+                saved["kind"] == "data" && kept,
+                "the draft was sealed locally for this account and read back; nothing was submitted",
+                "the local draft was not kept",
+            )
+            .with("save", json!({"kind": saved["kind"], "failure": saved["failure"]}))
+            .with("load", json!({"kind": loaded["kind"], "failure": loaded["failure"]}));
+            found.cleanup = "cleared from this Mac".to_owned();
+            found
+        }
+    };
+    ctx.settle("L14", DRAFT, started, inputs.clone(), found)?;
+
+    // The operator changes the account's access; the core must then refuse.
+    let started = now_utc();
+    let found = if ctx.run.nonsecret("L14", "access_change").as_deref() != Some("designated") {
+        Found::blocked("L14 designates no access_change the operator can make")
+    } else {
+        let bound = ctx.run.operator_timeout("L14");
+        let course = course.clone();
+        let denied = {
+            let desk_ref = &mut *desk;
+            let learner = learner_ref.clone();
+            let mut last = Value::Null;
+            let (done, step) = operator_step(
+                ctx.run.operator.as_ref(),
+                "academy-access-change",
+                "remove the designated test learner's access to the designated course now",
+                None,
+                bound,
+                async || {
+                    tokio::time::sleep(std::time::Duration::from_secs(1)).await;
+                    match desk_ref
+                        .academy(json!({"kind": "downloadCourse", "learner": learner, "courseId": course}))
+                        .await
+                    {
+                        Ok(r) => {
+                            // Academy withdrew the course (no longer
+                            // downloadable) or refused the learner.
+                            let refused = (r["kind"] == "failed"
+                                && r["failure"] == "notDownloadable")
+                                || (r["kind"] == "error"
+                                    && matches!(r["httpStatus"].as_u64(), Some(401 | 403 | 404)));
+                            last = r;
+                            refused
+                        }
+                        Err(_) => false,
+                    }
+                },
+            )
+            .await;
+            (done, step, last)
+        };
+        let (done, step, last) = denied;
+        let mut found = Found::check(
+            done,
+            "after the operator's access change, Academy refused the course and nothing stale was served",
+            "Academy kept serving the course after the access change",
+        )
+        .with("last", json!({"kind": last["kind"], "failure": last["failure"], "http_status": last["httpStatus"]}));
+        found.operator_step = Some(step);
+        found
+    };
+    ctx.settle("L14", DENIAL, started, inputs, found)?;
+    let _ = desk
+        .academy(json!({"kind": "removeDownload", "learner": learner_ref, "courseId": course}))
+        .await;
+    Ok(())
+}
+
+fn finish(ctx: Ctx<'_, '_>, families: &[String]) -> Shared {
+    let Ctx {
+        mut outcomes, stop, ..
+    } = ctx;
+    Shared {
+        families: families
+            .iter()
+            .map(|f| (f.clone(), outcomes.remove(f).unwrap_or_default()))
+            .collect(),
+        stop,
+    }
+}
diff --git a/crates/xtask/src/live_adapters.rs b/crates/xtask/src/live_adapters.rs
new file mode 100644
index 00000000..0a6e61be
--- /dev/null
+++ b/crates/xtask/src/live_adapters.rs
@@ -0,0 +1,268 @@
+//! OS adapters for the controlled live runner (C25).
+//!
+//! The runner drives the production core, but not the desktop host: there
+//! is no window, Keychain write or saved document. Credentials are session
+//! records (zeroized on removal) and the document lives in memory. The
+//! host's interactive parts are narrowed to what a scoped run needs:
+//!
+//! - a page the core opens (device sign-in, company or MCP sign-in) is
+//!   handed to the [`Operator`], who completes it in the browser; the runner
+//!   never completes it and learns the result only from the core;
+//! - a native confirmation is accepted only when the runner armed it for
+//!   the one change it just reviewed (and checked against its scope);
+//! - a one-time secret shown to the host is dropped (zeroized) unseen;
+//! - the folder sheets answer with the run's own scratch folder, every
+//!   other sheet as cancelled.
+
+use std::future::Future;
+use std::path::PathBuf;
+use std::pin::Pin;
+use std::sync::{Arc, Mutex};
+
+use desktop_core::import::ImportError;
+use desktop_core::store::MemoryStore;
+use desktop_core::vault::{RecordId, SessionVault, Vault, VaultError};
+use desktop_core::{
+    Adapters, ConfirmationRequest, CredentialStore, FileSaver, FolderPicker, ImagePicker,
+    ImportFile, ImportPicker, OperatorConfirmation, PagePrinter, SecretPresenter, UrlOpener,
+};
+use zeroize::Zeroizing;
+
+type Boxed<T> = Pin<Box<dyn Future<Output = T> + Send + 'static>>;
+
+/// The person running a live check: completes browser steps and access
+/// changes the runner asks for. The runner only ever observes the core.
+pub trait Operator: Send + Sync {
+    /// Asks the operator to do `instruction`; `url` is a page the core
+    /// produced (the issuer's verification or authorization page).
+    fn prompt(&self, instruction: &str, url: Option<&url::Url>);
+}
+
+/// The terminal: the instruction on stderr and the page in the default
+/// browser (as the desktop host does).
+pub struct TerminalOperator;
+
+impl Operator for TerminalOperator {
+    fn prompt(&self, instruction: &str, url: Option<&url::Url>) {
+        eprintln!("OPERATOR STEP: {instruction}");
+        if let Some(url) = url {
+            eprintln!("  page: {url}");
+            if url.scheme() == "https" || url.host_str() == Some("127.0.0.1") {
+                let _ = std::process::Command::new("/usr/bin/open")
+                    .arg(url.as_str())
+                    .status();
+            }
+        }
+    }
+}
+
+/// Native confirmations: accepted only once armed, once per arming.
+#[derive(Default)]
+pub struct Confirmations {
+    armed: Mutex<u32>,
+    shown: Mutex<Vec<(String, bool)>>,
+}
+
+impl Confirmations {
+    /// Accept the next confirmation the core opens.
+    pub fn arm(&self) {
+        if let Ok(mut armed) = self.armed.lock() {
+            *armed = 1;
+        }
+    }
+
+    pub fn disarm(&self) {
+        if let Ok(mut armed) = self.armed.lock() {
+            *armed = 0;
+        }
+    }
+
+    /// The titles shown so far and whether each was accepted.
+    pub fn shown(&self) -> Vec<(String, bool)> {
+        self.shown.lock().map(|s| s.clone()).unwrap_or_default()
+    }
+}
+
+/// What a desk's host offers.
+#[derive(Clone)]
+pub struct Host {
+    pub operator: Arc<dyn Operator>,
+    pub confirmations: Arc<Confirmations>,
+    /// Answered by the folder sheets (the run's scratch collection).
+    pub folder: Option<PathBuf>,
+    pub offline_root: Option<PathBuf>,
+    pub workbench_root: Option<PathBuf>,
+    /// Where the save sheet puts a response body (a run-owned folder).
+    pub save_dir: Option<PathBuf>,
+    /// What the image sheet answers with (a synthetic avatar).
+    pub image: Option<Vec<u8>>,
+}
+
+/// Session-only credentials for one run.
+#[derive(Default)]
+struct RunVault(SessionVault);
+
+impl Vault for RunVault {
+    fn put(&self, record: &RecordId, secret: &[u8]) -> Result<(), VaultError> {
+        self.0.put(record, secret)
+    }
+
+    fn get(&self, record: &RecordId) -> Result<Zeroizing<Vec<u8>>, VaultError> {
+        self.0.get(record)
+    }
+
+    fn delete(&self, record: &RecordId) -> Result<(), VaultError> {
+        self.0.delete(record)
+    }
+}
+
+impl CredentialStore for RunVault {
+    fn purge(&self) -> Result<(), VaultError> {
+        self.0.clear();
+        Ok(())
+    }
+}
+
+struct Sheets {
+    operator: Arc<dyn Operator>,
+    confirmations: Arc<Confirmations>,
+    folder: Option<PathBuf>,
+    save_dir: Option<PathBuf>,
+    image: Option<Vec<u8>>,
+}
+
+impl ImportPicker for Sheets {
+    fn choose(&self) -> Boxed<Option<Result<ImportFile, ImportError>>> {
+        Box::pin(async { None })
+    }
+}
+
+impl UrlOpener for Sheets {
+    fn open(&self, url: &url::Url) -> bool {
+        self.operator.prompt(
+            "complete this sign-in in the browser with the designated test identity",
+            Some(url),
+        );
+        true
+    }
+}
+
+impl PagePrinter for Sheets {
+    fn print(&self) -> bool {
+        false
+    }
+}
+
+impl ImagePicker for Sheets {
+    fn choose_image(&self) -> Boxed<Option<Result<ImportFile, ImportError>>> {
+        let file = self.image.clone().map(|bytes| {
+            Ok(ImportFile {
+                name: "c25-avatar.png".to_owned(),
+                bytes: Zeroizing::new(bytes),
+            })
+        });
+        Box::pin(async move { file })
+    }
+}
+
+impl OperatorConfirmation for Sheets {
+    fn confirm(&self, _nonce: u64, request: ConfirmationRequest) -> Boxed<bool> {
+        let accepted = self
+            .confirmations
+            .armed
+            .lock()
+            .map(|mut armed| {
+                let ok = *armed > 0;
+                *armed = 0;
+                ok
+            })
+            .unwrap_or(false);
+        if let Ok(mut shown) = self.confirmations.shown.lock() {
+            shown.push((request.title, accepted));
+        }
+        Box::pin(async move { accepted })
+    }
+
+    fn dismiss(&self, _nonce: u64) {}
+}
+
+impl SecretPresenter for Sheets {
+    fn reveal(&self, _label: String, secret: Zeroizing<String>) {
+        drop(secret);
+    }
+
+    fn dismiss(&self) {}
+}
+
+impl FileSaver for Sheets {
+    fn save(&self, _suggested: String, _bytes: Vec<u8>) -> Boxed<Result<Option<String>, ()>> {
+        Box::pin(async { Ok(None) })
+    }
+}
+
+impl FolderPicker for Sheets {
+    fn choose_folder(&self) -> Boxed<Option<PathBuf>> {
+        let folder = self.folder.clone();
+        Box::pin(async move { folder })
+    }
+
+    fn choose_new(&self) -> Boxed<Option<PathBuf>> {
+        Box::pin(async { None })
+    }
+
+    fn choose_project(&self) -> Boxed<Option<PathBuf>> {
+        Box::pin(async { None })
+    }
+
+    fn choose_save(&self, suggested: String) -> Boxed<Option<PathBuf>> {
+        let name: String = suggested
+            .chars()
+            .filter(|c| c.is_ascii_alphanumeric() || "._-".contains(*c))
+            .take(64)
+            .collect();
+        let path = self.save_dir.as_ref().map(|d| {
+            d.join(if name.is_empty() {
+                "response.bin".to_owned()
+            } else {
+                name
+            })
+        });
+        Box::pin(async move { path })
+    }
+}
+
+/// The adapters one live core runs with.
+pub fn adapters(host: &Host) -> Adapters {
+    let sheets = Arc::new(Sheets {
+        operator: Arc::clone(&host.operator),
+        confirmations: Arc::clone(&host.confirmations),
+        folder: host.folder.clone(),
+        save_dir: host.save_dir.clone(),
+        image: host.image.clone(),
+    });
+    Adapters {
+        keychain: Arc::new(RunVault::default()),
+        learner_keychain: Arc::new(RunVault::default()),
+        store: Arc::new(MemoryStore::new()),
+        picker: sheets.clone(),
+        opener: sheets.clone(),
+        printer: sheets.clone(),
+        images: sheets.clone(),
+        confirmer: sheets.clone(),
+        secrets: sheets.clone(),
+        text_files: sheets.clone(),
+        offline_root: host.offline_root.clone(),
+        saver: sheets.clone(),
+        sessions_root: None,
+        case_files: sheets.clone(),
+        library_root: None,
+        folders: sheets.clone(),
+        workbench_files: sheets.clone(),
+        gateway_files: sheets,
+        workbench_root: host.workbench_root.clone(),
+        harness: desktop_core::harness::sidecar::HarnessAdapters::unavailable(),
+        v1_source: None,
+        import_root: None,
+        logs_root: None,
+    }
+}
diff --git a/crates/xtask/src/live_changes.rs b/crates/xtask/src/live_changes.rs
new file mode 100644
index 00000000..533bff16
--- /dev/null
+++ b/crates/xtask/src/live_changes.rs
@@ -0,0 +1,1052 @@
+//! Mutating families (C25): L03 Runtime changes, L04 DLP and L08 Gateway
+//! changes, each through the production change review: `reviewChange`
+//! (Rust reads the baseline and normalizes the draft), `requestApply` with
+//! the exact typed confirmation, and the native confirmation, which the
+//! runner arms for that one reviewed change only. Every created resource is
+//! named under the family's disposable prefix, every update or delete
+//! targets a resource this run created (or, for a replace, a designated one
+//! written back with its own current body), one-time secrets are forgotten
+//! unseen, and every creation is deleted again and read back as absent. An
+//! outcome that may or may not have taken effect stops the run and leaves
+//! what was created for reconciliation instead of guessing.
+
+use std::collections::BTreeMap;
+
+use desktop_core::management::ManagementResult;
+use serde_json::{Value, json};
+
+use crate::live_run::{
+    Desk, DeskOptions, FamilyResult, Found, Outcomes, Run, Spec, Stop, disposable, sanitize_id,
+};
+use crate::{Result, invalid, now_utc};
+
+/// Names in a body that must sit under the disposable prefix (an IAM
+/// `scope_name` is checked against its underscore form in `names_ok`).
+const NAME_FIELDS: [&str; 5] = [
+    "topic_name",
+    "profile_name",
+    "api_key_name",
+    "cust_app",
+    "name",
+];
+
+fn id_field(kind: &str) -> &'static str {
+    match kind {
+        "topics" => "topic_id",
+        "profiles" => "profile_id",
+        "apiKeys" => "api_key_id",
+        "applications" => "customer_appId",
+        _ => "id",
+    }
+}
+
+/// A created resource the run must delete again.
+#[derive(Clone, Debug)]
+struct Created {
+    label: &'static str,
+    kind: &'static str,
+    id: String,
+    scoped: bool,
+}
+
+/// What one applied change produced.
+pub(crate) enum Applied {
+    /// The review failed; nothing was sent.
+    Review(Value),
+    Settled {
+        result: Value,
+        confirmation: Option<String>,
+    },
+}
+
+/// Reviews `draft`, applies it with the review's own confirmation text and
+/// the armed native confirmation, and waits for the result to settle.
+pub(crate) async fn apply(desk: &mut Desk, draft: &Value) -> Result<Applied> {
+    let context = desk.context_text()?;
+    desk.send_json(json!({"kind": "reviewChange", "context": context, "draft": draft}))
+        .await?;
+    let snap = desk
+        .until(desk.settle, |j| {
+            matches!(
+                j["changes"]["review"]["state"].as_str(),
+                Some("ready" | "failed")
+            )
+        })
+        .await
+        .ok_or_else(|| invalid("the review did not settle"))?;
+    let review = snap["changes"]["review"].clone();
+    if review["state"] == "failed" {
+        return Ok(Applied::Review(review["failure"].clone()));
+    }
+    let typed = review["confirmation"]
+        .as_str()
+        .unwrap_or("CREATE")
+        .to_owned();
+    let before = snap["changes"]["results"]
+        .as_array()
+        .map(Vec::len)
+        .unwrap_or(0);
+    desk.confirmations.arm();
+    let sent = desk
+        .send_json(
+            json!({"kind": "requestApply", "review": review["review"], "draft": draft,
+            "confirmation": typed}),
+        )
+        .await;
+    if let Err(e) = sent {
+        desk.confirmations.disarm();
+        return Err(e);
+    }
+    let settled = desk
+        .until(desk.settle, |j| {
+            j["changes"]["results"]
+                .as_array()
+                .is_some_and(|r| r.len() > before && r[0]["settled"] == true)
+        })
+        .await;
+    desk.confirmations.disarm();
+    let confirmation = desk.confirmations.shown().last().map(|(t, _)| t.clone());
+    match settled {
+        Some(j) => Ok(Applied::Settled {
+            result: j["changes"]["results"][0].clone(),
+            confirmation,
+        }),
+        None => Ok(Applied::Settled {
+            result: json!({"outcome": "unknown", "settled": false}),
+            confirmation,
+        }),
+    }
+}
+
+/// Forgets an applied change's one-time secret, unseen.
+async fn forget(desk: &mut Desk, result: &Value) -> Result<Value> {
+    if result["secret"] != "held" {
+        return Ok(result["secret"].clone());
+    }
+    desk.send_json(json!({"kind": "forgetSecret", "operation": result["operation"]}))
+        .await?;
+    let operation = result["operation"].clone();
+    let forgotten = desk
+        .until(desk.settle, |j| {
+            j["changes"]["results"].as_array().is_some_and(|r| {
+                r.iter()
+                    .any(|x| x["operation"] == operation && x["secret"] == "forgotten")
+            })
+        })
+        .await
+        .is_some();
+    Ok(json!(if forgotten {
+        "held, then forgotten unseen"
+    } else {
+        "still held"
+    }))
+}
+
+fn current(result: &Value) -> Value {
+    result["current"]
+        .as_str()
+        .and_then(|s| serde_json::from_str(s).ok())
+        .unwrap_or(Value::Null)
+}
+
+fn text(value: &Value) -> Option<String> {
+    match value {
+        Value::String(s) => Some(s.clone()),
+        Value::Number(n) => Some(n.to_string()),
+        _ => None,
+    }
+}
+
+struct Ctx<'r, 'a> {
+    run: &'r mut Run<'a>,
+    id: &'static str,
+    prefix: Option<String>,
+    outcomes: Outcomes,
+    created: Vec<Created>,
+    stop: Option<Stop>,
+}
+
+/// One planned change.
+struct Change {
+    spec: Spec,
+    kind: &'static str,
+    action: &'static str,
+    /// The created resource's label (update, delete, rotate), or none.
+    target: Option<&'static str>,
+    body: Value,
+    /// Within the selected Gateway workspace.
+    scoped: bool,
+    expect: &'static str,
+    /// Remember what this creates under this label.
+    creates: Option<&'static str>,
+}
+
+impl Ctx<'_, '_> {
+    fn stopped(&self) -> bool {
+        self.stop.is_some()
+    }
+
+    fn settle(
+        &mut self,
+        spec: Spec,
+        started: String,
+        inputs: BTreeMap<String, Value>,
+        found: Found,
+    ) -> Result<()> {
+        let stop = self.run.settle(
+            self.id,
+            spec,
+            started,
+            inputs,
+            found,
+            None,
+            &mut self.outcomes,
+        )?;
+        if self.stop.is_none() {
+            self.stop = stop;
+        }
+        Ok(())
+    }
+
+    fn block(&mut self, spec: Spec, reason: &str) -> Result<()> {
+        self.settle(spec, now_utc(), BTreeMap::new(), Found::blocked(reason))
+    }
+
+    /// Names in a create body must be under the prefix.
+    fn names_ok(&self, body: &Value) -> std::result::Result<(), String> {
+        let mut names = Vec::new();
+        for field in NAME_FIELDS {
+            if let Some(n) = body.get(field).and_then(Value::as_str) {
+                names.push(n.to_owned());
+            }
+        }
+        if let Some(n) = body["metadata"]["name"].as_str() {
+            names.push(n.to_owned());
+        }
+        if names.is_empty() {
+            return Err("a create names nothing to check against the prefix".to_owned());
+        }
+        for name in names {
+            disposable(self.prefix.as_deref(), &name)?;
+        }
+        // An IAM scope name allows only letters, digits and underscores
+        // (the service refuses hyphens), so it carries the prefix with its
+        // hyphens as underscores.
+        if let Some(scope) = body.get("scope_name").and_then(Value::as_str) {
+            let prefix = self.prefix.as_deref().unwrap_or_default().replace('-', "_");
+            if prefix.is_empty() || !scope.starts_with(&prefix) {
+                return Err(format!(
+                    "the IAM scope {scope} does not start with {prefix}"
+                ));
+            }
+        }
+        Ok(())
+    }
+
+    fn target(&self, label: &str) -> Option<Created> {
+        self.created
+            .iter()
+            .rev()
+            .find(|c| c.label == label)
+            .cloned()
+    }
+
+    /// Applies one change and records it.
+    async fn change(&mut self, desk: &mut Desk, change: Change) -> Result<Option<Value>> {
+        if self.stopped() {
+            return Ok(None);
+        }
+        let started = now_utc();
+        let target = match change.target {
+            None => String::new(),
+            Some(label) => match self.target(label) {
+                Some(c) => c.id,
+                None => {
+                    self.block(
+                        change.spec,
+                        &format!("nothing labelled {label} was created in this run"),
+                    )?;
+                    return Ok(None);
+                }
+            },
+        };
+        if change.action == "create"
+            && let Err(e) = self.names_ok(&change.body)
+        {
+            self.settle(change.spec, started, BTreeMap::new(), Found::blocked(e))?;
+            return Ok(None);
+        }
+        let mut draft = json!({"kind": change.kind, "action": change.action, "target": target,
+            "body": change.body.to_string()});
+        if change.scoped {
+            draft["workspace"] = json!(desk.workspace_ref());
+        }
+        let mut inputs = BTreeMap::new();
+        inputs.insert("kind".to_owned(), json!(change.kind));
+        inputs.insert("action".to_owned(), json!(change.action));
+        if !target.is_empty() {
+            inputs.insert("target".to_owned(), json!(sanitize_id(&target)));
+        }
+        inputs.insert("body".to_owned(), change.body.clone());
+        let (result, confirmation) = match apply(desk, &draft).await? {
+            // A cleanup whose target the review's complete inventory walk
+            // did not find is already absent (an application goes with its
+            // last key); an incomplete walk reports a different problem.
+            Applied::Review(failure)
+                if change.action == "delete"
+                    && change.expect == "absent"
+                    && failure["problem"] == "notFound" =>
+            {
+                let mut found = Found::passed(
+                    "already absent: the review's complete inventory walk found nothing to delete",
+                )
+                .with("review_failure", failure);
+                found.readback = "absent".to_owned();
+                self.settle(change.spec, started, inputs, found)?;
+                return Ok(None);
+            }
+            Applied::Review(failure) => {
+                let found = Found::failed("the review refused the draft; nothing was sent")
+                    .with("review_failure", failure);
+                self.settle(change.spec, started, inputs, found)?;
+                return Ok(None);
+            }
+            Applied::Settled {
+                result,
+                confirmation,
+            } => (result, confirmation),
+        };
+        let outcome = result["outcome"].as_str().unwrap_or("unknown");
+        let readback = result["readback"].as_str().unwrap_or("none").to_owned();
+        let mut found = match outcome {
+            "completed" if readback == change.expect => Found::passed(format!(
+                "applied once after the native confirmation; read back {readback}"
+            )),
+            "completed" => Found::failed(format!(
+                "the write completed but its readback was {readback}, not {}",
+                change.expect
+            ))
+            .stopping("the resulting state is not verified", true),
+            "unknown" => Found::failed("the write may or may not have taken effect")
+                .stopping("an uncertain outcome", true),
+            other => Found::failed(format!(
+                "the service did not apply it ({other}); nothing changed"
+            )),
+        }
+        .with("outcome", json!(outcome))
+        .with("failure", result["failure"].clone())
+        .with("confirmation_title", json!(confirmation));
+        found.readback = readback;
+        if let Some(steps) = result.get("provisioning").filter(|p| !p.is_null()) {
+            // Every step of a multi-step provisioning must have settled and
+            // been read back; otherwise what exists must be reconciled.
+            let settled = ["scope", "workspace", "binding"]
+                .iter()
+                .all(|k| steps[*k] == "completed")
+                && steps["scopeRead"] == "found"
+                && steps["workspaceRead"] == "found"
+                && steps["boundRead"] == true;
+            if !settled && found.outcome == "passed" {
+                found = Found::failed("the provisioning did not settle every step")
+                    .stopping("a partially provisioned workspace must be reconciled", true);
+            }
+            found = found.with("provisioning", steps.clone());
+        }
+        if result["secret"] != "none" && !result["secret"].is_null() {
+            let secret = forget(desk, &result).await?;
+            found = found.with("one_time_secret", secret);
+        }
+        let mut created_id = None;
+        if outcome == "completed"
+            && let Some(label) = change.creates
+        {
+            let now = current(&result);
+            let id = text(&now[id_field(change.kind)])
+                .or_else(|| text(&result["provisioning"]["workspaceId"]));
+            if let Some(id) = id {
+                found = found.id("created_id", &id);
+                self.created.push(Created {
+                    label,
+                    kind: change.kind,
+                    id: id.clone(),
+                    scoped: change.scoped,
+                });
+                created_id = Some(id);
+            }
+        }
+        found.cleanup = if change.creates.is_some() {
+            "deleted at the end of the family and read back as absent".to_owned()
+        } else if change.action == "delete" {
+            "this is the cleanup".to_owned()
+        } else {
+            "nothing created".to_owned()
+        };
+        self.settle(change.spec, started, inputs, found)?;
+        let _ = created_id;
+        Ok((outcome == "completed").then(|| current(&result)))
+    }
+
+    /// Deletes every created resource, newest first, unless the run stopped
+    /// on an uncertain outcome (then they are left for reconciliation).
+    async fn cleanup(&mut self, desk: &mut Desk, specs: &[(&'static str, Spec)]) -> Result<()> {
+        let created = std::mem::take(&mut self.created);
+        if let Some(stop) = &self.stop
+            && stop.reconcile
+        {
+            let left: Vec<String> = created
+                .iter()
+                .map(|c| format!("{} {}", c.kind, sanitize_id(&c.id)))
+                .collect();
+            for (_, spec) in specs {
+                let found =
+                    Found::blocked("not run: an uncertain outcome must be reconciled first")
+                        .with("left_for_reconciliation", json!(left));
+                self.run.settle(
+                    self.id,
+                    *spec,
+                    now_utc(),
+                    BTreeMap::new(),
+                    found,
+                    None,
+                    &mut self.outcomes,
+                )?;
+            }
+            return Ok(());
+        }
+        for (label, spec) in specs {
+            let Some(item) = created.iter().rev().find(|c| c.label == *label).cloned() else {
+                self.run.settle(
+                    self.id,
+                    *spec,
+                    now_utc(),
+                    BTreeMap::new(),
+                    Found::blocked(format!("nothing labelled {label} was created")),
+                    None,
+                    &mut self.outcomes,
+                )?;
+                continue;
+            };
+            self.created = vec![item.clone()];
+            // A key change carries its rotation policy, deletes included
+            // (the review checks it on every key change, as v1 did).
+            let body = if item.kind == "apiKeys" {
+                json!({"rotation_time_interval": 30, "rotation_time_unit": "days"})
+            } else {
+                json!({})
+            };
+            self.change(
+                desk,
+                Change {
+                    spec: *spec,
+                    kind: item.kind,
+                    action: "delete",
+                    target: Some(item.label),
+                    body,
+                    scoped: item.scoped,
+                    expect: "absent",
+                    creates: None,
+                },
+            )
+            .await?;
+        }
+        self.created.clear();
+        Ok(())
+    }
+
+    /// Replaces a designated resource with its own current body: the write
+    /// path is exercised and nothing changes.
+    async fn replace_same(
+        &mut self,
+        desk: &mut Desk,
+        spec: Spec,
+        kind: &'static str,
+        resource: &str,
+        key: &str,
+    ) -> Result<()> {
+        // `<resource>_blocked` (a reason) records the write-back as blocked.
+        let blocked = format!("{}_blocked", key.trim_end_matches("_id"));
+        if let Some(reason) = self.run.nonsecret(self.id, &blocked) {
+            return self.block(spec, &reason);
+        }
+        let Some(id) = self.run.nonsecret(self.id, key) else {
+            return self.block(spec, &format!("{} designates no {key}", self.id));
+        };
+        let detail = desk
+            .read(json!({"kind": "detail", "resource": resource, "id": id}))
+            .await?;
+        let body = match &detail {
+            ManagementResult::Detail { detail } => serde_json::to_value(detail)
+                .ok()
+                .and_then(|d| {
+                    d["item"]
+                        .as_str()
+                        .and_then(|s| serde_json::from_str::<Value>(s).ok())
+                })
+                .map(|mut item| {
+                    if let Some(o) = item.as_object_mut() {
+                        for server in [
+                            "id",
+                            "created_at",
+                            "updated_at",
+                            "created_by",
+                            "updated_by",
+                            "status",
+                        ] {
+                            o.remove(server);
+                        }
+                    }
+                    item
+                }),
+            _ => None,
+        };
+        let Some(body) = body else {
+            return self.settle(
+                spec,
+                now_utc(),
+                BTreeMap::new(),
+                Found::failed("the designated resource could not be read to write it back"),
+            );
+        };
+        self.created.push(Created {
+            label: "designated",
+            kind,
+            id,
+            scoped: false,
+        });
+        self.change(
+            desk,
+            Change {
+                spec,
+                kind,
+                action: "update",
+                target: Some("designated"),
+                body,
+                scoped: false,
+                expect: "found",
+                creates: None,
+            },
+        )
+        .await?;
+        self.created.retain(|c| c.label != "designated");
+        Ok(())
+    }
+}
+
+pub(crate) async fn run(run: &mut Run<'_>, id: &str) -> Result<FamilyResult> {
+    let id: &'static str = match id {
+        "L03" => "L03",
+        "L04" => "L04",
+        _ => "L08",
+    };
+    let prefix = run.prefix(id);
+    let mut ctx = Ctx {
+        run,
+        id,
+        prefix,
+        outcomes: Vec::new(),
+        created: Vec::new(),
+        stop: None,
+    };
+    let mut desk = match ctx.run.management_desk(id, DeskOptions::default()).await? {
+        Ok(d) => d,
+        Err(e) => {
+            ctx.block(
+                Spec {
+                    id: leak(format!("{id}-setup")),
+                    workflows: &[],
+                },
+                &e,
+            )?;
+            return Ok(FamilyResult {
+                outcomes: ctx.outcomes,
+                stop: None,
+            });
+        }
+    };
+    match id {
+        "L03" => l03(&mut ctx, &mut desk).await?,
+        "L04" => l04(&mut ctx, &mut desk).await?,
+        _ => l08(&mut ctx, &mut desk).await?,
+    }
+    Ok(FamilyResult {
+        outcomes: ctx.outcomes,
+        stop: ctx.stop,
+    })
+}
+
+/// A setup check's name lives for the run (one per family at most).
+fn leak(name: String) -> &'static str {
+    Box::leak(name.into_boxed_str())
+}
+
+fn spec(id: &'static str, workflows: &'static [&'static str]) -> Spec {
+    Spec { id, workflows }
+}
+
+async fn l03(ctx: &mut Ctx<'_, '_>, desk: &mut Desk) -> Result<()> {
+    let p = ctx.prefix.clone().unwrap_or_default();
+    let topic = json!({"topic_name": format!("{p}topic"), "description": "C25 disposable topic",
+        "examples": ["c25 synthetic example"]});
+    let created = ctx
+        .change(
+            desk,
+            Change {
+                spec: spec("L03-topic-create", &["W08"]),
+                kind: "topics",
+                action: "create",
+                target: None,
+                body: topic.clone(),
+                scoped: false,
+                expect: "found",
+                creates: Some("topic"),
+            },
+        )
+        .await?;
+    // The update names the revision the service read back.
+    let revision = created
+        .as_ref()
+        .map(|c| c["revision"].clone())
+        .filter(|r| !r.is_null())
+        .unwrap_or(json!(1));
+    let mut update = topic.clone();
+    update["description"] = json!("C25 disposable topic, updated");
+    update["revision"] = revision;
+    ctx.change(
+        desk,
+        Change {
+            spec: spec("L03-topic-update", &["W08"]),
+            kind: "topics",
+            action: "update",
+            target: Some("topic"),
+            body: update,
+            scoped: false,
+            expect: "found",
+            creates: None,
+        },
+    )
+    .await?;
+    // The service requires a default policy: the new profile copies the
+    // policy of a designated template profile (`profile_template`, else
+    // L01's scan profile), as the editor's duplicate does.
+    let template = ctx
+        .run
+        .nonsecret("L03", "profile_template")
+        .or_else(|| ctx.run.nonsecret("L01", "profile_name"));
+    let policy = match &template {
+        None => None,
+        Some(name) => {
+            let page = desk
+                .read(json!({"kind": "page", "resource": "profiles", "offset": 0, "limit": 100}))
+                .await?;
+            match &page {
+                ManagementResult::Page { page } => serde_json::from_str::<Vec<Value>>(&page.items)
+                    .unwrap_or_default()
+                    .into_iter()
+                    .find(|p| p["profile_name"].as_str() == Some(name.as_str()))
+                    .map(|p| p["policy"].clone())
+                    .filter(|p| p.is_object()),
+                _ => None,
+            }
+        }
+    };
+    match policy {
+        None => ctx.block(
+            spec("L03-profile-create", &["W07"]),
+            "no template profile's policy could be read (designate profile_template)",
+        )?,
+        Some(policy) => {
+            ctx.change(
+                desk,
+                Change {
+                    spec: spec("L03-profile-create", &["W07"]),
+                    kind: "profiles",
+                    action: "create",
+                    target: None,
+                    // Active: the service's inventory omits inactive
+                    // profiles, so an inactive one could not be read back
+                    // or cleaned up (C25 live finding).
+                    body: json!({"profile_name": format!("{p}profile"), "active": true,
+                    "policy": policy}),
+                    scoped: false,
+                    expect: "found",
+                    creates: Some("profile"),
+                },
+            )
+            .await?;
+        }
+    }
+    match ctx.run.nonsecret("L03", "deployment_profile") {
+        None => {
+            ctx.block(
+                spec("L03-key-create", &["W10", "W11"]),
+                "L03 designates no deployment_profile",
+            )?;
+            ctx.block(
+                spec("L03-key-rotate", &["W10", "W11"]),
+                "no key was created",
+            )?;
+            ctx.block(
+                spec("L03-application-update", &["W09"]),
+                "no application was created",
+            )?;
+        }
+        Some(dp) => {
+            let app = format!("{p}app");
+            let env = ctx
+                .run
+                .nonsecret("L03", "app_environment")
+                .unwrap_or_else(|| "staging".to_owned());
+            let cloud = ctx
+                .run
+                .nonsecret("L03", "app_cloud_provider")
+                .unwrap_or_else(|| "aws".to_owned());
+            ctx.change(
+                desk,
+                Change {
+                    spec: spec("L03-key-create", &["W10", "W11"]),
+                    kind: "apiKeys",
+                    action: "create",
+                    target: None,
+                    body: json!({"cust_app": app, "cust_env": env, "cust_cloud_provider": cloud,
+                    "api_key_name": format!("{p}key"), "dp_name": dp, "revoked": false,
+                    "rotation_time_interval": 30, "rotation_time_unit": "days"}),
+                    scoped: false,
+                    expect: "found",
+                    creates: Some("key"),
+                },
+            )
+            .await?;
+            ctx.change(
+                desk,
+                Change {
+                    spec: spec("L03-key-rotate", &["W10", "W11"]),
+                    kind: "apiKeys",
+                    action: "rotate",
+                    target: Some("key"),
+                    body: json!({"rotation_time_interval": 90, "rotation_time_unit": "days"}),
+                    scoped: false,
+                    expect: "found",
+                    creates: None,
+                },
+            )
+            .await?;
+            // Rotation replaces the key's ID: find it again by name so its
+            // cleanup names the current key.
+            if !ctx.stopped() {
+                let page = desk
+                    .read(json!({"kind": "page", "resource": "apiKeys", "offset": 0, "limit": 100}))
+                    .await?;
+                let key_name = format!("{p}key");
+                let current = match &page {
+                    ManagementResult::Page { page } => {
+                        serde_json::from_str::<Vec<Value>>(&page.items)
+                            .unwrap_or_default()
+                            .into_iter()
+                            .find(|k| k["api_key_name"].as_str() == Some(key_name.as_str()))
+                            .and_then(|k| text(&k["api_key_id"]))
+                    }
+                    _ => None,
+                };
+                if let Some(id) = current
+                    && let Some(key) = ctx.created.iter_mut().rev().find(|c| c.label == "key")
+                {
+                    key.id = id;
+                }
+            }
+            // The key's creation made its application; find it by name.
+            if !ctx.stopped() {
+                let page = desk
+                    .read(json!({"kind": "page", "resource": "applications", "offset": 0, "limit": 100}))
+                    .await?;
+                let app_id = match &page {
+                    ManagementResult::Page { page } => {
+                        serde_json::from_str::<Vec<Value>>(&page.items)
+                            .unwrap_or_default()
+                            .into_iter()
+                            .find(|a| a["app_name"].as_str() == Some(app.as_str()))
+                            .and_then(|a| text(&a["customer_appId"]))
+                    }
+                    _ => None,
+                };
+                match app_id {
+                    Some(id) => {
+                        ctx.created.push(Created {
+                            label: "application",
+                            kind: "applications",
+                            id,
+                            scoped: false,
+                        });
+                        ctx.change(desk, Change {
+                            spec: spec("L03-application-update", &["W09"]),
+                            kind: "applications", action: "update", target: Some("application"),
+                            // A real change: the environment moves off the
+                            // one the key's creation recorded.
+                            body: json!({"app_name": app, "cloud_provider": cloud,
+                                "environment": if env == "development" { "staging" } else { "development" }}),
+                            scoped: false, expect: "found", creates: None,
+                        })
+                        .await?;
+                    }
+                    None => ctx.settle(
+                        spec("L03-application-update", &["W09"]),
+                        now_utc(),
+                        BTreeMap::new(),
+                        Found::failed("the key's application is not listed"),
+                    )?,
+                }
+            }
+        }
+    }
+    ctx.cleanup(
+        desk,
+        &[
+            ("key", spec("L03-cleanup-key", &["W10"])),
+            ("application", spec("L03-cleanup-application", &["W09"])),
+            ("profile", spec("L03-cleanup-profile", &["W07"])),
+            ("topic", spec("L03-cleanup-topic", &["W08"])),
+        ],
+    )
+    .await
+}
+
+async fn l04(ctx: &mut Ctx<'_, '_>, desk: &mut Desk) -> Result<()> {
+    let p = ctx.prefix.clone().unwrap_or_default();
+    // The service needs the regex rules and confidence levels a custom
+    // pattern detects with (the shape of the tenant's own custom patterns).
+    let pattern = json!({"name": format!("{p}pattern"), "type": "custom",
+        "description": "C25 disposable pattern",
+        "detection_config": {"technique": "regex", "supported_confidence_levels": ["high", "low"]},
+        "matching_rules": {"proximity_distance": 200,
+            "regexes": [{"regex": "airs-v2-c25-[0-9]{6}", "weight": 1}]}});
+    ctx.change(
+        desk,
+        Change {
+            spec: spec("L04-pattern-create", &["W13"]),
+            kind: "dataPatterns",
+            action: "create",
+            target: None,
+            body: pattern.clone(),
+            scoped: false,
+            expect: "found",
+            creates: Some("pattern"),
+        },
+    )
+    .await?;
+    let mut replaced = pattern;
+    replaced["description"] = json!("C25 disposable pattern, replaced");
+    ctx.change(
+        desk,
+        Change {
+            spec: spec("L04-pattern-replace", &["W13"]),
+            kind: "dataPatterns",
+            action: "update",
+            target: Some("pattern"),
+            body: replaced,
+            scoped: false,
+            expect: "found",
+            creates: None,
+        },
+    )
+    .await?;
+    let category = ctx
+        .run
+        .nonsecret("L04", "dictionary_category")
+        .unwrap_or_else(|| "Confidential".to_owned());
+    let region = ctx
+        .run
+        .nonsecret("L04", "dictionary_region")
+        .unwrap_or_else(|| "United States".to_owned());
+    let metadata = |file: &str| {
+        json!({"name": format!("{p}dictionary"), "original_file_name": file,
+        "category": category, "region_name": region})
+    };
+    ctx.change(desk, Change {
+        spec: spec("L04-dictionary-create", &["W16"]),
+        kind: "dictionaries", action: "create", target: None,
+        body: json!({"metadata": metadata("c25-keywords.txt"), "file": "c25-synthetic-keyword\n"}),
+        scoped: false, expect: "found", creates: Some("dictionary"),
+    })
+    .await?;
+    ctx.change(desk, Change {
+        spec: spec("L04-dictionary-replace", &["W16"]),
+        kind: "dictionaries", action: "update", target: Some("dictionary"),
+        body: json!({"metadata": metadata("c25-keywords-2.txt"), "file": "c25-synthetic-keyword-2\n"}),
+        scoped: false, expect: "found", creates: None,
+    })
+    .await?;
+    if !ctx.stopped() {
+        ctx.replace_same(
+            desk,
+            spec("L04-data-profile-replace", &["W14"]),
+            "dataProfiles",
+            "dataProfiles",
+            "data_profile_id",
+        )
+        .await?;
+    }
+    if !ctx.stopped() {
+        ctx.replace_same(
+            desk,
+            spec("L04-filtering-profile-replace", &["W15"]),
+            "filteringProfiles",
+            "filteringProfiles",
+            "filtering_profile_id",
+        )
+        .await?;
+    }
+    if !ctx.stopped() {
+        let started = now_utc();
+        let page = desk
+            .read(
+                json!({"kind": "page", "resource": "deploymentProfiles", "offset": 0, "limit": 25}),
+            )
+            .await?;
+        let found = Found::check(
+            matches!(page, ManagementResult::Page { .. }),
+            "the deployment profile catalog was read (catalog-only, no deployment writes)",
+            "the deployment catalog could not be read",
+        )
+        .with("page", crate::live_run::summarize(&page));
+        ctx.settle(
+            spec("L04-deployment-catalog", &["W12"]),
+            started,
+            BTreeMap::new(),
+            found,
+        )?;
+    }
+    ctx.cleanup(
+        desk,
+        &[
+            ("dictionary", spec("L04-cleanup-dictionary", &["W16"])),
+            ("pattern", spec("L04-cleanup-pattern", &["W13"])),
+        ],
+    )
+    .await
+}
+
+async fn l08(ctx: &mut Ctx<'_, '_>, desk: &mut Desk) -> Result<()> {
+    let p = ctx.prefix.clone().unwrap_or_default();
+    // `provision_blocked` (a reason) records provisioning as blocked and
+    // runs the route and key changes in the designated workspace instead.
+    let workspace = match ctx.run.nonsecret("L08", "provision_blocked") {
+        Some(reason) => {
+            ctx.block(spec("L08-provision-workspace", &["W37", "W39"]), &reason)?;
+            ctx.run.nonsecret("L08", "workspace_id")
+        }
+        None => {
+            ctx.change(
+                desk,
+                Change {
+                    spec: spec("L08-provision-workspace", &["W37", "W39"]),
+                    kind: "gatewayWorkspaces",
+                    action: "create",
+                    target: None,
+                    body: json!({"name": format!("{p}ws"),
+                    "scope_name": format!("{}scope", p.replace('-', "_")),
+                    "existing_scope": false}),
+                    scoped: false,
+                    expect: "found",
+                    creates: Some("workspace"),
+                },
+            )
+            .await?;
+            ctx.target("workspace").map(|c| c.id)
+        }
+    };
+    let selected = match workspace {
+        Some(ws) if !ctx.stopped() => desk.select_workspace(&ws).await.is_ok(),
+        _ => false,
+    };
+    if selected {
+        match ctx.run.nonsecret("L08", "route_provider") {
+            None => {
+                ctx.block(
+                    spec("L08-route-create", &["W37"]),
+                    "L08 designates no route_provider",
+                )?;
+                ctx.block(spec("L08-route-update", &["W37"]), "no route was created")?;
+            }
+            Some(provider) => {
+                // A single-target routing config naming the integration as
+                // `@slug` (the Gateway's model catalog form).
+                let target = if provider.starts_with('@') {
+                    provider.clone()
+                } else {
+                    format!("@{provider}")
+                };
+                let config = json!({"strategy": {"mode": "single"},
+                    "targets": [{"provider": target}]});
+                ctx.change(
+                    desk,
+                    Change {
+                        spec: spec("L08-route-create", &["W37"]),
+                        kind: "gatewayRoutes",
+                        action: "create",
+                        target: None,
+                        body: json!({"name": format!("{p}route"), "config": config}),
+                        scoped: true,
+                        expect: "found",
+                        creates: Some("route"),
+                    },
+                )
+                .await?;
+                ctx.change(
+                    desk,
+                    Change {
+                        spec: spec("L08-route-update", &["W37"]),
+                        kind: "gatewayRoutes",
+                        action: "update",
+                        target: Some("route"),
+                        body: json!({"name": format!("{p}route-2")}),
+                        scoped: true,
+                        expect: "found",
+                        creates: None,
+                    },
+                )
+                .await?;
+            }
+        }
+        ctx.change(desk, Change {
+            spec: spec("L08-service-key-create", &["W38"]),
+            kind: "gatewayServiceKeys", action: "create", target: None,
+            body: json!({"name": format!("{p}key"), "scopes": ["completions.write"], "type": "service"}),
+            scoped: true, expect: "found", creates: Some("key"),
+        })
+        .await?;
+        ctx.change(
+            desk,
+            Change {
+                spec: spec("L08-service-key-rotate", &["W38"]),
+                kind: "gatewayServiceKeys",
+                action: "rotate",
+                target: Some("key"),
+                body: json!({"key_transition_period_ms": 3_600_000}),
+                scoped: true,
+                expect: "found",
+                creates: None,
+            },
+        )
+        .await?;
+    } else {
+        for name in [
+            "L08-route-create",
+            "L08-route-update",
+            "L08-service-key-create",
+            "L08-service-key-rotate",
+        ] {
+            ctx.block(
+                spec(name, &["W37", "W38"]),
+                "the provisioned workspace could not be selected",
+            )?;
+        }
+    }
+    ctx.cleanup(
+        desk,
+        &[
+            ("key", spec("L08-cleanup-service-key", &["W38"])),
+            ("route", spec("L08-cleanup-route", &["W37"])),
+            ("workspace", spec("L08-cleanup-workspace", &["W39"])),
+        ],
+    )
+    .await
+}
