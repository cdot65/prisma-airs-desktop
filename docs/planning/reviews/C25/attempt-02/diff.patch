+++ b/crates/xtask/tests/live_run/changes.rs
@@ -0,0 +1,272 @@
+//! L03 Runtime changes, L04 DLP and L08 Gateway changes against the
+//! synthetic cloud: review, the exact typed confirmation, the armed native
+//! confirmation, one-time secrets forgotten unseen, readback, and every
+//! created resource deleted again.
+
+use serde_json::{Value, json};
+
+use crate::cloud::{Cloud, ONE_TIME};
+use crate::common::{
+    Browser, CLIENT_SECRET, assert_no_secret, designate, management_family, management_secrets,
+    manifest, outcomes, receipt,
+};
+use crate::reads::served;
+
+const PREFIX: &str = "airs-v2-c25-";
+
+fn mutating(extra: Value) -> Value {
+    let mut family = management_family(extra);
+    family["disposable_prefix"] = json!(PREFIX);
+    family["cleanup"] = json!([format!(
+        "delete every {PREFIX} resource and read back its absence"
+    )]);
+    family["permitted_operations"] = json!(["create", "update", "delete", "rotate"]);
+    family
+}
+
+fn scope() -> Value {
+    let mut value = manifest();
+    let mut l03 = mutating(
+        json!({"nonsecret": {"deployment_profile": "dp-1", "profile_template": "Profile 0"}}),
+    );
+    l03["budget"] = json!({"writes": 20});
+    designate(&mut value, "L03", l03);
+    designate(
+        &mut value,
+        "L04",
+        mutating(json!({"nonsecret": {
+        "data_profile_id": "dprof-1", "filtering_profile_id": "filter-1"}})),
+    );
+    designate(
+        &mut value,
+        "L08",
+        mutating(json!({"nonsecret": {"route_provider": "@openai-prod"}})),
+    );
+    value
+}
+
+#[tokio::test(flavor = "multi_thread")]
+async fn runtime_dlp_and_gateway_changes_apply_once_and_clean_up() {
+    let s = served(Cloud::new()).await;
+    let (repo, record) = s
+        .fixture
+        .run(
+            scope(),
+            &["L03", "L04", "L08"],
+            &management_secrets(&[]),
+            Browser::idle(),
+        )
+        .await;
+    let record = record.expect("run");
+    for family in ["L03", "L04", "L08"] {
+        let checks = outcomes(&record, family);
+        assert!(
+            checks.iter().all(|c| c.ends_with(": passed")),
+            "{family}: {checks:?}"
+        );
+    }
+    assert!(record.passed(), "{record:?}");
+    let cloud = s.cloud.lock().expect("cloud");
+    // Nothing the run created is left behind.
+    assert!(!cloud.topics.iter().any(|t| {
+        t["topic_name"]
+            .as_str()
+            .is_some_and(|n| n.starts_with(PREFIX))
+    }));
+    assert!(!cloud.profiles.iter().any(|t| {
+        t["profile_name"]
+            .as_str()
+            .is_some_and(|n| n.starts_with(PREFIX))
+    }));
+    assert!(!cloud.keys.iter().any(|t| {
+        t["api_key_name"]
+            .as_str()
+            .is_some_and(|n| n.starts_with(PREFIX))
+    }));
+    assert!(!cloud.apps.iter().any(|t| {
+        t["app_name"]
+            .as_str()
+            .is_some_and(|n| n.starts_with(PREFIX))
+    }));
+    // A deleted pattern is archived by the service (status `deleted`).
+    assert!(
+        cloud.dlp["data-patterns"]
+            .iter()
+            .all(|p| p["status"] == "deleted")
+    );
+    assert!(cloud.dlp["dictionaries"].is_empty());
+    assert!(
+        cloud.items["configs"]
+            .iter()
+            .all(|c| !c["name"].as_str().unwrap_or("").starts_with(PREFIX))
+    );
+    assert!(
+        cloud
+            .workspaces
+            .iter()
+            .filter(|w| w["name"].as_str().unwrap_or("").starts_with(PREFIX))
+            .all(|w| w["status"] == "archived")
+    );
+    // The designated profiles were written back unchanged.
+    assert_eq!(cloud.dlp["data-filtering-profiles"][0]["name"], "Default");
+    drop(cloud);
+
+    let key = receipt(&repo, "L03", "L03-key-create");
+    assert_eq!(
+        key.observed["one_time_secret"],
+        json!("held, then forgotten unseen")
+    );
+    assert!(
+        key.observed["confirmation_title"]
+            .as_str()
+            .is_some_and(|t| !t.is_empty())
+    );
+    assert_eq!(
+        receipt(&repo, "L03", "L03-cleanup-topic").readback,
+        "absent"
+    );
+    assert_eq!(
+        receipt(&repo, "L08", "L08-provision-workspace").observed["provisioning"]["scope"],
+        json!("completed")
+    );
+    assert_eq!(
+        receipt(&repo, "L08", "L08-service-key-rotate").observed["one_time_secret"],
+        json!("held, then forgotten unseen")
+    );
+    assert_no_secret(&repo, &[CLIENT_SECRET, ONE_TIME, "gw-ONE-TIME"]);
+}
+
+#[tokio::test(flavor = "multi_thread")]
+async fn a_resource_this_run_did_not_create_is_never_updated_or_deleted() {
+    let s = served(Cloud::new()).await;
+    // The service refuses the pattern create: nothing labelled "pattern"
+    // exists, so its replace and cleanup are never sent.
+    let server = {
+        let cloud = std::sync::Arc::clone(&s.cloud);
+        s.fixture
+            .serve(crate::support::Reply::Route(std::sync::Arc::new(
+                move |seen| {
+                    if seen
+                        .request_line
+                        .starts_with("POST /dlp/v2/api/data-patterns ")
+                    {
+                        return crate::common::raw(400, &json!({"error": "refused"}));
+                    }
+                    cloud.lock().expect("cloud").route(seen)
+                },
+            )))
+            .await
+    };
+    let fixture = crate::common::Fixture {
+        management: Some(format!("https://localhost:{}", server.port)),
+        ..crate::common::Fixture {
+            ca: s.fixture.ca,
+            management: None,
+            academy: None,
+        }
+    };
+    let (repo, record) = fixture
+        .run(scope(), &["L04"], &management_secrets(&[]), Browser::idle())
+        .await;
+    let record = record.expect("run");
+    assert_eq!(
+        receipt(&repo, "L04", "L04-pattern-create").outcome,
+        "failed"
+    );
+    let replace = receipt(&repo, "L04", "L04-pattern-replace");
+    assert_eq!(replace.outcome, "blocked");
+    assert!(replace.detail.contains("nothing labelled pattern"));
+    assert_eq!(
+        receipt(&repo, "L04", "L04-cleanup-pattern").outcome,
+        "blocked"
+    );
+    let writes = s.cloud.lock().expect("cloud").writes.clone();
+    assert!(
+        !writes.iter().any(|w| w.contains("/data-patterns/")),
+        "{writes:?}"
+    );
+    assert!(!record.passed());
+}
+
+#[tokio::test(flavor = "multi_thread")]
+async fn a_lost_write_stops_the_run_and_leaves_its_resources_for_reconciliation() {
+    let s = served(Cloud::new()).await;
+    // The topic create is answered, then the profile create's reply is lost.
+    let lose = std::sync::Arc::new(std::sync::Mutex::new(true));
+    let server = {
+        let cloud = std::sync::Arc::clone(&s.cloud);
+        let lose = std::sync::Arc::clone(&lose);
+        s.fixture
+            .serve(crate::support::Reply::Route(std::sync::Arc::new(
+                move |seen| {
+                    let reply = cloud.lock().expect("cloud").route(seen);
+                    if seen
+                        .request_line
+                        .starts_with("POST /aisec/v1/mgmt/profile ")
+                        && std::mem::replace(&mut *lose.lock().expect("lose"), false)
+                    {
+                        return crate::support::Reply::Close;
+                    }
+                    reply
+                },
+            )))
+            .await
+    };
+    let mut fixture = crate::common::Fixture::new();
+    // Use the lossy server's origin (same CA as the first).
+    fixture.management = Some(format!("https://localhost:{}", server.port));
+    let fixture = crate::common::Fixture {
+        ca: s.fixture.ca,
+        ..fixture
+    };
+    let (repo, record) = fixture
+        .run(
+            scope(),
+            &["L03", "L04"],
+            &management_secrets(&[]),
+            Browser::idle(),
+        )
+        .await;
+    let record = record.expect("run");
+    let stop = record.stopped.expect("stopped");
+    assert!(stop.reconcile, "{stop:?}");
+    assert_eq!(stop.check, "L03-profile-create");
+    assert_eq!(
+        receipt(&repo, "L03", "L03-profile-create").outcome,
+        "needs-reconciliation"
+    );
+    let left = receipt(&repo, "L03", "L03-cleanup-topic");
+    assert_eq!(left.outcome, "blocked");
+    assert!(
+        left.observed["left_for_reconciliation"]
+            .to_string()
+            .contains("topics")
+    );
+    // L04 never ran.
+    assert_eq!(record.families[1].status, "blocked");
+}
+
+#[tokio::test(flavor = "multi_thread")]
+async fn a_blocked_write_back_is_recorded_with_its_reason_and_the_rest_still_runs() {
+    let s = served(Cloud::new()).await;
+    let mut value = scope();
+    value["families"]["L04"]["nonsecret"]["data_profile_blocked"] =
+        json!("the service refuses data profiles by ID");
+    let (repo, record) = s
+        .fixture
+        .run(value, &["L04"], &management_secrets(&[]), Browser::idle())
+        .await;
+    record.expect("run");
+    let data = receipt(&repo, "L04", "L04-data-profile-replace");
+    assert_eq!(data.outcome, "blocked");
+    assert_eq!(data.detail, "the service refuses data profiles by ID");
+    assert_eq!(
+        receipt(&repo, "L04", "L04-filtering-profile-replace").outcome,
+        "passed"
+    );
+    let writes = s.cloud.lock().expect("cloud").writes.clone();
+    assert!(
+        !writes.iter().any(|w| w.contains("/data-profiles/")),
+        "{writes:?}"
+    );
+}
diff --git a/crates/xtask/tests/live_run/cloud.rs b/crates/xtask/tests/live_run/cloud.rs
new file mode 100644
index 00000000..d442076f
--- /dev/null
+++ b/crates/xtask/tests/live_run/cloud.rs
@@ -0,0 +1,867 @@
+//! A synthetic management cloud on one TLS origin, assembled from the
+//! desktop-core fixtures' reply shapes: the OAuth grant (a designated and a
+//! restricted principal), AIRS management (profiles, topics, applications,
+//! keys and their writes), DLP, sessions, the Runtime overview, Red Team
+//! and Model/skill observations, AI Gateway (admin, data and IAM planes,
+//! with changes and provisioning), Gateway inference and the IAM access
+//! policies the API Client's managed collection reads and writes. A
+//! restricted principal is denied every request, or (`Restricted`) only
+//! its writes, or (a fault) nothing.
+
+use std::collections::BTreeMap;
+
+use serde_json::{Value, json};
+
+use crate::common::{TSG, parts, raw, restricted, token};
+use crate::support::{Reply, Seen};
+
+pub const DASH: &str = "/aisec/v1/mgmt/dashboard/v2/sessions/";
+pub const DATA: &str = "/ai_gw/v2";
+pub const ADMIN: &str = "/ai_gw/admin/v2";
+pub const IAM: &str = "/iam/v1";
+pub const RUNTIME: &str = "/rt/v1";
+pub const WS_A: &str = "16f7e90d-382a-4e78-b577-1b01eb5f8297";
+pub const PROVIDER: &str = "7e3a0000-0000-4000-8000-000000000001";
+pub const ROUTE: &str = "7e3a0000-0000-4000-8000-000000000002";
+pub const INTEGRATION: &str = "f6692544-3265-49be-9711-bbdcebc079eb";
+pub const RED_TEAM_SCAN: &str = "11111111-2222-4333-8444-555555555555";
+pub const ONE_TIME: &str = "SYNTHETIC-ONE-TIME-KEY-c25-";
+pub const MODEL: &str = "@openai-prod/gpt-4o";
+
+fn listing(rows: Vec<Value>) -> Value {
+    let total = rows.len();
+    json!({"object": "list", "total": total, "success": true, "has_more": false, "data": rows})
+}
+
+fn workspace(id: &str, name: &str, slug: &str) -> Value {
+    json!({"id": id, "slug": slug, "name": name, "icon": null, "description": null,
+           "created_at": "2026-10-01T00:00:00Z", "last_updated_at": "2026-10-02T00:00:00Z",
+           "is_default": 0, "status": "active", "scope_name": format!("scope-{slug}"),
+           "object": "workspace", "defaults": {"config_id": ROUTE, "allow_config_override": true},
+           "usage_limits": null, "rate_limits": null})
+}
+
+fn provider(id: &str, ws: &str, name: &str) -> Value {
+    json!({"id": id, "ai_provider_name": "openai", "slug": name, "name": name,
+           "usage_limits": null, "status": "active", "note": null, "created_at": "2026-10-01T00:00:00Z",
+           "expires_at": null, "last_reset_at": null, "rate_limits": [],
+           "integration_id": INTEGRATION, "object": "provider", "workspace_id": ws})
+}
+
+fn route(id: &str, ws: &str, config: &Value) -> Value {
+    json!({"id": id, "name": "default-route", "slug": "default-route", "organisation_id": "org-1",
+           "is_default": 1, "status": "active", "owner_id": "owner-1", "updated_by": "owner-1",
+           "created_at": "2026-10-01T00:00:00Z", "last_updated_at": "2026-10-02T00:00:00Z",
+           "workspace_id": ws, "object": "config", "format": "json", "type": "ROUTING",
+           "version_id": "v-1", "config": config.to_string()})
+}
+
+fn guardrail(id: &str, ws: &str) -> Value {
+    json!({"id": id, "name": "pii", "slug": "pii", "organisation_id": "org-1", "status": "active",
+           "owner_id": "owner-1", "updated_by": null, "created_at": "2026-10-01T00:00:00Z",
+           "last_updated_at": "2026-10-02T00:00:00Z", "workspace_id": ws, "object": "guardrail",
+           "checks": [], "actions": {"deny": true, "async": false, "sequential": false},
+           "version_id": "v-1"})
+}
+
+fn key(id: &str, ws: &str, name: &str) -> Value {
+    json!({"id": id, "name": name, "object": "api-key", "status": "active",
+           "scopes": ["completions.write"], "workspace_id": ws})
+}
+
+fn integration() -> Value {
+    json!({"id": INTEGRATION, "name": "OpenAI", "owner_id": "owner-1", "status": "active",
+           "created_at": "2026-10-01T00:00:00Z", "last_updated_at": null, "slug": "openai",
+           "description": null, "workspace_id": null, "ai_provider_id": "openai",
+           "object": "integration", "configurations": "{}"})
+}
+
+fn merge(target: &mut Value, edits: &Value) {
+    if let (Some(target), Some(edits)) = (target.as_object_mut(), edits.as_object()) {
+        for (k, v) in edits {
+            target.insert(k.clone(), v.clone());
+        }
+    }
+}
+
+fn no_content() -> Reply {
+    Reply::Raw {
+        head: "HTTP/1.1 204 No Content\r\ncontent-length: 0\r\nconnection: close".into(),
+        body: Vec::new(),
+    }
+}
+
+fn sse(parts: Vec<Vec<u8>>) -> Reply {
+    Reply::Stream {
+        head: "HTTP/1.1 200 OK\r\ncontent-type: text/event-stream\r\ncache-control: no-cache\r\nconnection: close"
+            .into(),
+        parts: parts.into_iter().map(|p| (0, p)).collect(),
+        hang: false,
+    }
+}
+
+fn chunk(id: &str, text: Option<&str>, finish: Option<&str>, usage: Option<Value>) -> Vec<u8> {
+    let mut delta = json!({});
+    if let Some(text) = text {
+        delta["content"] = json!(text);
+    }
+    let mut event = json!({"id": id, "object": "chat.completion.chunk", "created": 1_760_000_000,
+        "model": "gpt-4o", "choices": [{"index": 0, "delta": delta, "finish_reason": finish}]});
+    if let Some(usage) = usage {
+        event["usage"] = usage;
+    }
+    format!("data: {event}\n\n").into_bytes()
+}
+
+/// How the inference endpoint answers a stream.
+#[derive(Clone)]
+pub enum Chat {
+    /// A short complete answer with usage.
+    Text,
+    /// Many paced chunks (long enough to be stopped).
+    Paced,
+}
+
+/// What the restricted principal may do.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum Restricted {
+    /// Every request is refused (403).
+    DenyAll,
+    /// Reads succeed; writes are refused (403).
+    ReadOnly,
+    /// A fault: its writes are applied too.
+    WritesAllowed,
+}
+
+pub struct Cloud {
+    serial: u32,
+    pub restricted: Restricted,
+    /// Whether the Red Team scan list shows the seeded completed scan.
+    pub red_team_scans: bool,
+    pub profiles: Vec<Value>,
+    pub topics: Vec<Value>,
+    pub apps: Vec<Value>,
+    pub keys: Vec<Value>,
+    pub dlp: BTreeMap<&'static str, Vec<Value>>,
+    pub workspaces: Vec<Value>,
+    pub items: BTreeMap<&'static str, Vec<Value>>,
+    pub scopes: BTreeMap<String, Value>,
+    pub policies: Vec<Value>,
+    pub chat: Chat,
+    /// Usage the inference endpoint reports for a complete answer.
+    pub tokens: u64,
+    /// Every write (method and path) this cloud accepted.
+    pub writes: Vec<String>,
+}
+
+impl Cloud {
+    pub fn new() -> Self {
+        let mut dlp = BTreeMap::new();
+        dlp.insert("data-patterns", Vec::new());
+        dlp.insert(
+            "data-profiles",
+            vec![json!({"id": "dprof-1", "name": "Payments", "detection_rules": [
+                {"rule_type": "expression_tree", "expression_tree": {"rule_item": {
+                    "detection_technique": "regex", "id": "pattern-1", "name": "Card numbers", "version": 1,
+                    "match_type": "include", "confidence_level": "high", "occurrence_operator_type": "any",
+                    "supported_confidence_levels": ["low", "high"]}}}]})],
+        );
+        dlp.insert(
+            "data-filtering-profiles",
+            vec![json!({"id": "filter-1", "name": "Default", "file_based": false, "non_file_based": true})],
+        );
+        dlp.insert("dictionaries", Vec::new());
+        let mut items: BTreeMap<&'static str, Vec<Value>> = BTreeMap::new();
+        items.insert("providers", vec![provider(PROVIDER, WS_A, "openai-prod")]);
+        items.insert(
+            "configs",
+            vec![route(
+                ROUTE,
+                WS_A,
+                &json!({"targets": [{"provider": "@openai-prod"}]}),
+            )],
+        );
+        items.insert(
+            "guardrails",
+            vec![guardrail("7e3a0000-0000-4000-8000-000000000003", WS_A)],
+        );
+        items.insert(
+            "api-keys/service",
+            vec![key("7e3a0000-0000-4000-8000-000000000004", WS_A, "ci-key")],
+        );
+        items.insert("api-keys/user", Vec::new());
+        let mut scopes = BTreeMap::new();
+        scopes.insert(
+            "scope-team-a".to_owned(),
