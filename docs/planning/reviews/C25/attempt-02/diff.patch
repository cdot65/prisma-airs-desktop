+    let (repo, record) = run(&s, value, &["L01"]).await;
+    let record = record.expect("run");
+    let stop = record.stopped.expect("stopped");
+    assert_eq!(stop.check, "L01-denied");
+    assert!(stop.reason.contains("unexpected cost"));
