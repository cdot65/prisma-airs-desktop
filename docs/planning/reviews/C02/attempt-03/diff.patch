diff --git a/crates/desktop-core/src/runtime.rs b/crates/desktop-core/src/runtime.rs
new file mode 100644
index 0000000..07501ab
--- /dev/null
+++ b/crates/desktop-core/src/runtime.rs
@@ -0,0 +1,478 @@
+//! Bounded remote operations: Queued → DispatchClaimed → Settled.
+//!
+//! The registry lives inside the authority state, so context retirement,
+//! cancellation and dispatch claiming share one lock (DESIGN §1). Admission
+//! refuses with `Busy` when the queue is full by count or bytes; an accepted
+//! operation is never dropped. Work starts on the application's Tokio runtime
+//! only after it is claimed for dispatch. Queued work that is cancelled,
+//! retired or past its deadline settles NotSent. Once dispatch may have
+//! begun, cancellation or timeout alone yields Unknown unless the work itself
+//! reports stronger evidence. Settlement is single-use; late completions are
+//! ignored. Nothing here retries or replays work.
+
+use std::collections::{HashMap, VecDeque};
+use std::future::Future;
+use std::pin::Pin;
+use std::time::Duration;
+
+use serde::Serialize;
+use tokio::time::Instant;
+use tokio_util::sync::CancellationToken;
+use ts_rs::TS;
+
+use crate::authority::Refusal;
+
+/// Explicit operation bounds (DESIGN: start at 4 active, 64 queued, 64MiB).
+#[derive(Clone, Copy, Debug)]
+pub struct OperationLimits {
+    pub max_active: usize,
+    pub max_queued: usize,
+    pub max_queued_bytes: usize,
+    /// Interactive deadline, measured from submission.
+    pub interactive_budget: Duration,
+    /// Settled results retained for observation.
+    pub retained_settled: usize,
+}
+
+impl Default for OperationLimits {
+    fn default() -> Self {
+        Self {
+            max_active: 4,
+            max_queued: 64,
+            max_queued_bytes: 64 * 1024 * 1024,
+            interactive_budget: Duration::from_secs(60),
+            retained_settled: 256,
+        }
+    }
+}
+
+/// Native-issued operation reference.
+#[derive(Clone, Debug, PartialEq, Eq, Hash, Serialize, TS)]
+#[serde(transparent)]
+pub struct OperationId(String);
+
+impl OperationId {
+    pub fn as_str(&self) -> &str {
+        &self.0
+    }
+}
+
+/// What is known about the remote effect of an operation.
+#[derive(Clone, Copy, Debug, PartialEq, Eq, Serialize, TS)]
+#[serde(rename_all = "camelCase")]
+pub enum Outcome {
+    /// Nothing reached the remote service.
+    NotSent,
+    /// The service reliably refused it without effect.
+    Rejected,
+    /// The service reported completion.
+    Completed,
+    /// It may or may not have taken effect.
+    Unknown,
+}
+
+/// Why the desktop stopped waiting, separately from the remote outcome.
+#[derive(Clone, Copy, Debug, PartialEq, Eq, Serialize, TS)]
+#[serde(rename_all = "camelCase")]
+pub enum StopReason {
+    Cancelled,
+    ContextRetired,
+    Deadline,
+    ShuttingDown,
+}
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq, Serialize, TS)]
+#[serde(rename_all = "camelCase")]
+pub struct Settlement {
+    pub outcome: Outcome,
+    pub stop: Option<StopReason>,
+}
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum OperationState {
+    Queued,
+    DispatchClaimed,
+    Settled(Settlement),
+}
+
+/// Handed to work when it is claimed for dispatch.
+pub struct Claim {
+    pub cancel: CancellationToken,
+    pub deadline: Instant,
+}
+
+pub type WorkFuture = Pin<Box<dyn Future<Output = Outcome> + Send>>;
+/// One remote operation: started once, with its claim.
+pub type Work = Box<dyn FnOnce(Claim) -> WorkFuture + Send>;
+
+struct Queued {
+    id: OperationId,
+    context: String,
+    bytes: usize,
+    deadline: Instant,
+    cancelled: Option<StopReason>,
+    work: Work,
+}
+
+struct Active {
+    context: String,
+    cancel: CancellationToken,
+    stop: Option<StopReason>,
+}
+
+/// Work to start outside the lock (see [`spawn`]).
+pub struct Start {
+    pub id: OperationId,
+    pub claim: Claim,
+    pub work: Work,
+}
+
+/// The operation registry.
+pub struct Operations {
+    limits: OperationLimits,
+    issued: u64,
+    queue: VecDeque<Queued>,
+    queued_bytes: usize,
+    active: HashMap<OperationId, Active>,
+    settled: VecDeque<(OperationId, Settlement)>,
+}
+
+impl Operations {
+    pub fn new(limits: OperationLimits) -> Self {
+        Self {
+            limits,
+            issued: 0,
+            queue: VecDeque::new(),
+            queued_bytes: 0,
+            active: HashMap::new(),
+            settled: VecDeque::new(),
+        }
+    }
+
+    pub fn limits(&self) -> OperationLimits {
+        self.limits
+    }
+
+    /// Admits work bound to `context`. The deadline is measured from now.
+    /// Returns its reference and any work that may start immediately.
+    pub fn admit(
+        &mut self,
+        context: &str,
+        bytes: usize,
+        work: Work,
+        now: Instant,
+    ) -> Result<(OperationId, Vec<Start>), Refusal> {
+        let full = self.queue.len() >= self.limits.max_queued
+            || self.queued_bytes.saturating_add(bytes) > self.limits.max_queued_bytes;
+        if full || bytes > self.limits.max_queued_bytes {
+            return Err(Refusal::Busy);
+        }
+        self.issued += 1;
+        let id = OperationId(format!("op-{}", self.issued));
+        self.queue.push_back(Queued {
+            id: id.clone(),
+            context: context.to_owned(),
+            bytes,
+            deadline: now + self.limits.interactive_budget,
+            cancelled: None,
+            work,
+        });
+        self.queued_bytes += bytes;
+        Ok((id, self.claim(now)))
+    }
+
+    /// Claims queued work for dispatch while capacity allows.
+    fn claim(&mut self, now: Instant) -> Vec<Start> {
+        let mut starts = Vec::new();
+        while self.active.len() < self.limits.max_active {
+            let Some(next) = self.queue.pop_front() else {
+                break;
+            };
+            self.queued_bytes -= next.bytes;
+            let stop = next
+                .cancelled
+                .or_else(|| (now >= next.deadline).then_some(StopReason::Deadline));
+            if let Some(stop) = stop {
+                self.record(
+                    next.id,
+                    Settlement {
+                        outcome: Outcome::NotSent,
+                        stop: Some(stop),
+                    },
+                );
+                continue;
+            }
+            let cancel = CancellationToken::new();
+            self.active.insert(
+                next.id.clone(),
+                Active {
+                    context: next.context,
+                    cancel: cancel.clone(),
+                    stop: None,
+                },
+            );
+            starts.push(Start {
+                id: next.id,
+                claim: Claim {
+                    cancel,
+                    deadline: next.deadline,
+                },
+                work: next.work,
+            });
+        }
+        starts
+    }
+
+    /// Settles claimed work once; later or unknown completions are ignored.
+    pub fn complete(&mut self, id: &OperationId, outcome: Outcome, now: Instant) -> Vec<Start> {
+        if let Some(active) = self.active.remove(id) {
+            self.record(
+                id.clone(),
+                Settlement {
+                    outcome,
+                    stop: active.stop,
+                },
+            );
+        }
+        self.claim(now)
+    }
+
+    /// Stops queued work (NotSent) or signals claimed work. Returns whether
+    /// the operation was still unsettled.
+    pub fn cancel(
+        &mut self,
+        id: &OperationId,
+        reason: StopReason,
+        now: Instant,
+    ) -> (bool, Vec<Start>) {
+        if let Some(queued) = self.queue.iter_mut().find(|q| &q.id == id) {
+            queued.cancelled = Some(reason);
+            return (true, self.settle_cancelled_queue(now));
+        }
+        if let Some(active) = self.active.get_mut(id) {
+            active.stop.get_or_insert(reason);
+            active.cancel.cancel();
+            return (true, Vec::new());
+        }
+        (false, Vec::new())
+    }
+
+    /// Retires every operation not bound to `keep`: queued work settles
+    /// NotSent, claimed work is cancelled (its outcome then comes from the
+    /// work, normally Unknown once dispatch began).
+    pub fn retire_contexts(&mut self, keep: Option<&str>, now: Instant) -> Vec<Start> {
+        for queued in self.queue.iter_mut() {
+            if keep != Some(queued.context.as_str()) {
+                queued.cancelled.get_or_insert(StopReason::ContextRetired);
+            }
+        }
+        for active in self.active.values_mut() {
+            if keep != Some(active.context.as_str()) {
+                active.stop.get_or_insert(StopReason::ContextRetired);
+                active.cancel.cancel();
+            }
+        }
+        self.settle_cancelled_queue(now)
+    }
+
+    fn settle_cancelled_queue(&mut self, now: Instant) -> Vec<Start> {
+        let mut kept = VecDeque::new();
+        while let Some(queued) = self.queue.pop_front() {
+            match queued.cancelled {
+                Some(stop) => {
+                    self.queued_bytes -= queued.bytes;
+                    self.record(
+                        queued.id,
+                        Settlement {
+                            outcome: Outcome::NotSent,
+                            stop: Some(stop),
+                        },
+                    );
+                }
+                None => kept.push_back(queued),
+            }
+        }
+        self.queue = kept;
+        self.claim(now)
+    }
+
+    fn record(&mut self, id: OperationId, settlement: Settlement) {
+        self.settled.push_back((id, settlement));
+        while self.settled.len() > self.limits.retained_settled.max(1) {
+            self.settled.pop_front();
+        }
+    }
+
+    pub fn state(&self, id: &OperationId) -> Option<OperationState> {
+        if self.queue.iter().any(|q| &q.id == id) {
+            return Some(OperationState::Queued);
+        }
+        if self.active.contains_key(id) {
+            return Some(OperationState::DispatchClaimed);
+        }
+        self.settled
+            .iter()
+            .rev()
+            .find(|(s, _)| s == id)
+            .map(|(_, settlement)| OperationState::Settled(*settlement))
+    }
+
+    pub fn queued(&self) -> (usize, usize) {
+        (self.queue.len(), self.queued_bytes)
+    }
+
+    pub fn active(&self) -> usize {
+        self.active.len()
+    }
+}
+
+/// Runs claimed work on the current Tokio runtime and reports its outcome.
+/// The deadline is enforced here too: work still running at its deadline is
+/// cancelled and settles Unknown (dispatch may have begun).
+pub fn spawn<F>(start: Start, settle: F)
+where
+    F: FnOnce(OperationId, Outcome, Option<StopReason>) + Send + 'static,
+{
+    let Start { id, claim, work } = start;
+    let deadline = claim.deadline;
+    let cancel = claim.cancel.clone();
+    tokio::spawn(async move {
+        let future = work(claim);
+        tokio::select! {
+            outcome = future => settle(id, outcome, None),
+            () = tokio::time::sleep_until(deadline) => {
+                cancel.cancel();
+                settle(id, Outcome::Unknown, Some(StopReason::Deadline));
+            }
+        }
+    });
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn idle() -> Work {
+        Box::new(|_claim| Box::pin(async { Outcome::Completed }))
+    }
+
+    fn limits(active: usize, queued: usize, bytes: usize) -> OperationLimits {
+        OperationLimits {
+            max_active: active,
+            max_queued: queued,
+            max_queued_bytes: bytes,
+            ..OperationLimits::default()
+        }
+    }
+
+    #[test]
+    fn admission_is_bounded_by_count_and_bytes_without_dropping_work() {
+        let now = Instant::now();
+        let mut ops = Operations::new(limits(1, 2, 100));
+        let (first, starts) = ops.admit("cx", 10, idle(), now).expect("first");
+        assert_eq!(starts.len(), 1, "capacity starts it at once");
+        let (second, _) = ops.admit("cx", 60, idle(), now).expect("queued");
+        assert_eq!(
+            ops.admit("cx", 50, idle(), now).err(),
+            Some(Refusal::Busy),
+            "bytes"
+        );
+        let (third, _) = ops.admit("cx", 40, idle(), now).expect("queued");
+        assert_eq!(
+            ops.admit("cx", 0, idle(), now).err(),
+            Some(Refusal::Busy),
+            "count"
+        );
+        assert_eq!(ops.state(&first), Some(OperationState::DispatchClaimed));
+        assert_eq!(ops.state(&second), Some(OperationState::Queued));
+        let next = ops.complete(&first, Outcome::Completed, now);
+        assert_eq!(
+            next.iter().map(|s| s.id.clone()).collect::<Vec<_>>(),
+            vec![second.clone()]
+        );
+        assert_eq!(ops.state(&third), Some(OperationState::Queued));
+    }
+
+    #[test]
+    fn retirement_settles_queued_not_sent_and_cancels_claimed() {
+        let now = Instant::now();
+        let mut ops = Operations::new(limits(1, 8, 1000));
+        let (claimed, starts) = ops.admit("old", 1, idle(), now).expect("claimed");
+        let token = starts[0].claim.cancel.clone();
+        let (queued, _) = ops.admit("old", 1, idle(), now).expect("queued");
+        let (other, _) = ops.admit("new", 1, idle(), now).expect("queued");
+        let started = ops.retire_contexts(Some("new"), now);
+        assert!(token.is_cancelled());
+        assert_eq!(
+            ops.state(&queued),
+            Some(OperationState::Settled(Settlement {
+                outcome: Outcome::NotSent,
+                stop: Some(StopReason::ContextRetired)
+            }))
+        );
+        assert!(started.is_empty(), "the claimed slot is still busy");
+        let next = ops.complete(&claimed, Outcome::Unknown, now);
+        assert_eq!(
+            ops.state(&claimed),
+            Some(OperationState::Settled(Settlement {
+                outcome: Outcome::Unknown,
+                stop: Some(StopReason::ContextRetired)
+            }))
+        );
+        assert_eq!(next[0].id, other);
+    }
+
+    #[test]
+    fn settlement_is_single_use_and_queued_deadlines_are_not_sent() {
+        let now = Instant::now();
+        let mut ops = Operations::new(limits(1, 8, 1000));
+        let (claimed, _) = ops.admit("cx", 1, idle(), now).expect("claimed");
+        let (late, _) = ops.admit("cx", 1, idle(), now).expect("queued");
+        let later = now + OperationLimits::default().interactive_budget + Duration::from_secs(1);
+        let next = ops.complete(&claimed, Outcome::Completed, later);
+        assert!(next.is_empty(), "past its deadline before dispatch");
+        assert_eq!(
+            ops.state(&late),
+            Some(OperationState::Settled(Settlement {
+                outcome: Outcome::NotSent,
+                stop: Some(StopReason::Deadline)
+            }))
+        );
+        ops.complete(&claimed, Outcome::Rejected, later);
+        assert_eq!(
+            ops.state(&claimed),
+            Some(OperationState::Settled(Settlement {
+                outcome: Outcome::Completed,
+                stop: None
+            })),
+            "a duplicate completion cannot change the settlement"
+        );
+    }
+
+    #[test]
+    fn cancelling_queued_work_is_not_sent_and_claimed_work_is_signalled() {
+        let now = Instant::now();
+        let mut ops = Operations::new(limits(1, 8, 1000));
+        let (claimed, starts) = ops.admit("cx", 1, idle(), now).expect("claimed");
+        let (queued, _) = ops.admit("cx", 1, idle(), now).expect("queued");
+        assert!(ops.cancel(&queued, StopReason::Cancelled, now).0);
+        assert_eq!(
+            ops.state(&queued),
+            Some(OperationState::Settled(Settlement {
+                outcome: Outcome::NotSent,
+                stop: Some(StopReason::Cancelled)
+            }))
+        );
+        assert!(ops.cancel(&claimed, StopReason::Cancelled, now).0);
+        assert!(starts[0].claim.cancel.is_cancelled());
+        assert_eq!(
+            ops.state(&claimed),
+            Some(OperationState::DispatchClaimed),
+            "awaits the work's own outcome"
+        );
+        assert!(
+            !ops.cancel(&queued, StopReason::Cancelled, now).0,
+            "already settled"
+        );
+    }
+}
diff --git a/crates/desktop-core/src/scan.rs b/crates/desktop-core/src/scan.rs
new file mode 100644
index 0000000..f0ea0ff
--- /dev/null
+++ b/crates/desktop-core/src/scan.rs
@@ -0,0 +1,114 @@
+//! SDK scan client binding for one credential/context generation.
+//!
+//! Each admitted credential generation gets its own SDK `Session`, cancelled
+//! when that generation retires; a replacement never reuses a cancelled
+//! session. The client allows exactly the credential's approved origin, uses
+//! the app-owned transport and the explicit first-scan limits, and every
+//! request disables business-operation retries. The scan operation itself is
+//! introduced in C03; C02 qualifies this binding with fixture transports.
+
+use std::sync::Arc;
+use std::time::Duration;
+
+use scm_sdk::auth::Authentication;
+use scm_sdk::transport::Transport;
+use scm_sdk::{Client, Endpoint, Limits, OriginPolicy, RequestOptions, Secret, Session};
+use zeroize::Zeroizing;
+
+/// Serialized scan request ceiling (matches the SDK default).
+pub const MAX_REQUEST_BYTES: usize = 8 * 1024 * 1024;
+/// Decoded scan response ceiling.
+pub const MAX_RESPONSE_BYTES: usize = 16 * 1024 * 1024;
+/// Interactive deadline for one scan, from submission.
+pub const INTERACTIVE_DEADLINE: Duration = Duration::from_secs(60);
+
+/// The explicit first-scan SDK limits.
+pub fn scan_limits() -> Limits {
+    let mut limits = Limits::default();
+    limits.max_request_bytes = MAX_REQUEST_BYTES;
+    limits.max_response_bytes = MAX_RESPONSE_BYTES;
+    limits.operation_timeout = INTERACTIVE_DEADLINE;
+    limits.max_retries = 0;
+    limits
+}
+
+/// Why a binding could not be created (sanitized).
+#[derive(Clone, Copy, Debug, PartialEq, Eq, thiserror::Error)]
+pub enum BindingError {
+    #[error("the scan destination is not an approved HTTPS origin")]
+    Destination,
+    #[error("the scan key is not usable")]
+    Credential,
+    #[error("the scan client could not be configured")]
+    Client,
+}
+
+/// An SDK client bound to one credential generation and its destination.
+pub struct ScanBinding {
+    client: Client,
+    session: Session,
+}
+
+impl ScanBinding {
+    /// Builds the binding. `key` is consumed; the SDK keeps it in its own
+    /// zeroizing `Secret`.
+    pub fn new(
+        origin: &str,
+        key: Zeroizing<String>,
+        transport: Arc<dyn Transport>,
+    ) -> Result<Self, BindingError> {
+        let endpoint = Endpoint::parse(origin).map_err(|_| BindingError::Destination)?;
+        if endpoint.origin() != origin {
+            return Err(BindingError::Destination);
+        }
+        let secret = Secret::new(key.as_str()).map_err(|_| BindingError::Credential)?;
+        drop(key);
+        let authentication =
+            Authentication::scan(Some(secret), None).map_err(|_| BindingError::Credential)?;
+        let session = Session::new();
+        let client = Client::builder(endpoint.clone())
+            .authentication(authentication)
+            .transport(transport)
+            .destination_policy(Arc::new(OriginPolicy::new([endpoint])))
+            .limits(scan_limits())
+            .session(session.clone())
+            .build()
+            .map_err(|_| BindingError::Client)?;
+        Ok(Self { client, session })
+    }
+
+    pub fn client(&self) -> &Client {
+        &self.client
+    }
+
+    /// Per-request options: the remaining interactive budget, no retries.
+    pub fn request_options(remaining: Duration) -> Result<RequestOptions, BindingError> {
+        RequestOptions::with_timeout(remaining.max(Duration::from_millis(1)))
+            .and_then(|o| o.with_retries(0))
+            .map_err(|_| BindingError::Client)
+    }
+
+    /// Cancels the generation's session (retirement); in-flight requests stop.
+    pub fn retire(&self) {
+        self.session.cancel();
+    }
+
+    pub fn is_retired(&self) -> bool {
+        self.session.is_cancelled()
+    }
+}
+
+impl Drop for ScanBinding {
+    fn drop(&mut self) {
+        self.session.cancel();
+    }
+}
+
+/// A key the SDK would accept in its scan header, checked at entry so an
+/// unusable key is refused before anything is stored.
+pub fn key_is_usable(key: &str) -> bool {
+    Secret::new(key)
+        .ok()
+        .and_then(|s| Authentication::scan(Some(s), None).ok())
+        .is_some()
+}
diff --git a/crates/desktop-core/src/store.rs b/crates/desktop-core/src/store.rs
new file mode 100644
index 0000000..40f8ba5
--- /dev/null
+++ b/crates/desktop-core/src/store.rs
@@ -0,0 +1,475 @@
+//! Rust-owned application storage for nonsecret desktop state.
+//!
+//! One versioned JSON document holds the appearance preference, tenant
+//! profiles, the active tenant, the Keychain credential index (record IDs and
+//! their bound destinations, never secrets) and the pending cleanup ledger.
+//! Session-only credentials are never written. The file store uses an
+//! owner-only directory and file, atomic replacement (temporary file, fsync,
+//! rename, directory fsync) and an exclusive lock file held for the store's
+//! lifetime, so a second instance cannot interleave writes. An unreadable
+//! document is reported as corrupt and left untouched until the operator
+//! explicitly resets local data.
+
+use std::collections::BTreeSet;
+use std::fs::{self, File, OpenOptions};
+use std::io::{Read, Write};
+use std::path::{Path, PathBuf};
+
+use serde::{Deserialize, Serialize};
+
+use crate::tenants::{TenantId, TenantProfile};
+use crate::vault::RecordId;
+use crate::wire::Theme;
+
+/// Schema of the persisted state document.
+pub const STATE_SCHEMA: &str = "prisma-airs-desktop-v2/state/1";
+/// Ceiling for the persisted document.
+pub const MAX_STATE_BYTES: u64 = 4 * 1024 * 1024;
+const STATE_FILE: &str = "state.json";
+const LOCK_FILE: &str = "state.lock";
+
+/// A Keychain credential the core may use after restart.
+#[derive(Clone, Debug, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(rename_all = "camelCase", deny_unknown_fields)]
+pub struct StoredCredential {
+    pub record: RecordId,
+    pub tenant: TenantId,
+    /// The approved origin this credential may be sent to.
+    pub destination: String,
+}
+
+/// The persisted document.
+#[derive(Clone, Debug, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(rename_all = "camelCase", deny_unknown_fields)]
+pub struct PersistedState {
+    pub schema: String,
+    pub appearance: Theme,
+    pub tenants: Vec<TenantProfile>,
+    pub active_tenant: Option<TenantId>,
+    pub credentials: Vec<StoredCredential>,
+    /// Keychain records to delete (replaced, signed out, orphaned or reset).
+    pub pending_cleanup: Vec<RecordId>,
+}
+
+impl Default for PersistedState {
+    fn default() -> Self {
+        Self {
+            schema: STATE_SCHEMA.to_owned(),
+            appearance: Theme::System,
+            tenants: Vec::new(),
+            active_tenant: None,
+            credentials: Vec::new(),
+            pending_cleanup: Vec::new(),
+        }
+    }
+}
+
+impl PersistedState {
+    /// Structural checks beyond the schema: unique IDs and references to
+    /// existing tenants with valid profiles.
+    pub fn is_consistent(&self) -> bool {
+        let mut ids = BTreeSet::new();
+        let tenants_ok = self.tenants.iter().all(|t| {
+            ids.insert(t.id.clone())
+                && crate::tenants::ProfileDraft {
+                    label: t.label.clone(),
+                    tsg_id: t.tsg_id.clone(),
+                    destination: t.destination.clone(),
+                }
+                .validate()
+                .is_some_and(|d| {
+                    d.label == t.label && d.tsg_id == t.tsg_id && d.destination == t.destination
+                })
+        });
+        let mut records = BTreeSet::new();
+        let credentials_ok = self.credentials.iter().all(|c| {
+            records.insert(c.record.clone())
+                && self
+                    .tenants
+                    .iter()
+                    .any(|t| t.id == c.tenant && t.destination.origin() == c.destination)
+        });
+        let one_per_tenant = {
+            let mut seen = BTreeSet::new();
+            self.credentials
+                .iter()
+                .all(|c| seen.insert(c.tenant.clone()))
+        };
+        self.schema == STATE_SCHEMA
+            && tenants_ok
+            && credentials_ok
+            && one_per_tenant
+            && self.active_tenant.as_ref().is_none_or(|a| ids.contains(a))
+    }
+}
+
+/// Why the store could not be used. Sanitized.
+#[derive(Clone, Copy, Debug, PartialEq, Eq, thiserror::Error)]
+pub enum StoreError {
+    #[error("local desktop data is unreadable")]
+    Corrupt,
+    /// Nothing was changed (the failure happened before the replacement).
+    #[error("local desktop data is unavailable")]
+    Unavailable,
+    /// The document was replaced (or removed) but the directory could not be
+    /// synced, so its durability across a crash is not confirmed. The change
+    /// is visible and is not rolled back.
+    #[error("local desktop data was written but not confirmed durable")]
+    Unconfirmed,
+}
+
+/// Failure points that storage fault tests can inject (fixture builds only).
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum StoreFault {
+    /// Fail after writing the temporary file, before the rename.
+    BeforeRename,
+    /// Fail after the rename, at the directory sync.
+    AfterRename,
+}
+
+/// Persistence for [`PersistedState`].
+pub trait AppStore: Send + Sync + 'static {
+    /// The saved document, or `None` before the first save.
+    fn load(&self) -> Result<Option<PersistedState>, StoreError>;
+    /// Atomically replaces the saved document.
+    fn save(&self, state: &PersistedState) -> Result<(), StoreError>;
+    /// Removes the saved document (explicit operator reset).
+    fn reset(&self) -> Result<(), StoreError>;
+}
+
+/// File-backed store under the v2 data root.
+pub struct FileStore {
+    dir: PathBuf,
+    // Held for the store's lifetime: the exclusive cross-process lease.
+    _lock: File,
+    #[cfg(any(test, feature = "test-fixtures"))]
+    fault: std::sync::Mutex<Option<StoreFault>>,
+}
+
+impl FileStore {
+    /// Opens (creating) the owner-only data directory and takes its lease.
+    pub fn open(dir: &Path) -> Result<Self, StoreError> {
+        use std::os::unix::fs::{DirBuilderExt, PermissionsExt};
+        fs::DirBuilder::new()
+            .recursive(true)
+            .mode(0o700)
+            .create(dir)
+            .map_err(|_| StoreError::Unavailable)?;
+        let meta = fs::symlink_metadata(dir).map_err(|_| StoreError::Unavailable)?;
+        if !meta.is_dir() {
+            return Err(StoreError::Unavailable);
+        }
+        fs::set_permissions(dir, fs::Permissions::from_mode(0o700))
+            .map_err(|_| StoreError::Unavailable)?;
+        let lock = open_owner_only(&dir.join(LOCK_FILE), false)?;
+        lock.try_lock().map_err(|_| StoreError::Unavailable)?;
+        Ok(Self {
+            dir: dir.to_owned(),
+            _lock: lock,
+            #[cfg(any(test, feature = "test-fixtures"))]
+            fault: std::sync::Mutex::new(None),
+        })
+    }
+
+    fn path(&self) -> PathBuf {
+        self.dir.join(STATE_FILE)
+    }
+
+    #[cfg(any(test, feature = "test-fixtures"))]
+    pub fn inject(&self, fault: Option<StoreFault>) {
+        if let Ok(mut f) = self.fault.lock() {
+            *f = fault;
+        }
+    }
+
+    #[cfg(any(test, feature = "test-fixtures"))]
+    fn faulted(&self, point: StoreFault) -> bool {
+        self.fault
+            .lock()
+            .map(|f| *f == Some(point))
+            .unwrap_or(false)
+    }
+
+    #[cfg(not(any(test, feature = "test-fixtures")))]
+    fn faulted(&self, _: StoreFault) -> bool {
+        false
+    }
+
+    fn sync_dir(&self) -> Result<(), StoreError> {
+        if self.faulted(StoreFault::AfterRename) {
+            return Err(StoreError::Unconfirmed);
+        }
+        File::open(&self.dir)
+            .and_then(|d| d.sync_all())
+            .map_err(|_| StoreError::Unconfirmed)
+    }
+}
+
+fn open_owner_only(path: &Path, truncate: bool) -> Result<File, StoreError> {
+    use std::os::unix::fs::OpenOptionsExt;
+    OpenOptions::new()
+        .read(true)
+        .write(true)
+        .create(true)
+        .truncate(truncate)
+        .mode(0o600)
+        .custom_flags(libc_nofollow())
+        .open(path)
+        .map_err(|_| StoreError::Unavailable)
+}
+
+/// `O_NOFOLLOW` (macOS `<sys/fcntl.h>` value): never open through a planted
+/// symlink. The desktop targets macOS only.
+#[cfg(target_os = "macos")]
+fn libc_nofollow() -> i32 {
+    0x0100
+}
+
+impl AppStore for FileStore {
+    fn load(&self) -> Result<Option<PersistedState>, StoreError> {
+        let path = self.path();
+        let meta = match fs::symlink_metadata(&path) {
+            Ok(meta) => meta,
+            Err(e) if e.kind() == std::io::ErrorKind::NotFound => return Ok(None),
+            Err(_) => return Err(StoreError::Unavailable),
+        };
+        if !meta.is_file() || meta.len() > MAX_STATE_BYTES {
+            return Err(StoreError::Corrupt);
+        }
+        let mut bytes = Vec::new();
+        File::open(&path)
+            .and_then(|f| f.take(MAX_STATE_BYTES + 1).read_to_end(&mut bytes))
+            .map_err(|_| StoreError::Unavailable)?;
+        let state: PersistedState =
+            serde_json::from_slice(&bytes).map_err(|_| StoreError::Corrupt)?;
+        if !state.is_consistent() {
+            return Err(StoreError::Corrupt);
+        }
+        Ok(Some(state))
+    }
+
+    fn save(&self, state: &PersistedState) -> Result<(), StoreError> {
+        let bytes = serde_json::to_vec_pretty(state).map_err(|_| StoreError::Unavailable)?;
+        let mut entropy = [0u8; 8];
+        getrandom::fill(&mut entropy).map_err(|_| StoreError::Unavailable)?;
+        let temp = self
+            .dir
+            .join(format!(".{STATE_FILE}.{}", hex::encode(entropy)));
+        // Before the rename nothing has changed (Unavailable); after it the
+        // new document is in place and only its durability is unconfirmed.
+        let replaced = (|| {
+            let mut file = open_owner_only(&temp, true)?;
+            file.write_all(&bytes)
+                .map_err(|_| StoreError::Unavailable)?;
+            file.sync_all().map_err(|_| StoreError::Unavailable)?;
+            if self.faulted(StoreFault::BeforeRename) {
+                return Err(StoreError::Unavailable);
+            }
+            fs::rename(&temp, self.path()).map_err(|_| StoreError::Unavailable)
+        })();
+        if replaced.is_err() {
+            let _ = fs::remove_file(&temp);
+            return replaced;
+        }
+        self.sync_dir()
+    }
+
+    fn reset(&self) -> Result<(), StoreError> {
+        match fs::remove_file(self.path()) {
+            Ok(()) => {}
+            Err(e) if e.kind() == std::io::ErrorKind::NotFound => {}
+            Err(_) => return Err(StoreError::Unavailable),
+        }
+        self.sync_dir()
+    }
+}
+
+/// The store used when the data directory cannot be opened (for example
+/// another instance holds its lease): every call reports `Unavailable`, so
+/// the snapshot says so and nothing is written elsewhere.
+pub struct UnavailableStore;
+
+impl AppStore for UnavailableStore {
+    fn load(&self) -> Result<Option<PersistedState>, StoreError> {
+        Err(StoreError::Unavailable)
+    }
+
+    fn save(&self, _: &PersistedState) -> Result<(), StoreError> {
+        Err(StoreError::Unavailable)
+    }
+
+    fn reset(&self) -> Result<(), StoreError> {
+        Err(StoreError::Unavailable)
+    }
+}
+
+/// In-memory store for builds and tests that must not touch the disk.
+#[derive(Default)]
+pub struct MemoryStore {
+    state: std::sync::Mutex<Option<PersistedState>>,
+}
+
+impl MemoryStore {
+    pub fn new() -> Self {
+        Self::default()
+    }
+}
+
+impl AppStore for MemoryStore {
+    fn load(&self) -> Result<Option<PersistedState>, StoreError> {
+        self.state
+            .lock()
+            .map(|s| s.clone())
+            .map_err(|_| StoreError::Unavailable)
+    }
+
+    fn save(&self, state: &PersistedState) -> Result<(), StoreError> {
+        *self.state.lock().map_err(|_| StoreError::Unavailable)? = Some(state.clone());
+        Ok(())
+    }
+
+    fn reset(&self) -> Result<(), StoreError> {
+        *self.state.lock().map_err(|_| StoreError::Unavailable)? = None;
+        Ok(())
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::tenants::{Destination, Region};
+
+    fn scratch(name: &str) -> PathBuf {
+        let mut entropy = [0u8; 6];
+        getrandom::fill(&mut entropy).expect("entropy");
+        std::env::temp_dir().join(format!("airs-v2-store-{name}-{}", hex::encode(entropy)))
+    }
+
+    fn sample() -> PersistedState {
+        let id = TenantId::parse("tn-0123456789abcdef").expect("id");
+        PersistedState {
+            appearance: Theme::Dark,
+            tenants: vec![TenantProfile {
+                id: id.clone(),
+                label: "Prod".into(),
+                tsg_id: Some("1234".into()),
+                destination: Destination::Region {
+                    region: Region::Europe,
+                },
+            }],
+            active_tenant: Some(id.clone()),
+            credentials: vec![StoredCredential {
+                record: RecordId::parse("cr-0123456789abcdef").expect("record"),
+                tenant: id,
+                destination: Region::Europe.origin().into(),
+            }],
+            ..PersistedState::default()
+        }
+    }
+
+    #[test]
+    fn saves_atomically_with_owner_only_modes_and_reloads() {
+        use std::os::unix::fs::PermissionsExt;
+        let dir = scratch("roundtrip");
+        let store = FileStore::open(&dir).expect("open");
+        assert_eq!(store.load(), Ok(None));
+        store.save(&sample()).expect("save");
+        assert_eq!(store.load(), Ok(Some(sample())));
+        let mode = |p: &Path| fs::metadata(p).expect("meta").permissions().mode() & 0o777;
+        assert_eq!(mode(&dir), 0o700);
+        assert_eq!(mode(&dir.join(STATE_FILE)), 0o600);
+        let leftovers: Vec<_> = fs::read_dir(&dir)
+            .expect("dir")
+            .filter_map(|e| e.ok())
+            .filter(|e| e.file_name().to_string_lossy().starts_with('.'))
+            .collect();
+        assert!(leftovers.is_empty(), "no temporary files remain");
+        store.reset().expect("reset");
+        assert_eq!(store.load(), Ok(None));
+        drop(store);
+        fs::remove_dir_all(&dir).expect("cleanup");
+    }
+
+    #[test]
+    fn a_second_instance_cannot_take_the_lease() {
+        let dir = scratch("lease");
+        let first = FileStore::open(&dir).expect("open");
+        assert_eq!(FileStore::open(&dir).err(), Some(StoreError::Unavailable));
+        drop(first);
+        assert!(FileStore::open(&dir).is_ok(), "released with the store");
+        fs::remove_dir_all(&dir).expect("cleanup");
+    }
+
+    #[test]
+    fn unreadable_or_inconsistent_documents_are_corrupt_and_untouched() {
+        let dir = scratch("corrupt");
+        let store = FileStore::open(&dir).expect("open");
+        for bytes in [
+            b"{not json".to_vec(),
+            serde_json::to_vec(&PersistedState {
+                schema: "other".into(),
+                ..sample()
+            })
+            .expect("json"),
+            serde_json::to_vec(&PersistedState {
+                active_tenant: TenantId::parse("tn-ffffffffffffffff"),
+                ..sample()
+            })
+            .expect("json"),
+            br#"{"schema":"prisma-airs-desktop-v2/state/1","appearance":"dark","tenants":[],"activeTenant":null,"credentials":[],"pendingCleanup":[],"secret":"x"}"#.to_vec(),
+        ] {
+            fs::write(dir.join(STATE_FILE), &bytes).expect("write");
+            assert_eq!(store.load(), Err(StoreError::Corrupt));
+            assert_eq!(fs::read(dir.join(STATE_FILE)).expect("read"), bytes, "left untouched");
+        }
+        drop(store);
+        fs::remove_dir_all(&dir).expect("cleanup");
+    }
+
+    #[test]
+    fn failures_before_the_rename_change_nothing_and_after_it_are_unconfirmed() {
+        let dir = scratch("faults");
+        let store = FileStore::open(&dir).expect("open");
+        store.save(&PersistedState::default()).expect("baseline");
+        store.inject(Some(StoreFault::BeforeRename));
+        assert_eq!(store.save(&sample()), Err(StoreError::Unavailable));
+        assert_eq!(
+            store.load(),
+            Ok(Some(PersistedState::default())),
+            "old document kept"
+        );
+        store.inject(Some(StoreFault::AfterRename));
+        assert_eq!(store.save(&sample()), Err(StoreError::Unconfirmed));
+        assert_eq!(
+            store.load(),
+            Ok(Some(sample())),
+            "the new document is in place"
+        );
+        store.inject(None);
+        let leftovers = fs::read_dir(&dir)
+            .expect("dir")
+            .filter_map(|e| e.ok())
+            .filter(|e| e.file_name().to_string_lossy().starts_with('.'))
+            .count();
+        assert_eq!(leftovers, 0, "no temporary files remain");
+        drop(store);
+        fs::remove_dir_all(&dir).expect("cleanup");
+    }
+
+    #[test]
+    fn a_planted_symlink_is_not_written_through() {
+        let dir = scratch("symlink");
+        let store = FileStore::open(&dir).expect("open");
+        let outside = scratch("outside");
+        fs::write(&outside, b"keep").expect("write");
+        std::os::unix::fs::symlink(&outside, dir.join(STATE_FILE)).expect("symlink");
+        assert_eq!(store.load(), Err(StoreError::Corrupt), "not a regular file");
+        store
+            .save(&sample())
+            .expect("rename replaces the link itself");
+        assert_eq!(fs::read(&outside).expect("read"), b"keep");
+        drop(store);
+        fs::remove_dir_all(&dir).expect("cleanup");
+        fs::remove_file(&outside).expect("cleanup");
+    }
+}
