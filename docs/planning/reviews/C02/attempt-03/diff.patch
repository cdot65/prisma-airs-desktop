+        let context = ContextRef::clone(&desk.snap().active.expect("active").context);
+        let read = desk.handle.read_scan_credential(&context).await.map(|_| ());
+        let refusal = if failure == VaultError::Locked {
+            Refusal::LockedStore
+        } else {
+            Refusal::DeniedStore
+        };
+        assert_eq!(read, Err(refusal));
+    }
+}
