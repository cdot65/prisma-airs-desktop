new file mode 100644
index 0000000..e958a68
--- /dev/null
+++ b/crates/desktop-core/src/fixtures.rs
@@ -0,0 +1,373 @@
+//! Deterministic adapters for tests and the fixture build. Never compiled
+//! into shipping builds.
+
+use std::collections::{HashMap, VecDeque};
+use std::sync::{Arc, Condvar, Mutex};
+
+use futures_util::future::BoxFuture;
+use zeroize::Zeroizing;
+
+use crate::authority::{Adapters, CredentialStore, ImportFile, ImportPicker};
+use crate::import::ImportError;
+use crate::store::{AppStore, MemoryStore, PersistedState, StoreError};
+use crate::vault::{RecordId, Vault, VaultError};
+
+/// What a [`ScriptedVault`] was asked to do (no secret values).
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub enum VaultCall {
+    Put(RecordId),
+    Get(RecordId),
+    Delete(RecordId),
+    Purge,
+}
+
+#[derive(Default)]
+struct VaultState {
+    records: HashMap<RecordId, Zeroizing<Vec<u8>>>,
+    failure: Option<VaultError>,
+    /// Purge deletes this many records, then fails with this error.
+    partial_purge: Option<(usize, VaultError)>,
+    calls: Vec<VaultCall>,
+    held: bool,
+    waiting: usize,
+}
+
+/// A Keychain stand-in with scriptable failures and a write gate.
+#[derive(Default)]
+pub struct ScriptedVault {
+    state: Mutex<VaultState>,
+    gate: Condvar,
+}
+
+impl ScriptedVault {
+    /// Every following call fails with `failure` until cleared.
+    pub fn fail_with(&self, failure: Option<VaultError>) {
+        if let Ok(mut s) = self.state.lock() {
+            s.failure = failure;
+        }
+    }
+
+    /// Purges delete `deleted` records and then fail, until cleared (`None`).
+    pub fn fail_purge_after(&self, partial: Option<(usize, VaultError)>) {
+        if let Ok(mut s) = self.state.lock() {
+            s.partial_purge = partial;
+        }
+    }
+
+    /// Writes block until [`ScriptedVault::release`].
+    pub fn hold_writes(&self) {
+        if let Ok(mut s) = self.state.lock() {
+            s.held = true;
+        }
+    }
+
+    pub fn release(&self) {
+        if let Ok(mut s) = self.state.lock() {
+            s.held = false;
+        }
+        self.gate.notify_all();
+    }
+
+    /// Writes currently waiting at the gate.
+    pub fn waiting(&self) -> usize {
+        self.state.lock().map(|s| s.waiting).unwrap_or(0)
+    }
+
+    pub fn calls(&self) -> Vec<VaultCall> {
+        self.state
+            .lock()
+            .map(|s| s.calls.clone())
+            .unwrap_or_default()
+    }
+
+    pub fn records(&self) -> Vec<RecordId> {
+        let mut ids: Vec<RecordId> = self
+            .state
+            .lock()
+            .map(|s| s.records.keys().cloned().collect())
+            .unwrap_or_default();
+        ids.sort();
+        ids
+    }
+
+    pub fn secret(&self, record: &RecordId) -> Option<Vec<u8>> {
+        self.state
+            .lock()
+            .ok()?
+            .records
+            .get(record)
+            .map(|s| s.to_vec())
+    }
+
+    /// Places a record directly, as if left by an earlier run.
+    pub fn plant(&self, record: &RecordId, secret: &[u8]) {
+        if let Ok(mut s) = self.state.lock() {
+            s.records
+                .insert(record.clone(), Zeroizing::new(secret.to_vec()));
+        }
+    }
+}
+
+impl Vault for ScriptedVault {
+    fn put(&self, record: &RecordId, secret: &[u8]) -> Result<(), VaultError> {
+        let mut s = self.state.lock().map_err(|_| VaultError::Unavailable)?;
+        s.calls.push(VaultCall::Put(record.clone()));
+        s.waiting += 1;
+        while s.held {
+            s = self.gate.wait(s).map_err(|_| VaultError::Unavailable)?;
+        }
+        s.waiting -= 1;
+        if let Some(failure) = s.failure {
+            return Err(failure);
+        }
+        s.records
+            .insert(record.clone(), Zeroizing::new(secret.to_vec()));
+        Ok(())
+    }
+
+    fn get(&self, record: &RecordId) -> Result<Zeroizing<Vec<u8>>, VaultError> {
+        let mut s = self.state.lock().map_err(|_| VaultError::Unavailable)?;
+        s.calls.push(VaultCall::Get(record.clone()));
+        if let Some(failure) = s.failure {
+            return Err(failure);
+        }
+        s.records
+            .get(record)
+            .map(|v| Zeroizing::new(v.to_vec()))
+            .ok_or(VaultError::NotFound)
+    }
+
+    fn delete(&self, record: &RecordId) -> Result<(), VaultError> {
+        let mut s = self.state.lock().map_err(|_| VaultError::Unavailable)?;
+        s.calls.push(VaultCall::Delete(record.clone()));
+        if let Some(failure) = s.failure {
+            return Err(failure);
+        }
+        s.records
+            .remove(record)
+            .map(drop)
+            .ok_or(VaultError::NotFound)
+    }
+}
+
+impl CredentialStore for ScriptedVault {
+    fn purge(&self) -> Result<(), VaultError> {
+        let mut s = self.state.lock().map_err(|_| VaultError::Unavailable)?;
+        s.calls.push(VaultCall::Purge);
+        if let Some(failure) = s.failure {
+            return Err(failure);
+        }
+        if let Some((deleted, failure)) = s.partial_purge {
+            let mut ids: Vec<RecordId> = s.records.keys().cloned().collect();
+            ids.sort();
+            for id in ids.into_iter().take(deleted) {
+                s.records.remove(&id);
+            }
+            return Err(failure);
+        }
+        s.records.clear();
+        Ok(())
+    }
+}
+
+/// An in-memory store whose saves and resets can be made to fail.
+#[derive(Default)]
+pub struct ScriptedStore {
+    inner: MemoryStore,
+    failing: Mutex<bool>,
+    /// The next this-many saves are applied (visible) but report an
+    /// unconfirmed directory sync; `usize::MAX` means all of them.
+    unconfirmed: Mutex<usize>,
+    /// The last document whose durability was confirmed: what a crash
+    /// would leave on disk.
+    durable: Mutex<Option<PersistedState>>,
+    failing_resets: Mutex<bool>,
+    load_error: Mutex<Option<StoreError>>,
+    saves: Mutex<usize>,
+}
+
+impl ScriptedStore {
+    pub fn with_state(state: PersistedState) -> Self {
+        let store = Self::default();
+        let _ = store.inner.save(&state);
+        if let Ok(mut d) = store.durable.lock() {
+            *d = Some(state);
+        }
+        store
+    }
+
+    /// The last confirmed-durable document (what survives a crash).
+    pub fn durable(&self) -> Option<PersistedState> {
+        self.durable.lock().ok().and_then(|d| d.clone())
+    }
+
+    pub fn corrupt() -> Self {
+        let store = Self::default();
+        if let Ok(mut e) = store.load_error.lock() {
+            *e = Some(StoreError::Corrupt);
+        }
+        store
+    }
+
+    pub fn unavailable() -> Self {
+        let store = Self::default();
+        if let Ok(mut e) = store.load_error.lock() {
+            *e = Some(StoreError::Unavailable);
+        }
+        store
+    }
+
+    pub fn unconfirmed_saves(&self, unconfirmed: bool) {
+        self.unconfirm_next(if unconfirmed { usize::MAX } else { 0 });
+    }
+
+    /// The next `count` saves are visible but unconfirmed.
+    pub fn unconfirm_next(&self, count: usize) {
+        if let Ok(mut u) = self.unconfirmed.lock() {
+            *u = count;
+        }
+    }
+
+    pub fn fail_resets(&self, failing: bool) {
+        if let Ok(mut f) = self.failing_resets.lock() {
+            *f = failing;
+        }
+    }
+
+    pub fn fail_saves(&self, failing: bool) {
+        if let Ok(mut f) = self.failing.lock() {
+            *f = failing;
+        }
+    }
+
+    pub fn saved(&self) -> Option<PersistedState> {
+        self.inner.load().ok().flatten()
+    }
+
+    pub fn saves(&self) -> usize {
+        self.saves.lock().map(|s| *s).unwrap_or(0)
+    }
+}
+
+impl AppStore for ScriptedStore {
+    fn load(&self) -> Result<Option<PersistedState>, StoreError> {
+        if let Some(e) = self
+            .load_error
+            .lock()
+            .map_err(|_| StoreError::Unavailable)?
+            .as_ref()
+        {
+            return Err(*e);
+        }
+        self.inner.load()
+    }
+
+    fn save(&self, state: &PersistedState) -> Result<(), StoreError> {
+        if *self.failing.lock().map_err(|_| StoreError::Unavailable)? {
+            return Err(StoreError::Unavailable);
+        }
+        *self.saves.lock().map_err(|_| StoreError::Unavailable)? += 1;
+        self.inner.save(state)?;
+        let mut unconfirmed = self
+            .unconfirmed
+            .lock()
+            .map_err(|_| StoreError::Unavailable)?;
+        if *unconfirmed > 0 {
+            if *unconfirmed != usize::MAX {
+                *unconfirmed -= 1;
+            }
+            return Err(StoreError::Unconfirmed);
+        }
+        *self.durable.lock().map_err(|_| StoreError::Unavailable)? = Some(state.clone());
+        Ok(())
+    }
+
+    fn reset(&self) -> Result<(), StoreError> {
+        if *self.failing.lock().map_err(|_| StoreError::Unavailable)?
+            || *self
+                .failing_resets
+                .lock()
+                .map_err(|_| StoreError::Unavailable)?
+        {
+            return Err(StoreError::Unavailable);
+        }
+        if let Ok(mut e) = self.load_error.lock() {
+            *e = None;
+        }
+        if let Ok(mut d) = self.durable.lock() {
+            *d = None;
+        }
+        self.inner.reset()
+    }
+}
+
+type PickerReply = Option<Result<(String, Vec<u8>), ImportError>>;
+
+/// A native-sheet stand-in returning queued replies (or cancelling).
+#[derive(Default)]
+pub struct ScriptedPicker {
+    replies: Mutex<VecDeque<PickerReply>>,
+    opened: Mutex<usize>,
+}
+
+impl ScriptedPicker {
+    pub fn reply(&self, reply: PickerReply) {
+        if let Ok(mut r) = self.replies.lock() {
+            r.push_back(reply);
+        }
+    }
+
+    pub fn opened(&self) -> usize {
+        self.opened.lock().map(|o| *o).unwrap_or(0)
+    }
+}
+
+impl ImportPicker for ScriptedPicker {
+    fn choose(&self) -> BoxFuture<'static, Option<Result<ImportFile, ImportError>>> {
+        if let Ok(mut o) = self.opened.lock() {
+            *o += 1;
+        }
+        let reply = self
+            .replies
+            .lock()
+            .ok()
+            .and_then(|mut r| r.pop_front())
+            .flatten();
+        Box::pin(async move {
+            reply.map(|r| {
+                r.map(|(name, bytes)| ImportFile {
+                    name,
+                    bytes: Zeroizing::new(bytes),
+                })
+            })
+        })
+    }
+}
+
+/// Handles to the scripted adapters behind an [`Adapters`] value.
+pub struct Handles {
+    pub vault: Arc<ScriptedVault>,
+    pub store: Arc<ScriptedStore>,
+    pub picker: Arc<ScriptedPicker>,
+}
+
+/// Fresh scripted adapters with empty storage.
+pub fn adapters() -> (Adapters, Handles) {
+    adapters_with(ScriptedStore::default())
+}
+
+pub fn adapters_with(store: ScriptedStore) -> (Adapters, Handles) {
+    let handles = Handles {
+        vault: Arc::new(ScriptedVault::default()),
+        store: Arc::new(store),
+        picker: Arc::new(ScriptedPicker::default()),
+    };
+    (
+        Adapters {
+            keychain: handles.vault.clone(),
+            store: handles.store.clone(),
+            picker: handles.picker.clone(),
+        },
+        handles,
+    )
+}
diff --git a/crates/desktop-core/src/import.rs b/crates/desktop-core/src/import.rs
new file mode 100644
index 0000000..a57d7f3
--- /dev/null
+++ b/crates/desktop-core/src/import.rs
@@ -0,0 +1,351 @@
+//! Explicit, reviewed import of nonsecret tenant-profile metadata.
+//!
+//! Two source formats are recognized: the v2 profile document and the
+//! airs-cli tenant registry (`{version, active?, tenants:[{name, configPath,
+//! tsgId}]}`) that v1 reads. Only label, TSG identifier and destination are
+//! taken (the registry has no destination, so its candidates use the default
+//! region and say so). Every other field is discarded and counted; secret-like
+//! fields and credential-file references are counted separately, and a
+//! referenced file is never opened. The preview carries only nonsecret values;
+//! the raw bytes are zeroized after parsing. Import never changes an existing
+//! tenant and never brings a credential: each imported tenant needs a fresh
+//! scan key.
+
+use serde::Serialize;
+use serde_json::Value;
+use ts_rs::TS;
+use zeroize::Zeroizing;
+
+use crate::tenants::{Destination, ProfileDraft, Region};
+
+/// Largest import file read.
+pub const MAX_IMPORT_BYTES: usize = 1024 * 1024;
+/// Most candidates in one preview.
+pub const MAX_CANDIDATES: usize = 256;
+/// Schema of the v2 profile document.
+pub const PROFILE_DOCUMENT_SCHEMA: &str = "prisma-airs-desktop-v2/tenant-profiles/1";
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq, Serialize, TS)]
+#[serde(rename_all = "camelCase")]
+pub enum ImportFormat {
+    ProfileDocument,
+    AirsCliRegistry,
+}
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq, Serialize, TS)]
+#[serde(rename_all = "camelCase")]
+pub enum CandidateProblem {
+    InvalidLabel,
+    InvalidTsgId,
+    InvalidDestination,
+}
+
+/// One importable profile, as shown for review.
+#[derive(Clone, Debug, PartialEq, Eq, Serialize, TS)]
+#[serde(rename_all = "camelCase")]
+pub struct ImportCandidate {
+    pub index: u32,
+    pub label: String,
+    pub tsg_id: Option<String>,
+    pub destination: Option<Destination>,
+    /// True when the source named no destination and the default is used.
+    pub default_destination: bool,
+    pub problem: Option<CandidateProblem>,
+    /// An existing tenant already has this label (it is not changed).
+    pub existing_label: bool,
+}
+
+/// Counts of source content that was not imported.
+#[derive(Clone, Copy, Debug, Default, PartialEq, Eq, Serialize, TS)]
+#[serde(rename_all = "camelCase")]
+pub struct Discarded {
+    /// Fields that look like secrets (keys, secrets, tokens, passwords).
+    pub secret_fields: u32,
+    /// References to other files (for example credential `configPath`s).
+    pub file_references: u32,
+    pub other_fields: u32,
+}
+
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct ImportPreview {
+    pub format: ImportFormat,
+    pub candidates: Vec<ImportCandidate>,
+    pub discarded: Discarded,
+}
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq, Serialize, TS, thiserror::Error)]
+#[serde(rename_all = "camelCase")]
+pub enum ImportError {
+    #[error("the file is too large to import")]
+    TooLarge,
+    #[error("the file is not a supported profile format")]
+    Unsupported,
+    #[error("the file contains no profiles")]
+    Empty,
+}
+
+fn is_secret_name(name: &str) -> bool {
+    let n = name.to_ascii_lowercase();
+    [
+        "key",
+        "secret",
+        "token",
+        "password",
+        "passwd",
+        "credential",
+        "auth",
+    ]
+    .iter()
+    .any(|w| n.contains(w))
+}
+
+fn is_reference_name(name: &str) -> bool {
+    let n = name.to_ascii_lowercase();
+    n.ends_with("path") || n.ends_with("file") || n.ends_with("dir")
+}
+
+fn classify(name: &str, discarded: &mut Discarded) {
+    if is_secret_name(name) {
+        discarded.secret_fields += 1;
+    } else if is_reference_name(name) {
+        discarded.file_references += 1;
+    } else {
+        discarded.other_fields += 1;
+    }
+}
+
+fn text(value: Option<&Value>) -> Option<String> {
+    value.and_then(Value::as_str).map(str::to_owned)
+}
+
+/// Parses an import file into a reviewable preview. `existing` are the
+/// current tenant labels (for the duplicate-label flag).
+pub fn preview(
+    bytes: Zeroizing<Vec<u8>>,
+    existing: &[String],
+) -> Result<ImportPreview, ImportError> {
+    if bytes.len() > MAX_IMPORT_BYTES {
+        return Err(ImportError::TooLarge);
+    }
+    let root: Value = serde_json::from_slice(&bytes).map_err(|_| ImportError::Unsupported)?;
+    drop(bytes);
+    let Value::Object(root) = root else {
+        return Err(ImportError::Unsupported);
+    };
+    let mut discarded = Discarded::default();
+    let (format, entries) =
+        if root.get("schema").and_then(Value::as_str) == Some(PROFILE_DOCUMENT_SCHEMA) {
+            for name in root
+                .keys()
+                .filter(|k| !matches!(k.as_str(), "schema" | "profiles"))
+            {
+                classify(name, &mut discarded);
+            }
+            (ImportFormat::ProfileDocument, root.get("profiles"))
+        } else if root.get("version").and_then(Value::as_u64) == Some(1)
+            && root.get("tenants").is_some_and(Value::is_array)
+        {
+            for name in root
+                .keys()
+                .filter(|k| !matches!(k.as_str(), "version" | "tenants" | "active"))
+            {
+                classify(name, &mut discarded);
+            }
+            (ImportFormat::AirsCliRegistry, root.get("tenants"))
+        } else {
+            return Err(ImportError::Unsupported);
+        };
+    let Some(Value::Array(entries)) = entries else {
+        return Err(ImportError::Unsupported);
+    };
+    if entries.is_empty() {
+        return Err(ImportError::Empty);
+    }
+    if entries.len() > MAX_CANDIDATES {
+        return Err(ImportError::TooLarge);
+    }
+    let mut candidates = Vec::new();
+    for (index, entry) in entries.iter().enumerate() {
+        let Value::Object(entry) = entry else {
+            discarded.other_fields += 1;
+            continue;
+        };
+        let (label_key, kept): (&str, &[&str]) = match format {
+            ImportFormat::ProfileDocument => ("label", &["label", "tsgId", "destination"]),
+            ImportFormat::AirsCliRegistry => ("name", &["name", "tsgId"]),
+        };
+        for name in entry.keys().filter(|k| !kept.contains(&k.as_str())) {
+            classify(name, &mut discarded);
+        }
+        let label = text(entry.get(label_key)).unwrap_or_default();
+        let tsg_id = text(entry.get("tsgId"));
+        let (destination, default_destination) = match format {
+            ImportFormat::ProfileDocument => (
+                entry
+                    .get("destination")
+                    .and_then(|d| serde_json::from_value::<Destination>(d.clone()).ok()),
+                false,
+            ),
+            ImportFormat::AirsCliRegistry => (
+                Some(Destination::Region {
+                    region: Region::UnitedStates,
+                }),
+                true,
+            ),
+        };
+        let draft = destination.clone().map(|destination| ProfileDraft {
+            label: label.clone(),
+            tsg_id: tsg_id.clone(),
+            destination,
+        });
+        let (shown, problem) = match draft.clone().and_then(ProfileDraft::validate) {
+            Some(valid) => (valid, None),
+            None => {
+                let problem = if destination.and_then(Destination::validate).is_none() {
+                    CandidateProblem::InvalidDestination
+                } else if (ProfileDraft {
+                    label: label.clone(),
+                    tsg_id: None,
+                    destination: Destination::Region {
+                        region: Region::UnitedStates,
+                    },
+                })
+                .validate()
+                .is_none()
+                {
+                    CandidateProblem::InvalidLabel
+                } else {
+                    CandidateProblem::InvalidTsgId
+                };
+                (
+                    ProfileDraft {
+                        label: label
+                            .chars()
+                            .take(crate::tenants::MAX_LABEL_CHARS)
+                            .collect(),
+                        tsg_id: None,
+                        destination: Destination::Region {
+                            region: Region::UnitedStates,
+                        },
+                    },
+                    Some(problem),
+                )
+            }
+        };
+        candidates.push(ImportCandidate {
+            index: index as u32,
+            existing_label: existing.iter().any(|l| l == &shown.label),
+            label: shown.label,
+            tsg_id: if problem.is_none() {
+                shown.tsg_id
+            } else {
+                None
+            },
+            destination: if problem.is_none() {
+                Some(shown.destination)
+            } else {
+                None
+            },
+            default_destination,
+            problem,
+        });
+    }
+    if candidates.is_empty() {
+        return Err(ImportError::Empty);
+    }
+    Ok(ImportPreview {
+        format,
+        candidates,
+        discarded,
+    })
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn bytes(value: serde_json::Value) -> Zeroizing<Vec<u8>> {
+        Zeroizing::new(serde_json::to_vec(&value).expect("json"))
+    }
+
+    #[test]
+    fn airs_cli_registry_imports_names_and_tsg_ids_only() {
+        let source = serde_json::json!({
+            "version": 1,
+            "active": "prod",
+            "tenants": [
+                {"name": "prod", "configPath": "/Users/x/.config/airs/prod.json", "tsgId": "1234567890"},
+                {"name": "lab", "configPath": "/tmp/lab.json", "tsgId": "42", "airsApiKey": "synthetic-secret"}
+            ]
+        });
+        let preview = preview(bytes(source), &["lab".to_owned()]).expect("preview");
+        assert_eq!(preview.format, ImportFormat::AirsCliRegistry);
+        assert_eq!(preview.candidates.len(), 2);
+        assert_eq!(preview.candidates[0].label, "prod");
+        assert_eq!(preview.candidates[0].tsg_id.as_deref(), Some("1234567890"));
+        assert!(preview.candidates[0].default_destination);
+        assert!(preview.candidates[1].existing_label);
+        assert_eq!(
+            preview.discarded,
+            Discarded {
+                secret_fields: 1,
+                file_references: 2,
+                other_fields: 0
+            }
+        );
+        let shown = format!("{:?}", preview.candidates);
+        assert!(!shown.contains("synthetic-secret") && !shown.contains("/tmp/lab.json"));
+    }
+
+    #[test]
+    fn profile_documents_keep_whitelisted_fields_and_flag_invalid_entries() {
+        let source = serde_json::json!({
+            "schema": PROFILE_DOCUMENT_SCHEMA,
+            "exportedBy": "someone",
+            "profiles": [
+                {"label": "EU", "tsgId": "77", "destination": {"kind": "region", "region": "europe"}, "clientSecret": "s"},
+                {"label": "Custom", "destination": {"kind": "custom", "origin": "https://scan.example.com/"}},
+                {"label": "Bad", "destination": {"kind": "custom", "origin": "http://plain.example.com"}},
+                {"label": "", "destination": {"kind": "region", "region": "india"}}
+            ]
+        });
+        let preview = preview(bytes(source), &[]).expect("preview");
+        let c = &preview.candidates;
+        assert_eq!(
+            c[0].destination,
+            Some(Destination::Region {
+                region: Region::Europe
+            })
+        );
+        assert_eq!(
+            c[1].destination,
+            Some(Destination::Custom {
+                origin: "https://scan.example.com".into()
+            })
+        );
+        assert_eq!(c[2].problem, Some(CandidateProblem::InvalidDestination));
+        assert_eq!(c[3].problem, Some(CandidateProblem::InvalidLabel));
+        assert_eq!(preview.discarded.secret_fields, 1);
+        assert_eq!(preview.discarded.other_fields, 1);
+    }
+
+    #[test]
+    fn unsupported_oversized_and_empty_sources_are_refused() {
+        assert_eq!(
+            preview(Zeroizing::new(b"not json".to_vec()), &[]).err(),
+            Some(ImportError::Unsupported)
+        );
+        assert_eq!(
+            preview(bytes(serde_json::json!([1, 2])), &[]).err(),
+            Some(ImportError::Unsupported)
+        );
+        assert_eq!(
+            preview(bytes(serde_json::json!({"version": 1, "tenants": []})), &[]).err(),
+            Some(ImportError::Empty)
+        );
+        assert_eq!(
+            preview(Zeroizing::new(vec![b' '; MAX_IMPORT_BYTES + 1]), &[]).err(),
+            Some(ImportError::TooLarge)
+        );
+    }
+}
