+fn waiting_work(started: Arc<AtomicUsize>) -> desktop_core::runtime::Work {
+    Box::new(move |claim: Claim| {
+        started.fetch_add(1, Ordering::SeqCst);
+        Box::pin(async move {
+            claim.cancel.cancelled().await;
+            Outcome::Unknown
+        })
+    })
+}
