+//! The environment contract for controller commands.
+//!
+//! Every command starts from a cleared environment. Only the preserved
+//! identity variables, an explicit PATH of selected tool directories and the
+//! declared nonsecret build values are set. Inherited variables that could
+//! silently change compilation are refused outright, `.env` files fail the
+//! run, and the resolved tool identities (version output and executable
+//! hash) are recorded as dependency inputs.
+
+use std::collections::BTreeMap;
+use std::path::{Path, PathBuf};
+use std::process::Command;
+
+use serde::{Deserialize, Serialize};
+
+use crate::{Repo, Result, invalid, io_err, read_json, sha256_hex};
+
+#[derive(Clone, Debug, Deserialize)]
+#[serde(deny_unknown_fields)]
+struct ToolchainManifest {
+    schema_version: u32,
+    #[allow(dead_code)]
+    description: String,
+    path_dirs: Vec<String>,
+    tools: Vec<ToolSpec>,
+    declared_env: BTreeMap<String, String>,
+    preserve_unchanged: Vec<String>,
+    reject_inherited: Vec<String>,
+    reject_inherited_prefixes: Vec<String>,
+}
+
+#[derive(Clone, Debug, Deserialize)]
+#[serde(deny_unknown_fields)]
+struct ToolSpec {
+    name: String,
+    argv: Vec<String>,
+    expect_prefix: String,
+}
+
+/// A resolved build tool.
+#[derive(Clone, Debug, PartialEq, Eq, Serialize, Deserialize)]
+pub struct ToolIdentity {
+    pub name: String,
+    pub path: String,
+    pub version: String,
+    pub sha256: String,
+}
+
+/// The concrete environment commands run under.
+#[derive(Clone, Debug)]
+pub struct Environment {
+    vars: BTreeMap<String, String>,
+    path_dirs: Vec<PathBuf>,
+    pub tools: Vec<ToolIdentity>,
+}
+
+impl Environment {
+    /// Resolves the toolchain and verifies tool versions.
+    pub fn prepare(repo: &Repo) -> Result<Self> {
+        let spec: ToolchainManifest = read_json(&repo.toolchain_manifest())?;
+        if spec.schema_version != 1 {
+            return Err(invalid("unsupported toolchain.json schema_version"));
+        }
+        refuse_inherited(&spec)?;
+        refuse_env_files(repo)?;
+        let home = std::env::var("HOME").map_err(|_| invalid("HOME must be set"))?;
+        let path_dirs: Vec<PathBuf> = spec
+            .path_dirs
+            .iter()
+            .map(|dir| expand(dir, &home, repo.root()))
+            .collect();
+        let mut vars = BTreeMap::new();
+        for name in &spec.preserve_unchanged {
+            if let Ok(value) = std::env::var(name) {
+                vars.insert(name.clone(), value);
+            }
+        }
+        for (name, value) in &spec.declared_env {
+            if vars.contains_key(name) {
+                return Err(invalid(format!("{name} is both preserved and declared")));
+            }
+            vars.insert(name.clone(), value.clone());
+        }
+        let joined = path_dirs
+            .iter()
+            .map(|p| p.display().to_string())
+            .collect::<Vec<_>>()
+            .join(":");
+        vars.insert("PATH".to_owned(), joined);
+        let mut env = Self {
+            vars,
+            path_dirs,
+            tools: Vec::new(),
+        };
+        for tool in &spec.tools {
+            env.tools.push(env.identify(tool, repo.root())?);
+        }
+        // rustc/cargo in PATH are rustup shims; also bind the selected
+        // toolchain's actual executables.
+        for name in ["rustc", "cargo"] {
+            let argv = vec!["rustup".to_owned(), "which".to_owned(), name.to_owned()];
+            let output = env
+                .command(&argv, repo.root())?
+                .output()
+                .map_err(io_err(repo.root()))?;
+            let path = PathBuf::from(String::from_utf8_lossy(&output.stdout).trim());
+            if !output.status.success() || !path.is_file() {
+                return Err(invalid(format!(
+                    "rustup cannot resolve the selected {name}"
+                )));
+            }
+            let bytes = std::fs::read(&path).map_err(io_err(&path))?;
+            env.tools.push(ToolIdentity {
+                name: format!("{name}-toolchain"),
+                path: path.display().to_string(),
+                version: String::new(),
+                sha256: sha256_hex(&bytes),
+            });
+        }
+        Ok(env)
+    }
+
+    fn identify(&self, tool: &ToolSpec, cwd: &Path) -> Result<ToolIdentity> {
+        let program = self.resolve(&tool.argv[0])?;
+        let output = self
+            .command(&tool.argv, cwd)?
+            .output()
+            .map_err(io_err(&program))?;
+        let version = String::from_utf8_lossy(&output.stdout).trim().to_owned();
+        if !output.status.success() || !version.starts_with(&tool.expect_prefix) {
+            return Err(invalid(format!(
+                "{} reports {version:?}; expected prefix {:?}",
+                tool.name, tool.expect_prefix
+            )));
+        }
+        let bytes = std::fs::read(&program).map_err(io_err(&program))?;
+        Ok(ToolIdentity {
+            name: tool.name.clone(),
+            path: program.display().to_string(),
+            version,
+            sha256: sha256_hex(&bytes),
+        })
+    }
+
+    /// Finds a program in the selected PATH (never the caller's PATH).
+    pub fn resolve(&self, program: &str) -> Result<PathBuf> {
+        if program.contains('/') {
+            return Err(invalid(format!("program must be a bare name: {program}")));
+        }
+        self.path_dirs
+            .iter()
+            .map(|dir| dir.join(program))
+            .find(|candidate| candidate.is_file())
+            .ok_or_else(|| {
+                invalid(format!(
+                    "{program} not found in the selected toolchain PATH"
+                ))
+            })
+    }
+
+    /// Builds a process for an argv under this environment.
+    pub fn command(&self, argv: &[String], cwd: &Path) -> Result<Command> {
+        let program = argv
+            .first()
+            .ok_or_else(|| invalid("empty argv"))
+            .and_then(|p| self.resolve(p))?;
+        let mut command = Command::new(program);
+        command.args(&argv[1..]).current_dir(cwd).env_clear();
+        for (name, value) in &self.vars {
+            command.env(name, value);
+        }
+        Ok(command)
+    }
+
+    /// Adds a declared value for specific commands (never secrets).
+    pub fn with(mut self, name: &str, value: &str) -> Self {
+        self.vars.insert(name.to_owned(), value.to_owned());
+        self
+    }
+
+    /// Nonsecret effective variables recorded with each run. Identity values
+    /// (HOME/USER/LOGNAME) are recorded by name only.
+    pub fn recorded_vars(&self) -> BTreeMap<String, String> {
+        self.vars
+            .iter()
+            .map(|(name, value)| {
+                let shown = if matches!(name.as_str(), "HOME" | "USER" | "LOGNAME" | "TMPDIR") {
+                    "<preserved>".to_owned()
+                } else {
+                    value.clone()
+                };
+                (name.clone(), shown)
+            })
+            .collect()
+    }
+
+    /// Hash of the toolchain identities, part of the dependency fingerprint.
+    pub fn toolchain_hash(&self) -> String {
+        let text = self
+            .tools
+            .iter()
+            .map(|t| format!("{}\0{}\0{}\n", t.name, t.version, t.sha256))
+            .collect::<String>();
+        sha256_hex(text.as_bytes())
+    }
+}
+
+fn expand(dir: &str, home: &str, repo: &Path) -> PathBuf {
+    if let Some(rest) = dir.strip_prefix("$HOME") {
+        PathBuf::from(format!("{home}{rest}"))
+    } else if let Some(rest) = dir.strip_prefix("{repo}") {
+        PathBuf::from(format!("{}{rest}", repo.display()))
+    } else {
+        PathBuf::from(dir)
+    }
+}
+
+fn refuse_inherited(spec: &ToolchainManifest) -> Result<()> {
+    // A variable already equal to its declared value (for example inside a
+    // nested controller command) is not an override.
+    let mut offending: Vec<String> = std::env::vars_os()
+        .filter_map(|(name, value)| Some((name.into_string().ok()?, value.into_string().ok())))
+        .filter(|(name, value)| spec.declared_env.get(name).map(String::as_str) != value.as_deref())
+        .map(|(name, _)| name)
+        .filter(|name| {
+            spec.reject_inherited.contains(name)
+                || spec
+                    .reject_inherited_prefixes
+                    .iter()
+                    .any(|prefix| name.starts_with(prefix.as_str()))
+        })
+        .collect();
+    offending.sort();
+    if offending.is_empty() {
+        Ok(())
+    } else {
+        Err(invalid(format!(
+            "refusing undeclared inherited overrides: {}",
+            offending.join(", ")
+        )))
+    }
+}
+
+/// `.env` files are never read and their presence fails the run.
+pub fn refuse_env_files(repo: &Repo) -> Result<()> {
+    let mut dirs = vec![
+        repo.root().to_path_buf(),
+        repo.join("apps/desktop"),
+        repo.join("apps/desktop/src-tauri"),
+    ];
+    if let Ok(entries) = std::fs::read_dir(repo.join("packages")) {
+        dirs.extend(entries.filter_map(|e| e.ok()).map(|e| e.path()));
+    }
+    for dir in dirs {
+        let Ok(entries) = std::fs::read_dir(&dir) else {
+            continue;
+        };
+        for entry in entries.filter_map(|e| e.ok()) {
+            let name = entry.file_name();
+            let name = name.to_string_lossy();
+            if name == ".env" || name.starts_with(".env.") {
+                return Err(invalid(format!(
+                    "unexpected environment file {}; the controller never reads .env files",
+                    entry.path().display()
+                )));
+            }
+        }
+    }
+    Ok(())
+}
diff --git a/crates/xtask/src/evidence.rs b/crates/xtask/src/evidence.rs
new file mode 100644
index 0000000..9d86b9a
--- /dev/null
+++ b/crates/xtask/src/evidence.rs
@@ -0,0 +1,214 @@
+//! Native acceptance records (T09 and chunk-specific native assertions).
+//!
+//! `native-prepare` builds and launches the fixture app and records its
+//! executable hash. A separate acceptance record, produced by actual
+//! computer-use interaction or a recorded operator procedure, must name that
+//! exact hash and report every check. A build exit status is never
+//! acceptance.
+
+use serde::{Deserialize, Serialize};
+
+use crate::{Result, invalid};
+
+pub const NATIVE_SCHEMA: &str = "airs-v2/native-acceptance/1";
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(rename_all = "lowercase")]
+pub enum Method {
+    /// Computer-use automation driving the real native window.
+    Cua,
+    /// A recorded manual operator procedure.
+    Operator,
+}
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(rename_all = "lowercase")]
+pub enum CheckResult {
+    Pass,
+    Fail,
+    Blocked,
+}
+
+#[derive(Clone, Debug, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct NativeApp {
+    pub bundle: String,
+    pub identifier: String,
+    pub executable_sha256: String,
+    pub fixture: bool,
+}
+
+#[derive(Clone, Debug, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct NativeCheck {
+    pub id: String,
+    pub description: String,
+    pub result: CheckResult,
+    pub observation: String,
+    pub evidence: Vec<String>,
+}
+
+#[derive(Clone, Debug, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct NativeAcceptance {
+    pub schema: String,
+    pub subject: String,
+    pub recorded_utc: String,
+    pub method: Method,
+    pub performed_by: String,
+    pub host: String,
+    pub app: NativeApp,
+    pub checks: Vec<NativeCheck>,
+    pub limitations: Vec<String>,
+}
+
+impl NativeAcceptance {
+    pub fn parse(bytes: &[u8]) -> Result<Self> {
+        let record: Self = serde_json::from_slice(bytes)
+            .map_err(|e| invalid(format!("native acceptance record is malformed: {e}")))?;
+        if record.schema != NATIVE_SCHEMA {
+            return Err(invalid("native acceptance record has the wrong schema"));
+        }
+        Ok(record)
+    }
+
+    /// Reasons this record cannot count as native acceptance under `expect`.
+    pub fn failures(&self, subject: &str, expect: &NativeExpectation) -> Vec<String> {
+        let mut reasons = Vec::new();
+        if self.subject != subject {
+            reasons.push(format!(
+                "native record is for {} not {subject}",
+                self.subject
+            ));
+        }
+        if self.app.executable_sha256 != expect.prepared_executable_sha256 {
+            reasons.push("native record does not name the prepared fixture executable".to_owned());
+        }
+        match expect.current_executable_sha256.as_deref() {
+            Some(current) if current == expect.prepared_executable_sha256 => {}
+            Some(_) => reasons
+                .push("the prepared fixture bytes changed after native acceptance".to_owned()),
+            None => reasons.push("the prepared fixture executable is no longer present".to_owned()),
+        }
+        if expect.prepared_bundle.as_deref() != Some(self.app.bundle.as_str()) {
+            reasons.push("native record names a bundle other than the prepared fixture".to_owned());
+        }
+        match (
+            &expect.prepared_bundle_sha256,
+            &expect.current_bundle_sha256,
+        ) {
+            (Some(prepared), Some(current)) if prepared == current => {}
+            _ => reasons.push(
+                "the prepared fixture bundle changed or is missing (any bundle byte)".to_owned(),
+            ),
+        }
+        if expect.prepared_identifier.as_deref() != Some(expect.fixture_identifier.as_str())
+            || expect.current_identifier.as_deref() != Some(expect.fixture_identifier.as_str())
+        {
+            reasons.push(
+                "the prepared bundle's CFBundleIdentifier is not the fixture identity".to_owned(),
+            );
+        }
+        if !self.app.fixture || self.app.identifier != expect.fixture_identifier {
+            reasons.push(format!(
+                "native acceptance must use the fixture identity {} (record names {})",
+                expect.fixture_identifier, self.app.identifier
+            ));
+        }
+        let mut seen = std::collections::BTreeSet::new();
+        for check in &self.checks {
+            if !seen.insert(check.id.as_str()) {
+                reasons.push(format!("native check {} appears more than once", check.id));
+            }
+            if !expect.required_checks.contains(&check.id) {
+                reasons.push(format!(
+                    "native check {} is not in the required inventory",
+                    check.id
+                ));
+            }
+            if check.result != CheckResult::Pass {
+                reasons.push(format!("native check {} is {:?}", check.id, check.result));
+            }
+            if check.observation.trim().is_empty() {
+                reasons.push(format!("native check {} has no observation", check.id));
+            }
+            if check.evidence.is_empty() {
+                reasons.push(format!("native check {} cites no evidence", check.id));
+            }
+            for path in &check.evidence {
+                if !expect.evidence_files.contains(path) {
+                    reasons.push(format!(
+                        "native check {} cites {path}, which the packet does not hash-bind",
+                        check.id
+                    ));
+                }
+            }
+        }
+        for required in &expect.required_checks {
+            if !seen.contains(required.as_str()) {
+                reasons.push(format!("required native check {required} is missing"));
+            }
+        }
+        reasons
+    }
+}
+
+/// What a native acceptance record must satisfy for one chunk.
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct NativeExpectation {
+    pub required_checks: Vec<String>,
+    pub fixture_identifier: String,
+    /// Executable hash recorded by the frozen native-prepare run.
+    pub prepared_executable_sha256: String,
+    /// The prepared bundle path, tree hash and identifier (native-prepare.json).
+    pub prepared_bundle: Option<String>,
+    pub prepared_bundle_sha256: Option<String>,
+    pub prepared_identifier: Option<String>,
+    /// The prepared bundle as it exists now (None if absent).
+    pub current_executable_sha256: Option<String>,
+    pub current_bundle_sha256: Option<String>,
+    pub current_identifier: Option<String>,
+    /// Evidence paths hash-bound by the review packet.
+    pub evidence_files: std::collections::BTreeSet<String>,
+}
+
+#[derive(Clone, Debug, Deserialize)]
+#[serde(deny_unknown_fields)]
+struct NativeChecksFile {
+    #[allow(dead_code)]
+    schema: String,
+    #[allow(dead_code)]
+    description: String,
+    fixture_identifier: String,
+    chunks: std::collections::BTreeMap<String, Vec<RequiredCheck>>,
+}
+
+#[derive(Clone, Debug, Deserialize)]
+#[serde(deny_unknown_fields)]
+struct RequiredCheck {
+    id: String,
+    #[allow(dead_code)]
+    check: String,
+}
+
+/// Required check IDs and fixture identity from
+/// docs/architecture/native-checks.json for the given chunks (a phase passes
+/// all of its chunks: its integrated acceptance repeats every chunk check).
+/// A chunk without an inventory fails.
+pub fn required_checks(path: &std::path::Path, chunks: &[String]) -> Result<(Vec<String>, String)> {
+    let file: NativeChecksFile = crate::read_json(path)?;
+    let mut ids = Vec::new();
+    for chunk in chunks {
+        let checks = file
+            .chunks
+            .get(chunk)
+            .ok_or_else(|| invalid(format!("no native check inventory for {chunk}")))?;
+        if checks.is_empty() {
+            return Err(invalid(format!(
+                "native check inventory for {chunk} is empty"
+            )));
+        }
+        ids.extend(checks.iter().map(|c| c.id.clone()));
+    }
+    Ok((ids, file.fixture_identifier))
+}
diff --git a/crates/xtask/src/fingerprint.rs b/crates/xtask/src/fingerprint.rs
new file mode 100644
index 0000000..114cd57
--- /dev/null
+++ b/crates/xtask/src/fingerprint.rs
@@ -0,0 +1,397 @@
+//! Input fingerprints bound into review packets and receipts.
+//!
+//! * source: every tracked or untracked-but-not-ignored file (path, mode,
+//!   content or symlink target) plus the repository `.git/config`, minus a
+//!   narrow set of mutable evidence locations that are hashed separately.
+//! * dependencies: lockfiles, toolchain pin, the consumed immutable inputs
+//!   under `.inputs/`, and the resolved build-tool identities.
+//! * build_flags: the subject's manifest entries, Tauri configuration and
+//!   capability files, target and fixture-feature policy.
+//! * evidence: the subject's committed evidence directory.
+
+use std::collections::BTreeMap;
+use std::os::unix::fs::PermissionsExt;
+use std::path::Path;
+use std::process::Command;
+
+use serde::{Deserialize, Serialize};
+
+use crate::manifest::Manifest;
+use crate::{Repo, Result, Subject, invalid, io_err, sha256_hex};
+
+/// Mutable locations excluded from the source fingerprint. Each is hashed
+/// independently (evidence fingerprint, receipts) so exclusion cannot hide
+/// application sources, lockfiles, tests or configuration.
+pub const SOURCE_EXCLUSIONS: [&str; 3] = [
+    "docs/planning/status.md",
+    "docs/planning/reviews/",
+    "docs/planning/evidence/",
+];
+
+#[derive(Clone, Debug, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct Fingerprints {
+    pub source: String,
+    pub dependencies: String,
+    pub build_flags: String,
+    pub evidence: String,
+}
+
+/// One entry of the source inventory.
+#[derive(Clone, Debug, PartialEq, Eq, Serialize, Deserialize)]
+pub struct FileEntry {
+    pub path: String,
+    pub mode: String,
+    pub sha256: String,
+}
+
+pub fn is_excluded(path: &str) -> bool {
+    SOURCE_EXCLUSIONS.iter().any(|excluded| {
+        if excluded.ends_with('/') {
+            path.starts_with(excluded)
+        } else {
+            path == *excluded
+        }
+    })
+}
+
+/// Lists source files via git: tracked plus untracked files not ignored.
+pub fn source_inventory(repo: &Repo) -> Result<Vec<FileEntry>> {
+    let output = Command::new("/usr/bin/git")
+        .args([
+            "ls-files",
+            "-z",
+            "--cached",
+            "--others",
+            "--exclude-standard",
+        ])
+        .current_dir(repo.root())
+        .env_clear()
+        .env("PATH", "/usr/bin:/bin")
+        .env("HOME", std::env::var("HOME").unwrap_or_default())
+        .output()
+        .map_err(io_err(repo.root()))?;
+    if !output.status.success() {
+        return Err(invalid("git ls-files failed"));
+    }
+    let mut paths: Vec<String> = output
+        .stdout
+        .split(|b| *b == 0)
+        .filter(|p| !p.is_empty())
+        .map(|p| String::from_utf8_lossy(p).into_owned())
+        .filter(|p| !is_excluded(p))
+        .collect();
+    paths.sort();
+    paths.dedup();
+    let mut entries = Vec::with_capacity(paths.len() + 1);
+    for path in paths {
+        entries.push(file_entry(repo.root(), &path)?);
+    }
+    entries.push(file_entry(repo.root(), ".git/config")?);
+    Ok(entries)
+}
+
+fn file_entry(root: &Path, relative: &str) -> Result<FileEntry> {
+    let full = root.join(relative);
+    let Ok(meta) = std::fs::symlink_metadata(&full) else {
+        return Ok(FileEntry {
+            path: relative.to_owned(),
+            mode: "deleted".to_owned(),
+            sha256: String::new(),
+        });
+    };
+    if meta.file_type().is_symlink() {
+        let target = std::fs::read_link(&full).map_err(io_err(&full))?;
+        return Ok(FileEntry {
+            path: relative.to_owned(),
+            mode: "symlink".to_owned(),
+            sha256: sha256_hex(target.as_os_str().as_encoded_bytes()),
+        });
+    }
+    let bytes = std::fs::read(&full).map_err(io_err(&full))?;
+    let executable = meta.permissions().mode() & 0o111 != 0;
+    Ok(FileEntry {
+        path: relative.to_owned(),
+        mode: if executable { "100755" } else { "100644" }.to_owned(),
+        sha256: sha256_hex(&bytes),
+    })
+}
+
+pub fn inventory_hash(entries: &[FileEntry]) -> String {
+    let text: String = entries
+        .iter()
+        .map(|e| format!("{}\0{}\0{}\n", e.path, e.mode, e.sha256))
+        .collect();
+    sha256_hex(text.as_bytes())
+}
+
+pub fn source(repo: &Repo) -> Result<String> {
+    Ok(inventory_hash(&source_inventory(repo)?))
+}
+
+/// Hash of every regular file under a directory (relative paths, sorted).
+pub fn tree_hash(dir: &Path) -> Result<String> {
+    tree_hash_excluding(dir, &[])
+}
+
+/// Like [`tree_hash`], skipping directories with the given names.
+pub fn tree_hash_excluding(dir: &Path, skip: &[&str]) -> Result<String> {
+    let mut entries = Vec::new();
+    collect_tree(dir, dir, skip, &mut entries)?;
+    entries.sort_by(|a, b| a.path.cmp(&b.path));
+    Ok(inventory_hash(&entries))
+}
+
+fn collect_tree(root: &Path, dir: &Path, skip: &[&str], out: &mut Vec<FileEntry>) -> Result<()> {
+    let mut children: Vec<_> = std::fs::read_dir(dir)
+        .map_err(io_err(dir))?
+        .filter_map(|e| e.ok())
+        .collect();
+    children.sort_by_key(|e| e.file_name());
+    for child in children {
+        let path = child.path();
+        let relative = path
+            .strip_prefix(root)
+            .map_err(|_| invalid("path escaped its root"))?
+            .to_string_lossy()
+            .into_owned();
+        let meta = std::fs::symlink_metadata(&path).map_err(io_err(&path))?;
+        if meta.is_dir() {
+            if skip.iter().any(|name| child.file_name() == *name) {
+                continue;
+            }
+            collect_tree(root, &path, skip, out)?;
+        } else {
+            out.push(file_entry(root, &relative)?);
+        }
+    }
+    Ok(())
+}
+
+/// Dependency inputs: lockfiles, toolchain pin, immutable inputs, tools.
+pub fn dependencies(repo: &Repo, toolchain_hash: &str) -> Result<String> {
+    let mut parts: BTreeMap<String, String> = BTreeMap::new();
+    for file in [
+        "Cargo.lock",
+        "pnpm-lock.yaml",
+        "rust-toolchain.toml",
+        ".npmrc",
+        "docs/architecture/inputs.lock.json",
+    ] {
+        let path = repo.join(file);
+        let digest = match std::fs::read(&path) {
+            Ok(bytes) => sha256_hex(&bytes),
+            Err(_) => "absent".to_owned(),
+        };
+        parts.insert(file.to_owned(), digest);
+    }
+    let inputs = repo.join(".inputs");
+    if inputs.is_dir() {
+        let mut names: Vec<_> = std::fs::read_dir(&inputs)
+            .map_err(io_err(&inputs))?
+            .filter_map(|e| e.ok())
+            .filter(|e| e.path().is_dir())
+            .map(|e| e.file_name().to_string_lossy().into_owned())
+            .collect();
+        names.sort();
+        for name in names {
+            parts.insert(format!(".inputs/{name}"), tree_hash(&inputs.join(&name))?);
+        }
+    }
+    for (label, hash) in consumed_shared(repo)? {
+        parts.insert(label, hash);
+    }
+    parts.insert("toolchain".to_owned(), toolchain_hash.to_owned());
+    Ok(sha256_hex(
+        serde_json::to_string(&parts).unwrap_or_default().as_bytes(),
+    ))
+}
+
+/// Build flags: the subject's manifest entries and native configuration,
+/// as canonical JSON (sorted keys, compact) so independent tools can
+/// recompute it.
+pub fn build_flags(repo: &Repo, manifest: &Manifest, subject: Subject) -> Result<String> {
+    use serde_json::{Value, json};
+    let mut parts: BTreeMap<String, Value> = BTreeMap::new();
+    let chunks = if subject.is_phase() {
+        manifest.phase_chunks(subject)?
+    } else {
+        vec![subject]
+    };
+    for chunk in chunks {
+        let entry = manifest.chunk(chunk)?;
+        parts.insert(
+            format!("chunk/{chunk}"),
+            // Keys in sorted order so the canonical form is independent of
+            // serde_json's map ordering features.
+            json!({
+                "fixture": entry.fixture_command,
+                "frontend": entry.frontend_commands,
+                "host": entry.host_commands,
+                "native_prepare": entry.native_prepare,
+            }),
+        );
+    }
+    parts.insert("setup".to_owned(), json!(manifest.setup_commands));
+    parts.insert(
+        "phase_native".to_owned(),
+        json!(manifest.phase_native_prepare),
+    );
+    parts.insert("common".to_owned(), json!(manifest.common_commands));
+    parts.insert("shared".to_owned(), json!(manifest.shared_source_commands));
+    parts.insert("artifact".to_owned(), json!(manifest.artifact_build));
+    parts.insert("target".to_owned(), json!(manifest.target));
+    parts.insert(
+        "fixture_only".to_owned(),
+        json!(manifest.fixture_only_features),
+    );
+    parts.insert(
+        "production_features".to_owned(),
+        json!(manifest.requested_production_features),
+    );
+    for file in BUILD_FLAG_FILES {
+        let digest = std::fs::read(repo.join(file))
+            .map(|b| sha256_hex(&b))
+            .unwrap_or_else(|_| "absent".to_owned());
+        parts.insert(file.to_owned(), json!(digest));
+    }
+    Ok(sha256_hex(
+        serde_json::to_string(&parts).unwrap_or_default().as_bytes(),
+    ))
+}
+
+/// Native configuration files whose bytes are part of the build flags.
+pub const BUILD_FLAG_FILES: [&str; 6] = [
+    "apps/desktop/src-tauri/tauri.conf.json",
+    "apps/desktop/src-tauri/tauri.fixture.conf.json",
+    "apps/desktop/src-tauri/capabilities/main.json",
+    "apps/desktop/src-tauri/Cargo.toml",
+    "Cargo.toml",
+    "docs/architecture/native-checks.json",
+];
+
+/// Evidence: the subject's committed evidence directory (empty if absent).
+pub fn evidence(repo: &Repo, subject: Subject) -> Result<String> {
+    let dir = repo.evidence_dir(subject);
+    if dir.is_dir() {
+        tree_hash(&dir)
+    } else {
+        Ok(sha256_hex(b""))
+    }
+}
+
+pub fn all(
+    repo: &Repo,
+    manifest: &Manifest,
+    subject: Subject,
+    toolchain_hash: &str,
+) -> Result<Fingerprints> {
+    Ok(Fingerprints {
+        source: source(repo)?,
+        dependencies: dependencies(repo, toolchain_hash)?,
+        build_flags: build_flags(repo, manifest, subject)?,
+        evidence: evidence(repo, subject)?,
+    })
+}
+
+/// The shared presentation package locations actually consumed by builds:
+/// the locked input subtree, the staged scratch copy and the copy installed
+/// into the desktop's node_modules. Each is hashed into the dependency
+/// fingerprint; editing any of them invalidates bound receipts.
+pub const SHARED_PACKAGE: &str = "packages/presentation";
+
+pub fn consumed_shared(repo: &Repo) -> Result<Vec<(String, String)>> {
+    let mut out = Vec::new();
+    let web = repo.join(".work/academy");
+    out.push((
+        "shared/web-scratch".to_owned(),
+        if web.is_dir() {
+            academy_consumer_hash(&web)?
+        } else {
+            "absent".to_owned()
+        },
+    ));
+    let locations = [
+        (
+            "shared/input",
+            repo.join(".inputs/academy").join(SHARED_PACKAGE),
+        ),
+        (
+            "shared/scratch",
+            repo.join(".work/academy").join(SHARED_PACKAGE),
+        ),
+        (
+            "shared/installed",
+            std::fs::canonicalize(
+                repo.join("apps/desktop/node_modules/@ai-security-academy/presentation"),
+            )
+            .unwrap_or_default(),
+        ),
+    ];
+    for (label, path) in locations {
+        let hash = if path.is_dir() {
+            tree_hash_excluding(&path, &["node_modules"])?
+        } else {
+            "absent".to_owned()
+        };
+        out.push((label.to_owned(), hash));
+    }
+    Ok(out)
+}
+
+/// Generated outputs the Academy web checks write into scratch; everything
+/// else in `.work/academy` must equal the locked input.
+pub const ACADEMY_GENERATED: [&str; 4] = [
+    "dist",
+    "public/excalidraw-assets",
+    "packages/shared/tsconfig.tsbuildinfo",
+    // rollup-plugin-visualizer report written by `vite build`.
+    "stats.html",
+];
+
+/// Hash of an Academy tree as consumed by the web checks: excludes
+/// node_modules at any depth, the documented generated outputs and `.env*`
+/// files (never staged).
+pub fn academy_consumer_hash(dir: &Path) -> Result<String> {
+    let mut entries = Vec::new();
+    collect_tree(dir, dir, &["node_modules"], &mut entries)?;
+    entries.retain(|e| {
+        let name = e.path.rsplit('/').next().unwrap_or(&e.path);
+        let generated = ACADEMY_GENERATED
+            .iter()
+            .any(|g| e.path == *g || e.path.starts_with(&format!("{g}/")));
+        !generated && name != ".env" && !name.starts_with(".env.")
+    });
+    entries.sort_by(|a, b| a.path.cmp(&b.path));
+    Ok(inventory_hash(&entries))
+}
+
+/// Fails unless the staged web scratch tree, the staged package and the
+/// installed package all equal the locked input.
+pub fn verify_consumed_shared(repo: &Repo) -> Result<()> {
+    let input_tree = repo.join(".inputs/academy");
+    let scratch_tree = repo.join(".work/academy");
+    if input_tree.is_dir()
+        && scratch_tree.is_dir()
+        && academy_consumer_hash(&input_tree)? != academy_consumer_hash(&scratch_tree)?
+    {
+        return Err(invalid(
+            ".work/academy differs from the locked Academy input (outside documented generated outputs); re-run shared-prepare",
+        ));
+    }
+    let hashes = consumed_shared(repo)?;
+    let input = &hashes[1].1;
+    if input == "absent" {
+        return Err(invalid(
+            "locked shared input .inputs/academy is absent; run fetch-inputs",
+        ));
+    }
+    for (label, hash) in &hashes[2..] {
+        if hash != input {
+            return Err(invalid(format!(
+                "{label} differs from the locked shared input; re-run shared-prepare and pnpm install"
+            )));
+        }
+    }
+    Ok(())
+}
diff --git a/crates/xtask/src/gate.rs b/crates/xtask/src/gate.rs
new file mode 100644
index 0000000..e132174
--- /dev/null
+++ b/crates/xtask/src/gate.rs
@@ -0,0 +1,1010 @@
+//! Review packets, receipts and the completion gate.
+//!
+//! The gate never trusts a single summary. It re-derives the decision from the
+//! immutable packet, the reviewer-authored verdict (hash-bound and compared
+//! with the reviewer's actual final output), the run and native evidence the
+//! packet names checked against the approved command plan and native check
+//! inventory, the predecessor receipts, and the inputs as they exist now.
+
+use std::collections::{BTreeMap, BTreeSet};
+use std::path::{Path, PathBuf};
+
+use serde::{Deserialize, Serialize};
+
+use crate::evidence::{NativeAcceptance, NativeExpectation};
+use crate::fingerprint::Fingerprints;
+use crate::manifest::Command;
+use crate::runner::{RUN_SCHEMA, RunKind, RunRecord, Status};
+use crate::verdict::{Scores, Verdict};
+use crate::{Result, invalid, io_err, sha256_hex};
+
+pub const PACKET_SCHEMA: &str = "airs-v2/review-request/1";
+pub const RECEIPT_SCHEMA: &str = "airs-v2/review-receipt/1";
+pub const MINIMUM_SCORE: u8 = 9;
+
+#[derive(Clone, Debug, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct HashedPath {
+    pub path: String,
+    pub sha256: String,
+}
+
+#[derive(Clone, Debug, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct RunRef {
+    pub kind: RunKind,
+    pub run_id: String,
+    pub path: String,
+    pub sha256: String,
+}
+
+#[derive(Clone, Debug, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct PredecessorRef {
+    pub subject: String,
+    pub receipt: HashedPath,
+}
+
+/// The immutable request packet given to the reviewer.
+#[derive(Clone, Debug, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct Packet {
+    pub schema: String,
+    pub request_id: String,
+    pub attempt_id: String,
+    pub subject: String,
+    pub kind: String,
+    pub created_utc: String,
+    pub repository: String,
+    pub base_commit: String,
+    pub scope: String,
+    pub instructions: Vec<String>,
+    pub predecessors: Vec<PredecessorRef>,
+    pub fingerprints: Fingerprints,
+    pub source_inventory: HashedPath,
+    pub runs: Vec<RunRef>,
+    /// Every committed evidence file for the subject outside `runs/`.
+    pub evidence_files: Vec<HashedPath>,
+    pub native_acceptance: Option<HashedPath>,
+    pub native_executable_sha256: Option<String>,
+    pub diff: HashedPath,
+    pub limitations: Vec<String>,
+    pub verdict_schema: HashedPath,
+    pub verdict_path: String,
+    pub review_instructions: String,
+}
+
+/// Facts about how the reviewer ran, recorded by the controller.
+#[derive(Clone, Debug, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct TransportRecord {
+    pub kind: String,
+    pub thread: Option<String>,
+    pub codex_path: String,
+    pub codex_version: String,
+    pub codex_sha256: String,
+    pub submitted_utc: String,
+    pub completed_utc: String,
+    /// Process exit status (fresh exec) or the queue command's (thread).
+    pub exit_code: Option<i32>,
+    pub timed_out: bool,
+    pub raw_output: Option<HashedPath>,
+    pub model: Option<String>,
+}
+
+/// Controller-written record of one review attempt. Its `passed` and
+/// `failures` fields are informational; the gate re-derives the decision.
+#[derive(Clone, Debug, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct Receipt {
+    pub schema: String,
+    pub receipt_id: String,
+    pub subject: String,
+    pub request_id: String,
+    pub attempt_id: String,
+    pub transport: TransportRecord,
+    pub packet_sha256: String,
+    pub verdict_sha256: String,
+    pub fingerprints: Fingerprints,
+    pub fingerprints_after: Fingerprints,
+    pub scores: Scores,
+    pub required_fixes: usize,
+    pub blockers: usize,
+    pub evidence_gaps: usize,
+    pub passed: bool,
+    pub failures: Vec<String>,
+    pub created_utc: String,
+}
+
+/// What the approved manifest and native inventory require of an attempt.
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct Expectations {
+    /// Exact command plan per required run kind.
+    pub plans: Vec<(RunKind, Vec<Command>)>,
+    /// Native acceptance requirements; None for phases.
+    pub native: Option<NativeExpectation>,
+}
+
+/// Everything the gate evaluates, already loaded.
+#[derive(Clone, Debug)]
+pub struct GateInputs {
+    pub receipt_bytes: Vec<u8>,
+    pub packet_bytes: Vec<u8>,
+    pub verdict_bytes: Option<Vec<u8>>,
+    pub attempt_expired: bool,
+    pub current: Fingerprints,
+    /// Run files named by the packet: (ref, bytes as currently on disk).
+    pub runs: Vec<(RunRef, Option<Vec<u8>>)>,
+    /// Command logs of those runs, keyed by repository-relative path.
+    pub logs: BTreeMap<String, Vec<u8>>,
+    pub native_bytes: Option<Vec<u8>>,
+    /// Raw reviewer output named by the receipt (thread reply or exec JSONL).
+    pub raw_output_bytes: Option<Vec<u8>>,
+    /// Predecessor receipts named by the packet, as currently on disk.
+    pub predecessors: Vec<(PredecessorRef, Option<Vec<u8>>)>,
+    pub expect: Expectations,
+}
+
+/// Evaluates a review attempt. An empty list means the gate passes.
+pub fn evaluate(inputs: &GateInputs) -> Vec<String> {
+    let mut failures = Vec::new();
+    let receipt: Receipt = match serde_json::from_slice(&inputs.receipt_bytes) {
+        Ok(r) => r,
+        Err(e) => return vec![format!("receipt is malformed: {e}")],
+    };
+    if receipt.schema != RECEIPT_SCHEMA {
+        failures.push("receipt has the wrong schema".to_owned());
+    }
+    let packet: Packet = match serde_json::from_slice(&inputs.packet_bytes) {
+        Ok(p) => p,
+        Err(e) => {
+            failures.push(format!("request packet is malformed: {e}"));
+            return failures;
+        }
+    };
+    if packet.schema != PACKET_SCHEMA {
+        failures.push("request packet has the wrong schema".to_owned());
+    }
+    if sha256_hex(&inputs.packet_bytes) != receipt.packet_sha256 {
+        failures.push("request packet bytes do not match the receipt (edited packet)".to_owned());
+    }
+    if receipt.request_id != packet.request_id
+        || receipt.attempt_id != packet.attempt_id
+        || receipt.subject != packet.subject
+    {
+        failures.push("receipt identity does not match its request packet".to_owned());
+    }
+    if inputs.attempt_expired {
+        failures.push("the attempt is expired; its verdict cannot advance the gate".to_owned());
+    }
+    let Some(verdict_bytes) = inputs.verdict_bytes.as_ref() else {
+        failures.push("no reviewer-authored verdict exists (submission is not review)".to_owned());
+        return failures;
+    };
+    if sha256_hex(verdict_bytes) != receipt.verdict_sha256 {
+        failures.push("verdict bytes do not match the receipt (edited verdict)".to_owned());
+    }
+    let verdict = match Verdict::parse(verdict_bytes) {
+        Err(e) => {
+            failures.push(e.to_string());
+            None
+        }
+        Ok(verdict) => {
+            if verdict.request_id != packet.request_id {
+                failures.push("verdict request_id does not match the packet".to_owned());
+            }
+            if verdict.attempt_id != packet.attempt_id {
+                failures.push("verdict attempt_id does not match the packet".to_owned());
+            }
+            if verdict.subject != packet.subject {
+                failures.push("verdict subject does not match the packet".to_owned());
+            }
+            if verdict.fingerprints != packet.fingerprints {
+                failures.push("verdict fingerprints differ from the frozen packet".to_owned());
+            }
+            if verdict.scores != receipt.scores {
+                failures.push("receipt scores differ from the verdict".to_owned());
+            }
+            failures.extend(verdict.threshold_failures(MINIMUM_SCORE));
+            Some(verdict)
+        }
+    };
+    if receipt.fingerprints != packet.fingerprints {
+        failures.push("receipt fingerprints differ from the packet".to_owned());
+    }
+    if receipt.fingerprints_after != packet.fingerprints {
+        failures.push("inputs changed while the review was active".to_owned());
+    }
+    let current = &inputs.current;
+    let frozen = &packet.fingerprints;
+    if current.source != frozen.source {
+        failures.push("source changed since review (stale receipt)".to_owned());
+    }
+    if current.dependencies != frozen.dependencies {
+        failures.push("dependencies or toolchain changed since review".to_owned());
+    }
+    if current.build_flags != frozen.build_flags {
+        failures.push("build flags/features changed since review".to_owned());
+    }
+    if current.evidence != frozen.evidence {
+        failures.push("evidence changed since review".to_owned());
+    }
+    failures.extend(transport_failures(inputs, &receipt, verdict.as_ref()));
+    failures.extend(predecessor_failures(inputs, &packet));
+    failures.extend(run_failures(inputs, &packet));
+    if let Some(native) = inputs.expect.native.as_ref() {
+        failures.extend(native_failures(inputs, &packet, native));
+    }
+    failures
+}
+
+/// Extracts every JSON object embedded in a text (whole text or substrings
+/// beginning at `{`).
+fn json_objects(text: &str) -> Vec<serde_json::Value> {
+    let mut found = Vec::new();
+    for (i, _) in text.match_indices('{') {
+        let mut stream =
+            serde_json::Deserializer::from_str(&text[i..]).into_iter::<serde_json::Value>();
+        if let Some(Ok(value)) = stream.next()
+            && value.is_object()
+        {
+            found.push(value);
+        }
+    }
+    found
+}
+
+/// The reviewer's actual completion: the transport finished successfully and
+/// its final structured output equals verdict.json.
+fn transport_failures(
+    inputs: &GateInputs,
+    receipt: &Receipt,
+    verdict: Option<&Verdict>,
+) -> Vec<String> {
+    let transport = &receipt.transport;
+    let Some(reference) = transport.raw_output.as_ref() else {
+        return vec!["no raw reviewer output corroborates the verdict".to_owned()];
+    };
+    let Some(bytes) = inputs.raw_output_bytes.as_ref() else {
+        return vec!["raw reviewer output is missing".to_owned()];
+    };
+    let mut failures = Vec::new();
+    if sha256_hex(bytes) != reference.sha256 {
+        failures.push("raw reviewer output was edited".to_owned());
+    }
+    if transport.timed_out {
+        failures.push("the reviewer transport timed out".to_owned());
+    }
+    if transport.exit_code != Some(0) {
+        failures.push(format!(
+            "the reviewer transport exited with {:?}",
+            transport.exit_code
+        ));
+    }
+    let expected = verdict.and_then(|v| serde_json::to_value(v).ok());
+    let mut final_outputs: Vec<String> = Vec::new();
+    let text = String::from_utf8_lossy(bytes);
+    match transport.kind.as_str() {
+        "codex-thread" => {
+            if transport.thread.is_none() {
+                failures.push("thread transport without a thread ID".to_owned());
+            }
+            for line in text.lines() {
+                let Ok(event) = serde_json::from_str::<serde_json::Value>(line) else {
+                    continue;
+                };
+                let timestamp = event["timestamp"].as_str().unwrap_or_default();
+                if event["payload"]["type"] == "task_complete"
+                    && timestamp >= transport.submitted_utc.as_str()
+                    && let Some(message) = event["payload"]["last_agent_message"].as_str()
+                {
+                    final_outputs.push(message.to_owned());
+                }
+            }
+        }
+        "codex-exec-fresh" => {
+            let (forbidden, _) = crate::transport::inspect_events(bytes);
+            failures.extend(forbidden);
+            let mut completed = false;
+            let mut last_message = None;
+            for line in text.lines() {
+                let Ok(event) = serde_json::from_str::<serde_json::Value>(line) else {
+                    continue;
+                };
+                match event["type"].as_str().unwrap_or_default() {
+                    "turn.completed" => completed = true,
+                    "turn.failed" | "error" => {
+                        failures.push("the fresh reviewer turn failed".to_owned())
+                    }
+                    "item.completed" if event["item"]["type"] == "agent_message" => {
+                        last_message = event["item"]["text"].as_str().map(str::to_owned);
+                    }
+                    _ => {}
+                }
+            }
+            if !completed {
+                failures.push("the fresh reviewer turn never completed".to_owned());
+            }
+            final_outputs.extend(last_message);
+        }
+        other => failures.push(format!("unknown transport {other}")),
+    }
+    if final_outputs.is_empty() {
+        failures.push("no completed reviewer turn with a final output was observed".to_owned());
+    } else if let Some(expected) = expected {
+        let matches = final_outputs
+            .iter()
+            .any(|message| json_objects(message).contains(&expected));
+        if !matches {
+            failures.push("the reviewer's final output does not equal verdict.json".to_owned());
+        }
+    }
+    failures
+}
+
+fn predecessor_failures(inputs: &GateInputs, packet: &Packet) -> Vec<String> {
+    let mut failures = Vec::new();
+    if inputs.predecessors.len() != packet.predecessors.len() {
+        failures.push("predecessor evidence does not match the packet".to_owned());
+    }
+    for (reference, bytes) in &inputs.predecessors {
+        match bytes {
+            None => failures.push(format!(
+                "predecessor {} receipt is missing",
+                reference.subject
+            )),
+            Some(bytes) if sha256_hex(bytes) != reference.receipt.sha256 => {
+                failures.push(format!(
+                    "predecessor {} receipt was changed",
+                    reference.subject
+                ));
+            }
+            Some(_) => {}
+        }
+    }
+    failures
+}
+
+fn run_failures(inputs: &GateInputs, packet: &Packet) -> Vec<String> {
+    let mut failures = Vec::new();
+    let mut kinds_seen = BTreeSet::new();
+    for (kind, _) in &inputs.expect.plans {
+        if packet.runs.iter().filter(|r| r.kind == *kind).count() != 1 {
+            failures.push(format!("expected exactly one {kind:?} run in the packet"));
+        }
+    }
+    for (run_ref, bytes) in &inputs.runs {
+        let id = &run_ref.run_id;
+        let Some(bytes) = bytes else {
+            failures.push(format!("run {id} is missing"));
+            continue;
+        };
+        if sha256_hex(bytes) != run_ref.sha256 {
+            failures.push(format!("run {id} was edited after freezing"));
+            continue;
+        }
+        let record: RunRecord = match serde_json::from_slice(bytes) {
+            Ok(r) => r,
+            Err(e) => {
+                failures.push(format!("run {id} is malformed: {e}"));
+                continue;
+            }
+        };
+        if record.schema != RUN_SCHEMA
+            || record.subject != packet.subject
+            || record.kind != run_ref.kind
+            || record.run_id != run_ref.run_id
+            || run_ref.path
+                != format!(
+                    "docs/planning/evidence/{}/runs/{}/run.json",
+                    packet.subject, record.run_id
+                )
+        {
+            failures.push(format!("run {id} identity does not match its reference"));
+        }
+        kinds_seen.insert(format!("{:?}", record.kind));
+        if record.status != Status::Passed || record.failure.is_some() {
+            failures.push(format!("run {id} did not pass"));
+        }
+        let Some((_, plan)) = inputs.expect.plans.iter().find(|(k, _)| *k == record.kind) else {
+            failures.push(format!("run {id} is of an unexpected kind"));
+            continue;
+        };
+        if record.commands.len() != plan.len() {
+            failures.push(format!(
+                "run {id} recorded {} commands; the approved plan has {}",
+                record.commands.len(),
+                plan.len()
+            ));
+        }
+        for (i, expected) in plan.iter().enumerate() {
+            let Some(command) = record.commands.get(i) else {
+                break;
+            };
+            let label = &expected.label;
+            if command.label != *label || command.argv != expected.argv {
+                failures.push(format!("run {id} command {i} is not the approved {label}"));
+            }
+            if command.status != Status::Passed || command.exit_code != Some(0) {
+                failures.push(format!(
+                    "run {id} command {label} did not exit successfully"
+                ));
+            }
+            if expected.expects_tests {
+                match &command.tests {
+                    Some(t) if t.passed > 0 && t.failed == 0 => {}
+                    _ => failures.push(format!(
+                        "run {id} command {label} executed no passing tests"
+                    )),
+                }
+            }
+            let log_path = format!(
+                "docs/planning/evidence/{}/runs/{}/{}",
+                packet.subject, record.run_id, command.log
+            );
+            match inputs.logs.get(&log_path) {
+                Some(log) if sha256_hex(log) == command.output_sha256 => {}
+                Some(_) => {
+                    failures.push(format!("run {id} log for {label} does not match its hash"))
+                }
+                None => failures.push(format!("run {id} log for {label} is missing")),
+            }
+        }
+        for state in [&record.inputs_before, &record.inputs_after] {
+            if state.source != packet.fingerprints.source
+                || state.dependencies != packet.fingerprints.dependencies
+                || state.build_flags != packet.fingerprints.build_flags
+            {
+                failures.push(format!("run {id} executed against different inputs"));
+                break;
+            }
+        }
+        if record.kind == RunKind::NativePrepare {
+            let artifact = |name: &str| {
+                record
+                    .artifacts
+                    .iter()
+                    .find(|a| a.name == name)
+                    .map(|a| a.sha256.clone())
+            };
+            if artifact("fixture-executable").as_deref()
+                != packet.native_executable_sha256.as_deref()
+                || packet.native_executable_sha256.is_none()
+            {
+                failures.push(format!(
+                    "run {id} does not record the packet's prepared executable"
+                ));
+            }
+            if let Some(native) = inputs.expect.native.as_ref() {
+                let bundle = artifact("fixture-bundle");
+                if bundle.is_none() || bundle != native.prepared_bundle_sha256 {
+                    failures.push(format!(
+                        "run {id} does not record the prepared fixture bundle"
+                    ));
+                }
+            }
+        }
+    }
+    failures
+}
+
+fn native_failures(
+    inputs: &GateInputs,
+    packet: &Packet,
+    expect: &NativeExpectation,
+) -> Vec<String> {
+    let Some(reference) = packet.native_acceptance.as_ref() else {
+        return vec!["missing native acceptance evidence".to_owned()];
+    };
+    let Some(bytes) = inputs.native_bytes.as_ref() else {
+        return vec!["native acceptance record is missing".to_owned()];
+    };
+    if sha256_hex(bytes) != reference.sha256 {
+        return vec!["native acceptance record was edited after freezing".to_owned()];
+    }
+    if packet.native_executable_sha256.as_deref()
+        != Some(expect.prepared_executable_sha256.as_str())
+    {
+        return vec![
+            "the packet's prepared executable differs from the native expectation".to_owned(),
+        ];
+    }
+    match NativeAcceptance::parse(bytes) {
+        Ok(record) => record.failures(&packet.subject, expect),
+        Err(e) => vec![e.to_string()],
+    }
+}
+
+/// Loads gate inputs for a receipt from disk. `native` is completed with the
+/// packet's evidence index and prepared executable.
+pub fn load(
+    root: &Path,
+    receipt_path: &Path,
+    current: Fingerprints,
+    plans: Vec<(RunKind, Vec<Command>)>,
+    native: Option<NativeBase>,
+) -> Result<GateInputs> {
+    let receipt_bytes = std::fs::read(receipt_path).map_err(io_err(receipt_path))?;
+    let attempt_dir = receipt_path
+        .parent()
+        .ok_or_else(|| invalid("receipt has no attempt directory"))?;
+    let packet_path = attempt_dir.join("request.json");
+    let packet_bytes = std::fs::read(&packet_path).map_err(io_err(&packet_path))?;
+    let packet: Packet = serde_json::from_slice(&packet_bytes)
+        .map_err(|e| invalid(format!("request packet is malformed: {e}")))?;
+    let verdict_bytes = std::fs::read(&packet.verdict_path).ok();
+    let read = |relative: &str| -> Option<Vec<u8>> { std::fs::read(root.join(relative)).ok() };
+    let runs: Vec<(RunRef, Option<Vec<u8>>)> = packet
+        .runs
+        .iter()
+        .map(|r| (r.clone(), read(&r.path)))
+        .collect();
+    let mut logs = BTreeMap::new();
+    for (run_ref, bytes) in &runs {
+        let Some(record) = bytes
+            .as_ref()
+            .and_then(|b| serde_json::from_slice::<RunRecord>(b).ok())
+        else {
+            continue;
+        };
+        let dir = run_ref.path.trim_end_matches("run.json");
+        for command in &record.commands {
+            let path = format!("{dir}{}", command.log);
+            if let Some(log) = read(&path) {
+                logs.insert(path, log);
+            }
+        }
+    }
+    let native_bytes = packet
+        .native_acceptance
+        .as_ref()
+        .and_then(|n| read(&n.path));
+    let receipt: Receipt = serde_json::from_slice(&receipt_bytes)
+        .map_err(|e| invalid(format!("receipt is malformed: {e}")))?;
+    let raw_output_bytes = receipt
+        .transport
+        .raw_output
+        .as_ref()
+        .and_then(|r| read(&r.path));
+    let predecessors = packet
+        .predecessors
+        .iter()
+        .map(|p| (p.clone(), read(&p.receipt.path)))
+        .collect();
+    let native = native.map(|base| NativeExpectation {
+        required_checks: base.required_checks,
+        fixture_identifier: base.fixture_identifier,
+        prepared_executable_sha256: packet.native_executable_sha256.clone().unwrap_or_default(),
+        prepared_bundle: base.prepared_bundle,
+        prepared_bundle_sha256: base.prepared_bundle_sha256,
+        prepared_identifier: base.prepared_identifier,
+        current_executable_sha256: base.current_executable_sha256,
+        current_bundle_sha256: base.current_bundle_sha256,
+        current_identifier: base.current_identifier,
+        evidence_files: packet
+            .evidence_files
+            .iter()
+            .map(|e| e.path.clone())
+            .collect(),
+    });
+    Ok(GateInputs {
+        receipt_bytes,
+        packet_bytes,
+        verdict_bytes,
+        attempt_expired: attempt_dir.join("expired.json").exists(),
+        current,
+        runs,
+        logs,
+        native_bytes,
+        raw_output_bytes,
+        predecessors,
+        expect: Expectations { plans, native },
+    })
+}
+
+/// Native requirements known before reading a packet.
