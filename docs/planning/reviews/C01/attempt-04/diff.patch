diff --git a/crates/xtask/src/bindings.rs b/crates/xtask/src/bindings.rs
new file mode 100644
index 0000000..b035eb1
--- /dev/null
+++ b/crates/xtask/src/bindings.rs
@@ -0,0 +1,61 @@
+//! Generated TypeScript wire declarations (ts-rs) and their drift check.
+
+use std::path::Path;
+
+use crate::{Repo, Result, invalid, io_err, random_hex};
+
+pub const GENERATED_DIR: &str = "packages/desktop-contracts/src/generated";
+
+fn files(dir: &Path) -> Result<Vec<(String, Vec<u8>)>> {
+    let mut out = Vec::new();
+    if !dir.is_dir() {
+        return Ok(out);
+    }
+    for entry in std::fs::read_dir(dir)
+        .map_err(io_err(dir))?
+        .filter_map(|e| e.ok())
+    {
+        let path = entry.path();
+        if path.extension().is_some_and(|e| e == "ts") {
+            let bytes = std::fs::read(&path).map_err(io_err(&path))?;
+            out.push((entry.file_name().to_string_lossy().into_owned(), bytes));
+        }
+    }
+    out.sort();
+    Ok(out)
+}
+
+/// Regenerates into a scratch directory; writes (or with `check`, compares).
+pub fn run(repo: &Repo, check: bool) -> Result<()> {
+    let scratch = std::env::temp_dir().join(format!("airs-v2-bindings-{}", random_hex(6)?));
+    desktop_core::wire::export_typescript(&scratch)
+        .map_err(|e| invalid(format!("ts-rs export failed: {e}")))?;
+    let fresh = files(&scratch)?;
+    let target = repo.join(GENERATED_DIR);
+    let result = if check {
+        let committed = files(&target)?;
+        if committed == fresh {
+            Ok(())
+        } else {
+            let names =
+                |v: &[(String, Vec<u8>)]| v.iter().map(|(n, _)| n.clone()).collect::<Vec<_>>();
+            Err(invalid(format!(
+                "generated bindings differ from Rust DTOs; run `cargo run -p xtask -- bindings` (committed {:?}, fresh {:?})",
+                names(&committed),
+                names(&fresh)
+            )))
+        }
+    } else {
+        if target.is_dir() {
+            std::fs::remove_dir_all(&target).map_err(io_err(&target))?;
+        }
+        std::fs::create_dir_all(&target).map_err(io_err(&target))?;
+        for (name, bytes) in &fresh {
+            let path = target.join(name);
+            std::fs::write(&path, bytes).map_err(io_err(&path))?;
+        }
+        Ok(())
+    };
+    let _ = std::fs::remove_dir_all(&scratch);
+    result
+}
diff --git a/crates/xtask/src/cli.rs b/crates/xtask/src/cli.rs
new file mode 100644
index 0000000..644a0a4
--- /dev/null
+++ b/crates/xtask/src/cli.rs
@@ -0,0 +1,436 @@
+//! Strict command-line parsing and dispatch for `cargo run -p xtask -- ...`.
+
+use std::path::PathBuf;
+
+use crate::env::Environment;
+use crate::manifest::Manifest;
+use crate::review::TransportChoice;
+use crate::runner::{RunKind, Runner, Status};
+use crate::{
+    Repo, Result, Subject, bindings, complete, fingerprint, gate, invalid, ledger, native, package,
+    review, shared, transport,
+};
+
+const USAGE: &str = "usage: xtask <command> [options]
+  check|test        --chunk Cxx|--phase Pxx --manifest docs/architecture/checks.json
+  native            --chunk Cxx --manifest docs/architecture/checks.json
+  native-prepare    --chunk Cxx --target aarch64-apple-darwin --features test-fixtures
+  review            --chunk Cxx|--phase Pxx --reviewer codex --manifest docs/architecture/checks.json [--transport auto|thread|fresh] [--limitation TEXT]... [--native-pending REASON]
+  complete          --chunk Cxx|--phase Pxx --manifest docs/architecture/checks.json
+  reopen            --chunk Cxx|--phase Pxx --reason TEXT --manifest docs/architecture/checks.json
+  verify-commit     --chunk Cxx|--phase Pxx
+  validate-receipt  --receipt PATH --chunk Cxx|--phase Pxx [--gate-only]
+  fingerprint       --chunk Cxx|--phase Pxx
+  handshake
+  bindings          [--check]
+  ledger            [--check]
+  notices           [--check]
+  fetch-inputs      --source PATH_TO_ACADEMY_GIT_REPO
+  shared-prepare    --input .inputs/academy --scratch .work/academy
+  shared-lifecycle  --allowlist docs/architecture/shared-lifecycle.json --scratch .work/academy [--list]
+  package           --kind preview|release-candidate --manifest docs/architecture/checks.json";
+
+struct Args {
+    command: String,
+    options: Vec<(String, Option<String>)>,
+}
+
+impl Args {
+    fn parse(raw: Vec<String>) -> Result<Self> {
+        let mut iter = raw.into_iter();
+        let command = iter.next().ok_or_else(|| invalid(USAGE))?;
+        let mut options = Vec::new();
+        let rest: Vec<String> = iter.collect();
+        let mut i = 0;
+        while i < rest.len() {
+            let flag = &rest[i];
+            if !flag.starts_with("--") {
+                return Err(invalid(format!("unexpected argument {flag:?}\n{USAGE}")));
+            }
+            let value = rest.get(i + 1).filter(|v| !v.starts_with("--")).cloned();
+            i += if value.is_some() { 2 } else { 1 };
+            options.push((flag.clone(), value));
+        }
+        Ok(Self { command, options })
+    }
+
+    fn value(&self, flag: &str) -> Option<&str> {
+        self.options
+            .iter()
+            .find(|(f, _)| f == flag)
+            .and_then(|(_, v)| v.as_deref())
+    }
+
+    fn values(&self, flag: &str) -> Vec<String> {
+        self.options
+            .iter()
+            .filter(|(f, _)| f == flag)
+            .filter_map(|(_, v)| v.clone())
+            .collect()
+    }
+
+    fn has(&self, flag: &str) -> bool {
+        self.options.iter().any(|(f, _)| f == flag)
+    }
+
+    fn require(&self, flag: &str) -> Result<&str> {
+        self.value(flag)
+            .ok_or_else(|| invalid(format!("{} requires {flag}\n{USAGE}", self.command)))
+    }
+
+    fn only(&self, allowed: &[&str]) -> Result<()> {
+        for (flag, _) in &self.options {
+            if !allowed.contains(&flag.as_str()) {
+                return Err(invalid(format!(
+                    "{} does not accept {flag}\n{USAGE}",
+                    self.command
+                )));
+            }
+        }
+        Ok(())
+    }
+
+    fn subject(&self) -> Result<Subject> {
+        match (self.value("--chunk"), self.value("--phase")) {
+            (Some(c), None) => match Subject::parse(c)? {
+                s @ Subject::Chunk(_) => Ok(s),
+                _ => Err(invalid("--chunk expects C01-C26")),
+            },
+            (None, Some(p)) => match Subject::parse(p)? {
+                s @ Subject::Phase(_) => Ok(s),
+                _ => Err(invalid("--phase expects P01-P08")),
+            },
+            _ => Err(invalid(format!(
+                "exactly one of --chunk or --phase is required\n{USAGE}"
+            ))),
+        }
+    }
+
+    fn manifest(&self, repo: &Repo) -> Result<Manifest> {
+        let given = self.require("--manifest")?;
+        if given != "docs/architecture/checks.json" {
+            return Err(invalid(
+                "only the approved manifest docs/architecture/checks.json is accepted",
+            ));
+        }
+        Manifest::load(&repo.manifest())
+    }
+}
+
+pub fn main(raw: Vec<String>) -> Result<()> {
+    let repo = Repo::discover();
+    let args = Args::parse(raw)?;
+    match args.command.as_str() {
+        "check" | "test" => {
+            args.only(&["--chunk", "--phase", "--manifest"])?;
+            let manifest = args.manifest(&repo)?;
+            let subject = args.subject()?;
+            let env = Environment::prepare(&repo)?;
+            let kind = if args.command == "check" {
+                RunKind::Check
+            } else {
+                RunKind::Test
+            };
+            let commands = manifest.plan(subject, kind)?;
+            let shared_env;
+            let env_ref = if kind == RunKind::Check
+                && commands.iter().any(|c| c.label.starts_with("shared/"))
+            {
+                let version = shared::lock(&repo)?.academy.package_version;
+                shared_env = env.clone().with("npm_package_version", &version);
+                &shared_env
+            } else {
+                &env
+            };
+            let runner = Runner {
+                repo: &repo,
+                manifest: &manifest,
+                env: env_ref,
+                subject,
+            };
+            let record = runner.run(kind, &commands, &|_| intrinsic_checks(&repo, &manifest))?;
+            report(&record)
+        }
+        "native-prepare" => {
+            args.only(&["--chunk", "--phase", "--target", "--features"])?;
+            let manifest = Manifest::load(&repo.manifest())?;
+            let subject = args.subject()?;
+            let env = Environment::prepare(&repo)?;
+            let features: Vec<String> = args
+                .require("--features")?
+                .split(',')
+                .map(str::to_owned)
+                .collect();
+            let prepared = native::prepare(
+                &repo,
+                &manifest,
+                &env,
+                subject,
+                args.require("--target")?,
+                &features,
+            )?;
+            println!(
+                "prepared {} ({}) executable sha256 {}",
+                prepared.bundle, prepared.identifier, prepared.executable_sha256
+            );
+            Ok(())
+        }
+        "native" => {
+            args.only(&["--chunk", "--phase", "--manifest"])?;
+            let manifest = args.manifest(&repo)?;
+            let subject = args.subject()?;
+            let env = Environment::prepare(&repo)?;
+            let commands = manifest.plan(subject, RunKind::NativePrepare)?;
+            let runner = Runner {
+                repo: &repo,
+                manifest: &manifest,
+                env: &env,
+                subject,
+            };
+            let record = runner.run(RunKind::NativePrepare, &commands, &|record| {
+                fingerprint::verify_consumed_shared(&repo)?;
+                record.artifacts.extend(native::artifacts(&repo, subject)?);
+                Ok(())
+            })?;
+            report(&record)?;
+            let sha = record
+                .artifacts
+                .first()
+                .map(|a| a.sha256.clone())
+                .unwrap_or_default();
+            let pending = native::acceptance_status(&repo, &manifest, subject, &sha);
+            if pending.is_empty() {
+                println!("native acceptance recorded for executable {sha}");
+                Ok(())
+            } else {
+                Err(invalid(pending.join("; ")))
+            }
+        }
+        "review" => {
+            args.only(&[
+                "--chunk",
+                "--phase",
+                "--reviewer",
+                "--manifest",
+                "--transport",
+                "--limitation",
+                "--native-pending",
+            ])?;
+            if args.require("--reviewer")? != "codex" {
+                return Err(invalid("the reviewer is codex (D026)"));
+            }
+            let manifest = args.manifest(&repo)?;
+            let subject = args.subject()?;
+            let env = Environment::prepare(&repo)?;
+            let choice = match args.value("--transport").unwrap_or("auto") {
+                "auto" => TransportChoice::Auto,
+                "thread" => TransportChoice::Thread,
+                "fresh" => TransportChoice::Fresh,
+                other => return Err(invalid(format!("unknown transport {other}"))),
+            };
+            let outcome = review::review(
+                &repo,
+                &manifest,
+                &env,
+                subject,
+                choice,
+                args.values("--limitation"),
+                args.value("--native-pending").map(str::to_owned),
+            )?;
+            println!("receipt: {}", outcome.receipt.display());
+            if outcome.passed {
+                println!("review gate: PASS");
+                Ok(())
+            } else {
+                Err(invalid(format!(
+                    "review gate: FAIL\n  - {}",
+                    outcome.failures.join("\n  - ")
+                )))
+            }
+        }
+        "complete" => {
+            args.only(&["--chunk", "--phase", "--manifest"])?;
+            let manifest = args.manifest(&repo)?;
+            let subject = args.subject()?;
+            let env = Environment::prepare(&repo)?;
+            let current = fingerprint::all(&repo, &manifest, subject, &env.toolchain_hash())?;
+            let entry = complete::complete(&repo, &manifest, subject, current)?;
+            println!(
+                "{}",
+                serde_json::to_string_pretty(&entry).unwrap_or_default()
+            );
+            Ok(())
+        }
+        "reopen" => {
+            args.only(&["--chunk", "--phase", "--reason", "--manifest"])?;
+            let manifest = args.manifest(&repo)?;
+            let written =
+                complete::reopen(&repo, &manifest, args.subject()?, args.require("--reason")?)?;
+            println!(
+                "{}",
+                serde_json::to_string_pretty(&written).unwrap_or_default()
+            );
+            Ok(())
+        }
+        "verify-commit" => {
+            args.only(&["--chunk", "--phase"])?;
+            let entry = complete::verify_commit(&repo, args.subject()?)?;
+            println!(
+                "{}",
+                serde_json::to_string_pretty(&entry).unwrap_or_default()
+            );
+            Ok(())
+        }
+        "validate-receipt" => {
+            args.only(&["--receipt", "--chunk", "--phase", "--gate-only"])?;
+            let manifest = Manifest::load(&repo.manifest())?;
+            let subject = args.subject()?;
+            let env = Environment::prepare(&repo)?;
+            let current = fingerprint::all(&repo, &manifest, subject, &env.toolchain_hash())?;
+            let receipt = PathBuf::from(args.require("--receipt")?);
+            // --gate-only omits C01's bootstrap record, which is produced by
+            // comparing this very evaluation with the reference validator.
+            let failures = if args.has("--gate-only") {
+                let (plans, native) = complete::expectations(&repo, &manifest, subject)?;
+                gate::evaluate(&gate::load(repo.root(), &receipt, current, plans, native)?)
+            } else {
+                complete::evaluate_receipt(&repo, &manifest, subject, &receipt, current)?
+            };
+            if failures.is_empty() {
+                println!("receipt valid against current inputs");
+                Ok(())
+            } else {
+                Err(invalid(format!(
+                    "receipt rejected:\n  - {}",
+                    failures.join("\n  - ")
+                )))
+            }
+        }
+        "fingerprint" => {
+            args.only(&["--chunk", "--phase"])?;
+            let manifest = Manifest::load(&repo.manifest())?;
+            let env = Environment::prepare(&repo)?;
+            let fp = fingerprint::all(&repo, &manifest, args.subject()?, &env.toolchain_hash())?;
+            println!("{}", serde_json::to_string_pretty(&fp).unwrap_or_default());
+            Ok(())
+        }
+        "handshake" => {
+            args.only(&[])?;
+            let manifest = Manifest::load(&repo.manifest())?;
+            let env = Environment::prepare(&repo)?;
+            let codex = transport::Codex::resolve(&env, &manifest.reviewer, repo.root())?;
+            println!(
+                "codex {} ({}) sha256 {}",
+                codex.version, codex.path, codex.sha256
+            );
+            let route = transport::handshake(
+                &env,
+                &manifest.reviewer,
+                repo.root(),
+                &repo.transport_dir(),
+                std::time::Duration::from_secs(300),
+            )?;
+            println!("route ready: {}", route.display());
+            Ok(())
+        }
+        "bindings" => {
+            args.only(&["--check"])?;
+            bindings::run(&repo, args.has("--check"))
+        }
+        "notices" => {
+            args.only(&["--check"])?;
+            let env = Environment::prepare(&repo)?;
+            crate::notices::run(&env, &repo, args.has("--check"))
+        }
+        "ledger" => {
+            args.only(&["--check"])?;
+            if args.has("--check") {
+                ledger::check(&repo)
+            } else {
+                ledger::generate(&repo)
+            }
+        }
+        "fetch-inputs" => {
+            args.only(&["--source"])?;
+            let hash = shared::fetch(&repo, &PathBuf::from(args.require("--source")?))?;
+            println!(".inputs/academy tree sha256 {hash}");
+            Ok(())
+        }
+        "shared-prepare" => {
+            args.only(&["--input", "--scratch"])?;
+            shared::prepare(
+                &repo,
+                &PathBuf::from(args.require("--input")?),
+                &PathBuf::from(args.require("--scratch")?),
+            )
+        }
+        "shared-lifecycle" => {
+            args.only(&["--allowlist", "--scratch", "--list"])?;
+            let scratch = PathBuf::from(args.require("--scratch")?);
+            if args.has("--list") {
+                for (_, name, version, hook, script) in
+                    shared::discover_scripts(&repo.join(&scratch))?
+                {
+                    println!("{name}@{version} {hook}: {script}");
+                }
+                return Ok(());
+            }
+            let env = Environment::prepare(&repo)?;
+            let ran = shared::lifecycle(
+                &repo,
+                &env,
+                &PathBuf::from(args.require("--allowlist")?),
+                &scratch,
+            )?;
+            println!("ran allowlisted lifecycle scripts: {ran:?}");
+            Ok(())
+        }
+        "package" => {
+            args.only(&["--kind", "--manifest"])?;
+            let _manifest = args.manifest(&repo)?;
+            let kind = package::Kind::parse(args.require("--kind")?)?;
+            let completed = package::gate(&repo, kind)?;
+            println!(
+                "package gate passed for completed chunks {completed:?}; artifact build/signing validators are owned by C26"
+            );
+            Ok(())
+        }
+        _ => Err(invalid(USAGE)),
+    }
+}
+
+/// Controller-intrinsic checks recorded with every check/test run.
+fn intrinsic_checks(repo: &Repo, manifest: &Manifest) -> Result<()> {
+    ledger::check(repo)?;
+    fingerprint::verify_consumed_shared(repo)?;
+    crate::env::refuse_env_files(repo)?;
+    let _ = manifest;
+    Ok(())
+}
+
+fn report(record: &crate::runner::RunRecord) -> Result<()> {
+    for command in &record.commands {
+        let tests = command
+            .tests
+            .as_ref()
+            .map(|t| format!(" tests passed={} failed={}", t.passed, t.failed))
+            .unwrap_or_default();
+        println!(
+            "{:?} {} {}{}",
+            command.status,
+            command.label,
+            command.argv.join(" "),
+            tests
+        );
+    }
+    println!("run {} {:?}", record.run_id, record.status);
+    match record.status {
+        Status::Passed => Ok(()),
+        _ => Err(invalid(
+            record
+                .failure
+                .clone()
+                .unwrap_or_else(|| "run failed".to_owned()),
+        )),
+    }
+}
diff --git a/crates/xtask/src/complete.rs b/crates/xtask/src/complete.rs
new file mode 100644
index 0000000..c928617
--- /dev/null
+++ b/crates/xtask/src/complete.rs
@@ -0,0 +1,490 @@
+//! The append-only completion ledger, generations and predecessor rules.
+//!
+//! `complete` is a read-only validation of the current inputs against a
+//! review receipt followed by one appended line. Lines are never edited.
+//! Each subject's completions carry a generation; `reopen` appends an
+//! invalidation for the subject's current generation and for every later
+//! completed subject, after which a new review completes a new generation.
+//! A subject counts as complete only when its latest generation has a
+//! completion, a commit bound to the same receipt, no invalidation, and a
+//! receipt file whose bytes still match the ledger.
+
+use std::io::Write;
+use std::path::{Path, PathBuf};
+use std::process::Command;
+
+use serde::{Deserialize, Serialize};
+
+use crate::evidence;
+use crate::fingerprint::{self, Fingerprints};
+use crate::gate::{self, NativeBase, Receipt};
+use crate::manifest::{Command as PlannedCommand, Manifest};
+use crate::native::{self, Prepared};
+use crate::runner::RunKind;
+use crate::{Repo, Result, Subject, invalid, io_err, now_utc, read_json, sha256_hex};
+
+#[derive(Clone, Debug, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(tag = "kind", rename_all = "lowercase", deny_unknown_fields)]
+pub enum Entry {
+    Completion {
+        subject: String,
+        generation: u32,
+        receipt_id: String,
+        receipt: String,
+        receipt_sha256: String,
+        fingerprints: Fingerprints,
+        completed_utc: String,
+    },
+    Commit {
+        subject: String,
+        generation: u32,
+        receipt_id: String,
+        commit: String,
+        tree: String,
+        source: String,
+        verified_utc: String,
+    },
+    Invalidation {
+        subject: String,
+        generation: u32,
+        reason: String,
+        invalidated_utc: String,
+    },
+}
+
+pub fn read_ledger(path: &Path) -> Result<Vec<Entry>> {
+    let Ok(text) = std::fs::read_to_string(path) else {
+        return Ok(Vec::new());
+    };
+    text.lines()
+        .filter(|l| !l.trim().is_empty())
+        .map(|l| {
+            serde_json::from_str(l)
+                .map_err(|e| invalid(format!("corrupt completion ledger line: {e}")))
+        })
+        .collect()
+}
+
+fn append(path: &Path, entry: &Entry) -> Result<()> {
+    let line = serde_json::to_string(entry).map_err(|e| invalid(e.to_string()))?;
+    if let Some(parent) = path.parent() {
+        std::fs::create_dir_all(parent).map_err(io_err(parent))?;
+    }
+    let mut file = std::fs::OpenOptions::new()
+        .create(true)
+        .append(true)
+        .open(path)
+        .map_err(io_err(path))?;
+    writeln!(file, "{line}").map_err(io_err(path))
+}
+
+/// The latest completion generation of a subject and its entry.
+fn latest_completion(entries: &[Entry], subject: Subject) -> Option<&Entry> {
+    let id = subject.to_string();
+    entries
+        .iter()
+        .filter(|e| matches!(e, Entry::Completion { subject, .. } if *subject == id))
+        .max_by_key(|e| match e {
+            Entry::Completion { generation, .. } => *generation,
+            _ => 0,
+        })
+}
+
+fn highest_generation(entries: &[Entry], subject: Subject) -> u32 {
+    let id = subject.to_string();
+    entries
+        .iter()
+        .filter_map(|e| match e {
+            Entry::Completion {
+                subject,
+                generation,
+                ..
+            } if *subject == id => Some(*generation),
+            _ => None,
+        })
+        .max()
+        .unwrap_or(0)
+}
+
+/// Why `subject` is not currently complete (empty when it is).
+pub fn completion_problems(repo: &Repo, entries: &[Entry], subject: Subject) -> Vec<String> {
+    let id = subject.to_string();
+    let Some(Entry::Completion {
+        generation,
+        receipt_id,
+        receipt,
+        receipt_sha256,
+        ..
+    }) = latest_completion(entries, subject)
+    else {
+        return vec![format!("{subject} has no completion")];
+    };
+    let mut problems = Vec::new();
+    if entries.iter().any(|e| matches!(e, Entry::Invalidation { subject, generation: g, .. } if *subject == id && g == generation)) {
+        problems.push(format!("{subject} generation {generation} was invalidated"));
+    }
+    let committed = entries.iter().any(|e| {
+        matches!(e, Entry::Commit { subject, generation: g, receipt_id: r, .. } if *subject == id && g == generation && r == receipt_id)
+    });
+    if !committed {
+        problems.push(format!(
+            "{subject} generation {generation} has no verified commit"
+        ));
+    }
+    match std::fs::read(repo.join(receipt)) {
+        Err(_) => problems.push(format!("{subject} receipt {receipt} is missing")),
+        Ok(bytes) => {
+            if sha256_hex(&bytes) != *receipt_sha256 {
+                problems.push(format!(
+                    "{subject} receipt {receipt} was changed after completion"
+                ));
+            } else if let Ok(parsed) = serde_json::from_slice::<Receipt>(&bytes) {
+                let scores_ok = parsed
+                    .scores
+                    .named()
+                    .iter()
+                    .all(|(_, s)| *s >= gate::MINIMUM_SCORE);
+                if !parsed.passed
+                    || !scores_ok
+                    || parsed.required_fixes + parsed.blockers + parsed.evidence_gaps > 0
+                {
+                    problems.push(format!(
+                        "{subject} receipt does not record a passing review"
+                    ));
+                }
+            } else {
+                problems.push(format!("{subject} receipt is malformed"));
+            }
+        }
+    }
+    problems
+}
+
+pub fn is_completed(repo: &Repo, entries: &[Entry], subject: Subject) -> bool {
+    completion_problems(repo, entries, subject).is_empty()
+}
+
+/// Subjects that must be complete (reviewed and committed) before `subject`.
+pub fn predecessors(manifest: &Manifest, subject: Subject) -> Result<Vec<Subject>> {
+    match subject {
+        Subject::Chunk(1) => Ok(Vec::new()),
+        Subject::Chunk(n) => {
+            let mut required = vec![Subject::Chunk(n - 1)];
+            let phase = manifest.phase_of(subject)?;
+            let previous_phase = manifest.phase_of(Subject::Chunk(n - 1))?;
+            if phase != previous_phase {
+                required.push(previous_phase);
+            }
+            Ok(required)
+        }
+        Subject::Phase(_) => manifest.phase_chunks(subject),
+    }
+}
+
+/// The historical planning gate C01 depends on (reviewed by Claude, D019).
+pub fn g01_receipt(repo: &Repo) -> PathBuf {
+    repo.join("docs/planning/reviews/G01/attempt-05/receipt.json")
+}
+
+pub fn check_g01(repo: &Repo) -> Result<()> {
+    let receipt: serde_json::Value = read_json(&g01_receipt(repo))?;
+    let passed = receipt.get("passed").and_then(|v| v.as_bool()) == Some(true);
+    let scores_ok = receipt
+        .get("scores")
+        .and_then(|s| s.as_object())
+        .is_some_and(|s| s.len() == 5 && s.values().all(|v| v.as_u64().is_some_and(|n| n >= 9)));
+    if passed && scores_ok {
+        Ok(())
+    } else {
+        Err(invalid(
+            "historical G01 receipt does not record a passing design gate",
+        ))
+    }
+}
+
+pub fn require_predecessors(repo: &Repo, manifest: &Manifest, subject: Subject) -> Result<()> {
+    if subject == Subject::Chunk(1) {
+        return check_g01(repo);
+    }
+    let entries = read_ledger(&repo.completion_ledger())?;
+    for required in predecessors(manifest, subject)? {
+        let problems = completion_problems(repo, &entries, required);
+        if !problems.is_empty() {
+            return Err(invalid(format!(
+                "{subject} requires {required}: {}",
+                problems.join("; ")
+            )));
+        }
+    }
+    Ok(())
+}
+
+/// Every chunk and every phase needs check, test and native-prepare runs;
+/// a phase's native evidence is for its integrated tree.
+pub fn required_runs(_subject: Subject) -> Vec<RunKind> {
+    vec![RunKind::Check, RunKind::Test, RunKind::NativePrepare]
+}
+
+/// Approved command plans, one per required run kind.
+pub type Plans = Vec<(RunKind, Vec<PlannedCommand>)>;
+
+/// The approved command plans and native requirements for a subject.
+pub fn expectations(
+    repo: &Repo,
+    manifest: &Manifest,
+    subject: Subject,
+) -> Result<(Plans, Option<NativeBase>)> {
+    let plans = required_runs(subject)
+        .into_iter()
+        .map(|kind| Ok((kind, manifest.plan(subject, kind)?)))
+        .collect::<Result<Vec<_>>>()?;
+    let members = manifest.native_members(subject)?;
+    let (required_checks, fixture_identifier) =
+        evidence::required_checks(&repo.join("docs/architecture/native-checks.json"), &members)?;
+    let prepared =
+        read_json::<Prepared>(&repo.evidence_dir(subject).join("native-prepare.json")).ok();
+    let current = prepared.as_ref().map(|p| native::current_state(repo, p));
+    Ok((
+        plans,
+        Some(NativeBase {
+            required_checks,
+            fixture_identifier,
+            prepared_bundle: prepared.as_ref().map(|p| p.bundle.clone()),
+            prepared_bundle_sha256: prepared.as_ref().map(|p| p.bundle_sha256.clone()),
+            prepared_identifier: prepared.as_ref().map(|p| p.identifier.clone()),
+            current_executable_sha256: current.as_ref().and_then(|c| c.executable_sha256.clone()),
+            current_bundle_sha256: current.as_ref().and_then(|c| c.bundle_sha256.clone()),
+            current_identifier: current.and_then(|c| c.identifier),
+        }),
+    ))
+}
+
+/// Evaluates one receipt exactly as `complete` does.
+pub fn evaluate_receipt(
+    repo: &Repo,
+    manifest: &Manifest,
+    subject: Subject,
+    receipt: &Path,
+    current: Fingerprints,
+) -> Result<Vec<String>> {
+    let (plans, native) = expectations(repo, manifest, subject)?;
+    let inputs = gate::load(repo.root(), receipt, current, plans, native)?;
+    let mut failures = gate::evaluate(&inputs);
+    if subject == Subject::Chunk(1) {
+        failures.extend(bootstrap_failures(receipt, &inputs.receipt_bytes));
+    }
+    Ok(failures)
+}
+
+/// Bootstrap evidence for C01: the independent reference validator and the
+/// controller agree on this exact receipt and on every adversarial mutation.
+/// It lives in the attempt directory, outside the hash-bound evidence.
+#[derive(Clone, Debug, Deserialize)]
+struct Bootstrap {
+    receipt_sha256: String,
+    reference_accepted: bool,
+    controller_accepted: bool,
+    adversarial_cases: usize,
+    adversarial_agreement: bool,
+}
+
+fn bootstrap_failures(receipt: &Path, receipt_bytes: &[u8]) -> Vec<String> {
+    let path = gate::attempt_dir_of(receipt).join("bootstrap/result.json");
+    let Ok(record) = read_json::<Bootstrap>(&path) else {
+        return vec![
+            "C01 bootstrap: independent reference validation result is missing".to_owned(),
+        ];
+    };
+    let mut failures = Vec::new();
+    if record.receipt_sha256 != sha256_hex(receipt_bytes) {
+        failures.push("C01 bootstrap result is for a different receipt".to_owned());
+    }
+    if !record.reference_accepted || !record.controller_accepted {
+        failures.push("C01 bootstrap: the validators did not both accept the receipt".to_owned());
+    }
+    if !record.adversarial_agreement || record.adversarial_cases == 0 {
+        failures
+            .push("C01 bootstrap: validators did not agree on every adversarial case".to_owned());
+    }
+    failures
+}
+
+/// Validates the newest passing receipt and appends a completion line.
+pub fn complete(
+    repo: &Repo,
+    manifest: &Manifest,
+    subject: Subject,
+    current: Fingerprints,
+) -> Result<Entry> {
+    require_predecessors(repo, manifest, subject)?;
+    let ledger = repo.completion_ledger();
+    let entries = read_ledger(&ledger)?;
+    if is_completed(repo, &entries, subject) {
+        return Err(invalid(format!(
+            "{subject} is already complete; reopen it before completing a new generation"
+        )));
+    }
+    let mut attempts: Vec<PathBuf> = std::fs::read_dir(repo.reviews_dir(subject))
+        .map_err(io_err(&repo.reviews_dir(subject)))?
+        .filter_map(|e| e.ok())
+        .map(|e| e.path().join("receipt.json"))
+        .filter(|p| p.is_file())
+        .collect();
+    attempts.sort();
+    let mut last_failures = vec!["no review receipt exists".to_owned()];
+    for receipt_path in attempts.iter().rev() {
+        let failures = evaluate_receipt(repo, manifest, subject, receipt_path, current.clone())?;
+        if !failures.is_empty() {
+            last_failures = failures;
+            continue;
+        }
+        let bytes = std::fs::read(receipt_path).map_err(io_err(receipt_path))?;
+        let receipt: Receipt =
+            serde_json::from_slice(&bytes).map_err(|e| invalid(e.to_string()))?;
+        if entries.iter().any(|e| matches!(e, Entry::Completion { receipt_id, .. } if *receipt_id == receipt.receipt_id)) {
+            return Err(invalid("duplicate receipt ID; a receipt can complete only once"));
+        }
+        let entry = Entry::Completion {
+            subject: subject.to_string(),
+            generation: highest_generation(&entries, subject) + 1,
+            receipt_id: receipt.receipt_id,
+            receipt: receipt_path
+                .strip_prefix(repo.root())
+                .unwrap_or(receipt_path)
+                .display()
+                .to_string(),
+            receipt_sha256: sha256_hex(&bytes),
+            fingerprints: current,
+            completed_utc: now_utc(),
+        };
+        append(&ledger, &entry)?;
+        return Ok(entry);
+    }
+    Err(invalid(format!(
+        "{subject} cannot complete: {}",
+        last_failures.join("; ")
+    )))
+}
+
+/// Invalidates the subject's current generation and every later completed
+/// subject, so they must be re-reviewed and completed again.
+pub fn reopen(
+    repo: &Repo,
+    manifest: &Manifest,
+    subject: Subject,
+    reason: &str,
+) -> Result<Vec<Entry>> {
+    let ledger = repo.completion_ledger();
+    let entries = read_ledger(&ledger)?;
+    let mut affected = vec![subject];
+    let order: Vec<Subject> = (1..=26u8)
+        .flat_map(|n| {
+            let chunk = Subject::Chunk(n);
+            let mut out = vec![chunk];
+            if let Ok(phase) = manifest.phase_of(chunk)
+                && manifest
+                    .phase_chunks(phase)
+                    .ok()
+                    .and_then(|c| c.last().copied())
+                    == Some(chunk)
+            {
+                out.push(phase);
+            }
+            out
+        })
+        .collect();
+    let position = order
+        .iter()
+        .position(|s| *s == subject)
+        .ok_or_else(|| invalid("unknown subject"))?;
+    affected.extend(order[position + 1..].iter().copied());
+    let mut written = Vec::new();
+    for target in affected {
+        if latest_completion(&entries, target).is_none() {
+            continue;
+        }
+        let generation = highest_generation(&entries, target);
+        let entry = Entry::Invalidation {
+            subject: target.to_string(),
+            generation,
+            reason: if target == subject {
+                reason.to_owned()
+            } else {
+                format!("depends on reopened {subject}: {reason}")
+            },
+            invalidated_utc: now_utc(),
+        };
+        append(&ledger, &entry)?;
+        written.push(entry);
+    }
+    if written.is_empty() {
+        return Err(invalid(format!("{subject} has no completion to reopen")));
+    }
+    Ok(written)
+}
+
+fn git(repo: &Repo, args: &[&str]) -> Result<String> {
+    let output = Command::new("/usr/bin/git")
+        .args(args)
+        .current_dir(repo.root())
+        .env_clear()
+        .env("PATH", "/usr/bin:/bin")
+        .env("HOME", std::env::var("HOME").unwrap_or_default())
+        .output()
+        .map_err(io_err(repo.root()))?;
+    if !output.status.success() {
+        return Err(invalid(format!("git {} failed", args.join(" "))));
+    }
+    Ok(String::from_utf8_lossy(&output.stdout).trim().to_owned())
+}
+
+/// Verifies HEAD contains exactly the reviewed source and records the commit
+/// against the subject's latest completion generation.
+pub fn verify_commit(repo: &Repo, subject: Subject) -> Result<Entry> {
+    let ledger = repo.completion_ledger();
+    let entries = read_ledger(&ledger)?;
+    let Some(Entry::Completion {
+        generation,
+        receipt_id,
+        fingerprints,
+        ..
+    }) = latest_completion(&entries, subject)
+    else {
+        return Err(invalid(format!(
+            "{subject} has no completion to bind a commit to"
+        )));
+    };
+    let id = subject.to_string();
+    if entries.iter().any(|e| matches!(e, Entry::Invalidation { subject, generation: g, .. } if *subject == id && g == generation)) {
+        return Err(invalid(format!("{subject} generation {generation} is invalidated")));
+    }
+    let status = git(repo, &["status", "--porcelain=v1", "--untracked-files=all"])?;
+    let dirty: Vec<&str> = status
+        .lines()
+        .map(|l| l.get(3..).unwrap_or(l))
+        .filter(|p| !fingerprint::is_excluded(p))
+        .collect();
+    if !dirty.is_empty() {
+        return Err(invalid(format!(
+            "working tree has uncommitted source changes: {}",
+            dirty.join(", ")
+        )));
+    }
+    let source = fingerprint::source(repo)?;
+    if source != fingerprints.source {
+        return Err(invalid(
+            "committed source differs from the reviewed source fingerprint",
+        ));
+    }
+    let entry = Entry::Commit {
+        subject: id,
+        generation: *generation,
+        receipt_id: receipt_id.clone(),
+        commit: git(repo, &["rev-parse", "HEAD"])?,
+        tree: git(repo, &["rev-parse", "HEAD^{tree}"])?,
+        source,
+        verified_utc: now_utc(),
+    };
+    append(&ledger, &entry)?;
+    Ok(entry)
+}
