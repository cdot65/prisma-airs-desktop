+#[test]
+fn navigation_policy_accepts_only_packaged_assets() {
+    for url in ["tauri://localhost/index.html", "tauri://localhost/"] {
+        assert!(
+            desktop_host::is_packaged_origin(&url.parse().expect("url")),
+            "{url}"
+        );
+    }
+    for url in [
+        "https://localhost/",
+        "http://localhost:1420/",
