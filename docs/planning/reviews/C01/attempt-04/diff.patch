+    inventory = {c["id"]: c["check"] for c in json.load(open(os.path.join(ROOT, "docs/architecture/native-checks.json")))["chunks"]["C01"]}
+    add("C01-N01", flows["C01-N01"][0], flows["C01-N01"][1], [run_path, caps["launch"]], inventory["C01-N01"])
