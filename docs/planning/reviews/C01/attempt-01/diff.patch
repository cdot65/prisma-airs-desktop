@@ -0,0 +1,68 @@
+//! Repository-relative locations the controller reads and writes.
+
+use std::path::{Path, PathBuf};
+
+use crate::Subject;
+
+/// Root of a Prisma AIRS Desktop v2 checkout.
+#[derive(Clone, Debug)]
+pub struct Repo {
+    root: PathBuf,
+}
+
+impl Repo {
+    pub fn new(root: impl Into<PathBuf>) -> Self {
+        Self { root: root.into() }
+    }
+
+    /// Locates the checkout from the xtask crate's compile-time location.
+    pub fn discover() -> Self {
+        let manifest_dir = Path::new(env!("CARGO_MANIFEST_DIR"));
+        Self::new(
+            manifest_dir
+                .parent()
+                .and_then(Path::parent)
+                .unwrap_or(manifest_dir),
+        )
+    }
+
+    pub fn root(&self) -> &Path {
+        &self.root
+    }
+
+    pub fn join(&self, relative: impl AsRef<Path>) -> PathBuf {
+        self.root.join(relative)
+    }
+
+    pub fn manifest(&self) -> PathBuf {
+        self.join("docs/architecture/checks.json")
+    }
+
+    pub fn toolchain_manifest(&self) -> PathBuf {
+        self.join("docs/architecture/toolchain.json")
+    }
+
+    pub fn verdict_schema(&self) -> PathBuf {
+        self.join("docs/architecture/review-verdict.schema.json")
+    }
+
+    /// Committed, redacted evidence for one subject.
+    pub fn evidence_dir(&self, subject: Subject) -> PathBuf {
+        self.join(format!("docs/planning/evidence/{subject}"))
+    }
+
+    /// Immutable review attempts for one subject.
+    pub fn reviews_dir(&self, subject: Subject) -> PathBuf {
+        self.join(format!("docs/planning/reviews/{subject}"))
+    }
+
+    /// Append-only completion ledger.
+    pub fn completion_ledger(&self) -> PathBuf {
+        self.join("docs/planning/evidence/completions.jsonl")
+    }
+
+    /// Transport handshake records.
+    pub fn transport_dir(&self) -> PathBuf {
+        self.join("docs/planning/reviews/transport")
+    }
+}
diff --git a/crates/xtask/src/review.rs b/crates/xtask/src/review.rs
new file mode 100644
index 0000000..96cd325
--- /dev/null
+++ b/crates/xtask/src/review.rs
@@ -0,0 +1,540 @@
+//! Freezes inputs, writes the immutable request packet, delivers it to Codex
+//! and records a receipt derived from the reviewer-authored verdict.
+
+use std::path::{Path, PathBuf};
+use std::process::Command;
+use std::time::Duration;
+
+use crate::complete::{self, Entry, read_ledger};
+use crate::env::Environment;
+use crate::fingerprint::{self, Fingerprints};
+use crate::gate::{self, HashedPath, Packet, PredecessorRef, Receipt, RunRef, TransportRecord};
+use crate::manifest::Manifest;
+use crate::runner::{self, RunKind, Status};
+use crate::transport::{self, Codex};
+use crate::verdict::Verdict;
+use crate::{
+    Repo, Result, Subject, invalid, io_err, now_utc, random_hex, sha256_hex, write_json, write_new,
+};
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum TransportChoice {
+    /// Preferred thread when its handshake succeeds, else a fresh reviewer.
+    Auto,
+    Thread,
+    Fresh,
+}
+
+/// The commit the current subject's diff is measured from.
+fn base_commit(repo: &Repo) -> Result<String> {
+    let entries = read_ledger(&repo.completion_ledger())?;
+    let last = entries.iter().rev().find_map(|e| match e {
+        Entry::Commit { commit, .. } => Some(commit.clone()),
+        Entry::Completion { .. } => None,
+    });
+    // Before any completion, the reviewed planning baseline.
+    Ok(last.unwrap_or_else(|| "931916bf7469fba71aa15ee2a9cb6d2d194abf83".to_owned()))
+}
+
+/// Diff from base including untracked files, via a throwaway index so the
+/// real index is never modified.
+fn write_diff(repo: &Repo, base: &str, out: &Path) -> Result<HashedPath> {
+    let index = std::env::temp_dir().join(format!("airs-v2-review-index-{}", random_hex(6)?));
+    let git = |args: &[&str]| -> Result<Vec<u8>> {
+        let output = Command::new("/usr/bin/git")
+            .args(args)
+            .current_dir(repo.root())
+            .env_clear()
+            .env("PATH", "/usr/bin:/bin")
+            .env("HOME", std::env::var("HOME").unwrap_or_default())
+            .env("GIT_INDEX_FILE", &index)
+            .output()
+            .map_err(io_err(repo.root()))?;
+        if !output.status.success() {
+            return Err(invalid(format!(
+                "git {} failed: {}",
+                args.join(" "),
+                String::from_utf8_lossy(&output.stderr)
+            )));
+        }
+        Ok(output.stdout)
+    };
+    git(&["read-tree", base])?;
+    git(&["add", "-A", "--", "."])?;
+    let diff = git(&[
+        "diff",
+        "--cached",
+        "--stat",
+        "--patch",
+        base,
+        "--",
+        ".",
+        ":(exclude)docs/planning/reviews",
+        ":(exclude)*.lock",
+        ":(exclude)pnpm-lock.yaml",
+        ":(exclude)docs/planning/evidence/*/runs",
+    ])?;
+    let _ = std::fs::remove_file(&index);
+    write_new(out, &diff)?;
+    Ok(HashedPath {
+        path: rel(repo, out),
+        sha256: sha256_hex(&diff),
+    })
+}
+
+fn rel(repo: &Repo, path: &Path) -> String {
+    path.strip_prefix(repo.root())
+        .unwrap_or(path)
+        .display()
+        .to_string()
+}
+
+fn hashed(repo: &Repo, path: &Path) -> Result<HashedPath> {
+    let bytes = std::fs::read(path).map_err(io_err(path))?;
+    Ok(HashedPath {
+        path: rel(repo, path),
+        sha256: sha256_hex(&bytes),
+    })
+}
+
+/// Latest passing run of each required kind executed against `fingerprints`.
+fn select_runs(
+    repo: &Repo,
+    subject: Subject,
+    fingerprints: &Fingerprints,
+) -> Result<(Vec<RunRef>, Option<String>)> {
+    let runs = runner::load_runs(repo, subject)?;
+    let mut selected = Vec::new();
+    let mut executable = None;
+    for kind in complete::required_runs(subject) {
+        let found = runs.iter().rev().find(|(_, r)| {
+            r.kind == kind
+                && r.status == Status::Passed
+                && r.inputs_before.source == fingerprints.source
+                && r.inputs_before.dependencies == fingerprints.dependencies
+                && r.inputs_before.build_flags == fingerprints.build_flags
+        });
+        let Some((path, record)) = found else {
+            return Err(invalid(format!(
+                "no passing {kind:?} run against the current inputs; run it before requesting review"
+            )));
+        };
+        if kind == RunKind::NativePrepare {
+            executable = record
+                .artifacts
+                .iter()
+                .find(|a| a.name == "fixture-executable")
+                .map(|a| a.sha256.clone());
+        }
+        let bytes = std::fs::read(path).map_err(io_err(path))?;
+        selected.push(RunRef {
+            kind,
+            run_id: record.run_id.clone(),
+            path: rel(repo, path),
+            sha256: sha256_hex(&bytes),
+        });
+    }
+    Ok((selected, executable))
+}
+
+/// Hashes every evidence file for the subject outside `runs/` (run records
+/// are bound individually through [`RunRef`]).
+fn evidence_files(repo: &Repo, subject: Subject) -> Result<Vec<HashedPath>> {
+    let dir = repo.evidence_dir(subject);
+    let mut out = Vec::new();
+    let mut stack = vec![dir.clone()];
+    while let Some(current) = stack.pop() {
+        let Ok(entries) = std::fs::read_dir(&current) else {
+            continue;
+        };
+        for entry in entries.filter_map(|e| e.ok()) {
+            let path = entry.path();
+            if path.is_dir() {
+                if path != dir.join("runs") {
+                    stack.push(path);
+                }
+            } else {
+                out.push(hashed(repo, &path)?);
+            }
+        }
+    }
+    out.sort_by(|a, b| a.path.cmp(&b.path));
+    Ok(out)
+}
+
+fn next_attempt(dir: &Path) -> Result<(String, PathBuf)> {
+    std::fs::create_dir_all(dir).map_err(io_err(dir))?;
+    let mut highest = 0u32;
+    for entry in std::fs::read_dir(dir)
+        .map_err(io_err(dir))?
+        .filter_map(|e| e.ok())
+    {
+        let name = entry.file_name().to_string_lossy().into_owned();
+        if let Some(n) = name
+            .strip_prefix("attempt-")
+            .and_then(|n| n.parse::<u32>().ok())
+        {
+            highest = highest.max(n);
+        }
+    }
+    let id = format!("attempt-{:02}", highest + 1);
+    Ok((id.clone(), dir.join(id)))
+}
+
+/// Expires every earlier attempt that never produced a receipt.
+fn expire_pending(dir: &Path, reason: &str) -> Result<()> {
+    let Ok(entries) = std::fs::read_dir(dir) else {
+        return Ok(());
+    };
+    for entry in entries.filter_map(|e| e.ok()) {
+        let attempt = entry.path();
+        if attempt.join("request.json").is_file()
+            && !attempt.join("receipt.json").is_file()
+            && !attempt.join("expired.json").is_file()
+        {
+            write_json(
+                &attempt.join("expired.json"),
+                &serde_json::json!({ "expired_utc": now_utc(), "reason": reason }),
+            )?;
+        }
+    }
+    Ok(())
+}
+
+fn extract_block(markdown: &str, index: usize) -> Result<String> {
+    markdown
+        .split("```text\n")
+        .nth(index + 1)
+        .and_then(|rest| rest.split("\n```").next())
+        .map(str::to_owned)
+        .ok_or_else(|| invalid("review prompt is missing its text block"))
+}
+
+fn instructions(
+    repo: &Repo,
+    manifest: &Manifest,
+    subject: Subject,
+) -> Result<(String, String, Vec<String>)> {
+    let chunk_prompt_path = repo.join("docs/planning/prompts/review-chunk.md");
+    let chunk_prompt =
+        std::fs::read_to_string(&chunk_prompt_path).map_err(io_err(&chunk_prompt_path))?;
+    let message = extract_block(&chunk_prompt, 0)?;
+    if subject.is_phase() {
+        let path = repo.join("docs/planning/prompts/review-phase.md");
+        let phase_prompt = std::fs::read_to_string(&path).map_err(io_err(&path))?;
+        let chunks: Vec<String> = manifest
+            .phase_chunks(subject)?
+            .iter()
+            .map(Subject::to_string)
+            .collect();
+        let text = extract_block(&phase_prompt, 0)?
+            .replace("PHASE_ID", &subject.to_string())
+            .replace("CHUNK_LIST", &chunks.join(", "));
+        let files = chunks
+            .iter()
+            .map(|c| format!("docs/planning/chunks/{c}.md"))
+            .collect();
+        Ok((message, text, files))
+    } else {
+        let text = extract_block(&chunk_prompt, 1)?.replace("CHUNK_ID", &subject.to_string());
+        Ok((
+            message,
+            text,
+            vec![format!("docs/planning/chunks/{subject}.md")],
+        ))
+    }
+}
+
+fn predecessor_refs(
+    repo: &Repo,
+    manifest: &Manifest,
+    subject: Subject,
+) -> Result<Vec<PredecessorRef>> {
+    if subject == Subject::Chunk(1) {
+        return Ok(vec![PredecessorRef {
+            subject: "G01".to_owned(),
+            receipt: hashed(repo, &complete::g01_receipt(repo))?,
+        }]);
+    }
+    let entries = read_ledger(&repo.completion_ledger())?;
+    let mut refs = Vec::new();
+    for required in complete::predecessors(manifest, subject)? {
+        let receipt = entries.iter().rev().find_map(|e| match e {
+            Entry::Completion {
+                subject: s,
+                receipt,
+                ..
+            } if *s == required.to_string() => Some(receipt.clone()),
+            _ => None,
+        });
+        let receipt =
+            receipt.ok_or_else(|| invalid(format!("{required} has no completion receipt")))?;
+        refs.push(PredecessorRef {
+            subject: required.to_string(),
+            receipt: hashed(repo, &repo.join(receipt))?,
+        });
+    }
+    Ok(refs)
+}
+
+pub struct Outcome {
+    pub receipt: PathBuf,
+    pub passed: bool,
+    pub failures: Vec<String>,
+}
+
+pub fn review(
+    repo: &Repo,
+    manifest: &Manifest,
+    env: &Environment,
+    subject: Subject,
+    choice: TransportChoice,
+    limitations: Vec<String>,
+    native_pending: Option<String>,
+) -> Result<Outcome> {
+    let mut limitations = limitations;
+    complete::require_predecessors(repo, manifest, subject)?;
+    let reviewer = &manifest.reviewer;
+    let codex = Codex::resolve(env, reviewer, repo.root())?;
+    let fingerprints = fingerprint::all(repo, manifest, subject, &env.toolchain_hash())?;
+    let (runs, executable) = select_runs(repo, subject, &fingerprints)?;
+    let native_path = repo.evidence_dir(subject).join("native-acceptance.json");
+    let native_acceptance = if subject.is_phase() {
+        None
+    } else if native_path.is_file() {
+        Some(hashed(repo, &native_path)?)
+    } else if let Some(reason) = native_pending {
+        // An explicitly requested early review: the missing record is stated
+        // to the reviewer and the gate fails by construction.
+        limitations.push(format!(
+            "MANDATORY NATIVE ACCEPTANCE IS MISSING ({reason}); this attempt cannot pass the gate"
+        ));
+        None
+    } else {
+        return Err(invalid(
+            "native acceptance record is missing; mandatory native evidence is blocked, not optional",
+        ));
+    };
+    let reviews = repo.reviews_dir(subject);
+    expire_pending(&reviews, "superseded by a new review attempt")?;
+
+    let mut choice = choice;
+    loop {
+        let (attempt_id, attempt_dir) = next_attempt(&reviews)?;
+        let request_id = format!(
+            "rq-{subject}-{}-{}",
+            now_utc().replace([':', '-'], ""),
+            random_hex(4)?
+        );
+        let inventory = fingerprint::source_inventory(repo)?;
+        let inventory_path = attempt_dir.join("source-inventory.json");
+        write_new(
+            &inventory_path,
+            &serde_json::to_vec_pretty(&inventory).unwrap_or_default(),
+        )?;
+        let base = base_commit(repo)?;
+        let diff = write_diff(repo, &base, &attempt_dir.join("diff.patch"))?;
+        let (message_template, review_instructions, instruction_files) =
+            instructions(repo, manifest, subject)?;
+        let verdict_path = attempt_dir.join("verdict.json");
+        let packet_path = attempt_dir.join("request.json");
+        let packet = Packet {
+            schema: gate::PACKET_SCHEMA.to_owned(),
+            request_id: request_id.clone(),
+            attempt_id: attempt_id.clone(),
+            subject: subject.to_string(),
+            kind: if subject.is_phase() { "phase" } else { "chunk" }.to_owned(),
+            created_utc: now_utc(),
+            repository: repo.root().display().to_string(),
+            base_commit: base,
+            scope: if subject.is_phase() {
+                format!("cumulative phase review of {subject} and the earlier features it affects")
+            } else {
+                format!("implementation chunk {subject}")
+            },
+            instructions: instruction_files,
+            predecessors: predecessor_refs(repo, manifest, subject)?,
+            fingerprints: fingerprints.clone(),
+            source_inventory: hashed(repo, &inventory_path)?,
+            runs: runs.clone(),
+            evidence_files: evidence_files(repo, subject)?,
+            native_acceptance: native_acceptance.clone(),
+            native_executable_sha256: executable.clone(),
+            diff,
+            limitations: limitations.clone(),
+            verdict_schema: hashed(repo, &repo.verdict_schema())?,
+            verdict_path: verdict_path.display().to_string(),
+            review_instructions,
+        };
+        let packet_bytes =
+            serde_json::to_vec_pretty(&packet).map_err(|e| invalid(e.to_string()))?;
+        write_new(&packet_path, &packet_bytes)?;
+        let message = message_template
+            .replace("REQUEST_PACKET_PATH", &packet_path.display().to_string())
+            .replace("VERDICT_PATH", &verdict_path.display().to_string());
+
+        let use_thread = match choice {
+            TransportChoice::Fresh => false,
+            TransportChoice::Thread => true,
+            TransportChoice::Auto => {
+                match transport::handshake(
+                    env,
+                    reviewer,
+                    repo.root(),
+                    &repo.transport_dir(),
+                    Duration::from_secs(300),
+                ) {
+                    Ok(route) => {
+                        eprintln!("handshake confirmed: {}", route.display());
+                        true
+                    }
+                    Err(error) => {
+                        eprintln!("handshake failed ({error}); using a fresh Codex reviewer");
+                        false
+                    }
+                }
+            }
+        };
+
+        let submitted_utc = now_utc();
+        let (kind, thread, raw_output, model, extra_failures) = if use_thread {
+            let ack = transport::queue(env, reviewer, repo.root(), &message)?;
+            write_json(&attempt_dir.join("queue-ack.json"), &ack)?;
+            eprintln!(
+                "submitted to thread {} ({}); waiting for verdict",
+                reviewer.preferred_transport.thread, ack.stdout
+            );
+            if transport::wait_for_file(&verdict_path, reviewer, "thread verdict").is_none() {
+                write_json(
+                    &attempt_dir.join("expired.json"),
+                    &serde_json::json!({ "expired_utc": now_utc(), "reason": "no verdict from the preferred thread within the bounded wait; switching to a fresh reviewer" }),
+                )?;
+                choice = TransportChoice::Fresh;
+                continue;
+            }
+            let thread_id = reviewer.preferred_transport.thread.clone();
+            let reply = transport::wait_for_thread_reply(
+                &thread_id,
+                &request_id,
+                &submitted_utc,
+                Duration::from_secs(600),
+            );
+            let reply_path = attempt_dir.join("thread-reply.jsonl");
+            write_new(&reply_path, &reply)?;
+            let mut failures = Vec::new();
+            if reply.is_empty() {
+                failures
+                    .push("the thread transcript shows no reply naming this request".to_owned());
+            }
+            (
+                "codex-thread",
+                Some(thread_id),
+                Some(hashed(repo, &reply_path)?),
+                None,
+                failures,
+            )
+        } else {
+            let prompt = format!(
+                "You are a fresh, independent Codex reviewer with no prior context for this project. The repository is {}. {}\n\nThe request packet lists the scope, predecessor receipts, fingerprints, run evidence, diff and instructions; read it and the files it names. Your final message must be only the verdict JSON matching the provided output schema.",
+                repo.root().display(),
+                message
+            );
+            let result = transport::exec_fresh(
+                env,
+                reviewer,
+                repo.root(),
+                &repo.verdict_schema(),
+                &verdict_path,
+                &attempt_dir,
+                &prompt,
+            )?;
+            let raw = hashed(repo, &result.stdout_path)?;
+            let mut failures = result.forbidden_events;
+            if result.exit_code != Some(0) {
+                failures.push(format!("fresh reviewer exited with {:?}", result.exit_code));
+            }
+            ("codex-exec-fresh", None, Some(raw), result.model, failures)
+        };
+
+        let verdict_bytes = std::fs::read(&verdict_path).map_err(io_err(&verdict_path))?;
+        let fingerprints_after = fingerprint::all(repo, manifest, subject, &env.toolchain_hash())?;
+        let (scores, counts) = match Verdict::parse(&verdict_bytes) {
+            Ok(v) => (
+                v.scores.clone(),
+                (
+                    v.required_fixes.len(),
+                    v.blockers.len(),
+                    v.evidence_gaps.len(),
+                ),
+            ),
+            Err(e) => return Err(invalid(format!("attempt {attempt_id}: {e}"))),
+        };
+        let mut receipt = Receipt {
+            schema: gate::RECEIPT_SCHEMA.to_owned(),
+            receipt_id: format!("{subject}-{attempt_id}-{request_id}"),
+            subject: subject.to_string(),
+            request_id,
+            attempt_id,
+            transport: TransportRecord {
+                kind: kind.to_owned(),
+                thread,
+                codex_path: codex.path.clone(),
+                codex_version: codex.version.clone(),
+                codex_sha256: codex.sha256.clone(),
+                submitted_utc,
+                completed_utc: now_utc(),
+                raw_output,
+                model,
+            },
+            packet_sha256: sha256_hex(&packet_bytes),
+            verdict_sha256: sha256_hex(&verdict_bytes),
+            fingerprints: fingerprints.clone(),
+            fingerprints_after,
+            scores,
+            required_fixes: counts.0,
+            blockers: counts.1,
+            evidence_gaps: counts.2,
+            passed: false,
+            failures: Vec::new(),
+            created_utc: now_utc(),
+        };
+        let receipt_path = attempt_dir.join("receipt.json");
+        // Evaluate exactly as `complete` will, then record the outcome.
+        let provisional =
+            serde_json::to_vec_pretty(&receipt).map_err(|e| invalid(e.to_string()))?;
+        let inputs = gate::GateInputs {
+            receipt_bytes: provisional,
+            packet_bytes: packet_bytes.clone(),
+            verdict_bytes: Some(verdict_bytes),
+            attempt_expired: false,
+            current: fingerprint::all(repo, manifest, subject, &env.toolchain_hash())?,
+            runs: runs
+                .iter()
+                .map(|r| (r.clone(), std::fs::read(repo.join(&r.path)).ok()))
+                .collect(),
+            native_bytes: native_acceptance
+                .as_ref()
+                .and_then(|n| std::fs::read(repo.join(&n.path)).ok()),
+            raw_output_bytes: receipt
+                .transport
+                .raw_output
+                .as_ref()
+                .and_then(|r| std::fs::read(repo.join(&r.path)).ok()),
+            require_native: !subject.is_phase(),
+            required_run_kinds: complete::required_runs(subject),
+        };
+        let mut failures = gate::evaluate(&inputs);
+        failures.extend(extra_failures);
+        receipt.passed = failures.is_empty();
+        receipt.failures = failures.clone();
+        write_new(
+            &receipt_path,
+            &serde_json::to_vec_pretty(&receipt).map_err(|e| invalid(e.to_string()))?,
+        )?;
+        return Ok(Outcome {
+            receipt: receipt_path,
+            passed: failures.is_empty(),
+            failures,
+        });
+    }
+}
diff --git a/crates/xtask/src/runner.rs b/crates/xtask/src/runner.rs
new file mode 100644
index 0000000..eee0b79
--- /dev/null
+++ b/crates/xtask/src/runner.rs
@@ -0,0 +1,342 @@
+//! Executes manifest commands and records source-bound run evidence.
+
+use std::io::Read;
+use std::path::{Path, PathBuf};
+use std::process::Stdio;
+use std::time::Instant;
+
+use serde::{Deserialize, Serialize};
+
+use crate::env::{Environment, ToolIdentity};
+use crate::fingerprint;
+use crate::manifest::{Command, Manifest};
+use crate::{Repo, Result, Subject, invalid, io_err, now_utc, random_hex, sha256_hex, write_json};
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(rename_all = "kebab-case")]
+pub enum RunKind {
+    Check,
+    Test,
+    NativePrepare,
+}
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(rename_all = "lowercase")]
+pub enum Status {
+    Passed,
+    Failed,
+    Blocked,
+}
+
+#[derive(Clone, Debug, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct TestCounts {
+    pub passed: u64,
+    pub failed: u64,
+}
+
+#[derive(Clone, Debug, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct CommandResult {
+    pub label: String,
+    pub argv: Vec<String>,
+    pub cwd: String,
+    pub exit_code: Option<i32>,
+    pub duration_ms: u128,
+    pub output_sha256: String,
+    pub log: String,
+    pub tests: Option<TestCounts>,
+    pub status: Status,
+    pub note: Option<String>,
+}
+
+#[derive(Clone, Debug, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct InputState {
+    pub source: String,
+    pub dependencies: String,
+    pub build_flags: String,
+}
+
+#[derive(Clone, Debug, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct RunRecord {
+    pub schema: String,
+    pub run_id: String,
+    pub subject: String,
+    pub kind: RunKind,
+    pub started_utc: String,
+    pub finished_utc: String,
+    pub toolchain: Vec<ToolIdentity>,
+    pub env: std::collections::BTreeMap<String, String>,
+    pub inputs_before: InputState,
+    pub inputs_after: InputState,
+    pub commands: Vec<CommandResult>,
+    pub status: Status,
+    pub failure: Option<String>,
+    /// Artifacts produced by the run (path relative to repo and SHA-256).
+    #[serde(default)]
+    pub artifacts: Vec<Artifact>,
+}
+
+#[derive(Clone, Debug, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct Artifact {
+    pub name: String,
+    pub path: String,
+    pub sha256: String,
+}
+
+pub const RUN_SCHEMA: &str = "airs-v2/run/1";
+
+pub struct Runner<'a> {
+    pub repo: &'a Repo,
+    pub manifest: &'a Manifest,
+    pub env: &'a Environment,
+    pub subject: Subject,
+}
+
+impl Runner<'_> {
+    fn inputs(&self) -> Result<InputState> {
+        Ok(InputState {
+            source: fingerprint::source(self.repo)?,
+            dependencies: fingerprint::dependencies(self.repo, &self.env.toolchain_hash())?,
+            build_flags: fingerprint::build_flags(self.repo, self.manifest, self.subject)?,
+        })
+    }
+
+    /// Runs commands in order, stopping at the first failure. Every command
+    /// after a failure is recorded as blocked rather than silently skipped.
+    pub fn run(
+        &self,
+        kind: RunKind,
+        commands: &[Command],
+        extra: &dyn Fn(&mut RunRecord) -> Result<()>,
+    ) -> Result<RunRecord> {
+        let run_id = format!(
+            "{}-{}-{}",
+            kind_name(kind),
+            now_utc().replace([':', '-'], ""),
+            random_hex(3)?
+        );
+        let dir = self
+            .repo
+            .evidence_dir(self.subject)
+            .join("runs")
+            .join(&run_id);
+        let started_utc = now_utc();
+        let inputs_before = self.inputs()?;
+        let mut results = Vec::new();
+        let mut failure = None;
+        for command in commands {
+            if failure.is_some() {
+                results.push(blocked(command, "an earlier command failed"));
+                continue;
+            }
+            let result = self.execute(command, &dir)?;
+            if result.status != Status::Passed {
+                failure = Some(format!(
+                    "{} {}",
+                    result.label,
+                    result.note.clone().unwrap_or_default()
+                ));
+            }
+            results.push(result);
+        }
+        let inputs_after = self.inputs()?;
+        if failure.is_none() && inputs_before != inputs_after {
+            failure = Some("inputs changed while commands ran".to_owned());
+        }
+        let mut record = RunRecord {
+            schema: RUN_SCHEMA.to_owned(),
+            run_id,
+            subject: self.subject.to_string(),
+            kind,
+            started_utc,
+            finished_utc: now_utc(),
+            toolchain: self.env.tools.clone(),
+            env: self.env.recorded_vars(),
+            inputs_before,
+            inputs_after,
+            commands: results,
+            status: Status::Passed,
+            failure,
+            artifacts: Vec::new(),
+        };
+        if record.failure.is_none()
+            && let Err(error) = extra(&mut record)
+        {
+            record.failure = Some(error.to_string());
+        }
+        record.status = if record.failure.is_some() {
+            Status::Failed
+        } else {
+            Status::Passed
+        };
+        write_json(&dir.join("run.json"), &record)?;
+        Ok(record)
+    }
+
+    fn execute(&self, command: &Command, dir: &Path) -> Result<CommandResult> {
+        let argv = substitute(&command.argv, self.subject)?;
+        let log_rel = format!("logs/{}.log", command.label.replace('/', "-"));
+        let log_path = dir.join(&log_rel);
+        let started = Instant::now();
+        let mut process = match self.env.command(&argv, self.repo.root()) {
+            Ok(process) => process,
+            Err(error) => {
+                let mut result = blocked(command, &error.to_string());
+                result.argv = argv;
+                return Ok(result);
+            }
+        };
+        let output = process
+            .stdin(Stdio::null())
+            .stdout(Stdio::piped())
+            .stderr(Stdio::piped())
+            .spawn()
+            .and_then(|child| child.wait_with_output())
+            .map_err(io_err(self.repo.root()))?;
+        let mut log = output.stdout.clone();
+        log.extend_from_slice(b"\n--- stderr ---\n");
+        log.extend_from_slice(&output.stderr);
+        crate::write_atomic(&log_path, &log)?;
+        let text = String::from_utf8_lossy(&log);
+        let tests = if command.expects_tests {
+            parse_tests(&text)
+        } else {
+            None
+        };
+        let mut note = None;
+        let mut status = if output.status.success() {
+            Status::Passed
+        } else {
+            Status::Failed
+        };
+        if status == Status::Passed && command.expects_tests {
+            match &tests {
+                Some(t) if t.passed > 0 && t.failed == 0 => {}
+                Some(t) if t.failed > 0 => {
+                    status = Status::Failed;
+                    note = Some(format!("{} tests failed", t.failed));
+                }
+                _ => {
+                    status = Status::Failed;
+                    note = Some("no tests were executed (absent or zero-test target)".to_owned());
+                }
+            }
+        }
+        if status == Status::Failed && note.is_none() {
+            note = Some(format!("exit status {:?}", output.status.code()));
+        }
+        Ok(CommandResult {
+            label: command.label.clone(),
+            argv,
+            cwd: ".".to_owned(),
+            exit_code: output.status.code(),
+            duration_ms: started.elapsed().as_millis(),
+            output_sha256: sha256_hex(&log),
+            log: log_rel,
+            tests,
+            status,
+            note,
+        })
+    }
+}
+
+fn blocked(command: &Command, reason: &str) -> CommandResult {
+    CommandResult {
+        label: command.label.clone(),
+        argv: command.argv.clone(),
+        cwd: ".".to_owned(),
+        exit_code: None,
+        duration_ms: 0,
+        output_sha256: String::new(),
+        log: String::new(),
+        tests: None,
+        status: Status::Blocked,
+        note: Some(reason.to_owned()),
+    }
+}
+
+fn kind_name(kind: RunKind) -> &'static str {
+    match kind {
+        RunKind::Check => "check",
+        RunKind::Test => "test",
+        RunKind::NativePrepare => "native-prepare",
+    }
+}
+
+/// Replaces `{chunk}` with the validated subject; nothing else is substituted.
+pub fn substitute(argv: &[String], subject: Subject) -> Result<Vec<String>> {
+    argv.iter()
+        .map(|arg| match arg.as_str() {
+            "{chunk}" | "{phase}" => Ok(subject.to_string()),
+            other if other.contains('{') => Err(invalid(format!("unexpected placeholder {other}"))),
+            other => Ok(other.to_owned()),
+        })
+        .collect()
+}
+
+/// Extracts executed test counts from cargo test or vitest output.
+pub fn parse_tests(text: &str) -> Option<TestCounts> {
+    let mut found = false;
+    let mut counts = TestCounts {
+        passed: 0,
+        failed: 0,
+    };
+    for line in text.lines() {
+        let line = line.trim();
+        if let Some(rest) = line.strip_prefix("test result: ") {
+            found = true;
+            counts.passed += number_before(rest, " passed").unwrap_or(0);
+            counts.failed += number_before(rest, " failed").unwrap_or(0);
+        } else if let Some(rest) = line.strip_prefix("Tests ") {
+            // vitest: "Tests  3 failed | 12 passed (15)"
+            found = true;
+            counts.passed += number_before(rest, " passed").unwrap_or(0);
+            counts.failed += number_before(rest, " failed").unwrap_or(0);
+        }
+    }
+    found.then_some(counts)
+}
+
+fn number_before(text: &str, marker: &str) -> Option<u64> {
+    let end = text.find(marker)?;
+    let head = &text[..end];
+    let start = head
+        .rfind(|c: char| !c.is_ascii_digit())
+        .map_or(0, |i| i + 1);
+    head[start..].parse().ok()
+}
+
+/// Loads every run record for a subject.
+pub fn load_runs(repo: &Repo, subject: Subject) -> Result<Vec<(PathBuf, RunRecord)>> {
+    let dir = repo.evidence_dir(subject).join("runs");
+    let mut runs = Vec::new();
+    let Ok(entries) = std::fs::read_dir(&dir) else {
+        return Ok(runs);
+    };
+    for entry in entries.filter_map(|e| e.ok()) {
+        let path = entry.path().join("run.json");
+        if path.is_file() {
+            runs.push((path.clone(), crate::read_json::<RunRecord>(&path)?));
+        }
+    }
+    runs.sort_by(|a, b| {
+        a.1.started_utc
+            .cmp(&b.1.started_utc)
+            .then(a.1.run_id.cmp(&b.1.run_id))
+    });
+    Ok(runs)
+}
+
+/// Reads a log back for display (bounded).
+pub fn read_log_tail(path: &Path, max: usize) -> String {
+    let mut buf = Vec::new();
+    if let Ok(mut file) = std::fs::File::open(path) {
+        let _ = file.read_to_end(&mut buf);
+    }
+    let start = buf.len().saturating_sub(max);
+    String::from_utf8_lossy(&buf[start..]).into_owned()
+}
diff --git a/crates/xtask/src/shared.rs b/crates/xtask/src/shared.rs
new file mode 100644
index 0000000..59cb42c
--- /dev/null
+++ b/crates/xtask/src/shared.rs
@@ -0,0 +1,373 @@
+//! Immutable shared Academy input: fetch, verify, stage to scratch, and run
+//! only allowlisted dependency lifecycle scripts.
+//!
+//! `.inputs/academy` holds the exact archive of the reviewed Academy commit
+//! named in `docs/architecture/inputs.lock.json`; nothing is installed or
+//! built there. `shared-prepare` copies verified bytes into `.work/academy`
+//! (keeping only previously installed `node_modules`), refusing `.git`,
+//! `.env` files and symlinks that escape the tree.
+
+use std::collections::BTreeMap;
+use std::path::{Path, PathBuf};
+use std::process::Command;
+
+use serde::{Deserialize, Serialize};
+
+use crate::env::Environment;
+use crate::fingerprint;
+use crate::{Repo, Result, invalid, io_err, read_json, sha256_hex};
+
+#[derive(Clone, Debug, Deserialize, Serialize)]
+#[serde(deny_unknown_fields)]
+pub struct InputsLock {
+    pub schema: String,
+    pub academy: AcademyInput,
+}
+
+#[derive(Clone, Debug, Deserialize, Serialize)]
+#[serde(deny_unknown_fields)]
+pub struct AcademyInput {
+    pub origin: String,
+    pub branch: String,
+    pub base_commit: String,
+    pub commit: String,
+    pub tree_sha256: String,
+    pub package_version: String,
+}
+
+pub fn lock(repo: &Repo) -> Result<InputsLock> {
+    read_json(&repo.join("docs/architecture/inputs.lock.json"))
+}
+
+fn git_archive(source: &Path, commit: &str, dest: &Path) -> Result<()> {
+    let archive = Command::new("/usr/bin/git")
+        .args(["-C"])
+        .arg(source)
+        .args(["archive", "--format=tar", commit])
+        .env_clear()
+        .env("PATH", "/usr/bin:/bin")
+        .env("HOME", std::env::var("HOME").unwrap_or_default())
+        .output()
+        .map_err(io_err(source))?;
+    if !archive.status.success() {
+        return Err(invalid(format!(
+            "git archive {commit} failed: {}",
+            String::from_utf8_lossy(&archive.stderr)
+        )));
+    }
+    std::fs::create_dir_all(dest).map_err(io_err(dest))?;
+    let mut tar = Command::new("/usr/bin/tar")
+        .args(["-x", "-f", "-", "-C"])
+        .arg(dest)
+        .env_clear()
+        .stdin(std::process::Stdio::piped())
+        .spawn()
+        .map_err(io_err(dest))?;
+    {
+        use std::io::Write;
+        let mut stdin = tar
+            .stdin
+            .take()
+            .ok_or_else(|| invalid("tar stdin unavailable"))?;
+        stdin.write_all(&archive.stdout).map_err(io_err(dest))?;
+    }
+    let status = tar.wait().map_err(io_err(dest))?;
+    if status.success() {
+        Ok(())
+    } else {
+        Err(invalid("extracting the Academy archive failed"))
+    }
+}
+
+/// Materializes `.inputs/academy` from a git repository at the locked commit.
+pub fn fetch(repo: &Repo, source: &Path) -> Result<String> {
+    let lock = lock(repo)?;
+    let dest = repo.join(".inputs/academy");
+    if dest.exists() {
+        std::fs::remove_dir_all(&dest).map_err(io_err(&dest))?;
+    }
+    git_archive(source, &lock.academy.commit, &dest)?;
+    let hash = fingerprint::tree_hash(&dest)?;
+    if !lock.academy.tree_sha256.is_empty() && hash != lock.academy.tree_sha256 {
+        return Err(invalid(format!(
+            "fetched Academy tree {hash} does not match the locked {}",
+            lock.academy.tree_sha256
+        )));
+    }
+    Ok(hash)
+}
+
+fn verify_tree(root: &Path, dir: &Path) -> Result<()> {
+    for entry in std::fs::read_dir(dir)
+        .map_err(io_err(dir))?
+        .filter_map(|e| e.ok())
+    {
+        let path = entry.path();
+        let name = entry.file_name().to_string_lossy().into_owned();
+        if name == ".git" {
+            return Err(invalid(format!(
+                "input contains git metadata: {}",
+                path.display()
+            )));
+        }
+        let meta = std::fs::symlink_metadata(&path).map_err(io_err(&path))?;
+        if meta.file_type().is_symlink() {
+            let target = std::fs::read_link(&path).map_err(io_err(&path))?;
+            let resolved = path.parent().unwrap_or(root).join(&target);
+            let normalized = normalize(&resolved);
+            if target.is_absolute() || !normalized.starts_with(normalize(root)) {
+                return Err(invalid(format!(
+                    "symlink escapes the input: {}",
+                    path.display()
+                )));
+            }
+        } else if meta.is_dir() {
+            verify_tree(root, &path)?;
+        }
+    }
+    Ok(())
+}
+
+fn normalize(path: &Path) -> PathBuf {
+    let mut out = PathBuf::new();
+    for component in path.components() {
+        match component {
+            std::path::Component::ParentDir => {
+                out.pop();
+            }
+            std::path::Component::CurDir => {}
+            other => out.push(other),
+        }
+    }
+    out
+}
+
+fn copy_tree(from: &Path, to: &Path) -> Result<()> {
+    std::fs::create_dir_all(to).map_err(io_err(to))?;
+    for entry in std::fs::read_dir(from)
+        .map_err(io_err(from))?
+        .filter_map(|e| e.ok())
+    {
+        let name = entry.file_name().to_string_lossy().into_owned();
+        if name == ".env" || name.starts_with(".env.") {
+            continue;
+        }
+        let source = entry.path();
+        let dest = to.join(&name);
+        let meta = std::fs::symlink_metadata(&source).map_err(io_err(&source))?;
+        if meta.file_type().is_symlink() {
+            let target = std::fs::read_link(&source).map_err(io_err(&source))?;
+            std::os::unix::fs::symlink(&target, &dest).map_err(io_err(&dest))?;
+        } else if meta.is_dir() {
+            copy_tree(&source, &dest)?;
+        } else {
+            std::fs::copy(&source, &dest).map_err(io_err(&dest))?;
+        }
+    }
+    Ok(())
+}
+
+/// Removes everything in scratch except installed dependency directories.
+fn clear_scratch(dir: &Path) -> Result<()> {
+    if !dir.exists() {
+        return Ok(());
+    }
+    for entry in std::fs::read_dir(dir)
+        .map_err(io_err(dir))?
+        .filter_map(|e| e.ok())
+    {
+        let path = entry.path();
+        let name = entry.file_name();
+        if name == "node_modules" {
+            continue;
+        }
+        let meta = std::fs::symlink_metadata(&path).map_err(io_err(&path))?;
+        if meta.is_dir() && !meta.file_type().is_symlink() {
+            // Keep nested package node_modules; clear the rest of the tree.
+            clear_scratch(&path)?;
+            if std::fs::read_dir(&path)
+                .map_err(io_err(&path))?
+                .next()
+                .is_none()
+            {
+                std::fs::remove_dir(&path).map_err(io_err(&path))?;
+            }
+        } else {
+            std::fs::remove_file(&path).map_err(io_err(&path))?;
+        }
+    }
+    Ok(())
+}
+
+pub fn prepare(repo: &Repo, input: &Path, scratch: &Path) -> Result<()> {
+    let lock = lock(repo)?;
+    let input = repo.join(input);
+    let scratch = repo.join(scratch);
+    if !input.starts_with(repo.join(".inputs")) || !scratch.starts_with(repo.join(".work")) {
+        return Err(invalid(
+            "shared-prepare reads only .inputs/ and writes only .work/",
+        ));
+    }
+    verify_tree(&input, &input)?;
+    let hash = fingerprint::tree_hash(&input)?;
+    if hash != lock.academy.tree_sha256 {
+        return Err(invalid(format!(
+            "{} hashes to {hash}, not the locked {}",
+            input.display(),
+            lock.academy.tree_sha256
+        )));
+    }
+    clear_scratch(&scratch)?;
+    copy_tree(&input, &scratch)
+}
+
+#[derive(Clone, Debug, Deserialize, Serialize)]
+#[serde(deny_unknown_fields)]
+pub struct LifecycleAllowlist {
+    pub schema: String,
+    pub description: String,
+    pub scripts: Vec<AllowedScript>,
+}
+
+#[derive(Clone, Debug, Deserialize, Serialize, PartialEq, Eq)]
+#[serde(deny_unknown_fields)]
+pub struct AllowedScript {
+    pub package: String,
+    pub version: String,
+    pub hook: String,
+    pub script: String,
+    pub script_sha256: String,
+    /// `run` executes the reviewed script; `skip` records that it was
+    /// reviewed and is not required for the scoped commands.
+    pub action: String,
+    pub reason: String,
+}
+
+const HOOKS: [&str; 3] = ["preinstall", "install", "postinstall"];
+
+/// Every installed package with a lifecycle hook, under any `node_modules`
+/// directory of the scratch tree (hoisted or isolated pnpm layouts).
+/// One discovered lifecycle hook: package directory, name, version, hook, script.
+pub type DiscoveredScript = (PathBuf, String, String, String, String);
+
+pub fn discover_scripts(scratch: &Path) -> Result<Vec<DiscoveredScript>> {
+    let mut found = Vec::new();
+    let mut module_dirs = vec![scratch.join("node_modules")];
+    if let Ok(packages) = std::fs::read_dir(scratch.join("packages")) {
+        module_dirs.extend(
+            packages
+                .filter_map(|e| e.ok())
+                .map(|e| e.path().join("node_modules")),
+        );
+    }
+    while let Some(modules) = module_dirs.pop() {
+        let Ok(entries) = std::fs::read_dir(&modules) else {
+            continue;
+        };
+        for entry in entries.filter_map(|e| e.ok()) {
+            let path = entry.path();
+            let name = entry.file_name().to_string_lossy().into_owned();
+            if name == ".bin"
+                || std::fs::symlink_metadata(&path).is_ok_and(|m| m.file_type().is_symlink())
+            {
+                continue;
+            }
+            if name == ".pnpm" {
+                if let Ok(store) = std::fs::read_dir(&path) {
+                    module_dirs.extend(
+                        store
+                            .filter_map(|e| e.ok())
+                            .map(|e| e.path().join("node_modules")),
+                    );
+                }
+                continue;
+            }
+            let package_dirs: Vec<PathBuf> = if name.starts_with('@') {
+                std::fs::read_dir(&path)
+                    .map(|scoped| scoped.filter_map(|e| e.ok()).map(|e| e.path()).collect())
+                    .unwrap_or_default()
+            } else {
+                vec![path]
+            };
+            for dir in package_dirs {
+                if std::fs::symlink_metadata(&dir).is_ok_and(|m| m.file_type().is_symlink()) {
+                    continue;
+                }
+                module_dirs.push(dir.join("node_modules"));
+                let Ok(value) = read_json::<serde_json::Value>(&dir.join("package.json")) else {
+                    continue;
+                };
+                let name = value["name"].as_str().unwrap_or_default().to_owned();
+                let version = value["version"].as_str().unwrap_or_default().to_owned();
+                for hook in HOOKS {
+                    if let Some(script) = value["scripts"][hook].as_str() {
+                        found.push((
+                            dir.clone(),
+                            name.clone(),
+                            version.clone(),
+                            hook.to_owned(),
+                            script.to_owned(),
+                        ));
+                    }
+                }
+            }
+        }
+    }
+    found.sort_by(|a, b| (&a.1, &a.2, &a.3, &a.0).cmp(&(&b.1, &b.2, &b.3, &b.0)));
+    Ok(found)
+}
+
+pub fn lifecycle(
+    repo: &Repo,
+    env: &Environment,
+    allowlist: &Path,
+    scratch: &Path,
+) -> Result<Vec<String>> {
+    let allow: LifecycleAllowlist = read_json(&repo.join(allowlist))?;
+    let scratch = repo.join(scratch);
+    if !scratch.starts_with(repo.join(".work")) {
+        return Err(invalid("shared-lifecycle runs only in .work/ scratch"));
+    }
+    let mut ran = Vec::new();
+    let mut unknown = Vec::new();
+    let mut planned: BTreeMap<(String, PathBuf), String> = BTreeMap::new();
+    for (dir, name, version, hook, script) in discover_scripts(&scratch)? {
+        let digest = sha256_hex(script.as_bytes());
+        let reviewed = allow.scripts.iter().find(|a| {
+            a.package == name
+                && a.version == version
+                && a.hook == hook
+                && a.script == script
+                && a.script_sha256 == digest
+        });
+        match reviewed.map(|a| a.action.as_str()) {
+            Some("run") => {
+                planned.insert((format!("{name}@{version}:{hook}"), dir), script);
+            }
+            Some("skip") => {}
+            _ => unknown.push(format!("{name}@{version} {hook}: {script}")),
+        }
+    }
+    if !unknown.is_empty() {
+        return Err(invalid(format!(
+            "unknown dependency lifecycle scripts (not run): {}",
+            unknown.join("; ")
+        )));
+    }
+    for ((label, dir), script) in planned {
+        // Allowlisted scripts are fixed `node <file>` invocations; run them as
+        // argv without a shell.
+        let argv: Vec<String> = script.split_whitespace().map(str::to_owned).collect();
+        if argv.first().map(String::as_str) != Some("node") {
+            return Err(invalid(format!(
+                "allowlisted script {label} is not a plain node invocation"
+            )));
+        }
+        let status = env.command(&argv, &dir)?.status().map_err(io_err(&dir))?;
+        if !status.success() {
+            return Err(invalid(format!("lifecycle script {label} failed")));
+        }
+        ran.push(label);
+    }
+    Ok(ran)
+}
diff --git a/crates/xtask/src/subject.rs b/crates/xtask/src/subject.rs
new file mode 100644
index 0000000..52b687a
--- /dev/null
+++ b/crates/xtask/src/subject.rs
@@ -0,0 +1,44 @@
+//! Validated review subjects: chunks C01–C26 and phases P01–P08.
+
+use std::fmt;
+
+use crate::{Result, invalid};
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq, Hash, PartialOrd, Ord)]
+pub enum Subject {
+    Chunk(u8),
+    Phase(u8),
+}
+
+impl Subject {
+    pub fn parse(text: &str) -> Result<Self> {
+        let parse_num = |digits: &str, max: u8| -> Option<u8> {
+            (digits.len() == 2 && digits.bytes().all(|b| b.is_ascii_digit()))
+                .then(|| digits.parse::<u8>().ok())
+                .flatten()
+                .filter(|n| (1..=max).contains(n))
+        };
+        if let Some(n) = text.strip_prefix('C').and_then(|rest| parse_num(rest, 26)) {
+            return Ok(Self::Chunk(n));
+        }
+        if let Some(n) = text.strip_prefix('P').and_then(|rest| parse_num(rest, 8)) {
+            return Ok(Self::Phase(n));
+        }
+        Err(invalid(format!(
+            "not a valid chunk (C01-C26) or phase (P01-P08): {text:?}"
+        )))
+    }
+
+    pub fn is_phase(self) -> bool {
+        matches!(self, Self::Phase(_))
+    }
+}
+
+impl fmt::Display for Subject {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        match self {
+            Self::Chunk(n) => write!(f, "C{n:02}"),
+            Self::Phase(n) => write!(f, "P{n:02}"),
+        }
+    }
+}
diff --git a/crates/xtask/src/transport.rs b/crates/xtask/src/transport.rs
new file mode 100644
index 0000000..6624034
--- /dev/null
+++ b/crates/xtask/src/transport.rs
@@ -0,0 +1,439 @@
+//! Codex review transport (D026).
+//!
+//! Preferred: queue the review message to the owner-designated thread by its
+//! exact ID. Queue success is only submission; the reviewer-authored verdict
+//! file is the only completion signal. Fallback: a fresh ephemeral read-only
+//! `codex exec` whose JSONL events are captured and checked for tool use the
+//! review must not perform.
+
+use std::io::Write;
+use std::path::{Path, PathBuf};
+use std::process::{Command, Stdio};
+use std::time::{Duration, Instant};
+
+use serde::{Deserialize, Serialize};
+
+use crate::env::Environment;
+use crate::manifest::Reviewer;
+use crate::{Result, invalid, io_err, now_utc, random_hex, read_json, sha256_hex, write_json};
+
+/// A resolved and flag-verified Codex executable.
+#[derive(Clone, Debug, PartialEq, Eq, Serialize, Deserialize)]
+pub struct Codex {
+    pub path: String,
+    pub version: String,
+    pub sha256: String,
+}
+
+#[derive(Debug)]
+pub struct Output {
+    pub status: Option<i32>,
+    pub stdout: Vec<u8>,
+    pub stderr: Vec<u8>,
+    pub timed_out: bool,
+}
+
+/// Runs a process with optional stdin and a hard timeout (killed on expiry).
+pub fn run_with_timeout(
+    mut command: Command,
+    stdin: Option<&[u8]>,
+    timeout: Duration,
+) -> Result<Output> {
+    command
+        .stdin(if stdin.is_some() {
+            Stdio::piped()
+        } else {
+            Stdio::null()
+        })
+        .stdout(Stdio::piped())
+        .stderr(Stdio::piped());
+    let program = PathBuf::from(command.get_program());
+    let mut child = command.spawn().map_err(io_err(&program))?;
+    if let (Some(bytes), Some(mut pipe)) = (stdin, child.stdin.take()) {
+        pipe.write_all(bytes).map_err(io_err(&program))?;
+    }
+    let stdout = child.stdout.take();
+    let stderr = child.stderr.take();
+    let out_thread = std::thread::spawn(move || read_all(stdout));
+    let err_thread = std::thread::spawn(move || read_all(stderr));
+    let started = Instant::now();
+    let mut timed_out = false;
+    let status = loop {
+        if let Some(status) = child.try_wait().map_err(io_err(&program))? {
+            break status.code();
+        }
+        if started.elapsed() > timeout {
+            let _ = child.kill();
+            let _ = child.wait();
+            timed_out = true;
+            break None;
+        }
+        std::thread::sleep(Duration::from_millis(200));
+    };
+    Ok(Output {
+        status,
+        stdout: out_thread.join().unwrap_or_default(),
+        stderr: err_thread.join().unwrap_or_default(),
+        timed_out,
+    })
+}
+
+fn read_all<R: std::io::Read>(reader: Option<R>) -> Vec<u8> {
+    let mut buf = Vec::new();
+    if let Some(mut r) = reader {
+        let _ = r.read_to_end(&mut buf);
+    }
+    buf
+}
+
+impl Codex {
+    /// Resolves `codex` in the selected toolchain PATH and verifies that every
+    /// flag the manifest uses is advertised by this exact executable.
+    pub fn resolve(env: &Environment, reviewer: &Reviewer, cwd: &Path) -> Result<Self> {
+        let path = env.resolve("codex")?;
+        let canonical = std::fs::canonicalize(&path).map_err(io_err(&path))?;
+        let bytes = std::fs::read(&canonical).map_err(io_err(&canonical))?;
+        let version = Self::stdout(env, cwd, &["codex", "--version"])?;
+        let codex = Self {
+            path: path.display().to_string(),
+            version: version.trim().to_owned(),
+            sha256: sha256_hex(&bytes),
+        };
+        let queue_help = Self::stdout(env, cwd, &["codex", "queue", "--help"])?;
+        let exec_help = Self::stdout(env, cwd, &["codex", "exec", "--help"])?;
+        verify_flags(&reviewer.preferred_transport.argv, &queue_help)?;
+        verify_flags(&reviewer.fallback_transport.argv, &exec_help)?;
+        Ok(codex)
+    }
+
+    fn stdout(env: &Environment, cwd: &Path, argv: &[&str]) -> Result<String> {
+        let argv: Vec<String> = argv.iter().map(|s| (*s).to_owned()).collect();
+        let output = run_with_timeout(env.command(&argv, cwd)?, None, Duration::from_secs(30))?;
+        if output.status != Some(0) {
+            return Err(invalid(format!("{} failed", argv.join(" "))));
+        }
+        Ok(String::from_utf8_lossy(&output.stdout).into_owned())
+    }
+}
+
+/// Every `--flag` in the argv template must appear in the CLI help text.
+pub fn verify_flags(argv: &[String], help: &str) -> Result<()> {
+    for arg in argv.iter().filter(|a| a.starts_with('-') && *a != "-") {
+        let flag = arg.split('=').next().unwrap_or(arg);
+        let advertised = help
+            .split(|c: char| c.is_whitespace() || c == ',')
+            .any(|token| token == flag);
+        if !advertised {
+            return Err(invalid(format!(
+                "codex does not advertise flag {flag}; refusing to weaken the review"
+            )));
+        }
+    }
+    Ok(())
+}
+
+/// Expands the manifest argv template with validated values only. `{codex}`
+/// becomes the bare program name, which the environment resolves through the
+/// same selected PATH that produced [`Codex::path`].
+pub fn render_argv(template: &[String], values: &[(&str, &str)]) -> Result<Vec<String>> {
+    template
+        .iter()
+        .map(|arg| {
+            if arg == "{codex}" {
+                return Ok("codex".to_owned());
+            }
+            if let Some((_, value)) = values.iter().find(|(key, _)| arg == &format!("{{{key}}}")) {
+                return Ok((*value).to_owned());
+            }
+            if arg.contains('{') {
+                return Err(invalid(format!("unresolved transport placeholder {arg}")));
+            }
+            Ok(arg.clone())
+        })
+        .collect()
+}
+
+/// Queue acknowledgement: submission only.
+#[derive(Clone, Debug, Serialize, Deserialize)]
+pub struct QueueAck {
+    pub submitted_utc: String,
+    pub exit_code: Option<i32>,
+    pub stdout: String,
+}
+
+pub fn queue(
+    env: &Environment,
+    reviewer: &Reviewer,
+    cwd: &Path,
+    message: &str,
+) -> Result<QueueAck> {
+    let argv = render_argv(
+        &reviewer.preferred_transport.argv,
+        &[("transport_message", message)],
+    )?;
+    let command = env.command(&argv, cwd)?;
+    let submitted_utc = now_utc();
+    let output = run_with_timeout(
+        command,
+        None,
+        Duration::from_secs(reviewer.preferred_transport.submit_timeout_seconds),
+    )?;
+    if output.timed_out || output.status != Some(0) {
+        return Err(invalid(format!(
+            "codex queue did not acknowledge submission: {}",
+            String::from_utf8_lossy(&output.stderr)
+        )));
+    }
+    Ok(QueueAck {
+        submitted_utc,
+        exit_code: output.status,
+        stdout: String::from_utf8_lossy(&output.stdout).trim().to_owned(),
+    })
+}
+
+/// Handshake: the thread must author a matching route-ready.json.
+#[derive(Clone, Debug, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct RouteReady {
+    pub request_id: String,
+    pub thread: String,
+    pub acknowledged: bool,
+    pub reviewer: String,
+    pub written_utc: String,
+}
+
+pub fn handshake(
+    env: &Environment,
+    reviewer: &Reviewer,
+    cwd: &Path,
+    transport_dir: &Path,
+    wait: Duration,
+) -> Result<PathBuf> {
+    let thread = &reviewer.preferred_transport.thread;
+    let request_id = format!(
+        "hs-{}-{}",
+        now_utc().replace([':', '-'], ""),
+        random_hex(4)?
+    );
+    let dir = transport_dir.join(&request_id);
+    let route = dir.join("route-ready.json");
+    write_json(
+        &dir.join("request.json"),
+        &serde_json::json!({
+            "request_id": request_id,
+            "kind": "transport-handshake",
+            "created_utc": now_utc(),
+            "thread": thread,
+            "expected_output": route.display().to_string(),
+            "implementer": "Claude Code via xtask",
+        }),
+    )?;
+    let message = format!(
+        "Prisma AIRS Desktop v2 review-transport handshake. Request ID: {request_id}. This is a harmless routing check, not a review or implementation request. Do not change application files, run product endpoints or access credentials. Only write {} containing {{\"request_id\": \"{request_id}\", \"thread\": \"{thread}\", \"acknowledged\": true, \"reviewer\": \"codex\", \"written_utc\": <current UTC ISO time>}} atomically (temp file then rename) and reply with the same JSON.",
+        route.display()
+    );
+    queue(env, reviewer, cwd, &message)?;
+    let deadline = Instant::now() + wait;
+    while Instant::now() < deadline {
+        if route.is_file() {
+            let ready: RouteReady = read_json(&route)?;
+            if ready.request_id == request_id && &ready.thread == thread && ready.acknowledged {
+                return Ok(route);
+            }
+            return Err(invalid(
+                "route-ready.json does not match the handshake request",
+            ));
+        }
+        std::thread::sleep(Duration::from_secs(2));
+    }
+    Err(invalid(
+        "handshake not acknowledged within the bounded wait",
+    ))
+}
+
+/// Waits for a reviewer-authored verdict with bounded progress reports.
+pub fn wait_for_file(path: &Path, reviewer: &Reviewer, label: &str) -> Option<Vec<u8>> {
+    let started = Instant::now();
+    let mut last_progress = Instant::now();
+    let max = Duration::from_secs(reviewer.wait.max_wait_seconds);
+    loop {
+        if let Ok(bytes) = std::fs::read(path) {
+            // A writer that does not rename atomically may leave partial JSON.
+            if serde_json::from_slice::<serde_json::Value>(&bytes).is_ok() {
+                return Some(bytes);
+            }
+        }
+        if started.elapsed() > max {
+            return None;
+        }
+        if last_progress.elapsed() > Duration::from_secs(reviewer.wait.progress_every_seconds) {
+            eprintln!(
+                "[{}] waiting for {label}: {}s elapsed (max {}s)",
+                now_utc(),
+                started.elapsed().as_secs(),
+                max.as_secs()
+            );
+            last_progress = Instant::now();
+        }
+        std::thread::sleep(Duration::from_secs(reviewer.wait.poll_seconds));
+    }
+}
+
+/// Result of a fresh `codex exec` review.
+pub struct ExecResult {
+    pub exit_code: Option<i32>,
+    pub stdout_path: PathBuf,
+    pub stderr_path: PathBuf,
+    pub forbidden_events: Vec<String>,
+    pub model: Option<String>,
+}
+
+pub fn exec_fresh(
+    env: &Environment,
+    reviewer: &Reviewer,
+    repo: &Path,
+    schema: &Path,
+    verdict: &Path,
+    attempt_dir: &Path,
+    prompt: &str,
+) -> Result<ExecResult> {
+    let argv = render_argv(
+        &reviewer.fallback_transport.argv,
+        &[
+            ("repo", &repo.display().to_string()),
+            ("schema_path", &schema.display().to_string()),
+            ("verdict_path", &verdict.display().to_string()),
+        ],
+    )?;
+    let command = env.command(&argv, repo)?;
+    let output = run_with_timeout(
+        command,
+        Some(prompt.as_bytes()),
+        Duration::from_secs(reviewer.wait.max_wait_seconds),
+    )?;
+    let stdout_path = attempt_dir.join("stdout.jsonl");
+    let stderr_path = attempt_dir.join("stderr.log");
+    crate::write_new(&stdout_path, &output.stdout)?;
+    crate::write_new(&stderr_path, &output.stderr)?;
+    let (forbidden_events, model) = inspect_events(&output.stdout);
+    Ok(ExecResult {
+        exit_code: if output.timed_out {
+            None
+        } else {
+            output.status
+        },
+        stdout_path,
+        stderr_path,
+        forbidden_events,
+        model,
+    })
+}
+
+/// Flags JSONL events showing tool use a read-only review must not perform.
+pub fn inspect_events(stdout: &[u8]) -> (Vec<String>, Option<String>) {
+    let mut forbidden = Vec::new();
+    let mut model = None;
+    for line in String::from_utf8_lossy(stdout).lines() {
+        let Ok(event) = serde_json::from_str::<serde_json::Value>(line) else {
+            continue;
+        };
+        if model.is_none() {
+            model = find_string(&event, "model");
+        }
+        let item_type = event
+            .pointer("/item/type")
+            .and_then(|v| v.as_str())
+            .unwrap_or_default();
+        if matches!(item_type, "mcp_tool_call" | "web_search" | "file_change") {
+            forbidden.push(format!("reviewer used {item_type}"));
+        }
+    }
+    forbidden.dedup();
+    (forbidden, model)
+}
+
+fn find_string(value: &serde_json::Value, key: &str) -> Option<String> {
+    match value {
+        serde_json::Value::Object(map) => map
+            .get(key)
+            .and_then(|v| v.as_str().map(str::to_owned))
+            .or_else(|| map.values().find_map(|v| find_string(v, key))),
+        serde_json::Value::Array(items) => items.iter().find_map(|v| find_string(v, key)),
+        _ => None,
+    }
+}
+
+/// Finds the thread's rollout transcript under `$HOME/.codex/sessions`.
+pub fn thread_transcript(thread: &str) -> Option<PathBuf> {
+    let home = std::env::var("HOME").ok()?;
+    let root = PathBuf::from(home).join(".codex/sessions");
+    let suffix = format!("{thread}.jsonl");
+    let mut stack = vec![root];
+    while let Some(dir) = stack.pop() {
+        for entry in std::fs::read_dir(&dir).ok()?.filter_map(|e| e.ok()) {
+            let path = entry.path();
+            if path.is_dir() {
+                stack.push(path);
+            } else if path
+                .file_name()
+                .is_some_and(|n| n.to_string_lossy().ends_with(&suffix))
+            {
+                return Some(path);
+            }
+        }
+    }
+    None
+}
+
+/// Collects the thread's reply events that name `request_id` at or after
+/// `since` (RFC 3339 UTC). This corroborates that the verdict came from the
+/// designated thread rather than from the implementer.
+pub fn thread_reply(transcript: &Path, request_id: &str, since: &str) -> Vec<u8> {
+    let Ok(text) = std::fs::read_to_string(transcript) else {
+        return Vec::new();
+    };
+    let mut out = Vec::new();
+    for line in text.lines() {
+        let Ok(event) = serde_json::from_str::<serde_json::Value>(line) else {
+            continue;
+        };
+        let timestamp = event
+            .get("timestamp")
+            .and_then(|t| t.as_str())
+            .unwrap_or_default();
+        let kind = event
+            .pointer("/payload/type")
+            .and_then(|t| t.as_str())
+            .unwrap_or_default();
+        let is_reply = matches!(kind, "agent_message" | "task_complete")
+            || (kind == "message"
+                && event.pointer("/payload/role").and_then(|r| r.as_str()) == Some("assistant"));
+        if timestamp >= since && is_reply && line.contains(request_id) {
+            out.extend_from_slice(line.as_bytes());
+            out.push(b'\n');
+        }
+    }
+    out
+}
+
+/// Waits (bounded) for the thread's own reply naming the request.
+pub fn wait_for_thread_reply(
+    thread: &str,
+    request_id: &str,
+    since: &str,
+    max: Duration,
+) -> Vec<u8> {
+    let deadline = Instant::now() + max;
+    loop {
+        if let Some(path) = thread_transcript(thread) {
+            let reply = thread_reply(&path, request_id, since);
+            if !reply.is_empty() {
+                return reply;
+            }
+        }
+        if Instant::now() > deadline {
+            return Vec::new();
+        }
+        std::thread::sleep(Duration::from_secs(5));
+    }
+}
