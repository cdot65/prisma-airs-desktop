+description = "Prisma AIRS Desktop v2 native host: window/origin admission and OS adapters"
+edition.workspace = true
+rust-version.workspace = true
+license.workspace = true
+publish.workspace = true
+default-run = "prisma-airs-desktop-v2"
+
+[lib]
+name = "desktop_host"
+path = "src/lib.rs"
+
+[[bin]]
+name = "prisma-airs-desktop-v2"
+path = "src/main.rs"
+
+[features]
+default = []
+# Distinct fixture identity and the Tauri mock runtime for admission tests.
+# Never enabled by the shipping artifact build.
+test-fixtures = ["desktop-core/test-fixtures", "tauri/test"]
+
+[build-dependencies]
+tauri-build = { version = "=2.7.3", default-features = false, features = ["config-json"] }
+
+[dependencies]
+desktop-core = { path = "../../../crates/desktop-core" }
+tauri = { version = "=2.12.4", default-features = false, features = ["wry", "common-controls-v6", "compression"] }
+serde.workspace = true
+serde_json.workspace = true
+tokio = { workspace = true, features = ["sync", "macros"] }
+
+[dev-dependencies]
+tokio = { workspace = true, features = ["sync", "macros", "rt"] }
+
+[lints]
+workspace = true
+
+# Host admission tests use Tauri's mock runtime, available only with fixtures.
+[[test]]
+name = "ipc_admission"
+required-features = ["test-fixtures"]
+
+[[test]]
+name = "permission_manifest"
+required-features = ["test-fixtures"]
