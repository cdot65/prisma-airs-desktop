+# One-off C01 bootstrap reference validator
+
+C01 builds the controller that gates every later chunk, so the controller
+cannot certify its own first receipt. `validate_receipt.py` is an independent
+Python (standard library only) re-implementation of the receipt checks. It
+shares no code with `crates/xtask`: it validates the reviewer verdict against
+`docs/architecture/review-verdict.schema.json` with its own schema-subset
+interpreter, re-derives packet/verdict/raw-output/run/native hashes, applies
+the D019/D026 threshold, and recomputes the source fingerprint from git using
+the documented algorithm (`path\0mode\0sha256\n`, sorted, plus `.git/config`,
+excluding only status.md, reviews/ and evidence/).
+
+```text
+python3 -I tools/reference-validator/validate_receipt.py validate . docs/planning/reviews/C01/attempt-NN
+python3 -I tools/reference-validator/validate_receipt.py adversarial . docs/planning/reviews/C01/attempt-NN
+```
+
+`adversarial` requires the unmodified attempt to be accepted and each single
+mutation (any score 8, required fix/blocker/gap despite nines, extra field,
+score 11, mismatched request ID or fingerprint, expired attempt, missing
+verdict, edited packet, inputs changed during review) to be rejected. Its
+output is retained as C01 bootstrap evidence next to the controller's own
+`validate-receipt` result for the same attempt. After C01 completes, the
+controller gates later work; this validator is not part of that path.
diff --git a/tools/reference-validator/validate_receipt.py b/tools/reference-validator/validate_receipt.py
new file mode 100755
index 0000000..063cee5
--- /dev/null
+++ b/tools/reference-validator/validate_receipt.py
@@ -0,0 +1,264 @@
+#!/usr/bin/env python3
+"""Independent one-off reference validator for the C01 bootstrap receipt.
+
+C01's controller cannot certify its own first gate. This validator shares no
+code with crates/xtask: it re-reads the attempt's immutable files, validates
+the reviewer verdict against docs/architecture/review-verdict.schema.json with
+its own small JSON-Schema subset interpreter, re-derives every hash, applies
+the D019/D026 threshold, checks the evidence named by the packet, and
+recomputes the source fingerprint from git using the documented algorithm.
+
+Usage:
+  reference_validator.py validate <repo> <attempt-dir>
+  reference_validator.py adversarial <repo> <attempt-dir>
+
+`adversarial` copies the attempt to a temporary directory, applies one
+mutation at a time and requires each mutated copy to be rejected, after
+requiring the unmodified copy to be accepted. Output is JSON.
+"""
+
+import hashlib
+import json
+import os
+import shutil
+import subprocess
+import sys
+import tempfile
+
+DIMENSIONS = ["architecture", "behavior", "authority_security", "validation", "overall"]
+EXCLUDED = ["docs/planning/status.md", "docs/planning/reviews/", "docs/planning/evidence/"]
+
+
+def sha256(data):
+    return hashlib.sha256(data).hexdigest()
+
+
+def read(path):
+    with open(path, "rb") as f:
+        return f.read()
+
+
+# ---------- minimal JSON Schema interpreter (subset used by the schema) ----------
+
+def schema_errors(value, schema, where="$"):
+    errors = []
+    kind = schema.get("type")
+    types = {"object": dict, "array": list, "string": str, "boolean": bool}
+    if kind == "integer":
+        if isinstance(value, bool) or not isinstance(value, int):
+            return [f"{where}: expected integer"]
+    elif kind in types:
+        if not isinstance(value, types[kind]):
+            return [f"{where}: expected {kind}"]
+    if "enum" in schema and value not in schema["enum"]:
+        errors.append(f"{where}: {value!r} not in enum")
+    if "minimum" in schema and isinstance(value, int) and value < schema["minimum"]:
+        errors.append(f"{where}: below minimum")
+    if "maximum" in schema and isinstance(value, int) and value > schema["maximum"]:
+        errors.append(f"{where}: above maximum")
+    if kind == "object":
+        props = schema.get("properties", {})
+        for name in schema.get("required", []):
+            if name not in value:
+                errors.append(f"{where}.{name}: missing")
+        if schema.get("additionalProperties") is False:
+            for name in value:
+                if name not in props:
+                    errors.append(f"{where}.{name}: not allowed")
+        for name, sub in props.items():
+            if name in value:
+                errors.extend(schema_errors(value[name], sub, f"{where}.{name}"))
+    if kind == "array" and "items" in schema:
+        for i, item in enumerate(value):
+            errors.extend(schema_errors(item, schema["items"], f"{where}[{i}]"))
+    return errors
+
+
+# ---------- independent source fingerprint ----------
+
+def excluded(path):
+    return any(path.startswith(e) if e.endswith("/") else path == e for e in EXCLUDED)
+
+
+def entry(root, rel):
+    full = os.path.join(root, rel)
+    try:
+        st = os.lstat(full)
+    except FileNotFoundError:
+        return f"{rel}\0deleted\0\n"
+    if os.path.islink(full):
+        return f"{rel}\0symlink\0{sha256(os.fsencode(os.readlink(full)))}\n"
+    mode = "100755" if st.st_mode & 0o111 else "100644"
+    return f"{rel}\0{mode}\0{sha256(read(full))}\n"
+
+
+def source_fingerprint(root):
+    out = subprocess.run(
+        ["/usr/bin/git", "ls-files", "-z", "--cached", "--others", "--exclude-standard"],
+        cwd=root, capture_output=True, check=True,
+        env={"PATH": "/usr/bin:/bin", "HOME": os.environ.get("HOME", "")},
+    ).stdout
+    paths = sorted({p.decode() for p in out.split(b"\0") if p and not excluded(p.decode())})
+    text = "".join(entry(root, p) for p in paths) + entry(root, ".git/config")
+    return sha256(text.encode())
+
+
+# ---------- validation ----------
+
+def validate(repo, attempt, check_current=True):
+    reasons = []
+    receipt_b = read(os.path.join(attempt, "receipt.json"))
+    packet_b = read(os.path.join(attempt, "request.json"))
+    receipt = json.loads(receipt_b)
+    packet = json.loads(packet_b)
+    if os.path.exists(os.path.join(attempt, "expired.json")):
+        reasons.append("attempt expired")
+    if sha256(packet_b) != receipt["packet_sha256"]:
+        reasons.append("packet hash mismatch")
+    verdict_path = os.path.join(attempt, "verdict.json")
+    if not os.path.exists(verdict_path):
+        return reasons + ["no verdict"]
+    verdict_b = read(verdict_path)
+    if sha256(verdict_b) != receipt["verdict_sha256"]:
+        reasons.append("verdict hash mismatch")
+    try:
+        verdict = json.loads(verdict_b)
+    except ValueError:
+        return reasons + ["verdict not JSON"]
+    schema = json.loads(read(os.path.join(repo, "docs/architecture/review-verdict.schema.json")))
+    if sha256(read(os.path.join(repo, "docs/architecture/review-verdict.schema.json"))) != packet["verdict_schema"]["sha256"]:
+        reasons.append("verdict schema changed since packet")
+    errors = schema_errors(verdict, schema)
+    reasons.extend(f"schema: {e}" for e in errors)
+    if errors:
+        return reasons
+    for key in ("request_id", "attempt_id", "subject"):
+        if verdict[key] != packet[key] or receipt[key] != packet[key]:
+            reasons.append(f"{key} mismatch")
+    if verdict["fingerprints"] != packet["fingerprints"]:
+        reasons.append("verdict fingerprints differ from packet")
+    for d in DIMENSIONS:
+        if verdict["scores"][d] < 9:
+            reasons.append(f"{d} score {verdict['scores'][d]} < 9")
+    for key in ("required_fixes", "blockers", "evidence_gaps"):
+        if verdict[key]:
+            reasons.append(f"{key} not empty")
+    if verdict["recommendation"] != "pass":
+        reasons.append("recommendation fail")
+    if receipt["fingerprints_after"] != packet["fingerprints"]:
+        reasons.append("inputs changed during review")
+    raw = receipt["transport"].get("raw_output")
+    if not raw:
+        reasons.append("no raw reviewer output")
+    else:
+        raw_path = os.path.join(repo, raw["path"])
+        if not os.path.exists(raw_path):
+            reasons.append("raw reviewer output missing")
+        elif sha256(read(raw_path)) != raw["sha256"]:
+            reasons.append("raw reviewer output hash mismatch")
+        elif packet["request_id"].encode() not in read(raw_path):
+            reasons.append("raw reviewer output does not name request")
+    kinds = {r["kind"] for r in packet["runs"]}
+    for needed in ("check", "test", "native-prepare"):
+        if needed not in kinds:
+            reasons.append(f"missing {needed} run")
+    for run in packet["runs"]:
+        path = os.path.join(repo, run["path"])
+        if not os.path.exists(path) or sha256(read(path)) != run["sha256"]:
+            reasons.append(f"run {run['run_id']} missing or edited")
+            continue
+        record = json.loads(read(path))
+        if record["status"] != "passed" or any(c["status"] != "passed" for c in record["commands"]):
+            reasons.append(f"run {run['run_id']} not passed")
+        for state in (record["inputs_before"], record["inputs_after"]):
+            fp = packet["fingerprints"]
+            if (state["source"], state["dependencies"], state["build_flags"]) != (fp["source"], fp["dependencies"], fp["build_flags"]):
+                reasons.append(f"run {run['run_id']} used other inputs")
+                break
+    native = packet.get("native_acceptance")
+    if not native:
+        reasons.append("no native acceptance")
+    else:
+        path = os.path.join(repo, native["path"])
+        if not os.path.exists(path) or sha256(read(path)) != native["sha256"]:
+            reasons.append("native record missing or edited")
+        else:
+            record = json.loads(read(path))
+            if record["app"]["executable_sha256"] != packet.get("native_executable_sha256"):
+                reasons.append("native record names other bytes")
+            if not record["checks"] or any(c["result"] != "pass" for c in record["checks"]):
+                reasons.append("native checks not all passed")
+    if check_current:
+        current = source_fingerprint(repo)
+        if current != packet["fingerprints"]["source"]:
+            reasons.append("source changed since review")
+    return reasons
+
+
+def adversarial(repo, attempt):
+    def mutate_json(name, fn):
+        def apply(d):
+            p = os.path.join(d, name)
+            v = json.loads(read(p))
+            fn(v)
+            with open(p, "w") as f:
+                json.dump(v, f, indent=2)
+        return apply
+
+    def touch(name):
+        def apply(d):
+            with open(os.path.join(d, name), "w") as f:
+                f.write("{}")
+        return apply
+
+    def remove(name):
+        return lambda d: os.remove(os.path.join(d, name))
+
+    def set_score(dim):
+        return mutate_json("verdict.json", lambda v: v["scores"].__setitem__(dim, 8))
+
+    mutations = [(f"score {d}=8", set_score(d)) for d in DIMENSIONS] + [
+        ("required fix with nines", mutate_json("verdict.json", lambda v: v["required_fixes"].append("fix"))),
+        ("blocker", mutate_json("verdict.json", lambda v: v["blockers"].append("blocker"))),
+        ("evidence gap", mutate_json("verdict.json", lambda v: v["evidence_gaps"].append("gap"))),
+        ("extra verdict field", mutate_json("verdict.json", lambda v: v.__setitem__("approved", True))),
+        ("score 11", mutate_json("verdict.json", lambda v: v["scores"].__setitem__("overall", 11))),
+        ("request id mismatch", mutate_json("verdict.json", lambda v: v.__setitem__("request_id", "rq-other"))),
+        ("fingerprint mismatch", mutate_json("verdict.json", lambda v: v["fingerprints"].__setitem__("source", "0" * 64))),
+        ("expired attempt", touch("expired.json")),
+        ("missing verdict", remove("verdict.json")),
+        ("edited packet", mutate_json("request.json", lambda v: v.__setitem__("scope", "edited"))),
+        ("inputs changed during review", mutate_json("receipt.json", lambda v: v["fingerprints_after"].__setitem__("source", "1" * 64))),
+    ]
+    results = []
+    with tempfile.TemporaryDirectory() as tmp:
+        base = os.path.join(tmp, "base")
+        shutil.copytree(attempt, base)
+        accepted = validate(repo, base)
+        results.append({"case": "unmodified", "rejected": bool(accepted), "reasons": accepted})
+        for name, apply in mutations:
+            copy = os.path.join(tmp, name.replace(" ", "_"))
+            shutil.copytree(attempt, copy)
+            apply(copy)
+            reasons = validate(repo, copy)
+            results.append({"case": name, "rejected": bool(reasons), "reasons": reasons})
+    ok = (not results[0]["rejected"]) and all(r["rejected"] for r in results[1:])
+    return {"passed": ok, "results": results}
+
+
+def main():
+    if len(sys.argv) != 4 or sys.argv[1] not in ("validate", "adversarial"):
+        print(__doc__)
+        return 2
