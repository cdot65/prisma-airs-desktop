diff --git a/crates/xtask/src/manifest.rs b/crates/xtask/src/manifest.rs
new file mode 100644
index 0000000..f7288d4
--- /dev/null
+++ b/crates/xtask/src/manifest.rs
@@ -0,0 +1,357 @@
+//! The approved command manifest (`docs/architecture/checks.json`).
+//!
+//! Parsing is strict: unknown fields fail, every command is a non-empty argv
+//! array whose program is on a fixed allowlist, and placeholders may appear
+//! only where the controller substitutes validated values. Completion state is
+//! never read from the manifest; it lives in the append-only ledger.
+
+use std::collections::BTreeMap;
+use std::path::Path;
+
+use serde::Deserialize;
+
+use crate::{Result, Subject, invalid, read_json};
+
+/// Programs a manifest command may start.
+const PROGRAMS: [&str; 2] = ["cargo", "pnpm"];
+
+pub type Argv = Vec<String>;
+
+#[derive(Clone, Debug, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct Manifest {
+    pub schema_version: u32,
+    pub status: String,
+    pub target: String,
+    pub fixture_only_features: Vec<String>,
+    pub common_commands: Vec<Argv>,
+    pub controller: String,
+    pub shared_source_commands: Vec<Argv>,
+    pub artifact_build: Argv,
+    pub chunks: BTreeMap<String, Chunk>,
+    pub phases: BTreeMap<String, Vec<String>>,
+    pub invariants: Vec<String>,
+    pub requested_production_features: Vec<String>,
+    pub effective_features: String,
+    pub controller_commands: BTreeMap<String, Argv>,
+    pub reviewer: Reviewer,
+    pub shared_lifecycle_contract: String,
+    pub shared_source_required_chunks: Vec<String>,
+    pub shared_source_requirement: String,
+    pub environment_contract: serde_json::Value,
+}
+
+#[derive(Clone, Debug, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct Chunk {
+    pub rust_target: String,
+    pub fixture_command: Argv,
+    pub native_prepare: Argv,
+    pub native_acceptance: String,
+    pub live_requirement: String,
+    #[serde(default)]
+    pub frontend_commands: Vec<Argv>,
+    #[serde(default)]
+    pub host_commands: Vec<Argv>,
+}
+
+#[derive(Clone, Debug, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct Reviewer {
+    pub decision: String,
+    pub identity: String,
+    pub executable: String,
+    pub verdict_schema: String,
+    pub threshold: BTreeMap<String, u8>,
+    pub preferred_transport: PreferredTransport,
+    pub fallback_transport: FallbackTransport,
+    pub wait: Wait,
+    pub freeze: String,
+    pub expiry: String,
+}
+
+#[derive(Clone, Debug, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct PreferredTransport {
+    pub kind: String,
+    pub thread: String,
+    pub argv: Argv,
+    pub submit_timeout_seconds: u64,
+    pub requires: String,
+    pub forbidden: Vec<String>,
+    pub note: String,
+}
+
+#[derive(Clone, Debug, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct FallbackTransport {
+    pub kind: String,
+    pub argv: Argv,
+    pub stdin: String,
+    pub capture: Vec<String>,
+    pub forbidden: Vec<String>,
+}
+
+#[derive(Clone, Debug, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct Wait {
+    pub poll_seconds: u64,
+    pub max_wait_seconds: u64,
+    pub progress_every_seconds: u64,
+}
+
+/// One concrete command the controller will run for a subject.
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct Command {
+    /// Stable label used in evidence (`common/3`, `fixture`, `host/1`, ...).
+    pub label: String,
+    pub argv: Argv,
+    /// Whether the command must report at least one executed test.
+    pub expects_tests: bool,
+}
+
+pub const DIMENSIONS: [&str; 5] = [
+    "architecture",
+    "behavior",
+    "authority_security",
+    "validation",
+    "overall",
+];
+
+impl Manifest {
+    pub fn load(path: &Path) -> Result<Self> {
+        let manifest: Self = read_json(path)?;
+        manifest.validate()?;
+        Ok(manifest)
+    }
+
+    fn validate(&self) -> Result<()> {
+        if self.schema_version != 1 {
+            return Err(invalid("unsupported checks.json schema_version"));
+        }
+        if self.target != "aarch64-apple-darwin" {
+            return Err(invalid("checks.json target must be aarch64-apple-darwin"));
+        }
+        for n in 1..=26u8 {
+            let id = Subject::Chunk(n).to_string();
+            if !self.chunks.contains_key(&id) {
+                return Err(invalid(format!("checks.json is missing chunk {id}")));
+            }
+        }
+        if self.chunks.len() != 26 {
+            return Err(invalid("checks.json must define exactly C01-C26"));
+        }
+        let mut phase_members = Vec::new();
+        for n in 1..=8u8 {
+            let id = Subject::Phase(n).to_string();
+            let members = self
+                .phases
+                .get(&id)
+                .ok_or_else(|| invalid(format!("checks.json is missing phase {id}")))?;
+            phase_members.extend(members.iter().cloned());
+        }
+        let expected: Vec<String> = (1..=26u8).map(|n| Subject::Chunk(n).to_string()).collect();
+        if phase_members != expected || self.phases.len() != 8 {
+            return Err(invalid("phases must partition C01-C26 in order"));
+        }
+        for argv in self.all_static_commands() {
+            check_argv(argv)?;
+        }
+        for (name, argv) in &self.controller_commands {
+            check_argv(argv).map_err(|e| invalid(format!("controller command {name}: {e}")))?;
+        }
+        for dimension in DIMENSIONS {
+            if self.reviewer.threshold.get(dimension) != Some(&9) {
+                return Err(invalid(format!(
+                    "reviewer threshold for {dimension} must be exactly 9 (D019/D026)"
+                )));
+            }
+        }
+        if self.reviewer.threshold.len() != DIMENSIONS.len() {
+            return Err(invalid("reviewer threshold has unexpected dimensions"));
+        }
+        if self.reviewer.identity != "codex" {
+            return Err(invalid("reviewer identity must be codex (D026)"));
+        }
+        self.check_transports()
+    }
+
+    fn check_transports(&self) -> Result<()> {
+        let preferred = &self.reviewer.preferred_transport;
+        let fallback = &self.reviewer.fallback_transport;
+        for argv in [&preferred.argv, &fallback.argv] {
+            if argv.first().map(String::as_str) != Some("{codex}") {
+                return Err(invalid(
+                    "reviewer argv must start with the resolved {codex}",
+                ));
+            }
+        }
+        let banned = |argv: &Argv, forbidden: &[String]| {
+            argv.iter()
+                .any(|a| forbidden.iter().any(|f| a == f || a.contains(f.as_str())))
+        };
+        if banned(&preferred.argv, &preferred.forbidden)
+            || banned(&fallback.argv, &fallback.forbidden)
+        {
+            return Err(invalid("reviewer argv contains a forbidden flag"));
+        }
+        if !preferred
+            .argv
+            .windows(2)
+            .any(|w| w[0] == "--thread" && w[1] == preferred.thread)
+        {
+            return Err(invalid("preferred transport must address its exact thread"));
+        }
+        for required in [
+            "--sandbox",
+            "read-only",
+            "--ephemeral",
+            "--ignore-user-config",
+            "--ignore-rules",
+            "--output-schema",
+        ] {
+            if !fallback.argv.iter().any(|a| a == required) {
+                return Err(invalid(format!("fallback transport must pass {required}")));
+            }
+        }
+        Ok(())
+    }
+
+    fn all_static_commands(&self) -> impl Iterator<Item = &Argv> {
+        self.common_commands
+            .iter()
+            .chain(self.shared_source_commands.iter())
+            .chain(std::iter::once(&self.artifact_build))
+            .chain(self.chunks.values().flat_map(|c| {
+                std::iter::once(&c.fixture_command)
+                    .chain(std::iter::once(&c.native_prepare))
+                    .chain(c.frontend_commands.iter())
+                    .chain(c.host_commands.iter())
+            }))
+    }
+
+    pub fn chunk(&self, subject: Subject) -> Result<&Chunk> {
+        self.chunks
+            .get(&subject.to_string())
+            .ok_or_else(|| invalid(format!("no manifest entry for {subject}")))
+    }
+
+    /// Chunks belonging to a phase, in order.
+    pub fn phase_chunks(&self, phase: Subject) -> Result<Vec<Subject>> {
+        self.phases
+            .get(&phase.to_string())
+            .ok_or_else(|| invalid(format!("no phase {phase}")))?
+            .iter()
+            .map(|c| Subject::parse(c))
+            .collect()
+    }
+
+    /// The phase containing a chunk.
+    pub fn phase_of(&self, chunk: Subject) -> Result<Subject> {
+        let id = chunk.to_string();
+        self.phases
+            .iter()
+            .find(|(_, members)| members.contains(&id))
+            .map(|(phase, _)| Subject::parse(phase))
+            .ok_or_else(|| invalid(format!("{chunk} belongs to no phase")))?
+    }
+
+    pub fn requires_shared_source(&self, chunk: Subject) -> bool {
+        self.shared_source_required_chunks
+            .contains(&chunk.to_string())
+    }
+
+    /// Commands `check` runs for a chunk, in order.
+    pub fn check_commands(&self, chunk: Subject) -> Vec<Command> {
+        let mut commands: Vec<Command> = self
+            .common_commands
+            .iter()
+            .enumerate()
+            .map(|(i, argv)| Command {
+                label: format!("common/{}", i + 1),
+                argv: argv.clone(),
+                expects_tests: is_test_runner(argv),
+            })
+            .collect();
+        if self.requires_shared_source(chunk) {
+            commands.extend(
+                self.shared_source_commands
+                    .iter()
+                    .enumerate()
+                    .map(|(i, argv)| Command {
+                        label: format!("shared/{}", i + 1),
+                        argv: argv.clone(),
+                        expects_tests: is_test_runner(argv),
+                    }),
+            );
+        }
+        commands
+    }
+
+    /// Named fixture targets `test` runs for a chunk; each must execute tests.
+    pub fn test_commands(&self, chunk: Subject) -> Result<Vec<Command>> {
+        let entry = self.chunk(chunk)?;
+        let mut commands = vec![Command {
+            label: "fixture".to_owned(),
+            argv: entry.fixture_command.clone(),
+            expects_tests: true,
+        }];
+        commands.extend(
+            entry
+                .host_commands
+                .iter()
+                .enumerate()
+                .map(|(i, argv)| Command {
+                    label: format!("host/{}", i + 1),
+                    argv: argv.clone(),
+                    expects_tests: true,
+                }),
+        );
+        commands.extend(
+            entry
+                .frontend_commands
+                .iter()
+                .enumerate()
+                .map(|(i, argv)| Command {
+                    label: format!("frontend/{}", i + 1),
+                    argv: argv.clone(),
+                    expects_tests: true,
+                }),
+        );
+        Ok(commands)
+    }
+}
+
+fn is_test_runner(argv: &Argv) -> bool {
+    argv.iter().any(|a| a == "vitest")
+        || (argv.first().map(String::as_str) == Some("cargo")
+            && argv.get(1).map(String::as_str) == Some("test"))
+}
+
+fn check_argv(argv: &Argv) -> Result<()> {
+    let program = argv
+        .first()
+        .ok_or_else(|| invalid("manifest command is an empty argv"))?;
+    if !PROGRAMS.contains(&program.as_str()) {
+        return Err(invalid(format!(
+            "manifest program {program:?} is not allowlisted"
+        )));
+    }
+    for arg in argv {
+        if arg.contains('\0') || arg.contains('\n') {
+            return Err(invalid("manifest argument contains a control character"));
+        }
+        // Only the controller's own validated substitutions may appear.
+        if arg.contains('{') && !matches!(arg.as_str(), "{chunk}" | "{phase}") {
+            return Err(invalid(format!(
+                "unexpected placeholder in manifest argument {arg:?}"
+            )));
+        }
+    }
+    if argv.iter().any(|a| a == "--all-features") {
+        return Err(invalid(
+            "--all-features is prohibited; features are explicit",
+        ));
+    }
+    Ok(())
+}
diff --git a/crates/xtask/src/native.rs b/crates/xtask/src/native.rs
new file mode 100644
index 0000000..d622241
--- /dev/null
+++ b/crates/xtask/src/native.rs
@@ -0,0 +1,174 @@
+//! Fixture native builds for acceptance (`native-prepare`) and the `native`
+//! gate that requires an actual acceptance record for the prepared bytes.
+
+use std::path::{Path, PathBuf};
+
+use serde::{Deserialize, Serialize};
+
+use crate::env::Environment;
+use crate::evidence::NativeAcceptance;
+use crate::fingerprint;
+use crate::manifest::Manifest;
+use crate::runner::Artifact;
+use crate::{Repo, Result, Subject, invalid, io_err, now_utc, read_json, sha256_hex, write_json};
+
+pub const FIXTURE_IDENTIFIER: &str = "io.cdot.prisma-airs-desktop.v2.fixture";
+pub const PRODUCTION_IDENTIFIER: &str = "io.cdot.prisma-airs-desktop.v2";
+const EXECUTABLE: &str = "prisma-airs-desktop-v2";
+
+#[derive(Clone, Debug, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct Prepared {
+    pub subject: String,
+    pub built_utc: String,
+    pub bundle: String,
+    pub identifier: String,
+    pub executable_sha256: String,
+    pub bundle_sha256: String,
+    pub features: Vec<String>,
+    pub target: String,
+    pub commands: Vec<Vec<String>>,
+}
+
+fn run(env: &Environment, repo: &Repo, argv: &[&str]) -> Result<()> {
+    let argv: Vec<String> = argv.iter().map(|s| (*s).to_owned()).collect();
+    let status = env
+        .command(&argv, repo.root())?
+        .status()
+        .map_err(io_err(repo.root()))?;
+    if status.success() {
+        Ok(())
+    } else {
+        Err(invalid(format!("{} failed with {status}", argv.join(" "))))
+    }
+}
+
+/// The fixed fixture build commands (frontend then Tauri app bundle).
+pub fn build_commands(target: &str) -> Vec<Vec<&str>> {
+    vec![
+        vec!["pnpm", "--filter", "@prisma-airs/desktop", "build"],
+        vec![
+            "pnpm",
+            "--filter",
+            "@prisma-airs/desktop",
+            "exec",
+            "tauri",
+            "build",
+            "--ci",
+            "--no-sign",
+            "--target",
+            target,
+            "--bundles",
+            "app",
+            "--features",
+            "test-fixtures",
+            "--config",
+            "src-tauri/tauri.fixture.conf.json",
+        ],
+    ]
+}
+
+pub fn bundle_path(repo: &Repo, target: &str, product: &str) -> PathBuf {
+    repo.join(format!(
+        "target/{target}/release/bundle/macos/{product}.app"
+    ))
+}
+
+pub fn plist_value(bundle: &Path, key: &str) -> Result<String> {
+    let plist = bundle.join("Contents/Info.plist");
+    let output = std::process::Command::new("/usr/bin/plutil")
+        .args(["-extract", key, "raw", "-o", "-"])
+        .arg(&plist)
+        .env_clear()
+        .output()
+        .map_err(io_err(&plist))?;
+    if !output.status.success() {
+        return Err(invalid(format!(
+            "cannot read {key} from {}",
+            plist.display()
+        )));
+    }
+    Ok(String::from_utf8_lossy(&output.stdout).trim().to_owned())
+}
+
+pub fn prepare(
+    repo: &Repo,
+    manifest: &Manifest,
+    env: &Environment,
+    subject: Subject,
+    target: &str,
+    features: &[String],
+) -> Result<Prepared> {
+    if target != manifest.target {
+        return Err(invalid(format!(
+            "target {target} is not the manifest target {}",
+            manifest.target
+        )));
+    }
+    if features != manifest.fixture_only_features.as_slice() {
+        return Err(invalid(
+            "native-prepare requires exactly the fixture-only features",
+        ));
+    }
+    let commands = build_commands(target);
+    for argv in &commands {
+        run(env, repo, argv)?;
+    }
+    let bundle = bundle_path(repo, target, "Prisma AIRS Desktop v2 Fixture");
+    let identifier = plist_value(&bundle, "CFBundleIdentifier")?;
+    if identifier != FIXTURE_IDENTIFIER {
+        return Err(invalid(format!(
+            "fixture bundle has identifier {identifier}"
+        )));
+    }
+    let executable = bundle.join("Contents/MacOS").join(EXECUTABLE);
+    let bytes = std::fs::read(&executable).map_err(io_err(&executable))?;
+    let prepared = Prepared {
+        subject: subject.to_string(),
+        built_utc: now_utc(),
+        bundle: bundle
+            .strip_prefix(repo.root())
+            .unwrap_or(&bundle)
+            .display()
+            .to_string(),
+        identifier,
+        executable_sha256: sha256_hex(&bytes),
+        bundle_sha256: fingerprint::tree_hash(&bundle)?,
+        features: features.to_vec(),
+        target: target.to_owned(),
+        commands: commands
+            .iter()
+            .map(|argv| argv.iter().map(|s| (*s).to_owned()).collect())
+            .collect(),
+    };
+    write_json(
+        &repo.evidence_dir(subject).join("native-prepare.json"),
+        &prepared,
+    )?;
+    Ok(prepared)
+}
+
+/// Artifact entry recorded on the native-prepare run.
+pub fn artifact(repo: &Repo, subject: Subject) -> Result<Artifact> {
+    let prepared: Prepared = read_json(&repo.evidence_dir(subject).join("native-prepare.json"))?;
+    Ok(Artifact {
+        name: "fixture-executable".to_owned(),
+        path: format!("{}/Contents/MacOS/{EXECUTABLE}", prepared.bundle),
+        sha256: prepared.executable_sha256,
+    })
+}
+
+/// Reasons the subject's native acceptance is not yet established.
+pub fn acceptance_status(repo: &Repo, subject: Subject, executable_sha256: &str) -> Vec<String> {
+    let path = repo.evidence_dir(subject).join("native-acceptance.json");
+    match std::fs::read(&path) {
+        Err(_) => vec![format!(
+            "blocked: {} is missing; record actual CUA/operator native acceptance for executable {executable_sha256}",
+            path.display()
+        )],
+        Ok(bytes) => match NativeAcceptance::parse(&bytes) {
+            Ok(record) => record.failures(&subject.to_string(), executable_sha256),
+            Err(e) => vec![e.to_string()],
+        },
+    }
+}
diff --git a/crates/xtask/src/notices.rs b/crates/xtask/src/notices.rs
new file mode 100644
index 0000000..2e9a37e
--- /dev/null
+++ b/crates/xtask/src/notices.rs
@@ -0,0 +1,193 @@
+//! Exact third-party notice inventory for what the desktop app ships.
+//!
+//! Rust: every package reachable from `desktop-host` through normal
+//! dependencies in the locked graph (a superset across targets). JavaScript:
+//! the production dependency tree of `@prisma-airs/desktop` as installed. A
+//! package without a declared license fails the check; C26 compares this
+//! inventory with the signed bundle.
+
+use std::collections::{BTreeMap, BTreeSet};
+
+use serde::{Deserialize, Serialize};
+
+use crate::env::Environment;
+use crate::{Repo, Result, invalid, io_err, read_json, write_json};
+
+pub const INVENTORY: &str = "docs/architecture/notice-inventory.json";
+
+#[derive(Clone, Debug, PartialEq, Eq, PartialOrd, Ord, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct Package {
+    pub ecosystem: String,
+    pub name: String,
+    pub version: String,
+    pub license: String,
+}
+
+#[derive(Clone, Debug, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct Inventory {
+    pub schema: String,
+    pub scope: String,
+    pub packages: Vec<Package>,
+}
+
+fn output(env: &Environment, repo: &Repo, argv: &[&str]) -> Result<Vec<u8>> {
+    let argv: Vec<String> = argv.iter().map(|s| (*s).to_owned()).collect();
+    let out = env
+        .command(&argv, repo.root())?
+        .output()
+        .map_err(io_err(repo.root()))?;
+    if !out.status.success() {
+        return Err(invalid(format!(
+            "{} failed: {}",
+            argv.join(" "),
+            String::from_utf8_lossy(&out.stderr)
+        )));
+    }
+    Ok(out.stdout)
+}
+
+fn rust_packages(env: &Environment, repo: &Repo) -> Result<Vec<Package>> {
+    let bytes = output(
+        env,
+        repo,
+        &["cargo", "metadata", "--locked", "--format-version", "1"],
+    )?;
+    let meta: serde_json::Value =
+        serde_json::from_slice(&bytes).map_err(|e| invalid(e.to_string()))?;
+    let packages: BTreeMap<&str, &serde_json::Value> = meta["packages"]
+        .as_array()
+        .ok_or_else(|| invalid("cargo metadata has no packages"))?
+        .iter()
+        .filter_map(|p| Some((p["id"].as_str()?, p)))
+        .collect();
+    let nodes: BTreeMap<&str, &serde_json::Value> = meta["resolve"]["nodes"]
+        .as_array()
+        .ok_or_else(|| invalid("cargo metadata has no resolve graph"))?
+        .iter()
+        .filter_map(|n| Some((n["id"].as_str()?, n)))
+        .collect();
+    let root = packages
+        .iter()
+        .find(|(_, p)| p["name"] == "desktop-host")
+        .map(|(id, _)| *id)
+        .ok_or_else(|| invalid("desktop-host not in metadata"))?;
+    let mut seen = BTreeSet::new();
+    let mut stack = vec![root];
+    while let Some(id) = stack.pop() {
+        if !seen.insert(id) {
+            continue;
+        }
+        let Some(node) = nodes.get(id) else { continue };
+        for dep in node["deps"].as_array().into_iter().flatten() {
+            let normal = dep["dep_kinds"]
+                .as_array()
+                .into_iter()
+                .flatten()
+                .any(|k| k["kind"].is_null());
+            if normal && let Some(pkg) = dep["pkg"].as_str() {
+                stack.push(pkg);
+            }
+        }
+    }
+    Ok(seen
+        .into_iter()
+        .filter_map(|id| packages.get(id))
+        .filter(|p| p["source"].is_string())
+        .map(|p| Package {
+            ecosystem: "cargo".to_owned(),
+            name: p["name"].as_str().unwrap_or_default().to_owned(),
+            version: p["version"].as_str().unwrap_or_default().to_owned(),
+            license: p["license"].as_str().unwrap_or_default().to_owned(),
+        })
+        .collect())
+}
+
+fn js_packages(env: &Environment, repo: &Repo) -> Result<Vec<Package>> {
+    let bytes = output(
+        env,
+        repo,
+        &[
+            "pnpm",
+            "--filter",
+            "@prisma-airs/desktop",
+            "list",
+            "--prod",
+            "--depth",
+            "Infinity",
+            "--json",
+        ],
+    )?;
+    let tree: serde_json::Value =
+        serde_json::from_slice(&bytes).map_err(|e| invalid(e.to_string()))?;
+    let mut found = BTreeSet::new();
+    let mut stack: Vec<&serde_json::Value> = tree
+        .as_array()
+        .into_iter()
+        .flatten()
+        .filter_map(|p| p["dependencies"].as_object())
+        .flat_map(|deps| deps.values())
+        .collect();
+    while let Some(dep) = stack.pop() {
+        let path = dep["path"].as_str().unwrap_or_default();
+        let manifest: serde_json::Value =
+            read_json(&std::path::Path::new(path).join("package.json")).unwrap_or_default();
+        let name = manifest["name"].as_str().unwrap_or_default().to_owned();
+        let license = match &manifest["license"] {
+            serde_json::Value::String(s) => s.clone(),
+            _ => String::new(),
+        };
+        // Workspace/Academy-owned inputs are covered by their own records.
+        if !name.starts_with("@prisma-airs/") && !name.starts_with("@ai-security-academy/") {
+            found.insert(Package {
+                ecosystem: "npm".to_owned(),
+                name,
+                version: manifest["version"].as_str().unwrap_or_default().to_owned(),
+                license,
+            });
+        }
+        if let Some(children) = dep["dependencies"].as_object() {
+            stack.extend(children.values());
+        }
+    }
+    Ok(found.into_iter().collect())
+}
+
+pub fn build(env: &Environment, repo: &Repo) -> Result<Inventory> {
+    let mut packages = rust_packages(env, repo)?;
+    packages.extend(js_packages(env, repo)?);
+    packages.sort();
+    packages.dedup();
+    let unknown: Vec<String> = packages
+        .iter()
+        .filter(|p| p.license.trim().is_empty())
+        .map(|p| format!("{}:{}@{}", p.ecosystem, p.name, p.version))
+        .collect();
+    if !unknown.is_empty() {
+        return Err(invalid(format!(
+            "packages without a declared license: {}",
+            unknown.join(", ")
+        )));
+    }
+    Ok(Inventory {
+        schema: "airs-v2/notice-inventory/1".to_owned(),
+        scope: "registry packages reachable from desktop-host (normal deps, all targets) and the production npm tree of @prisma-airs/desktop; Academy-owned presentation is recorded in inputs.lock.json".to_owned(),
+        packages,
+    })
+}
+
+pub fn run(env: &Environment, repo: &Repo, check: bool) -> Result<()> {
+    let fresh = build(env, repo)?;
+    if check {
+        let committed: Inventory = read_json(&repo.join(INVENTORY))?;
+        if committed != fresh {
+            return Err(invalid(
+                "notice inventory differs from the resolved dependencies; run `xtask notices`",
+            ));
+        }
+        Ok(())
+    } else {
+        write_json(&repo.join(INVENTORY), &fresh)
+    }
+}
diff --git a/crates/xtask/src/package.rs b/crates/xtask/src/package.rs
new file mode 100644
index 0000000..6d88087
--- /dev/null
+++ b/crates/xtask/src/package.rs
@@ -0,0 +1,68 @@
+//! Package gates. Neither kind uploads or publishes anything.
+//!
+//! * preview: only completed chunks may be advertised; every other feature
+//!   must stay visibly unavailable in the build.
+//! * release-candidate: requires C01–C25 completed; C26 adds the signed,
+//!   notarized, stapled and installed-byte validators.
+
+use crate::complete::{is_completed, read_ledger};
+use crate::{Repo, Result, Subject, invalid};
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum Kind {
+    Preview,
+    ReleaseCandidate,
+}
+
+impl Kind {
+    pub fn parse(text: &str) -> Result<Self> {
+        match text {
+            "preview" => Ok(Self::Preview),
+            "release-candidate" => Ok(Self::ReleaseCandidate),
+            other => Err(invalid(format!("unknown package kind {other}"))),
+        }
+    }
+}
+
+/// Completed chunks, in order, from the append-only ledger.
+pub fn completed_chunks(repo: &Repo) -> Result<Vec<Subject>> {
+    let entries = read_ledger(&repo.completion_ledger())?;
+    Ok((1..=26u8)
+        .map(Subject::Chunk)
+        .filter(|s| is_completed(&entries, *s))
+        .collect())
+}
+
+pub fn gate(repo: &Repo, kind: Kind) -> Result<Vec<Subject>> {
+    let completed = completed_chunks(repo)?;
+    match kind {
+        Kind::Preview => {
+            if completed.is_empty() {
+                return Err(invalid(
+                    "a preview package needs at least one completed chunk",
+                ));
+            }
+            // Completion must be a contiguous prefix: no skipped predecessor.
+            for (i, subject) in completed.iter().enumerate() {
+                if *subject != Subject::Chunk(i as u8 + 1) {
+                    return Err(invalid("completed chunks are not a contiguous prefix"));
+                }
+            }
+            Ok(completed)
+        }
+        Kind::ReleaseCandidate => {
+            let missing: Vec<String> = (1..=25u8)
+                .map(Subject::Chunk)
+                .filter(|s| !completed.contains(s))
+                .map(|s| s.to_string())
+                .collect();
+            if !missing.is_empty() {
+                return Err(invalid(format!(
+                    "release-candidate requires C01-C25 completed; missing {}",
+                    missing.join(", ")
+                )));
+            }
+            Ok(completed)
+        }
+    }
+}
diff --git a/crates/xtask/src/paths.rs b/crates/xtask/src/paths.rs
