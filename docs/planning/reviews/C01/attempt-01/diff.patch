index 0000000..faeec72
--- /dev/null
+++ b/crates/xtask/src/complete.rs
@@ -0,0 +1,261 @@
+//! The append-only completion ledger and predecessor rules.
+//!
+//! `complete` is a read-only validation of the current inputs against a
+//! review receipt followed by one appended line. It never edits earlier lines,
+//! never trusts a receipt's own `passed` flag, and refuses duplicates.
+
+use std::io::Write;
+use std::path::{Path, PathBuf};
+use std::process::Command;
+
+use serde::{Deserialize, Serialize};
+
+use crate::fingerprint::{self, Fingerprints};
+use crate::gate::{self, Receipt};
+use crate::manifest::Manifest;
+use crate::runner::RunKind;
+use crate::{Repo, Result, Subject, invalid, io_err, now_utc, read_json, sha256_hex};
+
+#[derive(Clone, Debug, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(tag = "kind", rename_all = "lowercase", deny_unknown_fields)]
+pub enum Entry {
+    Completion {
+        subject: String,
+        receipt_id: String,
+        receipt: String,
+        receipt_sha256: String,
+        fingerprints: Fingerprints,
+        completed_utc: String,
+    },
+    Commit {
+        subject: String,
+        commit: String,
+        tree: String,
+        source: String,
+        verified_utc: String,
+    },
+}
+
+pub fn read_ledger(path: &Path) -> Result<Vec<Entry>> {
+    let Ok(text) = std::fs::read_to_string(path) else {
+        return Ok(Vec::new());
+    };
+    text.lines()
+        .filter(|l| !l.trim().is_empty())
+        .map(|l| {
+            serde_json::from_str(l)
+                .map_err(|e| invalid(format!("corrupt completion ledger line: {e}")))
+        })
+        .collect()
+}
+
+fn append(path: &Path, entry: &Entry) -> Result<()> {
+    let line = serde_json::to_string(entry).map_err(|e| invalid(e.to_string()))?;
+    if let Some(parent) = path.parent() {
+        std::fs::create_dir_all(parent).map_err(io_err(parent))?;
+    }
+    let mut file = std::fs::OpenOptions::new()
+        .create(true)
+        .append(true)
+        .open(path)
+        .map_err(io_err(path))?;
+    writeln!(file, "{line}").map_err(io_err(path))
+}
+
+pub fn is_completed(entries: &[Entry], subject: Subject) -> bool {
+    let id = subject.to_string();
+    let completed = entries
+        .iter()
+        .any(|e| matches!(e, Entry::Completion { subject, .. } if *subject == id));
+    let committed = entries
+        .iter()
+        .any(|e| matches!(e, Entry::Commit { subject, .. } if *subject == id));
+    completed && committed
+}
+
+/// Subjects that must be complete (reviewed and committed) before `subject`.
+pub fn predecessors(manifest: &Manifest, subject: Subject) -> Result<Vec<Subject>> {
+    match subject {
+        Subject::Chunk(1) => Ok(Vec::new()),
+        Subject::Chunk(n) => {
+            let mut required = vec![Subject::Chunk(n - 1)];
+            let phase = manifest.phase_of(subject)?;
+            let previous_phase = manifest.phase_of(Subject::Chunk(n - 1))?;
+            if phase != previous_phase {
+                required.push(previous_phase);
+            }
+            Ok(required)
+        }
+        Subject::Phase(_) => manifest.phase_chunks(subject),
+    }
+}
+
+/// The historical planning gate C01 depends on (reviewed by Claude, D019).
+pub fn g01_receipt(repo: &Repo) -> PathBuf {
+    repo.join("docs/planning/reviews/G01/attempt-05/receipt.json")
+}
+
+pub fn check_g01(repo: &Repo) -> Result<()> {
+    let receipt: serde_json::Value = read_json(&g01_receipt(repo))?;
+    let passed = receipt.get("passed").and_then(|v| v.as_bool()) == Some(true);
+    let scores_ok = receipt
+        .get("scores")
+        .and_then(|s| s.as_object())
+        .is_some_and(|s| s.len() == 5 && s.values().all(|v| v.as_u64().is_some_and(|n| n >= 9)));
+    if passed && scores_ok {
+        Ok(())
+    } else {
+        Err(invalid(
+            "historical G01 receipt does not record a passing design gate",
+        ))
+    }
+}
+
+pub fn require_predecessors(repo: &Repo, manifest: &Manifest, subject: Subject) -> Result<()> {
+    if subject == Subject::Chunk(1) {
+        return check_g01(repo);
+    }
+    let entries = read_ledger(&repo.completion_ledger())?;
+    for required in predecessors(manifest, subject)? {
+        if !is_completed(&entries, required) {
+            return Err(invalid(format!(
+                "{subject} requires {required} to be reviewed, completed and committed first"
+            )));
+        }
+    }
+    Ok(())
+}
+
+pub fn required_runs(subject: Subject) -> Vec<RunKind> {
+    if subject.is_phase() {
+        vec![RunKind::Check, RunKind::Test]
+    } else {
+        vec![RunKind::Check, RunKind::Test, RunKind::NativePrepare]
+    }
+}
+
+/// Validates the newest passing receipt and appends a completion line.
+pub fn complete(
+    repo: &Repo,
+    manifest: &Manifest,
+    subject: Subject,
+    current: Fingerprints,
+) -> Result<Entry> {
+    require_predecessors(repo, manifest, subject)?;
+    let ledger = repo.completion_ledger();
+    let entries = read_ledger(&ledger)?;
+    if entries
+        .iter()
+        .any(|e| matches!(e, Entry::Completion { subject: s, .. } if *s == subject.to_string()))
+    {
+        return Err(invalid(format!(
+            "{subject} is already completed; completions are append-only"
+        )));
+    }
+    let mut attempts: Vec<PathBuf> = std::fs::read_dir(repo.reviews_dir(subject))
+        .map_err(io_err(&repo.reviews_dir(subject)))?
+        .filter_map(|e| e.ok())
+        .map(|e| e.path().join("receipt.json"))
+        .filter(|p| p.is_file())
+        .collect();
+    attempts.sort();
+    let mut last_failures = vec!["no review receipt exists".to_owned()];
+    for receipt_path in attempts.iter().rev() {
+        let inputs = gate::load(
+            repo.root(),
+            receipt_path,
+            current.clone(),
+            !subject.is_phase(),
+            required_runs(subject),
+        )?;
+        let failures = gate::evaluate(&inputs);
+        if !failures.is_empty() {
+            last_failures = failures;
+            continue;
+        }
+        let receipt: Receipt =
+            serde_json::from_slice(&inputs.receipt_bytes).map_err(|e| invalid(e.to_string()))?;
+        if entries.iter().any(|e| matches!(e, Entry::Completion { receipt_id, .. } if *receipt_id == receipt.receipt_id)) {
+            return Err(invalid("duplicate receipt ID; a receipt can complete only once"));
+        }
+        let relative = receipt_path
+            .strip_prefix(repo.root())
+            .unwrap_or(receipt_path)
+            .display()
+            .to_string();
+        let entry = Entry::Completion {
+            subject: subject.to_string(),
+            receipt_id: receipt.receipt_id,
+            receipt: relative,
+            receipt_sha256: sha256_hex(&inputs.receipt_bytes),
+            fingerprints: current,
+            completed_utc: now_utc(),
+        };
+        append(&ledger, &entry)?;
+        return Ok(entry);
+    }
+    Err(invalid(format!(
+        "{subject} cannot complete: {}",
+        last_failures.join("; ")
+    )))
+}
+
+fn git(repo: &Repo, args: &[&str]) -> Result<String> {
+    let output = Command::new("/usr/bin/git")
+        .args(args)
+        .current_dir(repo.root())
+        .env_clear()
+        .env("PATH", "/usr/bin:/bin")
+        .env("HOME", std::env::var("HOME").unwrap_or_default())
+        .output()
+        .map_err(io_err(repo.root()))?;
+    if !output.status.success() {
+        return Err(invalid(format!("git {} failed", args.join(" "))));
+    }
+    Ok(String::from_utf8_lossy(&output.stdout).trim().to_owned())
+}
+
+/// Verifies HEAD contains exactly the reviewed source and records the commit.
+pub fn verify_commit(repo: &Repo, subject: Subject) -> Result<Entry> {
+    let ledger = repo.completion_ledger();
+    let entries = read_ledger(&ledger)?;
+    let reviewed = entries
+        .iter()
+        .rev()
+        .find_map(|e| match e {
+            Entry::Completion {
+                subject: s,
+                fingerprints,
+                ..
+            } if *s == subject.to_string() => Some(fingerprints.source.clone()),
+            _ => None,
+        })
+        .ok_or_else(|| invalid(format!("{subject} has no completion to bind a commit to")))?;
+    let status = git(repo, &["status", "--porcelain=v1", "--untracked-files=all"])?;
+    let dirty: Vec<&str> = status
+        .lines()
+        .map(|l| l.get(3..).unwrap_or(l))
+        .filter(|p| !fingerprint::is_excluded(p))
+        .collect();
+    if !dirty.is_empty() {
+        return Err(invalid(format!(
+            "working tree has uncommitted source changes: {}",
+            dirty.join(", ")
+        )));
+    }
+    let source = fingerprint::source(repo)?;
+    if source != reviewed {
+        return Err(invalid(
+            "committed source differs from the reviewed source fingerprint",
+        ));
+    }
+    let entry = Entry::Commit {
+        subject: subject.to_string(),
+        commit: git(repo, &["rev-parse", "HEAD"])?,
+        tree: git(repo, &["rev-parse", "HEAD^{tree}"])?,
+        source,
+        verified_utc: now_utc(),
+    };
+    append(&ledger, &entry)?;
+    Ok(entry)
+}
diff --git a/crates/xtask/src/env.rs b/crates/xtask/src/env.rs
new file mode 100644
index 0000000..4efa777
--- /dev/null
+++ b/crates/xtask/src/env.rs
@@ -0,0 +1,248 @@
+//! The environment contract for controller commands.
+//!
+//! Every command starts from a cleared environment. Only the preserved
+//! identity variables, an explicit PATH of selected tool directories and the
+//! declared nonsecret build values are set. Inherited variables that could
+//! silently change compilation are refused outright, `.env` files fail the
+//! run, and the resolved tool identities (version output and executable
+//! hash) are recorded as dependency inputs.
+
+use std::collections::BTreeMap;
+use std::path::{Path, PathBuf};
+use std::process::Command;
+
+use serde::{Deserialize, Serialize};
+
+use crate::{Repo, Result, invalid, io_err, read_json, sha256_hex};
+
+#[derive(Clone, Debug, Deserialize)]
+#[serde(deny_unknown_fields)]
+struct ToolchainManifest {
+    schema_version: u32,
+    #[allow(dead_code)]
+    description: String,
+    path_dirs: Vec<String>,
+    tools: Vec<ToolSpec>,
+    declared_env: BTreeMap<String, String>,
+    preserve_unchanged: Vec<String>,
+    reject_inherited: Vec<String>,
+    reject_inherited_prefixes: Vec<String>,
+}
+
+#[derive(Clone, Debug, Deserialize)]
+#[serde(deny_unknown_fields)]
+struct ToolSpec {
+    name: String,
+    argv: Vec<String>,
+    expect_prefix: String,
+}
+
+/// A resolved build tool.
+#[derive(Clone, Debug, PartialEq, Eq, Serialize, Deserialize)]
+pub struct ToolIdentity {
+    pub name: String,
+    pub path: String,
+    pub version: String,
+    pub sha256: String,
+}
+
+/// The concrete environment commands run under.
+#[derive(Clone, Debug)]
+pub struct Environment {
+    vars: BTreeMap<String, String>,
+    path_dirs: Vec<PathBuf>,
+    pub tools: Vec<ToolIdentity>,
+}
+
+impl Environment {
+    /// Resolves the toolchain and verifies tool versions.
+    pub fn prepare(repo: &Repo) -> Result<Self> {
+        let spec: ToolchainManifest = read_json(&repo.toolchain_manifest())?;
+        if spec.schema_version != 1 {
+            return Err(invalid("unsupported toolchain.json schema_version"));
+        }
+        refuse_inherited(&spec)?;
+        refuse_env_files(repo)?;
+        let home = std::env::var("HOME").map_err(|_| invalid("HOME must be set"))?;
+        let path_dirs: Vec<PathBuf> = spec
+            .path_dirs
+            .iter()
+            .map(|dir| expand(dir, &home, repo.root()))
+            .collect();
+        let mut vars = BTreeMap::new();
+        for name in &spec.preserve_unchanged {
+            if let Ok(value) = std::env::var(name) {
+                vars.insert(name.clone(), value);
+            }
+        }
+        for (name, value) in &spec.declared_env {
+            if vars.contains_key(name) {
+                return Err(invalid(format!("{name} is both preserved and declared")));
+            }
+            vars.insert(name.clone(), value.clone());
+        }
+        let joined = path_dirs
+            .iter()
+            .map(|p| p.display().to_string())
+            .collect::<Vec<_>>()
+            .join(":");
+        vars.insert("PATH".to_owned(), joined);
+        let mut env = Self {
+            vars,
+            path_dirs,
+            tools: Vec::new(),
+        };
+        for tool in &spec.tools {
+            env.tools.push(env.identify(tool, repo.root())?);
+        }
+        Ok(env)
+    }
+
+    fn identify(&self, tool: &ToolSpec, cwd: &Path) -> Result<ToolIdentity> {
+        let program = self.resolve(&tool.argv[0])?;
+        let output = self
+            .command(&tool.argv, cwd)?
+            .output()
+            .map_err(io_err(&program))?;
+        let version = String::from_utf8_lossy(&output.stdout).trim().to_owned();
+        if !output.status.success() || !version.starts_with(&tool.expect_prefix) {
+            return Err(invalid(format!(
+                "{} reports {version:?}; expected prefix {:?}",
+                tool.name, tool.expect_prefix
+            )));
+        }
+        let bytes = std::fs::read(&program).map_err(io_err(&program))?;
+        Ok(ToolIdentity {
+            name: tool.name.clone(),
+            path: program.display().to_string(),
+            version,
+            sha256: sha256_hex(&bytes),
+        })
+    }
+
+    /// Finds a program in the selected PATH (never the caller's PATH).
+    pub fn resolve(&self, program: &str) -> Result<PathBuf> {
+        if program.contains('/') {
+            return Err(invalid(format!("program must be a bare name: {program}")));
+        }
+        self.path_dirs
+            .iter()
+            .map(|dir| dir.join(program))
+            .find(|candidate| candidate.is_file())
+            .ok_or_else(|| {
+                invalid(format!(
+                    "{program} not found in the selected toolchain PATH"
+                ))
+            })
+    }
+
+    /// Builds a process for an argv under this environment.
+    pub fn command(&self, argv: &[String], cwd: &Path) -> Result<Command> {
+        let program = argv
+            .first()
+            .ok_or_else(|| invalid("empty argv"))
+            .and_then(|p| self.resolve(p))?;
+        let mut command = Command::new(program);
+        command.args(&argv[1..]).current_dir(cwd).env_clear();
+        for (name, value) in &self.vars {
+            command.env(name, value);
+        }
+        Ok(command)
+    }
+
+    /// Adds a declared value for specific commands (never secrets).
+    pub fn with(mut self, name: &str, value: &str) -> Self {
+        self.vars.insert(name.to_owned(), value.to_owned());
+        self
+    }
+
+    /// Nonsecret effective variables recorded with each run. Identity values
+    /// (HOME/USER/LOGNAME) are recorded by name only.
+    pub fn recorded_vars(&self) -> BTreeMap<String, String> {
+        self.vars
+            .iter()
+            .map(|(name, value)| {
+                let shown = if matches!(name.as_str(), "HOME" | "USER" | "LOGNAME" | "TMPDIR") {
+                    "<preserved>".to_owned()
+                } else {
+                    value.clone()
+                };
+                (name.clone(), shown)
+            })
+            .collect()
+    }
+
+    /// Hash of the toolchain identities, part of the dependency fingerprint.
+    pub fn toolchain_hash(&self) -> String {
+        let text = self
+            .tools
+            .iter()
+            .map(|t| format!("{}\0{}\0{}\n", t.name, t.version, t.sha256))
+            .collect::<String>();
+        sha256_hex(text.as_bytes())
+    }
+}
+
+fn expand(dir: &str, home: &str, repo: &Path) -> PathBuf {
+    if let Some(rest) = dir.strip_prefix("$HOME") {
+        PathBuf::from(format!("{home}{rest}"))
+    } else if let Some(rest) = dir.strip_prefix("{repo}") {
+        PathBuf::from(format!("{}{rest}", repo.display()))
+    } else {
+        PathBuf::from(dir)
+    }
+}
+
+fn refuse_inherited(spec: &ToolchainManifest) -> Result<()> {
+    // A variable already equal to its declared value (for example inside a
+    // nested controller command) is not an override.
+    let mut offending: Vec<String> = std::env::vars_os()
+        .filter_map(|(name, value)| Some((name.into_string().ok()?, value.into_string().ok())))
+        .filter(|(name, value)| spec.declared_env.get(name).map(String::as_str) != value.as_deref())
+        .map(|(name, _)| name)
+        .filter(|name| {
+            spec.reject_inherited.contains(name)
+                || spec
+                    .reject_inherited_prefixes
+                    .iter()
+                    .any(|prefix| name.starts_with(prefix.as_str()))
+        })
+        .collect();
+    offending.sort();
+    if offending.is_empty() {
+        Ok(())
+    } else {
+        Err(invalid(format!(
+            "refusing undeclared inherited overrides: {}",
+            offending.join(", ")
+        )))
+    }
+}
+
+/// `.env` files are never read and their presence fails the run.
+pub fn refuse_env_files(repo: &Repo) -> Result<()> {
+    let mut dirs = vec![
+        repo.root().to_path_buf(),
+        repo.join("apps/desktop"),
+        repo.join("apps/desktop/src-tauri"),
+    ];
+    if let Ok(entries) = std::fs::read_dir(repo.join("packages")) {
+        dirs.extend(entries.filter_map(|e| e.ok()).map(|e| e.path()));
+    }
+    for dir in dirs {
+        let Ok(entries) = std::fs::read_dir(&dir) else {
+            continue;
+        };
+        for entry in entries.filter_map(|e| e.ok()) {
+            let name = entry.file_name();
+            let name = name.to_string_lossy();
+            if name == ".env" || name.starts_with(".env.") {
+                return Err(invalid(format!(
+                    "unexpected environment file {}; the controller never reads .env files",
+                    entry.path().display()
+                )));
+            }
+        }
+    }
+    Ok(())
+}
diff --git a/crates/xtask/src/evidence.rs b/crates/xtask/src/evidence.rs
new file mode 100644
index 0000000..2c50b30
--- /dev/null
+++ b/crates/xtask/src/evidence.rs
@@ -0,0 +1,100 @@
+//! Native acceptance records (T09 and chunk-specific native assertions).
+//!
+//! `native-prepare` builds and launches the fixture app and records its
+//! executable hash. A separate acceptance record, produced by actual
+//! computer-use interaction or a recorded operator procedure, must name that
+//! exact hash and report every check. A build exit status is never
+//! acceptance.
+
+use serde::{Deserialize, Serialize};
+
+use crate::{Result, invalid};
+
+pub const NATIVE_SCHEMA: &str = "airs-v2/native-acceptance/1";
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(rename_all = "lowercase")]
+pub enum Method {
+    /// Computer-use automation driving the real native window.
+    Cua,
+    /// A recorded manual operator procedure.
+    Operator,
+}
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(rename_all = "lowercase")]
+pub enum CheckResult {
+    Pass,
+    Fail,
+    Blocked,
+}
+
+#[derive(Clone, Debug, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct NativeApp {
+    pub bundle: String,
+    pub identifier: String,
+    pub executable_sha256: String,
+    pub fixture: bool,
+}
+
+#[derive(Clone, Debug, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct NativeCheck {
+    pub id: String,
+    pub description: String,
+    pub result: CheckResult,
+    pub observation: String,
+    pub evidence: Vec<String>,
+}
+
+#[derive(Clone, Debug, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct NativeAcceptance {
+    pub schema: String,
+    pub subject: String,
+    pub recorded_utc: String,
+    pub method: Method,
+    pub performed_by: String,
+    pub host: String,
+    pub app: NativeApp,
+    pub checks: Vec<NativeCheck>,
+    pub limitations: Vec<String>,
+}
+
+impl NativeAcceptance {
+    pub fn parse(bytes: &[u8]) -> Result<Self> {
+        let record: Self = serde_json::from_slice(bytes)
+            .map_err(|e| invalid(format!("native acceptance record is malformed: {e}")))?;
+        if record.schema != NATIVE_SCHEMA {
+            return Err(invalid("native acceptance record has the wrong schema"));
+        }
+        Ok(record)
+    }
+
+    /// Reasons this record cannot count as native acceptance for `app_sha256`.
+    pub fn failures(&self, subject: &str, app_sha256: &str) -> Vec<String> {
+        let mut reasons = Vec::new();
+        if self.subject != subject {
+            reasons.push(format!(
+                "native record is for {} not {subject}",
+                self.subject
+            ));
+        }
+        if self.app.executable_sha256 != app_sha256 {
+            reasons.push("native record does not name the prepared fixture executable".to_owned());
+        }
+        if !self.app.fixture {
+            reasons.push("native fixture acceptance must use the fixture identity".to_owned());
+        }
+        if self.checks.is_empty() {
+            reasons.push("native record contains no checks".to_owned());
+        }
+        for check in &self.checks {
+            if check.result != CheckResult::Pass {
+                reasons.push(format!("native check {} is {:?}", check.id, check.result));
+            }
+        }
+        reasons
+    }
+}
diff --git a/crates/xtask/src/fingerprint.rs b/crates/xtask/src/fingerprint.rs
new file mode 100644
index 0000000..714a07f
--- /dev/null
+++ b/crates/xtask/src/fingerprint.rs
@@ -0,0 +1,280 @@
+//! Input fingerprints bound into review packets and receipts.
+//!
+//! * source: every tracked or untracked-but-not-ignored file (path, mode,
+//!   content or symlink target) plus the repository `.git/config`, minus a
+//!   narrow set of mutable evidence locations that are hashed separately.
+//! * dependencies: lockfiles, toolchain pin, the consumed immutable inputs
+//!   under `.inputs/`, and the resolved build-tool identities.
+//! * build_flags: the subject's manifest entries, Tauri configuration and
+//!   capability files, target and fixture-feature policy.
+//! * evidence: the subject's committed evidence directory.
+
+use std::collections::BTreeMap;
+use std::os::unix::fs::PermissionsExt;
+use std::path::Path;
+use std::process::Command;
+
+use serde::{Deserialize, Serialize};
+
+use crate::manifest::Manifest;
+use crate::{Repo, Result, Subject, invalid, io_err, sha256_hex};
+
+/// Mutable locations excluded from the source fingerprint. Each is hashed
+/// independently (evidence fingerprint, receipts) so exclusion cannot hide
+/// application sources, lockfiles, tests or configuration.
+pub const SOURCE_EXCLUSIONS: [&str; 3] = [
+    "docs/planning/status.md",
+    "docs/planning/reviews/",
+    "docs/planning/evidence/",
+];
+
+#[derive(Clone, Debug, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct Fingerprints {
+    pub source: String,
+    pub dependencies: String,
+    pub build_flags: String,
+    pub evidence: String,
+}
+
+/// One entry of the source inventory.
+#[derive(Clone, Debug, PartialEq, Eq, Serialize, Deserialize)]
+pub struct FileEntry {
+    pub path: String,
+    pub mode: String,
+    pub sha256: String,
+}
+
+pub fn is_excluded(path: &str) -> bool {
+    SOURCE_EXCLUSIONS.iter().any(|excluded| {
+        if excluded.ends_with('/') {
+            path.starts_with(excluded)
+        } else {
+            path == *excluded
+        }
+    })
+}
+
+/// Lists source files via git: tracked plus untracked files not ignored.
+pub fn source_inventory(repo: &Repo) -> Result<Vec<FileEntry>> {
+    let output = Command::new("/usr/bin/git")
+        .args([
+            "ls-files",
+            "-z",
+            "--cached",
+            "--others",
+            "--exclude-standard",
+        ])
+        .current_dir(repo.root())
+        .env_clear()
+        .env("PATH", "/usr/bin:/bin")
+        .env("HOME", std::env::var("HOME").unwrap_or_default())
+        .output()
+        .map_err(io_err(repo.root()))?;
+    if !output.status.success() {
+        return Err(invalid("git ls-files failed"));
+    }
+    let mut paths: Vec<String> = output
+        .stdout
+        .split(|b| *b == 0)
+        .filter(|p| !p.is_empty())
+        .map(|p| String::from_utf8_lossy(p).into_owned())
+        .filter(|p| !is_excluded(p))
+        .collect();
+    paths.sort();
+    paths.dedup();
+    let mut entries = Vec::with_capacity(paths.len() + 1);
+    for path in paths {
+        entries.push(file_entry(repo.root(), &path)?);
+    }
+    entries.push(file_entry(repo.root(), ".git/config")?);
+    Ok(entries)
+}
+
+fn file_entry(root: &Path, relative: &str) -> Result<FileEntry> {
+    let full = root.join(relative);
+    let Ok(meta) = std::fs::symlink_metadata(&full) else {
+        return Ok(FileEntry {
+            path: relative.to_owned(),
+            mode: "deleted".to_owned(),
+            sha256: String::new(),
+        });
+    };
+    if meta.file_type().is_symlink() {
+        let target = std::fs::read_link(&full).map_err(io_err(&full))?;
+        return Ok(FileEntry {
+            path: relative.to_owned(),
+            mode: "symlink".to_owned(),
+            sha256: sha256_hex(target.as_os_str().as_encoded_bytes()),
+        });
+    }
+    let bytes = std::fs::read(&full).map_err(io_err(&full))?;
+    let executable = meta.permissions().mode() & 0o111 != 0;
+    Ok(FileEntry {
+        path: relative.to_owned(),
+        mode: if executable { "100755" } else { "100644" }.to_owned(),
+        sha256: sha256_hex(&bytes),
+    })
+}
+
+pub fn inventory_hash(entries: &[FileEntry]) -> String {
+    let text: String = entries
+        .iter()
+        .map(|e| format!("{}\0{}\0{}\n", e.path, e.mode, e.sha256))
+        .collect();
+    sha256_hex(text.as_bytes())
+}
+
+pub fn source(repo: &Repo) -> Result<String> {
+    Ok(inventory_hash(&source_inventory(repo)?))
+}
+
+/// Hash of every regular file under a directory (relative paths, sorted).
+pub fn tree_hash(dir: &Path) -> Result<String> {
+    let mut entries = Vec::new();
+    collect_tree(dir, dir, &mut entries)?;
+    entries.sort_by(|a, b| a.path.cmp(&b.path));
+    Ok(inventory_hash(&entries))
+}
+
+fn collect_tree(root: &Path, dir: &Path, out: &mut Vec<FileEntry>) -> Result<()> {
+    let mut children: Vec<_> = std::fs::read_dir(dir)
+        .map_err(io_err(dir))?
+        .filter_map(|e| e.ok())
+        .collect();
+    children.sort_by_key(|e| e.file_name());
+    for child in children {
+        let path = child.path();
+        let relative = path
+            .strip_prefix(root)
+            .map_err(|_| invalid("path escaped its root"))?
+            .to_string_lossy()
+            .into_owned();
+        let meta = std::fs::symlink_metadata(&path).map_err(io_err(&path))?;
+        if meta.is_dir() {
+            collect_tree(root, &path, out)?;
+        } else {
+            out.push(file_entry(root, &relative)?);
+        }
+    }
+    Ok(())
+}
+
+/// Dependency inputs: lockfiles, toolchain pin, immutable inputs, tools.
+pub fn dependencies(repo: &Repo, toolchain_hash: &str) -> Result<String> {
+    let mut parts: BTreeMap<String, String> = BTreeMap::new();
+    for file in [
+        "Cargo.lock",
+        "pnpm-lock.yaml",
+        "rust-toolchain.toml",
+        ".npmrc",
+        "docs/architecture/inputs.lock.json",
+    ] {
+        let path = repo.join(file);
+        let digest = match std::fs::read(&path) {
+            Ok(bytes) => sha256_hex(&bytes),
+            Err(_) => "absent".to_owned(),
+        };
+        parts.insert(file.to_owned(), digest);
+    }
+    let inputs = repo.join(".inputs");
+    if inputs.is_dir() {
+        let mut names: Vec<_> = std::fs::read_dir(&inputs)
+            .map_err(io_err(&inputs))?
+            .filter_map(|e| e.ok())
+            .filter(|e| e.path().is_dir())
+            .map(|e| e.file_name().to_string_lossy().into_owned())
+            .collect();
+        names.sort();
+        for name in names {
+            parts.insert(format!(".inputs/{name}"), tree_hash(&inputs.join(&name))?);
+        }
+    }
+    parts.insert("toolchain".to_owned(), toolchain_hash.to_owned());
+    Ok(sha256_hex(
+        serde_json::to_string(&parts).unwrap_or_default().as_bytes(),
+    ))
+}
+
+/// Build flags: the subject's manifest entries and native configuration.
+pub fn build_flags(repo: &Repo, manifest: &Manifest, subject: Subject) -> Result<String> {
+    let mut parts: BTreeMap<String, String> = BTreeMap::new();
+    let chunks = if subject.is_phase() {
+        manifest.phase_chunks(subject)?
+    } else {
+        vec![subject]
+    };
+    for chunk in chunks {
+        let entry = manifest.chunk(chunk)?;
+        parts.insert(
+            format!("chunk/{chunk}"),
+            format!(
+                "{:?}|{:?}|{:?}|{:?}",
+                entry.fixture_command,
+                entry.native_prepare,
+                entry.host_commands,
+                entry.frontend_commands
+            ),
+        );
+    }
+    parts.insert(
+        "common".to_owned(),
+        format!("{:?}", manifest.common_commands),
+    );
+    parts.insert(
+        "shared".to_owned(),
+        format!("{:?}", manifest.shared_source_commands),
+    );
+    parts.insert(
+        "artifact".to_owned(),
+        format!("{:?}", manifest.artifact_build),
+    );
+    parts.insert("target".to_owned(), manifest.target.clone());
+    parts.insert(
+        "fixture_only".to_owned(),
+        format!("{:?}", manifest.fixture_only_features),
+    );
+    parts.insert(
+        "production_features".to_owned(),
+        format!("{:?}", manifest.requested_production_features),
+    );
+    for file in [
+        "apps/desktop/src-tauri/tauri.conf.json",
+        "apps/desktop/src-tauri/tauri.fixture.conf.json",
+        "apps/desktop/src-tauri/capabilities/main.json",
+        "apps/desktop/src-tauri/Cargo.toml",
+        "Cargo.toml",
+    ] {
+        let digest = std::fs::read(repo.join(file))
+            .map(|b| sha256_hex(&b))
+            .unwrap_or_else(|_| "absent".to_owned());
+        parts.insert(file.to_owned(), digest);
+    }
+    Ok(sha256_hex(
+        serde_json::to_string(&parts).unwrap_or_default().as_bytes(),
+    ))
+}
+
+/// Evidence: the subject's committed evidence directory (empty if absent).
+pub fn evidence(repo: &Repo, subject: Subject) -> Result<String> {
+    let dir = repo.evidence_dir(subject);
+    if dir.is_dir() {
+        tree_hash(&dir)
+    } else {
+        Ok(sha256_hex(b""))
+    }
+}
+
+pub fn all(
+    repo: &Repo,
+    manifest: &Manifest,
+    subject: Subject,
+    toolchain_hash: &str,
+) -> Result<Fingerprints> {
+    Ok(Fingerprints {
+        source: source(repo)?,
+        dependencies: dependencies(repo, toolchain_hash)?,
+        build_flags: build_flags(repo, manifest, subject)?,
+        evidence: evidence(repo, subject)?,
+    })
+}
diff --git a/crates/xtask/src/gate.rs b/crates/xtask/src/gate.rs
new file mode 100644
index 0000000..1079688
--- /dev/null
+++ b/crates/xtask/src/gate.rs
@@ -0,0 +1,591 @@
+//! Review packets, receipts and the completion gate.
+//!
+//! The gate never trusts a single summary. It re-derives the decision from the
+//! immutable packet, the reviewer-authored verdict (hash-bound), the run and
+//! native evidence the packet names, and the inputs as they exist now.
+
+use std::path::{Path, PathBuf};
+
+use serde::{Deserialize, Serialize};
+
+use crate::evidence::NativeAcceptance;
+use crate::fingerprint::Fingerprints;
+use crate::runner::{RunKind, RunRecord, Status};
+use crate::verdict::{Scores, Verdict};
+use crate::{Result, invalid, io_err, sha256_hex};
+
+pub const PACKET_SCHEMA: &str = "airs-v2/review-request/1";
+pub const RECEIPT_SCHEMA: &str = "airs-v2/review-receipt/1";
+pub const MINIMUM_SCORE: u8 = 9;
+
+#[derive(Clone, Debug, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
