/** The v2 screens' shared 32px controls (C38 made them for the Harness panels; C39 shares them). */
export { Btn, Field } from './harness/panels/controls'
import type { Intent, Refusal } from '@prisma-airs/desktop-contracts'

/** What the presentation learned about one delivered intent. */
export type DispatchOutcome =
    /** Admitted; `operation` names native work the intent started, if any. */
    | { kind: 'admitted'; operation: string | null }
    | { kind: 'refused'; refusal: Refusal }
    /** The desktop did not confirm admission; the current state is shown. */
    | { kind: 'unknown' }
    | { kind: 'failed' }

export type Dispatch = (intent: Intent) => Promise<DispatchOutcome>

const REFUSAL_TEXT: Record<Refusal, string> = {
    staleContext: 'The active tenant changed before this was applied. Check the current tenant and try again.',
    capabilityMissing: 'That is not available for the current tenant.',
    invalidInput: 'Check the entered values and try again.',
    reviewInvalid: 'This review is no longer valid. Start a new review.',
    reviewConsumed: 'This review was already used.',
    busy: 'The desktop is busy with a previous request. Try again in a moment.',
    lockedStore: 'The Keychain is locked. Unlock it and try again.',
    deniedStore: 'Local desktop data or the credential store is not available.',
    alreadyProcessed: 'That request was already processed.',
    sequenceGap: 'The request was not delivered in order. Try again.',
    shuttingDown: 'The desktop is shutting down.',
    decisionPending: 'A Harness decision is pending; resolve it before switching tenants.',
}

/** Sanitized operator text for an outcome that did not apply. */
export function outcomeMessage(outcome: DispatchOutcome): string | null {
    switch (outcome.kind) {
        case 'admitted':
            return null
        case 'refused':
            return REFUSAL_TEXT[outcome.refusal]
        case 'unknown':
            return 'The desktop did not confirm the request. The current state is shown; check it before trying again.'
        case 'failed':
            return 'The request could not be delivered.'
    }
}
import type {
    Outcome,
    ProfileSelector,
    ScanDraft,
    ScanFailureKind,
    ScanRecordView,
    StopReason,
    Verdict,
} from '@prisma-airs/desktop-contracts'

/** Per-text ceiling (UTF-8 bytes), matching the native admission check. */
export const MAX_TEXT_BYTES = 2 * 1024 * 1024
/** Whole-request ceiling (escaped JSON bytes plus envelope allowance). */
export const MAX_REQUEST_BYTES = 8 * 1024 * 1024
const ENVELOPE_BYTES = 16 * 1024
const MAX_PROFILE_NAME = 100
const MAX_APP_NAME = 256
const UUID = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i

const CONTROL = /[\u0000-\u001f\u007f-\u009f]/
const encoder = new TextEncoder()
const bytes = (text: string): number => encoder.encode(text).length
const escapedBytes = (text: string): number => bytes(JSON.stringify(text))

export interface ScanInput {
    profileKind: 'name' | 'id'
    profile: string
    prompt: string
    response: string
    appName: string
}

/**
 * Builds the draft from input captured at submission, or explains why it
 * cannot be sent. The native side re-checks every limit at admission.
 */
export function draftFrom(input: ScanInput): { draft: ScanDraft } | { problem: string; field: keyof ScanInput } {
    const profile = input.profile.trim()
    if (profile.length === 0) return { problem: 'Choose the AI security profile for this scan.', field: 'profile' }
    let selector: ProfileSelector
    if (input.profileKind === 'name') {
        if (profile.length > MAX_PROFILE_NAME || CONTROL.test(profile)) {
            return { problem: `Profile names are at most ${MAX_PROFILE_NAME} characters, on one line.`, field: 'profile' }
        }
        selector = { kind: 'name', name: profile }
    } else {
        if (!UUID.test(profile)) return { problem: 'A profile ID is a UUID, for example 1b2c…-….', field: 'profile' }
        selector = { kind: 'id', id: profile.toLowerCase() }
    }
    if (input.prompt.trim().length === 0 && input.response.trim().length === 0) {
