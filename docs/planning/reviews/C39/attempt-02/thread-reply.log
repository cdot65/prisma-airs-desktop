const CLIENT_ID: &str = "synthetic-client@1234567890.iam.panserviceaccount.com";
const CLIENT_SECRET: &str = "synthetic-client-secret-c39";
const TSG: &str = "1234567890";

/// The synthetic plane: a chart of `buckets` (violating counts; each bucket
/// reports a breakdown totalling its violating count unless `no_breakdown`),
/// an API key inventory, and the other products' sources answering plainly.
struct Script {
    buckets: Vec<u32>,
    no_breakdown: bool,
    chart_status: u16,
    keys: Vec<Value>,
}

impl Script {
    fn route(&mut self, seen: &Seen) -> Reply {
        let target = seen.request_line.split(' ').nth(1).unwrap_or("").to_owned();
        let path = target.split('?').next().unwrap_or("").to_owned();
        if path == "/oauth2/access_token" {
            return raw(
                200,
                &json!({"access_token": "mgmt-access", "token_type": "Bearer", "expires_in": 3600}),
            );
        }
        if path == "/aisec/v1/mgmt/dashboard/v2/sessions/sessionschart" {
            let buckets: Vec<Value> = self
                .buckets
                .iter()
                .enumerate()
                .map(|(i, v)| {
                    let mut b = json!({"time": format!("2026-10-19T{:02}:00:00Z", i), "total": 10 + v, "violating": v});
                    if !self.no_breakdown {
                        b["detection_type_violation_breakdown"] =
                            json!([{"detection_type": "pi", "violation_breakdown": {"total": v}}]);
                    }
                    b
                })
                .collect();
            return raw(
                self.chart_status,
                &json!({"bucket_size_seconds": 3600, "buckets": buckets}),
            );
        }
        if path == format!("/aisec/v1/mgmt/topics/tsg/{TSG}") {
            return raw(
                200,
                &json!({"custom_topics": [
                    {"topic_id": "11111111-1111-4111-8111-111111111111", "topic_name": "competitor-pricing",
                     "description": "Questions about competitor pricing", "revision": 3},
                    {"topic_id": "22222222-2222-4222-8222-222222222222", "topic_name": "medical-advice",
                     "description": "Requests for diagnosis or treatment", "revision": 5}]}),
            );
        }
        if path == format!("/aisec/v1/mgmt/apikeys/tsg/{TSG}") {
            let keys: Vec<Value> = self
                .keys
                .iter()
                .map(|k| {
                    let mut k = k.clone();
                    for (field, value) in [
                        ("api_key_last8", json!("abcd1234")),
                        ("auth_code", json!("SYNTHETIC-AUTH-CODE")),
                        ("cust_app", json!("Support bot")),
                        ("revoked", json!(false)),
                    ] {
                        if k.get(field).is_none() {
                            k[field] = value;
                        }
                    }
                    k
                })
                .collect();
            return raw(200, &json!({"api_keys": keys}));
        }
        if path == "/ai-red-teaming/data-plane/v1/dashboard/scan-statistics" {
            return raw(
                200,
                &json!({"total_scans": 3, "targets_scanned": 2,
                    "scan_status": [{"name": "COMPLETED", "count": 3}],
                    "risk_profile": [{"risk_rating": "LOW", "total": 2}],
                    "targets_scanned_by_type": [{"name": "APPLICATION", "count": 2}]}),
            );
        }
        if path == "/ai-red-teaming/data-plane/v1/scan" {
            return raw(
                200,
                &json!({"data": [{"uuid": "00000001-2222-4333-8444-555555555555", "status": "COMPLETED",
                    "job_type": "STATIC", "target_id": "66666666-7777-4888-8999-aaaaaaaaaaaa",
                    "target_type": "APPLICATION", "created_at": "2026-10-18T10:00:00Z"}],
                    "pagination": {"total_items": 1}}),
            );
        }
        if path == "/aims/data/v1/scans" {
            return raw(
                200,
                &json!({"scans": [{"uuid": "00000001-3333-4333-8444-555555555555", "eval_outcome": "ALLOWED",
                    "created_at": "2026-10-18T10:00:00Z"}], "pagination": {"total_items": 1}}),
            );
        }
        if path == "/aiag/data/v1/stats/scans" {
            return raw(
                200,
                &json!({"unique_skills_scanned": {"count": 1, "percent_change": null},
                    "total_vulnerabilities_found": {"count": 0, "percent_change": null},
                    "top_vulnerability": null}),
            );
        }
        if path == "/aiag/data/v1/scans" {
            return raw(
                200,
                &json!({"scans": [{"uuid": "00000001-4444-4333-8444-555555555555", "name": "AG-PRIVATE-SKILL",
                    "status": "COMPLETED", "eval_outcome": "ALLOWED", "artifact_type": "skill",
                    "summary": {"vulnerability_count": 0, "attack_chain_count": 0},
                    "created_at": "2026-10-18T10:00:00Z"}], "pagination": {"total_items": 1}}),
            );
        }
        raw(404, &json!({"error": "not found"}))
    }
}

fn raw(status: u16, body: &Value) -> Reply {
    let body = serde_json::to_vec(body).expect("json");
    Reply::Raw {
        head: format!(
            "HTTP/1.1 {status} Status\r\ncontent-type: application/json\r\ncontent-length: {}\r\nconnection: close",
            body.len()
        ),
        body,
    }
}

struct Desk {
    _core: Core,
    handle: AuthorityHandle,
    session: String,
    sequence: u64,
    _adapters: Handles,
    #[allow(dead_code)]
    script: Arc<Mutex<Script>>,
    _server: TlsServer,
}

async fn desk(buckets: Vec<u32>) -> Desk {
    let ca = TestCa::new("airs-v2 c39 ca");
    let script = Arc::new(Mutex::new(Script {
        buckets,
        no_breakdown: false,
        chart_status: 200,
        keys: vec![],
    }));
    let routed = Arc::clone(&script);
    let server = TlsServer::start(
        ca.leaf(&["localhost"]),
        Reply::Route(Arc::new(move |seen| {
            routed.lock().expect("script").route(seen)
        })),
    )
    .await;
    let origin = format!("https://localhost:{}", server.port);
    let (adapters, handles) = fixtures::adapters();
    let config = CoreConfig {
        management: ManagementEndpoints::at_origin(&origin),
        deadline_tick: Duration::from_millis(100),
        ..CoreConfig::default()
    };
    let core = Core::new(config, adapters);
    core.start();
    core.set_transport_policy(TransportPolicy {
        revision: 2,
        proxy: ProxyMode::Direct,
        extra_roots: vec![ca.pem.as_bytes().to_vec()],
    })
    .expect("policy");
    let handle = core.operator();
    let session = handle.register_delivery_session().expect("session").nonce;
    let mut desk = Desk {
        _core: core,
        handle,
        session,
        sequence: 0,
        _adapters: handles,
        script,
        _server: server,
    };
    desk.send(
        json!({"kind": "createTenant", "profile": {"label": "Northwind Health", "tsgId": TSG,
        "destination": {"kind": "custom", "origin": origin}}}),
    )
    .await
    .expect("tenant");
    let id = desk.snap().tenants[0].id.as_str().to_owned();
    desk.send(json!({"kind": "selectTenant", "tenant": id}))
        .await
        .expect("selected");
    let context = desk.context();
    desk.send(
        json!({"kind": "configureManagementCredential", "context": context, "mode": "keychain",
        "clientId": CLIENT_ID, "secret": CLIENT_SECRET}),
    )
    .await
    .expect("management key");
    assert!(
        eventually(|| desk
            .snap()
            .tenants
            .iter()
            .any(|t| t.management.state == ScanState::Ready))
        .await
    );
    desk
}

impl Desk {
    async fn send(&mut self, intent: Value) -> Result<Receipt, Refusal> {
        let intent: Intent = serde_json::from_value(intent).expect("intent");
        self.sequence += 1;
        self.handle
            .dispatch(
                Delivery {
                    session: self.session.clone(),
                    sequence: self.sequence,
                },
                intent,
            )
            .await
    }

    fn snap(&self) -> ShellSnapshot {
        match self.handle.observe(ViewScope::Shell).expect("observe") {
            Observation::Shell { snapshot, .. } => snapshot,
            _ => unreachable!("shell scope"),
        }
    }

    fn context(&self) -> String {
        self.snap()
            .active
            .expect("active")
            .context
            .as_str()
            .to_owned()
    }

    #[allow(dead_code)]
    fn script(&self) -> std::sync::MutexGuard<'_, Script> {
        self.script.lock().expect("script")
    }

    /// `readTenant`, waited to completion.
    async fn read(&mut self) -> ShellSnapshot {
        let context = self.context();
        let before = self.snap().inbox.read.generation;
        self.send(json!({"kind": "readTenant", "context": context}))
            .await
            .expect("read admitted");
        assert!(
            eventually(|| {
                let s = self.snap();
                s.inbox.read.generation != before && !s.overview.refreshing
            })
            .await,
            "the read completed"
        );
        self.snap()
    }
}

#[tokio::test(flavor = "multi_thread")]
async fn the_inventory_lists_the_products_and_runtime_tabs_the_board_draws() {
    let mut desk = desk(vec![0, 1]).await;
    // The inventory is the v2 shell's (the legacy shell carries none).
    desk.send(json!({"kind": "setUiVariant", "variant": "v2"}))
        .await
        .expect("v2");
    let snap = desk.read().await;
    let inventory = snap.administration.expect("inventory");
    let ids: Vec<String> = inventory
        .products
        .iter()
        .map(|p| {
            serde_json::to_value(p.id)
                .expect("id")
                .as_str()
                .expect("str")
                .to_owned()
        })
        .collect();
    assert_eq!(
        ids,
        [
            "runtimeSecurity",
            "gateway",
            "redTeam",
            "modelSkill",
            "agenticIdentity",
            "agenticEndpoint"
        ]
    );
    let runtime = &inventory.products[0];
    let tabs: Vec<&str> = runtime.tabs.iter().map(|t| t.label.as_str()).collect();
    assert_eq!(
        tabs,
        [
            "Overview",
            "Playground",
            "Security profiles",
            "Custom topics",
            "Applications",
            "API keys",
            "DLP",
            "Deployment profiles"
        ]
    );
    assert!(!runtime.read_only);
    for p in &inventory.products[4..] {
        assert!(
            matches!(
                serde_json::to_value(&p.availability).expect("availability")["state"].as_str(),
                Some("unavailable")
            ),
            "{:?}",
            p.label
        );
    }
    // Read-only products say so to the card (the header's label).
    assert!(inventory.products[2].read_only && inventory.products[3].read_only);
}

#[tokio::test(flavor = "multi_thread")]
async fn the_overview_tiles_and_bars_come_from_one_read_and_the_pill_from_its_state() {
    let mut desk = desk(vec![0, 2, 1, 4, 0, 0]).await;
    let snap = desk.read().await;
    let read = snap.overview.read.expect("a read");
    assert_eq!(read.summary.detection_events, Some(7));
    assert_eq!(read.summary.violating, Some(7));
    assert_eq!(read.summary.sessions, Some(67));
    let chart = read.chart.expect("chart");
    let violating: Vec<u32> = chart.buckets.iter().map(|b| b.violating).collect();
    assert_eq!(violating, [0, 2, 1, 4, 0, 0]);
    assert!(read.keys_complete && read.keys_failure.is_none());
    let runtime = snap
        .inbox
        .read
        .products
        .iter()
        .find(|p| p.product == ProductId::RuntimeSecurity)
        .expect("runtime read");
    assert_eq!(runtime.state, ProductReadState::Ok);
    assert_eq!(snap.inbox.read.state, ReadState::Done);
}

#[tokio::test(flavor = "multi_thread")]
async fn a_page_read_of_custom_topics_is_the_table_rows() {
    let mut desk = desk(vec![0]).await;
    let context = desk.context();
    let Receipt::Admitted {
        operation: Some(operation),
        ..
    } = desk
        .send(json!({"kind": "management", "context": context,
            "request": {"kind": "page", "resource": "topics", "offset": 0, "limit": 25}}))
        .await
        .expect("read admitted")
    else {
        panic!("no operation");
    };
    let Ok(Observation::Management(handle)) = desk.handle.observe(ViewScope::Management(operation))
    else {
        panic!("management observation");
    };
    let result = tokio::time::timeout(Duration::from_secs(20), handle.result())
        .await
        .expect("read settles");
    let result = serde_json::to_value(result).expect("result");
    assert_eq!(result["kind"], "page");
    let page = &result["page"];
    assert_eq!(page["resource"], "topics");
    assert_eq!(page["count"], 2);
    assert_eq!(page["complete"], true);
    let items: Value = serde_json::from_str(page["items"].as_str().expect("items")).expect("json");
    let names: Vec<&str> = items
        .as_array()
        .expect("array")
        .iter()
        .filter_map(|i| i["topic_name"].as_str())
        .collect();
    assert_eq!(names, ["competitor-pricing", "medical-advice"]);
    assert_eq!(items[0]["topic_id"], "11111111-1111-4111-8111-111111111111");
    assert_eq!(items[0]["revision"], 3);
}
/**
 * DLP authoring on the one presentation (C44): the C10 suite's assertions,
 * reached as the v2 shell reaches them (Administration, the Runtime card's
 * DLP tab and its inventory radios; the review sheet hosts the change
 * workbench). v1's actions per inventory, the dictionary draft from typed
 * keywords, a chosen file by its token only, the whole-list replace on edit,
 * typed keywords kept when a choice is cancelled or fails, and metadata that
 * must be one JSON object.
 */
import { render, screen, within } from '@testing-library/react'
import userEvent from '@testing-library/user-event'
import { describe, expect, it } from 'vitest'
import { DesktopClient, type Intent, type ManagementResource, type ManagementResult, type ShellSnapshot, type StagedFileView } from '@prisma-airs/desktop-contracts'
import { App } from '../../app'
import { type Native, scriptedNative, tenant } from '../../test/native'
import { fxSwitcher } from '../fixtures'

const CONTEXT = 'cx-aaaaaaaaaaaaaaaaaaaaaaaa'
const ITEMS: Partial<Record<ManagementResource, Record<string, unknown>[]>> = {
    dataPatterns: [{ id: 'pattern-1', name: 'Card numbers', type: 'custom' }],
    dataProfiles: [{ id: 'dp-1', name: 'PCI', detection_rules: [] }],
    filteringProfiles: [{ id: 'filter-1', name: 'Default', file_based: true, non_file_based: false }],
    dictionaries: [{ id: 'dict-1', name: 'Codes', original_file_name: 'codes.txt', category: 'Confidential', region_name: 'United States' }],
    deploymentProfiles: [{ dp_name: 'dp-0', status: 'active' }],
}

/** Administration's tenant with a ready management client (the v2 switcher fixture carries the product cards and their tabs). */
const ready = (staged: StagedFileView | null = null): ShellSnapshot => {
    const base = fxSwitcher()
    const nw = tenant({
        id: 'tn-0123456789abcdef',
        label: 'Northwind Health',
        tsgId: '1762204418',
        scan: { state: 'ready', mode: 'keychain', failure: null },
        management: {
            state: 'ready',
            mode: 'keychain',
            failure: null,
            clientId: 'svc@1762204418.iam.panserviceaccount.com',
            tokenOrigin: 'https://auth.apps.paloaltonetworks.com',
        },
    })
    return { ...base, tenants: [nw, base.tenants[1]!], active: { tenant: nw.id, context: CONTEXT }, activeFeature: 'administration', changes: { review: null, staged, results: [] } }
}

function service(native: Native) {
    const requests = new Map<string, Extract<Intent, { kind: 'management' }>['request']>()
    const respond = native.respond
    native.respond = (intent: Intent) => {
        if (intent.kind === 'management') {
            const operation = `op-${requests.size + 1}`
            requests.set(operation, intent.request)
            return { outcome: 'receipt', receipt: { kind: 'admitted', request: `rq-${requests.size}`, operation } }
        }
        return respond(intent)
    }
    native.observeManagement = (operation): { kind: 'management'; result: ManagementResult } => {
        const request = requests.get(operation)
        if (request?.kind === 'page') {
            const items = ITEMS[request.resource] ?? []
            return {
                kind: 'management',
                result: {
                    kind: 'page',
                    page: { resource: request.resource, offset: 0, limit: 25, items: JSON.stringify(items), count: items.length, nextOffset: null, complete: true, total: null },
                },
            }
        }
        const detail = request?.kind === 'detail' ? request : null
        const item = (ITEMS[detail?.resource ?? 'dataPatterns'] ?? []).find((i) => i.id === detail?.id) ?? {}
        return {
            kind: 'management',
            result: { kind: 'detail', detail: { resource: detail?.resource ?? 'dataPatterns', id: detail?.id ?? '', found: 'found', item: JSON.stringify(item) } },
        }
    }
}

const DLP_RESOURCES = ['Data patterns', 'Data profiles', 'Data filtering profiles', 'Dictionaries']

/** Administration as the v2 shell reaches it: the Runtime card (open first) with its DLP tab and the inventory chosen in it. */
async function openInventory(native: Native, label: string) {
    const user = userEvent.setup()
    render(<App client={new DesktopClient(native.transport)} />)
    await screen.findByRole('heading', { level: 1, name: 'Administration' })
    await chooseInventory(user, label)
    return user
}

async function chooseInventory(user: ReturnType<typeof userEvent.setup>, label: string) {
    if (DLP_RESOURCES.includes(label)) {
        await user.click(await screen.findByRole('tab', { name: 'DLP' }))
        await user.click(await within(await screen.findByRole('radiogroup', { name: 'DLP inventory' })).findByRole('radio', { name: label }))
    } else {
        await user.click(await screen.findByRole('tab', { name: label }))
    }
}

const sent = (native: Native, kind: Intent['kind']) => native.dispatched.filter((i) => i.kind === kind)

describe('DLP authoring', () => {
    it('offers exactly v1’s actions per inventory', async () => {
        const native = scriptedNative(ready())
        service(native)
        const user = await openInventory(native, 'Data patterns')
        expect(screen.getByRole('button', { name: /^New data pattern/ })).toBeInTheDocument()
        await user.click(await screen.findByRole('button', { name: 'Details for Card numbers' }))
        expect(await screen.findByRole('button', { name: 'Edit…' })).toBeInTheDocument()
        expect(screen.getByRole('button', { name: 'Delete…' })).toBeInTheDocument()
        // Data profiles: create and edit, never delete.
        await chooseInventory(user, 'Data profiles')
        expect(await screen.findByRole('button', { name: /^New data profile/ })).toBeInTheDocument()
        await user.click(await screen.findByRole('button', { name: 'Details for PCI' }))
        expect(await screen.findByRole('button', { name: 'Edit…' })).toBeInTheDocument()
        expect(screen.queryByRole('button', { name: 'Delete…' })).toBeNull()
        // Filtering profiles: edit only.
        await chooseInventory(user, 'Data filtering profiles')
        expect(screen.queryByRole('button', { name: /^New / })).toBeNull()
        await user.click(await screen.findByRole('button', { name: 'Details for Default' }))
        expect(await screen.findByRole('button', { name: 'Edit…' })).toBeInTheDocument()
        expect(screen.queryByRole('button', { name: 'Delete…' })).toBeNull()
        // Deployment profiles stay read-only.
        await chooseInventory(user, 'Deployment profiles')
        expect(await screen.findByRole('tab', { name: 'Deployment profiles' })).toHaveAttribute('aria-selected', 'true')
        expect(screen.queryByRole('button', { name: /^New / })).toBeNull()
    })

    it('builds a dictionary draft from the metadata and typed keywords when Review is pressed', async () => {
        const native = scriptedNative(ready())
        service(native)
        const user = await openInventory(native, 'Dictionaries')
        await user.click(screen.getByRole('button', { name: /^New dictionary/ }))
        const metadata = screen.getByLabelText('dictionary metadata (JSON)') as HTMLTextAreaElement
        const keywords = screen.getByLabelText('Dictionary keywords, one per line') as HTMLTextAreaElement
        expect(JSON.parse(metadata.value)).toMatchObject({ name: 'New dictionary', original_file_name: 'keywords.txt' })
        await user.clear(keywords)
        await user.type(keywords, 'alpha{Enter}beta')
        await user.click(screen.getByRole('button', { name: 'Review change' }))
        const prepare = sent(native, 'reviewChange')[0] as Extract<Intent, { kind: 'reviewChange' }>
        expect(prepare.draft.kind).toBe('dictionaries')
        expect(JSON.parse(prepare.draft.body)).toEqual({ metadata: JSON.parse(metadata.value), file: 'alpha\nbeta' })
    })

    it('references a file chosen in the native sheet by its token only', async () => {
        const native = scriptedNative(ready())
        service(native)
        const user = await openInventory(native, 'Dictionaries')
        await user.click(screen.getByRole('button', { name: /^New dictionary/ }))
        const useFile = screen.getByRole('radio', { name: /Use the chosen file/ })
        expect(useFile).toBeDisabled()
        await user.click(screen.getByRole('button', { name: 'Choose keyword file…' }))
        expect(sent(native, 'chooseDictionaryFile')).toEqual([{ kind: 'chooseDictionaryFile', context: CONTEXT }])
        await native.push(ready({ state: 'failed', token: null, name: null, bytes: null, lines: null, failure: 'notText' }))
        expect(screen.getByText('That file is not UTF-8 text.')).toBeInTheDocument()
        await native.push(ready({ state: 'ready', token: 'sf-0011223344556677', name: 'keywords.txt', bytes: 17, lines: 3, failure: null }))
        expect(screen.getByText(/Chosen: keywords\.txt \(17 bytes\)/)).toBeInTheDocument()
        await user.click(screen.getByRole('radio', { name: /Use the chosen file \(keywords\.txt, 3 lines\)/ }))
        await user.click(screen.getByRole('button', { name: 'Review change' }))
        const prepare = sent(native, 'reviewChange')[0] as Extract<Intent, { kind: 'reviewChange' }>
        const body = JSON.parse(prepare.draft.body) as Record<string, unknown>
        expect(body.fileRef).toBe('sf-0011223344556677')
        expect(body).not.toHaveProperty('file')
        expect(native.sent.join('\n')).not.toMatch(/\/Users\/|\/private\//)
    })

    it('re-sends a dictionary’s whole keyword list when editing it (v1 replace)', async () => {
        const native = scriptedNative(ready())
        service(native)
        const user = await openInventory(native, 'Dictionaries')
        await user.click(await screen.findByRole('button', { name: 'Details for Codes' }))
        await user.click(await screen.findByRole('button', { name: 'Edit…' }))
        const metadata = JSON.parse((screen.getByLabelText('dictionary metadata (JSON)') as HTMLTextAreaElement).value) as Record<string, unknown>
        expect(metadata).toEqual({ name: 'Codes', original_file_name: 'codes.txt', category: 'Confidential', region_name: 'United States' })
        expect((screen.getByLabelText('Dictionary keywords, one per line') as HTMLTextAreaElement).value).toBe('')
    })

    it('keeps typed keywords in use when a file choice is cancelled or fails', async () => {
        const native = scriptedNative(ready())
        service(native)
        const user = await openInventory(native, 'Dictionaries')
        await user.click(screen.getByRole('button', { name: /^New dictionary/ }))
        const keywords = screen.getByLabelText('Dictionary keywords, one per line') as HTMLTextAreaElement
        await user.click(screen.getByRole('button', { name: 'Choose keyword file…' }))
        await native.push(ready({ state: 'choosing', token: null, name: null, bytes: null, lines: null, failure: null }))
        // The sheet was cancelled: nothing staged.
        await native.push(ready(null))
        expect(screen.getByRole('radio', { name: /Type them/ })).toBeChecked()
        expect(screen.getByRole('radio', { name: /Use the chosen file/ })).not.toBeChecked()
        expect(keywords).toBeEnabled()
        await user.clear(keywords)
        await user.type(keywords, 'typed')
        await user.click(screen.getByRole('button', { name: 'Review change' }))
        const prepare = sent(native, 'reviewChange')[0] as Extract<Intent, { kind: 'reviewChange' }>
        expect(JSON.parse(prepare.draft.body)).toMatchObject({ file: 'typed' })
        // A failed choice likewise leaves typing in use.
        await user.click(screen.getByRole('button', { name: 'Choose keyword file…' }))
        await native.push(ready({ state: 'failed', token: null, name: null, bytes: null, lines: null, failure: 'tooLarge' }))
        expect(keywords).toBeEnabled()
        expect(screen.getByRole('radio', { name: /Type them/ })).toBeChecked()
    })

    it('refuses metadata that is not exactly one JSON object without dispatching', async () => {
        const native = scriptedNative(ready())
        service(native)
        const user = await openInventory(native, 'Dictionaries')
        await user.click(screen.getByRole('button', { name: /^New dictionary/ }))
        const metadata = screen.getByLabelText('dictionary metadata (JSON)') as HTMLTextAreaElement
        await user.clear(metadata)
        await user.click(metadata)
        // A valid object followed by a top-level fragment must not be spliced.
        await user.paste('{"name":"N","original_file_name":"a.txt","category":"Confidential","region_name":"United States"},"file":"injected"')
        await user.click(screen.getByRole('button', { name: 'Review change' }))
        expect(screen.getByText('The dictionary metadata must be one JSON object.')).toBeInTheDocument()
        expect(sent(native, 'reviewChange')).toEqual([])
    })
})

