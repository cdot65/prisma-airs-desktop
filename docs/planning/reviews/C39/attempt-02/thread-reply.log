def run():
    global NATIVE
    prepared = json.load(open(os.path.join(EVIDENCE, "native-prepare.json")))
    bundle = os.path.join(ROOT, prepared["bundle"])
    exe = os.path.join(bundle, "Contents/MacOS/prisma-airs-desktop-v2")
    if c8.sha256(exe) != prepared["executable_sha256"]:
        raise SystemExit("prepared executable changed since native-prepare")
    work = tempfile.mkdtemp(prefix="airs-v2-c39-acceptance-")
    FINAL = NATIVE
    NATIVE = NATIVE + ".staging"
    if os.path.isdir(NATIVE):
        shutil.rmtree(NATIVE)
    os.makedirs(NATIVE)
    c29.NATIVE = NATIVE
    if os.path.isdir(c29.CAPTURES):
        shutil.rmtree(c29.CAPTURES)
    app = fx.App(bundle, work, LOG)
    c29._APP = app
    app.quit()
    fx.clean_fixture_root()
    time.sleep(1.5)
    endpoint = fx.ScanEndpoint(os.path.join(work, "endpoint"), c8.SCAN_KEY)
    endpoint.install_roots()
    endpoint.start()
    mgmt = c8.MgmtEndpoint(os.path.join(work, "endpoint"), os.path.join(work, "mgmt"))
    mgmt.install()
    mgmt.start()
    mgmt.mode()
    try:
        return exercise(app, endpoint, mgmt, prepared, FINAL)
    finally:
        endpoint.stop()
        mgmt.stop()
        shutil.rmtree(work, ignore_errors=True)



def ring_by_tab(app, prefix, name):
    """Ring pixels around the first control whose label starts with `prefix`, reached by Tab from Expand all
    (keyboard focus scrolls it into view); the plain capture has the control before it focused."""
    app.ax("focus", "AXButton", "Expand all")
    time.sleep(0.3)
    for _ in range(24):
        app.keycode(48)
        time.sleep(0.1)
        f = fx.App.focused(app.tree()) or {}
        if (f.get("label") or "").startswith(prefix):
            break
    else:
        return {"diff": 0, "focused": None, "reason": "not reached by Tab"}
    app.keycode(48, "shift down")
    time.sleep(0.4)
    plain_cap = c29.capture(app, f"{name}-plain")
    app.keycode(48)
    time.sleep(0.4)
    focused_cap = c29.capture(app, f"{name}-view")
    snap = app.tree()
    # The capture is the viewport (the page is scrolled to the View): the box is measured from the scroll area's
    # origin, not the web area's (the document, taller than the window), which put the box below the image.
    web = next((n for n in snap if n.get("role") == "AXScrollArea" and n.get("size") and n.get("pos")), None) or next((n for n in snap if n.get("role") == "AXWebArea"), None)
    btn = fx.App.focused(snap)
    if not (web and btn and btn.get("pos") and btn.get("size") and plain_cap and focused_cap and (btn.get("label") or "").startswith(prefix)):
        return {"diff": 0, "focused": (btn or {}).get("label")}
    img_f = c31.c1.png_pixels(os.path.join(ROOT, focused_cap))
    img_p = c31.c1.png_pixels(os.path.join(ROOT, plain_cap))
    scale = img_f[0] / web["size"][0]
    box = [btn["pos"][0] - web["pos"][0], btn["pos"][1] - web["pos"][1], btn["size"][0], btn["size"][1]]
    return {"diff": c28.ring_diff(img_f, img_p, box, scale), "focused": btn.get("label"), "capture": focused_cap, "plain": plain_cap}

