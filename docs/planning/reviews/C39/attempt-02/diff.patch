+                </button>
+            </h2>
+            {unavailable && product.availability.state === 'unavailable' ? (
+                <p data-slot='admin-product-gate' className='text-[13px]' style={{ padding: '0 22px 18px 72px', color: 'var(--v2-soft)' }}>
+                    {product.availability.reason}
+                </p>
+            ) : null}
