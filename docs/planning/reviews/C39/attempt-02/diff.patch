+                {tiles.map((t) => (
+                    <div key={t.label} className='rounded-[12px]' style={{ padding: '16px 18px', background: 'var(--v2-inset)' }} data-slot='admin-kpi'>
+                        <div className='text-[12px]' style={faint}>
