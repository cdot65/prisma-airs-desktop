+                        </span>
+                    </span>
+                    <span className='shrink-0 text-right text-[12px]' style={{ width: 64, color: 'var(--v2-faint)' }} data-slot='admin-product-alerts'>
+                        {alerts > 0 ? C.alerts(alerts) : ''}
+                    </span>
