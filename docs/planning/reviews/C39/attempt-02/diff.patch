+/* C41 API Client: the pretty JSON view numbers its lines from a counter (the numbers are not part of the body's text). */
+[data-v2-shell] [data-slot='json-lines'] {
+    counter-reset: line;
+    white-space: pre;
+}
+[data-v2-shell] [data-slot='json-lines'] > [data-line]::before {
+    counter-increment: line;
+    content: counter(line);
+    display: inline-block;
+    width: 34px;
+    padding-right: 12px;
+    text-align: right;
+    color: var(--v2-faint);
+}
+/* The request's columns and the response pane stack below the width that fits them (the prototype is fixed-width). */
+@media (max-width: 1180px) {
+    [data-v2-shell] [data-slot='workbench-columns'] {
+        flex-wrap: wrap;
+    }
+    [data-v2-shell] [data-slot='workbench-response-pane'] {
+        flex: 1 1 100% !important;
+        max-width: none !important;
+        border-top: 1px solid var(--v2-rule);
+    }
+}
+/* C39a attempt-01 R1: below the width that fits the inventory's columns (900×600 at 200% is 450 CSS px) the rows stack their cells. */
+@media (max-width: 760px) {
+    [data-v2-shell] [data-slot='administration-row'] {
+        grid-template-columns: minmax(0, 1fr) !important;
+        gap: 4px !important;
+    }
+    /* The header row leaves the picture but not the accessibility tree; each stacked cell shows its column's
+       name (C39b attempt-01 R4). */
+    [data-v2-shell] [data-slot='administration-table'] > [role='row']:first-child {
+        position: absolute;
+        width: 1px;
+        height: 1px;
+        overflow: hidden;
+        clip: rect(0 0 0 0);
+        white-space: nowrap;
+    }
+    [data-v2-shell] [data-slot='administration-row'] > [role='cell'][data-label]::before {
+        content: attr(data-label) ': ';
+        font-weight: 600;
+        color: var(--v2-faint);
+    }
+    [data-v2-shell] [data-slot='administration-row'] > [role='cell']:last-child {
+        justify-content: flex-start;
+    }
+}
+/* C39b attempt-01: below the width that fits a table's columns (900×600 at 200% is 450 CSS px) the v2 admin tables stack their cells and hide the header row. */
+@media (max-width: 760px) {
+    [data-v2-shell] [data-slot='admin-tab'] [role='table'] > [role='row'] {
+        grid-template-columns: minmax(0, 1fr) !important;
+        gap: 4px !important;
+    }
+    [data-v2-shell] [data-slot='admin-tab'] [role='table'] > [role='row']:first-child {
+        position: absolute;
+        width: 1px;
+        height: 1px;
+        overflow: hidden;
+        clip: rect(0 0 0 0);
+        white-space: nowrap;
+    }
+    [data-v2-shell] [data-slot='admin-tab'] [role='table'] [role='cell'] {
+        white-space: normal;
+    }
+    [data-v2-shell] [data-slot='admin-tab'] [role='table'] [role='cell'][data-label]::before {
+        content: attr(data-label) ': ';
+        font-weight: 600;
+        color: var(--v2-faint);
+    }
+}
