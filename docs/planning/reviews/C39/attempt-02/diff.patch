+        }
+        setBusy(true)
+        setMessage(null)
+        const outcome = await dispatch(caseId && prefill ? { kind: 'scan', context, draft: built.draft, case: caseId } : { kind: 'scan', context, draft: built.draft })
+        setBusy(false)
