+        <div className='flex flex-col' style={{ gap: 16 }} data-slot='admin-gateway-overview'>
+            {chooser}
+            {g ? (
+                <p className='text-[12px]' style={soft}>{`Workspace ${g.workspaceName}`}</p>
+            ) : null}
