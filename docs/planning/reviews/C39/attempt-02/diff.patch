+                                    }}
+                                >
+                                    {t.label}
+                                </button>
+                            )
+                        })}
+                    </div>
+                    <div
+                        role='tabpanel'
+                        id={`${panel}-tab`}
+                        aria-label={current.label}
+                        data-slot='admin-tab'
+                        data-tab={current.id}
+                        data-disposition={current.disposition.kind}
+                        className='flex min-w-0 flex-col'
+                        style={{ gap: 18, padding: '22px 26px 26px 72px' }}
+                    >
+                        {note ? (
