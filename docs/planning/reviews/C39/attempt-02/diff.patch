+function AttackResults({ scanId, context, read, onClose }: { scanId: string; context: ContextRef; read: (request: ManagementRequest) => Promise<ManagementResult | string>; onClose: () => void }) {
+    const ids = useId()
+    const [pages, setPages] = useState<AttackPage[]>([])
