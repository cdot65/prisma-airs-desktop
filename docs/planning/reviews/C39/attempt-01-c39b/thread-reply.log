import { forwardRef, type ReactNode, useCallback, useEffect, useRef, useState } from 'react'
import { createPortal } from 'react-dom'
import type { AdminProduct, AdminTab, DesktopClient, FeatureId, ManagementResource, ProductReadState, ShellSnapshot } from '@prisma-airs/desktop-contracts'
import { CHANGE_NOUN, type ChangeTarget, verbOf } from '../../features/administration/runtime-changes'
import type { Dispatch } from '../../features/tenants/dispatch'
import type { Act } from '../inbox/inbox'
import { type Arrival, useShellStore } from '../store'
import { SHELL_COPY } from '../copy'
import { Verdict } from '../verdict'
import { ADMIN_COPY as C } from './copy'
import { ReviewSheet } from './review-sheet'
import { InventoryTable } from './inventory-table'
import { Playground } from './playground'
import { type PillTone, ProductCard } from './product-card'
import { RuntimeOverview } from './runtime-overview'
import { GatewayProduct, type GatewayTabId } from './gateway-tabs'
import { ObservationProduct } from './observation-tabs'
import type { GlyphName } from '../icons'
import { Btn } from '../controls'

export interface AdministrationProps {
    snapshot: ShellSnapshot
    dispatch: Dispatch
    client: DesktopClient
    onAct: Act
    onNavigate: (feature: FeatureId) => void
    arrival: Arrival | null
}

const DLP: ManagementResource[] = ['dataPatterns', 'dictionaries', 'dataProfiles', 'filteringProfiles', 'dlpCatalog']
const DLP_LABEL: Record<string, string> = {
    dataPatterns: 'Data patterns',
    dictionaries: 'Dictionaries',
    dataProfiles: 'Data profiles',
    filteringProfiles: 'Data filtering profiles',
    dlpCatalog: 'DLP profiles (AIRS)',
}
const DLP_KIND: Partial<Record<ManagementResource, string>> = {
    dataPatterns: 'dataPatterns',
    dictionaries: 'dictionaries',
    dataProfiles: 'dataProfiles',
    filteringProfiles: 'filteringProfiles',
}
interface Sheet {
    change: ChangeTarget | null
    rotation: string | null
    onDraft?: (body: string) => void
    note?: ReactNode
}

/**
 * Administration (C31, screens/reviews-administration.md): the accordion of
 * the products in `AdminInventory`, each tab rendered by its disposition.
 * Read and Change tabs render the retained views (the same reads and
 * reviewed changes), with the inventory's labels for exactly its actions;
 * Unavailable tabs and products show their gate and nothing else; Removed
 * tabs are not rendered. Every change opens the review sheet; a key rotation
 * follows the core's staged sequence there.
 */
export const Administration = forwardRef<HTMLHeadingElement, AdministrationProps>(function Administration(
    { snapshot, dispatch, client, onAct, onNavigate, arrival },
    ref
) {
    const tenant = snapshot.tenants.find((t) => t.id === snapshot.active?.tenant) ?? null
    const context = snapshot.active?.context ?? null
    const products = snapshot.administration?.products ?? []
    const [open, setOpen] = useState<Record<string, boolean>>({
        runtimeSecurity: true,
    })
    const [tabOf, setTabOf] = useState<Record<string, string>>({
        runtimeSecurity: 'custom-topics',
        gateway: 'routes',
        redTeam: 'scans',
        modelSkill: 'skill-scans',
    })
    const [dlp, setDlp] = useState<ManagementResource>('dataPatterns')
    const [sheet, setSheet] = useState<Sheet | null>(null)
    const observe = useCallback((operation: string) => client.observeManagement(operation), [client])

    // A Harness proposal the operator opened into a review (C21) arrives
    // here: the sheet shows its exact draft under the native review, on the
    // product and tab of its kind; typed confirmation and native approval
    // still apply, and leaving the sheet discards the review.
    const review = snapshot.changes.review
    const proposed = snapshot.harness.conversation?.proposals.find((p) => p.state === 'inReview' && review !== null && p.review === review.review) ?? null
    const shownProposal = useRef<string | null>(null)
    useEffect(() => {
        if (!proposed || shownProposal.current === proposed.review) return
        shownProposal.current = proposed.review
        const d = proposed.draft
        for (const p of products) {
            const t = p.tabs.find((x) => x.disposition.kind === 'change' && x.actions.some((a) => a.kind === d.kind))
            if (!t) continue
            setOpen((o) => ({ ...o, [p.id]: true }))
            setTabOf((s) => ({ ...s, [p.id]: t.id }))
            if (DLP.includes(d.kind as ManagementResource)) setDlp(d.kind as ManagementResource)
            break
        }
        setSheet({
            change: {
                kind: d.kind,
                action: d.action,
                target: d.target,
                title: `Proposed by the Harness: ${verbOf(d.kind, d.action).toLowerCase()} ${CHANGE_NOUN[d.kind]}${d.target ? ` ${d.target}` : ''}`,
                body: d.body,
            },
            rotation: null,
        })
        // eslint-disable-next-line react-hooks/exhaustive-deps -- once per opened proposal review
    }, [proposed])

    // A Runtime case opened in the Playground from Test Cases (C33): Runtime
    // Security's Playground tab, filled with the case.
    const playground = useShellStore((s) => s.playground)
    useEffect(() => {
        if (!playground || playground.tenant !== tenant?.id) return
        const tab = products.find((p) => p.id === 'runtimeSecurity')?.tabs.find((t) => t.label === 'Playground')
        if (!tab) return
        setOpen((o) => ({ ...o, runtimeSecurity: true }))
        setTabOf((s) => ({ ...s, runtimeSecurity: tab.id }))
        // eslint-disable-next-line react-hooks/exhaustive-deps -- once per handed case
    }, [playground?.prefill.nonce, products.length])

    // An arrival is consumed once, when its target is in the inventory (C35 attempt-02 R1):
    // a fresh snapshot never re-applies it over what the operator chose since. The rail's
    // product children and the tenant menu's "Change Gateway workspace…" name a product
    // (and a tab); a contextual action (Inbox, Home) names a Runtime inventory (C30).
    const consumedArrival = useRef<number | null>(null)
    useEffect(() => {
        if (!arrival || consumedArrival.current === arrival.sequence) return
        if (arrival.product) {
            const product = products.find((p) => p.id === arrival.product)
            if (!product) return
            consumedArrival.current = arrival.sequence
            setOpen((o) => ({ ...o, [product.id]: true }))
            const tab = arrival.tab ? product.tabs.find((t) => t.id === arrival.tab && t.disposition.kind !== 'removed') : undefined
            if (tab) setTabOf((s) => ({ ...s, [product.id]: tab.id }))
            return
        }
        if (!arrival.resource) {
            consumedArrival.current = arrival.sequence
            return
        }
        const resource = arrival.resource
        const runtime = products.find((p) => p.id === 'runtimeSecurity')
        const tab = runtime?.tabs.find((t) => t.resource === resource) ?? (DLP.includes(resource) ? runtime?.tabs.find((t) => t.label === 'DLP') : undefined)
        if (!tab) return
        consumedArrival.current = arrival.sequence
        setOpen((o) => ({ ...o, runtimeSecurity: true }))
        setTabOf((s) => ({ ...s, runtimeSecurity: tab.id }))
        if (DLP.includes(resource)) setDlp(resource)
    }, [arrival, products])

    if (!tenant || !context) {
        return (
            <section aria-labelledby='administration-heading' data-slot='administration-v2'>
                <h1 ref={ref} id='administration-heading' tabIndex={-1} className='font-bold' style={{ fontSize: 'var(--v2-title)' }}>
                    {C.title}
                </h1>
                <p className='mt-2 text-[13px]'>{C.noTenant}</p>
            </section>
        )
    }

    const labelsOf = (tab: AdminTab, kind?: string) =>
        Object.fromEntries(tab.actions.filter((a) => !kind || a.kind === kind).map((a) => [a.action, a.label])) as Partial<Record<ChangeTarget['action'], string>>

    function body(product: AdminProduct, tab: AdminTab) {
        if (tab.disposition.kind === 'unavailable') {
            return (
                <div data-slot='admin-unavailable' className='rounded-[12px] border p-4 text-[13px]' style={{ borderColor: 'var(--v2-rule)' }}>
                    <Verdict tone='info' word={C.unavailableTab} />
                    <p className='mt-2' style={{ color: 'var(--v2-soft)' }}>
                        {tab.disposition.reason}
                    </p>
                </div>
            )
        }
        const key = `${context}-${product.id}-${tab.id}`
        if (product.id === 'runtimeSecurity') {
            if (tab.label === 'Overview')
                return (
                    <RuntimeOverview
                        snapshot={snapshot}
                        onRead={() =>
                            void onAct(SHELL_COPY.readOf(tenant!.label), {
                                kind: 'readTenant',
                                context: context!,
                            })
                        }
                    />
                )
            if (tab.label === 'Playground') {
                // A case handed over from Test Cases fills the form (C33); the operator runs it.
                const handed = playground && playground.tenant === tenant!.id ? playground : null
                return <Playground key={key} snapshot={snapshot} dispatch={dispatch} onNavigate={onNavigate} prefill={handed?.prefill ?? null} caseId={handed?.caseId ?? null} />
            }
            const resource = (tab.label === 'DLP' ? dlp : tab.resource) as ManagementResource | null
            if (!resource) return null
            return (
                <div className='flex flex-col gap-3'>
                    {tab.label === 'DLP' ? (
                        <div role='radiogroup' aria-label={C.dlpResources} className='flex flex-wrap rounded-[8px] self-start' style={{ gap: 2, padding: 2, background: 'var(--v2-inset)' }} data-slot='dlp-resources'>
                            {DLP.map((r) => (
                                <button
                                    key={r}
                                    type='button'
                                    role='radio'
                                    aria-checked={dlp === r}
                                    onClick={() => setDlp(r)}
                                    className='h-7 min-h-0 rounded-[6px] px-3 text-[12px] font-semibold'
                                    style={{
                                        background: dlp === r ? 'var(--v2-paper)' : 'transparent',
                                        boxShadow: dlp === r ? '0 1px 2px rgba(0,0,0,0.12)' : 'none',
                                        color: 'var(--v2-ink)',
                                    }}
                                >
                                    {DLP_LABEL[r]}
                                </button>
                            ))}
                        </div>
                    ) : null}
                    <InventoryTable
                        key={`${key}-${resource}`}
                        snapshot={snapshot}
                        context={context!}
                        dispatch={dispatch}
                        observe={observe}
                        resource={resource}
                        arrival={arrival && arrival.resource === resource ? arrival : null}
                        labels={labelsOf(tab, tab.label === 'DLP' ? DLP_KIND[resource] : undefined)}
                        admitted={tab.actions}
                        onReview={(change) => setSheet({ change, rotation: null })}
                        rotations={snapshot.rotations}
                        onFinishRotation={(application) => setSheet({ change: null, rotation: application })}
                    />
                </div>
            )
        }
        if (product.id === 'gateway') {
            return (
                <GatewayProduct
                    key={`${context}-gateway`}
                    snapshot={snapshot}
                    context={context!}
                    dispatch={dispatch}
                    observe={observe}
                    onNavigate={onNavigate}
                    tab={tab.id as GatewayTabId}
                    actions={tab.actions}
                    onReview={(change, extras) => setSheet({ change, rotation: null, ...extras })}
                    onRead={() => void onAct(SHELL_COPY.readOf(tenant!.label), { kind: 'readTenant', context: context! })}
                />
            )
        }
        return <ObservationProduct key={`${context}-${product.id}`} snapshot={snapshot} context={context!} dispatch={dispatch} observe={observe} product={product.id as 'redTeam' | 'modelSkill'} tab={tab.id} />
    }

    const PILL_WORD: Record<ProductReadState | 'unavailable', { tone: PillTone; glyph: GlyphName }> = {
        ok: { tone: 'ok', glyph: 'check' },
        incomplete: { tone: 'flag', glyph: 'alert' },
        needsRole: { tone: 'flag', glyph: 'alert' },
        failed: { tone: 'flag', glyph: 'alert' },
        pending: { tone: 'faint', glyph: 'clock' },
        notRead: { tone: 'faint', glyph: 'clock' },
        unavailable: { tone: 'faint', glyph: 'ban' },
    }
    const reads = snapshot.inbox.read.products
    const overview = snapshot.overview.read
    const chrome = (product: AdminProduct) => {
        const read = reads.find((r) => r.product === product.id)
        const state: ProductReadState | 'unavailable' = product.availability.state === 'unavailable' ? 'unavailable' : (read?.state ?? 'notRead')
        const alerts = snapshot.inbox.items.filter((e) => e.product === product.id && e.needsAction && e.hold === null).length
        const value =
            product.id === 'runtimeSecurity'
                ? overview?.summary.detectionEvents ?? null
                : product.id === 'gateway'
                  ? overview?.gateway?.requests ?? null
                  : null
        return {
            pill: { word: C.status[state] ?? state, ...PILL_WORD[state] },
            stat: { value: value === null ? '—' : value.toLocaleString(), label: C.stat[product.id] ?? '', hot: product.id === 'runtimeSecurity' && value !== null && value > 0 },
            alerts,
        }
    }
    const available = products.filter((p) => p.availability.state === 'available')
    const setAll = (value: boolean) => setOpen(Object.fromEntries(available.map((p) => [p.id, value])))
    return (
        <section aria-labelledby='administration-heading' data-slot='administration-v2' className='flex min-w-0 flex-col' style={{ gap: 14 }}>
            <div className='flex flex-wrap items-end' style={{ gap: 12, marginBottom: 4 }}>
                <div className='min-w-0'>
                    <h1 ref={ref} id='administration-heading' tabIndex={-1} className='font-bold' style={{ fontSize: 'var(--v2-title)', letterSpacing: '-0.01em' }}>
                        {C.title}
                    </h1>
                    <p className='text-[14px]' style={{ marginTop: 4, color: 'var(--v2-soft)' }} data-slot='admin-sub'>
                        {C.lead(tenant.label)}
                    </p>
                </div>
                <div className='ml-auto flex shrink-0' style={{ gap: 6 }}>
                    <Btn onClick={() => setAll(true)}>{C.expandAll}</Btn>
                    <Btn onClick={() => setAll(false)}>{C.collapseAll}</Btn>
                </div>
            </div>
            <ul className='flex flex-col' style={{ gap: 14 }} data-slot='admin-products'>
                {products.map((product) => {
                    const tabs = product.tabs.filter((t) => t.disposition.kind !== 'removed')
                    const current = tabs.find((t) => t.id === tabOf[product.id]) ?? tabs[0]
                    const { pill, stat, alerts } = chrome(product)
                    return (
                        <ProductCard
                            key={product.id}
                            product={product}
                            open={!!open[product.id]}
                            onToggle={() => setOpen((o) => ({ ...o, [product.id]: !o[product.id] }))}
                            stat={stat}
                            pill={pill}
                            alerts={alerts}
                            tabs={tabs}
                            current={current}
                            onTab={(id) => setTabOf((s) => ({ ...s, [product.id]: id }))}
                            note={product.readOnly && current?.label !== 'Overview' ? C.readOnly : null}
                        >
                            {current ? body(product, current) : null}
                        </ProductCard>
                    )
                })}
            </ul>
            {/* The sheet is the topmost dialog (I8): rendered at the body, outside the page the modal stack hides. */}
            {sheet
                ? createPortal(
                      <ReviewSheet
                          snapshot={snapshot}
                          context={context}
                          dispatch={dispatch}
                          observe={observe}
                          change={sheet.change}
                          rotation={sheet.rotation}
                          onDraft={sheet.onDraft}
                          note={sheet.note}
                          onClose={() => setSheet(null)}
                      />,
                      document.body
                  )
                : null}
        </section>
    )
})
import { type ReactNode, useEffect, useRef, useState } from 'react'
import type { ChangeKind, ChangeResultView, ContextRef, GatewayResource, ManagementRequest, ManagementResource, ShellSnapshot } from '@prisma-airs/desktop-contracts'
import { MANAGEMENT_FAILURE_TEXT, RESOURCES, itemName, readManagement, type ObserveManagement } from '../../features/administration/management-read'
import { CHANGE_NOUN, type ChangeTarget, ChangeWorkbench, TEMPLATES, pretty, resultText } from '../../features/administration/runtime-changes'
import { type Dispatch, outcomeMessage } from '../../features/tenants/dispatch'
import { clockOf } from '../copy'
import { Modal } from '../modal'
import { useShellStore } from '../store'
import { Verdict } from '../verdict'
import { Glyph } from '../icons'
import { ADMIN_COPY as C } from './copy'
import { RotationPanel } from './rotation-panel'

export interface ReviewSheetProps {
    snapshot: ShellSnapshot
    context: ContextRef
    dispatch: Dispatch
    observe: ObserveManagement
    /** The change to review first (none when opening a rotation in progress). */
    change: ChangeTarget | null
    /** The application whose rotation this sheet follows (a key version, or "Finish rotation…"). */
    rotation: string | null
    /** A Gateway change keeps its edited text on this Mac as a draft (C17). */
    onDraft?: (body: string) => void
    note?: ReactNode
    onClose: () => void
}

const matches = (r: ChangeResultView, c: ChangeTarget) => r.kind === c.kind && r.action === c.action && r.target === c.target

const RUNTIME_RESOURCE: Partial<Record<ChangeKind, ManagementResource>> = {
    profiles: 'profiles',
    topics: 'topics',
    applications: 'applications',
    apiKeys: 'apiKeys',
    dataPatterns: 'dataPatterns',
    dataProfiles: 'dataProfiles',
    filteringProfiles: 'filteringProfiles',
    dictionaries: 'dictionaries',
}
const GATEWAY_RESOURCE: Partial<Record<ChangeKind, GatewayResource>> = {
    gatewayWorkspaces: 'workspaces',
    gatewayProviders: 'providers',
    gatewayRoutes: 'routes',
    gatewayGuardrails: 'guardrails',
    gatewayServiceKeys: 'serviceKeys',
    gatewayUserKeys: 'userKeys',
    gatewayIntegrations: 'integrations',
}

/** What an applied change established, for its action (C31): never success from a readback value alone. */
export type AppliedState = 'live' | 'removed' | 'unconfirmed' | 'failed'
export function appliedState(r: ChangeResultView): AppliedState {
    if (r.outcome === 'unknown') return 'unconfirmed'
    if (r.outcome !== 'completed') return 'failed'
    // The service accepted it; only the readback of this action confirms it.
    if (r.failure) return 'unconfirmed'
    if (r.action === 'delete') return r.readback === 'absent' ? 'removed' : 'unconfirmed'
    return r.readback === 'found' ? 'live' : 'unconfirmed'
}

/** What a reconciliation read of the reviewed item established now. */
type Reconciled = { state: 'reading' } | { state: 'read' } | { state: 'present' } | { state: 'absent' } | { state: 'partial' } | { state: 'failed'; message: string }

/**
 * The review surface (C31, I3, I6, I7): the reviewed change (diff, impact,
 * "Type <name> to confirm" with Apply disabled until it matches; the native
 * confirmation applies), then its applied panel from the core's result, or
 * the staged rotation panel for a Runtime key version. Every exit (Done,
 * Escape, the scrim, navigation, unmount) ends the reviews it opened in the
 * core, which retires any one-time key their changes returned or will
 * return; a key held for a rotation it resumed is forgotten too.
 */
export function ReviewSheet({ snapshot, context, dispatch, observe, change: initial, rotation: rotationApp, onDraft, note, onClose }: ReviewSheetProps) {
    const [change, setChange] = useState<ChangeTarget | null>(initial)
    const [application] = useState<string | null>(rotationApp ?? (initial?.kind === 'apiKeys' && initial.action === 'version' ? applicationOf(initial) : null))
    const [busy, setBusy] = useState(false)
    // "Application updated" waits for the core's recorded acknowledgement
    // before the old key's removal opens (Version → acknowledgement → Delete).
    const [ackWaiting, setAckWaiting] = useState(false)
    const [ackProblem, setAckProblem] = useState<string | null>(null)
    const [reconciled, setReconciled] = useState<Reconciled | null>(null)
    // Results present when this change was opened are not its outcome.
    const seen = useRef(new Set(snapshot.changes.results.map((r) => r.operation)))
    const [, setOpened] = useState(0)
    useEffect(() => {
        seen.current = new Set(snapshot.changes.results.map((r) => r.operation))
        setReconciled(null)
        // Render again without the results that belonged to the previous change.
        setOpened((n) => n + 1)
        // eslint-disable-next-line react-hooks/exhaustive-deps -- reset per opened change only
    }, [change])
    const result = change ? (snapshot.changes.results.find((r) => matches(r, change) && !seen.current.has(r.operation)) ?? null) : null
    const rotation = application ? (snapshot.rotations.find((r) => r.application === application) ?? null) : null
    // A key change of a rotation is followed by the rotation panel once it settles.
    const rotationStep = !!change && change.kind === 'apiKeys' && (change.action === 'version' || change.action === 'delete') && !!application
    const showWorkbench = !!change && !(result?.settled && rotationStep)

    // A completion is confirmed once more by a toast bound to this tenant and
    // context (I2, I10): it persists under Reduce Motion until dismissed.
    const announced = useRef(new Set<string>())
    const stage = rotation?.stage ?? null
    const settledState = result?.settled && !rotationStep ? appliedState(result) : null
    useEffect(() => {
        const say = (key: string, text: string) => {
            if (announced.current.has(key)) return
            announced.current.add(key)
            useShellStore.getState().toast(text, 'ok', undefined, snapshot.active?.tenant ?? null, context)
        }
        if (stage === 'complete' && rotation) say(`rotation-${rotation.application}`, C.rotation.completeToast(rotation.application))
        if (result && (settledState === 'live' || settledState === 'removed'))
            say(result.operation, settledState === 'live' ? C.applied.liveToast(change?.title ?? '') : C.applied.removedToast(change?.title ?? ''))
        // eslint-disable-next-line react-hooks/exhaustive-deps -- on each observed completion
    }, [stage, settledState])

    // Every review this sheet opened, so its exit can end each one in the core.
    const reviews = useRef(new Set<string>())
    const open = snapshot.changes.review?.review ?? null
    useEffect(() => {
        if (open && change) reviews.current.add(open)
    }, [open, change])
    const exit = useRef<() => void>(() => {})
    exit.current = () => {
        // I6: the core ends each review; an applied one retires the one-time
        // key its change returned, settled or still under way.
        for (const review of reviews.current) void dispatch({ kind: 'discardChange', review })
        reviews.current.clear()
        if (rotation?.issuedBy) void dispatch({ kind: 'forgetSecret', operation: rotation.issuedBy })
    }
    // Unmount (navigation, tenant switch, window close) is an exit too. The
    // deferred call lets a development re-mount cancel it.
    const pendingExit = useRef<number | null>(null)
    useEffect(() => {
        if (pendingExit.current !== null) window.clearTimeout(pendingExit.current)
        pendingExit.current = null
        return () => {
            pendingExit.current = window.setTimeout(() => exit.current(), 0)
        }
    }, [])

    function close() {
        exit.current()
        onClose()
    }

    async function updated() {
        if (!rotation) return
        setBusy(true)
        setAckProblem(null)
        const outcome = await dispatch({ kind: 'acknowledgeDeployment', context, application: rotation.application })
        setBusy(false)
        if (outcome.kind === 'refused' || outcome.kind === 'failed') {
            setAckProblem(outcomeMessage(outcome) ?? C.rotation.ackRefused)
            return
        }
        // Admitted, or not confirmed: only the observed acknowledgement opens the removal.
        if (outcome.kind === 'unknown') setAckProblem(C.rotation.ackUnknown)
        setAckWaiting(true)
    }
    const acknowledgedAt = rotation?.deploymentAcknowledgedAt ?? null
    useEffect(() => {
        if (!ackWaiting || acknowledgedAt === null || !rotation) return
        setAckWaiting(false)
        setAckProblem(null)
        setChange(removeOld(rotation.oldKey.id, rotation.oldKey.name))
        // eslint-disable-next-line react-hooks/exhaustive-deps -- once the acknowledgement is observed
    }, [ackWaiting, acknowledgedAt])

    /** Reads the reviewed item itself (never a replay): its detail by ID, or the inventory by name for a creation. */
    async function reconcile(of: { kind: ChangeKind; target: string; name: string | null; workspace?: string | null }) {
        setBusy(true)
        setReconciled({ state: 'reading' })
        const runtime = RUNTIME_RESOURCE[of.kind]
        const gateway = GATEWAY_RESOURCE[of.kind]
        let request: ManagementRequest | null = null
        if (runtime) request = of.target ? { kind: 'detail', resource: runtime, id: of.target } : { kind: 'page', resource: runtime, offset: 0, limit: 100 }
        else if (gateway) {
            const workspace = gateway === 'workspaces' || gateway === 'integrations' ? null : (of.workspace ?? null)
            request = {
                kind: 'gateway',
                workspace,
                read: of.target ? { kind: 'detail', resource: gateway, id: of.target } : { kind: 'inventory', resource: gateway },
            }
        }
        if (!request) {
            setBusy(false)
            setReconciled({ state: 'failed', message: C.applied.cannotReconcile })
            return
        }
        const outcome = await readManagement(dispatch, observe, context, request)
        setBusy(false)
        if (outcome.kind === 'notAdmitted') return setReconciled({ state: 'failed', message: outcome.message })
        const r = outcome.result
        if (r.kind === 'failed')
            return setReconciled({
                state: 'failed',
                message: MANAGEMENT_FAILURE_TEXT[r.failure],
            })
        const found = r.kind === 'detail' ? r.detail.found : r.kind === 'gateway' && r.gateway.kind === 'detail' ? r.gateway.detail.found : null
        if (found)
            return setReconciled({
                state: found === 'found' ? 'present' : found === 'absent' ? 'absent' : 'partial',
            })
        // A rotation's issuance: the core matched the reviewed key name; the panel shows what it established.
        if (of.name === null) return setReconciled({ state: 'read' })
        // A creation: look for its name in what was read.
        let rows: Record<string, unknown>[] = []
        let complete = false
        if (r.kind === 'page') {
            rows = JSON.parse(r.page.items) as Record<string, unknown>[]
            complete = r.page.offset === 0 && r.page.complete
        } else if (r.kind === 'gateway' && r.gateway.kind === 'list') {
            rows = JSON.parse(r.gateway.list.rows) as Record<string, unknown>[]
            complete = r.gateway.list.complete
        }
        const info = RESOURCES.find((x) => x.id === runtime)
        const named = rows.some((row) => (info ? itemName(info, row) : String(row.name ?? '')) === of.name)
        setReconciled({
            state: named ? 'present' : complete ? 'absent' : 'partial',
        })
    }

    return (
        <Modal label={application ? C.rotation.title(application) : C.reviewTitle} onClose={close} width={620} padding={30} sheet data-slot='review-sheet'>
            <div className='flex flex-col' style={{ gap: 18 }}>
                {/* R2App's review sheet (C39b): the title with the review's state, a close control, and the change's path. */}
                <div className='flex items-center' style={{ gap: 10 }}>
                    <h2 className='text-[24px] font-bold' style={{ letterSpacing: '-0.01em' }}>
                        {application ? C.rotation.title(application) : C.reviewTitle}
                    </h2>
                    <span className='rounded-full text-[12px] font-semibold' style={{ padding: '2px 9px', background: settledState === 'live' || settledState === 'removed' ? 'var(--v2-ok-bg)' : settledState === 'failed' ? 'var(--v2-block-bg)' : 'var(--v2-inset)', color: settledState === 'live' || settledState === 'removed' ? 'var(--v2-ok)' : settledState === 'failed' ? 'var(--v2-block)' : 'var(--v2-soft)' }} data-slot='review-state'>
                        {settledState === 'live' ? 'Applied' : settledState === 'removed' ? 'Removed' : settledState === 'failed' ? 'Not applied' : settledState === 'unconfirmed' ? 'Outcome unknown' : snapshot.changes.review && change ? (snapshot.changes.review.state === 'ready' ? 'Ready for review' : snapshot.changes.review.state === 'confirming' ? 'Confirming' : snapshot.changes.review.state === 'preparing' ? 'Preparing' : 'Review') : 'Draft'}
                    </span>
                    <button type='button' aria-label='Close review' onClick={close} className='ml-auto grid shrink-0 place-items-center rounded-[7px] border' style={{ width: 28, height: 28, minHeight: 0, borderColor: 'var(--v2-rule)', background: 'var(--v2-paper)', color: 'var(--v2-ink)' }}>
                        <Glyph name='x' size={12} stroke={2.2} />
                    </button>
                </div>
                {change ? (
                    <p className='text-[14px]' style={{ color: 'var(--v2-soft)' }} data-slot='review-path'>
                        {`${CHANGE_NOUN[change.kind].charAt(0).toUpperCase()}${CHANGE_NOUN[change.kind].slice(1)} › `}
                        <b style={{ color: 'var(--v2-ink)' }}>{change.title}</b>
                    </p>
                ) : null}
                {rotation ? (
                    <RotationPanel
                        rotation={rotation}
                        tenant={snapshot.active?.tenant ?? null}
                        busy={busy}
                        onReveal={(operation) => void dispatch({ kind: 'revealSecret', operation })}
                        onFinishLater={close}
                        onUpdated={() => void updated()}
                        onIssueAnother={() => setChange(issueAnother(rotation.oldKey.id, rotation.application))}
                        onRemoveOld={() => setChange(removeOld(rotation.oldKey.id, rotation.oldKey.name))}
                        onReconcile={() =>
                            void reconcile(
                                rotation.stage === 'removalUnconfirmed'
                                    ? {
                                          kind: 'apiKeys',
                                          target: rotation.oldKey.id,
                                          name: rotation.oldKey.name,
                                      }
                                    : { kind: 'apiKeys', target: '', name: null }
                            )
                        }
                    />
                ) : null}
                {showWorkbench && change ? (
                    <ChangeWorkbench
                        key={`${change.kind}-${change.action}-${change.target}-${change.draftId ?? ''}`}
                        change={change}
                        review={snapshot.changes.review}
                        staged={snapshot.changes.staged}
                        context={context}
                        dispatch={dispatch}
                        onClose={close}
                        onDraft={onDraft}
                        note={note}
                        requireTyped
                    />
                ) : null}
                {result && !rotationStep ? (
                    <Applied
                        result={result}
                        tenant={snapshot.tenants.find((t) => t.id === snapshot.active?.tenant)?.label ?? null}
                        reconciled={reconciled}
                        busy={busy}
                        onDone={close}
                        onReconcile={() =>
                            void reconcile({
                                kind: result.kind,
                                target: result.target,
                                name: result.name,
                                workspace: change?.workspace ?? null,
                            })
                        }
                        onReveal={() =>
                            void dispatch({
                                kind: 'revealSecret',
                                operation: result.operation,
                            })
                        }
                    />
                ) : null}
                {result && rotationStep && !result.settled ? (
                    <p role='status' className='text-[13px]'>
                        {resultText(result)}
                    </p>
                ) : null}
                {result && rotationStep && result.settled && (!rotation || result.outcome === 'rejected' || result.outcome === 'notSent') && change ? (
                    // The latest key change was not made (or the rotation could not be named): the
                    // core's sanitized result, apart from any rotation it leaves as it was, and an
                    // explicit way to try again through a new review. Nothing is resent by itself.
                    <section role='alert' data-slot='rotation-step-failed' data-action={change.action} className='flex flex-col gap-2 text-[13px]' style={{ color: 'var(--v2-block)' }}>
                        <p>{resultText(result)}</p>
                        {rotation ? <p style={{ color: 'var(--v2-ink)' }}>{change.action === 'version' ? C.rotation.issueFailedKept : C.rotation.removeFailedKept}</p> : null}
                        <div>
                            <button
                                type='button'
                                className='h-8 rounded-[7px] border px-3 text-[13px]'
                                style={{ borderColor: 'var(--v2-rule)', color: 'var(--v2-ink)' }}
                                onClick={() => setChange({ ...change })}
                            >
                                {C.rotation.tryAgain}
                            </button>
                        </div>
                    </section>
                ) : null}
                {rotation && reconciled ? <ReconcileNote reconciled={reconciled} /> : null}
                {ackProblem ? (
                    <p role='alert' data-slot='acknowledge-problem' className='text-[13px]' style={{ color: 'var(--v2-block)' }}>
                        {ackProblem}
                    </p>
                ) : null}
            </div>
        </Modal>
    )
}

function ReconcileNote({ reconciled }: { reconciled: Reconciled }) {
    return (
        <p role='status' data-slot='reconciled' data-state={reconciled.state} className='text-[13px]'>
            {reconciled.state === 'reading'
                ? C.applied.reading
                : reconciled.state === 'read'
                  ? C.applied.readRotation
                  : reconciled.state === 'present'
                    ? C.applied.present
                    : reconciled.state === 'absent'
                      ? C.applied.absent
                      : reconciled.state === 'partial'
                        ? C.applied.partial
                        : C.applied.readFailed(reconciled.message)}
        </p>
    )
}

/** The applied panel of a non-rotation change: only what the core's readback established, for its action. */
function Applied({
    result,
    tenant,
    reconciled,
    busy,
    onDone,
    onReconcile,
    onReveal,
}: {
    result: ChangeResultView
    tenant: string | null
    reconciled: Reconciled | null
    busy: boolean
    onDone: () => void
    onReconcile: () => void
    onReveal: () => void
}) {
    if (!result.settled) {
        return (
            <p role='status' className='text-[13px]' data-slot='applied'>
                {resultText(result)}
            </p>
        )
    }
    const state = appliedState(result)
    return (
        <section role='status' data-slot='applied' data-state={state} className='flex flex-col gap-2 rounded-[12px] border p-4' style={{ borderColor: 'var(--v2-rule)' }}>
            {state === 'live' ? (
                <Verdict tone='allowed' word={C.applied.live} />
            ) : state === 'removed' ? (
                <Verdict tone='allowed' word={C.applied.removed} />
            ) : state === 'unconfirmed' ? (
                <Verdict tone='flagged' word={C.applied.notConfirmed} />
            ) : (
                <Verdict tone='blocked' word={C.applied.failed} />
            )}
            <p className='text-[13px]'>{resultText(result)}</p>
            {state === 'live' || state === 'removed' ? <Receipt result={result} tenant={tenant} removed={state === 'removed'} /> : null}
            {result.secret === 'held' ? (
                <p className='text-[13px]' data-slot='applied-secret'>
                    {C.rotation.issuedNote}
                </p>
            ) : null}
            {reconciled ? <ReconcileNote reconciled={reconciled} /> : null}
            <div className='flex gap-2'>
                {result.secret === 'held' ? (
                    <button type='button' className='h-8 rounded-[7px] border px-3 text-[13px]' style={{ borderColor: 'var(--v2-rule)' }} onClick={onReveal}>
                        {C.rotation.reveal}
                    </button>
                ) : null}
                {state === 'unconfirmed' ? (
                    <button
                        type='button'
                        disabled={busy}
                        className='h-8 rounded-[7px] border px-3 text-[13px] disabled:opacity-60'
                        style={{ borderColor: 'var(--v2-rule)' }}
                        onClick={onReconcile}
                    >
                        {C.applied.reconcile}
                    </button>
                ) : null}
                <button
                    type='button'
                    className='h-8 rounded-[7px] px-3 text-[13px] font-semibold'
                    style={{ background: 'var(--v2-acc)', color: 'var(--v2-acc-ink)' }}
                    onClick={onDone}
                >
                    {C.applied.done}
                </button>
            </div>
        </section>
    )
}

/**
 * What a confirmed change established, from the core's result only: the
 * tenant, the resource, the returned name and revision, and when the core
 * recorded the readback (its own clock, never recomputed). A field the
 * service did not return says so.
 */
function Receipt({ result, tenant, removed }: { result: ChangeResultView; tenant: string | null; removed: boolean }) {
    let item: Record<string, unknown> = {}
    try {
        item = result.current ? (JSON.parse(result.current) as Record<string, unknown>) : {}
    } catch {
        item = {}
    }
    const revision = typeof item.revision === 'number' || typeof item.revision === 'string' ? String(item.revision) : null
    const rows: [string, string][] = [
        [C.applied.tenant, tenant ?? C.applied.notReported],
        [C.applied.resource, CHANGE_NOUN[result.kind]],
        [C.applied.name, result.name ?? C.applied.notReported],
        ...(removed ? [] : ([[C.applied.revision, revision ?? C.applied.notReported]] as [string, string][])),
        [C.applied.readAt, result.settledAt !== undefined ? clockOf(result.settledAt) : C.applied.notReported],
    ]
    return (
        <dl data-slot='applied-receipt' className='grid gap-x-4 gap-y-1 text-[12px]' style={{ gridTemplateColumns: 'max-content 1fr' }}>
            {rows.map(([label, value]) => (
                <div key={label} className='contents'>
                    <dt style={{ color: 'var(--v2-soft)' }}>{label}</dt>
                    <dd className='break-all'>{value}</dd>
                </div>
            ))}
        </dl>
    )
}

function applicationOf(change: ChangeTarget): string | null {
    try {
        const body = JSON.parse(change.body) as { cust_app?: unknown }
        return typeof body.cust_app === 'string' && body.cust_app ? body.cust_app : null
    } catch {
        return null
    }
}

const issueAnother = (oldKey: string, application: string): ChangeTarget => ({
    kind: 'apiKeys',
    action: 'version',
    target: oldKey,
    title: `Issue additional key for ${application}`,
    body: pretty({ ...TEMPLATES.key, cust_app: application }),
})

const removeOld = (oldKey: string, name: string): ChangeTarget => ({
    kind: 'apiKeys',
    action: 'delete',
    target: oldKey,
    title: `Remove ${name}`,
    body: '{}',
})
import { useEffect, useId, useRef, type KeyboardEvent, type ReactNode } from 'react'
import { useShellStore } from './store'

interface ModalProps {
    label: string
    onClose: () => void
    children: ReactNode
    /** Width in CSS px (default 560). */
    width?: number
    /** Inner padding in CSS px (default 20); 0 for a dialog that lays itself out edge to edge. */
    padding?: number
    /** Distance from the top of the window in CSS px (default 4vh); the prototype's palette sits at 90. */
    top?: number
    /** Corner radius in CSS px (default 12; the palette's frame is 14). */
    radius?: number
    /** A sheet docked to the window's right edge under the header (R2App's review sheet, 620px wide, full height). */
    sheet?: boolean
    'data-slot'?: string
}

const FOCUSABLE = 'a[href], button:not([disabled]), input:not([disabled]), select:not([disabled]), textarea:not([disabled]), [tabindex]:not([tabindex="-1"])'

/**
 * One topmost modal (I8): dialogs register on a shell-wide stack; only the
 * last is interactive. Lower dialogs are inert and aria-hidden, Tab and
 * Shift-Tab stay inside the topmost dialog, Escape closes the topmost only,
 * focus moves into the dialog on open and back to the opener on close. The
 * page behind every dialog is made inert by the shell (`useModalsOpen`).
 * The dialog element handles its own keys; the topmost dialog also listens
 * on the window for Escape alone, for when focus has left it (a native
 * sheet returned focus elsewhere), and closes only itself.
 */
export function Modal({ label, onClose, children, width = 560, padding = 20, top, radius = 12, sheet = false, ...rest }: ModalProps) {
    const id = useId()
    const pushModal = useShellStore((s) => s.pushModal)
    const popModal = useShellStore((s) => s.popModal)
    const modals = useShellStore((s) => s.modals)
    const topmost = modals.length > 0 && modals[modals.length - 1] === id
    const dialog = useRef<HTMLDivElement>(null)
    const opener = useRef<HTMLElement | null>(null)
    const focusedOnce = useRef(false)

    useEffect(() => {
        opener.current = document.activeElement instanceof HTMLElement ? document.activeElement : null
        pushModal(id)
        return () => {
            popModal(id)
            // After the commit: the page behind is still inert during cleanup,
            // and an inert ancestor refuses focus (observed in WebKit).
            const target = opener.current
            queueMicrotask(() => {
                // Only when nothing else took focus meanwhile (⌘T replacing the
                // palette hands focus to the tenant list, which must keep it).
                const active = document.activeElement
                if (active && active !== document.body) return
                // The opener may be gone (a "Finish rotation…" that completed):
                // focus the page heading rather than leave it on nothing.
                if (target?.isConnected) target.focus()
                else document.querySelector<HTMLElement>('main h1[tabindex="-1"]')?.focus()
            })
        }
    }, [id, pushModal, popModal])

    useEffect(() => {
        // Initial focus goes into the dialog once, when it opens. Regaining the
        // top after a higher dialog closes must not refocus: that dialog is
        // restoring its own opener, which may be any control here.
        if (!topmost || focusedOnce.current) return
        const node = dialog.current
        if (!node) return
        focusedOnce.current = true
        if (!node.contains(document.activeElement)) {
            // A declared initial control first (wherever it sits), else the first focusable.
            const first = node.querySelector<HTMLElement>('[autofocus]') ?? node.querySelector<HTMLElement>(FOCUSABLE)
            ;(first ?? node).focus()
        }
    }, [topmost])

    // Escape still closes the topmost dialog when focus has left it (a
    // native sheet returning focus to the page body, a click on the scrim's
    // edge): the dialog's own handler stops the event first when it has focus.
    const closeRef = useRef(onClose)
    closeRef.current = onClose
    useEffect(() => {
        if (!topmost) return
        const onWindowKey = (event: globalThis.KeyboardEvent) => {
            if (event.key !== 'Escape' || event.defaultPrevented) return
            const node = dialog.current
            if (node && node.contains(document.activeElement)) return
            event.preventDefault()
            closeRef.current()
        }
        window.addEventListener('keydown', onWindowKey)
        return () => window.removeEventListener('keydown', onWindowKey)
    }, [topmost])

    const onKeyDown = (event: KeyboardEvent<HTMLDivElement>) => {
        if (!topmost) return
        if (event.key === 'Escape') {
            event.preventDefault()
            event.stopPropagation()
            onClose()
            return
        }
        if (event.key === 'Tab') {
            // Keyboard interaction stays inside the topmost dialog.
            const node = dialog.current
            if (!node) return
            const items = Array.from(node.querySelectorAll<HTMLElement>(FOCUSABLE)).filter((el) => !el.hasAttribute('hidden') && el.getAttribute('aria-hidden') !== 'true')
            if (items.length === 0) {
                event.preventDefault()
                node.focus()
                return
            }
            const first = items[0] as HTMLElement
            const last = items[items.length - 1] as HTMLElement
            const active = document.activeElement
            if (event.shiftKey && (active === first || active === node)) {
                event.preventDefault()
                last.focus()
            } else if (!event.shiftKey && active === last) {
                event.preventDefault()
                first.focus()
            }
        }
    }

    return (
        <div
            className={sheet ? 'fixed z-50 flex justify-end' : 'fixed inset-0 z-50 grid place-items-start justify-center'}
            style={sheet ? { inset: 'var(--v2-header, 56px) 0 0 0' } : { paddingTop: top ?? '4vh' }}
            data-v2-scrim=''
            aria-hidden={topmost ? undefined : true}
            inert={topmost ? undefined : true}
            onMouseDown={() => topmost && onClose()}
        >
            <div
                ref={dialog}
                role='dialog'
                aria-modal={topmost ? 'true' : undefined}
                aria-label={label}
                tabIndex={-1}
                data-slot={rest['data-slot'] ?? 'modal'}
                data-topmost={topmost ? 'true' : 'false'}
                onKeyDown={onKeyDown}
                onMouseDown={(e) => e.stopPropagation()}
                className='border'
                // Bounded to the viewport: a tall dialog scrolls inside itself, so its
                // actions stay reachable at the minimum window size and 200% zoom.
                style={
                    sheet
