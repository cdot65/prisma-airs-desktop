                return answer({
                    kind: 'gateway',
                    gateway: { kind: 'list', list: { resource: read.resource, workspace: read.resource === 'workspaces' || read.resource === 'integrations' ? null : WS.id, rows: JSON.stringify(rows), count: 1, total: 1, complete: true } },
