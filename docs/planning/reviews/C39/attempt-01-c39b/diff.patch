+    const sub = !g ? (chooser ? 'Choose a workspace' : 'Not read yet') : g.usageFailure ? `Usage not read: ${MANAGEMENT_FAILURE_TEXT[g.usageFailure]}` : g.partial ? 'Part of the day only' : readAt ? `From the read at ${clockOf(readAt)}` : ''
