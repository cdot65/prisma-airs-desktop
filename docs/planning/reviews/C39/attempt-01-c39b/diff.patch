+function LocalWork({ local, context, dispatch, onOpen }: { local: GatewayLocalView; context: ContextRef; dispatch: Dispatch; onOpen: (kept: GatewayDraft | GatewayRecord, draftId: string | undefined) => void }) {
+    const ids = useId()
