--\n    \"C15-N01\": (X, [\"C41-N02\"], \"from the URL field Tab reaches Send; Space sends the typed input to the loopback service and the completion is announced\"),\n    \"C15-N02\": (R, [], \"cookies between requests: crates/desktop-core/tests/workbench_execution\"),\n    \"C15-N03\": (R, [], \"a 64 MiB response streamed to private storage: crates/desktop-core/tests/workbench_execution\"),\n    \"C15-N04\": (R, [], \"cancelling a running request: crates/desktop-core/tests/workbench_execution\"),\n    \"C15-N05\": (R, [], \"a lost POST response, sent once: crates/desktop-core/tests/workbench_execution\"),\n    \"C15-N06\": (R, [], \"tenant-credential operations and their refusals: crates/desktop-core/tests/workbench_execution\"),\n    \"C15-N07\": (R, [], \"a tenant change's native confirmation: the host's tests and workbench_execution\"),\n    \"C15-N08\": (R, [], \"an interrupted run after a relaunch: crates/desktop-core/tests/workbench_execution\"),\n    \"C15-N09\": (P, [\"C44-N01\"], \"the prepared bundle is Node-free (node_free from acceptance_c24) and no Node, Bun or Deno process runs beside the app during the destination sweep\"),\n    # ---- C16 Gateway reads → the AI Gateway card ----\n    \"C16-N01\": (X, [\"C39-N03\"], \"the Gateway card reads through the management client; without one the card asks for it\"),\n    \"C16-N02\": (X, [\"C39-N03\"], \"the Workspaces tab's chooser lists the workspaces; Team A chosen is checked and read\"),\n    \"C16-N03\": (X, [\"C39-N03\", \"C44-N01\"], \"a route's detail with the inventory's actions; no credential in any tree\"),\n    \"C16-N04\": (R, [], \"a workspace change drops the earlier workspace's late reply: crates/desktop-core/tests/gateway_reads\"),\n    \"C16-N05\": (R, [], \"inference prerequisites per plane: crates/desktop-core/tests/gateway_reads (the Harness's prerequisites panel is the v2 surface)\"),\n    \"C16-N06\": (R, [], \"a pending Runtime review protected across Gateway use: crates/desktop-core/tests/runtime_changes\"),\n    \"C16-N07\": (R, [], \"the remembered workspace restored only from a new listing: crates/desktop-core/tests/gateway_reads and apps/desktop/src/v2/admin/administration.test.tsx\"),\n    \"C16-N08\": (X, [\"C39-N04\"], \"keyboard reach at 900×600 and 200%\"),\n    \"C16-N09\": (X, [\"C44-N01\"], \"no secret or private marker in any tree; only admitted requests reach the plane\"),\n    \"C16-N10\": (R, [], \"integrations' late replies dropped: crates/desktop-core/tests/gateway_reads\"),\n    \"C16-N11\": (X, [\"C39-N03\"], \"the chosen workspace's settings read with Refresh workspace and its admitted actions\"),\n    # ---- C17 Gateway changes ----\n    \"C17-N01\": (X, [\"C39-N03\"], \"the workspace's admitted Edit… / Archive… offered from the read; the review and native confirmation of a Gateway change: crates/desktop-core/tests/gateway_changes\"),\n    \"C17-N02\": (R, [], \"a workspace change closes a prepared change: crates/desktop-core/tests/gateway_changes\"),\n    \"C17-N03\": (R, [], \"a referenced provider's delete disabled, the destructive sheet: crates/desktop-core/tests/gateway_changes and the host's sheet tests\"),\n    \"C17-N04\": (R, [], \"a service key's one-time value in the native secret sheet: the host's secret-sheet tests and gateway_changes\"),\n    \"C17-N05\": (R, [], \"workspace provisioning steps: crates/desktop-core/tests/gateway_changes\"),\n    \"C17-N06\": (R, [], \"a lost provisioning reply: crates/desktop-core/tests/gateway_changes\"),\n    \"C17-N07\": (R, [], \"Stop waiting on a provisioning: crates/desktop-core/tests/gateway_changes\"),\n    \"C17-N08\": (X, [\"C39-N03\"], \"the Workspaces tab shows the chosen workspace's settings with Edit… / Archive…\"),\n    \"C17-N09\": (X, [\"C39-N04\"], \"keyboard reach at 900×600 and 200%\"),\n    \"C17-N10\": (X, [\"C44-N01\"], \"no one-time key or private marker in any tree; only reviewed writes: gateway_changes\"),\n    \"C17-N11\": (R, [], \"Gateway work kept