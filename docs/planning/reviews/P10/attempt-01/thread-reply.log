{"type":"item.completed","item":{"id":"item_47","type":"command_execution","command":"/bin/zsh -lc 'cat tools/p10/test_historical.py tools/p10/test_followup.py tools/p10/test_build_reuse.py tools/p10/test_review_gate.py'","aggregated_output":"\"\"\"Historical source/builder independence and strict current reuse regressions.\"\"\"\nfrom pathlib import Path\nimport json,tempfile,unittest\nfrom unittest.mock import patch\nfrom candidate import digest,file_identity,bundle_hash,verify_candidate\nfrom qualification import sha,read\nfrom historical import Historical\n\n\nclass ArchiveNegatives(unittest.TestCase):\n    def setUp(self):\n        self.temp=tempfile.TemporaryDirectory();self.addCleanup(self.temp.cleanup);self.root=Path(self.temp.name);self.base=self.root/'docs/planning/evidence/C45';self.source=self.base/'archive/source';self.source.mkdir(parents=True);(self.source/'helper.py').write_text('recorded helper')\n        files={'helper.py':file_identity(self.source/'helper.py')};self.fp=digest(files);seal=self.base/'seal.json';seal.write_text(json.dumps(dict(files=files)))\n        self.bundle=self.base/'archive/app';exe=self.bundle/'Contents/MacOS/prisma-airs-desktop';exe.parent.mkdir(parents=True);exe.write_text('recorded executable');self.value=dict(bundle_sha256=bundle_hash(self.bundle),executable_sha256=sha(exe))\n        self.context=self.base/'context.json';self.context.write_text(json.dumps(dict(schema='airs-desktop/historical-qualification-context/1',sources={self.fp:dict(path=str(self.source.relative_to(self.root)),seal=dict(path=str(seal.relative_to(self.root)),sha256=sha(seal)))},applications={self.value['bundle_sha256']:dict(path=str(self.bundle.relative_to(self.root)),executable_sha256=self.value['executable_sha256'])})))\n    def history(self):return Historical(self.root,dict(path=str(self.context.relative_to(self.root)),sha256=sha(self.context)))\n    def test_original_source_and_complete_bundle_validate_without_a_live_checkout(self):\n        h=self.history();self.assertEqual(h.source(self.fp),self.source);self.assertEqual(h.application(self.value),self.bundle)\n    def test_changed_missing_or_extra_archived_source_is_rejected(self):\n        p=self.source/'helper.py'\n        p.write_text('changed')\n        with self.assertRaisesRegex(ValueError,'archive membership/content drift'):self.history().source(self.fp)\n        p.unlink()\n        with self.assertRaisesRegex(ValueError,'archive membership/content drift'):self.history().source(self.fp)\n        p.write_text('recorded helper');(self.source/'extra.py').write_text('extra')\n        with self.assertRaisesRegex(ValueError,'archive membership/content drift'):self.history().source(self.fp)\n    def test_changed_bundle_resource_or_executable_cannot_be_historical_evidence(self):\n        p=self.bundle/'Contents/resource';p.write_text('extra')\n        with self.assertRaisesRegex(ValueError,'complete bundle drift'):self.history().application(self.value)\n        p.unlink();(self.bundle/'Contents/MacOS/prisma-airs-desktop').write_text('wrong')\n        with self.assertRaisesRegex(ValueError,'complete bundle drift'):self.history().application(self.value)\n\n\nclass ActualQualificationRegression(unittest.TestCase):\n    def setUp(self):\n        self.root=Path(__file__).resolve().parents[2];self.folder=self.root/'docs/planning/evidence/C45/attempt-02-followup';self.context=dict(path=str((self.folder/'historical-context.json').relative_to(self.root)),sha256=sha(self.folder/'historical-context.json'))\n    def test_actual_historical_145_qualification_survives_unrelated_checkout_and_other_builder(self):\n        from packet import qualification\n        with patch('candidate.source_inventory',return_value={'unrelated/new-source.rs':{'sha256':'different'}}),patch('platform.node',return_value='another-release-builder'),patch('platform.platform',return_value='another-platform'):\n            result=qualification(self.root,self.root/'docs/planning/evidence/C45/attempt-01-followup/qualified-coverage.json',current=False,historical=Historical(self.root,self.context))\n        self.assertTrue(result['verified']['qualified']);self.assertEqual(result['verified']['affected']['tests']['passed'],72)\n    def test_current_candidate_still_rejects_source_or_builder_change(self):\n        candidate=read(self.folder/'candidate.json')\n        with patch('candidate.source_inventory',return_value={'unrelated/new-source.rs':{'sha256':'different'}}):\n            with self.assertRaisesRegex(ValueError,'current build-reuse source changed'):verify_candidate(self.root,candidate)\n        with patch('platform.node',return_value='another-release-builder'):\n            with self.assertRaisesRegex(ValueError,'execution conditions changed'):verify_candidate(self.root,candidate)\n    def test_historical_mode_requires_explicit_hash_bound_context(self):\n        from packet import qualification\n        with self.assertRaisesRegex(ValueError,'requires explicit archive context'):\n            qualification(self.root,self.root/'docs/planning/evidence/C45/attempt-01-followup/qualified-coverage.json',current=False)\n\n\nif __name__=='__main__':unittest.main()\n\"\"\"Causal followup guard negatives; no native UI, services or real credentials.\"\"\"\nfrom pathlib import Path\nimport copy,json,tempfile,unittest\nfrom qualification import sha\nfrom followup import source_delta,raw_checks,COMMANDS\n\n\nclass FollowupTests(unittest.TestCase):\n    def test_named_synthetic_tests_may_change(self):\n        name='crates/xtask/tests/live_run/common.rs';self.assertEqual(source_delta({name:'old'},{name:'new'},[name]),[name])\n\n    def test_production_or_unlisted_source_cannot_be_carried(self):\n        for name in ['apps/desktop/src-tauri/src/lib.rs','crates/xtask/src/live.rs']:\n            with self.assertRaisesRegex(ValueError,'application-affecting'):source_delta({name:'old'},{name:'new'},[name])\n\n    def test_undeclared_changed_test_is_rejected(self):\n        name='crates/xtask/tests/live_run/common.rs'\n        with self.assertRaisesRegex(ValueError,'undeclared'):source_delta({name:'old'},{name:'new'},[])\n\n    def setUp(self):\n        self.temp=tempfile.TemporaryDirectory();self.addCleanup(self.temp.cleanup);self.root=Path(self.temp.name);self.inputs=dict(source='current',dependencies='same',build_flags='same');self.commands=[]\n        for index,(label,argv,tests) in enumerate(COMMANDS):\n            log=self.root/(str(index)+'.log');log.write_text('synthetic retained passing output')\n            self.commands.append(dict(label=label,argv=argv,cwd='.',status='passed',exit_code=0,note=None,log=log.name,output_sha256=sha(log),tests=dict(passed=72,failed=0) if tests else None))\n        self.raw=dict(schema='airs-v2/run/1',subject='C45',run_id='synthetic',status='passed',failure=None,inputs_before=self.inputs,inputs_after=self.inputs,commands=copy.deepcopy(self.commands))\n\n    def verify(self):\n        path=self.root/'run.json';path.write_text(json.dumps(self.raw));return raw_checks(self.root,dict(path='run.json',sha256=sha(path)),self.inputs)\n\n    def test_actual_focused_test_lint_format_command_membership(self):self.assertEqual(self.verify()['commands'],3)\n\n    def test_test_target_cannot_be_omitted_or_replaced(self):\n        self.raw['commands'].pop()\n        with self.assertRaisesRegex(ValueError,'membership'):self.verify()\n        self.raw['commands']=copy.deepcopy(self.commands);self.raw['commands'][0]['argv']=['cargo','test']\n        with self.assertRaisesRegex(ValueError,'mismatch'):self.verify()\n\n    def test_no_tests_or_drifted_log_cannot_pass(self):\n        self.raw['commands'][0]['tests']['passed']=0\n        with self.assertRaisesRegex(ValueError,'not actually executed'):self.verify()\n        self.raw['commands'][0]['tests']['passed']=72;(self.root/'0.log').write_text('changed')\n        with self.assertRaisesRegex(ValueError,'log drift'):self.verify()\n\n    def test_runner_source_and_dependency_fingerprint_must_match(self):\n        self.raw['inputs_after']={**self.inputs,'source':'changed'}\n        with self.assertRaisesRegex(ValueError,'drift'):self.verify()\n\n\nif __name__=='__main__':unittest.main()\n\"\"\"Synthetic exact-artifact/source-delta proof tests, no app or UI execution.\"\"\"\nfrom pathlib import Path\nimport copy,json,platform,tempfile,unittest\nfrom unittest.mock import patch\nfrom candidate import verify_build_reuse,bundle_hash,digest\nfrom qualification import sha\n\n\nclass BuildReuseTests(unittest.TestCase):\n    def setUp(self):\n        self.temp=tempfile.TemporaryDirectory();self.addCleanup(self.temp.cleanup);self.root=Path(self.temp.name)\n        executable=self.root/'fixture.app/Contents/MacOS/prisma-airs-desktop';executable.parent.mkdir(parents=True);executable.write_text('same actual synthetic executable')\n        self.bundle=executable.parents[2]\n        self.before={'apps/source.rs':{'sha256':'unchanged'},'tools/native-acceptance/acceptance_c45.py':{'sha256':'old-selector'}}\n        self.after=copy.deepcopy(self.before);self.after['tools/native-acceptance/acceptance_c45.py']['sha256']='corrected-selector'\n        prepared=dict(bundle='fixture.app',executable_sha256=sha(executable),bundle_sha256=bundle_hash(self.bundle))\n        self.prepared=self.write('prepared.json',prepared)\n        self.original=dict(source_inventory_sha256=digest(self.before),runner_inputs=dict(dependencies='deps',build_flags='flags'),conditions=dict(platform='VM',hostname='worf'),prepare=self.prepared,executable_sha256=prepared['executable_sha256'],bundle_sha256=prepared['bundle_sha256'])\n        self.current=dict(source='new-source',dependencies='deps',build_flags='flags')\n        stage=self.root/'old-stage';stage.mkdir();(stage/'stdout.log').write_text('actual synthetic build output');(stage/'stderr.log').write_text('')\n        state=dict(exit_code=0,argv=['actual-build'],source_fingerprint=digest(self.before),stdout_sha256=sha(stage/'stdout.log'),stderr_sha256=sha(stage/'stderr.log'),artifacts={'prepared.json':self.prepared['sha256']})\n        self.record=dict(schema='airs-desktop/c45-helper-only-build-reuse/1',original_candidate=self.write('old-candidate.json',self.original),original_source=self.write('before.json',{'files':self.before}),current_source=self.write('after.json',{'files':self.after}),original_build_stage=self.write('old-stage/completed.json',state),declared_changed_paths=['tools/native-acceptance/acceptance_c45.py'])\n\n    def write(self,name,value):\n        p=self.root/name;p.parent.mkdir(parents=True,exist_ok=True);p.write_text(json.dumps(value));return dict(path=name,sha256=sha(p))\n\n    def verify(self):\n        with patch('candidate.source_inventory',return_value=self.after):return verify_build_reuse(self.root,self.record,self.current,'VM','worf')\n\n    def test_same_app_full_bundle_and_declared_helper_delta_reuses_actual_build(self):\n        result=self.verify();self.assertFalse(result['new_build_executed']);self.assertEqual(result['executable_sha256'],self.original['executable_sha256'])\n\n    def test_application_source_change_cannot_be_declared_helper_only(self):\n        self.after['apps/source.rs']['sha256']='changed';self.record['current_source']=self.write('after.json',{'files':self.after});self.record['declared_changed_paths'].append('apps/source.rs');self.record['declared_changed_paths'].sort()\n        with self.assertRaisesRegex(ValueError,'application-affecting'):self.verify()\n\n    def test_complete_bundle_change_rejects_reuse_even_when_executable_same(self):\n        (self.bundle/'new-resource').write_text('changed resource')\n        with self.assertRaisesRegex(ValueError,'complete bundle'):self.verify()\n\n    def test_dependencies_and_execution_conditions_must_match(self):\n        self.current['dependencies']='changed'\n        with self.assertRaisesRegex(ValueError,'dependency/toolchain'):self.verify()\n        self.current['dependencies']='deps';self.original['conditions']['hostname']='other';self.record['original_candidate']=self.write('old-candidate.json',self.original)\n        with self.assertRaisesRegex(ValueError,'conditions'):self.verify()\n\n    def test_original_build_logs_cannot_be_edited_and_rebound(self):\n        (self.root/'old-stage/stdout.log').write_text('edited')\n        with self.assertRaisesRegex(ValueError,'log drift'):self.verify()\n\n\nif __name__=='__main__':unittest.main()\nfrom pathlib import Path\nimport tempfile\nimport unittest\nfrom unittest.mock import patch\nimport review_gate\n\n\nclass ReleaseProofTests(unittest.TestCase):\n    def test_isolated_release_interpreter_can_load_qualification_siblings(self):\n        import subprocess\n        root=Path(__file__).resolve().parents[2]\n        result=subprocess.run([\"/usr/bin/python3\",\"-I\",\"-c\",\"import runpy;runpy.run_path('tools/p10/review_gate.py');from packet import qualification;assert callable(qualification)\"],cwd=root,capture_output=True,text=True)\n        self.assertEqual(result.returncode,0,result.stderr)\n\n    def test_missing_actual_p10_proof_blocks_release(self):\n        with tempfile.TemporaryDirectory() as directory:\n            root=Path(directory)\n            with patch.object(review_gate,\"actual_review\",return_value={\"subject\":\"P09\"}):\n                with self.assertRaises(FileNotFoundError):review_gate.release_prerequisites(root)\n\n    def test_unbound_member_or_qualification_cannot_complete_release(self):\n        import json\n        with tempfile.TemporaryDirectory() as directory:\n            root=Path(directory);path=root/\"docs/planning/evidence/P10\";path.mkdir(parents=True)\n            proof=dict(schema=\"airs-desktop/p10-completion-proof/1\",p09={\"subject\":\"P09\"},p10={\"subject\":\"P10\"},attempt=\"attempt-01\",source_archive=\"docs/planning/evidence/P10/source-archive\")\n            (path/\"completion-proof.json\").write_text(json.dumps(proof))\n            with patch.object(review_gate,\"actual_review\",side_effect=[proof[\"p09\"],proof[\"p10\"]]):\n                with self.assertRaises(KeyError):review_gate.release_prerequisites(root)\n\n    def test_actual_historical_transport_and_reject_output_mutations(self):\n        import json,shutil\n        root=Path(__file__).resolve().parents[2]\n        original=root/\"docs/planning/reviews/P09/attempt-02\"\n        request=json.loads((original/\"request.json\").read_text())\n        request[\"execution_root\"]=json.loads((root/\"docs/planning/evidence/C45/activation-20261102-g11/p09-proof.json\").read_text())[\"source_checkout\"]\n        request[\"schema_archive\"]=\"docs/planning/evidence/C45/activation-20261102-g11/p09-source/docs/architecture/review-verdict.schema.json\"\n        self.assertTrue(review_gate.transport(root,original,request)[\"reviewer_sessions_observed\"])\n        for flag,wrong in [(\"-o\",\"/wrong/verdict.json\"),(\"--output-schema\",\"/wrong/schema.json\"),(\"-s\",\"workspace-write\")]:\n            with self.subTest(flag=flag),tempfile.TemporaryDirectory() as directory:\n                out=Path(directory)\n                for name in [\"invocation.json\",\"request.json\",\"feature-probe.log\",\"thread-reply.log\",\"verdict-returned.json\"]:shutil.copy2(original/name,out/name)\n                invocation=json.loads((out/\"invocation.json\").read_text());args=invocation[\"command_without_prompt\"];args[args.index(flag)+1]=wrong\n                (out/\"invocation.json\").write_text(json.dumps(invocation))\n                with self.assertRaisesRegex(ValueError,\"transport\"):review_gate.transport(root,out,request)\n\n\nif __name__ == \"__main__\":unittest.main()\n","exit_code":0,"status":"completed"}}
