{"type":"item.completed","item":{"id":"item_17","type":"command_execution","command":"/bin/zsh -lc 'cat tools/p10/candidate.py tools/p10/historical.py tools/p10/provenance_followup.py'","aggregated_output":"\"\"\"Candidate/source bindings shared by C45 qualification and actual reviews.\"\"\"\nfrom pathlib import Path\nimport ast\nimport os\nimport stat\nimport sys\nsys.path.insert(0,str(Path(__file__).resolve().parents[1]/'p09'))\nfrom phase_packet import source_inventory, file_identity, digest\nfrom qualification import read, sha, require\n\n\ndef bundle_hash(bundle):\n    entries=[]\n    for base, directories, files in os.walk(bundle,followlinks=False):\n        symlinks=[name for name in directories if (Path(base)/name).is_symlink()]\n        directories[:]=[name for name in directories if name not in symlinks]\n        for name in files+symlinks:\n            path=Path(base)/name;relative=str(path.relative_to(bundle))\n            if path.is_symlink():mode='symlink';value=__import__('hashlib').sha256(os.readlink(path).encode()).hexdigest()\n            else:mode='100755' if path.stat().st_mode & 0o111 else '100644';value=sha(path)\n            entries.append((relative,mode,value))\n    text=''.join(f'{name}\\0{mode}\\0{value}\\n' for name,mode,value in sorted(entries))\n    return __import__('hashlib').sha256(text.encode()).hexdigest()\n\n\ndef helper_closure(root, driver):\n    folder=root/'tools/native-acceptance';pending=[driver];seen=set()\n    while pending:\n        name=pending.pop()\n        if name in seen or not (folder/(name+'.py')).is_file():continue\n        seen.add(name);tree=ast.parse((folder/(name+'.py')).read_text())\n        for node in ast.walk(tree):\n            if isinstance(node,ast.Import):pending.extend(alias.name.split('.')[0] for alias in node.names)\n            elif isinstance(node,ast.ImportFrom) and node.module:pending.append(node.module.split('.')[0])\n    paths=['tools/native-acceptance/'+name+'.py' for name in seen]\n    # Native compiled helpers/servers are used through literal paths, not imports.\n    paths += [str(p.relative_to(root)) for p in folder.iterdir() if p.suffix in ['.swift','.js']]\n    paths += ['tools/p10/native.py','tools/p10/candidate.py','docs/planning/evidence/P09/native-controller/native_requirements.py']\n    return {name:sha(root/name) for name in sorted(set(paths))}\n\n\ndef verify_source(root, seal):\n    expected=read(root/seal)['files']\n    require(source_inventory(root)==expected,'sealed source membership/content changed')\n    return digest(expected)\n\n\ndef verify_candidate(root, value, historical=None):\n    prepared=read(root/value['prepare']['path'])\n    require(sha(root/value['prepare']['path'])==value['prepare']['sha256'],'preparation drift')\n    bundle=historical.application(value) if historical else root/prepared['bundle']\n    require(sha(bundle/'Contents/MacOS/prisma-airs-desktop')==value['executable_sha256']==prepared['executable_sha256'],'candidate executable drift')\n    require(bundle_hash(bundle)==value['bundle_sha256']==prepared['bundle_sha256'],'complete candidate bundle drift')\n    helper_root=historical.source(value['source_inventory_sha256']) if historical else root\n    for name,value_hash in value['helper_closure'].items():require(sha(helper_root/name)==value_hash,'candidate helper drift: '+name)\n    if value.get('build_origin'):\n        import platform\n        origin=value['build_origin'];path=root/origin['record']\n        require(sha(path)==origin['sha256'],'build origin proof drift')\n        audit=verify_build_reuse(root,read(path),value['runner_inputs'],platform.platform(),platform.node(),historical=historical)\n        require(audit==origin['audit'],'build reuse audit drift')\n    return value\n\n# Explicit helper/provenance-only transition after the baseline02 startup smoke.\n# No application/config/dependency path is permitted. Old raw build and failed\n# smoke remain immutable; this is not a new execution of that build.\nBUILD_REUSE_PATHS = {\n    'tools/p10/historical.py','tools/p10/test_historical.py',\n    'tools/p10/provenance_followup.py','tools/p10/qualification.py',\n    'tools/p10/review_gate.py','tools/p10/followup.py',\n    'crates/xtask/tests/controlled_live.rs',\n    'crates/xtask/tests/live_run/common.rs',\n    'crates/xtask/examples/c45_baseline.rs',\n    'tools/p10/packet.py','tools/p10/followup.py','tools/p10/test_followup.py',\n    'tools/native-acceptance/acceptance_c04.py',\n    'tools/native-acceptance/test_c04_current_frame.py',\n    'tools/native-acceptance/acceptance_c45.py',\n    'tools/p10/candidate.py', 'tools/p10/test_build_reuse.py',\n    'tools/p10/supervise.py', 'tools/p10/seal.py',\n    'tools/p10/finalize.py', 'tools/p10/native.py',\n    'apps/desktop/src-tauri/tests/permission_manifest.rs',\n    'tools/p10/continuation.py', 'tools/p10/test_continuation.py',\n    'tools/native-acceptance/acceptance_c32_current.py',\n    'tools/native-acceptance/test_c32_project_path.py',\n}\n\n\ndef verify_build_reuse(root, record, current_identity, platform_name, hostname, historical=None):\n    from qualification import bound\n    from stages import verify_completed\n    require(record['schema']=='airs-desktop/c45-helper-only-build-reuse/1','build reuse schema')\n    old=read(bound(root,record['original_candidate']))\n    before=read(bound(root,record['original_source']))['files']\n    after=read(bound(root,record['current_source']))['files']\n    changed=sorted(name for name in set(before)|set(after) if before.get(name)!=after.get(name))\n    require(changed==record['declared_changed_paths'] and set(changed)<=BUILD_REUSE_PATHS,'undeclared or application-affecting build-reuse delta')\n    if historical:\n        historical.source(digest(before));historical.source(digest(after))\n    else:require(source_inventory(root)==after,'current build-reuse source changed')\n    require(digest(before)==old['source_inventory_sha256'],'original source seal/candidate mismatch')\n    require(current_identity['dependencies']==old['runner_inputs']['dependencies'] and current_identity['build_flags']==old['runner_inputs']['build_flags'],'build dependency/toolchain/flags changed')\n    if not historical:require(old['conditions']['platform']==platform_name and old['conditions']['hostname']==hostname,'build execution conditions changed')\n    state_path=bound(root,record['original_build_stage']);state=read(state_path)\n    verify_completed(root,state_path.parent,state,state['argv'],digest(before))\n    prepared=read(bound(root,old['prepare']));bundle=historical.application(old) if historical else root/prepared['bundle']\n    require(sha(bundle/'Contents/MacOS/prisma-airs-desktop')==old['executable_sha256']==prepared['executable_sha256'],'retained executable changed')\n    require(bundle_hash(bundle)==old['bundle_sha256']==prepared['bundle_sha256'],'retained complete bundle changed')\n    return {'original_candidate_sha256':record['original_candidate']['sha256'],'original_build_stage_sha256':record['original_build_stage']['sha256'],'declared_helper_only_delta':changed,'executable_sha256':old['executable_sha256'],'bundle_sha256':old['bundle_sha256'],'new_build_executed':False,'meaning':'Exact unchanged application retained from actual baseline02 build; changed C45 selector and qualification provenance execute current affected verification.'}\n\"\"\"Explicit immutable source/application context for historical qualification.\n\nThis validates what actually ran, not reuse on a current builder. Current reuse\ncontinues to check its own source, helpers, dependencies and machine conditions.\nThe caller must bind this context by hash in the qualified/release proof.\n\"\"\"\nfrom pathlib import Path\nfrom qualification import read,sha,require,bound\nfrom candidate import file_identity,digest,bundle_hash\n\n\nclass Historical:\n    def __init__(self,root,reference):\n        self.root=root;self.reference=reference;self.record=read(bound(root,reference));self.checked={}\n        require(self.record['schema']=='airs-desktop/historical-qualification-context/1','historical context schema')\n\n    def archive_path(self,name):\n        path=self.root/name\n        require(path.resolve().is_relative_to((self.root/'docs/planning/evidence/C45').resolve()),'historical archive escapes C45 evidence')\n        return path\n\n    def source(self,fingerprint):\n        entry=self.record['sources'].get(fingerprint);require(entry,'historical source archive missing')\n        if fingerprint not in self.checked:\n            seal=read(bound(self.root,entry['seal']));files=seal['files'];require(digest(files)==fingerprint,'historical source inventory binding')\n            folder=self.archive_path(entry['path'])\n            actual={str(p.relative_to(folder)):file_identity(p) for p in folder.rglob('*') if p.is_file() or p.is_symlink()}\n            require(actual==files,'historical source archive membership/content drift')\n            self.checked[fingerprint]=folder\n        return self.checked[fingerprint]\n\n    def application(self,candidate):\n        entry=self.record['applications'].get(candidate['bundle_sha256']);require(entry,'historical application archive missing')\n        folder=self.archive_path(entry['path'])\n        require(bundle_hash(folder)==candidate['bundle_sha256'],'historical complete bundle drift')\n        require(sha(folder/'Contents/MacOS/prisma-airs-desktop')==entry['executable_sha256']==candidate['executable_sha256'],'historical executable drift')\n        return folder\n\"\"\"Metadata-only archival correction after real C45 attempt-02.\n\nRetains original145 qualification, source/execution/condition bindings and raw\nscores. No application/native/Rust execution is implied by these Python checks.\n\"\"\"\nimport re\nfrom qualification import read,sha,require,bound\nfrom candidate import source_inventory,digest,verify_candidate\nfrom historical import Historical\n\nALLOWED={'tools/p10/candidate.py','tools/p10/qualification.py','tools/p10/followup.py',\n 'tools/p10/packet.py','tools/p10/review_gate.py','tools/p10/historical.py',\n 'tools/p10/provenance_followup.py','tools/p10/test_historical.py'}\nTESTS=['test_historical.py','test_followup.py','test_build_reuse.py','test_qualification.py','test_review_gate.py']\n\n\ndef verify(root,record,current=True,historical=None):\n    require(record['schema']=='airs-desktop/c45-provenance-followup/1','provenance followup schema')\n    require(current or historical is not None,'historical qualification needs explicit archive context')\n    context=Historical(root,record['historical_context'])\n    if historical:require(historical.reference==context.reference,'historical context binding differs')\n    from packet import qualification\n    previous=qualification(root,bound(root,record['parent_qualification']),current=False,historical=context)\n    candidate=read(bound(root,record['candidate']));parent=read(bound(root,read(bound(root,record['parent_qualification']))['candidate']))\n    before=read(bound(root,record['source_before']))['files'];after=read(bound(root,record['source_after']))['files']\n    require(digest(before)==parent['source_inventory_sha256'],'previous source binding')\n    changed=sorted(n for n in set(before)|set(after) if before.get(n)!=after.get(n))\n    require(changed==record['declared_changed_paths'] and set(changed)<=ALLOWED,'undeclared/application provenance delta')\n    require(digest(after)==candidate['source_inventory_sha256']==record['source_inventory_sha256'],'current provenance source binding')\n    if current:require(source_inventory(root)==after,'current provenance source drift')\n    else:context.source(digest(after))\n    for key in ('executable_sha256','bundle_sha256','build_flags','conditions','dependency_fingerprint'):\n        require(candidate[key]==parent[key],'provenance app/dependencies/conditions changed')\n    require(set(candidate['helper_closure'])==set(parent['helper_closure']),'provenance helper membership')\n    for name,value in parent['helper_closure'].items():\n        if name!='tools/p10/candidate.py':require(candidate['helper_closure'][name]==value,'runtime helper changed')\n    verify_candidate(root,candidate,historical=None if current else context)\n    checks=read(bound(root,record['focused_checks']));require(checks['schema']=='airs-desktop/focused-python-checks/1' and checks['source_before']==checks['source_after']==digest(after),'focused Python source drift')\n    require(len(checks['commands'])==len(TESTS),'focused Python target membership')\n    for command,name in zip(checks['commands'],TESTS):\n        argv=['/usr/bin/python3','-B','-m','unittest','discover','-s','tools/p10','-p',name,'-v']\n        require(command['argv']==argv and command['exit_code']==0 and command['cwd']==candidate['execution_root'] and command['started_utc'] and command['finished_utc'],'focused Python actual command binding')\n        output=bound(root,command['log']).read_text();require(re.search(r'Ran [1-9][0-9]* tests',output) and '\\nOK\\n' in output,'focused Python tests not passing')\n    for name,ref in record['actual_previous_review'].items():require(bound(root,ref)==root/'docs/planning/reviews/C45/attempt-02'/name,'previous actual review binding')\n    return {'qualified':True,'required':previous['verified']['required']+len(TESTS),'previous':previous,'focused_python_targets':len(TESTS),'source_inventory_sha256':digest(after),'candidate_sha256':record['candidate']['sha256'],'meaning':'Historical archives validate original sources/application/helpers/conditions independently of current checkout or builder. Current reuse remains strict. Original145coverage and72synthetic tests retained; only affected Python proof tests executed.'}\n","exit_code":0,"status":"completed"}}
