{"type":"item.completed","item":{"id":"item_40","type":"command_execution","command":"/bin/zsh -lc 'cat tools/native-acceptance/candidate_process.py tools/native-acceptance/acceptance_c45.py'","aggregated_output":"\"\"\"C45 fixture process ownership: exact bundle, executable and PID lifetime.\n\nNo process-name signaling, argument inspection, foreign adoption or installed-app\nlookup. macOS struct layout comes from the selected SDK sys/proc_info.h.\n\"\"\"\nfrom dataclasses import dataclass\nfrom pathlib import Path\nimport ctypes\nimport hashlib\nimport json\nimport os\nimport plistlib\nimport signal\nimport subprocess\nimport sys\nimport time\n\nFIXTURE_ID = 'io.cdot.airs-desktop.fixture'\nEXECUTABLE = 'prisma-airs-desktop'\n\n@dataclass(frozen=True)\nclass Identity:\n    pid: int\n    executable: str\n    birth: tuple\n    parent: int\n\nclass _BsdInfo(ctypes.Structure):\n    _fields_ = [('header', ctypes.c_uint32 * 12), ('comm', ctypes.c_char * 16),\n                ('name', ctypes.c_char * 32), ('misc', ctypes.c_uint32 * 5),\n                ('nice', ctypes.c_int32), ('seconds', ctypes.c_uint64), ('micros', ctypes.c_uint64)]\n\nclass MacProcesses:\n    def __init__(self):\n        if sys.platform != 'darwin':\n            raise RuntimeError('native process ownership requires macOS')\n        self.lib = ctypes.CDLL('/usr/lib/libproc.dylib', use_errno=True)\n        self.lib.proc_pidpath.argtypes = [ctypes.c_int, ctypes.c_void_p, ctypes.c_uint32]\n        self.lib.proc_pidpath.restype = ctypes.c_int\n        self.lib.proc_pidinfo.argtypes = [ctypes.c_int, ctypes.c_int, ctypes.c_uint64, ctypes.c_void_p, ctypes.c_int]\n        self.lib.proc_pidinfo.restype = ctypes.c_int\n\n    def snapshot(self, pid):\n        path = ctypes.create_string_buffer(4096)\n        info = _BsdInfo()\n        if self.lib.proc_pidpath(pid, path, len(path)) <= 0:\n            return None\n        if self.lib.proc_pidinfo(pid, 3, 0, ctypes.byref(info), ctypes.sizeof(info)) != ctypes.sizeof(info):\n            return None\n        if info.header[3] != pid:\n            return None\n        return Identity(pid, os.path.realpath(os.fsdecode(path.value)), (info.seconds, info.micros), info.header[4])\n\n    def pids(self):\n        return [int(p) for p in subprocess.check_output(['/bin/ps', '-axo', 'pid='], text=True).split()]\n\n    def send(self, pid, sig):\n        os.kill(pid, sig)\n\nclass Candidate:\n    def __init__(self, bundle, processes=None, record=None):\n        self.bundle = Path(bundle).resolve(strict=True)\n        info = plistlib.loads((self.bundle/'Contents/Info.plist').read_bytes())\n        if info.get('CFBundleIdentifier') != FIXTURE_ID or info.get('CFBundleExecutable') != EXECUTABLE:\n            raise ValueError('only the chosen C45 fixture bundle is allowed')\n        app_path=(self.bundle/'Contents/MacOS'/EXECUTABLE).resolve(strict=True)\n        engine_path=(self.bundle/'Contents/Resources/harness/airs-harness').resolve()\n        if not app_path.is_relative_to(self.bundle) or not engine_path.is_relative_to(self.bundle):\n            raise ValueError('candidate executable or engine escapes its fixture bundle')\n        self.app_path=str(app_path)\n        self.engine_path=str(engine_path)\n        self.processes = processes if processes is not None else MacProcesses()\n        self.record = Path(record) if record else None\n        self.app = None\n        self.engines_owned = {}\n        self.child = None\n\n    def matching(self, path):\n        return [s for pid in self.processes.pids() if (s := self.processes.snapshot(pid)) and s.executable == path]\n\n    def valid(self, identity):\n        if identity is None:return False\n        current=self.processes.snapshot(identity.pid)\n        return current is not None and (current.pid,current.executable,current.birth)==(identity.pid,identity.executable,identity.birth)\n\n    def publish(self):\n        if self.record:\n            def value(s):return dict(pid=s.pid, executable=s.executable, birth=s.birth, parent=s.parent)\n            data={'schema':'airs-desktop/candidate-processes/1','bundle':str(self.bundle),\n                  'app':value(self.app) if self.app else None,\n                  'engines':[value(s) for s in self.engines_owned.values()],\n                  'meaning':'Observed exact executable/PID birth identities owned by this driver; no process-name or installed-app lookup.'}\n            self.record.parent.mkdir(parents=True,exist_ok=True)\n            self.record.write_text(json.dumps(data,indent=2)+'\\n')\n\n    def app_pid(self):\n        matches = self.matching(self.app_path)\n        if len(matches)>1:\n            raise RuntimeError('multiple candidate processes; no UI or signal allowed')\n        if self.valid(self.app):return self.app.pid\n        if matches:\n            raise RuntimeError('candidate process is not owned by this driver; inspect durable ownership')\n        return None\n\n    def adopt_child(self, pid, parent):\n        identity=self.processes.snapshot(pid)\n        if not identity or identity.executable!=self.app_path or identity.parent!=parent:\n            raise RuntimeError('launched child identity does not match the bound fixture')\n        self.app=identity;self.publish();return pid\n\n    def launch(self):\n        if self.matching(self.app_path) or self.matching(self.engine_path):\n            raise RuntimeError('unowned candidate process exists; no automatic cleanup or duplicate writer')\n        self.child=subprocess.Popen([self.app_path], stdin=subprocess.DEVNULL,\n                                    stdout=subprocess.DEVNULL,stderr=subprocess.DEVNULL)\n        deadline=time.monotonic()+6\n        while time.monotonic()<deadline:\n            if self.child.poll() is not None:raise RuntimeError('fixture executable exited during launch')\n            s=self.processes.snapshot(self.child.pid)\n            if s and s.executable==self.app_path:return self.adopt_child(self.child.pid,os.getpid())\n            time.sleep(.05)\n        raise RuntimeError('fixture child identity was not observed')\n\n    def engines(self):\n        app_pid=self.app_pid()\n        for identity in self.matching(self.engine_path):\n            current=identity;seen=set()\n            while app_pid and current and current.pid not in seen:\n                if current.parent==app_pid:\n                    self.engines_owned[identity.pid]=identity;break\n                seen.add(current.pid);current=self.processes.snapshot(current.parent)\n        self.engines_owned={pid:s for pid,s in self.engines_owned.items() if self.valid(s)}\n        self.publish();return sorted(self.engines_owned)\n\n    def signal_identity(self, identity, sig):\n        if not self.valid(identity):return False\n        self.processes.send(identity.pid,sig);return True\n\n    def signal_app(self, sig=signal.SIGTERM):\n        self.engines()  # establish owned descendants before their parent exits\n        return self.signal_identity(self.app,sig)\n\n    def signal_engine(self,pid,sig=signal.SIGKILL):\n        self.engines();return self.signal_identity(self.engines_owned.get(pid),sig)\n\n    def stop_engines(self):\n        for pid in self.engines():self.signal_engine(pid)\n\n_bound = None\n\ndef bind(bundle):\n    global _bound\n    path=Path(bundle).resolve(strict=True)\n    if _bound is not None and _bound.bundle != path:\n        raise RuntimeError('one driver cannot switch fixture candidates')\n    if _bound is None:\n        prepare=os.environ.get('AIRS_NATIVE_PREPARE')\n        if prepare:\n            p=json.loads(Path(prepare).read_text());expected=(Path.cwd()/p['bundle']).resolve(strict=True)\n            if path!=expected:raise RuntimeError('bundle differs from declared native preparation')\n            executable=path/'Contents/MacOS'/EXECUTABLE\n            if hashlib.sha256(executable.read_bytes()).hexdigest()!=p['executable_sha256']:\n                raise RuntimeError('prepared executable changed')\n        _bound=Candidate(path,record=os.environ.get('AIRS_NATIVE_PROCESS_RECORD'))\n    return _bound\n\ndef current():\n    if _bound is not None:return _bound\n    prepare=os.environ.get('AIRS_NATIVE_PREPARE')\n    if prepare:return bind(Path.cwd()/json.loads(Path(prepare).read_text())['bundle'])\n    return None\n\ndef app_pid():\n    candidate=current();return candidate.app_pid() if candidate else None\n\ndef engine_pids():\n    candidate=current();return candidate.engines() if candidate else []\n\ndef stop_app(sig=signal.SIGTERM):\n    candidate=current()\n    if candidate:candidate.signal_app(sig)\n\ndef stop_engines():\n    candidate=current()\n    if candidate:candidate.stop_engines()\n\ndef signal_engine(pid,sig=signal.SIGKILL):\n    candidate=current();return candidate.signal_engine(pid,sig) if candidate else False\n\"\"\"Current identity/presentation native assertions. Synthetic fixture only.\n\nProduction-interface setup/reset and disposable-file Keychain isolation are\nseparately required by the qualified-coverage consumer. This driver does not\nread actual prior installations or infer those regressions from UI absence.\n\"\"\"\nfrom pathlib import Path\nimport json,os,platform,plistlib,shutil,sys,tempfile,time\nsys.path.insert(0,str(Path(__file__).resolve().parent))\nimport fixture_app as fx\nimport acceptance_c29 as c29\nimport v2_setup as setup\n\nROOT=Path.cwd().resolve()\nBASE=ROOT/'docs/planning/evidence/C45/baseline-03'\nLOG=[]\n\n\ndef main():\n    smoke='--smoke' in sys.argv\n    out=BASE/('startup-smoke-01' if smoke else 'identity')\n    assert not out.exists(),'preserve prior actual driver attempt'\n    out.mkdir(parents=True)\n    prepared=json.loads((BASE/'native-prepare.json').read_text())\n    bundle=ROOT/prepared['bundle']\n    info=plistlib.loads((bundle/'Contents/Info.plist').read_bytes())\n    production=json.loads((ROOT/'apps/desktop/src-tauri/tauri.conf.json').read_text())\n    assert info['CFBundleIdentifier']=='io.cdot.airs-desktop.fixture' and info['CFBundleExecutable']=='prisma-airs-desktop'\n    assert info['CFBundleShortVersionString']=='1.0.0' and production['productName']=='Prisma AIRS Desktop' and production['version']=='1.0.0' and production['identifier']=='io.cdot.airs-desktop'\n    work=Path(tempfile.mkdtemp(prefix='airs-c45-identity-'))\n    before=fx.v1_metadata();app=fx.App(str(bundle),str(work),LOG)\n    observations={'plist':info,'production_config':production,'controlled_prior_before':before,'scope':'Only generated prior-installation canaries; actual old roots and login Keychain are never read.'}\n    def save(name,tree):\n        path=out/(name+'.json');path.write_text(json.dumps(tree,indent=1)+'\\n');return str(path.relative_to(ROOT))\n    try:\n        app.quit();fx.clean_fixture_root();app.launch()\n        tree,first=app.wait_for(lambda t:app.node(t,'AXHeading',setup.WELCOME) is not None,20)\n        assert first,'fresh candidate must show wizard'\n        observations['wizard']=save('fresh-wizard',tree)\n        assert not any('SYNTHETIC-PRIOR-' in text for text in app.texts(tree))\n        # Inspect the native About panel without completing any regional/live setup.\n        app.front()\n        script=f'''tell application \"System Events\" to tell (first application process whose unix id is {app.pid})\nset appMenu to menu bar item 2 of menu bar 1\nset appMenuName to name of appMenu\nif appMenuName does not start with \"Prisma AIRS Desktop\" then error \"Unexpected application menu: \" & appMenuName\nset aboutItem to first menu item of menu 1 of appMenu whose name starts with \"About \"\nclick aboutItem\nreturn appMenuName\nend tell'''\n        result=fx.sh(['osascript','-e',script]);assert result.returncode==0,result.stderr\n        observations['actual_native_application_menu']=result.stdout.strip()\n        tree,about=app.wait_for(lambda t:app.has_text(t,'1.0.0'),10)\n        observations['about']=save('about',tree)\n        assert about and app.has_text(tree,'Prisma AIRS Desktop'),'native About must expose product/version'\n        app.keys('w','command down')\n        app.quit();app.launch()\n        tree,stillfresh=app.wait_for(lambda t:app.node(t,'AXHeading',setup.WELCOME) is not None,20)\n        assert stillfresh,'relaunch before setup must remain fresh'\n        observations['fresh_relaunch']=save('fresh-relaunch',tree)\n        # Explicitly recorded controlled fixtures are checked again after teardown.\n        observations['owned_processes']=json.loads(Path(os.environ['AIRS_NATIVE_PROCESS_RECORD']).read_text())\n        app.quit();fx.clean_fixture_root()\n        observations['controlled_prior_after']=fx.v1_metadata()\n        assert observations['controlled_prior_after']==before,'controlled prior canaries changed'\n        observations['log']=LOG\n        obs=out/'observations.json';obs.write_text(json.dumps(observations,indent=2)+'\\n')\n        if smoke:\n            (out/'smoke.json').write_text(json.dumps({'status':'pass','executable_sha256':prepared['executable_sha256'],'checks':'real direct launch, fresh wizard, native About1.0.0, owned PID controls, fresh relaunch, controlled canary preservation; not cumulative C45 acceptance'},indent=2)+'\\n')\n            return 0\n        # Mapped cumulative assertions and production-interface checks are consumed\n        # by qualification; do not invent a full native/UI proof from this smoke.\n        checks=[{'id':'C45-N01','result':'pass','observation':'Exact renamed fixture/config1.0.0, native About product/version and fresh launch/relaunch are observed. Home-first catalogue, Settings/Sessions focus and headings are required by the same candidate C44/C11 and shell-port baseline, not inferred here.','evidence':[str(obs.relative_to(ROOT)),observations['wizard'],observations['about']]},\n                {'id':'C45-N02','result':'pass','observation':'Fresh wizard and fresh relaunch expose no controlled prior canary, and controlled alpha/v2 canaries remain byte-identical across fixture cleanup/relaunch. Actual FileStore setup/restart/reset and four service isolation are separate required production-interface checks in qualification.','evidence':[str(obs.relative_to(ROOT)),observations['fresh_relaunch']]},\n                {'id':'C45-N03','result':'pass','observation':'The current same-candidate mapped native suite and production-interface/frontend regressions are separately required by qualification for ordinary collections, active helpers, removed intents and all current native assertions. This row explicitly binds their required aggregate rather than claiming they ran within this driver.','evidence':[str((BASE/'native-acceptance.json').relative_to(ROOT)),str(obs.relative_to(ROOT))]}]\n        aggregate=json.loads((BASE/'native-acceptance.json').read_text());assert aggregate['app']['executable_sha256']==prepared['executable_sha256'] and all(c['result']=='pass' for c in aggregate['checks'])\n        inventory={row['id']:row['check'] for row in json.loads((ROOT/'docs/architecture/native-checks.json').read_text())['chunks']['C45']}\n        for check in checks:check['description']=inventory[check['id']]\n        (out/'native-acceptance.json').write_text(json.dumps({'schema':'airs-v2/native-acceptance/1','subject':'C45','method':'cua','performed_by':os.environ['AIRS_NATIVE_ORCHESTRATOR'],'host':platform.platform(),'recorded_utc':time.strftime('%Y-%m-%dT%H:%M:%SZ',time.gmtime()),'app':{'bundle':prepared['bundle'],'identifier':prepared['identifier'],'executable_sha256':prepared['executable_sha256'],'fixture':True},'checks':checks,'limitations':['No actual prior user data or login Keychain accessed; no product calls. Non-adoption/reset/services are separately qualified production-interface regressions. Spoken VoiceOver/signing/installation not claimed.']},indent=2)+'\\n')\n        return 0\n    finally:\n        fx.stop_app();fx.stop_engines();shutil.rmtree(work,ignore_errors=True)\n\n\nif __name__=='__main__':raise SystemExit(main())\n","