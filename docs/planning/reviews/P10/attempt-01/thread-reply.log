{"type":"item.completed","item":{"id":"item_42","type":"command_execution","command":"/bin/zsh -lc 'cat docs/planning/evidence/P09/native-controller/native_requirements.py tools/native-acceptance/legacy_assertions.py'","aggregated_output":"\"\"\"Read the C44 gate's existing assertion map without changing its requirements.\"\"\"\nimport json\nimport re\nimport runpy\n\n\ndef load_requirements(root):\n    manifest = json.loads((root / 'docs/architecture/native-checks.json').read_text())['chunks']\n    data = runpy.run_path(str(root / 'tools/native-acceptance/legacy_assertions.py'))\n    assertions = data['ASSERTIONS']\n    legacy_ids = {c['id'] for chunk, checks in manifest.items()\n                  if re.fullmatch(r'C(0[1-9]|1\\d|2\\d|3[0-3])', chunk) for c in checks}\n    assert legacy_ids == set(assertions), 'legacy map differs from the full manifest'\n    targets = {t for kind, ts, _ in assertions.values()\n               if kind in (data['X'], data['S'], data['P']) for t in ts}\n    self_run = {lid.split('-')[0] for lid, (kind, _, _) in assertions.items() if kind == data['S']}\n    required = {chunk: {t for t in targets if t.startswith(chunk + '-')} for chunk in self_run}\n    # Some legacy ids are carried by a different self-run driver. Only drivers with actual targets run;\n    # the union check below still requires every mapped target to be covered.\n    required = {chunk: checks for chunk, checks in required.items() if checks}\n    for chunk in [f'C{i}' for i in range(35, 45)]:\n        required[chunk] = {c['id'] for c in manifest[chunk]}\n    assert all(required.values()), 'empty required native check set'\n    assert targets <= set().union(*required.values()), 'mapped native target has no driver'\n    return required\n\n\ndef assess_record(record, root, executable_sha256, required):\n    errors = []\n    if record.get('app', {}).get('executable_sha256') != executable_sha256:\n        errors.append('stale executable')\n    checks = {c['id']: c for c in record.get('checks', [])}\n    for cid in sorted(required):\n        check = checks.get(cid)\n        if check is None:\n            errors.append(cid + ' missing')\n        elif check['result'] != 'pass':\n            errors.append(cid + ' ' + check['result'])\n        else:\n            errors.extend(cid + ' missing evidence: ' + e for e in check['evidence'] if not (root / e).exists())\n    carried_elsewhere = [cid for cid, c in checks.items() if cid not in required and c['result'] != 'pass']\n    return errors, carried_elsewhere\n\"\"\"Where every pre-P09 native assertion stands on the one presentation (C44).\n\nEach legacy check id maps to a kind and its targets:\n  x  exercised: the named v2 checks assert the same requirement on the C44 bundle (their results bind the gate).\n  s  self: the legacy driver itself runs on the one presentation through legacy_v2 (run_on_v2.py <cNN> legacy).\n  p  ported: the requirement was added to the named v2 check in C44 (a new fact in that driver's record).\n  r  retired: the requirement concerns the legacy shell or a surface the one presentation does not have (D059: the\n     prototype is the specification; D060: no import from the alpha; the owner on 2026-10-31: the application is\n     driven by the new UI alone). Where the behaviour survives in the core, the retirement names the suite that holds\n     it (crates/desktop-core/tests/<name>, run by the gate's core-fixtures step); that suite result does not stand in\n     for a native assertion and the map says so.\nThe note says which fact of the target carries the requirement. The gate (acceptance_c44.py) fails when an exercised,\nself or ported target is missing or failing on this bundle, or a retirement has no reason.\n\"\"\"\n\nX, S, P, R = \"x\", \"s\", \"p\", \"r\"\n\nASSERTIONS = {\n    # ---- C01 the legacy shell's basics → the v2 shell (C35), the Go menu and the carried-over facts (C44) ----\n    \"C01-N01\": (X, [\"C44-N01\", \"C35-N01\"], \"the fixture app launches from 