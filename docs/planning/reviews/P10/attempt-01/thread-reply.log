{"type":"item.completed","item":{"id":"item_30","type":"command_execution","command":"/bin/zsh -lc 'cat tools/p10/stages.py tools/p10/supervise.py'","aggregated_output":"\"\"\"Immutable actual-stage bindings for recovery and finalization.\"\"\"\nfrom pathlib import Path\nfrom qualification import read,sha,require\n\n\ndef collect(root,base,stage,raw_runner=None):\n    files=[];missing=[]\n    if raw_runner:\n        path=root/raw_runner;raw=read(path);files=[path]+[path.parent/command['log'] for command in raw['commands']]\n    elif stage.startswith('native-'):\n        chunk=stage[len('native-'):].upper()\n        folder=base if chunk=='C44' else base/'identity' if chunk=='C45' else base/'native/cumulative'/chunk\n        path=folder/'native-acceptance.json';raw=read(path);files=[path]\n        for check in raw['checks']:\n            for name in check['evidence']:\n                evidence=root/name\n                if not evidence.exists() and check['result']!='pass':missing.append(name)\n                else:\n                    require(evidence.is_file(),'native raw evidence missing: '+name)\n                    files.append(evidence)\n        if chunk!='C45':\n            wrapper=folder/'execution.json';execution=read(wrapper)\n            require(execution['raw_record_sha256']==sha(path) and execution['controller_sha256']==sha(root/'tools/p10/native.py') and execution['required_check_errors']==[],'native wrapper/raw/controller binding')\n            require(execution['executable_sha256']==read(base/'candidate.json')['executable_sha256'],'native wrapper candidate binding')\n            files.append(wrapper)\n    elif stage=='startup-smoke':files=list((base/'startup-smoke-01').rglob('*.json'))\n    elif stage=='build':files=[root/'docs/planning/evidence/C45/native-prepare.json']\n    elif stage=='finalize':files=[root/'docs/planning/evidence/C45/qualified-coverage.json',base/'qualification-audit.json']\n    return {**{str(path.relative_to(root)):sha(path) for path in sorted(set(files))},**{name:None for name in missing}}\n\n\ndef verify_completed(root,folder,state,argv,source,candidate_sha=None):\n    require(state['exit_code']==0 and state['argv']==argv and state['source_fingerprint']==source,'completed stage command/source failed or differs')\n    require(sha(folder/'stdout.log')==state['stdout_sha256'] and sha(folder/'stderr.log')==state['stderr_sha256'],'completed stage log drift')\n    if candidate_sha:require(state['candidate_sha256']==candidate_sha,'completed stage candidate drift')\n    require(state.get('artifacts'),'completed stage raw artifact binding missing')\n    for name,expected in state['artifacts'].items():\n        if expected is None:require(not (root/name).exists(),'recorded missing superseded raw evidence changed: '+name)\n        else:require(sha(root/name)==expected,'completed stage raw/evidence drift: '+name)\n    return True\n\n\ndef verify_conditions(candidate,current,platform_name,hostname):\n    require({key:current[key] for key in ['source','dependencies','build_flags']}==candidate['runner_inputs'],'dependency/toolchain/build identity changed; diagnose affected checks without blanket replay')\n    require(candidate['conditions']['platform']==platform_name and candidate['conditions']['hostname']==hostname,'execution platform/conditions changed')\n    return True\n\"\"\"One guest Terminal-owned C45 generation; independent of model/tool lifetime.\n\nSealed source, global UI lock, exact candidate/foreground guards, immutable\nper-stage raw results and fail-stop. Re-entry validates completed stages and\ncontinues at the first unfinished stage; it never starts a second UI writer.\n\"\"\"\nfrom pathlib import Path\nimport datetime,fcntl,json,os,platform,shutil,subprocess,sys,time,traceback\nROOT=Path(__file__).resolve().parents[2]\nos.chdir(ROOT)\nsys.path.insert(0,str(Path(__file__).resolve().parent))\nfrom candidate import verify_source,verify_candidate,helper_closure,bundle_hash,verify_build_reuse\nfrom qualification import read,sha,require,digest\nfrom seal import DRIVERS,LEGACY,verify_plan\nfrom stages import collect,verify_completed,verify_conditions\nimport continuation\nBASE=ROOT/'docs/planning/evidence/C45/baseline-03'\nRUN=ROOT/'.evidence-private/worf-agent/2026-11-02-c45-p10-01'\nENV=os.environ.copy()\nENV['PATH']=str(ROOT/'.tools/bin')+':'+str(Path.home()/'.cargo/bin')+':'+str(Path.home()/'.nvm/versions/node/v24.21.0/bin')+':/usr/bin:/bin:/usr/sbin:/sbin'\nfor key in ['RUSTFLAGS','RUSTDOCFLAGS','CARGO_ENCODED_RUSTFLAGS','CARGO_TARGET_DIR','CARGO_BUILD_TARGET','NODE_OPTIONS','NODE_PATH']:ENV.pop(key,None)\nENV['RUST_TEST_THREADS']='4'\nENV['AIRS_NATIVE_ORCHESTRATOR']='Codex'\nENV['PYTHONDONTWRITEBYTECODE']='1'\n\n\ndef now():return datetime.datetime.now(datetime.timezone.utc).isoformat()\n\n\ndef write(path,value):\n    path.parent.mkdir(parents=True,exist_ok=True);temp=path.with_name(path.name+'.tmp');temp.write_text(json.dumps(value,indent=2)+'\\n');temp.replace(path)\n\n\ndef status(state,**extra):\n    value={'time':now(),'state':state,'pid':os.getpid(),'worktree':str(ROOT),**extra}\n    write(RUN/'qualification-status.json',value)\n    with (RUN/'qualification-events.jsonl').open('a') as stream:stream.write(json.dumps(value)+'\\n')\n    print(json.dumps(value),flush=True)\n\n\ndef ancestry():\n    rows={int(parts[0]):(int(parts[1]),parts[2]) for line in subprocess.check_output(['/bin/ps','-axo','pid=,ppid=,comm='],text=True).splitlines() if len(parts:=line.strip().split(None,2))==3}\n    parent=os.getppid();chain=[]\n    while parent in rows and parent>1:\n        pp,command=rows[parent];chain.append(dict(pid=parent,ppid=pp,command=command));parent=pp\n    require(any('Terminal.app/Contents/MacOS/Terminal' in item['command'] for item in chain),'qualification must be guest Terminal-owned')\n    return chain\n\n\ndef foreground():\n    value=subprocess.check_output(['/usr/bin/osascript','-e','tell application \"System Events\" to get bundle identifier of first application process whose frontmost is true'],text=True).strip()\n    require(value in ['com.apple.Terminal','io.cdot.airs-desktop.fixture'],'foreign foreground application: '+value)\n    return value\n\n\ndef source_guard():\n    if (BASE/'continuation-01.json').exists():continuation.verify(ROOT,BASE)\n    return verify_source(ROOT,str(continuation.paths(BASE)['source'].relative_to(ROOT)))\n\ndef candidate_path():return continuation.paths(BASE)['candidate']\n\n\ndef execute(stage,argv,candidate=None):\n    source=source_guard()\n    prior=continuation.retained(ROOT,BASE,stage,argv)\n    if prior:\n        status('retained original passing stage under explicit test-only proof; not reexecuted',stage=stage)\n        return prior[1]\n    folder=continuation.paths(BASE)['stages']/stage;folder.mkdir(parents=True,exist_ok=True)\n    done=folder/'completed.json'\n    if done.exists():\n        old=read(done)\n        verify_completed(ROOT,folder,old,argv,source,sha(candidate_path()) if candidate else None)\n        status('retained valid completed stage',stage=stage);return old\n    require(not (folder/'started.json').exists(),'partial prior stage; inspect actual ownership/results before recovery')\n    if candidate:\n        verify_candidate(ROOT,candidate)\n        require(candidate['conditions']['platform']==platform.platform(),'execution platform/conditions changed; diagnose affected evidence')\n    started=now();write(folder/'started.json',{'argv':argv,'started_utc':started,'source_fingerprint':source,'supervisor_pid':os.getpid(),'foreground':foreground()})\n    status('executing actual stage',stage=stage,argv=argv)\n    with (folder/'stdout.log').open('x') as stdout,(folder/'stderr.log').open('x') as stderr:\n        child=subprocess.Popen(argv,cwd=ROOT,env=ENV,stdin=subprocess.DEVNULL,stdout=stdout,stderr=stderr)\n        write(RUN/'active-stage.json',{'stage':stage,'pid':child.pid,'supervisor_pid':os.getpid(),'started_utc':started,'argv':argv})\n        code=child.wait()\n    require(source_guard()==source,'source changed while stage ran')\n    result={'execution_id':stage+'-'+started,'argv':argv,'exit_code':code,'source_fingerprint':source,'started_utc':started,'finished_utc':now(),'stdout_sha256':sha(folder/'stdout.log'),'stderr_sha256':sha(folder/'stderr.log')}\n    if candidate:result['candidate_sha256']=sha(candidate_path())\n    if stage.startswith('command-') and code==0:\n        raw=read(folder/'stdout.log');require(raw['schema']=='airs-v2/run/1' and raw['status']=='passed','existing runner did not return passing raw RunRecord')\n        raw_path=ROOT/'docs/planning/evidence/C45/runs'/raw['run_id']/'run.json'\n        require(read(raw_path)==raw,'runner stdout differs from immutable original run')\n        result['raw']=str(raw_path.relative_to(ROOT))\n    if code==0:result['artifacts']=collect(ROOT,BASE,stage,result.get('raw'))\n    write(folder/('completed.json' if code==0 else 'failed.json'),result)\n    status('actual stage passed' if code==0 else 'actual stage failed; STOP',stage=stage,exit_code=code)\n    require(code==0,'stage failed; preserve raw results, diagnose affected change only')\n    return result\n\n\ndef main():\n    BASE.mkdir(exist_ok=True)\n    lock=open('/private/tmp/prisma-airs-desktop-native-writer.lock','a+')\n    fcntl.flock(lock,fcntl.LOCK_EX|fcntl.LOCK_NB)\n    chain=ancestry();source=source_guard();plan=read(continuation.paths(BASE)['plan']);verify_plan(ROOT,plan)\n    owner=RUN/'qualification-owner.json'\n    if owner.exists():require(read(owner)['supervisor_sha256']==sha(__file__),'supervisor changed during recovery')\n    write(owner,{'pid':os.getpid(),'time':now(),'source_fingerprint':source,'supervisor_sha256':sha(__file__),'terminal_ancestry':chain,'global_ui_lock':'/private/tmp/prisma-airs-desktop-native-writer.lock'})\n    status('C45 one-generation qualification active',source_fingerprint=source,foreground=foreground())\n    reuse=None\n    if continuation.paths(BASE)['reuse'].exists():\n        current=json.loads(subprocess.check_output(['cargo','run','--locked','-q','-p','xtask','--example','c45_baseline','--','identity'],cwd=ROOT,env=ENV,text=True))\n        reuse=verify_build_reuse(ROOT,read(continuation.paths(BASE)['reuse']),current,platform.platform(),platform.node())\n        write(continuation.paths(BASE)['folder']/'build-reuse-audit.json',reuse)\n        status('retained exact actual baseline02 build; no rebuild executed',build_reuse=reuse)\n    else:\n        execute('build',['cargo','run','--locked','-p','xtask','--','native-prepare','--chunk','C45','--target','aarch64-apple-darwin','--features','test-fixtures'])\n    if not (BASE/'native-prepare.json').exists():shutil.copy2(ROOT/'docs/planning/evidence/C45/native-prepare.json',BASE/'native-prepare.json')\n    if not (candidate_path()).exists():\n        prepared=read(BASE/'native-prepare.json')\n        fp=json.loads(subprocess.check_output(['cargo','run','--locked','-q','-p','xtask','--example','c45_baseline','--','identity'],cwd=ROOT,env=ENV,text=True))\n        candidate={'schema':'airs-desktop/candidate/1','execution_root':str(ROOT),'source_inventory_sha256':source,'executable_sha256':prepared['executable_sha256'],'bundle_sha256':prepared['bundle_sha256'],'prepare':{'path':str((BASE/'native-prepare.json').relative_to(ROOT)),'sha256':sha(BASE/'native-prepare.json')},'helper_closure':plan['helper_closure'],'build_flags':{'features':prepared['features'],'target':prepared['target'],'commands':prepared['commands'],'manifest_sha256':sha(ROOT/'docs/architecture/checks.json')},'conditions':{'platform':platform.platform(),'hostname':platform.node(),'guest':'Worf VM','synthetic_only':True,'RUST_TEST_THREADS':'4','fixture_identifier':prepared['identifier'],'ui_writer':'one guest Terminal-owned exact-PID/birth fixture driver'},'dependency_fingerprint':fp['dependencies'],'runner_inputs':{k:fp[k] for k in ['source','dependencies','build_flags']}}\n        if reuse:candidate['build_origin']={'record':str(continuation.paths(BASE)['reuse'].relative_to(ROOT)),'sha256':sha(continuation.paths(BASE)['reuse']),'audit':reuse}\n        verify_candidate(ROOT,candidate);write(candidate_path(),candidate)\n    candidate=read(candidate_path());verify_candidate(ROOT,candidate)\n    current=json.loads(subprocess.check_output(['cargo','run','--locked','-q','-p','xtask','--example','c45_baseline','--','identity'],cwd=ROOT,env=ENV,text=True))\n    verify_conditions(candidate,current,platform.platform(),platform.node())\n    ENV['AIRS_NATIVE_PREPARE']=str(BASE/'native-prepare.json');ENV['AIRS_NATIVE_PROCESS_RECORD']=str(BASE/'startup-smoke-owned-processes.json')\n    execute('startup-smoke',['python3','tools/native-acceptance/acceptance_c45.py','--smoke'],candidate)\n    for command in plan['commands']:\n        kind='check' if command['label'].startswith('common/') else 'test'\n        execute('command-'+command['label'].replace('/','-'),['cargo','run','--locked','-q','-p','xtask','--example','c45_baseline','--',kind,command['label']],candidate)\n    for driver in DRIVERS:\n        execute('native-'+driver,['python3','tools/p10/native.py',driver]+(['legacy'] if driver in LEGACY else []),candidate)\n    ENV['AIRS_NATIVE_PROCESS_RECORD']=str(BASE/'identity-owned-processes.json')\n    execute('native-c45',['python3','tools/native-acceptance/acceptance_c45.py'],candidate)\n    execute('finalize',['python3','tools/p10/finalize.py'],candidate)\n    status('C45 baseline qualified; actual independent C45/P10 reviews remain',qualified_coverage='docs/planning/evidence/C45/qualified-coverage.json',source_fingerprint=source)\n\n\nif __name__=='__main__':\n    try:main()\n    except Exception:\n        status('FAIL-STOP; inspect raw stage and ownership before recovery',traceback=traceback.format_exc())\n        raise\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_31","type":"command_execution","command":"/bin/zsh -lc 'cat crates/desktop-core/tests/c45_fresh_setup.rs apps/desktop/src-tauri/tests/c45_namespace_isolation.rs'","aggregated_output":"//! C45 fresh setup against real FileStore and production authority, synthetic roots/vaults only.\nuse desktop_core::fixtures::{self, ScriptedVault};\nuse desktop_core::store::FileStore;\nuse desktop_core::vault::{RecordId, Vault};\nuse desktop_core::{\n    AuthorityHandle, Core, CoreConfig, Delivery, Intent, Observation, Receipt, ShellSnapshot,\n    ViewScope,\n};\nuse serde_json::{Value, json};\nuse std::path::{Path, PathBuf};\nuse std::sync::Arc;\nstruct Sandbox(PathBuf);\nimpl Sandbox {\n    fn new() -> Self {\n        let mut n = [0u8; 8];\n        getrandom::fill(&mut n).expect(\"fixture\");\n        let p = std::env::temp_dir().join(format!(\"airs-desktop-c45-{}\", hex::encode(n)));\n        std::fs::create_dir_all(&p).expect(\"root\");\n        Self(p)\n    }\n}\nimpl Drop for Sandbox {\n    fn drop(&mut self) {\n        let _ = std::fs::remove_dir_all(&self.0);\n    }\n}\nstruct Desk {\n    core: Core,\n    handle: AuthorityHandle,\n    session: String,\n    sequence: u64,\n}\nimpl Desk {\n    async fn open(root: &Path, vault: Arc<ScriptedVault>) -> Self {\n        let deadline = std::time::Instant::now() + std::time::Duration::from_secs(3);\n        let store = loop {\n            match FileStore::open(root) {\n                Ok(s) => break s,\n                Err(e) => {\n                    assert!(\n                        std::time::Instant::now() < deadline,\n                        \"new store lease did not release: {e:?}\"\n                    );\n                    tokio::time::sleep(std::time::Duration::from_millis(10)).await;\n                }\n            }\n        };\n        let (mut adapters, _) = fixtures::adapters();\n        adapters.store = Arc::new(store);\n        adapters.keychain = vault;\n        adapters.offline_root = Some(root.join(\"academy-offline\"));\n        adapters.sessions_root = Some(root.join(\"sessions\"));\n        adapters.library_root = Some(root.join(\"library\"));\n        adapters.workbench_root = Some(root.join(\"api-client\"));\n        adapters.logs_root = Some(root.join(\"logs\"));\n        let core = Core::new(\n            CoreConfig {\n                management: desktop_core::management::ManagementEndpoints::at_origin(\n                    \"https://localhost:9\",\n                ),\n                workbench_network: desktop_core::workbench::admission::Network::LoopbackOnly,\n                ..CoreConfig::default()\n            },\n            adapters,\n        );\n        core.start();\n        let handle = core.operator();\n        let session = handle.register_delivery_session().expect(\"delivery\").nonce;\n        Self {\n            core,\n            handle,\n            session,\n            sequence: 0,\n        }\n    }\n    fn snapshot(&self) -> ShellSnapshot {\n        match self.handle.observe(ViewScope::Shell).expect(\"snapshot\") {\n            Observation::Shell { snapshot, .. } => snapshot,\n            _ => unreachable!(\"shell\"),\n        }\n    }\n    fn json(&self) -> Value {\n        serde_json::to_value(self.snapshot()).expect(\"json\")\n    }\n    async fn send(&mut self, value: Value) -> Receipt {\n        self.sequence += 1;\n        self.handle\n            .dispatch(\n                Delivery {\n                    session: self.session.clone(),\n                    sequence: self.sequence,\n                },\n                serde_json::from_value(value).expect(\"typed intent\"),\n            )\n            .await\n            .expect(\"admitted\")\n    }\n}\nasync fn eventually(mut f: impl FnMut() -> bool) {\n    let deadline = std::time::Instant::now() + std::time::Duration::from_secs(4);\n    while !f() {\n        assert!(std::time::Instant::now() < deadline, \"settlement missing\");\n        tokio::time::sleep(std::time::Duration::from_millis(10)).await;\n    }\n}\n#[tokio::test]\nasync fn fresh_bootstrap_restart_and_reset_never_adopt_or_purge_prior_roots_or_credentials() {\n    let sandbox = Sandbox::new();\n    let root = sandbox.0.join(\"io.cdot.airs-desktop.fixture\");\n    let mut old_files = Vec::new();\n    for namespace in [\n        \"io.cdot.prisma-airs-desktop\",\n        \"io.cdot.prisma-airs-desktop.v2\",\n    ] {\n        for name in [\n            \"state.json\",\n            \"sessions/history.canary\",\n            \"api-client/profile.canary\",\n            \"academy-offline/approval.canary\",\n        ] {\n            let p = sandbox.0.join(namespace).join(name);\n            std::fs::create_dir_all(p.parent().expect(\"parent\")).expect(\"old fixture directory\");\n            let bytes=serde_json::to_vec(&json!({\"schema\":\"prisma-airs-desktop-v2/state/1\",\"tenants\":[{\"label\":\"SYNTHETIC-OLD-TENANT\"}],\"credentials\":[\"SYNTHETIC-OLD-CREDENTIAL\"],\"pendingCleanup\":[\"cr-0123456789abcdef\"],\"activeTenant\":\"SYNTHETIC-OLD-ACTIVE\",\"approvals\":[\"SYNTHETIC-OLD-APPROVAL\"],\"sentinel\":name})).expect(\"fixture\");\n            std::fs::write(&p, &bytes).expect(\"seed synthetic old root\");\n            old_files.push((p, bytes));\n        }\n    }\n    let old_vault = Arc::new(ScriptedVault::default());\n    let old_id = RecordId::parse(\"cr-0123456789abcdef\").expect(\"id\");\n    old_vault\n        .put(&old_id, b\"SYNTHETIC-OLD-KEY\")\n        .expect(\"old fixture key\");\n    let old_calls = old_vault.calls();\n    let new_vault = Arc::new(ScriptedVault::default());\n    let mut desk = Desk::open(&root, new_vault.clone()).await;\n    let fresh = desk.json();\n    assert_eq!(fresh[\"storage\"], \"ready\");\n    assert_eq!(fresh[\"onboarding\"], \"needed\");\n    assert_eq!(fresh[\"activeFeature\"], \"home\");\n    assert!(fresh[\"tenants\"].as_array().expect(\"tenants\").is_empty());\n    assert!(fresh[\"active\"].is_null());\n    for key in [\"uiVariant\", \"import\", \"v1Import\"] {\n        assert!(fresh.get(key).is_none(), \"removed contract {key}\");\n    }\n    assert_eq!(\n        old_vault.calls(),\n        old_calls,\n        \"bootstrap makes no old-vault calls\"\n    );\n    assert!(new_vault.records().is_empty());\n    desk.send(json!({\"kind\":\"createTenant\",\"profile\":{\"label\":\"New current tenant\",\"destination\":{\"kind\":\"custom\",\"origin\":\"https://localhost:9\"}}})).await;\n    let context = desk.json()[\"active\"][\"context\"].clone();\n    desk.send(json!({\"kind\":\"configureScanCredential\",\"context\":context,\"mode\":\"keychain\",\"key\":\"SYNTHETIC-NEW-C45-KEY\"})).await;\n    eventually(|| desk.json()[\"tenants\"][0][\"scan\"][\"state\"] == \"ready\").await;\n    let document: Value =\n        serde_json::from_slice(&std::fs::read(root.join(\"state.json\")).expect(\"new state\"))\n            .expect(\"document\");\n    assert_eq!(document[\"schema\"], \"prisma-airs-desktop/state/1\");\n    assert!(!document.to_string().contains(\"SYNTHETIC-NEW-C45-KEY\"));\n    desk.core.shutdown();\n    drop(desk);\n    let mut restarted = Desk::open(&root, new_vault.clone()).await;\n    assert_eq!(\n        restarted.json()[\"tenants\"][0][\"label\"],\n        \"New current tenant\"\n    );\n    assert_eq!(\n        restarted.json()[\"tenants\"]\n            .as_array()\n            .expect(\"tenants\")\n            .len(),\n        1\n    );\n    restarted.send(json!({\"kind\":\"resetLocalData\"})).await;\n    eventually(|| {\n        restarted.json()[\"storage\"] == \"ready\"\n            && restarted.json()[\"tenants\"]\n                .as_array()\n                .is_some_and(|v| v.is_empty())\n    })\n    .await;\n    assert!(new_vault.records().is_empty());\n    assert_eq!(\n        old_vault.calls(),\n        old_calls,\n        \"restart/reset make no old-vault calls\"\n    );\n    assert_eq!(\n        old_vault.secret(&old_id).as_deref(),\n        Some(b\"SYNTHETIC-OLD-KEY\".as_slice())\n    );\n    for (path, bytes) in old_files {\n        assert_eq!(\n            std::fs::read(path).expect(\"old synthetic sentinel\"),\n            bytes,\n            \"old root is byte-identical\"\n        );\n    }\n    restarted.core.shutdown();\n}\n#[test]\nfn retired_variant_profile_and_alpha_adoption_actions_are_not_native_intents() {\n    for value in [\n        json!({\"kind\":\"setUiVariant\",\"variant\":\"legacy\"}),\n        json!({\"kind\":\"chooseProfileImport\"}),\n        json!({\"kind\":\"inspectV1Import\"}),\n        json!({\"kind\":\"workbench\",\"request\":{\"kind\":\"readAdoption\"}}),\n    ] {\n        assert!(\n            serde_json::from_value::<Intent>(value).is_err(),\n            \"retired request cannot cross authority\"\n        );\n    }\n}\n//! C45 protected-service isolation using one disposable FILE keychain only.\n//! No login Keychain, production data, search-list query or live endpoint.\n#![cfg(target_os = \"macos\")]\nuse desktop_core::CredentialStore;\nuse desktop_core::vault::{RecordId, Vault, VaultError};\nuse desktop_host::keychain::{\n    ACADEMY_SERVICE, FIXTURE_ACADEMY_SERVICE, FIXTURE_SCAN_SERVICE, Interaction, KeychainStore,\n    SCAN_SERVICE,\n};\nuse std::path::PathBuf;\nstruct FileKeychain(PathBuf);\nimpl Drop for FileKeychain {\n    fn drop(&mut self) {\n        let _ = std::process::Command::new(\"/usr/bin/security\")\n            .args([\"delete-keychain\", self.0.to_str().unwrap_or_default()])\n            .output();\n        let _ = std::fs::remove_file(&self.0);\n    }\n}\n#[test]\nfn new_scan_and_academy_services_do_not_read_or_purge_prior_or_other_new_services() {\n    let mut entropy = [0u8; 8];\n    getrandom::fill(&mut entropy).expect(\"synthetic identity\");\n    let file = FileKeychain(std::env::temp_dir().join(format!(\n            \"airs-desktop-c45-{}.keychain-db\",\n            entropy\n                .iter()\n                .map(|b| format!(\"{b:02x}\"))\n                .collect::<String>()\n        )));\n    let services = [\n        \"io.cdot.prisma-airs-desktop\",\n        \"io.cdot.prisma-airs-desktop.academy\",\n        \"io.cdot.prisma-airs-desktop.v2.scan\",\n        \"io.cdot.prisma-airs-desktop.v2.academy\",\n        \"io.cdot.prisma-airs-desktop.v2.fixture.scan\",\n        \"io.cdot.prisma-airs-desktop.v2.fixture.academy\",\n        SCAN_SERVICE,\n        ACADEMY_SERVICE,\n        FIXTURE_SCAN_SERVICE,\n        FIXTURE_ACADEMY_SERVICE,\n    ];\n    assert_eq!(SCAN_SERVICE, \"io.cdot.airs-desktop.scan\");\n    assert_eq!(ACADEMY_SERVICE, \"io.cdot.airs-desktop.academy\");\n    assert_eq!(FIXTURE_SCAN_SERVICE, \"io.cdot.airs-desktop.fixture.scan\");\n    assert_eq!(\n        FIXTURE_ACADEMY_SERVICE,\n        \"io.cdot.airs-desktop.fixture.academy\"\n    );\n    let stores: Vec<_> = services\n        .iter()\n        .map(|service| {\n            KeychainStore::file(\n                &file.0,\n                \"SYNTHETIC-C45-PRIVATE-FILE\",\n                service,\n                Interaction::Disallowed,\n            )\n            .expect(\"private file store\")\n        })\n        .collect();\n    let id =\n        RecordId::parse(\"cr-0123456789abcdef\").expect(\"same synthetic account across services\");\n    for (index, store) in stores.iter().take(6).enumerate() {\n        store\n            .put(&id, format!(\"SYNTHETIC-OLD-{index}\").as_bytes())\n            .expect(\"seed private canary\");\n    }\n    for store in stores.iter().skip(6) {\n        assert_eq!(\n            store.get(&id).err(),\n            Some(VaultError::NotFound),\n            \"old-only account cannot be read through a new service\"\n        );\n    }\n    for (index, store) in stores.iter().enumerate().skip(6) {\n        store\n            .put(&id, format!(\"SYNTHETIC-NEW-{index}\").as_bytes())\n            .expect(\"new item\");\n    }\n    for index in 6..stores.len() {\n        stores[index].purge().expect(\"exact service purge\");\n        assert_eq!(stores[index].get(&id).err(), Some(VaultError::NotFound));\n        for (old, store) in stores.iter().take(6).enumerate() {\n            assert_eq!(\n                store.get(&id).expect(\"old file canary intact\").as_slice(),\n                format!(\"SYNTHETIC-OLD-{old}\").as_bytes()\n            );\n        }\n        for (other, store) in stores.iter().enumerate().skip(index + 1) {\n            assert_eq!(\n                store.get(&id).expect(\"other new service intact\").as_slice(),\n                format!(\"SYNTHETIC-NEW-{other}\").as_bytes()\n            );\n        }\n    }\n}\n","exit_code":0,"status":"completed"}}
