'\n-export type { ItemStatus } from './generated/ItemStatus'\n-export type { PlanItemView } from './generated/PlanItemView'\n-export type { PlanView } from './generated/PlanView'\n-export type { Problem } from './generated/Problem'\n-export type { ReceiptItemView } from './generated/ReceiptItemView'\n-export type { ReceiptState } from './generated/ReceiptState'\n-export type { ReceiptView } from './generated/ReceiptView'\n-export type { SourceState } from './generated/SourceState'\n-export type { TargetChoice } from './generated/TargetChoice'\n-export type { TenantTarget } from './generated/TenantTarget'\n-export type { V1ImportView } from './generated/V1ImportView'\n-export type { V1TenantChoice } from './generated/V1TenantChoice'\n export type { DiagnosticsClear } from './generated/DiagnosticsClear'\n export type { DiagnosticsExport } from './generated/DiagnosticsExport'\n export type { DiagnosticsView } from './generated/DiagnosticsView'\ndiff --git a/tools/reference-validator/validate_receipt.py b/tools/reference-validator/validate_receipt.py\nindex 1e717fbf..f0869eaa 100755\n--- a/tools/reference-validator/validate_receipt.py\n+++ b/tools/reference-validator/validate_receipt.py\n@@ -604,7 +604,7 @@ def validate(root, receipt_path, current=None):\n             if prepared:\n                 prep = json.loads(prepared)\n                 bundle = prep[\"bundle\"]\n-                exe = load(root, os.path.join(bundle, \"Contents/MacOS/prisma-airs-desktop-v2\"))\n+                exe = load(root, os.path.join(bundle, \"Contents/MacOS/prisma-airs-desktop\"))\n                 bundle_path = os.path.join(root, bundle)\n                 if rec[\"app\"][\"bundle\"] != bundle:\n                     reasons.append(\"native record names another bundle\")\n","exit_code":0,"status":"completed"}}
