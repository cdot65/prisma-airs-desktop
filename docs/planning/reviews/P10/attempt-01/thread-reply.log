{\"kind\": \"confirmProfileImport\", \"review\": review, \"selected\": [0]}))\n-            .await,\n-        Err(Refusal::ReviewConsumed)\n-    );\n-    assert!(desk.adapters.vault.calls().is_empty());\n-}\n-\n-#[tokio::test]\n-async fn cancelled_or_unsupported_import_leaves_tenants_unchanged() {\n-    let mut desk = Desk::new();\n-    desk.create(\"Tenant A\").await;\n-    let before = desk.snap().tenants;\n-    desk.adapters.picker.reply(None);\n-    desk.send(json!({\"kind\": \"chooseProfileImport\"}))\n-        .await\n-        .expect(\"sheet\");\n-    assert!(eventually(|| matches!(desk.snap().import, ImportView::Idle)).await);\n-    desk.adapters\n-        .picker\n-        .reply(Some(Ok((\"notes.txt\".into(), b\"just text\".to_vec()))));\n-    desk.send(json!({\"kind\": \"chooseProfileImport\"}))\n-        .await\n-        .expect(\"sheet\");\n-    assert!(eventually(|| matches!(desk.snap().import, ImportView::Failed { .. })).await);\n-    assert_eq!(desk.snap().tenants, before);\n-    assert_eq!(desk.adapters.picker.opened(), 2);\n-}\n-\n #[tokio::test]\n async fn reset_purges_the_namespace_and_removes_the_document() {\n     let mut desk = Desk::new();\ndiff --git a/crates/desktop-core/tests/dlp_subset/main.rs b/crates/desktop-core/tests/dlp_subset/main.rs\nindex 506ae633..d454e125 100644\n--- a/crates/desktop-core/tests/dlp_subset/main.rs\n+++ b/crates/desktop-core/tests/dlp_subset/main.rs\n@@ -12,9 +12,9 @@ mod support;\n \n use std::sync::{Arc, Mutex};\n \n+use desktop_core::ImportError;\n use desktop_core::changes::ChangeProblem;\n use desktop_core::fixtures::{self, Handles};\n-use desktop_core::import::ImportError;\n use desktop_core::management::{ManagementEndpoints, ManagementFailure};\n use desktop_core::runtime::Outcome;\n use desktop_core::transport::{ProxyMode, TransportPolicy};\ndiff --git a/crates/desktop-core/tests/gateway_inference/main.rs b/crates/desktop-core/tests/gateway_inference/main.rs\nindex 6add2b82..710a647b 100644\n--- a/crates/d