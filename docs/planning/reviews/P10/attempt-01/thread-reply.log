{"type":"item.completed","item":{"id":"item_21","type":"command_execution","command":"/bin/zsh -lc 'cat tools/p10/qualification.py tools/p10/followup.py tools/p10/seal.py'","aggregated_output":"\"\"\"Explicit C45/P10 evidence accounting. Does not execute checks or assign scores.\n\nThe existing runners produce raw records; this consumer rejects omitted coverage,\nchanged evidence, unsupported retirement and affected checks carried as unchanged.\nHistorical results always retain their original candidate and execution bindings.\n\"\"\"\nfrom pathlib import Path\nimport hashlib\nimport json\n\n\ndef require(value, message):\n    if not value:\n        raise ValueError(message)\n\n\ndef read(path):\n    return json.loads(Path(path).read_text())\n\n\ndef sha(path):\n    return hashlib.sha256(Path(path).read_bytes()).hexdigest()\n\n\ndef digest(value):\n    return hashlib.sha256((json.dumps(value, sort_keys=True, separators=(\",\", \":\")) + \"\\n\").encode()).hexdigest()\n\n\ndef bound(root, reference):\n    path = root / reference[\"path\"]\n    require(path.resolve().is_relative_to(root.resolve()), \"evidence escapes checkout\")\n    require(sha(path) == reference[\"sha256\"], \"evidence hash drift: \" + str(path))\n    return path\n\n\nEXACT_FIELDS = (\"executable_sha256\", \"bundle_sha256\", \"build_flags\", \"conditions\")\n\n\ndef verify_raw(root, needed, execution, origin):\n    require(execution[\"argv\"] == needed[\"argv\"], \"execution command differs from approved plan\")\n    require(execution[\"cwd\"] == origin[\"execution_root\"], \"execution cwd differs from original candidate\")\n    raw_path = bound(root, execution[\"raw\"])\n    raw = read(raw_path)\n    if needed[\"kind\"] == \"native\":\n        require(raw[\"schema\"] == \"airs-v2/native-acceptance/1\" and raw[\"app\"][\"executable_sha256\"] == origin[\"executable_sha256\"], \"raw native candidate mismatch\")\n        checks = [check for check in raw[\"checks\"] if check[\"id\"] == needed[\"id\"]]\n        require(len(checks) == 1 and checks[0][\"result\"] == \"pass\" and checks[0].get(\"observation\") and checks[0].get(\"evidence\"), \"raw native assertion not passing\")\n        for name in checks[0][\"evidence\"]:\n            require(name in execution[\"evidence\"], \"native evidence missing from execution inventory\")\n            bound(root, {\"path\":name,\"sha256\":execution[\"evidence\"][name]})\n    elif needed[\"kind\"] == \"command\":\n        require(raw[\"schema\"] == \"airs-v2/run/1\" and raw[\"status\"] == \"passed\" and raw[\"failure\"] is None and raw[\"inputs_before\"] == raw[\"inputs_after\"], \"raw runner failed or inputs changed\")\n        require(raw[\"inputs_before\"] == origin[\"runner_inputs\"], \"runner input fingerprint does not bind original candidate\")\n        commands = [command for command in raw[\"commands\"] if command[\"label\"] == needed[\"label\"]]\n        require(len(commands) == 1, \"raw runner command missing/duplicated\")\n        command = commands[0]\n        require(command[\"status\"] == \"passed\" and command[\"exit_code\"] == 0 and command[\"argv\"] == needed[\"argv\"] and command[\"cwd\"] in [\".\", origin[\"execution_root\"]] and not command[\"note\"], \"raw runner command failed/differs\")\n        require(command[\"output_sha256\"] == execution[\"log\"][\"sha256\"] and str((raw_path.parent/command[\"log\"]).relative_to(root)) == execution[\"log\"][\"path\"], \"raw runner log binding\")\n        if needed.get(\"expects_tests\"):\n            require(command[\"tests\"] and command[\"tests\"][\"passed\"] > 0 and command[\"tests\"][\"failed\"] == 0, \"test command did not execute passing tests\")\n    else:\n        raise ValueError(\"unsupported required raw execution kind\")\n\n\ndef verify(root, record, historical=None):\n    require(record[\"schema\"] == \"airs-desktop/qualified-coverage/1\", \"coverage schema\")\n    plan = read(bound(root, record[\"plan\"]))\n    require(plan[\"schema\"] == \"airs-desktop/required-coverage/1\", \"plan schema\")\n    requirements = plan[\"requirements\"]\n    ids = [item[\"id\"] for item in requirements]\n    require(len(ids) == len(set(ids)) and ids, \"duplicate/empty required coverage\")\n    rows = record[\"coverage\"]\n    require(len(rows) == len(ids) and {r[\"id\"] for r in rows} == set(ids), \"missing/duplicate/unknown coverage\")\n    by_id = {item[\"id\"]: item for item in requirements}\n    candidate = read(bound(root, record[\"candidate\"]))\n    require(all(candidate.get(k) for k in EXACT_FIELDS) and candidate.get(\"helper_closure\"), \"candidate binding incomplete\")\n    require(candidate.get(\"source_inventory_sha256\") == record[\"source_inventory_sha256\"], \"candidate source binding\")\n    for row in rows:\n        needed = by_id[row[\"id\"]]\n        mode = row[\"disposition\"]\n        require(mode in [\"executed\", \"reused_exact\", \"carried_unaffected\", \"not_applicable\"], \"unsupported coverage disposition\")\n        if mode == \"not_applicable\":\n            decision = needed.get(\"retirement\")\n            require(decision and row.get(\"reason\") and row.get(\"decision\") == decision, \"unapproved assertion retirement\")\n            bound(root, decision)\n            continue\n        original = read(bound(root, row[\"result\"]))\n        require(original.get(\"status\") == \"pass\" and original.get(\"exit_code\") == 0, \"result is not an actual passing execution\")\n        require(original.get(\"execution_id\") and original.get(\"argv\") and original.get(\"cwd\") and original.get(\"started_utc\") and original.get(\"finished_utc\"), \"execution provenance missing\")\n        require(row[\"id\"] in original.get(\"required_ids\", []), \"result does not cover required assertion\")\n        bound(root, original[\"log\"])\n        origin = read(bound(root, original[\"candidate\"]))\n        require(all(origin.get(k) for k in EXACT_FIELDS) and origin.get(\"helper_closure\"), \"original candidate binding incomplete\")\n        verify_raw(root, needed, original, origin)\n        if mode in [\"executed\", \"reused_exact\"]:\n            if mode == \"reused_exact\":\n                require(not needed.get(\"must_execute\", needed.get(\"affected\", True)), \"changed check must execute\")\n            helpers = needed.get(\"helper_paths\")\n            if helpers is None:\n                require(origin[\"helper_closure\"] == candidate[\"helper_closure\"], \"relevant helper closure differs\")\n            else:\n                require(all(name in origin[\"helper_closure\"] and name in candidate[\"helper_closure\"] and origin[\"helper_closure\"][name] == candidate[\"helper_closure\"][name] for name in helpers), \"relevant helper closure differs\")\n            require(all(origin[k] == candidate[k] for k in EXACT_FIELDS), \"artifact/helper/flags/conditions differ\")\n            if mode == \"executed\":\n                require(origin[\"source_inventory_sha256\"] == record[\"source_inventory_sha256\"], \"execution is historical, not current\")\n        else:\n            require(not needed.get(\"affected\", True), \"affected check cannot be carried unchanged\")\n            rationale = row.get(\"impact\")\n            require(rationale and rationale.get(\"reason\") and rationale.get(\"dependencies\") == needed.get(\"dependencies\") and rationale.get(\"original_candidate_sha256\") == original[\"candidate\"][\"sha256\"], \"unchanged-impact proof missing\")\n            proof = read(bound(root, rationale[\"proof\"]))\n            bindings = proof.get(\"file_bindings\", {})\n            require(set(bindings) == set(needed[\"dependencies\"]) and bindings, \"dependency membership proof missing\")\n            current_files=historical.source(record['source_inventory_sha256']) if historical else root\n            original_files=historical.source(origin['source_inventory_sha256']) if historical else root\n            for dependency, binding in bindings.items():\n                require(binding[\"original_sha256\"] == binding[\"current_sha256\"] == sha(current_files/dependency), \"dependency changed: \" + dependency)\n                original_source = original_files/dependency if historical else bound(root, binding[\"original_file\"])\n                require(sha(original_source) == binding[\"original_sha256\"], \"original dependency proof mismatch\")\n            require(proof.get(\"unchanged_dependencies\") == needed[\"dependencies\"] and proof.get(\"current_source_inventory_sha256\") == record[\"source_inventory_sha256\"] and proof.get(\"original_candidate_sha256\") == original[\"candidate\"][\"sha256\"], \"impact proof does not bind current and original inputs\")\n    return {\"qualified\": True, \"required\": len(ids), \"dispositions\": {m: sum(r[\"disposition\"] == m for r in rows) for m in sorted({r[\"disposition\"] for r in rows})}, \"candidate_sha256\": record[\"candidate\"][\"sha256\"], \"source_inventory_sha256\": record[\"source_inventory_sha256\"]}\n\"\"\"Explicit affected C45 attempt-01 followup, never a relabeled baseline.\n\nThe original 142-ID qualification and actual 9/9/9/8/8 review remain immutable.\nOnly named synthetic tests and administrative proof consumers may differ. The\ncurrent source, original exact app, unchanged runtime helpers and real focused\nRunner results are all required before a fresh independent review.\n\"\"\"\nfrom pathlib import Path\nimport json,platform\nfrom qualification import read,sha,require,bound,verify as verify_coverage\nfrom candidate import source_inventory,digest,verify_candidate,verify_build_reuse\n\nALLOWED={\n 'crates/xtask/tests/controlled_live.rs','crates/xtask/tests/live_run/common.rs',\n 'crates/xtask/examples/c45_baseline.rs','tools/p10/candidate.py',\n 'tools/p10/packet.py','tools/p10/followup.py','tools/p10/test_followup.py',\n}\nCOMMANDS=[\n ('C45/followup-live',['cargo','test','--locked','-p','xtask','--features','test-fixtures','--test','controlled_live','--test','live_run'],True),\n ('C45/followup-live-clippy',['cargo','clippy','--locked','-p','xtask','--features','test-fixtures','--test','controlled_live','--test','live_run','--example','c45_baseline','--','-D','warnings'],False),\n ('C45/followup-fmt',['cargo','fmt','--all','--','--check'],False),\n]\nMETA_ONLY={'tools/p10/candidate.py'}\n\n\ndef source_delta(before,after,declared):\n    changed=sorted(n for n in set(before)|set(after) if before.get(n)!=after.get(n))\n    require(changed==declared and set(changed)<=ALLOWED,'undeclared or application-affecting followup delta')\n    return changed\n\n\ndef raw_checks(root,record,inputs):\n    raw=read(bound(root,record))\n    require(raw['schema']=='airs-v2/run/1' and raw['subject']=='C45' and raw['status']=='passed' and raw['failure'] is None,'affected runner did not pass')\n    require(raw['inputs_before']==raw['inputs_after']==inputs,'affected runner source/dependency/flags drift')\n    require(len(raw['commands'])==len(COMMANDS),'affected command membership')\n    for command,(label,argv,tests) in zip(raw['commands'],COMMANDS):\n        require(command['label']==label and command['argv']==argv and command['cwd'] in ['.',str(root)] and command['status']=='passed' and command['exit_code']==0 and not command['note'],'affected command mismatch/failure')\n        require(sha(root/record['path']).strip()==record['sha256'],'raw runner changed')\n        log=(root/record['path']).parent/command['log']\n        require(log.resolve().is_relative_to(root.resolve()) and sha(log)==command['output_sha256'],'affected log drift')\n        if tests:require(command['tests'] and command['tests']['passed']>0 and command['tests']['failed']==0,'affected tests not actually executed')\n    return {'run_id':raw['run_id'],'commands':len(COMMANDS),'tests':raw['commands'][0]['tests']}\n\n\ndef verify(root,record,current=True,historical=None):\n    require(record['schema']=='airs-desktop/c45-affected-followup/1','followup schema')\n    baseline=read(bound(root,record['baseline_qualification']));base_result=verify_coverage(root,baseline,historical=historical)\n    old=read(bound(root,baseline['candidate']));candidate=read(bound(root,record['candidate']))\n    before=read(bound(root,record['source_before']))['files'];after=read(bound(root,record['source_after']))['files']\n    require(digest(before)==baseline['source_inventory_sha256']==old['source_inventory_sha256'],'baseline source binding')\n    source_delta(before,after,record['declared_changed_paths'])\n    require(digest(after)==candidate['source_inventory_sha256']==record['source_inventory_sha256'],'current followup source binding')\n    if current:require(source_inventory(root)==after,'followup current source drift')\n    # No historical source/helper hash is relabeled as current. The entire\n    # application/config/dependency tree outside the named delta is unchanged.\n    for key in ('executable_sha256','bundle_sha256','build_flags','conditions','dependency_fingerprint'):\n        require(candidate[key]==old[key],'followup app/build/conditions/dependencies changed: '+key)\n    require(set(candidate['helper_closure'])==set(old['helper_closure']),'runtime helper membership changed')\n    helper_root=historical.source(record['source_inventory_sha256']) if historical else root\n    for name,value in old['helper_closure'].items():\n        if name not in META_ONLY:require(candidate['helper_closure'][name]==value==sha(helper_root/name),'runtime helper changed: '+name)\n    verify_candidate(root,candidate,historical=historical)\n    checks=raw_checks(root,record['focused_run'],candidate['runner_inputs'])\n    for failure in record['old_red']:\n        path=bound(root,failure);require(failure['exit_code']==101 and 'test result: FAILED.' in path.read_text(),'causal original failure proof missing')\n    review=root/'docs/planning/reviews/C45/attempt-01'\n    for name,ref in record['actual_previous_review'].items():require(bound(root,ref)==review/name,'previous actual review binding')\n    audit=read(review/'post-review-audit.json');require(audit['scores']=={'architecture':9,'behavior':9,'authority_security':9,'validation':8,'overall':8} and audit['full_gate_pass'] is False,'actual previous review changed')\n    return {'qualified':True,'required':base_result['required']+len(COMMANDS),'baseline':base_result,'affected':checks,'source_inventory_sha256':digest(after),'candidate_sha256':record['candidate']['sha256'],'meaning':'Original baseline stays historical; named test/provenance-only delta, exact unchanged app/runtime helpers and new affected checks verified. No new native or baseline execution claimed.'}\n\n\ndef prepare(root):\n    import copy\n    folder=root/'docs/planning/evidence/C45/attempt-01-followup';require(not folder.exists(),'preserve prior followup');folder.mkdir()\n    ref=lambda p:dict(path=str(p.relative_to(root)),sha256=sha(p))\n    baseline=root/'docs/planning/evidence/C45/qualified-coverage.json';old=read(bound(root,read(baseline)['candidate']))\n    previous=root/'docs/planning/evidence/C45/baseline-03/continuation-04/source-seal.json'\n    before=read(previous)['files'];after=source_inventory(root);changed=sorted(n for n in set(before)|set(after) if before.get(n)!=after.get(n));source_delta(before,after,changed)\n    seal=folder/'source-seal.json';seal.write_text(json.dumps(dict(files=after,source_fingerprint=digest(after)),indent=2)+'\\n')\n    proof=copy.deepcopy(read(root/old['build_origin']['record']));proof['current_source']=ref(seal);origin=read(bound(root,proof['original_source']))['files'];proof['declared_changed_paths']=sorted(n for n in set(origin)|set(after) if origin.get(n)!=after.get(n));proof['reason']='Actual C45attempt01 synthetic fixture namespace remediation plus focused Runner/proof consumers only; exact application/config/dependencies/native helpers unchanged. No rebuild.';proof['checks_to_execute']='Only affected synthetic controlled_live/live_run tests, their Clippy and formatting. Original142 baseline results retained unchanged.'\n    proof_path=folder/'build-reuse.json';proof_path.write_text(json.dumps(proof,indent=2)+'\\n')\n    candidate=copy.deepcopy(old);candidate.update(source_inventory_sha256=digest(after),helper_closure={n:sha(root/n) for n in old['helper_closure']})\n    # Filled from the actual current cheap Runner identity before focused tests.\n    return folder,candidate,proof\n\n\nif __name__=='__main__':\n    import sys\n    root=Path.cwd().resolve()\n    if sys.argv[1:]==['verify']:\n        p=root/'docs/planning/evidence/C45/attempt-01-followup/qualified-coverage.json';print(json.dumps(verify(root,read(p)),indent=2))\n\"\"\"Create the one C45 baseline seal after focused preflight; never overwrite.\"\"\"\nfrom pathlib import Path\nimport json,sys\nfrom candidate import source_inventory,digest,helper_closure\nfrom qualification import read,sha,require\nsys.path.insert(0,str(Path.cwd()/'docs/planning/evidence/P09/native-controller'))\nfrom native_requirements import load_requirements\n\nDRIVERS=['c36','c43','c32','c31','c39','c11','c10','c03','c04','c05','c06','c07','c24','c35','c37','c38','c40','c41','c42','c44']\nLEGACY={'c03','c04','c05','c06','c07','c10','c11','c24','c31'}\n\n\ndef command_plan(root):\n    manifest=read(root/'docs/architecture/checks.json')\n    commands=[dict(label='common/'+str(i+1),argv=argv,expects_tests=('vitest' in argv or argv[:2]==['cargo','test'])) for i,argv in enumerate(manifest['common_commands'])]\n    chunk=manifest['chunks']['C45']\n    tests=[('fixture',chunk['fixture_command'])]+[('host/'+str(i+1),argv) for i,argv in enumerate(chunk['host_commands'])]+[('frontend/'+str(i+1),argv) for i,argv in enumerate(chunk['frontend_commands'])]\n    for label,argv in tests:\n        if not any(item['argv']==argv for item in commands):commands.append(dict(label='C45/'+label,argv=argv,expects_tests=True))\n    return commands\n\n\ndef verify_plan(root, plan):\n    expected={}\n    for command in command_plan(root):\n        expected['CHECK:'+command['label']]=dict(kind='command',argv=command['argv'],label=command['label'],expects_tests=command['expects_tests'])\n    native=load_requirements(root)\n    for driver in DRIVERS+['c45']:\n        argv=['python3','tools/p10/native.py',driver]+(['legacy'] if driver in LEGACY else [])\n        if driver=='c45':argv=['python3','tools/native-acceptance/acceptance_c45.py']\n        ids=native[driver.upper()] if driver!='c45' else {r['id'] for r in read(root/'docs/architecture/native-checks.json')['chunks']['C45']}\n        for cid in ids:expected[cid]=dict(kind='native',argv=argv)\n    rows=plan['requirements']\n    require(len(rows)==len(expected) and {r['id'] for r in rows}==set(expected),'required plan omits/duplicates/introduces approved coverage')\n    for row in rows:\n        require(all(row.get(k)==v for k,v in expected[row['id']].items()),'plan command/raw-kind differs from approved source manifest')\n    return True\n\n\ndef verify_historical_invocations(root):\n    import ast\n    historical=root/'docs/planning/evidence/P09/remediation-attempt-01/qualification-g11.py'\n    tree=ast.parse(historical.read_text())\n    node=next(n for n in ast.walk(tree) if isinstance(n,ast.Assign) and any(isinstance(t,ast.Name) and t.id=='queue' for t in n.targets))\n    permitted=(ast.Expression,ast.List,ast.Tuple,ast.Constant,ast.BinOp,ast.Add,ast.ListComp,ast.comprehension,ast.Name,ast.Load,ast.Store)\n    expression=ast.Expression(node.value)\n    require(all(isinstance(n,permitted) for n in ast.walk(expression)),'historical queue is not a literal/comprehension; never execute its supervisor')\n    queue=eval(compile(expression,str(historical),'eval'),{'__builtins__':{}},{})\n    current=[(driver,driver in LEGACY) for driver in DRIVERS]\n    require(current==queue,'current native driver/adapter plan differs from actual retained G11')\n    return {'status':'pass','historical_source':str(historical.relative_to(root)),'historical_source_sha256':sha(historical),'queue':current,'method':'AST-extracted literal queue only; historical supervisor never executed','new_assertions_retired':0}\n\n\ndef make(root):\n    base=root/'docs/planning/evidence/C45/baseline-03';base.mkdir(exist_ok=True)\n    require(not (base/'source-seal.json').exists(),'preserve previous seal')\n    requirements=[]\n    for command in command_plan(root):\n        requirements.append(dict(id='CHECK:'+command['label'],kind='command',**command,affected=True,must_execute=True,dependencies=['current approved manifest target'],helper_paths=[]))\n    native=load_requirements(root)\n    all_helpers={}\n    for driver in DRIVERS+['c45']:\n        module='acceptance_c32_current' if driver=='c32' else 'acceptance_'+driver\n        closure=helper_closure(root,module);all_helpers.update(closure)\n        argv=['python3','tools/p10/native.py',driver]+(['legacy'] if driver in LEGACY else [])\n        if driver=='c45':argv=['python3','tools/native-acceptance/acceptance_c45.py']\n        ids=native[driver.upper()] if driver!='c45' else {row['id'] for row in read(root/'docs/architecture/native-checks.json')['chunks']['C45']}\n        for cid in sorted(ids):requirements.append(dict(id=cid,kind='native',argv=argv,affected=True,must_execute=True,dependencies=['current fixture application and relevant native helpers'],helper_paths=sorted(closure)))\n    plan={'schema':'airs-desktop/required-coverage/1','subject':'C45','phase':'P10','baseline_count':1,'requirements':requirements,'commands':command_plan(root),'drivers':DRIVERS,'legacy_drivers':sorted(LEGACY),'helper_closure':all_helpers,'reason':'Owner-approved broad identity/isolation/cleanup baseline. Future fixes/merges/reviews use affected targets with explicit artifact/input proof; no automatic broad repeat.','historical_only':['C30 owner standing/performance','L19 charged3/remaining0','P09 actual all9/G11 and older approved retirements'],'excluded_private_operations':['classic login-Keychain probe','search-list inspection; current four services covered by disposable FILE Keychain test']}\n    source=source_inventory(root)\n    for name,value in [('source-seal.json',{'files':source,'source_fingerprint':digest(source)}),('required-coverage.json',plan)]:(base/name).write_text(json.dumps(value,indent=2)+'\\n')\n    print('Sealed',len(source),'source entries;',len(requirements),'required coverage IDs;',len(plan['commands']),'repository commands; native20+C45')\n\n\nif __name__=='__main__':make(Path.cwd().resolve())\n","exit_code":0,"status":"completed"}}
