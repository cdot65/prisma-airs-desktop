+            INFERENCE_KEY.to_owned(),
+        ),
+        (reference.as_str(), desk.endpoint(), "two words".to_owned()),
+    ] {
+        assert!(
+            desk.send(
+                json!({"kind": "configureInferenceCredential", "context": context,
+                "mode": "keychain", "workspace": workspace, "endpoint": endpoint, "secret": key})
+            )
