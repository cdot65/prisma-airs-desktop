+
+const idle = <T,>(): Held<T> => ({ read: null, loading: false, failure: null })
+
+/** Keeps the newest of overlapping reads; a superseded reply is dropped. */
+function useLatest() {
+    const token = useRef(0)
+    return {
+        next: () => ++token.current,
+        current: (mine: number) => mine === token.current,
+    }
