+        let foreign = json!({"data": [{"id": "x", "status": "active", "workspace_id": "other"}]});
+        assert!(policies(&foreign, WS, true).is_none());
+        let short =
+            json!({"total": 0, "data": [{"id": "x", "status": "active", "workspace_id": WS}]});
+        assert!(
