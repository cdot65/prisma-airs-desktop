+                rows: [{ id: 'log-1', createdAt: '2026-10-20T00:00:00Z', model: 'gpt-4o', provider: 'openai', status: 446, units: 0, cost: 0, traceId: o.trace ?? 'airs-1', cacheStatus: null, apiKeyId: null }],
+                total: 1, more: false, capped: false, partial: false,
+            },
+        })
+    }
+    return observed({
+        kind: 'limits',
