+        if outcome == "unknown" {
+            traces.push(view["trace"].as_str().expect("trace").to_owned());
+        }
+    }
+    // Every uncertain run is kept with its trace; a refusal is not.
+    let kept = || {
+        desk.json()["gateway"]["local"]["runs"]
+            .as_array()
+            .map(|runs| {
+                runs.iter()
+                    .map(|r| {
