+            );
+        }
+        if method == "POST" && path == format!("{RUNTIME}/chat/completions") {
+            self.serial += 1;
+            let id = format!("chatcmpl-{}", self.serial);
+            return match self.chat.clone() {
+                Chat::Text(texts) => {
