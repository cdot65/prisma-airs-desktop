+        .await
+        .expect("stored");
+    let mut traces = Vec::new();
+    for (chat, outcome) in [
+        (Chat::Status(500), "unknown"),
+        (Chat::Status(502), "unknown"),
+        (Chat::Status(503), "unknown"),
+        (Chat::Status(504), "unknown"),
+        (Chat::Lost, "unknown"),
+        (Chat::NotStream, "unknown"),
+        (Chat::Status(400), "rejected"),
+        (Chat::Status(446), "rejected"),
