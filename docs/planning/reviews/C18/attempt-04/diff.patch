+        (draft: PlaygroundDraftInput) => {
+            pending.current = draft
+            if (timer.current) clearTimeout(timer.current)
+            timer.current = setTimeout(flush, DRAFT_PAUSE_MS)
+        },
+        [flush]
+    )
+    useEffect(() => flush, [flush])
+    return { keep, flush }
