+                    return raw(404, &json!({"error": "not found"}));
+                };
+                *app = body.clone();
+                app["customer_appId"] = json!(id);
+                raw(200, &app.clone())
+            }
+            ("DELETE", "/aisec/v1/mgmt/customerapp") => {
+                let name = query("app_name").unwrap_or_default();
+                self.apps.retain(|a| a["app_name"] != name.as_str());
