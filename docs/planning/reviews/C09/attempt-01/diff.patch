+        expect(screen.getByLabelText('Type Finance to confirm')).toHaveAttribute('readonly')
+        expect(screen.getByRole('button', { name: 'Apply…' })).toBeDisabled()
+        expect(screen.getByRole('button', { name: 'Review again' })).toBeDisabled()
