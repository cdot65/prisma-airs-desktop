+            ("GET", p) if p == format!("/aisec/v1/mgmt/topics{tsg}") => {
+                list(&self.topics, "custom_topics")
+            }
+            ("GET", p) if p == format!("/aisec/v1/mgmt/customerapp{tsg}") => {
