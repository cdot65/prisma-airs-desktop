+        Err(PageError::Sdk(error))
+            if ManagementFailure::from_sdk(&error) == ManagementFailure::NotFound =>
+        {
+            let mut query = list_query(&[]);
+            query[1].1 = "1".to_owned();
+            match binding
+                .product_read(Product::RedTeam, "/v1/scan", query, deadline)
+                .await
