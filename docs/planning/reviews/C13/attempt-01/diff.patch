+/// A source's data or its sanitized failure.
+fn sourced<T>(read: Result<T, PageError>) -> (Option<T>, Option<ManagementFailure>) {
+    match read {
+        Ok(data) => (Some(data), None),
+        Err(error) => (None, Some(failure_of(error))),
+    }
+}
