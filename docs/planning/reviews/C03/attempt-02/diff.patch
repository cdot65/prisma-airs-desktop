diff --git a/tools/native-acceptance/fixture_app.py b/tools/native-acceptance/fixture_app.py
new file mode 100644
index 0000000..931148e
--- /dev/null
+++ b/tools/native-acceptance/fixture_app.py
@@ -0,0 +1,325 @@
+"""Shared driving helpers for the prepared fixture app (C03 onward): process
+control, the compiled Accessibility helper, frontmost-guarded keystrokes,
+fixture data-root hygiene and the synthetic scan endpoint.
+
+Keystrokes go through System Events only after the fixture app is confirmed
+frontmost, so they can never reach another application. The fixture build
+keeps data in its own Application Support directory and credentials in a
+dedicated fixture test keychain there; the login keychain and v1 data are
+never touched.
+"""
+
+import json
+import os
+import shutil
+import signal
+import socket
+import subprocess
+import time
+
+HOME = os.path.expanduser("~")
+DATA = os.path.join(HOME, "Library/Application Support/io.cdot.prisma-airs-desktop.v2.fixture")
+KEYCHAIN = os.path.join(DATA, "fixture-credentials.keychain-db")
+ROOTS = os.path.join(DATA, "fixture-transport-roots.pem")
+V1_DATA = os.path.join(HOME, "Library/Application Support/Prisma AIRS Desktop")
+PROCESS = "Fixture.app/Contents/MacOS/prisma-airs-desktop-v2"
+TOOLS = os.path.dirname(os.path.abspath(__file__))
+
+
+def sh(argv, **kw):
+    return subprocess.run(argv, capture_output=True, text=True, **kw)
+
+
+class App:
+    """One fixture bundle driven through Accessibility."""
+
+    def __init__(self, bundle, work, log):
+        self.bundle = bundle
+        self.log = log
+        self.ax_bin = os.path.join(work, "ax")
+        built = sh(["swiftc", "-O", os.path.join(TOOLS, "ax.swift"), "-o", self.ax_bin])
+        if built.returncode != 0:
+            raise SystemExit(f"ax helper did not build: {built.stderr}")
+        self.pid = None
+
+    def note(self, what, **data):
+        self.log.append({"t": time.strftime("%H:%M:%S"), "step": what, **data})
+
+    # ---- process ----
+    @staticmethod
+    def running_pid():
+        out = sh(["pgrep", "-f", PROCESS]).stdout.split()
+        return int(out[0]) if out else None
+
+    def quit(self):
+        pid = self.running_pid()
+        if pid:
+            try:
+                self.keys("q", "command down")
+            except RuntimeError:
+                pass
+            for _ in range(40):
+                time.sleep(0.25)
+                if not self.running_pid():
+                    break
+        sh(["pkill", "-f", PROCESS])
+        time.sleep(0.5)
+        self.pid = None
+
+    def kill(self):
+        """Ends the process without a graceful quit (an abrupt close)."""
+        pid = self.running_pid()
+        if pid:
+            os.kill(pid, signal.SIGKILL)
+            for _ in range(20):
+                time.sleep(0.25)
+                if not self.running_pid():
+                    break
+        self.pid = None
+
+    def launch(self, settle=6):
+        self.quit()
+        sh(["open", "-n", self.bundle])
+        for _ in range(settle * 2):
+            time.sleep(0.5)
+            if self.running_pid():
+                break
+        self.pid = self.running_pid()
+        if not self.pid:
+            raise RuntimeError("the fixture app did not start")
+        self.tree()  # announces the AX client so WebKit builds its tree
+        tree, _ = self.wait_for(lambda t: self.node(t, "AXHeading", "") is not None, 15)
+        time.sleep(0.5)
+        return self.pid
+
+    # ---- accessibility ----
+    def ax(self, command, *args):
+        out = sh([self.ax_bin, command, str(self.pid), *[str(a) for a in args]])
+        if command == "tree":
+            return json.loads(out.stdout or "[]")
+        if out.returncode != 0:
+            raise RuntimeError(f"ax {command} {args}: {out.stderr.strip()}")
+        return out.stdout
+
+    def tree(self):
+        return self.ax("tree")
+
+    @staticmethod
+    def texts(tree):
+        return [n.get("label") or "" for n in tree] + [str(n.get("value")) for n in tree if n.get("value") is not None]
+
+    def has_text(self, tree, fragment):
+        return any(fragment in t for t in self.texts(tree))
+
+    @staticmethod
+    def node(tree, role, prefix, nth=0):
+        found = [n for n in tree if n.get("role") == role and (n.get("label") or "").startswith(prefix)]
+        return found[nth] if nth < len(found) else None
+
+    @staticmethod
+    def focused(tree):
+        return next((n for n in tree if n.get("focused") and n.get("role") not in ("AXWindow", "AXWebArea", "AXGroup", "AXScrollArea")), None)
+
+    def wait_for(self, predicate, timeout=12.0):
+        deadline = time.time() + timeout
+        while True:
+            tree = self.tree()
+            if predicate(tree):
+                return tree, True
+            if time.time() > deadline:
+                return tree, False
+            time.sleep(0.3)
+
+    # ---- keyboard (frontmost-guarded) ----
+    def front(self):
+        script = (f'tell application "System Events"\nset p to first application process whose unix id is {self.pid}\n'
+                  'set frontmost of p to true\ndelay 0.2\nreturn frontmost of p\nend tell')
+        for _ in range(5):
+            if sh(["osascript", "-e", script]).stdout.strip() == "true":
+                return
+            time.sleep(0.3)
+        raise RuntimeError(f"the fixture app (pid {self.pid}) is not frontmost; refusing to send keystrokes")
+
+    def keys(self, text, modifiers=None):
+        if self.pid is None:
+            self.pid = self.running_pid()
+        if self.pid is None:
+            raise RuntimeError("keystrokes need the fixture pid")
+        self.front()
+        using = f" using {{{modifiers}}}" if modifiers else ""
+        escaped = text.replace("\\", "\\\\").replace('"', '\\"')
+        sh(["osascript", "-e", f'tell application "System Events" to keystroke "{escaped}"{using}'])
+        time.sleep(0.4)
+
+    def keycode(self, code, modifiers=None):
+        self.front()
+        using = f" using {{{modifiers}}}" if modifiers else ""
+        sh(["osascript", "-e", f'tell application "System Events" to key code {code}{using}'])
+        time.sleep(0.35)
+
+    def tab_walk(self, steps):
+        order = []
+        for _ in range(steps):
+            self.keycode(48)
+            f = self.focused(self.tree())
+            order.append(None if f is None else {"role": f["role"], "subrole": f.get("subrole"), "label": f.get("label")})
+        return order
+
+    def menu(self, *path):
+        self.front()
+        chain = f'menu item "{path[-1]}"'
+        for item in reversed(path[1:-1]):
+            chain += f' of menu 1 of menu item "{item}"'
+        chain += f' of menu 1 of menu bar item "{path[0]}" of menu bar 1'
+        sh(["osascript", "-e", f'tell application "System Events" to tell (first application process whose unix id is {self.pid}) to click {chain}'])
+        time.sleep(0.8)
+
+    def field(self, role, label, nth=0):
+        return self.node(self.tree(), role, label, nth)
+
+    def type_into(self, role, label, text, nth=0, secure=False):
+        """Types `text` and verifies what arrived; retypes over a selection if
+        keystrokes were dropped."""
+        for attempt in range(3):
+            self.ax("focus", role, label, nth)
+            time.sleep(0.4)
+            if attempt:
+                self.keys("a", "command down")
+                self.keycode(51)
+            self.keys(text)
+            time.sleep(0.3)
+            value = str((self.field(role, label, nth) or {}).get("value") or "")
+            if (len(value) == len(text) and set(value) <= {"•"}) if secure else value == text:
+                self.note("typed", field=label, attempts=attempt + 1)
+                return
+        raise RuntimeError(f"could not type into {label} reliably")
+
+    def type_file(self, role, label, path, nth=0, timeout=60, per_event=20):
+        """Replaces a field's text with a file's contents typed as real key
+        events (posted to the app's process only) and waits until it all
+        arrived."""
+        expected = open(path, encoding="utf-8").read()
+        for attempt in range(3):
+            self.ax("focus", role, label, nth)
+            time.sleep(0.3)
+            self.keys("a", "command down")
+            self.keycode(51)
+            self.front()
+            self.ax("type-file", path, per_event)
+            time.sleep(1.0)
+            deadline = time.time() + timeout
+            value = ""
+            while time.time() < deadline:
+                value = str((self.field(role, label, nth) or {}).get("value") or "")
+                if len(value) >= len(expected):
+                    break
+                time.sleep(0.3)
+            if value == expected:
+                self.note("typed-file", field=label, chars=len(expected), attempts=attempt + 1)
+                return True
+            self.note("typed-file-mismatch", field=label, expected=len(expected), arrived=len(value), attempt=attempt + 1)
+        return False
+
+    # ---- flows ----
+    def open_settings(self):
+        self.keys(",", "command down")
+        tree, _ = self.wait_for(lambda t: self.node(t, "AXHeading", "Settings") is not None)
+        return tree
+
+    def open_runtime(self):
+        self.ax("press", "AXButton", "Runtime Security")
+        tree, _ = self.wait_for(lambda t: self.node(t, "AXHeading", "Scan a prompt or response") is not None)
+        return tree
+
+    def create_custom_tenant(self, label, origin):
+        self.type_into("AXTextField", "Label", label)
+        self.ax("press", "AXRadioButton", "Custom HTTPS endpoint")
+        self.wait_for(lambda t: self.node(t, "AXTextField", "Endpoint origin") is not None)
+        self.type_into("AXTextField", "Endpoint origin", origin)
+        self.keycode(36)
+        return self.wait_for(lambda t: self.node(t, "AXButton", f"Delete {label}") is not None)
+
+    def save_key(self, key):
+        self.type_into("AXTextField", "AIRS API key", key, secure=True)
+        self.keycode(36)
+        return self.wait_for(lambda t: self.has_text(t, "Scan key saved in the Keychain."))
+
+    def make_active(self, label):
+        if self.has_text(self.tree(), f"Active tenant: {label}"):
+            return self.tree(), True
+        self.ax("press", "AXButton", f"Make {label} active")
+        return self.wait_for(lambda t: self.has_text(t, f"Active tenant: {label}") or self.has_text(t, f"{label} (active)"))
+
+
+def clean_fixture_root():
+    if os.path.exists(KEYCHAIN):
+        sh(["security", "delete-keychain", KEYCHAIN])
+    if os.path.isdir(DATA):
+        shutil.rmtree(DATA)
+
+
+def v1_metadata():
+    entries = []
+    for base, _, files in os.walk(V1_DATA):
+        for name in files:
+            path = os.path.join(base, name)
+            try:
+                st = os.lstat(path)
+            except OSError:
+                continue
+            entries.append([os.path.relpath(path, V1_DATA), st.st_size, int(st.st_mtime)])
+    return sorted(entries)
+
+
+def free_port():
+    with socket.socket() as s:
+        s.bind(("127.0.0.1", 0))
+        return s.getsockname()[1]
+
+
+class ScanEndpoint:
+    """The synthetic HTTPS scan endpoint (scan_server.py) in a scratch dir."""
+
+    def __init__(self, directory, key):
+        self.dir, self.key = directory, key
+        self.port = free_port()
+        self.proc = None
+        made = sh(["python3", "-I", os.path.join(TOOLS, "scan_server.py"), "--dir", directory, "--port", "0", "--key", key, "--make-certs"])
+        if made.returncode != 0:
+            raise SystemExit(f"fixture certificates were not generated: {made.stderr}")
+        self.mode("allow")
+
+    @property
+    def origin(self):
+        return f"https://localhost:{self.port}"
+
+    def install_roots(self):
+        """Trust the test CA in the fixture build (read at launch)."""
+        os.makedirs(DATA, exist_ok=True)
+        shutil.copy(os.path.join(self.dir, "ca.pem"), ROOTS)
+
+    def start(self):
+        if self.proc:
+            return
+        self.proc = subprocess.Popen(
+            ["python3", "-I", os.path.join(TOOLS, "scan_server.py"), "--dir", self.dir, "--port", str(self.port), "--key", self.key],
+            stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, text=True)
+        if self.proc.stdout.readline().strip() != "ready":
+            raise SystemExit("the synthetic scan endpoint did not start")
+
+    def stop(self):
+        if self.proc:
+            self.proc.terminate()
+            self.proc.wait(timeout=5)
+            self.proc = None
+
+    def mode(self, reply, delay_ms=0):
+        with open(os.path.join(self.dir, "mode.json"), "w") as f:
+            json.dump({"reply": reply, "delayMs": delay_ms}, f)
+
+    def requests(self):
+        path = os.path.join(self.dir, "requests.jsonl")
+        if not os.path.exists(path):
+            return []
+        with open(path) as f:
+            return [json.loads(line) for line in f if line.strip()]
diff --git a/tools/native-acceptance/scan_server.py b/tools/native-acceptance/scan_server.py
new file mode 100644
index 0000000..b6d81db
--- /dev/null
+++ b/tools/native-acceptance/scan_server.py
@@ -0,0 +1,166 @@
+#!/usr/bin/env python3
+"""Synthetic Runtime Security scan endpoint for C03 native acceptance and
+performance runs. It serves HTTPS on localhost with a certificate from a
+disposable test CA (generated with openssl into a scratch directory), answers
+POST /v1/scan/sync/request according to a mode file read on every request,
+and appends one JSON line per request it receives. It never contacts the
+network and only ever sees synthetic keys.
+
+  scan_server.py --dir <scratch> --port <port> --key <synthetic key>
+
+Files in <scratch>: ca.pem (the root the fixture app trusts), mode.json
+({"reply": "allow"|"block"|"unknownAction"|"incomplete"|"contentError"|"401"|"close",
+"delayMs": n}) and requests.jsonl.
+"""
+
+import argparse
+import hashlib
+import hmac
+import json
+import os
+import ssl
+import subprocess
+import sys
+import threading
+import time
+from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
+
+PATH = "/v1/scan/sync/request"
+
+
+def make_certs(directory):
+    """A test CA and a localhost leaf (P-256) signed by it."""
+    os.makedirs(directory, exist_ok=True)
+    run = lambda *argv: subprocess.run(argv, check=True, capture_output=True, cwd=directory)
+    run("openssl", "ecparam", "-name", "prime256v1", "-genkey", "-noout", "-out", "ca.key")
+    # Explicit SHA-256: the system LibreSSL otherwise signs with SHA-1, which
+    # macOS trust evaluation rejects as a broken signature algorithm.
+    run("openssl", "req", "-x509", "-new", "-sha256", "-key", "ca.key", "-days", "2", "-subj", "/CN=airs-v2 c03 fixture ca",
+        "-addext", "basicConstraints=critical,CA:TRUE", "-addext", "keyUsage=critical,keyCertSign,cRLSign", "-out", "ca.pem")
+    run("openssl", "ecparam", "-name", "prime256v1", "-genkey", "-noout", "-out", "leaf.key")
+    run("openssl", "req", "-new", "-key", "leaf.key", "-subj", "/CN=localhost", "-out", "leaf.csr")
+    with open(os.path.join(directory, "leaf.ext"), "w") as f:
+        f.write("basicConstraints=critical,CA:FALSE\nkeyUsage=critical,digitalSignature\n"
+                "extendedKeyUsage=serverAuth\nsubjectAltName=DNS:localhost\n")
+    run("openssl", "x509", "-req", "-sha256", "-in", "leaf.csr", "-CA", "ca.pem", "-CAkey", "ca.key", "-CAcreateserial",
+        "-days", "2", "-extfile", "leaf.ext", "-out", "leaf.pem")
+
+
+def result_body(mode):
+    body = {
+        "report_id": "R-c03-native", "scan_id": "S-c03-native", "tr_id": "T-c03",
+        "profile_name": "Production guardrails", "category": "benign", "action": "allow",
+        "timeout": False, "error": False, "errors": [],
+        "prompt_detected": {"injection": False, "dlp": False}, "response_detected": {},
+    }
+    if mode == "block":
+        body.update(category="malicious", action="block", prompt_detected={"injection": True, "dlp": False, "future_detector": True})
+    elif mode == "unknownAction":
+        body.update(action="quarantine-v2")
+    elif mode == "incomplete":
+        body.update(timeout=True)
+    elif mode == "contentError":
+        body.update(errors=[{"content_type": "prompt", "feature": "dlp", "status": "error"}])
+    return json.dumps(body).encode()
+
+
+class Handler(BaseHTTPRequestHandler):
+    protocol_version = "HTTP/1.1"
+    server_version = "airs-v2-c03-fixture"
+
+    def log_message(self, *_):
+        pass
+
+    def do_POST(self):
+        length = int(self.headers.get("content-length") or 0)
+        body = self.rfile.read(length)
+        key = self.server.key.encode()
+        token = self.headers.get("x-pan-token") or ""
+        record = {
+            "t": time.time(),
+            "method": "POST",
+            "path": self.path,
+            "contentType": self.headers.get("content-type"),
+            # Synthetic key: compared, never echoed in full.
+            "tokenMatches": hmac.compare_digest(token.encode(), key),
+            "payloadHashMatches": hmac.compare_digest(
+                (self.headers.get("x-payload-hash") or "").encode(),
+                hmac.new(key, body, hashlib.sha256).hexdigest().encode()),
+            "authorization": self.headers.get("authorization") is not None,
+            "bodyBytes": len(body),
+        }
+        try:
+            parsed = json.loads(body)
+            contents = parsed.get("contents") or [{}]
+            record["profile"] = parsed.get("ai_profile")
+            record["metadata"] = parsed.get("metadata")
+            record["promptChars"] = len(contents[0].get("prompt") or "")
+            record["responseChars"] = len(contents[0].get("response") or "")
+            record["promptHead"] = (contents[0].get("prompt") or "")[:64]
+        except (ValueError, AttributeError, IndexError):
+            record["unparsed"] = True
+        mode = self.server.mode()
+        record["reply"] = mode.get("reply", "allow")
+        with self.server.lock, open(self.server.log, "a") as f:
+            f.write(json.dumps(record) + "\n")
+        time.sleep(mode.get("delayMs", 0) / 1000)
+        reply = record["reply"]
+        if self.path != PATH:
+            self.respond(404, b"{}")
+        elif reply == "close":
+            self.close_connection = True
+            self.connection.close()
+        elif reply == "401":
+            self.respond(401, b'{"error":{"message":"synthetic denial"}}')
+        else:
+            self.respond(200, result_body(reply))
+
+    def respond(self, status, payload):
+        self.send_response(status)
+        self.send_header("content-type", "application/json")
+        self.send_header("content-length", str(len(payload)))
+        self.send_header("connection", "close")
+        self.end_headers()
+        self.wfile.write(payload)
+        self.close_connection = True
+
+
+class Server(ThreadingHTTPServer):
+    daemon_threads = True
+
+    def __init__(self, port, directory, key):
+        super().__init__(("127.0.0.1", port), Handler)
+        self.directory, self.key = directory, key
+        self.log = os.path.join(directory, "requests.jsonl")
+        self.lock = threading.Lock()
+
+    def mode(self):
+        try:
+            with open(os.path.join(self.directory, "mode.json")) as f:
+                return json.load(f)
+        except (OSError, ValueError):
+            return {"reply": "allow"}
+
+
+def main():
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--dir", required=True)
+    parser.add_argument("--port", type=int, required=True)
+    parser.add_argument("--key", required=True)
+    parser.add_argument("--make-certs", action="store_true")
+    args = parser.parse_args()
+    if args.make_certs:
+        make_certs(args.dir)
+        return 0
+    context = ssl.SSLContext(ssl.PROTOCOL_TLS_SERVER)
+    context.minimum_version = ssl.TLSVersion.TLSv1_2
+    context.load_cert_chain(os.path.join(args.dir, "leaf.pem"), os.path.join(args.dir, "leaf.key"))
+    server = Server(args.port, args.dir, args.key)
+    server.socket = context.wrap_socket(server.socket, server_side=True)
+    print("ready", flush=True)
+    server.serve_forever()
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
diff --git a/tools/perf/measure_c03.py b/tools/perf/measure_c03.py
new file mode 100644
index 0000000..c45d9fb
--- /dev/null
+++ b/tools/perf/measure_c03.py
@@ -0,0 +1,296 @@
+#!/usr/bin/env python3
+"""C03 performance measurement against the registered budgets
+(docs/architecture/budgets.json, registration in
+docs/planning/evidence/C03/budget-registration.json).
+
+  measure_c03.py --label calibration|acceptance
+
+Run from the repository root on the prepared C03 fixture bundle. Calibration
+runs are exploratory and written to perf-calibration-<time>.json; only an
+acceptance run writes docs/planning/evidence/C03/perf.json, and it refuses
+to start unless the budgets file matches its registration. Raw samples are
+recorded; `xtask native` recomputes every statistic from them.
+
+Workloads (see budgets.json for the exact methods): 20 cold launches from
+fresh bundle copies with no fixture data root, 20 warm relaunches, 100
+key-to-field samples, 20 s of idle memory, and 20 deterministic 100 KiB
+scans with the process tree sampled every 50 ms. The synthetic localhost
+TLS endpoint answers every scan; nothing leaves this Mac.
+"""
+
+import argparse
+import hashlib
+import json
+import os
+import shutil
+import subprocess
+import sys
+import tempfile
+import threading
+import time
+
+HERE = os.path.dirname(os.path.abspath(__file__))
+sys.path.insert(0, os.path.join(HERE, "..", "native-acceptance"))
+import fixture_app as fx  # noqa: E402
+
+ROOT = os.getcwd()
+EVIDENCE = os.path.join(ROOT, "docs/planning/evidence/C03")
+BUDGETS = os.path.join(ROOT, "docs/architecture/budgets.json")
+KEY = "synthetic-c03-perf-key"
+HEADING = "Scan a prompt or response"
+FRAME_MS = 1000 / 60
+MIB = 1024 * 1024
+WEBKIT_DIRS = [os.path.join(fx.HOME, "Library/WebKit/io.cdot.prisma-airs-desktop.v2.fixture"),
+               os.path.join(fx.HOME, "Library/Caches/io.cdot.prisma-airs-desktop.v2.fixture")]
+
+
+def sha256_file(path):
+    with open(path, "rb") as f:
+        return hashlib.sha256(f.read()).hexdigest()
+
+
+def utc():
+    return time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())
+
+
+def webkit_pids():
+    return set(int(p) for p in fx.sh(["pgrep", "-f", "com.apple.WebKit"]).stdout.split())
+
+
+def rss_mib(pids):
+    if not pids:
+        return 0.0
+    out = fx.sh(["ps", "-o", "rss=", "-p", ",".join(str(p) for p in pids)]).stdout.split()
+    return sum(int(v) for v in out) / 1024
+
+
+def wait_gone(pids, timeout=10):
+    deadline = time.time() + timeout
+    while time.time() < deadline:
+        alive = [p for p in pids if fx.sh(["ps", "-p", str(p)]).returncode == 0]
+        if not alive:
+            return True
+        time.sleep(0.2)
+    return False
+
+
+class Sampler(threading.Thread):
+    def __init__(self, pids, interval):
+        super().__init__(daemon=True)
+        self.pids, self.interval, self.samples, self.stop = pids, interval, [], threading.Event()
+
+    def run(self):
+        while not self.stop.is_set():
+            self.samples.append((time.time(), rss_mib(self.pids)))
+            time.sleep(self.interval)
+
+
+def main():
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--label", choices=["calibration", "acceptance"], required=True)
+    args = parser.parse_args()
+    registration = json.load(open(os.path.join(EVIDENCE, "budget-registration.json")))
+    budgets_sha = sha256_file(BUDGETS)
+    if budgets_sha != registration["budgets_sha256"]:
+        raise SystemExit("budgets.json does not match its registration; register a new version first")
+    started = utc()
+    if started < registration["registered_utc"]:
+        raise SystemExit("the clock is before the budget registration")
+    prepared = json.load(open(os.path.join(EVIDENCE, "native-prepare.json")))
+    bundle = os.path.join(ROOT, prepared["bundle"])
+    exe = os.path.join(bundle, "Contents/MacOS/prisma-airs-desktop-v2")
+    if sha256_file(exe) != prepared["executable_sha256"]:
+        raise SystemExit("prepared executable changed since native-prepare")
+    work = tempfile.mkdtemp(prefix="airs-v2-c03-perf-")
+    probe = os.path.join(work, "probe")
+    built = fx.sh(["swiftc", "-O", os.path.join(HERE, "probe.swift"), "-o", probe])
+    if built.returncode != 0:
+        raise SystemExit(f"probe did not build: {built.stderr}")
+    log = []
+    app = fx.App(bundle, work, log)
+    endpoint = fx.ScanEndpoint(os.path.join(work, "endpoint"), KEY)
+    partial = {"metrics": {}, "details": {}}
+    try:
+        result = measure(app, endpoint, probe, exe, bundle, work, partial)
+    except Exception as error:
+        # A failed attempt is kept, never silently discarded or relabelled.
+        attempt = os.path.join(EVIDENCE, f"perf-failed-{args.label}-{started.replace(':', '')}.json")
+        with open(attempt, "w") as f:
+            json.dump({"schema": "airs-v2-perf-failed/1", "label": args.label, "budgets_sha256": budgets_sha,
+                       "started_utc": started, "failed_utc": utc(), "error": str(error),
+                       "executable_sha256": prepared["executable_sha256"], "partial": partial, "log": log}, f, indent=1)
+            f.write("\n")
+        raise
+    finally:
+        fx.sh(["pkill", "-f", fx.PROCESS])
+        endpoint.stop()
+        fx.clean_fixture_root()
+        shutil.rmtree(work, ignore_errors=True)
+    hw = fx.sh(["sysctl", "-n", "hw.model"]).stdout.strip()
+    record = {
+        "schema": "airs-v2-perf/1",
+        "label": args.label,
+        "budgets_sha256": budgets_sha,
+        "started_utc": started,
+        "finished_utc": utc(),
+        "host": {"model": hw, "os": fx.sh(["sw_vers", "-productVersion"]).stdout.strip() + " (" + fx.sh(["sw_vers", "-buildVersion"]).stdout.strip() + ")"},
+        "bundle": prepared["bundle"],
+        "executable_sha256": prepared["executable_sha256"],
+        "metrics": result["metrics"],
+        "details": result["details"],
+        "limitations": [
+            "Cold launches use fresh bundle copies and no fixture data root, but the OS file cache is not purged (purge needs root).",
+            "Input-to-paint is the key-event-to-accessible-value time plus one 60 Hz frame; the compositor frame itself is not captured.",
+            "Resident memory is ps RSS summed over the app and the WebKit processes that appeared with its launch; shared pages are counted per process.",
+            "The fixture build adds only the Fixture menu and fixture trust roots to production code; footprint is measured on the production build by xtask footprint.",
+        ],
+        "log": log,
+    }
+    name = "perf.json" if args.label == "acceptance" else f"perf-calibration-{started.replace(':', '')}.json"
+    path = os.path.join(EVIDENCE, name)
+    with open(path, "w") as f:
+        json.dump(record, f, indent=1)
+        f.write("\n")
+    for metric, values in record["metrics"].items():
+        s = sorted(values["samples"])
+        p95 = s[max(1, -(-95 * len(s) // 100)) - 1]
+        print(f"{metric}: n={len(s)} median={s[(len(s) + 1) // 2 - 1]:.1f} p95={p95:.1f} max={s[-1]:.1f} {values['unit']}")
+    print(f"wrote {os.path.relpath(path, ROOT)}")
+    return 0
+
+
+def launch_probe(probe, exe):
+    out = subprocess.run([probe, "launch", exe, HEADING, "15000"], capture_output=True, text=True)
+    data = json.loads(out.stdout or "{}")
+    if out.returncode != 0 or data.get("ms") is None:
+        raise RuntimeError(f"the shell did not become usable: {out.stderr.strip()} {data}")
+    return data
+
+
+def stop_app(app):
+    pid = app.running_pid()
+    if pid:
+        fx.sh(["kill", str(pid)])
+        wait_gone([pid])
+    fx.sh(["pkill", "-f", fx.PROCESS])
+
+
+def measure(app, endpoint, probe, exe, bundle, work, partial):
+    metrics, details = partial["metrics"], partial["details"]
+    stop_app(app)
+
+    # ---- cold: fresh copies, no data root, previous WebKit processes gone ----
+    cold, cold_runs = [], []
+    for i in range(20):
+        fx.clean_fixture_root()
+        for d in WEBKIT_DIRS:
+            shutil.rmtree(d, ignore_errors=True)
+        copy = os.path.join(work, f"cold-{i}", os.path.basename(bundle))
+        fx.sh(["ditto", bundle, copy])
+        before = webkit_pids()
+        data = launch_probe(probe, os.path.join(copy, "Contents/MacOS/prisma-airs-desktop-v2"))
+        cold.append(data["ms"])
+        time.sleep(1)
+        spawned = sorted(webkit_pids() - before)
+        cold_runs.append({"ms": data["ms"], "polls": data["polls"], "webkit": len(spawned)})
+        stop_app(app)
+        wait_gone(spawned)
+        shutil.rmtree(os.path.dirname(copy), ignore_errors=True)
+    metrics["cold-usable-shell"] = {"unit": "ms", "samples": cold}
+    details["cold"] = cold_runs
+
+    # ---- one tenant with a Keychain key on the synthetic endpoint ----
+    fx.clean_fixture_root()
+    endpoint.install_roots()
+    endpoint.start()
+    app.launch()
+    app.open_settings()
+    _, created = app.create_custom_tenant("Perf Tenant", endpoint.origin)
+    _, saved = app.save_key(KEY)
+    if not (created and saved):
+        raise RuntimeError("the measurement tenant was not set up")
+    stop_app(app)
+    time.sleep(2)
+
+    # ---- warm relaunches ----
+    warm, warm_runs = [], []
+    for _ in range(20):
+        before = webkit_pids()
+        data = launch_probe(probe, exe)
+        warm.append(data["ms"])
+        time.sleep(1)
+        spawned = sorted(webkit_pids() - before)
+        warm_runs.append({"ms": data["ms"], "polls": data["polls"], "webkit": len(spawned)})
+        stop_app(app)
+        wait_gone(spawned)
+    metrics["warm-usable-shell"] = {"unit": "ms", "samples": warm}
+    details["warm"] = warm_runs
+
+    # ---- idle memory, input latency and scans on one warm launch ----
+    before = webkit_pids()
+    data = launch_probe(probe, exe)
+    app.pid = data["pid"]
+    time.sleep(3)
+    tree = set(webkit_pids() - before)
+    pids = [data["pid"], *sorted(tree)]
+    details["process_tree"] = {"app": data["pid"], "webkit": sorted(tree),
+                               "commands": [fx.sh(["ps", "-o", "comm=", "-p", str(p)]).stdout.strip() for p in sorted(tree)]}
+    time.sleep(7)
+    idle = []
+    for _ in range(20):
+        idle.append(rss_mib(pids))
+        time.sleep(1)
+    metrics["idle-process-tree-resident"] = {"unit": "MiB", "samples": idle}
+
+    app.front()
+    app.ax("focus", "AXTextArea", "Prompt")
+    time.sleep(0.5)
+    out = subprocess.run([probe, "type", str(app.pid), "100"], capture_output=True, text=True)
+    if out.returncode != 0:
+        raise RuntimeError(f"input probe failed: {out.stderr.strip()}")
+    raw = json.loads(out.stdout)["samples"]
+    metrics["input-to-paint"] = {"unit": "ms", "samples": [v + FRAME_MS for v in raw]}
+    details["input_raw_ms"] = raw
+
+    app.type_into("AXTextField", "Profile name or ID", "Perf profile")
+    prompt = os.path.join(work, "prompt-100k.txt")
+    block = "The quick brown fox jumps over the lazy dog. "
+    with open(prompt, "w") as f:
+        f.write((block * (100 * 1024 // len(block) + 1))[:100 * 1024])
+    sampler = Sampler(pids, 0.05)
+    sampler.start()
+    durations = []
+    for i in range(20):
+        sent = len(endpoint.requests())
+        # Paste-like: the 100 KiB arrives as four large edits (budgets v3).
+        if not app.type_file("AXTextArea", "Prompt", prompt, timeout=60, per_event=30000):
+            raise RuntimeError(f"scan {i}: the 100 KiB prompt did not arrive")
+        start = time.time()
+        app.ax("press", "AXButton", "Scan", 0)
+        _, done = app.wait_for(lambda t: len(endpoint.requests()) == sent + 1 and not any(
+            (n.get("label") or "") == "Cancel scan" for n in t) and any(
+            n.get("role") == "AXButton" and n.get("label") == "Scan" and n.get("enabled") for n in t), 20)
+        if not done:
+            raise RuntimeError(f"scan {i} did not settle")
+        durations.append((start, time.time()))
+    sampler.stop.set()
+    sampler.join()
+    requests = endpoint.requests()[-20:]
+    if not all(r.get("promptChars") == 100 * 1024 and r.get("tokenMatches") for r in requests):
+        raise RuntimeError("a scan request did not carry the 100 KiB prompt")
+    # Per-scan peak: the maximum over the samples taken from Scan until the
+    # verdict settled (and the first sample after it, so no scan is empty).
+    per_scan = []
+    for start, end in durations:
+        window = [v for t, v in sampler.samples if start <= t <= end]
+        after = [v for t, v in sampler.samples if t > end][:1]
+        per_scan.append(max(window + after))
+    metrics["scan-peak-process-tree-resident"] = {"unit": "MiB", "samples": per_scan}
+    details["scan"] = {"samples_50ms": len(sampler.samples), "overall_peak_mib": max(v for _, v in sampler.samples),
+                       "submit_to_settled_ms": [(end - start) * 1000 for start, end in durations]}
+    stop_app(app)
+    return {"metrics": metrics, "details": details}
+
+
+if __name__ == "__main__":
+    sys.exit(main())
diff --git a/tools/perf/probe.swift b/tools/perf/probe.swift
new file mode 100644
index 0000000..d9ef921
--- /dev/null
+++ b/tools/perf/probe.swift
@@ -0,0 +1,112 @@
+// Timing probe for the registered C03 budgets (docs/architecture/budgets.json),
+// compiled by tools/perf/measure_c03.py with swiftc.
+//
+//   probe launch <executable> <heading prefix> <timeout ms>
+//       Spawns the executable (stdio to /dev/null) and polls the new
+//       process's Accessibility tree every 5 ms until an AXHeading whose
+//       title/description starts with the prefix exists. Prints
+//       {"pid": n, "ms": elapsed, "polls": n}.
+//   probe type <pid> <count>
+//       The app must be frontmost with a text field focused. For each
+//       sample, posts one key event to the process (CGEventPostToPid, so it
+//       can reach no other application) and polls the focused element's
+//       AXValue every 0.5 ms until the character arrived. Prints
+//       {"samples": [ms, ...]}.
+
+import AppKit
+import ApplicationServices
+import Foundation
+
+func attr(_ el: AXUIElement, _ name: String) -> AnyObject? {
+    var value: AnyObject?
+    return AXUIElementCopyAttributeValue(el, name as CFString, &value) == .success ? value : nil
+}
+
+func label(_ el: AXUIElement) -> String {
+    for name in [kAXTitleAttribute, kAXDescriptionAttribute] {
+        if let s = attr(el, name) as? String, !s.isEmpty { return s }
+    }
+    return ""
+}
+
+func findHeading(_ app: AXUIElement, _ prefix: String) -> Bool {
+    var stack = (attr(app, kAXWindowsAttribute) as? [AXUIElement]) ?? []
+    var visited = 0
+    while let el = stack.popLast(), visited < 4000 {
+        visited += 1
+        if (attr(el, kAXRoleAttribute) as? String) == "AXHeading", label(el).hasPrefix(prefix) { return true }
+        stack.append(contentsOf: (attr(el, kAXChildrenAttribute) as? [AXUIElement]) ?? [])
+    }
+    return false
+}
+
+func fail(_ message: String) -> Never {
+    FileHandle.standardError.write((message + "\n").data(using: .utf8)!)
+    exit(1)
+}
+
+func ms(since start: UInt64) -> Double {
+    Double(DispatchTime.now().uptimeNanoseconds - start) / 1_000_000
+}
+
+func emit(_ object: [String: Any]) {
+    let data = try! JSONSerialization.data(withJSONObject: object, options: [])
+    FileHandle.standardOutput.write(data)
+}
+
+let args = CommandLine.arguments
+guard args.count >= 3 else { fail("usage: probe launch|type ...") }
+switch args[1] {
+case "launch":
+    guard args.count == 5, let timeout = Double(args[4]) else { fail("launch <executable> <prefix> <timeout ms>") }
+    let process = Process()
+    process.executableURL = URL(fileURLWithPath: args[2])
+    process.standardInput = FileHandle.nullDevice
+    process.standardOutput = FileHandle.nullDevice
+    process.standardError = FileHandle.nullDevice
+    let start = DispatchTime.now().uptimeNanoseconds
+    do { try process.run() } catch { fail("spawn failed: \(error)") }
+    let app = AXUIElementCreateApplication(process.processIdentifier)
+    var polls = 0
+    while ms(since: start) < timeout {
+        polls += 1
+        // WebKit builds a page's tree only for an AX client that announces itself.
+        AXUIElementSetAttributeValue(app, "AXEnhancedUserInterface" as CFString, kCFBooleanTrue)
+        if findHeading(app, args[3]) {
+            emit(["pid": Int(process.processIdentifier), "ms": ms(since: start), "polls": polls])
+            exit(0)
+        }
+        usleep(5_000)
+    }
+    emit(["pid": Int(process.processIdentifier), "ms": NSNull(), "polls": polls])
+    exit(2)
+case "type":
+    guard args.count == 4, let pid = pid_t(args[2]), let count = Int(args[3]) else { fail("type <pid> <count>") }
+    let app = AXUIElementCreateApplication(pid)
+    let source = CGEventSource(stateID: .hidSystemState)
+    var samples: [Double] = []
+    for _ in 0..<count {
+        guard let focused = attr(app, kAXFocusedUIElementAttribute) else { fail("no focused element") }
+        let element = focused as! AXUIElement
+        let before = (attr(element, kAXValueAttribute) as? String)?.count ?? 0
+        let down = CGEvent(keyboardEventSource: source, virtualKey: 0, keyDown: true)!
+        let up = CGEvent(keyboardEventSource: source, virtualKey: 0, keyDown: false)!
+        let start = DispatchTime.now().uptimeNanoseconds
+        down.postToPid(pid)
+        up.postToPid(pid)
+        var arrived = false
+        while ms(since: start) < 2000 {
+            if ((attr(element, kAXValueAttribute) as? String)?.count ?? 0) > before {
+                arrived = true
+                break
+            }
+            usleep(500)
+        }
+        guard arrived else { fail("a key event did not reach the focused field within 2 s") }
+        samples.append(ms(since: start))
+        usleep(40_000)
+    }
+    emit(["samples": samples])
+default:
+    fail("unknown command \(args[1])")
+}
