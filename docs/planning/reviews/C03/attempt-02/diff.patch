+        f"{o['offline_auto_sent']}; explicit Scan: verdict {o['offline_explicit']}, requests {o['offline_explicit_requests']}",
+        [o["tree_offline"]])
+    add("C03-N09", o["inflight_sent"] == 1 and not o["relaunch_history"] and o["relaunch_replayed"] == 0,
