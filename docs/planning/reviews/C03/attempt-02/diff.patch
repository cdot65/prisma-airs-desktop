+        profileName: 'Production guardrails',
+        profileId: null,
+        category: 'malicious',
+        action: 'block',
+        verdict: 'block',
+        timeout: false,
+        serviceError: false,
+        contentErrors: [],
+        promptDetected: [
+            { detector: 'dlp', detected: false },
+            { detector: 'future_detector', detected: true },
+        ],
+        responseDetected: [],
+        ...overrides,
+    }
+}
+
+function record(overrides: Partial<ScanRecordView> = {}): ScanRecordView {
+    return {
+        operation: 'op-1',
+        progress: 'settled',
+        outcome: 'completed',
+        stop: null,
+        result: result(),
+        failure: null,
