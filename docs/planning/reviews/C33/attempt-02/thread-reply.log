 * other four products' cases are specifications to inspect and transfer.
 * Imports, catalog imports, exports and copies are explicit.
 */
export const LibraryView = forwardRef<HTMLHeadingElement, Props>(function LibraryView({ snapshot, dispatch, onNavigate, onLoad }, ref) {
    const ids = useId()
    const tenant = snapshot.tenants.find((t) => t.id === snapshot.active?.tenant)
    const context: ContextRef | null = snapshot.active?.context ?? null
    const library = snapshot.library
    const [filter, setFilter] = useState<CaseProduct | 'all'>('all')
    const [authoring, setAuthoring] = useState(false)
    const [inspect, setInspect] = useState<string | null>(null)
    const [message, setMessage] = useState<string | null>(null)
    const [copyTo, setCopyTo] = useState('')

    useEffect(() => {
        if (context) void dispatch({ kind: 'openLibrary', context })
            appearance: self.appearance(),
            tenant_products: self
                .data
                .tenants
                .iter()
                .filter(|t| !t.products.is_empty())
                .map(|t| crate::store::TenantProducts {
                    tenant: t.profile.id.clone(),
                    products: t.products.clone(),
                })
                .collect(),
            tenant_warnings: self
                .data
                .tenants
                .iter()
                .filter(|t| !t.setup_warnings.is_empty())
                .map(|t| crate::store::TenantWarnings {
                    tenant: t.profile.id.clone(),
                    warnings: t.setup_warnings.clone(),
                })
                .collect(),
            tenant_rotations: self
                .data
                .tenants
                .iter()
                .filter(|t| !t.rotations.is_empty())
                .map(|t| crate::store::TenantRotations {
                    tenant: t.profile.id.clone(),
                    rotations: t.rotations.clone(),
                })
                .collect(),
            ui_variant: self.ui_variant(),
            onboarding: self.onboarding(),
            show_calls: self.show_calls(),
            show_calls_chosen: self.data.show_calls.is_some(),
            tenants: self
                .data
                .tenants
                .iter()
                .map(|t| t.profile.clone())
                .collect(),
            active_tenant: self.data.active.clone(),
            tenant_draft: self.data.setup.as_ref().map(|s| crate::store::StoredDraft {
                profile: s.tenant.profile.clone(),
                mode: s.mode,
            }),
            credentials: self
                .data
                .tenants
                {
                    return Err(e);
                }
                state.changed();
            }
        }
        Intent::SetShowCalls { on } => {
            // The operator's choice holds from now on, onboarding or not (C33).
            if state.data.show_calls != Some(on) {
                let before = state.data.clone();
                state.data.show_calls = Some(on);
                if state.storage == StorageHealth::Ready
                    && let Err(e) = state.save_with(&before)
                {
                    return Err(e);
                }
                state.changed();
            }
        }
        Intent::BeginTenantSetup { mode, profile } => {
            state.require_storage()?;
            let before = state.data.clone();
            state.begin_setup(mode, profile)?;
            state.save_with(&before)?;
            state.changed();
        }
        Intent::UpdateTenantSetup { context, profile } => {
            state.require_storage()?;
            let before = state.data.clone();
            let retired = state.update_setup(&context, profile)?;
            state.save_with(&before)?;
            for old in retired {
                let _ = session.delete(&old);
            }
            effects.push(Effect::Cleanup);
            state.changed();
    // failed binding is not cached.
    desk.adapters.vault.fail_with(None);
    assert_eq!(
        desk.read(json!({"kind": "verify"})).await,
        ManagementResult::Verified
    );
    assert_eq!(desk.requests("/oauth2/access_token").len(), 1);
}

#[tokio::test(flavor = "multi_thread")]
async fn a_result_settled_before_its_context_retired_is_never_delivered_afterwards() {
    let mut desk = desk().await;
    desk.management_key(CLIENT_SECRET).await;
    // Read A's inventory and detail to completion without observing them.
    let page = desk
        .admit(json!({"kind": "page", "resource": "profiles", "offset": 0, "limit": 25}))
        .await
        .expect("admitted");
    let detail = desk
        .admit(json!({"kind": "detail", "resource": "topics", "id": "11111111-1111-4111-8111-111111111111"}))
        .await
        .expect("admitted");
    // However long the token and the connection take here (2 s was not
    // always enough on a slow network).
    let mut reached = false;
    for _ in 0..1500 {
        if desk.requests("/aisec/v1/mgmt/topics").len() == 1 {
            reached = true;
            break;
        }
        tokio::time::sleep(Duration::from_millis(10)).await;
    }
    assert!(reached, "both reads reached the service");
    tokio::time::sleep(Duration::from_millis(300)).await;
    // The credential is replaced: A's results are withdrawn, not delivered.
    desk.management_key("replacement-secret").await;
    for operation in [&page, &detail] {
        assert_eq!(
            desk.result(operation).await,
            ManagementResult::Failed {
                failure: ManagementFailure::Cancelled,
                outcome: desktop_core::runtime::Outcome::Completed
            }
        );
    }
    // Likewise across a tenant switch.
    let page = desk
        .admit(json!({"kind": "page", "resource": "profiles", "offset": 0, "limit": 25}))
        .await
        .expect("admitted");

