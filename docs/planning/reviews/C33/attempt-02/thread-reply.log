                            library.outcomes.push(Outcome {
                                generation,
                                origin: p.origin.clone(),
                                notice: p.notice.clone(),
                                stamp: p.stamp,
                            });
                        }
                        (Some((library.tenant.clone(), generation)), None)
                    }
