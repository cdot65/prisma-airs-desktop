+        .map(|k| k.as_str())
+        .filter(|k| k.len() <= CALL_HEADER_NAME_LIMIT)
+        .map(str::to_owned)
+        .collect();
+    names.sort();
+    names.dedup();
+    names.truncate(CALL_HEADERS_LIMIT);
+    names
+}
