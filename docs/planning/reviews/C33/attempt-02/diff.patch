+    }
+    let method = method.as_str();
+    if method.is_empty() || method.len() > CALL_METHOD_LIMIT {
+        return None;
+    }
+    Some((
+        method.to_owned(),
+        url.origin().ascii_serialization(),
+        url.path().chars().take(CALL_PATH_LIMIT).collect(),
+        url.query().is_some(),
+        header_names(headers),
+        body_bytes,
+    ))
 }
 
