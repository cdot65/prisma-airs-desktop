    'notConfigured',
    'invalidConfig',
    'network',
    pub(super) fn library_write(&self, tenant: &TenantId, generation: u64) -> Option<LibraryWrite> {
        if self.storage == super::StorageHealth::Resetting {
            return None;
        }
        let library = self.libraries.iter().find(|l| {
            &l.tenant == tenant && l.generation == generation && l.state == LibraryState::Ready
        })?;
        Some(LibraryWrite {
            root: self.library_root.clone()?,
            tenant: tenant.as_str().to_owned(),
            library: library.library.clone(),
        })
    }

    pub(super) fn settle_library_write(
        &mut self,
        tenant: &TenantId,
        generation: u64,
        stored: Result<(), LibraryFailure>,
    ) {
        let Some(library) = self
            .libraries
            .iter_mut()
            .find(|l| &l.tenant == tenant && l.generation == generation)
        else {
            return;
        };
        library.unsaved = stored.err();
        // Everything this write covered now ends: saved, or not saved.
        let (done, rest): (Vec<_>, Vec<_>) = std::mem::take(&mut library.outcomes)
            .into_iter()
            .partition(|o| o.generation <= generation);
        library.outcomes = rest;
        for o in done {
            let outcome = match stored {
                Ok(()) => Ok(o.notice),
                Err(_) => Err(CaseProblem::NotSaved),
            };
            self.deliver(&o.origin, o.stamp, outcome);
        }
    }

    /// A tenant's cases as its open library holds them (C23).
    pub(super) fn open_library_cases(&self, tenant: &TenantId) -> Option<Vec<TestCase>> {
        self.libraries
            .iter()
            .find(|l| &l.tenant == tenant && l.state == LibraryState::Ready)
            .map(|l| l.library.cases.clone())
    }

    /// Applies an import's change to a tenant's open library (C23): what it
    /// returned and, when it changed the library, the generation to write.
    /// `None` when the library is not open.
    pub(super) fn change_open_library<R>(
        &mut self,
        tenant: &TenantId,
        change: impl FnOnce(&mut CaseLibrary) -> (R, bool),
    ) -> Option<(R, Option<u64>)> {
        let library = self
            .libraries
            .iter_mut()
            .find(|l| &l.tenant == tenant && l.state == LibraryState::Ready)?;
        let (result, changed) = change(&mut library.library);
        if !changed {
            return Some((result, None));
        }
        library.status += 1;
        let (_, generation) = Self::changed_library(library);
        Some((result, Some(generation)))
    }

    /// The newest generation of a tenant's open library (C23).
    pub(super) fn library_generation(&self, tenant: &TenantId) -> Option<u64> {
        self.libraries
            .iter()
            .find(|l| &l.tenant == tenant && l.state == LibraryState::Ready)
            .map(|l| l.generation)
    }

    /// A library that was loading (or failed) while an import wrote its
    /// file reads again (C23); the lease of the new read.
    pub(super) fn reread_library(&mut self, tenant: &TenantId) -> Option<u64> {
        let stale = self.libraries.iter().any(|l| {
            &l.tenant == tenant && matches!(l.state, LibraryState::Loading | LibraryState::Failed)
        });
        if !stale {
            return None;
        }
        let lease = self.lease();
        let library = self.libraries.iter_mut().find(|l| &l.tenant == tenant)?;
        library.lease = lease;
        library.state = LibraryState::Loading;
        library.failure = None;
        Some(lease)
    }

    /// Drops a deleted tenant's library from memory.
    pub(super) fn forget_library(&mut self, tenant: &TenantId) {
        self.libraries.retain(|l| &l.tenant != tenant);
    }

    pub(super) fn library_view(&self) -> LibraryView {
        let active = self.active_ref.as_ref();
        let tenant = self.data.active.as_ref();
        let export = self
            .export
            .as_ref()
            .filter(|e| Some(&e.context) == active && e.is_kind(super::ExportKind::Cases))
            .map(super::sessions_domain::Export::view);
        match self
            .libraries
            .iter()
            .find(|l| Some(&l.tenant) == tenant && active.is_some())
        {
            Some(l) => LibraryView {
                state: l.state,
                failure: l.failure,
                // An import's cases show once it commits (D050).
                cases: l
                    .library
                    .cases
                    .iter()
                    .filter(|c| !self.v1_hides_case(&l.tenant, &c.id))
                    .map(CaseView::from)
                    .collect(),
                problem: l.problem,
                unsaved: l.unsaved,
                notice: l.notice.clone(),
                choosing: l.choosing.is_some(),
                fetching: l.fetching.is_some(),
                export,
            },
            None => LibraryView {
                state: LibraryState::Idle,
                failure: None,
                cases: Vec::new(),
                problem: None,
                unsaved: None,
                notice: None,
                choosing: false,
                fetching: false,
                export,
            },
        }
    }
}
