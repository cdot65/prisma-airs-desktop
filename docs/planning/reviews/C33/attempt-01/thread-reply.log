fn lock(inner: &Inner) -> Result<MutexGuard<'_, State>, Refusal> {
    // A poisoned lock means an authoritative transition panicked; refuse
    // further work instead of continuing from a possibly torn state.
    inner.state.lock().map_err(|_| Refusal::ShuttingDown)
}

/// Principal-scoped entry to native desktop operations and observations.
#[derive(Clone)]
pub struct AuthorityHandle {
    principal: Principal,
    inner: Arc<Inner>,
}

impl AuthorityHandle {
    pub fn principal(&self) -> Principal {
        self.principal
    }

    /// Registers a new delivery session for this principal, retiring the
    /// previous one (for example after a renderer reload).
    pub fn register_delivery_session(&self) -> Result<DeliverySession, Refusal> {
        lock(&self.inner)?.operator_sessions.register()
    }

    /// Admits or refuses one delivered Intent. Admission never awaits remote
    /// IO, Keychain calls or an operator answer while holding the state.
    pub async fn dispatch(&self, delivery: Delivery, intent: Intent) -> Result<Receipt, Refusal> {
        let kind = intent.kind();
        let (result, effects) = {
            let mut state = lock(&self.inner)?;
            let digest = intent_digest(&state.salt, &intent);
            match state.operator_sessions.check(&delivery, &digest) {
                Admit::Refused(refusal) => return Err(refusal),
                Admit::Duplicate(result) => return result,
                Admit::Fresh => {
                    let mut effects = Vec::new();
                    // What an import writes waits while it (or its
                    // rollback) runs, until every receipt has settled, and
                    // while a receipt cannot be read (D050).
                    let result =
                        if state.v1_import_holds() && import_v1_domain::waits_for_import(&intent) {
                            Err(Refusal::Busy)
                        } else {
                            admit(
                                &mut state,
                                &self.inner.session,
                                &self.inner.adapters,
                                intent,
                                &mut effects,
                            )
                        };
                    if result.is_err() {
                        effects.clear();
                    }
                    // Settlements published by this intent are kept on
                    // this Mac whether or not the intent itself succeeded.
                    effects.extend(gateway_local_effects(&mut state));
                    // Learner records wait in the ledger for a confirmed
                    // save; once one has happened, let cleanup resume.
                    if !state.durability_unconfirmed && !state.data.learner_cleanup.is_empty() {
                        effects.push(Effect::Cleanup);
                    }
                    state
                        .operator_sessions
                        .record(&delivery, digest, result.clone());
                    (result, effects)
                }
            }
        };
        run_effects(&self.inner, effects);
        // Only the request's kind and the refusal's code (D051).
        self.inner
            .diagnostics
            .record(crate::diagnostics::Event::Intent {
                kind: kind.to_owned(),
                refusal: result.as_ref().err().map(refusal_code),
            });
        result
    }

    /// Returns the current redacted snapshot and subscribes to its updates
    /// atomically, so no update between them is lost.
    pub fn observe(&self, scope: ViewScope) -> Result<Observation, Refusal> {
        let mut state = lock(&self.inner)?;
        match scope {
            ViewScope::Shell => {
                let snapshot = state.snapshot();
                let updates = state.subscribers.subscribe().ok_or(Refusal::Busy)?;
                Ok(Observation::Shell { snapshot, updates })
            }
            ViewScope::AcademyCall(operation) => Ok(Observation::AcademyCall(
                state.observe_academy_call(&operation)?,
            )),
            ViewScope::Management(operation) => Ok(Observation::Management(
                state.observe_management(&operation)?,
            )),
            ViewScope::Workbench(operation) => {
                Ok(Observation::Workbench(state.observe_workbench(&operation)?))
            }
        }
    }

    /// Live observers registered with the core (retired ones are pruned).
    pub fn observer_count(&self) -> usize {
        lock(&self.inner)
            .map(|mut s| s.subscribers.len())
            .unwrap_or(0)
    }

    /// Admits remote work bound to the current context. Production remote
    /// operations (C03 Scan) are admitted through this path from their
    /// intents; fixtures use it to exercise the shared lifecycle.
    #[cfg(any(test, feature = "test-fixtures"))]
    pub fn admit_fixture_operation(
        &self,
        context: &ContextRef,
        bytes: usize,
        work: runtime::Work,
    ) -> Result<OperationId, Refusal> {
        let (id, starts) = {
            let mut state = lock(&self.inner)?;
            state.check_context(context)?;
            state
                .operations
                .admit(context.as_str(), bytes, work, Instant::now())?
        };
        run_effects(&self.inner, vec![Effect::Start(starts)]);
        Ok(id)
    }

    /// Cancels an operation admitted by this principal.
    pub fn cancel_operation(&self, operation: &OperationId) -> Result<bool, Refusal> {
        let (found, starts) = {
            let mut state = lock(&self.inner)?;
            state
                .operations
                .cancel(operation, StopReason::Cancelled, Instant::now())
        };
        run_effects(&self.inner, vec![Effect::Start(starts)]);
        Ok(found)
    }

    pub fn operation_state(&self, operation: &OperationId) -> Option<OperationState> {
        lock(&self.inner).ok()?.operations.state(operation)
    }

    /// A transport for one admitted operation under the current policy.
    pub fn transport_for_admission(
        &self,
    ) -> Result<Arc<crate::transport::NativeTransport>, Refusal> {
        let factory = lock(&self.inner)?
            .transport
            .clone()
            .ok_or(Refusal::CapabilityMissing)?;
        factory
            .for_admission()
            .map_err(|_| Refusal::CapabilityMissing)
    }

    /// Reads the active tenant's scan key for a binding (C03). The secret
    /// never enters a snapshot; the read runs off the transition lock.
    pub async fn read_scan_credential(
        &self,
        context: &ContextRef,
    ) -> Result<(String, Zeroizing<Vec<u8>>), Refusal> {
        let (record, mode, destination) = {
            let state = lock(&self.inner)?;
            let tenant = state.check_context(context)?;
            match &state.tenant(&tenant).ok_or(Refusal::StaleContext)?.scan {

    fn library_mut(&mut self, tenant: &TenantId) -> Result<&mut Library, Refusal> {
        let library = self
            .libraries
            .iter_mut()
            .find(|l| &l.tenant == tenant)
            .ok_or(Refusal::CapabilityMissing)?;
        match library.state {
            LibraryState::Ready => {
                library.act();
                Ok(library)
            }
            LibraryState::Loading => Err(Refusal::Busy),
            _ => Err(Refusal::CapabilityMissing),
        }
    }

    /// Starts opening `tenant`'s library unless it is open or opening;
    /// returns the load lease.
    fn start_library(&mut self, tenant: &TenantId) -> Option<u64> {
        if self.libraries.iter().any(|l| {
            &l.tenant == tenant && matches!(l.state, LibraryState::Loading | LibraryState::Ready)
        }) {
            return None;
        }
        let lease = self.lease();
        let pending = self
            .libraries
            .iter_mut()
            .find(|l| &l.tenant == tenant)
            .map(|l| std::mem::take(&mut l.pending))
            .unwrap_or_default();
        self.libraries.retain(|l| &l.tenant != tenant);
        let mut library = Library::new(tenant.clone(), lease);
        library.pending = pending;
        self.libraries.push(library);
        Some(lease)
    }

    pub(super) fn open_library(&mut self, context: &ContextRef) -> Result<Option<u64>, Refusal> {
        let tenant = self.check_context(context)?;
        self.library_root
            .as_ref()
            .ok_or(Refusal::CapabilityMissing)?;
        Ok(self.start_library(&tenant))
    }

    pub(super) fn library_load_target(&self, lease: u64) -> Option<(std::path::PathBuf, String)> {
        let library = self.libraries.iter().find(|l| l.lease == lease)?;
        Some((
            self.library_root.clone()?,
            library.tenant.as_str().to_owned(),
        ))
    }

    /// Settles a load. Additions made meanwhile are merged (all or none)
    /// and need a write; their originators hear how they ended.
    pub(super) fn settle_library(
        &mut self,
        lease: u64,
        loaded: Result<CaseLibrary, LibraryFailure>,
    ) -> Option<(TenantId, u64)> {
        let library = self
            .libraries
            .iter_mut()
            .find(|l| l.lease == lease && l.state == LibraryState::Loading)?;
        let pending = std::mem::take(&mut library.pending);
        let (write, failed) = match loaded {
            Ok(cases) => {
                library.library = cases;
                library.state = LibraryState::Ready;
                if pending.is_empty() {
                    return None;
                }
                let cases = pending.iter().map(|p| p.case.clone()).collect();
                match library.library.merge(cases) {
                    Ok(_) => {
                        library.generation += 1;
                        let generation = library.generation;
                        for p in &pending {
                            library.outcomes.push(Outcome {
                                generation,
                                origin: p.origin.clone(),
                                notice: p.notice.clone(),
                                stamp: p.stamp,
                            });
                        }
                        (Some((library.tenant.clone(), generation)), None)
                    }
                    Err(problem) => (None, Some(problem)),
                }
            }
            Err(failure) => {
                library.state = LibraryState::Failed;
                library.failure = Some(failure);
                (None, Some(CaseProblem::NotSaved))
            }
        };
        if let Some(problem) = failed {
            for p in pending {
                self.deliver(&p.origin, p.stamp, Err(problem));
            }
        }
        write
    }

    fn changed_library(library: &mut Library) -> (TenantId, u64) {
        library.problem = None;
        library.generation += 1;
        (library.tenant.clone(), library.generation)
    }

    /// Saves a new case authored from `draft`. A library that is not open
    /// yet opens, and the case is added when it does (its write follows).
    pub(super) fn save_case(
        &mut self,
        context: &ContextRef,
        draft: CaseDraft,
    ) -> Result<CopyEffects, Refusal> {
        let tenant = self.check_context(context)?;
        self.library_root
            .as_ref()
            .ok_or(Refusal::CapabilityMissing)?;
        let name = draft.name.clone();
        let case = draft.into_case(tenant.as_str());
        let open = self
            .libraries
            .iter()
            .any(|l| l.tenant == tenant && l.state == LibraryState::Ready);
        if !open {
            let case = case.map_err(|_| Refusal::InvalidInput)?;
            let load = self.start_library(&tenant);
            let library = self
                .libraries
                .iter_mut()
                .find(|l| l.tenant == tenant)
                .ok_or(Refusal::Busy)?;
            if library.pending.len() >= crate::library::CASE_LIMIT {
                return Err(Refusal::Busy);
            }
            let stamp = library.act();
            library.pending.push(Pending {
                case,
                origin: tenant,
                notice: LibraryNotice::Saved { name },
                stamp,
            });
            return Ok((None, load));
        }
        let library = self.library_mut(&tenant)?;
        library.notice = None;
        match case.and_then(|case| library.library.add(case, tenant.as_str())) {
            Ok(()) => {
                let write = Self::changed_library(library);
                library.outcomes.push(Outcome {
                    generation: write.1,
                    origin: tenant,
                    notice: LibraryNotice::Saved { name },
                    stamp: library.status,
                });
                Ok((Some(write), None))
            }
            Err(problem) => {
                library.problem = Some(problem);
                Err(Refusal::InvalidInput)
            }
        }
    }

    /// Writes the library again (an explicit retry after a failed save).
    pub(super) fn retry_library(
        &mut self,
        context: &ContextRef,
    ) -> Result<(TenantId, u64), Refusal> {
        let tenant = self.check_context(context)?;
        let library = self.library_mut(&tenant)?;
        if library.unsaved.is_none() {
            return Err(Refusal::InvalidInput);
        }
        library.generation += 1;
        Ok((tenant, library.generation))
    }

    pub(super) fn delete_case(
        &mut self,
        context: &ContextRef,
        id: &str,
    ) -> Result<(TenantId, u64), Refusal> {
        let tenant = self.check_context(context)?;
        let library = self.library_mut(&tenant)?;
        library.notice = None;
        if library.library.remove(id).is_none() {
            library.problem = Some(CaseProblem::Missing);
            return Err(Refusal::InvalidInput);
        }
        Ok(Self::changed_library(library))
    }

    /// Adds catalog examples (new identifiers, this tenant) not already
    /// present by product and name.
    pub(super) fn add_examples(
        &mut self,
        tenant: &TenantId,
        parsed: Result<Vec<TestCase>, CaseProblem>,
    ) -> Result<(TenantId, u64), Refusal> {
        let library = self.library_mut(tenant)?;
        let examples = match parsed {
            Ok(examples) => new_examples(&library.library, examples),
            Err(problem) => {
                library.problem = Some(problem);
                return Err(Refusal::InvalidInput);
            }
        };
        if examples.is_empty() {
            library.problem = Some(CaseProblem::AllPresent);
            return Err(Refusal::InvalidInput);
        }
        match library.library.merge(examples) {
            Ok(added) => {
                library.notice = None;
                let write = Self::changed_library(library);
                library.outcomes.push(Outcome {
                    generation: write.1,
                    origin: tenant.clone(),
                    notice: LibraryNotice::ExamplesAdded {
                        added: u32::try_from(added).unwrap_or(u32::MAX),
                    },
                    stamp: library.status,
                });
                Ok(write)
            }
            Err(problem) => {
                library.problem = Some(problem);
                Err(Refusal::InvalidInput)
            }
        }
    }

