                                    onClick={() => newInvestigation(hint.question)}
                                >
                                    {C.startNew}
                                </button>
                            </div>
                        </div>
                    ) : null}
                    <section aria-label={C.transcript} data-slot='harness-transcript' className='min-w-0'>
