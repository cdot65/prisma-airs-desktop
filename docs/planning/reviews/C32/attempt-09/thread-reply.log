                            <p>{C.endedHint}</p>
                            <div className='flex flex-wrap gap-2'>
                                <button type='button' className='h-8 rounded-[7px] border px-3 text-[13px]' style={{ borderColor: 'var(--v2-rule)' }} onClick={() => openSaved(hint.id)}>
                                    {C.openSaved}
                                </button>
                                <button
