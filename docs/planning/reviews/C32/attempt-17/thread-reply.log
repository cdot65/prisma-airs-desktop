  shasum -a 256 "${FILES[@]}" apps/desktop/*.ts apps/desktop/*.json docs/architecture/*.json
} | LC_ALL=C sort -k2 > "$2"
[ -s "$2" ] || { echo "inventory: empty" >&2; exit 2; }
shasum -a 256 "$2" | cut -d' ' -f1
#!/bin/bash
# C32 check runs with a source-bound record. Usage: run-checks.sh <attempt>
# Runs on the approved toolchain (rustup 1.99.0, node 24.21.0, repo pnpm).
