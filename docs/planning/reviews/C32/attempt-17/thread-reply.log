   699	    /// give the message back and say why.
   700	    pub(super) fn harness_renewed(
   701	        &mut self,
   702	        job: RenewJob,
   703	        renewed: Result<Option<(Zeroizing<String>, u64)>, SignInFailure>,
   704	        mcp: Option<super::harness_mcp::ScopeTokens>,
   705	    ) {
   706	        let bound = self.harness.as_ref().is_some_and(|c| self.harness_bound(c));
   707	        let Some(c) = self.harness.as_mut().filter(|c| c.id == job.conversation) else {
   708	            return;
   709	        };
   710	        // Stopped or ended while renewing: nothing is sent or restarted,
   711	        // and the message is not lost (P06 review R3-F1).
   712	        if c.ended.is_some() || c.stop.is_some() {
   713	            c.keep_unsent(job);
   714	            return;
   715	        }
   716	        match renewed {
   717	            Ok(key) if bound => {
   718	                if let Some((_, renew_at)) = &key {
   719	                    c.engine_renew_at = Some(*renew_at);
   720	                }
   721	                // MCP tokens restart the engine only when what it holds
   722	                // changed; their next renewal time is kept either way.
   723	                let mcp = mcp.and_then(|(tokens, renew_at)| {
   724	                    c.mcp_renew_at = renew_at;
   725	                    let print = crate::harness::mcp::fingerprint(&c.mcp, &tokens);
   726	                    (c.mcp_fingerprint.as_deref() != Some(print.as_str())).then(|| {
   727	                        c.mcp_fingerprint = Some(print);
   728	                        tokens
   729	                    })
   730	                });
   731	                let command = match (key, mcp) {
   732	                    (None, None) => {
   733	                        if let Ok(mut p) = c.progress.lock() {
   734	                            p.phase = HarnessPhase::Answering;
   735	                        }
   736	                        Command::Send {
   737	                            id: job.id,
   738	                            prompt: job.prompt,
   739	                        }
   740	                    }
   741	                    (key, mcp) => Command::Renew {
   742	                        key: key.map(|(k, _)| k),
   743	                        mcp,
   744	                        id: job.id,
   745	                        prompt: job.prompt,
   746	                    },
   747	                };
   748	                if c.commands.try_send(command).is_err() {
   749	                    c.cancel.cancel();
   750	                }
   751	            }
   752	            Ok(_) => {}
   753	            Err(failure) => {
   754	                c.entries -= 1;
   755	                c.unsent = Some(job.prompt.to_string());
   756	                c.renew_failure = Some(failure);
   757	                if let Ok(mut p) = c.progress.lock() {
   758	                    p.phase = HarnessPhase::Ready;
   759	                }
   760	            }
   761	        }
   762	    }
   763	
   764	    pub(super) fn interrupt_harness(&mut self, id: &OperationId) -> Result<(), Refusal> {
   765	        let conversation = self.live_harness(id)?;
   766	        conversation
   767	            .commands
   768	            .try_send(Command::Interrupt)
   769	            .map_err(|_| Refusal::Busy)
   770	    }
