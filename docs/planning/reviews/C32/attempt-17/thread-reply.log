    54	/// The bodies of the Gateway requests that carried a tool's output.
    55	fn outputs(desk: &Desk) -> Vec<String> {
    56	    desk.requests(&format!("{RUNTIME}/responses"))
    57	        .into_iter()
    58	        .filter_map(|s| {
    59	            let body: Value = serde_json::from_slice(&s.body).ok()?;
    60	            let last = body["input"].as_array()?.last()?.clone();
    61	            (last["type"] == "function_call_output").then(|| last["output"].to_string())
    62	        })
    63	        .collect()
    64	}
