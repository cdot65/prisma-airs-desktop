   134	fn entry<'a>(c: &'a Value, role: &str) -> Option<&'a Value> {
   135	    c["entries"]
   136	        .as_array()?
   137	        .iter()
   138	        .rev()
   139	        .find(|e| e["role"] == role)
   140	}
