    46	fn tool(desk: &Desk, namespace: Option<&str>, name: &str, arguments: Value) {
    47	    desk.gateway.lock().expect("gateway").answer = Answer::Tool {
    48	        namespace: namespace.map(str::to_owned),
    49	        name: name.to_owned(),
