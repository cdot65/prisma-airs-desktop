+            entry("u-2", HarnessRole::Operator),
+            entry("msg-c", HarnessRole::Operator),
+        ];
+        assert_eq!(messages_after(&imported), 3);
+        let numbered = [
+            entry("u-1", HarnessRole::Operator),
+            entry("u-7", HarnessRole::Tool),
+        ];
+        assert_eq!(messages_after(&numbered), 7);
+    }
+}
