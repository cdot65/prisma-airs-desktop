    25	/// The Harness desk with the management inventories the proposals review.
    26	async fn desk() -> Desk {
    27	    let desk = desk_with(Some(real_engine()), None).await;
    28	    desk.gateway.lock().expect("gateway").hook = Some(Arc::new(|seen| {
    29	        let target = seen.request_line.split(' ').nth(1)?;
    30	        let path = target.split_once('?').map_or(target, |(p, _)| p);
    31	        let body = match path {
    32	            p if p.starts_with("/aisec/v1/mgmt/topics/tsg/") => json!({"custom_topics": [
    33	                {"topic_id": "11111111-1111-4111-8111-111111111111", "topic_name": "Finance",
    34	                 "revision": 1, "description": "Money talk"}]}),
    35	            p if p.starts_with("/aisec/v1/mgmt/apikeys/tsg/") => json!({"api_keys": [
    36	                {"api_key_id": "key-1", "api_key_name": "Runtime", "api_key_last8": "abcd1234",
    37	                 "cust_app": "Support bot", "expiration": "2027-01-01T00:00:00Z", "revoked": false,
    38	                 "status": "ACTIVE"}]}),
    39	            _ => return None,
    40	        };
    41	        Some(json_reply(200, &body))
    42	    }));
    43	    desk
    44	}
