   102	async fn answered_with(desk: &mut Desk, predicate: impl Fn(&Value) -> bool) -> Value {
   103	    // A desktop read waits for the operator's decision in the page (C32):
   104	    // these tests allow each one as it is asked.
   105	    let deadline = std::time::Instant::now() + Duration::from_secs(40);
   106	    loop {
   107	        let c = desk.conversation();
   108	        if predicate(&c) {
   109	            break;
   110	        }
   111	        assert!(std::time::Instant::now() < deadline, "{c}");
   112	        let reads: Vec<Value> = c["approvals"]
   113	            .as_array()
   114	            .map(|a| {
   115	                a.iter()
   116	                    .filter(|a| a["kind"] == "desktopRead")
   117	                    .cloned()
   118	                    .collect()
   119	            })
   120	            .unwrap_or_default();
   121	        for read in reads {
   122	            let _ = desk
   123	                .send(
   124	                    json!({"kind": "decideHarnessApproval", "conversation": c["id"],
   125	                    "approval": read["id"], "allow": true}),
   126	                )
   127	                .await;
   128	        }
   129	        tokio::time::sleep(Duration::from_millis(50)).await;
   130	    }
   131	    desk.conversation()
   132	}
