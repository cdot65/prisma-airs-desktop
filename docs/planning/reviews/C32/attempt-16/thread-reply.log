                let body = Value::Object(a.body.unwrap_or_default()).to_string();
                Self::ProposeChange {
                    kind: a.kind,
                    action: a.action,
                    target: a.target,
                    body,
                    summary: a.summary.chars().filter(|c| !c.is_control()).collect(),
                }
            }
