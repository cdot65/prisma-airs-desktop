/// A parsed, bounded tool call.
#[derive(Clone, Debug, PartialEq, Eq)]
pub enum ToolCall {
    Inventory {
        resource: ManagementResource,
        offset: u32,
        limit: u32,
    },
    Detail {
        resource: ManagementResource,
        id: String,
    },
    Session {
        session_id: String,
        app_id: String,
        app_name: String,
    },
    Search {
        query: String,
    },
    RedTeam {
        window: u8,
    },
    SupplyChain,
    Scan {
        profile: String,
        prompt: Option<String>,
        response: Option<String>,
    },
    Cases,
    /// The conversation's workspace MCP catalog (`GatewayRead::McpServers`, C32).
    McpServers,
    ProposeChange {
        kind: ChangeKind,
        action: ChangeAction,
        target: String,
        /// The body as JSON object text.
        body: String,
        summary: String,
    },
}

#[derive(Deserialize)]
#[serde(rename_all = "camelCase", deny_unknown_fields)]
struct InventoryArgs {
    resource: ManagementResource,
    #[serde(default)]
    offset: u32,
    limit: Option<u32>,
}

#[derive(Deserialize)]
#[serde(rename_all = "camelCase", deny_unknown_fields)]
struct DetailArgs {
    resource: ManagementResource,
    id: String,
}

#[derive(Deserialize)]
#[serde(rename_all = "camelCase", deny_unknown_fields)]
struct SessionArgs {
    session_id: String,
    app_id: String,
    app_name: String,
}

#[derive(Deserialize)]
#[serde(deny_unknown_fields)]
struct SearchArgs {
    query: String,
}

#[derive(Deserialize)]
#[serde(deny_unknown_fields)]
struct RedTeamArgs {
    window: u8,
}

#[derive(Deserialize)]
#[serde(deny_unknown_fields)]
struct Empty {}

#[derive(Deserialize)]
#[serde(deny_unknown_fields)]
struct ScanArgs {
    profile: String,
    prompt: Option<String>,
    response: Option<String>,
}

#[derive(Deserialize)]
#[serde(deny_unknown_fields)]
struct ProposeArgs {
    kind: ChangeKind,
    action: ChangeAction,
    #[serde(default)]
    target: String,
    #[serde(default)]
    body: Option<Map<String, Value>>,
    summary: String,
}

/// The inventories the tools offer (the schema's enum, enforced).
fn offered(resource: ManagementResource) -> bool {
    !matches!(resource, ManagementResource::DlpCatalog)
}

fn plain(text: &str) -> bool {
    !text.is_empty() && text.len() <= 256 && !text.chars().any(char::is_control)
}

/// Whether a value carries anything credential-like anywhere.
pub fn has_credentials(value: &Value) -> bool {
    match value {
        Value::Object(map) => map.iter().any(|(k, v)| sensitive(k) || has_credentials(v)),
        Value::Array(items) => items.iter().any(has_credentials),
        _ => false,
    }
}
