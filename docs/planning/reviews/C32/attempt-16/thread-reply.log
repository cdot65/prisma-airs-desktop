+            entry("a-51", HarnessRole::Assistant),
+            entry("u-52", HarnessRole::Operator),
+        ];
+        assert_eq!(messages_after(&evicted), 52);
+        assert_eq!(messages_after(&[]), 0);
+        // An imported transcript keeps its own IDs: counted, never reused.
