                    <h2 className='text-[14px] font-semibold'>{C.prerequisites}</h2>
                    <p className='mt-1 text-[13px]' style={{ color: 'var(--v2-soft)' }}>
                        {C.prerequisitesNote}
                    </p>
                    <ul className='mt-3 flex flex-col gap-2 text-[13px]'>
