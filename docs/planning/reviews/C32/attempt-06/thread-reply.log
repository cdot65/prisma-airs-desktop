temp=p.with_name(\"verdict.json.review-tmp\")
try:
 fd=os.open(temp,os.O_WRONLY|os.O_CREAT|os.O_EXCL,0o600)
 with os.fdopen(fd,\"w\") as f:
  json.dump(data,f,indent=2,ensure_ascii=False)
