#!/usr/bin/env python3
"""C32 native acceptance: the Harness in the v2 shell, driven through the
real fixture window with the real pinned engine against the synthetic
Gateway service that plays the model.

Run from the repository root after `xtask native-prepare --chunk C32`.
Requires the macOS Accessibility grant. Synthetic services only; the fixture
data root and the project folder are removed at the end.

Checks (docs/architecture/native-checks.json, C32): the screen and a fresh
tenant's first send starting a user conversation (N01); a decision in the
page with the tenant-switch guard through the switcher, the palette and the
Go menu, then decline and approve (N02); a proposal followed up only as the
operator's review in Administration, ending the conversation, and the next
send starting a new one (N03); keyboard reach and the 900x600 / 200% layout
in both themes (N04).
"""

import json
import os
import secrets
import shutil
import sys
import tempfile
import time

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
import fixture_app as fx  # noqa: E402
import acceptance_c08 as c8  # noqa: E402
import acceptance_c09 as c9  # noqa: E402
import acceptance_c16 as c16  # noqa: E402
import acceptance_c19 as c19  # noqa: E402
import acceptance_c28 as c28  # noqa: E402
import acceptance_c29 as c29  # noqa: E402
import native_sheets as sheets  # noqa: E402

ROOT = os.getcwd()
SUBJECT = os.environ.get("AIRS_NATIVE_SUBJECT", "C32")
EVIDENCE = os.path.join(ROOT, "docs/planning/evidence", SUBJECT)
NATIVE = os.path.join(EVIDENCE, "native" if SUBJECT == "C32" else "native-C32")
RECORD = os.path.join(EVIDENCE, "native-acceptance.json" if SUBJECT == "C32" else "native-acceptance-C32.json")
INFERENCE_KEY = "SYNTHETIC-C32-HARNESS-KEY"
MARKERS = ["Profile 0", "WROTE", "Operation not permitted", "fork", "Failed to write file", "unavailable", "unsupported"]
TOPIC = "11111111-1111-4111-8111-111111111111"
FIRST = "Which profiles block prompt injection?"
LOG = []
GUARD = "A Harness decision is waiting"


def rel(path):
    return os.path.relpath(path, ROOT)


def dialog(tree, label):
    return next((n for n in tree if (n.get("label") or "") == label and n.get("subrole") in ("AXDialog", "AXApplicationDialog")), None)


def ask(mgmt, name, arguments, namespace="airs_desktop"):
    """The next turn's model asks for this one tool call."""
    tool = {"name": name, "arguments": json.dumps(arguments)}
    if namespace:
        tool["namespace"] = namespace
    mgmt.mode(harnessTool=tool, toolMarkers=MARKERS)


def plain(mgmt):
    """The next turns answer with text only."""
    mgmt.mode(harnessTool=None, toolMarkers=MARKERS)


def send(app, text):
    app.type_into("AXTextArea", "Message", text)
    c29.press(app, "AXButton", "Send")


def answers(app, tree=None):
    return sum(c19.ANSWER in x for x in app.texts(tree if tree is not None else app.tree()))


def main():
    try:
        return run()
    finally:
        sheets.disable()
        fx.sh(["pkill", "-f", fx.PROCESS])
        fx.sh(["pkill", "-9", "-f", c19.ENGINE])
        fx.clean_fixture_root()


def run():
    global NATIVE
    prepared = json.load(open(os.path.join(EVIDENCE, "native-prepare.json")))
    bundle = os.path.join(ROOT, prepared["bundle"])
    exe = os.path.join(bundle, "Contents/MacOS/prisma-airs-desktop-v2")
    if c8.sha256(exe) != prepared["executable_sha256"]:
        raise SystemExit("prepared executable changed since native-prepare")
    work = tempfile.mkdtemp(prefix="airs-v2-c32-acceptance-")
    base = os.path.join(ROOT, "target", f"native-c32-{secrets.token_hex(6)}")
    project = os.path.join(base, "agent-demo")
    os.makedirs(project)
    for n in range(3):
        with open(os.path.join(project, f"file-{n}.txt"), "w") as f:
            f.write(f"content {n}\n")
    FINAL = NATIVE
    NATIVE = NATIVE + ".staging"
    if os.path.isdir(NATIVE):
        shutil.rmtree(NATIVE)
    os.makedirs(NATIVE)
    c29.NATIVE = NATIVE
    c19.NATIVE = NATIVE
    if os.path.isdir(c29.CAPTURES):
        shutil.rmtree(c29.CAPTURES)
    app = fx.App(bundle, work, LOG)
    c29._APP = app
    app.quit()
    fx.sh(["pkill", "-9", "-f", c19.ENGINE])
    fx.clean_fixture_root()
    endpoint = fx.ScanEndpoint(os.path.join(work, "endpoint"), c8.SCAN_KEY)
    endpoint.install_roots()
    endpoint.start()
    mgmt = c8.MgmtEndpoint(os.path.join(work, "endpoint"), os.path.join(work, "mgmt"))
    mgmt.install()
    mgmt.start()
    mgmt.mode()
    try:
        return exercise(app, endpoint, mgmt, prepared, project, FINAL)
    finally:
        endpoint.stop()
        mgmt.stop()
        shutil.rmtree(work, ignore_errors=True)
        shutil.rmtree(base, ignore_errors=True)


def exercise(app, endpoint, mgmt, prepared, project, FINAL):
    global NATIVE
    runtime = f"{mgmt.origin}/rt/v1"
    obs = {"captures": {}}
    sheets.enable()
    app.launch()
    pid = app.pid
    # Two tenants (A configured for the Harness, B never used), then v2.
    app.open_settings()
    app.type_into("AXTextField", "TSG ID (optional)", c8.TSG)
    app.create_custom_tenant("Tenant A", endpoint.origin)
    app.save_key(c8.SCAN_KEY)
    c8.save_client(app)
    app.type_into("AXTextField", "TSG ID (optional)", c8.TSG)
    app.create_custom_tenant("Tenant B", endpoint.origin)
    app.make_active("Tenant A")
    c29.press(app, "AXCheckBox", "Use the new interface")
    app.wait_for(lambda t: fx.App.node(t, "AXHeading", "Home") is not None and c29.nav(t, "Destinations") is not None, 15)
    app.menu("Go", "AI Gateway")
    app.wait_for(lambda t: fx.App.node(t, "AXHeading", c16.HEADING) is not None, 12)
    c8.text(app, "2 workspaces", 15)
    app.ax("press", "AXRadioButton", "Team A")
    c8.text(app, "Team A", 10)
    c16.tab(app, "Playground")
    app.type_into("AXTextField", "Runtime endpoint", runtime)
    app.type_into("AXTextField", "Workspace API key with completions access", INFERENCE_KEY, secure=True)
    app.ax("press", "AXButton", "Store key for Team A")
    c8.text(app, "stored", 12)

    # ---- N01: the screen; a fresh tenant's first send starts a user conversation ----
    n1 = {}
    app.menu("Go", "Harness")
    tree, n1["screen"] = app.wait_for(lambda t: fx.App.node(t, "AXHeading", "Harness") is not None
                                      and fx.App.node(t, "AXTextArea", "Message") is not None, 15)
    n1["status_line"] = app.has_text(tree, "Tenant A · Engine") and app.has_text(tree, "Team A")
    n1["no_checklist"] = not app.has_text(tree, "Before you start")
    n1["no_seeded"] = not any(n.get("role") == "AXButton" and (n.get("label") or "").endswith("Ended") for n in tree) and not app.has_text(tree, "claims-triage")
    n1["rail"] = any(n.get("role") == "AXNavigation" or (n.get("subrole") == "AXLandmarkNavigation" and (n.get("label") or "") == "Conversations") for n in tree) or app.has_text(tree, "New investigation")
    obs["tree_empty"] = c29.save_tree("harness-empty", tree)
    obs["captures"]["harness-empty"] = c29.matrix(app, "harness-empty")
    runs_before = len(c19.harness_runs(mgmt))
    plain(mgmt)
    send(app, FIRST)
    tree, n1["answered"] = app.wait_for(lambda t: answers(app, t) >= 1, 60)
    n1["model_turns"] = len(c19.harness_runs(mgmt)) - runs_before
    n1["titled"] = sum(FIRST in x for x in app.texts(tree)) >= 2  # the rail title and the transcript entry
    n1["engine"] = bool(c19.engines())
    obs["tree_first"] = c29.save_tree("harness-first-send", tree)
    obs["captures"]["harness-first"] = c29.matrix(app, "harness-first")
    obs["n1"] = n1

    # ---- N02: a decision in the page; the guard through every path; decline and approve ----
    n2 = {}
    c29.press(app, "AXButton", "Project, sign-in and workspace tools")
    app.wait_for(lambda t: fx.App.node(t, "AXButton", "Choose a folder…") is not None, 10)
    app.ax("press", "AXButton", "Choose a folder…")
    sheets.open_file(app, project)
    tree, n2["project"] = app.wait_for(lambda t: app.has_text(t, project), 15)
    # A project applies to the next conversation: choosing it ends a running one (C21); the
    # next send starts a new one.
    time.sleep(1)
    if fx.App.node(app.tree(), "AXButton", "End conversation") is not None:
        c29.press(app, "AXButton", "End conversation")
    app.wait_for(lambda t: fx.App.node(t, "AXButton", "End conversation") is None, 30)
    ask(mgmt, "exec_command", {"cmd": "ls", "yield_time_ms": 1000, "login": False}, namespace=None)
    send(app, "List the files.")
    tree, n2["asked"] = app.wait_for(lambda t: fx.App.node(t, "AXButton", "Approve once") is not None
                                     and fx.App.node(t, "AXButton", "Decline") is not None, 60)
    n2["names_call"] = app.has_text(tree, "The Harness asks to run")
    obs["tree_decision"] = c29.save_tree("harness-decision", tree)
    obs["captures"]["harness-decision"] = c29.matrix(app, "harness-decision")

    def guard_shown(timeout=10):
        return app.wait_for(lambda t: dialog(t, GUARD) is not None, timeout)

    c29.open_switcher(app)
    c29.press(app, "AXCheckBox", "Tenant B")
    tree, g1 = guard_shown()
    n2["guard_switcher"] = g1 and app.has_text(tree, "Switching to Tenant B ends it")
    n2["guard_buttons"] = [l for l in ("Stay", "Discard and switch", "Archive and switch") if fx.App.node(tree, "AXButton", l)]
    obs["tree_guard"] = c29.save_tree("guard-switcher", tree)
    c29.press(app, "AXButton", "Stay")
    app.wait_for(lambda t: dialog(t, GUARD) is None, 8)
    app.keys("k", "command down")
    app.wait_for(lambda t: any(n.get("role") == "AXComboBox" for n in t), 8)
    app.keys("Switch to Tenant B")
    time.sleep(0.5)
    app.keycode(36)
    _, n2["guard_palette"] = guard_shown()
    c29.press(app, "AXButton", "Stay")
    app.wait_for(lambda t: dialog(t, GUARD) is None, 8)
    app.menu("Go", "Switch Tenant…")
    app.wait_for(lambda t: any(n.get("role") == "AXGroup" and (n.get("label") or "") == "Switch tenant" for n in t), 8)
    time.sleep(0.3)
    c29.press(app, "AXCheckBox", "Tenant B")
    _, n2["guard_menu"] = guard_shown()
    c29.press(app, "AXButton", "Stay")
    tree, _ = app.wait_for(lambda t: dialog(t, GUARD) is None, 8)
    n2["still_tenant_a"] = "Tenant A" in str(c29.switcher(app.tree()).get("label") or "")
    n2["decision_kept"] = fx.App.node(app.tree(), "AXButton", "Approve once") is not None
    # Decline: recorded, nothing run.
    c29.press(app, "AXButton", "Decline")
    tree, n2["declined"] = app.wait_for(lambda t: fx.App.node(t, "AXButton", "Approve once") is None and app.has_text(t, "Declined"), 40)
    # Approve once: the command runs and the turn completes.
    turns = len(c19.harness_runs(mgmt))
    ask(mgmt, "exec_command", {"cmd": "ls", "yield_time_ms": 1000, "login": False}, namespace=None)
    send(app, "List them again.")
    it('keeps a refused or undelivered follow-up beside the edit made while it was delivered, and resends nothing (attempt-04 R1)', async () => {
        const l = LIFECYCLES[0]!
        const { native, user } = await launch(fxHarness({ ...l.steps.approved, proposals: [] }))
        const box = () => screen.getByRole('textbox', { name: 'Message' })
        const dispatch = native.transport.dispatch
        for (const how of ['refused', 'undelivered'] as const) {
            await user.clear(box())
            await user.type(box(), `Original follow-up ${how}`)
            let release: () => void = () => undefined
            const respond = native.respond
            native.transport.dispatch = async (bytes) => {
                const intent = (JSON.parse(new TextDecoder().decode(bytes)) as { intent: Intent }).intent
                if (intent.kind !== 'sendHarness') return dispatch(bytes)
                await new Promise<void>((resolve) => (release = resolve))
                if (how === 'undelivered') {
                    // Delivered nowhere: the client gives up and reports the delivery as failed or unknown.
                    native.respond = () => ({ outcome: 'refusal', refusal: 'busy' })
                }
                return dispatch(bytes)
            }
            native.respond = (intent: Intent) => (intent.kind === 'sendHarness' ? { outcome: 'refusal', refusal: 'busy' } : respond(intent))
            await user.click(screen.getByRole('button', { name: 'Send' }))
            await user.clear(box())
            await user.type(box(), 'A different draft')
            release()
            const notSent = await screen.findByRole('region', { name: 'Not sent' })
            expect(within(notSent).getByText(`Original follow-up ${how}`)).toBeInTheDocument()
            expect(box()).toHaveValue('A different draft')
            native.respond = respond
            native.transport.dispatch = dispatch
        }
        expect(native.dispatched.filter((i) => i.kind === 'sendHarness')).toHaveLength(2)
    })

    it('never calls an unconfirmed send "not sent": the transcript that shows it settles it, and nothing is resent (attempt-04 R2, lost send receipt)', async () => {
        const l = LIFECYCLES[0]!
        const ready = { ...l.steps.approved, proposals: [] }
        const { native, user } = await launch(fxHarness(ready))
        const box = () => screen.getByRole('textbox', { name: 'Message' })
        await user.type(box(), 'Follow-up question')
        // The core takes the message (the transcript shows it), but the receipt is lost.
        native.respond = (intent: Intent) => {
            if (intent.kind === 'sendHarness') throw new DeliveryOutcomeUnknown('lost')
            return { outcome: 'receipt', receipt: { kind: 'admitted', request: 'rq-1', operation: null } }
        }
        await native.push({
            ...native.current,
            harness: { ...native.current.harness, conversation: { ...ready, phase: 'answering', entries: [...ready.entries, { id: 'u-2', role: 'operator', text: 'Follow-up question', state: 'complete' }] } },
        })
        await native.push({ ...native.current, harness: { ...native.current.harness, conversation: ready } })
        await user.click(screen.getByRole('button', { name: 'Send' }))
        await waitFor(() => expect(native.dispatched.filter((i) => i.kind === 'sendHarness').length).toBeGreaterThan(0))
        await waitFor(() => expect(screen.getByRole('region', { name: 'Not confirmed' })).toBeInTheDocument())
        expect(document.body.textContent).not.toMatch(/Your message was not sent/)
        // The transcript then shows it: it leaves the list and the box.
        await native.push({
            ...native.current,
            harness: { ...native.current.harness, conversation: { ...ready, phase: 'answering', entries: [...ready.entries, { id: 'u-2', role: 'operator', text: 'Follow-up question', state: 'complete' }] } },
        })
        await waitFor(() => expect(screen.queryByRole('region', { name: 'Not confirmed' })).toBeNull())
        expect(box()).toHaveValue('')
        const sends = native.dispatched.filter((i) => i.kind === 'sendHarness')
        expect(new Set(sends.map((i) => JSON.stringify(i))).size).toBe(1)
    })

    it('a lost start receipt is never "no conversation started": the message stays, sent nowhere (attempt-04 R2, lost start receipt)', async () => {
        const { native, user } = await launch(fxHarness(null))
        const box = () => screen.getByRole('textbox', { name: 'Message' })
        await user.type(box(), 'First question')
        native.respond = (intent: Intent) => {
            if (intent.kind === 'startHarness') throw new DeliveryOutcomeUnknown('lost')
            return { outcome: 'receipt', receipt: { kind: 'admitted', request: 'rq-1', operation: null } }
        }
        await user.click(screen.getByRole('button', { name: 'Send' }))
        expect(await screen.findByText(/whether a conversation started is not known\. Your message was not sent to any conversation; it is still in the box\./)).toBeInTheDocument()
        expect(document.body.textContent).not.toMatch(/No conversation started/)
        // A conversation then appears (perhaps the one started): nothing is sent to it by itself.
        const base = { ...LIFECYCLES[0]!.steps.declined, entries: [], lastTurn: null, savedAt: null, proposals: [] }
        await native.push({ ...native.current, harness: { ...native.current.harness, conversation: { ...base, id: 'op-80', phase: 'ready' } } })
        await new Promise((r) => setTimeout(r, 50))
        expect(native.dispatched.filter((i) => i.kind === 'sendHarness')).toEqual([])
        expect(box()).toHaveValue('First question')
    })

    it('settles an unconfirmed send only by a message its own conversation added after it: a repeated prompt or another conversation settles nothing (attempt-05 R1)', async () => {
        const l = LIFECYCLES[0]!
        const ready = { ...l.steps.approved, proposals: [] }
        const opening = ready.entries.find((e) => e.role === 'operator')!.text
        const { native, user } = await launch(fxHarness(ready))
        const box = () => screen.getByRole('textbox', { name: 'Message' })
        native.respond = (intent: Intent) => {
            if (intent.kind === 'sendHarness') throw new DeliveryOutcomeUnknown('lost')
            return { outcome: 'receipt', receipt: { kind: 'admitted', request: 'rq-1', operation: null } }
        }
        // The same words as the opening question, receipt lost, no new transcript entry.
        await user.type(box(), opening)
        await user.click(screen.getByRole('button', { name: 'Send' }))
        const notConfirmed = await screen.findByRole('region', { name: 'Not confirmed' })
        expect(within(notConfirmed).getByText(opening)).toBeInTheDocument()
        await native.push({ ...native.current })
        expect(screen.getByRole('region', { name: 'Not confirmed' })).toBeInTheDocument()
        expect(box()).toHaveValue(opening)
        expect(screen.getByText(/It may have been delivered: check the transcript/)).toBeInTheDocument()
        // Another conversation showing those words settles nothing either.
        const other = { ...l.steps.declined, id: 'op-99', phase: 'ready' as const, proposals: [], entries: [{ id: 'u-1', role: 'operator' as const, text: opening, state: 'complete' as const }, { id: 'u-2', role: 'operator' as const, text: opening, state: 'complete' as const }] }
        await native.push({ ...native.current, harness: { ...native.current.harness, conversation: other } })
        expect(screen.getByRole('region', { name: 'Not confirmed' })).toBeInTheDocument()
        // One send (the client's single transport resend of the same delivery aside); nothing replayed.
        expect(new Set(native.dispatched.filter((i) => i.kind === 'sendHarness').map((i) => JSON.stringify(i))).size).toBe(1)
    })

    it('a retry whose receipt is lost moves a refused message from Not sent to Not confirmed, truthfully (attempt-05 R2)', async () => {
        const l = LIFECYCLES[0]!
        const { native, user } = await launch(fxHarness({ ...l.steps.approved, proposals: [] }))
        const box = () => screen.getByRole('textbox', { name: 'Message' })
        const respond = native.respond
        // Refused while the operator types something else: kept under Not sent.
        let release: () => void = () => undefined
        const dispatch = native.transport.dispatch
        native.transport.dispatch = async (bytes) => {
            const intent = (JSON.parse(new TextDecoder().decode(bytes)) as { intent: Intent }).intent
            if (intent.kind === 'sendHarness') await new Promise<void>((resolve) => (release = resolve))
            return dispatch(bytes)
        }
        native.respond = (intent: Intent) => (intent.kind === 'sendHarness' ? { outcome: 'refusal', refusal: 'busy' } : respond(intent))
        await user.type(box(), 'Retry me')
        await user.click(screen.getByRole('button', { name: 'Send' }))
        await user.clear(box())
        await user.type(box(), 'Something else')
        release()
        expect(within(await screen.findByRole('region', { name: 'Not sent' })).getByText('Retry me')).toBeInTheDocument()
        native.transport.dispatch = dispatch
        // The operator retries the same words; this time the receipt is lost.
        native.respond = (intent: Intent) => {
            if (intent.kind === 'sendHarness') throw new DeliveryOutcomeUnknown('lost')
            return respond(intent)
        }
        await user.clear(box())
        await user.type(box(), 'Retry me')
        await user.click(screen.getByRole('button', { name: 'Send' }))
        const notConfirmed = await screen.findByRole('region', { name: 'Not confirmed' })
        expect(within(notConfirmed).getByText('Retry me')).toBeInTheDocument()
        expect(screen.queryByRole('region', { name: 'Not sent' })).toBeNull()
        expect(screen.getByText(/It is listed under Not confirmed/)).toBeInTheDocument()
        expect(box()).toHaveValue('Retry me')
    })
})
