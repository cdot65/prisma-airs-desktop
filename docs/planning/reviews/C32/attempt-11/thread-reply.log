    ring_plain = c29.capture(app, "harness-ring-plain")
    n4["ring"] = c31.ring_on(app, "New investigation", ring_plain, "harness-ring-new")
    base = c28.window_size(pid)
    c28.set_window_size(pid, 900, 600)
