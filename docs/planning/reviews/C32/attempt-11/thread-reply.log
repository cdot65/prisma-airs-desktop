/**
 * A scripted native host for production presentation tests: it answers the
 * real DesktopClient's observe/dispatch calls, records every byte sent
 * across the boundary and pushes native snapshots on the observation
 * channel, as the Rust host would.
 */
import { act } from '@testing-library/react'
import type { DesktopTransport, Intent, MenuCommand, ShellSnapshot, TenantView } from '@prisma-airs/desktop-contracts'
import shellResponse from '@prisma-airs/desktop-contracts/fixtures/wire/observe-shell-response.json'

export const baseSnapshot = shellResponse.snapshot as ShellSnapshot

export function tenant(overrides: Partial<TenantView> = {}): TenantView {
    return {
        id: 'tn-0123456789abcdef',
        label: 'Prod EU',
        tsgId: '1234567890',
        destination: { kind: 'region', region: 'europe' },
        environment: 'production',
        origin: 'https://service-de.api.aisecurity.paloaltonetworks.com',
        scan: { state: 'missing', mode: null, failure: null },
        management: { state: 'missing', mode: null, failure: null, clientId: null, tokenOrigin: null },
        inference: { state: 'missing', mode: null, failure: null, target: null },
        products: ['runtimeSecurity'],
        setupWarnings: [],
        ...overrides,
    }
}

export function withTenant(snapshot: ShellSnapshot, view: TenantView, context = 'cx-aaaaaaaaaaaaaaaaaaaaaaaa'): ShellSnapshot {
    return { ...snapshot, tenants: [view], active: { tenant: view.id, context } }
}

type Respond = (intent: Intent) => unknown
/** Answers one management observation (the native `management` scope). */
type ObserveManagement = (operation: string) => unknown | Promise<unknown>
/** Answers one API Client observation (the native `workbench` scope). */
type ObserveWorkbench = (operation: string) => unknown | Promise<unknown>

export interface Native {
    transport: DesktopTransport
    dispatched: Intent[]
    /** Every request body sent to the native host, decoded as text. */
    sent: string[]
    /** Every update delivered to the presentation. */
    delivered: string[]
    respond: Respond
    observeManagement: ObserveManagement
    observeWorkbench: ObserveWorkbench
    push(snapshot: ShellSnapshot): Promise<void>
    /** Delivers a native menu command on the observation channel, as the host would. */
    pushMenu(command: MenuCommand): Promise<void>
    current: ShellSnapshot
}

const decoder = new TextDecoder()

export function scriptedNative(initial: ShellSnapshot): Native {
    const listeners: ((update: unknown) => void)[] = []
    let revision = BigInt(initial.revision)
    const native: Native = {
        dispatched: [],
        sent: [],
        delivered: [],
        current: initial,
        respond: () => ({ outcome: 'receipt', receipt: { kind: 'admitted', request: 'rq-1', operation: null } }),
        observeManagement: () => ({ kind: 'refusal', refusal: 'invalidInput' }),
        observeWorkbench: () => ({ kind: 'refusal', refusal: 'invalidInput' }),
        push: (next) =>
            act(async () => {
                // Native revisions only increase; the client ignores others.
                revision += 1n
                const snapshot = { ...next, revision: revision.toString() }
                native.current = snapshot
                const update = { kind: 'shell', snapshot }
                native.delivered.push(JSON.stringify(update))
                listeners.at(-1)?.(update)
                await new Promise((resolve) => setTimeout(resolve, 0))
            }),
        pushMenu: (command) =>
            act(async () => {
                const update = { kind: 'menu', command }
                native.delivered.push(JSON.stringify(update))
                listeners.at(-1)?.(update)
                await new Promise((resolve) => setTimeout(resolve, 0))
                    ) : null}
                </div>
            </div>
        </section>
    )
})

/**
 * How the conversation stands, in words the C19–C22 Harness used (R5): a
 * failure names itself; a stopped, cut, failed or refused answer is never
 * shown as complete; an engine that could not be removed says so.
 */
function outcomeOf(c: ConversationView): { tone: VerdictTone; word: string; text: string } | null {
    if (c.phase === 'failed') return { tone: 'blocked', word: C.outcome.failed, text: c.failure ? HARNESS_FAILURE_TEXT[c.failure] : conversationText(c) }
    if (c.cleanup === 'failed') return { tone: 'blocked', word: C.outcome.cleanup, text: HARNESS_FAILURE_TEXT.cleanupFailed }
    if (c.phase === 'ended') return { tone: 'info', word: C.outcome.ended, text: conversationText(c) }
    if (c.lastTurn && c.lastTurn !== 'completed' && c.phase === 'ready') {
        return { tone: c.lastTurn === 'failed' ? 'blocked' : 'flagged', word: C.outcome.turn[c.lastTurn] ?? c.lastTurn, text: TURN_TEXT[c.lastTurn] }
    }
    return null
}

function Transcript({ entries }: { entries: HarnessEntry[] }) {
    return (
        <ol className='flex flex-col gap-3'>
            {entries.map((e) => (
                <li key={e.id} data-slot='harness-entry' data-role={e.role} data-state={e.state} className='flex flex-col gap-1'>
                    <span className='text-[12px] font-medium' style={{ color: 'var(--v2-soft)' }}>
                        {C.role[e.role] ?? e.role}
                        {C.entryState[e.state] ? ` · ${C.entryState[e.state]}` : ''}
                    </span>
                    <p className='text-[13px] whitespace-pre-wrap'>{e.text}</p>
                </li>
            ))}
        </ol>
    )
}

/**
 * One decision, as the core classified it (R1): a read-only call is decided
 * here; anything that may change things says what, and approving it opens
 * the system confirmation, which alone lets it run.
 */
function Decision({ approval: a, busy, onDecide }: { approval: HarnessApproval; busy: boolean; onDecide: (allow: boolean) => void }) {
    const what = a.server && a.tool ? `${a.server}.${a.tool}` : (a.command ?? a.files.join(', '))
    // Absent (a snapshot before C32) counts as may-change: never a false assurance.
    const readOnly = a.effect === 'readOnly'
    return (
        <section aria-label={C.decision} data-slot='harness-decision' data-kind={a.kind} data-effect={a.effect ?? 'mayChange'} className='flex flex-col gap-2 rounded-[12px] border p-3' style={{ borderColor: 'var(--v2-flag)' }}>
            <Verdict tone={readOnly ? 'info' : 'flagged'} word={readOnly ? C.readOnlyWord : C.mayChangeWord} />
            <p className='text-[13px]'>{C.asks(C.kind[a.kind] ?? a.kind, what)}</p>
/**
 * Typed presentation facade over the two native commands.
 *
 * - Admission calls are serialized: the next delivery is sent only after the
 *   previous admission result arrives, and the sequence advances only then.
 * - A lost admission result is recovered by resending the same bytes with the
 *   same sequence. If it stays lost, the outcome is unknown: the facade
 *   rotates to a new delivery session and never reuses that sequence for a
 *   different intent. It never re-sends business work under a new sequence.
 * - Native responses are validated at runtime; generated declarations alone
 *   do not validate anything.
 */
