    send(app, "And yesterday?")
    tree, n3["new_conversation"] = app.wait_for(lambda t: app.has_text(t, "And yesterday?") and answers(app, t) >= 1 and fx.App.node(t, "AXButton", "End conversation") is not None, 60)
