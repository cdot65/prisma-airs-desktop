{"type":"item.completed","item":{"id":"item_46","type":"command_execution","command":"/bin/zsh -lc \"cat docs/planning/evidence/P09/native-controller/native_requirements.py && python3 -B -c 'import json; d=json.load(open(\\\"docs/architecture/native-checks.json\\\")); print(json.dumps(d[\\\"chunks\\\"][\\\"C32\\\"],indent=2)); c=json.load(open(\\\"docs/architecture/checks.json\\\")); print(\\\"checks schema\\\",list(c)); print(json.dumps(c.get(\\\"chunks\\\",{}).get(\\\"C32\\\"),indent=2))'\"","aggregated_output":"\"\"\"Read the C44 gate's existing assertion map without changing its requirements.\"\"\"\nimport json\nimport re\nimport runpy\n\n\ndef load_requirements(root):\n    manifest = json.loads((root / 'docs/architecture/native-checks.json').read_text())['chunks']\n    data = runpy.run_path(str(root / 'tools/native-acceptance/legacy_assertions.py'))\n    assertions = data['ASSERTIONS']\n    legacy_ids = {c['id'] for chunk, checks in manifest.items()\n                  if re.fullmatch(r'C(0[1-9]|1\\d|2\\d|3[0-3])', chunk) for c in checks}\n    assert legacy_ids == set(assertions), 'legacy map differs from the full manifest'\n    targets = {t for kind, ts, _ in assertions.values()\n               if kind in (data['X'], data['S'], data['P']) for t in ts}\n    self_run = {lid.split('-')[0] for lid, (kind, _, _) in assertions.items() if kind == data['S']}\n    required = {chunk: {t for t in targets if t.startswith(chunk + '-')} for chunk in self_run}\n    # Some legacy ids are carried by a different self-run driver. Only drivers with actual targets run;\n    # the union check below still requires every mapped target to be covered.\n    required = {chunk: checks for chunk, checks in required.items() if checks}\n    for chunk in [f'C{i}' for i in range(35, 45)]:\n        required[chunk] = {c['id'] for c in manifest[chunk]}\n    assert all(required.values()), 'empty required native check set'\n    assert targets <= set().union(*required.values()), 'mapped native target has no driver'\n    return required\n\n\ndef assess_record(record, root, executable_sha256, required):\n    errors = []\n    if record.get('app', {}).get('executable_sha256') != executable_sha256:\n        errors.append('stale executable')\n    checks = {c['id']: c for c in record.get('checks', [])}\n    for cid in sorted(required):\n        check = checks.get(cid)\n        if check is None:\n            errors.append(cid + ' missing')\n        elif check['result'] != 'pass':\n            errors.append(cid + ' ' + check['result'])\n        else:\n            errors.extend(cid + ' missing evidence: ' + e for e in check['evidence'] if not (root / e).exists())\n    carried_elsewhere = [cid for cid, c in checks.items() if cid not in required and c['result'] != 'pass']\n    return errors, carried_elsewhere\n[\n  {\n    \"id\": \"C32-N01\",\n    \"check\": \"The Harness renders in the v2 shell on the existing engine: the title row names the tenant, the engine and the workspace; the prerequisites checklist is hidden once satisfied; a fresh tenant shows no seeded conversation, and its first send through the composer starts a user conversation that the real engine answers, titled from that message in the rail (I12).\"\n  },\n  {\n    \"id\": \"C32-N02\",\n    \"check\": \"A command the engine asks to run while the project is read-only is decided in the page (Approve once / Decline) after a project is chosen through the embedded project panel; while it waits, a tenant switch through the switcher, the palette and Go \\u203a Switch Tenant\\u2026 each shows the guard (Stay, Discard and switch, Archive and switch) and Stay keeps the tenant and the decision (I1, V2-N01); Decline records it and runs nothing, Approve once runs it. With changes allowed, a command is shown as May change things: Approve\\u2026 opens the native confirmation, Cancel keeps it pending and runs nothing, Allow once runs it; the guard is the one topmost modal (the rail and the page hidden beneath it) with initial focus on Stay, and Escape closes it with focus returned to the switcher.\"\n  },\n  {\n    \"id\": \"C32-N03\",\n    \"check\": \"The workspace MCP catalog read the engine asks for (airs_desktop.mcpServers) is shown as read-only and read only once approved in the page; a change the engine proposes appears as a follow-up and writes nothing; Open the review shows it as the operator's typed review in Administration (Apply gated, still nothing written) and leaving it closes the follow-up; End conversation seals it (its transcript saved, the rail marks it ended, the engine is gone) and the next send starts a new conversation; the ended conversation is announced in a status region.\"\n  },\n  {\n    \"id\": \"C32-N04\",\n    \"check\": \"Keyboard: Tab from the message box reaches Send or End; at the 900\\u00d7600 minimum and 200% zoom in both themes nothing on the Harness screen lies past the window's right edge and there is no horizontal scroll bar; a focused changed control (New investigation) shows its focus ring (pixels around it change against the unfocused capture); with Reduce Motion on, the ended conversation's toast stays past 6 s until dismissed, and the system setting is restored.\"\n  }\n]\nchecks schema ['schema_version', 'status', 'target', 'fixture_only_features', 'setup_commands', 'common_commands', 'controller', 'shared_source_commands', 'artifact_build', 'chunks', 'phases', 'phase_native_prepare', 'invariants', 'requested_production_features', 'effective_features', 'controller_commands', 'reviewer', 'shared_lifecycle_contract', 'shared_source_required_chunks', 'shared_source_requirement', 'environment_contract']\n{\n  \"rust_target\": \"ui_v2_harness\",\n  \"fixture_command\": [\n    \"cargo\",\n    \"test\",\n    \"--locked\",\n    \"-p\",\n    \"desktop-core\",\n    \"--features\",\n    \"test-fixtures\",\n    \"--test\",\n    \"ui_v2_harness\"\n  ],\n  \"native_prepare\": [\n    \"cargo\",\n    \"run\",\n    \"--locked\",\n    \"-p\",\n    \"xtask\",\n    \"--\",\n    \"native-prepare\",\n    \"--chunk\",\n    \"C32\",\n    \"--target\",\n    \"aarch64-apple-darwin\",\n    \"--features\",\n    \"test-fixtures\"\n  ],\n  \"native_acceptance\": \"T09 relevant changed-UI checklist plus chunk-specific native assertions (including the UI v2 accessibility additions, DESIGN-V2 \\u00a78); real CUA/operator record required\",\n  \"live_requirement\": \"no product endpoint calls; fixture engine only\",\n  \"host_commands\": [\n    [\n      \"cargo\",\n      \"test\",\n      \"--locked\",\n      \"-p\",\n      \"desktop-core\",\n      \"--features\",\n      \"test-fixtures\"\n    ],\n    [\n      \"cargo\",\n      \"test\",\n      \"--locked\",\n      \"-p\",\n      \"desktop-host\",\n      \"--features\",\n      \"test-fixtures\"\n    ]\n  ],\n  \"frontend_commands\": [\n    [\n      \"pnpm\",\n      \"--filter\",\n      \"@prisma-airs/desktop\",\n      \"exec\",\n      \"vitest\",\n      \"run\",\n      \"--config\",\n      \"vitest.config.ts\"\n    ]\n  ]\n}\n","exit_code":0,"status":"completed"}}
