nNavigate={props.onNavigate} />\n                        ) : feature.id === 'academy' && feature.availability.state === 'available' ? (\n            })\n            .unwrap_or_default();\n        super::run_effects(self.inner, vec![Effect::Start(starts)]);\n    }\n}\n\n/// One tool call, admitted under the conversation's current binding and\n/// only while its turn lasts: `cancel` is checked under the lock right\n/// before anything is admitted, and while it waits (C21 review F1). What\n/// was already sent is not undone.\nasync fn run(\n    inner: &Arc<Inner>,\n    conversation: &OperationId,\n    call: ToolCall,\n    cancel: &CancellationToken,\n) -> Result<String, Refusal> {\n    let current = |state: &mut State| -> Result<(), Refusal> {\n        if cancel.is_cancelled() {\n            return Err(Refusal::StaleContext);\n        }\n        state.harness_live(conversation).map(|_| ())\n    };\n    let context = {\n        let mut state = lock(inner)?;\n        current(&mut state)?;\n        state.harness_live(conversation)?.context_ref().clone()\n    };\n    let management = |request: ManagementRequest| async {\n        let (_admitted, handle, starts) = {\n            let mut state = lock(inner)?;\n            current(&mut state)?;\n            let (operation, mut starts) = state.admit_management(\n                context.clone(),\n                request,\n                Arc::clone(&inner.adapters.keychain),\n                Arc::clone(&inner.session),\n            )?;\n            starts.extend(state.take_gateway_starts());\n            let handle = state.observe_management(&operation)?;\n            state.changed();\n            (Admitted { inner, operation }, handle, starts)\n        };\n        super::run_effects(inner, vec![Effect::Start(starts)]);\n        let result = handle.result().await;\n        Ok::<_, Refusal>(tools::result_text(\n            serde_json::to_value(result).unwrap_or(Value::Null),\n            &[],\n        ))\n    };\n    match call {\n        ToolCall::Inventory {\n            resource,\n            offset,\n            limit,\n        } => {\n            management(ManagementRequest::Page {\n                resource,\n                offset,\n                limit,\n            })\n            .await\n        }\n        ToolCall::Detail { resource, id } => {\n            management(ManagementRequest::Detail { resource, id }).await\n        }\n        ToolCall::Session {\n            session_id,\n            app_id,\n            app_name,\n        } => {\n            management(ManagementRequest::Session {\n                session_id,\n                app_id,\n                app_name,\n            })\n            .await\n        }\n        ToolCall::Search { query } => management(ManagementRequest::Search { query }).await,\n        ToolCall::RedTeam { window } => management(ManagementRequest::RedTeam { window }).await,\n        ToolCall::SupplyChain => management(ManagementRequest::SupplyChain).await,\n        ToolCall::McpServers => {\n            // The conversation's own workspace catalog, as the MCP panel reads it.\n            let reference = {\n                let mut state = lock(inner)?;\n                current(&mut state)?;\n                state.harness_live(conversation)?.workspace_binding().0\n            };\n            management(ManagementRequest::Gateway {\n                workspace: Some(reference),\n                read: crate::gateway::GatewayRead::McpServers,\n            })\n            .await\n        }\n        ToolCall::Scan {\n            profile,\n            prompt,\n            response,\n        } => {\n            let draft = crate::scanning::ScanDraft {\n                profile: crate::scanning::ProfileSelector::Name { name: profile },\n                prompt: prompt.unwrap_or_default(),\n                response: response.unwrap_or_default(),\n                app_name: None,\n            };\n            let (operation, starts) = {\n                let mut state = lock(inner)?;\n                current(&mut state)?;\n                let admitted = state.admit_scan(\n                    context.clone(),\n                    draft,\n                    None,\n                    Arc::clone(&inner.adapters.keychain),\n                    Arc::clone(&inner.session),\n                )?;\n                state.changed();\n                admitted\n            };\n            let _admitted = Admitted {\n                inner,\n                operation: operation.clone(),\n            };\n            super::run_effects(inner, vec![Effect::Start(starts)]);\n            loop {\n                tokio::time::sleep(Duration::from_millis(50)).await;\n                let mut state = lock(inner)?;\n                current(&mut state)?;\n                state.sync_scans_now();\n                if let Some(view) = state.scan_settled(&operation) {\n                    return Ok(tools::result_text(\n                        serde_json::to_value(view).unwrap_or(Value::Null),\n                        &[],\n                    ));\n                }\n            }\n        }\n        ToolCall::Cases => {\n            let load = {\n                let mut state = lock(inner)?;\n                current(&mut state)?;\n                state.open_library(&context)?\n            };\n            if let Some(lease) = load {\n                super::run_effects(inner, vec![Effect::LoadLibrary { lease }]);\n            }\n            loop {\n                {\n                    let mut state = lock(inner)?;\n                    current(&mut state)?;\n                    state.check_context(&context)?;\n                    let view = state.library_view();\n                    if !matches!(view.state, super::library_domain::LibraryState::Loading) {\n                        let cases: Vec<Value> = view\n                            .cases\n                            .iter()\n                            .take(200)\n                            .map(|c| {\n                                json!({\"id\":c.id,\"name\":c.name,\"profile\":c.profile,\n                                \"expected\":c.expected,\"appName\":c.app_name})\n                            })\n                            .collect();\n                        return Ok(tools::result_text(json!({\"cases\":cases}), &[]));\n                    }\n                }\n                tokio::time::sleep(Duration::from_millis(50)).await;\n            }\n        }\n        ToolCall::ProposeChange {\n            kind,\n            action,\n            target,\n            body,\n            summary,\n        } => {\n            let draft = ChangeDraft {\n                kind,\n                action,\n                target,\n                body,\n                workspace: None,\n            };\n            let id = {\n                let mut state = lock(inner)?;\n                current(&mut state)?;\n                let id = state.stage_proposal(conversation, draft, summary)?;\n                state.changed();\n                id\n            };\n            Ok(format!(\n                \"Proposal {id} is staged for the operator. It has not been applied: only the operator can review and confirm it in the desktop.\"\n            ))\n        }\n    }\n}\n\n/// What the native sheet asks for a decision that may change things (C32).\nfn harness_confirmation(a: &crate::harness::HarnessApproval) -> super::ConfirmationRequest {\n    use crate::harness::ApprovalKind;\n    let (title, message) = match a.kind {\n        ApprovalKind::FileChange => (\n            \"Allow the Harness to change files?\".to_owned(),\n            format!(\"It will change {} in the project folder.\", a.files.join(\", \")),\n275:    RequestApply {\n396:    DecideHarnessApproval {\n402:    ReviewHarnessProposal {\n411:    ConfirmHarnessWrite {\n822:    RequestApply => \"requestApply\",\n846:    DecideHarnessApproval => \"decideHarnessApproval\",\n847:    ReviewHarnessProposal => \"reviewHarnessProposal\",\n849:    ConfirmHarnessWrite => \"confirmHarnessWrite\",\n2741:    ConfirmHarness {\n4178:        Intent::RequestApply {\n4387:        Intent::DecideHarnessApproval {\n4397:                effects.push(Effect::ConfirmHarness {\n4406:        Intent::ReviewHarnessProposal {\n4427:        Intent::ConfirmHarnessWrite {\n5361:            Effect::ConfirmHarness {\ncrates/desktop-core/src/authority/workbench_domain.rs:261:    Managed,\ncrates/desktop-core/src/authority/workbench_domain.rs:364:    ReviewRequired {\ncrates/desktop-core/src/authority/workbench_domain.rs:2353:        return refused(WorkbenchProblem::Managed);\ncrates/desktop-core/src/authority/workbench_domain/send.rs:220:        let cookie = (admitted.class != CredentialClass::Managed)\ncrates/desktop-core/src/authority/workbench_domain/send.rs:257:struct Managed {\ncrates/desktop-core/src/authority/workbench_domain/send.rs:309:    ) -> Result<(Destinations, Option<Managed>), SendRefusal> {\ncrates/desktop-core/src/authority/workbench_domain/send.rs:331:        let mut managed = Managed {\ncrates/desktop-core/src/authority/workbench_domain/send.rs:410:    managed: Option<Managed>,\ncrates/desktop-core/src/authority/workbench_domain/send.rs:510:    if admitted.class != CredentialClass::Managed {\ncrates/desktop-core/src/authority/workbench_domain/send.rs:523:    if admitted.class != CredentialClass::Managed\ncrates/desktop-core/src/authority/workbench_domain/send.rs:757:    if !planned.admitted.needs_review() {\ncrates/desktop-core/src/authority/workbench_domain/send.rs:796:        return Step::Done(Box::new(WorkbenchResult::ReviewRequired { review: view }));\ncrates/desktop-core/src/authority/workbench_domain/send.rs:868:            && (self.admitted.class == CredentialClass::Managed || self.admitted.needs_review())\ncrates/desktop-core/src/authority/workbench_domain/send.rs:876:    let reviewed = planned.admitted.needs_review();\ncrates/desktop-core/src/authority/workbench_domain/send.rs:1331:    let cookies = if admitted.class == CredentialClass::Managed {\n","exit_code":0,"status":"completed"}}
