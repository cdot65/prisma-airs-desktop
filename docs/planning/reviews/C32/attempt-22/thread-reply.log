{"type":"item.completed","item":{"id":"item_26","type":"command_execution","command":"/bin/zsh -lc 'cat tools/native-acceptance/test_c32_coverage.py tools/native-acceptance/test_c32_native_audit.py tools/p09/test_c32_transition.py'","aggregated_output":"import copy\nimport runpy\nimport unittest\nfrom pathlib import Path\nfrom c32_coverage import BOOLEAN_FACTS, MOTION, problems\n\n\ndef complete():\n    o = {g: {f: True for f in fs} for g, fs in BOOLEAN_FACTS.items()}\n    o['n2'].update(guard_initial_focus='Stay', guard_buttons=['Stay', 'Discard and switch', 'Archive and switch'])\n    o['n3'].update(writes_after_staging=0, writes_after_review=0)\n    o['n4'].update(reduce_motion={f: True for f in MOTION}, zoom={t: {'overflow_px': 0, 'horizontal_scrollbars': 0} for t in ('light', 'dark')}, ring={'focused': 'New investigation', 'diff': 200})\n    return o\n\n\nclass Coverage(unittest.TestCase):\n    def test_complete(self): self.assertEqual(problems(complete()), [])\n    def test_every_missing_or_false_fact_rejected(self):\n        for g, fs in BOOLEAN_FACTS.items():\n            for f in fs:\n                for value in (None, False):\n                    with self.subTest(group=g, fact=f, value=value):\n                        o=complete(); o[g][f]=value; self.assertTrue(problems(o))\n    def test_motion_each_required(self):\n        for f in MOTION:\n            o=complete();del o['n4']['reduce_motion'][f];self.assertTrue(problems(o))\n    def test_guard_layout_ring_and_write_negative(self):\n        for group, field, value in [('n2','guard_initial_focus',''),('n2','guard_buttons',[]),('n3','writes_after_review',1),('n3','writes_after_staging',None),('n4','zoom',{}),('n4','ring',{})]:\n            o=complete();o[group][field]=value;self.assertTrue(problems(o))\n    def test_native_mapping_requires_original_assertions(self):\n        a=runpy.run_path(str(Path(__file__).with_name('legacy_assertions.py')))['ASSERTIONS']\n        for n in ('02','03','04'):\n            cid='C32-N'+n\n            self.assertIn(cid,a[cid][1])\n\nif __name__ == '__main__': unittest.main()\nimport copy\nimport json\nfrom pathlib import Path\nimport tempfile\nimport unittest\nfrom c32_native_audit import PREFIX, report\nfrom test_c32_coverage import complete\n\n\nclass NativeAggregation(unittest.TestCase):\n    def setUp(self):\n        self.work=tempfile.TemporaryDirectory();self.addCleanup(self.work.cleanup);self.root=Path(self.work.name)\n        self.original=self.root/PREFIX/'native-attempt-02';self.follow=self.root/PREFIX/'native-attempt-03';(self.original/'native').mkdir(parents=True);(self.follow/'native.staging').mkdir(parents=True)\n        app={'executable_sha256':'fixture','identifier':'fixture-id'}\n        self.raw={'app':app,'checks':[{'id':f'C32-N0{i}','description':'native requirement','result':'pass' if i==1 else 'fail'} for i in range(1,5)]}\n        obs=complete();obs['n3']['ended_announced']=False;obs['n4']['send_reached']=False\n        self.write(self.original/'native-acceptance.json',self.raw);self.write(self.original/'native/observations.json',{'observations':obs})\n        self.write(self.root/'keyboard.json',[{'role':'AXButton','label':'Send','focused':True}]);self.write(self.root/'ended.json',[{'subrole':'AXApplicationStatus','depth':0},{'label':'Ended','depth':1}])\n        self.extra={'app':app,'keyboard':{'before':{'role':'AXTextArea','label':'Message'},'after':{'role':'AXButton','label':'Send'},'send_reached':True,'tree':'keyboard.json'},'ended_status':{'tree':'ended.json','status_regions':['Ended'],'ended_announced':True,'engine_gone':True,'saved_transcript':True,'rail_ended':True}}\n        self.path=self.follow/'native.staging/followup-observations.json';self.write(self.path,self.extra)\n    def write(self,path,value):path.write_text(json.dumps(value))\n    def test_new_aggregate_preserves_raw_failing_results(self):\n        before=(self.original/'native-acceptance.json').read_bytes();v=report(self.root)\n        self.assertTrue(all(c['result']=='pass' for c in v['checks']));self.assertEqual(v['raw_results']['C32-N02'],'fail');self.assertEqual(before,(self.original/'native-acceptance.json').read_bytes())\n    def test_missing_or_failed_followup_rejected(self):\n        for k in ['ended_announced','engine_gone','saved_transcript','rail_ended']:\n            x=copy.deepcopy(self.extra);x['ended_status'][k]=False;self.write(self.path,x)\n            with self.subTest(fact=k),self.assertRaises(AssertionError):report(self.root)\n    def test_wrong_bundle_rejected(self):\n        self.extra['app']=dict(self.extra['app'],executable_sha256='different');self.write(self.path,self.extra)\n        with self.assertRaises(AssertionError):report(self.root)\n    def test_native_focused_node_required(self):\n        self.write(self.root/'keyboard.json',[{'role':'AXButton','label':'Send','focused':False}])\n        with self.assertRaises(AssertionError):report(self.root)\n    def test_native_status_region_required(self):\n        self.write(self.root/'ended.json',[{'label':'Ended','depth':0}])\n        with self.assertRaises(AssertionError):report(self.root)\n\nif __name__=='__main__':unittest.main()\nimport unittest\nfrom c32_transition_policy import validate_input_delta, require_bundle_equivalence\n\nclass ReuseProof(unittest.TestCase):\n    def test_only_declared_c32_driver_change(self):\n        p='tools/native-acceptance/acceptance_c32_current.py'\n        self.assertEqual(validate_input_delta({'apps/source':'same'},{'apps/source':'same',p:'new'},{p:{}}),{p})\n    def test_production_or_shared_helper_change_rejected(self):\n        for p in ['apps/desktop/src/v2/harness/harness.tsx','crates/desktop-core/src/authority.rs','tools/native-acceptance/fixture_app.py','tools/native-acceptance/mgmt_server.py','Cargo.lock']:\n            with self.subTest(path=p),self.assertRaises(ValueError): validate_input_delta({p:'before'},{p:'after'},{p:{}})\n    def test_undeclared_new_driver_rejected(self):\n        with self.assertRaises(ValueError): validate_input_delta({}, {'tools/native-acceptance/acceptance_c32_current.py':'new'}, {})\n    def test_application_mode_symlink_and_bytes_all_bound(self):\n        expected={'binary':{'sha256':'same','mode':493},'link':{'target':'binary','mode':511}}\n        require_bundle_equivalence(expected,expected)\n        for changed in [{'binary':{'sha256':'changed','mode':493},'link':expected['link']},{'binary':{'sha256':'same','mode':420},'link':expected['link']},{'binary':expected['binary'],'link':{'target':'other','mode':511}}]:\n            with self.assertRaises(ValueError): require_bundle_equivalence(expected,changed)\n\nif __name__=='__main__': unittest.main()\n","exit_code":0,"status":"completed"}}
