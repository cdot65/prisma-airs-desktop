fline\": {\n          \"exit\": 0,\n          \"log\": \"docs/planning/evidence/P09/runs/attempt-09/l19-offline.log\",\n          \"log_sha256\": \"0f82e78276f26ffd6de742cb7b6d508c77a5f41bdec0dc7a3121656d0ae0882d\",\n          \"summary\": [\n            \"test result: ok. 15 passed; 0 failed; 0 ignored; 0 measured; 0 filtered out; finished in 0.01s\",\n            \"test result: ok. 57 passed; 0 failed; 0 ignored; 0 measured; 0 filtered out; finished in 30.35s\",\n            \"EXIT 0\"\n          ]\n        },\n        \"l19-native-driver\": {\n          \"exit\": 0,\n          \"log\": \"docs/planning/evidence/P09/runs/attempt-09/l19-native-driver.log\",\n          \"log_sha256\": \"db627b3f4da28a2df98ac36cd5fba5b549ab3e71e9c7a8c65cb500bff1e43cdb\",\n          \"summary\": [\n            \"EXIT 0\"\n          ]\n        }\n      }\n    }\n  ],\n  \"native_acceptance\": {\n    \"prepare\": \"docs/planning/evidence/P09/native-prepare.json\",\n    \"prepare_sha256\": \"32d8ffc6c1bd3ca8cff93813f7c1b2be1067439ea7a0bba8dd198a053a7f28f9\",\n    \"mapped_records\": [\n      {\n        \"subject\": \"C32\",\n        \"record\": \"docs/planning/evidence/C32/remediation-attempt-21/coverage/native-acceptance.json\",\n        \"sha256\": \"1477608b0ab6162a9f61a2bded082237ec17ef83e37e9998d89a4ac9b54d8a45\",\n        \"required_targets\": [\n          \"C32-N02\",\n          \"C32-N03\",\n          \"C32-N04\"\n        ],\n        \"executable_sha256\": \"38a08638a5e8bf27d65d5fbf9ac28ec042f684114e6df7025aa30ad8de201e72\",\n        \"origin\": \"P09 integrated native\",\n        \"prepare\": \"docs/planning/evidence/P09/native-prepare.json\",\n        \"prepare_sha256\": \"32d8ffc6c1bd3ca8cff93813f7c1b2be1067439ea7a0bba8dd198a053a7f28f9\"\n      },\n      {\n        \"subject\": \"C38\",\n        \"record\": \"docs/planning/evidence/P09/native/cumulative/C38/native-acceptance.json\",\n        \"sha256\": \"a8ca695cea267e7adbe64fcf28f1244159f32c62a823d887030c8677aa0ce8ef\",\n        \"required_targets\": [\n          \"C38-N01\",\n          \"C38-N02\",\n          \"C38-N03\"\n        ],\n        \"executable_sha256\": \"38a08638a5e8bf27d65d5fbf9ac28ec042f684114e6df7025aa30ad8de201e72\",\n        \"origin\": \"P09 integrated native\",\n        \"prepare\": \"docs/planning/evidence/P09/native-prepare.json\",\n        \"prepare_sha256\": \"32d8ffc6c1bd3ca8cff93813f7c1b2be1067439ea7a0bba8dd198a053a7f28f9\"\n      }\n    ],\n    \"performance\": {\n      \"record\": \"docs/planning/evidence/P09/workload-perf-C30.json\",\n      \"sha256\": \"1470aa5bf1ec3d191be637bc0e5817d6449455c5bcf556236cfedb09cc14eb2f\",\n      \"current_qualification\": false,\n      \"standing\": \"Historical G7 measurement retained under owner C30 closure; not a measurement of current C31 application bytes; no new C30 scenario or timing run authorized.\"\n    },\n    \"assertion_mapping\": {\n      \"C32-N01\": [\n        \"x\",\n        [\n          \"C38-N01\"\n        ],\n        \"the title band names tenant, engine and workspace; a fresh tenant's first send starts a conversation\"\n      ],\n      \"C32-N02\": [\n        \"s\",\n        [\n          \"C32-N02\",\n          \"C38-N01\",\n          \"C38-N02\",\n          \"C38-N03\"\n        ],\n        \"C32 current native driver requires embedded project selection, read-only command decline/approve, write-capable native Cancel/Allow and isolated three-path guard with initial/final focus; C38 retains the board checks\"\n      ],\n      \"C32-N03\": [\n        \"s\",\n        [\n          \"C32-N03\",\n          \"C38-N01\"\n        ],\n        \"C32 current native driver requires the approved MCP read, proposal-only typed review and review-exit follow-up, explicit End with saved transcript, ended rail/status, engine exit and next conversation\"\n      ],\n      \"C32-N04\": [\n        \"s\",\n        [\n          \"C32-N04\",\n          \"C38-N02\"\n        ],\n        \"C32 current native driver requires composer ke