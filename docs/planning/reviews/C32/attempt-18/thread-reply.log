   806	        <section aria-label={C.decision} data-slot='harness-decision' data-kind={a.kind} data-effect={a.effect ?? 'mayChange'} className='flex flex-col gap-2 rounded-[12px] border p-3' style={{ borderColor: 'var(--v2-flag)' }}>
   807	            <Verdict tone={readOnly ? 'info' : 'flagged'} word={readOnly ? C.readOnlyWord : C.mayChangeWord} />
   808	            <p className='text-[13px]'>{C.asks(C.kind[a.kind] ?? a.kind, what)}</p>
   809	            {a.arguments ? (
   810	                <pre className='overflow-x-auto rounded-[8px] p-2 text-[12px]' style={{ background: 'var(--v2-side)' }}>
   811	                    {a.arguments}
   812	                </pre>
   813	            ) : null}
   814	            {a.cwd ? <p className='text-[12px]'>{C.inFolder(a.cwd)}</p> : null}
   815	            {a.reason ? <p className='text-[12px]'>{a.reason}</p> : null}
   816	            <p className='text-[12px]' style={{ color: 'var(--v2-soft)' }}>
   817	                {readOnly ? (C.readOnlyNote[a.kind] ?? C.readOnlyNote.desktopRead) : (C.mayChangeNote[a.kind] ?? C.mayChangeNote.mcpTool)}
   818	            </p>
   819	            <div className='flex flex-wrap gap-2'>
   820	                <button
   821	                    type='button'
   822	                    disabled={busy}
   823	                    className='h-8 rounded-[7px] px-3 text-[13px] font-semibold disabled:opacity-60'
