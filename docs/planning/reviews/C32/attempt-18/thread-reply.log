    assert_eq!(idp.lock().expect("idp").refreshes, 1);
    assert_eq!(gateway_keys(&desk).len(), 2);
    assert_eq!(desk.launcher.launches().len(), launches);
    std::fs::remove_dir_all(&dir).expect("cleanup");
