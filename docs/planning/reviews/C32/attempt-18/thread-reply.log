   765	/**
   766	 * How the conversation stands, in words the C19–C22 Harness used (R5): a
   767	 * failure names itself; a stopped, cut, failed or refused answer is never
   768	 * shown as complete; an engine that could not be removed says so.
   769	 */
   770	function outcomeOf(c: ConversationView): { tone: VerdictTone; word: string; text: string } | null {
   771	    if (c.phase === 'failed') return { tone: 'blocked', word: C.outcome.failed, text: c.failure ? HARNESS_FAILURE_TEXT[c.failure] : conversationText(c) }
   772	    if (c.cleanup === 'failed') return { tone: 'blocked', word: C.outcome.cleanup, text: HARNESS_FAILURE_TEXT.cleanupFailed }
   773	    if (c.phase === 'ended') return { tone: 'info', word: C.outcome.ended, text: conversationText(c) }
   774	    if (c.lastTurn && c.lastTurn !== 'completed' && c.phase === 'ready') {
   775	        return { tone: c.lastTurn === 'failed' ? 'blocked' : 'flagged', word: C.outcome.turn[c.lastTurn] ?? c.lastTurn, text: TURN_TEXT[c.lastTurn] }
   776	    }
   777	    return null
   778	}
