                    native.delivered.push(JSON.stringify(response))
                    return response
                }
                if (body.scope.kind === 'workbench') {
                    const response = await native.observeWorkbench(body.scope.operation ?? '')
                    native.delivered.push(JSON.stringify(response))
                    return response
