   785	                    <span className='text-[12px] font-medium' style={{ color: 'var(--v2-soft)' }}>
   786	                        {C.role[e.role] ?? e.role}
   787	                        {C.entryState[e.state] ? ` · ${C.entryState[e.state]}` : ''}
   788	                    </span>
   789	                    <p className='text-[13px] whitespace-pre-wrap'>{e.text}</p>
   790	                </li>
   791	            ))}
   792	        </ol>
   793	    )
   794	}
