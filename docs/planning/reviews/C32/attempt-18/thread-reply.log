   839	        const body = JSON.parse(p.draft.body) as { cust_app?: unknown }
   840	        return typeof body.cust_app === 'string' ? body.cust_app : null
   841	    } catch {
   842	        return null
   843	    }
   844	}
   845	
   846	/** The Harness's proposals as follow-ups: each opens only as the operator's own review, and only while its conversation runs. */
   847	function FollowUps({
   848	    proposals,
   849	    rotations,
   850	    busy,
   851	    open,
   852	    onOpen,
   853	    onDismiss,
   854	}: {
   855	    proposals: ProposalView[]
   856	    rotations: RotationView[]
   857	    busy: boolean
   858	    open: boolean
   859	    onOpen: (p: ProposalView) => void
   860	    onDismiss: (p: ProposalView) => void
   861	}) {
   862	    return (
   863	        <section aria-label={C.followUps} data-slot='harness-follow-ups' className='flex flex-col gap-2 rounded-[12px] border p-3' style={{ borderColor: 'var(--v2-rule)' }}>
   864	            <h2 className='text-[14px] font-semibold'>{C.followUps}</h2>
   865	            <p className='text-[12px]' style={{ color: 'var(--v2-soft)' }}>
   866	                {open ? C.followUpNote : C.followUpEnded}
   867	            </p>
   868	            <ul className='flex flex-col gap-2'>
   869	                {proposals.map((p) => {
   870	                    // A key rotation's hand-off says where the rotation stands (I7).
   871	                    const app = p.draft.kind === 'apiKeys' && p.draft.action === 'version' ? applicationOf(p) : null
   872	                    const rotation = app ? (rotations.find((r) => r.application === app) ?? null) : null
   873	                    const stateTone: VerdictTone = p.state === 'staged' ? 'info' : p.state === 'inReview' ? 'flagged' : 'allowed'
   874	                    return (
   875	                        <li key={p.id} data-slot='follow-up' data-kind={p.draft.kind} data-action={p.draft.action} data-state={p.state} className='flex flex-col gap-1 text-[13px]'>
   876	                            <span className='font-medium'>{p.summary}</span>
   877	                            {app ? (
   878	                                <span data-slot='follow-up-rotation' className='text-[12px]'>
   879	                                    {rotation ? (C.rotation[rotation.stage] ?? rotation.stage) : C.rotation.none}
   880	                                </span>
   881	                            ) : null}
   882	                            {p.state !== 'staged' ? <Verdict tone={stateTone} word={p.state === 'inReview' ? C.inReview : p.state === 'closed' ? C.closed : C.dismissed} /> : null}
   883	                            {open && (p.state === 'staged' || p.state === 'inReview') ? (
   884	                                <div className='flex flex-wrap gap-2'>
   885	                                    <button
   886	                                        type='button'
   887	                                        disabled={busy}
   888	                                        className='h-8 rounded-[7px] px-3 text-[13px] font-semibold disabled:opacity-60'
   889	                                        style={{ background: 'var(--v2-acc)', color: 'var(--v2-acc-ink)' }}
   890	                                        onClick={() => onOpen(p)}
   891	                                    >
   892	                                        {p.state === 'staged' ? C.openReview : C.goToReview}
   893	                                    </button>
   894	                                    {p.state === 'staged' ? (
   895	                                        <button type='button' disabled={busy} className='h-8 rounded-[7px] border px-3 text-[13px] disabled:opacity-60' style={{ borderColor: 'var(--v2-rule)' }} onClick={() => onDismiss(p)}>
   896	                                            {C.dismiss}
   897	                                        </button>
   898	                                    ) : null}
   899	                                </div>
   900	                            ) : null}
   901	                        </li>
   902	                    )
   903	                })}
   904	            </ul>
   905	        </section>
   906	    )
   907	}

