    pub(super) fn harness_mcp_scope(
        &self,
        id: &OperationId,
    ) -> Option<(TenantId, String, Vec<crate::harness::mcp::ScopeServer>)> {
        let c = self.harness.as_ref().filter(|c| &c.id == id)?;
