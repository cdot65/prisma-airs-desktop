#!/bin/bash
# Deterministic inventory of the inputs C32's checks compile, test or build:
# the Rust crates and host, the desktop app sources and configuration, the
# contracts package sources and fixtures, the Academy shared source actually
# consumed (.work/academy/src and its installed packages, staged from
# .inputs/academy), the native acceptance tools, the lockfiles, the workspace
# and toolchain manifests, the harness pin and every docs/architecture/*.json.
# Every listed path must exist: a missing one fails the inventory (exit 2)
# instead of producing a partial digest.
# Usage: hash-inputs.sh <repo-root> <inventory-out>; prints the digest.
set -euo pipefail
cd "$1"
DIRS=(crates apps/desktop/src apps/desktop/src-tauri packages/desktop-contracts/src packages/desktop-contracts/fixtures tools/native-acceptance tools/academy .work/academy/src .work/academy/packages .inputs/academy)
FILES=(Cargo.toml Cargo.lock rust-toolchain.toml pnpm-lock.yaml package.json pnpm-workspace.yaml resources/harness/pin.json apps/desktop/package.json apps/desktop/index.html packages/desktop-contracts/package.json packages/desktop-contracts/tsconfig.json)
for p in "${DIRS[@]}"; do [ -d "$p" ] || { echo "inventory: missing directory $p" >&2; exit 2; }; done
for p in "${FILES[@]}"; do [ -f "$p" ] || { echo "inventory: missing file $p" >&2; exit 2; }; done
{
  find "${DIRS[@]}" -type f -not -path '*/target/*' -not -path '*/node_modules/*' -not -path '*/gen/schemas/*' -not -path '*/.git/*' -print0 | sort -z | xargs -0 shasum -a 256
  shasum -a 256 "${FILES[@]}" apps/desktop/*.ts apps/desktop/*.json docs/architecture/*.json
} | LC_ALL=C sort -k2 > "$2"
[ -s "$2" ] || { echo "inventory: empty" >&2; exit 2; }
shasum -a 256 "$2" | cut -d' ' -f1
#!/bin/bash
# C32 check runs with a source-bound record. Usage: run-checks.sh <attempt>
# Runs on the approved toolchain (rustup 1.99.0, node 24.21.0, repo pnpm).
set -o pipefail
ATTEMPT=${1:-attempt-01}
cd "$(dirname "$0")/../../../../.."
export PATH="$PWD/.tools/bin:$HOME/.cargo/bin:$HOME/.nvm/versions/node/v24.21.0/bin:/usr/bin:/bin:/usr/sbin:/sbin"
unset RUSTFLAGS CARGO_BUILD_RUSTFLAGS CARGO_TARGET_DIR
E=docs/planning/evidence/C32/runs
# Flake logs are same-input retries of this run only: earlier runs' logs are removed first.
rm -f $E/core-fixtures.flake-*.log
BEFORE=$($E/hash-inputs.sh "$PWD" $E/inputs-before.sha256) || { echo "input inventory failed; run invalid"; exit 2; }
[ -n "$BEFORE" ] || { echo "input inventory produced no digest; run invalid"; exit 2; }
# Configuration and build flags the controller fingerprints: itemised and hashed together.
BUILD_FLAGS=$(shasum -a 256 docs/architecture/checks.json docs/architecture/native-checks.json docs/architecture/toolchain.json docs/architecture/budgets.json apps/desktop/src-tauri/tauri.conf.json apps/desktop/src-tauri/tauri.fixture.conf.json apps/desktop/src-tauri/capabilities/*.json rust-toolchain.toml 2>/dev/null | shasum -a 256 | cut -d' ' -f1)
export BUILD_FLAGS
run() { local name=$1; shift; local log=$E/$name.log; echo "\$ $*" > "$log"; "$@" >> "$log" 2>&1; local rc=$?; echo "EXIT $rc" >> "$log"; echo "$name exit=$rc"; echo $rc > $E/$name.exit; }
