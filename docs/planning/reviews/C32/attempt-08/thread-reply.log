   263	        useShellStore.getState().toast(saved ? C.endedToastSaved(conversation.historyId.slice(0, 8)) : C.endedToast, 'info', undefined, tenant?.id ?? null, context)
   264	        // eslint-disable-next-line react-hooks/exhaustive-deps -- once per ended conversation
   265	    }, [conversation?.id, conversation?.phase])
