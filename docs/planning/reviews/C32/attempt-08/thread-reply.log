   267	    async function send() {
   268	        const raw = draft
   269	        const text = raw.trim()
   270	        if (!text || busy || queuedRef.current) return
   271	        if (current && !fresh) {
   272	            if (current.phase !== 'ready') return
   273	            // The box is cleared only once the core took the message, and only
   274	            // if it still holds what was sent (R2, R3).
   275	            // Judged later only against operator messages added after this point (R1).
   276	            const before = operatorCount(current)
   277	            const outcome = await run({ kind: 'sendHarness', conversation: current.id, prompt: text })
   278	            if (outcome.kind === 'admitted') {
   279	                if (box() === raw) setDraft('')
   280	            } else if (outcome.kind === 'unknown') {
   281	                uncertain(text, current.id, before)
   282	            } else {
   283	                // Refused or never delivered: the exact text stays, beside any later edit (R1).
   284	                const where = recover(text)
   285	                setProblem((p) => `${p ?? C.failed} ${C.notSent[where]}`)
   286	            }
   287	            return
   288	        }
   289	        const q: Queued = { id: ++submissions.current, text, raw, stage: current ? 'ending' : 'clearing' }
   290	        if (current) {
   291	            // A new investigation: the current conversation ends (its transcript is kept), then the next one starts.
   292	            if (pendingDecision) {
   293	                setProblem(C.decideFirst)
   294	                return
   295	            }
   296	            setQueued(q)
   297	            const ended = await run({ kind: 'endHarness', conversation: current.id })
   298	            if (ended.kind !== 'admitted') retire(q, (w) => (ended.kind === 'unknown' ? C.unconfirmedStep[w] : C.notStarted[w]), true)
   299	            return
   300	        }
   301	        setQueued(q)
   302	        await begin(q, conversation)
   303	    }
