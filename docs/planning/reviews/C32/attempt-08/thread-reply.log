   662	
   663	/**
   664	 * How the conversation stands, in words the C19–C22 Harness used (R5): a
   665	 * failure names itself; a stopped, cut, failed or refused answer is never
   666	 * shown as complete; an engine that could not be removed says so.
   667	 */
   668	function outcomeOf(c: ConversationView): { tone: VerdictTone; word: string; text: string } | null {
   669	    if (c.phase === 'failed') return { tone: 'blocked', word: C.outcome.failed, text: c.failure ? HARNESS_FAILURE_TEXT[c.failure] : conversationText(c) }
   670	    if (c.cleanup === 'failed') return { tone: 'blocked', word: C.outcome.cleanup, text: HARNESS_FAILURE_TEXT.cleanupFailed }
   671	    if (c.phase === 'ended') return { tone: 'info', word: C.outcome.ended, text: conversationText(c) }
   672	    if (c.lastTurn && c.lastTurn !== 'completed' && c.phase === 'ready') {
   673	        return { tone: c.lastTurn === 'failed' ? 'blocked' : 'flagged', word: C.outcome.turn[c.lastTurn] ?? c.lastTurn, text: TURN_TEXT[c.lastTurn] }
   674	    }
   675	    return null
   676	}
   677	
   678	function Transcript({ entries }: { entries: HarnessEntry[] }) {
   679	    return (
   680	        <ol className='flex flex-col gap-3'>
   681	            {entries.map((e) => (
