    63	/// Whether `path` (canonical) may be a Harness project: an absolute
    64	/// directory, neither the root, the home folder itself, a credential or
    65	/// configuration folder in it, an operating-system folder, nor the app's
    66	/// own data.
    67	pub fn project_allowed(
    68	    path: &std::path::Path,
    69	    home: Option<&std::path::Path>,
    70	    data: Option<&std::path::Path>,
    71	) -> bool {
    72	    let Some(text) = path.to_str() else {
    73	        return false;
    74	    };
    75	    if !path.is_absolute() || text.len() > 4096 || path.parent().is_none() || !path.is_dir() {
    76	        return false;
    77	    }
    78	    if REFUSED_ROOTS.iter().any(|r| path.starts_with(r)) {
    79	        return false;
    80	    }
    81	    if let Some(home) = home
    82	        && (path == home || REFUSED_HOME.iter().any(|d| path.starts_with(home.join(d))))
    83	    {
    84	        return false;
    85	    }
    86	    if let Some(data) = data
    87	        && (path.starts_with(data) || data.starts_with(path))
    88	    {
    89	        return false;
    90	    }
    91	    true
    92	}
