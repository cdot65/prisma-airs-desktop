  1065	    tool(&desk, None, "exec_command", json!({"cmd": "ls"}));
  1066	    desk.say(&id, "List the files.").await.expect("sent");
  1067	    let c = answered_with(&mut desk, |c| {
  1068	        c["approvals"].as_array().is_some_and(|a| !a.is_empty())
  1069	    })
  1070	    .await;
  1071	    let token = c["approvals"][0]["id"].as_str().expect("id").to_owned();
  1072	    // Another tenant to switch to.
  1073	    let a = desk.json()["active"]["tenant"]
  1074	        .as_str()
  1075	        .expect("A")
  1076	        .to_owned();
  1077	    let origin = desk.json()["tenants"][0]["origin"]
  1078	        .as_str()
  1079	        .expect("origin")
  1080	        .to_owned();
  1081	    desk.send(
  1082	        json!({"kind": "createTenant", "profile": {"label": "Tenant B", "tsgId": "1234567890",
  1083	        "destination": {"kind": "custom", "origin": origin}}}),
  1084	    )
  1085	    .await
  1086	    .expect("B");
  1087	    let b = desk.json()["tenants"]
  1088	        .as_array()
  1089	        .expect("tenants")
  1090	        .iter()
  1091	        .find(|t| t["label"] == "Tenant B")
  1092	        .and_then(|t| t["id"].as_str())
  1093	        .expect("B id")
  1094	        .to_owned();
  1095	    // Without a resolution the switch is refused and the guard is published.
  1096	    assert_eq!(
  1097	        desk.send(json!({"kind": "selectTenant", "tenant": b}))
  1098	            .await,
  1099	        Err(desktop_core::Refusal::DecisionPending)
  1100	    );
  1101	    let s = desk.json();
  1102	    assert_eq!(s["active"]["tenant"], a, "still on A");
  1103	    assert_eq!(s["switchBlocked"]["to"], b);
  1104	    assert_eq!(s["switchBlocked"]["pending"]["conversation"], id);
  1105	    assert_eq!(s["switchBlocked"]["pending"]["decision"], token);
  1106	    assert!(
  1107	        s["harness"]["conversation"]["approvals"]
  1108	            .as_array()
  1109	            .is_some_and(|x| !x.is_empty()),
  1110	        "nothing was decided for the operator"
  1111	    );
