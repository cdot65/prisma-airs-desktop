    69	async function launch(snapshot: ShellSnapshot) {
    70	    const native = scriptedNative(snapshot)
    71	    // Each start is a new operation (op-77, op-78, …), as the core issues them.
    72	    let started = 76
    73	    native.respond = (intent: Intent) =>
    74	        intent.kind === 'startHarness'
    75	            ? { outcome: 'receipt', receipt: { kind: 'admitted', request: 'rq-9', operation: `op-${++started}` } }
    76	            : { outcome: 'receipt', receipt: { kind: 'admitted', request: 'rq-1', operation: null } }
    77	    const user = userEvent.setup()
    78	    const view = render(<App client={new DesktopClient(native.transport)} />)
    79	    await screen.findByRole('heading', { level: 1, name: 'Harness' })
    80	    return { native, user, view }
    81	}
