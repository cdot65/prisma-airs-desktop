  1056	/// C30 (I1): the one tenant-switch path refuses while the operator has a
  1057	/// Harness decision pending; the refusal carries the guard, and the
  1058	/// operator's resolution ends the conversation (kept or dropped) and switches.
  1059	#[tokio::test(flavor = "multi_thread")]
