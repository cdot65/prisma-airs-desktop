   499	/// An operation a tool call admitted. Dropped before it settles (the turn
   500	/// was interrupted or ended, or the call timed out), it is cancelled: work
   501	/// still queued settles NotSent and sends nothing; work already dispatched
   502	/// is signalled and keeps its own, honest outcome (C21 review R2-F1). Once
   503	/// settled, cancelling changes nothing.
   504	struct Admitted<'a> {
   505	    inner: &'a Arc<Inner>,
   506	    operation: OperationId,
   507	}
   508	
   509	impl Drop for Admitted<'_> {
   510	    fn drop(&mut self) {
   511	        let starts = lock(self.inner)
   512	            .map(|mut state| {
   513	                let (_, starts) = state.operations.cancel(
   514	                    &self.operation,
   515	                    crate::runtime::StopReason::Cancelled,
   516	                    tokio::time::Instant::now(),
   517	                );
   518	                state.changed();
   519	                starts
   520	            })
   521	            .unwrap_or_default();
   522	        super::run_effects(self.inner, vec![Effect::Start(starts)]);
   523	    }
   524	}
   525	
   526	/// One tool call, admitted under the conversation's current binding and
   527	/// only while its turn lasts: `cancel` is checked under the lock right
   528	/// before anything is admitted, and while it waits (C21 review F1). What
   529	/// was already sent is not undone.
   530	async fn run(
   531	    inner: &Arc<Inner>,
   532	    conversation: &OperationId,
   533	    call: ToolCall,
   534	    cancel: &CancellationToken,
   535	) -> Result<String, Refusal> {
   536	    let current = |state: &mut State| -> Result<(), Refusal> {
   537	        if cancel.is_cancelled() {
   538	            return Err(Refusal::StaleContext);
   539	        }
   540	        state.harness_live(conversation).map(|_| ())
   541	    };
   542	    let context = {
   543	        let mut state = lock(inner)?;
   544	        current(&mut state)?;
   545	        state.harness_live(conversation)?.context_ref().clone()
   546	    };
   547	    let management = |request: ManagementRequest| async {
   548	        let (_admitted, handle, starts) = {
   549	            let mut state = lock(inner)?;
   550	            current(&mut state)?;
   551	            let (operation, mut starts) = state.admit_management(
   552	                context.clone(),
   553	                request,
   554	                Arc::clone(&inner.adapters.keychain),
   555	                Arc::clone(&inner.session),
   556	            )?;
   557	            starts.extend(state.take_gateway_starts());
   558	            let handle = state.observe_management(&operation)?;
   559	            state.changed();
   560	            (Admitted { inner, operation }, handle, starts)
   561	        };
