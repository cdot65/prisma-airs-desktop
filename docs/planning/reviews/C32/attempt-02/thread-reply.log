   456	/// The sink that runs a conversation's typed tool calls.
   457	pub(super) fn sink(
   458	    inner: &Arc<Inner>,
   459	    conversation: OperationId,
   460	    commands: mpsc::Sender<Command>,
   461	) -> ToolSink {
   462	    let inner = Arc::clone(inner);
   463	    Arc::new(move |request: ToolRequest| {
   464	        let inner = Arc::clone(&inner);
   465	        let conversation = conversation.clone();
   466	        let commands = commands.clone();
   467	        tokio::spawn(async move {
   468	            let ToolRequest {
   469	                request,
   470	                call,
   471	                lease,
   472	                cancel,
   473	            } = request;
   474	            // Interrupted, ended or stopped: whatever was not admitted is
   475	            // not, and no result is sent (the engine forgot the call).
   476	            let ran = tokio::select! {
   477	                () = cancel.cancelled() => return,
   478	                ran = tokio::time::timeout(TOOL_TIMEOUT, run(&inner, &conversation, call, &cancel)) => ran,
   479	            };
   480	            if cancel.is_cancelled() {
   481	                return;
   482	            }
   483	            let (success, text) = match ran {
   484	                Ok(Ok(text)) => (true, text),
   485	                _ => (false, UNAVAILABLE.to_owned()),
   486	            };
   487	            let _ = commands
   488	                .send(Command::ToolResult {
   489	                    request,
   490	                    lease,
   491	                    success,
   492	                    text,
   493	                })
   494	                .await;
   495	        });
   496	    })
   497	}
