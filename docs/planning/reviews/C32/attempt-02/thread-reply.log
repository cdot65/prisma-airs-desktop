   166	
   167	    /// Chooses a workspace the active context listed; remembered for the
   168	    /// tenant (a failed save refuses and leaves the previous choice).
   169	    pub(super) fn select_gateway_workspace(
   170	        &mut self,
   171	        context: &ContextRef,
   172	        workspace: &str,
   173	    ) -> Result<Vec<crate::runtime::Start>, Refusal> {
   174	        let tenant = self.check_context(context)?;
   175	        if self.is_setup_context(context) {
   176	            return self.select_setup_workspace(context, &tenant, workspace);
   177	        }
   178	        if self
   179	            .gateway
   180	            .selection
   181	            .as_ref()
   182	            .is_some_and(|s| &s.context == context && s.workspace.id == workspace)
   183	        {
   184	            return Ok(Vec::new());
   185	        }
   186	        let listed = self
   187	            .gateway
   188	            .listing
   189	            .as_ref()
   190	            .filter(|l| &l.context == context)
   191	            .and_then(|l| l.workspaces.iter().find(|w| w.id == workspace))
   192	            .cloned()
   193	            .ok_or(Refusal::InvalidInput)?;
   194	        let remembered = self
   195	            .tenant(&tenant)
   196	            .and_then(|t| t.gateway_workspace.clone());
   197	        if remembered.as_deref() != Some(workspace) {
   198	            let before = self.data.clone();
   199	            // A setup draft (C29) remembers it too and carries it into the tenant.
   200	            if let Some(t) = self.tenant_mut(&tenant) {
   201	                t.gateway_workspace = Some(workspace.to_owned());
   202	            }
   203	            if self.storage == StorageHealth::Ready {
   204	                self.save_with(&before)?;
   205	            }
   206	        }
   207	        Ok(self.choose(context.clone(), listed, false))
   208	    }
   258	    /// A Workspaces listing settled for `context` (still current): it
   259	    /// replaces the last one. A choice it no longer lists (completely) is
   260	    /// cleared; the tenant's remembered workspace is restored when listed.
   261	    pub(super) fn gateway_listed(&mut self, context: &ContextRef, list: &GatewayList) {
   262	        let workspaces = crate::gateway::listed_workspaces(list);
   263	        if self.is_setup_context(context) {
   264	            // The draft's listing: its own choice is reconciled, or restored
   265	            // from the draft's remembered workspace (a credential change
   266	            // retired the earlier choice with its context); the active
   267	            // tenant's listing and choice are untouched.
   268	            let reference = self.issue_workspace();
   269	            if let Some(setup) = self.data.setup.as_mut() {
   270	                match setup.gateway.selection.as_mut() {
   271	                    Some(selection) => {
   272	                        match workspaces.iter().find(|w| w.id == selection.workspace.id) {
   273	                            Some(listed) => selection.workspace = listed.clone(),
   274	                            None if list.complete => setup.gateway.selection = None,
   275	                            None => {}
   276	                        }
   277	                    }
   278	                    None => {
   279	                        if let Some(listed) = setup
   280	                            .tenant
   281	                            .gateway_workspace
   282	                            .as_deref()
   283	                            .and_then(|id| workspaces.iter().find(|w| w.id == id))
   284	                        {
   285	                            setup.gateway.selection = Some(Selection {
   286	                                reference,
   287	                                context: context.clone(),
   288	                                workspace: listed.clone(),
   289	                                restored: true,
   290	                            });
   291	                        }
   292	                    }
   293	                }
   294	                setup.gateway.workspaces = Some(workspaces);
   295	            }
   296	            return;
   297	        }
   298	        let mut starts = Vec::new();
   299	        if let Some(selection) = self.gateway.selection.as_mut() {
   300	            match workspaces.iter().find(|w| w.id == selection.workspace.id) {
   301	                Some(listed) => selection.workspace = listed.clone(),
   302	                None if list.complete => {
   303	                    self.gateway.selection = None;
   304	                    starts = self.retire_workspace_reads(None);
   305	                }
   306	                None => {}
   307	            }
   308	        }
   309	        if self.gateway.selection.is_none() {
   310	            let remembered = self
   311	                .data
   312	                .active
   313	                .as_ref()
   314	                .and_then(|id| self.tenant(id))
   315	                .and_then(|t| t.gateway_workspace.clone());
   316	            if let Some(listed) =
   317	                remembered.and_then(|id| workspaces.iter().find(|w| w.id == id).cloned())
   318	            {
   319	                starts.extend(self.choose(context.clone(), listed, true));
   320	            }
   321	        }
   322	        self.gateway.listing = Some(Listing {
   323	            context: context.clone(),
   324	            workspaces,
   325	            complete: list.complete,
   326	        });
   327	        self.gateway.pending.extend(starts);
   328	    }
