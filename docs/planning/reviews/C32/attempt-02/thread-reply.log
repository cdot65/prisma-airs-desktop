  1113	    desk.send(json!({"kind": "dismissSwitchGuard"}))
  1114	        .await
  1115	        .expect("dismissed");
  1116	    assert!(desk.json()["switchBlocked"].is_null());
  1117	    assert_eq!(desk.json()["active"]["tenant"], a);
  1118	    // Archive and switch: the conversation is ended (kept) and B is active.
  1119	    desk.send(json!({"kind": "selectTenant", "tenant": b, "resolution": "archive"}))
  1120	        .await
  1121	        .expect("switched");
  1122	    let s = desk.json();
  1123	    assert_eq!(s["active"]["tenant"], b);
  1124	    assert!(s["switchBlocked"].is_null());
  1125	    assert!(
  1126	        s["harness"]["conversation"].is_null(),
  1127	        "another tenant's conversation is never shown"
  1128	    );
  1129	    // A plain switch with nothing pending needs no resolution.
  1130	    desk.send(json!({"kind": "selectTenant", "tenant": a}))
  1131	        .await
  1132	        .expect("back to A");
  1133	    assert!(
  1134	        settle_for(30, || {
  1135	            let c = desk.conversation();
  1136	            c.is_null() || c["phase"] == "ended" || c["phase"] == "ending"
  1137	        })
  1138	        .await
  1139	    );
  1140	}
