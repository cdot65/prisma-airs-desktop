   160	    /// The tenant context changed: its listing and choice go with it.
   161	    pub(super) fn retire_gateway(&mut self) -> Vec<crate::runtime::Start> {
   162	        self.gateway.listing = None;
   163	        self.gateway.selection = None;
   164	        self.retire_workspace_reads(None)
