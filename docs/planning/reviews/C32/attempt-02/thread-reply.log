    fn changed(&mut self) {
        // Every published snapshot reflects settled scans' outcomes.
        self.sync_scans();
        self.sync_academy_calls();
        self.sync_management_calls();
        self.sync_changes();
        self.sync_inference();
        self.sync_files();
        self.sync_harness();
        self.revision += 1;
        let update = Update::Shell(Box::new(self.snapshot()));
        self.subscribers.publish(&update);
    }

    }

    fn choose(
        &mut self,
        context: ContextRef,
        workspace: ListedWorkspace,
        restored: bool,
    ) -> Vec<crate::runtime::Start> {
        let reference = self.issue_workspace();
        let starts = self.retire_workspace_reads(Some(&reference));
