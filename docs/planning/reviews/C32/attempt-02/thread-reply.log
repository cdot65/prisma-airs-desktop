   146	    /// Retires every Gateway workspace read but `keep`'s, and every
   147	    /// change applying under another reference that has not sent its write.
   148	    fn retire_workspace_reads(
   149	        &mut self,
   150	        keep: Option<&WorkspaceRef>,
   151	    ) -> Vec<crate::runtime::Start> {
   152	        self.retire_scoped_applies(keep);
   153	        self.operations.retire_contexts(
