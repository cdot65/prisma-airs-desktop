import { create } from 'zustand'

export type ToastKind = 'ok' | 'info' | 'warn'
import type { FeatureId, Intent, ManagementResource } from '@prisma-airs/desktop-contracts'

/** What a contextual action asked the destination to select on arrival (C30), owned by the tenant it was followed in (I2). */
export interface Arrival {
    tenant: string
    feature: FeatureId
    resource: ManagementResource | null
    /** The item to filter to, by name. */
    item: string | null
    /** Counts arrivals: a destination already open applies a new one. */
    sequence: number
}

/** A Harness message kept for the operator: refused or never sent, or not confirmed (C32). */
export interface HarnessKept {
    /** This record's own id: each attempt is its own record (C32). */
    id: number
    text: string
    unconfirmed: boolean
    /**
     * For an unconfirmed send: the conversation it was sent to and the IDs of
     * the operator messages it showed then. Entry IDs outlive the transcript's
     * eviction of its oldest entries, where a count would not (C32).
     */
    conversation?: string
    before?: string[]
}

/** An admitted Harness send awaiting its transcript entry (C32). */
export interface HarnessClaim {
    id: number
    conversation: string
    text: string
    /** The operator entry IDs the conversation showed when it was sent. */
    before: string[]
    /** Its send is still in flight: the entry is only held back, never used up, until the send is admitted (C32). */
    pending: boolean
}

/** A delivery the desktop did not confirm: kept until the operator retries or dismisses it (DESIGN-V2 §7). */
export interface Unconfirmed {
    id: number
    what: string
    intent: Intent
    /** The context the intent was bound to, if any: once that context retires, the delivery cannot be revived. */
    context: string | null
}

export interface Toast {
    id: number
    kind: ToastKind
    text: string
    /** An optional undo the toast offers (label + action). */
    undo?: { label: string; run: () => void }
    /** The tenant the toast speaks for (an item, a read): retired on leaving it (I2). */
    tenant: string | null
    /** The context it was raised under, when the action was context-bound: retired with it. */
    context: string | null
}

/**
 * Transient shell presentation state (state-ownership.md "UI"): what is open,
 * the palette query, toasts and the modal stack. Nothing here survives a
 * reload and nothing here is authority: every durable fact is observed from
 * the Rust snapshot.
 */
interface ShellStore {
    /** The scope the shell shows now (set from each snapshot before it renders): what a notification must belong to. */
    scope: { tenant: string | null; context: string | null }
    setScope(tenant: string | null, context: string | null): void
    paletteOpen: boolean
    switcherOpen: boolean
    toasts: Toast[]
    /** Open modal ids, bottom to top; only the last is interactive (I8). */
    modals: string[]
    /** The Inbox tab and item per tenant (I2: a switch round trip keeps it). */
    inboxSelection: Record<string, { tab: 'all' | 'action' | 'updates' | 'snoozed'; item: string | null }>
    selectInbox(tenant: string, selection: { tab: 'all' | 'action' | 'updates' | 'snoozed'; item: string | null }): void
    /** Harness drafts, by `tenant|workspace|conversation` (C32): kept across navigation and tenant round trips, never shared between scopes, never sent by themselves. */
    harnessDrafts: Record<string, string>
    setHarnessDraft(scope: string, text: string): void
    /** Per `tenant|workspace`: the operator chose a new investigation while one runs (C32). */
    harnessFresh: Record<string, boolean>
    setHarnessFresh(scope: string, fresh: boolean): void
    /**
     * Per `tenant|workspace`: messages kept for the operator (C32). `unconfirmed`
     * ones may have been delivered (the desktop did not confirm it); the others
     * were refused or never sent. Never sent by themselves.
     */
    harnessUnsent: Record<string, HarnessKept[]>
    keepHarnessUnsent(scope: string, kept: Omit<HarnessKept, 'id'>): void
    dropHarnessUnsent(scope: string, id: number): void
    /** Per `tenant|workspace`: transcript entries (`conversation|entry`) already used to settle a record; each settles one, once (C32). */
    harnessSettled: Record<string, string[]>
    /** Settles record `id` by transcript entry `entry`, atomically: the record goes and the entry is used up. */
    settleHarnessUnsent(scope: string, id: number, entry: string): void
    /**
     * Per `tenant|workspace`: admitted sends whose transcript entry is still to
     * come, kept only while an unconfirmed send of the same text awaits that
     * conversation: each claims its own entry before any uncertainty may (C32).
     */
    harnessClaims: Record<string, HarnessClaim[]>
    /** Records a claim and returns its id. */
    claimHarnessEntry(scope: string, claim: Omit<HarnessClaim, 'id'>): number
    /** Withdraws a claim whose send was not taken, or not confirmed. */
    dropHarnessClaim(scope: string, id: number): void
    /** The claim's send was admitted: its entry may now be used up. */
    confirmHarnessClaim(scope: string, id: number): void
    /** The claim `id` took transcript entry `entry`: both are used up. */
    consumeHarnessClaim(scope: string, id: number, entry: string): void
    /** The last contextual action's target, consumed by the destination it names. */
    arrival: Arrival | null
    arrive(target: Omit<Arrival, 'sequence'>): void
    /** Forgets an arrival that belongs to another tenant than `tenant`. */
    scopeArrival(tenant: string | null): void
    /** Drops unconfirmed deliveries bound to a context other than `context` (their authority retired). */
    retireUnconfirmed(context: string | null): void
    unconfirmed: Unconfirmed[]
    /** Toast lifetime in ms (6 s; tests shorten it). */
    toastMs: number
    addUnconfirmed(what: string, intent: Intent): number
    clearUnconfirmed(id: number): void
    openPalette(): void
    closePalette(): void
    setSwitcher(open: boolean): void
    toast(text: string, kind?: ToastKind, undo?: Toast['undo'], tenant?: string | null, context?: string | null): number
    /** Retires toasts that speak for another tenant than `tenant`. */
    retireToasts(tenant: string | null): void
    dismissToast(id: number): void
    pushModal(id: string): void
    popModal(id: string): void
}

let nextToast = 1
let nextKept = 1

export const useShellStore = create<ShellStore>((set, get) => ({
    scope: { tenant: null, context: null },
    setScope: (tenant, context) =>
        set((s) => ({
            scope: { tenant, context },
            // Leaving a scope retires what spoke for it, however late it would have arrived.
            toasts: s.toasts.filter((t) => (t.tenant === null || t.tenant === tenant) && (t.context === null || t.context === context)),
            unconfirmed: s.unconfirmed.filter((u) => u.context === null || u.context === context),
            arrival: s.arrival && s.arrival.tenant !== tenant ? null : s.arrival,
        })),
    paletteOpen: false,
    switcherOpen: false,
    toasts: [],
    modals: [],
    inboxSelection: {},
    selectInbox: (tenant, selection) => set((s) => ({ inboxSelection: { ...s.inboxSelection, [tenant]: selection } })),
    harnessDrafts: {},
    setHarnessDraft: (scope, text) => set((s) => ({ harnessDrafts: { ...s.harnessDrafts, [scope]: text } })),
    harnessFresh: {},
    setHarnessFresh: (scope, fresh) => set((s) => ({ harnessFresh: { ...s.harnessFresh, [scope]: fresh } })),
    harnessUnsent: {},
    keepHarnessUnsent: (scope, item) =>
        set((s) => {
            const kept = s.harnessUnsent[scope] ?? []
            const record = { ...item, id: nextKept++ }
            // An uncertain attempt is never removed or downgraded by a later one:
            // only its own conversation's transcript, or the operator, settles it.
            // A not-sent record of the same text is superseded by a later attempt;
            // not-sent records are kept once per text.
            const others = kept.filter((k) => k.unconfirmed || k.text !== item.text)
            return { harnessUnsent: { ...s.harnessUnsent, [scope]: [...others, record] } }
        }),
    dropHarnessUnsent: (scope, id) => set((s) => ({ harnessUnsent: { ...s.harnessUnsent, [scope]: (s.harnessUnsent[scope] ?? []).filter((k) => k.id !== id) } })),
    harnessClaims: {},
    claimHarnessEntry: (scope, claim) => {
        const id = nextKept++
        set((s) => ({ harnessClaims: { ...s.harnessClaims, [scope]: [...(s.harnessClaims[scope] ?? []), { ...claim, id }] } }))
        return id
    },
    dropHarnessClaim: (scope, id) => set((s) => ({ harnessClaims: { ...s.harnessClaims, [scope]: (s.harnessClaims[scope] ?? []).filter((c) => c.id !== id) } })),
    confirmHarnessClaim: (scope, id) =>
        set((s) => ({ harnessClaims: { ...s.harnessClaims, [scope]: (s.harnessClaims[scope] ?? []).map((c) => (c.id === id ? { ...c, pending: false } : c)) } })),
    consumeHarnessClaim: (scope, id, entry) =>
        set((s) => {
            const used = s.harnessSettled[scope] ?? []
            if (used.includes(entry)) return {}
            return {
                harnessClaims: { ...s.harnessClaims, [scope]: (s.harnessClaims[scope] ?? []).filter((c) => c.id !== id) },
                harnessSettled: { ...s.harnessSettled, [scope]: [...used, entry] },
            }
        }),
    harnessSettled: {},
    settleHarnessUnsent: (scope, id, entry) =>
        set((s) => {
            const used = s.harnessSettled[scope] ?? []
            if (used.includes(entry) || !(s.harnessUnsent[scope] ?? []).some((k) => k.id === id)) return {}
            return {
                harnessUnsent: { ...s.harnessUnsent, [scope]: (s.harnessUnsent[scope] ?? []).filter((k) => k.id !== id) },
                harnessSettled: { ...s.harnessSettled, [scope]: [...used, entry] },
            }
        }),
    arrival: null,
    arrive: (target) => set((s) => ({ arrival: { ...target, sequence: (s.arrival?.sequence ?? 0) + 1 } })),
    unconfirmed: [],
    toastMs: 6000,
    addUnconfirmed: (what, intent) => {
        const id = nextToast++
        const context = typeof (intent as { context?: unknown }).context === 'string' ? ((intent as { context: string }).context ?? null) : null
        // A delivery bound to a context the shell no longer shows is moot: never surfaced (I2).
        if (context !== null && context !== get().scope.context) return id
        set((s) => ({ unconfirmed: [...s.unconfirmed, { id, what, intent, context }] }))
        return id
    },
    scopeArrival: (tenant) => set((s) => (s.arrival && s.arrival.tenant !== tenant ? { arrival: null } : {})),
    retireUnconfirmed: (context) => set((s) => ({ unconfirmed: s.unconfirmed.filter((u) => u.context === null || u.context === context) })),
    clearUnconfirmed: (id) => set((s) => ({ unconfirmed: s.unconfirmed.filter((u) => u.id !== id) })),
    openPalette: () => set({ paletteOpen: true, switcherOpen: false }),
    closePalette: () => set({ paletteOpen: false }),
    setSwitcher: (open) => set({ switcherOpen: open, ...(open ? { paletteOpen: false } : {}) }),
    toast: (text, kind = 'ok', undo, tenant = null, context = null) => {
        const id = nextToast++
        // A toast for a tenant or context the shell no longer shows is never surfaced (I2).
        if (tenant !== null && tenant !== get().scope.tenant) return id
        if (context !== null && context !== get().scope.context) return id
        // One toast at a time: the newest replaces the rest (I10).
        set({ toasts: [{ id, kind, text, undo, tenant, context }] })
        return id
    },
    retireToasts: (tenant) => set((s) => ({ toasts: s.toasts.filter((t) => t.tenant === null || t.tenant === tenant) })),
    dismissToast: (id) => set((s) => ({ toasts: s.toasts.filter((t) => t.id !== id) })),
    pushModal: (id) => set((s) => ({ modals: s.modals.includes(id) ? s.modals : [...s.modals, id] })),
    popModal: (id) => set((s) => ({ modals: s.modals.filter((m) => m !== id) })),
}))

/** Test seam: forget everything (each test starts from an empty store). */
export function resetShellStore() {
    useShellStore.setState({ scope: { tenant: null, context: null }, paletteOpen: false, switcherOpen: false, toasts: [], modals: [], unconfirmed: [], toastMs: 6000, inboxSelection: {}, arrival: null, harnessDrafts: {}, harnessFresh: {}, harnessUnsent: {}, harnessSettled: {}, harnessClaims: {} })
}
import { useEffect, useId, useRef, type KeyboardEvent, type ReactNode } from 'react'
import { useShellStore } from './store'

interface ModalProps {
    label: string
    onClose: () => void
    children: ReactNode
    /** Width in CSS px (default 560). */
    width?: number
    'data-slot'?: string
}

const FOCUSABLE = 'a[href], button:not([disabled]), input:not([disabled]), select:not([disabled]), textarea:not([disabled]), [tabindex]:not([tabindex="-1"])'

/**
 * One topmost modal (I8): dialogs register on a shell-wide stack; only the
 * last is interactive. Lower dialogs are inert and aria-hidden, Tab and
 * Shift-Tab stay inside the topmost dialog, Escape closes the topmost only,
 * focus moves into the dialog on open and back to the opener on close. The
 * page behind every dialog is made inert by the shell (`useModalsOpen`).
 * The dialog element handles its own keys; the topmost dialog also listens
 * on the window for Escape alone, for when focus has left it (a native
 * sheet returned focus elsewhere), and closes only itself.
 */
export function Modal({ label, onClose, children, width = 560, ...rest }: ModalProps) {
    const id = useId()
    const pushModal = useShellStore((s) => s.pushModal)
    const popModal = useShellStore((s) => s.popModal)
    const modals = useShellStore((s) => s.modals)
    const topmost = modals.length > 0 && modals[modals.length - 1] === id
    const dialog = useRef<HTMLDivElement>(null)
    const opener = useRef<HTMLElement | null>(null)
    const focusedOnce = useRef(false)

    useEffect(() => {
        opener.current = document.activeElement instanceof HTMLElement ? document.activeElement : null
        pushModal(id)
        return () => {
            popModal(id)
            // After the commit: the page behind is still inert during cleanup,
            // and an inert ancestor refuses focus (observed in WebKit).
            const target = opener.current
            queueMicrotask(() => {
                // Only when nothing else took focus meanwhile (⌘T replacing the
                // palette hands focus to the tenant list, which must keep it).
                const active = document.activeElement
                if (active && active !== document.body) return
                // The opener may be gone (a "Finish rotation…" that completed):
                // focus the page heading rather than leave it on nothing.
                if (target?.isConnected) target.focus()
                else document.querySelector<HTMLElement>('main h1[tabindex="-1"]')?.focus()
            })
        }
    }, [id, pushModal, popModal])

    useEffect(() => {
        // Initial focus goes into the dialog once, when it opens. Regaining the
        // top after a higher dialog closes must not refocus: that dialog is
        // restoring its own opener, which may be any control here.
        if (!topmost || focusedOnce.current) return
        const node = dialog.current
        if (!node) return
        focusedOnce.current = true
        if (!node.contains(document.activeElement)) {
            // A declared initial control first (wherever it sits), else the first focusable.
            const first = node.querySelector<HTMLElement>('[autofocus]') ?? node.querySelector<HTMLElement>(FOCUSABLE)
            ;(first ?? node).focus()
        }
    }, [topmost])

    // Escape still closes the topmost dialog when focus has left it (a
    // native sheet returning focus to the page body, a click on the scrim's
    // edge): the dialog's own handler stops the event first when it has focus.
    const closeRef = useRef(onClose)
    closeRef.current = onClose
    useEffect(() => {
        if (!topmost) return
        const onWindowKey = (event: globalThis.KeyboardEvent) => {
            if (event.key !== 'Escape' || event.defaultPrevented) return
            const node = dialog.current
            if (node && node.contains(document.activeElement)) return
            event.preventDefault()
            closeRef.current()
        }
        window.addEventListener('keydown', onWindowKey)
        return () => window.removeEventListener('keydown', onWindowKey)
    }, [topmost])

    const onKeyDown = (event: KeyboardEvent<HTMLDivElement>) => {
        if (!topmost) return
        if (event.key === 'Escape') {
            event.preventDefault()
            event.stopPropagation()
            onClose()
            return
        }
        if (event.key === 'Tab') {
            // Keyboard interaction stays inside the topmost dialog.
            const node = dialog.current
            if (!node) return
            const items = Array.from(node.querySelectorAll<HTMLElement>(FOCUSABLE)).filter((el) => !el.hasAttribute('hidden') && el.getAttribute('aria-hidden') !== 'true')
            if (items.length === 0) {
                event.preventDefault()
                node.focus()
                return
            }
            const first = items[0] as HTMLElement
            const last = items[items.length - 1] as HTMLElement
            const active = document.activeElement
            if (event.shiftKey && (active === first || active === node)) {
                event.preventDefault()
                last.focus()
            } else if (!event.shiftKey && active === last) {
                event.preventDefault()
                first.focus()
            }
        }
    }

    return (
        <div
            className='fixed inset-0 z-50 grid place-items-start justify-center pt-[4vh]'
            data-v2-scrim=''
            aria-hidden={topmost ? undefined : true}
            inert={topmost ? undefined : true}
            onMouseDown={() => topmost && onClose()}
        >
            <div
                ref={dialog}
                role='dialog'
                aria-modal={topmost ? 'true' : undefined}
                aria-label={label}
                tabIndex={-1}
                data-slot={rest['data-slot'] ?? 'modal'}
                data-topmost={topmost ? 'true' : 'false'}
                onKeyDown={onKeyDown}
                onMouseDown={(e) => e.stopPropagation()}
                className='rounded-[12px] border p-5 shadow-2xl'
                // Bounded to the viewport: a tall dialog scrolls inside itself, so its
                // actions stay reachable at the minimum window size and 200% zoom.
                style={{ width: `min(${width}px, 92vw)`, maxHeight: '92vh', overflowY: 'auto', background: 'var(--v2-paper)', borderColor: 'var(--v2-rule)', color: 'var(--v2-ink)' }}
            >
                {children}
            </div>
        </div>
    )
}

/** Whether any modal is open: the shell makes the page behind it inert. */
export function useModalsOpen(): boolean {
    return useShellStore((s) => s.modals.length > 0)
}

