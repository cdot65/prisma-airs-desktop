    /// Lists the chosen workspace's saved conversations.
    pub(super) fn list_harness_history(
        &mut self,
        context: &ContextRef,
        reference: Option<&WorkspaceRef>,
    ) -> Result<Effect, Refusal> {
        let lease = self.lease();
        let h = self.history_for(context, reference)?;
        let scope = h.scope.clone();
        let problem = self.discard_problem(&scope);
        let h = self.history_for(context, reference)?;
        // Shown as reading until this request's own answer; a discard whose
        // removal failed is reported on the workspace until the record goes.
        h.list_lease = lease;
        h.list = None;
        h.problem = h.problem.or(problem);
        Ok(Effect::HarnessHistory(HistoryJob::List {
            lease,
            scope: h.scope.clone(),
        }))
    }

    pub(super) fn open_harness_history(
        &mut self,
        context: &ContextRef,
        reference: Option<&WorkspaceRef>,
        id: &str,
    ) -> Result<Effect, Refusal> {
        if !protocol::is_uuid(id) {
            return Err(Refusal::InvalidInput);
        }
        let lease = self.lease();
        let h = self.history_for(context, reference)?;
        let (tenant, workspace) = (h.tenant.clone(), h.workspace.clone());
        // A conversation an unsettled import saved is not there yet (D050).
        if self.v1_hides_conversation(&tenant, &workspace, id) {
            return Err(Refusal::InvalidInput);
        }
        let h = self.history_for(context, reference)?;
        if h.busy {
            return Err(Refusal::Busy);
        }
        h.busy = true;
        h.lease = lease;
        Ok(Effect::HarnessHistory(HistoryJob::Open {
            lease,
            scope: h.scope.clone(),
            id: id.to_owned(),
        }))
    }

    pub(super) fn close_harness_history(
        &mut self,
        context: &ContextRef,
        reference: Option<&WorkspaceRef>,
    ) -> Result<(), Refusal> {
        self.history_for(context, reference)?.opened = None;
        Ok(())
    }

    /// Deletes a saved conversation (never the one running now).
    pub(super) fn delete_harness_history(
        &mut self,
        context: &ContextRef,
        reference: Option<&WorkspaceRef>,
        id: &str,
    ) -> Result<Effect, Refusal> {
        if !protocol::is_uuid(id) {
            return Err(Refusal::InvalidInput);
        }
        if self.harness_history_live() == Some(id) {
            return Err(Refusal::Busy);
        }
        let lease = self.lease();
        let h = self.history_for(context, reference)?;
        if h.busy {
            return Err(Refusal::Busy);
        }
        h.busy = true;
        h.lease = lease;
        Ok(Effect::HarnessHistory(HistoryJob::Delete {
            lease,
            scope: h.scope.clone(),
            id: id.to_owned(),
        }))
    }

    /// The opened conversation's transcript in `format`, for the native
    /// save sheet. The engine's replay is never exported.
    pub(super) fn export_harness_history(
        &mut self,
        context: &ContextRef,
        reference: Option<&WorkspaceRef>,
        id: &str,
        format: HistoryFormat,
    ) -> Result<(u64, String, Vec<u8>), Refusal> {
        let record = self
            .history_for(context, reference)?
            .opened
            .gateway
            .selection
            .as_ref()
            .filter(|s| current(&s.context))
            .map(|s| SelectedWorkspace {
                reference: s.reference.clone(),
                workspace: s.workspace.clone(),
                restored: s.restored,
            });
        let remembered = self
            .data
            .active
            .as_ref()
            .and_then(|id| self.tenant(id))
            .and_then(|t| t.gateway_workspace.clone())
            .filter(|id| selected.as_ref().is_none_or(|s| &s.workspace.id != id));
        let remembered_missing = remembered.as_ref().is_some_and(|id| {
            listing.is_some_and(|l| l.complete && !l.workspaces.iter().any(|w| &w.id == id))
        });
        GatewayView {
            workspaces: listing.map(|l| l.workspaces.clone()),
            complete: listing.is_some_and(|l| l.complete),
            selected,
            remembered,
            remembered_missing,
            local: self.gateway_local_view(),
            playground: self.playground_view(),
            files: self.files_view(),
        }
    }

    fn issue_workspace(&mut self) -> WorkspaceRef {
        self.gateway.epoch += 1;
        WorkspaceRef::issue(&self.salt, self.gateway.epoch)
    }

    /// Retires every Gateway workspace read but `keep`'s, and every
    /// change applying under another reference that has not sent its write.
    fn retire_workspace_reads(
        &mut self,
        keep: Option<&WorkspaceRef>,
    ) -> Vec<crate::runtime::Start> {
        self.retire_scoped_applies(keep);
        self.operations.retire_contexts(
            WorkspaceRef::PREFIX,
            keep.map(WorkspaceRef::as_str),
            // The sealed Harness engine as a bundle resource (C19, D046).
            "--config",
            "src-tauri/tauri.harness.conf.json",
        ],
    ]
    .iter()
    .map(|argv| argv.iter().map(|s| (*s).to_owned()).collect())
    .collect();
    for argv in &commands {
        let status = env
            .command(argv, repo.root())?
            .status()
            .map_err(io_err(repo.root()))?;
        if !status.success() {
            return Err(invalid(format!("{} failed with {status}", argv.join(" "))));
        }
    }
    let app = bundle_path(repo, target, PRODUCT);
    let identifier = plist_value(&app, "CFBundleIdentifier")?;
    if identifier != crate::native::PRODUCTION_IDENTIFIER {
        return Err(invalid(format!(
            "the production bundle has identifier {identifier}"
        )));
    }
    let version = plist_value(&app, "CFBundleShortVersionString")?;
    let dmg = repo.join(format!(
        "target/{target}/release/bundle/dmg/{PRODUCT}_{version}_aarch64.dmg"
    ));
    Ok(ProductionBuild {
        app,
        dmg,
        identifier,
        commands,
    })
}

