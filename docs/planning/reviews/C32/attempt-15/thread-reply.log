export function withTenant(snapshot: ShellSnapshot, view: TenantView, context = 'cx-aaaaaaaaaaaaaaaaaaaaaaaa'): ShellSnapshot {
    return { ...snapshot, tenants: [view], active: { tenant: view.id, context } }
