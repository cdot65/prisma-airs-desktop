                                <p className='text-[13px] font-semibold'>{APPROVAL_TITLE[a.kind]}</p>
                                {a.kind === 'mcpTool' ? (
                                    <p className='font-mono text-[12px] break-all'>{`${a.server} · ${a.tool}`}</p>
