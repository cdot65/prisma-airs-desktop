    fn interrupt(&mut self) -> Result<(), HarnessFailure> {
        if let (Some(thread), Some((_, Some(turn)))) = (self.thread.clone(), self.turn.clone())
            && !self
                .pending
                .iter()
                .any(|(_, m)| *m == Method::TurnInterrupt)
        {
            self.request(
