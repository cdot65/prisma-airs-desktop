   812	/**
   813	 * How the conversation stands, in words the C19–C22 Harness used (R5): a
   814	 * failure names itself; a stopped, cut, failed or refused answer is never
   815	 * shown as complete; an engine that could not be removed says so.
   816	 */
   817	function outcomeOf(c: ConversationView): { tone: VerdictTone; word: string; text: string } | null {
   818	    if (c.phase === 'failed') return { tone: 'blocked', word: C.outcome.failed, text: c.failure ? HARNESS_FAILURE_TEXT[c.failure] : conversationText(c) }
   819	    if (c.cleanup === 'failed') return { tone: 'blocked', word: C.outcome.cleanup, text: HARNESS_FAILURE_TEXT.cleanupFailed }
   820	    if (c.phase === 'ended') return { tone: 'info', word: C.outcome.ended, text: conversationText(c) }
   821	    if (c.lastTurn && c.lastTurn !== 'completed' && c.phase === 'ready') {
   822	        return { tone: c.lastTurn === 'failed' ? 'blocked' : 'flagged', word: C.outcome.turn[c.lastTurn] ?? c.lastTurn, text: TURN_TEXT[c.lastTurn] }
   823	    }
   824	    return null
   825	}
