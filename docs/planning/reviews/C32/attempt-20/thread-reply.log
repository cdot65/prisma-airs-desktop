            });
        }
        self.harness_history
            .as_mut()
            .ok_or(Refusal::CapabilityMissing)
    }

    /// Lists the chosen workspace's saved conversations.
    pub(super) fn list_harness_history(
        &mut self,
        context: &ContextRef,
        reference: Option<&WorkspaceRef>,
    ) -> Result<Effect, Refusal> {
        let lease = self.lease();
        let h = self.history_for(context, reference)?;
        let scope = h.scope.clone();
        let problem = self.discard_problem(&scope);
        let h = self.history_for(context, reference)?;
        // Shown as reading until this request's own answer; a discard whose
        // removal failed is reported on the workspace until the record goes.
        h.list_lease = lease;
        h.list = None;
        h.problem = h.problem.or(problem);
        Ok(Effect::HarnessHistory(HistoryJob::List {
            lease,
            scope: h.scope.clone(),
        }))
    }

    pub(super) fn open_harness_history(
        &mut self,
        context: &ContextRef,
        reference: Option<&WorkspaceRef>,
        id: &str,
    ) -> Result<Effect, Refusal> {
        if !protocol::is_uuid(id) {
            return Err(Refusal::InvalidInput);
        }
        let lease = self.lease();
        let h = self.history_for(context, reference)?;
        let (tenant, workspace) = (h.tenant.clone(), h.workspace.clone());
        // A conversation an unsettled import saved is not there yet (D050).
        if self.v1_hides_conversation(&tenant, &workspace, id) {
            return Err(Refusal::InvalidInput);
        }
        let h = self.history_for(context, reference)?;
        if h.busy {
            return Err(Refusal::Busy);
        }
        h.busy = true;
        h.lease = lease;
        Ok(Effect::HarnessHistory(HistoryJob::Open {
            lease,
            scope: h.scope.clone(),
            id: id.to_owned(),
        }))
    }

    pub(super) fn close_harness_history(
        &mut self,
        context: &ContextRef,
        reference: Option<&WorkspaceRef>,
    ) -> Result<(), Refusal> {
        self.history_for(context, reference)?.opened = None;
        Ok(())
    }

    /// Deletes a saved conversation (never the one running now).
    pub(super) fn delete_harness_history(
        &mut self,
        context: &ContextRef,
        reference: Option<&WorkspaceRef>,
        id: &str,
    ) -> Result<Effect, Refusal> {
        if !protocol::is_uuid(id) {
            return Err(Refusal::InvalidInput);
        }
        if self.harness_history_live() == Some(id) {
            return Err(Refusal::Busy);
        }
        let lease = self.lease();
        let h = self.history_for(context, reference)?;
        if h.busy {
            return Err(Refusal::Busy);
        }
        h.busy = true;
        h.lease = lease;
        Ok(Effect::HarnessHistory(HistoryJob::Delete {
            lease,
            scope: h.scope.clone(),
            id: id.to_owned(),
        }))
    }

    /// The opened conversation's transcript in `format`, for the native
    /// save sheet. The engine's replay is never exported.
    pub(super) fn export_harness_history(
        &mut self,
        context: &ContextRef,
        reference: Option<&WorkspaceRef>,
        id: &str,
# Provenance and intentional deviations

Every fixture file and screen contract cites the frozen prototype file and the
prototype state names it derives from. This file lists where the
implementation deliberately differs from the prototype and why. Anything not
listed here is expected to match the prototype's behaviour and spacing.

Frozen reference: canvas https://claude.ai/artifact/2SEXT1XMHdZkxHvdw8oaYL,
page "Refined Native v2", version 134 (version id 1793059808-4929, published
2026-10-26). Files and hashes: [prototype/MANIFEST.sha256](prototype/MANIFEST.sha256).

