//! Input fingerprints bound into review packets and receipts.
//!
//! * source: every tracked or untracked-but-not-ignored file (path, mode,
//!   content or symlink target) plus the repository `.git/config`, minus a
//!   narrow set of mutable evidence locations that are hashed separately.
//! * dependencies: lockfiles, toolchain pin, the consumed immutable inputs
//!   under `.inputs/`, and the resolved build-tool identities.
//! * build_flags: the subject's manifest entries, Tauri configuration and
//!   capability files, target and fixture-feature policy.
//! * evidence: the subject's committed evidence directory.

use std::collections::BTreeMap;
use std::os::unix::fs::PermissionsExt;
use std::path::Path;
use std::process::Command;

use serde::{Deserialize, Serialize};

use crate::manifest::Manifest;
use crate::{Repo, Result, Subject, invalid, io_err, sha256_hex};

/// Mutable locations excluded from the source fingerprint. Each is hashed
/// independently (evidence fingerprint, receipts) so exclusion cannot hide
/// application sources, lockfiles, tests or configuration.
pub const SOURCE_EXCLUSIONS: [&str; 3] = [
    "docs/planning/status.md",
    "docs/planning/reviews/",
    "docs/planning/evidence/",
];

#[derive(Clone, Debug, PartialEq, Eq, Serialize, Deserialize)]
#[serde(deny_unknown_fields)]
pub struct Fingerprints {
    pub source: String,
    pub dependencies: String,
    pub build_flags: String,
    pub evidence: String,
}

/// One entry of the source inventory.
#[derive(Clone, Debug, PartialEq, Eq, Serialize, Deserialize)]
pub struct FileEntry {
    pub path: String,
    pub mode: String,
    pub sha256: String,
}

pub fn is_excluded(path: &str) -> bool {
    SOURCE_EXCLUSIONS.iter().any(|excluded| {
        if excluded.ends_with('/') {
            path.starts_with(excluded)
        } else {
            path == *excluded
        }
    })
}

/// Lists source files via git: tracked plus untracked files not ignored.
pub fn source_inventory(repo: &Repo) -> Result<Vec<FileEntry>> {
    let output = Command::new("/usr/bin/git")
        .args([
            "ls-files",
            "-z",
            "--cached",
            "--others",
            "--exclude-standard",
        ])
        .current_dir(repo.root())
        .env_clear()
        .env("PATH", "/usr/bin:/bin")
        .env("HOME", std::env::var("HOME").unwrap_or_default())
        .output()
        .map_err(io_err(repo.root()))?;
    if !output.status.success() {
        return Err(invalid("git ls-files failed"));
    }
    let mut paths: Vec<String> = output
        .stdout
        .split(|b| *b == 0)
        .filter(|p| !p.is_empty())
        .map(|p| String::from_utf8_lossy(p).into_owned())
        .filter(|p| !is_excluded(p))
        .collect();
    paths.sort();
    paths.dedup();
    let mut entries = Vec::with_capacity(paths.len() + 1);
    for path in paths {
        entries.push(file_entry(repo.root(), &path)?);
    }
    entries.push(file_entry(repo.root(), ".git/config")?);
    Ok(entries)
}

fn file_entry(root: &Path, relative: &str) -> Result<FileEntry> {
    let full = root.join(relative);
    let Ok(meta) = std::fs::symlink_metadata(&full) else {
        return Ok(FileEntry {
            path: relative.to_owned(),
            mode: "deleted".to_owned(),
            sha256: String::new(),
        });
    };
    if meta.file_type().is_symlink() {
        let target = std::fs::read_link(&full).map_err(io_err(&full))?;
        return Ok(FileEntry {
            path: relative.to_owned(),
            mode: "symlink".to_owned(),
            sha256: sha256_hex(target.as_os_str().as_encoded_bytes()),
        });
    }
    let bytes = std::fs::read(&full).map_err(io_err(&full))?;
    let executable = meta.permissions().mode() & 0o111 != 0;
    Ok(FileEntry {
        path: relative.to_owned(),
        mode: if executable { "100755" } else { "100644" }.to_owned(),
        sha256: sha256_hex(&bytes),
    })
}

pub fn inventory_hash(entries: &[FileEntry]) -> String {
    let text: String = entries
        .iter()
        .map(|e| format!("{}\0{}\0{}\n", e.path, e.mode, e.sha256))
        .collect();
    sha256_hex(text.as_bytes())
}

pub fn source(repo: &Repo) -> Result<String> {
    Ok(inventory_hash(&source_inventory(repo)?))
}

/// Hash of every regular file under a directory (relative paths, sorted).
pub fn tree_hash(dir: &Path) -> Result<String> {
    tree_hash_excluding(dir, &[])
}

/// Like [`tree_hash`], skipping directories with the given names.
pub fn tree_hash_excluding(dir: &Path, skip: &[&str]) -> Result<String> {
    let mut entries = Vec::new();
    collect_tree(dir, dir, skip, &mut entries)?;
    entries.sort_by(|a, b| a.path.cmp(&b.path));
    Ok(inventory_hash(&entries))
}

fn collect_tree(root: &Path, dir: &Path, skip: &[&str], out: &mut Vec<FileEntry>) -> Result<()> {
    let mut children: Vec<_> = std::fs::read_dir(dir)
        .map_err(io_err(dir))?
        .filter_map(|e| e.ok())
        .collect();
    children.sort_by_key(|e| e.file_name());
    for child in children {
        let path = child.path();
        let relative = path
            .strip_prefix(root)
            .map_err(|_| invalid("path escaped its root"))?
            .to_string_lossy()
            .into_owned();
        let meta = std::fs::symlink_metadata(&path).map_err(io_err(&path))?;
        if meta.is_dir() {
            if skip.iter().any(|name| child.file_name() == *name) {
                continue;
            }
            collect_tree(root, &path, skip, out)?;
        } else {
            out.push(file_entry(root, &relative)?);
        }
    }
    Ok(())
}

## D058 — UI v2 "Refined Native": frozen prototype, P09 extraction plan

Accepted by the owner on 2026-10-26 ("I accept it as written"), with authority to implement P09 end to end autonomously and to proceed with C28 while C26 remains in progress; every chunk is reviewed until it scores 9 in every dimension.

The owner explored fifteen interactive shell concepts on a Claude Design canvas
(https://claude.ai/artifact/2SEXT1XMHdZkxHvdw8oaYL), selected "Refined
Native", and iterated its prototype (R2App, R2Onboard, R2Harness ×3,
R2Rationale) through sixteen independent Codex usability reviews (scores 6, 7,
7, then 8 on rounds 4–16). The prototype is frozen at canvas version 134 and
copied verbatim into `docs/architecture/ui-v2/prototype/` with a SHA-256
manifest; the canvas page is not changed again. Prototype data is invented and
is never shipped.

Decisions (grilling session, 55 questions, all recommendations accepted):

1. Extraction is spec, then TypeScript presentation, then Rust contract, as
   phase P09 chunks C27–C34 (see the chunk index). The first implementation
   slice is the shell plus the first-run wizard and add-tenant sheet.
2. The prototype's state model is normative for twelve named invariants
   (`docs/architecture/ui-v2/invariants.md`) and illustrative for code shape.
   Every prototype state field is assigned Rust-owned/observed or UI-transient
   (`state-ownership.md`); nothing goes to browser storage.
3. D014 holds: secrets enter only through the host secret sheet and vault;
   an issued API key is disclosed only through the existing `RevealSecret`
   host path, held for the active context and never persisted; key rotation
   is the admitted sequence additional key (`Version`) → local deployment
   acknowledgement → old key `Delete` with readback (no invented grace
   period or revocation); typed-name confirmation is validated in the core;
   tenant switch is refused by the core while a Harness decision is pending;
   write-capable tool calls use the native confirmation sheet.
3a. Only products with an admitted service are verified, inventoried or
   changed (Runtime Security, Gateway, Red Team and Model/skill reads).
   Agentic Identity Security and Agentic Endpoint Security render as "Not
   available in this release" with a dependency gate; no inventory,
   verification result or mutation is invented for them.
4. Tokens live in a local `--v2-*` file; Academy variables stay for the
   embedded learner view. One Rust navigation inventory feeds the native menu,
   sidebar and palette; ⌘1–⌘9 are menu-defined. Feature ids gain `home` and
   `inbox`.
5. The new shell ships behind a Rust-owned `ui_variant` flag and the legacy
   shell, flag and legacy acceptance scripts are removed in C34. The Academy
   learner view is embedded unchanged.
6. The wizard realises D013 (scan key first and only required credential);
   v1 import is offered on the tenant step.
7. Verification: Vitest fixtures named after every prototype wrapper board,
   Rust tests per invariant, native acceptance extended with focus ring, live
   regions, topmost modal and Reduce Motion persistence, screenshot evidence
   at 100%/200% in both themes per chunk. Live calls only in C29 (verify,
   Vulture, reads) and C31 (review apply, Redtail, prefixed) inside the scope
   designated 2026-10-25. C27 is reviewed at 9/10 in every dimension and the
   controller enforces it: a `docs_only` chunk has no native preparation or
   acceptance and refuses owner acceptance at completion and at recognition;
   C28–C34 follow D034.
8. Minimum window 1180×720 with the rail collapsing below 1280 wide; toasts
   persist under Reduce Motion; "Show the calls" panel shows diagnostics-
   redacted wire data; English only in P09; chunks commit on main except C34.
9. C27 proceeds in parallel with C26 (docs and controller registration only);
   C28 waits for C26.

## Directions explicitly requested before round 1
# Prisma AIRS Desktop v2 domain vocabulary

These terms name the desktop product and its native authority concepts.
Mechanisms, wire formats and transition rules belong in the selected design.

## Language

**Tenant profile**: An application-owned configuration for a Prisma AIRS tenant,
including its label, endpoints, and protected credential references. A scan-only
profile does not require management OAuth credentials. A profile is not an
Academy learner account or a Gateway workspace.

**Credential capability**: The specific operations a credential can authorize,
such as scanning, management, inference, or workspace MCP. Possessing one
capability does not establish another; configuration keeps them explicit.

**Gateway workspace**: A remote AI Gateway administrative/inference context within
the selected tenant profile. It is distinct from a local filesystem project.

**Configuration review**: An operator-visible proposal for an AIRS configuration
change, bound to the current tenant, credential context, target resource, and
draft. Rust owns its validity. Displaying or importing a proposal does not grant
permission to apply it.

**Remote outcome**: What is known about an attempted remote action: not sent,
rejected, completed as established by evidence, or unknown. Local timeout,
cancellation, and disconnection do not establish remote rollback.

**Academy feature**: The learner experience within the broader desktop app.
Presentation is shared with Academy; remote learning contracts remain hosted.
Learning progression, XP, cosmetic credits, awards, and other gamification stay
within this feature.

**Academy learner account**: The remote learning identity owning progress,
assessments, certificates, and account-scoped local drafts/downloads. It is
independent of the selected Prisma AIRS tenant and Harness inference sign-in.

**Shared presentation**: React controls, themes, and shell layout reused from the
Academy-owned source. Sharing appearance does not share learner authority,
gamification effects, manager routes, or browser-session assumptions globally.

**Harness**: The assistant feature using the native Rust agent engine and
desktop-owned lifecycle, credential grants, reviews, and protected history.
The SCM SDK is a separate dependency, not the Harness engine.

**Project scope**: The explicitly selected local filesystem scope and approved
tool permissions available to a Harness conversation. Preserve the existing
restrictions initially; a transcript is not permission to restore approvals.

**MCP grant**: A desktop-owned authorization context for a specific remote MCP
binding. Inference sign-in is separate. Discovery does not establish execution;
execution evidence must correspond to the actual approved call.

**Historical conversation**: Saved user work that can be inspected after import.
Resumption requires separate context/protocol compatibility validation. It never
restores pending approvals or old authentication sessions.

**Billing**: Desktop commercial charging/monetization machinery, excluded from
v2. Remote Gateway usage/cost/budget/limit administration remains product
functionality. Academy's earned learning economy remains Academy-local.

**Shipped backend runtime**: Executables/workers required by the installed app's
backend. Node/Bun and TypeScript backend workers are excluded. Build-time JS
tooling and React JavaScript executing in the WebView are separate concepts.

**Parity**: Coverage of agreed working v1 behavior with new v2 evidence. V1 source
implementation, retained fixture/contract results, retained live evidence, and
v2 installed-artifact results are distinct. Replacing a preview/stub with a live
feature is scope expansion, not implicit parity work.

**Authority principal**: The native-established operator or restricted Harness
identity on whose behalf desktop work is requested. A claimed identity in a
request is not an Authority principal.

**Authority handle**: A principal-scoped entry to native desktop operations and
observations. Possessing an operation reference does not expand its authority.

**Intent**: A typed request for a specific desktop action under the caller's
current authority. It is distinct from a Harness proposal or an arbitrary remote
request.

**Receipt**: Native acknowledgement that an Intent was admitted, with its request
or operation reference. It is not evidence of operator confirmation or remote
completion.

**Refusal**: Native rejection of an Intent before admission under the requested
authority. A remote action's failure is a Remote outcome instead.

**ViewScope**: The product context a caller asks to observe, such as a learner
account, tenant workspace or Harness conversation. Native authority determines
which part is visible to that caller.

**Observation**: A scoped redacted view of native desktop state and operation
progress. It confers no execution or credential authority.

**ContextRef**: A native reference to the particular product context presented
to the caller. Returning to the same tenant or account does not revive retired
authority.

**Delivery session**: The current native-registered channel for one caller's
Intent deliveries. It is separate from tenant, learner or inference identity.

**Delivery sequence**: The order identity of an Intent within its Delivery session,
used to distinguish duplicate delivery from an explicit new action.
_Avoid_: Business retry, authorization token

**Native-owned payload reference**: A scoped reference to staged desktop input
whose ownership and content are known natively. It is not permission to read an
arbitrary filesystem path.

**Reviewed**: A Configuration review whose captured proposal remains eligible for
operator confirmation.

**Confirming**: A Configuration review currently awaiting the native operator's
answer for that specific proposal.

**Consumed**: A Configuration review already committed to its single admitted
operation. Failure of that operation does not make the review reusable.

**Queued**: An admitted desktop operation whose remote dispatch has not been
claimed.

**DispatchClaimed**: A desktop operation for which remote dispatch may have begun.
Local cancellation at this stage does not prove NotSent.

**Settled**: A desktop operation with a recorded terminal local result and its
current Remote outcome. Later reconciliation may refine knowledge of that outcome.

**Harness grant**: Native authority for one verified inference identity and its
approved tenant/workspace/origin context. Rotating that identity's token material
is distinct from replacing or revoking the Harness grant.

**Grant epoch**: The particular lifetime of a native grant's authority. Retired
authority stays retired even when an equivalent identity is selected again.

**One-time secret receipt**: The operator-scoped acknowledgement holding newly
issued secret material for its explicit transient reveal. It is separate from a
stored credential lookup.

**Editor lease**: The hold on the reviewed document while native operator
confirmation is pending. A changed document or context invalidates that hold.

