     6	/** What a contextual action asked the destination to select on arrival (C30), owned by the tenant it was followed in (I2). */
     7	export interface Arrival {
     8	    tenant: string
     9	    feature: FeatureId
    10	    resource: ManagementResource | null
    11	    /** The item to filter to, by name. */
    12	    item: string | null
    13	    /** Counts arrivals: a destination already open applies a new one. */
    14	    sequence: number
    15	}
    16	
    17	/** A Harness message kept for the operator: refused or never sent, or not confirmed (C32). */
    18	export interface HarnessKept {
    19	    /** This record's own id: each attempt is its own record (C32). */
    20	    id: number
    21	    text: string
    22	    unconfirmed: boolean
    23	    /** For an unconfirmed send: the conversation it was sent to and how many operator messages it had before (C32). */
    24	    conversation?: string
    25	    before?: number
    26	}
    27	
    28	/** A delivery the desktop did not confirm: kept until the operator retries or dismisses it (DESIGN-V2 §7). */
    29	export interface Unconfirmed {
    30	    id: number
    31	    what: string
    32	    intent: Intent
    33	    /** The context the intent was bound to, if any: once that context retires, the delivery cannot be revived. */
    34	    context: string | null
    35	}
    36	
    37	export interface Toast {
    38	    id: number
    39	    kind: ToastKind
    40	    text: string
    41	    /** An optional undo the toast offers (label + action). */
    42	    undo?: { label: string; run: () => void }
    43	    /** The tenant the toast speaks for (an item, a read): retired on leaving it (I2). */
    44	    tenant: string | null
    45	    /** The context it was raised under, when the action was context-bound: retired with it. */
    46	    context: string | null
    47	}
    48	
    49	/**
    50	 * Transient shell presentation state (state-ownership.md "UI"): what is open,
    51	 * the palette query, toasts and the modal stack. Nothing here survives a
    52	 * reload and nothing here is authority: every durable fact is observed from
    53	 * the Rust snapshot.
    54	 */
    55	interface ShellStore {
    56	    /** The scope the shell shows now (set from each snapshot before it renders): what a notification must belong to. */
    57	    scope: { tenant: string | null; context: string | null }
    58	    setScope(tenant: string | null, context: string | null): void
    59	    paletteOpen: boolean
    60	    switcherOpen: boolean
    61	    toasts: Toast[]
    62	    /** Open modal ids, bottom to top; only the last is interactive (I8). */
    63	    modals: string[]
    64	    /** The Inbox tab and item per tenant (I2: a switch round trip keeps it). */
    65	    inboxSelection: Record<string, { tab: 'all' | 'action' | 'updates' | 'snoozed'; item: string | null }>
    66	    selectInbox(tenant: string, selection: { tab: 'all' | 'action' | 'updates' | 'snoozed'; item: string | null }): void
