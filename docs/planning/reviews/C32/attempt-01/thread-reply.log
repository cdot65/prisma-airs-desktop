import { forwardRef, useEffect, useId, useRef, useState } from 'react'
import { Button, Callout } from '@ai-security-academy/presentation'
import { AlertTriangle, Info } from 'lucide-react'
import type {
    ConversationView,
    FeatureId,
    HarnessEntry,
    HarnessFailure,
    HarnessPhase,
    HarnessStop,
    McpStartup,
    ShellSnapshot,
    TurnEnd,
} from '@prisma-airs/desktop-contracts'
