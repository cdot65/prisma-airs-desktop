    obs["tree_approved"] = c29.save_tree("harness-approved", tree)
    obs["n2"] = n2

    # ---- N03: a follow-up opens only the operator's review; ending; the next send starts anew ----
    n3 = {}
    since = len(c9.writes(mgmt, prefix="/aisec/"))
