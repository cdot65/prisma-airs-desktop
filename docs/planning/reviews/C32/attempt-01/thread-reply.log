    tree, n3["new_conversation"] = app.wait_for(lambda t: app.has_text(t, "And yesterday?") and answers(app, t) >= 1 and not app.has_text(t, "This conversation ended."), 60)
    obs["n3"] = n3

    # ---- N04: keyboard reach; 900x600 and 200% in both themes ----
    n4 = {}
    app.ax("focus", "AXTextArea", "Message")
