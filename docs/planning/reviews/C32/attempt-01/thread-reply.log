        let Some(run) = self.playground.as_mut().filter(|r| &r.tenant == tenant) else {
            return starts;
        };
        run.retired = true;
        if run.settled.is_some() {
            return starts;
        }
        let operation = run.operation.clone();
        starts.extend(
            self.operations
                .cancel(&operation, StopReason::Cancelled, Instant::now())
                .1,
        );
        starts
    }

