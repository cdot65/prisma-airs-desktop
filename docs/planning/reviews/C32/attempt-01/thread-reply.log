        right = max(n["pos"][0] + n["size"][0] for n in nodes) if nodes and win else None
        hbars = [n for n in tree if n.get("role") == "AXScrollBar" and (n.get("orientation") == "horizontal" or (n.get("size") and n["size"][0] > n["size"][1]))]
