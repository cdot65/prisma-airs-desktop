        [run_rel, obs["tree_follow_up"], obs["tree_review"], obs["tree_ended"]] + caps("harness-follow-up") + caps("harness-ended"))
    zoom_ok = all(v["overflow_px"] == 0 and v["horizontal_scrollbars"] == 0 for v in n4["zoom"].values())
