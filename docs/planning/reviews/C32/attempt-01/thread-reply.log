        f = fx.App.focused(app.tree()) or {}
        walk.append(f.get("label") or "")
    n4["walk"] = walk
    n4["send_reached"] = any(l in ("Send", "End conversation") for l in walk)
    base = c28.window_size(pid)
    c28.set_window_size(pid, 900, 600)
    c29.zoom(app, 10)
