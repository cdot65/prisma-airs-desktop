   597	 */
   598	function outcomeOf(c: ConversationView): { tone: VerdictTone; word: string; text: string } | null {
   599	    if (c.phase === 'failed') return { tone: 'blocked', word: C.outcome.failed, text: c.failure ? HARNESS_FAILURE_TEXT[c.failure] : conversationText(c) }
   600	    if (c.cleanup === 'failed') return { tone: 'blocked', word: C.outcome.cleanup, text: HARNESS_FAILURE_TEXT.cleanupFailed }
   601	    if (c.phase === 'ended') return { tone: 'info', word: C.outcome.ended, text: conversationText(c) }
   602	    if (c.lastTurn && c.lastTurn !== 'completed' && c.phase === 'ready') {
   603	        return { tone: c.lastTurn === 'failed' ? 'blocked' : 'flagged', word: C.outcome.turn[c.lastTurn] ?? c.lastTurn, text: TURN_TEXT[c.lastTurn] }
