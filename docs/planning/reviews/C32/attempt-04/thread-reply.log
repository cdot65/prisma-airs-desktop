   635	            <Verdict tone={readOnly ? 'info' : 'flagged'} word={readOnly ? C.readOnlyWord : C.mayChangeWord} />
   636	            <p className='text-[13px]'>{C.asks(C.kind[a.kind] ?? a.kind, what)}</p>
   637	            {a.arguments ? (
   638	                <pre className='overflow-x-auto rounded-[8px] p-2 text-[12px]' style={{ background: 'var(--v2-side)' }}>
   639	                    {a.arguments}
   640	                </pre>
   641	            ) : null}
   642	            {a.cwd ? <p className='text-[12px]'>{C.inFolder(a.cwd)}</p> : null}
   643	            {a.reason ? <p className='text-[12px]'>{a.reason}</p> : null}
   644	            <p className='text-[12px]' style={{ color: 'var(--v2-soft)' }}>
   645	                {readOnly ? (C.readOnlyNote[a.kind] ?? C.readOnlyNote.desktopRead) : (C.mayChangeNote[a.kind] ?? C.mayChangeNote.mcpTool)}
   646	            </p>
   647	            <div className='flex flex-wrap gap-2'>
   648	                <button
   649	                    type='button'
   650	                    disabled={busy}
   651	                    className='h-8 rounded-[7px] px-3 text-[13px] font-semibold disabled:opacity-60'
   652	                    style={{ background: 'var(--v2-acc)', color: 'var(--v2-acc-ink)' }}
   653	                    onClick={() => onDecide(true)}
