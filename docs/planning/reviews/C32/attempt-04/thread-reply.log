   723	                                        <button type='button' disabled={busy} className='h-8 rounded-[7px] border px-3 text-[13px] disabled:opacity-60' style={{ borderColor: 'var(--v2-rule)' }} onClick={() => onDismiss(p)}>
   724	                                            {C.dismiss}
   725	                                        </button>
   726	                                    ) : null}
   727	                                </div>
