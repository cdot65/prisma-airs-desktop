import { useEffect, useId, useRef, type KeyboardEvent, type ReactNode } from 'react'
import { useShellStore } from './store'

interface ModalProps {
    label: string
    onClose: () => void
    children: ReactNode
    /** Width in CSS px (default 560). */
    width?: number
    'data-slot'?: string
}

const FOCUSABLE = 'a[href], button:not([disabled]), input:not([disabled]), select:not([disabled]), textarea:not([disabled]), [tabindex]:not([tabindex="-1"])'

/**
 * One topmost modal (I8): dialogs register on a shell-wide stack; only the
 * last is interactive. Lower dialogs are inert and aria-hidden, Tab and
 * Shift-Tab stay inside the topmost dialog, Escape closes the topmost only,
 * focus moves into the dialog on open and back to the opener on close. The
 * page behind every dialog is made inert by the shell (`useModalsOpen`).
 * The dialog element handles its own keys; the topmost dialog also listens
 * on the window for Escape alone, for when focus has left it (a native
 * sheet returned focus elsewhere), and closes only itself.
 */
export function Modal({ label, onClose, children, width = 560, ...rest }: ModalProps) {
    const id = useId()
    const pushModal = useShellStore((s) => s.pushModal)
    const popModal = useShellStore((s) => s.popModal)
    const modals = useShellStore((s) => s.modals)
    const topmost = modals.length > 0 && modals[modals.length - 1] === id
    const dialog = useRef<HTMLDivElement>(null)
    const opener = useRef<HTMLElement | null>(null)
    const focusedOnce = useRef(false)

    useEffect(() => {
        opener.current = document.activeElement instanceof HTMLElement ? document.activeElement : null
        pushModal(id)
        return () => {
            popModal(id)
            // After the commit: the page behind is still inert during cleanup,
            // and an inert ancestor refuses focus (observed in WebKit).
            const target = opener.current
            queueMicrotask(() => {
                // Only when nothing else took focus meanwhile (⌘T replacing the
                // palette hands focus to the tenant list, which must keep it).
                const active = document.activeElement
                if (active && active !== document.body) return
                // The opener may be gone (a "Finish rotation…" that completed):
                // focus the page heading rather than leave it on nothing.
                if (target?.isConnected) target.focus()
                else document.querySelector<HTMLElement>('main h1[tabindex="-1"]')?.focus()
            })
        }
    }, [id, pushModal, popModal])

    useEffect(() => {
        // Initial focus goes into the dialog once, when it opens. Regaining the
        // top after a higher dialog closes must not refocus: that dialog is
        // restoring its own opener, which may be any control here.
        if (!topmost || focusedOnce.current) return
        const node = dialog.current
        if (!node) return
        focusedOnce.current = true
        if (!node.contains(document.activeElement)) {
            // A declared initial control first (wherever it sits), else the first focusable.
            const first = node.querySelector<HTMLElement>('[autofocus]') ?? node.querySelector<HTMLElement>(FOCUSABLE)
            ;(first ?? node).focus()
        }
    }, [topmost])

    // Escape still closes the topmost dialog when focus has left it (a
    // native sheet returning focus to the page body, a click on the scrim's
    // edge): the dialog's own handler stops the event first when it has focus.
    const closeRef = useRef(onClose)
    closeRef.current = onClose
    useEffect(() => {
        if (!topmost) return
        const onWindowKey = (event: globalThis.KeyboardEvent) => {
            if (event.key !== 'Escape' || event.defaultPrevented) return
            const node = dialog.current
            if (node && node.contains(document.activeElement)) return
            event.preventDefault()
            closeRef.current()
        }
        window.addEventListener('keydown', onWindowKey)
        return () => window.removeEventListener('keydown', onWindowKey)
    }, [topmost])

    const onKeyDown = (event: KeyboardEvent<HTMLDivElement>) => {
        if (!topmost) return
        if (event.key === 'Escape') {
            event.preventDefault()
            event.stopPropagation()
            onClose()
            return
        }
        if (event.key === 'Tab') {
            // Keyboard interaction stays inside the topmost dialog.
            const node = dialog.current
            if (!node) return
            const items = Array.from(node.querySelectorAll<HTMLElement>(FOCUSABLE)).filter((el) => !el.hasAttribute('hidden') && el.getAttribute('aria-hidden') !== 'true')
            if (items.length === 0) {
                event.preventDefault()
                node.focus()
                return
            }
            const first = items[0] as HTMLElement
            const last = items[items.length - 1] as HTMLElement
            const active = document.activeElement
            if (event.shiftKey && (active === first || active === node)) {
                event.preventDefault()
                last.focus()
            } else if (!event.shiftKey && active === last) {
                event.preventDefault()
                first.focus()
            }
        }
    }

    return (
        <div
            className='fixed inset-0 z-50 grid place-items-start justify-center pt-[4vh]'
            data-v2-scrim=''
            aria-hidden={topmost ? undefined : true}
            inert={topmost ? undefined : true}
            onMouseDown={() => topmost && onClose()}
        >
            <div
                ref={dialog}
                role='dialog'
                aria-modal={topmost ? 'true' : undefined}
                aria-label={label}
                tabIndex={-1}
                data-slot={rest['data-slot'] ?? 'modal'}
                data-topmost={topmost ? 'true' : 'false'}
                onKeyDown={onKeyDown}
                onMouseDown={(e) => e.stopPropagation()}
                className='rounded-[12px] border p-5 shadow-2xl'
                // Bounded to the viewport: a tall dialog scrolls inside itself, so its
                // actions stay reachable at the minimum window size and 200% zoom.
                style={{ width: `min(${width}px, 92vw)`, maxHeight: '92vh', overflowY: 'auto', background: 'var(--v2-paper)', borderColor: 'var(--v2-rule)', color: 'var(--v2-ink)' }}
            >
                {children}
            </div>
        </div>
    )
}

/** Whether any modal is open: the shell makes the page behind it inert. */
export function useModalsOpen(): boolean {
    return useShellStore((s) => s.modals.length > 0)
}
### C19 implementation: the native Harness runtime and lifecycle

Implemented in `crates/desktop-core`:
- `harness::engine`: the compiled pin (`resources/harness/pin.json`) and
  the check every start makes before anything runs.
- `harness::protocol`: the `airs-desktop/1` frames, bounded and
  shape-checked; the bootstrap in one zeroizing buffer; the receipt
  matched against the binding.
- `harness::session`: one conversation's lifecycle:
  1. verify the engine;
  2. make its runtime home;
  3. read the key;
  4. launch, bootstrap, initialize and start a read-only thread;
  5. turns;
  6. the bounded stop and reap.

  Two threads own the pipes: the writer owns stdin, so closing its
  channel closes stdin, and the reader owns stdout, bounding every line
  and the stream's lifetime.
- `harness::sidecar`: the seam to the host's OS adapter (`LaunchSpec`,
  `SidecarLauncher`, `Sidecar`) and `HarnessAdapters`.
- `authority/harness_domain`: admission (as a Playground run), the
  conversation task, its retirement when it is no longer bound, and the
  view.
- Intents `StartHarness`, `SendHarness`, `InterruptHarness`, `EndHarness`
  and `ClearHarness`.
- Snapshot field `harness`: the engine's pin and the bound conversation.
- `Core::system_will_sleep` and `Core::end_harness_for_exit`.

In `apps/desktop/src-tauri`:
- `sidecar::OsLauncher`: process group, exit without reaping, group kill,
  reap on drop.
- `power`: the NSWorkspace will-sleep observer.
- The quit handler waits up to 5 s for the engine to be reaped.
- The bundled engine is resolved inside the app's resources.

In `xtask`, `harness::unpack` runs before every fixture build.

The presentation adds the Harness destination:
- the binding (workspace and endpoint);
- Start conversation;
- a streamed transcript (a list named Messages);
- Send (⌘↩), Stop answer, End conversation and Clear conversation;
- a status line that takes focus when a conversation ends or fails.

D046 records the decisions, including the engine's retries and how the
host limits them.

### C20 implementation: company sign-in, renewal and protected history

Implemented in `crates/desktop-core`:
- `harness::identity`: the provider (discovery, PKCE attempt, code
  exchange, refresh, revocation) over the app-owned client, and the
  `Verifier`. The verifier checks both JWTs against the issuer's JWKS,
  allowing one bounded refresh for an unknown key; time is judged on the
  caller's wall clock.
- `harness::callback`: the one-attempt loopback listener on `127.0.0.1`.
- `harness::history`: sealed records per tenant and workspace scope (list,
  read, save, delete, purge) and the transcript exports.
- `harness::session`: these additions:
  - After every turn, `desktop/history/read`. Commands wait for it, bounded
    by the request timeout.
  - The save sink runs off the task.
### C21 implementation: desktop tools, project folder, approvals and proposals

Implemented in `crates/desktop-core`:
- `harness::tools`: the `airs_desktop` catalog given to the engine as
  dynamic tools, `ToolCall::parse` (closed, bounded, never
  credential-bearing), and the scrubbed, redacted and bounded result text.
- `harness::protocol`: the binding carries the project and its access. The
  bootstrap sends `projectPath` and `localAccess`; the thread sends `cwd`,
  the sandbox and the catalog; restore sends the catalog too.
- `harness::session` adds:
  - `item/tool/call` handed to the authority's tool sink and answered
    with its result (`Command::ToolResult`);
  - command and file-change approvals held under desktop tokens
    (`Command::Decide`), or declined at once;
  - command, file-change and tool entries in the transcript;
  - everything pending cleared at interrupt and at turn end.
- `authority/harness_tools`:
  - project choice and checks, and the write flag;
  - approval decisions;
  - staged proposals and their review;
  - the write confirmation;
  - the tool runner, through `admit_management`, `admit_scan` and the
    library.
- `authority/harness_domain`: the conversation is bound to the project and
  its access. A renewal is held for `confirmWrite` while changes are
  allowed. The view shows approvals and proposals, and a proposal reads
  `closed` once its review has ended.
- `authority/harness_history`: saved bindings include the project and
  access; a mismatch reads `otherProject`.
- `store`: one project per tenant (path and write flag), checked for
  consistency.
- Intents: `ChooseHarnessProject`, `ClearHarnessProject`,
  `SetHarnessWrite`, `DecideHarnessApproval`, `ReviewHarnessProposal`,
  `DismissHarnessProposal`, `ConfirmHarnessWrite`.

The host adds the "Choose project folder" sheet (`FolderPicker::choose_project`;
the fixture build answers it from `fixture-project-folder` or the real
panel).

The presentation adds:
- the project folder panel (choose, remove, allow changes);
- the conversation's folder and access line;
- a "Waiting for your approval" region (Allow or Decline, with the command,
  folder, reason and files);
- "Proposed changes" (Review, Dismiss);
- the write re-confirmation (Allow changes and continue, Not now).

Administration opens a review the Harness proposed with its exact draft.
Saved conversations from another folder or access say so.

D048 records the decisions: the tool set, bounds, proposals, project
rules, approvals, sandbox evidence and the engine's patch-writer
limitation.

### C22 implementation: workspace MCP servers

Implemented in `crates/desktop-core`:
- `harness::mcp`:
  - the catalog projection, revisions and engine namespaces;
  - the conversation scope (`ScopeServer`) and its bootstrap entries, with
    the signed-out placeholder;
  - the fingerprint of what the engine holds.
- `harness::mcp_auth`: the desktop's OAuth for a server (challenge,
  protected-resource and server metadata, registration, authorize with
  PKCE and `resource`, exchange, refresh, revocation).
- `gateway`: `GatewayRead::McpServers`, which reads the workspace catalog
  through the management client.
- `harness::protocol`: the binding carries the MCP scope. The bootstrap
  sends `mcpServers` (frame overflow is `mcpTooLarge`), and the receipt
  must echo the scope in order.
