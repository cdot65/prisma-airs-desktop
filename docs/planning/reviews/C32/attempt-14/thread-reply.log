import { SHELL_COPY, SNOOZE_COPY } from './copy'
import { readLine } from './home'
import { Home } from './home'
import { Palette } from './palette'
import { useShellStore } from './store'
import { SwitchGuard } from './switch-guard'
import { TenantSwitcher } from './tenant-switcher'
import { Toasts } from './toasts'
import { Modal, useModalsOpen } from './modal'
import { Wizard } from './wizard/wizard'

export interface V2ShellProps {
    snapshot: ShellSnapshot
    appearancePending: boolean
    status: string
    onNavigate: (id: FeatureId) => void
    onSetAppearance: (theme: Theme) => void
    onSetShowCalls: (on: boolean) => void
    onReturnToClassic: () => void
    onSwitchTenant: (tenant: string, resolution?: SwitchResolution) => void
    onReadNow: () => void
    /** Re-sends a delivery the desktop did not confirm, only on the operator's click. */
    onRetry: (what: string, intent: Intent) => void
    /** Sends one intent and reports its outcome on the shell's surfaces (Home and Inbox actions). */
    onAct: Act
    dispatch: Dispatch
    client: DesktopClient
}

const THEMES: { value: Theme; label: string; icon: typeof Sun }[] = [
    { value: 'system', label: SHELL_COPY.appearanceSystem, icon: SunMoon },
    { value: 'light', label: SHELL_COPY.appearanceLight, icon: Sun },
    { value: 'dark', label: SHELL_COPY.appearanceDark, icon: Moon },
]

/**
 * The "Refined Native" shell (C28, DESIGN-V2): a 244px rail with the tenant
 * switcher on top, the Rust navigation inventory (labels and ⌘ hints come
 * from the same catalogue the native menu is built from), appearance and
 * "show the calls" preferences, one status surface and the modal stack.
 * Every destination other than Home renders the same FeatureBody the legacy
 * shell renders, so behaviour is identical whichever shell frames it.
 */
export function V2Shell(props: V2ShellProps) {
    const { snapshot } = props
    const paletteOpen = useShellStore((s) => s.paletteOpen)
    const openPalette = useShellStore((s) => s.openPalette)
    const closePalette = useShellStore((s) => s.closePalette)
    const unconfirmedAll = useShellStore((s) => s.unconfirmed)
    // Only deliveries bound to the shown context, or to none (I2).
    const unconfirmed = unconfirmedAll.filter((u) => u.context === null || u.context === (snapshot.active?.context ?? null))
    const clearUnconfirmed = useShellStore((s) => s.clearUnconfirmed)
    const arrival = useShellStore((s) => s.arrival)
    const modalOpen = useModalsOpen()
    const heading = useRef<HTMLHeadingElement>(null)
    const firstRender = useRef(true)
    const [adding, setAdding] = useState(false)
    // The sheet closes only when the wizard says so: a committed tenant (toast)
    // or a discard the core admitted. Escape and the scrim are close requests
    // the wizard answers with the same Cancel as its button.
    const [closeRequests, setCloseRequests] = useState(0)
    const closeSheet = (added?: string) => {
        setAdding(false)
        setCloseRequests(0)
        if (added) useShellStore.getState().toast(SHELL_COPY.tenantAdded(added), 'ok')
    }
    const active = snapshot.activeFeature
    const feature = snapshot.features.find((f) => f.id === active) ?? snapshot.features[0]
    // Completion toasts are derived from the core's ReadStatus (I4): a new
    // generation is one finished read; its kind follows the coverage. A
    // tenant change re-baselines (the other tenant's generation is its own).
    const read = snapshot.inbox.read
    const tenantNow = snapshot.active?.tenant ?? null
    const seenGeneration = useRef<{ tenant: string | null; generation: number }>({ tenant: tenantNow, generation: read.generation })
    useEffect(() => {
        const seen = seenGeneration.current
        seenGeneration.current = { tenant: tenantNow, generation: read.generation }
        if (seen.tenant !== tenantNow || read.generation === seen.generation) return
        const tenant = snapshot.tenants.find((t) => t.id === tenantNow)
        const line = readLine(snapshot, tenant?.label ?? null)
        useShellStore.getState().toast(line.text, line.tone === 'allowed' ? 'ok' : 'warn', undefined, tenantNow, snapshot.active?.context ?? null)
    }, [read.generation, tenantNow, snapshot])
    // A snooze is announced once, from the receipt the core issues for it
    // (I11): the return time is the core's, wherever the snooze was asked
    // for. Holds a tenant already had, or a read rediscovers, are not news.
    const lastSnooze = snapshot.inbox.lastSnooze
    const seenSnooze = useRef<{ tenant: string | null; sequence: number }>({ tenant: tenantNow, sequence: lastSnooze?.sequence ?? 0 })
    useEffect(() => {
        const seen = seenSnooze.current
        const sequence = lastSnooze?.sequence ?? 0
        seenSnooze.current = { tenant: tenantNow, sequence }
        if (seen.tenant !== tenantNow || !lastSnooze || sequence === seen.sequence) return
        useShellStore.getState().toast(SNOOZE_COPY.toast(lastSnooze.title, lastSnooze.returnsAt), 'info', undefined, tenantNow, snapshot.active?.context ?? null)
    }, [lastSnooze, tenantNow, snapshot.active])
    // Presentation state follows its tenant (I2): an arrival another tenant
    // asked for is forgotten, a toast that spoke for another tenant's item or
    // read is retired (however long Reduce Motion would have kept it), and an
    // unconfirmed delivery bound to a retired context is dropped (it can
    // never be revived, let alone rebound).
    const contextNow = snapshot.active?.context ?? null
    useEffect(() => {
        useShellStore.getState().scopeArrival(tenantNow)
        useShellStore.getState().retireToasts(tenantNow)
        useShellStore.getState().retireUnconfirmed(contextNow)
    }, [tenantNow, contextNow])
    // The guard for a switch asked here (I1); a setup draft's completion
    // renders the same guard inside the wizard, which re-sends the completion.
    const guard = snapshot.switchBlocked && !snapshot.switchBlocked.completion ? snapshot.switchBlocked : null
    const guardTarget = guard ? snapshot.tenants.find((t) => t.id === guard.to)?.label ?? guard.to : null

    useEffect(() => {
        // Move focus to the new page heading after navigation (not on launch).
        if (firstRender.current) {
            firstRender.current = false
            return
        }
        heading.current?.focus()
    }, [active])

    if (!feature) return null
    return (
        <div data-v2-shell='' className='flex min-h-screen'>
            <nav
                data-v2-rail=''
                aria-label={SHELL_COPY.navLabel}
                aria-hidden={modalOpen ? true : undefined}
                inert={modalOpen ? true : undefined}
                className='sticky top-0 flex h-screen shrink-0 flex-col gap-2 overflow-y-auto p-3'
                style={{ width: 'var(--v2-rail)', background: 'var(--v2-side)', borderRight: '1px solid var(--v2-rule)' }}
            >
                <TenantSwitcher snapshot={snapshot} onSwitch={props.onSwitchTenant} onAdd={() => setAdding(true)} />
                <ul className='mt-2 flex flex-col gap-0.5'>
                    {snapshot.features
                        .filter((f) => f.sidebar)
                        .map((f) => {
                            const Icon = FEATURE_ICONS[f.id]
                            const current = f.id === feature.id
                            const unavailable = f.availability.state === 'unavailable'
                            const reason = f.availability.state === 'unavailable' ? f.availability.reason : ''
                            return (
                                <li key={f.id}>
                                    <button
                                        type='button'
                                        aria-current={current ? 'page' : undefined}
                                        aria-disabled={unavailable || undefined}
                                        aria-describedby={unavailable ? `${f.id}-hint` : undefined}
                                        title={unavailable ? SHELL_COPY.unavailableHint(reason) : f.shortcut !== null ? `${f.label} (⌘${f.shortcut})` : f.label}
                                        onClick={() => !unavailable && props.onNavigate(f.id)}
                                        data-inset-focus=''
                                        className='flex min-h-9 w-full items-center gap-2.5 rounded-[7px] px-2.5 text-left text-[14px] font-medium'
                                        style={{
                                            background: current ? 'var(--v2-sel)' : 'transparent',
                                            color: current ? 'var(--v2-sel-ink)' : unavailable ? 'var(--v2-faint)' : 'var(--v2-ink)',
                                        }}
                                    >
                                        <Icon aria-hidden='true' size={16} />
                                        <span data-v2-label className='flex-grow truncate'>
                                            {f.label}
                                        </span>
                                        {f.shortcut !== null && (
                                            <kbd data-v2-label className='text-[11px]' aria-label={`Command ${f.shortcut}`} style={{ opacity: 0.75 }}>
            <main
                data-slot='app-main'
                className='min-w-0 flex-grow'
                style={{ padding: 'var(--v2-page-top) var(--v2-page-x) 28px' }}
                aria-hidden={modalOpen ? true : undefined}
                inert={modalOpen ? true : undefined}
            >
                {unconfirmed.length > 0 && (
                    <ul data-slot='unconfirmed' aria-label='Not confirmed' className='mb-4 flex flex-col gap-2'>
                        {unconfirmed.map((u) => (
                            <li key={u.id} role='status' className='flex items-center gap-3 rounded-[12px] border px-4 py-2 text-[13px]' style={{ borderColor: 'var(--v2-flag)', background: 'var(--v2-flag-bg)', color: 'var(--v2-ink)' }}>
                                <span className='flex-grow'>{SHELL_COPY.unconfirmed(u.what)}</span>
                                <button
                                    type='button'
                                    onClick={() => {
                                        clearUnconfirmed(u.id)
                                        props.onRetry(u.what, u.intent)
                                    }}
                                    className='h-8 rounded-[7px] px-3 text-[12px] font-semibold'
                                    style={{ background: 'var(--v2-acc)', color: 'var(--v2-acc-ink)' }}
                                >
                                    {SHELL_COPY.retry}
                                </button>
                                <button type='button' onClick={() => clearUnconfirmed(u.id)} className='h-8 rounded-[7px] border px-3 text-[12px]' style={{ borderColor: 'var(--v2-rule)' }}>
                                    {SHELL_COPY.dismiss}
                                </button>
                            </li>
                        ))}
                    </ul>
                )}
                {feature.id === 'home' ? (
                    <Home ref={heading} snapshot={snapshot} onAct={props.onAct} onNavigate={props.onNavigate} />
                ) : feature.id === 'inbox' ? (
                    <Inbox ref={heading} snapshot={snapshot} onAct={props.onAct} onNavigate={props.onNavigate} />
                ) : feature.id === 'administration' && feature.availability.state === 'available' ? (
                    <Administration
                        key={snapshot.active?.context ?? 'none'}
                        ref={heading}
                        snapshot={snapshot}
                        dispatch={props.dispatch}
                        client={props.client}
                        onAct={props.onAct}
                        onNavigate={props.onNavigate}
                        arrival={arrival && arrival.tenant === tenantNow && arrival.feature === 'administration' ? arrival : null}
                    />
                ) : feature.id === 'harness' && feature.availability.state === 'available' ? (
                    <Harness
                        key={snapshot.active?.context ?? 'none'}
                        ref={heading}
                        snapshot={snapshot}
                        dispatch={props.dispatch}
                        onNavigate={props.onNavigate}
                        arrival={arrival && arrival.tenant === tenantNow && arrival.feature === 'harness' ? arrival : null}
                    />
                ) : (
                    <FeatureBody
                        ref={heading}
                        feature={feature}
                        snapshot={snapshot}
                        appearancePending={props.appearancePending}
                        onSetAppearance={props.onSetAppearance}
                        onNavigate={props.onNavigate}
                        dispatch={props.dispatch}
                        client={props.client}
                        arrival={arrival && arrival.tenant === tenantNow && arrival.feature === feature.id ? arrival : null}
                    />
                )}
                <p role='status' aria-live='polite' data-slot='shell-status' className='mt-4 pb-6 text-[13px]' style={{ color: 'var(--v2-soft)' }}>
                    {props.status}
                </p>
            </main>
            {paletteOpen && (
                <Palette snapshot={snapshot} onNavigate={props.onNavigate} onSwitchTenant={props.onSwitchTenant} onReadNow={props.onReadNow} onClose={closePalette} />
            )}
            {guard && guardTarget && (
                <SwitchGuard target={guardTarget} completion={false} onStay={() => void props.dispatch({ kind: 'dismissSwitchGuard' })} onResolve={(resolution) => props.onSwitchTenant(guard.to, resolution)} />
            )}
            {adding && (
                <Modal label='Add a tenant' onClose={() => setCloseRequests((n) => n + 1)} width={1160} data-slot='add-tenant-sheet'>
                    <Wizard
                        snapshot={snapshot}
import { useEffect, useId, useRef, useState } from 'react'
import { Button } from '@ai-security-academy/presentation'
import type {
    ContextRef,
    HarnessHistoryView,
    HistoryFailure,
    HistoryFormat,
    NotContinuable,
    SelectedWorkspace,
} from '@prisma-airs/desktop-contracts'
import type { Dispatch } from '../tenants/dispatch'

/** Why protected history could not be read or written. */
export const HISTORY_FAILURE_TEXT: Record<HistoryFailure, string> = {
    locked: 'The Keychain is locked, so saved conversations cannot be read or saved. Nothing was written unencrypted.',
    denied: 'macOS did not allow access to the history key. Nothing was written unencrypted.',
    unavailable: 'Saved conversations are not available on this Mac right now.',
    full: 'This workspace already keeps 16 saved conversations. Delete one to keep new conversations.',
    tooLarge: 'This conversation is too large to save.',
    unreadable: 'This saved conversation cannot be read with this workspace’s key.',
    missing: 'That saved conversation no longer exists.',
}

const NOT_CONTINUABLE_TEXT: Record<NotContinuable, string> = {
    running: 'This is the conversation running now.',
    otherCredential:
        'It ran with another key, sign-in or endpoint than this workspace uses now, so it can be read and exported but not continued.',
    otherProject:
        'It ran with another project folder, or with changes allowed differently, than the Harness uses now. Choose that folder and access again to continue it, or start a new conversation.',
    otherMcp:
        'It ran with other workspace MCP servers or sign-ins than this workspace uses now, or they could not be checked. Turn the same servers on and sign in to them to continue it, or start a new conversation.',
    engineUnavailable: 'The Harness engine is not bundled with this build.',
    workspaceUnavailable: 'AI Gateway’s workspaces could not be read, so it can be read and exported here but not continued.',
    notRestorable:
        'It was cut short before the engine saved anything to restore, so it can be read and exported but not continued. A call it shows as interrupted may have run.',
    imported: 'It was imported from v1, so it can be read and exported but not continued.',
}

const FORMATS: readonly [HistoryFormat, string][] = [
    ['markdown', 'Markdown'],
    ['text', 'Plain text'],
    ['json', 'JSON'],
]

export function savedAt(seconds: number): string {
    return new Date(seconds * 1000).toLocaleString(undefined, { dateStyle: 'medium', timeStyle: 'short' })
}

interface Props {
    context: ContextRef
    /** None while no workspace is chosen (as when AI Gateway cannot be read). */
    selected: SelectedWorkspace | null
    history: HarnessHistoryView | null
    /** A conversation is running (one at a time). */
    running: boolean
    dispatch: Dispatch
    onMessage: (message: string | null) => void
}

/**
 * The chosen workspace's saved conversations (C20): saved encrypted on this
 * Mac after every answer. One can be read, exported, deleted, or continued
 * in a new engine when it ran with the credential this workspace uses now.
 * With no workspace chosen, the last chosen one's, read from this Mac only
 * (T23): read, exported and deleted, never continued.
 */
export function HistoryPanel({ context, selected, history, running, dispatch, onMessage }: Props) {
    const ids = useId()
    const [format, setFormat] = useState<HistoryFormat>('markdown')
    const [confirming, setConfirming] = useState<string | null>(null)
    const openedRef = useRef<HTMLHeadingElement>(null)
    const listRef = useRef<HTMLHeadingElement>(null)
    const workspace = selected?.reference ?? null
    // Without a chosen workspace there may be none saved on this Mac either.
    const [none, setNone] = useState(false)

    // Read the list whenever the chosen workspace changes.
    useEffect(() => {
        let current = true
        setNone(false)
        void dispatch({ kind: 'listHarnessHistory', context, workspace }).then((outcome) => {
            if (current) setNone(workspace === null && outcome.kind !== 'admitted')
        })
        return () => {
            current = false
        }
    }, [dispatch, context, workspace])

    const opened = history?.opened ?? null
    const wasOpened = useRef<string | null>(opened?.id ?? null)
    useEffect(() => {
        const was = wasOpened.current
        wasOpened.current = opened?.id ?? null
        if (opened && opened.id !== was) openedRef.current?.focus()
        if (!opened && was !== null) listRef.current?.focus()
    }, [opened])

    async function send(intent: Parameters<Dispatch>[0]): Promise<boolean> {
        onMessage(null)
        const outcome = await dispatch(intent)
        if (outcome.kind !== 'admitted') onMessage('That was not done.')
        return outcome.kind === 'admitted'
    }

    const busy = history?.busy ?? false
    const exportState = history?.export ?? null
    if (none || (selected === null && history !== null && !history.local)) return null
    return (
        <section aria-labelledby={`${ids}-heading`} className='flex flex-col gap-3' data-slot='harness-history'>
            <h2 ref={listRef} tabIndex={-1} id={`${ids}-heading`} className='text-[15px] font-semibold'>
                Saved conversations
            </h2>
            <p className='text-academy-ink-faint text-[12px]'>
                {selected
                    ? `Conversations in ${selected.workspace.name} are saved on this Mac after every answer, encrypted with a key kept in the Keychain. Up to 16 are kept; nothing is deleted to make room.`
                    : 'AI Gateway’s workspaces are not available, so these are the conversations saved on this Mac for the workspace you chose last. They can be read, exported and deleted here; continuing one needs that workspace from AI Gateway.'}
            </p>
            {history === null || history.state === 'loading' ? (
                <p role='status' className='text-[13px]'>
                    Reading saved conversations…
                </p>
            ) : history.state === 'failed' && history.failure ? (
                <p role='alert' className='text-academy-accent-warn text-[13px]'>
                    {HISTORY_FAILURE_TEXT[history.failure]}
                </p>
            ) : history.conversations.length === 0 && history.unreadable.length === 0 ? (
                <p className='text-[13px]'>No saved conversations in this workspace.</p>
            ) : (
                <ul role='list' aria-label='Saved conversations' className='flex flex-col gap-2' data-slot='harness-history-list'>
                    {history.conversations.map((c) => (
                        <li key={c.id} className='border-academy-rule flex flex-wrap items-center gap-3 rounded-[12px] border p-3'>
                            <span className='flex min-w-0 flex-1 flex-col'>
                                <span className='truncate text-[14px]'>{c.title || 'Untitled conversation'}</span>
                                <span className='text-academy-ink-faint text-[12px]'>
                                    {`${c.entries} messages · ${savedAt(c.updated)} · ${c.source === 'companySignIn' ? 'company sign-in' : 'workspace key'}`}
                                </span>
                            </span>
                            <Button
                                type='button'
                                tier='secondary'
                                size='sm'
                                disabled={busy}
                                aria-label={`Open ${c.title || 'untitled conversation'}`}
                                onClick={() => void send({ kind: 'openHarnessHistory', context, workspace, id: c.id })}
                            >
                                Open
                            </Button>
                        </li>
                    ))}
                    {history.unreadable.map((id) => (
                        <li key={id} className='border-academy-rule flex flex-wrap items-center gap-3 rounded-[12px] border p-3'>
                            <span className='text-academy-ink-faint flex-1 text-[13px]'>{HISTORY_FAILURE_TEXT.unreadable}</span>
                            {/* Its key may be missing only for now (C20 F5): deleting asks first. */}
                            {confirming === id ? (
                                <>
                                    <span role='alert' className='w-full text-[13px]'>
                                        Delete this unreadable conversation from this Mac? If its key comes back it could be read again; once deleted
                                        it cannot be recovered.
                                    </span>
                                    <Button
                                        type='button'
                                        tier='secondary'
                                        size='sm'
                                        disabled={busy}
                                        onClick={async () => {
                                            setConfirming(null)
                                            await send({ kind: 'deleteHarnessHistory', context, workspace, id })
                                        }}
                                    >
                                        Delete permanently
                                    </Button>
                                    <Button type='button' tier='tertiary' size='sm' onClick={() => setConfirming(null)}>
                                        Keep it
                                    </Button>
                                </>
                            ) : (
                                <Button type='button' tier='tertiary' size='sm' disabled={busy} onClick={() => setConfirming(id)}>
                                    Delete unreadable conversation…
                                </Button>
                            )}
                        </li>
                    ))}
                </ul>
            )}
            {history?.full ? <p className='text-academy-accent-warn text-[13px]'>{HISTORY_FAILURE_TEXT.full}</p> : null}
            {history?.problem ? (
                <p role='alert' className='text-academy-accent-warn text-[13px]' data-slot='harness-history-problem'>
                    {HISTORY_FAILURE_TEXT[history.problem]}
                </p>
            ) : null}
            {opened ? (
                <section aria-labelledby={`${ids}-opened`} className='flex flex-col gap-3' data-slot='harness-history-opened'>
                    <h3 ref={openedRef} tabIndex={-1} id={`${ids}-opened`} className='text-[14px] font-semibold'>
                        {opened.title || 'Untitled conversation'}
                    </h3>
                    <p className='text-academy-ink-faint text-[12px]'>{`Saved ${savedAt(opened.updated)}`}</p>
                    <ol role='list' aria-label='Saved messages' className='flex flex-col gap-2'>
                        {opened.entries.map((e) => (
                            <li key={e.id} className='border-academy-rule rounded-[12px] border p-3'>
                                <p className='text-academy-ink-faint text-[12px] font-semibold'>{e.role === 'operator' ? 'You' : 'Harness'}</p>
                                <p className='text-[14px] whitespace-pre-wrap'>{e.text}</p>
                            </li>
                        ))}
                    </ol>
                    {opened.notContinuable ? <p className='text-[13px]'>{NOT_CONTINUABLE_TEXT[opened.notContinuable]}</p> : null}
                    <div className='flex flex-wrap items-end gap-2'>
                        {opened.notContinuable === null && workspace !== null ? (
                            <Button
                                type='button'
                                tier='primary'
                                size='sm'
                                disabled={busy || running}
                                onClick={() => void send({ kind: 'resumeHarness', context, workspace, id: opened.id })}
                            >
                                Continue this conversation
                            </Button>
                        ) : null}
                        <label className='flex flex-col gap-1 text-[12px]'>
                            <span>Export as</span>
                            <select
                                value={format}
                                onChange={(event) => setFormat(event.target.value as HistoryFormat)}
                                className='border-academy-rule rounded-[8px] border p-1 text-[13px]'
                            >
                                {FORMATS.map(([value, label]) => (
                                    <option key={value} value={value}>
                                        {label}
                                    </option>
                                ))}
                            </select>
                        </label>
                        <Button
                            type='button'
                            tier='secondary'
                            size='sm'
                            disabled={exportState?.state === 'saving'}
                            onClick={() => void send({ kind: 'exportHarnessHistory', context, workspace, id: opened.id, format })}
                        >
                            Export…
                        </Button>
                        {confirming === opened.id ? (
                            <>
                                <Button
                                    type='button'
                                    tier='secondary'
                                    size='sm'
                                    disabled={busy}
                                    onClick={async () => {
                                        setConfirming(null)
                                        await send({ kind: 'deleteHarnessHistory', context, workspace, id: opened.id })
                                    }}
                                >
                                    Delete permanently
                                </Button>
                                <Button type='button' tier='tertiary' size='sm' onClick={() => setConfirming(null)}>
                                    Keep it
                                </Button>
                            </>
                        ) : (
                            <Button
                                type='button'
                                tier='tertiary'
                                size='sm'
                                disabled={busy || opened.notContinuable === 'running'}
                                onClick={() => setConfirming(opened.id)}
                            >
                                Delete…
                            </Button>
                        )}
                        <Button type='button' tier='tertiary' size='sm' onClick={() => void send({ kind: 'closeHarnessHistory', context, workspace })}>
                            Close
                        </Button>
                    </div>
                    {confirming === opened.id ? (
                        <p role='alert' className='text-[13px]'>
                            Delete this saved conversation from this Mac? It cannot be recovered.
                        </p>
                    ) : null}
                    {exportState ? (
                        <p role='status' className='text-[13px]' data-slot='harness-export'>
                            {exportState.state === 'saving'
                                ? 'Choose where to save the transcript…'
                                : exportState.state === 'saved'
                                  ? `Saved ${exportState.name ?? 'the transcript'}.`
                                  : exportState.state === 'cancelled'
                                    ? 'Export cancelled.'
                                    : 'The transcript could not be saved.'}
                        </p>
                    ) : null}
                </section>
            ) : null}
        </section>
    )
}

