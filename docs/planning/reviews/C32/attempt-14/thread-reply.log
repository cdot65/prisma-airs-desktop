/// A renewal's message as a failed operator entry (redacted with the
/// renewed credentials).
fn unsent_entry(launch: &Launch) -> Option<HarnessEntry> {
    let (id, prompt) = launch.then.as_ref()?;
    let text = match &launch.key {
        Key::Renewed(key) => redact(
            prompt,
            &Secrets {
                key: key.clone(),
                mcp: launch.mcp.clone(),
            },
        ),
        Key::Reader(_) => String::new(),
    };
    Some(HarnessEntry {
        id: id.clone(),
        role: HarnessRole::Operator,
        text,
        state: EntryState::Failed,
    })
}

/// A renewal's message that no engine was started for (its home, key,
/// bootstrap, launch or pipes failed) is kept, failed, in the view and in
/// the saved record, with the last export as its restore point, and the
/// save's outcome is shown (P06 review R4-F1).
async fn keep_unsent(shared: &Shared, entry: Option<HarnessEntry>, restore: Option<&Replay>) {
    let Some(entry) = entry else {
        return;
    };
    let mut taken = None;
    update(&shared.progress, &shared.pulse, |p| {
        push(p, entry);
        taken = Some((p.entries.clone(), p.usage, p.opening.clone()));
    });
    let (Some(sink), Some((entries, usage, opening))) = (shared.history.clone(), taken) else {
        return;
    };
    let export = restore.cloned().unwrap_or(Replay {
        context: Value::Null,
        replay: Value::Null,
    });
    let saved = tokio::task::spawn_blocking(move || sink(entries, usage, opening, &export))
        .await
        .unwrap_or(Err(HistoryFailure::Unavailable));
    update(&shared.progress, &shared.pulse, |p| match saved {
        Ok(at) => {
            p.saved_at = Some(at);
            p.save_failure = None;
        }

    pub(super) fn proposals_mut(&mut self) -> &mut Vec<super::harness_tools::Proposal> {
        &mut self.proposals
    }

    pub(super) fn take_write_confirmation(&mut self) -> Option<RenewJob> {
        self.write_confirm.take()
    }

    pub(super) fn set_phase(&self, phase: HarnessPhase) {
        if let Ok(mut p) = self.progress.lock() {
            p.phase = phase;
        }
    }

    /// A message that will not be sent goes back to the box.
    pub(super) fn give_back(&mut self, job: RenewJob) {
        self.keep_unsent(job);
        self.set_phase(HarnessPhase::Ready);
    }

    /// A message whose renewal a stop overtook goes back to the box; the
    /// stopping task sets the phase (P06 review R3-F1).
    fn keep_unsent(&mut self, job: RenewJob) {
        self.entries -= 1;
        self.unsent = Some(job.prompt.to_string());
    }
}

