    pub(super) fn interrupt_harness(&mut self, id: &OperationId) -> Result<(), Refusal> {
        let conversation = self.live_harness(id)?;
        conversation
            .commands
            .try_send(Command::Interrupt)
            .map_err(|_| Refusal::Busy)
    }

