   564	/**
   565	 * How the conversation stands, in words the C19–C22 Harness used (R5): a
   566	 * failure names itself; a stopped, cut, failed or refused answer is never
   567	 * shown as complete; an engine that could not be removed says so.
   568	 */
   569	function outcomeOf(c: ConversationView): { tone: VerdictTone; word: string; text: string } | null {
   570	    if (c.phase === 'failed') return { tone: 'blocked', word: C.outcome.failed, text: c.failure ? HARNESS_FAILURE_TEXT[c.failure] : conversationText(c) }
   571	    if (c.cleanup === 'failed') return { tone: 'blocked', word: C.outcome.cleanup, text: HARNESS_FAILURE_TEXT.cleanupFailed }
   572	    if (c.phase === 'ended') return { tone: 'info', word: C.outcome.ended, text: conversationText(c) }
   573	    if (c.lastTurn && c.lastTurn !== 'completed' && c.phase === 'ready') {
   574	        return { tone: c.lastTurn === 'failed' ? 'blocked' : 'flagged', word: C.outcome.turn[c.lastTurn] ?? c.lastTurn, text: TURN_TEXT[c.lastTurn] }
   575	    }
   576	    return null
   577	}
   578	
   579	function Transcript({ entries }: { entries: HarnessEntry[] }) {
   580	    return (
   581	        <ol className='flex flex-col gap-3'>
   582	            {entries.map((e) => (
   583	                <li key={e.id} data-slot='harness-entry' data-role={e.role} data-state={e.state} className='flex flex-col gap-1'>
   584	                    <span className='text-[12px] font-medium' style={{ color: 'var(--v2-soft)' }}>
   585	                        {C.role[e.role] ?? e.role}
   586	                        {C.entryState[e.state] ? ` · ${C.entryState[e.state]}` : ''}
   587	                    </span>
   588	                    <p className='text-[13px] whitespace-pre-wrap'>{e.text}</p>
   589	                </li>
   590	            ))}
   591	        </ol>
   592	    )
   593	}
   594	
   595	/**
   596	 * One decision, as the core classified it (R1): a read-only call is decided
   597	 * here; anything that may change things says what, and approving it opens
   598	 * the system confirmation, which alone lets it run.
   599	 */
   600	function Decision({ approval: a, busy, onDecide }: { approval: HarnessApproval; busy: boolean; onDecide: (allow: boolean) => void }) {
   601	    const what = a.server && a.tool ? `${a.server}.${a.tool}` : (a.command ?? a.files.join(', '))
   602	    // Absent (a snapshot before C32) counts as may-change: never a false assurance.
   603	    const readOnly = a.effect === 'readOnly'
   604	    return (
   605	        <section aria-label={C.decision} data-slot='harness-decision' data-kind={a.kind} data-effect={a.effect ?? 'mayChange'} className='flex flex-col gap-2 rounded-[12px] border p-3' style={{ borderColor: 'var(--v2-flag)' }}>
   606	            <Verdict tone={readOnly ? 'info' : 'flagged'} word={readOnly ? C.readOnlyWord : C.mayChangeWord} />
   607	            <p className='text-[13px]'>{C.asks(C.kind[a.kind] ?? a.kind, what)}</p>
   608	            {a.arguments ? (
   609	                <pre className='overflow-x-auto rounded-[8px] p-2 text-[12px]' style={{ background: 'var(--v2-side)' }}>
   610	                    {a.arguments}
   611	                </pre>
   612	            ) : null}
   613	            {a.cwd ? <p className='text-[12px]'>{C.inFolder(a.cwd)}</p> : null}
   614	            {a.reason ? <p className='text-[12px]'>{a.reason}</p> : null}
   615	            <p className='text-[12px]' style={{ color: 'var(--v2-soft)' }}>
   616	                {readOnly ? (C.readOnlyNote[a.kind] ?? C.readOnlyNote.desktopRead) : (C.mayChangeNote[a.kind] ?? C.mayChangeNote.mcpTool)}
   617	            </p>
   618	            <div className='flex flex-wrap gap-2'>
   619	                <button
   620	                    type='button'
   621	                    disabled={busy}
   622	                    className='h-8 rounded-[7px] px-3 text-[13px] font-semibold disabled:opacity-60'
   623	                    style={{ background: 'var(--v2-acc)', color: 'var(--v2-acc-ink)' }}
   624	                    onClick={() => onDecide(true)}
   625	                >
   626	                    {readOnly ? C.approveOnce : C.approveNative}
   627	                </button>
   628	                <button type='button' disabled={busy} className='h-8 rounded-[7px] border px-3 text-[13px] disabled:opacity-60' style={{ borderColor: 'var(--v2-rule)' }} onClick={() => onDecide(false)}>
   629	                    {C.decline}
   630	                </button>
   631	            </div>
   632	        </section>
   633	    )
   634	}
   635	
   636	function applicationOf(p: ProposalView): string | null {
   637	    try {
   638	        const body = JSON.parse(p.draft.body) as { cust_app?: unknown }
   639	        return typeof body.cust_app === 'string' ? body.cust_app : null
   640	    } catch {
   641	        return null
   642	    }
   643	}
   644	
   645	/** The Harness's proposals as follow-ups: each opens only as the operator's own review, and only while its conversation runs. */
   646	function FollowUps({
   647	    proposals,
   648	    rotations,
   649	    busy,
   650	    open,
   651	    onOpen,
   652	    onDismiss,
   653	}: {
   654	    proposals: ProposalView[]
   655	    rotations: RotationView[]
   656	    busy: boolean
   657	    open: boolean
   658	    onOpen: (p: ProposalView) => void
   659	    onDismiss: (p: ProposalView) => void
   660	}) {
   661	    return (
   662	        <section aria-label={C.followUps} data-slot='harness-follow-ups' className='flex flex-col gap-2 rounded-[12px] border p-3' style={{ borderColor: 'var(--v2-rule)' }}>
   663	            <h2 className='text-[14px] font-semibold'>{C.followUps}</h2>
   664	            <p className='text-[12px]' style={{ color: 'var(--v2-soft)' }}>
   665	                {open ? C.followUpNote : C.followUpEnded}
   666	            </p>
   667	            <ul className='flex flex-col gap-2'>
   668	                {proposals.map((p) => {
   669	                    // A key rotation's hand-off says where the rotation stands (I7).
   670	                    const app = p.draft.kind === 'apiKeys' && p.draft.action === 'version' ? applicationOf(p) : null
   671	                    const rotation = app ? (rotations.find((r) => r.application === app) ?? null) : null
   672	                    const stateTone: VerdictTone = p.state === 'staged' ? 'info' : p.state === 'inReview' ? 'flagged' : 'allowed'
   673	                    return (
   674	                        <li key={p.id} data-slot='follow-up' data-kind={p.draft.kind} data-action={p.draft.action} data-state={p.state} className='flex flex-col gap-1 text-[13px]'>
   675	                            <span className='font-medium'>{p.summary}</span>
   676	                            {app ? (
   677	                                <span data-slot='follow-up-rotation' className='text-[12px]'>
   678	                                    {rotation ? (C.rotation[rotation.stage] ?? rotation.stage) : C.rotation.none}
   679	                                </span>
   680	                            ) : null}
   681	                            {p.state !== 'staged' ? <Verdict tone={stateTone} word={p.state === 'inReview' ? C.inReview : p.state === 'closed' ? C.closed : C.dismissed} /> : null}
   682	                            {open && (p.state === 'staged' || p.state === 'inReview') ? (
   683	                                <div className='flex flex-wrap gap-2'>
   684	                                    <button
   685	                                        type='button'
   686	                                        disabled={busy}
   687	                                        className='h-8 rounded-[7px] px-3 text-[13px] font-semibold disabled:opacity-60'
   688	                                        style={{ background: 'var(--v2-acc)', color: 'var(--v2-acc-ink)' }}
   689	                                        onClick={() => onOpen(p)}
   690	                                    >
   691	                                        {p.state === 'staged' ? C.openReview : C.goToReview}
   692	                                    </button>
   693	                                    {p.state === 'staged' ? (
   694	                                        <button type='button' disabled={busy} className='h-8 rounded-[7px] border px-3 text-[13px] disabled:opacity-60' style={{ borderColor: 'var(--v2-rule)' }} onClick={() => onDismiss(p)}>
   695	                                            {C.dismiss}
   696	                                        </button>
   697	                                    ) : null}
   698	                                </div>
   699	                            ) : null}
   700	                        </li>
   701	                    )
   702	                })}
   703	            </ul>
   704	        </section>
   705	    )
   706	}

