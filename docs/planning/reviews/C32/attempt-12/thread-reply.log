        const one = pushed(ready.entries, op('u-101', 'Claimed bound'))
        await native.push({ ...native.current, harness: { ...native.current.harness, conversation: { ...ready, entries: one } } })
        await native.push({ ...native.current, activeFeature: 'administration' })
        await native.push({ ...native.current, activeFeature: 'harness' })
        await waitFor(() => expect(screen.getByRole('textbox', { name: 'Message' })).toBeInTheDocument())
        expect(within(screen.getByRole('region', { name: 'Not confirmed' })).getByText('Claimed bound')).toBeInTheDocument()
        // A second entry, which nobody claims, settles the original, also past the bound.
        const two = pushed(one, answer('a-101', 'Done'), op('u-102', 'Claimed bound'))
        await native.push({ ...native.current, harness: { ...native.current.harness, conversation: { ...ready, entries: two } } })
        await waitFor(() => expect(screen.queryByRole('region', { name: 'Not confirmed' })).toBeNull())
        expect(native.dispatched.filter((i) => i.kind === 'sendHarness')).toHaveLength(3)
    })
})

