            return respond(intent)
        }
        await user.type(box(), 'Held retry')
        await user.click(screen.getByRole('button', { name: 'Send' }))
        await screen.findByRole('region', { name: 'Not confirmed' })
        // The retry is held; its entry appears; then its outcome is lost too.
        let release: () => void = () => undefined
        let held = true
        let retries = 0
        const dispatch = native.transport.dispatch
        native.transport.dispatch = async (bytes) => {
            const intent = (JSON.parse(new TextDecoder().decode(bytes)) as { intent: Intent }).intent
            if (intent.kind !== 'sendHarness') return dispatch(bytes)
            retries += 1
            if (held) {
                held = false
                await new Promise<void>((resolve) => (release = resolve))
            }
            throw new Error('lost')
        }
        await user.click(screen.getByRole('button', { name: 'Send' }))
        const one = { ...ready, entries: [...ready.entries, { id: 'u-9', role: 'operator' as const, text: 'Held retry', state: 'complete' as const }] }
        await native.push({ ...native.current, harness: { ...native.current.harness, conversation: one } })
        release()
        // The retry's outcome is lost (the client's one resend fails too).
        await waitFor(() => expect(retries).toBe(2))
        await new Promise((r) => setTimeout(r, 50))
        native.transport.dispatch = dispatch
        await waitFor(() => expect(within(screen.getByRole('region', { name: 'Not confirmed' })).getAllByText('Held retry')).toHaveLength(1))
        await native.push({ ...native.current, activeFeature: 'administration' })
