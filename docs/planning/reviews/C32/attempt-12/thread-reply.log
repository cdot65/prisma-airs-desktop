async function testBound(kind){
 resetShellStore();const text=kind+" delivery";
 const es=kind==="count"?full(text):[entry("u-1",text),entry("a-1","x".repeat(260000),"assistant"),entry("a-2","x".repeat(260000),"assistant"),entry("u-2","different"),entry("a-3","x".repeat(260000),"assistant"),entry("a-4","x".repeat(260000),"assistant")];
