 if(/features'"\\/harness\\/harness-view"'$/.test(request))return {HARNESS_FAILURE_TEXT:{},TURN_TEXT:{},conversationText:()=>""};
 for(const [name,exp] of [["history-panel","HistoryPanel"],["mcp-panel","McpPanel"],["project-panel","ProjectPanel"],["sign-in-panel","SignInPanel"]]){
 if(request.endsWith("/"+name))return {[exp]:()=>null,HISTORY_FAILURE_TEXT:{},SIGN_IN_FAILURE_TEXT:{},savedAt:String};
 }
 return original.apply(this,arguments)
};
