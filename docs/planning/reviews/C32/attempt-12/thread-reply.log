import { create } from 'zustand'

export type ToastKind = 'ok' | 'info' | 'warn'
import type { FeatureId, Intent, ManagementResource } from '@prisma-airs/desktop-contracts'

/** What a contextual action asked the destination to select on arrival (C30), owned by the tenant it was followed in (I2). */
export interface Arrival {
    tenant: string
    feature: FeatureId
    resource: ManagementResource | null
    /** The item to filter to, by name. */
    item: string | null
    /** Counts arrivals: a destination already open applies a new one. */
    sequence: number
}

/** A Harness message kept for the operator: refused or never sent, or not confirmed (C32). */
export interface HarnessKept {
    /** This record's own id: each attempt is its own record (C32). */
    id: number
    text: string
    unconfirmed: boolean
    /**
     * For an unconfirmed send: the conversation it was sent to and the IDs of
     * the operator messages it showed then. Entry IDs outlive the transcript's
     * eviction of its oldest entries, where a count would not (C32).
     */
    conversation?: string
    before?: string[]
}

/** An admitted Harness send awaiting its transcript entry (C32). */
export interface HarnessClaim {
    id: number
    conversation: string
    text: string
    /** The operator entry IDs the conversation showed when it was sent. */
    before: string[]
    /** Its send is still in flight: the entry is only held back, never used up, until the send is admitted (C32). */
    pending: boolean
}

/** A delivery the desktop did not confirm: kept until the operator retries or dismisses it (DESIGN-V2 §7). */
export interface Unconfirmed {
    id: number
    what: string
    intent: Intent
    /** The context the intent was bound to, if any: once that context retires, the delivery cannot be revived. */
    context: string | null
}

export interface Toast {
    id: number
    kind: ToastKind
    text: string
    /** An optional undo the toast offers (label + action). */
    undo?: { label: string; run: () => void }
    /** The tenant the toast speaks for (an item, a read): retired on leaving it (I2). */
    tenant: string | null
    /** The context it was raised under, when the action was context-bound: retired with it. */
    context: string | null
}

/**
 * Transient shell presentation state (state-ownership.md "UI"): what is open,
 * the palette query, toasts and the modal stack. Nothing here survives a
 * reload and nothing here is authority: every durable fact is observed from
 * the Rust snapshot.
 */
interface ShellStore {
    /** The scope the shell shows now (set from each snapshot before it renders): what a notification must belong to. */
    scope: { tenant: string | null; context: string | null }
    setScope(tenant: string | null, context: string | null): void
    paletteOpen: boolean
    switcherOpen: boolean
    toasts: Toast[]
    /** Open modal ids, bottom to top; only the last is interactive (I8). */
    modals: string[]
    /** The Inbox tab and item per tenant (I2: a switch round trip keeps it). */
    inboxSelection: Record<string, { tab: 'all' | 'action' | 'updates' | 'snoozed'; item: string | null }>
    selectInbox(tenant: string, selection: { tab: 'all' | 'action' | 'updates' | 'snoozed'; item: string | null }): void
    /** Harness drafts, by `tenant|workspace|conversation` (C32): kept across navigation and tenant round trips, never shared between scopes, never sent by themselves. */
    harnessDrafts: Record<string, string>
    setHarnessDraft(scope: string, text: string): void
    /** Per `tenant|workspace`: the operator chose a new investigation while one runs (C32). */
    harnessFresh: Record<string, boolean>
    setHarnessFresh(scope: string, fresh: boolean): void
    /**
     * Per `tenant|workspace`: messages kept for the operator (C32). `unconfirmed`
     * ones may have been delivered (the desktop did not confirm it); the others
     * were refused or never sent. Never sent by themselves.
     */
    harnessUnsent: Record<string, HarnessKept[]>
    keepHarnessUnsent(scope: string, kept: Omit<HarnessKept, 'id'>): void
    dropHarnessUnsent(scope: string, id: number): void
    /** Per `tenant|workspace`: transcript entries (`conversation|entry`) already used to settle a record; each settles one, once (C32). */
    harnessSettled: Record<string, string[]>
    /** Settles record `id` by transcript entry `entry`, atomically: the record goes and the entry is used up. */
    settleHarnessUnsent(scope: string, id: number, entry: string): void
    /**
     * Per `tenant|workspace`: admitted sends whose transcript entry is still to
     * come, kept only while an unconfirmed send of the same text awaits that
     * conversation: each claims its own entry before any uncertainty may (C32).
     */
    harnessClaims: Record<string, HarnessClaim[]>
    /** Records a claim and returns its id. */
    claimHarnessEntry(scope: string, claim: Omit<HarnessClaim, 'id'>): number
    /** Withdraws a claim whose send was not taken, or not confirmed. */
    dropHarnessClaim(scope: string, id: number): void
    /** The claim's send was admitted: its entry may now be used up. */
    confirmHarnessClaim(scope: string, id: number): void
    /** The claim `id` took transcript entry `entry`: both are used up. */
    consumeHarnessClaim(scope: string, id: number, entry: string): void
    /** The last contextual action's target, consumed by the destination it names. */
    arrival: Arrival | null
    arrive(target: Omit<Arrival, 'sequence'>): void
    /** Forgets an arrival that belongs to another tenant than `tenant`. */
    scopeArrival(tenant: string | null): void
    /** Drops unconfirmed deliveries bound to a context other than `context` (their authority retired). */
    retireUnconfirmed(context: string | null): void
    unconfirmed: Unconfirmed[]
    /** Toast lifetime in ms (6 s; tests shorten it). */
    toastMs: number
    addUnconfirmed(what: string, intent: Intent): number
    clearUnconfirmed(id: number): void
    openPalette(): void
    closePalette(): void
    setSwitcher(open: boolean): void
    toast(text: string, kind?: ToastKind, undo?: Toast['undo'], tenant?: string | null, context?: string | null): number
    /** Retires toasts that speak for another tenant than `tenant`. */
    retireToasts(tenant: string | null): void
    dismissToast(id: number): void
    pushModal(id: string): void
    popModal(id: string): void
}

let nextToast = 1
let nextKept = 1

export const useShellStore = create<ShellStore>((set, get) => ({
    scope: { tenant: null, context: null },
    setScope: (tenant, context) =>
        set((s) => ({
            scope: { tenant, context },
            // Leaving a scope retires what spoke for it, however late it would have arrived.
            toasts: s.toasts.filter((t) => (t.tenant === null || t.tenant === tenant) && (t.context === null || t.context === context)),
            unconfirmed: s.unconfirmed.filter((u) => u.context === null || u.context === context),
            arrival: s.arrival && s.arrival.tenant !== tenant ? null : s.arrival,
        })),
    paletteOpen: false,
    switcherOpen: false,
    toasts: [],
    modals: [],
    inboxSelection: {},
    selectInbox: (tenant, selection) => set((s) => ({ inboxSelection: { ...s.inboxSelection, [tenant]: selection } })),
    harnessDrafts: {},
    setHarnessDraft: (scope, text) => set((s) => ({ harnessDrafts: { ...s.harnessDrafts, [scope]: text } })),
    harnessFresh: {},
    setHarnessFresh: (scope, fresh) => set((s) => ({ harnessFresh: { ...s.harnessFresh, [scope]: fresh } })),
    harnessUnsent: {},
    keepHarnessUnsent: (scope, item) =>
        set((s) => {
            const kept = s.harnessUnsent[scope] ?? []
            const record = { ...item, id: nextKept++ }
            // An uncertain attempt is never removed or downgraded by a later one:
            // only its own conversation's transcript, or the operator, settles it.
            // A not-sent record of the same text is superseded by a later attempt;
            // not-sent records are kept once per text.
            const others = kept.filter((k) => k.unconfirmed || k.text !== item.text)
            return { harnessUnsent: { ...s.harnessUnsent, [scope]: [...others, record] } }
        }),
    dropHarnessUnsent: (scope, id) => set((s) => ({ harnessUnsent: { ...s.harnessUnsent, [scope]: (s.harnessUnsent[scope] ?? []).filter((k) => k.id !== id) } })),
    harnessClaims: {},
    claimHarnessEntry: (scope, claim) => {
        const id = nextKept++
        set((s) => ({ harnessClaims: { ...s.harnessClaims, [scope]: [...(s.harnessClaims[scope] ?? []), { ...claim, id }] } }))
        return id
    },
    dropHarnessClaim: (scope, id) => set((s) => ({ harnessClaims: { ...s.harnessClaims, [scope]: (s.harnessClaims[scope] ?? []).filter((c) => c.id !== id) } })),
    confirmHarnessClaim: (scope, id) =>
        set((s) => ({ harnessClaims: { ...s.harnessClaims, [scope]: (s.harnessClaims[scope] ?? []).map((c) => (c.id === id ? { ...c, pending: false } : c)) } })),
    consumeHarnessClaim: (scope, id, entry) =>
        set((s) => {
            const used = s.harnessSettled[scope] ?? []
            if (used.includes(entry)) return {}
            return {
                harnessClaims: { ...s.harnessClaims, [scope]: (s.harnessClaims[scope] ?? []).filter((c) => c.id !== id) },
                harnessSettled: { ...s.harnessSettled, [scope]: [...used, entry] },
            }
        }),
    harnessSettled: {},
    settleHarnessUnsent: (scope, id, entry) =>
        set((s) => {
            const used = s.harnessSettled[scope] ?? []
            if (used.includes(entry) || !(s.harnessUnsent[scope] ?? []).some((k) => k.id === id)) return {}
            return {
                harnessUnsent: { ...s.harnessUnsent, [scope]: (s.harnessUnsent[scope] ?? []).filter((k) => k.id !== id) },
                harnessSettled: { ...s.harnessSettled, [scope]: [...used, entry] },
            }
        }),
    arrival: null,
    arrive: (target) => set((s) => ({ arrival: { ...target, sequence: (s.arrival?.sequence ?? 0) + 1 } })),
    unconfirmed: [],
    toastMs: 6000,
    addUnconfirmed: (what, intent) => {
        const id = nextToast++
        const context = typeof (intent as { context?: unknown }).context === 'string' ? ((intent as { context: string }).context ?? null) : null
        // A delivery bound to a context the shell no longer shows is moot: never surfaced (I2).
        if (context !== null && context !== get().scope.context) return id
        set((s) => ({ unconfirmed: [...s.unconfirmed, { id, what, intent, context }] }))
        return id
    },
    scopeArrival: (tenant) => set((s) => (s.arrival && s.arrival.tenant !== tenant ? { arrival: null } : {})),
    retireUnconfirmed: (context) => set((s) => ({ unconfirmed: s.unconfirmed.filter((u) => u.context === null || u.context === context) })),
    clearUnconfirmed: (id) => set((s) => ({ unconfirmed: s.unconfirmed.filter((u) => u.id !== id) })),
    openPalette: () => set({ paletteOpen: true, switcherOpen: false }),
    closePalette: () => set({ paletteOpen: false }),
    setSwitcher: (open) => set({ switcherOpen: open, ...(open ? { paletteOpen: false } : {}) }),
    toast: (text, kind = 'ok', undo, tenant = null, context = null) => {
        const id = nextToast++
        // A toast for a tenant or context the shell no longer shows is never surfaced (I2).
        if (tenant !== null && tenant !== get().scope.tenant) return id
        if (context !== null && context !== get().scope.context) return id
        // One toast at a time: the newest replaces the rest (I10).
        set({ toasts: [{ id, kind, text, undo, tenant, context }] })
        return id
    },
    retireToasts: (tenant) => set((s) => ({ toasts: s.toasts.filter((t) => t.tenant === null || t.tenant === tenant) })),
    dismissToast: (id) => set((s) => ({ toasts: s.toasts.filter((t) => t.id !== id) })),
    pushModal: (id) => set((s) => ({ modals: s.modals.includes(id) ? s.modals : [...s.modals, id] })),
    popModal: (id) => set((s) => ({ modals: s.modals.filter((m) => m !== id) })),
}))

/** Test seam: forget everything (each test starts from an empty store). */
export function resetShellStore() {
    useShellStore.setState({ scope: { tenant: null, context: null }, paletteOpen: false, switcherOpen: false, toasts: [], modals: [], unconfirmed: [], toastMs: 6000, inboxSelection: {}, arrival: null, harnessDrafts: {}, harnessFresh: {}, harnessUnsent: {}, harnessSettled: {}, harnessClaims: {} })
}
import { forwardRef, useEffect, useRef, useState } from 'react'
import { CheckCircle2, Circle } from 'lucide-react'
import type { ConversationView, FeatureId, HarnessApproval, HarnessEntry, Intent, ProposalView, RotationView, ShellSnapshot } from '@prisma-airs/desktop-contracts'
import { HARNESS_FAILURE_TEXT, TURN_TEXT, conversationText } from '../../features/harness/harness-view'
import { HISTORY_FAILURE_TEXT, HistoryPanel, savedAt } from '../../features/harness/history-panel'
import { McpPanel } from '../../features/harness/mcp-panel'
import { ProjectPanel } from '../../features/harness/project-panel'
import { SIGN_IN_FAILURE_TEXT, SignInPanel } from '../../features/harness/sign-in-panel'
import { type Dispatch, type DispatchOutcome, outcomeMessage } from '../../features/tenants/dispatch'
import { type Arrival, type HarnessClaim, type HarnessKept, useShellStore } from '../store'
import { Verdict, type VerdictTone } from '../verdict'
import { HARNESS_COPY as C } from './copy'

export interface HarnessProps {
    snapshot: ShellSnapshot
    dispatch: Dispatch
    onNavigate: (feature: FeatureId) => void
    /** A contextual action that named a conversation (its saved transcript id). */
    arrival: Arrival | null
}

/** Where the composer's text belongs when it starts the next conversation. */
const NEXT = 'next'
const MAX_TITLE = 72

const titleOf = (entries: HarnessEntry[]) => {
    const first = entries.find((e) => e.role === 'operator')?.text.trim() ?? ''
    if (!first) return C.untitled
    return first.length > MAX_TITLE ? `${first.slice(0, MAX_TITLE - 1)}…` : first
}

const live = (c: ConversationView | null) => c !== null && c.phase !== 'ended' && c.phase !== 'failed'

/**
 * One send into a new conversation (C32, I12), by submission: the text sent
 * (trimmed), the box's text as submitted (only that revision is cleared),
 * and where it stands. `ending` waits for the current conversation to end
 * (a new investigation); `clearing` and `requesting` are under way and
 * never re-entered; `starting` waits for exactly the conversation the start
 * receipt named. Nothing is replayed: a refusal, a failure, an end or a
 * replacement retires it and its text stays recoverable.
 */
type Queued = { id: number; text: string; raw: string } & (
    | { stage: 'ending' | 'clearing' | 'requesting' }
    | { stage: 'starting'; operation: string; prior: string | null }
)

/**
 * The Harness in the new shell (C32, screens/harness.md): a re-skin of the
 * existing engine, sessions, decisions, history, sign-in, project and MCP
 * modules (C19–C22). The core classifies each decision: a desktop read is
 * read-only and decided in the page; a change (files, a command with
 * changes allowed, a remote MCP tool) is allowed only through the native
 * confirmation the core opens. A proposal only ever opens the operator's
 * review in Administration. One conversation runs at a time; each keeps its
 * transcript. A fresh tenant's first send starts a conversation (I12); a
 * pending decision blocks a tenant switch (I1, the core's guard).
 *
 * The composer is one box per tenant and workspace (by its stable ID): it
 * survives navigation, tenant round trips and a conversation's retirement.
 * A message that reaches no conversation is kept in the "Not sent" list of
 * that scope, with "Put it in the box", unless the box still holds it;
 * nothing is ever sent by itself.
 */
export const Harness = forwardRef<HTMLHeadingElement, HarnessProps>(function Harness({ snapshot, dispatch, onNavigate, arrival }, ref) {
    const context = snapshot.active?.context ?? null
    const tenant = snapshot.tenants.find((t) => t.id === snapshot.active?.tenant) ?? null
    const selected = snapshot.gateway.selected
    const engine = snapshot.harness.engine
    const conversation = snapshot.harness.conversation
    const history = snapshot.harness.history
    const signIn = snapshot.harness.signIn
    const key = tenant?.inference
    const keyHere = key?.state === 'ready' && selected !== null && key.target?.workspace.id === selected.workspace.id
    const signInHere = signIn !== null && selected !== null && signIn.workspace.id === selected.workspace.id && signIn.selected
    const credentialReady = signInHere ? signIn.account !== null : keyHere
    const checklist: [string, boolean, { label: string; go: FeatureId } | null][] = [
        [C.tenant, tenant !== null, { label: C.openSettings, go: 'settings' }],
        [C.management, tenant?.management.state === 'ready', { label: C.openSettings, go: 'settings' }],
        [C.workspace, selected !== null, { label: C.chooseWorkspace, go: 'administration' }],
        [C.credential, credentialReady, { label: C.openSettings, go: 'settings' }],
    ]
    const ready = engine.available && context !== null && checklist.every(([, ok]) => ok)

    const [problem, setProblem] = useState<string | null>(null)
    const [busy, setBusy] = useState(false)
    const [setupOpen, setSetupOpen] = useState(false)
    const composer = useRef<HTMLTextAreaElement>(null)
    const running = live(conversation)
    // The conversation that runs now, if one does.
    const current = running ? conversation : null
    const scope = `${tenant?.id ?? '-'}|${selected?.workspace.id ?? '-'}`
    const draft = useShellStore((s) => s.harnessDrafts[scope] ?? '')
    const kept = useShellStore((s) => s.harnessUnsent[scope])
    const unsentKept = kept ?? []
    const fresh = useShellStore((s) => s.harnessFresh[scope] ?? false) && current !== null
    const box = () => useShellStore.getState().harnessDrafts[scope] ?? ''
    const setDraft = (text: string) => useShellStore.getState().setHarnessDraft(scope, text)
    const setFresh = (on: boolean) => useShellStore.getState().setHarnessFresh(scope, on)
    /** Keeps a message the core did not take, unless the box still holds it; says which. */
    const recover = (text: string): 'inBox' | 'kept' => {
        if (box().includes(text)) return 'inBox'
        useShellStore.getState().keepHarnessUnsent(scope, { text, unconfirmed: false })
        return 'kept'
    }
    /**
     * A message whose delivery the desktop did not confirm: it may have been
     * delivered. It is listed under "Not confirmed" (never "not sent") until
     * the transcript shows it; nothing is resent.
     */
    const uncertain = (text: string, conversation: string, before: string[]) => {
        useShellStore.getState().keepHarnessUnsent(scope, { text, unconfirmed: true, conversation, before })
        setProblem(C.unconfirmedSend)
    }
    /**
     * A send competing with an unconfirmed send of the same text to the same
     * conversation claims its own transcript entry before it is dispatched,
     * so an entry it produces can never settle the earlier attempt, whichever
     * arrives first (its entry or its receipt). Withdrawn if the send is not
     * taken, or not confirmed (it is then uncertain itself); kept if admitted.
     */
    const claimIfCompeting = (text: string, conversation: string, before: string[]): number | null => {
        const competing = (useShellStore.getState().harnessUnsent[scope] ?? []).some((k) => k.unconfirmed && k.conversation === conversation && k.text.trim() === text.trim())
        return competing ? useShellStore.getState().claimHarnessEntry(scope, { conversation, text, before, pending: true }) : null
    }
    const withdrawClaim = (claim: number | null) => {
        if (claim !== null) useShellStore.getState().dropHarnessClaim(scope, claim)
    }
    const confirmClaim = (claim: number | null) => {
        if (claim !== null) useShellStore.getState().confirmHarnessClaim(scope, claim)
    }
    /**
     * The operator messages a conversation shows (the baseline an unconfirmed
     * send is judged against), by entry ID: the core drops its oldest entries
     * past its bounds, so a count or a position would not stay comparable.
     */
    const operatorIds = (c: ConversationView | null) => (c ? c.entries.filter((e) => e.role === 'operator').map((e) => e.id) : [])
    const pendingDecision = current !== null && current.approvals.length > 0

    // The submission in flight: a ref for completions, state for the page.
    const queuedRef = useRef<Queued | null>(null)
    const [queued, setQueuedState] = useState<Queued | null>(null)
    const setQueued = (q: Queued | null) => {
        queuedRef.current = q
        setQueuedState(q)
    }
    const submissions = useRef(0)
    const stillQueued = (q: Queued) => queuedRef.current?.id === q.id

    async function run(intent: Intent): Promise<DispatchOutcome> {
        setProblem(null)
        setBusy(true)
        try {
            const outcome = await dispatch(intent)
            if (outcome.kind !== 'admitted') setProblem(outcomeMessage(outcome) ?? C.failed)
            return outcome
        } finally {
            setBusy(false)
        }
    }

    /** Retires a submission: nothing is sent; its text stays in the box or in "Not sent". */
    function retire(q: Queued, why: (where: 'inBox' | 'kept') => string, keepProblem = false) {
        if (!stillQueued(q)) return
        setQueued(null)
        setFresh(false)
        const where = recover(q.text)
        setProblem((p) => (keepProblem && p ? `${p} ${why(where)}` : why(where)))
    }

    // The saved conversations of the chosen workspace are listed once per workspace.
    const listed = useRef<string | null>(null)
    useEffect(() => {
        if (!context || !selected || listed.current === selected.reference) return
        listed.current = selected.reference
        void dispatch({ kind: 'listHarnessHistory', context, workspace: selected.reference })
    }, [context, selected, dispatch])

    // A message given back by the core (a failed renewal, changes not allowed
    // again) fills an empty box; otherwise it is kept in "Not sent" beside the
    // operator's draft. Nothing is resent (R4).
    const unsent = conversation?.unsent ?? null
    const [restored, setRestored] = useState<string | null>(null)
    useEffect(() => {
        if (unsent === null) return
        if (!box()) {
            setDraft(unsent)
            setRestored(unsent)
        } else if (!box().includes(unsent)) {
            useShellStore.getState().keepHarnessUnsent(scope, { text: unsent, unconfirmed: false })
        }
        // eslint-disable-next-line react-hooks/exhaustive-deps -- once per returned message
    }, [unsent, conversation?.id])

    /** Starts the next conversation for submission `q` (its stage already `clearing`): clears an ended one first. */
    async function begin(q: Queued, prior: ConversationView | null) {
        if (!context || !selected || !ready) return retire(q, (w) => C.notStarted[w])
        if (prior && !live(prior)) {
            const cleared = await run({ kind: 'clearHarness', conversation: prior.id })
            if (!stillQueued(q)) return
            if (cleared.kind !== 'admitted') return retire(q, (w) => (cleared.kind === 'unknown' ? C.unconfirmedStep[w] : C.notStarted[w]), true)
        }
        setQueued({ ...q, stage: 'requesting' })
        const started = await run({ kind: 'startHarness', context, workspace: selected.reference })
        if (!stillQueued(q)) return
        if (started.kind === 'admitted' && started.operation) setQueued({ id: q.id, text: q.text, raw: q.raw, stage: 'starting', operation: started.operation, prior: prior?.id ?? null })
        // Not confirmed: a conversation may have started; the message was not sent to it.
        else retire(q, (w) => (started.kind === 'unknown' ? C.unconfirmedStep[w] : C.notStarted[w]), true)
    }

    // The submission follows exactly its conversation (R2–R4).
    useEffect(() => {
        const q = queuedRef.current
        if (!q) return
        if (q.stage === 'ending') {
            if (live(conversation)) return
            // Advanced before anything asynchronous: a later snapshot never starts twice.
            const next: Queued = { id: q.id, text: q.text, raw: q.raw, stage: 'clearing' }
            setQueued(next)
            void begin(next, conversation)
            return
        }
        if (q.stage !== 'starting') return
        // The conversation it replaces may still be shown until the next snapshot.
        if (conversation && conversation.id === q.prior) return
        if (!conversation) return
        if (conversation.id !== q.operation) return retire(q, (w) => C.replaced[w])
        if (conversation.phase === 'failed') return retire(q, (w) => C.startFailed[w])
        if (conversation.phase === 'ended' || conversation.phase === 'ending') return retire(q, (w) => C.endedBeforeReady[w])
        if (conversation.phase !== 'ready') return
        setQueued(null)
        const before = operatorIds(conversation)
        const claim = claimIfCompeting(q.text, conversation.id, before)
        void run({ kind: 'sendHarness', conversation: conversation.id, prompt: q.text }).then((outcome) => {
            setFresh(false)
            if (outcome.kind !== 'admitted') withdrawClaim(claim)
            else confirmClaim(claim)
            if (outcome.kind === 'admitted') {
                // Only the submitted revision is cleared: later edits stay (R3).
                if (box() === q.raw) setDraft('')
            } else if (outcome.kind === 'unknown') {
                uncertain(q.text, conversation.id, before)
            } else {
                const where = recover(q.text)
                setProblem((p) => `${p ?? C.failed} ${C.notSent[where]}`)
            }
        })
        // eslint-disable-next-line react-hooks/exhaustive-deps -- driven by the observed conversation
    }, [queued, conversation?.id, conversation?.phase])

    // A message not confirmed is reconciled with what the core shows: once the
    // transcript holds it, it was delivered; it leaves the list, and the box
    // if it still holds exactly that text (R2).
    // Only an operator message the same conversation added after the send counts
    // (one it did not show then, by entry ID: never a position, which shifts
    // when the core drops its oldest entries),
    // and each such message settles one record: an older identical message, or
    // another conversation's, settles nothing (R1).
    // Entries used once stay used, across renders and remounts (the store keeps them).
    const settledEntries = useShellStore((s) => s.harnessSettled[scope])
    const claims = useShellStore((s) => s.harnessClaims[scope])
    const operators = (conversation?.entries ?? []).filter((e) => e.role === 'operator')
    const delivered: { record: HarnessKept; entry: string }[] = []
    const claimed: { claim: HarnessClaim; entry: string }[] = []
    const used = new Set(settledEntries ?? [])
    // Admitted sends take their own entries first: an identical uncertain send
    // never settles from a retry's entry; it waits for one nobody else claims.
    for (const c of claims ?? []) {
        if (conversation === null || c.conversation !== conversation.id) continue
        const at = operators.findIndex((e) => !c.before.includes(e.id) && !used.has(`${conversation.id}|${e.id}`) && e.text.trim() === c.text.trim())
        if (at < 0) continue
        const entry = `${conversation.id}|${operators[at]!.id}`
        used.add(entry)
        // While its send is in flight the entry is only held back from the
        // uncertain records; it is used up once the send is admitted.
        if (!c.pending) claimed.push({ claim: c, entry })
    }
    for (const k of kept ?? []) {
        if (!k.unconfirmed || conversation === null || k.conversation !== conversation.id) continue
        const at = operators.findIndex((e) => !(k.before ?? []).includes(e.id) && !used.has(`${conversation.id}|${e.id}`) && e.text.trim() === k.text.trim())
        if (at < 0) continue
        const entry = `${conversation.id}|${operators[at]!.id}`
        used.add(entry)
        delivered.push({ record: k, entry })
    }
    useEffect(() => {
        for (const { claim, entry } of claimed) useShellStore.getState().consumeHarnessClaim(scope, claim.id, entry)
        if (delivered.length === 0) return
        for (const { record, entry } of delivered) {
            useShellStore.getState().settleHarnessUnsent(scope, record.id, entry)
            if (box().trim() === record.text.trim() && !(useShellStore.getState().harnessUnsent[scope] ?? []).some((k) => k.text === record.text)) setDraft('')
        }
        setProblem((p) => (p === C.unconfirmedSend ? null : p))
        // eslint-disable-next-line react-hooks/exhaustive-deps -- when the transcript shows them
    }, [[...claimed.map((c) => `c${c.claim.id}:${c.entry}`), ...delivered.map((d) => `${d.record.id}:${d.entry}`)].join(',')])

    // An ended conversation is confirmed once by a toast bound to its tenant
    // and context (I2, I10): it persists under Reduce Motion until dismissed.
    const endedSeen = useRef<string | null>(null)
    useEffect(() => {
        if (!conversation || conversation.phase !== 'ended' || endedSeen.current === conversation.id) return
        endedSeen.current = conversation.id
        const saved = conversation.savedAt !== null && conversation.saveFailure === null
        useShellStore.getState().toast(saved ? C.endedToastSaved(conversation.historyId.slice(0, 8)) : C.endedToast, 'info', undefined, tenant?.id ?? null, context)
        // eslint-disable-next-line react-hooks/exhaustive-deps -- once per ended conversation
    }, [conversation?.id, conversation?.phase])

    async function send() {
        const raw = draft
        const text = raw.trim()
        if (!text || busy || queuedRef.current) return
        if (current && !fresh) {
            if (current.phase !== 'ready') return
            // The box is cleared only once the core took the message, and only
            // if it still holds what was sent (R2, R3).
            // Judged later only against operator messages added after this point (R1).
            const before = operatorIds(current)
            const claim = claimIfCompeting(text, current.id, before)
            const outcome = await run({ kind: 'sendHarness', conversation: current.id, prompt: text })
            if (outcome.kind === 'admitted') {
                confirmClaim(claim)
                if (box() === raw) setDraft('')
            } else if (outcome.kind === 'unknown') {
                withdrawClaim(claim)
                uncertain(text, current.id, before)
            } else {
                // Refused or never delivered: the exact text stays, beside any later edit (R1).
                withdrawClaim(claim)
                const where = recover(text)
                setProblem((p) => `${p ?? C.failed} ${C.notSent[where]}`)

