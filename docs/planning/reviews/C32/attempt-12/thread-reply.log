const entry=(id,text,role="operator")=>({id,text,role,state:"complete"});
const full=text=>Array.from({length:200},(_,i)=>i%2?entry("u-"+((i+1)/2)+"/a","answer","assistant"):entry("u-"+(i/2+1),i===118?text:"question"));
const push=(xs,...es)=>{const a=[...xs];for(const e of es){a.push(e);while(a.length>200||a.reduce((n,e)=>n+Buffer.byteLength(e.text),0)>1048576)a.shift()}return a};
