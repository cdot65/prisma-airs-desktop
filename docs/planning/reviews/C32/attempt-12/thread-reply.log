        expect(within(screen.getByRole('region', { name: 'Not confirmed' })).getAllByText('Held retry')).toHaveLength(1)
        // The original once (with its client resend) and the retry once: nothing replayed.
        expect(native.dispatched.filter((i) => i.kind === 'sendHarness')).toHaveLength(2)
        expect(retries).toBe(2)
    })

