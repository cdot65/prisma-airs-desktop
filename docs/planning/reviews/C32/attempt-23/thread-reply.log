{"type":"item.completed","item":{"id":"item_87","type":"command_execution","command":"/bin/zsh -lc 'cat resources/harness/pin.json apps/desktop/academy-source.ts apps/desktop/src-tauri/Cargo.toml apps/desktop/src-tauri/capabilities/main.json'","aggregated_output":"{\n  \"archive\": \"resources/harness/darwin-arm64.tar.gz\",\n  \"archiveBytes\": 113497192,\n  \"archiveSha256\": \"10729706be0bf2ec2bae1d21155fe866b047960e73881583397887c083fce173\",\n  \"binarySha256\": \"383bcfb5f8d36d2367793a594ceeaf89a5c0fd618d6436397e9c2e22a682c1c5\",\n  \"engineCommit\": \"9331a5839bc6a763d94dee7584746f58bbbe1181\",\n  \"executable\": \"airs-harness\",\n  \"files\": 1618,\n  \"protocol\": \"airs-desktop/1\",\n  \"resourcesSha256\": \"1c0a1eb83c82ffe4b2dc22f8ec4c6bc6a61fecc326ca70969de9c14ca62b3ac4\",\n  \"runtimeVersion\": \"0.1.7-desktop.2\",\n  \"signing\": {\n    \"identity\": \"Developer ID Application: Calvin Remsburg (G5QLZ5A8TA)\",\n    \"options\": \"runtime\",\n    \"signedUtc\": \"2026-10-25T21:23:45Z\",\n    \"teamIdentifier\": \"G5QLZ5A8TA\",\n    \"timestamp\": true,\n    \"unsignedBinarySha256\": \"f8e49cee8b0905818c9271e91b2ca8f39b67075e602e5db7db683f9d37aee50c\"\n  },\n  \"source\": {\n    \"buildInfoSha256\": \"a22d963e7bedf212c3190ef78ebc4d885e99cac87e87a53ed297f694b692cbc6\",\n    \"v1Archive\": \"packaging/harness/darwin-arm64.tar.gz\",\n    \"v1ArchiveSha256\": \"e79f564a5210241488a49c4756ff061dff3d336e23709f5fb7adfd4bde0928aa\",\n    \"v1Commit\": \"74754c02b19d87187b6dca81f64550a669b0f841\"\n  },\n  \"version\": 1\n}\n/**\n * Academy learner source compiled into the desktop (C05). The learner\n * package (@ai-security-academy/learner) exports Academy's own pages; their\n * `@/` imports are Academy's source in the prepared, hash-verified input\n * (.work/academy, xtask shared-prepare). Every bare import that source makes\n * resolves to this app's pinned copy (`dedupe`), so one React, one React\n * Query and one router instance exist and versions follow the desktop lock.\n */\n// A file-system path without Node typings in the app's tsconfig (the\n// repository path has no characters that URL-encode other than these).\nexport const ACADEMY_SRC = decodeURIComponent(new URL('../../.work/academy/src', import.meta.url).pathname)\nconst CONTRACTS_ROOT = decodeURIComponent(new URL('../../packages/desktop-contracts/', import.meta.url).pathname)\n\n// node_modules may be shared with another worktree. Compile this checkout's IPC parser and bindings,\n// not the workspace package reached through that other checkout's dependency symlink.\nexport const desktopAliases = [\n    { find: /^@prisma-airs\\/desktop-contracts$/, replacement: `${CONTRACTS_ROOT}src/index.ts` },\n    { find: /^@prisma-airs\\/desktop-contracts\\/fixtures\\//, replacement: `${CONTRACTS_ROOT}fixtures/` },\n    { find: /^@\\//, replacement: `${ACADEMY_SRC}/` },\n]\n\nexport const academyDedupe = [\n    'react',\n    'react-dom',\n    '@ai-security-academy/presentation',\n    '@ai-security-academy/shared',\n    '@codemirror/commands',\n    '@codemirror/lang-python',\n    '@codemirror/lang-yaml',\n    '@codemirror/language',\n    '@codemirror/state',\n    '@codemirror/view',\n    '@dnd-kit/core',\n    '@excalidraw/excalidraw',\n    '@lezer/highlight',\n    '@radix-ui/react-dialog',\n    '@radix-ui/react-slot',\n    '@tanstack/react-query',\n    '@tanstack/react-router',\n    '@trpc/client',\n    '@trpc/react-query',\n    '@trpc/server',\n    'class-variance-authority',\n    'clsx',\n    'dompurify',\n    'lucide-react',\n    'mermaid',\n    'qrcode.react',\n    'sanitize-html',\n    'tailwind-merge',\n    'zustand',\n]\n[package]\nname = \"desktop-host\"\nversion = \"2.0.0\"\ndescription = \"Prisma AIRS Desktop v2 native host: window/origin admission and OS adapters\"\nedition.workspace = true\nrust-version.workspace = true\nlicense.workspace = true\npublish.workspace = true\ndefault-run = \"prisma-airs-desktop-v2\"\n\n[lib]\nname = \"desktop_host\"\npath = \"src/lib.rs\"\n\n[[bin]]\nname = \"prisma-airs-desktop-v2\"\npath = \"src/main.rs\"\n\n[features]\ndefault = []\n# Distinct fixture identity and the Tauri mock runtime for admission tests.\n# Never enabled by the shipping artifact build.\ntest-fixtures = [\n    \"desktop-core/test-fixtures\",\n    \"tauri/test\",\n    \"dep:objc2-web-kit\",\n]\n\n[build-dependencies]\ntauri-build = { version = \"=2.7.3\", default-features = false, features = [\"config-json\"] }\n\n[dependencies]\ndesktop-core = { path = \"../../../crates/desktop-core\" }\nurl = \"=2.5.8\"\ntauri = { version = \"=2.12.4\", default-features = false, features = [\"wry\", \"common-controls-v6\", \"compression\"] }\nserde.workspace = true\nserde_json.workspace = true\ntokio = { workspace = true, features = [\"sync\", \"macros\", \"rt\", \"time\"] }\nfutures-util = { version = \"=0.3.34\", default-features = false, features = [\"std\"] }\nzeroize = { version = \"=1.9.1\", features = [\"std\"] }\ngetrandom = \"=0.4.3\"\n\n# Classic login Keychain credential adapter (DESIGN \"protected storage\") and\n# the native file sheet for profile import.\n[target.'cfg(target_os = \"macos\")'.dependencies.security-framework]\nversion = \"=3.7.0\"\n[target.'cfg(target_os = \"macos\")'.dependencies.security-framework-sys]\nversion = \"=2.17.0\"\n[target.'cfg(target_os = \"macos\")'.dependencies.core-foundation]\nversion = \"=0.10.1\"\n[target.'cfg(target_os = \"macos\")'.dependencies.rfd]\nversion = \"=0.17.2\"\ndefault-features = false\n\n# AppKit: the native operator confirmation and one-time secret sheets and\n# the clipboard (C09, D035); fixture-only WebView self-capture (WebKit).\n[target.'cfg(target_os = \"macos\")'.dependencies]\nobjc2 = { version = \"=0.6.5\" }\nobjc2-foundation = { version = \"=0.3.2\", default-features = false, features = [\"std\", \"NSData\", \"NSDictionary\", \"NSError\", \"NSString\", \"NSGeometry\", \"NSNotification\", \"NSOperation\", \"block2\"] }\nobjc2-app-kit = { version = \"=0.3.2\", default-features = false, features = [\"std\", \"NSImage\", \"NSImageRep\", \"NSBitmapImageRep\", \"NSAlert\", \"NSApplication\", \"NSButton\", \"NSControl\", \"NSResponder\", \"NSView\", \"NSWindow\", \"NSTextField\", \"NSPasteboard\", \"NSWorkspace\", \"block2\"] }\nobjc2-web-kit = { version = \"=0.3.2\", optional = true, default-features = false, features = [\"std\", \"WKWebView\", \"WKSnapshotConfiguration\", \"block2\", \"objc2-app-kit\"] }\nblock2 = { version = \"=0.6.2\" }\n# The Harness sidecar's process group and exit observed without reaping\n# (C19; already locked through tokio and Tauri).\nlibc = \"=0.2.191\"\n\n[dev-dependencies]\ntokio = { workspace = true, features = [\"sync\", \"macros\", \"rt\", \"rt-multi-thread\", \"net\", \"io-util\", \"time\"] }\ngetrandom = \"=0.4.3\"\n# The synthetic Academy endpoint for browser_callback (same pins as desktop-core).\nrcgen = { version = \"=0.14.10\", default-features = false, features = [\"aws_lc_rs\", \"pem\"] }\nrustls = { version = \"=0.23.46\", default-features = false, features = [\"aws_lc_rs\", \"std\", \"tls12\"] }\ntokio-rustls = { version = \"=0.26.6\", default-features = false, features = [\"aws_lc_rs\", \"tls12\"] }\ntime = \"=0.3.55\"\n# The synthetic OpenID provider for browser_callback (C20; same pins as\n# desktop-core).\njsonwebtoken = { version = \"=11.1.0\", default-features = false, features = [\"aws_lc_rs\"] }\nbase64 = \"=0.22.1\"\nsha2.workspace = true\n\n[lints]\nworkspace = true\n\n# Host admission tests use Tauri's mock runtime, available only with fixtures.\n[[test]]\nname = \"ipc_admission\"\nrequired-features = [\"test-fixtures\"]\n\n[[test]]\nname = \"permission_manifest\"\nrequired-features = [\"test-fixtures\"]\n\n[[test]]\nname = \"keychain_access\"\nrequired-features = [\"test-fixtures\"]\n\n[[test]]\nname = \"browser_callback\"\nrequired-features = [\"test-fixtures\"]\n\n[[test]]\nname = \"native_confirmation\"\nrequired-features = [\"test-fixtures\"]\n\n[[test]]\nname = \"clipboard_secret\"\nrequired-features = [\"test-fixtures\"]\n\n[[test]]\nname = \"sidecar_supervision\"\nrequired-features = [\"test-fixtures\"]\n\n[[test]]\nname = \"renderer_review_lifecycle\"\nrequired-features = [\"test-fixtures\"]\n{\n  \"$schema\": \"../gen/schemas/desktop-schema.json\",\n  \"identifier\": \"main-window\",\n  \"description\": \"The packaged main window may call only the two application commands.\",\n  \"local\": true,\n  \"windows\": [\"main\"],\n  \"webviews\": [\"main\"],\n  \"permissions\": [\"allow-desktop-dispatch\", \"allow-desktop-observe\"]\n}\n","exit_code":0,"status":"completed"}}
