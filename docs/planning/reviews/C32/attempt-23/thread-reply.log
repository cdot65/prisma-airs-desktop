{"type":"item.completed","item":{"id":"item_47","type":"command_execution","command":"/bin/zsh -lc \"sed -n '900,1020p' crates/desktop-core/src/authority/harness_domain.rs\"","aggregated_output":"        Ok(())\n    }\n\n    /// The conversation's task returned.\n    pub(super) fn harness_settled(&mut self, id: &OperationId, outcome: Outcome) {\n        if let Some(c) = self.harness.as_mut().filter(|c| &c.id == id) {\n            c.ended = Some(outcome);\n            // Ended without being asked to and without failing: its\n            // eight-hour bound passed.\n            let failed = c\n                .progress\n                .lock()\n                .map(|p| p.failure.is_some())\n                .unwrap_or(true);\n            if c.stop.is_none() && !c.retired && !failed {\n                c.stop = Some(HarnessStop::Deadline);\n            }\n            if c.retired {\n                self.harness = None;\n            }\n        }\n    }\n\n    /// Whether the conversation still belongs to the active context, the\n    /// chosen workspace and the key it was started with.\n    fn harness_bound(&self, c: &Conversation) -> bool {\n        let Some(tenant) = self.tenant(&c.tenant) else {\n            return false;\n        };\n        // The credential chosen for its workspace now, and its identity.\n        let sign_in = tenant\n            .harness_sign_in\n            .as_ref()\n            .filter(|s| s.selected && s.target.workspace.id == c.workspace.id);\n        let credential_ok = match (&c.grant, sign_in) {\n            (Some(grant), Some(s)) => s\n                .grant\n                .as_ref()\n                .is_some_and(|g| g.id == grant.id && s.target.endpoint == c.endpoint),\n            (None, None) => matches!(\n                &tenant.inference,\n                ScanCapability::Ready { record, .. } if Some(record) == c.record.as_ref()\n            ),\n            _ => false,\n        };\n        // The project and its access as selected now (C21).\n        let project = tenant.harness_project.as_ref();\n        let project_ok = project.map(|p| &p.path) == c.project.as_ref()\n            && project.is_some_and(|p| p.write) == c.write;\n        // Its MCP servers: still on, with the same sign-ins and revisions\n        // (C22). An expired sign-in alone keeps it, and so does a catalog\n        // that is loading or could not be read (nothing remote runs then).\n        let mcp_ok = self.mcp_scope_check(&c.tenant, &c.workspace.id, &c.mcp)\n            != super::harness_mcp::ScopeCheck::Changed;\n        !c.retired\n            && credential_ok\n            && project_ok\n            && mcp_ok\n            && Some(&c.context) == self.active_ref.as_ref()\n            && self.workspace_current(Some(&c.reference))\n    }\n\n    /// Retires a conversation that is no longer bound (run on every change).\n    pub(super) fn sync_harness(&mut self) {\n        // A confirmation whose decision is gone is ended (C32).\n        self.retire_harness_confirmation();\n        let bound = self.harness.as_ref().is_some_and(|c| self.harness_bound(c));\n        let Some(c) = self.harness.as_mut() else {\n            return;\n        };\n        if !bound {\n            c.retired = true;\n            c.cancel.cancel();\n            if c.ended.is_some() {\n                self.harness = None;\n            }\n        }\n    }\n\n    #[cfg(feature = \"test-fixtures\")]\n    pub(super) fn harness_pid(&self) -> Option<u32> {\n        self.harness.as_ref()?.progress.lock().ok()?.pid\n    }\n\n    /// Whether a conversation's task has not returned yet (quit waits).\n    pub(super) fn harness_running(&self) -> bool {\n        self.harness.as_ref().is_some_and(|c| c.ended.is_none())\n    }\n\n    pub(super) fn harness_view(&self, adapters_engine: bool) -> HarnessView {\n        let pin = engine::pin();\n        let current_review = self.change_review_id();\n        let conversation = self\n            .harness\n            .as_ref()\n            .filter(|c| self.harness_bound(c))\n            .and_then(|c| {\n                let p = c.progress.lock().ok()?.clone();\n                let phase = match (c.ended, p.phase) {\n                    // Shown as ending until the task has returned.\n                    (None, HarnessPhase::Ended | HarnessPhase::Failed) => HarnessPhase::Ending,\n                    (None, _) if c.stop.is_some() => HarnessPhase::Ending,\n                    (_, phase) => phase,\n                };\n                Some(ConversationView {\n                    id: c.id.clone(),\n                    workspace: c.workspace.clone(),\n                    endpoint: c.endpoint.clone(),\n                    phase,\n                    failure: p.failure,\n                    stop: c.stop,\n                    entries: p.entries,\n                    last_turn: p.last_turn,\n                    usage: p.usage,\n                    cleanup: p.cleanup,\n                    runtime_version: p.runtime_version,\n                    source: c.source,\n                    history_id: c.history_id.clone(),\n                    saved_at: p.saved_at,\n                    save_failure: p.save_failure,\n                    unsent: c.unsent.clone(),\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_48","type":"command_execution","command":"/bin/zsh -lc 'cat docs/planning/evidence/P09/native-controller/run-p09-native-c32.py docs/planning/evidence/P09/native-controller/native_requirements.py'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_48","type":"command_execution","command":"/bin/zsh -lc 'cat docs/planning/evidence/P09/native-controller/run-p09-native-c32.py docs/planning/evidence/P09/native-controller/native_requirements.py'","aggregated_output":"\"\"\"Redirect a retained native driver to P09 evidence without changing checks.\n\nRun in the approved GUI context only. The legacy adapter and assertion-level\nrequirements are the same ones C44 used. Every record must name the exact P09\nprepared executable; raw records keep their original generated attribution.\n\"\"\"\nfrom pathlib import Path\nimport datetime\nimport hashlib\nimport importlib\nimport json\nimport os\nimport platform\nimport shutil\nimport subprocess\nimport sys\n\nROOT = Path.cwd().resolve()\nTOOLS = ROOT / 'tools/native-acceptance'\nsys.path.insert(0, str(TOOLS))\nsys.path.insert(0, str(Path(__file__).resolve().parent))\nfrom native_requirements import load_requirements, assess_record\n\n\ndef main():\n    which = sys.argv[1]\n    assert which in ['c03','c04','c05','c06','c07','c10','c11','c24','c31','c32',*[f'c{i}' for i in range(35,45)]]\n    legacy = len(sys.argv) > 2 and sys.argv[2] == 'legacy'\n    chunk = which.upper()\n    phase = ROOT / 'docs/planning/evidence/P09'\n    prepared = json.loads((phase / 'native-prepare.json').read_text())\n    exe = ROOT / prepared['bundle'] / 'Contents/MacOS/prisma-airs-desktop-v2'\n    assert hashlib.sha256(exe.read_bytes()).hexdigest() == prepared['executable_sha256']\n    out = phase if chunk == 'C44' else phase / 'native/cumulative' / chunk\n    out.mkdir(parents=True, exist_ok=True)\n    record = out / 'native-acceptance.json'\n    assert not record.exists(), 'preserve earlier native records; archive explicitly before retry'\n    if chunk != 'C44':\n        shutil.copy2(phase / 'native-prepare.json', out / 'native-prepare.json')\n    if legacy:\n        importlib.import_module('legacy_v2')\n    driver_name = 'acceptance_c32_current' if chunk == 'C32' else f'acceptance_{which}'\n    if chunk == 'C32':\n        assert not legacy, 'C32 current driver uses the actual current presentation'\n        os.environ['AIRS_C32_EVIDENCE'] = str(out.relative_to(ROOT))\n    mod = importlib.import_module(driver_name)\n    original = str(mod.EVIDENCE)\n    # Only relocate evidence paths. Do not alter driver assertions, flows,\n    # timeouts, result values, provenance strings or the system capture folder.\n    for name in ['EVIDENCE', 'NATIVE', 'RECORD', 'PARITY']:\n        if hasattr(mod, name):\n            value = getattr(mod, name)\n            assert value == original or value.startswith(original + os.sep)\n            setattr(mod, name, str(out) + value[len(original):])\n    c29 = importlib.import_module('acceptance_c29')\n    c29.NATIVE = mod.NATIVE\n    if '--dry-run' in sys.argv[2:]:\n        required = load_requirements(ROOT)[chunk]\n        print(json.dumps({'subject':chunk,'mode':'paths only; no UI or driver execution',\n                          'evidence':str(out),'required_checks':sorted(required),\n                          'executable_sha256':prepared['executable_sha256']}))\n        return 0\n    started = datetime.datetime.now(datetime.timezone.utc).isoformat()\n    os.environ['AIRS_NATIVE_ORCHESTRATOR'] = 'Codex'\n    code = mod.main()\n    raw = json.loads(record.read_text())\n    errors, carried = assess_record(raw, ROOT, prepared['executable_sha256'], load_requirements(ROOT)[chunk])\n    execution = {'schema':'airs-v2/p09-native-execution/1','phase':'P09','driver_subject':chunk,\n                 'orchestrator':'Codex','started_utc':started,\n                 'finished_utc':datetime.datetime.now(datetime.timezone.utc).isoformat(),\n                 'source_root':str(ROOT),'source_head':subprocess.check_output(['git','rev-parse','HEAD'],text=True).strip(),\n                 'os':platform.platform(),'driver_return_code':code,\n                 'executable_sha256':prepared['executable_sha256'],\n                 'raw_record_sha256':hashlib.sha256(record.read_bytes()).hexdigest(),\n                 'controller_sha256':hashlib.sha256(Path(__file__).read_bytes()).hexdigest(),\n                 'requirements_sha256':hashlib.sha256(Path(__file__).with_name('native_requirements.py').read_bytes()).hexdigest(),\n                 'driver_sha256':hashlib.sha256((TOOLS / (driver_name + '.py')).read_bytes()).hexdigest(),\n                 'required_check_errors':errors,'superseded_raw_checks':carried,\n                 'adaptation':'evidence paths relocated to P09; no assertion or result changes',\n                 'raw_attribution':'driver-generated performed_by retained; C43 reads the actual orchestrator from AIRS_NATIVE_ORCHESTRATOR'}\n    (out / 'execution.json').write_text(json.dumps(execution,indent=2)+'\\n')\n    print(json.dumps({'subject':chunk,'required_pass':not errors,'errors':errors,'carried':carried}))\n    return 1 if errors else 0\n\n\nif __name__ == '__main__':\n    raise SystemExit(main())\n\"\"\"Read the C44 gate's existing assertion map without changing its requirements.\"\"\"\nimport json\nimport re\nimport runpy\n\n\ndef load_requirements(root):\n    manifest = json.loads((root / 'docs/architecture/native-checks.json').read_text())['chunks']\n    data = runpy.run_path(str(root / 'tools/native-acceptance/legacy_assertions.py'))\n    assertions = data['ASSERTIONS']\n    legacy_ids = {c['id'] for chunk, checks in manifest.items()\n                  if re.fullmatch(r'C(0[1-9]|1\\d|2\\d|3[0-3])', chunk) for c in checks}\n    assert legacy_ids == set(assertions), 'legacy map differs from the full manifest'\n    targets = {t for kind, ts, _ in assertions.values()\n               if kind in (data['X'], data['S'], data['P']) for t in ts}\n    self_run = {lid.split('-')[0] for lid, (kind, _, _) in assertions.items() if kind == data['S']}\n    required = {chunk: {t for t in targets if t.startswith(chunk + '-')} for chunk in self_run}\n    # Some legacy ids are carried by a different self-run driver. Only drivers with actual targets run;\n    # the union check below still requires every mapped target to be covered.\n    required = {chunk: checks for chunk, checks in required.items() if checks}\n    for chunk in [f'C{i}' for i in range(35, 45)]:\n        required[chunk] = {c['id'] for c in manifest[chunk]}\n    assert all(required.values()), 'empty required native check set'\n    assert targets <= set().union(*required.values()), 'mapped native target has no driver'\n    return required\n\n\ndef assess_record(record, root, executable_sha256, required):\n    errors = []\n    if record.get('app', {}).get('executable_sha256') != executable_sha256:\n        errors.append('stale executable')\n    checks = {c['id']: c for c in record.get('checks', [])}\n    for cid in sorted(required):\n        check = checks.get(cid)\n        if check is None:\n            errors.append(cid + ' missing')\n        elif check['result'] != 'pass':\n            errors.append(cid + ' ' + check['result'])\n        else:\n            errors.extend(cid + ' missing evidence: ' + e for e in check['evidence'] if not (root / e).exists())\n    carried_elsewhere = [cid for cid, c in checks.items() if cid not in required and c['result'] != 'pass']\n    return errors, carried_elsewhere\n","exit_code":0,"status":"completed"}}
