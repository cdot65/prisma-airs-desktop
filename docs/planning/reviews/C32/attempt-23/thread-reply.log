{"type":"item.completed","item":{"id":"item_81","type":"command_execution","command":"/bin/zsh -lc 'cat apps/desktop/src/v2/harness/panels/project.tsx apps/desktop/src/v2/harness/panels/mcp.tsx'","aggregated_output":"import { useId, useState } from 'react'\nimport type { ContextRef, HarnessProjectView } from '@prisma-airs/desktop-contracts'\nimport type { Dispatch } from '../../../features/tenants/dispatch'\nimport { actionOutcomeText } from '../text'\nimport { Btn } from './controls'\n\ninterface Props {\n    context: ContextRef\n    project: HarnessProjectView | null\n    /** A folder just refused as the project. */\n    refused: string | null\n    /** A conversation is running (changing the project or access ends it). */\n    running: boolean\n    dispatch: Dispatch\n    onMessage: (message: string | null) => void\n}\n\nconst REFUSED = 'Folders that hold system files, credentials or this app’s own data cannot be used.'\nconst CHECK = 'Check the folder and the permission shown here before trying again.'\n\n/**\n * The folder the Harness works in (C21, D048), as a v2 panel (C38): chosen\n * in the native folder sheet, read-only unless the operator allows changes.\n * Every command and file change still waits for the operator's approval,\n * and the engine's sandbox keeps both inside the folder.\n */\nexport function ProjectPanel({ context, project, refused, running, dispatch, onMessage }: Props) {\n    const ids = useId()\n    const [busy, setBusy] = useState(false)\n\n    // An unknown delivery stays Not confirmed naming the action (the change may have applied; the folder and\n    // its permission shown here are the state to reconcile with); a refusal says its own reason.\n    async function send(intent: Parameters<Dispatch>[0], action: string) {\n        onMessage(null)\n        setBusy(true)\n        try {\n            onMessage(actionOutcomeText(await dispatch(intent), action, CHECK))\n        } finally {\n            setBusy(false)\n        }\n    }\n\n    return (\n        <section aria-labelledby={`${ids}-heading`} className='flex flex-col gap-2 rounded-[12px] border p-3' style={{ borderColor: 'var(--v2-rule)' }} data-slot='harness-project'>\n            <h2 id={`${ids}-heading`} className='text-[13px] font-bold'>\n                Project folder\n            </h2>\n            {project ? (\n                <>\n                    <p className='font-mono text-[12px] break-all' data-slot='harness-project-path'>\n                        {project.path}\n                    </p>\n                    <label className='flex items-start gap-2 text-[13px]'>\n                        <input\n                            type='checkbox'\n                            className='mt-[3px] size-4 min-h-0'\n                            checked={project.write}\n                            disabled={busy}\n                            aria-describedby={`${ids}-write`}\n                            onChange={(event) =>\n                                void send({ kind: 'setHarnessWrite', context, write: event.target.checked }, event.target.checked ? 'allowing changes in this folder' : 'making this folder read-only')\n                            }\n                        />\n                        Allow changes in this folder\n                    </label>\n                    <p id={`${ids}-write`} className='text-[12px]' style={{ color: 'var(--v2-faint)' }}>\n                        {project.write\n                            ? 'The Harness may ask to run commands and change files here. Each waits for your approval and stays inside this folder.'\n                            : 'Read-only: the Harness may ask to run commands here, each with your approval, but cannot change anything.'}\n                    </p>\n                </>\n            ) : (\n                <p className='text-[13px]' style={{ color: 'var(--v2-faint)' }}>\n                    No folder. The Harness can use this app’s own read tools and propose changes for your review, but cannot run commands.\n                </p>\n            )}\n            {refused ? (\n                <p role='alert' className='text-[13px] break-all' style={{ color: 'var(--v2-flag)' }} data-slot='harness-project-refused'>\n                    {`${refused} cannot be used. ${REFUSED}`}\n                </p>\n            ) : null}\n            {running ? (\n                <p className='text-[12px]' style={{ color: 'var(--v2-faint)' }}>\n                    Changing the folder or its access ends the running conversation.\n                </p>\n            ) : null}\n            <div className='flex flex-wrap gap-2'>\n                <Btn disabled={busy} onClick={() => void send({ kind: 'chooseHarnessProject', context }, 'choosing a folder')}>\n                    {project ? 'Choose another folder…' : 'Choose a folder…'}\n                </Btn>\n                {project ? (\n                    <Btn tier='tertiary' disabled={busy} onClick={() => void send({ kind: 'clearHarnessProject', context }, 'removing the folder')}>\n                        Remove folder\n                    </Btn>\n                ) : null}\n            </div>\n        </section>\n    )\n}\nimport { useEffect, useId, useState } from 'react'\nimport type { ContextRef, HarnessMcpView, McpServerView, Refusal, SelectedWorkspace } from '@prisma-airs/desktop-contracts'\nimport { MANAGEMENT_FAILURE_TEXT } from '../../../features/administration/management-read'\nimport type { Dispatch } from '../../../features/tenants/dispatch'\nimport { MCP_MAX_ON, MCP_SIGN_IN_FAILURE_TEXT, MCP_STEP_TEXT, actionOutcomeText } from '../text'\nimport { Btn } from './controls'\n\nfunction standing(s: McpServerView): string {\n    if (!s.supported) return 'This server’s identifier is not one the Harness engine accepts; it cannot be used.'\n    if (s.expired) return MCP_SIGN_IN_FAILURE_TEXT[s.expired]\n    if (s.stale) return 'Signed in for an earlier version of this server. Sign in again to use it.'\n    if (s.signedIn) return 'Signed in.'\n    return 'Not signed in: its tools will be unavailable until you sign in.'\n}\n\n/** The aside's one-line standing (R2App's \"Signed in\" column). */\nexport function mcpStanding(s: McpServerView): { word: string; tone: 'ok' | 'flag' | 'faint' } {\n    if (!s.supported) return { word: 'Not usable', tone: 'faint' }\n    if (s.expired) return { word: 'Sign-in expired', tone: 'flag' }\n    if (s.stale) return { word: 'Sign in again', tone: 'flag' }\n    if (s.signedIn) return { word: 'Signed in', tone: 'ok' }\n    return { word: 'Not signed in', tone: 'faint' }\n}\n\ninterface Props {\n    context: ContextRef\n    selected: SelectedWorkspace\n    mcp: HarnessMcpView | null\n    /** A conversation is running (changing its servers ends it). */\n    running: boolean\n    dispatch: Dispatch\n    onMessage: (message: string | null) => void\n}\n\nconst faint = { color: 'var(--v2-faint)' }\n\n/**\n * The chosen workspace's MCP servers (C22, D049), as a v2 panel (C38): read\n * from its Gateway catalog, turned on for new conversations (at most\n * eight), each signed in to in the browser by this app. The engine only\n * ever gets each server's token in memory, and asks before every tool call.\n */\nconst CHECK = 'Check the servers shown here before trying again.'\n\n// The panel's own wording only for the refusals whose meaning this action fixes (crates/desktop-core/src/authority/\n// harness_mcp.rs): turning a server on is refused as invalidInput when it is not a supported catalog server and as busy\n// at the eight-server bound; starting a sign-in is refused as invalidInput for an unknown server and as busy while\n// another sign-in is in progress. Every other refusal (storage denied or locked, a retired context, …) keeps its own\n// reason and recovery, and turning a server off has no special wording (attempt-03 R1).\nconst ENABLE_REFUSED: Partial<Record<Refusal, string>> = {\n    invalidInput: 'That was not done. Only servers in this workspace’s catalog that the engine accepts can be turned on.',\n    busy: 'That was not done. At most eight servers can be on.',\n}\nconst SIGN_IN_REFUSED: Partial<Record<Refusal, string>> = {\n    invalidInput: 'Sign-in could not start. The server is not in this workspace’s catalog.',\n    busy: 'Sign-in could not start. Another sign-in is in progress.',\n}\n\nexport function McpPanel({ context, selected, mcp, running, dispatch, onMessage }: Props) {\n    const ids = useId()\n    const [busy, setBusy] = useState(false)\n    const workspace = selected.reference\n    const here = mcp !== null && mcp.workspace === selected.workspace.id\n\n    // Read the catalog whenever the chosen workspace changes.\n    useEffect(() => {\n        void dispatch({ kind: 'listMcpServers', context, workspace })\n    }, [dispatch, context, workspace])\n\n    // An unknown delivery stays Not confirmed naming the action (a sign-out or a change of which servers are on\n    // may have happened; the catalog shown here is the state to reconcile with); a refusal says this panel's\n    // reason for that refusal kind when the action fixes its meaning, else the refusal's own.\n    async function send(intent: Parameters<Dispatch>[0], action: string, refused?: Partial<Record<Refusal, string>>) {\n        onMessage(null)\n        setBusy(true)\n        try {\n            onMessage(actionOutcomeText(await dispatch(intent), action, CHECK, (refusal) => refused?.[refusal]))\n        } finally {\n            setBusy(false)\n        }\n    }\n\n    const servers = here ? mcp.servers : []\n    const on = servers.filter((s) => s.enabled).length\n    const signingIn = servers.some((s) => s.step !== null)\n    return (\n        <section aria-labelledby={`${ids}-heading`} className='flex flex-col gap-2 rounded-[12px] border p-3' style={{ borderColor: 'var(--v2-rule)' }} data-slot='harness-mcp'>\n            <h2 id={`${ids}-heading`} className='text-[13px] font-bold'>\n                Workspace MCP servers\n            </h2>\n            <p className='text-[12px]' style={faint}>\n                Servers published in this workspace’s AI Gateway. The Harness asks you before every tool call, and each server’s sign-in stays with this app.\n            </p>\n            {!here || mcp.state === 'loading' ? (\n                <p role='status' className='text-[13px]'>\n                    Reading the workspace’s MCP servers…\n                </p>\n            ) : null}\n            {here && mcp.failure ? (\n                <p role='alert' className='text-[13px]' style={{ color: 'var(--v2-flag)' }}>\n                    {`The MCP servers could not be read: ${MANAGEMENT_FAILURE_TEXT[mcp.failure]}`}\n                </p>\n            ) : null}\n            {here && mcp.state !== 'loading' && servers.length === 0 && !mcp.failure ? <p className='text-[13px]'>No MCP servers are published in this workspace.</p> : null}\n            {here && !mcp.complete && servers.length > 0 ? (\n                <p className='text-[12px]' style={faint}>\n                    Only the first 500 servers are shown.\n                </p>\n            ) : null}\n            {servers.length > 0 ? (\n                <ul role='list' aria-label='MCP servers' className='flex flex-col gap-2'>\n                    {servers.map((s) => {\n                        const holdsSignIn = s.signedIn || s.stale || s.expired !== null\n                        return (\n                            <li key={s.id} className='rounded-[8px] border p-2' style={{ borderColor: 'var(--v2-rule)' }} data-slot='harness-mcp-server'>\n                                <label className='flex items-start gap-2 text-[13px] font-semibold'>\n                                    <input\n                                        type='checkbox'\n                                        className='mt-[3px] size-4 min-h-0'\n                                        checked={s.enabled}\n                                        disabled={busy || !s.supported || (!s.enabled && on >= MCP_MAX_ON)}\n                                        aria-describedby={`${ids}-${s.id}-standing`}\n                                        onChange={(event) =>\n                                            void send(\n                                                { kind: 'enableMcpServer', context, workspace, server: s.id, enabled: event.target.checked },\n                                                event.target.checked ? `turning ${s.name} on` : `turning ${s.name} off`,\n                                                event.target.checked ? ENABLE_REFUSED : undefined\n                                            )\n                                        }\n                                    />\n                                    {`Use ${s.name} in new conversations`}\n                                </label>\n                                <p className='font-mono text-[11px] break-all'>{`${s.namespace} · ${s.url}`}</p>\n                                <p id={`${ids}-${s.id}-standing`} className='text-[12px]'>\n                                    {standing(s)}\n                                </p>\n                                {s.step ? (\n                                    <p role='status' className='text-[12px]'>\n                                        {MCP_STEP_TEXT[s.step]}\n                                    </p>\n                                ) : null}\n                                {s.failure ? (\n                                    <p role='alert' className='text-[12px]' style={{ color: 'var(--v2-flag)' }}>\n                                        {MCP_SIGN_IN_FAILURE_TEXT[s.failure]}\n                                    </p>\n                                ) : null}\n                                <div className='mt-1 flex flex-wrap gap-2'>\n                                    {s.step ? (\n                                        <Btn tier='tertiary' onClick={() => void send({ kind: 'cancelMcpSignIn', context }, 'cancelling the sign-in')}>\n                                            Cancel sign-in\n                                        </Btn>\n                                    ) : (\n                                        <Btn\n                                            disabled={busy || !s.supported || signingIn}\n                                            onClick={() => void send({ kind: 'signInMcpServer', context, workspace, server: s.id }, `starting the sign-in to ${s.name}`, SIGN_IN_REFUSED)}\n                                        >\n                                            {holdsSignIn ? `Sign in to ${s.name} again` : `Sign in to ${s.name}`}\n                                        </Btn>\n                                    )}\n                                    {holdsSignIn ? (\n                                        <Btn tier='tertiary' disabled={busy} onClick={() => void send({ kind: 'signOutMcpServer', context, workspace, server: s.id }, `signing out of ${s.name}`)}>\n                                            {`Sign out of ${s.name}`}\n                                        </Btn>\n                                    ) : null}\n                                </div>\n                            </li>\n                        )\n                    })}\n                </ul>\n            ) : null}\n            {running ? (\n                <p className='text-[12px]' style={faint}>\n                    Turning a server off, signing in again or signing out ends the running conversation that uses it.\n                </p>\n            ) : null}\n            <Btn tier='tertiary' className='self-start' disabled={here && mcp.state === 'loading'} onClick={() => void send({ kind: 'listMcpServers', context, workspace }, 'reading the servers')}>\n                Read the servers again\n            </Btn>\n        </section>\n    )\n}\n","exit_code":0,"status":"completed"}}
