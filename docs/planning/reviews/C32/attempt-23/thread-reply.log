{"type":"item.completed","item":{"id":"item_59","type":"command_execution","command":"/bin/zsh -lc \"rg -n 'submission|send_harness|end_harness|clear_harness|harness_live|sync_harness|start_harness' crates/desktop-core/src/authority/harness_domain.rs crates/desktop-core/src/harness/session.rs crates/desktop-core/src/harness.rs crates/desktop-core/src/delivery.rs\"","aggregated_output":"crates/desktop-core/src/authority/harness_domain.rs:81:    submissions: std::collections::VecDeque<Taken>,\ncrates/desktop-core/src/authority/harness_domain.rs:165:            .submissions\ncrates/desktop-core/src/authority/harness_domain.rs:282:    pub submissions: Vec<TakenSubmission>,\ncrates/desktop-core/src/authority/harness_domain.rs:290:    pub submission: String,\ncrates/desktop-core/src/authority/harness_domain.rs:313:    submission: String,\ncrates/desktop-core/src/authority/harness_domain.rs:323:fn is_submission(s: &str) -> bool {\ncrates/desktop-core/src/authority/harness_domain.rs:359:    pub(super) fn start_harness(\ncrates/desktop-core/src/authority/harness_domain.rs:539:            submissions: std::collections::VecDeque::new(),\ncrates/desktop-core/src/authority/harness_domain.rs:599:    pub(super) fn harness_live(&mut self, id: &OperationId) -> Result<&mut Conversation, Refusal> {\ncrates/desktop-core/src/authority/harness_domain.rs:622:    pub(super) fn send_harness(\ncrates/desktop-core/src/authority/harness_domain.rs:626:        submission: Option<String>,\ncrates/desktop-core/src/authority/harness_domain.rs:632:        if submission.as_deref().is_some_and(|s| !is_submission(s)) {\ncrates/desktop-core/src/authority/harness_domain.rs:640:                    let s = submission.as_ref()?;\ncrates/desktop-core/src/authority/harness_domain.rs:641:                    c.submissions.iter().find(|t| &t.submission == s)\ncrates/desktop-core/src/authority/harness_domain.rs:685:        if let Some(submission) = submission {\ncrates/desktop-core/src/authority/harness_domain.rs:686:            conversation.submissions.push_back(Taken {\ncrates/desktop-core/src/authority/harness_domain.rs:687:                submission,\ncrates/desktop-core/src/authority/harness_domain.rs:691:            if conversation.submissions.len() > MAX_SUBMISSIONS {\ncrates/desktop-core/src/authority/harness_domain.rs:692:                conversation.submissions.pop_front();\ncrates/desktop-core/src/authority/harness_domain.rs:863:    pub(super) fn end_harness(&mut self, id: &OperationId) -> Result<(), Refusal> {\ncrates/desktop-core/src/authority/harness_domain.rs:891:    pub(super) fn clear_harness(&mut self, id: &OperationId) -> Result<(), Refusal> {\ncrates/desktop-core/src/authority/harness_domain.rs:963:    pub(super) fn sync_harness(&mut self) {\ncrates/desktop-core/src/authority/harness_domain.rs:1027:                    submissions: c\ncrates/desktop-core/src/authority/harness_domain.rs:1028:                        .submissions\ncrates/desktop-core/src/authority/harness_domain.rs:1031:                            submission: t.submission.clone(),\n","exit_code":0,"status":"completed"}}
