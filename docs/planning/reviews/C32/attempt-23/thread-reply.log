{"type":"item.completed","item":{"id":"item_55","type":"command_execution","command":"/bin/zsh -lc 'cat tools/native-acceptance/c32_coverage.py tools/native-acceptance/test_c32_coverage.py'","aggregated_output":"\"\"\"Mandatory C32 native facts; absent facts never count as coverage.\"\"\"\nBOOLEAN_FACTS = {\n    'n2': ('project', 'asked', 'names_call', 'guard_switcher', 'guard_isolated', 'guard_focus_returned', 'guard_page_back', 'guard_palette', 'guard_menu', 'still_tenant_a', 'decision_kept', 'declined', 'approved', 'may_change_shown', 'native_sheet', 'refused_kept_pending', 'ran_after_native'),\n    'n3': ('read_asked', 'read_only_shown', 'read_done', 'staged', 'review', 'proposed_title', 'apply_gated', 'closed', 'ended', 'rail_ended', 'ended_announced', 'engine_gone', 'new_conversation'),\n    'n4': ('send_reached',),\n}\nMOTION = ('active', 'harness_ready', 'answered', 'toast', 'persists', 'dismissed', 'restored')\n\n\ndef problems(obs):\n    errors = []\n    for group, fields in BOOLEAN_FACTS.items():\n        for field in fields:\n            if obs.get(group, {}).get(field) is not True:\n                errors.append(group + '.' + field)\n    n2, n3, n4 = (obs.get(n, {}) for n in ('n2', 'n3', 'n4'))\n    if n2.get('guard_initial_focus') != 'Stay': errors.append('guard initial focus')\n    if set(n2.get('guard_buttons', [])) != {'Stay', 'Discard and switch', 'Archive and switch'}: errors.append('guard buttons')\n    for field in ('writes_after_staging', 'writes_after_review'):\n        if n3.get(field) != 0: errors.append(field)\n    for field in MOTION:\n        if n4.get('reduce_motion', {}).get(field) is not True: errors.append('reduce_motion.' + field)\n    zoom = n4.get('zoom', {})\n    for theme in ('light', 'dark'):\n        row = zoom.get(theme, {})\n        if row.get('overflow_px') != 0 or row.get('horizontal_scrollbars') != 0: errors.append('layout.' + theme)\n    ring = n4.get('ring', {})\n    if ring.get('focused') != 'New investigation' or ring.get('diff', 0) <= 150: errors.append('new investigation focus ring')\n    return errors\nimport copy\nimport runpy\nimport unittest\nfrom pathlib import Path\nfrom c32_coverage import BOOLEAN_FACTS, MOTION, problems\n\n\ndef complete():\n    o = {g: {f: True for f in fs} for g, fs in BOOLEAN_FACTS.items()}\n    o['n2'].update(guard_initial_focus='Stay', guard_buttons=['Stay', 'Discard and switch', 'Archive and switch'])\n    o['n3'].update(writes_after_staging=0, writes_after_review=0)\n    o['n4'].update(reduce_motion={f: True for f in MOTION}, zoom={t: {'overflow_px': 0, 'horizontal_scrollbars': 0} for t in ('light', 'dark')}, ring={'focused': 'New investigation', 'diff': 200})\n    return o\n\n\nclass Coverage(unittest.TestCase):\n    def test_complete(self): self.assertEqual(problems(complete()), [])\n    def test_every_missing_or_false_fact_rejected(self):\n        for g, fs in BOOLEAN_FACTS.items():\n            for f in fs:\n                for value in (None, False):\n                    with self.subTest(group=g, fact=f, value=value):\n                        o=complete(); o[g][f]=value; self.assertTrue(problems(o))\n    def test_motion_each_required(self):\n        for f in MOTION:\n            o=complete();del o['n4']['reduce_motion'][f];self.assertTrue(problems(o))\n    def test_guard_layout_ring_and_write_negative(self):\n        for group, field, value in [('n2','guard_initial_focus',''),('n2','guard_buttons',[]),('n3','writes_after_review',1),('n3','writes_after_staging',None),('n4','zoom',{}),('n4','ring',{})]:\n            o=complete();o[group][field]=value;self.assertTrue(problems(o))\n    def test_native_mapping_requires_original_assertions(self):\n        a=runpy.run_path(str(Path(__file__).with_name('legacy_assertions.py')))['ASSERTIONS']\n        for n in ('02','03','04'):\n            cid='C32-N'+n\n            self.assertIn(cid,a[cid][1])\n\nif __name__ == '__main__': unittest.main()\n","exit_code":0,"status":"completed"}}
