t-22/new-green-02.log\ndocs/planning/evidence/C32/remediation-attempt-22/fmt.log\ndocs/planning/evidence/C32/remediation-attempt-22/python-syntax.log\ndocs/planning/evidence/C32/remediation-attempt-22/bindings.json\ndocs/planning/evidence/P09/native/cumulative/C32/native-prepare.json\ndocs/planning/reviews/C32/attempt-23/thread-reply.log\ndocs/planning/reviews/C32/attempt-23/message.txt\ndocs/planning/reviews/C32/attempt-23/invocation.json\ndocs/planning/reviews/C32/attempt-23/source-inventory.json\ndocs/planning/reviews/C32/attempt-23/feature-probe.log\ndocs/planning/reviews/C32/attempt-23/request.json\ndocs/planning/reviews/C32/attempt-23/diff.patch\ndocs/adr/0002-academy-shared-presentation.md\ndocs/adr/0001-native-operation-authority.md\ndocs/adr/0004-managed-workbench-admission.md\ndocs/adr/0003-native-harness-and-scoped-identity.md\ndocs/planning/evidence/P09/native/cumulative/C32/native/tree-harness-first-send.json\ndocs/planning/evidence/P09/native/cumulative/C32/native/tree-guard-switcher.json\ndocs/planning/evidence/P09/native/cumulative/C32/native/tree-harness-min-200-light.json\ndocs/planning/evidence/P09/native/cumulative/C32/native/observations.json\ndocs/planning/evidence/P09/native/cumulative/C32/native/tree-harness-follow-up.json\ndocs/planning/evidence/P09/native/cumulative/C32/native/tree-harness-may-change.json\ndocs/planning/evidence/P09/native/cumulative/C32/native/tree-harness-min-200-dark.json\ndocs/planning/evidence/P09/native/cumulative/C32/native/tree-harness-decision.json\ndocs/planning/evidence/P09/native/cumulative/C32/native/tree-harness-reduce-motion-toast.json\ndocs/planning/evidence/P09/native/cumulative/C32/native/tree-harness-review.json\ndocs/planning/evidence/P09/native/cumulative/C32/native/tree-harness-desktop-read.json\ndocs/planning/evidence/P09/native/cumulative/C32/native/checkpoint.json\ndocs/planning/evidence/P09/native/cumulative/C32/native/tree-harness-empty.json\ndocs/planning/evidence/P09/native/cumulative/C32/native/tree-harness-ended.json\ndocs/planning/evidence/P09/native/cumulative/C32/native/tree-harness-approved.json\ndocs/planning/evidence/P09/native/cumulative/C32/native/captures/harness-ring-plain.png\ndocs/planning/evidence/P09/native/cumulative/C32/native/captures/harness-min-200-light.png\ndocs/planning/evidence/P09/native/cumulative/C32/native/captures/harness-empty-dark-100.png\ndocs/planning/evidence/P09/native/cumulative/C32/native/captures/harness-decision-light-100.png\ndocs/planning/evidence/P09/native/cumulative/C32/native/captures/harness-follow-up-light-100.png\ndocs/planning/evidence/P09/native/cumulative/C32/native/captures/harness-empty-light-100.png\ndocs/planning/evidence/P09/native/cumulative/C32/native/captures/harness-first-dark-200.png\ndocs/planning/evidence/P09/native/cumulative/C32/native/captures/harness-empty-dark-200.png\ndocs/planning/evidence/P09/native/cumulative/C32/native/captures/harness-decision-light-200.png\ndocs/planning/evidence/P09/native/cumulative/C32/native/captures/harness-follow-up-light-200.png\ndocs/planning/evidence/P09/native/cumulative/C32/native/captures/harness-empty-light-200.png\ndocs/planning/evidence/P09/native/cumulative/C32/native/captures/harness-first-dark-100.png\ndocs/planning/evidence/P09/native/cumulative/C32/native/captures/harness-reduce-motion-toast.png\ndocs/planning/evidence/P09/native/cumulative/C32/native/captures/harness-decision-dark-100.png\ndocs/planning/evidence/P09/native/cumulative/C32/native/captures/harness-min-200-dark.png\ndocs/planning/evidence/P09/native/cumulative/C32/native/captures/harness-follow-up-dark-100.png\ndocs/planning/evidence/P09/native/cumulative/C32/native/captures/harness-first-light-200.png\ndocs/planning/evidence/P09/native/cumulative/C32/native/captures/harness-ended-dark-100.png\ndocs/planning/evidence/P09/native/cumulative/C32/native/captures/harness-ring-new.png\ndocs/planning/evidence/P09/native/cumulative/C32/native/captures/harness-ended-light-100.png\ndocs/plan