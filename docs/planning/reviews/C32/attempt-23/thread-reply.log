d_flags\"]); print(\"predecessor bindings\",[(p[\"subject\"],all(sha(p[k])==p[k+\"_sha256\"] if k in [\"request\",\"receipt\",\"audit\"] else sha(p[k])==p[\"sha256\"] for k in [\"record\",\"request\",\"receipt\",\"audit\"])) for p in req[\"predecessors\"]])'\"'\"","aggregated_output":"source a096e88586886ddac06cce87333362ff52e7874cc27e8b1ba971a607f2c27be9 matches True files 8242 drift []\nevidence 6626c9b8111bab16cb6700e6e66b2391eba4de77e53556cb49889c2cc04f5c70 True\nlogs 18 drift []\ndependencies b35a8d04c49e040dd8cc5b69a1825fbfaa21962b0fac55b64147e1206aed5628 matches True members 18348 drift []\nafter b35a8d04c49e040dd8cc5b69a1825fbfaa21962b0fac55b64147e1206aed5628\nbuild_flags 166488b352224eb230ddfca178064d76f43deecbb6c73fb6d9359f56632e1a1f matches True\npredecessor bindings [('C31', True)]\n","exit_code":0,"status":"completed"}}
