+assert not out.exists(),'preserve prior post-check audits'
+sha=lambda p:hashlib.sha256(Path(p).read_bytes()).hexdigest()
+assert len(r['runs'])==18
+for name,run in r['runs'].items():
+    assert run['exit']==0,name
