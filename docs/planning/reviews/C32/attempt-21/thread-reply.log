{"type":"item.completed","item":{"id":"item_35","type":"command_execution","command":"/bin/zsh -lc 'cat crates/desktop-core/src/presentation.rs\n git diff e825c2f69cbcd19387142b80481faaad84690a07 HEAD -- apps/desktop/src-tauri/src/native_confirmation.rs crates/desktop-core/src/delivery.rs crates/desktop-core/src/authority/change_domain.rs | head -290'","aggregated_output":"//! Native-only revocable ownership carried from admission to presentation.\nuse std::sync::{\n    Arc,\n    atomic::{AtomicBool, Ordering},\n};\n\n/// A native callback may present or copy only while its original owner lives.\n/// This token is never a wire value, persisted record or mutation authority.\n#[derive(Clone, Debug)]\npub struct PresentationLease(Arc<AtomicBool>);\nimpl Default for PresentationLease {\n    fn default() -> Self {\n        Self(Arc::new(AtomicBool::new(true)))\n    }\n}\nimpl PresentationLease {\n    pub fn is_current(&self) -> bool {\n        self.0.load(Ordering::Acquire)\n    }\n    pub(crate) fn revoke(&self) {\n        self.0.store(false, Ordering::Release);\n    }\n}\n#[derive(Debug, Default)]\npub(crate) struct PresentationOwner(PresentationLease);\nimpl PresentationOwner {\n    pub(crate) fn lease(&self) -> PresentationLease {\n        self.0.clone()\n    }\n    pub(crate) fn revoke(&self) {\n        self.0.revoke();\n    }\n}\nimpl Drop for PresentationOwner {\n    fn drop(&mut self) {\n        self.revoke();\n    }\n}\n\n/// Fixture-only pause after real admission releases its lock, before a native\n/// presentation effect runs. It adds no IPC route and never pauses ordinary work.\n#[cfg(any(test, feature = \"test-fixtures\"))]\n#[derive(Default)]\npub struct PresentationGate {\n    entered: AtomicBool,\n    released: std::sync::Mutex<bool>,\n    wake: std::sync::Condvar,\n}\n#[cfg(any(test, feature = \"test-fixtures\"))]\nimpl PresentationGate {\n    pub fn entered(&self) -> bool {\n        self.entered.load(Ordering::Acquire)\n    }\n    pub fn release(&self) {\n        if let Ok(mut go) = self.released.lock() {\n            *go = true;\n            self.wake.notify_all();\n        }\n    }\n    pub(crate) fn pause(&self) {\n        self.entered.store(true, Ordering::Release);\n        if let Ok(go) = self.released.lock() {\n            // A broken fixture cannot strand the process after an assertion.\n            let _ = self\n                .wake\n                .wait_timeout_while(go, std::time::Duration::from_secs(15), |go| !*go);\n        }\n    }\n}\ndiff --git a/apps/desktop/src-tauri/src/native_confirmation.rs b/apps/desktop/src-tauri/src/native_confirmation.rs\nindex 9c1ba615..25798d21 100644\n--- a/apps/desktop/src-tauri/src/native_confirmation.rs\n+++ b/apps/desktop/src-tauri/src/native_confirmation.rs\n@@ -48,6 +48,13 @@ impl Registry {\n         sender.is_some_and(|tx| tx.send(accepted).is_ok())\n     }\n \n+    pub fn is_pending(&self, nonce: u64) -> bool {\n+        self.pending\n+            .lock()\n+            .map(|pending| pending.contains_key(&nonce))\n+            .unwrap_or(false)\n+    }\n+\n     pub fn open_count(&self) -> usize {\n         self.pending.lock().map(|p| p.len()).unwrap_or(0)\n     }\n@@ -81,6 +88,107 @@ impl SecretOwnership {\n     }\n }\n \n+/// The same revocation check is used immediately before AppKit presentation\n+/// and again in its explicit copy callback.\n+#[derive(Clone)]\n+pub struct SecretCopyPermit {\n+    lease: desktop_core::PresentationLease,\n+    generation: u64,\n+}\n+impl SecretCopyPermit {\n+    pub fn allowed(&self, owner: &SecretOwnership) -> bool {\n+        self.lease.is_current() && owner.owns(self.generation)\n+    }\n+}\n+\n+/// An admitted secret waiting for the main-thread queue. Its revocable owner\n+/// is captured at admission; a refused callback cannot claim the sheet slot.\n+/// Dropping a refused task zeroizes its key.\n+pub struct SecretPresentation {\n+    label: String,\n+    secret: zeroize::Zeroizing<String>,\n+    lease: desktop_core::PresentationLease,\n+}\n+impl SecretPresentation {\n+    pub fn new(\n+        label: String,\n+        secret: zeroize::Zeroizing<String>,\n+        lease: desktop_core::PresentationLease,\n+    ) -> Self {\n+        Self {\n+            label,\n+            secret,\n+            lease,\n+        }\n+    }\n+    pub fn run(\n+        self,\n+        owner: &SecretOwnership,\n+        show: impl FnOnce(String, zeroize::Zeroizing<String>, SecretCopyPermit),\n+    ) -> bool {\n+        if !self.lease.is_current() {\n+            return false;\n+        }\n+        let permit = SecretCopyPermit {\n+            lease: self.lease,\n+            generation: owner.begin(),\n+        };\n+        if !permit.allowed(owner) {\n+            return false;\n+        }\n+        show(self.label, self.secret, permit);\n+        true\n+    }\n+}\n+\n+pub struct ConfirmationPermit {\n+    lease: desktop_core::PresentationLease,\n+    nonce: u64,\n+}\n+impl ConfirmationPermit {\n+    pub fn complete(&self, registry: &Registry, accepted: bool) -> bool {\n+        registry.complete(self.nonce, accepted && self.lease.is_current())\n+    }\n+}\n+/// Production queue entry shared by AppKit and deterministic host regressions.\n+pub struct ConfirmationPresentation {\n+    nonce: u64,\n+    request: desktop_core::ConfirmationRequest,\n+    lease: desktop_core::PresentationLease,\n+}\n+impl ConfirmationPresentation {\n+    pub fn new(\n+        nonce: u64,\n+        request: desktop_core::ConfirmationRequest,\n+        lease: desktop_core::PresentationLease,\n+    ) -> Self {\n+        Self {\n+            nonce,\n+            request,\n+            lease,\n+        }\n+    }\n+    pub fn run(\n+        self,\n+        registry: &Registry,\n+        show: impl FnOnce(u64, desktop_core::ConfirmationRequest, ConfirmationPermit),\n+    ) -> bool {\n+        if !self.lease.is_current() || !registry.is_pending(self.nonce) {\n+            registry.complete(self.nonce, false);\n+            return f