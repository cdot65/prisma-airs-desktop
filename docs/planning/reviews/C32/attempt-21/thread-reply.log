{"type":"item.completed","item":{"id":"item_53","type":"command_execution","command":"/bin/zsh -lc \"sed -n '1246,1328p' apps/desktop/src/v2/harness/harness.test.tsx\n sed -n '298,345p' apps/desktop/src/v2/harness/harness.test.tsx\n sed -n '897,925p' apps/desktop/src/v2/harness/harness.test.tsx\n sed -n '1,175p' apps/desktop/src/v2/harness/panels/sign-in.tsx\"","aggregated_output":"    it('a pending report is never final: a send later given back keeps its exact text beside newer edits, on both send paths and through an A/B/A that retires its conversation (attempt-19 R1)', async () => {\n        const l = LIFECYCLES[0]!\n        const ready = { ...l.steps.approved, proposals: [] }\n        const report = (c: ConversationView, submission: string, state: 'pending' | 'returned'): ConversationView => ({\n            ...c,\n            phase: state === 'pending' ? 'renewing' : 'ready',\n            // The core's transient unsent text is never observed here.\n            unsent: null,\n            submissions: [{ submission, entry: 'u-2', state }],\n        })\n        for (const path of ['current', 'first'] as const) {\n            resetShellStore()\n            const { native, user, view } = await launch(fxHarness(path === 'current' ? ready : null))\n            const box = () => screen.getByRole('textbox', { name: 'Message' })\n            const text = `Renewing then returned (${path})`\n            await user.type(box(), text)\n            await user.click(screen.getByRole('button', { name: 'Send' }))\n            let conversation: ConversationView = ready\n            if (path === 'first') {\n                const { opening: _none, ...base } = l.steps.declined\n                conversation = { ...base, id: 'op-77', phase: 'ready', entries: [], lastTurn: null, savedAt: null, proposals: [] }\n                await native.push({ ...native.current, harness: { ...native.current.harness, conversation } })\n            }\n            await waitFor(() => expect(sendIds(native.dispatched)).toHaveLength(1))\n            const submission = sendIds(native.dispatched)[0]!\n            // Admitted while the renewal runs: pending, so the text is still tracked once the box is cleared.\n            await native.push({ ...native.current, harness: { ...native.current.harness, conversation: report(conversation, submission, 'pending') } })\n            await waitFor(() => expect(box()).toHaveValue(''))\n            await user.type(box(), 'A newer edit')\n            // Then given back.\n            await native.push({ ...native.current, harness: { ...native.current.harness, conversation: report(conversation, submission, 'returned') } })\n            await waitFor(() => expect(within(screen.getByRole('region', { name: 'Not sent' })).getAllByText(text)).toHaveLength(1))\n            expect(box()).toHaveValue('A newer edit')\n            await native.push({ ...native.current, activeFeature: 'administration' })\n            await native.push({ ...native.current, activeFeature: 'harness' })\n            await waitFor(() => expect(screen.getByRole('textbox', { name: 'Message' })).toHaveValue('A newer edit'))\n            expect(within(screen.getByRole('region', { name: 'Not sent' })).getAllByText(text)).toHaveLength(1)\n            expect(sendIds(native.dispatched)).toHaveLength(1)\n            view.unmount()\n        }\n        // Admitted while renewing, then A/B/A retires the conversation before the core's final word.\n        resetShellStore()\n        const { native, user } = await launch(fxHarness(ready))\n        const box = () => screen.getByRole('textbox', { name: 'Message' })\n        await user.type(box(), 'Renewing when retired')\n        await user.click(screen.getByRole('button', { name: 'Send' }))\n        await waitFor(() => expect(sendIds(native.dispatched)).toHaveLength(1))\n        await native.push({ ...native.current, harness: { ...native.current.harness, conversation: report(ready, sendIds(native.dispatched)[0]!, 'pending') } })\n        await waitFor(() => expect(box()).toHaveValue(''))\n        await user.type(box(), 'Typed after')\n        const a = native.current\n        await native.push({ ...a, active: { tenant: a.tenants[1]!.id, context: 'cx-bbbbbbbbbbbbbbbbbbbbbbbb' }, harness: { ...a.harness, conversation: null } })\n        const reissued = { ...a.gateway, selected: { ...a.gateway.selected!, reference: 'gw-cccccccccccccccccccccccc' } }\n        await native.push({ ...a, active: { tenant: a.active!.tenant, context: 'cx-cccccccccccccccccccccccc' }, gateway: reissued, harness: { ...a.harness, conversation: null } })\n        await waitFor(() => expect(within(screen.getByRole('region', { name: 'Not confirmed' })).getByText('Renewing when retired')).toBeInTheDocument())\n        expect(screen.getByRole('textbox', { name: 'Message' })).toHaveValue('Typed after')\n        await native.push({ ...native.current, activeFeature: 'administration' })\n        await native.push({ ...native.current, activeFeature: 'harness' })\n        await waitFor(() => expect(within(screen.getByRole('region', { name: 'Not confirmed' })).getByText('Renewing when retired')).toBeInTheDocument())\n        expect(screen.getByRole('textbox', { name: 'Message' })).toHaveValue('Typed after')\n        expect(sendIds(native.dispatched)).toHaveLength(1)\n    })\n\n    it('the rail keeps the conversation\\'s title from its opening after the transcript dropped it, also once ended (attempt-18 R2)', async () => {\n        const l = LIFECYCLES[0]!\n        const big = (n: number) => 'x'.repeat(n)\n        const byCount = pushed(full('Original investigation').map((e) => (e.id === 'u-1' ? { ...e, text: 'Original investigation' } : e)), op('u-101', 'Later unrelated question'))\n        const byBytes = pushed([op('u-1', 'Original investigation'), answer('a-1', big(260_000)), op('u-2', 'Later unrelated question'), answer('a-2', big(260_000)), answer('a-3', big(260_000)), answer('a-4', big(260_000))], answer('a-5', big(260_000)))\n        for (const entries of [byCount, byBytes]) {\n            expect(entries.some((e) => e.id === 'u-1')).toBe(false)\n            expect(entries.find((e) => e.role === 'operator')!.text).not.toBe('Original investigation')\n            for (const step of [l.steps.approved, l.steps.ended]) {\n                resetShellStore()\n                const { view } = await launch(fxHarness({ ...step, proposals: [], entries, opening: 'Original investigation' }))\n                const rail = screen.getByRole('navigation', { name: 'Conversations' })\n                expect(within(rail).getByText('Original investigation')).toBeInTheDocument()\n                expect(within(rail).queryByText('Later unrelated question')).toBeNull()\n                view.unmount()\n            }\n        }\n    })\n\n    it('settles an unconfirmed send by the core\\'s word even when the transcript is at its bounds and dropped its oldest entries (attempt-11 R1)', async () => {\n    it('a contextual restart of the ended conversation prefills its whole opening question, never its shortened title; a draft is kept and nothing is sent (attempt-12 R1)', async () => {\n        const l = LIFECYCLES[0]!\n        expect(LONG_OPENING.length).toBeGreaterThan(160)\n        const entries = l.steps.ended.entries.map((e) => (e.id === 'u-1' ? { ...e, text: LONG_OPENING } : e))\n        const ended = { ...l.steps.ended, entries, opening: LONG_OPENING }\n        const { native, user } = await launch(fxHarness(ended))\n        const box = () => screen.getByRole('textbox', { name: 'Message' })\n        await user.type(box(), 'A draft of my own')\n        useShellStore.getState().arrive({ tenant: 'tn-0123456789abcdef', feature: 'harness', resource: null, item: ended.historyId })\n        const hint = await waitFor(() => {\n            const found = document.querySelector('[data-slot=\"harness-hint\"]')\n            expect(found).not.toBeNull()\n            return found as HTMLElement\n        })\n        await user.click(within(hint).getByRole('button', { name: 'Start a new investigation' }))\n        expect(box()).toHaveValue(LONG_OPENING)\n        expect(within(screen.getByRole('region', { name: 'Not sent' })).getByText('A draft of my own')).toBeInTheDocument()\n        await new Promise((r) => setTimeout(r, 50))\n        expect(startHarnessCalls(native.dispatched)).toEqual([])\n    })\n\n    it('a contextual restart of an archived conversation reads its record for the whole opening question; a draft is kept and nothing is sent (attempt-12 R1)', async () => {\n        const l = LIFECYCLES[2]!\n        const title = `${LONG_OPENING.replace(/\\s+/g, ' ').slice(0, 79)}…`\n        const saved = { ...l.saved, title }\n        const { native, user } = await launch(fxHarness(null, {}, [saved]))\n        const box = () => screen.getByRole('textbox', { name: 'Message' })\n        await user.type(box(), 'Unrelated draft')\n        useShellStore.getState().arrive({ tenant: 'tn-0123456789abcdef', feature: 'harness', resource: null, item: saved.id })\n        const hint = await waitFor(() => {\n            const found = document.querySelector('[data-slot=\"harness-hint\"]')\n            expect(found).not.toBeNull()\n            return found as HTMLElement\n        })\n        await user.click(within(hint).getByRole('button', { name: 'Start a new investigation' }))\n        expect(native.dispatched).toContainEqual({ kind: 'openHarnessHistory', context: CONTEXT, workspace: REF, id: saved.id })\n        // Nothing is filled in while the record is read: never the title in its place.\n        expect(within(hint).getByRole('button', { name: 'Reading its opening question…' })).toHaveAttribute('aria-busy', 'true')\n        expect(box()).toHaveValue('Unrelated draft')\n        await native.push(withOpened(native.current, opened(saved, l.steps.ended.entries, LONG_OPENING)))\n        await waitFor(() => expect(box()).toHaveValue(LONG_OPENING))\n        expect(within(screen.getByRole('region', { name: 'Not sent' })).getByText('Unrelated draft')).toBeInTheDocument()\n        await new Promise((r) => setTimeout(r, 50))\n        expect(startHarnessCalls(native.dispatched)).toEqual([])\n    })\n\n    it('says when the opening question is not known, or its record could not be read, and never substitutes the title (attempt-12 R1)', async () => {\n        const l = LIFECYCLES[1]!\n    it('one Send starts at most one conversation and delivers once, even when the clear publishes before its receipt (attempt-03 R4)', async () => {\n        const l = LIFECYCLES[0]!\n        const { native, user } = await launch(fxHarness(l.steps.approved))\n        // The core publishes the cleared state (no conversation) before it answers ClearHarness.\n        const dispatch = native.transport.dispatch\n        native.transport.dispatch = async (bytes) => {\n            const intent = (JSON.parse(new TextDecoder().decode(bytes)) as { intent: Intent }).intent\n            if (intent.kind === 'clearHarness') {\n                // Published first; the receipt follows a tick later.\n                void native.push({ ...native.current, harness: { ...native.current.harness, conversation: null } })\n                await new Promise((r) => setTimeout(r, 20))\n            }\n            return dispatch(bytes)\n        }\n        await user.click(screen.getByRole('button', { name: 'New investigation' }))\n        await user.type(screen.getByRole('textbox', { name: 'Message' }), 'Only once')\n        await user.click(screen.getByRole('button', { name: 'Send' }))\n        await native.push({ ...native.current, harness: { ...native.current.harness, conversation: l.steps.ended } })\n        await waitFor(() => expect(native.dispatched.filter((i) => i.kind === 'startHarness')).toHaveLength(1))\n        const base = { ...l.steps.declined, entries: [], lastTurn: null, savedAt: null, proposals: [] }\n        await native.push({ ...native.current, harness: { ...native.current.harness, conversation: { ...base, id: 'op-77', phase: 'ready' } } })\n        await waitFor(() => expect(native.dispatched).toContainEqual(expect.objectContaining({ kind: 'sendHarness', conversation: 'op-77', prompt: 'Only once' })))\n        await new Promise((r) => setTimeout(r, 50))\n        expect(native.dispatched.filter((i) => i.kind === 'startHarness')).toHaveLength(1)\n        expect(native.dispatched.filter((i) => i.kind === 'sendHarness')).toHaveLength(1)\n        native.transport.dispatch = dispatch\n    })\n\n    it('keeps a refused or undelivered follow-up beside the edit made while it was delivered, and resends nothing (attempt-04 R1)', async () => {\nimport { type FormEvent, useId, useState } from 'react'\nimport type { ContextRef, CredentialSource, HarnessSignInView, SelectedWorkspace } from '@prisma-airs/desktop-contracts'\nimport type { Dispatch, DispatchOutcome } from '../../../features/tenants/dispatch'\nimport { SIGN_IN_FAILURE_TEXT, SIGN_IN_NEEDS, SIGN_IN_STEP_TEXT, actionOutcomeText, notConfirmedText, saveFailureText } from '../text'\nimport { Btn, Field } from './controls'\n\ninterface Props {\n    context: ContextRef\n    /** The chosen Gateway workspace; company sign-in is set up for one. */\n    selected: SelectedWorkspace | null\n    signIn: HarnessSignInView | null\n    /** The workspace key is stored for the chosen workspace. */\n    keyHere: boolean\n    /** A conversation is running (changing the credential ends it). */\n    running: boolean\n    dispatch: Dispatch\n    onMessage: (message: string | null) => void\n}\n\n/**\n * Which credential the Harness answers with (C20), as a v2 panel (C38): the\n * workspace inference key, or a company sign-in through the browser whose\n * Gateway token is renewed before it is sent.\n */\nexport function SignInPanel({ selected, ...rest }: Props) {\n    return selected ? <WorkspaceSignIn selected={selected} {...rest} /> : <SignInUnavailable />\n}\n\nconst faint = { color: 'var(--v2-faint)' }\n\n/** With no workspace chosen, company sign-in is shown but cannot be set up yet. */\nfunction SignInUnavailable() {\n    const ids = useId()\n    return (\n        <section aria-labelledby={`${ids}-heading`} className='flex flex-col gap-3' data-slot='harness-sign-in-setup'>\n            <h2 id={`${ids}-heading`} className='text-[13px] font-bold'>\n                Company sign-in (SSO)\n            </h2>\n            <p className='text-[12px]' style={faint}>{`Answer with your company’s identity provider instead of a workspace inference key. ${SIGN_IN_NEEDS}`}</p>\n            <Btn className='self-start' disabled aria-describedby={`${ids}-reason`}>\n                Set up company sign-in\n            </Btn>\n            <p id={`${ids}-reason`} className='text-[12px]' style={faint} data-slot='harness-sign-in-reason'>\n                Choose a Gateway workspace first\n            </p>\n        </section>\n    )\n}\n\nconst CHECK = 'Check the sign-in state shown here before trying again.'\n\nfunction WorkspaceSignIn({ context, selected, signIn, keyHere, running, dispatch, onMessage }: Props & { selected: SelectedWorkspace }) {\n    const ids = useId()\n    const here = signIn !== null && signIn.workspace.id === selected.workspace.id\n    const [editing, setEditing] = useState(false)\n    const [busy, setBusy] = useState(false)\n    const source: CredentialSource = here && signIn.selected ? 'companySignIn' : 'workspaceKey'\n\n    // An unknown delivery stays Not confirmed naming the action (a sign-out or a credential choice may have\n    // happened; the sign-in state shown here is the state to reconcile with); a refusal says its own reason.\n    async function send(intent: Parameters<Dispatch>[0], action: string, failureText?: (outcome: DispatchOutcome) => string): Promise<boolean> {\n        onMessage(null)\n        setBusy(true)\n        try {\n            const outcome = await dispatch(intent)\n            if (outcome.kind === 'unknown') onMessage(notConfirmedText(action, CHECK))\n            else if (outcome.kind !== 'admitted') onMessage(failureText ? failureText(outcome) : actionOutcomeText(outcome, action, CHECK))\n            return outcome.kind === 'admitted'\n        } finally {\n            setBusy(false)\n        }\n    }\n\n    async function configure(event: FormEvent<HTMLFormElement>) {\n        event.preventDefault()\n        const first = !here\n        const form = new FormData(event.currentTarget)\n        const value = (name: string) => String(form.get(name) ?? '').trim()\n        const saved = await send(\n            {\n                kind: 'configureHarnessSignIn',\n                context,\n                workspace: selected.reference,\n                endpoint: value('endpoint'),\n                issuer: value('issuer'),\n                clientId: value('client'),\n                audience: value('audience'),\n            },\n            'saving the company sign-in',\n            saveFailureText\n        )\n        if (!saved) return\n        setEditing(false)\n        // Newly set up, company sign-in becomes the choice for new\n        // conversations; signing in is still the operator's step. A running\n        // conversation is left alone (changing the credential ends it).\n        if (first && !running) await send({ kind: 'chooseHarnessCredential', context, source: 'companySignIn' }, 'choosing the company sign-in')\n    }\n\n    const signedIn = here && signIn.account !== null\n    const step = here ? signIn.step : null\n    return (\n        <section aria-labelledby={`${ids}-heading`} className='flex flex-col gap-3' data-slot='harness-credential'>\n            <h2 id={`${ids}-heading`} className='text-[13px] font-bold'>\n                Gateway credential\n            </h2>\n            {here ? (\n                <fieldset className='flex flex-col gap-1' disabled={busy}>\n                    <legend className='text-[13px] font-medium'>Answer with</legend>\n                    {(\n                        [\n                            ['workspaceKey', 'The workspace inference key', keyHere ? 'Stored in AI Gateway' : 'Not stored for this workspace'],\n                            ['companySignIn', 'Company sign-in', signedIn ? `Signed in as ${signIn.account}` : 'Not signed in'],\n                        ] as const\n                    ).map(([value, label, hint]) => (\n                        <label key={value} className='flex min-h-9 cursor-pointer items-center gap-3'>\n                            <input\n                                type='radio'\n                                name={`${ids}-source`}\n                                value={value}\n                                checked={source === value}\n                                onChange={() => void send({ kind: 'chooseHarnessCredential', context, source: value }, 'choosing the credential')}\n                                className='size-4 min-h-0'\n                            />\n                            <span className='flex flex-col'>\n                                <span className='text-[13px]'>{label}</span>\n                                <span className='text-[12px]' style={faint}>\n                                    {hint}\n                                </span>\n                            </span>\n                        </label>\n                    ))}\n                    {running ? (\n                        <p className='text-[12px]' style={faint}>\n                            Changing the credential ends the running conversation.\n                        </p>\n                    ) : null}\n                </fieldset>\n            ) : null}\n            <h3 className='text-[13px] font-semibold'>Company sign-in (SSO)</h3>\n            {!here && !editing ? (\n                <>\n                    <p className='text-[12px]' style={faint}>\n                        {SIGN_IN_NEEDS}\n                    </p>\n                    <Btn className='self-start' onClick={() => setEditing(true)}>\n                        Set up company sign-in\n                    </Btn>\n                </>\n            ) : here && !editing ? (\n                <div className='flex flex-col gap-2' data-slot='harness-sign-in'>\n                    <dl className='grid grid-cols-[auto_1fr] gap-x-4 gap-y-1 text-[13px]'>\n                        <dt style={faint}>Identity provider</dt>\n                        <dd className='font-mono text-[12px] break-all'>{signIn.issuer}</dd>\n                        <dt style={faint}>Client ID</dt>\n                        <dd className='font-mono text-[12px] break-all'>{signIn.clientId}</dd>\n                        <dt style={faint}>Gateway audience</dt>\n                        <dd className='font-mono text-[12px] break-all'>{signIn.audience}</dd>\n                        <dt style={faint}>Gateway endpoint</dt>\n                        <dd className='font-mono text-[12px] break-all'>{signIn.endpoint}</dd>\n                    </dl>\n                    {step ? (\n                        <p role='status' className='text-[13px]' data-slot='harness-sign-in-step'>\n                            {SIGN_IN_STEP_TEXT[step]}\n                        </p>\n                    ) : null}\n                    {signIn.failure ? (\n                        <p role='alert' className='text-[13px]' style={{ color: 'var(--v2-flag)' }} data-slot='harness-sign-in-failure'>\n                            {SIGN_IN_FAILURE_TEXT[signIn.failure]}\n                        </p>\n                    ) : null}\n                    <div className='flex flex-wrap gap-2'>\n                        {step ? (\n                            <Btn onClick={() => void send({ kind: 'cancelHarnessSignIn', context }, 'cancelling the sign-in')}>Cancel sign-in</Btn>\n                        ) : (\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_54","type":"command_execution","command":"/bin/zsh -lc \"sed -n '1,150p' apps/desktop/src/v2/harness/panels/mcp.tsx\n cat apps/desktop/academy-source.ts\n cat apps/desktop/src-tauri/capabilities/main.json apps/desktop/src-tauri/tauri.conf.json\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_54","type":"command_execution","command":"/bin/zsh -lc \"sed -n '1,150p' apps/desktop/src/v2/harness/panels/mcp.tsx\n cat apps/desktop/academy-source.ts\n cat apps/desktop/src-tauri/capabilities/main.json apps/desktop/src-tauri/tauri.conf.json\"","aggregated_output":"import { useEffect, useId, useState } from 'react'\nimport type { ContextRef, HarnessMcpView, McpServerView, Refusal, SelectedWorkspace } from '@prisma-airs/desktop-contracts'\nimport { MANAGEMENT_FAILURE_TEXT } from '../../../features/administration/management-read'\nimport type { Dispatch } from '../../../features/tenants/dispatch'\nimport { MCP_MAX_ON, MCP_SIGN_IN_FAILURE_TEXT, MCP_STEP_TEXT, actionOutcomeText } from '../text'\nimport { Btn } from './controls'\n\nfunction standing(s: McpServerView): string {\n    if (!s.supported) return 'This server’s identifier is not one the Harness engine accepts; it cannot be used.'\n    if (s.expired) return MCP_SIGN_IN_FAILURE_TEXT[s.expired]\n    if (s.stale) return 'Signed in for an earlier version of this server. Sign in again to use it.'\n    if (s.signedIn) return 'Signed in.'\n    return 'Not signed in: its tools will be unavailable until you sign in.'\n}\n\n/** The aside's one-line standing (R2App's \"Signed in\" column). */\nexport function mcpStanding(s: McpServerView): { word: string; tone: 'ok' | 'flag' | 'faint' } {\n    if (!s.supported) return { word: 'Not usable', tone: 'faint' }\n    if (s.expired) return { word: 'Sign-in expired', tone: 'flag' }\n    if (s.stale) return { word: 'Sign in again', tone: 'flag' }\n    if (s.signedIn) return { word: 'Signed in', tone: 'ok' }\n    return { word: 'Not signed in', tone: 'faint' }\n}\n\ninterface Props {\n    context: ContextRef\n    selected: SelectedWorkspace\n    mcp: HarnessMcpView | null\n    /** A conversation is running (changing its servers ends it). */\n    running: boolean\n    dispatch: Dispatch\n    onMessage: (message: string | null) => void\n}\n\nconst faint = { color: 'var(--v2-faint)' }\n\n/**\n * The chosen workspace's MCP servers (C22, D049), as a v2 panel (C38): read\n * from its Gateway catalog, turned on for new conversations (at most\n * eight), each signed in to in the browser by this app. The engine only\n * ever gets each server's token in memory, and asks before every tool call.\n */\nconst CHECK = 'Check the servers shown here before trying again.'\n\n// The panel's own wording only for the refusals whose meaning this action fixes (crates/desktop-core/src/authority/\n// harness_mcp.rs): turning a server on is refused as invalidInput when it is not a supported catalog server and as busy\n// at the eight-server bound; starting a sign-in is refused as invalidInput for an unknown server and as busy while\n// another sign-in is in progress. Every other refusal (storage denied or locked, a retired context, …) keeps its own\n// reason and recovery, and turning a server off has no special wording (attempt-03 R1).\nconst ENABLE_REFUSED: Partial<Record<Refusal, string>> = {\n    invalidInput: 'That was not done. Only servers in this workspace’s catalog that the engine accepts can be turned on.',\n    busy: 'That was not done. At most eight servers can be on.',\n}\nconst SIGN_IN_REFUSED: Partial<Record<Refusal, string>> = {\n    invalidInput: 'Sign-in could not start. The server is not in this workspace’s catalog.',\n    busy: 'Sign-in could not start. Another sign-in is in progress.',\n}\n\nexport function McpPanel({ context, selected, mcp, running, dispatch, onMessage }: Props) {\n    const ids = useId()\n    const [busy, setBusy] = useState(false)\n    const workspace = selected.reference\n    const here = mcp !== null && mcp.workspace === selected.workspace.id\n\n    // Read the catalog whenever the chosen workspace changes.\n    useEffect(() => {\n        void dispatch({ kind: 'listMcpServers', context, workspace })\n    }, [dispatch, context, workspace])\n\n    // An unknown delivery stays Not confirmed naming the action (a sign-out or a change of which servers are on\n    // may have happened; the catalog shown here is the state to reconcile with); a refusal says this panel's\n    // reason for that refusal kind when the action fixes its meaning, else the refusal's own.\n    async function send(intent: Parameters<Dispatch>[0], action: string, refused?: Partial<Record<Refusal, string>>) {\n        onMessage(null)\n        setBusy(true)\n        try {\n            onMessage(actionOutcomeText(await dispatch(intent), action, CHECK, (refusal) => refused?.[refusal]))\n        } finally {\n            setBusy(false)\n        }\n    }\n\n    const servers = here ? mcp.servers : []\n    const on = servers.filter((s) => s.enabled).length\n    const signingIn = servers.some((s) => s.step !== null)\n    return (\n        <section aria-labelledby={`${ids}-heading`} className='flex flex-col gap-2 rounded-[12px] border p-3' style={{ borderColor: 'var(--v2-rule)' }} data-slot='harness-mcp'>\n            <h2 id={`${ids}-heading`} className='text-[13px] font-bold'>\n                Workspace MCP servers\n            </h2>\n            <p className='text-[12px]' style={faint}>\n                Servers published in this workspace’s AI Gateway. The Harness asks you before every tool call, and each server’s sign-in stays with this app.\n            </p>\n            {!here || mcp.state === 'loading' ? (\n                <p role='status' className='text-[13px]'>\n                    Reading the workspace’s MCP servers…\n                </p>\n            ) : null}\n            {here && mcp.failure ? (\n                <p role='alert' className='text-[13px]' style={{ color: 'var(--v2-flag)' }}>\n                    {`The MCP servers could not be read: ${MANAGEMENT_FAILURE_TEXT[mcp.failure]}`}\n                </p>\n            ) : null}\n            {here && mcp.state !== 'loading' && servers.length === 0 && !mcp.failure ? <p className='text-[13px]'>No MCP servers are published in this workspace.</p> : null}\n            {here && !mcp.complete && servers.length > 0 ? (\n                <p className='text-[12px]' style={faint}>\n                    Only the first 500 servers are shown.\n                </p>\n            ) : null}\n            {servers.length > 0 ? (\n                <ul role='list' aria-label='MCP servers' className='flex flex-col gap-2'>\n                    {servers.map((s) => {\n                        const holdsSignIn = s.signedIn || s.stale || s.expired !== null\n                        return (\n                            <li key={s.id} className='rounded-[8px] border p-2' style={{ borderColor: 'var(--v2-rule)' }} data-slot='harness-mcp-server'>\n                                <label className='flex items-start gap-2 text-[13px] font-semibold'>\n                                    <input\n                                        type='checkbox'\n                                        className='mt-[3px] size-4 min-h-0'\n                                        checked={s.enabled}\n                                        disabled={busy || !s.supported || (!s.enabled && on >= MCP_MAX_ON)}\n                                        aria-describedby={`${ids}-${s.id}-standing`}\n                                        onChange={(event) =>\n                                            void send(\n                                                { kind: 'enableMcpServer', context, workspace, server: s.id, enabled: event.target.checked },\n                                                event.target.checked ? `turning ${s.name} on` : `turning ${s.name} off`,\n                                                event.target.checked ? ENABLE_REFUSED : undefined\n                                            )\n                                        }\n                                    />\n                                    {`Use ${s.name} in new conversations`}\n                                </label>\n                                <p className='font-mono text-[11px] break-all'>{`${s.namespace} · ${s.url}`}</p>\n                                <p id={`${ids}-${s.id}-standing`} className='text-[12px]'>\n                                    {standing(s)}\n                                </p>\n                                {s.step ? (\n                                    <p role='status' className='text-[12px]'>\n                                        {MCP_STEP_TEXT[s.step]}\n                                    </p>\n                                ) : null}\n                                {s.failure ? (\n                                    <p role='alert' className='text-[12px]' style={{ color: 'var(--v2-flag)' }}>\n                                        {MCP_SIGN_IN_FAILURE_TEXT[s.failure]}\n                                    </p>\n                                ) : null}\n                                <div className='mt-1 flex flex-wrap gap-2'>\n                                    {s.step ? (\n                                        <Btn tier='tertiary' onClick={() => void send({ kind: 'cancelMcpSignIn', context }, 'cancelling the sign-in')}>\n                                            Cancel sign-in\n/**\n * Academy learner source compiled into the desktop (C05). The learner\n * package (@ai-security-academy/learner) exports Academy's own pages; their\n * `@/` imports are Academy's source in the prepared, hash-verified input\n * (.work/academy, xtask shared-prepare). Every bare import that source makes\n * resolves to this app's pinned copy (`dedupe`), so one React, one React\n * Query and one router instance exist and versions follow the desktop lock.\n */\n// A file-system path without Node typings in the app's tsconfig (the\n// repository path has no characters that URL-encode other than these).\nexport const ACADEMY_SRC = decodeURIComponent(new URL('../../.work/academy/src', import.meta.url).pathname)\nconst CONTRACTS_ROOT = decodeURIComponent(new URL('../../packages/desktop-contracts/', import.meta.url).pathname)\n\n// node_modules may be shared with another worktree. Compile this checkout's IPC parser and bindings,\n// not the workspace package reached through that other checkout's dependency symlink.\nexport const desktopAliases = [\n    { find: /^@prisma-airs\\/desktop-contracts$/, replacement: `${CONTRACTS_ROOT}src/index.ts` },\n    { find: /^@prisma-airs\\/desktop-contracts\\/fixtures\\//, replacement: `${CONTRACTS_ROOT}fixtures/` },\n    { find: /^@\\//, replacement: `${ACADEMY_SRC}/` },\n]\n\nexport const academyDedupe = [\n    'react',\n    'react-dom',\n    '@ai-security-academy/presentation',\n    '@ai-security-academy/shared',\n    '@codemirror/commands',\n    '@codemirror/lang-python',\n    '@codemirror/lang-yaml',\n    '@codemirror/language',\n    '@codemirror/state',\n    '@codemirror/view',\n    '@dnd-kit/core',\n    '@excalidraw/excalidraw',\n    '@lezer/highlight',\n    '@radix-ui/react-dialog',\n    '@radix-ui/react-slot',\n    '@tanstack/react-query',\n    '@tanstack/react-router',\n    '@trpc/client',\n    '@trpc/react-query',\n    '@trpc/server',\n    'class-variance-authority',\n    'clsx',\n    'dompurify',\n    'lucide-react',\n    'mermaid',\n    'qrcode.react',\n    'sanitize-html',\n    'tailwind-merge',\n    'zustand',\n]\n{\n  \"$schema\": \"../gen/schemas/desktop-schema.json\",\n  \"identifier\": \"main-window\",\n  \"description\": \"The packaged main window may call only the two application commands.\",\n  \"local\": true,\n  \"windows\": [\"main\"],\n  \"webviews\": [\"main\"],\n  \"permissions\": [\"allow-desktop-dispatch\", \"allow-desktop-observe\"]\n}\n{\n  \"$schema\": \"https://schema.tauri.app/config/2\",\n  \"productName\": \"Prisma AIRS Desktop v2\",\n  \"version\": \"2.0.0\",\n  \"identifier\": \"io.cdot.prisma-airs-desktop.v2\",\n  \"build\": {\n    \"frontendDist\": \"../dist\",\n    \"beforeBuildCommand\": \"\"\n  },\n  \"app\": {\n    \"withGlobalTauri\": false,\n    \"windows\": [],\n    \"security\": {\n      \"csp\": {\n        \"default-src\": \"'self'\",\n        \"script-src\": \"'self'\",\n        \"style-src\": \"'self'\",\n        \"img-src\": \"'self' data:\",\n        \"font-src\": \"'self' data:\",\n        \"connect-src\": \"ipc: http://ipc.localhost\",\n        \"object-src\": \"'none'\",\n        \"base-uri\": \"'none'\",\n        \"form-action\": \"'none'\",\n        \"frame-ancestors\": \"'none'\",\n        \"frame-src\": \"'none'\",\n        \"worker-src\": \"'none'\"\n      },\n      \"dangerousDisableAssetCspModification\": false,\n      \"freezePrototype\": true,\n      \"capabilities\": [\"main-window\"]\n    }\n  },\n  \"bundle\": {\n    \"active\": true,\n    \"targets\": [\"app\", \"dmg\"],\n    \"category\": \"DeveloperTool\",\n    \"copyright\": \"Copyright 2026 cdot\",\n    \"license\": \"Apache-2.0\",\n    \"icon\": [\"icons/32x32.png\", \"icons/128x128.png\", \"icons/128x128@2x.png\", \"icons/icon.icns\", \"icons/icon.png\"],\n    \"macOS\": {\n      \"minimumSystemVersion\": \"13.0\",\n      \"hardenedRuntime\": true\n    }\n  }\n}\n","exit_code":0,"status":"completed"}}
