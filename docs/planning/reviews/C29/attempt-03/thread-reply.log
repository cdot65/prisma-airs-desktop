   695	    fn verify_view(setup: &Setup) -> Option<VerifyView> {
   696	        let run = setup.verify.as_ref()?;
   697	        let steps: Vec<VerifyStep> = run.steps.iter().map(|s| s.step.clone()).collect();
   698	        let done = steps.iter().all(|s| s.state != VerifyState::Pending);
   699	        let failed = steps.iter().any(|s| s.state == VerifyState::Fail);
   700	        // Only a required line blocks: the scan key on first run. An optional
   701	        // service that failed is carried as a warning the operator can
   702	        // continue over (and the Inbox shows).
   703	        let blocking = steps
   704	            .iter()
   705	            .any(|s| s.state == VerifyState::Fail && s.line == VerifyLine::ScanKey);
   706	        let warnings = steps
   707	            .iter()
   708	            .filter_map(|s| {
   709	                let product = s.product?;
   710	                match s.state {
   711	                    VerifyState::Warning => Some(VerifyWarning {
   712	                        product,
   713	                        reason: s.reason.clone(),
   714	                    }),
   715	                    VerifyState::Fail if s.line != VerifyLine::ScanKey => Some(VerifyWarning {
   716	                        product,
   717	                        reason: format!("Failed: {}", s.reason),
   718	                    }),
   719	                    _ => None,
   720	                }
   721	            })
   722	            .collect();
   723	        Some(VerifyView {
   724	            generation: run.generation,
   725	            steps,
   726	            done,
   727	            failed,
   728	            blocking,
   729	            stale: run.signature != Self::setup_signature(setup),
   730	            warnings,
   731	        })
   732	    }
