   268	    ) -> Result<Vec<RecordId>, Refusal> {
   269	        let profile = profile.validate().ok_or(Refusal::InvalidInput)?;
   270	        let setup = self.setup_for(context)?;
   271	        let id = setup.tenant.profile.id.clone();
   272	        let destination_changed = setup.tenant.profile.destination != profile.destination;
   273	        let tsg_changed = setup.tenant.profile.tsg_id != profile.tsg_id;
   274	        let mut retired = Vec::new();
   275	        if destination_changed {
   276	            for class in [
   277	                CredentialClass::Scan,
   278	                CredentialClass::Management,
   279	                CredentialClass::Inference,
   280	            ] {
   281	                retired.extend(self.retire_class(&id, class));
   282	            }
   283	        } else if tsg_changed {
   284	            retired.extend(self.retire_class(&id, CredentialClass::Management));
   285	        }
   286	        let setup = self.setup_for_mut(context)?;
   287	        let changed = setup.tenant.profile.label != profile.label
   288	            || setup.tenant.profile.tsg_id != profile.tsg_id
   289	            || setup.tenant.profile.destination != profile.destination
   290	            || setup.tenant.profile.environment != profile.environment;
   291	        setup.tenant.profile.label = profile.label;
   292	        setup.tenant.profile.tsg_id = profile.tsg_id;
   293	        setup.tenant.profile.destination = profile.destination;
   294	        setup.tenant.profile.environment = profile.environment;
   295	        if changed {
   296	            self.reissue_setup_context();
   297	        }
   298	        Ok(retired)
   299	    }
