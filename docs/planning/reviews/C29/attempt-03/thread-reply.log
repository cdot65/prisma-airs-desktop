   523	    /// The operations the current verify run waits on.
   524	    pub(super) fn setup_operations(&self) -> Vec<OperationId> {
   525	        self.data
   526	            .setup
   527	            .as_ref()
   528	            .and_then(|s| s.verify.as_ref())
   529	            .map(|v| v.steps.iter().filter_map(|s| s.operation.clone()).collect())
   530	            .unwrap_or_default()
   531	    }
