   348	    /// Starts a verification run over the current inputs: every line is
   349	    /// decided in the core; the lines that need a service read are admitted
   350	    /// through the management pipeline and settle through it.
   351	    pub(super) fn begin_verify(
   352	        &mut self,
   353	        context: &ContextRef,
   354	        keychain: Arc<dyn super::CredentialStore>,
   355	        session_vault: Arc<SessionVault>,
   356	    ) -> Result<Vec<crate::runtime::Start>, Refusal> {
   357	        let setup = self.setup_for(context)?;
   358	        let generation = setup.verify.as_ref().map_or(1, |v| v.generation + 1);
   359	        let signature = Self::setup_signature(setup);
   360	        let mode = setup.mode;
   361	        let products = setup.products.clone();
   362	        let scan = setup.tenant.scan.clone();
   363	        let management_ready = matches!(setup.tenant.management, ScanCapability::Ready { .. });
   364	        let mut starts = Vec::new();
   365	        let mut steps = Vec::new();
   366	        let mut admit = |state: &mut Self, request: ManagementRequest| -> Option<OperationId> {
   367	            match state.admit_management(
   368	                context.clone(),
   369	                request,
   370	                Arc::clone(&keychain),
   371	                Arc::clone(&session_vault),
   372	            ) {
   373	                Ok((operation, s)) => {
   374	                    starts.extend(s);
   375	                    Some(operation)
   376	                }
   377	                Err(_) => None,
   378	            }
   379	        };
   380	        // Runtime Security scan key: stored keys are proven by the first
   381	        // scan (there is no admitted read that exercises a scan key).
   382	        let (state_, reason) = match scan {
   383	            ScanCapability::Ready { .. } => (
   384	                VerifyState::Stored,
   385	                "Stored in the Keychain. Not checked here: the first scan proves it against the service.",
   386	            ),
   387	            ScanCapability::Storing { .. } => {
   388	                (VerifyState::Fail, "The scan key is still being saved.")
   389	            }
   390	            _ if mode == SetupMode::FirstRun => (
   391	                VerifyState::Fail,
   392	                "No scan key saved. Runtime Security needs one on first run.",
   393	            ),
   394	            _ => (
   395	                VerifyState::Warning,
   396	                "No scan key saved; scans stay unavailable until one is added in Administration.",
   397	            ),
   398	        };
   399	        steps.push(StepState {
   400	            step: VerifyStep {
   401	                line: VerifyLine::ScanKey,
   402	                product: Some(ProductId::RuntimeSecurity),
   403	                state: state_,
   404	                reason: reason.to_owned(),
   405	            },
   406	            operation: None,
   407	        });
   408	        // Management client: a real verify read when one is stored.
   409	        let needing: Vec<&str> = products
   410	            .iter()
   411	            .copied()
   412	            .filter(|p| needs_management(*p))
   413	            .map(product_label)
   414	            .collect();
   415	        let management = if management_ready {
   416	            match admit(self, ManagementRequest::Verify) {
   417	                Some(op) => (VerifyState::Pending, "Reading…".to_owned(), Some(op)),
   418	                None => (
   419	                    VerifyState::Fail,
   420	                    "The verify read could not be started.".to_owned(),
   421	                    None,
   422	                ),
   423	            }
   424	        } else if needing.is_empty() {
   425	            (
   426	                VerifyState::Skipped,
   427	                "No management client; Administration stays read-only.".to_owned(),
   428	                None,
   429	            )
   430	        } else {
   431	            (
   432	                VerifyState::Warning,
   433	                format!(
   434	                    "No management client: {} stay read-only until one is saved in Administration.",
   435	                    needing.join(", ")
   436	                ),
   437	                None,
   438	            )
   439	        };
   440	        steps.push(StepState {
   441	            step: VerifyStep {
   442	                line: VerifyLine::ManagementClient,
   443	                product: Some(ProductId::RuntimeSecurity),
   444	                state: management.0,
   445	                reason: management.1,
   446	            },
   447	            operation: management.2,
   448	        });
   449	        let chosen_workspace = self.setup_workspace_reference();
   450	        for product in products.iter().copied().filter(|p| needs_management(*p)) {
   451	            let (line, request) = match product {
   452	                // With a workspace chosen its prerequisites are read (the
   453	                // admitted scoped read); otherwise only the listing can be.
   454	                ProductId::Gateway => (
   455	                    VerifyLine::Gateway,
   456	                    match chosen_workspace.clone() {
   457	                        Some(reference) => ManagementRequest::Gateway {
   458	                            workspace: Some(reference),
   459	                            read: GatewayRead::Prerequisites,
   460	                        },
   461	                        None => ManagementRequest::Gateway {
   462	                            workspace: None,
   463	                            read: GatewayRead::Inventory {
   464	                                resource: GatewayResource::Workspaces,
   465	                            },
   466	                        },
   467	                    },
   468	                ),
   469	                ProductId::RedTeam => (
   470	                    VerifyLine::RedTeam,
   471	                    ManagementRequest::RedTeam { window: 7 },
   472	                ),
   473	                ProductId::ModelSkill => (VerifyLine::ModelSkill, ManagementRequest::SupplyChain),
   474	                ProductId::RuntimeSecurity => continue,
   475	            };
   476	            let (state_, reason, operation) = if !management_ready {
   477	                (
   478	                    VerifyState::Warning,
   479	                    "Needs the management client; not checked.".to_owned(),
   480	                    None,
   481	                )
   482	            } else {
   483	                match admit(self, request) {
   484	                    Some(op) => (VerifyState::Pending, "Reading…".to_owned(), Some(op)),
   485	                    None => (
   486	                        VerifyState::Fail,
   487	                        "The read could not be started.".to_owned(),
   488	                        None,
   489	                    ),
   490	                }
   491	            };
   492	            steps.push(StepState {
   493	                step: VerifyStep {
   494	                    line,
   495	                    product: Some(product),
   496	                    state: state_,
   497	                    reason,
   498	                },
   499	                operation,
   500	            });
   501	        }
   502	        // Products without an admitted service are listed, never checked.
   503	        for line in [VerifyLine::Ais, VerifyLine::Aes] {
   504	            steps.push(StepState {
   505	                step: VerifyStep {
   506	                    line,
   507	                    product: None,
   508	                    state: VerifyState::Unavailable,
   509	                    reason: "Not available in this release: no admitted service (D058).".to_owned(),
   510	                },
   511	                operation: None,
   512	            });
   513	        }
   514	        let setup = self.setup_for_mut(context)?;
   515	        setup.verify = Some(VerifyRun {
   516	            generation,
   517	            signature,
   518	            steps,
   519	        });
   520	        Ok(starts)
   521	    }
