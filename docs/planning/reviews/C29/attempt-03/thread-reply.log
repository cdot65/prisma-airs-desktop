   734	    /// The draft as the shell shows it.
   735	    pub(super) fn setup_view(&self) -> Option<SetupView> {
   736	        let setup = self.data.setup.as_ref()?;
   737	        let verify = Self::verify_view(setup);
   738	        let completable = verify
   739	            .as_ref()
   740	            .is_some_and(|v| v.done && !v.blocking && !v.stale);
   741	        let packs = setup
   742	            .products
   743	            .iter()
   744	            .map(|p| PackView {
   745	                product: *p,
   746	                count: case_products(*p)
   747	                    .iter()
   748	                    .map(|cp| {
   749	                        pack_counts()
   750	                            .iter()
   751	                            .find(|(c, _)| c == cp)
   752	                            .map_or(0, |(_, n)| *n)
   753	                    })
   754	                    .sum(),
   755	            })
   756	            .collect();
   757	        Some(SetupView {
   758	            mode: setup.mode,
   759	            context: setup.context.clone(),
   760	            tenant: super::tenant_view(&setup.tenant),
   761	            products: setup.products.clone(),
   762	            scan_required: setup.mode == SetupMode::FirstRun,
   763	            packs,
   764	            workspace: self.setup_workspace(&setup.context),
   765	            verify,
   766	            completable,
   767	        })
   768	    }
   769	
   770	    /// Commits the draft: it becomes a tenant with its products and the
   771	    /// verify warnings, is made active, and a first run's onboarding is
   772	    /// done. Refused unless the current inputs were verified without a
   773	    /// failure (the presentation cannot skip or forge a check).
   774	    pub(super) fn complete_setup(
   775	        &mut self,
   776	        context: &ContextRef,
   777	        packs: Vec<ProductId>,
   778	        recorded_secs: u32,
   779	    ) -> Result<Completed, Refusal> {
   780	        let setup = self.setup_for(context)?;
   781	        let view = Self::verify_view(setup).ok_or(Refusal::InvalidInput)?;
   782	        if !view.done || view.blocking || view.stale {
   783	            return Err(Refusal::InvalidInput);
   784	        }
   785	        if setup.mode == SetupMode::FirstRun
   786	            && !matches!(setup.tenant.scan, ScanCapability::Ready { .. })
   787	        {
   788	            return Err(Refusal::InvalidInput);
   789	        }
   790	        if packs.iter().any(|p| !setup.products.contains(p)) {
   791	            return Err(Refusal::InvalidInput);
   792	        }
   793	        if self.data.tenants.len() >= MAX_TENANTS {
   794	            return Err(Refusal::Busy);
   795	        }
   796	        let Some(mut setup) = self.data.setup.take() else {
   797	            return Err(Refusal::StaleContext);
   798	        };
   799	        let first_run = setup.mode == SetupMode::FirstRun;
   800	        setup.tenant.products = setup.products.clone();
   801	        for (n, w) in view.warnings.into_iter().take(MAX_WARNINGS).enumerate() {
   802	            setup
   803	                .tenant
   804	                .setup_warnings
   805	                .push(crate::features::SetupWarning {
   806	                    id: format!("vw-{}", n + 1),
   807	                    product: w.product,
   808	                    reason: w.reason,
   809	                    recorded_secs,
   810	                });
   811	        }
   812	        let id = setup.tenant.profile.id.clone();
   813	        self.data.tenants.push(setup.tenant);
   814	        self.data.active = Some(id.clone());
   815	        if first_run {
   816	            self.data.onboarding = Some(OnboardingState::Done);
   817	        }
   818	        let packs = packs
   819	            .iter()
   820	            .flat_map(|p| case_products(*p).iter().copied())
   821	            .collect();
   822	        Ok(Completed {
   823	            tenant: id,
   824	            first_run,
   825	            packs,
   826	        })
   827	    }
   828	
   829	    /// Drops the draft. Its Keychain records go to the cleanup queue; the
   830	    /// returned session records are the caller's to delete. No tenant,
   831	    /// selection or onboarding state changes.
   832	    pub(super) fn discard_setup(&mut self, context: &ContextRef) -> Result<Vec<RecordId>, Refusal> {
   833	        let id = self.setup_for(context)?.tenant.profile.id.clone();
   834	        let mut retired = Vec::new();
   835	        for class in [
   836	            CredentialClass::Scan,
   837	            CredentialClass::Management,
   838	            CredentialClass::Inference,
   839	        ] {
   840	            retired.extend(self.retire_class(&id, class));
   841	        }
   842	        self.data.setup = None;
