   224	    pub(super) fn reissue_setup_context(&mut self) {
   225	        let Some(old) = self.data.setup.as_ref().map(|s| s.context.clone()) else {
   226	            return;
   227	        };
   228	        self.epoch += 1;
   229	        let fresh = ContextRef::issue(&self.salt, self.epoch);
   230	        self.retire_management_binding(&old);
