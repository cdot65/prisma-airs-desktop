    outcome: {
        unknown: 'Sent but not confirmed. The current state is shown.',
        failed: 'Could not be delivered.',
        retry: 'Retry',
    },
    cancel: 'Cancel',
    cancelling: 'Discarding…',
    cancelFailed: 'The draft could not be discarded; it and its credentials are still here.',
    back: 'Back',
    cancelNote: 'Cancel discards this draft and removes any credential it saved. Nothing else changes.',
} as const

/** The products the wizard offers: admitted ones selectable, the rest shown as not available (DESIGN-V2 §6). */
export const PRODUCT_CARDS: { id: 'runtimeSecurity' | 'gateway' | 'redTeam' | 'modelSkill' | null; label: string; body: string; readOnly?: boolean }[] = [
    { id: 'runtimeSecurity', label: 'AI Runtime Security', body: 'Prompts, responses and tool calls are scanned as they happen.' },
    { id: 'gateway', label: 'AI Gateway', body: 'Workspaces, routes, providers, guardrails and keys.' },
    { id: 'redTeam', label: 'AI Red Teaming', body: 'Scan inventory, statistics and reports.', readOnly: true },
    { id: 'modelSkill', label: 'Model and skill scans', body: 'Model Security and AgentGuard skill scan summaries.', readOnly: true },
    { id: null, label: 'Agentic Identity Security', body: 'Needs an admitted AIS service (D058).' },
    { id: null, label: 'Agentic Endpoint Security', body: 'Needs an admitted AES service (D058).' },
]
