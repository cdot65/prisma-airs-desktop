    pub read_at: u32,
    pub window: u8,
    pub statistics: Option<RedTeamStatistics>,
    pub statistics_failure: Option<ManagementFailure>,
    pub scans: Option<RedTeamScans>,
    pub scans_failure: Option<ManagementFailure>,
}

