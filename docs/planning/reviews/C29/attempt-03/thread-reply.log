   301	    /// Records the chosen products (Runtime Security always, in first place).
   302	    pub(super) fn choose_setup_products(
   303	        &mut self,
   304	        context: &ContextRef,
   305	        products: Vec<ProductId>,
   306	    ) -> Result<(), Refusal> {
   307	        let setup = self.setup_for_mut(context)?;
   308	        setup.products = chosen(products);
   309	        Ok(())
   310	    }
