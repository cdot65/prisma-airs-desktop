   312	    /// A digest of every input verification depends on: profile, products
   313	    /// and the credential records. Results for another digest are stale.
   314	    fn setup_signature(setup: &Setup) -> u64 {
   315	        let mut h = DefaultHasher::new();
   316	        let p = &setup.tenant.profile;
   317	        p.label.hash(&mut h);
   318	        p.tsg_id.hash(&mut h);
   319	        p.destination.origin().hash(&mut h);
   320	        (p.environment as u8).hash(&mut h);
   321	        for product in &setup.products {
   322	            (*product as u8).hash(&mut h);
   323	        }
   324	        for class in [
   325	            CredentialClass::Scan,
   326	            CredentialClass::Management,
   327	            CredentialClass::Inference,
   328	        ] {
   329	            match setup.tenant.capability(class) {
   330	                ScanCapability::Ready { record, .. } => record.as_str().hash(&mut h),
   331	                ScanCapability::Storing { record, .. } => {
   332	                    "storing".hash(&mut h);
   333	                    record.as_str().hash(&mut h);
   334	                }
   335	                ScanCapability::Missing | ScanCapability::Failed { .. } => "none".hash(&mut h),
   336	            }
   337	        }
   338	        setup.tenant.management_client.hash(&mut h);
   339	        setup
   340	            .gateway
   341	            .selection
   342	            .as_ref()
   343	            .map(|s| s.workspace.id.as_str())
   344	            .hash(&mut h);
   345	        h.finish()
   346	    }
