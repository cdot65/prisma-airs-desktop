pub struct RedTeamScans {
    pub rows: Vec<RedTeamScan>,
    pub total: Option<u32>,
    /// The service capped its count: `total` is a lower bound.
    pub capped: bool,
    pub complete: bool,
}

/// One Red Teaming read: each source keeps its data or its failure.
