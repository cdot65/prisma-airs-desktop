{\n447:            .setup\n//! Gateway workspace selection inside the authority (C16). The workspaces\n//! a tenant context listed are remembered with that context; the operator\n//! chooses one of them, and a native [`WorkspaceRef`] names that choice.\n//! Workspace reads are admitted only with the current reference and read\n//! the workspace it names (never one the presentation supplies), under the\n//! reference as their operations domain: choosing another workspace\n//! retires them, and their results are withdrawn. A tenant context change\n//! (switch, credential replacement, reset) clears the listing and the\n//! choice. The choice is remembered per tenant and restored only when a\n//! later listing under a new context lists it again. Neither a choice nor a\n//! restore touches the tenant context, so Runtime reviews stay protected.\n\nuse serde::Serialize;\nuse tokio::time::Instant;\nuse ts_rs::TS;\n\nuse super::{Refusal, State, StorageHealth};\nuse crate::context::{ContextRef, WorkspaceRef};\nuse crate::gateway::{GatewayList, GatewayRead, GatewayResource, ListedWorkspace, WorkspaceScope};\nuse crate::management::ManagementRequest;\nuse crate::tenants::TenantId;\n\n/// The chosen workspace and the reference reads use.\n#[derive(Clone, Debug, PartialEq, Eq, Serialize, TS)]\n#[serde(rename_all = \"camelCase\")]\npub struct SelectedWorkspace {\n    pub reference: WorkspaceRef,\n    pub workspace: ListedWorkspace,\n    /// Restored from the tenant's remembered choice (not chosen this\n    /// session).\n    pub restored: bool,\n}\n\n/// The active context's Gateway workspace state.\n#[derive(Clone, Debug, PartialEq, Eq, Serialize, TS)]\n#[serde(rename_all = \"camelCase\")]\npub struct GatewayView {\n    /// The workspaces last listed under the active context (`None`: not\n    /// listed yet).\n    pub workspaces: Option<Vec<ListedWorkspace>>,\n    /// That listing was complete (absence from it is proven).\n    pub complete: bool,\n    pub selected: Option<SelectedWorkspace>,\n    /// The tenant's remembered workspace, while it is not selected.\n    pub remembered: Option<String>,\n    /// A complete listing did not list the remembered workspace.\n    pub remembered_missing: bool,\n    /// The tenant's Gateway drafts and uncertain changes on this Mac\n    /// (readable offline; C17).\n    pub local: super::gateway_local_domain::GatewayLocalView,\n    /// The Playground's run while it is bound to this context and\n    /// workspace (C18).\n    pub playground: Option<super::inference_domain::PlaygroundView>,\n    /// The chosen workspace's files while they are bound to this context,\n    /// workspace and inference key (C18).\n    pub files: Option<super::gateway_files_domain::GatewayFilesView>,\n}\n\nstruct Listing {\n    context: ContextRef,\n    workspaces: Vec<ListedWorkspace>,\n    complete: bool,\n}\n\n#[derive(Clone, Debug)]\npub(super) struct Selection {\n    pub(super) reference: WorkspaceRef,\n    pub(super) context: ContextRef,\n    pub(super) workspace: ListedWorkspace,\n    pub(super) restored: bool,\n}\n\n/// A setup draft's own Gateway listing and choice (C29): kept apart from\n/// the active tenant's, so a draft never clears or replaces the shell's\n/// selection and its late replies never reach the active tenant.\n#[derive(Clone, Debug, Default)]\npub(super) struct SetupGateway {\n    pub(super) workspaces: Option<Vec<ListedWorkspace>>,\n    pub(super) selection: Option<Selection>,\n}\n\n/// Where a Gateway read is admitted: its operations domain (the tenant\n/// context, or the selection reference for a scoped read), the reference\n/// it is bound to and the workspace it reads.\npub(super) struct GatewayAdmission {\n    pub domain: String,\n    pub workspace: Option<WorkspaceRef>,\n    pub scope: Option<WorkspaceScope>,\n}\n\n#[derive(Default)]\npub(super) struct GatewayState {\n    listing: Option<Listing>,\n    selection: Option<Selection>,\n    epoch: u64,\n    /// Work a retirement inside a settlement freed (started by the next\n    /// intent; normally none, since retired work still holds its slot).\n    pending: Vec<crate::runtime::Start>,\n}\n\nimpl State {\n    pub(super) fn gateway_view(&self) -> GatewayView {\n        let current = |context: &ContextRef| self.active_ref.as_ref() == Some(context);\n        let listing = self\n            .gateway\n            .listing\n            .as_ref()\n            .filter(|l| current(&l.context));\n        let selected = self\n            .gateway\n            .selection\n            .as_ref()\n            .filter(|s| current(&s.context))\n            .map(|s| SelectedWorkspace {\n                reference: s.reference.clone(),\n                workspace: s.workspace.clone(),\n                restored: s.restored,\n            });\n        let remembered = self\n            .data\n            .active\n            .as_ref()\n            .and_then(|id| self.tenant(id))\n            .and_then(|t| t.gateway_workspace.clone())\n            .filter(|id| selected.as_ref().is_none_or(|s| &s.workspace.id != id));\n        let remembered_missing = remembered.as_ref().is_some_and(|id| {\n            listing.is_some_and(|l| l.complete && !l.workspaces.iter().any(|w| &w.id == id))\n        });\n        GatewayView {\n            workspaces: listing.map(|l| l.workspaces.clone()),\n            complete: listing.is_some_and(|l| l.complete),\n            selected,\n            remembered,\n            remembered_missing,\n            local: self.gateway_local_view(),\n            playground: self.playground_view(),\n            files: self.files_view(),\n        }\n    }\n\n    fn issue_workspace(&mut self) -> WorkspaceRef {\n        self.gateway.epoch += 1;\n        WorkspaceRef::issue(&self.salt, self.gateway.epoch)\n    }\n\n    /// Retires every Gateway workspace read but `keep`'s, and every\n    /// change applying under another reference that has not sent its write.\n    fn retire_workspace_reads(\n        &mut self,\n        keep: Option<&WorkspaceRef>,\n    ) -> Vec<crate::runtime::Start> {\n        self.retire_scoped_applies(keep);\n        self.operations.retire_contexts(\n            WorkspaceRef::PREFIX,\n            keep.map(WorkspaceRef::as_str),\n            Instant::now(),\n        )\n    }\n\n    /// The tenant context changed: its listing and choice go with it.\n    pub(super) fn retire_gateway(&mut self) -> Vec<crate::runtime::Start> {\n        self.gateway.listing = None;\n        self.gateway.selection = None;\n        self.retire_workspace_reads(None)\n    }\n\n    /// Chooses a workspace the active context listed; remembered for the\n    /// tenant (a failed save refuses and leaves the previous choice).\n    pub(super) fn select_gateway_workspace(\n        &mut self,\n        context: &ContextRef,\n        workspace: &str,\n    ) -> Result<Vec<crate::runtime::Start>, Refusal> {\n        let tenant = self.check_context(context)?;\n        if self.is_setup_context(context) {\n1://! Management reads inside the authority (C08): one binding per credential\n77:/// The binding of one credential generation (context): its session and\n87:    fn management_binding(\n93:            .management_bindings\n103:        let binding = GenerationBinding {\n110:            binding.session.clone(),\n111:            Arc::clone(&binding.cell),\n112:            Arc::clone(&binding.investigation),\n114:        self.management_bindings.push(binding);\n118:    /// The active context's investigation, when its binding exists.\n120:        self.management_bindings\n126:    /// Cancels every binding but the current context's (its session ends\n128:    /// Retires the binding cached under one context (C29: a setup draft's\n130:    pub(super) fn retire_management_binding(&mut self, context: &ContextRef) {\n131:        self.management_bindings.retain(|b| {\n142:    pub(super) fn retire_management_bindings(&mut self) {\n144:        self.management_bindings.retain(|b| {\n158:    /// The active tenant's management binding inputs, checked: a ready\n162:    pub(super) fn binding_source(\n212:        let (session, binding, investigation) = self.management_binding(context, || {\n232:            binding,\n251:        let source = self.binding_source(&context, keychain, session_vault)?;\n341:        // A setup's verify reads (C29) belong to the draft's context and\n343:        let setup_context = self.data.setup.as_ref().map(|s| s.context.clone());\n344:        let setup_operations = self.setup_operations();\n345:        let mut setup_results = Vec::new();\n347:        let setup_selected = self.setup_workspace_reference();\n359:            let for_setup = setup_operations.contains(&record.operation);\n364:                && setup_context.as_ref() != Some(&record.context))\n366:                    selected.as_ref() != Some(w) && setup_selected.as_ref() != Some(w)\n417:            if for_setup {\n418:                // Consumed by the setup; nothing observes it.\n420:                setup_results.push((record.operation.clone(), result.clone()));\n427:        for (operation, result) in setup_results {\n428:            self.setup_settled(&operation, &result);\n485:            || self.is_setup_context(&context))\n            .find(|b| &b.context == context)\n        {\n            return (\n                b.session.clone(),\n                Arc::clone(&b.cell),\n                Arc::clone(&b.investigation),\n            );\n        }\n        let binding = GenerationBinding {\n            context: context.clone(),\n            session: Session::new(),\n            cell: BindingCell::default(),\n            investigation: Investigation::new(persistence()),\n        };\n        let triple = (\n            binding.session.clone(),\n            Arc::clone(&binding.cell),\n            Arc::clone(&binding.investigation),\n        );\n        self.management_bindings.push(binding);\n        triple\n    }\n\n    /// The active context's investigation, when its binding exists.\n    pub(super) fn investigation(&self, context: &ContextRef) -> Option<Arc<Investigation>> {\n        self.management_bindings\n            .iter()\n            .find(|b| &b.context == context)\n            .map(|b| Arc::clone(&b.investigation))\n    }\n\n    /// Cancels every binding but the current context's (its session ends\n    /// in-flight reads; its token cache is dropped with it).\n    /// Retires the binding cached under one context (C29: a setup draft's\n    /// context when its credentials or profile change).\n    pub(super) fn retire_management_binding(&mut self, context: &ContextRef) {\n        self.management_bindings.retain(|b| {\n            if &b.context == context {\n                b.session.cancel();\n                b.investigation.retire();\n                false\n            } else {\n                true\n            }\n        });\n    }\n\n    pub(super) fn retire_management_bindings(&mut self) {\n        let keep = self.active_ref.clone();\n        self.management_bindings.retain(|b| {\n            let current = Some(&b.context) == keep.as_ref();\n            if !current {\n                b.session.cancel();\n                // A write already admitted for this cache finds it retired\n                // and places nothing (the credential's cleanup may follow).\n                b.investigation.retire();\n            }\n            current\n        });\n    }\n\n    /// Admits one management read for the active tenant's management\n    /// capability. The scan key is never consulted.\n    /// The active tenant's management binding inputs, checked: a ready\n    /// management credential, its client ID and TSG, and the configured\n    /// token origin equal to the one the credential was stored for. The scan\n    /// key is never consulted.\n    pub(super) fn binding_source(\n        &mut self,\n        context: &ContextRef,\n        keychain: Arc<dyn super::CredentialStore>,\n        session_vault: Arc<SessionVault>,\n    ) -> Result<BindingSource, Refusal> {\n        let tenant = self.check_context(context)?;\n        let current = self.tenant(&tenant).ok_or(Refusal::StaleContext)?;\n        let (record, mode, destination) = match &current.management {\n            ScanCapability::Ready {\n                record,\n                mode,\n                destination,\n            } => (record.clone(), *mode, destination.clone()),\n            _ => return Err(Refusal::CapabilityMissing),\n        };\n        let client_id = current\n            .management_client\n            .clone()\n            .ok_or(Refusal::CapabilityMissing)?;\n        let tsg = current\n            .profile\n            .tsg_id\n            .clone()\n            .ok_or(Refusal::CapabilityMissing)?;\n        // The credential is bound to the token origin it was stored for; a\n        // different configured token origin never receives it.\n        let endpoints = self.management_endpoints.clone();\n        if endpoints.token_origin().as_deref() != Some(destination.as_str()) {\n            return Err(Refusal::CapabilityMissing);\n        }\n        let transport = self\n            .transport\n            .clone()\n            .ok_or(Refusal::CapabilityMissing)?\n            .for_tenant(\n                &self.calls,\n                crate::transport::CallTag {\n                    tenant: tenant.as_str().to_owned(),\n                    purpose: crate::transport::CallPurpose::Management,\n                    credential: crate::transport::CallCredential::ManagementClient,\n                },\n            )\n            .map_err(|_| Refusal::CapabilityMissing)?;\n        // Only a Keychain-stored credential's investigation is sealed on\n        // disk (its key in the same namespace); a session credential's stays\n        // in memory with its generation.\n        let root = self.sessions_root.clone();\n        let sealing: Arc<dyn crate::vault::Vault> = keychain.clone();\n        let credential = record.clone();\n        let (session, binding, investigation) = self.management_binding(context, || {\n            (mode == StorageMode::Keychain)\n                .then_some(root)\n                .flatten()\n                .map(|root| Persistence {\n                    root,\n                    credential,\n                    keychain: sealing,\n                })\n        });\n        Ok(BindingSource {\n            keychain,\n            session_vault,\n            record,\n            mode,\n            client_id,\n            tsg,\n            endpoints,\n            transport,\n            session,\n            binding,\n            investigation,\n        })\n    }\n//! Tenant profiles: nonsecret identity and approved scan destination.\n//!\n//! A tenant profile carries a native-issued ID, an operator label, an optional\n//! TSG identifier and the HTTPS origin its scan credential may be sent to. It\n//! never carries a secret; credentials are separate records bound to the\n//! profile's approved destination (see `vault`).\n\nuse serde::{Deserialize, Serialize};\nuse ts_rs::TS;\n\n/// Longest operator label, in characters.\npub const MAX_LABEL_CHARS: usize = 64;\n/// Longest TSG identifier, in digits.\npub const MAX_TSG_DIGITS: usize = 32;\n/// Longest custom origin, in bytes.\npub const MAX_ORIGIN_BYTES: usize = 2048;\n\n/// Native-issued tenant identifier (`tn-` + 16 hex digits). Deserialization\n/// accepts only that shape, so arbitrary text is never treated as an ID.\n#[derive(Clone, Debug, PartialEq, Eq, PartialOrd, Ord, Hash, Serialize, TS)]\n#[serde(transparent)]\npub struct TenantId(String);\n\nimpl<'de> Deserialize<'de> for TenantId {\n    fn deserialize<D: serde::Deserializer<'de>>(deserializer: D) -> Result<Self, D::Error> {\n        let text = String::deserialize(deserializer)?;\n        Self::parse(&text).ok_or_else(|| serde::de::Error::custom(\"not a tenant id\"))\n    }\n}\n\nimpl TenantId {\n    pub(crate) fn issue() -> Option<Self> {\n        let mut entropy = [0u8; 8];\n        getrandom::fill(&mut entropy).ok()?;\n        Some(Self(format!(\"tn-{}\", hex::encode(entropy))))\n    }\n\n    /// Accepts only the native-issued shape; other text is never an ID.\n    pub fn parse(text: &str) -> Option<Self> {\n        let hex_part = text.strip_prefix(\"tn-\")?;\n        (hex_part.len() == 16\n            && hex_part\n                .bytes()\n                .all(|b| matches!(b, b'0'..=b'9' | b'a'..=b'f')))\n        .then(|| Self(text.to_owned()))\n    }\n\n    pub fn as_str(&self) -> &str {\n        &self.0\n    }\n}\n\n/// AIRS scan regions offered by the SDK (`scm_sdk` `Region::endpoint`).\n#[derive(Clone, Copy, Debug, PartialEq, Eq, Serialize, Deserialize, TS)]\n#[serde(rename_all = \"camelCase\")]\npub enum Region {\n    UnitedStates,\n    Europe,\n    India,\n    Singapore,\n}\n\nimpl Region {\n    pub fn origin(self) -> &'static str {\n        match self {\n            Region::UnitedStates => \"https://service.api.aisecurity.paloaltonetworks.com\",\n            Region::Europe => \"https://service-de.api.aisecurity.paloaltonetworks.com\",\n            Region::India => \"https://service-in.api.aisecurity.paloaltonetworks.com\",\n            Region::Singapore => \"https://service-sg.api.aisecurity.paloaltonetworks.com\",\n        }\n    }\n}\n\n/// Where a tenant's scan requests (and therefore its scan key) may go.\n#[derive(Clone, Debug, PartialEq, Eq, Serialize, Deserialize, TS)]\n#[serde(tag = \"kind\", rename_all = \"camelCase\", deny_unknown_fields)]\npub enum Destination {\n    Region {\n        region: Region,\n    },\n    /// An operator-reviewed custom HTTPS origin (`https://host[:port]`).\n    Custom {\n        origin: String,\n    },\n}\n\nimpl Destination {\n    /// The exact origin credentials are bound to.\n    pub fn origin(&self) -> &str {\n        match self {\n            Destination::Region { region } => region.origin(),\n            Destination::Custom { origin } => origin,\n        }\n    }\n\n    /// Validates a draft and normalizes a custom origin to its ASCII origin.\n    pub fn validate(self) -> Option<Self> {\n        match self {\n            Destination::Region { .. } => Some(self),\n            Destination::Custom { origin } => {\n                normalize_origin(&origin).map(|origin| Destination::Custom { origin })\n            }\n        }\n    }\n}\n\n/// HTTPS origin only: host required; no userinfo, path, query or fragment.\npub fn normalize_origin(text: &str) -> Option<String> {\n    if text.is_empty() || text.len() > MAX_ORIGIN_BYTES || text.trim() != text {\n        return None;\n    }\n    let url = url::Url::parse(text).ok()?;\n    let plain = url.scheme() == \"https\"\n        && url.host_str().is_some_and(|h| !h.is_empty())\n        && url.username().is_empty()\n        && url.password().is_none()\n        && url.query().is_none()\n        && url.fragment().is_none()\n        && (url.path().is_empty() || url.path() == \"/\");\n    if !plain {\n        return None;\n    }\n    let origin = url.origin().ascii_serialization();\n    origin.starts_with(\"https://\").then_some(origin)\n}\n\n/// The nonsecret profile fields an operator supplies or imports.\n#[derive(Clone, Debug, PartialEq, Eq, Serialize, Deserialize, TS)]\n#[serde(rename_all = \"camelCase\", deny_unknown_fields)]\npub struct ProfileDraft {\n    pub label: String,\n    pub tsg_id: Option<String>,\n    pub destination: Destination,\n    /// Production / staging / other (C29); production when absent.\n    #[serde(default)]\n    pub environment: crate::features::TenantEnvironment,\n}\n\nimpl ProfileDraft {\n    /// Validates and normalizes the draft; `None` when any field is invalid.\n    pub fn validate(self) -> Option<Self> {\n        let label = self.label.trim().to_owned();\n        let label_ok = !label.is_empty()\n            && label.chars().count() <= MAX_LABEL_CHARS\n            && !label.chars().any(char::is_control);\n        let tsg_id = match self.tsg_id.map(|t| t.trim().to_owned()) {\n            None => None,\n            Some(t) if t.is_empty() => None,\n            Some(t) if t.len() <= MAX_TSG_DIGITS && t.bytes().all(|b| b.is_ascii_digit()) => {\n                Some(t)\n            }\n            Some(_) => return None,\n        };\n        let destination = self.destination.validate()?;\n        label_ok.then_some(Self {\n            label,\n            tsg_id,\n            destination,\n            environment: self.environment,\n        })\n    }\n}\n\n/// A stored tenant profile (nonsecret).\n#[derive(Clone, Debug, PartialEq, Eq, Serialize, Deserialize)]\n#[serde(rename_all = \"camelCase\", deny_unknown_fields)]\npub struct TenantProfile {\n    pub id: TenantId,\n    pub label: String,\n    pub tsg_id: Option<String>,\n    pub destination: Destination,\n    /// Production / staging / other (C29); production for older documents.\n    #[serde(default)]\n    pub environment: crate::features::TenantEnvironment,\n}\n\n#[cfg(test)]\nmod tests {\n    use super::*;\n\n    #[test]\n    fn origins_are_https_hosts_without_extra_parts() {\n        assert_eq!(\n            normalize_origin(\"https://Scan.Example.com:8443/\").as_deref(),\n            Some(\"https://scan.example.com:8443\")\n        );\n        assert_eq!(\n            normalize_origin(\"https://scan.example.com:443\").as_deref(),\n            Some(\"https://scan.example.com\")\n        );\n        for bad in [\n            \"http://scan.example.com\",\n            \"https://user:pw@scan.example.com\",\n            \"https://scan.example.com/v1\",\n            \"https://scan.example.com?x=1\",\n            \"https://scan.example.com#f\",\n            \" https://scan.example.com\",\n            \"file:///etc/passwd\",\n            \"https://\",\n            \"\",\n        ] {\n            assert_eq!(normalize_origin(bad), None, \"{bad}\");\n        }\n    }\n\n    #[test]\n    fn drafts_are_trimmed_and_bounded() {\n        let draft = |label: &str, tsg: Option<&str>| ProfileDraft {\n            label: label.to_owned(),\n            tsg_id: tsg.map(str::to_owned),\n            destination: Destination::Region {\n                region: Region::Europe,\n            },\n            environment: Default::default(),\n        };\n        let ok = draft(\"  Prod EU \", Some(\" 1234567890 \"))\n            .validate()\n            .expect(\"valid\");\n        assert_eq!(\n            (ok.label.as_str(), ok.tsg_id.as_deref()),\n            (\"Prod EU\", Some(\"1234567890\"))\n        );\n        assert_eq!(draft(\"x\", Some(\"\")).validate().expect(\"valid\").tsg_id, None);\n        assert!(draft(\"\", None).validate().is_none());\n        assert!(draft(&\"x\".repeat(65), None).validate().is_none());\n        assert!(draft(\"tab\\there\", None).validate().is_none());\n        assert!(draft(\"ok\", Some(\"12a\")).validate().is_none());\n    }\n\n    #[test]\n    fn tenant_ids_have_the_issued_shape_only() {\n        let id = TenantId::issue().expect(\"entropy\");\n        assert_eq!(TenantId::parse(id.as_str()), Some(id));\n        for bad in [\n            \"tn-\",\n            \"tn-ABCDEF0123456789\",\n            \"tn-0123456789abcdef0\",\n            \"x-0123456789abcdef\",\n        ] {\n            assert!(TenantId::parse(bad).is_none(), \"{bad}\");\n        }\n    }\n}\n","exit_code":0,"status":"completed"}}
