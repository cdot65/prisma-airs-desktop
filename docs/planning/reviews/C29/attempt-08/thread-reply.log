{"type":"item.completed","item":{"id":"item_44","type":"command_execution","command":"/bin/zsh -lc \"sed -n '1,235p' apps/desktop/src/v2/modal.tsx; cat apps/desktop/src/app.tsx; sed -n '553,670p' apps/desktop/src-tauri/tests/ipc_admission.rs\"","aggregated_output":"import { useEffect, useId, useRef, type KeyboardEvent, type ReactNode } from 'react'\nimport { useShellStore } from './store'\n\ninterface ModalProps {\n    label: string\n    onClose: () => void\n    children: ReactNode\n    /** Width in CSS px (default 560). */\n    width?: number\n    /** Inner padding in CSS px (default 20); 0 for a dialog that lays itself out edge to edge. */\n    padding?: number\n    /** Distance from the top of the window in CSS px (default 4vh); the prototype's palette sits at 90. */\n    top?: number\n    /** Corner radius in CSS px (default 12; the palette's frame is 14). */\n    radius?: number\n    /** A sheet docked to the window's right edge under the header (R2App's review sheet, 620px wide, full height). */\n    sheet?: boolean\n    /**\n     * The control focus returns to on close when the opener itself will be gone\n     * by then (a menu item that closes with its menu as the dialog opens): an\n     * explicit surviving target instead of whatever had focus at mount.\n     */\n    returnFocus?: HTMLElement | null\n    'data-slot'?: string\n}\n\nconst FOCUSABLE = 'a[href], button:not([disabled]), input:not([disabled]), select:not([disabled]), textarea:not([disabled]), [tabindex]:not([tabindex=\"-1\"])'\n\n/**\n * One topmost modal (I8): dialogs register on a shell-wide stack; only the\n * last is interactive. Lower dialogs are inert and aria-hidden, Tab and\n * Shift-Tab stay inside the topmost dialog, Escape closes the topmost only,\n * focus moves into the dialog on open and back to the opener on close. The\n * page behind every dialog is made inert by the shell (`useModalsOpen`).\n * The dialog element handles its own keys; the topmost dialog also listens\n * on the window for Escape alone, for when focus has left it (a native\n * sheet returned focus elsewhere), and closes only itself.\n */\nexport function Modal({ label, onClose, children, width = 560, padding = 20, top, radius = 12, sheet = false, returnFocus = null, ...rest }: ModalProps) {\n    const id = useId()\n    const pushModal = useShellStore((s) => s.pushModal)\n    const popModal = useShellStore((s) => s.popModal)\n    const modals = useShellStore((s) => s.modals)\n    const topmost = modals.length > 0 && modals[modals.length - 1] === id\n    const dialog = useRef<HTMLDivElement>(null)\n    const opener = useRef<HTMLElement | null>(null)\n    const returnRef = useRef(returnFocus)\n    returnRef.current = returnFocus\n    const focusedOnce = useRef(false)\n\n    useEffect(() => {\n        opener.current = document.activeElement instanceof HTMLElement ? document.activeElement : null\n        pushModal(id)\n        return () => {\n            popModal(id)\n            // After the commit: the page behind is still inert during cleanup,\n            // and an inert ancestor refuses focus (observed in WebKit).\n            const target = returnRef.current ?? opener.current\n            queueMicrotask(() => {\n                // Only when nothing else took focus meanwhile (⌘T replacing the\n                // palette hands focus to the tenant list, which must keep it).\n                const active = document.activeElement\n                if (active && active !== document.body) return\n                // The opener may be gone (a \"Finish rotation…\" that completed):\n                // focus the page heading rather than leave it on nothing.\n                if (target?.isConnected) target.focus()\n                else document.querySelector<HTMLElement>('main h1[tabindex=\"-1\"]')?.focus()\n            })\n        }\n    }, [id, pushModal, popModal])\n\n    useEffect(() => {\n        // Initial focus goes into the dialog once, when it opens. Regaining the\n        // top after a higher dialog closes must not refocus: that dialog is\n        // restoring its own opener, which may be any control here.\n        if (!topmost || focusedOnce.current) return\n        const node = dialog.current\n        if (!node) return\n        focusedOnce.current = true\n        if (!node.contains(document.activeElement)) {\n            // A declared initial control first (wherever it sits), else the first focusable.\n            const first = node.querySelector<HTMLElement>('[autofocus]') ?? node.querySelector<HTMLElement>(FOCUSABLE)\n            ;(first ?? node).focus()\n        }\n    }, [topmost])\n\n    // Escape still closes the topmost dialog when focus has left it (a\n    // native sheet returning focus to the page body, a click on the scrim's\n    // edge): the dialog's own handler stops the event first when it has focus.\n    const closeRef = useRef(onClose)\n    closeRef.current = onClose\n    useEffect(() => {\n        if (!topmost) return\n        const onWindowKey = (event: globalThis.KeyboardEvent) => {\n            if (event.key !== 'Escape' || event.defaultPrevented) return\n            const node = dialog.current\n            if (node && node.contains(document.activeElement)) return\n            event.preventDefault()\n            closeRef.current()\n        }\n        window.addEventListener('keydown', onWindowKey)\n        return () => window.removeEventListener('keydown', onWindowKey)\n    }, [topmost])\n\n    const onKeyDown = (event: KeyboardEvent<HTMLDivElement>) => {\n        if (!topmost) return\n        if (event.key === 'Escape') {\n            event.preventDefault()\n            event.stopPropagation()\n            onClose()\n            return\n        }\n        if (event.key === 'Tab') {\n            // Keyboard interaction stays inside the topmost dialog.\n            const node = dialog.current\n            if (!node) return\n            const items = Array.from(node.querySelectorAll<HTMLElement>(FOCUSABLE)).filter((el) => !el.hasAttribute('hidden') && el.getAttribute('aria-hidden') !== 'true')\n            if (items.length === 0) {\n                event.preventDefault()\n                node.focus()\n                return\n            }\n            const first = items[0] as HTMLElement\n            const last = items[items.length - 1] as HTMLElement\n            const active = document.activeElement\n            if (event.shiftKey && (active === first || active === node)) {\n                event.preventDefault()\n                last.focus()\n            } else if (!event.shiftKey && active === last) {\n                event.preventDefault()\n                first.focus()\n            }\n        }\n    }\n\n    return (\n        <div\n            className={sheet ? 'fixed z-50 flex justify-end' : 'fixed inset-0 z-50 grid place-items-start justify-center'}\n            style={sheet ? { inset: 'var(--v2-header, 56px) 0 0 0' } : { paddingTop: top ?? '4vh' }}\n            data-v2-scrim=''\n            aria-hidden={topmost ? undefined : true}\n            inert={topmost ? undefined : true}\n            onMouseDown={() => topmost && onClose()}\n        >\n            <div\n                ref={dialog}\n                role='dialog'\n                aria-modal={topmost ? 'true' : undefined}\n                aria-label={label}\n                tabIndex={-1}\n                data-slot={rest['data-slot'] ?? 'modal'}\n                data-topmost={topmost ? 'true' : 'false'}\n                onKeyDown={onKeyDown}\n                onMouseDown={(e) => e.stopPropagation()}\n                className='border'\n                // Bounded to the viewport: a tall dialog scrolls inside itself, so its\n                // actions stay reachable at the minimum window size and 200% zoom.\n                style={\n                    sheet\n                        ? { width: `min(${width}px, 100vw)`, height: '100%', overflowY: 'auto', padding, borderRadius: 0, borderLeft: '1px solid var(--v2-rule)', boxShadow: '-18px 0 40px rgba(0,0,0,0.18)', background: 'var(--v2-bg)', borderWidth: 0, color: 'var(--v2-ink)' }\n                        : { width: `min(${width}px, 92vw)`, maxHeight: '92vh', overflowY: 'auto', padding, borderRadius: radius, boxShadow: '0 24px 60px rgba(0,0,0,0.3)', background: 'var(--v2-paper)', borderColor: 'var(--v2-rule)', color: 'var(--v2-ink)' }\n                }\n            >\n                {children}\n            </div>\n        </div>\n    )\n}\n\n/** Whether any modal is open: the shell makes the page behind it inert. */\nexport function useModalsOpen(): boolean {\n    return useShellStore((s) => s.modals.length > 0)\n}\nimport { useCallback, useEffect, useLayoutEffect, useRef, useState } from 'react'\nimport {\n    DeliveryOutcomeUnknown,\n    type DesktopClient,\n    type FeatureId,\n    type Intent,\n    type MenuCommand,\n    type Refusal,\n    type ShellSnapshot,\n    type Theme,\n} from '@prisma-airs/desktop-contracts'\nimport { followAppearance } from './shell/appearance'\nimport { type DispatchOutcome, outcomeMessage } from './features/tenants/dispatch'\nimport { V2Shell } from './v2/v2-shell'\nimport { Wizard } from './v2/wizard/wizard'\nimport { useShellStore } from './v2/store'\nimport { SHELL_COPY } from './v2/copy'\nimport { forgetAcademyPresentation } from './features/academy/presentation-storage'\nimport { SAVE_DOCUMENT_EVENT } from './v2/workbench/request-editor'\n\nexport function App({ client }: { client: DesktopClient }) {\n    const [snapshot, setSnapshot] = useState<ShellSnapshot | null>(null)\n    const snapshotRef = useRef<ShellSnapshot | null>(null)\n    snapshotRef.current = snapshot\n    const [failure, setFailure] = useState<string | null>(null)\n    const [pending, setPending] = useState(false)\n    const [status, setStatus] = useState('')\n\n    const dispatch = useCallback(\n        async (intent: Intent): Promise<DispatchOutcome> => {\n            try {\n                const response = await client.dispatch(intent)\n                return response.outcome === 'refusal'\n                    ? { kind: 'refused', refusal: response.refusal }\n                    : { kind: 'admitted', operation: response.receipt.operation }\n            } catch (error) {\n                return error instanceof DeliveryOutcomeUnknown ? { kind: 'unknown' } : { kind: 'failed' }\n            }\n        },\n        [client]\n    )\n\n    // v2 (C28): navigation is Rust-owned. The native menu, the sidebar and\n    // the palette all dispatch `navigate`; refusals reach the status surface.\n    const v2Navigate = useCallback(\n        async (feature: FeatureId) => {\n            useShellStore.getState().closePalette()\n            const intent: Intent = { kind: 'navigate', feature }\n            const outcome = await dispatch(intent)\n            if (outcome.kind === 'refused') useShellStore.getState().toast(SHELL_COPY.toastRefused('Navigation', outcome.refusal), 'warn')\n            // Unknown delivery is kept inline with Retry; never an expiring toast alone.\n            else if (outcome.kind === 'unknown') useShellStore.getState().addUnconfirmed('Navigation', intent)\n            else if (outcome.kind === 'failed') useShellStore.getState().toast(SHELL_COPY.toastFailed('Navigation'), 'warn')\n        },\n        [dispatch]\n    )\n    // Every v2 action's outcome reaches the shell's surfaces (DESIGN-V2 §7):\n    // a refusal or failed delivery as a warn toast naming what was asked, an\n    // unconfirmed delivery inline with Retry, never replayed on its own.\n    const v2Act = useCallback(\n        async (what: string, intent: Intent, quiet: Refusal[] = []): Promise<DispatchOutcome> => {\n            // A context-bound action speaks for the tenant it was sent in (I2).\n            const boundContext = typeof (intent as { context?: unknown }).context === 'string' ? (intent as { context: string }).context : null\n            const bound = boundContext !== null ? (snapshotRef.current?.active?.tenant ?? null) : null\n            const outcome = await dispatch(intent)\n            if (outcome.kind === 'refused' && quiet.includes(outcome.refusal)) return outcome\n            if (outcome.kind === 'refused') useShellStore.getState().toast(SHELL_COPY.toastRefused(what, outcome.refusal, outcomeMessage(outcome)), 'warn', undefined, bound, boundContext)\n            else if (outcome.kind === 'unknown') useShellStore.getState().addUnconfirmed(what, intent)\n            else if (outcome.kind === 'failed') useShellStore.getState().toast(SHELL_COPY.toastFailed(what), 'warn', undefined, bound, boundContext)\n            return outcome\n        },\n        [dispatch]\n    )\n    const v2Preference = useCallback(\n        async (what: string, intent: Intent, quiet: Refusal[] = []) => {\n            await v2Act(what, intent, quiet)\n        },\n        [v2Act]\n    )\n\n    const onMenu = useRef<(command: MenuCommand) => void>(() => undefined)\n    onMenu.current = (command: MenuCommand) => {\n        // Native navigation dismisses the modal palette first so focus can\n        // move to the new page heading instead of behind an open dialog.\n        if (command.kind === 'navigate') void v2Navigate(command.feature)\n        else if (command.kind === 'commandPalette') useShellStore.getState().openPalette()\n        // ⌘T: the tenant switcher opens; nothing switches until chosen.\n        else if (command.kind === 'tenantSwitcher') useShellStore.getState().setSwitcher(true)\n        // The open API Client request saves (its editor listens).\n        else if (command.kind === 'saveDocument') window.dispatchEvent(new Event(SAVE_DOCUMENT_EVENT))\n        else void v2Preference('The appearance change', { kind: 'setAppearance', theme: command.theme })\n    }\n\n    useEffect(() => {\n        let stop: (() => void) | undefined\n        let cancelled = false\n        client\n            .observeShell({\n                onSnapshot: (next) => {\n                    // The shell's scope follows the snapshot before it renders: a\n                    // notification for another tenant or context is never surfaced.\n                    useShellStore.getState().setScope(next.active?.tenant ?? null, next.active?.context ?? null)\n                    setSnapshot(next)\n                },\n                onMenu: (command) => onMenu.current(command),\n                onError: () => setFailure('The desktop sent an unexpected update.'),\n            })\n            .then(\n                (unsubscribe) => {\n                    if (cancelled) unsubscribe()\n                    else stop = unsubscribe\n                },\n                () => setFailure('The desktop shell could not be observed.')\n            )\n        return () => {\n            cancelled = true\n            stop?.()\n        }\n    }, [client])\n\n    // A completed reset also forgets Academy's WebView presentation state\n    // (completion latches keyed by account); a stopped reset keeps it.\n    const storage = snapshot?.storage\n    const resetFailed = Boolean(snapshot?.resetFailure)\n    const previousStorage = useRef(storage)\n    useEffect(() => {\n        if (previousStorage.current === 'resetting' && storage !== 'resetting' && !resetFailed) {\n            forgetAcademyPresentation()\n        }\n        previousStorage.current = storage\n    }, [storage, resetFailed])\n\n    const appearance = snapshot?.appearance\n    // Apply the theme in the same commit as the snapshot, before paint, so\n    // the shell never shows a frame in the previous theme.\n    useLayoutEffect(() => (appearance ? followAppearance(appearance) : undefined), [appearance])\n\n    if (failure && !snapshot) {\n        return (\n            <main role='alert' className='text-academy-ink p-8'>\n                {failure}\n            </main>\n        )\n    }\n    if (!snapshot) {\n        return (\n            <main role='status' aria-live='polite' className='text-academy-ink-soft p-8'>\n                Starting Prisma AIRS Desktop…\n            </main>\n        )\n    }\n    if (snapshot.onboarding !== 'done') {\n        // First run: the wizard owns the window (D060: no alpha import; nothing leaves it before a tenant exists).\n        return (\n            <div data-v2-shell=''>\n                <Wizard\n                    snapshot={snapshot}\n                    dispatch={dispatch}\n                    observeManagement={(operation) => client.observeManagement(operation)}\n                    mode='firstRun'\n                    onClose={() => undefined}\n                    onNavigate={(feature) => void v2Navigate(feature)}\n                />\n            </div>\n        )\n    }\n    return (\n        <V2Shell\n            snapshot={snapshot}\n            appearancePending={pending}\n            status={failure ?? status}\n            onNavigate={(feature) => void v2Navigate(feature)}\n            onSetAppearance={(theme) => void v2Preference('The appearance change', { kind: 'setAppearance', theme })}\n            onSetShowCalls={(on) => void v2Preference('The preference change', { kind: 'setShowCalls', on })}\n            onSwitchTenant={(tenant, resolution) => {\n                // The target is captured now: a late refusal still names it. A\n                // pending-decision refusal is not a toast: the snapshot carries\n                // the guard the shell renders (I1).\n                const label = snapshot.tenants.find((t) => t.id === tenant)?.label ?? tenant\n                void v2Preference(SHELL_COPY.switchTo(label), { kind: 'selectTenant', tenant, resolution: resolution ?? null }, ['decisionPending'])\n            }}\n            onReadNow={() => {\n                // The palette's Read now is the same finite read of every chosen product (I4).\n                const active = snapshot.active\n                if (!active) return\n                const label = snapshot.tenants.find((t) => t.id === active.tenant)?.label ?? active.tenant\n                void v2Preference(SHELL_COPY.readOf(label), { kind: 'readTenant', context: active.context })\n            }}\n            onRetry={(what, intent) => void v2Preference(what, intent)}\n            onAct={v2Act}\n            dispatch={dispatch}\n            client={client}\n        />\n    )\n}\nfn setup_draft_intents_cross_ipc_without_echoing_secrets_or_creating_tenants() {\n    let h = harness();\n    let session = register(&h);\n    let begun = send(\n        &h,\n        &session,\n        1,\n        json!({\"kind\": \"beginTenantSetup\", \"mode\": \"add\", \"profile\": {\n        \"label\": \"Drafted\", \"tsgId\": \"1234567890\", \"destination\": {\"kind\": \"region\", \"region\": \"europe\"},\n        \"environment\": \"staging\"}}),\n    );\n    assert_eq!(begun.expect(\"begun\")[\"outcome\"], \"receipt\");\n    let snap = snapshot(&h, 20);\n    assert_eq!(\n        snap[\"tenants\"].as_array().map(Vec::len),\n        Some(0),\n        \"a draft is not a tenant\"\n    );\n    assert!(snap[\"active\"].is_null());\n    let setup = &snap[\"setup\"];\n    assert_eq!(setup[\"mode\"], \"add\");\n    assert_eq!(setup[\"tenant\"][\"environment\"], \"staging\");\n    assert_eq!(setup[\"scanRequired\"], false);\n    let context = setup[\"context\"].as_str().expect(\"draft context\").to_owned();\n    let key = \"synthetic-ipc-draft-scan-key-0042\";\n    let secret = \"synthetic-ipc-draft-client-secret-0042\";\n    let stored = send(\n        &h,\n        &session,\n        2,\n        json!({\"kind\": \"configureScanCredential\", \"context\": context, \"mode\": \"session\", \"key\": key}),\n    )\n    .expect(\"admitted\");\n    assert_eq!(stored[\"outcome\"], \"receipt\");\n    assert!(!stored.to_string().contains(key));\n    // The scan key retired the draft's context (a credential change always does).\n    let context = snapshot(&h, 21)[\"setup\"][\"context\"]\n        .as_str()\n        .expect(\"fresh draft context\")\n        .to_owned();\n    let client = send(\n        &h,\n        &session,\n        3,\n        json!({\"kind\": \"configureManagementCredential\", \"context\": context, \"mode\": \"session\",\n        \"clientId\": \"svc@1234567890.iam.example\", \"secret\": secret}),\n    )\n    .expect(\"admitted\");\n    assert!(!client.to_string().contains(secret));\n    assert!(eventually(|| {\n        let s = snapshot(&h, 21);\n        s[\"setup\"][\"tenant\"][\"scan\"][\"state\"] == \"ready\"\n            && s[\"setup\"][\"tenant\"][\"management\"][\"state\"] == \"ready\"\n    }));\n    let snap = snapshot(&h, 22);\n    let text = snap.to_string();\n    assert!(\n        !text.contains(key) && !text.contains(secret),\n        \"no snapshot carries a secret\"\n    );\n    assert_eq!(\n        snap[\"setup\"][\"tenant\"][\"management\"][\"clientId\"],\n        \"svc@1234567890.iam.example\"\n    );\n    assert_eq!(\n        snap[\"tenants\"].as_array().map(Vec::len),\n        Some(0),\n        \"still not a tenant\"\n    );\n    assert!(\n        h.adapters.vault.calls().is_empty(),\n        \"session-only never reaches the Keychain\"\n    );\n    // (Verification is not run here: the fixture host has no synthetic management plane,\n    // and a routine host test must never reach a product service; the core and reads\n    // suites cover it.) Each credential change retired the draft's context: re-read it.\n    let context = snapshot(&h, 24)[\"setup\"][\"context\"]\n        .as_str()\n        .expect(\"fresh draft context\")\n        .to_owned();\n    let discarded = send(\n        &h,\n        &session,\n        4,\n        json!({\"kind\": \"discardTenantSetup\", \"context\": context}),\n    )\n    .expect(\"discard\");\n    assert_eq!(discarded[\"outcome\"], \"receipt\");\n    let snap = snapshot(&h, 25);\n    assert!(snap[\"setup\"].is_null());\n    assert_eq!(snap[\"tenants\"].as_array().map(Vec::len), Some(0));\n    let stale = send(\n        &h,\n        &session,\n        5,\n        json!({\"kind\": \"verifyTenantSetup\", \"context\": context}),\n    );\n    assert_eq!(\n        stale.expect(\"refusal\"),\n        json!({\"outcome\": \"refusal\", \"refusal\": \"staleContext\"})\n    );\n}\n","exit_code":0,"status":"completed"}}
