>\n                                                                <Primary label={C.tenant.saveWorkspaceKey} disabled={busy} />\n                                                            </div>\n                                                        </form>\n                                                    )}\n                                                </div>\n                                            )}\n                                        </OptionalCard>\n                                    </>\n                                )}\n                            </>\n                        )}\n                        {step === 'products' && setup && (\n                            <>\n                                <div>\n                                    <h1 ref={heading} id={headingId} tabIndex={-1} className='font-bold' style={{ fontSize: 26, letterSpacing: '-0.01em' }}>\n                                        {C.products.title}\n                                    </h1>\n                                    <p className='text-[14px]' style={{ marginTop: 4, color: 'var(--v2-soft)' }}>\n                                        {C.products.lead(setup.tenant.label)}\n                                    </p>\n                                </div>\n                                <div className='grid' style={{ gridTemplateColumns: 'repeat(3, minmax(0, 1fr))', gap: 12 }} data-slot='product-cards'>\n                                    {PRODUCT_CARDS.map((card) => {\n                                        // An id without spaces (a label is not one): the description's targets.\n                                        const cardId = `product-${card.label.replace(/\\W+/g, '-').toLowerCase()}`\n                                        const unavailable = card.id === null\n                                        const always = card.id === 'runtimeSecurity'\n                                        const on = card.id !== null && setup.products.includes(card.id)\n                                        const reads = card.id === null ? null : card.id === 'runtimeSecurity' ? (scanReady ? C.products.readsWith.scanReady : C.products.readsWith.scanMissing) : clientReady ? C.products.readsWith.clientReady : C.products.readsWith.clientMissing\n                                        const lastStep = run && !run.stale && card.id ? run.steps.find((s) => s.product === card.id && s.line !== 'managementClient') : undefined\n                                        const missing = reads === C.products.readsWith.clientMissing || reads === C.products.readsWith.scanMissing\n                                        return (\n                                            // A label around a native checkbox, not a checkbox-role button: a checkbox's children are\n                                            // presentational to assistive technology, which hid the body and the tags (\"Always on\",\n                                            // \"Not available in this release\"); as the label's text they are read, and the control keeps\n                                            // the card's name, description and state. The card shows the control's focus ring.\n                                            <label\n                                                key={card.label}\n                                                className='relative flex flex-col text-left'\n                                                style={{ gap: 10, minHeight: 176, padding: '18px 20px', border: `1.5px solid ${on ? 'var(--v2-acc)' : 'var(--v2-rule)'}`, borderRadius: 12, background: on ? 'var(--v2-acc-soft)' : 'var(--v2-paper)', color: 'var(--v2-ink)', opacity: unavailable ? 0.7 : 1, cursor: unavailable || always ? 'default' : 'pointer' }}\n                                                data-slot='product-card'\n                                            >\n                                                <input\n                                                    type='checkbox'\n                                                    className='sr-only'\n                                                    checked={on}\n                                                    aria-disabled={unavailable || always ? true : undefined}\n                                                    aria-label={card.label}\n                                                    aria-describedby={`${cardId}-body ${cardId}-tags`}\n                                                    onChange={() => card.id && !always && void toggleProduct(card.id, !on)}\n                                                    data-slot='product-choice'\n                                                />\n                                                <span className='absolute grid place-items-center rounded-full' style={{ top: 14, right: 14, width: 20, height: 20, border: `1.5px solid ${on ? 'var(--v2-acc)' : 'var(--v2-ctl)'}`, background: on ? 'var(--v2-acc)' : 'transparent', color: 'var(--v2-acc-ink)' }}>\n                                                    {on && <Glyph name='check' size={11} color='var(--v2-acc-ink)' />}\n                                                </span>\n                                                <span className='grid place-items-center rounded-[10px]' style={{ width: 36, height: 36, background: on ? 'var(--v2-acc)' : 'var(--v2-inset)', color: on ? 'var(--v2-acc-ink)' : 'var(--v2-soft)' }}>\n                                                    <Glyph name={card.icon} size={18} color={on ? 'var(--v2-acc-ink)' : 'var(--v2-soft)'} />\n                                                </span>\n                                                <span className='block leading-[1.35]' style={{ paddingRight: 26 }}>\n                                                    <b className='text-[14px]'>{card.label}</b>\n                                                </span>\n                                                <span id={`${cardId}-body`} className='leading-[1.45]' style={{ color: 'var(--v2-soft)' }}>\n                                                    {card.body}\n                                                </span>\n                                                <span id={`${cardId}-tags`} className='mt-auto flex flex-wrap' style={{ gap: 6 }}>\n                                                    {unavailable && <Verdict tone='info' word={C.products.unavailable} />}\n                                                    {always && <Verdict tone='info' word={C.products.always} />}\n                                                    {card.readOnly && <Verdict tone='info' word={C.products.readOnly} />}\n                                                    {reads && !unavailable && <Verdict tone={missing ? 'flagged' : 'allowed'} word={reads} />}\n                                                    {lastStep && lastStep.state !== 'pending' && <Verdict tone={toneOf(lastStep.state)} word={C.verify.state[lastStep.state]} />}\n                                                </span>\n                                            </label>\n                                        )\n                                    })}\n                                </div>\n                                {!scanReady && (\n                                    <div className='flex items-center rounded-[8px] leading-[1.45]' style={{ gap: 8, padding: '10px 12px', background: 'var(--v2-flag-bg)' }} data-slot='no-scan-banner'>\n                                        <Glyph name='alert' size={15} color='var(--v2-flag)' className='shrink-0' />\n                                        <span className='flex-grow'>{C.products.noScan}</span>\n                                        <Secondary label={C.products.addScanKey} onClick={() => go(steps.indexOf('tenant'))} />\n                                    </div>\n                                )}\n                                <p className='text-[12px]' style={{ color: 'var(--v2-faint)' }}>\n                                    {C.products.licence}\n                                </p>\n                            </>\n                        )}\n                        {step === 'verify' && setup && (\n                            <>\n                                <div>\n                                    <h1 ref={heading} id={headingId} tabIndex={-1} className='font-bold' style={{ fontSize: 26, letterSpacing: '-0.01em' }}>\n                                        {C.verify.title}\n                                    </h1>\n                                    <p className='text-[14px]' style={{ marginTop: 4, color: 'var(--v2-soft)' }}>\n                                        {C.verify.lead(setup.tenant.label)}\n                                    </p>\n                                </div>\n                                <div role='status' aria-live='polite' className='flex items-center rounded-[12px]' style={{ gap: 12, padding: '14px 16px', background: !run ? 'var(--v2-inset)' : run.stale || run.blocking ? 'var(--v2-block-bg)' : running ? 'var(--v2-acc-soft)' : run.failed || run.warnings.length ? 'var(--v2-flag-bg)' : 'var(--v2-ok-bg)' }} data-slot='verify-banner'>\n                                    <Glyph name={!run || running ? 'clock' : run.stale || run.blocking ? 'ban' : run.failed || run.warnings.length ? 'alert' : 'check'} size={22} color={!run ? 'var(--v2-soft)' : run.stale || run.blocking ? 'var(--v2-block)' : running ? 'var(--v2-acc)' : run.failed || run.warnings.length ? 'var(--v2-flag)' : 'var(--v2-ok)'} className='shrink-0' />\n                                    <span className='flex-grow'>\n                                        <b className='text-[14px]'>{!run ? C.verify.notRunTitle : verifyStatus}</b>\n                                        <br />\n                                        <span style={{ color: 'var(--v2-soft)' }}>{!run ? C.verify.notRunText : running ? C.verify.runningText : run.stale ? C.verify.staleText : run.blocking ? C.verify.failedText : run.failed ? C.verify.failedOptionalText : C.verify.doneText}</span>\n                                    </span>\n                                    {run && run.done && run.failed && !run.stale && <Secondary label={C.verify.editCredentials} onClick={() => go(steps.indexOf('tenant'))} />}\n                                </div>\n                                <ul className='flex flex-col overflow-hidden rounded-[12px] border' aria-label='Checks' aria-busy={running} style={{ borderColor: 'var(--v2-rule)', background: 'var(--v2-paper)', opacity: run?.stale ? 0.6 : 1 }}>\n                                    {plannedRows.map((r, i) => {\n                                        const tone = run || r.state === 'unavailable' ? toneOf(r.state) : 'info'\n                                        const colors: [string, string, GlyphName] = tone === 'allowed' ? ['var(--v2-ok-bg)', 'var(--v2-ok)', 'check'] : tone === 'flagged' ? ['var(--v2-flag-bg)', 'var(--v2-flag)', 'alert'] : tone === 'blocked' ? ['var(--v2-block-bg)', 'var(--v2-block)', 'x'] : ['var(--v2-inset)', 'var(--v2-soft)', running && r.state === 'pending' ? 'clock' : 'dot']\n                                        return (\n                                            <li key={r.line} className='flex items-center' style={{ gap: 12, padding: '12px 18px', borderTop: i ? '1px solid var(--v2-rule)' : 0 }} data-slot={`verify-${r.line}`}>\n                                                <span className='grid shrink-0 place-items-center rounded-full' style={{ width: 26, height: 26, background: colors[0], color: colors[1] }}>\n                                                    <Glyph name={colors[2]} size={13} color={colors[1]} />\n                                                </span>\n                                                <span className='min-w-0 flex-grow'>\n                                                    <b className='font-semibold'>{C.verify.rows[r.line]}</b>\n                                                    <br />\n                                                    <span className='leading-[1.45]' style={{ color: tone === 'blocked' ? 'var(--v2-block)' : tone === 'flagged' ? 'var(--v2-flag)' : 'var(--v2-soft)' }}>\n                                                        {r.reason}\n                                                    </span>\n                                                </span>\n                                                <Verdict tone={tone} word={run || r.state === 'unavailable' ? C.verify.state[r.state] : C.verify.notRun} />\n                                            </li>\n                                        )\n                                    })}\n                                </ul>\n                            </>\n                        )}\n                        {step === 'packs' && setup && (\n                            <>\n                                <div>\n                                    <h1 ref={heading} id={headingId} tabIndex={-1} className='font-bold' style={{ fontSize: 26, letterSpacing: '-0.01em' }}>\n                                        {C.packs.title}\n                                    </h1>\n                                    <p className='text-[14px]' style={{ marginTop: 4, color: 'var(--v2-soft)' }}>\n                                        {C.packs.lead(setup.tenant.label)}\n                                    </p>\n                                </div>\n                                {setup.packs.some((p) => p.count > 0) ? (\n                                    <div role='group' aria-label={C.packs.title} className='flex flex-col overflow-hidden rounded-[12px] border' style={{ borderColor: 'var(--v2-rule)', background: 'var(--v2-paper)' }} data-slot='pack-list'>\n                                        {setup.packs.map((p, i) => {\n                                            const on = selectedPacks.includes(p.product)\n                                            const off = p.count === 0 || !setup.products.includes(p.product)\n                                            const cardInfo = PRODUCT_CARDS.find((c) => c.id === p.product)\n                                            return (\n                                                <button\n                                                    key={p.product}\n                                                    type='button'\n                                                    role='checkbox'\n                                                    aria-checked={on}\n                                                    aria-disabled={off ? true : undefined}\n                                                    aria-label={C.packs.pack(productLabel(p.product), p.count)}\n                                                    onClick={() => !off && setPacks(on ? selectedPacks.filter((x) => x !== p.product) : [...selectedPacks, p.product])}\n                                                    className='flex w-full items-center text-left'\n                                                    style={{ gap: 14, padding: '12px 18px', border: 0, borderTop: i ? '1px solid var(--v2-rule)' : 0, background: 'transparent', color: 'var(--v2-ink)', opacity: off ? 0.55 : 1 }}\n                                                    data-slot='pack-row'\n                                                >\n                                                    <span className='grid shrink-0 place-items-center rounded-[5px]' style={{ width: 18, height: 18, border: `1.5px solid ${on ? 'var(--v2-acc)' : 'var(--v2-ctl)'}`, background: on ? 'var(--v2-acc)' : 'transparent', color: 'var(--v2-acc-ink)' }}>\n                                                        {on && <Glyph name='check' size={11} color='var(--v2-acc-ink)' />}\n                                                    </span>\n                                                    {tile(cardInfo?.icon ?? 'cases')}\n                                                    <span className='min-w-0 flex-grow'>\n                                                        <b className='font-semibold'>{C.packs.name(productLabel(p.product))}</b> <span style={{ color: 'var(--v2-faint)' }}>· {productLabel(p.product)}</span>\n                                                        <br />\n                                                        <span style={{ color: 'var(--v2-soft)' }}>{cardInfo?.body ?? ''}</span>\n                                                    </span>\n                                                    <span className='text-[12px] whitespace-nowrap' style={{ color: 'var(--v2-faint)' }}>\n                                                        {C.packs.count(p.count)}\n                                                    </span>\n                                                </button>\n                                            )\n                                        })}\n                                    </div>\n                                ) : (\n                                    <p className='text-[13px]' style={{ color: 'var(--v2-soft)' }}>\n                                        {C.packs.none}\n                                    </p>\n                                )}\n                                <p style={{ color: 'var(--v2-soft)' }} data-slot='pack-summary'>\n                                    {C.packs.summary(selectedPacks.length, selectedPacks.reduce((a, id) => a + (setup.packs.find((p) => p.product === id)?.count ?? 0), 0))}\n                                </p>\n                            </>\n                        )}\n                        {step === 'academy' && (\n                            <>\n                                <div>\n                                    <h1 ref={heading} id={headingId} tabIndex={-1} className='font-bold' style={{ fontSize: 26, letterSpacing: '-0.01em' }}>\n                                        {C.academy.title}\n                                    </h1>\n                                    <p className='text-[14px]' style={{ marginTop: 4, color: 'var(--v2-soft)' }}>\n                                        {C.academy.lead}\n                                    </p>\n                                </div>\n                                <div className='grid' style={{ gridTemplateColumns: 'minmax(0, 1fr) minmax(0, 1fr)', gap: 14 }}>\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_31","type":"agent_message","text":"The scoped hashes and compiled-input entries match, and all 18 recorded check-log hashes verify. The prepared executable also matches the native record. I’m now checking whether the retained AX trees and captures substantiate the driver’s pass assertions."}}
{"type":"item.started","item":{"id":"item_32","type":"command_execution","command":"/bin/zsh -lc \"cat tools/native-acceptance/wizard_coverage.py; sed -n '1,240p' tools/native-acceptance/acceptance_c43.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_32","type":"command_execution","command":"/bin/zsh -lc \"cat tools/native-acceptance/wizard_coverage.py; sed -n '1,240p' tools/native-acceptance/acceptance_c43.py\"","aggregated_output":"\"\"\"Independent completeness check for the retained C29 native assertions.\n\nThe expected axes come from C29-N06/T09, rather than the rows a driver happens\nto emit. Missing behavior or a missing capture cannot be reported as exercised.\n\"\"\"\nimport argparse\nimport hashlib\nimport itertools\nimport json\nfrom pathlib import Path\n\nSTEPS = {\n    'firstRun': ['welcome', 'tenant', 'products', 'verify', 'packs', 'academy', 'done'],\n    'add': ['tenant', 'products', 'verify', 'packs', 'done'],\n}\nBEHAVIOR = [\n    'welcome_relaunch', 'profile_edit_saved', 'profile_edit_key_kept',\n    'gateway_listed', 'workspace_chosen', 'workspace_key_saved',\n    'rejected_client_failed', 'failed_client_continuable', 'failed_scan_stored_not_pass',\n    'credential_fix_returns_tenant', 'correct_client_saved', 'workspace_rechosen_after_fix',\n    'verification_passed', 'gateway_verification_passed', 'product_edit_marked_stale',\n    'stale_continuation_closed', 'stale_rerun_clean', 'home_relaunch',\n    'starter_cases_imported', 'secret_confinement',\n    'keyed_draft_saved', 'cancelled_rows_unchanged', 'cancelled_active_unchanged', 'cancelled_key_deleted',\n]\n\n\ndef problems(observations, root):\n    coverage = observations.get('c29_native_coverage', {})\n    behavior = coverage.get('behavior', {})\n    failures = ['missing/failed retained behavior: ' + key for key in BEHAVIOR if behavior.get(key) is not True]\n    rows = coverage.get('layouts', {})\n    expected = {(mode, step, theme, zoom) for mode, steps in STEPS.items()\n                for step, theme, zoom in itertools.product(steps, ['Light', 'Dark'], [1, 2])}\n    seen = set()\n    for name, row in rows.items():\n        axis = (row.get('mode'), row.get('step'), row.get('theme'), row.get('zoom'))\n        if axis in seen:\n            failures.append('duplicate matrix row: ' + str(axis))\n        seen.add(axis)\n        zoom = row.get('zoom')\n        requested = (1440, 900) if zoom == 1 else (900, 600)\n        geometry = row.get('geometry', {})\n        web = geometry.get('web') or []\n        viewport = geometry.get('viewport') or web\n        if not (len(web) == 2 and len(viewport) == 2 and web[0] == requested[0]\n                and viewport[0] == requested[0] and (zoom == 1 or viewport[1] == requested[1])):\n            failures.append(name + ': wrong measured geometry')\n        primary = row.get('primary', {})\n        height = (primary.get('size') or [0, 0])[1]\n        if not (primary.get('inside') and zoom in (1, 2) and height >= 32 * zoom):\n            failures.append(name + ': primary outside window or too small')\n        if row.get('overflow_px') != 0 or row.get('horizontal_scrollbars') != 0:\n            failures.append(name + ': horizontal overflow')\n        if row.get('dialog') != (row.get('mode') == 'add'):\n            failures.append(name + ': wrong modal ownership')\n        keyboard = row.get('keyboard', {})\n        if not (keyboard.get('primary_reached') and keyboard.get('walk') and keyboard.get('contained')):\n            failures.append(name + ': keyboard traversal missing/incomplete')\n        for field in ['capture', 'tree']:\n            path = Path(root) / row.get(field, '')\n            if not row.get(field) or not path.is_file():\n                failures.append(name + ': missing ' + field)\n            elif hashlib.sha256(path.read_bytes()).hexdigest() != row.get(field + '_sha256'):\n                failures.append(name + ': hash mismatch for ' + field)\n    failures.extend('missing matrix row: ' + str(axis) for axis in sorted(expected - seen))\n    failures.extend('unexpected matrix row: ' + str(axis) for axis in sorted(seen - expected))\n    return failures\n\n\ndef main():\n    parser = argparse.ArgumentParser()\n    parser.add_argument('observations', type=Path)\n    parser.add_argument('--root', type=Path, default=Path.cwd())\n    args = parser.parse_args()\n    data = json.loads(args.observations.read_text())\n    errors = problems(data['observations'], args.root)\n    print(json.dumps({'retained_C29_native_coverage': 'fail' if errors else 'pass', 'errors': errors}, indent=2))\n    return 1 if errors else 0\n\n\nif __name__ == '__main__':\n    raise SystemExit(main())\n#!/usr/bin/env python3\n\"\"\"C43 native acceptance (D059): the first-run wizard and the add-tenant\nsheet as the prototype board draws them (R2Onboard, every step, mode=add),\ndriven through the real fixture window against the synthetic scan and\nmanagement endpoints.\n\nRun from the repository root after `xtask native-prepare --chunk C43`.\nRequires the macOS Accessibility grant. Synthetic services only; the fixture\ndata root is removed at the end.\n\nChecks (docs/architecture/native-checks.json, C43): every first-run step as\nthe board draws it, the rail, the pinned footer and the C29 behaviour\nthrough to completion (N01); the add-tenant sheet (N02); keyboard reach,\nthe focus ring and the measured layouts in both themes (N03). The parity\ncomposites are captured per step.\n\"\"\"\n\nimport json\nimport os\nimport re\nimport shutil\nimport subprocess\nimport sys\nimport tempfile\nimport time\n\nsys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))\nimport fixture_app as fx  # noqa: E402\nimport acceptance_c08 as c8  # noqa: E402\nimport acceptance_c28 as c28  # noqa: E402\nimport acceptance_c29 as c29  # noqa: E402\nimport acceptance_c31 as c31  # noqa: E402\nimport wizard_coverage as coverage  # noqa: E402\n\nROOT = os.getcwd()\nEVIDENCE = os.path.join(ROOT, \"docs/planning/evidence/C43\")\nNATIVE = os.path.join(EVIDENCE, \"native\")\nRECORD = os.path.join(EVIDENCE, \"native-acceptance.json\")\nPARITY = os.path.join(EVIDENCE, \"parity\")\nDC = os.path.join(ROOT, \"tools/parity\")\nLOG = []\nTITLE_BAR = 28\nTAGS = (\"AXRadioButton\", \"AXCheckBox\", \"AXButton\", \"AXPopUpButton\", \"AXDisclosureTriangle\")\nSTEP_BOARDS = {\"welcome\": \"welcome\", \"tenant\": \"tenant\", \"products\": \"products\", \"verify\": \"verify\", \"packs\": \"cases\", \"academy\": \"academy\", \"done\": \"done\"}\n\n\ndef rel(path):\n    return os.path.relpath(path, ROOT)\n\n\ndef heading(tree, label):\n    return next((n for n in tree if n.get(\"role\") == \"AXHeading\" and (n.get(\"label\") or \"\") == label), None)\n\n\ndef heading_like(tree, prefix):\n    return next((n for n in tree if n.get(\"role\") == \"AXHeading\" and (n.get(\"label\") or \"\").startswith(prefix)), None)\n\n\ndef group(tree, label):\n    return next((n for n in tree if n.get(\"role\") == \"AXGroup\" and (n.get(\"label\") or \"\") == label), None)\n\n\ndef within(tree, node):\n    if not node:\n        return []\n    i = tree.index(node)\n    out = []\n    for m in tree[i + 1:]:\n        if m.get(\"depth\", 0) <= node.get(\"depth\", 0):\n            break\n        out.append(m)\n    return out\n\n\ndef labels(nodes, roles, prefix=\"\"):\n    roles = (roles,) if isinstance(roles, str) else roles\n    out = []\n    for n in nodes:\n        label = n.get(\"label\") or \"\"\n        if n.get(\"role\") in roles and label.startswith(prefix) and label not in out:\n            out.append(label)\n    return out\n\n\ndef press(app, role, label, timeout=8):\n    app.wait_for(lambda t: fx.App.node(t, role, label) is not None, timeout)\n    app.ax(\"press\", role, label)\n    time.sleep(0.5)\n\n\ndef press_any(app, label, timeout=8):\n    \"\"\"Presses the control with this label whatever role AX gives it (a switch is a checkbox, a radio a radio button).\"\"\"\n    tree, _ = app.wait_for(lambda t: any((n.get(\"label\") or \"\") == label and n.get(\"role\") in TAGS for n in t), timeout)\n    node = next((n for n in tree if (n.get(\"label\") or \"\") == label and n.get(\"role\") in TAGS), None)\n    if node:\n        app.ax(\"press\", node[\"role\"], label)\n        time.sleep(0.5)\n    return node is not None\n\n\ndef geometry(tree):\n    web = next((n for n in tree if n.get(\"role\") == \"AXWebArea\" and n.get(\"size\")), None)\n    scroll = next((n for n in tree if n.get(\"role\") == \"AXScrollArea\" and n.get(\"size\")), None)\n    win = next((n for n in tree if n.get(\"role\") == \"AXWindow\"), None)\n    return {\"web\": [int(web[\"size\"][0]), int(web[\"size\"][1])] if web else None,\n            \"viewport\": [int(scroll[\"size\"][0]), int(scroll[\"size\"][1])] if scroll else None,\n            \"window\": win.get(\"size\") if win else None}\n\n\ndef size_window(app, pid, w, h):\n    fx.sh([\"osascript\", \"-e\", f'tell application \"System Events\" to tell (first application process whose unix id is {pid}) to set position of window 1 to {{0, 0}}'])\n    requested = [w, h + TITLE_BAR]\n    for _ in range(3):\n        c28.set_window_size(pid, requested[0], requested[1])\n        time.sleep(0.8)\n        g = geometry(app.tree())\n        vp = g[\"viewport\"] or g[\"web\"]\n        if not vp or vp[1] == h:\n            break\n        requested = [requested[0], requested[1] + (h - vp[1])]\n    return c29.window_frame(pid)\n\n\ndef overflow(app):\n    tree = app.tree()\n    win = next((n for n in tree if n.get(\"role\") == \"AXWindow\"), None)\n    nodes = [n for n in tree if n.get(\"pos\") and n.get(\"size\") and n[\"size\"][0] > 0\n             and n.get(\"role\") in (\"AXButton\", \"AXStaticText\", \"AXTextField\", \"AXTextArea\", \"AXLink\", \"AXHeading\", \"AXCheckBox\", \"AXRadioButton\", \"AXPopUpButton\")]\n    right = max(n[\"pos\"][0] + n[\"size\"][0] for n in nodes) if nodes and win else None\n    hbars = [n for n in tree if n.get(\"role\") == \"AXScrollBar\" and (n.get(\"orientation\") == \"horizontal\" or (n.get(\"size\") and n[\"size\"][0] > n[\"size\"][1]))]\n    return {\"overflow_px\": max(0, right - (win[\"pos\"][0] + win[\"size\"][0])) if right is not None else None, \"horizontal_scrollbars\": len(hbars)}, tree\n\n\ndef primary_usable(tree, zoom, step):\n    \"\"\"The footer's primary inside the window and at least 32 CSS px.\"\"\"\n    win = next((n for n in tree if n.get(\"role\") == \"AXWindow\"), None)\n    labels_ = (\"Create the tenant to continue\", \"Save the scan key to continue\", \"Continue\", \"Continue with warnings\", \"Set up a tenant\", \"Open Prisma AIRS\", \"Finish\")\n    # Academy's signed-out advancing action is Skip for now. Packs also has\n    # a secondary Skip action; it must still be measured/traversed to Continue.\n    if step == \"academy\":\n        labels_ = (\"Continue\", \"Skip for now\")\n    btn = next((n for n in tree if n.get(\"role\") == \"AXButton\" and (n.get(\"label\") or \"\") in labels_ and n.get(\"pos\") and n.get(\"size\")), None)\n    inside = bool(btn and win and btn[\"pos\"][0] >= win[\"pos\"][0] and btn[\"pos\"][0] + btn[\"size\"][0] <= win[\"pos\"][0] + win[\"size\"][0] + 1 and btn[\"pos\"][1] + btn[\"size\"][1] <= win[\"pos\"][1] + win[\"size\"][1] + 1)\n    return {\"label\": btn.get(\"label\") if btn else None, \"size\": btn.get(\"size\") if btn else None, \"inside\": inside,\n            \"size_ok\": bool(btn and btn[\"size\"][1] >= 32 * zoom - 1), \"ok\": inside and bool(btn and btn[\"size\"][1] >= 32 * zoom - 1), \"zoom\": zoom}\n\n\ndef composite(app, step, theme, web_size, prepared, mode=\"firstRun\"):\n    board = STEP_BOARDS[step]\n    name = f\"{'add-' if mode == 'add' else ''}{board}-{theme.lower()}\"\n    cap = c29.capture(app, f\"parity-{name}\")\n    if not cap:\n        raise SystemExit(f\"no capture for {name}\")\n    os.makedirs(os.path.join(PARITY, \"app\"), exist_ok=True)\n    os.makedirs(os.path.join(PARITY, \"proto\"), exist_ok=True)\n    with open(os.path.join(PARITY, \"bundle.json\"), \"w\") as f:\n        json.dump({\"bundle\": prepared[\"bundle\"], \"executable_sha256\": prepared[\"executable_sha256\"], \"from\": \"native-prepare.json\",\n                   \"captured_by\": \"tools/native-acceptance/acceptance_c43.py\", \"captured_utc\": time.strftime(\"%Y-%m-%dT%H:%M:%SZ\", time.gmtime())}, f, indent=2)\n        f.write(\"\\n\")\n    app_png = os.path.join(PARITY, \"app\", f\"{name}.png\")\n    shutil.copy(os.path.join(ROOT, cap), app_png)\n    web_w, web_h = web_size\n    proto_png = os.path.join(PARITY, \"proto\", f\"{name}.png\")\n    props = [\"--prop\", f\"step={board}\", \"--prop\", f\"theme={theme.lower()}\", \"--prop\", \"filled=true\"]\n    if mode == \"add\":\n        props += [\"--prop\", \"mode=add\"]\n    subprocess.run([sys.executable, \"-I\", os.path.join(DC, \"dc_render.py\"), \"--board\", \"R2Onboard\", *props, \"--width\", str(web_w), \"--height\", str(web_h), \"--out\", proto_png], check=True, capture_output=True)\n    out = os.path.join(PARITY, f\"{name}.png\")\n    subprocess.run([sys.executable, \"-I\", os.path.join(DC, \"compose.py\"), \"--left\", proto_png, \"--right\", app_png,\n                    \"--out\", out, \"--title\", f\"Wizard · {board}{' · add' if mode == 'add' else ''} · {theme.lower()} · {web_w}×{web_h}\"], check=True, capture_output=True)\n    return rel(out)\n\n\ndef web_size_of(app, tries=12):\n    \"\"\"The WebView's size from the tree, read again while the tree has no web area yet (right after an appearance\n    change the tree is re-published and a read in between returned none, which crashed the add sheet's composite).\"\"\"\n    for _ in range(tries):\n        web = geometry(app.tree())[\"web\"]\n        if web:\n            return web\n        time.sleep(0.3)\n    raise RuntimeError(\"the WebView's size did not appear in the accessibility tree\")\n\n\ndef composites_for(app, step, prepared, mode=\"firstRun\"):\n    out = {}\n    for theme in (\"Light\", \"Dark\"):\n        c29.appearance(app, theme)\n        time.sleep(0.8)\n        out[theme.lower()] = composite(app, step, theme, web_size_of(app), prepared, mode)\n    c29.appearance(app, \"Light\")\n    time.sleep(0.5)\n    return out\n\n\ndef main():\n    try:\n        return run()\n    except Exception:\n        if os.path.isdir(NATIVE):\n            try:\n                c29.save_tree(\"failure\", c29._last_app_tree())\n                with open(os.path.join(NATIVE, \"failure-log.json\"), \"w\") as f:\n                    json.dump(LOG, f, indent=2)\n            except Exception as error:\n                print(\"failure evidence unavailable:\", error)\n        raise\n    finally:\n        fx.sh([\"pkill\", \"-f\", fx.PROCESS])\n        fx.clean_fixture_root()\n\n\ndef run():\n    global NATIVE\n    prepared = json.load(open(os.path.join(EVIDENCE, \"native-prepare.json\")))\n    bundle = os.path.join(ROOT, prepared[\"bundle\"])\n    exe = os.path.join(bundle, \"Contents/MacOS/prisma-airs-desktop-v2\")\n    if c8.sha256(exe) != prepared[\"executable_sha256\"]:\n        raise SystemExit(\"prepared executable changed since native-prepare\")\n    work = tempfile.mkdtemp(prefix=\"airs-v2-c43-acceptance-\")\n    FINAL = NATIVE\n    NATIVE = NATIVE + \".staging\"\n    if os.path.isdir(NATIVE):\n        shutil.rmtree(NATIVE)\n    os.makedirs(NATIVE)\n    c29.NATIVE = NATIVE\n    if os.path.isdir(c29.CAPTURES):\n        shutil.rmtree(c29.CAPTURES)\n    app = fx.App(bundle, work, LOG)\n    c29._APP = app\n    app.quit()\n    fx.clean_fixture_root()\n    time.sleep(1.5)\n    endpoint = fx.ScanEndpoint(os.path.join(work, \"endpoint\"), c8.SCAN_KEY)\n    endpoint.install_roots()\n    endpoint.start()\n    mgmt = c8.MgmtEndpoint(os.path.join(work, \"endpoint\"), os.path.join(work, \"mgmt\"))\n    mgmt.install()\n    mgmt.start()\n    mgmt.mode()\n","exit_code":0,"status":"completed"}}
