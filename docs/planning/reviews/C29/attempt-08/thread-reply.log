{"type":"item.completed","item":{"id":"item_65","type":"command_execution","command":"/bin/zsh -lc \"cat apps/desktop/src-tauri/src/keychain.rs; sed -n '1,165p' crates/desktop-core/src/vault.rs; sed -n '125,185p' crates/desktop-core/src/authority.rs; sed -n '2750,2835p' crates/desktop-core/src/authority.rs; rg -n 'require_operator|principal|Harness|BeginTenantSetup|CompleteTenantSetup' crates/desktop-core/src/authority.rs | head -50\"","aggregated_output":"//! Classic macOS Keychain credential adapter (DESIGN \"Native Harness,\n//! identity and protected storage\").\n//!\n//! Generic-password items with service = this build's v2 namespace and\n//! account = the immutable credential record ID; local, non-synchronizing,\n//! default application ACL. Production uses the login Keychain and allows the\n//! OS authorization prompts; fixture builds use a dedicated test keychain and\n//! the fixture namespace. Every call is serialized (the user-interaction\n//! setting is process-global), and OS status codes map to sanitized\n//! [`VaultError`]s: a keychain that is locked reports `Locked`, an item the\n//! process may not read reports `Denied`. Purge deletes only items in this\n//! namespace; v1 and foreign items are never addressed.\n//!\n//! `SecKeychainItem::delete` in security-framework discards the OS status, and\n//! the keychain lock status is not bound, so this module calls those two\n//! Security functions directly.\n#![allow(unsafe_code)]\n\nuse std::path::Path;\nuse std::sync::Mutex;\n\nuse core_foundation::base::TCFType;\nuse desktop_core::CredentialStore;\nuse desktop_core::vault::{RecordId, Vault, VaultError};\nuse security_framework::item::{ItemClass, ItemSearchOptions, Limit, Reference, SearchResult};\nuse security_framework::os::macos::keychain::{CreateOptions, SecKeychain};\nuse security_framework::os::macos::keychain_item::SecKeychainItem;\nuse security_framework_sys::base::SecKeychainRef;\n\n/// Security status code (`OSStatus` in `<MacTypes.h>`).\ntype OSStatus = i32;\nuse zeroize::Zeroizing;\n\n/// The production v2 scan-credential namespace (independent of v1's\n/// `io.cdot.prisma-airs-desktop`).\npub const SCAN_SERVICE: &str = \"io.cdot.prisma-airs-desktop.v2.scan\";\n/// The fixture build's namespace, used only in its dedicated test keychain.\npub const FIXTURE_SCAN_SERVICE: &str = \"io.cdot.prisma-airs-desktop.v2.fixture.scan\";\n/// The Academy learner namespace (refresh token of the signed-in learner).\npub const ACADEMY_SERVICE: &str = \"io.cdot.prisma-airs-desktop.v2.academy\";\n/// The fixture build's Academy learner namespace.\npub const FIXTURE_ACADEMY_SERVICE: &str = \"io.cdot.prisma-airs-desktop.v2.fixture.academy\";\n\nconst ERR_SEC_ITEM_NOT_FOUND: OSStatus = -25300;\nconst ERR_SEC_INTERACTION_NOT_ALLOWED: OSStatus = -25308;\nconst ERR_SEC_AUTH_FAILED: OSStatus = -25293;\nconst ERR_SEC_USER_CANCELED: OSStatus = -128;\nconst ERR_SEC_NO_SUCH_KEYCHAIN: OSStatus = -25294;\nconst ERR_SEC_INVALID_KEYCHAIN: OSStatus = -25295;\nconst K_SEC_UNLOCK_STATE_STATUS: u32 = 1;\n\nunsafe extern \"C\" {\n    fn SecKeychainGetStatus(keychain: SecKeychainRef, status: *mut u32) -> OSStatus;\n    #[cfg(feature = \"test-fixtures\")]\n    fn SecKeychainLock(keychain: SecKeychainRef) -> OSStatus;\n    #[cfg(feature = \"test-fixtures\")]\n    fn SecKeychainUnlock(\n        keychain: SecKeychainRef,\n        length: u32,\n        password: *const std::ffi::c_void,\n        use_password: u8,\n    ) -> OSStatus;\n}\n\n/// Whether the OS may show its own authorization prompts.\n#[derive(Clone, Copy, Debug, PartialEq, Eq)]\npub enum Interaction {\n    Allowed,\n    Disallowed,\n}\n\nstatic KEYCHAIN_CALLS: Mutex<()> = Mutex::new(());\n\n/// A credential store over one keychain and namespace.\npub struct KeychainStore {\n    keychain: SecKeychain,\n    service: &'static str,\n    interaction: Interaction,\n}\n\n// SAFETY (Send/Sync): SecKeychainRef is a Core Foundation object whose\n// Security APIs are thread-safe; every call here is additionally serialized.\nunsafe impl Send for KeychainStore {}\nunsafe impl Sync for KeychainStore {}\n\nimpl KeychainStore {\n    /// The login Keychain with the production scan namespace.\n    pub fn login() -> Result<Self, VaultError> {\n        Self::login_service(SCAN_SERVICE)\n    }\n\n    /// The login Keychain with one of this build's production namespaces.\n    pub fn login_service(service: &'static str) -> Result<Self, VaultError> {\n        Ok(Self {\n            keychain: SecKeychain::default().map_err(|e| map(e.code(), None))?,\n            service,\n            interaction: Interaction::Allowed,\n        })\n    }\n\n    /// A dedicated file keychain (fixture builds and tests). Creates it with\n    /// `password` when absent and unlocks it.\n    pub fn file(\n        path: &Path,\n        password: &str,\n        service: &'static str,\n        interaction: Interaction,\n    ) -> Result<Self, VaultError> {\n        let mut keychain = if path.exists() {\n            SecKeychain::open(path).map_err(|e| map(e.code(), None))?\n        } else {\n            CreateOptions::new()\n                .password(password)\n                .prompt_user(false)\n                .create(path)\n                .map_err(|e| map(e.code(), None))?\n        };\n        keychain\n            .unlock(Some(password))\n            .map_err(|e| map(e.code(), None))?;\n        Ok(Self {\n            keychain,\n            service,\n            interaction,\n        })\n    }\n\n    pub fn service(&self) -> &'static str {\n        self.service\n    }\n\n    /// Whether the keychain currently reports itself locked.\n    pub fn is_locked(&self) -> bool {\n        let mut status = 0u32;\n        // SAFETY: the keychain reference is valid for `self`'s lifetime and\n        // `status` is a valid out-pointer.\n        let code =\n            unsafe { SecKeychainGetStatus(self.keychain.as_concrete_TypeRef(), &mut status) };\n        code == 0 && status & K_SEC_UNLOCK_STATE_STATUS == 0\n    }\n\n    /// Runs `f` serialized, with OS prompts disabled when configured. The\n    /// lock state is read after the prompt guard is released: with user\n    /// interaction disabled the status call itself fails.\n    fn call<T>(&self, f: impl FnOnce() -> Result<T, OSStatus>) -> Result<T, VaultError> {\n        let _serial = KEYCHAIN_CALLS.lock().map_err(|_| VaultError::Unavailable)?;\n        let result = {\n            let _guard = match self.interaction {\n                Interaction::Allowed => None,\n                Interaction::Disallowed => Some(\n                    SecKeychain::disable_user_interaction().map_err(|_| VaultError::Unavailable)?,\n                ),\n            };\n            f()\n        };\n        result.map_err(|code| map(code, Some(self.is_locked())))\n    }\n\n    fn find(&self, record: &RecordId) -> Result<(Zeroizing<Vec<u8>>, SecKeychainItem), OSStatus> {\n        self.keychain\n            .find_generic_password(self.service, record.as_str())\n            .map(|(password, item)| (Zeroizing::new(password.to_vec()), item))\n            .map_err(|e| e.code())\n    }\n}\n\n/// Fixture-only lock control for native acceptance: a running app does not\n/// observe a lock made by another process through `security lock-keychain`\n/// (observed on macOS 27), so the fixture menu locks and unlocks this\n/// process's own keychain reference instead.\n#[cfg(feature = \"test-fixtures\")]\nimpl KeychainStore {\n    pub fn lock_for_fixture(&self) -> bool {\n        let _serial = KEYCHAIN_CALLS.lock();\n        // SAFETY: the keychain reference is valid for `self`'s lifetime.\n        unsafe { SecKeychainLock(self.keychain.as_concrete_TypeRef()) == 0 }\n    }\n\n    pub fn unlock_for_fixture(&self, password: &str) -> bool {\n        let _serial = KEYCHAIN_CALLS.lock();\n        // SAFETY: the reference is valid and the password pointer/length\n        // describe a live UTF-8 buffer for the duration of the call.\n        unsafe {\n            SecKeychainUnlock(\n                self.keychain.as_concrete_TypeRef(),\n                password.len() as u32,\n                password.as_ptr().cast(),\n                1,\n            ) == 0\n        }\n    }\n}\n\n/// v1's Keychain service, read only (C23, D050). It can only find\n/// generic passwords in v1's service: there is no way to add, change or\n/// delete one of v1's items through it, and it never changes the keychain\n/// search list.\npub struct V1KeychainSource {\n    keychain: SecKeychain,\n    interaction: Interaction,\n    /// Fixture builds: the accounts read, one per line (no data).\n    #[cfg(feature = \"test-fixtures\")]\n    log: Option<std::path::PathBuf>,\n}\n\n// SAFETY (Send/Sync): as for `KeychainStore`; every call is serialized.\nunsafe impl Send for V1KeychainSource {}\nunsafe impl Sync for V1KeychainSource {}\n\nimpl V1KeychainSource {\n    /// The login Keychain. macOS asks the operator before an item of v1's is\n    /// read (the platform's grant for a protected read).\n    pub fn login() -> Result<Self, VaultError> {\n        Ok(Self {\n            keychain: SecKeychain::default().map_err(|e| map(e.code(), None))?,\n            interaction: Interaction::Allowed,\n            #[cfg(feature = \"test-fixtures\")]\n            log: None,\n        })\n    }\n\n    /// A staged fixture keychain (fixture builds): opened only if it exists,\n    /// never created, and never prompting.\n    #[cfg(feature = \"test-fixtures\")]\n    pub fn file(path: &Path, password: &str, log: &Path) -> Result<Self, VaultError> {\n        if !path.is_file() {\n            return Err(VaultError::Unavailable);\n        }\n        let mut keychain = SecKeychain::open(path).map_err(|e| map(e.code(), None))?;\n        keychain\n            .unlock(Some(password))\n            .map_err(|e| map(e.code(), None))?;\n        Ok(Self {\n            keychain,\n            interaction: Interaction::Disallowed,\n            log: Some(log.to_path_buf()),\n        })\n    }\n\n    fn is_locked(&self) -> bool {\n        let mut status = 0u32;\n        // SAFETY: as in `KeychainStore::is_locked`.\n        let code =\n            unsafe { SecKeychainGetStatus(self.keychain.as_concrete_TypeRef(), &mut status) };\n        code == 0 && status & K_SEC_UNLOCK_STATE_STATUS == 0\n    }\n}\n\nimpl desktop_core::import_v1::V1Keychain for V1KeychainSource {\n    fn read(&self, account: &str) -> Result<Option<Zeroizing<Vec<u8>>>, VaultError> {\n        #[cfg(feature = \"test-fixtures\")]\n        if let Some(log) = &self.log {\n            use std::io::Write;\n            if let Ok(mut f) = std::fs::OpenOptions::new()\n                .create(true)\n                .append(true)\n                .open(log)\n            {\n                let _ = writeln!(f, \"{account}\");\n            }\n        }\n        let _serial = KEYCHAIN_CALLS.lock().map_err(|_| VaultError::Unavailable)?;\n        let found = {\n            let _guard = match self.interaction {\n                Interaction::Allowed => None,\n                Interaction::Disallowed => Some(\n                    SecKeychain::disable_user_interaction().map_err(|_| VaultError::Unavailable)?,\n                ),\n            };\n            self.keychain\n                .find_generic_password(desktop_core::import_v1::V1_SERVICE, account)\n                .map(|(password, _)| Zeroizing::new(password.to_vec()))\n                .map_err(|e| e.code())\n        };\n        match found {\n            Ok(bytes) => Ok(Some(bytes)),\n            Err(ERR_SEC_ITEM_NOT_FOUND) => Ok(None),\n            Err(code) => Err(map(code, Some(self.is_locked()))),\n        }\n    }\n}\n\nfn delete_item(item: &SecKeychainItem) -> Result<(), OSStatus> {\n    // SAFETY: the item reference is valid while `item` is alive.\n    let code = unsafe {\n        security_framework_sys::keychain_item::SecKeychainItemDelete(item.as_concrete_TypeRef())\n    };\n    if code == 0 { Ok(()) } else { Err(code) }\n}\n\n/// Maps an OS status to a sanitized vault error. `locked` is the keychain's\n/// lock state when known: a locked keychain answers -25308 (prompting not\n/// allowed), -25293 (authentication failed, observed on macOS 27 for an\n/// already-open keychain locked externally) or -128 (unlock prompt\n/// cancelled); the same codes on an unlocked keychain mean the item's ACL\n/// denied this process.\nfn map(code: OSStatus, locked: Option<bool>) -> VaultError {\n    match code {\n        ERR_SEC_ITEM_NOT_FOUND => VaultError::NotFound,\n        ERR_SEC_INTERACTION_NOT_ALLOWED | ERR_SEC_AUTH_FAILED | ERR_SEC_USER_CANCELED\n            if locked == Some(true) =>\n        {\n            VaultError::Locked\n        }\n        ERR_SEC_INTERACTION_NOT_ALLOWED | ERR_SEC_AUTH_FAILED | ERR_SEC_USER_CANCELED => {\n            VaultError::Denied\n        }\n        ERR_SEC_NO_SUCH_KEYCHAIN | ERR_SEC_INVALID_KEYCHAIN => VaultError::Unavailable,\n        _ => VaultError::Unavailable,\n    }\n}\n\nimpl Vault for KeychainStore {\n    fn put(&self, record: &RecordId, secret: &[u8]) -> Result<(), VaultError> {\n        self.call(|| {\n            self.keychain\n                .add_generic_password(self.service, record.as_str(), secret)\n                .map_err(|e| e.code())\n        })\n    }\n\n    fn get(&self, record: &RecordId) -> Result<Zeroizing<Vec<u8>>, VaultError> {\n        self.call(|| self.find(record).map(|(secret, _)| secret))\n    }\n\n    fn delete(&self, record: &RecordId) -> Result<(), VaultError> {\n        self.call(|| {\n            let (_, item) = self.find(record)?;\n            delete_item(&item)\n        })\n    }\n}\n\nimpl CredentialStore for KeychainStore {\n    fn purge(&self) -> Result<(), VaultError> {\n        self.call(|| {\n            let found = ItemSearchOptions::new()\n                .class(ItemClass::generic_password())\n                .keychains(std::slice::from_ref(&self.keychain))\n                .service(self.service)\n                .limit(Limit::All)\n                .load_refs(true)\n                .search();\n            let results = match found {\n                Ok(results) => results,\n                Err(e) if e.code() == ERR_SEC_ITEM_NOT_FOUND => return Ok(()),\n                Err(e) => return Err(e.code()),\n            };\n            for result in results {\n                if let SearchResult::Ref(Reference::KeychainItem(item)) = result {\n                    match delete_item(&item) {\n                        Ok(()) | Err(ERR_SEC_ITEM_NOT_FOUND) => {}\n                        Err(code) => return Err(code),\n                    }\n                }\n            }\n            Ok(())\n        })\n    }\n}\n\n#[cfg(test)]\nmod tests {\n    use super::*;\n\n    #[test]\n    fn status_codes_map_to_sanitized_failures() {\n        assert_eq!(map(ERR_SEC_ITEM_NOT_FOUND, None), VaultError::NotFound);\n        assert_eq!(\n            map(ERR_SEC_INTERACTION_NOT_ALLOWED, Some(true)),\n            VaultError::Locked\n        );\n        assert_eq!(\n            map(ERR_SEC_INTERACTION_NOT_ALLOWED, Some(false)),\n            VaultError::Denied\n        );\n        assert_eq!(map(ERR_SEC_USER_CANCELED, Some(false)), VaultError::Denied);\n        assert_eq!(map(ERR_SEC_AUTH_FAILED, Some(false)), VaultError::Denied);\n        assert_eq!(map(ERR_SEC_AUTH_FAILED, Some(true)), VaultError::Locked);\n        assert_eq!(map(ERR_SEC_USER_CANCELED, Some(true)), VaultError::Locked);\n        assert_eq!(map(ERR_SEC_NO_SUCH_KEYCHAIN, None), VaultError::Unavailable);\n        assert_eq!(map(-1, None), VaultError::Unavailable);\n    }\n}\n//! Protected credential storage seam and the session-only store.\n//!\n//! Credentials are immutable records (`cr-` + 16 hex digits). A record is\n//! written once, read for use and deleted on replacement, sign-out, endpoint\n//! change or reset; a newer record never reuses an older ID, so a late\n//! completion cannot overwrite current material. The native host supplies the\n//! Keychain implementation; [`SessionVault`] keeps explicitly session-only\n//! credentials in memory, zeroized on removal and when the app ends. Vault\n//! calls block, so the core runs them off the transition lock on the runtime's\n//! blocking pool.\n\nuse std::collections::HashMap;\nuse std::sync::Mutex;\n\nuse serde::{Deserialize, Serialize};\nuse ts_rs::TS;\nuse zeroize::Zeroizing;\n\n/// Largest secret the vault stores (the SDK's `Secret` limit is 16 KiB).\npub const MAX_SECRET_BYTES: usize = 16 * 1024;\n\n/// Native-issued immutable credential record identifier.\n#[derive(Clone, Debug, PartialEq, Eq, PartialOrd, Ord, Hash, Serialize)]\n#[serde(transparent)]\npub struct RecordId(String);\n\nimpl RecordId {\n    pub(crate) fn issue() -> Option<Self> {\n        let mut entropy = [0u8; 8];\n        getrandom::fill(&mut entropy).ok()?;\n        Some(Self(format!(\"cr-{}\", hex::encode(entropy))))\n    }\n\n    pub fn parse(text: &str) -> Option<Self> {\n        let hex_part = text.strip_prefix(\"cr-\")?;\n        (hex_part.len() == 16\n            && hex_part\n                .bytes()\n                .all(|b| matches!(b, b'0'..=b'9' | b'a'..=b'f')))\n        .then(|| Self(text.to_owned()))\n    }\n\n    pub fn as_str(&self) -> &str {\n        &self.0\n    }\n}\n\nimpl<'de> Deserialize<'de> for RecordId {\n    fn deserialize<D: serde::Deserializer<'de>>(deserializer: D) -> Result<Self, D::Error> {\n        let text = String::deserialize(deserializer)?;\n        Self::parse(&text).ok_or_else(|| serde::de::Error::custom(\"not a record id\"))\n    }\n}\n\n/// Where an operator chose to keep a credential.\n#[derive(Clone, Copy, Debug, PartialEq, Eq, Serialize, Deserialize, TS)]\n#[serde(rename_all = \"camelCase\")]\npub enum StorageMode {\n    /// The macOS login Keychain (a dedicated test keychain in fixture builds).\n    Keychain,\n    /// Memory only; cleared on sign-out, reset and app exit. Never persisted.\n    Session,\n}\n\n/// Why a vault call failed. Sanitized: no OS message or secret material.\n#[derive(Clone, Copy, Debug, PartialEq, Eq, Serialize, Deserialize, TS, thiserror::Error)]\n#[serde(rename_all = \"camelCase\")]\npub enum VaultError {\n    #[error(\"the credential store is locked\")]\n    Locked,\n    #[error(\"access to the credential store was denied\")]\n    Denied,\n    #[error(\"the credential store is unavailable\")]\n    Unavailable,\n    #[error(\"the credential was not found\")]\n    NotFound,\n    #[error(\"the stored credential is unreadable\")]\n    Corrupt,\n}\n\n/// A blocking credential store for one storage mode.\npub trait Vault: Send + Sync + 'static {\n    /// Stores a new record. Records are immutable: callers never rewrite one.\n    fn put(&self, record: &RecordId, secret: &[u8]) -> Result<(), VaultError>;\n    /// Reads a record's secret.\n    fn get(&self, record: &RecordId) -> Result<Zeroizing<Vec<u8>>, VaultError>;\n    /// Deletes a record; a missing record is `NotFound`.\n    fn delete(&self, record: &RecordId) -> Result<(), VaultError>;\n}\n\n/// Session-only credentials, held in memory and zeroized when removed.\n#[derive(Default)]\npub struct SessionVault {\n    records: Mutex<HashMap<RecordId, Zeroizing<Vec<u8>>>>,\n}\n\nimpl SessionVault {\n    pub fn new() -> Self {\n        Self::default()\n    }\n\n    /// Clears every session credential (sign-out of all, reset, shutdown).\n    pub fn clear(&self) {\n        if let Ok(mut records) = self.records.lock() {\n            records.clear();\n        }\n    }\n\n    pub fn len(&self) -> usize {\n        self.records.lock().map(|r| r.len()).unwrap_or(0)\n    }\n\n    pub fn is_empty(&self) -> bool {\n        self.len() == 0\n    }\n}\n\nimpl Vault for SessionVault {\n    fn put(&self, record: &RecordId, secret: &[u8]) -> Result<(), VaultError> {\n        let mut records = self.records.lock().map_err(|_| VaultError::Unavailable)?;\n        records.insert(record.clone(), Zeroizing::new(secret.to_vec()));\n        Ok(())\n    }\n\n    fn get(&self, record: &RecordId) -> Result<Zeroizing<Vec<u8>>, VaultError> {\n        let records = self.records.lock().map_err(|_| VaultError::Unavailable)?;\n        records\n            .get(record)\n            .map(|s| Zeroizing::new(s.to_vec()))\n            .ok_or(VaultError::NotFound)\n    }\n\n    fn delete(&self, record: &RecordId) -> Result<(), VaultError> {\n        let mut records = self.records.lock().map_err(|_| VaultError::Unavailable)?;\n        records.remove(record).map(drop).ok_or(VaultError::NotFound)\n    }\n}\n\nimpl Drop for SessionVault {\n    fn drop(&mut self) {\n        self.clear();\n    }\n}\n\n/// The credential store used when the OS store cannot be opened: every\n/// call reports `Unavailable`; there is no fallback to another store.\npub struct UnavailableVault;\n\nimpl Vault for UnavailableVault {\n    fn put(&self, _: &RecordId, _: &[u8]) -> Result<(), VaultError> {\n        Err(VaultError::Unavailable)\n    }\n\n    fn get(&self, _: &RecordId) -> Result<Zeroizing<Vec<u8>>, VaultError> {\n        Err(VaultError::Unavailable)\n    }\n\n    fn delete(&self, _: &RecordId) -> Result<(), VaultError> {\n        Err(VaultError::Unavailable)\n    }\n}\n\nimpl crate::authority::CredentialStore for UnavailableVault {\n    fn purge(&self) -> Result<(), VaultError> {\n        Err(VaultError::Unavailable)\n    },\n    /// Make a destination the active one (C28). Refused unless the feature\n    /// is in the current presentation's catalogue and available; the native\n    /// menu, the sidebar and the palette all go through here.\n    Navigate {\n        feature: FeatureId,\n    },\n    /// Advance the first-run wizard (C28/C29): never back to `needed`.\n    SetOnboarding {\n        state: features::OnboardingState,\n    },\n    /// The \"show the calls\" preference (C28).\n    SetShowCalls {\n        on: bool,\n    },\n    /// Start a tenant setup (C29): a draft with its own context that the\n    /// credential intents and `verifyTenantSetup` address. One at a time;\n    /// `firstRun` only while no tenant exists.\n    BeginTenantSetup {\n        mode: features::SetupMode,\n        profile: ProfileDraft,\n    },\n    /// Change the draft's profile. A new destination retires the draft's\n    /// credentials (they were bound to the old origin).\n    UpdateTenantSetup {\n        context: ContextRef,\n        profile: ProfileDraft,\n    },\n    /// Record the draft's chosen products (Runtime Security always).\n    ChooseSetupProducts {\n        context: ContextRef,\n        products: Vec<features::ProductId>,\n    },\n    /// Verify the draft's current inputs over the admitted reads; the\n    /// lines stream through `ShellSnapshot.setup.verify`.\n    VerifyTenantSetup {\n        context: ContextRef,\n    },\n    /// Commit the draft as a tenant (products, verify warnings, active\n    /// selection, first-run onboarding) and import the chosen starter\n    /// packs. Refused unless the current inputs were verified without a\n    /// blocking failure (an optional service's failure is carried as a warning).\n    CompleteTenantSetup {\n        context: ContextRef,\n        packs: Vec<features::ProductId>,\n        /// Completion is a tenant switch (I1): a pending Harness decision\n        /// refuses it until the operator resolves the conversation.\n        #[serde(default)]\n        resolution: Option<inbox_domain::SwitchResolution>,\n    },\n    /// Drop the draft and clean up its credentials. Nothing else changes.\n    DiscardTenantSetup {\n        context: ContextRef,\n    },\n    /// Create a tenant profile with no credential.\n    CreateTenant {\n        profile: ProfileDraft,\n    },\n    /// Make a tenant active; issues a new context reference.\n    SelectTenant {\n        tenant: TenantId,\n    },\n    /// Run an API Client request in its turn.\n    Workbench {\n        operation: OperationId,\n        request: WorkbenchRequest,\n    },\n    /// Run a Harness conversation as its own task (C19).\n    Harness(Box<harness_domain::HarnessStart>),\n    /// Company sign-in through the browser (C20).\n    HarnessSignIn(Box<harness_identity::SignInJob>),\n    /// Revoke a signed-out grant (C20).\n    HarnessSignedOut(Arc<harness_identity::Grant>),\n    /// Renew a sign-in token before a message is sent (C20).\n    HarnessRenew(Box<harness_domain::RenewJob>),\n    /// Read, open or delete protected history (C20).\n    HarnessHistory(harness_history::HistoryJob),\n    /// Remove a removed tenant's history directory once its saves under\n    /// way have settled (C20).\n    ForgetHarnessHistory(TenantId, std::path::PathBuf),\n    /// Choose the Harness project in the native folder sheet (C21).\n    ChooseHarnessProject(ContextRef),\n    /// Reads the chosen workspace's MCP catalog (C22).\n    McpCatalog {\n        context: ContextRef,\n        reference: WorkspaceRef,\n        lease: u64,\n    },\n    McpSignIn(Box<harness_mcp::McpSignInJob>),\n    McpSignedOut(Arc<harness_mcp::McpGrant>),\n}\n\nstruct Inner {\n    state: Mutex<State>,\n    adapters: Adapters,\n    session: Arc<SessionVault>,\n    diagnostics: Arc<crate::diagnostics::Diagnostics>,\n}\n\n/// The application core. The native host creates exactly one.\n#[derive(Clone)]\npub struct Core {\n    inner: Arc<Inner>,\n}\n\nimpl Core {\n    /// Creates the core and loads persisted state. A corrupt or unavailable\n    /// document is reported in the snapshot and never overwritten implicitly.\n    pub fn new(config: CoreConfig, adapters: Adapters) -> Self {\n        let (storage, data) = match adapters.store.load() {\n            Ok(Some(doc)) => (StorageHealth::Ready, data_from(doc)),\n            Ok(None) => (StorageHealth::Ready, Data::default()),\n            Err(StoreError::Corrupt) => (StorageHealth::Corrupt, Data::default()),\n            // Loading never reports Unconfirmed; treat it as unavailable.\n            Err(StoreError::Unavailable | StoreError::Unconfirmed) => {\n                (StorageHealth::Unavailable, Data::default())\n            }\n        };\n        let diagnostics = Arc::new(crate::diagnostics::Diagnostics::open(\n            adapters.logs_root.clone(),\n        ));\n        diagnostics.record(crate::diagnostics::Event::Started {\n            version: env!(\"CARGO_PKG_VERSION\").to_owned(),\n            fixture: cfg!(feature = \"test-fixtures\"),\n        });\n        if storage != StorageHealth::Ready {\n            diagnostics.record(crate::diagnostics::Event::Storage {\n                health: refusal_code_of(&storage),\n            });\n        }\n        let mut salt = [0u8; 16];\n        // Without entropy every reference would still be unique per epoch;\n        // the salt only makes them unguessable across launches.\n        let _ = getrandom::fill(&mut salt);\n        // The default Direct policy has no failing inputs; if the TLS stack\n        // is unusable the scan capability reports missing instead.\n        let transport = TransportFactory::new(TransportPolicy::default())\n            .ok()\n            .map(Arc::new);\n        let mut state = State {\n            revision: 1,\n            operator_sessions: Sessions::new(config.retained_results),\n            subscribers: Subscribers::new(config.observer_queue),\n            admitted: 0,\n            storage,\n            data,\n            active_feature: None,\n1://! Native authority: principal-bound handles, finite intents and observation.\n101:/// request payload. Restricted Harness principals arrive with the Harness\n143:    BeginTenantSetup {\n167:    CompleteTenantSetup {\n170:        /// Completion is a tenant switch (I1): a pending Harness decision\n186:        /// How a switch blocked by a pending Harness decision proceeds\n346:    /// Start a native Harness conversation in the chosen workspace with\n348:    StartHarness {\n355:    ConfigureHarnessSignIn {\n364:    RemoveHarnessSignIn {\n368:    ChooseHarnessCredential {\n373:    SignInHarness {\n376:    CancelHarnessSignIn {\n380:    SignOutHarness {\n383:    /// Choose the Harness project folder in the native folder sheet (C21).\n384:    ChooseHarnessProject {\n387:    ClearHarnessProject {\n391:    SetHarnessWrite {\n396:    DecideHarnessApproval {\n402:    ReviewHarnessProposal {\n406:    DismissHarnessProposal {\n411:    ConfirmHarnessWrite {\n445:    ListHarnessHistory {\n450:    OpenHarnessHistory {\n455:    CloseHarnessHistory {\n460:    DeleteHarnessHistory {\n466:    ExportHarnessHistory {\n474:    ResumeHarness {\n480:    SendHarness {\n492:    InterruptHarness {\n496:    EndHarness {\n500:    ClearHarness {\n799:    BeginTenantSetup => \"beginTenantSetup\",\n803:    CompleteTenantSetup => \"completeTenantSetup\",\n836:    StartHarness => \"startHarness\",\n837:    ConfigureHarnessSignIn => \"configureHarnessSignIn\",\n838:    RemoveHarnessSignIn => \"removeHarnessSignIn\",\n839:    ChooseHarnessCredential => \"chooseHarnessCredential\",\n840:    SignInHarness => \"signInHarness\",\n841:    CancelHarnessSignIn => \"cancelHarnessSignIn\",\n842:    SignOutHarness => \"signOutHarness\",\n843:    ChooseHarnessProject => \"chooseHarnessProject\",\n844:    ClearHarnessProject => \"clearHarnessProject\",\n845:    SetHarnessWrite => \"setHarnessWrite\",\n846:    DecideHarnessApproval => \"decideHarnessApproval\",\n847:    ReviewHarnessProposal => \"reviewHarnessProposal\",\n848:    DismissHarnessProposal => \"dismissHarnessProposal\",\n849:    ConfirmHarnessWrite => \"confirmHarnessWrite\",\n855:    ListHarnessHistory => \"listHarnessHistory\",\n856:    OpenHarnessHistory => \"openHarnessHistory\",\n","exit_code":0,"status":"completed"}}
