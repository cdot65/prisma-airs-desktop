ot -path '*/__pycache__/*' -not -path '*/target/*' -not -path '*/node_modules/*' -not -path '*/gen/schemas/*' -not -path '*/.git/*' -print0 | sort -z | xargs -0 shasum -a 256\n  shasum -a 256 \"${FILES[@]}\" apps/desktop/*.ts apps/desktop/*.json docs/architecture/*.json\n} | LC_ALL=C sort -k2 > \"$2\"\n[ -s \"$2\" ] || { echo \"inventory: empty\" >&2; exit 2; }\nshasum -a 256 \"$2\" | cut -d' ' -f1\n{\n  \"schema\": \"airs-v2/p09-native-build-inputs/1\",\n  \"generation\": \"worf-04\",\n  \"source_head\": \"c93a0a0202eb2b14ce629b9bb2e2856c908768fc\",\n  \"worktree_diff\": \"docs/planning/evidence/P09/preparations/worf-04/fixture-remediation.diff\",\n  \"worktree_diff_sha256\": \"7e0c29f06ad7f3c4467576337e9e5fb8934a1f0858c7afdd8efad4df59b7cbeb\",\n  \"prepare\": \"docs/planning/evidence/P09/native-prepare.json\",\n  \"prepare_sha256\": \"5540ad23b765d570a801ecab43cf35b3d89a1febb2cc8fedc0836926ffd73c1f\",\n  \"executable_sha256\": \"023bd5732793f1339766baf21176373ad2e23add6e8ad9f20cedb8c4d434ef61\",\n  \"bundle_sha256\": \"12a6140568950f7c329cb859f42d0aaa9a3d4d2280ee529fa5cf02a09569a56b\",\n  \"inputs\": {\n    \"procedure\": \"docs/planning/evidence/P09/runs/hash-inputs.sh\",\n    \"procedure_sha256\": \"0a4f9546e1aa4a812da6a946c6ee73d9a0e69c3fd4534dd3d480d5c804b53ea1\",\n    \"before_inventory\": \"docs/planning/evidence/P09/preparations/worf-04/inputs-before.sha256\",\n    \"after_inventory\": \"docs/planning/evidence/P09/preparations/worf-04/inputs-after.sha256\",\n    \"before_digest\": \"71ef915a9161a52e1f37889f8e321504da052f35c59b9d9aaccd13260b9e56ba\",\n    \"after_digest\": \"71ef915a9161a52e1f37889f8e321504da052f35c59b9d9aaccd13260b9e56ba\",\n    \"unchanged\": true,\n    \"members\": 18338\n  },\n  \"command\": {\n    \"argv\": [\n      \"cargo\",\n      \"run\",\n      \"--locked\",\n      \"-p\",\n      \"xtask\",\n      \"--\",\n      \"native-prepare\",\n      \"--phase\",\n      \"P09\",\n      \"--target\",\n      \"aarch64-apple-darwin\",\n      \"--