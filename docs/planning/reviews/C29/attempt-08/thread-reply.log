packages .inputs/academy\\\".split(); skip={\\\"__pycache__\\\",\\\"target\\\",\\\"node_modules\\\",\\\".git\\\"}; actual=[]\nfor d in rootdirs:\n for parent,dirs,files in os.walk(d,followlinks=False):\n  dirs[:]=[x for x in dirs if x not in skip and not str(Path(parent)/x).endswith(\\\"/gen/schemas\\\")]\n  actual.extend(str(Path(parent)/x) for x in files if not (Path(parent)/x).is_symlink())\nactual += \\\"docs/planning/evidence/C29/live/L19/attempt-01/wizard-verify.json Cargo.toml Cargo.lock rust-toolchain.toml pnpm-lock.yaml package.json pnpm-workspace.yaml resources/harness/pin.json apps/desktop/package.json apps/desktop/index.html packages/desktop-contracts/package.json packages/desktop-contracts/tsconfig.json\\\".split(); actual += [str(p) for g in [\\\"apps/desktop/*.ts\\\",\\\"apps/desktop/*.json\\\",\\\"docs/architecture/*.json\\\"] for p in Path.cwd().glob(g)]; actual=[p.removeprefix(str(Path.cwd())+\\\"/\\\") for p in actual]; recorded=[s.split(\\\"  \\\",1)[1] for s in Path(\\\"docs/planning/evidence/P09/runs/attempt-05/inputs-before.sha256\\\").read_text().splitlines()]; print(\\\"CLOSURE MEMBERSHIP\\\",len(actual),len(recorded), \\\"omitted\\\",sorted(set(actual)-set(recorded)),\\\"extra\\\",sorted(set(recorded)-set(actual)))' \"","aggregated_output":"BUNDLE 1621 12a6140568950f7c329cb859f42d0aaa9a3d4d2280ee529fa5cf02a09569a56b expected 12a6140568950f7c329cb859f42d0aaa9a3d4d2280ee529fa5cf02a09569a56b\nAUTHORITY PRODUCTION REMAINDER 1 True\nCLOSURE MEMBERSHIP 18338 18338 omitted [] extra []\n","exit_code":0,"status":"completed"}}
