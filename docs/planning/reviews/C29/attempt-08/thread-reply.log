{"type":"item.started","item":{"id":"item_68","type":"command_execution","command":"/bin/zsh -lc \"cat crates/desktop-core/tests/ui_v2_wizard/main.rs docs/architecture/ui-v2/screens/shell.md docs/architecture/ui-v2/screens/academy.md; sed -n '235,305p' crates/desktop-core/src/authority/gateway_domain.rs; sed -n '380,452p' crates/desktop-core/src/authority/gateway_domain.rs\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_68","type":"command_execution","command":"/bin/zsh -lc \"cat crates/desktop-core/tests/ui_v2_wizard/main.rs docs/architecture/ui-v2/screens/shell.md docs/architecture/ui-v2/screens/academy.md; sed -n '235,305p' crates/desktop-core/src/authority/gateway_domain.rs; sed -n '380,452p' crates/desktop-core/src/authority/gateway_domain.rs\"","aggregated_output":"//! C43: the wizard as the R2Onboard board draws it, through the production\n//! authority interface (docs/planning/chunks/C43.md). What the re-ported\n//! presentation draws from, unchanged from C29: the setup draft's profile\n//! (the rail's context line and the Tenant card), which credential is\n//! required (the Required/Optional tags), the products chosen (the product\n//! cards), the verify run's lines including the unavailable products (the\n//! Checks card), the packs offered with their counts (the starter-case rows)\n//! and completability (the footer's primary). Nothing here commits a tenant.\n\nuse desktop_core::features::{ProductId, VerifyLine, VerifyState};\nuse desktop_core::fixtures::{self, Handles, ScriptedStore};\nuse desktop_core::store::PersistedState;\nuse desktop_core::{\n    AuthorityHandle, Core, CoreConfig, Delivery, Intent, Observation, Receipt, Refusal,\n    ShellSnapshot, ViewScope,\n};\nuse serde_json::json;\n\nstruct Desk {\n    _core: Core,\n    handle: AuthorityHandle,\n    session: String,\n    sequence: u64,\n    #[allow(dead_code)]\n    adapters: Handles,\n}\n\nimpl Desk {\n    fn new() -> Self {\n        let (adapters, handles) =\n            fixtures::adapters_with(ScriptedStore::with_state(PersistedState::default()));\n        let core = Core::new(CoreConfig::default(), adapters);\n        core.start();\n        let handle = core.operator();\n        let session = handle.register_delivery_session().expect(\"session\").nonce;\n        Self {\n            _core: core,\n            handle,\n            session,\n            sequence: 0,\n            adapters: handles,\n        }\n    }\n\n    async fn send(&mut self, intent: serde_json::Value) -> Result<Receipt, Refusal> {\n        let intent: Intent = serde_json::from_value(intent).expect(\"intent\");\n        self.sequence += 1;\n        self.handle\n            .dispatch(\n                Delivery {\n                    session: self.session.clone(),\n                    sequence: self.sequence,\n                },\n                intent,\n            )\n            .await\n    }\n\n    fn snap(&self) -> ShellSnapshot {\n        match self.handle.observe(ViewScope::Shell).expect(\"observe\") {\n            Observation::Shell { snapshot, .. } => snapshot,\n            _ => unreachable!(\"shell scope\"),\n        }\n    }\n\n    fn setup(&self) -> desktop_core::features::SetupView {\n        self.snap().setup.expect(\"a setup in progress\")\n    }\n\n    async fn verified(&self) -> desktop_core::features::VerifyView {\n        for _ in 0..200 {\n            if let Some(v) = self.setup().verify\n                && v.done\n            {\n                return v;\n            }\n            tokio::time::sleep(std::time::Duration::from_millis(5)).await;\n        }\n        panic!(\"verification did not finish\");\n    }\n}\n\n#[tokio::test]\nasync fn the_board_draws_the_draft_the_tags_the_cards_and_the_checks_from_the_setup_view() {\n    let mut desk = Desk::new();\n    desk.send(json!({\"kind\": \"setUiVariant\", \"variant\": \"v2\"}))\n        .await\n        .expect(\"v2\");\n    desk.send(\n        json!({\"kind\": \"beginTenantSetup\", \"mode\": \"firstRun\", \"profile\": {\n        \"label\": \"Northwind Health\", \"tsgId\": \"1762204418\",\n        \"destination\": {\"kind\": \"region\", \"region\": \"europe\"}, \"environment\": \"staging\"}}),\n    )\n    .await\n    .expect(\"begun\");\n    let s = serde_json::to_value(desk.setup()).expect(\"json\");\n    // The rail's context line and the Tenant card.\n    assert_eq!(s[\"tenant\"][\"label\"], \"Northwind Health\");\n    assert_eq!(s[\"tenant\"][\"tsgId\"], \"1762204418\");\n    assert_eq!(s[\"tenant\"][\"environment\"], \"staging\");\n    assert_eq!(s[\"tenant\"][\"destination\"][\"region\"], \"europe\");\n    // First run: the scan key card is Required, the management card Optional (the core says which).\n    assert_eq!(s[\"scanRequired\"], true);\n    assert_eq!(s[\"tenant\"][\"scan\"][\"state\"], \"missing\");\n    assert_eq!(s[\"tenant\"][\"management\"][\"state\"], \"missing\");\n    // The product cards: Runtime always on; the packs rows with their counts.\n    assert_eq!(s[\"products\"], json!([\"runtimeSecurity\"]));\n    let packs = s[\"packs\"].as_array().expect(\"packs\");\n    assert!(\n        packs\n            .iter()\n            .any(|p| p[\"product\"] == \"runtimeSecurity\" && p[\"count\"].as_u64().unwrap_or(0) > 0),\n        \"{packs:?}\"\n    );\n    // Before any run the footer's primary on Verify is closed.\n    assert!(s[\"verify\"].is_null());\n    assert_eq!(s[\"completable\"], false);\n    // Choosing a product is recorded in the core as the card toggles.\n    let context = desk.setup().context.as_str().to_owned();\n    desk.send(json!({\"kind\": \"chooseSetupProducts\", \"context\": context, \"products\": [\"runtimeSecurity\", \"gateway\"]}))\n        .await\n        .expect(\"products\");\n    assert_eq!(\n        desk.setup().products,\n        vec![ProductId::RuntimeSecurity, ProductId::Gateway]\n    );\n    // The Checks card: one line per credential and chosen product, and the two unavailable products.\n    let context = desk.setup().context.as_str().to_owned();\n    desk.send(json!({\"kind\": \"verifyTenantSetup\", \"context\": context}))\n        .await\n        .expect(\"verify\");\n    let v = desk.verified().await;\n    let lines: Vec<VerifyLine> = v.steps.iter().map(|s| s.line).collect();\n    for line in [\n        VerifyLine::ScanKey,\n        VerifyLine::ManagementClient,\n        VerifyLine::Gateway,\n        VerifyLine::Ais,\n        VerifyLine::Aes,\n    ] {\n        assert!(lines.contains(&line), \"{lines:?}\");\n    }\n    assert!(\n        v.steps\n            .iter()\n            .filter(|s| matches!(s.line, VerifyLine::Ais | VerifyLine::Aes))\n            .all(|s| s.state == VerifyState::Unavailable)\n    );\n    // Without a scan key on first run the run fails and the footer's primary stays closed.\n    assert!(v.failed && v.blocking);\n    assert!(!desk.setup().completable);\n}\n\n#[tokio::test]\nasync fn add_mode_has_no_required_scan_key_and_the_sheet_discards_its_draft_on_cancel() {\n    let mut desk = Desk::new();\n    desk.send(json!({\"kind\": \"setUiVariant\", \"variant\": \"v2\"}))\n        .await\n        .expect(\"v2\");\n    desk.send(json!({\"kind\": \"setOnboarding\", \"state\": \"done\"}))\n        .await\n        .expect(\"done\");\n    desk.send(\n        json!({\"kind\": \"beginTenantSetup\", \"mode\": \"add\", \"profile\": {\n        \"label\": \"Coastal Bank\", \"tsgId\": \"1001464285\",\n        \"destination\": {\"kind\": \"region\", \"region\": \"unitedStates\"}, \"environment\": \"production\"}}),\n    )\n    .await\n    .expect(\"begun\");\n    let s = serde_json::to_value(desk.setup()).expect(\"json\");\n    assert_eq!(s[\"mode\"], \"add\");\n    // The add sheet's scan card is Optional.\n    assert_eq!(s[\"scanRequired\"], false);\n    assert!(desk.snap().tenants.is_empty(), \"a draft is not a tenant\");\n    // Cancel discards the draft in the core; the shell is untouched.\n    let context = desk.setup().context.as_str().to_owned();\n    desk.send(json!({\"kind\": \"discardTenantSetup\", \"context\": context}))\n        .await\n        .expect(\"discarded\");\n    assert!(desk.snap().setup.is_none());\n    assert!(desk.snap().tenants.is_empty());\n}\n# Shell, Home, tenant switcher, palette, toasts\n\nSource: `prototype/R2App.dc.html` (sidebar markup, `nav`, `switchPatch`,\n`requestSwitch`, `palette*`, `toast*`, `top`, Home section). Chunk: C28 (shell,\nHome skeleton), C30 (Home attention list backed by Inbox scope).\n\n## Sidebar\n\n- Top: tenant switcher button showing tenant name and environment pill;\n  ⌘T opens the list. Entries: every tenant (name, environment, TSG), then\n  \"Add a tenant…\". Selected tenant uses `sel/selInk`.\n- Destinations in the order of DESIGN-V2 §5 with icon, label, shortcut hint.\n  Unavailable destinations render disabled with their availability reason as\n  a tooltip and accessible description, never hidden.\n- Bottom: appearance toggle (light/dark/system) and \"Show the calls\" toggle,\n  both dispatching their Rust preference.\n- Collapses to icons below 1280px window width.\n\n## Home\n\n- Title \"Home\" with the tenant name and environment beneath; last-read line\n  from `ReadStatus` (\"Read finished at 07:45 · all sources complete\" or\n  \"· 3 sources partial\", warn-styled when partial; \"First read pending\" on a\n  fresh tenant).\n- \"Needs attention\": up to five Inbox items of kind Needs action, each with\n  severity (colour + icon + word), title, product, action button that\n  navigates with context, Acknowledge, and Snooze whose tooltip and\n  accessible name are the item's `snoozeLabel`.\n- Product cards for admitted, licensed products with their read state;\n  unlicensed products are listed once as \"Not licensed in this tenant\" and\n  unavailable products once as \"Not available in this release\" (DESIGN-V2\n  §6), never hidden.\n- Playground card (Runtime Security scan): prompt, direction, profile select,\n  verdict panel (word + icon + reason + plain explanation). Verdicts are\n  profile-aware: a detector not enabled, or a topic not assigned, reads \"Not\n  detected\" with the reason; monitor-only turns Blocked into Flagged with the\n  profile named.\n\n## Tenant switch (I1, I2)\n\n- `switchTenant{tenant_id, resolution?}`; the core refuses with\n  `SwitchBlocked{pending: {conversation, decision}}` when a Harness decision is\n  pending. The UI renders the guard dialog (Archive and switch / Discard and\n  switch / Stay) from that payload and re-dispatches with `resolution`. Initial\n  focus is on Stay, the safe default (Enter on arrival never ends the\n  conversation); Archive and switch stays the visually primary action.\n- Every entry point (switcher, palette, menu, wizard completion) uses the same\n  intent. After a switch the new tenant's Home renders from cached scopes within\n  100 ms with read status pending until the read lands.\n\n## Command palette\n\n- ⌘K. Entries: destinations from the Rust inventory, tenants, and three actions\n  (Navigate, Switch tenant, Read now). Typing filters; Enter dispatches; Escape\n  closes and restores focus. Native menu navigation while the palette is open\n  closes it first.\n\n## Toasts (I10)\n\n- Kinds ok, info, warn with icon and colour; one visible at a time, newest\n  replaces; 6 s expiry (persist under Reduce Motion); optional Undo action\n  (snooze). A toast never carries information absent from an observed scope.\n\n## Modals (I8)\n\n- Stack order kept in the shell store; only the topmost is interactive;\n  siblings get `aria-hidden`; Escape closes the topmost; focus returns to the\n  opener. Detail sheets (transcripts, facts) are modals in this stack.\n\n## Fixtures and tests\n\n- Fixture boards: R2Palette, R2Tenants, R2Dark, R2App default.\n- V2-T01, T02, T09, T10, T11; V2-N01, N03, N04, N05.\n# Academy embed\n\nSource: `R2App` Academy section, board R2Academy. Chunk: C34.\n\nThe Academy learner view (react-query, react-router, Academy ShellFrame) is\nhosted inside the new shell unchanged: the new sidebar replaces its outer\nframe, its inner routing and tests stay intact. Gamification appears only\nhere. The wizard's Academy step is the only other Academy surface.\n\nTokens: Academy's `--academy-*` variables remain its own; within the embed\nscope the shell aliases nothing. The embed receives the Rust-owned theme.\n\nTests: existing Academy presentation tests unchanged; one shell test that the\nembed mounts under `academy` and receives theme changes.\n                restored: false,\n            });\n        }\n        Ok(Vec::new())\n    }\n\n    fn choose(\n        &mut self,\n        context: ContextRef,\n        workspace: ListedWorkspace,\n        restored: bool,\n    ) -> Vec<crate::runtime::Start> {\n        let reference = self.issue_workspace();\n        let starts = self.retire_workspace_reads(Some(&reference));\n        self.gateway.selection = Some(Selection {\n            reference,\n            context,\n            workspace,\n            restored,\n        });\n        starts\n    }\n\n    /// A Workspaces listing settled for `context` (still current): it\n    /// replaces the last one. A choice it no longer lists (completely) is\n    /// cleared; the tenant's remembered workspace is restored when listed.\n    pub(super) fn gateway_listed(&mut self, context: &ContextRef, list: &GatewayList) {\n        let workspaces = crate::gateway::listed_workspaces(list);\n        if self.is_setup_context(context) {\n            // The draft's listing: its own choice is reconciled, or restored\n            // from the draft's remembered workspace (a credential change\n            // retired the earlier choice with its context); the active\n            // tenant's listing and choice are untouched.\n            let reference = self.issue_workspace();\n            if let Some(setup) = self.data.setup.as_mut() {\n                match setup.gateway.selection.as_mut() {\n                    Some(selection) => {\n                        match workspaces.iter().find(|w| w.id == selection.workspace.id) {\n                            Some(listed) => selection.workspace = listed.clone(),\n                            None if list.complete => setup.gateway.selection = None,\n                            None => {}\n                        }\n                    }\n                    None => {\n                        if let Some(listed) = setup\n                            .tenant\n                            .gateway_workspace\n                            .as_deref()\n                            .and_then(|id| workspaces.iter().find(|w| w.id == id))\n                        {\n                            setup.gateway.selection = Some(Selection {\n                                reference,\n                                context: context.clone(),\n                                workspace: listed.clone(),\n                                restored: true,\n                            });\n                        }\n                    }\n                }\n                setup.gateway.workspaces = Some(workspaces);\n            }\n            return;\n        }\n        let mut starts = Vec::new();\n        if let Some(selection) = self.gateway.selection.as_mut() {\n            match workspaces.iter().find(|w| w.id == selection.workspace.id) {\n                Some(listed) => selection.workspace = listed.clone(),\n                None if list.complete => {\n                    self.gateway.selection = None;\n                    starts = self.retire_workspace_reads(None);\n                }\n                reference: s.reference.clone(),\n                workspace: s.workspace.clone(),\n                restored: s.restored,\n            })\n    }\n\n    /// The workspace selection made under `context`: the active tenant's\n    /// or the setup draft's (C29); never the other one's.\n    fn selection_under(&self, context: &ContextRef) -> Option<&Selection> {\n        if self.is_setup_context(context) {\n            self.data\n                .setup\n                .as_ref()\n                .and_then(|s| s.gateway.selection.as_ref())\n                .filter(|s| &s.context == context)\n        } else {\n            self.gateway\n                .selection\n                .as_ref()\n                .filter(|s| &s.context == context)\n        }\n    }\n\n    /// The current selection's reference.\n    pub(super) fn gateway_selection(&self) -> Option<WorkspaceRef> {\n        self.gateway.selection.as_ref().map(|s| s.reference.clone())\n    }\n\n    /// The workspace `reference` names, while it is the current choice\n    /// under `context`.\n    pub(super) fn selected_workspace(\n        &self,\n        context: &ContextRef,\n        reference: &WorkspaceRef,\n    ) -> Option<ListedWorkspace> {\n        self.selection_under(context)\n            .filter(|s| &s.reference == reference)\n            .map(|s| s.workspace.clone())\n    }\n\n    /// The chosen workspace under `context`, if any (an overview reads its\n    /// Gateway activity).\n    pub(super) fn chosen_scope(\n        &self,\n        context: &ContextRef,\n    ) -> Option<crate::gateway::WorkspaceScope> {\n        self.gateway\n            .selection\n            .as_ref()\n            .filter(|s| &s.context == context)\n            .map(|s| crate::gateway::WorkspaceScope::from(&s.workspace))\n    }\n\n    /// Whether a result read under `workspace` may still be shown.\n    pub(super) fn workspace_current(&self, workspace: Option<&WorkspaceRef>) -> bool {\n        workspace.is_none_or(|w| {\n            self.gateway\n                .selection\n                .as_ref()\n                .is_some_and(|s| &s.reference == w)\n                || self.setup_workspace_reference().as_ref() == Some(w)\n        })\n    }\n\n    /// The draft's chosen workspace reference (C29), if any.\n    pub(super) fn setup_workspace_reference(&self) -> Option<WorkspaceRef> {\n        self.data\n            .setup\n            .as_ref()\n            .and_then(|s| s.gateway.selection.as_ref())\n            .map(|s| s.reference.clone())\n    }\n}\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_69","type":"command_execution","command":"/bin/zsh -lc \"cat tools/native-acceptance/fixture_app.py | head -135; sed -n '310,335p' tools/native-acceptance/legacy_assertions.py; sed -n '320,415p' packages/desktop-contracts/src/client.ts; cat packages/desktop-contracts/src/generated/SetupView.ts packages/desktop-contracts/src/generated/VerifyView.ts; python3 -c 'import json; d=json.load(open(\\\"docs/planning/evidence/C29/native-acceptance.json\\\")); print({k:d.get(k) for k in [\\\"subject\\\",\\\"host\\\",\\\"app\\\",\\\"limitations\\\"]}); print([(c[\\\"id\\\"],c[\\\"result\\\"]) for c in d[\\\"checks\\\"]])' \"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_69","type":"command_execution","command":"/bin/zsh -lc \"cat tools/native-acceptance/fixture_app.py | head -135; sed -n '310,335p' tools/native-acceptance/legacy_assertions.py; sed -n '320,415p' packages/desktop-contracts/src/client.ts; cat packages/desktop-contracts/src/generated/SetupView.ts packages/desktop-contracts/src/generated/VerifyView.ts; python3 -c 'import json; d=json.load(open(\\\"docs/planning/evidence/C29/native-acceptance.json\\\")); print({k:d.get(k) for k in [\\\"subject\\\",\\\"host\\\",\\\"app\\\",\\\"limitations\\\"]}); print([(c[\\\"id\\\"],c[\\\"result\\\"]) for c in d[\\\"checks\\\"]])' \"","aggregated_output":"\"\"\"Shared driving helpers for the prepared fixture app (C03 onward): process\ncontrol, the compiled Accessibility helper, frontmost-guarded keystrokes,\nfixture data-root hygiene and the synthetic scan endpoint.\n\nKeystrokes go through System Events only after the fixture app is confirmed\nfrontmost, so they can never reach another application. The fixture build\nkeeps data in its own Application Support directory and credentials in a\ndedicated fixture test keychain there; the login keychain and v1 data are\nnever touched.\n\"\"\"\n\nimport json\nimport os\nimport shutil\nimport signal\nimport socket\nimport subprocess\nimport time\n\nHOME = os.path.expanduser(\"~\")\nDATA = os.path.join(HOME, \"Library/Application Support/io.cdot.prisma-airs-desktop.v2.fixture\")\nKEYCHAIN = os.path.join(DATA, \"fixture-credentials.keychain-db\")\nROOTS = os.path.join(DATA, \"fixture-transport-roots.pem\")\nV1_DATA = os.path.join(HOME, \"Library/Application Support/Prisma AIRS Desktop\")\nPROCESS = \"Fixture.app/Contents/MacOS/prisma-airs-desktop-v2\"\nTOOLS = os.path.dirname(os.path.abspath(__file__))\n\n\ndef sh(argv, **kw):\n    return subprocess.run(argv, capture_output=True, text=True, **kw)\n\n\nclass App:\n    \"\"\"One fixture bundle driven through Accessibility.\"\"\"\n\n    def __init__(self, bundle, work, log):\n        self.bundle = bundle\n        self.log = log\n        self.ax_bin = os.path.join(work, \"ax\")\n        built = sh([\"swiftc\", \"-O\", os.path.join(TOOLS, \"ax.swift\"), \"-o\", self.ax_bin])\n        if built.returncode != 0:\n            raise SystemExit(f\"ax helper did not build: {built.stderr}\")\n        self.pid = None\n\n    def note(self, what, **data):\n        self.log.append({\"t\": time.strftime(\"%H:%M:%S\"), \"step\": what, **data})\n\n    # ---- process ----\n    @staticmethod\n    def running_pid():\n        out = sh([\"pgrep\", \"-f\", PROCESS]).stdout.split()\n        return int(out[0]) if out else None\n\n    def quit(self):\n        pid = self.running_pid()\n        if pid:\n            try:\n                self.keys(\"q\", \"command down\")\n            except RuntimeError:\n                pass\n            for _ in range(40):\n                time.sleep(0.25)\n                if not self.running_pid():\n                    break\n        sh([\"pkill\", \"-f\", PROCESS])\n        time.sleep(0.5)\n        self.pid = None\n\n    def kill(self):\n        \"\"\"Ends the process without a graceful quit (an abrupt close).\"\"\"\n        pid = self.running_pid()\n        if pid:\n            os.kill(pid, signal.SIGKILL)\n            for _ in range(20):\n                time.sleep(0.25)\n                if not self.running_pid():\n                    break\n        self.pid = None\n\n    def launch(self, settle=6):\n        self.quit()\n        sh([\"open\", \"-n\", self.bundle])\n        for _ in range(settle * 2):\n            time.sleep(0.5)\n            if self.running_pid():\n                break\n        self.pid = self.running_pid()\n        if not self.pid:\n            raise RuntimeError(\"the fixture app did not start\")\n        self.tree()  # announces the AX client so WebKit builds its tree\n        tree, _ = self.wait_for(lambda t: self.node(t, \"AXHeading\", \"\") is not None, 15)\n        time.sleep(0.5)\n        return self.pid\n\n    # ---- accessibility ----\n    def dump_tree(self, tag):\n        \"\"\"Keeps the current tree beside the probe for diagnosis; returns its path and a one-line summary.\"\"\"\n        dump = os.path.join(os.path.dirname(self.ax_bin), f\"ax-{tag}-{time.strftime('%H%M%S')}.json\")\n        try:\n            tree = self.tree()\n            with open(dump, \"w\") as f:\n                json.dump(tree, f)\n            heads = [n.get(\"label\") for n in tree if n.get(\"role\") == \"AXHeading\"][:6]\n            return f\"{dump} ({len(tree)} nodes; headings {heads}; window {bool(self.node(tree, 'AXWindow', ''))}; pid {self.pid} running {self.running_pid()})\"\n        except Exception as e:  # noqa: BLE001 - the diagnosis must not mask the failure\n            return f\"(tree unavailable: {e})\"\n\n    def ax(self, command, *args):\n        out = sh([self.ax_bin, command, str(self.pid), *[str(a) for a in args]])\n        if command == \"tree\":\n            return json.loads(out.stdout or \"[]\")\n        if out.returncode != 0:\n            # The tree at the failure, kept beside the probe for diagnosis (a control the driver expected was not there).\n            raise RuntimeError(f\"ax {command} {args}: {out.stderr.strip()} [tree: {self.dump_tree('failure')}]\")\n        return out.stdout\n\n    def tree(self):\n        return self.ax(\"tree\")\n\n    @staticmethod\n    def texts(tree):\n        return [n.get(\"label\") or \"\" for n in tree] + [str(n.get(\"value\")) for n in tree if n.get(\"value\") is not None]\n\n    def has_text(self, tree, fragment):\n        return any(fragment in t for t in self.texts(tree))\n\n    @staticmethod\n    def node(tree, role, prefix, nth=0):\n        found = [n for n in tree if n.get(\"role\") == role and (n.get(\"label\") or \"\").startswith(prefix)]\n        return found[nth] if nth < len(found) else None\n\n    @staticmethod\n    def focused(tree):\n        return next((n for n in tree if n.get(\"focused\") and n.get(\"role\") not in (\"AXWindow\", \"AXWebArea\", \"AXGroup\", \"AXScrollArea\")), None)\n\n    \"C22-N06\": (X, [\"C38-N02\"], \"the aside's Approve once and Decline reached by Tab (the servers' controls: harness.test.tsx)\"),\n    \"C22-N07\": (X, [\"C44-N01\", \"C38-N02\"], \"no token in any tree; no engine after the run\"),\n    # ---- C28 the first v2 shell ----\n    \"C28-N01\": (R, [], \"the interface switch is gone: C44-N01 asserts no 'Use the new interface' anywhere (one presentation)\"),\n    \"C28-N02\": (X, [\"C44-N01\"], \"the Go menu lists the v2 destinations and each opens its page\"),\n    \"C28-N03\": (X, [\"C35-N03\"], \"Tab reaches the tenant button, the destinations, the status block, the palette trigger, the Explain switch and Ask Harness with the focus ring (the classic-interface control is gone)\"),\n    \"C28-N04\": (X, [\"C36-N01\", \"C37-N01\"], \"the read status and the empty states as words\"),\n    \"C28-N05\": (X, [\"C43-N02\"], \"a toast after the sheet closes; a refused navigation's toast: apps/desktop/src/v2 tests\"),\n    \"C28-N06\": (X, [\"C35-N01\", \"C36-N01\"], \"the appearance toggle and the light and dark captures on the v2 tokens\"),\n    \"C28-N07\": (X, [\"C35-N03\"], \"900×600 and 200% with no horizontal overflow; the rail collapses\"),\n    # ---- C29 wizard → C43 ----\n    \"C29-N01\": (X, [\"C43-N01\"], \"Welcome with its cards and no Back, retained after relaunch; Set up a tenant (the C43 setup rail replaces the earlier rail-free welcome)\"),\n    \"C29-N02\": (X, [\"C43-N01\"], \"validation, drafting, scan/client custody, editing the draft without losing its key, Gateway workspace listing/choice and inference-key setup\"),\n    \"C29-N03\": (X, [\"C43-N01\"], \"product cards and actual rejected-client verification, editable credential correction, workspace re-choice and passing verification; a product edit marks the run stale and closes Continue until a clean rerun\"),\n    \"C29-N04\": (X, [\"C43-N01\"], \"Starter cases, Academy, Done and Open Prisma AIRS completing once, imported Runtime cases in Test Cases, followed by a relaunch to Home\"),\n    \"C29-N05\": (X, [\"C43-N02\"], \"the topmost add-tenant modal; Cancel before a draft and after storing a draft scan key, unchanged tenant rows/active tenant and actual Keychain record removal; Finish commits exactly once\"),\n    \"C29-N06\": (X, [\"C43-N03\"], \"all seven first-run and five add-tenant steps in Light/Dark at 100%/200% (48 rows), with per-row keyboard reach, geometry, AX tree and capture; the Tenant primary's focus ring\"),\n    # ---- C30 Inbox and reads → C36, C37 ----\n    \"C30-N01\": (X, [\"C38-N03\"], \"the guard through the switcher, the palette and the Go menu with a decision waiting; Escape and Stay keep the tenant and the decision; Archive and switch ends the conversation and lands the other tenant on Home with no engine (invariant I1)\"),\n    \"C30-N02\": (X, [\"C36-N01\", \"C37-N01\"], \"'First read pending' on Home and in the Inbox; Read now runs the read\"),\n    \"C30-N03\": (X, [\"C37-N01\"], \"snooze, acknowledge and unsnooze with the core's return time stated the same everywhere\"),\n    \"C30-N04\": (X, [\"C37-N02\"], \"Tab from Read now reaches the tabs and rows; Enter opens a row's detail\"),\n    # ---- C31 Administration → C39 ----\n    \"C31-N01\": (X, [\"C39-N01\"], \"the inventory per tab with exactly its admitted actions; the gated products show their gate\"),\n    \"C31-N02\": (S, [\"C31-N02\", \"C39-N02\"], \"acceptance_c31.py through legacy_v2: the custom topic edit through the review sheet, Apply on the exact name, the native confirmation, applied once; C39-N02 asserts the same on the board\"),\n    \"C31-N03\": (S, [\"C31-N03\"], \"acceptance_c31.py through legacy_v2: Issue additional key… reviewed and confirmed natively, the issued key revealed through the host's secret sheet, the review exit, the Inbox reminder and its resumption, the old key's removal (invariants I6/I7)\"),\n        isRecord(value.scan) &&\n        oneOf(SCAN_STATES, value.scan.state) &&\n        optional((m) => oneOf(MODES, m), value.scan.mode) &&\n        optional((f) => oneOf(VAULT_ERRORS, f), value.scan.failure) &&\n        isManagementView(value.management) &&\n        isInferenceKeyView(value.inference) &&\n        // C29: the products a tenant reads; Runtime Security is always first.\n        Array.isArray(value.products) &&\n        value.products.length >= 1 &&\n        value.products[0] === 'runtimeSecurity' &&\n        value.products.every((p: unknown) => typeof p === 'string' && PRODUCT_IDS.includes(p)) &&\n        new Set(value.products as string[]).size === value.products.length &&\n        // C29: verify warnings recorded at completion (Inbox items in C30).\n        Array.isArray(value.setupWarnings) &&\n        value.setupWarnings.every(isSetupWarning)\n    )\n}\n\nfunction isProductList(value: unknown): boolean {\n    return (\n        Array.isArray(value) &&\n        value.length >= 1 &&\n        value[0] === 'runtimeSecurity' &&\n        value.every((p: unknown) => typeof p === 'string' && PRODUCT_IDS.includes(p)) &&\n        new Set(value as string[]).size === value.length\n    )\n}\n\n/** The setup in progress (C29): a core-owned draft, never listed as a tenant. */\nfunction isSetupView(value: unknown): boolean {\n    if (\n        !isRecord(value) ||\n        !oneOf(SETUP_MODES, value.mode) ||\n        typeof value.context !== 'string' ||\n        !CONTEXT_REF.test(value.context) ||\n        !isTenant(value.tenant) ||\n        !isProductList(value.products) ||\n        typeof value.scanRequired !== 'boolean' ||\n        !optional((w) => isRecord(w) && typeof w.reference === 'string' && w.reference.length > 0 && isListedWorkspace(w.workspace) && typeof w.restored === 'boolean', value.workspace) ||\n        !Array.isArray(value.packs) ||\n        !value.packs.every((p: unknown) => isRecord(p) && oneOf(PRODUCT_IDS, p.product) && typeof p.count === 'number' && Number.isInteger(p.count) && p.count >= 0) ||\n        typeof value.completable !== 'boolean'\n    ) {\n        return false\n    }\n    const verify = value.verify\n    if (verify === null) return true\n    return (\n        isRecord(verify) &&\n        typeof verify.generation === 'number' &&\n        Number.isInteger(verify.generation) &&\n        verify.generation >= 1 &&\n        Array.isArray(verify.steps) &&\n        verify.steps.every((s: unknown) => isRecord(s) && oneOf(VERIFY_LINES, s.line) && (s.product === null || oneOf(PRODUCT_IDS, s.product)) && oneOf(VERIFY_STATES, s.state) && typeof s.reason === 'string') &&\n        typeof verify.done === 'boolean' &&\n        typeof verify.failed === 'boolean' &&\n        typeof verify.blocking === 'boolean' &&\n        typeof verify.stale === 'boolean' &&\n        Array.isArray(verify.warnings) &&\n        verify.warnings.every((w: unknown) => isRecord(w) && oneOf(PRODUCT_IDS, w.product) && typeof w.reason === 'string' && w.reason.length > 0)\n    )\n}\n\nconst SETUP_WARNING_ID = /^vw-[0-9]{1,20}$/\nfunction isSetupWarning(value: unknown): boolean {\n    return (\n        isRecord(value) &&\n        typeof value.id === 'string' &&\n        SETUP_WARNING_ID.test(value.id) &&\n        oneOf(PRODUCT_IDS, value.product) &&\n        typeof value.reason === 'string' &&\n        value.reason.length > 0 &&\n        typeof value.recordedSecs === 'number' &&\n        Number.isInteger(value.recordedSecs) &&\n        value.recordedSecs >= 0\n    )\n}\n\nfunction isImportView(value: unknown): boolean {\n    if (!isRecord(value)) return false\n    switch (value.state) {\n        case 'idle':\n        case 'choosing':\n            return true\n        case 'failed':\n            return oneOf(IMPORT_ERRORS, value.error)\n        case 'review':\n            return (\n                typeof value.review === 'string' &&\n                REVIEW_ID.test(value.review) &&\n                oneOf(IMPORT_FORMATS, value.format) &&\n                isString(value.fileName) &&\n                isRecord(value.discarded) &&\n                isCount(value.discarded.secretFields) &&\n                isCount(value.discarded.fileReferences) &&\n                isCount(value.discarded.otherFields) &&\n// This file was generated by [ts-rs](https://github.com/Aleph-Alpha/ts-rs). Do not edit this file manually.\nimport type { ContextRef } from \"./ContextRef\";\nimport type { PackView } from \"./PackView\";\nimport type { ProductId } from \"./ProductId\";\nimport type { SelectedWorkspace } from \"./SelectedWorkspace\";\nimport type { SetupMode } from \"./SetupMode\";\nimport type { TenantView } from \"./TenantView\";\nimport type { VerifyView } from \"./VerifyView\";\n\n/**\n * The tenant under setup (C29): a draft with its own context, not yet a\n * tenant. Absent when no wizard is open.\n */\nexport type SetupView = { mode: SetupMode, \n/**\n * The context credential and verify intents use for the draft.\n */\ncontext: ContextRef, \n/**\n * The draft's profile and credential states (no secret material).\n */\ntenant: TenantView, products: Array<ProductId>, \n/**\n * First run requires the scan key; the add sheet does not.\n */\nscanRequired: boolean, packs: Array<PackView>, \n/**\n * The Gateway workspace chosen for the draft, with the reference its\n * inference key is configured under.\n */\nworkspace: SelectedWorkspace | null, verify: VerifyView | null, \n/**\n * The current inputs were verified without a blocking failure:\n * completion is admitted (optional failures travel as warnings).\n */\ncompletable: boolean, };\n// This file was generated by [ts-rs](https://github.com/Aleph-Alpha/ts-rs). Do not edit this file manually.\nimport type { VerifyStep } from \"./VerifyStep\";\nimport type { VerifyWarning } from \"./VerifyWarning\";\n\n/**\n * The current verification run as the shell shows it.\n */\nexport type VerifyView = { \n/**\n * Counts runs; a later run replaces an earlier one's lines.\n */\ngeneration: number, steps: Array<VerifyStep>, \n/**\n * Every line has settled.\n */\ndone: boolean, \n/**\n * Some line failed.\n */\nfailed: boolean, \n/**\n * A required line failed (the scan key on first run): completion is\n * refused. An optional line's failure is carried as a warning instead.\n */\nblocking: boolean, \n/**\n * The inputs changed since this run started: it no longer counts.\n */\nstale: boolean, \n/**\n * What completion records as the tenant's setup warnings: warning\n * lines and failed optional lines.\n */\nwarnings: Array<VerifyWarning>, };\n{'subject': 'C29', 'host': 'Mac17,3; macOS 27.0.1 (26A434)', 'app': {'bundle': 'target/aarch64-apple-darwin/release/bundle/macos/Prisma AIRS Desktop v2 Fixture.app', 'identifier': 'io.cdot.prisma-airs-desktop.v2.fixture', 'executable_sha256': '8cd37bb5f0436b3d06d396ff62ffa8aa0c367b3ab18711eca407e1ad3354d13d', 'fixture': True}, 'limitations': [\"Pixels come from the fixture build's own WKWebView snapshot; menus and dialogs are verified through System Events and the accessibility tree.\", 'The verify reads run against the synthetic management endpoint (tools/native-acceptance/mgmt_server.py), whose Gateway lists two synthetic workspaces; the fail path replaces the management client with a secret that endpoint rejects, then corrects it.', 'The Academy step is exercised as skipped; the hosted device flow is the reviewed C04 component and its acceptance.', 'Spoken VoiceOver output was not recorded.']}\n[('C29-N01', 'pass'), ('C29-N02', 'pass'), ('C29-N03', 'pass'), ('C29-N04', 'pass'), ('C29-N05', 'pass'), ('C29-N06', 'pass')]\n","exit_code":0,"status":"completed"}}
