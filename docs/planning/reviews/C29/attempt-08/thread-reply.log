{"type":"item.completed","item":{"id":"item_62","type":"command_execution","command":"/bin/zsh -lc \"sed -n '1,125p' crates/xtask/src/fingerprint.rs; sed -n '1,180p' docs/planning/evidence/P09/check-remediation/attempt-03/targeted-fix-02.json; sed -n '1,215p' docs/planning/reviews/C29/attempt-08/diff.patch\"","aggregated_output":"//! Input fingerprints bound into review packets and receipts.\n//!\n//! * source: every tracked or untracked-but-not-ignored file (path, mode,\n//!   content or symlink target) plus the repository `.git/config`, minus a\n//!   narrow set of mutable evidence locations that are hashed separately.\n//! * dependencies: lockfiles, toolchain pin, the consumed immutable inputs\n//!   under `.inputs/`, and the resolved build-tool identities.\n//! * build_flags: the subject's manifest entries, Tauri configuration and\n//!   capability files, target and fixture-feature policy.\n//! * evidence: the subject's committed evidence directory.\n\nuse std::collections::BTreeMap;\nuse std::os::unix::fs::PermissionsExt;\nuse std::path::Path;\nuse std::process::Command;\n\nuse serde::{Deserialize, Serialize};\n\nuse crate::manifest::Manifest;\nuse crate::{Repo, Result, Subject, invalid, io_err, sha256_hex};\n\n/// Mutable locations excluded from the source fingerprint. Each is hashed\n/// independently (evidence fingerprint, receipts) so exclusion cannot hide\n/// application sources, lockfiles, tests or configuration.\npub const SOURCE_EXCLUSIONS: [&str; 3] = [\n    \"docs/planning/status.md\",\n    \"docs/planning/reviews/\",\n    \"docs/planning/evidence/\",\n];\n\n#[derive(Clone, Debug, PartialEq, Eq, Serialize, Deserialize)]\n#[serde(deny_unknown_fields)]\npub struct Fingerprints {\n    pub source: String,\n    pub dependencies: String,\n    pub build_flags: String,\n    pub evidence: String,\n}\n\n/// One entry of the source inventory.\n#[derive(Clone, Debug, PartialEq, Eq, Serialize, Deserialize)]\npub struct FileEntry {\n    pub path: String,\n    pub mode: String,\n    pub sha256: String,\n}\n\npub fn is_excluded(path: &str) -> bool {\n    SOURCE_EXCLUSIONS.iter().any(|excluded| {\n        if excluded.ends_with('/') {\n            path.starts_with(excluded)\n        } else {\n            path == *excluded\n        }\n    })\n}\n\n/// Lists source files via git: tracked plus untracked files not ignored.\npub fn source_inventory(repo: &Repo) -> Result<Vec<FileEntry>> {\n    let output = Command::new(\"/usr/bin/git\")\n        .args([\n            \"ls-files\",\n            \"-z\",\n            \"--cached\",\n            \"--others\",\n            \"--exclude-standard\",\n        ])\n        .current_dir(repo.root())\n        .env_clear()\n        .env(\"PATH\", \"/usr/bin:/bin\")\n        .env(\"HOME\", std::env::var(\"HOME\").unwrap_or_default())\n        .output()\n        .map_err(io_err(repo.root()))?;\n    if !output.status.success() {\n        return Err(invalid(\"git ls-files failed\"));\n    }\n    let mut paths: Vec<String> = output\n        .stdout\n        .split(|b| *b == 0)\n        .filter(|p| !p.is_empty())\n        .map(|p| String::from_utf8_lossy(p).into_owned())\n        .filter(|p| !is_excluded(p))\n        .collect();\n    paths.sort();\n    paths.dedup();\n    let mut entries = Vec::with_capacity(paths.len() + 1);\n    for path in paths {\n        entries.push(file_entry(repo.root(), &path)?);\n    }\n    entries.push(file_entry(repo.root(), \".git/config\")?);\n    Ok(entries)\n}\n\nfn file_entry(root: &Path, relative: &str) -> Result<FileEntry> {\n    let full = root.join(relative);\n    let Ok(meta) = std::fs::symlink_metadata(&full) else {\n        return Ok(FileEntry {\n            path: relative.to_owned(),\n            mode: \"deleted\".to_owned(),\n            sha256: String::new(),\n        });\n    };\n    if meta.file_type().is_symlink() {\n        let target = std::fs::read_link(&full).map_err(io_err(&full))?;\n        return Ok(FileEntry {\n            path: relative.to_owned(),\n            mode: \"symlink\".to_owned(),\n            sha256: sha256_hex(target.as_os_str().as_encoded_bytes()),\n        });\n    }\n    let bytes = std::fs::read(&full).map_err(io_err(&full))?;\n    let executable = meta.permissions().mode() & 0o111 != 0;\n    Ok(FileEntry {\n        path: relative.to_owned(),\n        mode: if executable { \"100755\" } else { \"100644\" }.to_owned(),\n        sha256: sha256_hex(&bytes),\n    })\n}\n\npub fn inventory_hash(entries: &[FileEntry]) -> String {\n    let text: String = entries\n        .iter()\n        .map(|e| format!(\"{}\\0{}\\0{}\\n\", e.path, e.mode, e.sha256))\n        .collect();\n    sha256_hex(text.as_bytes())\n{\n  \"command\": [\n    \"cargo\",\n    \"test\",\n    \"--locked\",\n    \"-p\",\n    \"desktop-core\",\n    \"--features\",\n    \"test-fixtures\",\n    \"--test\",\n    \"imports_rollback\"\n  ],\n  \"environment\": {\n    \"RUST_TEST_THREADS\": \"4\"\n  },\n  \"exit\": 0,\n  \"result\": \"23 passed; 0 failed; every original test/assertion retained\",\n  \"log_sha256\": \"c137e85d103bfc9d022178438ddbd430fa1a4ad2ea3deb00095e98ec1e29f654\",\n  \"sources\": {\n    \"crates/desktop-core/src/authority.rs\": \"b9ffc8ff16456fb7716ee54400c25f6371ac230e0ba74b2058e8ab6ef8dd710b\",\n    \"crates/desktop-core/tests/imports_rollback/main.rs\": \"5036ed3500288f6847541ebfc63b3aa3be12e1acefd87907cd81b87490e48390\",\n    \"crates/desktop-core/tests/imports_rollback/held.rs\": \"6099cc6697fa221d03cfb8cbeb083c0d43c6d359bf218196e8a5d60d34c9043d\",\n    \"crates/desktop-core/tests/imports_rollback/recovery.rs\": \"14158c282432be2f5a75d37853709336f182386606c53c3f881c6256a197fcc3\"\n  },\n  \"scope\": \"Production exit hook in test relaunch; confirmed durable receipt observation; read-only test-fixtures getter and bounded exact-cut waits replace guessed elapsed time. Rebuild and repeat native qualification before new checks/reviews.\"\n}\ndiff --git a/crates/desktop-core/src/authority.rs b/crates/desktop-core/src/authority.rs\nindex f0f09005..3479e458 100644\n--- a/crates/desktop-core/src/authority.rs\n+++ b/crates/desktop-core/src/authority.rs\n@@ -6167,6 +6167,17 @@ fn wall_secs(clock_offset: u32) -> u32 {\n         .saturating_add(clock_offset)\n }\n \n+#[cfg(feature = \"test-fixtures\")]\n+impl Core {\n+    /// Whether an armed fixture interruption is still waiting for its exact\n+    /// commit point. Read-only; tests must not simulate exit before it fires.\n+    pub fn v1_import_interruption_pending(&self) -> bool {\n+        lock(&self.inner)\n+            .map(|state| state.v1_import.interrupt_at.is_some())\n+            .unwrap_or(true)\n+    }\n+}\n+\n #[cfg(test)]\n mod tests {\n     use super::*;\ndiff --git a/crates/desktop-core/tests/imports_rollback/held.rs b/crates/desktop-core/tests/imports_rollback/held.rs\nindex 8f34123c..80fdcec5 100644\n--- a/crates/desktop-core/tests/imports_rollback/held.rs\n+++ b/crates/desktop-core/tests/imports_rollback/held.rs\n@@ -57,6 +57,7 @@ async fn confirm(desk: &mut Desk) {\n     desk.send(json!({\"kind\": \"confirmV1Import\", \"review\": plan[\"review\"], \"items\": items}))\n         .await\n         .expect(\"confirm\");\n+    desk.interrupted().await;\n }\n \n /// The one receipt's ID, from its folder.\n@@ -133,17 +134,16 @@ async fn a_rollback_that_cannot_finish_keeps_what_the_import_writes_waiting() {\n     desk.core.interrupt_v1_import(CommitPoint::Writing);\n     confirm(&mut desk).await;\n     until(&desk, |d| {\n-        std::fs::read_dir(&d.adapters.import_root)\n-            .into_iter()\n-            .flatten()\n-            .flatten()\n-            .filter_map(|e| std::fs::read_to_string(e.path()).ok())\n-            .filter_map(|t| serde_json::from_str::<Value>(&t).ok())\n-            .any(|r| {\n-                r[\"items\"]\n-                    .as_array()\n-                    .is_some_and(|i| i.iter().any(|x| x[\"state\"] == \"writing\"))\n+        // Temporary receipt files can expose Writing before either copy\n+        // and the document binding have been confirmed. Wait for the\n+        // last durable document, as a real interruption would require.\n+        d.adapters.store.durable().is_some_and(|state| {\n+            state.open_imports.iter().any(|r| {\n+                r.items.iter().any(|item| {\n+                    item.state == receipt::ItemState::Writing && !item.intended.is_empty()\n+                })\n             })\n+        })\n     })\n     .await;\n     desk.adapters.vault.fail_with(Some(VaultError::Locked));\ndiff --git a/crates/desktop-core/tests/imports_rollback/main.rs b/crates/desktop-core/tests/imports_rollback/main.rs\nindex 981bb63a..4e4a8cc4 100644\n--- a/crates/desktop-core/tests/imports_rollback/main.rs\n+++ b/crates/desktop-core/tests/imports_rollback/main.rs\n@@ -102,6 +102,10 @@ fn launch(\n     // Rollbacks are confirmed unless a test says otherwise.\n     handles.confirmer.auto(Some(true));\n     if let Some(old) = previous {\n+        // Match the host's exit boundary: release the learner's offline\n+        // generation before the next core opens the same store. Dropping\n+        // the facade alone can leave a job's instance lock alive.\n+        old.core.shutdown();\n         drop(old.core);\n         let o = old.adapters;\n         adapters.keychain = o.vault.clone();\n@@ -169,6 +173,22 @@ impl Desk {\n         self.json()[\"v1Import\"].clone()\n     }\n \n+    /// Wait for the armed cut itself, rather than guessing from elapsed\n+    /// time while receipt copies and owner writes are still being synced.\n+    async fn interrupted(&self) {\n+        for _ in 0..400 {\n+            if !self.core.v1_import_interruption_pending() {\n+                tokio::task::yield_now().await;\n+                return;\n+            }\n+            tokio::time::sleep(Duration::from_millis(25)).await;\n+        }\n+        panic!(\n+            \"the armed import interruption was not reached: {}\",\n+            self.import()\n+        );\n+    }\n+\n     /// Waits until no import step is under way.\n     async fn settled(&self) -> Value {\n         for _ in 0..400 {\n@@ -708,7 +728,7 @@ async fn an_interrupted_rollback_finishes_after_relaunch() {\n         desk.send(json!({\"kind\": \"rollBackV1Import\", \"receipt\": id}))\n             .await\n             .expect(\"roll back\");\n-        tokio::time::sleep(Duration::from_millis(500)).await;\n+        desk.interrupted().await;\n         // Hidden while it was being removed.\n         assert!(desk.tenants().is_empty(), \"{point:?}\");\n         // The next launch finishes it before anything else writes.\ndiff --git a/crates/desktop-core/tests/imports_rollback/recovery.rs b/crates/desktop-core/tests/imports_rollback/recovery.rs\nindex d1d4e582..e5158552 100644\n--- a/crates/desktop-core/tests/imports_rollback/recovery.rs\n+++ b/crates/desktop-core/tests/imports_rollback/recovery.rs\n@@ -182,7 +182,7 @@ async fn an_import_interrupted_anywhere_shows_nothing_and_is_undone_at_the_next_\n         desk.plan(EVERYTHING, new_targets(&view)).await;\n         desk.core.interrupt_v1_import_at(point, skip);\n         confirm_ready(&mut desk).await;\n-        tokio::time::sleep(Duration::from_millis(400)).await;\n+        desk.interrupted().await;\n         // Nothing of an import that has not committed is shown.\n         nothing_shown(&desk, &why);\n         // What it writes waits meanwhile.\n@@ -276,7 +276,7 @@ async fn an_identical_case_added_after_an_interruption_is_never_claimed() {\n     // Stops after the receipt names both cases, before the library write.\n     desk.core.interrupt_v1_import(CommitPoint::Writing);\n     confirm_ready(&mut desk).await;\n-    tokio::time::sleep(Duration::from_millis(400)).await;\n+    desk.interrupted().await;\n     assert!(desk.cases(&ours).is_empty(), \"not written\");\n     let mut desk = start(Some(desk));\n     desk.settled().await;\n@@ -348,7 +348,7 @@ async fn an_open_library_shows_the_previous_generation_until_the_import_commits(\n     // The cases item is applied; the reports item never starts.\n     desk.core.interrupt_v1_import(CommitPoint::Applied);\n     confirm_ready(&mut desk).await;\n-    tokio::time::sleep(Duration::from_millis(400)).await;\n+    desk.interrupted().await;\n     assert_eq!(desk.cases(&ours).len(), 3, \"written to the library\");\n     assert_eq!(\n         names(&desk),\ndiff --git a/tools/native-acceptance/acceptance_c43.py b/tools/native-acceptance/acceptance_c43.py\nindex b54616ae..cf6a9f3b 100644\n--- a/tools/native-acceptance/acceptance_c43.py\n+++ b/tools/native-acceptance/acceptance_c43.py\n@@ -30,6 +30,7 @@ import acceptance_c08 as c8  # noqa: E402\n import acceptance_c28 as c28  # noqa: E402\n import acceptance_c29 as c29  # noqa: E402\n import acceptance_c31 as c31  # noqa: E402\n+import wizard_coverage as coverage  # noqa: E402\n \n ROOT = os.getcwd()\n EVIDENCE = os.path.join(ROOT, \"docs/planning/evidence/C43\")\n@@ -130,10 +131,14 @@ def overflow(app):\n     return {\"overflow_px\": max(0, right - (win[\"pos\"][0] + win[\"size\"][0])) if right is not None else None, \"horizontal_scrollbars\": len(hbars)}, tree\n \n \n-def primary_usable(tree, zoom):\n+def primary_usable(tree, zoom, step):\n     \"\"\"The footer's primary inside the window and at least 32 CSS px.\"\"\"\n     win = next((n for n in tree if n.get(\"role\") == \"AXWindow\"), None)\n     labels_ = (\"Create the tenant to continue\", \"Save the scan key to continue\", \"Continue\", \"Continue with warnings\", \"Set up a tenant\", \"Open Prisma AIRS\", \"Finish\")\n+    # Academy's signed-out advancing action is Skip for now. Packs also has\n+    # a secondary Skip action; it must still be measured/traversed to Continue.\n+    if step == \"academy\":\n+        labels_ = (\"Continue\", \"Skip for now\")\n     btn = next((n for n in tree if n.get(\"role\") == \"AXButton\" and (n.get(\"label\") or \"\") in labels_ and n.get(\"pos\") and n.get(\"size\")), None)\n     inside = bool(btn and win and btn[\"pos\"][0] >= win[\"pos\"][0] and btn[\"pos\"][0] + btn[\"size\"][0] <= win[\"pos\"][0] + win[\"size\"][0] + 1 and btn[\"pos\"][1] + btn[\"size\"][1] <= win[\"pos\"][1] + win[\"size\"][1] + 1)\n     return {\"label\": btn.get(\"label\") if btn else None, \"size\": btn.get(\"size\") if btn else None, \"inside\": inside,\n@@ -191,6 +196,15 @@ def composites_for(app, step, prepared, mode=\"firstRun\"):\n def main():\n     try:\n         return run()\n+    except Exception:\n+        if os.path.isdir(NATIVE):\n+            try:\n+                c29.save_tree(\"failure\", c29._last_app_tree())\n+                with open(os.path.join(NATIVE, \"failure-log.json\"), \"w\") as f:\n+                    json.dump(LOG, f, indent=2)\n+            except Exception as error:\n+                print(\"failure evidence unavailable:\", error)\n+        raise\n     finally:\n         fx.sh([\"pkill\", \"-f\", fx.PROCESS])\n         fx.clean_fixture_root()\n@@ -239,15 +253,84 @@ def open_add_sheet(app):\n     press(app, \"AXButton\", \"Add a tenant\")\n \n \n+def layout_matrix(app, step, mode):\n+    \"\"\"Measure each actual step, including keyboard reach, in all four T09 states.\"\"\"\n+    out = {}\n+    for w, h, zoom in [(1440, 900, 1), (900, 600, 2)]:\n+        size_window(app, app.pid, w, h)\n+        if zoom == 2:\n+            c29.zoom(app, 10)\n+        for theme in (\"Light\", \"Dark\"):\n+            c29.appearance(app, theme)\n+            tree = app.tree()\n+            owner = c29.dialog(tree) if mode == \"add\" else next(n for n in tree if n.get(\"role\") == \"AXWindow\")\n+            headings = [n for n in within(tree, owner) if n.get(\"role\") == \"AXHeading\" and n.get(\"label\")]\n+            if not headings:\n+                raise RuntimeError(f\"no heading to start keyboard traversal: {mode}/{step}\")\n+            app.ax(\"focus\", \"AXHeading\", headings[0][\"label\"])\n+            primary = primary_usable(tree, zoom, step)[\"label\"]\n+            walk, contained, reached = [], True, False\n+            for _ in range(60):\n+                app.keycode(48)\n+                current = app.tree()\n+                focused = fx.App.focused(current) or {}\n+                scope = c29.dialog(current) if mode == \"add\" else next((n for n in current if n.get(\"role\") == \"AXWindow\"), None)\n+                # Compare membership as well as geometry: scrolling may move an\n+                # earlier control, but focus must never escape the owning modal.\n+                in_scope = bool(scope and focused in within(current, scope))\n+                contained = contained and in_scope\n+                walk.append({\"role\": focused.get(\"role\"), \"label\": focused.get(\"label\"), \"in_scope\": in_scope})\n+                if focused.get(\"role\") == \"AXButton\" and focused.get(\"label\") == primary:\n","exit_code":0,"status":"completed"}}
