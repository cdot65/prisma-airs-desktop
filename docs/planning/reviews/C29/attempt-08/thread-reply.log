{"type":"item.completed","item":{"id":"item_57","type":"command_execution","command":"/bin/zsh -lc \"sed -n '660,703p' crates/desktop-core/src/management.rs; sed -n '195,310p' apps/desktop/src-tauri/src/lib.rs; cat apps/desktop/src/features/academy/academy-account.tsx; cat apps/desktop/academy-source.ts\"","aggregated_output":"            dlp,\n            red_team,\n            model_security,\n            agentguard,\n            gateway,\n        })\n    }\n\n    /// The Gateway client over this binding's management credential (C16).\n    pub(crate) fn gateway(&self) -> &AIGatewayClient {\n        &self.gateway\n    }\n\n    pub(crate) fn options(deadline: Instant) -> Option<RequestOptions> {\n        let remaining = deadline.saturating_duration_since(Instant::now());\n        RequestOptions::with_timeout(remaining.max(Duration::from_millis(1)))\n            .and_then(|o| o.with_retries(0))\n            .ok()\n    }\n\n    /// The credential check (v1 `checktenant`): one profile, latest only.\n    pub async fn verify(&self, deadline: Instant) -> Result<(), scm_sdk::Error> {\n        let mut page = PaginationOptions::default();\n        page.limit = 1;\n        page.latest = Some(true);\n        self.management\n            .profiles()\n            .list(page, Self::options(deadline).as_ref())\n            .await\n            .map(|_| ())\n    }\n\n    /// One page of `resource`, normalized.\n    pub async fn page(\n        &self,\n        resource: ManagementResource,\n        offset: u32,\n        limit: u32,\n        deadline: Instant,\n    ) -> Result<ManagementPage, PageError> {\n        let options = Self::options(deadline);\n        let options = options.as_ref();\n        let offset_page = || {\n            let mut page = PaginationOptions::default();\n    pub fn zoom<R: Runtime>(&self, webview: &WebviewWindow<R>, step: Option<f64>) {\n        let Ok(mut zoom) = self.zoom.lock() else {\n            return;\n        };\n        *zoom = match step {\n            Some(delta) => (*zoom + delta).clamp(0.5, 3.0),\n            None => 1.0,\n        };\n        let _ = webview.set_zoom(*zoom);\n    }\n}\n\n/// Registers the two application commands on a Tauri builder.\npub fn commands<R: Runtime>(builder: tauri::Builder<R>) -> tauri::Builder<R> {\n    builder.invoke_handler(tauri::generate_handler![desktop_dispatch, desktop_observe])\n}\n\n/// Installs host state for an existing core plus the commands (tests use\n/// this with fixture adapters; the app builds its core in `setup`).\npub fn install<R: Runtime>(builder: tauri::Builder<R>, core: &Core) -> tauri::Builder<R> {\n    commands(builder.manage(Host::new(core)))\n}\n\n/// A core over deterministic fixture adapters, for host tests.\n#[cfg(feature = \"test-fixtures\")]\npub fn fixture_core() -> (Core, desktop_core::fixtures::Handles) {\n    fixture_core_with(CoreConfig::default())\n}\n\n/// A fixture core with a given configuration (for example the synthetic\n/// Academy origin).\n#[cfg(feature = \"test-fixtures\")]\npub fn fixture_core_with(config: CoreConfig) -> (Core, desktop_core::fixtures::Handles) {\n    let (adapters, handles) = desktop_core::fixtures::adapters();\n    (Core::new(config, adapters), handles)\n}\n\n/// Builds the packaged main window with its navigation policy: it may only\n/// display packaged assets; remote navigation, new windows and downloads are\n/// refused, so remote content can never acquire command authority.\npub fn main_window<R: Runtime, M: Manager<R>>(manager: &M) -> tauri::Result<WebviewWindow<R>> {\n    let builder =\n        WebviewWindowBuilder::new(manager, MAIN_WINDOW, WebviewUrl::App(\"index.html\".into()))\n            .title(product_title())\n            .inner_size(1280.0, 820.0)\n            .min_inner_size(900.0, 600.0)\n            .on_navigation(is_packaged_origin)\n            .on_new_window(|_, _| NewWindowResponse::Deny)\n            .on_download(|_, _| false)\n            .on_page_load(|webview, payload| {\n                // A (re)loading page owns none of the previous page's\n                // observations; retire them so nothing leaks across reloads.\n                if payload.event() == PageLoadEvent::Started {\n                    webview.state::<Host>().retire_webview(webview.label());\n                }\n            });\n    builder.build()\n}\n\nfn product_title() -> &'static str {\n    if cfg!(feature = \"test-fixtures\") {\n        \"Prisma AIRS Desktop v2 (Fixture)\"\n    } else {\n        \"Prisma AIRS Desktop v2\"\n    }\n}\n\n/// True for the packaged asset origin served by Tauri's custom protocol.\npub fn is_packaged_origin(url: &Url) -> bool {\n    url.scheme() == \"tauri\" && url.host_str() == Some(\"localhost\") && url.port().is_none()\n}\n\n/// Defense in depth beyond the capability grant: the caller must be the main\n/// webview of the main window currently showing packaged content.\nfn admit_caller<R: Runtime>(webview: &Webview<R>) -> Result<(), Refusal> {\n    if webview.label() != MAIN_WINDOW || webview.window().label() != MAIN_WINDOW {\n        return Err(Refusal::CapabilityMissing);\n    }\n    match webview.url() {\n        Ok(url) if is_packaged_origin(&url) => Ok(()),\n        _ => Err(Refusal::CapabilityMissing),\n    }\n}\n\n#[tauri::command]\nasync fn desktop_dispatch<R: Runtime>(\n    webview: Webview<R>,\n    request: Request<'_>,\n    host: State<'_, Host>,\n) -> Result<DispatchResponse, Refusal> {\n    admit_caller(&webview)?;\n    // The facade sends raw bytes so the size ceiling applies before parsing.\n    let InvokeBody::Raw(bytes) = request.body() else {\n        return Err(Refusal::InvalidInput);\n    };\n    let request = DispatchRequest::parse(bytes).map_err(|e| e.refusal())?;\n    let delivery = request.delivery().map_err(|e| e.refusal())?;\n    Ok(host\n        .operator\n        .dispatch(delivery, request.intent)\n        .await\n        .into())\n}\n\n#[tauri::command]\nasync fn desktop_observe<R: Runtime>(\n    webview: Webview<R>,\n    request: Request<'_>,\n    host: State<'_, Host>,\n) -> Result<ObserveResponse, Refusal> {\n    admit_caller(&webview)?;\n    let InvokeBody::Raw(bytes) = request.body() else {\n        return Err(Refusal::InvalidInput);\n    };\n    let request = ObserveRequest::parse(bytes).map_err(|e| e.refusal())?;\n    match request.scope {\nimport { useId, useState } from 'react'\nimport { Button, Callout } from '@ai-security-academy/presentation'\nimport { AlertTriangle, CheckCircle2, Info } from 'lucide-react'\nimport type { AcademyFailure, AcademyView, Intent, VaultError } from '@prisma-airs/desktop-contracts'\nimport { type Dispatch, outcomeMessage } from '../tenants/dispatch'\n\nconst FAILURE_TEXT: Record<AcademyFailure, string> = {\n    notConfigured: 'Academy desktop sign-in is not available on this server.',\n    invalidConfig: 'Academy returned a sign-in configuration the desktop cannot trust.',\n    network: 'Academy could not be reached. Check your connection and try again.',\n    invalidResponse: 'Academy returned an unexpected sign-in response. Try again.',\n    denied: 'Sign-in was declined in the browser.',\n    expired: 'The sign-in code expired before it was approved. Start again.',\n    sessionExpired: 'Your Academy session expired. Sign in again.',\n    scopeMissing: 'Academy did not grant learning access to this sign-in.',\n    accountChanged: 'Academy changed its sign-in configuration. Sign in again.',\n    authFailed: 'Academy sign-in could not complete. Try again.',\n}\n\nconst VAULT_TEXT: Record<VaultError, string> = {\n    locked: 'The Keychain is locked, so the session could not be saved. Unlock it and sign in again.',\n    denied: 'macOS did not allow the Academy session to be saved in the Keychain.',\n    unavailable: 'The Keychain is not available, so the session could not be saved.',\n    notFound: 'The saved Academy session is missing from the Keychain.',\n    corrupt: 'The saved Academy session could not be read.',\n}\n\ninterface Props {\n    view: AcademyView\n    dispatch: Dispatch\n}\n\n/**\n * The Academy learner account, independent of AIRS tenants. Sign-in is a\n * browser device flow: the desktop shows a code, opens the Academy page the\n * issuer named, and never sees a password. Tokens stay in the native core.\n */\nexport function AcademyAccount({ view, dispatch }: Props) {\n    const legend = useId()\n    const [busy, setBusy] = useState(false)\n    const [message, setMessage] = useState<string | null>(null)\n\n    async function send(intent: Intent) {\n        setBusy(true)\n        setMessage(null)\n        const outcome = await dispatch(intent)\n        setBusy(false)\n        setMessage(outcomeMessage(outcome))\n    }\n\n    return (\n        <fieldset\n            aria-labelledby={legend}\n            aria-busy={busy}\n            data-slot='academy-account'\n            className='border-academy-rule flex flex-col gap-3 rounded-[12px] border p-5'\n        >\n            <legend id={legend} className='text-academy-ink px-1 text-[15px] font-semibold'>\n                Academy account\n            </legend>\n            <p className='text-academy-ink-soft text-[13px]'>\n                Your Academy learner account is separate from AIRS tenants; switching tenants does not change it.\n            </p>\n            <div role='status' aria-live='polite' className='flex flex-col gap-3'>\n                <State view={view} busy={busy} send={send} />\n            </div>\n            {message ? (\n                <p role='alert' data-slot='academy-message' className='text-academy-accent-warn text-[13px]'>\n                    {message}\n                </p>\n            ) : null}\n        </fieldset>\n    )\n}\n\nfunction State({ view, busy, send }: { view: AcademyView; busy: boolean; send: (intent: Intent) => Promise<void> }) {\n    switch (view.state) {\n        case 'signedOut':\n            return (\n                <div className='flex flex-col items-start gap-3'>\n                    <p className='text-academy-ink text-[13px]'>Not signed in to Academy.</p>\n                    <Button type='button' tier='primary' disabled={busy} onClick={() => void send({ kind: 'startAcademySignIn' })}>\n                        Sign in to Academy\n                    </Button>\n                </div>\n            )\n        case 'starting':\n        case 'completing':\n            return (\n                <div className='flex flex-col items-start gap-3'>\n                    <p className='text-academy-ink text-[13px]'>\n                        {view.state === 'starting' ? 'Contacting Academy…' : 'Approved. Finishing sign-in…'}\n                    </p>\n                    <Button type='button' tier='secondary' onClick={() => void send({ kind: 'cancelAcademySignIn' })}>\n                        Cancel sign-in\n                    </Button>\n                </div>\n            )\n        case 'awaitingApproval':\n            return (\n                <div className='flex flex-col items-start gap-3' data-slot='academy-code'>\n                    <p className='text-academy-ink text-[13px]'>Enter this code on the Academy sign-in page:</p>\n                    <p\n                        className='font-mono text-academy-ink text-[24px] font-semibold tracking-[0.12em] select-all'\n                        aria-label={`Sign-in code ${view.userCode.split('').join(' ')}`}\n                    >\n                        {view.userCode}\n                    </p>\n                    <p className='text-academy-ink-faint text-[12px] break-all'>\n                        {view.verificationUri} · expires in {Math.max(1, Math.ceil(view.expiresIn / 60))} min\n                    </p>\n                    <div className='flex flex-wrap gap-2'>\n                        <Button type='button' tier='primary' onClick={() => void send({ kind: 'openAcademyVerification' })}>\n                            Open sign-in page\n                        </Button>\n                        <Button type='button' tier='secondary' onClick={() => void send({ kind: 'cancelAcademySignIn' })}>\n                            Cancel sign-in\n                        </Button>\n                    </div>\n                </div>\n            )\n        case 'signedIn':\n            return (\n                <div className='flex flex-col items-start gap-3'>\n                    <Callout tone='success' icon={CheckCircle2}>\n                        <p>\n                            Signed in to Academy as <span className='font-semibold'>{view.displayName}</span>.\n                        </p>\n                    </Callout>\n                    <Button type='button' tier='secondary' disabled={busy} onClick={() => void send({ kind: 'signOutAcademy' })}>\n                        Sign out of Academy\n                    </Button>\n                </div>\n            )\n        case 'failed':\n            return (\n                <div className='flex flex-col items-start gap-3'>\n                    <Callout tone='warning' icon={view.failure === 'network' ? Info : AlertTriangle} data-slot='academy-failure'>\n                        {view.displayName ? <p className='font-semibold'>{view.displayName}</p> : null}\n                        <p>{view.vault ? VAULT_TEXT[view.vault] : FAILURE_TEXT[view.failure]}</p>\n                    </Callout>\n                    <div className='flex flex-wrap gap-2'>\n                        <Button type='button' tier='primary' disabled={busy} onClick={() => void send({ kind: 'startAcademySignIn' })}>\n                            Sign in again\n                        </Button>\n                        <Button type='button' tier='secondary' disabled={busy} onClick={() => void send({ kind: 'signOutAcademy' })}>\n                            Sign out of Academy\n                        </Button>\n                    </div>\n                </div>\n            )\n    }\n}\n/**\n * Academy learner source compiled into the desktop (C05). The learner\n * package (@ai-security-academy/learner) exports Academy's own pages; their\n * `@/` imports are Academy's source in the prepared, hash-verified input\n * (.work/academy, xtask shared-prepare). Every bare import that source makes\n * resolves to this app's pinned copy (`dedupe`), so one React, one React\n * Query and one router instance exist and versions follow the desktop lock.\n */\n// A file-system path without Node typings in the app's tsconfig (the\n// repository path has no characters that URL-encode other than these).\nexport const ACADEMY_SRC = decodeURIComponent(new URL('../../.work/academy/src', import.meta.url).pathname)\nconst CONTRACTS_ROOT = decodeURIComponent(new URL('../../packages/desktop-contracts/', import.meta.url).pathname)\n\n// node_modules may be shared with another worktree. Compile this checkout's IPC parser and bindings,\n// not the workspace package reached through that other checkout's dependency symlink.\nexport const desktopAliases = [\n    { find: /^@prisma-airs\\/desktop-contracts$/, replacement: `${CONTRACTS_ROOT}src/index.ts` },\n    { find: /^@prisma-airs\\/desktop-contracts\\/fixtures\\//, replacement: `${CONTRACTS_ROOT}fixtures/` },\n    { find: /^@\\//, replacement: `${ACADEMY_SRC}/` },\n]\n\nexport const academyDedupe = [\n    'react',\n    'react-dom',\n    '@ai-security-academy/presentation',\n    '@ai-security-academy/shared',\n    '@codemirror/commands',\n    '@codemirror/lang-python',\n    '@codemirror/lang-yaml',\n    '@codemirror/language',\n    '@codemirror/state',\n    '@codemirror/view',\n    '@dnd-kit/core',\n    '@excalidraw/excalidraw',\n    '@lezer/highlight',\n    '@radix-ui/react-dialog',\n    '@radix-ui/react-slot',\n    '@tanstack/react-query',\n    '@tanstack/react-router',\n    '@trpc/client',\n    '@trpc/react-query',\n    '@trpc/server',\n    'class-variance-authority',\n    'clsx',\n    'dompurify',\n    'lucide-react',\n    'mermaid',\n    'qrcode.react',\n    'sanitize-html',\n    'tailwind-merge',\n    'zustand',\n]\n","exit_code":0,"status":"completed"}}
