import { useCallback, useEffect, useLayoutEffect, useRef, useState } from 'react'
import {
    DeliveryOutcomeUnknown,
    type DesktopClient,
    type FeatureId,
    type Intent,
    type MenuCommand,
    type ShellSnapshot,
    type Theme,
} from '@prisma-airs/desktop-contracts'
import { followAppearance } from './shell/appearance'
import type { DispatchOutcome } from './features/tenants/dispatch'
import { DesktopShell } from './shell/desktop-shell'
import { V2Shell } from './v2/v2-shell'
import { Wizard } from './v2/wizard/wizard'
import { useShellStore } from './v2/store'
import { SHELL_COPY } from './v2/copy'
import { forgetAcademyPresentation } from './features/academy/presentation-storage'
import { SAVE_DOCUMENT_EVENT } from './features/workbench/document-editor'

export function App({ client }: { client: DesktopClient }) {
    const [snapshot, setSnapshot] = useState<ShellSnapshot | null>(null)
    const [failure, setFailure] = useState<string | null>(null)
    const [active, setActive] = useState<FeatureId | null>(null)
    const [paletteOpen, setPaletteOpen] = useState(false)
    const [pending, setPending] = useState(false)
    const [status, setStatus] = useState('')

    const setAppearance = useCallback(
        async (theme: Theme) => {
            setPending(true)
            setStatus('')
            try {
                const response = await client.dispatch({ kind: 'setAppearance', theme })
                if (response.outcome === 'refusal') {
                    setStatus(`The desktop refused the appearance change (${response.refusal}).`)
                }
            } catch (error) {
                setStatus(
                    error instanceof DeliveryOutcomeUnknown
                        ? 'The desktop did not confirm the appearance change. The current setting is shown.'
                        : 'The appearance change could not be delivered.'
                )
            } finally {
                setPending(false)
            }
        },
        [client]
    )

    const dispatch = useCallback(
        async (intent: Intent): Promise<DispatchOutcome> => {
            try {
                const response = await client.dispatch(intent)
                return response.outcome === 'refusal'
                    ? { kind: 'refused', refusal: response.refusal }
                    : { kind: 'admitted', operation: response.receipt.operation }
            } catch (error) {
                return error instanceof DeliveryOutcomeUnknown ? { kind: 'unknown' } : { kind: 'failed' }
            }
        },
        [client]
    )

    // v2 (C28): navigation is Rust-owned. The native menu, the sidebar and
    // the palette all dispatch `navigate`; refusals reach the status surface.
    const v2 = snapshot?.uiVariant === 'v2'
    const v2Navigate = useCallback(
        async (feature: FeatureId) => {
            useShellStore.getState().closePalette()
            const intent: Intent = { kind: 'navigate', feature }
            const outcome = await dispatch(intent)
            if (outcome.kind === 'refused') useShellStore.getState().toast(SHELL_COPY.toastRefused('Navigation', outcome.refusal), 'warn')
            // Unknown delivery is kept inline with Retry; never an expiring toast alone.
            else if (outcome.kind === 'unknown') useShellStore.getState().addUnconfirmed('Navigation', intent)
            else if (outcome.kind === 'failed') useShellStore.getState().toast(SHELL_COPY.toastFailed('Navigation'), 'warn')
        },
        [dispatch]
    )
    const v2Preference = useCallback(
        async (what: string, intent: Intent) => {
            const outcome = await dispatch(intent)
            if (outcome.kind === 'refused') useShellStore.getState().toast(SHELL_COPY.toastRefused(what, outcome.refusal), 'warn')
            else if (outcome.kind === 'unknown') useShellStore.getState().addUnconfirmed(what, intent)
            else if (outcome.kind === 'failed') useShellStore.getState().toast(SHELL_COPY.toastFailed(what), 'warn')
        },
        [dispatch]
    )

    const onMenu = useRef<(command: MenuCommand) => void>(() => undefined)
    onMenu.current = (command: MenuCommand) => {
        if (command.kind === 'navigate') {
            // Native navigation dismisses the modal palette first so focus can
            // move to the new page heading instead of behind an open dialog.
            if (v2) void v2Navigate(command.feature)
            else {
                setPaletteOpen(false)
                setActive(command.feature)
            }
        }
        else if (command.kind === 'commandPalette') {
            if (v2) useShellStore.getState().openPalette()
            else setPaletteOpen(true)
        }
        // ⌘T: the tenant switcher opens; nothing switches until chosen.
        else if (command.kind === 'tenantSwitcher') {
            if (v2) useShellStore.getState().setSwitcher(true)
            else {
                setPaletteOpen(false)
                setActive('settings')
            }
        }
        // The open API Client request saves (its editor listens).
        else if (command.kind === 'saveDocument') window.dispatchEvent(new Event(SAVE_DOCUMENT_EVENT))
        else if (v2) void v2Preference('The appearance change', { kind: 'setAppearance', theme: command.theme })
        else void setAppearance(command.theme)
    }

    useEffect(() => {
        let stop: (() => void) | undefined
        let cancelled = false
        client
            .observeShell({
                onSnapshot: (next) => setSnapshot(next),
                onMenu: (command) => onMenu.current(command),
                onError: () => setFailure('The desktop sent an unexpected update.'),
            })
            .then(
                (unsubscribe) => {
                    if (cancelled) unsubscribe()
                    else stop = unsubscribe
                },
                () => setFailure('The desktop shell could not be observed.')
            )
        return () => {
            cancelled = true
            stop?.()
        }
    }, [client])

    // A completed reset also forgets Academy's WebView presentation state
    // (completion latches keyed by account); a stopped reset keeps it.
    const storage = snapshot?.storage
    const resetFailed = Boolean(snapshot?.resetFailure)
    const previousStorage = useRef(storage)
    useEffect(() => {
        if (previousStorage.current === 'resetting' && storage !== 'resetting' && !resetFailed) {
            forgetAcademyPresentation()
        }
        previousStorage.current = storage
    }, [storage, resetFailed])

    const appearance = snapshot?.appearance
    // Apply the theme in the same commit as the snapshot, before paint, so
    // the shell never shows a frame in the previous theme.
    useLayoutEffect(() => (appearance ? followAppearance(appearance) : undefined), [appearance])

    if (failure && !snapshot) {
        return (
            <main role='alert' className='text-academy-ink p-8'>
                {failure}
            </main>
        )
    }
    if (!snapshot) {
        return (
            <main role='status' aria-live='polite' className='text-academy-ink-soft p-8'>
                Starting Prisma AIRS Desktop…
            </main>
        )
    }
    if (snapshot.uiVariant === 'v2' && snapshot.onboarding !== 'done') {
        return (
            <div data-v2-shell=''>
                <Wizard
                    snapshot={snapshot}
                    dispatch={dispatch}
                    observeManagement={(operation) => client.observeManagement(operation)}
                    mode='firstRun'
                    onClose={() => undefined}
                    onNavigate={(feature) => void v2Navigate(feature)}
                />
            </div>
        )
    }
    if (snapshot.uiVariant === 'v2') {
        return (
            <V2Shell
                snapshot={snapshot}
                appearancePending={pending}
                status={failure ?? status}
                onNavigate={(feature) => void v2Navigate(feature)}
                onSetAppearance={(theme) => void v2Preference('The appearance change', { kind: 'setAppearance', theme })}
                onSetShowCalls={(on) => void v2Preference('The preference change', { kind: 'setShowCalls', on })}
                onReturnToClassic={() => void v2Preference('The interface change', { kind: 'setUiVariant', variant: 'legacy' })}
                onSwitchTenant={(tenant) => {
                    // The target is captured now: a late refusal still names it.
                    const label = snapshot.tenants.find((t) => t.id === tenant)?.label ?? tenant
                    void v2Preference(SHELL_COPY.switchTo(label), { kind: 'selectTenant', tenant })
                }}
                onReadNow={() => {
                    const active = snapshot.active
                    if (!active) return
                    const label = snapshot.tenants.find((t) => t.id === active.tenant)?.label ?? active.tenant
                    void v2Preference(SHELL_COPY.readOf(label), { kind: 'management', context: active.context, request: { kind: 'overview' } })
                }}
                onRetry={(what, intent) => void v2Preference(what, intent)}
                dispatch={dispatch}
                client={client}
            />
        )
    }
    return (
        <DesktopShell
            snapshot={snapshot}
            active={active ?? snapshot.features[0]?.id ?? 'settings'}
            paletteOpen={paletteOpen}
            appearancePending={pending}
            status={failure ?? status}
            onNavigate={setActive}
            onOpenPalette={() => setPaletteOpen(true)}
            onClosePalette={() => setPaletteOpen(false)}
            onSetAppearance={(theme) => void setAppearance(theme)}
            dispatch={dispatch}
            client={client}
        />
    )
}
import type { Intent, Refusal } from '@prisma-airs/desktop-contracts'

/** What the presentation learned about one delivered intent. */
export type DispatchOutcome =
    /** Admitted; `operation` names native work the intent started, if any. */
    | { kind: 'admitted'; operation: string | null }
    | { kind: 'refused'; refusal: Refusal }
    /** The desktop did not confirm admission; the current state is shown. */
    | { kind: 'unknown' }
    | { kind: 'failed' }

export type Dispatch = (intent: Intent) => Promise<DispatchOutcome>

const REFUSAL_TEXT: Record<Refusal, string> = {
    staleContext: 'The active tenant changed before this was applied. Check the current tenant and try again.',
    capabilityMissing: 'That is not available for the current tenant.',
    invalidInput: 'Check the entered values and try again.',
    reviewInvalid: 'This review is no longer valid. Start a new review.',
    reviewConsumed: 'This review was already used.',
    busy: 'The desktop is busy with a previous request. Try again in a moment.',
    lockedStore: 'The Keychain is locked. Unlock it and try again.',
    deniedStore: 'Local desktop data or the credential store is not available.',
    alreadyProcessed: 'That request was already processed.',
    sequenceGap: 'The request was not delivered in order. Try again.',
    shuttingDown: 'The desktop is shutting down.',
}

/** Sanitized operator text for an outcome that did not apply. */
export function outcomeMessage(outcome: DispatchOutcome): string | null {
    switch (outcome.kind) {
        case 'admitted':
            return null
        case 'refused':
            return REFUSAL_TEXT[outcome.refusal]
        case 'unknown':
            return 'The desktop did not confirm the request. The current state is shown; check it before trying again.'
        case 'failed':
            return 'The request could not be delivered.'
    }
}
import type {
    ContextRef,
    ManagementFailure,
    ManagementRequest,
    ManagementResource,
    ManagementResult,
} from '@prisma-airs/desktop-contracts'
import { RefusedError } from '@prisma-airs/desktop-contracts'
import { type Dispatch, outcomeMessage } from '../tenants/dispatch'

/** Waits for the single native result of an admitted management read. */
export type ObserveManagement = (operation: string) => Promise<ManagementResult>

/** What one management read produced, as the presentation shows it. */
export type ReadOutcome =
    | { kind: 'result'; result: ManagementResult }
    /** Not admitted (refused, unconfirmed or undelivered): nothing was read. */
    | { kind: 'notAdmitted'; message: string }

/**
 * Dispatches one management read for `context` and waits for its single
 * observation. A read whose context retires while it runs settles as
 * `cancelled`; it is never shown as data.
 */
export async function readManagement(
    dispatch: Dispatch,
    observe: ObserveManagement,
    context: ContextRef,
    request: ManagementRequest
): Promise<ReadOutcome> {
    const outcome = await dispatch({ kind: 'management', context, request })
    if (outcome.kind !== 'admitted' || outcome.operation === null) {
        return { kind: 'notAdmitted', message: outcomeMessage(outcome) ?? 'The read was not started.' }
    }
    try {
        return { kind: 'result', result: await observe(outcome.operation) }
    } catch (error) {
        if (error instanceof RefusedError) return { kind: 'notAdmitted', message: outcomeMessage({ kind: 'refused', refusal: error.refusal }) ?? '' }
        return { kind: 'notAdmitted', message: 'The desktop did not return the result of this read.' }
    }
}

/** Sanitized operator text for each management failure (no server text). */
export const MANAGEMENT_FAILURE_TEXT: Record<ManagementFailure, string> = {
    unauthorized: 'The management client was not accepted. Check the client ID and secret in Settings.',
    denied: 'This management client is not allowed to read this. Ask your administrator for the needed role.',
    notFound: 'The service did not find this resource.',
    rateLimited: 'The service is limiting requests. Wait a moment, then refresh.',
    unavailable: 'The management service is unavailable. Try again later.',
    rejected: 'The service rejected the request.',
    timeout: 'The read took too long and was stopped.',
    cancelled: 'The read was stopped because the tenant or its management credential changed.',
    network: 'The management service could not be reached.',
    destination: 'The service tried to send the read somewhere else. Nothing was followed.',
    invalidResponse: 'The service returned a reply the desktop could not use.',
    credentialLocked: 'The Keychain is locked. Unlock it and try again.',
    credentialDenied: 'macOS did not allow access to the management secret.',
    credentialMissing: 'The management secret is missing. Enter it again in Settings.',
    configuration: 'The management connection could not be set up for this tenant.',
}

export interface ResourceInfo {
    id: ManagementResource
    label: string
    group: 'AI Runtime Security' | 'Data Loss Prevention'
    /** Fields tried in order for a row's display name. */
    nameFields: readonly string[]
    /** The service's identity field (detail reads look items up by it). */
    idField: string
    /** Whether a detail read can address an item of this resource. */
    detail: boolean
}

