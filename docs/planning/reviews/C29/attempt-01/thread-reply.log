//! C29 (D058): the wizard's Rust contract through the production authority
//! interface: per-tenant products via `finishTenantSetup`, persisted and
//! restored, Runtime Security always kept, refusals for unknown tenants and
//! empty lists, and the onboarding state the wizard advances.

use desktop_core::features::{OnboardingState, ProductId};
use desktop_core::fixtures::{self, Handles, ScriptedStore};
use desktop_core::store::PersistedState;
use desktop_core::{
    AuthorityHandle, Core, CoreConfig, Delivery, Intent, Observation, Receipt, Refusal,
    ShellSnapshot, ViewScope,
};
use serde_json::json;

struct Desk {
    _core: Core,
    handle: AuthorityHandle,
    session: String,
    sequence: u64,
    adapters: Handles,
}

impl Desk {
    fn new() -> Self {
        Self::from_state(PersistedState::default())
    }

    fn from_state(state: PersistedState) -> Self {
        let (adapters, handles) = fixtures::adapters_with(ScriptedStore::with_state(state));
        let core = Core::new(CoreConfig::default(), adapters);
        core.start();
        let handle = core.operator();
        let session = handle.register_delivery_session().expect("session").nonce;
        Self {
            _core: core,
            handle,
            session,
            sequence: 0,
            adapters: handles,
        }
    }

    fn restart(self) -> Self {
        let state = self.adapters.store.saved().unwrap_or_default();
        drop(self._core);
        Self::from_state(state)
    }

    async fn send(&mut self, intent: serde_json::Value) -> Result<Receipt, Refusal> {
        let intent: Intent = serde_json::from_value(intent).expect("intent");
        self.sequence += 1;
        self.handle
            .dispatch(
                Delivery {
                    session: self.session.clone(),
                    sequence: self.sequence,
                },
                intent,
            )
            .await
    }

    fn snap(&self) -> ShellSnapshot {
        match self.handle.observe(ViewScope::Shell).expect("observe") {
            Observation::Shell { snapshot, .. } => snapshot,
            _ => unreachable!("shell scope"),
        }
    }

    async fn create(&mut self, label: &str) -> String {
        self.send(json!({"kind": "createTenant", "profile": {
            "label": label, "tsgId": "1234567890",
            "destination": {"kind": "region", "region": "europe"}
        }}))
        .await
        .expect("created");
        self.snap()
            .tenants
            .iter()
            .find(|t| t.label == label)
            .expect("tenant")
            .id
            .as_str()
            .to_owned()
    }
}

#[tokio::test]
async fn a_tenant_reads_runtime_only_until_the_wizard_finishes() {
    let mut desk = Desk::new();
    let id = desk.create("Northwind Health").await;
    let tenant = desk
        .snap()
        .tenants
        .into_iter()
        .find(|t| t.id.as_str() == id)
        .expect("tenant");
    assert_eq!(tenant.products, vec![ProductId::RuntimeSecurity]);
}

#[tokio::test]
async fn finish_tenant_setup_persists_products_keeps_runtime_and_restores() {
    let mut desk = Desk::new();
    let id = desk.create("Northwind Health").await;
    desk.send(json!({"kind": "finishTenantSetup", "tenant": id, "products": ["gateway", "redTeam", "gateway"]}))
        .await
        .expect("finished");
    let tenant = desk
        .snap()
        .tenants
        .into_iter()
        .find(|t| t.id.as_str() == id)
        .expect("tenant");
    assert_eq!(
        tenant.products,
        vec![
            ProductId::RuntimeSecurity,
            ProductId::Gateway,
            ProductId::RedTeam
        ],
        "Runtime first, duplicates dropped"
    );
    let saved = desk.adapters.store.saved().expect("saved");
    assert_eq!(saved.tenant_products.len(), 1);
    let desk = desk.restart();
    let tenant = desk
        .snap()
        .tenants
        .into_iter()
        .find(|t| t.id.as_str() == id)
        .expect("tenant");
    assert_eq!(tenant.products.len(), 3);
}

#[tokio::test]
async fn finish_tenant_setup_refuses_unknown_tenants_and_empty_lists() {
    let mut desk = Desk::new();
    let id = desk.create("Northwind Health").await;
    assert_eq!(
        desk.send(json!({"kind": "finishTenantSetup", "tenant": id, "products": []}))
            .await,
        Err(Refusal::InvalidInput)
    );
    assert_eq!(
        desk.send(json!({"kind": "finishTenantSetup", "tenant": "tn-00000000000000ff", "products": ["gateway"]})).await,
        Err(Refusal::InvalidInput)
    );
    // An unadmitted product is not even a well-formed intent (AIS/AES have no id).
    assert!(
        serde_json::from_value::<Intent>(
            json!({"kind": "finishTenantSetup", "tenant": id, "products": ["ais"]})
        )
        .is_err()
    );
}

