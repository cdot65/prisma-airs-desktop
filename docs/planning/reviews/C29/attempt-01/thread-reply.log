pub(super) async fn sign_in(inner: Arc<Inner>, flow: u64, client: AcademyClient) {
    let fail = |failure: AcademyFailure, vault: Option<VaultError>| {
        if let Ok(mut state) = lock(&inner)
            && state.learner.flow() == Some(flow)
        {
            state.learner = LearnerPhase::Failed { failure, vault };
            state.changed();
        }
    };
    let current = || lock(&inner).is_ok_and(|s| s.learner.flow() == Some(flow));
    let started = async {
        let config = client.config().await?;
        let endpoints = client.endpoints(&config).await?;
        let start = client.start(&config, &endpoints).await?;
        Ok::<_, AcademyFailure>((config, endpoints, start))
    }
    .await;
    let (config, endpoints, start) = match started {
        Ok(started) => started,
        Err(failure) => return fail(failure, None),
    };
    let expires_at = Instant::now() + start.expires_in;
    {
        let Ok(mut state) = lock(&inner) else { return };
        if state.learner.flow() != Some(flow) {
            return;
        }
        state.learner = LearnerPhase::Awaiting {
            flow,
            user_code: start.user_code.clone(),
            verification: start
                .verification_uri_complete
                .clone()
                .unwrap_or(start.verification_uri.clone()),
            expires_at,
        };
        state.changed();
    }
    let mut interval = start.interval;
    let tokens = loop {
        tokio::time::sleep(interval).await;
        if !current() {
            return;
        }
        if Instant::now() >= expires_at {
            return fail(AcademyFailure::Expired, None);
        }
import type { LucideIcon } from 'lucide-react'
import { CircleAlert, CircleCheck, CircleSlash, Info } from 'lucide-react'

export type VerdictTone = 'blocked' | 'flagged' | 'allowed' | 'info'

const TONES: Record<VerdictTone, { icon: LucideIcon; fg: string; bg: string }> = {
    blocked: { icon: CircleSlash, fg: 'var(--v2-block)', bg: 'var(--v2-block-bg)' },
    flagged: { icon: CircleAlert, fg: 'var(--v2-flag)', bg: 'var(--v2-flag-bg)' },
    allowed: { icon: CircleCheck, fg: 'var(--v2-ok)', bg: 'var(--v2-ok-bg)' },
    info: { icon: Info, fg: 'var(--v2-soft)', bg: 'var(--v2-inset)' },
}

/**
 * A verdict or severity is colour plus icon plus word, never colour alone
 * (invariant I9). The word is the accessible name; the icon is decorative.
 */
export function Verdict({ tone, word, reason }: { tone: VerdictTone; word: string; reason?: string }) {
    const { icon: Icon, fg, bg } = TONES[tone]
    return (
        <span
            data-slot='verdict'
            data-tone={tone}
            style={{ color: fg, background: bg }}
            className='inline-flex min-h-7 items-center gap-1.5 rounded-[7px] px-2 text-[12px] font-semibold'
        >
            <Icon aria-hidden='true' size={14} strokeWidth={2.4} />
            <span>{word}</span>
            {reason && <span className='font-normal opacity-90'> · {reason}</span>}
        </span>
    )
}

