import { useEffect, useId, useRef, useState, type FormEvent, type ReactNode } from 'react'
import { CircleCheck, CircleAlert, Info } from 'lucide-react'
import type { ContextRef, ManagementResult, ProductId, Region, ShellSnapshot, TenantView, VerifyWarning } from '@prisma-airs/desktop-contracts'
import type { Dispatch, DispatchOutcome } from '../../features/tenants/dispatch'
import { outcomeMessage } from '../../features/tenants/dispatch'
import { readManagement, MANAGEMENT_FAILURE_TEXT } from '../../features/administration/management-read'
import { Verdict, type VerdictTone } from '../verdict'
import { WIZARD_COPY as C } from './copy'

export type WizardStep = 'welcome' | 'tenant' | 'products' | 'verify' | 'packs' | 'academy' | 'done'
const FIRST_RUN: WizardStep[] = ['welcome', 'tenant', 'products', 'verify', 'packs', 'academy', 'done']
const ADD: WizardStep[] = ['tenant', 'products', 'verify', 'packs', 'done']

const REGIONS: { value: Region; label: string }[] = [
    { value: 'unitedStates', label: 'United States' },
    { value: 'europe', label: 'Europe' },
    { value: 'india', label: 'India' },
    { value: 'singapore', label: 'Singapore' },
]

/** The products the wizard offers: admitted ones selectable, the rest shown as not available (DESIGN-V2 §6). */
export const PRODUCT_CARDS: { id: ProductId | null; label: string; body: string; readOnly?: boolean; needsManagement?: boolean }[] = [
    { id: 'runtimeSecurity', label: 'AI Runtime Security', body: 'Prompts, responses and tool calls are scanned as they happen.' },
    { id: 'gateway', label: 'AI Gateway', body: 'Workspaces, routes, providers, guardrails and keys.', needsManagement: true },
    { id: 'redTeam', label: 'AI Red Teaming', body: 'Scan inventory, statistics and reports.', readOnly: true, needsManagement: true },
    { id: 'modelSkill', label: 'Model and skill scans', body: 'Model Security and AgentGuard skill scan summaries.', readOnly: true, needsManagement: true },
    { id: null, label: 'Agentic Identity Security', body: 'Needs an admitted AIS service (D058).' },
    { id: null, label: 'Agentic Endpoint Security', body: 'Needs an admitted AES service (D058).' },
]

export interface WizardProps {
    snapshot: ShellSnapshot
    dispatch: Dispatch
    observeManagement: (operation: string) => Promise<ManagementResult>
    mode: 'firstRun' | 'add'
    /**
     * add mode: the sheet closes, with the added tenant's label once it
     * finished; firstRun: the shell takes over once onboarding is done.
     */
    onClose: (added?: string) => void
    onNavigate: (feature: 'import' | 'home') => void
    /** Board fixtures and tests only: open on a later step with results already in hand. */
    initial?: WizardInitial
}

export type VerifyState = 'pending' | 'pass' | 'warning' | 'fail' | 'skipped'
export interface VerifyRow {
    id: 'scan' | 'management' | 'gateway'
    state: VerifyState
    reason: string
}
/** The state a board fixture opens the wizard in (boards.md `fx.on.*`). */
export interface WizardInitial {
    step?: WizardStep
    /** The tenant the wizard is bound to (its id in the snapshot). */
    tenant?: string
    products?: ProductId[]
    rows?: VerifyRow[]
    verifying?: boolean
    packsDone?: boolean
}
/** The product a verify line reports on (VerifyStep.product). */
const ROW_PRODUCT: Record<VerifyRow['id'], ProductId> = { scan: 'runtimeSecurity', management: 'runtimeSecurity', gateway: 'gateway' }

const toneOf = (state: VerifyState): VerdictTone => (state === 'pass' ? 'allowed' : state === 'warning' ? 'flagged' : state === 'fail' ? 'blocked' : 'info')

function fieldError(name: string, value: string): string | null {
    if (name === 'name') return value.trim() ? null : C.tenant.errors.name
    if (name === 'tsg') return /^\d{10}$/.test(value.trim()) ? null : C.tenant.errors.tsg
    return null
}

/**
 * The first-run wizard and the add-tenant sheet (C29, screens/wizard.md).
 * Every durable fact is written through existing core intents at the step
 * that produces it (createTenant, configureScanCredential,
 * configureManagementCredential, importExamples, startAcademySignIn) and the
 * products and onboarding state through `finishTenantSetup` and
 * `setOnboarding`. Secrets are read from their fields once, cleared, and
 * sent inside the intent (provenance P25); nothing here holds them.
 */
export function Wizard(props: WizardProps) {
    const { snapshot, dispatch, mode } = props
    const steps = mode === 'add' ? ADD : FIRST_RUN
    const initial = props.initial
    const startIndex = Math.max(0, steps.indexOf(initial?.step ?? (steps[0] as WizardStep)))
    const [index, setIndex] = useState(startIndex)
    const step = steps[index] as WizardStep
    const [visited, setVisited] = useState<Set<WizardStep>>(() => new Set<WizardStep>(steps.slice(0, startIndex + 1)))
    const [tenantId, setTenantId] = useState<string | null>(initial?.tenant ?? null)
    const tenant: TenantView | null = snapshot.tenants.find((t) => t.id === tenantId) ?? null
    const context: ContextRef | null = tenant && snapshot.active?.tenant === tenant.id ? snapshot.active.context : null
    const [products, setProducts] = useState<ProductId[]>(initial?.products ?? ['runtimeSecurity'])
    const [rows, setRows] = useState<VerifyRow[]>(initial?.rows ?? [])
    const [verifying, setVerifying] = useState(initial?.verifying ?? false)
    const [packsDone, setPacksDone] = useState(initial?.packsDone ?? false)
    const [opening, setOpening] = useState(false)
    const [status, setStatus] = useState<string | null>(null)
    const heading = useRef<HTMLHeadingElement>(null)
    const headingId = useId()

    useEffect(() => {
        heading.current?.focus()
    }, [step])

    useEffect(() => {
        // Leaving Welcome marks the wizard in progress (Rust-owned).
        if (mode === 'firstRun' && step !== 'welcome' && snapshot.onboarding === 'needed') void dispatch({ kind: 'setOnboarding', state: 'inProgress' })
    }, [step, mode, snapshot.onboarding, dispatch])

    const go = (next: number) => {
        setStatus(null)
        setIndex(next)
        setVisited((v) => new Set<WizardStep>([...v, steps[next] as WizardStep]))
    }
    const report = (outcome: DispatchOutcome, ok: string) => setStatus(outcome.kind === 'admitted' ? ok : outcomeMessage(outcome) ?? 'Not delivered.')

    // ---- tenant step ----
    const [errors, setErrors] = useState<Record<string, string>>({})
    const [touched, setTouched] = useState<Record<string, boolean>>({})
    const [busy, setBusy] = useState(false)
    /** The profile this wizard created, until the snapshot shows it. */
    const [created, setCreated] = useState<{ label: string; tsg: string } | null>(null)
    const scanRef = useRef<HTMLInputElement>(null)
    const secretRef = useRef<HTMLInputElement>(null)

    async function createTenant(event: FormEvent<HTMLFormElement>) {
        event.preventDefault()
        const data = new FormData(event.currentTarget)
        const name = String(data.get('name') ?? '')
        const tsg = String(data.get('tsg') ?? '')
        const region = String(data.get('region') ?? 'unitedStates') as Region
        const next = { name: fieldError('name', name) ?? '', tsg: fieldError('tsg', tsg) ?? '' }
        setTouched({ name: true, tsg: true })
        setErrors(next)
        if (next.name || next.tsg) return
        setBusy(true)
        const outcome = await dispatch({ kind: 'createTenant', profile: { label: name.trim(), tsgId: tsg.trim(), destination: { kind: 'region', region } } })
        setBusy(false)
        if (outcome.kind !== 'admitted') return setStatus(outcomeMessage(outcome) ?? 'Not delivered.')
        setCreated({ label: name.trim(), tsg: tsg.trim() })
        setStatus(C.tenant.created(name.trim()))
    }
    // Bind to the tenant this wizard created (the newest profile with that
    // name and TSG) and make it active so its credentials attach to it: a
    // first run's first tenant already is; the add sheet selects it (P27).
    // A first run that resumes after a relaunch (onboarding in progress, a
    // tenant already active) binds to that tenant instead of creating another.
    useEffect(() => {
        if (tenantId !== null) return
        if (created) {
            const mine = [...snapshot.tenants].reverse().find((t) => t.label === created.label && t.tsgId === created.tsg)
            if (!mine) return
            setTenantId(mine.id)
            if (snapshot.active?.tenant !== mine.id) {
                void dispatch({ kind: 'selectTenant', tenant: mine.id }).then((outcome) => {
                    if (outcome.kind !== 'admitted') setStatus(outcomeMessage(outcome) ?? 'Not delivered.')
                })
            }
            return
        }
        if (snapshot.active && mode === 'firstRun' && snapshot.onboarding === 'inProgress') setTenantId(snapshot.active.tenant)
    }, [snapshot.tenants, snapshot.active, snapshot.onboarding, mode, created, tenantId, dispatch])

    async function saveScanKey(event: FormEvent<HTMLFormElement>) {
        event.preventDefault()
        const field = scanRef.current
        if (!field || !context) return
        const key = field.value
        field.value = ''
        if (!key) return setErrors((e) => ({ ...e, scanKey: C.tenant.errors.scanKey }))
        setErrors((e) => ({ ...e, scanKey: '' }))
        setBusy(true)
        report(await dispatch({ kind: 'configureScanCredential', context, mode: 'keychain', key }), C.tenant.keySaved)
        setBusy(false)
    }

    async function saveClient(event: FormEvent<HTMLFormElement>) {
        event.preventDefault()
        const secretField = secretRef.current
        if (!secretField || !context) return
        const secret = secretField.value
        secretField.value = ''
        const clientId = String(new FormData(event.currentTarget).get('clientId') ?? '').trim()
        if (!clientId) return setErrors((e) => ({ ...e, clientId: C.tenant.errors.clientId }))
        if (!secret) return setErrors((e) => ({ ...e, clientSecret: C.tenant.errors.clientSecret }))
        setErrors((e) => ({ ...e, clientId: '', clientSecret: '' }))
        setBusy(true)
        report(await dispatch({ kind: 'configureManagementCredential', context, mode: 'keychain', clientId, secret }), C.tenant.clientSaved)
        setBusy(false)
    }

    const keyReady = tenant?.scan.state === 'ready'
    const clientReady = tenant?.management.state === 'ready'

    // ---- verify step: one admitted read per line; the core authorises each ----
    async function verify() {
        if (!tenant || !context) return
        setVerifying(true)
        const next: VerifyRow[] = [
            { id: 'scan', state: 'pending', reason: '' },
            { id: 'management', state: 'pending', reason: '' },
            { id: 'gateway', state: 'pending', reason: '' },
        ]
        setRows([...next])
        next[0] = keyReady ? { id: 'scan', state: 'pass', reason: C.verify.scanStored } : { id: 'scan', state: 'fail', reason: C.verify.scanMissing }
        setRows([...next])
        if (clientReady) {
            const outcome = await readManagement(dispatch, props.observeManagement, context, { kind: 'verify' })
            next[1] =
                outcome.kind === 'result' && outcome.result.kind === 'verified'
                    ? { id: 'management', state: 'pass', reason: 'The management client can read this tenant.' }
                    : outcome.kind === 'result' && outcome.result.kind === 'failed'
                      ? { id: 'management', state: outcome.result.failure === 'denied' ? 'warning' : 'fail', reason: MANAGEMENT_FAILURE_TEXT[outcome.result.failure] }
                      : { id: 'management', state: 'fail', reason: outcome.kind === 'notAdmitted' ? outcome.message : 'The service returned a reply the desktop could not use.' }
        } else {
            next[1] = { id: 'management', state: products.some((p) => p !== 'runtimeSecurity') ? 'warning' : 'skipped', reason: C.verify.managementNone }
        }
        setRows([...next])
        next[2] = { id: 'gateway', state: 'skipped', reason: C.verify.gatewaySkipped }
        setRows([...next])
        setVerifying(false)
    }
    const failed = rows.some((r) => r.state === 'fail')
    const warned = rows.some((r) => r.state === 'warning')

    // The bundled import needs this tenant's library open (the same
    // `openLibrary` the Test Cases destination sends on entry).
    const libraryReady = snapshot.library.state === 'ready'
    useEffect(() => {
        if (step === 'packs' && context && (snapshot.library.state === 'idle' || snapshot.library.state === 'failed')) void dispatch({ kind: 'openLibrary', context })
    }, [step, context, snapshot.library.state, dispatch])

    async function importPacks() {
        if (!context || !libraryReady) return
        setBusy(true)
        const outcome = await dispatch({ kind: 'importExamples', context, source: 'bundled' })
        setBusy(false)
        report(outcome, C.packs.imported)
        if (outcome.kind === 'admitted') setPacksDone(true)
    }

    async function finish() {
        if (!tenant) return
        setOpening(true)
        // Warning lines become the tenant's setup warnings (Inbox items, C30).
        const warnings: VerifyWarning[] = rows.filter((r) => r.state === 'warning' && products.includes(ROW_PRODUCT[r.id])).map((r) => ({ product: ROW_PRODUCT[r.id], reason: r.reason }))
        const outcome = await dispatch({ kind: 'finishTenantSetup', tenant: tenant.id, products, warnings })
        if (outcome.kind !== 'admitted') {
            setOpening(false)
            return setStatus(outcomeMessage(outcome) ?? 'Not delivered.')
        }
        if (mode === 'firstRun') await dispatch({ kind: 'setOnboarding', state: 'done' })
        props.onClose(mode === 'add' ? tenant.label : undefined)
    }

    const railCtx = tenant ? `${tenant.label} · ${REGIONS.find((r) => r.value === (tenant.destination.kind === 'region' ? tenant.destination.region : 'unitedStates'))?.label ?? 'Custom'}${tenant.tsgId ? ` · TSG ${tenant.tsgId}` : ''}` : ''

    return (
        <div data-slot='wizard' data-mode={mode} className='flex' style={{ minHeight: mode === 'add' ? 780 : '100vh', background: 'var(--v2-bg)', color: 'var(--v2-ink)' }}>
            <nav aria-label='Setup steps' className='flex shrink-0 flex-col gap-1 p-6' style={{ width: mode === 'add' ? 244 : 320, background: 'var(--v2-side)', borderRight: '1px solid var(--v2-rule)' }}>
                <p className='text-[15px] font-bold'>{mode === 'add' ? C.railTitleAdd : C.railTitle}</p>
                <p className='text-[12px]' style={{ color: 'var(--v2-faint)' }}>
                    {mode === 'add' ? C.railSubAdd : C.railSub}
                </p>
                {railCtx && step !== 'welcome' && (
                    <p data-slot='rail-context' className='mt-1 text-[12px] font-semibold'>
                        {railCtx}
                    </p>
                )}
                <ol className='mt-4 flex flex-col gap-1'>
                    {steps.map((s, i) => (
                        <li key={s}>
                            <button
                                type='button'
                                aria-current={s === step ? 'step' : undefined}
                                disabled={!visited.has(s)}
                                onClick={() => visited.has(s) && go(i)}
                                className='flex min-h-9 w-full items-center gap-2 rounded-[7px] px-2.5 text-left text-[13px] disabled:opacity-60'
                                style={{ background: s === step ? 'var(--v2-sel)' : 'transparent', color: s === step ? 'var(--v2-sel-ink)' : 'var(--v2-ink)' }}
                            >
                                <span className='grid size-5 place-items-center rounded-full text-[11px] font-bold' style={{ border: '1px solid currentColor' }}>
                                    {i + 1}
                                </span>
                                {C.steps[s]}
                            </button>
                        </li>
                    ))}
                </ol>
                {mode === 'add' && (
                    <div className='mt-auto flex flex-col gap-2'>
                        <p className='text-[11px]' style={{ color: 'var(--v2-faint)' }}>
                            {C.cancelNote}
                        </p>
                        <button type='button' onClick={() => props.onClose()} className='h-8 rounded-[7px] border text-[12px]' style={{ borderColor: 'var(--v2-rule)' }}>
                            {C.cancel}
                        </button>
                    </div>
                )}
            </nav>
            <main className='min-w-0 flex-grow' style={{ padding: mode === 'add' ? '34px 44px 24px' : '32px 44px 28px', maxWidth: 'var(--v2-reading)' }}>
                <section aria-labelledby={headingId} className='flex flex-col gap-4'>
                    {step === 'welcome' && (
                        <Step heading={heading} id={headingId} title={C.welcome.title} lead={C.welcome.lead}>
                            <ul className='grid gap-3' style={{ gridTemplateColumns: 'repeat(auto-fill, minmax(220px, 1fr))' }}>
                                {C.welcome.cards.map((c) => (
                                    <li key={c.title} className='rounded-[12px] border p-5' style={{ borderColor: 'var(--v2-rule)', background: 'var(--v2-paper)' }}>
                                        <p className='text-[14px] font-semibold'>{c.title}</p>
                                        <p className='mt-2 text-[13px]' style={{ color: 'var(--v2-soft)' }}>
                                            {c.body}
                                        </p>
                                    </li>
                                ))}
                            </ul>
                            <Actions primary={{ label: C.welcome.continue, onClick: () => go(index + 1) }} />
                        </Step>
                    )}
                    {step === 'tenant' && (
                        <Step heading={heading} id={headingId} title={C.tenant.title} lead={C.tenant.lead}>
                            {!tenant ? (
                                <form onSubmit={(e) => void createTenant(e)} aria-busy={busy} className='flex flex-col gap-3' data-slot='tenant-form'>
                                    <Field label={C.tenant.name} name='name' hint={C.tenant.nameHint} error={touched.name ? errors.name : ''} maxLength={64} onBlur={(v) => { setTouched((t) => ({ ...t, name: true })); setErrors((e) => ({ ...e, name: fieldError('name', v) ?? '' })) }} />
                                    <label className='flex flex-col gap-1 text-[13px] font-medium'>
                                        {C.tenant.region}
                                        <select name='region' defaultValue='unitedStates' className='h-8 px-2'>
                                            {REGIONS.map((r) => (
                                                <option key={r.value} value={r.value}>
                                                    {r.label}
                                                </option>
                                            ))}
                                        </select>
                                    </label>
                                    <Field label={C.tenant.tsg} name='tsg' hint={C.tenant.tsgHint} inputMode='numeric' error={touched.tsg ? errors.tsg : ''} onBlur={(v) => { setTouched((t) => ({ ...t, tsg: true })); setErrors((e) => ({ ...e, tsg: fieldError('tsg', v) ?? '' })) }} />
                                    <div className='flex items-center gap-3'>
                                        <Primary label={C.tenant.create} disabled={busy} />
                                        <button type='button' onClick={() => props.onNavigate('import')} className='text-[13px] underline' style={{ color: 'var(--v2-acc)' }} title={C.tenant.importHint}>
                                            {C.tenant.importV1}
                                        </button>
                                    </div>
                                </form>
                            ) : (
                                <div className='flex flex-col gap-5'>
                                    <form onSubmit={(e) => void saveScanKey(e)} aria-busy={busy} className='flex flex-col gap-2' data-slot='scan-key-form'>
                                        <p className='text-[14px] font-semibold'>{C.tenant.scanKey}</p>
                                        <p className='text-[12px]' style={{ color: 'var(--v2-faint)' }}>
                                            {C.tenant.scanHint}
                                        </p>
                                        <p data-slot='scan-state'>
                                            <Verdict tone={keyReady ? 'allowed' : tenant.scan.state === 'failed' ? 'blocked' : 'info'} word={keyReady ? 'Saved' : tenant.scan.state === 'storing' ? 'Storing…' : 'Not saved'} />
                                        </p>
                                        {!keyReady && (
                                            <div className='flex items-end gap-2'>
                                                <label className='flex flex-grow flex-col gap-1 text-[13px] font-medium'>
                                                    {C.tenant.scanKey}
                                                    <input ref={scanRef} type='password' autoComplete='off' aria-invalid={errors.scanKey ? true : undefined} aria-describedby={errors.scanKey ? 'wz-scan-error' : undefined} className='h-8 px-2' />
                                                </label>
                                                <Primary label={C.tenant.saveKey} disabled={busy} />
                                            </div>
                                        )}
                                        {errors.scanKey && (
                                            <p id='wz-scan-error' role='alert' className='text-[12px]' style={{ color: 'var(--v2-block)' }}>
                                                {errors.scanKey}
                                            </p>
                                        )}
                                    </form>
                                    <form onSubmit={(e) => void saveClient(e)} aria-busy={busy} className='flex flex-col gap-2' data-slot='management-form'>
                                        <p className='text-[14px] font-semibold'>{C.tenant.management}</p>
                                        <p className='text-[12px]' style={{ color: 'var(--v2-faint)' }}>
                                            {C.tenant.managementHint}
                                        </p>
                                        <p data-slot='management-state'>
                                            <Verdict tone={clientReady ? 'allowed' : 'info'} word={clientReady ? `Saved · ${tenant.management.clientId ?? ''}` : 'Not saved'} />
                                        </p>
                                        {!clientReady && (
                                            <div className='flex flex-col gap-2'>
                                                <Field label={C.tenant.clientId} name='clientId' error={errors.clientId} />
                                                <label className='flex flex-col gap-1 text-[13px] font-medium'>
                                                    {C.tenant.clientSecret}
                                                    <input ref={secretRef} type='password' autoComplete='off' aria-invalid={errors.clientSecret ? true : undefined} className='h-8 px-2' />
                                                </label>
                                                {errors.clientSecret && (
                                                    <p role='alert' className='text-[12px]' style={{ color: 'var(--v2-block)' }}>
                                                        {errors.clientSecret}
                                                    </p>
                                                )}
                                                <div>
                                                    <button type='submit' disabled={busy} className='h-8 rounded-[7px] border px-3 text-[13px]' style={{ borderColor: 'var(--v2-rule)' }}>
                                                        {C.tenant.saveClient}
                                                    </button>
                                                </div>
                                            </div>
                                        )}
                                    </form>
                                    <div>
                                        <p className='text-[14px] font-semibold'>{C.tenant.gateway}</p>
                                        <p className='text-[12px]' style={{ color: 'var(--v2-faint)' }}>
                                            {C.tenant.gatewayHint}
                                        </p>
                                    </div>
                                    <Actions back={() => go(index - 1)} primary={{ label: C.tenant.continue, onClick: () => (keyReady ? go(index + 1) : setStatus(C.tenant.errors.needsKey)), disabled: !keyReady }} />
                                </div>
                            )}
                        </Step>
                    )}
                    {step === 'products' && (
                        <Step heading={heading} id={headingId} title={C.products.title} lead={C.products.lead}>
                            <ul className='grid gap-3' style={{ gridTemplateColumns: 'repeat(auto-fill, minmax(240px, 1fr))' }} aria-label='Products'>
                                {PRODUCT_CARDS.map((card) => {
                                    const unavailable = card.id === null
                                    const checked = card.id !== null && products.includes(card.id)
                                    return (
                                        <li key={card.label} className='rounded-[12px] border p-4' style={{ borderColor: checked ? 'var(--v2-acc)' : 'var(--v2-rule)', background: 'var(--v2-paper)', opacity: unavailable ? 0.7 : 1 }}>
                                            <label className='flex items-start gap-3'>
                                                <input
                                                    type='checkbox'
                                                    disabled={unavailable}
                                                    checked={checked}
                                                    aria-describedby={`${card.label}-body`}
                                                    onChange={(e) => card.id && setProducts((p) => (e.target.checked ? [...p, card.id!] : p.filter((x) => x !== card.id)))}
                                                    className='mt-0.5 size-4 min-h-0'
                                                />
                                                <span className='flex flex-col gap-1'>
                                                    <span className='text-[14px] font-semibold'>{card.label}</span>
                                                    <span id={`${card.label}-body`} className='text-[12px]' style={{ color: 'var(--v2-soft)' }}>
                                                        {card.body}
                                                    </span>
                                                    <span className='flex gap-1.5'>
                                                        {unavailable && <Verdict tone='info' word={C.products.unavailable} />}
                                                        {card.readOnly && <Verdict tone='info' word={C.products.readOnly} />}
                                                        {card.needsManagement && !clientReady && !unavailable && <Verdict tone='flagged' word={C.products.needsManagement} />}
                                                    </span>
                                                </span>
                                            </label>
                                        </li>
                                    )
                                })}
                            </ul>
                            <Actions back={() => go(index - 1)} primary={{ label: C.products.continue, onClick: () => go(index + 1) }} />
                        </Step>
                    )}
                    {step === 'verify' && (
                        <Step heading={heading} id={headingId} title={C.verify.title} lead={C.verify.lead}>
                            <ul className='flex flex-col gap-2' aria-label='Checks' aria-busy={verifying}>
                                {(rows.length ? rows : (['scan', 'management', 'gateway'] as const).map((id) => ({ id, state: 'pending' as VerifyState, reason: '' }))).map((r) => (
                                    <li key={r.id} className='flex items-center justify-between gap-3 rounded-[12px] border px-4 py-3' style={{ borderColor: 'var(--v2-rule)', background: 'var(--v2-paper)' }} data-slot={`verify-${r.id}`}>
                                        <span className='flex flex-col'>
                                            <span className='text-[14px] font-medium'>{C.verify.rows[r.id]}</span>
                                            {r.reason && (
                                                <span className='text-[12px]' style={{ color: 'var(--v2-soft)' }}>
                                                    {r.reason}
                                                </span>
                                            )}
                                        </span>
                                        <Verdict tone={toneOf(r.state)} word={C.verify.state[r.state]} />
                                    </li>
                                ))}
                            </ul>
                            <p role='status' aria-live='polite' className='text-[13px]' style={{ color: 'var(--v2-soft)' }}>
                                {verifying ? C.verify.running : rows.length ? (failed ? 'A check failed.' : warned ? 'Checks finished with warnings.' : 'All checks passed.') : ''}
                            </p>
                            <Actions
                                back={() => go(index - 1)}
                                secondary={rows.length === 0 ? { label: C.verify.run, onClick: () => void verify() } : failed ? { label: C.verify.fix, onClick: () => { setRows([]); go(steps.indexOf('tenant')) } } : { label: C.verify.again, onClick: () => void verify() }}
                                primary={{ label: warned && !failed ? C.verify.continueWarnings : C.verify.continue, onClick: () => go(index + 1), disabled: verifying || rows.length === 0 || failed }}
                            />
                        </Step>
                    )}
                    {step === 'packs' && (
                        <Step heading={heading} id={headingId} title={C.packs.title} lead={C.packs.lead}>
                            <p data-slot='packs-state'>
                                <Verdict tone={packsDone ? 'allowed' : 'info'} word={packsDone ? C.packs.imported : libraryReady ? 'Not imported' : C.packs.opening} />
                            </p>
                            <Actions back={() => go(index - 1)} secondary={packsDone ? undefined : { label: C.packs.import, onClick: () => void importPacks(), disabled: busy || !libraryReady }} primary={{ label: packsDone ? C.packs.continue : C.packs.skip, onClick: () => go(index + 1) }} />
                        </Step>
                    )}
                    {step === 'academy' && (
                        <Step heading={heading} id={headingId} title={C.academy.title} lead={C.academy.lead}>
                            <p data-slot='academy-state'>
                                <Verdict tone={snapshot.academy.state === 'signedIn' ? 'allowed' : 'info'} word={snapshot.academy.state === 'signedIn' ? C.academy.signedIn : snapshot.academy.state === 'awaitingApproval' ? `Approve in the browser: ${snapshot.academy.userCode}` : 'Signed out'} />
                            </p>
                            <Actions back={() => go(index - 1)} secondary={snapshot.academy.state === 'signedOut' ? { label: C.academy.signIn, onClick: () => void dispatch({ kind: 'startAcademySignIn' }) } : undefined} primary={{ label: snapshot.academy.state === 'signedIn' ? C.academy.continue : C.academy.skip, onClick: () => go(index + 1) }} />
                        </Step>
                    )}
                    {step === 'done' && tenant && (
                        <Step heading={heading} id={headingId} title={C.done.title} lead={C.done.lead(tenant.label)}>
                            <ul className='text-[13px]' style={{ color: 'var(--v2-soft)' }}>
                                <li>Scan key: {keyReady ? 'saved' : 'not saved'}</li>
                                <li>Management client: {clientReady ? 'saved' : 'not saved'}</li>
                                <li>Products: {products.map((p) => PRODUCT_CARDS.find((c) => c.id === p)?.label).join(', ')}</li>
                                <li>Starter cases: {packsDone ? 'imported' : 'skipped'}</li>
                            </ul>
                            <Actions back={() => go(index - 1)} primary={{ label: opening ? C.done.opening : mode === 'add' ? C.done.finish : C.done.open, onClick: () => void finish(), disabled: opening }} />
                        </Step>
                    )}
                    <p role='status' aria-live='polite' data-slot='wizard-status' className='text-[13px]' style={{ color: 'var(--v2-soft)' }}>
                        {status}
                    </p>
                </section>
            </main>
        </div>
    )
}

function Step({ heading, id, title, lead, children }: { heading: React.RefObject<HTMLHeadingElement | null>; id: string; title: string; lead: string; children: ReactNode }) {
    return (
        <>
            <h1 ref={heading} id={id} tabIndex={-1} className='font-bold' style={{ fontSize: 'var(--v2-title)' }}>
                {title}
            </h1>
            <p className='text-[14px]' style={{ color: 'var(--v2-soft)', maxWidth: 640 }}>
                {lead}
            </p>
            {children}
        </>
    )
}

function Field({ label, name, hint, error, onBlur, ...rest }: { label: string; name: string; hint?: string; error?: string; onBlur?: (value: string) => void; maxLength?: number; inputMode?: 'numeric' }) {
    const id = useId()
    return (
        <label className='flex flex-col gap-1 text-[13px] font-medium'>
            {label}
            <input id={id} name={name} autoComplete='off' aria-invalid={error ? true : undefined} aria-describedby={error ? `${id}-error` : hint ? `${id}-hint` : undefined} onBlur={(e) => onBlur?.(e.target.value)} className='h-8 px-2' {...rest} />
            {error ? (
                <span id={`${id}-error`} role='alert' className='text-[12px] font-normal' style={{ color: 'var(--v2-block)' }}>
                    {error}
                </span>
            ) : hint ? (
                <span id={`${id}-hint`} className='text-[12px] font-normal' style={{ color: 'var(--v2-faint)' }}>
                    {hint}
                </span>
            ) : null}
        </label>
    )
}

function Primary({ label, disabled }: { label: string; disabled?: boolean }) {
    return (
        <button type='submit' disabled={disabled} className='h-8 rounded-[7px] px-4 text-[13px] font-semibold disabled:opacity-60' style={{ background: 'var(--v2-acc)', color: 'var(--v2-acc-ink)' }}>
            {label}
        </button>
    )
}

function Actions({ back, secondary, primary }: { back?: () => void; secondary?: { label: string; onClick: () => void; disabled?: boolean }; primary: { label: string; onClick: () => void; disabled?: boolean } }) {
    return (
        <div className='mt-2 flex items-center gap-2'>
            {back && (
                <button type='button' onClick={back} className='h-8 rounded-[7px] border px-3 text-[13px]' style={{ borderColor: 'var(--v2-rule)' }}>
                    {C.back}
                </button>
            )}
            <span className='flex-grow' />
            {secondary && (
                <button type='button' onClick={secondary.onClick} disabled={secondary.disabled} className='h-8 rounded-[7px] border px-3 text-[13px] disabled:opacity-60' style={{ borderColor: 'var(--v2-rule)' }}>
                    {secondary.label}
                </button>
            )}
            <button type='button' onClick={primary.onClick} disabled={primary.disabled} className='h-8 rounded-[7px] px-4 text-[13px] font-semibold disabled:opacity-60' style={{ background: 'var(--v2-acc)', color: 'var(--v2-acc-ink)' }}>
                {primary.label}
            </button>
        </div>
    )
}

