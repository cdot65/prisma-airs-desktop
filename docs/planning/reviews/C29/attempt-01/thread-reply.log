/**
 * Wizard board fixtures (docs/architecture/ui-v2/screens/boards.md, `fx.on.*`
 * and `fx.addTenant`): every reviewed R2Onboard state as a native snapshot
 * plus the step the wizard opens on. Snapshots come from the wire fixture
 * through the real DesktopClient shape, so a drifted contract fails here first.
 */
import type { ShellSnapshot, TenantView } from '@prisma-airs/desktop-contracts'
import { tenant, withTenant } from '../../test/native'
import { fxHome, fxSwitcher } from '../fixtures'
import type { WizardInitial, VerifyRow } from './wizard'

export interface WizardBoard {
    snapshot: ShellSnapshot
    mode: 'firstRun' | 'add'
    initial?: WizardInitial
}

const NW_ID = 'tn-0123456789abcdef'
const northwind = (over: Partial<TenantView> = {}): TenantView =>
    tenant({ id: NW_ID, label: 'Northwind Health', tsgId: '1762204418', scan: { state: 'ready', mode: 'keychain', failure: null }, ...over })

/** fx.on.*: v2 with onboarding still needed (welcome) or in progress (bound to Northwind). */
const needed = (): ShellSnapshot => ({ ...fxHome(), onboarding: 'needed', tenants: [], active: null })
const inProgress = (t: TenantView = northwind()): ShellSnapshot => withTenant({ ...fxHome(), onboarding: 'inProgress' }, t)
const libraryOpen = (s: ShellSnapshot): ShellSnapshot => ({ ...s, library: { ...s.library, state: 'ready' } })
const bound = (step: WizardInitial['step'], rest: Omit<WizardInitial, 'step' | 'tenant'> = {}): WizardInitial => ({ step, tenant: NW_ID, products: ['runtimeSecurity', 'gateway'], ...rest })

const PASS: VerifyRow = { id: 'scan', state: 'pass', reason: 'Key stored in the Keychain; the first scan proves it against the service.' }
const GATEWAY_SKIPPED: VerifyRow = { id: 'gateway', state: 'skipped', reason: 'No workspace chosen yet; checked in Administration › AI Gateway.' }

export const fxOn = {
    /** R2On01 */
    welcome: (): WizardBoard => ({ snapshot: needed(), mode: 'firstRun' }),
    /** R2On02: the tenant step before anything is entered. */
    tenantEmpty: (): WizardBoard => ({ snapshot: needed(), mode: 'firstRun', initial: { step: 'tenant' } }),
    /** R2On02b: tenant created, key saved; the rail carries the context line. */
    tenantFilled: (): WizardBoard => ({ snapshot: inProgress(), mode: 'firstRun', initial: bound('tenant') }),
    /** R2On03 */
    products: (): WizardBoard => ({ snapshot: inProgress(), mode: 'firstRun', initial: bound('products') }),
    /** R2On04: results streaming in. */
    verifyRunning: (): WizardBoard => ({
        snapshot: inProgress(),
        mode: 'firstRun',
        initial: bound('verify', { verifying: true, rows: [PASS, { id: 'management', state: 'pending', reason: '' }, { id: 'gateway', state: 'pending', reason: '' }] }),
    }),
    /** R2On04b: a warning row on an admitted product. */
    verifyWarn: (): WizardBoard => ({
        snapshot: inProgress(),
        mode: 'firstRun',
        initial: bound('verify', { rows: [PASS, { id: 'management', state: 'warning', reason: 'No management client: Administration stays read-only.' }, GATEWAY_SKIPPED] }),
    }),
    /** R2On04c: a failed row. */
    verifyFail: (): WizardBoard => ({
        snapshot: inProgress(northwind({ management: { state: 'ready', mode: 'keychain', failure: null, clientId: 'svc@1762204418.iam.example', tokenOrigin: 'https://auth.apps.paloaltonetworks.com' } })),
        mode: 'firstRun',
        initial: bound('verify', { rows: [PASS, { id: 'management', state: 'fail', reason: 'The management service could not be reached.' }, GATEWAY_SKIPPED] }),
    }),
    /** R2On05 */
    packs: (): WizardBoard => ({ snapshot: libraryOpen(inProgress()), mode: 'firstRun', initial: bound('packs') }),
    /** R2On06 */
    academy: (): WizardBoard => ({ snapshot: inProgress(), mode: 'firstRun', initial: bound('academy', { packsDone: true }) }),
    /** R2On07 */
    done: (): WizardBoard => ({ snapshot: inProgress(), mode: 'firstRun', initial: bound('done', { packsDone: true }) }),
}

/** R2AddTenant: the sheet over a shell that already has tenants. */
export const fxAddTenant = (): WizardBoard => ({ snapshot: fxSwitcher(), mode: 'add' })

