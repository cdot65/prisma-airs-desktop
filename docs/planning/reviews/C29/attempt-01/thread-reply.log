        f = fx.App.focused(t) or {}
        d = next((n for n in t if (n.get("label") or "") == "Add a tenant" and n.get("subrole") in ("AXDialog", "AXApplicationDialog")), None)
        inside.append(bool(d and f.get("pos") and d["pos"][0] <= f["pos"][0] <= d["pos"][0] + d["size"][0] and d["pos"][1] <= f["pos"][1] <= d["pos"][1] + d["size"][1]))
    obs["sheet"]["contained"] = all(inside)
    obs["capture_sheet"] = capture(app, "add-tenant-sheet")
    press(app, "AXButton", "Cancel")
    tree, closed = app.wait_for(lambda t: not any((n.get("label") or "") == "Add a tenant" and n.get("subrole") in ("AXDialog", "AXApplicationDialog") for n in t), 8)
    app.menu("Go", "Switch Tenant…")
    t2, _ = app.wait_for(lambda t: any(n.get("role") == "AXGroup" and (n.get("label") or "") == "Switch tenant" for n in t), 8)
    count_after_cancel = sum(1 for n in t2 if n.get("role") in ("AXButton", "AXCheckBox") and "TSG" in (n.get("label") or ""))  # the active row is aria-pressed (AXCheckBox)
    app.keycode(53)
    obs["sheet"]["cancel_closed"] = closed
    obs["sheet"]["tenants_after_cancel"] = count_after_cancel
    # Create a tenant in the sheet, then Cancel: it stays.
    app.menu("Go", "Switch Tenant…")
    app.wait_for(lambda t: any(n.get("role") == "AXGroup" and (n.get("label") or "") == "Switch tenant" for n in t), 8)
    time.sleep(0.5)
    press(app, "AXButton", "Add a tenant")
    app.wait_for(lambda t: fx.App.node(t, "AXHeading", "Your tenant") is not None, 10)
    app.type_into("AXTextField", "Display name", "Meridian Retail")
    app.type_into("AXTextField", "TSG ID", "1001464285")
    press(app, "AXButton", "Create tenant")
    tree, _ = app.wait_for(lambda t: app.has_text(t, "Meridian Retail is created."), 10)
    # The sheet binds to the tenant it created and makes it active, so the key attaches to it (P27).
    obs["sheet"]["bound_context"] = any("Meridian Retail · " in x and "TSG 1001464285" in x for x in app.texts(tree))
    app.type_into("AXTextField", "Scan API key", "SYNTHETIC-C29-SECOND-KEY-zyxwvu", secure=True)
    press(app, "AXButton", "Save scan key")
    tree, second_saved = app.wait_for(lambda t: app.has_text(t, "Scan key saved in the Keychain.") or app.has_text(t, "Saved"), 12)
    obs["sheet"]["second_key_saved"] = second_saved
    press(app, "AXButton", "Cancel")
    app.wait_for(lambda t: not any((n.get("label") or "") == "Add a tenant" and n.get("subrole") in ("AXDialog", "AXApplicationDialog") for n in t), 8)
    tree = app.tree()
    sw = fx.App.node(tree, "AXPopUpButton", "Switch tenant") or {}
    obs["sheet"]["active_after_cancel"] = "Meridian Retail" in str(sw.get("label") or "")
    app.menu("Go", "Switch Tenant…")
    t3, _ = app.wait_for(lambda t: any(n.get("role") == "AXGroup" and (n.get("label") or "") == "Switch tenant" for n in t), 8)
    obs["sheet"]["kept_after_create_cancel"] = any("Meridian Retail" in (n.get("label") or "") for n in t3)
    obs["sheet"]["tenants_after_create_cancel"] = sum(1 for n in t3 if n.get("role") in ("AXButton", "AXCheckBox") and "TSG" in (n.get("label") or ""))
    obs["tree_switcher_after"] = save_tree("switcher-after-sheet", t3)
    app.keycode(53)
    app.quit()
    endpoint.stop()
    mgmt.stop()

    run_path = os.path.join(NATIVE, "observations.json")
    with open(run_path, "w") as f:
        json.dump(json.loads(json.dumps({"observations": obs, "log": LOG}).replace(rel(NATIVE), rel(FINAL))), f, indent=1)
    run_rel = rel(run_path)
    inventory = {c["id"]: c["check"] for c in json.load(open(os.path.join(ROOT, "docs/architecture/native-checks.json")))["chunks"]["C29"]}
    checks = []

    def add(cid, passed, observation, evidence):
        checks.append({"id": cid, "description": inventory[cid], "result": "pass" if passed else "fail",
                       "observation": observation, "evidence": [e for e in evidence if e]})

    w, ts = obs["welcome"], obs["tenant_step"]
    add("C29-N01", w["shown"] and w["framing"] and w["cards"] and w["no_shell"] and w["after_relaunch"] and ts["shown"] and ts["heading_focused"] and ts["rail_current"],
        f"wizard shown on first v2 launch: {w['shown']} (framing {w['framing']}, three cards {w['cards']}, no shell rail {w['no_shell']}), again after relaunch {w['after_relaunch']}; Set up a tenant → Tenant heading focused {ts['heading_focused']}, rail step current {ts['rail_current']}",
        [run_rel, obs["tree_welcome"], obs["capture_welcome"]])
    v, c, k = obs["validation"], obs["created"], obs["key"]
    add("C29-N02", v["messages"] and v["no_tenant_yet"] and c["status"] and c["rail_context"] and obs["continue_disabled_before_key"] and k["saved"] and k["continue_enabled"] and not k["secret_in_trees"] and not k["secret_in_files"],
        f"empty name + 9-digit TSG: both messages shown {v['messages']} and nothing created {v['no_tenant_yet']}; valid create → status {c['status']}, rail context {c['rail_context']}; Continue disabled before the key {obs['continue_disabled_before_key']}; key saved {k['saved']}, Continue enabled {k['continue_enabled']}; secret in AX trees {k['secret_in_trees']}, in data files outside the Keychain {k['secret_in_files']}",
        [run_rel, obs["tree_invalid"], obs["tree_key_saved"]])
    p, vf, vp = obs["products"], obs["verify_fail"], obs["verify_pass"]
    add("C29-N03", p["shown"] and p["unavailable_disabled"] and p["unavailable_text"] and p["selectable"] and vf["failed"] and vf["continue_disabled"] and obs["verify_fresh_after_fix"] and vp["passed"],
        f"products: AIS/AES disabled {p['unavailable_disabled']} with the notice {p['unavailable_text']}, admitted products selectable {p['selectable']}; verify with the management endpoint down: failed {vf['failed']}, Continue disabled {vf['continue_disabled']}, 'Fix and verify again' offered and the next verify starts clean {obs['verify_fresh_after_fix']}; with the endpoint up: management verify Pass and all checks passed {vp['passed']} ({vp['requests']} synthetic requests)",
        [run_rel, obs["tree_products"], obs["tree_verify_fail"], obs["tree_verify_pass"], obs["capture_verify"]])
    pk, ac, dn, hm, lb = obs["packs"], obs["academy"], obs["done"], obs["home"], obs["library"]
    add("C29-N04", pk["imported"] and ac["shown"] and ac["sync_copy"] and ac["sign_in_offered"] and dn["shown"] and dn["summary"] and hm["shown"] and hm["switcher_names_tenant"] and lb["shown"] and lb["has_cases"] and obs["relaunch_home"],
        f"bundled examples imported {pk['imported']} and listed in Test Cases {lb['has_cases']}; Academy step with sign-in offered {ac['sign_in_offered']} and the sync disclosure {ac['sync_copy']}; Done summary {dn['summary']}; Open Prisma AIRS → Home with the tenant in the switcher {hm['switcher_names_tenant']}; relaunch shows Home, not the wizard: {obs['relaunch_home']}",
        [run_rel, obs["capture_home"], obs["tree_library"]])
    s = obs["sheet"]
    add("C29-N05", s["shown"] and s["no_welcome_or_academy"] and s["tenant_heading"] and (s["rail_width"] or 0) == 244 and s["contained"] and s["cancel_closed"] and s["tenants_after_cancel"] == 1
        and s["bound_context"] and s["second_key_saved"] and s["active_after_cancel"] and s["kept_after_create_cancel"] and s["tenants_after_create_cancel"] == 2,
        f"sheet shown as a dialog {s['shown']} with steps {s['steps']} (rail {s['rail_width']}px); Tab stayed inside {s['contained']}; Cancel on the first step closed it {s['cancel_closed']} leaving {s['tenants_after_cancel']} tenant; a tenant created in the sheet is bound (rail context {s['bound_context']}), receives its own scan key {s['second_key_saved']}, is active after Cancel {s['active_after_cancel']} and listed with the first ({s['tenants_after_create_cancel']} tenants)",
        [run_rel, obs["tree_sheet"], obs["capture_sheet"], obs["tree_switcher_after"]])

    hw = sh(["sysctl", "-n", "hw.model"]).stdout.strip()
    os_ver = sh(["sw_vers", "-productVersion"]).stdout.strip() + " (" + sh(["sw_vers", "-buildVersion"]).stdout.strip() + ")"
    record = {
        "schema": "airs-v2/native-acceptance/1", "subject": "C29", "recorded_utc": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()), "method": "cua",
        "performed_by": "Claude Code driving the real fixture window through macOS Accessibility (System Events and the ax helper) with fixture WebView self-capture; tools/native-acceptance/acceptance_c29.py",
        "host": f"{hw}; macOS {os_ver}",
        "app": {"bundle": prepared["bundle"], "identifier": prepared["identifier"], "executable_sha256": prepared["executable_sha256"], "fixture": True},
        "checks": checks,
        "limitations": [
            "Pixels come from the fixture build's own WKWebView snapshot; menus and dialogs are verified through System Events and the accessibility tree.",
            "The verify read runs against the synthetic management endpoint (tools/native-acceptance/mgmt_server.py); the fail path stops that endpoint.",
            "The Academy step is exercised as skipped; the hosted sign-in is covered by C04's acceptance.",
            "Spoken VoiceOver output was not recorded.",
        ],
    }
    screens = os.path.join(EVIDENCE, "screens")
    os.makedirs(screens, exist_ok=True)
    for name, src in (("welcome.png", obs["capture_welcome"]), ("verify-pass.png", obs["capture_verify"]), ("home-after-wizard.png", obs["capture_home"]), ("add-tenant-sheet.png", obs["capture_sheet"])):
        if src:
            shutil.copy(os.path.join(ROOT, src), os.path.join(screens, name))
    record["screens"] = sorted(os.listdir(screens))
    if os.path.isdir(FINAL):
        shutil.rmtree(FINAL)
    os.rename(NATIVE, FINAL)

