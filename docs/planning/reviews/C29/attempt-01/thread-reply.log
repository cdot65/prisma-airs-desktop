    onClose: () => void
    children: ReactNode
    /** Width in CSS px (default 560). */
    width?: number
    'data-slot'?: string
}

const FOCUSABLE = 'a[href], button:not([disabled]), input:not([disabled]), select:not([disabled]), textarea:not([disabled]), [tabindex]:not([tabindex="-1"])'

/**
 * One topmost modal (I8): dialogs register on a shell-wide stack; only the
 * last is interactive. Lower dialogs are inert and aria-hidden, Tab and
 * Shift-Tab stay inside the topmost dialog, Escape closes the topmost only,
 * focus moves into the dialog on open and back to the opener on close. The
 * page behind every dialog is made inert by the shell (`useModalsOpen`).
 * No global key listener: the dialog element handles its own keys.
 */
export function Modal({ label, onClose, children, width = 560, ...rest }: ModalProps) {
    const id = useId()
    const pushModal = useShellStore((s) => s.pushModal)
    const popModal = useShellStore((s) => s.popModal)
    const modals = useShellStore((s) => s.modals)
    const topmost = modals.length > 0 && modals[modals.length - 1] === id
    const dialog = useRef<HTMLDivElement>(null)
    const opener = useRef<HTMLElement | null>(null)
    const focusedOnce = useRef(false)

    useEffect(() => {
        opener.current = document.activeElement instanceof HTMLElement ? document.activeElement : null
        pushModal(id)
        return () => {
            popModal(id)
            // After the commit: the page behind is still inert during cleanup,
            // and an inert ancestor refuses focus (observed in WebKit).
            const target = opener.current
            queueMicrotask(() => {
                // Only when nothing else took focus meanwhile (⌘T replacing the
                // palette hands focus to the tenant list, which must keep it).
                const active = document.activeElement
                if (!active || active === document.body) target?.focus()
            })
        }
    }, [id, pushModal, popModal])

    useEffect(() => {
        // Initial focus goes into the dialog once, when it opens. Regaining the
        // top after a higher dialog closes must not refocus: that dialog is
        // restoring its own opener, which may be any control here.
        if (!topmost || focusedOnce.current) return
        const node = dialog.current
        if (!node) return
        focusedOnce.current = true
        if (!node.contains(document.activeElement)) {
            const first = node.querySelector<HTMLElement>('[autofocus], ' + FOCUSABLE)
            ;(first ?? node).focus()
        }
    }, [topmost])

    const onKeyDown = (event: KeyboardEvent<HTMLDivElement>) => {
        if (!topmost) return
        if (event.key === 'Escape') {
            event.preventDefault()
            event.stopPropagation()
            onClose()
            return
        }
        if (event.key === 'Tab') {
            // Keyboard interaction stays inside the topmost dialog.
            const node = dialog.current
            if (!node) return
            const items = Array.from(node.querySelectorAll<HTMLElement>(FOCUSABLE)).filter((el) => !el.hasAttribute('hidden') && el.getAttribute('aria-hidden') !== 'true')
            if (items.length === 0) {
                event.preventDefault()
                node.focus()
                return
            }
            const first = items[0] as HTMLElement
            const last = items[items.length - 1] as HTMLElement
            const active = document.activeElement
            if (event.shiftKey && (active === first || active === node)) {
                event.preventDefault()
                last.focus()
            } else if (!event.shiftKey && active === last) {
                event.preventDefault()
                first.focus()
            }
        }
    }

    return (
        <div
            className='fixed inset-0 z-50 grid place-items-start justify-center pt-[10vh]'
            data-v2-scrim=''
            aria-hidden={topmost ? undefined : true}
            inert={topmost ? undefined : true}
            onMouseDown={() => topmost && onClose()}
        >
            <div
                ref={dialog}
                role='dialog'
                aria-modal={topmost ? 'true' : undefined}
                aria-label={label}
                tabIndex={-1}
                data-slot={rest['data-slot'] ?? 'modal'}
                data-topmost={topmost ? 'true' : 'false'}
                onKeyDown={onKeyDown}
                onMouseDown={(e) => e.stopPropagation()}
                className='rounded-[12px] border p-5 shadow-2xl'
                style={{ width: `min(${width}px, 92vw)`, background: 'var(--v2-paper)', borderColor: 'var(--v2-rule)', color: 'var(--v2-ink)' }}
            >
                {children}
            </div>
        </div>
    )
}

/** Whether any modal is open: the shell makes the page behind it inert. */
export function useModalsOpen(): boolean {
    return useShellStore((s) => s.modals.length > 0)
}
import { type FormEvent, useId, useRef, useState } from 'react'
import { Button, Callout, Input } from '@ai-security-academy/presentation'
import { AlertTriangle, CheckCircle2, Info } from 'lucide-react'
import type { ContextRef, StorageMode, TenantView, VaultError } from '@prisma-airs/desktop-contracts'
import { MANAGEMENT_FAILURE_TEXT, type ObserveManagement, readManagement } from '../administration/management-read'
import { type Dispatch, outcomeMessage } from './dispatch'

const FAILURE_TEXT: Record<VaultError, string> = {
    locked: 'The Keychain is locked. Unlock it and enter the secret again, or keep it for this session only.',
    denied: 'macOS did not allow access to the Keychain. Enter the secret again, or keep it for this session only.',
    unavailable: 'The credential store is not available. Enter the secret again, or keep it for this session only.',
    notFound: 'The stored client secret is missing. Enter it again.',
    corrupt: 'The stored client secret could not be read. Enter it again.',
}

function status(tenant: TenantView): { tone: 'default' | 'success' | 'danger'; text: string } {
    const { state, mode, failure } = tenant.management
    switch (state) {
        case 'missing':
            return {
                tone: 'default',
                text: 'No management client. Scans do not need one; add one to read this tenant’s inventories in Administration.',
            }
        case 'storing':
            return { tone: 'default', text: 'Saving the management client…' }
        case 'ready':
            return {
                tone: 'success',
                text:
                    mode === 'session'
                        ? 'Management client secret held for this session only.'
                        : 'Management client secret saved in the Keychain.',
            }
        case 'failed':
            return { tone: 'danger', text: failure ? FAILURE_TEXT[failure] : 'The management client could not be saved.' }
    }
}

interface Props {
    tenant: TenantView
    context: ContextRef
    dispatch: Dispatch
    observe: ObserveManagement
}

/**
 * The tenant's separate management OAuth client (C08). It never replaces or
 * reads the scan key. The secret is read from its field at submission and
 * the field is cleared before the request is awaited; it is never held in
 * React state, storage or any snapshot. Verify performs one bounded
 * management read with the stored client.
 */
export function ManagementCredentialForm({ tenant, context, dispatch, observe }: Props) {
    const [mode, setMode] = useState<StorageMode>('keychain')
    const [message, setMessage] = useState<string | null>(null)
    const [verified, setVerified] = useState<string | null>(null)
    const [busy, setBusy] = useState(false)
    const secretRef = useRef<HTMLInputElement>(null)
    const clientRef = useRef<HTMLInputElement>(null)
    const ids = useId()
    const shown = status(tenant)
    const view = tenant.management
    const hasClient = view.state === 'ready' || view.state === 'failed'
    const noTsg = tenant.tsgId === null

    async function submit(event: FormEvent<HTMLFormElement>) {
        event.preventDefault()
        const secretField = secretRef.current
        const clientField = clientRef.current
        if (!secretField || !clientField) return
        const secret = secretField.value
        secretField.value = ''
        const clientId = clientField.value.trim()
        setVerified(null)
        if (clientId.length === 0) {
            setMessage('Enter the client ID.')
            clientField.focus()
            return
        }
        if (secret.length === 0) {
            setMessage('Enter the client secret.')
            secretField.focus()
            return
        }
        setBusy(true)
        setMessage(null)
        const outcome = await dispatch({ kind: 'configureManagementCredential', context, mode, clientId, secret })
        setBusy(false)
        setMessage(outcomeMessage(outcome))
    }

    async function verify() {
        setBusy(true)
        setMessage(null)
        setVerified(null)
        const outcome = await readManagement(dispatch, observe, context, { kind: 'verify' })
        setBusy(false)
        if (outcome.kind === 'notAdmitted') setMessage(outcome.message)
        else if (outcome.result.kind === 'verified') setVerified('The management client can read this tenant.')
        else if (outcome.result.kind === 'failed') setMessage(MANAGEMENT_FAILURE_TEXT[outcome.result.failure])
        else setMessage('The service returned a reply the desktop could not use.')
    }

    async function remove() {
        setBusy(true)
        setMessage(null)
        setVerified(null)
        const outcome = await dispatch({ kind: 'removeManagementCredential', context })
        setBusy(false)
        setMessage(outcomeMessage(outcome))
    }

    return (
        <section aria-labelledby={`${ids}-heading`} data-slot='management-credential' className='flex flex-col gap-3'>
            <h3 id={`${ids}-heading`} className='text-academy-ink text-[14px] font-semibold'>
                Management client
            </h3>
            <Callout
                tone={shown.tone}
                icon={shown.tone === 'success' ? CheckCircle2 : shown.tone === 'danger' ? AlertTriangle : Info}
                role='status'
                aria-live='polite'
                data-slot='management-status'
            >
                {shown.text}
                {view.clientId ? (
                    <span className='text-academy-ink-soft mt-1 block text-[12px]' data-slot='management-client-id'>
                        Client ID: {view.clientId}
                    </span>
                ) : null}
            </Callout>
            {noTsg ? (
                <Callout tone='warning' icon={AlertTriangle} data-slot='management-no-tsg'>
                    This tenant has no TSG ID. Add one to its profile before configuring a management client.
                </Callout>
            ) : null}
            <p className='text-academy-ink-faint text-[12px]' data-slot='management-sso-pointer'>
                Company sign-in (SSO) for the Harness is set up per Gateway workspace, in Harness.
            </p>
            <form onSubmit={(e) => void submit(e)} className='flex flex-col gap-3' aria-busy={busy}>
                <label htmlFor={`${ids}-client`} className='text-academy-ink text-[13px] font-medium'>
                    Client ID
                </label>
                <Input
                    ref={clientRef}
                    id={`${ids}-client`}
                    name='management-client-id'
                    autoComplete='off'
                    autoCapitalize='off'
                    autoCorrect='off'
                    spellCheck={false}
                    defaultValue={view.clientId ?? ''}
                    maxLength={1024}
                    data-slot='management-client-input'
                />
                <label htmlFor={`${ids}-secret`} className='text-academy-ink text-[13px] font-medium'>
                    Client secret
                </label>
                <Input
                    ref={secretRef}
                    id={`${ids}-secret`}
                    name='management-secret'
                    type='password'
                    autoComplete='off'
                    autoCapitalize='off'
                    autoCorrect='off'
                    spellCheck={false}
                    aria-describedby={`${ids}-hint`}
                    data-slot='management-secret-input'
                />
                <p id={`${ids}-hint`} className='text-academy-ink-faint text-[12px]'>
                    The secret is sent only to {view.tokenOrigin ?? 'the Palo Alto Networks token service'} to obtain
                    short-lived access tokens. It is separate from the scan key.
                </p>
                <fieldset aria-labelledby={`${ids}-mode`} className='flex flex-col gap-1'>
                    <legend id={`${ids}-mode`} className='text-academy-ink text-[13px] font-medium'>
                        Keep the secret
                    </legend>
                    {(
                        [
                            ['keychain', 'In the Keychain', 'Available after restarting the desktop'],
                            ['session', 'For this session only', 'Forgotten when the desktop quits'],
                        ] as const
                    ).map(([value, label, hint]) => (
                        <label key={value} className='flex min-h-11 cursor-pointer items-center gap-3'>
                            <input
                                type='radio'
                                name='management-mode'
                                value={value}
                                checked={mode === value}
                                onChange={() => setMode(value)}
                                className='size-4 accent-[var(--academy-accent)]'
                            />
                            <span className='flex flex-col'>
                                <span className='text-academy-ink text-[13px]'>{label}</span>
                                <span className='text-academy-ink-faint text-[12px]'>{hint}</span>
                            </span>
                        </label>
                    ))}
                </fieldset>
                <div className='flex flex-wrap gap-2'>
                    <Button type='submit' tier='primary' disabled={busy || noTsg}>
                        {hasClient ? 'Replace client' : 'Save client'}
                    </Button>
                    {view.state === 'ready' ? (
                        <Button type='button' tier='secondary' disabled={busy} onClick={() => void verify()}>
                            Verify
                        </Button>
                    ) : null}
                    {hasClient ? (
                        <Button type='button' tier='secondary' disabled={busy} onClick={() => void remove()}>
                            Remove management client
                        </Button>
                    ) : null}
                </div>
                {verified ? (
                    <p role='status' data-slot='management-verified' className='text-academy-ink text-[13px]'>
                        {verified}
                    </p>
                ) : null}
                {message ? (
                    <p role='alert' data-slot='management-message' className='text-academy-accent-warn text-[13px]'>
                        {message}
                    </p>
                ) : null}
            </form>
        </section>
    )
}
# Behavioral and native test catalogue

These are required future tests and observable assertions, not results already
executed. G01/C01 bind them to exact commands. Each chunk names its applicable
IDs and adds feature-specific cases. Use fake transports/clocks/stores at real
module interfaces plus literal external fixtures; native and live tests provide
separate evidence. Do not assert implementation-private structure for its own sake.

## Core authority and SDK

- **T01 Context isolation:** tenant/workspace/credential switch during a request
  rejects old replies, retires pending reviews/one-time secrets, and cancels work.
  Switching back cannot revive authority. Credential replacement and sign-out
  behave the same way; duplicate completions settle at most once.
- **T02 Review authority:** forged/stale/replayed/consumed review IDs, changed
  draft/resource/context, model text, and imported history cannot Apply. Valid
  operator Apply transmits the exact reviewed operation once.
- **T03 Unknown outcomes:** disconnect before send, after send, timeout, cancel,
  401/403/429/5xx, and partial multistep provisioning yield correct states. No
  automatic mutation/scan replay; offer readback/review/explicit retry where valid.
- **T04 SDK external contract:** independently authored request/response fixtures
  verify method/path/body/headers/options, pagination/multipart limits, unknown
  enum/action preservation, sanitized errors, and no dropped options.
- **T05 Credential confinement:** scan-only setup works; management/inference/MCP
  credentials are separate. Deny wrong-origin redirects or custom endpoint
  changes that would forward a credential without an explicitly reviewed new
  destination binding. Preserve legitimate operator-reviewed endpoint overrides
  and explicitly selected nonsecret tenant-profile import; whitelist metadata,
  discard embedded secrets and never follow credential-file references.
  No implicit environment/tenant file
  loading, upstream fallback, persistent renderer storage, or secret log fields.
- **T06 Protected storage:** locked/denied/unavailable/corrupt store, interrupted
  write/reset, session-only mode, restart, explicit one-time reveal/clipboard,
  and cleanup. No plaintext fallback; v1 namespaces remain untouched.
- **T07 Lifecycle:** bounded concurrent work, cancellation, queue backpressure,
  superseding reads, app close/restart, sleep/wake, expired credentials, and
  monotonic versus wall-clock decisions. UI remains responsive during work.

## Presentation and Academy

- **T08 Shared presentation:** web and desktop consumers build from the same
  reviewed shared source; themes/fonts/routes render correctly. General desktop
  screens mount no Academy gamification/account effects or web manager routes.
- **T09 Native UI:** actual Tauri command path, menus/shortcuts, keyboard-only
  workflow, focus restoration, VoiceOver labels/order, zoom/large text, themes,
  reduced motion, long/empty/error content, and window resizing. Mock IPC tests
  alone cannot establish these. macOS WebDriver availability must be verified;
  use supported native accessibility/automation or recorded manual steps.
- **T10 Academy identity:** device grant, pending/slow_down/expiry/cancel, refresh,
  revocation, wrong issuer/client/scope, account switch/sign-out, and stale replies.
  Token management stays Rust-owned. The learner account is independent of tenant.
- **T11 Learning authority:** client bundles contain no answer keys/private lab
  evaluation, privileged routes, or assessor tokens. Forged verdict/award/local
  exam clock cannot pass; the hosted backend decides access, grading, and awards.
  Signed-in denial differs from guest sign-in; sandbox never uses tenant secrets.
- **T12 Offline work:** download lease/revision/account access, encrypted draft
  save/restart, locked vault, sign-out/account switch, withdrawn content, duplicate
  submission IDs, changed draft versions, and reconnection. No deferred action
  replay. Valid local work remains usable without claiming offline grading.

  cookies/redirect auth, cancellation, history/download, Git/profile adoption,
  and recovery from interrupted writes. Arbitrary workbench targets cannot borrow
  privileged application credentials through renderer-supplied references.
- **T15 Harness process:** actual native binary and bounded bootstrap/JSONL
  protocol, malformed/oversized frames, correlation/duplicates, queue pressure,
  crash/EOF/cancel, context change, graceful/forced cleanup, and missing/tampered
  resources. No PATH launcher fallback or plaintext rollout/history.
- **T16 Harness authority:** typed investigation/proposal tools, active-draft
  protection, no engine Apply, one-time secrets absent from model context,
  read-only project defaults, approved single-process command restrictions,
  forbidden descendants/pipelines, stale decisions, and history replay.
- **T17 Inference/MCP identity:** pinned Gateway origin; SSO PKCE/state/nonce/
  issuer/client/audience/time/signature/JWKS/algorithm/key-rotation validation;
  sleep/refresh/revoke/identity changes;
  distinct inference/MCP grants; fixed conversation server scope; exact call-item
  approvals; changed revision/grant; denied tools; trace/execution evidence.
  No direct upstream provider fallback or global cross-workspace MCP authority.

## Import, quality, and artifacts

- **T18 Import transaction:** dry-run selection, versions/source lock, account
  match, protected source reads, malformed/oversized/traversal inputs, interruption
  at each commit point, restart, duplicate import, destination conflict, rollback,
  and source-byte preservation. No credentials/sessions/approvals transfer.
- **T19 Diagnostics privacy:** seeded canary secrets and customer content absent
  from logs/crash files/exports by default; explicit redacted export; correct
  retention/reset; no analytics/crash upload attempts; encrypted user history
  remains a distinct intentional storage feature.
- **T20 Performance:** named macOS hardware/OS/workloads, cold/warm startup, idle
  and scan/large-list/streaming/Harness memory, main-thread responsiveness, file
  and DMG footprint. Record methodology, repetitions, distribution and baseline;
  set core budgets in C03 and register later workload budgets at the introducing
  chunk's entry before implementation/acceptance measurement. See the budget
