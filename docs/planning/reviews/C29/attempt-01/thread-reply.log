import { render, screen, within } from '@testing-library/react'
import userEvent from '@testing-library/user-event'
import { describe, expect, it, vi } from 'vitest'
import { Wizard } from './wizard'
import type { Dispatch } from '../../features/tenants/dispatch'
import { fxAddTenant, fxOn, type WizardBoard } from './fixtures'

function mount(board: WizardBoard) {
    const dispatch = vi.fn<Dispatch>(async () => ({ kind: 'admitted', operation: null }))
    const onClose = vi.fn()
    render(<Wizard snapshot={board.snapshot} dispatch={dispatch} observeManagement={async () => ({ kind: 'verified' as const })} mode={board.mode} onClose={onClose} onNavigate={() => undefined} initial={board.initial} />)
    return { dispatch, onClose }
}
const current = () => screen.getByRole('navigation', { name: 'Setup steps' }).querySelector('[aria-current="step"]')?.textContent

describe('R2Onboard boards', () => {
    it('R2On01 welcome: three cards and the API-builder framing, no shell', () => {
        mount(fxOn.welcome())
        expect(screen.getByRole('heading', { level: 1, name: 'Built on the public APIs' })).toBeInTheDocument()
        expect(within(screen.getByRole('main')).getAllByRole('listitem')).toHaveLength(3)
        expect(screen.queryByRole('navigation', { name: 'Destinations' })).toBeNull()
    })
    it('R2On02 tenant empty: nothing created, Continue disabled, no context line', () => {
        mount(fxOn.tenantEmpty())
        expect(current()).toBe('2Tenant')
        expect(screen.getByRole('button', { name: 'Create tenant' })).toBeEnabled()
        expect(screen.queryByRole('button', { name: 'Continue' })).toBeNull()
        expect(screen.queryByLabelText('Scan API key', { selector: 'input' })).toBeNull()
        expect(document.querySelector('[data-slot="rail-context"]')).toBeNull()
    })
    it('R2On02b tenant filled: the context line and Continue enabled once the key is saved', () => {
        mount(fxOn.tenantFilled())
        expect(document.querySelector('[data-slot="rail-context"]')).toHaveTextContent('Northwind Health · Europe · TSG 1762204418')
        expect(screen.getByRole('button', { name: 'Continue' })).toBeEnabled()
    })
    it('R2On03 products: AIS and AES are not selectable', () => {
        mount(fxOn.products())
        expect(screen.getAllByRole('checkbox').map((b) => (b as HTMLInputElement).disabled)).toEqual([false, false, false, false, true, true])
        expect(screen.getByRole('checkbox', { name: /AI Gateway/ })).toBeChecked()
    })
    it('R2On04 verify running: the list is busy and Continue waits', () => {
        mount(fxOn.verifyRunning())
        expect(screen.getByRole('list', { name: 'Checks' })).toHaveAttribute('aria-busy', 'true')
        expect(screen.getByRole('button', { name: 'Continue' })).toBeDisabled()
        expect(within(document.querySelector('[data-slot="verify-management"]') as HTMLElement).getByText('Pending')).toBeInTheDocument()
    })
    it('R2On04b verify warning: Continue with warnings is offered and the warning travels into finishTenantSetup', async () => {
        const user = userEvent.setup()
        const { dispatch } = mount(fxOn.verifyWarn())
        expect(screen.getByText('Checks finished with warnings.')).toBeInTheDocument()
        await user.click(screen.getByRole('button', { name: 'Continue with warnings' }))
        await user.click(screen.getByRole('button', { name: 'Skip' }))
        await user.click(screen.getByRole('button', { name: 'Skip for now' }))
        await user.click(screen.getByRole('button', { name: 'Open Prisma AIRS' }))
        expect(dispatch).toHaveBeenCalledWith({ kind: 'finishTenantSetup', tenant: 'tn-0123456789abcdef', products: ['runtimeSecurity', 'gateway'], warnings: [{ product: 'runtimeSecurity', reason: 'No management client: Administration stays read-only.' }] })
    })
    it('R2On04c verify fail: Continue is disabled; Fix and verify again returns to Tenant and the next verify starts clean', async () => {
        const user = userEvent.setup()
        mount(fxOn.verifyFail())
        expect(screen.getByText('A check failed.')).toBeInTheDocument()
        expect(screen.getByRole('button', { name: 'Continue' })).toBeDisabled()
        await user.click(screen.getByRole('button', { name: 'Fix and verify again' }))
        expect(screen.getByRole('heading', { level: 1, name: 'Your tenant' })).toHaveFocus()
        await user.click(within(screen.getByRole('navigation', { name: 'Setup steps' })).getByRole('button', { name: /Verify$/ }))
        expect(screen.getByRole('button', { name: 'Run the checks' })).toBeInTheDocument()
        expect(screen.queryByText('A check failed.')).toBeNull()
    })
    it('R2On05 packs: optional, Skip is the primary until imported', () => {
        mount(fxOn.packs())
        expect(screen.getByRole('button', { name: 'Import the bundled examples' })).toBeEnabled()
        expect(screen.getByRole('button', { name: 'Skip' })).toBeEnabled()
    })
    it('R2On06 academy: hosted sign-in or skip, with the sync disclosure', () => {
        mount(fxOn.academy())
        expect(screen.getByRole('button', { name: 'Sign in to the Academy' })).toBeInTheDocument()
        expect(screen.getByRole('button', { name: 'Skip for now' })).toBeInTheDocument()
        expect(screen.getByText(/syncs your Academy progress only/)).toBeInTheDocument()
    })
    it('R2On07 done: the summary and a finite Open Prisma AIRS', () => {
        mount(fxOn.done())
        expect(screen.getByRole('heading', { level: 1, name: 'Ready' })).toBeInTheDocument()
        expect(screen.getByText(/^Northwind Health is set up\./)).toBeInTheDocument()
        expect(screen.getByRole('button', { name: 'Open Prisma AIRS' })).toBeEnabled()
    })
    it('R2AddTenant: no Welcome or Academy step, a 244px rail and Cancel on every step', () => {
        mount(fxAddTenant())
        const rail = screen.getByRole('navigation', { name: 'Setup steps' })
        expect(within(rail).getAllByRole('button').map((b) => b.textContent)).toEqual(['1Tenant', '2Products', '3Verify', '4Starter cases', '5Done', 'Cancel'])
        expect(rail).toHaveStyle({ width: '244px' })
        expect(screen.getByText(/Cancelling keeps a tenant and credential you already saved/)).toBeInTheDocument()
    })
})

