+    pub(super) fn queue_examples(
+        &mut self,
+        tenant: &TenantId,
+        products: &[CaseProduct],
+    ) -> (Option<u64>, Option<(TenantId, u64)>) {
+        let Ok(cases) =
+            crate::library::parse_catalog(crate::library::BUNDLED_CATALOG, tenant.as_str())
+        else {
