const CLIENT_SKIPPED: VerifyStep = { line: 'managementClient', product: 'runtimeSecurity', state: 'skipped', reason: 'No management client; Administration stays read-only.' }

export function verifyView(steps: VerifyStep[], over: Partial<VerifyView> = {}): VerifyView {
    const done = steps.every((s) => s.state !== 'pending')
    return { generation: 1, steps, done, failed: steps.some((s) => s.state === 'fail'), stale: false, warnings: steps.filter((s) => s.state === 'warning').map((s) => ({ product: s.product, reason: s.reason })), ...over }
}

export function setupView(over: Partial<SetupView> = {}): SetupView {
    const verify = over.verify ?? null
    return {
        mode: 'firstRun',
        context: DRAFT_CONTEXT,
        tenant: keyed(),
        products: ['runtimeSecurity'],
        scanRequired: true,
        packs: [{ product: 'runtimeSecurity', count: 6 }],
        workspace: null,
        verify,
        completable: Boolean(verify && verify.done && !verify.failed && !verify.stale),
        ...over,
    }
}

