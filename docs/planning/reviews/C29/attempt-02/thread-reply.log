                // Its identity was issued at review: present only when an
                // earlier attempt's tenant was kept.
                if s.tenant(&id).is_some() {
                    return Ok(false);
                }
                if s.data.tenants.len() >= super::super::MAX_TENANTS {
                    return Err(fail(Problem::DestinationFull));
                }
                Ok(true)
