                    Some(ScanPayload::Result(view)) => (Some((**view).clone()), None),
                    Some(ScanPayload::Failure(failure)) => (None, Some(*failure)),
                    None => (None, None),
                };
                ScanRecordView {
                    operation: r.operation.clone(),
                    progress,
                    outcome,
                    stop,
                    result,
                    failure,
                    discarded: r.discarded,
                }
            })
