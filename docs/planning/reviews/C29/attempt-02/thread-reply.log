    };
    if let Some(cases) = open {
        return Ok(cases);
    }
    let root = root.ok_or(Problem::NoV2Equivalent)?;
    let worker = Arc::clone(inner);
    let tenant = tenant.as_str().to_owned();
    blocking(Err(Problem::AccessDenied), move || {
