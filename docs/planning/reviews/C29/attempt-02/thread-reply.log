fn setup_draft_intents_cross_ipc_without_echoing_secrets_or_creating_tenants() {
    let h = harness();
    let session = register(&h);
    let begun = send(
        &h,
        &session,
        1,
        json!({"kind": "beginTenantSetup", "mode": "add", "profile": {
        "label": "Drafted", "tsgId": "1234567890", "destination": {"kind": "region", "region": "europe"},
        "environment": "staging"}}),
    );
    assert_eq!(begun.expect("begun")["outcome"], "receipt");
    let snap = snapshot(&h, 20);
    assert_eq!(
        snap["tenants"].as_array().map(Vec::len),
        Some(0),
        "a draft is not a tenant"
    );
    assert!(snap["active"].is_null());
    let setup = &snap["setup"];
    assert_eq!(setup["mode"], "add");
    assert_eq!(setup["tenant"]["environment"], "staging");
    assert_eq!(setup["scanRequired"], false);
    let context = setup["context"].as_str().expect("draft context").to_owned();
    let key = "synthetic-ipc-draft-scan-key-0042";
    let secret = "synthetic-ipc-draft-client-secret-0042";
    let stored = send(
        &h,
        &session,
        2,
        json!({"kind": "configureScanCredential", "context": context, "mode": "session", "key": key}),
    )
    .expect("admitted");
    assert_eq!(stored["outcome"], "receipt");
    assert!(!stored.to_string().contains(key));
    let client = send(
        &h,
        &session,
        3,
        json!({"kind": "configureManagementCredential", "context": context, "mode": "session",
        "clientId": "svc@1234567890.iam.example", "secret": secret}),
    )
    .expect("admitted");
    assert!(!client.to_string().contains(secret));
    assert!(eventually(|| {
        let s = snapshot(&h, 21);
        s["setup"]["tenant"]["scan"]["state"] == "ready"
            && s["setup"]["tenant"]["management"]["state"] == "ready"
    }));
    let snap = snapshot(&h, 22);
    let text = snap.to_string();
    assert!(
        !text.contains(key) && !text.contains(secret),
        "no snapshot carries a secret"
    );
    assert_eq!(
        snap["setup"]["tenant"]["management"]["clientId"],
        "svc@1234567890.iam.example"
    );
    assert_eq!(
        snap["tenants"].as_array().map(Vec::len),
        Some(0),
        "still not a tenant"
    );
    assert!(
        h.adapters.vault.calls().is_empty(),
        "session-only never reaches the Keychain"
    );
    // Verification runs in the core: the stored key is reported stored, never passed.
    let verified = send(
        &h,
        &session,
        4,
        json!({"kind": "verifyTenantSetup", "context": context}),
    )
    .expect("verify");
    assert_eq!(verified["outcome"], "receipt");
    assert!(eventually(
        || snapshot(&h, 23)["setup"]["verify"]["done"] == true
    ));
    let steps = snapshot(&h, 24)["setup"]["verify"]["steps"].clone();
    assert_eq!(steps[0]["line"], "scanKey");
    assert_eq!(steps[0]["state"], "stored");
    let discarded = send(
        &h,
        &session,
        5,
        json!({"kind": "discardTenantSetup", "context": context}),
    )
    .expect("discard");
    assert_eq!(discarded["outcome"], "receipt");
    let snap = snapshot(&h, 25);
    assert!(snap["setup"].is_null());
    assert_eq!(snap["tenants"].as_array().map(Vec::len), Some(0));
    let stale = send(
        &h,
        &session,
        6,
        json!({"kind": "verifyTenantSetup", "context": context}),
    );
    assert_eq!(
        stale.expect("refusal"),
        json!({"outcome": "refusal", "refusal": "staleContext"})
    );
}
    /// Starts reading the public catalog; returns the lease and its URL.
    /// Imports the bundled examples of `products` into `tenant`'s library
    /// (C29 starter packs). An open library takes them now (returns the
    /// write); otherwise they wait for the load this starts (returns its
    /// lease) and are merged when it settles.
    pub(super) fn queue_examples(
        &mut self,
        tenant: &TenantId,
        products: &[CaseProduct],
    ) -> (Option<u64>, Option<(TenantId, u64)>) {
        let Ok(cases) =
            crate::library::parse_catalog(crate::library::BUNDLED_CATALOG, tenant.as_str())
        else {
            return (None, None);
        };
        let cases: Vec<TestCase> = cases
            .into_iter()
            .filter(|c| products.contains(&c.product))
            .collect();
        if cases.is_empty() || self.library_root.is_none() {
            return (None, None);
        }
        if self
            .libraries
            .iter()
            .any(|l| &l.tenant == tenant && l.state == LibraryState::Ready)
        {
            let write = self.add_examples(tenant, Ok(cases)).ok();
            return (None, write);
        }
        let added = cases.len() as u32;
        let lease = self.start_library(tenant);
        if let Some(library) = self.libraries.iter_mut().find(|l| &l.tenant == tenant) {
            for case in cases {
                library.pending.push(Pending {
                    case,
                    origin: tenant.clone(),
                    notice: LibraryNotice::ExamplesAdded { added },
                    stamp: library.status,
                });
            }
        }
        (lease, None)
    }

    pub(super) fn begin_catalog(
//! Tenant profiles: nonsecret identity and approved scan destination.
//!
//! A tenant profile carries a native-issued ID, an operator label, an optional
//! TSG identifier and the HTTPS origin its scan credential may be sent to. It
//! never carries a secret; credentials are separate records bound to the
//! profile's approved destination (see `vault`).

use serde::{Deserialize, Serialize};
use ts_rs::TS;

/// Longest operator label, in characters.
pub const MAX_LABEL_CHARS: usize = 64;
/// Longest TSG identifier, in digits.
pub const MAX_TSG_DIGITS: usize = 32;
/// Longest custom origin, in bytes.
pub const MAX_ORIGIN_BYTES: usize = 2048;

/// Native-issued tenant identifier (`tn-` + 16 hex digits). Deserialization
/// accepts only that shape, so arbitrary text is never treated as an ID.
#[derive(Clone, Debug, PartialEq, Eq, PartialOrd, Ord, Hash, Serialize, TS)]
#[serde(transparent)]
pub struct TenantId(String);

impl<'de> Deserialize<'de> for TenantId {
    fn deserialize<D: serde::Deserializer<'de>>(deserializer: D) -> Result<Self, D::Error> {
        let text = String::deserialize(deserializer)?;
        Self::parse(&text).ok_or_else(|| serde::de::Error::custom("not a tenant id"))
    }
}

impl TenantId {
    pub(crate) fn issue() -> Option<Self> {
        let mut entropy = [0u8; 8];
        getrandom::fill(&mut entropy).ok()?;
        Some(Self(format!("tn-{}", hex::encode(entropy))))
    }

    /// Accepts only the native-issued shape; other text is never an ID.
    pub fn parse(text: &str) -> Option<Self> {
        let hex_part = text.strip_prefix("tn-")?;
        (hex_part.len() == 16
            && hex_part
                .bytes()
                .all(|b| matches!(b, b'0'..=b'9' | b'a'..=b'f')))
        .then(|| Self(text.to_owned()))
    }

    pub fn as_str(&self) -> &str {
        &self.0
    }
}

/// AIRS scan regions offered by the SDK (`scm_sdk` `Region::endpoint`).
#[derive(Clone, Copy, Debug, PartialEq, Eq, Serialize, Deserialize, TS)]
#[serde(rename_all = "camelCase")]
pub enum Region {
    UnitedStates,
    Europe,
    India,
    Singapore,
}

impl Region {
    pub fn origin(self) -> &'static str {
        match self {
            Region::UnitedStates => "https://service.api.aisecurity.paloaltonetworks.com",
            Region::Europe => "https://service-de.api.aisecurity.paloaltonetworks.com",
            Region::India => "https://service-in.api.aisecurity.paloaltonetworks.com",
            Region::Singapore => "https://service-sg.api.aisecurity.paloaltonetworks.com",
        }
    }
}

/// Where a tenant's scan requests (and therefore its scan key) may go.
#[derive(Clone, Debug, PartialEq, Eq, Serialize, Deserialize, TS)]
#[serde(tag = "kind", rename_all = "camelCase", deny_unknown_fields)]
pub enum Destination {
    Region {
        region: Region,
    },
    /// An operator-reviewed custom HTTPS origin (`https://host[:port]`).
    Custom {
        origin: String,
    },
}

impl Destination {
    /// The exact origin credentials are bound to.
    pub fn origin(&self) -> &str {
        match self {
            Destination::Region { region } => region.origin(),
            Destination::Custom { origin } => origin,
        }
    }

    /// Validates a draft and normalizes a custom origin to its ASCII origin.
    pub fn validate(self) -> Option<Self> {
        match self {
            Destination::Region { .. } => Some(self),
            Destination::Custom { origin } => {
                normalize_origin(&origin).map(|origin| Destination::Custom { origin })
            }
        }
    }
}

/// HTTPS origin only: host required; no userinfo, path, query or fragment.
pub fn normalize_origin(text: &str) -> Option<String> {
    if text.is_empty() || text.len() > MAX_ORIGIN_BYTES || text.trim() != text {
        return None;
    }
    let url = url::Url::parse(text).ok()?;
    let plain = url.scheme() == "https"
        && url.host_str().is_some_and(|h| !h.is_empty())
        && url.username().is_empty()
        && url.password().is_none()
        && url.query().is_none()
        && url.fragment().is_none()
        && (url.path().is_empty() || url.path() == "/");
    if !plain {
        return None;
    }
    let origin = url.origin().ascii_serialization();
    origin.starts_with("https://").then_some(origin)
}

