{"type":"item.completed","item":{"id":"item_65","type":"command_execution","command":"/bin/zsh -lc \"cat tools/native-acceptance/test_live_c29_l19.py; sed -n '1,140p' apps/desktop/src/v2/wizard/copy.ts\"","aggregated_output":"\"\"\"Offline regressions for live-driver admission; never resolve credentials.\"\"\"\nimport json\nfrom pathlib import Path\nimport sys\nimport tempfile\nimport unittest\n\nsys.path.insert(0, str(Path(__file__).resolve().parent))\nimport live_c29_l19 as driver\n\n\nclass Settlement(unittest.TestCase):\n    def test_the_actual_pending_tree_is_not_a_finished_verification(self):\n        root = Path(__file__).resolve().parents[2]\n        pending = json.loads((root / 'docs/planning/evidence/C29/live/L19/attempt-01/wizard-verify.json').read_text())\n        self.assertTrue(any(n.get('label') == 'Pending' for n in pending))\n        self.assertFalse(driver.verify_finished(pending))\n\n    def test_terminal_success_and_failure_are_finished_but_reading_is_not(self):\n        for label in ['Checks finished; nothing failed.', 'Checks finished with warnings.', 'A required check failed.', 'An optional check failed. You can fix it and verify again, or continue with it recorded as a warning.']:\n            tree = [{'role': 'AXStaticText', 'label': label}]\n            self.assertTrue(driver.verify_finished(tree))\n            self.assertFalse(driver.verify_finished(tree + [{'role': 'AXStaticText', 'label': 'Checking…'}]))\n\n\nclass Budget(unittest.TestCase):\n    def test_interrupted_first_attempt_stays_charged_and_a_third_is_refused(self):\n        with tempfile.TemporaryDirectory() as directory:\n            path = Path(directory) / 'ledger.jsonl'\n            self.assertEqual(driver.reserve_read(path, 'scope', 'attempt-01', 2), 1)\n            self.assertEqual(driver.reserve_read(path, 'scope', 'attempt-02', 2), 2)\n            before = path.read_bytes()\n            with self.assertRaises(AssertionError):\n                driver.reserve_read(path, 'scope', 'attempt-03', 2)\n            self.assertEqual(path.read_bytes(), before)\n\n    def test_duplicate_attempt_changed_scope_and_one_read_cap_refuse(self):\n        with tempfile.TemporaryDirectory() as directory:\n            path = Path(directory) / 'ledger.jsonl'\n            driver.reserve_read(path, 'scope', 'attempt-01', 1)\n            for scope, attempt, limit in [('scope', 'attempt-01', 2), ('other', 'attempt-02', 2), ('scope', 'attempt-02', 1)]:\n                with self.assertRaises(AssertionError):\n                    driver.reserve_read(path, scope, attempt, limit)\n\n\nif __name__ == '__main__':\n    unittest.main()\n/** Every string the first-run wizard and the add-tenant sheet show (screens/wizard.md). */\nexport const WIZARD_COPY = {\n    railTitle: 'Prisma AIRS',\n    railSub: 'Setup · about 5 minutes',\n    required: 'Required',\n    optional: 'Optional',\n    skipped: 'Skipped',\n    privacy: 'Secrets go straight to the macOS Keychain. Tenant calls go only to your own tenant. Joining the Academy is optional and sends your account details and progress to Academy.',\n    themeLight: 'Light appearance',\n    themeDark: 'Dark appearance',\n    progress: (n: number, of: number) => `Step ${n} of ${of}`,\n    railTitleAdd: 'Add a tenant',\n    railSubAdd: 'About 3 minutes',\n    steps: {\n        welcome: 'Welcome',\n        tenant: 'Tenant',\n        products: 'Products',\n        verify: 'Verify',\n        packs: 'Starter cases',\n        academy: 'Academy',\n        done: 'Done',\n    },\n    welcome: {\n        title: 'Welcome to Prisma AIRS Desktop',\n        lead: 'This app is built entirely on Palo Alto Networks’ own public APIs: the same programmatic interfaces any application builder can use. Everything you will see here, from reading a tenant’s security posture to scanning a prompt, is an API call you could make yourself. It exists to show how much those interfaces make possible.',\n        lead2: 'We will walk you through it: connect a tenant with the credentials an integration would use, pick the products you manage, check the connection, and optionally load starter test cases. It takes about five minutes, and you can change everything later.',\n        cards: [\n            { icon: 'key' as const, title: 'Built on the public APIs', body: 'Nothing here uses a private interface. What the app reads and changes, your own code can read and change.' },\n            { icon: 'eye' as const, title: 'See the calls as you go', body: 'With “Show the calls” on, each request the app sends is shown as it happens, with its response.' },\n            { icon: 'cap' as const, title: 'Learn by doing', body: 'Scan a prompt, read a tenant, review a change. The Academy explains the why; this app shows the how.' },\n        ],\n        continue: 'Set up a tenant',\n    },\n    tenant: {\n        title: 'Connect your tenant',\n        lead: 'This becomes a managed tenant. The credentials are the same ones any integration uses with the Palo Alto Networks APIs: the scan key is all that is needed to start; the management client is optional and unlocks Administration. Nothing becomes a tenant until the last step.',\n        card: 'Tenant',\n        environmentHint: 'Production tenants ask for confirmation before every change.',\n        regionHint: \"Where the tenant's data lives. Matches the Strata Cloud Manager region.\",\n        whereFind: 'Where do I find these?',\n        whereSteps: ['In Strata Cloud Manager, open Identity & Access › Service accounts.', 'Create a service account with the roles for the products you will manage.', 'Copy the client ID and the secret shown once. The secret is stored in your Keychain here and never shown again.'],\n        name: 'Display name',\n        nameHint: 'How this tenant appears in the switcher.',\n        environment: 'Environment',\n        region: 'Region',\n        tsg: 'TSG ID',\n        tsgHint: 'The 10-digit tenant service group ID.',\n        create: 'Create tenant',\n        save: 'Save changes',\n        created: (name: string) => `${name} is drafted. Add its scan key below.`,\n        updated: 'Tenant details saved.',\n        updateHint: 'Changing the region or TSG retires the credentials saved for the old one; enter them again.',\n        scanKey: 'Scan API key',\n        scanHint: 'Sent once to the desktop and kept in the Keychain; never shown again.',\n        scanRequired: 'Required on first run.',\n        scanOptional: 'Optional here; without it scans stay unavailable until a key is added in Administration.',\n        saveKey: 'Save scan key',\n        replaceKey: 'Replace scan key',\n        removeKey: 'Remove scan key',\n        keySaved: 'Scan key saved in the Keychain.',\n        keyRemoved: 'Scan key removed.',\n        management: 'Management credentials · OAuth 2.0',\n        managementHint: 'Unlocks Administration: reading and reviewing changes. Without it the app reads nothing but scans.',\n        clientId: 'Client ID',\n        clientSecret: 'Client secret',\n        saveClient: 'Save management client',\n        replaceClient: 'Replace management client',\n        removeClient: 'Remove management client',\n        clientSaved: 'Management client saved.',\n        clientRemoved: 'Management client removed.',\n        gateway: 'AI Gateway workspace',\n        gatewayHint: 'Choose a workspace and save its inference key now, or later in Administration › AI Gateway.',\n        gatewayOn: 'Set up an AI Gateway workspace now',\n        gatewayNeedsClient: 'Save the management client first: workspaces are read through it.',\n        readWorkspaces: 'Read workspaces',\n        readingWorkspaces: 'Reading workspaces…',\n        workspace: 'Workspace',\n        noWorkspaces: 'No workspace was readable in this tenant.',\n        chooseWorkspace: 'Use this workspace',\n        workspaceChosen: (name: string) => `Workspace ${name} chosen.`,\n        endpoint: 'Inference endpoint',\n        endpointHint: 'The https address the workspace key is sent to.',\n        workspaceKey: 'Workspace inference key',\n        saveWorkspaceKey: 'Save workspace key',\n        workspaceKeySaved: 'Workspace key saved in the Keychain.',\n        continue: 'Continue',\n        continueNeedsDraft: 'Create the tenant to continue',\n        continueNeedsKey: 'Save the scan key to continue',\n        continueDirty: 'Save or revert the changes to continue',\n        revert: 'Revert changes',\n        state: {\n            missing: 'Not saved',\n            storing: 'Saving…',\n            ready: 'Saved',\n            failed: 'Could not be saved',\n        },\n        errors: {\n            name: 'Enter a display name.',\n            tsg: 'The TSG ID is exactly 10 digits.',\n            scanKey: 'Paste the scan API key.',\n            clientId: 'Enter the client ID.',\n            clientSecret: 'Paste the client secret.',\n            endpoint: 'Enter an https endpoint.',\n            workspaceKey: 'Paste the workspace key.',\n        },\n    },\n    products: {\n        title: 'Which products will you manage?',\n        lead: (name: string) => `Pick the ones ${name} uses. They appear in Home, Inbox and Administration; nothing is read until you ask. Runtime Security is always on: the scan key is what a tenant starts with.`,\n        noScan: 'AI Runtime Security works without a scan API key, but the Playground and test runs need one.',\n        addScanKey: 'Add a scan key',\n        unavailable: 'Not available in this release',\n        readOnly: 'Read-only',\n        always: 'Always on',\n        licence: 'Licence state is not readable through the public APIs; the verify step shows what each product can reach.',\n        readsWith: {\n            scanReady: 'Scan key saved',\n            scanMissing: 'No scan key yet',\n            clientReady: 'Reads through the management client',\n            clientMissing: 'Needs the management client',\n        },\n        continue: 'Continue',\n    },\n    verify: {\n        title: 'Check the connection',\n        lead: (name: string) => `We save the credentials, get a token and confirm each product you picked, using only read calls. Nothing in ${name} is changed. Each line is decided by the desktop core: a stored key is reported as stored, never as checked, and every read is an admitted API call.`,\n        notRunTitle: 'Not checked yet',\n        notRunText: 'Run the checks when the credentials are saved. Each one is a public API call you could make from your own code.',\n        runningText: 'Reading with the saved credentials; nothing is changed.',\n        staleText: 'The inputs changed since this run.',\n        failedText: 'A required check failed. Edit the credentials and verify again.',\n        failedOptionalText: 'Fix it and verify again, or continue with it recorded as a warning.',\n        doneText: 'Every line was decided by the desktop core against your tenant.',\n        editCredentials: 'Edit credentials',\n        run: 'Run the checks',\n        running: 'Checking…',\n        again: 'Verify again',\n        notRun: 'Not run yet',\n        rows: {\n            scanKey: 'Runtime Security scan key',\n","exit_code":0,"status":"completed"}}
