{"type":"item.completed","item":{"id":"item_33","type":"command_execution","command":"/bin/zsh -lc \"rg -n 'guard_switch|guard_setup|switch_blocked|pending_decision|setup_context' crates/desktop-core/src/authority/inbox_domain.rs crates/desktop-core/src/authority.rs | tail -100; sed -n '620,850p' crates/desktop-core/src/authority/inbox_domain.rs; sed -n '1,190p' crates/desktop-core/tests/ui_v2_onboarding/main.rs\"","aggregated_output":"crates/desktop-core/src/authority/inbox_domain.rs:344:    pub(super) fn pending_decision(&self) -> Option<PendingDecisionRef> {\ncrates/desktop-core/src/authority/inbox_domain.rs:356:    pub(super) fn guard_switch(\ncrates/desktop-core/src/authority/inbox_domain.rs:369:            let blocked = self.switch_blocked.as_ref().ok_or(Refusal::StaleContext)?;\ncrates/desktop-core/src/authority/inbox_domain.rs:375:                || Some(&blocked.pending) != self.pending_decision().as_ref()\ncrates/desktop-core/src/authority/inbox_domain.rs:384:            self.switch_blocked = None;\ncrates/desktop-core/src/authority/inbox_domain.rs:387:        let Some(pending) = self.pending_decision() else {\ncrates/desktop-core/src/authority/inbox_domain.rs:388:            self.switch_blocked = None;\ncrates/desktop-core/src/authority/inbox_domain.rs:391:        self.switch_blocked = Some(SwitchBlocked {\ncrates/desktop-core/src/authority.rs:1041:    /// operator's resolution (I1); the snapshot's `switch_blocked` says which.\ncrates/desktop-core/src/authority.rs:1247:    pub switch_blocked: Option<SwitchBlocked>,\ncrates/desktop-core/src/authority.rs:1793:    switch_blocked: Option<SwitchBlocked>,\ncrates/desktop-core/src/authority.rs:1920:            switch_blocked: self.switch_blocked.clone(),\ncrates/desktop-core/src/authority.rs:2163:        if self.switch_blocked.as_ref().is_some_and(|guard| {\ncrates/desktop-core/src/authority.rs:2165:                || self.pending_decision().as_ref() != Some(&guard.pending)\ncrates/desktop-core/src/authority.rs:2170:            self.switch_blocked = None;\ncrates/desktop-core/src/authority.rs:2180:        self.switch_blocked = None;\ncrates/desktop-core/src/authority.rs:2909:            switch_blocked: None,\ncrates/desktop-core/src/authority.rs:3751:            if let Err(refusal) = state.guard_switch(&draft, resolution, Some(&context)) {\ncrates/desktop-core/src/authority.rs:3833:            if let Err(refusal) = state.guard_switch(&tenant, resolution, None) {\ncrates/desktop-core/src/authority.rs:3849:            state.switch_blocked = None;\ncrates/desktop-core/src/authority.rs:5841:        state.reissue_setup_context();\ncrates/desktop-core/src/authority.rs:5920:        state.reissue_setup_context();\n                ProductId::RedTeam | ProductId::ModelSkill => {\n                    let (outcome, failed) = record.map_or((None, None), |r| match product {\n                        ProductId::RedTeam => (r.red_team.as_ref(), r.red_team_failed.as_ref()),\n                        _ => (r.model_skill.as_ref(), r.model_skill_failed.as_ref()),\n                    });\n                    match (outcome, failed) {\n                        (None, None) => pending(product),\n                        // The latest attempt established nothing: reported as\n                        // such, with the retained read (if any) named as older.\n                        (kept, Some(f)) => failed_product(product, f, kept, &mut sources_missing),\n                        (Some(o), None) => product_read(product, o, &mut sources_missing),\n                    }\n                }\n            };\n            per_product.push(entry);\n        }\n        // Once anything was attempted, a chosen product nothing has reached\n        // yet is unread coverage like any other (I4): named, so no completion\n        // is announced as complete over it.\n        if attempted {\n            for entry in per_product\n                .iter()\n                .filter(|p| p.state == ProductReadState::Pending)\n            {\n                sources_missing.extend(source_names(entry.product).iter().map(|n| (*n).to_owned()));\n            }\n        }\n        let last_read_at = read\n            .map(|r| r.read_at)\n            .into_iter()\n            .chain(record.and_then(|r| r.red_team.as_ref()).map(|o| o.read_at))\n            .chain(\n                record\n                    .and_then(|r| r.model_skill.as_ref())\n                    .map(|o| o.read_at),\n            )\n            .max();\n        let settled_at = last_read_at\n            .into_iter()\n            .chain(overview.failed_at)\n            .chain(attempts.iter().map(|f| f.at))\n            .max();\n        ReadStatus {\n            state,\n            last_read_at,\n            failed_at,\n            settled_at,\n            products: per_product,\n            sources_missing,\n            generation: record.map_or(0, |r| r.generation),\n            rechecking: record.and_then(|r| r.rechecking),\n        }\n    }\n\n    /// The active tenant's Inbox (I2): overview items with their holds and\n    /// the tenant's setup warnings; nothing of another tenant.\n    pub(super) fn inbox_view(&self, overview: &OverviewView) -> InboxView {\n        let now = self.clock();\n        let holds = self.active_holds();\n        let mut items = Vec::new();\n        let read_at = overview.read.as_ref().map_or(now, |r| r.read_at);\n        let hold_of = |item: &InboxItem| -> Option<HoldView> {\n            holds.iter().find_map(|h| {\n                if h.id != item.id {\n                    return None;\n                }\n                match h.kind {\n                    HoldKind::Acknowledge if crate::observation::level(item) <= h.level => {\n                        Some(HoldView {\n                            kind: HoldKind::Acknowledge,\n                            returns_at: None,\n                        })\n                    }\n                    HoldKind::Snooze if now < h.until => Some(HoldView {\n                        kind: HoldKind::Snooze,\n                        returns_at: Some(h.until),\n                    }),\n                    _ => None,\n                }\n            })\n        };\n        for item in overview.read.iter().flat_map(|r| r.items.iter()) {\n            let (kind, product) = if item.id.starts_with(\"gateway-\") {\n                (InboxKind::Gateway, Some(ProductId::Gateway))\n            } else {\n                (InboxKind::Runtime, Some(ProductId::RuntimeSecurity))\n            };\n            items.push(InboxEntry {\n                id: item.id.clone(),\n                kind,\n                needs_action: item.action,\n                severity: item.tone,\n                title: item.title.clone(),\n                detail: item.detail.clone(),\n                source: item.source.clone(),\n                product,\n                target: Some(item_target(item)),\n                action_label: Some(item.action_label.clone()),\n                facts: item.facts.clone(),\n                when: read_at,\n                hold: hold_of(item),\n            });\n        }\n        if let Some(tenant) = self.data.active.as_ref().and_then(|id| self.tenant(id)) {\n            for w in &tenant.setup_warnings {\n                let item = setup_warning_item(w);\n                let (target, label) = warning_target(w.product);\n                items.push(InboxEntry {\n                    id: w.id.clone(),\n                    kind: InboxKind::SetupWarning,\n                    needs_action: true,\n                    severity: Tone::Warn,\n                    title: item.title.clone(),\n                    detail: w.reason.clone(),\n                    source: item.source.clone(),\n                    product: Some(w.product),\n                    target: Some(target),\n                    action_label: Some(label.to_owned()),\n                    facts: item.facts.clone(),\n                    when: w.recorded_secs,\n                    hold: hold_of(&item),\n                });\n            }\n        }\n        for item in self.rotation_items() {\n            items.push(InboxEntry {\n                id: item.id.clone(),\n                kind: InboxKind::Rotation,\n                needs_action: true,\n                severity: Tone::Warn,\n                title: item.title.clone(),\n                detail: item.detail.clone(),\n                source: item.source.clone(),\n                product: Some(ProductId::RuntimeSecurity),\n                target: Some(InboxTarget {\n                    feature: FeatureId::Administration,\n                    product: Some(ProductId::RuntimeSecurity),\n                    resource: Some(ManagementResource::ApiKeys),\n                    item: item\n                        .facts\n                        .iter()\n                        .find(|f| f.label == \"Old key\")\n                        .map(|f| f.value.clone()),\n                }),\n                action_label: Some(item.action_label.clone()),\n                facts: item.facts.clone(),\n                when: self\n                    .data\n                    .active\n                    .as_ref()\n                    .and_then(|id| self.tenant(id))\n                    .and_then(|t| {\n                        t.rotations\n                            .iter()\n                            .find(|r| {\n                                super::rotation_domain::rotation_item_id(&r.application) == item.id\n                            })\n                            .map(|r| r.issued_at)\n                    })\n                    .unwrap_or(read_at),\n                hold: hold_of(&item),\n            });\n        }\n        InboxView {\n            items,\n            read: self.read_status(overview),\n            last_snooze: self.active_record().and_then(|r| r.last_snooze.clone()),\n        }\n    }\n}\n//! C29 (D058): tenant setup through the production authority interface.\n//! The wizard works on one core-owned draft with its own context: credentials\n//! attach to it, verification is decided in the core, completion commits the\n//! draft as a tenant in one step, and a discard or relaunch leaves nothing\n//! behind but a cleanup of its credentials.\n\nuse desktop_core::features::{OnboardingState, ProductId, VerifyLine, VerifyState};\nuse desktop_core::fixtures::{self, Handles, ScriptedStore};\nuse desktop_core::store::PersistedState;\nuse desktop_core::{\n    AuthorityHandle, Core, CoreConfig, Delivery, Intent, Observation, Receipt, Refusal,\n    ShellSnapshot, ViewScope,\n};\nuse serde_json::json;\n\nconst KEY: &str = \"synthetic-scan-key-aaaa\";\n\nstruct Desk {\n    _core: Core,\n    handle: AuthorityHandle,\n    session: String,\n    sequence: u64,\n    adapters: Handles,\n}\n\nimpl Desk {\n    fn new() -> Self {\n        Self::from_state(PersistedState::default())\n    }\n\n    fn from_state(state: PersistedState) -> Self {\n        let (adapters, handles) = fixtures::adapters_with(ScriptedStore::with_state(state));\n        let core = Core::new(CoreConfig::default(), adapters);\n        core.start();\n        let handle = core.operator();\n        let session = handle.register_delivery_session().expect(\"session\").nonce;\n        Self {\n            _core: core,\n            handle,\n            session,\n            sequence: 0,\n            adapters: handles,\n        }\n    }\n\n    fn restart(self) -> Self {\n        let state = self.adapters.store.saved().unwrap_or_default();\n        drop(self._core);\n        Self::from_state(state)\n    }\n\n    async fn send(&mut self, intent: serde_json::Value) -> Result<Receipt, Refusal> {\n        let intent: Intent = serde_json::from_value(intent).expect(\"intent\");\n        self.sequence += 1;\n        self.handle\n            .dispatch(\n                Delivery {\n                    session: self.session.clone(),\n                    sequence: self.sequence,\n                },\n                intent,\n            )\n            .await\n    }\n\n    fn snap(&self) -> ShellSnapshot {\n        match self.handle.observe(ViewScope::Shell).expect(\"observe\") {\n            Observation::Shell { snapshot, .. } => snapshot,\n            _ => unreachable!(\"shell scope\"),\n        }\n    }\n\n    fn setup(&self) -> desktop_core::features::SetupView {\n        self.snap().setup.expect(\"a setup in progress\")\n    }\n\n    async fn begin(&mut self, mode: &str, label: &str) -> String {\n        self.send(\n            json!({\"kind\": \"beginTenantSetup\", \"mode\": mode, \"profile\": {\n                \"label\": label, \"tsgId\": \"1234567890\",\n                \"destination\": {\"kind\": \"region\", \"region\": \"europe\"}, \"environment\": \"staging\"\n            }}),\n        )\n        .await\n        .expect(\"begun\");\n        self.setup().context.as_str().to_owned()\n    }\n\n    /// The draft's current context: it changes whenever its inputs change.\n    fn context(&self) -> String {\n        self.setup().context.as_str().to_owned()\n    }\n\n    async fn settled(&self, ready: bool) {\n        for _ in 0..200 {\n            let s = self.setup();\n            let state = s.tenant.scan.state;\n            let done = if ready {\n                state == desktop_core::ScanState::Ready\n            } else {\n                state != desktop_core::ScanState::Storing\n            };\n            if done {\n                return;\n            }\n            tokio::time::sleep(std::time::Duration::from_millis(5)).await;\n        }\n        panic!(\"the scan key write did not settle\");\n    }\n\n    async fn verified(&self) -> desktop_core::features::VerifyView {\n        for _ in 0..200 {\n            if let Some(v) = self.setup().verify\n                && v.done\n            {\n                return v;\n            }\n            tokio::time::sleep(std::time::Duration::from_millis(5)).await;\n        }\n        panic!(\"verification did not finish\");\n    }\n}\n\n#[tokio::test]\nasync fn a_draft_is_not_a_tenant_and_first_run_needs_the_scan_key_to_verify() {\n    let mut desk = Desk::new();\n    desk.send(json!({\"kind\": \"setUiVariant\", \"variant\": \"v2\"}))\n        .await\n        .expect(\"v2\");\n    let context = desk.begin(\"firstRun\", \"Northwind Health\").await;\n    let snap = desk.snap();\n    assert!(snap.tenants.is_empty(), \"the draft is not listed\");\n    assert!(snap.active.is_none());\n    assert_eq!(snap.onboarding, OnboardingState::Needed);\n    let setup = snap.setup.expect(\"setup\");\n    assert_eq!(setup.tenant.label, \"Northwind Health\");\n    assert_eq!(\n        setup.tenant.environment,\n        desktop_core::features::TenantEnvironment::Staging\n    );\n    assert!(setup.scan_required);\n    assert_eq!(setup.products, vec![ProductId::RuntimeSecurity]);\n    assert!(setup.verify.is_none() && !setup.completable);\n    // A second draft is refused while one is open.\n    assert_eq!(\n        desk.send(json!({\"kind\": \"beginTenantSetup\", \"mode\": \"add\", \"profile\": {\n            \"label\": \"Other\", \"tsgId\": null, \"destination\": {\"kind\": \"region\", \"region\": \"europe\"}}}))\n            .await,\n        Err(Refusal::Busy)\n    );\n    // Without a scan key the verify run fails on first run, so completion is refused.\n    desk.send(json!({\"kind\": \"verifyTenantSetup\", \"context\": context}))\n        .await\n        .expect(\"verify started\");\n    let v = desk.verified().await;\n    let scan = v\n        .steps\n        .iter()\n        .find(|s| s.line == VerifyLine::ScanKey)\n        .expect(\"scan line\");\n    assert_eq!(scan.state, VerifyState::Fail);\n    assert!(v.failed && !desk.setup().completable);\n    assert_eq!(\n        desk.send(json!({\"kind\": \"completeTenantSetup\", \"context\": context, \"packs\": []}))\n            .await,\n        Err(Refusal::InvalidInput)\n    );\n}\n\n#[tokio::test]\nasync fn credentials_attach_to_the_draft_and_a_stored_key_is_never_a_pass() {\n    let mut desk = Desk::new();\n    let context = desk.begin(\"firstRun\", \"Northwind Health\").await;\n    desk.send(json!({\"kind\": \"configureScanCredential\", \"context\": context, \"mode\": \"session\", \"key\": KEY}))\n        .await\n        .expect(\"key accepted for the draft\");\n    desk.settled(true).await;\n    let context = desk.context();\n    assert!(desk.snap().tenants.is_empty(), \"still no tenant\");\n    desk.send(json!({\"kind\": \"verifyTenantSetup\", \"context\": context}))\n        .await\n        .expect(\"verify\");\n    let v = desk.verified().await;\n    let by_line = |line: VerifyLine| v.steps.iter().find(|s| s.line == line).cloned();\n    let scan = by_line(VerifyLine::ScanKey).expect(\"scan\");\n    assert_eq!(\n        scan.state,\n        VerifyState::Stored,\n        \"explicitly unverified, not Pass\"\n    );\n","exit_code":0,"status":"completed"}}
