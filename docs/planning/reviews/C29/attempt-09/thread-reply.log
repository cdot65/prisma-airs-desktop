{"type":"item.started","item":{"id":"item_54","type":"command_execution","command":"/bin/zsh -lc \"python3 -c 'import json,pathlib,hashlib,stat,os,plistlib; sha=lambda p:hashlib.sha256(pathlib.Path(p).read_bytes()).hexdigest(); root=pathlib.Path(\\\".\\\"); prep=json.load(open(\\\"docs/planning/evidence/P09/native-prepare.json\\\")); bundle=pathlib.Path(prep[\\\"bundle\\\"]); entries=[]\nfor p in bundle.rglob(\\\"*\\\"):\n m=p.lstat(); rel=p.relative_to(bundle).as_posix()\n if p.is_symlink():entries.append((rel,\\\"symlink\\\",hashlib.sha256(os.readlink(p).encode()).hexdigest()))\n elif p.is_file():entries.append((rel,\\\"100755\\\" if m.st_mode&0o111 else \\\"100644\\\",sha(p)))\ndigest=hashlib.sha256(\\\"\\\".join(f\\\"{p}\\\\0{m}\\\\0{h}\\\\n\\\" for p,m,h in sorted(entries)).encode()).hexdigest(); print(\\\"canonical bundle\\\",digest,digest==prep[\\\"bundle_sha256\\\"],\\\"entries\\\",len(entries)); print(\\\"bundle identifier\\\",plistlib.load(open(bundle/\\\"Contents/Info.plist\\\",\\\"rb\\\"))[\\\"CFBundleIdentifier\\\"]); print(\\\"runtime executable paths\\\",[(p,m) for p,m,h in entries if m==\\\"100755\\\"]); seal=json.load(open(\\\"docs/planning/evidence/P09/native-build-inputs.json\\\")); print(\\\"native input seal\\\",seal[\\\"inputs\\\"][\\\"before_digest\\\"]==sha(seal[\\\"inputs\\\"][\\\"before_inventory\\\"])==sha(seal[\\\"inputs\\\"][\\\"after_inventory\\\"]),\\\"log\\\",sha(seal[\\\"command\\\"][\\\"log\\\"])==seal[\\\"command\\\"][\\\"log_sha256\\\"]);\nlive=pathlib.Path(\\\"docs/planning/evidence/C29/live/L19\\\"); old={p:h for h,p in [line.split(\\\"  \\\",1) for line in (live/\\\"build-02/inputs-before.sha256\\\").read_text().splitlines()]}; changed=[p for p,h in old.items() if not pathlib.Path(p).is_file() or sha(p)\"'!=h]; print(\"L19 changed existing input count\",len(changed)); print(\"L19 production diffs\",[p for p in changed if p.startswith((\"apps/desktop/src/\",\"apps/desktop/src-tauri/src/\",\"crates/desktop-core/src/\",\"packages/