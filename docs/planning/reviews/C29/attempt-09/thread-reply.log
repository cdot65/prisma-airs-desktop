{"type":"item.completed","item":{"id":"item_58","type":"command_execution","command":"/bin/zsh -lc \"sed -n '187,337p' crates/desktop-core/tests/ui_v2_setup_reads/main.rs; sed -n '497,648p' crates/desktop-core/tests/ui_v2_setup_reads/main.rs; sed -n '649,768p' crates/desktop-core/tests/ui_v2_setup_reads/main.rs\"","aggregated_output":"fn default_script() -> Script {\n    let mut routes = BTreeMap::new();\n    routes.insert(\n        format!(\"/aisec/v1/mgmt/profiles/tsg/{TSG}\"),\n        (200, json!({\"ai_profiles\": [profile(0)]})),\n    );\n    routes.insert(\n        \"/ai-red-teaming/data-plane/v1/scan\".to_owned(),\n        (200, json!({\"data\": [{\"uuid\": \"00000000-2222-4333-8444-555555555555\", \"tsg_id\": TSG,\n            \"name\": \"Campaign\", \"target\": {\"name\": \"Bot\"}, \"target_id\": \"t-1\", \"target_type\": \"APPLICATION\",\n            \"job_type\": \"STATIC\", \"status\": \"COMPLETED\", \"created_at\": \"2026-10-18T10:00:00Z\"}],\n            \"pagination\": {\"total_items\": 1}})),\n    );\n    routes.insert(\n        \"/ai-red-teaming/data-plane/v1/dashboard/scan-statistics\".to_owned(),\n        (503, json!({\"error\": \"statistics unavailable\"})),\n    );\n    let mut put = |key: &str, status: u16, body: Value| {\n        routes.insert(key.to_owned(), (status, body));\n    };\n    put(\n        \"/workspaces?\",\n        200,\n        listing(\n            vec![\n                workspace(WS_A, \"Team A\", \"team-a\"),\n                workspace(WS_B, \"Team B\", \"team-b\"),\n            ],\n            2,\n            Some(false),\n        ),\n    );\n    put(\n        &format!(\"/workspaces/{WS_A}?\"),\n        200,\n        json!({\"id\": WS_A, \"name\": \"Team A\", \"description\": null, \"created_at\": \"2026-10-01T00:00:00Z\",\n               \"last_updated_at\": \"2026-10-02T00:00:00Z\", \"is_default\": 0, \"slug\": \"team-a\",\n               \"icon\": null, \"defaults\": {\"config_id\": ROUTE, \"allow_config_override\": true},\n               \"usage_limits\": null, \"rate_limits\": null, \"status\": \"active\"}),\n    );\n    for ws in [WS_A, WS_B] {\n        put(\n            &format!(\"/providers?workspace_id={ws}\"),\n            200,\n            listing(vec![provider_row(PROVIDER)], 1, Some(false)),\n        );\n        put(\n            &format!(\"/configs?workspace_id={ws}\"),\n            200,\n            listing(vec![route_row(ROUTE, ws)], 1, Some(false)),\n        );\n        put(\n            &format!(\"/guardrails?workspace_id={ws}\"),\n            200,\n            listing(vec![guardrail_row(GUARDRAIL, ws)], 1, Some(false)),\n        );\n        put(\n            &format!(\"/api-keys/service?workspace_id={ws}\"),\n            200,\n            listing(\n                vec![\n                    key_row(SERVICE_KEY, &[\"completions.write\", \"models.read\"]),\n                    key_row(\"7e3a0000-0000-4000-8000-000000000006\", &[\"models.read\"]),\n                ],\n                2,\n                Some(false),\n            ),\n        );\n        put(\n            &format!(\"/api-keys/user?workspace_id={ws}\"),\n            200,\n            listing(vec![key_row(USER_KEY, &[\"completions.write\"])], 1, None),\n        );\n    }\n    put(\n        &format!(\"/providers/{PROVIDER}?\"),\n        200,\n        json!({\"id\": PROVIDER, \"ai_provider_name\": \"openai\", \"model_config\": {\"api_key\": \"CANARY-model-config\"},\n               \"key\": \"sk-CANARY-provider\", \"masked_api_key\": \"sk-****ider\", \"slug\": \"openai-prod\",\n               \"name\": \"openai-prod\", \"usage_limits\": null, \"status\": \"active\", \"note\": null,\n               \"created_at\": \"2026-10-01T00:00:00Z\", \"expires_at\": null, \"last_reset_at\": null,\n               \"rate_limits\": [], \"integration_id\": INTEGRATION, \"object\": \"provider\"}),\n    );\n    put(&format!(\"/configs/{ROUTE}?\"), 200, {\n        let mut detail = route_row(ROUTE, WS_A);\n        detail[\"config\"] = json!(json!({\"strategy\": {\"mode\": \"fallback\"}, \"targets\": [\n                {\"provider\": \"@openai-prod\", \"api_key\": \"CANARY-route-key\", \"forward_headers\": [\"x-trace\"]},\n                {\"provider\": \"@backup\", \"weight\": 1}\n            ]}).to_string());\n        detail[\"format\"] = json!(\"json\");\n        detail[\"type\"] = json!(\"ROUTING\");\n        detail[\"version_id\"] = json!(\"v-1\");\n        detail\n    });\n    put(&format!(\"/guardrails/{GUARDRAIL}?\"), 200, {\n        let mut detail = guardrail_row(GUARDRAIL, WS_A);\n        detail[\"checks\"] = json!([{\"id\": \"pii-check\", \"parameters\": {\"apiKey\": \"CANARY-guardrail-key\"},\n                                       \"is_enabled\": true}]);\n        detail[\"actions\"] = json!({\"deny\": true, \"async\": false, \"sequential\": false});\n        detail[\"version_id\"] = json!(\"v-1\");\n        detail\n    });\n    put(\n        &format!(\"/api-keys/service/{SERVICE_KEY}?\"),\n        200,\n        key_row(SERVICE_KEY, &[\"completions.write\"]),\n    );\n    put(\n        &format!(\"/api-keys/user/{USER_KEY}?\"),\n        200,\n        key_row(USER_KEY, &[\"completions.write\"]),\n    );\n    put(\n        &format!(\"{ADMIN}/integrations\"),\n        200,\n        listing(vec![integration_row()], 1, Some(false)),\n    );\n    put(&format!(\"{ADMIN}/integrations/{INTEGRATION}\"), 200, {\n        let mut detail = integration_row();\n        detail[\"configurations\"] = json!(\n            json!({\"api_key\": \"CANARY-integration-secret\", \"region\": \"us-east-1\"}).to_string()\n        );\n        detail\n    });\n    put(\n        &format!(\"{ADMIN}/integrations/{INTEGRATION}/models\"),\n        200,\n        json!({\"object\": \"list\", \"allow_all_models\": false, \"total\": 2, \"models\": [\n            {\"slug\": \"gpt-4o\", \"enabled\": true, \"name\": \"GPT-4o\", \"pricing_config\": {\"pay_as_you_go\": {}}},\n            {\"slug\": \"o3\", \"enabled\": false}\n        ]}),\n    );\n    put(\n        &format!(\"{IAM}/scopes/scope-team-a\"),\n        200,\n        json!({\"name\": \"scope-team-a\", \"description\": \"Team A\", \"tsg_id\": TSG, \"id\": \"scope-1\",\n               \"resources\": [{\"resource_type\": \"workspace\", \"resource_id\": \"team-a\"}]}),\n    );\n    put(\n        &format!(\"{IAM}/scopes/scope-team-b\"),\n        200,\n        json!({\"name\": \"scope-team-b\", \"description\": \"Team B\", \"tsg_id\": TSG, \"id\": \"scope-2\",\n               \"resources\": [{\"resource_type\": \"workspace\", \"resource_id\": \"someone-else\"}]}),\n    );\n    Script {\n        routes,\n        hang: BTreeSet::new(),\n        token_status: 200,\n    }\n}\n\n#[tokio::test]\nasync fn a_draft_reads_beside_the_active_tenant_without_touching_its_gateway_choice() {\n    let mut desk = desk().await;\n    desk.tenant_a().await;\n    let a_before = desk.snap().gateway;\n    let a_reference = a_before\n        .selected\n        .as_ref()\n        .expect(\"A's choice\")\n        .reference\n        .clone();\n    assert_eq!(\n        a_before.selected.as_ref().map(|s| s.workspace.id.as_str()),\n        Some(WS_A)\n    );\n    let active_before = desk.snap().active.expect(\"active\");\n\n    // Draft B over the same synthetic plane (add mode, key optional).\n    let origin = desk.origin.clone();\n    desk.send(json!({\"kind\": \"beginTenantSetup\", \"mode\": \"add\", \"profile\": {\"label\": \"Tenant B\", \"tsgId\": TSG,\n        \"destination\": {\"kind\": \"custom\", \"origin\": origin}}}))\n        .await\n        .expect(\"draft\");\n    let first_context = desk.draft_context();\n    desk.send(json!({\"kind\": \"configureManagementCredential\", \"context\": first_context, \"mode\": \"keychain\",\n        \"clientId\": CLIENT_ID, \"secret\": CLIENT_SECRET}))\n        .await\n        .expect(\"draft client\");\n    // The credential change retired the draft's context: the old one is refused, the new one works.\n    let context = desk.draft_context();\n    assert_ne!(context, first_context, \"a fresh draft context\");\n    assert_eq!(\n        desk.send(json!({\"kind\": \"verifyTenantSetup\", \"context\": first_context}))\n            .await,\n        Err(Refusal::StaleContext)\n    );\n    assert!(eventually(|| desk.setup().tenant.management.state == ScanState::Ready).await);\n    desk.send(json!({\"kind\": \"chooseSetupProducts\", \"context\": context, \"products\": [\"gateway\"]}))\n        .await\n        .expect(\"products\");\n    // The draft lists through its own context and chooses WS_B; A keeps WS_A.\n    let list = desk.read(&context, json!({\"kind\": \"gateway\", \"workspace\": null, \"read\": {\"kind\": \"inventory\", \"resource\": \"workspaces\"}})).await;\n    assert!(\n        matches!(list, ManagementResult::Gateway { .. }),\n        \"draft listing delivered, not withdrawn: {list:?}\"\n    );\n    desk.send(json!({\"kind\": \"selectGatewayWorkspace\", \"context\": context, \"workspace\": WS_B}))\n        .await\n        .expect(\"draft chose\");\n    let setup = desk.setup();\n    let chosen = setup.workspace.expect(\"draft's workspace\");\n    assert_eq!(chosen.workspace.id, WS_B);\n    assert_ne!(chosen.reference, a_reference);\n    let a_during = desk.snap().gateway;\n    assert_eq!(\n        a_during.selected, a_before.selected,\n        \"A's choice untouched by the draft's listing and choice\"\n    );\n    assert_eq!(a_during.workspaces, a_before.workspaces);\n    assert_eq!(\n        desk.snap().active,\n        Some(active_before.clone()),\n        \"A's context untouched\"\n    );\n\n    // Replacing the draft's client retires its context and the choice under it;\n    // the next listing restores the draft's remembered workspace.\n    desk.send(\n        json!({\"kind\": \"configureManagementCredential\", \"context\": context, \"mode\": \"keychain\",\n        \"clientId\": CLIENT_ID, \"secret\": CLIENT_SECRET}),\n    )\n    .await\n    .expect(\"replaced client\");\n    let context = desk.draft_context();\n    assert!(\n        desk.setup().workspace.is_none(),\n        \"the choice went with the old context\"\n    );\n    assert!(eventually(|| desk.setup().tenant.management.state == ScanState::Ready).await);\n    let list = desk.read(&context, json!({\"kind\": \"gateway\", \"workspace\": null, \"read\": {\"kind\": \"inventory\", \"resource\": \"workspaces\"}})).await;\n    assert!(matches!(list, ManagementResult::Gateway { .. }));\n    let restored = desk\n        .setup()\n        .workspace\n        .expect(\"restored from the draft's remembered workspace\");\n    assert_eq!(restored.workspace.id, WS_B);\n    assert!(restored.restored);\n    assert_eq!(\n        desk.snap().gateway.selected,\n        a_before.selected,\n        \"A still untouched\"\n    );\n\n    // Verify: real reads settle the lines; AIS/AES are listed as unavailable.\n    desk.send(json!({\"kind\": \"verifyTenantSetup\", \"context\": context}))\n        .await\n        .expect(\"verify\");\n    let v = desk.verified().await;\n    let line = |l: VerifyLine| v.steps.iter().find(|s| s.line == l).cloned().expect(\"line\");\n    assert_eq!(\n        line(VerifyLine::ScanKey).state,\n        VerifyState::Warning,\n        \"no key in add mode\"\n    );\n    assert_eq!(line(VerifyLine::ManagementClient).state, VerifyState::Pass);\n    // WS_B's IAM scope lists another workspace: the prerequisites read is\n    // partial, and says so, instead of passing on the four inventories alone.\n    let gateway = line(VerifyLine::Gateway);\n    assert_eq!(gateway.state, VerifyState::Warning, \"{}\", gateway.reason);\n    assert!(\n        gateway\n            .reason\n            .contains(\"scope scope-team-b does not list the workspace\"),\n        \"{}\",\n        gateway.reason\n    );\n    assert_eq!(line(VerifyLine::Ais).state, VerifyState::Unavailable);\n    assert_eq!(line(VerifyLine::Aes).state, VerifyState::Unavailable);\n    assert!(line(VerifyLine::Ais).product.is_none());\n    assert!(v.done && !v.failed && !v.blocking && !v.stale);\n    assert_eq!(\n        v.warnings.len(),\n        2,\n        \"the missing key and the partial prerequisites\"\n    );\n    assert_eq!(v.warnings[1].product, ProductId::Gateway);\n    assert!(desk.setup().completable);\n\n    // Discard: A is exactly as it was.\n    desk.send(json!({\"kind\": \"discardTenantSetup\", \"context\": context}))\n        .await\n        .expect(\"discard\");\n    let snap = desk.snap();\n    assert!(snap.setup.is_none());\n    assert_eq!(snap.gateway.selected, a_before.selected);\n    assert_eq!(snap.active, Some(active_before));\n    assert_eq!(snap.tenants.len(), 1);\n    // A's chosen workspace still answers scoped reads under its reference.\n    let a_context = desk.active_context();\n    let prerequisites = desk\n        .read(\n            &a_context,\n            json!({\"kind\": \"gateway\", \"workspace\": a_reference, \"read\": {\"kind\": \"prerequisites\"}}),\n        )\n        .await;\n    assert!(\n        matches!(prerequisites, ManagementResult::Gateway { .. }),\n        \"{prerequisites:?}\"\n    );\n}\n\n#[tokio::test]\nasync fn an_optional_service_failure_is_a_warning_the_operator_may_continue_over() {\n    let mut desk = desk().await;\n    desk.tenant_a().await;\n    let origin = desk.origin.clone();\n    desk.send(json!({\"kind\": \"beginTenantSetup\", \"mode\": \"add\", \"profile\": {\"label\": \"Tenant B\", \"tsgId\": TSG,\n        \"destination\": {\"kind\": \"custom\", \"origin\": origin}}}))\n        .await\n        .expect(\"draft\");\n    let context = desk.draft_context();\n    desk.send(\n        json!({\"kind\": \"configureManagementCredential\", \"context\": context, \"mode\": \"keychain\",\n        \"clientId\": CLIENT_ID, \"secret\": CLIENT_SECRET}),\n    )\n    .await\n    .expect(\"draft client\");\n    let context = desk.draft_context();\n    assert!(eventually(|| desk.setup().tenant.management.state == ScanState::Ready).await);\n    desk.send(json!({\"kind\": \"chooseSetupProducts\", \"context\": context, \"products\": [\"redTeam\"]}))\n        .await\n        .expect(\"products\");\n    // The management plane refuses this client: the verify read fails.\n    desk.script.lock().expect(\"script\").token_status = 401;\n    desk.send(json!({\"kind\": \"verifyTenantSetup\", \"context\": context}))\n        .await\n        .expect(\"verify\");\n    let v = tokio::time::timeout(Duration::from_secs(60), desk.verified())\n        .await\n        .expect(\"settled\");\n    let management = v\n        .steps\n        .iter()\n        .find(|s| s.line == VerifyLine::ManagementClient)\n        .expect(\"line\");\n    assert_eq!(management.state, VerifyState::Fail, \"{}\", management.reason);\n    assert!(\n        v.failed && !v.blocking,\n        \"an optional service's failure does not block\"\n    );\n    assert!(\n        v.warnings\n            .iter()\n            .any(|w| w.product == ProductId::RuntimeSecurity && w.reason.starts_with(\"Failed: \"))\n    );\n    assert!(\n        desk.setup().completable,\n        \"Continue with warnings is admitted\"\n    );\n    desk.send(json!({\"kind\": \"completeTenantSetup\", \"context\": context, \"packs\": []}))\n        .await\n        .expect(\"completed over the warning\");\n    let snap = desk.snap();\n    let b = snap\n        .tenants\n        .iter()\n        .find(|t| t.label == \"Tenant B\")\n        .expect(\"B\");\n    assert!(\n        b.setup_warnings\n            .iter()\n            .any(|w| w.reason.starts_with(\"Failed: \")),\n        \"the failure is recorded, not converted to a pass\"\n    );\n    assert_eq!(snap.active.as_ref().map(|a| &a.tenant), Some(&b.id));\n    let _ = &desk.adapters;\n}\n\n#[tokio::test]\nasync fn a_source_that_fails_inside_a_read_is_a_warning_that_reaches_the_tenant() {\n    let mut desk = desk().await;\n    desk.tenant_a().await;\n    let origin = desk.origin.clone();\n    desk.send(json!({\"kind\": \"beginTenantSetup\", \"mode\": \"add\", \"profile\": {\"label\": \"Tenant B\", \"tsgId\": TSG,\n        \"destination\": {\"kind\": \"custom\", \"origin\": origin}}}))\n        .await\n        .expect(\"draft\");\n    let context = desk.draft_context();\n    desk.send(\n        json!({\"kind\": \"configureManagementCredential\", \"context\": context, \"mode\": \"keychain\",\n        \"clientId\": CLIENT_ID, \"secret\": CLIENT_SECRET}),\n    )\n    .await\n    .expect(\"draft client\");\n    let context = desk.draft_context();\n    assert!(eventually(|| desk.setup().tenant.management.state == ScanState::Ready).await);\n    desk.send(json!({\"kind\": \"chooseSetupProducts\", \"context\": context, \"products\": [\"redTeam\"]}))\n        .await\n        .expect(\"products\");\n    // Red Team scans list, but the statistics source answers 503: partial, never Pass.\n    desk.send(json!({\"kind\": \"verifyTenantSetup\", \"context\": context}))\n        .await\n        .expect(\"verify\");\n    let v = desk.verified().await;\n    let red_team = v\n        .steps\n        .iter()\n        .find(|s| s.line == VerifyLine::RedTeam)\n        .expect(\"line\");\n    assert_eq!(red_team.state, VerifyState::Warning, \"{}\", red_team.reason);\n    assert!(\n        red_team.reason.contains(\"statistics did not\"),\n        \"{}\",\n        red_team.reason\n    );\n    assert!(v.warnings.iter().any(|w| w.product == ProductId::RedTeam));\n    desk.send(json!({\"kind\": \"completeTenantSetup\", \"context\": context, \"packs\": []}))\n        .await\n        .expect(\"completed\");\n    let b = desk\n        .snap()\n        .tenants\n        .into_iter()\n        .find(|t| t.label == \"Tenant B\")\n        .expect(\"B\");\n    assert!(\n        b.setup_warnings\n            .iter()\n            .any(|w| w.product == ProductId::RedTeam && w.reason.contains(\"statistics did not\"))\n    );\n}\n\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_59","type":"command_execution","command":"/bin/zsh -lc \"sed -n '1850,1975p' crates/desktop-core/tests/harness_tools/main.rs; sed -n '176,238p' apps/desktop/src/v2/wizard/wizard.test.tsx; sed -n '427,478p' apps/desktop/src/v2/wizard/wizard.test.tsx\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_59","type":"command_execution","command":"/bin/zsh -lc \"sed -n '1850,1975p' crates/desktop-core/tests/harness_tools/main.rs; sed -n '176,238p' apps/desktop/src/v2/wizard/wizard.test.tsx; sed -n '427,478p' apps/desktop/src/v2/wizard/wizard.test.tsx\"","aggregated_output":"\n/// C30 (I1): completing an Add-a-tenant draft makes the new tenant active,\n/// so it is the same guarded switch: a pending Harness decision refuses it\n/// with the guard naming the draft, nothing is committed or retired until\n/// the operator resolves the conversation, and the resolution completes it.\n#[tokio::test(flavor = \"multi_thread\", worker_threads = 4)]\nasync fn completing_a_tenant_setup_is_the_guarded_switch_path() {\n    let mut desk = desk().await;\n    let dir = project();\n    choose_project(&mut desk, &dir).await;\n    let id = ready(&mut desk).await;\n    tool(&desk, None, \"exec_command\", json!({\"cmd\": \"ls\"}));\n    desk.say(&id, \"List the files.\").await.expect(\"sent\");\n    let c = answered_with(&mut desk, |c| {\n        c[\"approvals\"].as_array().is_some_and(|a| !a.is_empty())\n    })\n    .await;\n    let token = c[\"approvals\"][0][\"id\"].as_str().expect(\"id\").to_owned();\n    let a = desk.json()[\"active\"][\"tenant\"]\n        .as_str()\n        .expect(\"A\")\n        .to_owned();\n    let origin = desk.json()[\"tenants\"][0][\"origin\"]\n        .as_str()\n        .expect(\"origin\")\n        .to_owned();\n    desk.send(json!({\"kind\": \"beginTenantSetup\", \"mode\": \"add\", \"profile\": {\"label\": \"Tenant C\", \"tsgId\": \"1234567890\",\n        \"destination\": {\"kind\": \"custom\", \"origin\": origin}}}))\n        .await\n        .expect(\"draft\");\n    let setup = desk.json()[\"setup\"].clone();\n    let draft = setup[\"context\"].as_str().expect(\"draft context\").to_owned();\n    let draft_id = setup[\"tenant\"][\"id\"].as_str().expect(\"draft id\").to_owned();\n    desk.send(json!({\"kind\": \"verifyTenantSetup\", \"context\": draft}))\n        .await\n        .expect(\"verify\");\n    assert!(settle(|| desk.json()[\"setup\"][\"verify\"][\"done\"] == true).await);\n    assert_eq!(\n        desk.send(json!({\"kind\": \"completeTenantSetup\", \"context\": draft, \"packs\": []}))\n            .await,\n        Err(desktop_core::Refusal::DecisionPending)\n    );\n    let s = desk.json();\n    assert_eq!(s[\"active\"][\"tenant\"], a, \"still on A\");\n    assert_eq!(\n        s[\"switchBlocked\"][\"to\"], draft_id,\n        \"the guard names the draft\"\n    );\n    assert_eq!(s[\"switchBlocked\"][\"completion\"], true);\n    assert_eq!(s[\"switchBlocked\"][\"pending\"][\"conversation\"], id);\n    assert_eq!(s[\"switchBlocked\"][\"pending\"][\"decision\"], token);\n    assert_eq!(s[\"setup\"][\"context\"], draft, \"the draft is untouched\");\n    assert!(\n        s[\"harness\"][\"conversation\"][\"approvals\"]\n            .as_array()\n            .is_some_and(|x| !x.is_empty()),\n        \"nothing was decided for the operator\"\n    );\n    assert!(\n        s[\"tenants\"]\n            .as_array()\n            .expect(\"tenants\")\n            .iter()\n            .all(|t| t[\"label\"] != \"Tenant C\"),\n        \"nothing was committed\"\n    );\n    // Stay: the guard closes; the draft, the tenant and the decision remain.\n    desk.send(json!({\"kind\": \"dismissSwitchGuard\"}))\n        .await\n        .expect(\"dismissed\");\n    let s = desk.json();\n    assert!(s[\"switchBlocked\"].is_null());\n    assert_eq!(s[\"setup\"][\"context\"], draft);\n    assert_eq!(s[\"active\"][\"tenant\"], a);\n    // Archive and complete: the conversation ends (kept), the tenant is\n    // committed and active, the draft is gone.\n    let resolved = reviewed_switch(\n        &mut desk,\n        json!({\"kind\": \"completeTenantSetup\", \"context\": draft, \"packs\": []}),\n        \"archive\",\n    )\n    .await;\n    assert_eq!(\n        resolved[\"resolution\"][\"context\"],\n        desk.context(),\n        \"bound to the active source, not the setup draft\"\n    );\n    let mut wrong_source = resolved.clone();\n    wrong_source[\"resolution\"][\"context\"] = json!(draft);\n    assert_eq!(\n        desk.send(wrong_source).await,\n        Err(desktop_core::Refusal::StaleContext)\n    );\n    assert_eq!(\n        desk.conversation()[\"id\"],\n        id,\n        \"forged source does not end the conversation\"\n    );\n    desk.send(resolved).await.expect(\"completed\");\n    let s = desk.json();\n    assert!(s[\"setup\"].is_null());\n    assert!(s[\"switchBlocked\"].is_null());\n    let c_id = s[\"tenants\"]\n        .as_array()\n        .expect(\"tenants\")\n        .iter()\n        .find(|t| t[\"label\"] == \"Tenant C\")\n        .and_then(|t| t[\"id\"].as_str())\n        .expect(\"committed\")\n        .to_owned();\n    assert_eq!(s[\"active\"][\"tenant\"], c_id);\n    assert!(\n        s[\"harness\"][\"conversation\"].is_null(),\n        \"another tenant's conversation is never shown\"\n    );\n    desk.send(json!({\"kind\": \"selectTenant\", \"tenant\": a}))\n        .await\n        .expect(\"back to A\");\n    assert!(\n        settle_for(30, || {\n            let c = desk.conversation();\n            c.is_null() || c[\"phase\"] == \"ended\" || c[\"phase\"] == \"ending\"\n        })\n        .await\n    );\n    std::fs::remove_dir_all(&dir).expect(\"cleanup\");\n    it('keeps a refused or unconfirmed completion visible with Retry instead of closing', async () => {\n        const user = userEvent.setup()\n        const verified = verifyView([{ line: 'scanKey', product: 'runtimeSecurity', state: 'stored', reason: 'Stored.' }, { line: 'managementClient', product: 'runtimeSecurity', state: 'skipped', reason: 'No client.' }])\n        const native = await launch({ ...fxOnboarding(), onboarding: 'inProgress', setup: setupView({ verify: verified }) })\n        for (const step of ['Continue', 'Continue', 'Continue', 'Continue', 'Skip for now']) await user.click(screen.getByRole('button', { name: step }))\n        expect(screen.getByRole('heading', { level: 1, name: /is ready$/ })).toBeInTheDocument()\n        native.respond = () => ({ outcome: 'refusal', refusal: 'invalidInput' })\n        await user.click(screen.getByRole('button', { name: 'Open Prisma AIRS' }))\n        expect(await screen.findByText('Check the entered values and try again.')).toBeInTheDocument()\n        expect(screen.getByRole('button', { name: 'Open Prisma AIRS' })).toBeEnabled()\n        native.respond = () => {\n            throw new DeliveryOutcomeUnknown('lost')\n        }\n        await user.click(screen.getByRole('button', { name: 'Open Prisma AIRS' }))\n        expect(await screen.findByText('Sent but not confirmed. The current state is shown.')).toBeInTheDocument()\n        native.respond = () => admitted()\n        // (An unconfirmed delivery is re-sent once by the client before it gives up.)\n        const sent = native.dispatched.length\n        await user.click(screen.getByRole('button', { name: 'Retry' }))\n        expect(native.dispatched.length).toBe(sent + 1)\n        expect(native.dispatched.at(-1)).toEqual({ kind: 'completeTenantSetup', context: DRAFT_CONTEXT, packs: ['runtimeSecurity'], resolution: null })\n    })\n\n    it('opens from the switcher as a modal with the 244px rail and no Welcome or Academy step; Cancel before a draft sends nothing', async () => {\n        const user = userEvent.setup()\n        const native = await launch(fxSwitcher())\n        await user.click(screen.getByRole('button', { name: /^Switch tenant/ }))\n        await user.click(screen.getByRole('button', { name: 'Add a tenant…' }))\n        const sheet = screen.getByRole('dialog', { name: 'Add a tenant' })\n        expect(sheet).toHaveAttribute('aria-modal', 'true')\n        expect(sheet.style.maxHeight).toBe('92vh')\n        const steps = within(sheet).getByRole('navigation', { name: 'Setup steps' })\n        expect(within(steps).getAllByRole('button').map((b) => b.textContent)).toEqual(['1Tenant', '2Products', '3Verify', '4Starter casesOptional', '5Done', 'Light appearance'])\n        expect(within(sheet).getByRole('button', { name: 'Cancel' })).toBeInTheDocument()\n        expect(steps).toHaveStyle({ width: '244px' })\n        expect(within(sheet).queryByRole('button', { name: 'Back' })).toBeNull()\n        await user.click(within(sheet).getByRole('button', { name: 'Cancel' }))\n        expect(screen.queryByRole('dialog')).toBeNull()\n        expect(native.dispatched.filter((i) => i.kind !== 'navigate')).toEqual([])\n    })\n\n    it('drafts in add mode with an optional key, discards the draft on Cancel, and leaves the shell as it was', async () => {\n        const user = userEvent.setup()\n        const native = await launch(fxSwitcher())\n        await user.click(screen.getByRole('button', { name: /^Switch tenant/ }))\n        await user.click(screen.getByRole('button', { name: 'Add a tenant…' }))\n        const sheet = screen.getByRole('dialog', { name: 'Add a tenant' })\n        await user.type(within(sheet).getByLabelText(/Display name/), 'Coastal Bank')\n        await user.type(within(sheet).getByLabelText(/TSG ID/), '2000000001')\n        await user.click(within(sheet).getByRole('button', { name: 'Create tenant' }))\n        expect(native.dispatched.at(-1)).toMatchObject({ kind: 'beginTenantSetup', mode: 'add', profile: { label: 'Coastal Bank', tsgId: '2000000001' } })\n        const before = { tenants: native.current.tenants, active: native.current.active }\n        await native.push({ ...native.current, setup: setupView({ mode: 'add', scanRequired: false, tenant: draft({ label: 'Coastal Bank', tsgId: '2000000001', environment: 'production', destination: { kind: 'region', region: 'unitedStates' } }) }) })\n        await within(sheet).findByText('Coastal Bank is drafted. Add its scan key below.')\n        expect(within(sheet).getByText(/Optional here; without it scans stay unavailable/)).toBeInTheDocument()\n        expect(within(sheet).getByRole('button', { name: 'Continue' })).toBeEnabled()\n        expect(native.current.tenants).toEqual(before.tenants)\n        expect(native.current.active).toEqual(before.active)\n        await user.click(within(sheet).getByRole('button', { name: 'Cancel' }))\n        expect(native.dispatched.at(-1)).toEqual({ kind: 'discardTenantSetup', context: DRAFT_CONTEXT })\n        expect(screen.queryByRole('dialog')).toBeNull()\n    })\n\n    it('completion is the guarded switch path (I1): a pending Harness decision shows the guard in the sheet and the resolution re-sends the completion', async () => {\n        const user = userEvent.setup()\n        const verified = verifyView([{ line: 'scanKey', product: 'runtimeSecurity', state: 'warning', reason: 'No scan key saved; scans stay unavailable until one is added in Administration.' }, { line: 'managementClient', product: 'runtimeSecurity', state: 'skipped', reason: 'No client.' }])\n        const native = await launch({ ...fxSwitcher(), setup: setupView({ mode: 'add', scanRequired: false, tenant: draft({ label: 'Coastal Bank', tsgId: '2000000001' }), verify: verified }) })\n        await user.click(screen.getByRole('button', { name: /^Switch tenant/ }))\n        await user.click(screen.getByRole('button', { name: 'Add a tenant…' }))\n        const sheet = screen.getByRole('dialog', { name: 'Add a tenant' })\n        for (const step of ['Continue', 'Continue', 'Continue with warnings', 'Skip for now']) await user.click(within(sheet).getByRole('button', { name: step }))\n        native.respond = () => ({ outcome: 'refusal', refusal: 'decisionPending' })\n        await user.click(within(sheet).getByRole('button', { name: 'Finish' }))\n        expect(native.dispatched.at(-1)).toEqual({ kind: 'completeTenantSetup', context: DRAFT_CONTEXT, packs: [], resolution: null })\n        // Not a status line: the sheet stays, the draft stays, nothing was decided.\n        expect(screen.getByRole('dialog', { name: 'Add a tenant' })).toBeInTheDocument()\n        expect(document.querySelector('[data-slot=\"wizard-status\"]')?.textContent).toBe('')\n        const draftId = native.current.setup?.tenant.id as string\n        await native.push({ ...native.current, switchBlocked: { context: native.current.active!.context, review: 'rv-1111111111111111', targetContext: DRAFT_CONTEXT, to: draftId, pending: { conversation: 'op-7', decision: 'ap-1' }, completion: true } })\n        const guard = await screen.findByRole('dialog', { name: 'A Harness decision is waiting' })\n        expect(within(guard).getByText(/Finishing the setup of Coastal Bank makes it active/)).toBeInTheDocument()\n        native.respond = () => admitted()\n        await user.click(within(guard).getByRole('button', { name: 'Stay' }))\n        expect(native.dispatched.at(-1)).toEqual({ kind: 'dismissSwitchGuard' })\n        await native.push({ ...native.current, switchBlocked: null })\n        await waitFor(() => expect(screen.queryByRole('dialog', { name: 'A Harness decision is waiting' })).toBeNull())\n        expect(screen.getByRole('dialog', { name: 'Add a tenant' })).toBeInTheDocument()\n        await native.push({ ...native.current, switchBlocked: { context: native.current.active!.context, review: 'rv-1111111111111111', targetContext: DRAFT_CONTEXT, to: draftId, pending: { conversation: 'op-7', decision: 'ap-1' }, completion: true } })\n        await user.click(within(await screen.findByRole('dialog', { name: 'A Harness decision is waiting' })).getByRole('button', { name: 'Archive and switch' }))\n        expect(native.dispatched.at(-1)).toEqual({ kind: 'completeTenantSetup', context: DRAFT_CONTEXT, packs: [], resolution: { kind: 'archive', context: native.current.active!.context, review: 'rv-1111111111111111' } })\n        expect(await screen.findByText(/Coastal Bank is set up and active\\./)).toBeInTheDocument()\n    })\n})\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_60","type":"command_execution","command":"/bin/zsh -lc \"cat docs/planning/evidence/C29/live-scope-request.md docs/planning/evidence/C29/live/L19/additional-grant-01.json docs/planning/evidence/C29/live/L19/additional-grant-01-validation.json docs/planning/evidence/C29/live/L19/credential-correction.json; sed -n '769,937p' crates/desktop-core/tests/ui_v2_setup_reads/main.rs; rg -n 'fixture|VerifyState|failed|stale|unknown|verify|Pending' tools/native-acceptance/test_live_c29_l19.py | head -90\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_60","type":"command_execution","command":"/bin/zsh -lc \"cat docs/planning/evidence/C29/live-scope-request.md docs/planning/evidence/C29/live/L19/additional-grant-01.json docs/planning/evidence/C29/live/L19/additional-grant-01-validation.json docs/planning/evidence/C29/live/L19/credential-correction.json; sed -n '769,937p' crates/desktop-core/tests/ui_v2_setup_reads/main.rs; rg -n 'fixture|VerifyState|failed|stale|unknown|verify|Pending' tools/native-acceptance/test_live_c29_l19.py | head -90\"","aggregated_output":"# C29 live row: what the owner must designate\n\nC29's required acceptance includes one live read: \"verify against the\ndesignated read-only tenant (Vulture) under the owner scope, recorded as a\nredacted receipt; no writes\" (`chunks/C29.md`). The approved execution\nmanifest (`~/airs-v2-live.json`, `airs-v2/live-manifest/1`, approved\n2026-10-25) designates Vulture (TSG 1852583913, environment test-b) for the\nL18 scan family only. No family permits a management read on Vulture, so the\nwizard's verify read (`management · verify`, the same read L02 runs on\nRedtail) has no designated scope there.\n\nA Keychain item `mgmt-vulture-client-secret` exists under the live service,\nbut a stored secret is not a designation. Per the release contract a family\nwithout designated access is recorded **blocked**, never passed and never\nrun on an undesignated credential.\n\n## What unblocks it\n\nAdd one family to the private manifest and re-run `cargo run -p xtask --\nlive-scope --scope <path>`:\n\n```json\n\"L19\": {\n  \"status\": \"designated\",\n  \"reason\": \"\",\n  \"environment\": \"test-b\",\n  \"credentials\": {\n    \"client_secret\": { \"kind\": \"keychain\", \"service\": \"io.cdot.prisma-airs-desktop.v2.live\", \"account\": \"mgmt-vulture-client-secret\" }\n  },\n  \"nonsecret\": { \"client_id\": \"<Vulture management client id>\", \"tsg_id\": \"1852583913\", \"region\": \"us\" },\n  \"permitted_operations\": [\"one management verify read through the first-run wizard (C29); no inventories, no writes\"],\n  \"disposable_prefix\": null,\n  \"budget\": { \"reads\": 2 },\n  \"cleanup\": [],\n  \"irreversible_exclusions\": [\"no changes of any kind on Vulture\"]\n}\n```\n\nThe run then goes through the real wizard on the fixture build with the\nKeychain reference, and the receipt lands in `live/L19-verify.json` with the\nclient id and TSG only (no token, no secret). Until then `live/blocked.json`\nis the row's record.\n\n## Preparation update — 2026-11-01\n\nThe owner approved adding read-only L19 with the existing Keychain reference,\na maximum of two reads and no inventory browsing or changes. The public client\nID was supplied through the owner's local CLI tenant configuration; its secret\nfield was neither copied nor used. Private-manifest activation follows offline\nvalidation of the new family.\n\nInspection of the actual management verifier found that its credential probe\nreads one latest security-profile entry (`limit=1`, `latest=true`) and discards\nthe response contents. It does not merely obtain a token. The owner explicitly\napproved this single-profile probe, retaining only verification status and call\nmetadata, within the two-read maximum and with no other inventory browsing or\nchanges. The earlier wording above must not be used to imply that it is token-only.\nThe exact bounded operation and input restrictions are now documented under\nL19 in `docs/planning/live-checks.md` and validated by `xtask::live`.\n\nThe offline regression first failed because L19 was an unknown family; it now\naccepts an optional complete designation and rejects scope expansion. This is\ntooling preparation, not a live receipt. The historical `live/blocked.json`\nremains unchanged until an approved actual wizard verification has a separate\nsource-bound receipt.\n{\n  \"schema\": \"airs-v2/l19-additional-grant/1\",\n  \"owner_approval\": \"Compare, refresh if different, allow 1 more probe\",\n  \"recorded_utc\": \"2026-11-01T13:36:31.023213+00:00\",\n  \"condition\": \"local secret differed; named reference corrected and verified\",\n  \"correction_record_sha256\": \"32fa5ff6634794e195a61f2cd86bcfee2be542251447eccf67233aeb045a7350\",\n  \"previous_manifest_sha256\": \"999f95abf2f6fb75f3597c95d7903a385eb7a1e876b99f6d63185378ba24499e\",\n  \"previous_read_reservations\": 2,\n  \"previous_ledger_sha256\": \"45d0456aef4d907dfadfcdf0475ff8126d024d9dfb0e38ab1dc097994fbcd945\",\n  \"new_manifest_sha256\": \"a2dd7b01ed289ed164859ac0daf6e582100de555d29eefb01fa13df87d0bdbe1\",\n  \"additional_read_cap\": 1,\n  \"maximum_cumulative_read_reservations\": 3,\n  \"previous_reservations_refunded\": 0,\n  \"operation\": \"same single latest-profile probe (limit=1), no other inventories or writes\"\n}\n{\n  \"valid\": true,\n  \"manifest_sha256\": \"a2dd7b01ed289ed164859ac0daf6e582100de555d29eefb01fa13df87d0bdbe1\",\n  \"activated_utc\": \"2026-11-01T13:37:53.919960+00:00\",\n  \"previous_read_reservations_preserved\": 2,\n  \"additional_read_cap\": 1,\n  \"validation_log_sha256\": \"281a69f81d8d2441559773e8e43d6416b8f2ccd1e9f49e096f4931a265f425ca\"\n}\n{\n  \"schema\": \"airs-v2/l19-local-credential-correction/1\",\n  \"recorded_utc\": \"2026-11-01T13:35:46.006961+00:00\",\n  \"owner_approval\": \"Compare, refresh if different, allow 1 more probe\",\n  \"reference\": {\n    \"service\": \"io.cdot.prisma-airs-desktop.v2.live\",\n    \"account\": \"mgmt-vulture-client-secret\"\n  },\n  \"source\": \"/Users/cdot/.config/airs-cli/tenants/vulture.toml\",\n  \"source_field\": \"mgmtClientSecret\",\n  \"public_client_id\": \"prisma-airs-cli@1852583913.iam.panserviceaccount.com\",\n  \"tsg_id\": \"1852583913\",\n  \"compared\": true,\n  \"different\": true,\n  \"updated\": true,\n  \"verified\": true,\n  \"secret_values_or_hashes_retained\": false,\n  \"original_read_reservations_retained\": 2,\n  \"additional_probe_permitted_after_correction\": 1\n}\n#[tokio::test]\nasync fn discarding_a_draft_cancels_its_reads_in_flight_and_leaves_the_active_tenant_alone() {\n    let mut desk = desk().await;\n    desk.tenant_a().await;\n    let a_before = desk.snap().gateway;\n    let origin = desk.origin.clone();\n    desk.send(json!({\"kind\": \"beginTenantSetup\", \"mode\": \"add\", \"profile\": {\"label\": \"Tenant B\", \"tsgId\": TSG,\n        \"destination\": {\"kind\": \"custom\", \"origin\": origin}}}))\n        .await\n        .expect(\"draft\");\n    let context = desk.draft_context();\n    desk.send(\n        json!({\"kind\": \"configureManagementCredential\", \"context\": context, \"mode\": \"keychain\",\n        \"clientId\": CLIENT_ID, \"secret\": CLIENT_SECRET}),\n    )\n    .await\n    .expect(\"draft client\");\n    let context = desk.draft_context();\n    assert!(eventually(|| desk.setup().tenant.management.state == ScanState::Ready).await);\n    // The draft's fresh binding must fetch a token first; that request hangs.\n    desk.script\n        .lock()\n        .expect(\"script\")\n        .hang\n        .insert(\"/oauth2/access_token\".to_owned());\n    let Receipt::Admitted {\n        operation: Some(operation),\n        ..\n    } = desk\n        .send(json!({\"kind\": \"management\", \"context\": context,\n            \"request\": {\"kind\": \"gateway\", \"workspace\": null, \"read\": {\"kind\": \"inventory\", \"resource\": \"workspaces\"}}}))\n        .await\n        .expect(\"admitted\")\n    else {\n        panic!(\"no operation\");\n    };\n    desk.send(json!({\"kind\": \"verifyTenantSetup\", \"context\": context}))\n        .await\n        .expect(\"verify started\");\n    tokio::time::sleep(Duration::from_millis(200)).await;\n    desk.send(json!({\"kind\": \"discardTenantSetup\", \"context\": context}))\n        .await\n        .expect(\"discarded while reads were in flight\");\n    // The read queued under the draft settles cancelled, not with a result.\n    let Ok(Observation::Management(handle)) = desk.handle.observe(ViewScope::Management(operation))\n    else {\n        panic!(\"management observation\");\n    };\n    let result = tokio::time::timeout(Duration::from_secs(20), handle.result())\n        .await\n        .expect(\"settled in time\");\n    assert!(\n        matches!(\n            result,\n            ManagementResult::Failed {\n                failure: desktop_core::management::ManagementFailure::Cancelled,\n                ..\n            }\n        ),\n        \"{result:?}\"\n    );\n    desk.script.lock().expect(\"script\").hang.clear();\n    let snap = desk.snap();\n    assert!(snap.setup.is_none());\n    assert_eq!(\n        snap.gateway.selected, a_before.selected,\n        \"A's choice untouched\"\n    );\n    // A's own reads still work under its context and workspace reference.\n    let a_context = desk.active_context();\n    let a_reference = a_before.selected.expect(\"A\").reference;\n    let prerequisites = desk\n        .read(\n            &a_context,\n            json!({\"kind\": \"gateway\", \"workspace\": a_reference, \"read\": {\"kind\": \"prerequisites\"}}),\n        )\n        .await;\n    assert!(\n        matches!(prerequisites, ManagementResult::Gateway { .. }),\n        \"{prerequisites:?}\"\n    );\n}\n\n#[tokio::test]\nasync fn a_replaced_client_authenticates_afresh_and_profile_changes_retire_the_binding() {\n    let mut desk = desk().await;\n    desk.tenant_a().await;\n    let origin = desk.origin.clone();\n    desk.send(json!({\"kind\": \"beginTenantSetup\", \"mode\": \"add\", \"profile\": {\"label\": \"Tenant B\", \"tsgId\": TSG,\n        \"destination\": {\"kind\": \"custom\", \"origin\": origin}}}))\n        .await\n        .expect(\"draft\");\n    let context = desk.draft_context();\n    desk.send(\n        json!({\"kind\": \"configureManagementCredential\", \"context\": context, \"mode\": \"keychain\",\n        \"clientId\": CLIENT_ID, \"secret\": CLIENT_SECRET}),\n    )\n    .await\n    .expect(\"good client\");\n    let context = desk.draft_context();\n    assert!(eventually(|| desk.setup().tenant.management.state == ScanState::Ready).await);\n    desk.send(json!({\"kind\": \"verifyTenantSetup\", \"context\": context}))\n        .await\n        .expect(\"verify\");\n    let v = desk.verified().await;\n    assert_eq!(v.steps[1].state, VerifyState::Pass, \"{}\", v.steps[1].reason);\n    // Replace the secret with one the plane rejects: the cached binding must not pass for it.\n    desk.send(\n        json!({\"kind\": \"configureManagementCredential\", \"context\": context, \"mode\": \"keychain\",\n        \"clientId\": CLIENT_ID, \"secret\": \"wrong-synthetic-secret\"}),\n    )\n    .await\n    .expect(\"replaced client\");\n    let wrong_context = desk.draft_context();\n    assert_ne!(wrong_context, context);\n    assert!(eventually(|| desk.setup().tenant.management.state == ScanState::Ready).await);\n    desk.send(json!({\"kind\": \"verifyTenantSetup\", \"context\": wrong_context}))\n        .await\n        .expect(\"verify\");\n    let v = desk.verified().await;\n    assert_eq!(v.steps[1].state, VerifyState::Fail, \"{}\", v.steps[1].reason);\n    assert!(\n        v.steps[1].reason.contains(\"not accepted\"),\n        \"{}\",\n        v.steps[1].reason\n    );\n    assert!(\n        !v.blocking && desk.setup().completable,\n        \"an optional failure\"\n    );\n    // Remove the client, add the right one back: it authenticates afresh.\n    desk.send(json!({\"kind\": \"removeManagementCredential\", \"context\": wrong_context}))\n        .await\n        .expect(\"removed\");\n    let removed_context = desk.draft_context();\n    assert_ne!(removed_context, wrong_context);\n    assert_eq!(desk.setup().tenant.management.state, ScanState::Missing);\n    desk.send(json!({\"kind\": \"configureManagementCredential\", \"context\": removed_context, \"mode\": \"keychain\",\n        \"clientId\": CLIENT_ID, \"secret\": CLIENT_SECRET}))\n        .await\n        .expect(\"re-added\");\n    let context = desk.draft_context();\n    assert!(eventually(|| desk.setup().tenant.management.state == ScanState::Ready).await);\n    desk.send(json!({\"kind\": \"verifyTenantSetup\", \"context\": context}))\n        .await\n        .expect(\"verify\");\n    let v = desk.verified().await;\n    assert_eq!(v.steps[1].state, VerifyState::Pass, \"{}\", v.steps[1].reason);\n    // A TSG change retires the management credential (it was bound to the TSG) and the context.\n    let origin = desk.origin.clone();\n    desk.send(json!({\"kind\": \"updateTenantSetup\", \"context\": context, \"profile\": {\"label\": \"Tenant B\", \"tsgId\": \"9876543210\",\n        \"destination\": {\"kind\": \"custom\", \"origin\": origin}}}))\n        .await\n        .expect(\"tsg changed\");\n    let setup = desk.setup();\n    assert_ne!(setup.context.as_str(), context);\n    assert_eq!(setup.tenant.tsg_id.as_deref(), Some(\"9876543210\"));\n    assert_eq!(\n        setup.tenant.management.state,\n        ScanState::Missing,\n        \"the client went with the old TSG\"\n    );\n    assert!(setup.verify.is_none());\n    assert_eq!(\n        desk.send(json!({\"kind\": \"verifyTenantSetup\", \"context\": context}))\n            .await,\n        Err(Refusal::StaleContext)\n    );\n}\n15:        pending = json.loads((root / 'docs/planning/evidence/C29/live/L19/attempt-01/wizard-verify.json').read_text())\n16:        self.assertTrue(any(n.get('label') == 'Pending' for n in pending))\n17:        self.assertFalse(driver.verify_finished(pending))\n20:        for label in ['Checks finished; nothing failed.', 'Checks finished with warnings.', 'A required check failed.', 'An optional check failed. You can fix it and verify again, or continue with it recorded as a warning.']:\n22:            self.assertTrue(driver.verify_finished(tree))\n23:            self.assertFalse(driver.verify_finished(tree + [{'role': 'AXStaticText', 'label': 'Checking…'}]))\n","exit_code":0,"status":"completed"}}
