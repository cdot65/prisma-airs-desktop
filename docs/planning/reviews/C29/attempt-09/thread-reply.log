{"type":"item.completed","item":{"id":"item_45","type":"command_execution","command":"/bin/zsh -lc \"cat apps/desktop/src-tauri/capabilities/main.json apps/desktop/src-tauri/tauri.conf.json apps/desktop/src-tauri/tauri.fixture.conf.json apps/desktop/academy-source.ts; sed -n '535,565p' crates/desktop-core/src/management.rs; sed -n '664,700p' crates/desktop-core/src/management.rs; rg -n 'setup|tenant_draft|orphan' crates/desktop-core/src/store.rs | head -65\"","aggregated_output":"{\n  \"$schema\": \"../gen/schemas/desktop-schema.json\",\n  \"identifier\": \"main-window\",\n  \"description\": \"The packaged main window may call only the two application commands.\",\n  \"local\": true,\n  \"windows\": [\"main\"],\n  \"webviews\": [\"main\"],\n  \"permissions\": [\"allow-desktop-dispatch\", \"allow-desktop-observe\"]\n}\n{\n  \"$schema\": \"https://schema.tauri.app/config/2\",\n  \"productName\": \"Prisma AIRS Desktop v2\",\n  \"version\": \"2.0.0\",\n  \"identifier\": \"io.cdot.prisma-airs-desktop.v2\",\n  \"build\": {\n    \"frontendDist\": \"../dist\",\n    \"beforeBuildCommand\": \"\"\n  },\n  \"app\": {\n    \"withGlobalTauri\": false,\n    \"windows\": [],\n    \"security\": {\n      \"csp\": {\n        \"default-src\": \"'self'\",\n        \"script-src\": \"'self'\",\n        \"style-src\": \"'self'\",\n        \"img-src\": \"'self' data:\",\n        \"font-src\": \"'self' data:\",\n        \"connect-src\": \"ipc: http://ipc.localhost\",\n        \"object-src\": \"'none'\",\n        \"base-uri\": \"'none'\",\n        \"form-action\": \"'none'\",\n        \"frame-ancestors\": \"'none'\",\n        \"frame-src\": \"'none'\",\n        \"worker-src\": \"'none'\"\n      },\n      \"dangerousDisableAssetCspModification\": false,\n      \"freezePrototype\": true,\n      \"capabilities\": [\"main-window\"]\n    }\n  },\n  \"bundle\": {\n    \"active\": true,\n    \"targets\": [\"app\", \"dmg\"],\n    \"category\": \"DeveloperTool\",\n    \"copyright\": \"Copyright 2026 cdot\",\n    \"license\": \"Apache-2.0\",\n    \"icon\": [\"icons/32x32.png\", \"icons/128x128.png\", \"icons/128x128@2x.png\", \"icons/icon.icns\", \"icons/icon.png\"],\n    \"macOS\": {\n      \"minimumSystemVersion\": \"13.0\",\n      \"hardenedRuntime\": true\n    }\n  }\n}\n{\n  \"productName\": \"Prisma AIRS Desktop v2 Fixture\",\n  \"identifier\": \"io.cdot.prisma-airs-desktop.v2.fixture\"\n}\n/**\n * Academy learner source compiled into the desktop (C05). The learner\n * package (@ai-security-academy/learner) exports Academy's own pages; their\n * `@/` imports are Academy's source in the prepared, hash-verified input\n * (.work/academy, xtask shared-prepare). Every bare import that source makes\n * resolves to this app's pinned copy (`dedupe`), so one React, one React\n * Query and one router instance exist and versions follow the desktop lock.\n */\n// A file-system path without Node typings in the app's tsconfig (the\n// repository path has no characters that URL-encode other than these).\nexport const ACADEMY_SRC = decodeURIComponent(new URL('../../.work/academy/src', import.meta.url).pathname)\nconst CONTRACTS_ROOT = decodeURIComponent(new URL('../../packages/desktop-contracts/', import.meta.url).pathname)\n\n// node_modules may be shared with another worktree. Compile this checkout's IPC parser and bindings,\n// not the workspace package reached through that other checkout's dependency symlink.\nexport const desktopAliases = [\n    { find: /^@prisma-airs\\/desktop-contracts$/, replacement: `${CONTRACTS_ROOT}src/index.ts` },\n    { find: /^@prisma-airs\\/desktop-contracts\\/fixtures\\//, replacement: `${CONTRACTS_ROOT}fixtures/` },\n    { find: /^@\\//, replacement: `${ACADEMY_SRC}/` },\n]\n\nexport const academyDedupe = [\n    'react',\n    'react-dom',\n    '@ai-security-academy/presentation',\n    '@ai-security-academy/shared',\n    '@codemirror/commands',\n    '@codemirror/lang-python',\n    '@codemirror/lang-yaml',\n    '@codemirror/language',\n    '@codemirror/state',\n    '@codemirror/view',\n    '@dnd-kit/core',\n    '@excalidraw/excalidraw',\n    '@lezer/highlight',\n    '@radix-ui/react-dialog',\n    '@radix-ui/react-slot',\n    '@tanstack/react-query',\n    '@tanstack/react-router',\n    '@trpc/client',\n    '@trpc/react-query',\n    '@trpc/server',\n    'class-variance-authority',\n    'clsx',\n    'dompurify',\n    'lucide-react',\n    'mermaid',\n    'qrcode.react',\n    'sanitize-html',\n    'tailwind-merge',\n    'zustand',\n]\n            for item in map.values_mut() {\n                redact(item);\n            }\n        }\n        Value::Array(items) => {\n            for item in items {\n                redact(item);\n            }\n        }\n        _ => {}\n    }\n}\n\n/// The explicit management client limits.\nfn limits() -> Limits {\n    let mut limits = Limits::default();\n    limits.max_response_bytes = 16 * 1024 * 1024;\n    limits.operation_timeout = READ_DEADLINE;\n    limits.max_retries = 0;\n    limits\n}\n\n/// Management, DLP, Red Team, Model Security and AgentGuard clients bound\n/// to one credential generation.\npub struct ManagementBinding {\n    management: ManagementClient,\n    dlp: DlpClient,\n    red_team: RedTeamClient,\n    model_security: ModelSecurityClient,\n    agentguard: AgentGuardClient,\n    gateway: AIGatewayClient,\n            gateway,\n        })\n    }\n\n    /// The Gateway client over this binding's management credential (C16).\n    pub(crate) fn gateway(&self) -> &AIGatewayClient {\n        &self.gateway\n    }\n\n    pub(crate) fn options(deadline: Instant) -> Option<RequestOptions> {\n        let remaining = deadline.saturating_duration_since(Instant::now());\n        RequestOptions::with_timeout(remaining.max(Duration::from_millis(1)))\n            .and_then(|o| o.with_retries(0))\n            .ok()\n    }\n\n    /// The credential check (v1 `checktenant`): one profile, latest only.\n    pub async fn verify(&self, deadline: Instant) -> Result<(), scm_sdk::Error> {\n        let mut page = PaginationOptions::default();\n        page.limit = 1;\n        page.latest = Some(true);\n        self.management\n            .profiles()\n            .list(page, Self::options(deadline).as_ref())\n            .await\n            .map(|_| ())\n    }\n\n    /// One page of `resource`, normalized.\n    pub async fn page(\n        &self,\n        resource: ManagementResource,\n        offset: u32,\n        limit: u32,\n        deadline: Instant,\n    ) -> Result<ManagementPage, PageError> {\n        let options = Self::options(deadline);\n168:    /// Keychain records to delete (replaced, signed out, orphaned or reset).\n218:    /// A tenant setup in progress when the document was written (C29). It\n221:    pub tenant_draft: Option<StoredDraft>,\n243:/// One tenant's recorded setup warnings (C29).\n287:            tenant_draft: None,\n310:        // A credential belongs to a tenant, or to the setup draft that was\n315:            .chain(self.tenant_draft.as_ref().map(|d| &d.profile))\n351:        let draft_ok = self.tenant_draft.as_ref().is_none_or(|d| {\n766:    fn a_setup_draft_and_its_credential_round_trip_through_the_file_store() {\n774:        doc.tenant_draft = Some(StoredDraft {\n797:        // A draft colliding with a tenant id, or an orphan record, is not.\n799:        colliding.tenant_draft.as_mut().expect(\"draft\").profile.id = doc.tenants[0].id.clone();\n801:        let mut orphan = doc.clone();\n802:        orphan.tenant_draft = None;\n804:            !orphan.is_consistent(),\n","exit_code":0,"status":"completed"}}
