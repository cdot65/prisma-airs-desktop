{"type":"item.completed","item":{"id":"item_38","type":"command_execution","command":"/bin/zsh -lc \"sed -n '1,150p' crates/desktop-core/tests/ui_v2_setup_reads/main.rs; sed -n '553,685p' apps/desktop/src-tauri/tests/ipc_admission.rs; ls target/debug/deps/ui_v2_onboarding-* target/debug/deps/ipc_admission-*\"","aggregated_output":"//! C29 (D058): a setup draft's reads over the real management pipeline\n//! against a synthetic management plane, beside an active tenant: the\n//! draft's Gateway listing and choice never touch the active tenant's, its\n//! verify lines settle from real reads (management verify, the chosen\n//! workspace's prerequisites), an optional service's failure is carried as\n//! a warning the operator may continue over, and a discard leaves the\n//! active tenant exactly as it was.\n\n#[allow(dead_code)]\n#[path = \"../context_credentials/support.rs\"]\nmod support;\n\nuse std::collections::{BTreeMap, BTreeSet};\nuse std::sync::{Arc, Mutex};\nuse std::time::Duration;\n\nuse desktop_core::features::{ProductId, VerifyLine, VerifyState};\nuse desktop_core::fixtures::{self, Handles};\nuse desktop_core::management::{ManagementEndpoints, ManagementResult};\nuse desktop_core::transport::{ProxyMode, TransportPolicy};\nuse desktop_core::{\n    AuthorityHandle, Core, CoreConfig, Delivery, Intent, Observation, Receipt, Refusal, ScanState,\n    ShellSnapshot, ViewScope,\n};\nuse serde_json::{Value, json};\n\nuse crate::support::{Reply, Seen, TestCa, TlsServer, eventually};\n\nconst CLIENT_ID: &str = \"synthetic-client@1234567890.iam.panserviceaccount.com\";\nconst CLIENT_SECRET: &str = \"synthetic-client-secret-c16\";\nconst TSG: &str = \"1234567890\";\nconst DATA: &str = \"/ai_gw/v2\";\nconst ADMIN: &str = \"/ai_gw/admin/v2\";\nconst IAM: &str = \"/iam/v1\";\nconst WS_A: &str = \"16f7e90d-382a-4e78-b577-1b01eb5f8297\";\nconst WS_B: &str = \"16f7e90d-382a-4e78-b577-1b01eb5f8298\";\nconst PROVIDER: &str = \"7e3a0000-0000-4000-8000-000000000001\";\nconst ROUTE: &str = \"7e3a0000-0000-4000-8000-000000000002\";\nconst GUARDRAIL: &str = \"7e3a0000-0000-4000-8000-000000000003\";\nconst SERVICE_KEY: &str = \"7e3a0000-0000-4000-8000-000000000004\";\nconst USER_KEY: &str = \"7e3a0000-0000-4000-8000-000000000005\";\nconst INTEGRATION: &str = \"f6692544-3265-49be-9711-bbdcebc079eb\";\n\n/// What the synthetic planes answer: a status and body per path; requests\n/// whose target is listed in `hang` are never answered.\n#[derive(Default)]\nstruct Script {\n    routes: BTreeMap<String, (u16, Value)>,\n    hang: BTreeSet<String>,\n    /// What the token endpoint answers (200 grants; 401 refuses the client).\n    token_status: u16,\n}\n\nimpl Script {\n    fn route(&self, seen: &Seen) -> Reply {\n        let target = seen.request_line.split(' ').nth(1).unwrap_or(\"\").to_owned();\n        let path = target.split('?').next().unwrap_or(\"\");\n        if self.hang.contains(&target) {\n            return Reply::Hang;\n        }\n        let (status, body) = if path == \"/oauth2/access_token\" {\n            // The plane checks the client's Basic credentials: a replaced or\n            // wrong secret is refused, so a cached binding cannot pass for it.\n            let expected = basic(CLIENT_ID, CLIENT_SECRET);\n            let presented = seen.header(\"authorization\").unwrap_or(\"\");\n            if self.token_status == 200 && presented == expected {\n                (\n                    200,\n                    json!({\"access_token\": \"mgmt-access\", \"token_type\": \"Bearer\", \"expires_in\": 3600}),\n                )\n            } else {\n                // A wrong client, or a plane told to refuse grants: 401.\n                let status = if self.token_status == 200 {\n                    401\n                } else {\n                    self.token_status\n                };\n                (\n                    status,\n                    json!({\"error\": \"invalid_client\", \"error_description\": \"SERVER-TEXT-NEVER-SHOWN\"}),\n                )\n            }\n        } else {\n            let key = match path.strip_prefix(DATA) {\n                Some(rest) => format!(\"{rest}?{}\", target.split('?').nth(1).unwrap_or(\"\")),\n                None => path.to_owned(),\n            };\n            self.routes\n                .get(&key)\n                .or_else(|| self.routes.get(path))\n                .cloned()\n                .unwrap_or((404, json!({\"error\": \"not found\"})))\n        };\n        let body = serde_json::to_vec(&body).expect(\"json\");\n        Reply::Raw {\n            head: format!(\n                \"HTTP/1.1 {status} Status\\r\\ncontent-type: application/json\\r\\ncontent-length: {}\\r\\nconnection: close\",\n                body.len()\n            ),\n            body,\n        }\n    }\n}\n\n/// RFC 6749 2.3.1: both parts are form-urlencoded, then Basic-encoded.\nfn basic(user: &str, secret: &str) -> String {\n    const ALPHABET: &[u8; 64] = b\"ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/\";\n    let form = |text: &str| -> String {\n        text.bytes()\n            .map(|b| match b {\n                b'A'..=b'Z' | b'a'..=b'z' | b'0'..=b'9' | b'-' | b'.' | b'_' | b'~' => {\n                    (b as char).to_string()\n                }\n                b' ' => \"+\".to_owned(),\n                _ => format!(\"%{b:02X}\"),\n            })\n            .collect()\n    };\n    let input = format!(\"{}:{}\", form(user), form(secret));\n    let bytes = input.as_bytes();\n    let mut out = String::new();\n    for chunk in bytes.chunks(3) {\n        let b = [\n            chunk[0],\n            *chunk.get(1).unwrap_or(&0),\n            *chunk.get(2).unwrap_or(&0),\n        ];\n        let n = (u32::from(b[0]) << 16) | (u32::from(b[1]) << 8) | u32::from(b[2]);\n        for i in 0..4 {\n            if i <= chunk.len() {\n                out.push(ALPHABET[((n >> (18 - 6 * i)) & 63) as usize] as char);\n            } else {\n                out.push('=');\n            }\n        }\n    }\n    format!(\"Basic {out}\")\n}\n\nfn workspace(id: &str, name: &str, slug: &str) -> Value {\n    json!({\"id\": id, \"slug\": slug, \"name\": name, \"icon\": null, \"description\": null,\n           \"created_at\": \"2026-10-01T00:00:00Z\", \"last_updated_at\": \"2026-10-02T00:00:00Z\",\n           \"is_default\": 0, \"status\": \"active\", \"scope_name\": format!(\"scope-{slug}\"),\n           \"object\": \"workspace\"})\n}\n\nfn listing(rows: Vec<Value>, total: usize, more: Option<bool>) -> Value {\n    let mut reply = json!({\"object\": \"list\", \"total\": total, \"success\": true, \"data\": rows});\n    if let Some(more) = more {\n        reply[\"has_more\"] = json!(more);\nfn setup_draft_intents_cross_ipc_without_echoing_secrets_or_creating_tenants() {\n    let h = harness();\n    let session = register(&h);\n    let begun = send(\n        &h,\n        &session,\n        1,\n        json!({\"kind\": \"beginTenantSetup\", \"mode\": \"add\", \"profile\": {\n        \"label\": \"Drafted\", \"tsgId\": \"1234567890\", \"destination\": {\"kind\": \"region\", \"region\": \"europe\"},\n        \"environment\": \"staging\"}}),\n    );\n    assert_eq!(begun.expect(\"begun\")[\"outcome\"], \"receipt\");\n    let snap = snapshot(&h, 20);\n    assert_eq!(\n        snap[\"tenants\"].as_array().map(Vec::len),\n        Some(0),\n        \"a draft is not a tenant\"\n    );\n    assert!(snap[\"active\"].is_null());\n    let setup = &snap[\"setup\"];\n    assert_eq!(setup[\"mode\"], \"add\");\n    assert_eq!(setup[\"tenant\"][\"environment\"], \"staging\");\n    assert_eq!(setup[\"scanRequired\"], false);\n    let context = setup[\"context\"].as_str().expect(\"draft context\").to_owned();\n    let key = \"synthetic-ipc-draft-scan-key-0042\";\n    let secret = \"synthetic-ipc-draft-client-secret-0042\";\n    let stored = send(\n        &h,\n        &session,\n        2,\n        json!({\"kind\": \"configureScanCredential\", \"context\": context, \"mode\": \"session\", \"key\": key}),\n    )\n    .expect(\"admitted\");\n    assert_eq!(stored[\"outcome\"], \"receipt\");\n    assert!(!stored.to_string().contains(key));\n    // The scan key retired the draft's context (a credential change always does).\n    let context = snapshot(&h, 21)[\"setup\"][\"context\"]\n        .as_str()\n        .expect(\"fresh draft context\")\n        .to_owned();\n    let client = send(\n        &h,\n        &session,\n        3,\n        json!({\"kind\": \"configureManagementCredential\", \"context\": context, \"mode\": \"session\",\n        \"clientId\": \"svc@1234567890.iam.example\", \"secret\": secret}),\n    )\n    .expect(\"admitted\");\n    assert!(!client.to_string().contains(secret));\n    assert!(eventually(|| {\n        let s = snapshot(&h, 21);\n        s[\"setup\"][\"tenant\"][\"scan\"][\"state\"] == \"ready\"\n            && s[\"setup\"][\"tenant\"][\"management\"][\"state\"] == \"ready\"\n    }));\n    let snap = snapshot(&h, 22);\n    let text = snap.to_string();\n    assert!(\n        !text.contains(key) && !text.contains(secret),\n        \"no snapshot carries a secret\"\n    );\n    assert_eq!(\n        snap[\"setup\"][\"tenant\"][\"management\"][\"clientId\"],\n        \"svc@1234567890.iam.example\"\n    );\n    assert_eq!(\n        snap[\"tenants\"].as_array().map(Vec::len),\n        Some(0),\n        \"still not a tenant\"\n    );\n    assert!(\n        h.adapters.vault.calls().is_empty(),\n        \"session-only never reaches the Keychain\"\n    );\n    // (Verification is not run here: the fixture host has no synthetic management plane,\n    // and a routine host test must never reach a product service; the core and reads\n    // suites cover it.) Each credential change retired the draft's context: re-read it.\n    let context = snapshot(&h, 24)[\"setup\"][\"context\"]\n        .as_str()\n        .expect(\"fresh draft context\")\n        .to_owned();\n    let discarded = send(\n        &h,\n        &session,\n        4,\n        json!({\"kind\": \"discardTenantSetup\", \"context\": context}),\n    )\n    .expect(\"discard\");\n    assert_eq!(discarded[\"outcome\"], \"receipt\");\n    let snap = snapshot(&h, 25);\n    assert!(snap[\"setup\"].is_null());\n    assert_eq!(snap[\"tenants\"].as_array().map(Vec::len), Some(0));\n    let stale = send(\n        &h,\n        &session,\n        5,\n        json!({\"kind\": \"verifyTenantSetup\", \"context\": context}),\n    );\n    assert_eq!(\n        stale.expect(\"refusal\"),\n        json!({\"outcome\": \"refusal\", \"refusal\": \"staleContext\"})\n    );\n}\ntarget/debug/deps/ipc_admission-34efbb4681e194e4\ntarget/debug/deps/ipc_admission-34efbb4681e194e4.0ab7685lu668sfustychnfmp8.0goqnly.rcgu.o\ntarget/debug/deps/ipc_admission-34efbb4681e194e4.0ab7685lu668sfustychnfmp8.156cylg.rcgu.o\ntarget/debug/deps/ipc_admission-34efbb4681e194e4.0ab7685lu668sfustychnfmp8.1dvqm2s.rcgu.o\ntarget/debug/deps/ipc_admission-34efbb4681e194e4.0ab7685lu668sfustychnfmp8.1vgas59.rcgu.o\ntarget/debug/deps/ipc_admission-34efbb4681e194e4.0h8u8l6s0pokmqwvku33jr0l3.0goqnly.rcgu.o\ntarget/debug/deps/ipc_admission-34efbb4681e194e4.0h8u8l6s0pokmqwvku33jr0l3.156cylg.rcgu.o\ntarget/debug/deps/ipc_admission-34efbb4681e194e4.0h8u8l6s0pokmqwvku33jr0l3.1dvqm2s.rcgu.o\ntarget/debug/deps/ipc_admission-34efbb4681e194e4.0h8u8l6s0pokmqwvku33jr0l3.1vgas59.rcgu.o\ntarget/debug/deps/ipc_admission-34efbb4681e194e4.0hz00jvzu17d2bsxidvszgrx3.0goqnly.rcgu.o\ntarget/debug/deps/ipc_admission-34efbb4681e194e4.0hz00jvzu17d2bsxidvszgrx3.156cylg.rcgu.o\ntarget/debug/deps/ipc_admission-34efbb4681e194e4.0hz00jvzu17d2bsxidvszgrx3.1dvqm2s.rcgu.o\ntarget/debug/deps/ipc_admission-34efbb4681e194e4.0hz00jvzu17d2bsxidvszgrx3.1vgas59.rcgu.o\ntarget/debug/deps/ipc_admission-34efbb4681e194e4.0idaa1s8mmjtfuo2txykdkbn2.0goqnly.rcgu.o\ntarget/debug/deps/ipc_admission-34efbb4681e194e4.0idaa1s8mmjtfuo2txykdkbn2.156cylg.rcgu.o\ntarget/debug/deps/ipc_admission-34efbb4681e194e4.0id