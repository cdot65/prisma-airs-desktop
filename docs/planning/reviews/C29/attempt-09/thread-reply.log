\"cancelled_rows_unchanged\": true,\n  \"cancelled_active_unchanged\": true,\n  \"cancelled_key_deleted\": true,\n  \"secret_confinement\": true\n}\ncoverage keys ['behavior', 'layouts', 'errors']\nlayouts 48\nsample {\n  \"overflow_px\": 0,\n  \"horizontal_scrollbars\": 0,\n  \"mode\": \"firstRun\",\n  \"step\": \"welcome\",\n  \"theme\": \"Light\",\n  \"zoom\": 1,\n  \"geometry\": {\n    \"web\": [\n      1440,\n      900\n    ],\n    \"viewport\": [\n      1440,\n      900\n    ],\n    \"window\": [\n      1440,\n      932\n    ]\n  },\n  \"primary\": {\n    \"label\": \"Set up a tenant\",\n    \"size\": [\n      133,\n      32\n    ],\n    \"inside\": true,\n    \"size_ok\": true,\n    \"ok\": true,\n    \"zoom\": 1\n  },\n  \"dialog\": false,\n  \"keyboard\": {\n    \"walk\": [\n      {\n        \"role\": \"AXButton\",\n        \"label\": \"Set up a tenant\",\n        \"in_scope\": true\n      }\n    ],\n    \"primary_reached\": true,\n    \"contained\": true\n  },\n  \"capture\": \"docs/planning/evidence/P09/native/cumulative/C43/native/captures/wizard-firstRun-welcome-1440x900-100-light.png\",\n  \"tree\": \"docs/planning/evidence/P09/native/cumulative/C43/native/tree-wizard-firstRun-welcome-1440x900-100-light.json\",\n  \"capture_sha256\": \"88382dad9bc8d6c5992c5cd93ec10d3807fad6d92f2200d10ddd37ecfcc6d015\",\n  \"tree_sha256\": \"6b2776a03c452a8af002e1b3043283ec7babcb6345ff69fa4253051fdceebee8\"\n}\nother details {\n  \"errors\": []\n}\n","exit_code":0,"status":"completed"}}
