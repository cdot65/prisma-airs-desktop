&tenant) {\n+                return Err(Refusal::StaleContext);\n+            }\n             // The one switch path (I1): a pending Harness decision refuses\n             // it until the operator resolves the conversation.\n-            if let Err(refusal) = state.guard_switch(&tenant, resolution, false) {\n+            if let Err(refusal) = state.guard_switch(&tenant, resolution, None) {\n                 state.changed();\n                 return Err(refusal);\n             }\n@@ -6167,6 +6185,17 @@ fn wall_secs(clock_offset: u32) -> u32 {\n         .saturating_add(clock_offset)\n }\n \n+#[cfg(feature = \"test-fixtures\")]\n+impl Core {\n+    /// Whether an armed fixture interruption is still waiting for its exact\n+    /// commit point. Read-only; tests must not simulate exit before it fires.\n+    pub fn v1_import_interruption_pending(&self) -> bool {\n+        lock(&self.inner)\n+            .map(|state| state.v1_import.interrupt_at.is_some())\n+            .unwrap_or(true)\n+    }\n+}\n+\n #[cfg(test)]\n mod tests {\n     use super::*;\ndiff --git a/crates/desktop-core/src/authority/inbox_domain.rs b/crates/desktop-core/src/authority/inbox_domain.rs\nindex 0568f5f8..1f2facd6 100644\n--- a/crates/desktop-core/src/authority/inbox_domain.rs\n+++ b/crates/desktop-core/src/authority/inbox_domain.rs\n@@ -14,6 +14,7 @@ use super::observation_domain::{\n     source_names,\n };\n use super::{PendingDecisionRef, Refusal, State, SwitchBlocked};\n+use crate::context::{ContextRef, ReviewId};\n use crate::features::{FeatureId, ProductId, SetupWarning};\n use crate::management::{ManagementFailure, ManagementResource};\n use crate::observation::{Fact, InboxDestination, InboxItem, Tone};\n@@ -21,11 +22,17 @@ use crate::tenants::TenantId;\n \n /// How a blocked switch is resolved (I1): the pending conversation is\n /// ended and kept (`archive`) or ended and dropped (`discard`).\n-#[derive(Clone, Copy, Debug, PartialEq, Eq, Serialize, Deserialize, TS)]\n-#[serde(rename_all = \"camelCase\")]\n+#[derive(Clone, Debug, PartialEq, Eq, Serialize, Deserialize, TS)]\n+#[serde(tag = \"kind\", rename_all = \"camelCase\", deny_unknown_fields)]\n pub enum SwitchResolution {\n-    Archive,\n-    Discard,\n+    Archive {\n+        context: ContextRef,\n+        review: ReviewId,\n+    },\n+    Discard {\n+        context: ContextRef,\n+        review: ReviewId,\n+    },\n }\n \n /// Where an Inbox entry came from.\n@@ -350,33 +357,46 @@ impl State {\n         &mut self,\n         to: &TenantId,\n         resolution: Option<SwitchResolution>,\n-        completion: bool,\n+        target_context: Option<&ContextRef>,\n     ) -> Result<(), Refusal> {\n+        if let Some(resolution) = resolution {\n+            let (context, review) = match &resolution {\n+                SwitchResolution::Archive { context, review }\n+                | SwitchResolution::Discard { context, review } => (context, review),\n+            };\n+            // A resolution names one native refusal, never whichever\n+            // conversation happens to be pending when a lost delivery retries.\n+            let blocked = self.switch_blocked.as_ref().ok_or(Refusal::StaleContext)?;\n+            if self.active_ref.as_ref() != Some(context)\n+                || &blocked.context != context\n+                || &blocked.review != review\n+                || &blocked.to != to\n+                || blocked.target_context.as_ref() != target_context\n+                || Some(&blocked.pending) != self.pending_decision().as_ref()\n+            {\n+                return Err(Refusal::StaleContext);\n+            }\n+            let id = self.live_bound_harness().ok_or(Refusal::StaleContext)?;\n+            match resolution {\n+                SwitchResolution::Archive { .. } => self.end_harness(&id)?,\n+                SwitchResolution::Discard { .. } => self.discard_harness(&id)?,\n+            }\n+            self.switch_blocked = None;\n+            return Ok(());\n+        }\n         let Some(pending) = self.pending_decision() else {\n             self.switch_blocked = None;\n             return Ok(());\n         };\n-        let id = self.live_bound_harness().ok_or(Refusal::Busy)?;\n-        match resolution {\n-            None => {\n-                self.switch_blocked = Some(SwitchBlocked {\n-                    to: to.clone(),\n-                    pending,\n-                    completion,\n-                });\n-                Err(Refusal::DecisionPending)\n-            }\n-            Some(SwitchResolution::Archive) => {\n-                self.end_harness(&id)?;\n-                self.switch_blocked = None;\n-                Ok(())\n-            }\n-            Some(SwitchResolution::Discard) => {\n-                self.discard_harness(&id)?;\n-                self.switch_blocked = None;\n-                Ok(())\n-            }\n-        }\n+        self.switch_blocked = Some(SwitchBlocked {\n+            to: to.clone(),\n+            pending,\n+            completion: target_context.is_some(),\n+            context: self.active_ref.clone().ok_or(Refusal::StaleContext)?,\n+            review: ReviewId::issue().ok_or(Refusal::ShuttingDown)?,\n+            target_context: target_context.cloned(),\n+        });\n+        Err(Refusal::DecisionPending)\n     }\n \n     /// The active tenant's setup warnings as items.\ndiff --git a/packages/desktop-contracts/src/client.ts b/packages/desktop-contracts/src/client.ts\nindex ff8c31f2..751ad5b4 100644\n--- a/packages/desktop-contracts/src/client.ts\n+++ b/packages/desktop-contracts/src/client.ts\n@@ -2879,6 +2879,12 @@ export function parseShellSnapshot(value: unknown): ShellSnapshot {\n         !optional(\n             (g) =>\n                 isRecord(g) &&\n+                typeof g.context === 'string' &&\n+                CONTEXT_REF.test(g.context) &&\n+                isRecord(value.active) &&\n+                g.context === value.active.context &&\n+                typeof g.review === 'string' &&\n+                REVIEW_ID.test(g.review) &&\n                 typeof g.to === 'string' &&\n                 TENANT_ID.test(g.to) &&\n                 isRecord(g.pending) &&\n@@ -2886,7 +2892,10 @@ export function parseShellSnapshot(value: unknown): ShellSnapshot {\n                 g.pending.conversation.length > 0 &&\n                 typeof g.pending.decision === 'string' &&\n                 g.pending.decision.length > 0 &&\n-                typeof g.completion === 'boolean',\n+                typeof g.completion === 'boolean' &&\n+                (g.completion\n+                    ? typeof g.targetContext === 'string' && CONTEXT_REF.test(g.targetContext) && isRecord(value.setup) && isRecord(value.setup.tenant) && g.targetContext === value.setup.context && g.to === value.setup.tenant.id\n+                    : g.targetContext === null),\n             value.switchBlocked\n         ) ||\n         // C29: the tenant setup in progress, with its draft and verification.\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_57","type":"command_execution","command":"/bin/zsh -lc 'cat docs/architecture/ui-v2/screens/harness.md docs/architecture/ui-v2/screens/reviews-administration.md'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_57","type":"command_execution","command":"/bin/zsh -lc 'cat docs/architecture/ui-v2/screens/harness.md docs/architecture/ui-v2/screens/reviews-administration.md'","aggregated_output":"# Harness\n\nSource: `R2App` (`CONVOS` blocks/mcp/keys at lines 760–790, `decs`, `ended`,\n`archiveActive`, `sendDraft`, `startNewConvo`, `convoHint`, `follows`),\nboards R2Harness, R2Harness2, R2Harness3. Chunk: C32.\n\nThe screen is a re-skin of the existing Harness engine, sessions, decisions,\nMCP and sign-in modules (C19–C22); the conversation, decision and project\nauthority model is unchanged. D014's Harness restrictions hold: a proposal\nnever authorises Apply.\n\n## Layout\n\n- Title row \"Harness\" with tenant and engine status; left rail of\n  conversations (lifecycle seeds appear only on non-fresh fixture tenants;\n  user conversations titled from their first message; archived ones marked\n  ended); main transcript; one composer per tenant and workspace (its draft kept across navigation, tenant round trips and a conversation's retirement), with messages that reached no conversation, or whose delivery was not confirmed, kept apart for recovery and never sent by themselves (provenance P50).\n- Prerequisites checklist (tenant, management client, Gateway workspace,\n  company sign-in) stays visible until satisfied (D057 F05).\n\n## Lifecycles (fixture conversations)\n\nAll three are **read-only** tool-call lifecycles in the prototype; none\nwrites to a tenant from the Harness.\n\n1. **blocks** — \"Why were 14 prompts blocked on claims-triage overnight?\":\n   read-only tool call `list_security_events` (in-page Approve once /\n   Decline), result summary, recommendation, follow-up \"Open the review\"\n   that opens the injection-override topic review in Administration\n   (Runtime Security, `ChangeKind::Topics`).\n2. **mcp** — \"Which laptops run an MCP server that is not on the allow\n   list?\": in the prototype the read-only call targets an AES inventory.\n   AES has no admitted service (DESIGN-V2 §6), so the implemented fixture\n   reads the workspace MCP server inventory the core already exposes\n   (`GatewayRead::McpServers`, C22) and its follow-up opens a Gateway\n   guardrail review (`ChangeKind::GatewayGuardrails`). Recorded as\n   deviation P16.\n3. **keys** — \"Which API keys expire before the audit, and can you rotate\n   them?\": read-only key inventory; the Harness refuses to rotate (\"rotation\n   is a write; it goes through Administration and a review\") and hands off\n   to the key rotation flow. The follow-up text reflects the rotation stage\n   (additional key issued / old key removed).\n\nEach has approve, decline, end and follow-up paths. Declining records the\ndecision and the assistant's declined text; ending seals the session\n(`endConversation` → archive id) and the rail shows it ended.\n\nTool-call approval stays as C21/C22 built it: the core decides from the\ntool's write flag whether the host's native confirmation sheet is required;\nread-only calls use the in-page bar. No P09 fixture exercises a write-capable\ncall; the native sheet path is covered by the existing C21 tests.\n\n## Rules\n\n- A fresh tenant's first send creates a user conversation (I12); sending in\n  an ended conversation creates a new one.\n- Contextual navigation into an ended conversation shows a hint with \"Open\n  the saved transcript\" (archived transcript detail) and \"Start a new\n  investigation\" (new conversation prefilled with the opening question). The\n  hint clears on any navigation.\n- A pending decision blocks tenant switch (I1).\n\n## Fixtures and tests\n\n- Boards R2Harness (blocks), R2Harness2 (mcp), R2Harness3 (keys). Tests\n  V2-R01, V2-T01, T13; V2-T17 approve/decline/end/follow-up per lifecycle;\n  V2-T18 the keys lifecycle never dispatches a mutation from the Harness.\n# Reviews, Administration and key rotation\n\nSource: `R2App` (`REVIEWS` line 826, `rvKind`, `canApply`, `doApply`,\n`appliedKey`, `appliedOther`, `TOPICS`, `PROFILES`, `verdictFor`, `T` admin\ntables, API keys row actions). Chunk: C31. Every change goes through the\nexisting Configuration review (`changes.rs`, D014): the review binds tenant,\ncredentials, resource and draft, and changed context invalidates it.\n\n## Administration\n\n- Accordion of the products in DESIGN-V2 §6. Each admitted product expands to\n  tabs from `AdminInventory`, generated from the complete table in\n  [administration-inventory.md](administration-inventory.md): every tab is\n  mapped to an admitted read and every creation or row action to an admitted\n  `ChangeKind` + `ChangeAction` with its label, and every denied action,\n  unavailable tab and removed tab is named there. A product or tab with no\n  admitted service renders as **Not available in this release** with the\n  dependency it waits on; it never shows invented inventory and never offers\n  a mutation (V2-T20, V2-R11).\n- Tables: columns per tab, row actions \"Edit…\", \"Rotate…\", \"Finish\n  rotation…\", \"View\", \"Results\". Read-only products (Red Team, Model/skill)\n  never offer a change.\n- Security profiles and Custom topics derive \"Used by\" from one topic\n  inventory; detector ids and topic keys are distinct types.\n\n## Review (I3)\n\n- Opened by `openReview{kind, action, resource}`; the scope carries tenant,\n  resource, before/after diff lines, impact (from `changes::impact`), and the\n  typed-name requirement.\n- The UI shows the diff, impact, a text field \"Type <name> to confirm\" and\n  Apply (disabled until match). `confirmReview{review_id, typed}` is\n  validated in the core: wrong name, different tenant or changed context\n  refuses with the reason, and the UI shows a warn toast naming the tenant.\n- Applied panel (non-key): \"Live. The item was read back.\" with name,\n  revision, time, tenant. Done. Unknown outcome renders the existing\n  \"not confirmed\" state with the reconciliation step, never a success.\n- Any review exit (Done, Escape, tenant switch, context retirement) calls\n  `ForgetSecret` for any held one-time key and resets `secretVisible` (I6).\n\n## Key rotation (I6, I7) — supported sequence\n\nThe prototype promised a grace period with a later revocation and a secret\nrecoverable from the Keychain. The retained core supports neither as one\noperation: `ChangeAction::Rotate` regenerates a key in place (no grace), and\n`ChangeAction::Version` creates an additional key while the existing one is\nunchanged (`changes.rs` 842–846, `management.rs` 980–988). Issued keys are\nheld per result for the active context only and never persisted\n(DESIGN.md \"Secrets\"). The implemented flow therefore uses the two admitted\noperations in sequence and never stores a secret. It applies to Runtime\nSecurity API keys only: Gateway service and user keys admit `Rotate`\n(regenerate in place) and not `Version`, so they get the plain \"Rotate…\"\nreview with the existing one-time reveal and no staged sequence\n(administration-inventory.md):\n\n1. **Issue an additional key** — review `ApiKeys · Version` for the\n   application. On apply the core reads the key back, holds the one-time\n   secret in the zeroizing buffer, and the panel reads **Additional key\n   issued · old key still active**: Reveal (host `RevealSecret` sheet, 60 s,\n   selectable label) and Copy (host clipboard with marker, cleared after\n   60 s); note \"Shown once. Not stored by this app; if lost, issue another\n   key\"; actions **Finish later** / **Application updated**. Side effects:\n   Inbox item `rotation-<application>` (Needs action, \"Update\n   support-copilot with the new key, then remove the old key\"), with a\n   snooze that returns in 24 hours and no invented deadline; the key table\n   shows both keys, the old one marked \"Replace after deployment\".\n2. **Resumed** — panel reads **Rotation in progress · secret no longer\n   available**: \"The new key was shown once when it was issued and this app\n   does not keep it. If support-copilot does not have it, issue another key.\"\n   Actions: **Issue another key** (returns to step 1) / **Application\n   updated**.\n3. **Application updated** — records a *local* deployment acknowledgement\n   with its time (\"Deployment acknowledged 07:51 by you on this Mac\"; this is\n   the operator's statement, not remote evidence) and opens the review\n   `ApiKeys · Delete` for the old key.\n4. **Old key removed** — on apply the core performs the delete and reads\n   back; absent is the expected readback and the panel reads **Rotation\n   complete · old key removed 07:52** with the readback time stored once and\n   never recomputed. The Inbox item clears and the completion toast fires.\n   An unknown delete outcome shows the reconciliation state and keeps the\n   Inbox item.\n\nTwo timestamps are kept and labelled distinctly: `deployment_acknowledged_at`\n(local statement) and `old_key_removed_at` (remote readback). Neither is\nderived from read counts. `ChangeAction::Rotate` (regenerate in place) stays\navailable from the key row as \"Regenerate…\" with the existing impact text\n\"Replaces this key; update every integration using it\"; it is not called\nrotation in the UI.\n\n## Playground verdicts\n\n- Detector results and topic matches are independent. A profile without the\n  detector, or without the topic assigned, yields \"Not detected\" with the\n  reason; monitor-only turns Blocked into Flagged; applying a topic never\n  suppresses an enabled detector. The applied topic's example prompts\n  classify under the topic and show Flagged when assigned.\n\n## Fixtures and tests\n\n- Boards R2Admin, R2Review. Tests V2-R03 (confirmReview refusals), V2-R06\n  (held key dropped on every review exit, tenant switch and context\n  retirement; Reveal after drop refuses), V2-R07 (rotation state machine:\n  Version → acknowledge → Delete → readback, with these named failure\n  cases: (a) failed issuance: refusal shown, no key held, no Inbox item;\n  (b) unknown issuance (uncertain Version outcome): state \"issuance not\n  confirmed\" with the existing reconciliation read of the application's key\n  inventory, no automatic reissue, no Inbox item until a key is read back;\n  (c) rejected or failed Delete: the reminder stays, the old key stays listed,\n  `old_key_removed_at` stays unset and the panel stays at stage 3 with the\n  refusal reason; (d) unknown Delete outcome: \"removal not confirmed\" with\n  reconciliation by readback, reminder retained; (e) both timestamps stable\n  across reads and tenant switches), V2-T03, T06 (resumed panel has no secret\n  controls), T07 (Inbox item lifecycle), T08 (timestamps labelled and\n  stable), V2-T19 (unavailable product renders no inventory and no action).\n- Live (C31 only): one topic review apply and read-back against the\n  change-allowed tenant under the `airs-v2-c25-` prefix, with cleanup. Key\n  issuance and deletion are not run live in P09; they are covered by the\n  C09 fixtures and the existing C25 L-rows.\n","exit_code":0,"status":"completed"}}
