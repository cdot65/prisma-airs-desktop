{"type":"item.completed","item":{"id":"item_36","type":"command_execution","command":"/bin/zsh -lc \"sed -n '330,425p' crates/desktop-core/src/authority/inbox_domain.rs; sed -n '2140,2190p' crates/desktop-core/src/authority.rs; cat docs/planning/evidence/P09/native/cumulative/C43/execution.json\"","aggregated_output":"        } else {\n            ProductReadState::Failed\n        },\n        sources_read: 0,\n        sources_total: names.len() as u32,\n        detail: Some(match f.failure {\n            Some(failure) => format!(\"{failure:?}: {}{older}\", f.detail),\n            None => format!(\"{}{older}\", f.detail),\n        }),\n    }\n}\n\nimpl State {\n    /// The decision the active tenant's conversation is waiting for, if any.\n    pub(super) fn pending_decision(&self) -> Option<PendingDecisionRef> {\n        let conversation = self.live_bound_harness()?;\n        let approvals = self.bound_approvals();\n        let first = approvals.first()?;\n        Some(PendingDecisionRef {\n            conversation: conversation.as_str().to_owned(),\n            decision: first.id.clone(),\n        })\n    }\n\n    /// Admits a tenant switch, or refuses it while a decision is pending\n    /// (I1): the refusal carries the guard the presentation renders.\n    pub(super) fn guard_switch(\n        &mut self,\n        to: &TenantId,\n        resolution: Option<SwitchResolution>,\n        target_context: Option<&ContextRef>,\n    ) -> Result<(), Refusal> {\n        if let Some(resolution) = resolution {\n            let (context, review) = match &resolution {\n                SwitchResolution::Archive { context, review }\n                | SwitchResolution::Discard { context, review } => (context, review),\n            };\n            // A resolution names one native refusal, never whichever\n            // conversation happens to be pending when a lost delivery retries.\n            let blocked = self.switch_blocked.as_ref().ok_or(Refusal::StaleContext)?;\n            if self.active_ref.as_ref() != Some(context)\n                || &blocked.context != context\n                || &blocked.review != review\n                || &blocked.to != to\n                || blocked.target_context.as_ref() != target_context\n                || Some(&blocked.pending) != self.pending_decision().as_ref()\n            {\n                return Err(Refusal::StaleContext);\n            }\n            let id = self.live_bound_harness().ok_or(Refusal::StaleContext)?;\n            match resolution {\n                SwitchResolution::Archive { .. } => self.end_harness(&id)?,\n                SwitchResolution::Discard { .. } => self.discard_harness(&id)?,\n            }\n            self.switch_blocked = None;\n            return Ok(());\n        }\n        let Some(pending) = self.pending_decision() else {\n            self.switch_blocked = None;\n            return Ok(());\n        };\n        self.switch_blocked = Some(SwitchBlocked {\n            to: to.clone(),\n            pending,\n            completion: target_context.is_some(),\n            context: self.active_ref.clone().ok_or(Refusal::StaleContext)?,\n            review: ReviewId::issue().ok_or(Refusal::ShuttingDown)?,\n            target_context: target_context.cloned(),\n        });\n        Err(Refusal::DecisionPending)\n    }\n\n    /// The active tenant's setup warnings as items.\n    pub(super) fn setup_warning_items(&self) -> Vec<InboxItem> {\n        self.data\n            .active\n            .as_ref()\n            .and_then(|id| self.tenant(id))\n            .map(|t| t.setup_warnings.iter().map(setup_warning_item).collect())\n            .unwrap_or_default()\n    }\n\n    /// The products the active tenant chose (Runtime Security until a setup\n    /// chooses more).\n    pub(super) fn selected_products(&self, tenant: &TenantId) -> Vec<ProductId> {\n        self.tenant(tenant)\n            .map(|t| {\n                if t.products.is_empty() {\n                    vec![ProductId::RuntimeSecurity]\n                } else {\n                    t.products.clone()\n                }\n            })\n            .unwrap_or_default()\n    }\n\n                .data\n                .tenants\n                .iter()\n                .flat_map(|t| t.harness_mcp.iter().cloned())\n                .collect(),\n            ..PersistedState::default()\n        }\n    }\n\n    fn lease(&mut self) -> u64 {\n        self.next_lease += 1;\n        self.next_lease\n    }\n\n    fn changed(&mut self) {\n        // Every published snapshot reflects settled scans' outcomes.\n        self.sync_scans();\n        self.sync_academy_calls();\n        self.sync_management_calls();\n        self.sync_changes();\n        self.sync_inference();\n        self.sync_files();\n        self.sync_harness();\n        if self.switch_blocked.as_ref().is_some_and(|guard| {\n            self.active_ref.as_ref() != Some(&guard.context)\n                || self.pending_decision().as_ref() != Some(&guard.pending)\n                || guard.target_context.as_ref().is_some_and(|context| {\n                    self.setup_tenant_for(context).as_ref() != Some(&guard.to)\n                })\n        }) {\n            self.switch_blocked = None;\n        }\n        self.revision += 1;\n        let update = Update::Shell(Box::new(self.snapshot()));\n        self.subscribers.publish(&update);\n    }\n\n    /// Issues a fresh context reference for the active tenant (or none) and\n    /// retires everything bound to the previous one.\n    fn reissue_context(&mut self) -> Vec<runtime::Start> {\n        self.switch_blocked = None;\n        self.epoch += 1;\n        self.active_ref = self\n            .data\n            .active\n            .as_ref()\n            .map(|_| ContextRef::issue(&self.salt, self.epoch));\n        if self\n            .endpoint_review\n            .as_ref()\n            .is_some_and(|r| Some(&r.context) != self.active_ref.as_ref())\n{\n  \"schema\": \"airs-v2/p09-native-execution/1\",\n  \"phase\": \"P09\",\n  \"driver_subject\": \"C43\",\n  \"orchestrator\": \"Codex\",\n  \"started_utc\": \"2026-11-02T04:42:51.870190+00:00\",\n  \"finished_utc\": \"2026-11-02T05:02:50.164447+00:00\",\n  \"source_root\": \"/Users/cdot/development/redtail/prisma-airs-desktop-v2-current\",\n  \"source_head\": \"ab898b6038cd613e761a889a9bff75ca19524ba0\",\n  \"os\": \"macOS-26.6.2-arm64-arm-64bit-Mach-O\",\n  \"driver_return_code\": 0,\n  \"executable_sha256\": \"fd51e81755a555f0daeee52168f134254c569e84b8ae82f684c3f3f839f83d56\",\n  \"raw_record_sha256\": \"7983a6981fecad55566d0969c0b1c7598c7fac8911cddff9fff4dcd1ff6eff41\",\n  \"controller_sha256\": \"d438ad8be0bf88edae91b5180c896adfb6365b701e06c21c7226747300bd2743\",\n  \"requirements_sha256\": \"292cbe4a98ead78199b7a339e9797cdfbe5595138941ac0390c8a68a534301cf\",\n  \"driver_sha256\": \"4654183139197387a759ee489429f30eab2e87cd13bc2a9b78470fd4fb75a3f9\",\n  \"required_check_errors\": [],\n  \"superseded_raw_checks\": [],\n  \"adaptation\": \"evidence paths relocated to P09; no assertion or result changes\",\n  \"raw_attribution\": \"driver-generated performed_by retained; C43 reads the actual orchestrator from AIRS_NATIVE_ORCHESTRATOR\"\n}\n","exit_code":0,"status":"completed"}}
