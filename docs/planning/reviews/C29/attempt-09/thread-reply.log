uard.clone();\n1239:        desk.send(old_guard.clone()).await,\n1243:    let old_guard = reviewed_switch(\n1250:        dismissed_guard[\"resolution\"][\"review\"],\n1251:        old_guard[\"resolution\"][\"review\"]\n1254:        desk.send(dismissed_guard).await,\n1268:        desk.send(old_guard.clone()).await,\n1278:        desk.send(old_guard).await,\n1280:        \"a new refusal never revives an old resolution\"\n1285:        .expect(\"fresh resolution remains usable\");\n1292:async fn stale_archive_resolution_never_ends_another_pending_conversation() {\n1293:    stale_switch_resolution_is_bound(\"archive\").await;\n1297:async fn stale_discard_resolution_never_deletes_another_pending_conversation() {\n1298:    stale_switch_resolution_is_bound(\"discard\").await;\n1302:/// Harness decision pending; the refusal carries the guard, and the\n1303:/// operator's resolution ends the conversation (kept or dropped) and switches.\n1340:    // Without a resolution the switch is refused and the guard is published.\n1357:    // Stay: the guard closes, nothing else changes.\n1378:    // A plain switch with nothing pending needs no resolution.\n1818:    // The guard is still actionable: Discard removes the earlier record and\n1852:/// so it is the same guarded switch: a pending Harness decision refuses it\n1853:/// with the guard naming the draft, nothing is committed or retired until\n1854:/// the operator resolves the conversation, and the resolution completes it.\n1856:async fn completing_a_tenant_setup_is_the_guarded_switch_path() {\n1896:        \"the guard names the draft\"\n1898:    assert_eq!(s[\"switchBlocked\"][\"completion\"], true);\n1916:    // Stay: the guard closes; the draft, the tenant and the decision remain.\n1933:        resolved[\"resolution\"][\"context\"],\n1938:    wrong_source[\"resolution\"][\"context\"] = json!(draft);\n","exit_code":0,"status":"completed"}}
