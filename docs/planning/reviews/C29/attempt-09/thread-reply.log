top/src/v2/wizard/wizard.test.tsx:176:    it('keeps a refused or unconfirmed completion visible with Retry instead of closing', async () => {\napps/desktop/src/v2/wizard/wizard.test.tsx:199:    it('opens from the switcher as a modal with the 244px rail and no Welcome or Academy step; Cancel before a draft sends nothing', async () => {\napps/desktop/src/v2/wizard/wizard.test.tsx:217:    it('drafts in add mode with an optional key, discards the draft on Cancel, and leaves the shell as it was', async () => {\napps/desktop/src/v2/wizard/wizard.test.tsx:239:    it('keeps the sheet open with Retry when the discard is refused, and closes only once the core admits it', async () => {\napps/desktop/src/v2/wizard/wizard.test.tsx:256:    it('does not let unsaved profile edits reach later steps or completion', async () => {\napps/desktop/src/v2/wizard/wizard.test.tsx:271:    it('waits for a pending creation on Cancel and discards what it produced before closing', async () => {\napps/desktop/src/v2/wizard/wizard.test.tsx:300:    it('discards the draft once when its snapshot arrives before the creation receipt', async () => {\napps/desktop/src/v2/wizard/wizard.test.tsx:321:    it('an unconfirmed discard with the draft still present offers Retry, which discards and closes', async () => {\napps/desktop/src/v2/wizard/wizard.test.tsx:343:    it('after an unconfirmed creation, Cancel discards the draft the next snapshot shows, and an unconfirmed discard closes once the draft is gone', async () => {\napps/desktop/src/v2/wizard/wizard.test.tsx:368:    it('the Done checks line is derived from the verification states: a warning and a failure are counted, a passed line is counted, and \"All passed\" needs every line to pass (attempt-01 R1)', async () => {\napps/desktop/src/v2/wizard/wizard.test.tsx:386:    it('the Environment segmented control is a native radio group: one tab stop, arrow keys move the selection, Tab leaves to Region (attempt-01 R2)', async () => {\napps/desktop/src/v2/wizard/wizard.test.tsx:408:    it('finishes with one completion intent and a toast naming the new tenant', async () => {\napps/desktop/src/v2/wizard/wizard.test.tsx:427:    it('completion is the guarded switch path (I1): a pending Harness decision shows the guard in the sheet and the resolution re-sends the completion', async () => {\n\"\"\"Independent completeness check for the retained C29 native assertions.\n\nThe expected axes come from C29-N06/T09, rather than the rows a driver happens\nto emit. Missing behavior or a missing capture cannot be reported as exercised.\n\"\"\"\nimport argparse\nimport hashlib\nimport itertools\nimport json\nfrom pathlib import Path\n\nSTEPS = {\n    'firstRun': ['welcome', 'tenant', 'products', 'verify', 'packs', 'academy', 'done'],\n    'add': ['tenant', 'products', 'verify', 'packs', 'done'],\n}\nBEHAVIOR = [\n    'welcome_relaunch', 'profile_edit_saved', 'profile_edit_key_kept',\n    'gateway_listed', 'workspace_chosen', 'workspace_key_saved',\n    'rejected_client_failed', 'failed_client_continuable', 'failed_scan_stored_not_pass',\n    'credential_fix_returns_tenant', 'correct_client_saved', 'workspace_rechosen_after_fix',\n    'verification_passed', 'gateway_verification_passed', 'product_edit_marked_stale',\n    'stale_continuation_closed', 'stale_rerun_clean', 'home_relaunch',\n    'starter_cases_imported', 'secret_confinement',\n    'keyed_draft_saved', 'cancelled_rows_unchanged', 'cancelled_active_unchanged', 'cancelled_key_deleted',\n]\n\n\ndef problems(observations, root):\n    coverage = observations.get('c29_native_coverage', {})\n    behavior = coverage.get('behavior', {})\n    failures = ['missing/failed retained behavior: ' + key for key in BEHAVIOR if behavior.get(key) is not True]\n    rows = coverage.get('layouts', {})\n    expected = {(mode, step, theme, zoom) for mode, steps in STEPS.items()\n                for step, theme, zoom in itertools.product(steps, ['Light', 'Dark'], [1, 2])}\n    seen = set()\n    for name, row in rows.items():\n        axis = (row.get('mode'), row.get('step'), row.get('theme'), row.get('zoom'))\n        if axis in seen:\n            failures.append('duplicate matrix row: ' + str(axis))\n        seen.add(axis)\n        zoom = row.get('zoom')\n        requested = (1440, 900) if zoom == 1 else (900, 600)\n        geometry = row.get('geometry', {})\n        web = geometry.get('web') or []\n        viewport = geometry.get('viewport') or web\n        if not (len(web) == 2 and len(viewport) == 2 and web[0] == requested[0]\n                and viewport[0] == requested[0] and (zoom == 1 or viewport[1] == requested[1])):\n            failures.append(name + ': wrong measured geometry')\n        primary = row.get('primary', {})\n        height = (primary.get('size') or [0, 0])[1]\n        if not (primary.get('inside') and zoom in (1, 2) and height >= 32 * zoom):\n            failures.append(name + ': primary outside window or too small')\n        if row.get('overflow_px') != 0 or row.get('horizontal_scrollbars') != 0:\n            failures.append(name + ': horizontal overflow')\n        if row.get('dialog') != (row.get('mode') == 'add'):\n            failures.append(name + ': wrong modal ownership')\n        keyboard = row.get('keyboard', {})\n        if not (keyboard.get('primary_reached') and keyboard.get('walk') and keyboard.get('contained')):\n            failures.append(name + ': keyboard traversal missing/incomplete')\n        for field in ['capture', 'tree']:\n            path = Path(root) / row.get(field, '')\n            if not row.get(field) or not path.is_file():\n                failures.append(name + ': missing ' + field)\n            elif hashlib.sha256(path.read_bytes()).hexdigest() != row.get(field + '_sha256'):\n                failures.append(name + ': hash mismatch for ' + field)\n    failures.extend('missing matrix row: ' + str(axis) for axis in sorted(expected - seen))\n    failures.extend('unexpected matrix row: ' + str(axis) for axis in sorted(seen - expected))\n    return failures\n\n\ndef main():\n    parser = argparse.ArgumentParser()\n    parser.add_argument('observations', type=Path)\n    parser.add_argument('--root', type=Path, default=Path.cwd())\n    args = parser.parse_args()\n    data = json.loads(args.observations.read_text())\n    errors = problems(data['observations'], args.root)\n    print(json.dumps({'retained_C29_native_coverage': 'fail' if errors else 'pass', 'errors': errors}, indent=2))\n    return 1 if errors else 0\n\n\nif __name__ == '__main__':\n    raise SystemExit(main())\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_29","type":"command_execution","command":"/bin/zsh -lc \"rg -n 'BeginTenantSetup|UpdateTenantSetup|DiscardTenantSetup|CompleteTenantSetup|VerifyTenantSetup|ChooseSetupProducts|switch_guard|SwitchResolution|SetOnboarding|is_setup' crates/desktop-core/src/authority.rs; cat apps/desktop/src/v2/switch-guard.tsx apps/desktop/src/features/academy/academy-account.tsx; sed -n '630,751p' apps/desktop/src/v2/wizard/wizard.tsx\"","aggregated_output":"56:    ReadStatus, SwitchResolution,\n133:    SetOnboarding {\n143:    BeginTenantSetup {\n149:    UpdateTenantSetup {\n154:    ChooseSetupProducts {\n160:    VerifyTenantSetup {\n167:    CompleteTenantSetup {\n173:        resolution: Option<inbox_domain::SwitchResolution>,\n176:    DiscardTenantSetup {\n189:        resolution: Option<inbox_domain::SwitchResolution>,\n797:    SetOnboarding => \"setOnboarding\",\n799:    BeginTenantSetup => \"beginTenantSetup\",\n800:    UpdateTenantSetup => \"updateTenantSetup\",\n801:    ChooseSetupProducts => \"chooseSetupProducts\",\n802:    VerifyTenantSetup => \"verifyTenantSetup\",\n803:    CompleteTenantSetup => \"completeTenantSetup\",\n804:    DiscardTenantSetup => \"discardTenantSetup\",\n3672:        Intent::SetOnboarding { state: next } => {\n3706:        Intent::BeginTenantSetup { mode, profile } => {\n3713:        Intent::UpdateTenantSetup { context, profile } => {\n3724:        Intent::ChooseSetupProducts { context, products } => {\n3731:        Intent::VerifyTenantSetup { context } => {\n3741:        Intent::CompleteTenantSetup {\n3774:        Intent::DiscardTenantSetup { context } => {\n5837:    } else if state.is_setup_tenant(&tenant) {\n5919:    } else if state.is_setup_tenant(&tenant) {\nimport type { ShellSnapshot, SwitchResolution } from '@prisma-airs/desktop-contracts'\nimport { GUARD_COPY } from './copy'\nimport { Modal } from './modal'\n\nexport interface SwitchGuardProps {\n    /** The tenant the switch (or the setup completion) leads to. */\n    target: string\n    /** The switch is a setup draft's completion (the body says so). */\n    completion: boolean\n    binding: Pick<NonNullable<ShellSnapshot['switchBlocked']>, 'context' | 'review'>\n    onStay: () => void\n    onResolve: (resolution: SwitchResolution) => void\n}\n\n/**\n * The one tenant-switch guard (I1): rendered from the core's `switchBlocked`\n * whether the switch was asked for through the switcher, the palette, the\n * native menu or the completion of a setup draft. Stay dismisses the guard;\n * Archive and Discard re-send the same intent with the chosen resolution.\n * Initial focus is on Stay, the safe default: Enter on arrival never ends\n * the conversation (Archive stays the visually primary action).\n */\nexport function SwitchGuard({ target, completion, binding, onStay, onResolve }: SwitchGuardProps) {\n    return (\n        <Modal label={GUARD_COPY.title} onClose={onStay} width={520} data-slot='switch-guard'>\n            <h2 className='text-[16px] font-semibold'>{GUARD_COPY.title}</h2>\n            <p className='mt-2 text-[13px]' style={{ color: 'var(--v2-soft)' }}>\n                {completion ? GUARD_COPY.bodyCompletion(target) : GUARD_COPY.body(target)}\n            </p>\n            <div className='mt-4 flex flex-wrap justify-end gap-2'>\n                <button type='button' autoFocus onClick={onStay} className='h-8 rounded-[7px] border px-3 text-[13px]' style={{ borderColor: 'var(--v2-rule)' }}>\n                    {GUARD_COPY.stay}\n                </button>\n                <button type='button' onClick={() => onResolve({ kind: 'discard', context: binding.context, review: binding.review })} className='h-8 rounded-[7px] border px-3 text-[13px]' style={{ borderColor: 'var(--v2-rule)' }}>\n                    {GUARD_COPY.discard}\n                </button>\n                <button type='button' onClick={() => onResolve({ kind: 'archive', context: binding.context, review: binding.review })} className='h-8 rounded-[7px] px-3 text-[13px] font-semibold' style={{ background: 'var(--v2-acc)', color: 'var(--v2-acc-ink)' }}>\n                    {GUARD_COPY.archive}\n                </button>\n            </div>\n        </Modal>\n    )\n}\nimport { useId, useState } from 'react'\nimport { Button, Callout } from '@ai-security-academy/presentation'\nimport { AlertTriangle, CheckCircle2, Info } from 'lucide-react'\nimport type { AcademyFailure, AcademyView, Intent, VaultError } from '@prisma-airs/desktop-contracts'\nimport { type Dispatch, outcomeMessage } from '../tenants/dispatch'\n\nconst FAILURE_TEXT: Record<AcademyFailure, string> = {\n    notConfigured: 'Academy desktop sign-in is not available on this server.',\n    invalidConfig: 'Academy returned a sign-in configuration the desktop cannot trust.',\n    network: 'Academy could not be reached. Check your connection and try again.',\n    invalidResponse: 'Academy returned an unexpected sign-in response. Try again.',\n    denied: 'Sign-in was declined in the browser.',\n    expired: 'The sign-in code expired before it was approved. Start again.',\n    sessionExpired: 'Your Academy session expired. Sign in again.',\n    scopeMissing: 'Academy did not grant learning access to this sign-in.',\n    accountChanged: 'Academy changed its sign-in configuration. Sign in again.',\n    authFailed: 'Academy sign-in could not complete. Try again.',\n}\n\nconst VAULT_TEXT: Record<VaultError, string> = {\n    locked: 'The Keychain is locked, so the session could not be saved. Unlock it and sign in again.',\n    denied: 'macOS did not allow the Academy session to be saved in the Keychain.',\n    unavailable: 'The Keychain is not available, so the session could not be saved.',\n    notFound: 'The saved Academy session is missing from the Keychain.',\n    corrupt: 'The saved Academy session could not be read.',\n}\n\ninterface Props {\n    view: AcademyView\n    dispatch: Dispatch\n}\n\n/**\n * The Academy learner account, independent of AIRS tenants. Sign-in is a\n * browser device flow: the desktop shows a code, opens the Academy page the\n * issuer named, and never sees a password. Tokens stay in the native core.\n */\nexport function AcademyAccount({ view, dispatch }: Props) {\n    const legend = useId()\n    const [busy, setBusy] = useState(false)\n    const [message, setMessage] = useState<string | null>(null)\n\n    async function send(intent: Intent) {\n        setBusy(true)\n        setMessage(null)\n        const outcome = await dispatch(intent)\n        setBusy(false)\n        setMessage(outcomeMessage(outcome))\n    }\n\n    return (\n        <fieldset\n            aria-labelledby={legend}\n            aria-busy={busy}\n            data-slot='academy-account'\n            className='border-academy-rule flex flex-col gap-3 rounded-[12px] border p-5'\n        >\n            <legend id={legend} className='text-academy-ink px-1 text-[15px] font-semibold'>\n                Academy account\n            </legend>\n            <p className='text-academy-ink-soft text-[13px]'>\n                Your Academy learner account is separate from AIRS tenants; switching tenants does not change it.\n            </p>\n            <div role='status' aria-live='polite' className='flex flex-col gap-3'>\n                <State view={view} busy={busy} send={send} />\n            </div>\n            {message ? (\n                <p role='alert' data-slot='academy-message' className='text-academy-accent-warn text-[13px]'>\n                    {message}\n                </p>\n            ) : null}\n        </fieldset>\n    )\n}\n\nfunction State({ view, busy, send }: { view: AcademyView; busy: boolean; send: (intent: Intent) => Promise<void> }) {\n    switch (view.state) {\n        case 'signedOut':\n            return (\n                <div className='flex flex-col items-start gap-3'>\n                    <p className='text-academy-ink text-[13px]'>Not signed in to Academy.</p>\n                    <Button type='button' tier='primary' disabled={busy} onClick={() => void send({ kind: 'startAcademySignIn' })}>\n                        Sign in to Academy\n                    </Button>\n                </div>\n            )\n        case 'starting':\n        case 'completing':\n            return (\n                <div className='flex flex-col items-start gap-3'>\n                    <p className='text-academy-ink text-[13px]'>\n                        {view.state === 'starting' ? 'Contacting Academy…' : 'Approved. Finishing sign-in…'}\n                    </p>\n                    <Button type='button' tier='secondary' onClick={() => void send({ kind: 'cancelAcademySignIn' })}>\n                        Cancel sign-in\n                    </Button>\n                </div>\n            )\n        case 'awaitingApproval':\n            return (\n                <div className='flex flex-col items-start gap-3' data-slot='academy-code'>\n                    <p className='text-academy-ink text-[13px]'>Enter this code on the Academy sign-in page:</p>\n                    <p\n                        className='font-mono text-academy-ink text-[24px] font-semibold tracking-[0.12em] select-all'\n                        aria-label={`Sign-in code ${view.userCode.split('').join(' ')}`}\n                    >\n                        {view.userCode}\n                    </p>\n                    <p className='text-academy-ink-faint text-[12px] break-all'>\n                        {view.verificationUri} · expires in {Math.max(1, Math.ceil(view.expiresIn / 60))} min\n                    </p>\n                    <div className='flex flex-wrap gap-2'>\n                        <Button type='button' tier='primary' onClick={() => void send({ kind: 'openAcademyVerification' })}>\n                            Open sign-in page\n                        </Button>\n                        <Button type='button' tier='secondary' onClick={() => void send({ kind: 'cancelAcademySignIn' })}>\n                            Cancel sign-in\n                        </Button>\n                    </div>\n                </div>\n            )\n        case 'signedIn':\n            return (\n                <div className='flex flex-col items-start gap-3'>\n                    <Callout tone='success' icon={CheckCircle2}>\n                        <p>\n                            Signed in to Academy as <span className='font-semibold'>{view.displayName}</span>.\n                        </p>\n                    </Callout>\n                    <Button type='button' tier='secondary' disabled={busy} onClick={() => void send({ kind: 'signOutAcademy' })}>\n                        Sign out of Academy\n                    </Button>\n                </div>\n            )\n        case 'failed':\n            return (\n                <div className='flex flex-col items-start gap-3'>\n                    <Callout tone='warning' icon={view.failure === 'network' ? Info : AlertTriangle} data-slot='academy-failure'>\n                        {view.displayName ? <p className='font-semibold'>{view.displayName}</p> : null}\n                        <p>{view.vault ? VAULT_TEXT[view.vault] : FAILURE_TEXT[view.failure]}</p>\n                    </Callout>\n                    <div className='flex flex-wrap gap-2'>\n                        <Button type='button' tier='primary' disabled={busy} onClick={() => void send({ kind: 'startAcademySignIn' })}>\n                            Sign in again\n                        </Button>\n                        <Button type='button' tier='secondary' disabled={busy} onClick={() => void send({ kind: 'signOutAcademy' })}>\n                            Sign out of Academy\n                        </Button>\n                    </div>\n                </div>\n            )\n    }\n}\n                                                    )\n                                                })}\n                                            </div>\n                                            <span className='font-normal' style={{ color: 'var(--v2-faint)' }}>\n                                                {C.tenant.environmentHint}\n                                            </span>\n                                        </div>\n                                        <label className='flex flex-col text-[12px] font-semibold' style={{ gap: 5, color: 'var(--v2-soft)' }}>\n                                            {C.tenant.region}\n                                            <select name='region' aria-label={C.tenant.region} value={form.region} onChange={(e) => setForm((f) => ({ ...f, region: e.target.value as Region }))} className='h-8 min-h-0 rounded-[7px] border px-2.5 text-[13px] font-normal' style={{ borderColor: 'var(--v2-ctl)', background: 'var(--v2-bg)', color: 'var(--v2-ink)' }}>\n                                                {REGIONS.map((r) => (\n                                                    <option key={r.value} value={r.value}>\n                                                        {r.label}\n                                                    </option>\n                                                ))}\n                                            </select>\n                                            <span className='font-normal' style={{ color: 'var(--v2-faint)' }}>\n                                                {C.tenant.regionHint}\n                                            </span>\n                                        </label>\n                                    </div>\n                                    {setup && (\n                                        <p className='text-[12px]' style={{ color: 'var(--v2-faint)' }}>\n                                            {C.tenant.updateHint}\n                                        </p>\n                                    )}\n                                    <div className='flex items-center' style={{ gap: 10 }}>\n                                        <Primary label={setup ? C.tenant.save : C.tenant.create} disabled={busy} />\n                                        {profileDirty && <Secondary label={C.tenant.revert} onClick={revertProfile} />}\n                                    </div>\n                                </form>\n                                {setup && (\n                                    <>\n                                        {scanCard}\n                                        <form onSubmit={(e) => void saveClient(e)} aria-busy={busy} className='flex flex-col rounded-[12px] border' style={{ gap: 12, padding: '18px 20px', borderColor: 'var(--v2-rule)', background: 'var(--v2-paper)' }} data-slot='management-form'>\n                                            <div className='flex items-center' style={{ gap: 8 }}>\n                                                <b className='text-[14px]'>{C.tenant.management}</b>\n                                                {pill(C.optional)}\n                                                <button type='button' aria-expanded={helpOpen} onClick={() => setHelpOpen((h) => !h)} className='ml-auto text-[12px] font-semibold' style={{ color: 'var(--v2-acc)' }}>\n                                                    {C.tenant.whereFind}\n                                                </button>\n                                            </div>\n                                            {helpOpen && (\n                                                <ol className='flex list-decimal flex-col rounded-[8px] leading-[1.5]' style={{ gap: 4, padding: '12px 14px 12px 32px', background: 'var(--v2-inset)', color: 'var(--v2-soft)' }}>\n                                                    {C.tenant.whereSteps.map((t) => (\n                                                        <li key={t}>{t}</li>\n                                                    ))}\n                                                </ol>\n                                            )}\n                                            <p className='text-[12px]' style={{ color: 'var(--v2-faint)' }}>\n                                                {C.tenant.managementHint}\n                                            </p>\n                                            <p data-slot='management-state'>\n                                                <Verdict tone={stateTone(setup.tenant.management.state)} word={C.tenant.state[setup.tenant.management.state]} reason={clientReady && setup.tenant.management.clientId ? `Client ID: ${setup.tenant.management.clientId}` : undefined} />\n                                            </p>\n                                            <div className='grid' style={{ gridTemplateColumns: '1fr 1fr', gap: 12 }}>\n                                                <Field label={C.tenant.clientId} name='clientId' error={errors.clientId} />\n                                                <SecretField label={C.tenant.clientSecret} inputRef={secretRef} error={errors.clientSecret} />\n                                            </div>\n                                            <div className='flex items-center' style={{ gap: 10 }}>\n                                                <Primary label={clientReady ? C.tenant.replaceClient : C.tenant.saveClient} disabled={busy} />\n                                                {clientReady && <Secondary label={C.tenant.removeClient} disabled={busy} onClick={() => void remove('removeManagementCredential', C.tenant.clientRemoved)} />}\n                                            </div>\n                                        </form>\n                                        <OptionalCard icon='route' title={C.tenant.gateway} text={C.tenant.gatewayHint} tag={C.optional} open={gatewayOn} onToggle={(on) => setGatewayOn(on)} switchLabel={C.tenant.gatewayOn} slot='gateway-section'>\n                                            {!clientReady && (\n                                                <p className='text-[12px]' style={{ color: 'var(--v2-soft)' }}>\n                                                    {C.tenant.gatewayNeedsClient}\n                                                </p>\n                                            )}\n                                            {clientReady && (\n                                                <div className='flex flex-col' style={{ gap: 10 }}>\n                                                    <div className='flex items-center' style={{ gap: 10 }}>\n                                                        <Secondary label={C.tenant.readWorkspaces} disabled={busy} onClick={() => void listWorkspaces()} />\n                                                        {workspacesNote && (\n                                                            <span className='text-[12px]' style={{ color: 'var(--v2-soft)' }}>\n                                                                {workspacesNote}\n                                                            </span>\n                                                        )}\n                                                    </div>\n                                                    {workspaces && workspaces.length > 0 && (\n                                                        <div className='flex items-end' style={{ gap: 10 }}>\n                                                            <label className='flex flex-col text-[12px] font-semibold' style={{ gap: 5, color: 'var(--v2-soft)' }}>\n                                                                {C.tenant.workspace}\n                                                                <select value={workspace} onChange={(e) => setWorkspace(e.target.value)} className='h-8 min-h-0 rounded-[7px] border px-2.5 text-[13px] font-normal' style={{ borderColor: 'var(--v2-ctl)', background: 'var(--v2-bg)', color: 'var(--v2-ink)' }}>\n                                                                    {workspaces.map((w) => (\n                                                                        <option key={w.id} value={w.id}>\n                                                                            {w.name}\n                                                                        </option>\n                                                                    ))}\n                                                                </select>\n                                                            </label>\n                                                            <Secondary label={C.tenant.chooseWorkspace} disabled={busy || !workspace} onClick={() => void chooseWorkspace()} />\n                                                        </div>\n                                                    )}\n                                                    {chosen && (\n                                                        <form onSubmit={(e) => void saveWorkspaceKey(e)} aria-busy={busy} className='flex flex-col' style={{ gap: 10 }} data-slot='workspace-key-form'>\n                                                            <p className='text-[13px]'>{C.tenant.workspaceChosen(chosen.workspace.name)}</p>\n                                                            <p data-slot='inference-state'>\n                                                                <Verdict tone={setup.tenant.inference.state === 'ready' ? 'allowed' : 'info'} word={C.tenant.state[setup.tenant.inference.state]} />\n                                                            </p>\n                                                            <div className='grid' style={{ gridTemplateColumns: '1fr 1fr', gap: 12 }}>\n                                                                <Field label={C.tenant.endpoint} name='endpoint' value={endpoint} onChange={setEndpoint} hint={C.tenant.endpointHint} error={errors.endpoint} />\n                                                                <SecretField label={C.tenant.workspaceKey} inputRef={workspaceKeyRef} error={errors.workspaceKey} />\n                                                            </div>\n                                                            <div>\n                                                                <Primary label={C.tenant.saveWorkspaceKey} disabled={busy} />\n                                                            </div>\n                                                        </form>\n                                                    )}\n                                                </div>\n                                            )}\n                                        </OptionalCard>\n                                    </>\n                                )}\n                            </>\n                        )}\n                        {step === 'products' && setup && (\n                            <>\n                                <div>\n                                    <h1 ref={heading} id={headingId} tabIndex={-1} className='font-bold' style={{ fontSize: 26, letterSpacing: '-0.01em' }}>\n                                        {C.products.title}\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_31","type":"command_execution","command":"/bin/zsh -lc \"sed -n '3660,3805p' crates/desktop-core/src/authority.rs; sed -n '1,280p' crates/desktop-core/src/authority/inbox_domain.rs\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_31","type":"command_execution","command":"/bin/zsh -lc \"sed -n '3660,3805p' crates/desktop-core/src/authority.rs; sed -n '1,280p' crates/desktop-core/src/authority/inbox_domain.rs\"","aggregated_output":"            let entry = features::catalogue_for(state.ui_variant())\n                .into_iter()\n                .find(|e| e.id == feature)\n                .ok_or(Refusal::InvalidInput)?;\n            if entry.availability != features::Availability::Available {\n                return Err(Refusal::InvalidInput);\n            }\n            if state.active_feature != Some(feature) {\n                state.active_feature = Some(feature);\n                state.changed();\n            }\n        }\n        Intent::SetOnboarding { state: next } => {\n            use features::OnboardingState as O;\n            let current = state.onboarding();\n            let allowed = matches!(\n                (current, next),\n                (O::Needed, O::InProgress | O::Done) | (O::InProgress, O::Done)\n            ) || current == next;\n            if !allowed {\n                return Err(Refusal::InvalidInput);\n            }\n            if current != next {\n                let before = state.data.clone();\n                state.data.onboarding = Some(next);\n                if state.storage == StorageHealth::Ready\n                    && let Err(e) = state.save_with(&before)\n                {\n                    return Err(e);\n                }\n                state.changed();\n            }\n        }\n        Intent::SetShowCalls { on } => {\n            // The operator's choice holds from now on, onboarding or not (C33).\n            if state.data.show_calls != Some(on) {\n                let before = state.data.clone();\n                state.data.show_calls = Some(on);\n                if state.storage == StorageHealth::Ready\n                    && let Err(e) = state.save_with(&before)\n                {\n                    return Err(e);\n                }\n                state.changed();\n            }\n        }\n        Intent::BeginTenantSetup { mode, profile } => {\n            state.require_storage()?;\n            let before = state.data.clone();\n            state.begin_setup(mode, profile)?;\n            state.save_with(&before)?;\n            state.changed();\n        }\n        Intent::UpdateTenantSetup { context, profile } => {\n            state.require_storage()?;\n            let before = state.data.clone();\n            let retired = state.update_setup(&context, profile)?;\n            state.save_with(&before)?;\n            for old in retired {\n                let _ = session.delete(&old);\n            }\n            effects.push(Effect::Cleanup);\n            state.changed();\n        }\n        Intent::ChooseSetupProducts { context, products } => {\n            state.require_storage()?;\n            let before = state.data.clone();\n            state.choose_setup_products(&context, products)?;\n            state.save_with(&before)?;\n            state.changed();\n        }\n        Intent::VerifyTenantSetup { context } => {\n            let starts = state.begin_verify(\n                &context,\n                Arc::clone(&adapters.keychain),\n                Arc::clone(session),\n            )?;\n            effects.push(Effect::Start(starts));\n            effects.push(Effect::Start(state.take_gateway_starts()));\n            state.changed();\n        }\n        Intent::CompleteTenantSetup {\n            context,\n            packs,\n            resolution,\n        } => {\n            state.require_storage()?;\n            let draft = state.completable_setup(&context, &packs)?;\n            // Completion makes the new tenant active: the one guarded switch\n            // path (I1). A pending Harness decision refuses it, with the\n            // draft, the active tenant and the decision all untouched.\n            if let Err(refusal) = state.guard_switch(&draft, resolution, Some(&context)) {\n                state.changed();\n                return Err(refusal);\n            }\n            effects.extend(state.take_history_jobs());\n            let before = state.data.clone();\n            let recorded_secs = wall_secs(state.clock_offset);\n            let done = state.complete_setup(&context, packs, recorded_secs)?;\n            state.save_with(&before)?;\n            effects.push(Effect::Start(state.reissue_context()));\n            effects.push(Effect::Start(state.take_gateway_starts()));\n            if !done.packs.is_empty() {\n                let (lease, write) = state.queue_examples(&done.tenant, &done.packs);\n                if let Some(lease) = lease {\n                    effects.push(Effect::LoadLibrary { lease });\n                }\n                if let Some((tenant, generation)) = write {\n                    effects.push(Effect::StoreLibrary { tenant, generation });\n                }\n            }\n            let _ = done.first_run;\n            state.changed();\n        }\n        Intent::DiscardTenantSetup { context } => {\n            if state.setup_has_keychain_credential() {\n                state.require_storage()?;\n            }\n            let before = state.data.clone();\n            let retired = state.discard_setup(&context)?;\n            if state.storage == StorageHealth::Ready {\n                state.save_with(&before)?;\n            }\n            for old in retired {\n                let _ = session.delete(&old);\n            }\n            effects.push(Effect::Start(state.take_gateway_starts()));\n            effects.push(Effect::Cleanup);\n            state.changed();\n        }\n        Intent::CreateTenant { profile } => {\n            state.require_storage()?;\n            let profile = profile.validate().ok_or(Refusal::InvalidInput)?;\n            if state.data.tenants.len() >= MAX_TENANTS {\n                return Err(Refusal::Busy);\n            }\n            let id = TenantId::issue().ok_or(Refusal::ShuttingDown)?;\n            let before = state.data.clone();\n            let select = state.data.active.is_none();\n            state.data.tenants.push(Tenant::new(TenantProfile {\n                id: id.clone(),\n                label: profile.label,\n                tsg_id: profile.tsg_id,\n                destination: profile.destination,\n                environment: profile.environment,\n            }));\n//! Inbox, reads and the tenant-switch guard (C30, screens/inbox-reads.md,\n//! invariants I1, I2, I4, I11, I12). Everything here is derived per tenant\n//! from scopes the core already owns: the Runtime overview read (its items,\n//! sources and failures), the operator's holds, the tenant's chosen\n//! products and its setup warnings (C29). The core computes the snooze\n//! return time, the per-product read status and whether a switch may\n//! proceed; the presentation renders them.\n\nuse serde::{Deserialize, Serialize};\nuse ts_rs::TS;\n\nuse super::observation_domain::{\n    FailedAttempt, HoldKind, OverviewView, ProductOutcome, SnoozeReceipt, product_sources,\n    source_names,\n};\nuse super::{PendingDecisionRef, Refusal, State, SwitchBlocked};\nuse crate::context::{ContextRef, ReviewId};\nuse crate::features::{FeatureId, ProductId, SetupWarning};\nuse crate::management::{ManagementFailure, ManagementResource};\nuse crate::observation::{Fact, InboxDestination, InboxItem, Tone};\nuse crate::tenants::TenantId;\n\n/// How a blocked switch is resolved (I1): the pending conversation is\n/// ended and kept (`archive`) or ended and dropped (`discard`).\n#[derive(Clone, Debug, PartialEq, Eq, Serialize, Deserialize, TS)]\n#[serde(tag = \"kind\", rename_all = \"camelCase\", deny_unknown_fields)]\npub enum SwitchResolution {\n    Archive {\n        context: ContextRef,\n        review: ReviewId,\n    },\n    Discard {\n        context: ContextRef,\n        review: ReviewId,\n    },\n}\n\n/// Where an Inbox entry came from.\n#[derive(Clone, Copy, Debug, PartialEq, Eq, Serialize, TS)]\n#[serde(rename_all = \"camelCase\")]\npub enum InboxKind {\n    /// A Runtime overview item (sessions, keys).\n    Runtime,\n    /// The chosen Gateway workspace's day (C18).\n    Gateway,\n    /// A warning recorded at tenant setup (C29).\n    SetupWarning,\n    /// A key rotation in progress (C31, I7).\n    Rotation,\n}\n\n/// An operator's hold on an entry, with the core-computed return time.\n#[derive(Clone, Debug, PartialEq, Eq, Serialize, TS)]\n#[serde(rename_all = \"camelCase\")]\npub struct HoldView {\n    pub kind: HoldKind,\n    /// When a snoozed entry returns (seconds since the epoch); none for an\n    /// acknowledgment, which ends when the item's level rises.\n    pub returns_at: Option<u32>,\n}\n\n/// Where an entry's action leads (C30): the destination, and within it the\n/// product, the inventory and the item the presentation selects on arrival.\n#[derive(Clone, Debug, PartialEq, Eq, Serialize, TS)]\n#[serde(rename_all = \"camelCase\")]\npub struct InboxTarget {\n    pub feature: FeatureId,\n    pub product: Option<ProductId>,\n    /// The Administration inventory to open (API keys for a key item).\n    pub resource: Option<ManagementResource>,\n    /// The item's name within that inventory, for the filter.\n    pub item: Option<String>,\n}\n\n/// One Inbox entry of the active tenant.\n#[derive(Clone, Debug, PartialEq, Eq, Serialize, TS)]\n#[serde(rename_all = \"camelCase\")]\npub struct InboxEntry {\n    pub id: String,\n    pub kind: InboxKind,\n    /// Needs action (otherwise an update).\n    pub needs_action: bool,\n    pub severity: Tone,\n    pub title: String,\n    pub detail: String,\n    pub source: String,\n    pub product: Option<ProductId>,\n    /// Where the action leads, with the context it carries.\n    pub target: Option<InboxTarget>,\n    pub action_label: Option<String>,\n    pub facts: Vec<Fact>,\n    /// When it was observed or recorded (seconds since the epoch).\n    pub when: u32,\n    pub hold: Option<HoldView>,\n}\n\n/// The read as a whole.\n#[derive(Clone, Copy, Debug, PartialEq, Eq, Serialize, TS)]\n#[serde(rename_all = \"camelCase\")]\npub enum ReadState {\n    /// Nothing has been read for this tenant yet.\n    Pending,\n    Reading,\n    Done,\n    /// The last read failed; an older read may be shown.\n    Failed,\n}\n\n/// One product's part of the read.\n#[derive(Clone, Copy, Debug, PartialEq, Eq, Serialize, TS)]\n#[serde(rename_all = \"camelCase\")]\npub enum ProductReadState {\n    Pending,\n    Ok,\n    /// Some of its sources were not read.\n    Incomplete,\n    /// A source refused the client for permissions.\n    NeedsRole,\n    Failed,\n    /// Nothing reads this product on Home; its destination does.\n    NotRead,\n}\n\n#[derive(Clone, Debug, PartialEq, Eq, Serialize, TS)]\n#[serde(rename_all = \"camelCase\")]\npub struct ProductRead {\n    pub product: ProductId,\n    pub state: ProductReadState,\n    pub sources_read: u32,\n    pub sources_total: u32,\n    pub detail: Option<String>,\n}\n\n/// The active tenant's read status (I4), derived from the overview read.\n#[derive(Clone, Debug, PartialEq, Eq, Serialize, TS)]\n#[serde(rename_all = \"camelCase\")]\npub struct ReadStatus {\n    pub state: ReadState,\n    pub last_read_at: Option<u32>,\n    /// When the last read failed (seconds since the epoch); with\n    /// `last_read_at`, an older read is shown.\n    pub failed_at: Option<u32>,\n    /// When the latest attempt settled, established or not (seconds since\n    /// the epoch): the time a completion is announced with when nothing was\n    /// established yet.\n    pub settled_at: Option<u32>,\n    pub products: Vec<ProductRead>,\n    /// Sources the last read could not establish, by name.\n    pub sources_missing: Vec<String>,\n    /// Counts completed reads of this tenant in this session: a change is\n    /// a completion the presentation may announce.\n    pub generation: u32,\n    /// The product a `recheckProduct` asked for, until the next read lands.\n    pub rechecking: Option<ProductId>,\n}\n\n/// The Inbox scope (per tenant, I2).\n#[derive(Clone, Debug, PartialEq, Eq, Serialize, TS)]\n#[serde(rename_all = \"camelCase\")]\npub struct InboxView {\n    pub items: Vec<InboxEntry>,\n    pub read: ReadStatus,\n    /// The last snooze placed on this tenant in this session (I11).\n    pub last_snooze: Option<SnoozeReceipt>,\n}\n\nfn product_label(product: ProductId) -> &'static str {\n    match product {\n        ProductId::RuntimeSecurity => \"AI Runtime Security\",\n        ProductId::Gateway => \"AI Gateway\",\n        ProductId::RedTeam => \"AI Red Teaming\",\n        ProductId::ModelSkill => \"Model and skill scans\",\n    }\n}\n\nfn warning_destination(product: ProductId) -> InboxDestination {\n    match product {\n        ProductId::Gateway => InboxDestination::Gateway,\n        _ => InboxDestination::ApiKeys,\n    }\n}\n\n/// Where a setup warning is fixed (C30): the scan key and the management\n/// client live in Settings, a Gateway workspace in AI Gateway, the Red Team\n/// and model/skill services in AI Red Teaming.\nfn warning_target(product: ProductId) -> (InboxTarget, &'static str) {\n    let (feature, label) = match product {\n        ProductId::RuntimeSecurity => (FeatureId::Settings, \"Open Settings\"),\n        ProductId::Gateway => (FeatureId::Gateway, \"Open AI Gateway\"),\n        ProductId::RedTeam | ProductId::ModelSkill => (FeatureId::RedTeam, \"Open AI Red Teaming\"),\n    };\n    (\n        InboxTarget {\n            feature,\n            product: Some(product),\n            resource: None,\n            item: None,\n        },\n        label,\n    )\n}\n\n/// Where a Runtime overview item's action leads: an API key item opens the\n/// API keys inventory filtered to that key.\nfn item_target(item: &InboxItem) -> InboxTarget {\n    match item.destination {\n        InboxDestination::ApiKeys => InboxTarget {\n            feature: FeatureId::Administration,\n            product: Some(ProductId::RuntimeSecurity),\n            resource: Some(ManagementResource::ApiKeys),\n            item: item\n                .facts\n                .iter()\n                .find(|f| f.label == \"Key\")\n                .map(|f| f.value.clone()),\n        },\n        InboxDestination::Sessions => InboxTarget {\n            feature: FeatureId::Sessions,\n            product: Some(ProductId::RuntimeSecurity),\n            resource: None,\n            item: None,\n        },\n        InboxDestination::Gateway => InboxTarget {\n            feature: FeatureId::Gateway,\n            product: Some(ProductId::Gateway),\n            resource: None,\n            item: None,\n        },\n    }\n}\n\n/// A setup warning as an attention item (C29 → C30): the item id is the\n/// warning's `vw-<n>`, so holds address it like any other item.\npub(super) fn setup_warning_item(w: &SetupWarning) -> InboxItem {\n    InboxItem {\n        id: w.id.clone(),\n        title: format!(\"{}: setup warning\", product_label(w.product)),\n        detail: w.reason.clone(),\n        source: \"Setup · verify\".to_owned(),\n        action: true,\n        tone: Tone::Warn,\n        destination: warning_destination(w.product),\n        action_label: warning_target(w.product).1.to_owned(),\n        facts: vec![Fact {\n            label: \"Product\".to_owned(),\n            value: product_label(w.product).to_owned(),\n        }],\n        per_mille: None,\n    }\n}\n\nfn source_state(failure: Option<ManagementFailure>) -> ProductReadState {\n    match failure {\n        None => ProductReadState::Ok,\n        Some(ManagementFailure::Denied | ManagementFailure::Unauthorized) => {\n            ProductReadState::NeedsRole\n        }\n        Some(_) => ProductReadState::Failed,\n    }\n}\n\nfn pending(product: ProductId) -> ProductRead {\n    ProductRead {\n        product,\n        state: ProductReadState::Pending,\n        sources_read: 0,\n        sources_total: product_sources(product),\n        detail: None,\n    }\n}\n\nfn needs_role_failure(failure: Option<ManagementFailure>) -> bool {\n    matches!(\n        failure,\n        Some(ManagementFailure::Denied | ManagementFailure::Unauthorized)\n    )\n}\n\nfn combined(needs_role: bool, read_count: u32, total: u32) -> ProductReadState {\n    if needs_role {\n","exit_code":0,"status":"completed"}}
