h({ ...native.current, switchBlocked: { to: 'tn-fedcba9876543210', pending: { conversation: 'op-7', decision: 'ap-1' }, completion: false } })\n59:+        await native.push({ ...native.current, switchBlocked: { context: native.current.active!.context, review: 'rv-1111111111111111', targetContext: null, to: 'tn-fedcba9876543210', pending: { conversation: 'op-7', decision: 'ap-1' }, completion: false } })\n61:-        expect(native.dispatched.at(-1)).toEqual({ kind: 'selectTenant', tenant: 'tn-fedcba9876543210', resolution: 'archive' })\n62:+        expect(native.dispatched.at(-1)).toEqual({ kind: 'selectTenant', tenant: 'tn-fedcba9876543210', resolution: { kind: 'archive', context: native.current.active!.context, review: 'rv-1111111111111111' } })\n63:+    })\n64:+\n65:+    it.each(['archive', 'discard'] as const)('retires an unconfirmed %s resolution with its native refusal, even in the same context', async (kind) => {\n66:+        const user = userEvent.setup()\n67:+        const native = await launch(fxInbox())\n68:+        const context = native.current.active!.context\n69:+        const guard = { context, review: 'rv-1111111111111111', targetContext: null, to: native.current.tenants[1]!.id, pending: { conversation: 'op-7', decision: 'ap-1' }, completion: false }\n70:+        await native.push({ ...native.current, switchBlocked: guard })\n71:+        native.respond = () => { throw new DeliveryOutcomeUnknown('lost') }\n72:+        const label = kind === 'archive' ? 'Archive and switch' : 'Discard and switch'\n73:+        await user.click(within(await screen.findByRole('dialog', { name: 'A Harness decision is waiting' })).getByRole('button', { name: label }))\n74:+        await waitFor(() => expect(useShellStore.getState().unconfirmed).toHaveLength(1))\n75:+        expect(useShellStore.getState().unconfirmed[0]?.context).toBe(context)\n76:+        const retired = native.dispatched.at(-1)!\n77:+        const sent = native.dispatched.length\n78:+        // A replacement pending conversation/refusal in the same tenant/context.\n79:+        const replacement = { ...guard, review: 'rv-2222222222222222', pending: { conversation: 'op-8', decision: 'ap-2' } }\n80:+        await native.push({ ...native.current, switchBlocked: replacement })\n81:+        expect(useShellStore.getState().unconfirmed).toHaveLength(0)\n82:+        useShellStore.getState().addUnconfirmed('The retired switch', retired)\n83:+        expect(useShellStore.getState().unconfirmed).toHaveLength(0)\n84:+        expect(native.dispatched).toHaveLength(sent)\n85:+        // A fresh explicit action uses the replacement native binding.\n86:+        native.respond = () => ({ outcome: 'receipt', receipt: { kind: 'admitted', request: 'rq-1', operation: null } })\n87:+        await user.click(within(screen.getByRole('dialog', { name: 'A Harness decision is waiting' })).getByRole('button', { name: label }))\n88:+        expect(native.dispatched.at(-1)).toEqual({ kind: 'selectTenant', tenant: guard.to, resolution: { kind, context, review: replacement.review } })\n89:+        await native.push({ ...native.current, active: { tenant: guard.to, context: 'cx-bbbbbbbbbbbbbbbbbbbbbbbb' }, switchBlocked: null })\n90:+        expect(document.querySelector('[data-slot=\"unconfirmed\"]')).toBeNull()\n91:+    })\n92:+\n93:+    it.each(['archive', 'discard'] as const)('never surfaces a late lost %s receipt after the source context retires', async (kind) => {\n94:+        const user = userEvent.setup()\n95:+        const native = await launch(fxInbox())\n96:+        const guard = { context: native.current.active!.context, review: 'rv-1111111111111111', targetContext: null, to: native.current.tenants[1]!.id, pending: { conversation: 'op-7', decision: 'ap-1' }, completion: false }\n?? docs/planning/reviews/C29/attempt-09/\n","exit_code":0,"status":"completed"}}
