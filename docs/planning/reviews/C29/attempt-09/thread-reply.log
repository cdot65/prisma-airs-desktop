{"type":"item.completed","item":{"id":"item_66","type":"command_execution","command":"/bin/zsh -lc \"sed -n '1,100p' tools/native-acceptance/live_c29_l19.py; sed -n '1,170p' apps/desktop/src/v2/store.ts; sed -n '270,368p' apps/desktop/src/v2/wizard/wizard.test.tsx; sed -n '285,380p' crates/desktop-core/src/store.rs\"","aggregated_output":"#!/usr/bin/env python3\n\"\"\"One approved C29 wizard verify. Run from the granted native queue, never\nagainst a synthetic-keychain fixture bundle. No automatic live retry.\n\nThe qualification bundle uses production adapters with a separate data identity;\nthe exact build, source, flags and executable are recorded by its build receipt.\nOnly a locally stored placeholder scan key and the approved management client\nare entered. Only Runtime Security is selected, and onboarding is not completed.\n\"\"\"\nimport argparse\nimport datetime\nimport fcntl\nimport hashlib\nimport json\nimport os\nfrom pathlib import Path\nimport re\nimport shutil\nimport signal\nimport subprocess\nimport sys\nimport tempfile\nimport time\n\nsys.path.insert(0, str(Path(__file__).resolve().parent))\nimport fixture_app as fx\n\nIDENTITY = 'io.cdot.prisma-airs-desktop.v2.l19qual'\nSERVICE = 'io.cdot.prisma-airs-desktop.v2.scan'\nLIVE_REF = ('io.cdot.prisma-airs-desktop.v2.live', 'mgmt-vulture-client-secret')\nOPERATION = 'one management credential verification through the first-run wizard (C29): one latest security-profile probe with limit=1; discard profile contents; no other inventory browsing or writes'\nROOT = Path.cwd().resolve()\nDATA = Path.home() / 'Library/Application Support' / IDENTITY\nEXE = None\n\n\ndef sha(path):\n    return hashlib.sha256(Path(path).read_bytes()).hexdigest()\n\n\ndef write(path, value):\n    path.parent.mkdir(parents=True, exist_ok=True)\n    path.write_text(json.dumps(value, indent=2) + '\\n')\n\n\nclass PrivateApp(fx.App):\n    @staticmethod\n    def running_pid():\n        rows = fx.sh(['ps', '-axo', 'pid=,comm=']).stdout.splitlines()\n        ids = [int(parts[0]) for row in rows if len(parts := row.strip().split(None, 1)) == 2 and parts[1] == str(EXE)]\n        if len(ids) > 1:\n            raise RuntimeError('multiple qualification processes')\n        return ids[0] if ids else None\n\n    def quit(self):\n        pid = self.running_pid()\n        if pid:\n            os.kill(pid, signal.SIGTERM)\n            for _ in range(40):\n                if not self.running_pid():\n                    break\n                time.sleep(.25)\n            if self.running_pid():\n                os.kill(pid, signal.SIGKILL)\n                time.sleep(.5)\n            if self.running_pid():\n                raise RuntimeError('qualification process did not stop')\n        self.pid = None\n\n    def ax(self, command, *args):\n        # No automatic diagnostic tree during private entry or on failure.\n        out = fx.sh([self.ax_bin, command, str(self.pid), *map(str, args)])\n        if out.returncode:\n            raise RuntimeError(f'accessibility {command} failed')\n        return json.loads(out.stdout or '[]') if command == 'tree' else out.stdout\n\n    def private_type(self, label, value, helper):\n        self.ax('focus', 'AXTextField', label, 0)\n        self.front()\n        result = subprocess.run([str(helper), str(self.pid)], input=value, text=True, capture_output=True)\n        if result.returncode:\n            raise RuntimeError('private credential entry failed')\n        time.sleep(.5)\n        field = self.field('AXTextField', label) or {}\n        arrived = str(field.get('value') or '')\n        if len(arrived) != len(value) or not set(arrived) <= {'•'}:\n            raise RuntimeError('private field did not report a masked value')\n\n\ndef require(app, predicate, message, timeout=20):\n    tree, ok = app.wait_for(predicate, timeout)\n    if not ok:\n        raise RuntimeError(message)\n    return tree\n\n\ndef press(app, label):\n    require(app, lambda t: app.node(t, 'AXButton', label) is not None, f'{label} unavailable')\n    app.ax('press', 'AXButton', label)\n    time.sleep(.5)\nimport { create } from 'zustand'\n\nexport type ToastKind = 'ok' | 'info' | 'warn'\nimport type { AdminProductId, FeatureId, Intent, ManagementResource } from '@prisma-airs/desktop-contracts'\n\n/** What a contextual action asked the destination to select on arrival (C30), owned by the tenant it was followed in (I2). */\nexport interface Arrival {\n    tenant: string\n    feature: FeatureId\n    resource: ManagementResource | null\n    /** The item to filter to, by name. */\n    item: string | null\n    /** The Administration product to open (the rail's product children, C35). */\n    product?: AdminProductId\n    /** That product's tab to show, by the inventory's tab id (the tenant menu's workspace row, C35). */\n    tab?: string\n    /** Counts arrivals: a destination already open applies a new one. */\n    sequence: number\n}\n\n/** A Harness message kept for the operator: refused or never sent, or not confirmed (C32). */\nexport interface HarnessKept {\n    /** This record's own id: each attempt is its own record (C32). */\n    id: number\n    text: string\n    unconfirmed: boolean\n    /**\n     * For an unconfirmed send: the conversation it was sent to and the send's\n     * own ID. It is settled only when that conversation reports the core took\n     * that ID (`ConversationView.submissions`), never by matching text (C32).\n     */\n    conversation?: string\n    submission?: string\n}\n\n/** A Harness send the page dispatched, awaiting the core's word on it (C32): never shown, never sent again. */\nexport interface HarnessSent {\n    submission: string\n    conversation: string\n    text: string\n}\n\n/**\n * A Runtime case handed to the Playground (C33): Administration opens Runtime\n * Security's Playground tab with the case's fields; the operator runs the\n * scan there. Bound to the tenant it was opened in.\n */\nexport interface PlaygroundCase {\n    tenant: string\n    caseId: string\n    prefill: import('../features/library/library-view').CasePrefill\n}\n\n/** A delivery the desktop did not confirm: kept until the operator retries or dismisses it (DESIGN-V2 §7). */\nexport interface Unconfirmed {\n    id: number\n    what: string\n    intent: Intent\n    /** The native context or captured switch source this delivery belongs to; retirement never rebinds it. */\n    context: string | null\n}\n\n/** An initial tenant selection captures even the absence of an active context. */\nexport function unconfirmedInContext(delivery: Pick<Unconfirmed, 'intent' | 'context'>, context: string | null): boolean {\n    return delivery.context === context || (delivery.context === null && delivery.intent.kind !== 'selectTenant')\n}\n\nfunction switchResolution(intent: Intent) {\n    return intent.kind === 'selectTenant' || intent.kind === 'completeTenantSetup' ? intent.resolution : null\n}\n\n/** A destructive switch is bound to its source, not its destination or setup draft. */\nexport function deliveryContext(intent: Intent): string | null {\n    const resolution = switchResolution(intent)\n    if (resolution) return resolution.context\n    return 'context' in intent && typeof intent.context === 'string' ? intent.context : null\n}\n\nexport interface Toast {\n    id: number\n    kind: ToastKind\n    text: string\n    /** An optional undo the toast offers (label + action). */\n    undo?: { label: string; run: () => void }\n    /** The tenant the toast speaks for (an item, a read): retired on leaving it (I2). */\n    tenant: string | null\n    /** The context it was raised under, when the action was context-bound: retired with it. */\n    context: string | null\n}\n\n/**\n * Transient shell presentation state (state-ownership.md \"UI\"): what is open,\n * the palette query, toasts and the modal stack. Nothing here survives a\n * reload and nothing here is authority: every durable fact is observed from\n * the Rust snapshot.\n */\ninterface ShellStore {\n    /** The scope the shell shows now (set from each snapshot before it renders): what a notification must belong to. */\n    scope: { tenant: string | null; context: string | null; switchReview: string | null }\n    setScope(tenant: string | null, context: string | null, switchReview?: string | null): void\n    paletteOpen: boolean\n    switcherOpen: boolean\n    /** The rail's Administration children shown or hidden (C35; the prototype's `adminNav`). */\n    adminNavOpen: boolean\n    setAdminNav(open: boolean): void\n    toasts: Toast[]\n    /** Open modal ids, bottom to top; only the last is interactive (I8). */\n    modals: string[]\n    /** The Inbox tab and item per tenant (I2: a switch round trip keeps it). */\n    inboxSelection: Record<string, { tab: 'all' | 'action' | 'updates' | 'snoozed'; item: string | null }>\n    selectInbox(tenant: string, selection: { tab: 'all' | 'action' | 'updates' | 'snoozed'; item: string | null }): void\n    /** Harness drafts, by `tenant|workspace|conversation` (C32): kept across navigation and tenant round trips, never shared between scopes, never sent by themselves. */\n    harnessDrafts: Record<string, string>\n    setHarnessDraft(scope: string, text: string): void\n    /** Per `tenant|workspace`: the operator chose a new investigation while one runs (C32). */\n    harnessFresh: Record<string, boolean>\n    setHarnessFresh(scope: string, fresh: boolean): void\n    /**\n     * Per `tenant|workspace`: messages kept for the operator (C32). `unconfirmed`\n     * ones may have been delivered (the desktop did not confirm it); the others\n     * were refused or never sent. Never sent by themselves.\n     */\n    harnessUnsent: Record<string, HarnessKept[]>\n    keepHarnessUnsent(scope: string, kept: Omit<HarnessKept, 'id'>): void\n    dropHarnessUnsent(scope: string, id: number): void\n    /**\n     * Per `tenant|workspace`: sends dispatched and not yet reported by their\n     * conversation (C32), so a send the core gives back keeps its text whatever\n     * order its receipt and the core's word arrive in. Newest 64.\n     */\n    harnessSent: Record<string, HarnessSent[]>\n    /** The case last handed to the Playground (C33); never runs anything by itself. */\n    playground: PlaygroundCase | null\n    openPlayground(target: Omit<PlaygroundCase, 'prefill'> & { prefill: Omit<PlaygroundCase['prefill'], 'nonce'> }): void\n    trackHarnessSend(scope: string, sent: HarnessSent): void\n    untrackHarnessSend(scope: string, submission: string): void\n    /** The last contextual action's target, consumed by the destination it names. */\n    arrival: Arrival | null\n    arrive(target: Omit<Arrival, 'sequence'>): void\n    /** Forgets an arrival that belongs to another tenant than `tenant`. */\n    scopeArrival(tenant: string | null): void\n    /** Drops unconfirmed deliveries bound to a context other than `context` (their authority retired). */\n    retireUnconfirmed(context: string | null): void\n    unconfirmed: Unconfirmed[]\n    /** Toast lifetime in ms (6 s; tests shorten it). */\n    toastMs: number\n    addUnconfirmed(what: string, intent: Intent, sourceContext?: string | null): number\n    clearUnconfirmed(id: number): void\n    openPalette(): void\n    closePalette(): void\n    setSwitcher(open: boolean): void\n    toast(text: string, kind?: ToastKind, undo?: Toast['undo'], tenant?: string | null, context?: string | null): number\n    /** Retires toasts that speak for another tenant than `tenant`. */\n    retireToasts(tenant: string | null): void\n    dismissToast(id: number): void\n    pushModal(id: string): void\n    popModal(id: string): void\n}\n\nlet nextToast = 1\nlet nextKept = 1\n\nexport const useShellStore = create<ShellStore>((set, get) => ({\n    scope: { tenant: null, context: null, switchReview: null },\n    setScope: (tenant, context, switchReview = null) =>\n        set((s) => ({\n            scope: { tenant, context, switchReview },\n            // Leaving a scope retires what spoke for it, however late it would have arrived.\n            toasts: s.toasts.filter((t) => (t.tenant === null || t.tenant === tenant) && (t.context === null || t.context === context)),\n            unconfirmed: s.unconfirmed.filter((u) => unconfirmedInContext(u, context) && (!switchResolution(u.intent) || switchResolution(u.intent)?.review === switchReview)),\n\n    it('waits for a pending creation on Cancel and discards what it produced before closing', async () => {\n        const user = userEvent.setup()\n        const native = await launch(fxSwitcher())\n        await user.click(screen.getByRole('button', { name: /^Switch tenant/ }))\n        await user.click(screen.getByRole('button', { name: 'Add a tenant…' }))\n        const sheet = screen.getByRole('dialog', { name: 'Add a tenant' })\n        await user.type(within(sheet).getByLabelText(/Display name/), 'Coastal Bank')\n        await user.type(within(sheet).getByLabelText(/TSG ID/), '2000000001')\n        let answer: (value: unknown) => void = () => undefined\n        native.respond = () => new Promise((resolve) => (answer = resolve))\n        await user.click(within(sheet).getByRole('button', { name: 'Create tenant' }))\n        await user.click(within(sheet).getByRole('button', { name: 'Cancel' }))\n        // Nothing closes and nothing is discarded while the creation is undecided.\n        expect(screen.getByRole('dialog', { name: 'Add a tenant' })).toBeInTheDocument()\n        expect(native.dispatched.filter((i) => i.kind === 'discardTenantSetup')).toHaveLength(0)\n        native.respond = () => admitted()\n        // The receipt settles first, on its own render: the draft is coming, so the\n        // sheet must neither close nor discard yet.\n        answer(admitted())\n        await waitFor(() => expect(within(sheet).getByRole('button', { name: 'Discarding…' })).toBeDisabled())\n        await new Promise((r) => setTimeout(r, 30))\n        expect(screen.getByRole('dialog', { name: 'Add a tenant' })).toBeInTheDocument()\n        expect(native.dispatched.filter((i) => i.kind === 'discardTenantSetup')).toHaveLength(0)\n        await native.push({ ...native.current, setup: setupView({ mode: 'add', scanRequired: false, tenant: draft({ label: 'Coastal Bank', tsgId: '2000000001', environment: 'production', destination: { kind: 'region', region: 'unitedStates' } }) }) })\n        await waitFor(() => expect(native.dispatched.filter((i) => i.kind === 'discardTenantSetup')).toHaveLength(1))\n        expect(native.dispatched.at(-1)).toEqual({ kind: 'discardTenantSetup', context: DRAFT_CONTEXT })\n        await waitFor(() => expect(screen.queryByRole('dialog')).toBeNull())\n    })\n\n    it('discards the draft once when its snapshot arrives before the creation receipt', async () => {\n        const user = userEvent.setup()\n        const native = await launch(fxSwitcher())\n        await user.click(screen.getByRole('button', { name: /^Switch tenant/ }))\n        await user.click(screen.getByRole('button', { name: 'Add a tenant…' }))\n        const sheet = screen.getByRole('dialog', { name: 'Add a tenant' })\n        await user.type(within(sheet).getByLabelText(/Display name/), 'Coastal Bank')\n        await user.type(within(sheet).getByLabelText(/TSG ID/), '2000000001')\n        let answer: (value: unknown) => void = () => undefined\n        native.respond = () => new Promise((resolve) => (answer = resolve))\n        await user.click(within(sheet).getByRole('button', { name: 'Create tenant' }))\n        await user.click(within(sheet).getByRole('button', { name: 'Cancel' }))\n        // The draft shows up first; the receipt is still outstanding.\n        await native.push({ ...native.current, setup: setupView({ mode: 'add', scanRequired: false, tenant: draft({ label: 'Coastal Bank', tsgId: '2000000001', environment: 'production', destination: { kind: 'region', region: 'unitedStates' } }) }) })\n        expect(native.dispatched.filter((i) => i.kind === 'discardTenantSetup')).toHaveLength(0)\n        native.respond = () => admitted()\n        answer(admitted())\n        await waitFor(() => expect(native.dispatched.filter((i) => i.kind === 'discardTenantSetup')).toHaveLength(1))\n        await waitFor(() => expect(screen.queryByRole('dialog')).toBeNull())\n    })\n\n    it('an unconfirmed discard with the draft still present offers Retry, which discards and closes', async () => {\n        const user = userEvent.setup()\n        const native = await launch({ ...fxSwitcher(), setup: setupView({ mode: 'add', scanRequired: false, tenant: draft({ label: 'Coastal Bank', tsgId: '2000000001' }) }) })\n        await user.click(screen.getByRole('button', { name: /^Switch tenant/ }))\n        await user.click(screen.getByRole('button', { name: 'Add a tenant…' }))\n        const sheet = screen.getByRole('dialog', { name: 'Add a tenant' })\n        native.respond = () => {\n            throw new DeliveryOutcomeUnknown('lost')\n        }\n        await user.click(within(sheet).getByRole('button', { name: 'Cancel' }))\n        await within(sheet).findByText('Sent but not confirmed. The current state is shown.')\n        // The draft is still there: Retry is offered; Escape is the same retry.\n        await native.push({ ...native.current })\n        expect(screen.getByRole('dialog', { name: 'Add a tenant' })).toBeInTheDocument()\n        const sent = native.dispatched.filter((i) => i.kind === 'discardTenantSetup').length\n        native.respond = () => admitted()\n        await user.click(within(sheet).getByRole('button', { name: 'Retry' }))\n        expect(native.dispatched.filter((i) => i.kind === 'discardTenantSetup')).toHaveLength(sent + 1)\n        expect(native.dispatched.at(-1)).toEqual({ kind: 'discardTenantSetup', context: DRAFT_CONTEXT })\n        await waitFor(() => expect(screen.queryByRole('dialog')).toBeNull())\n    })\n\n    it('after an unconfirmed creation, Cancel discards the draft the next snapshot shows, and an unconfirmed discard closes once the draft is gone', async () => {\n        const user = userEvent.setup()\n        const native = await launch(fxSwitcher())\n        await user.click(screen.getByRole('button', { name: /^Switch tenant/ }))\n        await user.click(screen.getByRole('button', { name: 'Add a tenant…' }))\n        const sheet = screen.getByRole('dialog', { name: 'Add a tenant' })\n        await user.type(within(sheet).getByLabelText(/Display name/), 'Coastal Bank')\n        await user.type(within(sheet).getByLabelText(/TSG ID/), '2000000001')\n        native.respond = () => {\n            throw new DeliveryOutcomeUnknown('lost')\n        }\n        await user.click(within(sheet).getByRole('button', { name: 'Create tenant' }))\n        await within(sheet).findByText('Sent but not confirmed. The current state is shown.')\n        await user.click(within(sheet).getByRole('button', { name: 'Cancel' }))\n        expect(screen.getByRole('dialog', { name: 'Add a tenant' })).toBeInTheDocument()\n        expect(native.dispatched.filter((i) => i.kind === 'discardTenantSetup')).toHaveLength(0)\n        // The creation did go through: the draft appears, and the discard is sent — unconfirmed too.\n        await native.push({ ...native.current, setup: setupView({ mode: 'add', scanRequired: false, tenant: draft({ label: 'Coastal Bank', tsgId: '2000000001', environment: 'production', destination: { kind: 'region', region: 'unitedStates' } }) }) })\n        await waitFor(() => expect(native.dispatched.filter((i) => i.kind === 'discardTenantSetup').length).toBeGreaterThan(0))\n        expect(screen.getByRole('dialog', { name: 'Add a tenant' })).toBeInTheDocument()\n        native.respond = () => admitted()\n        await native.push({ ...native.current, setup: null })\n        await waitFor(() => expect(screen.queryByRole('dialog')).toBeNull())\n    })\n\n    it('the Done checks line is derived from the verification states: a warning and a failure are counted, a passed line is counted, and \"All passed\" needs every line to pass (attempt-01 R1)', async () => {\n            tenant_warnings: Vec::new(),\n            tenant_rotations: Vec::new(),\n            tenant_draft: None,\n        }\n    }\n}\n\nimpl PersistedState {\n    /// Structural checks beyond the schema: unique IDs and references to\n    /// existing tenants with valid profiles.\n    pub fn is_consistent(&self) -> bool {\n        let mut ids = BTreeSet::new();\n        let tenants_ok = self.tenants.iter().all(|t| {\n            ids.insert(t.id.clone())\n                && crate::tenants::ProfileDraft {\n                    label: t.label.clone(),\n                    tsg_id: t.tsg_id.clone(),\n                    destination: t.destination.clone(),\n                    environment: t.environment,\n                }\n                .validate()\n                .is_some_and(|d| {\n                    d.label == t.label && d.tsg_id == t.tsg_id && d.destination == t.destination\n                })\n        });\n        // A credential belongs to a tenant, or to the setup draft that was\n        // in progress (C29): its records are cleaned up on the next load.\n        let owners: Vec<&TenantProfile> = self\n            .tenants\n            .iter()\n            .chain(self.tenant_draft.as_ref().map(|d| &d.profile))\n            .collect();\n        let mut records = BTreeSet::new();\n        let credentials_ok = self.credentials.iter().all(|c| {\n            records.insert(c.record.clone())\n                && match c.class {\n                    CredentialClass::Scan => {\n                        c.client_id.is_none()\n                            && c.inference.is_none()\n                            && owners.iter().any(|t| {\n                                t.id == c.tenant && t.destination.origin() == c.destination\n                            })\n                    }\n                    // A management credential needs the tenant's TSG, its\n                    // client ID and an exact HTTPS token origin.\n                    CredentialClass::Management => {\n                        c.inference.is_none()\n                            && c.client_id\n                                .as_deref()\n                                .is_some_and(crate::management::client_id_is_valid)\n                            && crate::management::is_origin(&c.destination)\n                            && owners\n                                .iter()\n                                .any(|t| t.id == c.tenant && t.tsg_id.is_some())\n                    }\n                    // An inference key names its workspace and the HTTPS\n                    // runtime endpoint it is sent to.\n                    CredentialClass::Inference => {\n                        c.client_id.is_none()\n                            && c.inference\n                                .as_ref()\n                                .is_some_and(|t| t.is_valid() && t.endpoint == c.destination)\n                            && owners.iter().any(|t| t.id == c.tenant)\n                    }\n                }\n        });\n        let draft_ok = self.tenant_draft.as_ref().is_none_or(|d| {\n            !ids.contains(&d.profile.id)\n                && crate::tenants::ProfileDraft {\n                    label: d.profile.label.clone(),\n                    tsg_id: d.profile.tsg_id.clone(),\n                    destination: d.profile.destination.clone(),\n                    environment: d.profile.environment,\n                }\n                .validate()\n                .is_some()\n        });\n        let one_per_tenant = {\n            let mut seen = BTreeSet::new();\n            self.credentials\n                .iter()\n                .all(|c| seen.insert((c.tenant.clone(), c.class)))\n        };\n        let learner_ok = self.learner.as_ref().is_none_or(|l| {\n            crate::academy::is_account_id(&l.account_id)\n                && !l.display_name.trim().is_empty()\n                && crate::academy::origin_of(&l.issuer).as_deref() == Some(l.issuer.as_str())\n                && !l.client_id.is_empty()\n        });\n        // One remembered Gateway workspace per existing tenant.\n        let mut chose = BTreeSet::new();\n        let gateway_ok = self.gateway_workspaces.iter().all(|p| {\n            ids.contains(&p.tenant)\n                && chose.insert(p.tenant.clone())\n                && crate::gateway::is_id(&p.workspace)\n        });\n","exit_code":0,"status":"completed"}}
