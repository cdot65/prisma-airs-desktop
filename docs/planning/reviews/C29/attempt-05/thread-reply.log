   346	    /// Starts a verification run over the current inputs: every line is
   347	    /// decided in the core; the lines that need a service read are admitted
   348	    /// through the management pipeline and settle through it.
   349	    pub(super) fn begin_verify(
   350	        &mut self,
   351	        context: &ContextRef,
   352	        keychain: Arc<dyn super::CredentialStore>,
   353	        session_vault: Arc<SessionVault>,
   354	    ) -> Result<Vec<crate::runtime::Start>, Refusal> {
   355	        let setup = self.setup_for(context)?;
   356	        let generation = setup.verify.as_ref().map_or(1, |v| v.generation + 1);
   357	        let signature = Self::setup_signature(setup);
   358	        let mode = setup.mode;
   359	        let products = setup.products.clone();
   360	        let scan = setup.tenant.scan.clone();
   361	        let management_ready = matches!(setup.tenant.management, ScanCapability::Ready { .. });
   362	        let mut starts = Vec::new();
   363	        let mut steps = Vec::new();
   364	        let mut admit = |state: &mut Self, request: ManagementRequest| -> Option<OperationId> {
   365	            match state.admit_management(
   366	                context.clone(),
   367	                request,
   368	                Arc::clone(&keychain),
   369	                Arc::clone(&session_vault),
   370	            ) {
   371	                Ok((operation, s)) => {
   372	                    starts.extend(s);
   373	                    Some(operation)
   374	                }
   375	                Err(_) => None,
   376	            }
   377	        };
   378	        // Runtime Security scan key: stored keys are proven by the first
   379	        // scan (there is no admitted read that exercises a scan key).
   380	        let (state_, reason) = match scan {
   381	            ScanCapability::Ready { .. } => (
   382	                VerifyState::Stored,
   383	                "Stored in the Keychain. Not checked here: the first scan proves it against the service.",
   384	            ),
   385	            ScanCapability::Storing { .. } => {
   386	                (VerifyState::Fail, "The scan key is still being saved.")
   387	            }
   388	            _ if mode == SetupMode::FirstRun => (
   389	                VerifyState::Fail,
   390	                "No scan key saved. Runtime Security needs one on first run.",
   391	            ),
   392	            _ => (
   393	                VerifyState::Warning,
   394	                "No scan key saved; scans stay unavailable until one is added in Administration.",
   395	            ),
   396	        };
   397	        steps.push(StepState {
   398	            step: VerifyStep {
   399	                line: VerifyLine::ScanKey,
   400	                product: Some(ProductId::RuntimeSecurity),
   401	                state: state_,
   402	                reason: reason.to_owned(),
   403	            },
   404	            operation: None,
   405	        });

