   176	    /// Starts a setup with a validated profile. One draft at a time.
   177	    pub(super) fn begin_setup(
   178	        &mut self,
   179	        mode: SetupMode,
   180	        profile: ProfileDraft,
   181	    ) -> Result<(), Refusal> {
   182	        let profile = profile.validate().ok_or(Refusal::InvalidInput)?;
   183	        if self.data.setup.is_some() {
   184	            return Err(Refusal::Busy);
   185	        }
   186	        if self.data.tenants.len() >= MAX_TENANTS {
   187	            return Err(Refusal::Busy);
   188	        }
   189	        if mode == SetupMode::FirstRun && !self.data.tenants.is_empty() {
   190	            return Err(Refusal::InvalidInput);
   191	        }
   192	        let id = TenantId::issue().ok_or(Refusal::ShuttingDown)?;
   193	        self.epoch += 1;
   194	        let context = ContextRef::issue(&self.salt, self.epoch);
   195	        self.data.setup = Some(Setup {
   196	            mode,
   197	            tenant: Tenant::new(TenantProfile {
   198	                id,
   199	                label: profile.label,
   200	                tsg_id: profile.tsg_id,
   201	                destination: profile.destination,
   202	                environment: profile.environment,
   203	            }),
   204	            context,
   205	            products: vec![ProductId::RuntimeSecurity],
   206	            verify: None,
   207	            gateway: SetupGateway::default(),
   208	        });
   209	        Ok(())
   210	    }
