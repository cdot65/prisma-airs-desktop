   310	    /// A digest of every input verification depends on: profile, products
   311	    /// and the credential records. Results for another digest are stale.
   312	    fn setup_signature(setup: &Setup) -> u64 {
   313	        let mut h = DefaultHasher::new();
   314	        let p = &setup.tenant.profile;
   315	        p.label.hash(&mut h);
   316	        p.tsg_id.hash(&mut h);
   317	        p.destination.origin().hash(&mut h);
   318	        (p.environment as u8).hash(&mut h);
   319	        for product in &setup.products {
   320	            (*product as u8).hash(&mut h);
   321	        }
   322	        for class in [
   323	            CredentialClass::Scan,
   324	            CredentialClass::Management,
   325	            CredentialClass::Inference,
   326	        ] {
   327	            match setup.tenant.capability(class) {
   328	                ScanCapability::Ready { record, .. } => record.as_str().hash(&mut h),
   329	                ScanCapability::Storing { record, .. } => {
   330	                    "storing".hash(&mut h);
   331	                    record.as_str().hash(&mut h);
   332	                }
   333	                ScanCapability::Missing | ScanCapability::Failed { .. } => "none".hash(&mut h),
   334	            }
   335	        }
   336	        setup.tenant.management_client.hash(&mut h);
   337	        setup
   338	            .gateway
   339	            .selection
   340	            .as_ref()
   341	            .map(|s| s.workspace.id.as_str())
   342	            .hash(&mut h);
   343	        h.finish()
   344	    }
