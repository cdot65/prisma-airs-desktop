   733	    fn verify_view(setup: &Setup) -> Option<VerifyView> {
   734	        let run = setup.verify.as_ref()?;
   735	        let steps: Vec<VerifyStep> = run.steps.iter().map(|s| s.step.clone()).collect();
   736	        let done = steps.iter().all(|s| s.state != VerifyState::Pending);
   737	        let failed = steps.iter().any(|s| s.state == VerifyState::Fail);
   738	        // Only a required line blocks: the scan key on first run. An optional
   739	        // service that failed is carried as a warning the operator can
   740	        // continue over (and the Inbox shows).
   741	        let blocking = steps
   742	            .iter()
   743	            .any(|s| s.state == VerifyState::Fail && s.line == VerifyLine::ScanKey);
   744	        let warnings = steps
   745	            .iter()
   746	            .filter_map(|s| {
   747	                let product = s.product?;
   748	                match s.state {
   749	                    VerifyState::Warning => Some(VerifyWarning {
   750	                        product,
   751	                        reason: s.reason.clone(),
   752	                    }),
   753	                    VerifyState::Fail if s.line != VerifyLine::ScanKey => Some(VerifyWarning {
   754	                        product,
   755	                        reason: format!("Failed: {}", s.reason),
   756	                    }),
   757	                    _ => None,
   758	                }
   759	            })
   760	            .collect();
   761	        Some(VerifyView {
   762	            generation: run.generation,
   763	            steps,
   764	            done,
   765	            failed,
   766	            blocking,
   767	            stale: run.signature != Self::setup_signature(setup),
   768	            warnings,
   769	        })
   770	    }
   771	
   772	    /// The draft as the shell shows it.
   773	    pub(super) fn setup_view(&self) -> Option<SetupView> {
   774	        let setup = self.data.setup.as_ref()?;
   775	        let verify = Self::verify_view(setup);
   776	        let completable = verify
   777	            .as_ref()
   778	            .is_some_and(|v| v.done && !v.blocking && !v.stale);
   779	        let packs = setup
   780	            .products
   781	            .iter()
   782	            .map(|p| PackView {
   783	                product: *p,
   784	                count: case_products(*p)
   785	                    .iter()
   786	                    .map(|cp| {
   787	                        pack_counts()
   788	                            .iter()
   789	                            .find(|(c, _)| c == cp)
   790	                            .map_or(0, |(_, n)| *n)
   791	                    })
   792	                    .sum(),
   793	            })
   794	            .collect();
