   259	    /// Changes the draft's profile. A new destination retires credentials
   260	    /// bound to the old one (returned session records are the caller's to
   261	    /// delete); verification results go stale through the signature.
   262	    pub(super) fn update_setup(
   263	        &mut self,
   264	        context: &ContextRef,
   265	        profile: ProfileDraft,
   266	    ) -> Result<Vec<RecordId>, Refusal> {
   267	        let profile = profile.validate().ok_or(Refusal::InvalidInput)?;
   268	        let setup = self.setup_for(context)?;
   269	        let id = setup.tenant.profile.id.clone();
   270	        let destination_changed = setup.tenant.profile.destination != profile.destination;
   271	        let tsg_changed = setup.tenant.profile.tsg_id != profile.tsg_id;
   272	        let mut retired = Vec::new();
   273	        if destination_changed {
   274	            for class in [
   275	                CredentialClass::Scan,
   276	                CredentialClass::Management,
   277	                CredentialClass::Inference,
   278	            ] {
   279	                retired.extend(self.retire_class(&id, class));
   280	            }
   281	        } else if tsg_changed {
   282	            retired.extend(self.retire_class(&id, CredentialClass::Management));
   283	        }
   284	        let setup = self.setup_for_mut(context)?;
   285	        let changed = setup.tenant.profile.label != profile.label
   286	            || setup.tenant.profile.tsg_id != profile.tsg_id
   287	            || setup.tenant.profile.destination != profile.destination
   288	            || setup.tenant.profile.environment != profile.environment;
   289	        setup.tenant.profile.label = profile.label;
   290	        setup.tenant.profile.tsg_id = profile.tsg_id;
   291	        setup.tenant.profile.destination = profile.destination;
   292	        setup.tenant.profile.environment = profile.environment;
   293	        if changed {
   294	            self.reissue_setup_context();
   295	        }
   296	        Ok(retired)
   297	    }
