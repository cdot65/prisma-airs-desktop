   704	function Field({ label, name, hint, error, onBlur, value, onChange, ...rest }: { label: string; name: string; hint?: string; error?: string; onBlur?: (value: string) => void; value?: string; onChange?: (value: string) => void; maxLength?: number; inputMode?: 'numeric' }) {
   705	    const id = useId()
   706	    return (
   707	        <label className='flex flex-col gap-1 text-[13px] font-medium'>
   708	            {label}
   709	            <input id={id} name={name} autoComplete='off' value={value} onChange={onChange ? (e) => onChange(e.target.value) : undefined} aria-invalid={error ? true : undefined} aria-describedby={error ? `${id}-error` : hint ? `${id}-hint` : undefined} onBlur={(e) => onBlur?.(e.target.value)} className='h-8 px-2' {...rest} />
   710	            {error ? (
   711	                <span id={`${id}-error`} role='alert' className='text-[12px] font-normal' style={{ color: 'var(--v2-block)' }}>
   712	                    {error}
   713	                </span>
   714	            ) : hint ? (
   715	                <span id={`${id}-hint`} className='text-[12px] font-normal' style={{ color: 'var(--v2-faint)' }}>
   716	                    {hint}
   717	                </span>
   718	            ) : null}
   719	        </label>
   720	    )
   721	}
