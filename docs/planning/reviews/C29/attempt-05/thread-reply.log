/**
 * Wizard board fixtures (docs/architecture/ui-v2/screens/boards.md, `fx.on.*`
 * and `fx.addTenant`): every reviewed R2Onboard state as the native snapshot
 * the real DesktopClient parses, with the setup draft the core would hold at
 * that point and the step the wizard opens on.
 */
import type { SetupView, ShellSnapshot, TenantView, VerifyStep, VerifyView } from '@prisma-airs/desktop-contracts'
import { tenant } from '../../test/native'
import { fxHome, fxSwitcher } from '../fixtures'
import type { WizardInitial } from './wizard'

export interface WizardBoard {
    snapshot: ShellSnapshot
    mode: 'firstRun' | 'add'
    initial?: WizardInitial
}

export const DRAFT_CONTEXT = 'cx-draft00000000000000000000'
const DRAFT_ID = 'tn-00000000d4af7001'

/** The draft Northwind Health as the core shows it, with the credentials given. */
export function draft(over: Partial<TenantView> = {}): TenantView {
    return tenant({ id: DRAFT_ID, label: 'Northwind Health', tsgId: '1762204418', environment: 'staging', destination: { kind: 'region', region: 'europe' }, ...over })
}
const keyed = (): TenantView => draft({ scan: { state: 'ready', mode: 'keychain', failure: null } })

const STORED: VerifyStep = { line: 'scanKey', product: 'runtimeSecurity', state: 'stored', reason: 'Stored in the Keychain. Not checked here: the first scan proves it against the service.' }
const CLIENT_SKIPPED: VerifyStep = { line: 'managementClient', product: 'runtimeSecurity', state: 'skipped', reason: 'No management client; Administration stays read-only.' }
export const UNAVAILABLE: VerifyStep[] = [
    { line: 'ais', product: null, state: 'unavailable', reason: 'Not available in this release: no admitted service (D058).' },
    { line: 'aes', product: null, state: 'unavailable', reason: 'Not available in this release: no admitted service (D058).' },
]

/** A verify view as the core derives it: warnings carry warning lines and failed optional lines; only the scan key blocks. */
export function verifyView(lines: VerifyStep[], over: Partial<VerifyView> = {}): VerifyView {
    const steps = [...lines, ...UNAVAILABLE]
    const done = steps.every((s) => s.state !== 'pending')
    const warnings = steps.flatMap((s) => (s.product === null ? [] : s.state === 'warning' ? [{ product: s.product, reason: s.reason }] : s.state === 'fail' && s.line !== 'scanKey' ? [{ product: s.product, reason: `Failed: ${s.reason}` }] : []))
    return { generation: 1, steps, done, failed: steps.some((s) => s.state === 'fail'), blocking: steps.some((s) => s.state === 'fail' && s.line === 'scanKey'), stale: false, warnings, ...over }
}

export function setupView(over: Partial<SetupView> = {}): SetupView {
    const verify = over.verify ?? null
    return {
        mode: 'firstRun',
        context: DRAFT_CONTEXT,
        tenant: keyed(),
        products: ['runtimeSecurity'],
        scanRequired: true,
        packs: [{ product: 'runtimeSecurity', count: 6 }],
        workspace: null,
        verify,
        completable: Boolean(verify && verify.done && !verify.blocking && !verify.stale),
        ...over,
    }
}

const needed = (): ShellSnapshot => ({ ...fxHome(), onboarding: 'needed', tenants: [], active: null })
const withSetup = (setup: SetupView): ShellSnapshot => ({ ...needed(), onboarding: 'inProgress', setup })
const VERIFIED = verifyView([STORED, CLIENT_SKIPPED])

export const fxOn = {
    /** R2On01 */
    welcome: (): WizardBoard => ({ snapshot: needed(), mode: 'firstRun' }),
    /** R2On02: the tenant step before anything is drafted. */
    tenantEmpty: (): WizardBoard => ({ snapshot: { ...needed(), onboarding: 'inProgress' }, mode: 'firstRun', initial: { step: 'tenant' } }),
    /** R2On02b: drafted and keyed; the rail carries the context line. */
    tenantFilled: (): WizardBoard => ({ snapshot: withSetup(setupView()), mode: 'firstRun', initial: { step: 'tenant' } }),
    /** R2On03 */
    products: (): WizardBoard => ({ snapshot: withSetup(setupView({ products: ['runtimeSecurity', 'gateway'], packs: [{ product: 'runtimeSecurity', count: 6 }, { product: 'gateway', count: 2 }] })), mode: 'firstRun', initial: { step: 'products' } }),
    /** R2On04: results streaming in. */
    verifyRunning: (): WizardBoard => ({
        snapshot: withSetup(setupView({ products: ['runtimeSecurity', 'gateway'], verify: verifyView([STORED, { line: 'managementClient', product: 'runtimeSecurity', state: 'pending', reason: 'Reading…' }, { line: 'gateway', product: 'gateway', state: 'pending', reason: 'Reading…' }]) })),
        mode: 'firstRun',
        initial: { step: 'verify' },
    }),
    /** R2On04b: a warning row on an admitted product. */
    verifyWarn: (): WizardBoard => ({
        snapshot: withSetup(setupView({ products: ['runtimeSecurity', 'gateway'], verify: verifyView([STORED, { line: 'managementClient', product: 'runtimeSecurity', state: 'warning', reason: 'No management client: AI Gateway stay read-only until one is saved in Administration.' }, { line: 'gateway', product: 'gateway', state: 'warning', reason: 'Needs the management client; not checked.' }]) })),
        mode: 'firstRun',
        initial: { step: 'verify' },
    }),
    /** R2On04c: a required line failed (first run without a scan key): blocked. */
    verifyFail: (): WizardBoard => ({
        snapshot: withSetup(setupView({ tenant: draft({ management: { state: 'ready', mode: 'keychain', failure: null, clientId: 'svc@1762204418.iam.example', tokenOrigin: 'https://auth.apps.paloaltonetworks.com' } }), verify: verifyView([{ line: 'scanKey', product: 'runtimeSecurity', state: 'fail', reason: 'No scan key saved. Runtime Security needs one on first run.' }, { line: 'managementClient', product: 'runtimeSecurity', state: 'pass', reason: 'The management client can read this tenant.' }]) })),
        mode: 'firstRun',
        initial: { step: 'verify' },
    }),
    /** R2On04c-opt: an optional service failed: continue with it recorded as a warning, or fix it. */
    verifyOptionalFail: (): WizardBoard => ({
        snapshot: withSetup(setupView({ tenant: draft({ scan: { state: 'ready', mode: 'keychain', failure: null }, management: { state: 'ready', mode: 'keychain', failure: null, clientId: 'svc@1762204418.iam.example', tokenOrigin: 'https://auth.apps.paloaltonetworks.com' } }), verify: verifyView([STORED, { line: 'managementClient', product: 'runtimeSecurity', state: 'fail', reason: 'The management client was not accepted. Check the client ID and secret.' }]) })),
        mode: 'firstRun',
        initial: { step: 'verify' },
    }),
    /** R2On04d: results that no longer count after an edit. */
    verifyStale: (): WizardBoard => ({ snapshot: withSetup(setupView({ verify: verifyView([STORED, CLIENT_SKIPPED], { stale: true }) })), mode: 'firstRun', initial: { step: 'verify' } }),
    /** R2On05 */
    packs: (): WizardBoard => ({ snapshot: withSetup(setupView({ verify: VERIFIED })), mode: 'firstRun', initial: { step: 'packs' } }),
    /** R2On06 */
    academy: (): WizardBoard => ({ snapshot: withSetup(setupView({ verify: VERIFIED })), mode: 'firstRun', initial: { step: 'academy' } }),
    /** R2On07 */
    done: (): WizardBoard => ({ snapshot: withSetup(setupView({ verify: VERIFIED })), mode: 'firstRun', initial: { step: 'done', packs: ['runtimeSecurity'] } }),
}

/** R2AddTenant: the sheet over a shell that already has tenants, nothing drafted yet. */
export const fxAddTenant = (): WizardBoard => ({ snapshot: fxSwitcher(), mode: 'add' })
/** R2AddTenant drafted: the add sheet with an unkeyed draft (the key is optional there). */
export const fxAddTenantDrafted = (): WizardBoard => ({ snapshot: { ...fxSwitcher(), setup: setupView({ mode: 'add', scanRequired: false, tenant: draft({ label: 'Coastal Bank', tsgId: '2000000001' }) }) }, mode: 'add', initial: { step: 'tenant' } })
//! C29 (D058): tenant setup through the production authority interface.
//! The wizard works on one core-owned draft with its own context: credentials
//! attach to it, verification is decided in the core, completion commits the
//! draft as a tenant in one step, and a discard or relaunch leaves nothing
//! behind but a cleanup of its credentials.

use desktop_core::features::{OnboardingState, ProductId, VerifyLine, VerifyState};
use desktop_core::fixtures::{self, Handles, ScriptedStore};
use desktop_core::store::PersistedState;
use desktop_core::{
    AuthorityHandle, Core, CoreConfig, Delivery, Intent, Observation, Receipt, Refusal,
    ShellSnapshot, ViewScope,
};
use serde_json::json;

const KEY: &str = "synthetic-scan-key-aaaa";

struct Desk {
    _core: Core,
    handle: AuthorityHandle,
    session: String,
    sequence: u64,
    adapters: Handles,
}

impl Desk {
    fn new() -> Self {
        Self::from_state(PersistedState::default())
    }

    fn from_state(state: PersistedState) -> Self {
        let (adapters, handles) = fixtures::adapters_with(ScriptedStore::with_state(state));
        let core = Core::new(CoreConfig::default(), adapters);
        core.start();
        let handle = core.operator();
        let session = handle.register_delivery_session().expect("session").nonce;
        Self {
            _core: core,
            handle,
            session,
            sequence: 0,
            adapters: handles,
        }
    }

    fn restart(self) -> Self {
        let state = self.adapters.store.saved().unwrap_or_default();
        drop(self._core);
        Self::from_state(state)
    }

    async fn send(&mut self, intent: serde_json::Value) -> Result<Receipt, Refusal> {
        let intent: Intent = serde_json::from_value(intent).expect("intent");
        self.sequence += 1;
        self.handle
            .dispatch(
                Delivery {
                    session: self.session.clone(),
                    sequence: self.sequence,
                },
                intent,
            )
            .await
    }

    fn snap(&self) -> ShellSnapshot {
        match self.handle.observe(ViewScope::Shell).expect("observe") {
            Observation::Shell { snapshot, .. } => snapshot,
            _ => unreachable!("shell scope"),
        }
    }

    fn setup(&self) -> desktop_core::features::SetupView {
        self.snap().setup.expect("a setup in progress")
    }

    async fn begin(&mut self, mode: &str, label: &str) -> String {
        self.send(
            json!({"kind": "beginTenantSetup", "mode": mode, "profile": {
                "label": label, "tsgId": "1234567890",
                "destination": {"kind": "region", "region": "europe"}, "environment": "staging"
            }}),
        )
        .await
        .expect("begun");
        self.setup().context.as_str().to_owned()
    }

    /// The draft's current context: it changes whenever its inputs change.
    fn context(&self) -> String {
        self.setup().context.as_str().to_owned()
    }

    async fn settled(&self, ready: bool) {
        for _ in 0..200 {
            let s = self.setup();
            let state = s.tenant.scan.state;
            let done = if ready {
                state == desktop_core::ScanState::Ready
            } else {
                state != desktop_core::ScanState::Storing
            };
            if done {
                return;
            }
            tokio::time::sleep(std::time::Duration::from_millis(5)).await;
        }
        panic!("the scan key write did not settle");
    }

    async fn verified(&self) -> desktop_core::features::VerifyView {
        for _ in 0..200 {
            if let Some(v) = self.setup().verify
                && v.done
            {
                return v;
            }
            tokio::time::sleep(std::time::Duration::from_millis(5)).await;
        }
        panic!("verification did not finish");
    }
}

#[tokio::test]
async fn a_draft_is_not_a_tenant_and_first_run_needs_the_scan_key_to_verify() {
    let mut desk = Desk::new();
    desk.send(json!({"kind": "setUiVariant", "variant": "v2"}))
        .await
        .expect("v2");
    let context = desk.begin("firstRun", "Northwind Health").await;
    let snap = desk.snap();
    assert!(snap.tenants.is_empty(), "the draft is not listed");
    assert!(snap.active.is_none());
    assert_eq!(snap.onboarding, OnboardingState::Needed);
    let setup = snap.setup.expect("setup");
    assert_eq!(setup.tenant.label, "Northwind Health");
    assert_eq!(
        setup.tenant.environment,
        desktop_core::features::TenantEnvironment::Staging
    );
    );
    assert!(setup.scan_required);
    assert_eq!(setup.products, vec![ProductId::RuntimeSecurity]);
    assert!(setup.verify.is_none() && !setup.completable);
    // A second draft is refused while one is open.
    assert_eq!(
        desk.send(json!({"kind": "beginTenantSetup", "mode": "add", "profile": {
            "label": "Other", "tsgId": null, "destination": {"kind": "region", "region": "europe"}}}))
            .await,
        Err(Refusal::Busy)
    );
    // Without a scan key the verify run fails on first run, so completion is refused.
    desk.send(json!({"kind": "verifyTenantSetup", "context": context}))
        .await
        .expect("verify started");
    let v = desk.verified().await;
    let scan = v
        .steps
        .iter()
        .find(|s| s.line == VerifyLine::ScanKey)
        .expect("scan line");
    assert_eq!(scan.state, VerifyState::Fail);
    assert!(v.failed && !desk.setup().completable);
    assert_eq!(
        desk.send(json!({"kind": "completeTenantSetup", "context": context, "packs": []}))
            .await,
        Err(Refusal::InvalidInput)
    );
}

#[tokio::test]
async fn credentials_attach_to_the_draft_and_a_stored_key_is_never_a_pass() {
    let mut desk = Desk::new();
    let context = desk.begin("firstRun", "Northwind Health").await;
    desk.send(json!({"kind": "configureScanCredential", "context": context, "mode": "session", "key": KEY}))
        .await
        .expect("key accepted for the draft");
    desk.settled(true).await;
    let context = desk.context();
    assert!(desk.snap().tenants.is_empty(), "still no tenant");
    desk.send(json!({"kind": "verifyTenantSetup", "context": context}))
        .await
        .expect("verify");
    let v = desk.verified().await;
    let by_line = |line: VerifyLine| v.steps.iter().find(|s| s.line == line).cloned();
    let scan = by_line(VerifyLine::ScanKey).expect("scan");
    assert_eq!(
        scan.state,
        VerifyState::Stored,
        "explicitly unverified, not Pass"
    );
    assert!(scan.reason.contains("first scan proves it"));
    let management = by_line(VerifyLine::ManagementClient).expect("management");
    assert_eq!(management.state, VerifyState::Skipped);
    assert!(
        by_line(VerifyLine::Gateway).is_none(),
        "unselected products have no line"
    );
    assert!(v.done && !v.failed && !v.stale && v.warnings.is_empty());
    assert!(desk.setup().completable);
}

#[tokio::test]
async fn changing_inputs_makes_results_stale_and_products_needing_a_client_warn() {
    let mut desk = Desk::new();
    let context = desk.begin("firstRun", "Northwind Health").await;
    desk.send(json!({"kind": "configureScanCredential", "context": context, "mode": "session", "key": KEY}))
        .await
        .expect("key");
    desk.settled(true).await;
    let context = desk.context();
    desk.send(json!({"kind": "verifyTenantSetup", "context": context}))
        .await
        .expect("verify");
    let first = desk.verified().await;
    assert_eq!(first.generation, 1);
    // Choosing Gateway afterwards invalidates the run; completion is refused.
    desk.send(json!({"kind": "chooseSetupProducts", "context": context, "products": ["gateway", "gateway", "redTeam"]}))
        .await
        .expect("products");
    let setup = desk.setup();
    assert_eq!(
        setup.products,
        vec![
            ProductId::RuntimeSecurity,
            ProductId::Gateway,
            ProductId::RedTeam
        ]
    );
    assert!(setup.verify.expect("kept").stale && !setup.completable);
    assert_eq!(
        desk.send(json!({"kind": "completeTenantSetup", "context": context, "packs": []}))
            .await,
        Err(Refusal::InvalidInput)
    );
    desk.send(json!({"kind": "verifyTenantSetup", "context": context}))
        .await
        .expect("verify again");
    let second = desk.verified().await;
    assert_eq!(second.generation, 2);
    assert!(!second.stale);
    let lines: Vec<(VerifyLine, VerifyState)> =
        second.steps.iter().map(|s| (s.line, s.state)).collect();
    assert_eq!(
        lines,
        vec![
            (VerifyLine::ScanKey, VerifyState::Stored),
            (VerifyLine::ManagementClient, VerifyState::Warning),
            (VerifyLine::Gateway, VerifyState::Warning),
            (VerifyLine::RedTeam, VerifyState::Warning),
            (VerifyLine::Ais, VerifyState::Unavailable),
            (VerifyLine::Aes, VerifyState::Unavailable),
        ]
    );
    assert_eq!(second.warnings.len(), 3);
    assert_eq!(second.warnings[1].product, ProductId::Gateway);
    assert!(desk.setup().completable, "warnings do not block completion");
    // A profile change (new destination) retires the key and goes stale.
    desk.send(
        json!({"kind": "updateTenantSetup", "context": context, "profile": {
        "label": "Northwind Health", "tsgId": "1234567890",
        "destination": {"kind": "region", "region": "unitedStates"}, "environment": "production"}}),
    )
    .await
    .expect("updated");
    let setup = desk.setup();
    assert_eq!(setup.tenant.scan.state, desktop_core::ScanState::Missing);
    assert_eq!(
        setup.tenant.environment,
        desktop_core::features::TenantEnvironment::Production
    );
    assert!(
        setup.verify.is_none() && !setup.completable,
        "the run went with the old context"
    );
    assert_ne!(
        setup.context.as_str(),
        context,
        "a profile change retires the draft's context"
    );
    assert_eq!(
        desk.send(json!({"kind": "verifyTenantSetup", "context": context}))
            .await,
        Err(Refusal::StaleContext)
    );
}

#[tokio::test]
async fn completion_commits_the_draft_once_with_products_warnings_and_onboarding() {
    let mut desk = Desk::new();
    desk.send(json!({"kind": "setUiVariant", "variant": "v2"}))
                state.changed();
            }
        }
        Intent::BeginTenantSetup { mode, profile } => {
            state.require_storage()?;
            let before = state.data.clone();
            state.begin_setup(mode, profile)?;
            state.save_with(&before)?;
            state.changed();
        }
        Intent::UpdateTenantSetup { context, profile } => {
            state.require_storage()?;
            let before = state.data.clone();
            let retired = state.update_setup(&context, profile)?;
            state.save_with(&before)?;
            for old in retired {
                let _ = session.delete(&old);
            }
            effects.push(Effect::Cleanup);
            state.changed();
        }
        Intent::ChooseSetupProducts { context, products } => {
            state.require_storage()?;
            let before = state.data.clone();
            state.choose_setup_products(&context, products)?;
            state.save_with(&before)?;
            state.changed();
        }
        Intent::VerifyTenantSetup { context } => {
            let starts = state.begin_verify(
                &context,
                Arc::clone(&adapters.keychain),
                Arc::clone(session),
            )?;
            effects.push(Effect::Start(starts));
            effects.push(Effect::Start(state.take_gateway_starts()));
            state.changed();
        }
        Intent::CompleteTenantSetup { context, packs } => {
            state.require_storage()?;
            let before = state.data.clone();
            let recorded_secs = wall_secs(state.clock_offset);
            let done = state.complete_setup(&context, packs, recorded_secs)?;
            state.save_with(&before)?;
            effects.push(Effect::Start(state.reissue_context()));
            effects.push(Effect::Start(state.take_gateway_starts()));
            if !done.packs.is_empty() {
                let (lease, write) = state.queue_examples(&done.tenant, &done.packs);
                if let Some(lease) = lease {
                    effects.push(Effect::LoadLibrary { lease });
                }
                if let Some((tenant, generation)) = write {
                    effects.push(Effect::StoreLibrary { tenant, generation });
                }
            }
            let _ = done.first_run;
            state.changed();
        }
        Intent::DiscardTenantSetup { context } => {
            if state.setup_has_keychain_credential() {
                state.require_storage()?;
            }
            let before = state.data.clone();
            let retired = state.discard_setup(&context)?;
            if state.storage == StorageHealth::Ready {
                state.save_with(&before)?;
            }
            for old in retired {
                let _ = session.delete(&old);
            }
            effects.push(Effect::Start(state.take_gateway_starts()));
            effects.push(Effect::Cleanup);
            state.changed();
        }
        Intent::CreateTenant { profile } => {
            state.require_storage()?;
            let profile = profile.validate().ok_or(Refusal::InvalidInput)?;
            if state.data.tenants.len() >= MAX_TENANTS {
                return Err(Refusal::Busy);
            }
            let id = TenantId::issue().ok_or(Refusal::ShuttingDown)?;
            let before = state.data.clone();
            let select = state.data.active.is_none();
            state.data.tenants.push(Tenant::new(TenantProfile {
                id: id.clone(),
                label: profile.label,
                tsg_id: profile.tsg_id,
