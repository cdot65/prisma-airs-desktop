   220	    /// The draft's inputs changed (a credential, the profile): a fresh
   221	    /// context replaces the old one so nothing bound to it survives — the
   222	    /// cached management binding (SDK clients, token cache, TSG), reads in
   223	    /// flight, the verify run and the Gateway listing and choice.
   224	    pub(super) fn reissue_setup_context(&mut self) {
   225	        if self.data.setup.is_none() {
   226	            return;
   227	        }
   228	        self.epoch += 1;
   229	        let fresh = ContextRef::issue(&self.salt, self.epoch);
   230	        self.retire_setup_authority();
   231	        if let Some(setup) = self.data.setup.as_mut() {
   232	            setup.context = fresh;
   233	            setup.verify = None;
   234	            setup.gateway = SetupGateway::default();
   235	        }
   236	    }
   237	
   238	    /// A tenant was committed outside the setup (the legacy Create tenant
   239	    /// or a v1 import during first run): a first-run draft is over, since
   240	    /// the desktop now has a tenant and the shell takes over. Its Keychain
   241	    /// records go to the cleanup queue; returned session records are the
   242	    /// caller's to delete.
   243	    pub(super) fn end_first_run_setup(&mut self) -> Vec<RecordId> {
   244	        if self
   245	            .data
   246	            .setup
   247	            .as_ref()
   248	            .is_none_or(|s| s.mode != SetupMode::FirstRun)
   249	        {
   250	            return Vec::new();
   251	        }
   252	        let context = self.data.setup.as_ref().map(|s| s.context.clone());
   253	        match context {
   254	            Some(context) => self.discard_setup(&context).unwrap_or_default(),
   255	            None => Vec::new(),
   256	        }
   257	    }
