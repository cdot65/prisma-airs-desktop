{"type":"item.completed","item":{"id":"item_52","type":"command_execution","command":"/bin/zsh -lc \"sed -n '1980,2140p' crates/desktop-core/tests/harness_tools/main.rs; sed -n '520,616p' crates/desktop-core/tests/ui_v2_onboarding/main.rs\"","aggregated_output":"async fn guarded_resolution_save_failure(completion: bool, kind: &str) {\n    let mut desk = desk().await;\n    let dir = project();\n    choose_project(&mut desk, &dir).await;\n    let id = ready(&mut desk).await;\n    desk.say(&id, \"Say hello.\").await.expect(\"sent\");\n    desk.answered().await;\n    assert!(settle(|| !desk.conversation()[\"savedAt\"].is_null()).await);\n    let history = desk.conversation()[\"historyId\"]\n        .as_str()\n        .expect(\"history\")\n        .to_owned();\n    tool(&desk, None, \"exec_command\", json!({\"cmd\": \"ls\"}));\n    desk.say(&id, \"List the files.\")\n        .await\n        .expect(\"pending turn\");\n    answered_with(&mut desk, |c| {\n        c[\"approvals\"].as_array().is_some_and(|a| !a.is_empty())\n    })\n    .await;\n    let origin = desk.json()[\"tenants\"][0][\"origin\"]\n        .as_str()\n        .expect(\"origin\")\n        .to_owned();\n    let intent = if completion {\n        desk.send(json!({\"kind\":\"beginTenantSetup\",\"mode\":\"add\",\"profile\":{\"label\":\"Tenant B\",\"tsgId\":\"1234567890\",\"destination\":{\"kind\":\"custom\",\"origin\":origin}}})).await.expect(\"draft\");\n        let draft = desk.json()[\"setup\"][\"context\"]\n            .as_str()\n            .expect(\"draft context\")\n            .to_owned();\n        desk.send(json!({\"kind\":\"verifyTenantSetup\",\"context\":draft}))\n            .await\n            .expect(\"verify\");\n        assert!(settle(|| desk.json()[\"setup\"][\"verify\"][\"done\"] == true).await);\n        json!({\"kind\":\"completeTenantSetup\",\"context\":draft,\"packs\":[]})\n    } else {\n        desk.send(json!({\"kind\":\"createTenant\",\"profile\":{\"label\":\"Tenant B\",\"tsgId\":\"1234567890\",\"destination\":{\"kind\":\"custom\",\"origin\":origin}}})).await.expect(\"B\");\n        let b = desk.json()[\"tenants\"]\n            .as_array()\n            .expect(\"tenants\")\n            .iter()\n            .find(|t| t[\"label\"] == \"Tenant B\")\n            .expect(\"B\")[\"id\"]\n            .clone();\n        json!({\"kind\":\"selectTenant\",\"tenant\":b})\n    };\n    let resolved = reviewed_switch(&mut desk, intent, kind).await;\n    let before = desk.json();\n    let stored = serde_json::to_value(desk.adapters.store.saved()).expect(\"stored document\");\n    let protected: Vec<_> = files_under(&desk.history_root)\n        .into_iter()\n        .filter(|f| f.to_string_lossy().contains(&history))\n        .map(|f| {\n            let bytes = std::fs::read(&f).expect(\"protected transcript\");\n            (f, bytes)\n        })\n        .collect();\n    assert!(\n        !protected.is_empty(),\n        \"the completed first turn is protected on disk\"\n    );\n    desk.adapters.store.fail_saves(true);\n    assert_eq!(\n        desk.send(resolved.clone()).await,\n        Err(desktop_core::Refusal::DeniedStore)\n    );\n    let refused = desk.json();\n    assert_eq!(\n        refused[\"active\"], before[\"active\"],\n        \"the source remains active\"\n    );\n    assert_eq!(\n        refused[\"switchBlocked\"], before[\"switchBlocked\"],\n        \"save refusal preserves the exact native guard\"\n    );\n    assert_eq!(\n        refused[\"setup\"], before[\"setup\"],\n        \"the draft remains actionable\"\n    );\n    for field in [\"id\", \"phase\", \"approvals\", \"historyId\", \"savedAt\"] {\n        assert_eq!(\n            refused[\"harness\"][\"conversation\"][field], before[\"harness\"][\"conversation\"][field],\n            \"pending conversation {field} unchanged\"\n        );\n    }\n    assert_eq!(\n        serde_json::to_value(desk.adapters.store.saved()).expect(\"saved\"),\n        stored\n    );\n    for (path, bytes) in &protected {\n        assert_eq!(&std::fs::read(path).expect(\"still protected\"), bytes);\n    }\n    // Recovery uses the same refusal binding, with a new explicit delivery.\n    desk.adapters.store.fail_saves(false);\n    desk.send(resolved.clone())\n        .await\n        .expect(\"one successful resolution after storage recovery\");\n    assert_ne!(desk.json()[\"active\"][\"tenant\"], before[\"active\"][\"tenant\"]);\n    assert!(desk.json()[\"switchBlocked\"].is_null());\n    if completion {\n        assert!(desk.json()[\"setup\"].is_null());\n    }\n    assert_eq!(\n        desk.send(resolved).await,\n        Err(desktop_core::Refusal::StaleContext),\n        \"a consumed resolution cannot run again\"\n    );\n    desk.send(json!({\"kind\":\"selectTenant\",\"tenant\":before[\"active\"][\"tenant\"]}))\n        .await\n        .expect(\"back to source\");\n    assert!(\n        settle_for(30, || {\n            let c = desk.conversation();\n            c.is_null() || c[\"phase\"] == \"ended\"\n        })\n        .await\n    );\n    let mut listed = history_ids(&mut desk).await;\n    for _ in 0..60 {\n        if listed.contains(&history) == (kind == \"archive\") {\n            break;\n        }\n        tokio::time::sleep(Duration::from_millis(100)).await;\n        listed = history_ids(&mut desk).await;\n    }\n    assert_eq!(\n        listed.contains(&history),\n        kind == \"archive\",\n        \"successful recovery honors the chosen history outcome\"\n    );\n    assert_eq!(\n        files_under(&desk.history_root)\n            .iter()\n            .any(|f| f.to_string_lossy().contains(&history)),\n        kind == \"archive\"\n    );\n    std::fs::remove_dir_all(&dir).expect(\"cleanup\");\n}\n\n#[tokio::test(flavor = \"multi_thread\", worker_threads = 4)]\nasync fn select_archive_resolution_save_failure_preserves_pending_work() {\n    guarded_resolution_save_failure(false, \"archive\").await;\n}\n#[tokio::test(flavor = \"multi_thread\", worker_threads = 4)]\nasync fn select_discard_resolution_save_failure_preserves_pending_work() {\n    guarded_resolution_save_failure(false, \"discard\").await;\n}\n#[tokio::test(flavor = \"multi_thread\", worker_threads = 4)]\nasync fn setup_archive_resolution_save_failure_preserves_pending_work() {\n    guarded_resolution_save_failure(true, \"archive\").await;\n}\n#[tokio::test(flavor = \"multi_thread\", worker_threads = 4)]\nasync fn setup_discard_resolution_save_failure_preserves_pending_work() {\n    guarded_resolution_save_failure(true, \"discard\").await;\n}\n        .expect(\"created\");\n    assert_eq!(desk.snap().onboarding, OnboardingState::Done);\n    assert_eq!(\n        desk.adapters.store.saved().expect(\"saved\").onboarding,\n        OnboardingState::Needed,\n        \"the stored state is untouched\"\n    );\n    desk.send(json!({\"kind\": \"setUiVariant\", \"variant\": \"v2\"}))\n        .await\n        .expect(\"v2\");\n    assert_eq!(desk.snap().onboarding, OnboardingState::Done);\n}\n\n#[tokio::test]\nasync fn a_draft_id_is_never_selectable_or_deletable_as_a_tenant() {\n    let mut desk = Desk::new();\n    desk.send(json!({\"kind\": \"createTenant\", \"profile\": {\n        \"label\": \"First\", \"tsgId\": \"1111111111\", \"destination\": {\"kind\": \"region\", \"region\": \"europe\"}}}))\n        .await\n        .expect(\"first tenant\");\n    let before = desk.snap();\n    desk.begin(\"add\", \"Second\").await;\n    let draft_id = desk.setup().tenant.id.as_str().to_owned();\n    assert_eq!(\n        desk.send(json!({\"kind\": \"selectTenant\", \"tenant\": draft_id}))\n            .await,\n        Err(Refusal::InvalidInput),\n        \"a draft is not a tenant\"\n    );\n    assert_eq!(\n        desk.send(json!({\"kind\": \"deleteTenant\", \"tenant\": draft_id}))\n            .await,\n        Err(Refusal::InvalidInput)\n    );\n    let after = desk.snap();\n    assert_eq!(after.active, before.active);\n    assert_eq!(after.tenants, before.tenants);\n    let saved = desk.adapters.store.saved().expect(\"saved\");\n    assert_eq!(saved.active_tenant, before.active.map(|a| a.tenant));\n    assert!(\n        saved.tenant_draft.is_some(),\n        \"the draft itself is still there\"\n    );\n}\n\n#[tokio::test]\nasync fn a_tenant_created_outside_the_wizard_ends_a_first_run_draft_and_the_shell_takes_over() {\n    // The v1 import during first run commits tenants through the same path.\n    let mut desk = Desk::new();\n    desk.send(json!({\"kind\": \"setUiVariant\", \"variant\": \"v2\"}))\n        .await\n        .expect(\"v2\");\n    desk.send(json!({\"kind\": \"setOnboarding\", \"state\": \"inProgress\"}))\n        .await\n        .expect(\"in progress\");\n    let context = desk.begin(\"firstRun\", \"Drafted\").await;\n    desk.send(json!({\"kind\": \"configureScanCredential\", \"context\": context, \"mode\": \"keychain\", \"key\": KEY}))\n        .await\n        .expect(\"key\");\n    desk.settled(true).await;\n    let record = desk.adapters.vault.records()[0].clone();\n    desk.send(json!({\"kind\": \"createTenant\", \"profile\": {\n        \"label\": \"Imported\", \"tsgId\": \"2222222222\", \"destination\": {\"kind\": \"region\", \"region\": \"europe\"}}}))\n        .await\n        .expect(\"imported tenant\");\n    let snap = desk.snap();\n    assert!(snap.setup.is_none(), \"the first-run draft is over\");\n    assert_eq!(\n        snap.onboarding,\n        OnboardingState::Done,\n        \"a tenant exists: the shell takes over\"\n    );\n    assert_eq!(snap.tenants.len(), 1);\n    assert_eq!(snap.tenants[0].label, \"Imported\");\n    let saved = desk.adapters.store.saved().expect(\"saved\");\n    assert!(saved.tenant_draft.is_none());\n    assert!(\n        saved.credentials.is_empty(),\n        \"the draft's record left the ledger\"\n    );\n    let deleted = desk\n        .adapters\n        .vault\n        .calls()\n        .into_iter()\n        .any(|c| matches!(c, fixtures::VaultCall::Delete(r) if r == record));\n    assert!(\n        deleted || saved.pending_cleanup.contains(&record),\n        \"its Keychain record is cleaned up\"\n    );\n    let desk = desk.restart();\n    assert_eq!(\n        desk.snap().onboarding,\n        OnboardingState::Done,\n        \"and stays so after a relaunch\"\n    );\n}\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_53","type":"command_execution","command":"/bin/zsh -lc \"sed -n '1,245p' apps/desktop/src-tauri/src/adapters.rs; sed -n '1,300p' apps/desktop/src-tauri/src/keychain.rs\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_53","type":"command_execution","command":"/bin/zsh -lc \"sed -n '1,245p' apps/desktop/src-tauri/src/adapters.rs; sed -n '1,300p' apps/desktop/src-tauri/src/keychain.rs\"","aggregated_output":"//! Production OS adapters for the core: the Rust-owned data store, the\n//! Keychain credential store and the native profile-import sheet.\n//!\n//! The data root is the OS application-data directory for this build's\n//! bundle identifier (`io.cdot.prisma-airs-desktop.v2`, or `.fixture` in the\n//! fixture build), never a v1 directory. Fixture builds keep credentials in a\n//! dedicated test keychain inside that root under the fixture namespace, with\n//! OS prompts disabled so failures are deterministic; production uses the\n//! login Keychain. An adapter that cannot be opened is replaced by one that\n//! reports `Unavailable`; there is no fallback to plaintext or another store.\n\nuse std::io::Read;\nuse std::path::{Path, PathBuf};\nuse std::sync::Arc;\n\nuse desktop_core::avatar::MAX_SOURCE_BYTES;\nuse desktop_core::import::{ImportError, MAX_IMPORT_BYTES};\nuse desktop_core::store::{AppStore, FileStore, UnavailableStore};\nuse desktop_core::vault::UnavailableVault;\nuse desktop_core::{\n    Adapters, CredentialStore, FileSaver, FolderPicker, ImagePicker, ImportFile, ImportPicker,\n    PagePrinter, UrlOpener,\n};\nuse futures_util::future::BoxFuture;\nuse tauri::{AppHandle, Manager, Runtime};\nuse zeroize::Zeroizing;\n\nuse crate::MAIN_WINDOW;\n\n/// The fixture test keychain's file name inside the fixture data root.\npub const FIXTURE_KEYCHAIN: &str = \"fixture-credentials.keychain-db\";\n/// The fixture test keychain's password. It protects only synthetic fixture\n/// credentials in a keychain that exists solely for acceptance runs.\npub const FIXTURE_KEYCHAIN_PASSWORD: &str = \"prisma-airs-desktop-v2-fixture-keychain\";\n/// The staged fixture v1 keychain (C23) and its password: synthetic v1\n/// items only, created by the acceptance driver.\n#[cfg(feature = \"test-fixtures\")]\npub const FIXTURE_V1_KEYCHAIN: &str = \"fixture-v1.keychain-db\";\n#[cfg(feature = \"test-fixtures\")]\npub const FIXTURE_V1_KEYCHAIN_PASSWORD: &str = \"prisma-airs-desktop-v2-fixture-v1-keychain\";\n\n/// Builds the production adapters for the app's data root.\npub fn production<R: Runtime>(app: &AppHandle<R>) -> Adapters {\n    let root = app.path().app_data_dir().ok();\n    let store: Arc<dyn AppStore> = root\n        .as_deref()\n        .and_then(|dir| FileStore::open(dir).ok())\n        .map(|s| Arc::new(s) as Arc<dyn AppStore>)\n        .unwrap_or_else(|| Arc::new(UnavailableStore));\n    Adapters {\n        keychain: credential_store(root.as_deref()),\n        learner_keychain: learner_store(root.as_deref()),\n        store,\n        picker: Arc::new(NativePicker { app: app.clone() }),\n        opener: opener(root.as_deref()),\n        printer: printer(app, root.as_deref()),\n        images: images(app, root.as_deref()),\n        confirmer: confirmer(app),\n        secrets: secrets(app),\n        text_files: sheet_picker(\n            root.as_deref(),\n            text_files(app, root.as_deref()),\n            Arc::new(NativeTextPicker { app: app.clone() }),\n        ),\n        offline_root: root.as_ref().map(|r| r.join(\"academy-offline\")),\n        saver: sheet_saver(\n            root.as_deref(),\n            saver(app, root.as_deref()),\n            Arc::new(NativeSaver { app: app.clone() }),\n        ),\n        sessions_root: root.as_ref().map(|r| r.join(\"sessions\")),\n        case_files: sheet_picker(\n            root.as_deref(),\n            case_files(app, root.as_deref()),\n            Arc::new(NativeCasePicker { app: app.clone() }),\n        ),\n        library_root: root.as_ref().map(|r| r.join(\"library\")),\n        folders: folders(app, root.as_deref()),\n        workbench_files: sheet_picker(\n            root.as_deref(),\n            workbench_files(root.as_deref()),\n            Arc::new(NativeExportPicker { app: app.clone() }),\n        ),\n        workbench_root: root.as_ref().map(|r| r.join(\"api-client\")),\n        gateway_files: sheet_picker(\n            root.as_deref(),\n            gateway_files(app, root.as_deref()),\n            Arc::new(NativeUploadPicker { app: app.clone() }),\n        ),\n        harness: harness(app, root.as_deref()),\n        v1_source: v1_source(app),\n        import_root: root.as_ref().map(|r| r.join(\"imports\")),\n        logs_root: logs_root(app, root.as_deref()),\n    }\n}\n\n/// macOS's own logs folder for this app (D051), apart from the work in the\n/// data folder. Fixture builds keep it under their data root, which the\n/// acceptance drivers remove after each run.\n#[cfg(not(feature = \"test-fixtures\"))]\nfn logs_root<R: Runtime>(app: &AppHandle<R>, _: Option<&Path>) -> Option<PathBuf> {\n    app.path().app_log_dir().ok()\n}\n\n#[cfg(feature = \"test-fixtures\")]\nfn logs_root<R: Runtime>(_: &AppHandle<R>, root: Option<&Path>) -> Option<PathBuf> {\n    root.map(|r| r.join(\"fixture-logs\"))\n}\n\n/// v1's folder and Keychain service, read only (C23). Fixture builds read a\n/// staged copy under their data root and a staged file keychain, never a\n/// real v1 or the login Keychain.\n#[cfg(not(feature = \"test-fixtures\"))]\nfn v1_source<R: Runtime>(app: &AppHandle<R>) -> Option<desktop_core::import_v1::V1Source> {\n    let root = app.path().data_dir().ok()?.join(\"Prisma AIRS Desktop\");\n    let keychain = crate::keychain::V1KeychainSource::login().ok()?;\n    Some(desktop_core::import_v1::V1Source {\n        root,\n        keychain: Arc::new(keychain),\n    })\n}\n\n#[cfg(feature = \"test-fixtures\")]\nfn v1_source<R: Runtime>(app: &AppHandle<R>) -> Option<desktop_core::import_v1::V1Source> {\n    let data = app.path().app_data_dir().ok()?;\n    let keychain: Arc<dyn desktop_core::import_v1::V1Keychain> =\n        match crate::keychain::V1KeychainSource::file(\n            &data.join(FIXTURE_V1_KEYCHAIN),\n            FIXTURE_V1_KEYCHAIN_PASSWORD,\n            &data.join(\"fixture-v1-reads.log\"),\n        ) {\n            Ok(k) => Arc::new(k),\n            Err(_) => Arc::new(desktop_core::import_v1::source::UnavailableKeychain),\n        };\n    Some(desktop_core::import_v1::V1Source {\n        root: data.join(\"fixture-v1\"),\n        keychain,\n    })\n}\n\n/// The bundled Harness engine (`Contents/Resources/harness/airs-harness`),\n/// its OS launcher and where its ephemeral runtime homes are made. A build\n/// without the engine resource offers no Harness.\nfn harness<R: Runtime>(\n    app: &AppHandle<R>,\n    root: Option<&Path>,\n) -> desktop_core::harness::sidecar::HarnessAdapters {\n    use desktop_core::harness::{engine::Engine, sidecar::HarnessAdapters};\n    let engine = app\n        .path()\n        .resource_dir()\n        .ok()\n        .map(|r| {\n            r.join(\"harness\")\n                .join(desktop_core::harness::engine::pin().executable)\n        })\n        .and_then(|p| p.canonicalize().ok())\n        .filter(|p| p.is_file())\n        .map(|executable| Engine { executable });\n    #[cfg(target_os = \"macos\")]\n    let launcher: Arc<dyn desktop_core::harness::sidecar::SidecarLauncher> =\n        Arc::new(crate::sidecar::OsLauncher);\n    #[cfg(not(target_os = \"macos\"))]\n    let launcher: Arc<dyn desktop_core::harness::sidecar::SidecarLauncher> =\n        Arc::new(desktop_core::harness::sidecar::UnavailableLauncher);\n    HarnessAdapters {\n        launcher,\n        engine,\n        runtime_root: root.map(|r| r.join(\"harness-runtime\")),\n        history_root: root.map(|r| r.join(\"harness-history\")),\n        #[cfg(feature = \"test-fixtures\")]\n        fixture: None,\n        #[cfg(feature = \"test-fixtures\")]\n        save_gate: None,\n    }\n}\n\n/// The v1 API Client profile offered for adoption (read only). Fixture\n/// builds use a staged copy under their data root, never a real profile.\n#[cfg(not(feature = \"test-fixtures\"))]\npub fn adoption_source<R: Runtime>(app: &AppHandle<R>) -> Option<PathBuf> {\n    app.path()\n        .data_dir()\n        .ok()\n        .map(|d| d.join(\"Prisma AIRS Desktop\").join(\"api-client\"))\n}\n\n#[cfg(feature = \"test-fixtures\")]\npub fn adoption_source<R: Runtime>(app: &AppHandle<R>) -> Option<PathBuf> {\n    app.path()\n        .app_data_dir()\n        .ok()\n        .map(|d| d.join(\"fixture-v1-api-client\"))\n}\n\n/// A separate native sheet for the close guard (its own registry, so its\n/// nonce never meets a change review's).\n#[cfg(target_os = \"macos\")]\npub fn close_guard<R: Runtime>(app: &AppHandle<R>) -> Arc<dyn desktop_core::OperatorConfirmation> {\n    Arc::new(crate::native_confirmation::NativeConfirmation::new(\n        app.clone(),\n    ))\n}\n\n#[cfg(not(target_os = \"macos\"))]\npub fn close_guard<R: Runtime>(_app: &AppHandle<R>) -> Arc<dyn desktop_core::OperatorConfirmation> {\n    Arc::new(crate::native_confirmation::Unsupported)\n}\n\n/// Insomnia exports are bounded like v1 (1 MiB); one byte more is read so\n/// the core can report \"too large\".\npub const MAX_EXPORT_BYTES: usize = desktop_core::workbench::insomnia::EXPORT_BYTES + 1;\n\n/// The native folder sheets for API Client collections (C14).\nfn folders<R: Runtime>(app: &AppHandle<R>, root: Option<&Path>) -> Arc<dyn FolderPicker> {\n    let native = Arc::new(NativeFolders { app: app.clone() });\n    staged_folders(root, native)\n}\n\n#[cfg(not(feature = \"test-fixtures\"))]\nfn staged_folders(\n    _root: Option<&Path>,\n    native: Arc<NativeFolders<impl Runtime>>,\n) -> Arc<dyn FolderPicker> {\n    native\n}\n\n/// Where the fixture driver names the folder the open sheet answers.\n#[cfg(feature = \"test-fixtures\")]\npub const FIXTURE_OPEN_FOLDER: &str = \"fixture-open-folder\";\n/// Where the fixture driver names the folder the new-collection sheet\n/// answers.\n#[cfg(feature = \"test-fixtures\")]\npub const FIXTURE_NEW_FOLDER: &str = \"fixture-new-folder\";\n/// Where the fixture driver names the folder the Harness project sheet\n/// answers (C21).\n#[cfg(feature = \"test-fixtures\")]\npub const FIXTURE_PROJECT_FOLDER: &str = \"fixture-project-folder\";\n/// Where the fixture driver names the file the save-response sheet answers.\n#[cfg(feature = \"test-fixtures\")]\npub const FIXTURE_SAVE_RESPONSE: &str = \"fixture-save-response\";\n\n/// The fixture build answers the folder sheets with the paths the driver\n/// staged (none: cancelled), unless the native-sheet flag asks for the real\n/// NSOpenPanel / NSSavePanel.\n//! Classic macOS Keychain credential adapter (DESIGN \"Native Harness,\n//! identity and protected storage\").\n//!\n//! Generic-password items with service = this build's v2 namespace and\n//! account = the immutable credential record ID; local, non-synchronizing,\n//! default application ACL. Production uses the login Keychain and allows the\n//! OS authorization prompts; fixture builds use a dedicated test keychain and\n//! the fixture namespace. Every call is serialized (the user-interaction\n//! setting is process-global), and OS status codes map to sanitized\n//! [`VaultError`]s: a keychain that is locked reports `Locked`, an item the\n//! process may not read reports `Denied`. Purge deletes only items in this\n//! namespace; v1 and foreign items are never addressed.\n//!\n//! `SecKeychainItem::delete` in security-framework discards the OS status, and\n//! the keychain lock status is not bound, so this module calls those two\n//! Security functions directly.\n#![allow(unsafe_code)]\n\nuse std::path::Path;\nuse std::sync::Mutex;\n\nuse core_foundation::base::TCFType;\nuse desktop_core::CredentialStore;\nuse desktop_core::vault::{RecordId, Vault, VaultError};\nuse security_framework::item::{ItemClass, ItemSearchOptions, Limit, Reference, SearchResult};\nuse security_framework::os::macos::keychain::{CreateOptions, SecKeychain};\nuse security_framework::os::macos::keychain_item::SecKeychainItem;\nuse security_framework_sys::base::SecKeychainRef;\n\n/// Security status code (`OSStatus` in `<MacTypes.h>`).\ntype OSStatus = i32;\nuse zeroize::Zeroizing;\n\n/// The production v2 scan-credential namespace (independent of v1's\n/// `io.cdot.prisma-airs-desktop`).\npub const SCAN_SERVICE: &str = \"io.cdot.prisma-airs-desktop.v2.scan\";\n/// The fixture build's namespace, used only in its dedicated test keychain.\npub const FIXTURE_SCAN_SERVICE: &str = \"io.cdot.prisma-airs-desktop.v2.fixture.scan\";\n/// The Academy learner namespace (refresh token of the signed-in learner).\npub const ACADEMY_SERVICE: &str = \"io.cdot.prisma-airs-desktop.v2.academy\";\n/// The fixture build's Academy learner namespace.\npub const FIXTURE_ACADEMY_SERVICE: &str = \"io.cdot.prisma-airs-desktop.v2.fixture.academy\";\n\nconst ERR_SEC_ITEM_NOT_FOUND: OSStatus = -25300;\nconst ERR_SEC_INTERACTION_NOT_ALLOWED: OSStatus = -25308;\nconst ERR_SEC_AUTH_FAILED: OSStatus = -25293;\nconst ERR_SEC_USER_CANCELED: OSStatus = -128;\nconst ERR_SEC_NO_SUCH_KEYCHAIN: OSStatus = -25294;\nconst ERR_SEC_INVALID_KEYCHAIN: OSStatus = -25295;\nconst K_SEC_UNLOCK_STATE_STATUS: u32 = 1;\n\nunsafe extern \"C\" {\n    fn SecKeychainGetStatus(keychain: SecKeychainRef, status: *mut u32) -> OSStatus;\n    #[cfg(feature = \"test-fixtures\")]\n    fn SecKeychainLock(keychain: SecKeychainRef) -> OSStatus;\n    #[cfg(feature = \"test-fixtures\")]\n    fn SecKeychainUnlock(\n        keychain: SecKeychainRef,\n        length: u32,\n        password: *const std::ffi::c_void,\n        use_password: u8,\n    ) -> OSStatus;\n}\n\n/// Whether the OS may show its own authorization prompts.\n#[derive(Clone, Copy, Debug, PartialEq, Eq)]\npub enum Interaction {\n    Allowed,\n    Disallowed,\n}\n\nstatic KEYCHAIN_CALLS: Mutex<()> = Mutex::new(());\n\n/// A credential store over one keychain and namespace.\npub struct KeychainStore {\n    keychain: SecKeychain,\n    service: &'static str,\n    interaction: Interaction,\n}\n\n// SAFETY (Send/Sync): SecKeychainRef is a Core Foundation object whose\n// Security APIs are thread-safe; every call here is additionally serialized.\nunsafe impl Send for KeychainStore {}\nunsafe impl Sync for KeychainStore {}\n\nimpl KeychainStore {\n    /// The login Keychain with the production scan namespace.\n    pub fn login() -> Result<Self, VaultError> {\n        Self::login_service(SCAN_SERVICE)\n    }\n\n    /// The login Keychain with one of this build's production namespaces.\n    pub fn login_service(service: &'static str) -> Result<Self, VaultError> {\n        Ok(Self {\n            keychain: SecKeychain::default().map_err(|e| map(e.code(), None))?,\n            service,\n            interaction: Interaction::Allowed,\n        })\n    }\n\n    /// A dedicated file keychain (fixture builds and tests). Creates it with\n    /// `password` when absent and unlocks it.\n    pub fn file(\n        path: &Path,\n        password: &str,\n        service: &'static str,\n        interaction: Interaction,\n    ) -> Result<Self, VaultError> {\n        let mut keychain = if path.exists() {\n            SecKeychain::open(path).map_err(|e| map(e.code(), None))?\n        } else {\n            CreateOptions::new()\n                .password(password)\n                .prompt_user(false)\n                .create(path)\n                .map_err(|e| map(e.code(), None))?\n        };\n        keychain\n            .unlock(Some(password))\n            .map_err(|e| map(e.code(), None))?;\n        Ok(Self {\n            keychain,\n            service,\n            interaction,\n        })\n    }\n\n    pub fn service(&self) -> &'static str {\n        self.service\n    }\n\n    /// Whether the keychain currently reports itself locked.\n    pub fn is_locked(&self) -> bool {\n        let mut status = 0u32;\n        // SAFETY: the keychain reference is valid for `self`'s lifetime and\n        // `status` is a valid out-pointer.\n        let code =\n            unsafe { SecKeychainGetStatus(self.keychain.as_concrete_TypeRef(), &mut status) };\n        code == 0 && status & K_SEC_UNLOCK_STATE_STATUS == 0\n    }\n\n    /// Runs `f` serialized, with OS prompts disabled when configured. The\n    /// lock state is read after the prompt guard is released: with user\n    /// interaction disabled the status call itself fails.\n    fn call<T>(&self, f: impl FnOnce() -> Result<T, OSStatus>) -> Result<T, VaultError> {\n        let _serial = KEYCHAIN_CALLS.lock().map_err(|_| VaultError::Unavailable)?;\n        let result = {\n            let _guard = match self.interaction {\n                Interaction::Allowed => None,\n                Interaction::Disallowed => Some(\n                    SecKeychain::disable_user_interaction().map_err(|_| VaultError::Unavailable)?,\n                ),\n            };\n            f()\n        };\n        result.map_err(|code| map(code, Some(self.is_locked())))\n    }\n\n    fn find(&self, record: &RecordId) -> Result<(Zeroizing<Vec<u8>>, SecKeychainItem), OSStatus> {\n        self.keychain\n            .find_generic_password(self.service, record.as_str())\n            .map(|(password, item)| (Zeroizing::new(password.to_vec()), item))\n            .map_err(|e| e.code())\n    }\n}\n\n/// Fixture-only lock control for native acceptance: a running app does not\n/// observe a lock made by another process through `security lock-keychain`\n/// (observed on macOS 27), so the fixture menu locks and unlocks this\n/// process's own keychain reference instead.\n#[cfg(feature = \"test-fixtures\")]\nimpl KeychainStore {\n    pub fn lock_for_fixture(&self) -> bool {\n        let _serial = KEYCHAIN_CALLS.lock();\n        // SAFETY: the keychain reference is valid for `self`'s lifetime.\n        unsafe { SecKeychainLock(self.keychain.as_concrete_TypeRef()) == 0 }\n    }\n\n    pub fn unlock_for_fixture(&self, password: &str) -> bool {\n        let _serial = KEYCHAIN_CALLS.lock();\n        // SAFETY: the reference is valid and the password pointer/length\n        // describe a live UTF-8 buffer for the duration of the call.\n        unsafe {\n            SecKeychainUnlock(\n                self.keychain.as_concrete_TypeRef(),\n                password.len() as u32,\n                password.as_ptr().cast(),\n                1,\n            ) == 0\n        }\n    }\n}\n\n/// v1's Keychain service, read only (C23, D050). It can only find\n/// generic passwords in v1's service: there is no way to add, change or\n/// delete one of v1's items through it, and it never changes the keychain\n/// search list.\npub struct V1KeychainSource {\n    keychain: SecKeychain,\n    interaction: Interaction,\n    /// Fixture builds: the accounts read, one per line (no data).\n    #[cfg(feature = \"test-fixtures\")]\n    log: Option<std::path::PathBuf>,\n}\n\n// SAFETY (Send/Sync): as for `KeychainStore`; every call is serialized.\nunsafe impl Send for V1KeychainSource {}\nunsafe impl Sync for V1KeychainSource {}\n\nimpl V1KeychainSource {\n    /// The login Keychain. macOS asks the operator before an item of v1's is\n    /// read (the platform's grant for a protected read).\n    pub fn login() -> Result<Self, VaultError> {\n        Ok(Self {\n            keychain: SecKeychain::default().map_err(|e| map(e.code(), None))?,\n            interaction: Interaction::Allowed,\n            #[cfg(feature = \"test-fixtures\")]\n            log: None,\n        })\n    }\n\n    /// A staged fixture keychain (fixture builds): opened only if it exists,\n    /// never created, and never prompting.\n    #[cfg(feature = \"test-fixtures\")]\n    pub fn file(path: &Path, password: &str, log: &Path) -> Result<Self, VaultError> {\n        if !path.is_file() {\n            return Err(VaultError::Unavailable);\n        }\n        let mut keychain = SecKeychain::open(path).map_err(|e| map(e.code(), None))?;\n        keychain\n            .unlock(Some(password))\n            .map_err(|e| map(e.code(), None))?;\n        Ok(Self {\n            keychain,\n            interaction: Interaction::Disallowed,\n            log: Some(log.to_path_buf()),\n        })\n    }\n\n    fn is_locked(&self) -> bool {\n        let mut status = 0u32;\n        // SAFETY: as in `KeychainStore::is_locked`.\n        let code =\n            unsafe { SecKeychainGetStatus(self.keychain.as_concrete_TypeRef(), &mut status) };\n        code == 0 && status & K_SEC_UNLOCK_STATE_STATUS == 0\n    }\n}\n\nimpl desktop_core::import_v1::V1Keychain for V1KeychainSource {\n    fn read(&self, account: &str) -> Result<Option<Zeroizing<Vec<u8>>>, VaultError> {\n        #[cfg(feature = \"test-fixtures\")]\n        if let Some(log) = &self.log {\n            use std::io::Write;\n            if let Ok(mut f) = std::fs::OpenOptions::new()\n                .create(true)\n                .append(true)\n                .open(log)\n            {\n                let _ = writeln!(f, \"{account}\");\n            }\n        }\n        let _serial = KEYCHAIN_CALLS.lock().map_err(|_| VaultError::Unavailable)?;\n        let found = {\n            let _guard = match self.interaction {\n                Interaction::Allowed => None,\n                Interaction::Disallowed => Some(\n                    SecKeychain::disable_user_interaction().map_err(|_| VaultError::Unavailable)?,\n                ),\n            };\n            self.keychain\n                .find_generic_password(desktop_core::import_v1::V1_SERVICE, account)\n                .map(|(password, _)| Zeroizing::new(password.to_vec()))\n                .map_err(|e| e.code())\n        };\n        match found {\n            Ok(bytes) => Ok(Some(bytes)),\n            Err(ERR_SEC_ITEM_NOT_FOUND) => Ok(None),\n            Err(code) => Err(map(code, Some(self.is_locked()))),\n        }\n    }\n}\n\nfn delete_item(item: &SecKeychainItem) -> Result<(), OSStatus> {\n    // SAFETY: the item reference is valid while `item` is alive.\n    let code = unsafe {\n        security_framework_sys::keychain_item::SecKeychainItemDelete(item.as_concrete_TypeRef())\n    };\n    if code == 0 { Ok(()) } else { Err(code) }\n}\n\n/// Maps an OS status to a sanitized vault error. `locked` is the keychain's\n/// lock state when known: a locked keychain answers -25308 (prompting not\n/// allowed), -25293 (authentication failed, observed on macOS 27 for an\n/// already-open keychain locked externally) or -128 (unlock prompt\n/// cancelled); the same codes on an unlocked keychain mean the item's ACL\n/// denied this process.\nfn map(code: OSStatus, locked: Option<bool>) -> VaultError {\n    match code {\n        ERR_SEC_ITEM_NOT_FOUND => VaultError::NotFound,\n        ERR_SEC_INTERACTION_NOT_ALLOWED | ERR_SEC_AUTH_FAILED | ERR_SEC_USER_CANCELED\n","exit_code":0,"status":"completed"}}
