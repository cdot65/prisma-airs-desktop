{"type":"item.completed","item":{"id":"item_58","type":"command_execution","command":"/bin/zsh -lc \"sed -n '497,648p' crates/desktop-core/tests/ui_v2_setup_reads/main.rs; sed -n '245,325p' apps/desktop/src/v2/wizard/wizard.test.tsx; cat apps/desktop/src/features/academy/academy-account.tsx\"","aggregated_output":"#[tokio::test]\nasync fn a_draft_reads_beside_the_active_tenant_without_touching_its_gateway_choice() {\n    let mut desk = desk().await;\n    desk.tenant_a().await;\n    let a_before = desk.snap().gateway;\n    let a_reference = a_before\n        .selected\n        .as_ref()\n        .expect(\"A's choice\")\n        .reference\n        .clone();\n    assert_eq!(\n        a_before.selected.as_ref().map(|s| s.workspace.id.as_str()),\n        Some(WS_A)\n    );\n    let active_before = desk.snap().active.expect(\"active\");\n\n    // Draft B over the same synthetic plane (add mode, key optional).\n    let origin = desk.origin.clone();\n    desk.send(json!({\"kind\": \"beginTenantSetup\", \"mode\": \"add\", \"profile\": {\"label\": \"Tenant B\", \"tsgId\": TSG,\n        \"destination\": {\"kind\": \"custom\", \"origin\": origin}}}))\n        .await\n        .expect(\"draft\");\n    let first_context = desk.draft_context();\n    desk.send(json!({\"kind\": \"configureManagementCredential\", \"context\": first_context, \"mode\": \"keychain\",\n        \"clientId\": CLIENT_ID, \"secret\": CLIENT_SECRET}))\n        .await\n        .expect(\"draft client\");\n    // The credential change retired the draft's context: the old one is refused, the new one works.\n    let context = desk.draft_context();\n    assert_ne!(context, first_context, \"a fresh draft context\");\n    assert_eq!(\n        desk.send(json!({\"kind\": \"verifyTenantSetup\", \"context\": first_context}))\n            .await,\n        Err(Refusal::StaleContext)\n    );\n    assert!(eventually(|| desk.setup().tenant.management.state == ScanState::Ready).await);\n    desk.send(json!({\"kind\": \"chooseSetupProducts\", \"context\": context, \"products\": [\"gateway\"]}))\n        .await\n        .expect(\"products\");\n    // The draft lists through its own context and chooses WS_B; A keeps WS_A.\n    let list = desk.read(&context, json!({\"kind\": \"gateway\", \"workspace\": null, \"read\": {\"kind\": \"inventory\", \"resource\": \"workspaces\"}})).await;\n    assert!(\n        matches!(list, ManagementResult::Gateway { .. }),\n        \"draft listing delivered, not withdrawn: {list:?}\"\n    );\n    desk.send(json!({\"kind\": \"selectGatewayWorkspace\", \"context\": context, \"workspace\": WS_B}))\n        .await\n        .expect(\"draft chose\");\n    let setup = desk.setup();\n    let chosen = setup.workspace.expect(\"draft's workspace\");\n    assert_eq!(chosen.workspace.id, WS_B);\n    assert_ne!(chosen.reference, a_reference);\n    let a_during = desk.snap().gateway;\n    assert_eq!(\n        a_during.selected, a_before.selected,\n        \"A's choice untouched by the draft's listing and choice\"\n    );\n    assert_eq!(a_during.workspaces, a_before.workspaces);\n    assert_eq!(\n        desk.snap().active,\n        Some(active_before.clone()),\n        \"A's context untouched\"\n    );\n\n    // Replacing the draft's client retires its context and the choice under it;\n    // the next listing restores the draft's remembered workspace.\n    desk.send(\n        json!({\"kind\": \"configureManagementCredential\", \"context\": context, \"mode\": \"keychain\",\n        \"clientId\": CLIENT_ID, \"secret\": CLIENT_SECRET}),\n    )\n    .await\n    .expect(\"replaced client\");\n    let context = desk.draft_context();\n    assert!(\n        desk.setup().workspace.is_none(),\n        \"the choice went with the old context\"\n    );\n    assert!(eventually(|| desk.setup().tenant.management.state == ScanState::Ready).await);\n    let list = desk.read(&context, json!({\"kind\": \"gateway\", \"workspace\": null, \"read\": {\"kind\": \"inventory\", \"resource\": \"workspaces\"}})).await;\n    assert!(matches!(list, ManagementResult::Gateway { .. }));\n    let restored = desk\n        .setup()\n        .workspace\n        .expect(\"restored from the draft's remembered workspace\");\n    assert_eq!(restored.workspace.id, WS_B);\n    assert!(restored.restored);\n    assert_eq!(\n        desk.snap().gateway.selected,\n        a_before.selected,\n        \"A still untouched\"\n    );\n\n    // Verify: real reads settle the lines; AIS/AES are listed as unavailable.\n    desk.send(json!({\"kind\": \"verifyTenantSetup\", \"context\": context}))\n        .await\n        .expect(\"verify\");\n    let v = desk.verified().await;\n    let line = |l: VerifyLine| v.steps.iter().find(|s| s.line == l).cloned().expect(\"line\");\n    assert_eq!(\n        line(VerifyLine::ScanKey).state,\n        VerifyState::Warning,\n        \"no key in add mode\"\n    );\n    assert_eq!(line(VerifyLine::ManagementClient).state, VerifyState::Pass);\n    // WS_B's IAM scope lists another workspace: the prerequisites read is\n    // partial, and says so, instead of passing on the four inventories alone.\n    let gateway = line(VerifyLine::Gateway);\n    assert_eq!(gateway.state, VerifyState::Warning, \"{}\", gateway.reason);\n    assert!(\n        gateway\n            .reason\n            .contains(\"scope scope-team-b does not list the workspace\"),\n        \"{}\",\n        gateway.reason\n    );\n    assert_eq!(line(VerifyLine::Ais).state, VerifyState::Unavailable);\n    assert_eq!(line(VerifyLine::Aes).state, VerifyState::Unavailable);\n    assert!(line(VerifyLine::Ais).product.is_none());\n    assert!(v.done && !v.failed && !v.blocking && !v.stale);\n    assert_eq!(\n        v.warnings.len(),\n        2,\n        \"the missing key and the partial prerequisites\"\n    );\n    assert_eq!(v.warnings[1].product, ProductId::Gateway);\n    assert!(desk.setup().completable);\n\n    // Discard: A is exactly as it was.\n    desk.send(json!({\"kind\": \"discardTenantSetup\", \"context\": context}))\n        .await\n        .expect(\"discard\");\n    let snap = desk.snap();\n    assert!(snap.setup.is_none());\n    assert_eq!(snap.gateway.selected, a_before.selected);\n    assert_eq!(snap.active, Some(active_before));\n    assert_eq!(snap.tenants.len(), 1);\n    // A's chosen workspace still answers scoped reads under its reference.\n    let a_context = desk.active_context();\n    let prerequisites = desk\n        .read(\n            &a_context,\n            json!({\"kind\": \"gateway\", \"workspace\": a_reference, \"read\": {\"kind\": \"prerequisites\"}}),\n        )\n        .await;\n    assert!(\n        matches!(prerequisites, ManagementResult::Gateway { .. }),\n        \"{prerequisites:?}\"\n    );\n}\n\n#[tokio::test]\n        native.respond = () => ({ outcome: 'refusal', refusal: 'deniedStore' })\n        await user.keyboard('{Escape}')\n        expect(native.dispatched.at(-1)).toEqual({ kind: 'discardTenantSetup', context: DRAFT_CONTEXT })\n        expect(screen.getByRole('dialog', { name: 'Add a tenant' })).toBeInTheDocument()\n        expect(await within(sheet).findByText(/could not be discarded/)).toBeInTheDocument()\n        native.respond = () => admitted()\n        await user.click(within(sheet).getByRole('button', { name: 'Retry' }))\n        expect(native.dispatched.filter((i) => i.kind === 'discardTenantSetup')).toHaveLength(2)\n        expect(screen.queryByRole('dialog')).toBeNull()\n    })\n\n    it('does not let unsaved profile edits reach later steps or completion', async () => {\n        const user = userEvent.setup()\n        const verified = verifyView([{ line: 'scanKey', product: 'runtimeSecurity', state: 'warning', reason: 'No scan key.' }, { line: 'managementClient', product: 'runtimeSecurity', state: 'skipped', reason: 'No client.' }])\n        await launch({ ...fxSwitcher(), setup: setupView({ mode: 'add', scanRequired: false, tenant: draft({ label: 'Coastal Bank', tsgId: '2000000001' }), verify: verified }) })\n        await user.click(screen.getByRole('button', { name: /^Switch tenant/ }))\n        await user.click(screen.getByRole('button', { name: 'Add a tenant…' }))\n        const sheet = screen.getByRole('dialog', { name: 'Add a tenant' })\n        await user.clear(within(sheet).getByLabelText(/TSG ID/))\n        expect(within(sheet).getByRole('button', { name: 'Save or revert the changes to continue' })).toBeDisabled()\n        expect(within(within(sheet).getByRole('navigation', { name: 'Setup steps' })).getByRole('button', { name: /Done$/ })).toBeDisabled()\n        await user.click(within(sheet).getByRole('button', { name: 'Revert changes' }))\n        expect(within(sheet).getByLabelText(/TSG ID/)).toHaveValue('2000000001')\n        expect(within(sheet).getByRole('button', { name: 'Continue' })).toBeEnabled()\n    })\n\n    it('waits for a pending creation on Cancel and discards what it produced before closing', async () => {\n        const user = userEvent.setup()\n        const native = await launch(fxSwitcher())\n        await user.click(screen.getByRole('button', { name: /^Switch tenant/ }))\n        await user.click(screen.getByRole('button', { name: 'Add a tenant…' }))\n        const sheet = screen.getByRole('dialog', { name: 'Add a tenant' })\n        await user.type(within(sheet).getByLabelText(/Display name/), 'Coastal Bank')\n        await user.type(within(sheet).getByLabelText(/TSG ID/), '2000000001')\n        let answer: (value: unknown) => void = () => undefined\n        native.respond = () => new Promise((resolve) => (answer = resolve))\n        await user.click(within(sheet).getByRole('button', { name: 'Create tenant' }))\n        await user.click(within(sheet).getByRole('button', { name: 'Cancel' }))\n        // Nothing closes and nothing is discarded while the creation is undecided.\n        expect(screen.getByRole('dialog', { name: 'Add a tenant' })).toBeInTheDocument()\n        expect(native.dispatched.filter((i) => i.kind === 'discardTenantSetup')).toHaveLength(0)\n        native.respond = () => admitted()\n        // The receipt settles first, on its own render: the draft is coming, so the\n        // sheet must neither close nor discard yet.\n        answer(admitted())\n        await waitFor(() => expect(within(sheet).getByRole('button', { name: 'Discarding…' })).toBeDisabled())\n        await new Promise((r) => setTimeout(r, 30))\n        expect(screen.getByRole('dialog', { name: 'Add a tenant' })).toBeInTheDocument()\n        expect(native.dispatched.filter((i) => i.kind === 'discardTenantSetup')).toHaveLength(0)\n        await native.push({ ...native.current, setup: setupView({ mode: 'add', scanRequired: false, tenant: draft({ label: 'Coastal Bank', tsgId: '2000000001', environment: 'production', destination: { kind: 'region', region: 'unitedStates' } }) }) })\n        await waitFor(() => expect(native.dispatched.filter((i) => i.kind === 'discardTenantSetup')).toHaveLength(1))\n        expect(native.dispatched.at(-1)).toEqual({ kind: 'discardTenantSetup', context: DRAFT_CONTEXT })\n        await waitFor(() => expect(screen.queryByRole('dialog')).toBeNull())\n    })\n\n    it('discards the draft once when its snapshot arrives before the creation receipt', async () => {\n        const user = userEvent.setup()\n        const native = await launch(fxSwitcher())\n        await user.click(screen.getByRole('button', { name: /^Switch tenant/ }))\n        await user.click(screen.getByRole('button', { name: 'Add a tenant…' }))\n        const sheet = screen.getByRole('dialog', { name: 'Add a tenant' })\n        await user.type(within(sheet).getByLabelText(/Display name/), 'Coastal Bank')\n        await user.type(within(sheet).getByLabelText(/TSG ID/), '2000000001')\n        let answer: (value: unknown) => void = () => undefined\n        native.respond = () => new Promise((resolve) => (answer = resolve))\n        await user.click(within(sheet).getByRole('button', { name: 'Create tenant' }))\n        await user.click(within(sheet).getByRole('button', { name: 'Cancel' }))\n        // The draft shows up first; the receipt is still outstanding.\n        await native.push({ ...native.current, setup: setupView({ mode: 'add', scanRequired: false, tenant: draft({ label: 'Coastal Bank', tsgId: '2000000001', environment: 'production', destination: { kind: 'region', region: 'unitedStates' } }) }) })\n        expect(native.dispatched.filter((i) => i.kind === 'discardTenantSetup')).toHaveLength(0)\n        native.respond = () => admitted()\n        answer(admitted())\n        await waitFor(() => expect(native.dispatched.filter((i) => i.kind === 'discardTenantSetup')).toHaveLength(1))\n        await waitFor(() => expect(screen.queryByRole('dialog')).toBeNull())\n    })\n\n    it('an unconfirmed discard with the draft still present offers Retry, which discards and closes', async () => {\n        const user = userEvent.setup()\n        const native = await launch({ ...fxSwitcher(), setup: setupView({ mode: 'add', scanRequired: false, tenant: draft({ label: 'Coastal Bank', tsgId: '2000000001' }) }) })\n        await user.click(screen.getByRole('button', { name: /^Switch tenant/ }))\n        await user.click(screen.getByRole('button', { name: 'Add a tenant…' }))\nimport { useId, useState } from 'react'\nimport { Button, Callout } from '@ai-security-academy/presentation'\nimport { AlertTriangle, CheckCircle2, Info } from 'lucide-react'\nimport type { AcademyFailure, AcademyView, Intent, VaultError } from '@prisma-airs/desktop-contracts'\nimport { type Dispatch, outcomeMessage } from '../tenants/dispatch'\n\nconst FAILURE_TEXT: Record<AcademyFailure, string> = {\n    notConfigured: 'Academy desktop sign-in is not available on this server.',\n    invalidConfig: 'Academy returned a sign-in configuration the desktop cannot trust.',\n    network: 'Academy could not be reached. Check your connection and try again.',\n    invalidResponse: 'Academy returned an unexpected sign-in response. Try again.',\n    denied: 'Sign-in was declined in the browser.',\n    expired: 'The sign-in code expired before it was approved. Start again.',\n    sessionExpired: 'Your Academy session expired. Sign in again.',\n    scopeMissing: 'Academy did not grant learning access to this sign-in.',\n    accountChanged: 'Academy changed its sign-in configuration. Sign in again.',\n    authFailed: 'Academy sign-in could not complete. Try again.',\n}\n\nconst VAULT_TEXT: Record<VaultError, string> = {\n    locked: 'The Keychain is locked, so the session could not be saved. Unlock it and sign in again.',\n    denied: 'macOS did not allow the Academy session to be saved in the Keychain.',\n    unavailable: 'The Keychain is not available, so the session could not be saved.',\n    notFound: 'The saved Academy session is missing from the Keychain.',\n    corrupt: 'The saved Academy session could not be read.',\n}\n\ninterface Props {\n    view: AcademyView\n    dispatch: Dispatch\n}\n\n/**\n * The Academy learner account, independent of AIRS tenants. Sign-in is a\n * browser device flow: the desktop shows a code, opens the Academy page the\n * issuer named, and never sees a password. Tokens stay in the native core.\n */\nexport function AcademyAccount({ view, dispatch }: Props) {\n    const legend = useId()\n    const [busy, setBusy] = useState(false)\n    const [message, setMessage] = useState<string | null>(null)\n\n    async function send(intent: Intent) {\n        setBusy(true)\n        setMessage(null)\n        const outcome = await dispatch(intent)\n        setBusy(false)\n        setMessage(outcomeMessage(outcome))\n    }\n\n    return (\n        <fieldset\n            aria-labelledby={legend}\n            aria-busy={busy}\n            data-slot='academy-account'\n            className='border-academy-rule flex flex-col gap-3 rounded-[12px] border p-5'\n        >\n            <legend id={legend} className='text-academy-ink px-1 text-[15px] font-semibold'>\n                Academy account\n            </legend>\n            <p className='text-academy-ink-soft text-[13px]'>\n                Your Academy learner account is separate from AIRS tenants; switching tenants does not change it.\n            </p>\n            <div role='status' aria-live='polite' className='flex flex-col gap-3'>\n                <State view={view} busy={busy} send={send} />\n            </div>\n            {message ? (\n                <p role='alert' data-slot='academy-message' className='text-academy-accent-warn text-[13px]'>\n                    {message}\n                </p>\n            ) : null}\n        </fieldset>\n    )\n}\n\nfunction State({ view, busy, send }: { view: AcademyView; busy: boolean; send: (intent: Intent) => Promise<void> }) {\n    switch (view.state) {\n        case 'signedOut':\n            return (\n                <div className='flex flex-col items-start gap-3'>\n                    <p className='text-academy-ink text-[13px]'>Not signed in to Academy.</p>\n                    <Button type='button' tier='primary' disabled={busy} onClick={() => void send({ kind: 'startAcademySignIn' })}>\n                        Sign in to Academy\n                    </Button>\n                </div>\n            )\n        case 'starting':\n        case 'completing':\n            return (\n                <div className='flex flex-col items-start gap-3'>\n                    <p className='text-academy-ink text-[13px]'>\n                        {view.state === 'starting' ? 'Contacting Academy…' : 'Approved. Finishing sign-in…'}\n                    </p>\n                    <Button type='button' tier='secondary' onClick={() => void send({ kind: 'cancelAcademySignIn' })}>\n                        Cancel sign-in\n                    </Button>\n                </div>\n            )\n        case 'awaitingApproval':\n            return (\n                <div className='flex flex-col items-start gap-3' data-slot='academy-code'>\n                    <p className='text-academy-ink text-[13px]'>Enter this code on the Academy sign-in page:</p>\n                    <p\n                        className='font-mono text-academy-ink text-[24px] font-semibold tracking-[0.12em] select-all'\n                        aria-label={`Sign-in code ${view.userCode.split('').join(' ')}`}\n                    >\n                        {view.userCode}\n                    </p>\n                    <p className='text-academy-ink-faint text-[12px] break-all'>\n                        {view.verificationUri} · expires in {Math.max(1, Math.ceil(view.expiresIn / 60))} min\n                    </p>\n                    <div className='flex flex-wrap gap-2'>\n                        <Button type='button' tier='primary' onClick={() => void send({ kind: 'openAcademyVerification' })}>\n                            Open sign-in page\n                        </Button>\n                        <Button type='button' tier='secondary' onClick={() => void send({ kind: 'cancelAcademySignIn' })}>\n                            Cancel sign-in\n                        </Button>\n                    </div>\n                </div>\n            )\n        case 'signedIn':\n            return (\n                <div className='flex flex-col items-start gap-3'>\n                    <Callout tone='success' icon={CheckCircle2}>\n                        <p>\n                            Signed in to Academy as <span className='font-semibold'>{view.displayName}</span>.\n                        </p>\n                    </Callout>\n                    <Button type='button' tier='secondary' disabled={busy} onClick={() => void send({ kind: 'signOutAcademy' })}>\n                        Sign out of Academy\n                    </Button>\n                </div>\n            )\n        case 'failed':\n            return (\n                <div className='flex flex-col items-start gap-3'>\n                    <Callout tone='warning' icon={view.failure === 'network' ? Info : AlertTriangle} data-slot='academy-failure'>\n                        {view.displayName ? <p className='font-semibold'>{view.displayName}</p> : null}\n                        <p>{view.vault ? VAULT_TEXT[view.vault] : FAILURE_TEXT[view.failure]}</p>\n                    </Callout>\n                    <div className='flex flex-wrap gap-2'>\n                        <Button type='button' tier='primary' disabled={busy} onClick={() => void send({ kind: 'startAcademySignIn' })}>\n                            Sign in again\n                        </Button>\n                        <Button type='button' tier='secondary' disabled={busy} onClick={() => void send({ kind: 'signOutAcademy' })}>\n                            Sign out of Academy\n                        </Button>\n                    </div>\n                </div>\n            )\n    }\n}\n","exit_code":0,"status":"completed"}}
