ca8168a\",\n  \"executable_sha256\": \"8fb5a476b2a25adf2842286faa69e5393f5812ac3d7b65f87564eb0f05b54dca\",\n  \"source_inputs_sha256\": \"217a81f9ed49219bae0fa7946b9684ca6d2469b3c7f607d91b0c48816f09284c\",\n  \"client_id\": \"prisma-airs-cli@1852583913.iam.panserviceaccount.com\",\n  \"tsg_id\": \"1852583913\",\n  \"operation\": \"one management credential verification through the first-run wizard (C29): one latest security-profile probe with limit=1; discard profile contents; no other inventory browsing or writes\",\n  \"wizard_verify_intents\": 1,\n  \"read_budget_reserved\": 1,\n  \"http_requests_observed\": false,\n  \"automatic_retries\": 0,\n  \"products\": [\n    \"runtimeSecurity\"\n  ],\n  \"evidence\": [\n    \"docs/planning/evidence/C29/live/L19/attempt-03/wizard-verify.json\"\n  ],\n  \"local_credentials_removed\": true,\n  \"limitations\": [\n    \"Request bound comes from the inspected production verifier (limit=1, latest=true, SDK retries=0) and exactly one wizard intent; no TLS interception or response body capture.\"\n  ],\n  \"cumulative_read_budget_reserved\": 1,\n  \"verification\": \"management client passed\",\n  \"local_record_count\": 2,\n  \"events\": [\n    {\n      \"t\": \"07:38:23\",\n      \"step\": \"typed\",\n      \"field\": \"Display name\",\n      \"attempts\": 1\n    },\n    {\n      \"t\": \"07:38:25\",\n      \"step\": \"typed\",\n      \"field\": \"TSG ID\",\n      \"attempts\": 1\n    },\n    {\n      \"t\": \"07:38:30\",\n      \"step\": \"typed\",\n      \"field\": \"Client ID\",\n      \"attempts\": 1\n    }\n  ]\n}\n","exit_code":0,"status":"completed"}}
