t!(!read.needs_review());\n799:        assert!(delete.needs_review());\n809:                Err(SendRefusal::UnknownEndpoint),\n823:                Err(SendRefusal::UnknownEndpoint),\n914:            Err(SendRefusal::UnknownManagedReference {\n926:        assert!(scan.needs_review());\n940:        let unmanaged = |method: &str, url: &str, headers: &str, settings: &str| {\n964:        // mutation needs review under its own class.\n979:            let a = unmanaged(\n987:            assert!(a.needs_review(), \"{headers} {settings}\");\n991:            unmanaged(\n998:            .needs_review()\n1000:        let read = unmanaged(\"GET\", \"{{scm_base}}/iam/v1/access_policies\", \"\", \"\").expect(\"read\");\n1001:        assert!(read.operation.is_some() && !read.needs_review());\n1008:                unmanaged(method, url, \"Authorization: Bearer manual\", \"\"),\n1009:                Err(SendRefusal::UnknownEndpoint),\n1014:        let other = unmanaged(\n1021:        assert!(other.operation.is_none() && !other.needs_review());\n1040:                \"registered, unmanaged: {headers}\"\n1055:                \"registered, unmanaged: {url}\"\n1098:        // A generated Host header is refused for a managed request too.\n                Some(url::Host::Domain(name)) => name == \"localhost\",\n                None => false,\n            },\n        }\n    }\n}\n\n/// The credential class a request was admitted under.\n#[derive(Clone, Copy, Debug, PartialEq, Eq, Serialize, serde::Deserialize, TS)]\n#[serde(rename_all = \"camelCase\")]\npub enum CredentialClass {\n    Anonymous,\n    Workbench,\n    Managed,\n}\n\n/// Why a Send was refused (nothing was sent).\n#[derive(Clone, Debug, PartialEq, Eq, Serialize, TS)]\n#[serde(tag = \"kind\", rename_all = \"camelCase\")]\npub enum SendRefusal {\n    Render {\n        problem: RenderProblem,\n    },\n    /// Not an absolute http(s) URL, or a secret in its origin.\n    Url,\n    /// This build does not send to that destination.\n    Network,\n    /// Workbench secrets and tenant credentials in one request.\n    MixedCredentials,\n    /// A `tenant.*` reference that names no native tenant credential.\n    UnknownManagedReference {\n        reference: String,\n    },\n    /// A tenant credential somewhere it may not go.\n    ManagedPlacement,\n    /// Operator headers that would override or obscure a tenant\n    /// credential or the method.\n    AmbiguousCredential,\n    /// No active tenant with the credential this request needs.\n    NoTenant,\n    /// The token URL is not the tenant credential's token destination.\n    TokenDestination,\n    /// The request URL is not where the tenant credential may go.\n    RequestDestination,\n    /// Tenant credentials go only over HTTPS.\n    NotHttps,\n    /// A tenant-credential request that is no known catalogue operation.\n    UnknownEndpoint,\n    /// A secret has no usable value on this Mac.\n    Secret {\n        reference: String,\n        failure: SecretFailure,\n    },\n    Body {\n        problem: BodyProblem,\n    },\n    /// Four requests are already running.\n    Busy,\n    /// The document changed since the snapshot was taken.\n    Stale,\n    /// Review outcomes for tenant-credential changes.\n    ReviewMissing,\n    ReviewStale,\n    ReviewExpired,\n    ReviewConsumed,\n    Declined,\n    /// The private API Client store is unavailable (nothing recorded).\n    Private,\n}\n\n#[derive(Clone, Copy, Debug, PartialEq, Eq, Serialize, TS)]\n#[serde(rename_all = \"camelCase\")]\npub enum SecretFailure {\n    Missing,\n    Locked,\n    Denied,\n    /// Empty, surrounding whitespace or a line break (v1).\n    Invalid,\n}\n\n#[derive(Clone, Copy, Debug, PartialEq, Eq, Serialize, TS)]\n#[serde(rename_all = \"camelCase\")]\npub enum BodyProblem {\n    /// A file is missing, outside the collection or not a regular file.\n    Missing,\n    /// Over 64 MiB per file or 128 MiB in all.\n    TooLarge,\n    /// A stored-file body has unsaved edits (Save first).\n    Unsaved,\n}\n\n/// Where the active tenant's credentials may go (built natively from the\n/// configured endpoints and the tenant's stored capabilities).\n#[derive(Clone, Debug, Default, PartialEq, Eq)]\npub struct Destinations {\n    /// Exact token URLs the management client secret may be sent to.\n    pub token_urls: Vec<String>,\n    /// The token origin (the catalogue's auth host operations).\n    pub token_origin: Option<String>,\n    /// API origins management bearer tokens may be sent to.\n    pub api_origins: BTreeSet<String>,\n    /// The tenant's scan origin (the scan key's destination).\n    pub scan_origin: Option<String>,\n    /// The management capability is ready.\n    pub management: bool,\n    pub tsg: Option<String>,\n        return Err(SendRefusal::UnknownManagedReference {\n            reference: unknown.clone(),\n        });\n    }\n    if references.contains(TSG_ID) {\n        // Filled before admission when a tenant is active.\n        return Err(SendRefusal::NoTenant);\n    }\n    let managed: BTreeSet<&str> = references\n        .iter()\n        .map(String::as_str)\n        .filter(|r| r.starts_with(scm::MANAGED_PREFIX))\n        .collect();\n    let workbench = references.len() > managed.len();\n    if !managed.is_empty() && workbench {\n        return Err(SendRefusal::MixedCredentials);\n    }\n    let url = parse_url(&plan.url)?;\n    if !network.admits(&url) {\n        return Err(SendRefusal::Network);\n    }\n    if managed.is_empty() {\n        // A registered Prisma origin is classified whatever the credential\n        // (a literal header, a collection secret or none).\n        let operation = match destinations.registered.classes(&url) {\n            Some(classes) => {\n                if ambiguous_at_registered(plan, &url) {\n                    return Err(SendRefusal::AmbiguousCredential);\n                }\n                Some(registered_operation(plan, &url, classes)?)\n            }\n            None => None,\n        };\n        return Ok(Admitted {\n            class: if workbench {\n                CredentialClass::Workbench\n            } else {\n                CredentialClass::Anonymous\n            },\n            url,\n            operation,\n        });\n    }\n    // ---- a tenant credential: placement, destinations, operation ----\n    let oauth = matches!(&plan.auth, Auth::OAuth2 { secret, client_id, .. }\n        if secret == CLIENT_SECRET && client_id.secrets().all(|r| r == CLIENT_ID));\n    let key_header = plan\n        .headers\n        .iter()\n        .filter(|(n, v)| n.eq_ignore_ascii_case(\"x-pan-token\") && only(v, API_KEY))\n        .count();\n    let key_auth = matches!(&plan.auth, Auth::ApiKey { name, query: false, secret }\n        if name.eq_ignore_ascii_case(\"x-pan-token\") && secret == API_KEY);\n    let scan = key_header + usize::from(key_auth) == 1;\n    // Every slot holding a tenant credential must be one of those places.\n    let mut placed = BTreeSet::new();\n    if oauth {\n        placed.insert(CLIENT_SECRET);\n        if let Auth::OAuth2 { client_id, .. } = &plan.auth\n            && client_id.secrets().next().is_some()\n        {\ncrates/desktop-core/Cargo.toml:27:scm-sdk = { version = \"=0.2.4\", default-features = false, features = [\"scan\", \"management\", \"red-team\", \"model-security\", \"agentguard\", \"gateway\"] }\nCargo.lock:798: \"scm-sdk\",\nCargo.lock:3344:name = \"scm-sdk\"\n            }\n            state.changed();\n            // The same account keeps its open (or, before `start`, its\n            // pending) offline work; only a new generation is opened here.\n            let fresh = state\n                .offline\n                .clone()\n                .filter(|o| !previous.as_ref().is_some_and(|p| Arc::ptr_eq(p, o)));\n            (starts, fresh)\n        };\n        let (starts, offline) = starts;\n        let mut effects = vec![Effect::Start(starts)];\n        effects.extend(offline.map(Effect::OpenOffline));\n        run_effects(&self.inner, effects);\n        Ok(())\n    }\n}\n\nfn data_from(doc: PersistedState) -> Data {\n    // A setup that was in progress is not restored: its credentials are\n    // cleaned up (C29).\n    let draft_records: Vec<RecordId> = doc\n        .tenant_draft\n        .as_ref()\n        .map(|d| {\n            doc.credentials\n                .iter()\n                .filter(|c| c.tenant == d.profile.id)\n                .map(|c| c.record.clone())\n                .collect()\n        })\n        .unwrap_or_default();\n    let tenants = doc\n        .tenants\n        .into_iter()\n        .map(|profile| {\n            let scan = doc\n                .credentials\n                .iter()\n                .find(|c| {\n                    c.class == CredentialClass::Scan\n                        && c.tenant == profile.id\n                        && c.destination == profile.destination.origin()\n                })\n                .map(|c| ScanCapability::Ready {\n                    record: c.record.clone(),\n                tenant.rotations = tr.rotations.clone();\n            }\n            tenant\n        })\n        .collect();\n    Data {\n        appearance: Some(doc.appearance),\n        onboarding: Some(doc.onboarding),\n        show_calls: doc.show_calls_chosen.then_some(doc.show_calls),\n        tenants,\n        active: doc.active_tenant,\n        setup: None,\n        pending_cleanup: {\n            let mut pending = doc.pending_cleanup;\n            for record in draft_records {\n                if !pending.contains(&record) {\n                    pending.push(record);\n                }\n            }\n            pending\n        },\n        learner: doc.learner,\n        learner_cleanup: doc.learner_cleanup,\n        harness_history: doc.harness_history,\n        open_imports: doc.open_imports,\n    }\n}\n\nfn lock(inner: &Inner) -> Result<MutexGuard<'_, State>, Refusal> {\n    // A poisoned lock means an authoritative transition panicked; refuse\n    // further work instead of continuing from a possibly torn state.\n    inner.state.lock().map_err(|_| Refusal::ShuttingDown)\n}\n\n/// Principal-scoped entry to native desktop operations and observations.\n#[derive(Clone)]\npub struct AuthorityHandle {\n    principal: Principal,\n    inner: Arc<Inner>,\n}\n\n    record: RecordId,\n    mode: StorageMode,\n    result: Result<(), VaultError>,\n) {\n    let Ok(mut state) = lock(inner) else {\n        return;\n    };\n    state.writes_in_flight.retain(|r| r != &record);\n    let current = state.tenant(tenant).is_some_and(\n        |t| matches!(t.capability(class), ScanCapability::Storing { lease: l, .. } if *l == lease),\n    );\n    if !current {\n        // Stale: replaced, signed out, retargeted, deleted or reset while the\n        // write ran. A successful stale write is persisted work: it stays in\n        // (or joins) the cleanup ledger and is never attached anywhere.\n        if result.is_ok() {\n            match mode {\n                StorageMode::Keychain => {\n                    if !state.data.pending_cleanup.contains(&record) {\n                        state.data.pending_cleanup.push(record);\n                    }\n                }\n                StorageMode::Session => {\n                    let _ = inner.session.delete(&record);\n                }\n            }\n        }\n        drop(state);\n        drain_cleanup(inner);\n        return;\n    }\n    let before = state.data.clone();\n    let destination = match class {\n        CredentialClass::Scan => state\n            .tenant(tenant)\n            .map(|t| t.profile.destination.origin().to_owned())\n            .unwrap_or_default(),\n        CredentialClass::Management => state\n            .management_endpoints\n            .token_origin()\n            .unwrap_or_default(),\n        CredentialClass::Inference => state\n            .tenant(tenant)\n            .and_then(|t| t.inference_target.as_ref())\n            .map(|t| t.endpoint.clone())\n            .unwrap_or_default(),\n    };\n    let next = match result {\n        Ok(()) => {\n            if mode == StorageMode::Keychain {\n                state.data.pending_cleanup.retain(|r| r != &record);\n            }\n            ScanCapability::Ready {\n                record: record.clone(),\n                mode,\n                destination,\n            }\n        }\n        Err(failure) => ScanCapability::Failed { mode, failure },\n    };\n    if let Some(t) = state.tenant_mut(tenant) {\n        *t.capability_mut(class) = next;\n    }\n    if mode == StorageMode::Keychain && state.save_with(&before).is_err() {\n        // The record could not be committed: it stays in the ledger and the\n        // capability fails explicitly instead of becoming usable unsaved.\n        if let Some(t) = state.tenant_mut(tenant) {\n            *t.capability_mut(class) = ScanCapability::Failed {\n                mode,\n                failure: VaultError::Unavailable,\n            };\n        }\n        if !state.data.pending_cleanup.contains(&record) {\n            state.data.pending_cleanup.push(record);\n        }\n    }\n    state.changed();\n    drop(state);\n    drain_cleanup(inner);\n}\n\n/// Deletes ledgered Keychain records off the lock; removes each settled one\n/// (deleted or already absent) from the durable ledger.\nfn drain_cleanup(inner: &Arc<Inner>) {\n    let records = {\n        let Ok(mut state) = lock(inner) else {\n            return;\n        };\n        let in_flight = state.writes_in_flight.clone();\n        let records: Vec<RecordId> = state\n            .data\n","exit_code":0,"status":"completed"}}
