c/v2/harness/harness.test.tsx', 'apps/desktop/src/v2/harness/harness.tsx', 'apps/desktop/src/v2/harness/panels/history.tsx', 'apps/desktop/src/v2/harness/panels/mcp.tsx', 'apps/desktop/src/v2/harness/panels/project.tsx', 'apps/desktop/src/v2/harness/panels/sign-in.tsx', 'apps/desktop/src/v2/harness/text.ts', 'apps/desktop/src/v2/inbox/inbox.test.tsx', 'apps/desktop/src/v2/store.ts', 'apps/desktop/src/v2/switch-guard.tsx', 'apps/desktop/src/v2/v2-shell.tsx', 'apps/desktop/src/v2/wizard/wizard.test.tsx', 'apps/desktop/src/v2/wizard/wizard.tsx', 'crates/desktop-core/src/authority.rs', 'crates/desktop-core/src/authority/inbox_domain.rs', 'crates/desktop-core/src/authority/setup_domain.rs', 'crates/desktop-core/tests/harness_tools/main.rs', 'crates/desktop-core/tests/imports_rollback/held.rs', 'crates/desktop-core/tests/imports_rollback/main.rs', 'crates/desktop-core/tests/imports_rollback/recovery.rs', 'packages/desktop-contracts/src/client.ts', 'packages/desktop-contracts/src/generated/SwitchBlocked.ts', 'packages/desktop-contracts/src/generated/SwitchResolution.ts', 'tools/native-acceptance/acceptance_c04.py', 'tools/native-acceptance/acceptance_c05.py', 'tools/native-acceptance/acceptance_c06.py', 'tools/native-acceptance/acceptance_c07.py', 'tools/native-acceptance/acceptance_c11.py', 'tools/native-acceptance/acceptance_c24.py', 'tools/native-acceptance/acceptance_c37.py', 'tools/native-acceptance/acceptance_c38.py', 'tools/native-acceptance/acceptance_c43.py', 'tools/native-acceptance/ax.swift', 'tools/native-acceptance/fixture_app.py', 'tools/native-acceptance/legacy_assertions.py']\nmissing []\nC28 verdict binding True True True {'architecture': 9, 'behavior': 9, 'authority_security': 9, 'validation': 9, 'overall': 9} [] [] []\nC27 verdict binding True True True {'architecture': 9, 'behavior': 9, 'authority_security': 9, 'validation': 9, 'overall': 9} [] [] []\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_72","type":"command_execution","command":"/bin/zsh -lc \"cat docs/planning/evidence/C29/live-scope-request.md docs/planning/evidence/C29/live/L19/additional-grant-01.json docs/planning/evidence/C29/live/L19/credential-correction.json; sed -n '140,200p' docs/planning/decisions.md; cat apps/desktop/src/v2/wizard/wizard-boards.test.tsx\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_72","type":"command_execution","command":"/bin/zsh -lc \"cat docs/planning/evidence/C29/live-scope-request.md docs/planning/evidence/C29/live/L19/additional-grant-01.json docs/planning/evidence/C29/live/L19/credential-correction.json; sed -n '140,200p' docs/planning/decisions.md; cat apps/desktop/src/v2/wizard/wizard-boards.test.tsx\"","aggregated_output":"# C29 live row: what the owner must designate\n\nC29's required acceptance includes one live read: \"verify against the\ndesignated read-only tenant (Vulture) under the owner scope, recorded as a\nredacted receipt; no writes\" (`chunks/C29.md`). The approved execution\nmanifest (`~/airs-v2-live.json`, `airs-v2/live-manifest/1`, approved\n2026-10-25) designates Vulture (TSG 1852583913, environment test-b) for the\nL18 scan family only. No family permits a management read on Vulture, so the\nwizard's verify read (`management · verify`, the same read L02 runs on\nRedtail) has no designated scope there.\n\nA Keychain item `mgmt-vulture-client-secret` exists under the live service,\nbut a stored secret is not a designation. Per the release contract a family\nwithout designated access is recorded **blocked**, never passed and never\nrun on an undesignated credential.\n\n## What unblocks it\n\nAdd one family to the private manifest and re-run `cargo run -p xtask --\nlive-scope --scope <path>`:\n\n```json\n\"L19\": {\n  \"status\": \"designated\",\n  \"reason\": \"\",\n  \"environment\": \"test-b\",\n  \"credentials\": {\n    \"client_secret\": { \"kind\": \"keychain\", \"service\": \"io.cdot.prisma-airs-desktop.v2.live\", \"account\": \"mgmt-vulture-client-secret\" }\n  },\n  \"nonsecret\": { \"client_id\": \"<Vulture management client id>\", \"tsg_id\": \"1852583913\", \"region\": \"us\" },\n  \"permitted_operations\": [\"one management verify read through the first-run wizard (C29); no inventories, no writes\"],\n  \"disposable_prefix\": null,\n  \"budget\": { \"reads\": 2 },\n  \"cleanup\": [],\n  \"irreversible_exclusions\": [\"no changes of any kind on Vulture\"]\n}\n```\n\nThe run then goes through the real wizard on the fixture build with the\nKeychain reference, and the receipt lands in `live/L19-verify.json` with the\nclient id and TSG only (no token, no secret). Until then `live/blocked.json`\nis the row's record.\n\n## Preparation update — 2026-11-01\n\nThe owner approved adding read-only L19 with the existing Keychain reference,\na maximum of two reads and no inventory browsing or changes. The public client\nID was supplied through the owner's local CLI tenant configuration; its secret\nfield was neither copied nor used. Private-manifest activation follows offline\nvalidation of the new family.\n\nInspection of the actual management verifier found that its credential probe\nreads one latest security-profile entry (`limit=1`, `latest=true`) and discards\nthe response contents. It does not merely obtain a token. The owner explicitly\napproved this single-profile probe, retaining only verification status and call\nmetadata, within the two-read maximum and with no other inventory browsing or\nchanges. The earlier wording above must not be used to imply that it is token-only.\nThe exact bounded operation and input restrictions are now documented under\nL19 in `docs/planning/live-checks.md` and validated by `xtask::live`.\n\nThe offline regression first failed because L19 was an unknown family; it now\naccepts an optional complete designation and rejects scope expansion. This is\ntooling preparation, not a live receipt. The historical `live/blocked.json`\nremains unchanged until an approved actual wizard verification has a separate\nsource-bound receipt.\n{\n  \"schema\": \"airs-v2/l19-additional-grant/1\",\n  \"owner_approval\": \"Compare, refresh if different, allow 1 more probe\",\n  \"recorded_utc\": \"2026-11-01T13:36:31.023213+00:00\",\n  \"condition\": \"local secret differed; named reference corrected and verified\",\n  \"correction_record_sha256\": \"32fa5ff6634794e195a61f2cd86bcfee2be542251447eccf67233aeb045a7350\",\n  \"previous_manifest_sha256\": \"999f95abf2f6fb75f3597c95d7903a385eb7a1e876b99f6d63185378ba24499e\",\n  \"previous_read_reservations\": 2,\n  \"previous_ledger_sha256\": \"45d0456aef4d907dfadfcdf0475ff8126d024d9dfb0e38ab1dc097994fbcd945\",\n  \"new_manifest_sha256\": \"a2dd7b01ed289ed164859ac0daf6e582100de555d29eefb01fa13df87d0bdbe1\",\n  \"additional_read_cap\": 1,\n  \"maximum_cumulative_read_reservations\": 3,\n  \"previous_reservations_refunded\": 0,\n  \"operation\": \"same single latest-profile probe (limit=1), no other inventories or writes\"\n}\n{\n  \"schema\": \"airs-v2/l19-local-credential-correction/1\",\n  \"recorded_utc\": \"2026-11-01T13:35:46.006961+00:00\",\n  \"owner_approval\": \"Compare, refresh if different, allow 1 more probe\",\n  \"reference\": {\n    \"service\": \"io.cdot.prisma-airs-desktop.v2.live\",\n    \"account\": \"mgmt-vulture-client-secret\"\n  },\n  \"source\": \"/Users/cdot/.config/airs-cli/tenants/vulture.toml\",\n  \"source_field\": \"mgmtClientSecret\",\n  \"public_client_id\": \"prisma-airs-cli@1852583913.iam.panserviceaccount.com\",\n  \"tsg_id\": \"1852583913\",\n  \"compared\": true,\n  \"different\": true,\n  \"updated\": true,\n  \"verified\": true,\n  \"secret_values_or_hashes_retained\": false,\n  \"original_read_reservations_retained\": 2,\n  \"additional_probe_permitted_after_correction\": 1\n}\n\nKeep v1 intact as behavioral reference. Academy, the SDK, native Harness, and\ncdot-framework remain independently maintained inputs, consumed at pinned\nrevisions or through reviewed shared presentation modules.\n\nRead-only preflight found the new checkout already initialized on `main`, with\nthe exact origin and no worktree files. The remote advertised no branches.\nPlanning records were moved here from the framework checkout. This does not\nauthorize application implementation before the agreed planning/architecture gates.\n\n## D013 — Scan-key-first onboarding\n\nAccepted in interview round 4, Q13.\n\nThe first scan supports an explicit scanning API key without requiring management\nOAuth credentials. Support scan-only tenants. Management credentials are separate\nand added for administration workflows; a management registration does not\nimplicitly supply scan authentication. Additional scan credential modes must be\nspecified and tested when needed, not inferred from an SDK constructor.\n\n## D014 — Rust application authority\n\nAccepted in interview round 4, Q14.\n\nRust owns tenant context, credential access, request lifecycles, and permission\nto apply configuration changes. React presents drafts, reviews, and results.\nConfiguration review binds the tenant, credentials, resource, and draft; changed\ncontext invalidates it. Harness proposals enter the same operator review flow\nand cannot authorize Apply. Initially preserve the existing Harness project/tool\nrestrictions; expansion would require a separate explicit design decision.\n\n## D015 — Import work, reestablish authentication\n\nAccepted in interview round 4, Q15.\n\nImport selected user-authored work and settings, including saved cases, reports,\nAcademy drafts, API Client projects, and historical conversations. Require fresh\ncredential setup and sign-in. Regenerate disposable caches/downloads. Imported\nconversations are inspectable history until resumption compatibility is validated;\nold pending approvals and authentication sessions never transfer.\n\nReading protected source work for an explicitly selected import is distinct from\ntransferring its old authentication credentials. Define restartable import\nreceipts, version/account checks, rollback, and source-preservation tests.\n\n## D016 — Explicit offline behavior\n\nAccepted in interview round 4, Q16.\n\nOffline mode supports local drafts, saved work, history, and valid downloaded\nAcademy content. Online operations require explicit retry after reconnection.\nDo not silently replay configuration changes, scans, grading submissions, or\nother remote actions. Preserve unknown/uncertain outcomes rather than asserting\nthat cancellation or disconnection undid remote work.\n\n## D017 — Operational usage/cost administration\n\nAccepted in interview round 4, Q17 (owner: \"absolutely\").\n\nRetain Gateway usage, cost, budget, and limit views as Prisma AIRS administrative\nfunctionality. These describe the systems the operator manages. They do not add\n/**\n * Every R2Onboard board (boards.md) renders from its fixture with the\n * reviewed state visible: the wizard opened on the step, over the setup\n * draft the core would hold, through the real contract shape.\n */\nimport { render, screen, within } from '@testing-library/react'\nimport userEvent from '@testing-library/user-event'\nimport { describe, expect, it, vi } from 'vitest'\nimport { Wizard } from './wizard'\nimport type { Dispatch } from '../../features/tenants/dispatch'\nimport { DRAFT_CONTEXT, fxAddTenant, fxAddTenantDrafted, fxOn, type WizardBoard } from './fixtures'\n\nfunction mount(board: WizardBoard) {\n    const dispatch = vi.fn<Dispatch>(async () => ({ kind: 'admitted', operation: null }))\n    const onClose = vi.fn()\n    render(<Wizard snapshot={board.snapshot} dispatch={dispatch} observeManagement={async () => ({ kind: 'verified' as const })} mode={board.mode} onClose={onClose} onNavigate={() => undefined} initial={board.initial} />)\n    return { dispatch, onClose }\n}\nconst current = () => screen.getByRole('navigation', { name: 'Setup steps' }).querySelector('[aria-current=\"step\"]')?.textContent\n\ndescribe('R2Onboard boards', () => {\n    it('R2On01 welcome: three cards and the API-builder framing, no shell, no Back', () => {\n        mount(fxOn.welcome())\n        expect(screen.getByRole('heading', { level: 1, name: 'Welcome to Prisma AIRS Desktop' })).toBeInTheDocument()\n        expect(within(screen.getByRole('main')).getAllByRole('listitem')).toHaveLength(3)\n        expect(screen.queryByRole('navigation', { name: 'Destinations' })).toBeNull()\n        expect(screen.queryByRole('button', { name: 'Back' })).toBeNull()\n    })\n    it('R2On02 tenant empty: nothing drafted, Continue names what is missing, no context line', () => {\n        mount(fxOn.tenantEmpty())\n        expect(current()).toBe('2Tenant')\n        expect(screen.getByRole('button', { name: 'Create tenant' })).toBeEnabled()\n        expect(screen.getByRole('button', { name: 'Create the tenant to continue' })).toBeDisabled()\n        expect(screen.queryByLabelText('Scan API key', { selector: 'input' })).toBeNull()\n        expect(document.querySelector('[data-slot=\"rail-context\"]')).toBeNull()\n    })\n    it('R2On02b tenant filled: the context line, the editable profile, credential controls and Continue', () => {\n        mount(fxOn.tenantFilled())\n        expect(document.querySelector('[data-slot=\"rail-context\"]')).toHaveTextContent('Northwind Health · Staging · TSG 1762204418')\n        expect(screen.getByLabelText(/Display name/)).toHaveValue('Northwind Health')\n        expect(within(screen.getByRole('radiogroup', { name: 'Environment' })).getByRole('radio', { name: 'Staging' })).toBeChecked()\n        expect(screen.getByRole('button', { name: 'Save changes' })).toBeInTheDocument()\n        expect(screen.getByRole('button', { name: 'Replace scan key' })).toBeInTheDocument()\n        expect(screen.getByRole('button', { name: 'Remove scan key' })).toBeInTheDocument()\n        expect(screen.getByRole('button', { name: 'Save management client' })).toBeInTheDocument()\n        expect(screen.getByRole('switch', { name: 'Set up an AI Gateway workspace now' })).not.toBeChecked()\n        expect(screen.getByRole('button', { name: 'Continue' })).toBeEnabled()\n    })\n    it('R2On03 products: Runtime always on, AIS and AES not selectable, reads-with state per card', () => {\n        mount(fxOn.products())\n        const boxes = screen.getAllByRole('checkbox')\n        expect(boxes.map((b) => b.getAttribute('aria-disabled') === 'true')).toEqual([true, false, false, false, true, true])\n        expect(screen.getByRole('checkbox', { name: /AI Gateway/ })).toBeChecked()\n        expect(screen.getByText('Always on')).toBeInTheDocument()\n        expect(screen.getByText('Scan key saved')).toBeInTheDocument()\n        expect(screen.getAllByText('Needs the management client')).toHaveLength(3)\n        expect(screen.getByText(/Licence state is not readable through the public APIs/)).toBeInTheDocument()\n    })\n    it('R2On04 verify running: the list is busy and Continue waits', () => {\n        mount(fxOn.verifyRunning())\n        expect(screen.getByRole('list', { name: 'Checks' })).toHaveAttribute('aria-busy', 'true')\n        expect(screen.getByRole('button', { name: 'Continue' })).toBeDisabled()\n        expect(within(document.querySelector('[data-slot=\"verify-gateway\"]') as HTMLElement).getByText('Pending')).toBeInTheDocument()\n        expect(screen.getByText('Checking…')).toBeInTheDocument()\n    })\n    it('R2On04b verify warning: Continue with warnings is offered because the core says the run is completable', () => {\n        mount(fxOn.verifyWarn())\n        expect(screen.getByText('Checks finished with warnings.')).toBeInTheDocument()\n        expect(screen.getByRole('button', { name: 'Continue with warnings' })).toBeEnabled()\n        expect(screen.getByRole('button', { name: 'Verify again' })).toBeEnabled()\n    })\n    it('R2On04c verify fail (required): Continue is disabled; Fix and verify again returns to Tenant with the profile and credential controls', async () => {\n        const user = userEvent.setup()\n        mount(fxOn.verifyFail())\n        expect(screen.getByText('A required check failed.')).toBeInTheDocument()\n        expect(screen.getByRole('button', { name: 'Continue' })).toBeDisabled()\n        expect(screen.queryByRole('button', { name: 'Continue with warnings' })).toBeNull()\n        expect(screen.getByRole('button', { name: 'Verify again' })).toBeEnabled()\n        expect(within(document.querySelector('[data-slot=\"verify-ais\"]') as HTMLElement).getByText('Not available')).toBeInTheDocument()\n        expect(within(document.querySelector('[data-slot=\"verify-aes\"]') as HTMLElement).getByText('Not available')).toBeInTheDocument()\n        await user.click(screen.getByRole('button', { name: 'Fix and verify again' }))\n        expect(screen.getByRole('heading', { level: 1, name: 'Connect your tenant' })).toHaveFocus()\n        expect(screen.getByLabelText(/TSG ID/)).toHaveValue('1762204418')\n        expect(screen.getByRole('button', { name: 'Replace management client' })).toBeInTheDocument()\n        expect(screen.getByRole('button', { name: 'Remove management client' })).toBeInTheDocument()\n        expect(screen.getByText('Client ID: svc@1762204418.iam.example', { exact: false })).toBeInTheDocument()\n    })\n    it('R2On04c-opt optional failure: the operator may fix it or continue with it recorded as a warning', async () => {\n        const user = userEvent.setup()\n        const { dispatch } = mount(fxOn.verifyOptionalFail())\n        expect(screen.getByText(/An optional check failed/)).toBeInTheDocument()\n        expect(screen.getByRole('button', { name: 'Fix and verify again' })).toBeEnabled()\n        expect(screen.getByRole('button', { name: 'Verify again' })).toBeEnabled()\n        await user.click(screen.getByRole('button', { name: 'Continue with warnings' }))\n        expect(screen.getByRole('heading', { level: 1, name: 'Load starter test cases' })).toBeInTheDocument()\n        expect(dispatch).not.toHaveBeenCalled()\n    })\n    it('R2On04d verify stale: the run no longer counts and later steps are unreachable', () => {\n        mount(fxOn.verifyStale())\n        expect(screen.getByText('The inputs changed since this run. Verify again before continuing.')).toBeInTheDocument()\n        expect(screen.getByRole('button', { name: 'Continue' })).toBeDisabled()\n        const rail = screen.getByRole('navigation', { name: 'Setup steps' })\n        expect(within(rail).getByRole('button', { name: /Done$/ })).toBeDisabled()\n    })\n    it('R2On05 packs: one checkbox per chosen product with its count; Skip clears the choice', async () => {\n        const user = userEvent.setup()\n        mount(fxOn.packs())\n        expect(screen.getByRole('checkbox', { name: 'AI Runtime Security · 6 cases' })).toBeChecked()\n        await user.click(screen.getByRole('button', { name: 'Skip for now' }))\n        expect(screen.getByRole('heading', { level: 1, name: 'Join the AI Security Academy' })).toBeInTheDocument()\n    })\n    it('R2On06 academy: the reviewed account component with sign-in or skip and the sync disclosure', () => {\n        mount(fxOn.academy())\n        expect(screen.getByRole('button', { name: 'Sign in to Academy' })).toBeInTheDocument()\n        expect(screen.getByRole('button', { name: 'Skip for now' })).toBeInTheDocument()\n        expect(screen.getByText(/syncs your Academy progress only/)).toBeInTheDocument()\n    })\n    it('R2On07 done: the summary matches the core’s draft and Open Prisma AIRS sends one completion', async () => {\n        const user = userEvent.setup()\n        const { dispatch } = mount(fxOn.done())\n        expect(screen.getByRole('heading', { level: 1, name: /is ready$/ })).toBeInTheDocument()\n        expect(document.querySelector('[data-slot=\"summary\"]')).toHaveTextContent('Products: AI Runtime Security')\n        // The checks line counts the verification states (a stored key, a skipped client, two unavailable products): never \"All passed\".\n        expect(document.querySelector('[data-slot=\"summary\"]')).toHaveTextContent('Checks: 1 stored, not checked · 1 not checked · 2 not available')\n        expect(document.querySelector('[data-slot=\"summary\"]')).not.toHaveTextContent('All passed')\n        await user.click(screen.getByRole('button', { name: 'Open Prisma AIRS' }))\n        expect(dispatch).toHaveBeenCalledWith({ kind: 'completeTenantSetup', context: DRAFT_CONTEXT, packs: ['runtimeSecurity'], resolution: null })\n        expect(screen.getByRole('button', { name: 'Opening…' })).toBeDisabled()\n    })\n    it('R2AddTenant: no Welcome or Academy step, a 244px rail, Cancel on every step and no Back on the first', () => {\n        mount(fxAddTenant())\n        const rail = screen.getByRole('navigation', { name: 'Setup steps' })\n        expect(within(rail).getAllByRole('button').map((b) => b.textContent)).toEqual(['1Tenant', '2Products', '3Verify', '4Starter casesOptional', '5Done', 'Light appearance'])\n        expect(screen.getByRole('button', { name: 'Cancel' })).toBeInTheDocument()\n        expect(rail).toHaveStyle({ width: '244px' })\n        expect(screen.getByText(/Cancel discards this draft and removes any credential it saved/)).toBeInTheDocument()\n        expect(screen.queryByRole('button', { name: 'Back' })).toBeNull()\n    })\n    it('R2AddTenant drafted: the scan key is optional and Continue is open', () => {\n        mount(fxAddTenantDrafted())\n        expect(screen.getByText(/Optional here; without it scans stay unavailable/)).toBeInTheDocument()\n        expect(screen.getByRole('button', { name: 'Continue' })).toBeEnabled()\n    })\n})\n","exit_code":0,"status":"completed"}}
