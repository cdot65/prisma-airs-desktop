           .await\n                    .map(|detail| ManagementResult::Detail { detail }),\n                ManagementRequest::Overview => Ok(ManagementResult::Overview {\n                    overview: runtime_overview(binding, deadline, self.workspace.as_ref()).await,\n                }),\n                ManagementRequest::RedTeam { window } => red_team_read(binding, *window, deadline)\n                    .await\n                    .map(|observation| ManagementResult::RedTeam { observation }),\n                ManagementRequest::SupplyChain => supply_chain_read(binding, deadline)\n                    .await\n                    .map(|observation| ManagementResult::SupplyChain { observation }),\n                ManagementRequest::Attacks {\n                    scan_id,\n                    page,\n                    received,\n                } => binding\n                    .product_read(\n                        Product::RedTeam,\n                        &format!(\"/v1/report/static/{scan_id}/list-attacks\"),\n\"\"\"Offline regressions for live-driver admission; never resolve credentials.\"\"\"\nimport json\nfrom pathlib import Path\nimport sys\nimport tempfile\nimport unittest\n\nsys.path.insert(0, str(Path(__file__).resolve().parent))\nimport live_c29_l19 as driver\n\n\nclass Settlement(unittest.TestCase):\n    def test_the_actual_pending_tree_is_not_a_finished_verification(self):\n        root = Path(__file__).resolve().parents[2]\n        pending = json.loads((root / 'docs/planning/evidence/C29/live/L19/attempt-01/wizard-verify.json').read_text())\n        self.assertTrue(any(n.get('label') == 'Pending' for n in pending))\n        self.assertFalse(driver.verify_finished(pending))\n\n    def test_terminal_success_and_failure_are_finished_but_reading_is_not(self):\n        for label in ['Checks finished; nothing failed.', 'Checks finished with warnings.', 'A required check failed.', 'An optional check failed. You can fix it and verify again, or continue with