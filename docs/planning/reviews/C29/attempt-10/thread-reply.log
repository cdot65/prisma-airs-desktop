accounts', 'n3', 'tree_add_done', 'tree_add_finished', 'n2', 'secret_leak_paths'])\n{\n  \"behavior\": {\n    \"welcome_relaunch\": true,\n    \"profile_edit_saved\": true,\n    \"profile_edit_key_kept\": true,\n    \"gateway_listed\": true,\n    \"workspace_chosen\": true,\n    \"workspace_key_saved\": true,\n    \"rejected_client_failed\": true,\n    \"failed_client_continuable\": true,\n    \"failed_scan_stored_not_pass\": true,\n    \"credential_fix_returns_tenant\": true,\n    \"correct_client_saved\": true,\n    \"workspace_rechosen_after_fix\": true,\n    \"verification_passed\": true,\n    \"gateway_verification_passed\": true,\n    \"product_edit_marked_stale\": true,\n    \"stale_continuation_closed\": true,\n    \"stale_rerun_clean\": true,\n    \"starter_cases_imported\": true,\n    \"home_relaunch\": true,\n    \"keyed_draft_saved\": true,\n    \"cancelled_rows_unchanged\": true,\n    \"cancelled_active_unchanged\": true,\n    \"cancelled_key_deleted\": true,\n    \"secret_confinement\": true\n  },\n  \"errors\": []\n}\n","exit_code":0,"status":"completed"}}
