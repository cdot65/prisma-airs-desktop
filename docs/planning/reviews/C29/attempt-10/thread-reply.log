{"type":"item.completed","item":{"id":"item_88","type":"command_execution","command":"/bin/zsh -lc \"sed -n '220,305p' tools/native-acceptance/acceptance_c24.py; sed -n '1055,1098p' apps/desktop/src-tauri/src/adapters.rs; sed -n '175,240p' tools/native-acceptance/acceptance_c24.py; python3 -c 'import json; p=\\\"docs/planning/evidence/P09/native/cumulative/C24/native/tree-offline-library.json\\\"; d=json.load(open(p)); print([(n[\\\"role\\\"],n.get(\\\"label\\\")) for n in d if n[\\\"role\\\"] in (\\\"AXHeading\\\",\\\"AXStaticText\\\") and any(x in str(n.get(\\\"label\\\",\\\"\\\")).lower() for x in (\\\"case\\\",\\\"saved\\\",\\\"keychain\\\",\\\"injection\\\",\\\"not run\\\"))])'\"","aggregated_output":"    obs[\"canaries\"] = {\n        \"secret_in_files\": holding(fx.DATA, SECRET, skip=(\".keychain-db\",)),\n        \"secret_in_trees\": [rel(p) for p in trees if SECRET in open(p).read()],\n        \"content_in_diagnostics\": holding(LOGS, CONTENT) + [rel(p) for p in exported if CONTENT in open(p).read()],\n        \"secret_in_diagnostics\": holding(LOGS, SECRET) + [rel(p) for p in exported if SECRET in open(p).read()],\n    }\n    c23.press(app, \"Clear diagnostics\")\n    time.sleep(1.0)\n    lines = sum(len(open(p).read().splitlines()) for p in files(LOGS))\n    obs[\"diagnostics\"][\"cleared\"] = lines <= 2\n\n    # ---- N07: Diagnostics by keyboard, through the production NSSavePanel ----\n    # No AX tree is saved while a panel lists folders.\n    out = os.path.join(work, \"panel-exports\")\n    os.makedirs(out)\n    ns.enable()\n    app.open_settings()\n    reached = c8.reach(app, 1, \"Export diagnostics…\")\n    app.keycode(49)  # Space presses the focused button\n    panel = ns.wait_sheet(app)\n    saved_panel = ns.save_as(app, out)\n    tree, said = c8.text(app, \"Diagnostics saved.\", 10)\n    focus_saved = fx.App.focused(tree)\n    target = os.path.join(out, \"prisma-airs-desktop-diagnostics.json\")\n    try:\n        exported_doc = json.load(open(target))\n    except (OSError, ValueError):\n        exported_doc = {}\n    app.keycode(49)  # still on Export: the panel again, then Cancel\n    cancelled = ns.cancel(app)\n    tree, cancel_said = c8.text(app, \"Nothing was saved.\", 10)\n    focus_cancelled = fx.App.focused(tree)\n    obs[\"tree_panel_cancelled\"] = save_tree(\"diagnostics-panel-cancelled\", tree)\n    ns.disable()\n    clear = c8.reach(app, 1, \"Clear diagnostics\")\n    app.keycode(49)\n    tree, cleared_said = c8.text(app, \"Diagnostics cleared.\", 10)\n    obs[\"tree_cleared\"] = save_tree(\"diagnostics-cleared\", tree)\n    status = [n for n in tree if n.get(\"role\") == \"AXStaticText\" and n.get(\"label\") == \"Diagnostics cleared.\"]\n    for _ in range(10):\n        app.keys(\"=\", \"command down\")\n    zoomed = c8.reach(app, 2, \"Clear diagnostics\")\n    app.keys(\"0\", \"command down\")\n    fx.sh([\"osascript\", \"-e\", f'tell application \"System Events\" to tell (first application process whose unix id is {app.pid}) to set size of window 1 to {{900, 600}}'])\n    time.sleep(0.8)\n    smallest = c8.reach(app, 1, \"Export diagnostics…\")\n    fx.sh([\"osascript\", \"-e\", f'tell application \"System Events\" to tell (first application process whose unix id is {app.pid}) to set size of window 1 to {{1280, 820}}'])\n    # Focus comes back to the control that opened the panel, not just the window.\n    on_export = lambda f: bool(f) and f.get(\"role\") == \"AXButton\" and f.get(\"label\") == \"Export diagnostics…\"  # noqa: E731\n    obs[\"keyboard\"] = {\n        \"export_reached\": bool(reached[\"found\"]),\n        \"panel_shown\": panel,\n        \"saved\": saved_panel and said and exported_doc.get(\"schema\") == \"prisma-airs-desktop-v2/diagnostics/1\",\n        \"focus_after_save\": (focus_saved or {}).get(\"label\"),\n        \"focus_after_save_on_export\": on_export(focus_saved),\n        \"cancelled\": cancelled and cancel_said and sorted(os.listdir(out)) == [\"prisma-airs-desktop-diagnostics.json\"],\n        \"focus_after_cancel\": (focus_cancelled or {}).get(\"label\"),\n        \"focus_after_cancel_on_export\": on_export(focus_cancelled),\n        \"clear_reached\": bool(clear[\"found\"]),\n        \"cleared_announced\": cleared_said and bool(status),\n        \"zoom_200\": zoomed,\n        \"minimum_size\": smallest,\n    }\n\n    # ---- N03: startup network with a configured tenant ----\n    app.quit()\n    before = webkit_pids()\n    app.launch(settle=0)\n    sockets, net_lines, sampled = network(app, before)\n    path = os.path.join(NATIVE, \"startup-network-samples.log\")\n    with open(path, \"w\") as f:\n        f.write(\"\\n\".join([f\"sampled pid={p} ({n})\" for p, n in sorted(sampled.items())] + net_lines) + \"\\n\")\n    obs[\"network\"] = {\"startup_sockets\": sockets, \"log\": rel(path),\n                      \"processes\": sorted(set(sampled.values())),\n                      \"webkit_sampled\": sum(1 for n in sampled.values() if \"WebKit\" in n)}\n\n    # ---- N04: offline launch, then reconnect ----\n    app.quit()\n    endpoint.stop()\n    mgmt.stop()\n    before = webkit_pids()\n    app.launch()\n    app.open_settings()\n    app.make_active(\"Canary Tenant\")\n    app.ax(\"press\", \"AXButton\", \"Case Library\")\n    tree, cases = c8.text(app, \"Prompt injection\", 15)\nfn learner_store(_root: Option<&Path>) -> Arc<dyn CredentialStore> {\n    Arc::new(UnavailableVault)\n}\n\n#[cfg(all(target_os = \"macos\", not(feature = \"test-fixtures\")))]\nfn credential_store(_root: Option<&Path>) -> Arc<dyn CredentialStore> {\n    crate::keychain::KeychainStore::login()\n        .map(|k| Arc::new(k) as Arc<dyn CredentialStore>)\n        .unwrap_or_else(|_| Arc::new(UnavailableVault))\n}\n\n/// The fixture keychain, for the fixture menu's lock/unlock items.\n#[cfg(all(target_os = \"macos\", feature = \"test-fixtures\"))]\npub static FIXTURE_STORE: std::sync::OnceLock<Arc<crate::keychain::KeychainStore>> =\n    std::sync::OnceLock::new();\n\n#[cfg(all(target_os = \"macos\", feature = \"test-fixtures\"))]\nfn credential_store(root: Option<&Path>) -> Arc<dyn CredentialStore> {\n    use crate::keychain::{FIXTURE_SCAN_SERVICE, Interaction, KeychainStore};\n    let store = root.and_then(|dir| {\n        KeychainStore::file(\n            &dir.join(FIXTURE_KEYCHAIN),\n            FIXTURE_KEYCHAIN_PASSWORD,\n            FIXTURE_SCAN_SERVICE,\n            Interaction::Disallowed,\n        )\n        .ok()\n    });\n    match store {\n        Some(store) => {\n            let store = Arc::new(store);\n            let _ = FIXTURE_STORE.set(Arc::clone(&store));\n            store\n        }\n        None => Arc::new(UnavailableVault),\n    }\n}\n\n#[cfg(not(target_os = \"macos\"))]\nfn credential_store(_root: Option<&Path>) -> Arc<dyn CredentialStore> {\n    Arc::new(UnavailableVault)\n}\n\n/// The fixture build's additional trust roots for the synthetic acceptance\n    app.make_active(\"Canary Tenant\")\n    app.open_runtime()\n    app.type_into(\"AXTextField\", \"Profile name or ID\", c8.PROFILE)\n    app.type_into(\"AXTextArea\", \"Prompt\", CONTENT)\n    before = len(endpoint.requests())\n    app.ax(\"press\", \"AXButton\", \"Scan\", 0)\n    tree, scanned = c8.text(app, \"Allowed\", 15)\n    obs[\"seed\"] = {\"stored\": stored, \"scanned\": scanned and len(endpoint.requests()) == before + 1}\n    obs[\"tree_scan\"] = save_tree(\"scan\", tree)\n\n    # ---- N04 (staging): local work to find again offline. The alpha import is retired (D060): the cases come from\n    # Test Cases' starter packs (Load starter packs… → Load selected); FP/FN reports and the import receipt are not\n    # staged (the report flow is C11's, run on this presentation by acceptance_c11.py).\n    app.ax(\"press\", \"AXButton\", \"Case Library\")\n    app.wait_for(lambda t: fx.App.node(t, \"AXHeading\", \"Test Cases\") is not None, 12)\n    opener = next((n for n in app.tree() if n.get(\"role\") in (\"AXButton\", \"AXPopUpButton\") and (n.get(\"label\") or \"\") == \"Load starter packs…\"), None)\n    if opener is None:\n        raise RuntimeError(f\"no Load starter packs… [tree: {app.dump_tree('cases-no-packs')}]\")\n    app.ax(\"press\", opener[\"role\"], \"Load starter packs…\")\n    app.wait_for(lambda t: fx.App.node(t, \"AXButton\", \"Load selected\") is not None, 10)\n    app.ax(\"press\", \"AXButton\", \"Load selected\")\n    tree, staged = c8.text(app, \"Prompt injection\", 20)\n    obs[\"staged\"] = {\"imported\": staged, \"how\": \"starter packs (the alpha import retired, D060)\"}\n\n    # ---- N01: diagnostics in Settings ----\n    app.open_settings()\n    tree, stated = app.wait_for(lambda t: any(\"Kept only on this Mac for 14 days and never sent anywhere\" in p for p in diagnostics_paragraphs(t)), 10)\n    counted = diagnostics_counted(tree)\n    c23.press(app, \"Export diagnostics…\")\n    tree, saved = c8.text(app, \"Diagnostics saved.\", 15)\n    exported = [p for p in files(EXPORTS) if p.endswith(\"diagnostics.json\")]\n    document = json.load(open(exported[0])) if exported else {}\n    obs[\"tree_diagnostics\"] = save_tree(\"diagnostics\", tree)\n    obs[\"diagnostics\"] = {\n        \"stated\": stated,\n        \"counted\": counted,\n        \"saved\": saved and bool(exported),\n        \"schema\": document.get(\"schema\"),\n        \"events\": len(document.get(\"events\", [])),\n        \"kinds_only\": all(set(e.get(\"event\", {})) <= {\"type\", \"kind\", \"refusal\", \"version\", \"fixture\", \"health\",\n                                                      \"outcome\", \"file\", \"line\"} for e in document.get(\"events\", [])),\n    }\n\n    # ---- N02 (search): the canaries ----\n    trees = [os.path.join(NATIVE, n) for n in os.listdir(NATIVE) if n.startswith(\"tree-\")]\n    obs[\"canaries\"] = {\n        \"secret_in_files\": holding(fx.DATA, SECRET, skip=(\".keychain-db\",)),\n        \"secret_in_trees\": [rel(p) for p in trees if SECRET in open(p).read()],\n        \"content_in_diagnostics\": holding(LOGS, CONTENT) + [rel(p) for p in exported if CONTENT in open(p).read()],\n        \"secret_in_diagnostics\": holding(LOGS, SECRET) + [rel(p) for p in exported if SECRET in open(p).read()],\n    }\n    c23.press(app, \"Clear diagnostics\")\n    time.sleep(1.0)\n    lines = sum(len(open(p).read().splitlines()) for p in files(LOGS))\n    obs[\"diagnostics\"][\"cleared\"] = lines <= 2\n\n    # ---- N07: Diagnostics by keyboard, through the production NSSavePanel ----\n    # No AX tree is saved while a panel lists folders.\n    out = os.path.join(work, \"panel-exports\")\n    os.makedirs(out)\n    ns.enable()\n    app.open_settings()\n    reached = c8.reach(app, 1, \"Export diagnostics…\")\n    app.keycode(49)  # Space presses the focused button\n    panel = ns.wait_sheet(app)\n    saved_panel = ns.save_as(app, out)\n[('AXStaticText', 'Keychain'), ('AXStaticText', 'Test Cases'), ('AXHeading', 'Test Cases'), ('AXStaticText', 'Test Cases'), ('AXStaticText', '11 cases in Canary Tenant · sealed on this Mac, per tenant'), ('AXStaticText', 'Search cases'), ('AXStaticText', 'Case'), ('AXStaticText', 'Not run'), ('AXStaticText', 'Prompt injection attempt'), ('AXStaticText', 'Not run'), ('AXStaticText', 'Not run'), ('AXStaticText', 'Not run'), ('AXStaticText', 'Not run'), ('AXStaticText', 'Not run'), ('AXStaticText', 'Not run'), ('AXStaticText', 'Not run'), ('AXStaticText', 'Not run'), ('AXStaticText', 'Not run'), ('AXStaticText', 'Review a skill that should never request tenant OAuth secrets, system keychains, or arbitrary shell execution.'), ('AXStaticText', 'Not run'), ('AXStaticText', 'Case'), ('AXStaticText', 'Prompt injection attempt'), ('AXStaticText', 'Review a skill that should never request tenant OAuth secrets, system keychains, or arbitrary shell execution.'), ('AXStaticText', 'Not run'), ('AXStaticText', 'Not run'), ('AXStaticText', 'Not run'), ('AXStaticText', 'Not run'), ('AXStaticText', 'Not run'), ('AXStaticText', 'Not run'), ('AXStaticText', 'Not run'), ('AXStaticText', 'Not run'), ('AXStaticText', 'Not run'), ('AXStaticText', 'Not run'), ('AXStaticText', 'Not run'), ('AXStaticText', 'Case')]\n","exit_code":0,"status":"completed"}}
