: \"c673feed3aa0948e643a2c4bf23b793364fb6a6a12b1cbc2f0de877757c288f9\",\n  \"inputs\": {\n    \"procedure\": \"docs/planning/evidence/P09/runs/hash-inputs.sh\",\n    \"procedure_sha256\": \"0a4f9546e1aa4a812da6a946c6ee73d9a0e69c3fd4534dd3d480d5c804b53ea1\",\n    \"before_inventory\": \"docs/planning/evidence/P09/preparations/worf-07/inputs-before.sha256\",\n    \"after_inventory\": \"docs/planning/evidence/P09/preparations/worf-07/inputs-after.sha256\",\n    \"before_digest\": \"f5f26271b8823df8a2b5299417146784d345d4e04f8b59341706e6a41750210d\",\n    \"after_digest\": \"f5f26271b8823df8a2b5299417146784d345d4e04f8b59341706e6a41750210d\",\n    \"unchanged\": true,\n    \"members\": 18338\n  },\n  \"command\": {\n    \"argv\": [\n      \"cargo\",\n      \"run\",\n      \"--locked\",\n      \"-p\",\n      \"xtask\",\n      \"--\",\n      \"native-prepare\",\n      \"--phase\",\n      \"P09\",\n      \"--target\",\n      \"aarch64-apple-darwin\",\n      \"--features\",\n      \"test-fixtures\"\n    ],\n    \"cwd\": \"/Users/cdot/development/redtail/prisma-airs-desktop-v2-current\",\n    \"exit\": 0,\n    \"log\": \"docs/planning/evidence/P09/preparations/worf-07/native-prepare.log\",\n    \"log_sha256\": \"89ca7df866329d65d0efa4a98bdaca85ce8472da0fc292ea80945772cf59aae2\"\n  },\n  \"prior_generation\": \"docs/planning/evidence/P09/native-history/Worf-generation-06-complete-before-store-order-fix-20261102\",\n  \"qualification\": \"Fresh build input seal only; every mapped native driver must run on these new bytes before qualification. No old native pass transferred.\"\n}\n#!/bin/bash\n# Deterministic inventory of the inputs P09's checks compile, test or build:\n# the Rust crates and host, the desktop app sources and configuration, the\n# contracts package sources and fixtures, the Academy shared source actually\n# consumed (.work/academy/src and its installed packages, staged from\n# .inputs/academy), the native acceptance tools, the lockfiles, the workspace\n# and toolchain manifests, the harness pin and every docs/architecture/*.json.\n# Generated Python bytecode caches are excluded; the captured pending-tree fixture\n# consumed by the L19 driver regression is explicitly included.\n# Every listed path must exist: a missing one fails the inventory (exit 2)\n# instead of producing a partial digest.\n# Usage: hash-inputs.sh <repo-root> <inventory-out>; prints the digest.\nset -euo pipefail\ncd \"$1\"\nDIRS=(crates apps/desktop/src apps/desktop/src-tauri packages/desktop-contracts/src packages/desktop-contracts/fixtures tools/native-acceptance tools/parity tools/academy .work/academy/src .work/academy/packages .inputs/academy)\nFILES=(docs/planning/evidence/C29/live/L19/attempt-01/wizard-verify.json Cargo.toml Cargo.lock rust-toolchain.toml pnpm-lock.yaml package.json pnpm-workspace.yaml resources/harness/pin.json apps/desktop/package.json apps/desktop/index.html packages/desktop-contracts/package.json packages/desktop-contracts/tsconfig.json)\nfor p in \"${DIRS[@]}\"; do [ -d \"$p\" ] || { echo \"inventory: missing directory $p\" >&2; exit 2; }; done\nfor p in \"${FILES[@]}\"; do [ -f \"$p\" ] || { echo \"inventory: missing file $p\" >&2; exit 2; }; done\n{\n  find \"${DIRS[@]}\" -type f -not -path '*/__pycache__/*' -not -path '*/target/*' -not -path '*/node_modules/*' -not -path '*/gen/schemas/*' -not -path '*/.git/*' -print0 | sort -z | xargs -0 shasum -a 256\n  shasum -a 256 \"${FILES[@]}\" apps/desktop/*.ts apps/desktop/*.json docs/architecture/*.json\n} | LC_ALL=C sort -k2 > \"$2\"\n[ -s \"$2\" ] || { echo \"inventory: empty\" >&2; exit 2; }\nshasum -a 256 \"$2\" | cut -d' ' -f1\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_25","type":"command_execution","command":"/bin/zsh -lc 'cat docs/adr/0001-native-operation-authority.md docs/adr/0002-academy-shared-presentation.md docs/adr/0003-native-harness-and-scoped-identity.md docs/adr/0004-managed-workbench-admission.md'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_25","type":"command_execution","command":"/bin/zsh -lc 'cat docs/adr/0001-native-operation-authority.md docs/adr/0002-academy-shared-presentation.md docs/adr/0003-native-harness-and-scoped-identity.md docs/adr/0004-managed-workbench-admission.md'","aggregated_output":"# 1. Native operation authority owns coordination\n\nDate: 2026-10-16. Status: selected following owner candidate selection; independent G01 verdict\nand implementation readiness are tracked in planning/status.md. Implements D008,D009,D013,D014,D016,D019.\n\nV1 already has deep domain/request modules, but GPUI callers still coordinate\nslots, protected-key IO and ordered effects. React must not inherit that authority.\n\nChoose a principal-bound Rust actor with dispatch(Intent) and observe(ViewScope).\nKeep feature transitions domain-owned inside one initial core crate. Native\nbootstrap injects adapters and creates operator/Harness handles; JSON cannot\nselect the caller principal. Finite domain instructions exclude arbitrary SDK\nmethod strings and any Harness Apply capability.\n\nThe interface includes atomic admission/context retirement, per-source supersession,\nseparate read/review/write/stream domains, priority/deadline/rate-limit semantics,\nbounded queues, bounded delivery-sequence deduplication with safe session rotation,\nsingle-use settlement and truthful Remote outcome. No remote IO\nor blocking vault call occurs while the authoritative transition is locked.\nAdmitted work runs on the host's one async runtime; native adapters execute effects.\n\nReact owns raw editor text/undo. Rust owns immutable captured drafts/reviews.\nReview/Apply/Save/Send capture fresh input in their actual production handlers;\nApply compares fresh input with the stored reviewed operation and executes only\nthat stored operation. Invalid/lossy input, changed context/draft/resource or a\nconsumed review refuses dispatch. Never rely only on a debounced revision.\nRequestApply uses a native operator confirmation; actual Apply completion is\nprivate, single-use and revalidated after the modal editor/context lease.\nEvery scoped intent/observation carries native-issued context and principal\nadmission. Async vault completions are generation/lease-bound; obsolete writes\nreceive orphan cleanup rather than reactivating credentials. Explicit one-time\nsecret reveal/copy stays in a scoped transient native dialog, never snapshots.\n\nAlternatives considered under the design-it-twice skill:\n\n| Design | Depth/locality | Cost |\n|---|---|---|\n| Actor dispatch/observe | Callers learn one authority seam; context and settlement stay together | Finite unions and observation backpressure need discipline |\n| Typed scoped handles | Strong domain methods and revoked scopes; flexible internal composition | More handles/methods and IPC registries for callers to coordinate |\n| Task-oriented scan board | Trivial first scan workflow | Public task surface grows across all parity features |\n\nRecommend the actor with domain-specific types and a small generated presentation\nfacade. Retain the alternatives' explicit scoped validation and effortless scan\nusage internally. Do not combine all their public surfaces or add pass-through\nmodules merely to obtain two method names.\n\nTwo real execution adapters (SDK/scripted), storage adapters (Keychain/session/\nfault-injectable) and clocks justify internal seams. The interface is the test\nsurface: switch/replace/cancel while queued/dispatched, old/duplicate reply,\nfresh-input races, double Apply, denied Harness Apply, unknown outcome/no replay,\npriority/deadline/rate-limit containment and observation resynchronization.\n\nSee [selected design](../architecture/DESIGN.md) for ownership/wire details.\nNo app code has been written and no native/SDK test is claimed by this ADR.\n# 2. Share Academy presentation through explicit composition\n\nDate: 2026-10-16. Status: selected following owner candidate selection; independent G01 verdict\nand implementation readiness are tracked in planning/status.md. Implements D004,D005,D006,D007,D010.\n\nThe current UI package re-exports web app source. Shell palette/mobile navigation\nand theme persistence require tRPC/Clerk/router context; the authenticated web\nentry also starts learner and manager behavior. A whole-app import would spread\nthat authority into unrelated desktop features.\n\nKeep one Academy-owned presentation implementation. Create explicit provider-free\ncontrols/theme/shell exports while preserving the existing tooling entry. Both\nAcademy web and desktop consume the extracted source. Composition adapters supply\nbrand/navigation/account/header/palette/mobile slots; the shared module owns\nvisual semantics, responsive layout and focus. No universal plugin framework.\n\nDesktop global theme is an app preference stored through Rust, not hosted\nsettings.update. Academy web keeps its learner-account theme behavior. Learner\nnotifications, gamification and account effects mount only in Academy composition.\n\nExtract learner views separately when C05/C06 require them. Retain React Query/\ntRPC hooks behind a transport/navigation provider; type-only learner contracts\nbuild without the Express/DB runtime. Web uses existing HTTP authentication;\ndesktop uses a terminating link into the allowlisted Rust Academy transport.\nTokens stay native. Hosted learning/access/grading/award truth and client-safe\nbundle/draft contracts remain authoritative. Never bundle raw answer content.\n\nDirectly embedding the authenticated web root is rejected because its interface\ncontains unrelated account/manager assumptions. Maintaining a desktop UI copy\nis rejected because appearance and learner behavior would diverge.\n\nTests render shared presentation without hosted identity/query providers, run\nboth consumers' regressions, verify native keyboard/focus/themes, and prove no\nlearner mutation/gamification effect from general desktop screens. Learner tests\ncover native link envelopes/allowlist, account cache retirement and hosted authority.\n\nDependency/source/license pins are extraction prerequisites. This ADR changes\nno Academy checkout, package or hosted registration. See\n[selected design](../architecture/DESIGN.md).\n# 3. Retain native Harness and own scoped identity in Rust\n\nDate: 2026-10-16. Status: selected following owner candidate selection; independent G01 verdict\nand implementation readiness are tracked in planning/status.md. Implements D010,D011,D014–D016,D021–D023.\n\nDesktop-server is already a Rust engine. V1 host workers and its package manifest\nstill require Node/managed CLI. Preserve engine depth and replace those host\nrequirements, rather than rewrite the agent. Source inspection alone does not\nestablish that a newly sealed installed bundle works without the old resources.\n\nNative lifecycle owns sealed executable selection, bounded stdin bootstrap,\nprotocol supervision, process cleanup, scoped grants and protected history.\nReact only presents lifecycle state. Grant/tenant/project changes retire the\nrun; approvals bind actual call items. Preserve existing project/process/tool\nrestrictions, Gateway-only inference/MCP and no engine Apply.\n\nIdentity shares native discovery/HTTP/validation/storage mechanics while retaining\nAcademy learner, Harness inference and MCP grant policies. They are distinct\nidentities with distinct sign-out/refresh/context effects. Use public-client\nPKCE/device flows and a no-redirect native transport; never embed a client secret\nor trust renderer-selected issuer/token destinations.\n\nHost signature/JWKS validation is a deliberate stricter v2 requirement; v1\nomitted it. Validate ID/access token types according to their actual contracts,\nnot by decoding arbitrary JWT claims. Rotation/expiry/sleep/revocation fail closed.\nSame-identity token refresh restarts the one-shot-bootstrap engine and restores\ncompatible in-session history; it re-confirms workspace-write permission and\nnever replays remote/tool effects. Declining workspace-write confirmation keeps\nthe draft/cancels Send without restart. Any changed ContextBinding (including\nlocal access/model/configuration/MCP inventory) starts a new conversation; its\nold history is inspect-only under the new binding. MCP-only token rotation also\nrebootstraps/restores an identical binding, but retains working v1's current\nproject-access confirmation without an SSO refresh or another write prompt.\nNative scope additionally binds per-server MCP grant IDs/catalog revisions absent\nfrom engine equality; re-sign-in/sign-out/removal/revision change retires the\nconversation. Expiry alone leaves inference usable with that non-required server\nunavailable and native calls denied. This continuity is distinct from inspect-only\nimported history. No token or refresh credential enters React, diagnostics, process arguments or\ninherited environment. One-time operator-entered inputs remain transient.\n\nUse independent v2 bundle/data/Keychain namespaces. Protected work is encrypted\nand account/context-scoped; no plaintext fallback. Reviewed import creates a new\nv2 data generation, never modifies v1, transfers no credentials/approvals and\nretains a restartable receipt/rollback generation. Historical conversations are\ninspect-only until fresh-context compatibility is qualified.\n\nTests cross native process and identity interfaces: malformed/oversized bootstrap,\nqueue pressure, wrong context, crash/EOF/graceful and forced cleanup, signature/\nissuer/audience/key-rotation rejection, scoped sign-out, protected histories and\nNode-free installed inventory. Native/live/final signed-byte proof remain separate.\nSee [selected design](../architecture/DESIGN.md) for identity/crypto proposals.\n# 4. Managed HTTP enters native configuration authority\n\nDate: 2026-10-16. Status: selected following owner candidate selection; independent G01 verdict\nand implementation readiness are tracked in planning/status.md. Implements D014,D016 and C14/C15 requirements.\n\nV1's workbench has real request-document and transport depth. Its redactions-based\nredirect guard is not explicit tenant-credential classification, Live mode lacks\napplication destination binding, and its post-401 retry can resend a mutation.\nThe stricter v2 review/no-replay policy must be enforced below every Send path.\n\nKeep RequestDocument reconciliation separate. Native execution admission captures\na fresh immutable effective request and explicitly distinguishes tenant-managed,\nworkbench-owned and anonymous credentials. Known managed reads need capability/\ndestination admission. Known mutations need exact Configuration review. Unknown\nmanaged methods/paths are denied, even if presented as a read or generic draft.\nOrdinary workbench-owned/anonymous HTTP remains supported.\n\nReplace the editable SCM collection-ID credential gate with native-owned\ncapability registration. Imported IDs/references cannot authorize tenant secret\nresolution. An edited token_url/request URL is admitted against the explicit\ncredential destination before secrets are obtained; an ID change never creates\na capability. Preserve operator-reviewed endpoint configuration separately.\n\nBind review to expanded URL/method/headers/body and file hashes, variables,\ncookies, credential/context/destination and resource classification. Recheck\nbefore dispatch; changed input/context/files require fresh review. Rust constructs\nthe actual request; renderer fields cannot mark it preapproved.\n\nManaged redirects are disabled initially: a 3xx is shown, and following it is a\nnew prepared/admitted request. Generic redirects preserve bounded cookie/credential\norigin policy. No automatic workbench resend follows HTTP401, refresh, reconnect,\nlost response, import or history replay. Refresh can precede a new explicit Send.\n\nThe built-in catalogue has 193 request specifications, 81 with mutation methods;\nthis is metadata parity, not a claim of dedicated/live-qualified product support.\nTests cover imported/edited requests, unknown managed endpoints, direct IPC bypass,\nambiguous paths/auth headers, same/cross-origin redirects, stale cookie/file/\nvariable/context bindings, double Apply and post-401/lost-response no resend.\n\nThis is a stricter v2 product contract, not an allegation that v1 failed its own\ncontract. See [selected design](../architecture/DESIGN.md).\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_26","type":"command_execution","command":"/bin/zsh -lc \"sed -n '1,330p' crates/desktop-core/src/authority/setup_domain.rs\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_26","type":"command_execution","command":"/bin/zsh -lc \"sed -n '1,330p' crates/desktop-core/src/authority/setup_domain.rs\"","aggregated_output":"//! Tenant setup (C29, screens/wizard.md): the first-run wizard and the\n//! add-tenant sheet work on one core-owned draft tenant with its own\n//! context. Credentials attach to the draft through the existing intents,\n//! verification runs in the core over the admitted reads and streams its\n//! steps through the shell snapshot, completion commits the draft as a\n//! tenant in one step, and a discard cleans its credentials up. Nothing of\n//! the draft is visible as a tenant until completion.\n\nuse std::collections::hash_map::DefaultHasher;\nuse std::hash::{Hash, Hasher};\nuse std::sync::{Arc, OnceLock};\n\nuse tokio::time::Instant;\n\nuse super::gateway_domain::SetupGateway;\nuse super::{CredentialClass, MAX_TENANTS, Refusal, ScanCapability, State, Tenant};\nuse crate::context::{ContextRef, WorkspaceRef};\nuse crate::features::{\n    OnboardingState, PackView, ProductId, SetupMode, SetupView, VerifyLine, VerifyState,\n    VerifyStep, VerifyView, VerifyWarning,\n};\nuse crate::gateway::{GatewayRead, GatewayResource, GatewayResult, PlaneAccess, ScopeBinding};\nuse crate::library::CaseProduct;\nuse crate::management::{ManagementFailure, ManagementRequest, ManagementResult};\nuse crate::runtime::OperationId;\nuse crate::tenants::TenantId;\nuse crate::tenants::{ProfileDraft, TenantProfile};\nuse crate::vault::{RecordId, SessionVault, StorageMode};\n\n/// The draft under setup.\n#[derive(Clone, Debug)]\npub(super) struct Setup {\n    pub mode: SetupMode,\n    pub tenant: Tenant,\n    pub context: ContextRef,\n    pub products: Vec<ProductId>,\n    pub verify: Option<VerifyRun>,\n    /// The draft's own Gateway listing and choice.\n    pub gateway: SetupGateway,\n}\n\n/// One verification run: its steps and the inputs it was run over.\n#[derive(Clone, Debug)]\npub(super) struct VerifyRun {\n    generation: u32,\n    signature: u64,\n    steps: Vec<StepState>,\n}\n\n#[derive(Clone, Debug)]\nstruct StepState {\n    step: VerifyStep,\n    operation: Option<OperationId>,\n}\n\n/// What a completed setup left for the handler to act on.\npub(super) struct Completed {\n    pub tenant: TenantId,\n    pub first_run: bool,\n    pub packs: Vec<CaseProduct>,\n    pub retired_workspace: Option<WorkspaceRef>,\n}\n\nconst MAX_WARNINGS: usize = 8;\n\n/// The bundled case-catalog counts per product (the packs step).\nfn pack_counts() -> &'static [(CaseProduct, u32)] {\n    static COUNTS: OnceLock<Vec<(CaseProduct, u32)>> = OnceLock::new();\n    COUNTS.get_or_init(|| {\n        let cases = crate::library::parse_catalog(crate::library::BUNDLED_CATALOG, \"catalog\")\n            .unwrap_or_default();\n        let mut counts: Vec<(CaseProduct, u32)> = Vec::new();\n        for case in cases {\n            match counts.iter_mut().find(|(p, _)| *p == case.product) {\n                Some((_, n)) => *n += 1,\n                None => counts.push((case.product, 1)),\n            }\n        }\n        counts\n    })\n}\n\n/// The case-catalog products a chosen product's starter pack holds.\npub(super) fn case_products(product: ProductId) -> &'static [CaseProduct] {\n    match product {\n        ProductId::RuntimeSecurity => &[CaseProduct::RuntimeSecurity],\n        ProductId::Gateway => &[CaseProduct::AiGateway],\n        ProductId::RedTeam => &[CaseProduct::AiRedTeaming],\n        ProductId::ModelSkill => &[CaseProduct::ModelSecurity, CaseProduct::SkillScanning],\n    }\n}\n\nfn product_label(product: ProductId) -> &'static str {\n    match product {\n        ProductId::RuntimeSecurity => \"AI Runtime Security\",\n        ProductId::Gateway => \"AI Gateway\",\n        ProductId::RedTeam => \"AI Red Teaming\",\n        ProductId::ModelSkill => \"Model and skill scans\",\n    }\n}\n\nfn needs_management(product: ProductId) -> bool {\n    product != ProductId::RuntimeSecurity\n}\n\n/// The verify step's reason for a management failure.\nfn failure_reason(failure: ManagementFailure) -> &'static str {\n    match failure {\n        ManagementFailure::Unauthorized => {\n            \"The management client was not accepted. Check the client ID and secret.\"\n        }\n        ManagementFailure::Denied => \"The management client is not allowed to read this tenant.\",\n        ManagementFailure::NotFound => \"The service found nothing for this TSG.\",\n        ManagementFailure::RateLimited => \"The service is rate-limiting reads; try again shortly.\",\n        ManagementFailure::Unavailable => \"The management service could not be reached.\",\n        ManagementFailure::Rejected => \"The service rejected the request.\",\n        ManagementFailure::Timeout => \"The service did not answer in time.\",\n        ManagementFailure::Cancelled => \"The check was cancelled.\",\n        ManagementFailure::Network => \"The network request failed.\",\n        ManagementFailure::Destination => \"The management destination is not reachable from here.\",\n        ManagementFailure::InvalidResponse => {\n            \"The service returned a reply the desktop could not use.\"\n        }\n        ManagementFailure::CredentialLocked => {\n            \"The Keychain is locked; unlock it and verify again.\"\n        }\n        ManagementFailure::CredentialDenied => \"The Keychain denied access to the client secret.\",\n        ManagementFailure::CredentialMissing => \"The client secret is missing from the Keychain.\",\n        ManagementFailure::Configuration => \"The management client is not fully configured.\",\n    }\n}\n\nfn chosen(products: Vec<ProductId>) -> Vec<ProductId> {\n    let mut chosen = vec![ProductId::RuntimeSecurity];\n    for p in products {\n        if !chosen.contains(&p) {\n            chosen.push(p);\n        }\n    }\n    chosen\n}\n\nimpl State {\n    /// Whether `context` is the draft's.\n    pub(super) fn is_setup_context(&self, context: &ContextRef) -> bool {\n        self.data\n            .setup\n            .as_ref()\n            .is_some_and(|s| &s.context == context)\n    }\n\n    /// The draft's tenant id for its context.\n    pub(super) fn setup_tenant_for(&self, context: &ContextRef) -> Option<TenantId> {\n        self.data\n            .setup\n            .as_ref()\n            .filter(|s| &s.context == context)\n            .map(|s| s.tenant.profile.id.clone())\n    }\n\n    fn setup_for(&self, context: &ContextRef) -> Result<&Setup, Refusal> {\n        self.data\n            .setup\n            .as_ref()\n            .filter(|s| &s.context == context)\n            .ok_or(Refusal::StaleContext)\n    }\n\n    fn setup_for_mut(&mut self, context: &ContextRef) -> Result<&mut Setup, Refusal> {\n        self.data\n            .setup\n            .as_mut()\n            .filter(|s| &s.context == context)\n            .ok_or(Refusal::StaleContext)\n    }\n\n    /// Starts a setup with a validated profile. One draft at a time.\n    pub(super) fn begin_setup(\n        &mut self,\n        mode: SetupMode,\n        profile: ProfileDraft,\n    ) -> Result<(), Refusal> {\n        let profile = profile.validate().ok_or(Refusal::InvalidInput)?;\n        if self.data.setup.is_some() {\n            return Err(Refusal::Busy);\n        }\n        if self.data.tenants.len() >= MAX_TENANTS {\n            return Err(Refusal::Busy);\n        }\n        if mode == SetupMode::FirstRun && !self.data.tenants.is_empty() {\n            return Err(Refusal::InvalidInput);\n        }\n        let id = TenantId::issue().ok_or(Refusal::ShuttingDown)?;\n        self.epoch += 1;\n        let context = ContextRef::issue(&self.salt, self.epoch);\n        self.data.setup = Some(Setup {\n            mode,\n            tenant: Tenant::new(TenantProfile {\n                id,\n                label: profile.label,\n                tsg_id: profile.tsg_id,\n                destination: profile.destination,\n                environment: profile.environment,\n            }),\n            context,\n            products: vec![ProductId::RuntimeSecurity],\n            verify: None,\n            gateway: SetupGateway::default(),\n        });\n        Ok(())\n    }\n\n    /// Whether `tenant` is the draft under setup.\n    pub(super) fn is_setup_tenant(&self, tenant: &TenantId) -> bool {\n        self.data\n            .setup\n            .as_ref()\n            .is_some_and(|s| &s.tenant.profile.id == tenant)\n    }\n\n    /// The draft's inputs changed (a credential, the profile): a fresh\n    /// context replaces the old one so nothing bound to it survives — the\n    /// cached management binding (SDK clients, token cache, TSG), reads in\n    /// flight, the verify run and the Gateway listing and choice.\n    pub(super) fn reissue_setup_context(&mut self) {\n        if self.data.setup.is_none() {\n            return;\n        }\n        self.epoch += 1;\n        let fresh = ContextRef::issue(&self.salt, self.epoch);\n        self.retire_setup_authority();\n        if let Some(setup) = self.data.setup.as_mut() {\n            setup.context = fresh;\n            setup.verify = None;\n            setup.gateway = SetupGateway::default();\n        }\n    }\n\n    /// A tenant was committed outside the setup (the legacy Create tenant\n    /// or a v1 import during first run): a first-run draft is over, since\n    /// the desktop now has a tenant and the shell takes over. Its Keychain\n    /// records go to the cleanup queue; returned session records are the\n    /// caller's to delete.\n    pub(super) fn end_first_run_setup(&mut self) -> Vec<RecordId> {\n        if self\n            .data\n            .setup\n            .as_ref()\n            .is_none_or(|s| s.mode != SetupMode::FirstRun)\n        {\n            return Vec::new();\n        }\n        let context = self.data.setup.as_ref().map(|s| s.context.clone());\n        match context {\n            Some(context) => self.discard_setup(&context).unwrap_or_default(),\n            None => Vec::new(),\n        }\n    }\n\n    /// Changes the draft's profile. A new destination retires credentials\n    /// bound to the old one (returned session records are the caller's to\n    /// delete); verification results go stale through the signature.\n    pub(super) fn update_setup(\n        &mut self,\n        context: &ContextRef,\n        profile: ProfileDraft,\n    ) -> Result<Vec<RecordId>, Refusal> {\n        let profile = profile.validate().ok_or(Refusal::InvalidInput)?;\n        let setup = self.setup_for(context)?;\n        let id = setup.tenant.profile.id.clone();\n        let destination_changed = setup.tenant.profile.destination != profile.destination;\n        let tsg_changed = setup.tenant.profile.tsg_id != profile.tsg_id;\n        let mut retired = Vec::new();\n        if destination_changed {\n            for class in [\n                CredentialClass::Scan,\n                CredentialClass::Management,\n                CredentialClass::Inference,\n            ] {\n                retired.extend(self.retire_class(&id, class));\n            }\n        } else if tsg_changed {\n            retired.extend(self.retire_class(&id, CredentialClass::Management));\n        }\n        let setup = self.setup_for_mut(context)?;\n        let changed = setup.tenant.profile.label != profile.label\n            || setup.tenant.profile.tsg_id != profile.tsg_id\n            || setup.tenant.profile.destination != profile.destination\n            || setup.tenant.profile.environment != profile.environment;\n        setup.tenant.profile.label = profile.label;\n        setup.tenant.profile.tsg_id = profile.tsg_id;\n        setup.tenant.profile.destination = profile.destination;\n        setup.tenant.profile.environment = profile.environment;\n        if changed {\n            self.reissue_setup_context();\n        }\n        Ok(retired)\n    }\n\n    /// Records the chosen products (Runtime Security always, in first place).\n    pub(super) fn choose_setup_products(\n        &mut self,\n        context: &ContextRef,\n        products: Vec<ProductId>,\n    ) -> Result<(), Refusal> {\n        let setup = self.setup_for_mut(context)?;\n        setup.products = chosen(products);\n        Ok(())\n    }\n\n    /// A digest of every input verification depends on: profile, products\n    /// and the credential records. Results for another digest are stale.\n    fn setup_signature(setup: &Setup) -> u64 {\n        let mut h = DefaultHasher::new();\n        let p = &setup.tenant.profile;\n        p.label.hash(&mut h);\n        p.tsg_id.hash(&mut h);\n        p.destination.origin().hash(&mut h);\n        (p.environment as u8).hash(&mut h);\n        for product in &setup.products {\n            (*product as u8).hash(&mut h);\n        }\n        for class in [\n            CredentialClass::Scan,\n            CredentialClass::Management,\n            CredentialClass::Inference,\n        ] {\n            match setup.tenant.capability(class) {\n                ScanCapability::Ready { record, .. } => record.as_str().hash(&mut h),\n                ScanCapability::Storing { record, .. } => {\n","exit_code":0,"status":"completed"}}
