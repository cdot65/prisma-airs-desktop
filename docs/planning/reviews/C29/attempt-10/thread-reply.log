fault();\napps/desktop/src-tauri/src/adapters.rs:1205:                .unwrap_or_default();\napps/desktop/src-tauri/src/adapters.rs:1240:                .unwrap_or_default();\n\n/// The native open sheet attached to the main window.\npub struct NativePicker<R: Runtime> {\n    app: AppHandle<R>,\n}\n\nimpl<R: Runtime> ImportPicker for NativePicker<R> {\n    fn choose(&self) -> BoxFuture<'static, Option<Result<ImportFile, ImportError>>> {\n        let app = self.app.clone();\n        Box::pin(async move {\n            let (tx, rx) = tokio::sync::oneshot::channel::<Option<PathBuf>>();\n            let window = app.get_webview_window(MAIN_WINDOW)?;\n            app.run_on_main_thread(move || {\n                let chosen = rfd::FileDialog::new()\n                    .set_parent(&window)\n                    .set_title(\"Import tenant profiles\")\n                    .add_filter(\"Tenant profiles\", &[\"json\"])\n                    .pick_file();\n                let _ = tx.send(chosen);\n            })\n            .ok()?;\n            let path = rx.await.ok()??;\n            let name = path\n                .file_name()\n                .map(|n| n.to_string_lossy().into_owned())\n                .unwrap_or_default();\n            let read = tokio::task::spawn_blocking(move || read_bounded(&path))\n                .await\n                .ok()?;\n            Some(read.map(|bytes| ImportFile { name, bytes }))\n        })\n    }\n}\n\n/// The native file sheet for a dictionary's keyword file, attached to the\n/// main window; the file is only read, bounded to [`MAX_TEXT_FILE_BYTES`].\n#[cfg_attr(feature = \"test-fixtures\", allow(dead_code))]\npub struct NativeTextPicker<R: Runtime> {\n    app: AppHandle<R>,\n}\n\nimpl<R: Runtime> ImportPicker for NativeTextPicker<R> {\n    fn choose(&self) -> BoxFuture<'static, Option<Result<ImportFile, ImportError>>> {\n        let app = self.app.clone();\n        Box::pin(async move {\n            let (tx, rx) = tokio::sync::oneshot::channel::<Option<PathBuf>>();\n            let window = app.get_webview_window(MAIN_WINDOW)?;\n            app.run_on_main_thread(move || {\n                let chosen = rfd::FileDialog::new()\n                    .set_parent(&window)\n                    .set_title(\"Choose a dictionary keyword file\")\n                    .add_filter(\"Text\", &[\"txt\", \"csv\"])\n                    .pick_file();\n                let _ = tx.send(chosen);\n            })\n            .ok()?;\n            let path = rx.await.ok()??;\n            let name = path\n                .file_name()\n                .map(|n| n.to_string_lossy().into_owned())\n                .unwrap_or_default();\n            let read =\n                tokio::task::spawn_blocking(move || read_limited(&path, MAX_TEXT_FILE_BYTES))\n                    .await\n                    .ok()?;\n            Some(read.map(|bytes| ImportFile { name, bytes }))\n        })\n    }\n}\n\n/// The commit point at which the next v1 import or rollback stops (C23),\n/// named in `fixture-import-crash` under the fixture data root.\n#[cfg(feature = \"test-fixtures\")]\npub const FIXTURE_IMPORT_CRASH: &str = \"fixture-import-crash\";\n\n#[cfg(feature = \"test-fixtures\")]\npub fn fixture_import_crash<R: Runtime>(\n    app: &AppHandle<R>,\n) -> Option<desktop_core::import_v1::CommitPoint> {\n    use desktop_core::import_v1::CommitPoint;\n    let named =\n        std::fs::read_to_string(app.path().app_data_dir().ok()?.join(FIXTURE_IMPORT_CRASH)).ok()?;\n    match named.trim() {\n        \"created\" => Some(CommitPoint::Created),\n        \"writing\" => Some(CommitPoint::Writing),\n        \"written\" => Some(CommitPoint::Written),\n        \"applied\" => Some(CommitPoint::Applied),\n        \"reverting\" => Some(CommitPoint::Reverting),\n        \"reverted\" => Some(CommitPoint::Reverted),\n        _ => None,\n    }\n}\n\n#[cfg(test)]\nmod tests {\n    use super::*;\n\n    #[test]\n    fn reads_are_bounded_and_limited_to_regular_files() {\n        let dir = std::env::temp_dir().join(format!(\"airs-v2-import-{}\", std::process::id()));\n        std::fs::create_dir_all(&dir).expect(\"dir\");\n\n    fn delete(&self, record: &RecordId) -> Result<(), VaultError> {\n        self.call(|| {\n            let (_, item) = self.find(record)?;\n            delete_item(&item)\n        })\n    }\n}\n\nimpl CredentialStore for KeychainStore {\n    fn purge(&self) -> Result<(), VaultError> {\n        self.call(|| {\n            let found = ItemSearchOptions::new()\n                .class(ItemClass::generic_password())\n                .keychains(std::slice::from_ref(&self.keychain))\n                .service(self.service)\n                .limit(Limit::All)\n                .load_refs(true)\n                .search();\n            let results = match found {\n                Ok(results) => results,\n                Err(e) if e.code() == ERR_SEC_ITEM_NOT_FOUND => return Ok(()),\n                Err(e) => return Err(e.code()),\n            };\n            for result in results {\n                if let SearchResult::Ref(Reference::KeychainItem(item)) = result {\n                    match delete_item(&item) {\n                        Ok(()) | Err(ERR_SEC_ITEM_NOT_FOUND) => {}\n                        Err(code) => return Err(code),\n                    }\n                }\n            }\n            Ok(())\n        })\n    }\n}\n\n#[cfg(test)]\nmod tests {\n    use super::*;\n\n    #[test]\n    fn status_codes_map_to_sanitized_failures() {\n        assert_eq!(map(ERR_SEC_ITEM_NOT_FOUND, None), VaultError::NotFound);\n        assert_eq!(\n            map(ERR_SEC_INTERACTION_NOT_ALLOWED, Some(true)),\n            VaultError::Locked\n        );\n        assert_eq!(\n            map(ERR_SEC_INTERACTION_NOT_ALLOWED, Some(false)),\n            VaultError::Denied\n        );\n        assert_eq!(map(ERR_SEC_USER_CANCELED, Some(false)), VaultError::Denied);\n        assert_eq!(map(ERR_SEC_AUTH_FAILED, Some(false)), VaultError::Denied);\n        assert_eq!(map(ERR_SEC_AUTH_FAILED, Some(true)), VaultError::Locked);\n        assert_eq!(map(ERR_SEC_USER_CANCELED, Some(true)), VaultError::Locked);\n        assert_eq!(map(ERR_SEC_NO_SUCH_KEYCHAIN, None), VaultError::Unavailable);\n        assert_eq!(map(-1, None), VaultError::Unavailable);\n    }\n}\ntools/native-acceptance/acceptance_c24.py:14:(with its keychains, exports and logs) is removed at the end; the real v1\ntools/native-acceptance/acceptance_c24.py:15:folder and the login keychain are untouched.\ntools/native-acceptance/acceptance_c24.py:139:            fx.sh([\"security\", \"delete-keychain\", c23.V1_KEYCHAIN])\ntools/native-acceptance/acceptance_c24.py:221:        \"secret_in_files\": holding(fx.DATA, SECRET, skip=(\".keychain-db\",)),\ntools/native-acceptance/acceptance_c40.py:286:    n1[\"empty_line\"] = app.has_text(tree, \"0 cases in Northwind Health · sealed on this Mac, per tenant\")\ntools/native-acceptance/acceptance_c40.py:303:    n1[\"count_line\"] = next((x for x in app.texts(tree) if re.match(r\"\\d+ cases in Northwind Health · sealed on this Mac, per tenant\", x)), None)\n","exit_code":0,"status":"completed"}}
