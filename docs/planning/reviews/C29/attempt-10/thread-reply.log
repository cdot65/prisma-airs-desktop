{"type":"item.completed","item":{"id":"item_21","type":"command_execution","command":"/bin/zsh -lc \"sed -n '1,240p' tools/p09/phase_inputs.py\"","aggregated_output":"\"\"\"Fail-closed current-P09 inputs for the manual phase-review fallback.\n\nHistorical member verdicts remain historical. Current native/check evidence and\nthe remedial C29-C32 audits must independently qualify the integrated inputs.\nThis module never launches a review or changes a completion ledger.\n\"\"\"\nfrom pathlib import Path\nimport datetime\nimport hashlib\nimport json\nimport math\nimport re\nimport subprocess\nimport sys\nimport tempfile\n\nMEMBERS = ['C27', 'C28', 'C29', 'C30', 'C31', 'C32', 'C33', *[f'C{i}' for i in range(35, 45)]]\nDECISIONS = {\n    'C33': 'docs/planning/p09-recut.md',\n    'C41': 'docs/planning/reviews/C41/owner-override-2026-10-31.md',\n}\nDIMENSIONS = {'architecture', 'behavior', 'authority_security', 'validation', 'overall'}\nREVIEW_DISABLED = {'hooks', 'plugins', 'apps', 'remote_plugin', 'browser_use', 'browser_use_external',\n                   'in_app_browser', 'computer_use', 'image_generation', 'multi_agent', 'skill_search',\n                   'skill_mcp_dependency_install', 'unbounded_connection_retries'}\n\n\ndef require(condition, message):\n    if not condition:\n        raise ValueError(message)\n\n\ndef read(path):\n    return json.loads(Path(path).read_text())\n\n\ndef sha(path):\n    return hashlib.sha256(Path(path).read_bytes()).hexdigest()\n\n\ndef full_gate(verdict):\n    scores = verdict.get('scores', {})\n    require(set(scores) == DIMENSIONS and all(type(v) is int and v >= 9 and v <= 10 for v in scores.values()),\n            'member does not have all five scores at least 9')\n    require(verdict.get('recommendation') == 'pass', 'member recommendation is not pass')\n    for field in ['required_fixes', 'blockers', 'evidence_gaps']:\n        require(verdict.get(field) == [], 'member has missing/nonempty ' + field)\n\n\ndef verify_launch(root, out):\n    \"\"\"Audit requested isolation, observed feature probe and actual JSONL events.\"\"\"\n    invocation = read(out / 'invocation.json')\n    require(invocation['request_sha256'] == sha(out / 'request.json')\n            and invocation['schema_sha256'] == sha(root / 'docs/architecture/review-verdict.schema.json'),\n            'review invocation request/schema mismatch')\n    argv = invocation['command_without_prompt']\n    require(argv and argv[0] == 'codex' and argv.count('exec') == 1, 'review is not a fresh Codex exec')\n    for flag in ['--no-daemon', '--ephemeral', '--ignore-user-config', '--ignore-rules', '--json']:\n        require(argv.count(flag) == 1, 'review isolation flag missing/duplicated: ' + flag)\n    for flag, value in [('-a', 'never'), ('-s', 'read-only'), ('-m', invocation['model_requested']),\n                        ('--output-schema', 'docs/architecture/review-verdict.schema.json'),\n                        ('-o', str(out / 'verdict-returned.json'))]:\n        require(argv.count(flag) == 1 and argv[argv.index(flag) + 1] == value, 'review argument mismatch: ' + flag)\n    require(not any('dangerously' in x or x in ['--approve-for-me', 'resume', 'fork', '--last'] for x in argv),\n            'review bypass/resume argument forbidden')\n    overrides = [argv[i + 1] for i, arg in enumerate(argv) if arg == '-c']\n    require(set(overrides) == {'web_search=\"disabled\"', 'model_reasoning_effort=\"xhigh\"'} and len(overrides) == 2,\n            'review config overrides differ from contract')\n    disabled = [argv[i + 1] for i, arg in enumerate(argv) if arg == '--disable']\n    require(set(disabled) == REVIEW_DISABLED and len(disabled) == len(REVIEW_DISABLED), 'review feature flags differ')\n    probe = out / 'feature-probe.log'\n    require(sha(probe) == invocation['feature_probe_sha256'], 'review feature probe drift')\n    observed = {line.split()[0]: line.split()[-1] for line in probe.read_text().splitlines() if len(line.split()) >= 3}\n    require(all(observed.get(name) == invocation['restricted_features_observed'].get(name) == 'false'\n                for name in REVIEW_DISABLED), 'review feature isolation not observed')\n    messages, sessions = [], []\n    for line in (out / 'thread-reply.log').read_text().splitlines():\n        try:\n            event = json.loads(line)\n        except json.JSONDecodeError:\n            continue\n        if not isinstance(event, dict):\n            continue\n        item = event.get('item', {})\n        if not isinstance(item, dict):\n            item = {}\n        require(event.get('type') not in ['hook.started', 'hook.completed']\n                and item.get('type') not in ['mcp_tool_call', 'hook_execution'], 'unexpected review connector/hook event')\n        if event.get('type') == 'thread.started':\n            sessions.append(event.get('thread_id'))\n        if event.get('type') == 'item.completed' and item.get('type') in ['agent_message', 'assistant_message']:\n            messages.append(item.get('text', ''))\n    require(messages and json.loads(messages[-1]) == read(out / 'verdict-returned.json'),\n            'returned verdict does not match actual final JSONL agent message')\n    return {'invocation_sha256': sha(out / 'invocation.json'), 'thread_reply_sha256': sha(out / 'thread-reply.log'),\n            'feature_probe_sha256': sha(probe), 'model_requested': invocation['model_requested'],\n            'harness_version_observed': invocation['harness_version_observed'], 'reviewer_sessions_observed': sessions,\n            'limits': 'Observed CLI settings/events and unchanged inputs; not cryptographic proof of provider authorship.'}\n\n\ndef latest_verdict(root, subject):\n    directory = root / 'docs/planning/reviews' / subject\n    key = lambda p: [int(x) if x.isdigit() else x for x in re.findall(r'\\d+|[a-z]+', p.name)]\n    for attempt in sorted(directory.glob('attempt-*'), key=key, reverse=True):\n        for name in ['verdict-returned.json', 'verdict.json']:\n            path = attempt / name\n            if path.is_file():\n                return path, read(path)\n    raise ValueError('no actual verdict for ' + subject)\n\n\ndef verify_members(root):\n    members = []\n    for subject in MEMBERS + [f'P{i:02}' for i in range(1, 8)]:\n        if subject == 'C33':\n            decision = root / DECISIONS[subject]\n            require(decision.is_file(), 'missing C33 supersession decision')\n            members.append({'subject': subject, 'standing': 'superseded under D059; no numeric verdict invented',\n                            'owner_decision': DECISIONS[subject], 'owner_decision_sha256': sha(decision)})\n            continue\n        path, verdict = latest_verdict(root, subject)\n        request = read(path.parent / 'request.json')\n        require(verdict['subject'] == subject and verdict['request_id'] == request['request_id']\n                and verdict['attempt_id'] == request['attempt_id'] and verdict['fingerprints'] == request['fingerprints'],\n                subject + ': verdict/request binding mismatch')\n        item = {'subject': subject, 'record': str(path.relative_to(root)), 'sha256': sha(path),\n                'request': str((path.parent / 'request.json').relative_to(root)),\n                'request_sha256': sha(path.parent / 'request.json'), 'scores': verdict['scores'],\n                'recommendation': verdict['recommendation']}\n        if subject == 'C41':\n            decision = root / DECISIONS[subject]\n            require(decision.is_file(), 'missing C41 explicit owner override')\n            require(verdict['attempt_id'] == 'attempt-09' and verdict['scores'] == dict(\n                architecture=9, behavior=8, authority_security=9, validation=8, overall=8),\n                'C41 override applies only to its unchanged recorded numeric verdict')\n            item.update(owner_decision=DECISIONS[subject], owner_decision_sha256=sha(decision),\n                        standing='explicit owner override; actual numeric verdict unchanged')\n        else:\n            full_gate(verdict)\n        receipt = path.parent / 'receipt.json'\n        if receipt.is_file():\n            value = read(receipt)\n            require(value.get('verdict_sha256', value.get('raw_verdict_sha256')) == sha(path), subject + ': receipt verdict hash mismatch')\n            require(value.get('scores', value.get('verdict', {}).get('scores')) == verdict['scores'], subject + ': receipt scores mismatch')\n            require(value['request_id'] == verdict['request_id'] and value['fingerprints'] == verdict['fingerprints'],\n                    subject + ': receipt request/fingerprint mismatch')\n            item.update(receipt=str(receipt.relative_to(root)), receipt_sha256=sha(receipt))\n        if subject in ['C29', 'C30', 'C31', 'C32']:\n            audit = path.parent / 'post-review-audit.json'\n            value = read(audit)\n            require(value['full_gate_pass'] and value['compiled_inputs_unchanged']\n                    and value['raw_verdict_sha256'] == sha(path) and value['request_sha256'] == sha(path.parent / 'request.json'),\n                    subject + ': missing/stale full-gate audit')\n            # These remedial generations must still cover the current scoped bytes.\n            inventory = read(path.parent / 'source-inventory.json')\n            for name, digest in inventory['files'].items():\n                require(sha(root / name) == digest, subject + ': reviewed source/evidence drift: ' + name)\n            item.update(audit=str(audit.relative_to(root)), audit_sha256=sha(audit))\n        members.append(item)\n    return members\n\n\ndef native_build(root, prepared):\n    \"\"\"The current fixture build's actual before/after compiled-input seal.\"\"\"\n    path = root / 'docs/planning/evidence/P09/native-build-inputs.json'\n    build = read(path)\n    require(build['schema'] == 'airs-v2/p09-native-build-inputs/1', 'native build-input schema mismatch')\n    require(re.fullmatch(r'[A-Za-z0-9][A-Za-z0-9._-]*', build['generation']) is not None,\n            'invalid native generation')\n    prefix = 'docs/planning/evidence/P09/preparations/' + build['generation'] + '/'\n    require(build['prepare'] == 'docs/planning/evidence/P09/native-prepare.json'\n            and build['command']['log'] == prefix + 'native-prepare.log'\n            and build['command']['cwd'] == str(root)\n            and build['command']['argv'] == ['cargo', 'run', '--locked', '-p', 'xtask', '--', 'native-prepare',\n                                            '--phase', 'P09', '--target', 'aarch64-apple-darwin', '--features', 'test-fixtures'],\n            'native build command/path mismatch')\n    require(build['worktree_diff'] == prefix + 'fixture-remediation.diff'\n            and sha(root / build['worktree_diff']) == build['worktree_diff_sha256'], 'native source-diff provenance mismatch')\n    require(build['prepare_sha256'] == sha(root / build['prepare'])\n            and build['executable_sha256'] == prepared['executable_sha256']\n            and build['bundle_sha256'] == prepared['bundle_sha256'], 'native build/preparation binding mismatch')\n    require(build['command']['exit'] == 0 and sha(root / build['command']['log']) == build['command']['log_sha256'],\n            'native build command failed or log changed')\n    value = build['inputs']\n    require(value['procedure'] == 'docs/planning/evidence/P09/runs/hash-inputs.sh'\n            and value['before_inventory'] == prefix + 'inputs-before.sha256'\n            and value['after_inventory'] == prefix + 'inputs-after.sha256', 'native inventory paths mismatch')\n    procedure = root / value['procedure']\n    require(sha(procedure) == value['procedure_sha256'], 'native build inventory procedure drift')\n    require(value['before_digest'] == value['after_digest'] == sha(root / value['before_inventory'])\n            == sha(root / value['after_inventory']), 'native build inputs changed')\n    require(value['unchanged'] is True and value['members'] == len((root / value['before_inventory']).read_text().splitlines())\n            and value['members'] > 0, 'native build inventory declaration mismatch')\n    with tempfile.TemporaryDirectory(prefix='p09-native-inputs-') as scratch:\n        current = subprocess.check_output(['/bin/bash', str(procedure), str(root), str(Path(scratch) / 'inputs.sha256')], text=True).strip()\n    require(current == value['before_digest'], 'current compiled inputs differ from prepared native build')\n    return {'record': str(path.relative_to(root)), 'sha256': sha(path),\n            'generation': build['generation'], 'input_digest': current}\n\n\ndef c30_samples(value):\n    \"\"\"Check real-record sample accounting; unit fixtures cannot qualify a run.\"\"\"\n    require(value.get('label') == 'acceptance' and value.get('status') == 'pass'\n            and value.get('failure') is None and value.get('method') == 'c30-cached-switch-v2',\n            'C30 requires successful current-method acceptance')\n    require(set(value['metrics']) == {'tenant-switch-home'}, 'wrong C30 workload')\n    metric = value['metrics']['tenant-switch-home']\n    samples = metric['samples']\n    require(metric['unit'] == 'ms' and len(samples) == 10, 'C30 requires ten measured samples')\n    require(all(type(x) in (int, float) and math.isfinite(x) and x > 0 for x in samples),\n            'invalid C30 timing sample')\n    rows = value['details']['raw_switches']\n    require(len(rows) == 12 and value['details']['switches'] == 12, 'C30 requires all twelve raw switches')\n    for index, row in enumerate(rows):\n        source, target = ('Tenant A', 'Tenant B') if index % 2 == 0 else ('Tenant B', 'Tenant A')\n        measured = row['probe'].get('ms')\n        require(row['index'] == index and row['from'] == source and row['to'] == target\n                and row['warmup'] is (index < 2) and row['exit'] == 0\n                and row['probe']['method'] == 'c30-cached-switch-v2'\n                and type(measured) in (int, float) and math.isfinite(measured) and measured > 0\n                and type(row['probe']['polls']) is int and row['probe']['polls'] > 0,\n                'invalid/omitted C30 raw switch')\n    require(samples == [row['probe']['ms'] for row in rows[2:]], 'C30 sample selection mismatch')\n    p95 = sorted(samples)[math.ceil(.95 * len(samples)) - 1]\n    require(p95 <= 100, 'C30 cached-switch p95 exceeds registered 100ms budget')\n    return p95\n\n\ndef verify_c30_performance(root, prepared, build, records):\n    phase = root / 'docs/planning/evidence/P09'\n    path = phase / 'workload-perf-C30.json'\n    value = read(path)\n    p95 = c30_samples(value)\n    attempt = value['attempt']\n    require(re.fullmatch(r'attempt-\\d+', attempt) is not None, 'invalid C30 performance attempt')\n    prefix = 'docs/planning/evidence/P09/performance/C30/' + attempt + '/'\n    require(value['schema'] == 'airs-v2-workload-perf/1' and value['subject'] == 'P09'\n            and value['source_root'] == str(root) and sha(root / (prefix + 'workload-perf.json')) == sha(path),\n            'C30 performance identity/attempt mismatch')\n    require(value['executable_sha256'] == prepared['executable_sha256']\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_22","type":"command_execution","command":"/bin/zsh -lc \"wc -l apps/desktop/src/v2/wizard/* crates/desktop-core/src/authority/setup_domain.rs crates/desktop-core/tests/ui_v2_onboarding/main.rs crates/desktop-core/tests/ui_v2_setup_reads/main.rs; ls docs/adr; sed -n '1,180p' docs/planning/IMPLEMENTATION-PLAN.md\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_22","type":"command_execution","command":"/bin/zsh -lc \"wc -l apps/desktop/src/v2/wizard/* crates/desktop-core/src/authority/setup_domain.rs crates/desktop-core/tests/ui_v2_onboarding/main.rs crates/desktop-core/tests/ui_v2_setup_reads/main.rs; ls docs/adr; sed -n '1,180p' docs/planning/IMPLEMENTATION-PLAN.md\"","aggregated_output":"     244 apps/desktop/src/v2/wizard/copy.ts\n     108 apps/desktop/src/v2/wizard/fixtures.ts\n     144 apps/desktop/src/v2/wizard/wizard-boards.test.tsx\n     456 apps/desktop/src/v2/wizard/wizard.test.tsx\n    1128 apps/desktop/src/v2/wizard/wizard.tsx\n     956 crates/desktop-core/src/authority/setup_domain.rs\n     616 crates/desktop-core/tests/ui_v2_onboarding/main.rs\n     937 crates/desktop-core/tests/ui_v2_setup_reads/main.rs\n    4589 total\n0001-native-operation-authority.md\n0002-academy-shared-presentation.md\n0003-native-harness-and-scoped-identity.md\n0004-managed-workbench-admission.md\n# Prisma AIRS Desktop v2 implementation plan\n\nStatus: product interview decisions D001–D023 accepted; D024/D025 settle source\nterms and all four architecture candidates; D026 makes Codex the independent\nchunk and phase reviewer. G00/G01 passed; implementation proceeds from C01. A passing plan review is not a passing architecture,\nSDK, application, live-tenant, or package review.\n\n## Outcome and exclusions\n\nDeliver a fresh macOS Apple Silicon desktop application with React presentation\nin Tauri, a focused Rust application core, direct Rust SCM SDK integration, and\nthe native Rust Harness engine. Academy supplies shared presentation and remains\nthe authority for remote learning. Preserve agreed working v1 behavior, using\nv1 as requirements reference. Do not translate its GPUI implementation wholesale.\n\nNo desktop billing, media-generation backend, local MySQL/Redis server stack,\nNode/Bun backend runtime, TypeScript workers, speculative browser client, or\nin-app updater is included. Academy gamification remains inside Academy. Gateway\nusage/cost/budget/limits remain operational product functionality. Build-time\nJavaScript tooling and React WebView JavaScript are expected.\n\nSource destination: `ssh://git@git-ssh.cdot.io/cdot/prisma-airs-desktop-v2.git`.\nCheckout: `/Users/cdot/development/redtail/prisma-airs-desktop-v2`.\n\n## Architectural guiding principles\n\n1. Design deep modules: substantial behavior behind a small domain interface.\n   Apply the deletion test; do not wrap every SDK method in a pass-through module.\n2. The interface is the test surface. Exercise production transitions and\n   adapters; use independent wire/protocol expectations for external contracts.\n3. One adapter is a hypothetical seam; two real adapters justify a seam. Shared\n   Academy presentation has real web/desktop consumers. Do not build speculative\n   browser/backend/plugin architectures for this desktop delivery.\n4. Rust owns authority and locality for tenant/credential/workspace context,\n   request lifecycle, configuration review, protected storage, and approvals.\n   React owns presentation and editable input, not permission to execute.\n5. The SDK owns its declared transport/authentication contracts. The application\n   owns interactive identity, OS storage, context admission, and workflow policy.\n   Do not duplicate SDK retry/pagination/OAuth policy without a documented need.\n6. Unknown outcomes and partial/stale/denied/unsupported data remain distinct.\n   Never map an unknown verdict to allow or a cancelled write to successful rollback.\n7. Host credentials and capabilities are explicit. No ambient environment-file\n   discovery, inherited production fallback, generic renderer secret access,\n   unrestricted native plugin grants, or cross-origin credential forwarding.\n8. Shared appearance does not imply shared learner state. Tenant operations,\n   Academy identity/progression, Harness inference identity, and MCP grants stay\n   separately scoped. A tenant switch does not sign the learner out of Academy.\n9. Keep provenance and reproducibility local to dependency selection. Exact\n   versions, source hashes, build inputs, notices, and protocol pins are evidence;\n   a neighboring active worktree is not a release dependency.\n10. Measure native usability/performance and the actual installed package. A\n    successful browser render or mocked IPC assertion is insufficient evidence\n    for Tauri host behavior, VoiceOver, Keychain, sidecar isolation, or notarization.\n\nConcrete interfaces, crate decomposition, shared package extraction, and storage\nformats are outputs of G01. This plan defines behavior and testable work, not\nunreviewed Rust signatures or a predetermined hierarchy of tiny modules.\n\n## Ordered phases and chunks\n\nEvery Cxx has its own instruction file under [chunks](chunks/README.md). Complete\nchunks in numeric order. A dependency delay blocks its chunk; report it honestly\nand continue only research/preparation explicitly within that chunk. Do not\nsilently advance a later phase or replace a real dependency with a fake to pass.\nFor a prolonged upstream stall, report the exact dependency and offer an owner\nreorder/scope decision. Do not wait indefinitely or reorder silently; an approved\nchange updates predecessors, plan and review evidence before execution.\n\n| Phase | Chunks   | Result                                                           |\n|-------|----------|------------------------------------------------------------------|\n| P00   | G00, G01 | Confirmed plan; selected and reviewed architecture               |\n| P01   | C01–C03  | Shared desktop shell, native core, first complete Runtime scan   |\n| P02   | C04–C07  | Academy identity, learner presentation, assessment, offline work |\n| P03   | C08–C12  | Runtime/DLP administration, Sessions, reports, Library           |\n| P04   | C13–C15  | Existing Red Team/Model reads and complete API Client workflows  |\n| P05   | C16–C18  | Gateway workspace/configuration, reviewed changes, inference     |\n| P06   | C19–C22  | Native Harness, Rust sign-in, typed host tools, workspace MCP    |\n| P07   | C23–C24  | Reviewed imports, native quality, accessibility/privacy closure  |\n| P08   | C25–C26  | Controlled live qualification; signed installed DMG acceptance   |\n| P09   | C27–C44  | UI v2 \"Refined Native\": spec, shell, wizard, destinations (D058); re-cut from C35 as one screen per chunk ported from the prototype (D059) |\n\n### G00 — Plan confirmation\n\nFinish the decision ledger, baseline coverage, chunk instructions, review/test\nprotocols, dependency gates, and architecture handoff. Obtain an actual independent\nplan review meeting D019. Product decisions are accepted and the owner explicitly\nselected the architecture candidates and source terms in D024/D025. Continue the\nrequested design work; no further blanket scope question is needed. Architecture\nreview and implementation evidence remain distinct gates.\n\n### G01 — Architecture improvement workflow\n\nFollow [the handoff](architecture-handoff.md) and the requested\nimprove-codebase-architecture skill. Explore the named areas, show a temporary\nHTML report with before/after candidates, ask the owner to choose, and grill the\nselected design. Produce ADRs, interface/test ownership, dependency/import\ndecisions, and concrete chunk command specifications. Review the architecture\nat least 9/10 in every critical dimension and overall. Revise this plan if the\nselected design affects it, then re-review affected planning evidence.\n\nNo application scaffolding, shared-source refactoring, real-data migration,\nproduct endpoint calls, or packaging implementation begins before G01 passes.\n\n## Per-chunk execution contract\n\n1. Read AGENTS/CLAUDE, glossary, accepted ADRs, the chunk, predecessor receipts,\n   dependency manifest, test catalogue, and its canonical implementer prompt.\n2. Confirm a clean approved source snapshot and identify unrelated user work.\n   Resolve dependency availability/provenance and baseline check limitations.\n3. Implement only that chunk and approved supporting changes. A shared Academy,\n   SDK, or Harness change needs its own reviewed revision and regression evidence;\n   preserve active work and do not move another project's main branch casually.\n4. Run exact checks from the approved command manifest. Use deterministic local\n   fixtures and literal external contracts, then the appropriate native tests.\n   Never call hosted application endpoints by accident.\n5. Record commands, environments, inputs, results, failures, hashes, limitations,\n   and rollback rehearsal. Save raw sensitive evidence privately; commit redacted\n   summaries with references/hashes, not credentials or customer bodies.\n6. Freeze source and dependency inputs. Request actual independent Codex\n   review through [the independent prompt](prompts/review-chunk.md) (D026).\n7. If any critical dimension/overall score is below 9, required fixes remain,\n   source changed, or mandatory evidence is absent: remediate, rerun affected\n   checks, freeze a new snapshot, and request a new review of the same chunk.\n8. Complete only after the receipt and evidence validate against current inputs.\n   After a phase's last chunk, obtain the cumulative Codex phase review\n   ([prompt](prompts/review-phase.md)) before starting the next phase.\n   Make a focused commit; revalidate that its tree matches the reviewed tree.\n   Later edits invalidate affected receipts and trigger targeted regression\n   checks/re-review. Preserve failed attempts; never pressure a reviewer to pass.\n\n## Command contract to establish in C01\n\nThese commands are a required future interface, not tools that exist today:\n\n```text\ncargo run --locked -p xtask -- check --chunk Cxx --manifest docs/architecture/checks.json\ncargo run --locked -p xtask -- test --chunk Cxx --manifest docs/architecture/checks.json\ncargo run --locked -p xtask -- native --chunk Cxx --manifest docs/architecture/checks.json\ncargo run --locked -p xtask -- review --chunk Cxx --reviewer codex --manifest docs/architecture/checks.json\ncargo run --locked -p xtask -- review --phase Pxx --reviewer codex --manifest docs/architecture/checks.json\ncargo run --locked -p xtask -- complete --chunk Cxx --manifest docs/architecture/checks.json\ncargo run --locked -p xtask -- package --kind preview --manifest docs/architecture/checks.json\ncargo run --locked -p xtask -- package --kind release-candidate --manifest docs/architecture/checks.json\n```\n\nC01 creates the controller and a versioned manifest of exact commands, working\ndirectories, targets, features, fixtures, timeouts, and expected evidence. It\ncannot implement the later chunks itself. G01 specifies actual Rust/pnpm/Tauri\ncommands after choosing the workspace; a future engineer must not guess them or\nclaim these placeholder commands already ran. Document/test the controller's\nrejection of missing, stale, malformed, edited, or sub-threshold receipts.\n\n## Coverage and evidence\n\n- [Feature baseline](feature-baseline.md): existing working/preview/stub behavior.\n- [Parity matrix](parity-matrix.md): work ownership and release closure.\n- [Dependency gates](dependencies.md): accepted inputs and unresolved qualification.\n- [Test catalogue](test-catalogue.md): named behavioral/native/artifact test cases.\n- [Review protocol](review-protocol.md): scoring, receipt fields, invalidation.\n- [Release contract](release-contract.md): live scope, signing, package/install proof.\n- [Mandatory live checks](live-checks.md): fixed L-family/F-smoke requirements and\n  owner-approved per-workflow live scope; no access-driven silent reductions.\n- [Distribution gate](distribution.md): owner-selected source/binary terms,\n  Academy permission, framework disposition and exact shipped notices.\n- [Status](status.md): authoritative current state; planned is not implemented.\n\nG01 must convert each chunk's named tests into exact invocation commands and\nobservable assertions. Tests cannot simply repeat implementation decisions.\nFresh signed-artifact checks bind the final DMG hash and installed bytes; source\nor fixture checks do not substitute for them.\n\n## Expected sequencing dependencies\n\nThe scan proof can use accepted SDK Phase 3 after native macOS qualification.\nManagement/DLP uses accepted Phase 4 or a later explicitly reviewed compatible\npin. Existing Red Team/Model reads need verified Phase 5 capabilities; complete\nGateway needs Phase 6 capabilities. Harness/Academy transports are application\nwork, not delivered by the SCM SDK. Keep these upstream dependencies visible and\ndo not require unrelated SDK operations merely because they share a library.\n\n","exit_code":0,"status":"completed"}}
