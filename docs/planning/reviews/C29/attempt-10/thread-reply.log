{"type":"item.completed","item":{"id":"item_36","type":"command_execution","command":"/bin/zsh -lc \"sed -n '1,180p' docs/planning/evidence/P09/runs/run-checks.sh; cat tools/native-acceptance/wizard_coverage.py\"","aggregated_output":"#!/bin/bash\n# P09 check runs with a source-bound record. Usage: run-checks.sh <attempt>\n# Runs on the approved toolchain (rustup 1.99.0, node 24.21.0, repo pnpm).\nset -o pipefail\nATTEMPT=${1:-attempt-01}\ncd \"$(dirname \"$0\")/../../../../..\"\nexport PATH=\"$PWD/.tools/bin:$HOME/.cargo/bin:$HOME/.nvm/versions/node/v24.21.0/bin:/usr/bin:/bin:/usr/sbin:/sbin\"\nunset RUSTFLAGS CARGO_BUILD_RUSTFLAGS CARGO_TARGET_DIR\n# Timing-sensitive suites (4 s \"eventually\" waits, engine bootstraps) flake when ten test threads\n# per binary share this Mac with the owner's browser and a second session; four threads per\n# binary keep the same tests and assertions, only less contention. Recorded in the run record.\nexport RUST_TEST_THREADS=4\nR=docs/planning/evidence/P09/runs\nE=$R/$ATTEMPT\nif [ -e \"$E\" ] || [ -e \"$R/run-$ATTEMPT.json\" ]; then\n  echo \"Refusing to overwrite retained P09 check evidence: $ATTEMPT; choose a fresh attempt.\" >&2\n  exit 2\nfi\nmkdir -p \"$E\"\n# Flake logs are same-input retries of this run only: earlier runs' logs are removed first.\nrm -f $E/core-fixtures.flake-*.log $E/host.flake-*.log\nBEFORE=$($R/hash-inputs.sh \"$PWD\" $E/inputs-before.sha256) || { echo \"input inventory failed; run invalid\"; exit 2; }\n[ -n \"$BEFORE\" ] || { echo \"input inventory produced no digest; run invalid\"; exit 2; }\n# Configuration and build flags the controller fingerprints: itemised and hashed together.\nBUILD_FLAGS=$(shasum -a 256 docs/architecture/checks.json docs/architecture/native-checks.json docs/architecture/toolchain.json docs/architecture/budgets.json apps/desktop/src-tauri/tauri.conf.json apps/desktop/src-tauri/tauri.fixture.conf.json apps/desktop/src-tauri/capabilities/*.json rust-toolchain.toml 2>/dev/null | shasum -a 256 | cut -d' ' -f1)\nexport BUILD_FLAGS\nrun() { local name=$1; shift; local log=$E/$name.log; echo \"\\$ $*\" > \"$log\"; \"$@\" >> \"$log\" 2>&1; local rc=$?; echo \"EXIT $rc\" >> \"$log\"; echo \"$name exit=$rc\"; echo $rc > $E/$name.exit; }\nrun rustfmt cargo fmt --all -- --check\nrun clippy cargo clippy --locked -p desktop-core -p desktop-host -p xtask --features test-fixtures --all-targets -- -D warnings\nrun clippy-default cargo clippy --locked --workspace --all-targets -- -D warnings\nrun notices cargo run --locked -q -p xtask -- notices --check\nrun bindings cargo run --locked -q -p xtask -- bindings --check\nrun contracts-typecheck pnpm --filter @prisma-airs/desktop-contracts exec tsc --noEmit\nrun desktop-typecheck pnpm --filter @prisma-airs/desktop exec tsc --noEmit\nrun vitest pnpm --filter @prisma-airs/desktop exec vitest run --config vitest.config.ts\nrun vitest-truth pnpm --filter @prisma-airs/desktop exec vitest run --config vitest.truth.config.ts\nrun core-lib cargo test --locked -p desktop-core --lib\nrun core-fixtures cargo test --locked -p desktop-core --features test-fixtures\n# A timing-sensitive test (Harness-engine turns, or the transport's connection-release\n# check) can flake under the full-suite load: the exact same\n# command is retried on the same frozen inputs, every failed run kept as evidence.\nfor try in 1 2; do\n  if [ \"$(cat $E/core-fixtures.exit)\" != \"0\" ]; then\n    cp $E/core-fixtures.log $E/core-fixtures.flake-$try.log\n    run core-fixtures cargo test --locked -p desktop-core --features test-fixtures\n  fi\ndone\n# The chunk's registered fixture command (docs/architecture/checks.json P09), exactly as the manifest runs it.\nrun fixture-command cargo test --locked -p desktop-core --features test-fixtures --test ui_v2_closure --test ui_v2_shell_port --test ui_v2_home --test ui_v2_inbox_port --test ui_v2_harness_port --test ui_v2_admin --test ui_v2_api --test ui_v2_academy --test ui_v2_wizard\nrun host cargo test --locked -p desktop-host --features test-fixtures\n# The host's Academy device-flow tests (browser_callback.rs, outside this chunk) wait 5 s for a\n# state and flake under load: the same command is retried on the same frozen inputs, every\n# failed run kept as evidence.\nfor try in 1 2; do\n  if [ \"$(cat $E/host.exit)\" != \"0\" ]; then\n    cp $E/host.log $E/host.flake-$try.log\n    run host cargo test --locked -p desktop-host --features test-fixtures\n  fi\ndone\nrun xtask-lib cargo test --locked -p xtask --lib\nrun shell-controller cargo test --locked -p xtask --features test-fixtures --test shell_controller\nrun desktop-build pnpm --filter @prisma-airs/desktop build\nrun l19-offline cargo test --locked -p xtask --features test-fixtures --test controlled_live --test live_run\n# Offline unittest only: retained/synthetic AX settlement and tempfile budget\n# ledgers. Imports pure helpers; never calls the live driver's guarded main(),\n# resolves credentials, launches the qualification app, or sends a product call.\nrun l19-native-driver python3 -I tools/native-acceptance/test_live_c29_l19.py\nAFTER=$($R/hash-inputs.sh \"$PWD\" $E/inputs-after.sha256) || { echo \"input inventory failed after the runs; run invalid\"; exit 2; }\n[ -n \"$AFTER\" ] || { echo \"input inventory produced no digest after the runs; run invalid\"; exit 2; }\npython3 -I - \"$E\" \"$BEFORE\" \"$AFTER\" \"$ATTEMPT\" <<'PY'\nimport json,sys,subprocess,os,time,hashlib\nE,b,a,attempt=sys.argv[1:5]\ndef ver(c):\n    try: return subprocess.check_output(c,text=True,stderr=subprocess.STDOUT).strip()\n    except Exception as e: return str(e)\nsha=lambda p: hashlib.sha256(open(p,\"rb\").read()).hexdigest()\nnames=[\"rustfmt\",\"clippy\",\"clippy-default\",\"notices\",\"bindings\",\"contracts-typecheck\",\"desktop-typecheck\",\"vitest\",\"vitest-truth\",\"core-lib\",\"core-fixtures\",\"fixture-command\",\"host\",\"xtask-lib\",\"shell-controller\",\"desktop-build\",\"l19-offline\",\"l19-native-driver\"]\nrec={\"subject\":\"P09\",\"attempt\":attempt,\"time\":time.strftime(\"%Y-%m-%dT%H:%M:%S%z\"),\"cwd\":os.getcwd(),\n \"toolchain\":{\"rustc\":ver([\"rustc\",\"-V\"]),\"cargo\":ver([\"cargo\",\"-V\"]),\"node\":ver([\"node\",\"-v\"]),\"pnpm\":ver([\"pnpm\",\"-v\"]),\"rustup_active\":ver([\"rustup\",\"show\",\"active-toolchain\"])},\n \"environment\":{\"PATH\":os.environ[\"PATH\"],\"RUSTFLAGS\":os.environ.get(\"RUSTFLAGS\"),\"CARGO_TARGET_DIR\":os.environ.get(\"CARGO_TARGET_DIR\"),\"RUST_TEST_THREADS\":os.environ.get(\"RUST_TEST_THREADS\")},\n \"build_flags\":{\"digest\":os.environ.get(\"BUILD_FLAGS\"),\"covers\":\"checks.json, native-checks.json, toolchain.json, budgets.json, tauri.conf.json, tauri.fixture.conf.json, src-tauri/capabilities/*.json, rust-toolchain.toml\"},\"inputs\":{\"procedure\":f\"{E}/../hash-inputs.sh\",\"procedure_sha256\":sha(f\"{E}/../hash-inputs.sh\"),\"before_inventory_sha256\":sha(f\"{E}/inputs-before.sha256\"),\"before_digest\":b,\"after_inventory_sha256\":sha(f\"{E}/inputs-after.sha256\"),\"after_digest\":a,\"unchanged\":a==b,\"members\":sum(1 for _ in open(f\"{E}/inputs-before.sha256\"))},\n \"runs\":{}}\nfor n in names:\n    log=f\"{E}/{n}.log\"\n    rec[\"runs\"][n]={\"exit\":int(open(f\"{E}/{n}.exit\").read().strip()),\"log\":log,\"log_sha256\":sha(log),\"summary\":[l.strip() for l in open(log,errors=\"replace\") if l.startswith(\"test result\") or \"Test Files\" in l or \"Tests  \" in l or l.startswith(\"EXIT\")][-4:]}\njson.dump(rec,open(f\"{E}/../run-{attempt}.json\",\"w\"),indent=2)\nprint(json.dumps({k:v[\"exit\"] for k,v in rec[\"runs\"].items()}),\"inputs unchanged:\",a==b,\"members:\",rec[\"inputs\"][\"members\"])\nPY\n\"\"\"Independent completeness check for the retained C29 native assertions.\n\nThe expected axes come from C29-N06/T09, rather than the rows a driver happens\nto emit. Missing behavior or a missing capture cannot be reported as exercised.\n\"\"\"\nimport argparse\nimport hashlib\nimport itertools\nimport json\nfrom pathlib import Path\n\nSTEPS = {\n    'firstRun': ['welcome', 'tenant', 'products', 'verify', 'packs', 'academy', 'done'],\n    'add': ['tenant', 'products', 'verify', 'packs', 'done'],\n}\nBEHAVIOR = [\n    'welcome_relaunch', 'profile_edit_saved', 'profile_edit_key_kept',\n    'gateway_listed', 'workspace_chosen', 'workspace_key_saved',\n    'rejected_client_failed', 'failed_client_continuable', 'failed_scan_stored_not_pass',\n    'credential_fix_returns_tenant', 'correct_client_saved', 'workspace_rechosen_after_fix',\n    'verification_passed', 'gateway_verification_passed', 'product_edit_marked_stale',\n    'stale_continuation_closed', 'stale_rerun_clean', 'home_relaunch',\n    'starter_cases_imported', 'secret_confinement',\n    'keyed_draft_saved', 'cancelled_rows_unchanged', 'cancelled_active_unchanged', 'cancelled_key_deleted',\n]\n\n\ndef problems(observations, root):\n    coverage = observations.get('c29_native_coverage', {})\n    behavior = coverage.get('behavior', {})\n    failures = ['missing/failed retained behavior: ' + key for key in BEHAVIOR if behavior.get(key) is not True]\n    rows = coverage.get('layouts', {})\n    expected = {(mode, step, theme, zoom) for mode, steps in STEPS.items()\n                for step, theme, zoom in itertools.product(steps, ['Light', 'Dark'], [1, 2])}\n    seen = set()\n    for name, row in rows.items():\n        axis = (row.get('mode'), row.get('step'), row.get('theme'), row.get('zoom'))\n        if axis in seen:\n            failures.append('duplicate matrix row: ' + str(axis))\n        seen.add(axis)\n        zoom = row.get('zoom')\n        requested = (1440, 900) if zoom == 1 else (900, 600)\n        geometry = row.get('geometry', {})\n        web = geometry.get('web') or []\n        viewport = geometry.get('viewport') or web\n        if not (len(web) == 2 and len(viewport) == 2 and web[0] == requested[0]\n                and viewport[0] == requested[0] and (zoom == 1 or viewport[1] == requested[1])):\n            failures.append(name + ': wrong measured geometry')\n        primary = row.get('primary', {})\n        height = (primary.get('size') or [0, 0])[1]\n        if not (primary.get('inside') and zoom in (1, 2) and height >= 32 * zoom):\n            failures.append(name + ': primary outside window or too small')\n        if row.get('overflow_px') != 0 or row.get('horizontal_scrollbars') != 0:\n            failures.append(name + ': horizontal overflow')\n        if row.get('dialog') != (row.get('mode') == 'add'):\n            failures.append(name + ': wrong modal ownership')\n        keyboard = row.get('keyboard', {})\n        if not (keyboard.get('primary_reached') and keyboard.get('walk') and keyboard.get('contained')):\n            failures.append(name + ': keyboard traversal missing/incomplete')\n        for field in ['capture', 'tree']:\n            path = Path(root) / row.get(field, '')\n            if not row.get(field) or not path.is_file():\n                failures.append(name + ': missing ' + field)\n            elif hashlib.sha256(path.read_bytes()).hexdigest() != row.get(field + '_sha256'):\n                failures.append(name + ': hash mismatch for ' + field)\n    failures.extend('missing matrix row: ' + str(axis) for axis in sorted(expected - seen))\n    failures.extend('unexpected matrix row: ' + str(axis) for axis in sorted(seen - expected))\n    return failures\n\n\ndef main():\n    parser = argparse.ArgumentParser()\n    parser.add_argument('observations', type=Path)\n    parser.add_argument('--root', type=Path, default=Path.cwd())\n    args = parser.parse_args()\n    data = json.loads(args.observations.read_text())\n    errors = problems(data['observations'], args.root)\n    print(json.dumps({'retained_C29_native_coverage': 'fail' if errors else 'pass', 'errors': errors}, indent=2))\n    return 1 if errors else 0\n\n\nif __name__ == '__main__':\n    raise SystemExit(main())\n","exit_code":0,"status":"completed"}}
