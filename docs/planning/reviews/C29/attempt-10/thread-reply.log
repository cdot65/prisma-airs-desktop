{"type":"item.completed","item":{"id":"item_81","type":"command_execution","command":"/bin/zsh -lc \"sed -n '360,430p' crates/desktop-core/src/authority/inbox_domain.rs; sed -n '1,200p' packages/desktop-contracts/src/client.ts; cat packages/desktop-contracts/src/generated/SwitchResolution.ts packages/desktop-contracts/src/generated/SwitchBlocked.ts; sed -n '1,155p' apps/desktop/src/v2/switch-guard.tsx\"","aggregated_output":"}\n\nimpl State {\n    /// The decision the active tenant's conversation is waiting for, if any.\n    pub(super) fn pending_decision(&self) -> Option<PendingDecisionRef> {\n        let conversation = self.live_bound_harness()?;\n        let approvals = self.bound_approvals();\n        let first = approvals.first()?;\n        Some(PendingDecisionRef {\n            conversation: conversation.as_str().to_owned(),\n            decision: first.id.clone(),\n        })\n    }\n\n    /// Admits a tenant switch, or refuses it while a decision is pending\n    /// (I1): the refusal carries the guard the presentation renders.\n    pub(super) fn guard_switch(\n        &mut self,\n        to: &TenantId,\n        resolution: Option<SwitchResolution>,\n        target_context: Option<&ContextRef>,\n    ) -> Result<Option<GuardedSwitch>, Refusal> {\n        if let Some(resolution) = resolution {\n            let (context, review) = match &resolution {\n                SwitchResolution::Archive { context, review }\n                | SwitchResolution::Discard { context, review } => (context, review),\n            };\n            // A resolution names one native refusal, never whichever\n            // conversation happens to be pending when a lost delivery retries.\n            let blocked = self.switch_blocked.as_ref().ok_or(Refusal::StaleContext)?;\n            if self.active_ref.as_ref() != Some(context)\n                || &blocked.context != context\n                || &blocked.review != review\n                || &blocked.to != to\n                || blocked.target_context.as_ref() != target_context\n                || Some(&blocked.pending) != self.pending_decision().as_ref()\n            {\n                return Err(Refusal::StaleContext);\n            }\n            let id = self.live_bound_harness().ok_or(Refusal::StaleContext)?;\n            // Validation alone changes no conversation, guard or history.\n            // A definite store refusal can restore Data and leave all of\n            // this unresolved work exactly as it was.\n            return Ok(Some(match resolution {\n                SwitchResolution::Archive { .. } => GuardedSwitch::Archive(id),\n                SwitchResolution::Discard { .. } => GuardedSwitch::Discard(id),\n            }));\n        }\n        let Some(pending) = self.pending_decision() else {\n            self.switch_blocked = None;\n            return Ok(None);\n        };\n        self.switch_blocked = Some(SwitchBlocked {\n            to: to.clone(),\n            pending,\n            completion: target_context.is_some(),\n            context: self.active_ref.clone().ok_or(Refusal::StaleContext)?,\n            review: ReviewId::issue().ok_or(Refusal::ShuttingDown)?,\n            target_context: target_context.cloned(),\n        });\n        Err(Refusal::DecisionPending)\n    }\n\n    /// The active tenant's setup warnings as items.\n    pub(super) fn setup_warning_items(&self) -> Vec<InboxItem> {\n        self.data\n            .active\n            .as_ref()\n            .and_then(|id| self.tenant(id))\n            .map(|t| t.setup_warnings.iter().map(setup_warning_item).collect())\n            .unwrap_or_default()\n/**\n * Typed presentation facade over the two native commands.\n *\n * - Admission calls are serialized: the next delivery is sent only after the\n *   previous admission result arrives, and the sequence advances only then.\n * - A lost admission result is recovered by resending the same bytes with the\n *   same sequence. If it stays lost, the outcome is unknown: the facade\n *   rotates to a new delivery session and never reuses that sequence for a\n *   different intent. It never re-sends business work under a new sequence.\n * - Native responses are validated at runtime; generated declarations alone\n *   do not validate anything.\n */\nimport type { AcademyCallResult } from './generated/AcademyCallResult'\nimport type { DispatchResponse } from './generated/DispatchResponse'\nimport type { Intent } from './generated/Intent'\nimport type { ManagementResult } from './generated/ManagementResult'\nimport type { MenuCommand } from './generated/MenuCommand'\nimport type { ObservationUpdate } from './generated/ObservationUpdate'\nimport type { Refusal } from './generated/Refusal'\nimport type { ShellSnapshot } from './generated/ShellSnapshot'\nimport type { WorkbenchResult } from './generated/WorkbenchResult'\n\nexport const PROTOCOL = 1\n\n/** The native boundary. Production binds it to Tauri `invoke`/`Channel`. */\nexport interface DesktopTransport {\n    dispatch(bytes: Uint8Array): Promise<unknown>\n    observe(bytes: Uint8Array): Promise<unknown>\n    openChannel(onMessage: (update: unknown) => void): {\n        token: string\n        close(): void\n    }\n}\n\n/** The admission result for a delivery could not be established. */\nexport class DeliveryOutcomeUnknown extends Error {\n    constructor(readonly intentKind: string) {\n        super(\n            `The desktop did not confirm whether \"${intentKind}\" was admitted. ` +\n                'Check the current state before trying again.'\n        )\n        this.name = 'DeliveryOutcomeUnknown'\n    }\n}\n\n/** The native host returned something outside the wire contract. */\nexport class ContractViolation extends Error {\n    constructor(what: string) {\n        super(`Unexpected native response: ${what}`)\n        this.name = 'ContractViolation'\n    }\n}\n\nexport class RefusedError extends Error {\n    constructor(readonly refusal: Refusal) {\n        super(`Refused: ${refusal}`)\n        this.name = 'RefusedError'\n    }\n}\n\nconst REFUSALS: readonly Refusal[] = [\n    'staleContext',\n    'capabilityMissing',\n    'invalidInput',\n    'reviewInvalid',\n    'reviewConsumed',\n    'busy',\n    'lockedStore',\n    'deniedStore',\n    'alreadyProcessed',\n    'sequenceGap',\n    'shuttingDown',\n    'decisionPending',\n]\n\nconst DECIMAL_U64 = /^(0|[1-9][0-9]{0,19})$/\nconst U64_MAX = 18446744073709551615n\n\nconst FEATURE_IDS: readonly string[] = [\n    'home',\n    'inbox',\n    'runtime',\n    'academy',\n    'administration',\n    'sessions',\n    'library',\n    'redTeam',\n    'apiClient',\n    'gateway',\n    'harness',\n    'import',\n    'settings',\n]\nconst THEMES: readonly string[] = ['system', 'light', 'dark']\nconst PRODUCT_IDS: readonly string[] = ['runtimeSecurity', 'gateway', 'redTeam', 'modelSkill']\nconst ENVIRONMENTS: readonly string[] = ['production', 'staging', 'other']\nconst SETUP_MODES: readonly string[] = ['firstRun', 'add']\nconst VERIFY_LINES: readonly string[] = ['scanKey', 'managementClient', 'gateway', 'redTeam', 'modelSkill', 'ais', 'aes']\nconst VERIFY_STATES: readonly string[] = ['pending', 'pass', 'warning', 'fail', 'stored', 'skipped', 'unavailable']\nconst UI_VARIANTS: readonly string[] = ['legacy', 'v2']\nconst ONBOARDING_STATES: readonly string[] = ['needed', 'inProgress', 'done']\nconst STORAGE: readonly string[] = ['ready', 'corrupt', 'unavailable', 'resetting']\nconst SCAN_STATES: readonly string[] = ['missing', 'storing', 'ready', 'failed']\nconst MODES: readonly string[] = ['keychain', 'session']\nconst VAULT_ERRORS: readonly string[] = ['locked', 'denied', 'unavailable', 'notFound', 'corrupt']\nconst REGIONS: readonly string[] = ['unitedStates', 'europe', 'india', 'singapore']\nconst IMPORT_FORMATS: readonly string[] = ['profileDocument', 'airsCliRegistry']\nconst IMPORT_ERRORS: readonly string[] = ['tooLarge', 'unsupported', 'empty']\nconst CANDIDATE_PROBLEMS: readonly string[] = ['invalidLabel', 'invalidTsgId', 'invalidDestination']\nconst TENANT_ID = /^tn-[0-9a-f]{16}$/\nconst CONTEXT_REF = /^cx-[A-Za-z0-9-]{1,61}$/\nconst REVIEW_ID = /^rv-[A-Za-z0-9-]{1,61}$/\nconst OPERATION_ID = /^op-[0-9]{1,20}$/\nconst LEARNER_REF = /^lx-[A-Za-z0-9-]{1,61}$/\n/** A bare HTTPS origin (Academy web, for public links only). */\nconst ACADEMY_ORIGIN = /^https:\\/\\/[A-Za-z0-9.-]{1,253}(:\\d{1,5})?$/\nconst ACADEMY_FAILURES: readonly string[] = [\n    'notConfigured',\n    'invalidConfig',\n    'network',\n    'invalidResponse',\n    'denied',\n    'expired',\n    'sessionExpired',\n    'scopeMissing',\n    'accountChanged',\n    'authFailed',\n]\nconst CALL_FAILURES: readonly string[] = [\n    'network',\n    'timeout',\n    'invalidResponse',\n    'sessionExpired',\n    'credentialUnavailable',\n    'cancelled',\n    'hostUnavailable',\n    'unsupportedImage',\n    'destinationRefused',\n    'uploadFailed',\n    'offlineUnavailable',\n    'notDownloadable',\n    'offlineFull',\n]\nconst SCAN_PROGRESS: readonly string[] = ['queued', 'running', 'settled']\nconst OUTCOMES: readonly string[] = ['notSent', 'rejected', 'completed', 'unknown']\nconst STOP_REASONS: readonly string[] = ['cancelled', 'contextRetired', 'deadline', 'shuttingDown']\nconst VERDICTS: readonly string[] = ['allow', 'block', 'alert', 'unknown']\nconst SCAN_FAILURES: readonly string[] = [\n    'unauthorized',\n    'forbidden',\n    'conflict',\n    'rateLimited',\n    'badRequest',\n    'unprocessable',\n    'serverError',\n    'httpOther',\n    'timeout',\n    'cancelled',\n    'network',\n    'redirect',\n    'malformedResponse',\n    'tooLarge',\n    'invalidRequest',\n    'credentialLocked',\n    'credentialDenied',\n    'credentialMissing',\n    'other',\n]\n\nconst MANAGEMENT_RESOURCES: readonly string[] = [\n    'sessions',\n    'profiles',\n    'topics',\n    'applications',\n    'apiKeys',\n    'deploymentProfiles',\n    'dlpCatalog',\n    'dataProfiles',\n    'dataPatterns',\n    'filteringProfiles',\n    'dictionaries',\n]\nconst MANAGEMENT_FAILURES: readonly string[] = [\n    'unauthorized',\n    'denied',\n    'notFound',\n    'rateLimited',\n    'unavailable',\n    'rejected',\n    'timeout',\n    'cancelled',\n    'network',\n    'destination',\n    'invalidResponse',\n    'credentialLocked',\n    'credentialDenied',\n    'credentialMissing',\n    'configuration',\n]\nconst DETAIL_FOUND: readonly string[] = ['found', 'absent', 'incomplete']\n// This file was generated by [ts-rs](https://github.com/Aleph-Alpha/ts-rs). Do not edit this file manually.\nimport type { ContextRef } from \"./ContextRef\";\nimport type { ReviewId } from \"./ReviewId\";\n\n/**\n * How a blocked switch is resolved (I1): the pending conversation is\n * ended and kept (`archive`) or ended and dropped (`discard`).\n */\nexport type SwitchResolution = { \"kind\": \"archive\", context: ContextRef, review: ReviewId, } | { \"kind\": \"discard\", context: ContextRef, review: ReviewId, };\n// This file was generated by [ts-rs](https://github.com/Aleph-Alpha/ts-rs). Do not edit this file manually.\nimport type { ContextRef } from \"./ContextRef\";\nimport type { PendingDecisionRef } from \"./PendingDecisionRef\";\nimport type { ReviewId } from \"./ReviewId\";\nimport type { TenantId } from \"./TenantId\";\n\n/**\n * Why a tenant switch is held (C28 contract, raised in C30): a Harness\n * conversation has a decision pending; the operator chooses to archive it,\n * discard it or stay. The shell renders its guard from this, never from a\n * guess of its own (invariant I1).\n */\nexport type SwitchBlocked = { \n/**\n * The active source context and native-issued, single refusal reference.\n */\ncontext: ContextRef, review: ReviewId, \n/**\n * The exact setup generation when completing a draft; none for selection.\n */\ntargetContext: ContextRef | null, \n/**\n * The tenant the switch was asked for (a setup draft's id when the\n * switch is its completion).\n */\nto: TenantId, pending: PendingDecisionRef, \n/**\n * The switch is the completion of the tenant setup draft `to`: the\n * resolution is re-sent with `completeTenantSetup` (C30, I1).\n */\ncompletion: boolean, };\nimport type { ShellSnapshot, SwitchResolution } from '@prisma-airs/desktop-contracts'\nimport { GUARD_COPY } from './copy'\nimport { Modal } from './modal'\n\nexport interface SwitchGuardProps {\n    /** The tenant the switch (or the setup completion) leads to. */\n    target: string\n    /** The switch is a setup draft's completion (the body says so). */\n    completion: boolean\n    binding: Pick<NonNullable<ShellSnapshot['switchBlocked']>, 'context' | 'review'>\n    onStay: () => void\n    onResolve: (resolution: SwitchResolution) => void\n}\n\n/**\n * The one tenant-switch guard (I1): rendered from the core's `switchBlocked`\n * whether the switch was asked for through the switcher, the palette, the\n * native menu or the completion of a setup draft. Stay dismisses the guard;\n * Archive and Discard re-send the same intent with the chosen resolution.\n * Initial focus is on Stay, the safe default: Enter on arrival never ends\n * the conversation (Archive stays the visually primary action).\n */\nexport function SwitchGuard({ target, completion, binding, onStay, onResolve }: SwitchGuardProps) {\n    return (\n        <Modal label={GUARD_COPY.title} onClose={onStay} width={520} data-slot='switch-guard'>\n            <h2 className='text-[16px] font-semibold'>{GUARD_COPY.title}</h2>\n            <p className='mt-2 text-[13px]' style={{ color: 'var(--v2-soft)' }}>\n                {completion ? GUARD_COPY.bodyCompletion(target) : GUARD_COPY.body(target)}\n            </p>\n            <div className='mt-4 flex flex-wrap justify-end gap-2'>\n                <button type='button' autoFocus onClick={onStay} className='h-8 rounded-[7px] border px-3 text-[13px]' style={{ borderColor: 'var(--v2-rule)' }}>\n                    {GUARD_COPY.stay}\n                </button>\n                <button type='button' onClick={() => onResolve({ kind: 'discard', context: binding.context, review: binding.review })} className='h-8 rounded-[7px] border px-3 text-[13px]' style={{ borderColor: 'var(--v2-rule)' }}>\n                    {GUARD_COPY.discard}\n                </button>\n                <button type='button' onClick={() => onResolve({ kind: 'archive', context: binding.context, review: binding.review })} className='h-8 rounded-[7px] px-3 text-[13px] font-semibold' style={{ background: 'var(--v2-acc)', color: 'var(--v2-acc-ink)' }}>\n                    {GUARD_COPY.archive}\n                </button>\n            </div>\n        </Modal>\n    )\n}\n","exit_code":0,"status":"completed"}}
