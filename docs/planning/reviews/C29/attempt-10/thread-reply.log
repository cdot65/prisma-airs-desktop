{"type":"item.completed","item":{"id":"item_55","type":"command_execution","command":"/bin/zsh -lc \"cat crates/desktop-core/tests/ui_v2_wizard/main.rs; sed -n '190,300p' crates/desktop-core/src/authority/library_domain.rs; sed -n '430,515p' crates/desktop-core/src/authority/library_domain.rs; rg -n 'fn save_with|fn reissue_context|switch_blocked|fn onboarding' crates/desktop-core/src/authority.rs | head -35\"","aggregated_output":"//! C43: the wizard as the R2Onboard board draws it, through the production\n//! authority interface (docs/planning/chunks/C43.md). What the re-ported\n//! presentation draws from, unchanged from C29: the setup draft's profile\n//! (the rail's context line and the Tenant card), which credential is\n//! required (the Required/Optional tags), the products chosen (the product\n//! cards), the verify run's lines including the unavailable products (the\n//! Checks card), the packs offered with their counts (the starter-case rows)\n//! and completability (the footer's primary). Nothing here commits a tenant.\n\nuse desktop_core::features::{ProductId, VerifyLine, VerifyState};\nuse desktop_core::fixtures::{self, Handles, ScriptedStore};\nuse desktop_core::store::PersistedState;\nuse desktop_core::{\n    AuthorityHandle, Core, CoreConfig, Delivery, Intent, Observation, Receipt, Refusal,\n    ShellSnapshot, ViewScope,\n};\nuse serde_json::json;\n\nstruct Desk {\n    _core: Core,\n    handle: AuthorityHandle,\n    session: String,\n    sequence: u64,\n    #[allow(dead_code)]\n    adapters: Handles,\n}\n\nimpl Desk {\n    fn new() -> Self {\n        let (adapters, handles) =\n            fixtures::adapters_with(ScriptedStore::with_state(PersistedState::default()));\n        let core = Core::new(CoreConfig::default(), adapters);\n        core.start();\n        let handle = core.operator();\n        let session = handle.register_delivery_session().expect(\"session\").nonce;\n        Self {\n            _core: core,\n            handle,\n            session,\n            sequence: 0,\n            adapters: handles,\n        }\n    }\n\n    async fn send(&mut self, intent: serde_json::Value) -> Result<Receipt, Refusal> {\n        let intent: Intent = serde_json::from_value(intent).expect(\"intent\");\n        self.sequence += 1;\n        self.handle\n            .dispatch(\n                Delivery {\n                    session: self.session.clone(),\n                    sequence: self.sequence,\n                },\n                intent,\n            )\n            .await\n    }\n\n    fn snap(&self) -> ShellSnapshot {\n        match self.handle.observe(ViewScope::Shell).expect(\"observe\") {\n            Observation::Shell { snapshot, .. } => snapshot,\n            _ => unreachable!(\"shell scope\"),\n        }\n    }\n\n    fn setup(&self) -> desktop_core::features::SetupView {\n        self.snap().setup.expect(\"a setup in progress\")\n    }\n\n    async fn verified(&self) -> desktop_core::features::VerifyView {\n        for _ in 0..200 {\n            if let Some(v) = self.setup().verify\n                && v.done\n            {\n                return v;\n            }\n            tokio::time::sleep(std::time::Duration::from_millis(5)).await;\n        }\n        panic!(\"verification did not finish\");\n    }\n}\n\n#[tokio::test]\nasync fn the_board_draws_the_draft_the_tags_the_cards_and_the_checks_from_the_setup_view() {\n    let mut desk = Desk::new();\n    desk.send(json!({\"kind\": \"setUiVariant\", \"variant\": \"v2\"}))\n        .await\n        .expect(\"v2\");\n    desk.send(\n        json!({\"kind\": \"beginTenantSetup\", \"mode\": \"firstRun\", \"profile\": {\n        \"label\": \"Northwind Health\", \"tsgId\": \"1762204418\",\n        \"destination\": {\"kind\": \"region\", \"region\": \"europe\"}, \"environment\": \"staging\"}}),\n    )\n    .await\n    .expect(\"begun\");\n    let s = serde_json::to_value(desk.setup()).expect(\"json\");\n    // The rail's context line and the Tenant card.\n    assert_eq!(s[\"tenant\"][\"label\"], \"Northwind Health\");\n    assert_eq!(s[\"tenant\"][\"tsgId\"], \"1762204418\");\n    assert_eq!(s[\"tenant\"][\"environment\"], \"staging\");\n    assert_eq!(s[\"tenant\"][\"destination\"][\"region\"], \"europe\");\n    // First run: the scan key card is Required, the management card Optional (the core says which).\n    assert_eq!(s[\"scanRequired\"], true);\n    assert_eq!(s[\"tenant\"][\"scan\"][\"state\"], \"missing\");\n    assert_eq!(s[\"tenant\"][\"management\"][\"state\"], \"missing\");\n    // The product cards: Runtime always on; the packs rows with their counts.\n    assert_eq!(s[\"products\"], json!([\"runtimeSecurity\"]));\n    let packs = s[\"packs\"].as_array().expect(\"packs\");\n    assert!(\n        packs\n            .iter()\n            .any(|p| p[\"product\"] == \"runtimeSecurity\" && p[\"count\"].as_u64().unwrap_or(0) > 0),\n        \"{packs:?}\"\n    );\n    // Before any run the footer's primary on Verify is closed.\n    assert!(s[\"verify\"].is_null());\n    assert_eq!(s[\"completable\"], false);\n    // Choosing a product is recorded in the core as the card toggles.\n    let context = desk.setup().context.as_str().to_owned();\n    desk.send(json!({\"kind\": \"chooseSetupProducts\", \"context\": context, \"products\": [\"runtimeSecurity\", \"gateway\"]}))\n        .await\n        .expect(\"products\");\n    assert_eq!(\n        desk.setup().products,\n        vec![ProductId::RuntimeSecurity, ProductId::Gateway]\n    );\n    // The Checks card: one line per credential and chosen product, and the two unavailable products.\n    let context = desk.setup().context.as_str().to_owned();\n    desk.send(json!({\"kind\": \"verifyTenantSetup\", \"context\": context}))\n        .await\n        .expect(\"verify\");\n    let v = desk.verified().await;\n    let lines: Vec<VerifyLine> = v.steps.iter().map(|s| s.line).collect();\n    for line in [\n        VerifyLine::ScanKey,\n        VerifyLine::ManagementClient,\n        VerifyLine::Gateway,\n        VerifyLine::Ais,\n        VerifyLine::Aes,\n    ] {\n        assert!(lines.contains(&line), \"{lines:?}\");\n    }\n    assert!(\n        v.steps\n            .iter()\n            .filter(|s| matches!(s.line, VerifyLine::Ais | VerifyLine::Aes))\n            .all(|s| s.state == VerifyState::Unavailable)\n    );\n    // Without a scan key on first run the run fails and the footer's primary stays closed.\n    assert!(v.failed && v.blocking);\n    assert!(!desk.setup().completable);\n}\n\n#[tokio::test]\nasync fn add_mode_has_no_required_scan_key_and_the_sheet_discards_its_draft_on_cancel() {\n    let mut desk = Desk::new();\n    desk.send(json!({\"kind\": \"setUiVariant\", \"variant\": \"v2\"}))\n        .await\n        .expect(\"v2\");\n    desk.send(json!({\"kind\": \"setOnboarding\", \"state\": \"done\"}))\n        .await\n        .expect(\"done\");\n    desk.send(\n        json!({\"kind\": \"beginTenantSetup\", \"mode\": \"add\", \"profile\": {\n        \"label\": \"Coastal Bank\", \"tsgId\": \"1001464285\",\n        \"destination\": {\"kind\": \"region\", \"region\": \"unitedStates\"}, \"environment\": \"production\"}}),\n    )\n    .await\n    .expect(\"begun\");\n    let s = serde_json::to_value(desk.setup()).expect(\"json\");\n    assert_eq!(s[\"mode\"], \"add\");\n    // The add sheet's scan card is Optional.\n    assert_eq!(s[\"scanRequired\"], false);\n    assert!(desk.snap().tenants.is_empty(), \"a draft is not a tenant\");\n    // Cancel discards the draft in the core; the shell is untouched.\n    let context = desk.setup().context.as_str().to_owned();\n    desk.send(json!({\"kind\": \"discardTenantSetup\", \"context\": context}))\n        .await\n        .expect(\"discarded\");\n    assert!(desk.snap().setup.is_none());\n    assert!(desk.snap().tenants.is_empty());\n}\n            .find(|l| &l.tenant == tenant)\n            .ok_or(Refusal::CapabilityMissing)?;\n        match library.state {\n            LibraryState::Ready => {\n                library.act();\n                Ok(library)\n            }\n            LibraryState::Loading => Err(Refusal::Busy),\n            _ => Err(Refusal::CapabilityMissing),\n        }\n    }\n\n    /// Starts opening `tenant`'s library unless it is open or opening;\n    /// returns the load lease.\n    fn start_library(&mut self, tenant: &TenantId) -> Option<u64> {\n        if self.libraries.iter().any(|l| {\n            &l.tenant == tenant && matches!(l.state, LibraryState::Loading | LibraryState::Ready)\n        }) {\n            return None;\n        }\n        let lease = self.lease();\n        let pending = self\n            .libraries\n            .iter_mut()\n            .find(|l| &l.tenant == tenant)\n            .map(|l| std::mem::take(&mut l.pending))\n            .unwrap_or_default();\n        self.libraries.retain(|l| &l.tenant != tenant);\n        let mut library = Library::new(tenant.clone(), lease);\n        library.pending = pending;\n        self.libraries.push(library);\n        Some(lease)\n    }\n\n    pub(super) fn open_library(&mut self, context: &ContextRef) -> Result<Option<u64>, Refusal> {\n        let tenant = self.check_context(context)?;\n        self.library_root\n            .as_ref()\n            .ok_or(Refusal::CapabilityMissing)?;\n        Ok(self.start_library(&tenant))\n    }\n\n    pub(super) fn library_load_target(&self, lease: u64) -> Option<(std::path::PathBuf, String)> {\n        let library = self.libraries.iter().find(|l| l.lease == lease)?;\n        Some((\n            self.library_root.clone()?,\n            library.tenant.as_str().to_owned(),\n        ))\n    }\n\n    /// Settles a load. Additions made meanwhile are merged (all or none)\n    /// and need a write; their originators hear how they ended.\n    pub(super) fn settle_library(\n        &mut self,\n        lease: u64,\n        loaded: Result<CaseLibrary, LibraryFailure>,\n    ) -> Option<(TenantId, u64)> {\n        let library = self\n            .libraries\n            .iter_mut()\n            .find(|l| l.lease == lease && l.state == LibraryState::Loading)?;\n        let pending = std::mem::take(&mut library.pending);\n        let (write, failed) = match loaded {\n            Ok(cases) => {\n                library.library = cases;\n                library.state = LibraryState::Ready;\n                if pending.is_empty() {\n                    return None;\n                }\n                let cases = pending.iter().map(|p| p.case.clone()).collect();\n                match library.library.merge(cases) {\n                    Ok(_) => {\n                        library.generation += 1;\n                        let generation = library.generation;\n                        for p in &pending {\n                            library.outcomes.push(Outcome {\n                                generation,\n                                origin: p.origin.clone(),\n                                notice: p.notice.clone(),\n                                stamp: p.stamp,\n                            });\n                        }\n                        (Some((library.tenant.clone(), generation)), None)\n                    }\n                    Err(problem) => (None, Some(problem)),\n                }\n            }\n            Err(failure) => {\n                library.state = LibraryState::Failed;\n                library.failure = Some(failure);\n                (None, Some(CaseProblem::NotSaved))\n            }\n        };\n        if let Some(problem) = failed {\n            for p in pending {\n                self.deliver(&p.origin, p.stamp, Err(problem));\n            }\n        }\n        write\n    }\n\n    fn changed_library(library: &mut Library) -> (TenantId, u64) {\n        library.problem = None;\n        library.generation += 1;\n        (library.tenant.clone(), library.generation)\n    }\n\n    /// Saves a new case authored from `draft`. A library that is not open\n    /// yet opens, and the case is added when it does (its write follows).\n    pub(super) fn save_case(\n        &mut self,\n                .map(starter_packs);\n        self.add_examples(&tenant, parsed)\n    }\n\n    /// Starts reading the public catalog; returns the lease and its URL.\n    /// Imports the bundled examples of `products` into `tenant`'s library\n    /// (C29 starter packs). An open library takes them now (returns the\n    /// write); otherwise they wait for the load this starts (returns its\n    /// lease) and are merged when it settles.\n    pub(super) fn queue_examples(\n        &mut self,\n        tenant: &TenantId,\n        products: &[CaseProduct],\n    ) -> (Option<u64>, Option<(TenantId, u64)>) {\n        let Ok(cases) =\n            crate::library::parse_catalog(crate::library::BUNDLED_CATALOG, tenant.as_str())\n        else {\n            return (None, None);\n        };\n        let cases: Vec<TestCase> = starter_packs(cases)\n            .into_iter()\n            .filter(|c| products.contains(&c.product))\n            .collect();\n        if cases.is_empty() || self.library_root.is_none() {\n            return (None, None);\n        }\n        if self\n            .libraries\n            .iter()\n            .any(|l| &l.tenant == tenant && l.state == LibraryState::Ready)\n        {\n            let write = self.add_examples(tenant, Ok(cases)).ok();\n            return (None, write);\n        }\n        let added = cases.len() as u32;\n        let lease = self.start_library(tenant);\n        if let Some(library) = self.libraries.iter_mut().find(|l| &l.tenant == tenant) {\n            for case in cases {\n                library.pending.push(Pending {\n                    case,\n                    origin: tenant.clone(),\n                    notice: LibraryNotice::ExamplesAdded { added },\n                    stamp: library.status,\n                });\n            }\n        }\n        (lease, None)\n    }\n\n    pub(super) fn begin_catalog(\n        &mut self,\n        context: &ContextRef,\n    ) -> Result<(u64, url::Url), Refusal> {\n        let tenant = self.check_context(context)?;\n        let url = self.case_catalog.clone();\n        if !crate::library::catalog_url_ok(&url, &url) {\n            return Err(Refusal::CapabilityMissing);\n        }\n        let lease = self.lease();\n        let library = self.library_mut(&tenant)?;\n        if library.fetching.is_some() {\n            return Err(Refusal::Busy);\n        }\n        library.fetching = Some(lease);\n        library.notice = None;\n        library.problem = None;\n        Ok((lease, url))\n    }\n\n    pub(super) fn settle_catalog(\n        &mut self,\n        lease: u64,\n        fetched: Option<Vec<u8>>,\n    ) -> Option<(TenantId, u64)> {\n        let library = self\n            .libraries\n            .iter_mut()\n            .find(|l| l.fetching == Some(lease))?;\n        library.fetching = None;\n        let tenant = library.tenant.clone();\n        let Some(bytes) = fetched else {\n            library.act();\n            library.notice = Some(LibraryNotice::CatalogUnavailable);\n            return None;\n        };\n        let parsed = crate::library::parse_catalog(&bytes, tenant.as_str());\n1041:    /// operator's resolution (I1); the snapshot's `switch_blocked` says which.\n1247:    pub switch_blocked: Option<SwitchBlocked>,\n1793:    switch_blocked: Option<SwitchBlocked>,\n1871:    fn onboarding(&self) -> features::OnboardingState {\n1920:            switch_blocked: self.switch_blocked.clone(),\n2163:        if self.switch_blocked.as_ref().is_some_and(|guard| {\n2170:            self.switch_blocked = None;\n2179:    fn reissue_context(&mut self) -> Vec<runtime::Start> {\n2180:        self.switch_blocked = None;\n2532:    fn save_with(&mut self, before: &Data) -> Result<(), Refusal> {\n2909:            switch_blocked: None,\n3862:            state.switch_blocked = None;\n","exit_code":0,"status":"completed"}}
