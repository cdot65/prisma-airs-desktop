{"type":"item.completed","item":{"id":"item_61","type":"command_execution","command":"/bin/zsh -lc \"rg -n '\"'^pub fn tree_hash|fn file_entry|fn inventory_hash|fn collect|pub fn'\"' crates/xtask/src/fingerprint.rs; sed -n '20,195p' crates/xtask/src/fingerprint.rs; sed -n '5750,5950p' crates/desktop-core/src/authority.rs\"","aggregated_output":"48:pub fn is_excluded(path: &str) -> bool {\n59:pub fn source_inventory(repo: &Repo) -> Result<Vec<FileEntry>> {\n94:fn file_entry(root: &Path, relative: &str) -> Result<FileEntry> {\n120:pub fn inventory_hash(entries: &[FileEntry]) -> String {\n128:pub fn source(repo: &Repo) -> Result<String> {\n133:pub fn tree_hash(dir: &Path) -> Result<String> {\n138:pub fn tree_hash_excluding(dir: &Path, skip: &[&str]) -> Result<String> {\n145:fn collect_tree(root: &Path, dir: &Path, skip: &[&str], out: &mut Vec<FileEntry>) -> Result<()> {\n172:pub fn dependencies(repo: &Repo, toolchain_hash: &str) -> Result<String> {\n213:pub fn build_flags(repo: &Repo, manifest: &Manifest, subject: Subject) -> Result<String> {\n275:pub fn evidence(repo: &Repo, subject: Subject) -> Result<String> {\n284:pub fn all(\n329:pub fn consumed_shared(repo: &Repo) -> Result<Vec<(String, String)>> {\n378:pub fn academy_consumer_hash(dir: &Path) -> Result<String> {\n394:pub fn verify_consumed_shared(repo: &Repo) -> Result<()> {\nuse crate::{Repo, Result, Subject, invalid, io_err, sha256_hex};\n\n/// Mutable locations excluded from the source fingerprint. Each is hashed\n/// independently (evidence fingerprint, receipts) so exclusion cannot hide\n/// application sources, lockfiles, tests or configuration.\npub const SOURCE_EXCLUSIONS: [&str; 3] = [\n    \"docs/planning/status.md\",\n    \"docs/planning/reviews/\",\n    \"docs/planning/evidence/\",\n];\n\n#[derive(Clone, Debug, PartialEq, Eq, Serialize, Deserialize)]\n#[serde(deny_unknown_fields)]\npub struct Fingerprints {\n    pub source: String,\n    pub dependencies: String,\n    pub build_flags: String,\n    pub evidence: String,\n}\n\n/// One entry of the source inventory.\n#[derive(Clone, Debug, PartialEq, Eq, Serialize, Deserialize)]\npub struct FileEntry {\n    pub path: String,\n    pub mode: String,\n    pub sha256: String,\n}\n\npub fn is_excluded(path: &str) -> bool {\n    SOURCE_EXCLUSIONS.iter().any(|excluded| {\n        if excluded.ends_with('/') {\n            path.starts_with(excluded)\n        } else {\n            path == *excluded\n        }\n    })\n}\n\n/// Lists source files via git: tracked plus untracked files not ignored.\npub fn source_inventory(repo: &Repo) -> Result<Vec<FileEntry>> {\n    let output = Command::new(\"/usr/bin/git\")\n        .args([\n            \"ls-files\",\n            \"-z\",\n            \"--cached\",\n            \"--others\",\n            \"--exclude-standard\",\n        ])\n        .current_dir(repo.root())\n        .env_clear()\n        .env(\"PATH\", \"/usr/bin:/bin\")\n        .env(\"HOME\", std::env::var(\"HOME\").unwrap_or_default())\n        .output()\n        .map_err(io_err(repo.root()))?;\n    if !output.status.success() {\n        return Err(invalid(\"git ls-files failed\"));\n    }\n    let mut paths: Vec<String> = output\n        .stdout\n        .split(|b| *b == 0)\n        .filter(|p| !p.is_empty())\n        .map(|p| String::from_utf8_lossy(p).into_owned())\n        .filter(|p| !is_excluded(p))\n        .collect();\n    paths.sort();\n    paths.dedup();\n    let mut entries = Vec::with_capacity(paths.len() + 1);\n    for path in paths {\n        entries.push(file_entry(repo.root(), &path)?);\n    }\n    entries.push(file_entry(repo.root(), \".git/config\")?);\n    Ok(entries)\n}\n\nfn file_entry(root: &Path, relative: &str) -> Result<FileEntry> {\n    let full = root.join(relative);\n    let Ok(meta) = std::fs::symlink_metadata(&full) else {\n        return Ok(FileEntry {\n            path: relative.to_owned(),\n            mode: \"deleted\".to_owned(),\n            sha256: String::new(),\n        });\n    };\n    if meta.file_type().is_symlink() {\n        let target = std::fs::read_link(&full).map_err(io_err(&full))?;\n        return Ok(FileEntry {\n            path: relative.to_owned(),\n            mode: \"symlink\".to_owned(),\n            sha256: sha256_hex(target.as_os_str().as_encoded_bytes()),\n        });\n    }\n    let bytes = std::fs::read(&full).map_err(io_err(&full))?;\n    let executable = meta.permissions().mode() & 0o111 != 0;\n    Ok(FileEntry {\n        path: relative.to_owned(),\n        mode: if executable { \"100755\" } else { \"100644\" }.to_owned(),\n        sha256: sha256_hex(&bytes),\n    })\n}\n\npub fn inventory_hash(entries: &[FileEntry]) -> String {\n    let text: String = entries\n        .iter()\n        .map(|e| format!(\"{}\\0{}\\0{}\\n\", e.path, e.mode, e.sha256))\n        .collect();\n    sha256_hex(text.as_bytes())\n}\n\npub fn source(repo: &Repo) -> Result<String> {\n    Ok(inventory_hash(&source_inventory(repo)?))\n}\n\n/// Hash of every regular file under a directory (relative paths, sorted).\npub fn tree_hash(dir: &Path) -> Result<String> {\n    tree_hash_excluding(dir, &[])\n}\n\n/// Like [`tree_hash`], skipping directories with the given names.\npub fn tree_hash_excluding(dir: &Path, skip: &[&str]) -> Result<String> {\n    let mut entries = Vec::new();\n    collect_tree(dir, dir, skip, &mut entries)?;\n    entries.sort_by(|a, b| a.path.cmp(&b.path));\n    Ok(inventory_hash(&entries))\n}\n\nfn collect_tree(root: &Path, dir: &Path, skip: &[&str], out: &mut Vec<FileEntry>) -> Result<()> {\n    let mut children: Vec<_> = std::fs::read_dir(dir)\n        .map_err(io_err(dir))?\n        .filter_map(|e| e.ok())\n        .collect();\n    children.sort_by_key(|e| e.file_name());\n    for child in children {\n        let path = child.path();\n        let relative = path\n            .strip_prefix(root)\n            .map_err(|_| invalid(\"path escaped its root\"))?\n            .to_string_lossy()\n            .into_owned();\n        let meta = std::fs::symlink_metadata(&path).map_err(io_err(&path))?;\n        if meta.is_dir() {\n            if skip.iter().any(|name| child.file_name() == *name) {\n                continue;\n            }\n            collect_tree(root, &path, skip, out)?;\n        } else {\n            out.push(file_entry(root, &relative)?);\n        }\n    }\n    Ok(())\n}\n\n/// Dependency inputs: lockfiles, toolchain pin, immutable inputs, tools.\npub fn dependencies(repo: &Repo, toolchain_hash: &str) -> Result<String> {\n    let mut parts: BTreeMap<String, String> = BTreeMap::new();\n    for file in [\n        \"Cargo.lock\",\n        \"pnpm-lock.yaml\",\n        \"rust-toolchain.toml\",\n        \".npmrc\",\n        \"docs/architecture/inputs.lock.json\",\n    ] {\n        let path = repo.join(file);\n        let digest = match std::fs::read(&path) {\n            Ok(bytes) => sha256_hex(&bytes),\n            Err(_) => \"absent\".to_owned(),\n        };\n        parts.insert(file.to_owned(), digest);\n    }\n    let inputs = repo.join(\".inputs\");\n    if inputs.is_dir() {\n        let mut names: Vec<_> = std::fs::read_dir(&inputs)\n            .map_err(io_err(&inputs))?\n            .filter_map(|e| e.ok())\n            .filter(|e| e.path().is_dir())\n            .map(|e| e.file_name().to_string_lossy().into_owned())\n            .collect();\n        Ok(mut state) => {\n            let now = Instant::now();\n            if let Some(stop) = stop {\n                state.operations.cancel(id, stop, now);\n            }\n            let starts = state.operations.complete(id, outcome, now);\n            state.sync_scans();\n            state.changed();\n            let mut effects = vec![Effect::Start(starts)];\n            effects.extend(state.take_case_writes());\n            effects.extend(gateway_local_effects(&mut state));\n            effects\n        }\n        Err(_) => return,\n    };\n    run_effects(inner, effects);\n}\n\n/// Gateway work to keep on this Mac after settlements: the newest writes,\n/// and reads of books that settlements wait for.\nfn gateway_local_effects(state: &mut State) -> Vec<Effect> {\n    let (writes, reads) = state.take_gateway_local();\n    writes\n        .into_iter()\n        .map(|(tenant, generation)| Effect::StoreGatewayLocal { tenant, generation })\n        .chain(\n            reads\n                .into_iter()\n                .map(|lease| Effect::LoadGatewayLocal { lease }),\n        )\n        .collect()\n}\n\n/// Stores a new credential of `class` for the active tenant, replacing any\n/// previous one of that class (the other class is untouched). The record is\n/// written ahead into the cleanup ledger and its secret stored only once\n/// that entry is durable.\n#[allow(clippy::too_many_arguments)]\nfn configure_credential(\n    state: &mut State,\n    session: &Arc<SessionVault>,\n    effects: &mut Vec<Effect>,\n    context: &ContextRef,\n    class: CredentialClass,\n    mode: StorageMode,\n    key: EnteredSecret,\n    client_id: Option<String>,\n    inference: Option<crate::gateway_inference::InferenceTarget>,\n) -> Result<(), Refusal> {\n    let tenant = state.check_context(context)?;\n    if mode == StorageMode::Keychain {\n        state.require_storage()?;\n    } else if state.storage == StorageHealth::Resetting {\n        return Err(Refusal::Busy);\n    }\n    let current = state.tenant(&tenant).ok_or(Refusal::StaleContext)?;\n    if matches!(current.capability(class), ScanCapability::Storing { .. }) {\n        return Err(Refusal::Busy);\n    }\n    let record = RecordId::issue().ok_or(Refusal::ShuttingDown)?;\n    let lease = state.lease();\n    let before = state.data.clone();\n    let retired_session = state.retire_class(&tenant, class);\n    if let Some(t) = state.tenant_mut(&tenant) {\n        *t.capability_mut(class) = ScanCapability::Storing {\n            lease,\n            record: record.clone(),\n            mode,\n        };\n        if class == CredentialClass::Management {\n            t.management_client = client_id;\n        }\n        if class == CredentialClass::Inference {\n            t.inference_target = inference;\n        }\n    }\n    if mode == StorageMode::Keychain {\n        // Write-ahead: the new record is in the cleanup ledger until\n        // it is committed, so a crash never leaves an untracked item.\n        state.data.pending_cleanup.push(record.clone());\n    }\n    if state.storage == StorageHealth::Ready {\n        state.save_with(&before)?;\n    }\n    if let Some(old) = retired_session {\n        let _ = session.delete(&old);\n    }\n    // A Keychain secret may be written only once its write-ahead\n    // ledger entry is confirmed durable: if a crash could restore a\n    // document without that entry, the secret would be untracked.\n    // The retirement of the previous key stays visible either way.\n    let authorized =\n        mode == StorageMode::Session || !state.durability_unconfirmed || state.confirm_durable();\n    // An inference key is not part of the tenant context: replacing it\n    // stops only the run that used the old one (reviews, reads and the\n    // workspace choice are untouched).\n    if class == CredentialClass::Inference {\n        effects.push(Effect::Start(state.retire_inference(&tenant)));\n    } else if state.data.active.as_ref() == Some(&tenant) {\n        effects.push(Effect::Start(state.reissue_context()));\n    } else if state.is_setup_tenant(&tenant) {\n        // A draft under setup (C29) has its own context: replacing its\n        // credential retires that context (and the binding cached under it)\n        // without touching the shell's active context.\n        state.reissue_setup_context();\n    }\n    if authorized {\n        if mode == StorageMode::Keychain {\n            state.writes_in_flight.push(record.clone());\n        }\n        effects.push(Effect::Store {\n            tenant,\n            class,\n            lease,\n            record,\n            mode,\n            key,\n        });\n    } else if let Some(t) = state.tenant_mut(&tenant) {\n        // Nothing was written; the ledger entry settles as absent.\n        *t.capability_mut(class) = ScanCapability::Failed {\n            mode,\n            failure: VaultError::Unavailable,\n        };\n    }\n    effects.push(Effect::Cleanup);\n    state.changed();\n    Ok(())\n}\n\n/// Signs the active tenant's `class` capability out (the other class is\n/// untouched).\n/// The native confirmation's private completion: never reachable from the\n/// renderer (it is the adapter future's own result).\nfn settle_confirmation(inner: &Arc<Inner>, review: &ReviewId, nonce: u64, accepted: bool) {\n    let starts = match lock(inner) {\n        Ok(mut state) => {\n            let starts = state.settle_confirmation(\n                review,\n                nonce,\n                accepted,\n                Arc::clone(&inner.adapters.keychain),\n                Arc::clone(&inner.session),\n            );\n            state.changed();\n            starts\n        }\n        Err(_) => return,\n    };\n    run_effects(inner, vec![Effect::Start(starts)]);\n}\n\nfn remove_credential(\n    state: &mut State,\n    session: &Arc<SessionVault>,\n    effects: &mut Vec<Effect>,\n    context: &ContextRef,\n    class: CredentialClass,\n) -> Result<(), Refusal> {\n    let tenant = state.check_context(context)?;\n    let has_keychain = matches!(\n        state.tenant(&tenant).map(|t| t.capability(class)),\n        Some(ScanCapability::Ready {\n            mode: StorageMode::Keychain,\n            ..\n        })\n    );\n    if has_keychain {\n        state.require_storage()?;\n    }\n    let before = state.data.clone();\n    let retired_session = state.retire_class(&tenant, class);\n    if state.storage == StorageHealth::Ready {\n        state.save_with(&before)?;\n    }\n    if let Some(old) = retired_session {\n        let _ = session.delete(&old);\n    }\n    if class == CredentialClass::Inference {\n        effects.push(Effect::Start(state.retire_inference(&tenant)));\n    } else if state.data.active.as_ref() == Some(&tenant) {\n        effects.push(Effect::Start(state.reissue_context()));\n    } else if state.is_setup_tenant(&tenant) {\n        state.reissue_setup_context();\n    }\n    effects.push(Effect::Cleanup);\n    state.changed();\n    Ok(())\n}\n\nfn settle_store(\n    inner: &Arc<Inner>,\n    tenant: &TenantId,\n    class: CredentialClass,\n    lease: u64,\n    record: RecordId,\n    mode: StorageMode,\n    result: Result<(), VaultError>,\n) {\n    let Ok(mut state) = lock(inner) else {\n        return;\n","exit_code":0,"status":"completed"}}
