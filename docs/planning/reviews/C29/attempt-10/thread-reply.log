'] > nav > ol button {\n        width: auto;\n        height: 32px !important;\n        padding: 0 6px !important;\n        gap: 0 !important;\n    }\n    [data-slot='wizard'] > nav > ol button > span:not(:first-child) {\n        position: absolute;\n        width: 1px;\n        height: 1px;\n        overflow: hidden;\n        clip: rect(0 0 0 0);\n        white-space: nowrap;\n    }\n    [data-slot='wizard'] > nav > [data-slot='privacy-note'] {\n        display: none;\n    }\n    [data-slot='wizard'] > nav > [data-slot='theme-button'] {\n        margin-top: 6px !important;\n    }\n    [data-slot='wizard'] main .grid {\n        grid-template-columns: minmax(0, 1fr) !important;\n    }\n    /* The strip drops the brand row (the sheet is already named), and the footer's hint or status keeps to two\n       lines: at 900×600 and 200% the add sheet is 279 CSS px tall, and a long hint made the footer taller than the\n       sheet, pushing its primary below the window. */\n    [data-slot='wizard'] > nav > div:first-child {\n        display: none;\n    }\n    [data-slot='wizard-footer'] [data-slot='wizard-status'] > span {\n        display: -webkit-box;\n        -webkit-line-clamp: 2;\n        -webkit-box-orient: vertical;\n        overflow: hidden;\n\n    useEffect(() => {\n        opener.current = document.activeElement instanceof HTMLElement ? document.activeElement : null\n        pushModal(id)\n        return () => {\n            popModal(id)\n            // After the commit: the page behind is still inert during cleanup,\n            // and an inert ancestor refuses focus (observed in WebKit).\n            const target = returnRef.current ?? opener.current\n            queueMicrotask(() => {\n                // Only when nothing else took focus meanwhile (⌘T replacing the\n                // palette hands focus to the tenant list, which must keep it).\n                const active = document.activeElement\n                if (active && active !== document.body) return\n                // The opener may be gone (a \"Finish rotation…\" that completed):\n                // focus the page heading rather than leave it on nothing.\n                if (target?.isConnected) target.focus()\n                else document.querySelector<HTMLElement>('main h1[tabindex=\"-1\"]')?.focus()\n            })\n        }\n    }, [id, pushModal, popModal])\n\n    useEffect(() => {\n        // Initial focus goes into the dialog once, when it opens. Regaining the\n        // top after a higher dialog closes must not refocus: that dialog is\n        // restoring its own opener, which may be any control here.\n        if (!topmost || focusedOnce.current) return\n        const node = dialog.current\n        if (!node) return\n        focusedOnce.current = true\n        if (!node.contains(document.activeElement)) {\n            // A declared initial control first (wherever it sits), else the first focusable.\n            const first = node.querySelector<HTMLElement>('[autofocus]') ?? node.querySelector<HTMLElement>(FOCUSABLE)\n            ;(first ?? node).focus()\n        }\n    }, [topmost])\n\n    // Escape still closes the topmost dialog when focus has left it (a\n    // native sheet returning focus to the page body, a click on the scrim's\n    // edge): the dialog's own handler stops the event first when it has focus.\n    const closeRef = useRef(onClose)\n    closeRef.current = onClose\n    useEffect(() => {\n        if (!topmost) return\n        const onWindowKey = (event: globalThis.KeyboardEvent) => {\n            if (event.key !== 'Escape' || event.defaultPrevented) return\n            const node = dialog.current\n            if (node && node.contains(document.activeElement)) return\n            event.preventDefault()\n            closeRef.current()\n        }\n        window.addEventListener('keydown', onWindowKey)\n        return () => window.removeEventListener('keydown', onWindowKey)\n    }, [topmost])\n\n    const onKeyDown = (event: KeyboardEvent<HTMLDivElement>) => {\n        if (!topmost) return\n        if (event.key === 'Escape') {\n            event.preventDefault()\n            event.stopPropagation()\n            onClose()\n            return\n        }\n        if (event.key === 'Tab') {\n            // Keyboard interaction stays inside the topmost dialog.\n            const node = dialog.current\n            if (!node) return\n            const items = Array.from(node.querySelectorAll<HTMLElement>(FOCUSABLE)).filter((el) => !el.hasAttribute('hidden') && el.getAttribute('aria-hidden') !== 'true')\n            if (items.length === 0) {\n                event.preventDefault()\n                node.focus()\n                return\n            }\n            const first = items[0] as HTMLElement\n            const last = items[items.length - 1] as HTMLElement\n            const active = document.activeElement\n            if (event.shiftKey && (active === first || active === node)) {\n                event.preventDefault()\n                last.focus()\n            } else if (!event.shiftKey && active === last) {\n                event.preventDefault()\n                first.focus()\n            }\n        }\n    }\n\n    return (\n        <div\n            className={sheet ? 'fixed z-50 flex justify-end' : 'fixed inset-0 z-50 grid place-items-start justify-center'}\n            style={sheet ? { inset: 'var(--v2-header, 56px) 0 0 0' } : { paddingTop: top ?? '4vh' }}\n            data-v2-scrim=''\n36:export class DeliveryOutcomeUnknown extends Error {\n42:        this.name = 'DeliveryOutcomeUnknown'\n3019:    onSnapshot(snapshot: ShellSnapshot): void\n3046:    dispatch(intent: Intent): Promise<DispatchResponse> {\n3164:        throw new DeliveryOutcomeUnknown(intent.kind)\n3191:            observer.onSnapshot(snapshot)\n    if (value.kind === 'invalid') return isFieldProblem(value.problem)\n    return oneOf(SAVE_REFUSALS, value.kind)\n}\n\n// ---- API Client execution (C15)\n\nconst RUN_ID = /^run-[0-9a-f]{16}$/\nconst RUN_STATES: readonly string[] = ['running', 'completed', 'failed', 'cancelled', 'interrupted']\nconst RUN_FAILURES: readonly string[] = ['timeout', 'connect', 'tls', 'request', 'token', 'tooLarge', 'storage', 'redirect', 'retired']\nconst CREDENTIAL_CLASSES: readonly string[] = ['anonymous', 'workbench', 'managed']\nconst NETWORKS: readonly string[] = ['live', 'loopbackOnly', 'disabled']\nconst SECRET_FAILURES: readonly string[] = ['missing', 'locked', 'denied', 'invalid']\nconst BODY_PROBLEMS: readonly string[] = ['missing', 'tooLarge', 'unsaved']\nconst EXPORT_FAILURES: readonly string[] = ['destination', 'body', 'io']\nconst SEND_REFUSALS: readonly string[] = [\n    'url', 'network', 'mixedCredentials', 'managedPlacement', 'ambiguousCredential', 'noTenant', 'tokenDestination',\n    'requestDestination', 'notHttps', 'unknownEndpoint', 'busy', 'stale', 'reviewMissing', 'reviewStale', 'reviewExpired',\n    'reviewConsumed', 'declined', 'private',\n]\nconst RENDER_PROBLEMS: readonly string[] = ['unclosed', 'secretInName', 'name', 'url', 'auth', 'multipartContentType']\n\nfunction isRenderProblem(value: unknown): boolean {\n    if (!isRecord(value)) return false\n    if (value.kind === 'field') return isFieldProblem(value.problem)\n    if (value.kind === 'unresolved' || value.kind === 'nested') return isString(value.name)\n    return oneOf(RENDER_PROBLEMS, value.kind)\n}\n\nfunction isSendRefusal(value: unknown): boolean {\n    if (!isRecord(value)) return false\n    switch (value.kind) {\n        case 'render':\n            return isRenderProblem(value.problem)\n        case 'unknownManagedReference':\n            return isString(value.reference)\n        case 'secret':\n            return isString(value.reference) && oneOf(SECRET_FAILURES, value.failure)\n        case 'body':\n            return oneOf(BODY_PROBLEMS, value.problem)\n    }\n    return oneOf(SEND_REFUSALS, value.kind)\n}\n\nfunction isRunRecord(value: unknown): boolean {\n    return (\n        isRecord(value) &&\n        typeof value.id === 'string' &&\n        RUN_ID.test(value.id) &&\n        typeof value.request === 'string' &&\n        DOCUMENT_ID.test(value.request) &&\n        isRelative(value.relative) &&\n        isCount(value.at) &&\n        isString(value.method) &&\n        isString(value.url) &&\n        oneOf(CREDENTIAL_CLASSES, value.class) &&\n        optional(isString, value.operation) &&\n        oneOf(RUN_STATES, value.state) &&\n        optional((f) => oneOf(RUN_FAILURES, f), value.failure) &&\n        typeof value.uncertain === 'boolean' &&\n        optional((s) => isCount(s) && (s as number) < 1000, value.status) &&\n        Array.isArray(value.headers) &&\n        value.headers.every(isPair) &&\n        optional(isString, value.redirect) &&\n        isCount(value.elapsedMs) &&\n        isCount(value.bytes) &&\n        typeof value.stored === 'boolean'\n    )\n}\n\nfunction isRunView(value: unknown): boolean {\n    return (\n        isRecord(value) &&\n        isRunRecord(value.record) &&\n        optional(isString, value.preview) &&\n        isCount(value.previewBytes) &&\n        typeof value.tokenDropped === 'boolean'\n    )\n}\n\nfunction isRunningView(value: unknown): boolean {\n    return (\n        isRecord(value) &&\n        typeof value.run === 'string' &&\n        RUN_ID.test(value.run) &&\n        typeof value.request === 'string' &&\n        DOCUMENT_ID.test(value.request) &&\n        isString(value.method) &&\n        isCount(value.bytes)\n    )\n}\n\nfunction isSendReviewView(value: unknown): boolean {\n    return (\n        isRecord(value) &&\n        typeof value.review === 'string' &&\n        REVIEW_ID.test(value.review) &&\n        typeof value.request === 'string' &&\n        DOCUMENT_ID.test(value.request) &&\n        isString(value.operation) &&\n        isString(value.method) &&\n        isString(value.url) &&\n        Array.isArray(value.headers) &&\n        value.headers.every(isPair) &&\n        isString(value.body) &&\n        isCount(value.bodyBytes) &&\n        isStrings(value.files, isRelative) &&\n        isString(value.destination) &&\n        isCount(value.expires)\n    )\n}\n\nexport function parseWorkbenchResult(value: unknown): WorkbenchResult {\n    if (isRecord(value)) {\n        const valid = (() => {\n            switch (value.kind) {\n                case 'done':\n                case 'cancelled':\n                    return true\n                case 'refused':\n                    return isWorkbenchProblem(value.problem)\n                case 'opened':\n                    return isString(value.name)\n                case 'document':\n                    return isDocumentView(value.document) && Array.isArray(value.notes) && value.notes.every(isImportNote)\n                case 'saved':\n                case 'unchanged':\n                    return isDocumentView(value.document)\n                case 'saveRefused':\n                    return isSaveRefusal(value.refusal)\n                case 'protected':\n                case 'closed':\n                    return typeof value.id === 'string' && DOCUMENT_ID.test(value.id)\n                case 'preview':\n                    return isPreview(value.preview)\n                case 'environment':\n                    return (\n                        isString(value.name) &&\n                        typeof value.private === 'boolean' &&\n                        isString(value.text) &&\n                        optional((r) => typeof r === 'string' && DIGEST.test(r), value.revision)\n                    )\n                case 'schema':\n                    return (\n                        isRecord(value.schema) &&\n                        isRelative(value.schema.relative) &&\n                        isString(value.schema.text) &&\n","exit_code":0,"status":"completed"}}
