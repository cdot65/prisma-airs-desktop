secrets(app),\n        text_files: sheet_picker(\n            root.as_deref(),\n            text_files(app, root.as_deref()),\n            Arc::new(NativeTextPicker { app: app.clone() }),\n        ),\n        offline_root: root.as_ref().map(|r| r.join(\"academy-offline\")),\n        saver: sheet_saver(\n            root.as_deref(),\n            saver(app, root.as_deref()),\n            Arc::new(NativeSaver { app: app.clone() }),\n        ),\n        sessions_root: root.as_ref().map(|r| r.join(\"sessions\")),\n        case_files: sheet_picker(\n            root.as_deref(),\n            case_files(app, root.as_deref()),\n            Arc::new(NativeCasePicker { app: app.clone() }),\n        ),\n        library_root: root.as_ref().map(|r| r.join(\"library\")),\n        folders: folders(app, root.as_deref()),\n        workbench_files: sheet_picker(\n            root.as_deref(),\n            workbench_files(root.as_deref()),\n            Arc::new(NativeExportPicker { app: app.clone() }),\n        ),\n        workbench_root: root.as_ref().map(|r| r.join(\"api-client\")),\n        gateway_files: sheet_picker(\n            root.as_deref(),\n            gateway_files(app, root.as_deref()),\n            Arc::new(NativeUploadPicker { app: app.clone() }),\n        ),\n        harness: harness(app, root.as_deref()),\n        v1_source: v1_source(app),\n        import_root: root.as_ref().map(|r| r.join(\"imports\")),\n        logs_root: logs_root(app, root.as_deref()),\n    }\n}\n\n/// macOS's own logs folder for this app (D051), apart from the work in the\n/// data folder. Fixture builds keep it under their data root, which the\n/// acceptance drivers remove after each run.\n#[cfg(not(feature = \"test-fixtures\"))]\ncrates/desktop-core/src/library.rs:615:    Locked,\ncrates/desktop-core/src/library.rs:626:        VaultError::Locked => LibraryFailure::Locked,\n{\n  \"review\": \"docs/planning/reviews/C30/attempt-11/verdict-returned.json\",\n  \"actual_review_scores\": {\n    \"architecture\": 9,\n    \"behavior\": 8,\n    \"authority_security\": 9,\n    \"validation\": 8,\n    \"overall\": 8\n  },\n  \"d034_accepted\": true,\n  \"accepted_findings\": [\n    \"R1\",\n    \"E1\"\n  ],\n  \"actual_results\": {\n    \"original_G6_four_fault_regressions\": \"0passed/4failed exit101; allfail exact native-guard preservation assertion\",\n    \"corrected_four_fault_regressions\": \"4passed/0failed exit0\",\n    \"strict_clippy\": 0,\n    \"format_check\": 0,\n    \"harness_tools\": \"22/22PASS\",\n    \"onboarding\": \"10/10PASS\",\n    \"setup_reads\": \"5/5PASS\"\n  },\n  \"logs_sha256\": {\n    \"C30-save-failure-fix-01.log\": \"6ce3de0c52cd3f7d08da5378c777414c3464ebedae2c994c1d8dc5ad1df9e0dc\",\n    \"C30-save-failure-original-G6.log\": \"09155fa7a560ca1fb9de2fd70092b1ff051fa75778d4c3dcbc31ec9f175f133a\",\n    \"C30-store-order-harness-setup-01.log\": \"9e0fbc77dd36da3856f1a3a05db1b2d548047fd55792726441427a0c4dbd765b\",\n    \"C30-store-order-clippy-01.log\": \"2f4f616dca75338817f7d380bf494cdcdcf92515142d8fe7525ab358ba031f4d\",\n    \"C30-store-order-fmt-01.log\": \"5fcb04dce61431e03194e48dc201c4f32c352e4a96d055e73ed0191c5364579a\"\n  },\n  \"current_source_sha256\": {\n    \"crates/desktop-core/src/authority.rs\": \"629dec32b59a6b674aa1442ece0e3f44d9b8ab7ba1efd2b5ae1671d9b35899ab\",\n    \"crates/desktop-core/src/authority/inbox_domain.rs\": \"50841eb6f86cdf75ccc18a6a294d73c0caf4ed52616085f63cabfa55c3bf4038\",\n    \"crates/desktop-core/src/authority/setup_domain.rs\": \"882ff459974eea6aa7cd59198f23973754394dc4a7b017848fbee00e8e2c9cb3\",\n    \"crates/desktop-core/tests/harness_tools/main.rs\": \"ad88285ee7ae6b2e3ee1e7828565f50659423fd27483b10f3511eb81a18c287f\"\n  },\n  \"limits\": \"Preflight only, not fresh native/check/independent review qualification. G7/check07/C29attempt10/C30attempt12 and later full9 member/phase gates pending. Zero live calls.\"\n}\n# C30 attempt11 persistence ordering remediation\n\nActual review9/8/9/8/8, no blockers