{"type":"item.started","item":{"id":"item_66","type":"command_execution","command":"/bin/zsh -lc \"sed -n '330,500p' crates/desktop-core/src/authority/management_domain.rs; sed -n '1,125p' apps/desktop/src-tauri/tests/ipc_admission.rs; rg -n 'setup_draft|secret|deny|window|origin' apps/desktop/src-tauri/tests/ipc_admission.rs apps/desktop/src-tauri/src/lib.rs | head -80\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_66","type":"command_execution","command":"/bin/zsh -lc \"sed -n '330,500p' crates/desktop-core/src/authority/management_domain.rs; sed -n '1,125p' apps/desktop/src-tauri/tests/ipc_admission.rs; rg -n 'setup_draft|secret|deny|window|origin' apps/desktop/src-tauri/tests/ipc_admission.rs apps/desktop/src-tauri/src/lib.rs | head -80\"","aggregated_output":"        self.read_part_started(&context);\n        Ok(admitted)\n    }\n\n    /// Delivers settled management results to their single observation.\n    pub(super) fn sync_management_calls(&mut self) {\n        let current = self.active_ref.clone();\n        let mut overviews = Vec::new();\n        let mut parts = Vec::new();\n        let mut key_pages = Vec::new();\n        let mut listings = Vec::new();\n        // A setup's verify reads (C29) belong to the draft's context and\n        // settle into its lines instead of an observation.\n        let setup_context = self.data.setup.as_ref().map(|s| s.context.clone());\n        let setup_operations = self.setup_operations();\n        let mut setup_results = Vec::new();\n        let selected = self.gateway_selection();\n        let setup_selected = self.setup_workspace_reference();\n        for record in self.management_calls.iter_mut().filter(|r| !r.settled) {\n            let settlement = match self.operations.state(&record.operation) {\n                Some(OperationState::Settled(s)) => s,\n                None => Settlement {\n                    outcome: Outcome::Unknown,\n                    stop: None,\n                },\n                Some(_) => continue,\n            };\n            record.settled = true;\n            let reply = record.slot.lock().ok().and_then(|mut s| s.take());\n            let for_setup = setup_operations.contains(&record.operation);\n            // The draft's context stays current for every read admitted under\n            // it (its verify lines and the presentation's own reads, such as\n            // the Gateway workspace listing) until the draft ends.\n            let retired = (current.as_ref() != Some(&record.context)\n                && setup_context.as_ref() != Some(&record.context))\n                || record.workspace.as_ref().is_some_and(|w| {\n                    selected.as_ref() != Some(w) && setup_selected.as_ref() != Some(w)\n                });\n            let result = match (reply, retired, settlement.stop) {\n                // A reply for a retired context is never shown.\n                (_, true, _) | (_, _, Some(_)) | (None, _, _) => ManagementResult::Failed {\n                    failure: ManagementFailure::Cancelled,\n                    outcome: settlement.outcome,\n                },\n                (Some(result), false, None) => result,\n            };\n            if record.overview {\n                overviews.push((record.context.clone(), result.clone()));\n            }\n            if let Some(product) = record.read_part {\n                parts.push((record.context.clone(), product, result.clone()));\n            }\n            if record.api_keys_page && !retired {\n                match &result {\n                    ManagementResult::Page { page } => {\n                        // The whole inventory in one read: the first page,\n                        // and the last.\n                        key_pages.push(KeyRead::Items(\n                            record.context.clone(),\n                            page.items.clone(),\n                            page.offset == 0 && page.complete,\n                        ));\n                    }\n                    ManagementResult::Detail { detail } => match (&detail.found, &detail.item) {\n                        (crate::management::DetailFound::Found, Some(item)) => {\n                            key_pages.push(KeyRead::Items(\n                                record.context.clone(),\n                                format!(\"[{item}]\"),\n                                false,\n                            ));\n                        }\n                        (crate::management::DetailFound::Absent, _) => {\n                            key_pages\n                                .push(KeyRead::Absent(record.context.clone(), detail.id.clone()));\n                        }\n                        _ => {}\n                    },\n                    _ => {}\n                }\n            }\n            if record.lists_workspaces\n                && let ManagementResult::Gateway {\n                    gateway: crate::gateway::GatewayResult::List { list },\n                } = &result\n            {\n                listings.push((record.context.clone(), list.clone()));\n            }\n            if for_setup {\n                // Consumed by the setup; nothing observes it.\n                record.observed = true;\n                setup_results.push((record.operation.clone(), result.clone()));\n            }\n            if let Ok(mut slot) = record.cell.result.lock() {\n                *slot = Some(result);\n            }\n            record.cell.ready.notify_waiters();\n        }\n        for (operation, result) in setup_results {\n            self.setup_settled(&operation, &result);\n        }\n        for (context, result) in overviews {\n            self.overview_settled(&context, result);\n        }\n        for (context, product, result) in parts {\n            self.product_read_settled(&context, product, &result);\n        }\n        for read in key_pages {\n            match read {\n                KeyRead::Items(context, items, whole) => {\n                    if let Ok(tenant) = self.check_context(&context)\n                        && let Ok(items) = serde_json::from_str::<Vec<serde_json::Value>>(&items)\n                    {\n                        self.rotation_reconcile(&tenant, &items, whole);\n                    }\n                }\n                KeyRead::Absent(context, id) => {\n                    if let Ok(tenant) = self.check_context(&context) {\n                        self.rotation_key_absent(&tenant, &id);\n                    }\n                }\n            }\n        }\n        for (context, list) in listings {\n            self.gateway_listed(&context, &list);\n        }\n        let mut settled = 0;\n        let mut keep = vec![true; self.management_calls.len()];\n        for (i, record) in self.management_calls.iter().enumerate().rev() {\n            if record.settled {\n                settled += 1;\n                keep[i] = !record.observed && settled <= RETAINED_RESULTS;\n            }\n        }\n        let mut index = 0;\n        self.management_calls.retain(|_| {\n            index += 1;\n            keep[index - 1]\n        });\n    }\n\n    /// The single observation of a management read's result.\n    pub(super) fn observe_management(\n        &mut self,\n        operation: &OperationId,\n    ) -> Result<ManagementHandle, Refusal> {\n        let (context, workspace) = self\n            .management_calls\n            .iter()\n            .find(|r| &r.operation == operation && !r.observed)\n            .map(|r| (r.context.clone(), r.workspace.clone()))\n            .ok_or(Refusal::InvalidInput)?;\n        // A result whose context (or Gateway workspace choice) retired\n        // before it was observed is withdrawn (it may have settled while it\n        // was current).\n        let current = (self.active_ref.as_ref() == Some(&context)\n            || self.is_setup_context(&context))\n            && self.workspace_current(workspace.as_ref());\n        let record = self\n            .management_calls\n            .iter_mut()\n            .find(|r| &r.operation == operation)\n            .ok_or(Refusal::InvalidInput)?;\n        record.observed = true;\n        if record.settled\n            && !current\n            && let Ok(mut slot) = record.cell.result.lock()\n            && let Some(result) = slot.take()\n        {\n            *slot = Some(withdrawn(result));\n        }\n        let handle = ManagementHandle(Arc::clone(&record.cell));\n//! Production host admission through Tauri's IPC path (mock runtime, real\n//! generated context and capabilities). Literal request/response fixtures are\n//! shared with the TypeScript facade tests.\n\nuse std::path::PathBuf;\n\nuse serde_json::{Value, json};\nuse tauri::ipc::{CallbackFn, InvokeBody};\nuse tauri::test::{INVOKE_KEY, MockRuntime, get_ipc_response, mock_builder};\nuse tauri::webview::InvokeRequest;\nuse tauri::{App, Manager, WebviewUrl, WebviewWindow, WebviewWindowBuilder};\n\nfn fixture(name: &str) -> Value {\n    let path = PathBuf::from(env!(\"CARGO_MANIFEST_DIR\"))\n        .join(\"../../../packages/desktop-contracts/fixtures/wire\")\n        .join(name);\n    serde_json::from_slice(&std::fs::read(&path).expect(\"fixture\")).expect(\"fixture json\")\n}\n\nstruct Harness {\n    app: App<MockRuntime>,\n    main: WebviewWindow<MockRuntime>,\n    adapters: desktop_core::fixtures::Handles,\n}\n\nfn harness() -> Harness {\n    let (core, adapters) = desktop_host::fixture_core();\n    let app = desktop_host::install(mock_builder(), &core)\n        .build(tauri::generate_context!())\n        .expect(\"app builds with the production context\");\n    let main = desktop_host::main_window(&app).expect(\"main window\");\n    Harness {\n        app,\n        main,\n        adapters,\n    }\n}\n\nfn request(cmd: &str, body: InvokeBody, url: &str) -> InvokeRequest {\n    InvokeRequest {\n        cmd: cmd.into(),\n        callback: CallbackFn(0),\n        error: CallbackFn(1),\n        url: url.parse().expect(\"url\"),\n        body,\n        headers: Default::default(),\n        invoke_key: INVOKE_KEY.to_string(),\n    }\n}\n\nconst ORIGIN: &str = \"tauri://localhost\";\n\nfn raw(value: &Value) -> InvokeBody {\n    InvokeBody::Raw(serde_json::to_vec(value).expect(\"bytes\"))\n}\n\nfn call(window: &WebviewWindow<MockRuntime>, cmd: &str, body: InvokeBody) -> Result<Value, Value> {\n    call_from(window, cmd, body, ORIGIN)\n}\n\nfn call_from(\n    window: &WebviewWindow<MockRuntime>,\n    cmd: &str,\n    body: InvokeBody,\n    url: &str,\n) -> Result<Value, Value> {\n    get_ipc_response(window, request(cmd, body, url))\n        .map(|b| b.deserialize::<Value>().expect(\"json response\"))\n}\n\nfn register(h: &Harness) -> String {\n    let response = call(\n        &h.main,\n        \"desktop_observe\",\n        raw(&fixture(\"observe-session-request.json\")),\n    )\n    .expect(\"session\");\n    let template = fixture(\"observe-session-response.json\");\n    assert_eq!(response[\"kind\"], template[\"kind\"]);\n    assert_eq!(response[\"nextSequence\"], template[\"nextSequence\"]);\n    let session = response[\"session\"].as_str().expect(\"session\").to_owned();\n    assert!(\n        session.starts_with(\"ds-\")\n            && session.len() == 35\n            && session[3..].bytes().all(|b| b.is_ascii_hexdigit())\n    );\n    session\n}\n\nfn dispatch(h: &Harness, session: &str, sequence: &str, theme: &str) -> Result<Value, Value> {\n    let mut body = fixture(\"dispatch-request.json\");\n    body[\"session\"] = json!(session);\n    body[\"sequence\"] = json!(sequence);\n    body[\"intent\"][\"theme\"] = json!(theme);\n    call(&h.main, \"desktop_dispatch\", raw(&body))\n}\n\n#[test]\nfn literal_dispatch_round_trip_matches_fixtures() {\n    let h = harness();\n    let session = register(&h);\n    assert_eq!(\n        dispatch(&h, &session, \"1\", \"dark\"),\n        Ok(fixture(\"dispatch-receipt.json\"))\n    );\n}\n\n#[test]\nfn shell_observation_matches_the_literal_snapshot() {\n    let h = harness();\n    let response = call(\n        &h.main,\n        \"desktop_observe\",\n        raw(&fixture(\"observe-shell-request.json\")),\n    )\n    .expect(\"observe\");\n    // The learner reference is salted per launch: check its shape, then\n    // compare everything else literally.\n    let mut response = response;\n    let learner = response[\"snapshot\"][\"learner\"]\n        .as_str()\n        .expect(\"learner\")\n        .to_owned();\n    assert!(\n        learner.len() == 27\napps/desktop/src-tauri/src/lib.rs:3://! The host owns window/origin/schema admission for the two application\napps/desktop/src-tauri/src/lib.rs:4://! commands, the packaged main window and its navigation policy, and native\napps/desktop/src-tauri/src/lib.rs:6://! once and derives the caller principal from the invoking window, never from\napps/desktop/src-tauri/src/lib.rs:27:pub mod clipboard_secret;\napps/desktop/src-tauri/src/lib.rs:39:/// Label of the single packaged window allowed to call application commands.\napps/desktop/src-tauri/src/lib.rs:130:    /// Ends every observation of a webview: used on page reload and window\napps/desktop/src-tauri/src/lib.rs:225:/// Academy origin).\napps/desktop/src-tauri/src/lib.rs:232:/// Builds the packaged main window with its navigation policy: it may only\napps/desktop/src-tauri/src/lib.rs:233:/// display packaged assets; remote navigation, new windows and downloads are\napps/desktop/src-tauri/src/lib.rs:235:pub fn main_window<R: Runtime, M: Manager<R>>(manager: &M) -> tauri::Result<WebviewWindow<R>> {\napps/desktop/src-tauri/src/lib.rs:241:            .on_navigation(is_packaged_origin)\napps/desktop/src-tauri/src/lib.rs:242:            .on_new_window(|_, _| NewWindowResponse::Deny)\napps/desktop/src-tauri/src/lib.rs:262:/// True for the packaged asset origin served by Tauri's custom protocol.\napps/desktop/src-tauri/src/lib.rs:263:pub fn is_packaged_origin(url: &Url) -> bool {\napps/desktop/src-tauri/src/lib.rs:268:/// webview of the main window currently showing packaged content.\napps/desktop/src-tauri/src/lib.rs:270:    if webview.label() != MAIN_WINDOW || webview.window().label() != MAIN_WINDOW {\napps/desktop/src-tauri/src/lib.rs:274:        Ok(url) if is_packaged_origin(&url) => Ok(()),\napps/desktop/src-tauri/src/lib.rs:415:        .on_window_event(|window, event| {