{"type":"item.completed","item":{"id":"item_89","type":"command_execution","command":"/bin/zsh -lc \"rg -n 'wizard|data-mode' apps/desktop/src --glob '*.css'; sed -n '164,245p' apps/desktop/src/v2/wizard/copy.ts; sed -n '105,175p' apps/desktop/src/features/academy/academy-account.tsx\"","aggregated_output":"apps/desktop/src/styles/tokens.css:228:/* The wizard's product cards (C43): the card is a label around a visually hidden native checkbox; the card shows\napps/desktop/src/styles/tokens.css:234:/* The wizard (C43) below 760px (a 900-point window at 200%): the rail is a compact strip above the step (the step\napps/desktop/src/styles/tokens.css:238:    [data-v2-shell] [data-slot='wizard'],\napps/desktop/src/styles/tokens.css:239:    [data-slot='wizard'] {\napps/desktop/src/styles/tokens.css:242:    [data-slot='wizard'] > nav {\napps/desktop/src/styles/tokens.css:249:    [data-slot='wizard'] > nav > div:first-child {\napps/desktop/src/styles/tokens.css:252:    [data-slot='wizard'] > nav > ol {\napps/desktop/src/styles/tokens.css:257:    [data-slot='wizard'] > nav > ol button {\napps/desktop/src/styles/tokens.css:263:    [data-slot='wizard'] > nav > ol button > span:not(:first-child) {\napps/desktop/src/styles/tokens.css:271:    [data-slot='wizard'] > nav > [data-slot='privacy-note'] {\napps/desktop/src/styles/tokens.css:274:    [data-slot='wizard'] > nav > [data-slot='theme-button'] {\napps/desktop/src/styles/tokens.css:277:    [data-slot='wizard'] main .grid {\napps/desktop/src/styles/tokens.css:283:    [data-slot='wizard'] > nav > div:first-child {\napps/desktop/src/styles/tokens.css:286:    [data-slot='wizard-footer'] [data-slot='wizard-status'] > span {\napps/desktop/src/styles/tokens.css:419:/* The wizard's Environment segmented control (C43): native radios inside labels; the segment shows the ring. */\n        continue: 'Continue',\n    },\n    packs: {\n        title: 'Load starter test cases',\n        lead: (name: string) => `Optional. Ready-made cases for the products you picked, imported into ${name}’s Test Cases library so there is something to run on the first day. They are sealed on this Mac, and you can edit or delete them later.`,\n        pack: (product: string, count: number) => `${product} · ${count} ${count === 1 ? 'case' : 'cases'}`,\n        name: (product: string) => `${product} starter pack`,\n        count: (n: number) => `${n} ${n === 1 ? 'case' : 'cases'}`,\n        summary: (packs: number, cases: number) => (packs === 0 ? 'No packs selected. Starter cases can be added later from Test Cases.' : `${cases} ${cases === 1 ? 'case' : 'cases'} in ${packs} ${packs === 1 ? 'pack' : 'packs'} will be imported.`),\n        none: 'No bundled cases for the chosen products.',\n        skip: 'Skip for now',\n        continue: 'Continue',\n    },\n    academy: {\n        title: 'Join the AI Security Academy',\n        lead: 'Optional. Short lessons for each product, practised against your own tenant. Signing in syncs your Academy progress only: lessons, assessments and certificates. Nothing about your tenant or its credentials is sent to the Academy.',\n        account: 'Your account',\n        whatSyncs: 'What is sent to Academy',\n        syncs: ['Your account’s email and display name, when you sign in.', 'Lesson progress, assessments and certificates.', 'Nothing about your tenants or their credentials.'],\n        skip: 'Skip for now',\n        continue: 'Continue',\n    },\n    done: {\n        title: (name: string) => `${name} is ready`,\n        lead: 'Here is what was set up. Everything can be changed later in Administration and Settings; Home reads the tenant the first time you open it.',\n        change: 'Change',\n        summary: {\n            tenant: 'Tenant',\n            scan: 'Scan key',\n            client: 'Management client',\n            products: 'Products',\n            checks: 'Checks',\n            checksPassed: 'All passed',\n            // The checks line counts each verification state (P26: a stored or skipped credential is not a passed check).\n            checkCounts: {\n                pass: (n: number) => `${n} passed`,\n                warning: (n: number) => `${n} ${n === 1 ? 'warning' : 'warnings'}`,\n                fail: (n: number) => `${n} failed`,\n                stored: (n: number) => `${n} stored, not checked`,\n                skipped: (n: number) => `${n} not checked`,\n                unavailable: (n: number) => `${n} not available`,\n                pending: (n: number) => `${n} pending`,\n            },\n            packs: 'Starter cases',\n            academy: 'Academy',\n            academySkipped: 'Skipped · join any time from Academy',\n            saved: 'saved',\n            notSaved: 'not saved',\n            none: 'none',\n        },\n        nextUp: [\n            { icon: 'home' as const, title: 'Home', text: 'The first read of each product arrives when you open it. Open the API Client any time to see the request behind a figure.' },\n            { icon: 'inbox' as const, title: 'Inbox', text: 'Anything that needs you, from every product, in one list.' },\n            { icon: 'bot' as const, title: 'Ask the Harness', text: 'Choose a model the first time you ask. Tools always ask first.' },\n        ],\n        open: 'Open Prisma AIRS',\n        opening: 'Opening…',\n        finish: 'Finish',\n        finishing: 'Finishing…',\n    },\n    outcome: {\n        unknown: 'Sent but not confirmed. The current state is shown.',\n        failed: 'Could not be delivered.',\n        retry: 'Retry',\n    },\n    cancel: 'Cancel',\n    cancelling: 'Discarding…',\n    cancelFailed: 'The draft could not be discarded; it and its credentials are still here.',\n    back: 'Back',\n    cancelNote: 'Cancel discards this draft and removes any credential it saved. Nothing else changes.',\n} as const\n\n/** The products the wizard offers: admitted ones selectable, the rest shown as not available (DESIGN-V2 §6). */\nexport const PRODUCT_CARDS: { id: 'runtimeSecurity' | 'gateway' | 'redTeam' | 'modelSkill' | null; label: string; body: string; icon: 'shield' | 'route' | 'cross' | 'box' | 'idcard' | 'laptop'; readOnly?: boolean }[] = [\n    { id: 'runtimeSecurity', label: 'AI Runtime Security', body: 'Prompts, responses and tool calls are scanned as they happen.', icon: 'shield' },\n    { id: 'gateway', label: 'AI Gateway', body: 'Workspaces, routes, providers, guardrails and keys.', icon: 'route' },\n    { id: 'redTeam', label: 'AI Red Teaming', body: 'Scan inventory, statistics and reports.', icon: 'cross', readOnly: true },\n    { id: 'modelSkill', label: 'Model and skill scans', body: 'Model Security and AgentGuard skill scan summaries.', icon: 'box', readOnly: true },\n    { id: null, label: 'Agentic Identity Security', body: 'Needs an admitted AIS service (D058).', icon: 'idcard' },\n    { id: null, label: 'Agentic Endpoint Security', body: 'Needs an admitted AES service (D058).', icon: 'laptop' },\n]\n                        aria-label={`Sign-in code ${view.userCode.split('').join(' ')}`}\n                    >\n                        {view.userCode}\n                    </p>\n                    <p className='text-academy-ink-faint text-[12px] break-all'>\n                        {view.verificationUri} · expires in {Math.max(1, Math.ceil(view.expiresIn / 60))} min\n                    </p>\n                    <div className='flex flex-wrap gap-2'>\n                        <Button type='button' tier='primary' onClick={() => void send({ kind: 'openAcademyVerification' })}>\n                            Open sign-in page\n                        </Button>\n                        <Button type='button' tier='secondary' onClick={() => void send({ kind: 'cancelAcademySignIn' })}>\n                            Cancel sign-in\n                        </Button>\n                    </div>\n                </div>\n            )\n        case 'signedIn':\n            return (\n                <div className='flex flex-col items-start gap-3'>\n                    <Callout tone='success' icon={CheckCircle2}>\n                        <p>\n                            Signed in to Academy as <span className='font-semibold'>{view.displayName}</span>.\n                        </p>\n                    </Callout>\n                    <Button type='button' tier='secondary' disabled={busy} onClick={() => void send({ kind: 'signOutAcademy' })}>\n                        Sign out of Academy\n                    </Button>\n                </div>\n            )\n        case 'failed':\n            return (\n                <div className='flex flex-col items-start gap-3'>\n                    <Callout tone='warning' icon={view.failure === 'network' ? Info : AlertTriangle} data-slot='academy-failure'>\n                        {view.displayName ? <p className='font-semibold'>{view.displayName}</p> : null}\n                        <p>{view.vault ? VAULT_TEXT[view.vault] : FAILURE_TEXT[view.failure]}</p>\n                    </Callout>\n                    <div className='flex flex-wrap gap-2'>\n                        <Button type='button' tier='primary' disabled={busy} onClick={() => void send({ kind: 'startAcademySignIn' })}>\n                            Sign in again\n                        </Button>\n                        <Button type='button' tier='secondary' disabled={busy} onClick={() => void send({ kind: 'signOutAcademy' })}>\n                            Sign out of Academy\n                        </Button>\n                    </div>\n                </div>\n            )\n    }\n}\n","exit_code":0,"status":"completed"}}
