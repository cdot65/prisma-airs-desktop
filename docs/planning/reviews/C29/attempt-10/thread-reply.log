nant' && (\n                            <>\n                                <div className='flex flex-wrap items-end' style={{ gap: 12 }}>\n                                    <div>\n                                        <h1 ref={heading} id={headingId} tabIndex={-1} className='font-bold' style={{ fontSize: 26, letterSpacing: '-0.01em' }}>\n                                            {C.tenant.title}\n                                        </h1>\n                                        <p className='text-[14px]' style={{ marginTop: 4, color: 'var(--v2-soft)' }}>\n                                            {C.tenant.lead}\n                                        </p>\n                                    </div>\n                                </div>\n                                <form onSubmit={(e) => void submitProfile(e)} aria-busy={busy} className='flex flex-col rounded-[12px] border' style={{ gap: 12, padding: '18px 20px', borderColor: 'var(--v2-rule)', background: 'var(--v2-paper)' }} data-slot='tenant-form'>\n                                    <div className='flex items-center' style={{ gap: 8 }}>\n                                        <b className='text-[14px]'>{C.tenant.card}</b>\n                                        {pill(C.required, 'required')}\n                                    </div>\n                                    <div className='grid' style={{ gridTemplateColumns: '1fr 1fr', gap: 12 }} data-slot='field-grid'>\n                                        <Field label={C.tenant.name} name='name' value={form.name} onChange={(v) => setForm((f) => ({ ...f, name: v }))} hint={C.tenant.nameHint} error={touched.name ? errors.name : ''} maxLength={64} onBlur={(v) => { setTouched((t) => ({ ...t, name: true })); setErrors((e) => ({ ...e, name: fieldError('name', v) })) }} />\n                                        <Field label={C.tenant.tsg} name='tsg' value={form.tsg} onChange={(v) => setForm((f) => ({ ...f, tsg: v }))} hint={C.tenant.tsgHint} inputMode='numeric' error={touched.tsg ? errors.tsg : ''} onBlur={(v) => { setTouched((t) => ({ ...t, tsg: true })); setErrors((e) => ({ ...e, tsg: fieldError('tsg', v) })) }} />\n                                        <div className='flex flex-col text-[12px] font-semibold' style={{ gap: 5, color: 'var(--v2-soft)' }}>\n                                            {C.tenant.environment}\n                                            <div role='radiogroup' aria-label={C.tenant.environment} className='flex w-fit rounded-[8px]' style={{ padding: 2, background: 'var(--v2-inset)' }} data-slot='environment-control'>\n                                                {ENVIRONMENTS.map((env) => {\n                                                    const on = form.environment === env\n                                                    // Native radios in the segmented control: one tab stop for the group, arrow keys move\n                                                    // the selection, the label is the visible segment (buttons with a radio role had neither).\n                                                    return (\n                                                        <label key={env} className='relative flex h-8 cursor-pointer items-center rounded-[6px] text-[12.5px] font-semibold' style={{ padding: '0 14px', background: on ? 'var(--v2-paper)' : 'transparent', boxShadow: on ? '0 1px 2px rgba(0,0,0,0.12)' : 'none', color: 'var(--v2-ink)' }} data-slot='environment-choice'>\n                                                            <input type='radio' className='sr-only' name={`${headingId}-environment`} value={env} checked={on} onChange={() => setForm((f) => ({ ...f, environment: env }))} />\n                                                            {ENVIRONMENT_LABELS[env]}\n                                                        </label>\n                                                    )\n                                                })}\n                                            </div>\n                                            <span className='font-normal' style={{ color: 'var(--v2-faint)' }}>\n                                                {C.tenant.environmentHint}\n                                            </span>\n                                        </div>\n                                        <label className='flex flex-col text-[12px] font-semibold' style={{ gap: 5, color: 'var(--v2-soft)' }}>\n                                            {C.tenant.region}\n                                            <select name='region' aria-label={C.tenant.region} value={form.region} onChange={(e) => setForm((f) => ({ ...f, region: e.target.value as Region }))} className='h-8 min-h-0 rounded-[7px] border px-2.5 text-[13px] font-normal' style={{ borderColor: 'var(--v2-ctl)', background: 'var(--v2-bg)', color: 'var(--v2-ink)' }}>\n                                                {REGIONS.map((r) => (\n                                                    <option key={r.value} value={r.value}>\n                                                        {r.label}\n                                                    </option>\n                                                ))}\n                                            </select>\n                                            <span className='font-normal' style={{ color: 'var(--v2-faint)' }}>\n                                                {C.tenant.regionHint}\n                                            </span>\n                                        </label>\n                                    </div>\n                                    {setup && (\n                                        <p className='text-[12px]' style={{ color: 'var(--v2-faint)' }}>\n                                            {C.tenant.updateHint}\n                                        </p>\n                                    )}\n                                    <div className='flex items-center' style={{ gap: 10 }}>\n                                        <Primary label={setup ? C.tenant.save : C.tenant.create} disabled={busy} />\n                                        {profileDirty && <Secondary label={C.tenant.revert} onClick={revertProfile} />}\n                                    </div>\n                                </form>\n                                {setup && (\n                                    <>\n                                        {scanCard}\n                                        <form onSubmit={(e) => void saveClient(e)} aria-busy={busy} className='flex flex-col rounded-[12px] border' style={{ gap: 12, padding: '18px 20px', borderColor: 'var(--v2-rule)', background: 'var(--v2-paper)' }} data-slot='management-form'>\n                                            <div className='flex items-center' style={{ gap: 8 }}>\n                                                <b className='text-[14px]'>{C.tenant.management}</b>\n                                                {pill(C.optional)}\n                                                <button type='button' aria-expanded={helpOpen} onClick={() => setHelpOpen((h) => !h)} className='ml-auto text-[12px] font-semibold' style={{ color: 'var(--v2-acc)' }}>\n                                                    {C.tenant.whereFind}\n                                                </button>\n                                            </div>\n                                            {helpOpen && (\n                                                <ol className='flex list-decimal flex-col rounded-[8px] leading-[1.5]' style={{ gap: 4, padding: '12px 14px 12px 32px', background: 'var(--v2-inset)', color: 'var(--v2-soft)' }}>\n                                                    {C.tenant.whereSteps.map((t) => (\n                                                        <li key={t}>{t}</li>\n                                                    ))}\n                                                </ol>\n                                            )}\n                                            <p className='text-[12px]' style={{ color: 'var(--v2-faint)' }}>\n                                                {C.tenant.managementHint}\n                                            </p>\n                                            <p data-slot='management-state'>\n                                                <Verdict tone={stateTone(setup.tenant.management.state)} word={C.tenant.state[setup.tenant.management.state]} reason={clientReady && setup.tenant.management.clientId ? `Client ID: ${setup.tenant.management.clientId}` : undefined} />\n                                            </p>\n                                            <div className='grid' style={{ gridTemplateColumns: '1fr 1fr', gap: 12 }}>\n                                                <Field label={C.tenant.clientId} name='clientId' error={errors.clientId} />\n                                                <SecretField label={C.tenant.clientSecret} inputRef={secretRef} error={errors.clientSecret} />\n                                            </div>\n                                            <div className='flex items-center' style={{ gap: 10 }}>\n                                                <Primary label={clientReady ? C.tenant.replaceClient : C.tenant.saveClient} disabled={busy} />\n                                                {clientReady && <Secondary label={C.tenant.removeClient} disabled={busy} onClick={() => void remove('removeManagementCredential', C.tenant.clientRemoved)} />}\n                                            </div>\n                                        </form>\n                                        <OptionalCard icon='route' title={C.tenant.gateway} text={C.tenant.gatewayHint} tag={C.optional} open={gatewayOn} onToggle={(on) => setGatewayOn(on)} switchLabel={C.tenant.gatewayOn} slot='gateway-section'>\n                                            {!clientReady && (\n                                                <p className='text-[12px]' style={{ color: 'var(--v2-soft)' }}>\n                                                    {C.tenant.gatewayNeedsClient}\n                                                </p>\n                                            )}\n                                            {clientReady && (\n                                                <div className='flex flex-col' style={{ gap: 10 }}>\n                                                    <div className='flex items-center' style={{ gap: 10 }}>\n                                                        <Secondary label={C.tenant.readWorkspaces} disabled={busy} onClick={() => void listWorkspaces()} />\n                                                        {workspacesNote && (\n                                                            <span className='text-[12px]' style={{ color: 'var(--v2-soft)' }}>\n                                                                {workspacesNote}\n                                                            </span>\n                                                        )}\n                                                    </div>\n                                                    {workspaces && workspaces.length > 0 && (\n                                                        <div className='flex items-end' style={{ gap: 10 }}>\n                                                            <label className='flex flex-col text-[12px] font-semibold' style={{ gap: 5, color: 'var(--v2-soft)' }}>\n                                                                {C.tenant.workspace}\n                                                                <select value={workspace} onChange={(e) => setWorkspace(e.target.value)} className='h-8 min-h-0 rounded-[7px] border px-2.5 text-[13px] font-normal' style={{ borderColor: 'var(--v2-ctl)', background: 'var(--v2-bg)', color: 'var(--v2-ink)' }}>\n                                                                    {workspaces.map((w) => (\n                                                                        <option key={w.id} value={w.id}>\n                                                                            {w.name}\n                                                                        </option>\n                                                                    ))}\n                                                                </select>\n                                                            </label>\n                                                            <Secondary label={C.tenant.chooseWorkspace} disabled={busy || !workspace} onClick={() => void chooseWorkspace()} />\n                                                        </div>\n                                                    )}\n                                                    {chosen && (\n                                                        <form onSubmit={(e) => void saveWorkspaceKey(e)} aria-busy={busy} className='flex flex-col' style={{ gap: 10 }} data-slot='workspace-key-form'>\n                                                            <p className='text-[13px]'>{C.tenant.workspaceChosen(chosen.workspace.name)}</p>\n                                                            <p data-slot='inference-state'>\n                                                                <Verdict tone={setup.tenant.inference.state === 'ready' ? 'allowed' : 'info'} word={C.tenant.state[setup.tenant.inference.state]} />\n                                                            </p>\n                                                            <div className='grid' style={{ gridTemplateColumns: '1fr 1fr', gap: 12 }}>\n                                                                <Field label={C.tenant.endpoint} name='endpoint' value={endpoint} onChange={setEndpoint} hint={C.tenant.endpointHint} error={errors.endpoint} />\n                                                                <SecretField label={C.tenant.workspaceKey} inputRef={workspaceKeyRef} error={errors.workspaceKey} />\n                                                            </div>\n                                                            <div>\n                                                                <Primary label={C.tenant.saveWorkspaceKey} disabled={busy} />\n                                                            </div>\n                                                        </form>\n                                                    )}\n                                                </div>\n                                            )}\n                                        </OptionalCard>\n                                    </>\n                                )}\n                            </>\n                        )}\n                        {step === 'products' && setup && (\n                            <>\n                                <div>\n                                    <h1 ref={heading} id={headingId} tabIndex={-1} className='font-bold' style={{ fontSize: 26, letterSpacing: '-0.01em' }}>\n                                        {C.products.title}\n                                    </h1>\n                                    <p className='text-[14px]' style={{ marginTop: 4, color: 'var(--v2-soft)' }}>\n                                        {C.products.lead(setup.tenant.label)}\n                                    </p>\n                                </div>\n                                <div className='grid' style={{ gridTemplateColumns: 'repeat(3, minmax(0, 1fr))', gap: 12 }} data-slot='product-cards'>\n                                    {PRODUCT_CARDS.map((card) => {\n                                        // An id without spaces (a label is not one): the description's targets.\n                                        const cardId = `product-${card.label.replace(/\\W+/g, '-').toLowerCase()}`\n                                        const unavailable = card.id === null\n                                        const always = card.id === 'runtimeSecurity'\n                                        const on = card.id !== null && setup.products.includes(card.id)\n                                        const reads = card.id === null ? null : card.id === 'runtimeSecurity' ? (scanReady ? C.products.readsWith.scanReady : C.products.readsWith.scanMissing) : clientReady ? C.products.readsWith.clientReady : C.products.readsWith.clientMissing\n                                        const lastStep = run && !run.stale && card.id ? run.steps.find((s) => s.product === card.id && s.line !== 'managementClient') : undefined\n                                        const missing = reads === C.products.readsWith.clientMissing || reads === C.products.readsWith.scanMissing\n                                        return (\n                                            // A label around a native checkbox, not a checkbox-role button: a checkbox's children are\n                                            // presentational to assistive technology, which hid the body and the tags (\"Always on\",\n                                            // \"Not available in this release\"); as the label's text they are read, and the control keeps\n                                            // the card's name, description and state. The card shows the control's focus ring.\n                                            <label\n                                                key={card.label}\n                                                className='relative flex flex-col text-left'\n                                                style={{ gap: 10, minHeight: 176, padding: '18px 20px', border: `1.5px solid ${on ? 'var(--v2-acc)' : 'var(--v2-rule)'}`, borderRadius: 12, background: on ? 'var(--v2-acc-soft)' : 'var(--v2-paper)', color: 'var(--v2-ink)', opacity: unavailable ? 0.7 : 1, cursor: unavailable || always ? 'default' : 'pointer' }}\n                                                data-slot='product-card'\n                                            >\n                                                <input\n                                                    type='checkbox'\n                                                    className='sr-only'\n                                                    checked={on}\n                                                    aria-disabled={unavailable || always ? true : undefined}\n                                                    aria-label={card.label}\n                                                    aria-describedby={`${cardId}-body ${cardId}-tags`}\n                                                    onChange={() => card.id && !always && void toggleProduct(card.id, !on)}\n                                                    data-slot='product-choice'\n                                                />\n                                                <span className='absolute grid place-items-center rounded-full' style={{ top: 14, right: 14, width: 20, height: 20, border: `1.5px solid ${on ? 'var(--v2-acc)' : 'var(--v2-ctl)'}`, background: on ? 'var(--v2-acc)' : 'transparent', color: 'var(--v2-acc-ink)' }}>\n                                                    {on && <Glyph name='check' size={11} color='var(--v2-acc-ink)' />}\n                                                </span>\n                                                <span className='grid place-items-center rounded-[10px]' style={{ width: 36, height: 36, background: on ? 'var(--v2-acc)' : 'var(--v2-inset)', color: on ? 'var(--v2-acc-ink)' : 'var(--v2-soft)' }}>\n                                                    <Glyph name={card.icon} size={18} color={on ? 'var(--v2-acc-ink)' : 'var(--v2-soft)'} />\n                                                </span>\n                                                <span className='block leading-[1.35]' style={{ paddingRight: 26 }}>\n                                                    <b className='text-[14px]'>{card.label}</b>\n                                                </span>\n                                                <span id={`${cardId}-body`} className='leading-[1.45]' style={{ color: 'var(--v2-soft)' }}>\n                                                    {card.body}\n                                                </span>\n                                                <span id={`${cardId}-tags`} className='mt-auto flex flex-wrap' style={{ gap: 6 }}>\n                                                    {unavailable && <Verdict tone='info' word={C.products.unavailable} />}\n                                                    {always && <Verdict tone='info' word={C.products.always} />}\n                                                    {card.readOnly && <Verdict tone='info' word={C.products.readOnly} />}\n                                                    {reads && !unavailable && <Verdict tone={missing ? 'flagged' : 'allowed'} word={reads} />}\n                                                    {lastStep && lastStep.state !== 'pending' && <Verdict tone={toneOf(lastStep.state)} word={C.verify.state[lastStep.state]} />}\n                                                </span>\n                                            </label>\n                                        )\n                                    })}\n                                </div>\n                                {!scanReady && (\n                                    <div className='flex items-center rounded-[8px] leading-[1.45]' style={{ gap: 8, padding: '10px 12px', background: 'var(--v2-flag-bg)' }} data-slot='no-scan-banner'>\n                                        <Glyph name='alert' size={15} color='var(--v2-flag)' className='shrink-0' />\n                                        <span className='flex-grow'>{C.products.noScan}</span>\n                                        <Secondary label={C.products.addScanKey} onClick={() => go(steps.indexOf('tenant'))} />\n                                    </div>\n                                )}\n                                <p className='text-[12px]' style={{ color: 'var(--v2-faint)' }}>\n                                    {C.products.licence}\n                                </p>\n                            </>\n                        )}\n                        {step === 'verify' && setup && (\n                            <>\n                                <div>\n                                    <h1 ref={heading} id={headingId} tabIndex={-1} className='font-bold' style={{ fontSize: 26, letterSpacing: '-0.01em' }}>\n                                        {C.verify.title}\n                                    </h1>\n                                    <p className='text-[14px]' style={{ marginTop: 4, color: 'var(--v2-soft)' }}>\n                                        {C.verify.lead(setup.tenant.label)}\n                                    </p>\n                                </div>\n                                <div role='status' aria-live='polite' className='flex items-center rounded-[12px]' style={{ gap: 12, padding: '14px 16px', background: !run ? 'var(--v2-inset)' : run.stale || run.blocking ? 'var(--v2-block-bg)' : running ? 'var(--v2-acc-soft)' : run.failed || run.warnings.length ? 'var(--v2-flag-bg)' : 'var(--v2-ok-bg)' }} data-slot='verify-banner'>\n                                    <Glyph name={!run || running ? 'clock' : run.stale || run.blocking ? 'ban' : run.failed || run.warnings.length ? 'alert' : 'check'} size={22} color={!run ? 'var(--v2-soft)' : run.stale || run.blocking ? 'var(--v2-block)' : running ? 'var(--v2-acc)' : run.failed || run.warnings.length ? 'var(--v2-flag)' : 'var(--v2-ok)'} className='shrink-0' />\n                                    <span className='flex-grow'>\n                                        <b className='text-[14px]'>{!run ? C.verify.notRunTitle : verifyStatus}</b>\n                                        <br />\n                                        <span style={{ color: 'var(--v2-soft)' }}>{!run ? C.verify.notRunText : running ? C.verify.runningText : run.stale ? C.verify.staleText : run.blocking ? C.verify.failedText : run.failed ? C.verify.failedOptionalText : C.verify.doneText}</span>\n                                    </span>\n                                    {run && run.done && run.failed && !run.stale && <Secondary label={C.verify.editCredentials} onClick={() => go(steps.indexOf('tenant'))} />}\n                                </div>\n                                <ul className='flex flex-col overflow-hidden rounded-[12px] border' aria-label='Checks' aria-busy={running} style={{ borderColor: 'var(--v2-rule)', background: 'var(--v2-paper)', opacity: run?.stale ? 0.6 : 1 }}>\n                                    {plannedRows.map((r, i) => {\n                                        const tone = run || r.state === 'unavailable' ? toneOf(r.state) : 'info'\n                                        const colors: [string, string, GlyphName] = tone === 'allowed' ? ['var(--v2-ok-bg)', 'var(--v2-ok)', 'check'] : tone === 'flagged' ? ['var(--v2-flag-bg)', 'var(--v2-flag)', 'alert'] : tone === 'blocked' ? ['var(--v2-block-bg)', 'var(--v2-block)', 'x'] : ['var(--v2-inset)', 'var(--v2-soft)', running && r.state === 'pending' ? 'clock' : 'dot']\n                                        return (\n                                            <li key={r.line} className='flex items-center' style={{ gap: 12, padding: '12px 18px', borderTop: i ? '1px solid var(--v2-rule)' : 0 }} data-slot={`verify-${r.line}`}>\n                                                <span className='grid shrink-0 place-items-center rounded-full' style={{ width: 26, height: 26, background: colors[0], color: colors[1] }}>\n                                                    <Glyph name={colors[2]} size={13} color={colors[1]} />\n                                                </span>\n                                                <span className='min-w-0 flex-grow'>\n                                                    <b className='font-semibold'>{C.verify.rows[r.line]}</b>\n                                                    <br />\n                                                    <span className='leading-[1.45]' style={{ color: tone === 'blocked' ? 'var(--v2-block)' : tone === 'flagged' ? 'var(--v2-flag)' : 'var(--v2-soft)' }}>\n                                                        {r.reason}\n                                                    </span>\n                                                </span>\n                                                <Verdict tone={tone} word={run || r.state === 'unavailable' ? C.verify.state[r.state] : C.verify.notRun} />\n                                            </li>\n                                        )\n                                    })}\n                                </ul>\n                            </>\n                        )}\n                        {step === 'packs' && setup && (\n                            <>\n                                <div>\n                                    <h1 ref={heading} id={headingId} tabIndex={-1} className='font-bold' style={{ fontSize: 26, letterSpacing: '-0.01em' }}>\n                                        {C.packs.title}\n                                    </h1>\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_32","type":"command_execution","command":"/bin/zsh -lc \"sed -n '3635,3825p' crates/desktop-core/src/authority.rs; sed -n '1,285p' crates/desktop-core/src/authority/inbox_domain.rs\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_32","type":"command_execution","command":"/bin/zsh -lc \"sed -n '3635,3825p' crates/desktop-core/src/authority.rs; sed -n '1,285p' crates/desktop-core/src/authority/inbox_domain.rs\"","aggregated_output":"fn admit(\n    state: &mut State,\n    session: &Arc<SessionVault>,\n    adapters: &Adapters,\n    intent: Intent,\n    effects: &mut Vec<Effect>,\n) -> Result<Receipt, Refusal> {\n    let mut operation_ref: Option<OperationId> = None;\n    match intent {\n        Intent::SetAppearance { theme } => {\n            if state.appearance() != theme {\n                let before = state.data.clone();\n                state.data.appearance = Some(theme);\n                if state.storage == StorageHealth::Ready\n                    && let Err(e) = state.save_with(&before)\n                {\n                    return Err(e);\n                }\n                state.changed();\n            }\n        }\n        Intent::SetUiVariant { variant: _ } => {\n            // C44: one presentation. Accepted and ignored (see `ui_variant`).\n        }\n        Intent::Navigate { feature } => {\n            let entry = features::catalogue_for(state.ui_variant())\n                .into_iter()\n                .find(|e| e.id == feature)\n                .ok_or(Refusal::InvalidInput)?;\n            if entry.availability != features::Availability::Available {\n                return Err(Refusal::InvalidInput);\n            }\n            if state.active_feature != Some(feature) {\n                state.active_feature = Some(feature);\n                state.changed();\n            }\n        }\n        Intent::SetOnboarding { state: next } => {\n            use features::OnboardingState as O;\n            let current = state.onboarding();\n            let allowed = matches!(\n                (current, next),\n                (O::Needed, O::InProgress | O::Done) | (O::InProgress, O::Done)\n            ) || current == next;\n            if !allowed {\n                return Err(Refusal::InvalidInput);\n            }\n            if current != next {\n                let before = state.data.clone();\n                state.data.onboarding = Some(next);\n                if state.storage == StorageHealth::Ready\n                    && let Err(e) = state.save_with(&before)\n                {\n                    return Err(e);\n                }\n                state.changed();\n            }\n        }\n        Intent::SetShowCalls { on } => {\n            // The operator's choice holds from now on, onboarding or not (C33).\n            if state.data.show_calls != Some(on) {\n                let before = state.data.clone();\n                state.data.show_calls = Some(on);\n                if state.storage == StorageHealth::Ready\n                    && let Err(e) = state.save_with(&before)\n                {\n                    return Err(e);\n                }\n                state.changed();\n            }\n        }\n        Intent::BeginTenantSetup { mode, profile } => {\n            state.require_storage()?;\n            let before = state.data.clone();\n            state.begin_setup(mode, profile)?;\n            state.save_with(&before)?;\n            state.changed();\n        }\n        Intent::UpdateTenantSetup { context, profile } => {\n            state.require_storage()?;\n            let before = state.data.clone();\n            let retired = state.update_setup(&context, profile)?;\n            state.save_with(&before)?;\n            for old in retired {\n                let _ = session.delete(&old);\n            }\n            effects.push(Effect::Cleanup);\n            state.changed();\n        }\n        Intent::ChooseSetupProducts { context, products } => {\n            state.require_storage()?;\n            let before = state.data.clone();\n            state.choose_setup_products(&context, products)?;\n            state.save_with(&before)?;\n            state.changed();\n        }\n        Intent::VerifyTenantSetup { context } => {\n            let starts = state.begin_verify(\n                &context,\n                Arc::clone(&adapters.keychain),\n                Arc::clone(session),\n            )?;\n            effects.push(Effect::Start(starts));\n            effects.push(Effect::Start(state.take_gateway_starts()));\n            state.changed();\n        }\n        Intent::CompleteTenantSetup {\n            context,\n            packs,\n            resolution,\n        } => {\n            state.require_storage()?;\n            let draft = state.completable_setup(&context, &packs)?;\n            // Completion makes the new tenant active: the one guarded switch\n            // path (I1). A pending Harness decision refuses it, with the\n            // draft, the active tenant and the decision all untouched.\n            let resolution = match state.guard_switch(&draft, resolution, Some(&context)) {\n                Ok(resolution) => resolution,\n                Err(refusal) => {\n                    state.changed();\n                    return Err(refusal);\n                }\n            };\n            let before = state.data.clone();\n            let recorded_secs = wall_secs(state.clock_offset);\n            let done = state.complete_setup(&context, packs, recorded_secs)?;\n            state.save_with(&before)?;\n            if let Some(resolution) = resolution {\n                resolution.resolve(state)?;\n            }\n            effects.extend(state.take_history_jobs());\n            state.retire_setup_context(&context, done.retired_workspace.as_ref());\n            effects.push(Effect::Start(state.reissue_context()));\n            effects.push(Effect::Start(state.take_gateway_starts()));\n            if !done.packs.is_empty() {\n                let (lease, write) = state.queue_examples(&done.tenant, &done.packs);\n                if let Some(lease) = lease {\n                    effects.push(Effect::LoadLibrary { lease });\n                }\n                if let Some((tenant, generation)) = write {\n                    effects.push(Effect::StoreLibrary { tenant, generation });\n                }\n            }\n            let _ = done.first_run;\n            state.changed();\n        }\n        Intent::DiscardTenantSetup { context } => {\n            if state.setup_has_keychain_credential() {\n                state.require_storage()?;\n            }\n            let before = state.data.clone();\n            let retired = state.discard_setup(&context)?;\n            if state.storage == StorageHealth::Ready {\n                state.save_with(&before)?;\n            }\n            for old in retired {\n                let _ = session.delete(&old);\n            }\n            effects.push(Effect::Start(state.take_gateway_starts()));\n            effects.push(Effect::Cleanup);\n            state.changed();\n        }\n        Intent::CreateTenant { profile } => {\n            state.require_storage()?;\n            let profile = profile.validate().ok_or(Refusal::InvalidInput)?;\n            if state.data.tenants.len() >= MAX_TENANTS {\n                return Err(Refusal::Busy);\n            }\n            let id = TenantId::issue().ok_or(Refusal::ShuttingDown)?;\n            let before = state.data.clone();\n            let select = state.data.active.is_none();\n            state.data.tenants.push(Tenant::new(TenantProfile {\n                id: id.clone(),\n                label: profile.label,\n                tsg_id: profile.tsg_id,\n                destination: profile.destination,\n                environment: profile.environment,\n            }));\n            if select {\n                state.data.active = Some(id);\n            }\n            // A first-run draft is over once the desktop has a tenant (C29).\n            let retired = state.end_first_run_setup();\n            state.save_with(&before)?;\n            for old in retired {\n                let _ = session.delete(&old);\n            }\n            effects.push(Effect::Cleanup);\n            if select {\n                effects.push(Effect::Start(state.reissue_context()));\n            }\n//! Inbox, reads and the tenant-switch guard (C30, screens/inbox-reads.md,\n//! invariants I1, I2, I4, I11, I12). Everything here is derived per tenant\n//! from scopes the core already owns: the Runtime overview read (its items,\n//! sources and failures), the operator's holds, the tenant's chosen\n//! products and its setup warnings (C29). The core computes the snooze\n//! return time, the per-product read status and whether a switch may\n//! proceed; the presentation renders them.\n\nuse serde::{Deserialize, Serialize};\nuse ts_rs::TS;\n\nuse super::observation_domain::{\n    FailedAttempt, HoldKind, OverviewView, ProductOutcome, SnoozeReceipt, product_sources,\n    source_names,\n};\nuse super::{PendingDecisionRef, Refusal, State, SwitchBlocked};\nuse crate::context::{ContextRef, ReviewId};\nuse crate::features::{FeatureId, ProductId, SetupWarning};\nuse crate::management::{ManagementFailure, ManagementResource};\nuse crate::observation::{Fact, InboxDestination, InboxItem, Tone};\nuse crate::runtime::OperationId;\nuse crate::tenants::TenantId;\n\n/// How a blocked switch is resolved (I1): the pending conversation is\n/// ended and kept (`archive`) or ended and dropped (`discard`).\n#[derive(Clone, Debug, PartialEq, Eq, Serialize, Deserialize, TS)]\n#[serde(tag = \"kind\", rename_all = \"camelCase\", deny_unknown_fields)]\npub enum SwitchResolution {\n    Archive {\n        context: ContextRef,\n        review: ReviewId,\n    },\n    Discard {\n        context: ContextRef,\n        review: ReviewId,\n    },\n}\n\n/// A validated resolution held only inside the synchronous admission lock.\n/// Persist the tenant transition before consuming it; the old context and\n/// workspace remain bound until resolution and context retirement finish.\npub(super) enum GuardedSwitch {\n    Archive(OperationId),\n    Discard(OperationId),\n}\n\nimpl GuardedSwitch {\n    pub(super) fn resolve(self, state: &mut State) -> Result<(), Refusal> {\n        match self {\n            Self::Archive(id) => state.end_harness(&id)?,\n            Self::Discard(id) => state.discard_harness(&id)?,\n        }\n        state.switch_blocked = None;\n        Ok(())\n    }\n}\n\n/// Where an Inbox entry came from.\n#[derive(Clone, Copy, Debug, PartialEq, Eq, Serialize, TS)]\n#[serde(rename_all = \"camelCase\")]\npub enum InboxKind {\n    /// A Runtime overview item (sessions, keys).\n    Runtime,\n    /// The chosen Gateway workspace's day (C18).\n    Gateway,\n    /// A warning recorded at tenant setup (C29).\n    SetupWarning,\n    /// A key rotation in progress (C31, I7).\n    Rotation,\n}\n\n/// An operator's hold on an entry, with the core-computed return time.\n#[derive(Clone, Debug, PartialEq, Eq, Serialize, TS)]\n#[serde(rename_all = \"camelCase\")]\npub struct HoldView {\n    pub kind: HoldKind,\n    /// When a snoozed entry returns (seconds since the epoch); none for an\n    /// acknowledgment, which ends when the item's level rises.\n    pub returns_at: Option<u32>,\n}\n\n/// Where an entry's action leads (C30): the destination, and within it the\n/// product, the inventory and the item the presentation selects on arrival.\n#[derive(Clone, Debug, PartialEq, Eq, Serialize, TS)]\n#[serde(rename_all = \"camelCase\")]\npub struct InboxTarget {\n    pub feature: FeatureId,\n    pub product: Option<ProductId>,\n    /// The Administration inventory to open (API keys for a key item).\n    pub resource: Option<ManagementResource>,\n    /// The item's name within that inventory, for the filter.\n    pub item: Option<String>,\n}\n\n/// One Inbox entry of the active tenant.\n#[derive(Clone, Debug, PartialEq, Eq, Serialize, TS)]\n#[serde(rename_all = \"camelCase\")]\npub struct InboxEntry {\n    pub id: String,\n    pub kind: InboxKind,\n    /// Needs action (otherwise an update).\n    pub needs_action: bool,\n    pub severity: Tone,\n    pub title: String,\n    pub detail: String,\n    pub source: String,\n    pub product: Option<ProductId>,\n    /// Where the action leads, with the context it carries.\n    pub target: Option<InboxTarget>,\n    pub action_label: Option<String>,\n    pub facts: Vec<Fact>,\n    /// When it was observed or recorded (seconds since the epoch).\n    pub when: u32,\n    pub hold: Option<HoldView>,\n}\n\n/// The read as a whole.\n#[derive(Clone, Copy, Debug, PartialEq, Eq, Serialize, TS)]\n#[serde(rename_all = \"camelCase\")]\npub enum ReadState {\n    /// Nothing has been read for this tenant yet.\n    Pending,\n    Reading,\n    Done,\n    /// The last read failed; an older read may be shown.\n    Failed,\n}\n\n/// One product's part of the read.\n#[derive(Clone, Copy, Debug, PartialEq, Eq, Serialize, TS)]\n#[serde(rename_all = \"camelCase\")]\npub enum ProductReadState {\n    Pending,\n    Ok,\n    /// Some of its sources were not read.\n    Incomplete,\n    /// A source refused the client for permissions.\n    NeedsRole,\n    Failed,\n    /// Nothing reads this product on Home; its destination does.\n    NotRead,\n}\n\n#[derive(Clone, Debug, PartialEq, Eq, Serialize, TS)]\n#[serde(rename_all = \"camelCase\")]\npub struct ProductRead {\n    pub product: ProductId,\n    pub state: ProductReadState,\n    pub sources_read: u32,\n    pub sources_total: u32,\n    pub detail: Option<String>,\n}\n\n/// The active tenant's read status (I4), derived from the overview read.\n#[derive(Clone, Debug, PartialEq, Eq, Serialize, TS)]\n#[serde(rename_all = \"camelCase\")]\npub struct ReadStatus {\n    pub state: ReadState,\n    pub last_read_at: Option<u32>,\n    /// When the last read failed (seconds since the epoch); with\n    /// `last_read_at`, an older read is shown.\n    pub failed_at: Option<u32>,\n    /// When the latest attempt settled, established or not (seconds since\n    /// the epoch): the time a completion is announced with when nothing was\n    /// established yet.\n    pub settled_at: Option<u32>,\n    pub products: Vec<ProductRead>,\n    /// Sources the last read could not establish, by name.\n    pub sources_missing: Vec<String>,\n    /// Counts completed reads of this tenant in this session: a change is\n    /// a completion the presentation may announce.\n    pub generation: u32,\n    /// The product a `recheckProduct` asked for, until the next read lands.\n    pub rechecking: Option<ProductId>,\n}\n\n/// The Inbox scope (per tenant, I2).\n#[derive(Clone, Debug, PartialEq, Eq, Serialize, TS)]\n#[serde(rename_all = \"camelCase\")]\npub struct InboxView {\n    pub items: Vec<InboxEntry>,\n    pub read: ReadStatus,\n    /// The last snooze placed on this tenant in this session (I11).\n    pub last_snooze: Option<SnoozeReceipt>,\n}\n\nfn product_label(product: ProductId) -> &'static str {\n    match product {\n        ProductId::RuntimeSecurity => \"AI Runtime Security\",\n        ProductId::Gateway => \"AI Gateway\",\n        ProductId::RedTeam => \"AI Red Teaming\",\n        ProductId::ModelSkill => \"Model and skill scans\",\n    }\n}\n\nfn warning_destination(product: ProductId) -> InboxDestination {\n    match product {\n        ProductId::Gateway => InboxDestination::Gateway,\n        _ => InboxDestination::ApiKeys,\n    }\n}\n\n/// Where a setup warning is fixed (C30): the scan key and the management\n/// client live in Settings, a Gateway workspace in AI Gateway, the Red Team\n/// and model/skill services in AI Red Teaming.\nfn warning_target(product: ProductId) -> (InboxTarget, &'static str) {\n    let (feature, label) = match product {\n        ProductId::RuntimeSecurity => (FeatureId::Settings, \"Open Settings\"),\n        ProductId::Gateway => (FeatureId::Gateway, \"Open AI Gateway\"),\n        ProductId::RedTeam | ProductId::ModelSkill => (FeatureId::RedTeam, \"Open AI Red Teaming\"),\n    };\n    (\n        InboxTarget {\n            feature,\n            product: Some(product),\n            resource: None,\n            item: None,\n        },\n        label,\n    )\n}\n\n/// Where a Runtime overview item's action leads: an API key item opens the\n/// API keys inventory filtered to that key.\nfn item_target(item: &InboxItem) -> InboxTarget {\n    match item.destination {\n        InboxDestination::ApiKeys => InboxTarget {\n            feature: FeatureId::Administration,\n            product: Some(ProductId::RuntimeSecurity),\n            resource: Some(ManagementResource::ApiKeys),\n            item: item\n                .facts\n                .iter()\n                .find(|f| f.label == \"Key\")\n                .map(|f| f.value.clone()),\n        },\n        InboxDestination::Sessions => InboxTarget {\n            feature: FeatureId::Sessions,\n            product: Some(ProductId::RuntimeSecurity),\n            resource: None,\n            item: None,\n        },\n        InboxDestination::Gateway => InboxTarget {\n            feature: FeatureId::Gateway,\n            product: Some(ProductId::Gateway),\n            resource: None,\n            item: None,\n        },\n    }\n}\n\n/// A setup warning as an attention item (C29 → C30): the item id is the\n/// warning's `vw-<n>`, so holds address it like any other item.\npub(super) fn setup_warning_item(w: &SetupWarning) -> InboxItem {\n    InboxItem {\n        id: w.id.clone(),\n        title: format!(\"{}: setup warning\", product_label(w.product)),\n        detail: w.reason.clone(),\n        source: \"Setup · verify\".to_owned(),\n        action: true,\n        tone: Tone::Warn,\n        destination: warning_destination(w.product),\n        action_label: warning_target(w.product).1.to_owned(),\n        facts: vec![Fact {\n            label: \"Product\".to_owned(),\n            value: product_label(w.product).to_owned(),\n        }],\n        per_mille: None,\n    }\n}\n\nfn source_state(failure: Option<ManagementFailure>) -> ProductReadState {\n    match failure {\n        None => ProductReadState::Ok,\n        Some(ManagementFailure::Denied | ManagementFailure::Unauthorized) => {\n            ProductReadState::NeedsRole\n        }\n        Some(_) => ProductReadState::Failed,\n    }\n}\n\nfn pending(product: ProductId) -> ProductRead {\n    ProductRead {\n        product,\n        state: ProductReadState::Pending,\n","exit_code":0,"status":"completed"}}
