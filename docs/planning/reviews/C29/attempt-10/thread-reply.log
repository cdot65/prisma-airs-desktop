{"type":"item.completed","item":{"id":"item_40","type":"command_execution","command":"/bin/zsh -lc 'cat crates/desktop-core/tests/ui_v2_onboarding/main.rs'","aggregated_output":"//! C29 (D058): tenant setup through the production authority interface.\n//! The wizard works on one core-owned draft with its own context: credentials\n//! attach to it, verification is decided in the core, completion commits the\n//! draft as a tenant in one step, and a discard or relaunch leaves nothing\n//! behind but a cleanup of its credentials.\n\nuse desktop_core::features::{OnboardingState, ProductId, VerifyLine, VerifyState};\nuse desktop_core::fixtures::{self, Handles, ScriptedStore};\nuse desktop_core::store::PersistedState;\nuse desktop_core::{\n    AuthorityHandle, Core, CoreConfig, Delivery, Intent, Observation, Receipt, Refusal,\n    ShellSnapshot, ViewScope,\n};\nuse serde_json::json;\n\nconst KEY: &str = \"synthetic-scan-key-aaaa\";\n\nstruct Desk {\n    _core: Core,\n    handle: AuthorityHandle,\n    session: String,\n    sequence: u64,\n    adapters: Handles,\n}\n\nimpl Desk {\n    fn new() -> Self {\n        Self::from_state(PersistedState::default())\n    }\n\n    fn from_state(state: PersistedState) -> Self {\n        let (adapters, handles) = fixtures::adapters_with(ScriptedStore::with_state(state));\n        let core = Core::new(CoreConfig::default(), adapters);\n        core.start();\n        let handle = core.operator();\n        let session = handle.register_delivery_session().expect(\"session\").nonce;\n        Self {\n            _core: core,\n            handle,\n            session,\n            sequence: 0,\n            adapters: handles,\n        }\n    }\n\n    fn restart(self) -> Self {\n        let state = self.adapters.store.saved().unwrap_or_default();\n        drop(self._core);\n        Self::from_state(state)\n    }\n\n    async fn send(&mut self, intent: serde_json::Value) -> Result<Receipt, Refusal> {\n        let intent: Intent = serde_json::from_value(intent).expect(\"intent\");\n        self.sequence += 1;\n        self.handle\n            .dispatch(\n                Delivery {\n                    session: self.session.clone(),\n                    sequence: self.sequence,\n                },\n                intent,\n            )\n            .await\n    }\n\n    fn snap(&self) -> ShellSnapshot {\n        match self.handle.observe(ViewScope::Shell).expect(\"observe\") {\n            Observation::Shell { snapshot, .. } => snapshot,\n            _ => unreachable!(\"shell scope\"),\n        }\n    }\n\n    fn setup(&self) -> desktop_core::features::SetupView {\n        self.snap().setup.expect(\"a setup in progress\")\n    }\n\n    async fn begin(&mut self, mode: &str, label: &str) -> String {\n        self.send(\n            json!({\"kind\": \"beginTenantSetup\", \"mode\": mode, \"profile\": {\n                \"label\": label, \"tsgId\": \"1234567890\",\n                \"destination\": {\"kind\": \"region\", \"region\": \"europe\"}, \"environment\": \"staging\"\n            }}),\n        )\n        .await\n        .expect(\"begun\");\n        self.setup().context.as_str().to_owned()\n    }\n\n    /// The draft's current context: it changes whenever its inputs change.\n    fn context(&self) -> String {\n        self.setup().context.as_str().to_owned()\n    }\n\n    async fn settled(&self, ready: bool) {\n        for _ in 0..200 {\n            let s = self.setup();\n            let state = s.tenant.scan.state;\n            let done = if ready {\n                state == desktop_core::ScanState::Ready\n            } else {\n                state != desktop_core::ScanState::Storing\n            };\n            if done {\n                return;\n            }\n            tokio::time::sleep(std::time::Duration::from_millis(5)).await;\n        }\n        panic!(\"the scan key write did not settle\");\n    }\n\n    async fn verified(&self) -> desktop_core::features::VerifyView {\n        for _ in 0..200 {\n            if let Some(v) = self.setup().verify\n                && v.done\n            {\n                return v;\n            }\n            tokio::time::sleep(std::time::Duration::from_millis(5)).await;\n        }\n        panic!(\"verification did not finish\");\n    }\n}\n\n#[tokio::test]\nasync fn a_draft_is_not_a_tenant_and_first_run_needs_the_scan_key_to_verify() {\n    let mut desk = Desk::new();\n    desk.send(json!({\"kind\": \"setUiVariant\", \"variant\": \"v2\"}))\n        .await\n        .expect(\"v2\");\n    let context = desk.begin(\"firstRun\", \"Northwind Health\").await;\n    let snap = desk.snap();\n    assert!(snap.tenants.is_empty(), \"the draft is not listed\");\n    assert!(snap.active.is_none());\n    assert_eq!(snap.onboarding, OnboardingState::Needed);\n    let setup = snap.setup.expect(\"setup\");\n    assert_eq!(setup.tenant.label, \"Northwind Health\");\n    assert_eq!(\n        setup.tenant.environment,\n        desktop_core::features::TenantEnvironment::Staging\n    );\n    assert!(setup.scan_required);\n    assert_eq!(setup.products, vec![ProductId::RuntimeSecurity]);\n    assert!(setup.verify.is_none() && !setup.completable);\n    // A second draft is refused while one is open.\n    assert_eq!(\n        desk.send(json!({\"kind\": \"beginTenantSetup\", \"mode\": \"add\", \"profile\": {\n            \"label\": \"Other\", \"tsgId\": null, \"destination\": {\"kind\": \"region\", \"region\": \"europe\"}}}))\n            .await,\n        Err(Refusal::Busy)\n    );\n    // Without a scan key the verify run fails on first run, so completion is refused.\n    desk.send(json!({\"kind\": \"verifyTenantSetup\", \"context\": context}))\n        .await\n        .expect(\"verify started\");\n    let v = desk.verified().await;\n    let scan = v\n        .steps\n        .iter()\n        .find(|s| s.line == VerifyLine::ScanKey)\n        .expect(\"scan line\");\n    assert_eq!(scan.state, VerifyState::Fail);\n    assert!(v.failed && !desk.setup().completable);\n    assert_eq!(\n        desk.send(json!({\"kind\": \"completeTenantSetup\", \"context\": context, \"packs\": []}))\n            .await,\n        Err(Refusal::InvalidInput)\n    );\n}\n\n#[tokio::test]\nasync fn credentials_attach_to_the_draft_and_a_stored_key_is_never_a_pass() {\n    let mut desk = Desk::new();\n    let context = desk.begin(\"firstRun\", \"Northwind Health\").await;\n    desk.send(json!({\"kind\": \"configureScanCredential\", \"context\": context, \"mode\": \"session\", \"key\": KEY}))\n        .await\n        .expect(\"key accepted for the draft\");\n    desk.settled(true).await;\n    let context = desk.context();\n    assert!(desk.snap().tenants.is_empty(), \"still no tenant\");\n    desk.send(json!({\"kind\": \"verifyTenantSetup\", \"context\": context}))\n        .await\n        .expect(\"verify\");\n    let v = desk.verified().await;\n    let by_line = |line: VerifyLine| v.steps.iter().find(|s| s.line == line).cloned();\n    let scan = by_line(VerifyLine::ScanKey).expect(\"scan\");\n    assert_eq!(\n        scan.state,\n        VerifyState::Stored,\n        \"explicitly unverified, not Pass\"\n    );\n    assert!(scan.reason.contains(\"first scan proves it\"));\n    let management = by_line(VerifyLine::ManagementClient).expect(\"management\");\n    assert_eq!(management.state, VerifyState::Skipped);\n    assert!(\n        by_line(VerifyLine::Gateway).is_none(),\n        \"unselected products have no line\"\n    );\n    assert!(v.done && !v.failed && !v.stale && v.warnings.is_empty());\n    assert!(desk.setup().completable);\n}\n\n#[tokio::test]\nasync fn changing_inputs_makes_results_stale_and_products_needing_a_client_warn() {\n    let mut desk = Desk::new();\n    let context = desk.begin(\"firstRun\", \"Northwind Health\").await;\n    desk.send(json!({\"kind\": \"configureScanCredential\", \"context\": context, \"mode\": \"session\", \"key\": KEY}))\n        .await\n        .expect(\"key\");\n    desk.settled(true).await;\n    let context = desk.context();\n    desk.send(json!({\"kind\": \"verifyTenantSetup\", \"context\": context}))\n        .await\n        .expect(\"verify\");\n    let first = desk.verified().await;\n    assert_eq!(first.generation, 1);\n    // Choosing Gateway afterwards invalidates the run; completion is refused.\n    desk.send(json!({\"kind\": \"chooseSetupProducts\", \"context\": context, \"products\": [\"gateway\", \"gateway\", \"redTeam\"]}))\n        .await\n        .expect(\"products\");\n    let setup = desk.setup();\n    assert_eq!(\n        setup.products,\n        vec![\n            ProductId::RuntimeSecurity,\n            ProductId::Gateway,\n            ProductId::RedTeam\n        ]\n    );\n    assert!(setup.verify.expect(\"kept\").stale && !setup.completable);\n    assert_eq!(\n        desk.send(json!({\"kind\": \"completeTenantSetup\", \"context\": context, \"packs\": []}))\n            .await,\n        Err(Refusal::InvalidInput)\n    );\n    desk.send(json!({\"kind\": \"verifyTenantSetup\", \"context\": context}))\n        .await\n        .expect(\"verify again\");\n    let second = desk.verified().await;\n    assert_eq!(second.generation, 2);\n    assert!(!second.stale);\n    let lines: Vec<(VerifyLine, VerifyState)> =\n        second.steps.iter().map(|s| (s.line, s.state)).collect();\n    assert_eq!(\n        lines,\n        vec![\n            (VerifyLine::ScanKey, VerifyState::Stored),\n            (VerifyLine::ManagementClient, VerifyState::Warning),\n            (VerifyLine::Gateway, VerifyState::Warning),\n            (VerifyLine::RedTeam, VerifyState::Warning),\n            (VerifyLine::Ais, VerifyState::Unavailable),\n            (VerifyLine::Aes, VerifyState::Unavailable),\n        ]\n    );\n    assert_eq!(second.warnings.len(), 3);\n    assert_eq!(second.warnings[1].product, ProductId::Gateway);\n    assert!(desk.setup().completable, \"warnings do not block completion\");\n    // A profile change (new destination) retires the key and goes stale.\n    desk.send(\n        json!({\"kind\": \"updateTenantSetup\", \"context\": context, \"profile\": {\n        \"label\": \"Northwind Health\", \"tsgId\": \"1234567890\",\n        \"destination\": {\"kind\": \"region\", \"region\": \"unitedStates\"}, \"environment\": \"production\"}}),\n    )\n    .await\n    .expect(\"updated\");\n    let setup = desk.setup();\n    assert_eq!(setup.tenant.scan.state, desktop_core::ScanState::Missing);\n    assert_eq!(\n        setup.tenant.environment,\n        desktop_core::features::TenantEnvironment::Production\n    );\n    assert!(\n        setup.verify.is_none() && !setup.completable,\n        \"the run went with the old context\"\n    );\n    assert_ne!(\n        setup.context.as_str(),\n        context,\n        \"a profile change retires the draft's context\"\n    );\n    assert_eq!(\n        desk.send(json!({\"kind\": \"verifyTenantSetup\", \"context\": context}))\n            .await,\n        Err(Refusal::StaleContext)\n    );\n}\n\n#[tokio::test]\nasync fn completion_commits_the_draft_once_with_products_warnings_and_onboarding() {\n    let mut desk = Desk::new();\n    desk.send(json!({\"kind\": \"setUiVariant\", \"variant\": \"v2\"}))\n        .await\n        .expect(\"v2\");\n    desk.send(json!({\"kind\": \"setOnboarding\", \"state\": \"inProgress\"}))\n        .await\n        .expect(\"in progress\");\n    let context = desk.begin(\"firstRun\", \"Northwind Health\").await;\n    desk.send(json!({\"kind\": \"configureScanCredential\", \"context\": context, \"mode\": \"session\", \"key\": KEY}))\n        .await\n        .expect(\"key\");\n    desk.settled(true).await;\n    let context = desk.context();\n    desk.send(json!({\"kind\": \"chooseSetupProducts\", \"context\": context, \"products\": [\"gateway\"]}))\n        .await\n        .expect(\"products\");\n    desk.send(json!({\"kind\": \"verifyTenantSetup\", \"context\": context}))\n        .await\n        .expect(\"verify\");\n    desk.verified().await;\n    // A pack for an unchosen product is refused.\n    assert_eq!(\n        desk.send(json!({\"kind\": \"completeTenantSetup\", \"context\": context, \"packs\": [\"redTeam\"]}))\n            .await,\n        Err(Refusal::InvalidInput)\n    );\n    desk.send(\n        json!({\"kind\": \"completeTenantSetup\", \"context\": context, \"packs\": [\"runtimeSecurity\"]}),\n    )\n    .await\n    .expect(\"completed\");\n    let snap = desk.snap();\n    assert!(snap.setup.is_none());\n    assert_eq!(snap.tenants.len(), 1);\n    let tenant = &snap.tenants[0];\n    assert_eq!(tenant.label, \"Northwind Health\");\n    assert_eq!(\n        tenant.products,\n        vec![ProductId::RuntimeSecurity, ProductId::Gateway]\n    );\n    assert_eq!(\n        tenant.scan.state,\n        desktop_core::ScanState::Ready,\n        \"the key moved with it\"\n    );\n    assert_eq!(\n        tenant.setup_warnings.len(),\n        2,\n        \"management + gateway warnings\"\n    );\n    assert_eq!(tenant.setup_warnings[0].id, \"vw-1\");\n    assert_eq!(tenant.setup_warnings[1].product, ProductId::Gateway);\n    assert!(tenant.setup_warnings[0].recorded_secs > 1_700_000_000);\n    assert_eq!(\n        snap.active.as_ref().map(|a| &a.tenant),\n        Some(&tenant.id),\n        \"active once\"\n    );\n    assert_ne!(\n        snap.active.as_ref().map(|a| a.context.as_str()),\n        Some(context.as_str()),\n        \"a fresh context, not the draft's\"\n    );\n    assert_eq!(snap.onboarding, OnboardingState::Done);\n    assert_eq!(snap.active_feature, desktop_core::features::FeatureId::Home);\n    // The draft's context is retired with it.\n    assert_eq!(\n        desk.send(json!({\"kind\": \"verifyTenantSetup\", \"context\": context}))\n            .await,\n        Err(Refusal::StaleContext)\n    );\n    let saved = desk.adapters.store.saved().expect(\"saved\");\n    assert!(saved.tenant_draft.is_none());\n    assert_eq!(saved.tenant_warnings.len(), 1);\n    let desk = desk.restart();\n    let snap = desk.snap();\n    assert_eq!(snap.onboarding, OnboardingState::Done);\n    assert_eq!(snap.tenants[0].setup_warnings.len(), 2, \"restored\");\n}\n\n#[tokio::test]\nasync fn add_mode_keeps_the_shell_untouched_until_completion_and_discard_cleans_up() {\n    let mut desk = Desk::new();\n    desk.send(json!({\"kind\": \"createTenant\", \"profile\": {\n        \"label\": \"First\", \"tsgId\": \"1111111111\", \"destination\": {\"kind\": \"region\", \"region\": \"europe\"}}}))\n        .await\n        .expect(\"first tenant\");\n    let before = desk.snap();\n    let first = before.active.clone().expect(\"active\");\n    assert_eq!(\n        before.onboarding,\n        OnboardingState::Done,\n        \"an existing tenant means no wizard\"\n    );\n    assert_eq!(\n        desk.send(\n            json!({\"kind\": \"beginTenantSetup\", \"mode\": \"firstRun\", \"profile\": {\n            \"label\": \"X\", \"tsgId\": null, \"destination\": {\"kind\": \"region\", \"region\": \"europe\"}}})\n        )\n        .await,\n        Err(Refusal::InvalidInput),\n        \"first run is impossible once a tenant exists\"\n    );\n    let context = desk.begin(\"add\", \"Second\").await;\n    desk.send(json!({\"kind\": \"configureScanCredential\", \"context\": context, \"mode\": \"keychain\", \"key\": KEY}))\n        .await\n        .expect(\"key in the Keychain\");\n    desk.settled(true).await;\n    let context = desk.context();\n    let records = desk.adapters.vault.records();\n    assert_eq!(records.len(), 1, \"one Keychain record for the draft\");\n    let during = desk.snap();\n    assert_eq!(during.tenants.len(), 1, \"the shell still lists one tenant\");\n    assert_eq!(\n        during.active,\n        Some(first.clone()),\n        \"the active tenant and context are untouched\"\n    );\n    assert!(\n        !during.setup.as_ref().expect(\"setup\").scan_required,\n        \"add mode: the key is optional\"\n    );\n    // Discard: nothing changed, and the draft's record is queued for cleanup.\n    desk.send(json!({\"kind\": \"discardTenantSetup\", \"context\": context}))\n        .await\n        .expect(\"discarded\");\n    let after = desk.snap();\n    assert!(after.setup.is_none());\n    assert_eq!(after.tenants.len(), 1);\n    assert_eq!(after.active, Some(first));\n    let saved = desk.adapters.store.saved().expect(\"saved\");\n    assert!(saved.tenant_draft.is_none());\n    assert!(\n        saved\n            .credentials\n            .iter()\n            .all(|c| c.tenant == before.tenants[0].id)\n    );\n    assert!(\n        saved.pending_cleanup.contains(&records[0])\n            || !desk.adapters.vault.records().contains(&records[0]),\n        \"the draft's Keychain record is being removed\"\n    );\n    assert_eq!(\n        desk.send(json!({\"kind\": \"verifyTenantSetup\", \"context\": context}))\n            .await,\n        Err(Refusal::StaleContext)\n    );\n}\n\n#[tokio::test]\nasync fn add_mode_without_a_key_verifies_with_a_warning_and_completes_switching_once() {\n    let mut desk = Desk::new();\n    desk.send(json!({\"kind\": \"createTenant\", \"profile\": {\n        \"label\": \"First\", \"tsgId\": \"1111111111\", \"destination\": {\"kind\": \"region\", \"region\": \"europe\"}}}))\n        .await\n        .expect(\"first tenant\");\n    let context = desk.begin(\"add\", \"Second\").await;\n    desk.send(json!({\"kind\": \"verifyTenantSetup\", \"context\": context}))\n        .await\n        .expect(\"verify\");\n    let v = desk.verified().await;\n    assert_eq!(\n        v.steps[0].state,\n        VerifyState::Warning,\n        \"no key is a warning in add mode\"\n    );\n    assert!(desk.setup().completable);\n    desk.send(json!({\"kind\": \"completeTenantSetup\", \"context\": context, \"packs\": []}))\n        .await\n        .expect(\"completed\");\n    let snap = desk.snap();\n    assert_eq!(snap.tenants.len(), 2);\n    let second = snap\n        .tenants\n        .iter()\n        .find(|t| t.label == \"Second\")\n        .expect(\"second\");\n    assert_eq!(snap.active.as_ref().map(|a| &a.tenant), Some(&second.id));\n    assert_eq!(second.setup_warnings.len(), 1);\n    assert_eq!(snap.onboarding, OnboardingState::Done);\n}\n\n#[tokio::test]\nasync fn a_relaunch_drops_the_draft_and_queues_its_credentials_for_cleanup() {\n    let mut desk = Desk::new();\n    let context = desk.begin(\"firstRun\", \"Northwind Health\").await;\n    desk.send(json!({\"kind\": \"configureScanCredential\", \"context\": context, \"mode\": \"keychain\", \"key\": KEY}))\n        .await\n        .expect(\"key\");\n    desk.settled(true).await;\n    let saved = desk.adapters.store.saved().expect(\"saved\");\n    assert!(\n        saved.tenant_draft.is_some(),\n        \"the draft is written so its records are known\"\n    );\n    assert_eq!(saved.credentials.len(), 1);\n    assert!(saved.tenants.is_empty());\n    let record = saved.credentials[0].record.clone();\n    let mut desk = desk.restart();\n    let snap = desk.snap();\n    assert!(snap.setup.is_none() && snap.tenants.is_empty());\n    assert_eq!(snap.onboarding, OnboardingState::Needed);\n    // The next write carries no draft; its record was queued for cleanup\n    // (and removed by the start-up cleanup, which the fresh vault records).\n    desk.send(json!({\"kind\": \"setShowCalls\", \"on\": false}))\n        .await\n        .expect(\"saved again\");\n    let saved = desk.adapters.store.saved().expect(\"saved\");\n    assert!(saved.tenant_draft.is_none());\n    assert!(saved.credentials.is_empty());\n    let deleted = desk\n        .adapters\n        .vault\n        .calls()\n        .into_iter()\n        .any(|c| matches!(c, fixtures::VaultCall::Delete(r) if r == record));\n    assert!(\n        deleted || saved.pending_cleanup.contains(&record),\n        \"cleanup reached the vault\"\n    );\n}\n\n#[tokio::test]\nasync fn a_desktop_with_a_tenant_is_never_sent_through_the_wizard() {\n    let mut desk = Desk::new();\n    assert_eq!(desk.snap().onboarding, OnboardingState::Needed);\n    desk.send(json!({\"kind\": \"createTenant\", \"profile\": {\n        \"label\": \"Northwind Health\", \"tsgId\": \"1234567890\",\n        \"destination\": {\"kind\": \"region\", \"region\": \"europe\"}}}))\n        .await\n        .expect(\"created\");\n    assert_eq!(desk.snap().onboarding, OnboardingState::Done);\n    assert_eq!(\n        desk.adapters.store.saved().expect(\"saved\").onboarding,\n        OnboardingState::Needed,\n        \"the stored state is untouched\"\n    );\n    desk.send(json!({\"kind\": \"setUiVariant\", \"variant\": \"v2\"}))\n        .await\n        .expect(\"v2\");\n    assert_eq!(desk.snap().onboarding, OnboardingState::Done);\n}\n\n#[tokio::test]\nasync fn a_draft_id_is_never_selectable_or_deletable_as_a_tenant() {\n    let mut desk = Desk::new();\n    desk.send(json!({\"kind\": \"createTenant\", \"profile\": {\n        \"label\": \"First\", \"tsgId\": \"1111111111\", \"destination\": {\"kind\": \"region\", \"region\": \"europe\"}}}))\n        .await\n        .expect(\"first tenant\");\n    let before = desk.snap();\n    desk.begin(\"add\", \"Second\").await;\n    let draft_id = desk.setup().tenant.id.as_str().to_owned();\n    assert_eq!(\n        desk.send(json!({\"kind\": \"selectTenant\", \"tenant\": draft_id}))\n            .await,\n        Err(Refusal::InvalidInput),\n        \"a draft is not a tenant\"\n    );\n    assert_eq!(\n        desk.send(json!({\"kind\": \"deleteTenant\", \"tenant\": draft_id}))\n            .await,\n        Err(Refusal::InvalidInput)\n    );\n    let after = desk.snap();\n    assert_eq!(after.active, before.active);\n    assert_eq!(after.tenants, before.tenants);\n    let saved = desk.adapters.store.saved().expect(\"saved\");\n    assert_eq!(saved.active_tenant, before.active.map(|a| a.tenant));\n    assert!(\n        saved.tenant_draft.is_some(),\n        \"the draft itself is still there\"\n    );\n}\n\n#[tokio::test]\nasync fn a_tenant_created_outside_the_wizard_ends_a_first_run_draft_and_the_shell_takes_over() {\n    // The v1 import during first run commits tenants through the same path.\n    let mut desk = Desk::new();\n    desk.send(json!({\"kind\": \"setUiVariant\", \"variant\": \"v2\"}))\n        .await\n        .expect(\"v2\");\n    desk.send(json!({\"kind\": \"setOnboarding\", \"state\": \"inProgress\"}))\n        .await\n        .expect(\"in progress\");\n    let context = desk.begin(\"firstRun\", \"Drafted\").await;\n    desk.send(json!({\"kind\": \"configureScanCredential\", \"context\": context, \"mode\": \"keychain\", \"key\": KEY}))\n        .await\n        .expect(\"key\");\n    desk.settled(true).await;\n    let record = desk.adapters.vault.records()[0].clone();\n    desk.send(json!({\"kind\": \"createTenant\", \"profile\": {\n        \"label\": \"Imported\", \"tsgId\": \"2222222222\", \"destination\": {\"kind\": \"region\", \"region\": \"europe\"}}}))\n        .await\n        .expect(\"imported tenant\");\n    let snap = desk.snap();\n    assert!(snap.setup.is_none(), \"the first-run draft is over\");\n    assert_eq!(\n        snap.onboarding,\n        OnboardingState::Done,\n        \"a tenant exists: the shell takes over\"\n    );\n    assert_eq!(snap.tenants.len(), 1);\n    assert_eq!(snap.tenants[0].label, \"Imported\");\n    let saved = desk.adapters.store.saved().expect(\"saved\");\n    assert!(saved.tenant_draft.is_none());\n    assert!(\n        saved.credentials.is_empty(),\n        \"the draft's record left the ledger\"\n    );\n    let deleted = desk\n        .adapters\n        .vault\n        .calls()\n        .into_iter()\n        .any(|c| matches!(c, fixtures::VaultCall::Delete(r) if r == record));\n    assert!(\n        deleted || saved.pending_cleanup.contains(&record),\n        \"its Keychain record is cleaned up\"\n    );\n    let desk = desk.restart();\n    assert_eq!(\n        desk.snap().onboarding,\n        OnboardingState::Done,\n        \"and stays so after a relaunch\"\n    );\n}\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_41","type":"command_execution","command":"/bin/zsh -lc \"cat apps/desktop/src/v2/wizard/wizard-boards.test.tsx; sed -n '1,235p' apps/desktop/src/v2/wizard/wizard.test.tsx\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_41","type":"command_execution","command":"/bin/zsh -lc \"cat apps/desktop/src/v2/wizard/wizard-boards.test.tsx; sed -n '1,235p' apps/desktop/src/v2/wizard/wizard.test.tsx\"","aggregated_output":"/**\n * Every R2Onboard board (boards.md) renders from its fixture with the\n * reviewed state visible: the wizard opened on the step, over the setup\n * draft the core would hold, through the real contract shape.\n */\nimport { render, screen, within } from '@testing-library/react'\nimport userEvent from '@testing-library/user-event'\nimport { describe, expect, it, vi } from 'vitest'\nimport { Wizard } from './wizard'\nimport type { Dispatch } from '../../features/tenants/dispatch'\nimport { DRAFT_CONTEXT, fxAddTenant, fxAddTenantDrafted, fxOn, type WizardBoard } from './fixtures'\n\nfunction mount(board: WizardBoard) {\n    const dispatch = vi.fn<Dispatch>(async () => ({ kind: 'admitted', operation: null }))\n    const onClose = vi.fn()\n    render(<Wizard snapshot={board.snapshot} dispatch={dispatch} observeManagement={async () => ({ kind: 'verified' as const })} mode={board.mode} onClose={onClose} onNavigate={() => undefined} initial={board.initial} />)\n    return { dispatch, onClose }\n}\nconst current = () => screen.getByRole('navigation', { name: 'Setup steps' }).querySelector('[aria-current=\"step\"]')?.textContent\n\ndescribe('R2Onboard boards', () => {\n    it('R2On01 welcome: three cards and the API-builder framing, no shell, no Back', () => {\n        mount(fxOn.welcome())\n        expect(screen.getByRole('heading', { level: 1, name: 'Welcome to Prisma AIRS Desktop' })).toBeInTheDocument()\n        expect(within(screen.getByRole('main')).getAllByRole('listitem')).toHaveLength(3)\n        expect(screen.queryByRole('navigation', { name: 'Destinations' })).toBeNull()\n        expect(screen.queryByRole('button', { name: 'Back' })).toBeNull()\n    })\n    it('R2On02 tenant empty: nothing drafted, Continue names what is missing, no context line', () => {\n        mount(fxOn.tenantEmpty())\n        expect(current()).toBe('2Tenant')\n        expect(screen.getByRole('button', { name: 'Create tenant' })).toBeEnabled()\n        expect(screen.getByRole('button', { name: 'Create the tenant to continue' })).toBeDisabled()\n        expect(screen.queryByLabelText('Scan API key', { selector: 'input' })).toBeNull()\n        expect(document.querySelector('[data-slot=\"rail-context\"]')).toBeNull()\n    })\n    it('R2On02b tenant filled: the context line, the editable profile, credential controls and Continue', () => {\n        mount(fxOn.tenantFilled())\n        expect(document.querySelector('[data-slot=\"rail-context\"]')).toHaveTextContent('Northwind Health · Staging · TSG 1762204418')\n        expect(screen.getByLabelText(/Display name/)).toHaveValue('Northwind Health')\n        expect(within(screen.getByRole('radiogroup', { name: 'Environment' })).getByRole('radio', { name: 'Staging' })).toBeChecked()\n        expect(screen.getByRole('button', { name: 'Save changes' })).toBeInTheDocument()\n        expect(screen.getByRole('button', { name: 'Replace scan key' })).toBeInTheDocument()\n        expect(screen.getByRole('button', { name: 'Remove scan key' })).toBeInTheDocument()\n        expect(screen.getByRole('button', { name: 'Save management client' })).toBeInTheDocument()\n        expect(screen.getByRole('switch', { name: 'Set up an AI Gateway workspace now' })).not.toBeChecked()\n        expect(screen.getByRole('button', { name: 'Continue' })).toBeEnabled()\n    })\n    it('R2On03 products: Runtime always on, AIS and AES not selectable, reads-with state per card', () => {\n        mount(fxOn.products())\n        const boxes = screen.getAllByRole('checkbox')\n        expect(boxes.map((b) => b.getAttribute('aria-disabled') === 'true')).toEqual([true, false, false, false, true, true])\n        expect(screen.getByRole('checkbox', { name: /AI Gateway/ })).toBeChecked()\n        expect(screen.getByText('Always on')).toBeInTheDocument()\n        expect(screen.getByText('Scan key saved')).toBeInTheDocument()\n        expect(screen.getAllByText('Needs the management client')).toHaveLength(3)\n        expect(screen.getByText(/Licence state is not readable through the public APIs/)).toBeInTheDocument()\n    })\n    it('R2On04 verify running: the list is busy and Continue waits', () => {\n        mount(fxOn.verifyRunning())\n        expect(screen.getByRole('list', { name: 'Checks' })).toHaveAttribute('aria-busy', 'true')\n        expect(screen.getByRole('button', { name: 'Continue' })).toBeDisabled()\n        expect(within(document.querySelector('[data-slot=\"verify-gateway\"]') as HTMLElement).getByText('Pending')).toBeInTheDocument()\n        expect(screen.getByText('Checking…')).toBeInTheDocument()\n    })\n    it('R2On04b verify warning: Continue with warnings is offered because the core says the run is completable', () => {\n        mount(fxOn.verifyWarn())\n        expect(screen.getByText('Checks finished with warnings.')).toBeInTheDocument()\n        expect(screen.getByRole('button', { name: 'Continue with warnings' })).toBeEnabled()\n        expect(screen.getByRole('button', { name: 'Verify again' })).toBeEnabled()\n    })\n    it('R2On04c verify fail (required): Continue is disabled; Fix and verify again returns to Tenant with the profile and credential controls', async () => {\n        const user = userEvent.setup()\n        mount(fxOn.verifyFail())\n        expect(screen.getByText('A required check failed.')).toBeInTheDocument()\n        expect(screen.getByRole('button', { name: 'Continue' })).toBeDisabled()\n        expect(screen.queryByRole('button', { name: 'Continue with warnings' })).toBeNull()\n        expect(screen.getByRole('button', { name: 'Verify again' })).toBeEnabled()\n        expect(within(document.querySelector('[data-slot=\"verify-ais\"]') as HTMLElement).getByText('Not available')).toBeInTheDocument()\n        expect(within(document.querySelector('[data-slot=\"verify-aes\"]') as HTMLElement).getByText('Not available')).toBeInTheDocument()\n        await user.click(screen.getByRole('button', { name: 'Fix and verify again' }))\n        expect(screen.getByRole('heading', { level: 1, name: 'Connect your tenant' })).toHaveFocus()\n        expect(screen.getByLabelText(/TSG ID/)).toHaveValue('1762204418')\n        expect(screen.getByRole('button', { name: 'Replace management client' })).toBeInTheDocument()\n        expect(screen.getByRole('button', { name: 'Remove management client' })).toBeInTheDocument()\n        expect(screen.getByText('Client ID: svc@1762204418.iam.example', { exact: false })).toBeInTheDocument()\n    })\n    it('R2On04c-opt optional failure: the operator may fix it or continue with it recorded as a warning', async () => {\n        const user = userEvent.setup()\n        const { dispatch } = mount(fxOn.verifyOptionalFail())\n        expect(screen.getByText(/An optional check failed/)).toBeInTheDocument()\n        expect(screen.getByRole('button', { name: 'Fix and verify again' })).toBeEnabled()\n        expect(screen.getByRole('button', { name: 'Verify again' })).toBeEnabled()\n        await user.click(screen.getByRole('button', { name: 'Continue with warnings' }))\n        expect(screen.getByRole('heading', { level: 1, name: 'Load starter test cases' })).toBeInTheDocument()\n        expect(dispatch).not.toHaveBeenCalled()\n    })\n    it('R2On04d verify stale: the run no longer counts and later steps are unreachable', () => {\n        mount(fxOn.verifyStale())\n        expect(screen.getByText('The inputs changed since this run. Verify again before continuing.')).toBeInTheDocument()\n        expect(screen.getByRole('button', { name: 'Continue' })).toBeDisabled()\n        const rail = screen.getByRole('navigation', { name: 'Setup steps' })\n        expect(within(rail).getByRole('button', { name: /Done$/ })).toBeDisabled()\n    })\n    it('R2On05 packs: one checkbox per chosen product with its count; Skip clears the choice', async () => {\n        const user = userEvent.setup()\n        mount(fxOn.packs())\n        expect(screen.getByRole('checkbox', { name: 'AI Runtime Security · 6 cases' })).toBeChecked()\n        await user.click(screen.getByRole('button', { name: 'Skip for now' }))\n        expect(screen.getByRole('heading', { level: 1, name: 'Join the AI Security Academy' })).toBeInTheDocument()\n    })\n    it('R2On06 academy: the reviewed account component with sign-in or skip and the sync disclosure', () => {\n        mount(fxOn.academy())\n        expect(screen.getByRole('button', { name: 'Sign in to Academy' })).toBeInTheDocument()\n        expect(screen.getByRole('button', { name: 'Skip for now' })).toBeInTheDocument()\n        expect(screen.getByText(/syncs your Academy progress only/)).toBeInTheDocument()\n    })\n    it('R2On07 done: the summary matches the core’s draft and Open Prisma AIRS sends one completion', async () => {\n        const user = userEvent.setup()\n        const { dispatch } = mount(fxOn.done())\n        expect(screen.getByRole('heading', { level: 1, name: /is ready$/ })).toBeInTheDocument()\n        expect(document.querySelector('[data-slot=\"summary\"]')).toHaveTextContent('Products: AI Runtime Security')\n        // The checks line counts the verification states (a stored key, a skipped client, two unavailable products): never \"All passed\".\n        expect(document.querySelector('[data-slot=\"summary\"]')).toHaveTextContent('Checks: 1 stored, not checked · 1 not checked · 2 not available')\n        expect(document.querySelector('[data-slot=\"summary\"]')).not.toHaveTextContent('All passed')\n        await user.click(screen.getByRole('button', { name: 'Open Prisma AIRS' }))\n        expect(dispatch).toHaveBeenCalledWith({ kind: 'completeTenantSetup', context: DRAFT_CONTEXT, packs: ['runtimeSecurity'], resolution: null })\n        expect(screen.getByRole('button', { name: 'Opening…' })).toBeDisabled()\n    })\n    it('R2AddTenant: no Welcome or Academy step, a 244px rail, Cancel on every step and no Back on the first', () => {\n        mount(fxAddTenant())\n        const rail = screen.getByRole('navigation', { name: 'Setup steps' })\n        expect(within(rail).getAllByRole('button').map((b) => b.textContent)).toEqual(['1Tenant', '2Products', '3Verify', '4Starter casesOptional', '5Done', 'Light appearance'])\n        expect(screen.getByRole('button', { name: 'Cancel' })).toBeInTheDocument()\n        expect(rail).toHaveStyle({ width: '244px' })\n        expect(screen.getByText(/Cancel discards this draft and removes any credential it saved/)).toBeInTheDocument()\n        expect(screen.queryByRole('button', { name: 'Back' })).toBeNull()\n    })\n    it('R2AddTenant drafted: the scan key is optional and Continue is open', () => {\n        mount(fxAddTenantDrafted())\n        expect(screen.getByText(/Optional here; without it scans stay unavailable/)).toBeInTheDocument()\n        expect(screen.getByRole('button', { name: 'Continue' })).toBeEnabled()\n    })\n})\n/**\n * The first-run wizard and add-tenant sheet (C29) over the scripted native\n * transport: the draft, its credentials, the chosen products, the verify run\n * and the completion gate all live in the core's `setup`; this presentation\n * only walks the steps, sends intents and shows what the snapshot says.\n */\nimport { render, screen, waitFor, within } from '@testing-library/react'\nimport userEvent from '@testing-library/user-event'\nimport { beforeEach, describe, expect, it } from 'vitest'\nimport { DeliveryOutcomeUnknown, DesktopClient, type ShellSnapshot } from '@prisma-airs/desktop-contracts'\nimport { App } from '../../app'\nimport { scriptedNative, tenant, withTenant, type Native } from '../../test/native'\nimport { fxHome, fxSwitcher } from '../fixtures'\nimport { resetShellStore } from '../store'\nimport { DRAFT_CONTEXT, draft, setupView, verifyView } from './fixtures'\n\n/** fx.on.welcome: v2 with onboarding still needed. */\nfunction fxOnboarding(): ShellSnapshot {\n    return { ...fxHome(), onboarding: 'needed', tenants: [], active: null }\n}\n\nasync function launch(snapshot: ShellSnapshot): Promise<Native> {\n    const native = scriptedNative(snapshot)\n    render(<App client={new DesktopClient(native.transport)} />)\n    await screen.findByRole('heading', { level: 1 })\n    return native\n}\nconst admitted = (operation: string | null = null) => ({ outcome: 'receipt', receipt: { kind: 'admitted', request: 'rq-1', operation } })\n\nbeforeEach(() => resetShellStore())\n\ndescribe('first-run wizard', () => {\n    it('opens on Welcome, marks the wizard in progress only once the core admits it, and keeps a refusal visible', async () => {\n        const user = userEvent.setup()\n        const native = await launch(fxOnboarding())\n        expect(screen.getByRole('heading', { level: 1, name: 'Welcome to Prisma AIRS Desktop' })).toBeInTheDocument()\n        expect(screen.getByText(/built entirely on Palo Alto Networks’ own public APIs/)).toBeInTheDocument()\n        expect(screen.queryByRole('button', { name: 'Back' })).toBeNull()\n        native.respond = () => ({ outcome: 'refusal', refusal: 'deniedStore' })\n        await user.click(screen.getByRole('button', { name: 'Set up a tenant' }))\n        expect(native.dispatched.at(-1)).toEqual({ kind: 'setOnboarding', state: 'inProgress' })\n        expect(screen.getByRole('heading', { level: 1, name: 'Welcome to Prisma AIRS Desktop' })).toBeInTheDocument()\n        expect(document.querySelector('[data-slot=\"wizard-status\"]')).toHaveTextContent(/Keychain|denied|store/i)\n        native.respond = () => admitted()\n        await user.click(screen.getByRole('button', { name: 'Set up a tenant' }))\n        expect(screen.getByRole('heading', { level: 1, name: 'Connect your tenant' })).toHaveFocus()\n    })\n\n    it('validates per field, drafts the tenant in the core, and attaches the scan key to the draft context once without echoing it', async () => {\n        const user = userEvent.setup()\n        const native = await launch({ ...fxOnboarding(), onboarding: 'inProgress' })\n        expect(screen.getByRole('heading', { level: 1, name: 'Connect your tenant' })).toBeInTheDocument()\n        expect(screen.getByRole('button', { name: 'Create the tenant to continue' })).toBeDisabled()\n        await user.click(screen.getByRole('button', { name: 'Create tenant' }))\n        const name = screen.getByLabelText(/Display name/)\n        expect(name).toHaveAttribute('aria-invalid', 'true')\n        expect(name).toHaveAccessibleDescription('Enter a display name.')\n        expect(native.dispatched.filter((i) => i.kind === 'beginTenantSetup')).toHaveLength(0)\n        await user.type(name, 'Northwind Health')\n        await user.click(within(screen.getByRole('radiogroup', { name: 'Environment' })).getByRole('radio', { name: 'Staging' }))\n        await user.selectOptions(screen.getByLabelText('Region'), 'europe')\n        await user.type(screen.getByLabelText(/TSG ID/), '1762204418')\n        await user.click(screen.getByRole('button', { name: 'Create tenant' }))\n        expect(native.dispatched.at(-1)).toEqual({ kind: 'beginTenantSetup', mode: 'firstRun', profile: { label: 'Northwind Health', tsgId: '1762204418', destination: { kind: 'region', region: 'europe' }, environment: 'staging' } })\n        // The core holds the draft; nothing is a tenant yet.\n        await native.push({ ...native.current, setup: setupView({ tenant: draft() }) })\n        expect(await screen.findByText('Northwind Health is drafted. Add its scan key below.')).toBeInTheDocument()\n        expect(native.current.tenants).toEqual([])\n        expect(document.querySelector('[data-slot=\"rail-context\"]')).toHaveTextContent('Northwind Health · Staging · TSG 1762204418')\n        expect(screen.getByRole('button', { name: 'Save the scan key to continue' })).toBeDisabled()\n        const key = screen.getByLabelText('Scan API key', { selector: 'input' })\n        expect(key).toHaveAttribute('type', 'password')\n        await user.type(key, 'synthetic-scan-key-aaaa')\n        await user.click(screen.getByRole('button', { name: 'Save scan key' }))\n        expect(native.dispatched.at(-1)).toEqual({ kind: 'configureScanCredential', context: DRAFT_CONTEXT, mode: 'keychain', key: 'synthetic-scan-key-aaaa' })\n        expect((key as HTMLInputElement).value).toBe('')\n        expect(document.body.innerHTML).not.toContain('synthetic-scan-key-aaaa')\n        await native.push({ ...native.current, setup: setupView() })\n        expect(within(document.querySelector('[data-slot=\"scan-state\"]') as HTMLElement).getByText('Saved')).toBeInTheDocument()\n        expect(screen.getByRole('button', { name: 'Replace scan key' })).toBeInTheDocument()\n        expect(screen.getByRole('button', { name: 'Remove scan key' })).toBeInTheDocument()\n        expect(screen.getByRole('button', { name: 'Continue' })).toBeEnabled()\n        // Editing the profile goes through updateTenantSetup on the draft.\n        await user.type(screen.getByLabelText(/Display name/), ' EU')\n        await user.click(screen.getByRole('button', { name: 'Save changes' }))\n        expect(native.dispatched.at(-1)).toEqual({ kind: 'updateTenantSetup', context: DRAFT_CONTEXT, profile: { label: 'Northwind Health EU', tsgId: '1762204418', destination: { kind: 'region', region: 'europe' }, environment: 'staging' } })\n    })\n\n    it('sets up a Gateway workspace on the draft: lists through the management client, chooses one, saves the endpoint and key once', async () => {\n        const user = userEvent.setup()\n        const clientReady = draft({ scan: { state: 'ready', mode: 'keychain', failure: null }, management: { state: 'ready', mode: 'keychain', failure: null, clientId: 'svc@1762204418.iam.example', tokenOrigin: 'https://auth.apps.paloaltonetworks.com' } })\n        const native = await launch({ ...fxOnboarding(), onboarding: 'inProgress', setup: setupView({ tenant: clientReady }) })\n        await user.click(screen.getByRole('switch', { name: 'Set up an AI Gateway workspace now' }))\n        native.respond = () => admitted('op-7')\n        native.observeManagement = () => ({ kind: 'management', result: { kind: 'gateway', gateway: { kind: 'list', list: { resource: 'workspaces', workspace: null, rows: JSON.stringify([{ id: 'ws-1', name: 'Harness' }, { id: 'ws-2', name: 'Lab' }]), count: 2, total: 2, complete: true } } } })\n        await user.click(screen.getByRole('button', { name: 'Read workspaces' }))\n        expect(native.dispatched.at(-1)).toEqual({ kind: 'management', context: DRAFT_CONTEXT, request: { kind: 'gateway', workspace: null, read: { kind: 'inventory', resource: 'workspaces' } } })\n        const chooser = await screen.findByLabelText('Workspace')\n        await user.selectOptions(chooser, 'ws-2')\n        native.respond = () => admitted()\n        await user.click(screen.getByRole('button', { name: 'Use this workspace' }))\n        expect(native.dispatched.at(-1)).toEqual({ kind: 'selectGatewayWorkspace', context: DRAFT_CONTEXT, workspace: 'ws-2' })\n        expect(await screen.findByText('Workspace Lab chosen.')).toBeInTheDocument()\n        // The core records the choice on the draft; the key is configured under its reference.\n        await native.push({ ...native.current, setup: setupView({ tenant: clientReady, workspace: { reference: 'gw-ref-0001', workspace: { id: 'ws-2', name: 'Lab', slug: 'lab', scopeName: 'Lab' }, restored: false } }) })\n        await user.type(await screen.findByLabelText(/Inference endpoint/), 'https://gateway.example.test/v1')\n        const key = screen.getByLabelText('Workspace inference key', { selector: 'input' })\n        await user.type(key, 'synthetic-workspace-key-zz')\n        await user.click(screen.getByRole('button', { name: 'Save workspace key' }))\n        expect(native.dispatched.at(-1)).toEqual({ kind: 'configureInferenceCredential', context: DRAFT_CONTEXT, mode: 'keychain', workspace: 'gw-ref-0001', endpoint: 'https://gateway.example.test/v1', secret: 'synthetic-workspace-key-zz' })\n        expect((key as HTMLInputElement).value).toBe('')\n        expect(document.body.innerHTML).not.toContain('synthetic-workspace-key-zz')\n    })\n\n    it('records products in the core, verifies through one core-owned run, gates Continue on the snapshot, and completes with one intent', async () => {\n        const user = userEvent.setup()\n        const native = await launch({ ...fxOnboarding(), onboarding: 'inProgress', setup: setupView() })\n        await user.click(screen.getByRole('button', { name: 'Continue' }))\n        expect(screen.getByRole('heading', { level: 1, name: 'Which products will you manage?' })).toBeInTheDocument()\n        const boxes = screen.getAllByRole('checkbox')\n        expect(boxes.map((b) => b.getAttribute('aria-disabled') === 'true')).toEqual([true, false, false, false, true, true])\n        expect(boxes[0]).toBeChecked()\n        expect(screen.getAllByText('Not available in this release')).toHaveLength(2)\n        await user.click(screen.getByRole('checkbox', { name: /AI Gateway/ }))\n        expect(native.dispatched.at(-1)).toEqual({ kind: 'chooseSetupProducts', context: DRAFT_CONTEXT, products: ['runtimeSecurity', 'gateway'] })\n        await native.push({ ...native.current, setup: setupView({ products: ['runtimeSecurity', 'gateway'], packs: [{ product: 'runtimeSecurity', count: 6 }, { product: 'gateway', count: 2 }] }) })\n        await user.click(screen.getByRole('button', { name: 'Continue' }))\n        // Verify: rows are planned until a run exists (AIS/AES listed as not available); Continue waits for the core's gate.\n        expect(screen.getAllByText('Not run yet')).toHaveLength(3)\n        expect(screen.getAllByText('Not available')).toHaveLength(2)\n        expect(screen.getByRole('button', { name: 'Continue' })).toBeDisabled()\n        await user.click(screen.getByRole('button', { name: 'Run the checks' }))\n        expect(native.dispatched.at(-1)).toEqual({ kind: 'verifyTenantSetup', context: DRAFT_CONTEXT })\n        const stored = { line: 'scanKey' as const, product: 'runtimeSecurity' as const, state: 'stored' as const, reason: 'Stored in the Keychain. Not checked here: the first scan proves it against the service.' }\n        const warning = { line: 'managementClient' as const, product: 'runtimeSecurity' as const, state: 'warning' as const, reason: 'No management client: AI Gateway stay read-only until one is saved in Administration.' }\n        const gatewayPending = { line: 'gateway' as const, product: 'gateway' as const, state: 'pending' as const, reason: 'Reading…' }\n        await native.push({ ...native.current, setup: setupView({ products: ['runtimeSecurity', 'gateway'], verify: verifyView([stored, warning, gatewayPending]) }) })\n        expect(await screen.findByRole('list', { name: 'Checks' })).toHaveAttribute('aria-busy', 'true')\n        expect(within(document.querySelector('[data-slot=\"verify-scanKey\"]') as HTMLElement).getByText('Stored')).toBeInTheDocument()\n        expect(screen.getByRole('button', { name: 'Continue' })).toBeDisabled()\n        const gatewayWarn = { ...gatewayPending, state: 'warning' as const, reason: 'Needs the management client; not checked.' }\n        await native.push({ ...native.current, setup: setupView({ products: ['runtimeSecurity', 'gateway'], verify: verifyView([stored, warning, gatewayWarn]) }) })\n        expect(await screen.findByText('Checks finished with warnings.')).toBeInTheDocument()\n        expect(screen.getByRole('button', { name: 'Continue with warnings' })).toBeEnabled()\n        // An edit makes the run stale: the core says so and the gate closes.\n        await native.push({ ...native.current, setup: setupView({ products: ['runtimeSecurity', 'gateway'], verify: verifyView([stored, warning, gatewayWarn], { stale: true }) }) })\n        expect(await screen.findByText('The inputs changed since this run. Verify again before continuing.')).toBeInTheDocument()\n        expect(screen.getByRole('button', { name: 'Continue' })).toBeDisabled()\n        await native.push({ ...native.current, setup: setupView({ products: ['runtimeSecurity', 'gateway'], packs: [{ product: 'runtimeSecurity', count: 6 }, { product: 'gateway', count: 2 }], verify: verifyView([stored, warning, gatewayWarn]) }) })\n        await user.click(await screen.findByRole('button', { name: 'Continue with warnings' }))\n        // Packs per chosen product with counts; Academy through the reviewed account component.\n        expect(screen.getByRole('checkbox', { name: 'AI Runtime Security · 6 cases' })).toBeChecked()\n        await user.click(screen.getByRole('checkbox', { name: 'AI Gateway · 2 cases' }))\n        // A product dropped later takes its pack with it (the core would refuse a stray pack).\n        await native.push({ ...native.current, setup: setupView({ products: ['runtimeSecurity'], packs: [{ product: 'runtimeSecurity', count: 6 }], verify: verifyView([stored, warning]) }) })\n        expect(screen.queryByRole('checkbox', { name: /AI Gateway/ })).toBeNull()\n        await native.push({ ...native.current, setup: setupView({ products: ['runtimeSecurity', 'gateway'], packs: [{ product: 'runtimeSecurity', count: 6 }, { product: 'gateway', count: 2 }], verify: verifyView([stored, warning, gatewayWarn]) }) })\n        expect(await screen.findByRole('checkbox', { name: 'AI Gateway · 2 cases' })).not.toBeChecked()\n        await user.click(screen.getByRole('button', { name: 'Continue' }))\n        expect(screen.getByRole('heading', { level: 1, name: 'Join the AI Security Academy' })).toBeInTheDocument()\n        expect(screen.getByText(/syncs your Academy progress only/)).toBeInTheDocument()\n        expect(screen.getByRole('button', { name: 'Sign in to Academy' })).toBeInTheDocument()\n        await user.click(screen.getByRole('button', { name: 'Skip for now' }))\n        expect(screen.getByRole('heading', { level: 1, name: /is ready$/ })).toBeInTheDocument()\n        expect(document.querySelector('[data-slot=\"summary\"]')).toHaveTextContent('Products: AI Runtime Security, AI Gateway')\n        expect(document.querySelector('[data-slot=\"summary\"]')).toHaveTextContent('Starter cases: AI Runtime Security')\n        // Completion is one intent; the shell takes over when the core confirms.\n        await user.click(screen.getByRole('button', { name: 'Open Prisma AIRS' }))\n        expect(native.dispatched.at(-1)).toEqual({ kind: 'completeTenantSetup', context: DRAFT_CONTEXT, packs: ['runtimeSecurity'], resolution: null })\n        expect(screen.getByRole('button', { name: 'Opening…' })).toBeDisabled()\n        const nw = tenant({ id: 'tn-0123456789abcdef', label: 'Northwind Health', tsgId: '1762204418', environment: 'staging', products: ['runtimeSecurity', 'gateway'] })\n        await native.push(withTenant({ ...native.current, onboarding: 'done', setup: null }, nw))\n        expect(await screen.findByRole('navigation', { name: 'Destinations' })).toBeInTheDocument()\n    })\n\n    it('keeps a refused or unconfirmed completion visible with Retry instead of closing', async () => {\n        const user = userEvent.setup()\n        const verified = verifyView([{ line: 'scanKey', product: 'runtimeSecurity', state: 'stored', reason: 'Stored.' }, { line: 'managementClient', product: 'runtimeSecurity', state: 'skipped', reason: 'No client.' }])\n        const native = await launch({ ...fxOnboarding(), onboarding: 'inProgress', setup: setupView({ verify: verified }) })\n        for (const step of ['Continue', 'Continue', 'Continue', 'Continue', 'Skip for now']) await user.click(screen.getByRole('button', { name: step }))\n        expect(screen.getByRole('heading', { level: 1, name: /is ready$/ })).toBeInTheDocument()\n        native.respond = () => ({ outcome: 'refusal', refusal: 'invalidInput' })\n        await user.click(screen.getByRole('button', { name: 'Open Prisma AIRS' }))\n        expect(await screen.findByText('Check the entered values and try again.')).toBeInTheDocument()\n        expect(screen.getByRole('button', { name: 'Open Prisma AIRS' })).toBeEnabled()\n        native.respond = () => {\n            throw new DeliveryOutcomeUnknown('lost')\n        }\n        await user.click(screen.getByRole('button', { name: 'Open Prisma AIRS' }))\n        expect(await screen.findByText('Sent but not confirmed. The current state is shown.')).toBeInTheDocument()\n        native.respond = () => admitted()\n        // (An unconfirmed delivery is re-sent once by the client before it gives up.)\n        const sent = native.dispatched.length\n        await user.click(screen.getByRole('button', { name: 'Retry' }))\n        expect(native.dispatched.length).toBe(sent + 1)\n        expect(native.dispatched.at(-1)).toEqual({ kind: 'completeTenantSetup', context: DRAFT_CONTEXT, packs: ['runtimeSecurity'], resolution: null })\n    })\n\n    it('opens from the switcher as a modal with the 244px rail and no Welcome or Academy step; Cancel before a draft sends nothing', async () => {\n        const user = userEvent.setup()\n        const native = await launch(fxSwitcher())\n        await user.click(screen.getByRole('button', { name: /^Switch tenant/ }))\n        await user.click(screen.getByRole('button', { name: 'Add a tenant…' }))\n        const sheet = screen.getByRole('dialog', { name: 'Add a tenant' })\n        expect(sheet).toHaveAttribute('aria-modal', 'true')\n        expect(sheet.style.maxHeight).toBe('92vh')\n        const steps = within(sheet).getByRole('navigation', { name: 'Setup steps' })\n        expect(within(steps).getAllByRole('button').map((b) => b.textContent)).toEqual(['1Tenant', '2Products', '3Verify', '4Starter casesOptional', '5Done', 'Light appearance'])\n        expect(within(sheet).getByRole('button', { name: 'Cancel' })).toBeInTheDocument()\n        expect(steps).toHaveStyle({ width: '244px' })\n        expect(within(sheet).queryByRole('button', { name: 'Back' })).toBeNull()\n        await user.click(within(sheet).getByRole('button', { name: 'Cancel' }))\n        expect(screen.queryByRole('dialog')).toBeNull()\n        expect(native.dispatched.filter((i) => i.kind !== 'navigate')).toEqual([])\n    })\n\n    it('drafts in add mode with an optional key, discards the draft on Cancel, and leaves the shell as it was', async () => {\n        const user = userEvent.setup()\n        const native = await launch(fxSwitcher())\n        await user.click(screen.getByRole('button', { name: /^Switch tenant/ }))\n        await user.click(screen.getByRole('button', { name: 'Add a tenant…' }))\n        const sheet = screen.getByRole('dialog', { name: 'Add a tenant' })\n        await user.type(within(sheet).getByLabelText(/Display name/), 'Coastal Bank')\n        await user.type(within(sheet).getByLabelText(/TSG ID/), '2000000001')\n        await user.click(within(sheet).getByRole('button', { name: 'Create tenant' }))\n        expect(native.dispatched.at(-1)).toMatchObject({ kind: 'beginTenantSetup', mode: 'add', profile: { label: 'Coastal Bank', tsgId: '2000000001' } })\n        const before = { tenants: native.current.tenants, active: native.current.active }\n        await native.push({ ...native.current, setup: setupView({ mode: 'add', scanRequired: false, tenant: draft({ label: 'Coastal Bank', tsgId: '2000000001', environment: 'production', destination: { kind: 'region', region: 'unitedStates' } }) }) })\n        await within(sheet).findByText('Coastal Bank is drafted. Add its scan key below.')\n        expect(within(sheet).getByText(/Optional here; without it scans stay unavailable/)).toBeInTheDocument()\n        expect(within(sheet).getByRole('button', { name: 'Continue' })).toBeEnabled()\n        expect(native.current.tenants).toEqual(before.tenants)\n        expect(native.current.active).toEqual(before.active)\n        await user.click(within(sheet).getByRole('button', { name: 'Cancel' }))\n        expect(native.dispatched.at(-1)).toEqual({ kind: 'discardTenantSetup', context: DRAFT_CONTEXT })\n","exit_code":0,"status":"completed"}}
