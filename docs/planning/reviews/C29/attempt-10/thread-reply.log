{"type":"item.completed","item":{"id":"item_67","type":"command_execution","command":"/bin/zsh -lc \"sed -n '1,240p' apps/desktop/src/app.tsx; sed -n '1,225p' apps/desktop/src/v2/store.ts; sed -n '1,225p' apps/desktop/src/v2/modal.tsx\"","aggregated_output":"import { useCallback, useEffect, useLayoutEffect, useRef, useState } from 'react'\nimport {\n    DeliveryOutcomeUnknown,\n    type DesktopClient,\n    type FeatureId,\n    type Intent,\n    type MenuCommand,\n    type Refusal,\n    type ShellSnapshot,\n    type Theme,\n} from '@prisma-airs/desktop-contracts'\nimport { followAppearance } from './shell/appearance'\nimport { type DispatchOutcome, outcomeMessage } from './features/tenants/dispatch'\nimport { V2Shell } from './v2/v2-shell'\nimport { Wizard } from './v2/wizard/wizard'\nimport { deliveryContext, useShellStore } from './v2/store'\nimport { SHELL_COPY } from './v2/copy'\nimport { forgetAcademyPresentation } from './features/academy/presentation-storage'\nimport { SAVE_DOCUMENT_EVENT } from './v2/workbench/request-editor'\n\nexport function App({ client }: { client: DesktopClient }) {\n    const [snapshot, setSnapshot] = useState<ShellSnapshot | null>(null)\n    const snapshotRef = useRef<ShellSnapshot | null>(null)\n    snapshotRef.current = snapshot\n    const [failure, setFailure] = useState<string | null>(null)\n    const [pending, setPending] = useState(false)\n    const [status, setStatus] = useState('')\n\n    const dispatch = useCallback(\n        async (intent: Intent): Promise<DispatchOutcome> => {\n            try {\n                const response = await client.dispatch(intent)\n                return response.outcome === 'refusal'\n                    ? { kind: 'refused', refusal: response.refusal }\n                    : { kind: 'admitted', operation: response.receipt.operation }\n            } catch (error) {\n                return error instanceof DeliveryOutcomeUnknown ? { kind: 'unknown' } : { kind: 'failed' }\n            }\n        },\n        [client]\n    )\n\n    // v2 (C28): navigation is Rust-owned. The native menu, the sidebar and\n    // the palette all dispatch `navigate`; refusals reach the status surface.\n    const v2Navigate = useCallback(\n        async (feature: FeatureId) => {\n            useShellStore.getState().closePalette()\n            const intent: Intent = { kind: 'navigate', feature }\n            const outcome = await dispatch(intent)\n            if (outcome.kind === 'refused') useShellStore.getState().toast(SHELL_COPY.toastRefused('Navigation', outcome.refusal), 'warn')\n            // Unknown delivery is kept inline with Retry; never an expiring toast alone.\n            else if (outcome.kind === 'unknown') useShellStore.getState().addUnconfirmed('Navigation', intent)\n            else if (outcome.kind === 'failed') useShellStore.getState().toast(SHELL_COPY.toastFailed('Navigation'), 'warn')\n        },\n        [dispatch]\n    )\n    // Every v2 action's outcome reaches the shell's surfaces (DESIGN-V2 §7):\n    // a refusal or failed delivery as a warn toast naming what was asked, an\n    // unconfirmed delivery inline with Retry, never replayed on its own.\n    const v2Act = useCallback(\n        async (what: string, intent: Intent, quiet: Refusal[] = []): Promise<DispatchOutcome> => {\n            // A context-bound action speaks for the tenant it was sent in (I2).\n            const boundContext = deliveryContext(intent)\n            // A normal switch refusal still names its intended destination,\n            // but an uncertain switch must not offer Retry in another scope.\n            const retryContext = boundContext ?? (intent.kind === 'selectTenant' ? snapshotRef.current?.active?.context ?? null : null)\n            const bound = boundContext !== null ? (snapshotRef.current?.active?.tenant ?? null) : null\n            const outcome = await dispatch(intent)\n            if (outcome.kind === 'refused' && quiet.includes(outcome.refusal)) return outcome\n            if (outcome.kind === 'refused') useShellStore.getState().toast(SHELL_COPY.toastRefused(what, outcome.refusal, outcomeMessage(outcome)), 'warn', undefined, bound, boundContext)\n            else if (outcome.kind === 'unknown') useShellStore.getState().addUnconfirmed(what, intent, retryContext)\n            else if (outcome.kind === 'failed') useShellStore.getState().toast(SHELL_COPY.toastFailed(what), 'warn', undefined, bound, boundContext)\n            return outcome\n        },\n        [dispatch]\n    )\n    const v2Preference = useCallback(\n        async (what: string, intent: Intent, quiet: Refusal[] = []) => {\n            await v2Act(what, intent, quiet)\n        },\n        [v2Act]\n    )\n\n    const onMenu = useRef<(command: MenuCommand) => void>(() => undefined)\n    onMenu.current = (command: MenuCommand) => {\n        // Native navigation dismisses the modal palette first so focus can\n        // move to the new page heading instead of behind an open dialog.\n        if (command.kind === 'navigate') void v2Navigate(command.feature)\n        else if (command.kind === 'commandPalette') useShellStore.getState().openPalette()\n        // ⌘T: the tenant switcher opens; nothing switches until chosen.\n        else if (command.kind === 'tenantSwitcher') useShellStore.getState().setSwitcher(true)\n        // The open API Client request saves (its editor listens).\n        else if (command.kind === 'saveDocument') window.dispatchEvent(new Event(SAVE_DOCUMENT_EVENT))\n        else void v2Preference('The appearance change', { kind: 'setAppearance', theme: command.theme })\n    }\n\n    useEffect(() => {\n        let stop: (() => void) | undefined\n        let cancelled = false\n        client\n            .observeShell({\n                onSnapshot: (next) => {\n                    // The shell's scope follows the snapshot before it renders: a\n                    // notification for another tenant or context is never surfaced.\n                    useShellStore.getState().setScope(next.active?.tenant ?? null, next.active?.context ?? null, next.switchBlocked?.review ?? null)\n                    setSnapshot(next)\n                },\n                onMenu: (command) => onMenu.current(command),\n                onError: () => setFailure('The desktop sent an unexpected update.'),\n            })\n            .then(\n                (unsubscribe) => {\n                    if (cancelled) unsubscribe()\n                    else stop = unsubscribe\n                },\n                () => setFailure('The desktop shell could not be observed.')\n            )\n        return () => {\n            cancelled = true\n            stop?.()\n        }\n    }, [client])\n\n    // A completed reset also forgets Academy's WebView presentation state\n    // (completion latches keyed by account); a stopped reset keeps it.\n    const storage = snapshot?.storage\n    const resetFailed = Boolean(snapshot?.resetFailure)\n    const previousStorage = useRef(storage)\n    useEffect(() => {\n        if (previousStorage.current === 'resetting' && storage !== 'resetting' && !resetFailed) {\n            forgetAcademyPresentation()\n        }\n        previousStorage.current = storage\n    }, [storage, resetFailed])\n\n    const appearance = snapshot?.appearance\n    // Apply the theme in the same commit as the snapshot, before paint, so\n    // the shell never shows a frame in the previous theme.\n    useLayoutEffect(() => (appearance ? followAppearance(appearance) : undefined), [appearance])\n\n    if (failure && !snapshot) {\n        return (\n            <main role='alert' className='text-academy-ink p-8'>\n                {failure}\n            </main>\n        )\n    }\n    if (!snapshot) {\n        return (\n            <main role='status' aria-live='polite' className='text-academy-ink-soft p-8'>\n                Starting Prisma AIRS Desktop…\n            </main>\n        )\n    }\n    if (snapshot.onboarding !== 'done') {\n        // First run: the wizard owns the window (D060: no alpha import; nothing leaves it before a tenant exists).\n        return (\n            <div data-v2-shell=''>\n                <Wizard\n                    snapshot={snapshot}\n                    dispatch={dispatch}\n                    observeManagement={(operation) => client.observeManagement(operation)}\n                    mode='firstRun'\n                    onClose={() => undefined}\n                    onNavigate={(feature) => void v2Navigate(feature)}\n                />\n            </div>\n        )\n    }\n    return (\n        <V2Shell\n            snapshot={snapshot}\n            appearancePending={pending}\n            status={failure ?? status}\n            onNavigate={(feature) => void v2Navigate(feature)}\n            onSetAppearance={(theme) => void v2Preference('The appearance change', { kind: 'setAppearance', theme })}\n            onSetShowCalls={(on) => void v2Preference('The preference change', { kind: 'setShowCalls', on })}\n            onSwitchTenant={(tenant, resolution) => {\n                // The target is captured now: a late refusal still names it. A\n                // pending-decision refusal is not a toast: the snapshot carries\n                // the guard the shell renders (I1).\n                const label = snapshot.tenants.find((t) => t.id === tenant)?.label ?? tenant\n                void v2Preference(SHELL_COPY.switchTo(label), { kind: 'selectTenant', tenant, resolution: resolution ?? null }, ['decisionPending'])\n            }}\n            onReadNow={() => {\n                // The palette's Read now is the same finite read of every chosen product (I4).\n                const active = snapshot.active\n                if (!active) return\n                const label = snapshot.tenants.find((t) => t.id === active.tenant)?.label ?? active.tenant\n                void v2Preference(SHELL_COPY.readOf(label), { kind: 'readTenant', context: active.context })\n            }}\n            onRetry={(what, intent) => void v2Preference(what, intent)}\n            onAct={v2Act}\n            dispatch={dispatch}\n            client={client}\n        />\n    )\n}\nimport { create } from 'zustand'\n\nexport type ToastKind = 'ok' | 'info' | 'warn'\nimport type { AdminProductId, FeatureId, Intent, ManagementResource } from '@prisma-airs/desktop-contracts'\n\n/** What a contextual action asked the destination to select on arrival (C30), owned by the tenant it was followed in (I2). */\nexport interface Arrival {\n    tenant: string\n    feature: FeatureId\n    resource: ManagementResource | null\n    /** The item to filter to, by name. */\n    item: string | null\n    /** The Administration product to open (the rail's product children, C35). */\n    product?: AdminProductId\n    /** That product's tab to show, by the inventory's tab id (the tenant menu's workspace row, C35). */\n    tab?: string\n    /** Counts arrivals: a destination already open applies a new one. */\n    sequence: number\n}\n\n/** A Harness message kept for the operator: refused or never sent, or not confirmed (C32). */\nexport interface HarnessKept {\n    /** This record's own id: each attempt is its own record (C32). */\n    id: number\n    text: string\n    unconfirmed: boolean\n    /**\n     * For an unconfirmed send: the conversation it was sent to and the send's\n     * own ID. It is settled only when that conversation reports the core took\n     * that ID (`ConversationView.submissions`), never by matching text (C32).\n     */\n    conversation?: string\n    submission?: string\n}\n\n/** A Harness send the page dispatched, awaiting the core's word on it (C32): never shown, never sent again. */\nexport interface HarnessSent {\n    submission: string\n    conversation: string\n    text: string\n}\n\n/**\n * A Runtime case handed to the Playground (C33): Administration opens Runtime\n * Security's Playground tab with the case's fields; the operator runs the\n * scan there. Bound to the tenant it was opened in.\n */\nexport interface PlaygroundCase {\n    tenant: string\n    caseId: string\n    prefill: import('../features/library/library-view').CasePrefill\n}\n\n/** A delivery the desktop did not confirm: kept until the operator retries or dismisses it (DESIGN-V2 §7). */\nexport interface Unconfirmed {\n    id: number\n    what: string\n    intent: Intent\n    /** The native context or captured switch source this delivery belongs to; retirement never rebinds it. */\n    context: string | null\n}\n\n/** An initial tenant selection captures even the absence of an active context. */\nexport function unconfirmedInContext(delivery: Pick<Unconfirmed, 'intent' | 'context'>, context: string | null): boolean {\n    return delivery.context === context || (delivery.context === null && delivery.intent.kind !== 'selectTenant')\n}\n\nfunction switchResolution(intent: Intent) {\n    return intent.kind === 'selectTenant' || intent.kind === 'completeTenantSetup' ? intent.resolution : null\n}\n\n/** A destructive switch is bound to its source, not its destination or setup draft. */\nexport function deliveryContext(intent: Intent): string | null {\n    const resolution = switchResolution(intent)\n    if (resolution) return resolution.context\n    return 'context' in intent && typeof intent.context === 'string' ? intent.context : null\n}\n\nexport interface Toast {\n    id: number\n    kind: ToastKind\n    text: string\n    /** An optional undo the toast offers (label + action). */\n    undo?: { label: string; run: () => void }\n    /** The tenant the toast speaks for (an item, a read): retired on leaving it (I2). */\n    tenant: string | null\n    /** The context it was raised under, when the action was context-bound: retired with it. */\n    context: string | null\n}\n\n/**\n * Transient shell presentation state (state-ownership.md \"UI\"): what is open,\n * the palette query, toasts and the modal stack. Nothing here survives a\n * reload and nothing here is authority: every durable fact is observed from\n * the Rust snapshot.\n */\ninterface ShellStore {\n    /** The scope the shell shows now (set from each snapshot before it renders): what a notification must belong to. */\n    scope: { tenant: string | null; context: string | null; switchReview: string | null }\n    setScope(tenant: string | null, context: string | null, switchReview?: string | null): void\n    paletteOpen: boolean\n    switcherOpen: boolean\n    /** The rail's Administration children shown or hidden (C35; the prototype's `adminNav`). */\n    adminNavOpen: boolean\n    setAdminNav(open: boolean): void\n    toasts: Toast[]\n    /** Open modal ids, bottom to top; only the last is interactive (I8). */\n    modals: string[]\n    /** The Inbox tab and item per tenant (I2: a switch round trip keeps it). */\n    inboxSelection: Record<string, { tab: 'all' | 'action' | 'updates' | 'snoozed'; item: string | null }>\n    selectInbox(tenant: string, selection: { tab: 'all' | 'action' | 'updates' | 'snoozed'; item: string | null }): void\n    /** Harness drafts, by `tenant|workspace|conversation` (C32): kept across navigation and tenant round trips, never shared between scopes, never sent by themselves. */\n    harnessDrafts: Record<string, string>\n    setHarnessDraft(scope: string, text: string): void\n    /** Per `tenant|workspace`: the operator chose a new investigation while one runs (C32). */\n    harnessFresh: Record<string, boolean>\n    setHarnessFresh(scope: string, fresh: boolean): void\n    /**\n     * Per `tenant|workspace`: messages kept for the operator (C32). `unconfirmed`\n     * ones may have been delivered (the desktop did not confirm it); the others\n     * were refused or never sent. Never sent by themselves.\n     */\n    harnessUnsent: Record<string, HarnessKept[]>\n    keepHarnessUnsent(scope: string, kept: Omit<HarnessKept, 'id'>): void\n    dropHarnessUnsent(scope: string, id: number): void\n    /**\n     * Per `tenant|workspace`: sends dispatched and not yet reported by their\n     * conversation (C32), so a send the core gives back keeps its text whatever\n     * order its receipt and the core's word arrive in. Newest 64.\n     */\n    harnessSent: Record<string, HarnessSent[]>\n    /** The case last handed to the Playground (C33); never runs anything by itself. */\n    playground: PlaygroundCase | null\n    openPlayground(target: Omit<PlaygroundCase, 'prefill'> & { prefill: Omit<PlaygroundCase['prefill'], 'nonce'> }): void\n    trackHarnessSend(scope: string, sent: HarnessSent): void\n    untrackHarnessSend(scope: string, submission: string): void\n    /** The last contextual action's target, consumed by the destination it names. */\n    arrival: Arrival | null\n    arrive(target: Omit<Arrival, 'sequence'>): void\n    /** Forgets an arrival that belongs to another tenant than `tenant`. */\n    scopeArrival(tenant: string | null): void\n    /** Drops unconfirmed deliveries bound to a context other than `context` (their authority retired). */\n    retireUnconfirmed(context: string | null): void\n    unconfirmed: Unconfirmed[]\n    /** Toast lifetime in ms (6 s; tests shorten it). */\n    toastMs: number\n    addUnconfirmed(what: string, intent: Intent, sourceContext?: string | null): number\n    clearUnconfirmed(id: number): void\n    openPalette(): void\n    closePalette(): void\n    setSwitcher(open: boolean): void\n    toast(text: string, kind?: ToastKind, undo?: Toast['undo'], tenant?: string | null, context?: string | null): number\n    /** Retires toasts that speak for another tenant than `tenant`. */\n    retireToasts(tenant: string | null): void\n    dismissToast(id: number): void\n    pushModal(id: string): void\n    popModal(id: string): void\n}\n\nlet nextToast = 1\nlet nextKept = 1\n\nexport const useShellStore = create<ShellStore>((set, get) => ({\n    scope: { tenant: null, context: null, switchReview: null },\n    setScope: (tenant, context, switchReview = null) =>\n        set((s) => ({\n            scope: { tenant, context, switchReview },\n            // Leaving a scope retires what spoke for it, however late it would have arrived.\n            toasts: s.toasts.filter((t) => (t.tenant === null || t.tenant === tenant) && (t.context === null || t.context === context)),\n            unconfirmed: s.unconfirmed.filter((u) => unconfirmedInContext(u, context) && (!switchResolution(u.intent) || switchResolution(u.intent)?.review === switchReview)),\n            arrival: s.arrival && s.arrival.tenant !== tenant ? null : s.arrival,\n        })),\n    paletteOpen: false,\n    switcherOpen: false,\n    adminNavOpen: true,\n    setAdminNav: (open) => set({ adminNavOpen: open }),\n    toasts: [],\n    modals: [],\n    inboxSelection: {},\n    selectInbox: (tenant, selection) => set((s) => ({ inboxSelection: { ...s.inboxSelection, [tenant]: selection } })),\n    harnessDrafts: {},\n    setHarnessDraft: (scope, text) => set((s) => ({ harnessDrafts: { ...s.harnessDrafts, [scope]: text } })),\n    harnessFresh: {},\n    setHarnessFresh: (scope, fresh) => set((s) => ({ harnessFresh: { ...s.harnessFresh, [scope]: fresh } })),\n    harnessUnsent: {},\n    keepHarnessUnsent: (scope, item) =>\n        set((s) => {\n            const kept = s.harnessUnsent[scope] ?? []\n            const record = { ...item, id: nextKept++ }\n            // An uncertain attempt is never removed or downgraded by a later one:\n            // only the core's word on its own send ID, or the operator, settles it.\n            // A not-sent record of the same text is superseded by a later attempt;\n            // not-sent records are kept once per text.\n            const others = kept.filter((k) => k.unconfirmed || k.text !== item.text)\n            return { harnessUnsent: { ...s.harnessUnsent, [scope]: [...others, record] } }\n        }),\n    dropHarnessUnsent: (scope, id) => set((s) => ({ harnessUnsent: { ...s.harnessUnsent, [scope]: (s.harnessUnsent[scope] ?? []).filter((k) => k.id !== id) } })),\n    harnessSent: {},\n    playground: null,\n    openPlayground: (target) => set((s) => ({ playground: { ...target, prefill: { ...target.prefill, nonce: (s.playground?.prefill.nonce ?? 0) + 1 } } })),\n    trackHarnessSend: (scope, sent) => set((s) => ({ harnessSent: { ...s.harnessSent, [scope]: [...(s.harnessSent[scope] ?? []), sent].slice(-64) } })),\n    untrackHarnessSend: (scope, submission) => set((s) => ({ harnessSent: { ...s.harnessSent, [scope]: (s.harnessSent[scope] ?? []).filter((t) => t.submission !== submission) } })),\n    arrival: null,\n    arrive: (target) => set((s) => ({ arrival: { ...target, sequence: (s.arrival?.sequence ?? 0) + 1 } })),\n    unconfirmed: [],\n    toastMs: 6000,\n    addUnconfirmed: (what, intent, context = deliveryContext(intent)) => {\n        const id = nextToast++\n        // A delivery bound to a context the shell no longer shows is moot: never surfaced (I2).\n        if (!unconfirmedInContext({ intent, context }, get().scope.context)) return id\n        const resolution = switchResolution(intent)\n        if (resolution && resolution.review !== get().scope.switchReview) return id\n        set((s) => ({ unconfirmed: [...s.unconfirmed, { id, what, intent, context }] }))\n        return id\n    },\n    scopeArrival: (tenant) => set((s) => (s.arrival && s.arrival.tenant !== tenant ? { arrival: null } : {})),\n    retireUnconfirmed: (context) => set((s) => ({ unconfirmed: s.unconfirmed.filter((u) => unconfirmedInContext(u, context)) })),\n    clearUnconfirmed: (id) => set((s) => ({ unconfirmed: s.unconfirmed.filter((u) => u.id !== id) })),\n    openPalette: () => set({ paletteOpen: true, switcherOpen: false }),\n    closePalette: () => set({ paletteOpen: false }),\n    setSwitcher: (open) => set({ switcherOpen: open, ...(open ? { paletteOpen: false } : {}) }),\n    toast: (text, kind = 'ok', undo, tenant = null, context = null) => {\n        const id = nextToast++\n        // A toast for a tenant or context the shell no longer shows is never surfaced (I2).\n        if (tenant !== null && tenant !== get().scope.tenant) return id\nimport { useEffect, useId, useRef, type KeyboardEvent, type ReactNode } from 'react'\nimport { useShellStore } from './store'\n\ninterface ModalProps {\n    label: string\n    onClose: () => void\n    children: ReactNode\n    /** Width in CSS px (default 560). */\n    width?: number\n    /** Inner padding in CSS px (default 20); 0 for a dialog that lays itself out edge to edge. */\n    padding?: number\n    /** Distance from the top of the window in CSS px (default 4vh); the prototype's palette sits at 90. */\n    top?: number\n    /** Corner radius in CSS px (default 12; the palette's frame is 14). */\n    radius?: number\n    /** A sheet docked to the window's right edge under the header (R2App's review sheet, 620px wide, full height). */\n    sheet?: boolean\n    /**\n     * The control focus returns to on close when the opener itself will be gone\n     * by then (a menu item that closes with its menu as the dialog opens): an\n     * explicit surviving target instead of whatever had focus at mount.\n     */\n    returnFocus?: HTMLElement | null\n    'data-slot'?: string\n}\n\nconst FOCUSABLE = 'a[href], button:not([disabled]), input:not([disabled]), select:not([disabled]), textarea:not([disabled]), [tabindex]:not([tabindex=\"-1\"])'\n\n/**\n * One topmost modal (I8): dialogs register on a shell-wide stack; only the\n * last is interactive. Lower dialogs are inert and aria-hidden, Tab and\n * Shift-Tab stay inside the topmost dialog, Escape closes the topmost only,\n * focus moves into the dialog on open and back to the opener on close. The\n * page behind every dialog is made inert by the shell (`useModalsOpen`).\n * The dialog element handles its own keys; the topmost dialog also listens\n * on the window for Escape alone, for when focus has left it (a native\n * sheet returned focus elsewhere), and closes only itself.\n */\nexport function Modal({ label, onClose, children, width = 560, padding = 20, top, radius = 12, sheet = false, returnFocus = null, ...rest }: ModalProps) {\n    const id = useId()\n    const pushModal = useShellStore((s) => s.pushModal)\n    const popModal = useShellStore((s) => s.popModal)\n    const modals = useShellStore((s) => s.modals)\n    const topmost = modals.length > 0 && modals[modals.length - 1] === id\n    const dialog = useRef<HTMLDivElement>(null)\n    const opener = useRef<HTMLElement | null>(null)\n    const returnRef = useRef(returnFocus)\n    returnRef.current = returnFocus\n    const focusedOnce = useRef(false)\n\n    useEffect(() => {\n        opener.current = document.activeElement instanceof HTMLElement ? document.activeElement : null\n        pushModal(id)\n        return () => {\n            popModal(id)\n            // After the commit: the page behind is still inert during cleanup,\n            // and an inert ancestor refuses focus (observed in WebKit).\n            const target = returnRef.current ?? opener.current\n            queueMicrotask(() => {\n                // Only when nothing else took focus meanwhile (⌘T replacing the\n                // palette hands focus to the tenant list, which must keep it).\n                const active = document.activeElement\n                if (active && active !== document.body) return\n                // The opener may be gone (a \"Finish rotation…\" that completed):\n                // focus the page heading rather than leave it on nothing.\n                if (target?.isConnected) target.focus()\n                else document.querySelector<HTMLElement>('main h1[tabindex=\"-1\"]')?.focus()\n            })\n        }\n    }, [id, pushModal, popModal])\n\n    useEffect(() => {\n        // Initial focus goes into the dialog once, when it opens. Regaining the\n        // top after a higher dialog closes must not refocus: that dialog is\n        // restoring its own opener, which may be any control here.\n        if (!topmost || focusedOnce.current) return\n        const node = dialog.current\n        if (!node) return\n        focusedOnce.current = true\n        if (!node.contains(document.activeElement)) {\n            // A declared initial control first (wherever it sits), else the first focusable.\n            const first = node.querySelector<HTMLElement>('[autofocus]') ?? node.querySelector<HTMLElement>(FOCUSABLE)\n            ;(first ?? node).focus()\n        }\n    }, [topmost])\n\n    // Escape still closes the topmost dialog when focus has left it (a\n    // native sheet returning focus to the page body, a click on the scrim's\n    // edge): the dialog's own handler stops the event first when it has focus.\n    const closeRef = useRef(onClose)\n    closeRef.current = onClose\n    useEffect(() => {\n        if (!topmost) return\n        const onWindowKey = (event: globalThis.KeyboardEvent) => {\n            if (event.key !== 'Escape' || event.defaultPrevented) return\n            const node = dialog.current\n            if (node && node.contains(document.activeElement)) return\n            event.preventDefault()\n            closeRef.current()\n        }\n        window.addEventListener('keydown', onWindowKey)\n        return () => window.removeEventListener('keydown', onWindowKey)\n    }, [topmost])\n\n    const onKeyDown = (event: KeyboardEvent<HTMLDivElement>) => {\n        if (!topmost) return\n        if (event.key === 'Escape') {\n            event.preventDefault()\n            event.stopPropagation()\n            onClose()\n            return\n        }\n        if (event.key === 'Tab') {\n            // Keyboard interaction stays inside the topmost dialog.\n            const node = dialog.current\n            if (!node) return\n            const items = Array.from(node.querySelectorAll<HTMLElement>(FOCUSABLE)).filter((el) => !el.hasAttribute('hidden') && el.getAttribute('aria-hidden') !== 'true')\n            if (items.length === 0) {\n                event.preventDefault()\n                node.focus()\n                return\n            }\n            const first = items[0] as HTMLElement\n            const last = items[items.length - 1] as HTMLElement\n            const active = document.activeElement\n            if (event.shiftKey && (active === first || active === node)) {\n                event.preventDefault()\n                last.focus()\n            } else if (!event.shiftKey && active === last) {\n                event.preventDefault()\n                first.focus()\n            }\n        }\n    }\n\n    return (\n        <div\n            className={sheet ? 'fixed z-50 flex justify-end' : 'fixed inset-0 z-50 grid place-items-start justify-center'}\n            style={sheet ? { inset: 'var(--v2-header, 56px) 0 0 0' } : { paddingTop: top ?? '4vh' }}\n            data-v2-scrim=''\n            aria-hidden={topmost ? undefined : true}\n            inert={topmost ? undefined : true}\n            onMouseDown={() => topmost && onClose()}\n        >\n            <div\n                ref={dialog}\n                role='dialog'\n                aria-modal={topmost ? 'true' : undefined}\n                aria-label={label}\n                tabIndex={-1}\n                data-slot={rest['data-slot'] ?? 'modal'}\n                data-topmost={topmost ? 'true' : 'false'}\n                onKeyDown={onKeyDown}\n                onMouseDown={(e) => e.stopPropagation()}\n                className='border'\n                // Bounded to the viewport: a tall dialog scrolls inside itself, so its\n                // actions stay reachable at the minimum window size and 200% zoom.\n                style={\n                    sheet\n                        ? { width: `min(${width}px, 100vw)`, height: '100%', overflowY: 'auto', padding, borderRadius: 0, borderLeft: '1px solid var(--v2-rule)', boxShadow: '-18px 0 40px rgba(0,0,0,0.18)', background: 'var(--v2-bg)', borderWidth: 0, color: 'var(--v2-ink)' }\n                        : { width: `min(${width}px, 92vw)`, maxHeight: '92vh', overflowY: 'auto', padding, borderRadius: radius, boxShadow: '0 24px 60px rgba(0,0,0,0.3)', background: 'var(--v2-paper)', borderColor: 'var(--v2-rule)', color: 'var(--v2-ink)' }\n                }\n            >\n                {children}\n            </div>\n        </div>\n    )\n}\n\n/** Whether any modal is open: the shell makes the page behind it inert. */\nexport function useModalsOpen(): boolean {\n    return useShellStore((s) => s.modals.length > 0)\n}\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_68","type":"command_execution","command":"/bin/zsh -lc \"sed -n '550,675p' apps/desktop/src-tauri/tests/ipc_admission.rs; sed -n '250,335p' apps/desktop/src-tauri/src/lib.rs; cat apps/desktop/src-tauri/capabilities/main.json apps/desktop/src-tauri/tauri.conf.json; cat apps/desktop/academy-source.ts\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_68","type":"command_execution","command":"/bin/zsh -lc \"sed -n '550,675p' apps/desktop/src-tauri/tests/ipc_admission.rs; sed -n '250,335p' apps/desktop/src-tauri/src/lib.rs; cat apps/desktop/src-tauri/capabilities/main.json apps/desktop/src-tauri/tauri.conf.json; cat apps/desktop/academy-source.ts\"","aggregated_output":"/// context; no receipt, snapshot or Keychain call echoes a secret, nothing\n/// becomes a tenant before completion, and a discard leaves no draft behind.\n#[test]\nfn setup_draft_intents_cross_ipc_without_echoing_secrets_or_creating_tenants() {\n    let h = harness();\n    let session = register(&h);\n    let begun = send(\n        &h,\n        &session,\n        1,\n        json!({\"kind\": \"beginTenantSetup\", \"mode\": \"add\", \"profile\": {\n        \"label\": \"Drafted\", \"tsgId\": \"1234567890\", \"destination\": {\"kind\": \"region\", \"region\": \"europe\"},\n        \"environment\": \"staging\"}}),\n    );\n    assert_eq!(begun.expect(\"begun\")[\"outcome\"], \"receipt\");\n    let snap = snapshot(&h, 20);\n    assert_eq!(\n        snap[\"tenants\"].as_array().map(Vec::len),\n        Some(0),\n        \"a draft is not a tenant\"\n    );\n    assert!(snap[\"active\"].is_null());\n    let setup = &snap[\"setup\"];\n    assert_eq!(setup[\"mode\"], \"add\");\n    assert_eq!(setup[\"tenant\"][\"environment\"], \"staging\");\n    assert_eq!(setup[\"scanRequired\"], false);\n    let context = setup[\"context\"].as_str().expect(\"draft context\").to_owned();\n    let key = \"synthetic-ipc-draft-scan-key-0042\";\n    let secret = \"synthetic-ipc-draft-client-secret-0042\";\n    let stored = send(\n        &h,\n        &session,\n        2,\n        json!({\"kind\": \"configureScanCredential\", \"context\": context, \"mode\": \"session\", \"key\": key}),\n    )\n    .expect(\"admitted\");\n    assert_eq!(stored[\"outcome\"], \"receipt\");\n    assert!(!stored.to_string().contains(key));\n    // The scan key retired the draft's context (a credential change always does).\n    let context = snapshot(&h, 21)[\"setup\"][\"context\"]\n        .as_str()\n        .expect(\"fresh draft context\")\n        .to_owned();\n    let client = send(\n        &h,\n        &session,\n        3,\n        json!({\"kind\": \"configureManagementCredential\", \"context\": context, \"mode\": \"session\",\n        \"clientId\": \"svc@1234567890.iam.example\", \"secret\": secret}),\n    )\n    .expect(\"admitted\");\n    assert!(!client.to_string().contains(secret));\n    assert!(eventually(|| {\n        let s = snapshot(&h, 21);\n        s[\"setup\"][\"tenant\"][\"scan\"][\"state\"] == \"ready\"\n            && s[\"setup\"][\"tenant\"][\"management\"][\"state\"] == \"ready\"\n    }));\n    let snap = snapshot(&h, 22);\n    let text = snap.to_string();\n    assert!(\n        !text.contains(key) && !text.contains(secret),\n        \"no snapshot carries a secret\"\n    );\n    assert_eq!(\n        snap[\"setup\"][\"tenant\"][\"management\"][\"clientId\"],\n        \"svc@1234567890.iam.example\"\n    );\n    assert_eq!(\n        snap[\"tenants\"].as_array().map(Vec::len),\n        Some(0),\n        \"still not a tenant\"\n    );\n    assert!(\n        h.adapters.vault.calls().is_empty(),\n        \"session-only never reaches the Keychain\"\n    );\n    // (Verification is not run here: the fixture host has no synthetic management plane,\n    // and a routine host test must never reach a product service; the core and reads\n    // suites cover it.) Each credential change retired the draft's context: re-read it.\n    let context = snapshot(&h, 24)[\"setup\"][\"context\"]\n        .as_str()\n        .expect(\"fresh draft context\")\n        .to_owned();\n    let discarded = send(\n        &h,\n        &session,\n        4,\n        json!({\"kind\": \"discardTenantSetup\", \"context\": context}),\n    )\n    .expect(\"discard\");\n    assert_eq!(discarded[\"outcome\"], \"receipt\");\n    let snap = snapshot(&h, 25);\n    assert!(snap[\"setup\"].is_null());\n    assert_eq!(snap[\"tenants\"].as_array().map(Vec::len), Some(0));\n    let stale = send(\n        &h,\n        &session,\n        5,\n        json!({\"kind\": \"verifyTenantSetup\", \"context\": context}),\n    );\n    assert_eq!(\n        stale.expect(\"refusal\"),\n        json!({\"outcome\": \"refusal\", \"refusal\": \"staleContext\"})\n    );\n}\n            });\n    builder.build()\n}\n\nfn product_title() -> &'static str {\n    if cfg!(feature = \"test-fixtures\") {\n        \"Prisma AIRS Desktop v2 (Fixture)\"\n    } else {\n        \"Prisma AIRS Desktop v2\"\n    }\n}\n\n/// True for the packaged asset origin served by Tauri's custom protocol.\npub fn is_packaged_origin(url: &Url) -> bool {\n    url.scheme() == \"tauri\" && url.host_str() == Some(\"localhost\") && url.port().is_none()\n}\n\n/// Defense in depth beyond the capability grant: the caller must be the main\n/// webview of the main window currently showing packaged content.\nfn admit_caller<R: Runtime>(webview: &Webview<R>) -> Result<(), Refusal> {\n    if webview.label() != MAIN_WINDOW || webview.window().label() != MAIN_WINDOW {\n        return Err(Refusal::CapabilityMissing);\n    }\n    match webview.url() {\n        Ok(url) if is_packaged_origin(&url) => Ok(()),\n        _ => Err(Refusal::CapabilityMissing),\n    }\n}\n\n#[tauri::command]\nasync fn desktop_dispatch<R: Runtime>(\n    webview: Webview<R>,\n    request: Request<'_>,\n    host: State<'_, Host>,\n) -> Result<DispatchResponse, Refusal> {\n    admit_caller(&webview)?;\n    // The facade sends raw bytes so the size ceiling applies before parsing.\n    let InvokeBody::Raw(bytes) = request.body() else {\n        return Err(Refusal::InvalidInput);\n    };\n    let request = DispatchRequest::parse(bytes).map_err(|e| e.refusal())?;\n    let delivery = request.delivery().map_err(|e| e.refusal())?;\n    Ok(host\n        .operator\n        .dispatch(delivery, request.intent)\n        .await\n        .into())\n}\n\n#[tauri::command]\nasync fn desktop_observe<R: Runtime>(\n    webview: Webview<R>,\n    request: Request<'_>,\n    host: State<'_, Host>,\n) -> Result<ObserveResponse, Refusal> {\n    admit_caller(&webview)?;\n    let InvokeBody::Raw(bytes) = request.body() else {\n        return Err(Refusal::InvalidInput);\n    };\n    let request = ObserveRequest::parse(bytes).map_err(|e| e.refusal())?;\n    match request.scope {\n        WireScope::DeliverySession => Ok(host\n            .operator\n            .register_delivery_session()\n            .map_or_else(|refusal| ObserveResponse::Refusal { refusal }, Into::into)),\n        WireScope::Shell { updates } => {\n            let channel: Channel<ObservationUpdate> = updates\n                .parse::<JavaScriptChannelId>()\n                .map_err(|_| Refusal::InvalidInput)?\n                .channel_on(webview.clone());\n            let Observation::Shell {\n                snapshot,\n                updates: mut subscription,\n            } = host.operator.observe(ViewScope::Shell)?\n            else {\n                return Err(Refusal::InvalidInput);\n            };\n            let mut menu = host.menu.subscribe();\n            let mut variant = snapshot.ui_variant;\n            let app = webview.app_handle().clone();\n            // Every (re)subscription reconciles the native menu with the fresh\n            // snapshot: a variant change dropped by an overflowing stream\n            // (replaced by Resync) must not leave the Go menu stale (C28).\n            host.sync_menu(&app, variant);\n            host.register(webview.label(), &updates, move |id, registry| {\n                tauri::async_runtime::spawn(async move {\n{\n  \"$schema\": \"../gen/schemas/desktop-schema.json\",\n  \"identifier\": \"main-window\",\n  \"description\": \"The packaged main window may call only the two application commands.\",\n  \"local\": true,\n  \"windows\": [\"main\"],\n  \"webviews\": [\"main\"],\n  \"permissions\": [\"allow-desktop-dispatch\", \"allow-desktop-observe\"]\n}\n{\n  \"$schema\": \"https://schema.tauri.app/config/2\",\n  \"productName\": \"Prisma AIRS Desktop v2\",\n  \"version\": \"2.0.0\",\n  \"identifier\": \"io.cdot.prisma-airs-desktop.v2\",\n  \"build\": {\n    \"frontendDist\": \"../dist\",\n    \"beforeBuildCommand\": \"\"\n  },\n  \"app\": {\n    \"withGlobalTauri\": false,\n    \"windows\": [],\n    \"security\": {\n      \"csp\": {\n        \"default-src\": \"'self'\",\n        \"script-src\": \"'self'\",\n        \"style-src\": \"'self'\",\n        \"img-src\": \"'self' data:\",\n        \"font-src\": \"'self' data:\",\n        \"connect-src\": \"ipc: http://ipc.localhost\",\n        \"object-src\": \"'none'\",\n        \"base-uri\": \"'none'\",\n        \"form-action\": \"'none'\",\n        \"frame-ancestors\": \"'none'\",\n        \"frame-src\": \"'none'\",\n        \"worker-src\": \"'none'\"\n      },\n      \"dangerousDisableAssetCspModification\": false,\n      \"freezePrototype\": true,\n      \"capabilities\": [\"main-window\"]\n    }\n  },\n  \"bundle\": {\n    \"active\": true,\n    \"targets\": [\"app\", \"dmg\"],\n    \"category\": \"DeveloperTool\",\n    \"copyright\": \"Copyright 2026 cdot\",\n    \"license\": \"Apache-2.0\",\n    \"icon\": [\"icons/32x32.png\", \"icons/128x128.png\", \"icons/128x128@2x.png\", \"icons/icon.icns\", \"icons/icon.png\"],\n    \"macOS\": {\n      \"minimumSystemVersion\": \"13.0\",\n      \"hardenedRuntime\": true\n    }\n  }\n}\n/**\n * Academy learner source compiled into the desktop (C05). The learner\n * package (@ai-security-academy/learner) exports Academy's own pages; their\n * `@/` imports are Academy's source in the prepared, hash-verified input\n * (.work/academy, xtask shared-prepare). Every bare import that source makes\n * resolves to this app's pinned copy (`dedupe`), so one React, one React\n * Query and one router instance exist and versions follow the desktop lock.\n */\n// A file-system path without Node typings in the app's tsconfig (the\n// repository path has no characters that URL-encode other than these).\nexport const ACADEMY_SRC = decodeURIComponent(new URL('../../.work/academy/src', import.meta.url).pathname)\nconst CONTRACTS_ROOT = decodeURIComponent(new URL('../../packages/desktop-contracts/', import.meta.url).pathname)\n\n// node_modules may be shared with another worktree. Compile this checkout's IPC parser and bindings,\n// not the workspace package reached through that other checkout's dependency symlink.\nexport const desktopAliases = [\n    { find: /^@prisma-airs\\/desktop-contracts$/, replacement: `${CONTRACTS_ROOT}src/index.ts` },\n    { find: /^@prisma-airs\\/desktop-contracts\\/fixtures\\//, replacement: `${CONTRACTS_ROOT}fixtures/` },\n    { find: /^@\\//, replacement: `${ACADEMY_SRC}/` },\n]\n\nexport const academyDedupe = [\n    'react',\n    'react-dom',\n    '@ai-security-academy/presentation',\n    '@ai-security-academy/shared',\n    '@codemirror/commands',\n    '@codemirror/lang-python',\n    '@codemirror/lang-yaml',\n    '@codemirror/language',\n    '@codemirror/state',\n    '@codemirror/view',\n    '@dnd-kit/core',\n    '@excalidraw/excalidraw',\n    '@lezer/highlight',\n    '@radix-ui/react-dialog',\n    '@radix-ui/react-slot',\n    '@tanstack/react-query',\n    '@tanstack/react-router',\n    '@trpc/client',\n    '@trpc/react-query',\n    '@trpc/server',\n    'class-variance-authority',\n    'clsx',\n    'dompurify',\n    'lucide-react',\n    'mermaid',\n    'qrcode.react',\n    'sanitize-html',\n    'tailwind-merge',\n    'zustand',\n]\n","exit_code":0,"status":"completed"}}
