#[tokio::test]
async fn a_draft_reads_beside_the_active_tenant_without_touching_its_gateway_choice() {
    let mut desk = desk().await;
    desk.tenant_a().await;
    let a_before = desk.snap().gateway;
    let a_reference = a_before
        .selected
        .as_ref()
        .expect("A's choice")
        .reference
        .clone();
    assert_eq!(
        a_before.selected.as_ref().map(|s| s.workspace.id.as_str()),
        Some(WS_A)
    );
    let active_before = desk.snap().active.expect("active");

    // Draft B over the same synthetic plane (add mode, key optional).
    let origin = desk.origin.clone();
    desk.send(json!({"kind": "beginTenantSetup", "mode": "add", "profile": {"label": "Tenant B", "tsgId": TSG,
        "destination": {"kind": "custom", "origin": origin}}}))
        .await
        .expect("draft");
    let first_context = desk.draft_context();
    desk.send(json!({"kind": "configureManagementCredential", "context": first_context, "mode": "keychain",
        "clientId": CLIENT_ID, "secret": CLIENT_SECRET}))
        .await
        .expect("draft client");
    // The credential change retired the draft's context: the old one is refused, the new one works.
    let context = desk.draft_context();
    assert_ne!(context, first_context, "a fresh draft context");
    assert_eq!(
        desk.send(json!({"kind": "verifyTenantSetup", "context": first_context}))
            .await,
        Err(Refusal::StaleContext)
    );
    assert!(eventually(|| desk.setup().tenant.management.state == ScanState::Ready).await);
    desk.send(json!({"kind": "chooseSetupProducts", "context": context, "products": ["gateway"]}))
        .await
        .expect("products");
    // The draft lists through its own context and chooses WS_B; A keeps WS_A.
    let list = desk.read(&context, json!({"kind": "gateway", "workspace": null, "read": {"kind": "inventory", "resource": "workspaces"}})).await;
    assert!(
        matches!(list, ManagementResult::Gateway { .. }),
        "draft listing delivered, not withdrawn: {list:?}"
    );
    desk.send(json!({"kind": "selectGatewayWorkspace", "context": context, "workspace": WS_B}))
        .await
        .expect("draft chose");
    let setup = desk.setup();
    let chosen = setup.workspace.expect("draft's workspace");
    assert_eq!(chosen.workspace.id, WS_B);
    assert_ne!(chosen.reference, a_reference);
    let a_during = desk.snap().gateway;
    assert_eq!(
        a_during.selected, a_before.selected,
        "A's choice untouched by the draft's listing and choice"
    );
    assert_eq!(a_during.workspaces, a_before.workspaces);
    assert_eq!(
        desk.snap().active,
        Some(active_before.clone()),
        "A's context untouched"
    );

    // Replacing the draft's client retires its context and the choice under it;
    // the next listing restores the draft's remembered workspace.
    desk.send(
        json!({"kind": "configureManagementCredential", "context": context, "mode": "keychain",
        "clientId": CLIENT_ID, "secret": CLIENT_SECRET}),
    )
    .await
    .expect("replaced client");
    let context = desk.draft_context();
    assert!(
        desk.setup().workspace.is_none(),
        "the choice went with the old context"
    );
    assert!(eventually(|| desk.setup().tenant.management.state == ScanState::Ready).await);
    let list = desk.read(&context, json!({"kind": "gateway", "workspace": null, "read": {"kind": "inventory", "resource": "workspaces"}})).await;
    assert!(matches!(list, ManagementResult::Gateway { .. }));
    let restored = desk
        .setup()
        .workspace
        .expect("restored from the draft's remembered workspace");
    assert_eq!(restored.workspace.id, WS_B);
    assert!(restored.restored);
    assert_eq!(
        desk.snap().gateway.selected,
        a_before.selected,
        "A still untouched"
    );

    // Verify: real reads settle the lines; AIS/AES are listed as unavailable.
    desk.send(json!({"kind": "verifyTenantSetup", "context": context}))
        .await
        .expect("verify");
    let v = desk.verified().await;
    let line = |l: VerifyLine| v.steps.iter().find(|s| s.line == l).cloned().expect("line");
    assert_eq!(
        line(VerifyLine::ScanKey).state,
        VerifyState::Warning,
        "no key in add mode"
    );
    assert_eq!(line(VerifyLine::ManagementClient).state, VerifyState::Pass);
    // WS_B's IAM scope lists another workspace: the prerequisites read is
    // partial, and says so, instead of passing on the four inventories alone.
    let gateway = line(VerifyLine::Gateway);
    assert_eq!(gateway.state, VerifyState::Warning, "{}", gateway.reason);
    assert!(
        gateway
            .reason
            .contains("scope scope-team-b does not list the workspace"),
        "{}",
        gateway.reason
    );
    assert_eq!(line(VerifyLine::Ais).state, VerifyState::Unavailable);
    assert_eq!(line(VerifyLine::Aes).state, VerifyState::Unavailable);
    assert!(line(VerifyLine::Ais).product.is_none());
    assert!(v.done && !v.failed && !v.blocking && !v.stale);
    assert_eq!(
        v.warnings.len(),
        2,
        "the missing key and the partial prerequisites"
    );
    assert_eq!(v.warnings[1].product, ProductId::Gateway);
    assert!(desk.setup().completable);

    // Discard: A is exactly as it was.
    desk.send(json!({"kind": "discardTenantSetup", "context": context}))
        .await
        .expect("discard");
    let snap = desk.snap();
    assert!(snap.setup.is_none());
    assert_eq!(snap.gateway.selected, a_before.selected);
    assert_eq!(snap.active, Some(active_before));
    assert_eq!(snap.tenants.len(), 1);
    // A's chosen workspace still answers scoped reads under its reference.
    let a_context = desk.active_context();
    let prerequisites = desk
        .read(
            &a_context,
            json!({"kind": "gateway", "workspace": a_reference, "read": {"kind": "prerequisites"}}),
        )
        .await;
    assert!(
        matches!(prerequisites, ManagementResult::Gateway { .. }),
        "{prerequisites:?}"
    );
}

#[tokio::test]
async fn an_optional_service_failure_is_a_warning_the_operator_may_continue_over() {
    let mut desk = desk().await;
async fn changing_inputs_makes_results_stale_and_products_needing_a_client_warn() {
    let mut desk = Desk::new();
    let context = desk.begin("firstRun", "Northwind Health").await;
    desk.send(json!({"kind": "configureScanCredential", "context": context, "mode": "session", "key": KEY}))
        .await
        .expect("key");
    desk.settled(true).await;
    let context = desk.context();
    desk.send(json!({"kind": "verifyTenantSetup", "context": context}))
        .await
        .expect("verify");
    let first = desk.verified().await;
    assert_eq!(first.generation, 1);
    // Choosing Gateway afterwards invalidates the run; completion is refused.
    desk.send(json!({"kind": "chooseSetupProducts", "context": context, "products": ["gateway", "gateway", "redTeam"]}))
        .await
        .expect("products");
    let setup = desk.setup();
    assert_eq!(
        setup.products,
        vec![
            ProductId::RuntimeSecurity,
            ProductId::Gateway,
            ProductId::RedTeam
        ]
    );
    assert!(setup.verify.expect("kept").stale && !setup.completable);
    assert_eq!(
        desk.send(json!({"kind": "completeTenantSetup", "context": context, "packs": []}))
            .await,
        Err(Refusal::InvalidInput)
    );
    desk.send(json!({"kind": "verifyTenantSetup", "context": context}))
        .await
        .expect("verify again");
    let second = desk.verified().await;
    assert_eq!(second.generation, 2);
    assert!(!second.stale);
    let lines: Vec<(VerifyLine, VerifyState)> =
        second.steps.iter().map(|s| (s.line, s.state)).collect();
    assert_eq!(
        lines,
        vec![
            (VerifyLine::ScanKey, VerifyState::Stored),
            (VerifyLine::ManagementClient, VerifyState::Warning),
            (VerifyLine::Gateway, VerifyState::Warning),
            (VerifyLine::RedTeam, VerifyState::Warning),
            (VerifyLine::Ais, VerifyState::Unavailable),
            (VerifyLine::Aes, VerifyState::Unavailable),
        ]
    );
    assert_eq!(second.warnings.len(), 3);
    assert_eq!(second.warnings[1].product, ProductId::Gateway);
    assert!(desk.setup().completable, "warnings do not block completion");
    // A profile change (new destination) retires the key and goes stale.
    desk.send(
        json!({"kind": "updateTenantSetup", "context": context, "profile": {
        "label": "Northwind Health", "tsgId": "1234567890",
        "destination": {"kind": "region", "region": "unitedStates"}, "environment": "production"}}),
    )
    .await
    .expect("updated");
    let setup = desk.setup();
    assert_eq!(setup.tenant.scan.state, desktop_core::ScanState::Missing);
    assert_eq!(
        setup.tenant.environment,
        desktop_core::features::TenantEnvironment::Production
    );
    assert!(
        setup.verify.is_none() && !setup.completable,
        "the run went with the old context"
    );
    assert_ne!(
        setup.context.as_str(),
        context,
        "a profile change retires the draft's context"
    );
    assert_eq!(
        desk.send(json!({"kind": "verifyTenantSetup", "context": context}))
            .await,
        Err(Refusal::StaleContext)
    );
}

#[tokio::test]
async fn completion_commits_the_draft_once_with_products_warnings_and_onboarding() {
async fn completion_commits_the_draft_once_with_products_warnings_and_onboarding() {
    let mut desk = Desk::new();
    desk.send(json!({"kind": "setUiVariant", "variant": "v2"}))
        .await
        .expect("v2");
    desk.send(json!({"kind": "setOnboarding", "state": "inProgress"}))
        .await
        .expect("in progress");
    let context = desk.begin("firstRun", "Northwind Health").await;
    desk.send(json!({"kind": "configureScanCredential", "context": context, "mode": "session", "key": KEY}))
        .await
        .expect("key");
    desk.settled(true).await;
    let context = desk.context();
    desk.send(json!({"kind": "chooseSetupProducts", "context": context, "products": ["gateway"]}))
        .await
        .expect("products");
    desk.send(json!({"kind": "verifyTenantSetup", "context": context}))
        .await
        .expect("verify");
    desk.verified().await;
    // A pack for an unchosen product is refused.
    assert_eq!(
        desk.send(json!({"kind": "completeTenantSetup", "context": context, "packs": ["redTeam"]}))
            .await,
        Err(Refusal::InvalidInput)
    );
    desk.send(
        json!({"kind": "completeTenantSetup", "context": context, "packs": ["runtimeSecurity"]}),
    )
    .await
    .expect("completed");
    let snap = desk.snap();
    assert!(snap.setup.is_none());
    assert_eq!(snap.tenants.len(), 1);
    let tenant = &snap.tenants[0];
    assert_eq!(tenant.label, "Northwind Health");
    assert_eq!(
        tenant.products,
        vec![ProductId::RuntimeSecurity, ProductId::Gateway]
    );
    assert_eq!(
        tenant.scan.state,
        desktop_core::ScanState::Ready,
        "the key moved with it"
    );
    assert_eq!(
        tenant.setup_warnings.len(),
        2,
        "management + gateway warnings"
    );
    assert_eq!(tenant.setup_warnings[0].id, "vw-1");
    assert_eq!(tenant.setup_warnings[1].product, ProductId::Gateway);
    assert!(tenant.setup_warnings[0].recorded_secs > 1_700_000_000);
    assert_eq!(
        snap.active.as_ref().map(|a| &a.tenant),
        Some(&tenant.id),
        "active once"
    );
    assert_ne!(
        snap.active.as_ref().map(|a| a.context.as_str()),
        Some(context.as_str()),
        "a fresh context, not the draft's"
    );
    assert_eq!(snap.onboarding, OnboardingState::Done);
    assert_eq!(snap.active_feature, desktop_core::features::FeatureId::Home);
    // The draft's context is retired with it.
    assert_eq!(
        desk.send(json!({"kind": "verifyTenantSetup", "context": context}))
            .await,
        Err(Refusal::StaleContext)
    );
    let saved = desk.adapters.store.saved().expect("saved");
    assert!(saved.tenant_draft.is_none());
    assert_eq!(saved.tenant_warnings.len(), 1);
    let desk = desk.restart();
    let snap = desk.snap();
    assert_eq!(snap.onboarding, OnboardingState::Done);
    assert_eq!(snap.tenants[0].setup_warnings.len(), 2, "restored");
}

#[tokio::test]
async fn add_mode_keeps_the_shell_untouched_until_completion_and_discard_cleans_up() {
    let mut desk = Desk::new();
    desk.send(json!({"kind": "createTenant", "profile": {
        "label": "First", "tsgId": "1111111111", "destination": {"kind": "region", "region": "europe"}}}))
        .await
        .expect("first tenant");
    let before = desk.snap();
    let first = before.active.clone().expect("active");
    assert_eq!(
        before.onboarding,
        OnboardingState::Done,
        "an existing tenant means no wizard"
    );
    assert_eq!(
        desk.send(
            json!({"kind": "beginTenantSetup", "mode": "firstRun", "profile": {
            "label": "X", "tsgId": null, "destination": {"kind": "region", "region": "europe"}}})
        )
        .await,
        Err(Refusal::InvalidInput),
        "first run is impossible once a tenant exists"
    );
    let context = desk.begin("add", "Second").await;
    desk.send(json!({"kind": "configureScanCredential", "context": context, "mode": "keychain", "key": KEY}))
        .await
        .expect("key in the Keychain");
    desk.settled(true).await;
    let context = desk.context();
    let records = desk.adapters.vault.records();
    assert_eq!(records.len(), 1, "one Keychain record for the draft");
    let during = desk.snap();
    assert_eq!(during.tenants.len(), 1, "the shell still lists one tenant");
    assert_eq!(
        during.active,
        Some(first.clone()),
        "the active tenant and context are untouched"
    );
    assert!(
        !during.setup.as_ref().expect("setup").scan_required,
        "add mode: the key is optional"
    );
    // Discard: nothing changed, and the draft's record is queued for cleanup.
    desk.send(json!({"kind": "discardTenantSetup", "context": context}))
        .await
        .expect("discarded");
    let after = desk.snap();
    assert!(after.setup.is_none());
    assert_eq!(after.tenants.len(), 1);
    assert_eq!(after.active, Some(first));
    let saved = desk.adapters.store.saved().expect("saved");
    assert!(saved.tenant_draft.is_none());
    assert!(
        saved
            .credentials
            .iter()
            .all(|c| c.tenant == before.tenants[0].id)
    );
    assert!(
        saved.pending_cleanup.contains(&records[0])
            || !desk.adapters.vault.records().contains(&records[0]),
        "the draft's Keychain record is being removed"
    );
    assert_eq!(
        desk.send(json!({"kind": "verifyTenantSetup", "context": context}))
            .await,
        Err(Refusal::StaleContext)
    );
}

