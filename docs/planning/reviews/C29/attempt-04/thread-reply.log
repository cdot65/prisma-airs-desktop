//! C29 (D058): tenant setup through the production authority interface.
//! The wizard works on one core-owned draft with its own context: credentials
//! attach to it, verification is decided in the core, completion commits the
//! draft as a tenant in one step, and a discard or relaunch leaves nothing
//! behind but a cleanup of its credentials.

use desktop_core::features::{OnboardingState, ProductId, VerifyLine, VerifyState};
use desktop_core::fixtures::{self, Handles, ScriptedStore};
use desktop_core::store::PersistedState;
use desktop_core::{
    AuthorityHandle, Core, CoreConfig, Delivery, Intent, Observation, Receipt, Refusal,
    ShellSnapshot, ViewScope,
};
use serde_json::json;

const KEY: &str = "synthetic-scan-key-aaaa";

struct Desk {
    _core: Core,
    handle: AuthorityHandle,
    session: String,
    sequence: u64,
    adapters: Handles,
}

impl Desk {
    fn new() -> Self {
        Self::from_state(PersistedState::default())
    }

    fn from_state(state: PersistedState) -> Self {
        let (adapters, handles) = fixtures::adapters_with(ScriptedStore::with_state(state));
        let core = Core::new(CoreConfig::default(), adapters);
        core.start();
        let handle = core.operator();
        let session = handle.register_delivery_session().expect("session").nonce;
        Self {
            _core: core,
            handle,
            session,
            sequence: 0,
            adapters: handles,
        }
    }

    fn restart(self) -> Self {
        let state = self.adapters.store.saved().unwrap_or_default();
        drop(self._core);
        Self::from_state(state)
    }

    async fn send(&mut self, intent: serde_json::Value) -> Result<Receipt, Refusal> {
        let intent: Intent = serde_json::from_value(intent).expect("intent");
        self.sequence += 1;
        self.handle
            .dispatch(
                Delivery {
                    session: self.session.clone(),
                    sequence: self.sequence,
                },
                intent,
            )
            .await
    }

    fn snap(&self) -> ShellSnapshot {
        match self.handle.observe(ViewScope::Shell).expect("observe") {
            Observation::Shell { snapshot, .. } => snapshot,
            _ => unreachable!("shell scope"),
        }
    }

    fn setup(&self) -> desktop_core::features::SetupView {
        self.snap().setup.expect("a setup in progress")
    }

    async fn begin(&mut self, mode: &str, label: &str) -> String {
        self.send(
            json!({"kind": "beginTenantSetup", "mode": mode, "profile": {
                "label": label, "tsgId": "1234567890",
                "destination": {"kind": "region", "region": "europe"}, "environment": "staging"
            }}),
        )
        .await
        .expect("begun");
        self.setup().context.as_str().to_owned()
    }

    /// The draft's current context: it changes whenever its inputs change.
    fn context(&self) -> String {
        self.setup().context.as_str().to_owned()
    }

    async fn settled(&self, ready: bool) {
        for _ in 0..200 {
            let s = self.setup();
            let state = s.tenant.scan.state;
            let done = if ready {
                state == desktop_core::ScanState::Ready
            } else {
                state != desktop_core::ScanState::Storing
            };
            if done {
                return;
            }
            tokio::time::sleep(std::time::Duration::from_millis(5)).await;
        }
        panic!("the scan key write did not settle");
    }

    async fn verified(&self) -> desktop_core::features::VerifyView {
        for _ in 0..200 {
            if let Some(v) = self.setup().verify
                && v.done
            {
                return v;
            }
            tokio::time::sleep(std::time::Duration::from_millis(5)).await;
        }
        panic!("verification did not finish");
    }
}

#[tokio::test]
async fn a_draft_is_not_a_tenant_and_first_run_needs_the_scan_key_to_verify() {
    let mut desk = Desk::new();
    desk.send(json!({"kind": "setUiVariant", "variant": "v2"}))
        .await
        .expect("v2");
    let context = desk.begin("firstRun", "Northwind Health").await;
    let snap = desk.snap();
    assert!(snap.tenants.is_empty(), "the draft is not listed");
    assert!(snap.active.is_none());
    assert_eq!(snap.onboarding, OnboardingState::Needed);
    let setup = snap.setup.expect("setup");
    assert_eq!(setup.tenant.label, "Northwind Health");
    assert_eq!(
        setup.tenant.environment,
        desktop_core::features::TenantEnvironment::Staging
    );
    assert!(setup.scan_required);
    assert_eq!(setup.products, vec![ProductId::RuntimeSecurity]);
    assert!(setup.verify.is_none() && !setup.completable);
    // A second draft is refused while one is open.
    assert_eq!(
        desk.send(json!({"kind": "beginTenantSetup", "mode": "add", "profile": {
            "label": "Other", "tsgId": null, "destination": {"kind": "region", "region": "europe"}}}))
            .await,
        Err(Refusal::Busy)
    );
    // Without a scan key the verify run fails on first run, so completion is refused.
    desk.send(json!({"kind": "verifyTenantSetup", "context": context}))
        .await
        .expect("verify started");
    let v = desk.verified().await;
    let scan = v
        .steps
        .iter()
        .find(|s| s.line == VerifyLine::ScanKey)
        .expect("scan line");
    assert_eq!(scan.state, VerifyState::Fail);
    assert!(v.failed && !desk.setup().completable);
    assert_eq!(
        desk.send(json!({"kind": "completeTenantSetup", "context": context, "packs": []}))
            .await,
        Err(Refusal::InvalidInput)
    );
}

#[tokio::test]
async fn credentials_attach_to_the_draft_and_a_stored_key_is_never_a_pass() {
    let mut desk = Desk::new();
    let context = desk.begin("firstRun", "Northwind Health").await;
    desk.send(json!({"kind": "configureScanCredential", "context": context, "mode": "session", "key": KEY}))
        .await
        .expect("key accepted for the draft");
    desk.settled(true).await;
    let context = desk.context();
    assert!(desk.snap().tenants.is_empty(), "still no tenant");
    desk.send(json!({"kind": "verifyTenantSetup", "context": context}))
        .await
        .expect("verify");
    let v = desk.verified().await;
    let by_line = |line: VerifyLine| v.steps.iter().find(|s| s.line == line).cloned();
    let scan = by_line(VerifyLine::ScanKey).expect("scan");
    assert_eq!(
        scan.state,
        VerifyState::Stored,
        "explicitly unverified, not Pass"
    );
    assert!(scan.reason.contains("first scan proves it"));
    let management = by_line(VerifyLine::ManagementClient).expect("management");
    assert_eq!(management.state, VerifyState::Skipped);
    assert!(
        by_line(VerifyLine::Gateway).is_none(),
        "unselected products have no line"
    );
    assert!(v.done && !v.failed && !v.stale && v.warnings.is_empty());
    assert!(desk.setup().completable);
}
#[tokio::test]
async fn a_source_that_fails_inside_a_read_is_a_warning_that_reaches_the_tenant() {
    let mut desk = desk().await;
    desk.tenant_a().await;
    let origin = desk.origin.clone();
    desk.send(json!({"kind": "beginTenantSetup", "mode": "add", "profile": {"label": "Tenant B", "tsgId": TSG,
        "destination": {"kind": "custom", "origin": origin}}}))
        .await
        .expect("draft");
    let context = desk.draft_context();
    desk.send(
        json!({"kind": "configureManagementCredential", "context": context, "mode": "keychain",
        "clientId": CLIENT_ID, "secret": CLIENT_SECRET}),
    )
    .await
    .expect("draft client");
    let context = desk.draft_context();
    assert!(eventually(|| desk.setup().tenant.management.state == ScanState::Ready).await);
    desk.send(json!({"kind": "chooseSetupProducts", "context": context, "products": ["redTeam"]}))
        .await
        .expect("products");
    // Red Team scans list, but the statistics source answers 503: partial, never Pass.
    desk.send(json!({"kind": "verifyTenantSetup", "context": context}))
        .await
        .expect("verify");
    let v = desk.verified().await;
    let red_team = v
        .steps
        .iter()
        .find(|s| s.line == VerifyLine::RedTeam)
        .expect("line");
    assert_eq!(red_team.state, VerifyState::Warning, "{}", red_team.reason);
    assert!(
        red_team.reason.contains("statistics did not"),
        "{}",
        red_team.reason
    );
    assert!(v.warnings.iter().any(|w| w.product == ProductId::RedTeam));
    desk.send(json!({"kind": "completeTenantSetup", "context": context, "packs": []}))
        .await
        .expect("completed");
    let b = desk
        .snap()
        .tenants
        .into_iter()
        .find(|t| t.label == "Tenant B")
        .expect("B");
    assert!(
        b.setup_warnings
            .iter()
            .any(|w| w.product == ProductId::RedTeam && w.reason.contains("statistics did not"))
    );
}

#[tokio::test]
async fn discarding_a_draft_cancels_its_reads_in_flight_and_leaves_the_active_tenant_alone() {
    let mut desk = desk().await;
    desk.tenant_a().await;
    let a_before = desk.snap().gateway;
    let origin = desk.origin.clone();
    desk.send(json!({"kind": "beginTenantSetup", "mode": "add", "profile": {"label": "Tenant B", "tsgId": TSG,
        "destination": {"kind": "custom", "origin": origin}}}))
        .await
        .expect("draft");
    let context = desk.draft_context();
    desk.send(
        json!({"kind": "configureManagementCredential", "context": context, "mode": "keychain",
        "clientId": CLIENT_ID, "secret": CLIENT_SECRET}),
    )
    .await
    .expect("draft client");
    let context = desk.draft_context();
    assert!(eventually(|| desk.setup().tenant.management.state == ScanState::Ready).await);
    // The draft's fresh binding must fetch a token first; that request hangs.
    desk.script
        .lock()
        .expect("script")
        .hang
        .insert("/oauth2/access_token".to_owned());
    let Receipt::Admitted {
        operation: Some(operation),
        ..
    } = desk
        .send(json!({"kind": "management", "context": context,
            "request": {"kind": "gateway", "workspace": null, "read": {"kind": "inventory", "resource": "workspaces"}}}))
        .await
        .expect("admitted")
    else {
        panic!("no operation");
    };
    desk.send(json!({"kind": "verifyTenantSetup", "context": context}))
        .await
        .expect("verify started");
    tokio::time::sleep(Duration::from_millis(200)).await;
    desk.send(json!({"kind": "discardTenantSetup", "context": context}))
        .await
        .expect("discarded while reads were in flight");
    // The read queued under the draft settles cancelled, not with a result.
    let Ok(Observation::Management(handle)) = desk.handle.observe(ViewScope::Management(operation))
    else {
        panic!("management observation");
    };
    let result = tokio::time::timeout(Duration::from_secs(20), handle.result())
        .await
        .expect("settled in time");
    assert!(
        matches!(
            result,
            ManagementResult::Failed {
                failure: desktop_core::management::ManagementFailure::Cancelled,
                ..
            }
        ),
        "{result:?}"
    );
    desk.script.lock().expect("script").hang.clear();
    let snap = desk.snap();
    assert!(snap.setup.is_none());
    assert_eq!(
        snap.gateway.selected, a_before.selected,
        "A's choice untouched"
    );
    // A's own reads still work under its context and workspace reference.
    let a_context = desk.active_context();
    let a_reference = a_before.selected.expect("A").reference;
    let prerequisites = desk
        .read(
            &a_context,
            json!({"kind": "gateway", "workspace": a_reference, "read": {"kind": "prerequisites"}}),
        )
        .await;
    assert!(
        matches!(prerequisites, ManagementResult::Gateway { .. }),
        "{prerequisites:?}"
    );
}

#[tokio::test]
async fn a_replaced_client_authenticates_afresh_and_profile_changes_retire_the_binding() {
    let mut desk = desk().await;
    desk.tenant_a().await;
    let origin = desk.origin.clone();
    desk.send(json!({"kind": "beginTenantSetup", "mode": "add", "profile": {"label": "Tenant B", "tsgId": TSG,
        "destination": {"kind": "custom", "origin": origin}}}))
        .await
        .expect("draft");
    let context = desk.draft_context();
    desk.send(
        json!({"kind": "configureManagementCredential", "context": context, "mode": "keychain",
        "clientId": CLIENT_ID, "secret": CLIENT_SECRET}),
    )
    .await
    .expect("good client");
    let context = desk.draft_context();
    assert!(eventually(|| desk.setup().tenant.management.state == ScanState::Ready).await);
    desk.send(json!({"kind": "verifyTenantSetup", "context": context}))
        .await
        .expect("verify");
    let v = desk.verified().await;
    assert_eq!(v.steps[1].state, VerifyState::Pass, "{}", v.steps[1].reason);
    // Replace the secret with one the plane rejects: the cached binding must not pass for it.
    desk.send(
        json!({"kind": "configureManagementCredential", "context": context, "mode": "keychain",
        "clientId": CLIENT_ID, "secret": "wrong-synthetic-secret"}),
    )
    .await
    .expect("replaced client");
    let wrong_context = desk.draft_context();
    assert_ne!(wrong_context, context);
    assert!(eventually(|| desk.setup().tenant.management.state == ScanState::Ready).await);
    desk.send(json!({"kind": "verifyTenantSetup", "context": wrong_context}))
        .await
        .expect("verify");
    let v = desk.verified().await;
    assert_eq!(v.steps[1].state, VerifyState::Fail, "{}", v.steps[1].reason);
    assert!(
        v.steps[1].reason.contains("not accepted"),
        "{}",
        v.steps[1].reason
    );
    assert!(
        !v.blocking && desk.setup().completable,
        "an optional failure"
    );
    // Remove the client, add the right one back: it authenticates afresh.
    desk.send(json!({"kind": "removeManagementCredential", "context": wrong_context}))
        .await
        .expect("removed");
    let removed_context = desk.draft_context();
    assert_ne!(removed_context, wrong_context);
    assert_eq!(desk.setup().tenant.management.state, ScanState::Missing);
    desk.send(json!({"kind": "configureManagementCredential", "context": removed_context, "mode": "keychain",
        "clientId": CLIENT_ID, "secret": CLIENT_SECRET}))
        .await
        .expect("re-added");
    let context = desk.draft_context();
    assert!(eventually(|| desk.setup().tenant.management.state == ScanState::Ready).await);
    desk.send(json!({"kind": "verifyTenantSetup", "context": context}))
        .await
        .expect("verify");
    let v = desk.verified().await;
    assert_eq!(v.steps[1].state, VerifyState::Pass, "{}", v.steps[1].reason);
    // A TSG change retires the management credential (it was bound to the TSG) and the context.
    let origin = desk.origin.clone();
    desk.send(json!({"kind": "updateTenantSetup", "context": context, "profile": {"label": "Tenant B", "tsgId": "9876543210",
        "destination": {"kind": "custom", "origin": origin}}}))
        .await
        .expect("tsg changed");
    let setup = desk.setup();
    assert_ne!(setup.context.as_str(), context);
    assert_eq!(setup.tenant.tsg_id.as_deref(), Some("9876543210"));
    assert_eq!(
        setup.tenant.management.state,
        ScanState::Missing,
        "the client went with the old TSG"
    );
    assert!(setup.verify.is_none());
    assert_eq!(
        desk.send(json!({"kind": "verifyTenantSetup", "context": context}))
            .await,
        Err(Refusal::StaleContext)
    );
}
    assert_ne!(renewed, session);
    assert_eq!(
        dispatch(&h, &session, "3", "dark").expect("retired"),
        json!({"outcome": "refusal", "refusal": "staleContext"}),
        "a retired session cannot deliver after re-registration"
    );
    assert_eq!(
        dispatch(&h, &renewed, "1", "dark").expect("renewed")["outcome"],
        json!("receipt")
    );
}

#[test]
fn malformed_requests_are_refused_before_authority() {
    let h = harness();
    let session = register(&h);
    let cases = fixture("rejected-requests.json");
    for case in cases["dispatch"].as_array().expect("dispatch cases") {
        let mut body = case["body"].clone();
        if body.get("session").and_then(Value::as_str) == Some("ds-x") {
            body["session"] = json!(session);
        }
        assert_eq!(
            call(&h.main, "desktop_dispatch", raw(&body)),
            Err(json!("invalidInput")),
            "{}",
            case["case"]
        );
    }
    for case in cases["observe"].as_array().expect("observe cases") {
        assert_eq!(
            call(&h.main, "desktop_observe", raw(&case["body"])),
            Err(json!("invalidInput")),
            "{}",
            case["case"]
        );
    }
    // None of the refused deliveries consumed a sequence.
    assert_eq!(
        dispatch(&h, &session, "1", "dark").expect("first")["outcome"],
        json!("receipt")
    );
}

#[test]
fn json_bodies_and_oversized_payloads_are_refused() {
    let h = harness();
    let body = fixture("dispatch-request.json");
    assert_eq!(
        call(&h.main, "desktop_dispatch", InvokeBody::Json(body)),
        Err(json!("invalidInput")),
        "JSON bodies bypass the size ceiling"
    );
    let mut huge = b"{\"protocol\":1,\"session\":\"ds-x\",\"sequence\":\"1\",\"intent\":{\"kind\":\"setAppearance\",\"theme\":\"dark\"},\"pad\":\"".to_vec();
    huge.resize(desktop_core::wire::MAX_REQUEST_BYTES + 1, b'a');
    assert_eq!(
        call(&h.main, "desktop_dispatch", InvokeBody::Raw(huge)),
        Err(json!("invalidInput"))
    );
}

