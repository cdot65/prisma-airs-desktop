import { useEffect, useId, useRef, type KeyboardEvent, type ReactNode } from 'react'
import { useShellStore } from './store'

interface ModalProps {
    label: string
    onClose: () => void
    children: ReactNode
    /** Width in CSS px (default 560). */
    width?: number
    /** Inner padding in CSS px (default 20); 0 for a dialog that lays itself out edge to edge. */
    padding?: number
    /** Distance from the top of the window in CSS px (default 4vh); the prototype's palette sits at 90. */
    top?: number
    /** Corner radius in CSS px (default 12; the palette's frame is 14). */
    radius?: number
    /** A sheet docked to the window's right edge under the header (R2App's review sheet, 620px wide, full height). */
    sheet?: boolean
    /**
     * The control focus returns to on close when the opener itself will be gone
     * by then (a menu item that closes with its menu as the dialog opens): an
     * explicit surviving target instead of whatever had focus at mount.
     */
    returnFocus?: HTMLElement | null
    'data-slot'?: string
}

const FOCUSABLE = 'a[href], button:not([disabled]), input:not([disabled]), select:not([disabled]), textarea:not([disabled]), [tabindex]:not([tabindex="-1"])'

/**
 * One topmost modal (I8): dialogs register on a shell-wide stack; only the
 * last is interactive. Lower dialogs are inert and aria-hidden, Tab and
 * Shift-Tab stay inside the topmost dialog, Escape closes the topmost only,
 * focus moves into the dialog on open and back to the opener on close. The
 * page behind every dialog is made inert by the shell (`useModalsOpen`).
 * The dialog element handles its own keys; the topmost dialog also listens
 * on the window for Escape alone, for when focus has left it (a native
 * sheet returned focus elsewhere), and closes only itself.
 */
export function Modal({ label, onClose, children, width = 560, padding = 20, top, radius = 12, sheet = false, returnFocus = null, ...rest }: ModalProps) {
    const id = useId()
    const pushModal = useShellStore((s) => s.pushModal)
    const popModal = useShellStore((s) => s.popModal)
    const modals = useShellStore((s) => s.modals)
    const topmost = modals.length > 0 && modals[modals.length - 1] === id
    const dialog = useRef<HTMLDivElement>(null)
    const opener = useRef<HTMLElement | null>(null)
    const returnRef = useRef(returnFocus)
    returnRef.current = returnFocus
    const focusedOnce = useRef(false)

    useEffect(() => {
        opener.current = document.activeElement instanceof HTMLElement ? document.activeElement : null
        pushModal(id)
        return () => {
            popModal(id)
            // After the commit: the page behind is still inert during cleanup,
            // and an inert ancestor refuses focus (observed in WebKit).
            const target = returnRef.current ?? opener.current
            queueMicrotask(() => {
                // Only when nothing else took focus meanwhile (⌘T replacing the
                // palette hands focus to the tenant list, which must keep it).
                const active = document.activeElement
                if (active && active !== document.body) return
                // The opener may be gone (a "Finish rotation…" that completed):
                // focus the page heading rather than leave it on nothing.
                if (target?.isConnected) target.focus()
                else document.querySelector<HTMLElement>('main h1[tabindex="-1"]')?.focus()
            })
        }
    }, [id, pushModal, popModal])

    useEffect(() => {
        // Initial focus goes into the dialog once, when it opens. Regaining the
        // top after a higher dialog closes must not refocus: that dialog is
        // restoring its own opener, which may be any control here.
        if (!topmost || focusedOnce.current) return
        const node = dialog.current
        if (!node) return
        focusedOnce.current = true
        if (!node.contains(document.activeElement)) {
            // A declared initial control first (wherever it sits), else the first focusable.
            const first = node.querySelector<HTMLElement>('[autofocus]') ?? node.querySelector<HTMLElement>(FOCUSABLE)
            ;(first ?? node).focus()
        }
    }, [topmost])

    // Escape still closes the topmost dialog when focus has left it (a
    // native sheet returning focus to the page body, a click on the scrim's
    // edge): the dialog's own handler stops the event first when it has focus.
    const closeRef = useRef(onClose)
    closeRef.current = onClose
    useEffect(() => {
        if (!topmost) return
        const onWindowKey = (event: globalThis.KeyboardEvent) => {
            if (event.key !== 'Escape' || event.defaultPrevented) return
            const node = dialog.current
            if (node && node.contains(document.activeElement)) return
            event.preventDefault()
            closeRef.current()
        }
        window.addEventListener('keydown', onWindowKey)
        return () => window.removeEventListener('keydown', onWindowKey)
    }, [topmost])

    const onKeyDown = (event: KeyboardEvent<HTMLDivElement>) => {
        if (!topmost) return
        if (event.key === 'Escape') {
            event.preventDefault()
            event.stopPropagation()
            onClose()
            return
        }
        if (event.key === 'Tab') {
            // Keyboard interaction stays inside the topmost dialog.
            const node = dialog.current
            if (!node) return
            const items = Array.from(node.querySelectorAll<HTMLElement>(FOCUSABLE)).filter((el) => !el.hasAttribute('hidden') && el.getAttribute('aria-hidden') !== 'true')
            if (items.length === 0) {
                event.preventDefault()
                node.focus()
                return
            }
            const first = items[0] as HTMLElement
            const last = items[items.length - 1] as HTMLElement
            const active = document.activeElement
            if (event.shiftKey && (active === first || active === node)) {
                event.preventDefault()
                last.focus()
            } else if (!event.shiftKey && active === last) {
                event.preventDefault()
                first.focus()
            }
        }
    }

    return (
        <div
            className={sheet ? 'fixed z-50 flex justify-end' : 'fixed inset-0 z-50 grid place-items-start justify-center'}
            style={sheet ? { inset: 'var(--v2-header, 56px) 0 0 0' } : { paddingTop: top ?? '4vh' }}
            data-v2-scrim=''
            aria-hidden={topmost ? undefined : true}
            inert={topmost ? undefined : true}
            onMouseDown={() => topmost && onClose()}
        >
            <div
                ref={dialog}
                role='dialog'
                aria-modal={topmost ? 'true' : undefined}
                aria-label={label}
                tabIndex={-1}
                data-slot={rest['data-slot'] ?? 'modal'}
                data-topmost={topmost ? 'true' : 'false'}
                onKeyDown={onKeyDown}
                onMouseDown={(e) => e.stopPropagation()}
                className='border'
                // Bounded to the viewport: a tall dialog scrolls inside itself, so its
                // actions stay reachable at the minimum window size and 200% zoom.
                style={
                    sheet
                        ? { width: `min(${width}px, 100vw)`, height: '100%', overflowY: 'auto', padding, borderRadius: 0, borderLeft: '1px solid var(--v2-rule)', boxShadow: '-18px 0 40px rgba(0,0,0,0.18)', background: 'var(--v2-bg)', borderWidth: 0, color: 'var(--v2-ink)' }
                        : { width: `min(${width}px, 92vw)`, maxHeight: '92vh', overflowY: 'auto', padding, borderRadius: radius, boxShadow: '0 24px 60px rgba(0,0,0,0.3)', background: 'var(--v2-paper)', borderColor: 'var(--v2-rule)', color: 'var(--v2-ink)' }
                }
            >
                {children}
            </div>
                        </button>
                    )}
                    <p role='status' aria-live='polite' data-slot='wizard-status' className='flex min-w-0 items-center text-[12.5px]' style={{ gap: 10, color: status ? 'var(--v2-ink)' : 'var(--v2-soft)' }}>
                        <span className='min-w-0'>{status?.text ?? hint}</span>
                        {status?.retry && <Secondary label={C.outcome.retry} onClick={status.retry} />}
                    </p>
                    <span className='ml-auto text-[12px]' style={{ color: 'var(--v2-faint)' }} data-slot='wizard-progress'>
                        {C.progress(index + 1, steps.length)}
                    </span>
                    {extra && <Secondary label={extra.label} onClick={extra.onClick} disabled={extra.disabled} />}
                    {secondary && <Secondary label={secondary.label} onClick={secondary.onClick} disabled={secondary.disabled} />}
                    {skipBtn && <Secondary label={skipBtn.label} onClick={skipBtn.onClick} disabled={skipBtn.disabled} />}
                    <button type='button' onClick={primary.onClick} disabled={primary.disabled} className='h-8 rounded-[7px] px-[18px] text-[13px] font-semibold disabled:opacity-60' style={{ background: 'var(--v2-acc)', color: 'var(--v2-acc-ink)' }} data-slot='wizard-primary'>
                        {primary.label}
                    </button>
                </footer>
            </div>
            {/* The guard is a dialog above the sheet (I8): rendered at the body, outside the sheet's inert subtree. */}
            {completionGuard && setup && createPortal(<SwitchGuard target={setup.tenant.label} completion onStay={() => void dispatch({ kind: 'dismissSwitchGuard' })} onResolve={(resolution) => void finish(resolution)} />, document.body)}
        </div>
    )
}

/** A section card with a switch in its header (R2Onboard's optional cards); a required card has no switch and stays open. */
function OptionalCard({ icon, title, text, tag, open, onToggle, switchLabel, state, slot, onSubmit, busy, children }: { icon: GlyphName; title: string; text: string; tag: string; open: boolean; onToggle?: (on: boolean) => void; switchLabel?: string; state?: ReactNode; slot: string; onSubmit?: (e: FormEvent<HTMLFormElement>) => void; busy?: boolean; children: ReactNode }) {
    const Tag = onSubmit ? 'form' : 'section'
    return (
        <Tag onSubmit={onSubmit} aria-busy={onSubmit ? busy : undefined} aria-label={onSubmit ? undefined : title} className='flex flex-col rounded-[12px] border' style={{ gap: 12, padding: '18px 20px', borderColor: 'var(--v2-rule)', background: 'var(--v2-paper)' }} data-slot={slot}>
            <div className='flex items-center' style={{ gap: 12 }}>
                <span className='grid shrink-0 place-items-center rounded-[8px]' style={{ width: 30, height: 30, background: 'var(--v2-inset)', color: 'var(--v2-soft)' }}>
                    <Glyph name={icon} size={15} color='var(--v2-soft)' />
                </span>
                <span className='min-w-0 flex-grow'>
                    <span className='flex items-center' style={{ gap: 8 }}>
                        <b className='text-[14px]'>{title}</b>
                        <span className='rounded-full text-[12px] font-semibold' style={{ padding: '1px 7px', background: 'var(--v2-inset)', color: 'var(--v2-faint)' }}>
                            {tag}
                        </span>
                        {state}
                    </span>
                    <span className='text-[12px]' style={{ color: 'var(--v2-soft)' }}>
                        {text}
                    </span>
                </span>
                {onToggle && (
                    <button type='button' role='switch' aria-checked={open} aria-label={switchLabel ?? title} onClick={() => onToggle(!open)} className='relative shrink-0 rounded-full' style={{ width: 38, height: 22, border: 0, background: open ? 'var(--v2-acc)' : 'var(--v2-inset)', boxShadow: `inset 0 0 0 1px ${open ? 'var(--v2-acc)' : 'var(--v2-ctl)'}` }} data-slot='switch'>
                        <span className='absolute rounded-full' style={{ top: 3, left: open ? 19 : 3, width: 16, height: 16, background: open ? 'var(--v2-acc-ink)' : 'var(--v2-paper)' }} />
                    </button>
                )}
            </div>
            {open && (
                <div className='flex flex-col' style={{ gap: 10, paddingLeft: 42 }}>
                    {children}
                </div>
            )}
        </Tag>
    )
}

function Field({ label, name, hint, error, onBlur, value, onChange, ...rest }: { label: string; name: string; hint?: string; error?: string; onBlur?: (value: string) => void; value?: string; onChange?: (value: string) => void; maxLength?: number; inputMode?: 'numeric' }) {
    const id = useId()
    return (
        <label className='flex flex-col text-[12px] font-semibold' style={{ gap: 5, color: 'var(--v2-soft)' }}>
            {label}
            <input id={id} name={name} autoComplete='off' value={value} onChange={onChange ? (e) => onChange(e.target.value) : undefined} aria-invalid={error ? true : undefined} aria-describedby={error ? `${id}-error` : hint ? `${id}-hint` : undefined} onBlur={(e) => onBlur?.(e.target.value)} className='h-8 min-h-0 rounded-[7px] border px-2.5 text-[13px] font-normal' style={{ borderColor: error ? 'var(--v2-block)' : 'var(--v2-ctl)', background: 'var(--v2-bg)', color: 'var(--v2-ink)' }} {...rest} />
            {error ? (
                <span id={`${id}-error`} role='alert' className='font-normal' style={{ color: 'var(--v2-block)' }}>
                    {error}
                </span>
            ) : hint ? (
                <span id={`${id}-hint`} className='font-normal' style={{ color: 'var(--v2-faint)' }}>
                    {hint}
                </span>
            ) : null}
        </label>
    )
}

/** A password field read once through its ref and cleared by the caller (P25). */
function SecretField({ label, inputRef, error }: { label: string; inputRef: React.RefObject<HTMLInputElement | null>; error?: string }) {
    const id = useId()
    return (
        <label className='flex flex-col text-[12px] font-semibold' style={{ gap: 5, color: 'var(--v2-soft)' }}>
            {label}
            <input id={id} ref={inputRef} type='password' autoComplete='off' aria-invalid={error ? true : undefined} aria-describedby={error ? `${id}-error` : undefined} className='h-8 min-h-0 rounded-[7px] border px-2.5 text-[13px] font-normal' style={{ borderColor: error ? 'var(--v2-block)' : 'var(--v2-ctl)', background: 'var(--v2-bg)', color: 'var(--v2-ink)' }} />
            {error && (
                <span id={`${id}-error`} role='alert' className='font-normal' style={{ color: 'var(--v2-block)' }}>
                    {error}
                </span>
            )}
        </label>
    )
}

function Primary({ label, disabled }: { label: string; disabled?: boolean }) {
    return (
        <button type='submit' disabled={disabled} className='h-8 rounded-[7px] px-4 text-[13px] font-semibold disabled:opacity-60' style={{ background: 'var(--v2-acc)', color: 'var(--v2-acc-ink)' }}>
            {label}
        </button>
    )
}

function Secondary({ label, onClick, disabled }: { label: string; onClick: () => void; disabled?: boolean }) {
    return (
        <button type='button' onClick={onClick} disabled={disabled} className='h-8 rounded-[7px] border px-3 text-[13px] disabled:opacity-60' style={{ borderColor: 'var(--v2-rule)', background: 'var(--v2-paper)', color: 'var(--v2-ink)' }}>
            {label}
        </button>
    )
}
import { useCallback, useEffect, useLayoutEffect, useRef, useState } from 'react'
import {
    DeliveryOutcomeUnknown,
    type DesktopClient,
    type FeatureId,
    type Intent,
    type MenuCommand,
    type Refusal,
    type ShellSnapshot,
    type Theme,
} from '@prisma-airs/desktop-contracts'
import { followAppearance } from './shell/appearance'
import { type DispatchOutcome, outcomeMessage } from './features/tenants/dispatch'
import { V2Shell } from './v2/v2-shell'
import { Wizard } from './v2/wizard/wizard'
import { useShellStore } from './v2/store'
import { SHELL_COPY } from './v2/copy'
import { forgetAcademyPresentation } from './features/academy/presentation-storage'
import { SAVE_DOCUMENT_EVENT } from './v2/workbench/request-editor'

export function App({ client }: { client: DesktopClient }) {
    const [snapshot, setSnapshot] = useState<ShellSnapshot | null>(null)
    const snapshotRef = useRef<ShellSnapshot | null>(null)
    snapshotRef.current = snapshot
    const [failure, setFailure] = useState<string | null>(null)
    const [pending, setPending] = useState(false)
    const [status, setStatus] = useState('')

    const dispatch = useCallback(
        async (intent: Intent): Promise<DispatchOutcome> => {
            try {
                const response = await client.dispatch(intent)
                return response.outcome === 'refusal'
                    ? { kind: 'refused', refusal: response.refusal }
                    : { kind: 'admitted', operation: response.receipt.operation }
            } catch (error) {
                return error instanceof DeliveryOutcomeUnknown ? { kind: 'unknown' } : { kind: 'failed' }
            }
        },
        [client]
    )

    // v2 (C28): navigation is Rust-owned. The native menu, the sidebar and
    // the palette all dispatch `navigate`; refusals reach the status surface.
    const v2Navigate = useCallback(
        async (feature: FeatureId) => {
            useShellStore.getState().closePalette()
            const intent: Intent = { kind: 'navigate', feature }
            const outcome = await dispatch(intent)
            if (outcome.kind === 'refused') useShellStore.getState().toast(SHELL_COPY.toastRefused('Navigation', outcome.refusal), 'warn')
            // Unknown delivery is kept inline with Retry; never an expiring toast alone.
            else if (outcome.kind === 'unknown') useShellStore.getState().addUnconfirmed('Navigation', intent)
            else if (outcome.kind === 'failed') useShellStore.getState().toast(SHELL_COPY.toastFailed('Navigation'), 'warn')
        },
        [dispatch]
    )
    // Every v2 action's outcome reaches the shell's surfaces (DESIGN-V2 §7):
    // a refusal or failed delivery as a warn toast naming what was asked, an
    // unconfirmed delivery inline with Retry, never replayed on its own.
    const v2Act = useCallback(
        async (what: string, intent: Intent, quiet: Refusal[] = []): Promise<DispatchOutcome> => {
            // A context-bound action speaks for the tenant it was sent in (I2).
            const boundContext = typeof (intent as { context?: unknown }).context === 'string' ? (intent as { context: string }).context : null
            const bound = boundContext !== null ? (snapshotRef.current?.active?.tenant ?? null) : null
            const outcome = await dispatch(intent)
            if (outcome.kind === 'refused' && quiet.includes(outcome.refusal)) return outcome
            if (outcome.kind === 'refused') useShellStore.getState().toast(SHELL_COPY.toastRefused(what, outcome.refusal, outcomeMessage(outcome)), 'warn', undefined, bound, boundContext)
            else if (outcome.kind === 'unknown') useShellStore.getState().addUnconfirmed(what, intent)
            else if (outcome.kind === 'failed') useShellStore.getState().toast(SHELL_COPY.toastFailed(what), 'warn', undefined, bound, boundContext)
            return outcome
        },
        [dispatch]
    )
    const v2Preference = useCallback(
        async (what: string, intent: Intent, quiet: Refusal[] = []) => {
            await v2Act(what, intent, quiet)
        },
        [v2Act]
    )

    const onMenu = useRef<(command: MenuCommand) => void>(() => undefined)
    onMenu.current = (command: MenuCommand) => {
        // Native navigation dismisses the modal palette first so focus can
        // move to the new page heading instead of behind an open dialog.
        if (command.kind === 'navigate') void v2Navigate(command.feature)
        else if (command.kind === 'commandPalette') useShellStore.getState().openPalette()
        // ⌘T: the tenant switcher opens; nothing switches until chosen.
        else if (command.kind === 'tenantSwitcher') useShellStore.getState().setSwitcher(true)
        // The open API Client request saves (its editor listens).
        else if (command.kind === 'saveDocument') window.dispatchEvent(new Event(SAVE_DOCUMENT_EVENT))
        else void v2Preference('The appearance change', { kind: 'setAppearance', theme: command.theme })
    }

    useEffect(() => {
        let stop: (() => void) | undefined
        let cancelled = false
        client
            .observeShell({
                onSnapshot: (next) => {
                    // The shell's scope follows the snapshot before it renders: a
                    // notification for another tenant or context is never surfaced.
                    useShellStore.getState().setScope(next.active?.tenant ?? null, next.active?.context ?? null)
                    setSnapshot(next)
                },
                onMenu: (command) => onMenu.current(command),
                onError: () => setFailure('The desktop sent an unexpected update.'),
            })
            .then(
                (unsubscribe) => {
                    if (cancelled) unsubscribe()
                    else stop = unsubscribe
                },
                () => setFailure('The desktop shell could not be observed.')
            )
        return () => {
            cancelled = true
            stop?.()
        }
    }, [client])

    // A completed reset also forgets Academy's WebView presentation state
    // (completion latches keyed by account); a stopped reset keeps it.
    const storage = snapshot?.storage
    const resetFailed = Boolean(snapshot?.resetFailure)
    const previousStorage = useRef(storage)
    useEffect(() => {
        if (previousStorage.current === 'resetting' && storage !== 'resetting' && !resetFailed) {
            forgetAcademyPresentation()
        }
        previousStorage.current = storage
    }, [storage, resetFailed])

    const appearance = snapshot?.appearance
    // Apply the theme in the same commit as the snapshot, before paint, so
    // the shell never shows a frame in the previous theme.
    useLayoutEffect(() => (appearance ? followAppearance(appearance) : undefined), [appearance])

    if (failure && !snapshot) {
        return (
            <main role='alert' className='text-academy-ink p-8'>
                {failure}
            </main>
        )
    }
    if (!snapshot) {
        return (
            <main role='status' aria-live='polite' className='text-academy-ink-soft p-8'>
                Starting Prisma AIRS Desktop…
            </main>
        )
    }
    if (snapshot.onboarding !== 'done') {
        // First run: the wizard owns the window (D060: no alpha import; nothing leaves it before a tenant exists).
        return (
            <div data-v2-shell=''>
                <Wizard
                    snapshot={snapshot}
                    dispatch={dispatch}
                    observeManagement={(operation) => client.observeManagement(operation)}
                    mode='firstRun'
                    onClose={() => undefined}
                    onNavigate={(feature) => void v2Navigate(feature)}
                />
            </div>
        )
    }
    return (
        <V2Shell
            snapshot={snapshot}
            appearancePending={pending}
            status={failure ?? status}
            onNavigate={(feature) => void v2Navigate(feature)}
            onSetAppearance={(theme) => void v2Preference('The appearance change', { kind: 'setAppearance', theme })}
            onSetShowCalls={(on) => void v2Preference('The preference change', { kind: 'setShowCalls', on })}
            onSwitchTenant={(tenant, resolution) => {
                // The target is captured now: a late refusal still names it. A
                // pending-decision refusal is not a toast: the snapshot carries
                // the guard the shell renders (I1).
                const label = snapshot.tenants.find((t) => t.id === tenant)?.label ?? tenant
                void v2Preference(SHELL_COPY.switchTo(label), { kind: 'selectTenant', tenant, resolution: resolution ?? null }, ['decisionPending'])
            }}
            onReadNow={() => {
                // The palette's Read now is the same finite read of every chosen product (I4).
                const active = snapshot.active
                if (!active) return
                const label = snapshot.tenants.find((t) => t.id === active.tenant)?.label ?? active.tenant
                void v2Preference(SHELL_COPY.readOf(label), { kind: 'readTenant', context: active.context })
            }}
            onRetry={(what, intent) => void v2Preference(what, intent)}
            onAct={v2Act}
            dispatch={dispatch}
            client={client}
        />
    )
}

