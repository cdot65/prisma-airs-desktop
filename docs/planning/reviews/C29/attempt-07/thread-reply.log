        .tenants
        .iter()
        .find(|t| t.label == "Tenant B")
        .expect("B");
    assert!(
        b.setup_warnings
            .iter()
            .any(|w| w.reason.starts_with("Failed: ")),
        "the failure is recorded, not converted to a pass"
