//! Tenant profiles: nonsecret identity and approved scan destination.
//!
//! A tenant profile carries a native-issued ID, an operator label, an optional
//! TSG identifier and the HTTPS origin its scan credential may be sent to. It
//! never carries a secret; credentials are separate records bound to the
//! profile's approved destination (see `vault`).

use serde::{Deserialize, Serialize};
use ts_rs::TS;

/// Longest operator label, in characters.
pub const MAX_LABEL_CHARS: usize = 64;
/// Longest TSG identifier, in digits.
pub const MAX_TSG_DIGITS: usize = 32;
/// Longest custom origin, in bytes.
pub const MAX_ORIGIN_BYTES: usize = 2048;

/// Native-issued tenant identifier (`tn-` + 16 hex digits). Deserialization
/// accepts only that shape, so arbitrary text is never treated as an ID.
#[derive(Clone, Debug, PartialEq, Eq, PartialOrd, Ord, Hash, Serialize, TS)]
#[serde(transparent)]
pub struct TenantId(String);

impl<'de> Deserialize<'de> for TenantId {
    fn deserialize<D: serde::Deserializer<'de>>(deserializer: D) -> Result<Self, D::Error> {
        let text = String::deserialize(deserializer)?;
        Self::parse(&text).ok_or_else(|| serde::de::Error::custom("not a tenant id"))
    }
}

impl TenantId {
    pub(crate) fn issue() -> Option<Self> {
        let mut entropy = [0u8; 8];
        getrandom::fill(&mut entropy).ok()?;
        Some(Self(format!("tn-{}", hex::encode(entropy))))
    }

    /// Accepts only the native-issued shape; other text is never an ID.
    pub fn parse(text: &str) -> Option<Self> {
        let hex_part = text.strip_prefix("tn-")?;
        (hex_part.len() == 16
            && hex_part
                .bytes()
                .all(|b| matches!(b, b'0'..=b'9' | b'a'..=b'f')))
        .then(|| Self(text.to_owned()))
    }

    pub fn as_str(&self) -> &str {
        &self.0
    }
}

/// AIRS scan regions offered by the SDK (`scm_sdk` `Region::endpoint`).
#[derive(Clone, Copy, Debug, PartialEq, Eq, Serialize, Deserialize, TS)]
#[serde(rename_all = "camelCase")]
pub enum Region {
    UnitedStates,
    Europe,
    India,
    Singapore,
}

impl Region {
    pub fn origin(self) -> &'static str {
        match self {
            Region::UnitedStates => "https://service.api.aisecurity.paloaltonetworks.com",
            Region::Europe => "https://service-de.api.aisecurity.paloaltonetworks.com",
            Region::India => "https://service-in.api.aisecurity.paloaltonetworks.com",
            Region::Singapore => "https://service-sg.api.aisecurity.paloaltonetworks.com",
        }
    }
}

/// Where a tenant's scan requests (and therefore its scan key) may go.
#[derive(Clone, Debug, PartialEq, Eq, Serialize, Deserialize, TS)]
#[serde(tag = "kind", rename_all = "camelCase", deny_unknown_fields)]
pub enum Destination {
    Region {
        region: Region,
    },
    /// An operator-reviewed custom HTTPS origin (`https://host[:port]`).
    Custom {
        origin: String,
    },
}

impl Destination {
    /// The exact origin credentials are bound to.
    pub fn origin(&self) -> &str {
        match self {
            Destination::Region { region } => region.origin(),
            Destination::Custom { origin } => origin,
        }
    }

    /// Validates a draft and normalizes a custom origin to its ASCII origin.
    pub fn validate(self) -> Option<Self> {
        match self {
            Destination::Region { .. } => Some(self),
            Destination::Custom { origin } => {
                normalize_origin(&origin).map(|origin| Destination::Custom { origin })
            }
        }
    }
}

/// HTTPS origin only: host required; no userinfo, path, query or fragment.
pub fn normalize_origin(text: &str) -> Option<String> {
    if text.is_empty() || text.len() > MAX_ORIGIN_BYTES || text.trim() != text {
        return None;
    }
    let url = url::Url::parse(text).ok()?;
    let plain = url.scheme() == "https"
        && url.host_str().is_some_and(|h| !h.is_empty())
        && url.username().is_empty()
        && url.password().is_none()
        && url.query().is_none()
        && url.fragment().is_none()
        && (url.path().is_empty() || url.path() == "/");
    if !plain {
//! Classic macOS Keychain credential adapter (DESIGN "Native Harness,
//! identity and protected storage").
//!
//! Generic-password items with service = this build's v2 namespace and
//! account = the immutable credential record ID; local, non-synchronizing,
//! default application ACL. Production uses the login Keychain and allows the
//! OS authorization prompts; fixture builds use a dedicated test keychain and
//! the fixture namespace. Every call is serialized (the user-interaction
//! setting is process-global), and OS status codes map to sanitized
//! [`VaultError`]s: a keychain that is locked reports `Locked`, an item the
//! process may not read reports `Denied`. Purge deletes only items in this
//! namespace; v1 and foreign items are never addressed.
//!
//! `SecKeychainItem::delete` in security-framework discards the OS status, and
//! the keychain lock status is not bound, so this module calls those two
//! Security functions directly.
#![allow(unsafe_code)]

use std::path::Path;
use std::sync::Mutex;

use core_foundation::base::TCFType;
use desktop_core::CredentialStore;
use desktop_core::vault::{RecordId, Vault, VaultError};
use security_framework::item::{ItemClass, ItemSearchOptions, Limit, Reference, SearchResult};
use security_framework::os::macos::keychain::{CreateOptions, SecKeychain};
use security_framework::os::macos::keychain_item::SecKeychainItem;
use security_framework_sys::base::SecKeychainRef;

/// Security status code (`OSStatus` in `<MacTypes.h>`).
type OSStatus = i32;
use zeroize::Zeroizing;

/// The production v2 scan-credential namespace (independent of v1's
/// `io.cdot.prisma-airs-desktop`).
pub const SCAN_SERVICE: &str = "io.cdot.prisma-airs-desktop.v2.scan";
/// The fixture build's namespace, used only in its dedicated test keychain.
pub const FIXTURE_SCAN_SERVICE: &str = "io.cdot.prisma-airs-desktop.v2.fixture.scan";
/// The Academy learner namespace (refresh token of the signed-in learner).
pub const ACADEMY_SERVICE: &str = "io.cdot.prisma-airs-desktop.v2.academy";
/// The fixture build's Academy learner namespace.
pub const FIXTURE_ACADEMY_SERVICE: &str = "io.cdot.prisma-airs-desktop.v2.fixture.academy";

const ERR_SEC_ITEM_NOT_FOUND: OSStatus = -25300;
const ERR_SEC_INTERACTION_NOT_ALLOWED: OSStatus = -25308;
const ERR_SEC_AUTH_FAILED: OSStatus = -25293;
const ERR_SEC_USER_CANCELED: OSStatus = -128;
const ERR_SEC_NO_SUCH_KEYCHAIN: OSStatus = -25294;
const ERR_SEC_INVALID_KEYCHAIN: OSStatus = -25295;
const K_SEC_UNLOCK_STATE_STATUS: u32 = 1;

unsafe extern "C" {
    fn SecKeychainGetStatus(keychain: SecKeychainRef, status: *mut u32) -> OSStatus;
    #[cfg(feature = "test-fixtures")]
    fn SecKeychainLock(keychain: SecKeychainRef) -> OSStatus;
    #[cfg(feature = "test-fixtures")]
    fn SecKeychainUnlock(
        keychain: SecKeychainRef,
        length: u32,
        password: *const std::ffi::c_void,
        use_password: u8,
    ) -> OSStatus;
}

/// Whether the OS may show its own authorization prompts.
#[derive(Clone, Copy, Debug, PartialEq, Eq)]
pub enum Interaction {
    Allowed,
    Disallowed,
}

static KEYCHAIN_CALLS: Mutex<()> = Mutex::new(());

/// A credential store over one keychain and namespace.
pub struct KeychainStore {
    keychain: SecKeychain,
    service: &'static str,
    interaction: Interaction,
}

// SAFETY (Send/Sync): SecKeychainRef is a Core Foundation object whose
// Security APIs are thread-safe; every call here is additionally serialized.
unsafe impl Send for KeychainStore {}
unsafe impl Sync for KeychainStore {}

impl KeychainStore {
    /// The login Keychain with the production scan namespace.
    pub fn login() -> Result<Self, VaultError> {
        Self::login_service(SCAN_SERVICE)
    }

    /// The login Keychain with one of this build's production namespaces.
    pub fn login_service(service: &'static str) -> Result<Self, VaultError> {
        Ok(Self {
            keychain: SecKeychain::default().map_err(|e| map(e.code(), None))?,
            service,
            interaction: Interaction::Allowed,
        })
    }

    /// A dedicated file keychain (fixture builds and tests). Creates it with
    /// `password` when absent and unlocks it.
    pub fn file(
        path: &Path,
        password: &str,
        service: &'static str,
        interaction: Interaction,
    ) -> Result<Self, VaultError> {
        let mut keychain = if path.exists() {
            SecKeychain::open(path).map_err(|e| map(e.code(), None))?
        } else {
            CreateOptions::new()
                .password(password)
                .prompt_user(false)
                .create(path)
                .map_err(|e| map(e.code(), None))?
        };
        keychain
            .unlock(Some(password))
            .map_err(|e| map(e.code(), None))?;
        Ok(Self {
            keychain,
            service,
            interaction,
        })

