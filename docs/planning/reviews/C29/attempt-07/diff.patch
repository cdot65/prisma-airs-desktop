+def labels(nodes, roles, prefix=""):
+    roles = (roles,) if isinstance(roles, str) else roles
+    out = []
+    for n in nodes:
+        label = n.get("label") or ""
+        if n.get("role") in roles and label.startswith(prefix) and label not in out:
+            out.append(label)
+    return out
