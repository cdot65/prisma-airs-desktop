+                                                <Glyph name={tone === 'ok' ? 'check' : tone === 'warn' ? 'alert' : 'dot'} size={13} color={tone === 'ok' ? 'var(--v2-ok)' : tone === 'warn' ? 'var(--v2-flag)' : 'var(--v2-soft)'} />
