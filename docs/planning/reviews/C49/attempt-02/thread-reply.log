src/learn.ts-20-    emptyResults: 'Nothing matches. Try fewer words, or another chip.',\n.inputs/academy/packages/shared/src/learn.ts-21-    continueKicker: 'Continue',\n.inputs/academy/packages/shared/src/learn.ts-22-} as const\n.inputs/academy/packages/shared/src/learn.ts-23-\nimport * as React from 'react'\nimport { cn } from '@/lib/utils'\n\nconst Input = React.forwardRef<HTMLInputElement, React.ComponentProps<'input'>>(\n    ({ className, type, ...props }, ref) => (\n        <input\n            ref={ref}\n            type={type}\n            data-slot='input'\n            className={cn(\n                'border-input bg-background placeholder:text-muted-foreground flex h-9 w-full rounded-md border px-3 py-1 text-sm shadow-xs transition-colors outline-none',\n                'focus-visible:border-ring focus-visible:ring-ring/50 focus-visible:ring-[3px]',\n                'disabled:pointer-events-none disabled:cursor-not-allowed disabled:opacity-50',\n                'aria-invalid:border-destructive aria-invalid:ring-destructive/20',\n                className\n            )}\n            {...props}\n        />\n    )\n)\nInput.displayName = 'Input'\n\nexport { Input }\n13-import { DesktopClient, type ShellSnapshot } from '@prisma-airs/desktop-contracts'\n14-import { App } from '../../app'\n15-import { ACADEMY_ORIGIN, ACCOUNT, GUEST, academySnapshot, scriptedNative as academyNative } from '../../modules/academy/test-support'\n16-import { scriptedNative } from '../../test/native'\n17-import { fxSwitcher } from '../fixtures'\n18-import { resetShellStore } from '../store'\n19-import tokensCss from '../../styles/tokens.css?raw'\n20:import { Academy, PATHS_LIST_KEY, themeFor } from './academy'\n21-\n22-beforeEach(() => {\n23-    resetShellStore()\n24-    window.scrollTo = vi.fn() as never\n25-    // The WebView has matchMedia; jsdom does not (the lab runner reads the desktop-width layout).\n26-    window.matchMedia = vi.fn().mockReturnValue({ matches: true, addEventListener: vi.fn(), removeEventListener: vi.fn() }) as never\n27-})\n--\n466-        expect(submits).toBe(2)\n467-        const ids = native.calls.filter((i) => i.procedure === 'desktop.attempt.submit').map((i) => (JSON.parse(i.input ?? '{}') as { json: { submissionId: string } }).json.submissionId)\n468-        expect(new Set(ids).size).toBe(1)\n469-        expect(document.querySelector('[data-slot=\"academy-v2\"]')).toBe(mounted)\n470-    }, 30000)\n471-\n472-    it('maps the Rust-owned appearance to the learner host’s theme', () => {\n473:        expect(themeFor('dark')).toBe('gruvbox')\n474:        expect(themeFor('light')).toBe('paper')\n475:        expect(['gruvbox', 'paper']).toContain(themeFor('system'))\n476-    })\n477-\n478-    it('keeps the accent focus ring on its section links, current or not: the shell\\'s ink-on-accent ring is scoped to the accent-filled sidebar destination (attempt-05 R1)', async () => {\n479-        const css: string = tokensCss\n480-        // The override names the sidebar destination (data-inset-focus) and never a bare aria-current='page'.\n481:        expect(css).toMatch(/\\[data-desktop-theme\\] \\[data-inset-focus\\]\\[aria-current='page'\\]:focus-visible \\{\\s*outline-color: var\\(--v2-sel-ink\\);/)\n482:        expect(css).not.toMatch(/\\[data-desktop-theme\\] \\[aria-current='page'\\]:focus-visible/)\n483-        const native = academyNative((procedure) => (procedure === 'paths.list' ? [PATH] : procedure === 'library.list' ? [] : undefined))\n484-        render(<Academy snapshot={academySnapshot(true, ACCOUNT)} client={native.client} onNavigate={vi.fn()} />)\n485-        const place = await screen.findByRole('region', { name: 'Your place' })\n486-        const nav = within(place).getByRole('navigation', { name: 'Academy sections' })\n487-        const current = within(nav).getAllByRole('link').find((l) => l.getAttribute('aria-current') === 'page')\n488-        expect(current).toBeDefined()\n489-        // A current section link is an accent-soft link, not an accent-filled destination: no inset-focus marker on any of them.\n490-        for (const link of within(nav).getAllByRole('link')) expect(link).not.toHaveAttribute('data-inset-focus')\n491-    })\n492-\n493:    it('mounts in the v2 shell for the Academy destination (the shell hands the Rust-owned appearance to the learner host through themeFor)', async () => {\n494-        const base = fxSwitcher()\n495-        const snapshot: ShellSnapshot = {\n496-            ...base,\n497-            activeFeature: 'academy',\n498-            learner: GUEST,\n499-            academyOrigin: ACADEMY_ORIGIN,\n500-            academy: { state: 'signedOut' },\n//! The environment contract for controller commands.\n//!\n//! Every command starts from a cleared environment. Only the preserved\n//! identity variables, an explicit PATH of selected tool directories and the\n//! declared nonsecret build values are set. Inherited variables that could\n//! silently change compilation are refused outright, `.env` files fail the\n//! run, and the resolved tool identities (version output and executable\n//! hash) are recorded as dependency inputs.\n\nuse std::collections::BTreeMap;\nuse std::path::{Path, PathBuf};\nuse std::process::Command;\n\nuse serde::{Deserialize, Serialize};\n\nuse crate::{Repo, Result, invalid, io_err, read_json, sha256_hex};\n\n#[derive(Clone, Debug, Deserialize)]\n#[serde(deny_unknown_fields)]\nstruct ToolchainManifest {\n    schema_version: u32,\n    #[allow(dead_code)]\n    description: String,\n    path_dirs: Vec<String>,\n    tools: Vec<ToolSpec>,\n    declared_env: BTreeMap<String, String>,\n    preserve_unchanged: Vec<String>,\n    reject_inherited: Vec<String>,\n    reject_inherited_prefixes: Vec<String>,\n}\n\n#[derive(Clone, Debug, Deserialize)]\n#[serde(deny_unknown_fields)]\nstruct ToolSpec {\n    name: String,\n    argv: Vec<String>,\n    expect_prefix: String,\n}\n\n/// A resolved build tool.\n#[derive(Clone, Debug, PartialEq, Eq, Serialize, Deserialize)]\npub struct ToolIdentity {\n    pub name: String,\n    pub path: String,\n    pub version: String,\n    pub sha256: String,\n}\n\n/// The concrete environment commands run under.\n#[derive(Clone, Debug)]\npub struct Environment {\n    vars: BTreeMap<String, String>,\n    path_dirs: Vec<PathBuf>,\n    pub tools: Vec<ToolIdentity>,\n}\n\nimpl Environment {\n    /// Resolves the toolchain and verifies tool versions.\n    pub fn prepare(repo: &Repo) -> Result<Self> {\n        let spec: ToolchainManifest = read_json(&repo.toolchain_manifest())?;\n        if spec.schema_version != 1 {\n            return Err(invalid(\"unsupported toolchain.json schema_version\"));\n        }\n        refuse_inherited(&spec)?;\n        refuse_env_files(repo)?;\n        let home = std::env::var(\"HOME\").map_err(|_| invalid(\"HOME must be set\"))?;\n        let path_dirs: Vec<PathBuf> = spec\n            .path_dirs\n            .iter()\n            .map(|dir| expand(dir, &home, repo.root()))\n            .collect();\n        let mut vars = BTreeMap::new();\n        for name in &spec.preserve_unchanged {\n            if let Ok(value) = std::env::var(name) {\n                vars.insert(name.clone(), value);\n            }\n        }\n        for (name, value) in &spec.declared_env {\n            if vars.contains_key(name) {\n                return Err(invalid(format!(\"{name} is both preserved and declared\")));\n            }\n            vars.insert(name.clone(), value.clone());\n        }\n        let joined = path_dirs\n            .iter()\n            .map(|p| p.display().to_string())\n            .collect::<Vec<_>>()\n            .join(\":\");\n        vars.insert(\"PATH\".to_owned(), joined);\n        let mut env = Self {\n            vars,\n            path_dirs,\n            tools: Vec::new(),\n        };\n        for tool in &spec.tools {\n            env.tools.push(env.identify(tool, repo.root())?);\n        }\n        // rustc/cargo in PATH are rustup shims; also bind the selected\n        // toolchain's actual executables.\n        for name in [\"rustc\", \"cargo\"] {\n            let argv = vec![\"rustup\".to_owned(), \"which\".to_owned(), name.to_owned()];\n            let output = env\n                .command(&argv, repo.root())?\n                .output()\n                .map_err(io_err(repo.root()))?;\n            let path = PathBuf::from(String::from_utf8_lossy(&output.stdout).trim());\n            if !output.status.success() || !path.is_file() {\n                return Err(invalid(format!(\n                    \"rustup cannot resolve the selected {name}\"\n                )));\n            }\n            let bytes = std::fs::read(&path).map_err(io_err(&path))?;\n            env.tools.push(ToolIdentity {\n                name: format!(\"{name}-toolchain\"),\n                path: path.display().to_string(),\n                version: String::new(),\n                sha256: sha256_hex(&bytes),\n            });\n        }\n        Ok(env)\n    }\n\n    fn identify(&self, tool: &ToolSpec, cwd: &Path) -> Result<ToolIdentity> {\n        let program = self.resolve(&tool.argv[0])?;\n        let output = self\n            .command(&tool.argv, cwd)?\n            .output()\n            .map_err(io_err(&program))?;\n        let version = String::from_utf8_lossy(&output.stdout).trim().to_owned();\n        if !output.status.success() || !version.starts_with(&tool.expect_prefix) {\n            return Err(invalid(format!(\n                \"{} reports {version:?}; expected prefix {:?}\",\n                tool.name, tool.expect_prefix\n            )));\n        }\n        let bytes = std::fs::read(&program).map_err(io_err(&program))?;\n        Ok(ToolIdentity {\n            name: tool.name.clone(),\n            path: program.display().to_string(),\n            version,\n            sha256: sha256_hex(&bytes),\n        })\n    }\n\n    /// Finds a program in the selected PATH (never the caller's PATH).\n    pub fn resolve(&self, program: &str) -> Result<PathBuf> {\n        if program.contains('/') {\n            return Err(invalid(format!(\"program must be a bare name: {program}\")));\n        }\n        self.path_dirs\n            .iter()\n            .map(|dir| dir.join(program))\n            .find(|candidate| candidate.is_file())\n            .ok_or_else(|| {\n                invalid(format!(\n                    \"{program} not found in the selected toolchain PATH\"\n                ))\n            })\n    }\n\n    /// Builds a process for an argv under this environment.\n    pub fn command(&self, argv: &[String], cwd: &Path) -> Result<Command> {\n        let program = argv\n            .first()\n            .ok_or_else(|| invalid(\"empty argv\"))\n            .and_then(|p| self.resolve(p))?;\n        let mut command = Command::new(program);\n        command.args(&argv[1..]).current_dir(cwd).env_clear();\n        for (name, value) in &self.vars {\n            command.env(name, value);\n        }\n        Ok(command)\n    }\n\n    /// Adds a declared value for specific commands (never secrets).\n    pub fn with(mut self, name: &str, value: &str) -> Self {\n        self.vars.insert(name.to_owned(), value.to_owned());\n        self\n    }\n\n    /// Nonsecret effective variables recorded with each run. Identity values\n    /// (HOME/USER/LOGNAME) are recorded by name only.\n    pub fn recorded_vars(&self) -> BTreeMap<String, String> {\n        self.vars\n            .iter()\n            .map(|(name, value)| {\n                let shown = if matches!(name.as_str(), \"HOME\" | \"USER\" | \"LOGNAME\" | \"TMPDIR\") {\n                    \"<preserved>\".to_owned()\n                } else {\n                    value.clone()\n                };\n                (name.clone(), shown)\n            })\n            .collect()\n    }\n\n    /// Hash of the toolchain identities, part of the dependency fingerprint.\n    pub fn toolchain_hash(&self) -> String {\n        let text = self\n            .tools\n            .iter()\n            .map(|t| format!(\"{}\\0{}\\0{}\\n\", t.name, t.version, t.sha256))\n            .collect::<String>();\n        sha256_hex(text.as_bytes())\n    }\n}\n\nfn expand(dir: &str, home: &str, repo: &Path) -> PathBuf {\n    if let Some(rest) = dir.strip_prefix(\"$HOME\") {\n        PathBuf::from(format!(\"{home}{rest}\"))\n    } else if let Some(rest) = dir.strip_prefix(\"{repo}\") {\n        PathBuf::from(format!(\"{}{rest}\", repo.display()))\n    } else {\n        PathBuf::from(dir)\n    }\n}\n\nfn refuse_inherited(spec: &ToolchainManifest) -> Result<()> {\n    // A variable already equal to its declared value (for example inside a\n    // nested controller command) is not an override.\n    let mut offending: Vec<String> = std::env::vars_os()\n        .filter_map(|(name, value)| Some((name.into_string().ok()?, value.into_string().ok())))\n        .filter(|(name, value)| spec.declared_env.get(name).map(String::as_str) != value.as_deref())\n        .map(|(name, _)| name)\n        .filter(|name| {\n            spec.reject_inherited.contains(name)\n                || spec\n                    .reject_inherited_prefixes\n                    .iter()\n                    .any(|prefix| name.starts_with(prefix.as_str()))\n        })\n        .collect();\n    offending.sort();\n    if offending.is_empty() {\n        Ok(())\n    } else {\n        Err(invalid(format!(\n            \"refusing undeclared inherited overrides: {}\",\n            offending.join(\", \")\n        )))\n","exit_code":0,"status":"completed"}}
