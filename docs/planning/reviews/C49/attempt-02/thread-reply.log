{"type":"item.completed","item":{"id":"item_59","type":"command_execution","command":"/bin/zsh -lc 'cat crates/xtask/examples/p11_native_candidate.rs; cat docs/planning/evidence/P11/native-build-05-vm/source-alias.json; cat docs/planning/evidence/P11/helper-parser-followup-01/change.json'","aggregated_output":"//! Versioned P11 fixture preparation; never overwrites sealed preparation.\nuse sha2::{Digest, Sha256};\nuse std::{\n    fs,\n    io::Write,\n    path::Path,\n    time::{SystemTime, UNIX_EPOCH},\n};\nuse xtask::{Repo, env::Environment, manifest::Manifest, native};\n\ntype Result<T> = std::result::Result<T, Box<dyn std::error::Error>>;\n\nfn reserve(repo: &Repo, args: &[String]) -> Result<fs::File> {\n    let name = args.get(1).map(String::as_str).unwrap_or(\"\");\n    let attempt = name\n        .strip_prefix(\"docs/planning/evidence/P11/native-build-\")\n        .and_then(|s| s.strip_suffix(\"-vm/native-prepare.json\"))\n        .and_then(|s| s.parse::<u32>().ok());\n    if args.len() != 2\n        || args[0] != \"--out\"\n        || !attempt.is_some_and(|n| {\n            n >= 5\n                && name\n                    == format!(\n                        \"docs/planning/evidence/P11/native-build-{n:02}-vm/native-prepare.json\"\n                    )\n        })\n    {\n        return Err(\"expected --out docs/planning/evidence/P11/native-build-NN-vm/native-prepare.json (NN>=05)\".into());\n    }\n    if repo.root().canonicalize()? != repo.root() {\n        return Err(\"repository parents must not be symlinks\".into());\n    }\n    let mut parent = repo.root().to_path_buf();\n    for part in Path::new(name)\n        .parent()\n        .ok_or(\"missing output parent\")?\n        .components()\n    {\n        parent.push(part);\n        match fs::symlink_metadata(&parent) {\n            Ok(m) if m.is_dir() && !m.file_type().is_symlink() => {}\n            Err(e) if e.kind() == std::io::ErrorKind::NotFound => fs::create_dir(&parent)?,\n            _ => return Err(\"output parents must be real directories\".into()),\n        }\n    }\n    Ok(fs::OpenOptions::new()\n        .write(true)\n        .create_new(true)\n        .open(repo.join(name))?)\n}\n\nfn main() -> Result<()> {\n    let repo = Repo::discover();\n    // Reserve before environment probes, extraction or either build command.\n    // A failed build leaves this incomplete attempt reserved for inspection.\n    let mut output = reserve(&repo, &std::env::args().skip(1).collect::<Vec<_>>())?;\n    let manifest = Manifest::load(&repo.manifest())?;\n    let target = \"aarch64-apple-darwin\";\n    let features = vec![\"test-fixtures\".to_owned()];\n    if manifest.target != target || manifest.fixture_only_features != features {\n        return Err(\"P11 requires the fixed ARM64 fixture recipe\".into());\n    }\n    let env = Environment::prepare(&repo)?;\n    xtask::harness::unpack(&repo)?;\n    let commands: Vec<Vec<String>> = native::build_commands(target)\n        .iter()\n        .map(|argv| argv.iter().map(|s| (*s).to_owned()).collect())\n        .collect();\n    for argv in &commands {\n        if !env.command(argv, repo.root())?.status()?.success() {\n            return Err(format!(\"fixture build failed: {}\", argv.join(\" \")).into());\n        }\n    }\n    let bundle = native::bundle_path(&repo, target, \"Prisma AIRS Desktop Fixture\");\n    let identifier = native::plist_value(&bundle, \"CFBundleIdentifier\")?;\n    if identifier != native::FIXTURE_IDENTIFIER {\n        return Err(format!(\"unexpected fixture identifier: {identifier}\").into());\n    }\n    let prepared = native::Prepared {\n        subject: \"P11\".to_owned(),\n        built_utc: desktop_core::sessions::rfc3339(\n            SystemTime::now().duration_since(UNIX_EPOCH)?.as_secs(),\n        ),\n        bundle: bundle.strip_prefix(repo.root())?.display().to_string(),\n        identifier,\n        executable_sha256: hex::encode(Sha256::digest(fs::read(\n            bundle.join(\"Contents/MacOS/prisma-airs-desktop\"),\n        )?)),\n        bundle_sha256: xtask::fingerprint::tree_hash(&bundle)?,\n        features,\n        target: target.to_owned(),\n        commands,\n    };\n    serde_json::to_writer_pretty(&mut output, &prepared)?;\n    output.write_all(b\"\\n\")?;\n    output.sync_all()?;\n    Ok(())\n}\n\n#[cfg(test)]\nmod tests {\n    use super::*;\n\n    #[test]\n    fn invalid_paths_collisions_and_symlink_parents_refuse_before_build() -> Result<()> {\n        let base = std::env::temp_dir().join(format!(\n            \"airs-p11-reserve-{}-{}\",\n            std::process::id(),\n            SystemTime::now().duration_since(UNIX_EPOCH)?.as_nanos()\n        ));\n        fs::create_dir(&base)?;\n        let repo = Repo::new(base.canonicalize()?);\n        for value in [\n            \"docs/planning/evidence/P11/native-prepare.json\",\n            \"docs/planning/evidence/P11/native-build-04-vm/native-prepare.json\",\n            \"docs/planning/evidence/P11/native-build-5-vm/native-prepare.json\",\n            \"docs/planning/evidence/P11/native-build-0005-vm/native-prepare.json\",\n            \"docs/planning/evidence/P11/../P11/native-build-05-vm/native-prepare.json\",\n            \"/docs/planning/evidence/P11/native-build-05-vm/native-prepare.json\",\n        ] {\n            assert!(reserve(&repo, &[\"--out\".into(), value.into()]).is_err());\n        }\n        assert!(reserve(&repo, &[]).is_err());\n        assert!(reserve(&repo, &[\"--out\".into()]).is_err());\n        assert!(reserve(&repo, &[\"--wrong\".into(), \"x\".into()]).is_err());\n        assert!(!repo.join(\"docs\").exists());\n        let value = \"docs/planning/evidence/P11/native-build-05-vm/native-prepare.json\";\n        let args = vec![\"--out\".to_owned(), value.to_owned()];\n        reserve(&repo, &args)?.write_all(b\"owned-sentinel\")?;\n        assert!(reserve(&repo, &args).is_err());\n        assert_eq!(fs::read(repo.join(value))?, b\"owned-sentinel\");\n        drop(reserve(\n            &repo,\n            &[\"--out\".into(), value.replace(\"05-vm\", \"06-vm\")],\n        )?);\n        fs::remove_dir_all(repo.join(\"docs\"))?;\n        fs::create_dir(repo.join(\"outside\"))?;\n        std::os::unix::fs::symlink(repo.join(\"outside\"), repo.join(\"docs\"))?;\n        assert!(reserve(&repo, &args).is_err());\n        assert_eq!(fs::read_dir(repo.join(\"outside\"))?.count(), 0);\n        fs::remove_dir_all(&base)?;\n        Ok(())\n    }\n}\n{\n  \"schema\": \"airs-desktop/producer-source-alias/1\",\n  \"receipt\": {\n    \"path\": \"docs/planning/evidence/P11/native-build-05-vm/receipt.json\",\n    \"sha256\": \"aa8bb0a1669075e3841e5d761b99cbcbb7e30be012d358da593789aeb2404007\"\n  },\n  \"original_source\": {\n    \"path\": \".evidence-private/native-build-05-vm/run.py\",\n    \"sha256\": \"98609b764f360dcf66792a61cc6d146fd3c8251f67e8ee7a9b843febff1a2bc9\"\n  },\n  \"public_source\": {\n    \"path\": \"docs/planning/evidence/P11/native-build-05-vm/producer.py\",\n    \"sha256\": \"98609b764f360dcf66792a61cc6d146fd3c8251f67e8ee7a9b843febff1a2bc9\"\n  },\n  \"meaning\": \"Byte-identical executed producer source; original receipt and argv remain unchanged.\"\n}\n{\n  \"schema\": \"airs-desktop/p11-helper-parser-followup/1\",\n  \"original_qa\": {\n    \"path\": \"docs/planning/evidence/P11/helper-qa-remediation-01/record.json\",\n    \"sha256\": \"ab9ae81f5112349883dee94fb4bbd6bc27200508adde115b9f55bcd5c0329345\"\n  },\n  \"reason\": \"The actual recovery probe records additional observations. Require every mandatory fact and every actual recorded value true, while preserving extra passing facts. No application/native/helper driver or behavior changed. Only this adversarial guard is rerun; original81 remains at its actual source.\",\n  \"changed_files\": {\n    \"remediation.py\": {\n      \"original\": {\n        \"path\": \"docs/planning/evidence/P11/helper-parser-followup-01/original/remediation.py\",\n        \"sha256\": \"d7e2a87a70a5947de7aea4bce33ae1ee46184abe725bf7da83f8dec48c27918a\"\n      },\n      \"current_path\": \"tools/p11/remediation.py\",\n      \"current_sha256\": \"395efcbce6da0fa9262d1f7af7db52bccf416d4793acb65d11f61baa2cf8036b\"\n    },\n    \"test_remediation.py\": {\n      \"original\": {\n        \"path\": \"docs/planning/evidence/P11/helper-parser-followup-01/original/test_remediation.py\",\n        \"sha256\": \"f2ae2dcb814fdcf64687b8a3657fce7d2f8e7bf826f56265f786290722b71e78\"\n      },\n      \"current_path\": \"tools/p11/test_remediation.py\",\n      \"current_sha256\": \"20a791d080b46f21d2313c3640ccde3580cf03fec5500f37301972883866e197\"\n    }\n  }\n}\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_60","type":"command_execution","command":"/bin/zsh -lc \"sed -n '1,100p' apps/desktop/src/shell/feature-view.tsx; sed -n '130,185p' apps/desktop/src/v2/settings/management-credential.test.tsx; rg -n 'source_tests|source_requirements|C49|SOURCE_REQUIREMENTS' tools/native-acceptance/acceptance_p11.py\"","aggregated_output":"import { forwardRef, useId, useState } from 'react'\nimport { Callout } from '@ai-security-academy/presentation'\nimport { Info } from 'lucide-react'\nimport type { FeatureEntry, ShellSnapshot, Theme } from '@prisma-airs/desktop-contracts'\nimport { type Dispatch, outcomeMessage } from '../modules/tenants/dispatch'\nimport { DiagnosticsPanel } from '../modules/diagnostics/diagnostics-panel'\nimport { AcademyAccount } from '../modules/academy/academy-account'\nimport { TenantsSettings } from '../modules/tenants/tenants-settings'\nimport type { ObserveManagement } from '../modules/administration/management-read'\nimport { PageIntro } from '../v2/page-intro'\nimport { SetupWarningHistory } from '../v2/setup-warning-history'\n\ninterface HeadingProps {\n    id: string\n    kicker: string\n    title: string\n}\n\n/** Page heading that receives focus after navigation (tabIndex -1). */\nexport const PageHeading = forwardRef<HTMLHeadingElement, HeadingProps>(function PageHeading({ id, title }, ref) {\n    return (\n        <header className='mb-4 flex flex-col gap-1' data-slot='page-header'>\n            <h1 ref={ref} id={id} tabIndex={-1} data-slot='page-heading' className='font-bold outline-none' style={{ fontSize: 'var(--v2-title)' }}>\n                {title}\n            </h1>\n        </header>\n    )\n})\n\nexport const UnavailableView = forwardRef<HTMLHeadingElement, { feature: FeatureEntry }>(function UnavailableView({ feature }) {\n    const planned = feature.availability.state === 'unavailable' ? feature.availability.plannedChunk : ''\n    return (\n        <section aria-label={feature.label} data-slot='feature-unavailable'>\n            <Callout tone='default' icon={Info}>\n                <p>\n                    {feature.label} is not available in this build. Nothing here contacts a Prisma AIRS\n                    tenant or the Academy.\n                </p>\n                <p className='text-academy-ink-faint mt-2 font-mono text-[11px] tracking-[0.12em] uppercase'>\n                    Planned in {planned}\n                </p>\n            </Callout>\n        </section>\n    )\n})\n\ninterface SettingsProps {\n    snapshot: ShellSnapshot\n    pending: boolean\n    onSetAppearance: (theme: Theme) => void\n    dispatch: Dispatch\n    observeManagement: ObserveManagement\n}\n\nexport const SettingsView = forwardRef<HTMLHeadingElement, SettingsProps>(function SettingsView(\n    { snapshot, pending, onSetAppearance, dispatch, observeManagement }\n) {\n    const legend = useId()\n    const [themeBusy, setThemeBusy] = useState(false)\n    const [message, setMessage] = useState<string | null>(null)\n    async function setColorTheme(theme: ShellSnapshot['colorTheme']) {\n        setThemeBusy(true)\n        setMessage(null)\n        const outcome = await dispatch({ kind: 'setColorTheme', theme })\n        setThemeBusy(false)\n        setMessage(outcomeMessage(outcome))\n    }\n    return (\n        <section aria-label='Settings' data-slot='settings' className='flex flex-col gap-4'>\n            <PageIntro description='Personalize the desktop, manage tenant connections and review local diagnostics.' />\n            <div className='settings-grid'>\n                <fieldset aria-labelledby={legend} aria-busy={pending || themeBusy} className='settings-card'>\n                    <legend id={legend}>Appearance</legend>\n                    <p className='settings-description'>Desktop preferences do not change your Academy account settings.</p>\n                    <div className='settings-fields'>\n                        <label className='settings-field'>\n                            Appearance\n                            <select aria-label='Appearance' value={snapshot.appearance} disabled={pending} onChange={(e) => onSetAppearance(e.target.value as Theme)}>\n                                <option value='system'>Match system</option>\n                                <option value='light'>Light</option>\n                                <option value='dark'>Dark</option>\n                            </select>\n                        </label>\n                        <label className='settings-field'>\n                            Theme\n                            <select aria-label='Theme' value={snapshot.colorTheme} disabled={themeBusy} onChange={(e) => void setColorTheme(e.target.value as ShellSnapshot['colorTheme'])}>\n                                <option value='prismaAirs'>Prisma AIRS</option>\n                                <option value='gruvbox'>Gruvbox</option>\n                            </select>\n                        </label>\n                    </div>\n                    {message && <p role='alert'>{message}</p>}\n                </fieldset>\n                <AcademyAccount view={snapshot.academy} dispatch={dispatch} />\n                <DiagnosticsPanel view={snapshot.diagnostics} dispatch={dispatch}>\n                    <SetupWarningHistory warnings={snapshot.tenants.find((t) => t.id === snapshot.active?.tenant)?.setupWarnings ?? []} />\n                </DiagnosticsPanel>\n            </div>\n            <TenantsSettings snapshot={snapshot} dispatch={dispatch} observeManagement={observeManagement} />\n        </section>\n50:    return {row['id']: row['check'] for chunk in ('C46', 'C47', 'C48', 'C49') for row in chunks[chunk]}\n318:        declaration = next((node.value for node in tree.body if isinstance(node, ast.Assign) and any(isinstance(t, ast.Name) and t.id == 'SOURCE_REQUIREMENTS' for t in node.targets)), None)\n326:    return {'path': str(path), 'sha256': sha(path), 'inputs': value['inputs_after'], 'source_requirements': declared}\n","exit_code":0,"status":"completed"}}
