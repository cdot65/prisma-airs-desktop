ps/desktop/src-tauri/capabilities/main.json\": {\n      \"original_sha256\": \"444a0f7989825380a5d40a4a2bd378bcb6522a94d3e0c7d8ac02bc74a770472d\",\n      \"current_sha256\": \"444a0f7989825380a5d40a4a2bd378bcb6522a94d3e0c7d8ac02bc74a770472d\",\n      \"original_file\": {\n        \"path\": \"docs/planning/evidence/P11/source-history/S3/apps/desktop/src-tauri/capabilities/main.json\",\n        \"sha256\": \"444a0f7989825380a5d40a4a2bd378bcb6522a94d3e0c7d8ac02bc74a770472d\"\n      }\n    },\n    \"apps/desktop/src-tauri/icons/128x128.png\": {\n      \"original_sha256\": \"85f9daf4ad8eef92df8d9884fb1f21e2018a0136198842c6d9ee93c2caa4fee6\",\n      \"current_sha256\": \"85f9daf4ad8eef92df8d9884fb1f21e2018a0136198842c6d9ee93c2caa4fee6\",\n      \"original_file\": {\n        \"path\": \"docs/planning/evidence/P11/source-history/S3/apps/desktop/src-tauri/icons/128x128.png\",\n        \"sha256\": \"85f9daf4ad8eef92df8d9884fb1f21e2018a0136198842c6d9ee93c2caa4fee6\"\n      }\n    },\n    \"apps/desktop/\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_25","type":"command_execution","command":"/bin/zsh -lc \"sed -n '150,340p' tools/native-acceptance/acceptance_p11_settings.py; cat tools/native-acceptance/acceptance_p11_credentials.py; cat tools/native-acceptance/acceptance_p11_keyboard.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_25","type":"command_execution","command":"/bin/zsh -lc \"sed -n '150,340p' tools/native-acceptance/acceptance_p11_settings.py; cat tools/native-acceptance/acceptance_p11_credentials.py; cat tools/native-acceptance/acceptance_p11_keyboard.py\"","aggregated_output":"    # The alternate theme and explicit appearance must survive a real restart.\n    old_pid = ctx.app.pid\n    ctx.app.quit()\n    ctx.app.launch()\n    _settings(ctx)\n    persisted = _value(ctx, \"AXPopUpButton\", \"Theme\") == \"Gruvbox\" and _value(ctx, \"AXPopUpButton\", \"Appearance\") == \"Dark\"\n    ctx.require(persisted and ctx.app.pid != old_pid, \"C49 palette/appearance did not survive restart\")\n    evidence.append(ctx.save(\"c49-persisted-alternate-theme\"))\n    ctx.navigate(\"Home\")\n    captures.append(ctx.capture(\"c49-product-gruvbox-dark\"))\n\n    portal_observed, desktop_portals, academy_inputs = [], [], []\n    for theme in (\"Prisma AIRS\", \"Gruvbox\"):\n        _settings(ctx)\n        _select(ctx, \"Theme\", [\"Prisma AIRS\", \"Gruvbox\"], theme)\n        # Desktop-owned modal must follow the selected desktop palette.\n        ctx.press(\"AXButton\", \"Add tenant…\")\n        tree = ctx.text(\"Add a tenant\")\n        desktop_portals.append(ctx.app.has_text(tree, \"Add a tenant\"))\n        captures.append(ctx.capture(f\"c49-desktop-portal-{theme.lower().replace(' ', '-')}\"))\n        ctx.press(\"AXButton\", \"Cancel\")\n        _resize(ctx, 1100, 800)\n        _zoom(ctx, doubled=True)\n        ctx.navigate(\"Academy\")\n        # Academy owns this ordinary in-page search input too. Capture its\n        # actual focus treatment, not only a portal or static learner text.\n        label = \"Search paths, courses, and labs\"\n        tree, ready = ctx.app.wait_for(lambda t: any(ctx.app.node(t, role, label)\n            for role in (\"AXSearchField\", \"AXTextField\")))\n        ctx.require(ready, \"Academy catalog search input missing\")\n        role = next(role for role in (\"AXSearchField\", \"AXTextField\") if ctx.app.node(tree, role, label))\n        ctx.app.ax(\"focus\", role, label)\n        tree, focused = ctx.app.wait_for(lambda t: (ctx.app.focused(t) or {}).get(\"label\") == label)\n        ctx.require(focused, \"Academy catalog search did not receive focus\")\n        academy_inputs.append(focused)\n        evidence.append(ctx.save(f\"c49-academy-search-focused-{theme.lower().replace(' ', '-')}\", tree))\n        captures.append(ctx.capture(f\"c49-academy-search-focused-{theme.lower().replace(' ', '-')}\"))\n        tree = _academy_reader(ctx)\n        evidence.append(ctx.save(f\"c49-guest-reader-{theme.lower().replace(' ', '-')}\", tree))\n        captures.append(ctx.capture(f\"c49-guest-reader-{theme.lower().replace(' ', '-')}\"))\n        # Academy's narrow reader Modal is a body portal with Academy tokens.\n        ctx.press(\"AXButton\", \"Contents\")\n        tree = ctx.text(\"Course contents\")\n        portal_observed.append(ctx.app.has_text(tree, \"Course contents\"))\n        evidence.append(ctx.save(f\"c49-academy-contents-{theme.lower().replace(' ', '-')}\", tree))\n        captures.append(ctx.capture(f\"c49-academy-contents-{theme.lower().replace(' ', '-')}\"))\n        ctx.press(\"AXButton\", \"Close\")\n        ctx.require(not ctx.app.has_text(ctx.app.tree(), \"Course contents\"), \"Academy contents did not close\")\n        _zoom(ctx)\n    _settings(ctx)\n    _select(ctx, \"Theme\", [\"Prisma AIRS\", \"Gruvbox\"], original_theme)\n    _select(ctx, \"Appearance\", options, original_appearance)\n    ctx.record(\"C49-N02\", {\"four_palette_controls_observed\": len(captures) >= 4,\n        \"alternate_theme_and_appearance_survived_restart\": persisted,\n        \"desktop_add_portal_opened_in_both_themes\": all(desktop_portals) and len(desktop_portals) == 2,\n        \"guest_academy_in_page_search_focus_observed_in_both_desktop_themes\": all(academy_inputs) and len(academy_inputs) == 2,\n        \"guest_academy_reader_and_contents_portal_opened_in_both_themes\": all(portal_observed) and len(portal_observed) == 2},\n        evidence, captures)\n\n\ndef _tenant_controls(ctx, bootstrap):\n    evidence, captures = [], []\n    _settings(ctx)\n    selected_before = _value(ctx, \"AXPopUpButton\", \"Tenant to update\")\n    ctx.require(selected_before == bootstrap + \" (active)\", \"C49 must begin on its owned bootstrap tenant\")\n    client_before = _value(ctx, \"AXTextField\", \"Client ID\")\n    # Keep the management client intact: later C46 warning flows use it.\n    _node(ctx, \"AXButton\", \"Replace client\")\n    _node(ctx, \"AXButton\", \"Remove management client\")\n    storage_choices = []\n    for nth in (0, 1):  # Scan and management cards expose both storage choices.\n        tree = _radio(ctx, \"For this session only\", nth)\n        storage_choices.append((ctx.app.node(tree, \"AXRadioButton\", \"For this session only\", nth) or {}).get(\"value\") in (1, \"1\"))\n        tree = _radio(ctx, \"In secure storage\", nth)\n        storage_choices.append((ctx.app.node(tree, \"AXRadioButton\", \"In secure storage\", nth) or {}).get(\"value\") in (1, \"1\"))\n    ctx.app.type_into(\"AXTextField\", \"Client secret\", \"synthetic-c49-unsaved-secret\", secure=True)\n    ctx.navigate(\"Home\")\n    _settings(ctx)\n    cleared_on_leave = _value(ctx, \"AXTextField\", \"Client secret\") == \"\"\n    ctx.require(cleared_on_leave, \"unsaved management secret survived leaving Settings\")\n\n    # Actual credential writes are confined to the fixture vault/session. No scan\n    # or product request is made. Remove the key again before restoring Home.\n    _radio(ctx, \"For this session only\", 0)\n    for index, button in enumerate((\"Save key\", \"Replace key\"), start=1):\n        ctx.app.type_into(\"AXTextField\", \"AIRS API key\", f\"synthetic-c49-session-key-{index}\", secure=True)\n        ctx.press(\"AXButton\", button)\n        tree = ctx.text(\"Scan key held for this session only.\")\n        ctx.require(_value(ctx, \"AXTextField\", \"AIRS API key\") == \"\", \"submitted scan secret remained visible\")\n        evidence.append(ctx.save(f\"c49-session-key-{index}\", tree))\n    ctx.press(\"AXButton\", \"Remove scan key\")\n    tree = ctx.text(\"No scan key.\")\n    evidence.append(ctx.save(\"c49-session-key-removed\", tree))\n\n    ctx.press(\"AXButton\", \"Change destination…\")\n    _radio(ctx, \"Custom HTTPS endpoint\")\n    custom_destination = _node(ctx, \"AXTextField\", \"Endpoint origin\") is not None\n    tree = ctx.text(\"HTTPS only, with no path, query or credentials.\")\n    evidence.append(ctx.save(\"c49-custom-destination-review-surface\", tree))\n    captures.append(ctx.capture(\"c49-custom-destination-card\"))\n    ctx.press(\"AXButton\", \"Cancel\")\n\n    ctx.press(\"AXButton\", \"Edit\")\n    original_environment = _value(ctx, \"AXPopUpButton\", \"Environment\")\n    tree = ctx.app.tree()\n    metadata_only = ctx.app.node(tree, \"AXTextField\", \"TSG ID\") is None and ctx.app.node(tree, \"AXTextField\", \"Endpoint origin\") is None\n    ctx.require(metadata_only, \"metadata editor unexpectedly exposes tenant identity/destination\")\n    _replace_text(ctx, \"Display name\", bootstrap + \" Edited\")\n    _select(ctx, \"Environment\", [\"Production\", \"Staging\", \"Other\"], \"Staging\" if original_environment != \"Staging\" else \"Other\")\n    ctx.press(\"AXButton\", \"Save changes\")\n    ctx.text(bootstrap + \" Edited\")\n    evidence.append(ctx.save(\"c49-metadata-edited\"))\n    ctx.press(\"AXButton\", \"Edit\")\n    _replace_text(ctx, \"Display name\", bootstrap)\n    _select(ctx, \"Environment\", [\"Production\", \"Staging\", \"Other\"], original_environment)\n    ctx.press(\"AXButton\", \"Save changes\")\n    ctx.text(bootstrap + \" (active)\")\n    ctx.press(\"AXButton\", \"Delete\")\n    tree = ctx.app.tree()\n    bound_delete = ctx.app.node(tree, \"AXButton\", f\"Confirm deleting {bootstrap} and its credentials\") is not None\n    ctx.require(bound_delete, \"Delete confirmation did not name the selected tenant\")\n    evidence.append(ctx.save(\"c49-delete-target-confirmation\", tree))\n    ctx.press(\"AXButton\", \"Cancel\")\n\n    ctx.press(\"AXButton\", \"Add tenant…\")\n    tree = ctx.text(\"Add a tenant\")\n    region_only = ctx.app.node(tree, \"AXRadioButton\", \"Custom HTTPS endpoint\") is None and ctx.app.node(tree, \"AXPopUpButton\", \"Region\") is not None\n    _replace_text(ctx, \"Display name\", \"P11 Cancelled Draft\")\n    _replace_text(ctx, \"TSG ID\", \"1234567899\")\n    ctx.press(\"AXButton\", \"Draft tenant\")\n    tree = ctx.text(\"P11 Cancelled Draft is drafted.\")\n    blocked = _node(ctx, \"AXButton\", \"Save the management client to continue\", tree).get(\"enabled\") is False\n    ctx.require(region_only and blocked, \"Add must use region-only draft with required management client\")\n    ctx.app.type_into(\"AXTextField\", \"Client secret\", \"synthetic-c49-cancelled-draft-secret\", secure=True)\n    evidence.append(ctx.save(\"c49-add-required-oauth-draft\"))\n    captures.append(ctx.capture(\"c49-add-required-oauth-draft\"))\n    ctx.press(\"AXButton\", \"Cancel\")\n    tree, cancelled = ctx.app.wait_for(lambda t: ctx.app.node(t, \"AXTextField\", \"TSG ID\") is None)\n    ctx.require(cancelled, \"Add draft did not close after cancellation\")\n    selected_after = _value(ctx, \"AXPopUpButton\", \"Tenant to update\")\n    management_retained = _value(ctx, \"AXTextField\", \"Client ID\") == client_before and ctx.app.node(tree, \"AXButton\", \"Remove management client\") is not None\n    restored = selected_after == selected_before\n    ctx.press(\"AXButton\", \"Edit\")\n    restored_environment = _value(ctx, \"AXPopUpButton\", \"Environment\") == original_environment\n    ctx.press(\"AXButton\", \"Cancel\")\n    ctx.require(restored and management_retained, \"C49 did not restore bootstrap profile/management controls\")\n    ctx.record(\"C49-N03\", {\"scan_and_management_secure_session_choices_selectable\": all(storage_choices) and len(storage_choices) == 4,\n        \"scan_session_save_replace_remove_observed\": ctx.app.has_text(tree, \"No scan key.\"),\n        \"unsaved_management_secret_cleared_on_navigation\": cleared_on_leave,\n        \"editor_exposed_metadata_fields_only\": metadata_only,\n        \"selected_profile_label_and_environment_restored\": restored and restored_environment,\n        \"delete_confirmation_named_selected_target_and_was_cancelled\": bound_delete,\n        \"custom_https_controls_retained_in_destination_card\": custom_destination,\n        \"add_offered_region_only\": region_only,\n        \"add_draft_required_management_before_continue_and_cancelled\": blocked and cancelled,\n        \"bootstrap_management_controls_retained\": management_retained}, evidence, captures)\n\n\ndef run(ctx):\n    \"\"\"Observe C49 against the orchestrator's already bootstrapped fixture only.\"\"\"\n    bootstrap = ctx.state[\"bootstrap_tenant\"]\n    tree = _settings(ctx)\n    original_window = _node(ctx, \"AXWindow\", \"\", tree).get(\"size\")\n    original_appearance = _value(ctx, \"AXPopUpButton\", \"Appearance\")\n    original_theme = _value(ctx, \"AXPopUpButton\", \"Theme\")\n    requirements = ctx.save(\"c49-source-boundary-requirements\", SOURCE_REQUIREMENTS)\n    ctx.state[\"c49_source_requirements\"] = SOURCE_REQUIREMENTS\n    cards = (\"Appearance\", \"Academy account\", \"Diagnostics\", \"Tenants\", \"Scan key\", \"Management client\",\n             \"Scan destination\", \"Update Tenant\", \"Add Tenant\")\n    present = all(ctx.app.has_text(tree, card) for card in cards)\n    ctx.require(present, \"C49 Settings cards missing\")\n    captures = [ctx.capture(\"c49-settings-cards-100-percent\")]\n    evidence = [requirements, ctx.save(\"c49-settings-cards\", tree)]\n    _resize(ctx, 1100, 800)\n    _zoom(ctx, doubled=True)\n    keyboard_evidence, keyboard_reached = _keyboard_cards(ctx)\n    evidence.append(keyboard_evidence)\n    captures.append(ctx.capture(\"c49-settings-keyboard-200-percent\"))\n    ctx.record(\"C49-N01\", {\"expected_settings_and_tenant_cards_present\": present,\n        \"independent_appearance_theme_controls_present\": bool(ctx.app.node(tree, \"AXPopUpButton\", \"Appearance\") and ctx.app.node(tree, \"AXPopUpButton\", \"Theme\")),\n        \"changed_card_controls_keyboard_reachable_inside_narrow_window_at_requested_200_percent\": keyboard_reached}, evidence, captures)\n    _zoom(ctx)\n    _themes(ctx, original_appearance, original_theme)\n    _tenant_controls(ctx, bootstrap)\n    _zoom(ctx)\n    if original_window:\n        _resize(ctx, *original_window)\n    ctx.navigate(\"Home\")\n    ctx.text(bootstrap)\n\"\"\"Scoped scan-session precondition for the unfinished C49 credential flow.\"\"\"\nimport acceptance_p11_settings as settings\n\n\ndef run(ctx, bootstrap):\n    # The finish driver removes any leftover fixture scan key before entry.\n    # Credential saves rotate context and remount the form with keychain as\n    # its default, so select session anew before EACH synthetic secret entry.\n    original = ctx.app.type_into\n    submitted = 0\n\n    def type_into(role, label, text, *args, **kwargs):\n        nonlocal submitted\n        if (role, label) == ('AXTextField', 'AIRS API key') and isinstance(text, str) and text.startswith('synthetic-c49-session-key-'):\n            ctx.require(submitted < 2 and text == f'synthetic-c49-session-key-{submitted + 1}',\n                        'unexpected C49 synthetic scan-key sequence')\n            settings._radio(ctx, 'For this session only', 0)  # includes selected-state verification\n            submitted += 1\n            ctx.log.append({'action': 'c49-scan-session-mode-before-input', 'ordinal': submitted})\n        return original(role, label, text, *args, **kwargs)\n\n    ctx.app.type_into = type_into\n    try:\n        result = settings._tenant_controls(ctx, bootstrap)\n        ctx.require(submitted == 2, 'C49 requires both session-key submissions')\n        return result\n    finally:\n        ctx.app.type_into = original\n\"\"\"C47-N01: retain the frozen matrix and measure only its two unfinished API focus paths.\"\"\"\nimport copy\nimport hashlib\nimport json\nfrom pathlib import Path\n\nimport acceptance_c29 as c29\nimport acceptance_p11_shell as shell\nimport acceptance_p11_geometry as geometry\n\nROOT = Path.cwd().resolve()\nFLAGS = ('one_named_header_h1', 'navigation_focus', 'main_inside_window', 'academy_location')\nEXPECTED_FACTS = {\n    'all_destinations_have_one_named_header_h1': True,\n    'navigation_focus_observed': True,\n    'main_frames_measured_inside_window': True,\n    'named_actions_keyboard_reachable': False,\n    'academy_hierarchy_retained': True,\n}\nVIEWS = (('Light', 1440, 820, 0, 100), ('Dark', 900, 600, 10, 200))\n\n\ndef require(value, message):\n    if not value:\n        raise RuntimeError(message)\n\n\ndef sha(path):\n    return hashlib.sha256(Path(path).read_bytes()).hexdigest()\n\n\ndef bound(root, ref):\n    path = (root / ref['path']).resolve()\n    require(path.is_relative_to(root.resolve()) and sha(path) == ref['sha256'],\n            'prior keyboard evidence escapes or changed')\n    return path\n\n\ndef inspect_prior(ctx, prior, root=ROOT):\n    raw_path = bound(root, prior['observations'])\n    matrix_path = bound(root, prior['measurements'])\n    raw = json.loads(raw_path.read_text())\n    require(raw['schema'] == 'airs-desktop/p11-native-observations/1' and raw['subject'] == 'P11'\n            and raw['status'] == 'failed' and raw['exit_code'] == 1 and raw['complete'] is False,\n            'original failed matrix process must remain failed')\n    require(raw['binding']['helper_closure'] == raw['helper_closure']\n            and all(raw[key] == raw['binding'][key] == ctx.prepared[key]\n                    for key in ('executable_sha256', 'bundle_sha256'))\n            and raw['binding']['prepare']['sha256'] == ctx.binding['prepare']['sha256']\n            and raw['binding']['native_inventory_sha256'] == ctx.binding['native_inventory_sha256']\n            and raw['host'] == ctx.binding['conditions']['platform'],\n            'prior matrix candidate, platform or binding changed')\n    for name, digest in raw['helper_closure'].items():\n        file = (root / name).resolve()\n        require(file.is_relative_to(root) and file.is_file()\n                and ctx.closure.get(name) == digest == sha(file), 'prior matrix helper bytes changed')\n    for name, digest in raw['artifact_sha256'].items():\n        artifact = (root / name).resolve()\n        require(artifact.is_relative_to(raw_path.parent) and sha(artifact) == digest,\n                'prior matrix artifact changed')\n    rows = [row for row in raw['checks'] if row['id'] == 'C47-N01']\n    require(len(rows) == 1 and rows[0]['facts'] == EXPECTED_FACTS,\n            'prior N01 had a different failed fact')\n    row = rows[0]\n    relative = str(matrix_path.relative_to(root))\n    require(relative in row['evidence'] and raw['artifact_sha256'].get(relative) == prior['measurements']['sha256'],\n            'matrix is not bound by the original N01')\n    matrix = json.loads(matrix_path.read_text())\n    expected = {(page, theme, zoom) for page in shell.PAGES for theme, _, _, _, zoom in VIEWS}\n    require(len(matrix) == 16 and {(r['page'], r['theme'], r['zoom']) for r in matrix} == expected,\n            'frozen matrix membership changed')\n    for item in matrix:\n        require(all(item.get(flag) is True for flag in FLAGS), 'frozen non-keyboard measurement failed')\n        require(item['requested'] == ([1440, 820] if item['theme'] == 'Light' else [900, 600]),\n                'frozen matrix viewport changed')\n        require(item['named_action_keyboard_visible'] is (item['page'] != 'API Client'),\n                'frozen matrix has an unexpected keyboard result')\n    require(len(row['visual']) == len(set(row['visual'])) == 16\n            and all(name in raw['artifact_sha256'] for name in row['visual']),\n            'original matrix captures missing')\n    return raw, row, matrix\n\n\nclass TraversalFailure(RuntimeError):\n    def __init__(self, reason, record):\n        super().__init__('API keyboard traversal failed: ' + reason)\n        self.record = dict(record, failure=reason)\n\n\ndef focus_key(tree, node):\n    semantic = lambda value: (value.get('role'), value.get('label'), value.get('subrole'), value.get('depth'))\n    peers = [value for value in tree if semantic(value) == semantic(node)]\n    return (*semantic(node), next((i for i, value in enumerate(peers) if value is node), 0))\n\n\ndef traverse(initial, tab, tree_now, focused, frame):\n    \"\"\"One finite measured focus cycle, bounded by the actual AX tree size.\"\"\"\n    collection = [n for n in initial if n.get('role') == 'AXPopUpButton'\n                  and (n.get('label') or '').startswith('Collection ')]\n    require(len(collection) == 1, 'API Collection selector is missing or ambiguous')\n    require(sum(n.get('role') == 'AXPopUpButton' and n.get('label') == 'Environment'\n                for n in initial) == 1, 'API Environment selector is missing or ambiguous')\n    labels = {'collection': ('AXPopUpButton', collection[0]['label']),\n              'environment': ('AXPopUpButton', 'Environment')}\n    limit = 2 * max(1, len(initial))\n    trace, seen, reached = [], set(), {}\n    record = {'initial_ax_elements': len(initial), 'element_bound': limit,\n              'expected_header_selectors': labels, 'trace': trace, 'reached': reached}\n    for step in range(1, limit + 1):\n        tab()\n        tree = tree_now()\n        node = focused(tree)\n        if not node:\n            trace.append({'step': step, 'focused': None})\n            continue\n        key = focus_key(tree, node)\n        if key in seen:\n            raise TraversalFailure('focus_cycle', record)\n        seen.add(key)\n        viewport = frame()\n        inside = bool(node.get('enabled') is not False and node.get('size')\n                      and all(value > 0 for value in node['size']) and c29.inside(viewport, node))\n        entry = {'step': step, 'role': node.get('role'), 'label': node.get('label'),\n                 'pos': node.get('pos'), 'size': node.get('size'), 'window': viewport,\n                 'inside_window': inside}\n        trace.append(entry)\n        pair = (node.get('role'), node.get('label'))\n        goals = [name for name, expected in labels.items() if pair == expected]\n        if pair in (('AXTextField', 'URL'), ('AXButton', 'Send')):\n            goals.append('request_action')\n        for goal in goals:\n            if not inside:\n                raise TraversalFailure('focused_goal_outside_window', record)\n            reached[goal] = dict(entry)\n        if set(reached) == {'collection', 'environment', 'request_action'}:\n            record['steps'] = step\n            return record, node\n    raise TraversalFailure('ax_element_bound', record)\n\n\ndef run(ctx, prior):\n    raw, old_row, matrix = inspect_prior(ctx, prior)\n    proof = ctx.save('c47-keyboard-prior-binding', {\n        'prior_raw': prior['observations'], 'prior_measurements': prior['measurements'],\n        'original_execution_id': raw['execution_id'], 'original_process_exit_code': raw['exit_code'],\n        'original_failed_facts': old_row['facts'],\n        'disposition': 'Retain original non-keyboard and fourteen keyboard measurements; '\n                       'replace only the two failed API keyboard measurements with new observations.'})\n    corrected = copy.deepcopy(matrix)\n    evidence, captures, replacements = [prior['measurements']['path'], proof], [], []\n    for theme, width, height, zoom, percent in VIEWS:\n        name = 'c47-api-keyboard-' + theme.lower() + '-' + str(percent)\n        ctx.app.menu('View', 'Actual Size')\n        ctx.app.front()\n        geometry.size_window(ctx, width, height)\n        c29.appearance(ctx.app, theme)\n        if zoom:\n            c29.zoom(ctx.app, zoom)\n        ctx.navigate('API Client')\n        ctx.app.ax('focus', 'AXHeading', 'API Client')\n        initial = ctx.app.tree()\n        start = ctx.app.focused(initial) or {}\n        ctx.require(start.get('role') == 'AXHeading' and start.get('label') == 'API Client',\n                    'API header did not receive actual native focus')\n        try:\n            trace, node = traverse(initial, lambda: ctx.app.keycode(48), ctx.app.tree,\n                                   ctx.app.focused, ctx.frame)\n        except TraversalFailure as error:\n            ctx.save(name + '-trace', error.record)\n            raise\n        trace_ref = ctx.save(name + '-trace', trace)\n        evidence += [trace_ref, ctx.save(name + '-focused', ctx.app.tree())]\n        captures.append(ctx.capture(name))\n        item = next(r for r in corrected if r['page'] == 'API Client'\n                    and r['theme'] == theme and r['zoom'] == percent)\n        item['named_action_keyboard_visible'] = True\n        item['focused_action'] = node\n        replacements.append({'page': 'API Client', 'theme': theme, 'zoom': percent,\n                             'prior_keyboard_visible': False, 'new_trace': trace_ref,\n                             'collection_and_environment_keyboard_visible': True})\n    evidence.append(ctx.save('c47-keyboard-supplement-measurements', {\n        'prior_raw': prior['observations'], 'prior_measurements': prior['measurements'],\n        'replacements': replacements, 'derived_measurements': corrected,\n        'meaning': 'New derived N01 evidence. The original failed raw row and matrix are unchanged.'}))\n    facts = {'all_destinations_have_one_named_header_h1': all(r['one_named_header_h1'] for r in corrected),\n             'navigation_focus_observed': all(r['navigation_focus'] for r in corrected),\n             'main_frames_measured_inside_window': all(r['main_inside_window'] for r in corrected),\n             'named_actions_keyboard_reachable': all(r['named_action_keyboard_visible'] for r in corrected),\n             'academy_hierarchy_retained': all(r['academy_location'] for r in corrected),\n             'api_header_selectors_keyboard_visible': len(replacements) == 2}\n    ctx.app.menu('View', 'Actual Size')\n    ctx.resize(1440, 900)\n    return {'id': 'C47-N01', 'facts': facts, 'evidence': evidence,\n            'visual': [*old_row['visual'], *captures]}\n","exit_code":0,"status":"completed"}}
