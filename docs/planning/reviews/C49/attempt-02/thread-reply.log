{"type":"item.started","item":{"id":"item_38","type":"command_execution","command":"/bin/zsh -lc \"sed -n '1,220p' apps/desktop/src/modules/tenants/credential-entry.test.tsx; sed -n '1,250p' apps/desktop/src/v2/settings/management-credential.test.tsx; cat apps/desktop/src/modules/academy/academy-account.tsx apps/desktop/src/modules/diagnostics/diagnostics-panel.tsx apps/desktop/src/v2/setup-warning-history.tsx\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_38","type":"command_execution","command":"/bin/zsh -lc \"sed -n '1,220p' apps/desktop/src/modules/tenants/credential-entry.test.tsx; sed -n '1,250p' apps/desktop/src/v2/settings/management-credential.test.tsx; cat apps/desktop/src/modules/academy/academy-account.tsx apps/desktop/src/modules/diagnostics/diagnostics-panel.tsx apps/desktop/src/v2/setup-warning-history.tsx\"","aggregated_output":"/**\n * Production scan-key entry through the real App, DesktopClient and shell:\n * fresh capture at submission, transient handling, storage-mode choice and\n * truthful outcome reporting.\n */\nimport { act, render, screen, within } from '@testing-library/react'\nimport userEvent from '@testing-library/user-event'\nimport { afterEach, beforeEach, describe, expect, it, vi } from 'vitest'\nimport { DesktopClient } from '@prisma-airs/desktop-contracts'\nimport { App } from '../../app'\nimport { baseSnapshot, type Native, scriptedNative, tenant, withTenant, framed } from '../../test/native'\n\nconst KEY = 'synthetic-scan-key-0042'\n\nasync function openSettings(native: Native) {\n    const user = userEvent.setup()\n    render(<App client={new DesktopClient(native.transport)} />)\n    // C44: one presentation; the core names the destination in the snapshot.\n    await native.push({ ...native.current, onboarding: 'done', activeFeature: 'settings' })\n    return user\n}\n\nconst keyField = () => screen.getByLabelText('AIRS API key') as HTMLInputElement\n\nlet setItem: ReturnType<typeof vi.spyOn>\nbeforeEach(() => {\n    setItem = vi.spyOn(Storage.prototype, 'setItem')\n})\nafterEach(() => setItem.mockRestore())\n\ndescribe('scan-key entry', () => {\n    it('captures the key typed at submission time and clears the field before awaiting', async () => {\n        const native = framed(scriptedNative(withTenant(baseSnapshot, tenant())), 'settings')\n        let admit: (value: unknown) => void = () => undefined\n        native.respond = () => new Promise((resolve) => (admit = resolve))\n        const user = await openSettings(native)\n        await user.type(keyField(), 'first-draft')\n        await user.clear(keyField())\n        await user.type(keyField(), KEY)\n        await user.click(screen.getByRole('button', { name: 'Save key' }))\n        expect(keyField().value).toBe('')\n        expect(native.dispatched).toEqual([\n            {\n                kind: 'configureScanCredential',\n                context: 'cx-aaaaaaaaaaaaaaaaaaaaaaaa',\n                mode: 'keychain',\n                key: KEY,\n            },\n        ])\n        await act(async () => admit({ outcome: 'receipt', receipt: { kind: 'admitted', request: 'rq-1', operation: null } }))\n        expect(screen.queryByRole('alert')).toBeNull()\n    })\n\n    it('keeps the key out of snapshots, observations, the page and browser storage', async () => {\n        const native = framed(scriptedNative(withTenant(baseSnapshot, tenant())), 'settings')\n        const user = await openSettings(native)\n        await user.type(keyField(), KEY)\n        await user.click(screen.getByRole('button', { name: 'Save key' }))\n        await native.push(\n            withTenant(baseSnapshot, tenant({ scan: { state: 'ready', mode: 'keychain', failure: null } }), 'cx-bbbbbbbbbbbbbbbbbbbbbbbb')\n        )\n        expect(screen.getByText('Scan key saved in secure storage.')).toBeInTheDocument()\n        const withKey = native.sent.filter((body) => body.includes(KEY))\n        expect(withKey).toHaveLength(1)\n        expect(JSON.parse(withKey[0]!).intent.kind).toBe('configureScanCredential')\n        expect(native.delivered.some((update) => update.includes(KEY))).toBe(false)\n        expect(document.body.innerHTML).not.toContain(KEY)\n        expect(setItem).not.toHaveBeenCalled()\n    })\n\n    it('sends the session-only choice when selected', async () => {\n        const native = framed(scriptedNative(withTenant(baseSnapshot, tenant())), 'settings')\n        const user = await openSettings(native)\n        const scanKey = document.querySelector<HTMLElement>('[data-slot=\"scan-key\"]') as HTMLElement\n        await user.click(within(scanKey).getByRole('radio', { name: /For this session only/ }))\n        await user.type(keyField(), KEY)\n        await user.click(screen.getByRole('button', { name: 'Save key' }))\n        expect(native.dispatched.at(-1)).toMatchObject({ kind: 'configureScanCredential', mode: 'session' })\n    })\n\n    it('reports a refusal without claiming the key was saved', async () => {\n        const native = framed(scriptedNative(withTenant(baseSnapshot, tenant())), 'settings')\n        native.respond = () => ({ outcome: 'refusal', refusal: 'staleContext' })\n        const user = await openSettings(native)\n        await user.type(keyField(), KEY)\n        await user.click(screen.getByRole('button', { name: 'Save key' }))\n        expect(await screen.findByRole('alert')).toHaveTextContent(/active tenant changed/i)\n        expect(keyField().value).toBe('')\n        expect(screen.getByText(/No scan key/)).toBeInTheDocument()\n    })\n\n    it('reports an unconfirmed delivery as unknown', async () => {\n        const native = framed(scriptedNative(withTenant(baseSnapshot, tenant())), 'settings')\n        native.respond = () => Promise.reject(new Error('lost'))\n        const user = await openSettings(native)\n        await user.type(keyField(), KEY)\n        await user.click(screen.getByRole('button', { name: 'Save key' }))\n        expect(await screen.findByRole('alert')).toHaveTextContent(/did not confirm/i)\n        const configure = native.dispatched.filter((i) => i.kind === 'configureScanCredential')\n        expect(configure.length).toBeGreaterThan(0)\n        expect(new Set(native.sent.filter((b) => b.includes(KEY)))).toHaveProperty('size', 1)\n    })\n\n    it('refuses an empty key locally and focuses the field', async () => {\n        const native = framed(scriptedNative(withTenant(baseSnapshot, tenant())), 'settings')\n        const user = await openSettings(native)\n        await user.click(screen.getByRole('button', { name: 'Save key' }))\n        expect(await screen.findByRole('alert')).toHaveTextContent('Enter the scan key.')\n        expect(keyField()).toHaveFocus()\n        expect(native.dispatched).toEqual([])\n    })\n\n    it('shows locked and denied failures with explicit recovery, never a fallback', async () => {\n        const native = framed(scriptedNative(\n            withTenant(baseSnapshot, tenant({ scan: { state: 'failed', mode: 'keychain', failure: 'locked' } }))\n        ), 'settings')\n        await openSettings(native)\n        expect(screen.getByText(/Secure storage is locked/)).toBeInTheDocument()\n        await native.push(withTenant(baseSnapshot, tenant({ scan: { state: 'failed', mode: 'keychain', failure: 'denied' } })))\n        expect(screen.getByText(/did not allow access/)).toBeInTheDocument()\n        expect(screen.getByRole('button', { name: 'Replace key' })).toBeInTheDocument()\n    })\n\n    it('removes the scan key under the current context', async () => {\n        const native = framed(scriptedNative(\n            withTenant(baseSnapshot, tenant({ scan: { state: 'ready', mode: 'session', failure: null } }))\n        ), 'settings')\n        const user = await openSettings(native)\n        expect(screen.getByText('Scan key held for this session only.')).toBeInTheDocument()\n        await user.click(screen.getByRole('button', { name: 'Remove scan key' }))\n        expect(native.dispatched).toEqual([{ kind: 'removeScanCredential', context: 'cx-aaaaaaaaaaaaaaaaaaaaaaaa' }])\n    })\n\n    it('discards a partially typed key when the context changes', async () => {\n        const native = framed(scriptedNative(withTenant(baseSnapshot, tenant())), 'settings')\n        const user = await openSettings(native)\n        await user.type(keyField(), 'partial')\n        await native.push(withTenant(baseSnapshot, tenant(), 'cx-cccccccccccccccccccccccc'))\n        expect(keyField().value).toBe('')\n        expect(native.dispatched).toEqual([])\n    })\n})\n/**\n * Production management-client onboarding through the real App, DesktopClient\n * and the one presentation (C44): Settings is reached as the v2 shell reaches\n * it, and the same assertions as the C08 suite hold: a separate credential\n * from the scan key, the secret captured at submission and cleared before\n * awaiting, verification as one management read, TSG requirement and removal.\n * The legacy suite stays as the owner's uncommitted file; this one runs.\n */\nimport { render, screen, within } from '@testing-library/react'\nimport userEvent from '@testing-library/user-event'\nimport { afterEach, beforeEach, describe, expect, it, vi } from 'vitest'\nimport { DesktopClient, type TenantView } from '@prisma-airs/desktop-contracts'\nimport { App } from '../../app'\nimport { baseSnapshot, framed, type Native, scriptedNative, tenant, withTenant } from '../../test/native'\n\nconst CONTEXT = 'cx-aaaaaaaaaaaaaaaaaaaaaaaa'\nconst CLIENT_ID = 'svc@1234567890.iam.panserviceaccount.com'\nconst SECRET = 'synthetic-management-secret-0042'\nconst readyManagement: TenantView['management'] = {\n    state: 'ready',\n    mode: 'keychain',\n    failure: null,\n    clientId: CLIENT_ID,\n    tokenOrigin: 'https://auth.apps.paloaltonetworks.com',\n}\n\nasync function openSettings(native: Native) {\n    const user = userEvent.setup()\n    render(<App client={new DesktopClient(framed(native, 'settings').transport)} />)\n    await screen.findByRole('heading', { level: 1, name: 'Settings' })\n    return user\n}\n\nconst section = () => document.querySelector<HTMLElement>('[data-slot=\"management-credential\"]') as HTMLElement\nconst secretField = () => within(section()).getByLabelText('Client secret') as HTMLInputElement\nconst clientField = () => within(section()).getByLabelText('Client ID') as HTMLInputElement\n\nlet setItem: ReturnType<typeof vi.spyOn>\nbeforeEach(() => {\n    setItem = vi.spyOn(Storage.prototype, 'setItem')\n})\nafterEach(() => setItem.mockRestore())\n\ndescribe('management client onboarding', () => {\n    it('saves a separate client, clearing the secret before awaiting and keeping it out of storage', async () => {\n        const native = scriptedNative(withTenant(baseSnapshot, tenant({ scan: { state: 'ready', mode: 'keychain', failure: null } }), CONTEXT))\n        let admit: (value: unknown) => void = () => undefined\n        native.respond = () => new Promise((resolve) => (admit = resolve))\n        const user = await openSettings(native)\n        expect(within(section()).getByRole('status')).toHaveTextContent('Scans do not need one')\n        await user.type(clientField(), CLIENT_ID)\n        await user.type(secretField(), SECRET)\n        await user.click(within(section()).getByRole('radio', { name: /For this session only/ }))\n        await user.click(within(section()).getByRole('button', { name: 'Save client' }))\n        expect(secretField().value).toBe('')\n        expect(native.dispatched).toEqual([{ kind: 'configureManagementCredential', context: CONTEXT, mode: 'session', clientId: CLIENT_ID, secret: SECRET }])\n        admit({ outcome: 'receipt', receipt: { kind: 'admitted', request: 'rq-1', operation: null } })\n        // The scan key is never part of a management intent.\n        expect(native.dispatched.some((i) => i.kind === 'configureScanCredential')).toBe(false)\n        for (const call of setItem.mock.calls) expect(JSON.stringify(call)).not.toContain(SECRET)\n        expect(native.delivered.join('\\n')).not.toContain(SECRET)\n    })\n\n    it('requires a client ID and a secret before dispatching', async () => {\n        const native = scriptedNative(withTenant(baseSnapshot, tenant(), CONTEXT))\n        const user = await openSettings(native)\n        await user.click(within(section()).getByRole('button', { name: 'Save client' }))\n        expect(within(section()).getByRole('alert')).toHaveTextContent('Enter the client ID.')\n        await user.type(clientField(), CLIENT_ID)\n        await user.click(within(section()).getByRole('button', { name: 'Save client' }))\n        expect(within(section()).getByRole('alert')).toHaveTextContent('Enter the client secret.')\n        expect(native.dispatched).toEqual([])\n    })\n\n    it('needs a TSG ID on the tenant profile', async () => {\n        const native = scriptedNative(withTenant(baseSnapshot, tenant({ tsgId: null }), CONTEXT))\n        await openSettings(native)\n        expect(screen.getByText(/has no TSG ID/)).toBeInTheDocument()\n        expect(within(section()).getByRole('button', { name: 'Save client' })).toBeDisabled()\n    })\n\n    it('points to the Harness for company sign-in (SSO)', async () => {\n        const native = scriptedNative(withTenant(baseSnapshot, tenant(), CONTEXT))\n        await openSettings(native)\n        expect(within(section()).getByText('Company sign-in (SSO) for the Harness is set up per Gateway workspace, in Harness.')).toBeInTheDocument()\n    })\n\n    it('verifies with one management read and reports failures faithfully', async () => {\n        const native = scriptedNative(withTenant(baseSnapshot, tenant({ management: readyManagement }), CONTEXT))\n        let answer: unknown = { kind: 'management', result: { kind: 'verified' } }\n        native.respond = () => ({ outcome: 'receipt', receipt: { kind: 'admitted', request: 'rq-1', operation: 'op-7' } })\n        const observed: string[] = []\n        native.observeManagement = (operation) => {\n            observed.push(operation)\n            return answer\n        }\n        const user = await openSettings(native)\n        expect(within(section()).getByRole('status')).toHaveTextContent('saved in secure storage')\n        expect(within(section()).getByText(`Client ID: ${CLIENT_ID}`)).toBeInTheDocument()\n        await user.click(within(section()).getByRole('button', { name: 'Verify' }))\n        expect(await within(section()).findByText('Management OAuth authentication succeeded.')).toBeInTheDocument()\n        expect(native.dispatched).toEqual([{ kind: 'management', context: CONTEXT, request: { kind: 'verify' } }])\n        expect(observed).toEqual(['op-7'])\n        answer = { kind: 'management', result: { kind: 'failed', failure: 'unauthorized', outcome: 'rejected' } }\n        await user.click(within(section()).getByRole('button', { name: 'Verify' }))\n        expect(await within(section()).findByRole('alert')).toHaveTextContent('was not accepted')\n        expect(within(section()).queryByText('Management OAuth authentication succeeded.')).toBeNull()\n    })\n\n    it('removes only the management client', async () => {\n        const native = scriptedNative(withTenant(baseSnapshot, tenant({ scan: { state: 'ready', mode: 'keychain', failure: null }, management: readyManagement }), CONTEXT))\n        const user = await openSettings(native)\n        await user.click(within(section()).getByRole('button', { name: 'Remove management client' }))\n        expect(native.dispatched).toEqual([{ kind: 'removeManagementCredential', context: CONTEXT }])\n    })\n})\nimport { useId, useState } from 'react'\nimport { Button, Callout } from '@ai-security-academy/presentation'\nimport { AlertTriangle, CheckCircle2, Info } from 'lucide-react'\nimport type { AcademyFailure, AcademyView, Intent, VaultError } from '@prisma-airs/desktop-contracts'\nimport { type Dispatch, outcomeMessage } from '../tenants/dispatch'\n\nconst FAILURE_TEXT: Record<AcademyFailure, string> = {\n    notConfigured: 'Academy desktop sign-in is not available on this server.',\n    invalidConfig: 'Academy returned a sign-in configuration the desktop cannot trust.',\n    network: 'Academy could not be reached. Check your connection and try again.',\n    invalidResponse: 'Academy returned an unexpected sign-in response. Try again.',\n    denied: 'Sign-in was declined in the browser.',\n    expired: 'The sign-in code expired before it was approved. Start again.',\n    sessionExpired: 'Your Academy session expired. Sign in again.',\n    scopeMissing: 'Academy did not grant learning access to this sign-in.',\n    accountChanged: 'Academy changed its sign-in configuration. Sign in again.',\n    authFailed: 'Academy sign-in could not complete. Try again.',\n}\n\nconst VAULT_TEXT: Record<VaultError, string> = {\n    locked: 'Secure storage is locked, so the session could not be saved. Unlock it and sign in again.',\n    denied: 'The system did not allow the Academy session to be saved in secure storage.',\n    unavailable: 'Secure storage is not available, so the session could not be saved.',\n    notFound: 'The saved Academy session is missing from secure storage.',\n    corrupt: 'The saved Academy session could not be read.',\n}\n\ninterface Props {\n    view: AcademyView\n    dispatch: Dispatch\n}\n\n/**\n * The Academy learner account, independent of AIRS tenants. Sign-in is a\n * browser device flow: the desktop shows a code, opens the Academy page the\n * issuer named, and never sees a password. Tokens stay in the native core.\n */\nexport function AcademyAccount({ view, dispatch }: Props) {\n    const legend = useId()\n    const [busy, setBusy] = useState(false)\n    const [message, setMessage] = useState<string | null>(null)\n\n    async function send(intent: Intent) {\n        setBusy(true)\n        setMessage(null)\n        const outcome = await dispatch(intent)\n        setBusy(false)\n        setMessage(outcomeMessage(outcome))\n    }\n\n    return (\n        <fieldset\n            aria-labelledby={legend}\n            aria-busy={busy}\n            data-slot='academy-account'\n            className='settings-card'\n        >\n            <legend id={legend} className='text-academy-ink px-1 text-[15px] font-semibold'>\n                Academy account\n            </legend>\n            <p className='text-academy-ink-soft text-[13px]'>\n                Your Academy learner account is separate from AIRS tenants; switching tenants does not change it.\n            </p>\n            <div role='status' aria-live='polite' className='flex flex-col gap-3'>\n                <State view={view} busy={busy} send={send} />\n            </div>\n            {message ? (\n                <p role='alert' data-slot='academy-message' className='text-academy-accent-warn text-[13px]'>\n                    {message}\n                </p>\n            ) : null}\n        </fieldset>\n    )\n}\n\nfunction State({ view, busy, send }: { view: AcademyView; busy: boolean; send: (intent: Intent) => Promise<void> }) {\n    switch (view.state) {\n        case 'signedOut':\n            return (\n                <div className='flex flex-col items-start gap-3'>\n                    <p className='text-academy-ink text-[13px]'>Not signed in to Academy.</p>\n                    <Button type='button' tier='primary' disabled={busy} onClick={() => void send({ kind: 'startAcademySignIn' })}>\n                        Sign in to Academy\n                    </Button>\n                </div>\n            )\n        case 'starting':\n        case 'completing':\n            return (\n                <div className='flex flex-col items-start gap-3'>\n                    <p className='text-academy-ink text-[13px]'>\n                        {view.state === 'starting' ? 'Contacting Academy…' : 'Approved. Finishing sign-in…'}\n                    </p>\n                    <Button type='button' tier='secondary' onClick={() => void send({ kind: 'cancelAcademySignIn' })}>\n                        Cancel sign-in\n                    </Button>\n                </div>\n            )\n        case 'awaitingApproval':\n            return (\n                <div className='flex flex-col items-start gap-3' data-slot='academy-code'>\n                    <p className='text-academy-ink text-[13px]'>Enter this code on the Academy sign-in page:</p>\n                    <p\n                        className='font-mono text-academy-ink text-[24px] font-semibold tracking-[0.12em] select-all'\n                        aria-label={`Sign-in code ${view.userCode.split('').join(' ')}`}\n                    >\n                        {view.userCode}\n                    </p>\n                    <p className='text-academy-ink-faint text-[12px] break-all'>\n                        {view.verificationUri} · expires in {Math.max(1, Math.ceil(view.expiresIn / 60))} min\n                    </p>\n                    <div className='flex flex-wrap gap-2'>\n                        <Button type='button' tier='primary' onClick={() => void send({ kind: 'openAcademyVerification' })}>\n                            Open sign-in page\n                        </Button>\n                        <Button type='button' tier='secondary' onClick={() => void send({ kind: 'cancelAcademySignIn' })}>\n                            Cancel sign-in\n                        </Button>\n                    </div>\n                </div>\n            )\n        case 'signedIn':\n            return (\n                <div className='flex flex-col items-start gap-3'>\n                    <Callout tone='success' icon={CheckCircle2}>\n                        <p>\n                            Signed in to Academy as <span className='font-semibold'>{view.displayName}</span>.\n                        </p>\n                    </Callout>\n                    <Button type='button' tier='secondary' disabled={busy} onClick={() => void send({ kind: 'signOutAcademy' })}>\n                        Sign out of Academy\n                    </Button>\n                </div>\n            )\n        case 'failed':\n            return (\n                <div className='flex flex-col items-start gap-3'>\n                    <Callout tone='warning' icon={view.failure === 'network' ? Info : AlertTriangle} data-slot='academy-failure'>\n                        {view.displayName ? <p className='font-semibold'>{view.displayName}</p> : null}\n                        <p>{view.vault ? VAULT_TEXT[view.vault] : FAILURE_TEXT[view.failure]}</p>\n                    </Callout>\n                    <div className='flex flex-wrap gap-2'>\n                        <Button type='button' tier='primary' disabled={busy} onClick={() => void send({ kind: 'startAcademySignIn' })}>\n                            Sign in again\n                        </Button>\n                        <Button type='button' tier='secondary' disabled={busy} onClick={() => void send({ kind: 'signOutAcademy' })}>\n                            Sign out of Academy\n                        </Button>\n                    </div>\n                </div>\n            )\n    }\n}\nimport { useId, useState, type ReactNode } from 'react'\nimport { Button } from '@ai-security-academy/presentation'\nimport type { DiagnosticsClear, DiagnosticsExport, DiagnosticsView } from '@prisma-airs/desktop-contracts'\nimport { type Dispatch, outcomeMessage } from '../tenants/dispatch'\n\nconst EXPORT_TEXT: Record<DiagnosticsExport, string> = {\n    saving: 'Choose where to save the diagnostics in the open dialog.',\n    saved: 'Diagnostics saved.',\n    cancelled: 'Nothing was saved.',\n    failed: 'The diagnostics could not be saved.',\n}\n\nconst CLEAR_TEXT: Record<DiagnosticsClear, string> = {\n    cleared: 'Diagnostics cleared.',\n    failed: 'The diagnostics could not all be removed, so the events counted above are still kept. Try again.',\n}\n\ninterface Props {\n    view: DiagnosticsView\n    dispatch: Dispatch\n    children?: ReactNode\n}\n\n/**\n * Local, redacted diagnostics (C24, D051). The desktop keeps only the kind\n * of each request and why one was refused, storage and reset outcomes, and\n * where the app stopped unexpectedly; never prompts, responses, keys or\n * names. Nothing is sent anywhere: export is explicit and saved where the\n * operator chooses.\n */\nexport function DiagnosticsPanel({ view, dispatch, children }: Props) {\n    const legend = useId()\n    const [message, setMessage] = useState<string | null>(null)\n    const busy = view.export === 'saving'\n\n    async function run(intent: Parameters<Dispatch>[0]) {\n        setMessage(null)\n        const outcome = await dispatch(intent)\n        setMessage(outcomeMessage(outcome))\n    }\n\n    return (\n        <fieldset aria-labelledby={legend} data-slot='diagnostics' className='settings-card'>\n            <legend id={legend} className='text-academy-ink px-1 text-[15px] font-semibold'>\n                Diagnostics\n            </legend>\n            {!view.available ? (\n                <p className='text-academy-ink-soft text-[13px]'>This build keeps no diagnostics.</p>\n            ) : (\n                <>\n                    <p className='text-academy-ink-soft max-w-prose text-[13px]'>\n                        Kept only on this device for {view.retentionDays} days and never sent anywhere: the kind of each\n                        request and why one was refused, storage and reset outcomes, and where the app stopped\n                        unexpectedly. Prompts, responses, keys, tokens and names are never kept.\n                    </p>\n                    <p className='text-academy-ink text-[13px]' data-slot='diagnostics-count'>\n                        {view.events} event{view.events === 1 ? '' : 's'} kept.\n                    </p>\n                    <div className='flex flex-wrap gap-2'>\n                        {/* aria-disabled, not disabled, while the save dialog is open: a\n                            disabled button drops keyboard focus, which would not come back to\n                            Export when the dialog closes. */}\n                        <Button type='button' tier='secondary' aria-disabled={busy} onClick={() => !busy && void run({ kind: 'exportDiagnostics' })}>\n                            Export diagnostics…\n                        </Button>\n                        <Button type='button' tier='tertiary' aria-disabled={busy} onClick={() => !busy && void run({ kind: 'clearDiagnostics' })}>\n                            Clear diagnostics\n                        </Button>\n                    </div>\n                    {view.export ? (\n                        <p role='status' aria-live='polite' className='text-academy-ink-soft text-[13px]'>\n                            {EXPORT_TEXT[view.export]}\n                        </p>\n                    ) : null}\n                    {view.clear === 'failed' ? (\n                        <p role='alert' data-slot='diagnostics-clear' className='text-academy-accent-warn text-[13px]'>\n                            {CLEAR_TEXT.failed}\n                        </p>\n                    ) : view.clear === 'cleared' ? (\n                        <p role='status' aria-live='polite' data-slot='diagnostics-clear' className='text-academy-ink-soft text-[13px]'>\n                            {CLEAR_TEXT.cleared}\n                        </p>\n                    ) : null}\n                </>\n            )}\n            {message ? (\n                <p role='alert' className='text-academy-accent-warn text-[13px]'>\n                    {message}\n                </p>\n            ) : null}\n            {children}\n        </fieldset>\n    )\n}\nimport type { SetupWarning, VerifyState } from '@prisma-airs/desktop-contracts'\nimport { READ_COPY } from './copy'\n\nconst CHECK_STATE: Record<VerifyState, string> = { pending: 'Checking', pass: 'Passed', warning: 'Warning', fail: 'Failed', stored: 'Stored', skipped: 'Skipped', unavailable: 'Unavailable' }\n\nfunction RecordedTime({ seconds }: { seconds: number }) {\n    const date = new Date(seconds * 1000)\n    return Number.isFinite(date.valueOf()) ? <time dateTime={date.toISOString()}>{date.toLocaleString()}</time> : <span>Time unavailable</span>\n}\n\n/** Native outcomes only: this presentation never infers resolution from a product read. */\nexport function SetupWarningResult({ warning, live = false }: { warning: SetupWarning; live?: boolean }) {\n    return <div className='flex flex-col text-[13px]' style={{ gap: 5, color: 'var(--v2-soft)' }} role={live ? 'status' : undefined} aria-live={live ? 'polite' : undefined} data-slot='setup-warning-result'>\n        <p>Originally recorded <RecordedTime seconds={warning.recordedSecs} />.</p>\n        {warning.recheck ? <>\n            <p>Latest check: {CHECK_STATE[warning.recheck.state]} · <RecordedTime seconds={warning.recheck.checkedSecs} />.</p>\n            <p>{warning.recheck.reason}</p>\n            {warning.recheck.state !== 'pending' && (warning.recheck.basis === 'unknown' || !warning.recheck.equivalent) ? <p>The original scope could not be matched. This result does not resolve the original warning.</p> : null}\n        </> : <p>No later setup recheck is recorded.</p>}\n        {warning.resolvedSecs !== undefined\n            ? <p data-state='resolved'>Resolved <RecordedTime seconds={warning.resolvedSecs} />.</p>\n            : <p data-state='active'>Warning active.</p>}\n    </div>\n}\n\n/** Tenant configuration history is separate from the redacted diagnostic event log/export. */\nexport function SetupWarningHistory({ warnings }: { warnings: SetupWarning[] }) {\n    if (warnings.length === 0) return null\n    return <section aria-label='Setup check history' className='flex flex-col' style={{ gap: 10, borderTop: '1px solid var(--v2-rule)', paddingTop: 12 }}>\n        <h3 className='text-[14px] font-semibold' style={{ color: 'var(--v2-ink)' }}>Setup check history</h3>\n        <p className='text-[13px]' style={{ color: 'var(--v2-soft)' }}>These tenant setup records are separate from the redacted diagnostic events above. Exporting or clearing diagnostic events does not export or clear this history.</p>\n        <ol className='flex flex-col' style={{ gap: 14 }}>\n            {[...warnings].sort((a, b) => b.recordedSecs - a.recordedSecs).map((warning) => <li key={warning.id} data-warning={warning.id} className='flex flex-col' style={{ gap: 5 }}>\n                <h4 className='text-[13px] font-semibold' style={{ color: 'var(--v2-ink)' }}>{READ_COPY.products[warning.product]}</h4>\n                <p className='text-[13px] whitespace-pre-wrap' style={{ color: 'var(--v2-soft)' }}>{warning.reason}</p>\n                <SetupWarningResult warning={warning} />\n            </li>)}\n        </ol>\n    </section>\n}\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_39","type":"command_execution","command":"/bin/zsh -lc \"sed -n '200,320p' crates/xtask/src/fingerprint.rs; cat docs/planning/evidence/P11/remediation-selection-02/fingerprint.json; sed -n '259,297p' tools/p11/remediation.py; cat tools/p11/README.md\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_39","type":"command_execution","command":"/bin/zsh -lc \"sed -n '200,320p' crates/xtask/src/fingerprint.rs; cat docs/planning/evidence/P11/remediation-selection-02/fingerprint.json; sed -n '259,297p' tools/p11/remediation.py; cat tools/p11/README.md\"","aggregated_output":"    }\n    for (label, hash) in consumed_shared(repo)? {\n        parts.insert(label, hash);\n    }\n    parts.insert(\"toolchain\".to_owned(), toolchain_hash.to_owned());\n    Ok(sha256_hex(\n        serde_json::to_string(&parts).unwrap_or_default().as_bytes(),\n    ))\n}\n\n/// Build flags: the subject's manifest entries and native configuration,\n/// as canonical JSON (sorted keys, compact) so independent tools can\n/// recompute it.\npub fn build_flags(repo: &Repo, manifest: &Manifest, subject: Subject) -> Result<String> {\n    use serde_json::{Value, json};\n    let mut parts: BTreeMap<String, Value> = BTreeMap::new();\n    let chunks = if subject.is_phase() {\n        manifest.phase_chunks(subject)?\n    } else {\n        vec![subject]\n    };\n    for chunk in chunks {\n        let entry = manifest.chunk(chunk)?;\n        let mut flags = json!({\n            \"fixture\": entry.fixture_command,\n            \"frontend\": entry.frontend_commands,\n            \"host\": entry.host_commands,\n            \"native_prepare\": entry.native_prepare,\n        });\n        // Keep historical canonical objects byte-for-byte equivalent. Only\n        // new chunks bind the D063 selected check list.\n        if let Some(selected) = &entry.check_commands {\n            flags[\"checks\"] = json!(selected);\n        }\n        parts.insert(format!(\"chunk/{chunk}\"), flags);\n    }\n    parts.insert(\"setup\".to_owned(), json!(manifest.setup_commands));\n    parts.insert(\n        \"phase_native\".to_owned(),\n        json!(manifest.phase_native_prepare),\n    );\n    parts.insert(\"common\".to_owned(), json!(manifest.common_commands));\n    parts.insert(\"shared\".to_owned(), json!(manifest.shared_source_commands));\n    parts.insert(\"artifact\".to_owned(), json!(manifest.artifact_build));\n    parts.insert(\"target\".to_owned(), json!(manifest.target));\n    parts.insert(\n        \"fixture_only\".to_owned(),\n        json!(manifest.fixture_only_features),\n    );\n    parts.insert(\n        \"production_features\".to_owned(),\n        json!(manifest.requested_production_features),\n    );\n    for file in BUILD_FLAG_FILES {\n        let digest = std::fs::read(repo.join(file))\n            .map(|b| sha256_hex(&b))\n            .unwrap_or_else(|_| \"absent\".to_owned());\n        parts.insert(file.to_owned(), json!(digest));\n    }\n    Ok(sha256_hex(\n        serde_json::to_string(&parts).unwrap_or_default().as_bytes(),\n    ))\n}\n\n/// Native configuration files whose bytes are part of the build flags.\npub const BUILD_FLAG_FILES: [&str; 7] = [\n    \"apps/desktop/src-tauri/tauri.conf.json\",\n    \"apps/desktop/src-tauri/tauri.fixture.conf.json\",\n    \"apps/desktop/src-tauri/tauri.harness.conf.json\",\n    \"apps/desktop/src-tauri/capabilities/main.json\",\n    \"apps/desktop/src-tauri/Cargo.toml\",\n    \"Cargo.toml\",\n    \"docs/architecture/native-checks.json\",\n];\n\n/// Evidence: the subject's committed evidence directory (empty if absent).\npub fn evidence(repo: &Repo, subject: Subject) -> Result<String> {\n    let dir = repo.evidence_dir(subject);\n    if dir.is_dir() {\n        tree_hash(&dir)\n    } else {\n        Ok(sha256_hex(b\"\"))\n    }\n}\n\npub fn all(\n    repo: &Repo,\n    manifest: &Manifest,\n    subject: Subject,\n    toolchain_hash: &str,\n) -> Result<Fingerprints> {\n    Ok(Fingerprints {\n        source: source(repo)?,\n        dependencies: dependencies(repo, toolchain_hash)?,\n        build_flags: build_flags(repo, manifest, subject)?,\n        evidence: evidence(repo, subject)?,\n    })\n}\n\n/// The Academy packages the desktop installs from the staged input\n/// (`file:` dependencies) and compiles: each one's locked input subtree, its\n/// staged scratch copy and the copy installed into the desktop's\n/// node_modules are hashed into the dependency fingerprint; editing any of\n/// them invalidates bound receipts. The presentation package keeps its\n/// original labels.\npub const SHARED_PACKAGES: [(&str, &str); 3] = [\n    (\"presentation\", \"packages/presentation\"),\n    (\"learner\", \"packages/learner\"),\n    (\"shared\", \"packages/shared\"),\n];\n\n/// Files a package's own checks generate in scratch; never consumed.\nconst PACKAGE_GENERATED: [&str; 1] = [\"tsconfig.tsbuildinfo\"];\n\nfn package_hash(dir: &Path) -> Result<String> {\n    let mut entries = Vec::new();\n    collect_tree(dir, dir, &[\"node_modules\"], &mut entries)?;\n    entries.retain(|e| !PACKAGE_GENERATED.contains(&e.path.as_str()));\n    entries.sort_by(|a, b| a.path.cmp(&b.path));\n    Ok(inventory_hash(&entries))\n}\n{\n  \"source\": \"5e8e8bb12e9efda00f04da5be85184190b9c97f6d2bb21a96c82197f86eccbdd\",\n  \"dependencies\": \"2c489f82dc23ebf9680a9cb5977071253b226b29c8f019f1fb43db4ff3384326\",\n  \"build_flags\": \"2b29a1e96f4c6f878a15a50ae4e202d789ff6d5c93a7519fc8c3e2e32e06d432\"\n}\ndef source_qa(root, reference, files):\n    supplement = read(bound(root, reference))\n    require(supplement['schema'] == 'airs-desktop/p11-c48-source-supplement/1'\n            and supplement['source_files'] == {n: files[n]['sha256'] for n in APP_DELTA},\n            'C48 affected source inputs differ')\n    producers = [read(bound(root, ref)) for ref in supplement['producer_receipts']]\n    originals = [row for producer in producers for key in ('final_checks', 'retained_prior_focused_checks')\n                 for row in producer.get(key, [])]\n    expected = {'C48/recovery-final02': 4, 'C48/typecheck-final02': None,\n        'C48/controllers-final': 20, 'C48/api-prior': 42, 'C48/shell-and-cases-prior': 45}\n    checks = supplement['checks']\n    require(len(checks) == len(expected) and {c['id'] for c in checks} == set(expected),\n            'C48 selected recovery/cross-consumer coverage missing')\n    earlier = {\n        'apps/desktop/src/v2/workbench/api-client.tsx': {\n            '50b881c165ce183abe845f4c572d687fe7bc4b0041a1a69c875394c55a67bb1d',\n            '0d1da0ed31d0ff86e4d46fb0392f08ad06945b30eb47c7cf97c114fba46e63d3'},\n        'apps/desktop/src/v2/workbench/api-client.test.tsx': {\n            '2d07b3ec2c0d340b30c4cf23877c05b548d30f34c7a4a98fe2dc72433f2f01eb',\n            '7a68e497d5056c30ebb8aa1f9f9c8216d7a28e979d86496ea74cbce9c255de03'}}\n    for item in checks:\n        require(item['exit_code'] == 0 and item.get('passed') == expected[item['id']]\n                and item['argv'] and item['cwd'], 'C48 selected command failed')\n        log = bound(root, item['log'])\n        require(any(all(old.get(k) == item.get(k) for k in ('argv', 'cwd', 'exit_code', 'passed'))\n                    and old['log_sha256'] == sha(log) for old in originals),\n                'C48 selection is not an original actual execution')\n        require(item['source_hashes'] and set(item['source_inputs']) == set(item['source_hashes']),\n                'C48 original source scope missing')\n        for name, value in item['source_hashes'].items():\n            require(sha(bound(root, item['source_inputs'][name])) == value\n                    and (files.get(name, {}).get('sha256') == value or value in earlier.get(name, set())),\n                    'C48 selected source delta is not the bounded recovery refinement')\n        if item['id'].endswith('final02'):\n            require(item['source_hashes'] == supplement['source_files'], 'final selector source was retagged')\n    return supplement\n\n\ndef recovery(root, reference, baseline, candidate, old_result, files):\n# Shared P11 qualification and actual reviews\n\nThe accepted D063 plan selects the changed C46–C49 flows. P09/P10 and RC1 retain\ntheir original results and artifacts. One actual P11 Check/Test run and fixture\ncandidate serve all four chunk reviews and the phase review. No phase run is\ncopied, renamed or reported as a newly executed chunk run. The standard ledger\nremains unchanged (`controller_complete:false`), as with the accepted P10 manual\nreview fallback.\n\nUse the existing Rust Runner's registered P11 focused command plans and one\n`xtask native-prepare --phase P11 --target aarch64-apple-darwin --features\ntest-fixtures`. Finish source preflight before that build. Real source failures\nget causal checks; driver-only fixes retain the same verified app bytes. Keep\nall failed attempts. Do not rerun unrelated Rust/native suites for provenance.\n\n`acceptance_p11.py` requires the explicit fixture bundle, owned processes and\nlocal synthetic endpoints. It records measured facts and capture hashes first.\nIts no-UI finalizer requires an actual source-bound P11 test RunRecord and an\nexplicit, capture-specific visual review. No pixels or invisible authority\nboundary are inferred from a test count, successful script exit or AX absence.\n\n`proof.py make` binds the actual Check/Test RunRecords, current metadata-only\nfingerprint, prepare, finalized native record, original observation manifest and\nbuild receipt into one immutable qualification folder. Its CLI lists the exact\nrequired inputs. It reuses P10's raw evidence validator and rejects missing or\nchanged command/native membership, logs, current source/dependencies, candidate,\nhelpers, incomplete build inputs and failed observation exits. The Python source\nhash recomputation was checked against the actual Rust fingerprint algorithm.\n\nFor the two reviewed conditional-style fixes, `--check` may name an explicit\n`airs-desktop/p11-check-selection/1` receipt. It binds the original failed Check\nrun, exact before/current source inventories, the fixed module's exact hashes,\nand a current `airs-desktop/p11-check-supplement/1` containing only affected or\npreviously blocked commands. Every registered command is accounted in order.\nPassing setup/bindings/typecheck/compile results may be `carried_unaffected`\nwith a reason; their original source, timestamps and logs remain bound. Format\nand all affected/blocked lint/notice checks execute. This receipt is never a\nnew passing full-run record. Tests and native assertions still execute on the\nshared current candidate, and archived standing uses this same strict consumer.\nThe dated test-only `unwrap` to descriptive `expect` correction is also bound\nby its exact old/new hashes. `airs-desktop/rust-test-build-carry/1` retains the\noriginal build/prepare and binds the current Check selection and Test run; only\nthat Rust test file may differ. It requires no frontend or native rebuild and\ndoes not claim either was executed. Executable and complete bundle verification\nremain independent requirements.\n\nFor a frontend test-only source change, `--build-input-carry` requires the\noriginal native build and a successful current-source frontend rebuild whose\ncomplete output is byte-identical. Its command, input hashes and raw log remain\nbound; the retained native build is never reported as newly executed.\n\n`review.py make C46 attempt-01 QUALIFICATION` (likewise C47–C49) writes a frozen\nrequest and inventories. Launch it with the retained\n`tools/p09/launch-remedial-review.py C46 attempt-01 gpt-6.1-sol`, then use\n`review.py audit C46 attempt-01`. The launcher requests a fresh, ephemeral,\nread-only reviewer with hooks/plugins/network/UI features disabled. Every actual\nscore and finding is retained. After all four pass the full gate, make and audit\nthe P11 request against exactly the same qualification. Chunk acceptance at8\nfollows D034; P11 still requires every member and phase at9 with empty findings.\n\n`standing.finalize(root, qualification, attempts)` runs only after those five\nactual reviews. It refuses existing outputs, verifies the three explicit LFS\npaths, and archives the exact source, fixture app and proof/evidence membership.\n`standing.py release-prerequisites` subsequently verifies that archived standing\nwithout a current `target` directory, installed app, host toolchain or matching\nhostname. Production promotion requires both the original P09/P10 proof and this\nnew P11 standing. Stable installed/live acceptance and Linux qualification remain\nseparate. These tools perform no signing, publication or live product calls.\n\n## VM affected verification after the Modal fix\n\nThe dedicated VM uses the unchanged registered command plan. Run selected labels\nwith the existing Runner through the small build-only example:\n\n    cargo run --locked -p xtask --example p11_affected -- check C46/check/1 C46/check/4\n    cargo run --locked -p xtask --example p11_affected -- test <all 12 registered frontend labels, in order>\n\nThis produces ordinary subset RunRecords. It refuses setup, unknown, duplicate\nand reordered labels; it does not create full-suite or controller completion.\nThe source checks originally run on Kirk retain their original logs and inputs.\n\nThe optional proof.py make --impact-selection FILE keeps --check and --tests\npointing to the original D2 records. FILE has schema\nairs-desktop/p11-impact-selection/1, current runner_inputs, a nonempty reason,\nand these bound references: baseline_source, baseline_candidate,\nbaseline_check, baseline_test, current_source, tool_transition, and\ncurrent_runs (check/test). Both source records contain files and git_config.\nIt also lists exact changed_paths, dependencies from carry_dependencies,\nand affected labels: the two checks above and all registered frontend tests.\n\nD2 is source-check context, with no native qualification claimed. Its permanent\narchive is docs/planning/evidence/P11/source-history/D2. The original failed\nCheck and its two repairs stay intact. Current format/typecheck and frontend\nresults execute in the VM; eight unchanged Rust test commands and seven other\nchecks are carried with explicit reasons. Dependencies include all desktop-core,\nxtask library, contracts, resources, architecture inputs and root lock/toolchain\nfiles. The tool audit must bind exact original/current compiler, Cargo, Node and\npnpm bytes; only the rustup shims may differ. No whole dependency hash is relabelled.\n\nThe P11 wrapper validates Check provenance at its original source context. The\nunchanged P10 generic consumer validates carried Rust results against their\noriginal candidate, raw runs/logs and exact dependency proofs. Every registered\nrequirement remains present. Final standing includes both source contexts and\nverifies without a target directory or the original host. A changed production\ndependency, omitted command, failed/zero-test result or changed compiler fails\nthe consumer. New native assertions still require actual current VM evidence.\n\n## Native helper continuation without replaying source QA\n\nFor helper/proof-only fixes after the VM source checks, --helper-source-carry\nbinds schema airs-desktop/p11-helper-source-carry/1. It names baseline_source\n(the archived S2 source seal), baseline_candidate (S2 app/VM context),\nimpact_selection (the original D2/S2 selection), current_source (S3), exact\nchanged_paths, current runner_inputs, unchanged conditions, a reason and qa refs.\nThe complete application input identities and dependency/build fingerprints must\nmatch. Only native/P11 helpers, their build-only example and owner execution\ndocumentation/attributes may change; an application edit is rejected.\n\nEach QA ref has schema airs-desktop/p11-helper-qa/1, actual argv/cwd, exit_code,\npositive passing tests, a bound log and helper_files mapping names to current\nhashes. The records must cover every changed Python helper. Their relevant\nhelper hashes bind validity; unrelated source edits do not force repeated QA.\n\nThe fourteen S2 frontend/check results retain their actual RunRecords and become\nreused_exact against the same app, flags and VM conditions with empty helper\ndependencies. The eight D2 Rust results remain carried_unaffected. Original\nfailed Check evidence stays unchanged. Both D2 and S2 source archives are in\nthe durable historical context; no current target or original host is needed.\n\nA native continuation names a native-selection/1 manifest and finalized standard\nacceptance. Per-row origins retain the failed original process status separately\nfrom completed assertion status. C46 uses its original completed observations\nand unchanged relevant helpers; remaining rows use the successful continuation.\nThe native provenance validator binds actual per-row logs, arguments, times,\ncapture reviews and app identities. A failed whole process is never relabelled\nas a newly passing process.\n\n### Review remediation without replaying unaffected flows\n\n`remediation.py RECEIPT --out FRESH_FOLDER` consumes the dated C46/C47/C48\nreview fixes. `proof.py verify FRESH_FOLDER/qualification.json` remains the\nreview entrypoint. This path preserves qualification02 and all original raw\noutcomes; it does not turn a failed contributing process into a passing run.\n\nThe receipt (`airs-desktop/p11-review-remediation/1`) binds the original\nqualification, D2/S2/S3 source history, the preserved original app tar, current\nsource/fingerprint/build/prepare, the actual nine Rust integration consumers,\nC48 source selectors, the old-artifact drawer-scroll supplement, current-artifact\nrecovery, helper QA, and a reason for every carried requirement. Exactly four\nfrontend files and two Rust fixture files have pinned before/after hashes. Other\napplication, dependency, native-helper or VM changes cannot silently use this\nreview decision. The versioned native build example is a build tool, not a\nproduction-source exemption.\n\nUnchanged rows retain their original result and candidate references. Explicit\n`carried_unaffected` dependency proofs include every resource and the relevant\nnative helpers. Source selectors replace only affected verification goals;\nthe original registered command remains visible. These custom selector records\nretain actual commands, logs, source inputs and known timing limitations rather\nthan manufacturing a complete `airs-v2/run/1` or claiming a whole command reran.\nC48's new recovery slice retains unrelated first-use/save facts as old subfact\norigins. It never presents the original 099/eb9 artifact as the new app.\n\nHistorical finalization archives the accepted source/app and retains all three\nprior source contexts. P10's generic coverage and historical consumers are\nunchanged. This path does not assign review scores or complete a controller.\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_40","type":"command_execution","command":"/bin/zsh -lc \"rg -n --glob '*.css' 'focus-visible|focus-ring|input.*focus' .inputs/academy | head -65; cat apps/desktop/src/modules/academy/learner-provider.tsx; cat apps/desktop/src/styles.css\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_40","type":"command_execution","command":"/bin/zsh -lc \"rg -n --glob '*.css' 'focus-visible|focus-ring|input.*focus' .inputs/academy | head -65; cat apps/desktop/src/modules/academy/learner-provider.tsx; cat apps/desktop/src/styles.css\"","aggregated_output":".inputs/academy/packages/presentation/src/styles/base.css:25:    ):focus-visible {\n.inputs/academy/packages/presentation/src/styles/base.css:26:        outline: 2px solid var(--academy-focus-ring);\n.inputs/academy/packages/presentation/src/styles/tokens.css:73:    --academy-focus-ring: color-mix(\n.inputs/academy/packages/presentation/src/styles/theme.css:104:     * ≥3:1 indicator contrast as the consuming app's global :focus-visible\n.inputs/academy/packages/presentation/src/styles/theme.css:106:    --color-ring: var(--academy-focus-ring);\n/**\n * Account-scoped React Query cache and Academy learner host. Every learner\n * reference (an account generation, or the guest generation while signed\n * out) gets its own QueryClient and a remounted subtree: signing in or out,\n * or changing account, retires the previous cache, so no reply or cached\n * value for one account is shown to another. Tenant switches do not change\n * the learner reference and keep the cache.\n */\nimport { createContext, type ReactNode, useCallback, useContext, useEffect, useMemo } from 'react'\nimport { QueryClient, QueryClientProvider } from '@tanstack/react-query'\nimport { createTRPCClient, TRPCClientError, type TRPCClient } from '@trpc/client'\nimport type { AnyRouter } from '@trpc/server'\nimport SuperJSON from 'superjson'\nimport { LearnerHost } from '@ai-security-academy/learner'\nimport type { DesktopClient, LearnerRef } from '@prisma-airs/desktop-contracts'\nimport { desktopLink } from './desktop-link'\nimport { hostAction, loadAcademyImage, nativeLocalDrafts } from './host-actions'\n\nconst NO_RETRY = new Set([\n    'UNAUTHORIZED',\n    'FORBIDDEN',\n    'BAD_REQUEST',\n    'NOT_FOUND',\n    'PRECONDITION_FAILED',\n    'METHOD_NOT_SUPPORTED',\n])\n\n/** Queries may be asked once more after a transient failure; mutations never. */\nexport function learnerQueryClient(): QueryClient {\n    return new QueryClient({\n        defaultOptions: {\n            queries: {\n                staleTime: 60_000,\n                retry: (count, error) =>\n                    count < 1 &&\n                    !(error instanceof TRPCClientError && NO_RETRY.has(String((error.data as { code?: unknown })?.code))),\n            },\n            mutations: { retry: false },\n        },\n    })\n}\n\nconst TrpcContext = createContext<TRPCClient<AnyRouter> | null>(null)\n\n/** A plain learner tRPC client for the current generation (inside a provider). */\nexport function useLearnerTrpc<TRouter extends AnyRouter>(): TRPCClient<TRouter> {\n    const client = useContext(TrpcContext)\n    if (!client) throw new Error('useLearnerTrpc needs a LearnerProvider')\n    return client as unknown as TRPCClient<TRouter>\n}\n\ninterface Props {\n    client: DesktopClient\n    learner: LearnerRef\n    /** Academy's account id when signed in; null for the guest generation. */\n    accountId?: string | null\n    /** The signed-in account's display name, for Academy's account pages. */\n    displayName?: string | null\n    theme?: 'gruvbox' | 'paper'\n    /** Academy web's origin (public links such as certificate verify URLs). */\n    webOrigin?: string | null\n    children: ReactNode\n}\n\nfunction Generation({\n    client,\n    learner,\n    accountId = null,\n    displayName = null,\n    theme = 'gruvbox',\n    webOrigin = null,\n    children,\n}: Props) {\n    const queryClient = useMemo(() => learnerQueryClient(), [])\n    const links = useMemo(\n        () => [\n            desktopLink<AnyRouter>({\n                client,\n                learner: () => learner,\n                signedIn: () => accountId !== null,\n                transformer: SuperJSON,\n            }),\n        ],\n        [client, learner, accountId]\n    )\n    const trpc = useMemo(() => createTRPCClient<AnyRouter>({ links }), [links])\n    // The generation is Academy's learner session: a new one (sign-in,\n    // sign-out, reset, even for the same account) retires Academy's\n    // learner-scoped state.\n    const identity = useMemo(\n        () => ({\n            userId: accountId,\n            session: learner,\n            // The desktop knows the account's display name only; the email\n            // and uploaded photo come from Academy's settings read.\n            profile: accountId ? { fullName: displayName, firstName: null, email: null, imageUrl: null } : null,\n        }),\n        [accountId, learner, displayName]\n    )\n    // Native actions Academy's pages ask the host for: sign-out ends the\n    // learner session in the core; print opens the native print sheet; the\n    // avatar is chosen, checked and uploaded natively and read back as a\n    // data URL (this WebView loads no remote images).\n    const onSignOut = useCallback(() => void client.dispatch({ kind: 'signOutAcademy' }).catch(() => undefined), [client])\n    const onPrint = useCallback(() => hostAction(client, { kind: 'printPage', learner }), [client, learner])\n    const onUploadAvatar = useCallback(() => hostAction(client, { kind: 'uploadAvatar', learner }), [client, learner])\n    const loadImage = useCallback(\n        (url: string) => loadAcademyImage(client, { kind: 'loadAcademyImage', learner, url }),\n        [client, learner]\n    )\n    // Lab work Academy has not confirmed is sealed in the core for this\n    // account (signed in only); the core never sends it by itself.\n    const localDrafts = useMemo(\n        () => (accountId === null ? undefined : nativeLocalDrafts(client, learner)),\n        [client, learner, accountId]\n    )\n    useEffect(() => () => queryClient.clear(), [queryClient])\n    return (\n        <QueryClientProvider client={queryClient}>\n            <TrpcContext.Provider value={trpc}>\n                <LearnerHost\n                    links={links}\n                    queryClient={queryClient}\n                    identity={identity}\n                    theme={theme}\n                    labs='desktop'\n                    diagrams='prerendered'\n                    webOrigin={webOrigin}\n                    onSignOut={onSignOut}\n                    onPrint={onPrint}\n                    remoteImages={false}\n                    loadImage={loadImage}\n                    avatarUpload={accountId !== null}\n                    onUploadAvatar={onUploadAvatar}\n                    appearance='host'\n                    assessorTools={false}\n                    awardPresenters={false}\n                    courseReset\n                    lessonFeedback\n                    localDrafts={localDrafts}\n                >\n                    {children}\n                </LearnerHost>\n            </TrpcContext.Provider>\n        </QueryClientProvider>\n    )\n}\n\nexport function LearnerProvider(props: Props) {\n    // Keyed by generation: query observers bind to the client they first\n    // saw, so the learner subtree remounts and keeps nothing from the\n    // previous account.\n    return <Generation key={props.learner} {...props} />\n}\n@import 'tailwindcss';\n@import './styles/tokens.css';\n\n/* Self-hosted fonts: the packaged CSP allows only bundled font files. */\n@import '@fontsource-variable/inter/index.css';\n@import '@fontsource-variable/jetbrains-mono/index.css';\n\n/* Academy-owned shared presentation (ADR 0002): general tokens and themes,\n * the base focus ring/interaction helpers, and the Tailwind token layer.\n * Earned Academy skins are gamification and are not imported here. */\n@import '@ai-security-academy/presentation/tokens.css';\n@import '@ai-security-academy/presentation/base.css';\n@import '@ai-security-academy/presentation/theme.css';\n\n@source '../node_modules/@ai-security-academy/presentation/src';\n\n/* Academy's learner experience (C05): its reading styles and motion, and the\n * Academy source its pages are built from (for utility classes). Caveat is\n * the lab marginalia hand. Earned Academy skins are not imported. */\n@import '@fontsource-variable/inter/wght-italic.css';\n@import '@fontsource-variable/jetbrains-mono/wght-italic.css';\n@import '@fontsource-variable/caveat/index.css';\n@import '../../../.work/academy/src/styles/animations.css';\n@import '../../../.work/academy/src/styles/learner.css';\n@source '../../../.work/academy/src/features';\n@source '../../../.work/academy/src/components';\n@source '../../../.work/academy/packages/learner/src';\n\n/* The shared frame scrolls the document under a sticky 56px topbar and a\n * fixed 60px decorative bottom fade. Focused controls scrolled into view stay\n * clear of both, including at 200% zoom (C01-N10). */\nhtml {\n    scroll-padding-top: 72px;\n    scroll-padding-bottom: 76px;\n}\n\n/* Tailwind's reset strips form controls to bare text, so a field written\n * without classes had no visible edge (C26 installed acceptance F04). Every\n * text field, select and text area gets a visible box at zero specificity:\n * any utility class on a control still wins. The border meets the 3:1\n * non-text contrast floor in both themes. */\n@layer base {\n    :where(input:not([type='radio'], [type='checkbox'], [type='range'], [type='file'], [type='hidden']), select, textarea) {\n        border: 1px solid var(--academy-ink-faint);\n        border-radius: var(--academy-radius-md);\n        background: var(--academy-paper);\n        color: var(--academy-ink);\n        padding: 0.5rem 0.75rem;\n        min-height: 2.25rem;\n    }\n\n    :where(input, select, textarea):disabled {\n        opacity: 0.6;\n    }\n}\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_41","type":"command_execution","command":"/bin/zsh -lc \"sed -n '1,190p' tools/p10/review_gate.py; cat crates/xtask/src/subject.rs; cat apps/desktop/src/contracts/refinement-contract.test.ts\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_41","type":"command_execution","command":"/bin/zsh -lc \"sed -n '1,190p' tools/p10/review_gate.py; cat crates/xtask/src/subject.rs; cat apps/desktop/src/contracts/refinement-contract.test.ts\"","aggregated_output":"\"\"\"Read-only actual-review proof checks for C45/P10 and production prerequisites.\n\nNo score assignment, evidence execution, controller completion or release action.\n\"\"\"\nfrom pathlib import Path\nimport json\nimport sys\n\nsys.path.insert(0, str(Path(__file__).resolve().parent))\nsys.path.insert(0, str(Path(__file__).resolve().parents[1] / \"p09\"))\nfrom phase_packet import file_identity, digest, validate\nfrom phase_inputs import full_gate, require, read, sha, REVIEW_DISABLED\n\n\ndef transport(root, out, request):\n    invocation = read(out/\"invocation.json\")\n    require(invocation[\"request_sha256\"] == sha(out/\"request.json\"), \"transport request drift\")\n    schema_path = root/request.get(\"schema_archive\", \"docs/architecture/review-verdict.schema.json\")\n    require(invocation[\"schema_sha256\"] == sha(schema_path), \"transport schema drift\")\n    args = invocation[\"command_without_prompt\"]\n    require(args[0] == \"codex\" and args.count(\"exec\") == 1, \"not fresh Codex exec\")\n    for flag in [\"--no-daemon\", \"--ephemeral\", \"--ignore-user-config\", \"--ignore-rules\", \"--json\"]:\n        require(args.count(flag) == 1, \"transport isolation \" + flag)\n    for flag, value in [(\"-a\", \"never\"), (\"-s\", \"read-only\"), (\"-m\", \"gpt-6.1-sol\")]:\n        require(args.count(flag) == 1 and args[args.index(flag)+1] == value, \"transport isolation argument \" + flag)\n    require(args.count(\"--output-schema\") == 1 and args[args.index(\"--output-schema\")+1] == \"docs/architecture/review-verdict.schema.json\", \"transport output schema\")\n    expected_out = Path(request.get(\"execution_root\", root))/\"docs/planning/reviews\"/request[\"subject\"]/request[\"attempt_id\"]/\"verdict-returned.json\"\n    require(args.count(\"-o\") == 1 and args[args.index(\"-o\")+1] == str(expected_out), \"transport output path\")\n    require(invocation[\"model_requested\"] == \"gpt-6.1-sol\", \"configured review model changed\")\n    require(not any(\"dangerously\" in arg or arg in [\"resume\", \"fork\", \"--last\", \"--approve-for-me\"] for arg in args), \"review resume/bypass\")\n    disabled = [args[i+1] for i,a in enumerate(args) if a == \"--disable\"]\n    require(set(disabled) == REVIEW_DISABLED and len(disabled) == len(REVIEW_DISABLED), \"restricted review features\")\n    overrides = [args[i+1] for i,a in enumerate(args) if a == \"-c\"]\n    require(set(overrides) == {'web_search=\"disabled\"', 'model_reasoning_effort=\"xhigh\"'} and len(overrides) == 2, \"review overrides\")\n    require(invocation[\"feature_probe_sha256\"] == sha(out/\"feature-probe.log\"), \"feature probe drift\")\n    observed = {line.split()[0]:line.split()[-1] for line in (out/\"feature-probe.log\").read_text().splitlines() if len(line.split()) >= 3}\n    require(all(observed.get(k) == invocation[\"restricted_features_observed\"].get(k) == \"false\" for k in REVIEW_DISABLED), \"feature isolation not observed\")\n    messages=[];sessions=[]\n    for line in (out/\"thread-reply.log\").read_text().splitlines():\n        try:event=json.loads(line)\n        except json.JSONDecodeError:continue\n        if not isinstance(event,dict):continue\n        item=event.get(\"item\",{})\n        if not isinstance(item,dict):item={}\n        require(event.get(\"type\") not in [\"hook.started\",\"hook.completed\"] and item.get(\"type\") not in [\"mcp_tool_call\",\"hook_execution\"], \"unexpected review side effect\")\n        if event.get(\"type\") == \"thread.started\":sessions.append(event.get(\"thread_id\"))\n        if event.get(\"type\") == \"item.completed\" and item.get(\"type\") in [\"agent_message\",\"assistant_message\"]:messages.append(item.get(\"text\",\"\"))\n    require(len(sessions) == 1 and messages and json.loads(messages[-1]) == read(out/\"verdict-returned.json\"), \"actual independent returned verdict missing/mismatched\")\n    return dict(invocation_sha256=sha(out/\"invocation.json\"),thread_reply_sha256=sha(out/\"thread-reply.log\"),feature_probe_sha256=sha(out/\"feature-probe.log\"),reviewer_sessions_observed=sessions)\n\n\ndef actual_review(root, subject, attempt, source_root=None, evidence=True):\n    out=root/\"docs/planning/reviews\"/subject/attempt\n    request=read(out/\"request.json\"); verdict=read(out/\"verdict-returned.json\")\n    schema_path=(root/request[\"schema_archive\"] if request.get(\"schema_archive\")\n                 else (source_root or root)/\"docs/architecture/review-verdict.schema.json\")\n    # Historical P09 schema is preserved independently of future descriptions.\n    if subject == \"P09\":schema_path=root/\"docs/planning/evidence/C45/activation-20261102-g11/p09-source/docs/architecture/review-verdict.schema.json\"\n    validate(verdict,read(schema_path))\n    require(verdict[\"subject\"] == subject and request[\"subject\"] == subject and verdict[\"attempt_id\"] == request[\"attempt_id\"] == attempt and verdict[\"request_id\"] == request[\"request_id\"] and verdict[\"fingerprints\"] == request[\"fingerprints\"], \"actual verdict request/fingerprint binding\")\n    full_gate(verdict)\n    # Preserve request bytes: the archive path is verification context, never an edit.\n    transport_request=dict(request)\n    # A later schema description must not change an archived review's input.\n    # Supply verification context only; request/invocation bytes stay immutable.\n    if source_root is not None:\n        transport_request[\"schema_archive\"]=str(schema_path.relative_to(root))\n    if subject == \"P09\":\n        transport_request[\"schema_archive\"]=str(schema_path.relative_to(root))\n        transport_request[\"execution_root\"]=read(root/\"docs/planning/evidence/C45/activation-20261102-g11/p09-proof.json\")[\"source_checkout\"]\n    observed=transport(root,out,transport_request)\n    audit=read(out/\"post-review-audit.json\");receipt=read(out/\"receipt.json\")\n    require(audit[\"full_gate_pass\"] is True and receipt[\"full_gate_pass\"] is True and receipt[\"source_frozen\"] is True, \"actual full-gate audit missing\")\n    for record in [audit,receipt]:\n        require(record[\"request_sha256\"] == sha(out/\"request.json\") and record.get(\"raw_verdict_sha256\",record.get(\"verdict_sha256\")) == sha(out/\"verdict-returned.json\") and record[\"scores\"] == verdict[\"scores\"], \"review audit/receipt binding\")\n    require(receipt[\"post_review_audit_sha256\"] == sha(out/\"post-review-audit.json\") and receipt[\"fingerprints\"] == verdict[\"fingerprints\"], \"receipt audit/fingerprints\")\n    require(receipt[\"invocation_sha256\"] == observed[\"invocation_sha256\"] and receipt[\"thread_reply_sha256\"] == observed[\"thread_reply_sha256\"], \"receipt transport binding\")\n    for name,key,base in [(\"source-inventory.json\",\"source\",source_root or root),(\"evidence-inventory.json\",\"evidence\",root)]:\n        inventory=read(out/name)[\"files\"]\n        require(digest(inventory) == request[\"fingerprints\"][key], \"inventory fingerprint mismatch\")\n        if evidence or key == \"source\":\n            locations = read(root/\"docs/planning/evidence/C45/activation-20261102-g11/p09-extra-evidence/locations.json\") if subject == \"P09\" and key == \"evidence\" else {}\n            for relative,identity in inventory.items():\n                path = root/locations[relative] if relative in locations else base/relative\n                require(file_identity(path) == identity, \"reviewed input drift: \" + relative)\n    return dict(subject=subject,attempt=attempt,request_sha256=sha(out/\"request.json\"),verdict_sha256=sha(out/\"verdict-returned.json\"),audit_sha256=sha(out/\"post-review-audit.json\"),receipt_sha256=sha(out/\"receipt.json\"),scores=verdict[\"scores\"],fingerprints=verdict[\"fingerprints\"])\n\n\ndef release_prerequisites(root):\n    archive=root/\"docs/planning/evidence/C45/activation-20261102-g11/p09-source\"\n    p09=actual_review(root,\"P09\",\"attempt-02\",archive)\n    standing=read(root/\"docs/planning/evidence/P10/completion-proof.json\")\n    require(standing[\"schema\"] == \"airs-desktop/p10-completion-proof/1\" and standing[\"p09\"] == p09,\"P09 prerequisite binding\")\n    # P10's exact reviewed source is archived on completion. Later C26 release\n    # implementation gets its own checks/review; it does not relabel P10 inputs.\n    archived=root/standing[\"source_archive\"]\n    require(archived.resolve().is_relative_to((root/\"docs/planning/evidence/P10\").resolve()),\"P10 archive escapes evidence\")\n    p10=actual_review(root,\"P10\",standing[\"attempt\"],archived)\n    require(standing[\"p10\"] == p10,\"P10 completion proof binding\")\n    c45=actual_review(root,\"C45\",standing[\"c45\"][\"attempt\"],root/standing[\"c45_source_archive\"])\n    require(standing[\"c45\"] == c45,\"C45 member proof binding\")\n    from packet import qualification\n    from historical import Historical\n    historical=Historical(root,standing[\"historical_context\"])\n    qualified=qualification(root,root/standing[\"qualification\"][\"record\"],current=False,historical=historical)\n    request=read(root/\"docs/planning/reviews/P10\"/standing[\"attempt\"]/\"request.json\")\n    require(qualified == standing[\"qualification\"] == request[\"qualification\"] and request[\"predecessors\"][\"C45\"] == c45,\"P10 qualified candidate/member binding\")\n    return {\"p09\":p09,\"p10\":p10,\"c45\":c45,\"controller_complete\":False,\"c26_required_here\":False}\n\n\nif __name__ == \"__main__\":\n    require(len(sys.argv) == 2 and sys.argv[1] == \"release-prerequisites\", \"usage: review_gate.py release-prerequisites\")\n    print(json.dumps(release_prerequisites(Path.cwd().resolve()),indent=2))\n//! Validated review subjects through the P11 refinement phase (D063).\n\nuse std::fmt;\n\nuse crate::{Result, invalid};\n\n#[derive(Clone, Copy, Debug, PartialEq, Eq, Hash, PartialOrd, Ord)]\npub enum Subject {\n    Chunk(u8),\n    Phase(u8),\n}\n\nimpl Subject {\n    /// The last registered chunk and phase (checks.json must define exactly these).\n    pub const LAST_CHUNK: u8 = 49;\n    pub const LAST_PHASE: u8 = 11;\n    /// D058: the documentation-only chunks. Fixed in code so the policy (no\n    /// native gate, no owner acceptance below 9/10) cannot be switched on for\n    /// an application chunk or off for the specification from a manifest.\n    pub const DOCS_ONLY_CHUNKS: &'static [u8] = &[27];\n\n    /// Whether this subject is a documentation-only chunk (D058).\n    pub fn is_docs_only(self) -> bool {\n        matches!(self, Self::Chunk(n) if Self::DOCS_ONLY_CHUNKS.contains(&n))\n    }\n\n    pub fn parse(text: &str) -> Result<Self> {\n        let parse_num = |digits: &str, max: u8| -> Option<u8> {\n            (digits.len() == 2 && digits.bytes().all(|b| b.is_ascii_digit()))\n                .then(|| digits.parse::<u8>().ok())\n                .flatten()\n                .filter(|n| (1..=max).contains(n))\n        };\n        if let Some(n) = text\n            .strip_prefix('C')\n            .and_then(|rest| parse_num(rest, Self::LAST_CHUNK))\n        {\n            return Ok(Self::Chunk(n));\n        }\n        if let Some(n) = text\n            .strip_prefix('P')\n            .and_then(|rest| parse_num(rest, Self::LAST_PHASE))\n        {\n            return Ok(Self::Phase(n));\n        }\n        Err(invalid(format!(\n            \"not a valid chunk (C01-C49) or phase (P01-P11): {text:?}\"\n        )))\n    }\n\n    pub fn is_phase(self) -> bool {\n        matches!(self, Self::Phase(_))\n    }\n}\n\nimpl fmt::Display for Subject {\n    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {\n        match self {\n            Self::Chunk(n) => write!(f, \"C{n:02}\"),\n            Self::Phase(n) => write!(f, \"P{n:02}\"),\n        }\n    }\n}\n\n#[cfg(test)]\nmod tests {\n    use super::Subject;\n\n    #[test]\n    fn accepts_registered_range_only() {\n        assert_eq!(Subject::parse(\"C01\").expect(\"C01\"), Subject::Chunk(1));\n        assert_eq!(Subject::parse(\"C26\").expect(\"C26\"), Subject::Chunk(26));\n        assert_eq!(Subject::parse(\"C27\").expect(\"C27\"), Subject::Chunk(27));\n        assert_eq!(Subject::parse(\"C34\").expect(\"C34\"), Subject::Chunk(34));\n        assert_eq!(Subject::parse(\"C44\").expect(\"C44\"), Subject::Chunk(44));\n        assert_eq!(Subject::parse(\"C45\").expect(\"C45\"), Subject::Chunk(45));\n        assert_eq!(Subject::parse(\"C49\").expect(\"C49\"), Subject::Chunk(49));\n        assert_eq!(Subject::parse(\"P11\").expect(\"P11\"), Subject::Phase(11));\n        assert_eq!(Subject::parse(\"P10\").expect(\"P10\"), Subject::Phase(10));\n        assert_eq!(Subject::parse(\"P08\").expect(\"P08\"), Subject::Phase(8));\n        assert_eq!(Subject::parse(\"P09\").expect(\"P09\"), Subject::Phase(9));\n        for bad in [\"C00\", \"C50\", \"P00\", \"P12\", \"C7\", \"C027\", \"c27\", \"X01\"] {\n            assert!(Subject::parse(bad).is_err(), \"{bad} must be refused\");\n        }\n        assert_eq!(Subject::Chunk(34).to_string(), \"C34\");\n        assert_eq!(Subject::Phase(9).to_string(), \"P09\");\n    }\n\n    #[test]\n    fn only_the_specification_chunk_is_documentation_only() {\n        assert!(Subject::Chunk(27).is_docs_only());\n        for other in [\n            Subject::Chunk(1),\n            Subject::Chunk(26),\n            Subject::Chunk(28),\n            Subject::Chunk(34),\n            Subject::Phase(9),\n        ] {\n            assert!(!other.is_docs_only(), \"{other}\");\n        }\n    }\n}\nimport { describe, expect, it } from 'vitest'\nimport { ContractViolation, parseShellSnapshot } from '@prisma-airs/desktop-contracts'\nimport { baseSnapshot, tenant } from '../test/native'\n\ndescribe('refinement native contract', () => {\n    it('accepts only the paired host color-theme values', () => {\n        expect(parseShellSnapshot({ ...baseSnapshot, colorTheme: 'prismaAirs' }).colorTheme).toBe('prismaAirs')\n        expect(parseShellSnapshot({ ...baseSnapshot, colorTheme: 'gruvbox' }).colorTheme).toBe('gruvbox')\n        for (const colorTheme of [undefined, null, 'future-theme', {}, 1]) {\n            expect(() => parseShellSnapshot({ ...baseSnapshot, colorTheme })).toThrow(ContractViolation)\n        }\n    })\n    it('requires a real boolean for the native-owned management requirement', () => {\n        const setup = {\n            mode: 'add', context: 'cx-draft', tenant: tenant(), products: ['runtimeSecurity'],\n            scanRequired: false, managementRequired: true, packs: [], workspace: null,\n            verify: null, completable: false,\n        }\n        expect(parseShellSnapshot({ ...baseSnapshot, setup }).setup?.managementRequired).toBe(true)\n        for (const managementRequired of [undefined, null, 'true', {}, 1]) {\n            expect(() => parseShellSnapshot({ ...baseSnapshot, setup: { ...setup, managementRequired } })).toThrow(ContractViolation)\n        }\n    })\n})\n","exit_code":0,"status":"completed"}}
