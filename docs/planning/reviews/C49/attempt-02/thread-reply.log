{"type":"item.completed","item":{"id":"item_19","type":"command_execution","command":"/bin/zsh -lc 'cat apps/desktop/src/styles/tokens.css'","aggregated_output":"/*\n * Desktop tokens: independent palette family and light/dark appearance.\n * Light/dark mode and the selected family paint --v2-* tokens. Root\n * data-theme keeps Academy's existing general palette. Shared controls\n * receive desktop aliases only inside explicit data-desktop-theme scopes.\n */\n:root {\n    --v2-color-scheme: light;\n    --v2-bg: #f5f6f8;\n    --v2-side: #eef0f3;\n    --v2-paper: #ffffff;\n    --v2-inset: #e9edf2;\n    --v2-rule: #d4d9e1;\n    --v2-ctl: #7b8494;\n    --v2-ink: #17212f;\n    --v2-soft: #435166;\n    --v2-faint: #5c687b;\n    --v2-acc: #b83b16;\n    --v2-acc-ink: #ffffff;\n    --v2-acc-soft: #fce6de;\n    --v2-block: #b42318;\n    --v2-block-bg: #fbe4e1;\n    --v2-flag: #815200;\n    --v2-flag-bg: #fff0c9;\n    --v2-ok: #1a6b40;\n    --v2-ok-bg: #def3e6;\n    --v2-sel: var(--v2-acc);\n    --v2-sel-ink: var(--v2-acc-ink);\n    --v2-get: #245e8f;\n\n    --v2-page-top: 32px;\n    --v2-page-x: 44px;\n    --v2-title: 26px;\n    --v2-card-pad: 20px;\n    /* Grid and card gaps (the prototype's 16–20px; 12px is only inside rows). */\n    --v2-gap: 16px;\n    --v2-gap-row: 12px;\n    /* The prototype's base text is 13px; 14px is the subtitle size. */\n    --v2-text: 13px;\n    --v2-text-1: 14px;\n    --v2-text-2: 12px;\n    --v2-h2: 13px;\n    --v2-control: 32px;\n    --v2-radius-control: 7px;\n    --v2-radius-card: 12px;\n    --v2-rail: 244px;\n    --v2-header: 56px;\n    --v2-reading: 860px;\n    /* Overlay widths (R2App): tenant menu, palette, review sheet, detail sheet, dialogs. */\n    --v2-menu: 360px;\n    --v2-palette: 640px;\n    --v2-sheet: 620px;\n    --v2-detail: 520px;\n    --v2-dialog: 560px;\n    --v2-scrim: rgba(0, 0, 0, 0.22);\n    --v2-scrim-deep: rgba(0, 0, 0, 0.34);\n}\n\n:root[data-appearance='dark'] {\n    --v2-color-scheme: dark;\n    --v2-bg: #151b25;\n    --v2-side: #101620;\n    --v2-paper: #1e2734;\n    --v2-inset: #263243;\n    --v2-rule: #37465b;\n    --v2-ctl: #8190a5;\n    --v2-ink: #f0f3f8;\n    --v2-soft: #c7d0dd;\n    --v2-faint: #aab8cb;\n    --v2-acc: #ff9a70;\n    --v2-acc-ink: #26190f;\n    --v2-acc-soft: #4b2e25;\n    --v2-block: #ff9b94;\n    --v2-block-bg: #492a31;\n    --v2-flag: #f7c567;\n    --v2-flag-bg: #40351e;\n    --v2-ok: #8ddbb1;\n    --v2-ok-bg: #1a3d32;\n    --v2-get: #8cc8ff;\n}\n\n:root[data-color-theme='gruvbox'][data-appearance='light'] {\n    --v2-color-scheme: light;\n    --v2-bg: #fbf1c7;\n    --v2-side: #f2e5bc;\n    --v2-paper: #fff8df;\n    --v2-inset: #ebdbb2;\n    --v2-rule: #d5c4a1;\n    --v2-ctl: #85745b;\n    --v2-ink: #282828;\n    --v2-soft: #504945;\n    --v2-faint: #665c54;\n    --v2-acc: #a3390c;\n    --v2-acc-ink: #ffffff;\n    --v2-acc-soft: #f5d7ac;\n    --v2-block: #9d201b;\n    --v2-block-bg: #f8d7c3;\n    --v2-flag: #785500;\n    --v2-flag-bg: #f5e4a9;\n    --v2-ok: #426421;\n    --v2-ok-bg: #e3ebbb;\n    --v2-get: #076678;\n}\n\n:root[data-color-theme='gruvbox'][data-appearance='dark'] {\n    --v2-color-scheme: dark;\n    --v2-bg: #1d2021;\n    --v2-side: #161919;\n    --v2-paper: #282828;\n    --v2-inset: #32302f;\n    --v2-rule: #3c3836;\n    --v2-ctl: #8a7f70;\n    --v2-ink: #ebdbb2;\n    --v2-soft: #d5c4a1;\n    --v2-faint: #bdae93;\n    --v2-acc: #fe8019;\n    --v2-acc-ink: #1d2021;\n    --v2-acc-soft: #4a2f1a;\n    --v2-block: #ff6b57;\n    --v2-block-bg: #3d1f1c;\n    --v2-flag: #fabd2f;\n    --v2-flag-bg: #3a3019;\n    --v2-ok: #b8bb26;\n    --v2-ok-bg: #2b2f17;\n    --v2-get: #83a598;\n}\n\n/* The v2 shell root: body background, type and the visible focus ring\n * (invariant: accent-colour ring on every focusable control; inset variant\n * where a control declares it). */\n[data-v2-shell] {\n    background: var(--v2-bg);\n    color: var(--v2-ink);\n    font-size: var(--v2-text);\n    font-family: -apple-system, BlinkMacSystemFont, 'SF Pro Text', system-ui, sans-serif;\n    min-height: 100vh;\n}\n/* The destination heading takes focus after navigation for assistive technology; it is not a control, so no ring (C35). */\n[data-v2-shell] h1[tabindex='-1']:focus {\n    outline: none;\n}\n/* A page inside the shell's main region: the prototype's 32/44 margins, scrolling by itself. */\n[data-v2-shell] [data-v2-page] {\n    padding: var(--v2-page-top) var(--v2-page-x) 28px;\n    overflow-y: auto;\n    min-height: 0;\n    flex-grow: 1;\n    min-width: 0;\n}\n/* Shell ancestry includes Academy; desktop control styling needs ownership. */\n[data-desktop-theme] :focus-visible {\n    outline: 2px solid var(--v2-acc);\n    outline-offset: 2px;\n}\n[data-desktop-theme] [data-inset-focus]:focus-visible {\n    outline-offset: -4px;\n}\n[data-desktop-theme] input,\n[data-desktop-theme] select,\n[data-desktop-theme] textarea {\n    border: 1px solid var(--v2-ctl);\n    border-radius: var(--v2-radius-control);\n    background: var(--v2-bg);\n    color: var(--v2-ink);\n    min-height: var(--v2-control);\n}\n/* Rail collapses to icons below 1280 CSS px; nothing scrolls horizontally. */\n[data-v2-shell] {\n    overflow-x: hidden;\n}\n@media (max-width: 1279px) {\n    [data-v2-rail] {\n        width: 64px !important;\n    }\n    /* Collapsed: one 32px control per row; icons stay, labels leave the\n     * layout but stay in the accessible name. */\n    [data-v2-rail] [data-v2-stack] {\n        flex-direction: column;\n        align-items: stretch;\n    }\n    [data-v2-rail] [data-v2-stack] > * {\n        width: 100%;\n    }\n    /* Collapsed: labels leave the layout but stay in the accessible name (rail and header). */\n    [data-v2-rail] [data-v2-label],\n    [data-v2-header] [data-v2-label] {\n        position: absolute;\n        width: 1px;\n        height: 1px;\n        overflow: hidden;\n        clip: rect(0 0 0 0);\n        white-space: nowrap;\n    }\n    /* Collapsed: the product children and the status rows leave the rail (C35). */\n    [data-v2-rail] [data-v2-collapse] {\n        display: none !important;\n    }\n    [data-v2-rail] [data-v2-stack] > * {\n        padding-left: 0 !important;\n        padding-right: 0 !important;\n    }\n    [data-v2-header] [data-v2-search] {\n        width: auto !important;\n        flex: 1 1 120px !important;\n        min-width: 0;\n    }\n    /* The Harness's rail and Decisions aside stack above and below the transcript when the page is narrow (C38).\n       Wide, the columns are one flex line bounded by the page, so each column scrolls on its own. */\n    [data-v2-shell] [data-slot='harness-columns'] {\n        flex-wrap: wrap;\n    }\n    [data-v2-shell] [data-slot='harness-rail'],\n    [data-v2-shell] [data-slot='harness-decisions'] {\n        flex: 1 1 100% !important;\n        border-left: 0 !important;\n        border-right: 0 !important;\n        border-bottom: 1px solid var(--v2-rule);\n    }\n    /* Home's attention and quick-action sections stack when the page is narrow (C36). */\n    [data-v2-shell] [data-slot='home-lower'] {\n        grid-template-columns: minmax(0, 1fr) !important;\n    }\n}\n/* The Harness composer is one pill: the ring is the pill's when its box is typed in (C38). */\n[data-v2-shell] [data-slot='harness-composer']:focus-within {\n    outline: 2px solid var(--v2-acc);\n    outline-offset: 1px;\n}\n[data-v2-shell] [data-slot='harness-composer'] textarea:focus-visible {\n    outline: none;\n}\n/* The selected sidebar destination is accent-filled, so its ring is the\n * ink-on-accent colour; every other control keeps the accent ring, including\n * a current link on an accent-soft surface (the Academy's section links: the\n * accent is 5.05:1 on the light soft surface and 4.86:1 on the dark one, where\n * the ink-on-accent colour was 1.06:1 and 1.11:1). */\n[data-desktop-theme] [data-inset-focus][aria-current='page']:focus-visible {\n    outline-color: var(--v2-sel-ink);\n}\n[data-v2-shell] [data-v2-scrim] {\n    background: var(--v2-scrim);\n}\n@media (prefers-reduced-motion: reduce) {\n    [data-v2-shell] * {\n        transition: none !important;\n        animation: none !important;\n    }\n}\n\n/* C41 API Client: the pretty JSON view numbers its lines from a counter (the numbers are not part of the body's text). */\n[data-v2-shell] [data-slot='json-lines'] {\n    counter-reset: line;\n    white-space: pre;\n}\n[data-v2-shell] [data-slot='json-lines'] > [data-line]::before {\n    counter-increment: line;\n    content: counter(line);\n    display: inline-block;\n    width: 34px;\n    padding-right: 12px;\n    text-align: right;\n    color: var(--v2-faint);\n}\n/* The request's columns and the response pane stack below the width that fits them (the prototype is fixed-width). */\n@media (max-width: 1180px) {\n    [data-v2-shell] [data-slot='workbench-columns'] {\n        flex-wrap: wrap;\n    }\n    [data-v2-shell] [data-slot='workbench-response-pane'] {\n        flex: 1 1 100% !important;\n        max-width: none !important;\n        border-top: 1px solid var(--v2-rule);\n    }\n}\n/* The wizard's product cards (C43): the card is a label around a visually hidden native checkbox; the card shows\n   the control's focus ring and its chosen state. */\n[data-slot='product-card']:has(> input:focus-visible) {\n    outline: 2px solid var(--v2-acc);\n    outline-offset: 2px;\n}\n/* The wizard (C43) below 760px (a 900-point window at 200%): the rail is a compact strip above the step (the step\n   marks keep their names for assistive technology but show their numbers), every grid is one column, and the step\n   scrolls between the strip and the pinned footer. */\n@media (max-width: 760px) {\n    [data-v2-shell] [data-slot='wizard'],\n    [data-slot='wizard'] {\n        flex-direction: column;\n    }\n    [data-slot='wizard'] > nav {\n        width: 100% !important;\n        flex: 0 0 auto;\n        padding: 10px 12px 8px !important;\n        border-right: 0 !important;\n        border-bottom: 1px solid var(--v2-rule);\n    }\n    [data-slot='wizard'] > nav > div:first-child {\n        margin-bottom: 8px !important;\n    }\n    [data-slot='wizard'] > nav > ol {\n        flex-direction: row;\n        flex-wrap: wrap;\n        gap: 4px !important;\n    }\n    [data-slot='wizard'] > nav > ol button {\n        width: auto;\n        height: 32px !important;\n        padding: 0 6px !important;\n        gap: 0 !important;\n    }\n    [data-slot='wizard'] > nav > ol button > span:not(:first-child) {\n        position: absolute;\n        width: 1px;\n        height: 1px;\n        overflow: hidden;\n        clip: rect(0 0 0 0);\n        white-space: nowrap;\n    }\n    [data-slot='wizard'] > nav > [data-slot='privacy-note'] {\n        display: none;\n    }\n    [data-slot='wizard'] > nav > [data-slot='theme-button'] {\n        margin-top: 6px !important;\n    }\n    [data-slot='wizard'] main .grid {\n        grid-template-columns: minmax(0, 1fr) !important;\n    }\n    /* The strip drops the brand row (the sheet is already named), and the footer's hint or status keeps to two\n       lines: at 900×600 and 200% the add sheet is 279 CSS px tall, and a long hint made the footer taller than the\n       sheet, pushing its primary below the window. */\n    [data-slot='wizard'] > nav > div:first-child {\n        display: none;\n    }\n    [data-slot='wizard-footer'] [data-slot='wizard-status'] > span {\n        display: -webkit-box;\n        -webkit-line-clamp: 2;\n        -webkit-box-orient: vertical;\n        overflow: hidden;\n    }\n}\n@media (max-width: 1279px) {\n    [data-v2-rail] {\n        width: 64px !important;\n    }\n    /* Collapsed: one 32px control per row; icons stay, labels leave the\n     * layout but stay in the accessible name. */\n    [data-v2-rail] [data-v2-stack] {\n        flex-direction: column;\n        align-items: stretch;\n    }\n    [data-v2-rail] [data-v2-stack] > * {\n        width: 100%;\n    }\n    /* Collapsed: labels leave the layout but stay in the accessible name (rail and header). */\n    [data-v2-rail] [data-v2-label],\n    [data-v2-header] [data-v2-label] {\n        position: absolute;\n        width: 1px;\n        height: 1px;\n        overflow: hidden;\n        clip: rect(0 0 0 0);\n        white-space: nowrap;\n    }\n    /* Collapsed: the product children and the status rows leave the rail (C35). */\n    [data-v2-rail] [data-v2-collapse] {\n        display: none !important;\n    }\n    [data-v2-rail] [data-v2-stack] > * {\n        padding-left: 0 !important;\n        padding-right: 0 !important;\n    }\n    [data-v2-header] [data-v2-search] {\n        width: auto !important;\n        flex: 1 1 120px !important;\n        min-width: 0;\n    }\n    /* The Harness's rail and Decisions aside stack above and below the transcript when the page is narrow (C38).\n       Wide, the columns are one flex line bounded by the page, so each column scrolls on its own. */\n    [data-v2-shell] [data-slot='harness-columns'] {\n        flex-wrap: wrap;\n    }\n    [data-v2-shell] [data-slot='harness-rail'],\n    [data-v2-shell] [data-slot='harness-decisions'] {\n        flex: 1 1 100% !important;\n        border-left: 0 !important;\n        border-right: 0 !important;\n        border-bottom: 1px solid var(--v2-rule);\n    }\n    /* Home's attention and quick-action sections stack when the page is narrow (C36). */\n    [data-v2-shell] [data-slot='home-lower'] {\n        grid-template-columns: minmax(0, 1fr) !important;\n    }\n    /* The Inbox's list and detail cards stack when the page is narrow (C37): each card takes its\n       own height (the list up to half the viewport, scrolling inside) and the page scrolls. */\n    [data-v2-shell] [data-slot='inbox-columns'] {\n        grid-template-columns: minmax(0, 1fr) !important;\n        grid-template-rows: auto auto;\n        min-height: auto !important;\n        flex-grow: 0 !important;\n    }\n    [data-v2-shell] [data-slot='inbox-list'] {\n        min-height: 240px;\n        max-height: 50vh;\n    }\n}\n/* C39a attempt-01 R1: below the width that fits the inventory's columns (900×600 at 200% is 450 CSS px) the rows stack their cells. */\n@media (max-width: 760px) {\n    [data-v2-shell] [data-slot='administration-row'] {\n        grid-template-columns: minmax(0, 1fr) !important;\n        gap: 4px !important;\n    }\n    /* The header row leaves the picture but not the accessibility tree; each stacked cell shows its column's\n       name (C39b attempt-01 R4). */\n    [data-v2-shell] [data-slot='administration-table'] > [role='row']:first-child {\n        position: absolute;\n        width: 1px;\n        height: 1px;\n        overflow: hidden;\n        clip: rect(0 0 0 0);\n        white-space: nowrap;\n    }\n    [data-v2-shell] [data-slot='administration-row'] > [role='cell'][data-label]::before {\n        content: attr(data-label) ': ';\n        font-weight: 600;\n        color: var(--v2-faint);\n    }\n    [data-v2-shell] [data-slot='administration-row'] > [role='cell']:last-child {\n        justify-content: flex-start;\n    }\n}\n/* C39b attempt-01: below the width that fits a table's columns (900×600 at 200% is 450 CSS px) the v2 admin tables stack their cells and hide the header row. */\n@media (max-width: 760px) {\n    [data-v2-shell] [data-slot='admin-tab'] [role='table'] > [role='row'] {\n        grid-template-columns: minmax(0, 1fr) !important;\n        gap: 4px !important;\n    }\n    [data-v2-shell] [data-slot='admin-tab'] [role='table'] > [role='row']:first-child {\n        display: none;\n    }\n    [data-v2-shell] [data-slot='admin-tab'] [role='table'] [role='cell'] {\n        white-space: normal;\n    }\n}\n/* Narrower still (a 900-point window at 200%): the request tree sits above the editor instead of beside it. */\n@media (max-width: 760px) {\n    [data-v2-shell] [data-slot='api-body'] {\n        flex-wrap: wrap;\n    }\n    [data-v2-shell] [data-slot='request-tree'] {\n        width: 100% !important;\n        max-height: 40vh;\n        border-right: 0 !important;\n        border-bottom: 1px solid var(--v2-rule);\n    }\n}\n/* Test Cases (C40): below 760px (a 900-point window at 200%) each row is two lines: the case and its product, the\n   input, then the result and the action; the five-column grid cannot hold readable cells there. */\n@media (max-width: 760px) {\n    [data-v2-shell] [data-slot='cases-table'] [role='row'] {\n        grid-template-columns: minmax(0, 1fr) auto !important;\n        row-gap: 8px !important;\n    }\n    [data-v2-shell] [data-slot='cases-table'] [role='row'] > :nth-child(3) {\n        grid-column: 1 / -1;\n    }\n}\n/* The wizard's Environment segmented control (C43): native radios inside labels; the segment shows the ring. */\n[data-slot='environment-choice']:has(> input:focus-visible) {\n    outline: 2px solid var(--v2-acc);\n    outline-offset: 1px;\n}\n\n/* Shared controls follow the desktop palette only in explicitly owned scopes.\n * Academy and its body portals retain the general root palette. */\n[data-desktop-theme] {\n    color-scheme: var(--v2-color-scheme);\n    --academy-bg: var(--v2-bg);\n    --academy-bg-rail: var(--v2-side);\n    --academy-bg-inset: var(--v2-inset);\n    --academy-paper: var(--v2-paper);\n    --academy-paper-deep: var(--v2-inset);\n    --academy-ink: var(--v2-ink);\n    --academy-ink-soft: var(--v2-soft);\n    --academy-ink-faint: var(--v2-faint);\n    --academy-rule: var(--v2-rule);\n    --academy-rule-strong: var(--v2-ctl);\n    --academy-track: var(--v2-rule);\n    --academy-accent: var(--v2-acc);\n    --academy-accent-ink: var(--v2-acc-ink);\n    --academy-accent-soft: var(--v2-acc-soft);\n    --academy-accent-ring: var(--v2-acc);\n    --academy-focus-ring: var(--v2-acc);\n    --academy-accent-warn: var(--v2-block);\n    --academy-saved-dot: var(--v2-ok);\n    --academy-info: var(--v2-get);\n    --academy-active-chip: var(--v2-inset);\n}\n\n.settings-grid {\n    display: grid;\n    grid-template-columns: repeat(auto-fit, minmax(min(100%, 23rem), 1fr));\n    gap: 16px;\n    align-items: start;\n}\n.settings-card {\n    min-width: 0;\n    display: flex;\n    flex-direction: column;\n    gap: 12px;\n    padding: 16px;\n    border: 1px solid var(--v2-rule);\n    border-radius: var(--v2-radius-card);\n    background: var(--v2-paper);\n    color: var(--v2-ink);\n    font-size: 13px;\n}\n.settings-card > legend, .settings-card > h3 {\n    padding: 0 4px;\n    font-size: 14px;\n    font-weight: 600;\n}\n.settings-description { color: var(--v2-soft); font-size: 12px; }\n.settings-fields {\n    display: grid;\n    grid-template-columns: repeat(auto-fit, minmax(min(100%, 12rem), 1fr));\n    gap: 12px;\n}\n.settings-field { display: flex; min-width: 0; flex-direction: column; gap: 5px; font-size: 12px; font-weight: 500; }\n.settings-card :is(input:not([type='radio']):not([type='checkbox']), select) {\n    width: 100%; min-width: 0; min-height: 32px; padding: 5px 9px; font-size: 13px;\n}\n.settings-card :is(button, [type='radio'], [type='checkbox']) { flex-shrink: 0; }\n.settings-card button { min-height: 32px; height: auto; padding-top: 5px; padding-bottom: 5px; }\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_20","type":"command_execution","command":"/bin/zsh -lc \"sed -n '260,440p' apps/desktop/src/modules/tenants/tenants-settings.tsx; cat apps/desktop/src/modules/tenants/credential-entry.tsx apps/desktop/src/modules/tenants/management-credential.tsx\"","aggregated_output":"function AddTenant({ snapshot, dispatch, observeManagement }: Props) {\n    const headingId = useId()\n    const [open, setOpen] = useState(false)\n    const [closeRequests, setCloseRequests] = useState(0)\n    const [added, setAdded] = useState<string | null>(null)\n    return <section aria-labelledby={headingId} className='settings-card' data-slot='add-tenant'>\n        <h3 id={headingId}>Add Tenant</h3>\n        <p className='settings-description'>Connect a tenant with its TSG ID, management client and scan region. OAuth authentication is required before it is added; a Scan Key can be configured later.</p>\n        <div><Button type='button' tier='primary' onClick={() => { setCloseRequests(0); setOpen(true) }}>Add tenant…</Button></div>\n        {added && <p role='status'>Added {added}.</p>}\n        {open && <Modal label='Add a tenant' onClose={() => setCloseRequests((n) => n + 1)} width={1160} padding={0} data-slot='settings-add-tenant-sheet'>\n            <Wizard mode='add' snapshot={snapshot} dispatch={dispatch} observeManagement={observeManagement} onNavigate={() => undefined} closeRequests={closeRequests} onClose={(label) => { setOpen(false); setCloseRequests(0); if (label) setAdded(label) }} />\n        </Modal>}\n    </section>\n}\n\nfunction ResetLocalData({ snapshot, dispatch }: { snapshot: ShellSnapshot; dispatch: Dispatch }) {\n    const { message, busy, run } = useAction(dispatch)\n    const [confirming, setConfirming] = useState(false)\n    const headingId = useId()\n    return (\n        <section aria-labelledby={headingId} className='settings-card' data-slot='reset'>\n            <h3 id={headingId} className='text-academy-ink text-[14px] font-semibold'>\n                Reset local data\n            </h3>\n            <p className='text-academy-ink-soft text-[13px]'>\n                Removes this app’s tenant profiles, preferences and stored credentials. Other applications are not changed.\n            </p>\n            {snapshot.resetFailure ? (\n                <Callout tone='danger' icon={AlertTriangle} role='alert' data-slot='reset-failure'>\n                    {resetFailureText(snapshot.resetFailure)}\n                </Callout>\n            ) : null}\n            <div className='flex flex-wrap gap-2'>\n                {confirming ? (\n                    <>\n                        <Button\n                            type='button'\n                            tier='primary'\n                            disabled={busy}\n                            onClick={() => {\n                                setConfirming(false)\n                                void run({ kind: 'resetLocalData' })\n                            }}\n                        >\n                            Confirm reset\n                        </Button>\n                        <Button type='button' tier='tertiary' onClick={() => setConfirming(false)}>\n                            Cancel\n                        </Button>\n                    </>\n                ) : (\n                    <Button\n                        type='button'\n                        tier='secondary'\n                        disabled={busy || snapshot.storage === 'resetting'}\n                        onClick={() => setConfirming(true)}\n                    >\n                        Reset local data…\n                    </Button>\n                )}\n            </div>\n            <Message text={message} />\n        </section>\n    )\n}\n\nfunction StorageNotice({ snapshot }: { snapshot: ShellSnapshot }) {\n    switch (snapshot.storage) {\n        case 'ready':\n            return snapshot.durabilityUnconfirmed ? (\n                <Callout tone='warning' icon={AlertTriangle} role='status' data-slot='durability-notice'>\n                    The last change was saved, but the system did not confirm it was written to disk. It may be lost if\n                    this device stops unexpectedly; the next change retries.\n                </Callout>\n            ) : null\n        case 'resetting':\n            return (\n                <p role='status' aria-live='polite' className='text-academy-ink-soft text-[13px]'>\n                    Resetting local data… Scan keys are out of use until it finishes.\n                </p>\n            )\n        case 'corrupt':\n            return (\n                <Callout tone='danger' icon={AlertTriangle} role='alert' data-slot='storage-notice'>\n                    Local desktop data could not be read. Nothing was changed. Reset local data to continue.\n                </Callout>\n            )\n        case 'unavailable':\n            return (\n                <Callout tone='danger' icon={AlertTriangle} role='alert' data-slot='storage-notice'>\n                    Local desktop data is unavailable. Another copy of the desktop may be running.\n                </Callout>\n            )\n    }\n}\n\ninterface Props {\n    snapshot: ShellSnapshot\n    dispatch: Dispatch\n    observeManagement: ObserveManagement\n}\n\n/** Tenant settings keep profile editing separate from credential and destination authority. */\nexport function TenantsSettings({ snapshot, dispatch, observeManagement }: Props) {\n    const legend = useId()\n    const active = snapshot.active ? snapshot.tenants.find((t) => t.id === snapshot.active?.tenant) : undefined\n    return (\n        <section aria-labelledby={legend} data-slot='tenants' className='flex flex-col gap-3'>\n            <div className='flex flex-wrap items-baseline gap-3'>\n                <h2 id={legend} className='text-[16px] font-semibold'>Tenants</h2>\n                {active && <p className='settings-description'>Active tenant: <strong>{active.label}</strong></p>}\n            </div>\n            <StorageNotice snapshot={snapshot} />\n            <div className='settings-grid'>\n                {active && snapshot.active && <>\n                    <ScanKeyForm key={snapshot.active.context} tenant={active} context={snapshot.active.context} dispatch={dispatch} />\n                    <ManagementCredentialForm key={`management-${snapshot.active.context}`} tenant={active} context={snapshot.active.context} dispatch={dispatch} observe={observeManagement} />\n                    <EndpointChange key={`destination-${snapshot.active.context}`} tenant={active} snapshot={snapshot} dispatch={dispatch} />\n                </>}\n                <UpdateTenant snapshot={snapshot} dispatch={dispatch} />\n                <AddTenant snapshot={snapshot} dispatch={dispatch} observeManagement={observeManagement} />\n                <ResetLocalData snapshot={snapshot} dispatch={dispatch} />\n            </div>\n        </section>\n    )\n}\nimport { type FormEvent, useId, useRef, useState } from 'react'\nimport { Button, Callout, Input } from '@ai-security-academy/presentation'\nimport { AlertTriangle, CheckCircle2, Info } from 'lucide-react'\nimport type { ContextRef, StorageMode, TenantView, VaultError } from '@prisma-airs/desktop-contracts'\nimport { type Dispatch, outcomeMessage } from './dispatch'\n\nconst FAILURE_TEXT: Record<VaultError, string> = {\n    locked: 'Secure storage is locked. Unlock it and enter the key again, or keep it for this session only.',\n    denied: 'The system did not allow access to secure storage. Enter the key again, or keep it for this session only.',\n    unavailable: 'The credential store is not available. Enter the key again, or keep it for this session only.',\n    notFound: 'The stored key is missing. Enter it again.',\n    corrupt: 'The stored key could not be read. Enter it again.',\n}\n\nfunction scanStatus(tenant: TenantView): { tone: 'default' | 'success' | 'danger'; text: string } {\n    const { state, mode, failure } = tenant.scan\n    switch (state) {\n        case 'missing':\n            return { tone: 'default', text: 'No scan key. Enter this tenant’s AIRS API key to enable scans.' }\n        case 'storing':\n            return { tone: 'default', text: 'Saving the scan key…' }\n        case 'ready':\n            return {\n                tone: 'success',\n                text: mode === 'session' ? 'Scan key held for this session only.' : 'Scan key saved in secure storage.',\n            }\n        case 'failed':\n            return { tone: 'danger', text: failure ? FAILURE_TEXT[failure] : 'The scan key could not be saved.' }\n    }\n}\n\ninterface Props {\n    tenant: TenantView\n    context: ContextRef\n    dispatch: Dispatch\n}\n\n/**\n * Scan-key entry for the active tenant. The key is read from the field at\n * the moment of submission and the field is cleared before the request is\n * awaited; it is never held in React state, storage or any snapshot. (A\n * JavaScript string cannot be reliably zeroized; the native side keeps it.)\n */\nexport function ScanKeyForm({ tenant, context, dispatch }: Props) {\n    const [mode, setMode] = useState<StorageMode>('keychain')\n    const [message, setMessage] = useState<string | null>(null)\n    const [busy, setBusy] = useState(false)\n    const keyRef = useRef<HTMLInputElement>(null)\n    const keyId = useId()\n    const hintId = useId()\n    const modeLegend = useId()\n    const status = scanStatus(tenant)\n    const hasKey = tenant.scan.state === 'ready' || tenant.scan.state === 'failed'\n\n    async function submit(event: FormEvent<HTMLFormElement>) {\n        event.preventDefault()\n        const field = keyRef.current\n        if (!field) return\n        const key = field.value\n        field.value = ''\n        if (key.length === 0) {\n            setMessage('Enter the scan key.')\n            field.focus()\n            return\n        }\n        setBusy(true)\n        setMessage(null)\n        const outcome = await dispatch({ kind: 'configureScanCredential', context, mode, key })\n        setBusy(false)\n        setMessage(outcomeMessage(outcome))\n    }\n\n    async function remove() {\n        setBusy(true)\n        setMessage(null)\n        const outcome = await dispatch({ kind: 'removeScanCredential', context })\n        setBusy(false)\n        setMessage(outcomeMessage(outcome))\n    }\n\n    return (\n        <section aria-labelledby={`${keyId}-heading`} data-slot='scan-key' className='settings-card'>\n            <h3 id={`${keyId}-heading`} className='text-academy-ink text-[14px] font-semibold'>\n                Scan key\n            </h3>\n            <Callout\n                tone={status.tone}\n                icon={status.tone === 'success' ? CheckCircle2 : status.tone === 'danger' ? AlertTriangle : Info}\n                role='status'\n                aria-live='polite'\n                data-slot='scan-status'\n            >\n                {status.text}\n            </Callout>\n            <form onSubmit={(e) => void submit(e)} className='flex flex-col gap-3' aria-busy={busy}>\n                <label htmlFor={keyId} className='text-academy-ink text-[13px] font-medium'>\n                    AIRS API key\n                </label>\n                <Input\n                    ref={keyRef}\n                    id={keyId}\n                    name='scan-key'\n                    type='password'\n                    autoComplete='off'\n                    autoCapitalize='off'\n                    autoCorrect='off'\n                    spellCheck={false}\n                    aria-describedby={hintId}\n                    data-slot='scan-key-input'\n                />\n                <p id={hintId} className='text-academy-ink-faint text-[12px]'>\n                    Sent only to {tenant.origin}. Entering a new key replaces the current one.\n                </p>\n                <fieldset aria-labelledby={modeLegend} className='flex flex-col gap-1'>\n                    <legend id={modeLegend} className='text-academy-ink text-[13px] font-medium'>\n                        Keep the key\n                    </legend>\n                    {(\n                        [\n                            ['keychain', 'In secure storage', 'Available after restarting the desktop'],\n                            ['session', 'For this session only', 'Forgotten when the desktop quits'],\n                        ] as const\n                    ).map(([value, label, hint]) => (\n                        <label key={value} className='flex min-h-8 cursor-pointer items-center gap-3'>\n                            <input\n                                type='radio'\n                                name='scan-key-mode'\n                                value={value}\n                                checked={mode === value}\n                                onChange={() => setMode(value)}\n                                className='size-4 accent-[var(--academy-accent)]'\n                            />\n                            <span className='flex flex-col'>\n                                <span className='text-academy-ink text-[13px]'>{label}</span>\n                                <span className='text-academy-ink-faint text-[12px]'>{hint}</span>\n                            </span>\n                        </label>\n                    ))}\n                </fieldset>\n                <div className='flex flex-wrap gap-2'>\n                    <Button type='submit' tier='primary' disabled={busy}>\n                        {hasKey ? 'Replace key' : 'Save key'}\n                    </Button>\n                    {hasKey ? (\n                        <Button type='button' tier='secondary' disabled={busy} onClick={() => void remove()}>\n                            Remove scan key\n                        </Button>\n                    ) : null}\n                </div>\n                {message ? (\n                    <p role='alert' data-slot='scan-key-message' className='text-academy-accent-warn text-[13px]'>\n                        {message}\n                    </p>\n                ) : null}\n            </form>\n        </section>\n    )\n}\nimport { type FormEvent, useId, useRef, useState } from 'react'\nimport { Button, Callout, Input } from '@ai-security-academy/presentation'\nimport { AlertTriangle, CheckCircle2, Info } from 'lucide-react'\nimport type { ContextRef, StorageMode, TenantView, VaultError } from '@prisma-airs/desktop-contracts'\nimport { MANAGEMENT_FAILURE_TEXT, type ObserveManagement, readManagement } from '../administration/management-read'\nimport { type Dispatch, outcomeMessage } from './dispatch'\n\nconst FAILURE_TEXT: Record<VaultError, string> = {\n    locked: 'Secure storage is locked. Unlock it and enter the secret again, or keep it for this session only.',\n    denied: 'The system did not allow access to secure storage. Enter the secret again, or keep it for this session only.',\n    unavailable: 'The credential store is not available. Enter the secret again, or keep it for this session only.',\n    notFound: 'The stored client secret is missing. Enter it again.',\n    corrupt: 'The stored client secret could not be read. Enter it again.',\n}\n\nfunction status(tenant: TenantView): { tone: 'default' | 'success' | 'danger'; text: string } {\n    const { state, mode, failure } = tenant.management\n    switch (state) {\n        case 'missing':\n            return {\n                tone: 'default',\n                text: 'No management client. Scans do not need one; add one to read this tenant’s inventories in Administration.',\n            }\n        case 'storing':\n            return { tone: 'default', text: 'Saving the management client…' }\n        case 'ready':\n            return {\n                tone: 'success',\n                text:\n                    mode === 'session'\n                        ? 'Management client secret held for this session only.'\n                        : 'Management client secret saved in secure storage.',\n            }\n        case 'failed':\n            return { tone: 'danger', text: failure ? FAILURE_TEXT[failure] : 'The management client could not be saved.' }\n    }\n}\n\ninterface Props {\n    tenant: TenantView\n    context: ContextRef\n    dispatch: Dispatch\n    observe: ObserveManagement\n}\n\n/**\n * The tenant's separate management OAuth client (C08). It never replaces or\n * reads the scan key. The secret is read from its field at submission and\n * the field is cleared before the request is awaited; it is never held in\n * React state, storage or any snapshot. Verify authenticates the stored OAuth client without reading product inventories.\n */\nexport function ManagementCredentialForm({ tenant, context, dispatch, observe }: Props) {\n    const [mode, setMode] = useState<StorageMode>('keychain')\n    const [message, setMessage] = useState<string | null>(null)\n    const [verified, setVerified] = useState<string | null>(null)\n    const [busy, setBusy] = useState(false)\n    const secretRef = useRef<HTMLInputElement>(null)\n    const clientRef = useRef<HTMLInputElement>(null)\n    const ids = useId()\n    const shown = status(tenant)\n    const view = tenant.management\n    const hasClient = view.state === 'ready' || view.state === 'failed'\n    const noTsg = tenant.tsgId === null\n\n    async function submit(event: FormEvent<HTMLFormElement>) {\n        event.preventDefault()\n        const secretField = secretRef.current\n        const clientField = clientRef.current\n        if (!secretField || !clientField) return\n        const secret = secretField.value\n        secretField.value = ''\n        const clientId = clientField.value.trim()\n        setVerified(null)\n        if (clientId.length === 0) {\n            setMessage('Enter the client ID.')\n            clientField.focus()\n            return\n        }\n        if (secret.length === 0) {\n            setMessage('Enter the client secret.')\n            secretField.focus()\n            return\n        }\n        setBusy(true)\n        setMessage(null)\n        const outcome = await dispatch({ kind: 'configureManagementCredential', context, mode, clientId, secret })\n        setBusy(false)\n        setMessage(outcomeMessage(outcome))\n    }\n\n    async function verify() {\n        setBusy(true)\n        setMessage(null)\n        setVerified(null)\n        const outcome = await readManagement(dispatch, observe, context, { kind: 'verify' })\n        setBusy(false)\n        if (outcome.kind === 'notAdmitted') setMessage(outcome.message)\n        else if (outcome.result.kind === 'verified') setVerified('Management OAuth authentication succeeded.')\n        else if (outcome.result.kind === 'failed') setMessage(MANAGEMENT_FAILURE_TEXT[outcome.result.failure])\n        else setMessage('The service returned a reply the desktop could not use.')\n    }\n\n    async function remove() {\n        setBusy(true)\n        setMessage(null)\n        setVerified(null)\n        const outcome = await dispatch({ kind: 'removeManagementCredential', context })\n        setBusy(false)\n        setMessage(outcomeMessage(outcome))\n    }\n\n    return (\n        <section aria-labelledby={`${ids}-heading`} data-slot='management-credential' className='settings-card'>\n            <h3 id={`${ids}-heading`} className='text-academy-ink text-[14px] font-semibold'>\n                Management client\n            </h3>\n            <Callout\n                tone={shown.tone}\n                icon={shown.tone === 'success' ? CheckCircle2 : shown.tone === 'danger' ? AlertTriangle : Info}\n                role='status'\n                aria-live='polite'\n                data-slot='management-status'\n            >\n                {shown.text}\n                {view.clientId ? (\n                    <span className='text-academy-ink-soft mt-1 block text-[12px]' data-slot='management-client-id'>\n                        Client ID: {view.clientId}\n                    </span>\n                ) : null}\n            </Callout>\n            {noTsg ? (\n                <Callout tone='warning' icon={AlertTriangle} data-slot='management-no-tsg'>\n                    This tenant has no TSG ID. Add a replacement tenant with its TSG ID to configure a management client.\n                </Callout>\n            ) : null}\n            <p className='text-academy-ink-faint text-[12px]' data-slot='management-sso-pointer'>\n                Company sign-in (SSO) for the Harness is set up per Gateway workspace, in Harness.\n            </p>\n            <form onSubmit={(e) => void submit(e)} className='flex flex-col gap-3' aria-busy={busy}>\n                <label htmlFor={`${ids}-client`} className='text-academy-ink text-[13px] font-medium'>\n                    Client ID\n                </label>\n                <Input\n                    ref={clientRef}\n                    id={`${ids}-client`}\n                    name='management-client-id'\n                    autoComplete='off'\n                    autoCapitalize='off'\n                    autoCorrect='off'\n                    spellCheck={false}\n                    defaultValue={view.clientId ?? ''}\n                    maxLength={1024}\n                    data-slot='management-client-input'\n                />\n                <label htmlFor={`${ids}-secret`} className='text-academy-ink text-[13px] font-medium'>\n                    Client secret\n                </label>\n                <Input\n                    ref={secretRef}\n                    id={`${ids}-secret`}\n                    name='management-secret'\n                    type='password'\n                    autoComplete='off'\n                    autoCapitalize='off'\n                    autoCorrect='off'\n                    spellCheck={false}\n                    aria-describedby={`${ids}-hint`}\n                    data-slot='management-secret-input'\n                />\n                <p id={`${ids}-hint`} className='text-academy-ink-faint text-[12px]'>\n                    The secret is sent only to {view.tokenOrigin ?? 'the Palo Alto Networks token service'} to obtain\n                    short-lived access tokens. It is separate from the scan key.\n                </p>\n                <fieldset aria-labelledby={`${ids}-mode`} className='flex flex-col gap-1'>\n                    <legend id={`${ids}-mode`} className='text-academy-ink text-[13px] font-medium'>\n                        Keep the secret\n                    </legend>\n                    {(\n                        [\n                            ['keychain', 'In secure storage', 'Available after restarting the desktop'],\n                            ['session', 'For this session only', 'Forgotten when the desktop quits'],\n                        ] as const\n                    ).map(([value, label, hint]) => (\n                        <label key={value} className='flex min-h-8 cursor-pointer items-center gap-3'>\n                            <input\n                                type='radio'\n                                name='management-mode'\n                                value={value}\n                                checked={mode === value}\n                                onChange={() => setMode(value)}\n                                className='size-4 accent-[var(--academy-accent)]'\n                            />\n                            <span className='flex flex-col'>\n                                <span className='text-academy-ink text-[13px]'>{label}</span>\n                                <span className='text-academy-ink-faint text-[12px]'>{hint}</span>\n                            </span>\n                        </label>\n                    ))}\n                </fieldset>\n                <div className='flex flex-wrap gap-2'>\n                    <Button type='submit' tier='primary' disabled={busy || noTsg}>\n                        {hasClient ? 'Replace client' : 'Save client'}\n                    </Button>\n                    {view.state === 'ready' ? (\n                        <Button type='button' tier='secondary' disabled={busy} onClick={() => void verify()}>\n                            Verify\n                        </Button>\n                    ) : null}\n                    {hasClient ? (\n                        <Button type='button' tier='secondary' disabled={busy} onClick={() => void remove()}>\n                            Remove management client\n                        </Button>\n                    ) : null}\n                </div>\n                {verified ? (\n                    <p role='status' data-slot='management-verified' className='text-academy-ink text-[13px]'>\n                        {verified}\n                    </p>\n                ) : null}\n                {message ? (\n                    <p role='alert' data-slot='management-message' className='text-academy-accent-warn text-[13px]'>\n                        {message}\n                    </p>\n                ) : null}\n            </form>\n        </section>\n    )\n}\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_21","type":"command_execution","command":"/bin/zsh -lc \"python3 -c 'import json,hashlib,stat,os; from pathlib import Path; b=Path(\\\"docs/planning/reviews/C49/attempt-02\\\"); r=json.load(open(b/\\\"request.json\\\"));\nfor label in [\\\"source\\\",\\\"evidence\\\"]:\n d=json.load(open(b/(label+\\\"-inventory.json\\\")))[\\\"files\\\"]; h=hashlib.sha256(json.dumps(d,sort_keys=True,separators=(\\\",\\\",\\\":\\\")).encode()).hexdigest(); bad=[]\n for n,x in d.items():\n  p=Path(n)\n  try:\n   s=p.lstat(); actual={\\\"mode\\\":stat.S_IMODE(s.st_mode),\\\"kind\\\":\\\"symlink\\\",\\\"target\\\":os.readlink(p)} if p.is_symlink() else {\\\"mode\\\":stat.S_IMODE(s.st_mode),\\\"kind\\\":\\\"file\\\",\\\"sha256\\\":hashlib.sha256(p.read_bytes()).hexdigest()}\n   if actual\"'!=x: bad.append(n)\n  except OSError as e: bad.append(n+\": \"+str(e))\n print(label,\"files\",len(d),\"digest\",h,\"matches\",h==r[\"fingerprints\"][label],\"drift\",bad)\nprint(\"scope matches\",sorted(r[\"scope\"][\"files\"])==sorted(json.load(open(b/\"source-inventory.json\"))[\"files\"]))'\"'\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_21","type":"command_execution","command":"/bin/zsh -lc \"python3 -c 'import json,hashlib,stat,os; from pathlib import Path; b=Path(\\\"docs/planning/reviews/C49/attempt-02\\\"); r=json.load(open(b/\\\"request.json\\\"));\nfor label in [\\\"source\\\",\\\"evidence\\\"]:\n d=json.load(open(b/(label+\\\"-inventory.json\\\")))[\\\"files\\\"]; h=hashlib.sha256(json.dumps(d,sort_keys=True,separators=(\\\",\\\",\\\":\\\")).encode()).hexdigest(); bad=[]\n for n,x in d.items():\n  p=Path(n)\n  try:\n   s=p.lstat(); actual={\\\"mode\\\":stat.S_IMODE(s.st_mode),\\\"kind\\\":\\\"symlink\\\",\\\"target\\\":os.readlink(p)} if p.is_symlink() else {\\\"mode\\\":stat.S_IMODE(s.st_mode),\\\"kind\\\":\\\"file\\\",\\\"sha256\\\":hashlib.sha256(p.read_bytes()).hexdigest()}\n   if actual\"'!=x: bad.append(n)\n  except OSError as e: bad.append(n+\": \"+str(e))\n print(label,\"files\",len(d),\"digest\",h,\"matches\",h==r[\"fingerprints\"][label],\"drift\",bad)\nprint(\"scope matches\",sorted(r[\"scope\"][\"files\"])==sorted(json.load(open(b/\"source-inventory.json\"))[\"files\"]))'\"'\"","aggregated_output":"source files 1209 digest 8880ad698b81ab5c5cd6edf561ad2dc211d171bc81e5a7da1ca5ebb6d374200b matches False drift []\nevidence files 4406 digest 82cabf85cb8ac75a636dcfe33ff9d7564cf0c0e59b9bd2fe9f2de6a0fc4f2057 matches False drift []\nscope matches True\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_22","type":"command_execution","command":"/bin/zsh -lc 'cat tools/native-acceptance/acceptance_p11_settings.py tools/native-acceptance/acceptance_p11_credentials.py tools/native-acceptance/acceptance_p11_keyboard.py tools/native-acceptance/ax_colors.swift'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_22","type":"command_execution","command":"/bin/zsh -lc 'cat tools/native-acceptance/acceptance_p11_settings.py tools/native-acceptance/acceptance_p11_credentials.py tools/native-acceptance/acceptance_p11_keyboard.py tools/native-acceptance/ax_colors.swift'","aggregated_output":"\"\"\"C49 affected native observations; invoked only by acceptance_p11.run.\n\nAll input belongs to the orchestrator's fixture. Captures require independent\nvisual review. Native observations do not prove before-await secret clearing,\nidentity authority, rollback, contrast ratios, or earned-skin authorization;\nthe finalizer must also bind the named production-interface regressions.\nThis module has no standalone execution path and never reads a real vault.\n\"\"\"\n\nimport time\n\n\nSOURCE_REQUIREMENTS = {\n    \"frontend\": [\n        \"src/v2/settings/refinement-settings.test.tsx\",\n        \"src/modules/tenants/credential-entry.test.tsx\",\n        \"src/v2/settings/management-credential.test.tsx\",\n        \"src/shell/appearance.test.ts\",\n        \"src/shell/palette-contrast.test.ts\",\n        \"src/v2/academy/academy.test.tsx\",\n    ],\n    \"rust\": [\"refinement_metadata\", \"color_theme\", \"ui_v2_setup_reads\", \"ui_v2_onboarding\"],\n    \"not_claimed_by_native\": [\n        \"secret clearing occurs before awaiting dispatch\",\n        \"stale context and cross-profile authority are rejected\",\n        \"failed persistence and cancellation roll back safely\",\n        \"measured palette contrast and Academy earned-skin authority\",\n    ],\n}\n\n\ndef _node(ctx, role, label, tree=None, nth=0):\n    node = ctx.app.node(ctx.app.tree() if tree is None else tree, role, label, nth)\n    ctx.require(node is not None, f\"C49 missing {role} {label}\")\n    return node\n\n\ndef _value(ctx, role, label, nth=0):\n    return str(_node(ctx, role, label, nth=nth).get(\"value\") or \"\")\n\n\ndef _select(ctx, label, options, selected):\n    \"\"\"Choose a native HTML select with real keys, then verify the AX value.\"\"\"\n    ctx.require(selected in options, \"unknown C49 select option\")\n    _node(ctx, \"AXPopUpButton\", label)\n    ctx.app.ax(\"focus\", \"AXPopUpButton\", label)\n    ctx.app.keycode(49)  # Space opens the focused select's native menu.\n    ctx.app.keycode(115)  # Home, followed by the declared option index.\n    for _ in range(options.index(selected)):\n        ctx.app.keycode(125)\n    ctx.app.keycode(36)\n    tree, ready = ctx.app.wait_for(\n        lambda t: str((ctx.app.node(t, \"AXPopUpButton\", label) or {}).get(\"value\") or \"\") == selected\n    )\n    ctx.require(ready, f\"C49 {label} did not select {selected}\")\n    return tree\n\n\ndef _replace_text(ctx, label, value):\n    ctx.app.ax(\"focus\", \"AXTextField\", label)\n    ctx.app.keys(\"a\", \"command down\")\n    ctx.app.keycode(51)\n    ctx.app.type_into(\"AXTextField\", label, value)\n\n\ndef _radio(ctx, label, nth=0):\n    node = _node(ctx, \"AXRadioButton\", label, nth=nth)\n    ctx.require(node.get(\"enabled\") is not False, f\"disabled radio {label}\")\n    ctx.app.ax(\"press\", \"AXRadioButton\", label, nth)\n    tree, selected = ctx.app.wait_for(\n        lambda t: (ctx.app.node(t, \"AXRadioButton\", label, nth) or {}).get(\"value\") in (1, \"1\")\n    )\n    ctx.require(selected, f\"radio not selected: {label}\")\n    return tree\n\n\ndef _resize(ctx, width, height):\n    ctx.resize(width, height)\n    time.sleep(.6)\n\n\ndef _zoom(ctx, doubled=False):\n    ctx.app.menu(\"View\", \"Actual Size\")\n    if doubled:\n        # Host::zoom increments by 0.1 from reset 1.0; ten steps request 2.0.\n        for _ in range(10):\n            ctx.app.menu(\"View\", \"Zoom In\")\n\n\ndef _inside(window, control):\n    if not all(n.get(\"pos\") and n.get(\"size\") for n in (window, control)):\n        return False\n    x, y = window[\"pos\"]\n    w, h = window[\"size\"]\n    px, py = control[\"pos\"]\n    pw, ph = control[\"size\"]\n    return pw > 0 and ph > 0 and x - 2 <= px and y - 2 <= py and px + pw <= x + w + 2 and py + ph <= y + h + 2\n\n\ndef _keyboard_cards(ctx):\n    wanted = {\"Theme\", \"AIRS API key\", \"Client ID\", \"Client secret\", \"Save key\",\n              \"Change destination…\", \"Tenant to update\", \"Edit\", \"Delete\", \"Add tenant…\"}\n    reached, trace = set(), []\n    ctx.app.ax(\"focus\", \"AXPopUpButton\", \"Appearance\")\n    for _ in range(70):\n        ctx.app.keycode(48)\n        tree = ctx.app.tree()\n        focused = ctx.app.focused(tree)\n        window = ctx.app.node(tree, \"AXWindow\", \"\") or {}\n        if focused:\n            label = focused.get(\"label\") or \"\"\n            matches = {label_ for label_ in wanted if label == label_ or label.startswith(label_ + \" \")}\n            visible = _inside(window, focused)\n            trace.append({\"role\": focused.get(\"role\"), \"label\": label, \"inside_window\": visible,\n                          \"pos\": focused.get(\"pos\"), \"size\": focused.get(\"size\")})\n            if visible:\n                reached.update(matches)\n        if reached == wanted:\n            break\n    evidence = ctx.save(\"c49-keyboard-200-percent\", {\"requested_zoom\": 2.0, \"wanted\": sorted(wanted),\n        \"reached\": sorted(reached), \"trace\": trace, \"meaning\": \"AX geometry and keyboard reach; pixels require review\"})\n    ctx.require(reached == wanted, f\"C49 unreachable controls at narrow/200%: {sorted(wanted - reached)}\")\n    return evidence, reached == wanted\n\n\ndef _settings(ctx):\n    return ctx.navigate(\"Settings\")\n\n\ndef _academy_reader(ctx):\n    \"\"\"From the current synthetic catalog, through guest learner links only.\"\"\"\n    ctx.press(\"AXCheckBox\", \"Courses\")\n    ctx.press(\"AXLink\", \"COURSE Runtime Security Foundations\")\n    ctx.text(\"Runtime Security Foundations\")\n    ctx.press(\"AXLink\", \"Scanning at runtime: part 1\")\n    return ctx.text(\"Lesson 1 of Scanning at runtime opens here\")\n\n\ndef _themes(ctx, original_appearance, original_theme):\n    evidence, captures = [], []\n    options = [\"Match system\", \"Light\", \"Dark\"]\n    for theme in (\"Prisma AIRS\", \"Gruvbox\"):\n        for appearance in (\"Light\", \"Dark\"):\n            _settings(ctx)\n            _select(ctx, \"Appearance\", options, appearance)\n            tree = _select(ctx, \"Theme\", [\"Prisma AIRS\", \"Gruvbox\"], theme)\n            name = f\"c49-{theme.lower().replace(' ', '-')}-{appearance.lower()}\"\n            evidence.append(ctx.save(name, tree))\n            captures.append(ctx.capture(name))\n    # The alternate theme and explicit appearance must survive a real restart.\n    old_pid = ctx.app.pid\n    ctx.app.quit()\n    ctx.app.launch()\n    _settings(ctx)\n    persisted = _value(ctx, \"AXPopUpButton\", \"Theme\") == \"Gruvbox\" and _value(ctx, \"AXPopUpButton\", \"Appearance\") == \"Dark\"\n    ctx.require(persisted and ctx.app.pid != old_pid, \"C49 palette/appearance did not survive restart\")\n    evidence.append(ctx.save(\"c49-persisted-alternate-theme\"))\n    ctx.navigate(\"Home\")\n    captures.append(ctx.capture(\"c49-product-gruvbox-dark\"))\n\n    portal_observed, desktop_portals, academy_inputs = [], [], []\n    for theme in (\"Prisma AIRS\", \"Gruvbox\"):\n        _settings(ctx)\n        _select(ctx, \"Theme\", [\"Prisma AIRS\", \"Gruvbox\"], theme)\n        # Desktop-owned modal must follow the selected desktop palette.\n        ctx.press(\"AXButton\", \"Add tenant…\")\n        tree = ctx.text(\"Add a tenant\")\n        desktop_portals.append(ctx.app.has_text(tree, \"Add a tenant\"))\n        captures.append(ctx.capture(f\"c49-desktop-portal-{theme.lower().replace(' ', '-')}\"))\n        ctx.press(\"AXButton\", \"Cancel\")\n        _resize(ctx, 1100, 800)\n        _zoom(ctx, doubled=True)\n        ctx.navigate(\"Academy\")\n        # Academy owns this ordinary in-page search input too. Capture its\n        # actual focus treatment, not only a portal or static learner text.\n        label = \"Search paths, courses, and labs\"\n        tree, ready = ctx.app.wait_for(lambda t: any(ctx.app.node(t, role, label)\n            for role in (\"AXSearchField\", \"AXTextField\")))\n        ctx.require(ready, \"Academy catalog search input missing\")\n        role = next(role for role in (\"AXSearchField\", \"AXTextField\") if ctx.app.node(tree, role, label))\n        ctx.app.ax(\"focus\", role, label)\n        tree, focused = ctx.app.wait_for(lambda t: (ctx.app.focused(t) or {}).get(\"label\") == label)\n        ctx.require(focused, \"Academy catalog search did not receive focus\")\n        academy_inputs.append(focused)\n        evidence.append(ctx.save(f\"c49-academy-search-focused-{theme.lower().replace(' ', '-')}\", tree))\n        captures.append(ctx.capture(f\"c49-academy-search-focused-{theme.lower().replace(' ', '-')}\"))\n        tree = _academy_reader(ctx)\n        evidence.append(ctx.save(f\"c49-guest-reader-{theme.lower().replace(' ', '-')}\", tree))\n        captures.append(ctx.capture(f\"c49-guest-reader-{theme.lower().replace(' ', '-')}\"))\n        # Academy's narrow reader Modal is a body portal with Academy tokens.\n        ctx.press(\"AXButton\", \"Contents\")\n        tree = ctx.text(\"Course contents\")\n        portal_observed.append(ctx.app.has_text(tree, \"Course contents\"))\n        evidence.append(ctx.save(f\"c49-academy-contents-{theme.lower().replace(' ', '-')}\", tree))\n        captures.append(ctx.capture(f\"c49-academy-contents-{theme.lower().replace(' ', '-')}\"))\n        ctx.press(\"AXButton\", \"Close\")\n        ctx.require(not ctx.app.has_text(ctx.app.tree(), \"Course contents\"), \"Academy contents did not close\")\n        _zoom(ctx)\n    _settings(ctx)\n    _select(ctx, \"Theme\", [\"Prisma AIRS\", \"Gruvbox\"], original_theme)\n    _select(ctx, \"Appearance\", options, original_appearance)\n    ctx.record(\"C49-N02\", {\"four_palette_controls_observed\": len(captures) >= 4,\n        \"alternate_theme_and_appearance_survived_restart\": persisted,\n        \"desktop_add_portal_opened_in_both_themes\": all(desktop_portals) and len(desktop_portals) == 2,\n        \"guest_academy_in_page_search_focus_observed_in_both_desktop_themes\": all(academy_inputs) and len(academy_inputs) == 2,\n        \"guest_academy_reader_and_contents_portal_opened_in_both_themes\": all(portal_observed) and len(portal_observed) == 2},\n        evidence, captures)\n\n\ndef _tenant_controls(ctx, bootstrap):\n    evidence, captures = [], []\n    _settings(ctx)\n    selected_before = _value(ctx, \"AXPopUpButton\", \"Tenant to update\")\n    ctx.require(selected_before == bootstrap + \" (active)\", \"C49 must begin on its owned bootstrap tenant\")\n    client_before = _value(ctx, \"AXTextField\", \"Client ID\")\n    # Keep the management client intact: later C46 warning flows use it.\n    _node(ctx, \"AXButton\", \"Replace client\")\n    _node(ctx, \"AXButton\", \"Remove management client\")\n    storage_choices = []\n    for nth in (0, 1):  # Scan and management cards expose both storage choices.\n        tree = _radio(ctx, \"For this session only\", nth)\n        storage_choices.append((ctx.app.node(tree, \"AXRadioButton\", \"For this session only\", nth) or {}).get(\"value\") in (1, \"1\"))\n        tree = _radio(ctx, \"In secure storage\", nth)\n        storage_choices.append((ctx.app.node(tree, \"AXRadioButton\", \"In secure storage\", nth) or {}).get(\"value\") in (1, \"1\"))\n    ctx.app.type_into(\"AXTextField\", \"Client secret\", \"synthetic-c49-unsaved-secret\", secure=True)\n    ctx.navigate(\"Home\")\n    _settings(ctx)\n    cleared_on_leave = _value(ctx, \"AXTextField\", \"Client secret\") == \"\"\n    ctx.require(cleared_on_leave, \"unsaved management secret survived leaving Settings\")\n\n    # Actual credential writes are confined to the fixture vault/session. No scan\n    # or product request is made. Remove the key again before restoring Home.\n    _radio(ctx, \"For this session only\", 0)\n    for index, button in enumerate((\"Save key\", \"Replace key\"), start=1):\n        ctx.app.type_into(\"AXTextField\", \"AIRS API key\", f\"synthetic-c49-session-key-{index}\", secure=True)\n        ctx.press(\"AXButton\", button)\n        tree = ctx.text(\"Scan key held for this session only.\")\n        ctx.require(_value(ctx, \"AXTextField\", \"AIRS API key\") == \"\", \"submitted scan secret remained visible\")\n        evidence.append(ctx.save(f\"c49-session-key-{index}\", tree))\n    ctx.press(\"AXButton\", \"Remove scan key\")\n    tree = ctx.text(\"No scan key.\")\n    evidence.append(ctx.save(\"c49-session-key-removed\", tree))\n\n    ctx.press(\"AXButton\", \"Change destination…\")\n    _radio(ctx, \"Custom HTTPS endpoint\")\n    custom_destination = _node(ctx, \"AXTextField\", \"Endpoint origin\") is not None\n    tree = ctx.text(\"HTTPS only, with no path, query or credentials.\")\n    evidence.append(ctx.save(\"c49-custom-destination-review-surface\", tree))\n    captures.append(ctx.capture(\"c49-custom-destination-card\"))\n    ctx.press(\"AXButton\", \"Cancel\")\n\n    ctx.press(\"AXButton\", \"Edit\")\n    original_environment = _value(ctx, \"AXPopUpButton\", \"Environment\")\n    tree = ctx.app.tree()\n    metadata_only = ctx.app.node(tree, \"AXTextField\", \"TSG ID\") is None and ctx.app.node(tree, \"AXTextField\", \"Endpoint origin\") is None\n    ctx.require(metadata_only, \"metadata editor unexpectedly exposes tenant identity/destination\")\n    _replace_text(ctx, \"Display name\", bootstrap + \" Edited\")\n    _select(ctx, \"Environment\", [\"Production\", \"Staging\", \"Other\"], \"Staging\" if original_environment != \"Staging\" else \"Other\")\n    ctx.press(\"AXButton\", \"Save changes\")\n    ctx.text(bootstrap + \" Edited\")\n    evidence.append(ctx.save(\"c49-metadata-edited\"))\n    ctx.press(\"AXButton\", \"Edit\")\n    _replace_text(ctx, \"Display name\", bootstrap)\n    _select(ctx, \"Environment\", [\"Production\", \"Staging\", \"Other\"], original_environment)\n    ctx.press(\"AXButton\", \"Save changes\")\n    ctx.text(bootstrap + \" (active)\")\n    ctx.press(\"AXButton\", \"Delete\")\n    tree = ctx.app.tree()\n    bound_delete = ctx.app.node(tree, \"AXButton\", f\"Confirm deleting {bootstrap} and its credentials\") is not None\n    ctx.require(bound_delete, \"Delete confirmation did not name the selected tenant\")\n    evidence.append(ctx.save(\"c49-delete-target-confirmation\", tree))\n    ctx.press(\"AXButton\", \"Cancel\")\n\n    ctx.press(\"AXButton\", \"Add tenant…\")\n    tree = ctx.text(\"Add a tenant\")\n    region_only = ctx.app.node(tree, \"AXRadioButton\", \"Custom HTTPS endpoint\") is None and ctx.app.node(tree, \"AXPopUpButton\", \"Region\") is not None\n    _replace_text(ctx, \"Display name\", \"P11 Cancelled Draft\")\n    _replace_text(ctx, \"TSG ID\", \"1234567899\")\n    ctx.press(\"AXButton\", \"Draft tenant\")\n    tree = ctx.text(\"P11 Cancelled Draft is drafted.\")\n    blocked = _node(ctx, \"AXButton\", \"Save the management client to continue\", tree).get(\"enabled\") is False\n    ctx.require(region_only and blocked, \"Add must use region-only draft with required management client\")\n    ctx.app.type_into(\"AXTextField\", \"Client secret\", \"synthetic-c49-cancelled-draft-secret\", secure=True)\n    evidence.append(ctx.save(\"c49-add-required-oauth-draft\"))\n    captures.append(ctx.capture(\"c49-add-required-oauth-draft\"))\n    ctx.press(\"AXButton\", \"Cancel\")\n    tree, cancelled = ctx.app.wait_for(lambda t: ctx.app.node(t, \"AXTextField\", \"TSG ID\") is None)\n    ctx.require(cancelled, \"Add draft did not close after cancellation\")\n    selected_after = _value(ctx, \"AXPopUpButton\", \"Tenant to update\")\n    management_retained = _value(ctx, \"AXTextField\", \"Client ID\") == client_before and ctx.app.node(tree, \"AXButton\", \"Remove management client\") is not None\n    restored = selected_after == selected_before\n    ctx.press(\"AXButton\", \"Edit\")\n    restored_environment = _value(ctx, \"AXPopUpButton\", \"Environment\") == original_environment\n    ctx.press(\"AXButton\", \"Cancel\")\n    ctx.require(restored and management_retained, \"C49 did not restore bootstrap profile/management controls\")\n    ctx.record(\"C49-N03\", {\"scan_and_management_secure_session_choices_selectable\": all(storage_choices) and len(storage_choices) == 4,\n        \"scan_session_save_replace_remove_observed\": ctx.app.has_text(tree, \"No scan key.\"),\n        \"unsaved_management_secret_cleared_on_navigation\": cleared_on_leave,\n        \"editor_exposed_metadata_fields_only\": metadata_only,\n        \"selected_profile_label_and_environment_restored\": restored and restored_environment,\n        \"delete_confirmation_named_selected_target_and_was_cancelled\": bound_delete,\n        \"custom_https_controls_retained_in_destination_card\": custom_destination,\n        \"add_offered_region_only\": region_only,\n        \"add_draft_required_management_before_continue_and_cancelled\": blocked and cancelled,\n        \"bootstrap_management_controls_retained\": management_retained}, evidence, captures)\n\n\ndef run(ctx):\n    \"\"\"Observe C49 against the orchestrator's already bootstrapped fixture only.\"\"\"\n    bootstrap = ctx.state[\"bootstrap_tenant\"]\n    tree = _settings(ctx)\n    original_window = _node(ctx, \"AXWindow\", \"\", tree).get(\"size\")\n    original_appearance = _value(ctx, \"AXPopUpButton\", \"Appearance\")\n    original_theme = _value(ctx, \"AXPopUpButton\", \"Theme\")\n    requirements = ctx.save(\"c49-source-boundary-requirements\", SOURCE_REQUIREMENTS)\n    ctx.state[\"c49_source_requirements\"] = SOURCE_REQUIREMENTS\n    cards = (\"Appearance\", \"Academy account\", \"Diagnostics\", \"Tenants\", \"Scan key\", \"Management client\",\n             \"Scan destination\", \"Update Tenant\", \"Add Tenant\")\n    present = all(ctx.app.has_text(tree, card) for card in cards)\n    ctx.require(present, \"C49 Settings cards missing\")\n    captures = [ctx.capture(\"c49-settings-cards-100-percent\")]\n    evidence = [requirements, ctx.save(\"c49-settings-cards\", tree)]\n    _resize(ctx, 1100, 800)\n    _zoom(ctx, doubled=True)\n    keyboard_evidence, keyboard_reached = _keyboard_cards(ctx)\n    evidence.append(keyboard_evidence)\n    captures.append(ctx.capture(\"c49-settings-keyboard-200-percent\"))\n    ctx.record(\"C49-N01\", {\"expected_settings_and_tenant_cards_present\": present,\n        \"independent_appearance_theme_controls_present\": bool(ctx.app.node(tree, \"AXPopUpButton\", \"Appearance\") and ctx.app.node(tree, \"AXPopUpButton\", \"Theme\")),\n        \"changed_card_controls_keyboard_reachable_inside_narrow_window_at_requested_200_percent\": keyboard_reached}, evidence, captures)\n    _zoom(ctx)\n    _themes(ctx, original_appearance, original_theme)\n    _tenant_controls(ctx, bootstrap)\n    _zoom(ctx)\n    if original_window:\n        _resize(ctx, *original_window)\n    ctx.navigate(\"Home\")\n    ctx.text(bootstrap)\n\"\"\"Scoped scan-session precondition for the unfinished C49 credential flow.\"\"\"\nimport acceptance_p11_settings as settings\n\n\ndef run(ctx, bootstrap):\n    # The finish driver removes any leftover fixture scan key before entry.\n    # Credential saves rotate context and remount the form with keychain as\n    # its default, so select session anew before EACH synthetic secret entry.\n    original = ctx.app.type_into\n    submitted = 0\n\n    def type_into(role, label, text, *args, **kwargs):\n        nonlocal submitted\n        if (role, label) == ('AXTextField', 'AIRS API key') and isinstance(text, str) and text.startswith('synthetic-c49-session-key-'):\n            ctx.require(submitted < 2 and text == f'synthetic-c49-session-key-{submitted + 1}',\n                        'unexpected C49 synthetic scan-key sequence')\n            settings._radio(ctx, 'For this session only', 0)  # includes selected-state verification\n            submitted += 1\n            ctx.log.append({'action': 'c49-scan-session-mode-before-input', 'ordinal': submitted})\n        return original(role, label, text, *args, **kwargs)\n\n    ctx.app.type_into = type_into\n    try:\n        result = settings._tenant_controls(ctx, bootstrap)\n        ctx.require(submitted == 2, 'C49 requires both session-key submissions')\n        return result\n    finally:\n        ctx.app.type_into = original\n\"\"\"C47-N01: retain the frozen matrix and measure only its two unfinished API focus paths.\"\"\"\nimport copy\nimport hashlib\nimport json\nfrom pathlib import Path\n\nimport acceptance_c29 as c29\nimport acceptance_p11_shell as shell\nimport acceptance_p11_geometry as geometry\n\nROOT = Path.cwd().resolve()\nFLAGS = ('one_named_header_h1', 'navigation_focus', 'main_inside_window', 'academy_location')\nEXPECTED_FACTS = {\n    'all_destinations_have_one_named_header_h1': True,\n    'navigation_focus_observed': True,\n    'main_frames_measured_inside_window': True,\n    'named_actions_keyboard_reachable': False,\n    'academy_hierarchy_retained': True,\n}\nVIEWS = (('Light', 1440, 820, 0, 100), ('Dark', 900, 600, 10, 200))\n\n\ndef require(value, message):\n    if not value:\n        raise RuntimeError(message)\n\n\ndef sha(path):\n    return hashlib.sha256(Path(path).read_bytes()).hexdigest()\n\n\ndef bound(root, ref):\n    path = (root / ref['path']).resolve()\n    require(path.is_relative_to(root.resolve()) and sha(path) == ref['sha256'],\n            'prior keyboard evidence escapes or changed')\n    return path\n\n\ndef inspect_prior(ctx, prior, root=ROOT):\n    raw_path = bound(root, prior['observations'])\n    matrix_path = bound(root, prior['measurements'])\n    raw = json.loads(raw_path.read_text())\n    require(raw['schema'] == 'airs-desktop/p11-native-observations/1' and raw['subject'] == 'P11'\n            and raw['status'] == 'failed' and raw['exit_code'] == 1 and raw['complete'] is False,\n            'original failed matrix process must remain failed')\n    require(raw['binding']['helper_closure'] == raw['helper_closure']\n            and all(raw[key] == raw['binding'][key] == ctx.prepared[key]\n                    for key in ('executable_sha256', 'bundle_sha256'))\n            and raw['binding']['prepare']['sha256'] == ctx.binding['prepare']['sha256']\n            and raw['binding']['native_inventory_sha256'] == ctx.binding['native_inventory_sha256']\n            and raw['host'] == ctx.binding['conditions']['platform'],\n            'prior matrix candidate, platform or binding changed')\n    for name, digest in raw['helper_closure'].items():\n        file = (root / name).resolve()\n        require(file.is_relative_to(root) and file.is_file()\n                and ctx.closure.get(name) == digest == sha(file), 'prior matrix helper bytes changed')\n    for name, digest in raw['artifact_sha256'].items():\n        artifact = (root / name).resolve()\n        require(artifact.is_relative_to(raw_path.parent) and sha(artifact) == digest,\n                'prior matrix artifact changed')\n    rows = [row for row in raw['checks'] if row['id'] == 'C47-N01']\n    require(len(rows) == 1 and rows[0]['facts'] == EXPECTED_FACTS,\n            'prior N01 had a different failed fact')\n    row = rows[0]\n    relative = str(matrix_path.relative_to(root))\n    require(relative in row['evidence'] and raw['artifact_sha256'].get(relative) == prior['measurements']['sha256'],\n            'matrix is not bound by the original N01')\n    matrix = json.loads(matrix_path.read_text())\n    expected = {(page, theme, zoom) for page in shell.PAGES for theme, _, _, _, zoom in VIEWS}\n    require(len(matrix) == 16 and {(r['page'], r['theme'], r['zoom']) for r in matrix} == expected,\n            'frozen matrix membership changed')\n    for item in matrix:\n        require(all(item.get(flag) is True for flag in FLAGS), 'frozen non-keyboard measurement failed')\n        require(item['requested'] == ([1440, 820] if item['theme'] == 'Light' else [900, 600]),\n                'frozen matrix viewport changed')\n        require(item['named_action_keyboard_visible'] is (item['page'] != 'API Client'),\n                'frozen matrix has an unexpected keyboard result')\n    require(len(row['visual']) == len(set(row['visual'])) == 16\n            and all(name in raw['artifact_sha256'] for name in row['visual']),\n            'original matrix captures missing')\n    return raw, row, matrix\n\n\nclass TraversalFailure(RuntimeError):\n    def __init__(self, reason, record):\n        super().__init__('API keyboard traversal failed: ' + reason)\n        self.record = dict(record, failure=reason)\n\n\ndef focus_key(tree, node):\n    semantic = lambda value: (value.get('role'), value.get('label'), value.get('subrole'), value.get('depth'))\n    peers = [value for value in tree if semantic(value) == semantic(node)]\n    return (*semantic(node), next((i for i, value in enumerate(peers) if value is node), 0))\n\n\ndef traverse(initial, tab, tree_now, focused, frame):\n    \"\"\"One finite measured focus cycle, bounded by the actual AX tree size.\"\"\"\n    collection = [n for n in initial if n.get('role') == 'AXPopUpButton'\n                  and (n.get('label') or '').startswith('Collection ')]\n    require(len(collection) == 1, 'API Collection selector is missing or ambiguous')\n    require(sum(n.get('role') == 'AXPopUpButton' and n.get('label') == 'Environment'\n                for n in initial) == 1, 'API Environment selector is missing or ambiguous')\n    labels = {'collection': ('AXPopUpButton', collection[0]['label']),\n              'environment': ('AXPopUpButton', 'Environment')}\n    limit = 2 * max(1, len(initial))\n    trace, seen, reached = [], set(), {}\n    record = {'initial_ax_elements': len(initial), 'element_bound': limit,\n              'expected_header_selectors': labels, 'trace': trace, 'reached': reached}\n    for step in range(1, limit + 1):\n        tab()\n        tree = tree_now()\n        node = focused(tree)\n        if not node:\n            trace.append({'step': step, 'focused': None})\n            continue\n        key = focus_key(tree, node)\n        if key in seen:\n            raise TraversalFailure('focus_cycle', record)\n        seen.add(key)\n        viewport = frame()\n        inside = bool(node.get('enabled') is not False and node.get('size')\n                      and all(value > 0 for value in node['size']) and c29.inside(viewport, node))\n        entry = {'step': step, 'role': node.get('role'), 'label': node.get('label'),\n                 'pos': node.get('pos'), 'size': node.get('size'), 'window': viewport,\n                 'inside_window': inside}\n        trace.append(entry)\n        pair = (node.get('role'), node.get('label'))\n        goals = [name for name, expected in labels.items() if pair == expected]\n        if pair in (('AXTextField', 'URL'), ('AXButton', 'Send')):\n            goals.append('request_action')\n        for goal in goals:\n            if not inside:\n                raise TraversalFailure('focused_goal_outside_window', record)\n            reached[goal] = dict(entry)\n        if set(reached) == {'collection', 'environment', 'request_action'}:\n            record['steps'] = step\n            return record, node\n    raise TraversalFailure('ax_element_bound', record)\n\n\ndef run(ctx, prior):\n    raw, old_row, matrix = inspect_prior(ctx, prior)\n    proof = ctx.save('c47-keyboard-prior-binding', {\n        'prior_raw': prior['observations'], 'prior_measurements': prior['measurements'],\n        'original_execution_id': raw['execution_id'], 'original_process_exit_code': raw['exit_code'],\n        'original_failed_facts': old_row['facts'],\n        'disposition': 'Retain original non-keyboard and fourteen keyboard measurements; '\n                       'replace only the two failed API keyboard measurements with new observations.'})\n    corrected = copy.deepcopy(matrix)\n    evidence, captures, replacements = [prior['measurements']['path'], proof], [], []\n    for theme, width, height, zoom, percent in VIEWS:\n        name = 'c47-api-keyboard-' + theme.lower() + '-' + str(percent)\n        ctx.app.menu('View', 'Actual Size')\n        ctx.app.front()\n        geometry.size_window(ctx, width, height)\n        c29.appearance(ctx.app, theme)\n        if zoom:\n            c29.zoom(ctx.app, zoom)\n        ctx.navigate('API Client')\n        ctx.app.ax('focus', 'AXHeading', 'API Client')\n        initial = ctx.app.tree()\n        start = ctx.app.focused(initial) or {}\n        ctx.require(start.get('role') == 'AXHeading' and start.get('label') == 'API Client',\n                    'API header did not receive actual native focus')\n        try:\n            trace, node = traverse(initial, lambda: ctx.app.keycode(48), ctx.app.tree,\n                                   ctx.app.focused, ctx.frame)\n        except TraversalFailure as error:\n            ctx.save(name + '-trace', error.record)\n            raise\n        trace_ref = ctx.save(name + '-trace', trace)\n        evidence += [trace_ref, ctx.save(name + '-focused', ctx.app.tree())]\n        captures.append(ctx.capture(name))\n        item = next(r for r in corrected if r['page'] == 'API Client'\n                    and r['theme'] == theme and r['zoom'] == percent)\n        item['named_action_keyboard_visible'] = True\n        item['focused_action'] = node\n        replacements.append({'page': 'API Client', 'theme': theme, 'zoom': percent,\n                             'prior_keyboard_visible': False, 'new_trace': trace_ref,\n                             'collection_and_environment_keyboard_visible': True})\n    evidence.append(ctx.save('c47-keyboard-supplement-measurements', {\n        'prior_raw': prior['observations'], 'prior_measurements': prior['measurements'],\n        'replacements': replacements, 'derived_measurements': corrected,\n        'meaning': 'New derived N01 evidence. The original failed raw row and matrix are unchanged.'}))\n    facts = {'all_destinations_have_one_named_header_h1': all(r['one_named_header_h1'] for r in corrected),\n             'navigation_focus_observed': all(r['navigation_focus'] for r in corrected),\n             'main_frames_measured_inside_window': all(r['main_inside_window'] for r in corrected),\n             'named_actions_keyboard_reachable': all(r['named_action_keyboard_visible'] for r in corrected),\n             'academy_hierarchy_retained': all(r['academy_location'] for r in corrected),\n             'api_header_selectors_keyboard_visible': len(replacements) == 2}\n    ctx.app.menu('View', 'Actual Size')\n    ctx.resize(1440, 900)\n    return {'id': 'C47-N01', 'facts': facts, 'evidence': evidence,\n            'visual': [*old_row['visual'], *captures]}\n// Reads the text colors WebKit exposes through accessibility for the fixture\n// window's web area, without screen capture. It asks the AXWebArea for an\n// attributed string over its whole text-marker range and reports the distinct\n// foreground/background colors with sample text. With a needle, it reports\n// the colors of the first run containing that text instead.\n// Usage: swift ax_colors.swift <pid> [needle]\nimport AppKit\nimport ApplicationServices\n\nfunc attr(_ el: AXUIElement, _ name: String) -> AnyObject? {\n    var value: AnyObject?\n    return AXUIElementCopyAttributeValue(el, name as CFString, &value) == .success ? value : nil\n}\n\nfunc param(_ el: AXUIElement, _ name: String, _ arg: AnyObject) -> AnyObject? {\n    var value: AnyObject?\n    return AXUIElementCopyParameterizedAttributeValue(el, name as CFString, arg, &value) == .success ? value : nil\n}\n\nfunc hex(_ color: Any?) -> String? {\n    guard let c = color, CFGetTypeID(c as CFTypeRef) == CGColor.typeID else { return nil }\n    guard let rgb = NSColor(cgColor: c as! CGColor)?.usingColorSpace(.sRGB) else { return nil }\n    return String(format: \"#%02x%02x%02x\", Int(round(rgb.redComponent * 255)), Int(round(rgb.greenComponent * 255)), Int(round(rgb.blueComponent * 255)))\n}\n\nlet pid = pid_t(CommandLine.arguments[1])!\nlet app = AXUIElementCreateApplication(pid)\nvar stack: [AXUIElement] = (attr(app, kAXWindowsAttribute) as? [AXUIElement]) ?? []\nvar web: AXUIElement?\nwhile let el = stack.popLast() {\n    if (attr(el, kAXRoleAttribute) as? String) == \"AXWebArea\" { web = el; break }\n    stack.append(contentsOf: (attr(el, kAXChildrenAttribute) as? [AXUIElement]) ?? [])\n}\nguard let area = web,\n      let start = attr(area, \"AXStartTextMarker\"), let end = attr(area, \"AXEndTextMarker\"),\n      let range = param(area, \"AXTextMarkerRangeForUnorderedTextMarkers\", [start, end] as CFArray),\n      let text = param(area, \"AXAttributedStringForTextMarkerRange\", range) as? NSAttributedString else {\n    print(\"{\\\"error\\\":\\\"web area attributed text unavailable\\\"}\")\n    exit(1)\n}\nif CommandLine.arguments.count > 2 {\n    let needle = CommandLine.arguments[2]\n    let found = (text.string as NSString).range(of: needle)\n    var result: [String: Any] = [\"needle\": needle, \"found\": found.location != NSNotFound]\n    if found.location != NSNotFound {\n        let attrs = text.attributes(at: found.location, effectiveRange: nil)\n        result[\"foreground\"] = hex(attrs[NSAttributedString.Key(\"AXForegroundColor\")]) ?? \"none\"\n        result[\"background\"] = hex(attrs[NSAttributedString.Key(\"AXBackgroundColor\")]) ?? \"none\"\n    }\n    let data = try! JSONSerialization.data(withJSONObject: result, options: [.prettyPrinted, .sortedKeys])\n    print(String(data: data, encoding: .utf8)!)\n    exit(0)\n}\nvar runs: [String: [String: Any]] = [:]\ntext.enumerateAttributes(in: NSRange(location: 0, length: text.length)) { attrs, r, _ in\n    let fg = hex(attrs[NSAttributedString.Key(\"AXForegroundColor\")]) ?? \"none\"\n    let bg = hex(attrs[NSAttributedString.Key(\"AXBackgroundColor\")]) ?? \"none\"\n    let key = \"\\(fg)|\\(bg)\"\n    let sample = (text.string as NSString).substring(with: r).trimmingCharacters(in: .whitespacesAndNewlines)\n    if runs[key] == nil && !sample.isEmpty { runs[key] = [\"foreground\": fg, \"background\": bg, \"sample\": String(sample.prefix(40))] }\n}\nlet data = try! JSONSerialization.data(withJSONObject: Array(runs.values).sorted { \"\\($0)\" < \"\\($1)\" }, options: [.prettyPrinted, .sortedKeys])\nprint(String(data: data, encoding: .utf8)!)\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_23","type":"command_execution","command":"/bin/zsh -lc \"sed -n '1,210p' tools/p10/candidate.py; sed -n '3538,3600p' crates/desktop-core/src/authority.rs; sed -n '3880,3985p' crates/desktop-core/src/authority.rs; sed -n '6090,6145p' crates/desktop-core/src/authority.rs\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_23","type":"command_execution","command":"/bin/zsh -lc \"sed -n '1,210p' tools/p10/candidate.py; sed -n '3538,3600p' crates/desktop-core/src/authority.rs; sed -n '3880,3985p' crates/desktop-core/src/authority.rs; sed -n '6090,6145p' crates/desktop-core/src/authority.rs\"","aggregated_output":"\"\"\"Candidate/source bindings shared by C45 qualification and actual reviews.\"\"\"\nfrom pathlib import Path\nimport ast\nimport os\nimport stat\nimport sys\nsys.path.insert(0,str(Path(__file__).resolve().parents[1]/'p09'))\nfrom phase_packet import source_inventory, file_identity, digest\nfrom qualification import read, sha, require\n\n\ndef bundle_hash(bundle):\n    entries=[]\n    for base, directories, files in os.walk(bundle,followlinks=False):\n        symlinks=[name for name in directories if (Path(base)/name).is_symlink()]\n        directories[:]=[name for name in directories if name not in symlinks]\n        for name in files+symlinks:\n            path=Path(base)/name;relative=str(path.relative_to(bundle))\n            if path.is_symlink():mode='symlink';value=__import__('hashlib').sha256(os.readlink(path).encode()).hexdigest()\n            else:mode='100755' if path.stat().st_mode & 0o111 else '100644';value=sha(path)\n            entries.append((relative,mode,value))\n    text=''.join(f'{name}\\0{mode}\\0{value}\\n' for name,mode,value in sorted(entries))\n    return __import__('hashlib').sha256(text.encode()).hexdigest()\n\n\ndef helper_closure(root, driver):\n    folder=root/'tools/native-acceptance';pending=[driver];seen=set()\n    while pending:\n        name=pending.pop()\n        if name in seen or not (folder/(name+'.py')).is_file():continue\n        seen.add(name);tree=ast.parse((folder/(name+'.py')).read_text())\n        for node in ast.walk(tree):\n            if isinstance(node,ast.Import):pending.extend(alias.name.split('.')[0] for alias in node.names)\n            elif isinstance(node,ast.ImportFrom) and node.module:pending.append(node.module.split('.')[0])\n    paths=['tools/native-acceptance/'+name+'.py' for name in seen]\n    # Native compiled helpers/servers are used through literal paths, not imports.\n    paths += [str(p.relative_to(root)) for p in folder.iterdir() if p.suffix in ['.swift','.js']]\n    paths += ['tools/p10/native.py','tools/p10/candidate.py','docs/planning/evidence/P09/native-controller/native_requirements.py']\n    return {name:sha(root/name) for name in sorted(set(paths))}\n\n\ndef verify_source(root, seal):\n    expected=read(root/seal)['files']\n    require(source_inventory(root)==expected,'sealed source membership/content changed')\n    return digest(expected)\n\n\ndef verify_candidate(root, value, historical=None):\n    prepared=read(root/value['prepare']['path'])\n    require(sha(root/value['prepare']['path'])==value['prepare']['sha256'],'preparation drift')\n    bundle=historical.application(value) if historical else root/prepared['bundle']\n    require(sha(bundle/'Contents/MacOS/prisma-airs-desktop')==value['executable_sha256']==prepared['executable_sha256'],'candidate executable drift')\n    require(bundle_hash(bundle)==value['bundle_sha256']==prepared['bundle_sha256'],'complete candidate bundle drift')\n    helper_root=historical.source(value['source_inventory_sha256']) if historical else root\n    for name,value_hash in value['helper_closure'].items():require(sha(helper_root/name)==value_hash,'candidate helper drift: '+name)\n    if value.get('build_origin'):\n        import platform\n        origin=value['build_origin'];path=root/origin['record']\n        require(sha(path)==origin['sha256'],'build origin proof drift')\n        audit=verify_build_reuse(root,read(path),value['runner_inputs'],platform.platform(),platform.node(),historical=historical)\n        require(audit==origin['audit'],'build reuse audit drift')\n    return value\n\n# Explicit helper/provenance-only transition after the baseline02 startup smoke.\n# No application/config/dependency path is permitted. Old raw build and failed\n# smoke remain immutable; this is not a new execution of that build.\nBUILD_REUSE_PATHS = {\n    'tools/p10/historical.py','tools/p10/test_historical.py',\n    'tools/p10/provenance_followup.py','tools/p10/qualification.py',\n    'tools/p10/review_gate.py','tools/p10/followup.py',\n    'crates/xtask/tests/controlled_live.rs',\n    'crates/xtask/tests/live_run/common.rs',\n    'crates/xtask/examples/c45_baseline.rs',\n    'tools/p10/packet.py','tools/p10/followup.py','tools/p10/test_followup.py',\n    'tools/native-acceptance/acceptance_c04.py',\n    'tools/native-acceptance/test_c04_current_frame.py',\n    'tools/native-acceptance/acceptance_c45.py',\n    'tools/p10/candidate.py', 'tools/p10/test_build_reuse.py',\n    'tools/p10/supervise.py', 'tools/p10/seal.py',\n    'tools/p10/finalize.py', 'tools/p10/native.py',\n    'apps/desktop/src-tauri/tests/permission_manifest.rs',\n    'tools/p10/continuation.py', 'tools/p10/test_continuation.py',\n    'tools/native-acceptance/acceptance_c32_current.py',\n    'tools/native-acceptance/test_c32_project_path.py',\n}\n\n\ndef verify_build_reuse(root, record, current_identity, platform_name, hostname, historical=None):\n    from qualification import bound\n    from stages import verify_completed\n    require(record['schema']=='airs-desktop/c45-helper-only-build-reuse/1','build reuse schema')\n    old=read(bound(root,record['original_candidate']))\n    before=read(bound(root,record['original_source']))['files']\n    after=read(bound(root,record['current_source']))['files']\n    changed=sorted(name for name in set(before)|set(after) if before.get(name)!=after.get(name))\n    require(changed==record['declared_changed_paths'] and set(changed)<=BUILD_REUSE_PATHS,'undeclared or application-affecting build-reuse delta')\n    if historical:\n        historical.source(digest(before));historical.source(digest(after))\n    else:require(source_inventory(root)==after,'current build-reuse source changed')\n    require(digest(before)==old['source_inventory_sha256'],'original source seal/candidate mismatch')\n    require(current_identity['dependencies']==old['runner_inputs']['dependencies'] and current_identity['build_flags']==old['runner_inputs']['build_flags'],'build dependency/toolchain/flags changed')\n    if not historical:require(old['conditions']['platform']==platform_name and old['conditions']['hostname']==hostname,'build execution conditions changed')\n    state_path=bound(root,record['original_build_stage']);state=read(state_path)\n    verify_completed(root,state_path.parent,state,state['argv'],digest(before))\n    prepared=read(bound(root,old['prepare']));bundle=historical.application(old) if historical else root/prepared['bundle']\n    require(sha(bundle/'Contents/MacOS/prisma-airs-desktop')==old['executable_sha256']==prepared['executable_sha256'],'retained executable changed')\n    require(bundle_hash(bundle)==old['bundle_sha256']==prepared['bundle_sha256'],'retained complete bundle changed')\n    return {'original_candidate_sha256':record['original_candidate']['sha256'],'original_build_stage_sha256':record['original_build_stage']['sha256'],'declared_helper_only_delta':changed,'executable_sha256':old['executable_sha256'],'bundle_sha256':old['bundle_sha256'],'new_build_executed':False,'meaning':'Exact unchanged application retained from actual baseline02 build; changed C45 selector and qualification provenance execute current affected verification.'}\n                Refusal::DeniedStore\n            }\n        })?;\n        // Recheck after the read: a context change meanwhile retires it.\n        lock(&self.inner)?.check_context(context)?;\n        Ok((destination, secret))\n    }\n\n    /// Session-only credentials currently held (for lifecycle tests).\n    pub fn session_credentials(&self) -> usize {\n        self.inner.session.len()\n    }\n}\n\nfn admit(\n    state: &mut State,\n    session: &Arc<SessionVault>,\n    adapters: &Adapters,\n    intent: Intent,\n    effects: &mut Vec<Effect>,\n) -> Result<Receipt, Refusal> {\n    let mut operation_ref: Option<OperationId> = None;\n    match intent {\n        Intent::SetAppearance { theme } => {\n            if state.appearance() != theme {\n                let before = state.data.clone();\n                state.data.appearance = Some(theme);\n                if state.storage == StorageHealth::Ready\n                    && let Err(e) = state.save_with(&before)\n                {\n                    return Err(e);\n                }\n                state.changed();\n            }\n        }\n        Intent::SetColorTheme { theme } => {\n            if state.color_theme() != theme {\n                let before = state.data.clone();\n                state.data.color_theme = theme;\n                if state.storage == StorageHealth::Ready\n                    && let Err(e) = state.save_with(&before)\n                {\n                    return Err(e);\n                }\n                state.changed();\n            }\n        }\n        Intent::Navigate { feature } => {\n            let entry = features::catalogue()\n                .into_iter()\n                .find(|e| e.id == feature)\n                .ok_or(Refusal::InvalidInput)?;\n            if entry.availability != features::Availability::Available {\n                return Err(Refusal::InvalidInput);\n            }\n            if state.active_feature != Some(feature) {\n                state.active_feature = Some(feature);\n                state.changed();\n            }\n        }\n        Intent::SetOnboarding { state: next } => {\n            use features::OnboardingState as O;\n            let current = state.onboarding();\n        } => {\n            state.require_storage()?;\n            let before = state.data.clone();\n            let issued_by = state.acknowledge_deployment(&context, &application)?;\n            state.save_with(&before)?;\n            // Only a recorded acknowledgement retires the held copy (I6).\n            if let Some((operation, old_key)) = issued_by {\n                state.forget_issuance(&operation, &old_key);\n            }\n            state.changed();\n        }\n        Intent::EditTenant {\n            tenant,\n            label,\n            environment,\n        } => {\n            state.require_storage()?;\n            if !state.committed_tenant(&tenant) {\n                return Err(Refusal::InvalidInput);\n            }\n            let before = state.data.clone();\n            let target = state\n                .data\n                .tenants\n                .iter_mut()\n                .find(|t| t.profile.id == tenant)\n                .ok_or(Refusal::InvalidInput)?;\n            let validated = ProfileDraft {\n                label,\n                tsg_id: target.profile.tsg_id.clone(),\n                destination: target.profile.destination.clone(),\n                environment,\n            }\n            .validate()\n            .ok_or(Refusal::InvalidInput)?;\n            target.profile.label = validated.label;\n            target.profile.environment = validated.environment;\n            state.save_with(&before)?;\n            state.changed();\n        }\n        Intent::DeleteTenant { tenant } => {\n            state.require_storage()?;\n            if !state.committed_tenant(&tenant) {\n                return Err(Refusal::InvalidInput);\n            }\n            let before = state.data.clone();\n            let was_active = state.data.active.as_ref() == Some(&tenant);\n            state.calls.forget(tenant.as_str());\n            let retired_session = state.retire_credential(&tenant);\n            let retired_management = state.retire_class(&tenant, CredentialClass::Management);\n            let retired_inference = state.retire_class(&tenant, CredentialClass::Inference);\n            // Its company sign-in ends: the refresh token item is deleted\n            // through the ledger and revoked at the provider.\n            let signed_in = state.grant(&tenant);\n            if let Some(record) = state\n                .tenant(&tenant)\n                .and_then(|t| t.harness_sign_in.as_ref())\n                .and_then(|s| s.grant.as_ref())\n                .map(|g| g.record.clone())\n            {\n                state.data.pending_cleanup.push(record);\n            }\n            // Its workspace MCP sign-ins end too: their token items are\n            // deleted through the ledger and revoked at each server.\n            let mcp_signed_in = state.mcp_grants_of(&tenant);\n            let mcp_records: Vec<_> = state\n                .tenant(&tenant)\n                .map(|t| {\n                    t.harness_mcp\n                        .iter()\n                        .filter_map(|m| m.grant.as_ref().map(|g| g.record.clone()))\n                        .collect()\n                })\n                .unwrap_or_default();\n            for record in mcp_records {\n                if !state.data.pending_cleanup.contains(&record) {\n                    state.data.pending_cleanup.push(record);\n                }\n            }\n            // Its protected history keys go through the ledger too (the\n            // sealed records are removed with its directory below).\n            let (history_keys, history_dir) = state.forget_harness_history(&tenant);\n            for key in history_keys {\n                if !state.data.pending_cleanup.contains(&key) {\n                    state.data.pending_cleanup.push(key);\n                }\n            }\n            state.data.tenants.retain(|t| t.profile.id != tenant);\n            if was_active {\n                state.data.active = None;\n            }\n            // The tenant's case Library key (and with it its sealed file)\n            // goes through the durable cleanup ledger, retried until done.\n            let library_key = crate::library::key_record(tenant.as_str());\n            if !state.data.pending_cleanup.contains(&library_key) {\n                state.data.pending_cleanup.push(library_key);\n            }\n            state.save_with(&before)?;\n            // Only an accepted deletion drops the tenant's scan records; a\n            // refused one keeps them observable and cancellable.\n            state.scans.retain(|r| r.tenant != tenant);\n            if let Some(path) = state.forget_reports(&tenant) {\n                effects.push(Effect::ForgetReports(path));\n            }\n            if let Some(path) = state.forget_gateway_local(&tenant) {\n                effects.push(Effect::ForgetReports(path));\n\n    fn core(config: CoreConfig) -> Core {\n        Core::new(config, crate::fixtures::adapters().0)\n    }\n\n    #[tokio::test]\n    async fn color_theme_is_persisted_without_changing_appearance_or_tenant_scope() {\n        let core = core(CoreConfig::default());\n        let handle = core.operator();\n        let session = handle.register_delivery_session().expect(\"session\");\n        handle\n            .dispatch(\n                delivery(&session.nonce, 1),\n                Intent::SetAppearance {\n                    theme: Theme::Light,\n                },\n            )\n            .await\n            .expect(\"appearance\");\n        let before = lock(&core.inner).expect(\"state\").snapshot();\n        handle\n            .dispatch(\n                delivery(&session.nonce, 2),\n                Intent::SetColorTheme {\n                    theme: ColorTheme::Gruvbox,\n                },\n            )\n            .await\n            .expect(\"palette\");\n        let state = lock(&core.inner).expect(\"state\");\n        let after = state.snapshot();\n        assert_eq!(after.color_theme, ColorTheme::Gruvbox);\n        assert_eq!(after.appearance, Theme::Light);\n        assert_eq!(after.active, before.active);\n        let saved = state.persisted();\n        assert_eq!(saved.color_theme, ColorTheme::Gruvbox);\n        assert_eq!(saved.appearance, Theme::Light);\n    }\n\n    #[test]\n    fn observers_beyond_the_cap_are_refused_not_evicted() {\n        let core = core(CoreConfig::default());\n        let handle = core.operator();\n        let held: Vec<Observation> = (0..crate::observe::MAX_SUBSCRIBERS)\n            .map(|_| handle.observe(ViewScope::Shell).expect(\"within cap\"))\n            .collect();\n        assert_eq!(handle.observe(ViewScope::Shell).err(), Some(Refusal::Busy));\n        assert_eq!(handle.observer_count(), crate::observe::MAX_SUBSCRIBERS);\n        drop(held);\n        assert_eq!(handle.observer_count(), 0, \"closed observers are pruned\");\n        assert!(handle.observe(ViewScope::Shell).is_ok());\n    }\n\n    #[tokio::test]\n    async fn observer_queue_overflow_ends_with_resync() {\n        let core = core(CoreConfig {\n","exit_code":0,"status":"completed"}}
