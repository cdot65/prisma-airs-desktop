ata-v2-header=''\napps/desktop/src/v2/v2-shell.tsx:441:                    data-desktop-theme=''\napps/desktop/src/v2/v2-shell.tsx-442-                    className='flex shrink-0 items-center'\napps/desktop/src/v2/v2-shell.tsx-443-                    style={{ height: 'var(--v2-header)', gap: 14, padding: '0 20px 0 44px', borderBottom: '1px solid var(--v2-rule)', background: 'var(--v2-bg)' }}\napps/desktop/src/v2/v2-shell.tsx-444-                >\napps/desktop/src/v2/v2-shell.tsx-445-                    <div className='flex min-w-0 items-baseline gap-2'>\napps/desktop/src/v2/v2-shell.tsx-446-                        <h1 ref={heading} id='page-heading' data-slot='page-heading' tabIndex={-1} className='min-w-0 truncate text-[18px] font-bold'>\n--\napps/desktop/src/v2/v2-shell.tsx-499-                            {SHELL_COPY.showCallsHint}\napps/desktop/src/v2/v2-shell.tsx-500-                        </span>\napps/desktop/src/v2/v2-shell.tsx-501-                    </button>\napps/desktop/src/v2/v2-shell.tsx-502-                </header>\napps/desktop/src/v2/v2-shell.tsx-503-                <div className='relative flex min-h-0 flex-grow'>\napps/desktop/src/v2/v2-shell.tsx:504:                    <main data-slot='app-main' data-v2-page='' aria-labelledby='page-heading' data-desktop-theme={feature.id === 'academy' ? undefined : ''} className='flex min-w-0 flex-grow flex-col'>\napps/desktop/src/v2/v2-shell.tsx-505-                        {unconfirmed.length > 0 && (\napps/desktop/src/v2/v2-shell.tsx-506-                            <ul data-slot='unconfirmed' aria-label='Not confirmed' className='mb-4 flex flex-col gap-2'>\napps/desktop/src/v2/v2-shell.tsx-507-                                {unconfirmed.map((u) => (\napps/desktop/src/v2/v2-shell.tsx-508-                                    <li key={u.id} role='status' className='flex items-center gap-3 rounded-[12px] border px-4 py-2 text-[13px]' style={{ borderColor: 'var(--v2-flag)', background: 'var(--v2-flag-bg)', color: 'var(--v2-ink)' }}>\napps/desktop/src/v2/v2-shell.tsx-509-                                        <span className='flex-grow'>{SHELL_COPY.unconfirmed(u.what)}</span>\nimport type { Intent, Refusal } from '@prisma-airs/desktop-contracts'\n\n/** What the presentation learned about one delivered intent. */\nexport type DispatchOutcome =\n    /** Admitted; `operation` names native work the intent started, if any. */\n    | { kind: 'admitted'; operation: string | null }\n    | { kind: 'refused'; refusal: Refusal }\n    /** The desktop did not confirm admission; the current state is shown. */\n    | { kind: 'unknown' }\n    | { kind: 'failed' }\n\nexport type Dispatch = (intent: Intent) => Promise<DispatchOutcome>\n\nconst REFUSAL_TEXT: Record<Refusal, string> = {\n    staleContext: 'The active tenant changed before this was applied. Check the current tenant and try again.',\n    capabilityMissing: 'That is not available for the current tenant.',\n    invalidInput: 'Check the entered values and try again.',\n    reviewInvalid: 'This review is no longer valid. Start a new review.',\n    reviewConsumed: 'This review was already used.',\n    busy: 'The desktop is busy with a previous request. Try again in a moment.',\n    lockedStore: 'The Keychain is locked. Unlock it and try again.',\n    deniedStore: 'Local desktop data or the credential store is not available.',\n    alreadyProcessed: 'That request was already processed.',\n    sequenceGap: 'The request was not delivered in order. Try again.',\n    shuttingDown: 'The desktop is shutting down.',\n    decisionPending: 'A Harness decision is pending; resolve it before switching tenants.',\n}\n\n/** Sanitized operator text for an outcome that did not apply. */\nexport function outcomeMessage(outcome: DispatchOutcome): string | null {\n    switch (outcome.kind) {\n        case 'admitted':\n            return null\n        case 'refused':\n            return REFUSAL_TEXT[outcome.refusal]\n        case 'unknown':\n            return 'The desktop did not confirm the request. The current state is shown; check it before trying again.'\n        case 'failed':\n            return 'The request could not be delivered.'\n    }\n}\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_29","type":"command_execution","command":"/bin/zsh -lc \"sed -n '1,80p' tools/p09/phase_packet.py; rg -n '\"'^def |current_fingerprints|subprocess|write_text|mkdir'\"' tools/p11/proof.py tools/p11/remediation.py tools/p11/standing.py tools/p10/qualification.py; sed -n '860,1035p' tools/p11/proof.py\"","aggregated_output":"\"\"\"Current P09 packet and post-review audit; independent review remains external.\"\"\"\nfrom pathlib import Path\nimport argparse\nimport hashlib\nimport json\nimport os\nimport stat\nimport subprocess\nimport time\n\nimport phase_inputs as inputs\n\nPREVIOUS_PHASE = '6a7253c2'\n\n\ndef digest(value):\n    return hashlib.sha256((json.dumps(value, sort_keys=True, separators=(',', ':')) + '\\n').encode()).hexdigest()\n\n\ndef file_identity(path):\n    metadata = path.lstat()\n    value = {'mode': stat.S_IMODE(metadata.st_mode)}\n    if path.is_symlink():\n        value.update(kind='symlink', target=os.readlink(path))\n    else:\n        inputs.require(path.is_file(), 'unsupported source kind: ' + str(path))\n        value.update(kind='file', sha256=inputs.sha(path))\n    return value\n\n\ndef source_inventory(root):\n    names = subprocess.check_output(['git', 'ls-files', '-z', '--cached', '--others', '--exclude-standard'], cwd=root).decode().split('\\0')\n    excluded = ('docs/planning/evidence/', 'docs/planning/reviews/')\n    def active_tool(name):\n        return ((name.startswith('docs/planning/evidence/P09/native-controller/') and name.endswith('.py'))\n                or name in ['docs/planning/evidence/P09/runs/hash-inputs.sh', 'docs/planning/evidence/P09/runs/run-checks.sh'])\n    return {name: file_identity(root / name) for name in sorted(set(names))\n            if name and name != 'docs/planning/status.md' and (not name.startswith(excluded) or active_tool(name))\n            and ((root / name).exists() or (root / name).is_symlink())}\n\n\ndef live_evidence(root):\n    path = root / 'docs/planning/evidence/C29/live/L19-verify.json'\n    live = inputs.read(path)\n    inputs.require(live['status'] == 'pass' and live['temporary_local_credentials_removed'], 'L19 pass/cleanup missing')\n    inputs.require(live['budget']['total_reserved'] == 3 and live['budget']['refunded'] == 0, 'L19 charged budget changed')\n    receipt = root / live['native_receipt']\n    inputs.require(inputs.sha(receipt) == live['native_receipt_sha256'], 'L19 receipt hash mismatch')\n    raw = inputs.read(receipt)\n    inputs.require(raw['status'] == 'pass' and raw['local_credentials_removed'], 'L19 actual receipt not passing/cleaned')\n    archived = root / 'docs/planning/evidence/C29/live/L19/build-02/l19-qualification-executable.bin'\n    inputs.require(inputs.sha(archived) == raw['executable_sha256'], 'L19 historical executable mismatch')\n    return {'record': str(path.relative_to(root)), 'sha256': inputs.sha(path),\n            'native_receipt': str(receipt.relative_to(root)), 'native_receipt_sha256': inputs.sha(receipt),\n            'qualification_executable': str(archived.relative_to(root)), 'qualification_executable_sha256': inputs.sha(archived),\n            'live_calls_performed_by_this_verifier': 0, 'remaining_live_allowance': 0}\n\n\ndef evidence_inventory(root, run_path, verified):\n    files = set()\n    phase = root / 'docs/planning/evidence/P09'\n    prefixes = [phase / 'native', phase / 'parity', phase / 'screens', phase / 'preparations', phase / 'check-remediation', phase / 'performance', phase / 'phase-tooling-history', phase / 'phase-tooling-validation', run_path.parent / inputs.read(run_path)['attempt'],\n                root / 'docs/planning/evidence/C29/live/L19']\n    prefixes += list((phase / 'native-history').glob('*Worf*'))\n    for prefix in prefixes:\n        files.update(p for p in prefix.rglob('*') if p.is_file() and '__pycache__' not in p.parts)\n    files.update(phase / name for name in ['native-prepare.json', 'native-acceptance.json', 'execution.json']