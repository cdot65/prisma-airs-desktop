  h.finish()\n345:        context: &ContextRef,\n349:        let setup = self.setup_for(context)?;\n359:                context.clone(),\n486:        let setup = self.setup_for_mut(context)?;\n589:            context: setup.context.clone(),\n595:            workspace: self.setup_workspace(&setup.context),\n605:    /// Whether the draft under `context` may complete with `packs` now (the\n606:    /// checks of [`State::complete_setup`], without changing anything):\n610:        context: &ContextRef,\n613:        let setup = self.setup_for(context)?;\n637:    pub(super) fn complete_setup(\n639:        context: &ContextRef,\n643:        self.completable_setup(context, &packs)?;\n644:        let setup = self.setup_for(context)?;\n697:    pub(super) fn discard_setup(&mut self, context: &ContextRef) -> Result<Vec<RecordId>, Refusal> {\n698:        let id = self.setup_for(context)?.tenant.profile.id.clone();\n712:    /// Nothing bound to the draft's context outlives the draft: the cached\n714:    /// flight under its context and under its chosen workspace reference.\n715:    /// Late replies are withdrawn by the pipeline (the context is gone).\n717:        let Some((context, reference)) = self.data.setup.as_ref().map(|s| {\n719:                s.context.clone(),\n725:        self.retire_setup_context(&context, reference.as_ref());\n729:    pub(super) fn retire_setup_context(\n731:        context: &ContextRef,\n734:        self.retire_management_binding(context);\n736:        let mut starts = self.operations.retire_context(context.as_str(), now);\n738:            starts.extend(self.operations.retire_context(reference.as_str(), now));\n775:            \"Management OAuth authenticated successfully.\".to_owned(),\n        else setStatus({ text: C.outcome.failed, retry })\n        return false\n    }\n\n    // ---- welcome: leaving it marks onboarding in progress (Rust-owned) ----\n    async function leaveWelcome() {\n        if (snapshot.onboarding !== 'needed') return go(index + 1)\n        setBusy(true)\n        const outcome = await dispatch({ kind: 'setOnboarding', state: 'inProgress' })\n        setBusy(false)\n        if (report(outcome, null, () => void leaveWelcome())) go(index + 1)\n    }\n\n    // ---- tenant: the profile form drafts or updates the core's setup ----\n    const [form, setForm] = useState<{ name: string; environment: TenantEnvironment; region: Region; tsg: string }>(() => ({\n        name: setup?.tenant.label ?? '',\n        environment: setup?.tenant.environment ?? 'production',\n        region: setup && setup.tenant.destination.kind === 'region' ? setup.tenant.destination.region : 'unitedStates',\n        tsg: setup?.tenant.tsgId ?? '',\n    }))\n    const [errors, setErrors] = useState<Record<string, string>>({})\n    const [touched, setTouched] = useState<Record<string, boolean>>({})\n    const savedProfile = setup ? { name: setup.tenant.label, environment: setup.tenant.environment, region: setup.tenant.destination.kind === 'region' ? setup.tenant.destination.region : 'unitedStates', tsg: setup.tenant.tsgId ?? '' } : null\n    // Displayed details that differ from the draft's, or are invalid, must be\n    // saved or reverted before anything downstream (R7): the core only ever\n    // verifies and commits what it holds.\n    const profileDirty = Boolean(savedProfile && (form.name.trim() !== savedProfile.name || form.environment !== savedProfile.environment || form.region !== savedProfile.region || form.tsg.trim() !== savedProfile.tsg))\n    const revertProfile = () => {\n        if (savedProfile) setForm(savedProfile)\n        setErrors({})\n        setTouched({})\n    }\n    const scanRef = useRef<HTMLInputElement>(null)\n    const secretRef = useRef<HTMLInputElement>(null)\n    const workspaceKeyRef = useRef<HTMLInputElement>(null)\n    useEffect(() => {\n        const fields = [scanRef.current, secretRef.current, workspaceKeyRef.current]\n        const clear = () => { for (const field of fields) if (field) field.value = '' }\n        clear()\n        return clear\n    }, [context])\n    const profileOf = () => ({ label: form.name.trim(), tsgId: form.tsg.trim(), destination: { kind: 'region' as const, region: form.region }, environment: form.environment })\n\n    // A draft creation that is in flight, or whose delivery was not confirmed,\n    // may still produce a draft: Cancel waits for it and discards what appears.\n    const createInFlight = useRef<Promise<DispatchOutcome> | null>(null)\n    // Mirrored in state so a settlement re-runs the cancel decision whatever\n    // order the receipt and the draft snapshot arrive in.\n    const [createPending, setCreatePending] = useState(false)\n    // An admitted creation whose draft has not been observed yet: the draft is\n    // coming, so a cancellation waits for it however long the snapshot takes.\n    const [createAdmitted, setCreateAdmitted] = useState(false)\n    const [createUnknown, setCreateUnknown] = useState<string | null>(null)\n    async function submitProfile(event: FormEvent<HTMLFormElement>) {\n        event.preventDefault()\n        const next = { name: fieldError('name', form.name), tsg: fieldError('tsg', form.tsg) }\n        setTouched({ name: true, tsg: true })\n        setErrors(next)\n        if (next.name || next.tsg) return\n        setBusy(true)\n        let outcome: DispatchOutcome\n        if (setup) outcome = await dispatch({ kind: 'updateTenantSetup', context: setup.context, profile: profileOf() })\n        else {\n            const promise = dispatch({ kind: 'beginTenantSetup', mode, profile: profileOf() })\n            createInFlight.current = promise\n            setCreatePending(true)\n            outcome = await promise\n            createInFlight.current = null\n            if (outcome.kind === 'unknown') setCreateUnknown(snapshot.revision)\n            if (outcome.kind === 'admitted') setCreateAdmitted(true)\n            setCreatePending(false)\n        }\n        setBusy(false)\n        report(outcome, setup ? C.tenant.updated : C.tenant.created(form.name.trim()), () => void submitProfile(event))\n    }\n    useEffect(() => {\n        // A later snapshot settles an unconfirmed creation either way; an admitted\n        // one is settled by the draft it produced.\n        if (createUnknown !== null && createUnknown !== snapshot.revision) setCreateUnknown(null)\n        if (createAdmitted && setup) setCreateAdmitted(false)\n    }, [createUnknown, createAdmitted, setup, snapshot.revision])\n\n    async function saveScanKey(event: FormEvent<HTMLFormElement>) {\n        event.preventDefault()\n        const field = scanRef.current\n        if (!field || !context) return\n        const key = field.value\n        field.value = ''\n        if (!key) return setErrors((e) => ({ ...e, scanKey: C.tenant.errors.scanKey }))\n        setErrors((e) => ({ ...e, scanKey: '' }))\n        setBusy(true)\n        report(await dispatch({ kind: 'configureScanCredential', context, mode: 'keychain', key }), C.tenant.keySaved)\n        setBusy(false)\n    }\n\n    async function saveClient(event: FormEvent<HTMLFormElement>) {\n        event.preventDefault()\n        const secretField = secretRef.current\n        if (!secretField || !context) return\n        const secret = secretField.value\n        secretField.value = ''\n        const clientId = String(new FormData(event.currentTarget).get('clientId') ?? '').trim()\n        if (!clientId) return setErrors((e) => ({ ...e, clientId: C.tenant.errors.clientId }))\n        if (!secret) return setErrors((e) => ({ ...e, clientSecret: C.tenant.errors.clientSecret }))\n        setErrors((e) => ({ ...e, clientId: '', clientSecret: '' }))\n        setBusy(true)\n        report(await dispatch({ kind: 'configureManagementCredential', context, mode: 'keychain', clientId, secret }), C.tenant.clientSaved)\n        setBusy(false)\n    }\n\n    async function remove(kind: 'removeScanCredential' | 'removeManagementCredential', ok: string) {\n        if (!context) return\n        setBusy(true)\n        report(await dispatch({ kind, context }), ok)\n        setBusy(false)\n    }\n\n    // ---- Gateway workspace (optional): list through the management client, choose, key ----\n    const [gatewayOn, setGatewayOn] = useState(false)\n    const [workspaces, setWorkspaces] = useState<{ id: string; name: string }[] | null>(null)\n    const [workspacesNote, setWorkspacesNote] = useState<string | null>(null)\n    const [workspace, setWorkspace] = useState<string>('')\n    // The chosen workspace is core state on the draft (its reference is what the key is configured under).\n    const chosen = setup?.workspace ?? null\n    const [endpoint, setEndpoint] = useState('')\n\n    async function listWorkspaces() {\n        if (!context) return\n        setWorkspacesNote(C.tenant.readingWorkspaces)\n        setWorkspaces(null)\n        const outcome = await readManagement(dispatch, props.observeManagement, context, { kind: 'gateway', workspace: null, read: { kind: 'inventory', resource: 'workspaces' } })\n        if (outcome.kind !== 'result') return setWorkspacesNote(outcome.kind === 'notAdmitted' ? outcome.message : C.outcome.failed)\n        const result = outcome.result\n        if (result.kind !== 'gateway' || result.gateway.kind !== 'list') return setWorkspacesNote(result.kind === 'failed' ? C.outcome.failed : C.tenant.noWorkspaces)\n        const rows = (JSON.parse(result.gateway.list.rows) as Record<string, unknown>[])\n            .filter((r) => typeof r.id === 'string')\n            .map((r) => ({ id: String(r.id), name: typeof r.name === 'string' && r.name ? r.name : String(r.id) }))\n        setWorkspaces(rows)\n        setWorkspace(rows[0]?.id ?? '')\n        setWorkspacesNote(rows.length ? null : C.tenant.noWorkspaces)\n    }\n\n    async function chooseWorkspace() {\n        if (!context || !workspace) return\n        setBusy(true)\n        const outcome = await dispatch({ kind: 'selectGatewayWorkspace', context, workspace })\n\"\"\"C45 fixture process ownership: exact bundle, executable and PID lifetime.\n\nNo process-name signaling, argument inspection, foreign adoption or installed-app\nlookup. macOS struct layout comes from the selected SDK sys/proc_info.h.\n\"\"\"\nfrom dataclasses import dataclass\nfrom pathlib import Path\nimport ctypes\nimport hashlib\nimport json\nimport os\nimport plistlib\nimport signal\nimport subprocess\nimport sys\nimport time\n\nFIXTURE_ID = 'io.cdot.airs-desktop.fixture'\nEXECUTABLE = 'prisma-airs-desktop'\n\n@dataclass(frozen=True)\nclass Identity:\n    pid: int\n    executable: str\n    birth: tuple\n    parent: int\n\nclass _BsdInfo(ctypes.Structure):\n    _fields_ = [('header', ctypes.c_uint32 * 12), ('comm', ctypes.c_char * 16),\n                ('name', ctypes.c_char * 32), ('misc', ctypes.c_uint32 * 5),\n                ('nice', ctypes.c_int32), ('seconds', ctypes.c_uint64), ('micros', ctypes.c_uint64)]\n\nclass MacProcesses:\n    def __init__(self):\n        if sys.platform != 'darwin':\n            raise RuntimeError('native process ownership requires macOS')\n        self.lib = ctypes.CDLL('/usr/lib/libproc.dylib', use_errno=True)\n        self.lib.proc_pidpath.argtypes = [ctypes.c_int, ctypes.c_void_p, ctypes.c_uint32]\n        self.lib.proc_pidpath.restype = ctypes.c_int\n        self.lib.proc_pidinfo.argtypes = [ctypes.c_int, ctypes.c_int, ctypes.c_uint64, ctypes.c_void_p, ctypes.c_int]\n        self.lib.proc_pidinfo.restype = ctypes.c_int\n\n    def snapshot(self, pid):\n        path = ctypes.create_string_buffer(4096)\n        info = _BsdInfo()\n        if self.lib.proc_pidpath(pid, path, len(path)) <= 0:\n            return None\n        if self.lib.proc_pidinfo(pid, 3, 0, ctypes.byref(info), ctypes.sizeof(info)) != ctypes.sizeof(info):\n            return None\n        if info.header[3] != pid:\n            return None\n        return Identity(pid, os.path.realpath(os.fsdecode(path.value)), (info.seconds, info.micros), info.header[4])\n\n    def pids(self):\n        return [int(p) for p in subprocess.check_output(['/bin/ps', '-axo', 'pid='], text=True).split()]\n\n    def send(self, pid, sig):\n        os.kill(pid, sig)\n\nclass Candidate:\n    def __init__(self, bundle, processes=None, record=None):\n        self.bundle = Path(bundle).resolve(strict=True)\n        info = plistlib.loads((self.bundle/'Contents/Info.plist').read_bytes())\n        if info.get('CFBundleIdentifier') != FIXTURE_ID or info.get('CFBundleExecutable') != EXECUTABLE:\n            raise ValueError('only the chosen C45 fixture bundle is allowed')\n        app_path=(self.bundle/'Contents/MacOS'/EXECUTABLE).resolve(strict=True)\n        engine_path=(self.bundle/'Contents/Resources/harness/airs-harness').resolve()\n        if not app_path.is_relative_to(self.bundle) or not engine_path.is_relative_to(self.bundle):\n            raise ValueError('candidate executable or engine escapes its fixture bundle')\n        self.app_path=str(app_path)\n        self.engine_path=str(engine_path)\n        self.processes = processes if processes is not None else MacProcesses()\n        self.record = Path(record) if record else None\n        self.app = None\n        self.engines_owned = {}\n        self.child = None\n\n    def matching(self, path):\n        return [s for pid in self.processes.pids() if (s := self.processes.snapshot(pid)) and s.executable == path]\n\n    def valid(self, identity):\n        if identity is None:return False\n        current=self.processes.snapshot(identity.pid)\n        return current is not None and (current.pid,current.executable,current.birth)==(identity.pid,identity.executable,identity.birth)\n\n    def publish(self):\n        if self.record:\n            def value(s):return dict(pid=s.pid, executable=s.executable, birth=s.birth, parent=s.parent)\n            data={'schema':'airs-desktop/candidate-processes/1','bundle':str(self.bundle),\n                  'app':value(self.app) if self.app else None,\n                  'engines':[value(s) for s in self.engines_owned.values()],\n                  'meaning':'Observed exact executable/PID birth identities owned by this driver; no process-name or installed-app lookup.'}\n            self.record.parent.mkdir(parents=True,exist_ok=True)\n            self.record.write_text(json.dumps(data,indent=2)+'\\n')\n\n    def app_pid(self):\n        matches = self.matching(self.app_path)\n        if len(matches)>1:\n            raise RuntimeError('multiple candidate processes; no UI or signal allowed')\n        if self.valid(self.app):return self.app.pid\n        if matches:\n            raise RuntimeError('candidate process is not owned by this driver; inspect durable ownership')\n        return None\n\n    def adopt_child(self, pid, parent):\n        identity=self.processes.snapshot(pid)\n        if not identity or identity.executable!=self.app_path or identity.parent!=parent:\n            raise RuntimeError('launched child identity does not match the bound fixture')\n        self.app=identity;self.publish();return pid\n\n    def launch(self):\n        if self.matching(self.app_path) or self.matching(self.engine_path):\n            raise RuntimeError('unowned candidate process exists; no automatic cleanup or duplicate writer')\n        self.child=subprocess.Popen([self.app_path], stdin=subprocess.DEVNULL,\n                                    stdout=subprocess.DEVNULL,stderr=subprocess.DEVNULL)\n        deadline=time.monotonic()+6\n        while time.monotonic()<deadline:\n            if self.child.poll() is not None:raise RuntimeError('fixture executable exited during launch')\n            s=self.processes.snapshot(self.child.pid)\n            if s and s.executable==self.app_path:return self.adopt_child(self.child.pid,os.getpid())\n            time.sleep(.05)\n        raise RuntimeError('fixture child identity was not observed')\n\n    def engines(self):\n        app_pid=self.app_pid()\n        for identity in self.matching(self.engine_path):\n            current=identity;seen=set()\n            while app_pid and current and current.pid not in seen:\n                if current.parent==app_pid:\n                    self.engines_owned[identity.pid]=identity;break\n                seen.add(current.pid);current=self.processes.snapshot(current.parent)\n        self.engines_owned={pid:s for pid,s in self.engines_owned.items() if self.valid(s)}\n        self.publish();return sorted(self.engines_owned)\n\n    def signal_identity(self, identity, sig):\n        if not self.valid(identity):return False\n        self.processes.send(identity.pid,sig);return True\n\n    def signal_app(self, sig=signal.SIGTERM):\n        self.engines()  # establish owned descendants before their parent exits\n        return self.signal_identity(self.app,sig)\n\n    def signal_engine(self,pid,sig=signal.SIGKILL):\n        self.engines();return self.signal_identity(self.engines_owned.get(pid),sig)\n\n    def stop_engines(self):\n        for pid in self.engines():self.signal_engine(pid)\n\n_bound = None\n\ndef bind(bundle):\n    global _bound\n    path=Path(bundle).resolve(strict=True)\n    if _bound is not None and _bound.bundle != path:\n        raise RuntimeError('one driver cannot switch fixture candidates')\n    if _bound is None:\n        prepare=os.environ.get('AIRS_NATIVE_PREPARE')\n        if prepare:\n            p=json.loads(Path(prepare).read_text());expected=(Path.cwd()/p['bundle']).resolve(strict=True)\n            if path!=expected:raise RuntimeError('bundle differs from declared native preparation')\n            executable=path/'Contents/MacOS'/EXECUTABLE\n            if hashlib.sha256(executable.read_bytes()).hexdigest()!=p['executable_sha256']:\n                raise RuntimeError('prepared executable changed')\n        _bound=Candidate(path,record=os.environ.get('AIRS_NATIVE_PROCESS_RECORD'))\n    return _bound\n\ndef current():\n    if _bound is not None:return _bound\n    prepare=os.environ.get('AIRS_NATIVE_PREPARE')\n    if prepare:return bind(Path.cwd()/json.loads(Path(prepare).read_text())['bundle'])\n    return None\n\ndef app_pid():\n    candidate=current();return candidate.app_pid() if candidate else None\n\ndef engine_pids():\n    candidate=current();return candidate.engines() if candidate else []\n\ndef stop_app(sig=signal.SIGTERM):\n    candidate=current()\n    if candidate:candidate.signal_app(sig)\n\ndef stop_engines():\n    candidate=current()\n    if candidate:candidate.stop_engines()\n\ndef signal_engine(pid,sig=signal.SIGKILL):\n    candidate=current();return candidate.signal_engine(pid,sig) if candidate else False\n","exit_code":0,"status":"completed"}}
