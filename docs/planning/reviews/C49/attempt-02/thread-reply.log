t input = &hashes[&package_label(name, \"input\")];\n        if input == \"absent\" {\n            return Err(invalid(format!(\n                \"locked shared input for {name} is absent from .inputs/academy; run fetch-inputs\"\n            )));\n        }\n        for place in [\"scratch\", \"installed\"] {\n            let label = package_label(name, place);\ncrates/xtask/src/env.rs:197:    /// Hash of the toolchain identities, part of the dependency fingerprint.\ncrates/xtask/src/env.rs:198:    pub fn toolchain_hash(&self) -> String {\ncrates/xtask/src/cli.rs:10:    Repo, Result, Subject, bindings, complete, fingerprint, gate, invalid, ledger, native, package,\ncrates/xtask/src/cli.rs:23:  fingerprint       --chunk Cxx|--phase Pxx\ncrates/xtask/src/cli.rs:198:                fingerprint::verify_consumed_shared(&repo)?;\ncrates/xtask/src/cli.rs:264:            let current = fingerprint::all(&repo, &manifest, subject, &env.toolchain_hash())?;\ncrates/xtask/src/cli.rs:303:            let current = fingerprint::all(&repo, &manifest, subject, &env.toolchain_hash())?;\ncrates/xtask/src/cli.rs:323:        \"fingerprint\" => {\ncrates/xtask/src/cli.rs:327:            let fp = fingerprint::all(&repo, &manifest, args.subject()?, &env.toolchain_hash())?;\ncrates/xtask/src/cli.rs:588:    fingerprint::verify_consumed_shared(repo)?;\nzsh:1: no matches found: docs/planning/evidence/P11/impact-selection-01/*transition*\n","exit_code":1,"status":"failed"}}
