GS\",\n    \"RUSTDOCFLAGS\",\n    \"CARGO_ENCODED_RUSTFLAGS\",\n    \"RUSTC_WRAPPER\",\n    \"RUSTC_WORKSPACE_WRAPPER\",\n    \"CARGO_BUILD_TARGET\",\n    \"CARGO_TARGET_DIR\",\n    \"NODE_OPTIONS\",\n    \"NODE_PATH\",\n    \"TAURI_CONFIG\",\n    \"TAURI_SIGNING_PRIVATE_KEY\"\n  ],\n  \"reject_inherited_prefixes\": [\n    \"npm_config_\",\n    \"VITE_\",\n    \"PNPM_\"\n  ]\n}\n-rwxr-xr-x  1 admin  staff  175520824 Nov  4 14:26 target/debug/xtask\n\n.tools/bin:\ntotal 8\n-rwxr-xr-x  1 admin  staff  254 Nov  4 14:18 pnpm\n\nrunning 3 tests\ntest store::tests::color_theme_defaults_existing_state_without_changing_appearance ... ok\ntest store::tests::alternate_color_theme_roundtrips_independently_of_appearance ... ok\ntest authority::tests::color_theme_is_persisted_without_changing_appearance_or_tenant_scope ... ok\n\ntest result: ok. 3 passed; 0 failed; 0 ignored; 0 measured; 228 filtered out; finished in 0.02s\n\n\n--- stderr ---\n   Compiling desktop-core v1.0.0 (/Users/cdot/development/redtail/p09-queue/refinement-20261104/core/crates/desktop-core)\n    Finished `test` profile [unoptimized + debuginfo] target(s) in 14.25s\n     Running unittests src/lib.rs (target/debug/deps/desktop_core-ca515594acbdf855)\n17:test result: ok. 13 passed; 0 failed; 0 ignored; 0 measured; 0 filtered out; finished in 0.92s\n21:test metadata_edit_targets_only_the_selected_profile_without_rebinding_identity ... ok\n22:test metadata_edit_rolls_back_when_private_persistence_fails ... ok\n23:test metadata_edit_rejects_invalid_labels_and_has_no_tsg_or_endpoint_fields ... ok\n25:test result: ok. 3 passed; 0 failed; 0 ignored; 0 measured; 0 filtered out; finished in 0.02s\n39:test result: ok. 9 passed; 0 failed; 0 ignored; 0 measured; 0 filtered out; finished in 0.17s\n54:test result: ok. 10 passed; 0 failed; 0 ignored; 0 measured; 0 filtered out; finished in 0.10s\n61:test result: ok. 2 passed; 0 failed; 0 ignored; 0 measured; 0 filtered out; finished in 0.02s\n68:     Running tests/refineme