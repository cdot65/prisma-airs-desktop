\": \"docs/planning/evidence/P11/fixture-code-access-verification-01/validator-receipt.json\",\n    \"sha256\": \"fa0760cc72e0d950ddff174883c843f441d1530003dcaa6d75cd40521967dd06\"\n  },\n  \"picker_cleanup\": {\n    \"path\": \"docs/planning/evidence/P11/recovery-native-02/picker-cleanup.json\",\n    \"sha256\": \"4e5aa3fdf221e15688b8eaffb4041082f903fce7e44aeb16d4902426a6eb20c7\"\n  },\n  \"prior_failed_recovery\": {\n    \"path\": \"docs/planning/evidence/P11/recovery-native-01/raw/observations.json\",\n    \"sha256\": \"ac09eff6d60b38fd0a5f0496ae9579f884839c2fe52eb33541fcddd909fb6351\"\n  },\n  \"recorded_utc\": \"2026-11-04T21:52:55.826915+00:00\",\n  \"execution_condition_changes\": \"Dedicated synthetic fixture item only: append exact new ad-hoc code requirement, retain old ACL/item value/all other metadata. The original ACL-helper exit1/postcheck failure and recovery01 admission failure remain unchanged. Independent read-only metadata verification and the actual recovery02 existing-key read establish the current fixture admission. No byte-identical application or universal OS-permission equality is claimed.\"\n}\nNATIVE 35\n","exit_code":0,"status":"completed"}}
