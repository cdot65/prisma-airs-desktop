{"type":"item.completed","item":{"id":"item_49","type":"command_execution","command":"/bin/zsh -lc \"sed -n '590,712p' crates/desktop-core/src/authority/setup_domain.rs; sed -n '60,100p' crates/desktop-core/src/authority/setup_domain.rs; rg -n 'recheck|complete|persistence|cancell|late|authentication' crates/desktop-core/tests/ui_v2_onboarding/main.rs crates/desktop-core/tests/ui_v2_setup_reads/main.rs | tail -45; cat apps/desktop/src/modules/academy/academy-account.tsx\"","aggregated_output":"            tenant: super::tenant_view(&setup.tenant),\n            products: setup.products.clone(),\n            scan_required: false,\n            management_required: true,\n            packs,\n            workspace: self.setup_workspace(&setup.context),\n            verify,\n            completable,\n        })\n    }\n\n    /// Commits the draft: it becomes a tenant with its products and the\n    /// verify warnings, is made active, and a first run's onboarding is\n    /// done. Refused unless the current inputs were verified without a\n    /// failure (the presentation cannot skip or forge a check).\n    /// Whether the draft under `context` may complete with `packs` now (the\n    /// checks of [`State::complete_setup`], without changing anything):\n    /// the draft tenant's id when it may.\n    pub(super) fn completable_setup(\n        &self,\n        context: &ContextRef,\n        packs: &[ProductId],\n    ) -> Result<TenantId, Refusal> {\n        let setup = self.setup_for(context)?;\n        let view = Self::verify_view(setup).ok_or(Refusal::InvalidInput)?;\n        if !view.done || view.blocking || view.stale {\n            return Err(Refusal::InvalidInput);\n        }\n        if !setup\n            .tenant\n            .profile\n            .tsg_id\n            .as_deref()\n            .is_some_and(crate::management::tsg_is_valid)\n            || !matches!(setup.tenant.management, ScanCapability::Ready { .. })\n        {\n            return Err(Refusal::InvalidInput);\n        }\n        if packs.iter().any(|p| !setup.products.contains(p)) {\n            return Err(Refusal::InvalidInput);\n        }\n        if self.data.tenants.len() >= MAX_TENANTS {\n            return Err(Refusal::Busy);\n        }\n        Ok(setup.tenant.profile.id.clone())\n    }\n\n    pub(super) fn complete_setup(\n        &mut self,\n        context: &ContextRef,\n        packs: Vec<ProductId>,\n        recorded_secs: u32,\n    ) -> Result<Completed, Refusal> {\n        self.completable_setup(context, &packs)?;\n        let setup = self.setup_for(context)?;\n        let view = Self::verify_view(setup).ok_or(Refusal::InvalidInput)?;\n        // Stage only Data before persistence. Authority retirement is\n        // irreversible and waits for the handler's successful save.\n        let retired_workspace = self.setup_workspace_reference();\n        let Some(mut setup) = self.data.setup.take() else {\n            return Err(Refusal::StaleContext);\n        };\n        let first_run = setup.mode == SetupMode::FirstRun;\n        setup.tenant.products = setup.products.clone();\n        for (n, w) in view.warnings.into_iter().take(MAX_WARNINGS).enumerate() {\n            setup\n                .tenant\n                .setup_warnings\n                .push(crate::features::SetupWarning {\n                    id: format!(\"vw-{}\", n + 1),\n                    product: w.product,\n                    reason: w.reason,\n                    recorded_secs,\n                    check: Some(super::setup_warning_domain::binding_for(\n                        &setup.tenant,\n                        super::setup_warning_domain::line_for(w.product),\n                        setup\n                            .gateway\n                            .selection\n                            .as_ref()\n                            .map(|s| crate::gateway::WorkspaceScope::from(&s.workspace)),\n                    )),\n                    recheck: None,\n                    resolved_secs: None,\n                });\n        }\n        let id = setup.tenant.profile.id.clone();\n        self.data.tenants.push(setup.tenant);\n        self.data.active = Some(id.clone());\n        if first_run {\n            self.data.onboarding = Some(OnboardingState::Done);\n        }\n        let packs = packs\n            .iter()\n            .flat_map(|p| case_products(*p).iter().copied())\n            .collect();\n        Ok(Completed {\n            tenant: id,\n            first_run,\n            packs,\n            retired_workspace,\n        })\n    }\n\n    /// Drops the draft. Its Keychain records go to the cleanup queue; the\n    /// returned session records are the caller's to delete. No tenant,\n    /// selection or onboarding state changes.\n    pub(super) fn discard_setup(&mut self, context: &ContextRef) -> Result<Vec<RecordId>, Refusal> {\n        let id = self.setup_for(context)?.tenant.profile.id.clone();\n        let mut retired = Vec::new();\n        for class in [\n            CredentialClass::Scan,\n            CredentialClass::Management,\n            CredentialClass::Inference,\n        ] {\n            retired.extend(self.retire_class(&id, class));\n        }\n        self.retire_setup_authority();\n        self.data.setup = None;\n        Ok(retired)\n    }\n\n    /// Nothing bound to the draft's context outlives the draft: the cached\n    pub packs: Vec<CaseProduct>,\n    pub retired_workspace: Option<WorkspaceRef>,\n}\n\nconst MAX_WARNINGS: usize = 8;\n\n/// The bundled case-catalog counts per product (the packs step).\nfn pack_counts() -> &'static [(CaseProduct, u32)] {\n    static COUNTS: OnceLock<Vec<(CaseProduct, u32)>> = OnceLock::new();\n    COUNTS.get_or_init(|| {\n        let cases = crate::library::parse_catalog(crate::library::BUNDLED_CATALOG, \"catalog\")\n            .unwrap_or_default();\n        let mut counts: Vec<(CaseProduct, u32)> = Vec::new();\n        for case in cases {\n            match counts.iter_mut().find(|(p, _)| *p == case.product) {\n                Some((_, n)) => *n += 1,\n                None => counts.push((case.product, 1)),\n            }\n        }\n        counts\n    })\n}\n\n/// The case-catalog products a chosen product's starter pack holds.\npub(super) fn case_products(product: ProductId) -> &'static [CaseProduct] {\n    match product {\n        ProductId::RuntimeSecurity => &[CaseProduct::RuntimeSecurity],\n        ProductId::Gateway => &[CaseProduct::AiGateway],\n        ProductId::RedTeam => &[CaseProduct::AiRedTeaming],\n        ProductId::ModelSkill => &[CaseProduct::ModelSecurity, CaseProduct::SkillScanning],\n    }\n}\n\nfn needs_management(product: ProductId) -> bool {\n    product != ProductId::RuntimeSecurity\n}\n\n/// The verify step's reason for a management failure.\nfn failure_reason(failure: ManagementFailure) -> &'static str {\n    match failure {\n        ManagementFailure::Unauthorized => {\ncrates/desktop-core/tests/ui_v2_onboarding/main.rs:221:        desk.send(json!({\"kind\": \"completeTenantSetup\", \"context\": context, \"packs\": []}))\ncrates/desktop-core/tests/ui_v2_onboarding/main.rs:258:        \"a stored Scan Key is not OAuth authentication\"\ncrates/desktop-core/tests/ui_v2_onboarding/main.rs:263:async fn changing_inputs_makes_authentication_stale_and_product_permissions_warn() {\ncrates/desktop-core/tests/ui_v2_onboarding/main.rs:291:        desk.send(json!({\"kind\": \"completeTenantSetup\", \"context\": context, \"packs\": []}))\ncrates/desktop-core/tests/ui_v2_onboarding/main.rs:369:        desk.send(json!({\"kind\": \"completeTenantSetup\", \"context\": context, \"packs\": [\"redTeam\"]}))\ncrates/desktop-core/tests/ui_v2_onboarding/main.rs:374:        json!({\"kind\": \"completeTenantSetup\", \"context\": context, \"packs\": [\"runtimeSecurity\"]}),\ncrates/desktop-core/tests/ui_v2_onboarding/main.rs:377:    .expect(\"completed\");\ncrates/desktop-core/tests/ui_v2_onboarding/main.rs:519:async fn add_mode_without_a_key_verifies_with_a_warning_and_completes_switching_once() {\ncrates/desktop-core/tests/ui_v2_onboarding/main.rs:537:    desk.send(json!({\"kind\": \"completeTenantSetup\", \"context\": context, \"packs\": []}))\ncrates/desktop-core/tests/ui_v2_onboarding/main.rs:539:        .expect(\"completed\");\ncrates/desktop-core/tests/ui_v2_setup_reads/main.rs:692:        desk.send(json!({\"kind\": \"completeTenantSetup\", \"context\": context, \"packs\": []}))\ncrates/desktop-core/tests/ui_v2_setup_reads/main.rs:699:    assert!(after.setup.is_some(), \"failed authentication stays a draft\");\ncrates/desktop-core/tests/ui_v2_setup_reads/main.rs:757:    desk.send(json!({\"kind\": \"completeTenantSetup\", \"context\": context, \"packs\": []}))\ncrates/desktop-core/tests/ui_v2_setup_reads/main.rs:759:        .expect(\"completed\");\ncrates/desktop-core/tests/ui_v2_setup_reads/main.rs:826:    // The read queued under the draft settles cancelled, not with a result.\ncrates/desktop-core/tests/ui_v2_setup_reads/main.rs:914:        desk.send(json!({\"kind\": \"completeTenantSetup\", \"context\": wrong_context, \"packs\": []}))\ncrates/desktop-core/tests/ui_v2_setup_reads/main.rs:971:// Owner refinement: management authentication gates every new tenant; a\ncrates/desktop-core/tests/ui_v2_setup_reads/main.rs:974:async fn refinement_oauth_authentication_does_not_require_profile_permission() {\ncrates/desktop-core/tests/ui_v2_setup_reads/main.rs:1023:        \"authentication must not inventory Runtime profiles\"\ncrates/desktop-core/tests/ui_v2_setup_reads/main.rs:1025:    desk.send(json!({\"kind\": \"completeTenantSetup\", \"context\": context, \"packs\": []}))\ncrates/desktop-core/tests/ui_v2_setup_reads/main.rs:1027:        .expect(\"complete\");\ncrates/desktop-core/tests/ui_v2_setup_reads/main.rs:1038:async fn refinement_missing_oauth_cannot_complete_an_add_draft() {\ncrates/desktop-core/tests/ui_v2_setup_reads/main.rs:1058:        desk.send(json!({\"kind\": \"completeTenantSetup\", \"context\": context, \"packs\": []}))\ncrates/desktop-core/tests/ui_v2_setup_reads/main.rs:1070:async fn refinement_invalid_oauth_cannot_complete_an_add_draft() {\ncrates/desktop-core/tests/ui_v2_setup_reads/main.rs:1097:        \"invalid OAuth is a blocking authentication failure, not an optional product warning\"\ncrates/desktop-core/tests/ui_v2_setup_reads/main.rs:1100:        desk.send(json!({\"kind\": \"completeTenantSetup\", \"context\": context, \"packs\": []}))\ncrates/desktop-core/tests/ui_v2_setup_reads/main.rs:1157:        desk.send(json!({\"kind\": \"completeTenantSetup\", \"context\": context, \"packs\": []}))\ncrates/desktop-core/tests/ui_v2_setup_reads/main.rs:1172:async fn refinement_issuer_400_is_an_authentication_failure() {\ncrates/desktop-core/tests/ui_v2_setup_reads/main.rs:1177:async fn refinement_issuer_401_is_an_authentication_failure() {\ncrates/desktop-core/tests/ui_v2_setup_reads/main.rs:1182:async fn refinement_issuer_403_does_not_prove_authentication() {\nimport { useId, useState } from 'react'\nimport { Button, Callout } from '@ai-security-academy/presentation'\nimport { AlertTriangle, CheckCircle2, Info } from 'lucide-react'\nimport type { AcademyFailure, AcademyView, Intent, VaultError } from '@prisma-airs/desktop-contracts'\nimport { type Dispatch, outcomeMessage } from '../tenants/dispatch'\n\nconst FAILURE_TEXT: Record<AcademyFailure, string> = {\n    notConfigured: 'Academy desktop sign-in is not available on this server.',\n    invalidConfig: 'Academy returned a sign-in configuration the desktop cannot trust.',\n    network: 'Academy could not be reached. Check your connection and try again.',\n    invalidResponse: 'Academy returned an unexpected sign-in response. Try again.',\n    denied: 'Sign-in was declined in the browser.',\n    expired: 'The sign-in code expired before it was approved. Start again.',\n    sessionExpired: 'Your Academy session expired. Sign in again.',\n    scopeMissing: 'Academy did not grant learning access to this sign-in.',\n    accountChanged: 'Academy changed its sign-in configuration. Sign in again.',\n    authFailed: 'Academy sign-in could not complete. Try again.',\n}\n\nconst VAULT_TEXT: Record<VaultError, string> = {\n    locked: 'Secure storage is locked, so the session could not be saved. Unlock it and sign in again.',\n    denied: 'The system did not allow the Academy session to be saved in secure storage.',\n    unavailable: 'Secure storage is not available, so the session could not be saved.',\n    notFound: 'The saved Academy session is missing from secure storage.',\n    corrupt: 'The saved Academy session could not be read.',\n}\n\ninterface Props {\n    view: AcademyView\n    dispatch: Dispatch\n}\n\n/**\n * The Academy learner account, independent of AIRS tenants. Sign-in is a\n * browser device flow: the desktop shows a code, opens the Academy page the\n * issuer named, and never sees a password. Tokens stay in the native core.\n */\nexport function AcademyAccount({ view, dispatch }: Props) {\n    const legend = useId()\n    const [busy, setBusy] = useState(false)\n    const [message, setMessage] = useState<string | null>(null)\n\n    async function send(intent: Intent) {\n        setBusy(true)\n        setMessage(null)\n        const outcome = await dispatch(intent)\n        setBusy(false)\n        setMessage(outcomeMessage(outcome))\n    }\n\n    return (\n        <fieldset\n            aria-labelledby={legend}\n            aria-busy={busy}\n            data-slot='academy-account'\n            className='settings-card'\n        >\n            <legend id={legend} className='text-academy-ink px-1 text-[15px] font-semibold'>\n                Academy account\n            </legend>\n            <p className='text-academy-ink-soft text-[13px]'>\n                Your Academy learner account is separate from AIRS tenants; switching tenants does not change it.\n            </p>\n            <div role='status' aria-live='polite' className='flex flex-col gap-3'>\n                <State view={view} busy={busy} send={send} />\n            </div>\n            {message ? (\n                <p role='alert' data-slot='academy-message' className='text-academy-accent-warn text-[13px]'>\n                    {message}\n                </p>\n            ) : null}\n        </fieldset>\n    )\n}\n\nfunction State({ view, busy, send }: { view: AcademyView; busy: boolean; send: (intent: Intent) => Promise<void> }) {\n    switch (view.state) {\n        case 'signedOut':\n            return (\n                <div className='flex flex-col items-start gap-3'>\n                    <p className='text-academy-ink text-[13px]'>Not signed in to Academy.</p>\n                    <Button type='button' tier='primary' disabled={busy} onClick={() => void send({ kind: 'startAcademySignIn' })}>\n                        Sign in to Academy\n                    </Button>\n                </div>\n            )\n        case 'starting':\n        case 'completing':\n            return (\n                <div className='flex flex-col items-start gap-3'>\n                    <p className='text-academy-ink text-[13px]'>\n                        {view.state === 'starting' ? 'Contacting Academy…' : 'Approved. Finishing sign-in…'}\n                    </p>\n                    <Button type='button' tier='secondary' onClick={() => void send({ kind: 'cancelAcademySignIn' })}>\n                        Cancel sign-in\n                    </Button>\n                </div>\n            )\n        case 'awaitingApproval':\n            return (\n                <div className='flex flex-col items-start gap-3' data-slot='academy-code'>\n                    <p className='text-academy-ink text-[13px]'>Enter this code on the Academy sign-in page:</p>\n                    <p\n                        className='font-mono text-academy-ink text-[24px] font-semibold tracking-[0.12em] select-all'\n                        aria-label={`Sign-in code ${view.userCode.split('').join(' ')}`}\n                    >\n                        {view.userCode}\n                    </p>\n                    <p className='text-academy-ink-faint text-[12px] break-all'>\n                        {view.verificationUri} · expires in {Math.max(1, Math.ceil(view.expiresIn / 60))} min\n                    </p>\n                    <div className='flex flex-wrap gap-2'>\n                        <Button type='button' tier='primary' onClick={() => void send({ kind: 'openAcademyVerification' })}>\n                            Open sign-in page\n                        </Button>\n                        <Button type='button' tier='secondary' onClick={() => void send({ kind: 'cancelAcademySignIn' })}>\n                            Cancel sign-in\n                        </Button>\n                    </div>\n                </div>\n            )\n        case 'signedIn':\n            return (\n                <div className='flex flex-col items-start gap-3'>\n                    <Callout tone='success' icon={CheckCircle2}>\n                        <p>\n                            Signed in to Academy as <span className='font-semibold'>{view.displayName}</span>.\n                        </p>\n                    </Callout>\n                    <Button type='button' tier='secondary' disabled={busy} onClick={() => void send({ kind: 'signOutAcademy' })}>\n                        Sign out of Academy\n                    </Button>\n                </div>\n            )\n        case 'failed':\n            return (\n                <div className='flex flex-col items-start gap-3'>\n                    <Callout tone='warning' icon={view.failure === 'network' ? Info : AlertTriangle} data-slot='academy-failure'>\n                        {view.displayName ? <p className='font-semibold'>{view.displayName}</p> : null}\n                        <p>{view.vault ? VAULT_TEXT[view.vault] : FAILURE_TEXT[view.failure]}</p>\n                    </Callout>\n                    <div className='flex flex-wrap gap-2'>\n                        <Button type='button' tier='primary' disabled={busy} onClick={() => void send({ kind: 'startAcademySignIn' })}>\n                            Sign in again\n                        </Button>\n                        <Button type='button' tier='secondary' disabled={busy} onClick={() => void send({ kind: 'signOutAcademy' })}>\n                            Sign out of Academy\n                        </Button>\n                    </div>\n                </div>\n            )\n    }\n}\n","exit_code":0,"status":"completed"}}
