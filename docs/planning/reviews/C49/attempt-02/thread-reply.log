{"type":"item.completed","item":{"id":"item_33","type":"command_execution","command":"/bin/zsh -lc \"sed -n '647,822p' tools/p11/proof.py; cat tools/p10/qualification.py\"","aggregated_output":"def verify_plan(source, plan, check_dispositions=None):\n    expected = {}\n    for kind in ('check', 'test'):\n        for row in command_plan(source, kind):\n            # Setup is real, recorded, and validated as part of each raw run.\n            if row['label'].startswith('setup/'):\n                continue\n            expected[f'{kind}:{row[\"label\"]}'] = {\n                'kind': 'command', 'argv': row['argv'],\n                'label': row['label'],\n                'expects_tests': row['expects_tests']}\n    native = read(source / 'docs/architecture/native-checks.json')['chunks']\n    for chunk in CHUNKS:\n        for row in native[chunk]:\n            expected[row['id']] = {'kind': 'native'}\n    rows = plan['requirements']\n    require(len(rows) == len(expected) and {row['id'] for row in rows} == set(expected),\n            'P11 proof omits, duplicates or adds required coverage')\n    for row in rows:\n        require(all(row.get(key) == value for key, value in expected[row['id']].items()),\n                'P11 approved requirement changed')\n        affected = not (check_dispositions and check_dispositions.get(row['id']) in\n                        ('carried_unaffected', 'reused_exact'))\n        require(row.get('affected') is affected and row.get('must_execute') is affected,\n                'changed P11 coverage cannot be silently carried')\n\n\ndef verify_coverage(root, qualified, historical=None):\n    \"\"\"P11 check selection plus the unchanged generic test/native consumer.\"\"\"\n    if 'review_remediation' in qualified:\n        import remediation\n        return remediation.verify_coverage(root, qualified, historical=historical)\n    if 'impact_selection' in qualified:\n        return verify_impact_coverage(root, qualified, historical=historical)\n    if 'check_selection' not in qualified:\n        source = historical.source(qualified['source_inventory_sha256']) if historical else root\n        verify_plan(source, read(bound(root, qualified['plan'])))\n        require(all(row['disposition'] == 'executed' for row in qualified['coverage']),\n                'changed P11 coverage was not executed')\n        return coverage.verify(root, qualified, historical=historical)\n    candidate = read(bound(root, qualified['candidate']))\n    source = historical.source(qualified['source_inventory_sha256']) if historical else root\n    check_source = read(bound(root, qualified['check_source']))\n    require(digest(check_source['files']) == qualified['source_inventory_sha256'],\n            'check selection source does not bind qualified source')\n    selection = validate_check_selection(root, bound(root, qualified['check_selection']),\n        candidate['runner_inputs'], source=source,\n        files=check_source['files'] if historical else None)\n    require(qualified['check_source'] == selection['selection']['current_source'],\n            'check selection source reference differs')\n    require(selection['selection']['execution_root'] == candidate['execution_root'],\n            'check selection original execution root differs from candidate')\n    selected = {'check:' + row['needed']['label']: row for row in selection['selected']\n                if not row['needed']['label'].startswith('setup/')}\n    plan = read(bound(root, qualified['plan']))\n    verify_plan(source, plan, {cid: row['disposition'] for cid, row in selected.items()})\n    rows = qualified['coverage']\n    require(len(rows) == len(plan['requirements']) and {r['id'] for r in rows}\n            == {r['id'] for r in plan['requirements']}, 'check coverage membership differs')\n    for row in rows:\n        if row['id'] not in selected:\n            continue\n        chosen = selected[row['id']]\n        raw, actual, path = chosen['raw'], chosen['actual'], chosen['path']\n        result = read(bound(root, row['result']))\n        require(row['disposition'] == chosen['disposition'] and result == {\n            'status': 'pass', 'exit_code': 0, 'execution_id': raw['run_id'],\n            'argv': actual['argv'], 'cwd': selection['selection']['execution_root'],\n            'started_utc': raw['started_utc'], 'finished_utc': raw['finished_utc'],\n            'required_ids': [row['id']], 'log': reference(root, path.parent / actual['log']),\n            'candidate': qualified['candidate'], 'raw': reference(root, path),\n            'original_runner_inputs': raw['inputs_before'],\n            'reason': chosen['reason'], 'evidence': {}}, 'check result changed original execution binding')\n    runtime_plan = read(bound(root, qualified['runtime_plan']))\n    require(runtime_plan == dict(plan, requirements=[r for r in plan['requirements'] if r['id'] not in selected]),\n            'runtime plan does not match test/native subset')\n    runtime = dict(qualified, plan=qualified['runtime_plan'],\n                   coverage=[row for row in rows if row['id'] not in selected])\n    require(all(row['disposition'] == 'executed' for row in runtime['coverage']),\n            'changed P11 test/native coverage was not executed')\n    result = coverage.verify(root, runtime, historical=historical)\n    result['required'] += len(selected)\n    for row in selected.values():\n        mode = row['disposition']\n        result['dispositions'][mode] = result['dispositions'].get(mode, 0) + 1\n    return result\n\n\ndef verify(root, path):\n    record = read(path)\n    require(record['schema'] == 'airs-desktop/p11-shared-qualification/1', 'P11 proof schema')\n    require(set(record['runner_inputs']) == {'source', 'dependencies', 'build_flags'},\n            'P11 runner input keys differ')\n    require(record['runner_inputs']['source'] == xtask_source(root),\n            'current source does not match actual runner source fingerprint')\n    seal = read(bound(root, record['source']))\n    require(source_inventory(root) == seal['files'], 'P11 source changed after qualification')\n    qualified = read(bound(root, record['coverage']))\n    require(digest(seal['files']) == qualified['source_inventory_sha256'], 'P11 source binding')\n    if 'review_remediation' in record:\n        require(qualified.get('review_remediation') == record['review_remediation'],\n                'review remediation qualification binding differs')\n    elif 'helper_source_carry' in record:\n        validate_helper_source_carry(root, bound(root, record['helper_source_carry']), record['runner_inputs'])\n    elif 'impact_selection' in record:\n        validate_impact_selection(root, bound(root, record['impact_selection']), record['runner_inputs'])\n    else:\n        for kind in ('check', 'test'):\n            validate_run(root, bound(root, record['runs'][kind]), kind, record['runner_inputs'])\n    inputs = read(bound(root, record['fingerprint']))\n    require(record['runner_inputs'] == {key: inputs[key] for key in record['runner_inputs']},\n            'P11 observed current fingerprint mismatch')\n    current = current_fingerprints(root)\n    require(record['runner_inputs'] == {key: current[key] for key in record['runner_inputs']},\n            'current dependency/toolchain/build flags differ from executed checks')\n    result = verify_coverage(root, qualified)\n    candidate = read(bound(root, qualified['candidate']))\n    from candidate import verify_candidate\n    verify_candidate(root, candidate)\n    performed = read(bound(root, record['native_execution']))\n    if 'review_remediation' in record:\n        remedy = read(bound(root, record['review_remediation']))\n        recovery = read(bound(root, remedy['recovery']))\n        require(record['native_execution'] == recovery['raw']\n                and candidate['helper_closure'] == recovery['helper_closure'],\n                'affected recovery helper/execution membership changed')\n    else:\n        require(candidate['helper_closure'] == helper_closure(root, native_driver(root, performed)),\n                'P11 native helper membership changed')\n        validate_execution(root, performed, candidate,\n            acceptance=bound(root, record['native_acceptance']) if 'native_acceptance' in record else None,\n            execution=bound(root, record['native_execution']))\n    build_path = bound(root, record['build'])\n    build = read(build_path)\n    require(build['application_inputs_unchanged'] is True\n            and all(step['exit_code'] == 0 for step in build['steps']), 'fixture build failed/drifted')\n    if 'review_remediation' in record:\n        import remediation\n        remediation.versioned_build(root, build, candidate)\n    else:\n        require([step['argv'] for step in build['steps']] == [\n            ['pnpm', '--filter', '@prisma-airs/desktop-contracts', 'typecheck'],\n            ['pnpm', '--filter', '@prisma-airs/desktop', 'typecheck'],\n            ['cargo', 'run', '--locked', '-p', 'xtask', '--', 'native-prepare', '--phase', 'P11',\n             '--target', 'aarch64-apple-darwin', '--features', 'test-fixtures']],\n            'missing or changed fixture build invocation')\n    require(set(build['application_inputs_before']) == application_files(root),\n            'built application input membership differs or is incomplete')\n    require(read(build_path.parent / 'native-prepare.json') == read(bound(root, candidate['prepare'])),\n            'prepared candidate differs from retained actual build output')\n    for step in build['steps']:\n        log = (build_path.parent / step['log']).resolve()\n        require(log.is_relative_to(root.resolve()) and sha(log) == step['log_sha256'],\n                'fixture build log drift')\n    changed = [name for name, value in build['application_inputs_before'].items()\n               if sha(root / name) != value]\n    if changed:\n        carry_schema = read(bound(root, record['build_input_carry']))['schema']\n        if carry_schema == 'airs-desktop/rust-test-build-carry/1':\n            rust_test_carry(root, record, build_path, build, candidate, changed)\n        else:\n            frontend_test_carry(root, record, build_path, build, candidate, changed)\n    else:\n        require('build_input_carry' not in record, 'unnecessary or stale build carry')\n    baseline = read(bound(root, record['historical_baseline']))\n    require(record['historical_baseline']['path'] == 'docs/planning/evidence/P10/completion-proof.json'\n            and baseline['schema'] == 'airs-desktop/p10-completion-proof/1', 'missing accepted baseline')\n    from review_gate import release_prerequisites\n    require(record['historical_standing'] == release_prerequisites(root),\n            'actual historical standing drift')\n    return {'record': str(path.relative_to(root)), 'sha256': sha(path),\n            'verified': result, 'candidate_sha256': qualified['candidate']['sha256'],\n            'controller_complete': False}\n\n\ndef make(root, check, tests, fingerprint, prepare, native, execution, build, out,\n\"\"\"Explicit C45/P10 evidence accounting. Does not execute checks or assign scores.\n\nThe existing runners produce raw records; this consumer rejects omitted coverage,\nchanged evidence, unsupported retirement and affected checks carried as unchanged.\nHistorical results always retain their original candidate and execution bindings.\n\"\"\"\nfrom pathlib import Path\nimport hashlib\nimport json\n\n\ndef require(value, message):\n    if not value:\n        raise ValueError(message)\n\n\ndef read(path):\n    return json.loads(Path(path).read_text())\n\n\ndef sha(path):\n    return hashlib.sha256(Path(path).read_bytes()).hexdigest()\n\n\ndef digest(value):\n    return hashlib.sha256((json.dumps(value, sort_keys=True, separators=(\",\", \":\")) + \"\\n\").encode()).hexdigest()\n\n\ndef bound(root, reference):\n    path = root / reference[\"path\"]\n    require(path.resolve().is_relative_to(root.resolve()), \"evidence escapes checkout\")\n    require(sha(path) == reference[\"sha256\"], \"evidence hash drift: \" + str(path))\n    return path\n\n\nEXACT_FIELDS = (\"executable_sha256\", \"bundle_sha256\", \"build_flags\", \"conditions\")\n\n\ndef verify_raw(root, needed, execution, origin):\n    require(execution[\"argv\"] == needed[\"argv\"], \"execution command differs from approved plan\")\n    require(execution[\"cwd\"] == origin[\"execution_root\"], \"execution cwd differs from original candidate\")\n    raw_path = bound(root, execution[\"raw\"])\n    raw = read(raw_path)\n    if needed[\"kind\"] == \"native\":\n        require(raw[\"schema\"] == \"airs-v2/native-acceptance/1\" and raw[\"app\"][\"executable_sha256\"] == origin[\"executable_sha256\"], \"raw native candidate mismatch\")\n        checks = [check for check in raw[\"checks\"] if check[\"id\"] == needed[\"id\"]]\n        require(len(checks) == 1 and checks[0][\"result\"] == \"pass\" and checks[0].get(\"observation\") and checks[0].get(\"evidence\"), \"raw native assertion not passing\")\n        for name in checks[0][\"evidence\"]:\n            require(name in execution[\"evidence\"], \"native evidence missing from execution inventory\")\n            bound(root, {\"path\":name,\"sha256\":execution[\"evidence\"][name]})\n    elif needed[\"kind\"] == \"command\":\n        require(raw[\"schema\"] == \"airs-v2/run/1\" and raw[\"status\"] == \"passed\" and raw[\"failure\"] is None and raw[\"inputs_before\"] == raw[\"inputs_after\"], \"raw runner failed or inputs changed\")\n        require(raw[\"inputs_before\"] == origin[\"runner_inputs\"], \"runner input fingerprint does not bind original candidate\")\n        commands = [command for command in raw[\"commands\"] if command[\"label\"] == needed[\"label\"]]\n        require(len(commands) == 1, \"raw runner command missing/duplicated\")\n        command = commands[0]\n        require(command[\"status\"] == \"passed\" and command[\"exit_code\"] == 0 and command[\"argv\"] == needed[\"argv\"] and command[\"cwd\"] in [\".\", origin[\"execution_root\"]] and not command[\"note\"], \"raw runner command failed/differs\")\n        require(command[\"output_sha256\"] == execution[\"log\"][\"sha256\"] and str((raw_path.parent/command[\"log\"]).relative_to(root)) == execution[\"log\"][\"path\"], \"raw runner log binding\")\n        if needed.get(\"expects_tests\"):\n            require(command[\"tests\"] and command[\"tests\"][\"passed\"] > 0 and command[\"tests\"][\"failed\"] == 0, \"test command did not execute passing tests\")\n    else:\n        raise ValueError(\"unsupported required raw execution kind\")\n\n\ndef verify(root, record, historical=None):\n    require(record[\"schema\"] == \"airs-desktop/qualified-coverage/1\", \"coverage schema\")\n    plan = read(bound(root, record[\"plan\"]))\n    require(plan[\"schema\"] == \"airs-desktop/required-coverage/1\", \"plan schema\")\n    requirements = plan[\"requirements\"]\n    ids = [item[\"id\"] for item in requirements]\n    require(len(ids) == len(set(ids)) and ids, \"duplicate/empty required coverage\")\n    rows = record[\"coverage\"]\n    require(len(rows) == len(ids) and {r[\"id\"] for r in rows} == set(ids), \"missing/duplicate/unknown coverage\")\n    by_id = {item[\"id\"]: item for item in requirements}\n    candidate = read(bound(root, record[\"candidate\"]))\n    require(all(candidate.get(k) for k in EXACT_FIELDS) and candidate.get(\"helper_closure\"), \"candidate binding incomplete\")\n    require(candidate.get(\"source_inventory_sha256\") == record[\"source_inventory_sha256\"], \"candidate source binding\")\n    for row in rows:\n        needed = by_id[row[\"id\"]]\n        mode = row[\"disposition\"]\n        require(mode in [\"executed\", \"reused_exact\", \"carried_unaffected\", \"not_applicable\"], \"unsupported coverage disposition\")\n        if mode == \"not_applicable\":\n            decision = needed.get(\"retirement\")\n            require(decision and row.get(\"reason\") and row.get(\"decision\") == decision, \"unapproved assertion retirement\")\n            bound(root, decision)\n            continue\n        original = read(bound(root, row[\"result\"]))\n        require(original.get(\"status\") == \"pass\" and original.get(\"exit_code\") == 0, \"result is not an actual passing execution\")\n        require(original.get(\"execution_id\") and original.get(\"argv\") and original.get(\"cwd\") and original.get(\"started_utc\") and original.get(\"finished_utc\"), \"execution provenance missing\")\n        require(row[\"id\"] in original.get(\"required_ids\", []), \"result does not cover required assertion\")\n        bound(root, original[\"log\"])\n        origin = read(bound(root, original[\"candidate\"]))\n        require(all(origin.get(k) for k in EXACT_FIELDS) and origin.get(\"helper_closure\"), \"original candidate binding incomplete\")\n        verify_raw(root, needed, original, origin)\n        if mode in [\"executed\", \"reused_exact\"]:\n            if mode == \"reused_exact\":\n                require(not needed.get(\"must_execute\", needed.get(\"affected\", True)), \"changed check must execute\")\n            helpers = needed.get(\"helper_paths\")\n            if helpers is None:\n                require(origin[\"helper_closure\"] == candidate[\"helper_closure\"], \"relevant helper closure differs\")\n            else:\n                require(all(name in origin[\"helper_closure\"] and name in candidate[\"helper_closure\"] and origin[\"helper_closure\"][name] == candidate[\"helper_closure\"][name] for name in helpers), \"relevant helper closure differs\")\n            require(all(origin[k] == candidate[k] for k in EXACT_FIELDS), \"artifact/helper/flags/conditions differ\")\n            if mode == \"executed\":\n                require(origin[\"source_inventory_sha256\"] == record[\"source_inventory_sha256\"], \"execution is historical, not current\")\n        else:\n            require(not needed.get(\"affected\", True), \"affected check cannot be carried unchanged\")\n            rationale = row.get(\"impact\")\n            require(rationale and rationale.get(\"reason\") and rationale.get(\"dependencies\") == needed.get(\"dependencies\") and rationale.get(\"original_candidate_sha256\") == original[\"candidate\"][\"sha256\"], \"unchanged-impact proof missing\")\n            proof = read(bound(root, rationale[\"proof\"]))\n            bindings = proof.get(\"file_bindings\", {})\n            require(set(bindings) == set(needed[\"dependencies\"]) and bindings, \"dependency membership proof missing\")\n            current_files=historical.source(record['source_inventory_sha256']) if historical else root\n            original_files=historical.source(origin['source_inventory_sha256']) if historical else root\n            for dependency, binding in bindings.items():\n                require(binding[\"original_sha256\"] == binding[\"current_sha256\"] == sha(current_files/dependency), \"dependency changed: \" + dependency)\n                original_source = original_files/dependency if historical else bound(root, binding[\"original_file\"])\n                require(sha(original_source) == binding[\"original_sha256\"], \"original dependency proof mismatch\")\n            require(proof.get(\"unchanged_dependencies\") == needed[\"dependencies\"] and proof.get(\"current_source_inventory_sha256\") == record[\"source_inventory_sha256\"] and proof.get(\"original_candidate_sha256\") == original[\"candidate\"][\"sha256\"], \"impact proof does not bind current and original inputs\")\n    return {\"qualified\": True, \"required\": len(ids), \"dispositions\": {m: sum(r[\"disposition\"] == m for r in rows) for m in sorted({r[\"disposition\"] for r in rows})}, \"candidate_sha256\": record[\"candidate\"][\"sha256\"], \"source_inventory_sha256\": record[\"source_inventory_sha256\"]}\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_31","type":"command_execution","command":"/bin/zsh -lc 'cat crates/xtask/src/fingerprint.rs; cat apps/desktop/src/contracts/refinement-contract.test.ts; cat docs/planning/evidence/P11/runs/test-20261104T135013Z-49afb6/logs/C49-fixture.log docs/planning/evidence/P11/runs/test-20261104T150831Z-4e9ebe/logs/C49-frontend-1.log'","aggregated_output":"//! Input fingerprints bound into review packets and receipts.\n//!\n//! * source: every tracked or untracked-but-not-ignored file (path, mode,\n//!   content or symlink target) plus the repository `.git/config`, minus a\n//!   narrow set of mutable evidence locations that are hashed separately.\n//! * dependencies: lockfiles, toolchain pin, the consumed immutable inputs\n//!   under `.inputs/`, and the resolved build-tool identities.\n//! * build_flags: the subject's manifest entries, Tauri configuration and\n//!   capability files, target and fixture-feature policy.\n//! * evidence: the subject's committed evidence directory.\n\nuse std::collections::BTreeMap;\nuse std::os::unix::fs::PermissionsExt;\nuse std::path::Path;\nuse std::process::Command;\n\nuse serde::{Deserialize, Serialize};\n\nuse crate::manifest::Manifest;\nuse crate::{Repo, Result, Subject, invalid, io_err, sha256_hex};\n\n/// Mutable locations excluded from the source fingerprint. Each is hashed\n/// independently (evidence fingerprint, receipts) so exclusion cannot hide\n/// application sources, lockfiles, tests or configuration.\npub const SOURCE_EXCLUSIONS: [&str; 3] = [\n    \"docs/planning/status.md\",\n    \"docs/planning/reviews/\",\n    \"docs/planning/evidence/\",\n];\n\n#[derive(Clone, Debug, PartialEq, Eq, Serialize, Deserialize)]\n#[serde(deny_unknown_fields)]\npub struct Fingerprints {\n    pub source: String,\n    pub dependencies: String,\n    pub build_flags: String,\n    pub evidence: String,\n}\n\n/// One entry of the source inventory.\n#[derive(Clone, Debug, PartialEq, Eq, Serialize, Deserialize)]\npub struct FileEntry {\n    pub path: String,\n    pub mode: String,\n    pub sha256: String,\n}\n\npub fn is_excluded(path: &str) -> bool {\n    SOURCE_EXCLUSIONS.iter().any(|excluded| {\n        if excluded.ends_with('/') {\n            path.starts_with(excluded)\n        } else {\n            path == *excluded\n        }\n    })\n}\n\n/// Lists source files via git: tracked plus untracked files not ignored.\npub fn source_inventory(repo: &Repo) -> Result<Vec<FileEntry>> {\n    let output = Command::new(\"/usr/bin/git\")\n        .args([\n            \"ls-files\",\n            \"-z\",\n            \"--cached\",\n            \"--others\",\n            \"--exclude-standard\",\n        ])\n        .current_dir(repo.root())\n        .env_clear()\n        .env(\"PATH\", \"/usr/bin:/bin\")\n        .env(\"HOME\", std::env::var(\"HOME\").unwrap_or_default())\n        .output()\n        .map_err(io_err(repo.root()))?;\n    if !output.status.success() {\n        return Err(invalid(\"git ls-files failed\"));\n    }\n    let mut paths: Vec<String> = output\n        .stdout\n        .split(|b| *b == 0)\n        .filter(|p| !p.is_empty())\n        .map(|p| String::from_utf8_lossy(p).into_owned())\n        .filter(|p| !is_excluded(p))\n        .collect();\n    paths.sort();\n    paths.dedup();\n    let mut entries = Vec::with_capacity(paths.len() + 1);\n    for path in paths {\n        entries.push(file_entry(repo.root(), &path)?);\n    }\n    entries.push(file_entry(repo.root(), \".git/config\")?);\n    Ok(entries)\n}\n\nfn file_entry(root: &Path, relative: &str) -> Result<FileEntry> {\n    let full = root.join(relative);\n    let Ok(meta) = std::fs::symlink_metadata(&full) else {\n        return Ok(FileEntry {\n            path: relative.to_owned(),\n            mode: \"deleted\".to_owned(),\n            sha256: String::new(),\n        });\n    };\n    if meta.file_type().is_symlink() {\n        let target = std::fs::read_link(&full).map_err(io_err(&full))?;\n        return Ok(FileEntry {\n            path: relative.to_owned(),\n            mode: \"symlink\".to_owned(),\n            sha256: sha256_hex(target.as_os_str().as_encoded_bytes()),\n        });\n    }\n    let bytes = std::fs::read(&full).map_err(io_err(&full))?;\n    let executable = meta.permissions().mode() & 0o111 != 0;\n    Ok(FileEntry {\n        path: relative.to_owned(),\n        mode: if executable { \"100755\" } else { \"100644\" }.to_owned(),\n        sha256: sha256_hex(&bytes),\n    })\n}\n\npub fn inventory_hash(entries: &[FileEntry]) -> String {\n    let text: String = entries\n        .iter()\n        .map(|e| format!(\"{}\\0{}\\0{}\\n\", e.path, e.mode, e.sha256))\n        .collect();\n    sha256_hex(text.as_bytes())\n}\n\npub fn source(repo: &Repo) -> Result<String> {\n    Ok(inventory_hash(&source_inventory(repo)?))\n}\n\n/// Hash of every regular file under a directory (relative paths, sorted).\npub fn tree_hash(dir: &Path) -> Result<String> {\n    tree_hash_excluding(dir, &[])\n}\n\n/// Like [`tree_hash`], skipping directories with the given names.\npub fn tree_hash_excluding(dir: &Path, skip: &[&str]) -> Result<String> {\n    let mut entries = Vec::new();\n    collect_tree(dir, dir, skip, &mut entries)?;\n    entries.sort_by(|a, b| a.path.cmp(&b.path));\n    Ok(inventory_hash(&entries))\n}\n\nfn collect_tree(root: &Path, dir: &Path, skip: &[&str], out: &mut Vec<FileEntry>) -> Result<()> {\n    let mut children: Vec<_> = std::fs::read_dir(dir)\n        .map_err(io_err(dir))?\n        .filter_map(|e| e.ok())\n        .collect();\n    children.sort_by_key(|e| e.file_name());\n    for child in children {\n        let path = child.path();\n        let relative = path\n            .strip_prefix(root)\n            .map_err(|_| invalid(\"path escaped its root\"))?\n            .to_string_lossy()\n            .into_owned();\n        let meta = std::fs::symlink_metadata(&path).map_err(io_err(&path))?;\n        if meta.is_dir() {\n            if skip.iter().any(|name| child.file_name() == *name) {\n                continue;\n            }\n            collect_tree(root, &path, skip, out)?;\n        } else {\n            out.push(file_entry(root, &relative)?);\n        }\n    }\n    Ok(())\n}\n\n/// Dependency inputs: lockfiles, toolchain pin, immutable inputs, tools.\npub fn dependencies(repo: &Repo, toolchain_hash: &str) -> Result<String> {\n    let mut parts: BTreeMap<String, String> = BTreeMap::new();\n    for file in [\n        \"Cargo.lock\",\n        \"pnpm-lock.yaml\",\n        \"rust-toolchain.toml\",\n        \".npmrc\",\n        \"docs/architecture/inputs.lock.json\",\n    ] {\n        let path = repo.join(file);\n        let digest = match std::fs::read(&path) {\n            Ok(bytes) => sha256_hex(&bytes),\n            Err(_) => \"absent\".to_owned(),\n        };\n        parts.insert(file.to_owned(), digest);\n    }\n    let inputs = repo.join(\".inputs\");\n    if inputs.is_dir() {\n        let mut names: Vec<_> = std::fs::read_dir(&inputs)\n            .map_err(io_err(&inputs))?\n            .filter_map(|e| e.ok())\n            .filter(|e| e.path().is_dir())\n            .map(|e| e.file_name().to_string_lossy().into_owned())\n            .collect();\n        names.sort();\n        for name in names {\n            parts.insert(format!(\".inputs/{name}\"), tree_hash(&inputs.join(&name))?);\n        }\n    }\n    for (label, hash) in consumed_shared(repo)? {\n        parts.insert(label, hash);\n    }\n    parts.insert(\"toolchain\".to_owned(), toolchain_hash.to_owned());\n    Ok(sha256_hex(\n        serde_json::to_string(&parts).unwrap_or_default().as_bytes(),\n    ))\n}\n\n/// Build flags: the subject's manifest entries and native configuration,\n/// as canonical JSON (sorted keys, compact) so independent tools can\n/// recompute it.\npub fn build_flags(repo: &Repo, manifest: &Manifest, subject: Subject) -> Result<String> {\n    use serde_json::{Value, json};\n    let mut parts: BTreeMap<String, Value> = BTreeMap::new();\n    let chunks = if subject.is_phase() {\n        manifest.phase_chunks(subject)?\n    } else {\n        vec![subject]\n    };\n    for chunk in chunks {\n        let entry = manifest.chunk(chunk)?;\n        let mut flags = json!({\n            \"fixture\": entry.fixture_command,\n            \"frontend\": entry.frontend_commands,\n            \"host\": entry.host_commands,\n            \"native_prepare\": entry.native_prepare,\n        });\n        // Keep historical canonical objects byte-for-byte equivalent. Only\n        // new chunks bind the D063 selected check list.\n        if let Some(selected) = &entry.check_commands {\n            flags[\"checks\"] = json!(selected);\n        }\n        parts.insert(format!(\"chunk/{chunk}\"), flags);\n    }\n    parts.insert(\"setup\".to_owned(), json!(manifest.setup_commands));\n    parts.insert(\n        \"phase_native\".to_owned(),\n        json!(manifest.phase_native_prepare),\n    );\n    parts.insert(\"common\".to_owned(), json!(manifest.common_commands));\n    parts.insert(\"shared\".to_owned(), json!(manifest.shared_source_commands));\n    parts.insert(\"artifact\".to_owned(), json!(manifest.artifact_build));\n    parts.insert(\"target\".to_owned(), json!(manifest.target));\n    parts.insert(\n        \"fixture_only\".to_owned(),\n        json!(manifest.fixture_only_features),\n    );\n    parts.insert(\n        \"production_features\".to_owned(),\n        json!(manifest.requested_production_features),\n    );\n    for file in BUILD_FLAG_FILES {\n        let digest = std::fs::read(repo.join(file))\n            .map(|b| sha256_hex(&b))\n            .unwrap_or_else(|_| \"absent\".to_owned());\n        parts.insert(file.to_owned(), json!(digest));\n    }\n    Ok(sha256_hex(\n        serde_json::to_string(&parts).unwrap_or_default().as_bytes(),\n    ))\n}\n\n/// Native configuration files whose bytes are part of the build flags.\npub const BUILD_FLAG_FILES: [&str; 7] = [\n    \"apps/desktop/src-tauri/tauri.conf.json\",\n    \"apps/desktop/src-tauri/tauri.fixture.conf.json\",\n    \"apps/desktop/src-tauri/tauri.harness.conf.json\",\n    \"apps/desktop/src-tauri/capabilities/main.json\",\n    \"apps/desktop/src-tauri/Cargo.toml\",\n    \"Cargo.toml\",\n    \"docs/architecture/native-checks.json\",\n];\n\n/// Evidence: the subject's committed evidence directory (empty if absent).\npub fn evidence(repo: &Repo, subject: Subject) -> Result<String> {\n    let dir = repo.evidence_dir(subject);\n    if dir.is_dir() {\n        tree_hash(&dir)\n    } else {\n        Ok(sha256_hex(b\"\"))\n    }\n}\n\npub fn all(\n    repo: &Repo,\n    manifest: &Manifest,\n    subject: Subject,\n    toolchain_hash: &str,\n) -> Result<Fingerprints> {\n    Ok(Fingerprints {\n        source: source(repo)?,\n        dependencies: dependencies(repo, toolchain_hash)?,\n        build_flags: build_flags(repo, manifest, subject)?,\n        evidence: evidence(repo, subject)?,\n    })\n}\n\n/// The Academy packages the desktop installs from the staged input\n/// (`file:` dependencies) and compiles: each one's locked input subtree, its\n/// staged scratch copy and the copy installed into the desktop's\n/// node_modules are hashed into the dependency fingerprint; editing any of\n/// them invalidates bound receipts. The presentation package keeps its\n/// original labels.\npub const SHARED_PACKAGES: [(&str, &str); 3] = [\n    (\"presentation\", \"packages/presentation\"),\n    (\"learner\", \"packages/learner\"),\n    (\"shared\", \"packages/shared\"),\n];\n\n/// Files a package's own checks generate in scratch; never consumed.\nconst PACKAGE_GENERATED: [&str; 1] = [\"tsconfig.tsbuildinfo\"];\n\nfn package_hash(dir: &Path) -> Result<String> {\n    let mut entries = Vec::new();\n    collect_tree(dir, dir, &[\"node_modules\"], &mut entries)?;\n    entries.retain(|e| !PACKAGE_GENERATED.contains(&e.path.as_str()));\n    entries.sort_by(|a, b| a.path.cmp(&b.path));\n    Ok(inventory_hash(&entries))\n}\n\nfn package_label(name: &str, place: &str) -> String {\n    if name == \"presentation\" {\n        format!(\"shared/{place}\")\n    } else {\n        format!(\"shared/{name}/{place}\")\n    }\n}\n\npub fn consumed_shared(repo: &Repo) -> Result<Vec<(String, String)>> {\n    let mut out = Vec::new();\n    let web = repo.join(\".work/academy\");\n    out.push((\n        \"shared/web-scratch\".to_owned(),\n        if web.is_dir() {\n            academy_consumer_hash(&web)?\n        } else {\n            \"absent\".to_owned()\n        },\n    ));\n    for (name, package) in SHARED_PACKAGES {\n        let locations = [\n            (\"input\", repo.join(\".inputs/academy\").join(package)),\n            (\"scratch\", repo.join(\".work/academy\").join(package)),\n            (\n                \"installed\",\n                std::fs::canonicalize(\n                    repo.join(\"apps/desktop/node_modules/@ai-security-academy\")\n                        .join(name),\n                )\n                .unwrap_or_default(),\n            ),\n        ];\n        for (place, path) in locations {\n            let hash = if path.is_dir() {\n                package_hash(&path)?\n            } else {\n                \"absent\".to_owned()\n            };\n            out.push((package_label(name, place), hash));\n        }\n    }\n    Ok(out)\n}\n\n/// Generated outputs the Academy web checks write into scratch; everything\n/// else in `.work/academy` must equal the locked input.\npub const ACADEMY_GENERATED: [&str; 4] = [\n    \"dist\",\n    \"public/excalidraw-assets\",\n    \"packages/shared/tsconfig.tsbuildinfo\",\n    // rollup-plugin-visualizer report written by `vite build`.\n    \"stats.html\",\n];\n\n/// Hash of an Academy tree as consumed by the web checks: excludes\n/// node_modules at any depth, the documented generated outputs and `.env*`\n/// files (never staged).\npub fn academy_consumer_hash(dir: &Path) -> Result<String> {\n    let mut entries = Vec::new();\n    collect_tree(dir, dir, &[\"node_modules\"], &mut entries)?;\n    entries.retain(|e| {\n        let name = e.path.rsplit('/').next().unwrap_or(&e.path);\n        let generated = ACADEMY_GENERATED\n            .iter()\n            .any(|g| e.path == *g || e.path.starts_with(&format!(\"{g}/\")));\n        !generated && name != \".env\" && !name.starts_with(\".env.\")\n    });\n    entries.sort_by(|a, b| a.path.cmp(&b.path));\n    Ok(inventory_hash(&entries))\n}\n\n/// Fails unless the staged web scratch tree and every consumed package's\n/// staged and installed copies equal the locked input.\npub fn verify_consumed_shared(repo: &Repo) -> Result<()> {\n    let input_tree = repo.join(\".inputs/academy\");\n    let scratch_tree = repo.join(\".work/academy\");\n    if input_tree.is_dir()\n        && scratch_tree.is_dir()\n        && academy_consumer_hash(&input_tree)? != academy_consumer_hash(&scratch_tree)?\n    {\n        return Err(invalid(\n            \".work/academy differs from the locked Academy input (outside documented generated outputs); re-run shared-prepare\",\n        ));\n    }\n    let hashes: BTreeMap<String, String> = consumed_shared(repo)?.into_iter().collect();\n    for (name, _) in SHARED_PACKAGES {\n        let input = &hashes[&package_label(name, \"input\")];\n        if input == \"absent\" {\n            return Err(invalid(format!(\n                \"locked shared input for {name} is absent from .inputs/academy; run fetch-inputs\"\n            )));\n        }\n        for place in [\"scratch\", \"installed\"] {\n            let label = package_label(name, place);\n            if &hashes[&label] != input {\n                return Err(invalid(format!(\n                    \"{label} differs from the locked shared input; re-run shared-prepare and pnpm install\"\n                )));\n            }\n        }\n    }\n    Ok(())\n}\n\n#[cfg(test)]\nmod tests {\n    use std::path::PathBuf;\n\n    use super::*;\n\n    fn write(path: &Path, text: &str) {\n        std::fs::create_dir_all(path.parent().expect(\"parent\")).expect(\"dir\");\n        std::fs::write(path, text).expect(\"write\");\n    }\n\n    /// A checkout with the three Academy packages locked, staged and\n    /// installed identically.\n    fn checkout(tag: &str) -> (Repo, PathBuf) {\n        let root =\n            std::env::temp_dir().join(format!(\"airs-xtask-consumed-{tag}-{}\", std::process::id()));\n        let _ = std::fs::remove_dir_all(&root);\n        for tree in [\".inputs/academy\", \".work/academy\"] {\n            write(\n                &root.join(tree).join(\"package.json\"),\n                \"{\\\"name\\\":\\\"academy\\\"}\",\n            );\n            for (_, package) in SHARED_PACKAGES {\n                write(\n                    &root.join(tree).join(package).join(\"src/index.ts\"),\n                    \"export const v = 1\\n\",\n                );\n            }\n        }\n        for (name, _) in SHARED_PACKAGES {\n            write(\n                &root\n                    .join(\"apps/desktop/node_modules/@ai-security-academy\")\n                    .join(name)\n                    .join(\"src/index.ts\"),\n                \"export const v = 1\\n\",\n            );\n        }\n        (Repo::new(&root), root)\n    }\n\n    #[test]\n    fn every_installed_academy_package_is_fingerprinted_and_verified() {\n        let (repo, root) = checkout(\"verify\");\n        verify_consumed_shared(&repo).expect(\"identical copies verify\");\n        let before = consumed_shared(&repo).expect(\"hashes\");\n        // A package's own generated build info in scratch is not consumed.\n        write(\n            &root.join(\".work/academy/packages/shared/tsconfig.tsbuildinfo\"),\n            \"{}\",\n        );\n        verify_consumed_shared(&repo).expect(\"generated build info ignored\");\n        for name in [\"learner\", \"shared\", \"presentation\"] {\n            let file = root\n                .join(\"apps/desktop/node_modules/@ai-security-academy\")\n                .join(name)\n                .join(\"src/index.ts\");\n            write(&file, \"export const v = 2\\n\");\n            let error = verify_consumed_shared(&repo)\n                .expect_err(\"altered installed copy\")\n                .to_string();\n            let label = package_label(name, \"installed\");\n            assert!(error.contains(&label), \"{error}\");\n            assert_ne!(\n                consumed_shared(&repo).expect(\"hashes\"),\n                before,\n                \"{name} changes the fingerprint\"\n            );\n            write(&file, \"export const v = 1\\n\");\n        }\n        // A symlink in place of a file is not the same copy.\n        let file = root.join(\"apps/desktop/node_modules/@ai-security-academy/learner/src/index.ts\");\n        let target = root.join(\"elsewhere.ts\");\n        write(&target, \"export const v = 1\\n\");\n        std::fs::remove_file(&file).expect(\"remove\");\n        std::os::unix::fs::symlink(&target, &file).expect(\"symlink\");\n        assert!(verify_consumed_shared(&repo).is_err(), \"symlinked file\");\n        // A missing installed package fails too.\n        std::fs::remove_dir_all(\n            root.join(\"apps/desktop/node_modules/@ai-security-academy/learner\"),\n        )\n        .expect(\"remove\");\n        assert!(\n            verify_consumed_shared(&repo).is_err(),\n            \"absent installed copy\"\n        );\n        std::fs::remove_dir_all(&root).expect(\"cleanup\");\n    }\n}\nimport { describe, expect, it } from 'vitest'\nimport { ContractViolation, parseShellSnapshot } from '@prisma-airs/desktop-contracts'\nimport { baseSnapshot, tenant } from '../test/native'\n\ndescribe('refinement native contract', () => {\n    it('accepts only the paired host color-theme values', () => {\n        expect(parseShellSnapshot({ ...baseSnapshot, colorTheme: 'prismaAirs' }).colorTheme).toBe('prismaAirs')\n        expect(parseShellSnapshot({ ...baseSnapshot, colorTheme: 'gruvbox' }).colorTheme).toBe('gruvbox')\n        for (const colorTheme of [undefined, null, 'future-theme', {}, 1]) {\n            expect(() => parseShellSnapshot({ ...baseSnapshot, colorTheme })).toThrow(ContractViolation)\n        }\n    })\n    it('requires a real boolean for the native-owned management requirement', () => {\n        const setup = {\n            mode: 'add', context: 'cx-draft', tenant: tenant(), products: ['runtimeSecurity'],\n            scanRequired: false, managementRequired: true, packs: [], workspace: null,\n            verify: null, completable: false,\n        }\n        expect(parseShellSnapshot({ ...baseSnapshot, setup }).setup?.managementRequired).toBe(true)\n        for (const managementRequired of [undefined, null, 'true', {}, 1]) {\n            expect(() => parseShellSnapshot({ ...baseSnapshot, setup: { ...setup, managementRequired } })).toThrow(ContractViolation)\n        }\n    })\n})\n\nrunning 3 tests\ntest store::tests::color_theme_defaults_existing_state_without_changing_appearance ... ok\ntest store::tests::alternate_color_theme_roundtrips_independently_of_appearance ... ok\ntest authority::tests::color_theme_is_persisted_without_changing_appearance_or_tenant_scope ... ok\n\ntest result: ok. 3 passed; 0 failed; 0 ignored; 0 measured; 228 filtered out; finished in 0.02s\n\n\n--- stderr ---\n   Compiling desktop-core v1.0.0 (/Users/cdot/development/redtail/p09-queue/refinement-20261104/core/crates/desktop-core)\n    Finished `test` profile [unoptimized + debuginfo] target(s) in 14.25s\n     Running unittests src/lib.rs (target/debug/deps/desktop_core-ca515594acbdf855)\n\n RUN  v3.2.6 /Users/cdot/development/redtail/p09-queue/refinement-20261104/core/apps/desktop\n\n ✓ src/shell/palette-contrast.test.ts (4 tests) 2ms\n ✓ src/shell/academy-theme-boundary.test.ts (19 tests) 47ms\n ✓ src/shell/appearance.test.ts (2 tests) 3ms\n ✓ src/v2/settings/refinement-settings.test.tsx (10 tests) 406ms\n ✓ src/modules/tenants/reset.te