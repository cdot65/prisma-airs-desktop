{"type":"item.completed","item":{"id":"item_43","type":"command_execution","command":"/bin/zsh -lc \"cat .inputs/academy/packages/presentation/src/styles/base.css; rg -n 'Search paths, courses, and labs|focus:outline-none|outline-none' .inputs/academy/src/features/catalog .work/academy/src/features/catalog .work/academy/src/components | head -50; sed -n '75,120p' apps/desktop/src/app.tsx; sed -n '1,170p' apps/desktop/src/v2/academy/academy.test.tsx\"","aggregated_output":"/* ─────────────────────────────────────────────────────────────────────────\n * Shared base + interaction helpers (ADR 0002)\n *\n * General presentation every consumer needs: the global keyboard focus ring\n * (WCAG 2.4.7) and body base, the nav/icon-button hover helpers applied by the\n * shared shell and controls, the `ax-pulse` keyframe behind StatusChip's live\n * dot, and the reduced-motion clamp. Academy-only reward/shift animations stay\n * in the web app's animations.css.\n * ───────────────────────────────────────────────────────────────────────── */\n\n@layer base {\n    /* ── Global focus indicator (WCAG 2.4.7) ────────────────────────────────\n     * Every interactive element gets a 2px accent ring with a 2px offset on\n     * keyboard focus. `:where()` keeps specificity at the pseudo-class floor\n     * so a component with a bespoke focus treatment can still opt out with an\n     * `outline-none` utility (utilities layer wins the cascade). */\n    :where(\n        a,\n        button,\n        input,\n        select,\n        textarea,\n        summary,\n        [tabindex]\n    ):focus-visible {\n        outline: 2px solid var(--academy-focus-ring);\n        outline-offset: 2px;\n    }\n\n    body {\n        background: var(--academy-bg);\n        color: var(--academy-ink);\n        font-family: var(--academy-font-body);\n        -webkit-font-smoothing: antialiased;\n        text-rendering: optimizeLegibility;\n    }\n}\n\n@keyframes ax-pulse {\n    0%,\n    100% {\n        opacity: 1;\n        transform: scale(1);\n    }\n    50% {\n        opacity: 0.4;\n        transform: scale(0.8);\n    }\n}\n\n/* Interaction helpers — applied by the shared shell/controls. */\n.ax-nav {\n    text-decoration: none;\n    transition:\n        color var(--academy-dur-1) var(--academy-ease),\n        background var(--academy-dur-1) var(--academy-ease);\n}\n.ax-nav:hover {\n    color: var(--academy-ink) !important;\n    background: var(--academy-bg-inset) !important;\n}\n\n.ax-icbtn {\n    transition:\n        background var(--academy-dur-1),\n        color var(--academy-dur-1);\n}\n.ax-icbtn:hover {\n    background: var(--academy-paper-deep) !important;\n    color: var(--academy-ink) !important;\n}\n\n@media (prefers-reduced-motion: reduce) {\n    *,\n    *::before,\n    *::after {\n        animation-duration: 0.001ms !important;\n        animation-iteration-count: 1 !important;\n        transition-duration: 0.001ms !important;\n    }\n}\nrg: .inputs/academy/src/features/catalog: No such file or directory (os error 2)\nrg: .work/academy/src/features/catalog: No such file or directory (os error 2)\n.work/academy/src/components/modal.tsx:76:                        'bg-academy-paper border-academy-rule rounded-academy-lg fixed top-1/2 left-1/2 z-[70] max-h-[85dvh] w-[calc(100%_-_2rem)] max-w-lg -translate-x-1/2 -translate-y-1/2 overflow-y-auto border p-6 shadow-lg outline-none',\n.work/academy/src/components/shell/command-palette.tsx:137:                className='bg-academy-surface rounded-academy-lg border-academy-line w-full max-w-lg border shadow-lg outline-none'\n.work/academy/src/components/shell/command-palette.tsx:159:                    className='text-academy-ink placeholder:text-academy-ink-faint border-academy-rule w-full border-b bg-transparent px-5 py-4 text-[15px] outline-none'\n.work/academy/src/components/ax/terminal-block.tsx:223:                            className='text-academy-ink w-full min-w-0 bg-transparent font-mono text-[12.5px] outline-none disabled:opacity-50'\n.work/academy/src/components/ui/input.tsx:11:                'border-input bg-background placeholder:text-muted-foreground flex h-9 w-full rounded-md border px-3 py-1 text-sm shadow-xs transition-colors outline-none',\n.work/academy/src/components/ui/radio-group.tsx:28:                'border-input text-primary focus-visible:border-ring focus-visible:ring-ring/50 aria-invalid:ring-destructive/20 aria-invalid:border-destructive aspect-square size-4 shrink-0 rounded-full border shadow-xs transition-[color,box-shadow] outline-none focus-visible:ring-[3px] disabled:cursor-not-allowed disabled:opacity-50',\n.work/academy/src/components/ui/confirm-dialog.test.tsx:20:        expect(action).not.toHaveClass('outline-none')\n        [dispatch]\n    )\n    const v2Preference = useCallback(\n        async (what: string, intent: Intent, quiet: Refusal[] = []) => {\n            await v2Act(what, intent, quiet)\n        },\n        [v2Act]\n    )\n\n    const onMenu = useRef<(command: MenuCommand) => void>(() => undefined)\n    onMenu.current = (command: MenuCommand) => {\n        // Native navigation dismisses the modal palette first so focus can\n        // move to the new page heading instead of behind an open dialog.\n        if (command.kind === 'navigate') void v2Navigate(command.feature)\n        else if (command.kind === 'commandPalette') useShellStore.getState().openPalette()\n        // ⌘T: the tenant switcher opens; nothing switches until chosen.\n        else if (command.kind === 'tenantSwitcher') useShellStore.getState().setSwitcher(true)\n        // The open API Client request saves (its editor listens).\n        else if (command.kind === 'saveDocument') window.dispatchEvent(new Event(SAVE_DOCUMENT_EVENT))\n        else void v2Preference('The appearance change', { kind: 'setAppearance', theme: command.theme })\n    }\n\n    useEffect(() => {\n        let stop: (() => void) | undefined\n        let cancelled = false\n        client\n            .observeShell({\n                onSnapshot: (next) => {\n                    // The shell's scope follows the snapshot before it renders: a\n                    // notification for another tenant or context is never surfaced.\n                    useShellStore.getState().setScope(next.active?.tenant ?? null, next.active?.context ?? null, next.switchBlocked?.review ?? null)\n                    useShellStore.getState().observeWorkbench(next.active?.tenant ?? null, next.active?.context ?? null, next.workbench.collection?.scope ?? null)\n                    setSnapshot(next)\n                },\n                onMenu: (command) => onMenu.current(command),\n                onError: () => setFailure('The desktop sent an unexpected update.'),\n            })\n            .then(\n                (unsubscribe) => {\n                    if (cancelled) unsubscribe()\n                    else stop = unsubscribe\n                },\n                () => setFailure('The desktop shell could not be observed.')\n            )\n        return () => {\n            cancelled = true\n/**\n * C42: the Academy as R2App draws it (start=academy) around Academy's own\n * learner pages over the native learner transport: the title row's pills,\n * the frame (the pages beside Your place), the Learning paths row read\n * through the generation's client, guest and account generations, sign-in\n * routed to Settings, the offline pill, and the v2 shell mounting it.\n */\nimport { act, render, screen, waitFor, within } from '@testing-library/react'\nimport userEvent from '@testing-library/user-event'\nimport { beforeEach, describe, expect, it, vi } from 'vitest'\nimport { createTRPCReact, getQueryKey } from '@trpc/react-query'\nimport type { AnyRouter } from '@trpc/server'\nimport { DesktopClient, type ShellSnapshot } from '@prisma-airs/desktop-contracts'\nimport { App } from '../../app'\nimport { ACADEMY_ORIGIN, ACCOUNT, GUEST, academySnapshot, scriptedNative as academyNative } from '../../modules/academy/test-support'\nimport { scriptedNative } from '../../test/native'\nimport { fxSwitcher } from '../fixtures'\nimport { resetShellStore } from '../store'\nimport tokensCss from '../../styles/tokens.css?raw'\nimport { Academy, PATHS_LIST_KEY, themeFor } from './academy'\n\nbeforeEach(() => {\n    resetShellStore()\n    window.scrollTo = vi.fn() as never\n    // The WebView has matchMedia; jsdom does not (the lab runner reads the desktop-width layout).\n    window.matchMedia = vi.fn().mockReturnValue({ matches: true, addEventListener: vi.fn(), removeEventListener: vi.fn() }) as never\n})\n\nconst PATH = {\n    id: 'path-runtime',\n    slug: 'runtime-path',\n    title: 'Runtime Security Path',\n    tagline: 'Protect prompts and responses at runtime.',\n    familyKey: 'prisma-airs',\n    iconKey: null,\n    tone: 'info',\n    courseCount: 1,\n    estMinutes: 30,\n    unitCount: 4,\n    unitsDone: 1,\n    locked: false,\n    lockReason: null,\n}\nconst GATEWAY = {\n    ...PATH,\n    id: 'path-gateway',\n    slug: 'gateway-path',\n    title: 'AI Gateway Path',\n    tagline: 'Route and govern model traffic.',\n    familyKey: 'gateway',\n    unitsDone: 0,\n    estMinutes: 45,\n    locked: true,\n}\n\n/** The path's own page as `paths.get` returns it (the router's shape: the sections and their course cards). */\nconst PATH_PAGE = {\n    id: PATH.id,\n    slug: PATH.slug,\n    title: PATH.title,\n    tagline: 'Protect prompts and responses at runtime.',\n    description: 'Scan what reaches the model and what comes back.',\n    level: 'associate',\n    programId: null,\n    iconKey: null,\n    tone: 'info',\n    sections: [\n        {\n            id: 'sec-1',\n            title: 'Foundations',\n            description: 'The scan loop and its verdicts.',\n            order: 0,\n            courses: [\n                {\n                    id: 'runtime-security',\n                    slug: 'runtime-security',\n                    title: 'Runtime Security Foundations',\n                    description: 'Scan prompts and responses at runtime.',\n                    level: 'associate',\n                    coursePurpose: null,\n                    iconKey: null,\n                    tone: 'info',\n                    estMinutes: 150,\n                    order: 0,\n                    unitCount: 4,\n                    unitsDone: 1,\n                    moduleCount: 2,\n                    modulesComplete: 0,\n                    status: 'published',\n                    teaser: null,\n                },\n            ],\n        },\n    ],\n}\n\nconst replies = { 'paths.list': [PATH, GATEWAY], 'library.list': [] }\n\ndescribe('C42 Academy board', () => {\n    it('draws the chrome around the guest catalog: the pills, the frame, Your place, the Learning paths row from paths.list, through the guest generation only', async () => {\n        const native = academyNative(replies)\n        render(<Academy snapshot={academySnapshot(false)} client={native.client} onNavigate={vi.fn()} />)\n        expect(screen.getByRole('region', { name: 'Academy' })).toBeInTheDocument()\n        expect(screen.queryByRole('heading', { name: 'AI Security Academy' })).toBeNull()\n        expect(screen.getByText('Learn each product with your own tenant beside you')).toBeInTheDocument()\n        expect(document.querySelector('[data-slot=\"academy-account\"]')).toHaveTextContent('Browsing as a guest')\n        expect(document.querySelector('[data-slot=\"academy-offline-pill\"]')).toBeNull()\n        // The learner pages in the left card, Academy's own catalog heading.\n        const pages = await screen.findByRole('region', { name: 'Academy pages' })\n        expect(await within(pages).findByRole('heading', { level: 1, name: 'What will you take up next?' })).toBeInTheDocument()\n        expect((await within(pages).findAllByText('Runtime Security Path')).length).toBeGreaterThan(0)\n        // Your place: the guest note, Open Settings and Learn only.\n        const place = screen.getByRole('region', { name: 'Your place' })\n        expect(within(place).getByText('Sign in from Settings to track progress and take knowledge checks.')).toBeInTheDocument()\n        expect(within(place).getByRole('button', { name: 'Open Settings' })).toBeInTheDocument()\n        const nav = within(place).getByRole('navigation', { name: 'Academy sections' })\n        expect(\n            within(nav)\n                .getAllByRole('link')\n                .map((l) => l.textContent)\n        ).toEqual(['Learn'])\n        expect(within(nav).getByRole('link', { name: 'Learn' })).toHaveAttribute('aria-current', 'page')\n        // The Learning paths row: the catalog's paths as cards with their units.\n        const paths = await screen.findByRole('region', { name: 'Learning paths' })\n        const cards = await within(paths).findAllByRole('link', { name: /^Open / })\n        expect(cards.map((c) => c.getAttribute('aria-label'))).toEqual(['Open Runtime Security Path', 'Open AI Gateway Path'])\n        expect(cards[0]).toHaveTextContent('1 of 4 units · 30 min')\n        expect(within(cards[0]!).getByRole('progressbar', { name: 'Runtime Security Path progress' })).toHaveAttribute('aria-valuenow', '25')\n        expect(cards[1]).toHaveTextContent('Locked')\n        // Every call went through the guest generation, as public queries.\n        expect(native.calls.map((i) => [i.procedure, i.procedureKind, i.learner])).toEqual(expect.arrayContaining([['paths.list', 'query', GUEST]]))\n        expect(new Set(native.calls.map((i) => i.learner))).toEqual(new Set([GUEST]))\n        expect(document.querySelector('[data-slot=\"academy-v2\"]')).not.toBeNull()\n        expect(screen.queryByRole('link', { name: /sign up/i })).toBeNull()\n    })\n\n    it('a path card opens the real path page within the destination: read by its slug, titled by the path, named in the trail', async () => {\n        const user = userEvent.setup()\n        // `paths.get` answers the catalog's slug only (the server's NOT_FOUND for any other).\n        const native = academyNative((procedure, _learner, input) =>\n            procedure === 'paths.list'\n                ? [PATH, GATEWAY]\n                : procedure === 'library.list'\n                  ? []\n                  : procedure === 'paths.get' && (input as { pathSlug?: string })?.pathSlug === PATH.slug\n                    ? PATH_PAGE\n                    : undefined\n        )\n        render(<Academy snapshot={academySnapshot(false)} client={native.client} onNavigate={vi.fn()} />)\n        const paths = await screen.findByRole('region', { name: 'Learning paths' })\n        await user.click(await within(paths).findByRole('link', { name: 'Open Runtime Security Path' }))\n        const pages = await screen.findByRole('region', { name: 'Academy pages' })\n        expect(await within(pages).findByRole('heading', { level: 1, name: 'Runtime Security Path' })).toBeInTheDocument()\n        expect(within(pages).queryByRole('heading', { level: 1, name: 'What will you take up next?' })).toBeNull()\n        expect(within(pages).queryByText('Path not found.')).toBeNull()\n        expect(within(pages).getByText('Foundations')).toBeInTheDocument()\n        expect(within(pages).getByText('Runtime Security Foundations')).toBeInTheDocument()\n        const trail = within(pages).getByRole('navigation', { name: 'Academy location' })\n        expect(trail).toHaveTextContent('Runtime Security Path')\n        const get = native.calls.filter((i) => i.procedure === 'paths.get')\n        expect(get.map((i) => JSON.parse(i.input ?? '{}'))).toEqual([{ json: { pathSlug: 'runtime-path' } }])\n    })\n\n    it('the Learning paths row reads through the key Academy’s own paths.list query uses, holding the raw reply', () => {\n        // tRPC react-query's key for `trpc.paths.list.useQuery()`: `utils.paths.list.invalidate()` (after a course reset\n        // or an enrollment change) matches it by prefix, and the embed's prefetch fills the same entry.\n        const t = createTRPCReact<AnyRouter>() as unknown as { paths: { list: unknown } }\n        const key = (getQueryKey as unknown as (procedure: unknown, input?: unknown, type?: string) => unknown)(t.paths.list, undefined, 'query')\n        expect(PATHS_LIST_KEY).toEqual(key)\n    })\n","exit_code":0,"status":"completed"}}
