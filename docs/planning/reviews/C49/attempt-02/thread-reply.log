{"type":"item.completed","item":{"id":"item_8","type":"command_execution","command":"/bin/zsh -lc 'cat apps/desktop/src/shell/appearance.ts apps/desktop/src/shell/appearance.test.ts apps/desktop/src/v2/settings/refinement-settings.test.tsx apps/desktop/src/shell/academy-theme-boundary.test.ts'","aggregated_output":"import { GENERAL_THEMES, applyThemeAttribute, type GeneralThemeId } from '@ai-security-academy/presentation'\nimport type { ColorTheme, Theme } from '@prisma-airs/desktop-contracts'\n\n/** Maps the desktop preference to a general shared theme (never an earned skin). */\nexport function resolveTheme(theme: Theme, prefersDark: boolean): GeneralThemeId {\n    if (theme === 'light') return GENERAL_THEMES.light\n    if (theme === 'dark') return GENERAL_THEMES.dark\n    return prefersDark ? GENERAL_THEMES.dark : GENERAL_THEMES.light\n}\n\nconst darkQuery = () =>\n    typeof window.matchMedia === 'function'\n        ? window.matchMedia('(prefers-color-scheme: dark)')\n        : null\n\n/** Applies the preference now and follows OS changes while it is `system`. */\nexport function followAppearance(theme: Theme, colorTheme: ColorTheme = 'prismaAirs'): () => void {\n    const query = darkQuery()\n    const apply = () => {\n        const general = resolveTheme(theme, query?.matches ?? true)\n        // Academy keeps its general palette, including portals attached to body.\n        applyThemeAttribute(general)\n        document.documentElement.dataset.appearance = general === GENERAL_THEMES.dark ? 'dark' : 'light'\n        document.documentElement.dataset.colorTheme = colorTheme\n    }\n    apply()\n    if (theme !== 'system' || !query) return () => undefined\n    query.addEventListener('change', apply)\n    return () => query.removeEventListener('change', apply)\n}\nimport { afterEach, describe, expect, it, vi } from 'vitest'\nimport { followAppearance } from './appearance'\n\nafterEach(() => {\n    vi.unstubAllGlobals()\n    delete document.documentElement.dataset.colorTheme\n    delete document.documentElement.dataset.appearance\n    delete document.documentElement.dataset.theme\n})\n\ndescribe('independent desktop and Academy appearance', () => {\n    it('selects the desktop palette without replacing the Academy general theme', () => {\n        followAppearance('light', 'prismaAirs')()\n        expect(document.documentElement.dataset.theme).toBe('paper')\n        expect(document.documentElement.dataset.colorTheme).toBe('prismaAirs')\n        expect(document.documentElement.dataset.appearance).toBe('light')\n        followAppearance('light', 'gruvbox')()\n        expect(document.documentElement.dataset.theme).toBe('paper')\n        expect(document.documentElement.dataset.colorTheme).toBe('gruvbox')\n    })\n\n    it('follows system appearance while retaining the chosen palette and cleans up', () => {\n        let notify = () => undefined\n        const remove = vi.fn()\n        const query = { matches: false, addEventListener: vi.fn((_name, cb) => { notify = cb }), removeEventListener: remove }\n        vi.stubGlobal('matchMedia', () => query)\n        const stop = followAppearance('system', 'prismaAirs')\n        expect(document.documentElement.dataset.appearance).toBe('light')\n        query.matches = true\n        notify()\n        expect(document.documentElement.dataset.appearance).toBe('dark')\n        expect(document.documentElement.dataset.theme).toBe('gruvbox')\n        expect(document.documentElement.dataset.colorTheme).toBe('prismaAirs')\n        stop()\n        expect(remove).toHaveBeenCalledWith('change', notify)\n    })\n})\nimport { render, screen, within } from '@testing-library/react'\nimport userEvent from '@testing-library/user-event'\nimport { describe, expect, it, vi } from 'vitest'\nimport type { SetupMode, SetupView } from '@prisma-airs/desktop-contracts'\nimport { SettingsView } from '../../shell/feature-view'\nimport { Wizard } from '../wizard/wizard'\nimport { draft, setupView } from '../wizard/fixtures'\nimport { fxHome, fxSwitcher } from '../fixtures'\nimport { TenantsSettings } from '../../modules/tenants/tenants-settings'\n\nconst dispatch = () => vi.fn().mockResolvedValue({ kind: 'admitted', operation: null })\n\ndescribe('compact settings contracts', () => {\n    it('changes palette independently from appearance', async () => {\n        const user = userEvent.setup()\n        const send = dispatch()\n        const appearance = vi.fn()\n        render(<SettingsView snapshot={{ ...fxHome(), colorTheme: 'prismaAirs', appearance: 'light' }} pending={false} onSetAppearance={appearance} dispatch={send} observeManagement={vi.fn()} />)\n        await user.selectOptions(screen.getByRole('combobox', { name: 'Theme' }), 'gruvbox')\n        expect(send).toHaveBeenCalledWith({ kind: 'setColorTheme', theme: 'gruvbox' })\n        expect(appearance).not.toHaveBeenCalled()\n        await user.selectOptions(screen.getByRole('combobox', { name: 'Appearance' }), 'dark')\n        expect(appearance).toHaveBeenCalledWith('dark')\n    })\n\n    it('edits only the explicitly selected profile metadata', async () => {\n        const user = userEvent.setup()\n        const send = dispatch()\n        const snapshot = fxSwitcher()\n        render(<TenantsSettings snapshot={snapshot} dispatch={send} observeManagement={vi.fn()} />)\n        const card = within(document.querySelector('[data-slot=\"update-tenant\"]') as HTMLElement)\n        await user.selectOptions(card.getByRole('combobox', { name: 'Tenant to update' }), snapshot.tenants[1]!.id)\n        await user.click(card.getByRole('button', { name: 'Edit' }))\n        await user.clear(card.getByRole('textbox', { name: 'Display name' }))\n        await user.type(card.getByRole('textbox', { name: 'Display name' }), 'Renamed')\n        await user.selectOptions(card.getByRole('combobox', { name: 'Environment' }), 'staging')\n        await user.click(card.getByRole('button', { name: 'Save changes' }))\n        expect(send).toHaveBeenCalledWith({ kind: 'editTenant', tenant: snapshot.tenants[1]!.id, label: 'Renamed', environment: 'staging' })\n        expect(send.mock.calls).toHaveLength(1)\n    })\n\n    it('does not carry a delete confirmation to a different profile after removal', async () => {\n        const user = userEvent.setup()\n        const send = dispatch()\n        const snapshot = fxSwitcher()\n        const view = render(<TenantsSettings snapshot={snapshot} dispatch={send} observeManagement={vi.fn()} />)\n        const card = () => within(document.querySelector('[data-slot=\"update-tenant\"]') as HTMLElement)\n        await user.click(card().getByRole('button', { name: 'Delete' }))\n        expect(card().getByRole('button', { name: /Confirm deleting Northwind/ })).toBeInTheDocument()\n        view.rerender(<TenantsSettings snapshot={{ ...snapshot, tenants: [snapshot.tenants[1]!] }} dispatch={send} observeManagement={vi.fn()} />)\n        expect(card().queryByRole('button', { name: /Confirm deleting/ })).not.toBeInTheDocument()\n        expect(card().getByRole('button', { name: 'Delete' })).toBeInTheDocument()\n        expect(send).not.toHaveBeenCalled()\n    })\n\n    it('opens Add as an isolated wizard rather than creating a credential-free profile', async () => {\n        const user = userEvent.setup()\n        const send = dispatch()\n        render(<TenantsSettings snapshot={fxSwitcher()} dispatch={send} observeManagement={vi.fn()} />)\n        await user.click(screen.getByRole('button', { name: 'Add tenant…' }))\n        expect(screen.getByRole('dialog', { name: 'Add a tenant' })).toBeInTheDocument()\n        expect(screen.queryByRole('radio', { name: 'Custom HTTPS endpoint' })).not.toBeInTheDocument()\n        expect(send).not.toHaveBeenCalled()\n    })\n})\n\ndescribe.each<SetupMode>(['firstRun', 'add'])('required OAuth in %s setup', (mode) => {\n    it('cannot continue with only a Scan Key and no management client', () => {\n        const setup = { ...setupView({ mode, tenant: draft({ scan: { state: 'ready', mode: 'keychain', failure: null } }) }), scanRequired: false, managementRequired: true } as SetupView\n        render(<Wizard snapshot={{ ...fxHome(), setup }} dispatch={dispatch()} observeManagement={vi.fn()} mode={mode} initial={{ step: 'tenant' }} onClose={vi.fn()} onNavigate={vi.fn()} />)\n        expect(screen.getByRole('button', { name: 'Save the management client to continue' })).toBeDisabled()\n    })\n\n    it('can reach verification with a management client and no Scan Key', () => {\n        const setup = { ...setupView({ mode, tenant: draft({ management: { state: 'ready', mode: 'keychain', failure: null, clientId: 'synthetic-client', tokenOrigin: 'https://auth.apps.paloaltonetworks.com' } }) }), scanRequired: false, managementRequired: true } as SetupView\n        render(<Wizard snapshot={{ ...fxHome(), setup }} dispatch={dispatch()} observeManagement={vi.fn()} mode={mode} initial={{ step: 'tenant' }} onClose={vi.fn()} onNavigate={vi.fn()} />)\n        expect(screen.getByRole('button', { name: 'Continue' })).toBeEnabled()\n        expect(screen.getByText(/^OAuth authentication is required before/)).toBeInTheDocument()\n    })\n\n    it('clears an entered client secret when the draft context changes', async () => {\n        const user = userEvent.setup()\n        const setup = { ...setupView({ mode, tenant: draft() }), scanRequired: false, managementRequired: true } as SetupView\n        const props = { dispatch: dispatch(), observeManagement: vi.fn(), mode, initial: { step: 'tenant' as const }, onClose: vi.fn(), onNavigate: vi.fn() }\n        const view = render(<Wizard {...props} snapshot={{ ...fxHome(), setup }} />)\n        const secret = screen.getByLabelText('Client secret') as HTMLInputElement\n        await user.type(secret, 'synthetic-never-submitted-secret')\n        view.rerender(<Wizard {...props} snapshot={{ ...fxHome(), setup: { ...setup, context: 'cx-another-draft-context' } }} />)\n        expect(secret.value).toBe('')\n        expect(props.dispatch).not.toHaveBeenCalled()\n    })\n})\nimport { afterEach, beforeEach, describe, expect, it } from 'vitest'\nimport tokens from '../styles/tokens.css?raw'\n\n// Inspect the real stylesheet's selector participation. jsdom cannot resolve\n// inherited CSS variables or qualify native computed colors and focus pixels.\nlet stylesheet: HTMLStyleElement\nlet fixture: HTMLDivElement\nlet rules: CSSStyleRule[]\n\nbeforeEach(() => {\n    stylesheet = document.createElement('style')\n    stylesheet.textContent = tokens\n    document.head.append(stylesheet)\n    rules = [...stylesheet.sheet!.cssRules].filter((rule): rule is CSSStyleRule => rule.type === CSSRule.STYLE_RULE)\n    fixture = document.createElement('div')\n    fixture.innerHTML = `\n        <div data-v2-shell>\n            <header data-desktop-theme><button id=\"header\">Explain</button></header>\n            <nav data-desktop-theme><button id=\"rail\" data-inset-focus aria-current=\"page\">Settings</button></nav>\n            <main data-desktop-theme><section class=\"settings-card\">\n                <input id=\"desktop-input\"><select id=\"desktop-select\"><option>Light</option></select>\n                <textarea id=\"desktop-textarea\"></textarea><button id=\"desktop-button\">Save</button>\n            </section></main>\n            <main><section data-slot=\"academy-pages\">\n                <input id=\"academy-input\"><select id=\"academy-select\"><option>General theme</option></select>\n                <textarea id=\"academy-textarea\"></textarea><button id=\"academy-button\">Continue</button>\n            </section></main>\n        </div>\n        <div data-v2-scrim data-desktop-theme><div role=\"dialog\"><input id=\"dialog-input\"><button id=\"dialog-button\">Apply</button></div></div>\n        <div data-slot=\"wizard\" data-desktop-theme><input id=\"wizard-input\"><button id=\"wizard-button\">Continue</button></div>\n        <div data-academy-portal><input id=\"academy-portal-input\"><button id=\"academy-portal-button\">Close</button></div>`\n    document.body.append(fixture)\n})\n\nafterEach(() => {\n    stylesheet.remove()\n    fixture.remove()\n})\n\nfunction desktopRulesFor(id: string, properties: string[]): string[] {\n    const control = fixture.querySelector<HTMLElement>(`#${id}`)!\n    control.focus()\n    return rules.filter((rule) => properties.some((property) => rule.style.getPropertyValue(property).includes('var(--v2-')) && control.matches(rule.selectorText)).map((rule) => rule.selectorText)\n}\n\ndescribe('desktop CSS ownership at the Academy boundary', () => {\n    it.each(['academy-input', 'academy-select', 'academy-textarea', 'academy-portal-input'])('leaves %s form colors to Academy', (id) => {\n        expect(desktopRulesFor(id, ['background', 'color', 'border'])).toEqual([])\n    })\n\n    it.each(['academy-input', 'academy-select', 'academy-textarea', 'academy-button', 'academy-portal-button'])('leaves %s focus treatment to Academy', (id) => {\n        expect(desktopRulesFor(id, ['outline', 'outline-color'])).toEqual([])\n    })\n\n    it.each(['desktop-input', 'desktop-select', 'desktop-textarea', 'dialog-input', 'wizard-input'])('keeps desktop form colors on %s', (id) => {\n        expect(desktopRulesFor(id, ['background', 'color', 'border']).length).toBeGreaterThan(0)\n    })\n\n    it.each(['header', 'rail', 'desktop-button', 'dialog-button', 'wizard-button'])('keeps desktop focus treatment on %s', (id) => {\n        expect(desktopRulesFor(id, ['outline']).length).toBeGreaterThan(0)\n        if (id === 'rail') expect(desktopRulesFor(id, ['outline-color']).length).toBeGreaterThan(0)\n    })\n})\n","exit_code":0,"status":"completed"}}
