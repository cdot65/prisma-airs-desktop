{"type":"item.completed","item":{"id":"item_48","type":"command_execution","command":"/bin/zsh -lc \"sed -n '1,175p' tools/native-acceptance/acceptance_p11_resume.py && sed -n '1,145p' tools/native-acceptance/acceptance_p11_continue.py && sed -n '1,130p' tools/native-acceptance/acceptance_p11_finish.py\"","aggregated_output":"#!/usr/bin/env python3\n\"\"\"Resume the first unfinished P11 slice; never repeat completed setup.\"\"\"\nimport argparse\nimport json\nimport os\nfrom pathlib import Path\nimport platform\nimport sys\nimport tempfile\nimport time\n\nimport acceptance_p11 as core\nimport acceptance_p11_api as api\nimport acceptance_p11_settings as settings\nimport acceptance_p11_shell as shell\nimport acceptance_p11_setup as setup\n\nROOT = core.ROOT\nC46 = 'C46-N01'\n\n\ndef relevant_c46(root=ROOT):\n    paths = set(core._binding.helper_closure(root, 'acceptance_p11_setup'))\n    paths.add('tools/native-acceptance/acceptance_p11.py')\n    if 'tools/native-acceptance/acceptance_p11_api.py' in paths:\n        raise RuntimeError('C46 dependency closure unexpectedly includes API helper')\n    return sorted(paths)\n\n\ndef inspect_previous(path, prepare, work, state_path):\n    \"\"\"Pure admission checks; no app, endpoint, certificate or vault operation.\"\"\"\n    if work.is_symlink(): raise RuntimeError('resume work cannot be a symlink')\n    path, work = path.resolve(), work.resolve()\n    raw = json.loads(path.read_text())\n    require = core.Context.require\n    require(raw['schema'] == 'airs-desktop/p11-native-observations/1'\n            and raw['subject'] == 'P11' and raw['status'] == 'failed'\n            and raw['exit_code'] == 1 and raw['complete'] is False,\n            'only the failed first-unfinished API attempt may resume')\n    require(len(raw['checks']) == 1 and raw['checks'][0]['id'] == C46\n            and raw['checks'][0]['facts']\n            and all(value is True for value in raw['checks'][0]['facts'].values()),\n            'completed C46 facts missing; setup is not eligible for reuse')\n    require(raw['host'] == platform.platform(), 'resume must use the same native platform')\n    require(core.sha(ROOT/'docs/architecture/native-checks.json') == raw['binding']['native_inventory_sha256'], 'native scope changed')\n    require(core.sha(prepare) == raw['binding']['prepare']['sha256'],\n            'resume preparation differs')\n    for name in relevant_c46():\n        require(core.sha(ROOT/name) == raw['helper_closure'].get(name),\n                'completed C46 helper changed: ' + name)\n    for name, digest in raw['artifact_sha256'].items():\n        artifact = (ROOT/name).resolve()\n        require(artifact.is_relative_to(path.parent) and core.sha(artifact) == digest,\n                'prior immutable native artifact changed')\n    require(work.parent == Path(tempfile.gettempdir()).resolve()\n            and work.name.startswith('airs-p11-owned-') and work.is_dir()\n            and not work.is_symlink() and work.stat().st_uid == os.getuid(),\n            'resume work directory is not this user owned fixture')\n    previous_state = path.parent/'fixture-state-final.json'\n    require(raw['artifact_sha256'].get(str(previous_state.relative_to(ROOT))) == core.sha(previous_state),\n            'prior final fixture state is not bound')\n    state = json.loads(state_path.read_text())\n    require(state == json.loads(previous_state.read_text()), 'fixture state changed since failed attempt')\n    return raw, state\n\n\ndef restored_context(args):\n    import fixture_app as fx\n    import acceptance_c08 as c8\n    prepared, bundle = core.verify_prepare(args.prepare.resolve())\n    previous, state = inspect_previous(args.previous, args.prepare, args.work, Path(fx.DATA)/'state.json')\n    if prepared['executable_sha256'] != previous['executable_sha256'] or prepared['bundle_sha256'] != previous['bundle_sha256']:\n        raise RuntimeError('resume app artifact differs')\n    work = args.work.resolve()\n    guard_files = ['scan/ca.pem', 'scan/leaf.pem', 'scan/leaf.key', 'scan/mode.json',\n                   'mgmt/mode.json', 'mgmt/issued.json', 'mgmt/idp-key.pem',\n                   'academy/ca.pem', 'academy/leaf.pem', 'academy/leaf.key',\n                   'academy/mode.json', 'academy/catalog.json']\n    for name in guard_files:\n        file = work/name\n        if not file.is_file() or file.is_symlink() or file.stat().st_uid != os.getuid():\n            raise RuntimeError('owned fixture input missing: '+name)\n    expected_roots = (work/'scan/ca.pem').read_bytes()+b'\\n'+(work/'academy/ca.pem').read_bytes()\n    if Path(fx.ROOTS).read_bytes() != expected_roots:\n        raise RuntimeError('installed owned trust roots differ from retained CAs')\n    if Path(c8.MGMT_ORIGIN_FILE).read_text().strip() != 'https://localhost:62780' or (Path(fx.DATA)/'fixture-academy-origin').read_text().strip() != 'https://localhost:62781':\n        raise RuntimeError('retained management/Academy origins changed')\n    ctx = core.Context.__new__(core.Context)  # no new scratch root or reset\n    ctx.prepare_path, ctx.prepared, ctx.bundle = args.prepare.resolve(), prepared, bundle\n    ctx.out = args.out.resolve(); ctx.out.mkdir(parents=True, exist_ok=False)\n    ctx.work, ctx.log, ctx.rows, ctx.errors, ctx.artifacts = work, [], {}, [], {}\n    ctx.fixture_root_owned = False\n    ctx.argv = [sys.executable, *sys.argv]\n    ctx.argv_source = 'sys.executable + sys.argv'\n    ctx.started = time.strftime('%Y-%m-%dT%H:%M:%SZ', time.gmtime())\n    ctx.execution_exit_code = 1\n    ctx.app = ctx.scan = ctx.mgmt = ctx.academy = None\n    ctx.closure = core._binding.helper_closure(ROOT, 'acceptance_p11_resume')\n    ctx.binding = dict(previous['binding'], helper_closure=ctx.closure,\n                       conditions={'platform': platform.platform(), 'hostname': platform.node()})\n    tenant = next(t for t in state['tenants'] if t['label'] == 'P11 Northwind')\n    warning = next(w for group in state['tenantWarnings'] if group['tenant'] == tenant['id']\n                   for w in group['warnings'] if w['product'] == 'modelSkill')\n    ctx.state = {'bootstrap_tenant': 'P11 Northwind', 'spare_tenant': 'P11 Secondary',\n                 'bootstrap_tenant_id': tenant['id'], 'original_supply_chain_warning': warning,\n                 'scan_absent': True}\n    ctx.continuation = {'observations': {'path': str(args.previous.resolve().relative_to(ROOT)),\n                                         'sha256': core.sha(args.previous)},\n                        'completed_ids': [C46], 'remaining_ids': sorted(set(core.inventory())-{C46}),\n                        'work': str(work), 'fixture_state_semantically_equal': True,\n                        'owned_inputs_sha256': {name: core.sha(work/name) for name in guard_files},\n                        'installed_roots_sha256': core.sha(fx.ROOTS),\n                        'certificate_generation_or_install_executed': False}\n    ctx.save('resume-preconditions', ctx.continuation)\n    # Restore only existing server state. Constructors/install/mode are forbidden.\n    ctx.scan = fx.ScanEndpoint.__new__(fx.ScanEndpoint)\n    ctx.scan.dir, ctx.scan.key, ctx.scan.port, ctx.scan.proc = str(work/'scan'), c8.SCAN_KEY, fx.free_port(), None\n    ctx.mgmt = c8.MgmtEndpoint.__new__(c8.MgmtEndpoint)\n    ctx.mgmt.certs, ctx.mgmt.dir, ctx.mgmt.port, ctx.mgmt.proc = str(work/'scan'), str(work/'mgmt'), 62780, None\n    ctx.academy = fx.AcademyEndpoint.__new__(fx.AcademyEndpoint)\n    ctx.academy.dir, ctx.academy.port, ctx.academy.proc = str(work/'academy'), 62781, None\n    return ctx\n\n\ndef execute(args):\n    import fixture_app as fx\n    if not os.environ.get('AIRS_NATIVE_ORCHESTRATOR'):\n        raise RuntimeError('set AIRS_NATIVE_ORCHESTRATOR to the actual VM UI operator')\n    ctx = restored_context(args)\n    os.environ['AIRS_NATIVE_PROCESS_RECORD'] = str(ctx.out/'candidate-processes.json')\n    offsets = {}\n    original_sh = fx.sh\n    def checked_sh(argv, **kwargs):\n        result = original_sh(argv, **kwargs)\n        if Path(str(argv[0])).name == 'osascript' and result.returncode != 0:\n            raise RuntimeError('System Events transport rejected owned native input')\n        return result\n    fx.sh = checked_sh\n    try:\n        ctx.app = fx.App(str(ctx.bundle), str(ctx.work), ctx.log)\n        candidate = ctx.app.candidate\n        ctx.require(not candidate.matching(candidate.app_path) and not candidate.matching(candidate.engine_path),\n                    'unowned fixture process exists; refusing resume')\n        ctx.fixture_root_owned = True\n        for name, endpoint in [('scan', ctx.scan), ('management', ctx.mgmt), ('academy', ctx.academy)]:\n            offsets[name] = len(endpoint.requests())\n            endpoint.start()\n        ctx.save('endpoint-history-offsets', offsets)\n        ctx.app.launch()\n        api.run(ctx, prior_first_use={'observations': ctx.continuation['observations'],\n            'evidence': {'path': str((args.previous.resolve().parent/'c48-first-use.json').relative_to(ROOT)),\n                         'sha256': core.sha(args.previous.resolve().parent/'c48-first-use.json')}})\n        settings.run(ctx)\n        shell.run(ctx)\n        setup.warning_flows(ctx)\n        core.verify_prepare(ctx.prepare_path)\n        ctx.require(core._binding.helper_closure(ROOT, 'acceptance_p11_resume') == ctx.closure,\n                    'resume helper changed during execution')\n        ctx.require(set(ctx.rows) == set(ctx.continuation['remaining_ids'])\n                    and all(value is True for row in ctx.rows.values() for value in row['facts'].values()),\n                    'unfinished native facts remain incomplete')\n        ctx.execution_exit_code = 0\n    except BaseException as error:\n        ctx.execution_exit_code = 130 if isinstance(error, KeyboardInterrupt) else 1\n        ctx.errors.append({'type': type(error).__name__, 'message': str(error)})\n        if ctx.app:\n            try: ctx.save('failure-tree')\n            except Exception: pass\n    finally:\n        if ctx.fixture_root_owned:\n            for name, endpoint in [('management', ctx.mgmt), ('scan', ctx.scan), ('academy', ctx.academy)]:\n                try:\n                    ctx.save(name+'-requests', {'prior_count': offsets.get(name, 0),\n                        'new_requests': endpoint.requests()[offsets.get(name, 0):]})\n                except Exception as error:\n#!/usr/bin/env python3\n\"\"\"Continue seven unfinished assertions; preserve five completed observations.\"\"\"\nimport argparse\nimport json\nimport os\nfrom pathlib import Path\nimport platform\nimport sys\nimport tempfile\nimport time\n\nimport acceptance_p11 as core\nimport acceptance_p11_resume as prior_driver\nimport acceptance_p11_roles as roles\nimport acceptance_p11_api as api\nimport acceptance_p11_settings as settings\nimport acceptance_p11_shell as shell\nimport acceptance_p11_setup as setup\n\nROOT = core.ROOT\nC46 = 'C46-N01'\n\n\ndef relevant_c46(root=ROOT):\n    paths = set(core._binding.helper_closure(root, 'acceptance_p11_setup'))\n    paths.add('tools/native-acceptance/acceptance_p11.py')\n    if 'tools/native-acceptance/acceptance_p11_api.py' in paths:\n        raise RuntimeError('C46 dependency closure unexpectedly includes API helper')\n    return sorted(paths)\n\n\ndef previous_scope(check_id):\n    if check_id == 'C46-N01':\n        return relevant_c46()\n    helper = 'acceptance_p11_api' if check_id.startswith('C48-') else 'acceptance_p11_settings'\n    paths = set(core._binding.helper_closure(ROOT, helper))\n    paths.update(core._binding.helper_closure(ROOT, 'fixture_app'))\n    paths.update(core._binding.helper_closure(ROOT, 'acceptance_c29'))\n    paths.update(['tools/native-acceptance/acceptance_p11.py',\n                  'tools/native-acceptance/acceptance_p11_resume.py'])\n    return sorted(paths)\n\n\ndef inspect_chain(paths, prepare, work, state_path):\n    \"\"\"Validate both failed runs and latest state before any new native action.\"\"\"\n    require = core.Context.require\n    require(len(paths) == 2, 'this continuation requires original06 and original07')\n    if work.is_symlink(): raise RuntimeError('resume work cannot be a symlink')\n    work = work.resolve()\n    require(work.parent == Path(tempfile.gettempdir()).resolve() and work.name.startswith('airs-p11-owned-')\n            and work.is_dir() and work.stat().st_uid == os.getuid(), 'unowned continuation work')\n    prepared = json.loads(prepare.read_text())\n    completed = set()\n    current = core._binding.helper_closure(ROOT, 'acceptance_p11_continue')\n    raws = []\n    for path in paths:\n        path = path.resolve(); raw = json.loads(path.read_text())\n        require(raw['schema'] == 'airs-desktop/p11-native-observations/1'\n                and raw['subject'] == 'P11' and raw['status'] == 'failed'\n                and raw['exit_code'] == 1 and raw['complete'] is False and raw['errors'],\n                'prior process outcome must remain failed')\n        require(raw['host'] == platform.platform()\n                and raw['executable_sha256'] == prepared['executable_sha256']\n                and raw['bundle_sha256'] == prepared['bundle_sha256']\n                and raw['binding']['prepare']['sha256'] == core.sha(prepare)\n                and raw['binding']['native_inventory_sha256'] == core.sha(ROOT/'docs/architecture/native-checks.json'),\n                'prior native artifact/platform/prepare differs')\n        for name, digest in raw['artifact_sha256'].items():\n            artifact = (ROOT/name).resolve()\n            require(artifact.is_relative_to(path.parent) and core.sha(artifact) == digest,\n                    'prior immutable native artifact changed')\n        for row in raw['checks']:\n            require(row['id'] not in completed and row['facts']\n                    and all(value is True for value in row['facts'].values()),\n                    'prior completed assertion missing, duplicated or failed')\n            for name in previous_scope(row['id']):\n                require(raw['helper_closure'].get(name) == current.get(name) == core.sha(ROOT/name),\n                        'prior relevant helper changed: '+name)\n            completed.add(row['id'])\n        raws.append(raw)\n    expected = {'C46-N01', 'C48-N01', 'C48-N02', 'C48-N03', 'C49-N01'}\n    require(completed == expected, 'continue from the first unfinished C49 theme assertion only')\n    latest = paths[-1].resolve()\n    require(raws[-1]['continuation']['observations'] ==\n            {'path': str(paths[0].resolve().relative_to(ROOT)), 'sha256': core.sha(paths[0])}\n            and raws[-1]['continuation']['work'] == str(work), 'prior continuation chain/work differs')\n    state_file = latest.parent/'fixture-state-final.json'\n    require(raws[-1]['artifact_sha256'].get(str(state_file.relative_to(ROOT))) == core.sha(state_file),\n            'latest final fixture state is not bound')\n    state = json.loads(state_path.read_text())\n    require(state == json.loads(state_file.read_text()), 'fixture state changed since latest failed run')\n    return raws[-1], state\n\n\nclass ContinueContext(core.Context):\n    def press(self, role, label, timeout=12):\n        return roles.press(self, super().press, role, label, timeout)\n\n\n\ndef restored_context(args):\n    import fixture_app as fx\n    import acceptance_c08 as c8\n    prepared, bundle = core.verify_prepare(args.prepare.resolve())\n    previous, state = inspect_chain(args.previous, args.prepare, args.work, Path(fx.DATA)/'state.json')\n    if prepared['executable_sha256'] != previous['executable_sha256'] or prepared['bundle_sha256'] != previous['bundle_sha256']:\n        raise RuntimeError('resume app artifact differs')\n    work = args.work.resolve()\n    guard_files = ['scan/ca.pem', 'scan/leaf.pem', 'scan/leaf.key', 'scan/mode.json',\n                   'mgmt/mode.json', 'mgmt/issued.json', 'mgmt/idp-key.pem',\n                   'academy/ca.pem', 'academy/leaf.pem', 'academy/leaf.key',\n                   'academy/mode.json', 'academy/catalog.json']\n    for name in guard_files:\n        file = work/name\n        if not file.is_file() or file.is_symlink() or file.stat().st_uid != os.getuid():\n            raise RuntimeError('owned fixture input missing: '+name)\n    expected_roots = (work/'scan/ca.pem').read_bytes()+b'\\n'+(work/'academy/ca.pem').read_bytes()\n    if Path(fx.ROOTS).read_bytes() != expected_roots:\n        raise RuntimeError('installed owned trust roots differ from retained CAs')\n    prior_inputs = previous['continuation']\n    if core.sha(fx.ROOTS) != prior_inputs['installed_roots_sha256']:\n        raise RuntimeError('owned trust roots changed since previous admission')\n    for name in guard_files:\n        if name.endswith(('.pem', '.key')) or name == 'academy/catalog.json':\n            if core.sha(work/name) != prior_inputs['owned_inputs_sha256'][name]:\n                raise RuntimeError('retained owned certificate/catalog changed: '+name)\n    if Path(c8.MGMT_ORIGIN_FILE).read_text().strip() != 'https://localhost:62780' or (Path(fx.DATA)/'fixture-academy-origin').read_text().strip() != 'https://localhost:62781':\n        raise RuntimeError('retained management/Academy origins changed')\n    ctx = ContinueContext.__new__(ContinueContext)  # no new scratch root or reset\n    ctx.prepare_path, ctx.prepared, ctx.bundle = args.prepare.resolve(), prepared, bundle\n    ctx.out = args.out.resolve(); ctx.out.mkdir(parents=True, exist_ok=False)\n    ctx.work, ctx.log, ctx.rows, ctx.errors, ctx.artifacts = work, [], {}, [], {}\n    ctx.fixture_root_owned = False\n    ctx.argv = [sys.executable, *sys.argv]\n    ctx.argv_source = 'sys.executable + sys.argv'\n    ctx.started = time.strftime('%Y-%m-%dT%H:%M:%SZ', time.gmtime())\n    ctx.execution_exit_code = 1\n    ctx.app = ctx.scan = ctx.mgmt = ctx.academy = None\n    ctx.closure = core._binding.helper_closure(ROOT, 'acceptance_p11_continue')\n    ctx.binding = dict(previous['binding'], helper_closure=ctx.closure,\n                       conditions={'platform': platform.platform(), 'hostname': platform.node()})\n    tenant = next(t for t in state['tenants'] if t['label'] == 'P11 Northwind')\n    warning = next(w for group in state['tenantWarnings'] if group['tenant'] == tenant['id']\n                   for w in group['warnings'] if w['product'] == 'modelSkill')\n    ctx.state = {'bootstrap_tenant': 'P11 Northwind', 'spare_tenant': 'P11 Secondary',\n#!/usr/bin/env python3\n\"\"\"Finish first-uncompleted credentials and remaining shell/warning assertions.\"\"\"\nimport argparse\nimport json\nimport os\nfrom pathlib import Path\nimport platform\nimport sys\nimport tempfile\nimport time\n\nimport acceptance_p11 as core\nimport acceptance_p11_resume as prior_driver\nimport acceptance_p11_continue as completed_driver\nimport acceptance_p11_credentials as credentials\nimport acceptance_p11_roles as roles\nimport acceptance_p11_api as api\nimport acceptance_p11_settings as settings\nimport acceptance_p11_shell as shell\nimport acceptance_p11_setup as setup\n\nROOT = core.ROOT\nC46 = 'C46-N01'\n\n\ndef relevant_c46(root=ROOT):\n    paths = set(core._binding.helper_closure(root, 'acceptance_p11_setup'))\n    paths.add('tools/native-acceptance/acceptance_p11.py')\n    if 'tools/native-acceptance/acceptance_p11_api.py' in paths:\n        raise RuntimeError('C46 dependency closure unexpectedly includes API helper')\n    return sorted(paths)\n\n\ndef inspect_chain(paths, prepare, work, state_path):\n    \"\"\"Validate both failed runs and latest state before any new native action.\"\"\"\n    require = core.Context.require\n    require(len(paths) >= 2, 'continuation requires its ordered prior observation chain')\n    if work.is_symlink(): raise RuntimeError('resume work cannot be a symlink')\n    work = work.resolve()\n    require(work.parent == Path(tempfile.gettempdir()).resolve() and work.name.startswith('airs-p11-owned-')\n            and work.is_dir() and work.stat().st_uid == os.getuid(), 'unowned continuation work')\n    prepared = json.loads(prepare.read_text())\n    completed = set()\n    current = core._binding.helper_closure(ROOT, 'acceptance_p11_finish')\n    raws = []\n    prior_refs = []\n    for index, path in enumerate(paths):\n        path = path.resolve(); raw = json.loads(path.read_text())\n        require(raw['schema'] == 'airs-desktop/p11-native-observations/1'\n                and raw['subject'] == 'P11' and raw['status'] == 'failed'\n                and raw['exit_code'] == 1 and raw['complete'] is False and raw['errors'],\n                'prior process outcome must remain failed')\n        require(raw['host'] == platform.platform()\n                and raw['executable_sha256'] == prepared['executable_sha256']\n                and raw['bundle_sha256'] == prepared['bundle_sha256']\n                and raw['binding']['prepare']['sha256'] == core.sha(prepare)\n                and raw['binding']['native_inventory_sha256'] == core.sha(ROOT/'docs/architecture/native-checks.json'),\n                'prior native artifact/platform/prepare differs')\n        for name, digest in raw['artifact_sha256'].items():\n            artifact = (ROOT/name).resolve()\n            require(artifact.is_relative_to(path.parent) and core.sha(artifact) == digest,\n                    'prior immutable native artifact changed')\n        if index == 0:\n            require([row['id'] for row in raw['checks']] == ['C46-N01'], 'initial setup scope differs')\n        else:\n            admission = raw['continuation']\n            require(admission.get('origins', [admission['observations']]) == prior_refs\n                    and sorted(admission['completed_ids']) == sorted(completed)\n                    and sorted(admission['remaining_ids']) == sorted(set(core.inventory())-completed),\n                    'prior observation chain is inconsistent')\n        for row in raw['checks']:\n            require(row['id'] not in completed and row['facts']\n                    and all(value is True for value in row['facts'].values()),\n                    'prior completed assertion missing, duplicated or failed')\n            paths_in_scope = relevant_c46() if index == 0 else sorted(raw['helper_closure'])\n            for name in paths_in_scope:\n                require(raw['helper_closure'].get(name) == current.get(name) == core.sha(ROOT/name),\n                        'prior relevant helper changed: '+name)\n            completed.add(row['id'])\n        raws.append(raw)\n        prior_refs.append({'path': str(path.relative_to(ROOT)), 'sha256': core.sha(path)})\n    require(completed and completed < set(core.inventory()), 'no unfinished native assertion remains')\n    latest = paths[-1].resolve()\n    require(raws[-1]['continuation']['work'] == str(work), 'prior continuation work differs')\n    state_file = latest.parent/'fixture-state-final.json'\n    require(raws[-1]['artifact_sha256'].get(str(state_file.relative_to(ROOT))) == core.sha(state_file),\n            'latest final fixture state is not bound')\n    state = json.loads(state_path.read_text())\n    require(state == json.loads(state_file.read_text()), 'fixture state changed since latest failed run')\n    return raws[-1], state\n\n\nclass FinishContext(completed_driver.ContinueContext):\n    pass\n\n\n\ndef restored_context(args):\n    import fixture_app as fx\n    import acceptance_c08 as c8\n    prepared, bundle = core.verify_prepare(args.prepare.resolve())\n    previous, state = inspect_chain(args.previous, args.prepare, args.work, Path(fx.DATA)/'state.json')\n    if prepared['executable_sha256'] != previous['executable_sha256'] or prepared['bundle_sha256'] != previous['bundle_sha256']:\n        raise RuntimeError('resume app artifact differs')\n    work = args.work.resolve()\n    guard_files = ['scan/ca.pem', 'scan/leaf.pem', 'scan/leaf.key', 'scan/mode.json',\n                   'mgmt/mode.json', 'mgmt/issued.json', 'mgmt/idp-key.pem',\n                   'academy/ca.pem', 'academy/leaf.pem', 'academy/leaf.key',\n                   'academy/mode.json', 'academy/catalog.json']\n    for name in guard_files:\n        file = work/name\n        if not file.is_file() or file.is_symlink() or file.stat().st_uid != os.getuid():\n            raise RuntimeError('owned fixture input missing: '+name)\n    expected_roots = (work/'scan/ca.pem').read_bytes()+b'\\n'+(work/'academy/ca.pem').read_bytes()\n    if Path(fx.ROOTS).read_bytes() != expected_roots:\n        raise RuntimeError('installed owned trust roots differ from retained CAs')\n    prior_inputs = previous['continuation']\n    if core.sha(fx.ROOTS) != prior_inputs['installed_roots_sha256']:\n        raise RuntimeError('owned trust roots changed since previous admission')\n    for name in guard_files:\n        if name.endswith(('.pem', '.key')) or name == 'academy/catalog.json':\n            if core.sha(work/name) != prior_inputs['owned_inputs_sha256'][name]:\n                raise RuntimeError('retained owned certificate/catalog changed: '+name)\n    if Path(c8.MGMT_ORIGIN_FILE).read_text().strip() != 'https://localhost:62780' or (Path(fx.DATA)/'fixture-academy-origin').read_text().strip() != 'https://localhost:62781':\n        raise RuntimeError('retained management/Academy origins changed')\n    ctx = FinishContext.__new__(FinishContext)  # no new scratch root or reset\n    ctx.prepare_path, ctx.prepared, ctx.bundle = args.prepare.resolve(), prepared, bundle\n    ctx.out = args.out.resolve(); ctx.out.mkdir(parents=True, exist_ok=False)\n    ctx.work, ctx.log, ctx.rows, ctx.errors, ctx.artifacts = work, [], {}, [], {}\n    ctx.fixture_root_owned = False\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_49","type":"command_execution","command":"/bin/zsh -lc \"cat apps/desktop/src/modules/diagnostics/diagnostics-panel.tsx apps/desktop/src/v2/setup-warning-history.tsx && sed -n '2680,2725p' packages/desktop-contracts/src/client.ts && sed -n '1,170p' apps/desktop/src/v2/v2-shell.test.tsx\"","aggregated_output":"import { useId, useState, type ReactNode } from 'react'\nimport { Button } from '@ai-security-academy/presentation'\nimport type { DiagnosticsClear, DiagnosticsExport, DiagnosticsView } from '@prisma-airs/desktop-contracts'\nimport { type Dispatch, outcomeMessage } from '../tenants/dispatch'\n\nconst EXPORT_TEXT: Record<DiagnosticsExport, string> = {\n    saving: 'Choose where to save the diagnostics in the open dialog.',\n    saved: 'Diagnostics saved.',\n    cancelled: 'Nothing was saved.',\n    failed: 'The diagnostics could not be saved.',\n}\n\nconst CLEAR_TEXT: Record<DiagnosticsClear, string> = {\n    cleared: 'Diagnostics cleared.',\n    failed: 'The diagnostics could not all be removed, so the events counted above are still kept. Try again.',\n}\n\ninterface Props {\n    view: DiagnosticsView\n    dispatch: Dispatch\n    children?: ReactNode\n}\n\n/**\n * Local, redacted diagnostics (C24, D051). The desktop keeps only the kind\n * of each request and why one was refused, storage and reset outcomes, and\n * where the app stopped unexpectedly; never prompts, responses, keys or\n * names. Nothing is sent anywhere: export is explicit and saved where the\n * operator chooses.\n */\nexport function DiagnosticsPanel({ view, dispatch, children }: Props) {\n    const legend = useId()\n    const [message, setMessage] = useState<string | null>(null)\n    const busy = view.export === 'saving'\n\n    async function run(intent: Parameters<Dispatch>[0]) {\n        setMessage(null)\n        const outcome = await dispatch(intent)\n        setMessage(outcomeMessage(outcome))\n    }\n\n    return (\n        <fieldset aria-labelledby={legend} data-slot='diagnostics' className='settings-card'>\n            <legend id={legend} className='text-academy-ink px-1 text-[15px] font-semibold'>\n                Diagnostics\n            </legend>\n            {!view.available ? (\n                <p className='text-academy-ink-soft text-[13px]'>This build keeps no diagnostics.</p>\n            ) : (\n                <>\n                    <p className='text-academy-ink-soft max-w-prose text-[13px]'>\n                        Kept only on this device for {view.retentionDays} days and never sent anywhere: the kind of each\n                        request and why one was refused, storage and reset outcomes, and where the app stopped\n                        unexpectedly. Prompts, responses, keys, tokens and names are never kept.\n                    </p>\n                    <p className='text-academy-ink text-[13px]' data-slot='diagnostics-count'>\n                        {view.events} event{view.events === 1 ? '' : 's'} kept.\n                    </p>\n                    <div className='flex flex-wrap gap-2'>\n                        {/* aria-disabled, not disabled, while the save dialog is open: a\n                            disabled button drops keyboard focus, which would not come back to\n                            Export when the dialog closes. */}\n                        <Button type='button' tier='secondary' aria-disabled={busy} onClick={() => !busy && void run({ kind: 'exportDiagnostics' })}>\n                            Export diagnostics…\n                        </Button>\n                        <Button type='button' tier='tertiary' aria-disabled={busy} onClick={() => !busy && void run({ kind: 'clearDiagnostics' })}>\n                            Clear diagnostics\n                        </Button>\n                    </div>\n                    {view.export ? (\n                        <p role='status' aria-live='polite' className='text-academy-ink-soft text-[13px]'>\n                            {EXPORT_TEXT[view.export]}\n                        </p>\n                    ) : null}\n                    {view.clear === 'failed' ? (\n                        <p role='alert' data-slot='diagnostics-clear' className='text-academy-accent-warn text-[13px]'>\n                            {CLEAR_TEXT.failed}\n                        </p>\n                    ) : view.clear === 'cleared' ? (\n                        <p role='status' aria-live='polite' data-slot='diagnostics-clear' className='text-academy-ink-soft text-[13px]'>\n                            {CLEAR_TEXT.cleared}\n                        </p>\n                    ) : null}\n                </>\n            )}\n            {message ? (\n                <p role='alert' className='text-academy-accent-warn text-[13px]'>\n                    {message}\n                </p>\n            ) : null}\n            {children}\n        </fieldset>\n    )\n}\nimport type { SetupWarning, VerifyState } from '@prisma-airs/desktop-contracts'\nimport { READ_COPY } from './copy'\n\nconst CHECK_STATE: Record<VerifyState, string> = { pending: 'Checking', pass: 'Passed', warning: 'Warning', fail: 'Failed', stored: 'Stored', skipped: 'Skipped', unavailable: 'Unavailable' }\n\nfunction RecordedTime({ seconds }: { seconds: number }) {\n    const date = new Date(seconds * 1000)\n    return Number.isFinite(date.valueOf()) ? <time dateTime={date.toISOString()}>{date.toLocaleString()}</time> : <span>Time unavailable</span>\n}\n\n/** Native outcomes only: this presentation never infers resolution from a product read. */\nexport function SetupWarningResult({ warning, live = false }: { warning: SetupWarning; live?: boolean }) {\n    return <div className='flex flex-col text-[13px]' style={{ gap: 5, color: 'var(--v2-soft)' }} role={live ? 'status' : undefined} aria-live={live ? 'polite' : undefined} data-slot='setup-warning-result'>\n        <p>Originally recorded <RecordedTime seconds={warning.recordedSecs} />.</p>\n        {warning.recheck ? <>\n            <p>Latest check: {CHECK_STATE[warning.recheck.state]} · <RecordedTime seconds={warning.recheck.checkedSecs} />.</p>\n            <p>{warning.recheck.reason}</p>\n            {warning.recheck.state !== 'pending' && (warning.recheck.basis === 'unknown' || !warning.recheck.equivalent) ? <p>The original scope could not be matched. This result does not resolve the original warning.</p> : null}\n        </> : <p>No later setup recheck is recorded.</p>}\n        {warning.resolvedSecs !== undefined\n            ? <p data-state='resolved'>Resolved <RecordedTime seconds={warning.resolvedSecs} />.</p>\n            : <p data-state='active'>Warning active.</p>}\n    </div>\n}\n\n/** Tenant configuration history is separate from the redacted diagnostic event log/export. */\nexport function SetupWarningHistory({ warnings }: { warnings: SetupWarning[] }) {\n    if (warnings.length === 0) return null\n    return <section aria-label='Setup check history' className='flex flex-col' style={{ gap: 10, borderTop: '1px solid var(--v2-rule)', paddingTop: 12 }}>\n        <h3 className='text-[14px] font-semibold' style={{ color: 'var(--v2-ink)' }}>Setup check history</h3>\n        <p className='text-[13px]' style={{ color: 'var(--v2-soft)' }}>These tenant setup records are separate from the redacted diagnostic events above. Exporting or clearing diagnostic events does not export or clear this history.</p>\n        <ol className='flex flex-col' style={{ gap: 14 }}>\n            {[...warnings].sort((a, b) => b.recordedSecs - a.recordedSecs).map((warning) => <li key={warning.id} data-warning={warning.id} className='flex flex-col' style={{ gap: 5 }}>\n                <h4 className='text-[13px] font-semibold' style={{ color: 'var(--v2-ink)' }}>{READ_COPY.products[warning.product]}</h4>\n                <p className='text-[13px] whitespace-pre-wrap' style={{ color: 'var(--v2-soft)' }}>{warning.reason}</p>\n                <SetupWarningResult warning={warning} />\n            </li>)}\n        </ol>\n    </section>\n}\n        isRecord(value.receipt) &&\n        value.receipt.kind === 'admitted' &&\n        typeof value.receipt.request === 'string' &&\n        optional(isOperation, value.receipt.operation)\n    ) {\n        return {\n            outcome: 'receipt',\n            receipt: {\n                kind: 'admitted',\n                request: value.receipt.request,\n                operation: value.receipt.operation as string | null,\n            },\n        }\n    }\n    throw new ContractViolation('dispatch response')\n}\n\nexport function parseShellSnapshot(value: unknown): ShellSnapshot {\n    if (\n        !isRecord(value) ||\n        !isDecimalU64(value.revision) ||\n        !THEMES.includes(value.appearance as string) ||\n        !COLOR_THEMES.includes(value.colorTheme as string) ||\n        !ONBOARDING_STATES.includes(value.onboarding as string) ||\n        typeof value.activeFeature !== 'string' ||\n        !FEATURE_IDS.includes(value.activeFeature) ||\n        typeof value.showCalls !== 'boolean' ||\n        !isCalls(value.calls, value.showCalls) ||\n        !optional(\n            (g) =>\n                isRecord(g) &&\n                typeof g.context === 'string' &&\n                CONTEXT_REF.test(g.context) &&\n                isRecord(value.active) &&\n                g.context === value.active.context &&\n                typeof g.review === 'string' &&\n                REVIEW_ID.test(g.review) &&\n                typeof g.to === 'string' &&\n                TENANT_ID.test(g.to) &&\n                isRecord(g.pending) &&\n                typeof g.pending.conversation === 'string' &&\n                g.pending.conversation.length > 0 &&\n                typeof g.pending.decision === 'string' &&\n                g.pending.decision.length > 0 &&\n                typeof g.completion === 'boolean' &&\n                (g.completion\n/**\n * The production App over a scripted native transport, rendering the v2\n * shell (C28): the Rust catalogue drives the sidebar, every navigation is a\n * `navigate` intent, the palette and tenant switcher dispatch, preferences\n * dispatch, refusals reach the status surface as warn toasts, and the\n * accessibility invariants I8–I10 hold.\n */\nimport { act, render, screen, waitFor, within } from '@testing-library/react'\nimport userEvent from '@testing-library/user-event'\nimport { beforeEach, describe, expect, it } from 'vitest'\nimport { DesktopClient, type RuntimeOverview } from '@prisma-airs/desktop-contracts'\nimport { App } from '../app'\nimport { scriptedNative, tenant, type Native } from '../test/native'\nimport { fxHome, fxHomeDark, fxSwitcher } from './fixtures'\nimport { DeliveryOutcomeUnknown } from '@prisma-airs/desktop-contracts'\nimport { resetShellStore, useShellStore } from './store'\n\nasync function launch(snapshot = fxHome()): Promise<Native> {\n    const native = scriptedNative(snapshot)\n    render(<App client={new DesktopClient(native.transport)} />)\n    await screen.findByRole('navigation', { name: 'Destinations' })\n    return native\n}\n\nconst rail = () => within(screen.getByRole('navigation', { name: 'Destinations' }))\n/** The catalogue as a build without the Inbox would list it (an unavailable destination). */\nconst withUnavailableInbox = (snapshot: ReturnType<typeof fxHome>) => ({\n    ...snapshot,\n    features: snapshot.features.map((f) => (f.id === 'inbox' ? { ...f, availability: { state: 'unavailable' as const, reason: 'The Inbox arrives in C30', plannedChunk: 'C30' } } : f)),\n})\nconst intents = (native: Native) => native.dispatched.map((i) => i.kind)\n\nbeforeEach(() => {\n    resetShellStore()\n    document.documentElement.removeAttribute('data-theme')\n})\n\ndescribe('v2 shell', () => {\n    it.each(['prismaAirs', 'gruvbox'] as const)('keeps Settings Add outside inert shell ancestors in %s', async (colorTheme) => {\n        const user = userEvent.setup()\n        const native = await launch({ ...fxSwitcher(), activeFeature: 'settings', colorTheme })\n        await screen.findByRole('heading', { level: 1, name: 'Settings' })\n        const opener = screen.getByRole('button', { name: 'Add tenant…' })\n        await user.click(opener)\n        const dialog = document.querySelector<HTMLElement>('[data-slot=\"settings-add-tenant-sheet\"]')\n        expect(dialog).not.toBeNull()\n        expect(dialog).toHaveAttribute('aria-modal', 'true')\n        expect(dialog?.closest('[inert], [aria-hidden=\"true\"]')).toBeNull()\n        const host = dialog?.closest('[data-slot=\"desktop-modal-host\"]')\n        expect(host).toHaveAttribute('data-desktop-theme')\n        expect(host?.closest('[inert], [aria-hidden=\"true\"]')).toBeNull()\n        expect(host?.closest('[data-v2-shell]')).not.toBeNull()\n        expect(document.querySelector('[data-slot=\"app-main\"]')?.closest('[inert]')).not.toBeNull()\n        const visible = screen.getByRole('dialog', { name: 'Add a tenant' })\n        expect(within(visible).getByRole('heading', { name: 'Connect your tenant' })).toBeInTheDocument()\n        const field = within(visible).getByRole('textbox', { name: /Display name/ })\n        await user.type(field, 'Uncommitted local draft')\n        expect(field).toHaveValue('Uncommitted local draft')\n        await user.keyboard('{Escape}')\n        await waitFor(() => expect(screen.queryByRole('dialog')).toBeNull())\n        await waitFor(() => expect(opener).toHaveFocus())\n        expect(native.dispatched.filter((intent) => intent.kind !== 'navigate')).toEqual([])\n    })\n\n    it('renders the sidebar from the Rust catalogue with the menu shortcuts and marks an unavailable destination', async () => {\n        await launch(withUnavailableInbox(fxHome()))\n        const items = rail().getAllByRole('button').filter((b) => b.hasAttribute('data-inset-focus'))\n        expect(items.map((b) => b.textContent)).toEqual([\n            'Home⌘1',\n            'Inbox⌘2',\n            'Harness⌘3',\n            'Academy⌘4',\n            'Test Cases⌘5',\n            'API Client⌘6',\n            'Administration⌘7',\n        ])\n        expect(items[0]).toHaveAttribute('aria-current', 'page')\n        expect(items[1]).toHaveAttribute('aria-disabled', 'true')\n        expect(items[1]).toHaveAccessibleDescription('Not available: The Inbox arrives in C30')\n        expect(screen.getByRole('heading', { level: 1, name: 'Home' })).toBeInTheDocument()\n        expect(document.querySelector('[data-v2-shell]')).not.toBeNull()\n    })\n\n    it('dispatches navigate for the sidebar, the native menu and Home cards, never local state', async () => {\n        const user = userEvent.setup()\n        const native = await launch(withUnavailableInbox(fxHome()))\n        await user.click(rail().getByRole('button', { name: /Harness/ }))\n        expect(native.dispatched.at(-1)).toEqual({ kind: 'navigate', feature: 'harness' })\n        // The page changes only when the core reports it.\n        expect(screen.getByRole('heading', { level: 1, name: 'Home' })).toBeInTheDocument()\n        await native.push({ ...native.current, activeFeature: 'harness' })\n        expect(rail().getByRole('button', { name: /Harness/ })).toHaveAttribute('aria-current', 'page')\n        // An unavailable destination dispatches nothing.\n        await user.click(rail().getByRole('button', { name: /Inbox/ }))\n        expect(intents(native).filter((k) => k === 'navigate')).toHaveLength(1)\n        // A Home quick action is the same intent.\n        await native.push({ ...native.current, activeFeature: 'home' })\n        await user.click(within(screen.getByRole('main')).getByRole('button', { name: /Ask the Harness/ }))\n        expect(native.dispatched.at(-1)).toEqual({ kind: 'navigate', feature: 'harness' })\n    })\n\n    it('reports a refused navigation on the status surface as a warn toast', async () => {\n        const user = userEvent.setup()\n        const native = await launch()\n        native.respond = () => ({ outcome: 'refusal', refusal: 'invalidInput' })\n        await user.click(rail().getByRole('button', { name: /Academy/ }))\n        const toast = await screen.findByText('Navigation was refused (invalidInput).')\n        const surface = toast.closest('[data-slot=\"toast\"]')\n        expect(surface).toHaveAttribute('role', 'status')\n        expect(surface).toHaveAttribute('data-kind', 'warn')\n        expect(document.querySelectorAll('[data-slot=\"toast\"]')).toHaveLength(1)\n    })\n\n    it('opens the palette from the sidebar, lists destinations, tenants and actions, and dispatches on Enter', async () => {\n        const user = userEvent.setup()\n        const native = await launch(fxSwitcher())\n        await user.click(screen.getByRole('button', { name: /Search or go to…/ }))\n        const dialog = screen.getByRole('dialog', { name: 'Command palette' })\n        expect(dialog).toHaveAttribute('aria-modal', 'true')\n        const options = within(dialog).getAllByRole('option').map((o) => o.textContent)\n        expect(options.slice(0, 2)).toEqual(['Home⌘1', 'Inbox⌘2'])\n        expect(options).toContain('Switch to Meridian Retail · Production · TSG 1001464285')\n        expect(options).toContain('Read now')\n        // End and Home jump to the last and first entries.\n        await user.keyboard('{End}')\n        expect(within(dialog).getByRole('combobox')).toHaveAttribute('aria-activedescendant', expect.stringContaining('action:read'))\n        await user.keyboard('{Home}')\n        expect(within(dialog).getByRole('combobox')).toHaveAttribute('aria-activedescendant', expect.stringContaining('go:home'))\n        await user.type(within(dialog).getByRole('combobox'), 'meridian{Enter}')\n        expect(native.dispatched.at(-1)).toEqual({ kind: 'selectTenant', tenant: 'tn-fedcba9876543210', resolution: null })\n        expect(screen.queryByRole('dialog')).toBeNull()\n        await user.click(screen.getByRole('button', { name: /Search or go to…/ }))\n        await user.type(screen.getByRole('combobox'), 'read{Enter}')\n        expect(native.dispatched.at(-1)).toEqual({ kind: 'readTenant', context: 'cx-aaaaaaaaaaaaaaaaaaaaaaaa' })\n    })\n\n    it('switches tenants from the rail switcher with one selectTenant intent and lists Add a tenant', async () => {\n        const user = userEvent.setup()\n        const native = await launch(fxSwitcher())\n        const switcher = screen.getByRole('button', { name: /^Switch tenant/ })\n        expect(switcher).toHaveAccessibleName('Switch tenant: Northwind Health · Production · TSG 1762204418')\n        expect(switcher).toHaveTextContent('TSG 1762204418')\n        await user.click(switcher)\n        const list = screen.getByRole('group', { name: 'Switch tenant' })\n        expect(within(list).getAllByRole('button').map((o) => o.getAttribute('aria-label'))).toEqual([\n            'Northwind Health · Production · TSG 1762204418',\n            'Meridian Retail · Production · TSG 1001464285',\n        ])\n        expect(within(list).getAllByRole('button')[0]).toHaveAttribute('aria-pressed', 'true')\n        const menu = list.closest('[data-slot=\"tenant-menu\"]') as HTMLElement\n        expect(within(menu).getByRole('button', { name: 'Add a tenant…' })).toBeInTheDocument()\n        expect(within(menu).getByRole('button', { name: 'Tenant settings and credentials…' })).toBeInTheDocument()\n        await user.click(within(list).getByRole('button', { name: /Meridian Retail/ }))\n        expect(native.dispatched.at(-1)).toEqual({ kind: 'selectTenant', tenant: 'tn-fedcba9876543210', resolution: null })\n        expect(screen.queryByRole('group', { name: 'Switch tenant' })).toBeNull()\n    })\n\n    it('picks the nth tenant with ⌃n while the menu is open, as its hints say (C35)', async () => {\n        const user = userEvent.setup()\n        const native = await launch(fxSwitcher())\n        await user.click(screen.getByRole('button', { name: /^Switch tenant/ }))\n        const list = screen.getByRole('group', { name: 'Switch tenant' })\n        expect(within(list).getAllByRole('button').map((b) => b.textContent)).toEqual([expect.stringContaining('⌃1'), expect.stringContaining('⌃2')])\n        await user.keyboard('{Control>}2{/Control}')\n        expect(native.dispatched.at(-1)).toEqual({ kind: 'selectTenant', tenant: 'tn-fedcba9876543210', resolution: null })\n        expect(screen.queryByRole('group', { name: 'Switch tenant' })).toBeNull()\n        // ⌃1 on the current tenant closes the menu and sends nothing.\n        const before = native.dispatched.length\n        await user.click(screen.getByRole('button', { name: /^Switch tenant/ }))\n        await user.keyboard('{Control>}1{/Control}')\n","exit_code":0,"status":"completed"}}
