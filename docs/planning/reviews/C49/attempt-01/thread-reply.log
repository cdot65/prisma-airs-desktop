intln!(\"{}\", serde_json::to_string_pretty(&fp).unwrap_or_default());\n            Ok(())\n        }\n        \"handshake\" => {\n            args.only(&[])?;\n            let manifest = Manifest::load(&repo.manifest())?;\n            let env = Environment::prepare(&repo)?;\n            let codex = transport::Codex::resolve(&env, &manifest.reviewer, repo.root())?;\n            println!(\n                \"codex {} ({}) sha256 {}\",\n{\n  \"schema_version\": 1,\n  \"description\": \"Build-only toolchain selected for controller commands. Values beginning with $HOME expand against the preserved real HOME; {repo} expands to the checkout root.\",\n  \"path_dirs\": [\n    \"{repo}/.tools/bin\",\n    \"$HOME/.cargo/bin\",\n    \"$HOME/.nvm/versions/node/v24.21.0/bin\",\n    \"/usr/bin\",\n    \"/bin\",\n    \"/usr/sbin\",\n    \"/sbin\"\n  ],\n  \"tools\": [\n    {\n      \"name\": \"rustc\",\n      \"argv\": [\n        \"rustc\",\n        \"--version\"\n      ],\n      \"expect_prefix\": \"rustc 1.99.0 \"\n    },\n    {\n      \"name\": \"cargo\",\n      \"argv\": [\n        \"cargo\",\n        \"--version\"\n      ],\n      \"expect_prefix\": \"cargo 1.99.0 \"\n    },\n    {\n      \"name\": \"node\",\n      \"argv\": [\n        \"node\",\n        \"--version\"\n      ],\n      \"expect_prefix\": \"v24.21.0\"\n    },\n    {\n      \"name\": \"pnpm\",\n      \"argv\": [\n        \"pnpm\",\n        \"--version\"\n      ],\n      \"expect_prefix\": \"10.6.5\"\n    }\n  ],\n  \"declared_env\": {\n    \"RUSTUP_TOOLCHAIN\": \"1.99.0\",\n    \"CI\": \"1\",\n    \"SOURCEMAPS\": \"0\",\n    \"VITE_BASE_PATH\": \"/\",\n    \"VITE_API_PROXY_TARGET\": \"http://127.0.0.1:9\",\n    \"CARGO_TERM_COLOR\": \"never\",\n    \"NO_COLOR\": \"1\",\n    \"COREPACK_ENABLE_DOWNLOAD_PROMPT\": \"0\",\n    \"COREPACK_ENABLE_AUTO_PIN\": \"0\"\n  },\n  \"preserve_unchanged\": [\n    \"HOME\",\n    \"USER\",\n    \"LOGNAME\",\n    \"TMPDIR\",\n    \"LANG\",\n    \"LC_ALL\"\n  ],\n  \"reject_inherited