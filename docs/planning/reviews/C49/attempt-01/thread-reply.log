{"type":"item.completed","item":{"id":"item_32","type":"command_execution","command":"/bin/zsh -lc \"sed -n '1,140p' apps/desktop/src/v2/academy/academy.tsx && sed -n '120,190p' apps/desktop/src/app.tsx && rg -n '(secretRef|useLayoutEffect|cancelSetup|closeRequests|contextKey|draftKey|key=)' apps/desktop/src/v2/wizard/wizard.tsx\"","aggregated_output":"import { PageIntro } from '../page-intro'\nimport { createContext, forwardRef, lazy, Suspense, useCallback, useContext, useEffect, useImperativeHandle, useMemo, useRef, useState } from 'react'\nimport { useQuery, useQueryClient } from '@tanstack/react-query'\nimport { createMemoryHistory, createRootRoute, createRoute, createRouter, Link, Outlet, redirect, RouterProvider } from '@tanstack/react-router'\nimport {\n    AssessmentIntroPage,\n    AssessmentPage,\n    CertificatePage,\n    CompletionMoments,\n    CoursePage,\n    currentCourseSlug,\n    DossierPage,\n    HomePage,\n    IdentityPracticalPage,\n    LEARNER_ACCOUNT_NAV,\n    LEARNER_NAV,\n    LearnerAccountPage,\n    LearnPage,\n    MyCertificatePage,\n    NotificationsPage,\n    OnboardingPage,\n    OrientationPage,\n    PathLandingPage,\n    ProgramHubPage,\n    ShiftEntryPage,\n    ShopPage,\n    UnitPage,\n    useLearnerPageHeader,\n    WeeklyBoardPage,\n} from '@ai-security-academy/learner'\nimport type { DesktopClient, FeatureId, ShellSnapshot } from '@prisma-airs/desktop-contracts'\nimport { LearnerProvider, useLearnerTrpc } from '../../modules/academy/learner-provider'\nimport { DownloadsPage, OfflineNotice, OfflineWorkProvider } from '../../modules/academy/offline-work'\nimport { Btn } from '../controls'\nimport { Glyph, type GlyphName } from '../icons'\nimport { ACADEMY_COPY as C } from './copy'\n\nexport interface AcademyProps {\n    snapshot: ShellSnapshot\n    client: DesktopClient\n    onNavigate: (id: FeatureId) => void\n    /** The learner path to open (default `/learn`). */\n    initialPath?: string\n}\n\n// Fixture builds only; never loaded otherwise.\nconst LearnerCallProbe = lazy(() => import('../../modules/academy/learner-call-probe'))\n\nconst faint = { color: 'var(--v2-faint)' }\nconst soft = { color: 'var(--v2-soft)' }\nconst CARD = { background: 'var(--v2-paper)', border: '1px solid var(--v2-rule)', borderRadius: 12 }\n\n/** The Rust-owned appearance as the learner host's theme. */\nexport function themeFor(appearance: ShellSnapshot['appearance']): 'gruvbox' | 'paper' {\n    if (appearance === 'dark') return 'gruvbox'\n    if (appearance === 'light') return 'paper'\n    return typeof window !== 'undefined' && window.matchMedia?.('(prefers-color-scheme: dark)').matches ? 'gruvbox' : 'paper'\n}\n\n/** A learning path as Academy's catalog lists it (the fields the row draws). */\ninterface PathRow {\n    id: string\n    slug: string\n    title: string\n    /** The path's one-line summary, as `paths.list` names it. */\n    tagline: string\n    familyKey: string | null\n    unitCount: number\n    unitsDone: number\n    estMinutes: number | null\n    locked: boolean\n}\n\n/**\n * The learner's place (the right card's state lines), provided by `Academy`\n * from the snapshot and read by the router's root on every render, so the\n * card follows the snapshot while the router (memoised per generation)\n * stays mounted.\n */\nconst PlaceContext = createContext<React.ReactNode>(null)\n\n/**\n * The React Query key Academy's own `trpc.paths.list.useQuery()` uses\n * (tRPC react-query: the procedure path split, then `{ type: 'query' }`\n * with no input). Sharing it means one cache entry per generation: the\n * embed's prefetch fills it, and `utils.paths.list.invalidate()` after a\n * course reset or an enrollment change refetches this row too. The entry\n * holds the procedure's raw reply; the row reads it through `pathRows`.\n */\nexport const PATHS_LIST_KEY = [['paths', 'list'], { type: 'query' }] as const\n\n/** Academy's mutations that move a path's progress (tRPC mutation keys: the procedure path). */\nexport const PROGRESS_MUTATIONS: readonly (readonly string[])[] = [\n    ['units', 'complete'],\n    ['units', 'submitKnowledgeCheck'],\n    // A desktop lab's submission completes its unit when it passes (the hosted grade decides).\n    ['desktop', 'attempt', 'submit'],\n]\n\nfunction pathRows(rows: unknown): PathRow[] {\n    if (!Array.isArray(rows)) return []\n    return rows.flatMap((r) => {\n        if (!r || typeof r !== 'object') return []\n        const o = r as Record<string, unknown>\n        if (typeof o.id !== 'string' || typeof o.slug !== 'string' || typeof o.title !== 'string') return []\n        return [\n            {\n                id: o.id,\n                slug: o.slug,\n                title: o.title,\n                tagline: typeof o.tagline === 'string' ? o.tagline : '',\n                familyKey: typeof o.familyKey === 'string' ? o.familyKey : null,\n                unitCount: typeof o.unitCount === 'number' ? o.unitCount : 0,\n                unitsDone: typeof o.unitsDone === 'number' ? o.unitsDone : 0,\n                estMinutes: typeof o.estMinutes === 'number' ? o.estMinutes : null,\n                locked: o.locked === true,\n            },\n        ]\n    })\n}\n\nconst FAMILY_GLYPH: Record<string, GlyphName> = { 'prisma-airs': 'shield', runtime: 'shield', gateway: 'route', 'red-teaming': 'cross', models: 'box', skills: 'code' }\n\n/**\n * Builds the in-memory learner router (one per mounted generation), the\n * legacy destination's routes: reading routes serve guests too; account\n * routes ask a guest to sign in. The root draws the prototype's frame\n * around the page: the page on the left, the learner's place on the right,\n * the Learning paths row beneath.\n */\nfunction academyRouter(onNavigate: (id: FeatureId) => void, initialPath: string, signedIn: boolean) {\n    const root = createRootRoute({\n        component: () => {\n            const place = useContext(PlaceContext)\n            return (\n                <>\n                    <div className='grid min-w-0' style={{ gridTemplateColumns: 'minmax(0, 1.4fr) minmax(0, 1fr)', gap: 16 }} data-slot='academy-frame'>\n                        <section aria-label={C.pages} className='flex min-w-0 flex-col' style={{ ...CARD, padding: '20px 22px', gap: 10 }} data-slot='academy-pages'>\n                            <LearnerTrail />\n                            <LearnerStatus />\n            stop?.()\n        }\n    }, [client])\n\n    // A completed reset also forgets Academy's WebView presentation state\n    // (completion latches keyed by account); a stopped reset keeps it.\n    const storage = snapshot?.storage\n    const resetFailed = Boolean(snapshot?.resetFailure)\n    const previousStorage = useRef(storage)\n    useEffect(() => {\n        if (previousStorage.current === 'resetting' && storage !== 'resetting' && !resetFailed) {\n            forgetAcademyPresentation()\n        }\n        previousStorage.current = storage\n    }, [storage, resetFailed])\n\n    const appearance = snapshot?.appearance\n    const colorTheme = snapshot?.colorTheme\n    // Apply the theme in the same commit as the snapshot, before paint, so\n    // the shell never shows a frame in the previous theme.\n    useLayoutEffect(() => (appearance ? followAppearance(appearance, colorTheme) : undefined), [appearance, colorTheme])\n\n    if (failure && !snapshot) {\n        return (\n            <main role='alert' className='text-academy-ink p-8'>\n                {failure}\n            </main>\n        )\n    }\n    if (!snapshot) {\n        return (\n            <main role='status' aria-live='polite' className='text-academy-ink-soft p-8'>\n                Starting Prisma AIRS Desktop…\n            </main>\n        )\n    }\n    if (snapshot.onboarding !== 'done') {\n        // First run: the wizard owns the window (D060: no alpha import; nothing leaves it before a tenant exists).\n        return (\n            <div data-v2-shell=''>\n                <Wizard\n                    snapshot={snapshot}\n                    dispatch={dispatch}\n                    observeManagement={(operation) => client.observeManagement(operation)}\n                    mode='firstRun'\n                    onClose={() => undefined}\n                    onNavigate={(feature) => void v2Navigate(feature)}\n                />\n            </div>\n        )\n    }\n    return (\n        <V2Shell\n            snapshot={snapshot}\n            appearancePending={pending}\n            status={failure ?? status}\n            onNavigate={(feature) => void v2Navigate(feature)}\n            onSetAppearance={(theme) => void v2Preference('The appearance change', { kind: 'setAppearance', theme })}\n            onSetShowCalls={(on) => void v2Preference('The preference change', { kind: 'setShowCalls', on })}\n            onSwitchTenant={(tenant, resolution) => {\n                // The target is captured now: a late refusal still names it. A\n                // pending-decision refusal is not a toast: the snapshot carries\n                // the guard the shell renders (I1).\n                const label = snapshot.tenants.find((t) => t.id === tenant)?.label ?? tenant\n                void v2Preference(SHELL_COPY.switchTo(label), { kind: 'selectTenant', tenant, resolution: resolution ?? null }, ['decisionPending'])\n            }}\n            onReadNow={() => {\n                // The palette's Read now is the same finite read of every chosen product (I4).\n                const active = snapshot.active\n                if (!active) return\n                const label = snapshot.tenants.find((t) => t.id === active.tenant)?.label ?? active.tenant\n45:    closeRequests?: number\n148:    const secretRef = useRef<HTMLInputElement>(null)\n151:        const fields = [scanRef.current, secretRef.current, workspaceKeyRef.current]\n212:        const secretField = secretRef.current\n397:    const seenCloseRequests = useRef(props.closeRequests ?? 0)\n399:        if ((props.closeRequests ?? 0) > seenCloseRequests.current) {\n400:            seenCloseRequests.current = props.closeRequests ?? 0\n404:    }, [props.closeRequests])\n535:                            <li key={s}>\n591:                                        <li key={c.title} className='flex flex-col rounded-[12px] border' style={{ gap: 10, padding: '18px 20px', borderColor: 'var(--v2-rule)', background: 'var(--v2-paper)' }}>\n632:                                                        <label key={env} className='relative flex h-8 cursor-pointer items-center rounded-[6px] text-[12.5px] font-semibold' style={{ padding: '0 14px', background: on ? 'var(--v2-paper)' : 'transparent', boxShadow: on ? '0 1px 2px rgba(0,0,0,0.12)' : 'none', color: 'var(--v2-ink)' }} data-slot='environment-choice'>\n647:                                                    <option key={r.value} value={r.value}>\n680:                                                        <li key={t}>{t}</li>\n692:                                                <SecretField label={C.tenant.clientSecret} inputRef={secretRef} error={errors.clientSecret} />\n722:                                                                        <option key={w.id} value={w.id}>\n779:                                                key={card.label}\n853:                                            <li key={r.line} className='flex items-center' style={{ gap: 12, padding: '12px 18px', borderTop: i ? '1px solid var(--v2-rule)' : 0 }} data-slot={`verify-${r.line}`}>\n889:                                                    key={p.product}\n950:                                                    <li key={t}>{t}</li>\n983:                                        <div key={k} className='flex items-center' style={{ gap: 12, padding: '12px 18px', borderTop: i ? '1px solid var(--v2-rule)' : 0 }}>\n1002:                                        <div key={n.title} className='flex flex-col rounded-[12px] border' style={{ gap: 8, padding: '18px 20px', borderColor: 'var(--v2-rule)', background: 'var(--v2-paper)' }}>\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_33","type":"command_execution","command":"/bin/zsh -lc \"sed -n '1,275p' tools/p10/qualification.py && sed -n '1,130p' tools/p10/review_gate.py && cat docs/planning/evidence/P11/helper-qa-final-02/record.json\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_33","type":"command_execution","command":"/bin/zsh -lc \"sed -n '1,275p' tools/p10/qualification.py && sed -n '1,130p' tools/p10/review_gate.py && cat docs/planning/evidence/P11/helper-qa-final-02/record.json\"","aggregated_output":"\"\"\"Explicit C45/P10 evidence accounting. Does not execute checks or assign scores.\n\nThe existing runners produce raw records; this consumer rejects omitted coverage,\nchanged evidence, unsupported retirement and affected checks carried as unchanged.\nHistorical results always retain their original candidate and execution bindings.\n\"\"\"\nfrom pathlib import Path\nimport hashlib\nimport json\n\n\ndef require(value, message):\n    if not value:\n        raise ValueError(message)\n\n\ndef read(path):\n    return json.loads(Path(path).read_text())\n\n\ndef sha(path):\n    return hashlib.sha256(Path(path).read_bytes()).hexdigest()\n\n\ndef digest(value):\n    return hashlib.sha256((json.dumps(value, sort_keys=True, separators=(\",\", \":\")) + \"\\n\").encode()).hexdigest()\n\n\ndef bound(root, reference):\n    path = root / reference[\"path\"]\n    require(path.resolve().is_relative_to(root.resolve()), \"evidence escapes checkout\")\n    require(sha(path) == reference[\"sha256\"], \"evidence hash drift: \" + str(path))\n    return path\n\n\nEXACT_FIELDS = (\"executable_sha256\", \"bundle_sha256\", \"build_flags\", \"conditions\")\n\n\ndef verify_raw(root, needed, execution, origin):\n    require(execution[\"argv\"] == needed[\"argv\"], \"execution command differs from approved plan\")\n    require(execution[\"cwd\"] == origin[\"execution_root\"], \"execution cwd differs from original candidate\")\n    raw_path = bound(root, execution[\"raw\"])\n    raw = read(raw_path)\n    if needed[\"kind\"] == \"native\":\n        require(raw[\"schema\"] == \"airs-v2/native-acceptance/1\" and raw[\"app\"][\"executable_sha256\"] == origin[\"executable_sha256\"], \"raw native candidate mismatch\")\n        checks = [check for check in raw[\"checks\"] if check[\"id\"] == needed[\"id\"]]\n        require(len(checks) == 1 and checks[0][\"result\"] == \"pass\" and checks[0].get(\"observation\") and checks[0].get(\"evidence\"), \"raw native assertion not passing\")\n        for name in checks[0][\"evidence\"]:\n            require(name in execution[\"evidence\"], \"native evidence missing from execution inventory\")\n            bound(root, {\"path\":name,\"sha256\":execution[\"evidence\"][name]})\n    elif needed[\"kind\"] == \"command\":\n        require(raw[\"schema\"] == \"airs-v2/run/1\" and raw[\"status\"] == \"passed\" and raw[\"failure\"] is None and raw[\"inputs_before\"] == raw[\"inputs_after\"], \"raw runner failed or inputs changed\")\n        require(raw[\"inputs_before\"] == origin[\"runner_inputs\"], \"runner input fingerprint does not bind original candidate\")\n        commands = [command for command in raw[\"commands\"] if command[\"label\"] == needed[\"label\"]]\n        require(len(commands) == 1, \"raw runner command missing/duplicated\")\n        command = commands[0]\n        require(command[\"status\"] == \"passed\" and command[\"exit_code\"] == 0 and command[\"argv\"] == needed[\"argv\"] and command[\"cwd\"] in [\".\", origin[\"execution_root\"]] and not command[\"note\"], \"raw runner command failed/differs\")\n        require(command[\"output_sha256\"] == execution[\"log\"][\"sha256\"] and str((raw_path.parent/command[\"log\"]).relative_to(root)) == execution[\"log\"][\"path\"], \"raw runner log binding\")\n        if needed.get(\"expects_tests\"):\n            require(command[\"tests\"] and command[\"tests\"][\"passed\"] > 0 and command[\"tests\"][\"failed\"] == 0, \"test command did not execute passing tests\")\n    else:\n        raise ValueError(\"unsupported required raw execution kind\")\n\n\ndef verify(root, record, historical=None):\n    require(record[\"schema\"] == \"airs-desktop/qualified-coverage/1\", \"coverage schema\")\n    plan = read(bound(root, record[\"plan\"]))\n    require(plan[\"schema\"] == \"airs-desktop/required-coverage/1\", \"plan schema\")\n    requirements = plan[\"requirements\"]\n    ids = [item[\"id\"] for item in requirements]\n    require(len(ids) == len(set(ids)) and ids, \"duplicate/empty required coverage\")\n    rows = record[\"coverage\"]\n    require(len(rows) == len(ids) and {r[\"id\"] for r in rows} == set(ids), \"missing/duplicate/unknown coverage\")\n    by_id = {item[\"id\"]: item for item in requirements}\n    candidate = read(bound(root, record[\"candidate\"]))\n    require(all(candidate.get(k) for k in EXACT_FIELDS) and candidate.get(\"helper_closure\"), \"candidate binding incomplete\")\n    require(candidate.get(\"source_inventory_sha256\") == record[\"source_inventory_sha256\"], \"candidate source binding\")\n    for row in rows:\n        needed = by_id[row[\"id\"]]\n        mode = row[\"disposition\"]\n        require(mode in [\"executed\", \"reused_exact\", \"carried_unaffected\", \"not_applicable\"], \"unsupported coverage disposition\")\n        if mode == \"not_applicable\":\n            decision = needed.get(\"retirement\")\n            require(decision and row.get(\"reason\") and row.get(\"decision\") == decision, \"unapproved assertion retirement\")\n            bound(root, decision)\n            continue\n        original = read(bound(root, row[\"result\"]))\n        require(original.get(\"status\") == \"pass\" and original.get(\"exit_code\") == 0, \"result is not an actual passing execution\")\n        require(original.get(\"execution_id\") and original.get(\"argv\") and original.get(\"cwd\") and original.get(\"started_utc\") and original.get(\"finished_utc\"), \"execution provenance missing\")\n        require(row[\"id\"] in original.get(\"required_ids\", []), \"result does not cover required assertion\")\n        bound(root, original[\"log\"])\n        origin = read(bound(root, original[\"candidate\"]))\n        require(all(origin.get(k) for k in EXACT_FIELDS) and origin.get(\"helper_closure\"), \"original candidate binding incomplete\")\n        verify_raw(root, needed, original, origin)\n        if mode in [\"executed\", \"reused_exact\"]:\n            if mode == \"reused_exact\":\n                require(not needed.get(\"must_execute\", needed.get(\"affected\", True)), \"changed check must execute\")\n            helpers = needed.get(\"helper_paths\")\n            if helpers is None:\n                require(origin[\"helper_closure\"] == candidate[\"helper_closure\"], \"relevant helper closure differs\")\n            else:\n                require(all(name in origin[\"helper_closure\"] and name in candidate[\"helper_closure\"] and origin[\"helper_closure\"][name] == candidate[\"helper_closure\"][name] for name in helpers), \"relevant helper closure differs\")\n            require(all(origin[k] == candidate[k] for k in EXACT_FIELDS), \"artifact/helper/flags/conditions differ\")\n            if mode == \"executed\":\n                require(origin[\"source_inventory_sha256\"] == record[\"source_inventory_sha256\"], \"execution is historical, not current\")\n        else:\n            require(not needed.get(\"affected\", True), \"affected check cannot be carried unchanged\")\n            rationale = row.get(\"impact\")\n            require(rationale and rationale.get(\"reason\") and rationale.get(\"dependencies\") == needed.get(\"dependencies\") and rationale.get(\"original_candidate_sha256\") == original[\"candidate\"][\"sha256\"], \"unchanged-impact proof missing\")\n            proof = read(bound(root, rationale[\"proof\"]))\n            bindings = proof.get(\"file_bindings\", {})\n            require(set(bindings) == set(needed[\"dependencies\"]) and bindings, \"dependency membership proof missing\")\n            current_files=historical.source(record['source_inventory_sha256']) if historical else root\n            original_files=historical.source(origin['source_inventory_sha256']) if historical else root\n            for dependency, binding in bindings.items():\n                require(binding[\"original_sha256\"] == binding[\"current_sha256\"] == sha(current_files/dependency), \"dependency changed: \" + dependency)\n                original_source = original_files/dependency if historical else bound(root, binding[\"original_file\"])\n                require(sha(original_source) == binding[\"original_sha256\"], \"original dependency proof mismatch\")\n            require(proof.get(\"unchanged_dependencies\") == needed[\"dependencies\"] and proof.get(\"current_source_inventory_sha256\") == record[\"source_inventory_sha256\"] and proof.get(\"original_candidate_sha256\") == original[\"candidate\"][\"sha256\"], \"impact proof does not bind current and original inputs\")\n    return {\"qualified\": True, \"required\": len(ids), \"dispositions\": {m: sum(r[\"disposition\"] == m for r in rows) for m in sorted({r[\"disposition\"] for r in rows})}, \"candidate_sha256\": record[\"candidate\"][\"sha256\"], \"source_inventory_sha256\": record[\"source_inventory_sha256\"]}\n\"\"\"Read-only actual-review proof checks for C45/P10 and production prerequisites.\n\nNo score assignment, evidence execution, controller completion or release action.\n\"\"\"\nfrom pathlib import Path\nimport json\nimport sys\n\nsys.path.insert(0, str(Path(__file__).resolve().parent))\nsys.path.insert(0, str(Path(__file__).resolve().parents[1] / \"p09\"))\nfrom phase_packet import file_identity, digest, validate\nfrom phase_inputs import full_gate, require, read, sha, REVIEW_DISABLED\n\n\ndef transport(root, out, request):\n    invocation = read(out/\"invocation.json\")\n    require(invocation[\"request_sha256\"] == sha(out/\"request.json\"), \"transport request drift\")\n    schema_path = root/request.get(\"schema_archive\", \"docs/architecture/review-verdict.schema.json\")\n    require(invocation[\"schema_sha256\"] == sha(schema_path), \"transport schema drift\")\n    args = invocation[\"command_without_prompt\"]\n    require(args[0] == \"codex\" and args.count(\"exec\") == 1, \"not fresh Codex exec\")\n    for flag in [\"--no-daemon\", \"--ephemeral\", \"--ignore-user-config\", \"--ignore-rules\", \"--json\"]:\n        require(args.count(flag) == 1, \"transport isolation \" + flag)\n    for flag, value in [(\"-a\", \"never\"), (\"-s\", \"read-only\"), (\"-m\", \"gpt-6.1-sol\")]:\n        require(args.count(flag) == 1 and args[args.index(flag)+1] == value, \"transport isolation argument \" + flag)\n    require(args.count(\"--output-schema\") == 1 and args[args.index(\"--output-schema\")+1] == \"docs/architecture/review-verdict.schema.json\", \"transport output schema\")\n    expected_out = Path(request.get(\"execution_root\", root))/\"docs/planning/reviews\"/request[\"subject\"]/request[\"attempt_id\"]/\"verdict-returned.json\"\n    require(args.count(\"-o\") == 1 and args[args.index(\"-o\")+1] == str(expected_out), \"transport output path\")\n    require(invocation[\"model_requested\"] == \"gpt-6.1-sol\", \"configured review model changed\")\n    require(not any(\"dangerously\" in arg or arg in [\"resume\", \"fork\", \"--last\", \"--approve-for-me\"] for arg in args), \"review resume/bypass\")\n    disabled = [args[i+1] for i,a in enumerate(args) if a == \"--disable\"]\n    require(set(disabled) == REVIEW_DISABLED and len(disabled) == len(REVIEW_DISABLED), \"restricted review features\")\n    overrides = [args[i+1] for i,a in enumerate(args) if a == \"-c\"]\n    require(set(overrides) == {'web_search=\"disabled\"', 'model_reasoning_effort=\"xhigh\"'} and len(overrides) == 2, \"review overrides\")\n    require(invocation[\"feature_probe_sha256\"] == sha(out/\"feature-probe.log\"), \"feature probe drift\")\n    observed = {line.split()[0]:line.split()[-1] for line in (out/\"feature-probe.log\").read_text().splitlines() if len(line.split()) >= 3}\n    require(all(observed.get(k) == invocation[\"restricted_features_observed\"].get(k) == \"false\" for k in REVIEW_DISABLED), \"feature isolation not observed\")\n    messages=[];sessions=[]\n    for line in (out/\"thread-reply.log\").read_text().splitlines():\n        try:event=json.loads(line)\n        except json.JSONDecodeError:continue\n        if not isinstance(event,dict):continue\n        item=event.get(\"item\",{})\n        if not isinstance(item,dict):item={}\n        require(event.get(\"type\") not in [\"hook.started\",\"hook.completed\"] and item.get(\"type\") not in [\"mcp_tool_call\",\"hook_execution\"], \"unexpected review side effect\")\n        if event.get(\"type\") == \"thread.started\":sessions.append(event.get(\"thread_id\"))\n        if event.get(\"type\") == \"item.completed\" and item.get(\"type\") in [\"agent_message\",\"assistant_message\"]:messages.append(item.get(\"text\",\"\"))\n    require(len(sessions) == 1 and messages and json.loads(messages[-1]) == read(out/\"verdict-returned.json\"), \"actual independent returned verdict missing/mismatched\")\n    return dict(invocation_sha256=sha(out/\"invocation.json\"),thread_reply_sha256=sha(out/\"thread-reply.log\"),feature_probe_sha256=sha(out/\"feature-probe.log\"),reviewer_sessions_observed=sessions)\n\n\ndef actual_review(root, subject, attempt, source_root=None, evidence=True):\n    out=root/\"docs/planning/reviews\"/subject/attempt\n    request=read(out/\"request.json\"); verdict=read(out/\"verdict-returned.json\")\n    schema_path=(root/request[\"schema_archive\"] if request.get(\"schema_archive\")\n                 else (source_root or root)/\"docs/architecture/review-verdict.schema.json\")\n    # Historical P09 schema is preserved independently of future descriptions.\n    if subject == \"P09\":schema_path=root/\"docs/planning/evidence/C45/activation-20261102-g11/p09-source/docs/architecture/review-verdict.schema.json\"\n    validate(verdict,read(schema_path))\n    require(verdict[\"subject\"] == subject and request[\"subject\"] == subject and verdict[\"attempt_id\"] == request[\"attempt_id\"] == attempt and verdict[\"request_id\"] == request[\"request_id\"] and verdict[\"fingerprints\"] == request[\"fingerprints\"], \"actual verdict request/fingerprint binding\")\n    full_gate(verdict)\n    # Preserve request bytes: the archive path is verification context, never an edit.\n    transport_request=dict(request)\n    # A later schema description must not change an archived review's input.\n    # Supply verification context only; request/invocation bytes stay immutable.\n    if source_root is not None:\n        transport_request[\"schema_archive\"]=str(schema_path.relative_to(root))\n    if subject == \"P09\":\n        transport_request[\"schema_archive\"]=str(schema_path.relative_to(root))\n        transport_request[\"execution_root\"]=read(root/\"docs/planning/evidence/C45/activation-20261102-g11/p09-proof.json\")[\"source_checkout\"]\n    observed=transport(root,out,transport_request)\n    audit=read(out/\"post-review-audit.json\");receipt=read(out/\"receipt.json\")\n    require(audit[\"full_gate_pass\"] is True and receipt[\"full_gate_pass\"] is True and receipt[\"source_frozen\"] is True, \"actual full-gate audit missing\")\n    for record in [audit,receipt]:\n        require(record[\"request_sha256\"] == sha(out/\"request.json\") and record.get(\"raw_verdict_sha256\",record.get(\"verdict_sha256\")) == sha(out/\"verdict-returned.json\") and record[\"scores\"] == verdict[\"scores\"], \"review audit/receipt binding\")\n    require(receipt[\"post_review_audit_sha256\"] == sha(out/\"post-review-audit.json\") and receipt[\"fingerprints\"] == verdict[\"fingerprints\"], \"receipt audit/fingerprints\")\n    require(receipt[\"invocation_sha256\"] == observed[\"invocation_sha256\"] and receipt[\"thread_reply_sha256\"] == observed[\"thread_reply_sha256\"], \"receipt transport binding\")\n    for name,key,base in [(\"source-inventory.json\",\"source\",source_root or root),(\"evidence-inventory.json\",\"evidence\",root)]:\n        inventory=read(out/name)[\"files\"]\n        require(digest(inventory) == request[\"fingerprints\"][key], \"inventory fingerprint mismatch\")\n        if evidence or key == \"source\":\n            locations = read(root/\"docs/planning/evidence/C45/activation-20261102-g11/p09-extra-evidence/locations.json\") if subject == \"P09\" and key == \"evidence\" else {}\n            for relative,identity in inventory.items():\n                path = root/locations[relative] if relative in locations else base/relative\n                require(file_identity(path) == identity, \"reviewed input drift: \" + relative)\n    return dict(subject=subject,attempt=attempt,request_sha256=sha(out/\"request.json\"),verdict_sha256=sha(out/\"verdict-returned.json\"),audit_sha256=sha(out/\"post-review-audit.json\"),receipt_sha256=sha(out/\"receipt.json\"),scores=verdict[\"scores\"],fingerprints=verdict[\"fingerprints\"])\n\n\ndef release_prerequisites(root):\n    archive=root/\"docs/planning/evidence/C45/activation-20261102-g11/p09-source\"\n    p09=actual_review(root,\"P09\",\"attempt-02\",archive)\n    standing=read(root/\"docs/planning/evidence/P10/completion-proof.json\")\n    require(standing[\"schema\"] == \"airs-desktop/p10-completion-proof/1\" and standing[\"p09\"] == p09,\"P09 prerequisite binding\")\n    # P10's exact reviewed source is archived on completion. Later C26 release\n    # implementation gets its own checks/review; it does not relabel P10 inputs.\n    archived=root/standing[\"source_archive\"]\n    require(archived.resolve().is_relative_to((root/\"docs/planning/evidence/P10\").resolve()),\"P10 archive escapes evidence\")\n    p10=actual_review(root,\"P10\",standing[\"attempt\"],archived)\n    require(standing[\"p10\"] == p10,\"P10 completion proof binding\")\n    c45=actual_review(root,\"C45\",standing[\"c45\"][\"attempt\"],root/standing[\"c45_source_archive\"])\n    require(standing[\"c45\"] == c45,\"C45 member proof binding\")\n    from packet import qualification\n    from historical import Historical\n    historical=Historical(root,standing[\"historical_context\"])\n    qualified=qualification(root,root/standing[\"qualification\"][\"record\"],current=False,historical=historical)\n    request=read(root/\"docs/planning/reviews/P10\"/standing[\"attempt\"]/\"request.json\")\n    require(qualified == standing[\"qualification\"] == request[\"qualification\"] and request[\"predecessors\"][\"C45\"] == c45,\"P10 qualified candidate/member binding\")\n    return {\"p09\":p09,\"p10\":p10,\"c45\":c45,\"controller_complete\":False,\"c26_required_here\":False}\n\n\nif __name__ == \"__main__\":\n    require(len(sys.argv) == 2 and sys.argv[1] == \"release-prerequisites\", \"usage: review_gate.py release-prerequisites\")\n    print(json.dumps(release_prerequisites(Path.cwd().resolve()),indent=2))\n{\n  \"schema\": \"airs-desktop/p11-helper-qa/1\",\n  \"argv\": [\n    \"/Library/Developer/CommandLineTools/usr/bin/python3\",\n    \"docs/planning/evidence/P11/helper-qa-final-02/run.py\"\n  ],\n  \"cwd\": \"/Users/cdot/development/redtail/p09-queue/refinement-20261104/core\",\n  \"started_utc\": \"2026-11-04T17:11:20.862867+00:00\",\n  \"finished_utc\": \"2026-11-04T17:11:24.082200+00:00\",\n  \"exit_code\": 0,\n  \"tests\": {\n    \"passed\": 75,\n    \"failed\": 0\n  },\n  \"skipped\": 0,\n  \"log\": {\n    \"path\": \"docs/planning/evidence/P11/helper-qa-final-02/qa.log\",\n    \"sha256\": \"b12cf4692c507a3c875a7302e8efd34b3d3016633f07f6dceedf04b107816af3\"\n  },\n  \"helper_files\": {\n    \"tools/native-acceptance/acceptance_p11_api.py\": \"bcf93c6c13ecfa04e877eebc51bf30424c806688ef4c3aff04129a4e830eebb8\",\n    \"tools/native-acceptance/acceptance_p11_continue.py\": \"a324be5c74d8db6c3ed25f951caf43f19fce67e905c49dc542a1ad54bbef50e8\",\n    \"tools/native-acceptance/acceptance_p11_credentials.py\": \"1053bed0372457aa439c6105341f15fc8df729412fea83b8c10e7f907eb3f520\",\n    \"tools/native-acceptance/acceptance_p11_finish.py\": \"e758719d74f157f9b12f4bda2355d4bd2098ddd613231d5749fd8ea