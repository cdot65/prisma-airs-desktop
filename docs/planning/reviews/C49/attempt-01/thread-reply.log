{"type":"item.completed","item":{"id":"item_17","type":"command_execution","command":"/bin/zsh -lc \"sed -n '1,200p' apps/desktop/src/styles/tokens.css && sed -n '400,580p' apps/desktop/src/styles/tokens.css && cat apps/desktop/src/shell/palette-contrast.test.ts apps/desktop/src/shell/academy-theme-boundary.test.ts\"","aggregated_output":"/*\n * Desktop tokens: independent palette family and light/dark appearance.\n * Light/dark mode and the selected family paint --v2-* tokens. Root\n * data-theme keeps Academy's existing general palette. Shared controls\n * receive desktop aliases only inside explicit data-desktop-theme scopes.\n */\n:root {\n    --v2-color-scheme: light;\n    --v2-bg: #f5f6f8;\n    --v2-side: #eef0f3;\n    --v2-paper: #ffffff;\n    --v2-inset: #e9edf2;\n    --v2-rule: #d4d9e1;\n    --v2-ctl: #7b8494;\n    --v2-ink: #17212f;\n    --v2-soft: #435166;\n    --v2-faint: #5c687b;\n    --v2-acc: #b83b16;\n    --v2-acc-ink: #ffffff;\n    --v2-acc-soft: #fce6de;\n    --v2-block: #b42318;\n    --v2-block-bg: #fbe4e1;\n    --v2-flag: #815200;\n    --v2-flag-bg: #fff0c9;\n    --v2-ok: #1a6b40;\n    --v2-ok-bg: #def3e6;\n    --v2-sel: var(--v2-acc);\n    --v2-sel-ink: var(--v2-acc-ink);\n    --v2-get: #245e8f;\n\n    --v2-page-top: 32px;\n    --v2-page-x: 44px;\n    --v2-title: 26px;\n    --v2-card-pad: 20px;\n    /* Grid and card gaps (the prototype's 16–20px; 12px is only inside rows). */\n    --v2-gap: 16px;\n    --v2-gap-row: 12px;\n    /* The prototype's base text is 13px; 14px is the subtitle size. */\n    --v2-text: 13px;\n    --v2-text-1: 14px;\n    --v2-text-2: 12px;\n    --v2-h2: 13px;\n    --v2-control: 32px;\n    --v2-radius-control: 7px;\n    --v2-radius-card: 12px;\n    --v2-rail: 244px;\n    --v2-header: 56px;\n    --v2-reading: 860px;\n    /* Overlay widths (R2App): tenant menu, palette, review sheet, detail sheet, dialogs. */\n    --v2-menu: 360px;\n    --v2-palette: 640px;\n    --v2-sheet: 620px;\n    --v2-detail: 520px;\n    --v2-dialog: 560px;\n    --v2-scrim: rgba(0, 0, 0, 0.22);\n    --v2-scrim-deep: rgba(0, 0, 0, 0.34);\n}\n\n:root[data-appearance='dark'] {\n    --v2-color-scheme: dark;\n    --v2-bg: #151b25;\n    --v2-side: #101620;\n    --v2-paper: #1e2734;\n    --v2-inset: #263243;\n    --v2-rule: #37465b;\n    --v2-ctl: #8190a5;\n    --v2-ink: #f0f3f8;\n    --v2-soft: #c7d0dd;\n    --v2-faint: #aab8cb;\n    --v2-acc: #ff9a70;\n    --v2-acc-ink: #26190f;\n    --v2-acc-soft: #4b2e25;\n    --v2-block: #ff9b94;\n    --v2-block-bg: #492a31;\n    --v2-flag: #f7c567;\n    --v2-flag-bg: #40351e;\n    --v2-ok: #8ddbb1;\n    --v2-ok-bg: #1a3d32;\n    --v2-get: #8cc8ff;\n}\n\n:root[data-color-theme='gruvbox'][data-appearance='light'] {\n    --v2-color-scheme: light;\n    --v2-bg: #fbf1c7;\n    --v2-side: #f2e5bc;\n    --v2-paper: #fff8df;\n    --v2-inset: #ebdbb2;\n    --v2-rule: #d5c4a1;\n    --v2-ctl: #85745b;\n    --v2-ink: #282828;\n    --v2-soft: #504945;\n    --v2-faint: #665c54;\n    --v2-acc: #a3390c;\n    --v2-acc-ink: #ffffff;\n    --v2-acc-soft: #f5d7ac;\n    --v2-block: #9d201b;\n    --v2-block-bg: #f8d7c3;\n    --v2-flag: #785500;\n    --v2-flag-bg: #f5e4a9;\n    --v2-ok: #426421;\n    --v2-ok-bg: #e3ebbb;\n    --v2-get: #076678;\n}\n\n:root[data-color-theme='gruvbox'][data-appearance='dark'] {\n    --v2-color-scheme: dark;\n    --v2-bg: #1d2021;\n    --v2-side: #161919;\n    --v2-paper: #282828;\n    --v2-inset: #32302f;\n    --v2-rule: #3c3836;\n    --v2-ctl: #8a7f70;\n    --v2-ink: #ebdbb2;\n    --v2-soft: #d5c4a1;\n    --v2-faint: #bdae93;\n    --v2-acc: #fe8019;\n    --v2-acc-ink: #1d2021;\n    --v2-acc-soft: #4a2f1a;\n    --v2-block: #ff6b57;\n    --v2-block-bg: #3d1f1c;\n    --v2-flag: #fabd2f;\n    --v2-flag-bg: #3a3019;\n    --v2-ok: #b8bb26;\n    --v2-ok-bg: #2b2f17;\n    --v2-get: #83a598;\n}\n\n/* The v2 shell root: body background, type and the visible focus ring\n * (invariant: accent-colour ring on every focusable control; inset variant\n * where a control declares it). */\n[data-v2-shell] {\n    background: var(--v2-bg);\n    color: var(--v2-ink);\n    font-size: var(--v2-text);\n    font-family: -apple-system, BlinkMacSystemFont, 'SF Pro Text', system-ui, sans-serif;\n    min-height: 100vh;\n}\n/* The destination heading takes focus after navigation for assistive technology; it is not a control, so no ring (C35). */\n[data-v2-shell] h1[tabindex='-1']:focus {\n    outline: none;\n}\n/* A page inside the shell's main region: the prototype's 32/44 margins, scrolling by itself. */\n[data-v2-shell] [data-v2-page] {\n    padding: var(--v2-page-top) var(--v2-page-x) 28px;\n    overflow-y: auto;\n    min-height: 0;\n    flex-grow: 1;\n    min-width: 0;\n}\n/* Shell ancestry includes Academy; desktop control styling needs ownership. */\n[data-desktop-theme] :focus-visible {\n    outline: 2px solid var(--v2-acc);\n    outline-offset: 2px;\n}\n[data-desktop-theme] [data-inset-focus]:focus-visible {\n    outline-offset: -4px;\n}\n[data-desktop-theme] input,\n[data-desktop-theme] select,\n[data-desktop-theme] textarea {\n    border: 1px solid var(--v2-ctl);\n    border-radius: var(--v2-radius-control);\n    background: var(--v2-bg);\n    color: var(--v2-ink);\n    min-height: var(--v2-control);\n}\n/* Rail collapses to icons below 1280 CSS px; nothing scrolls horizontally. */\n[data-v2-shell] {\n    overflow-x: hidden;\n}\n@media (max-width: 1279px) {\n    [data-v2-rail] {\n        width: 64px !important;\n    }\n    /* Collapsed: one 32px control per row; icons stay, labels leave the\n     * layout but stay in the accessible name. */\n    [data-v2-rail] [data-v2-stack] {\n        flex-direction: column;\n        align-items: stretch;\n    }\n    [data-v2-rail] [data-v2-stack] > * {\n        width: 100%;\n    }\n    /* Collapsed: labels leave the layout but stay in the accessible name (rail and header). */\n    [data-v2-rail] [data-v2-label],\n    [data-v2-header] [data-v2-label] {\n        position: absolute;\n        width: 1px;\n        height: 1px;\n        overflow: hidden;\n        clip: rect(0 0 0 0);\n        white-space: nowrap;\n    }\n    /* Collapsed: the product children and the status rows leave the rail (C35). */\n    [data-v2-rail] [data-v2-collapse] {\n        display: none !important;\n    }\n    [data-v2-rail] [data-v2-stack] > * {\n        padding-left: 0 !important;\n        padding-right: 0 !important;\n    [data-v2-shell] [data-slot='inbox-list'] {\n        min-height: 240px;\n        max-height: 50vh;\n    }\n}\n/* C39a attempt-01 R1: below the width that fits the inventory's columns (900×600 at 200% is 450 CSS px) the rows stack their cells. */\n@media (max-width: 760px) {\n    [data-v2-shell] [data-slot='administration-row'] {\n        grid-template-columns: minmax(0, 1fr) !important;\n        gap: 4px !important;\n    }\n    /* The header row leaves the picture but not the accessibility tree; each stacked cell shows its column's\n       name (C39b attempt-01 R4). */\n    [data-v2-shell] [data-slot='administration-table'] > [role='row']:first-child {\n        position: absolute;\n        width: 1px;\n        height: 1px;\n        overflow: hidden;\n        clip: rect(0 0 0 0);\n        white-space: nowrap;\n    }\n    [data-v2-shell] [data-slot='administration-row'] > [role='cell'][data-label]::before {\n        content: attr(data-label) ': ';\n        font-weight: 600;\n        color: var(--v2-faint);\n    }\n    [data-v2-shell] [data-slot='administration-row'] > [role='cell']:last-child {\n        justify-content: flex-start;\n    }\n}\n/* C39b attempt-01: below the width that fits a table's columns (900×600 at 200% is 450 CSS px) the v2 admin tables stack their cells and hide the header row. */\n@media (max-width: 760px) {\n    [data-v2-shell] [data-slot='admin-tab'] [role='table'] > [role='row'] {\n        grid-template-columns: minmax(0, 1fr) !important;\n        gap: 4px !important;\n    }\n    [data-v2-shell] [data-slot='admin-tab'] [role='table'] > [role='row']:first-child {\n        display: none;\n    }\n    [data-v2-shell] [data-slot='admin-tab'] [role='table'] [role='cell'] {\n        white-space: normal;\n    }\n}\n/* Narrower still (a 900-point window at 200%): the request tree sits above the editor instead of beside it. */\n@media (max-width: 760px) {\n    [data-v2-shell] [data-slot='api-body'] {\n        flex-wrap: wrap;\n    }\n    [data-v2-shell] [data-slot='request-tree'] {\n        width: 100% !important;\n        max-height: 40vh;\n        border-right: 0 !important;\n        border-bottom: 1px solid var(--v2-rule);\n    }\n}\n/* Test Cases (C40): below 760px (a 900-point window at 200%) each row is two lines: the case and its product, the\n   input, then the result and the action; the five-column grid cannot hold readable cells there. */\n@media (max-width: 760px) {\n    [data-v2-shell] [data-slot='cases-table'] [role='row'] {\n        grid-template-columns: minmax(0, 1fr) auto !important;\n        row-gap: 8px !important;\n    }\n    [data-v2-shell] [data-slot='cases-table'] [role='row'] > :nth-child(3) {\n        grid-column: 1 / -1;\n    }\n}\n/* The wizard's Environment segmented control (C43): native radios inside labels; the segment shows the ring. */\n[data-slot='environment-choice']:has(> input:focus-visible) {\n    outline: 2px solid var(--v2-acc);\n    outline-offset: 1px;\n}\n\n/* Shared controls follow the desktop palette only in explicitly owned scopes.\n * Academy and its body portals retain the general root palette. */\n[data-desktop-theme] {\n    color-scheme: var(--v2-color-scheme);\n    --academy-bg: var(--v2-bg);\n    --academy-bg-rail: var(--v2-side);\n    --academy-bg-inset: var(--v2-inset);\n    --academy-paper: var(--v2-paper);\n    --academy-paper-deep: var(--v2-inset);\n    --academy-ink: var(--v2-ink);\n    --academy-ink-soft: var(--v2-soft);\n    --academy-ink-faint: var(--v2-faint);\n    --academy-rule: var(--v2-rule);\n    --academy-rule-strong: var(--v2-ctl);\n    --academy-track: var(--v2-rule);\n    --academy-accent: var(--v2-acc);\n    --academy-accent-ink: var(--v2-acc-ink);\n    --academy-accent-soft: var(--v2-acc-soft);\n    --academy-accent-ring: var(--v2-acc);\n    --academy-focus-ring: var(--v2-acc);\n    --academy-accent-warn: var(--v2-block);\n    --academy-saved-dot: var(--v2-ok);\n    --academy-info: var(--v2-get);\n    --academy-active-chip: var(--v2-inset);\n}\n\n.settings-grid {\n    display: grid;\n    grid-template-columns: repeat(auto-fit, minmax(min(100%, 23rem), 1fr));\n    gap: 16px;\n    align-items: start;\n}\n.settings-card {\n    min-width: 0;\n    display: flex;\n    flex-direction: column;\n    gap: 12px;\n    padding: 16px;\n    border: 1px solid var(--v2-rule);\n    border-radius: var(--v2-radius-card);\n    background: var(--v2-paper);\n    color: var(--v2-ink);\n    font-size: 13px;\n}\n.settings-card > legend, .settings-card > h3 {\n    padding: 0 4px;\n    font-size: 14px;\n    font-weight: 600;\n}\n.settings-description { color: var(--v2-soft); font-size: 12px; }\n.settings-fields {\n    display: grid;\n    grid-template-columns: repeat(auto-fit, minmax(min(100%, 12rem), 1fr));\n    gap: 12px;\n}\n.settings-field { display: flex; min-width: 0; flex-direction: column; gap: 5px; font-size: 12px; font-weight: 500; }\n.settings-card :is(input:not([type='radio']):not([type='checkbox']), select) {\n    width: 100%; min-width: 0; min-height: 32px; padding: 5px 9px; font-size: 13px;\n}\n.settings-card :is(button, [type='radio'], [type='checkbox']) { flex-shrink: 0; }\n.settings-card button { min-height: 32px; height: auto; padding-top: 5px; padding-bottom: 5px; }\nimport { describe, expect, it } from 'vitest'\nimport tokens from '../styles/tokens.css?raw'\n\nfunction declarations(selector: string): Record<string, string> {\n    const start = tokens.indexOf(`${selector} {`)\n    if (start < 0) throw new Error(`Missing palette: ${selector}`)\n    const body = tokens.slice(start, tokens.indexOf('}', start))\n    return Object.fromEntries([...body.matchAll(/--v2-([\\w-]+): (#[\\da-f]{6});/g)].map((m) => [m[1]!, m[2]!]))\n}\n\nconst luminance = (hex: string) => {\n    const values = [1, 3, 5].map((at) => parseInt(hex.slice(at, at + 2), 16) / 255).map((c) => c <= 0.04045 ? c / 12.92 : ((c + 0.055) / 1.055) ** 2.4)\n    return values[0]! * 0.2126 + values[1]! * 0.7152 + values[2]! * 0.0722\n}\nconst contrast = (a: string, b: string) => {\n    const [low, high] = [luminance(a), luminance(b)].sort((x, y) => x - y)\n    return (high! + 0.05) / (low! + 0.05)\n}\n\ndescribe.each(['prismaAirs', 'gruvbox'])('%s palette contrast', (family) => {\n    it.each(['light', 'dark'])('%s retains readable text and visible controls', (appearance) => {\n        const palette = {\n            ...declarations(':root'),\n            ...(appearance === 'dark' ? declarations(\":root[data-appearance='dark']\") : {}),\n            ...(family === 'gruvbox' ? declarations(`:root[data-color-theme='gruvbox'][data-appearance='${appearance}']`) : {}),\n        }\n        for (const surface of ['bg', 'paper', 'inset']) {\n            for (const ink of ['ink', 'soft', 'faint']) expect(contrast(palette[ink]!, palette[surface]!), `${ink} on ${surface}`).toBeGreaterThanOrEqual(4.5)\n            for (const control of ['ctl', 'acc']) expect(contrast(palette[control]!, palette[surface]!), `${control} on ${surface}`).toBeGreaterThanOrEqual(3)\n        }\n        expect(contrast(palette['acc-ink']!, palette.acc!)).toBeGreaterThanOrEqual(4.5)\n        for (const status of ['block', 'flag', 'ok']) expect(contrast(palette[status]!, palette[`${status}-bg`]!)).toBeGreaterThanOrEqual(4.5)\n    })\n})\nimport { afterEach, beforeEach, describe, expect, it } from 'vitest'\nimport tokens from '../styles/tokens.css?raw'\n\n// Inspect the real stylesheet's selector participation. jsdom cannot resolve\n// inherited CSS variables or qualify native computed colors and focus pixels.\nlet stylesheet: HTMLStyleElement\nlet fixture: HTMLDivElement\nlet rules: CSSStyleRule[]\n\nbeforeEach(() => {\n    stylesheet = document.createElement('style')\n    stylesheet.textContent = tokens\n    document.head.append(stylesheet)\n    rules = [...stylesheet.sheet!.cssRules].filter((rule): rule is CSSStyleRule => rule.type === CSSRule.STYLE_RULE)\n    fixture = document.createElement('div')\n    fixture.innerHTML = `\n        <div data-v2-shell>\n            <header data-desktop-theme><button id=\"header\">Explain</button></header>\n            <nav data-desktop-theme><button id=\"rail\" data-inset-focus aria-current=\"page\">Settings</button></nav>\n            <main data-desktop-theme><section class=\"settings-card\">\n                <input id=\"desktop-input\"><select id=\"desktop-select\"><option>Light</option></select>\n                <textarea id=\"desktop-textarea\"></textarea><button id=\"desktop-button\">Save</button>\n            </section></main>\n            <main><section data-slot=\"academy-pages\">\n                <input id=\"academy-input\"><select id=\"academy-select\"><option>General theme</option></select>\n                <textarea id=\"academy-textarea\"></textarea><button id=\"academy-button\">Continue</button>\n            </section></main>\n        </div>\n        <div data-v2-scrim data-desktop-theme><div role=\"dialog\"><input id=\"dialog-input\"><button id=\"dialog-button\">Apply</button></div></div>\n        <div data-slot=\"wizard\" data-desktop-theme><input id=\"wizard-input\"><button id=\"wizard-button\">Continue</button></div>\n        <div data-academy-portal><input id=\"academy-portal-input\"><button id=\"academy-portal-button\">Close</button></div>`\n    document.body.append(fixture)\n})\n\nafterEach(() => {\n    stylesheet.remove()\n    fixture.remove()\n})\n\nfunction desktopRulesFor(id: string, properties: string[]): string[] {\n    const control = fixture.querySelector<HTMLElement>(`#${id}`)!\n    control.focus()\n    return rules.filter((rule) => properties.some((property) => rule.style.getPropertyValue(property).includes('var(--v2-')) && control.matches(rule.selectorText)).map((rule) => rule.selectorText)\n}\n\ndescribe('desktop CSS ownership at the Academy boundary', () => {\n    it.each(['academy-input', 'academy-select', 'academy-textarea', 'academy-portal-input'])('leaves %s form colors to Academy', (id) => {\n        expect(desktopRulesFor(id, ['background', 'color', 'border'])).toEqual([])\n    })\n\n    it.each(['academy-input', 'academy-select', 'academy-textarea', 'academy-button', 'academy-portal-button'])('leaves %s focus treatment to Academy', (id) => {\n        expect(desktopRulesFor(id, ['outline', 'outline-color'])).toEqual([])\n    })\n\n    it.each(['desktop-input', 'desktop-select', 'desktop-textarea', 'dialog-input', 'wizard-input'])('keeps desktop form colors on %s', (id) => {\n        expect(desktopRulesFor(id, ['background', 'color', 'border']).length).toBeGreaterThan(0)\n    })\n\n    it.each(['header', 'rail', 'desktop-button', 'dialog-button', 'wizard-button'])('keeps desktop focus treatment on %s', (id) => {\n        expect(desktopRulesFor(id, ['outline']).length).toBeGreaterThan(0)\n        if (id === 'rail') expect(desktopRulesFor(id, ['outline-color']).length).toBeGreaterThan(0)\n    })\n})\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_16","type":"command_execution","command":"/bin/zsh -lc 'cat apps/desktop/src/shell/feature-view.tsx && cat apps/desktop/src/modules/tenants/credential-entry.tsx && cat apps/desktop/src/modules/tenants/management-credential.tsx'","aggregated_output":"import { forwardRef, useId, useState } from 'react'\nimport { Callout } from '@ai-security-academy/presentation'\nimport { Info } from 'lucide-react'\nimport type { FeatureEntry, ShellSnapshot, Theme } from '@prisma-airs/desktop-contracts'\nimport { type Dispatch, outcomeMessage } from '../modules/tenants/dispatch'\nimport { DiagnosticsPanel } from '../modules/diagnostics/diagnostics-panel'\nimport { AcademyAccount } from '../modules/academy/academy-account'\nimport { TenantsSettings } from '../modules/tenants/tenants-settings'\nimport type { ObserveManagement } from '../modules/administration/management-read'\nimport { PageIntro } from '../v2/page-intro'\nimport { SetupWarningHistory } from '../v2/setup-warning-history'\n\ninterface HeadingProps {\n    id: string\n    kicker: string\n    title: string\n}\n\n/** Page heading that receives focus after navigation (tabIndex -1). */\nexport const PageHeading = forwardRef<HTMLHeadingElement, HeadingProps>(function PageHeading({ id, title }, ref) {\n    return (\n        <header className='mb-4 flex flex-col gap-1' data-slot='page-header'>\n            <h1 ref={ref} id={id} tabIndex={-1} data-slot='page-heading' className='font-bold outline-none' style={{ fontSize: 'var(--v2-title)' }}>\n                {title}\n            </h1>\n        </header>\n    )\n})\n\nexport const UnavailableView = forwardRef<HTMLHeadingElement, { feature: FeatureEntry }>(function UnavailableView({ feature }) {\n    const planned = feature.availability.state === 'unavailable' ? feature.availability.plannedChunk : ''\n    return (\n        <section aria-label={feature.label} data-slot='feature-unavailable'>\n            <Callout tone='default' icon={Info}>\n                <p>\n                    {feature.label} is not available in this build. Nothing here contacts a Prisma AIRS\n                    tenant or the Academy.\n                </p>\n                <p className='text-academy-ink-faint mt-2 font-mono text-[11px] tracking-[0.12em] uppercase'>\n                    Planned in {planned}\n                </p>\n            </Callout>\n        </section>\n    )\n})\n\ninterface SettingsProps {\n    snapshot: ShellSnapshot\n    pending: boolean\n    onSetAppearance: (theme: Theme) => void\n    dispatch: Dispatch\n    observeManagement: ObserveManagement\n}\n\nexport const SettingsView = forwardRef<HTMLHeadingElement, SettingsProps>(function SettingsView(\n    { snapshot, pending, onSetAppearance, dispatch, observeManagement }\n) {\n    const legend = useId()\n    const [themeBusy, setThemeBusy] = useState(false)\n    const [message, setMessage] = useState<string | null>(null)\n    async function setColorTheme(theme: ShellSnapshot['colorTheme']) {\n        setThemeBusy(true)\n        setMessage(null)\n        const outcome = await dispatch({ kind: 'setColorTheme', theme })\n        setThemeBusy(false)\n        setMessage(outcomeMessage(outcome))\n    }\n    return (\n        <section aria-label='Settings' data-slot='settings' className='flex flex-col gap-4'>\n            <PageIntro description='Personalize the desktop, manage tenant connections and review local diagnostics.' />\n            <div className='settings-grid'>\n                <fieldset aria-labelledby={legend} aria-busy={pending || themeBusy} className='settings-card'>\n                    <legend id={legend}>Appearance</legend>\n                    <p className='settings-description'>Desktop preferences do not change your Academy account settings.</p>\n                    <div className='settings-fields'>\n                        <label className='settings-field'>\n                            Appearance\n                            <select aria-label='Appearance' value={snapshot.appearance} disabled={pending} onChange={(e) => onSetAppearance(e.target.value as Theme)}>\n                                <option value='system'>Match system</option>\n                                <option value='light'>Light</option>\n                                <option value='dark'>Dark</option>\n                            </select>\n                        </label>\n                        <label className='settings-field'>\n                            Theme\n                            <select aria-label='Theme' value={snapshot.colorTheme} disabled={themeBusy} onChange={(e) => void setColorTheme(e.target.value as ShellSnapshot['colorTheme'])}>\n                                <option value='prismaAirs'>Prisma AIRS</option>\n                                <option value='gruvbox'>Gruvbox</option>\n                            </select>\n                        </label>\n                    </div>\n                    {message && <p role='alert'>{message}</p>}\n                </fieldset>\n                <AcademyAccount view={snapshot.academy} dispatch={dispatch} />\n                <DiagnosticsPanel view={snapshot.diagnostics} dispatch={dispatch}>\n                    <SetupWarningHistory warnings={snapshot.tenants.find((t) => t.id === snapshot.active?.tenant)?.setupWarnings ?? []} />\n                </DiagnosticsPanel>\n            </div>\n            <TenantsSettings snapshot={snapshot} dispatch={dispatch} observeManagement={observeManagement} />\n        </section>\n    )\n})\nimport { type FormEvent, useId, useRef, useState } from 'react'\nimport { Button, Callout, Input } from '@ai-security-academy/presentation'\nimport { AlertTriangle, CheckCircle2, Info } from 'lucide-react'\nimport type { ContextRef, StorageMode, TenantView, VaultError } from '@prisma-airs/desktop-contracts'\nimport { type Dispatch, outcomeMessage } from './dispatch'\n\nconst FAILURE_TEXT: Record<VaultError, string> = {\n    locked: 'Secure storage is locked. Unlock it and enter the key again, or keep it for this session only.',\n    denied: 'The system did not allow access to secure storage. Enter the key again, or keep it for this session only.',\n    unavailable: 'The credential store is not available. Enter the key again, or keep it for this session only.',\n    notFound: 'The stored key is missing. Enter it again.',\n    corrupt: 'The stored key could not be read. Enter it again.',\n}\n\nfunction scanStatus(tenant: TenantView): { tone: 'default' | 'success' | 'danger'; text: string } {\n    const { state, mode, failure } = tenant.scan\n    switch (state) {\n        case 'missing':\n            return { tone: 'default', text: 'No scan key. Enter this tenant’s AIRS API key to enable scans.' }\n        case 'storing':\n            return { tone: 'default', text: 'Saving the scan key…' }\n        case 'ready':\n            return {\n                tone: 'success',\n                text: mode === 'session' ? 'Scan key held for this session only.' : 'Scan key saved in secure storage.',\n            }\n        case 'failed':\n            return { tone: 'danger', text: failure ? FAILURE_TEXT[failure] : 'The scan key could not be saved.' }\n    }\n}\n\ninterface Props {\n    tenant: TenantView\n    context: ContextRef\n    dispatch: Dispatch\n}\n\n/**\n * Scan-key entry for the active tenant. The key is read from the field at\n * the moment of submission and the field is cleared before the request is\n * awaited; it is never held in React state, storage or any snapshot. (A\n * JavaScript string cannot be reliably zeroized; the native side keeps it.)\n */\nexport function ScanKeyForm({ tenant, context, dispatch }: Props) {\n    const [mode, setMode] = useState<StorageMode>('keychain')\n    const [message, setMessage] = useState<string | null>(null)\n    const [busy, setBusy] = useState(false)\n    const keyRef = useRef<HTMLInputElement>(null)\n    const keyId = useId()\n    const hintId = useId()\n    const modeLegend = useId()\n    const status = scanStatus(tenant)\n    const hasKey = tenant.scan.state === 'ready' || tenant.scan.state === 'failed'\n\n    async function submit(event: FormEvent<HTMLFormElement>) {\n        event.preventDefault()\n        const field = keyRef.current\n        if (!field) return\n        const key = field.value\n        field.value = ''\n        if (key.length === 0) {\n            setMessage('Enter the scan key.')\n            field.focus()\n            return\n        }\n        setBusy(true)\n        setMessage(null)\n        const outcome = await dispatch({ kind: 'configureScanCredential', context, mode, key })\n        setBusy(false)\n        setMessage(outcomeMessage(outcome))\n    }\n\n    async function remove() {\n        setBusy(true)\n        setMessage(null)\n        const outcome = await dispatch({ kind: 'removeScanCredential', context })\n        setBusy(false)\n        setMessage(outcomeMessage(outcome))\n    }\n\n    return (\n        <section aria-labelledby={`${keyId}-heading`} data-slot='scan-key' className='settings-card'>\n            <h3 id={`${keyId}-heading`} className='text-academy-ink text-[14px] font-semibold'>\n                Scan key\n            </h3>\n            <Callout\n                tone={status.tone}\n                icon={status.tone === 'success' ? CheckCircle2 : status.tone === 'danger' ? AlertTriangle : Info}\n                role='status'\n                aria-live='polite'\n                data-slot='scan-status'\n            >\n                {status.text}\n            </Callout>\n            <form onSubmit={(e) => void submit(e)} className='flex flex-col gap-3' aria-busy={busy}>\n                <label htmlFor={keyId} className='text-academy-ink text-[13px] font-medium'>\n                    AIRS API key\n                </label>\n                <Input\n                    ref={keyRef}\n                    id={keyId}\n                    name='scan-key'\n                    type='password'\n                    autoComplete='off'\n                    autoCapitalize='off'\n                    autoCorrect='off'\n                    spellCheck={false}\n                    aria-describedby={hintId}\n                    data-slot='scan-key-input'\n                />\n                <p id={hintId} className='text-academy-ink-faint text-[12px]'>\n                    Sent only to {tenant.origin}. Entering a new key replaces the current one.\n                </p>\n                <fieldset aria-labelledby={modeLegend} className='flex flex-col gap-1'>\n                    <legend id={modeLegend} className='text-academy-ink text-[13px] font-medium'>\n                        Keep the key\n                    </legend>\n                    {(\n                        [\n                            ['keychain', 'In secure storage', 'Available after restarting the desktop'],\n                            ['session', 'For this session only', 'Forgotten when the desktop quits'],\n                        ] as const\n                    ).map(([value, label, hint]) => (\n                        <label key={value} className='flex min-h-8 cursor-pointer items-center gap-3'>\n                            <input\n                                type='radio'\n                                name='scan-key-mode'\n                                value={value}\n                                checked={mode === value}\n                                onChange={() => setMode(value)}\n                                className='size-4 accent-[var(--academy-accent)]'\n                            />\n                            <span className='flex flex-col'>\n                                <span className='text-academy-ink text-[13px]'>{label}</span>\n                                <span className='text-academy-ink-faint text-[12px]'>{hint}</span>\n                            </span>\n                        </label>\n                    ))}\n                </fieldset>\n                <div className='flex flex-wrap gap-2'>\n                    <Button type='submit' tier='primary' disabled={busy}>\n                        {hasKey ? 'Replace key' : 'Save key'}\n                    </Button>\n                    {hasKey ? (\n                        <Button type='button' tier='secondary' disabled={busy} onClick={() => void remove()}>\n                            Remove scan key\n                        </Button>\n                    ) : null}\n                </div>\n                {message ? (\n                    <p role='alert' data-slot='scan-key-message' className='text-academy-accent-warn text-[13px]'>\n                        {message}\n                    </p>\n                ) : null}\n            </form>\n        </section>\n    )\n}\nimport { type FormEvent, useId, useRef, useState } from 'react'\nimport { Button, Callout, Input } from '@ai-security-academy/presentation'\nimport { AlertTriangle, CheckCircle2, Info } from 'lucide-react'\nimport type { ContextRef, StorageMode, TenantView, VaultError } from '@prisma-airs/desktop-contracts'\nimport { MANAGEMENT_FAILURE_TEXT, type ObserveManagement, readManagement } from '../administration/management-read'\nimport { type Dispatch, outcomeMessage } from './dispatch'\n\nconst FAILURE_TEXT: Record<VaultError, string> = {\n    locked: 'Secure storage is locked. Unlock it and enter the secret again, or keep it for this session only.',\n    denied: 'The system did not allow access to secure storage. Enter the secret again, or keep it for this session only.',\n    unavailable: 'The credential store is not available. Enter the secret again, or keep it for this session only.',\n    notFound: 'The stored client secret is missing. Enter it again.',\n    corrupt: 'The stored client secret could not be read. Enter it again.',\n}\n\nfunction status(tenant: TenantView): { tone: 'default' | 'success' | 'danger'; text: string } {\n    const { state, mode, failure } = tenant.management\n    switch (state) {\n        case 'missing':\n            return {\n                tone: 'default',\n                text: 'No management client. Scans do not need one; add one to read this tenant’s inventories in Administration.',\n            }\n        case 'storing':\n            return { tone: 'default', text: 'Saving the management client…' }\n        case 'ready':\n            return {\n                tone: 'success',\n                text:\n                    mode === 'session'\n                        ? 'Management client secret held for this session only.'\n                        : 'Management client secret saved in secure storage.',\n            }\n        case 'failed':\n            return { tone: 'danger', text: failure ? FAILURE_TEXT[failure] : 'The management client could not be saved.' }\n    }\n}\n\ninterface Props {\n    tenant: TenantView\n    context: ContextRef\n    dispatch: Dispatch\n    observe: ObserveManagement\n}\n\n/**\n * The tenant's separate management OAuth client (C08). It never replaces or\n * reads the scan key. The secret is read from its field at submission and\n * the field is cleared before the request is awaited; it is never held in\n * React state, storage or any snapshot. Verify authenticates the stored OAuth client without reading product inventories.\n */\nexport function ManagementCredentialForm({ tenant, context, dispatch, observe }: Props) {\n    const [mode, setMode] = useState<StorageMode>('keychain')\n    const [message, setMessage] = useState<string | null>(null)\n    const [verified, setVerified] = useState<string | null>(null)\n    const [busy, setBusy] = useState(false)\n    const secretRef = useRef<HTMLInputElement>(null)\n    const clientRef = useRef<HTMLInputElement>(null)\n    const ids = useId()\n    const shown = status(tenant)\n    const view = tenant.management\n    const hasClient = view.state === 'ready' || view.state === 'failed'\n    const noTsg = tenant.tsgId === null\n\n    async function submit(event: FormEvent<HTMLFormElement>) {\n        event.preventDefault()\n        const secretField = secretRef.current\n        const clientField = clientRef.current\n        if (!secretField || !clientField) return\n        const secret = secretField.value\n        secretField.value = ''\n        const clientId = clientField.value.trim()\n        setVerified(null)\n        if (clientId.length === 0) {\n            setMessage('Enter the client ID.')\n            clientField.focus()\n            return\n        }\n        if (secret.length === 0) {\n            setMessage('Enter the client secret.')\n            secretField.focus()\n            return\n        }\n        setBusy(true)\n        setMessage(null)\n        const outcome = await dispatch({ kind: 'configureManagementCredential', context, mode, clientId, secret })\n        setBusy(false)\n        setMessage(outcomeMessage(outcome))\n    }\n\n    async function verify() {\n        setBusy(true)\n        setMessage(null)\n        setVerified(null)\n        const outcome = await readManagement(dispatch, observe, context, { kind: 'verify' })\n        setBusy(false)\n        if (outcome.kind === 'notAdmitted') setMessage(outcome.message)\n        else if (outcome.result.kind === 'verified') setVerified('Management OAuth authentication succeeded.')\n        else if (outcome.result.kind === 'failed') setMessage(MANAGEMENT_FAILURE_TEXT[outcome.result.failure])\n        else setMessage('The service returned a reply the desktop could not use.')\n    }\n\n    async function remove() {\n        setBusy(true)\n        setMessage(null)\n        setVerified(null)\n        const outcome = await dispatch({ kind: 'removeManagementCredential', context })\n        setBusy(false)\n        setMessage(outcomeMessage(outcome))\n    }\n\n    return (\n        <section aria-labelledby={`${ids}-heading`} data-slot='management-credential' className='settings-card'>\n            <h3 id={`${ids}-heading`} className='text-academy-ink text-[14px] font-semibold'>\n                Management client\n            </h3>\n            <Callout\n                tone={shown.tone}\n                icon={shown.tone === 'success' ? CheckCircle2 : shown.tone === 'danger' ? AlertTriangle : Info}\n                role='status'\n                aria-live='polite'\n                data-slot='management-status'\n            >\n                {shown.text}\n                {view.clientId ? (\n                    <span className='text-academy-ink-soft mt-1 block text-[12px]' data-slot='management-client-id'>\n                        Client ID: {view.clientId}\n                    </span>\n                ) : null}\n            </Callout>\n            {noTsg ? (\n                <Callout tone='warning' icon={AlertTriangle} data-slot='management-no-tsg'>\n                    This tenant has no TSG ID. Add a replacement tenant with its TSG ID to configure a management client.\n                </Callout>\n            ) : null}\n            <p className='text-academy-ink-faint text-[12px]' data-slot='management-sso-pointer'>\n                Company sign-in (SSO) for the Harness is set up per Gateway workspace, in Harness.\n            </p>\n            <form onSubmit={(e) => void submit(e)} className='flex flex-col gap-3' aria-busy={busy}>\n                <label htmlFor={`${ids}-client`} className='text-academy-ink text-[13px] font-medium'>\n                    Client ID\n                </label>\n                <Input\n                    ref={clientRef}\n                    id={`${ids}-client`}\n                    name='management-client-id'\n                    autoComplete='off'\n                    autoCapitalize='off'\n                    autoCorrect='off'\n                    spellCheck={false}\n                    defaultValue={view.clientId ?? ''}\n                    maxLength={1024}\n                    data-slot='management-client-input'\n                />\n                <label htmlFor={`${ids}-secret`} className='text-academy-ink text-[13px] font-medium'>\n                    Client secret\n                </label>\n                <Input\n                    ref={secretRef}\n                    id={`${ids}-secret`}\n                    name='management-secret'\n                    type='password'\n                    autoComplete='off'\n                    autoCapitalize='off'\n                    autoCorrect='off'\n                    spellCheck={false}\n                    aria-describedby={`${ids}-hint`}\n                    data-slot='management-secret-input'\n                />\n                <p id={`${ids}-hint`} className='text-academy-ink-faint text-[12px]'>\n                    The secret is sent only to {view.tokenOrigin ?? 'the Palo Alto Networks token service'} to obtain\n                    short-lived access tokens. It is separate from the scan key.\n                </p>\n                <fieldset aria-labelledby={`${ids}-mode`} className='flex flex-col gap-1'>\n                    <legend id={`${ids}-mode`} className='text-academy-ink text-[13px] font-medium'>\n                        Keep the secret\n                    </legend>\n                    {(\n                        [\n                            ['keychain', 'In secure storage', 'Available after restarting the desktop'],\n                            ['session', 'For this session only', 'Forgotten when the desktop quits'],\n                        ] as const\n                    ).map(([value, label, hint]) => (\n                        <label key={value} className='flex min-h-8 cursor-pointer items-center gap-3'>\n                            <input\n                                type='radio'\n                                name='management-mode'\n                                value={value}\n                                checked={mode === value}\n                                onChange={() => setMode(value)}\n                                className='size-4 accent-[var(--academy-accent)]'\n                            />\n                            <span className='flex flex-col'>\n                                <span className='text-academy-ink text-[13px]'>{label}</span>\n                                <span className='text-academy-ink-faint text-[12px]'>{hint}</span>\n                            </span>\n                        </label>\n                    ))}\n                </fieldset>\n                <div className='flex flex-wrap gap-2'>\n                    <Button type='submit' tier='primary' disabled={busy || noTsg}>\n                        {hasClient ? 'Replace client' : 'Save client'}\n                    </Button>\n                    {view.state === 'ready' ? (\n                        <Button type='button' tier='secondary' disabled={busy} onClick={() => void verify()}>\n                            Verify\n                        </Button>\n                    ) : null}\n                    {hasClient ? (\n                        <Button type='button' tier='secondary' disabled={busy} onClick={() => void remove()}>\n                            Remove management client\n                        </Button>\n                    ) : null}\n                </div>\n                {verified ? (\n                    <p role='status' data-slot='management-verified' className='text-academy-ink text-[13px]'>\n                        {verified}\n                    </p>\n                ) : null}\n                {message ? (\n                    <p role='alert' data-slot='management-message' className='text-academy-accent-warn text-[13px]'>\n                        {message}\n                    </p>\n                ) : null}\n            </form>\n        </section>\n    )\n}\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_18","type":"command_execution","command":"/bin/zsh -lc 'cat apps/desktop/src/v2/modal.tsx && cat apps/desktop/src/v2/settings/management-credential.test.tsx && cat apps/desktop/src/modules/tenants/credential-entry.test.tsx'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.started","item":{"id":"item_19","type":"command_execution","command":"/bin/zsh -lc \"sed -n '135,200p' crates/desktop-core/src/store.rs && sed -n '700,790p' crates/desktop-core/src/store.rs && sed -n '1,65p' crates/desktop-core/src/wire.rs && cat apps/desktop/src/modules/academy/academy-account.tsx\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_18","type":"command_execution","command":"/bin/zsh -lc 'cat apps/desktop/src/v2/modal.tsx && cat apps/desktop/src/v2/settings/management-credential.test.tsx && cat apps/desktop/src/modules/tenants/credential-entry.test.tsx'","aggregated_output":"import { createContext, useContext, useEffect, useId, useLayoutEffect, useRef, useState, type KeyboardEvent, type ReactNode } from 'react'\nimport { createPortal } from 'react-dom'\nimport { useShellStore } from './store'\n\n// Undefined preserves standalone use; null means the shell host is mounting.\nconst DesktopModalHostContext = createContext<HTMLElement | null | undefined>(undefined)\n\n/** Desktop-owned dialogs stay inside the shell palette, outside its inert page. */\nexport function DesktopModalHost({ children }: { children: ReactNode }) {\n    const [host, setHost] = useState<HTMLDivElement | null>(null)\n    return (\n        <DesktopModalHostContext.Provider value={host}>\n            {children}\n            <div ref={setHost} data-slot='desktop-modal-host' data-desktop-theme='' className='contents' />\n        </DesktopModalHostContext.Provider>\n    )\n}\n\ninterface ModalProps {\n    label: string\n    onClose: () => void\n    children: ReactNode\n    /** Width in CSS px (default 560). */\n    width?: number\n    /** Inner padding in CSS px (default 20); 0 for a dialog that lays itself out edge to edge. */\n    padding?: number\n    /** Distance from the top of the window in CSS px (default 4vh); the prototype's palette sits at 90. */\n    top?: number\n    /** Corner radius in CSS px (default 12; the palette's frame is 14). */\n    radius?: number\n    /** A sheet docked to the window's right edge under the header (R2App's review sheet, 620px wide, full height). */\n    sheet?: boolean\n    /**\n     * The control focus returns to on close when the opener itself will be gone\n     * by then (a menu item that closes with its menu as the dialog opens): an\n     * explicit surviving target instead of whatever had focus at mount.\n     */\n    returnFocus?: HTMLElement | null\n    'data-slot'?: string\n}\n\nconst FOCUSABLE = 'a[href], button:not([disabled]), input:not([disabled]), select:not([disabled]), textarea:not([disabled]), [tabindex]:not([tabindex=\"-1\"])'\n\n/**\n * One topmost modal (I8): dialogs register on a shell-wide stack; only the\n * last is interactive. Lower dialogs are inert and aria-hidden, Tab and\n * Shift-Tab stay inside the topmost dialog, Escape closes the topmost only,\n * focus moves into the dialog on open and back to the opener on close. The\n * page behind every dialog is made inert by the shell (`useModalsOpen`).\n * The dialog element handles its own keys; the topmost dialog also listens\n * on the window for Escape alone, for when focus has left it (a native\n * sheet returned focus elsewhere), and closes only itself.\n */\nexport function Modal({ label, onClose, children, width = 560, padding = 20, top, radius = 12, sheet = false, returnFocus = null, ...rest }: ModalProps) {\n    const host = useContext(DesktopModalHostContext)\n    const id = useId()\n    const pushModal = useShellStore((s) => s.pushModal)\n    const popModal = useShellStore((s) => s.popModal)\n    const modals = useShellStore((s) => s.modals)\n    const topmost = modals.length > 0 && modals[modals.length - 1] === id\n    const dialog = useRef<HTMLDivElement>(null)\n    const opener = useRef<HTMLElement | null>(null)\n    const returnRef = useRef(returnFocus)\n    returnRef.current = returnFocus\n    const focusedOnce = useRef(false)\n\n    // Capture before a child wizard's passive heading-focus effect runs.\n    useLayoutEffect(() => {\n        opener.current = document.activeElement instanceof HTMLElement ? document.activeElement : null\n        pushModal(id)\n        return () => {\n            popModal(id)\n            // After the commit: the page behind is still inert during cleanup,\n            // and an inert ancestor refuses focus (observed in WebKit).\n            const target = returnRef.current ?? opener.current\n            queueMicrotask(() => {\n                // Only when nothing else took focus meanwhile (⌘T replacing the\n                // palette hands focus to the tenant list, which must keep it).\n                const active = document.activeElement\n                if (active && active !== document.body) return\n                // The opener may be gone (a \"Finish rotation…\" that completed):\n                // focus the page heading rather than leave it on nothing.\n                if (target?.isConnected) target.focus()\n                else document.querySelector<HTMLElement>('[data-slot=\"page-heading\"], main h1[tabindex=\"-1\"]')?.focus()\n            })\n        }\n    }, [id, pushModal, popModal])\n\n    useEffect(() => {\n        // Initial focus goes into the dialog once, when it opens. Regaining the\n        // top after a higher dialog closes must not refocus: that dialog is\n        // restoring its own opener, which may be any control here.\n        if (!topmost || focusedOnce.current) return\n        const node = dialog.current\n        if (!node) return\n        focusedOnce.current = true\n        if (!node.contains(document.activeElement)) {\n            // A declared initial control first (wherever it sits), else the first focusable.\n            const first = node.querySelector<HTMLElement>('[autofocus]') ?? node.querySelector<HTMLElement>(FOCUSABLE)\n            ;(first ?? node).focus()\n        }\n    }, [topmost, host])\n\n    // Escape still closes the topmost dialog when focus has left it (a\n    // native sheet returning focus to the page body, a click on the scrim's\n    // edge): the dialog's own handler stops the event first when it has focus.\n    const closeRef = useRef(onClose)\n    closeRef.current = onClose\n    useEffect(() => {\n        if (!topmost) return\n        const onWindowKey = (event: globalThis.KeyboardEvent) => {\n            if (event.key !== 'Escape' || event.defaultPrevented) return\n            const node = dialog.current\n            if (node && node.contains(document.activeElement)) return\n            event.preventDefault()\n            closeRef.current()\n        }\n        window.addEventListener('keydown', onWindowKey)\n        return () => window.removeEventListener('keydown', onWindowKey)\n    }, [topmost])\n\n    const onKeyDown = (event: KeyboardEvent<HTMLDivElement>) => {\n        if (!topmost) return\n        if (event.key === 'Escape') {\n            event.preventDefault()\n            event.stopPropagation()\n            onClose()\n            return\n        }\n        if (event.key === 'Tab') {\n            // Keyboard interaction stays inside the topmost dialog.\n            const node = dialog.current\n            if (!node) return\n            const items = Array.from(node.querySelectorAll<HTMLElement>(FOCUSABLE)).filter((el) => !el.hasAttribute('hidden') && el.getAttribute('aria-hidden') !== 'true')\n            if (items.length === 0) {\n                event.preventDefault()\n                node.focus()\n                return\n            }\n            const first = items[0] as HTMLElement\n            const last = items[items.length - 1] as HTMLElement\n            const active = document.activeElement\n            if (event.shiftKey && (active === first || active === node)) {\n                event.preventDefault()\n                last.focus()\n            } else if (!event.shiftKey && active === last) {\n                event.preventDefault()\n                first.focus()\n            }\n        }\n    }\n\n    const content = (\n        <div\n            className={sheet ? 'fixed z-50 flex justify-end' : 'fixed inset-0 z-50 grid place-items-start justify-center'}\n            style={sheet ? { inset: 'var(--v2-header, 56px) 0 0 0' } : { paddingTop: top ?? '4vh' }}\n            data-v2-scrim=''\n            data-desktop-theme=''\n            aria-hidden={topmost ? undefined : true}\n            inert={topmost ? undefined : true}\n            onMouseDown={() => topmost && onClose()}\n        >\n            <div\n                ref={dialog}\n                role='dialog'\n                aria-modal={topmost ? 'true' : undefined}\n                aria-label={label}\n                tabIndex={-1}\n                data-slot={rest['data-slot'] ?? 'modal'}\n                data-topmost={topmost ? 'true' : 'false'}\n                onKeyDown={onKeyDown}\n                onMouseDown={(e) => e.stopPropagation()}\n                className='border'\n                // Bounded to the viewport: a tall dialog scrolls inside itself, so its\n                // actions stay reachable at the minimum window size and 200% zoom.\n                style={\n                    sheet\n                        ? { width: `min(${width}px, 100vw)`, height: '100%', overflowY: 'auto', padding, borderRadius: 0, borderLeft: '1px solid var(--v2-rule)', boxShadow: '-18px 0 40px rgba(0,0,0,0.18)', background: 'var(--v2-bg)', borderWidth: 0, color: 'var(--v2-ink)' }\n                        : { width: `min(${width}px, 92vw)`, maxHeight: '92vh', overflowY: 'auto', padding, borderRadius: radius, boxShadow: '0 24px 60px rgba(0,0,0,0.3)', background: 'var(--v2-paper)', borderColor: 'var(--v2-rule)', color: 'var(--v2-ink)' }\n                }\n            >\n                {children}\n            </div>\n        </div>\n    )\n    return host === undefined ? content : host ? createPortal(content, host) : null\n}\n\n/** Whether any modal is open: the shell makes the page behind it inert. */\nexport function useModalsOpen(): boolean {\n    return useShellStore((s) => s.modals.length > 0)\n}\n/**\n * Production management-client onboarding through the real App, DesktopClient\n * and the one presentation (C44): Settings is reached as the v2 shell reaches\n * it, and the same assertions as the C08 suite hold: a separate credential\n * from the scan key, the secret captured at submission and cleared before\n * awaiting, verification as one management read, TSG requirement and removal.\n * The legacy suite stays as the owner's uncommitted file; this one runs.\n */\nimport { render, screen, within } from '@testing-library/react'\nimport userEvent from '@testing-library/user-event'\nimport { afterEach, beforeEach, describe, expect, it, vi } from 'vitest'\nimport { DesktopClient, type TenantView } from '@prisma-airs/desktop-contracts'\nimport { App } from '../../app'\nimport { baseSnapshot, framed, type Native, scriptedNative, tenant, withTenant } from '../../test/native'\n\nconst CONTEXT = 'cx-aaaaaaaaaaaaaaaaaaaaaaaa'\nconst CLIENT_ID = 'svc@1234567890.iam.panserviceaccount.com'\nconst SECRET = 'synthetic-management-secret-0042'\nconst readyManagement: TenantView['management'] = {\n    state: 'ready',\n    mode: 'keychain',\n    failure: null,\n    clientId: CLIENT_ID,\n    tokenOrigin: 'https://auth.apps.paloaltonetworks.com',\n}\n\nasync function openSettings(native: Native) {\n    const user = userEvent.setup()\n    render(<App client={new DesktopClient(framed(native, 'settings').transport)} />)\n    await screen.findByRole('heading', { level: 1, name: 'Settings' })\n    return user\n}\n\nconst section = () => document.querySelector<HTMLElement>('[data-slot=\"management-credential\"]') as HTMLElement\nconst secretField = () => within(section()).getByLabelText('Client secret') as HTMLInputElement\nconst clientField = () => within(section()).getByLabelText('Client ID') as HTMLInputElement\n\nlet setItem: ReturnType<typeof vi.spyOn>\nbeforeEach(() => {\n    setItem = vi.spyOn(Storage.prototype, 'setItem')\n})\nafterEach(() => setItem.mockRestore())\n\ndescribe('management client onboarding', () => {\n    it('saves a separate client, clearing the secret before awaiting and keeping it out of storage', async () => {\n        const native = scriptedNative(withTenant(baseSnapshot, tenant({ scan: { state: 'ready', mode: 'keychain', failure: null } }), CONTEXT))\n        let admit: (value: unknown) => void = () => undefined\n        native.respond = () => new Promise((resolve) => (admit = resolve))\n        const user = await openSettings(native)\n        expect(within(section()).getByRole('status')).toHaveTextContent('Scans do not need one')\n        await user.type(clientField(), CLIENT_ID)\n        await user.type(secretField(), SECRET)\n        await user.click(within(section()).getByRole('radio', { name: /For this session only/ }))\n        await user.click(within(section()).getByRole('button', { name: 'Save client' }))\n        expect(secretField().value).toBe('')\n        expect(native.dispatched).toEqual([{ kind: 'configureManagementCredential', context: CONTEXT, mode: 'session', clientId: CLIENT_ID, secret: SECRET }])\n        admit({ outcome: 'receipt', receipt: { kind: 'admitted', request: 'rq-1', operation: null } })\n        // The scan key is never part of a management intent.\n        expect(native.dispatched.some((i) => i.kind === 'configureScanCredential')).toBe(false)\n        for (const call of setItem.mock.calls) expect(JSON.stringify(call)).not.toContain(SECRET)\n        expect(native.delivered.join('\\n')).not.toContain(SECRET)\n    })\n\n    it('requires a client ID and a secret before dispatching', async () => {\n        const native = scriptedNative(withTenant(baseSnapshot, tenant(), CONTEXT))\n        const user = await openSettings(native)\n        await user.click(within(section()).getByRole('button', { name: 'Save client' }))\n        expect(within(section()).getByRole('alert')).toHaveTextContent('Enter the client ID.')\n        await user.type(clientField(), CLIENT_ID)\n        await user.click(within(section()).getByRole('button', { name: 'Save client' }))\n        expect(within(section()).getByRole('alert')).toHaveTextContent('Enter the client secret.')\n        expect(native.dispatched).toEqual([])\n    })\n\n    it('needs a TSG ID on the tenant profile', async () => {\n        const native = scriptedNative(withTenant(baseSnapshot, tenant({ tsgId: null }), CONTEXT))\n        await openSettings(native)\n        expect(screen.getByText(/has no TSG ID/)).toBeInTheDocument()\n        expect(within(section()).getByRole('button', { name: 'Save client' })).toBeDisabled()\n    })\n\n    it('points to the Harness for company sign-in (SSO)', async () => {\n        const native = scriptedNative(withTenant(baseSnapshot, tenant(), CONTEXT))\n        await openSettings(native)\n        expect(within(section()).getByText('Company sign-in (SSO) for the Harness is set up per Gateway workspace, in Harness.')).toBeInTheDocument()\n    })\n\n    it('verifies with one management read and reports failures faithfully', async () => {\n        const native = scriptedNative(withTenant(baseSnapshot, tenant({ management: readyManagement }), CONTEXT))\n        let answer: unknown = { kind: 'management', result: { kind: 'verified' } }\n        native.respond = () => ({ outcome: 'receipt', receipt: { kind: 'admitted', request: 'rq-1', operation: 'op-7' } })\n        const observed: string[] = []\n        native.observeManagement = (operation) => {\n            observed.push(operation)\n            return answer\n        }\n        const user = await openSettings(native)\n        expect(within(section()).getByRole('status')).toHaveTextContent('saved in secure storage')\n        expect(within(section()).getByText(`Client ID: ${CLIENT_ID}`)).toBeInTheDocument()\n        await user.click(within(section()).getByRole('button', { name: 'Verify' }))\n        expect(await within(section()).findByText('Management OAuth authentication succeeded.')).toBeInTheDocument()\n        expect(native.dispatched).toEqual([{ kind: 'management', context: CONTEXT, request: { kind: 'verify' } }])\n        expect(observed).toEqual(['op-7'])\n        answer = { kind: 'management', result: { kind: 'failed', failure: 'unauthorized', outcome: 'rejected' } }\n        await user.click(within(section()).getByRole('button', { name: 'Verify' }))\n        expect(await within(section()).findByRole('alert')).toHaveTextContent('was not accepted')\n        expect(within(section()).queryByText('Management OAuth authentication succeeded.')).toBeNull()\n    })\n\n    it('removes only the management client', async () => {\n        const native = scriptedNative(withTenant(baseSnapshot, tenant({ scan: { state: 'ready', mode: 'keychain', failure: null }, management: readyManagement }), CONTEXT))\n        const user = await openSettings(native)\n        await user.click(within(section()).getByRole('button', { name: 'Remove management client' }))\n        expect(native.dispatched).toEqual([{ kind: 'removeManagementCredential', context: CONTEXT }])\n    })\n})\n/**\n * Production scan-key entry through the real App, DesktopClient and shell:\n * fresh capture at submission, transient handling, storage-mode choice and\n * truthful outcome reporting.\n */\nimport { act, render, screen, within } from '@testing-library/react'\nimport userEvent from '@testing-library/user-event'\nimport { afterEach, beforeEach, describe, expect, it, vi } from 'vitest'\nimport { DesktopClient } from '@prisma-airs/desktop-contracts'\nimport { App } from '../../app'\nimport { baseSnapshot, type Native, scriptedNative, tenant, withTenant, framed } from '../../test/native'\n\nconst KEY = 'synthetic-scan-key-0042'\n\nasync function openSettings(native: Native) {\n    const user = userEvent.setup()\n    render(<App client={new DesktopClient(native.transport)} />)\n    // C44: one presentation; the core names the destination in the snapshot.\n    await native.push({ ...native.current, onboarding: 'done', activeFeature: 'settings' })\n    return user\n}\n\nconst keyField = () => screen.getByLabelText('AIRS API key') as HTMLInputElement\n\nlet setItem: ReturnType<typeof vi.spyOn>\nbeforeEach(() => {\n    setItem = vi.spyOn(Storage.prototype, 'setItem')\n})\nafterEach(() => setItem.mockRestore())\n\ndescribe('scan-key entry', () => {\n    it('captures the key typed at submission time and clears the field before awaiting', async () => {\n        const native = framed(scriptedNative(withTenant(baseSnapshot, tenant())), 'settings')\n        let admit: (value: unknown) => void = () => undefined\n        native.respond = () => new Promise((resolve) => (admit = resolve))\n        const user = await openSettings(native)\n        await user.type(keyField(), 'first-draft')\n        await user.clear(keyField())\n        await user.type(keyField(), KEY)\n        await user.click(screen.getByRole('button', { name: 'Save key' }))\n        expect(keyField().value).toBe('')\n        expect(native.dispatched).toEqual([\n            {\n                kind: 'configureScanCredential',\n                context: 'cx-aaaaaaaaaaaaaaaaaaaaaaaa',\n                mode: 'keychain',\n                key: KEY,\n            },\n        ])\n        await act(async () => admit({ outcome: 'receipt', receipt: { kind: 'admitted', request: 'rq-1', operation: null } }))\n        expect(screen.queryByRole('alert')).toBeNull()\n    })\n\n    it('keeps the key out of snapshots, observations, the page and browser storage', async () => {\n        const native = framed(scriptedNative(withTenant(baseSnapshot, tenant())), 'settings')\n        const user = await openSettings(native)\n        await user.type(keyField(), KEY)\n        await user.click(screen.getByRole('button', { name: 'Save key' }))\n        await native.push(\n            withTenant(baseSnapshot, tenant({ scan: { state: 'ready', mode: 'keychain', failure: null } }), 'cx-bbbbbbbbbbbbbbbbbbbbbbbb')\n        )\n        expect(screen.getByText('Scan key saved in secure storage.')).toBeInTheDocument()\n        const withKey = native.sent.filter((body) => body.includes(KEY))\n        expect(withKey).toHaveLength(1)\n        expect(JSON.parse(withKey[0]!).intent.kind).toBe('configureScanCredential')\n        expect(native.delivered.some((update) => update.includes(KEY))).toBe(false)\n        expect(document.body.innerHTML).not.toContain(KEY)\n        expect(setItem).not.toHaveBeenCalled()\n    })\n\n    it('sends the session-only choice when selected', async () => {\n        const native = framed(scriptedNative(withTenant(baseSnapshot, tenant())), 'settings')\n        const user = await openSettings(native)\n        const scanKey = document.querySelector<HTMLElement>('[data-slot=\"scan-key\"]') as HTMLElement\n        await user.click(within(scanKey).getByRole('radio', { name: /For this session only/ }))\n        await user.type(keyField(), KEY)\n        await user.click(screen.getByRole('button', { name: 'Save key' }))\n        expect(native.dispatched.at(-1)).toMatchObject({ kind: 'configureScanCredential', mode: 'session' })\n    })\n\n    it('reports a refusal without claiming the key was saved', async () => {\n        const native = framed(scriptedNative(withTenant(baseSnapshot, tenant())), 'settings')\n        native.respond = () => ({ outcome: 'refusal', refusal: 'staleContext' })\n        const user = await openSettings(native)\n        await user.type(keyField(), KEY)\n        await user.click(screen.getByRole('button', { name: 'Save key' }))\n        expect(await screen.findByRole('alert')).toHaveTextContent(/active tenant changed/i)\n        expect(keyField().value).toBe('')\n        expect(screen.getByText(/No scan key/)).toBeInTheDocument()\n    })\n\n    it('reports an unconfirmed delivery as unknown', async () => {\n        const native = framed(scriptedNative(withTenant(baseSnapshot, tenant())), 'settings')\n        native.respond = () => Promise.reject(new Error('lost'))\n        const user = await openSettings(native)\n        await user.type(keyField(), KEY)\n        await user.click(screen.getByRole('button', { name: 'Save key' }))\n        expect(await screen.findByRole('alert')).toHaveTextContent(/did not confirm/i)\n        const configure = native.dispatched.filter((i) => i.kind === 'configureScanCredential')\n        expect(configure.length).toBeGreaterThan(0)\n        expect(new Set(native.sent.filter((b) => b.includes(KEY)))).toHaveProperty('size', 1)\n    })\n\n    it('refuses an empty key locally and focuses the field', async () => {\n        const native = framed(scriptedNative(withTenant(baseSnapshot, tenant())), 'settings')\n        const user = await openSettings(native)\n        await user.click(screen.getByRole('button', { name: 'Save key' }))\n        expect(await screen.findByRole('alert')).toHaveTextContent('Enter the scan key.')\n        expect(keyField()).toHaveFocus()\n        expect(native.dispatched).toEqual([])\n    })\n\n    it('shows locked and denied failures with explicit recovery, never a fallback', async () => {\n        const native = framed(scriptedNative(\n            withTenant(baseSnapshot, tenant({ scan: { state: 'failed', mode: 'keychain', failure: 'locked' } }))\n        ), 'settings')\n        await openSettings(native)\n        expect(screen.getByText(/Secure storage is locked/)).toBeInTheDocument()\n        await native.push(withTenant(baseSnapshot, tenant({ scan: { state: 'failed', mode: 'keychain', failure: 'denied' } })))\n        expect(screen.getByText(/did not allow access/)).toBeInTheDocument()\n        expect(screen.getByRole('button', { name: 'Replace key' })).toBeInTheDocument()\n    })\n\n    it('removes the scan key under the current context', async () => {\n        const native = framed(scriptedNative(\n            withTenant(baseSnapshot, tenant({ scan: { state: 'ready', mode: 'session', failure: null } }))\n        ), 'settings')\n        const user = await openSettings(native)\n        expect(screen.getByText('Scan key held for this session only.')).toBeInTheDocument()\n        await user.click(screen.getByRole('button', { name: 'Remove scan key' }))\n        expect(native.dispatched).toEqual([{ kind: 'removeScanCredential', context: 'cx-aaaaaaaaaaaaaaaaaaaaaaaa' }])\n    })\n\n    it('discards a partially typed key when the context changes', async () => {\n        const native = framed(scriptedNative(withTenant(baseSnapshot, tenant())), 'settings')\n        const user = await openSettings(native)\n        await user.type(keyField(), 'partial')\n        await native.push(withTenant(baseSnapshot, tenant(), 'cx-cccccccccccccccccccccccc'))\n        expect(keyField().value).toBe('')\n        expect(native.dispatched).toEqual([])\n    })\n})\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_19","type":"command_execution","command":"/bin/zsh -lc \"sed -n '135,200p' crates/desktop-core/src/store.rs && sed -n '700,790p' crates/desktop-core/src/store.rs && sed -n '1,65p' crates/desktop-core/src/wire.rs && cat apps/desktop/src/modules/academy/academy-account.tsx\"","aggregated_output":"    /// The Gateway workspace it is published in.\n    pub workspace: String,\n    pub server_id: String,\n    /// On for new conversations (at most eight per workspace).\n    pub enabled: bool,\n    pub grant: Option<StoredMcpGrant>,\n}\n\n/// A sign-in to a workspace MCP server: bound to the server's URL and\n/// catalog revision when it was made. Its tokens are a Keychain item.\n#[derive(Clone, Debug, PartialEq, Eq, Serialize, Deserialize)]\n#[serde(rename_all = \"camelCase\", deny_unknown_fields)]\npub struct StoredMcpGrant {\n    /// A UUID made for this sign-in (a new sign-in is a new grant).\n    pub id: String,\n    pub url: String,\n    pub revision: String,\n    /// The client registered for this sign-in (public).\n    pub client_id: String,\n    pub token_endpoint: String,\n    pub revocation_endpoint: Option<String>,\n    pub record: RecordId,\n}\n\n/// The persisted document.\n#[derive(Clone, Debug, PartialEq, Eq, Serialize, Deserialize)]\n#[serde(rename_all = \"camelCase\", deny_unknown_fields)]\npub struct PersistedState {\n    pub schema: String,\n    pub appearance: Theme,\n    /// Missing in earlier state: use the Prisma AIRS family while retaining appearance.\n    #[serde(default, skip_serializing_if = \"ColorTheme::is_default\")]\n    pub color_theme: ColorTheme,\n    pub tenants: Vec<TenantProfile>,\n    pub active_tenant: Option<TenantId>,\n    pub credentials: Vec<StoredCredential>,\n    /// Keychain records to delete (replaced, signed out, orphaned or reset).\n    pub pending_cleanup: Vec<RecordId>,\n    /// The Academy learner account, if signed in (C04; absent before).\n    #[serde(default, skip_serializing_if = \"Option::is_none\")]\n    pub learner: Option<StoredLearner>,\n    /// Learner-namespace records to delete (write-ahead entries, replaced,\n    /// signed out or abandoned), drained only after a confirmed save.\n    #[serde(default, skip_serializing_if = \"Vec::is_empty\")]\n    pub learner_cleanup: Vec<RecordId>,\n    /// Each tenant's chosen Gateway workspace (C16; absent before).\n    #[serde(default, skip_serializing_if = \"Vec::is_empty\")]\n    pub gateway_workspaces: Vec<GatewayPreference>,\n    /// Company sign-ins for the Harness (C20; absent before).\n    #[serde(default, skip_serializing_if = \"Vec::is_empty\")]\n    pub harness_sign_ins: Vec<StoredSignIn>,\n    /// Workspaces whose protected Harness history may exist (C20), so a\n    /// tenant's removal also removes their keys.\n    #[serde(default, skip_serializing_if = \"Vec::is_empty\")]\n    pub harness_history: Vec<GatewayPreference>,\n    /// Each tenant's Harness project (C21; absent before).\n    #[serde(default, skip_serializing_if = \"Vec::is_empty\")]\n    pub harness_projects: Vec<StoredProject>,\n    /// Workspace MCP servers and their sign-ins (C22; absent before).\n    #[serde(default, skip_serializing_if = \"Vec::is_empty\")]\n    pub harness_mcp: Vec<StoredMcpServer>,\n    /// First-run wizard state (C28/C29; absent before = needed).\n    #[serde(default)]\n    pub onboarding: crate::features::OnboardingState,\n    /// \"Show the calls\" preference (C28; absent before = on).\n    #[serde(default = \"show_calls_default\")]\n    fn sample() -> PersistedState {\n        let id = TenantId::parse(\"tn-0123456789abcdef\").expect(\"id\");\n        PersistedState {\n            appearance: Theme::Dark,\n            tenants: vec![TenantProfile {\n                id: id.clone(),\n                label: \"Prod\".into(),\n                tsg_id: Some(\"1234\".into()),\n                destination: Destination::Region {\n                    region: Region::Europe,\n                },\n                environment: Default::default(),\n            }],\n            active_tenant: Some(id.clone()),\n            credentials: vec![StoredCredential {\n                record: RecordId::parse(\"cr-0123456789abcdef\").expect(\"record\"),\n                tenant: id,\n                destination: Region::Europe.origin().into(),\n                class: CredentialClass::Scan,\n                client_id: None,\n                inference: None,\n            }],\n            ..PersistedState::default()\n        }\n    }\n\n    #[test]\n    fn color_theme_defaults_existing_state_without_changing_appearance() {\n        let mut value = serde_json::to_value(sample()).expect(\"state\");\n        assert!(value.get(\"colorTheme\").is_none(), \"default stays omitted\");\n        let state: PersistedState = serde_json::from_value(value.clone()).expect(\"old state\");\n        assert_eq!(state.color_theme, ColorTheme::PrismaAirs);\n        assert_eq!(state.appearance, Theme::Dark);\n        value[\"colorTheme\"] = serde_json::json!(\"not-a-theme\");\n        assert!(serde_json::from_value::<PersistedState>(value).is_err());\n    }\n\n    #[test]\n    fn alternate_color_theme_roundtrips_independently_of_appearance() {\n        let mut state = sample();\n        state.color_theme = ColorTheme::Gruvbox;\n        let value = serde_json::to_value(&state).expect(\"state\");\n        assert_eq!(value[\"colorTheme\"], \"gruvbox\");\n        assert_eq!(\n            serde_json::from_value::<PersistedState>(value).expect(\"new state\"),\n            state\n        );\n    }\n\n    #[test]\n    fn saves_atomically_with_owner_only_modes_and_reloads() {\n        use std::os::unix::fs::PermissionsExt;\n        let dir = scratch(\"roundtrip\");\n        let store = FileStore::open(&dir).expect(\"open\");\n        assert_eq!(store.load(), Ok(None));\n        store.save(&sample()).expect(\"save\");\n        assert_eq!(store.load(), Ok(Some(sample())));\n        let mode = |p: &Path| fs::metadata(p).expect(\"meta\").permissions().mode() & 0o777;\n        assert_eq!(mode(&dir), 0o700);\n        assert_eq!(mode(&dir.join(STATE_FILE)), 0o600);\n        let leftovers: Vec<_> = fs::read_dir(&dir)\n            .expect(\"dir\")\n            .filter_map(|e| e.ok())\n            .filter(|e| e.file_name().to_string_lossy().starts_with('.'))\n            .collect();\n        assert!(leftovers.is_empty(), \"no temporary files remain\");\n        store.reset().expect(\"reset\");\n        assert_eq!(store.load(), Ok(None));\n        drop(store);\n        fs::remove_dir_all(&dir).expect(\"cleanup\");\n    }\n\n    #[test]\n    fn a_setup_draft_and_its_credential_round_trip_through_the_file_store() {\n        // C29: a keyed draft is written so its records are known; the\n        // production store accepts the document (the draft owns the record)\n        // and the next load cleans it up.\n        let dir = scratch(\"draft\");\n        let store = FileStore::open(&dir).expect(\"open\");\n        let mut doc = sample();\n        let draft_id = TenantId::parse(\"tn-00000000d4af7001\").expect(\"id\");\n        doc.tenant_draft = Some(StoredDraft {\n            profile: TenantProfile {\n                id: draft_id.clone(),\n                label: \"Drafted\".into(),\n                tsg_id: Some(\"1234567890\".into()),\n                destination: Destination::Region {\n                    region: Region::UnitedStates,\n                },\n                environment: crate::features::TenantEnvironment::Staging,\n            },\n//! Versioned wire contract between the React presentation and the native host.\n//!\n//! Requests are parsed from raw bytes with an explicit size ceiling and strict\n//! schemas: unknown fields, unknown variants, wrong protocol versions and\n//! non-canonical sequence numbers are rejected before any authority is\n//! consulted. Opaque IDs, revisions and sequences are strings so JavaScript\n//! never rounds a u64. TypeScript declarations are generated from these types\n//! (`xtask bindings`); they document the shape but do not validate at runtime.\n\nuse std::path::Path;\n\nuse serde::{Deserialize, Serialize};\nuse ts_rs::TS;\n\nuse crate::authority::{Intent, Receipt, Refusal, ShellSnapshot};\nuse crate::delivery::{Delivery, DeliverySession};\nuse crate::features::{Availability, FeatureEntry, FeatureId};\n\n/// The only wire protocol version this build accepts.\npub const PROTOCOL: u32 = 1;\n\n/// Ceiling for one serialized request (DESIGN: 32MiB JSON envelope).\npub const MAX_REQUEST_BYTES: usize = 32 * 1024 * 1024;\n\n/// Desktop-wide appearance preference.\n#[derive(Clone, Copy, Debug, PartialEq, Eq, Serialize, Deserialize, TS)]\n#[serde(rename_all = \"camelCase\")]\npub enum Theme {\n    System,\n    Light,\n    Dark,\n}\n\n/// Desktop palette family, independent of light/dark appearance and Academy.\n#[derive(Clone, Copy, Debug, Default, PartialEq, Eq, Serialize, Deserialize, TS)]\n#[serde(rename_all = \"camelCase\")]\npub enum ColorTheme {\n    #[default]\n    PrismaAirs,\n    Gruvbox,\n}\n\nimpl ColorTheme {\n    pub fn is_default(&self) -> bool {\n        *self == Self::PrismaAirs\n    }\n}\n\n/// One Intent delivery from the renderer.\n#[derive(Clone, Debug, PartialEq, Eq, Deserialize, TS)]\n#[serde(rename_all = \"camelCase\", deny_unknown_fields)]\npub struct DispatchRequest {\n    pub protocol: u32,\n    pub session: String,\n    /// Decimal u64 without sign or leading zeros.\n    pub sequence: String,\n    pub intent: Intent,\n}\n\n/// An observation or session request from the renderer.\n#[derive(Clone, Debug, PartialEq, Eq, Deserialize, TS)]\n#[serde(rename_all = \"camelCase\", deny_unknown_fields)]\npub struct ObserveRequest {\n    pub protocol: u32,\n    pub scope: WireScope,\nimport { useId, useState } from 'react'\nimport { Button, Callout } from '@ai-security-academy/presentation'\nimport { AlertTriangle, CheckCircle2, Info } from 'lucide-react'\nimport type { AcademyFailure, AcademyView, Intent, VaultError } from '@prisma-airs/desktop-contracts'\nimport { type Dispatch, outcomeMessage } from '../tenants/dispatch'\n\nconst FAILURE_TEXT: Record<AcademyFailure, string> = {\n    notConfigured: 'Academy desktop sign-in is not available on this server.',\n    invalidConfig: 'Academy returned a sign-in configuration the desktop cannot trust.',\n    network: 'Academy could not be reached. Check your connection and try again.',\n    invalidResponse: 'Academy returned an unexpected sign-in response. Try again.',\n    denied: 'Sign-in was declined in the browser.',\n    expired: 'The sign-in code expired before it was approved. Start again.',\n    sessionExpired: 'Your Academy session expired. Sign in again.',\n    scopeMissing: 'Academy did not grant learning access to this sign-in.',\n    accountChanged: 'Academy changed its sign-in configuration. Sign in again.',\n    authFailed: 'Academy sign-in could not complete. Try again.',\n}\n\nconst VAULT_TEXT: Record<VaultError, string> = {\n    locked: 'Secure storage is locked, so the session could not be saved. Unlock it and sign in again.',\n    denied: 'The system did not allow the Academy session to be saved in secure storage.',\n    unavailable: 'Secure storage is not available, so the session could not be saved.',\n    notFound: 'The saved Academy session is missing from secure storage.',\n    corrupt: 'The saved Academy session could not be read.',\n}\n\ninterface Props {\n    view: AcademyView\n    dispatch: Dispatch\n}\n\n/**\n * The Academy learner account, independent of AIRS tenants. Sign-in is a\n * browser device flow: the desktop shows a code, opens the Academy page the\n * issuer named, and never sees a password. Tokens stay in the native core.\n */\nexport function AcademyAccount({ view, dispatch }: Props) {\n    const legend = useId()\n    const [busy, setBusy] = useState(false)\n    const [message, setMessage] = useState<string | null>(null)\n\n    async function send(intent: Intent) {\n        setBusy(true)\n        setMessage(null)\n        const outcome = await dispatch(intent)\n        setBusy(false)\n        setMessage(outcomeMessage(outcome))\n    }\n\n    return (\n        <fieldset\n            aria-labelledby={legend}\n            aria-busy={busy}\n            data-slot='academy-account'\n            className='settings-card'\n        >\n            <legend id={legend} className='text-academy-ink px-1 text-[15px] font-semibold'>\n                Academy account\n            </legend>\n            <p className='text-academy-ink-soft text-[13px]'>\n                Your Academy learner account is separate from AIRS tenants; switching tenants does not change it.\n            </p>\n            <div role='status' aria-live='polite' className='flex flex-col gap-3'>\n                <State view={view} busy={busy} send={send} />\n            </div>\n            {message ? (\n                <p role='alert' data-slot='academy-message' className='text-academy-accent-warn text-[13px]'>\n                    {message}\n                </p>\n            ) : null}\n        </fieldset>\n    )\n}\n\nfunction State({ view, busy, send }: { view: AcademyView; busy: boolean; send: (intent: Intent) => Promise<void> }) {\n    switch (view.state) {\n        case 'signedOut':\n            return (\n                <div className='flex flex-col items-start gap-3'>\n                    <p className='text-academy-ink text-[13px]'>Not signed in to Academy.</p>\n                    <Button type='button' tier='primary' disabled={busy} onClick={() => void send({ kind: 'startAcademySignIn' })}>\n                        Sign in to Academy\n                    </Button>\n                </div>\n            )\n        case 'starting':\n        case 'completing':\n            return (\n                <div className='flex flex-col items-start gap-3'>\n                    <p className='text-academy-ink text-[13px]'>\n                        {view.state === 'starting' ? 'Contacting Academy…' : 'Approved. Finishing sign-in…'}\n                    </p>\n                    <Button type='button' tier='secondary' onClick={() => void send({ kind: 'cancelAcademySignIn' })}>\n                        Cancel sign-in\n                    </Button>\n                </div>\n            )\n        case 'awaitingApproval':\n            return (\n                <div className='flex flex-col items-start gap-3' data-slot='academy-code'>\n                    <p className='text-academy-ink text-[13px]'>Enter this code on the Academy sign-in page:</p>\n                    <p\n                        className='font-mono text-academy-ink text-[24px] font-semibold tracking-[0.12em] select-all'\n                        aria-label={`Sign-in code ${view.userCode.split('').join(' ')}`}\n                    >\n                        {view.userCode}\n                    </p>\n                    <p className='text-academy-ink-faint text-[12px] break-all'>\n                        {view.verificationUri} · expires in {Math.max(1, Math.ceil(view.expiresIn / 60))} min\n                    </p>\n                    <div className='flex flex-wrap gap-2'>\n                        <Button type='button' tier='primary' onClick={() => void send({ kind: 'openAcademyVerification' })}>\n                            Open sign-in page\n                        </Button>\n                        <Button type='button' tier='secondary' onClick={() => void send({ kind: 'cancelAcademySignIn' })}>\n                            Cancel sign-in\n                        </Button>\n                    </div>\n                </div>\n            )\n        case 'signedIn':\n            return (\n                <div className='flex flex-col items-start gap-3'>\n                    <Callout tone='success' icon={CheckCircle2}>\n                        <p>\n                            Signed in to Academy as <span className='font-semibold'>{view.displayName}</span>.\n                        </p>\n                    </Callout>\n                    <Button type='button' tier='secondary' disabled={busy} onClick={() => void send({ kind: 'signOutAcademy' })}>\n                        Sign out of Academy\n                    </Button>\n                </div>\n            )\n        case 'failed':\n            return (\n                <div className='flex flex-col items-start gap-3'>\n                    <Callout tone='warning' icon={view.failure === 'network' ? Info : AlertTriangle} data-slot='academy-failure'>\n                        {view.displayName ? <p className='font-semibold'>{view.displayName}</p> : null}\n                        <p>{view.vault ? VAULT_TEXT[view.vault] : FAILURE_TEXT[view.failure]}</p>\n                    </Callout>\n                    <div className='flex flex-wrap gap-2'>\n                        <Button type='button' tier='primary' disabled={busy} onClick={() => void send({ kind: 'startAcademySignIn' })}>\n                            Sign in again\n                        </Button>\n                        <Button type='button' tier='secondary' disabled={busy} onClick={() => void send({ kind: 'signOutAcademy' })}>\n                            Sign out of Academy\n                        </Button>\n                    </div>\n                </div>\n            )\n    }\n}\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_20","type":"command_execution","command":"/bin/zsh -lc \"sed -n '375,455p' apps/desktop/src/modules/tenants/tenants-settings.tsx && sed -n '55,120p' apps/desktop/src/shell/feature-view.tsx && sed -n '3560,3600p' crates/desktop-core/src/authority.rs && sed -n '3860,3955p' crates/desktop-core/src/authority.rs && cat crates/desktop-core/tests/refinement_metadata.rs && sed -n '6050,6155p' crates/desktop-core/src/authority.rs\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_20","type":"command_execution","command":"/bin/zsh -lc \"sed -n '375,455p' apps/desktop/src/modules/tenants/tenants-settings.tsx && sed -n '55,120p' apps/desktop/src/shell/feature-view.tsx && sed -n '3560,3600p' crates/desktop-core/src/authority.rs && sed -n '3860,3955p' crates/desktop-core/src/authority.rs && cat crates/desktop-core/tests/refinement_metadata.rs && sed -n '6050,6155p' crates/desktop-core/src/authority.rs\"","aggregated_output":"                {active && snapshot.active && <>\n                    <ScanKeyForm key={snapshot.active.context} tenant={active} context={snapshot.active.context} dispatch={dispatch} />\n                    <ManagementCredentialForm key={`management-${snapshot.active.context}`} tenant={active} context={snapshot.active.context} dispatch={dispatch} observe={observeManagement} />\n                    <EndpointChange key={`destination-${snapshot.active.context}`} tenant={active} snapshot={snapshot} dispatch={dispatch} />\n                </>}\n                <UpdateTenant snapshot={snapshot} dispatch={dispatch} />\n                <AddTenant snapshot={snapshot} dispatch={dispatch} observeManagement={observeManagement} />\n                <ResetLocalData snapshot={snapshot} dispatch={dispatch} />\n            </div>\n        </section>\n    )\n}\nexport const SettingsView = forwardRef<HTMLHeadingElement, SettingsProps>(function SettingsView(\n    { snapshot, pending, onSetAppearance, dispatch, observeManagement }\n) {\n    const legend = useId()\n    const [themeBusy, setThemeBusy] = useState(false)\n    const [message, setMessage] = useState<string | null>(null)\n    async function setColorTheme(theme: ShellSnapshot['colorTheme']) {\n        setThemeBusy(true)\n        setMessage(null)\n        const outcome = await dispatch({ kind: 'setColorTheme', theme })\n        setThemeBusy(false)\n        setMessage(outcomeMessage(outcome))\n    }\n    return (\n        <section aria-label='Settings' data-slot='settings' className='flex flex-col gap-4'>\n            <PageIntro description='Personalize the desktop, manage tenant connections and review local diagnostics.' />\n            <div className='settings-grid'>\n                <fieldset aria-labelledby={legend} aria-busy={pending || themeBusy} className='settings-card'>\n                    <legend id={legend}>Appearance</legend>\n                    <p className='settings-description'>Desktop preferences do not change your Academy account settings.</p>\n                    <div className='settings-fields'>\n                        <label className='settings-field'>\n                            Appearance\n                            <select aria-label='Appearance' value={snapshot.appearance} disabled={pending} onChange={(e) => onSetAppearance(e.target.value as Theme)}>\n                                <option value='system'>Match system</option>\n                                <option value='light'>Light</option>\n                                <option value='dark'>Dark</option>\n                            </select>\n                        </label>\n                        <label className='settings-field'>\n                            Theme\n                            <select aria-label='Theme' value={snapshot.colorTheme} disabled={themeBusy} onChange={(e) => void setColorTheme(e.target.value as ShellSnapshot['colorTheme'])}>\n                                <option value='prismaAirs'>Prisma AIRS</option>\n                                <option value='gruvbox'>Gruvbox</option>\n                            </select>\n                        </label>\n                    </div>\n                    {message && <p role='alert'>{message}</p>}\n                </fieldset>\n                <AcademyAccount view={snapshot.academy} dispatch={dispatch} />\n                <DiagnosticsPanel view={snapshot.diagnostics} dispatch={dispatch}>\n                    <SetupWarningHistory warnings={snapshot.tenants.find((t) => t.id === snapshot.active?.tenant)?.setupWarnings ?? []} />\n                </DiagnosticsPanel>\n            </div>\n            <TenantsSettings snapshot={snapshot} dispatch={dispatch} observeManagement={observeManagement} />\n        </section>\n    )\n})\n    match intent {\n        Intent::SetAppearance { theme } => {\n            if state.appearance() != theme {\n                let before = state.data.clone();\n                state.data.appearance = Some(theme);\n                if state.storage == StorageHealth::Ready\n                    && let Err(e) = state.save_with(&before)\n                {\n                    return Err(e);\n                }\n                state.changed();\n            }\n        }\n        Intent::SetColorTheme { theme } => {\n            if state.color_theme() != theme {\n                let before = state.data.clone();\n                state.data.color_theme = theme;\n                if state.storage == StorageHealth::Ready\n                    && let Err(e) = state.save_with(&before)\n                {\n                    return Err(e);\n                }\n                state.changed();\n            }\n        }\n        Intent::Navigate { feature } => {\n            let entry = features::catalogue()\n                .into_iter()\n                .find(|e| e.id == feature)\n                .ok_or(Refusal::InvalidInput)?;\n            if entry.availability != features::Availability::Available {\n                return Err(Refusal::InvalidInput);\n            }\n            if state.active_feature != Some(feature) {\n                state.active_feature = Some(feature);\n                state.changed();\n            }\n        }\n        Intent::SetOnboarding { state: next } => {\n            use features::OnboardingState as O;\n            let current = state.onboarding();\n            operation_ref = operation;\n            effects.push(Effect::Start(starts));\n            effects.push(Effect::Start(state.take_gateway_starts()));\n            state.changed();\n        }\n        Intent::AcknowledgeItem { context, id } => {\n            state.hold_insight(&context, &id, HoldKind::Acknowledge)?;\n            state.changed();\n        }\n        Intent::SnoozeItem { context, id } => {\n            state.hold_insight(&context, &id, HoldKind::Snooze)?;\n            state.changed();\n        }\n        Intent::UnsnoozeItem { context, id } => {\n            state.restore_insight(&context, &id)?;\n            state.changed();\n        }\n        Intent::AcknowledgeDeployment {\n            context,\n            application,\n        } => {\n            state.require_storage()?;\n            let before = state.data.clone();\n            let issued_by = state.acknowledge_deployment(&context, &application)?;\n            state.save_with(&before)?;\n            // Only a recorded acknowledgement retires the held copy (I6).\n            if let Some((operation, old_key)) = issued_by {\n                state.forget_issuance(&operation, &old_key);\n            }\n            state.changed();\n        }\n        Intent::EditTenant {\n            tenant,\n            label,\n            environment,\n        } => {\n            state.require_storage()?;\n            if !state.committed_tenant(&tenant) {\n                return Err(Refusal::InvalidInput);\n            }\n            let before = state.data.clone();\n            let target = state\n                .data\n                .tenants\n                .iter_mut()\n                .find(|t| t.profile.id == tenant)\n                .ok_or(Refusal::InvalidInput)?;\n            let validated = ProfileDraft {\n                label,\n                tsg_id: target.profile.tsg_id.clone(),\n                destination: target.profile.destination.clone(),\n                environment,\n            }\n            .validate()\n            .ok_or(Refusal::InvalidInput)?;\n            target.profile.label = validated.label;\n            target.profile.environment = validated.environment;\n            state.save_with(&before)?;\n            state.changed();\n        }\n        Intent::DeleteTenant { tenant } => {\n            state.require_storage()?;\n            if !state.committed_tenant(&tenant) {\n                return Err(Refusal::InvalidInput);\n            }\n            let before = state.data.clone();\n            let was_active = state.data.active.as_ref() == Some(&tenant);\n            state.calls.forget(tenant.as_str());\n            let retired_session = state.retire_credential(&tenant);\n            let retired_management = state.retire_class(&tenant, CredentialClass::Management);\n            let retired_inference = state.retire_class(&tenant, CredentialClass::Inference);\n            // Its company sign-in ends: the refresh token item is deleted\n            // through the ledger and revoked at the provider.\n            let signed_in = state.grant(&tenant);\n            if let Some(record) = state\n                .tenant(&tenant)\n                .and_then(|t| t.harness_sign_in.as_ref())\n                .and_then(|s| s.grant.as_ref())\n                .map(|g| g.record.clone())\n            {\n                state.data.pending_cleanup.push(record);\n            }\n            // Its workspace MCP sign-ins end too: their token items are\n            // deleted through the ledger and revoked at each server.\n            let mcp_signed_in = state.mcp_grants_of(&tenant);\n            let mcp_records: Vec<_> = state\n                .tenant(&tenant)\n                .map(|t| {\n                    t.harness_mcp\n                        .iter()\n                        .filter_map(|m| m.grant.as_ref().map(|g| g.record.clone()))\n                        .collect()\n                })\n                .unwrap_or_default();\n            for record in mcp_records {\n                if !state.data.pending_cleanup.contains(&record) {\n#![cfg(feature = \"test-fixtures\")]\n\nuse desktop_core::features::TenantEnvironment;\nuse desktop_core::fixtures::{self, ScriptedStore};\nuse desktop_core::store::PersistedState;\nuse desktop_core::tenants::{Destination, Region, TenantId, TenantProfile};\nuse desktop_core::{\n    Core, CoreConfig, Delivery, Intent, Observation, Refusal, ShellSnapshot, ViewScope,\n};\nuse serde_json::json;\n\nfn profile(id: &str, label: &str) -> TenantProfile {\n    TenantProfile {\n        id: TenantId::parse(id).expect(\"fixture id\"),\n        label: label.to_owned(),\n        tsg_id: Some(\"1234567890\".to_owned()),\n        destination: Destination::Region {\n            region: Region::Europe,\n        },\n        environment: TenantEnvironment::Production,\n    }\n}\nfn snapshot(core: &Core) -> ShellSnapshot {\n    match core.operator().observe(ViewScope::Shell).expect(\"snapshot\") {\n        Observation::Shell { snapshot, .. } => snapshot,\n        _ => panic!(\"shell expected\"),\n    }\n}\nfn state() -> PersistedState {\n    let a = profile(\"tn-0123456789abcdef\", \"A\");\n    let b = profile(\"tn-fedcba9876543210\", \"B\");\n    PersistedState {\n        tenants: vec![a.clone(), b],\n        active_tenant: Some(a.id),\n        ..PersistedState::default()\n    }\n}\n#[tokio::test]\nasync fn metadata_edit_targets_only_the_selected_profile_without_rebinding_identity() {\n    let (adapters, handles) = fixtures::adapters_with(ScriptedStore::with_state(state()));\n    let core = Core::new(\n        CoreConfig {\n            fixture_tenant_creation: false,\n            ..CoreConfig::default()\n        },\n        adapters,\n    );\n    core.start();\n    let before = snapshot(&core);\n    let handle = core.operator();\n    let session = handle.register_delivery_session().expect(\"session\").nonce;\n    let target = before.tenants[1].id.clone();\n    handle\n        .dispatch(\n            Delivery {\n                session,\n                sequence: 1,\n            },\n            Intent::EditTenant {\n                tenant: target.clone(),\n                label: \"Renamed B\".to_owned(),\n                environment: TenantEnvironment::Staging,\n            },\n        )\n        .await\n        .expect(\"metadata edit\");\n    let after = snapshot(&core);\n    assert_eq!(\n        after.active, before.active,\n        \"metadata never switches the active tenant\"\n    );\n    assert_eq!(after.tenants[0], before.tenants[0]);\n    let changed = &after.tenants[1];\n    assert_eq!(changed.id, target);\n    assert_eq!(changed.label, \"Renamed B\");\n    assert_eq!(changed.environment, TenantEnvironment::Staging);\n    assert_eq!(changed.tsg_id, before.tenants[1].tsg_id);\n    assert_eq!(changed.destination, before.tenants[1].destination);\n    assert_eq!(changed.management, before.tenants[1].management);\n    assert_eq!(changed.scan, before.tenants[1].scan);\n    assert_eq!(\n        handles.store.saved().expect(\"saved\").tenants[1].label,\n        \"Renamed B\"\n    );\n}\n#[tokio::test]\nasync fn metadata_edit_rolls_back_when_private_persistence_fails() {\n    let (adapters, handles) = fixtures::adapters_with(ScriptedStore::with_state(state()));\n    let core = Core::new(\n        CoreConfig {\n            fixture_tenant_creation: false,\n            ..CoreConfig::default()\n        },\n        adapters,\n    );\n    core.start();\n    let before = snapshot(&core);\n    handles.store.fail_saves(true);\n    let handle = core.operator();\n    let session = handle.register_delivery_session().expect(\"session\").nonce;\n    assert!(\n        handle\n            .dispatch(\n                Delivery {\n                    session,\n                    sequence: 1\n                },\n                Intent::EditTenant {\n                    tenant: before.tenants[0].id.clone(),\n                    label: \"Not saved\".to_owned(),\n                    environment: TenantEnvironment::Other,\n                }\n            )\n            .await\n            .is_err()\n    );\n    let after = snapshot(&core);\n    assert_eq!(after.tenants, before.tenants);\n    assert_eq!(after.active, before.active);\n    assert_eq!(\n        handles.store.saved().expect(\"old saved state\").tenants[0].label,\n        \"A\"\n    );\n}\n#[tokio::test]\nasync fn metadata_edit_rejects_invalid_labels_and_has_no_tsg_or_endpoint_fields() {\n    let (adapters, _) = fixtures::adapters_with(ScriptedStore::with_state(state()));\n    let core = Core::new(\n        CoreConfig {\n            fixture_tenant_creation: false,\n            ..CoreConfig::default()\n        },\n        adapters,\n    );\n    core.start();\n    let before = snapshot(&core);\n    let handle = core.operator();\n    let session = handle.register_delivery_session().expect(\"session\").nonce;\n    assert_eq!(\n        handle\n            .dispatch(\n                Delivery {\n                    session,\n                    sequence: 1\n                },\n                Intent::EditTenant {\n                    tenant: before.tenants[0].id.clone(),\n                    label: \"   \".to_owned(),\n                    environment: TenantEnvironment::Other,\n                }\n            )\n            .await,\n        Err(Refusal::InvalidInput)\n    );\n    for (field, value) in [\n        (\"tsgId\", json!(\"9999999999\")),\n        (\"destination\", json!({\"kind\":\"region\", \"region\":\"india\"})),\n    ] {\n        let mut intent = json!({\"kind\":\"editTenant\", \"tenant\":before.tenants[0].id, \"label\":\"A\", \"environment\":\"production\"});\n        intent[field] = value;\n        assert!(\n            serde_json::from_value::<Intent>(intent).is_err(),\n            \"unreviewed identity field {field}\"\n        );\n    }\n    assert_eq!(snapshot(&core).tenants, before.tenants);\n}\n                // cleanup ledger); tenant profiles and preferences are kept.\n                // A fresh context is issued: no earlier reference revives.\n                state.storage = match inner.adapters.store.load() {\n                    Ok(_) => StorageHealth::Ready,\n                    Err(StoreError::Corrupt) => StorageHealth::Corrupt,\n                    Err(StoreError::Unavailable | StoreError::Unconfirmed) => {\n                        StorageHealth::Unavailable\n                    }\n                };\n                state.reset_failure = Some(failure);\n                let starts = state.reissue_context();\n                state.changed();\n                (starts, true)\n            }\n        }\n    };\n    run_effects(inner, vec![Effect::Start(starts)]);\n    if cleanup {\n        drain_cleanup(inner);\n    }\n}\n\n/// Wall-clock seconds since the Unix epoch, moved by the fixture clock offset.\nfn wall_secs(clock_offset: u32) -> u32 {\n    std::time::SystemTime::now()\n        .duration_since(std::time::UNIX_EPOCH)\n        .map_or(0, |d| u32::try_from(d.as_secs()).unwrap_or(u32::MAX))\n        .saturating_add(clock_offset)\n}\n\n#[cfg(test)]\nmod tests {\n    use super::*;\n\n    fn delivery(session: &str, sequence: u64) -> Delivery {\n        Delivery {\n            session: session.to_owned(),\n            sequence,\n        }\n    }\n\n    fn core(config: CoreConfig) -> Core {\n        Core::new(config, crate::fixtures::adapters().0)\n    }\n\n    #[tokio::test]\n    async fn color_theme_is_persisted_without_changing_appearance_or_tenant_scope() {\n        let core = core(CoreConfig::default());\n        let handle = core.operator();\n        let session = handle.register_delivery_session().expect(\"session\");\n        handle\n            .dispatch(\n                delivery(&session.nonce, 1),\n                Intent::SetAppearance {\n                    theme: Theme::Light,\n                },\n            )\n            .await\n            .expect(\"appearance\");\n        let before = lock(&core.inner).expect(\"state\").snapshot();\n        handle\n            .dispatch(\n                delivery(&session.nonce, 2),\n                Intent::SetColorTheme {\n                    theme: ColorTheme::Gruvbox,\n                },\n            )\n            .await\n            .expect(\"palette\");\n        let state = lock(&core.inner).expect(\"state\");\n        let after = state.snapshot();\n        assert_eq!(after.color_theme, ColorTheme::Gruvbox);\n        assert_eq!(after.appearance, Theme::Light);\n        assert_eq!(after.active, before.active);\n        let saved = state.persisted();\n        assert_eq!(saved.color_theme, ColorTheme::Gruvbox);\n        assert_eq!(saved.appearance, Theme::Light);\n    }\n\n    #[test]\n    fn observers_beyond_the_cap_are_refused_not_evicted() {\n        let core = core(CoreConfig::default());\n        let handle = core.operator();\n        let held: Vec<Observation> = (0..crate::observe::MAX_SUBSCRIBERS)\n            .map(|_| handle.observe(ViewScope::Shell).expect(\"within cap\"))\n            .collect();\n        assert_eq!(handle.observe(ViewScope::Shell).err(), Some(Refusal::Busy));\n        assert_eq!(handle.observer_count(), crate::observe::MAX_SUBSCRIBERS);\n        drop(held);\n        assert_eq!(handle.observer_count(), 0, \"closed observers are pruned\");\n        assert!(handle.observe(ViewScope::Shell).is_ok());\n    }\n\n    #[tokio::test]\n    async fn observer_queue_overflow_ends_with_resync() {\n        let core = core(CoreConfig {\n            retained_results: 4,\n            observer_queue: 3,\n            ..CoreConfig::default()\n        });\n        let handle = core.operator();\n        let Ok(Observation::Shell { mut updates, .. }) = handle.observe(ViewScope::Shell) else {\n            panic!(\"shell observation\");\n        };\n        let session = handle.register_delivery_session().expect(\"session\");\n        let themes = [Theme::Dark, Theme::Light, Theme::Dark, Theme::Light];\n","exit_code":0,"status":"completed"}}
