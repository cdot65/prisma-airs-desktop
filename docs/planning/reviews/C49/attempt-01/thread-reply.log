{"type":"item.completed","item":{"id":"item_42","type":"command_execution","command":"/bin/zsh -lc \"cat docs/planning/evidence/P11/helper-source-carry-final-02/fingerprint.json && sed -n '1,100p' docs/architecture/checks.json\"","aggregated_output":"{\n  \"source\": \"b793952c103302ef6174cbdf339dc49623d84919557b1999485aba3336731d35\",\n  \"dependencies\": \"2c489f82dc23ebf9680a9cb5977071253b226b29c8f019f1fb43db4ff3384326\",\n  \"build_flags\": \"2b29a1e96f4c6f878a15a50ae4e202d789ff6d5c93a7519fc8c3e2e32e06d432\"\n}\n{\n  \"schema_version\": 1,\n  \"status\": \"executable contract; C01 implements the runner and targets. Entries describe commands, not results.\",\n  \"target\": \"aarch64-apple-darwin\",\n  \"fixture_only_features\": [\n    \"test-fixtures\"\n  ],\n  \"setup_commands\": [\n    [\n      \"cargo\",\n      \"run\",\n      \"--locked\",\n      \"-p\",\n      \"xtask\",\n      \"--\",\n      \"shared-prepare\",\n      \"--input\",\n      \".inputs/academy\",\n      \"--scratch\",\n      \".work/academy\"\n    ],\n    [\n      \"pnpm\",\n      \"install\",\n      \"--frozen-lockfile\",\n      \"--ignore-scripts\"\n    ]\n  ],\n  \"common_commands\": [\n    [\n      \"cargo\",\n      \"run\",\n      \"--locked\",\n      \"-p\",\n      \"xtask\",\n      \"--\",\n      \"bindings\",\n      \"--check\"\n    ],\n    [\n      \"cargo\",\n      \"run\",\n      \"--locked\",\n      \"-p\",\n      \"xtask\",\n      \"--\",\n      \"ledger\",\n      \"--check\"\n    ],\n    [\n      \"cargo\",\n      \"run\",\n      \"--locked\",\n      \"-p\",\n      \"xtask\",\n      \"--\",\n      \"notices\",\n      \"--check\"\n    ],\n    [\n      \"pnpm\",\n      \"--filter\",\n      \"@prisma-airs/desktop-contracts\",\n      \"typecheck\"\n    ],\n    [\n      \"pnpm\",\n      \"--filter\",\n      \"@prisma-airs/desktop\",\n      \"typecheck\"\n    ],\n    [\n      \"pnpm\",\n      \"--filter\",\n      \"@prisma-airs/desktop\",\n      \"exec\",\n      \"vitest\",\n      \"run\",\n      \"--config\",\n      \"vitest.config.ts\"\n    ],\n    [\n      \"pnpm\",\n      \"--filter\",\n      \"@prisma-airs/desktop\",\n      \"build\"\n    ],\n    [\n      \"cargo\",\n      \"fmt\",\n      \"--all\",\n      \"--\",\n      \"--check\"\n    ],\n    [\n      \"cargo\",\n      \"clippy\",\n      \"--workspace\",\n      \"--locked\",\n      \"--all-targets\",\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_44","type":"command_execution","command":"/bin/zsh -lc \"sed -n '135,250p' apps/desktop/src/v2/wizard/wizard.tsx && sed -n '365,410p' apps/desktop/src/v2/wizard/wizard.tsx && cat apps/desktop/src/modules/tenants/dispatch.ts\"","aggregated_output":"    const [errors, setErrors] = useState<Record<string, string>>({})\n    const [touched, setTouched] = useState<Record<string, boolean>>({})\n    const savedProfile = setup ? { name: setup.tenant.label, environment: setup.tenant.environment, region: setup.tenant.destination.kind === 'region' ? setup.tenant.destination.region : 'unitedStates', tsg: setup.tenant.tsgId ?? '' } : null\n    // Displayed details that differ from the draft's, or are invalid, must be\n    // saved or reverted before anything downstream (R7): the core only ever\n    // verifies and commits what it holds.\n    const profileDirty = Boolean(savedProfile && (form.name.trim() !== savedProfile.name || form.environment !== savedProfile.environment || form.region !== savedProfile.region || form.tsg.trim() !== savedProfile.tsg))\n    const revertProfile = () => {\n        if (savedProfile) setForm(savedProfile)\n        setErrors({})\n        setTouched({})\n    }\n    const scanRef = useRef<HTMLInputElement>(null)\n    const secretRef = useRef<HTMLInputElement>(null)\n    const workspaceKeyRef = useRef<HTMLInputElement>(null)\n    useEffect(() => {\n        const fields = [scanRef.current, secretRef.current, workspaceKeyRef.current]\n        const clear = () => { for (const field of fields) if (field) field.value = '' }\n        clear()\n        return clear\n    }, [context])\n    const profileOf = () => ({ label: form.name.trim(), tsgId: form.tsg.trim(), destination: { kind: 'region' as const, region: form.region }, environment: form.environment })\n\n    // A draft creation that is in flight, or whose delivery was not confirmed,\n    // may still produce a draft: Cancel waits for it and discards what appears.\n    const createInFlight = useRef<Promise<DispatchOutcome> | null>(null)\n    // Mirrored in state so a settlement re-runs the cancel decision whatever\n    // order the receipt and the draft snapshot arrive in.\n    const [createPending, setCreatePending] = useState(false)\n    // An admitted creation whose draft has not been observed yet: the draft is\n    // coming, so a cancellation waits for it however long the snapshot takes.\n    const [createAdmitted, setCreateAdmitted] = useState(false)\n    const [createUnknown, setCreateUnknown] = useState<string | null>(null)\n    async function submitProfile(event: FormEvent<HTMLFormElement>) {\n        event.preventDefault()\n        const next = { name: fieldError('name', form.name), tsg: fieldError('tsg', form.tsg) }\n        setTouched({ name: true, tsg: true })\n        setErrors(next)\n        if (next.name || next.tsg) return\n        setBusy(true)\n        let outcome: DispatchOutcome\n        if (setup) outcome = await dispatch({ kind: 'updateTenantSetup', context: setup.context, profile: profileOf() })\n        else {\n            const promise = dispatch({ kind: 'beginTenantSetup', mode, profile: profileOf() })\n            createInFlight.current = promise\n            setCreatePending(true)\n            outcome = await promise\n            createInFlight.current = null\n            if (outcome.kind === 'unknown') setCreateUnknown(snapshot.revision)\n            if (outcome.kind === 'admitted') setCreateAdmitted(true)\n            setCreatePending(false)\n        }\n        setBusy(false)\n        report(outcome, setup ? C.tenant.updated : C.tenant.created(form.name.trim()), () => void submitProfile(event))\n    }\n    useEffect(() => {\n        // A later snapshot settles an unconfirmed creation either way; an admitted\n        // one is settled by the draft it produced.\n        if (createUnknown !== null && createUnknown !== snapshot.revision) setCreateUnknown(null)\n        if (createAdmitted && setup) setCreateAdmitted(false)\n    }, [createUnknown, createAdmitted, setup, snapshot.revision])\n\n    async function saveScanKey(event: FormEvent<HTMLFormElement>) {\n        event.preventDefault()\n        const field = scanRef.current\n        if (!field || !context) return\n        const key = field.value\n        field.value = ''\n        if (!key) return setErrors((e) => ({ ...e, scanKey: C.tenant.errors.scanKey }))\n        setErrors((e) => ({ ...e, scanKey: '' }))\n        setBusy(true)\n        report(await dispatch({ kind: 'configureScanCredential', context, mode: 'keychain', key }), C.tenant.keySaved)\n        setBusy(false)\n    }\n\n    async function saveClient(event: FormEvent<HTMLFormElement>) {\n        event.preventDefault()\n        const secretField = secretRef.current\n        if (!secretField || !context) return\n        const secret = secretField.value\n        secretField.value = ''\n        const clientId = String(new FormData(event.currentTarget).get('clientId') ?? '').trim()\n        if (!clientId) return setErrors((e) => ({ ...e, clientId: C.tenant.errors.clientId }))\n        if (!secret) return setErrors((e) => ({ ...e, clientSecret: C.tenant.errors.clientSecret }))\n        setErrors((e) => ({ ...e, clientId: '', clientSecret: '' }))\n        setBusy(true)\n        report(await dispatch({ kind: 'configureManagementCredential', context, mode: 'keychain', clientId, secret }), C.tenant.clientSaved)\n        setBusy(false)\n    }\n\n    async function remove(kind: 'removeScanCredential' | 'removeManagementCredential', ok: string) {\n        if (!context) return\n        setBusy(true)\n        report(await dispatch({ kind, context }), ok)\n        setBusy(false)\n    }\n\n    // ---- Gateway workspace (optional): list through the management client, choose, key ----\n    const [gatewayOn, setGatewayOn] = useState(false)\n    const [workspaces, setWorkspaces] = useState<{ id: string; name: string }[] | null>(null)\n    const [workspacesNote, setWorkspacesNote] = useState<string | null>(null)\n    const [workspace, setWorkspace] = useState<string>('')\n    // The chosen workspace is core state on the draft (its reference is what the key is configured under).\n    const chosen = setup?.workspace ?? null\n    const [endpoint, setEndpoint] = useState('')\n\n    async function listWorkspaces() {\n        if (!context) return\n        setWorkspacesNote(C.tenant.readingWorkspaces)\n        setWorkspaces(null)\n        const outcome = await readManagement(dispatch, props.observeManagement, context, { kind: 'gateway', workspace: null, read: { kind: 'inventory', resource: 'workspaces' } })\n        if (outcome.kind !== 'result') return setWorkspacesNote(outcome.kind === 'notAdmitted' ? outcome.message : C.outcome.failed)\n        const result = outcome.result\n        if (result.kind !== 'gateway' || result.gateway.kind !== 'list') return setWorkspacesNote(result.kind === 'failed' ? C.outcome.failed : C.tenant.noWorkspaces)\n        const rows = (JSON.parse(result.gateway.list.rows) as Record<string, unknown>[])\n            .filter((r) => typeof r.id === 'string')\n        setStatus({ text: `${C.cancelFailed} ${outcome.kind === 'refused' ? (outcomeMessage(outcome) ?? '') : C.outcome.failed}`.trim(), retry: () => void retryDiscard() })\n    }\n    async function retryDiscard() {\n        const current = latestSetup.current\n        if (!current) return props.onClose()\n        await discardNow(current.context)\n    }\n    async function cancel() {\n        // A close request while a discard is unconfirmed is the operator's retry.\n        if (cancelState === 'discarding') return retryDiscard()\n        if (cancelling) return\n        if (createInFlight.current || createUnknown !== null || createAdmitted) {\n            setCancelState('awaitingCreate')\n            if (createInFlight.current) {\n                const outcome = await createInFlight.current\n                // Nothing was created: close. Admitted or unconfirmed: the next snapshot decides.\n                if (outcome.kind === 'refused' || outcome.kind === 'failed') return props.onClose()\n            }\n            return\n        }\n        const current = latestSetup.current\n        if (!current) return props.onClose()\n        await discardNow(current.context)\n    }\n    useEffect(() => {\n        if (cancelState !== 'awaitingCreate' || createPending) return\n        if (setup) void discardNow(setup.context)\n        // An admitted creation's draft is still on its way: keep waiting for it.\n        else if (createAdmitted) return\n        else if (createUnknown === null) props.onClose()\n        // eslint-disable-next-line react-hooks/exhaustive-deps -- decided per settlement and snapshot\n    }, [cancelState, setup, createUnknown, createAdmitted, createPending, snapshot.revision])\n    const seenCloseRequests = useRef(props.closeRequests ?? 0)\n    useEffect(() => {\n        if ((props.closeRequests ?? 0) > seenCloseRequests.current) {\n            seenCloseRequests.current = props.closeRequests ?? 0\n            void cancel()\n        }\n        // eslint-disable-next-line react-hooks/exhaustive-deps -- a request is handled once\n    }, [props.closeRequests])\n    useEffect(() => {\n        // An unconfirmed discard that did go through shows up as the draft being gone.\n        if (cancelState === 'discarding' && !setup) props.onClose()\n    }, [cancelState, setup, props])\n    useEffect(() => {\n        // The draft's context changed (a credential or profile change): the core\nimport type { Intent, Refusal } from '@prisma-airs/desktop-contracts'\n\n/** What the presentation learned about one delivered intent. */\nexport type DispatchOutcome =\n    /** Admitted; `operation` names native work the intent started, if any. */\n    | { kind: 'admitted'; operation: string | null }\n    | { kind: 'refused'; refusal: Refusal }\n    /** The desktop did not confirm admission; the current state is shown. */\n    | { kind: 'unknown' }\n    | { kind: 'failed' }\n\nexport type Dispatch = (intent: Intent) => Promise<DispatchOutcome>\n\nconst REFUSAL_TEXT: Record<Refusal, string> = {\n    staleContext: 'The active tenant changed before this was applied. Check the current tenant and try again.',\n    capabilityMissing: 'That is not available for the current tenant.',\n    invalidInput: 'Check the entered values and try again.',\n    reviewInvalid: 'This review is no longer valid. Start a new review.',\n    reviewConsumed: 'This review was already used.',\n    busy: 'The desktop is busy with a previous request. Try again in a moment.',\n    lockedStore: 'The Keychain is locked. Unlock it and try again.',\n    deniedStore: 'Local desktop data or the credential store is not available.',\n    alreadyProcessed: 'That request was already processed.',\n    sequenceGap: 'The request was not delivered in order. Try again.',\n    shuttingDown: 'The desktop is shutting down.',\n    decisionPending: 'A Harness decision is pending; resolve it before switching tenants.',\n}\n\n/** Sanitized operator text for an outcome that did not apply. */\nexport function outcomeMessage(outcome: DispatchOutcome): string | null {\n    switch (outcome.kind) {\n        case 'admitted':\n            return null\n        case 'refused':\n            return REFUSAL_TEXT[outcome.refusal]\n        case 'unknown':\n            return 'The desktop did not confirm the request. The current state is shown; check it before trying again.'\n        case 'failed':\n            return 'The request could not be delivered.'\n    }\n}\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_45","type":"command_execution","command":"/bin/zsh -lc \"sed -n '1,240p' crates/xtask/src/env.rs && sed -n '1,165p' tools/p11/standing.py && sed -n '1,160p' tools/p11/test_standing.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_45","type":"command_execution","command":"/bin/zsh -lc \"sed -n '1,240p' crates/xtask/src/env.rs && sed -n '1,165p' tools/p11/standing.py && sed -n '1,160p' tools/p11/test_standing.py\"","aggregated_output":"//! The environment contract for controller commands.\n//!\n//! Every command starts from a cleared environment. Only the preserved\n//! identity variables, an explicit PATH of selected tool directories and the\n//! declared nonsecret build values are set. Inherited variables that could\n//! silently change compilation are refused outright, `.env` files fail the\n//! run, and the resolved tool identities (version output and executable\n//! hash) are recorded as dependency inputs.\n\nuse std::collections::BTreeMap;\nuse std::path::{Path, PathBuf};\nuse std::process::Command;\n\nuse serde::{Deserialize, Serialize};\n\nuse crate::{Repo, Result, invalid, io_err, read_json, sha256_hex};\n\n#[derive(Clone, Debug, Deserialize)]\n#[serde(deny_unknown_fields)]\nstruct ToolchainManifest {\n    schema_version: u32,\n    #[allow(dead_code)]\n    description: String,\n    path_dirs: Vec<String>,\n    tools: Vec<ToolSpec>,\n    declared_env: BTreeMap<String, String>,\n    preserve_unchanged: Vec<String>,\n    reject_inherited: Vec<String>,\n    reject_inherited_prefixes: Vec<String>,\n}\n\n#[derive(Clone, Debug, Deserialize)]\n#[serde(deny_unknown_fields)]\nstruct ToolSpec {\n    name: String,\n    argv: Vec<String>,\n    expect_prefix: String,\n}\n\n/// A resolved build tool.\n#[derive(Clone, Debug, PartialEq, Eq, Serialize, Deserialize)]\npub struct ToolIdentity {\n    pub name: String,\n    pub path: String,\n    pub version: String,\n    pub sha256: String,\n}\n\n/// The concrete environment commands run under.\n#[derive(Clone, Debug)]\npub struct Environment {\n    vars: BTreeMap<String, String>,\n    path_dirs: Vec<PathBuf>,\n    pub tools: Vec<ToolIdentity>,\n}\n\nimpl Environment {\n    /// Resolves the toolchain and verifies tool versions.\n    pub fn prepare(repo: &Repo) -> Result<Self> {\n        let spec: ToolchainManifest = read_json(&repo.toolchain_manifest())?;\n        if spec.schema_version != 1 {\n            return Err(invalid(\"unsupported toolchain.json schema_version\"));\n        }\n        refuse_inherited(&spec)?;\n        refuse_env_files(repo)?;\n        let home = std::env::var(\"HOME\").map_err(|_| invalid(\"HOME must be set\"))?;\n        let path_dirs: Vec<PathBuf> = spec\n            .path_dirs\n            .iter()\n            .map(|dir| expand(dir, &home, repo.root()))\n            .collect();\n        let mut vars = BTreeMap::new();\n        for name in &spec.preserve_unchanged {\n            if let Ok(value) = std::env::var(name) {\n                vars.insert(name.clone(), value);\n            }\n        }\n        for (name, value) in &spec.declared_env {\n            if vars.contains_key(name) {\n                return Err(invalid(format!(\"{name} is both preserved and declared\")));\n            }\n            vars.insert(name.clone(), value.clone());\n        }\n        let joined = path_dirs\n            .iter()\n            .map(|p| p.display().to_string())\n            .collect::<Vec<_>>()\n            .join(\":\");\n        vars.insert(\"PATH\".to_owned(), joined);\n        let mut env = Self {\n            vars,\n            path_dirs,\n            tools: Vec::new(),\n        };\n        for tool in &spec.tools {\n            env.tools.push(env.identify(tool, repo.root())?);\n        }\n        // rustc/cargo in PATH are rustup shims; also bind the selected\n        // toolchain's actual executables.\n        for name in [\"rustc\", \"cargo\"] {\n            let argv = vec![\"rustup\".to_owned(), \"which\".to_owned(), name.to_owned()];\n            let output = env\n                .command(&argv, repo.root())?\n                .output()\n                .map_err(io_err(repo.root()))?;\n            let path = PathBuf::from(String::from_utf8_lossy(&output.stdout).trim());\n            if !output.status.success() || !path.is_file() {\n                return Err(invalid(format!(\n                    \"rustup cannot resolve the selected {name}\"\n                )));\n            }\n            let bytes = std::fs::read(&path).map_err(io_err(&path))?;\n            env.tools.push(ToolIdentity {\n                name: format!(\"{name}-toolchain\"),\n                path: path.display().to_string(),\n                version: String::new(),\n                sha256: sha256_hex(&bytes),\n            });\n        }\n        Ok(env)\n    }\n\n    fn identify(&self, tool: &ToolSpec, cwd: &Path) -> Result<ToolIdentity> {\n        let program = self.resolve(&tool.argv[0])?;\n        let output = self\n            .command(&tool.argv, cwd)?\n            .output()\n            .map_err(io_err(&program))?;\n        let version = String::from_utf8_lossy(&output.stdout).trim().to_owned();\n        if !output.status.success() || !version.starts_with(&tool.expect_prefix) {\n            return Err(invalid(format!(\n                \"{} reports {version:?}; expected prefix {:?}\",\n                tool.name, tool.expect_prefix\n            )));\n        }\n        let bytes = std::fs::read(&program).map_err(io_err(&program))?;\n        Ok(ToolIdentity {\n            name: tool.name.clone(),\n            path: program.display().to_string(),\n            version,\n            sha256: sha256_hex(&bytes),\n        })\n    }\n\n    /// Finds a program in the selected PATH (never the caller's PATH).\n    pub fn resolve(&self, program: &str) -> Result<PathBuf> {\n        if program.contains('/') {\n            return Err(invalid(format!(\"program must be a bare name: {program}\")));\n        }\n        self.path_dirs\n            .iter()\n            .map(|dir| dir.join(program))\n            .find(|candidate| candidate.is_file())\n            .ok_or_else(|| {\n                invalid(format!(\n                    \"{program} not found in the selected toolchain PATH\"\n                ))\n            })\n    }\n\n    /// Builds a process for an argv under this environment.\n    pub fn command(&self, argv: &[String], cwd: &Path) -> Result<Command> {\n        let program = argv\n            .first()\n            .ok_or_else(|| invalid(\"empty argv\"))\n            .and_then(|p| self.resolve(p))?;\n        let mut command = Command::new(program);\n        command.args(&argv[1..]).current_dir(cwd).env_clear();\n        for (name, value) in &self.vars {\n            command.env(name, value);\n        }\n        Ok(command)\n    }\n\n    /// Adds a declared value for specific commands (never secrets).\n    pub fn with(mut self, name: &str, value: &str) -> Self {\n        self.vars.insert(name.to_owned(), value.to_owned());\n        self\n    }\n\n    /// Nonsecret effective variables recorded with each run. Identity values\n    /// (HOME/USER/LOGNAME) are recorded by name only.\n    pub fn recorded_vars(&self) -> BTreeMap<String, String> {\n        self.vars\n            .iter()\n            .map(|(name, value)| {\n                let shown = if matches!(name.as_str(), \"HOME\" | \"USER\" | \"LOGNAME\" | \"TMPDIR\") {\n                    \"<preserved>\".to_owned()\n                } else {\n                    value.clone()\n                };\n                (name.clone(), shown)\n            })\n            .collect()\n    }\n\n    /// Hash of the toolchain identities, part of the dependency fingerprint.\n    pub fn toolchain_hash(&self) -> String {\n        let text = self\n            .tools\n            .iter()\n            .map(|t| format!(\"{}\\0{}\\0{}\\n\", t.name, t.version, t.sha256))\n            .collect::<String>();\n        sha256_hex(text.as_bytes())\n    }\n}\n\nfn expand(dir: &str, home: &str, repo: &Path) -> PathBuf {\n    if let Some(rest) = dir.strip_prefix(\"$HOME\") {\n        PathBuf::from(format!(\"{home}{rest}\"))\n    } else if let Some(rest) = dir.strip_prefix(\"{repo}\") {\n        PathBuf::from(format!(\"{}{rest}\", repo.display()))\n    } else {\n        PathBuf::from(dir)\n    }\n}\n\nfn refuse_inherited(spec: &ToolchainManifest) -> Result<()> {\n    // A variable already equal to its declared value (for example inside a\n    // nested controller command) is not an override.\n    let mut offending: Vec<String> = std::env::vars_os()\n        .filter_map(|(name, value)| Some((name.into_string().ok()?, value.into_string().ok())))\n        .filter(|(name, value)| spec.declared_env.get(name).map(String::as_str) != value.as_deref())\n        .map(|(name, _)| name)\n        .filter(|name| {\n            spec.reject_inherited.contains(name)\n                || spec\n                    .reject_inherited_prefixes\n                    .iter()\n                    .any(|prefix| name.starts_with(prefix.as_str()))\n        })\n        .collect();\n    offending.sort();\n    if offending.is_empty() {\n        Ok(())\n    } else {\n        Err(invalid(format!(\n            \"refusing undeclared inherited overrides: {}\",\n            offending.join(\", \")\n        )))\n\"\"\"Durable, audited P11 standing for later production promotion.\n\nFinalization consumes completed executions and five real full-9 reviews. It\nnever assigns a score or completes a controller ledger. Historical validation\nuses the archived source/application, not this checkout's ignored target tree,\ninstalled application, toolchain, hostname, or current application source.\n\"\"\"\nfrom pathlib import Path\nimport json\nimport shutil\nimport subprocess\nimport sys\n\nsys.path.insert(0, str(Path(__file__).resolve().parent))\nsys.path.insert(0, str(Path(__file__).resolve().parents[1] / 'p10'))\nfrom candidate import bundle_hash, digest, file_identity\nfrom historical import Historical\nfrom qualification import bound, read, require, sha, verify as verify_coverage\nfrom review_gate import actual_review, release_prerequisites\n\nCHUNKS = ('C46', 'C47', 'C48', 'C49')\nSUBJECTS = (*CHUNKS, 'P11')\nBASE = Path('docs/planning/evidence/P11')\nACCEPTED = BASE / 'accepted'\nCOMPLETION = BASE / 'completion-proof.json'\nD2_SOURCE = BASE / 'source-history/D2'\nS2_SOURCE = BASE / 'source-history/S2'\nLFS_PATHS = (str(S2_SOURCE / 'resources/harness/darwin-arm64.tar.gz'),\n             str(D2_SOURCE / 'resources/harness/darwin-arm64.tar.gz'),\n             str(ACCEPTED / 'application/Contents/MacOS/prisma-airs-desktop'),\n             str(ACCEPTED / 'application/Contents/Resources/harness/airs-harness'),\n             str(ACCEPTED / 'source/resources/harness/darwin-arm64.tar.gz'))\n\n\nclass ArchivedP11(Historical):\n    \"\"\"Explicit P11 archive context; historical C45 behavior is untouched.\"\"\"\n    def archive_path(self, name):\n        path = self.root / name\n        require(path.resolve().is_relative_to((self.root / ACCEPTED).resolve())\n                or path.resolve() in ((self.root / D2_SOURCE).resolve(), (self.root / S2_SOURCE).resolve()),\n                'historical archive escapes accepted P11 evidence')\n        return path\n\n\ndef reference(root, path):\n    root = Path(root).resolve()\n    path = Path(path).resolve(strict=True)\n    require(path.is_relative_to(root.resolve()), 'P11 reference escapes checkout')\n    return {'path': str(path.relative_to(root)), 'sha256': sha(path)}\n\n\ndef identities(root, paths):\n    return {str(path.relative_to(root)): file_identity(path) for path in sorted(set(paths))}\n\n\ndef evidence_files(root, attempts):\n    paths = [p for p in (root / BASE).rglob('*')\n             if (p.is_file() or p.is_symlink()) and not p.is_relative_to(root / ACCEPTED)\n             and p != root / COMPLETION and '__pycache__' not in p.parts]\n    for subject, attempt in attempts.items():\n        paths.extend(p for p in (root / 'docs/planning/reviews' / subject / attempt).rglob('*')\n                     if (p.is_file() or p.is_symlink()) and '__pycache__' not in p.parts)\n    return paths\n\n\ndef latest_attempt(root, subject):\n    attempts = [p.name for p in (root / 'docs/planning/reviews' / subject).glob('attempt-*')\n                if p.is_dir() and p.name.removeprefix('attempt-').isdigit()]\n    require(attempts, 'missing actual P11 member/phase review: ' + subject)\n    return max(attempts, key=lambda name: int(name.removeprefix('attempt-')))\n\n\ndef require_archive_lfs(root):\n    result = subprocess.run(['/usr/bin/git', 'check-attr', '-z', 'filter', '--', *LFS_PATHS],\n                            cwd=root, capture_output=True, check=True)\n    fields = result.stdout.decode().strip('\\0').split('\\0')\n    require(len(fields) == len(LFS_PATHS) * 3\n            and all(fields[i:i+3] == [name, 'filter', 'lfs'] for i, name in zip(range(0, len(fields), 3), LFS_PATHS)),\n            'configure reviewed P11 archive Git LFS paths before finalization')\n\n\ndef audited_reviews(root, attempts, qualified, source):\n    root = Path(root).resolve()\n    require(set(attempts) == set(SUBJECTS), 'P11 requires exactly four member reviews and its phase review')\n    reviews = {}\n    for subject in SUBJECTS:\n        attempt = attempts[subject]\n        require(attempt == latest_attempt(root, subject), 'newer review attempt exists: ' + subject)\n        request = read(root / 'docs/planning/reviews' / subject / attempt / 'request.json')\n        require(request['qualification'] == qualified,\n                'P11 reviews do not bind one shared qualification: ' + subject)\n        reviews[subject] = actual_review(root, subject, attempt, source_root=source)\n        require(all(value >= 9 for value in reviews[subject]['scores'].values()),\n                'P11 promotion requires full-9 reviewed standing: ' + subject)\n    phase = read(root / 'docs/planning/reviews/P11' / attempts['P11'] / 'request.json')\n    require(phase['predecessors']['members'] == {name: reviews[name] for name in CHUNKS},\n            'phase review did not consume these exact four audited member reviews')\n    require(all(row['fingerprints']['source'] == qualified['verified']['source_inventory_sha256']\n                for row in reviews.values()), 'reviews bind a foreign qualified source')\n    return reviews\n\n\ndef verify(root):\n    \"\"\"Verify immutable historical standing; no current build directory needed.\"\"\"\n    root = Path(root).resolve()\n    path = root / COMPLETION\n    require(path.is_file(), 'P11 promotion requires actual accepted standing: ' + str(COMPLETION))\n    record = read(path)\n    require(record['schema'] == 'airs-desktop/p11-completion-proof/1'\n            and record['controller_complete'] is False, 'P11 standing schema/controller claim')\n    require(record['context']['path'] == str(ACCEPTED / 'historical-context.json'),\n            'P11 standing context is foreign')\n    history = ArchivedP11(root, record['context'])\n    qualified = record['qualification']\n    original = read(bound(root, {'path': qualified['record'], 'sha256': qualified['sha256']}))\n    require(original['schema'] == 'airs-desktop/p11-shared-qualification/1', 'foreign P11 qualification')\n    coverage = read(bound(root, original['coverage']))\n    source_hash = coverage['source_inventory_sha256']\n    source = history.source(source_hash)\n    seal = read(bound(root, original['source']))\n    require(digest(seal['files']) == source_hash, 'original P11 source seal differs')\n    import proof\n    result = proof.verify_coverage(root, coverage, historical=history)\n    require(result == qualified['verified'], 'archived P11 raw qualification differs')\n    candidate = read(bound(root, coverage['candidate']))\n    from candidate import verify_candidate\n    verify_candidate(root, candidate, historical=history)\n    require(coverage['candidate']['sha256'] == qualified['candidate_sha256'],\n            'P11 accepted candidate reference differs')\n    proof.validate_execution(root, read(bound(root, original['native_execution'])), candidate,\n        acceptance=bound(root, original['native_acceptance']) if 'native_acceptance' in original else None,\n        execution=bound(root, original['native_execution']))\n    inventory = read(bound(root, record['evidence']))['files']\n    require(inventory, 'P11 raw evidence inventory missing')\n    require(set(inventory) == {str(p.relative_to(root)) for p in evidence_files(root, record['attempts'])},\n            'P11 retained evidence membership differs')\n    for name, identity in inventory.items():\n        target = root / name\n        require(target.resolve().is_relative_to(root), 'P11 evidence escapes checkout')\n        require(file_identity(target) == identity,\n                'P11 retained evidence drift (hydrate pinned LFS objects if needed): ' + name)\n    reviews = audited_reviews(root, record['attempts'], qualified, source)\n    require(reviews == record['reviews'], 'P11 audited review standing changed')\n    baseline = release_prerequisites(root)\n    require(record['historical_standing'] == original['historical_standing'] == baseline,\n            'P11 historical baseline standing differs')\n    return {'schema': 'airs-desktop/p11-promotion-prerequisites/1',\n            'record': str(COMPLETION), 'sha256': sha(path),\n            'qualification': qualified, 'reviews': reviews, 'controller_complete': False}\n\n\ndef finalize(root, qualification_path, attempts):\n    \"\"\"Archive only after actual reviews; refuse every existing output path.\n\n    Large files under accepted/application and accepted/source/resources/harness\n    must have their reviewed explicit Git LFS rules before the qualified seal.\n    This function never runs a test, native driver, build, signing or publication.\n    \"\"\"\n    root = Path(root).resolve()\n    destination, completion = root / ACCEPTED, root / COMPLETION\n    require(not destination.exists() and not completion.exists(), 'preserve existing accepted P11 archive')\n    require_archive_lfs(root)\n    import proof\n    qualified = proof.verify(root, Path(qualification_path).resolve())\n    reviews = audited_reviews(root, attempts, qualified, root)\n\"\"\"Synthetic validator fixtures only; no app, review session, or UI is run.\n\nThe existing audited-review transport and legacy phase consumer are substituted\nat their boundary. Source/application/coverage/raw-evidence checks run for real.\n\"\"\"\nfrom pathlib import Path\nimport copy\nimport json\nimport subprocess\nimport tempfile\nimport unittest\nfrom unittest.mock import patch\n\nimport standing as s\nimport proof\n\n\nclass StandingTests(unittest.TestCase):\n    def setUp(self):\n        self.directory = tempfile.TemporaryDirectory()\n        self.addCleanup(self.directory.cleanup)\n        self.root = Path(self.directory.name).resolve()\n        self.source = self.root / s.ACCEPTED / 'source'\n        self.source.mkdir(parents=True)\n        self.attempts = {name: 'attempt-01' for name in s.SUBJECTS}\n        self.baseline = {'fixture': 'previous independently audited standing'}\n\n        def write(path, value):\n            path = self.root / path\n            path.parent.mkdir(parents=True, exist_ok=True)\n            path.write_text(json.dumps(value) + '\\n')\n            return s.reference(self.root, path)\n        self.write = write\n        self.helper = 'tools/native-acceptance/acceptance_p11.py'\n        helper = self.source / self.helper\n        helper.parent.mkdir(parents=True)\n        helper.write_text('# synthetic archival fixture; never executed\\n')\n        manifests = self.source / 'docs/architecture'\n        manifests.mkdir(parents=True)\n        manifest = {'setup_commands': [], 'phases': {'P11': list(s.CHUNKS)}, 'chunks': {}}\n        natives = {'chunks': {}}\n        for name in s.CHUNKS:\n            manifest['chunks'][name] = {'check_commands': [['fixture-check', name]],\n                'fixture_command': ['cargo', 'test', '--test', name]}\n            natives['chunks'][name] = [{'id': f'{name}-N{i:02}', 'check': 'validator fixture'} for i in range(1, 4)]\n        (manifests / 'checks.json').write_text(json.dumps(manifest))\n        (manifests / 'native-checks.json').write_text(json.dumps(natives))\n        files = {str(p.relative_to(self.source)): s.file_identity(p)\n                 for p in self.source.rglob('*') if p.is_file()}\n        self.source_hash = s.digest(files)\n        seal = write(s.ACCEPTED / 'source-seal.json', {'files': files})\n        app = self.root / s.ACCEPTED / 'application'\n        exe = app / 'Contents/MacOS/prisma-airs-desktop'\n        exe.parent.mkdir(parents=True)\n        exe.write_text('synthetic candidate bytes; never executed')\n        self.bundle = app\n        bundle_hash = s.bundle_hash(app)\n        self.context = write(s.ACCEPTED / 'historical-context.json', {\n            'schema': 'airs-desktop/historical-qualification-context/1',\n            'sources': {self.source_hash: {'path': str(self.source.relative_to(self.root)), 'seal': seal}},\n            'applications': {bundle_hash: {'path': str(app.relative_to(self.root)), 'executable_sha256': s.sha(exe)}}})\n        prepared = write(s.BASE / 'fixture/prepare.json', {'bundle': 'target/never-present.app',\n            'executable_sha256': s.sha(exe), 'bundle_sha256': bundle_hash})\n        inputs = {'source': 'synthetic-original-runner-source', 'dependencies': 'synthetic-deps', 'build_flags': 'synthetic-flags'}\n        candidate = {'source_inventory_sha256': self.source_hash, 'execution_root': '/original/qualification-host',\n            'runner_inputs': inputs, 'prepare': prepared, 'executable_sha256': s.sha(exe),\n            'bundle_sha256': bundle_hash, 'build_flags': {'target': 'synthetic-arm64'},\n            'conditions': {'platform': 'original-fixture-platform'}, 'helper_closure': {self.helper: s.sha(helper)}}\n        candidate_ref = write(s.BASE / 'fixture/candidate.json', candidate)\n        execution = {'status': 'observed', 'exit_code': 0,\n            'argv': ['python3', 'tools/native-acceptance/acceptance_p11.py'],\n            'executable_sha256': candidate['executable_sha256'], 'bundle_sha256': bundle_hash,\n            'helper_closure': candidate['helper_closure'], 'execution_id': 'fixture-native',\n            'started_utc': 'fixture-start', 'finished_utc': 'fixture-finish'}\n        execution_ref = write(s.BASE / 'fixture/native-execution.json', execution)\n        self.requirements, rows = [], []\n        for kind in ('check', 'test'):\n            commands = []\n            needed_commands = proof.command_plan(self.source, kind)\n            raw_path = s.BASE / f'fixture/{kind}/run.json'\n            for needed in needed_commands:\n                label = needed['label']\n                relative_log = 'logs/' + label.replace('/', '-') + '.log'\n                log = self.root / raw_path.parent / relative_log\n                log.parent.mkdir(parents=True, exist_ok=True)\n                log.write_text('Synthetic guard fixture only, never an application test pass.\\n')\n                commands.append({'label': label, 'argv': needed['argv'], 'cwd': '.', 'status': 'passed',\n                    'exit_code': 0, 'note': None, 'log': relative_log, 'output_sha256': s.sha(log),\n                    'tests': {'passed': 1, 'failed': 0} if needed['expects_tests'] else None})\n            raw_ref = write(raw_path, {'schema': 'airs-v2/run/1', 'status': 'passed', 'failure': None,\n                'inputs_before': inputs, 'inputs_after': inputs, 'commands': commands})\n            for needed, command in zip(needed_commands, commands):\n                cid = kind + ':' + needed['label']\n                self.requirements.append(dict(id=cid, kind='command', affected=True, must_execute=True, **needed))\n                result = {'status': 'pass', 'exit_code': 0, 'execution_id': 'fixture-' + cid,\n                    'argv': needed['argv'], 'cwd': candidate['execution_root'], 'started_utc': 'fixture-start',\n                    'finished_utc': 'fixture-finish', 'required_ids': [cid], 'raw': raw_ref,\n                    'log': s.reference(self.root, self.root / raw_path.parent / command['log']),\n                    'candidate': candidate_ref, 'evidence': {}}\n                result_ref = write(s.BASE / 'fixture/results' / (cid.replace('/', '-') + '.json'), result)\n                rows.append({'id': cid, 'disposition': 'executed', 'result': result_ref})\n        native_ids = [row['id'] for name in s.CHUNKS for row in natives['chunks'][name]]\n        native_ref = write(s.BASE / 'fixture/native.json', {'schema': 'airs-v2/native-acceptance/1',\n            'app': {'executable_sha256': candidate['executable_sha256']},\n            'checks': [{'id': cid, 'result': 'pass', 'observation': 'synthetic validator fixture',\n                        'evidence': [execution_ref['path']]} for cid in native_ids]})\n        for cid in native_ids:\n            self.requirements.append({'id': cid, 'kind': 'native', 'argv': execution['argv'],\n                                      'affected': True, 'must_execute': True})\n            result_ref = write(s.BASE / 'fixture/results' / (cid + '.json'), {\n                'status': 'pass', 'exit_code': 0, 'execution_id': 'fixture-native', 'argv': execution['argv'],\n                'cwd': candidate['execution_root'], 'started_utc': 'fixture-start', 'finished_utc': 'fixture-finish',\n                'required_ids': [cid], 'raw': native_ref, 'log': execution_ref, 'candidate': candidate_ref,\n                'evidence': {execution_ref['path']: execution_ref['sha256']}})\n            rows.append({'id': cid, 'disposition': 'executed', 'result': result_ref})\n        plan = write(s.BASE / 'fixture/plan.json', {'schema': 'airs-desktop/required-coverage/1',\n                                                   'requirements': self.requirements})\n        coverage = {'schema': 'airs-desktop/qualified-coverage/1', 'plan': plan, 'candidate': candidate_ref,\n                    'source_inventory_sha256': self.source_hash, 'coverage': rows}\n        coverage_ref = write(s.BASE / 'fixture/coverage.json', coverage)\n        self.qualified = {'record': str(s.BASE / 'fixture/qualification.json'), 'sha256': None,\n            'verified': s.verify_coverage(self.root, coverage), 'candidate_sha256': candidate_ref['sha256'],\n            'controller_complete': False}\n        original = write(self.qualified['record'], {'schema': 'airs-desktop/p11-shared-qualification/1',\n            'coverage': coverage_ref, 'source': seal, 'native_execution': execution_ref, 'historical_standing': self.baseline})\n        self.qualified['sha256'] = original['sha256']\n        self.reviews = {name: {'subject': name, 'attempt': 'attempt-01',\n            'fingerprints': {'source': self.source_hash},\n            'scores': {k: 9 for k in ('architecture', 'behavior', 'authority_security', 'validation', 'overall')}}\n            for name in s.SUBJECTS}\n        for name in s.SUBJECTS:\n            write(Path('docs/planning/reviews') / name / 'attempt-01/request.json', {\n                'qualification': self.qualified, 'predecessors': {'members': {c: self.reviews[c] for c in s.CHUNKS}}})\n        evidence = write(s.ACCEPTED / 'evidence-inventory.json', {\n            'files': s.identities(self.root, s.evidence_files(self.root, self.attempts))})\n        self.record = {'schema': 'airs-desktop/p11-completion-proof/1', 'controller_complete': False,\n            'context': self.context, 'qualification': self.qualified, 'attempts': self.attempts,\n            'reviews': self.reviews, 'historical_standing': self.baseline, 'evidence': evidence}\n        write(s.COMPLETION, self.record)\n        self.review_mock = patch.object(s, 'actual_review', side_effect=lambda root, subject, attempt, **kw: copy.deepcopy(self.reviews[subject])).start()\n        self.addCleanup(patch.stopall)\n        patch.object(s, 'release_prerequisites', return_value=self.baseline).start()\n\n    def test_archived_standing_needs_neither_target_nor_current_source(self):\n        self.assertFalse((self.root / 'target').exists())\n        (self.root / 'future-source.rs').write_text('unrelated subsequent release work')\n        result = s.verify(self.root)\n        self.assertFalse(result['controller_complete'])\n        self.assertEqual(self.review_mock.call_count, 5)\n\n    def test_missing_standing_and_foreign_context_rejected(self):\n        completion = self.root / s.COMPLETION\n        completion.unlink()\n        with self.assertRaisesRegex(ValueError, 'actual accepted standing'):\n            s.verify(self.root)\n        self.write(s.COMPLETION, dict(self.record, context=dict(self.context, path='foreign/context.json')))\n        with self.assertRaisesRegex(ValueError, 'context is foreign'):\n            s.verify(self.root)\n\n    def test_source_and_bundle_drift_rejected(self):\n","exit_code":0,"status":"completed"}}
