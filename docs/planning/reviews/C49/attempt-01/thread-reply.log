\",\n      \"vitest\",\n      \"run\",\n      \"--config\",\n      \"vitest.config.ts\",\n      \"src/shell/appearance.test.ts\",\n      \"src/shell/palette-contrast.test.ts\",\n      \"src/v2/settings/refinement-settings.test.tsx\",\n      \"src/modules/tenants/credential-entry.test.tsx\",\n      \"src/modules/tenants/reset.test.tsx\",\n      \"src/modules/academy/academy-account.test.tsx\",\n      \"src/shell/academy-theme-boundary.test.ts\"\n    ],\n    [\n      \"pnpm\",\n      \"--filter\",\n      \"@prisma-airs/desktop\",\n      \"exec\",\n      \"vitest\",\n      \"run\",\n      \"--config\",\n      \"vitest.config.ts\",\n      \"src/v2/settings/management-credential.test.tsx\"\n    ],\n    [\n      \"pnpm\",\n      \"--filter\",\n      \"@prisma-airs/desktop\",\n      \"exec\",\n      \"vitest\",\n      \"run\",\n      \"--config\",\n      \"vitest.config.ts\",\n      \"src/modules/diagnostics/diagnostics-panel.test.tsx\"\n    ],\n    [\n      \"pnpm\",\n      \"--filter\",\n      \"@prisma-airs/desktop\",\n      \"exec\",\n      \"vitest\",\n      \"run\",\n      \"--config\",\n      \"vitest.config.ts\",\n      \"src/v2/academy/academy.test.tsx\"\n    ]\n  ]\n}\n[\n  {\n    \"id\": \"C49-N01\",\n    \"check\": \"Settings uses compact Appearance, Academy and Diagnostics cards, with a dedicated Tenant section containing Scan Key, Management Client, Scan Destination, Update Tenant and Add Tenant cards. Controls remain keyboard-accessible and usable at narrow width/200% zoom.\"\n  },\n  {\n    \"id\": \"C49-N02\",\n    \"check\": \"Independent Appearance and Theme dropdowns provide Prisma AIRS default and Gruvbox light/dark. Existing Appearance survives restart; alternate theme persists. Representative shell/product, learner and portaled surfaces retain contrast/focus and Academy-owned cosmetics; desktop theme grants no earned skin.\"\n  },\n  {\n    \"id\": \"C49-N03\",\n    \"check\": \"Credential cards preserve secure/session choices and Replace/Remove; sec