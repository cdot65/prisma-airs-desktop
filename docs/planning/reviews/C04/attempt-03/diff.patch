+            }),
+            F::InvalidConfig,
+        ),
+        (
+            Box::new(|s| s.metadata_issuer = Some("https://evil.example".into())),
+            F::InvalidConfig,
+        ),
+        (
+            Box::new(|s| s.token_endpoint = Some("https://evil.example/oauth/token".into())),
+            F::InvalidConfig,
