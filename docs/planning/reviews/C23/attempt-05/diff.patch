+    // The folder no longer allows removing its files.
+    std::fs::set_permissions(&logs, std::fs::Permissions::from_mode(0o500)).expect("deny");
+    desk.send(json!({"kind": "clearDiagnostics"}))
+        .await
+        .expect("admitted");
