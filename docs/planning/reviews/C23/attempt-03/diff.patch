+    assert_eq!(desk.receipt()["state"], "rolledBack");
+    assert!(v1_tenant_ids(&desk).is_empty());
+    assert!(desk.send(create_later()).await.is_ok());
+
+    // Both copies damaged: nothing says what it wrote, so what imports write
