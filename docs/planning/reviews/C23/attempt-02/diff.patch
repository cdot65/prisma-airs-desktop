+                {"id": SCRATCH, "name": "Scratch", "environment": "lab", "tsg_id": "",
+                 "storage": "session", "credential_ref": null},
+                {"id": "acade001-0000-4000-8000-000000000001", "name": "Academy Sandbox",
+                 "environment": "Simulated learning lab", "tsg_id": "", "storage": "session",
+                 "credential_ref": null}
