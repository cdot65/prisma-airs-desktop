+def run(cmd):
+    try:
+        p = subprocess.run(cmd, cwd=REPO, env=ENV, capture_output=True, text=True, timeout=900)
+    except subprocess.TimeoutExpired:
+        return "timeout", ""
+    return p.returncode, p.stdout + p.stderr
+
