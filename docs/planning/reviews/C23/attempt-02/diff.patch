+//! What v1 has (inspection: files only) and what the operator's selection
+//! reads of it (planning: the selected protected items). Destination checks
+//! (already present, conflict, full) are the authority's, against v2's
+//! owners.
+
+use serde::Serialize;
+use sha2::{Digest, Sha256};
+use ts_rs::TS;
+use zeroize::Zeroizing;
+
+use super::parse::{self, V1Snapshot, V1Tenant, V1Tenants};
+use super::source::{self, V1Source};
+use super::{Category, Problem};
+use crate::tenants::{Destination, Region};
+
+/// Inspection's view of v1's folder.
+#[derive(Clone, Copy, Debug, PartialEq, Eq, Serialize, TS)]
+#[serde(rename_all = "camelCase")]
+pub enum SourceState {
+    /// No v1 folder on this Mac.
+    NotFound,
+    /// v1 is running: close it first.
+    Locked,
+    /// The folder or its tenants could not be read.
+    Unavailable,
+    Ready,
+}
+
+/// One v1 tenant as inspection shows it (no secret, no Keychain read).
+#[derive(Clone, Debug, PartialEq, Eq, Serialize, TS)]
+#[serde(rename_all = "camelCase")]
+pub struct V1TenantView {
+    pub index: u32,
+    pub label: String,
+    pub tsg_id: Option<String>,
+    /// Session-only in v1: nothing of it was stored.
+    pub session_only: bool,
+}
+
+/// A category as inspection sees it: what files show, or why not.
+#[derive(Clone, Debug, PartialEq, Eq, Serialize, TS)]
+#[serde(rename_all = "camelCase")]
+pub struct CategoryView {
+    pub category: Category,
+    /// Items found in files; `None` when only a protected read can tell.
+    pub found: Option<u32>,
+    pub problem: Option<Problem>,
+}
+
+pub struct Inventory {
+    pub state: SourceState,
+    pub tenants: Option<V1Tenants>,
+    pub categories: Vec<CategoryView>,
+    /// v1's settings with no v2 equivalent (shown, never read).
+    pub not_mapped: Vec<String>,
+}
+
+fn tsg(tenant: &V1Tenant) -> Option<String> {
+    let t = tenant.tsg_id.trim();
+    (!t.is_empty()).then(|| t.to_owned())
+}
+
+impl Inventory {
+    pub fn tenant_views(&self) -> Vec<V1TenantView> {
+        self.tenants
+            .iter()
+            .flat_map(|t| t.tenants.iter())
+            .enumerate()
+            .map(|(i, t)| V1TenantView {
+                index: u32::try_from(i).unwrap_or(u32::MAX),
+                label: t.name.clone(),
+                tsg_id: tsg(t),
+                session_only: t.storage == parse::V1Storage::Session,
+            })
+            .collect()
+    }
+}
+
+/// Reads v1's folder without touching its Keychain.
+pub fn inventory(src: &V1Source) -> Inventory {
+    let none = |state| Inventory {
+        state,
+        tenants: None,
+        categories: Vec::new(),
+        not_mapped: Vec::new(),
+    };
+    match source::root_state(&src.root) {
+        Ok(()) => {}
+        Err(Problem::Missing) => return none(SourceState::NotFound),
+        Err(_) => return none(SourceState::Unavailable),
+    }
+    let lock = match source::lock(&src.root) {
+        Ok(lock) => lock,
+        Err(Problem::SourceLocked) => return none(SourceState::Locked),
+        Err(_) => return none(SourceState::Unavailable),
+    };
+    let tenants = source::read_file(&src.root, &[parse::TENANTS_FILE], parse::TENANTS_LIMIT)
+        .and_then(|b| parse::tenants(&b));
+    let mut categories = Vec::new();
+    let mut view = |category, found: Result<Option<u32>, Problem>| {
+        categories.push(CategoryView {
+            category,
+            found: found.as_ref().ok().copied().flatten(),
+            problem: found.err(),
+        });
+    };
+    let count = |n: usize| Some(u32::try_from(n).unwrap_or(u32::MAX));
+    let listed = tenants.as_ref().map_err(|p| *p);
+    view(Category::Tenants, listed.map(|t| count(t.tenants.len())));
+    view(Category::Endpoints, listed.map(|_| None));
+    view(
+        Category::Settings,
+        file_present(src, parse::APPEARANCE_FILE).and_then(|p| {
+            if p {
+                Ok(Some(1))
+            } else {
+                Err(Problem::Missing)
+            }
+        }),
+    );
+    view(Category::Cases, listed.map(|_| None));
+    view(
+        Category::Reports,
+        source::read_file(&src.root, &[parse::REPORTS_FILE], parse::REPORTS_LIMIT)
+            .and_then(|b| parse::reports(&b))
+            .map(|r| count(r.iter().map(|t| t.reports.len() + t.unfit).sum())),
+    );
+    view(
+        Category::AcademyDrafts,
+        source::list(
+            &src.root,
+            &[parse::ACADEMY_DIR],
+            true,
+            256,
+            parse::is_digest,
+        )
+        .map(|d| count(d.len())),
+    );
+    view(
+        Category::ApiClient,
+        crate::workbench::adoption::read(&src.root.join("api-client"))
+            .map(|c| count(c.len()))
+            .map_err(|p| match p {
+                crate::workbench::adoption::AdoptionProblem::Missing => Problem::Missing,
+                crate::workbench::adoption::AdoptionProblem::Unreadable => Problem::Corrupt,
+            }),
+    );
+    view(Category::Conversations, listed.map(|_| None));
+    let mut not_mapped = Vec::new();
+    if file_present(src, parse::NAVIGATION_FILE) == Ok(true) {
+        not_mapped.push("navigation".to_owned());
+    }
+    drop(lock);
+    Inventory {
+        state: if tenants.is_ok() || matches!(tenants, Err(Problem::Missing)) {
+            SourceState::Ready
+        } else {
+            SourceState::Unavailable
+        },
+        tenants: tenants.ok(),
+        categories,
+        not_mapped,
+    }
+}
+
+fn file_present(src: &V1Source, name: &str) -> Result<bool, Problem> {
+    source::exists(&src.root, &[name])
+}
+
+/// Where a v1 tenant's work goes.
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub enum Target {
+    /// A new keyless v2 tenant.
+    New,
+    /// An existing v2 tenant (its TSG must match).
+    Existing(crate::tenants::TenantId),
+    Skip,
+}
+
+/// What a candidate would write, decoded from v1.
+pub enum Payload {
+    Tenant {
+        label: String,
+        tsg_id: Option<String>,
+        destination: Destination,
+        /// Why v1's scan endpoint was not used (the default region is),
+        /// when endpoints were selected.
+        endpoint_problem: Option<Problem>,
+    },
+    Appearance(crate::wire::Theme),
+    Cases(Vec<crate::library::TestCase>),
+    Reports {
+        reports: Vec<crate::sessions::Report>,
+        unfit: usize,
+    },
+    Drafts {
+        owner_digest: String,
+        drafts: Vec<parse::V1Draft>,
+        skipped: usize,
+    },
+    ApiClient(Vec<crate::workbench::adoption::Candidate>),
+    Conversations(Vec<V1Snapshot>),
+}
+
+/// One item read from v1 for review, before the destination is checked.
+pub struct Candidate {
+    pub category: Category,
+    /// The v1 tenant it belongs to (index into inspection's list).
+    pub tenant: Option<u32>,
+    pub label: String,
+    /// SHA-256 of the v1 bytes it was read from.
+    pub source_hash: String,
+    pub payload: Result<Payload, Problem>,
+}
+
+fn sha(bytes: &[u8]) -> String {
+    hex::encode(Sha256::digest(bytes))
+}
+
+/// A v1 scan endpoint as a v2 destination: one of the regions, or a plain
+/// HTTPS origin (`https://host[:port]`); anything else is not mappable.
+pub fn destination(endpoint: &str) -> Result<Destination, Problem> {
+    let endpoint = endpoint.trim();
+    if endpoint.is_empty() {
+        return Ok(Destination::Region {
+            region: Region::UnitedStates,
+        });
+    }
+    let origin = crate::tenants::normalize_origin(endpoint).ok_or(Problem::EndpointNotMappable)?;
+    for region in [
+        Region::UnitedStates,
+        Region::Europe,
+        Region::India,
+        Region::Singapore,
+    ] {
+        if region.origin() == origin {
+            return Ok(Destination::Region { region });
+        }
+    }
+    Ok(Destination::Custom { origin })
+}
+
+fn default_destination() -> Destination {
+    Destination::Region {
+        region: Region::UnitedStates,
+    }
+}
+
+/// The account digest of a signed-in Academy learner (v1's directory name).
+pub fn learner_digest(account: &str) -> String {
+    parse::digest(account)
+}
+
+/// Reads what the selection needs from v1. Protected items are read only
+/// for selected protected categories, and only for tenants with a target.
+pub fn read(
+    src: &V1Source,
+    tenants: &V1Tenants,
+    targets: &[Target],
+    categories: &[Category],
+    learner: Option<&str>,
+) -> Vec<Candidate> {
+    let mut out = Vec::new();
+    let selected = |c: Category| categories.contains(&c);
+    for (i, tenant) in tenants.tenants.iter().enumerate() {
+        let index = u32::try_from(i).unwrap_or(u32::MAX);
+        let target = targets.get(i).cloned().unwrap_or(Target::Skip);
+        let candidate = |category, source_hash: String, payload| Candidate {
+            category,
+            tenant: Some(index),
+            label: tenant.name.clone(),
+            source_hash,
+            payload,
+        };
+        if target == Target::Skip {
+            for c in [Category::Tenants, Category::Cases, Category::Conversations] {
+                if selected(c) {
+                    out.push(candidate(c, String::new(), Err(Problem::NoTarget)));
+                }
+            }
+            continue;
+        }
+        if selected(Category::Tenants) && target == Target::New {
+            // An endpoint that cannot be read or mapped leaves the default
+            // region, and says why; the tenant is still imported.
+            let (destination, endpoint_problem, hash) = if selected(Category::Endpoints) {
+                match endpoint_of(src, tenant) {
+                    Ok((d, h)) => (d, None, h),
+                    Err(p) => (default_destination(), Some(p), String::new()),
+                }
+            } else {
+                (default_destination(), None, String::new())
+            };
+            let payload = Ok(Payload::Tenant {
+                label: tenant.name.clone(),
+                tsg_id: tsg(tenant),
+                destination,
+                endpoint_problem,
+            });
+            out.push(candidate(Category::Tenants, hash, payload));
+        }
+        let protected_tenant = tenant.storage == parse::V1Storage::Protected;
+        if selected(Category::Cases) {
+            let account = format!("cases-{}", tenant.id);
+            let read = if !protected_tenant {
+                Err(Problem::NoStoredWork)
+            } else if tenants.retired.contains(&account) {
+                Err(Problem::SourceRetired)
+            } else {
+                match source::read_item(src, &account, parse::CASES_LIMIT) {
+                    Ok(Some(bytes)) => parse::cases(&bytes, &tenant.id)
+                        .map(|cases| (sha(&bytes), Payload::Cases(cases))),
+                    Ok(None) => Err(Problem::Missing),
+                    Err(p) => Err(p),
+                }
+            };
+            let (hash, payload) = split(read);
+            out.push(candidate(Category::Cases, hash, payload));
+        }
+        if selected(Category::Conversations) {
+            let read = match tenant.credential_ref.as_deref() {
+                None => Err(Problem::NoStoredWork),
+                Some(_) if !protected_tenant => Err(Problem::NoStoredWork),
+                Some(reference) => {
+                    let account = format!("harness-history-{reference}");
+                    if tenants.retired.contains(&account) {
+                        Err(Problem::SourceRetired)
+                    } else {
+                        match source::read_item(src, &account, parse::HISTORY_LIMIT) {
+                            Ok(Some(bytes)) => parse::history(&bytes, &tenant.id)
+                                .map(|c| (sha(&bytes), Payload::Conversations(c))),
+                            Ok(None) => Err(Problem::Missing),
+                            Err(p) => Err(p),
+                        }
+                    }
+                }
+            };
+            let (hash, payload) = split(read);
+            out.push(candidate(Category::Conversations, hash, payload));
+        }
+    }
+    if selected(Category::Reports) {
+        out.extend(reports(src, tenants, targets));
+    }
+    if selected(Category::Settings) {
+        let read = source::read_file(
+            &src.root,
+            &[parse::APPEARANCE_FILE],
+            parse::APPEARANCE_LIMIT,
+        )
+        .and_then(|b| parse::appearance(&b).map(|t| (sha(&b), Payload::Appearance(t))));
+        let (hash, payload) = split(read);
+        out.push(Candidate {
+            category: Category::Settings,
+            tenant: None,
+            label: "Appearance".to_owned(),
+            source_hash: hash,
+            payload,
+        });
+    }
+    if selected(Category::AcademyDrafts) {
+        out.push(drafts(src, learner));
+    }
+    if selected(Category::ApiClient) {
+        let read = crate::workbench::adoption::read(&src.root.join("api-client"))
+            .map_err(|p| match p {
+                crate::workbench::adoption::AdoptionProblem::Missing => Problem::Missing,
+                crate::workbench::adoption::AdoptionProblem::Unreadable => Problem::Corrupt,
+            })
+            .map(|c| {
+                (
+                    super::content_hash(&api_identity(&c)),
+                    Payload::ApiClient(c),
+                )
+            });
+        let (hash, payload) = split(read);
+        out.push(Candidate {
+            category: Category::ApiClient,
+            tenant: None,
+            label: "API Client".to_owned(),
+            source_hash: hash,
+            payload,
+        });
+    }
+    out
+}
+
+/// A collection's root, identity and private environments (what a review
+/// of the API Client category depends on).
+type ApiIdentity = (String, String, Vec<(String, String)>);
+
+fn api_identity(candidates: &[crate::workbench::adoption::Candidate]) -> Vec<ApiIdentity> {
+    candidates
+        .iter()
+        .map(|c| {
+            (
+                c.root.display().to_string(),
+                c.id.clone(),
+                c.environments.clone(),
+            )
+        })
+        .collect()
+}
+
+fn split(read: Result<(String, Payload), Problem>) -> (String, Result<Payload, Problem>) {
+    match read {
+        Ok((hash, payload)) => (hash, Ok(payload)),
+        Err(p) => (String::new(), Err(p)),
+    }
+}
+
+fn endpoint_of(src: &V1Source, tenant: &V1Tenant) -> Result<(Destination, String), Problem> {
+    if tenant.storage != parse::V1Storage::Protected {
+        return Err(Problem::NoStoredWork);
+    }
+    let reference = tenant
+        .credential_ref
+        .as_deref()
+        .ok_or(Problem::NoStoredWork)?;
+    let bytes = source::read_item(
+        src,
+        &format!("credentials-{reference}"),
+        parse::CREDENTIALS_LIMIT,
+    )?
+    .ok_or(Problem::Missing)?;
+    let endpoint = Zeroizing::new(parse::scan_endpoint(&bytes)?);
+    // The hash names the endpoint only, never the secret item's bytes.
+    Ok((destination(&endpoint)?, sha(endpoint.as_bytes())))
+}
+
+fn reports(src: &V1Source, tenants: &V1Tenants, targets: &[Target]) -> Vec<Candidate> {
+    let bytes = match source::read_file(&src.root, &[parse::REPORTS_FILE], parse::REPORTS_LIMIT) {
+        Ok(bytes) => bytes,
+        Err(p) => {
+            return vec![Candidate {
+                category: Category::Reports,
+                tenant: None,
+                label: "FP/FN reports".to_owned(),
+                source_hash: String::new(),
+                payload: Err(p),
+            }];
+        }
+    };
+    let hash = sha(&bytes);
+    let book = match parse::reports(&bytes) {
+        Ok(book) => book,
+        Err(p) => {
+            return vec![Candidate {
+                category: Category::Reports,
+                tenant: None,
+                label: "FP/FN reports".to_owned(),
+                source_hash: hash,
+                payload: Err(p),
+            }];
+        }
+    };
+    let mut out = Vec::new();
+    for entry in book {
+        let index = tenants.tenants.iter().position(|t| t.id == entry.tenant);
+        let label = index
+            .map(|i| tenants.tenants[i].name.clone())
+            .unwrap_or_else(|| "A removed v1 tenant".to_owned());
+        let payload = match index.map(|i| targets.get(i).cloned().unwrap_or(Target::Skip)) {
+            None => Err(Problem::NoTarget),
+            Some(Target::Skip) => Err(Problem::NoTarget),
+            Some(_) => Ok(Payload::Reports {
+                reports: entry.reports,
+                unfit: entry.unfit,
+            }),
+        };
+        out.push(Candidate {
+            category: Category::Reports,
+            tenant: index.map(|i| u32::try_from(i).unwrap_or(u32::MAX)),
+            label,
+            source_hash: hash.clone(),
+            payload,
+        });
+    }
+    out
+}
+
+/// The signed-in learner's unsaved lab drafts. v1 keeps them sealed in a
+/// directory named by the account's digest, keyed by a Keychain item.
+fn drafts(src: &V1Source, learner: Option<&str>) -> Candidate {
+    let candidate = |hash: String, payload| Candidate {
+        category: Category::AcademyDrafts,
+        tenant: None,
+        label: "Academy lab drafts".to_owned(),
+        source_hash: hash,
+        payload,
+    };
+    let Some(account) = learner else {
+        return candidate(String::new(), Err(Problem::SignInRequired));
+    };
+    let owner_digest = learner_digest(account);
+    let dirs = match source::list(
+        &src.root,
+        &[parse::ACADEMY_DIR],
+        true,
+        256,
+        parse::is_digest,
+    ) {
+        Ok(dirs) => dirs,
+        Err(p) => return candidate(String::new(), Err(p)),
+    };
+    if !dirs.contains(&owner_digest) {
+        return candidate(
+            String::new(),
+            Err(if dirs.is_empty() {
+                Problem::Missing
+            } else {
+                Problem::AccountMismatch
+            }),
+        );
+    }
+    let read = (|| {
+        let names = source::list(
+            &src.root,
+            &[parse::ACADEMY_DIR, &owner_digest],
+            false,
+            parse::ACADEMY_ENTRIES,
+            |n| {
+                n.strip_prefix("attempt-")
+                    .and_then(|r| r.strip_suffix(".bin"))
+                    .is_some_and(parse::is_digest)
+            },
+        )?;
+        let key = source::read_item(src, &format!("academy-content-key-v1-{owner_digest}"), 64)?
+            .ok_or(Problem::Missing)?;
+        let mut hasher = Sha256::new();
+        let mut drafts = Vec::new();
+        let mut skipped = 0;
+        for name in names {
+            let bytes = source::read_file(
+                &src.root,
+                &[parse::ACADEMY_DIR, &owner_digest, &name],
+                parse::ACADEMY_RECORD_LIMIT,
+            )?;
+            hasher.update(name.as_bytes());
+            hasher.update(&*bytes);
+            let value = parse::academy_record(&key, account, &name, &bytes)?;
+            match parse::draft(&value, account)? {
+                parse::DraftCheck::Draft(d) => {
+                    if name != format!("attempt-{}.bin", parse::digest(&d.attempt_id)) {
+                        return Err(Problem::Corrupt);
+                    }
+                    drafts.push(d);
+                }
+                _ => skipped += 1,
+            }
+        }
+        Ok((
+            hex::encode(hasher.finalize()),
+            Payload::Drafts {
+                owner_digest: owner_digest.clone(),
+                drafts,
+                skipped,
+            },
+        ))
+    })();
+    let (hash, payload) = split(read);
+    candidate(hash, payload)
+}
+
+/// Re-reads the files a candidate came from (Keychain items are protected
+/// from change by v1's instance lock, held from review to settlement).
+pub fn file_hash(src: &V1Source, category: Category) -> Option<Result<String, Problem>> {
+    let file = match category {
+        Category::Reports => parse::REPORTS_FILE,
+        Category::Settings => parse::APPEARANCE_FILE,
+        _ => return None,
+    };
+    let limit = match category {
+        Category::Reports => parse::REPORTS_LIMIT,
+        _ => parse::APPEARANCE_LIMIT,
+    };
+    Some(source::read_file(&src.root, &[file], limit).map(|b| sha(&b)))
+}
diff --git a/crates/desktop-core/src/import_v1/receipt.rs b/crates/desktop-core/src/import_v1/receipt.rs
new file mode 100644
index 00000000..871e5a67
--- /dev/null
+++ b/crates/desktop-core/src/import_v1/receipt.rs
@@ -0,0 +1,333 @@
+//! Import receipts: an import's commit record, kept beside v2's state
+//! (`<data root>/imports/<id>.json`, 0600, replaced atomically with the file
+//! and its directory synced).
+//!
+//! Every item is noted `writing` (with what it is about to add) before its
+//! owner write and `applied` (with what it added) after; the receipt noted
+//! `applied` commits the import. One the app ended during is rolled back at
+//! the next launch, and can then be imported again (D050).
+
+use std::io::Write;
+use std::path::{Path, PathBuf};
+
+use serde::{Deserialize, Serialize};
+use ts_rs::TS;
+
+use super::Category;
+
+pub const RECEIPT_SCHEMA: &str = "prisma-airs-desktop-v2/import-receipt/1";
+/// Receipts kept; a new import waits until one is forgotten.
+pub const MAX_RECEIPTS: usize = 8;
+const RECEIPT_LIMIT: u64 = 4 * 1024 * 1024;
+
+/// `imp-` and 16 hex digits.
+pub fn new_id() -> Option<String> {
+    let mut entropy = [0u8; 8];
+    getrandom::fill(&mut entropy).ok()?;
+    Some(format!("imp-{}", hex::encode(entropy)))
+}
+
+pub fn id_ok(id: &str) -> bool {
+    id.strip_prefix("imp-")
+        .is_some_and(|h| h.len() == 16 && h.bytes().all(|b| matches!(b, b'0'..=b'9' | b'a'..=b'f')))
+}
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq, Serialize, Deserialize, TS)]
+#[serde(rename_all = "camelCase")]
+pub enum ReceiptState {
+    Applying,
+    Applied,
+    RollingBack,
+    RolledBack,
+}
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq, Serialize, Deserialize, TS)]
+#[serde(rename_all = "camelCase")]
+pub enum ItemState {
+    Planned,
+    /// Its owner write may have happened (a crash here is reconciled).
+    Writing,
+    Applied,
+    /// Its write failed; the import was rolled back.
+    Failed,
+    Reverting,
+    Reverted,
+    /// Changed in v2 after the import: kept.
+    KeptChanged,
+    /// Removed in v2 since the import.
+    Gone,
+}
+
+/// What one item wrote, with the content hash it wrote: a rollback removes
+/// it only while v2 still holds exactly that.
+#[derive(Clone, Debug, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(rename_all = "camelCase", tag = "kind")]
+pub enum Written {
+    Tenant {
+        id: String,
+        hash: String,
+    },
+    Appearance {
+        before: crate::wire::Theme,
+        after: crate::wire::Theme,
+    },
+    Case {
+        tenant: String,
+        id: String,
+        hash: String,
+    },
+    Report {
+        tenant: String,
+        scan_id: String,
+        sub: u32,
+        hash: String,
+    },
+    Draft {
+        account: String,
+        attempt: String,
+        hash: String,
+    },
+    Recent {
+        root: PathBuf,
+        id: String,
+    },
+    Conversation {
+        tenant: String,
+        workspace: String,
+        id: String,
+        hash: String,
+    },
+}
+
+#[derive(Clone, Debug, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(rename_all = "camelCase", deny_unknown_fields)]
+pub struct ReceiptItem {
+    pub index: u32,
+    pub category: Category,
+    pub label: String,
+    /// The v2 tenant it writes into (pre-issued for a new tenant).
+    pub target: Option<String>,
+    /// The v1 tenant it was read for (a resume reads it again).
+    pub source_tenant: Option<String>,
+    pub source_hash: String,
+    pub state: ItemState,
+    /// What it wrote (confirmed by its owner).
+    pub written: Vec<Written>,
+    /// What it was about to write when noted `writing`: an interruption
+    /// there leaves these unconfirmed.
+    #[serde(default, skip_serializing_if = "Vec::is_empty")]
+    pub intended: Vec<Written>,
+    /// Entries a rollback kept because v2 changed them (or they are gone).
+    #[serde(default)]
+    pub kept: u32,
+}
+
+#[derive(Clone, Debug, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(rename_all = "camelCase", deny_unknown_fields)]
+pub struct Receipt {
+    pub schema: String,
+    pub id: String,
+    /// Seconds since 1970.
+    pub created: u64,
+    pub state: ReceiptState,
+    /// The categories the operator selected (a resume reads the same).
+    #[serde(default)]
+    pub selected: Vec<Category>,
+    /// It never committed (it failed, or the app ended during it) and was
+    /// rolled back (D050); importing it again reads v1 again.
+    #[serde(default)]
+    pub recovered: bool,
+    pub items: Vec<ReceiptItem>,
+}
+
+impl Receipt {
+    pub fn terminal(&self) -> bool {
+        matches!(self.state, ReceiptState::Applied | ReceiptState::RolledBack)
+    }
+}
+
+#[derive(Debug, PartialEq, Eq)]
+pub enum ReceiptFailure {
+    /// Writing failed; the previous receipt is unchanged.
+    Unavailable,
+    /// Written, but the directory sync failed: durability unconfirmed.
+    Unconfirmed,
+    Corrupt,
+}
+
+fn path(root: &Path, id: &str) -> Option<PathBuf> {
+    id_ok(id).then(|| root.join(format!("{id}.json")))
+}
+
+/// Writes the receipt durably: a temporary file synced and renamed over the
+/// old one, then the directory synced.
+pub fn store(root: &Path, receipt: &Receipt) -> Result<(), ReceiptFailure> {
+    use std::os::unix::fs::{OpenOptionsExt, PermissionsExt};
+    let target = path(root, &receipt.id).ok_or(ReceiptFailure::Unavailable)?;
+    let bytes = serde_json::to_vec_pretty(receipt).map_err(|_| ReceiptFailure::Unavailable)?;
+    std::fs::DirBuilder::new()
+        .recursive(true)
+        .create(root)
+        .map_err(|_| ReceiptFailure::Unavailable)?;
+    std::fs::set_permissions(root, std::fs::Permissions::from_mode(0o700))
+        .map_err(|_| ReceiptFailure::Unavailable)?;
+    let mut entropy = [0u8; 8];
+    getrandom::fill(&mut entropy).map_err(|_| ReceiptFailure::Unavailable)?;
+    let temp = root.join(format!(".{}.tmp", hex::encode(entropy)));
+    let written = (|| {
+        let mut file = std::fs::OpenOptions::new()
+            .write(true)
+            .create_new(true)
+            .mode(0o600)
+            .open(&temp)?;
+        file.write_all(&bytes)?;
+        file.sync_all()?;
+        std::fs::rename(&temp, &target)
+    })();
+    if written.is_err() {
+        let _ = std::fs::remove_file(&temp);
+        return Err(ReceiptFailure::Unavailable);
+    }
+    #[cfg(feature = "test-fixtures")]
+    if sync_fault(root) {
+        return Err(ReceiptFailure::Unconfirmed);
+    }
+    std::fs::File::open(root)
+        .and_then(|d| d.sync_all())
+        .map_err(|_| ReceiptFailure::Unconfirmed)
+}
+
+/// Fixture builds: receipt folders whose directory sync fails, after how
+/// many more writes (each failing write counts once).
+#[cfg(feature = "test-fixtures")]
+static SYNC_FAULTS: std::sync::Mutex<Vec<(PathBuf, u32)>> = std::sync::Mutex::new(Vec::new());
+
+/// Makes the directory sync of the receipt write after `after` more writes
+/// under `root` fail, and every one after it, until cleared with `None`
+/// (fixture builds only).
+#[cfg(feature = "test-fixtures")]
+pub fn fail_sync(root: &Path, after: Option<u32>) {
+    if let Ok(mut faults) = SYNC_FAULTS.lock() {
+        faults.retain(|(r, _)| r != root);
+        if let Some(n) = after {
+            faults.push((root.to_path_buf(), n));
+        }
+    }
+}
+
+#[cfg(feature = "test-fixtures")]
+fn sync_fault(root: &Path) -> bool {
+    SYNC_FAULTS.lock().is_ok_and(|mut faults| {
+        faults
+            .iter_mut()
+            .find(|(r, _)| r == root)
+            .is_some_and(|(_, n)| {
+                if *n == 0 {
+                    true
+                } else {
+                    *n -= 1;
+                    false
+                }
+            })
+    })
+}
+
+/// Every receipt, oldest first. A damaged one is reported, never removed.
+pub fn load_all(root: &Path) -> (Vec<Receipt>, usize) {
+    let Ok(entries) = std::fs::read_dir(root) else {
+        return (Vec::new(), 0);
+    };
+    let mut receipts = Vec::new();
+    let mut damaged = 0;
+    for entry in entries.flatten().take(64) {
+        let name = entry.file_name().to_string_lossy().into_owned();
+        let Some(id) = name.strip_suffix(".json").filter(|id| id_ok(id)) else {
+            continue;
+        };
+        match load(root, id) {
+            Ok(r) => receipts.push(r),
+            Err(_) => damaged += 1,
+        }
+    }
+    receipts.sort_by(|a, b| a.created.cmp(&b.created).then(a.id.cmp(&b.id)));
+    (receipts, damaged)
+}
+
+pub fn load(root: &Path, id: &str) -> Result<Receipt, ReceiptFailure> {
+    let path = path(root, id).ok_or(ReceiptFailure::Corrupt)?;
+    let meta = std::fs::symlink_metadata(&path).map_err(|_| ReceiptFailure::Corrupt)?;
+    if !meta.is_file() || meta.len() > RECEIPT_LIMIT {
+        return Err(ReceiptFailure::Corrupt);
+    }
+    let bytes = std::fs::read(&path).map_err(|_| ReceiptFailure::Corrupt)?;
+    let receipt: Receipt = serde_json::from_slice(&bytes).map_err(|_| ReceiptFailure::Corrupt)?;
+    if receipt.schema != RECEIPT_SCHEMA || receipt.id != id {
+        return Err(ReceiptFailure::Corrupt);
+    }
+    Ok(receipt)
+}
+
+/// Forgets a receipt (its imported work stays; it can no longer be rolled
+/// back).
+pub fn forget(root: &Path, id: &str) -> Result<(), ReceiptFailure> {
+    let path = path(root, id).ok_or(ReceiptFailure::Corrupt)?;
+    match std::fs::remove_file(path) {
+        Ok(()) => {}
+        Err(e) if e.kind() == std::io::ErrorKind::NotFound => {}
+        Err(_) => return Err(ReceiptFailure::Unavailable),
+    }
+    std::fs::File::open(root)
+        .and_then(|d| d.sync_all())
+        .map_err(|_| ReceiptFailure::Unconfirmed)
+}
+
+/// Removes every receipt (local-data reset).
+pub fn purge(root: &Path) -> bool {
+    match std::fs::remove_dir_all(root) {
+        Ok(()) => true,
+        Err(e) => e.kind() == std::io::ErrorKind::NotFound,
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn receipts_round_trip_and_damage_is_reported() {
+        let mut entropy = [0u8; 8];
+        getrandom::fill(&mut entropy).expect("entropy");
+        let root = std::env::temp_dir()
+            .canonicalize()
+            .expect("tmp")
+            .join(format!("airs-receipts-{}", hex::encode(entropy)));
+        let receipt = Receipt {
+            schema: RECEIPT_SCHEMA.to_owned(),
+            id: new_id().expect("id"),
+            created: 1,
+            state: ReceiptState::Applying,
+            selected: vec![Category::Cases],
+            recovered: false,
+            items: vec![ReceiptItem {
+                index: 0,
+                category: Category::Cases,
+                label: "Prod".into(),
+                target: Some("tn-0123456789abcdef".into()),
+                source_tenant: None,
+                source_hash: "ab".into(),
+                state: ItemState::Writing,
+                written: vec![],
+                intended: vec![],
+                kept: 0,
+            }],
+        };
+        store(&root, &receipt).expect("stored");
+        assert_eq!(load(&root, &receipt.id).expect("loaded"), receipt);
+        std::fs::write(root.join("imp-00000000000000ff.json"), b"{").expect("write");
+        let (all, damaged) = load_all(&root);
+        assert_eq!((all.len(), damaged), (1, 1));
+        assert!(load(&root, "../x").is_err());
+        forget(&root, &receipt.id).expect("forgot");
+        assert!(purge(&root));
+    }
+}
diff --git a/crates/desktop-core/src/import_v1/source.rs b/crates/desktop-core/src/import_v1/source.rs
new file mode 100644
index 00000000..c6bd2729
--- /dev/null
+++ b/crates/desktop-core/src/import_v1/source.rs
@@ -0,0 +1,329 @@
+//! The v1 source, read only (D050): files under v1's application-support
+//! folder and generic passwords in v1's Keychain service. Nothing here can
+//! write, create, lock-create or delete anything of v1's.
+
+use std::fs::File;
+use std::io::Read;
+use std::path::{Path, PathBuf};
+use std::sync::Arc;
+
+use zeroize::Zeroizing;
+
+use super::Problem;
+use crate::vault::VaultError;
+
+/// v1's Keychain service.
+pub const V1_SERVICE: &str = "io.cdot.prisma-airs-desktop";
+
+/// v1's running-instance lock file (present only while v1 has run).
+const INSTANCE_LOCK: &str = ".desktop-instance.lock";
+
+/// Reads generic-password data in v1's service. There is no write method:
+/// v1's items cannot be changed through this type.
+pub trait V1Keychain: Send + Sync + 'static {
+    /// The item's data, `None` when there is no such item.
+    fn read(&self, account: &str) -> Result<Option<Zeroizing<Vec<u8>>>, VaultError>;
+}
+
+/// A v1 Keychain that cannot be read (no keychain on this build).
+pub struct UnavailableKeychain;
+
+impl V1Keychain for UnavailableKeychain {
+    fn read(&self, _: &str) -> Result<Option<Zeroizing<Vec<u8>>>, VaultError> {
+        Err(VaultError::Unavailable)
+    }
+}
+
+/// Where v1's work is: its folder and its Keychain service.
+#[derive(Clone)]
+pub struct V1Source {
+    pub root: PathBuf,
+    pub keychain: Arc<dyn V1Keychain>,
+}
+
+/// A path below the v1 root: plain names only (no separators, no dot names).
+fn component_ok(name: &str) -> bool {
+    !name.is_empty()
+        && name.len() <= 255
+        && name != "."
+        && name != ".."
+        && !name.contains('/')
+        && !name.contains('\0')
+}
+
+/// The v1 root itself: an absolute, ordinary directory (not a symlink).
+pub fn root_state(root: &Path) -> Result<(), Problem> {
+    if !root.is_absolute() {
+        return Err(Problem::PathRejected);
+    }
+    match std::fs::symlink_metadata(root) {
+        Ok(meta) if meta.is_dir() => Ok(()),
+        Ok(_) => Err(Problem::PathRejected),
+        Err(e) if e.kind() == std::io::ErrorKind::NotFound => Err(Problem::Missing),
+        Err(_) => Err(Problem::AccessDenied),
+    }
+}
+
+/// Walks `parts` below `root`, refusing symlinks and non-directories on the
+/// way: the path to read, after every component was checked with `lstat`.
+fn checked(root: &Path, parts: &[&str]) -> Result<PathBuf, Problem> {
+    root_state(root)?;
+    let mut path = root.to_path_buf();
+    for (i, part) in parts.iter().enumerate() {
+        if !component_ok(part) {
+            return Err(Problem::PathRejected);
+        }
+        path.push(part);
+        if i + 1 < parts.len() {
+            match std::fs::symlink_metadata(&path) {
+                Ok(meta) if meta.is_dir() => {}
+                Ok(_) => return Err(Problem::PathRejected),
+                Err(e) if e.kind() == std::io::ErrorKind::NotFound => {
+                    return Err(Problem::Missing);
+                }
+                Err(_) => return Err(Problem::AccessDenied),
+            }
+        }
+    }
+    Ok(path)
+}
+
+/// `O_NOFOLLOW` (macOS `<sys/fcntl.h>`).
+const O_NOFOLLOW: i32 = 0x0100;
+
+/// Reads a regular file below the root, at most `max` bytes, never through
+/// a symlink. Opened read-only: its bytes, times and mode are unchanged.
+pub fn read_file(root: &Path, parts: &[&str], max: u64) -> Result<Zeroizing<Vec<u8>>, Problem> {
+    use std::os::unix::fs::OpenOptionsExt;
+    let path = checked(root, parts)?;
+    let meta = match std::fs::symlink_metadata(&path) {
+        Ok(meta) => meta,
+        Err(e) if e.kind() == std::io::ErrorKind::NotFound => return Err(Problem::Missing),
+        Err(_) => return Err(Problem::AccessDenied),
+    };
+    if !meta.is_file() {
+        return Err(Problem::PathRejected);
+    }
+    if meta.len() > max {
+        return Err(Problem::TooLarge);
+    }
+    let file = std::fs::OpenOptions::new()
+        .read(true)
+        .custom_flags(O_NOFOLLOW)
+        .open(&path)
+        .map_err(|e| match e.kind() {
+            std::io::ErrorKind::NotFound => Problem::Missing,
+            std::io::ErrorKind::PermissionDenied => Problem::AccessDenied,
+            _ => Problem::PathRejected,
+        })?;
+    let mut bytes = Zeroizing::new(Vec::new());
+    file.take(max + 1)
+        .read_to_end(&mut bytes)
+        .map_err(|_| Problem::AccessDenied)?;
+    if bytes.len() as u64 > max {
+        return Err(Problem::TooLarge);
+    }
+    Ok(bytes)
+}
+
+/// Whether a file or directory exists below the root (no symlink followed).
+pub fn exists(root: &Path, parts: &[&str]) -> Result<bool, Problem> {
+    let path = match checked(root, parts) {
+        Ok(path) => path,
+        Err(Problem::Missing) => return Ok(false),
+        Err(p) => return Err(p),
+    };
+    match std::fs::symlink_metadata(&path) {
+        Ok(_) => Ok(true),
+        Err(e) if e.kind() == std::io::ErrorKind::NotFound => Ok(false),
+        Err(_) => Err(Problem::AccessDenied),
+    }
+}
+
+/// The names of the entries of a directory below the root that `keep`
+/// accepts, at most `limit` entries in all (more is `TooLarge`). Entries
+/// that are not plain files or directories as `kind` says are refused.
+pub fn list(
+    root: &Path,
+    parts: &[&str],
+    dirs: bool,
+    limit: usize,
+    keep: impl Fn(&str) -> bool,
+) -> Result<Vec<String>, Problem> {
+    let path = checked(root, parts)?;
+    let meta = match std::fs::symlink_metadata(&path) {
+        Ok(meta) => meta,
+        Err(e) if e.kind() == std::io::ErrorKind::NotFound => return Err(Problem::Missing),
+        Err(_) => return Err(Problem::AccessDenied),
+    };
+    if !meta.is_dir() {
+        return Err(Problem::PathRejected);
+    }
+    let mut names = Vec::new();
+    let entries = std::fs::read_dir(&path).map_err(|_| Problem::AccessDenied)?;
+    for (count, entry) in entries.enumerate() {
+        if count >= limit {
+            return Err(Problem::TooLarge);
+        }
+        let entry = entry.map_err(|_| Problem::AccessDenied)?;
+        let Some(name) = entry.file_name().to_str().map(str::to_owned) else {
+            continue;
+        };
+        if !keep(&name) {
+            continue;
+        }
+        let kind = entry.file_type().map_err(|_| Problem::AccessDenied)?;
+        if (dirs && !kind.is_dir()) || (!dirs && !kind.is_file()) {
+            return Err(Problem::PathRejected);
+        }
+        names.push(name);
+    }
+    names.sort();
+    Ok(names)
+}
+
+/// A shared lock on v1's instance lock, held while an import reads and
+/// settles: v1 holds it exclusively while it runs. The file is opened
+/// read-only and never created; without one v1 has not run here.
+pub struct SourceLock {
+    _file: Option<File>,
+}
+
+/// Takes the shared lock without waiting; v1 running (it takes the file
+/// exclusively) is `SourceLocked`.
+pub fn lock(root: &Path) -> Result<SourceLock, Problem> {
+    use std::os::unix::fs::OpenOptionsExt;
+    let path = checked(root, &[INSTANCE_LOCK])?;
+    let file = match std::fs::OpenOptions::new()
+        .read(true)
+        .custom_flags(O_NOFOLLOW)
+        .open(&path)
+    {
+        Ok(file) => file,
+        Err(e) if e.kind() == std::io::ErrorKind::NotFound => {
+            return Ok(SourceLock { _file: None });
+        }
+        Err(_) => return Err(Problem::PathRejected),
+    };
+    match file.try_lock_shared() {
+        Ok(()) => Ok(SourceLock { _file: Some(file) }),
+        Err(std::fs::TryLockError::WouldBlock) => Err(Problem::SourceLocked),
+        Err(_) => Err(Problem::AccessDenied),
+    }
+}
+
+/// Reads one v1 Keychain item, at most `max` bytes.
+pub fn read_item(
+    source: &V1Source,
+    account: &str,
+    max: usize,
+) -> Result<Option<Zeroizing<Vec<u8>>>, Problem> {
+    match source.keychain.read(account) {
+        Ok(Some(bytes)) if bytes.len() > max => Err(Problem::TooLarge),
+        Ok(found) => Ok(found),
+        Err(VaultError::NotFound) => Ok(None),
+        Err(VaultError::Locked) => Err(Problem::KeychainLocked),
+        Err(VaultError::Denied) => Err(Problem::AccessDenied),
+        Err(VaultError::Corrupt) => Err(Problem::Corrupt),
+        Err(VaultError::Unavailable) => Err(Problem::KeychainLocked),
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn root() -> PathBuf {
+        let mut entropy = [0u8; 8];
+        getrandom::fill(&mut entropy).expect("entropy");
+        let dir = std::env::temp_dir()
+            .canonicalize()
+            .expect("tmp")
+            .join(format!("airs-v1-src-{}", hex::encode(entropy)));
+        std::fs::create_dir_all(&dir).expect("dir");
+        dir
+    }
+
+    #[test]
+    fn reads_are_bounded_and_never_follow_symlinks() {
+        let root = root();
+        std::fs::write(root.join("tenants.json"), b"{}").expect("write");
+        assert_eq!(
+            &**read_file(&root, &["tenants.json"], 8).expect("read"),
+            b"{}"
+        );
+        assert_eq!(
+            read_file(&root, &["tenants.json"], 1),
+            Err(Problem::TooLarge)
+        );
+        assert_eq!(read_file(&root, &["absent.json"], 8), Err(Problem::Missing));
+        std::os::unix::fs::symlink(root.join("tenants.json"), root.join("link.json"))
+            .expect("link");
+        assert_eq!(
+            read_file(&root, &["link.json"], 8),
+            Err(Problem::PathRejected)
+        );
+        std::fs::create_dir(root.join("real")).expect("dir");
+        std::fs::write(root.join("real").join("a.bin"), b"x").expect("write");
+        std::os::unix::fs::symlink(root.join("real"), root.join("alias")).expect("link");
+        assert_eq!(
+            read_file(&root, &["alias", "a.bin"], 8),
+            Err(Problem::PathRejected)
+        );
+        assert_eq!(
+            read_file(&root, &["..", "x"], 8),
+            Err(Problem::PathRejected)
+        );
+        assert_eq!(
+            read_file(&root, &["real/a.bin"], 8),
+            Err(Problem::PathRejected)
+        );
+        assert_eq!(
+            read_file(Path::new("relative"), &["a"], 8),
+            Err(Problem::PathRejected)
+        );
+        std::fs::remove_dir_all(&root).expect("cleanup");
+    }
+
+    #[test]
+    fn listing_is_bounded_and_typed() {
+        let root = root();
+        std::fs::create_dir(root.join("d")).expect("dir");
+        for n in 0..3 {
+            std::fs::write(root.join("d").join(format!("attempt-{n}.bin")), b"x").expect("w");
+        }
+        let names = list(&root, &["d"], false, 8, |n| n.ends_with(".bin")).expect("list");
+        assert_eq!(names.len(), 3);
+        assert_eq!(
+            list(&root, &["d"], false, 2, |_| true),
+            Err(Problem::TooLarge)
+        );
+        assert_eq!(
+            list(&root, &["d"], true, 8, |_| true),
+            Err(Problem::PathRejected)
+        );
+        assert_eq!(
+            list(&root, &["none"], true, 8, |_| true),
+            Err(Problem::Missing)
+        );
+        std::fs::remove_dir_all(&root).expect("cleanup");
+    }
+
+    #[test]
+    fn the_instance_lock_is_shared_never_created() {
+        let root = root();
+        assert!(lock(&root).is_ok());
+        assert!(!root.join(INSTANCE_LOCK).exists(), "never created");
+        std::fs::write(root.join(INSTANCE_LOCK), b"").expect("write");
+        let ours = lock(&root).expect("shared");
+        let again = lock(&root).expect("shared twice");
+        drop((ours, again));
+        // v1 running holds it exclusively.
+        let v1 = File::open(root.join(INSTANCE_LOCK)).expect("open");
+        v1.try_lock().expect("exclusive");
+        assert!(matches!(lock(&root), Err(Problem::SourceLocked)));
+        drop(v1);
+        assert!(lock(&root).is_ok());
+        std::fs::remove_dir_all(&root).expect("cleanup");
+    }
+}
