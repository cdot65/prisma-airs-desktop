+        if (v === 'benign') counts.benign += 1
+    }
+    const visible = rows.filter(
+        (row) =>
+            (application === '' || appName(row) === application) &&
+            (verdict === 'all' || verdictOf(row).verdict === verdict) &&
+            (detector === '' || detectors(row).includes(detector))
