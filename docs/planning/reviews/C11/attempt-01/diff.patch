+                </label>
+                <Button type='submit' tier='secondary' disabled={search?.kind === 'searching' || query.trim().length === 0}>
+                    Search
+                </Button>
+                {search ? (
+                    <Button
+                        type='button'
+                        tier='tertiary'
+                        onClick={() => {
+                            searchToken.current += 1
