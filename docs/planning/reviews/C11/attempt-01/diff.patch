+    #[test]
+    fn csv_is_rfc4180_with_v1s_formula_guard() {
+        assert_eq!(csv_cell("=SUM(A1)"), "'=SUM(A1)");
+        assert_eq!(csv_cell("-12"), "-12", "numbers are not guarded");
