+                                </th>
+                                <th scope='col' className='py-2 font-medium'>
+                                    <span className='sr-only'>Actions</span>
+                                </th>
+                            </tr>
+                        </thead>
+                        <tbody>
+                            {reports.items.map((r) => (
+                                <tr key={`${r.scanId}-${r.scanSubReqId}`} className='border-academy-rule border-b align-top' data-slot='sessions-report-row'>
