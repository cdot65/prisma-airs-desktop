+    const filtered = application !== '' || verdict !== 'all' || detector !== ''
+
+    return (
+        <div className='flex flex-col gap-5' data-slot='sessions-investigation'>
+            <form
+                className='flex flex-wrap items-end gap-3'
+                role='search'
