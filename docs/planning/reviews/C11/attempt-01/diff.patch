+                            {`${v === 'all' ? 'All' : VERDICT_TEXT[v]}${shown ? ` ${counts[v]}` : ''}`}
+                        </Button>
+                    ))}
+                </div>
+                <Button type='button' tier='secondary' disabled={loading} onClick={() => void load(page?.offset ?? 0)}>
+                    Refresh
