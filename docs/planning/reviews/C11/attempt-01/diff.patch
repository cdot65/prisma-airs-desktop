+
+
+def session_row(n, every):
+    breakdown = [{"detection_type": "prompt_injection", "violation_breakdown": {"total": 1, "high": 1}}] if n % every == 0 else \
+        [{"detection_type": "dlp", "violation_breakdown": {"total": 0}}]
