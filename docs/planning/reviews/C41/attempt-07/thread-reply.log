fn refusal(refusal: SendRefusal) -> WorkbenchResult {
    WorkbenchResult::SendRefused { refusal }
}

/// The active tenant's credentials a managed request may use.
#[derive(Clone, PartialEq, Eq)]
struct Managed {
    tenant: String,
    client_id: Option<String>,
    management: Option<(RecordId, StorageMode)>,
    scan: Option<(RecordId, StorageMode)>,
}

impl State {
    /// Every registered Prisma origin, whatever tenant is active: the
    /// configured management and token origins, the workbench API origins,
    /// the AIRS scan regions and each tenant's scan destination.
    fn registered_origins(&self) -> Registered {
        let endpoints = &self.management_endpoints;
        let mut registered = Registered::default();
        for base in [
            &endpoints.api,
            &endpoints.dlp,
            &endpoints.red_team_data,
            &endpoints.red_team_mgmt,
            &endpoints.red_team_broker,
            &endpoints.model_data,
            &endpoints.model_mgmt,
            &endpoints.agentguard_data,
            &endpoints.agentguard_mgmt,
            &endpoints.gateway_data,
            &endpoints.gateway_admin,
            &endpoints.gateway_iam,
        ]
        .into_iter()
        .chain(&self.workbench_api_origins)
        {
            registered.add(base, OriginClass::Api);
        }
        registered.add(&endpoints.token, OriginClass::Auth);
        for region in [
            Region::UnitedStates,
            Region::Europe,
            Region::India,
            Region::Singapore,
        ] {
            registered.add(region.origin(), OriginClass::Scan);
        }
        for tenant in &self.data.tenants {
            registered.add(tenant.profile.destination.origin(), OriginClass::Scan);
        }
        registered
    }

    /// Where `context`'s tenant credentials may go, and their records.
    fn send_destinations(
        &self,
        context: Option<&ContextRef>,
    ) -> Result<(Destinations, Option<Managed>), SendRefusal> {
        let registered = self.registered_origins();
        let Some(context) = context else {
            return Ok((
                Destinations {
                    registered,
                    ..Destinations::default()
                },
                None,
            ));
        };
        let tenant = self
            .check_context(context)
            .map_err(|_| SendRefusal::NoTenant)?;
        let current = self.tenant(&tenant).ok_or(SendRefusal::NoTenant)?;
        let endpoints = &self.management_endpoints;
        let token_origin = endpoints.token_origin();
        let mut destinations = Destinations {
            tsg: current.profile.tsg_id.clone(),
            registered,
            ..Destinations::default()
        };
        let mut managed = Managed {
            tenant: tenant.as_str().to_owned(),
            client_id: None,
            management: None,
            scan: None,
        };
        if let ScanCapability::Ready {
            record,
            mode,
            destination,
        } = &current.management
            && token_origin.as_deref() == Some(destination.as_str())
            && let Some(client) = &current.management_client
        {
            destinations.management = true;
            destinations.token_urls = vec![
                endpoints.token.clone(),
                format!("{destination}{}", admission::CATALOGUE_TOKEN_PATH),
            ];
            destinations.token_origin = Some(destination.clone());
            for base in [
                &endpoints.api,
                &endpoints.dlp,
                &endpoints.red_team_data,
                &endpoints.red_team_mgmt,
                &endpoints.red_team_broker,
                &endpoints.model_data,
                &endpoints.model_mgmt,
                &endpoints.agentguard_data,
                &endpoints.agentguard_mgmt,
                &endpoints.gateway_data,
                &endpoints.gateway_admin,
                &endpoints.gateway_iam,
            ] {
                if let Ok(u) = url::Url::parse(base) {
                    destinations
                        .api_origins
                        .insert(u.origin().ascii_serialization());
                }
            }
            destinations
                .api_origins
                .extend(self.workbench_api_origins.iter().cloned());
            managed.client_id = Some(client.clone());
            managed.management = Some((record.clone(), *mode));
        }
        if let ScanCapability::Ready {
            record,
            mode,
            destination,
        } = &current.scan
        {
            destinations.scan_origin = Some(destination.clone());
            managed.scan = Some((record.clone(), *mode));
        }
        Ok((destinations, Some(managed)))
    }
}

/// The credentials a planned request sends besides its tenant ones.
#[derive(Clone, Debug, Default, PartialEq, Eq)]
struct Credentials {
    /// Each workbench secret reference it uses and that secret's
    /// generation this session (0: not replaced since the session began).
    secrets: BTreeMap<String, u64>,
    /// The Cookie header admitted with it (sent on its first hop).
    cookie: Option<String>,
}

/// A rendered, admitted request and where it comes from.
#[derive(Clone)]
struct Planned {
    plan: Plan,
    admitted: Admitted,
    request: String,
    relative: String,
    folder: PathBuf,
    collection: String,
    scope: String,
    managed: Option<Managed>,
    context: Option<ContextRef>,
    /// Body files' content as reviewed (empty unless applied).
    pins: BTreeMap<String, String>,
    credentials: Credentials,
    /// The reset epoch it was planned in.
    epoch: u64,
}

/// Renders and admits the snapshot `fields` of document `id` at
/// `revision` (nothing secret is read), for a Send admitted in reset epoch
/// `epoch`. The plan keeps that epoch whatever happens during its awaits,
/// so a reset meanwhile retires it: its jar is not loaded, and no review is
/// published or run registered for it.
async fn plan(
    inner: &Arc<Inner>,
    root: &Path,
    id: &str,
    revision: &str,
    fields: Fields,
    context: Option<ContextRef>,
    epoch: u64,
) -> Result<Planned, Box<WorkbenchResult>> {
    let found = with_open(inner, |o| {
        let doc = current(o, id, revision)?;
        let env = o.data.environment.clone();
        Ok((
            doc,
            o.catalog.root.clone(),
            o.catalog.id.clone(),
            o.scope.clone(),
            env.clone(),
            env.and_then(|e| o.data.private.get(&e).cloned()),
            o.data.private.get(environments::DEFAULTS).cloned(),
        ))
    })
    .map_err(|p| Box::new(refused(p)))?;
    #[cfg(feature = "test-fixtures")]
    {
        let (hold, waiting) = lock(inner)
            .map_err(|_| Box::new(refused(WorkbenchProblem::Unavailable)))?
            .workbench
            .sending
            .planning();
        waiting.fetch_add(1, Ordering::SeqCst);
        drop(hold.lock().await);
        waiting.fetch_sub(1, Ordering::SeqCst);
    }
    let (doc, folder, collection, scope, env, local, defaults) = found;
    let reference = doc.body_reference();
    let stored_body = if fields.body_kind == "file" {
        if fields.body != doc.saved.body {
            return Err(Box::new(refusal(SendRefusal::Body {
                problem: admission::BodyProblem::Unsaved,
            })));
        }
    let Tenant {
        mut desk,
        server,
        origin,
        ..
    } = tenant().await;
    let root = managed_collection(
        &origin,
        &[
            ("del", "DELETE", "/iam/v1/access_policies/abc"),
            ("create", "POST", "/iam/v1/access_policies"),
        ],
    );
    std::fs::write(root.join("policy.json"), "{\"name\":\"p\"}").expect("fixture");
    desk.open(&root).await;
    let doc = desk.doc("del.request.toml").await;
    let r = desk.send_doc("del.request.toml").await;
    assert_eq!(r["kind"], "reviewRequired", "{r}");
    let review = r["review"].clone();
    assert_eq!(review["method"], "DELETE");
    assert_eq!(review["destination"], origin);
    assert!(server.seen().is_empty(), "a review sends nothing");
    assert_eq!(desk.workbench()["review"], review);
    let context = desk.context();
    let apply = |review: &Value, fields: &Value| json!({"kind": "apply", "review": review, "id": "del", "revision": doc["revision"], "fields": fields, "context": context});
    // A forged review, then a changed snapshot: refused before any sheet
    // (were one shown, it would be declined).
    desk.adapters.confirmer.auto(Some(false));
    let r = desk
        .wb(apply(&json!("rv-0000000000000000"), &doc["fields"]))
        .await;
    assert_eq!(
        r,
        json!({"kind": "sendRefused", "refusal": {"kind": "reviewMissing"}})
    );
    let changed = with(&doc, "url", "{{scm_base}}/iam/v1/access_policies/other");
    let r = desk.wb(apply(&review["review"], &changed)).await;
    assert_eq!(
        r,
        json!({"kind": "sendRefused", "refusal": {"kind": "reviewStale"}})
    );
    // The operator declines natively: nothing is sent, the review stays.
    desk.adapters.confirmer.auto(Some(false));
    let r = desk.wb(apply(&review["review"], &doc["fields"])).await;
    assert_eq!(
        r,
        json!({"kind": "sendRefused", "refusal": {"kind": "declined"}})
    );
    assert!(server.seen().is_empty());
    // Confirmed: sent exactly once, then the review is consumed.
    desk.adapters.confirmer.auto(Some(true));
    let r = desk.wb(apply(&review["review"], &doc["fields"])).await;
    assert_eq!(r["run"]["record"]["status"], 200, "{r}");
    let deletes = |server: &TlsServer| {
        server
            .seen()
            .iter()
            .filter(|s| s.request_line.starts_with("DELETE"))
            .count()
    };
    assert_eq!(deletes(&server), 1);
    let (_, confirmation) = desk
        .adapters
        .confirmer
        .requests()
        .last()
        .cloned()
        .expect("confirmed");
    assert!(
        confirmation.destructive && confirmation.message.contains("/iam/v1/access_policies/abc")
    );
    let r = desk.wb(apply(&review["review"], &doc["fields"])).await;
    assert_eq!(
        r,
        json!({"kind": "sendRefused", "refusal": {"kind": "reviewConsumed"}})
    );
    assert_eq!(deletes(&server), 1);
