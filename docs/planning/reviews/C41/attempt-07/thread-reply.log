   520	                ) : null}
   521	                <Btn tier='tertiary' onClick={() => void call({ kind: 'clearCookies' }).then((r) => setMessage(r.kind === 'done' ? C.cookiesCleared : (resultText(r) ?? '')))}>
   522	                    {C.clearCookies}
   523	                </Btn>
   524	            </div>
   525	        </section>
