async fn open_at(
    inner: &Arc<Inner>,
    root: &std::path::Path,
    folder: PathBuf,
    built_in: bool,
) -> WorkbenchResult {
    let keychain = Arc::clone(&inner.adapters.keychain);
    let private = root.to_path_buf();
