   390	                            : git.state === 'unavailable'
   391	                              ? 'Git was not found on this Mac.'
   392	                              : 'Git did not answer in time.'}
   393	                    </p>
   394	                )
   395	            ) : null}
   396	        </section>
   397	    )
   398	}
