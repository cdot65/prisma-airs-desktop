                        <Btn type='submit' disabled={!(values[s.reference] ?? '')}>
                            {`Store value for ${s.reference}`}
                        </Btn>
                        {s.stored ? (
                            <Btn tier='tertiary' onClick={() => void run({ kind: 'removeSecret', reference: s.reference })}>
                                {`Remove value for ${s.reference}`}
                            </Btn>
                        ) : null}
                    </form>
                )
            )}
        </section>
    )
}

