#!/usr/bin/env python3
"""C41 native acceptance (D059): the API Client as the prototype board draws
it (R2App start=api), driven through the real fixture window against the
synthetic scan and management endpoints and a plain-HTTP loopback service
the collection's requests go to.

Run from the repository root after `xtask native-prepare --chunk C41`.
Requires the macOS Accessibility grant. Synthetic services only; the fixture
data root is removed at the end.

Checks (docs/architecture/native-checks.json, C41): the board (title row
with the chips, the request tree, the open requests' tabs, the request
line, the sub-tabs, the response pane), Send's completion in the status
region with the body outside it, a later send reflecting the service's
change while History keeps the first response exactly, a new request from
+, a Params row written as a line and read by Preview, the collection
menu's docked sheet (N01); keyboard reach, the focus ring and the measured
layouts in both themes (N02). The parity composites are captured from the
sent state.
"""

import json
import os
import shutil
import subprocess
import sys
import tempfile
import time

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
import fixture_app as fx  # noqa: E402
import acceptance_c08 as c8  # noqa: E402
import acceptance_c15 as c15  # noqa: E402
import acceptance_c28 as c28  # noqa: E402
import acceptance_c29 as c29  # noqa: E402
import acceptance_c31 as c31  # noqa: E402
import native_sheets as sheets  # noqa: E402

ROOT = os.getcwd()
EVIDENCE = os.path.join(ROOT, "docs/planning/evidence/C41")
NATIVE = os.path.join(EVIDENCE, "native")
RECORD = os.path.join(EVIDENCE, "native-acceptance.json")
PARITY = os.path.join(EVIDENCE, "parity")
DC = os.path.join(ROOT, "tools/parity")
LOG = []
TITLE_BAR = 28
FIRST_BODY = '{"custom_topics":["Finance"]}'
TABS = ("AXRadioButton", "AXButton", "AXCheckBox")

ANY = ("AXButton", "AXPopUpButton", "AXCheckBox", "AXRadioButton")


def node_any(tree, label):
    return next((n for n in tree if (n.get("label") or "") == label and n.get("role") in ANY), None)


def press_any(app, label, timeout=8):
    """Presses the control with this exact label whatever role AX gives it: a button with aria-haspopup is an
    AXPopUpButton, one with aria-pressed an AXCheckBox."""
    tree, _ = app.wait_for(lambda t: node_any(t, label) is not None, timeout)
"""Shared driving helpers for the prepared fixture app (C03 onward): process
control, the compiled Accessibility helper, frontmost-guarded keystrokes,
fixture data-root hygiene and the synthetic scan endpoint.

Keystrokes go through System Events only after the fixture app is confirmed
frontmost, so they can never reach another application. The fixture build
keeps data in its own Application Support directory and credentials in a
dedicated fixture test keychain there; the login keychain and v1 data are
never touched.
"""

import json
import os
import shutil
import signal
import socket
import subprocess
import time

HOME = os.path.expanduser("~")
DATA = os.path.join(HOME, "Library/Application Support/io.cdot.prisma-airs-desktop.v2.fixture")
KEYCHAIN = os.path.join(DATA, "fixture-credentials.keychain-db")
ROOTS = os.path.join(DATA, "fixture-transport-roots.pem")
V1_DATA = os.path.join(HOME, "Library/Application Support/Prisma AIRS Desktop")
PROCESS = "Fixture.app/Contents/MacOS/prisma-airs-desktop-v2"
TOOLS = os.path.dirname(os.path.abspath(__file__))


def sh(argv, **kw):
    return subprocess.run(argv, capture_output=True, text=True, **kw)


class App:
    """One fixture bundle driven through Accessibility."""

    def __init__(self, bundle, work, log):
        self.bundle = bundle
        self.log = log
        self.ax_bin = os.path.join(work, "ax")
        built = sh(["swiftc", "-O", os.path.join(TOOLS, "ax.swift"), "-o", self.ax_bin])
        if built.returncode != 0:
            raise SystemExit(f"ax helper did not build: {built.stderr}")
        self.pid = None

    def note(self, what, **data):
        self.log.append({"t": time.strftime("%H:%M:%S"), "step": what, **data})

    # ---- process ----
    @staticmethod
    def running_pid():
        out = sh(["pgrep", "-f", PROCESS]).stdout.split()
        return int(out[0]) if out else None

    def quit(self):
        pid = self.running_pid()
        if pid:
            try:
                self.keys("q", "command down")
            except RuntimeError:
                pass
            for _ in range(40):
                time.sleep(0.25)
                if not self.running_pid():
                    break
        sh(["pkill", "-f", PROCESS])
        time.sleep(0.5)
        self.pid = None

    def kill(self):
        """Ends the process without a graceful quit (an abrupt close)."""
        pid = self.running_pid()
        if pid:
            os.kill(pid, signal.SIGKILL)
            for _ in range(20):
                time.sleep(0.25)
                if not self.running_pid():
                    break
        self.pid = None

    def launch(self, settle=6):
        self.quit()
        sh(["open", "-n", self.bundle])
        for _ in range(settle * 2):
            time.sleep(0.5)
            if self.running_pid():
                break
        self.pid = self.running_pid()
        if not self.pid:
            raise RuntimeError("the fixture app did not start")
        self.tree()  # announces the AX client so WebKit builds its tree
        tree, _ = self.wait_for(lambda t: self.node(t, "AXHeading", "") is not None, 15)
        time.sleep(0.5)
        return self.pid

    # ---- accessibility ----
    def ax(self, command, *args):
        out = sh([self.ax_bin, command, str(self.pid), *[str(a) for a in args]])
        if command == "tree":
            return json.loads(out.stdout or "[]")
        if out.returncode != 0:
            raise RuntimeError(f"ax {command} {args}: {out.stderr.strip()}")
        return out.stdout

    def tree(self):
        return self.ax("tree")

    @staticmethod
    def texts(tree):
        return [n.get("label") or "" for n in tree] + [str(n.get("value")) for n in tree if n.get("value") is not None]

    def has_text(self, tree, fragment):
        return any(fragment in t for t in self.texts(tree))

    @staticmethod
    def node(tree, role, prefix, nth=0):
        found = [n for n in tree if n.get("role") == role and (n.get("label") or "").startswith(prefix)]
        return found[nth] if nth < len(found) else None

    @staticmethod
    def focused(tree):
        return next((n for n in tree if n.get("focused") and n.get("role") not in ("AXWindow", "AXWebArea", "AXGroup", "AXScrollArea")), None)

    def wait_for(self, predicate, timeout=12.0):
        deadline = time.time() + timeout
        while True:
            tree = self.tree()
            if predicate(tree):
                return tree, True
            if time.time() > deadline:
                return tree, False

