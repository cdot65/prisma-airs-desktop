}

struct Pending {
    view: SendReviewView,
    digest: String,
    context: Option<ContextRef>,
    created: Instant,
}

/// Send state held by the workbench.
#[derive(Default)]
pub(in crate::authority) struct Sending {
    runs: BTreeMap<String, Active>,
    review: Option<Pending>,
    consumed: Vec<ReviewId>,
    tokens: Arc<Tokens>,
    jars: BTreeMap<String, Arc<Mutex<Jar>>>,
    /// Each collection's history once read this session.
    histories: BTreeMap<String, Vec<RunRecord>>,
    /// Workbench secrets replaced this session (by collection and
    /// reference) and the generation each was replaced in.
    secret_generations: BTreeMap<(String, String), u64>,
    generation: u64,
    /// Advanced by every reset: work planned in an earlier epoch was
    /// retired and neither stores nor publishes anything.
    epoch: u64,
    /// Held shared by each private-storage step of a send and exclusively
