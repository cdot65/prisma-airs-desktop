[data-v2-shell] [data-slot='harness-composer'] textarea:focus-visible {
    outline: none;
}
/* The selected destination is accent-filled, so its ring is the ink-on-accent
 * colour; every other control keeps the accent ring. */
[data-v2-shell] [aria-current='page']:focus-visible {
    outline-color: var(--v2-sel-ink);
}
[data-v2-shell] [data-v2-scrim] {
    background: var(--v2-scrim);
}
@media (prefers-reduced-motion: reduce) {
    [data-v2-shell] * {
        transition: none !important;
        animation: none !important;
    }
}

/* C41 API Client: the pretty JSON view numbers its lines from a counter (the numbers are not part of the body's text). */
[data-v2-shell] [data-slot='json-lines'] {
    counter-reset: line;
    white-space: pre;
}
[data-v2-shell] [data-slot='json-lines'] > [data-line]::before {
    counter-increment: line;
    content: counter(line);
    display: inline-block;
    width: 34px;
    padding-right: 12px;
    text-align: right;
    color: var(--v2-faint);
}
/* The request's columns and the response pane stack below the width that fits them (the prototype is fixed-width). */
@media (max-width: 1180px) {
    [data-v2-shell] [data-slot='workbench-columns'] {
        flex-wrap: wrap;
