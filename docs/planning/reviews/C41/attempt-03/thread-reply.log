import { useEffect, useState } from 'react'
import type { RunRecord, RunView, RunningView, SendReviewView } from '@prisma-airs/desktop-contracts'
import { type WorkbenchCall, resultText, runFailureText, runSummary, sizeText } from '../../features/workbench/workbench-call'
import { clockOf } from '../copy'
import { Btn } from '../controls'
import { Glyph } from '../icons'
import { API_COPY as C } from './copy'
import { prettyJson } from './request-rows'
import { requestName } from './request-tree'

type ResponseTab = 'body' | 'headers' | 'details' | 'history'
const TABS: ResponseTab[] = ['body', 'headers', 'details', 'history']

const faint = { color: 'var(--v2-faint)' }
const soft = { color: 'var(--v2-soft)' }
const MONO = "ui-monospace, 'SF Mono', Menlo, monospace"
const BOX = {
    margin: '0 14px 12px',
    border: '1px solid var(--v2-rule)',
    borderRadius: 8,
    background: 'var(--v2-paper)',
}

/** The status pill's tone: the code's class, a failure, or a run that never completed. */
function tone(record: RunRecord): {
    fg: string
    bg: string
    text: string
    glyph: 'check' | 'alert' | 'ban' | 'x'
} {
    if (record.state === 'completed' && record.status !== null) {
        const code = record.status
        return code < 300
            ? {
                  fg: 'var(--v2-ok)',
                  bg: 'var(--v2-ok-bg)',
                  text: `${code} ${code === 200 ? 'OK' : ''}`.trim(),
                  glyph: 'check',
              }
            : code < 500
              ? {
                    fg: 'var(--v2-flag)',
                    bg: 'var(--v2-flag-bg)',
                    text: String(code),
                    glyph: 'alert',
                }
              : {
                    fg: 'var(--v2-block)',
                    bg: 'var(--v2-block-bg)',
                    text: String(code),
                    glyph: 'ban',
                }
    }
    const text = record.state === 'interrupted' ? 'Interrupted' : record.state === 'cancelled' ? 'Cancelled' : record.state === 'running' ? 'Running' : 'Failed'
    return { fg: 'var(--v2-block)', bg: 'var(--v2-block-bg)', text, glyph: 'x' }
}

export function elapsedText(ms: number): string {
    return ms < 1000 ? `${ms} ms` : `${(ms / 1000).toFixed(2)} s`
}

interface Props {
    /** The run Send produced for this request (null before the first send). */
    run: RunView | null
    running: RunningView[]
    review: SendReviewView | null
    call: WorkbenchCall
    /** Changes when history may have changed (the collection, a send). */
    historyKey: string
    onApply: () => void
    onDismiss: () => void
}

/**
 * The response pane (R2App's right 40%): the status line, the Body,
 * Headers, Details and History tabs. A run shown from History is the
 * immutable record of what happened then; nothing here sends anything.
 */
export function ResponsePane({ run, running, review, call, historyKey, onApply, onDismiss }: Props) {
    const [tab, setTab] = useState<ResponseTab>('body')
    const [pretty, setPretty] = useState(true)
    const [fromHistory, setFromHistory] = useState<RunView | null>(null)
    const [message, setMessage] = useState('')
    // A new send shows its own run and returns to Body.
    const runId = run?.record.id ?? null
    useEffect(() => {
        setFromHistory(null)
        setMessage('')
        if (runId) setTab('body')
    }, [runId])
    const shown = fromHistory ?? run
    const record = shown?.record ?? null
    const formatted = shown?.preview != null ? prettyJson(shown.preview) : null

    const save = async () => {
        if (!record) return
        setMessage('')
        const r = await call({ kind: 'saveResponse', run: record.id })
        if (r.kind === 'responseSaved') setMessage(C.saved(sizeText(r.bytes), r.name))
        else if (r.kind !== 'cancelled') setMessage(resultText(r) ?? '')
    }
    const copy = async () => {
        if (shown?.preview == null) return
        try {
            await navigator.clipboard.writeText(shown.preview)
            setMessage(C.copied)
        } catch {
            setMessage(C.copyFailed)
        }
    }

    const first = running[0] ?? null
    const head = record ? (
        <>
            <span
                className='inline-flex items-center rounded-[6px] font-bold'
                style={{
                    gap: 4,
                    padding: '2px 9px',
                    background: tone(record).bg,
                    color: tone(record).fg,
                }}
                data-slot='response-status'
            >
                <Glyph name={tone(record).glyph} size={11} color={tone(record).fg} />
                {tone(record).text}
            </span>
            <span style={soft}>{elapsedText(record.elapsedMs)}</span>
            <span style={soft}>{sizeText(record.bytes)}</span>
            <span className='ml-auto truncate text-[12px]' style={faint}>
                {fromHistory ? `${requestName(record.relative)} · ${clockOf(record.at)}` : clockOf(record.at)}
            </span>
        </>
    ) : first ? (
        <span role='status' aria-live='polite' className='flex flex-wrap items-center text-[12.5px]' style={{ gap: 8 }} data-slot='workbench-running'>
            {C.sendingProgress(first.method, sizeText(first.bytes))}
            <Btn className='h-7' onClick={() => void call({ kind: 'cancel', run: first.run })}>
                {C.cancel_}
            </Btn>
        </span>
    ) : (
        <span style={faint}>{C.noResponseYet}</span>
    )

    return (
        <section
            aria-label={C.pane}
            data-slot='workbench-response-pane'
            className='flex min-h-0 min-w-0 flex-col overflow-auto'
            style={{ flex: '0 0 40%', minWidth: 'min(100%, 340px)', maxWidth: 440 }}
        >
            <div
                className='flex items-center text-[13px]'
                style={{
                    gap: 10,
                    minHeight: 48,
                    padding: '9px 14px',
                    borderBottom: '1px solid var(--v2-rule)',
                }}
                data-slot='response-head'
            >
                {head}
            </div>
            {review ? (
                <div
                    role='alert'
                    className='flex flex-col rounded-[10px] text-[13px]'
                    style={{
                        gap: 8,
                        margin: '12px 14px 0',
                        padding: '12px 14px',
                        background: 'var(--v2-flag-bg)',
                    }}
                    data-slot='workbench-review'
                >
                    <p className='font-semibold'>{C.review.title(review.operation)}</p>
                    <p className='break-all font-mono text-[12px]'>{`${review.method} ${review.url}`}</p>
                    <p>{C.review.goes(review.destination)}</p>
                    {review.headers.length ? (
                        <ul className='font-mono text-[12px]'>
                            {review.headers.map(([n, v], i) => (
                                <li key={i} className='break-all'>{`${n}: ${v}`}</li>
                            ))}
                        </ul>
                    ) : null}
                    {review.body ? (
                        <pre className='max-h-48 overflow-auto rounded-[8px] p-2 font-mono text-[12px] whitespace-pre-wrap' style={{ background: 'var(--v2-paper)' }}>
                            {review.body}
                        </pre>
                    ) : null}
                    {review.files.length ? <p>{C.review.files(review.files.join(', '))}</p> : null}
                    <p className='text-[12px]' style={faint}>
                        {C.review.expires(new Date(review.expires * 1000).toLocaleTimeString())}
                    </p>
                    <div className='flex flex-wrap' style={{ gap: 8 }}>
                        <Btn tier='primary' onClick={onApply}>
                            {C.review.apply}
                        </Btn>
                        <Btn onClick={onDismiss}>{C.review.dismiss}</Btn>
                    </div>
                </div>
            ) : null}
            <div
                role='tablist'
                aria-label={`${C.response} views`}
                className='flex flex-wrap'
                style={{
                    gap: 2,
                    padding: '0 10px',
                    borderBottom: '1px solid var(--v2-rule)',
                }}
            >
                {TABS.map((t) => (
                    <button
                        key={t}
                        type='button'
                        role='tab'
                        aria-selected={tab === t}
                        aria-controls={`response-panel-${t}`}
                        onClick={() => setTab(t)}
                        className='min-h-0 text-[12.5px] font-semibold'
                        style={{
                            height: 38,
                            padding: '0 10px',
                            border: 0,
                            borderBottom: `2px solid ${tab === t ? 'var(--v2-acc)' : 'transparent'}`,
                            background: 'transparent',
                            color: tab === t ? 'var(--v2-ink)' : 'var(--v2-soft)',
                        }}
                    >
                        {C.responseTabs[t]}
                        {t === 'headers' && record?.headers.length ? (
                            <span className='font-normal' style={{ fontSize: 12, ...faint }}>
                                {' '}
                                {record.headers.length}
                            </span>
                        ) : null}
                    </button>
                ))}
            </div>
            <div role='tabpanel' id={`response-panel-${tab}`} className='flex min-h-0 flex-grow flex-col'>
                {tab === 'history' ? (
                    <History
                        call={call}
                        revision={historyKey}
                        onShow={(view) => {
                            setFromHistory(view)
                            setTab('body')
                        }}
                    />
                ) : !shown || !record ? (
                    <p className='text-[13px]' style={{ margin: '20px 14px', ...faint }} data-slot='workbench-no-response'>
                        {C.noResponse}
                    </p>
                ) : (
                    <section aria-label={C.response} data-slot='workbench-response' className='flex min-h-0 flex-grow flex-col text-[13px]'>
                        <p className='sr-only' data-slot='workbench-run-summary'>
                            {runSummary(record)}
                        </p>
                        {record.failure ? (
                            <p role='alert' style={{ margin: '12px 14px 0' }}>
                                {runFailureText(record.failure)}
                            </p>
                        ) : null}
                        {record.uncertain ? (
                            <p
                                role='alert'
                                className='rounded-[8px]'
                                style={{
                                    margin: '12px 14px 0',
                                    padding: '10px 12px',
                                    background: 'var(--v2-flag-bg)',
                                }}
                            >
                                {C.uncertain}
                            </p>
                        ) : null}
                        {record.redirect ? <p style={{ margin: '12px 14px 0' }}>{C.redirect(record.redirect)}</p> : null}
                        {shown.tokenDropped ? <p style={{ margin: '12px 14px 0' }}>{C.tokenDropped}</p> : null}
                        {tab === 'body' ? (
                            <>
                                <div className='flex flex-wrap items-center' style={{ gap: 10, padding: '12px 18px' }}>
                                    <span className='text-[12px]' style={faint}>
                                        {formatted !== null ? 'JSON' : shown.preview === null ? '' : 'Text'}
                                    </span>
                                    <span className='flex rounded-[7px] text-[12px]' style={{ padding: 2, background: 'var(--v2-inset)' }} role='group' aria-label='Body format'>
                                        {(['pretty', 'raw'] as const).map((f) => (
                                            <button
                                                key={f}
                                                type='button'
                                                aria-pressed={pretty === (f === 'pretty')}
                                                onClick={() => setPretty(f === 'pretty')}
                                                className='min-h-0 rounded-[5px] font-semibold'
                                                style={{
                                                    padding: '2px 9px',
                                                    border: 0,
                                                    background: pretty === (f === 'pretty') ? 'var(--v2-paper)' : 'transparent',
                                                    color: 'var(--v2-ink)',
                                                }}
                                            >
                                                {f === 'pretty' ? C.pretty : C.raw}
                                            </button>
                                        ))}
                                    </span>
                                    <span className='ml-auto flex items-center' style={{ gap: 6 }}>
                                        <Btn className='h-7' disabled={shown.preview == null} onClick={() => void copy()}>
                                            {C.copy}
                                        </Btn>
                                        <Btn className='h-7' disabled={!record.stored} onClick={() => void save()}>
                                            {C.saveResponse}
                                        </Btn>
                                    </span>
                                </div>
                                {shown.preview !== null && shown.preview !== '' ? (
                                    pretty && formatted !== null ? (
                                        <pre
                                            role='region'
                                            aria-label={C.responseBody}
                                            data-slot='json-lines'
                                            className='min-h-0 flex-grow overflow-auto text-[12px] leading-[1.75]'
                                            style={{
                                                ...BOX,
                                                padding: '10px 0',
                                                fontFamily: MONO,
                                                color: 'var(--v2-ink)',
                                            }}
                                        >
                                            {formatted.split('\n').map((line, i) => (
                                                <span key={i} data-line=''>
                                                    {line}
                                                    {'\n'}
                                                </span>
                                            ))}
                                        </pre>
                                    ) : (
                                        <pre
                                            role='region'
                                            aria-label={C.responseBody}
                                            className='min-h-0 flex-grow overflow-auto text-[12px] leading-[1.6] break-all whitespace-pre-wrap'
                                            style={{
                                                ...BOX,
                                                padding: 12,
                                                fontFamily: MONO,
                                                color: 'var(--v2-ink)',
                                            }}
                                        >
                                            {shown.preview}
                                        </pre>
                                    )
                                ) : (
                                    <p style={{ margin: '0 14px 12px', ...faint }}>{shown.preview === null && record.bytes > 0 ? C.notText : C.noBody}</p>
                                )}
                                {record.bytes > shown.previewBytes && shown.preview !== null ? (
                                    <p className='text-[12px]' style={{ margin: '0 14px 12px', ...faint }}>
                                        {C.firstBytes(sizeText(shown.previewBytes))}
                                    </p>
                                ) : null}
                            </>
                        ) : tab === 'headers' ? (
                            record.headers.length ? (
                                <div role='table' aria-label={C.responseHeaders} className='overflow-hidden text-[12px]' style={{ ...BOX, margin: '12px 14px', fontFamily: MONO }}>
                                    {record.headers.map(([n, v], i) => (
                                        <div
                                            key={i}
                                            role='row'
                                            className='grid'
                                            style={{
                                                gridTemplateColumns: '1fr 1.6fr',
                                                borderTop: i ? '1px solid var(--v2-rule)' : 0,
                                            }}
                                        >
                                            <span role='cell' className='break-all' style={{ padding: '8px 10px', ...soft }}>
                                                {n}
                                            </span>
                                            <span
                                                role='cell'
                                                className='break-all'
                                                style={{
                                                    padding: '8px 10px',
                                                    borderLeft: '1px solid var(--v2-rule)',
                                                }}
                                            >
                                                {v}
                                            </span>
                                        </div>
                                    ))}
                                </div>
                            ) : (
                                <p style={{ margin: '20px 14px', ...faint }}>No headers were recorded.</p>
                            )
                        ) : (
                            <dl
                                className='flex flex-col text-[12.5px]'
                                style={{
                                    ...BOX,
                                    margin: '12px 14px',
                                    padding: '12px 14px',
                                    gap: 8,
                                }}
                                data-slot='response-details'
                            >
                                {(
                                    [
                                        [C.details.request, `${record.method} ${record.url}`],
                                        [C.details.status, runSummary(record)],
                                        [C.details.duration, elapsedText(record.elapsedMs)],
                                        [C.details.size, sizeText(record.bytes)],
                                        [C.details.when, new Date(record.at * 1000).toLocaleString()],
                                        [C.details.credential, record.class === 'anonymous' ? C.details.anonymous : record.class],
                                        [C.details.operation, record.operation ?? '—'],
                                        [C.details.stored, record.stored ? C.details.yes : C.details.no],
                                    ] as [string, string][]
                                ).map(([k, v]) => (
                                    <div key={k} className='flex justify-between' style={{ gap: 10 }}>
                                        <dt style={faint}>{k}</dt>
                                        <dd className='min-w-0 break-all text-right'>{v}</dd>
                                    </div>
                                ))}
                            </dl>
                        )}
                    </section>
                )}
            </div>
            <p role='status' aria-live='polite' className='text-[12px]' style={{ margin: '0 14px 10px', ...soft }} data-slot='workbench-response-saved'>
                {message}
            </p>
        </section>
    )
}

/** The collection's history: what was sent, never sent again. */
function History({ call, revision, onShow }: { call: WorkbenchCall; revision: string; onShow: (run: RunView) => void }) {
    const [runs, setRuns] = useState<RunRecord[]>([])
    const [more, setMore] = useState(false)
    const [message, setMessage] = useState('')
    useEffect(() => {
        let live = true
        void call({ kind: 'history', before: null }).then((r) => {
            if (!live) return
            if (r.kind === 'history') {
                setRuns(r.runs)
                setMore(r.more)
            } else setMessage(resultText(r) ?? '')
        })
        return () => {
            live = false
        }
    }, [call, revision])
    const older = async () => {
        const last = runs.at(-1)
        if (!last) return
        const r = await call({ kind: 'history', before: last.id })
        if (r.kind === 'history') {
            setRuns((x) => [...x, ...r.runs])
            setMore(r.more)
        }
    }
    const clear = async () => {
        const r = await call({ kind: 'clearHistory' })
        if (r.kind === 'done') {
            setRuns([])
            setMore(false)
        } else setMessage(resultText(r) ?? '')
    }
    return (
        <section aria-label='History' data-slot='workbench-history' className='flex flex-col text-[13px]' style={{ gap: 8, margin: '12px 14px' }}>
            <p className='text-[12px]' style={soft}>
                {C.historyLead}
            </p>
            {message ? <p role='alert'>{message}</p> : null}
            {runs.length === 0 ? <p style={faint}>{C.historyEmpty}</p> : null}
            <ul className='flex flex-col' style={{ gap: 8 }}>
                {runs.map((r) => {
                    const t = tone(r)
                    const summary = `${r.method} ${r.relative.replace(/\.request\.toml$/, '')} · ${runSummary(r)} · ${new Date(r.at * 1000).toLocaleString()}`
                    return (
                        <li key={r.id}>
                            <button
                                type='button'
                                aria-label={summary}
                                onClick={() =>
                                    void call({ kind: 'showRun', run: r.id }).then((x) => {
                                        if (x.kind === 'ran') onShow(x.run)
                                        else setMessage(resultText(x) ?? '')
                                    })
                                }
                                className='flex w-full min-h-0 items-center rounded-[8px] border text-left'
                                style={{
                                    gap: 10,
                                    padding: '10px 12px',
                                    borderColor: 'var(--v2-rule)',
                                    background: 'var(--v2-paper)',
                                    color: 'var(--v2-ink)',
                                }}
                                data-slot='history-run'
                            >
                                <span className='rounded-[6px] text-[12px] font-bold' style={{ padding: '2px 8px', background: t.bg, color: t.fg }}>
                                    {t.text}
                                </span>
                                <span className='min-w-0 flex-grow truncate'>{`${r.method} ${requestName(r.relative)} · ${new Date(r.at * 1000).toLocaleString()}`}</span>
                                <span className='text-[12px]' style={faint}>
                                    {elapsedText(r.elapsedMs)}
                                </span>
                            </button>
                        </li>
                    )
                })}
            </ul>
            <div className='flex flex-wrap' style={{ gap: 8 }}>
                {more ? <Btn onClick={() => void older()}>{C.older}</Btn> : null}
                {runs.length ? (
                    <Btn tier='tertiary' onClick={() => void clear()}>
                        {C.clearHistory}
                    </Btn>
                ) : null}
                <Btn tier='tertiary' onClick={() => void call({ kind: 'clearCookies' }).then((r) => setMessage(r.kind === 'done' ? C.cookiesCleared : (resultText(r) ?? '')))}>
                    {C.clearCookies}
                </Btn>
            </div>
        </section>
    )
}
import { useId, useState } from 'react'
import { createPortal } from 'react-dom'
import type { CollectionView, GitView, WorkbenchView as WorkbenchState } from '@prisma-airs/desktop-contracts'
import type { WorkbenchCall } from '../../features/workbench/workbench-call'
import { Btn, Field } from '../controls'
import { Modal } from '../modal'
import { API_COPY as C } from './copy'
import { TEXTAREA_STYLE } from './request-editor'

export type Tool = 'environments' | 'secrets' | 'schemas' | 'import' | 'git'
export type Run = (request: Parameters<WorkbenchCall>[0]) => ReturnType<WorkbenchCall>

const soft = { color: 'var(--v2-soft)' }
const faint = { color: 'var(--v2-faint)' }
const H2 = 'text-[17px] font-bold'
const LABEL = 'flex flex-col text-[13px] font-medium'

interface Props {
    tool: Tool
    state: WorkbenchState
    collection: CollectionView
    run: Run
    onClose: () => void
    /** A cURL import created a draft (the sheet closes and the request shows). */
    onCreated: (r: Awaited<ReturnType<WorkbenchCall>>) => void
    /** Where focus returns on close: the Collection chip, since the menu item that opened the sheet closes with its menu (I8). */
    returnFocus?: HTMLElement | null
}

/**
 * The collection's tools (C14) in a right-docked sheet: environments,
 * secrets, schemas, imports and Git. Values entered for secrets go to the
 * Keychain through the core and are never shown again.
 */
export function ToolsSheet({ tool, state, collection, run, onClose, onCreated, returnFocus = null }: Props) {
    const title = C.tools[tool].replace(/…$/, '')
    return createPortal(
        <Modal label={title} sheet width={620} onClose={onClose} returnFocus={returnFocus} data-slot='workbench-tools'>
            <div className='flex flex-col' style={{ gap: 14 }} data-slot={`workbench-${tool}`}>
                <div className='flex items-center' style={{ gap: 10 }}>
                    <h2 className={H2}>{title}</h2>
                    <Btn tier='tertiary' className='ml-auto' aria-label={`Close ${title}`} onClick={onClose}>
                        ×
                    </Btn>
                </div>
                {tool === 'environments' ? (
                    <Environments collection={collection} run={run} />
                ) : tool === 'secrets' ? (
                    <Secrets collection={collection} run={run} />
                ) : tool === 'schemas' ? (
                    <Schemas collection={collection} run={run} />
                ) : tool === 'import' ? (
                    <Import state={state} run={run} onCreated={onCreated} />
                ) : (
                    <Git git={state.git} run={run} />
                )}
            </div>
        </Modal>,
        document.body
    )
}

function Environments({ collection, run }: { collection: CollectionView; run: Run }) {
    const ids = useId()
    const [open, setOpen] = useState<{
        name: string
        private: boolean
        text: string
        revision: string | null
    } | null>(null)
    const [name, setName] = useState('')
    const load = async (env: string, priv: boolean) => {
        const r = await run({ kind: 'openEnvironment', name: env, private: priv })
        if (r.kind === 'environment')
            setOpen({
                name: r.name,
                private: r.private,
                text: r.text,
                revision: r.revision,
            })
    }
    return (
        <section aria-label='Environments' className='flex flex-col text-[13px]' style={{ gap: 12 }}>
            <p style={soft}>Shared environments are TOML files saved in the collection. Private environments live only on this Mac and are never committed.</p>
            {collection.environments.length === 0 ? <p>No environments yet.</p> : null}
            <ul className='flex flex-col' style={{ gap: 6 }}>
                {collection.environments.map((e) => (
                    <li key={e.name} className='flex flex-wrap items-center' style={{ gap: 8 }}>
                        <span className='font-medium'>{e.name}</span>
                        <span style={faint}>{`(${C.chips.envOrigin[e.origin] ?? e.origin})`}</span>
                        {e.origin !== 'local' ? <Btn onClick={() => void load(e.name, false)}>{`Edit shared ${e.name}`}</Btn> : null}
                        <Btn onClick={() => void load(e.name, true)}>{`Edit private ${e.name}`}</Btn>
                    </li>
                ))}
            </ul>
            <div className='flex flex-wrap items-end' style={{ gap: 8 }}>
                <label className={LABEL} htmlFor={`${ids}-env`} style={{ gap: 4 }}>
                    Environment name
                    <Field id={`${ids}-env`} value={name} onChange={(e) => setName(e.target.value)} autoComplete='off' spellCheck={false} />
                </label>
                <Btn disabled={!name} onClick={() => void load(name, false)}>
                    New shared environment
                </Btn>
                <Btn disabled={!name} onClick={() => void load(name, true)}>
                    New private environment
                </Btn>
                <Btn tier='tertiary' onClick={() => void load('_defaults', true)}>
                    Private collection defaults
                </Btn>
            </div>
            {open ? (
                <form
                    aria-label={`${open.private ? 'Private' : 'Shared'} environment ${open.name}`}
                    className='flex flex-col'
                    style={{ gap: 8 }}
                    onSubmit={(e) => {
                        e.preventDefault()
                        void run({
                            kind: 'saveEnvironment',
                            name: open.name,
                            private: open.private,
                            revision: open.revision,
                            text: open.text,
                        }).then((r) => {
                            if (r.kind === 'environment')
                                setOpen({
                                    name: r.name,
                                    private: r.private,
                                    text: r.text,
                                    revision: r.revision,
                                })
                        })
                    }}
                >
                    <label className={LABEL} htmlFor={`${ids}-env-text`} style={{ gap: 4 }}>
                        {`${open.private ? 'Private' : 'Shared'} environment ${open.name}`}
                        <textarea id={`${ids}-env-text`} style={TEXTAREA_STYLE} value={open.text} spellCheck={false} onChange={(e) => setOpen({ ...open, text: e.target.value })} />
                    </label>
                    <div className='flex flex-wrap' style={{ gap: 8 }}>
                        <Btn tier='primary' type='submit'>
                            Save environment
                        </Btn>
                        {open.private && open.revision ? (
                            <Btn tier='tertiary' onClick={() => void run({ kind: 'deleteEnvironment', name: open.name }).then((r) => r.kind === 'done' && setOpen(null))}>
                                Delete private environment
                            </Btn>
                        ) : null}
                        <Btn tier='tertiary' onClick={() => setOpen(null)}>
                            Close
                        </Btn>
                    </div>
                </form>
            ) : null}
        </section>
    )
}

function Secrets({ collection, run }: { collection: CollectionView; run: Run }) {
    const ids = useId()
    const [values, setValues] = useState<Record<string, string>>({})
    return (
        <section aria-label='Secrets' className='flex flex-col text-[13px]' style={{ gap: 12 }}>
            <p style={soft}>Files hold secret references only. Values are kept in the Keychain on this Mac, never shown again and never written to a collection.</p>
            {collection.secrets.length === 0 ? <p>No secret references are used yet.</p> : null}
            {collection.secrets.map((s, i) =>
                s.managed ? (
                    <p key={s.reference}>
                        <span className='font-mono'>{s.reference}</span>: managed by the tenant in Settings (resolved only by tenant authority when sending arrives).
                    </p>
                ) : (
                    <form
                        key={s.reference}
                        className='flex flex-wrap items-end'
                        style={{ gap: 8 }}
                        onSubmit={(e) => {
                            e.preventDefault()
                            const value = values[s.reference] ?? ''
                            setValues((v) => ({ ...v, [s.reference]: '' }))
                            void run({ kind: 'setSecret', reference: s.reference, value })
                        }}
                    >
                        <label className={LABEL} htmlFor={`${ids}-secret-${i}`} style={{ gap: 4 }}>
                            {`${s.reference} (${s.stored ? 'value stored' : 'no value'})`}
                            <Field
                                id={`${ids}-secret-${i}`}
                                type='password'
                                autoComplete='off'
                                value={values[s.reference] ?? ''}
                                onChange={(e) => setValues((v) => ({ ...v, [s.reference]: e.target.value }))}
                            />
                        </label>
                        <Btn type='submit' disabled={!(values[s.reference] ?? '')}>
                            {`Store value for ${s.reference}`}
                        </Btn>
                        {s.stored ? (
                            <Btn tier='tertiary' onClick={() => void run({ kind: 'removeSecret', reference: s.reference })}>
                                {`Remove value for ${s.reference}`}
                            </Btn>
                        ) : null}
                    </form>
                )
            )}
        </section>
    )
}

function Schemas({ collection, run }: { collection: CollectionView; run: Run }) {
    const ids = useId()
    const [open, setOpen] = useState<{
        relative: string
        text: string
        revision: string | null
    } | null>(null)
    const [path, setPath] = useState('')
    return (
        <section aria-label='Schemas' className='flex flex-col text-[13px]' style={{ gap: 12 }}>
            <p style={soft}>JSON or YAML schema text, edited without validation or request generation. Associate one from a request's Body tab.</p>
            <ul className='flex flex-col' style={{ gap: 6 }}>
                {collection.schemas.map((s) => (
                    <li key={s}>
                        <Btn onClick={() => void run({ kind: 'openSchema', relative: s }).then((r) => r.kind === 'schema' && setOpen(r.schema))}>{`Edit ${s}`}</Btn>
                    </li>
                ))}
            </ul>
            <div className='flex flex-wrap items-end' style={{ gap: 8 }}>
                <label className={LABEL} htmlFor={`${ids}-schema`} style={{ gap: 4 }}>
                    New schema path (.json, .yaml or .yml)
                    <Field id={`${ids}-schema`} value={path} onChange={(e) => setPath(e.target.value)} autoComplete='off' spellCheck={false} />
                </label>
                <Btn disabled={!path} onClick={() => setOpen({ relative: path, text: '', revision: null })}>
                    New schema
                </Btn>
            </div>
            {open ? (
                <form
                    aria-label={`Schema ${open.relative}`}
                    className='flex flex-col'
                    style={{ gap: 8 }}
                    onSubmit={(e) => {
                        e.preventDefault()
                        void run({
                            kind: 'saveSchema',
                            relative: open.relative,
                            revision: open.revision,
                            text: open.text,
                        }).then((r) => r.kind === 'schema' && setOpen(r.schema))
                    }}
                >
                    <label className={LABEL} htmlFor={`${ids}-schema-text`} style={{ gap: 4 }}>
                        {`Schema ${open.relative}`}
                        <textarea id={`${ids}-schema-text`} style={TEXTAREA_STYLE} value={open.text} spellCheck={false} onChange={(e) => setOpen({ ...open, text: e.target.value })} />
                    </label>
                    <div className='flex' style={{ gap: 8 }}>
                        <Btn tier='primary' type='submit'>
                            Save schema
                        </Btn>
                        <Btn tier='tertiary' onClick={() => setOpen(null)}>
                            Close
                        </Btn>
                    </div>
                </form>
            ) : null}
        </section>
    )
}

function Import({ state, run, onCreated }: { state: WorkbenchState; run: Run; onCreated: (r: Awaited<ReturnType<WorkbenchCall>>) => void }) {
    const ids = useId()
    const [text, setText] = useState('')
    const [path, setPath] = useState('imported/request')
    const [chosen, setChosen] = useState<number[]>([])
    const [created, setCreated] = useState('')
    return (
        <section aria-label='Import' className='flex flex-col text-[13px]' style={{ gap: 16 }}>
            <form
                className='flex flex-col'
                style={{ gap: 8 }}
                onSubmit={(e) => {
                    e.preventDefault()
                    void run({ kind: 'importCurl', text, relative: path }).then((r) => {
                        if (r.kind === 'document') {
                            setText('')
                            onCreated(r)
                        }
                    })
                }}
            >
                <h3 className='text-[15px] font-semibold'>Paste one cURL command</h3>
                <p style={soft}>The command is parsed, never executed. Literal credentials become secret references you provide in Secrets.</p>
                <label className={LABEL} htmlFor={`${ids}-curl`} style={{ gap: 4 }}>
                    cURL command
                    <textarea id={`${ids}-curl`} style={TEXTAREA_STYLE} value={text} spellCheck={false} onChange={(e) => setText(e.target.value)} />
                </label>
                <label className={LABEL} htmlFor={`${ids}-curl-path`} style={{ gap: 4 }}>
                    Draft path (folder/name)
                    <Field id={`${ids}-curl-path`} value={path} onChange={(e) => setPath(e.target.value)} autoComplete='off' spellCheck={false} />
                </label>
                <Btn tier='primary' type='submit' className='self-start' disabled={!text.trim()}>
                    Create draft
                </Btn>
            </form>
            <div className='flex flex-col' style={{ gap: 8 }}>
                <h3 className='text-[15px] font-semibold'>Insomnia export</h3>
                <p style={soft}>Insomnia v5 collections (schema 5.1, YAML or JSON, up to 1 MiB). Scripts and plugins are not converted.</p>
                <Btn className='self-start' onClick={() => void run({ kind: 'chooseInsomnia' })}>
                    Choose Insomnia export…
                </Btn>
                {state.import ? (
                    <div className='flex flex-col' style={{ gap: 6 }} data-slot='workbench-import-preview'>
                        <p className='font-medium'>Conversion report</p>
                        {state.import.map((r) => (
                            <label key={r.index} className='flex items-center' style={{ gap: 8 }}>
                                <input
                                    type='checkbox'
                                    disabled={r.problem !== null}
                                    checked={chosen.includes(r.index)}
                                    onChange={(e) => setChosen((x) => (e.target.checked ? [...x, r.index] : x.filter((i) => i !== r.index)))}
                                />
                                {`${r.environment ? 'Environment' : 'Request'} ${r.label}${r.problem ? ` · not converted (${r.problem})` : ` · ${r.relative}`}`}
                            </label>
                        ))}
                        <div className='flex flex-wrap' style={{ gap: 8 }}>
                            <Btn tier='tertiary' onClick={() => setChosen(state.import?.filter((r) => r.problem === null).map((r) => r.index) ?? [])}>
                                Select all supported
                            </Btn>
                            <Btn
                                tier='primary'
                                disabled={chosen.length === 0}
                                onClick={() =>
                                    void run({ kind: 'createImported', selected: chosen }).then((r) => {
                                        if (r.kind === 'created') {
                                            setChosen([])
                                            setCreated(`Created ${r.requests} request drafts and ${r.environments} environments; ${r.skipped} skipped.`)
                                        }
                                    })
                                }
                            >
                                Create selected
                            </Btn>
                            <Btn tier='tertiary' onClick={() => void run({ kind: 'dismissImport' })}>
                                Dismiss
                            </Btn>
                        </div>
                    </div>
                ) : null}
                {created ? <p role='status'>{created}</p> : null}
            </div>
        </section>
    )
}

function Git({ git, run }: { git: GitView | null; run: Run }) {
    return (
        <section aria-label='Git' className='flex flex-col text-[13px]' style={{ gap: 8 }}>
            <p style={soft}>Branch and changes (read-only). Local editing, saving and previews work without Git.</p>
            <Btn className='self-start' onClick={() => void run({ kind: 'readGit' })}>
                Read Git status
            </Btn>
            {git ? (
                git.state === 'ready' ? (
                    <div className='flex flex-col' style={{ gap: 4 }}>
                        <p>{`Branch ${git.branch ?? 'detached'}${git.head ? ` at ${git.head}` : ''}${git.upstream ? ` · tracking ${git.upstream} (${git.ahead ?? 0} ahead, ${git.behind ?? 0} behind)` : ''}`}</p>
                        {git.changes.length === 0 ? <p>No changes in this collection.</p> : null}
                        <ul className='font-mono text-[12px]'>
                            {git.changes.map((c) => (
                                <li key={`${c.status}:${c.path}`}>{`${c.status} ${c.path}`}</li>
                            ))}
                        </ul>
                        {git.truncated ? <p>Only the first 500 changes are shown.</p> : null}
                    </div>
                ) : (
                    <p>
                        {git.state === 'notRepository'
                            ? 'This collection is not in a Git working tree.'
                            : git.state === 'unavailable'
                              ? 'Git was not found on this Mac.'
                              : 'Git did not answer in time.'}
                    </p>
                )
            ) : null}
        </section>
    )
}
import { useEffect, useId, useRef, type KeyboardEvent, type ReactNode } from 'react'
import { useShellStore } from './store'

interface ModalProps {
    label: string
    onClose: () => void
    children: ReactNode
    /** Width in CSS px (default 560). */
    width?: number
    /** Inner padding in CSS px (default 20); 0 for a dialog that lays itself out edge to edge. */
    padding?: number
    /** Distance from the top of the window in CSS px (default 4vh); the prototype's palette sits at 90. */
    top?: number
    /** Corner radius in CSS px (default 12; the palette's frame is 14). */
    radius?: number
    /** A sheet docked to the window's right edge under the header (R2App's review sheet, 620px wide, full height). */
    sheet?: boolean
    /**
     * The control focus returns to on close when the opener itself will be gone
     * by then (a menu item that closes with its menu as the dialog opens): an
     * explicit surviving target instead of whatever had focus at mount.
     */
    returnFocus?: HTMLElement | null
    'data-slot'?: string
}

const FOCUSABLE = 'a[href], button:not([disabled]), input:not([disabled]), select:not([disabled]), textarea:not([disabled]), [tabindex]:not([tabindex="-1"])'

/**
 * One topmost modal (I8): dialogs register on a shell-wide stack; only the
 * last is interactive. Lower dialogs are inert and aria-hidden, Tab and
 * Shift-Tab stay inside the topmost dialog, Escape closes the topmost only,
 * focus moves into the dialog on open and back to the opener on close. The
 * page behind every dialog is made inert by the shell (`useModalsOpen`).
 * The dialog element handles its own keys; the topmost dialog also listens
 * on the window for Escape alone, for when focus has left it (a native
 * sheet returned focus elsewhere), and closes only itself.
 */
export function Modal({ label, onClose, children, width = 560, padding = 20, top, radius = 12, sheet = false, returnFocus = null, ...rest }: ModalProps) {
    const id = useId()
    const pushModal = useShellStore((s) => s.pushModal)
    const popModal = useShellStore((s) => s.popModal)
    const modals = useShellStore((s) => s.modals)
    const topmost = modals.length > 0 && modals[modals.length - 1] === id
    const dialog = useRef<HTMLDivElement>(null)
    const opener = useRef<HTMLElement | null>(null)
    const returnRef = useRef(returnFocus)
    returnRef.current = returnFocus
    const focusedOnce = useRef(false)

    useEffect(() => {
        opener.current = document.activeElement instanceof HTMLElement ? document.activeElement : null
        pushModal(id)
        return () => {
            popModal(id)
            // After the commit: the page behind is still inert during cleanup,
            // and an inert ancestor refuses focus (observed in WebKit).
            const target = returnRef.current ?? opener.current
            queueMicrotask(() => {
                // Only when nothing else took focus meanwhile (⌘T replacing the
                // palette hands focus to the tenant list, which must keep it).
                const active = document.activeElement
                if (active && active !== document.body) return
                // The opener may be gone (a "Finish rotation…" that completed):
                // focus the page heading rather than leave it on nothing.
                if (target?.isConnected) target.focus()
                else document.querySelector<HTMLElement>('main h1[tabindex="-1"]')?.focus()
            })
        }
    }, [id, pushModal, popModal])

    useEffect(() => {
        // Initial focus goes into the dialog once, when it opens. Regaining the
        // top after a higher dialog closes must not refocus: that dialog is
        // restoring its own opener, which may be any control here.
        if (!topmost || focusedOnce.current) return
        const node = dialog.current
        if (!node) return
        focusedOnce.current = true
        if (!node.contains(document.activeElement)) {
            // A declared initial control first (wherever it sits), else the first focusable.
            const first = node.querySelector<HTMLElement>('[autofocus]') ?? node.querySelector<HTMLElement>(FOCUSABLE)
            ;(first ?? node).focus()
        }
    }, [topmost])

    // Escape still closes the topmost dialog when focus has left it (a
    // native sheet returning focus to the page body, a click on the scrim's
    // edge): the dialog's own handler stops the event first when it has focus.
    const closeRef = useRef(onClose)
    closeRef.current = onClose
    useEffect(() => {
        if (!topmost) return
        const onWindowKey = (event: globalThis.KeyboardEvent) => {
            if (event.key !== 'Escape' || event.defaultPrevented) return
            const node = dialog.current
            if (node && node.contains(document.activeElement)) return
            event.preventDefault()
            closeRef.current()
        }
        window.addEventListener('keydown', onWindowKey)
        return () => window.removeEventListener('keydown', onWindowKey)
    }, [topmost])

    const onKeyDown = (event: KeyboardEvent<HTMLDivElement>) => {
        if (!topmost) return
        if (event.key === 'Escape') {
            event.preventDefault()
            event.stopPropagation()
            onClose()
            return
        }
        if (event.key === 'Tab') {
            // Keyboard interaction stays inside the topmost dialog.
            const node = dialog.current
            if (!node) return
            const items = Array.from(node.querySelectorAll<HTMLElement>(FOCUSABLE)).filter((el) => !el.hasAttribute('hidden') && el.getAttribute('aria-hidden') !== 'true')
            if (items.length === 0) {
                event.preventDefault()
                node.focus()
                return
            }
            const first = items[0] as HTMLElement
            const last = items[items.length - 1] as HTMLElement
            const active = document.activeElement
            if (event.shiftKey && (active === first || active === node)) {
                event.preventDefault()
                last.focus()
            } else if (!event.shiftKey && active === last) {
                event.preventDefault()
                first.focus()
            }
        }
    }

    return (
        <div
            className={sheet ? 'fixed z-50 flex justify-end' : 'fixed inset-0 z-50 grid place-items-start justify-center'}
            style={sheet ? { inset: 'var(--v2-header, 56px) 0 0 0' } : { paddingTop: top ?? '4vh' }}
            data-v2-scrim=''
            aria-hidden={topmost ? undefined : true}
            inert={topmost ? undefined : true}
            onMouseDown={() => topmost && onClose()}
        >
            <div
                ref={dialog}
                role='dialog'
                aria-modal={topmost ? 'true' : undefined}
                aria-label={label}
                tabIndex={-1}
                data-slot={rest['data-slot'] ?? 'modal'}
                data-topmost={topmost ? 'true' : 'false'}
                onKeyDown={onKeyDown}
                onMouseDown={(e) => e.stopPropagation()}
                className='border'
                // Bounded to the viewport: a tall dialog scrolls inside itself, so its
                // actions stay reachable at the minimum window size and 200% zoom.
                style={
                    sheet
                        ? { width: `min(${width}px, 100vw)`, height: '100%', overflowY: 'auto', padding, borderRadius: 0, borderLeft: '1px solid var(--v2-rule)', boxShadow: '-18px 0 40px rgba(0,0,0,0.18)', background: 'var(--v2-bg)', borderWidth: 0, color: 'var(--v2-ink)' }
                        : { width: `min(${width}px, 92vw)`, maxHeight: '92vh', overflowY: 'auto', padding, borderRadius: radius, boxShadow: '0 24px 60px rgba(0,0,0,0.3)', background: 'var(--v2-paper)', borderColor: 'var(--v2-rule)', color: 'var(--v2-ink)' }
                }
            >
                {children}
            </div>
        </div>
    )
}

/** Whether any modal is open: the shell makes the page behind it inert. */
export function useModalsOpen(): boolean {
    return useShellStore((s) => s.modals.length > 0)
}
