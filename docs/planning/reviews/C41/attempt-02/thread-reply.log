        ?.replace(/\.request\.toml$/, '') ?? relative
const folderOf = (relative: string) => relative.split('/').slice(0, -1).join('/')
const short = (method: string) => (method === 'DELETE' ? 'DEL' : method === 'OPTIONS' ? 'OPT' : method)

/**
 * The request tree (R2App's 286px pane): Find request, +, folders with
 * their counts and the requests under them with their methods. A search
 * lists the matching requests flat. Nothing here sends anything.
 */
export function RequestTree({ collection, onOpen, onCreate }: Props) {
    const ids = useId()
    const [query, setQuery] = useState('')
    const [collapsed, setCollapsed] = useState<Set<string>>(() => new Set())
    const [creating, setCreating] = useState<null | 'request' | 'folder'>(null)
    const [path, setPath] = useState('')
    const selected = collection.tabs.find((t) => t.id === collection.selected)?.relative ?? null
    const needle = query.trim().toLowerCase()

    // The hierarchy: every folder (listed, or implied by a request's path or a deeper folder), its direct
    // requests, its child folders and the count of every request under it, as the prototype's tree draws them.
    const { children, byFolder, counts } = useMemo(() => {
        const byFolder = new Map<string, RequestEntry[]>()
        const folders = new Set<string>()
        const add = (f: string) => {
            for (let i = f.indexOf('/'); i !== -1; i = f.indexOf('/', i + 1)) folders.add(f.slice(0, i))
            if (f !== '') folders.add(f)
        }
        for (const f of collection.folders) add(f)
        for (const r of collection.requests) {
            const f = folderOf(r.relative)
            add(f)
            byFolder.set(f, [...(byFolder.get(f) ?? []), r])
        }
        const children = new Map<string, string[]>()
        for (const f of [...folders].sort()) children.set(folderOf(f), [...(children.get(folderOf(f)) ?? []), f])
        const counts = new Map<string, number>()
        for (const f of folders) counts.set(f, collection.requests.filter((r) => r.relative.startsWith(`${f}/`)).length)
        return { children, byFolder, counts }
    }, [collection.requests, collection.folders])

    const matching = needle === '' ? null : collection.requests.filter((r) => `${r.method} ${r.relative} ${r.url}`.toLowerCase().includes(needle))

    const request = (r: RequestEntry, depth: number) => (
        <button
            key={r.id}
            type='button'
            aria-label={C.openRequest(r.method, r.relative)}
            aria-current={r.relative === selected ? 'true' : undefined}
            onClick={() => onOpen(r.relative)}
            className='flex w-full min-h-0 items-center rounded-[6px] text-left text-[12.5px]'
            style={{
                gap: 6,
                height: 30,
                padding: `0 8px 0 ${8 + depth * 14}px`,
                background: r.relative === selected ? 'var(--v2-inset)' : 'transparent',
                color: 'var(--v2-ink)',
                fontWeight: r.relative === selected ? 600 : 400,
            }}
            data-slot='tree-request'
        >
            <span className='shrink-0 font-mono text-[11px] font-bold' style={{ width: 34, color: methodColor(r.method) }}>
                {short(r.method)}
            </span>
            <span className='min-w-0 flex-grow truncate'>{requestName(r.relative)}</span>
        </button>
    )

    const toggle = (f: string) =>
        setCollapsed((s) => {
            const n = new Set(s)
            if (n.has(f)) n.delete(f)
            else n.add(f)
            return n
        })

    let shown = 0
    const requests = (f: string, depth: number) => (byFolder.get(f) ?? []).slice(0, Math.max(0, LIMIT - shown)).map((r) => ((shown += 1), request(r, depth)))
    // A collapsed folder hides its whole subtree: its requests, its child folders and theirs.
    const folder = (f: string): JSX.Element => {
        const open = !collapsed.has(f)
        const depth = f.split('/').length - 1
        return (
            <div key={`f:${f}`} data-slot='tree-folder'>
                <button
                    type='button'
                    aria-expanded={open}
                    aria-label={C.folder(f, open)}
                    onClick={() => toggle(f)}
                    className='flex w-full min-h-0 items-center rounded-[6px] text-left text-[12.5px] font-semibold'
                    style={{
                        gap: 6,
                        height: 30,
                        padding: `0 8px 0 ${8 + depth * 14}px`,
                        color: 'var(--v2-ink)',
                    }}
                >
                    <span className='inline-flex shrink-0' style={{ transform: open ? 'none' : 'rotate(-90deg)' }}>
                        <Glyph name='chev' size={10} color='var(--v2-faint)' />
                    </span>
                    <Glyph name='folder' size={13} color='var(--v2-faint)' />
                    <span className='min-w-0 flex-grow truncate'>{f.split('/').pop()}</span>
                    <span className='text-[12px]' style={{ color: 'var(--v2-faint)' }} data-slot='tree-folder-count'>
                        {counts.get(f) ?? 0}
                    </span>
                </button>
                {open ? (children.get(f) ?? []).map(folder) : null}
                {open ? requests(f, depth + 1) : null}
            </div>
        )
    }
    const list = matching ? matching.slice(0, LIMIT).map((r) => request(r, 0)) : [...(children.get('') ?? []).map(folder), ...requests('', 0)]

    const total = matching ? matching.length : collection.requests.length

    return (
        <form
            aria-label={C.tree}
            data-slot='request-tree'
            className='flex min-h-0 shrink-0 flex-col'
            style={{
                width: 286,
                borderRight: '1px solid var(--v2-rule)',
                background: 'var(--v2-side)',
            }}
            onSubmit={(e) => e.preventDefault()}
        >
            <div className='flex' style={{ gap: 6, padding: 10 }}>
                <label
                    htmlFor={`${ids}-find`}
                    className='flex min-w-0 flex-grow items-center rounded-[7px] text-[12px]'
                    style={{
                        gap: 7,
                        height: 32,
                        padding: '0 9px',
                        background: 'var(--v2-inset)',
                        color: 'var(--v2-faint)',
                    }}
                >
                    <Glyph name='search' size={12} color='var(--v2-faint)' />
                    <input
                        id={`${ids}-find`}
                        type='search'
                        aria-label={C.find}
                        placeholder={C.find}
                        value={query}
                        autoComplete='off'
                        onChange={(e) => setQuery(e.target.value)}
                        className='min-h-0 min-w-0 flex-grow border-0 bg-transparent p-0 text-[13px]'
                        style={{
                            border: 0,
                            minHeight: 0,
                            height: 24,
                            borderRadius: 0,
                            background: 'transparent',
                            color: 'var(--v2-ink)',
                        }}
                        data-slot='tree-search'
                    />
                </label>
                <button
                    type='button'
                    aria-label={C.newRequest}
                    aria-haspopup='dialog'
                    title={C.newRequest}
                    onClick={() => {
                        setPath('')
                        setCreating('request')
                    }}
                    className='grid size-8 min-h-0 shrink-0 place-items-center rounded-[7px] border text-[15px]'
                    style={{
                        borderColor: 'var(--v2-rule)',
                        background: 'var(--v2-paper)',
                        color: 'var(--v2-ink)',
                    }}
                >
                    +
                </button>
            </div>
            <div className='min-h-0 flex-grow overflow-auto' style={{ padding: '0 6px 10px' }} data-slot='tree-list'>
                {list}
                {total === 0 ? (
                    <div className='flex flex-col items-start text-[12.5px] leading-[1.5]' style={{ gap: 10, padding: '16px 10px', color: 'var(--v2-faint)' }} data-slot='tree-empty'>
                        <span>{matching ? C.noMatch(query.trim(), collection.requests.length) : C.noRequests}</span>
                        {matching ? <Btn onClick={() => setQuery('')}>{C.clearSearch}</Btn> : null}
                    </div>
                ) : null}
                {total > LIMIT ? (
                    <p className='text-[12px]' style={{ padding: '8px 10px', color: 'var(--v2-faint)' }}>
                        {C.tooMany(LIMIT, total)}
                    </p>
                ) : null}
            </div>
            {creating
                ? createPortal(
                      <Modal label={creating === 'request' ? C.newRequestTitle : C.newFolder} width={480} onClose={() => setCreating(null)} data-slot='new-request-dialog'>
                          <form
                              className='flex flex-col'
                              style={{ gap: 12 }}
                              onSubmit={(e) => {
                                  e.preventDefault()
                                  const kind = creating
                                  void onCreate(kind, path.trim()).then((ok) => ok && setCreating(null))
                              }}
                          >
                              <h2 className='text-[17px] font-bold'>{creating === 'request' ? C.newRequestTitle : C.newFolder}</h2>
                              <div role='radiogroup' aria-label={C.create} className='flex' style={{ gap: 12 }}>
                                  {(['request', 'folder'] as const).map((k) => (
                                      <label key={k} className='flex items-center text-[13px]' style={{ gap: 6 }}>
                                          <input type='radio' name={`${ids}-kind`} checked={creating === k} onChange={() => setCreating(k)} />
                                          {k === 'request' ? C.newRequest : C.newFolder}
                                      </label>
                                  ))}
                              </div>
                              <label htmlFor={`${ids}-path`} className='flex flex-col text-[13px] font-medium' style={{ gap: 4 }}>
                                  {creating === 'request' ? C.newRequestPath : C.newFolderPath}
                                  <Field id={`${ids}-path`} value={path} autoFocus autoComplete='off' spellCheck={false} onChange={(e) => setPath(e.target.value)} />
                              </label>
                              {creating === 'request' ? (
                                  <p className='text-[12px]' style={{ color: 'var(--v2-faint)' }}>
                                      {C.newRequestLead}
                                  </p>
                              ) : null}
                              <div className='flex justify-end' style={{ gap: 8 }}>
                                  <Btn onClick={() => setCreating(null)}>{C.cancel}</Btn>
                                  <Btn tier='primary' type='submit' disabled={path.trim() === ''}>
                                      {C.create}
                                  </Btn>
                              </div>
                          </form>
                      </Modal>,
                      document.body
                  )
                : null}
        </form>
    )
}
import { useEffect, useState } from 'react'
import type { RunRecord, RunView, RunningView, SendReviewView } from '@prisma-airs/desktop-contracts'
import { type WorkbenchCall, resultText, runFailureText, runSummary, sizeText } from '../../features/workbench/workbench-call'
import { clockOf } from '../copy'
import { Btn } from '../controls'
import { Glyph } from '../icons'
import { API_COPY as C } from './copy'
import { prettyJson } from './request-rows'
import { requestName } from './request-tree'

type ResponseTab = 'body' | 'headers' | 'details' | 'history'
const TABS: ResponseTab[] = ['body', 'headers', 'details', 'history']

const faint = { color: 'var(--v2-faint)' }
const soft = { color: 'var(--v2-soft)' }
const MONO = "ui-monospace, 'SF Mono', Menlo, monospace"
const BOX = {
    margin: '0 14px 12px',
    border: '1px solid var(--v2-rule)',
    borderRadius: 8,
    background: 'var(--v2-paper)',
}

/** The status pill's tone: the code's class, a failure, or a run that never completed. */
function tone(record: RunRecord): {
    fg: string
    bg: string
    text: string
    glyph: 'check' | 'alert' | 'ban' | 'x'
} {
    if (record.state === 'completed' && record.status !== null) {
        const code = record.status
        return code < 300
            ? {
                  fg: 'var(--v2-ok)',
                  bg: 'var(--v2-ok-bg)',
                  text: `${code} ${code === 200 ? 'OK' : ''}`.trim(),
                  glyph: 'check',
              }
            : code < 500
              ? {
                    fg: 'var(--v2-flag)',
                    bg: 'var(--v2-flag-bg)',
                    text: String(code),
                    glyph: 'alert',
                }
              : {
                    fg: 'var(--v2-block)',
                    bg: 'var(--v2-block-bg)',
                    text: String(code),
                    glyph: 'ban',
                }
    }
    const text = record.state === 'interrupted' ? 'Interrupted' : record.state === 'cancelled' ? 'Cancelled' : record.state === 'running' ? 'Running' : 'Failed'
    return { fg: 'var(--v2-block)', bg: 'var(--v2-block-bg)', text, glyph: 'x' }
}

export function elapsedText(ms: number): string {
    return ms < 1000 ? `${ms} ms` : `${(ms / 1000).toFixed(2)} s`
}

interface Props {
    /** The run Send produced for this request (null before the first send). */
    run: RunView | null
    running: RunningView[]
    review: SendReviewView | null
    call: WorkbenchCall
    /** Changes when history may have changed (the collection, a send). */
    historyKey: string
    onApply: () => void
    onDismiss: () => void
}

/**
 * The response pane (R2App's right 40%): the status line, the Body,
 * Headers, Details and History tabs. A run shown from History is the
 * immutable record of what happened then; nothing here sends anything.
 */
export function ResponsePane({ run, running, review, call, historyKey, onApply, onDismiss }: Props) {
    const [tab, setTab] = useState<ResponseTab>('body')
    const [pretty, setPretty] = useState(true)
    const [fromHistory, setFromHistory] = useState<RunView | null>(null)
    const [message, setMessage] = useState('')
    // A new send shows its own run and returns to Body.
    const runId = run?.record.id ?? null
    useEffect(() => {
        setFromHistory(null)
        setMessage('')
        if (runId) setTab('body')
    }, [runId])
    const shown = fromHistory ?? run
    const record = shown?.record ?? null
    const formatted = shown?.preview != null ? prettyJson(shown.preview) : null

    const save = async () => {
        if (!record) return
        setMessage('')
        const r = await call({ kind: 'saveResponse', run: record.id })
        if (r.kind === 'responseSaved') setMessage(C.saved(sizeText(r.bytes), r.name))
        else if (r.kind !== 'cancelled') setMessage(resultText(r) ?? '')
    }
    const copy = async () => {
        if (shown?.preview == null) return
        try {
            await navigator.clipboard.writeText(shown.preview)
            setMessage(C.copied)
        } catch {
            setMessage(C.copyFailed)
        }
    }

    const first = running[0] ?? null
    const head = record ? (
        <>
            <span
                className='inline-flex items-center rounded-[6px] font-bold'
                style={{
                    gap: 4,
                    padding: '2px 9px',
                    background: tone(record).bg,
                    color: tone(record).fg,
                }}
                data-slot='response-status'
            >
                <Glyph name={tone(record).glyph} size={11} color={tone(record).fg} />
                {tone(record).text}
            </span>
            <span style={soft}>{elapsedText(record.elapsedMs)}</span>
            <span style={soft}>{sizeText(record.bytes)}</span>
            <span className='ml-auto truncate text-[12px]' style={faint}>
                {fromHistory ? `${requestName(record.relative)} · ${clockOf(record.at)}` : clockOf(record.at)}
            </span>
        </>
    ) : first ? (
        <span role='status' aria-live='polite' className='flex flex-wrap items-center text-[12.5px]' style={{ gap: 8 }} data-slot='workbench-running'>
            {C.sendingProgress(first.method, sizeText(first.bytes))}
            <Btn className='h-7' onClick={() => void call({ kind: 'cancel', run: first.run })}>
                {C.cancel_}
            </Btn>
        </span>
    ) : (
        <span style={faint}>{C.noResponseYet}</span>
    )

    return (
        <section
            aria-label={C.pane}
            data-slot='workbench-response-pane'
            className='flex min-h-0 min-w-0 flex-col overflow-auto'
            style={{ flex: '0 0 40%', minWidth: 'min(100%, 340px)', maxWidth: 440 }}
        >
            <div
                className='flex items-center text-[13px]'
                style={{
                    gap: 10,
                    minHeight: 48,
                    padding: '9px 14px',
                    borderBottom: '1px solid var(--v2-rule)',
                }}
                data-slot='response-head'
            >
                {head}
            </div>
            {review ? (
                <div
                    role='alert'
                    className='flex flex-col rounded-[10px] text-[13px]'
                    style={{
                        gap: 8,
                        margin: '12px 14px 0',
                        padding: '12px 14px',
                        background: 'var(--v2-flag-bg)',
                    }}
                    data-slot='workbench-review'
                >
                    <p className='font-semibold'>{C.review.title(review.operation)}</p>
                    <p className='break-all font-mono text-[12px]'>{`${review.method} ${review.url}`}</p>
                    <p>{C.review.goes(review.destination)}</p>
                    {review.headers.length ? (
                        <ul className='font-mono text-[12px]'>
                            {review.headers.map(([n, v], i) => (
                                <li key={i} className='break-all'>{`${n}: ${v}`}</li>
                            ))}
                        </ul>
                    ) : null}
                    {review.body ? (
                        <pre className='max-h-48 overflow-auto rounded-[8px] p-2 font-mono text-[12px] whitespace-pre-wrap' style={{ background: 'var(--v2-paper)' }}>
                            {review.body}
                        </pre>
                    ) : null}
                    {review.files.length ? <p>{C.review.files(review.files.join(', '))}</p> : null}
                    <p className='text-[12px]' style={faint}>
                        {C.review.expires(new Date(review.expires * 1000).toLocaleTimeString())}
                    </p>
                    <div className='flex flex-wrap' style={{ gap: 8 }}>
                        <Btn tier='primary' onClick={onApply}>
                            {C.review.apply}
                        </Btn>
                        <Btn onClick={onDismiss}>{C.review.dismiss}</Btn>
                    </div>
                </div>
            ) : null}
            <div
                role='tablist'
                aria-label={`${C.response} views`}
                className='flex flex-wrap'
                style={{
                    gap: 2,
                    padding: '0 10px',
                    borderBottom: '1px solid var(--v2-rule)',
                }}
            >
                {TABS.map((t) => (
                    <button
                        key={t}
                        type='button'
                        role='tab'
                        aria-selected={tab === t}
                        aria-controls={`response-panel-${t}`}
                        onClick={() => setTab(t)}
                        className='min-h-0 text-[12.5px] font-semibold'
                        style={{
                            height: 38,
                            padding: '0 10px',
                            border: 0,
                            borderBottom: `2px solid ${tab === t ? 'var(--v2-acc)' : 'transparent'}`,
                            background: 'transparent',
                            color: tab === t ? 'var(--v2-ink)' : 'var(--v2-soft)',
                        }}
                    >
                        {C.responseTabs[t]}
                        {t === 'headers' && record?.headers.length ? (
                            <span className='font-normal' style={{ fontSize: 12, ...faint }}>
                                {' '}
                                {record.headers.length}
                            </span>
                        ) : null}
                    </button>
                ))}
            </div>
            <div role='tabpanel' id={`response-panel-${tab}`} className='flex min-h-0 flex-grow flex-col'>
                {tab === 'history' ? (
                    <History
                        call={call}
                        revision={historyKey}
                        onShow={(view) => {
                            setFromHistory(view)
                            setTab('body')
                        }}
                    />

 succeeded in 0ms:
                </div>
            ) : null}
        </div>
    )

    const alerts = (
        <>
            {state.network !== 'live' ? (
                <p className='text-[12px]' style={faint} data-slot='workbench-network'>
                    {state.network === 'loopbackOnly' ? C.network.loopbackOnly : C.network.none}
                </p>
            ) : null}
            {state.failure ? (
                <p role='alert' className='rounded-[10px] text-[13px]' style={{ padding: '12px 14px', background: 'var(--v2-block-bg)' }}>
                    {C.privateFailure(state.failure)}
                </p>
            ) : null}
            {message && collection ? (
                <p role='alert' className='text-[13px]' style={{ color: 'var(--v2-block)' }} data-slot='workbench-message'>
                    {message}
                </p>
            ) : null}
            {collection?.issues.length ? (
                <div role='alert' className='rounded-[10px] text-[13px]' style={{ padding: '12px 14px', background: 'var(--v2-flag-bg)' }} data-slot='workbench-issues'>
                    <p>{C.issues(collection.issues.length, collection.complete)}</p>
                    <ul className='mt-1 list-disc pl-5 text-[12px]'>
                        {collection.issues.slice(0, 10).map((i) => (
                            <li key={`${i.relative}:${i.kind}`}>{`${i.relative}: ${i.kind}`}</li>
                        ))}
                    </ul>
                </div>
            ) : null}
            {collection?.unsaved ? (
                <p role='alert' className='rounded-[10px] text-[13px]' style={{ padding: '12px 14px', background: 'var(--v2-block-bg)' }}>
                    {C.unsaved(collection.unsaved)}
                </p>
            ) : null}
        </>
    )

    if (!state.available) {
        return (
            <section
                aria-labelledby='workbench-heading'
                data-slot='api-client-v2'
                className='flex min-h-0 min-w-0 flex-grow flex-col'
                style={{
                    margin: 'calc(-1 * var(--v2-page-top)) calc(-1 * var(--v2-page-x)) -28px',
                }}
            >
                {band}
                <p role='alert' className='text-[13px]' style={{ padding: '20px var(--v2-page-x)' }}>
                    {C.unavailable}
                </p>
            </section>
        )
    }

    return (
        <section
            aria-labelledby='workbench-heading'
            data-slot='api-client-v2'
            className='flex min-h-0 min-w-0 flex-grow flex-col'
            style={{
                margin: 'calc(-1 * var(--v2-page-top)) calc(-1 * var(--v2-page-x)) -28px',
            }}
        >
            {band}
            {!collection ? (
                <div className='flex flex-col' style={{ gap: 12, padding: '20px var(--v2-page-x)' }}>
                    {alerts}
                    {state.loaded ? (
                        <Start state={state} run={run} message={message} offerNew={offerNew} />
                    ) : (
                        <p role='status' className='text-[13px]' style={soft}>
                            {C.opening}
                        </p>
                    )}
                </div>
            ) : (
                <>
                    <div className='flex min-h-0 flex-grow' data-slot='api-body'>
                        <RequestTree
                            collection={collection}
                            onOpen={(relative) => void run({ kind: 'openRequest', relative }).then(show)}
                            onCreate={async (kind, relative) => {
                                const r = await run(kind === 'request' ? { kind: 'newRequest', relative } : { kind: 'newFolder', relative })
                                if (kind === 'request') show(r)
                                return r.kind === 'document' || r.kind === 'done'
                            }}
                        />
                        <div className='flex min-h-0 min-w-0 flex-grow flex-col' data-slot='api-main'>
                            <div
                                role='tablist'
                                aria-label={C.openRequests}
                                className='flex shrink-0 flex-wrap items-end'
                                style={{
                                    minHeight: 36,
                                    gap: 2,
                                    padding: '0 8px',
                                    borderBottom: '1px solid var(--v2-rule)',
                                    background: 'var(--v2-side)',
                                }}
                                data-slot='workbench-tabs'
                            >
                                {collection.tabs.map((t) => {
                                    const name = requestName(t.relative)
                                    const on = t.id === collection.selected
                                    const marks = [t.new ? 'new' : t.draft ? 'unsaved' : '', t.conflict ? `${t.conflict} on disk` : '', t.interrupted ? 'interrupted save' : '']
                                        .filter(Boolean)
                                        .join(', ')
                                    return (
                                        <span
                                            key={t.id}
                                            className='flex items-center rounded-t-[7px] border border-b-0'
                                            style={{
                                                height: 30,
                                                maxWidth: 240,
                                                borderColor: on ? 'var(--v2-rule)' : 'transparent',
                                                background: on ? 'var(--v2-bg)' : 'transparent',
                                            }}
                                        >
                                            <button
                                                type='button'
                                                role='tab'
                                                aria-selected={on}
                                                aria-label={`${t.method} ${name}${marks ? ` (${marks})` : ''}`}
                                                onClick={() => void run({ kind: 'selectTab', id: t.id })}
                                                className='flex min-h-0 min-w-0 items-center text-[12px] whitespace-nowrap'
                                                style={{
                                                    gap: 7,
                                                    height: 28,
                                                    padding: '0 6px 0 12px',
                                                    border: 0,
                                                    background: 'transparent',
                                                    color: 'var(--v2-ink)',
                                                }}
                                            >
                                                <span className='font-mono text-[11px] font-bold' style={{ color: methodColor(t.method) }}>
                                                    {t.method}
                                                </span>
import { useCallback, useEffect, useId, useRef, useState } from 'react'
import type { DocumentView, Fields, ImportNote, Preview, RunView, RunningView, SendReviewView } from '@prisma-airs/desktop-contracts'
import { type WorkbenchCall, fieldText, resultText, saveRefusalText } from '../../features/workbench/workbench-call'
import { Btn } from '../controls'
import { Glyph } from '../icons'
import { API_COPY as C, BODY_KINDS, METHODS, methodColor } from './copy'
import { type Row, type RowKind, enabledCount, parseRows, serializeRows, splitUrl } from './request-rows'
import { ResponsePane } from './response-pane'
import { requestName } from './request-tree'

/** File > Save (Cmd+S) arrives from the native menu as this window event. */
export const SAVE_DOCUMENT_EVENT = 'airs-save-document'
/** How long typing pauses before the snapshot is protected on this Mac. */
export const PROTECT_DELAY_MS = 400

type Sub = 'params' | 'headers' | 'body' | 'auth' | 'variables' | 'preview'
const SUBS: Sub[] = ['params', 'headers', 'body', 'auth', 'variables', 'preview']

const same = (a: Fields, b: Fields) =>
    a.method === b.method && a.url === b.url && a.headers === b.headers && a.query === b.query && a.body === b.body && a.bodyKind === b.bodyKind && a.settings === b.settings

/**
 * What the completion status region announces after Send (C33, known gap 5):
 * "<request> · <code> · <duration>". The response body is outside it.
 */
export function completionText(record: { relative: string; status: number | null; elapsedMs: number }): string {
    const code = record.status !== null ? String(record.status) : 'no response'
    const ms = record.elapsedMs
    const duration = ms < 1000 ? `${ms} ms` : `${(ms / 1000).toFixed(1)} s`
    return `${requestName(record.relative)} · ${code} · ${duration}`
}

const NOTE_TEXT = (note: ImportNote): string => {
    switch (note.kind) {
        case 'flagOmitted':
            return 'Presentation and globbing flags were left out.'
        case 'authRemoved':
            return `The authentication credential was removed: store its value in Secrets as ${note.reference}.`
        case 'headerReplaced':
            return `A credential header now uses {{${note.variable}}}: store its value in Secrets as ${note.reference}.`
        case 'compressed':
            return '--compressed became Accept-Encoding: identity.'
        case 'emptyCookie':
            return 'The empty cookie option added no cookie.'
    }
}

const MONO = "ui-monospace, 'SF Mono', Menlo, monospace"
const faint = { color: 'var(--v2-faint)' }
const soft = { color: 'var(--v2-soft)' }
export const TEXTAREA_STYLE = {
    border: '1px solid var(--v2-rule)',
    borderRadius: 8,
    background: 'var(--v2-paper)',
    color: 'var(--v2-ink)',
    fontFamily: MONO,
    fontSize: 12.5,
    lineHeight: 1.6,
    padding: 12,
    minHeight: 140,
    width: '100%',
    resize: 'vertical' as const,
}

export interface EditorHandle {
    /** Protects any edit not yet acknowledged; resolves whether everything typed is now kept on this Mac. */
    flush: () => Promise<boolean>
    /** The operator chose to close without the latest edits. */
    abandon: () => void
}

interface Props {
    initial: DocumentView
    notes: ImportNote[]
    call: WorkbenchCall
    schemas: string[]
    historyKey: string
    onClosed: (id: string) => void
    register?: (handle: EditorHandle) => void
    context?: string | null
    running?: RunningView[]
    review?: SendReviewView | null
}

/**
 * One request document as R2App draws it (C41): the method, URL and Send
 * on one line with the save state beside them, the Params / Headers / Body
 * / Auth / Variables / Preview sub-tabs on the left and the response pane
 * on the right. The C14/C15 behaviour is the legacy editor's, ported: the
 * editor text lives here (React owns immediate input); Rust owns the
 * baseline and revision; Save and Send take the fields the editor holds at
 * that moment; typing pauses protect the snapshot on this Mac; a reply
 * never overwrites newer typing.
 */
export function RequestEditor({ initial, notes, call, schemas, historyKey, onClosed, register, context = null, running = [], review = null }: Props) {
    const ids = useId()
    const [doc, setDoc] = useState(initial)
    const [fields, setFields] = useState(initial.fields)
    const fieldsRef = useRef(initial.fields)
    const revisionRef = useRef(initial.revision)
    const idRef = useRef(initial.id)
    const timer = useRef<ReturnType<typeof setTimeout> | null>(null)
    const editGen = useRef(0)
    const markedGen = useRef(0)
    const sentGen = useRef(0)
    const ackGen = useRef(0)
    const [status, setStatus] = useState('')
    const [saving, setSaving] = useState(false)
    const [preview, setPreview] = useState<Preview | null>(null)
    const [run, setRun] = useState<RunView | null>(null)
    const [sending, setSending] = useState(false)
    const [sub, setSub] = useState<Sub>('params')
    const [asText, setAsText] = useState<Record<RowKind, boolean>>({
        query: false,
        headers: false,
    })
    const [conflict, setConflict] = useState<'changed' | 'deleted' | 'interrupted' | null>(initial.interrupted ? 'interrupted' : initial.conflict)

    const adopt = useCallback((next: DocumentView, editor: Fields | null) => {
        setDoc(next)
        revisionRef.current = next.revision
        setConflict(next.interrupted ? 'interrupted' : next.conflict)
        if (editor !== null) {
            fieldsRef.current = editor
            setFields(editor)
        }
    }, [])

    const protect = useCallback((): Promise<boolean> => {
        timer.current = null
        const edit = editGen.current
        sentGen.current = Math.max(sentGen.current, edit)
        return call({
            kind: 'protect',
            id: idRef.current,
            revision: revisionRef.current,
            fields: fieldsRef.current,
            edit,
        }).then((r) => {
            if (r.kind === 'protected') {
                ackGen.current = Math.max(ackGen.current, edit)
                return true
            }
            setStatus(resultText(r) ?? '')
            return false
        })
    }, [call])

    const flush = useCallback((): Promise<boolean> => {
        const waiting = timer.current !== null
        if (timer.current !== null) clearTimeout(timer.current)
        if (waiting || editGen.current > ackGen.current) return protect()
        return Promise.resolve(true)
    }, [protect])

    const abandon = useCallback(() => {
        if (timer.current !== null) clearTimeout(timer.current)
        timer.current = null
        ackGen.current = editGen.current
    }, [])

    const registerRef = useRef(register)
    registerRef.current = register
    useEffect(() => {
        registerRef.current?.({ flush, abandon })
        return () => {
            const left = flush()
            registerRef.current?.({ flush: () => left, abandon: () => {} })
        }
    }, [flush, abandon])

    // The status line's last word (a save's, a send's completion, a refusal) gives way to the state once the
    // request is edited again; only an action still in flight keeps its line.
    const settle = () => setStatus((s) => (s === C.sending || s === C.waitingReview || s === 'Saving…' ? s : ''))

    const edit = (patch: Partial<Fields>) => {
        const next = { ...fieldsRef.current, ...patch }
        fieldsRef.current = next
        setFields(next)
        // Every edit, not only the one that first makes the request dirty: a send from an already dirty (or new)
        // request left its completion standing through the next edits, since dirty never changed.
        settle()
        const generation = ++editGen.current
        if (markedGen.current <= sentGen.current) {
            markedGen.current = generation
            void call({ kind: 'editing', id: idRef.current, edit: generation })
        }
        if (timer.current !== null) clearTimeout(timer.current)
        timer.current = setTimeout(() => void protect(), PROTECT_DELAY_MS)
    }

    const reload = async () => {
        const r = await call({ kind: 'openRequest', relative: doc.relative })
        if (r.kind === 'document') adopt(r.document, r.document.fields)
    }

    const save = async () => {
        const snapshot = fieldsRef.current
        const edit = editGen.current
        if (timer.current !== null) {
            clearTimeout(timer.current)
            timer.current = null
        }
        sentGen.current = Math.max(sentGen.current, edit)
        setSaving(true)
        setStatus('Saving…')
        const r = await call({
            kind: 'save',
            id: idRef.current,
            revision: revisionRef.current,
            fields: snapshot,
            edit,
        })
        setSaving(false)
        if (r.kind === 'saved' || r.kind === 'unchanged') {
            ackGen.current = Math.max(ackGen.current, edit)
            adopt(r.document, null)
            if (fieldsRef.current !== snapshot) {
                setStatus('Saved. Edits made while saving are kept unsaved.')
                void protect()
            } else {
                setStatus(r.kind === 'saved' ? 'Saved' : 'No changes to save')
            }
            return
        }
        if (r.kind === 'saveRefused') {
            if (r.refusal.kind === 'conflict') setConflict('changed')
            if (r.refusal.kind === 'interrupted' || r.refusal.kind === 'io') setConflict('interrupted')
            setStatus(saveRefusalText(r.refusal))
            return
        }
        if (r.kind === 'refused' && r.problem.kind === 'stale') await reload()
        setStatus(resultText(r) ?? '')
    }

    const resolve = async (choice: 'useDisk' | 'keepMine') => {
        const r = await call({
            kind: 'resolve',
            id: idRef.current,
            revision: revisionRef.current,
            fields: fieldsRef.current,
            choice,
        })
        if (r.kind === 'closed') return onClosed(r.id)
        if (r.kind === 'document') {
            adopt(r.document, choice === 'useDisk' ? r.document.fields : null)
            setStatus(choice === 'useDisk' ? 'Using the files on disk. Your version was kept privately.' : 'Your edits now apply to the files on disk. Save to write them.')
            return
        }
        setStatus(resultText(r) ?? '')
    }

    const discard = async () => {
        const r = await call({ kind: 'discardDraft', id: idRef.current })
        if (r.kind === 'closed') return onClosed(r.id)
        if (r.kind === 'document') {
            ackGen.current = editGen.current
            adopt(r.document, r.document.fields)
            setStatus('Draft discarded')
            return
        }
        setStatus(resultText(r) ?? '')
    }

    const associate = async (schema: string) => {
        const r = await call({
            kind: 'associateSchema',
            id: idRef.current,
            revision: revisionRef.current,
            fields: fieldsRef.current,
            schema: schema === '' ? null : schema,
        })
        if (r.kind === 'document') adopt(r.document, null)
        else setStatus(resultText(r) ?? '')
    }

    const sendNow = async (reviewId: string | null) => {
        const snapshot = fieldsRef.current
        setSending(true)
        setRun(null)
        setStatus(reviewId ? C.waitingReview : C.sending)
        const r = await call(
            reviewId
                ? {
                      kind: 'apply',
                      review: reviewId,
                      id: idRef.current,
                      revision: revisionRef.current,
                      fields: snapshot,
                      context,
                  }
                : {
                      kind: 'send',
                      id: idRef.current,
                      revision: revisionRef.current,
                      fields: snapshot,
                      context,
                  }
        )
        setSending(false)
        if (r.kind === 'ran') {
            setRun(r.run)
            setStatus(completionText(r.run.record))
            return
        }
        if (r.kind === 'reviewRequired') {
            setStatus(C.reviewBelow)
            return
        }
        if (r.kind === 'refused' && r.problem.kind === 'stale') await reload()
        setStatus(resultText(r) ?? '')
    }

    const readPreview = useCallback(async () => {
        const r = await call({
            kind: 'preview',
            id: idRef.current,
            fields: fieldsRef.current,
        })
        if (r.kind === 'preview') setPreview(r.preview)
        else setStatus(resultText(r) ?? '')
    }, [call])
    // Variables and Preview read the rendered request when they open.
    useEffect(() => {
        if (sub === 'variables' || sub === 'preview') void readPreview()
    }, [sub, readPreview])

    const saveRef = useRef(save)
    saveRef.current = save
    useEffect(() => {
        const onSave = () => void saveRef.current()
        window.addEventListener(SAVE_DOCUMENT_EVENT, onSave)
        return () => window.removeEventListener(SAVE_DOCUMENT_EVENT, onSave)
    }, [])

    const dirty = doc.new || doc.metadataDirty || !same(fields, doc.saved)
    const name = requestName(doc.relative)
    const state = doc.new ? C.state.new : dirty ? C.state.unsaved : C.state.saved
    // Metadata changes the core reports (a schema association) make the request dirty without an edit here.
    useEffect(() => {
        if (dirty) setStatus((s) => (s === C.sending || s === C.waitingReview || s === 'Saving…' ? s : ''))
    }, [dirty])
    const url = splitUrl(fields.url)

    const rowsTable = (kind: RowKind) => {
        const text = kind === 'query' ? fields.query : fields.headers
        const rows = parseRows(text, kind)
        const textMode = asText[kind] || rows === null
        const write = (next: Row[]) => edit(kind === 'query' ? { query: serializeRows(next, kind) } : { headers: serializeRows(next, kind) })
        const label = kind === 'query' ? C.sub.params : C.sub.headers
        return (
            <>
                <div className='flex flex-wrap items-center' style={{ gap: 8 }}>
                    <Btn disabled={textMode} onClick={() => write([...(rows ?? []), { enabled: true, name: '', value: '' }])}>
                        {C.addRow[kind === 'query' ? 'params' : 'headers']}
                    </Btn>
                    {rows === null ? (
                        <span className='text-[12px]' style={faint}>
                            {C.textOnly}
                        </span>

exec
