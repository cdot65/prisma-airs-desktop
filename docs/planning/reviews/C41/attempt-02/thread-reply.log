/// `Name: value` rows (blank lines skipped).
pub fn header_rows(text: &str) -> Result<Vec<Row>, FieldProblem> {
    rows(text, ':', FieldName::Headers, true)
}

/// `name=value` rows (blank lines skipped; values kept verbatim).
pub fn query_rows(text: &str) -> Result<Vec<Row>, FieldProblem> {
    rows(text, '=', FieldName::Query, false)
}

fn rows(text: &str, split: char, field: FieldName, trim: bool) -> Result<Vec<Row>, FieldProblem> {
    text.lines()
        .enumerate()
        .filter(|(_, l)| !l.trim().is_empty())
        .map(|(i, line)| {
            let (enabled, line) = match line.strip_prefix("# ") {
                Some(rest) => (false, rest),
                None => (true, line),
            };
            let (name, value) = line
                .split_once(split)
                .ok_or(FieldProblem::at(field, Some(i)))?;
            let name = name.trim();
            if name.is_empty() || name.starts_with("# ") || name.contains(['\r', '=']) {
                return Err(FieldProblem::at(field, Some(i)));
            }
            Ok(Row {
                name: name.to_owned(),
                value: if trim { value.trim() } else { value }.to_owned(),
                enabled,
            })
        })
        .collect()
}

pub(crate) fn valid_reference(value: &str) -> bool {
    !value.is_empty()
        .chars()
        .map(|c| match c {
            '/' | '\\' | ':' => '-',
            c if c.is_control() => ' ',
            c => c,
        })
        .collect();
    let cleaned = cleaned.trim().trim_start_matches('.').trim().to_owned();
    if cleaned.is_empty() {
        "request".into()
    } else {
        cleaned.chars().take(120).collect()
    }
}

/// The request file and its body sidecar for an entry (v1's layout).
pub fn paths(entry: &Entry) -> (String, String) {
    let mut parts: Vec<String> = entry
        .folder
        .split('/')
        .filter(|p| !p.is_empty())
        .map(segment)
        .collect();
    let name = segment(&entry.name);
    parts.push(format!("{name}{}", project::REQUEST_SUFFIX));
    let relative = parts.join("/");
    let stem = relative.trim_end_matches(".toml");
    let body = format!(
        "{stem}.{}",
        if entry.body_kind == "json" {
            "body.json"
        } else {
            "body.txt"
        }
    );
    (relative, body)
}

fn rows(entries: &[Row]) -> ArrayOfTables {
    let mut rows = ArrayOfTables::new();
    for row in entries {
        let mut table = Table::new();
        table["name"] = value(&row.name);
        table["value"] = value(&row.value);
        if !row.enabled {
            table["enabled"] = value(false);
        }
        rows.push(table);
    }
    rows
}

pub fn request_text(entry: &Entry, body: &str) -> String {
    let mut doc = DocumentMut::new();
    doc["format_version"] = value(1);
    doc["id"] = value(&entry.id);
    doc["method"] = value(&entry.method);
    doc["url"] = value(&entry.url);
    if !entry.body.is_empty() {
        doc["body"] = value(body);
    }
    if entry.body_kind != "text" {
        doc["body_kind"] = value(&entry.body_kind);
    }
    if !entry.headers.is_empty() {
        doc["headers"] = Item::ArrayOfTables(rows(&entry.headers));
    }
    if !entry.query.is_empty() {
        doc["query"] = Item::ArrayOfTables(rows(&entry.query));
    }
    if entry.auth == "oauth2" {
    preview: '{"custom_topics":["Finance"]}',
    previewBytes: 29,
    tokenDropped: false,
}

