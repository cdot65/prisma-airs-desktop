   436	/** The collection's history: what was sent, never sent again. */
   437	function History({ call, revision, onShow }: { call: WorkbenchCall; revision: string; onShow: (run: RunView) => void }) {
   438	    const [runs, setRuns] = useState<RunRecord[]>([])
   439	    const [more, setMore] = useState(false)
   440	    const [message, setMessage] = useState('')
   441	    useEffect(() => {
   442	        let live = true
   443	        void call({ kind: 'history', before: null }).then((r) => {
   444	            if (!live) return
   445	            if (r.kind === 'history') {
   446	                setRuns(r.runs)
   447	                setMore(r.more)
   448	            } else setMessage(resultText(r) ?? '')
   449	        })
   450	        return () => {
   451	            live = false
   452	        }
   453	    }, [call, revision])
   454	    const older = async () => {
   455	        const last = runs.at(-1)
   456	        if (!last) return
   457	        const r = await call({ kind: 'history', before: last.id })
   458	        if (r.kind === 'history') {
   459	            setRuns((x) => [...x, ...r.runs])
   460	            setMore(r.more)
   461	        }
   462	    }
   463	    const clear = async () => {
   464	        const r = await call({ kind: 'clearHistory' })
   465	        if (r.kind === 'done') {
   466	            setRuns([])
   467	            setMore(false)
   468	        } else setMessage(resultText(r) ?? '')
   469	    }
   470	    return (
   471	        <section aria-label='History' data-slot='workbench-history' className='flex flex-col text-[13px]' style={{ gap: 8, margin: '12px 14px' }}>
   472	            <p className='text-[12px]' style={soft}>
   473	                {C.historyLead}
   474	            </p>
   475	            {message ? <p role='alert'>{message}</p> : null}
   476	            {runs.length === 0 ? <p style={faint}>{C.historyEmpty}</p> : null}
   477	            <ul className='flex flex-col' style={{ gap: 8 }}>
   478	                {runs.map((r) => {
   479	                    const t = tone(r)
   480	                    const summary = `${r.method} ${r.relative.replace(/\.request\.toml$/, '')} · ${runSummary(r)} · ${new Date(r.at * 1000).toLocaleString()}`
   481	                    return (
   482	                        <li key={r.id}>
   483	                            <button
   484	                                type='button'
   485	                                aria-label={summary}
   486	                                onClick={() =>
   487	                                    void call({ kind: 'showRun', run: r.id }).then((x) => {
   488	                                        if (x.kind === 'ran') onShow(x.run)
   489	                                        else setMessage(resultText(x) ?? '')
   490	                                    })
   491	                                }
   492	                                className='flex w-full min-h-0 items-center rounded-[8px] border text-left'
   493	                                style={{
   494	                                    gap: 10,
   495	                                    padding: '10px 12px',
   496	                                    borderColor: 'var(--v2-rule)',
   497	                                    background: 'var(--v2-paper)',
   498	                                    color: 'var(--v2-ink)',
   499	                                }}
   500	                                data-slot='history-run'
   501	                            >
   502	                                <span className='rounded-[6px] text-[12px] font-bold' style={{ padding: '2px 8px', background: t.bg, color: t.fg }}>
   503	                                    {t.text}
   504	                                </span>
   505	                                <span className='min-w-0 flex-grow truncate'>{`${r.method} ${requestName(r.relative)} · ${new Date(r.at * 1000).toLocaleString()}`}</span>
   506	                                <span className='text-[12px]' style={faint}>
   507	                                    {elapsedText(r.elapsedMs)}
   508	                                </span>
   509	                            </button>
   510	                        </li>
   511	                    )
   512	                })}
   513	            </ul>
   514	            <div className='flex flex-wrap' style={{ gap: 8 }}>
   515	                {more ? <Btn onClick={() => void older()}>{C.older}</Btn> : null}
   516	                {runs.length ? (
   517	                    <Btn tier='tertiary' onClick={() => void clear()}>
   518	                        {C.clearHistory}
   519	                    </Btn>
   520	                ) : null}
   521	                <Btn tier='tertiary' onClick={() => void call({ kind: 'clearCookies' }).then((r) => setMessage(r.kind === 'done' ? C.cookiesCleared : (resultText(r) ?? '')))}>
   522	                    {C.clearCookies}
   523	                </Btn>
   524	            </div>
   525	        </section>
   526	    )
   527	}

