        .sending
        .review
        .as_ref()
        .map(|p| p.view.clone());
    drop(state);
    let Some(view) = view else {
        return Step::Done(Box::new(refusal(SendRefusal::ReviewMissing)));
    };
    let inner = Arc::clone(inner);
    Step::Later(Box::pin(async move {
