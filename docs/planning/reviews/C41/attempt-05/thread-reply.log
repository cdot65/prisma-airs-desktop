    24	/** The status pill's tone: the code's class, a failure, or a run that never completed. */
    25	function tone(record: RunRecord): {
    26	    fg: string
    27	    bg: string
    28	    text: string
    29	    glyph: 'check' | 'alert' | 'ban' | 'x'
    30	} {
    31	    if (record.state === 'completed' && record.status !== null) {
    32	        const code = record.status
    33	        return code < 300
    34	            ? {
    35	                  fg: 'var(--v2-ok)',
    36	                  bg: 'var(--v2-ok-bg)',
    37	                  text: `${code} ${code === 200 ? 'OK' : ''}`.trim(),
    38	                  glyph: 'check',
    39	              }
    40	            : code < 500
    41	              ? {
    42	                    fg: 'var(--v2-flag)',
    43	                    bg: 'var(--v2-flag-bg)',
    44	                    text: String(code),
    45	                    glyph: 'alert',
    46	                }
    47	              : {
    48	                    fg: 'var(--v2-block)',
    49	                    bg: 'var(--v2-block-bg)',
    50	                    text: String(code),
    51	                    glyph: 'ban',
    52	                }
    53	    }
    54	    const text = record.state === 'interrupted' ? 'Interrupted' : record.state === 'cancelled' ? 'Cancelled' : record.state === 'running' ? 'Running' : 'Failed'
    55	    return { fg: 'var(--v2-block)', bg: 'var(--v2-block-bg)', text, glyph: 'x' }
    56	}
    57	
    58	export function elapsedText(ms: number): string {
    59	    return ms < 1000 ? `${ms} ms` : `${(ms / 1000).toFixed(2)} s`
