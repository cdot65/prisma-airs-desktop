    11	type ResponseTab = 'body' | 'headers' | 'details' | 'history'
    12	const TABS: ResponseTab[] = ['body', 'headers', 'details', 'history']
    13	
    14	const faint = { color: 'var(--v2-faint)' }
    15	const soft = { color: 'var(--v2-soft)' }
