++++const answers =
++++    (extra: (request: WorkbenchRequest) => WorkbenchResult | null = () => null) =>
++++    (request: WorkbenchRequest): WorkbenchResult => {
++++        const e = extra(request)
++++        if (e) return e
++++        switch (request.kind) {
++++            case 'openRequest':
++++                return document()
++++            case 'send':
++++                return { kind: 'ran', run: ran }
++++            case 'protect':
++++                return { kind: 'protected', id: request.id }
++++            case 'history':
++++                return {
++++                    kind: 'history',
++++                    runs: [ran.record, older.record],
++++                    more: false,
++++                }
++++            case 'showRun':
++++                return {
++++                    kind: 'ran',
++++                    run: request.run === older.record.id ? older : ran,
++++                }
++++            case 'preview':
++++                return {
++++                    kind: 'preview',
++++                    preview: {
++++                        method: 'GET',
++++                        url: request.fields.url,
++++                        headers: [['accept', 'application/json']],
++++                        query: [['page', '1']],
++++                        bodyKind: 'text',
++++                        body: '',
++++                        bodyBytes: 0,
++++                        variables: [],
++++                        unresolved: [],
++++                        missingSecrets: [],
++++                        auth: null,
++++                        authReferences: [],
++++                        problem: null,
++++                        jsonWarning: false,
++++                    },
++++                }
++++            case 'save':
++++                return {
++++                    kind: 'saved',
++++                    document: {
++++                        ...document(request.fields).document,
++++                        revision: '2'.repeat(32),
++++                    },
++++                }
++++            default:
++++                return { kind: 'done' }
++++        }
++++    }
