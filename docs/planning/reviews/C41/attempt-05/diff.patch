++                        variables: [],
++                        unresolved: [],
++                        missingSecrets: [],
++                        auth: null,
++                        authReferences: [],
++                        problem: null,
++                        jsonWarning: false,
++                    },
++                }
++            case 'save':
++                return {
++                    kind: 'saved',
++                    document: {
++                        ...document(request.fields).document,
++                        revision: '2'.repeat(32),
++                    },
++                }
++            default:
