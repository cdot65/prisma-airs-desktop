++                }
++            case 'preview':
++                return {
++                    kind: 'preview',
++                    preview: {
++                        method: 'GET',
++                        url: request.fields.url,
++                        headers: [['accept', 'application/json']],
++                        query: [['page', '1']],
++                        bodyKind: 'text',
++                        body: '',
