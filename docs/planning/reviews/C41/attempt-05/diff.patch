+++++def composite(app, theme, web_size, prepared):
+++++    name = f"api-{theme.lower()}"
+++++    cap = c29.capture(app, f"parity-{name}")
+++++    if not cap:
+++++        raise SystemExit(f"no capture for {name}")
+++++    os.makedirs(os.path.join(PARITY, "app"), exist_ok=True)
