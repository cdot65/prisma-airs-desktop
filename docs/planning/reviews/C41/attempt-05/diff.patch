+++++        json.dump(["Finance"], f)
+++++    api = c15.Workbench(api_dir)
+++++    try:
+++++        return exercise(app, endpoint, mgmt, api, api_dir, prepared, work, FINAL)
+++++    finally:
+++++        api.stop()
+++++        endpoint.stop()
+++++        mgmt.stop()
+++++        shutil.rmtree(work, ignore_errors=True)
