++++    const onKeyDown = (event: KeyboardEvent<HTMLDivElement>) => {
++++        if (!topmost) return
++++        if (event.key === 'Escape') {
++++            event.preventDefault()
++++            event.stopPropagation()
++++            onClose()
++++            return
++++        }
++++        if (event.key === 'Tab') {
++++            // Keyboard interaction stays inside the topmost dialog.
