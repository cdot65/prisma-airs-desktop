+} {
+    if (record.state === 'completed' && record.status !== null) {
+        const code = record.status
+        return code < 300
+            ? {
+                  fg: 'var(--v2-ok)',
+                  bg: 'var(--v2-ok-bg)',
+                  text: `${code} ${code === 200 ? 'OK' : ''}`.trim(),
+                  glyph: 'check',
+              }
+            : code < 500
+              ? {
+                    fg: 'var(--v2-flag)',
+                    bg: 'var(--v2-flag-bg)',
+                    text: String(code),
+                    glyph: 'alert',
+                }
+              : {
+                    fg: 'var(--v2-block)',
+                    bg: 'var(--v2-block-bg)',
+                    text: String(code),
+                    glyph: 'ban',
+                }
+    }
