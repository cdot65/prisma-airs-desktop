   432	function History({ call, revision, onShow }: { call: WorkbenchCall; revision: string; onShow: (run: RunView) => void }) {
   433	    const [runs, setRuns] = useState<RunRecord[]>([])
   434	    const [more, setMore] = useState(false)
   435	    const [message, setMessage] = useState('')
   436	    useEffect(() => {
   437	        let live = true
   438	        void call({ kind: 'history', before: null }).then((r) => {
   439	            if (!live) return
   440	            if (r.kind === 'history') {
   441	                setRuns(r.runs)
   442	                setMore(r.more)
   443	            } else setMessage(resultText(r) ?? '')
   444	        })
   445	        return () => {
   446	            live = false
   447	        }
   448	    }, [call, revision])
   449	    const older = async () => {
   450	        const last = runs.at(-1)
   451	        if (!last) return
   452	        const r = await call({ kind: 'history', before: last.id })
   453	        if (r.kind === 'history') {
   454	            setRuns((x) => [...x, ...r.runs])
   455	            setMore(r.more)
   456	        }
   457	    }
   458	    const clear = async () => {
   459	        const r = await call({ kind: 'clearHistory' })
   460	        if (r.kind === 'done') {
   461	            setRuns([])
   462	            setMore(false)
   463	        } else setMessage(resultText(r) ?? '')
   464	    }
   465	    return (
   466	        <section aria-label='History' data-slot='workbench-history' className='flex flex-col text-[13px]' style={{ gap: 8, margin: '12px 14px' }}>
   467	            <p className='text-[12px]' style={soft}>
   468	                {C.historyLead}
   469	            </p>
   470	            {message ? <p role='alert'>{message}</p> : null}
   471	            {runs.length === 0 ? <p style={faint}>{C.historyEmpty}</p> : null}
   472	            <ul className='flex flex-col' style={{ gap: 8 }}>
   473	                {runs.map((r) => {
   474	                    const t = tone(r)
   475	                    const summary = `${r.method} ${r.relative.replace(/\.request\.toml$/, '')} · ${runSummary(r)} · ${new Date(r.at * 1000).toLocaleString()}`
   476	                    return (
   477	                        <li key={r.id}>
   478	                            <button
   479	                                type='button'
   480	                                aria-label={summary}
   481	                                onClick={() =>
   482	                                    void call({ kind: 'showRun', run: r.id }).then((x) => {
   483	                                        if (x.kind === 'ran') onShow(x.run)
   484	                                        else setMessage(resultText(x) ?? '')
   485	                                    })
   486	                                }
   487	                                className='flex w-full min-h-0 items-center rounded-[8px] border text-left'
   488	                                style={{
   489	                                    gap: 10,
   490	                                    padding: '10px 12px',
   491	                                    borderColor: 'var(--v2-rule)',
   492	                                    background: 'var(--v2-paper)',
   493	                                    color: 'var(--v2-ink)',
   494	                                }}
   495	                                data-slot='history-run'
   496	                            >
   497	                                <span className='rounded-[6px] text-[12px] font-bold' style={{ padding: '2px 8px', background: t.bg, color: t.fg }}>
   498	                                    {t.text}
   499	                                </span>
   500	                                <span className='min-w-0 flex-grow truncate'>{`${r.method} ${requestName(r.relative)} · ${new Date(r.at * 1000).toLocaleString()}`}</span>
   501	                                <span className='text-[12px]' style={faint}>
   502	                                    {elapsedText(r.elapsedMs)}
   503	                                </span>
   504	                            </button>
   505	                        </li>
   506	                    )
   507	                })}
   508	            </ul>
   509	            <div className='flex flex-wrap' style={{ gap: 8 }}>
   510	                {more ? <Btn onClick={() => void older()}>{C.older}</Btn> : null}
   511	                {runs.length ? (
   512	                    <Btn tier='tertiary' onClick={() => void clear()}>
   513	                        {C.clearHistory}
   514	                    </Btn>
   515	                ) : null}
   516	                <Btn tier='tertiary' onClick={() => void call({ kind: 'clearCookies' }).then((r) => setMessage(r.kind === 'done' ? C.cookiesCleared : (resultText(r) ?? '')))}>
   517	                    {C.clearCookies}
   518	                </Btn>
   519	            </div>
   520	        </section>
   521	    )
   522	}
