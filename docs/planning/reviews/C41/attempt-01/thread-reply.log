    33	export function ToolsSheet({ tool, state, collection, run, onClose, onCreated }: Props) {
    34	    const title = C.tools[tool].replace(/…$/, '')
    35	    return createPortal(
    36	        <Modal label={title} sheet width={620} onClose={onClose} data-slot='workbench-tools'>
    37	            <div className='flex flex-col' style={{ gap: 14 }} data-slot={`workbench-${tool}`}>
