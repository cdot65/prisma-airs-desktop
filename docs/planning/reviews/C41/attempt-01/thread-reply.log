   116	/** A collection with a folder, a root request and two tabs. */
   117	function board(): ShellSnapshot {
   118	    const snapshot = fxApi()
   119	    const collection = snapshot.workbench.collection!
   120	    return {
   121	        ...snapshot,
   122	        workbench: {
   123	            ...snapshot.workbench,
   124	            collection: {
   125	                ...collection,
   126	                requests: [
   127	                    ...collection.requests,
   128	                    {
   129	                        relative: 'health.request.toml',
   130	                        id: 'health',
   131	                        method: 'GET',
   132	                        url: 'http://127.0.0.1:8080/health',
   133	                    },
   134	                ],
   135	                environments: [{ name: 'local', origin: 'local' }],
   136	                environment: 'local',
   137	                archives: 2,
   138	            },
   139	        },
   140	    }
   141	}
   142	
   143	const answers =
   144	    (extra: (request: WorkbenchRequest) => WorkbenchResult | null = () => null) =>
   145	    (request: WorkbenchRequest): WorkbenchResult => {
   146	        const e = extra(request)
   147	        if (e) return e
   148	        switch (request.kind) {
   149	            case 'openRequest':
   150	                return document()
   151	            case 'send':
   152	                return { kind: 'ran', run: ran }
   153	            case 'protect':
   154	                return { kind: 'protected', id: request.id }
   155	            case 'history':
   156	                return {
   157	                    kind: 'history',
   158	                    runs: [ran.record, older.record],
   159	                    more: false,
   160	                }
   161	            case 'showRun':
   162	                return {
   163	                    kind: 'ran',
   164	                    run: request.run === older.record.id ? older : ran,
   165	                }
   166	            case 'preview':
   167	                return {
   168	                    kind: 'preview',
   169	                    preview: {
   170	                        method: 'GET',
   171	                        url: request.fields.url,
   172	                        headers: [['accept', 'application/json']],
   173	                        query: [['page', '1']],
   174	                        bodyKind: 'text',
   175	                        body: '',
   176	                        bodyBytes: 0,
   177	                        variables: [],
   178	                        unresolved: [],
   179	                        missingSecrets: [],
   180	                        auth: null,
   181	                        authReferences: [],
   182	                        problem: null,
   183	                        jsonWarning: false,
   184	                    },
   185	                }
   186	            case 'save':
   187	                return {
   188	                    kind: 'saved',
   189	                    document: {
   190	                        ...document(request.fields).document,
   191	                        revision: '2'.repeat(32),
   192	                    },
   193	                }
   194	            default:
   195	                return { kind: 'done' }
   196	        }
   197	    }
