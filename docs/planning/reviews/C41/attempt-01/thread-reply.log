   131	def composite(app, theme, web_size, prepared):
   132	    name = f"api-{theme.lower()}"
   133	    cap = c29.capture(app, f"parity-{name}")
   134	    if not cap:
   135	        raise SystemExit(f"no capture for {name}")
   136	    os.makedirs(os.path.join(PARITY, "app"), exist_ok=True)
   137	    os.makedirs(os.path.join(PARITY, "proto"), exist_ok=True)
   138	    with open(os.path.join(PARITY, "bundle.json"), "w") as f:
   139	        json.dump({"bundle": prepared["bundle"], "executable_sha256": prepared["executable_sha256"], "from": "native-prepare.json",
   140	                   "captured_by": "tools/native-acceptance/acceptance_c41.py", "captured_utc": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())}, f, indent=2)
   141	        f.write("\n")
   142	    app_png = os.path.join(PARITY, "app", f"{name}.png")
   143	    shutil.copy(os.path.join(ROOT, cap), app_png)
   144	    web_w, web_h = web_size
   145	    proto_png = os.path.join(PARITY, "proto", f"{name}.png")
   146	    subprocess.run([sys.executable, "-I", os.path.join(DC, "dc_render.py"), "--board", "R2App", "--prop", "start=api",
   147	                    "--prop", f"theme={theme.lower()}", "--width", str(web_w), "--height", str(web_h), "--out", proto_png], check=True, capture_output=True)
   148	    out = os.path.join(PARITY, f"{name}.png")
   149	    subprocess.run([sys.executable, "-I", os.path.join(DC, "compose.py"), "--left", proto_png, "--right", app_png,
   150	                    "--out", out, "--title", f"API Client · {theme.lower()} · {web_w}×{web_h}"], check=True, capture_output=True)
   151	    return rel(out)
   152	
   153	
   154	def stage_collection(work, origin):
   155	    """A collection in a Git repository: a folder with one request to the loopback topics route, and a root request."""
   156	    repo = os.path.realpath(os.path.join(work, "repo"))
   157	    root = os.path.join(repo, "api")
   158	    os.makedirs(os.path.join(root, "topics"))
   159	    with open(os.path.join(root, "collection.toml"), "w") as f:
   160	        f.write(f'format_version = 1\nid = "c41"\nname = "Topics API"\n\n[variables]\nbase = "{origin}"\n')
   161	    with open(os.path.join(root, "topics", "list.request.toml"), "w") as f:
   162	        f.write(c15.request("list", "GET", "{{base}}/topics"))
   163	    with open(os.path.join(root, "health.request.toml"), "w") as f:
   164	        f.write(c15.request("health", "GET", "{{base}}/health"))
   165	    env = {"GIT_CONFIG_NOSYSTEM": "1", "GIT_CONFIG_GLOBAL": "/dev/null", "HOME": repo}
   166	    for args in (["init", "-q", "-b", "main"], ["add", "-A"],
   167	                 ["-c", "user.name=fixture", "-c", "user.email=fixture@example.invalid", "commit", "-q", "-m", "fixture"]):
   168	        subprocess.run(["/usr/bin/git", "-C", repo, *args], capture_output=True, text=True, env=env)
   169	    os.makedirs(fx.DATA, exist_ok=True)
   170	    with open(os.path.join(fx.DATA, "fixture-open-folder"), "w") as f:
   171	        f.write(root + "\n")
   172	    return root
   173	
   174	
   175	def main():
   176	    try:
   177	        return run()
   178	    finally:
   179	        sheets.disable()
   180	        fx.sh(["pkill", "-f", fx.PROCESS])
   181	        fx.clean_fixture_root()
   182	
   183	
   184	def run():
   185	    global NATIVE
   186	    prepared = json.load(open(os.path.join(EVIDENCE, "native-prepare.json")))
   187	    bundle = os.path.join(ROOT, prepared["bundle"])
   188	    exe = os.path.join(bundle, "Contents/MacOS/prisma-airs-desktop-v2")
   189	    if c8.sha256(exe) != prepared["executable_sha256"]:
   190	        raise SystemExit("prepared executable changed since native-prepare")
   191	    work = tempfile.mkdtemp(prefix="airs-v2-c41-acceptance-")
   192	    FINAL = NATIVE
   193	    NATIVE = NATIVE + ".staging"
   194	    if os.path.isdir(NATIVE):
   195	        shutil.rmtree(NATIVE)
   196	    os.makedirs(NATIVE)
   197	    c29.NATIVE = NATIVE
   198	    if os.path.isdir(c29.CAPTURES):
   199	        shutil.rmtree(c29.CAPTURES)
   200	    app = fx.App(bundle, work, LOG)
   201	    c29._APP = app
   202	    app.quit()
   203	    fx.clean_fixture_root()
   204	    time.sleep(1.5)
   205	    endpoint = fx.ScanEndpoint(os.path.join(work, "endpoint"), c8.SCAN_KEY)
   206	    endpoint.install_roots()
   207	    endpoint.start()
   208	    mgmt = c8.MgmtEndpoint(os.path.join(work, "endpoint"), os.path.join(work, "mgmt"))
   209	    mgmt.install()
   210	    mgmt.start()
   211	    mgmt.mode()
   212	    api_dir = os.path.join(work, "api-endpoint")
   213	    os.makedirs(api_dir)
   214	    with open(os.path.join(api_dir, "topics.json"), "w") as f:
   215	        json.dump(["Finance"], f)
   216	    api = c15.Workbench(api_dir)
   217	    try:
   218	        return exercise(app, endpoint, mgmt, api, api_dir, prepared, work, FINAL)
   219	    finally:
   220	        api.stop()
   221	        endpoint.stop()
   222	        mgmt.stop()
   223	        shutil.rmtree(work, ignore_errors=True)
   224	
   225	
   226	def exercise(app, endpoint, mgmt, api, api_dir, prepared, work, FINAL):
   227	    global NATIVE
   228	    obs = {"captures": {}}
   229	    collection_root = stage_collection(work, api.origin)
   230	    sheets.enable()
   231	    app.launch()
   232	    pid = app.pid
   233	    app.open_settings()
   234	    app.type_into("AXTextField", "TSG ID (optional)", c8.TSG)
   235	    app.create_custom_tenant("Northwind Health", endpoint.origin)
   236	    app.save_key(c8.SCAN_KEY)
   237	    c8.save_client(app)
   238	    c29.press(app, "AXCheckBox", "Use the new interface")
   239	    app.wait_for(lambda t: fx.App.node(t, "AXHeading", "Home") is not None and c29.nav(t, "Destinations") is not None, 15)
   240	    size_window(app, pid, 1440, 900)
   241	
   242	    # ---- N01: the board ----
   243	    n1 = {}
   244	    app.menu("Go", "API Client")
   245	    tree, n1["screen"] = app.wait_for(lambda t: fx.App.node(t, "AXHeading", "API Client") is not None, 15)
   246	    n1["start"] = app.has_text(tree, "No collection is open.")
   247	    obs["tree_start"] = c29.save_tree("api-start", tree)
   248	    c29.press(app, "AXButton", "Open collection…")
   249	    if sheets.wait_sheet(app, timeout=4):
   250	        sheets.open_file(app, collection_root)
   251	    tree, n1["opened"] = app.wait_for(lambda t: fx.App.node(t, "AXButton", "Open GET topics/list.request.toml") is not None, 15)
   252	    n1["chip"] = node_any(tree, "Collection Topics API") is not None
   253	    n1["environment_chip"] = any(n.get("role") in ("AXPopUpButton", "AXComboBox") and (n.get("label") or "") == "Environment" for n in tree)
   254	    n1["lead"] = any("Collection Topics API · api · Northwind Health" in x for x in app.texts(tree))
   255	    n1["folder"] = fx.App.node(tree, "AXButton", "Collapse folder topics") is not None
   256	    n1["root_request"] = fx.App.node(tree, "AXButton", "Open GET health.request.toml") is not None
   257	    n1["find"] = any(n.get("role") in ("AXTextField", "AXSearchField") and (n.get("label") or "") == "Find request" for n in tree)
   258	    n1["plus"] = node_any(tree, "New request") is not None
   259	    n1["select_prompt"] = app.has_text(tree, "Select a request, or create one with New request.")
