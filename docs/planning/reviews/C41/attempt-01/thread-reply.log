     1	#!/usr/bin/env python3
     2	"""C41 native acceptance (D059): the API Client as the prototype board draws
     3	it (R2App start=api), driven through the real fixture window against the
     4	synthetic scan and management endpoints and a plain-HTTP loopback service
     5	the collection's requests go to.
     6	
     7	Run from the repository root after `xtask native-prepare --chunk C41`.
     8	Requires the macOS Accessibility grant. Synthetic services only; the fixture
     9	data root is removed at the end.
    10	
    11	Checks (docs/architecture/native-checks.json, C41): the board (title row
    12	with the chips, the request tree, the open requests' tabs, the request
    13	line, the sub-tabs, the response pane), Send's completion in the status
    14	region with the body outside it, a later send reflecting the service's
    15	change while History keeps the first response exactly, a new request from
    16	+, a Params row written as a line and read by Preview, the collection
    17	menu's docked sheet (N01); keyboard reach, the focus ring and the measured
    18	layouts in both themes (N02). The parity composites are captured from the
    19	sent state.
    20	"""
    21	
    22	import json
    23	import os
    24	import shutil
    25	import subprocess
    26	import sys
    27	import tempfile
    28	import time
    29	
    30	sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
    31	import fixture_app as fx  # noqa: E402
    32	import acceptance_c08 as c8  # noqa: E402
    33	import acceptance_c15 as c15  # noqa: E402
    34	import acceptance_c28 as c28  # noqa: E402
    35	import acceptance_c29 as c29  # noqa: E402
    36	import acceptance_c31 as c31  # noqa: E402
    37	import native_sheets as sheets  # noqa: E402
    38	
    39	ROOT = os.getcwd()
    40	EVIDENCE = os.path.join(ROOT, "docs/planning/evidence/C41")
    41	NATIVE = os.path.join(EVIDENCE, "native")
    42	RECORD = os.path.join(EVIDENCE, "native-acceptance.json")
    43	PARITY = os.path.join(EVIDENCE, "parity")
    44	DC = os.path.join(ROOT, "tools/parity")
    45	LOG = []
    46	TITLE_BAR = 28
    47	FIRST_BODY = '{"custom_topics":["Finance"]}'
    48	TABS = ("AXRadioButton", "AXButton", "AXCheckBox")
    49	
    50	ANY = ("AXButton", "AXPopUpButton", "AXCheckBox", "AXRadioButton")
    51	
    52	
    53	def node_any(tree, label):
    54	    return next((n for n in tree if (n.get("label") or "") == label and n.get("role") in ANY), None)
    55	
    56	
    57	def press_any(app, label, timeout=8):
    58	    """Presses the control with this exact label whatever role AX gives it: a button with aria-haspopup is an
    59	    AXPopUpButton, one with aria-pressed an AXCheckBox."""
    60	    tree, _ = app.wait_for(lambda t: node_any(t, label) is not None, timeout)
    61	    node = node_any(tree, label)
    62	    if node is None:
    63	        raise RuntimeError(f"no control labelled {label}")
    64	    app.ax("press", node["role"], label)
    65	    time.sleep(0.5)
    66	
    67	
    68	def rel(path):
    69	    return os.path.relpath(path, ROOT)
    70	
    71	
    72	def labels(tree, roles, prefix):
    73	    roles = (roles,) if isinstance(roles, str) else roles
    74	    out = []
    75	    for n in tree:
    76	        label = n.get("label") or ""
    77	        if n.get("role") in roles and label.startswith(prefix) and label not in out:
    78	            out.append(label)
    79	    return out
    80	
    81	
    82	def dialog(tree, label):
    83	    return next((n for n in tree if (n.get("label") or "") == label and n.get("subrole") in ("AXDialog", "AXApplicationDialog")), None)
    84	
    85	
    86	def geometry(tree):
    87	    web = next((n for n in tree if n.get("role") == "AXWebArea" and n.get("size")), None)
    88	    scroll = next((n for n in tree if n.get("role") == "AXScrollArea" and n.get("size")), None)
    89	    win = next((n for n in tree if n.get("role") == "AXWindow"), None)
    90	    return {"web": [int(web["size"][0]), int(web["size"][1])] if web else None,
    91	            "viewport": [int(scroll["size"][0]), int(scroll["size"][1])] if scroll else None,
    92	            "window": win.get("size") if win else None}
    93	
    94	
    95	def size_window(app, pid, w, h):
    96	    fx.sh(["osascript", "-e", f'tell application "System Events" to tell (first application process whose unix id is {pid}) to set position of window 1 to {{0, 0}}'])
    97	    requested = [w, h + TITLE_BAR]
    98	    for _ in range(3):
    99	        c28.set_window_size(pid, requested[0], requested[1])
   100	        time.sleep(0.8)
   101	        g = geometry(app.tree())
   102	        vp = g["viewport"] or g["web"]
   103	        if not vp or vp[1] == h:
   104	            break
   105	        requested = [requested[0], requested[1] + (h - vp[1])]
   106	    return c29.window_frame(pid)
   107	
   108	
   109	def overflow(app):
   110	    tree = app.tree()
   111	    win = next((n for n in tree if n.get("role") == "AXWindow"), None)
   112	    nodes = [n for n in tree if n.get("pos") and n.get("size") and n["size"][0] > 0
   113	             and n.get("role") in ("AXButton", "AXStaticText", "AXTextField", "AXTextArea", "AXSearchField", "AXCheckBox", "AXPopUpButton", "AXComboBox", "AXLink", "AXHeading", "AXRadioButton")]
   114	    right = max(n["pos"][0] + n["size"][0] for n in nodes) if nodes and win else None
   115	    hbars = [n for n in tree if n.get("role") == "AXScrollBar" and (n.get("orientation") == "horizontal" or (n.get("size") and n["size"][0] > n["size"][1]))]
   116	    return {"overflow_px": max(0, right - (win["pos"][0] + win["size"][0])) if right is not None else None, "horizontal_scrollbars": len(hbars)}, tree
   117	
   118	
   119	def board_usable(tree, zoom):
   120	    """The board at this zoom: the tree's search, the URL field, Send (at least 32 CSS px) and the response pane's tabs."""
   121	    find = next((n for n in tree if n.get("role") in ("AXTextField", "AXSearchField") and (n.get("label") or "") == "Find request"), None)
   122	    url = fx.App.node(tree, "AXTextField", "URL")
   123	    send = fx.App.node(tree, "AXButton", "Send")
   124	    body_tab = next((n for n in tree if n.get("role") in TABS and (n.get("label") or "") == "Body" and n.get("pos") and n.get("size")), None)
   125	    out = {"find": find is not None, "url": url is not None, "send_size": send.get("size") if send else None,
   126	           "send_ok": bool(send and send["size"][0] >= 32 * zoom - 1 and send["size"][1] >= 32 * zoom - 1), "response_tabs": body_tab is not None, "zoom": zoom}
   127	    out["ok"] = out["find"] and out["url"] and out["send_ok"] and out["response_tabs"]
   128	    return out
