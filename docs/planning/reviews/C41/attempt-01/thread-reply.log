        names.sort();
        for name in names {
            parts.insert(format!(".inputs/{name}"), tree_hash(&inputs.join(&name))?);
        }
    }
    for (label, hash) in consumed_shared(repo)? {
        parts.insert(label, hash);
    }
    parts.insert("toolchain".to_owned(), toolchain_hash.to_owned());
    Ok(sha256_hex(
