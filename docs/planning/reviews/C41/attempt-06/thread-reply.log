                            aria-label={`${C.chips.collection} ${collection.name}`}
                            className={CHIP}
                            style={chipStyle}
                            onClick={(e) => {
                                e.stopPropagation()
                                setMenu((m) => !m)
                            }}
                            data-slot='collection-chip'
                        >
