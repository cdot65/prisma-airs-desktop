                                background: environment ? 'var(--v2-ok)' : 'var(--v2-faint)',
                            }}
                        />
                        <span style={faint}>{C.chips.environment}</span>
                        <select
                            aria-label={C.chips.environment}
                            value={collection.environment ?? ''}
                            onChange={(e) =>
                                void run({
                                    kind: 'selectEnvironment',
