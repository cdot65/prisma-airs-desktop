/** The method's colour (R2App mColor). */
export function methodColor(method: string): string {
    switch (method.toUpperCase()) {
        case 'GET':
            return 'var(--v2-ok)'
        case 'POST':
            return 'var(--v2-acc)'
        case 'PUT':
        case 'PATCH':
            return 'var(--v2-flag)'
        case 'DELETE':
            return 'var(--v2-block)'
        default:
            return 'var(--v2-soft)'
    }
}

