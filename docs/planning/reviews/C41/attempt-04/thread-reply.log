                                <span className='flex items-center' style={{ gap: 5 }}>
                                    <span
                                        aria-hidden
                                        className='rounded-full'
                                        style={{
                                            width: 6,
                                            height: 6,
                                            background: state.busy ? 'var(--v2-flag)' : 'var(--v2-ok)',
                                        }}
                                    />
                                    {state.busy ? C.working : C.footer.ready}
