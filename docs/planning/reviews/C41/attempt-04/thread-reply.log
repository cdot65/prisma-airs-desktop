                                    </span>
                                ) : null}
                            </button>
                        ))}
                    </div>
                    <div role='tabpanel' id={`${ids}-sub-panel`} className='flex min-h-0 flex-grow flex-col overflow-auto' style={{ gap: 12, padding: '18px 20px' }}>
                        <p className='text-[12px] leading-[1.45]' style={soft}>
                            {C.subText[sub]}
                        </p>
                        {panel}
