//! API Client Send (C15, ADR 0004). A Send carries the editor's fresh
//! snapshot; Rust renders it against the current environment layers,
//! admits it natively before any secret is read, and builds and sends the
//! actual request itself. Known tenant-credential changes stop at an exact
//! review: Apply re-renders the same snapshot against the current files,
//! must reproduce the reviewed digest, takes the operator's native
//! confirmation, consumes the review and sends once. A review is bound to
//! the credentials actually sent too: the authentication (username and
//! secret references), each workbench secret's generation (replacing one
//! starts a new generation) and the Cookie header the jar gives the
//! request; any change needs a fresh review, and the request carries that
//! admitted Cookie header rather than reading the jar again. Transfers run off the
//! workbench lane (at most four at a time, each cancellable); their results
//! go to history and nothing is ever sent again by itself.

use std::collections::BTreeMap;
use std::future::Future;
use std::path::{Path, PathBuf};
use std::pin::Pin;
use std::sync::atomic::{AtomicU64, Ordering};
use std::sync::{Arc, Mutex};
use std::time::Instant;

use serde::Serialize;
use sha2::{Digest, Sha256};
use tokio_util::sync::CancellationToken;
use ts_rs::TS;
use zeroize::Zeroizing;

use super::super::{ConfirmationRequest, Inner, ScanCapability, State, lock};
use super::{
    WorkbenchProblem, WorkbenchRequest, WorkbenchResult, blocking, current, ensure_profile,
    refused, with_open,
};
use crate::context::{ContextRef, ReviewId};
use crate::tenants::Region;
use crate::vault::{RecordId, StorageMode, Vault, VaultError};
use crate::workbench::admission::{
    self, Admitted, CredentialClass, Destinations, Network, OriginClass, Registered, SecretFailure,
    SendRefusal,
};
use crate::workbench::cookies::Jar;
use crate::workbench::document::Fields;
use crate::workbench::environments::{self, Layers};
use crate::workbench::execute::{self, Tokens, Transfer};
use crate::workbench::history::{self, BodyWriter, ExportFailure, RunRecord, RunState};
use crate::workbench::profile;
use crate::workbench::project;
use crate::workbench::render::{self, Body, PartValue, Plan, Secrets};

/// Requests running at once (v1: 4).
pub const MAX_ACTIVE: usize = 4;
const REVIEW_BODY: usize = 4 * 1024;

/// A finished (or shown) run.
#[derive(Clone, Debug, PartialEq, Eq, Serialize, TS)]
#[serde(rename_all = "camelCase")]
pub struct RunView {
    pub record: RunRecord,
    /// The body's first 256 KiB as text, when it is text.
    pub preview: Option<String>,
    pub preview_bytes: u32,
    /// A 401 dropped the minted token: Send again for a new one.
    pub token_dropped: bool,
}

/// A request in flight.
#[derive(Clone, Debug, PartialEq, Eq, Serialize, TS)]
#[serde(rename_all = "camelCase")]
pub struct RunningView {
    pub run: String,
    pub request: String,
    pub method: String,
    /// Bytes sent and received so far.
    #[ts(type = "number")]
    pub bytes: u64,
}

/// A tenant-credential change awaiting the operator (secrets masked).
#[derive(Clone, Debug, PartialEq, Eq, Serialize, TS)]
#[serde(rename_all = "camelCase")]
pub struct SendReviewView {
    pub review: ReviewId,
    pub request: String,
    /// The catalogue operation.
    pub operation: String,
    pub method: String,
    pub url: String,
    pub headers: Vec<(String, String)>,
    pub body: String,
    #[ts(type = "number")]
    pub body_bytes: u64,
    /// Collection files the body sends (bound by their content).
    pub files: Vec<String>,
    /// The origin it goes to.
    pub destination: String,
    /// Seconds since the Unix epoch after which it cannot be applied.
    #[ts(type = "number")]
    pub expires: u64,
}

struct Active {
    cancel: CancellationToken,
    progress: Arc<AtomicU64>,
    request: String,
    method: String,
}

struct Pending {
    view: SendReviewView,
    digest: String,
    context: Option<ContextRef>,
    created: Instant,
}

/// Send state held by the workbench.
#[derive(Default)]
pub(in crate::authority) struct Sending {
    runs: BTreeMap<String, Active>,
    review: Option<Pending>,
    consumed: Vec<ReviewId>,
    tokens: Arc<Tokens>,
    jars: BTreeMap<String, Arc<Mutex<Jar>>>,
    /// Each collection's history once read this session.
    histories: BTreeMap<String, Vec<RunRecord>>,
    /// Workbench secrets replaced this session (by collection and
    /// reference) and the generation each was replaced in.
    secret_generations: BTreeMap<(String, String), u64>,
    generation: u64,
    /// Advanced by every reset: work planned in an earlier epoch was
    /// retired and neither stores nor publishes anything.
    epoch: u64,
    /// Held shared by each private-storage step of a send and exclusively
    /// by reset from before its purge to its end.
    fence: Arc<tokio::sync::RwLock<()>>,
    /// Holds each Send between its document capture and its rendering
    /// while a test holds it, and counts those waiting (fixture builds).
    #[cfg(feature = "test-fixtures")]
    planning: (Arc<tokio::sync::Mutex<()>>, Arc<AtomicU64>),
}

impl Sending {
    /// Reset: running requests are cancelled; tokens, cookies, reviews and
    /// histories are forgotten (their files go with the private folder).
    pub(super) fn clear(&mut self) {
        self.epoch += 1;
        for active in self.runs.values() {
            active.cancel.cancel();
        }
        self.review = None;
        self.tokens.clear();
        self.jars.clear();
        self.histories.clear();
    }

    /// The fence reset holds exclusively while it purges.
    pub(in crate::authority) fn fence(&self) -> Arc<tokio::sync::RwLock<()>> {
        Arc::clone(&self.fence)
    }

    #[cfg(feature = "test-fixtures")]
    pub(in crate::authority) fn planning(&self) -> (Arc<tokio::sync::Mutex<()>>, Arc<AtomicU64>) {
        (Arc::clone(&self.planning.0), Arc::clone(&self.planning.1))
    }

    /// A collection was closed or another opened.
    pub(super) fn leave(&mut self) {
        self.review = None;
    }

    pub(super) fn running(&self) -> Vec<RunningView> {
        self.runs
            .iter()
            .map(|(run, a)| RunningView {
                run: run.clone(),
                request: a.request.clone(),
                method: a.method.clone(),
                bytes: a.progress.load(Ordering::Relaxed),
            })
            .collect()
    }

    pub(super) fn review(&self) -> Option<SendReviewView> {
        self.review.as_ref().map(|p| p.view.clone())
    }

    /// A workbench secret is about to be replaced or removed: what was
    /// planned or reviewed with it no longer goes.
    pub(super) fn secret_changed(&mut self, collection: &str, reference: &str) {
        self.generation += 1;
        self.secret_generations.insert(
            (collection.to_owned(), reference.to_owned()),
            self.generation,
        );
    }

    /// The credentials `plan` would send now: its workbench secrets'
    /// generations and, without a tenant credential, the Cookie header the
    /// collection's jar gives its URL.
    fn credentials(
        &self,
        collection: &str,
        scope: &str,
        plan: &Plan,
        admitted: &Admitted,
    ) -> Credentials {
        let secrets = plan
            .references()
            .into_iter()
            .filter(|r| !r.starts_with(crate::workbench::scm::MANAGED_PREFIX))
            .map(|r| {
                let generation = self
                    .secret_generations
                    .get(&(collection.to_owned(), r.clone()))
                    .copied()
                    .unwrap_or(0);
                (r, generation)
            })
            .collect();
        let cookie = (admitted.class != CredentialClass::Managed)
            .then(|| self.jars.get(scope))
            .flatten()
            .and_then(|jar| {
                jar.lock()
                    .ok()?
                    .header(&admitted.url, history::now() as i64)
            });
        Credentials { secrets, cookie }
    }

    /// The active context changed (tenant switch, credential replacement,
    /// reset): a review bound to another context is retired for good.
    pub(in crate::authority) fn retire(&mut self, keep: Option<&ContextRef>) {
        let retired = self
            .review
            .as_ref()
            .is_some_and(|p| p.context.is_some() && p.context.as_ref() != keep);
        if retired && let Some(p) = self.review.take() {
            self.consumed.push(p.view.review);
        }
    }
}

