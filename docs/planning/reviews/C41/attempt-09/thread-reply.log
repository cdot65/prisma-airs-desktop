                if o.data.private.remove(&name).is_none() {
                    return Err(WorkbenchProblem::Missing);
                }
                if o.data.environment.as_deref() == Some(name.as_str())
                    && !o.catalog.environments.contains(&name)
                {
                    o.data.environment = None;
                }
