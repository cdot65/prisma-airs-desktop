import { type JSX, useId, useMemo, useState } from 'react'
import { createPortal } from 'react-dom'
import type { CollectionView, RequestEntry } from '@prisma-airs/desktop-contracts'
import { Btn, Field } from '../controls'
import { Glyph } from '../icons'
import { Modal } from '../modal'
import { API_COPY as C, methodColor } from './copy'

interface Props {
    collection: CollectionView
    /** Opens a request (the core reads its document). */
    onOpen: (entry: { id: string; relative: string }) => void
    /** Creates a request draft or a folder; resolves to null when created, else the failure's text (said in the dialog). */
    onCreate: (kind: 'request' | 'folder', relative: string) => Promise<string | null>
}

const LIMIT = 300

export const requestName = (relative: string) =>
    relative
        .split('/')
        .pop()
        ?.replace(/\.request\.toml$/, '') ?? relative
const folderOf = (relative: string) => relative.split('/').slice(0, -1).join('/')
const short = (method: string) => (method === 'DELETE' ? 'DEL' : method === 'OPTIONS' ? 'OPT' : method)

/**
 * The request tree (R2App's 286px pane): Find request, +, folders with
 * their counts and the requests under them with their methods. A search
 * lists the matching requests flat. Nothing here sends anything.
 */
export function RequestTree({ collection, onOpen, onCreate }: Props) {
    const ids = useId()
    const [query, setQuery] = useState('')
    const [collapsed, setCollapsed] = useState<Set<string>>(() => new Set())
    const [creating, setCreating] = useState<null | 'request' | 'folder'>(null)
    const [path, setPath] = useState('')
    // A creation that failed, said inside the dialog (the page behind it is inert and hidden while it is open).
    const [failure, setFailure] = useState('')
    const selected = collection.tabs.find((t) => t.id === collection.selected)?.relative ?? null
    const needle = query.trim().toLowerCase()

    // The hierarchy: every folder (listed, or implied by a request's path or a deeper folder), its direct
    // requests, its child folders and the count of every request under it, as the prototype's tree draws them.
    const { children, byFolder, counts } = useMemo(() => {
        const byFolder = new Map<string, RequestEntry[]>()
        const folders = new Set<string>()
        const add = (f: string) => {
            for (let i = f.indexOf('/'); i !== -1; i = f.indexOf('/', i + 1)) folders.add(f.slice(0, i))
            if (f !== '') folders.add(f)
        }
        for (const f of collection.folders) add(f)
        for (const r of collection.requests) {
            const f = folderOf(r.relative)
            add(f)
            byFolder.set(f, [...(byFolder.get(f) ?? []), r])
        }
        const children = new Map<string, string[]>()
        for (const f of [...folders].sort()) children.set(folderOf(f), [...(children.get(folderOf(f)) ?? []), f])
        const counts = new Map<string, number>()
        for (const f of folders) counts.set(f, collection.requests.filter((r) => r.relative.startsWith(`${f}/`)).length)
        return { children, byFolder, counts }
    }, [collection.requests, collection.folders])

    const matching = needle === '' ? null : collection.requests.filter((r) => `${r.method} ${r.relative} ${r.url}`.toLowerCase().includes(needle))

    const request = (r: RequestEntry, depth: number) => (
        <button
            key={r.id}
            type='button'
            aria-label={C.openRequest(r.method, r.relative)}
            aria-current={r.relative === selected ? 'true' : undefined}
            onClick={() => onOpen({ id: r.id, relative: r.relative })}
            className='flex w-full min-h-0 items-center rounded-[6px] text-left text-[12.5px]'
            style={{
                gap: 6,
                height: 30,
                padding: `0 8px 0 ${8 + depth * 14}px`,
                background: r.relative === selected ? 'var(--v2-inset)' : 'transparent',
                color: 'var(--v2-ink)',
                fontWeight: r.relative === selected ? 600 : 400,
            }}
            data-slot='tree-request'
        >
            <span className='shrink-0 font-mono text-[11px] font-bold' style={{ width: 34, color: methodColor(r.method) }}>
                {short(r.method)}
            </span>
            <span className='min-w-0 flex-grow truncate'>{requestName(r.relative)}</span>
        </button>
    )

    const toggle = (f: string) =>
        setCollapsed((s) => {
            const n = new Set(s)
            if (n.has(f)) n.delete(f)
            else n.add(f)
            return n
        })

    let shown = 0
    const requests = (f: string, depth: number) => (byFolder.get(f) ?? []).slice(0, Math.max(0, LIMIT - shown)).map((r) => ((shown += 1), request(r, depth)))
    // A collapsed folder hides its whole subtree: its requests, its child folders and theirs.
    const folder = (f: string): JSX.Element => {
        const open = !collapsed.has(f)
        const depth = f.split('/').length - 1
        return (
            <div key={`f:${f}`} data-slot='tree-folder'>
                <button
                    type='button'
                    aria-expanded={open}
                    aria-label={C.folder(f, open)}
                    onClick={() => toggle(f)}
                    className='flex w-full min-h-0 items-center rounded-[6px] text-left text-[12.5px] font-semibold'
                    style={{
                        gap: 6,
                        height: 30,
                        padding: `0 8px 0 ${8 + depth * 14}px`,
                        color: 'var(--v2-ink)',
                    }}
                >
                    <span className='inline-flex shrink-0' style={{ transform: open ? 'none' : 'rotate(-90deg)' }}>
                        <Glyph name='chev' size={10} color='var(--v2-faint)' />
                    </span>
                    <Glyph name='folder' size={13} color='var(--v2-faint)' />
                    <span className='min-w-0 flex-grow truncate'>{f.split('/').pop()}</span>
                    <span className='text-[12px]' style={{ color: 'var(--v2-faint)' }} data-slot='tree-folder-count'>
                        {counts.get(f) ?? 0}
                    </span>
                </button>
                {open ? (children.get(f) ?? []).map(folder) : null}
                {open ? requests(f, depth + 1) : null}
            </div>
        )
    }
    const list = matching ? matching.slice(0, LIMIT).map((r) => request(r, 0)) : [...(children.get('') ?? []).map(folder), ...requests('', 0)]

    const total = matching ? matching.length : collection.requests.length

    return (
        <form
            aria-label={C.tree}
            data-slot='request-tree'
            className='flex min-h-0 shrink-0 flex-col'
            style={{
                width: 286,
                borderRight: '1px solid var(--v2-rule)',
                background: 'var(--v2-side)',
            }}
            onSubmit={(e) => e.preventDefault()}
        >
            <div className='flex' style={{ gap: 6, padding: 10 }}>
                <label
                    htmlFor={`${ids}-find`}
                    className='flex min-w-0 flex-grow items-center rounded-[7px] text-[12px]'
                    style={{
                        gap: 7,
                        height: 32,
                        padding: '0 9px',
                        background: 'var(--v2-inset)',
                        color: 'var(--v2-faint)',
                    }}
                >
                    <Glyph name='search' size={12} color='var(--v2-faint)' />
                    <input
                        id={`${ids}-find`}
                        type='search'
                        aria-label={C.find}
                        placeholder={C.find}
                        value={query}
                        autoComplete='off'
                        onChange={(e) => setQuery(e.target.value)}
                        className='min-h-0 min-w-0 flex-grow border-0 bg-transparent p-0 text-[13px]'
                        style={{
                            border: 0,
                            minHeight: 0,
                            height: 24,
                            borderRadius: 0,
                            background: 'transparent',
                            color: 'var(--v2-ink)',
                        }}
                        data-slot='tree-search'
                    />
                </label>
                <button
                    type='button'
                    aria-label={C.newRequest}
                    aria-haspopup='dialog'
                    title={C.newRequest}
                    onClick={() => {
                        setPath('')
                        setFailure('')
                        setCreating('request')
                    }}
                    className='grid size-8 min-h-0 shrink-0 place-items-center rounded-[7px] border text-[15px]'
                    style={{
                        borderColor: 'var(--v2-rule)',
                        background: 'var(--v2-paper)',
                        color: 'var(--v2-ink)',
                    }}
                >
                    +
                </button>
            </div>
            <div className='min-h-0 flex-grow overflow-auto' style={{ padding: '0 6px 10px' }} data-slot='tree-list'>
                {list}
                {total === 0 ? (
                    <div className='flex flex-col items-start text-[12.5px] leading-[1.5]' style={{ gap: 10, padding: '16px 10px', color: 'var(--v2-faint)' }} data-slot='tree-empty'>
                        <span>{matching ? C.noMatch(query.trim(), collection.requests.length) : C.noRequests}</span>
                        {matching ? <Btn onClick={() => setQuery('')}>{C.clearSearch}</Btn> : null}
                    </div>
                ) : null}
                {total > LIMIT ? (
                    <p className='text-[12px]' style={{ padding: '8px 10px', color: 'var(--v2-faint)' }}>
                        {C.tooMany(LIMIT, total)}
                    </p>
                ) : null}
            </div>
            {creating
                ? createPortal(
                      <Modal label={creating === 'request' ? C.newRequestTitle : C.newFolder} width={480} onClose={() => setCreating(null)} data-slot='new-request-dialog'>
                          <form
                              className='flex flex-col'
                              style={{ gap: 12 }}
                              onSubmit={(e) => {
                                  e.preventDefault()
                                  const kind = creating
                                  void onCreate(kind, path.trim()).then((failed) => {
                                      if (failed) setFailure(failed)
                                      else setCreating(null)
                                  })
                              }}
                          >
                              <h2 className='text-[17px] font-bold'>{creating === 'request' ? C.newRequestTitle : C.newFolder}</h2>
                              <div role='radiogroup' aria-label={C.create} className='flex' style={{ gap: 12 }}>
                                  {(['request', 'folder'] as const).map((k) => (
                                      <label key={k} className='flex items-center text-[13px]' style={{ gap: 6 }}>
                                          <input type='radio' name={`${ids}-kind`} checked={creating === k} onChange={() => setCreating(k)} />
                                          {k === 'request' ? C.newRequest : C.newFolder}
                                      </label>
                                  ))}
                              </div>
                              <label htmlFor={`${ids}-path`} className='flex flex-col text-[13px] font-medium' style={{ gap: 4 }}>
                                  {creating === 'request' ? C.newRequestPath : C.newFolderPath}
                                  <Field id={`${ids}-path`} value={path} autoFocus autoComplete='off' spellCheck={false} onChange={(e) => setPath(e.target.value)} />
                              </label>
                              {creating === 'request' ? (
                                  <p className='text-[12px]' style={{ color: 'var(--v2-faint)' }}>
                                      {C.newRequestLead}
                                  </p>
                              ) : null}
                              {failure ? (
                                  <p role='alert' className='rounded-[8px] text-[13px]' style={{ padding: '10px 12px', background: 'var(--v2-block-bg)' }} data-slot='new-request-failure'>
                                      {failure}
                                  </p>
                              ) : null}
                              <div className='flex justify-end' style={{ gap: 8 }}>
                                  <Btn onClick={() => setCreating(null)}>{C.cancel}</Btn>
                                  <Btn tier='primary' type='submit' disabled={path.trim() === ''}>
                                      {C.create}
                                  </Btn>
                              </div>
                          </form>
                      </Modal>,
                      document.body
                  )
                : null}
        </form>
    )
}
import { useEffect, useId, useRef, type KeyboardEvent, type ReactNode } from 'react'
import { useShellStore } from './store'

interface ModalProps {
    label: string
    onClose: () => void
    children: ReactNode
    /** Width in CSS px (default 560). */
    width?: number
    /** Inner padding in CSS px (default 20); 0 for a dialog that lays itself out edge to edge. */
    padding?: number
    /** Distance from the top of the window in CSS px (default 4vh); the prototype's palette sits at 90. */
    top?: number
    /** Corner radius in CSS px (default 12; the palette's frame is 14). */
    radius?: number
    /** A sheet docked to the window's right edge under the header (R2App's review sheet, 620px wide, full height). */
    sheet?: boolean
    /**
     * The control focus returns to on close when the opener itself will be gone
     * by then (a menu item that closes with its menu as the dialog opens): an
     * explicit surviving target instead of whatever had focus at mount.
     */
    returnFocus?: HTMLElement | null
    'data-slot'?: string
}

const FOCUSABLE = 'a[href], button:not([disabled]), input:not([disabled]), select:not([disabled]), textarea:not([disabled]), [tabindex]:not([tabindex="-1"])'

/**
 * One topmost modal (I8): dialogs register on a shell-wide stack; only the
 * last is interactive. Lower dialogs are inert and aria-hidden, Tab and
 * Shift-Tab stay inside the topmost dialog, Escape closes the topmost only,
 * focus moves into the dialog on open and back to the opener on close. The
 * page behind every dialog is made inert by the shell (`useModalsOpen`).
 * The dialog element handles its own keys; the topmost dialog also listens
 * on the window for Escape alone, for when focus has left it (a native
 * sheet returned focus elsewhere), and closes only itself.
 */
export function Modal({ label, onClose, children, width = 560, padding = 20, top, radius = 12, sheet = false, returnFocus = null, ...rest }: ModalProps) {
    const id = useId()
    const pushModal = useShellStore((s) => s.pushModal)
    const popModal = useShellStore((s) => s.popModal)
    const modals = useShellStore((s) => s.modals)
    const topmost = modals.length > 0 && modals[modals.length - 1] === id
    const dialog = useRef<HTMLDivElement>(null)
    const opener = useRef<HTMLElement | null>(null)
    const returnRef = useRef(returnFocus)
    returnRef.current = returnFocus
    const focusedOnce = useRef(false)

    useEffect(() => {
        opener.current = document.activeElement instanceof HTMLElement ? document.activeElement : null
        pushModal(id)
        return () => {
            popModal(id)
            // After the commit: the page behind is still inert during cleanup,
            // and an inert ancestor refuses focus (observed in WebKit).
            const target = returnRef.current ?? opener.current
            queueMicrotask(() => {
                // Only when nothing else took focus meanwhile (⌘T replacing the
                // palette hands focus to the tenant list, which must keep it).
                const active = document.activeElement
                if (active && active !== document.body) return
                // The opener may be gone (a "Finish rotation…" that completed):
                // focus the page heading rather than leave it on nothing.
                if (target?.isConnected) target.focus()
                else document.querySelector<HTMLElement>('main h1[tabindex="-1"]')?.focus()
            })
        }
    }, [id, pushModal, popModal])

    useEffect(() => {
        // Initial focus goes into the dialog once, when it opens. Regaining the
        // top after a higher dialog closes must not refocus: that dialog is
        // restoring its own opener, which may be any control here.
        if (!topmost || focusedOnce.current) return
        const node = dialog.current
        if (!node) return
        focusedOnce.current = true
        if (!node.contains(document.activeElement)) {
            // A declared initial control first (wherever it sits), else the first focusable.
            const first = node.querySelector<HTMLElement>('[autofocus]') ?? node.querySelector<HTMLElement>(FOCUSABLE)
            ;(first ?? node).focus()
        }
    }, [topmost])

    // Escape still closes the topmost dialog when focus has left it (a
    // native sheet returning focus to the page body, a click on the scrim's
    // edge): the dialog's own handler stops the event first when it has focus.
    const closeRef = useRef(onClose)
    closeRef.current = onClose
    useEffect(() => {
        if (!topmost) return
        const onWindowKey = (event: globalThis.KeyboardEvent) => {
            if (event.key !== 'Escape' || event.defaultPrevented) return
            const node = dialog.current
            if (node && node.contains(document.activeElement)) return
            event.preventDefault()
            closeRef.current()
        }
        window.addEventListener('keydown', onWindowKey)
        return () => window.removeEventListener('keydown', onWindowKey)
    }, [topmost])

    const onKeyDown = (event: KeyboardEvent<HTMLDivElement>) => {
        if (!topmost) return
        if (event.key === 'Escape') {
            event.preventDefault()
            event.stopPropagation()
            onClose()
            return
        }
        if (event.key === 'Tab') {
            // Keyboard interaction stays inside the topmost dialog.
            const node = dialog.current
            if (!node) return
            const items = Array.from(node.querySelectorAll<HTMLElement>(FOCUSABLE)).filter((el) => !el.hasAttribute('hidden') && el.getAttribute('aria-hidden') !== 'true')
            if (items.length === 0) {
                event.preventDefault()
                node.focus()
                return
            }
            const first = items[0] as HTMLElement
            const last = items[items.length - 1] as HTMLElement
            const active = document.activeElement
            if (event.shiftKey && (active === first || active === node)) {
                event.preventDefault()
                last.focus()
            } else if (!event.shiftKey && active === last) {
                event.preventDefault()
                first.focus()
            }
        }
    }

    return (
        <div
            className={sheet ? 'fixed z-50 flex justify-end' : 'fixed inset-0 z-50 grid place-items-start justify-center'}
            style={sheet ? { inset: 'var(--v2-header, 56px) 0 0 0' } : { paddingTop: top ?? '4vh' }}
            data-v2-scrim=''
            aria-hidden={topmost ? undefined : true}
            inert={topmost ? undefined : true}
            onMouseDown={() => topmost && onClose()}
        >
            <div
                ref={dialog}
                role='dialog'
                aria-modal={topmost ? 'true' : undefined}
                aria-label={label}
                tabIndex={-1}
                data-slot={rest['data-slot'] ?? 'modal'}
                data-topmost={topmost ? 'true' : 'false'}
                onKeyDown={onKeyDown}
                onMouseDown={(e) => e.stopPropagation()}
                className='border'
                // Bounded to the viewport: a tall dialog scrolls inside itself, so its
                // actions stay reachable at the minimum window size and 200% zoom.
                style={
                    sheet
                        ? { width: `min(${width}px, 100vw)`, height: '100%', overflowY: 'auto', padding, borderRadius: 0, borderLeft: '1px solid var(--v2-rule)', boxShadow: '-18px 0 40px rgba(0,0,0,0.18)', background: 'var(--v2-bg)', borderWidth: 0, color: 'var(--v2-ink)' }
                        : { width: `min(${width}px, 92vw)`, maxHeight: '92vh', overflowY: 'auto', padding, borderRadius: radius, boxShadow: '0 24px 60px rgba(0,0,0,0.3)', background: 'var(--v2-paper)', borderColor: 'var(--v2-rule)', color: 'var(--v2-ink)' }
                }
            >
                {children}
            </div>
        </div>
    )
}

/** Whether any modal is open: the shell makes the page behind it inert. */
export function useModalsOpen(): boolean {
    return useShellStore((s) => s.modals.length > 0)
}

 succeeded in 0ms:
//! C41: the API Client as the R2App board draws it, through the production
//! authority interface against a loopback service (screens/api-client-
//! test-cases.md, docs/planning/chunks/C41.md). What the board draws from:
//! the collection view's requests, folders, tabs and selection as requests
//! open and drafts are created; the Params rows the table edits are the
//! file's `name=value` lines, read back by Preview and sent as the query;
//! History lists the runs newest first and a shown run is the record as it
//! was (I5). Nothing here sends by itself: every request is a workbench
//! intent the operator's view would send.

#[path = "../workbench_execution/server.rs"]
#[allow(dead_code)]
mod server;
#[path = "../context_credentials/support.rs"]
#[allow(dead_code)]
mod support;

use std::path::{Path, PathBuf};
use std::sync::Arc;

use desktop_core::fixtures::{self, Handles};
use desktop_core::runtime::OperationId;
use desktop_core::{
    AuthorityHandle, Core, CoreConfig, Delivery, Intent, Observation, Receipt, Refusal,
    ShellSnapshot, ViewScope,
};
use serde_json::{Value, json};
use server::{Answer, Http};

struct Desk {
    #[allow(dead_code)]
    core: Core,
    handle: AuthorityHandle,
    session: String,
    sequence: u64,
    adapters: Handles,
}

impl Desk {
    async fn send(&mut self, intent: Value) -> Result<Receipt, Refusal> {
        let intent: Intent = serde_json::from_value(intent).expect("intent");
        self.sequence += 1;
        self.handle
            .dispatch(
                Delivery {
                    session: self.session.clone(),
                    sequence: self.sequence,
                },
                intent,
            )
            .await
    }

    async fn wb(&mut self, request: Value) -> Value {
        let Receipt::Admitted { operation, .. } = self
            .send(json!({"kind": "workbench", "request": request}))
            .await
            .expect("admitted");
        self.wait(operation.expect("operation")).await
    }

    async fn wait(&self, operation: OperationId) -> Value {
        let Observation::Workbench(handle) = self
            .handle
            .observe(ViewScope::Workbench(operation))
            .expect("observe")
        else {
            unreachable!("workbench scope")
        };
        serde_json::to_value(handle.result().await).expect("json")
    }

    fn snap(&self) -> ShellSnapshot {
        match self.handle.observe(ViewScope::Shell).expect("observe") {
            Observation::Shell { snapshot, .. } => snapshot,
            _ => unreachable!("shell scope"),
        }
    }

    fn collection(&self) -> Value {
        serde_json::to_value(self.snap()).expect("json")["workbench"]["collection"].clone()
    }

    async fn open(&mut self, root: &Path) {
        self.adapters.folders.reply(Some(root.to_path_buf()));
        let r = self.wb(json!({"kind": "openFolder"})).await;
        assert_eq!(r["kind"], "opened", "{r}");
    }

    async fn document(&mut self, relative: &str) -> Value {
        let r = self
            .wb(json!({"kind": "openRequest", "relative": relative}))
            .await;
        assert_eq!(r["kind"], "document", "{r}");
        r["document"].clone()
    }

    async fn send_fields(&mut self, doc: &Value, fields: &Value) -> Value {
        self.wb(json!({"kind": "send", "id": doc["id"], "revision": doc["revision"], "fields": fields, "context": null}))
            .await
    }
}

async fn start() -> Desk {
    let (adapters, handles) = fixtures::adapters();
    let core = Core::new(CoreConfig::default(), adapters);
    core.start();
    let handle = core.operator();
    let session = handle.register_delivery_session().expect("session").nonce;
    Desk {
        core,
        handle,
        session,
        sequence: 0,
        adapters: handles,
    }
}

fn temp(name: &str) -> PathBuf {
    let mut n = [0u8; 8];
    getrandom::fill(&mut n).expect("fixture");
    let p = std::env::temp_dir()
        .canonicalize()
        .expect("fixture")
        .join(format!("airs-v2-c41-{name}-{}", hex::encode(n)));
    std::fs::create_dir_all(&p).expect("fixture");
    p
}

/// A collection inside a Git repository: a folder with one request, and a
/// root request (what the tree lists).
fn collection(origin: &str) -> PathBuf {
    let repo = temp("repo");
    std::fs::create_dir(repo.join(".git")).expect("fixture");
    let root = repo.join("api");
    std::fs::create_dir_all(root.join("topics")).expect("fixture");
    std::fs::write(
        root.join("collection.toml"),
        format!("format_version = 1\nid = \"c41\"\nname = \"Topics API\"\n\n[variables]\nbase = \"{origin}\"\n"),
    )
    .expect("fixture");
    std::fs::write(
        root.join("topics/list.request.toml"),
        "format_version = 1\nid = \"list\"\nmethod = \"GET\"\nurl = \"{{base}}/topics\"\n",
    )
    .expect("fixture");
    std::fs::write(
        root.join("health.request.toml"),
        "format_version = 1\nid = \"health\"\nmethod = \"GET\"\nurl = \"{{base}}/health\"\n",
    )
    .expect("fixture");
    root
}

fn topics_service() -> impl std::future::Future<Output = Http> {
    Http::start(Arc::new(|_| Answer::ok(r#"{"custom_topics":["Finance"]}"#)))
}

fn names(v: &Value, key: &str) -> Vec<String> {
    v.as_array()
        .expect("array")
        .iter()
        .map(|x| x[key].as_str().expect(key).to_owned())
        .collect()
}

#[tokio::test(flavor = "multi_thread")]
async fn the_tree_tabs_and_selection_the_board_draws_from() {
    let http = topics_service().await;
    let root = collection(&http.origin());
    let mut desk = start().await;
    desk.open(&root).await;
    // The tree: the folder and both requests; nothing open yet.
    let c = desk.collection();
    assert_eq!(
        names(&c["requests"], "relative"),
        vec!["health.request.toml", "topics/list.request.toml"],
        "{c}"
    );
    assert!(
        c["folders"]
            .as_array()
            .expect("folders")
            .iter()
            .any(|f| f == "topics"),
        "{c}"
    );
    assert_eq!(c["tabs"].as_array().expect("tabs").len(), 0);
    assert!(c["selected"].is_null());
    // Opening a request: one tab, selected, not a draft.
    let list = desk.document("topics/list.request.toml").await;
    assert_eq!(list["fields"]["method"], "GET");
    assert_eq!(list["new"], false);
    let c = desk.collection();
    assert_eq!(
        names(&c["tabs"], "relative"),
        vec!["topics/list.request.toml"]
    );
    assert_eq!(c["selected"], list["id"]);
    assert_eq!(c["tabs"][0]["draft"], false);
    // A new folder and a new request draft from the tree's +: the draft is a
    // second, selected tab marked new, and the folder is listed.
    let r = desk
        .wb(json!({"kind": "newFolder", "relative": "admin"}))
        .await;
    assert_eq!(r["kind"], "done", "{r}");
    let r = desk
        .wb(json!({"kind": "newRequest", "relative": "admin/create"}))
        .await;
    assert_eq!(r["kind"], "document", "{r}");
    assert_eq!(r["document"]["new"], true);
    let c = desk.collection();
    assert!(
        c["folders"]
            .as_array()
            .expect("folders")
            .iter()
            .any(|f| f == "admin"),
        "{c}"
    );
    assert_eq!(
        names(&c["tabs"], "relative"),
        vec!["topics/list.request.toml", "admin/create.request.toml"]
    );
    assert_eq!(c["selected"], r["document"]["id"]);
    assert_eq!(c["tabs"][1]["new"], true);
    // Selecting the first tab again, then closing the draft, discarding it.
    let r = desk
        .wb(json!({"kind": "selectTab", "id": list["id"]}))
        .await;
    assert_eq!(r["kind"], "done", "{r}");
    assert_eq!(desk.collection()["selected"], list["id"]);
    let r = desk
        .wb(json!({"kind": "closeTab", "id": r#""#.to_owned() + c["tabs"][1]["id"].as_str().expect("id"), "discard": true}))
        .await;
    assert_eq!(r["kind"], "closed", "{r}");
    assert_eq!(
        names(&desk.collection()["tabs"], "relative"),
        vec!["topics/list.request.toml"]
    );
    assert!(http.seen().is_empty(), "nothing was sent");
}

#[tokio::test(flavor = "multi_thread")]
async fn params_rows_are_the_files_lines_read_by_preview_and_sent_as_the_query() {
    let http = topics_service().await;
    let root = collection(&http.origin());
    let mut desk = start().await;
    desk.open(&root).await;
    let list = desk.document("topics/list.request.toml").await;
    // The table's rows: an enabled row and a disabled one, as the editor writes them.
    let mut fields = list["fields"].clone();
    fields["query"] = json!("page=1\n# limit=5");
    let r = desk
        .wb(json!({"kind": "save", "id": list["id"], "revision": list["revision"], "fields": fields, "edit": 1}))
        .await;
    assert_eq!(r["kind"], "saved", "{r}");
    let saved = r["document"].clone();
    assert_eq!(saved["fields"]["query"], "page=1\n# limit=5");
    // The file holds the rows as `[[query]]` tables (name, value, enabled), the form Rust always read.
    let file = std::fs::read_to_string(root.join("topics/list.request.toml")).expect("file");
    assert!(
        file.contains("[[query]]")
            && file.contains("name = \"page\"")
            && file.contains("value = \"1\""),
        "{file}"
    );
    assert!(
        file.contains("name = \"limit\"") && file.contains("enabled = false"),
        "{file}"
    );
    // Preview reads the enabled row only.
    let r = desk
        .wb(json!({"kind": "preview", "id": saved["id"], "fields": saved["fields"]}))
        .await;
    assert_eq!(r["kind"], "preview", "{r}");
    assert_eq!(r["preview"]["query"], json!([["page", "1"]]));
    assert!(
        r["preview"]["url"]
            .as_str()
            .expect("url")
            .ends_with("/topics")
    );
    assert!(http.seen().is_empty(), "preview sends nothing");
    // Send appends it to the URL.
    let r = desk.send_fields(&saved, &saved["fields"]).await;
    assert_eq!(r["kind"], "ran", "{r}");
    assert_eq!(r["run"]["record"]["status"], 200);
    let seen = http.seen();
    assert_eq!(seen.len(), 1);
    assert!(
        seen[0].request_line.starts_with("GET /topics?page=1 "),
        "{}",
        seen[0].request_line
    );
}

#[tokio::test(flavor = "multi_thread")]
async fn history_lists_runs_newest_first_and_a_shown_run_is_the_record_as_it_was() {
    let http = topics_service().await;
    let root = collection(&http.origin());
    let mut desk = start().await;
    desk.open(&root).await;
    let list = desk.document("topics/list.request.toml").await;
    let first = desk.send_fields(&list, &list["fields"]).await;
    assert_eq!(first["kind"], "ran", "{first}");
    let health = desk.document("health.request.toml").await;
    let second = desk.send_fields(&health, &health["fields"]).await;
    assert_eq!(second["kind"], "ran", "{second}");
    let page = desk.wb(json!({"kind": "history", "before": null})).await;
    assert_eq!(page["kind"], "history", "{page}");
    let runs = page["runs"].as_array().expect("runs");
    assert_eq!(runs.len(), 2);
    assert_eq!(runs[0]["id"], second["run"]["record"]["id"], "newest first");
    assert_eq!(runs[0]["relative"], "health.request.toml");
    assert_eq!(runs[1]["relative"], "topics/list.request.toml");
    // Showing the older run is the record, with its body; nothing is sent again.
    let shown = desk
        .wb(json!({"kind": "showRun", "run": runs[1]["id"]}))
        .await;
    assert_eq!(shown["kind"], "ran", "{shown}");
    assert_eq!(shown["run"]["record"], first["run"]["record"]);
    assert_eq!(shown["run"]["preview"], r#"{"custom_topics":["Finance"]}"#);
    assert_eq!(http.seen().len(), 2);
}

