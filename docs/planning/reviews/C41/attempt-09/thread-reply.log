async fn open_request(
    inner: &Arc<Inner>,
    root: &std::path::Path,
    relative: String,
) -> WorkbenchResult {
    let found = lock(inner).ok().and_then(|s| {
        let open = s.workbench.open.as_ref()?;
        let held = open
            .documents
            .values()
            .find(|d| d.relative == relative)
            .map(|d| d.id.clone());
        Some((
            open.catalog.root.clone(),
            held,
            open.catalog
                .requests
                .iter()
                .find(|r| r.relative == relative)
                .cloned(),
        ))
    });
    let Some((folder, held, entry)) = found else {
        return refused(WorkbenchProblem::NoCollection);
    };
    let id = match (held, entry) {
        (Some(id), _) => id,
        (None, Some(entry)) => {
            let read = blocking(Err(ProjectProblem::Io), move || {
                document::open(&folder, &entry)
            })
            .await;
            match read {
                Ok(doc) => {
                    let id = doc.id.clone();
                    let stored = with_open(inner, |o| {
                        o.documents.insert(id.clone(), doc);
                        Ok(())
                    });
                    if let Err(p) = stored {
                        return refused(p);
                    }
                    id
                }
                Err(p) => return refused(WorkbenchProblem::Project(p)),
            }
        }
        (None, None) => return refused(WorkbenchProblem::Missing),
    };
    let view = with_open(inner, |o| {
        o.open_tab(&id);
        o.view(&id).ok_or(WorkbenchProblem::Missing)
    });
    match view {
        Ok(document) => {
            persist_result(
                inner,
                root,
                WorkbenchResult::Document {
                    document,
                    notes: Vec::new(),
                },
            )
            .await
        }
        Err(p) => refused(p),
    }
}

fn request_path(relative: &str) -> String {
    if relative.ends_with(project::REQUEST_SUFFIX) {
        relative.to_owned()
    } else {
        format!("{relative}{}", project::REQUEST_SUFFIX)
    }
}

async fn new_request(
    inner: &Arc<Inner>,
    root: &std::path::Path,
    relative: String,
    fields: Option<Fields>,
    notes: Vec<ImportNote>,
) -> WorkbenchResult {
    let relative = request_path(relative.trim());
    let Some(folder) = collection_root(inner) else {
        return refused(WorkbenchProblem::NoCollection);
    };
    let doc = match document::create(&relative) {
        Ok(d) => d,
        Err(p) => return refused(WorkbenchProblem::Project(p)),
    };
/* C41 API Client: the pretty JSON view numbers its lines from a counter (the numbers are not part of the body's text). */
[data-v2-shell] [data-slot='json-lines'] {
    counter-reset: line;
    white-space: pre;
}
[data-v2-shell] [data-slot='json-lines'] > [data-line]::before {
    counter-increment: line;
    content: counter(line);
    display: inline-block;
    width: 34px;
    padding-right: 12px;
    text-align: right;
    color: var(--v2-faint);
}
/* The request's columns and the response pane stack below the width that fits them (the prototype is fixed-width). */
@media (max-width: 1180px) {
    [data-v2-shell] [data-slot='workbench-columns'] {
        flex-wrap: wrap;
    }
    [data-v2-shell] [data-slot='workbench-response-pane'] {
        flex: 1 1 100% !important;
        max-width: none !important;
        border-top: 1px solid var(--v2-rule);
    }
}
/* Narrower still (a 900-point window at 200%): the request tree sits above the editor instead of beside it. */
@media (max-width: 760px) {
    [data-v2-shell] [data-slot='api-body'] {
        flex-wrap: wrap;
    }
    [data-v2-shell] [data-slot='request-tree'] {
        width: 100% !important;
        max-height: 40vh;
        border-right: 0 !important;
        border-bottom: 1px solid var(--v2-rule);
    }
}
