    /// credentials; Rust decides that from the request itself.
    Send {
        id: String,
        revision: String,
        fields: Fields,
        context: Option<ContextRef>,
    },
    /// Send a reviewed tenant-credential change: the same snapshot must
    /// reproduce the review, and the operator confirms natively.
    Apply {
