        ) : sub === 'variables' ? (
            <>
                {preview ? (
                    preview.variables.length ? (
                        <div role='table' aria-label={C.sub.variables} className='overflow-hidden rounded-[8px] border' style={{ borderColor: 'var(--v2-rule)' }} data-slot='rows-variables'>
                            <div
                                role='row'
                                className='grid text-[12px] font-semibold'
                                style={{
                                    gridTemplateColumns: '1fr 1fr 1fr',
                                    background: 'var(--v2-inset)',
                                    ...faint,
                                }}
                            >
                                <span role='columnheader' style={{ padding: 8 }}>
                                    {C.columns.name}
                                </span>
                                <span role='columnheader' style={{ padding: 8 }}>
                                    Layer
                                </span>
                                <span role='columnheader' style={{ padding: 8 }}>
                                    {C.columns.value}
                                </span>
                            </div>
                            {preview.variables.map((v) => (
                                <div
                                    key={v.name}
                                    role='row'
                                    className='grid'
                                    style={{
                                        gridTemplateColumns: '1fr 1fr 1fr',
                                        borderTop: '1px solid var(--v2-rule)',
                                        fontFamily: MONO,
                                        fontSize: 12,
                                    }}
                                >
                                    <span role='cell' className='break-all' style={{ padding: '10px 8px' }}>
                                        {v.name}
                                    </span>
                                    <span
                                        role='cell'
                                        style={{
                                            padding: '10px 8px',
                                            borderLeft: '1px solid var(--v2-rule)',
                                            ...soft,
                                        }}
                                    >
                                        {String(v.layer)}
                                    </span>
                                    <span
                                        role='cell'
                                        className='break-all'
                                        style={{
                                            padding: '10px 8px',
                                            borderLeft: '1px solid var(--v2-rule)',
                                            ...soft,
                                        }}
                                    >
                                        {v.secret ? `•••• ${v.secret}${v.stored === false ? ' (no value on this Mac)' : ''}` : 'from the environment'}
                                    </span>
                                </div>
                            ))}
                        </div>
                    ) : (
                        <p className='text-[13px]' style={faint}>
                            No variables are used by this request.
                        </p>
                    )
                ) : null}
                {preview?.unresolved.length ? <p role='alert' className='text-[13px]'>{`Unresolved variables: ${preview.unresolved.join(', ')}`}</p> : null}
                <Btn className='self-start' onClick={() => void readPreview()}>
                    {C.readPreview}
                </Btn>
            </>
        ) : (
            <>
                {preview ? (
                    <section aria-label='Request preview' data-slot='workbench-preview' className='flex flex-col text-[13px]' style={{ gap: 8 }}>
                        <pre
                            role='region'
                            aria-label={C.sub.preview}
                            className='break-all whitespace-pre-wrap'
                            style={{
                                ...TEXTAREA_STYLE,
                                minHeight: 0,
                                resize: 'none',
                                margin: 0,
                            }}
                        >
                            {[
                                `${preview.method} ${preview.url}${preview.query.length ? `?${preview.query.map(([n, v]) => `${n}=${v}`).join('&')}` : ''}`,
                                ...preview.headers.map(([n, v]) => `${n}: ${v}`),
                                ...(preview.body ? ['', preview.body] : []),
                            ].join('\n')}
                        </pre>
                        {preview.auth && preview.auth !== 'none' ? <p>{`Authentication: ${preview.auth}`}</p> : null}
                        {preview.unresolved.length ? <p role='alert'>{`Unresolved variables: ${preview.unresolved.join(', ')}`}</p> : null}
                        {preview.missingSecrets.length ? <p role='alert'>{`Secrets without a value on this Mac: ${preview.missingSecrets.join(', ')}`}</p> : null}
                        {preview.problem ? <p role='alert'>{fieldText(preview.problem)}</p> : null}
                        {preview.jsonWarning ? <p>The JSON body does not parse; it is kept exactly as typed.</p> : null}
                    </section>
                ) : null}
                <div className='flex flex-wrap items-center' style={{ gap: 10 }}>
                    <Btn onClick={() => void readPreview()}>{C.readPreview}</Btn>
                    <span className='text-[12px]' style={faint}>
                        {C.previewHint}
                    </span>
                </div>
            </>
        )

    const extra = (s: Sub): string => {
        if (s === 'params') return String(enabledCount(fields.query, 'query') || '')
        if (s === 'headers') return String(enabledCount(fields.headers, 'headers') || '')
        if (s === 'body') return fields.body ? fields.bodyKind.toUpperCase() : ''
        return ''
    }

    return (
        <form
            aria-label={`Request ${name}`}
            data-slot='workbench-document'
            className='flex min-h-0 flex-grow flex-col'
            onSubmit={(e) => {
                e.preventDefault()
                void save()
            }}
            onKeyDown={(e) => {
                if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 's') {
                    e.preventDefault()
                    void save()
                }
            }}
        >
            {conflict ? (
                <div
                    role='alert'
                    className='flex flex-col text-[13px]'
                    style={{
                        gap: 8,
                        margin: '12px 20px 0',
                        padding: '12px 14px',
                        borderRadius: 10,
                        background: 'var(--v2-flag-bg)',
                    }}
                    data-slot='workbench-conflict'
                >
                    <p className='font-semibold'>{conflict === 'deleted' ? C.conflict.deleted : conflict === 'interrupted' ? C.conflict.interrupted : C.conflict.changed}</p>
                    <p>{conflict === 'interrupted' ? C.conflict.interruptedText : C.conflict.changedText}</p>
                    <div className='flex flex-wrap' style={{ gap: 8 }}>
                        <Btn onClick={() => void resolve('useDisk')}>{C.conflict.useDisk}</Btn>
                        <Btn onClick={() => void resolve('keepMine')}>{C.conflict.keepMine}</Btn>
                    </div>
                </div>
            ) : null}
            {doc.recovered && !conflict ? (
                <div
                    className='flex flex-col text-[13px]'
                    style={{
                        gap: 8,
                        margin: '12px 20px 0',
                        padding: '12px 14px',
                        borderRadius: 10,
                        background: 'var(--v2-acc-soft)',
                    }}
                    data-slot='workbench-recovered'
                >
                    <p className='font-semibold'>{C.recovered}</p>
                    <p>{C.recoveredText}</p>
                    <Btn className='self-start' onClick={() => void discard()}>
                        {C.discardDraft}
                    </Btn>
                </div>
            ) : null}
            {notes.length ? (
                <div
                    className='flex flex-col text-[13px]'
                    style={{
                        gap: 4,
                        margin: '12px 20px 0',
                        padding: '12px 14px',
                        borderRadius: 10,
                        background: 'var(--v2-acc-soft)',
                    }}
                    data-slot='workbench-notes'
                >
                    <p className='font-semibold'>{C.notes}</p>
                    <ul className='list-disc pl-5'>
                        {notes.map((n, i) => (
                            <li key={i}>{NOTE_TEXT(n)}</li>
                        ))}
                    </ul>
                </div>
            ) : null}
            <div
                className='flex flex-wrap items-center'
                style={{
                    gap: 8,
                    padding: '16px 20px',
                    borderBottom: '1px solid var(--v2-rule)',
                }}
                data-slot='workbench-request-line'
            >
                <div
                    className='flex min-w-0 flex-grow overflow-hidden rounded-[8px] border'
                    style={{
                        height: 34,
                        borderColor: 'var(--v2-rule)',
                        background: 'var(--v2-paper)',
                        flexBasis: 320,
                    }}
                >
                    <span className='relative flex shrink-0 items-center' style={{ width: 86, borderRight: '1px solid var(--v2-rule)' }}>
                        <select
                            aria-label={C.method}
                            value={fields.method}
                            onChange={(e) => edit({ method: e.target.value })}
                            className='h-full w-full min-h-0 appearance-none border-0 bg-transparent font-mono text-[12px] font-bold'
                            style={{
                                border: 0,
                                minHeight: 0,
                                borderRadius: 0,
                                background: 'transparent',
                                padding: '0 24px 0 10px',
                                color: methodColor(fields.method),
                            }}
                        >
                            {(METHODS.includes(fields.method) ? METHODS : [fields.method, ...METHODS]).map((m) => (
                                <option key={m} value={m}>
                                    {m}
                                </option>
                            ))}
                        </select>
                        <span className='pointer-events-none absolute' style={{ right: 8 }}>
                            <Glyph name='chev' size={10} color='var(--v2-faint)' />
                        </span>
                    </span>
                    <span className='flex min-w-0 flex-grow items-center' style={{ padding: '0 12px', gap: 4 }}>
                        {url.base ? (
                            <span
                                aria-hidden
                                className='shrink-0 rounded-[4px] font-mono text-[12px]'
                                style={{
                                    padding: '1px 5px',
                                    background: 'var(--v2-acc-soft)',
                                    color: 'var(--v2-acc)',
                                }}
                            >
                                {url.base}
                            </span>
                        ) : null}
                        <input
                            aria-label={C.url}
                            value={fields.url}
                            autoComplete='off'
                            spellCheck={false}
                            onChange={(e) => edit({ url: e.target.value })}
                            className='min-h-0 min-w-0 flex-grow border-0 bg-transparent font-mono text-[12.5px]'
                            style={{

exec
/bin/zsh -lc "sed -n '820,1030p' apps/desktop/src/v2/workbench/request-editor.tsx; cat apps/desktop/src/v2/workbench/response-pane.tsx" in /Users/cdot/development/redtail/prisma-airs-desktop-v2-c41
 succeeded in 0ms:
                            style={{
                                border: 0,
                                minHeight: 0,
                                borderRadius: 0,
                                background: 'transparent',
                                padding: 0,
                                color: 'var(--v2-ink)',
                            }}
                        />
                    </span>
                </div>
                <Btn tier='primary' className='h-[34px] px-[18px] text-[13px]' disabled={sending} onClick={() => void sendNow(null)}>
                    {C.send}
                </Btn>
                <Btn className='h-[34px]' type='submit' disabled={saving}>
                    {C.save}
                </Btn>
                {dirty && !doc.new && !doc.recovered ? (
                    <Btn tier='tertiary' className='h-[34px]' onClick={() => void discard()}>
                        {C.discardChanges}
                    </Btn>
                ) : null}
                <span
                    role='status'
                    aria-live='polite'
                    className='flex min-w-0 items-center rounded-[8px] border text-[12px]'
                    style={{
                        gap: 6,
                        minHeight: 34,
                        padding: '6px 12px',
                        borderColor: 'var(--v2-rule)',
                        background: 'var(--v2-inset)',
                        color: 'var(--v2-soft)',
                        maxWidth: '100%',
                    }}
                    data-slot='workbench-save-status'
                    data-state={doc.new ? 'new' : dirty ? 'unsaved' : 'saved'}
                >
                    {status === '' || status === 'Saved' ? <Glyph name={dirty ? 'dot' : 'check'} size={12} color={dirty ? 'var(--v2-acc)' : 'var(--v2-ok)'} /> : null}
                    <span className='min-w-0'>{status || state}</span>
                </span>
            </div>
            <div className='flex min-h-0 flex-grow' data-slot='workbench-columns'>
                <div className='flex min-w-0 flex-col' style={{ flex: '1 1 360px', borderRight: '1px solid var(--v2-rule)' }}>
                    <div
                        role='tablist'
                        aria-label={C.request}
                        className='flex shrink-0 flex-wrap'
                        style={{
                            gap: 4,
                            padding: '0 12px',
                            borderBottom: '1px solid var(--v2-rule)',
                        }}
                    >
                        {SUBS.map((s) => (
                            <button
                                key={s}
                                type='button'
                                role='tab'
                                aria-selected={sub === s}
                                aria-controls={`${ids}-sub-panel`}
                                onClick={() => setSub(s)}
                                className='min-h-0 shrink-0 text-[12.5px] font-semibold whitespace-nowrap'
                                style={{
                                    height: 38,
                                    padding: '0 10px',
                                    border: 0,
                                    borderBottom: `2px solid ${sub === s ? 'var(--v2-acc)' : 'transparent'}`,
                                    background: 'transparent',
                                    color: sub === s ? 'var(--v2-ink)' : 'var(--v2-soft)',
                                }}
                            >
                                {C.sub[s]}
                                {extra(s) ? (
                                    <span className='font-normal' style={{ fontSize: 12, ...faint }}>
                                        {' '}
                                        {extra(s)}
                                    </span>
                                ) : null}
                            </button>
                        ))}
                    </div>
                    <div role='tabpanel' id={`${ids}-sub-panel`} className='flex min-h-0 flex-grow flex-col overflow-auto' style={{ gap: 12, padding: '18px 20px' }}>
                        <p className='text-[12px] leading-[1.45]' style={soft}>
                            {C.subText[sub]}
                        </p>
                        {panel}
                    </div>
                </div>
                <ResponsePane
                    run={run}
                    running={running}
                    review={review}
                    call={call}
                    historyKey={historyKey}
                    onApply={() => review && void sendNow(review.review)}
                    onDismiss={() => void call({ kind: 'dismissReview' }).then(() => setStatus(''))}
                />
            </div>
        </form>
    )
}
import { useEffect, useState } from 'react'
import type { RunRecord, RunView, RunningView, SendReviewView } from '@prisma-airs/desktop-contracts'
import { type WorkbenchCall, resultText, runFailureText, runSummary, sizeText } from '../../features/workbench/workbench-call'
import { clockOf } from '../copy'
import { Btn } from '../controls'
import { Glyph } from '../icons'
import { API_COPY as C } from './copy'
import { prettyJson } from './request-rows'
import { requestName } from './request-tree'

type ResponseTab = 'body' | 'headers' | 'details' | 'history'
const TABS: ResponseTab[] = ['body', 'headers', 'details', 'history']

const faint = { color: 'var(--v2-faint)' }
const soft = { color: 'var(--v2-soft)' }
const MONO = "ui-monospace, 'SF Mono', Menlo, monospace"
const BOX = {
    margin: '0 14px 12px',
    border: '1px solid var(--v2-rule)',
    borderRadius: 8,
    background: 'var(--v2-paper)',
}

/** The status pill's tone: the code's class, a failure, or a run that never completed. */
function tone(record: RunRecord): {
    fg: string
    bg: string
    text: string
    glyph: 'check' | 'alert' | 'ban' | 'x'
} {
    if (record.state === 'completed' && record.status !== null) {
        const code = record.status
        return code < 300
            ? {
                  fg: 'var(--v2-ok)',
                  bg: 'var(--v2-ok-bg)',
                  text: `${code} ${code === 200 ? 'OK' : ''}`.trim(),
                  glyph: 'check',
              }
            : code < 500
              ? {
                    fg: 'var(--v2-flag)',
                    bg: 'var(--v2-flag-bg)',
                    text: String(code),
                    glyph: 'alert',
                }
              : {
                    fg: 'var(--v2-block)',
                    bg: 'var(--v2-block-bg)',
                    text: String(code),
                    glyph: 'ban',
                }
    }
    const text = record.state === 'interrupted' ? 'Interrupted' : record.state === 'cancelled' ? 'Cancelled' : record.state === 'running' ? 'Running' : 'Failed'
    return { fg: 'var(--v2-block)', bg: 'var(--v2-block-bg)', text, glyph: 'x' }
}

export function elapsedText(ms: number): string {
    return ms < 1000 ? `${ms} ms` : `${(ms / 1000).toFixed(2)} s`
}

interface Props {
    /** The run Send produced for this request (null before the first send). */
    run: RunView | null
    running: RunningView[]
    review: SendReviewView | null
    call: WorkbenchCall
    /** Changes when history may have changed (the collection, a send). */
    historyKey: string
    onApply: () => void
    onDismiss: () => void
}

/**
 * The response pane (R2App's right 40%): the status line, the Body,
 * Headers, Details and History tabs. A run shown from History is the
 * immutable record of what happened then; nothing here sends anything.
 */
export function ResponsePane({ run, running, review, call, historyKey, onApply, onDismiss }: Props) {
    const [tab, setTab] = useState<ResponseTab>('body')
    const [pretty, setPretty] = useState(true)
    const [fromHistory, setFromHistory] = useState<RunView | null>(null)
    const [message, setMessage] = useState('')
    // A new send shows its own run and returns to Body.
    const runId = run?.record.id ?? null
    useEffect(() => {
        setFromHistory(null)
        setMessage('')
        if (runId) setTab('body')
    }, [runId])
    const shown = fromHistory ?? run
    const record = shown?.record ?? null
    const formatted = shown?.preview != null ? prettyJson(shown.preview) : null

    const save = async () => {
        if (!record) return
        setMessage('')
        const r = await call({ kind: 'saveResponse', run: record.id })
        if (r.kind === 'responseSaved') setMessage(C.saved(sizeText(r.bytes), r.name))
        else if (r.kind !== 'cancelled') setMessage(resultText(r) ?? '')
    }
    const copy = async () => {
        if (shown?.preview == null) return
        try {
            await navigator.clipboard.writeText(shown.preview)
            setMessage(C.copied)
        } catch {
            setMessage(C.copyFailed)
        }
    }

    const first = running[0] ?? null
    // Every transfer in flight is in view with its own Cancel, whatever response is being inspected (a run from
    // History shown while a new send runs hid the progress and the cancellation behind the old record; the core
    // runs several sends of one document at once, and only the first was shown).
    const progress = running.map((r, i) => (
        <span key={r.run} role='status' aria-live='polite' className='flex w-full flex-wrap items-center text-[12.5px]' style={{ gap: 8 }} data-slot='workbench-running'>
            {C.sendingProgress(r.method, sizeText(r.bytes))}
            <Btn className='h-7' aria-label={running.length > 1 ? `${C.cancel_} ${i + 1} of ${running.length}` : undefined} onClick={() => void call({ kind: 'cancel', run: r.run })}>
                {C.cancel_}
            </Btn>
        </span>
    ))
    const head = record ? (
        <>
            <span
                className='inline-flex items-center rounded-[6px] font-bold'
                style={{
                    gap: 4,
                    padding: '2px 9px',
                    background: tone(record).bg,
                    color: tone(record).fg,
                }}
                data-slot='response-status'
            >
                <Glyph name={tone(record).glyph} size={11} color={tone(record).fg} />
                {tone(record).text}
            </span>
            <span style={soft}>{elapsedText(record.elapsedMs)}</span>
            <span style={soft}>{sizeText(record.bytes)}</span>
            <span className='ml-auto truncate text-[12px]' style={faint}>
                {fromHistory ? `${requestName(record.relative)} · ${clockOf(record.at)}` : clockOf(record.at)}
            </span>
        </>
    ) : first ? null : (
        <span style={faint}>{C.noResponseYet}</span>
    )

    return (
        <section
            aria-label={C.pane}
            data-slot='workbench-response-pane'
            className='flex min-h-0 min-w-0 flex-col overflow-auto'
            style={{ flex: '0 0 40%', minWidth: 'min(100%, 340px)', maxWidth: 440 }}
        >
            <div
                className='flex flex-wrap items-center text-[13px]'
                style={{
                    gap: 10,
                    minHeight: 48,
                    padding: '9px 14px',
                    borderBottom: '1px solid var(--v2-rule)',
                }}
                data-slot='response-head'
            >
                {progress}
                {head}
            </div>
            {review ? (
                <div
                    role='alert'
                    className='flex flex-col rounded-[10px] text-[13px]'
                    style={{
                        gap: 8,
                        margin: '12px 14px 0',
                        padding: '12px 14px',
                        background: 'var(--v2-flag-bg)',
                    }}
                    data-slot='workbench-review'
                >
                    <p className='font-semibold'>{C.review.title(review.operation)}</p>
                    <p className='break-all font-mono text-[12px]'>{`${review.method} ${review.url}`}</p>
                    <p>{C.review.goes(review.destination)}</p>
                    {review.headers.length ? (
                        <ul className='font-mono text-[12px]'>
                            {review.headers.map(([n, v], i) => (
                                <li key={i} className='break-all'>{`${n}: ${v}`}</li>
                            ))}
                        </ul>
                    ) : null}
                    {review.body ? (
                        <pre className='max-h-48 overflow-auto rounded-[8px] p-2 font-mono text-[12px] whitespace-pre-wrap' style={{ background: 'var(--v2-paper)' }}>
                            {review.body}
                        </pre>
                    ) : null}
                    {review.files.length ? <p>{C.review.files(review.files.join(', '))}</p> : null}
                    <p className='text-[12px]' style={faint}>
                        {C.review.expires(new Date(review.expires * 1000).toLocaleTimeString())}
                    </p>
                    <div className='flex flex-wrap' style={{ gap: 8 }}>
                        <Btn tier='primary' onClick={onApply}>
                            {C.review.apply}
                        </Btn>
                        <Btn onClick={onDismiss}>{C.review.dismiss}</Btn>
                    </div>
                </div>
            ) : null}
            <div
                role='tablist'
                aria-label={`${C.response} views`}
                className='flex flex-wrap'
                style={{
                    gap: 2,
                    padding: '0 10px',
                    borderBottom: '1px solid var(--v2-rule)',
                }}
            >
                {TABS.map((t) => (
                    <button
                        key={t}
                        type='button'
                        role='tab'
                        aria-selected={tab === t}
                        aria-controls={`response-panel-${t}`}
                        onClick={() => setTab(t)}
                        className='min-h-0 text-[12.5px] font-semibold'
                        style={{
                            height: 38,
                            padding: '0 10px',
                            border: 0,
                            borderBottom: `2px solid ${tab === t ? 'var(--v2-acc)' : 'transparent'}`,
                            background: 'transparent',
                            color: tab === t ? 'var(--v2-ink)' : 'var(--v2-soft)',
                        }}
                    >
                        {C.responseTabs[t]}
                        {t === 'headers' && record?.headers.length ? (
                            <span className='font-normal' style={{ fontSize: 12, ...faint }}>
                                {' '}
                                {record.headers.length}
                            </span>
                        ) : null}
                    </button>
                ))}
            </div>
            <div role='tabpanel' id={`response-panel-${tab}`} className='flex min-h-0 flex-grow flex-col'>
                {tab === 'history' ? (
                    <History
                        call={call}
                        revision={historyKey}
                        onShow={(view) => {
                            setFromHistory(view)
                            setTab('body')
                        }}
                    />
                ) : !shown || !record ? (
                    <p className='text-[13px]' style={{ margin: '20px 14px', ...faint }} data-slot='workbench-no-response'>
                        {C.noResponse}
                    </p>
                ) : (
                    <section aria-label={C.response} data-slot='workbench-response' className='flex min-h-0 flex-grow flex-col text-[13px]'>
                        <p className='sr-only' data-slot='workbench-run-summary'>
                            {runSummary(record)}
                        </p>
                        {record.failure ? (
                            <p role='alert' style={{ margin: '12px 14px 0' }}>
                                {runFailureText(record.failure)}
                            </p>
                        ) : null}
                        {record.uncertain ? (
                            <p
                                role='alert'
                                className='rounded-[8px]'
                                style={{
                                    margin: '12px 14px 0',
                                    padding: '10px 12px',
                                    background: 'var(--v2-flag-bg)',
                                }}
                            >
                                {C.uncertain}
                            </p>
                        ) : null}
                        {record.redirect ? <p style={{ margin: '12px 14px 0' }}>{C.redirect(record.redirect)}</p> : null}
                        {shown.tokenDropped ? <p style={{ margin: '12px 14px 0' }}>{C.tokenDropped}</p> : null}
                        {tab === 'body' ? (
                            <>
                                <div className='flex flex-wrap items-center' style={{ gap: 10, padding: '12px 18px' }}>
                                    <span className='text-[12px]' style={faint}>
                                        {formatted !== null ? 'JSON' : shown.preview === null ? '' : 'Text'}
                                    </span>
                                    <span className='flex rounded-[7px] text-[12px]' style={{ padding: 2, background: 'var(--v2-inset)' }} role='group' aria-label='Body format'>
                                        {(['pretty', 'raw'] as const).map((f) => (
                                            <button
                                                key={f}
                                                type='button'
                                                aria-pressed={pretty === (f === 'pretty')}
                                                onClick={() => setPretty(f === 'pretty')}
                                                className='min-h-0 rounded-[5px] font-semibold'
                                                style={{
                                                    padding: '2px 9px',
                                                    border: 0,
                                                    background: pretty === (f === 'pretty') ? 'var(--v2-paper)' : 'transparent',
                                                    color: 'var(--v2-ink)',
                                                }}
                                            >
                                                {f === 'pretty' ? C.pretty : C.raw}
                                            </button>
                                        ))}
                                    </span>
                                    <span className='ml-auto flex items-center' style={{ gap: 6 }}>
                                        <Btn className='h-7' disabled={shown.preview == null} onClick={() => void copy()}>
                                            {C.copy}
                                        </Btn>
                                        <Btn className='h-7' disabled={!record.stored} onClick={() => void save()}>
                                            {C.saveResponse}
                                        </Btn>
                                    </span>
                                </div>
                                {shown.preview !== null && shown.preview !== '' ? (
                                    pretty && formatted !== null ? (
                                        <pre
                                            role='region'
                                            aria-label={C.responseBody}
                                            data-slot='json-lines'
                                            className='min-h-0 flex-grow overflow-auto text-[12px] leading-[1.75]'
                                            style={{
                                                ...BOX,
                                                padding: '10px 0',
                                                fontFamily: MONO,
                                                color: 'var(--v2-ink)',
                                            }}
                                        >
                                            {formatted.split('\n').map((line, i) => (
                                                <span key={i} data-line=''>
                                                    {line}
                                                    {'\n'}
                                                </span>
                                            ))}
                                        </pre>
                                    ) : (
                                        <pre
                                            role='region'
                                            aria-label={C.responseBody}
                                            className='min-h-0 flex-grow overflow-auto text-[12px] leading-[1.6] break-all whitespace-pre-wrap'
                                            style={{
                                                ...BOX,
                                                padding: 12,
                                                fontFamily: MONO,
                                                color: 'var(--v2-ink)',
                                            }}
                                        >
                                            {shown.preview}
                                        </pre>
                                    )
                                ) : (
                                    <p style={{ margin: '0 14px 12px', ...faint }}>{shown.preview === null && record.bytes > 0 ? C.notText : C.noBody}</p>
                                )}
                                {record.bytes > shown.previewBytes && shown.preview !== null ? (
                                    <p className='text-[12px]' style={{ margin: '0 14px 12px', ...faint }}>
                                        {C.firstBytes(sizeText(shown.previewBytes))}
                                    </p>
                                ) : null}
                            </>
                        ) : tab === 'headers' ? (
                            record.headers.length ? (
                                <div role='table' aria-label={C.responseHeaders} className='overflow-hidden text-[12px]' style={{ ...BOX, margin: '12px 14px', fontFamily: MONO }}>
                                    {record.headers.map(([n, v], i) => (
                                        <div
                                            key={i}
                                            role='row'
                                            className='grid'
                                            style={{
                                                gridTemplateColumns: '1fr 1.6fr',
                                                borderTop: i ? '1px solid var(--v2-rule)' : 0,
                                            }}
                                        >
                                            <span role='cell' className='break-all' style={{ padding: '8px 10px', ...soft }}>
                                                {n}
                                            </span>
                                            <span
                                                role='cell'
                                                className='break-all'
                                                style={{
                                                    padding: '8px 10px',
                                                    borderLeft: '1px solid var(--v2-rule)',
                                                }}
                                            >
                                                {v}
                                            </span>
                                        </div>
                                    ))}
                                </div>
                            ) : (
                                <p style={{ margin: '20px 14px', ...faint }}>No headers were recorded.</p>
                            )
                        ) : (
                            <dl
                                className='flex flex-col text-[12.5px]'
                                style={{
                                    ...BOX,
                                    margin: '12px 14px',
                                    padding: '12px 14px',
                                    gap: 8,
                                }}
                                data-slot='response-details'
                            >
                                {(
                                    [
                                        [C.details.request, `${record.method} ${record.url}`],
                                        [C.details.status, runSummary(record)],
                                        [C.details.duration, elapsedText(record.elapsedMs)],
                                        [C.details.size, sizeText(record.bytes)],
                                        [C.details.when, new Date(record.at * 1000).toLocaleString()],
                                        [C.details.credential, record.class === 'anonymous' ? C.details.anonymous : record.class],
                                        [C.details.operation, record.operation ?? '—'],
                                        [C.details.stored, record.stored ? C.details.yes : C.details.no],
                                    ] as [string, string][]
                                ).map(([k, v]) => (
                                    <div key={k} className='flex justify-between' style={{ gap: 10 }}>
                                        <dt style={faint}>{k}</dt>
                                        <dd className='min-w-0 break-all text-right'>{v}</dd>
                                    </div>
                                ))}
                            </dl>
                        )}
                    </section>
                )}
            </div>
            <p role='status' aria-live='polite' className='text-[12px]' style={{ margin: '0 14px 10px', ...soft }} data-slot='workbench-response-saved'>
                {message}
            </p>
        </section>
    )
}

/** The collection's history: what was sent, never sent again. */
function History({ call, revision, onShow }: { call: WorkbenchCall; revision: string; onShow: (run: RunView) => void }) {
    const [runs, setRuns] = useState<RunRecord[]>([])
    const [more, setMore] = useState(false)
    const [message, setMessage] = useState('')
    useEffect(() => {
        let live = true
        void call({ kind: 'history', before: null }).then((r) => {
            if (!live) return
            if (r.kind === 'history') {
                setRuns(r.runs)
                setMore(r.more)
            } else setMessage(resultText(r) ?? '')
        })
        return () => {
            live = false
        }
    }, [call, revision])
    const older = async () => {
        const last = runs.at(-1)
        if (!last) return
        const r = await call({ kind: 'history', before: last.id })
        if (r.kind === 'history') {
            setRuns((x) => [...x, ...r.runs])
            setMore(r.more)
        }
    }
    const clear = async () => {
        const r = await call({ kind: 'clearHistory' })
        if (r.kind === 'done') {
            setRuns([])
            setMore(false)
        } else setMessage(resultText(r) ?? '')
    }
    return (
        <section aria-label='History' data-slot='workbench-history' className='flex flex-col text-[13px]' style={{ gap: 8, margin: '12px 14px' }}>
            <p className='text-[12px]' style={soft}>
                {C.historyLead}
            </p>
            {message ? <p role='alert'>{message}</p> : null}
            {runs.length === 0 ? <p style={faint}>{C.historyEmpty}</p> : null}
            <ul className='flex flex-col' style={{ gap: 8 }}>
                {runs.map((r) => {
                    const t = tone(r)
                    const summary = `${r.method} ${r.relative.replace(/\.request\.toml$/, '')} · ${runSummary(r)} · ${new Date(r.at * 1000).toLocaleString()}`
                    return (
                        <li key={r.id}>
                            <button
                                type='button'
                                aria-label={summary}
                                onClick={() =>
                                    void call({ kind: 'showRun', run: r.id }).then((x) => {
                                        if (x.kind === 'ran') onShow(x.run)
                                        else setMessage(resultText(x) ?? '')
                                    })
                                }
                                className='flex w-full min-h-0 items-center rounded-[8px] border text-left'
                                style={{
                                    gap: 10,
                                    padding: '10px 12px',
                                    borderColor: 'var(--v2-rule)',
                                    background: 'var(--v2-paper)',
                                    color: 'var(--v2-ink)',
                                }}
                                data-slot='history-run'
                            >
                                <span className='rounded-[6px] text-[12px] font-bold' style={{ padding: '2px 8px', background: t.bg, color: t.fg }}>
                                    {t.text}
                                </span>
                                <span className='min-w-0 flex-grow truncate'>{`${r.method} ${requestName(r.relative)} · ${new Date(r.at * 1000).toLocaleString()}`}</span>
                                <span className='text-[12px]' style={faint}>
                                    {elapsedText(r.elapsedMs)}
                                </span>
                            </button>
                        </li>
                    )
                })}
            </ul>
            <div className='flex flex-wrap' style={{ gap: 8 }}>
                {more ? <Btn onClick={() => void older()}>{C.older}</Btn> : null}
                {runs.length ? (
                    <Btn tier='tertiary' onClick={() => void clear()}>
                        {C.clearHistory}
                    </Btn>
                ) : null}
                <Btn tier='tertiary' onClick={() => void call({ kind: 'clearCookies' }).then((r) => setMessage(r.kind === 'done' ? C.cookiesCleared : (resultText(r) ?? '')))}>
                    {C.clearCookies}
                </Btn>
            </div>
        </section>
    )
}

