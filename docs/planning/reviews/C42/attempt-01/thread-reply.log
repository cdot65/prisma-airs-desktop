import type { ReactNode } from 'react'
import { cn } from '../cn'

export interface PageColumnProps {
    className?: string
    children: ReactNode
    'data-slot'?: string
}

/**
 * PageColumn — the shared padding contract for routed pages (`px-6 pt-5
 * pb-16`, gutters dropped ≥900px where the shell's own `px-7` takes over).
 * Width is owned by the shell's `--academy-content-max` token (1040px);
 * PageColumn fills that container and never re-caps it. Pages add layout via
 * `className` (e.g. Home's `flex flex-col gap-[42px]`), never their own
 * width/padding. The unit reader's prose measure is its own template and
 * does not use this component.
 */
export function PageColumn({ className, children, ...rest }: PageColumnProps) {
    return (
        <div
            className={cn(
                'mx-auto w-full px-6 pt-5 pb-16 min-[900px]:px-0',
                className
            )}
            {...rest}
        >
            {children}
        </div>
    )
}
