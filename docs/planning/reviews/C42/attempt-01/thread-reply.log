import { useMemo, useState } from 'react'
import { Navigate } from '@tanstack/react-router'
import { trpc } from '@/lib/trpc'
import { Kicker, PageColumn, ProgressBar, RowTile } from '@/components/ax'
import { QueryError } from '@/components/query-state'
import { useSetPageHeader } from '@/components/shell/page-header'
import { AccessGateView, isAccessDenied } from '../components/access-gate'
import { CourseTabs } from '../components/course-tabs'
import { PathCourseCard } from '../components/path-course-card'
import { courseIcon } from '../course-icon'
import { isPathCourseStaged } from '../path-course-availability'
import { pathLevelLabel } from '../path-level'

const TABS = [
    { id: 'courses', label: 'Courses' },
    { id: 'about', label: 'About' },
] as const
type TabId = (typeof TABS)[number]['id']

/**
 * Path landing (`/paths/$pathSlug`) — the roadmap, opened (design: Reading
 * Room System 3a): one centered 820px editorial column — PATH kicker, hot
 * icon tile + title + level rung, tagline as the lead, Courses/About tabs; each
 * section renders heading + inline rollup progress + blurb + its course rows.
 * Unknown slugs that match a COURSE slug redirect to the course overview
 * (pre-rename `/paths/:id` URLs keep working).
 */
export function PathLandingPage({ pathSlug }: { pathSlug: string }) {
    const pathQuery = trpc.paths.get.useQuery({ pathSlug })
    // Only consulted for the legacy-course-slug redirect on a path miss.
    const coursesQuery = trpc.courses.list.useQuery(undefined, {
        enabled: pathQuery.error?.data?.code === 'NOT_FOUND',
    })
    const [tab, setTab] = useState<TabId>('courses')
    const path = pathQuery.data

    const header = useMemo(
        () => ({
            breadcrumbs: [
                { label: 'Paths', to: '/paths' },
                { label: path?.title ?? 'Path' },
            ],
        }),
        [path?.title]
    )
    useSetPageHeader(header)

    if (pathQuery.isLoading) {
        return <p className='text-academy-ink-faint p-8 text-sm'>Loading…</p>
    }
    // A locked path is an ANSWER, not a miss: the server said who may enter
    // and why this reader may not (sign in / ask your admin / finish the
    // previous path). Only a genuine miss falls through to the legacy
    // course-slug redirect and "Path not found."
    if (pathQuery.isError && isAccessDenied(pathQuery.error)) {
        return <AccessGateView error={pathQuery.error} />
    }
    if (pathQuery.isError && pathQuery.error?.data?.code !== 'NOT_FOUND')
        return (
            <PageColumn>
                <QueryError
                    title='Unable to load this learning path.'
                    onRetry={() => void pathQuery.refetch()}
                    retrying={pathQuery.isFetching}
                />
            </PageColumn>
        )
    if (!path) {
        if (coursesQuery.isLoading)
            return (
                <p role='status' className='p-8 text-sm'>
                    Looking for this course…
                </p>
            )
        if (coursesQuery.isError)
            return (
                <QueryError
                    title='Unable to find this course.'
                    onRetry={() => void coursesQuery.refetch()}
                    retrying={coursesQuery.isFetching}
                />
            )
        const course = coursesQuery.data?.find((c) => c.slug === pathSlug)
        if (course) {
            return (
                <Navigate
                    to='/courses/$courseSlug'
                    params={{ courseSlug: course.slug }}
                    replace
                />
            )
        }
        return (
            <p className='text-academy-ink-faint p-8 text-sm'>
                Path not found.
            </p>
        )
    }

    return (
        <PageColumn>
            <header>
                <Kicker tone='accent'>Path</Kicker>
                <div className='mt-4 flex items-center gap-5'>
                    <RowTile
                        icon={courseIcon(path.iconKey)}
                        hot
                        size={56}
                        className='rounded-[14px]'
                    />
                    <div>
                        <h1 className='font-display text-academy-ink text-[40px] leading-[1.08] font-extrabold tracking-[-0.02em]'>
                            {path.title}
                        </h1>
                        {/* The retired role axis used to live here (now
                         * dropped from paths.get) — this is the ladder rung
                         * (spec §3.2), same label as the library card badge
                         * ({@link pathLevelLabel}), never a second spelling. */}
                        <p
                            data-testid='path-level-label'
                            className='text-academy-ink-faint mt-2.5 font-mono text-[12px] leading-[normal] font-semibold tracking-[0.16em] uppercase'
                        >
                            {pathLevelLabel(path.level, path.title)}
                        </p>
                    </div>
                </div>
                <p className='text-academy-ink-soft mt-3.5 mb-[30px] text-[18px] leading-[1.7]'>
                    {path.tagline}
                </p>
            </header>

            <div className='mb-[34px]'>
                <CourseTabs
                    tabs={TABS}
                    active={tab}
                    onChange={(id) => setTab(id)}
                    gapClass='gap-[28px]'
                    idPrefix='path'
                />
            </div>

            {TABS.filter((t) => t.id !== tab).map((t) => (
                <div
                    key={t.id}
                    role='tabpanel'
                    id={`path-panel-${t.id}`}
                    aria-labelledby={`path-tab-${t.id}`}
                    hidden
                />
            ))}
            <div
                role='tabpanel'
                id={`path-panel-${tab}`}
                aria-labelledby={`path-tab-${tab}`}
                tabIndex={0}
            >
                {tab === 'about' && (
                    <div className='max-w-[76ch] space-y-3'>
                        <p className='text-academy-ink-soft text-[15px] leading-relaxed whitespace-pre-line'>
                            {path.description}
                        </p>
                    </div>
                )}

                {tab === 'courses' &&
                    (() => {
                        const allCourses = path.sections.flatMap(
                            (s) => s.courses
                        )
                        const hotId = allCourses
                            .filter((c) => c.unitsDone > 0 && c.unitCount > 0)
                            .reduce<(typeof allCourses)[number] | null>(
                                (best, c) =>
                                    !best ||
                                    c.unitsDone / c.unitCount >
                                        best.unitsDone / best.unitCount
                                        ? c
                                        : best,
                                null
                            )?.id
                        return path.sections.map((section) => {
                            // A `coming_soon` course card carries no completable
                            // work (it's a locked teaser, unitCount is always 0)
                            // and must not dilute the section's completion
                            // average with an automatic 0% (fix round 2:
                            // including it in `section.courses` at all — the
                            // right call, see Finding 1 — otherwise made every
                            // mixed section under-report). A section with NO
                            // completable course (every member still
                            // `coming_soon`) has no percent to show at all: `pct`
                            // is `null` and the bar/number are omitted rather
                            // than showing a misleading 0% or NaN%.
                            const completable = section.courses.filter(
                                (c) => c.status !== 'coming_soon'
                            )
                            const pcts = completable.map((c) =>
                                c.unitCount
                                    ? Math.round(
                                          (c.unitsDone / c.unitCount) * 100
                                      )
                                    : 0
                            )
                            const pct = pcts.length
                                ? Math.round(
                                      pcts.reduce((s, p) => s + p, 0) /
                                          pcts.length
                                  )
                                : null
                            return (
                                <section
                                    key={section.id}
                                    data-slot='path-section'
                                    className='mb-[38px]'
                                >
                                    <div>
                                        <div className='flex items-baseline gap-4'>
                                            <h2 className='font-display text-academy-ink text-[22px] leading-[1.2] font-bold tracking-[-0.01em]'>
                                                {section.title}
                                            </h2>
                                            <span className='flex-1' />
                                            {pct !== null && (
                                                <>
                                                    <span className='relative -top-[3px] hidden w-[120px] shrink-0 sm:block'>
                                                        <ProgressBar
                                                            value={pct}
                                                            aria-label={`${section.title} progress`}
                                                        />
                                                    </span>
                                                    <span className='text-academy-ink-faint shrink-0 font-mono text-[12px] leading-[normal]'>
                                                        {pct}%
                                                    </span>
                                                </>
                                            )}
                                        </div>
                                        {section.description && (
                                            <p className='text-academy-ink-faint mt-1.5 text-[15px] leading-[normal]'>
                                                {section.description}
                                            </p>
                                        )}
                                    </div>
                                    <div className='mt-4 flex flex-col gap-3'>
                                        {section.courses.map((c) => (
                                            <PathCourseCard
                                                key={c.id}
                                                course={c}
                                                forceLocked={isPathCourseStaged(
                                                    path.id,
                                                    c.id
                                                )}
                                                hot={c.id === hotId}
                                            />
                                        ))}
                                    </div>
                                </section>
                            )
                        })
                    })()}
            </div>
        </PageColumn>
    )
}
/**
 * Units data-access layer (MS Learn IA migration). Thin wrappers over the new
 * `units.*` tRPC router — the Module/Unit screens consume these instead of the
 * legacy lessons/quiz/labs hooks. Ungated: nothing here reads or writes a pass
 * gate.
 */
import { mutationFailure } from '@/lib/mutation-failure'
import { trpc } from '@/lib/trpc'
import { useAwardToasts } from '@/features/gamification'

/** A certification's paths + Σ rollup + exam eligibility. */
export function useCertOverview(certificationId: string) {
    return trpc.units.certOverview.useQuery(
        { certificationId },
        { enabled: !!certificationId }
    )
}

/** A course's modules with unit rollups + reuse counts. */
export function useModulesByPath(courseId: string) {
    return trpc.units.listByPath.useQuery({ courseId }, { enabled: !!courseId })
}

/** A module's ordered unit sequence + the learner's per-unit status. */
export function useModuleUnits(moduleId: string) {
    return trpc.units.listByModule.useQuery(
        { moduleId },
        { enabled: !!moduleId }
    )
}

/** One unit's full client-safe payload (discriminated by `kind`). */
export function useUnit(unitId: string) {
    return trpc.units.get.useQuery({ unitId }, { enabled: !!unitId })
}

/**
 * Invalidate the per-learner progress rollups a unit completion changes. With a
 * non-zero global `staleTime`, these no longer refetch on their own, so a
 * completed unit must explicitly refresh the sibling list, this unit's status,
 * and the path/certification/dashboard rollups that count it.
 */
function invalidateAfterUnitProgress(utils: ReturnType<typeof trpc.useUtils>) {
    utils.units.listByModule.invalidate()
    utils.units.get.invalidate()
    // The per-course module rollup: the course accordion renders it, and the
    // completion watcher (LL2) detects "module/course newly 100%" from it.
    utils.units.listByPath.invalidate()
    utils.units.certOverview.invalidate()
    utils.courses.list.invalidate()
    utils.certifications.list.invalidate()
    utils.dashboard.summary.invalidate()
    // Gamification: XP/level/streak/credits + daily-ops progress all move on a
    // completion — refresh the HUD, dossier, and quest board so they aren't stale.
    utils.gamification.summary.invalidate()
    utils.gamification.dossier.invalidate()
    // O2: a completed unit or KC ticks a first-rotation checklist row (and the
    // unlock this completion's own award may have paid retires the card), so
    // Home inside the staleTime window must not show yesterday's checklist.
    utils.gamification.firstRotation.invalidate()
}

/**
 * When a completion's outcome is unknown (the host's transport reports it
 * may have been recorded), re-read the progress it would have changed: the
 * outline and unit status then show what Academy actually recorded.
 */
function readBackIfUncertain(
    utils: ReturnType<typeof trpc.useUtils>,
    error: unknown
) {
    if (mutationFailure(error) === 'mayHaveApplied')
        invalidateAfterUnitProgress(utils)
}

/** Mark a content unit done; refresh the sibling list + progress rollups. */
export function useCompleteUnit() {
    const utils = trpc.useUtils()
    const showAwardToasts = useAwardToasts()
    return trpc.units.complete.useMutation({
        onSuccess: (data) => {
            invalidateAfterUnitProgress(utils)
            showAwardToasts(data.award)
        },
        onError: (error) => readBackIfUncertain(utils, error),
    })
}

/** Begin an (ungated) knowledge-check attempt — draws the bank. */
export function useStartKnowledgeCheck() {
    return trpc.units.startKnowledgeCheck.useMutation()
}

/** Submit a knowledge-check attempt — scores + marks the unit done regardless. */
export function useSubmitKnowledgeCheck() {
    const utils = trpc.useUtils()
    const showAwardToasts = useAwardToasts()
    return trpc.units.submitKnowledgeCheck.useMutation({
        onSuccess: (data) => {
            invalidateAfterUnitProgress(utils)
            showAwardToasts(data.award)
        },
        onError: (error) => readBackIfUncertain(utils, error),
    })
}
import { trpc } from '@/lib/trpc'

/**
 * Reset the caller's progress in one course. On success, invalidate every rollup
 * a wiped course changes: the per-course summary gate, the course module list, and
 * the course/path/dashboard surfaces that count progress. Failures surface through
 * the global mutation-error toast (mirrors useRemoveEnrollment — no success toast).
 */
export function useResetCourseProgress() {
    const utils = trpc.useUtils()
    return trpc.progress.resetCourse.useMutation({
        onSuccess: () => {
            utils.progress.courseSummary.invalidate()
            utils.units.listByPath.invalidate()
            utils.courses.list.invalidate()
            utils.paths.list.invalidate()
            utils.dashboard.summary.invalidate()
            // Reset removes the course's earned XP — refresh the HUD/dossier.
            utils.gamification.summary.invalidate()
            utils.gamification.dossier.invalidate()
        },
    })
}
import { createContext, useContext } from 'react'
import type { QueryClient } from '@tanstack/react-query'
import type { TRPCClient } from '@trpc/client'
import { createTRPCQueryUtils, createTRPCReact } from '@trpc/react-query'
import type { AppRouter } from '@/server/app-router'

// Typed tRPC React Query hooks. `AppRouter` is a type-only import, so no
// server runtime is pulled into the browser bundle.
export const trpc = createTRPCReact<AppRouter>()

/**
 * The same procedures, callable OUTSIDE React (CO1).
 *
 * `trpc.useUtils()` is the in-component form and is unavailable to a TanStack
 * Router `loader`, which runs during navigation with no component mounted. The
 * proxy this returns writes into the SAME QueryClient under the SAME keys the
 * hooks read, which is the property that makes a loader prefetch a head start
 * rather than a second, parallel fetch of everything.
 *
 * There is exactly one of these per tRPC client; `AuthTRPCProvider` owns its
 * lifetime because the client it wraps carries the Clerk session token.
 */
export function createTrpcQueryUtils(
    client: TRPCClient<AppRouter>,
    queryClient: QueryClient
) {
    return createTRPCQueryUtils<AppRouter>({ client, queryClient })
}

export type TrpcQueryUtils = ReturnType<typeof createTrpcQueryUtils>

/**
 * Where `AuthTRPCProvider` publishes the utils it built, and where route
 * loaders reach them through the router context.
 *
 * Null only above that provider, which nothing routed ever is. `useTrpcQueryUtils`
 * throws there rather than handing back a proxy over a different QueryClient,
 * which would prefetch into a cache no component reads and look for all the
 * world like a working loader.
 */
export const TrpcQueryUtilsContext = createContext<TrpcQueryUtils | null>(null)

export function useTrpcQueryUtils(): TrpcQueryUtils {
    const utils = useContext(TrpcQueryUtilsContext)
    if (!utils) {
        throw new Error(
            'useTrpcQueryUtils must be used inside AuthTRPCProvider'
        )
    }
    return utils
}
