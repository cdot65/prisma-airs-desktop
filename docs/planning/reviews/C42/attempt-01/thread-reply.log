                                    role='progressbar'
                                    aria-valuemin={0}
                                    aria-valuemax={100}
                                    aria-valuenow={pct}
                                    aria-label={`${p.title} progress`}
                                >
                                    <span className='block h-full rounded-full' style={{ width: `${pct}%`, background: 'var(--v2-acc)' }} />
                                </span>
                                <span className='text-[12px]' style={faint}>
                                    {C.pathMeta(p.unitCount, p.unitsDone, p.estMinutes)}
                                </span>
                            </Link>
                        )
                    })}
                </div>
            )}
        </section>
    )
}

