/**
 * Units data-access layer (MS Learn IA migration). Thin wrappers over the new
 * `units.*` tRPC router — the Module/Unit screens consume these instead of the
 * legacy lessons/quiz/labs hooks. Ungated: nothing here reads or writes a pass
 * gate.
 */
import { mutationFailure } from '@/lib/mutation-failure'
import { trpc } from '@/lib/trpc'
import { useAwardToasts } from '@/features/gamification'

/** A certification's paths + Σ rollup + exam eligibility. */
export function useCertOverview(certificationId: string) {
    return trpc.units.certOverview.useQuery(
        { certificationId },
        { enabled: !!certificationId }
    )
}

/** A course's modules with unit rollups + reuse counts. */
export function useModulesByPath(courseId: string) {
    return trpc.units.listByPath.useQuery({ courseId }, { enabled: !!courseId })
}

/** A module's ordered unit sequence + the learner's per-unit status. */
export function useModuleUnits(moduleId: string) {
    return trpc.units.listByModule.useQuery(
        { moduleId },
        { enabled: !!moduleId }
    )
}

/** One unit's full client-safe payload (discriminated by `kind`). */
export function useUnit(unitId: string) {
    return trpc.units.get.useQuery({ unitId }, { enabled: !!unitId })
}

/**
 * Invalidate the per-learner progress rollups a unit completion changes. With a
 * non-zero global `staleTime`, these no longer refetch on their own, so a
 * completed unit must explicitly refresh the sibling list, this unit's status,
 * and the path/certification/dashboard rollups that count it.
 */
function invalidateAfterUnitProgress(utils: ReturnType<typeof trpc.useUtils>) {
    utils.units.listByModule.invalidate()
    utils.units.get.invalidate()
    // The per-course module rollup: the course accordion renders it, and the
    // completion watcher (LL2) detects "module/course newly 100%" from it.
    utils.units.listByPath.invalidate()
    utils.units.certOverview.invalidate()
    utils.courses.list.invalidate()
    utils.certifications.list.invalidate()
    utils.dashboard.summary.invalidate()
    // Gamification: XP/level/streak/credits + daily-ops progress all move on a
    // completion — refresh the HUD, dossier, and quest board so they aren't stale.
    utils.gamification.summary.invalidate()
    utils.gamification.dossier.invalidate()
    // O2: a completed unit or KC ticks a first-rotation checklist row (and the
    // unlock this completion's own award may have paid retires the card), so
    // Home inside the staleTime window must not show yesterday's checklist.
    utils.gamification.firstRotation.invalidate()
}

/**
 * When a completion's outcome is unknown (the host's transport reports it
 * may have been recorded), re-read the progress it would have changed: the
 * outline and unit status then show what Academy actually recorded.
 */
function readBackIfUncertain(
    utils: ReturnType<typeof trpc.useUtils>,
    error: unknown
) {
    if (mutationFailure(error) === 'mayHaveApplied')
        invalidateAfterUnitProgress(utils)
}

/** Mark a content unit done; refresh the sibling list + progress rollups. */
export function useCompleteUnit() {
    const utils = trpc.useUtils()
    const showAwardToasts = useAwardToasts()
    return trpc.units.complete.useMutation({
        onSuccess: (data) => {
            invalidateAfterUnitProgress(utils)
            showAwardToasts(data.award)
        },
        onError: (error) => readBackIfUncertain(utils, error),
    })
}

/** Begin an (ungated) knowledge-check attempt — draws the bank. */
export function useStartKnowledgeCheck() {
    return trpc.units.startKnowledgeCheck.useMutation()
}

/** Submit a knowledge-check attempt — scores + marks the unit done regardless. */
export function useSubmitKnowledgeCheck() {
    const utils = trpc.useUtils()
    const showAwardToasts = useAwardToasts()
    return trpc.units.submitKnowledgeCheck.useMutation({
        onSuccess: (data) => {
            invalidateAfterUnitProgress(utils)
            showAwardToasts(data.award)
        },
        onError: (error) => readBackIfUncertain(utils, error),
    })
}
