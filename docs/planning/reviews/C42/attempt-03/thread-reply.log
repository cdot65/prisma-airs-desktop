/**
 * Hooks over Academy's desktop lab attempt contract (`desktop.attempt.*`,
 * `desktop.draft.*`): owned attempts pinned to a revision, versioned learner
 * drafts with explicit conflicts, hints, critique, and grading that is
 * idempotent per submission id. Grading, hints and verdicts are Academy's;
 * nothing here decides a pass.
 */
import type { RouterInputs, RouterOutputs } from '@/lib/api-types'
import { trpc } from '@/lib/trpc'

export type DesktopAttempt = RouterOutputs['desktop']['attempt']['get']
export type DesktopDraft = RouterInputs['desktop']['draft']['save']['draft']
export type DesktopSaveReply = RouterOutputs['desktop']['draft']['save']
export type DesktopGrade = RouterOutputs['desktop']['attempt']['submit']

/** A new idempotency key (request, mutation or submission id). */
export function newId(): string {
    return crypto.randomUUID()
}

export function useDesktopAttempts() {
    return trpc.desktop.attempt.list.useQuery({ limit: 100 })
}

export function useDesktopAttempt(attemptId: string | null) {
    return trpc.desktop.attempt.get.useQuery(
        { attemptId: attemptId ?? '00000000-0000-4000-8000-000000000000' },
        { enabled: Boolean(attemptId), staleTime: 0 }
    )
}

export function useStartDesktopAttempt() {
    return trpc.desktop.attempt.start.useMutation()
}

export function useSaveDesktopDraft() {
    // A draft save that fails is shown in place; the global notice would
    // repeat it on every autosave.
    return trpc.desktop.draft.save.useMutation({ meta: { silent: true } })
}

export function useResolveDesktopDraft() {
    return trpc.desktop.draft.resolve.useMutation()
}

export function useCheckDesktopStep() {
    return trpc.desktop.attempt.checkStep.useMutation()
}

export function useSubmitDesktopAttempt() {
    const utils = trpc.useUtils()
    return trpc.desktop.attempt.submit.useMutation({
        onSettled: () => {
            // Progress the grade may have changed, whatever the reply said.
            void utils.desktop.attempt.list.invalidate()
            void utils.units.listByModule.invalidate()
            void utils.units.get.invalidate()
        },
    })
}

export function useDesktopHint() {
    return trpc.desktop.attempt.hint.useMutation()
}

export function useDesktopCritique() {
    return trpc.desktop.attempt.critique.useMutation()
}
