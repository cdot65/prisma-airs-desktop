/**
 * A passed lab completes its owning lab-kind unit (spec 2026-07-06 phase 5:
 * lab-in-player). Resolution is via `units.lab_id`; a lab not placed as a
 * unit returns null — loudly (#594): logged in production so a broken
 * lab→unit link is visible (the pass writes lab_progress but the unit never
 * counts done), thrown in development so seeds/content can't ship the gap.
 * Idempotent — same upsert shape as the units router's
 * markUnitDone, with completedAt stamping only the FIRST completion; the
 * xp-award (plan 2026-07-14 §1d) is idempotent through the xp_events unique,
 * so repeat passes return awarded:false. Returns the AwardResult (null when
 * no owning unit) so lab mutations can surface level-up/unlock toasts.
 */
import type { AppDb } from '@/db'
import { eq, sql } from 'drizzle-orm'
import { unitProgress, units } from '@/db/schema'
import { awardXp, type AwardResult } from './xp-award'

export async function completeOwningUnit(
    db: AppDb,
    userId: string,
    labId: string
): Promise<AwardResult | null> {
    const [unit] = await db
        .select({ id: units.id, xp: units.xp })
        .from(units)
        .where(eq(units.labId, labId))
        .limit(1)
    if (!unit) {
        const msg = `[lab-unit-completion] no unit row links lab ${labId} (user ${userId}) — the lab pass will not complete a unit`
        if (process.env.NODE_ENV === 'development') throw new Error(msg)
        console.error(msg)
        return null
    }
    await db
        .insert(unitProgress)
        .values({
            userId,
            unitId: unit.id,
            status: 'done',
            bestScore: null,
            attempts: 0,
            completedAt: new Date(),
        })
        .onConflictDoUpdate({
            target: [unitProgress.userId, unitProgress.unitId],
            set: {
                status: 'done',
                completedAt: sql`coalesce(${unitProgress.completedAt}, now())`,
                updatedAt: sql`now()`,
            },
        })
    return awardXp({
        db,
        userId,
        sourceType: 'lab',
        sourceId: unit.id,
        baseXp: unit.xp,
    })
}

