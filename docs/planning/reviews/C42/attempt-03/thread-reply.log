/**
 * Everything learner pages need from their host, supplied explicitly: the
 * tRPC links (the desktop's terminating link that calls its native core),
 * the account-scoped QueryClient, the learner identity and the general
 * theme. No Clerk session, router or persistence is mounted here, and the
 * theme is read-only (a desktop appearance never writes a learner setting).
 * As on Academy web, every failed mutation surfaces a visible notice
 * (Academy's toaster, mounted with the pages), worded by what is known of
 * its outcome.
 */
import { type ReactNode, useEffect, useMemo } from 'react'
import type { QueryClient } from '@tanstack/react-query'
import { THEMES } from '@/theme'
import { ACCENTS, DEFAULT_ACCENT } from '@/theme/accent'
import { AccentContext } from '@/theme/accent-context'
import { ThemeContext } from '@/theme/theme-context'
import type { TRPCLink } from '@trpc/client'
import {
    type HostActionOutcome,
    type LearnerCapabilities,
    LearnerCapabilitiesProvider,
    type LocalDrafts,
} from '@/lib/learner-capabilities'
import {
    type LearnerIdentity,
    LearnerIdentityProvider,
} from '@/lib/learner-identity'
import { createTrpcQueryUtils, trpc, TrpcQueryUtilsContext } from '@/lib/trpc'
import type { AppRouter } from '@/server/app-router'
import { Toaster, toastMutationError } from '@/components/ui/toast'

export interface LearnerHostProps {
    links: TRPCLink<AppRouter>[]
    queryClient: QueryClient
    identity: LearnerIdentity
    theme: 'gruvbox' | 'paper'
    /**
     * How hands-on labs run (default 'run'): 'desktop' through Academy's
     * desktop attempt contract, 'preview' when they cannot run here.
     */
    labs?: 'run' | 'desktop' | 'preview'
    /** 'prerendered' when the page cannot run mermaid (default 'live'). */
    diagrams?: 'live' | 'prerendered'
    /** Academy web's origin for public links such as certificate verify URLs. */
    webOrigin?: string | null
    /** Ends the learner session (the account page's sign-out). */
    onSignOut?: () => void
    /** Opens the print sheet for the current page (certificate download). */
    onPrint?: () => Promise<HostActionOutcome>
    /** Whether remote images (uploaded avatars) can load (default true). */
    remoteImages?: boolean
    /** Whether avatars can be uploaded here (default true). */
    avatarUpload?: boolean
    /** 'host' when the host owns appearance (default 'learner'). */
    appearance?: 'learner' | 'host'
    /** Whether authorized assessors review practicals here (default true). */
    assessorTools?: boolean
    /**
     * Whether Home claims and announces away commendations and event
     * celebrations here (default true); otherwise Academy web announces them.
     */
    awardPresenters?: boolean
    /** Whether the course page offers resetting course progress (default false). */
    courseReset?: boolean
    /** Whether completed lessons ask for a rating (default false). */
    lessonFeedback?: boolean
    /** Uploads a new avatar the host chooses (default: the page's file picker). */
    onUploadAvatar?: () => Promise<HostActionOutcome>
    /** Loads an Academy image where remote images cannot load. */
    loadImage?: (url: string) => Promise<string | null>
    /** Keeps lab work Academy has not confirmed on this device. */
    localDrafts?: LocalDrafts
    children: ReactNode
}

export function LearnerHost({
    links,
    queryClient,
    identity,
    theme,
    labs = 'run',
    diagrams = 'live',
    webOrigin = null,
    onSignOut,
    onPrint,
    remoteImages = true,
    avatarUpload = true,
    appearance = 'learner',
    assessorTools = true,
    awardPresenters = true,
    courseReset = false,
    lessonFeedback = false,
    onUploadAvatar,
    loadImage,
    localDrafts,
    children,
}: LearnerHostProps) {
    const client = useMemo(() => trpc.createClient({ links }), [links])
    const utils = useMemo(
        () => createTrpcQueryUtils(client, queryClient),
        [client, queryClient]
    )
    const themeValue = useMemo(
        () => ({ theme, setTheme: () => undefined, themes: [THEMES[theme]] }),
        [theme]
    )
    // Academy web reports mutation failures from its QueryClient's mutation
    // cache; a host supplies its own client, so the same report is attached
    // here for as long as the pages are mounted.
    useEffect(
        () =>
            queryClient.getMutationCache().subscribe((event) => {
                if (event.type === 'updated' && event.action.type === 'error') {
                    toastMutationError(event.action.error, event.mutation.meta)
                }
            }),
        [queryClient]
    )
    // Accent is read-only here too: the host owns appearance.
    const accentValue = useMemo(
        () => ({
            accent: DEFAULT_ACCENT,
            setAccent: () => undefined,
            accents: [ACCENTS[DEFAULT_ACCENT]],
        }),
        []
    )
    const capabilities = useMemo<LearnerCapabilities>(
        () => ({
            labs,
            liveDiagrams: diagrams === 'live',
            remoteImages,
            avatarUpload,
            appearance,
            webOrigin,
            signOut: onSignOut ?? null,
            print: onPrint ?? null,
            assessorTools,
            awardPresenters,
            courseReset,
            lessonFeedback,
            uploadAvatar: onUploadAvatar ?? null,
            loadImage: loadImage ?? null,
            localDrafts: localDrafts ?? null,
        }),
        [
            labs,
            diagrams,
            remoteImages,
            avatarUpload,
            appearance,
            webOrigin,
            onSignOut,
            onPrint,
            assessorTools,
            awardPresenters,
            courseReset,
            lessonFeedback,
            onUploadAvatar,
            loadImage,
            localDrafts,
        ]
    )
    return (
        <trpc.Provider client={client} queryClient={queryClient}>
            <TrpcQueryUtilsContext.Provider value={utils}>
                <LearnerIdentityProvider value={identity}>
                    <ThemeContext.Provider value={themeValue}>
                        <AccentContext.Provider value={accentValue}>
                            <LearnerCapabilitiesProvider value={capabilities}>
                                {children}
                                <Toaster />
                            </LearnerCapabilitiesProvider>
                        </AccentContext.Provider>
                    </ThemeContext.Provider>
                </LearnerIdentityProvider>
            </TrpcQueryUtilsContext.Provider>
        </trpc.Provider>
    )
}

