/**
 * Lab data-access layer — thin wrappers over agent3's live `labs` tRPC router.
 * Components consume these, never `trpc` directly, so the API surface stays in
 * one place. Scans/submissions are evaluated SERVER-SIDE; the client only sends
 * the editor buffer.
 */
import { trpc } from '@/lib/trpc'
import { useAwardToasts, type AwardResultLike } from '@/features/gamification'
import type { LabCourseId } from '../api/contracts'
import { publishLabPassAward } from './use-lab-pass-award'

/** A lab pass changes DERIVED module/path/cert completion (spec §7) — refresh
 *  every rollup surface, not just the labs rail. */
function useInvalidateProgressRollups() {
    const utils = trpc.useUtils()
    return () => {
        utils.labs.list.invalidate()
        utils.units.invalidate() // moduleMeta / listByModule / listByPath / certOverview
        utils.courses.invalidate()
        utils.certifications.invalidate()
        utils.progress.invalidate()
        utils.dashboard.invalidate()
        // The pass banks XP — refresh the HUD and dossier so neither trails
        // the award the learner just saw. The vault is NOT refreshed here: a
        // pass that issued a cache says so in `award.cachesEarned`, and
        // `useAwardToasts` owns both the announcement and the invalidation (E1).
        utils.gamification.summary.invalidate()
        utils.gamification.dossier.invalidate()
    }
}

/**
 * What every lab-pass mutation does on success: refresh the rollups, celebrate
 * the award (+XP, level-up, commendations), and hand it to the pass card so
 * `UnitLabSection` can show the XP just earned. `award` is null when the lab
 * isn't placed as a unit (nothing was banked) and `awarded: false` on a replay
 * — `useAwardToasts` no-ops on both, so callers pass it unconditionally.
 */
function useLabPassSuccess() {
    const invalidate = useInvalidateProgressRollups()
    const showAwardToasts = useAwardToasts()
    return (award: AwardResultLike | null | undefined) => {
        invalidate()
        publishLabPassAward(award)
        showAwardToasts(award)
    }
}

/** Every lab + this learner's status — the rail count + the lesson last-CTA lookup. */
export function useLabs() {
    return trpc.labs.list.useQuery()
}

/** Load a lab by (course, ordinal) + this learner's progress (draft/status). */
export function useLab(courseId: string, order: number) {
    return trpc.labs.get.useQuery({
        courseId: courseId as LabCourseId,
        order,
    })
}

/** Run the server-side scan; returns `{ passed, output }` (authored terminal). */
export function useRunScan() {
    return trpc.labs.runScan.useMutation()
}

/** Submit for credit; the server re-evaluates and gates on a pass. */
export function useSubmitLab() {
    const onPass = useLabPassSuccess()
    return trpc.labs.submitLab.useMutation({
        onSuccess: (data) => onPass(data.award),
    })
}

/**
 * Grade a triage lab. The server RE-EVALUATES against its server-only rubric and
 * returns per-finding truth/rationale (POST-grade only). On success the rail's
 * lab status is refreshed. `mutation.data` is the graded result; `reset()` clears
 * it to return to the work view (retry).
 */
export function useGradeTriage() {
    const onPass = useLabPassSuccess()
    return trpc.labs.gradeTriage.useMutation({
        onSuccess: (data) => onPass(data.award),
    })
}

/** Send one command; the SERVER resolves it against the (server-only) command
 *  table and returns lines + checkpoint verdicts. Client evaluates nothing. */
export function useExecCommand() {
    return trpc.labs.execCommand.useMutation()
}

/** Save a terminal lab's optional structured companion response. */
export function useSaveTerminalResponse() {
    return trpc.labs.saveTerminalResponse.useMutation({
        meta: { silent: true },
    })
}

/** Reset a terminal attempt to its authored world and fresh live namespace. */
export function useResetTerminalSession() {
    return trpc.labs.resetTerminalSession.useMutation({
        meta: { silent: true },
    })
}

/** Reveal the next hint on a checkpoint's server-metered ladder. */
export function useRequestHint() {
    return trpc.labs.requestHint.useMutation()
}

/** Submit a terminal lab; the server re-derives every checkpoint from the
 *  persisted session and gates on all passing. `meta.silent` opts the
 *  mutation out of the global MutationCache error toast (main.tsx) — the
 *  runner renders its own error surface (the airs-live submit-blocked banner
 *  on live labs; inline copy otherwise), so the toast would double-report. */
export function useSubmitTerminalLab() {
    const onPass = useLabPassSuccess()
    return trpc.labs.submitTerminalLab.useMutation({
        meta: { silent: true },
        onSuccess: (data) => onPass(data.award),
    })
}

/** Start (or resume) a scenario attempt; returns the client lab + session. */
export function useStartScenario() {
    return trpc.labs.startScenario.useMutation()
}

/** Submit ONE step; server evaluates (terminal: from ITS persisted state).
 *  A step advance changes the persisted scenario session AND derived rollups, so
 *  reconcile `labs.get` (the runner + unit-page read it) plus every rollup
 *  surface — mirrors `useSubmitScenarioLab`. Without this the `labs.get` cache
 *  never reconciles after an advance (root cause #2). */
export function useSubmitStep() {
    const utils = trpc.useUtils()
    const invalidate = useInvalidateProgressRollups()
    return trpc.labs.submitStep.useMutation({
        onSuccess: () => {
            utils.labs.get.invalidate()
            invalidate()
        },
    })
}

/**
 * Debounced draw-scene autosave (plan 6 EXTENSION). Fire-and-forget: no
 * invalidation (the client already holds the scene it just sent), and a failed
 * autosave is swallowed into a console.warn — it must never interrupt drawing.
 */
export function useSaveStepDraft() {
    return trpc.labs.saveStepDraft.useMutation({
        // `meta.silent` opts this fire-and-forget autosave out of the global
        // MutationCache error toast (main.tsx) — a failed draft save must never
        // interrupt drawing.
        meta: { silent: true },
        onError: (err) => console.warn('draft autosave failed', err.message),
    })
}

/** Reveal the next hint on a STEP's server-metered ladder. */
export function useRequestStepHint() {
    return trpc.labs.requestStepHint.useMutation()
}

/** Submit the whole scenario; the server re-derives every step verdict. */
export function useSubmitScenarioLab() {
    const onPass = useLabPassSuccess()
    return trpc.labs.submitScenarioLab.useMutation({
        onSuccess: (data) => onPass(data.award),
    })
}
/**
 * paths router — skill-ladder curated paths (spec 2026-07-06 §3.2): a
 * shared Entry rung plus, per program, an Associate and a Professional
 * rung (`paths.level`), grouped by `paths.programId`.
 *   paths.list() -> path cards (course/duration rollups)
 *   paths.get({ pathSlug }) -> hero + ordered sections -> ordered course cards
 *     with per-course unit rollups (unitCount/unitsDone) for section progress.
 * No path-grain progress rows: everything derives from unit_progress.
 */
import { z } from 'zod'
import type { AppDb } from '@/db'
import { TRPCError } from '@trpc/server'
import { and, asc, eq, inArray, sql } from 'drizzle-orm'
import {
    courseModules,
    courses,
    labProgress,
    modules,
    pathCourses,
    paths,
    pathSections,
    unitProgress,
    units,
} from '@/db/schema'
import {
    pathAccessDecisions,
    resolvePathAccess,
    throwLocked,
} from '../services/content-access'
import { cachedPerDb } from '../services/static-cache'
import { publicProcedure, router } from '../trpc'

/**
 * A course counts toward a path's course-completion rollups (courseCount,
 * estMinutes, and the unit-progress totals on `paths.list`) only once
 * `published`. ONE definition, shared by `buildPathList` and
 * `pathCardsForUser` — they returned the same row under two different
 * definitions before (course-status-read-sites audit, fix round 1): a
 * `coming_soon` course with modules already drafted (the normal authoring
 * order) would otherwise count its units in the progress bar while being
 * unopenable. `paths.get`'s section list is intentionally NOT filtered by
 * this — a `coming_soon` member still renders there, as a locked teaser.
 */
const PUBLISHED_COURSE = eq(courses.status, 'published')

/** Learner-visible course statuses inside a path's section list: `published`
 *  renders as a normal card, `coming_soon` renders as a locked teaser (same
 *  as `certification-graph`'s `LEARNER_COURSE_STATUSES`). `draft`/`retired`
 *  never leave the server. */
const PATH_SECTION_COURSE_STATUSES = ['published', 'coming_soon'] as const

interface CourseProgressRollup {
    unitCount: number
    unitsDone: number
    moduleCount: number
    modulesComplete: number
}

/** Course progress derived from the canonical module-completion contract:
 * every module needs at least one unit, every unit must be done, and any
 * module-level lab must be passed. */
/**
 * `userId` is null for a signed-out browser. Every progress read below is
 * skipped in that case rather than queried with a null id, so a guest gets a
 * well-formed rollup of zeroes instead of an error or a leak.
 */
async function courseUnitRollup(
    db: AppDb,
    courseIds: string[],
    userId: string | null
) {
    const out = new Map<string, CourseProgressRollup>()
    if (courseIds.length === 0) return out
    const memberRows = await db
        .select({
            courseId: courseModules.courseId,
            moduleId: courseModules.moduleId,
        })
        .from(courseModules)
        .where(inArray(courseModules.courseId, courseIds))
    const moduleIds = memberRows.map((r) => r.moduleId)
    if (moduleIds.length === 0) return out
    const [unitRows, doneRows, moduleRows] = await Promise.all([
        db
            .select({ id: units.id, moduleId: units.moduleId })
            .from(units)
            .where(inArray(units.moduleId, moduleIds)),
        userId
            ? db
                  .select({ unitId: unitProgress.unitId })
                  .from(unitProgress)
                  .where(
                      and(
                          eq(unitProgress.userId, userId),
                          eq(unitProgress.status, 'done')
                      )
                  )
            : [],
        db
            .select({ id: modules.id, labId: modules.labId })
            .from(modules)
            .where(inArray(modules.id, moduleIds)),
    ])
    const done = new Set(doneRows.map((r) => r.unitId))
    const labIds = moduleRows.flatMap((m) => (m.labId ? [m.labId] : []))
    const passedLabRows =
        userId && labIds.length > 0
            ? await db
                  .select({ labId: labProgress.labId })
                  .from(labProgress)
                  .where(
                      and(
                          eq(labProgress.userId, userId),
                          eq(labProgress.status, 'passed'),
                          inArray(labProgress.labId, labIds)
                      )
                  )
            : []
    const passedLabs = new Set(passedLabRows.map((r) => r.labId))
    // A module can belong to several courses — count its units toward each.
    const coursesByModule = new Map<string, string[]>()
    for (const r of memberRows) {
        const list = coursesByModule.get(r.moduleId) ?? []
        list.push(r.courseId)
        coursesByModule.set(r.moduleId, list)
    }
    const unitsByModule = new Map<string, string[]>()
    for (const unit of unitRows) {
        const list = unitsByModule.get(unit.moduleId) ?? []
        list.push(unit.id)
        unitsByModule.set(unit.moduleId, list)
    }
    const moduleById = new Map(moduleRows.map((m) => [m.id, m]))
    for (const [moduleId, courseIds] of coursesByModule) {
        const moduleUnits = unitsByModule.get(moduleId) ?? []
        const module = moduleById.get(moduleId)
        const complete =
            moduleUnits.length > 0 &&
            moduleUnits.every((unitId) => done.has(unitId)) &&
            (!module?.labId || passedLabs.has(module.labId))
        for (const courseId of courseIds) {
            const acc = out.get(courseId) ?? {
                unitCount: 0,
                unitsDone: 0,
                moduleCount: 0,
                modulesComplete: 0,
            }
            acc.moduleCount += 1
            if (complete) acc.modulesComplete += 1
            for (const unitId of moduleUnits) {
                acc.unitCount += 1
                if (done.has(unitId)) acc.unitsDone += 1
            }
            out.set(courseId, acc)
        }
    }
    return out
}

/**
 * Cheap change fingerprint for the path catalog — one round-trip guarding the
 * 4-query build (audit #237; same pattern as library.list).
 */
function pathsFingerprint(db: AppDb) {
    return async () => {
        const [row] = await db
            .select({
                p: sql<number>`(select count(*) from ${paths})`,
                s: sql<number>`(select count(*) from ${pathSections})`,
                m: sql<number>`(select count(*) from ${pathCourses})`,
                c: sql<number>`(select count(*) from ${courses})`,
                // Cards now carry `access`, and flipping a path from public to
                // authenticated changes NO count — a counts-only fingerprint
                // would keep serving the old, open card until the pod
                // restarted. `syncPaths` stamps updated_at on every upsert.
                t: sql<number>`(select coalesce(max(extract(epoch from updated_at)), 0) from ${paths})`,
            })
            .from(sql`(select 1) as one`)
        return `${row?.p ?? 0}:${row?.s ?? 0}:${row?.m ?? 0}:${row?.c ?? 0}:${row?.t ?? 0}`
    }
}

/** Path cards — fully static between deploys (no per-user data). */
async function buildPathList(db: AppDb) {
    // Retired paths stay in the table so their rows (and any learner state
    // hanging off them) survive, but they are not a learner-facing surface —
    // same contract `certification-graph` applies to certifications. Without
    // this filter the superseded role-axis paths render alongside the new
    // ladder, with colliding `order` values.
    const pathRows = await db
        .select()
        .from(paths)
        .where(eq(paths.status, 'published'))
        // `id` tie-break makes the ordering total — see `library.ts`'s
        // programId derivation for the general rationale. Inert today
        // (published paths' `order` values are unique), but the schema
        // places no uniqueness constraint on `order`.
        .orderBy(asc(paths.order), asc(paths.id))
    const sections = await db.select().from(pathSections)
    const memberships = await db.select().from(pathCourses)
    // A course card is a learner surface too: a coming_soon/draft course
    // authored ahead of its release must not inflate a published path's
    // courseCount/estMinutes roll-up (audit #status-read-sites).
    const courseRows = await db
        .select({ id: courses.id, estMinutes: courses.estMinutes })
        .from(courses)
        .where(PUBLISHED_COURSE)
    const estById = new Map(courseRows.map((c) => [c.id, c.estMinutes]))
    const sectionPath = new Map(sections.map((s) => [s.id, s.pathId]))
    const byPath = new Map<string, string[]>()
    for (const m of memberships) {
        const pathId = sectionPath.get(m.sectionId)
        if (!pathId) continue
        byPath.set(pathId, [...(byPath.get(pathId) ?? []), m.courseId])
    }
    return pathRows.map((p) => {
        const courseIds = [...new Set(byPath.get(p.id) ?? [])].filter((id) =>
            estById.has(id)
        )
        return {
            id: p.id,
            slug: p.slug,
            familyKey: p.familyKey,
            title: p.title,
            tagline: p.tagline,
            level: p.level,
            /** 'public' | 'authenticated' — see `paths.access`. */
            access: p.access,
            programId: p.programId,
            iconKey: p.iconKey,
            tone: p.tone,
            order: p.order,
            courseCount: courseIds.length,
            estMinutes: courseIds.reduce(
                (s, id) => s + (estById.get(id) ?? 0),
                0
            ),
        }
    })
}

