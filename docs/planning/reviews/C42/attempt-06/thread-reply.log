def exercise(app, endpoint, mgmt, academy, prepared, work, FINAL):
    global NATIVE
    obs = {"captures": {}, "origin": academy.origin}
    app.launch()
    pid = app.pid
    app.open_settings()
    app.type_into("AXTextField", "TSG ID (optional)", c8.TSG)
