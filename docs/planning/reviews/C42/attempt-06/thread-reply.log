#[derive(Clone, Debug)]
pub(super) enum LearnerPhase {
    SignedOut,
    Starting {
        flow: u64,
    },
    Awaiting {
        flow: u64,
        user_code: String,
        verification: Url,
        expires_at: Instant,
    },
    Completing {
        flow: u64,
    },
    SignedIn,
    Failed {
        failure: AcademyFailure,
        vault: Option<VaultError>,
    },
}

impl LearnerPhase {
    pub(super) fn flow(&self) -> Option<u64> {
        match self {
            Self::Starting { flow } | Self::Awaiting { flow, .. } | Self::Completing { flow } => {
                Some(*flow)
            }
            _ => None,
        }
    }
}

