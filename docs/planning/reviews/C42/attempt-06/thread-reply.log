   330	/** The Learning paths row: Academy's paths as its catalog lists them for this generation, read through the learner client. */
   331	function PathsRow() {
   332	    const trpc = useLearnerTrpc() as unknown as { paths: { list: { query(): Promise<unknown> } } }
   333	    const queryClient = useQueryClient()
   334	    const query = useQuery({
   335	        queryKey: PATHS_LIST_KEY,
   336	        queryFn: () => trpc.paths.list.query(),
   337	    })
   338	    // The row stays mounted across the learner's routes, and Academy's own completion hooks refresh the unit,
   339	    // course and dashboard rollups but not paths.list. A unit completion or a knowledge-check submission that
   340	    // settles in this generation's cache rereads the row: on success for the new counts, on an error (an
   341	    // uncertain outcome included) to read Academy's truth back without replaying the mutation.
   342	    useEffect(
   343	        () =>
   344	            queryClient.getMutationCache().subscribe((event) => {
   345	                if (event.type !== 'updated' || (event.action.type !== 'success' && event.action.type !== 'error')) return
   346	                const key = event.mutation.options.mutationKey?.[0]
   347	                if (Array.isArray(key) && PROGRESS_MUTATIONS.some((m) => m.length === key.length && m.every((p, i) => p === key[i]))) {
   348	                    void queryClient.invalidateQueries({ queryKey: PATHS_LIST_KEY })
   349	                }
   350	            }),
   351	        [queryClient]
   352	    )
   353	    const rows = pathRows(query.data)
   354	    return (
   355	        <section aria-labelledby='academy-paths' className='flex flex-col' style={{ gap: 12 }} data-slot='academy-paths'>
   356	            <h2 id='academy-paths' className='text-[15px] font-bold' style={{ marginTop: 6 }}>
   357	                {C.paths}
   358	            </h2>
   359	            {query.isPending ? (
   360	                <p role='status' className='text-[13px]' style={faint}>
   361	                    {C.pathsReading}
   362	                </p>
   363	            ) : query.isError ? (
   364	                <p role='alert' className='text-[13px]' style={faint}>
   365	                    {C.pathsFailed}
   366	                </p>
   367	            ) : rows.length === 0 ? (
   368	                <p className='text-[13px]' style={faint}>
   369	                    {C.pathsEmpty}
   370	                </p>
   371	            ) : (
   372	                <div className='grid' style={{ gridTemplateColumns: 'repeat(auto-fill, minmax(260px, 1fr))', gap: 16 }} data-slot='academy-path-cards'>
   373	                    {rows.map((p) => {
   374	                        const pct = p.unitCount > 0 ? Math.round((100 * p.unitsDone) / p.unitCount) : 0
   375	                        return (
   376	                            <Link
   377	                                key={p.id}
   378	                                to='/paths/$pathSlug'
   379	                                params={{ pathSlug: p.slug }}
   380	                                aria-label={C.openPath(p.title)}
   381	                                className='flex min-w-0 flex-col'
   382	                                style={{ ...CARD, padding: '18px 20px', gap: 10, color: 'var(--v2-ink)' }}
   383	                                data-slot='academy-path'
   384	                            >
   385	                                <span className='flex items-center' style={{ gap: 9 }}>
   386	                                    <span className='grid shrink-0 place-items-center rounded-[8px]' style={{ width: 28, height: 28, background: 'var(--v2-inset)', color: 'var(--v2-soft)' }}>
   387	                                        <Glyph name={FAMILY_GLYPH[p.familyKey ?? ''] ?? 'cap'} size={14} color='var(--v2-soft)' />
   388	                                    </span>
   389	                                    <b className='min-w-0 truncate'>{p.title}</b>
   390	                                    {p.locked ? (
   391	                                        <span className='ml-auto text-[12px]' style={faint}>
   392	                                            {C.pathLocked}
   393	                                        </span>
   394	                                    ) : null}
   395	                                </span>
   396	                                <span className='text-[12px]' style={{ minHeight: 32, ...soft }}>
   397	                                    {p.tagline}
   398	                                </span>
   399	                                <span
   400	                                    className='rounded-full'
   401	                                    style={{ height: 5, background: 'var(--v2-inset)' }}
   402	                                    role='progressbar'
   403	                                    aria-valuemin={0}
   404	                                    aria-valuemax={100}
   405	                                    aria-valuenow={pct}
   406	                                    aria-label={`${p.title} progress`}
   407	                                >
   408	                                    <span className='block h-full rounded-full' style={{ width: `${pct}%`, background: 'var(--v2-acc)' }} />
   409	                                </span>
   410	                                <span className='text-[12px]' style={faint}>
   411	                                    {C.pathMeta(p.unitCount, p.unitsDone, p.estMinutes)}
   412	                                </span>
   413	                            </Link>
   414	                        )
   415	                    })}
   416	                </div>
   417	            )}
   418	        </section>
   419	    )
