   620	                    style={{ height: 26, padding: '0 12px', gap: 6, background: displayName ? 'var(--v2-acc-soft)' : 'var(--v2-inset)', color: displayName ? 'var(--v2-acc)' : 'var(--v2-soft)' }}
   621	                    data-slot='academy-account'
   622	                >
