   549	function AcademyRoutes({
   550	    onNavigate,
   551	    container,
   552	    initialPath,
   553	    signedIn,
   554	    learner,
   555	}: {
   556	    onNavigate: (id: FeatureId) => void
   557	    container: React.RefObject<HTMLElement | null>
   558	    initialPath: string
   559	    signedIn: boolean
   560	    /** The generation: the router (and its history) is rebuilt per learner reference. */
   561	    learner: string
   562	}) {
   563	    const navigate = useRef(onNavigate)
   564	    navigate.current = onNavigate
   565	    // eslint-disable-next-line react-hooks/exhaustive-deps -- `learner` keys the router to the generation
   566	    const router = useMemo(() => academyRouter((id) => navigate.current(id), initialPath, signedIn), [initialPath, signedIn, learner])
   567	    useHeadingFocus(container, router)
   568	    const links = useLessonLinks(router)
   569	    return (
   570	        <div onClick={links.onClick} className='flex min-w-0 flex-col' style={{ gap: 20 }}>
   571	            <p role='status' aria-live='polite' data-slot='academy-link-notice' className='text-[13px] empty:hidden' style={soft}>
   572	                {links.notice}
   573	            </p>
   574	            <RouterProvider router={router} />
   575	        </div>
   576	    )
   577	}
