   480	/** Moves focus to the page heading after each navigation (keyboard and VoiceOver users). */
   481	function useHeadingFocus(container: React.RefObject<HTMLElement | null>, router: ReturnType<typeof academyRouter>) {
   482	    useEffect(() => {
   483	        let tries = 0
   484	        let frame = 0
   485	        const tryFocus = () => {
   486	            const active = document.activeElement
   487	            if (active && active !== document.body && !container.current?.contains(active)) return
   488	            const heading = container.current?.querySelector('[data-slot="academy-pages"] h1')
   489	            if (heading instanceof HTMLElement) {
   490	                focusHeading(heading)
   491	            } else if (tries++ < 300) {
   492	                frame = requestAnimationFrame(tryFocus)
   493	            }
   494	        }
   495	        const unsubscribe = router.subscribe('onResolved', ({ pathChanged }) => {
   496	            if (!pathChanged) return
   497	            tries = 0
   498	            cancelAnimationFrame(frame)
   499	            frame = requestAnimationFrame(tryFocus)
   500	        })
   501	        return () => {
   502	            unsubscribe()
   503	            cancelAnimationFrame(frame)
   504	        }
   505	    }, [container, router])
   506	}
