//! C42: the Academy as the R2App board draws it, through the production
//! authority interface against a synthetic Academy (docs/planning/chunks/
//! C42.md). What the chrome draws from: the snapshot's `academy`,
//! `learner`, `academyOrigin` and `academyOffline` as a guest and after
//! signing in (a new learner generation); the Learning paths row's
//! `paths.list` is a public query the guest generation reads without any
//! credential and the account generation reads with its token. Nothing
//! here signs in or sends by itself: every call is an intent the view would
//! send.

include!("../academy_identity/harness.rs");

fn paths_reply() -> Value {
    json!({"result": {"data": {"json": [{
        "id": "path-runtime", "slug": "runtime-path", "title": "Runtime Security Path",
        "tagline": "Protect prompts and responses at runtime.", "familyKey": "prisma-airs",
        "iconKey": null, "tone": "info", "courseCount": 1, "estMinutes": 30,
        "unitCount": 4, "unitsDone": 0, "locked": false, "lockReason": null}]}}})
}

fn snapshot_json(desk: &Desk) -> Value {
    serde_json::to_value(desk.snap()).expect("json")
}

#[tokio::test(flavor = "multi_thread")]
async fn the_chrome_draws_from_the_snapshot_as_a_guest_then_as_the_account() {
    let mut desk = desk().await;
    let origin = desk.script.lock().expect("script").origin.clone();
    // A guest: signed out, the guest generation, Academy's origin, offline work signed out and reachable.
    let s = snapshot_json(&desk);
    assert_eq!(s["academy"]["state"], "signedOut", "{s}");
    let guest = s["learner"].as_str().expect("guest learner").to_owned();
    assert_eq!(s["academyOrigin"], origin);
    assert_eq!(s["academyOffline"]["state"], "signedOut");
    assert_eq!(s["academyOffline"]["reachable"], true);
    assert_eq!(s["academyOffline"]["downloads"], json!([]));
    // The Learning paths row: a public query, sent without any credential.
    desk.script.lock().expect("script").trpc = vec![("paths.list".into(), 200, paths_reply())];
    let reply = desk
        .call_as(&guest, "paths.list", "query", None)
        .await
        .expect("admitted");
    assert_eq!(data_of(reply)["json"][0]["title"], "Runtime Security Path");
    let seen = &trpc(&desk, "paths.list")[0];
    assert_eq!(seen.header("authorization"), None);
    assert_eq!(seen.request_line.split(' ').next(), Some("GET"));
    // Signed in from Settings: the account's name, a new generation, offline work for the account.
    desk.sign_in().await;
    let s = snapshot_json(&desk);
    assert_eq!(s["academy"]["state"], "signedIn", "{s}");
    assert_eq!(s["academy"]["displayName"], "Ada Lovelace");
    let account = s["learner"].as_str().expect("account learner").to_owned();
    assert_ne!(account, guest, "a new generation");
    assert_eq!(s["academy"]["learner"], account);
    assert_ne!(s["academyOffline"]["state"], "signedOut");
    // The row's query as the account carries its token.
    desk.script.lock().expect("script").trpc = vec![("paths.list".into(), 200, paths_reply())];
    desk.call("paths.list", "query", None)
        .await
        .expect("admitted");
    let calls = trpc(&desk, "paths.list");
    assert_eq!(calls.len(), 2);
    assert_eq!(calls[1].header("authorization"), Some("Bearer access-1"));
}

#[tokio::test(flavor = "multi_thread")]
async fn a_guest_generation_cannot_read_account_pages_the_frame_offers_only_when_signed_in() {
    let mut desk = desk().await;
    let guest = desk.current_learner();
    // The frame offers Home, Program, Downloads, Notifications and Settings only when signed in:
    // the guest generation is refused their reads before anything is sent.
    for procedure in ["progress.get", "notifications.list", "settings.get"] {
        let refused = desk.call_as(&guest, procedure, "query", None).await.err();
        assert_eq!(refused, Some(Refusal::CapabilityMissing), "{procedure}");
    }
    assert!(
        desk.server
            .seen()
            .iter()
            .all(|s| !s.request_line.contains("/api/trpc/progress"))
    );
}

fn data_of(result: AcademyCallResult) -> Value {
    let AcademyCallResult::Data { data } = result else {
        panic!("{result:?}")
    };
    serde_json::from_str(&data).expect("json")
}

fn trpc(desk: &Desk, procedure: &str) -> Vec<Seen> {
    desk.requests(&format!("/api/trpc/{procedure}"))
}
/**
 * Account-scoped React Query cache and Academy learner host. Every learner
 * reference (an account generation, or the guest generation while signed
 * out) gets its own QueryClient and a remounted subtree: signing in or out,
 * or changing account, retires the previous cache, so no reply or cached
 * value for one account is shown to another. Tenant switches do not change
 * the learner reference and keep the cache.
 */
import { createContext, type ReactNode, useCallback, useContext, useEffect, useMemo } from 'react'
import { QueryClient, QueryClientProvider } from '@tanstack/react-query'
import { createTRPCClient, TRPCClientError, type TRPCClient } from '@trpc/client'
import type { AnyRouter } from '@trpc/server'
import SuperJSON from 'superjson'
import { LearnerHost } from '@ai-security-academy/learner'
import type { DesktopClient, LearnerRef } from '@prisma-airs/desktop-contracts'
import { desktopLink } from './desktop-link'
import { hostAction, loadAcademyImage, nativeLocalDrafts } from './host-actions'

const NO_RETRY = new Set([
    'UNAUTHORIZED',
    'FORBIDDEN',
    'BAD_REQUEST',
    'NOT_FOUND',
    'PRECONDITION_FAILED',
    'METHOD_NOT_SUPPORTED',
])

/** Queries may be asked once more after a transient failure; mutations never. */
export function learnerQueryClient(): QueryClient {
    return new QueryClient({
        defaultOptions: {
            queries: {
                staleTime: 60_000,
                retry: (count, error) =>
                    count < 1 &&
                    !(error instanceof TRPCClientError && NO_RETRY.has(String((error.data as { code?: unknown })?.code))),
            },
            mutations: { retry: false },
        },
    })
}

const TrpcContext = createContext<TRPCClient<AnyRouter> | null>(null)

/** A plain learner tRPC client for the current generation (inside a provider). */
export function useLearnerTrpc<TRouter extends AnyRouter>(): TRPCClient<TRouter> {
    const client = useContext(TrpcContext)
    if (!client) throw new Error('useLearnerTrpc needs a LearnerProvider')
    return client as unknown as TRPCClient<TRouter>
}

interface Props {
    client: DesktopClient
    learner: LearnerRef
    /** Academy's account id when signed in; null for the guest generation. */
    accountId?: string | null
    /** The signed-in account's display name, for Academy's account pages. */
    displayName?: string | null
    theme?: 'gruvbox' | 'paper'
    /** Academy web's origin (public links such as certificate verify URLs). */
    webOrigin?: string | null
    children: ReactNode
}

function Generation({
    client,
    learner,
    accountId = null,
    displayName = null,
    theme = 'gruvbox',
    webOrigin = null,
    children,
}: Props) {
    const queryClient = useMemo(() => learnerQueryClient(), [])
    const links = useMemo(
        () => [
            desktopLink<AnyRouter>({
                client,
                learner: () => learner,
                signedIn: () => accountId !== null,
                transformer: SuperJSON,
            }),
        ],
        [client, learner, accountId]
    )
    const trpc = useMemo(() => createTRPCClient<AnyRouter>({ links }), [links])
    // The generation is Academy's learner session: a new one (sign-in,
    // sign-out, reset, even for the same account) retires Academy's
    // learner-scoped state.
    const identity = useMemo(
        () => ({
            userId: accountId,
            session: learner,
            // The desktop knows the account's display name only; the email
            // and uploaded photo come from Academy's settings read.
            profile: accountId ? { fullName: displayName, firstName: null, email: null, imageUrl: null } : null,
        }),
        [accountId, learner, displayName]
    )
    // Native actions Academy's pages ask the host for: sign-out ends the
    // learner session in the core; print opens the native print sheet; the
    // avatar is chosen, checked and uploaded natively and read back as a
    // data URL (this WebView loads no remote images).
    const onSignOut = useCallback(() => void client.dispatch({ kind: 'signOutAcademy' }).catch(() => undefined), [client])
    const onPrint = useCallback(() => hostAction(client, { kind: 'printPage', learner }), [client, learner])
    const onUploadAvatar = useCallback(() => hostAction(client, { kind: 'uploadAvatar', learner }), [client, learner])
    const loadImage = useCallback(
        (url: string) => loadAcademyImage(client, { kind: 'loadAcademyImage', learner, url }),
        [client, learner]
    )
    // Lab work Academy has not confirmed is sealed in the core for this
    // account (signed in only); the core never sends it by itself.
    const localDrafts = useMemo(
        () => (accountId === null ? undefined : nativeLocalDrafts(client, learner)),
        [client, learner, accountId]
    )
    useEffect(() => () => queryClient.clear(), [queryClient])
    return (
        <QueryClientProvider client={queryClient}>
            <TrpcContext.Provider value={trpc}>
                <LearnerHost
                    links={links}
                    queryClient={queryClient}
                    identity={identity}
                    theme={theme}
                    labs='desktop'
                    diagrams='prerendered'
                    webOrigin={webOrigin}
                    onSignOut={onSignOut}
                    onPrint={onPrint}
                    remoteImages={false}
                    loadImage={loadImage}
                    avatarUpload={accountId !== null}
                    onUploadAvatar={onUploadAvatar}
                    appearance='host'
                    assessorTools={false}
                    awardPresenters={false}
                    courseReset
                    lessonFeedback
                    localDrafts={localDrafts}
                >
                    {children}
                </LearnerHost>
            </TrpcContext.Provider>
        </QueryClientProvider>
    )
}

export function LearnerProvider(props: Props) {
    // Keyed by generation: query observers bind to the client they first
    // saw, so the learner subtree remounts and keeps nothing from the
    // previous account.
    return <Generation key={props.learner} {...props} />
}

