   508	/**
   509	 * Lesson bodies are server-compiled HTML whose links are plain anchors. A
   510	 * learner path routes within the destination; an in-page anchor scrolls;
   511	 * any other address stays out of the window and the learner is told.
   512	 */
   513	function useLessonLinks(router: ReturnType<typeof academyRouter>) {
   514	    const [notice, setNotice] = useState<string | null>(null)
   515	    const onClick = useCallback(
   516	        (event: React.MouseEvent<HTMLElement>) => {
   517	            if (event.defaultPrevented) return
   518	            const anchor = (event.target as Element | null)?.closest?.('a[href]')
   519	            if (!anchor || !event.currentTarget.contains(anchor)) return
   520	            event.preventDefault()
   521	            const href = anchor.getAttribute('href') ?? ''
   522	            if (href.startsWith('#')) {
   523	                const target = href.length > 1 ? event.currentTarget.querySelector(`[id="${CSS.escape(href.slice(1))}"]`) : null
   524	                target?.scrollIntoView({ block: 'start' })
   525	                setNotice(null)
   526	                return
   527	            }
   528	            let url: URL
   529	            try {
   530	                url = new URL(href, window.location.href)
   531	            } catch {
   532	                setNotice(C.linkUnopenable)
   533	                return
   534	            }
   535	            if (url.origin === window.location.origin) {
   536	                setNotice(null)
   537	                void router.navigate({ to: `${url.pathname}${url.search}${url.hash}` })
   538	            } else if (url.protocol === 'https:' || url.protocol === 'http:') {
   539	                setNotice(C.linkOutside(url.host, url.href))
   540	            } else {
   541	                setNotice(C.linkUnopenable)
   542	            }
   543	        },
   544	        [router]
   545	    )
   546	    return { notice, onClick }
   547	}
