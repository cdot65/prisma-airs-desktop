/** paths.list card rows — cached catalog + the caller's unit rollups
 *  (shared by `list` and `recommended`). */
async function pathCardsForUser(db: AppDb, userId: string | null) {
    // Static catalog stays per-DB cached; the caller's progress rollup is
    // layered on per request (Reading Room: path rows show "in progress"
    // + a progress fill on the paths/home screens).
    const base = await cachedPerDb(db, 'paths-list', pathsFingerprint(db), () =>
        buildPathList(db)
    )
    const sections = await db.select().from(pathSections)
    const memberships = await db.select().from(pathCourses)
    // Same PUBLISHED_COURSE definition buildPathList's courseCount/estMinutes
    // use — a coming_soon course must not count toward this progress total
    // either, even once it has modules (fix round 1, Finding 2).
    const publishedRows = await db
        .select({ id: courses.id })
        .from(courses)
        .where(PUBLISHED_COURSE)
    const publishedIds = new Set(publishedRows.map((r) => r.id))
    const sectionPath = new Map(sections.map((s) => [s.id, s.pathId]))
    const byPath = new Map<string, string[]>()
    for (const m of memberships) {
        const pathId = sectionPath.get(m.sectionId)
        if (!pathId) continue
        byPath.set(pathId, [...(byPath.get(pathId) ?? []), m.courseId])
    }
    const allCourseIds = [
        ...new Set(memberships.map((m) => m.courseId)),
    ].filter((id) => publishedIds.has(id))
    const rollup = await courseUnitRollup(db, allCourseIds, userId)
    return base.map((p) => {
        const courseIds = [...new Set(byPath.get(p.id) ?? [])].filter((id) =>
            publishedIds.has(id)
        )
        const totals = courseIds.reduce(
            (acc, id) => {
                const r = rollup.get(id)
                acc.unitCount += r?.unitCount ?? 0
                acc.unitsDone += r?.unitsDone ?? 0
                acc.moduleCount += r?.moduleCount ?? 0
                acc.modulesComplete += r?.modulesComplete ?? 0
                return acc
            },
            {
                unitCount: 0,
                unitsDone: 0,
                moduleCount: 0,
                modulesComplete: 0,
            }
        )
        return { ...p, ...totals }
    })
}

