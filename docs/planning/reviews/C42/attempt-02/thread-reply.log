                                    {p.locked ? (
                                        <span className='ml-auto text-[12px]' style={faint}>
                                            {C.pathLocked}
                                        </span>
                                    ) : null}
                                </span>
                                <span className='text-[12px]' style={{ minHeight: 32, ...soft }}>
                                    {p.description}
                                </span>
                                <span
                                    className='rounded-full'
                                    style={{ height: 5, background: 'var(--v2-inset)' }}
                                    role='progressbar'
                                    aria-valuemin={0}
                                    aria-valuemax={100}
                                    aria-valuenow={pct}
                                    aria-label={`${p.title} progress`}
                                >
