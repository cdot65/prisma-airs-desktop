import { useMemo, useState } from 'react'
import { Navigate } from '@tanstack/react-router'
import { trpc } from '@/lib/trpc'
import { Kicker, PageColumn, ProgressBar, RowTile } from '@/components/ax'
import { QueryError } from '@/components/query-state'
import { useSetPageHeader } from '@/components/shell/page-header'
import { AccessGateView, isAccessDenied } from '../components/access-gate'
import { CourseTabs } from '../components/course-tabs'
import { PathCourseCard } from '../components/path-course-card'
import { courseIcon } from '../course-icon'
import { isPathCourseStaged } from '../path-course-availability'
import { pathLevelLabel } from '../path-level'

const TABS = [
    { id: 'courses', label: 'Courses' },
    { id: 'about', label: 'About' },
] as const
type TabId = (typeof TABS)[number]['id']

/**
 * Path landing (`/paths/$pathSlug`) — the roadmap, opened (design: Reading
 * Room System 3a): one centered 820px editorial column — PATH kicker, hot
 * icon tile + title + level rung, tagline as the lead, Courses/About tabs; each
 * section renders heading + inline rollup progress + blurb + its course rows.
 * Unknown slugs that match a COURSE slug redirect to the course overview
 * (pre-rename `/paths/:id` URLs keep working).
 */
export function PathLandingPage({ pathSlug }: { pathSlug: string }) {
    const pathQuery = trpc.paths.get.useQuery({ pathSlug })
    // Only consulted for the legacy-course-slug redirect on a path miss.
    const coursesQuery = trpc.courses.list.useQuery(undefined, {
        enabled: pathQuery.error?.data?.code === 'NOT_FOUND',
    })
    const [tab, setTab] = useState<TabId>('courses')
    const path = pathQuery.data

    const header = useMemo(
        () => ({
            breadcrumbs: [
                { label: 'Paths', to: '/paths' },
                { label: path?.title ?? 'Path' },
            ],
        }),
        [path?.title]
    )
    useSetPageHeader(header)

    if (pathQuery.isLoading) {
        return <p className='text-academy-ink-faint p-8 text-sm'>Loading…</p>
    }
    // A locked path is an ANSWER, not a miss: the server said who may enter
    // and why this reader may not (sign in / ask your admin / finish the
    // previous path). Only a genuine miss falls through to the legacy
    // course-slug redirect and "Path not found."
    if (pathQuery.isError && isAccessDenied(pathQuery.error)) {
        return <AccessGateView error={pathQuery.error} />
    }
    if (pathQuery.isError && pathQuery.error?.data?.code !== 'NOT_FOUND')
        return (
            <PageColumn>
                <QueryError
                    title='Unable to load this learning path.'
                    onRetry={() => void pathQuery.refetch()}
                    retrying={pathQuery.isFetching}
                />
            </PageColumn>
        )
    if (!path) {
        if (coursesQuery.isLoading)
            return (
                <p role='status' className='p-8 text-sm'>
                    Looking for this course…
                </p>
            )
        if (coursesQuery.isError)
            return (
                <QueryError
                    title='Unable to find this course.'
                    onRetry={() => void coursesQuery.refetch()}
                    retrying={coursesQuery.isFetching}
                />
            )
        const course = coursesQuery.data?.find((c) => c.slug === pathSlug)
        if (course) {
            return (
                <Navigate
                    to='/courses/$courseSlug'
                    params={{ courseSlug: course.slug }}
                    replace
                />
            )
        }
        return (
            <p className='text-academy-ink-faint p-8 text-sm'>
                Path not found.
            </p>
        )
    }

    return (
        <PageColumn>
            <header>
                <Kicker tone='accent'>Path</Kicker>
                <div className='mt-4 flex items-center gap-5'>
                    <RowTile
                        icon={courseIcon(path.iconKey)}
                        hot
                        size={56}
                        className='rounded-[14px]'
                    />
                    <div>
                        <h1 className='font-display text-academy-ink text-[40px] leading-[1.08] font-extrabold tracking-[-0.02em]'>
                            {path.title}
                        </h1>
                        {/* The retired role axis used to live here (now
                         * dropped from paths.get) — this is the ladder rung
                         * (spec §3.2), same label as the library card badge
                         * ({@link pathLevelLabel}), never a second spelling. */}
                        <p
                            data-testid='path-level-label'
                            className='text-academy-ink-faint mt-2.5 font-mono text-[12px] leading-[normal] font-semibold tracking-[0.16em] uppercase'
