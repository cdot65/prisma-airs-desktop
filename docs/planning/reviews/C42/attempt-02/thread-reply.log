                                </span>
                                <span className='text-[12px]' style={faint}>
                                    {C.pathMeta(p.unitCount, p.unitsDone, p.estMinutes)}
                                </span>
                            </Link>
                        )
                    })}
                </div>
            )}
        </section>
    )
}

