    AcknowledgeItem {
        context: ContextRef,
        id: String,
    },
    /// Set an Inbox entry aside for 24 hours; the return time is computed
    /// here and shown wherever the entry appears (C30, I11).
    SnoozeItem {
        context: ContextRef,
        id: String,
    },
    /// Bring a held entry back.
    UnsnoozeItem {
        context: ContextRef,
