                                <Verdict tone={toneOf(e.severity)} word={e.severity === 'bad' ? 'Critical' : e.severity === 'warn' ? 'Warning' : 'Info'} />
                                <span className='flex-grow text-[13px] font-medium'>{e.title}</span>
