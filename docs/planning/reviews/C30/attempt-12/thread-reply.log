s/planning/worktree-preservation/2026-11-01/snapshots/prisma-airs-desktop-v2-c37/docs/planning/evidence/C37/parity/inbox-dark.png\ndocs/planning/worktree-preservation/2026-11-01/snapshots/prisma-airs-desktop-v2-c37/docs/planning/evidence/C37/parity/bundle.json\ndocs/planning/worktree-preservation/2026-11-01/snapshots/prisma-airs-desktop-v2-c37/docs/planning/evidence/C37/native/captures/parity-inbox-light.png\ndocs/planning/worktree-preservation/2026-11-01/snapshots/prisma-airs-desktop-v2-c37/docs/planning/evidence/C37/native/captures/parity-inbox-dark.png\ndocs/planning/evidence/C36/parity/home-dark.png\ndocs/planning/evidence/C36/parity/notes.md\ndocs/planning/evidence/C36/parity/bundle.json\ndocs/planning/evidence/C36/parity/home-light.png\ndocs/planning/evidence/C37/parity/inbox-light.png\ndocs/planning/evidence/C37/parity/inbox-dark.png\n","exit_code":0,"status":"completed"}}
