{"type":"item.completed","item":{"id":"item_58","type":"command_execution","command":"/bin/zsh -lc \"nl -ba tools/native-acceptance/legacy_assertions.py | sed -n '326,333p'; nl -ba tools/native-acceptance/acceptance_c37.py | sed -n '365,390p'; nl -ba tools/native-acceptance/acceptance_c37.py | sed -n '143,171p'; nl -ba tools/native-acceptance/acceptance_c38.py | sed -n '419,435p'; python3 -B -c 'import json,hashlib,pathlib; root=pathlib.Path.cwd(); sha=lambda p:hashlib.sha256(p.read_bytes()).hexdigest(); d=root/\\\"docs/planning/reviews/C29/attempt-10\\\"; r=json.load(open(d/\\\"request.json\\\")); inv=json.load(open(d/\\\"source-inventory.json\\\"))[\\\"files\\\"]; bad=[p for p,h in inv.items() if not (root/p).is_file() or sha(root/p)\"'!=h]; print(\"C29 predecessor scoped mismatches\",len(bad),bad[:8]); p=root/\"docs/planning/reviews/C30/attempt-12\"; inv=json.load(open(p/\"source-inventory.json\"))[\"files\"]; print(\"FINAL C30 scope\",len(inv),\"mismatches\",[p for p,h in inv.items() if sha(root/p)!=h]); l=json.load(open(\"docs/planning/evidence/C29/live/L19-verify.json\")); print(\"L19 receipt hash\",sha(root/l[\"native_receipt\"])==l[\"native_receipt_sha256\"]); print(\"L19 executable\",sha(root/\"docs/planning/evidence/C29/live/L19/build-02/l19-qualification-executable.bin\")==l[\"executable_sha256\"]); build=json.load(open(\"docs/planning/evidence/C29/live/L19/attempt-03/build.json\")); print(\"L19 build keys\",list(build)); p=root/\"docs/planning/evidence/C30/remediation-attempt-11\"; pf=json.load(open(p/\"preflight.json\")); print(\"remediation logs mismatches\",[n for n,h in pf[\"logs_sha256\"].items() if sha(p/n)!=h]); print(\"performance p95\",max(json.load(open(\"docs/planning/evidence/P09/workload-perf-C30.json\"))[\"metrics\"][\"tenant-switch-home\"][\"samples\"]))'\"'; git status --short\"","aggregated_output":"   326\t    \"C29-N06\": (X, [\"C43-N03\"], \"all seven first-run and five add-tenant steps in Light/Dark at 100%/200% (48 rows), with per-row keyboard reach, geometry, AX tree and capture; the Tenant primary's focus ring\"),\n   327\t    # ---- C30 Inbox and reads → C36, C37 ----\n   328\t    \"C30-N01\": (X, [\"C38-N03\"], \"the guard through the switcher, the palette and the Go menu with a decision waiting; Escape and Stay keep the tenant and the decision; Archive and switch ends the conversation and lands the other tenant on Home with no engine (invariant I1)\"),\n   329\t    \"C30-N02\": (X, [\"C36-N01\", \"C37-N01\"], \"'First read pending' on Home and in the Inbox; Read now runs the read\"),\n   330\t    \"C30-N03\": (X, [\"C37-N01\"], \"snooze, acknowledge and unsnooze with the core's return time stated the same everywhere\"),\n   331\t    \"C30-N04\": (X, [\"C37-N02\"], \"Tab from Read now reaches the tabs and rows; Enter opens a row's detail\"),\n   332\t    # ---- C31 Administration → C39 ----\n   333\t    \"C31-N01\": (X, [\"C39-N01\"], \"the inventory per tab with exactly its admitted actions; the gated products show their gate\"),\n   365\t    time.sleep(0.5)\n   366\t    # The C30 holds, from the detail card: snooze (the core's time in the row, the detail and the toast), unsnooze, acknowledge.\n   367\t    snooze = starts(inside, (\"AXButton\",), \"Snooze 24 hours\")\n   368\t    if snooze:\n   369\t        app.ax(\"press\", \"AXButton\", snooze[\"label\"])\n   370\t        tree, toasted = app.wait_for(lambda t: any(\"snoozed · returns\" in x for x in app.texts(t)), 10)\n   371\t        toast_text = next((x for x in app.texts(tree) if \"snoozed · returns\" in x), \"\")\n   372\t        n1[\"snooze_toast\"] = toasted\n   373\t        returns_toast = toast_text.split(\"returns \", 1)[1].rstrip(\"×\").strip() if \"returns \" in toast_text else None\n   374\t        tab = tab_node(app.tree(), \"Snoozed\")\n   375\t        app.ax(\"press\", tab[\"role\"], tab[\"label\"]) if tab else None\n   376\t        time.sleep(0.6)\n   377\t        tree = app.tree()\n   378\t        row = next((n for n in rows_of(tree, region(tree, \"Inbox list\")) if \"Returns \" in (n.get(\"label\") or \"\")), None)\n   379\t        # The row's name ends with the entry's own time after the return wording: \"Returns tomorrow 03:16 03:16\".\n   380\t        row_returns = re.sub(r\"\\s+\\d\\d:\\d\\d$\", \"\", row[\"label\"].split(\"Returns \", 1)[1].strip()) if row and \"Returns \" in row[\"label\"] else None\n   381\t        app.ax(\"press\", \"AXButton\", row[\"label\"][:60]) if row else None\n   382\t        time.sleep(0.5)\n   383\t        tree = app.tree()\n   384\t        pane_returns = next(((n.get(\"label\") or \"\")[len(\"Returns \"):] for n in within(tree, region(tree, \"Details\")) if n.get(\"role\") == \"AXStaticText\" and (n.get(\"label\") or \"\").startswith(\"Returns \")), None)\n   385\t        n1[\"snooze_times\"] = {\"toast\": returns_toast, \"row\": row_returns, \"pane\": pane_returns}\n   386\t        n1[\"snooze_same\"] = bool(returns_toast) and returns_toast == row_returns == pane_returns\n   387\t        c29.press(app, \"AXButton\", \"Unsnooze\")\n   388\t        _, n1[\"unsnoozed\"] = app.wait_for(lambda t: starts(t, (\"AXButton\",), \"Snooze 24 hours\") is not None, 8)\n   389\t        tab = tab_node(app.tree(), \"All\")\n   390\t        app.ax(\"press\", tab[\"role\"], tab[\"label\"]) if tab else None\n   143\t    \"\"\"From Read now, Tab reaches a tab and a row; Enter on a row the detail does not show changes the\n   144\t    detail to it (the row is focused first, so it is scrolled into the viewport).\"\"\"\n   145\t    app.ax(\"focus\", \"AXButton\", \"Read now\")\n   146\t    time.sleep(0.3)\n   147\t    walk = [(((f or {}).get(\"label\")) or \"\")[:44] for f in app.tab_walk(14)]\n   148\t    tree = app.tree()\n   149\t    lst = region(tree, \"Inbox list\")\n   150\t    rows = rows_of(tree, lst)\n   151\t    detail = region(tree, \"Details\")\n   152\t    shown = next(((n.get(\"label\") or \"\") for n in within(tree, detail) if n.get(\"role\") == \"AXHeading\"), \"\") if detail else \"\"\n   153\t    reach = {\"tab\": next((i for i, l in enumerate(walk) if l.startswith(\"All\")), None),\n   154\t             \"row\": next((i for i, l in enumerate(walk) if rows and any(l and (r.get(\"label\") or \"\").startswith(l[:12]) for r in rows)), None)}\n   155\t    target = next((r for r in rows if not shown or shown not in (r.get(\"label\") or \"\")), None)\n   156\t    out = {\"walk\": walk, \"reach\": reach, \"shown_before\": shown, \"target\": (target or {}).get(\"label\")}\n   157\t    if target:\n   158\t        app.ax(\"focus\", \"AXButton\", target[\"label\"][:60])\n   159\t        time.sleep(0.3)\n   160\t        t = app.tree()\n   161\t        focused = fx.App.focused(t) or {}\n   162\t        win = next((n for n in t if n.get(\"role\") == \"AXWindow\"), None)\n   163\t        out[\"focused_row\"] = (focused.get(\"label\") or \"\") == target[\"label\"]\n   164\t        out[\"row_in_viewport\"] = contained(focused, win) if win else False\n   165\t        app.keycode(36)\n   166\t        _, out[\"enter_changed\"] = app.wait_for(lambda t: region(t, \"Details\") is not None and any(\n   167\t            n.get(\"role\") == \"AXHeading\" and (n.get(\"label\") or \"\") and (n.get(\"label\") or \"\") in (target[\"label\"] or \"\") and (n.get(\"label\") or \"\") != shown\n   168\t            for n in within(t, region(t, \"Details\"))), 8)\n   169\t    out[\"ok\"] = all(i is not None for i in reach.values()) and reach[\"tab\"] < reach[\"row\"] and bool(target) and out.get(\"focused_row\", False) and out.get(\"row_in_viewport\", False) and out.get(\"enter_changed\", False)\n   170\t    return out\n   171\t\n   419\t    tree, n3[\"switcher_guard\"] = app.wait_for(lambda t: guard_dialog(t) is not None, 10)\n   420\t    n3[\"guard_buttons\"] = [l for l in (\"Stay\", \"Discard and switch\", \"Archive and switch\") if fx.App.node(tree, \"AXButton\", l)]\n   421\t    n3[\"guard_names_target\"] = app.has_text(tree, f\"Switching to {