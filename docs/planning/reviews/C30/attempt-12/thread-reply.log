le_sha256\\\"]==prep[\\\"executable_sha256\\\"] and e[\\\"required_check_errors\\\"]==[]\n for cid in n[\\\"required_targets\\\"]:\n  c=next(x for x in r[\\\"checks\\\"] if x[\\\"id\\\"]==cid); assert c[\\\"result\\\"]==\\\"pass\\\" and all((root/x).exists() for x in c[\\\"evidence\\\"])\n print(n[\\\"subject\\\"],\\\"mapped native hashes/targets/driver/prepare/executable consistent\\\")\n'\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
