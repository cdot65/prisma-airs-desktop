/native-build-inputs.json\\\"); prep=read(root/\\\"docs/planning/evidence/P09/native-prepare.json\\\"); assert sha(root/build[\\\"inputs\\\"][\\\"before_inventory\\\"])==sha(root/build[\\\"inputs\\\"][\\\"after_inventory\\\"])==run[\\\"inputs\\\"][\\\"before_digest\\\"]; assert sha(root/build[\\\"command\\\"][\\\"log\\\"])==build[\\\"command\\\"][\\\"log_sha256\\\"]; print(\\\"native build/check seals and build log match\\\")\nsys.path.insert(0,str(root/\\\"tools/p09\\\")); import phase_inputs as pi; records=[]\nfor p in (root/\\\"docs/planning/evidence/P09/native/cumulative\\\").glob(\\\"*/execution.json\\\"):\n e=read(p); records.append({\\\"subject\\\":e[\\\"driver_subject\\\"],\\\"started_utc\\\":e[\\\"started_utc\\\"],\\\"finished_utc\\\":e[\\\"finished_utc\\\"]})\ne=read(root/\\\"docs/planning/evidence/P09/execution.json\\\"); records.append({\\\"subject\\\":\\\"C44\\\",\\\"started_utc\\\":e[\\\"started_utc\\\"],\\\"finished_utc\\\":e[\\\"finished_utc\\\"]}); summary=pi.verify_c30_performance(root,prep,{\\\"input_digest\\\":build[\\\"inputs\\\"][\\\"before_digest\\\"]},records); print(\\\"performance raw samples/AX/current bindings/serial interval audit\\\",summary)\nrequest=read(root/\\\"docs/planning/reviews/C30/attempt-12/request.json\\\")\nfor n in request[\\\"native_acceptance\\\"][\\\"mapped_records\\\"]:\n p=root/n[\\\"record\\\"]; r=read(p); e=read(p.parent/\\\"execution.json\\\"); assert sha(p)==n[\\\"sha256\\\"]==e[\\\"raw_record_sha256\\\"]; assert sha(p.parent/\\\"native-prepare.json\\\")==sha(root/\\\"docs/planning/evidence/P09/native-prepare.json\\\"); assert e[\\\"driver_sha256\\\"]==sha(root/\\\"tools/native-acceptance\\\"/(\\\"acceptance_\\\"+n[\\\"subject\\\"].lower()+\\\".py\\\")); assert e[\\\"controller_sha256\\\"]==sha(root/\\\"docs/planning/evidence/P09/native-controller/run-p09-native.py\\\"); assert e[\\\"requirements_sha256\\\"]==sha(root/\\\"docs/planning/evidence/P09/native-controller/native_requirements.py\\\"); assert e[\\\"execut