ulti_thread\")]\n1156:async fn a_failed_product_attempt_is_reported_and_never_replaces_its_last_read() {\n1240:#[tokio::test(flavor = \"multi_thread\")]\n1241:async fn unread_chosen_products_stay_in_coverage_after_a_partial_attempt() {\n1307:#[tokio::test(flavor = \"multi_thread\")]\n1308:async fn a_first_product_recheck_refused_for_a_role_is_a_settled_attempt() {\n1343:#[tokio::test(flavor = \"multi_thread\")]\n1344:async fn an_expired_read_is_a_gap_not_an_all_clear_and_stays_so_across_a_switch() {\n1379:#[tokio::test(flavor = \"multi_thread\")]\n1380:async fn a_refresh_over_an_expired_read_restores_nothing_until_it_lands() {\n1426:#[tokio::test(flavor = \"multi_thread\")]\n1427:async fn a_snoozed_update_returns_at_its_deadline_and_is_published() {\n//! C30 (D058): the Inbox and read scopes through the production authority\n//! interface against a synthetic management plane: per-tenant isolation\n//! (I2), read status transitions and partial coverage (I4), the snooze\n//! return time computed in the core (I11), a fresh tenant's empty scopes\n//! (I12), and setup warnings (C29) as entries the operator can hold.\n\n#[allow(dead_code)]\n#[path = \"../context_credentials/support.rs\"]\nmod support;\n\nuse std::sync::{Arc, Mutex};\nuse std::time::Duration;\n\nuse desktop_core::features::ProductId;\nuse desktop_core::fixtures::{self, Handles};\nuse desktop_core::management::ManagementEndpoints;\nuse desktop_core::transport::{ProxyMode, TransportPolicy};\nuse desktop_core::{\n    AttentionFace, AuthorityHandle, Core, CoreConfig, Delivery, HoldKind, InboxKind, Intent,\n    Observation, ProductReadState, ReadState, Receipt, Refusal, ScanState, ShellSnapshot,\n    ViewScope,\n};\nuse serde_json::{Value, json};\n\nuse crate::support::{Reply, Seen, TestCa, TlsServer, eventually};\n\nconst CLIENT_ID: &str = \"synthetic-client@1234567890.iam.panserviceaccount.com\";\nconst CLIENT_SECRET: &str = \"synthetic-client-secret-c30\";\nconst TSG: &str = \"1234567890\";\n\nstruct Script {\n    /// A chart whose violating count exceeds its total (inconsistent).\n    inconsistent_chart: bool,\n    /// The chart's violating sessions (0: the activity item is an update,\n    /// not something to act on).\n    violating: u32,\n    /// The token grant's status (401: the client is refused).\n    token_status: u16,\n    /// Never answer the key inventory (a read held open).\n    hang_keys: bool,\n    chart_status: u16,\n    keys_status: u16,\n    keys: Vec<Value>,\n    /// Rows beyond the page the plane claims for each listing (0: the page\n    /// is the inventory).\n    more_rows: u32,\n    /// The other products' sources (C30 R4): Red Team statistics and scans,\n    /// model scans, skill statistics and skill scans.\n    red_team_status: [u16; 2],\n    model_skill_status: [u16; 3],\n}\n\nimpl Script {\n    fn route(&mut self, seen: &Seen) -> Reply {\n        let target = seen.request_line.split(' ').nth(1).unwrap_or(\"\").to_owned();\n        let path = target.split('?').next().unwrap_or(\"\").to_owned();\n        if path == \"/oauth2/access_token\" {\n            if self.token_status != 200 {\n                return raw(\n                    self.token_status,\n                    &json!({\"error\": \"invalid_client\", \"error_description\": \"SERVER-TEXT-NEVER-SHOWN\"}),\n                );\n            }\n            return raw(\n                200,\n                &json!({\"access_token\": \"mgmt-access\", \"token_type\": \"Bearer\", \"expires_in\": 3600}),\n            );\n        }\n        if path == \"/aisec/v1/mgmt/dashboard/v2/sessions/sessionschart\" {\n            return raw(\n                self.chart_status,\n                &json!({\"bucket_size_seconds\": 3600, \"buckets\": [\n                    {\"time\": \"2026-10-19T00:00:00Z\", \"total\": 10, \"violating\": if self.inconsistent_chart { 30 } else { self.violating },\n                     \"detection_type_violation_breakdown\": [{\"detection_type\": \"pi\", \"violation_breakdown\": {\"total\": 3}}]}]}),\n            );\n        }\n        if path == format!(\"/aisec/v1/mgmt/apikeys/tsg/{TSG}\") {\n            if self.hang_keys {\n                return Reply::Hang;\n            }\n            let keys: Vec<Value> = self\n                .keys\n                .iter()\n                .map(|k| {\n                    let mut k = k.clone();\n                    for (field, value) in [\n                        (\"api_key_last8\", json!(\"abcd1234\")),\n                        (\"auth_code\", json!(\"SYNTHETIC-AUTH-CODE\")),\n                        (\"cust_app\", json!(\"Support bot\")),\n                        (\"revoked\", json!(false)),\n                    ] {\n                        if k.get(field).is_none() {\n                            k[field] = value;\n                        }\n                    }\n                    k\n                })\n                .collect();\n            return raw(self.keys_status, &json!({\"api_keys\": keys}));\n        }\n        // Red Team (two sources) and model/skill (three) in the shapes the\n        // synthetic plane answers with (tools/native-acceptance/mgmt_server.py).\n        if path == \"/ai-red-teaming/data-plane/v1/dashboard/scan-statistics\" {\n            return raw(\n                self.red_team_status[0],\n                &json!({\"total_scans\": 3, \"targets_scanned\": 2,\n                    \"scan_status\": [{\"name\": \"COMPLETED\", \"count\": 3}],\n                    \"risk_profile\": [{\"risk_rating\": \"LOW\", \"total\": 2}],\n                    \"targets_scanned_by_type\": [{\"name\": \"APPLICATION\", \"count\": 2}]}),\n            );\n        }\n        if path == \"/ai-red-teaming/data-plane/v1/scan\" {\n            return raw(\n                self.red_team_status[1],\n                &json!({\"data\": [{\"uuid\": \"00000001-2222-4333-8444-555555555555\", \"status\": \"COMPLETED\",\n                    \"job_type\": \"STATIC\", \"target_id\": \"66666666-7777-4888-8999-aaaaaaaaaaaa\",\n                    \"target_type\": \"APPLICATION\", \"created_at\": \"2026-10-18T10:00:00Z\"}],\n                    \"pagination\": {\"total_items\": 1 + self.more_rows}}),\n            );\n        }\n        if path == \"/aims/data/v1/scans\" {\n            return raw(\n                self.model_skill_status[0],\n                &json!({\"scans\": [{\"uuid\": \"00000001-3333-4333-8444-555555555555\", \"eval_outcome\": \"ALLOWED\",\n                    \"created_at\": \"2026-10-18T10:00:00Z\"}], \"pagination\": {\"total_items\": 1 + self.more_rows}}),\n            );\n        }\n        if path == \"/aiag/data/v1/stats/scans\" {\n            return raw(\n                self.model_skill_status[1],\n                &json!({\"unique_skills_scanned\": {\"count\": 1, \"percent_change\": null},\n                    \"total_vulnerabilities_found\": {\"count\": 0, \"percent_change\": null},\n                    \"top_vulnerability\": null}),\n            );\n        }\n        if path == \"/aiag/data/v1/scans\" {\n            return raw(\n                self.model_skill_status[2],\n                &json!({\"scans\": [{\"uuid\": \"00000001-4444-4333-8444-555555555555\", \"name\": \"AG-PRIVATE-SKILL\",\n                    \"status\": \"COMPLETED\", \"eval_outcome\": \"ALLOWED\", \"artifact_type\": \"skill\",\n                    \"summary\": {\"vulnerability_count\": 0, \"attack_chain_count\": 0},\n                    \"created_at\": \"2026-10-18T10:00:00Z\"}], \"pagination\": {\"total_items\": 1}}),\n            );\n        }\n        raw(404, &json!({\"error\": \"not found\"}))\n    }\n}\n\nfn raw(status: u16, body: &Value) -> Reply {\n    let body = serde_json::to_vec(body).expect(\"json\");\n    Reply::Raw {\n        head: format!(\n            \"HTTP/1.1 {status} Status\\r\\ncontent-type: application/json\\r\\ncontent-length: {}\\r\\nconnection: close\",\n            body.len()\n        ),\n        body,\n    }\n}\n\nfn now() -> u64 {\n    std::time::SystemTime::now()\n        .duration_since(std::time::UNIX_EPOCH)\n        .expect(\"clock\")\n        .as_secs()\n}\n\nstruct Desk {\n    _core: Core,\n    handle: AuthorityHandle,\n    session: String,\n    sequence: u64,\n    _adapters: Handles,\n    script: Arc<Mutex<Script>>,\n    _server: TlsServer,\n    origin: String,\n}\n\nasync fn desk() -> Desk {\n    let ca = TestCa::new(\"airs-v2 c30 ca\");\n    let script = Arc::new(Mutex::new(Script {\n        inconsistent_chart: false,\n        violating: 3,\n        token_status: 200,\n        hang_keys: false,\n        chart_status: 200,\n        keys_status: 200,\n        keys: vec![],\n        more_rows: 0,\n        red_team_status: [200, 200],\n        model_skill_status: [200, 200, 200],\n    }));\n    let routed = Arc::clone(&script);\n    let server = TlsServer::start(\n        ca.leaf(&[\"localhost\"]),\n        Reply::Route(Arc::new(move |seen| {\n            routed.lock().expect(\"script\").route(seen)\n        })),\n    )\n    .await;\n    let origin = format!(\"https://localhost:{}\", server.port);\n    let (adapters, handles) = fixtures::adapters();\n    let config = CoreConfig {\n        management: ManagementEndpoints::at_origin(&origin),\n        deadline_tick: Duration::from_millis(100),\n        ..CoreConfig::default()\n    };\n    let core = Core::new(config, adapters);\n    core.start();\n    core.set_transport_policy(TransportPolicy {\n        revision: 2,\n        proxy: ProxyMode::Direct,\n        extra_roots: vec![ca.pem.as_bytes().to_vec()],\n    })\n    .expect(\"policy\");\n    let handle = core.operator();\n    let session = handle.register_delivery_session().expect(\"session\").nonce;\n    let mut desk = Desk {\n        _core: core,\n        handle,\n        session,\n        sequence: 0,\n        _adapters: handles,\n        script,\n        _server: server,\n        origin: origin.clone(),\n    };\n    desk.tenant(\"Tenant A\").await;\n    desk\n}\n\nimpl Desk {\n    async fn send(&mut self, intent: Value) -> Result<Receipt, Refusal> {\n        let intent: Intent = serde_json::from_value(intent).expect(\"intent\");\n        self.sequence += 1;\n        self.handle\n            .dispatch(\n                Delivery {\n                    session: self.session.clone(),\n                    sequence: self.sequence,\n                },\n                intent,\n            )\n            .await\n    }\n\n//! C28 (D058): the v2 shell's Rust-owned presentation state through the\n//! production authority interface: the `ui_variant` flag, the per-variant\n//! feature catalogue the menu/sidebar/palette share, `navigate`, onboarding\n//! transitions and the \"show the calls\" preference, all persisted or\n//! session-scoped exactly as state-ownership.md assigns them.\n\nuse desktop_core::features::{self, FeatureId, OnboardingState, UiVariant};\nuse desktop_core::fixtures::{self, Handles, ScriptedStore};\nuse desktop_core::store::PersistedState;\nuse desktop_core::{\n    AuthorityHandle, Core, CoreConfig, Delivery, Intent, Observation, Receipt, Refusal,\n    ShellSnapshot, ViewScope,\n};\nuse serde_json::json;\n\nstruct Desk {\n    _core: Core,\n    handle: AuthorityHandle,\n    session: String,\n    sequence: u64,\n    adapters: Handles,\n}\n\nimpl Desk {\n    fn new() -> Self {\n        Self::from_state(PersistedState::default())\n    }\n\n    fn from_state(state: PersistedState) -> Self {\n        let (adapters, handles) = fixtures::adapters_with(ScriptedStore::with_state(state));\n        let core = Core::new(CoreConfig::default(), adapters);\n        core.start();\n        let handle = core.operator();\n        let session = handle.register_delivery_session().expect(\"session\").nonce;\n        Self {\n            _core: core,\n            handle,\n            session,\n            sequence: 0,\n            adapters: handles,\n        }\n    }\n\n    fn restart(self) -> Self {\n        let state = self.adapters.store.saved().unwrap_or_default();\n        drop(self._core);\n        Self::from_state(state)\n    }\n\n    async fn send(&mut self, intent: serde_json::Value) -> Result<Receipt, Refusal> {\n        let intent: Intent = serde_json::from_value(intent).expect(\"intent\");\n        self.sequence += 1;\n        self.handle\n            .dispatch(\n                Delivery {\n                    session: self.session.clone(),\n                    sequence: self.sequence,\n                },\n                intent,\n            )\n            .await\n    }\n\n    fn snap(&self) -> ShellSnapshot {\n        match self.handle.observe(ViewScope::Shell).expect(\"observe\") {\n            Observation::Shell { snapshot, .. } => snapshot,\n            _ => unreachable!(\"shell scope\"),\n        }\n    }\n}\n\n#[tokio::test]\nasync fn a_fresh_store_is_the_one_presentation_with_onboarding_needed_and_calls_shown() {\n    // C44: there is one presentation. A fresh store is v2 with Home first (⌘1).\n    let desk = Desk::new();\n    let snap = desk.snap();\n    assert_eq!(snap.ui_variant, UiVariant::V2);\n    assert_eq!(snap.onboarding, OnboardingState::Needed);\n    assert!(snap.show_calls);\n    assert_eq!(snap.active_feature, FeatureId::Home);\n    assert_eq!(snap.features[0].id, FeatureId::Home);\n    assert_eq!(snap.features[0].shortcut, Some(1));\n    assert!(snap.features.iter().any(|f| f.id == FeatureId::Inbox));\n}\n\n#[tokio::test]\nasync fn the_catalogue_is_v2_whatever_variant_is_asked_for_and_survives_a_restart() {\n    // C44: `setUiVariant` is accepted and changes nothing (older presentations and drivers still send it).\n    let mut desk = Desk::new();\n    desk.send(json!({\"kind\": \"setUiVariant\", \"variant\": \"legacy\"}))\n        .await\n        .expect(\"accepted, no-op\");\n    let snap = desk.snap();\n    assert_eq!(snap.ui_variant, UiVariant::V2);\n    assert_eq!(\n        snap.active_feature,\n        FeatureId::Home,\n        \"falls back to the first sidebar entry\"\n    );\n    let sidebar: Vec<FeatureId> = snap\n        .features\n        .iter()\n        .filter(|f| f.sidebar)\n        .map(|f| f.id)\n        .collect();\n    assert_eq!(\n        sidebar,\n        [\n            FeatureId::Home,\n            FeatureId::Inbox,\n            FeatureId::Harness,\n            FeatureId::Academy,\n            FeatureId::Library,\n            FeatureId::ApiClient,\n            FeatureId::Administration\n        ]\n    );\n    let shortcuts: Vec<Option<u8>> = snap.features.iter().map(|f| f.shortcut).collect();\n    assert_eq!(\n        &shortcuts[..7],\n        &[\n            Some(1),\n            Some(2),\n            Some(3),\n            Some(4),\n            Some(5),\n            Some(6),\n            Some(7)\n        ]\n    );\n    assert!(shortcuts[7..].iter().all(Option::is_none));\n    // Every destination the legacy shell listed is still reachable from the v2 catalogue, except the alpha\n    // import, which left the catalogue under D060 (the legacy catalogue itself goes with C45).\n    for id in features::catalogue().iter().map(|f| f.id) {\n        if id == FeatureId::Import {\n            assert!(\n                snap.features.iter().all(|f| f.id != id),\n                \"Import still listed (D060)\"\n            );\n            continue;\n        }\n        assert!(snap.features.iter().any(|f| f.id == id), \"{id:?} dropped\");\n    }\n    // Nothing about the presentation is persisted by the switch; a restart is v2 on Home.\n    let desk = desk.restart();\n    assert_eq!(desk.snap().ui_variant, UiVariant::V2);\n    assert_eq!(desk.snap().active_feature, FeatureId::Home);\n}\n\n#[tokio::test]\nasync fn navigate_accepts_only_catalogued_destinations_and_is_session_scoped() {\n    let mut desk = Desk::new();\n    // Home is the v2 catalogue's first entry; Harness is listed too.\n    desk.send(json!({\"kind\": \"navigate\", \"feature\": \"home\"}))\n        .await\n        .expect(\"home\");\n    desk.send(json!({\"kind\": \"navigate\", \"feature\": \"harness\"}))\n        .await\n        .expect(\"harness\");\n    assert_eq!(desk.snap().active_feature, FeatureId::Harness);\n    // A variant intent (a no-op since C44) leaves navigation where it is.\n    desk.send(json!({\"kind\": \"setUiVariant\", \"variant\": \"v2\"}))\n        .await\n        .expect(\"v2\");\n    assert_eq!(desk.snap().active_feature, FeatureId::Harness);\n    // The Inbox arrived in C30: listed and available (an unlisted destination\n    // stays refused, never a blank page).\n    desk.send(json!({\"kind\": \"navigate\", \"feature\": \"inbox\"}))\n        .await\n        .expect(\"inbox\");\n    assert_eq!(desk.snap().active_feature, FeatureId::Inbox);\n    desk.send(json!({\"kind\": \"navigate\", \"feature\": \"administration\"}))\n        .await\n        .expect(\"administration\");\n    assert_eq!(desk.snap().active_feature, FeatureId::Administration);\n    // Navigation is not persisted: a restart lands on the first sidebar entry.\n    let desk = desk.restart();\n    assert_eq!(desk.snap().active_feature, FeatureId::Home);\n    // An unknown feature name is not even a well-formed intent.\n    assert!(\n        serde_json::from_value::<Intent>(json!({\"kind\": \"navigate\", \"feature\": \"nope\"})).is_err()\n    );\n}\n\n#[tokio::test]\nasync fn onboarding_only_moves_forward_and_show_calls_persists() {\n    let mut desk = Desk::new();\n    desk.send(json!({\"kind\": \"setOnboarding\", \"state\": \"inProgress\"}))\n        .await\n        .expect(\"in progress\");\n    assert_eq!(\n        desk.send(json!({\"kind\": \"setOnboarding\", \"state\": \"needed\"}))\n            .await,\n        Err(Refusal::InvalidInput),\n        \"never back to needed\"\n    );\n    desk.send(json!({\"kind\": \"setOnboarding\", \"state\": \"done\"}))\n        .await\n        .expect(\"done\");\n    assert_eq!(\n        desk.send(json!({\"kind\": \"setOnboarding\", \"state\": \"inProgress\"}))\n            .await,\n        Err(Refusal::InvalidInput)\n    );\n    desk.send(json!({\"kind\": \"setShowCalls\", \"on\": false}))\n        .await\n        .expect(\"off\");\n    let saved = desk.adapters.store.saved().expect(\"saved\");\n    assert_eq!(saved.onboarding, OnboardingState::Done);\n    assert!(!saved.show_calls);\n    let desk = desk.restart();\n    let snap = desk.snap();\n    assert_eq!(snap.onboarding, OnboardingState::Done);\n    assert!(!snap.show_calls);\n}\n\n#[tokio::test]\nasync fn a_pre_c28_state_document_loads_into_the_one_presentation() {\n    // A store written before C28 has none of the new fields; since C44 it opens in v2 like every other.\n    let mut doc = serde_json::to_value(PersistedState::default()).expect(\"json\");\n    let object = doc.as_object_mut().expect(\"object\");\n    object.remove(\"uiVariant\");\n    object.remove(\"onboarding\");\n    object.remove(\"showCalls\");\n    let state: PersistedState = serde_json::from_value(doc).expect(\"older document loads\");\n    assert_eq!(state.ui_variant, UiVariant::V2);\n    assert_eq!(state.onboarding, OnboardingState::Needed);\n    assert!(state.show_calls);\n    let desk = Desk::from_state(state);\n    assert_eq!(desk.snap().ui_variant, UiVariant::V2);\n}\napps/desktop/src/v2/v2-shell.test.tsx:39:    it('renders the sidebar from the Rust catalogue with the menu shortcuts and marks an unavailable destination', async () => {\napps/desktop/src/v2/v2-shell.test.tsx:58:    it('dispatches navigate for the sidebar, the native menu and Home cards, never local state', async () => {\napps/desktop/src/v2/v2-shell.test.tsx:76:    it('reports a refused navigation on the status surface as a warn toast', async () => {\napps/desktop/src/v2/v2-shell.test.tsx:88:    it('opens the palette from the sidebar, lists destinations, tenants and actions, and dispatches on Enter', async () => {\napps/desktop/src/v2/v2-shell.test.tsx:111:    it('switches tenants from the rail switcher with one selectTenant intent and lists Add a tenant', async () => {\napps/desktop/src/v2/v2-shell.test.tsx:132:    it('picks the nth tenant with ⌃n while the menu is open, as its hints say (C35)', async () => {\napps/desktop/src/v2/v2-shell.test.tsx:149:    it('dispatches the appearance and show-the-calls preferences from the rail toggle and the header switch', async () => {\napps/desktop/src/v2/v2-shell.test.tsx:173:    it('applies the dark theme attribute the tokens key on', async () => {\napps/desktop/src/v2/v2-shell.test.tsx:178:    it('shows the read status from the observed overview, never a timer of its own', async () => {\napps/desktop/src/v2/v2-shell.test.tsx:201:    it('keeps one topmost modal: the palette over the switcher, Escape closes only the top, focus returns', async () => {\napps/desktop/src/v2/v2-shell.test.tsx:216:    it('expires toasts after their lifetime, or keeps them under Reduce Motion', async () => {\napps/desktop/src/v2/v2-shell.test.tsx:241:    it('keeps an unconfirmed delivery inline with Retry, never auto-resending, and retries only on the click', async () => {\napps/desktop/src/v2/v2-shell.test.tsx:262:    it('opens the tenant switcher from the native ⌘T command without switching, and returns focus to the trigger on Escape', async () => {\napps/desktop/src/v2/v2-shell.test.tsx:277:    it('keeps destination names when the rail is collapsed and does not restart a toast deadline on re-render', async () => {\napps/desktop/src/v2/v2-shell.test.tsx:304:    it('hands focus to the tenant list when ⌘T replaces an open palette, and Escape returns it to the trigger', async () => {\napps/desktop/src/v2/v2-shell.test.tsx:319:    it('routes appearance through the same recovery path from the rail and the native menu', async () => {\napps/desktop/src/v2/v2-shell.test.tsx:344:    it('focuses the tenant list after ⌘T even when focus inside an inert rail is refused, as WebKit does', async () => {\napps/desktop/src/v2/v2-shell.test.tsx:372:    it('renders the tenant popup outside the rail with a usable width; Settings has no interface switch (C44)', async () => {\napps/desktop/src/v2/v2-shell.test.tsx:387:    it('makes toast controls inert and hidden while a modal is topmost, usable again after', async () => {\napps/desktop/src/v2/v2-shell.test.tsx:405:    it('bounds the tenant popup to the viewport and lets the keyboard reach the last of twenty tenants', async () => {\napps/desktop/src/v2/v2-shell.test.tsx:424:    it('names the intended tenant in a refused switch; a late refusal of a read for a tenant no longer shown is never surfaced (I2)', async () => {\napps/desktop/src/v2/v2-shell.test.tsx:452:    it('tells two tenants with the same label and region apart by TSG, and names the current tenant on the trigger away from Home', async () => {\napps/desktop/src/v2/v2-shell.test.tsx:467:    it('identifies identically named tenants in the palette by environment and TSG, and ArrowDown moves the current row', async () => {\napps/desktop/src/v2/v2-shell.test.tsx:509:    it('reports the Harness credential the Harness would use for the selected workspace: SSO only for that workspace, else the key, else none (R1)', async () => {\napps/desktop/src/v2/v2-shell.test.tsx:542:    it('follows an OS appearance change while the preference is system: the toggle updates without a new snapshot and its next click picks the opposite (R2)', async () => {\napps/desktop/src/v2/v2-shell.test.tsx:582:    it('opens the Gateway workspace choice from the tenant menu, and gates the row while no tenant is active (R3)', async () => {\napps/desktop/src/v2/v2-shell.test.tsx:621:    it('lets Tab reach the palette’s \"Ask the Harness instead\" fallback, Enter opens the Harness once, and Escape returns focus to the search button (R4)', async () => {\napps/desktop/src/v2/inbox/inbox.test.tsx:29:    it('lists the core entries in tabs with counts, opens the detail pane, and acts through core intents', async () => {\napps/desktop/src/v2/inbox/inbox.test.tsx:59:    it('snoozes through the core and states the return time the core computed, the same on Home (I11)', async () => {\napps/desktop/src/v2/inbox/inbox.test.tsx:82:    it('derives completion toasts from the core read status: warn when partial, ok when complete (I4)', async () => {\napps/desktop/src/v2/inbox/inbox.test.tsx:93:    it('a fresh tenant shows first read pending and an empty Inbox, never sample data (I12)', async () => {\napps/desktop/src/v2/inbox/inbox.test.tsx:103:    it('renders the switch guard from the refusal payload and re-dispatches with the chosen resolution (I1)', async () => {\napps/desktop/src/v2/inbox/inbox.test.tsx:171:    it('also retires a late unconfirmed initial tenant selection with the context it was asked from', async () => {\napps/desktop/src/v2/inbox/inbox.test.tsx:222:    it('announces a snooze once, from the core receipt: never an old hold after a switch or a reread (I11)', async () => {\napps/desktop/src/v2/inbox/inbox.test.tsx:241:    it('reports each action outcome for the tenant or item it names: refusal and failure as warn toasts, an unconfirmed delivery with Retry, an admitted recheck as info (DESIGN-V2 §7)', async () => {\napps/desktop/src/v2/inbox/inbox.test.tsx:274:    it('a failed first read is failed, never pending or an all-clear; a failed refresh labels the kept read as older (I4)', async () => {\napps/desktop/src/v2/inbox/inbox.test.tsx:297:    it('an arrival and an unconfirmed item action belong to their tenant: the next tenant inherits neither, and a retired context cannot be revived (I2)', async () => {\napps/desktop/src/v2/inbox/inbox.test.tsx:329:    it('Home never claims an all-clear from unread data: in-progress, failed and partial reads are named (I4)', async () => {\napps/desktop/src/v2/inbox/inbox.test.tsx:346:    it('toasts that speak for a tenant are retired on leaving it, even under Reduce Motion (I2)', async () => {\napps/desktop/src/v2/inbox/inbox.test.tsx:365:    it('a notification for a scope that retired before it arrived is never surfaced: late refusal, lost delivery, late recheck (I2)', async () => {\napps/desktop/src/v2/inbox/inbox.test.tsx:415:    it('a first product-only recheck refused for a role is a settled attempt, announced for when it settled, never first read pending (I4)', async () => {\napps/desktop/src/v2/inbox/inbox.test.tsx:429:    it('lists the entries the core supplies before any read (a setup warning) with every action, while a truly empty fresh tenant shows pending (I12)', async () => {\napps/desktop/src/v2/inbox/inbox.test.tsx:461:    it('a healthy empty read older than ten minutes is a gap, not an all-clear, on Home and in the Inbox (C12, I4)', async () => {\napps/desktop/src/v2/inbox/inbox.test.tsx:495:    it('keeps the Inbox tab and item per tenant across a switch round trip (I2)', async () => {\napps/desktop/src/v2/inbox/inbox.test.tsx:512:    it('draws the list card with the filter tabs and counts, rows with the severity word, product, source and time, and the footer naming the read (C37)', async () => {\napps/desktop/src/v2/inbox/inbox.test.tsx:530:    it('fills the detail card from a row: severity, product and source, the title, the body, the facts grid, the entry’s own action and the holds; Why this matters only while the calls are shown (C37)', async () => {\napps/desktop/src/v2/inbox/inbox.test.tsx:549:    it('offers Open role issue in the empty state when a product needs a role, opening that product in Administration (C37)', async () => {\n","exit_code":0,"status":"completed"}}
