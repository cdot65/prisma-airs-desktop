   name={`${name}-region`}\n                        defaultValue={initial?.kind === 'region' ? initial.region : 'unitedStates'}\n                        className='border-academy-rule bg-academy-bg text-academy-ink min-h-11 rounded-[8px] border px-3 text-[13px]'\n                    >\n                        {REGIONS.map((r) => (\n                            <option key={r.value} value={r.value}>\n                                {r.label}\n                            </option>\n                        ))}\n                    </select>\n                </div>\n            ) : (\n                <TextField\n                    label='Endpoint origin'\n                    name={`${name}-origin`}\n                    placeholder='https://scan.example.com'\n                    hint='HTTPS only, with no path, query or credentials. The scan key is sent only here.'\n                    defaultValue={initial?.kind === 'custom' ? initial.origin : ''}\n                    autoComplete='off'\n                    spellCheck={false}\n                />\n            )}\n        </fieldset>\n    )\n}\n\n/** Reads the destination fields at the moment of submission. */\nfunction readDestination(form: HTMLFormElement, name: string): Destination {\n    const data = new FormData(form)\n    if (data.get(`${name}-kind`) === 'custom') {\n        return { kind: 'custom', origin: String(data.get(`${name}-origin`) ?? '') }\n    }\n    return { kind: 'region', region: String(data.get(`${name}-region`) ?? 'unitedStates') as Region }\n}\n\nfunction useAction(dispatch: Dispatch) {\n    const [message, setMessage] = useState<string | null>(null)\n    const [busy, setBusy] = useState(false)\n    async function run(intent: Parameters<Dispatch>[0]): Promise<boolean> {\n        setBusy(true)\n        setMessage(null)\n        const outcome = await dispatch(intent)\n        setBusy(false)\n        setMessage(outcomeMessage(outcome))\n        return outcome.kind === 'admitted'\n    }\n    return { message, busy, run }\n}\n\nfunction Message({ text }: { text: string | null }) {\n    return text ? (\n        <p role='alert' className='text-academy-accent-warn text-[13px]'>\n            {text}\n        </p>\n    ) : null\n}\n\nfunction EndpointChange({ tenant, snapshot, dispatch }: { tenant: TenantView; snapshot: ShellSnapshot; dispatch: Dispatch }) {\n    const { message, busy, run } = useAction(dispatch)\n    const [editing, setEditing] = useState(false)\n    const headingId = useId()\n    const context = snapshot.active?.context\n    const review = snapshot.endpointReview?.tenant === tenant.id ? snapshot.endpointReview : null\n    if (!context) return null\n    return (\n        <section aria-labelledby={headingId} data-slot='endpoint' className='flex flex-col gap-3'>\n            <h3 id={headingId} className='text-academy-ink text-[14px] font-semibold'>\n                Scan destination\n            </h3>\n            <p className='text-academy-ink-soft text-[13px]'>\n                Scan requests and the scan key go only to <span className='font-mono'>{tenant.origin}</span>.\n            </p>\n            {review ? (\n                <div data-slot='endpoint-review' className='flex flex-col gap-3'>\n                    <Callout tone='warning' icon={AlertTriangle}>\n                        <p>\n                            Review: scan requests will go to <span className='font-mono'>{review.toOrigin}</span> instead\n                            of <span className='font-mono'>{review.fromOrigin}</span>.\n                        </p>\n                        {review.removesScanCredential ? (\n                            <p>The current scan key will be removed. Enter a key for the new destination afterwards.</p>\n    if cfg!(feature = \"test-fixtures\") {\n        \"Prisma AIRS Desktop v2 (Fixture)\"\n    } else {\n        \"Prisma AIRS Desktop v2\"\n    }\n}\n\n/// True for the packaged asset origin served by Tauri's custom protocol.\npub fn is_packaged_origin(url: &Url) -> bool {\n    url.scheme() == \"tauri\" && url.host_str() == Some(\"localhost\") && url.port().is_none()\n}\n\n/// Defense in depth beyond the capability grant: the caller must be the main\n/// webview of the main window currently showing packaged content.\nfn admit_caller<R: Runtime>(webview: &Webview<R>) -> Result<(), Refusal> {\n    if webview.label() != MAIN_WINDOW || webview.window().label() != MAIN_WINDOW {\n        return Err(Refusal::CapabilityMissing);\n    }\n    match webview.url() {\n        Ok(url) if is_packaged_origin(&url) => Ok(()),\n        _ => Err(Refusal::CapabilityMissing),\n    }\n}\n\n#[tauri::command]\nasync fn desktop_dispatch<R: Runtime>(\n    webview: Webview<R>,\n    request: Request<'_>,\n    host: State<'_, Host>,\n) -> Result<DispatchResponse, Refusal> {\n    admit_caller(&webview)?;\n    // The facade sends raw bytes so the size ceiling applies before parsing.\n    let InvokeBody::Raw(bytes) = request.body() else {\n        return Err(Refusal::InvalidInput);\n    };\n    let request = DispatchRequest::parse(bytes).map_err(|e| e.refusal())?;\n    let delivery = request.delivery().map_err(|e| e.refusal())?;\n    Ok(host\n        .operator\n        .dispatch(delivery, request.intent)\n        .await\n        .into())\n}\n\n#[tauri::command]\nasync fn desktop_observe<R: Runtime>(\n    webview: Webview<R>,\n    request: Request<'_>,\n    host: State<'_, Host>,\n) -> Result<ObserveResponse, Refusal> {\n                &tenant.inference,\n                ScanCapability::Ready { record, .. } if Some(record) == c.record.as_ref()\n            ),\n            _ => false,\n        };\n        // The project and its access as selected now (C21).\n        let project = tenant.harness_project.as_ref();\n        let project_ok = project.map(|p| &p.path) == c.project.as_ref()\n            && project.is_some_and(|p| p.write) == c.write;\n        // Its MCP servers: still on, with the same sign-ins and revisions\n        // (C22). An expired sign-in alone keeps it, and so does a catalog\n        // that is loading or could not be read (nothing remote runs then).\n        let mcp_ok = self.mcp_scope_check(&c.tenant, &c.workspace.id, &c.mcp)\n            != super::harness_mcp::ScopeCheck::Changed;\n        !c.retired\n            && credential_ok\n            && project_ok\n            && mcp_ok\n            && Some(&c.context) == self.active_ref.as_ref()\n            && self.workspace_current(Some(&c.reference))\n    }\n\n    /// Retires a conversation that is no longer bound (run on every change).\n    pub(super) fn sync_harness(&mut self) {\n        // A confirmation whose decision is gone is ended (C32).\n        self.retire_harness_confirmation();\n        let bound = self.harness.as_ref().is_some_and(|c| self.harness_bound(c));\n1292:async fn stale_archive_resolution_never_ends_another_pending_conversation() {\n1297:async fn stale_discard_resolution_never_deletes_another_pending_conversation() {\n1305:async fn a_pending_decision_refuses_a_tenant_switch_until_it_is_resolved() {\n1856:async fn completing_a_tenant_setup_is_the_guarded_switch_path() {\n[\n  {\n    \"subject\": \"C05\",\n    \"started_utc\": \"2026-11-02T09:30:19.898985+00:00\",\n    \"finished_utc\": \"2026-11-02T09:35:06.173024+00:00\",\n    \"command\": [\n      \"/opt/homebrew/opt/python@3.15/bin/python3.15\",\n      \"-I\",\n      \"/Users/cdot/development/redtail/prisma-airs-desktop-v2-current/docs/planning/evidence/P09/native-controller/run-p09-native.py\",\n      \"c05\",\n      \"legacy\"\n    ],\n    \"exit\": 0,\n    \"log\": \".evidence-private/worf-agent/2026-11-02-resume-05/native-07-continuation-c05.log\",\n    \"log_sha256\": \"42a29acc5a6b5cc1b22cb997d1575f47918191d1c73db3c0fbb3010b1a112bdd\",\n    \"execution\": \"docs/planning/evidence/P09/native/cumulative/C05/execution.json\",\n    \"required_check_errors\": [],\n    \"superseded_raw_checks\": []\n  },\n  {\n    \"subject\": \"C06\",\n    \"started_utc\": \"2026-11-02T