{"type":"item.completed","item":{"id":"item_45","type":"command_execution","command":"/bin/zsh -lc \"rg -n 'switchBlocked|guard|resolution|unconfirmed|completeTenantSetup|onResolve|onStay' apps/desktop/src/v2/wizard/wizard.tsx; sed -n '505,570p' apps/desktop/src/v2/v2-shell.tsx; sed -n '3250,3330p' crates/desktop-core/src/authority.rs; sed -n '3420,3508p' crates/desktop-core/src/authority.rs; cat packages/desktop-contracts/src/generated/SwitchResolution.ts packages/desktop-contracts/src/generated/SwitchBlocked.ts; rg -n 'switchBlocked|switchResolution|selectTenant' packages/desktop-contracts/src/client.ts\"","aggregated_output":"11:import { SwitchGuard } from '../switch-guard'\n43:     * refused or unconfirmed discard stays visible instead of closing.\n185:        // A later snapshot settles an unconfirmed creation either way; an admitted\n322:    // Completion makes the new tenant active: it is the one guarded switch\n323:    // path (I1). A pending Harness decision refuses it; the core's guard is\n324:    // rendered here and the completion re-sent with the chosen resolution.\n325:    async function finish(resolution: SwitchResolution | null = null) {\n328:        const outcome = await dispatch({ kind: 'completeTenantSetup', context: setup.context, packs: selectedPacks, resolution })\n336:        // The guard is the snapshot's to show (switchBlocked), not a status line.\n340:    const completionGuard = snapshot.switchBlocked?.completion && setup && snapshot.switchBlocked.to === setup.tenant.id ? snapshot.switchBlocked : null\n343:    // idle → awaitingCreate (a creation is pending or unconfirmed: wait for what it\n345:    // gone after an unconfirmed delivery) → retry (refused or failed, with Retry).\n367:        // A close request while a discard is unconfirmed is the operator's retry.\n374:                // Nothing was created: close. Admitted or unconfirmed: the next snapshot decides.\n400:        // An unconfirmed discard that did go through shows up as the draft being gone.\n1037:            {/* The guard is a dialog above the sheet (I8): rendered at the body, outside the sheet's inert subtree. */}\n1038:            {completionGuard && setup && createPortal(<SwitchGuard target={setup.tenant.label} completion binding={completionGuard} onStay={() => void dispatch({ kind: 'dismissSwitchGuard' })} onResolve={(resolution) => void finish(resolution)} />, document.body)}\n                                snapshot={snapshot}\n                                dispatch={props.dispatch}\n                                client={props.client}\n                                onAct={props.onAct}\n                                onNavigate={props.onNavigate}\n                                arrival={arrival && arrival.tenant === tenantNow && arrival.feature === 'administration' ? arrival : null}\n                            />\n                        ) : feature.id === 'harness' && feature.availability.state === 'available' ? (\n                            <Harness\n                                key={snapshot.active?.context ?? 'none'}\n                                ref={heading}\n                                snapshot={snapshot}\n                                dispatch={props.dispatch}\n                                onNavigate={props.onNavigate}\n                                arrival={arrival && arrival.tenant === tenantNow && arrival.feature === 'harness' ? arrival : null}\n                            />\n                        ) : feature.id === 'library' && feature.availability.state === 'available' ? (\n                            // Keyed by context: a new tenant starts at its first page, nothing inspected.\n                            <TestCases key={snapshot.active?.context ?? 'none'} ref={heading} snapshot={snapshot} dispatch={props.dispatch} onNavigate={props.onNavigate} />\n                        ) : feature.id === 'academy' && feature.availability.state === 'available' ? (\n                            // Not keyed by tenant: the learner generation is the account's, not the tenant's.\n                            <Academy ref={heading} snapshot={snapshot} client={props.client} onNavigate={props.onNavigate} />\n                        ) : feature.id === 'apiClient' && feature.availability.state === 'available' ? (\n                            // Not keyed by tenant: API Client documents are on this Mac.\n                            <ApiClient ref={heading} snapshot={snapshot} dispatch={props.dispatch} observe={observeWorkbench} />\n                        ) : (feature.id === 'runtime' || feature.id === 'gateway' || feature.id === 'redTeam') && feature.availability.state === 'available' ? (\n                            // C44: the product destinations (Go, the palette) open Administration on their product; the legacy views are gone.\n                            <Administration\n                                key={snapshot.active?.context ?? 'none'}\n                                ref={heading}\n                                snapshot={snapshot}\n                                dispatch={props.dispatch}\n                                client={props.client}\n                                onAct={props.onAct}\n                                onNavigate={props.onNavigate}\n                                arrival={tenantNow ? { tenant: tenantNow, feature: 'administration', resource: null, item: null, ...PRODUCT_DESTINATION[feature.id] } : null}\n                            />\n                        ) : (\n                            <FeatureBody\n                                ref={heading}\n                                feature={feature}\n                                snapshot={snapshot}\n                                appearancePending={props.appearancePending}\n                                onSetAppearance={props.onSetAppearance}\n                                onNavigate={props.onNavigate}\n                                dispatch={props.dispatch}\n                                client={props.client}\n                            />\n                        )}\n                        <p role='status' aria-live='polite' data-slot='shell-status' className='mt-4 text-[13px]' style={{ color: 'var(--v2-soft)' }}>\n                            {props.status}\n                        </p>\n                    </main>\n                    {/* \"Show the calls\" (C33): beside every destination while chosen. */}\n                    <CallsPanel snapshot={snapshot} dispatch={props.dispatch} />\n                </div>\n            </div>\n            {paletteOpen && (\n                <Palette snapshot={snapshot} onNavigate={props.onNavigate} onSwitchTenant={props.onSwitchTenant} onReadNow={props.onReadNow} onClose={closePalette} />\n            )}\n            {guard && guardTarget && (\n                <SwitchGuard target={guardTarget} completion={false} binding={guard} onStay={() => void props.dispatch({ kind: 'dismissSwitchGuard' })} onResolve={(resolution) => props.onSwitchTenant(guard.to, resolution)} />\n            )}\n            {adding && (\n                <Modal label='Add a tenant' onClose={() => setCloseRequests((n) => n + 1)} width={1160} padding={0} data-slot='add-tenant-sheet'>\n                    <Wizard\n                        state.changed();\n                    }\n                };\n            }\n        });\n    }\n\n    /// Moves this core's clock forward (fixture builds only).\n    #[cfg(feature = \"test-fixtures\")]\n    pub fn advance_clock(&self, secs: u32) {\n        if let Ok(mut state) = lock(&self.inner) {\n            state.clock_offset = state.clock_offset.saturating_add(secs);\n        }\n    }\n\n    /// The operator handle, created by the host for its packaged main window.\n    pub fn operator(&self) -> AuthorityHandle {\n        AuthorityHandle {\n            principal: Principal::Operator,\n            inner: Arc::clone(&self.inner),\n        }\n    }\n\n    /// Installs a new transport policy revision; contexts and their work\n    /// bound to the previous revision are retired.\n    pub fn set_transport_policy(&self, policy: TransportPolicy) -> Result<(), PolicyError> {\n        let factory = Arc::new(TransportFactory::new(policy)?);\n        let starts = {\n            let mut state = lock(&self.inner).map_err(|_| PolicyError::Client)?;\n            state.transport = Some(factory);\n            let previous = state.offline.clone();\n            let mut starts = state.reissue_context();\n            // Learner work moves to a client under the new policy.\n            if matches!(state.learner, LearnerPhase::SignedIn) {\n                starts.extend(state.restore_learner_session(&self.inner));\n            }\n            state.changed();\n            // The same account keeps its open (or, before `start`, its\n            // pending) offline work; only a new generation is opened here.\n            let fresh = state\n                .offline\n                .clone()\n                .filter(|o| !previous.as_ref().is_some_and(|p| Arc::ptr_eq(p, o)));\n            (starts, fresh)\n        };\n        let (starts, offline) = starts;\n        let mut effects = vec![Effect::Start(starts)];\n        effects.extend(offline.map(Effect::OpenOffline));\n        run_effects(&self.inner, effects);\n        Ok(())\n    }\n}\n\nfn data_from(doc: PersistedState) -> Data {\n    // A setup that was in progress is not restored: its credentials are\n    // cleaned up (C29).\n    let draft_records: Vec<RecordId> = doc\n        .tenant_draft\n        .as_ref()\n        .map(|d| {\n            doc.credentials\n                .iter()\n                .filter(|c| c.tenant == d.profile.id)\n                .map(|c| c.record.clone())\n                .collect()\n        })\n        .unwrap_or_default();\n    let tenants = doc\n        .tenants\n        .into_iter()\n        .map(|profile| {\n            let scan = doc\n                .credentials\n                .iter()\n                .find(|c| {\n                    c.class == CredentialClass::Scan\n                        && c.tenant == profile.id\n                        && c.destination == profile.destination.origin()\n                })\n                .map(|c| ScanCapability::Ready {\n                    record: c.record.clone(),\n                if !pending.contains(&record) {\n                    pending.push(record);\n                }\n            }\n            pending\n        },\n        learner: doc.learner,\n        learner_cleanup: doc.learner_cleanup,\n        harness_history: doc.harness_history,\n        open_imports: doc.open_imports,\n    }\n}\n\nfn lock(inner: &Inner) -> Result<MutexGuard<'_, State>, Refusal> {\n    // A poisoned lock means an authoritative transition panicked; refuse\n    // further work instead of continuing from a possibly torn state.\n    inner.state.lock().map_err(|_| Refusal::ShuttingDown)\n}\n\n/// Principal-scoped entry to native desktop operations and observations.\n#[derive(Clone)]\npub struct AuthorityHandle {\n    principal: Principal,\n    inner: Arc<Inner>,\n}\n\nimpl AuthorityHandle {\n    pub fn principal(&self) -> Principal {\n        self.principal\n    }\n\n    /// Registers a new delivery session for this principal, retiring the\n    /// previous one (for example after a renderer reload).\n    pub fn register_delivery_session(&self) -> Result<DeliverySession, Refusal> {\n        lock(&self.inner)?.operator_sessions.register()\n    }\n\n    /// Admits or refuses one delivered Intent. Admission never awaits remote\n    /// IO, Keychain calls or an operator answer while holding the state.\n    pub async fn dispatch(&self, delivery: Delivery, intent: Intent) -> Result<Receipt, Refusal> {\n        let kind = intent.kind();\n        let (result, effects) = {\n            let mut state = lock(&self.inner)?;\n            let digest = intent_digest(&state.salt, &intent);\n            match state.operator_sessions.check(&delivery, &digest) {\n                Admit::Refused(refusal) => return Err(refusal),\n                Admit::Duplicate(result) => return result,\n                Admit::Fresh => {\n                    let mut effects = Vec::new();\n                    // What an import writes waits while it (or its\n                    // rollback) runs, until every receipt has settled, and\n                    // while a receipt cannot be read (D050).\n                    let result =\n                        if state.v1_import_holds() && import_v1_domain::waits_for_import(&intent) {\n                            Err(Refusal::Busy)\n                        } else {\n                            admit(\n                                &mut state,\n                                &self.inner.session,\n                                &self.inner.adapters,\n                                intent,\n                                &mut effects,\n                            )\n                        };\n                    if result.is_err() {\n                        effects.clear();\n                    }\n                    // Settlements published by this intent are kept on\n                    // this Mac whether or not the intent itself succeeded.\n                    effects.extend(gateway_local_effects(&mut state));\n                    // Learner records wait in the ledger for a confirmed\n                    // save; once one has happened, let cleanup resume.\n                    if !state.durability_unconfirmed && !state.data.learner_cleanup.is_empty() {\n                        effects.push(Effect::Cleanup);\n                    }\n                    state\n                        .operator_sessions\n                        .record(&delivery, digest, result.clone());\n                    (result, effects)\n                }\n            }\n        };\n        run_effects(&self.inner, effects);\n        // Only the request's kind and the refusal's code (D051).\n        self.inner\n            .diagnostics\n            .record(crate::diagnostics::Event::Intent {\n                kind: kind.to_owned(),\n                refusal: result.as_ref().err().map(refusal_code),\n// This file was generated by [ts-rs](https://github.com/Aleph-Alpha/ts-rs). Do not edit this file manually.\nimport type { ContextRef } from \"./ContextRef\";\nimport type { ReviewId } from \"./ReviewId\";\n\n/**\n * How a blocked switch is resolved (I1): the pending conversation is\n * ended and kept (`archive`) or ended and dropped (`discard`).\n */\nexport type SwitchResolution = { \"kind\": \"archive\", context: ContextRef, review: ReviewId, } | { \"kind\": \"discard\", context: ContextRef, review: ReviewId, };\n// This file was generated by [ts-rs](https://github.com/Aleph-Alpha/ts-rs). Do not edit this file manually.\nimport type { ContextRef } from \"./ContextRef\";\nimport type { PendingDecisionRef } from \"./PendingDecisionRef\";\nimport type { ReviewId } from \"./ReviewId\";\nimport type { TenantId } from \"./TenantId\";\n\n/**\n * Why a tenant switch is held (C28 contract, raised in C30): a Harness\n * conversation has a decision pending; the operator chooses to archive it,\n * discard it or stay. The shell renders its guard from this, never from a\n * guess of its own (invariant I1).\n */\nexport type SwitchBlocked = { \n/**\n * The active source context and native-issued, single refusal reference.\n */\ncontext: ContextRef, review: ReviewId, \n/**\n * The exact setup generation when completing a draft; none for selection.\n */\ntargetContext: ContextRef | null, \n/**\n * The tenant the switch was asked for (a setup draft's id when the\n * switch is its completion).\n */\nto: TenantId, pending: PendingDecisionRef, \n/**\n * The switch is the completion of the tenant setup draft `to`: the\n * resolution is re-sent with `completeTenantSetup` (C30, I1).\n */\ncompletion: boolean, };\n2899:            value.switchBlocked\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_46","type":"command_execution","command":"/bin/zsh -lc \"sed -n '300,345p' apps/desktop/src/v2/wizard/wizard.tsx; sed -n '2870,2935p' packages/desktop-contracts/src/client.ts; sed -n '1,170p' crates/desktop-core/src/authority/harness_history.rs; rg -n 'discard_history|tombstone|discarded|fn take_history_jobs' crates/desktop-core/src/authority/harness_history.rs; sed -n '1,180p' crates/desktop-core/src/workbench/admission.rs; cat apps/desktop/src-tauri/capabilities/main.json apps/desktop/academy-source.ts\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_46","type":"command_execution","command":"/bin/zsh -lc \"sed -n '300,345p' apps/desktop/src/v2/wizard/wizard.tsx; sed -n '2870,2935p' packages/desktop-contracts/src/client.ts; sed -n '1,170p' crates/desktop-core/src/authority/harness_history.rs; rg -n 'discard_history|tombstone|discarded|fn take_history_jobs' crates/desktop-core/src/authority/harness_history.rs; sed -n '1,180p' crates/desktop-core/src/workbench/admission.rs; cat apps/desktop/src-tauri/capabilities/main.json apps/desktop/academy-source.ts\"","aggregated_output":"        report(await dispatch({ kind: 'verifyTenantSetup', context }), null, () => void verify())\n        setBusy(false)\n    }\n    const run = setup?.verify ?? null\n    const running = Boolean(run && !run.done)\n    const plannedRows: VerifyStep[] = run\n        ? run.steps\n        : [\n              { line: 'scanKey', product: 'runtimeSecurity', state: 'pending', reason: '' },\n              { line: 'managementClient', product: 'runtimeSecurity', state: 'pending', reason: '' },\n              ...(setup?.products ?? []).filter((p) => p !== 'runtimeSecurity').map((p): VerifyStep => ({ line: p === 'gateway' ? 'gateway' : p === 'redTeam' ? 'redTeam' : 'modelSkill', product: p, state: 'pending', reason: '' })),\n              ...UNAVAILABLE_LINES,\n          ]\n    const verifyStatus = !run ? '' : running ? C.verify.running : run.stale ? C.verify.stale : run.blocking ? C.verify.failed : run.failed ? C.verify.failedOptional : run.warnings.length ? C.verify.finishedWarnings : C.verify.finishedClean\n\n    // ---- packs: the chosen packs are imported by the completion intent ----\n    // Only packs of currently chosen products with cases count; a product removed\n    // after its pack was ticked takes the pack with it (R8).\n    const offered = setup?.packs.filter((p) => p.count > 0 && setup.products.includes(p.product)).map((p) => p.product) ?? []\n    const selectedPacks: ProductId[] = (packs ?? offered).filter((p) => offered.includes(p))\n\n    // ---- done: completion is one core intent; the shell confirms it ----\n    // Completion makes the new tenant active: it is the one guarded switch\n    // path (I1). A pending Harness decision refuses it; the core's guard is\n    // rendered here and the completion re-sent with the chosen resolution.\n    async function finish(resolution: SwitchResolution | null = null) {\n        if (!setup) return\n        setFinishing(true)\n        const outcome = await dispatch({ kind: 'completeTenantSetup', context: setup.context, packs: selectedPacks, resolution })\n        if (outcome.kind === 'admitted') {\n            // First run: the shell takes over once the snapshot shows onboarding\n            // done (the same intent set it). Add: the sheet closes with the label.\n            if (mode === 'add') props.onClose(setup.tenant.label)\n            return\n        }\n        setFinishing(false)\n        // The guard is the snapshot's to show (switchBlocked), not a status line.\n        if (outcome.kind === 'refused' && outcome.refusal === 'decisionPending') return\n        report(outcome, null, () => void finish())\n    }\n    const completionGuard = snapshot.switchBlocked?.completion && setup && snapshot.switchBlocked.to === setup.tenant.id ? snapshot.switchBlocked : null\n\n    // ---- cancel (add mode): the draft is discarded in the core before the sheet closes ----\n    // idle → awaitingCreate (a creation is pending or unconfirmed: wait for what it\n    // produces) → discarding (sent; closes on admission, or when the draft is seen\n    // gone after an unconfirmed delivery) → retry (refused or failed, with Retry).\n        !isRecord(value) ||\n        !isDecimalU64(value.revision) ||\n        !THEMES.includes(value.appearance as string) ||\n        !UI_VARIANTS.includes(value.uiVariant as string) ||\n        !ONBOARDING_STATES.includes(value.onboarding as string) ||\n        typeof value.activeFeature !== 'string' ||\n        !FEATURE_IDS.includes(value.activeFeature) ||\n        typeof value.showCalls !== 'boolean' ||\n        !isCalls(value.calls, value.showCalls) ||\n        !optional(\n            (g) =>\n                isRecord(g) &&\n                typeof g.context === 'string' &&\n                CONTEXT_REF.test(g.context) &&\n                isRecord(value.active) &&\n                g.context === value.active.context &&\n                typeof g.review === 'string' &&\n                REVIEW_ID.test(g.review) &&\n                typeof g.to === 'string' &&\n                TENANT_ID.test(g.to) &&\n                isRecord(g.pending) &&\n                typeof g.pending.conversation === 'string' &&\n                g.pending.conversation.length > 0 &&\n                typeof g.pending.decision === 'string' &&\n                g.pending.decision.length > 0 &&\n                typeof g.completion === 'boolean' &&\n                (g.completion\n                    ? typeof g.targetContext === 'string' && CONTEXT_REF.test(g.targetContext) && isRecord(value.setup) && isRecord(value.setup.tenant) && g.targetContext === value.setup.context && g.to === value.setup.tenant.id\n                    : g.targetContext === null),\n            value.switchBlocked\n        ) ||\n        // C29: the tenant setup in progress, with its draft and verification.\n        !optional(isSetupView, value.setup) ||\n        !Array.isArray(value.features) ||\n        typeof value.fixtureBuild !== 'boolean' ||\n        !oneOf(STORAGE, value.storage) ||\n        !Array.isArray(value.tenants) ||\n        !value.tenants.every(isTenant) ||\n        !optional(\n            (a) => isRecord(a) && typeof a.tenant === 'string' && TENANT_ID.test(a.tenant) && typeof a.context === 'string' && CONTEXT_REF.test(a.context),\n            value.active\n        ) ||\n        !optional(\n            (r) =>\n                isRecord(r) &&\n                typeof r.review === 'string' &&\n                REVIEW_ID.test(r.review) &&\n                typeof r.tenant === 'string' &&\n                TENANT_ID.test(r.tenant) &&\n                isString(r.fromOrigin) &&\n                isString(r.toOrigin) &&\n                isDestination(r.to) &&\n                typeof r.removesScanCredential === 'boolean',\n            value.endpointReview\n        ) ||\n        !isImportView(value.import) ||\n        !optional(\n            (f) => isRecord(f) && oneOf(RESET_STAGES, f.stage) && oneOf(VAULT_ERRORS, f.reason),\n            value.resetFailure\n        ) ||\n        typeof value.durabilityUnconfirmed !== 'boolean' ||\n        !Array.isArray(value.scans) ||\n        !value.scans.every(isScanRecord) ||\n        !isAcademyView(value.academy) ||\n        !optional((l) => typeof l === 'string' && LEARNER_REF.test(l), value.learner) ||\n        typeof value.academyOrigin !== 'string' ||\n//! Protected Harness history inside the authority (C20, D047).\n//!\n//! The chosen Gateway workspace's saved conversations are listed, opened,\n//! exported and deleted here, and a saved conversation whose binding is the\n//! one a new conversation would have now can be continued (restored into a\n//! new engine). Records are read and written off the lock with the\n//! Keychain-held scope key; each result applies only while its request is\n//! still the current one for that scope.\n\nuse std::sync::Arc;\n\nuse serde::Serialize;\nuse ts_rs::TS;\n\nuse super::harness_domain::{HistoryPlan, Resume};\nuse super::harness_identity::now;\nuse super::sessions_domain::ExportKind;\nuse super::{Effect, Inner, Refusal, State, lock};\nuse crate::context::{ContextRef, WorkspaceRef};\nuse crate::harness::history::{\n    self, CredentialSource, HistoryFailure, Listed, Record, SavedBinding, Scope,\n};\nuse crate::harness::session::{HistorySink, Replay};\nuse crate::harness::{HarnessEntry, HarnessRole, HarnessUsage, protocol};\nuse crate::store::GatewayPreference;\nuse crate::tenants::TenantId;\n\n/// One saved conversation in the list.\n#[derive(Clone, Debug, PartialEq, Eq, Serialize, TS)]\n#[serde(rename_all = \"camelCase\")]\npub struct SavedConversationView {\n    pub id: String,\n    pub title: String,\n    #[ts(type = \"number\")]\n    pub updated: u64,\n    pub entries: u32,\n    pub source: CredentialSource,\n}\n\n/// Why a saved conversation can be read but not continued.\n#[derive(Clone, Copy, Debug, PartialEq, Eq, Serialize, TS)]\n#[serde(rename_all = \"camelCase\")]\npub enum NotContinuable {\n    /// It is the conversation running now.\n    Running,\n    /// It ran with another key, sign-in, endpoint or credential choice.\n    OtherCredential,\n    /// It ran with another project folder, or with changes allowed or not\n    /// (C21): continuing it needs a new conversation.\n    OtherProject,\n    /// It ran with other workspace MCP servers or sign-ins (C22), or they\n    /// cannot be checked because the catalog is not loaded.\n    OtherMcp,\n    /// The bundled engine is not available.\n    EngineUnavailable,\n    /// Read from this Mac without its workspace from AI Gateway (as when it\n    /// cannot be reached): it can be read and exported, not continued.\n    WorkspaceUnavailable,\n    /// Cut short before the engine exported anything to restore: it can be\n    /// read and exported, never continued (C22 review R2-F1).\n    NotRestorable,\n    /// Imported from v1 (C23): its transcript can be read and exported; it\n    /// never continues (another engine's replay is never restored).\n    Imported,\n}\n\n/// A saved conversation opened for reading.\n#[derive(Clone, Debug, PartialEq, Eq, Serialize, TS)]\n#[serde(rename_all = \"camelCase\")]\npub struct OpenedConversationView {\n    pub id: String,\n    pub title: String,\n    #[ts(type = \"number\")]\n    pub updated: u64,\n    pub entries: Vec<HarnessEntry>,\n    pub source: CredentialSource,\n    pub not_continuable: Option<NotContinuable>,\n    /// Its opening message, whole (never the shortened title), when known:\n    /// a record saved before C32 knows it only while its transcript holds\n    /// the first message (C32).\n    #[serde(skip_serializing_if = \"Option::is_none\")]\n    #[ts(optional)]\n    pub opening: Option<String>,\n}\n\n#[derive(Clone, Copy, Debug, PartialEq, Eq, Serialize, TS)]\n#[serde(rename_all = \"camelCase\")]\npub enum HistoryListState {\n    Loading,\n    Ready,\n    Failed,\n}\n\n/// The chosen workspace's protected history.\n#[derive(Clone, Debug, PartialEq, Eq, Serialize, TS)]\n#[serde(rename_all = \"camelCase\")]\npub struct HarnessHistoryView {\n    /// Read from this Mac for the tenant's last chosen workspace, without\n    /// that workspace from AI Gateway (T23): read-only.\n    pub local: bool,\n    pub state: HistoryListState,\n    pub conversations: Vec<SavedConversationView>,\n    /// Records present that do not open with this workspace's key.\n    pub unreadable: Vec<String>,\n    pub failure: Option<HistoryFailure>,\n    /// The workspace holds as many saved conversations as it may.\n    pub full: bool,\n    pub opened: Option<OpenedConversationView>,\n    /// Opening or deleting is in progress.\n    pub busy: bool,\n    /// Why the last open or delete did not happen.\n    pub problem: Option<HistoryFailure>,\n    /// The last open that settled, so the open that asked for a record can\n    /// tell its own outcome, whatever came before it (C32). Absent until\n    /// one has.\n    #[serde(skip_serializing_if = \"Option::is_none\")]\n    #[ts(optional)]\n    pub last_open: Option<OpenSettled>,\n    /// Saving a transcript in the native sheet.\n    pub export: Option<super::sessions_domain::ExportView>,\n}\n\n/// Export formats.\n#[derive(Clone, Copy, Debug, PartialEq, Eq, serde::Deserialize, Serialize, TS)]\n#[serde(rename_all = \"camelCase\")]\npub enum HistoryFormat {\n    Markdown,\n    Text,\n    Json,\n}\n\n/// An open that settled: the record asked for, its place in the order the\n/// core admitted opens, and why it did not open (C32).\n#[derive(Clone, Debug, PartialEq, Eq, Serialize, TS)]\n#[serde(rename_all = \"camelCase\")]\npub struct OpenSettled {\n    pub id: String,\n    #[ts(type = \"number\")]\n    pub sequence: u64,\n    pub failure: Option<HistoryFailure>,\n}\n\n/// The history shown for one scope.\npub(super) struct HistoryState {\n    tenant: TenantId,\n    workspace: String,\n    scope: Scope,\n    /// Addressed without the workspace from AI Gateway.\n    local: bool,\n    /// The newest list request, and the newest open or delete.\n    list_lease: u64,\n    lease: u64,\n    list: Option<Result<Vec<Listed>, HistoryFailure>>,\n    opened: Option<Arc<Record>>,\n    busy: bool,\n    /// Why the last open or delete did not happen.\n    problem: Option<HistoryFailure>,\n    last_open: Option<OpenSettled>,\n}\n\n/// Work on records, off the lock.\npub(super) enum HistoryJob {\n    List {\n        lease: u64,\n        scope: Scope,\n    },\n    Open {\n        lease: u64,\n        scope: Scope,\n        id: String,\n177:    /// A discarded conversation's record is removed (C30), after any save\n553:    /// Remembers a discarded conversation (C30): no save of it is admitted\n556:    pub(super) fn discard_history(&mut self, scope: Scope, id: String) {\n557:        if self.history_discarded.len() >= MAX_DISCARDS {\n558:            self.history_discarded.remove(0);\n560:        self.history_discarded.push((scope.clone(), id.clone()));\n565:    pub(super) fn take_history_jobs(&mut self) -> Vec<Effect> {\n572:    /// Whether a conversation was discarded: its saves are refused.\n573:    fn history_discarded(&self, scope: &Scope, id: &str) -> bool {\n574:        self.history_discarded\n635:        // A discarded conversation (C30) is never saved again.\n638:            || self.history_discarded(scope, id)\n879:            // history hold: a discard between the two (its tombstone first,\n881:            // discarded transcript would be written again (C30).\n882:            let discarded = lock(&inner).is_ok_and(|state| state.history_discarded(&scope, &id));\n883:            if discarded {\n//! Native admission of a rendered request (C15, ADR 0004), decided before\n//! any secret is read. The credential class comes from the references the\n//! request would actually use, never from a collection or request identity:\n//!\n//! - anonymous: no secret; workbench: only workbench Keychain secrets;\n//!   managed: a native tenant credential (`tenant.client_id`,\n//!   `tenant.client_secret`, `tenant.api_key`). Mixing classes is refused.\n//! - A managed credential may only go where it belongs: the OAuth client\n//!   pair only into an `oauth2` grant whose token URL is an admitted token\n//!   destination of the active tenant's management capability; the scan\n//!   key only as the `x-pan-token` header to the tenant's scan origin.\n//!   Managed requests use HTTPS and admitted API origins only.\n//! - A managed request must be a known built-in catalogue operation: known\n//!   reads are admitted, known mutations need an exact review, and any\n//!   other method or path is denied, whatever it is presented as.\n//! - Every destination passes the build's network mode (fixture builds:\n//!   loopback only).\n//! - Registered Prisma origins (the configured management, token and scan\n//!   origins, known with or without an active tenant) are classified\n//!   whatever the credential: a request there with a manual or workbench\n//!   credential, or none, is still a known operation (mutations reviewed)\n//!   or denied, and generic redirects never enter them.\n//! - Managed and registered-origin requests carry no URL user-info and no\n//!   Host or forwarding override in any header they would send, the editor's\n//!   or the one their authentication generates. At a registered origin a\n//!   request also carries no method override and at most one credential\n//!   (one Authorization, Proxy-Authorization, Cookie or x-pan-token header,\n//!   or an API key in the query).\n\nuse std::collections::BTreeSet;\nuse std::net::IpAddr;\nuse std::sync::OnceLock;\n\nuse serde::Serialize;\nuse ts_rs::TS;\n\nuse super::render::{Auth, Piece, Plan, RenderProblem, Template};\nuse super::scm;\n\npub const CLIENT_ID: &str = \"tenant.client_id\";\npub const CLIENT_SECRET: &str = \"tenant.client_secret\";\npub const API_KEY: &str = \"tenant.api_key\";\n/// The active tenant's TSG (not a secret; filled in as text).\npub const TSG_ID: &str = \"tenant.tsg_id\";\nconst MANAGED: [&str; 4] = [CLIENT_ID, CLIENT_SECRET, API_KEY, TSG_ID];\n/// The legacy token path the built-in catalogue uses, at the token origin.\npub const CATALOGUE_TOKEN_PATH: &str = \"/auth/v1/oauth2/access_token\";\n/// Headers whose presence makes a managed request's credential or method\n/// ambiguous.\nconst AMBIGUOUS: [&str; 7] = [\n    CREDENTIAL_HEADERS[0],\n    CREDENTIAL_HEADERS[1],\n    CREDENTIAL_HEADERS[2],\n    CREDENTIAL_HEADERS[3],\n    METHOD_OVERRIDES[0],\n    METHOD_OVERRIDES[1],\n    METHOD_OVERRIDES[2],\n];\n\n/// Headers that carry a credential.\nconst CREDENTIAL_HEADERS: [&str; 4] = [\n    \"authorization\",\n    \"proxy-authorization\",\n    \"cookie\",\n    \"x-pan-token\",\n];\n\n/// Headers that ask a server to treat the request as another method.\nconst METHOD_OVERRIDES: [&str; 3] = [\n    \"x-http-method-override\",\n    \"x-http-method\",\n    \"x-method-override\",\n];\n\n/// Headers that would redirect a request to another virtual host behind\n/// the admitted authority.\nconst HOST_OVERRIDES: [&str; 5] = [\n    \"host\",\n    \"forwarded\",\n    \"x-forwarded-host\",\n    \"x-original-url\",\n    \"x-rewrite-url\",\n];\n\n/// Where API Client requests may go in this build.\n#[derive(Clone, Copy, Debug, PartialEq, Eq, Serialize, TS)]\n#[serde(rename_all = \"camelCase\")]\npub enum Network {\n    /// Any http(s) destination (production builds).\n    Live,\n    /// Loopback only, no proxy (fixture builds): literal loopback\n    /// addresses, or `localhost`, which the client pins to 127.0.0.1 (no\n    /// name is ever looked up).\n    LoopbackOnly,\n    /// Nothing is sent.\n    Disabled,\n}\n\nimpl Network {\n    pub fn admits(self, url: &url::Url) -> bool {\n        if !matches!(url.scheme(), \"http\" | \"https\") {\n            return false;\n        }\n        match self {\n            Self::Disabled => false,\n            Self::Live => url.host().is_some(),\n            Self::LoopbackOnly => match url.host() {\n                Some(url::Host::Ipv4(ip)) => IpAddr::V4(ip).is_loopback(),\n                Some(url::Host::Ipv6(ip)) => IpAddr::V6(ip).is_loopback(),\n                Some(url::Host::Domain(name)) => name == \"localhost\",\n                None => false,\n            },\n        }\n    }\n}\n\n/// The credential class a request was admitted under.\n#[derive(Clone, Copy, Debug, PartialEq, Eq, Serialize, serde::Deserialize, TS)]\n#[serde(rename_all = \"camelCase\")]\npub enum CredentialClass {\n    Anonymous,\n    Workbench,\n    Managed,\n}\n\n/// Why a Send was refused (nothing was sent).\n#[derive(Clone, Debug, PartialEq, Eq, Serialize, TS)]\n#[serde(tag = \"kind\", rename_all = \"camelCase\")]\npub enum SendRefusal {\n    Render {\n        problem: RenderProblem,\n    },\n    /// Not an absolute http(s) URL, or a secret in its origin.\n    Url,\n    /// This build does not send to that destination.\n    Network,\n    /// Workbench secrets and tenant credentials in one request.\n    MixedCredentials,\n    /// A `tenant.*` reference that names no native tenant credential.\n    UnknownManagedReference {\n        reference: String,\n    },\n    /// A tenant credential somewhere it may not go.\n    ManagedPlacement,\n    /// Operator headers that would override or obscure a tenant\n    /// credential or the method.\n    AmbiguousCredential,\n    /// No active tenant with the credential this request needs.\n    NoTenant,\n    /// The token URL is not the tenant credential's token destination.\n    TokenDestination,\n    /// The request URL is not where the tenant credential may go.\n    RequestDestination,\n    /// Tenant credentials go only over HTTPS.\n    NotHttps,\n    /// A tenant-credential request that is no known catalogue operation.\n    UnknownEndpoint,\n    /// A secret has no usable value on this Mac.\n    Secret {\n        reference: String,\n        failure: SecretFailure,\n    },\n    Body {\n        problem: BodyProblem,\n    },\n    /// Four requests are already running.\n    Busy,\n    /// The document changed since the snapshot was taken.\n    Stale,\n    /// Review outcomes for tenant-credential changes.\n    ReviewMissing,\n    ReviewStale,\n    ReviewExpired,\n    ReviewConsumed,\n    Declined,\n    /// The private API Client store is unavailable (nothing recorded).\n    Private,\n}\n\n#[derive(Clone, Copy, Debug, PartialEq, Eq, Serialize, TS)]\n{\n  \"$schema\": \"../gen/schemas/desktop-schema.json\",\n  \"identifier\": \"main-window\",\n  \"description\": \"The packaged main window may call only the two application commands.\",\n  \"local\": true,\n  \"windows\": [\"main\"],\n  \"webviews\": [\"main\"],\n  \"permissions\": [\"allow-desktop-dispatch\", \"allow-desktop-observe\"]\n}\n/**\n * Academy learner source compiled into the desktop (C05). The learner\n * package (@ai-security-academy/learner) exports Academy's own pages; their\n * `@/` imports are Academy's source in the prepared, hash-verified input\n * (.work/academy, xtask shared-prepare). Every bare import that source makes\n * resolves to this app's pinned copy (`dedupe`), so one React, one React\n * Query and one router instance exist and versions follow the desktop lock.\n */\n// A file-system path without Node typings in the app's tsconfig (the\n// repository path has no characters that URL-encode other than these).\nexport const ACADEMY_SRC = decodeURIComponent(new URL('../../.work/academy/src', import.meta.url).pathname)\nconst CONTRACTS_ROOT = decodeURIComponent(new URL('../../packages/desktop-contracts/', import.meta.url).pathname)\n\n// node_modules may be shared with another worktree. Compile this checkout's IPC parser and bindings,\n// not the workspace package reached through that other checkout's dependency symlink.\nexport const desktopAliases = [\n    { find: /^@prisma-airs\\/desktop-contracts$/, replacement: `${CONTRACTS_ROOT}src/index.ts` },\n    { find: /^@prisma-airs\\/desktop-contracts\\/fixtures\\//, replacement: `${CONTRACTS_ROOT}fixtures/` },\n    { find: /^@\\//, replacement: `${ACADEMY_SRC}/` },\n]\n\nexport const academyDedupe = [\n    'react',\n    'react-dom',\n    '@ai-security-academy/presentation',\n    '@ai-security-academy/shared',\n    '@codemirror/commands',\n    '@codemirror/lang-python',\n    '@codemirror/lang-yaml',\n    '@codemirror/language',\n    '@codemirror/state',\n    '@codemirror/view',\n    '@dnd-kit/core',\n    '@excalidraw/excalidraw',\n    '@lezer/highlight',\n    '@radix-ui/react-dialog',\n    '@radix-ui/react-slot',\n    '@tanstack/react-query',\n    '@tanstack/react-router',\n    '@trpc/client',\n    '@trpc/react-query',\n    '@trpc/server',\n    'class-variance-authority',\n    'clsx',\n    'dompurify',\n    'lucide-react',\n    'mermaid',\n    'qrcode.react',\n    'sanitize-html',\n    'tailwind-merge',\n    'zustand',\n]\n","exit_code":0,"status":"completed"}}
