ce, when it opens. Regaining the\n        // top after a higher dialog closes must not refocus: that dialog is\n        // restoring its own opener, which may be any control here.\n        if (!topmost || focusedOnce.current) return\n        const node = dialog.current\n        if (!node) return\n        focusedOnce.current = true\n        if (!node.contains(document.activeElement)) {\n            // A declared initial control first (wherever it sits), else the first focusable.\n            const first = node.querySelector<HTMLElement>('[autofocus]') ?? node.querySelector<HTMLElement>(FOCUSABLE)\n            ;(first ?? node).focus()\n        }\n    }, [topmost])\n\n    // Escape still closes the topmost dialog when focus has left it (a\n    // native sheet returning focus to the page body, a click on the scrim's\n    // edge): the dialog's own handler stops the event first when it has focus.\n    const closeRef = useRef(onClose)\n    closeRef.current = onClose\n    useEffect(() => {\n        if (!topmost) return\n        const onWindowKey = (event: globalThis.KeyboardEvent) => {\n            if (event.key !== 'Escape' || event.defaultPrevented) return\n            const node = dialog.current\n            if (node && node.contains(document.activeElement)) return\n            event.preventDefault()\n            closeRef.current()\n        }\n        window.addEventListener('keydown', onWindowKey)\n        return () => window.removeEventListener('keydown', onWindowKey)\n    }, [topmost])\n\n    const onKeyDown = (event: KeyboardEvent<HTMLDivElement>) => {\n        if (!topmost) return\n        if (event.key === 'Escape') {\n            event.preventDefault()\n            event.stopPropagation()\n            onClose()\n            return\n        }\n        if (event.key === 'Tab') {\n            // Keyboard interaction stays inside the topmost dialog.\n            const node = dialog.current\n            if (!node) return\n            const items = Array.from(node.querySelectorAll<HTMLElement>(FOCUSABLE)).filter((el) => !el.hasAttribute('hidden') && el.getAttribute('aria-hidden') !== 'true')\n            if (items.length === 0) {\n                event.preventDefault()\n                node.focus()\n                return\n            }\n            const first = items[0] as HTMLElement\n            const last = items[items.length - 1] as HTMLElement\n            const active = document.activeElement\n            if (event.shiftKey && (active === first || active === node)) {\n                event.preventDefault()\n                last.focus()\n            } else if (!event.shiftKey && active === last) {\n                event.preventDefault()\n                first.focus()\n            }\n        }\n    }\n\n    return (\n        <div\n            className={sheet ? 'fixed z-50 flex justify-end' : 'fixed inset-0 z-50 grid place-items-start justify-center'}\n            style={sheet ? { inset: 'var(--v2-header, 56px) 0 0 0' } : { paddingTop: top ?? '4vh' }}\n            data-v2-scrim=''\n            aria-hidden={topmost ? undefined : true}\n            inert={topmost ? undefined : true}\n            onMouseDown={() => topmost && onClose()}\n        >\n            <div\n                ref={dialog}\n                role='dialog'\n                aria-modal={topmost ? 'true' : undefined}\n                aria-label={label}\n                tabIndex={-1}\n                data-slot={rest['data-slot'] ?? 'modal'}\n                data-topmost={topmost ? 'true' : 'false'}\n                onKeyDown={onKeyDown}\n                onMouseDown={(e) => e.stopPropagation()}\n                className='border'\n                // Bounded to the viewport: a tall dialog scrolls inside itself, so its\n                // actions stay reachable at the minimum window size and 200% zoom.\n                style={\n                    sheet\n                        ? { width: `min(${width}px, 100vw)`, height: '100%', overflowY: 'auto', padding, borderRadius: 0, borderLeft: '1px solid var(--v2-rule)', boxShadow: '-18px 0 40px rgba(0,0,0,0.18)', background: 'var(--v2-bg)', borderWidth: 0, color: 'var(--v2-ink)' }\n                        : { width: `min(${width}px, 92vw)`, maxHeight: '92vh', overflowY: 'auto', padding, borderRadius: radius, boxShadow: '0 24px 60px rgba(0,0,0,0.3)', background: 'var(--v2-paper)', borderColor: 'var(--v2-rule)', color: 'var(--v2-ink)' }\n                }\n            >\n                {children}\n            </div>\n        </div>\n    )\n}\n\n/** Whether any modal is open: the shell makes the page behind it inert. */\nexport function useModalsOpen(): boolean {\n    return useShellStore((s) => s.modals.length > 0)\n}\n                                onClick={() => {\n                                    if (!onChangeWorkspace) return\n                                    close()\n                                    onChangeWorkspace()\n                                }}\n                                className='flex h-8 items-center justify-between gap-2 rounded-[6px] px-2.5 text-left disabled:cursor-not-allowed'\n                                style={{ color: onChangeWorkspace ? 'var(--v2-ink)' : 'var(--v2-faint)' }}\n                            >\n                                <span>{SHELL_COPY.changeWorkspace}</span>\n                                {!onChangeWorkspace && <span className='text-[12px]'>{SHELL_COPY.changeWorkspaceGate}</span>}\n                            </button>\n                        </div>\n                        <div className='flex flex-col gap-px overflow-y-auto overscroll-contain p-1.5' style={{ borderTop: '1px solid var(--v2-rule)' }}>\n                            <div className='px-2 pt-1.5 pb-1 text-[12px] font-semibold' style={{ color: 'var(--v2-faint)' }}>\n                                {SHELL_COPY.switchTenantHeading}\n                            </div>\n                            <div role='group' aria-label={SHELL_COPY.tenantSwitcher} data-slot='tenant-list' className='flex flex-col gap-px'>\n                                {snapshot.tenants.map((t, i) => {\n                                    const selected = t.id === snapshot.active?.tenant\n                                    return (\n                                        <button\n                                            key={t.id}\n                                            type='button'\n                                            aria-pressed={selected}\n                                            aria-label={identity(snapshot, t)}\n                                            onFocus={(e) => e.currentTarget.scrollIntoView({ block: 'nearest' })}\n                                            onClick={() => {\n                                                close()\n                                                if (!selected) onSwitch(t.id)\n                                            }}\n                                            className='flex min-h-[42px] w-full items-center gap-2.5 rounded-[7px] text-left'\n                                            style={{ padding: '4px 8px', background: selected ? 'var(--v2-inset)' : 'transparent' }}\n                                        >\n                                            <span aria-hidden='true' className='grid size-7 shrink-0 place-items-center rounded-[7px] text-[11px] font-bold' style={{ background: avatarColor(t.id), color: '#ffffff' }}>\n                                                {initials(t.label)}\n                                            </span>\n                                            <span className='min-w-0 flex-grow'>\n                                                <span className='font-semibold'>{t.label}</span> <span style={{ color: 'var(--v2-faint)' }}>{environment(snapshot, t.id)}</span>\n                                                <span className='block text-[12px]' style={{ color: 'var(--v2-faint)' }}>\n                                                    {selected && workspace ? SHELL_COPY.workspaceOf(workspace) : t.tsgId ? SHELL_COPY.tsgOf(t.tsgId) : ''}\n                                                </span>\n                                            </span>\n                                            <span aria-hidden='true' className='text-[12px] font-bold' style={{ color: 'var(--v2-acc)' }}>\n                                                {selected ? '✓' : ''}\n                                            </span>\n                                            <span className='text-[12px]' style={{ color: 'var(--v2-faint)' }}>\n                                                {i < 9 ? `⌃${i + 1}` : ''}\n                                            </span>\n                                        </button>\n                                    )\n                                })}\n                            </div>\n                        </div>\n                        <div className='p-1.5' style={{ borderTop: '1px solid var(--v2-rule)' }}>\n                            <button\n                                type='button'\n                                onClick={() => {\n                                    close()\n                                    onAdd()\n                                }}\n                                className='flex h-9 w-full items-center gap-2.5 rounded-[7px] px-2 text-left'\n                            >\n                                <span aria-hidden='true' className='grid size-7 place-items-center rounded-[7px] text-[16px]' style={{ border: '1px dashed var(--v2-faint)', color: 'var(--v2-soft)' }}>\n                                    +\n                                </span>\n                                {SHELL_COPY.addTenant}\n                            </button>\n                        </div>\n                    </div>,\n                    document.body\n                )}\n        </div>\n    )\n}\n12:    onSwitch: (tenant: string) => void\n22:    if (!tenant) return ''\n23:    return ENVIRONMENT_LABELS[tenant.environment]\n28:    return `${t.label} · ${environment(snapshot, t.id)}${t.tsgId ? ` · TSG ${t.tsgId}` : ''}`\n45:    return AVATARS[h % AVATARS.length]!\n56: * `selectTenant` intent (the C30 guard renders from the core's refusal).\n58:export function TenantSwitcher({ snapshot, onSwitch, onAdd, onNavigate, onChangeWorkspace, collapsed }: TenantSwitcherProps) {\n60:    const setOpen = useShellStore((s) => s.setSwitcher)\n69:    // (WebKit refuses focus inside an inert subtree), so this re-runs when the\n74:            first?.focus()\n75:            if (first && document.activeElement !== first) window.setTimeout(() => first.focus(), 0)\n76:        } else if (!open && wasOpen.current) trigger.current?.focus()\n80:        if (!open) return\n84:    const workspace = snapshot.gateway.selected?.workspace.name ?? null\n85:    // The account shown is the one the Harness would send as, for the selected workspace (R1).\n88:    const close = () => setOpen(false)\n89:    return (\n140:                                close()\n141:                                return\n146:                                if (!t) return\n148:                                close()\n149:                                if (t.id !== snapshot.active?.tenant) onSwitch(t.id)\n153:                        // overflow never constrain the selection surface (DESIGN-V2 §4).\n189:                                    close()\n201:                                    if (!onChangeWorkspace) return\n202:                                    close()\n218:                                    const selected = t.id === snapshot.active?.tenant\n219:                                    return (\n223:                                            aria-pressed={selected}\n227:                                                close()\n228:                                                if (!selected) onSwitch(t.id)\n231:                                            style={{ padding: '4px 8px', background: selected ? 'var(--v2-inset)' : 'transparent' }}\n239:                                                    {selected && workspace ? SHELL_COPY.workspaceOf(workspace) : t.tsgId ? SHELL_COPY.tsgOf(t.tsgId) : ''}\n243:                                                {selected ? '✓' : ''}\n257:                                    close()\n","exit_code":0,"status":"completed"}}
