ull\napps/desktop/src/v2/home.tsx:119:    const base = { id: product.id, name: product.label, isNew: product.availability.state === 'unavailable', gated: product.availability.state === 'unavailable', recheck }\napps/desktop/src/v2/home.tsx:122:    if (!state || state.state === 'pending' || state.state === 'notRead') return blank(PILLS.pending, read.state === 'reading' ? HOME_COPY.reading : HOME_COPY.firstRead)\napps/desktop/src/v2/home.tsx:218:    const hold = (kind: 'acknowledgeItem' | 'snoozeItem', id: string, title: string) => context && void onAct(holdWhat(kind, title), { kind, context, id })\napps/desktop/src/v2/home.tsx:219:    // A recheck re-reads one product (C30); its admission is announced for the product.\napps/desktop/src/v2/home.tsx:220:    const recheck = async (product: ProductId) => {\napps/desktop/src/v2/home.tsx:223:        const outcome = await onAct(SHELL_COPY.recheckOf(label, tenant.label), { kind: 'recheckProduct', context, product })\napps/desktop/src/v2/home.tsx:224:        if (outcome.kind === 'admitted') useShellStore.getState().toast(READ_COPY.recheck(label), 'info', undefined, tenant.id, context)\napps/desktop/src/v2/home.tsx:313:                                {c.recheck && context && (\napps/desktop/src/v2/home.tsx:316:                                        onClick={() => void recheck(c.recheck!)}\napps/desktop/src/v2/home.tsx:321:                                        {HOME_COPY.recheck}\napps/desktop/src/v2/home.tsx:383:                                            <button type='button' aria-label={`${SNOOZE_COPY.offer}: ${e.title}`} title={SNOOZE_COPY.offer} onClick={() => hold('snoozeItem', e.id, e.title)} className='grid size-8 min-h-0 shrink-0 place-items-center rounded-[7px] border' style={{ borderColor: 'var(--v2-rule)', background: 'var(--v2-bg)', color: 'var(--v2-ink)' }}>\nimport { useCallback, useEffect, useRef, useState, useSyncExternalStore } from 'react'\nimport type { AdminProductId, SwitchResolution, DesktopClient, Fea