{"type":"item.completed","item":{"id":"item_32","type":"command_execution","command":"/bin/zsh -lc \"sed -n '25,225p' apps/desktop/src/v2/inbox/inbox.test.tsx; sed -n '365,579p' crates/desktop-core/tests/ui_v2_inbox/main.rs; sed -n '654,757p' crates/desktop-core/tests/ui_v2_inbox/main.rs\"","aggregated_output":"\nbeforeEach(() => resetShellStore())\n\ndescribe('Inbox', () => {\n    it('lists the core entries in tabs with counts, opens the detail pane, and acts through core intents', async () => {\n        const user = userEvent.setup()\n        const native = await launch(fxInbox())\n        expect(screen.getByRole('heading', { level: 1, name: 'Inbox' })).toBeInTheDocument()\n        const tabs = screen.getAllByRole('tab').map((t) => t.textContent)\n        expect(tabs).toEqual(['All 4', 'Needs action 2', 'Updates 1', 'Snoozed 1'])\n        expect(screen.getByText(/3 of 4 sources were read at \\d\\d:\\d\\d\\./)).toBeInTheDocument()\n        await user.click(screen.getByRole('tab', { name: /Needs action/ }))\n        const rows = within(screen.getByRole('list', { name: 'Inbox items' })).getAllByRole('button')\n        expect(rows.map((r) => r.textContent)).toEqual([expect.stringContaining('Runtime expires in 5 days'), expect.stringContaining('AI Gateway: setup warning')])\n        await user.click(rows[0] as HTMLElement)\n        const detail = screen.getByRole('complementary', { name: 'Details' })\n        expect(within(detail).getByRole('heading', { level: 2, name: 'Runtime expires in 5 days' })).toBeInTheDocument()\n        expect(within(detail).getByText('Expires')).toBeInTheDocument()\n        expect(within(detail).getByText(/Why this matters/)).toBeInTheDocument()\n        await user.click(within(detail).getByRole('button', { name: 'Open API keys' }))\n        expect(native.dispatched.at(-1)).toEqual({ kind: 'navigate', feature: 'administration' })\n        // The action carries its target: Administration opens on the API keys inventory, filtered to the key.\n        const ready = native.current.tenants.map((t, i) => (i === 0 ? { ...t, management: { state: 'ready' as const, mode: 'keychain' as const, failure: null, clientId: 'client@1762204418.iam.panserviceaccount.com', tokenOrigin: 'https://auth.apps.paloaltonetworks.com' } } : t))\n        await native.push({ ...native.current, activeFeature: 'administration', tenants: ready })\n        await screen.findByRole('heading', { level: 1, name: 'Administration' })\n        await waitFor(() => expect(screen.getByRole('tab', { name: 'API keys' })).toHaveAttribute('aria-selected', 'true'))\n        await waitFor(() => expect(document.querySelector('[data-slot=\"administration-filter\"]')).toHaveValue('Runtime'))\n        await native.push({ ...native.current, activeFeature: 'inbox' })\n        await screen.findByRole('heading', { level: 1, name: 'Inbox' })\n        await user.click(within(screen.getByRole('list', { name: 'Inbox items' })).getByRole('button', { name: /Runtime expires in 5 days/ }))\n        await user.click(within(screen.getByRole('complementary', { name: 'Details' })).getByRole('button', { name: 'Acknowledge' }))\n        expect(native.dispatched.at(-1)).toEqual({ kind: 'acknowledgeItem', context: 'cx-aaaaaaaaaaaaaaaaaaaaaaaa', id: 'runtime-key:k1' })\n    })\n\n    it('snoozes through the core and states the return time the core computed, the same on Home (I11)', async () => {\n        const user = userEvent.setup()\n        const native = await launch(fxInbox())\n        await user.click(screen.getByRole('button', { name: /Runtime expires in 5 days/ }))\n        const detail = screen.getByRole('complementary', { name: 'Details' })\n        await user.click(within(detail).getByRole('button', { name: 'Snooze 24 hours: Runtime expires in 5 days' }))\n        expect(native.dispatched.at(-1)).toEqual({ kind: 'snoozeItem', context: 'cx-aaaaaaaaaaaaaaaaaaaaaaaa', id: 'runtime-key:k1' })\n        // The core answers with the return time and a receipt; the row, the pane and the toast all state it.\n        const snoozed = native.current.inbox.items.map((e) => (e.id === 'runtime-key:k1' ? { ...e, hold: { kind: 'snooze' as const, returnsAt: 1_761_576_400 } } : e))\n        await native.push({ ...native.current, inbox: { ...native.current.inbox, items: snoozed, lastSnooze: { id: 'runtime-key:k1', title: 'Runtime expires in 5 days', returnsAt: 1_761_576_400, sequence: 1 } } })\n        const returns = (await within(screen.getByRole('complementary', { name: 'Details' })).findByText(/^Returns /)).textContent\n        expect(returns).toMatch(/^Returns (today|tomorrow|\\w+ \\d+) \\d\\d:\\d\\d$/)\n        await user.click(screen.getByRole('tab', { name: /Snoozed/ }))\n        const row = screen.getByRole('button', { name: /Runtime expires in 5 days/ })\n        expect(row.textContent).toContain(returns)\n        await waitFor(() => expect(toasts().join(' ')).toContain(`Runtime expires in 5 days snoozed · returns ${returns?.replace('Returns ', '')}`))\n        // Home offers the same snooze label for the same item.\n        await native.push({ ...native.current, activeFeature: 'home' })\n        await screen.findByRole('heading', { level: 1, name: 'Home' })\n        expect(screen.getByRole('button', { name: 'Snooze 24 hours: AI Gateway: setup warning' })).toBeInTheDocument()\n        expect(document.querySelector('[data-slot=\"attention\"]')?.textContent ?? '').not.toContain('Runtime expires in 5 days')\n    })\n\n    it('derives completion toasts from the core read status: warn when partial, ok when complete (I4)', async () => {\n        const native = await launch(fxInbox())\n        await native.push({ ...native.current, inbox: { ...native.current.inbox, read: { ...native.current.inbox.read, generation: 2 } } })\n        await waitFor(() => expect(toasts().join(' ')).toMatch(/Read finished at \\d\\d:\\d\\d · 1 source partial/))\n        expect(document.querySelector('[data-slot=\"toast\"]')?.getAttribute('data-kind')).toBe('warn')\n        const complete = { ...native.current.inbox.read, generation: 3, sourcesMissing: [], products: native.current.inbox.read.products.map((p) => ({ ...p, state: 'ok' as const, sourcesRead: 2 })) }\n        await native.push({ ...native.current, inbox: { ...native.current.inbox, read: complete } })\n        await waitFor(() => expect(toasts().join(' ')).toMatch(/Read finished at \\d\\d:\\d\\d · all sources complete/))\n        expect(document.querySelector('[data-slot=\"toast\"]')?.getAttribute('data-kind')).toBe('ok')\n    })\n\n    it('a fresh tenant shows first read pending and an empty Inbox, never sample data (I12)', async () => {\n        const native = await launch(fxFresh())\n        expect(document.querySelector('[data-slot=\"read-status\"]')?.textContent).toContain('First read pending')\n        expect(document.querySelector('[data-slot=\"attention\"]')).toBeNull()\n        await native.push({ ...native.current, activeFeature: 'inbox' })\n        await screen.findByRole('heading', { level: 1, name: 'Inbox' })\n        expect(document.querySelector('[data-slot=\"inbox-empty\"]')?.textContent).toContain('First read pending')\n        expect(screen.queryByRole('list', { name: 'Inbox items' })).toBeNull()\n    })\n\n    it('renders the switch guard from the refusal payload and re-dispatches with the chosen resolution (I1)', async () => {\n        const user = userEvent.setup()\n        const native = await launch(fxInbox())\n        native.respond = () => ({ outcome: 'refusal', refusal: 'decisionPending' })\n        await user.click(screen.getByRole('button', { name: /^Switch tenant/ }))\n        await user.click(screen.getByRole('button', { name: /Meridian Retail/ }))\n        expect(native.dispatched.at(-1)).toEqual({ kind: 'selectTenant', tenant: 'tn-fedcba9876543210', resolution: null })\n        expect(toasts()).toEqual([])\n        await native.push({ ...native.current, switchBlocked: { context: native.current.active!.context, review: 'rv-1111111111111111', targetContext: null, to: 'tn-fedcba9876543210', pending: { conversation: 'op-7', decision: 'ap-1' }, completion: false } })\n        const guard = await screen.findByRole('dialog', { name: 'A Harness decision is waiting' })\n        expect(within(guard).getByText(/Switching to Meridian Retail ends it/)).toBeInTheDocument()\n        // Initial focus is Stay, the safe default: Enter on arrival ends nothing.\n        await waitFor(() => expect(within(guard).getByRole('button', { name: 'Stay' })).toHaveFocus())\n        native.respond = () => ({ outcome: 'receipt', receipt: { kind: 'admitted', request: 'rq-1', operation: null } })\n        await user.click(within(guard).getByRole('button', { name: 'Stay' }))\n        expect(native.dispatched.at(-1)).toEqual({ kind: 'dismissSwitchGuard' })\n        await native.push({ ...native.current, switchBlocked: { context: native.current.active!.context, review: 'rv-1111111111111111', targetContext: null, to: 'tn-fedcba9876543210', pending: { conversation: 'op-7', decision: 'ap-1' }, completion: false } })\n        await user.click(within(await screen.findByRole('dialog', { name: 'A Harness decision is waiting' })).getByRole('button', { name: 'Archive and switch' }))\n        expect(native.dispatched.at(-1)).toEqual({ kind: 'selectTenant', tenant: 'tn-fedcba9876543210', resolution: { kind: 'archive', context: native.current.active!.context, review: 'rv-1111111111111111' } })\n    })\n\n    it.each(['archive', 'discard'] as const)('retires an unconfirmed %s resolution with its native refusal, even in the same context', async (kind) => {\n        const user = userEvent.setup()\n        const native = await launch(fxInbox())\n        const context = native.current.active!.context\n        const guard = { context, review: 'rv-1111111111111111', targetContext: null, to: native.current.tenants[1]!.id, pending: { conversation: 'op-7', decision: 'ap-1' }, completion: false }\n        await native.push({ ...native.current, switchBlocked: guard })\n        native.respond = () => { throw new DeliveryOutcomeUnknown('lost') }\n        const label = kind === 'archive' ? 'Archive and switch' : 'Discard and switch'\n        await user.click(within(await screen.findByRole('dialog', { name: 'A Harness decision is waiting' })).getByRole('button', { name: label }))\n        await waitFor(() => expect(useShellStore.getState().unconfirmed).toHaveLength(1))\n        expect(useShellStore.getState().unconfirmed[0]?.context).toBe(context)\n        const retired = native.dispatched.at(-1)!\n        const sent = native.dispatched.length\n        // A replacement pending conversation/refusal in the same tenant/context.\n        const replacement = { ...guard, review: 'rv-2222222222222222', pending: { conversation: 'op-8', decision: 'ap-2' } }\n        await native.push({ ...native.current, switchBlocked: replacement })\n        expect(useShellStore.getState().unconfirmed).toHaveLength(0)\n        useShellStore.getState().addUnconfirmed('The retired switch', retired)\n        expect(useShellStore.getState().unconfirmed).toHaveLength(0)\n        expect(native.dispatched).toHaveLength(sent)\n        // A fresh explicit action uses the replacement native binding.\n        native.respond = () => ({ outcome: 'receipt', receipt: { kind: 'admitted', request: 'rq-1', operation: null } })\n        await user.click(within(screen.getByRole('dialog', { name: 'A Harness decision is waiting' })).getByRole('button', { name: label }))\n        expect(native.dispatched.at(-1)).toEqual({ kind: 'selectTenant', tenant: guard.to, resolution: { kind, context, review: replacement.review } })\n        await native.push({ ...native.current, active: { tenant: guard.to, context: 'cx-bbbbbbbbbbbbbbbbbbbbbbbb' }, switchBlocked: null })\n        expect(document.querySelector('[data-slot=\"unconfirmed\"]')).toBeNull()\n    })\n\n    it.each(['archive', 'discard'] as const)('never surfaces a late lost %s receipt after the source context retires', async (kind) => {\n        const user = userEvent.setup()\n        const native = await launch(fxInbox())\n        const guard = { context: native.current.active!.context, review: 'rv-1111111111111111', targetContext: null, to: native.current.tenants[1]!.id, pending: { conversation: 'op-7', decision: 'ap-1' }, completion: false }\n        await native.push({ ...native.current, switchBlocked: guard })\n        let fail: (reason: unknown) => void = () => undefined\n        native.respond = () => new Promise((_, reject) => { fail = reject })\n        await user.click(within(await screen.findByRole('dialog', { name: 'A Harness decision is waiting' })).getByRole('button', { name: kind === 'archive' ? 'Archive and switch' : 'Discard and switch' }))\n        await native.push({ ...native.current, active: { tenant: guard.to, context: 'cx-bbbbbbbbbbbbbbbbbbbbbbbb' }, switchBlocked: null })\n        fail(new DeliveryOutcomeUnknown('lost'))\n        await new Promise((resolve) => setTimeout(resolve, 50))\n        fail(new DeliveryOutcomeUnknown('lost'))\n        await new Promise((resolve) => setTimeout(resolve, 50))\n        expect(useShellStore.getState().unconfirmed).toHaveLength(0)\n        expect(document.querySelector('[data-slot=\"unconfirmed\"]')).toBeNull()\n        await native.push({ ...fxInbox(), active: { tenant: fxInbox().active!.tenant, context: 'cx-cccccccccccccccccccccccc' } })\n        expect(useShellStore.getState().unconfirmed).toHaveLength(0)\n    })\n\n    it('also retires a late unconfirmed initial tenant selection with the context it was asked from', async () => {\n        const user = userEvent.setup()\n        const native = await launch(fxInbox())\n        let fail: (reason: unknown) => void = () => undefined\n        native.respond = () => new Promise((_, reject) => { fail = reject })\n        await user.click(screen.getByRole('button', { name: /^Switch tenant/ }))\n        await user.click(screen.getByRole('button', { name: /Meridian Retail/ }))\n        await native.push({ ...native.current, active: { tenant: native.current.tenants[1]!.id, context: 'cx-bbbbbbbbbbbbbbbbbbbbbbbb' } })\n        fail(new DeliveryOutcomeUnknown('lost'))\n        await new Promise((resolve) => setTimeout(resolve, 50))\n        fail(new DeliveryOutcomeUnknown('lost'))\n        await new Promise((resolve) => setTimeout(resolve, 50))\n        expect(useShellStore.getState().unconfirmed).toHaveLength(0)\n    })\n\n    it.each(['unknown-first', 'snapshot-first'] as const)('retires a captured-null initial selection (%s) after another context appears', async (order) => {\n        const user = userEvent.setup()\n        // Deleting the active tenant leaves onboarding done and other tenants selectable.\n        const native = await launch({ ...fxFresh(), active: null })\n        const destination = native.current.tenants[0]!\n        const later = native.current.tenants[1]!\n        let fail: (reason: unknown) => void = () => undefined\n        native.respond = order === 'unknown-first'\n            ? () => { throw new DeliveryOutcomeUnknown('lost') }\n            : () => new Promise((_, reject) => { fail = reject })\n        await user.click(screen.getByRole('button', { name: /^Switch tenant/ }))\n        await user.click(screen.getByRole('button', { name: new RegExp(destination.label) }))\n        const selections = native.dispatched.filter((intent) => intent.kind === 'selectTenant')\n        expect(selections).toContainEqual({ kind: 'selectTenant', tenant: destination.id, resolution: null })\n        if (order === 'unknown-first') {\n            await screen.findByRole('button', { name: 'Retry' })\n            expect(useShellStore.getState().unconfirmed[0]?.context).toBeNull()\n        }\n        await native.push({ ...native.current, active: { tenant: destination.id, context: 'cx-bbbbbbbbbbbbbbbbbbbbbbbb' } })\n        if (order === 'snapshot-first') {\n            fail(new DeliveryOutcomeUnknown('lost'))\n            await new Promise((resolve) => setTimeout(resolve, 50))\n            fail(new DeliveryOutcomeUnknown('lost'))\n            await new Promise((resolve) => setTimeout(resolve, 50))\n        }\n        expect(useShellStore.getState().unconfirmed).toHaveLength(0)\n        expect(screen.queryByRole('button', { name: 'Retry' })).toBeNull()\n        // The client's bounded same-request resend has settled by now.\n        const settledSelections = native.dispatched.filter((intent) => intent.kind === 'selectTenant')\n        await native.push({ ...native.current, active: { tenant: later.id, context: 'cx-cccccccccccccccccccccccc' } })\n        expect(useShellStore.getState().unconfirmed).toHaveLength(0)\n        expect(screen.queryByRole('button', { name: 'Retry' })).toBeNull()\n        // Observation and retirement never re-dispatch the old destination.\n        expect(native.dispatched.filter((intent) => intent.kind === 'selectTenant')).toEqual(settledSelections)\n    })\n\n    it('announces a snooze once, from the core receipt: never an old hold after a switch or a reread (I11)', async () => {\n        const native = await launch(fxInbox())\n        // Meridian already holds a snoozed item: switching there is not a new snooze.\n        const meridian = native.current.tenants[1]!\n#[tokio::test(flavor = \"multi_thread\")]\nasync fn a_fresh_tenant_shows_pending_reads_and_an_empty_inbox() {\n    let desk = desk().await;\n    let snap = desk.snap();\n    assert_eq!(snap.inbox.read.state, ReadState::Pending);\n    assert!(snap.inbox.items.is_empty());\n    assert_eq!(snap.overview.face, AttentionFace::FirstLaunch);\n    assert!(snap.overview.attention.is_empty() && snap.overview.held.is_empty());\n    assert_eq!(\n        snap.inbox.read.products.len(),\n        1,\n        \"Runtime Security until the setup chooses more\"\n    );\n    assert_eq!(snap.inbox.read.products[0].state, ProductReadState::Pending);\n    assert_eq!(snap.inbox.read.generation, 0);\n}\n\n#[tokio::test(flavor = \"multi_thread\")]\nasync fn reads_report_per_product_coverage_and_a_recheck_names_its_product() {\n    let mut desk = desk().await;\n    desk.management_key().await;\n    let expiring = desktop_core::sessions::rfc3339(now() + 5 * 86_400 + 60);\n    desk.script().keys = vec![\n        json!({\"api_key_id\": \"k1\", \"api_key_name\": \"Runtime\", \"expiration\": expiring, \"api_key\": \"SYNTHETIC-KEY-NEVER-SHOWN\"}),\n    ];\n    let snap = desk.read().await;\n    let read = &snap.inbox.read;\n    assert_eq!(read.state, ReadState::Done);\n    assert!(read.last_read_at.is_some());\n    assert_eq!(read.generation, 1);\n    assert_eq!(read.products[0].state, ProductReadState::Ok);\n    assert_eq!(\n        (\n            read.products[0].sources_read,\n            read.products[0].sources_total\n        ),\n        (2, 2)\n    );\n    assert!(read.sources_missing.is_empty());\n    // Items carry their kind and product; the key is never in the snapshot.\n    let ids: Vec<&str> = snap.inbox.items.iter().map(|i| i.id.as_str()).collect();\n    assert_eq!(ids, [\"runtime-activity\", \"runtime-key:k1\"]);\n    assert!(\n        snap.inbox\n            .items\n            .iter()\n            .all(|i| i.kind == InboxKind::Runtime && i.product == Some(ProductId::RuntimeSecurity))\n    );\n    assert!(\n        !serde_json::to_string(&snap)\n            .expect(\"json\")\n            .contains(\"SYNTHETIC-KEY-NEVER-SHOWN\")\n    );\n    // A failed chart is partial coverage, named.\n    desk.script().chart_status = 503;\n    let snap = desk.read().await;\n    let read = &snap.inbox.read;\n    assert_eq!(read.state, ReadState::Done);\n    assert_eq!(read.products[0].state, ProductReadState::Incomplete);\n    assert_eq!(read.sources_missing, vec![\"sessions chart\".to_owned()]);\n    assert_eq!(read.generation, 2);\n    // A refused source needs a role; a recheck names the product until its read lands.\n    desk.script().chart_status = 200;\n    desk.script().keys_status = 403;\n    let context = desk.context();\n    desk.send(json!({\"kind\": \"recheckProduct\", \"context\": context, \"product\": \"runtimeSecurity\"}))\n        .await\n        .expect(\"recheck admitted\");\n    assert_eq!(\n        desk.snap().inbox.read.rechecking,\n        Some(ProductId::RuntimeSecurity)\n    );\n    assert!(eventually(|| desk.snap().inbox.read.generation == 3).await);\n    let read = desk.snap().inbox.read;\n    assert_eq!(read.products[0].state, ProductReadState::NeedsRole);\n    assert!(read.sources_missing.contains(&\"API keys\".to_owned()));\n    assert_eq!(read.rechecking, None, \"answered by the read\");\n}\n\n#[tokio::test(flavor = \"multi_thread\")]\nasync fn snooze_returns_at_a_core_computed_time_shown_the_same_everywhere() {\n    let mut desk = desk().await;\n    desk.management_key().await;\n    let expiring = desktop_core::sessions::rfc3339(now() + 3 * 86_400 + 60);\n    desk.script().keys =\n        vec![json!({\"api_key_id\": \"k1\", \"api_key_name\": \"Runtime\", \"expiration\": expiring})];\n    desk.read().await;\n    let context = desk.context();\n    let before = u32::try_from(now()).expect(\"fits\");\n    desk.send(json!({\"kind\": \"snoozeItem\", \"context\": context, \"id\": \"runtime-key:k1\"}))\n        .await\n        .expect(\"snoozed\");\n    let snap = desk.snap();\n    let held = snap\n        .overview\n        .held\n        .iter()\n        .find(|h| h.item.id == \"runtime-key:k1\")\n        .expect(\"held\");\n    let returns = held.returns_at.expect(\"a return time\");\n    assert!(\n        (before + 86_400..=before + 86_400 + 5).contains(&returns),\n        \"24 hours, computed in the core\"\n    );\n    let entry = snap\n        .inbox\n        .items\n        .iter()\n        .find(|i| i.id == \"runtime-key:k1\")\n        .expect(\"entry\");\n    let hold = entry.hold.as_ref().expect(\"hold\");\n    assert_eq!(hold.kind, HoldKind::Snooze);\n    assert_eq!(\n        hold.returns_at,\n        Some(returns),\n        \"the Inbox states the same time\"\n    );\n    assert!(\n        !snap\n            .overview\n            .attention\n            .iter()\n            .any(|i| i.id == \"runtime-key:k1\"),\n        \"off Home's attention list\"\n    );\n    // Unsnooze brings it back; acknowledge hides it without a return time.\n    desk.send(json!({\"kind\": \"unsnoozeItem\", \"context\": context, \"id\": \"runtime-key:k1\"}))\n        .await\n        .expect(\"unsnoozed\");\n    assert!(\n        desk.snap()\n            .overview\n            .attention\n            .iter()\n            .any(|i| i.id == \"runtime-key:k1\")\n    );\n    desk.send(json!({\"kind\": \"acknowledgeItem\", \"context\": context, \"id\": \"runtime-key:k1\"}))\n        .await\n        .expect(\"acknowledged\");\n    let entry = desk\n        .snap()\n        .inbox\n        .items\n        .into_iter()\n        .find(|i| i.id == \"runtime-key:k1\")\n        .expect(\"entry\");\n    assert_eq!(\n        entry.hold.as_ref().map(|h| (h.kind, h.returns_at)),\n        Some((HoldKind::Acknowledge, None))\n    );\n    assert_eq!(\n        desk.send(json!({\"kind\": \"snoozeItem\", \"context\": context, \"id\": \"no-such-item\"}))\n            .await,\n        Err(Refusal::InvalidInput)\n    );\n}\n\n#[tokio::test(flavor = \"multi_thread\")]\nasync fn every_scope_is_per_tenant_across_a_switch() {\n    let mut desk = desk().await;\n    desk.management_key().await;\n    let expiring = desktop_core::sessions::rfc3339(now() + 3 * 86_400 + 60);\n    desk.script().keys =\n        vec![json!({\"api_key_id\": \"k1\", \"api_key_name\": \"Runtime\", \"expiration\": expiring})];\n    desk.read().await;\n    let a = desk.snap().active.expect(\"A\").tenant;\n    let context = desk.context();\n    desk.send(json!({\"kind\": \"snoozeItem\", \"context\": context, \"id\": \"runtime-key:k1\"}))\n        .await\n        .expect(\"snoozed in A\");\n    assert_eq!(desk.snap().inbox.items.len(), 2);\n    // B: nothing of A's shows; B starts pending and empty, on its Home.\n    desk.send(json!({\"kind\": \"setUiVariant\", \"variant\": \"v2\"}))\n        .await\n        .expect(\"v2\");\n    desk.send(json!({\"kind\": \"navigate\", \"feature\": \"inbox\"}))\n        .await\n        .expect(\"inbox\");\n    let b = desk.tenant(\"Tenant B\").await;\n    let snap = desk.snap();\n    assert_eq!(\n        snap.active_feature,\n        desktop_core::features::FeatureId::Home,\n        \"a switch shows the new tenant's Home\"\n    );\n    assert_eq!(\n        snap.active.as_ref().map(|x| x.tenant.as_str()),\n        Some(b.as_str())\n    );\n    assert!(snap.inbox.items.is_empty(), \"B's Inbox is empty, not A's\");\n    assert_eq!(snap.inbox.read.state, ReadState::Pending);\n    assert!(snap.overview.held.is_empty(), \"A's holds are not B's\");\n    assert_eq!(snap.overview.face, AttentionFace::FirstLaunch);\n    // Back to A: its hold is still its own.\n    desk.send(json!({\"kind\": \"selectTenant\", \"tenant\": a}))\n        .await\n        .expect(\"back to A\");\n    desk.management_key().await;\n    let snap = desk.read().await;\n    let held = snap\n        .overview\n        .held\n        .iter()\n        .find(|h| h.item.id == \"runtime-key:k1\");\n    assert!(\n        held.is_some_and(|h| h.kind == HoldKind::Snooze),\n        \"A's snooze survived the round trip\"\n    );\n    assert_eq!(\n        snap.inbox.items.iter().filter(|i| i.hold.is_some()).count(),\n        1\n    );\n}\n\n#[tokio::test(flavor = \"multi_thread\")]\n#[tokio::test(flavor = \"multi_thread\")]\nasync fn a_tenants_read_survives_a_switch_away_and_back_without_a_new_read() {\n    let mut desk = desk().await;\n    desk.management_key().await;\n    let expiring = desktop_core::sessions::rfc3339(now() + 3 * 86_400 + 60);\n    desk.script().keys =\n        vec![json!({\"api_key_id\": \"k1\", \"api_key_name\": \"Runtime\", \"expiration\": expiring})];\n    let snap = desk.read().await;\n    let a = snap.active.expect(\"A\").tenant;\n    let read_at = snap.inbox.read.last_read_at.expect(\"read\");\n    let context = desk.context();\n    desk.send(json!({\"kind\": \"snoozeItem\", \"context\": context, \"id\": \"runtime-key:k1\"}))\n        .await\n        .expect(\"snoozed in A\");\n    let before = desk.snap();\n    assert_eq!(before.inbox.read.generation, 1);\n    // A recheck admitted in A, answered only after the switch: its reply\n    // belongs to a retired context.\n    desk.script().keys_status = 503;\n    desk.send(json!({\"kind\": \"recheckProduct\", \"context\": context, \"product\": \"runtimeSecurity\"}))\n        .await\n        .expect(\"recheck admitted\");\n    assert_eq!(\n        desk.snap().inbox.read.rechecking,\n        Some(ProductId::RuntimeSecurity)\n    );\n    let b = desk.tenant(\"Tenant B\").await;\n    let snap = desk.snap();\n    assert_eq!(\n        snap.active.as_ref().map(|x| x.tenant.as_str()),\n        Some(b.as_str())\n    );\n    assert_eq!(\n        snap.inbox.read.state,\n        ReadState::Pending,\n        \"B is its own, unread\"\n    );\n    assert_eq!(snap.inbox.read.rechecking, None, \"A's recheck is not B's\");\n    assert_eq!(snap.inbox.read.generation, 0);\n    assert!(snap.inbox.items.is_empty());\n    assert!(\n        snap.inbox.last_snooze.is_none(),\n        \"A's snooze receipt is not B's\"\n    );\n    // Back to A: no new read, and A's read is shown again as it was.\n    desk.script().keys_status = 200;\n    desk.send(json!({\"kind\": \"selectTenant\", \"tenant\": a}))\n        .await\n        .expect(\"back to A\");\n    tokio::time::sleep(Duration::from_millis(600)).await;\n    let snap = desk.snap();\n    assert_eq!(snap.inbox.read.state, ReadState::Done);\n    assert_eq!(\n        snap.inbox.read.last_read_at,\n        Some(read_at),\n        \"the cached read time\"\n    );\n    assert_eq!(\n        snap.inbox\n            .items\n            .iter()\n            .map(|i| i.id.clone())\n            .collect::<Vec<_>>(),\n        before\n            .inbox\n            .items\n            .iter()\n            .map(|i| i.id.clone())\n            .collect::<Vec<_>>(),\n        \"the cached items\"\n    );\n    assert!(\n        snap.inbox.items.iter().any(|i| i.id == \"runtime-key:k1\"\n            && i.hold.as_ref().is_some_and(|h| h.kind == HoldKind::Snooze)),\n        \"the hold\"\n    );\n    assert_eq!(\n        snap.inbox.read.products[0].state,\n        ProductReadState::Ok,\n        \"not the withdrawn 503 reply\"\n    );\n    assert_eq!(\n        snap.inbox.read.rechecking, None,\n        \"the retired recheck is not pending\"\n    );\n    assert_eq!(snap.inbox.last_snooze.as_ref().map(|r| r.sequence), Some(1));\n    assert!(snap.overview.read.is_some(), \"A's read is shown again\");\n    // Reading A again is one more completion of A only.\n    let snap = desk.read().await;\n    assert_eq!(snap.inbox.read.generation, 2);\n    desk.send(json!({\"kind\": \"selectTenant\", \"tenant\": b}))\n        .await\n        .expect(\"to B\");\n    assert_eq!(desk.snap().inbox.read.generation, 0, \"B's count is its own\");\n}\n\n/// C30 (I4): `readTenant` reads every chosen product finitely: the Runtime\n/// sources and the chosen Gateway workspace through the overview, the Red\n/// Team scans and statistics, the model and skill scans; each settles into\n/// its own per-source outcome. A chosen Gateway without a workspace is\n/// named as missing coverage, never announced complete; a refused source\n/// needs a role; `recheckProduct` re-reads one product and refuses one the\n/// tenant did not choose.\n#[tokio::test(flavor = \"multi_thread\")]\n","exit_code":0,"status":"completed"}}
