uild inputs changed')\n    require(value['unchanged'] is True and value['members'] == len((root / value['before_inventory']).read_text().splitlines())\n            and value['members'] > 0, 'native build inventory declaration mismatch')\n    with tempfile.TemporaryDirectory(prefix='p09-native-inputs-') as scratch:\n        current = subprocess.check_output(['/bin/bash', str(procedure), str(root), str(Path(scratch) / 'inputs.sha256')], text=True).strip()\n    require(current == value['before_digest'], 'current compiled inputs differ from prepared native build')\n    return {'record': str(path.relative_to(root)), 'sha256': sha(path),\n            'generation': build['generation'], 'input_digest': current}\n\n\ndef c30_samples(value):\n    \"\"\"Check real-record sample accounting; unit fixtures cannot qualify a run.\"\"\"\n    require(value.get('label') == 'acceptance' and value.get('status') == 'pass'\n            and value.get('failure') is None and value.get('method') == 'c30-cached-switch-v2',\n            'C30 requires successful current-method acceptance')\n    require(set(value['metrics']) == {'tenant-switch-home'}, 'wrong C30 workload')\n    metric = value['metrics']['tenant-switch-home']\n    samples = metric['samples']\n    require(metric['unit'] == 'ms' and len(samples) == 10, 'C30 requires ten measured samples')\n    require(all(type(x) in (int, float) and math.isfinite(x) and x > 0 for x in samples),\n            'invalid C30 timing sample')\n    rows = value['details']['raw_switches']\n    require(len(rows) == 12 and value['details']['switches'] == 12, 'C30 requires all twelve raw switches')\n    for index, row in enumerate(rows):\n        source, target = ('Tenant A', 'Tenant B') if index % 2 == 0 else ('Tenant B', 'Tenant A')\n        measured = row['probe'].get('ms')\n        require(row['index'] == index and row['from'] == source and row['to'] == target\n                and row['warmup'] is (index < 2) and row['exit'] == 0\n                and row['probe']['method'] == 'c30-cached-switch-v2'\n                and type(measured) in (int, float) and math.isfinite(measured) and measured > 0\n                and type(row['probe']['polls']) is int and row['probe']['polls'] > 0,\n                'invalid/omitted C30 raw switch')\n    require(samples == [row['probe']['ms'] for row in rows[2:]], 'C30 sample selection mismatch')\n    p95 = sorted(samples)[math.ceil(.95 * len(samples)) - 1]\n    require(p95 <= 100, 'C30 cached-switch p95 exceeds registered 100ms budget')\n    return p95\n\n\ndef verify_c30_performance(root, prepared, build, records):\n\"\"\"Read the C44 gate's existing assertion map without changing its requirements.\"\"\"\nimport json\nimport re\nimport runpy\n\n\ndef load_requirements(root):\n    manifest = json.loads((root / 'docs/architecture/native-checks.json').read_text())['chunks']\n    data = runpy.run_path(str(root / 'tools/native-acceptance/legacy_assertions.py'))\n    assertions = data['ASSERTIONS']\n    legacy_ids = {c['id'] for chunk, checks in manifest.items()\n                  if re.fullmatch(r'C(0[1-9]|1\\d|2\\d|3[0-3])', chunk) for c in checks}\n    assert legacy_ids == set(assertions), 'legacy map differs from the full manifest'\n    targets = {t for kind, ts, _ in assertions.values()\n               if kind in (data['X'], data['S'], data['P']) for t in ts}\n    self_run = {lid.split('-')[0] for lid, (kind, _, _) in assertions.items() if kind == data['S']}\n    required = {chunk: {t for t in targets if t.startswith(chunk + '-')} for chunk in self_run}\n    # Some legacy ids are carried by a different self-run driver. Only drivers with actual targets run;\n    # the union check below still requires every mapped target to be covered.\n    required = {chunk: checks for chunk, checks in required.items() if checks}\n    for chunk in [f'C{i}' for i in range(35, 45)]:\n        required[chunk] = {c['id'] for c in manifest[chunk]}\n    assert all(required.values()), 'empty required native check set'\n    assert targets <= set().union(*required.values()), 'mapped native target has no driver'\n    return required\n\n\ndef assess_record(record, root, executable_sha256, required):\n    errors = []\n    if record.get('app', {}).get('executable_sha256') != executable_sha256:\n        errors.append('stale executable')\n    checks = {c['id']: c for c in record.get('checks', [])}\n    for cid in sorted(required):\n        check = checks.get(cid)\n        if check is None:\n            errors.append(cid + ' missing')\n        elif check['result'] != 'pass':\n            errors.append(cid + ' ' + check['result'])\n        else:\n            errors.extend(cid + ' missing evidence: ' + e for e in check['evidence'] if not (root / e).exists())\n    carried_elsewhere = [cid for cid, c in checks.items() if cid not in required and c['result'] != 'pass']\n    return errors, carried_elsewhere\n{\n  \"schema\": \"airs-v2/live-row/1\",\n  \"subject\": \"C29\",\n  \"row\": \"verify against Vulture (reads only)\",\n  \"status\": \"pass\",\n  \"recorded_utc\": \"2026-11-01T13:38:19.467214+00:00\",\n  \"family\": \"L19\",\n  \"native_receipt\": \"docs/planning/evidence/C29/live/L19/attempt-03/receipt.json\",\n  \"native_receipt_sha256\": \"0d0b66212cd1483dbcab073050750de80e3277d29c875697302609e34855c202\",\n  \"manifest_sha256\": \"a2dd7b01ed289ed164859ac0daf6e582100de555d29eefb01fa13df87d0bdbe1\",\n  \"client_id\": \"prisma-airs-cli@1852583913.iam.panserviceaccount.com\",\n  \"tsg_id\": \"1852583913\",\n  \"operation\": \"one management credential verification through the first-run wizard (C29): one latest security-profile probe with limit=1; discard profile contents; no other inventory browsing or writes\",\n  \"executable_sha256\": \"8fb5a476b2a25adf2842286faa69e5393f5812ac3d7b65f87564eb0f05b54dca\",\n  \"source_inputs_sha256\": \"217a81f9ed49219bae0fa7946b9684ca6d2469b3c7f607d91b0c48816f09284c\",\n  \"current_source_match\": \"docs/planning/evidence/C29/live/L19/current-source