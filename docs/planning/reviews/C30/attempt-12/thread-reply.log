ard-boards.test.tsx': '6ec1c860a1982dab081cfb9f6449d05595f4777de52e787a5e6706bb9120cee0', 'apps/desktop/src/v2/wizard/wizard.test.tsx': '5660dbdf91ae5560cd8dce8f1d63579b2c5e2b6f2e9d7c47d863ed32301fc2f6', 'apps/desktop/src/v2/wizard/wizard.tsx': '2dad02a98b260442e02adc43e225ff02ff96785003395b91a453544a945cbbde', 'apps/desktop/tsconfig.json': '9d4eea5db5b726bb841ae59434e7ee162416640d91c25a52b59207ff7593a8c2', 'apps/desktop/vite.config.ts': '2fde1c37fc7c693d8ef3bfe8d3ab3bed2e7a92de747bb2221c89a0a5372a60cf', 'apps/desktop/vitest.config.ts': '37d95b98bc2d0d7245b9382f551eb3ca52b2cf95c9ade43e0b6d81839ed83c05', 'crates/desktop-core/src/authority.rs': '629dec32b59a6b674aa1442ece0e3f44d9b8ab7ba1efd2b5ae1671d9b35899ab', 'crates/desktop-core/src/authority/harness_domain.rs': 'e435948b3e3f9456088be8f14a3061907c32ca0cc1c0cbdac6177ecbbc8c714f', 'crates/desktop-core/src/authority/harness_history.rs': '1c62c24291f5bdda7d1e6d491f4b069bdd3d950e3bc71f48e43ae5f72ab20d2c', 'crates/desktop-core/src/authority/import_v1_domain.rs': 'f4838597cfa5ebaed2c7d93b78e7988e2c56672fddca5e01bc6962e78a20bf5d', 'crates/desktop-core/src/authority/import_v1_domain/owners.rs': '086f147d41c972bceda99d32cfae9958f8a76be728331170285e607648af46ea', 'crates/desktop-core/src/authority/inbox_domain.rs': '50841eb6f86cdf75ccc18a6a294d73c0caf4ed52616085f63cabfa55c3bf4038', 'crates/desktop-core/src/authority/management_domain.rs': 'e6902fdef171b0176bcc094a1e7616bc0d01d82e7b7d119bab99c40a0f5972bf', 'crates/desktop-core/src/authority/observation_domain.rs': '51b979541e8ceb83c08ff13b58d314f6dddb2a8913549323a98a959254b9053b', 'crates/desktop-core/src/authority/setup_domain.rs': '882ff459974eea6aa7cd59198f23973754394dc4a7b017848fbee00e8e2c9cb3', 'crates/desktop-core/src/features.rs': '5e1a4b15d5660114c7eb3e083358ecdc8a8be4dce7fc9874e94956797b6aa8db', 'crates/desktop-core/src/fixtures.rs': '2a745828980404b66b41ac3cf36dadf73e3dcfec8b4c1acf007a6c23b1515cd2', 'crates/desktop-core/src/harness/sidecar.rs': 'a043e8f3f3dea430c3c57cdf1eff83ebaea7f6336c0106cbeea7093bb950c6eb', 'crates/desktop-core/src/lib.rs': 'c403eeab081d7b55de9e06d72b87c5c29f3fbdc0804c5d6e9f77bec4a80122dd', 'crates/desktop-core/src/management.rs': '27ec0bf44ee40a190ae64fd83c43ab8765992bec49671b652db9862463a0a61b', 'crates/desktop-core/src/observation.rs': '27b4d657830323c0112e208331d08ec46119fa367033ba197717ea3fd62f159c', 'crates/desktop-core/src/offline.rs': 'c403658aaa4e1bf75b91e0eae95155b58471fc054915\n","exit_code":0,"status":"completed"}}
