{"type":"item.completed","item":{"id":"item_23","type":"command_execution","command":"/bin/zsh -lc \"sed -n '815,895p' crates/desktop-core/src/authority/harness_domain.rs; sed -n '2520,2590p' crates/desktop-core/src/authority.rs; sed -n '825,956p' crates/desktop-core/src/authority/setup_domain.rs\"","aggregated_output":"            .try_send(Command::Interrupt)\n            .map_err(|_| Refusal::Busy)\n    }\n\n    /// The bound conversation that is still running, if any (C30 guard).\n    pub(super) fn live_bound_harness(&self) -> Option<OperationId> {\n        self.harness\n            .as_ref()\n            .filter(|c| c.ended.is_none() && c.stop.is_none() && self.harness_bound(c))\n            .map(|c| c.id.clone())\n    }\n\n    /// The approvals the live bound conversation waits for (C30 guard).\n    pub(super) fn bound_approvals(&self) -> Vec<crate::harness::HarnessApproval> {\n        self.harness\n            .as_ref()\n            .filter(|c| c.ended.is_none() && c.stop.is_none() && self.harness_bound(c))\n            .map(|c| c.progress_approvals())\n            .unwrap_or_default()\n    }\n\n    /// Ends the conversation and drops it: nothing of it is shown or kept\n    /// (C30 \"discard and switch\"). Its protected history record is removed\n    /// and no later save of it (the turn the stop cuts short) is admitted.\n    pub(super) fn discard_harness(&mut self, id: &OperationId) -> Result<(), Refusal> {\n        let root = self.history_root();\n        let conversation = self.live_harness(id)?;\n        if let Some(job) = conversation.write_confirm.take() {\n            conversation.keep_unsent(job);\n        }\n        conversation.stop = Some(HarnessStop::Ended);\n        conversation.retired = true;\n        conversation.cancel.cancel();\n        let history_id = conversation.history_id.clone();\n        let scope = root.map(|root| {\n            Scope::new(\n                &root,\n                conversation.tenant.as_str(),\n                &conversation.workspace.id,\n            )\n        });\n        if let Some(scope) = scope {\n            self.discard_history(scope, history_id);\n        }\n        Ok(())\n    }\n\n    /// Ends the conversation: the engine is stopped and reaped.\n    pub(super) fn end_harness(&mut self, id: &OperationId) -> Result<(), Refusal> {\n        let conversation = self.live_harness(id)?;\n        if let Some(job) = conversation.write_confirm.take() {\n            conversation.keep_unsent(job);\n        }\n        conversation.stop = Some(HarnessStop::Ended);\n        conversation.cancel.cancel();\n        Ok(())\n    }\n\n    /// Stops whatever conversation runs (sleep, quit), keeping it shown.\n    pub(super) fn stop_harness(&mut self, why: HarnessStop) -> bool {\n        match self.harness.as_mut().filter(|c| c.ended.is_none()) {\n            Some(c) => {\n                // A renewal waiting for changes to be allowed again is not\n                // sent; its message goes back to the box (P06 review R3-F1).\n                if let Some(job) = c.write_confirm.take() {\n                    c.keep_unsent(job);\n                }\n                c.stop.get_or_insert(why);\n                c.cancel.cancel();\n                true\n            }\n            None => false,\n        }\n    }\n\n    /// Clears an ended conversation (nothing of it is kept).\n    pub(super) fn clear_harness(&mut self, id: &OperationId) -> Result<(), Refusal> {\n        if !self\n            .harness\n            .as_ref()\n            .is_some_and(|c| &c.id == id && c.ended.is_some())\n            // An in-flight write is already in the ledger (Keychain) or is\n            // discarded by its stale completion (session).\n            ScanCapability::Storing { .. }\n            | ScanCapability::Failed { .. }\n            | ScanCapability::Missing => None,\n        }\n    }\n\n    /// Saves the current data. A failure before the replacement changed\n    /// nothing: memory is restored to `before` and the intent is refused. A\n    /// replacement whose durability was not confirmed is kept (it is what a\n    /// restart would most likely load) and reported in the snapshot.\n    fn save_with(&mut self, before: &Data) -> Result<(), Refusal> {\n        let saved = match self.storage {\n            StorageHealth::Ready => self.store.save(&self.persisted()),\n            StorageHealth::Resetting => {\n                self.data = before.clone();\n                return Err(Refusal::Busy);\n            }\n            StorageHealth::Corrupt | StorageHealth::Unavailable => {\n                self.data = before.clone();\n                return Err(Refusal::DeniedStore);\n            }\n        };\n        match saved {\n            Ok(()) => {\n                self.durability_unconfirmed = false;\n                // The saved state includes every rotation fact held in memory.\n                self.rotation_unsaved = false;\n                Ok(())\n            }\n            Err(StoreError::Unconfirmed) => {\n                self.durability_unconfirmed = true;\n                self.rotation_unsaved = false;\n                Ok(())\n            }\n            Err(error) => {\n                self.data = before.clone();\n                Err(store_refusal(error))\n            }\n        }\n    }\n\n    /// Saves again to confirm durability after an unconfirmed save. Only a\n    /// confirmed write-ahead may authorize a protected-storage write.\n    fn confirm_durable(&mut self) -> bool {\n        match self.store.save(&self.persisted()) {\n            Ok(()) => {\n                self.durability_unconfirmed = false;\n                true\n            }\n            Err(_) => false,\n        }\n    }\n\n    /// Retires every context reference and operation (reset admission).\n    fn retire_all_contexts(&mut self) -> Vec<runtime::Start> {\n        self.epoch += 1;\n        self.active_ref = None;\n        self.endpoint_review = None;\n        let starts = self.operations.retire_contexts(\"\", None, Instant::now());\n        self.workbench.sending.retire(None);\n        self.retire_scan_sessions();\n        self.retire_management_bindings();\n        let mut starts = starts;\n        starts.extend(self.retire_gateway());\n        self.sync_scans();\n        self.sync_management_calls();\n        self.sync_changes();\n        starts\n    }\n        }\n        if setup.mode == SetupMode::FirstRun\n            && !matches!(setup.tenant.scan, ScanCapability::Ready { .. })\n        {\n            return Err(Refusal::InvalidInput);\n        }\n        if packs.iter().any(|p| !setup.products.contains(p)) {\n            return Err(Refusal::InvalidInput);\n        }\n        if self.data.tenants.len() >= MAX_TENANTS {\n            return Err(Refusal::Busy);\n        }\n        Ok(setup.tenant.profile.id.clone())\n    }\n\n    pub(super) fn complete_setup(\n        &mut self,\n        context: &ContextRef,\n        packs: Vec<ProductId>,\n        recorded_secs: u32,\n    ) -> Result<Completed, Refusal> {\n        self.completable_setup(context, &packs)?;\n        let setup = self.setup_for(context)?;\n        let view = Self::verify_view(setup).ok_or(Refusal::InvalidInput)?;\n        // Stage only Data before persistence. Authority retirement is\n        // irreversible and waits for the handler's successful save.\n        let retired_workspace = self.setup_workspace_reference();\n        let Some(mut setup) = self.data.setup.take() else {\n            return Err(Refusal::StaleContext);\n        };\n        let first_run = setup.mode == SetupMode::FirstRun;\n        setup.tenant.products = setup.products.clone();\n        for (n, w) in view.warnings.into_iter().take(MAX_WARNINGS).enumerate() {\n            setup\n                .tenant\n                .setup_warnings\n                .push(crate::features::SetupWarning {\n                    id: format!(\"vw-{}\", n + 1),\n                    product: w.product,\n                    reason: w.reason,\n                    recorded_secs,\n                });\n        }\n        let id = setup.tenant.profile.id.clone();\n        self.data.tenants.push(setup.tenant);\n        self.data.active = Some(id.clone());\n        if first_run {\n            self.data.onboarding = Some(OnboardingState::Done);\n        }\n        let packs = packs\n            .iter()\n            .flat_map(|p| case_products(*p).iter().copied())\n            .collect();\n        Ok(Completed {\n            tenant: id,\n            first_run,\n            packs,\n            retired_workspace,\n        })\n    }\n\n    /// Drops the draft. Its Keychain records go to the cleanup queue; the\n    /// returned session records are the caller's to delete. No tenant,\n    /// selection or onboarding state changes.\n    pub(super) fn discard_setup(&mut self, context: &ContextRef) -> Result<Vec<RecordId>, Refusal> {\n        let id = self.setup_for(context)?.tenant.profile.id.clone();\n        let mut retired = Vec::new();\n        for class in [\n            CredentialClass::Scan,\n            CredentialClass::Management,\n            CredentialClass::Inference,\n        ] {\n            retired.extend(self.retire_class(&id, class));\n        }\n        self.retire_setup_authority();\n        self.data.setup = None;\n        Ok(retired)\n    }\n\n    /// Nothing bound to the draft's context outlives the draft: the cached\n    /// management binding (SDK clients, token cache), the reads queued or in\n    /// flight under its context and under its chosen workspace reference.\n    /// Late replies are withdrawn by the pipeline (the context is gone).\n    fn retire_setup_authority(&mut self) {\n        let Some((context, reference)) = self.data.setup.as_ref().map(|s| {\n            (\n                s.context.clone(),\n                s.gateway.selection.as_ref().map(|w| w.reference.clone()),\n            )\n        }) else {\n            return;\n        };\n        self.retire_setup_context(&context, reference.as_ref());\n    }\n\n    /// Retire a committed draft only after its state replacement succeeded.\n    pub(super) fn retire_setup_context(\n        &mut self,\n        context: &ContextRef,\n        reference: Option<&WorkspaceRef>,\n    ) {\n        self.retire_management_binding(context);\n        let now = Instant::now();\n        let mut starts = self.operations.retire_context(context.as_str(), now);\n        if let Some(reference) = reference {\n            starts.extend(self.operations.retire_context(reference.as_str(), now));\n        }\n        self.queue_gateway_starts(starts);\n    }\n\n    /// Whether a draft credential is stored in the Keychain (its removal\n    /// needs storage).\n    pub(super) fn setup_has_keychain_credential(&self) -> bool {\n        self.data.setup.as_ref().is_some_and(|s| {\n            [\n                CredentialClass::Scan,\n                CredentialClass::Management,\n                CredentialClass::Inference,\n            ]\n            .into_iter()\n            .any(|c| {\n                matches!(\n                    s.tenant.capability(c),\n                    ScanCapability::Ready {\n                        mode: StorageMode::Keychain,\n                        ..\n                    }\n                )\n            })\n        })\n    }\n}\n","exit_code":0,"status":"completed"}}
