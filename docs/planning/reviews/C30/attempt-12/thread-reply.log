{"type":"item.completed","item":{"id":"item_35","type":"command_execution","command":"/bin/zsh -lc \"sed -n '175,300p' tools/perf/probe.swift; sed -n '85,170p' crates/xtask/src/fingerprint.rs; sed -n '337,404p' crates/desktop-core/tests/ui_v2_inbox/main.rs; python3 -c 'import json; r=json.load(open(\\\"docs/planning/evidence/P09/workload-perf-C30.json\\\")); print(json.dumps(r,indent=2)[:8500])'\"","aggregated_output":"        var stack = Array(roots.reversed())\n        while let el = stack.popLast(), out.count < 20000 {\n            out.append(el)\n            stack.append(contentsOf: ((attr(el, kAXChildrenAttribute) as? [AXUIElement]) ?? []).reversed())\n        }\n        return out\n    }\n    let elements = walk((attr(app, kAXWindowsAttribute) as? [AXUIElement]) ?? [])\n    let targetPrefix = args[3] + \" ·\"\n    let targets = elements.filter {\n        (attr($0, kAXRoleAttribute) as? String) == \"AXCheckBox\" && label($0).hasPrefix(targetPrefix)\n    }\n    guard targets.count == 1, let target = targets.first,\n          (attr(target, kAXValueAttribute) as? NSNumber)?.boolValue != true else {\n        fail(\"expected exactly one unselected destination tenant row\")\n    }\n    guard let selector = elements.first(where: {\n        (attr($0, kAXRoleAttribute) as? String) == \"AXPopUpButton\" && label($0).hasPrefix(\"Switch tenant:\")\n    }), let main = elements.first(where: {\n        (attr($0, kAXSubroleAttribute) as? String) == \"AXLandmarkMain\"\n    }) else { fail(\"current tenant selector or main content unavailable\") }\n    func homeReady() -> Bool {\n        var heading = false\n        var status = false\n        var seen = 0\n        var stack: [(AXUIElement, Bool)] = [(main, false)]\n        while let (el, wasStatus) = stack.popLast(), seen < 20000 {\n            seen += 1\n            let role = attr(el, kAXRoleAttribute) as? String\n            let inStatus = wasStatus || (attr(el, kAXSubroleAttribute) as? String) == \"AXApplicationStatus\"\n            if role == \"AXHeading\", label(el) == \"Home\" { heading = true }\n            if inStatus, role == \"AXStaticText\", let value = attr(el, kAXValueAttribute) as? String,\n               value.contains(args[4]) { status = true }\n            if heading && status { return true }\n            for child in ((attr(el, kAXChildrenAttribute) as? [AXUIElement]) ?? []).reversed() {\n                stack.append((child, inStatus))\n            }\n        }\n        return false\n    }\n    let start = DispatchTime.now().uptimeNanoseconds\n    guard AXUIElementPerformAction(target, kAXPressAction as CFString) == .success else { fail(\"press failed\") }\n    var polls = 0\n    while ms(since: start) < timeout {\n        polls += 1\n        guard NSWorkspace.shared.frontmostApplication?.processIdentifier == pid else { fail(\"fixture lost foreground\") }\n        if label(selector).hasPrefix(\"Switch tenant: \" + targetPrefix) && homeReady() {\n            emit([\"ms\": ms(since: start), \"polls\": polls, \"method\": \"c30-cached-switch-v2\"])\n            exit(0)\n        }\n        usleep(2_000)\n    }\n    emit([\"ms\": NSNull(), \"polls\": polls, \"method\": \"c30-cached-switch-v2\"])\n    exit(2)\ncase \"activate-field\":\n    // From AXPress on a control to a text field labelled <field> exposing\n    // exactly <value> (the newly selected tab's editor is ready).\n    guard args.count == 8, let pid = pid_t(args[2]), let timeout = Double(args[7]) else {\n        fail(\"activate-field <pid> <role> <label prefix> <field label> <value> <timeout ms>\")\n    }\n    let app = AXUIElementCreateApplication(pid)\n    func fields() -> [AXUIElement] {\n        var out: [AXUIElement] = []\n        var stack = (attr(app, kAXWindowsAttribute) as? [AXUIElement]) ?? []\n        var seen = 0\n        while let el = stack.popLast(), seen < 20000 {\n            seen += 1\n            out.append(el)\n            stack.append(contentsOf: (attr(el, kAXChildrenAttribute) as? [AXUIElement]) ?? [])\n        }\n        return out\n    }\n    guard let target = fields().first(where: {\n        (attr($0, kAXRoleAttribute) as? String) == args[3] && label($0).hasPrefix(args[4])\n    }) else { fail(\"no \\(args[3]) labelled \\(args[4])\") }\n    let start = DispatchTime.now().uptimeNanoseconds\n    guard AXUIElementPerformAction(target, kAXPressAction as CFString) == .success else { fail(\"press failed\") }\n    var polls = 0\n    while ms(since: start) < timeout {\n        polls += 1\n        let ready = fields().contains(where: {\n            (attr($0, kAXRoleAttribute) as? String) == \"AXTextField\"\n                && label($0) == args[5]\n                && (attr($0, kAXValueAttribute) as? String) == args[6]\n        })\n        if ready {\n            emit([\"ms\": ms(since: start), \"polls\": polls])\n            exit(0)\n        }\n        usleep(2_000)\n    }\n    emit([\"ms\": NSNull(), \"polls\": polls])\n    exit(2)\ndefault:\n    fail(\"unknown command \\(args[1])\")\n}\n    paths.dedup();\n    let mut entries = Vec::with_capacity(paths.len() + 1);\n    for path in paths {\n        entries.push(file_entry(repo.root(), &path)?);\n    }\n    entries.push(file_entry(repo.root(), \".git/config\")?);\n    Ok(entries)\n}\n\nfn file_entry(root: &Path, relative: &str) -> Result<FileEntry> {\n    let full = root.join(relative);\n    let Ok(meta) = std::fs::symlink_metadata(&full) else {\n        return Ok(FileEntry {\n            path: relative.to_owned(),\n            mode: \"deleted\".to_owned(),\n            sha256: String::new(),\n        });\n    };\n    if meta.file_type().is_symlink() {\n        let target = std::fs::read_link(&full).map_err(io_err(&full))?;\n        return Ok(FileEntry {\n            path: relative.to_owned(),\n            mode: \"symlink\".to_owned(),\n            sha256: sha256_hex(target.as_os_str().as_encoded_bytes()),\n        });\n    }\n    let bytes = std::fs::read(&full).map_err(io_err(&full))?;\n    let executable = meta.permissions().mode() & 0o111 != 0;\n    Ok(FileEntry {\n        path: relative.to_owned(),\n        mode: if executable { \"100755\" } else { \"100644\" }.to_owned(),\n        sha256: sha256_hex(&bytes),\n    })\n}\n\npub fn inventory_hash(entries: &[FileEntry]) -> String {\n    let text: String = entries\n        .iter()\n        .map(|e| format!(\"{}\\0{}\\0{}\\n\", e.path, e.mode, e.sha256))\n        .collect();\n    sha256_hex(text.as_bytes())\n}\n\npub fn source(repo: &Repo) -> Result<String> {\n    Ok(inventory_hash(&source_inventory(repo)?))\n}\n\n/// Hash of every regular file under a directory (relative paths, sorted).\npub fn tree_hash(dir: &Path) -> Result<String> {\n    tree_hash_excluding(dir, &[])\n}\n\n/// Like [`tree_hash`], skipping directories with the given names.\npub fn tree_hash_excluding(dir: &Path, skip: &[&str]) -> Result<String> {\n    let mut entries = Vec::new();\n    collect_tree(dir, dir, skip, &mut entries)?;\n    entries.sort_by(|a, b| a.path.cmp(&b.path));\n    Ok(inventory_hash(&entries))\n}\n\nfn collect_tree(root: &Path, dir: &Path, skip: &[&str], out: &mut Vec<FileEntry>) -> Result<()> {\n    let mut children: Vec<_> = std::fs::read_dir(dir)\n        .map_err(io_err(dir))?\n        .filter_map(|e| e.ok())\n        .collect();\n    children.sort_by_key(|e| e.file_name());\n    for child in children {\n        let path = child.path();\n        let relative = path\n            .strip_prefix(root)\n            .map_err(|_| invalid(\"path escaped its root\"))?\n            .to_string_lossy()\n            .into_owned();\n        let meta = std::fs::symlink_metadata(&path).map_err(io_err(&path))?;\n        if meta.is_dir() {\n            if skip.iter().any(|name| child.file_name() == *name) {\n                continue;\n            }\n            collect_tree(root, &path, skip, out)?;\n        } else {\n            out.push(file_entry(root, &relative)?);\n        }\n    }\n    Ok(())\n}\n\n        );\n        self.send(json!({\"kind\": \"completeTenantSetup\", \"context\": draft, \"packs\": []}))\n            .await\n            .expect(\"completed\");\n        let id = self.snap().active.expect(\"active\").tenant;\n        self.management_key().await;\n        id.as_str().to_owned()\n    }\n\n    /// `readTenant`, waited to completion.\n    async fn read(&mut self) -> ShellSnapshot {\n        let context = self.context();\n        let before = self.snap().inbox.read.generation;\n        self.send(json!({\"kind\": \"readTenant\", \"context\": context}))\n            .await\n            .expect(\"read admitted\");\n        assert!(\n            eventually(|| {\n                let s = self.snap();\n                s.inbox.read.generation != before && !s.overview.refreshing\n            })\n            .await,\n            \"the read completed\"\n        );\n        self.snap()\n    }\n}\n\n#[tokio::test(flavor = \"multi_thread\")]\nasync fn a_fresh_tenant_shows_pending_reads_and_an_empty_inbox() {\n    let desk = desk().await;\n    let snap = desk.snap();\n    assert_eq!(snap.inbox.read.state, ReadState::Pending);\n    assert!(snap.inbox.items.is_empty());\n    assert_eq!(snap.overview.face, AttentionFace::FirstLaunch);\n    assert!(snap.overview.attention.is_empty() && snap.overview.held.is_empty());\n    assert_eq!(\n        snap.inbox.read.products.len(),\n        1,\n        \"Runtime Security until the setup chooses more\"\n    );\n    assert_eq!(snap.inbox.read.products[0].state, ProductReadState::Pending);\n    assert_eq!(snap.inbox.read.generation, 0);\n}\n\n#[tokio::test(flavor = \"multi_thread\")]\nasync fn reads_report_per_product_coverage_and_a_recheck_names_its_product() {\n    let mut desk = desk().await;\n    desk.management_key().await;\n    let expiring = desktop_core::sessions::rfc3339(now() + 5 * 86_400 + 60);\n    desk.script().keys = vec![\n        json!({\"api_key_id\": \"k1\", \"api_key_name\": \"Runtime\", \"expiration\": expiring, \"api_key\": \"SYNTHETIC-KEY-NEVER-SHOWN\"}),\n    ];\n    let snap = desk.read().await;\n    let read = &snap.inbox.read;\n    assert_eq!(read.state, ReadState::Done);\n    assert!(read.last_read_at.is_some());\n    assert_eq!(read.generation, 1);\n    assert_eq!(read.products[0].state, ProductReadState::Ok);\n    assert_eq!(\n        (\n            read.products[0].sources_read,\n            read.products[0].sources_total\n        ),\n        (2, 2)\n    );\n    assert!(read.sources_missing.is_empty());\n    // Items carry their kind and product; the key is never in the snapshot.\n{\n  \"schema\": \"airs-v2-workload-perf/1\",\n  \"label\": \"acceptance\",\n  \"status\": \"pass\",\n  \"failure\": null,\n  \"method\": \"c30-cached-switch-v2\",\n  \"method_sha256\": \"35830b74e6c0c9721080de1b51f6d25ff68265a98adb1bc76eba041e723bc582\",\n  \"registration_record_sha256\": \"9065a742f836824a30d2913c0032723523703fdb93cb81934d219236dfa9c326\",\n  \"subject\": \"P09\",\n  \"attempt\": \"attempt-03\",\n  \"command\": [\n    \"/opt/homebrew/Cellar/python@3.15/3.15.0/Frameworks/Python.framework/Versions/3.15/Resources/Python.app/Contents/MacOS/Python\",\n    \"-I\",\n    \"tools/perf/measure_c30.py\",\n    \"--label\",\n    \"acceptance\",\n    \"--attempt\",\n    \"attempt-03\"\n  ],\n  \"conditions\": {\n    \"platform\": \"macOS-26.6.2-arm64-arm-64bit-Mach-O\",\n    \"machine\": \"arm64\",\n    \"macos\": \"26.6.2\",\n    \"swiftc\": \"Apple Swift version 6.4 (swiftlang-6.4.0.34.1 clang-2100.3.34.1)\\nTarget: arm64-apple-macosx26.0\",\n    \"load_average\": [\n      1.57470703125,\n      1.3125,\n      1.3544921875\n    ],\n    \"execution_environment\": \"owner-authorized Worf macOS guest; guest-level observations only\",\n    \"fixture_pid\": 3656,\n    \"window\": {\n      \"pos\": [\n        320,\n        95\n      ],\n      \"size\": [\n        1280,\n        820\n      ]\n    }\n  },\n  \"prepare_sha256\": \"93beddb1f4bcb85b21ee8fa0290768b2aaa1c41d00387b3dda140a9ead4efb86\",\n  \"build_inputs_sha256\": \"938