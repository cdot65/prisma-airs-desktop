   217	fn wall() -> u32 {
   218	    std::time::SystemTime::now()
   219	        .duration_since(std::time::UNIX_EPOCH)
   220	        .map_or(0, |d| u32::try_from(d.as_secs()).unwrap_or(u32::MAX))
   221	}
   222	
   223	/// A failure that means the client lacks a role, not that the source is down.
   224	fn needs_role(failure: Option<ManagementFailure>) -> bool {
   225	    matches!(
   226	        failure,
   227	        Some(ManagementFailure::Denied | ManagementFailure::Unauthorized)
   228	    )
   229	}
   230	
   231	/// One source of a product's read: its name, whether it was established
   232	/// (answered, and for a listing the whole inventory), and its failure.
   233	type Source = (&'static str, bool, Option<ManagementFailure>);
   234	
   235	fn outcome_of(read_at: u32, sources: &[Source], detail: String) -> ProductOutcome {
   236	    let sources_read = sources.iter().filter(|(_, ok, _)| *ok).count() as u32;
   237	    let failure = sources.iter().find_map(|(_, _, f)| *f);
   238	    ProductOutcome {
   239	        read_at,
   240	        sources_read,
   241	        sources_total: sources.len() as u32,
   242	        missing: sources
   243	            .iter()
   244	            .filter(|(_, ok, _)| !*ok)
   245	            .map(|(name, _, _)| (*name).to_owned())
   246	            .collect(),
   247	        needs_role: sources.iter().any(|(_, _, f)| needs_role(*f)),
   248	        failure,
   249	        detail,
   250	    }
   251	}
   252	
   253	/// A listing establishes its source only when the page is the inventory:
   254	/// a capped count or rows beyond the page leave it unread coverage.
   255	fn listed(complete: Option<bool>) -> bool {
   256	    complete == Some(true)
   257	}
   258	
   259	/// The names of a product's sources (for a read that never reached them).
   260	pub(super) fn source_names(product: ProductId) -> &'static [&'static str] {
   261	    match product {
   262	        ProductId::RuntimeSecurity => &["sessions chart", "API keys"],
   263	        ProductId::Gateway => &["Gateway usage", "Gateway limits"],
   264	        ProductId::RedTeam => &["Red Team statistics", "Red Team scan list"],
   265	        ProductId::ModelSkill => &["model scan list", "skill statistics", "skill scan list"],
   266	    }
   267	}
   268	
   269	fn all_missing(product: ProductId) -> Vec<String> {
   270	    source_names(product)
   271	        .iter()
   272	        .map(|s| (*s).to_owned())
   273	        .collect()
   274	}
