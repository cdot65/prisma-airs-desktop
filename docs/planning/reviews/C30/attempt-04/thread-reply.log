   239	fn source_state(failure: Option<ManagementFailure>) -> ProductReadState {
   240	    match failure {
   241	        None => ProductReadState::Ok,
   242	        Some(ManagementFailure::Denied | ManagementFailure::Unauthorized) => {
   243	            ProductReadState::NeedsRole
   244	        }
   245	        Some(_) => ProductReadState::Failed,
   246	    }
   247	}
   248	
   249	fn pending(product: ProductId) -> ProductRead {
   250	    ProductRead {
   251	        product,
   252	        state: ProductReadState::Pending,
   253	        sources_read: 0,
   254	        sources_total: product_sources(product),
   255	        detail: None,
   256	    }
   257	}
   258	
   259	fn needs_role_failure(failure: Option<ManagementFailure>) -> bool {
   260	    matches!(
   261	        failure,
   262	        Some(ManagementFailure::Denied | ManagementFailure::Unauthorized)
   263	    )
   264	}
   265	
   266	fn combined(needs_role: bool, read_count: u32, total: u32) -> ProductReadState {
   267	    if needs_role {
   268	        ProductReadState::NeedsRole
   269	    } else if read_count == total {
   270	        ProductReadState::Ok
   271	    } else if read_count == 0 {
   272	        ProductReadState::Failed
   273	    } else {
   274	        ProductReadState::Incomplete
   275	    }
   276	}
