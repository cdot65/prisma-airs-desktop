   278	/// A product's finite outcome as its read entry, naming each source it
   279	/// did not establish.
   280	fn product_read(
   281	    product: ProductId,
   282	    o: &ProductOutcome,
   283	    sources_missing: &mut Vec<String>,
   284	) -> ProductRead {
   285	    let state = combined(o.needs_role, o.sources_read, o.sources_total);
   286	    sources_missing.extend(o.missing.iter().cloned());
   287	    ProductRead {
   288	        product,
   289	        state,
   290	        sources_read: o.sources_read,
   291	        sources_total: o.sources_total,
   292	        detail: Some(match (state, o.failure) {
   293	            (ProductReadState::Ok, _) => o.detail.clone(),
   294	            (_, Some(f)) => format!("{f:?}: {}", o.detail),
   295	            (_, None) => o.detail.clone(),
   296	        }),
   297	    }
   298	}
   299	
   300	/// A product whose latest attempt established nothing: its failure, with
   301	/// every source named missing and the retained older read (if any) named.
   302	fn failed_product(
   303	    product: ProductId,
   304	    f: &FailedAttempt,
   305	    kept: Option<&ProductOutcome>,
   306	    sources_missing: &mut Vec<String>,
   307	) -> ProductRead {
   308	    let names = source_names(product);
   309	    sources_missing.extend(names.iter().map(|n| (*n).to_owned()));
   310	    let older = kept.map_or(String::new(), |o| {
   311	        format!("; the read from {} ({}) is kept", o.read_at, o.detail)
   312	    });
   313	    ProductRead {
   314	        product,
   315	        state: if f.needs_role {
   316	            ProductReadState::NeedsRole
   317	        } else {
   318	            ProductReadState::Failed
   319	        },
   320	        sources_read: 0,
   321	        sources_total: names.len() as u32,
   322	        detail: Some(match f.failure {
   323	            Some(failure) => format!("{failure:?}: {}{older}", f.detail),
   324	            None => format!("{}{older}", f.detail),
   325	        }),
   326	    }
   327	}
