   341	    /// Admits a tenant switch, or refuses it while a decision is pending
   342	    /// (I1): the refusal carries the guard the presentation renders.
   343	    pub(super) fn guard_switch(
   344	        &mut self,
   345	        to: &TenantId,
   346	        resolution: Option<SwitchResolution>,
   347	        completion: bool,
   348	    ) -> Result<(), Refusal> {
   349	        let Some(pending) = self.pending_decision() else {
   350	            self.switch_blocked = None;
   351	            return Ok(());
   352	        };
   353	        let id = self.live_bound_harness().ok_or(Refusal::Busy)?;
   354	        match resolution {
   355	            None => {
   356	                self.switch_blocked = Some(SwitchBlocked {
   357	                    to: to.clone(),
   358	                    pending,
   359	                    completion,
   360	                });
   361	                Err(Refusal::DecisionPending)
   362	            }
   363	            Some(SwitchResolution::Archive) => {
   364	                self.end_harness(&id)?;
   365	                self.switch_blocked = None;
   366	                Ok(())
   367	            }
   368	            Some(SwitchResolution::Discard) => {
   369	                self.discard_harness(&id)?;
   370	                self.switch_blocked = None;

