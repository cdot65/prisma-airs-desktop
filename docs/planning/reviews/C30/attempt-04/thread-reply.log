   626	    /// The active tenant's Inbox (I2): overview items with their holds and
   627	    /// the tenant's setup warnings; nothing of another tenant.
   628	    pub(super) fn inbox_view(&self, overview: &OverviewView) -> InboxView {
   629	        let now = self.clock();
   630	        let holds = self.active_holds();
   631	        let mut items = Vec::new();
   632	        let read_at = overview.read.as_ref().map_or(now, |r| r.read_at);
   633	        let hold_of = |item: &InboxItem| -> Option<HoldView> {
   634	            holds.iter().find_map(|h| {
   635	                if h.id != item.id {
   636	                    return None;
   637	                }
   638	                match h.kind {
   639	                    HoldKind::Acknowledge if crate::observation::level(item) <= h.level => {
   640	                        Some(HoldView {
   641	                            kind: HoldKind::Acknowledge,
   642	                            returns_at: None,
   643	                        })
   644	                    }
   645	                    HoldKind::Snooze if now < h.until => Some(HoldView {
   646	                        kind: HoldKind::Snooze,
   647	                        returns_at: Some(h.until),
   648	                    }),
   649	                    _ => None,
   650	                }
   651	            })
   652	        };
   653	        for item in overview.read.iter().flat_map(|r| r.items.iter()) {
   654	            let (kind, product) = if item.id.starts_with("gateway-") {
   655	                (InboxKind::Gateway, Some(ProductId::Gateway))
   656	            } else {
   657	                (InboxKind::Runtime, Some(ProductId::RuntimeSecurity))
   658	            };
   659	            items.push(InboxEntry {
   660	                id: item.id.clone(),
   661	                kind,
   662	                needs_action: item.action,
   663	                severity: item.tone,
   664	                title: item.title.clone(),
   665	                detail: item.detail.clone(),
   666	                source: item.source.clone(),
   667	                product,
   668	                target: Some(item_target(item)),
   669	                action_label: Some(item.action_label.clone()),
   670	                facts: item.facts.clone(),
   671	                when: read_at,
   672	                hold: hold_of(item),
   673	            });
   674	        }
   675	        if let Some(tenant) = self.data.active.as_ref().and_then(|id| self.tenant(id)) {
   676	            for w in &tenant.setup_warnings {
   677	                let item = setup_warning_item(w);
   678	                let (target, label) = warning_target(w.product);
   679	                items.push(InboxEntry {
   680	                    id: w.id.clone(),
   681	                    kind: InboxKind::SetupWarning,
   682	                    needs_action: true,
   683	                    severity: Tone::Warn,
   684	                    title: item.title.clone(),
   685	                    detail: w.reason.clone(),
   686	                    source: item.source.clone(),
   687	                    product: Some(w.product),
   688	                    target: Some(target),
   689	                    action_label: Some(label.to_owned()),
   690	                    facts: item.facts.clone(),
   691	                    when: w.recorded_secs,
   692	                    hold: hold_of(&item),
   693	                });
   694	            }
   695	        }
   696	        InboxView {
   697	            items,
   698	            read: self.read_status(overview),
   699	            last_snooze: self.active_record().and_then(|r| r.last_snooze.clone()),
   700	        }
   701	    }
   702	}

