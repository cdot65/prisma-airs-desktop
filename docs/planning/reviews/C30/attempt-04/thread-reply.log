   151	impl OverviewRecord {
   152	    fn new(tenant: TenantId) -> Self {
   153	        Self {
   154	            tenant,
   155	            read: None,
   156	            failure: None,
   157	            failed_at: None,
   158	            parts: Vec::new(),
   159	            red_team: None,
   160	            model_skill: None,
   161	            red_team_failed: None,
   162	            model_skill_failed: None,
   163	            generation: 0,
   164	            rechecking: None,
   165	            snoozes: 0,
   166	            last_snooze: None,
   167	        }
   168	    }
   169	
   170	    /// Reading: a part admitted under the tenant's current context is
   171	    /// still under way.
   172	    pub(super) fn refreshing(&self, current: Option<&ContextRef>) -> bool {
   173	        self.parts.iter().any(|c| Some(c) == current)
   174	    }
   175	
   176	    /// A product's read settled: an outcome that established at least one
   177	    /// source replaces the retained outcome (and clears any failure); one
   178	    /// that established nothing is kept as the latest failed attempt, the
   179	    /// retained outcome staying shown as older.
   180	    fn settle_product(&mut self, product: ProductId, outcome: ProductOutcome) {
   181	        let (slot, failed) = match product {
   182	            ProductId::RedTeam => (&mut self.red_team, &mut self.red_team_failed),
   183	            ProductId::ModelSkill => (&mut self.model_skill, &mut self.model_skill_failed),
   184	            ProductId::RuntimeSecurity | ProductId::Gateway => return,
   185	        };
   186	        if outcome.sources_read > 0 {
   187	            *slot = Some(outcome);
   188	            *failed = None;
   189	        } else {
   190	            *failed = Some(FailedAttempt {
   191	                at: outcome.read_at,
   192	                needs_role: outcome.needs_role,
   193	                failure: outcome.failure,
   194	                detail: outcome.detail,
   195	            });
   196	        }
   197	    }
   198	
   199	    /// One read part landed under `context`. A current part completes the
   200	    /// read when no current part is left (one generation); a withdrawn
   201	    /// (retired-context) part counts nothing, and a recheck it carried is
   202	    /// simply over once nothing current remains.
   203	    fn part_landed(&mut self, context: &ContextRef, current: Option<&ContextRef>) {
   204	        if let Some(at) = self.parts.iter().position(|c| c == context) {
   205	            self.parts.remove(at);
   206	        }
   207	        if self.refreshing(current) {
   208	            return;
   209	        }
   210	        if Some(context) == current {
   211	            self.generation = self.generation.wrapping_add(1);
   212	        }
   213	        self.rechecking = None;
   214	    }
   215	}
