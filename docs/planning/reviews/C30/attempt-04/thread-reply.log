   766	enum JobResult {
   767	    Listed(Result<Vec<Listed>, HistoryFailure>),
   768	    Opened(Result<Box<Record>, HistoryFailure>),
   769	    Deleted(
   770	        String,
   771	        Result<(), HistoryFailure>,
   772	        Result<Vec<Listed>, HistoryFailure>,
   773	    ),
   774	    Discarded(
   775	        String,
   776	        Result<(), HistoryFailure>,
   777	        Result<Vec<Listed>, HistoryFailure>,
   778	    ),
   779	}
   780	
   781	pub(super) async fn run_job(inner: Arc<Inner>, job: HistoryJob) {
   782	    let vault = Arc::clone(&inner.adapters.keychain);
   783	    let hold = match lock(&inner) {
   784	        Ok(state) => Arc::clone(&state.history_hold),
   785	        Err(_) => return,
   786	    };
   787	    let (lease, scope, result) = tokio::task::spawn_blocking(move || match job {
   788	        HistoryJob::List { lease, scope } => {
   789	            let list = history::list(&*vault, &scope);
   790	            (lease, scope, JobResult::Listed(list))
   791	        }
   792	        HistoryJob::Open { lease, scope, id } => {
   793	            let record = history::read(&*vault, &scope, &id).map(Box::new);
   794	            (lease, scope, JobResult::Opened(record))
   795	        }
   796	        HistoryJob::Delete { lease, scope, id } => {
   797	            let deleted = history::delete(&scope, &id);
   798	            let list = history::list(&*vault, &scope);
   799	            (lease, scope, JobResult::Deleted(id, deleted, list))
   800	        }
   801	        HistoryJob::Discard { scope, id } => {
   802	            // After any save of it under way (the sink holds the same lock
   803	            // while it writes); a record never saved is simply absent.
   804	            let _held = hold.blocking_lock();
   805	            let deleted = history::delete(&scope, &id);
   806	            let list = history::list(&*vault, &scope);
   807	            (0, scope, JobResult::Discarded(id, deleted, list))
   808	        }
   809	    })
   810	    .await
   811	    .expect("history job");
   812	    if let Ok(mut state) = lock(&inner) {
   813	        state.history_done(lease, &scope, result);
   814	    }
   815	}
   816	
   817	/// The sink that saves a conversation after each turn: the scope is noted
   818	/// first, then the record is sealed and replaced, then the list updated.
   819	pub(super) fn sink(inner: &Arc<Inner>, plan: HistoryPlan) -> HistorySink {
   820	    let inner = Arc::clone(inner);
   821	    let HistoryPlan {
   822	        scope,
   823	        id,
   824	        created,
   825	        binding,
   826	        tenant,
   827	        workspace,
   828	    } = plan;
   829	    Arc::new(move |entries: Vec<HarnessEntry>, usage, export: &Replay| {
   830	        let hold = lock(&inner)
   831	            .ok()
   832	            .and_then(|mut state| {
   833	                state
   834	                    .admit_history_write(&tenant, &workspace, &scope, &id)
   835	                    .then(|| Arc::clone(&state.history_hold))
   836	            })
   837	            .ok_or(HistoryFailure::Unavailable)?;
   838	        #[cfg(feature = "test-fixtures")]
   839	        if let Some(gate) = inner.adapters.harness.save_gate.as_ref() {
   840	            // A test may hold the save open here, between admission and the write.
   841	            drop(gate.lock());
   842	        }
   843	        let saved = {
   844	            let _held = hold.blocking_lock();
   845	            // Admission was under the state lock, the write is under the
   846	            // history hold: a discard between the two (its tombstone first,
   847	            // then its removal under this same hold) must win, or the
   848	            // discarded transcript would be written again (C30).
   849	            let discarded = lock(&inner).is_ok_and(|state| state.history_discarded(&scope, &id));
   850	            if discarded {
   851	                Err(HistoryFailure::Unavailable)
   852	            } else {
   853	                save_record(
   854	                    &inner, &scope, &id, created, &binding, entries, usage, export,
   855	                )
   856	            }
   857	        };
   858	        if let Ok(mut state) = lock(&inner) {
   859	            state.history_written(&tenant, &scope);
   860	            if let Ok(record) = &saved {
   861	                state.history_saved(&scope, record);
   862	            }
   863	        }
   864	        // A key settled after its tenant was removed is cleaned up now.
   865	        super::run_effects(&inner, vec![Effect::Cleanup]);
   866	        saved.map(|record| record.updated)
   867	    })
   868	}
   869	
   870	/// Seals and replaces one conversation's record.
   871	#[allow(clippy::too_many_arguments)]
   872	fn save_record(
   873	    inner: &Arc<Inner>,
   874	    scope: &Scope,
   875	    id: &str,
   876	    created: u64,
   877	    binding: &SavedBinding,
   878	    entries: Vec<HarnessEntry>,
   879	    usage: Option<HarnessUsage>,
   880	    export: &Replay,
   881	) -> Result<Record, HistoryFailure> {
   882	    let title = entries
   883	        .iter()
   884	        .find(|e| e.role == HarnessRole::Operator)
   885	        .map(|e| history::title(&e.text))
   886	        .unwrap_or_default();
   887	    let record = Record {
   888	        schema: history::SCHEMA.to_owned(),
   889	        id: id.to_owned(),
   890	        title,
   891	        created,
   892	        updated: now().max(created),
   893	        binding: binding.clone(),
   894	        entries,
   895	        usage,
   896	        context: export.context.clone(),
   897	        replay: export.replay.clone(),
   898	        origin: None,
   899	    };
   900	    history::save(&*inner.adapters.keychain, scope, &record)?;
   901	    Ok(record)
   902	}

