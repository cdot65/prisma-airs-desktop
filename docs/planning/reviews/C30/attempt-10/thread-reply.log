.toml\"},\"inputs\":{\"procedure\":f\"{E}/../hash-inputs.sh\",\"procedure_sha256\":sha(f\"{E}/../hash-inputs.sh\"),\"before_inventory_sha256\":sha(f\"{E}/inputs-before.sha256\"),\"before_digest\":b,\"after_inventory_sha256\":sha(f\"{E}/inputs-after.sha256\"),\"after_digest\":a,\"unchanged\":a==b,\"members\":sum(1 for _ in open(f\"{E}/inputs-before.sha256\"))},\n \"runs\":{}}\nfor n in names:\n    log=f\"{E}/{n}.log\"\n    rec[\"runs\"][n]={\"exit\":int(open(f\"{E}/{n}.exit\").read().strip()),\"log\":log,\"log_sha256\":sha(log),\"summary\":[l.strip() for l in open(log,errors=\"replace\") if l.startswith(\"test result\") or \"Test Files\" in l or \"Tests  \" in l or l.startswith(\"EXIT\")][-4:]}\njson.dump(rec,open(f\"{E}/../run-{attempt}.json\",\"w\"),indent=2)\nprint(json.dumps({k:v[\"exit\"] for k,v in rec[\"runs\"].items()}),\"inputs unchanged:\",a==b,\"members:\",rec[\"inputs\"][\"members\"])\nPY\n$ pnpm --filter @prisma-airs/desktop exec vitest run --config vitest.truth.config.ts\n\n RUN  v3.2.6 /Users/cdot/development/redtail/prisma-airs-desktop-v2-current/apps/desktop\n\nstderr | src/features/academy/learner-bundle.truth.ts > ships no Academy truth, privileged module or unexplained procedure\n../../node_modules/.pnpm/zod@4.6.7/node_modules/zod/v4/core/util.js (400:0): A comment\n\n\"// Wrapped in a `@__PURE__` IIFE: esbuild never tree-shakes a top-level initializer that contains a member access on `Number`, so the bare object literal survived into every bundle.\"\n\nin \"../../node_modules/.pnpm/zod@4.6.7/node_modules/zod/v4/core/util.js\" contains an annotation that Rollup cannot interpret due to the position of the comment. The comment will be removed to avoid issues.\n\nstderr | src/features/academy/learner-bundle.truth.ts > ships no Academy truth, privileged module or unexplained procedure\n../../node_modules/.pnpm/zod@4.6.7/node_modules/zod/v4/core/regexes.js (74:0): A comment\n\n\"/** Anchors a pattern source. The interpolation lives here rather than at 