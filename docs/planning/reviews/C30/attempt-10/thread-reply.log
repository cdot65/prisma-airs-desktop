{"type":"item.completed","item":{"id":"item_13","type":"command_execution","command":"/bin/zsh -lc \"ls docs/planning/reviews/C29/attempt-08; head -40 docs/planning/reviews/C30/attempt-10/source-inventory.json; ls tools/p09; rg --files docs | rg '/(adrs|adr)/'; sed -n '1,140p' tools/p09/review-packet.py\"","aggregated_output":"acceptance.md\ndiff.patch\nfeature-probe.log\ninvocation.json\nmessage.txt\npost-review-audit.json\nreceipt.json\nrequest.json\nsource-inventory.json\nthread-reply.log\nverdict-returned.json\n{\n  \"files\": {\n    \"AGENTS.md\": \"a86646f089dbf6dcae4d67690ebacd22c24e4eab49f99d10baadf047f08aa2e2\",\n    \"GLOSSARY.md\": \"3567b754b55eabcd3bbcd60b87537f7a103cc70a6a3e1460b9d048a518f5db7f\",\n    \"apps/desktop/academy-source.ts\": \"cb85cffc6dc5e4ac30e4e134511b43907bec04007c2cdf13365079900930ac6e\",\n    \"apps/desktop/src-tauri/src/adapters.rs\": \"a86c9d46d765ed0aa1c32dd8417db743047524af7d68f38bf7662f127859ab0c\",\n    \"apps/desktop/src-tauri/src/keychain.rs\": \"94af19e76e20d4190beffe5f6fc36603802ca9467b8bdbb10344c4f5bee19419\",\n    \"apps/desktop/src-tauri/src/lib.rs\": \"d5e9afbfe7ce3f8eb0ff833b8a9267c4576db7bb854e6c799bea9a220ddfac53\",\n    \"apps/desktop/src-tauri/src/main.rs\": \"d91af47cd0e93854998526fe6b0598292f9573bced0cade0e23d2ed20fdf43b2\",\n    \"apps/desktop/src/app.tsx\": \"b41aa5e39f92bde2869e7846a11f38401ad44bc1df37d2937dbc85b36706c7dc\",\n    \"apps/desktop/src/features/tenants/dispatch.ts\": \"aad1fd77a5344a033e246975f3dd461bcc282343170ef6c7f2c83455e83ea437\",\n    \"apps/desktop/src/features/tenants/tenants-settings.tsx\": \"c8f106a6c1b71877107eb3a1522b5c95e28392a78f3024ad75e6039641c4e7ab\",\n    \"apps/desktop/src/shell/feature-body.tsx\": \"69c9c29b004ec1526edc9d1bbad0ca9ff9b64cf62057961ab83fb536c10a02b6\",\n    \"apps/desktop/src/v2/copy.ts\": \"84147711cff74ff1da9c4bd92e4a2c8c3138568fe00c57ee0c36327ff437bf60\",\n    \"apps/desktop/src/v2/fixtures.ts\": \"53b71fa82883442c1a4503f95b9ef37f10da171b4fe4e469f77f3457b8f0f07