{"type":"item.completed","item":{"id":"item_17","type":"command_execution","command":"/bin/zsh -lc 'cat apps/desktop/src/v2/inbox/inbox.tsx'","aggregated_output":"import { forwardRef, useEffect } from 'react'\nimport type { FeatureId, InboxEntry, Intent, ProductId, ShellSnapshot } from '@prisma-airs/desktop-contracts'\nimport type { DispatchOutcome } from '../../features/tenants/dispatch'\nimport { INBOX_COPY as C, READ_COPY, SHELL_COPY, SNOOZE_COPY, clockOf } from '../copy'\nimport { Glyph, type GlyphName } from '../icons'\nimport { useShellStore } from '../store'\nimport type { VerdictTone } from '../verdict'\n\n/**\n * Sends one intent and reports its outcome on the shell's surfaces (DESIGN-V2\n * §7): a refusal or failed delivery as a warn toast naming `what`, an\n * unconfirmed delivery inline with Retry (never replayed on its own).\n */\nexport type Act = (what: string, intent: Intent) => Promise<DispatchOutcome>\n\nexport interface InboxProps {\n    snapshot: ShellSnapshot\n    onAct: Act\n    onNavigate: (feature: FeatureId) => void\n}\n\nexport type InboxTab = 'all' | 'action' | 'updates' | 'snoozed'\nconst TABS: InboxTab[] = ['all', 'action', 'updates', 'snoozed']\n\nexport const toneOf = (severity: InboxEntry['severity']): VerdictTone => (severity === 'bad' ? 'blocked' : severity === 'warn' ? 'flagged' : 'info')\n\n/** Where an entry's action leads (C30): the destination the core names. */\nexport function destinationFeature(entry: InboxEntry): FeatureId | null {\n    return entry.target?.feature ?? null\n}\n\n/**\n * Follows an entry's contextual action: the target's inventory and item are\n * handed to the destination (it selects them on arrival), then the shell\n * navigates through the core.\n */\nexport function follow(entry: InboxEntry, tenant: string, onNavigate: (feature: FeatureId) => void) {\n    const target = entry.target\n    if (!target) return\n    // The target belongs to the tenant it was followed in (I2): another tenant never inherits it.\n    useShellStore.getState().arrive({ tenant, feature: target.feature, resource: target.resource, item: target.item })\n    onNavigate(target.feature)\n}\n\n/** The tenant-named description of a hold action, for its outcome report. */\nexport function holdWhat(kind: 'acknowledgeItem' | 'snoozeItem' | 'unsnoozeItem', title: string): string {\n    return kind === 'acknowledgeItem' ? SHELL_COPY.acknowledgmentOf(title) : kind === 'snoozeItem' ? SHELL_COPY.snoozeOf(title) : SHELL_COPY.unsnoozeOf(title)\n}\n\n/** Which tab an entry belongs to; held entries are never \"needs action\". */\nexport function tabOf(entry: InboxEntry): InboxTab {\n    if (entry.hold?.kind === 'snooze') return 'snoozed'\n    if (entry.needsAction && !entry.hold) return 'action'\n    return 'updates'\n}\n\nconst severityTile = (severity: InboxEntry['severity']): { glyph: GlyphName; fg: string; bg: string } =>\n    severity === 'bad' ? { glyph: 'ban', fg: 'var(--v2-block)', bg: 'var(--v2-block-bg)' } : severity === 'warn' ? { glyph: 'alert', fg: 'var(--v2-flag)', bg: 'var(--v2-flag-bg)' } : { glyph: 'info', fg: 'var(--v2-soft)', bg: 'var(--v2-inset)' }\n\nconst button32 = 'flex h-8 min-h-0 items-center rounded-[7px] text-[13px] whitespace-nowrap'\n\n/**\n * The Inbox (C30, screens/inbox-reads.md): the active tenant's entries from\n * the core's Inbox scope, in tabs with counts, a detail pane with the facts,\n * the explanation and the contextual actions. Acknowledge and snooze are\n * core intents on the entry; the snooze return time is the core's and the\n * label is the one Home uses (I11). The selected tab and item are kept per\n * tenant across a switch (I2) and cleared when the tenant is deleted.\n */\nexport const Inbox = forwardRef<HTMLHeadingElement, InboxProps>(function Inbox({ snapshot, onAct, onNavigate }, ref) {\n    const tenant = snapshot.tenants.find((t) => t.id === snapshot.active?.tenant) ?? null\n    const context = snapshot.active?.context ?? null\n    const tenantKey = tenant?.id ?? 'none'\n    const selection = useShellStore((s) => s.inboxSelection[tenantKey])\n    const selectInbox = useShellStore((s) => s.selectInbox)\n    const tab: InboxTab = selection?.tab ?? 'all'\n    const selectedId = selection?.item ?? null\n    const items = snapshot.inbox.items\n    const counts: Record<InboxTab, number> = { all: items.length, action: 0, updates: 0, snoozed: 0 }\n    for (const e of items) counts[tabOf(e)] += 1\n    const visible = items.filter((e) => tab === 'all' || tabOf(e) === tab)\n    const selected = items.find((e) => e.id === selectedId) ?? null\n    useEffect(() => {\n        if (selectedId && !items.some((e) => e.id === selectedId)) selectInbox(tenantKey, { tab, item: null })\n    }, [items, selectedId, selectInbox, tenantKey, tab])\n    const read = snapshot.inbox.read\n\n    // Holds are core intents; their outcomes reach the shell's surfaces. A\n    // snooze's return time is the core's: the shell announces it from the\n    // receipt the snapshot carries (the same toast whether asked here or on Home).\n    const act = (entry: InboxEntry, kind: 'acknowledgeItem' | 'snoozeItem' | 'unsnoozeItem') => context && void onAct(holdWhat(kind, entry.title), { kind, context, id: entry.id })\n    const readNow = () => context && tenant && void onAct(SHELL_COPY.readOf(tenant.label), { kind: 'readTenant', context })\n\n    // Never attempted, in progress, failed, partial, expired and healthy-empty\n    // reads stay distinct (I4, C12). Entries the core supplies (a setup\n    // warning before any read) are listed whatever the read status.\n    const failedUnread = read.state === 'failed' && read.lastReadAt === null && read.failedAt !== null\n    const stale = (read.state === 'done' || read.state === 'reading') && read.lastReadAt !== null && !snapshot.overview.fresh\n    const readingAgain = read.state === 'reading' && read.lastReadAt !== null\n    const empty = !tenant\n        ? C.emptyPending\n        : items.length === 0 && read.state === 'reading'\n          ? C.emptyReading\n          : items.length === 0 && read.state === 'pending'\n            ? C.emptyPending\n            : items.length === 0 && failedUnread\n              ? C.emptyFailed(clockOf(read.failedAt ?? 0))\n              : items.length === 0 && read.lastReadAt === null && read.settledAt !== null\n                ? C.emptyUnread(clockOf(read.settledAt), read.sourcesMissing.length)\n                : visible.length === 0\n                  ? tab === 'all' || tab === 'action'\n                      ? read.sourcesMissing.length > 0\n                          ? C.emptyPartial(read.products.reduce((n, p) => n + p.sourcesRead, 0), read.products.reduce((n, p) => n + p.sourcesTotal, 0), read.sourcesMissing)\n                          : stale\n                            ? C.emptyStale(clockOf(read.lastReadAt ?? 0))\n                            : C.emptyClear\n                      : C.emptyTab\n                  : null\n    const partialLine =\n        read.state === 'failed' && read.failedAt !== null && read.lastReadAt !== null\n            ? C.failedKept(clockOf(read.failedAt), clockOf(read.lastReadAt))\n            : (read.lastReadAt ?? read.settledAt) !== null && read.sourcesMissing.length > 0\n              ? C.partial(read.products.reduce((n, p) => n + p.sourcesRead, 0), read.products.reduce((n, p) => n + p.sourcesTotal, 0), clockOf(read.lastReadAt ?? read.settledAt ?? 0))\n              : readingAgain\n                ? stale\n                    ? C.readingStale(clockOf(read.lastReadAt ?? 0))\n                    : C.readingKept(clockOf(read.lastReadAt ?? 0))\n                : stale\n                  ? C.stale(clockOf(read.lastReadAt ?? 0))\n                  : null\n\n    // The empty states' role issue, the footer's coverage lines and the product hand-off (C37, R2App).\n    const needsRole = read.products.find((p) => p.state === 'needsRole') ?? null\n    const openProduct = (id: ProductId) => {\n        if (tenant) useShellStore.getState().arrive({ tenant: tenant.id, feature: 'administration', resource: null, item: null, product: id })\n        onNavigate('administration')\n    }\n    const sourcesRead = read.products.reduce((n, p) => n + p.sourcesRead, 0)\n    const sourcesTotal = read.products.reduce((n, p) => n + p.sourcesTotal, 0)\n    const readAt = read.lastReadAt ?? read.settledAt\n    const footLine1 = !tenant || readAt === null ? C.footNoReads(tenant?.label ?? '') : read.sourcesMissing.length > 0 ? C.footPartial(sourcesRead, sourcesTotal, clockOf(readAt)) : C.footAll(clockOf(readAt))\n    const gateway = snapshot.overview.read?.gateway ?? null\n    const footLine2 = gateway ? C.footGateway(gateway.workspaceName, gateway.policies) : (snapshot.overview.read?.gaps[0] ?? '')\n\n    return (\n        <section aria-labelledby='inbox-heading' data-slot='inbox' className='flex min-h-0 flex-grow flex-col' style={{ gap: 20 }}>\n            <div className='flex items-end' style={{ gap: 12 }}>\n                <div>\n                    <h1 ref={ref} id='inbox-heading' tabIndex={-1} className='font-bold' style={{ fontSize: 'var(--v2-title)', letterSpacing: '-0.01em' }}>\n                        {C.title}\n                    </h1>\n                    <p role='status' data-slot='inbox-sub' className='text-[14px]' style={{ marginTop: 4, color: 'var(--v2-soft)' }}>\n                        {tenant ? C.sub(tenant.label) : C.emptyPending}\n                        {partialLine ? ` · ${partialLine}` : ''}\n                    </p>\n                </div>\n                {context && (\n                    <button type='button' onClick={readNow} disabled={read.state === 'reading'} className={`${button32} ml-auto border px-3.5 disabled:opacity-60`} style={{ borderColor: 'var(--v2-rule)', background: 'var(--v2-paper)', color: 'var(--v2-ink)' }}>\n                        {read.state === 'reading' ? C.reading : C.readNow}\n                    </button>\n                )}\n            </div>\n            {/* The list column is the prototype's 430px beside the detail; one under the other when both cannot fit (200% zoom, a narrow window). */}\n            <div data-slot='inbox-columns' className='grid min-h-0 min-w-0 flex-grow' style={{ gridTemplateColumns: 'minmax(0, 430px) minmax(0, 1fr)', gap: 20 }}>\n                <section aria-label={C.listCard} data-slot='inbox-list' className='flex min-h-0 min-w-0 flex-col overflow-hidden rounded-[12px] border' style={{ borderColor: 'var(--v2-rule)', background: 'var(--v2-paper)' }}>\n                    <div className='flex items-center' style={{ padding: '14px 18px', gap: 10, borderBottom: '1px solid var(--v2-rule)' }}>\n                        <div role='tablist' aria-label={C.filter} className='flex rounded-[8px]' style={{ padding: 2, background: 'var(--v2-inset)' }}>\n                            {TABS.map((t) => (\n                                <button\n                                    key={t}\n                                    role='tab'\n                                    type='button'\n                                    id={`itab-${t}`}\n                                    aria-controls='inbox-panel'\n                                    aria-selected={tab === t}\n                                    onClick={() => selectInbox(tenantKey, { tab: t, item: selectedId })}\n                                    className='h-7 min-h-0 rounded-[6px] px-3 text-[12px] font-semibold'\n                                    style={{ background: tab === t ? 'var(--v2-paper)' : 'transparent', boxShadow: tab === t ? '0 1px 2px rgba(0,0,0,0.12)' : 'none', color: 'var(--v2-ink)' }}\n                                >\n                                    {C.tabs[t]}{' '}\n                                    <span className='font-medium' style={{ color: 'var(--v2-faint)' }}>\n                                        {counts[t]}\n                                    </span>\n                                </button>\n                            ))}\n                        </div>\n                    </div>\n                    <div role='tabpanel' id='inbox-panel' aria-labelledby={`itab-${tab}`} className='min-h-0 flex-grow overflow-auto'>\n                        {empty ? (\n                            <div role='status' data-slot='inbox-empty' className='flex flex-col items-center text-center leading-[1.5]' style={{ gap: 12, padding: '32px 18px', color: 'var(--v2-faint)' }}>\n                                <span>{empty}</span>\n                                {needsRole && context && (\n                                    <button type='button' onClick={() => openProduct(needsRole.product)} className={`${button32} border px-3.5 font-semibold`} style={{ borderColor: 'var(--v2-flag)', background: 'var(--v2-flag-bg)', color: 'var(--v2-flag)' }}>\n                                        {C.openRoleIssue}\n                                    </button>\n                                )}\n                            </div>\n                        ) : (\n                            <ul aria-label={C.ariaList} className='flex flex-col'>\n                                {visible.map((e) => {\n                                    const tile = severityTile(e.severity)\n                                    const current = selected?.id === e.id\n                                    return (\n                                        <li key={e.id}>\n                                            <button\n                                                type='button'\n                                                aria-current={current ? 'true' : undefined}\n                                                data-inset-focus=''\n                                                onClick={() => selectInbox(tenantKey, { tab, item: e.id })}\n                                                className='flex w-full min-w-0 items-start text-left'\n                                                style={{ gap: 10, padding: '14px 18px', borderBottom: '1px solid var(--v2-rule)', background: current ? 'var(--v2-inset)' : 'transparent', boxShadow: current ? 'inset 3px 0 0 var(--v2-acc)' : 'none', color: 'var(--v2-ink)' }}\n                                            >\n                                                <span aria-hidden='true' className='grid size-[26px] shrink-0 place-items-center rounded-[7px]' style={{ background: tile.bg, color: tile.fg }}>\n                                                    <Glyph name={tile.glyph} size={13} stroke={2} />\n                                                </span>\n                                                <span className='min-w-0 flex-grow'>\n                                                    <span className='block font-semibold [overflow-wrap:anywhere]'>{e.title}</span>\n                                                    <span className='text-[12px]' style={{ color: 'var(--v2-faint)' }}>\n                                                        {/* The severity is a word as well as a colour and an icon (I9). */}\n                                                        <span data-slot='severity' className='font-semibold' style={{ color: tile.fg }}>\n                                                            {C.severity[e.severity]}\n                                                        </span>\n                                                        {' · '}\n                                                        {e.product ? READ_COPY.products[e.product] : C.kind[e.kind]} · {e.source}\n                                                        {e.hold?.kind === 'snooze' && e.hold.returnsAt !== null ? ` · ${SNOOZE_COPY.returns(e.hold.returnsAt)}` : ''}\n                                                    </span>\n                                                    {e.hold?.kind === 'acknowledge' && (\n                                                        <span className='ml-2 inline-flex items-center gap-1 text-[12px] font-semibold' style={{ color: 'var(--v2-ok)' }}>\n                                                            <Glyph name='check' size={11} stroke={2.6} />\n                                                            {C.acknowledged}\n                                                        </span>\n                                                    )}\n                                                </span>\n                                                <span className='text-[12px]' style={{ color: 'var(--v2-faint)' }}>\n                                                    {clockOf(e.when)}\n                                                </span>\n                                            </button>\n                                        </li>\n                                    )\n                                })}\n                            </ul>\n                        )}\n                    </div>\n                    <div data-slot='inbox-foot' className='text-[12px] leading-[1.6]' style={{ padding: '14px 18px', borderTop: '1px solid var(--v2-rule)', color: 'var(--v2-faint)' }}>\n                        <span>{footLine1}</span>\n                        <br />\n                        <span>{footLine2}</span>\n                    </div>\n                </section>\n                <aside aria-label={C.detail} data-slot='inbox-detail' className='flex min-w-0 flex-col rounded-[12px] border break-words' style={{ padding: '28px 30px', gap: 18, borderColor: 'var(--v2-rule)', background: 'var(--v2-paper)' }}>\n                    {!selected ? (\n                        <div className='flex flex-grow flex-col items-center justify-center text-center leading-[1.5]' style={{ gap: 12, color: 'var(--v2-faint)' }}>\n                            <span>{empty ?? C.selectHint}</span>\n                        </div>\n                    ) : (\n                        <>\n                            <div className='flex items-center' style={{ gap: 10 }}>\n                                <span aria-hidden='true' className='grid size-[34px] place-items-center rounded-[9px]' style={{ background: severityTile(selected.severity).bg, color: severityTile(selected.severity).fg }}>\n                                    <Glyph name={severityTile(selected.severity).glyph} size={17} stroke={2} />\n                                </span>\n                                <span className='rounded-full text-[12px] font-semibold' style={{ padding: '2px 9px', background: severityTile(selected.severity).bg, color: severityTile(selected.severity).fg }}>\n                                    {C.severity[selected.severity]}\n                                </span>\n                                <span style={{ color: 'var(--v2-faint)' }}>\n                                    {selected.product ? READ_COPY.products[selected.product] : C.kind[selected.kind]} · {selected.source}\n                                </span>\n                            </div>\n                            <h2 className='min-w-0 text-[22px] font-bold' style={{ letterSpacing: '-0.01em' }}>\n                                {selected.title}\n                            </h2>\n                            <p className='text-[14px] leading-[1.55]' style={{ color: 'var(--v2-soft)' }}>\n                                {selected.detail}\n                            </p>\n                            {selected.facts.length > 0 && (\n                                <dl aria-label={C.facts} className='grid' style={{ gridTemplateColumns: 'repeat(3, minmax(0, 1fr))', gap: 10 }}>\n                                    {selected.facts.map((f) => (\n                                        <div key={f.label} className='rounded-[10px]' style={{ padding: '12px 14px', background: 'var(--v2-inset)' }}>\n                                            <dt className='text-[12px]' style={{ color: 'var(--v2-faint)' }}>\n                                                {f.label}\n                                            </dt>\n                                            <dd className='font-semibold' style={{ marginTop: 2 }}>\n                                                {f.value}\n                                            </dd>\n                                        </div>\n                                    ))}\n                                </dl>\n                            )}\n                            {snapshot.showCalls && (\n                                <div data-slot='inbox-why' className='flex gap-2 rounded-[10px] text-[13px] leading-[1.45]' style={{ padding: '12px 14px', background: 'var(--v2-acc-soft)', maxWidth: 860 }}>\n                                    <Glyph name='info' size={15} stroke={2} color='var(--v2-acc)' className='mt-px' />\n                                    <span>\n                                        <span className='font-semibold'>{C.why}: </span>\n                                        {C.whyText[selected.kind]}\n                                    </span>\n                                </div>\n                            )}\n                            {selected.hold?.kind === 'snooze' && selected.hold.returnsAt !== null && (\n                                <p data-slot='snooze-returns' className='text-[12px]' style={{ color: 'var(--v2-soft)' }}>\n                                    {SNOOZE_COPY.returns(selected.hold.returnsAt)}\n                                </p>\n                            )}\n                            <div className='flex flex-wrap' style={{ gap: 8, marginTop: 'auto' }}>\n                                {destinationFeature(selected) && selected.actionLabel && (\n                                    <button type='button' onClick={() => tenant && follow(selected, tenant.id, onNavigate)} className={`${button32} px-[18px] font-semibold`} style={{ background: 'var(--v2-acc)', color: 'var(--v2-acc-ink)' }}>\n                                        {selected.actionLabel}\n                                    </button>\n                                )}\n                                {selected.hold?.kind === 'acknowledge' ? (\n                                    <button type='button' aria-pressed='true' onClick={() => void act(selected, 'unsnoozeItem')} className={`${button32} border px-3.5`} style={{ borderColor: 'var(--v2-rule)', background: 'var(--v2-paper)', color: 'var(--v2-ink)' }}>\n                                        {C.needsAction}\n                                    </button>\n                                ) : (\n                                    <button type='button' aria-pressed='false' onClick={() => void act(selected, 'acknowledgeItem')} className={`${button32} border px-3.5`} style={{ borderColor: 'var(--v2-rule)', background: 'var(--v2-paper)', color: 'var(--v2-ink)' }}>\n                                        {C.acknowledge}\n                                    </button>\n                                )}\n                                {selected.hold?.kind === 'snooze' ? (\n                                    <button type='button' onClick={() => void act(selected, 'unsnoozeItem')} className={`${button32} border px-3.5`} style={{ borderColor: 'var(--v2-rule)', background: 'var(--v2-paper)', color: 'var(--v2-ink)' }}>\n                                        {C.unsnooze}\n                                    </button>\n                                ) : (\n                                    <button type='button' title={SNOOZE_COPY.offer} aria-label={`${SNOOZE_COPY.offer}: ${selected.title}`} onClick={() => void act(selected, 'snoozeItem')} className={`${button32} border px-3.5`} style={{ borderColor: 'var(--v2-rule)', background: 'var(--v2-paper)', color: 'var(--v2-ink)' }}>\n                                        {SNOOZE_COPY.offer}\n                                    </button>\n                                )}\n                            </div>\n                        </>\n                    )}\n                </aside>\n            </div>\n        </section>\n    )\n})\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_18","type":"command_execution","command":"/bin/zsh -lc 'cat docs/adr/0001-native-operation-authority.md docs/adr/0002-academy-shared-presentation.md docs/adr/0003-native-harness-and-scoped-identity.md docs/adr/0004-managed-workbench-admission.md'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_18","type":"command_execution","command":"/bin/zsh -lc 'cat docs/adr/0001-native-operation-authority.md docs/adr/0002-academy-shared-presentation.md docs/adr/0003-native-harness-and-scoped-identity.md docs/adr/0004-managed-workbench-admission.md'","aggregated_output":"# 1. Native operation authority owns coordination\n\nDate: 2026-10-16. Status: selected following owner candidate selection; independent G01 verdict\nand implementation readiness are tracked in planning/status.md. Implements D008,D009,D013,D014,D016,D019.\n\nV1 already has deep domain/request modules, but GPUI callers still coordinate\nslots, protected-key IO and ordered effects. React must not inherit that authority.\n\nChoose a principal-bound Rust actor with dispatch(Intent) and observe(ViewScope).\nKeep feature transitions domain-owned inside one initial core crate. Native\nbootstrap injects adapters and creates operator/Harness handles; JSON cannot\nselect the caller principal. Finite domain instructions exclude arbitrary SDK\nmethod strings and any Harness Apply capability.\n\nThe interface includes atomic admission/context retirement, per-source supersession,\nseparate read/review/write/stream domains, priority/deadline/rate-limit semantics,\nbounded queues, bounded delivery-sequence deduplication with safe session rotation,\nsingle-use settlement and truthful Remote outcome. No remote IO\nor blocking vault call occurs while the authoritative transition is locked.\nAdmitted work runs on the host's one async runtime; native adapters execute effects.\n\nReact owns raw editor text/undo. Rust owns immutable captured drafts/reviews.\nReview/Apply/Save/Send capture fresh input in their actual production handlers;\nApply compares fresh input with the stored reviewed operation and executes only\nthat stored operation. Invalid/lossy input, changed context/draft/resource or a\nconsumed review refuses dispatch. Never rely only on a debounced revision.\nRequestApply uses a native operator confirmation; actual Apply completion is\nprivate, single-use and revalidated after the modal editor/context lease.\nEvery scoped intent/observation carries native-issued context and principal\nadmission. Async vault completions are generation/lease-bound; obsolete writes\nreceive orphan cleanup rather than reactivating credentials. Explicit one-time\nsecret reveal/copy stays in a scoped transient native dialog, never snapshots.\n\nAlternatives considered under the design-it-twice skill:\n\n| Design | Depth/locality | Cost |\n|---|---|---|\n| Actor dispatch/observe | Callers learn one authority seam; context and settlement stay together | Finite unions and observation backpressure need discipline |\n| Typed scoped handles | Strong domain methods and revoked scopes; flexible internal composition | More handles/methods and IPC registries for callers to coordinate |\n| Task-oriented scan board | Trivial first scan workflow | Public task surface grows across all parity features |\n\nRecommend the actor with domain-specific types and a small generated presentation\nfacade. Retain the alternatives' explicit scoped validation and effortless scan\nusage internally. Do not combine all their public surfaces or add pass-through\nmodules merely to obtain two method names.\n\nTwo real execution adapters (SDK/scripted), storage adapters (Keychain/session/\nfault-injectable) and clocks justify internal seams. The interface is the test\nsurface: switch/replace/cancel while queued/dispatched, old/duplicate reply,\nfresh-input races, double Apply, denied Harness Apply, unknown outcome/no replay,\npriority/deadline/rate-limit containment and observation resynchronization.\n\nSee [selected design](../architecture/DESIGN.md) for ownership/wire details.\nNo app code has been written and no native/SDK test is claimed by this ADR.\n# 2. Share Academy presentation through explicit composition\n\nDate: 2026-10-16. Status: selected following owner candidate selection; independent G01 verdict\nand implementation readiness are tracked in planning/status.md. Implements D004,D005,D006,D007,D010.\n\nThe current UI package re-exports web app source. Shell palette/mobile navigation\nand theme persistence require tRPC/Clerk/router context; the authenticated web\nentry also starts learner and manager behavior. A whole-app import would spread\nthat authority into unrelated desktop features.\n\nKeep one Academy-owned presentation implementation. Create explicit provider-free\ncontrols/theme/shell exports while preserving the existing tooling entry. Both\nAcademy web and desktop consume the extracted source. Composition adapters supply\nbrand/navigation/account/header/palette/mobile slots; the shared module owns\nvisual semantics, responsive layout and focus. No universal plugin framework.\n\nDesktop global theme is an app preference stored through Rust, not hosted\nsettings.update. Academy web keeps its learner-account theme behavior. Learner\nnotifications, gamification and account effects mount only in Academy composition.\n\nExtract learner views separately when C05/C06 require them. Retain React Query/\ntRPC hooks behind a transport/navigation provider; type-only learner contracts\nbuild without the Express/DB runtime. Web uses existing HTTP authentication;\ndesktop uses a terminating link into the allowlisted Rust Academy transport.\nTokens stay native. Hosted learning/access/grading/award truth and client-safe\nbundle/draft contracts remain authoritative. Never bundle raw answer content.\n\nDirectly embedding the authenticated web root is rejected because its interface\ncontains unrelated account/manager assumptions. Maintaining a desktop UI copy\nis rejected because appearance and learner behavior would diverge.\n\nTests render shared presentation without hosted identity/query providers, run\nboth consumers' regressions, verify native keyboard/focus/themes, and prove no\nlearner mutation/gamification effect from general desktop screens. Learner tests\ncover native link envelopes/allowlist, account cache retirement and hosted authority.\n\nDependency/source/license pins are extraction prerequisites. This ADR changes\nno Academy checkout, package or hosted registration. See\n[selected design](../architecture/DESIGN.md).\n# 3. Retain native Harness and own scoped identity in Rust\n\nDate: 2026-10-16. Status: selected following owner candidate selection; independent G01 verdict\nand implementation readiness are tracked in planning/status.md. Implements D010,D011,D014–D016,D021–D023.\n\nDesktop-server is already a Rust engine. V1 host workers and its package manifest\nstill require Node/managed CLI. Preserve engine depth and replace those host\nrequirements, rather than rewrite the agent. Source inspection alone does not\nestablish that a newly sealed installed bundle works without the old resources.\n\nNative lifecycle owns sealed executable selection, bounded stdin bootstrap,\nprotocol supervision, process cleanup, scoped grants and protected history.\nReact only presents lifecycle state. Grant/tenant/project changes retire the\nrun; approvals bind actual call items. Preserve existing project/process/tool\nrestrictions, Gateway-only inference/MCP and no engine Apply.\n\nIdentity shares native discovery/HTTP/validation/storage mechanics while retaining\nAcademy learner, Harness inference and MCP grant policies. They are distinct\nidentities with distinct sign-out/refresh/context effects. Use public-client\nPKCE/device flows and a no-redirect native transport; never embed a client secret\nor trust renderer-selected issuer/token destinations.\n\nHost signature/JWKS validation is a deliberate stricter v2 requirement; v1\nomitted it. Validate ID/access token types according to their actual contracts,\nnot by decoding arbitrary JWT claims. Rotation/expiry/sleep/revocation fail closed.\nSame-identity token refresh restarts the one-shot-bootstrap engine and restores\ncompatible in-session history; it re-confirms workspace-write permission and\nnever replays remote/tool effects. Declining workspace-write confirmation keeps\nthe draft/cancels Send without restart. Any changed ContextBinding (including\nlocal access/model/configuration/MCP inventory) starts a new conversation; its\nold history is inspect-only under the new binding. MCP-only token rotation also\nrebootstraps/restores an identical binding, but retains working v1's current\nproject-access confirmation without an SSO refresh or another write prompt.\nNative scope additionally binds per-server MCP grant IDs/catalog revisions absent\nfrom engine equality; re-sign-in/sign-out/removal/revision change retires the\nconversation. Expiry alone leaves inference usable with that non-required server\nunavailable and native calls denied. This continuity is distinct from inspect-only\nimported history. No token or refresh credential enters React, diagnostics, process arguments or\ninherited environment. One-time operator-entered inputs remain transient.\n\nUse independent v2 bundle/data/Keychain namespaces. Protected work is encrypted\nand account/context-scoped; no plaintext fallback. Reviewed import creates a new\nv2 data generation, never modifies v1, transfers no credentials/approvals and\nretains a restartable receipt/rollback generation. Historical conversations are\ninspect-only until fresh-context compatibility is qualified.\n\nTests cross native process and identity interfaces: malformed/oversized bootstrap,\nqueue pressure, wrong context, crash/EOF/graceful and forced cleanup, signature/\nissuer/audience/key-rotation rejection, scoped sign-out, protected histories and\nNode-free installed inventory. Native/live/final signed-byte proof remain separate.\nSee [selected design](../architecture/DESIGN.md) for identity/crypto proposals.\n# 4. Managed HTTP enters native configuration authority\n\nDate: 2026-10-16. Status: selected following owner candidate selection; independent G01 verdict\nand implementation readiness are tracked in planning/status.md. Implements D014,D016 and C14/C15 requirements.\n\nV1's workbench has real request-document and transport depth. Its redactions-based\nredirect guard is not explicit tenant-credential classification, Live mode lacks\napplication destination binding, and its post-401 retry can resend a mutation.\nThe stricter v2 review/no-replay policy must be enforced below every Send path.\n\nKeep RequestDocument reconciliation separate. Native execution admission captures\na fresh immutable effective request and explicitly distinguishes tenant-managed,\nworkbench-owned and anonymous credentials. Known managed reads need capability/\ndestination admission. Known mutations need exact Configuration review. Unknown\nmanaged methods/paths are denied, even if presented as a read or generic draft.\nOrdinary workbench-owned/anonymous HTTP remains supported.\n\nReplace the editable SCM collection-ID credential gate with native-owned\ncapability registration. Imported IDs/references cannot authorize tenant secret\nresolution. An edited token_url/request URL is admitted against the explicit\ncredential destination before secrets are obtained; an ID change never creates\na capability. Preserve operator-reviewed endpoint configuration separately.\n\nBind review to expanded URL/method/headers/body and file hashes, variables,\ncookies, credential/context/destination and resource classification. Recheck\nbefore dispatch; changed input/context/files require fresh review. Rust constructs\nthe actual request; renderer fields cannot mark it preapproved.\n\nManaged redirects are disabled initially: a 3xx is shown, and following it is a\nnew prepared/admitted request. Generic redirects preserve bounded cookie/credential\norigin policy. No automatic workbench resend follows HTTP401, refresh, reconnect,\nlost response, import or history replay. Refresh can precede a new explicit Send.\n\nThe built-in catalogue has 193 request specifications, 81 with mutation methods;\nthis is metadata parity, not a claim of dedicated/live-qualified product support.\nTests cover imported/edited requests, unknown managed endpoints, direct IPC bypass,\nambiguous paths/auth headers, same/cross-origin redirects, stale cookie/file/\nvariable/context bindings, double Apply and post-401/lost-response no resend.\n\nThis is a stricter v2 product contract, not an allegation that v1 failed its own\ncontract. See [selected design](../architecture/DESIGN.md).\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_19","type":"command_execution","command":"/bin/zsh -lc \"rg 'P3[3-8]|P20|P11' docs/architecture/ui-v2/provenance.md; sed -n '500,640p' docs/planning/decisions.md; cat docs/planning/parity-matrix.md\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_19","type":"command_execution","command":"/bin/zsh -lc \"rg 'P3[3-8]|P20|P11' docs/architecture/ui-v2/provenance.md; sed -n '500,640p' docs/planning/decisions.md; cat docs/planning/parity-matrix.md\"","aggregated_output":"| P11 | Home snooze button hard-codes \"Snooze 24 hours\" | Item-specific `snoozeLabel` shared by Home and Inbox | Round 16 finding; invariant I11 |\n| P20 | Key rotation issues a new key with a 24-hour grace period, a later revocation and a secret recoverable from the Keychain (`REVIEWS.key`, `keyRotated/keySecretClosed/keyDeployed/keyDoneAt`) | Two admitted operations in sequence: `ApiKeys · Version` (additional key, one-time reveal through the existing `RevealSecret` host sheet, never persisted) → local deployment acknowledgement → `ApiKeys · Delete` of the old key with readback. Two distinct timestamps; a lost secret means \"issue another key\" | `changes.rs` 842–846 and `management.rs` 980–988 define Rotate (regenerate, no grace) and Version (additional key); DESIGN.md \"Secrets\" forbids persisting issued keys |\n| P33 | `ReadStatus` as its own core scope with per-product states from dedicated reads | `readTenant` admits one finite read per chosen product through the existing management pipeline: the Runtime overview the shell already owns (sessions chart, key inventory, the chosen Gateway workspace's usage and limits), the Red Team statistics and scan list (C13's read), the model scans, skill statistics and skill scans (C13's read); each settles into the tenant's read record as a per-source outcome (read, needs a role, failed); a source counts as read only when it established what it is for: a listing whose page is the inventory (not capped, nothing beyond the first page), a sessions chart with consistent totals, a key page with every expiration reported, Gateway usage with the day's requests and errors both known; anything less is named in `sourcesMissing` (the same gaps the Inbox shows). A product attempt that established nothing (every source failed, or the read never reached the service) is kept as the latest failed attempt beside the product's last outcome that did, which stays shown as older; the read is failed while such an attempt is the latest (a missing role is a settled attempt reported on the product, not a failed read). Once anything was attempted, every chosen source nothing has reached yet is named as unread coverage too, and `settledAt` carries the time of the latest attempt so a completion that established nothing is announced for when it settled, never as a first read still pending. A healthy empty read older than the ten-minute window (`OverviewView.fresh`, C12) is a gap: Home and the Inbox keep the cached read and name its age instead of an all-clear, never re-reading on their own; a refresh in progress keeps that read and its age named until the new read lands (admission restores nothing). A chosen Gateway with no workspace is unread coverage, named in `sourcesMissing`; `recheckProduct` re-reads one chosen product. The read completes (one generation) when every part admitted under the tenant's current context has landed; a read in which no source answered is a failed read (`failed`, with `failedAt`), never pending and never done, and a failed refresh keeps the earlier read labelled as older | No second read pipeline, and Home never claims coverage a read did not establish (I4): revised after the C30 attempt-01 review, which found selected Red Team and model/skill products left unread and a workspace-less Gateway announced as complete |\n| P34 | Inbox items with `kind`, `severity` and `explanation` per item | `InboxEntry` carries the overview item (Runtime, Gateway) or the C29 setup warning with its hold (listed, with every action, whatever the read status: a warning exists before any read); the explanation is per kind in the presentation's copy, not invented per item; `deadline` is absent (P20). Its action carries an `InboxTarget` (destination, product, Administration inventory, item name): a key item opens Administration on the API keys inventory filtered to the key, a setup warning opens where it is fixed (Settings for the scan key or management client, AI Gateway, AI Red Teaming) | The admitted reads report no per-item explanation or deadline; the target was added after the attempt-01 review found actions landing on the destination's default view |\n| P35 | Guard offers \"Archive and switch\" / \"Discard and switch\" | Archive ends the conversation (its protected history stays as C20 saved it); Discard ends it, removes its protected history record (after any save under way, under the same lock the sink holds) and refuses every later save of it (the turn the stop cuts short), then drops it once its task returns; both then switch once; the pending approval is never decided for the operator; the dialog's initial focus is Stay, the safe default (Enter on arrival ends nothing). A save admitted before the discard (the turn the engine's end cut short) re-checks the tombstone under the history hold before it writes, so it can never write the discarded transcript back after the removal. A removal that fails (storage unavailable, access denied) is never implied to have succeeded: the record stays listed and the workspace's history reports the failure, through unrelated opens and removals, until the operator removes the record | The engine is stopped either way: a switch retires its binding (C20); the difference is whether the transcript is kept, which the dialog promises and the attempt-01 review found unkept |\n| P36 | Completing \"Add a tenant\" switches to the new tenant | `completeTenantSetup{resolution?}` goes through the same guard as `selectTenant`: a pending Harness decision refuses it with `switchBlocked{to: <draft id>, completion: true}`, nothing is committed or retired, the draft stays, and the wizard renders the one guard dialog and re-sends the completion with the resolution | Wizard completion is listed among the entry points of the single guarded switch path (shell.md, I1); the attempt-01 review found it bypassing the guard |\n| P37 | Scopes are per tenant and a switch round trip shows the cached state | Each opened tenant owns its read record in the core (its last overview, the other products' outcomes, generation, recheck, snooze receipt) for the session; a switch away and back shows it again without a new read. Per-operation bookkeeping is separate from the cached data: each read part is tracked with the context it was admitted under, \"reading\" means a part under the current context is open, a part under a retired context is withdrawn when it lands (never recorded, never counted), so a read held open across a switch round trip can never leave the tenant reading. The presentation's own transient state follows the tenant too: the shell store carries the shown scope (set from each snapshot before it renders); a toast for a tenant's item or read and an unconfirmed delivery bound to a context are refused at insertion when that scope is no longer shown (a refusal or lost delivery arriving after a switch), retired on leaving it (however long Reduce Motion would keep them) and filtered at render; a contextual arrival belongs to the tenant it was followed in | I2 names the tenant, not the context, as the owner of its cached scopes; the attempt-01 review found the overview bound to the context and lost across A → B → A |\n| P38 | Snooze toast states the core-computed return time | The core issues a `SnoozeReceipt{id, title, returnsAt, sequence}` on the tenant's Inbox scope for the last snooze placed in the session; the shell announces a new sequence once, in the tenant it was placed in, and never a hold a switch or a reread merely rediscovers; a snooze ends at its return time whether or not its entry is actionable, and the core's deadline ticker publishes the expiry (the holds in effect are part of the overview's time signature) | I11 wants one source for the return time and one announcement per snooze; diffing holds between snapshots announced old holds after a switch (attempt-01 review) |\nattempt-01 review (R3–R6); P22–P23 after attempt-03 (F3a, F3b); P24–P25 were recorded in C28 and P26–P32 in C29 and P33–P38 in C30 and P39–P43 in C31, P44–P51 in C32 and P52–P56 in C33 when implementation met the host as it is (P26–P28 revised after the C29 attempt-01 review; P26–P27 again, and P32 added, after attempt-02; P33–P35 revised and P36–P38 added after the C30 attempt-01 review).\n  from the service's own signal (v1's paging rules); a missing page never\n  proves absence.\n- Clients and their token cache live per credential generation (an SDK\n  session and a lazily built binding); a replaced or removed credential, a\n  tenant switch or reset cancels that generation's reads and never shows\n  their results.\n\n## D034 — Chunk reviews at 8/10; phase sign-off at 9/10 with every chunk raised\n\nDecided by the owner on 2026-10-18 during C08 (\"from now on the chunk reviews\njust need to clear a 8/10, but the phases themselves must continue to achieve a\n9/10 or higher ... each chunk will be pushed to achieve a 9/10 or higher before\nthe phase is signed off on\"); recorded by the implementer. Supersedes D032's\ncase-by-case acceptance for chunks.\n\n- A chunk completes on a Codex review whose five scores are all at least 8\n  with no blockers, through `xtask complete --owner-accept REASON`; required\n  fixes, evidence gaps and the fail recommendation may remain and are\n  recorded (`owner_acceptance.decision = \"D034\"`). Everything else (packet,\n  verdict, transport, fingerprints, runs, native evidence) must still check.\n- A phase review is never owner-accepted: it needs 9/10 in all five scores\n  with empty required fixes, blockers and evidence gaps (`xtask complete`\n  refuses `--owner-accept` for a phase).\n- Before the phase review, every chunk in the phase whose current completion\n  was owner-accepted is remediated and re-reviewed until it passes the full\n  9/10 gate, then completed as a new generation without reopening later\n  chunks. `xtask complete` refuses a phase while any member chunk's current\n  completion is owner-accepted.\n\n## D035 — Reviewed Runtime writes with an AppKit confirmation and secret sheet\n\nDecided in C09 (implementer decision, recorded for review).\n\n- C09 implements exactly v1's Runtime write subset (`bridge/src/protocol.ts`\n  allowed matrix at 74754c02): profiles and custom topics create, update and\n  delete; applications update and delete; API keys create, version, rotate\n  and delete; never force delete. v1's validation, authorship (the\n  management client ID), key-creation checks (application and key names\n  case-insensitively unique over a 40×25 walk, the one deployment profile's\n  auth code injected by the desktop), baseline and review digests, typed\n  confirmation (\"CREATE\" or the item name) and impact text are kept. Request\n  bodies are normalized with the SDK's own request contracts\n  (`scm_sdk::validation::parse`), the Rust counterpart of v1's zod parse.\n- The SDK has no conditional-write precondition, so a change re-reads its\n  baseline immediately before writing and refuses (not sent) when the\n  review digest differs, as v1 did; a 409 is a conflict. An external writer\n  can still race the final read; atomic conflict prevention is not claimed.\n  Writes are never retried; a transport failure's outcome stays unknown.\n  After a write the item is read back by the operation (v1 relied on the\n  write reply), and the readback never changes the write's outcome.\n- RequestApply opens an `NSAlert` sheet on the main window built on the main\n  thread with `objc2` 0.6.5, `objc2-app-kit` 0.3.2, `objc2-foundation` 0.3.2\n  and `block2` 0.6.2 (the lock's versions; DESIGN named objc2 0.6.3 before\n  the pin moved). These become shipping macOS dependencies limited to the\n  NSAlert, NSWindow, NSButton, NSTextField and NSPasteboard classes; WebKit\n  capture stays fixture-only. The sheet's completion resolves a private,\n  nonce-bound future; no wire intent can carry an approval. Destructive\n  changes (delete, rotate) make Cancel the Return default.\n- One-time keys (`api_key` in create/version/rotate replies; the SDK models\n  it as a plain String) move into a zeroizing buffer at once and are never\n  serialized to a snapshot, log or store; the native secret sheet shows one\n  on request, ends itself after 60 s, and Copy and Close writes it with a\n  random owner marker and the nspasteboard.org concealed/transient hints,\n  clearing it after 60 s only if the marker and change count are still\n  ours. The text field's own string copy cannot be zeroized; it is cleared\n  when the sheet ends.\n- v1's directional and customized prompt-injection options were local\n  previews with no API fields; they are not part of any draft.\n\n## D036 — DLP authoring subset with staged keyword files\n\nDecided in C10 (implementer decision, recorded for review).\n\n- C10 implements exactly v1's DLP write subset (`bridge/src/protocol.ts`\n  allowed matrix at 74754c02): data patterns create, replace and delete;\n  data profiles create and replace; data filtering profiles replace;\n  dictionaries create, replace and delete. There is no filtering profile\n  create or delete, no data profile delete, and the SDK's merge-patch\n  methods are not used; deployment profiles and the AIRS DLP catalog stay\n  read-only. Unsupported variants fail review before any request.\n- The same review authority as C09 applies (fresh input, typed\n  confirmation, native confirmation, baseline re-read and digest, no\n  retries, faithful outcomes); DLP baselines and readback use each item's\n  own get, where a 404 is absent. v1 added no authorship to DLP writes;\n  neither does C10, and the SDK's DLP deletes send no body.\n- Bodies are normalized with the SDK's request contracts; data profiles\n  first drop the response-only `advance_data_patterns_rule_request` and\n  null fields and must pass v1's `validDataProfile` (ported exactly, UTF-16\n  name length). Dictionaries are exactly `{metadata, file}` with the file\n  as non-empty text of at most 64 Ki UTF-16 units (v1), metadata checked by\n  `DictionaryRequestSchema` and an `original_file_name` the SDK's multipart\n  rules accept; uploads are the SDK's multipart (`json` metadata part,\n  `file` part named by the file name, text/plain).\n- v1 entered keywords only as text. C10's milestone asks for file\n  selection, so a dictionary may also use a keyword file chosen in a native\n  sheet (rfd/NSOpenPanel; the fixture build reads a file staged in its data\n  root). Rust reads it once (bounded to 256 KiB, then UTF-8, a byte-order\n  mark dropped, non-empty, at most 64 Ki UTF-16 units), never writes it,\n  and stages it for the active context under a random token; a draft\n  refers to it as `fileRef`. The renderer never sees a path or the content;\n  a different file chosen after review changes the draft Apply compares\n  and is refused.\n\n## D037 — Sessions investigations, the protected cache and metadata-only reports\n\nDecided in C11 (implementer decision, recorded for review).\n\n- Sessions are read through the tenant's management binding (C08) with the\n  SDK's raw dashboard reads, leniently as v1 read them: the inventory is the\n  last 24 hours (`time_interval=1`, `time_unit=day`) in pages of 25; a\n  session is one page of 25 actions over 30 days (\"at least 25\" when full);\n  a transaction and a scan's content are read by scan and sub-request.\n  Secret fields are redacted and prompt/response text is removed from every\n  read except Content, which runs only on an explicit reveal.\n- Searches keep v1's classification and bounds (`bridge/src/runtime.ts`): a\n  session ID walks 30 days in pages of 100 for at most 40 pages; a scan ID is\n  one scan report whose metadata (never content) is returned, a 404 proving\n  absence; a detector walks the last day for at most 1,000 sessions and\n  stops after the page that reaches 100 matches. Completeness is claimed\n  only when the window ended (and, for a detector, with no more than 100\n  matches); the presentation words each result by what was read.\n- The investigation cache belongs to one credential generation and never\n  authorizes anything: every read, cached or not, first binds the current\n  credential. It keeps v1's 50 entries per category and 4 MiB snapshot\n  bound. For a Keychain credential it is sealed (XChaCha20-Poly1305, AAD\n  bound to the credential) under a random key in the credential namespace\n  whose record is derived from the credential's record; the sealed file and\n  key are removed with the credential through the cleanup ledger and by a\n  reset. A session credential's cache stays in memory. Unlike v1, the\n  snapshot is a 0600 file rather than a Keychain item (one key item per\n  credential, any size); a snapshot that does not open is discarded. Clear\n  empties it; Export writes its session and transaction metadata only.\n- FP/FN reports keep v1's model, limits, upsert/remove/undo and CSV. Unlike\n  v1, a new report is built in Rust from the scan's action row in this\n  credential's investigation (the operator supplies only kind, category and\n  reason, the category being one of v1's quick picks), so a report can\n  never carry content or invented metadata; an existing report can be\n  edited without its session. Reports are a 0600 JSON file per tenant\n  (named by a digest of the tenant ID), loaded off the lock, written\n  newest-generation-only, removed with the tenant and by reset. Exports go\n  through the native save sheet (rfd/NSSavePanel, owner-only atomic write;\n# Working-v1 parity and release closure\n\nAll v2 rows are **planned**. No v2 source/native/live/artifact result exists yet.\nThe baseline is [feature-baseline.md](feature-baseline.md); do not expand a\npreview/stub into required live behavior without an explicit scope decision.\n\n| Requirement family                     | Owning chunks   | Closure requirement                                                                  |\n|----------------------------------------|-----------------|--------------------------------------------------------------------------------------|\n| Tenant setup/scan-only/protected state | C02,C03,C08,C23 | Context/capabilities, reviewed endpoint overrides/profile import, verification/reset |\n| Runtime synchronous scan/cases         | C03,C12         | Faithful verdicts, profiles, cancellation and no silent replay                       |\n| Profiles/topics/applications/keys      | C08,C09         | Exact supported reads/writes, review binding, one-time secrets                       |\n| DLP/deployment catalogue               | C08,C10         | Exact supported operation subset and real multipart semantics                        |\n| Sessions/content/search/cache          | C11             | Explicit reveal, protected persistence, bounded completeness                         |\n| Metadata FP/FN reports                 | C11             | Edit/remove/undo/export without suppression side effects                             |\n| Home/Inbox/source observations/charts  | C12,C18         | Runtime and Gateway data, freshness/partial/unknown/attention                        |\n| Five-product Library/specifications    | C12             | Authoring/import/export; only supported Runtime execution                            |\n| Red Team read-only observations        | C13             | Accepted actual reads; no invented live execution                                    |\n| Model/skill read-only observations     | C13             | Accepted actual reads and partial-source disclosure                                  |\n| API Client documents/projects/imports  | C14             | Fresh-input reconciliation, drafts/conflicts/secrets/Git adoption                    |\n| API Client transport/history/catalogue | C15             | Real HTTP/cookies/downloads, scoped auth, no mutation bypass                         |\n| Gateway workspace/config/admin subset  | C16,C17         | Supported scope/options and reviewed multi-step outcomes                             |\n| Gateway inference/logs/telemetry/cost  | C18             | Streaming, route/model selection, operational budgets/limits                         |\n| Harness native run/stream/lifecycle    | C19             | Real Rust engine/protocol, cleanup and no packaged Node runtime                      |\n| Harness identity/protected history     | C20             | Rust SSO/key lifecycle, scope-safe restore/export/delete                             |\n| Harness typed tools/project permission | C21             | Investigation/proposals and enforced existing sandbox restrictions                   |\n| Workspace MCP                          | C22             | Rust auth/grants, exact call approvals and execution evidence                        |\n| Academy identity/account isolation     | C04             | Device OAuth, scope admission, tenant-independent learner identity                   |\n| Academy learner presentation           | C05             | Shared catalog/lessons/checks/sandbox/UI; feature-local gamification                 |\n| Academy Program/exams/certificates     | C06             | Hosted access/timing/grading/award authority and account workflows                   |\n| Academy encrypted offline work         | C07             | Lease/revision/account-aware reading/drafts; explicit submission                     |\n| Reviewed imports/fresh authentication  | C23             | User work, source preservation, restart/rollback; no old approvals                   |\n| Native UX/privacy/measured performance | C01–C24         | Per-chunk checks plus cumulative actual native quality closure                       |\n| Controlled live behavior               | C25             | Designated scope, real outcomes, readback/cleanup, honest gaps                       |\n| Signed installed package/update        | C26             | DMG/notary/Gatekeeper, exact bytes, fresh user, coexistence/rollback                 |\n\n## Required per-workflow ledger\n\nThe [workflow ledger](../architecture/workflows.md) expands these families into\n66 operation/workflow classes. C01 records machine-readable evidence rows and\nconsuming chunks map exact supported operations/options before implementation.\nEvery row needs an ID, baseline source, current classification, responsible chunk,\nexact SDK/shared dependency contract, and independent expectations. Preserve four\nevidence categories separately: source implementation, fixture/contract results,\nnative/live qualification, and final installed-artifact qualification. Record\ndenied/unsupported/partial results honestly rather than collapsing them to pass.\n\nG01/C01 adds a live_requirement (required/not_required with reason) and separate\nready/blocked-by-access status to every row under [live-checks.md](live-checks.md).\nThe owner approves the expanded list before C25. Missing access cannot shrink\nmandatory scope; a reduction requires a recorded owner decision and new review.\nT23 cross-feature offline acceptance applies to local work and pending operations,\nnot just Academy. C24 closes that cumulative matrix.\n\nV2 source completeness alone does not close a row. Each workflow needs applicable\nsuccess and failure assertions, context/authority coverage, native acceptance and\nrequired live/artifact evidence. C25/C26 review the cumulative ledger against\nthe final frozen input set. A required blocked check blocks stable completion.\n\n## Intentional non-goals and retained classifications\n\n- Financial desktop billing/monetization and media-generation infrastructure are\n  excluded. Remote operational cost/limit administration is retained.\n- Exception Patterns remains explicitly synthetic/inert if shown. FP/FN reports\n  do not suppress scans or modify policy.\n- New Red Team execution and dedicated Model Security execution remain outside\n  parity. Their existence in the new SDK does not authorize adding product scope.\n- Academy admin/assessor operations remain web-only. Learner feedback with an\n  administrative namespace is classified by actual authority, not string matching.\n- No browser app, in-app updater, or additional supported OS/architecture is\n  required for first stable v2.\n- Shared Academy appearance replaces the GPUI presentation implementation. Do\n  not infer a pixel clone or identical internal widget/theme catalogue. Preserve\n  theme preference workflows and specify reviewed mappings for imported settings.\n- The generic SCM workbench catalogue does not prove all 193 requests were live\n  tested. Classify its supported execution/admission separately from dedicated\n  workflows and bind its request metadata to a reviewed source snapshot.\n\nManaged scan/identity HTTP deliberately defaults to Direct rather than v1's\nambient system proxy behavior. On mandatory-proxy networks, onboarding/settings\nshows Direct/System/Explicit policy and requires operator selection; a failed\nfirst request must surface proxy setup rather than an unexplained regression.\nGeneric workbench remains System by default. C02/C15 qualify all modes.\n","exit_code":0,"status":"completed"}}
