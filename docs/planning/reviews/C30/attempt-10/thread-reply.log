s-panel'\nimport { TestCases } from './workbench/test-cases'\n\n/** C44: the product destinations the catalogue still lists (Go, the palette), opened as Administration's products. */\nconst PRODUCT_DESTINATION: Record<'runtime' | 'gateway' | 'redTeam', { product: AdminProductId; sequence: number }> = { runtime: { product: 'runtimeSecurity', sequence: -1 }, gateway: { product: 'gateway', sequence: -2 }, redTeam: { product: 'redTeam', sequence: -3 } }\n\nexport interface V2ShellProps {\n    snapshot: ShellSnapshot\n    appearancePending: boolean\n    status: string\n    onNavigate: (id: FeatureId) => void\n    onSetAppearance: (theme: Theme) => void\n    onSetShowCalls: (on: boolean) => void\n    onSwitchTenant: (tenant: string, resolution?: SwitchResolution) => void\n    onReadNow: () => void\n    /** Re-sends a delivery the desktop did not confirm, only on the operator's click. */\n    onRetry: (what: string, intent: Intent) => void\n    /** Sends one intent and reports its outcome on the shell's surfaces (Home and Inbox actions). */\n    onAct: Act\n    dispatch: Dispatch\n    client: DesktopClient\n}\n\n/** The products the Inbox files entries under (the inventory's ids that have an admitted service). */\nconst productOf = (id: AdminProductId): string | null => (id === 'agenticIdentity' || id === 'agenticEndpoint' ? null : id)\n\nconst darkQuery = () => (typeof window !== 'undefined' && typeof window.matchMedia === 'function' ? window.matchMedia('(prefers-color-scheme: dark)') : null)\nconst subscribeDark = (notify: () => void) => {\n    const query = darkQuery()\n    if (!query) return () => undefined\n    query.addEventListener('change', notify)\n    return () => query.removeEventListener('change', notify)\n}\n// Without a media query the follower assumes dark (shell/appearance.ts): the toggle agrees with it.\nconst readDark = () => darkQuery()?.matches ?? true\n\n/**\n * Whether the shown appearance is dark: the choice, or the system's while\n * following it, re-read on every OS appearance change (C35 R2) so the\n * toggle's state and its next click follow what the follower applied.\n */\nfunction useShownDark(theme: Theme): boolean {\n    const systemDark = useSyncExternalStore(subscribeDark, readDark, readDark)\n    return theme === 'system' ? systemDark : theme === 'dark'\n}\n\n/**\n * The \"Refined Native\" shell as the prototype draws it (R2App, C35): a\n * 244px sidebar (tenant button, the Rust navigation inventory with the\n * Administration products as children and needs-action badges, the status\n * block) and a right column with the 56px header (title and subtitle, the\n * search button that opens the palette, the Explain switch, Ask Harness)\n * over the destination. Labels and ⌘ hints come from the same catalogue\n * the native menu is built from. Destinations not yet ported render the\n * legacy FeatureBody inside the page frame.\n */\nexport function V2Shell(props: V2ShellProps) {\n    const { snapshot } = props\n    const paletteOpen = useShellStore((s) => s.paletteOpen)\n    const openPalette = useShellStore((s) => s.openPalette)\n    const closePalette = useShellStore((s) => s.closePalette)\n    const adminNavOpen = useShellStore((s) => s.adminNavOpen)\n    const setAdminNav = useShellStore((s) => s.setAdminNav)\n    const unconfirmedAll = useShellStore((s) => s.unconfirmed)\n    // Only deliveries bound to the shown context, or to none (I2).\n    const unconfirmed = unconfirmedAll.filter((u) => u.context === null || u.context === (snapshot.active?.context ?? null))\n    const clearUnconfirmed = useShellStore((s) => s.clearUnconfirmed)\n    const arrival = useShellStore((s) => s.arrival)\n    const modalOpen = useModalsOpen()\n    const heading = useRef<HTMLHeadingElement>(null)\n    const firstRender = useRef(true)\n    const [adding, setAdding] = useState(false)\n    // The sheet closes only when the wizard says so: a committed tenant (toast)\n    // or a discard the core admitted. Escape and the scrim are close requests\n    // the wizard answers with the same Cancel as its button.\n    const [closeRequests, setCloseRequests] = useState(0)\n    const closeSheet = (added?: string) => {\n        setAdding(false)\n        setCloseRequests(0)\n        if (added) useShellStore.getState().toast(SHELL_COPY.tenantAdded(added), 'ok')\n    }\n    const active = snapshot.activeFeature\n    const feature = snapshot.features.find((f) => f.id === active) ?? snapshot.features[0]\n    // Completion toasts are derived from the core's ReadStatus (I4): a new\n    // generation is one finished read; its kind follows the coverage. A\n    // tenant change re-baselines (the other tenant's generation is its own).\n    const read = snapshot.inbox.read\n    const tenantNow = snapshot.active?.tenant ?? null\n    const tenant = snapshot.tenants.find((t) => t.id === tenantNow) ?? null\n    const seenGeneration = useRef<{ tenant: string | null; generation: number }>({ tenant: tenantNow, generation: read.generation })\n    useEffect(() => {\n        const seen = seenGeneration.current\n        seenGeneration.current = { tenant: tenantNow, generation: read.generation }\n        if (seen.tenant !== tenantNow || read.generation === seen.generation) return\n        const tenant = snapshot.tenants.find((t) => t.id === tenantNow)\n        const line = readLine(snapshot, tenant?.label ?? null)\n        useShellStore.getState().toast(line.text, line.tone === 'allowed' ? 'ok' : 'warn', undefined, tenantNow, snapshot.active?.context ?? null)\n    }, [read.generation, tenantNow, snapshot])\n    // A snooze is announced once, from the receipt the core issues for it\n    // (I11): the return time is the core's, wherever the snooze was asked\n    // for. Holds a tenant already had, or a read rediscovers, are not news.\n    const lastSnooze = snapshot.inbox.lastSnooze\n    const seenSnooze = useRef<{ tenant: string | null; sequence: number }>({ tenant: tenantNow, sequence: lastSnooze?.sequence ?? 0 })\n    useEffect(() => {\n        const seen = seenSnooze.current\n        const sequence = lastSnooze?.sequence ?? 0\n        seenSnooze.current = { tenant: tenantNow, sequence }\n        if (seen.tenant !== tenantNow || !lastSnooze || sequence === seen.sequence) return\n        useShellStore.getState().toast(SNOOZE_COPY.toast(lastSnooze.title, lastSnooze.returnsAt), 'info', undefined, tenantNow, snapshot.active?.context ?? null)\n    }, [lastSnooze, tenantNow, snapshot.active])\n    // Presentation state follows its tenant (I2): an arrival another tenant\n    // asked for is forgotten, a toast that spoke for another tenant's item or\n    // read is retired (however long Reduce Motion would have kept it), and an\n    // unconfirmed delivery bound to a retired context is dropped (it can\n    // never be revived, let alone rebound).\n    const contextNow = snapshot.active?.context ?? null\n    useEffect(() => {\n        useShellStore.getState().scopeArrival(tenantNow)\n        useShellStore.getState().retireToasts(tenantNow)\n        useShellStore.getState().retireUnconfirmed(contextNow)\n    }, [tenantNow, contextNow])\n    // The guard for a switch asked here (I1); a setup draft's completion\n    // renders the same guard inside the wizard, which re-sends the completion.\n    const guard = snapshot.switchBlocked && !snapshot.switchBlocked.completion ? snapshot.switchBlocked : null\n    const guardTarget = guard ? snapshot.tenants.find((t) => t.id === guard.to)?.label ?? guard.to : null\n\n    useEffect(() => {\n        // Move focus to the new page heading after navigation (not on launch).\n        if (firstRender.current) {\n            firstRender.current = false\n            return\n        }\n        heading.current?.focus()\n    }, [active])\n\n    const observeWorkbench = useCallback((operation: string) => props.client.observeWorkbench(operation), [props.client])\n\n    if (!feature) return null\n\n    // The rail's badges: items needing action, in all and per product (the prototype's NAV badge and PRODUCTS counts).\n    const needing = snapshot.inbox.items.filter((e) => e.needsAction && !e.hold)\n    const products = snapshot.administration?.products ?? []\n    const productsKnown = products.length > 0\n    const admin = snapshot.features.find((f) => f.id === 'administration')\n    const adminAvailable = admin?.availability.state === 'available'\n    const productShown = arrival && arrival.tenant === tenantNow && arrival.feature === 'administration' ? arrival.product ?? null : null\n    const openProduct = (id: AdminProductId) => {\n        if (!tenantNow) return\n        useShellStore.getState().arrive({ tenant: tenantNow, feature: 'administration', resource: null, item: null, product: id })\n        props.onNavigate('administration')\n    }\n    const subtitle = feature.id === 'administration' && productShown ? products.find((p) => p.id === productShown)?.label ?? '' : ''\n\n    // The status block (R2App): the connection and read status, the Harness credential as the\n    // Harness itself would use it for the selected workspace (R1), the keychain, jobs.\n    const readStatus = readLine(snapshot, tenant?.label ?? null)\n    const credential = harnessCredential(snapshot)\n    const harnessText =\n        credential.source === 'sso'\n            ? credential.ready\n                ? SHELL_COPY.harnessSignedIn\n                : credential.failed\n                  ? SHELL_COPY.harnessRenew\n                  : SHELL_COPY.harnessPending\n            : credential.source === 'key'\n              ? SHELL_COPY.harnessKey\n              : credential.workspace\n                ? SHELL_COPY.harnessOff\n                : SHELL_COPY.harnessNoWorkspace\n    const keychainText = snapshot.storage === 'ready' ? SHELL_COPY.keychainUnlocked : snapshot.storage === 'unavailable' ? SHELL_COPY.keychainUnavailable : SHELL_COPY.keychainLocked\n    const running = read.state === 'reading' ? 1 : 0\n    const jobsText = running === 0 ? SHELL_COPY.jobsNone : SHELL_COPY.jobsRunning(running)\n    const account = credential.source === 'sso' && credential.ready ? credential.account : snapshot.academy.state === 'signedIn' ? snapshot.academy.displayName : null\n    const dark = useShownDark(snapshot.appearance)\n    // The tenant menu's workspace row: the Gateway's Workspaces tab in Administration, while a tenant is active.\n    const gatewayProduct = products.find((p) => p.id === 'gateway')\n    const changeWorkspace =\n        tenantNow && adminAvailable && gatewayProduct && gatewayProduct.availability.state === 'available'\n            ? () => {\n                  useShellStore.getState().arrive({ tenant: tenantNow, feature: 'administration', resource: null, item: null, product: 'gateway', tab: 'workspaces' })\n                  props.onNavigate('administration')\n              }\n            : null\n\n    const navRow = (current: boolean, unavailable: boolean) => ({\n        background: current ? 'var(--v2-sel)' : 'transparent',\n        color: current ? 'var(--v2-sel-ink)' : unavailable ? 'var(--v2-faint)' : 'var(--v2-ink)',\n    })\n\n    return (\n        <div data-v2-shell='' className='flex h-screen overflow-hidden'>\n            <nav\n                data-v2-rail=''\n                aria-label={SHELL_COPY.navLabel}\n                aria-hidden={modalOpen ? true : undefined}\n                inert={modalOpen ? true : undefined}\n                // The prototype reserves 14px above the tenant button for the window's traffic lights, which this\n                // window's own title bar carries; the rail starts under it (noted in the parity notes).\n                className='flex h-screen shrink-0 flex-col overflow-y-auto'\n                style={{ width: 'var(--v2-rail)', padding: '12px 10px 12px', background: 'var(--v2-side)', borderRight: '1px solid var(--v2-rule)' }}\n            >\n                <TenantSwitcher snapshot={snapshot} onSwitch={props.onSwitchTenant} onAdd={() => setAdding(true)} onNavigate={props.onNavigate} onChangeWorkspace={changeWorkspace} />\n                <ul className='flex flex-grow flex-col overflow-y-auto overscroll-contain' style={{ gap: 2, minHeight: 0 }} data-slot='nav-list'>\n                    {snapshot.features\n                        .filter((f) => f.sidebar)\n                        .map((f) => {\n                            const glyph = FEATURE_GLYPHS[f.id] ?? 'chevR'\n                            const current = f.id === feature.id\n                            const unavailable = f.availability.state === 'unavailable'\n                            const reason = f.availability.state === 'unavailable' ? f.availability.reason : ''\n                            const isAdmin = f.id === 'administration'\n                            const badge = f.id === 'inbox' && needing.length > 0 ? String(needing.length) : ''\n                            return (\n                                <li key={f.id} className='flex flex-col' style={{ gap: 1 }}>\n                                    <div className='flex items-center' style={{ gap: 2 }}>\n                                        <button\n                                            type='button'\n                                            aria-current={current ? 'page' : undefined}\n                                            aria-disabled={unavailable || undefined}\n                                            aria-describedby={unavailable ? `${f.id}-hint` : undefined}\n                                            title={unavailable ? SHELL_COPY.unavailableHint(reason) : f.shortcut !== null ? `${f.label} (⌘${f.shortcut})` : f.label}\n                                            onClick={() => !unavailable && props.onNavigate(f.id)}\n                                            data-inset-focus=''\n                                            className='flex h-[34px] min-h-0 flex-grow items-center rounded-[8px] px-2.5 text-left text-[13px]'\n","exit_code":1,"status":"failed"}}
{"type":"item.started","item":{"id":"item_27","type":"command_execution","command":"/bin/zsh -lc \"sed -n '1,230p' apps/desktop/src/v2/home.tsx; cat apps/desktop/src/features/tenants/dispatch.ts; rg -n 'setScope|selectTenant|onSwitchTenant|onAct|const act|retry|readTenant|onReadNow' apps/desktop/src/app.tsx; rg -n 'overview_record|overview_parts|withdraw|complete_read|finish_read|product_read_refused|read_records|admit_read_part|set_rechecking|hold_insight|restore_insight|time_signature' crates/desktop-core/src/authority/observation_domain.rs\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_27","type":"command_execution","command":"/bin/zsh -lc \"sed -n '1,230p' apps/desktop/src/v2/home.tsx; cat apps/desktop/src/features/tenants/dispatch.ts; rg -n 'setScope|selectTenant|onSwitchTenant|onAct|const act|retry|readTenant|onReadNow' apps/desktop/src/app.tsx; rg -n 'overview_record|overview_parts|withdraw|complete_read|finish_read|product_read_refused|read_records|admit_read_part|set_rechecking|hold_insight|restore_insight|time_signature' crates/desktop-core/src/authority/observation_domain.rs\"","aggregated_output":"import { forwardRef } from 'react'\nimport type { AdminProduct, AdminProductId, FeatureId, InboxEntry, ProductId, ProductRead, ShellSnapshot } from '@prisma-airs/desktop-contracts'\nimport { HOME_COPY, INBOX_COPY, READ_COPY, SHELL_COPY, SNOOZE_COPY, clockOf } from './copy'\nimport { Glyph, PRODUCT_GLYPHS, type GlyphName } from './icons'\nimport { type Act, destinationFeature, follow, holdWhat } from './inbox/inbox'\nimport { useShellStore } from './store'\n\nexport interface HomeProps {\n    snapshot: ShellSnapshot\n    onAct: Act\n    onNavigate: (id: FeatureId) => void\n}\n\n/**\n * What the empty attention list may say (I4): an all-clear only after a\n * complete read; otherwise the unread, in-progress, failed or partial\n * coverage is named instead.\n */\nexport function attentionEmpty(snapshot: ShellSnapshot): string {\n    const read = snapshot.inbox.read\n    if (read.state === 'pending') return HOME_COPY.firstRead\n    if (read.state === 'reading' && read.lastReadAt === null) return HOME_COPY.reading\n    if (read.state === 'failed' && read.failedAt !== null) {\n        return read.lastReadAt === null ? READ_COPY.failed(clockOf(read.failedAt)) : HOME_COPY.clearSoFar(READ_COPY.failedKept(clockOf(read.failedAt), clockOf(read.lastReadAt)))\n    }\n    // A read in progress shows the cached read until the new one lands: its age stays named (C12).\n    const stale = read.lastReadAt !== null && !snapshot.overview.fresh\n    if (read.state === 'reading' && read.lastReadAt !== null) return HOME_COPY.clearSoFar(stale ? READ_COPY.readingStaleQualifier(clockOf(read.lastReadAt)) : READ_COPY.readingQualifier(clockOf(read.lastReadAt)))\n    if (read.sourcesMissing.length > 0) return HOME_COPY.clearSoFar(READ_COPY.unread(read.sourcesMissing.length))\n    // A healthy empty read older than the freshness window is a gap, not an all-clear (C12).\n    if (stale) return HOME_COPY.clearSoFar(READ_COPY.staleQualifier(clockOf(read.lastReadAt ?? 0)))\n    return HOME_COPY.allClear\n}\n\n/** The read-status line (I4): first read pending, reading, finished (with partial coverage), or failed. */\nexport function readLine(snapshot: ShellSnapshot, tenant: string | null): { text: string; tone: 'info' | 'flagged' | 'allowed' | 'blocked' } {\n    const read = snapshot.inbox.read\n    if (!tenant) return { text: HOME_COPY.noTenant, tone: 'info' }\n    if (read.state === 'reading' && read.lastReadAt === null) return { text: HOME_COPY.reading, tone: 'info' }\n    // Reading again: the cached read stays shown, with its age, until the new one lands.\n    if (read.state === 'reading' && read.lastReadAt !== null) {\n        const when = clockOf(read.lastReadAt)\n        return snapshot.overview.fresh ? { text: READ_COPY.readingKept(when), tone: 'info' } : { text: READ_COPY.readingStale(when), tone: 'flagged' }\n    }\n    // A failed read is failed, attempted or not before: never \"pending\", never an all-clear.\n    if (read.state === 'failed' && read.failedAt !== null) {\n        return read.lastReadAt === null ? { text: READ_COPY.failed(clockOf(read.failedAt)), tone: 'blocked' } : { text: READ_COPY.failedKept(clockOf(read.failedAt), clockOf(read.lastReadAt)), tone: 'blocked' }\n    }\n    if (read.state === 'pending' || (read.lastReadAt === null && read.settledAt === null)) return { text: HOME_COPY.firstRead, tone: 'info' }\n    // A settled attempt that established nothing (every source needs a role)\n    // is announced for when it settled, never as a first read still pending.\n    const when = clockOf(read.lastReadAt ?? read.settledAt ?? 0)\n    const needsRole = read.products.filter((p) => p.state === 'needsRole').length\n    if (needsRole > 0) return { text: READ_COPY.finishedNeedsRole(when, needsRole), tone: 'flagged' }\n    if (read.sourcesMissing.length > 0) return { text: READ_COPY.finishedIncomplete(when, read.sourcesMissing.length), tone: 'flagged' }\n    // Expired coverage stays distinct from healthy-empty (C12): the cached read is kept, its age named.\n    if (read.lastReadAt !== null && !snapshot.overview.fresh) return { text: READ_COPY.stale(when), tone: 'flagged' }\n    const activity = snapshot.overview.read?.summary.sessions\n    if (activity === 0 && snapshot.inbox.items.length === 0) return { text: READ_COPY.finishedNoActivity(when, tenant), tone: 'allowed' }\n    return { text: READ_COPY.finished(when), tone: 'allowed' }\n}\n\n/**\n * The one line under the greeting (R2App `homeSub`): the product count, the\n * core's read-status line (I4: pending, reading, finished with its coverage,\n * or failed, exactly as `readLine` says it) and the needs-action count.\n */\nexport function homeSub(snapshot: ShellSnapshot, tenant: string, products: number, needing: number): string {\n    const parts = [HOME_COPY.sub.products(products), readLine(snapshot, tenant).text]\n    if (needing > 0) parts.push(HOME_COPY.sub.needAction(needing))\n    return parts.join(' · ')\n}\n\ntype Pill = { word: string; bg: string; fg: string; glyph: GlyphName }\nconst PILLS: Record<'ok' | 'partial' | 'role' | 'pending' | 'failed' | 'gated', Pill> = {\n    ok: { word: HOME_COPY.pill.connected, bg: 'var(--v2-ok-bg)', fg: 'var(--v2-ok)', glyph: 'check' },\n    partial: { word: HOME_COPY.pill.partial, bg: 'var(--v2-flag-bg)', fg: 'var(--v2-flag)', glyph: 'alert' },\n    role: { word: HOME_COPY.pill.needsRole, bg: 'var(--v2-flag-bg)', fg: 'var(--v2-flag)', glyph: 'alert' },\n    pending: { word: HOME_COPY.pill.connecting, bg: 'var(--v2-inset)', fg: 'var(--v2-soft)', glyph: 'clock' },\n    failed: { word: HOME_COPY.pill.failed, bg: 'var(--v2-block-bg)', fg: 'var(--v2-block)', glyph: 'ban' },\n    gated: { word: HOME_COPY.pill.unavailable, bg: 'var(--v2-inset)', fg: 'var(--v2-faint)', glyph: 'lock' },\n}\n\ninterface Card {\n    id: AdminProductId\n    /** The read can be asked for again (a role granted, a failure, partial coverage): the C30 recheck. */\n    recheck: ProductId | null\n    name: string\n    pill: Pill\n    value: string\n    valueColor: string\n    metric: string\n    spark: { h: number; hot: boolean }[]\n    sub: string\n    subColor: string\n    subGlyph: GlyphName\n    isNew: boolean\n    gated: boolean\n}\n\n/** The products the read reports on (the inventory ids with an admitted service). */\nconst readIdOf = (id: AdminProductId): ProductId | null => (id === 'agenticIdentity' || id === 'agenticEndpoint' ? null : id)\n\nconst dollars = (cents: number) => `$${(cents / 100).toFixed(2)}`\nconst count = (n: number) => n.toLocaleString('en-US')\n\n/**\n * One card per Administration product (R2App `cards`), from the core only:\n * Runtime's headline is the read's detection events over its chart; the\n * Gateway's is the chosen workspace's day; Red Teaming and model/skill scans\n * carry their read state (the core publishes no figures for them); the two\n * gated products carry their gate. Nothing scripted is drawn.\n */\nexport function cardOf(snapshot: ShellSnapshot, product: AdminProduct, attention: InboxEntry[]): Card {\n    const readId = readIdOf(product.id)\n    const read = snapshot.inbox.read\n    const state: ProductRead | undefined = readId ? read.products.find((p) => p.product === readId) : undefined\n    const recheck = readId && state && (state.state === 'needsRole' || state.state === 'failed' || state.state === 'incomplete') ? readId : null\n    const base = { id: product.id, name: product.label, isNew: product.availability.state === 'unavailable', gated: product.availability.state === 'unavailable', recheck }\n    const blank = (pill: Pill, sub: string, subColor = 'var(--v2-faint)', subGlyph: GlyphName = 'clock'): Card => ({ ...base, pill, value: '—', valueColor: 'var(--v2-faint)', metric: HOME_COPY.metric[product.id] ?? '', spark: [], sub, subColor, subGlyph })\n    if (product.availability.state === 'unavailable') return blank(PILLS.gated, product.availability.reason, 'var(--v2-faint)', 'lock')\n    if (!state || state.state === 'pending' || state.state === 'notRead') return blank(PILLS.pending, read.state === 'reading' ? HOME_COPY.reading : HOME_COPY.firstRead)\n    if (state.state === 'needsRole') return blank(PILLS.role, HOME_COPY.cardNeedsRole(state.detail), 'var(--v2-flag)', 'alert')\n    if (state.state === 'failed') return blank(PILLS.failed, state.detail ?? READ_COPY.productState.failed ?? 'Failed', 'var(--v2-block)', 'ban')\n    const pill = state.state === 'incomplete' ? PILLS.partial : PILLS.ok\n    const worst = attention.find((e) => e.product === readId)\n    const overview = snapshot.overview.read\n    // The worst attention item is the last line when there is one; else the line states what the\n    // read established, and names what it could not (R1): unknown is never an all-clear.\n    const worstLine = worst ? { sub: worst.title, subColor: worst.severity === 'bad' ? 'var(--v2-block)' : 'var(--v2-flag)', subGlyph: (worst.severity === 'bad' ? 'ban' : 'alert') as GlyphName } : null\n    if (product.id === 'runtimeSecurity' && overview) {\n        const events = overview.summary.detectionEvents\n        const buckets = overview.chart?.buckets ?? []\n        const max = Math.max(1, ...buckets.map((b) => b.violating))\n        const spark = buckets.slice(-12).map((b) => ({ h: Math.max(2, Math.round((b.violating / max) * 38)), hot: b.violating > 0 }))\n        const violating = overview.summary.violating\n        const line =\n            worstLine ??\n            (overview.chart === null || overview.chartFailure !== null\n                ? { sub: HOME_COPY.chartNotRead, subColor: 'var(--v2-flag)', subGlyph: 'alert' as GlyphName }\n                : violating === null\n                  ? { sub: HOME_COPY.activityUnknown, subColor: 'var(--v2-flag)', subGlyph: 'alert' as GlyphName }\n                  : violating > 0\n                    ? { sub: HOME_COPY.runtimeViolating(violating), subColor: 'var(--v2-soft)', subGlyph: 'check' as GlyphName }\n                    : { sub: HOME_COPY.noDetections, subColor: 'var(--v2-soft)', subGlyph: 'check' as GlyphName })\n        return {\n            ...base,\n            pill,\n            value: events === null ? '—' : count(events),\n            valueColor: events !== null && events > 0 ? 'var(--v2-block)' : 'var(--v2-ink)',\n            metric: HOME_COPY.metric.runtimeSecurity,\n            spark,\n            ...line,\n        }\n    }\n    if (product.id === 'gateway') {\n        const g = overview?.gateway ?? null\n        if (!g) {\n            // No workspace chosen (or no read yet): no day to draw, and the gate said (R2).\n            return { ...base, pill, value: '—', valueColor: 'var(--v2-faint)', metric: HOME_COPY.metric.gateway, spark: [], ...(worstLine ?? { sub: HOME_COPY.gatewayNoWorkspace, subColor: 'var(--v2-faint)', subGlyph: 'route' as GlyphName }) }\n        }\n        const requests = g.requests\n        const errors = g.errors\n        const rate = requests !== null && errors !== null && requests > 0 ? (errors / requests) * 100 : null\n        const line =\n            worstLine ??\n            (g.usageFailure !== null || requests === null\n                ? { sub: HOME_COPY.usageNotRead(g.workspaceName), subColor: 'var(--v2-flag)', subGlyph: 'alert' as GlyphName }\n                : errors === null\n                  ? { sub: HOME_COPY.errorsUnknown(g.workspaceName), subColor: 'var(--v2-flag)', subGlyph: 'alert' as GlyphName }\n                  : rate === null\n                    ? { sub: HOME_COPY.gatewayNoRequests(g.workspaceName), subColor: 'var(--v2-soft)', subGlyph: 'check' as GlyphName }\n                    : { sub: HOME_COPY.gatewayErrorRate(rate), subColor: rate > 5 ? 'var(--v2-block)' : 'var(--v2-soft)', subGlyph: (rate > 5 ? 'ban' : 'check') as GlyphName })\n        return {\n            ...base,\n            pill: g.partial ? PILLS.partial : pill,\n            value: requests === null ? '—' : count(requests),\n            valueColor: 'var(--v2-ink)',\n            metric: g.cost === null ? HOME_COPY.metric.gateway : `${HOME_COPY.metric.gateway} · ${dollars(g.cost)}`,\n            spark: [],\n            ...line,\n        }\n    }\n    // Read-state cards: the read's coverage is the figure the core has.\n    return {\n        ...base,\n        pill,\n        value: state.sourcesTotal > 0 ? `${state.sourcesRead}/${state.sourcesTotal}` : '—',\n        valueColor: 'var(--v2-ink)',\n        metric: HOME_COPY.metric[product.id] ?? READ_COPY.sources(state.sourcesRead, state.sourcesTotal),\n        spark: [],\n        sub: worst ? worst.title : state.detail ?? (state.state === 'incomplete' ? HOME_COPY.partialRead(state.sourcesRead, state.sourcesTotal) : HOME_COPY.readOnly),\n        subColor: worst ? (worst.severity === 'bad' ? 'var(--v2-block)' : 'var(--v2-flag)') : state.state === 'incomplete' ? 'var(--v2-flag)' : 'var(--v2-soft)',\n        subGlyph: worst ? (worst.severity === 'bad' ? 'ban' : 'alert') : state.state === 'incomplete' ? 'alert' : 'check',\n    }\n}\n\nconst severityTile = (e: InboxEntry): { glyph: GlyphName; fg: string; bg: string } =>\n    e.severity === 'bad' ? { glyph: 'ban', fg: 'var(--v2-block)', bg: 'var(--v2-block-bg)' } : e.severity === 'warn' ? { glyph: 'alert', fg: 'var(--v2-flag)', bg: 'var(--v2-flag-bg)' } : { glyph: 'info', fg: 'var(--v2-soft)', bg: 'var(--v2-inset)' }\n\n/**\n * Home as the prototype draws it (R2App start=home, C36): the greeting row\n * with the read summary and Refresh, the Explain banner while the calls are\n * shown, the six product cards, then Needs attention beside Quick actions.\n * Every figure reads the snapshot; every action is a core intent whose\n * outcome reaches the shell's surfaces (DESIGN-V2 §7).\n */\nexport const Home = forwardRef<HTMLHeadingElement, HomeProps>(function Home({ snapshot, onAct, onNavigate }, ref) {\n    const tenant = snapshot.tenants.find((t) => t.id === snapshot.active?.tenant) ?? null\n    const context = snapshot.active?.context ?? null\n    const read = snapshot.inbox.read\n    const products = snapshot.administration?.products ?? []\n    const attention = snapshot.inbox.items.filter((e) => e.needsAction && !e.hold)\n    const shown = attention.slice(0, 5)\n    const needsRole = read.products.find((p) => p.state === 'needsRole') ?? null\n    const account = snapshot.harness.signIn?.account && snapshot.harness.signIn.failure === null ? snapshot.harness.signIn.account : null\n    const readNow = () => context && tenant && void onAct(SHELL_COPY.readOf(tenant.label), { kind: 'readTenant', context })\n    const hold = (kind: 'acknowledgeItem' | 'snoozeItem', id: string, title: string) => context && void onAct(holdWhat(kind, title), { kind, context, id })\n    // A recheck re-reads one product (C30); its admission is announced for the product.\n    const recheck = async (product: ProductId) => {\n        if (!context || !tenant) return\n        const label = READ_COPY.products[product] ?? product\n        const outcome = await onAct(SHELL_COPY.recheckOf(label, tenant.label), { kind: 'recheckProduct', context, product })\n        if (outcome.kind === 'admitted') useShellStore.getState().toast(READ_COPY.recheck(label), 'info', undefined, tenant.id, context)\n    }\n    const openProduct = (id: AdminProductId, tab?: string) => {\n        if (tenant) useShellStore.getState().arrive({ tenant: tenant.id, feature: 'administration', resource: null, item: null, product: id, tab })\n        onNavigate('administration')\n    }\n    const quick: { label: string; sub: string; key: string; glyph: GlyphName; go: () => void }[] = [\nimport type { Intent, Refusal } from '@prisma-airs/desktop-contracts'\n\n/** What the presentation learned about one delivered intent. */\nexport type DispatchOutcome =\n    /** Admitted; `operation` names native work the intent started, if any. */\n    | { kind: 'admitted'; operation: string | null }\n    | { kind: 'refused'; refusal: Refusal }\n    /** The desktop did not confirm admission; the current state is shown. */\n    | { kind: 'unknown' }\n    | { kind: 'failed' }\n\nexport type Dispatch = (intent: Intent) => Promise<DispatchOutcome>\n\nconst REFUSAL_TEXT: Record<Refusal, string> = {\n    staleContext: 'The active tenant changed before this was applied. Check the current tenant and try again.',\n    capabilityMissing: 'That is not available for the current tenant.',\n    invalidInput: 'Check the entered values and try again.',\n    reviewInvalid: 'This review is no longer valid. Start a new review.',\n    reviewConsumed: 'This review was already used.',\n    busy: 'The desktop is busy with a previous request. Try again in a moment.',\n    lockedStore: 'The Keychain is locked. Unlock it and try again.',\n    deniedStore: 'Local desktop data or the credential store is not available.',\n    alreadyProcessed: 'That request was already processed.',\n    sequenceGap: 'The request was not delivered in order. Try again.',\n    shuttingDown: 'The desktop is shutting down.',\n    decisionPending: 'A Harness decision is pending; resolve it before switching tenants.',\n}\n\n/** Sanitized operator text for an outcome that did not apply. */\nexport function outcomeMessage(outcome: DispatchOutcome): string | null {\n    switch (outcome.kind) {\n        case 'admitted':\n            return null\n        case 'refused':\n            return REFUSAL_TEXT[outcome.refusal]\n        case 'unknown':\n            return 'The desktop did not confirm the request. The current state is shown; check it before trying again.'\n        case 'failed':\n            return 'The request could not be delivered.'\n    }\n}\n102:                    useShellStore.getState().setScope(next.active?.tenant ?? null, next.active?.context ?? null)\n175:            onSwitchTenant={(tenant, resolution) => {\n180:                void v2Preference(SHELL_COPY.switchTo(label), { kind: 'selectTenant', tenant, resolution: resolution ?? null }, ['decisionPending'])\n182:            onReadNow={() => {\n184:                const active = snapshot.active\n187:                void v2Preference(SHELL_COPY.readOf(label), { kind: 'readTenant', context: active.context })\n190:            onAct={v2Act}\n10://! context is current (a retired context's reply is withdrawn and never\n144:    /// context the tenant no longer has is withdrawn when it lands and never\n210:    /// read when no current part is left (one generation); a withdrawn\n348:    /// withdrawn and the tenant stops waiting for it; nothing completed.\n442:    /// context's reply is withdrawn.\n543:    pub(super) fn product_read_refused(\n563:    pub(super) fn set_rechecking(&mut self, tenant: &TenantId, product: Option<ProductId>) {\n597:    pub(super) fn hold_insight(\n642:    pub(super) fn restore_insight(\n","exit_code":0,"status":"completed"}}
