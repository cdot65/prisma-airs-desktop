{"type":"item.completed","item":{"id":"item_33","type":"command_execution","command":"/bin/zsh -lc \"sed -n '410,565p' crates/xtask/src/budgets.rs; cat tools/perf/measure_c30.py; cat docs/planning/evidence/C29/live/L19-verify.json; cat docs/planning/reviews/C29/attempt-08/post-review-audit.json\"","aggregated_output":"        evidence: \"workload-perf.json\",\n    },\n    // Long typed input under an active assistive client (C03's open\n    // observation), registered by C24 before it measured it.\n    Workload {\n        registered_by: \"C24\",\n        registration: \"docs/planning/evidence/C24/workload-budget-registration.json\",\n        measured_by: \"C24\",\n        evidence: \"workload-perf.json\",\n    },\n    // The v2 tenant switch (D058): the new tenant's Home from cached\n    // scopes, registered by C30 before it measured it.\n    Workload {\n        registered_by: \"C30\",\n        registration: \"docs/planning/evidence/C30/workload-budget-registration.json\",\n        measured_by: \"C30\",\n        evidence: \"workload-perf.json\",\n    },\n];\n\n/// Budgets from a registered Markdown table:\n/// `| id | statistic | <limit> <unit> | samples | method |`.\npub fn workload_budgets(table: &str) -> Result<Vec<Budget>> {\n    let mut budgets = Vec::new();\n    for line in table.lines() {\n        let cells: Vec<&str> = line\n            .trim()\n            .trim_matches('|')\n            .split('|')\n            .map(str::trim)\n            .collect();\n        if cells.len() < 5 || cells[0] == \"Budget\" || cells[0].starts_with(\"---\") {\n            continue;\n        }\n        let (limit, unit) = cells[2]\n            .split_once(' ')\n            .ok_or_else(|| invalid(format!(\"budget row without a unit: {line}\")))?;\n        budgets.push(Budget {\n            id: cells[0].to_owned(),\n            statistic: cells[1].to_owned(),\n            limit: limit\n                .parse()\n                .map_err(|_| invalid(format!(\"budget limit is not a number: {line}\")))?,\n            unit: unit.to_owned(),\n            samples: cells[3]\n                .parse()\n                .map_err(|_| invalid(format!(\"budget sample count is not a number: {line}\")))?,\n        });\n    }\n    if budgets.is_empty() {\n        return Err(invalid(\"the registered workload table lists no budgets\"));\n    }\n    Ok(budgets)\n}\n\n/// The workload measurement record (tools/perf/measure_c05.py).\n#[derive(Clone, Debug, Deserialize)]\npub struct WorkloadPerf {\n    pub schema: String,\n    pub label: String,\n    pub registration_sha256: String,\n    pub started_utc: String,\n    pub executable_sha256: String,\n    pub metrics: BTreeMap<String, Metric>,\n}\n\n/// Where a subject's measurement of `workload` is recorded: the measuring\n/// chunk's `workload-perf.json`, or in a phase (which may measure several)\n/// `workload-perf-<measuring chunk>.json`, falling back to the one name\n/// phases with a single workload used.\nfn workload_evidence(dir: &std::path::Path, subject: Subject, workload: &Workload) -> String {\n    match subject {\n        // The cumulative chunk records every other chunk's workload under\n        // that chunk's name.\n        Subject::Chunk(c) if cumulative(subject) && format!(\"C{c:02}\") != workload.measured_by => {\n            format!(\"workload-perf-{}.json\", workload.measured_by)\n        }\n        Subject::Chunk(_) => workload.evidence.to_owned(),\n        Subject::Phase(_) => {\n            let named = format!(\"workload-perf-{}.json\", workload.measured_by);\n            if dir.join(&named).exists() {\n                named\n            } else {\n                workload.evidence.to_owned()\n            }\n        }\n    }\n}\n\nfn evaluate_workload(repo: &Repo, subject: Subject, workload: &Workload) -> Result<Vec<String>> {\n    let record: Registration = read_json(&repo.join(workload.registration))?;\n    let table_path = repo.join(&record.budgets);\n    let table = std::fs::read(&table_path).map_err(io_err(&table_path))?;\n    let table_sha = sha256_hex(&table);\n    if table_sha != record.budgets_sha256 {\n        return Err(invalid(format!(\n            \"{} (sha256 {table_sha}) does not match its {} registration ({}); a change needs a new registered version\",\n            record.budgets, workload.registered_by, record.budgets_sha256\n        )));\n    }\n    let budgets = workload_budgets(&String::from_utf8_lossy(&table))?;\n    let dir = repo.evidence_dir(subject);\n    let mut failures = Vec::new();\n    let prepared: Option<Prepared> = read_json(&dir.join(\"native-prepare.json\")).ok();\n    let evidence = workload_evidence(&dir, subject, workload);\n    let perf: WorkloadPerf = match read_json(&dir.join(&evidence)) {\n        Ok(perf) => perf,\n        Err(e) => return Ok(vec![format!(\"blocked: {e}\")]),\n    };\n    if perf.schema != \"airs-v2-workload-perf/1\" || perf.label != \"acceptance\" {\n        failures.push(format!(\"{evidence} is not an acceptance measurement\"));\n    }\n    if perf.registration_sha256 != table_sha {\n        failures.push(format!(\n            \"{evidence} names budgets {} not the registered {table_sha}\",\n            perf.registration_sha256\n        ));\n    }\n    if perf.started_utc < record.registered_utc {\n        failures.push(format!(\n            \"{evidence} started before the budgets were registered\"\n        ));\n    }\n    if prepared.as_ref().map(|p| p.executable_sha256.as_str())\n        != Some(perf.executable_sha256.as_str())\n    {\n        failures.push(format!(\n            \"{evidence} was not measured on the prepared fixture executable\"\n        ));\n    }\n    for budget in &budgets {\n        failures.extend(judge(budget, perf.metrics.get(&budget.id)));\n    }\n    Ok(failures)\n}\n\n/// One budget against its raw samples (statistic recomputed here).\nfn judge(budget: &Budget, metric: Option<&Metric>) -> Option<String> {\n    let Some(metric) = metric else {\n        return Some(format!(\"{}: no measurement\", budget.id));\n    };\n    if metric.unit != budget.unit {\n        return Some(format!(\n            \"{}: unit {} is not {}\",\n            budget.id, metric.unit, budget.unit\n        ));\n    }\n    if metric.samples.len() < budget.samples {\n        return Some(format!(\n            \"{}: {} samples, {} required\",\n            budget.id,\n            metric.samples.len(),\n            budget.samples\n        ));\n    }\n    match statistic(&budget.statistic, &metric.samples) {\n#!/usr/bin/env python3\n\"\"\"C30 measurement of the tenant-switch workload against the budget\nregistered before C30 measured it (docs/planning/evidence/C30/workload-budget.md,\nregistration in docs/planning/evidence/C30/workload-budget-registration.json).\n\n  measure_c30.py --label calibration|acceptance\n\nRun from the repository root on the prepared C30 fixture bundle. Only an\nacceptance run writes docs/planning/evidence/<subject>/workload-perf.json\n(in a phase, workload-perf-C30.json); it refuses to start unless the budget\ntable matches its registration. Raw samples are recorded; `xtask native`\nrecomputes the statistic.\n\nWorkload, on one launch in the v2 presentation against the synthetic\nmanagement endpoint on loopback, with Tenant A read once and Tenant B never\nread:\n\n- tenant-switch-home: from AXPress on the other tenant's row in the open\n  switcher to the Home heading and the new tenant's name line existing in\n  the accessibility tree (probe.swift activate, 2 ms polling); samples\n  alternate A→B and B→A.\n\"\"\"\n\nimport argparse\nimport hashlib\nimport json\nimport os\nimport sys\nimport tempfile\nimport time\n\nHERE = os.path.dirname(os.path.abspath(__file__))\nsys.path.insert(0, os.path.join(HERE, \"..\", \"native-acceptance\"))\nimport fixture_app as fx  # noqa: E402\nimport acceptance_c08 as c8  # noqa: E402\n\nROOT = os.getcwd()\nSUBJECT = os.environ.get(\"AIRS_NATIVE_SUBJECT\", \"C30\")\nEVIDENCE = os.path.join(ROOT, \"docs/planning/evidence\", SUBJECT)\nREGISTRATION = os.path.join(ROOT, \"docs/planning/evidence/C30/workload-budget-registration.json\")\n\n\ndef sha256_file(path):\n    with open(path, \"rb\") as f:\n        return hashlib.sha256(f.read()).hexdigest()\n\n\ndef utc():\n    return time.strftime(\"%Y-%m-%dT%H:%M:%SZ\", time.gmtime())\n\n\ndef open_switcher(app):\n    app.menu(\"Go\", \"Switch Tenant…\")\n    app.wait_for(lambda t: any(n.get(\"role\") == \"AXGroup\" and (n.get(\"label\") or \"\") == \"Switch tenant\" for n in t), 8)\n    time.sleep(0.3)\n\n\ndef main():\n    parser = argparse.ArgumentParser()\n    parser.add_argument(\"--label\", choices=[\"calibration\", \"acceptance\"], required=True)\n    label = parser.parse_args().label\n    registration = json.load(open(REGISTRATION))\n    table = os.path.join(ROOT, registration[\"budgets\"])\n    table_sha = sha256_file(table)\n    if table_sha != registration[\"budgets_sha256\"]:\n        raise SystemExit(\"the workload budget table does not match its C30 registration\")\n    prepared = json.load(open(os.path.join(EVIDENCE, \"native-prepare.json\")))\n    bundle = os.path.join(ROOT, prepared[\"bundle\"])\n    exe = os.path.join(bundle, \"Contents/MacOS/prisma-airs-desktop-v2\")\n    if sha256_file(exe) != prepared[\"executable_sha256\"]:\n        raise SystemExit(\"prepared executable changed since native-prepare\")\n    work = tempfile.mkdtemp(prefix=\"airs-v2-c30-perf-\")\n    probe = os.path.join(work, \"probe\")\n    built = fx.sh([\"swiftc\", \"-O\", os.path.join(HERE, \"probe.swift\"), \"-o\", probe])\n    if built.returncode != 0:\n        raise SystemExit(f\"probe did not build: {built.stderr}\")\n    started = utc()\n    app = fx.App(bundle, work, [])\n    app.quit()\n    fx.clean_fixture_root()\n    endpoint = fx.ScanEndpoint(os.path.join(work, \"endpoint\"), c8.SCAN_KEY)\n    endpoint.install_roots()\n    endpoint.start()\n    mgmt = c8.MgmtEndpoint(os.path.join(work, \"endpoint\"), os.path.join(work, \"mgmt\"))\n    mgmt.install()\n    mgmt.start()\n    mgmt.mode()\n    metrics, details = {}, {}\n    try:\n        app.launch()\n        # Two tenants in the legacy Settings, then the v2 presentation.\n        app.open_settings()\n        app.type_into(\"AXTextField\", \"TSG ID (optional)\", c8.TSG)\n        app.create_custom_tenant(\"Tenant A\", endpoint.origin)\n        app.save_key(c8.SCAN_KEY)\n        c8.save_client(app)\n        app.type_into(\"AXTextField\", \"TSG ID (optional)\", c8.TSG)\n        app.create_custom_tenant(\"Tenant B\", endpoint.origin)\n        app.make_active(\"Tenant A\")\n        app.ax(\"press\", \"AXCheckBox\", \"Use the new interface\")\n        app.wait_for(lambda t: fx.App.node(t, \"AXHeading\", \"Home\") is not None, 15)\n        # Tenant A read once: its Home shows the read status and items.\n        app.ax(\"press\", \"AXButton\", \"Read now\")\n        app.wait_for(lambda t: any(x.startswith(\"Read finished at\") for x in app.texts(t)), 30)\n        details[\"a_read\"] = True\n        samples = []\n        current = \"Tenant A\"\n        for _ in range(12):\n            other = \"Tenant B\" if current == \"Tenant A\" else \"Tenant A\"\n            open_switcher(app)\n            # Shown means the destination's Home with its own cached read status: Tenant A's\n            # finished read, Tenant B's first read still pending (never the other's).\n            status = \"Read finished at\" if other == \"Tenant A\" else \"First read pending\"\n            out = fx.sh([probe, \"activate\", str(app.pid), \"AXCheckBox\", other, \"Home\", f\"{other} ·\", \"10000\", status])\n            result = json.loads(out.stdout or \"{}\")\n            if \"ms\" in result:\n                samples.append(result[\"ms\"])\n            current = other\n            time.sleep(0.5)\n        metrics[\"tenant-switch-home\"] = {\"unit\": \"ms\", \"samples\": samples[2:]}\n        details[\"switches\"] = len(samples)\n    finally:\n        app.quit()\n        endpoint.stop()\n        mgmt.stop()\n        fx.clean_fixture_root()\n    record = {\n        \"schema\": \"airs-v2-workload-perf/1\",\n        \"label\": label,\n        \"registration_sha256\": table_sha,\n        \"started_utc\": started,\n        \"finished_utc\": utc(),\n        \"executable_sha256\": prepared[\"executable_sha256\"],\n        \"host\": fx.sh([\"sysctl\", \"-n\", \"hw.model\"]).stdout.strip(),\n        \"metrics\": metrics,\n        \"details\": details,\n    }\n    own = \"workload-perf.json\" if SUBJECT == \"C30\" else \"workload-perf-C30.json\"\n    name = own if label == \"acceptance\" else f\"workload-perf-calibration-{started.replace(':', '')}.json\"\n    path = os.path.join(EVIDENCE, name)\n    with open(path, \"w\") as f:\n        json.dump(record, f, indent=1)\n        f.write(\"\\n\")\n    for key, metric in metrics.items():\n        ordered = sorted(metric[\"samples\"])\n        if ordered:\n            p95 = ordered[max(1, -(-95 * len(ordered) // 100)) - 1]\n            print(f\"{key}: n={len(ordered)} p95={p95} max={ordered[-1]} {metric['unit']}\")\n    print(os.path.relpath(path, ROOT))\n    return 0\n\n\nif __name__ == \"__main__\":\n    sys.exit(main())\n{\n  \"schema\": \"airs-v2/live-row/1\",\n  \"subject\": \"C29\",\n  \"row\": \"verify against Vulture (reads only)\",\n  \"status\": \"pass\",\n  \"recorded_utc\": \"2026-11-01T13:38:19.467214+00:00\",\n  \"family\": \"L19\",\n  \"native_receipt\": \"docs/planning/evidence/C29/live/L19/attempt-03/receipt.json\",\n  \"native_receipt_sha256\": \"0d0b66212cd1483dbcab073050750de80e3277d29c875697302609e34855c202\",\n  \"manifest_sha256\": \"a2dd7b01ed289ed164859ac0daf6e582100de555d29eefb01fa13df87d0bdbe1\",\n  \"client_id\": \"prisma-airs-cli@1852583913.iam.panserviceaccount.com\",\n  \"tsg_id\": \"1852583913\",\n  \"operation\": \"one management credential verification through the first-run wizard (C29): one latest security-profile probe with limit=1; discard profile contents; no other inventory browsing or writes\",\n  \"executable_sha256\": \"8fb5a476b2a25adf2842286faa69e5393f5812ac3d7b65f87564eb0f05b54dca\",\n  \"source_inputs_sha256\": \"217a81f9ed49219bae0fa7946b9684ca6d2469b3c7f607d91b0c48816f09284c\",\n  \"current_source_match\": \"docs/planning/evidence/C29/live/L19/current-source-match.json\",\n  \"budget\": {\n    \"original_grant_reserved\": 2,\n    \"additional_explicit_owner_grant_cap\": 1,\n    \"additional_grant_reserved\": 1,\n    \"total_reserved\": 3,\n    \"refunded\": 0,\n    \"additional_grant_record\": \"docs/planning/evidence/C29/live/L19/additional-grant-01.json\"\n  },\n  \"temporary_local_credentials_removed\": true,\n  \"http_request_count_observed\": false,\n  \"limitations\": [\n    \"Request bound comes from the inspected production verifier (limit=1, latest=true, SDK retries=0) and exactly one wizard intent; no TLS interception or response body capture.\"\n  ],\n  \"historical_blocked_record\": \"docs/planning/evidence/C29/live/blocked.json (retained unchanged; superseded by this authorized actual run)\"\n}\n{\n  \"subject\": \"C29\",\n  \"attempt\": \"attempt-08\",\n  \"time\": \"2026-11-02T01:00:14.976978+00:00\",\n  \"transport\": {\n    \"invocation_sha256\": \"3ef4b6bdcde6da39dd7c66a74f8a27bbfa21654ca5070f4f0e85576344a6d4d3\",\n    \"thread_reply_sha256\": \"b6318c0d8e22fb1e1b9a61cc14d85a7bd81445d8d63141ebb5b71deb33c74b80\",\n    \"feature_probe_sha256\": \"bb4d01d583993c8e3c431e0437092e6c288e9b5da919595063853d37e2d89862\",\n    \"model_requested\": \"gpt-6.1-sol\",\n    \"harness_version_observed\": \"codex-cli 0.166.0\",\n    \"reviewer_sessions_observed\": [\n      \"01a199be-21fe-7641-bc5b-31d69c775565\"\n    ],\n    \"limits\": \"Observed CLI settings/events and unchanged inputs; not cryptographic proof of provider authorship.\"\n  },\n  \"raw_verdict_sha256\": \"881b4644b76313b2fb775c8841d951752b90154b42f9d60af87d3780f37645b6\",\n  \"request_sha256\": \"f30cc370180aea988d8498414b5cb82094d4c8ac9f9b5303deb5b22