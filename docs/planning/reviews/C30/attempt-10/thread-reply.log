{"type":"item.completed","item":{"id":"item_14","type":"command_execution","command":"/bin/zsh -lc 'cat crates/desktop-core/src/authority/inbox_domain.rs'","aggregated_output":"//! Inbox, reads and the tenant-switch guard (C30, screens/inbox-reads.md,\n//! invariants I1, I2, I4, I11, I12). Everything here is derived per tenant\n//! from scopes the core already owns: the Runtime overview read (its items,\n//! sources and failures), the operator's holds, the tenant's chosen\n//! products and its setup warnings (C29). The core computes the snooze\n//! return time, the per-product read status and whether a switch may\n//! proceed; the presentation renders them.\n\nuse serde::{Deserialize, Serialize};\nuse ts_rs::TS;\n\nuse super::observation_domain::{\n    FailedAttempt, HoldKind, OverviewView, ProductOutcome, SnoozeReceipt, product_sources,\n    source_names,\n};\nuse super::{PendingDecisionRef, Refusal, State, SwitchBlocked};\nuse crate::features::{FeatureId, ProductId, SetupWarning};\nuse crate::management::{ManagementFailure, ManagementResource};\nuse crate::observation::{Fact, InboxDestination, InboxItem, Tone};\nuse crate::tenants::TenantId;\n\n/// How a blocked switch is resolved (I1): the pending conversation is\n/// ended and kept (`archive`) or ended and dropped (`discard`).\n#[derive(Clone, Copy, Debug, PartialEq, Eq, Serialize, Deserialize, TS)]\n#[serde(rename_all = \"camelCase\")]\npub enum SwitchResolution {\n    Archive,\n    Discard,\n}\n\n/// Where an Inbox entry came from.\n#[derive(Clone, Copy, Debug, PartialEq, Eq, Serialize, TS)]\n#[serde(rename_all = \"camelCase\")]\npub enum InboxKind {\n    /// A Runtime overview item (sessions, keys).\n    Runtime,\n    /// The chosen Gateway workspace's day (C18).\n    Gateway,\n    /// A warning recorded at tenant setup (C29).\n    SetupWarning,\n    /// A key rotation in progress (C31, I7).\n    Rotation,\n}\n\n/// An operator's hold on an entry, with the core-computed return time.\n#[derive(Clone, Debug, PartialEq, Eq, Serialize, TS)]\n#[serde(rename_all = \"camelCase\")]\npub struct HoldView {\n    pub kind: HoldKind,\n    /// When a snoozed entry returns (seconds since the epoch); none for an\n    /// acknowledgment, which ends when the item's level rises.\n    pub returns_at: Option<u32>,\n}\n\n/// Where an entry's action leads (C30): the destination, and within it the\n/// product, the inventory and the item the presentation selects on arrival.\n#[derive(Clone, Debug, PartialEq, Eq, Serialize, TS)]\n#[serde(rename_all = \"camelCase\")]\npub struct InboxTarget {\n    pub feature: FeatureId,\n    pub product: Option<ProductId>,\n    /// The Administration inventory to open (API keys for a key item).\n    pub resource: Option<ManagementResource>,\n    /// The item's name within that inventory, for the filter.\n    pub item: Option<String>,\n}\n\n/// One Inbox entry of the active tenant.\n#[derive(Clone, Debug, PartialEq, Eq, Serialize, TS)]\n#[serde(rename_all = \"camelCase\")]\npub struct InboxEntry {\n    pub id: String,\n    pub kind: InboxKind,\n    /// Needs action (otherwise an update).\n    pub needs_action: bool,\n    pub severity: Tone,\n    pub title: String,\n    pub detail: String,\n    pub source: String,\n    pub product: Option<ProductId>,\n    /// Where the action leads, with the context it carries.\n    pub target: Option<InboxTarget>,\n    pub action_label: Option<String>,\n    pub facts: Vec<Fact>,\n    /// When it was observed or recorded (seconds since the epoch).\n    pub when: u32,\n    pub hold: Option<HoldView>,\n}\n\n/// The read as a whole.\n#[derive(Clone, Copy, Debug, PartialEq, Eq, Serialize, TS)]\n#[serde(rename_all = \"camelCase\")]\npub enum ReadState {\n    /// Nothing has been read for this tenant yet.\n    Pending,\n    Reading,\n    Done,\n    /// The last read failed; an older read may be shown.\n    Failed,\n}\n\n/// One product's part of the read.\n#[derive(Clone, Copy, Debug, PartialEq, Eq, Serialize, TS)]\n#[serde(rename_all = \"camelCase\")]\npub enum ProductReadState {\n    Pending,\n    Ok,\n    /// Some of its sources were not read.\n    Incomplete,\n    /// A source refused the client for permissions.\n    NeedsRole,\n    Failed,\n    /// Nothing reads this product on Home; its destination does.\n    NotRead,\n}\n\n#[derive(Clone, Debug, PartialEq, Eq, Serialize, TS)]\n#[serde(rename_all = \"camelCase\")]\npub struct ProductRead {\n    pub product: ProductId,\n    pub state: ProductReadState,\n    pub sources_read: u32,\n    pub sources_total: u32,\n    pub detail: Option<String>,\n}\n\n/// The active tenant's read status (I4), derived from the overview read.\n#[derive(Clone, Debug, PartialEq, Eq, Serialize, TS)]\n#[serde(rename_all = \"camelCase\")]\npub struct ReadStatus {\n    pub state: ReadState,\n    pub last_read_at: Option<u32>,\n    /// When the last read failed (seconds since the epoch); with\n    /// `last_read_at`, an older read is shown.\n    pub failed_at: Option<u32>,\n    /// When the latest attempt settled, established or not (seconds since\n    /// the epoch): the time a completion is announced with when nothing was\n    /// established yet.\n    pub settled_at: Option<u32>,\n    pub products: Vec<ProductRead>,\n    /// Sources the last read could not establish, by name.\n    pub sources_missing: Vec<String>,\n    /// Counts completed reads of this tenant in this session: a change is\n    /// a completion the presentation may announce.\n    pub generation: u32,\n    /// The product a `recheckProduct` asked for, until the next read lands.\n    pub rechecking: Option<ProductId>,\n}\n\n/// The Inbox scope (per tenant, I2).\n#[derive(Clone, Debug, PartialEq, Eq, Serialize, TS)]\n#[serde(rename_all = \"camelCase\")]\npub struct InboxView {\n    pub items: Vec<InboxEntry>,\n    pub read: ReadStatus,\n    /// The last snooze placed on this tenant in this session (I11).\n    pub last_snooze: Option<SnoozeReceipt>,\n}\n\nfn product_label(product: ProductId) -> &'static str {\n    match product {\n        ProductId::RuntimeSecurity => \"AI Runtime Security\",\n        ProductId::Gateway => \"AI Gateway\",\n        ProductId::RedTeam => \"AI Red Teaming\",\n        ProductId::ModelSkill => \"Model and skill scans\",\n    }\n}\n\nfn warning_destination(product: ProductId) -> InboxDestination {\n    match product {\n        ProductId::Gateway => InboxDestination::Gateway,\n        _ => InboxDestination::ApiKeys,\n    }\n}\n\n/// Where a setup warning is fixed (C30): the scan key and the management\n/// client live in Settings, a Gateway workspace in AI Gateway, the Red Team\n/// and model/skill services in AI Red Teaming.\nfn warning_target(product: ProductId) -> (InboxTarget, &'static str) {\n    let (feature, label) = match product {\n        ProductId::RuntimeSecurity => (FeatureId::Settings, \"Open Settings\"),\n        ProductId::Gateway => (FeatureId::Gateway, \"Open AI Gateway\"),\n        ProductId::RedTeam | ProductId::ModelSkill => (FeatureId::RedTeam, \"Open AI Red Teaming\"),\n    };\n    (\n        InboxTarget {\n            feature,\n            product: Some(product),\n            resource: None,\n            item: None,\n        },\n        label,\n    )\n}\n\n/// Where a Runtime overview item's action leads: an API key item opens the\n/// API keys inventory filtered to that key.\nfn item_target(item: &InboxItem) -> InboxTarget {\n    match item.destination {\n        InboxDestination::ApiKeys => InboxTarget {\n            feature: FeatureId::Administration,\n            product: Some(ProductId::RuntimeSecurity),\n            resource: Some(ManagementResource::ApiKeys),\n            item: item\n                .facts\n                .iter()\n                .find(|f| f.label == \"Key\")\n                .map(|f| f.value.clone()),\n        },\n        InboxDestination::Sessions => InboxTarget {\n            feature: FeatureId::Sessions,\n            product: Some(ProductId::RuntimeSecurity),\n            resource: None,\n            item: None,\n        },\n        InboxDestination::Gateway => InboxTarget {\n            feature: FeatureId::Gateway,\n            product: Some(ProductId::Gateway),\n            resource: None,\n            item: None,\n        },\n    }\n}\n\n/// A setup warning as an attention item (C29 → C30): the item id is the\n/// warning's `vw-<n>`, so holds address it like any other item.\npub(super) fn setup_warning_item(w: &SetupWarning) -> InboxItem {\n    InboxItem {\n        id: w.id.clone(),\n        title: format!(\"{}: setup warning\", product_label(w.product)),\n        detail: w.reason.clone(),\n        source: \"Setup · verify\".to_owned(),\n        action: true,\n        tone: Tone::Warn,\n        destination: warning_destination(w.product),\n        action_label: warning_target(w.product).1.to_owned(),\n        facts: vec![Fact {\n            label: \"Product\".to_owned(),\n            value: product_label(w.product).to_owned(),\n        }],\n        per_mille: None,\n    }\n}\n\nfn source_state(failure: Option<ManagementFailure>) -> ProductReadState {\n    match failure {\n        None => ProductReadState::Ok,\n        Some(ManagementFailure::Denied | ManagementFailure::Unauthorized) => {\n            ProductReadState::NeedsRole\n        }\n        Some(_) => ProductReadState::Failed,\n    }\n}\n\nfn pending(product: ProductId) -> ProductRead {\n    ProductRead {\n        product,\n        state: ProductReadState::Pending,\n        sources_read: 0,\n        sources_total: product_sources(product),\n        detail: None,\n    }\n}\n\nfn needs_role_failure(failure: Option<ManagementFailure>) -> bool {\n    matches!(\n        failure,\n        Some(ManagementFailure::Denied | ManagementFailure::Unauthorized)\n    )\n}\n\nfn combined(needs_role: bool, read_count: u32, total: u32) -> ProductReadState {\n    if needs_role {\n        ProductReadState::NeedsRole\n    } else if read_count == total {\n        ProductReadState::Ok\n    } else if read_count == 0 {\n        ProductReadState::Failed\n    } else {\n        ProductReadState::Incomplete\n    }\n}\n\n/// A product's finite outcome as its read entry, naming each source it\n/// did not establish.\nfn product_read(\n    product: ProductId,\n    o: &ProductOutcome,\n    sources_missing: &mut Vec<String>,\n) -> ProductRead {\n    let state = combined(o.needs_role, o.sources_read, o.sources_total);\n    sources_missing.extend(o.missing.iter().cloned());\n    ProductRead {\n        product,\n        state,\n        sources_read: o.sources_read,\n        sources_total: o.sources_total,\n        detail: Some(match (state, o.failure) {\n            (ProductReadState::Ok, _) => o.detail.clone(),\n            (_, Some(f)) => format!(\"{f:?}: {}\", o.detail),\n            (_, None) => o.detail.clone(),\n        }),\n    }\n}\n\n/// A product whose latest attempt established nothing: its failure, with\n/// every source named missing and the retained older read (if any) named.\nfn failed_product(\n    product: ProductId,\n    f: &FailedAttempt,\n    kept: Option<&ProductOutcome>,\n    sources_missing: &mut Vec<String>,\n) -> ProductRead {\n    let names = source_names(product);\n    sources_missing.extend(names.iter().map(|n| (*n).to_owned()));\n    let older = kept.map_or(String::new(), |o| {\n        format!(\"; the read from {} ({}) is kept\", o.read_at, o.detail)\n    });\n    ProductRead {\n        product,\n        state: if f.needs_role {\n            ProductReadState::NeedsRole\n        } else {\n            ProductReadState::Failed\n        },\n        sources_read: 0,\n        sources_total: names.len() as u32,\n        detail: Some(match f.failure {\n            Some(failure) => format!(\"{failure:?}: {}{older}\", f.detail),\n            None => format!(\"{}{older}\", f.detail),\n        }),\n    }\n}\n\nimpl State {\n    /// The decision the active tenant's conversation is waiting for, if any.\n    pub(super) fn pending_decision(&self) -> Option<PendingDecisionRef> {\n        let conversation = self.live_bound_harness()?;\n        let approvals = self.bound_approvals();\n        let first = approvals.first()?;\n        Some(PendingDecisionRef {\n            conversation: conversation.as_str().to_owned(),\n            decision: first.id.clone(),\n        })\n    }\n\n    /// Admits a tenant switch, or refuses it while a decision is pending\n    /// (I1): the refusal carries the guard the presentation renders.\n    pub(super) fn guard_switch(\n        &mut self,\n        to: &TenantId,\n        resolution: Option<SwitchResolution>,\n        completion: bool,\n    ) -> Result<(), Refusal> {\n        let Some(pending) = self.pending_decision() else {\n            self.switch_blocked = None;\n            return Ok(());\n        };\n        let id = self.live_bound_harness().ok_or(Refusal::Busy)?;\n        match resolution {\n            None => {\n                self.switch_blocked = Some(SwitchBlocked {\n                    to: to.clone(),\n                    pending,\n                    completion,\n                });\n                Err(Refusal::DecisionPending)\n            }\n            Some(SwitchResolution::Archive) => {\n                self.end_harness(&id)?;\n                self.switch_blocked = None;\n                Ok(())\n            }\n            Some(SwitchResolution::Discard) => {\n                self.discard_harness(&id)?;\n                self.switch_blocked = None;\n                Ok(())\n            }\n        }\n    }\n\n    /// The active tenant's setup warnings as items.\n    pub(super) fn setup_warning_items(&self) -> Vec<InboxItem> {\n        self.data\n            .active\n            .as_ref()\n            .and_then(|id| self.tenant(id))\n            .map(|t| t.setup_warnings.iter().map(setup_warning_item).collect())\n            .unwrap_or_default()\n    }\n\n    /// The products the active tenant chose (Runtime Security until a setup\n    /// chooses more).\n    pub(super) fn selected_products(&self, tenant: &TenantId) -> Vec<ProductId> {\n        self.tenant(tenant)\n            .map(|t| {\n                if t.products.is_empty() {\n                    vec![ProductId::RuntimeSecurity]\n                } else {\n                    t.products.clone()\n                }\n            })\n            .unwrap_or_default()\n    }\n\n    /// The per-product read status (I4) from the overview read, the other\n    /// products' finite outcomes and the tenant's chosen products. Coverage\n    /// a read did not establish is named in `sources_missing`, so nothing\n    /// unread is ever announced as complete.\n    pub(super) fn read_status(&self, overview: &OverviewView) -> ReadStatus {\n        let products = self\n            .data\n            .active\n            .as_ref()\n            .map(|id| self.selected_products(id))\n            .unwrap_or_default();\n        let record = self.active_record();\n        // A refresh in which no source answered is shown by the overview for\n        // its gaps (C12) but established nothing: it is not a read.\n        let read = overview.read.as_ref().filter(|r| {\n            !(overview.failure.is_some() && r.chart.is_none() && r.keys_failure.is_some())\n        });\n        let outcomes_read = record.is_some_and(|r| r.red_team.is_some() || r.model_skill.is_some());\n        // The latest failed attempts across the chosen products; a missing\n        // role is a settled attempt reported on the product, not a failed read.\n        let attempts: Vec<&FailedAttempt> = record\n            .map(|r| {\n                [\n                    (ProductId::RedTeam, r.red_team_failed.as_ref()),\n                    (ProductId::ModelSkill, r.model_skill_failed.as_ref()),\n                ]\n                .into_iter()\n                .filter(|(p, _)| products.contains(p))\n                .filter_map(|(_, f)| f)\n                .collect()\n            })\n            .unwrap_or_default();\n        let product_failures: Vec<&FailedAttempt> =\n            attempts.iter().copied().filter(|f| !f.needs_role).collect();\n        let failed_at = overview\n            .failed_at\n            .into_iter()\n            .chain(product_failures.iter().map(|f| f.at))\n            .max();\n        // Attempted: something settled for this tenant, established or not.\n        let attempted =\n            read.is_some() || outcomes_read || overview.failure.is_some() || !attempts.is_empty();\n        // A failed read is failed, however little it established: never\n        // \"pending\" (it was attempted) and never \"done\".\n        let state = if overview.refreshing {\n            ReadState::Reading\n        } else if overview.failure.is_some() || !product_failures.is_empty() {\n            ReadState::Failed\n        } else if !attempted {\n            ReadState::Pending\n        } else {\n            ReadState::Done\n        };\n        let failed_without_data = |product: ProductId, sources_missing: &mut Vec<String>| {\n            let names = source_names(product);\n            sources_missing.extend(names.iter().map(|n| (*n).to_owned()));\n            ProductRead {\n                product,\n                state: if needs_role_failure(overview.failure) {\n                    ProductReadState::NeedsRole\n                } else {\n                    ProductReadState::Failed\n                },\n                sources_read: 0,\n                sources_total: names.len() as u32,\n                detail: overview.failure.map(|f| format!(\"{f:?}\")),\n            }\n        };\n        let mut sources_missing = Vec::new();\n        let mut per_product = Vec::new();\n        for product in products.clone() {\n            let entry = match product {\n                ProductId::RuntimeSecurity => match read {\n                    None if overview.failure.is_some() => {\n                        failed_without_data(product, &mut sources_missing)\n                    }\n                    None => pending(product),\n                    Some(r) => {\n                        // Established means read and whole: a chart with\n                        // inconsistent totals or a key page with an unreported\n                        // expiration is unread coverage, not a complete read.\n                        let chart = if r.chart_failure.is_some() {\n                            source_state(r.chart_failure)\n                        } else if r.chart_established() {\n                            ProductReadState::Ok\n                        } else {\n                            ProductReadState::Incomplete\n                        };\n                        let keys = if r.keys_failure.is_some() {\n                            source_state(r.keys_failure)\n                        } else if r.keys_established() {\n                            ProductReadState::Ok\n                        } else {\n                            ProductReadState::Incomplete\n                        };\n                        if chart != ProductReadState::Ok {\n                            sources_missing.push(\"sessions chart\".to_owned());\n                        }\n                        if keys != ProductReadState::Ok {\n                            sources_missing.push(\"API keys\".to_owned());\n                        }\n                        let read_count = u32::from(chart == ProductReadState::Ok)\n                            + u32::from(keys == ProductReadState::Ok);\n                        let state = combined(\n                            chart == ProductReadState::NeedsRole\n                                || keys == ProductReadState::NeedsRole,\n                            read_count,\n                            2,\n                        );\n                        ProductRead {\n                            product,\n                            state,\n                            sources_read: read_count,\n                            sources_total: 2,\n                            detail: (state != ProductReadState::Ok).then(|| {\n                                r.chart_failure.or(r.keys_failure).map_or_else(\n                                    || {\n                                        r.gaps\n                                            .iter()\n                                            .find(|g| {\n                                                g.contains(\"unreported\") || g.starts_with(\"Runtime\")\n                                            })\n                                            .cloned()\n                                            .unwrap_or_else(|| {\n                                                \"the key inventory was not complete\".to_owned()\n                                            })\n                                    },\n                                    |f| format!(\"{f:?}\"),\n                                )\n                            }),\n                        }\n                    }\n                },\n                ProductId::Gateway => match read {\n                    None if overview.failure.is_some() => {\n                        failed_without_data(product, &mut sources_missing)\n                    }\n                    None => pending(product),\n                    // A chosen product without a workspace is unread coverage,\n                    // not a complete read.\n                    Some(r) if r.gateway.is_none() => {\n                        sources_missing.push(\"Gateway workspace (none chosen)\".to_owned());\n                        ProductRead {\n                            product,\n                            state: ProductReadState::Incomplete,\n                            sources_read: 0,\n                            sources_total: 2,\n                            detail: Some(\n                                \"No Gateway workspace chosen; choose one in AI Gateway.\".to_owned(),\n                            ),\n                        }\n                    }\n                    Some(r) => {\n                        let g = r.gateway.as_ref().expect(\"checked\");\n                        // Usage is established only when the day's requests\n                        // and errors are both known (read, whole, reported).\n                        let usage = if g.usage_failure.is_some() {\n                            source_state(g.usage_failure)\n                        } else if g.activity_known() {\n                            ProductReadState::Ok\n                        } else {\n                            ProductReadState::Incomplete\n                        };\n                        let limits = if g.limits_failure.is_some() {\n                            source_state(g.limits_failure)\n                        } else if g.policies.is_some() {\n                            ProductReadState::Ok\n                        } else {\n                            ProductReadState::Incomplete\n                        };\n                        if usage != ProductReadState::Ok {\n                            sources_missing.push(\"Gateway usage\".to_owned());\n                        }\n                        if limits != ProductReadState::Ok {\n                            sources_missing.push(\"Gateway limits\".to_owned());\n                        }\n                        let read_count = u32::from(usage == ProductReadState::Ok)\n                            + u32::from(limits == ProductReadState::Ok);\n                        let state = combined(\n                            usage == ProductReadState::NeedsRole\n                                || limits == ProductReadState::NeedsRole,\n                            read_count,\n                            2,\n                        );\n                        ProductRead {\n                            product,\n                            state,\n                            sources_read: read_count,\n                            sources_total: 2,\n                            detail: (state != ProductReadState::Ok)\n                                .then(|| format!(\"workspace {}\", g.workspace_name)),\n                        }\n                    }\n                },\n                ProductId::RedTeam | ProductId::ModelSkill => {\n                    let (outcome, failed) = record.map_or((None, None), |r| match product {\n                        ProductId::RedTeam => (r.red_team.as_ref(), r.red_team_failed.as_ref()),\n                        _ => (r.model_skill.as_ref(), r.model_skill_failed.as_ref()),\n                    });\n                    match (outcome, failed) {\n                        (None, None) => pending(product),\n                        // The latest attempt established nothing: reported as\n                        // such, with the retained read (if any) named as older.\n                        (kept, Some(f)) => failed_product(product, f, kept, &mut sources_missing),\n                        (Some(o), None) => product_read(product, o, &mut sources_missing),\n                    }\n                }\n            };\n            per_product.push(entry);\n        }\n        // Once anything was attempted, a chosen product nothing has reached\n        // yet is unread coverage like any other (I4): named, so no completion\n        // is announced as complete over it.\n        if attempted {\n            for entry in per_product\n                .iter()\n                .filter(|p| p.state == ProductReadState::Pending)\n            {\n                sources_missing.extend(source_names(entry.product).iter().map(|n| (*n).to_owned()));\n            }\n        }\n        let last_read_at = read\n            .map(|r| r.read_at)\n            .into_iter()\n            .chain(record.and_then(|r| r.red_team.as_ref()).map(|o| o.read_at))\n            .chain(\n                record\n                    .and_then(|r| r.model_skill.as_ref())\n                    .map(|o| o.read_at),\n            )\n            .max();\n        let settled_at = last_read_at\n            .into_iter()\n            .chain(overview.failed_at)\n            .chain(attempts.iter().map(|f| f.at))\n            .max();\n        ReadStatus {\n            state,\n            last_read_at,\n            failed_at,\n            settled_at,\n            products: per_product,\n            sources_missing,\n            generation: record.map_or(0, |r| r.generation),\n            rechecking: record.and_then(|r| r.rechecking),\n        }\n    }\n\n    /// The active tenant's Inbox (I2): overview items with their holds and\n    /// the tenant's setup warnings; nothing of another tenant.\n    pub(super) fn inbox_view(&self, overview: &OverviewView) -> InboxView {\n        let now = self.clock();\n        let holds = self.active_holds();\n        let mut items = Vec::new();\n        let read_at = overview.read.as_ref().map_or(now, |r| r.read_at);\n        let hold_of = |item: &InboxItem| -> Option<HoldView> {\n            holds.iter().find_map(|h| {\n                if h.id != item.id {\n                    return None;\n                }\n                match h.kind {\n                    HoldKind::Acknowledge if crate::observation::level(item) <= h.level => {\n                        Some(HoldView {\n                            kind: HoldKind::Acknowledge,\n                            returns_at: None,\n                        })\n                    }\n                    HoldKind::Snooze if now < h.until => Some(HoldView {\n                        kind: HoldKind::Snooze,\n                        returns_at: Some(h.until),\n                    }),\n                    _ => None,\n                }\n            })\n        };\n        for item in overview.read.iter().flat_map(|r| r.items.iter()) {\n            let (kind, product) = if item.id.starts_with(\"gateway-\") {\n                (InboxKind::Gateway, Some(ProductId::Gateway))\n            } else {\n                (InboxKind::Runtime, Some(ProductId::RuntimeSecurity))\n            };\n            items.push(InboxEntry {\n                id: item.id.clone(),\n                kind,\n                needs_action: item.action,\n                severity: item.tone,\n                title: item.title.clone(),\n                detail: item.detail.clone(),\n                source: item.source.clone(),\n                product,\n                target: Some(item_target(item)),\n                action_label: Some(item.action_label.clone()),\n                facts: item.facts.clone(),\n                when: read_at,\n                hold: hold_of(item),\n            });\n        }\n        if let Some(tenant) = self.data.active.as_ref().and_then(|id| self.tenant(id)) {\n            for w in &tenant.setup_warnings {\n                let item = setup_warning_item(w);\n                let (target, label) = warning_target(w.product);\n                items.push(InboxEntry {\n                    id: w.id.clone(),\n                    kind: InboxKind::SetupWarning,\n                    needs_action: true,\n                    severity: Tone::Warn,\n                    title: item.title.clone(),\n                    detail: w.reason.clone(),\n                    source: item.source.clone(),\n                    product: Some(w.product),\n                    target: Some(target),\n                    action_label: Some(label.to_owned()),\n                    facts: item.facts.clone(),\n                    when: w.recorded_secs,\n                    hold: hold_of(&item),\n                });\n            }\n        }\n        for item in self.rotation_items() {\n            items.push(InboxEntry {\n                id: item.id.clone(),\n                kind: InboxKind::Rotation,\n                needs_action: true,\n                severity: Tone::Warn,\n                title: item.title.clone(),\n                detail: item.detail.clone(),\n                source: item.source.clone(),\n                product: Some(ProductId::RuntimeSecurity),\n                target: Some(InboxTarget {\n                    feature: FeatureId::Administration,\n                    product: Some(ProductId::RuntimeSecurity),\n                    resource: Some(ManagementResource::ApiKeys),\n                    item: item\n                        .facts\n                        .iter()\n                        .find(|f| f.label == \"Old key\")\n                        .map(|f| f.value.clone()),\n                }),\n                action_label: Some(item.action_label.clone()),\n                facts: item.facts.clone(),\n                when: self\n                    .data\n                    .active\n                    .as_ref()\n                    .and_then(|id| self.tenant(id))\n                    .and_then(|t| {\n                        t.rotations\n                            .iter()\n                            .find(|r| {\n                                super::rotation_domain::rotation_item_id(&r.application) == item.id\n                            })\n                            .map(|r| r.issued_at)\n                    })\n                    .unwrap_or(read_at),\n                hold: hold_of(&item),\n            });\n        }\n        InboxView {\n            items,\n            read: self.read_status(overview),\n            last_snooze: self.active_record().and_then(|r| r.last_snooze.clone()),\n        }\n    }\n}\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_15","type":"command_execution","command":"/bin/zsh -lc 'cat apps/desktop/src/v2/inbox/inbox.tsx apps/desktop/src/v2/home.tsx apps/desktop/src/v2/switch-guard.tsx apps/desktop/src/v2/copy.ts'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_15","type":"command_execution","command":"/bin/zsh -lc 'cat apps/desktop/src/v2/inbox/inbox.tsx apps/desktop/src/v2/home.tsx apps/desktop/src/v2/switch-guard.tsx apps/desktop/src/v2/copy.ts'","aggregated_output":"import { forwardRef, useEffect } from 'react'\nimport type { FeatureId, InboxEntry, Intent, ProductId, ShellSnapshot } from '@prisma-airs/desktop-contracts'\nimport type { DispatchOutcome } from '../../features/tenants/dispatch'\nimport { INBOX_COPY as C, READ_COPY, SHELL_COPY, SNOOZE_COPY, clockOf } from '../copy'\nimport { Glyph, type GlyphName } from '../icons'\nimport { useShellStore } from '../store'\nimport type { VerdictTone } from '../verdict'\n\n/**\n * Sends one intent and reports its outcome on the shell's surfaces (DESIGN-V2\n * §7): a refusal or failed delivery as a warn toast naming `what`, an\n * unconfirmed delivery inline with Retry (never replayed on its own).\n */\nexport type Act = (what: string, intent: Intent) => Promise<DispatchOutcome>\n\nexport interface InboxProps {\n    snapshot: ShellSnapshot\n    onAct: Act\n    onNavigate: (feature: FeatureId) => void\n}\n\nexport type InboxTab = 'all' | 'action' | 'updates' | 'snoozed'\nconst TABS: InboxTab[] = ['all', 'action', 'updates', 'snoozed']\n\nexport const toneOf = (severity: InboxEntry['severity']): VerdictTone => (severity === 'bad' ? 'blocked' : severity === 'warn' ? 'flagged' : 'info')\n\n/** Where an entry's action leads (C30): the destination the core names. */\nexport function destinationFeature(entry: InboxEntry): FeatureId | null {\n    return entry.target?.feature ?? null\n}\n\n/**\n * Follows an entry's contextual action: the target's inventory and item are\n * handed to the destination (it selects them on arrival), then the shell\n * navigates through the core.\n */\nexport function follow(entry: InboxEntry, tenant: string, onNavigate: (feature: FeatureId) => void) {\n    const target = entry.target\n    if (!target) return\n    // The target belongs to the tenant it was followed in (I2): another tenant never inherits it.\n    useShellStore.getState().arrive({ tenant, feature: target.feature, resource: target.resource, item: target.item })\n    onNavigate(target.feature)\n}\n\n/** The tenant-named description of a hold action, for its outcome report. */\nexport function holdWhat(kind: 'acknowledgeItem' | 'snoozeItem' | 'unsnoozeItem', title: string): string {\n    return kind === 'acknowledgeItem' ? SHELL_COPY.acknowledgmentOf(title) : kind === 'snoozeItem' ? SHELL_COPY.snoozeOf(title) : SHELL_COPY.unsnoozeOf(title)\n}\n\n/** Which tab an entry belongs to; held entries are never \"needs action\". */\nexport function tabOf(entry: InboxEntry): InboxTab {\n    if (entry.hold?.kind === 'snooze') return 'snoozed'\n    if (entry.needsAction && !entry.hold) return 'action'\n    return 'updates'\n}\n\nconst severityTile = (severity: InboxEntry['severity']): { glyph: GlyphName; fg: string; bg: string } =>\n    severity === 'bad' ? { glyph: 'ban', fg: 'var(--v2-block)', bg: 'var(--v2-block-bg)' } : severity === 'warn' ? { glyph: 'alert', fg: 'var(--v2-flag)', bg: 'var(--v2-flag-bg)' } : { glyph: 'info', fg: 'var(--v2-soft)', bg: 'var(--v2-inset)' }\n\nconst button32 = 'flex h-8 min-h-0 items-center rounded-[7px] text-[13px] whitespace-nowrap'\n\n/**\n * The Inbox (C30, screens/inbox-reads.md): the active tenant's entries from\n * the core's Inbox scope, in tabs with counts, a detail pane with the facts,\n * the explanation and the contextual actions. Acknowledge and snooze are\n * core intents on the entry; the snooze return time is the core's and the\n * label is the one Home uses (I11). The selected tab and item are kept per\n * tenant across a switch (I2) and cleared when the tenant is deleted.\n */\nexport const Inbox = forwardRef<HTMLHeadingElement, InboxProps>(function Inbox({ snapshot, onAct, onNavigate }, ref) {\n    const tenant = snapshot.tenants.find((t) => t.id === snapshot.active?.tenant) ?? null\n    const context = snapshot.active?.context ?? null\n    const tenantKey = tenant?.id ?? 'none'\n    const selection = useShellStore((s) => s.inboxSelection[tenantKey])\n    const selectInbox = useShellStore((s) => s.selectInbox)\n    const tab: InboxTab = selection?.tab ?? 'all'\n    const selectedId = selection?.item ?? null\n    const items = snapshot.inbox.items\n    const counts: Record<InboxTab, number> = { all: items.length, action: 0, updates: 0, snoozed: 0 }\n    for (const e of items) counts[tabOf(e)] += 1\n    const visible = items.filter((e) => tab === 'all' || tabOf(e) === tab)\n    const selected = items.find((e) => e.id === selectedId) ?? null\n    useEffect(() => {\n        if (selectedId && !items.some((e) => e.id === selectedId)) selectInbox(tenantKey, { tab, item: null })\n    }, [items, selectedId, selectInbox, tenantKey, tab])\n    const read = snapshot.inbox.read\n\n    // Holds are core intents; their outcomes reach the shell's surfaces. A\n    // snooze's return time is the core's: the shell announces it from the\n    // receipt the snapshot carries (the same toast whether asked here or on Home).\n    const act = (entry: InboxEntry, kind: 'acknowledgeItem' | 'snoozeItem' | 'unsnoozeItem') => context && void onAct(holdWhat(kind, entry.title), { kind, context, id: entry.id })\n    const readNow = () => context && tenant && void onAct(SHELL_COPY.readOf(tenant.label), { kind: 'readTenant', context })\n\n    // Never attempted, in progress, failed, partial, expired and healthy-empty\n    // reads stay distinct (I4, C12). Entries the core supplies (a setup\n    // warning before any read) are listed whatever the read status.\n    const failedUnread = read.state === 'failed' && read.lastReadAt === null && read.failedAt !== null\n    const stale = (read.state === 'done' || read.state === 'reading') && read.lastReadAt !== null && !snapshot.overview.fresh\n    const readingAgain = read.state === 'reading' && read.lastReadAt !== null\n    const empty = !tenant\n        ? C.emptyPending\n        : items.length === 0 && read.state === 'reading'\n          ? C.emptyReading\n          : items.length === 0 && read.state === 'pending'\n            ? C.emptyPending\n            : items.length === 0 && failedUnread\n              ? C.emptyFailed(clockOf(read.failedAt ?? 0))\n              : items.length === 0 && read.lastReadAt === null && read.settledAt !== null\n                ? C.emptyUnread(clockOf(read.settledAt), read.sourcesMissing.length)\n                : visible.length === 0\n                  ? tab === 'all' || tab === 'action'\n                      ? read.sourcesMissing.length > 0\n                          ? C.emptyPartial(read.products.reduce((n, p) => n + p.sourcesRead, 0), read.products.reduce((n, p) => n + p.sourcesTotal, 0), read.sourcesMissing)\n                          : stale\n                            ? C.emptyStale(clockOf(read.lastReadAt ?? 0))\n                            : C.emptyClear\n                      : C.emptyTab\n                  : null\n    const partialLine =\n        read.state === 'failed' && read.failedAt !== null && read.lastReadAt !== null\n            ? C.failedKept(clockOf(read.failedAt), clockOf(read.lastReadAt))\n            : (read.lastReadAt ?? read.settledAt) !== null && read.sourcesMissing.length > 0\n              ? C.partial(read.products.reduce((n, p) => n + p.sourcesRead, 0), read.products.reduce((n, p) => n + p.sourcesTotal, 0), clockOf(read.lastReadAt ?? read.settledAt ?? 0))\n              : readingAgain\n                ? stale\n                    ? C.readingStale(clockOf(read.lastReadAt ?? 0))\n                    : C.readingKept(clockOf(read.lastReadAt ?? 0))\n                : stale\n                  ? C.stale(clockOf(read.lastReadAt ?? 0))\n                  : null\n\n    // The empty states' role issue, the footer's coverage lines and the product hand-off (C37, R2App).\n    const needsRole = read.products.find((p) => p.state === 'needsRole') ?? null\n    const openProduct = (id: ProductId) => {\n        if (tenant) useShellStore.getState().arrive({ tenant: tenant.id, feature: 'administration', resource: null, item: null, product: id })\n        onNavigate('administration')\n    }\n    const sourcesRead = read.products.reduce((n, p) => n + p.sourcesRead, 0)\n    const sourcesTotal = read.products.reduce((n, p) => n + p.sourcesTotal, 0)\n    const readAt = read.lastReadAt ?? read.settledAt\n    const footLine1 = !tenant || readAt === null ? C.footNoReads(tenant?.label ?? '') : read.sourcesMissing.length > 0 ? C.footPartial(sourcesRead, sourcesTotal, clockOf(readAt)) : C.footAll(clockOf(readAt))\n    const gateway = snapshot.overview.read?.gateway ?? null\n    const footLine2 = gateway ? C.footGateway(gateway.workspaceName, gateway.policies) : (snapshot.overview.read?.gaps[0] ?? '')\n\n    return (\n        <section aria-labelledby='inbox-heading' data-slot='inbox' className='flex min-h-0 flex-grow flex-col' style={{ gap: 20 }}>\n            <div className='flex items-end' style={{ gap: 12 }}>\n                <div>\n                    <h1 ref={ref} id='inbox-heading' tabIndex={-1} className='font-bold' style={{ fontSize: 'var(--v2-title)', letterSpacing: '-0.01em' }}>\n                        {C.title}\n                    </h1>\n                    <p role='status' data-slot='inbox-sub' className='text-[14px]' style={{ marginTop: 4, color: 'var(--v2-soft)' }}>\n                        {tenant ? C.sub(tenant.label) : C.emptyPending}\n                        {partialLine ? ` · ${partialLine}` : ''}\n                    </p>\n                </div>\n                {context && (\n                    <button type='button' onClick={readNow} disabled={read.state === 'reading'} className={`${button32} ml-auto border px-3.5 disabled:opacity-60`} style={{ borderColor: 'var(--v2-rule)', background: 'var(--v2-paper)', color: 'var(--v2-ink)' }}>\n                        {read.state === 'reading' ? C.reading : C.readNow}\n                    </button>\n                )}\n            </div>\n            {/* The list column is the prototype's 430px beside the detail; one under the other when both cannot fit (200% zoom, a narrow window). */}\n            <div data-slot='inbox-columns' className='grid min-h-0 min-w-0 flex-grow' style={{ gridTemplateColumns: 'minmax(0, 430px) minmax(0, 1fr)', gap: 20 }}>\n                <section aria-label={C.listCard} data-slot='inbox-list' className='flex min-h-0 min-w-0 flex-col overflow-hidden rounded-[12px] border' style={{ borderColor: 'var(--v2-rule)', background: 'var(--v2-paper)' }}>\n                    <div className='flex items-center' style={{ padding: '14px 18px', gap: 10, borderBottom: '1px solid var(--v2-rule)' }}>\n                        <div role='tablist' aria-label={C.filter} className='flex rounded-[8px]' style={{ padding: 2, background: 'var(--v2-inset)' }}>\n                            {TABS.map((t) => (\n                                <button\n                                    key={t}\n                                    role='tab'\n                                    type='button'\n                                    id={`itab-${t}`}\n                                    aria-controls='inbox-panel'\n                                    aria-selected={tab === t}\n                                    onClick={() => selectInbox(tenantKey, { tab: t, item: selectedId })}\n                                    className='h-7 min-h-0 rounded-[6px] px-3 text-[12px] font-semibold'\n                                    style={{ background: tab === t ? 'var(--v2-paper)' : 'transparent', boxShadow: tab === t ? '0 1px 2px rgba(0,0,0,0.12)' : 'none', color: 'var(--v2-ink)' }}\n                                >\n                                    {C.tabs[t]}{' '}\n                                    <span className='font-medium' style={{ color: 'var(--v2-faint)' }}>\n                                        {counts[t]}\n                                    </span>\n                                </button>\n                            ))}\n                        </div>\n                    </div>\n                    <div role='tabpanel' id='inbox-panel' aria-labelledby={`itab-${tab}`} className='min-h-0 flex-grow overflow-auto'>\n                        {empty ? (\n                            <div role='status' data-slot='inbox-empty' className='flex flex-col items-center text-center leading-[1.5]' style={{ gap: 12, padding: '32px 18px', color: 'var(--v2-faint)' }}>\n                                <span>{empty}</span>\n                                {needsRole && context && (\n                                    <button type='button' onClick={() => openProduct(needsRole.product)} className={`${button32} border px-3.5 font-semibold`} style={{ borderColor: 'var(--v2-flag)', background: 'var(--v2-flag-bg)', color: 'var(--v2-flag)' }}>\n                                        {C.openRoleIssue}\n                                    </button>\n                                )}\n                            </div>\n                        ) : (\n                            <ul aria-label={C.ariaList} className='flex flex-col'>\n                                {visible.map((e) => {\n                                    const tile = severityTile(e.severity)\n                                    const current = selected?.id === e.id\n                                    return (\n                                        <li key={e.id}>\n                                            <button\n                                                type='button'\n                                                aria-current={current ? 'true' : undefined}\n                                                data-inset-focus=''\n                                                onClick={() => selectInbox(tenantKey, { tab, item: e.id })}\n                                                className='flex w-full min-w-0 items-start text-left'\n                                                style={{ gap: 10, padding: '14px 18px', borderBottom: '1px solid var(--v2-rule)', background: current ? 'var(--v2-inset)' : 'transparent', boxShadow: current ? 'inset 3px 0 0 var(--v2-acc)' : 'none', color: 'var(--v2-ink)' }}\n                                            >\n                                                <span aria-hidden='true' className='grid size-[26px] shrink-0 place-items-center rounded-[7px]' style={{ background: tile.bg, color: tile.fg }}>\n                                                    <Glyph name={tile.glyph} size={13} stroke={2} />\n                                                </span>\n                                                <span className='min-w-0 flex-grow'>\n                                                    <span className='block font-semibold [overflow-wrap:anywhere]'>{e.title}</span>\n                                                    <span className='text-[12px]' style={{ color: 'var(--v2-faint)' }}>\n                                                        {/* The severity is a word as well as a colour and an icon (I9). */}\n                                                        <span data-slot='severity' className='font-semibold' style={{ color: tile.fg }}>\n                                                            {C.severity[e.severity]}\n                                                        </span>\n                                                        {' · '}\n                                                        {e.product ? READ_COPY.products[e.product] : C.kind[e.kind]} · {e.source}\n                                                        {e.hold?.kind === 'snooze' && e.hold.returnsAt !== null ? ` · ${SNOOZE_COPY.returns(e.hold.returnsAt)}` : ''}\n                                                    </span>\n                                                    {e.hold?.kind === 'acknowledge' && (\n                                                        <span className='ml-2 inline-flex items-center gap-1 text-[12px] font-semibold' style={{ color: 'var(--v2-ok)' }}>\n                                                            <Glyph name='check' size={11} stroke={2.6} />\n                                                            {C.acknowledged}\n                                                        </span>\n                                                    )}\n                                                </span>\n                                                <span className='text-[12px]' style={{ color: 'var(--v2-faint)' }}>\n                                                    {clockOf(e.when)}\n                                                </span>\n                                            </button>\n                                        </li>\n                                    )\n                                })}\n                            </ul>\n                        )}\n                    </div>\n                    <div data-slot='inbox-foot' className='text-[12px] leading-[1.6]' style={{ padding: '14px 18px', borderTop: '1px solid var(--v2-rule)', color: 'var(--v2-faint)' }}>\n                        <span>{footLine1}</span>\n                        <br />\n                        <span>{footLine2}</span>\n                    </div>\n                </section>\n                <aside aria-label={C.detail} data-slot='inbox-detail' className='flex min-w-0 flex-col rounded-[12px] border break-words' style={{ padding: '28px 30px', gap: 18, borderColor: 'var(--v2-rule)', background: 'var(--v2-paper)' }}>\n                    {!selected ? (\n                        <div className='flex flex-grow flex-col items-center justify-center text-center leading-[1.5]' style={{ gap: 12, color: 'var(--v2-faint)' }}>\n                            <span>{empty ?? C.selectHint}</span>\n                        </div>\n                    ) : (\n                        <>\n                            <div className='flex items-center' style={{ gap: 10 }}>\n                                <span aria-hidden='true' className='grid size-[34px] place-items-center rounded-[9px]' style={{ background: severityTile(selected.severity).bg, color: severityTile(selected.severity).fg }}>\n                                    <Glyph name={severityTile(selected.severity).glyph} size={17} stroke={2} />\n                                </span>\n                                <span className='rounded-full text-[12px] font-semibold' style={{ padding: '2px 9px', background: severityTile(selected.severity).bg, color: severityTile(selected.severity).fg }}>\n                                    {C.severity[selected.severity]}\n                                </span>\n                                <span style={{ color: 'var(--v2-faint)' }}>\n                                    {selected.product ? READ_COPY.products[selected.product] : C.kind[selected.kind]} · {selected.source}\n                                </span>\n                            </div>\n                            <h2 className='min-w-0 text-[22px] font-bold' style={{ letterSpacing: '-0.01em' }}>\n                                {selected.title}\n                            </h2>\n                            <p className='text-[14px] leading-[1.55]' style={{ color: 'var(--v2-soft)' }}>\n                                {selected.detail}\n                            </p>\n                            {selected.facts.length > 0 && (\n                                <dl aria-label={C.facts} className='grid' style={{ gridTemplateColumns: 'repeat(3, minmax(0, 1fr))', gap: 10 }}>\n                                    {selected.facts.map((f) => (\n                                        <div key={f.label} className='rounded-[10px]' style={{ padding: '12px 14px', background: 'var(--v2-inset)' }}>\n                                            <dt className='text-[12px]' style={{ color: 'var(--v2-faint)' }}>\n                                                {f.label}\n                                            </dt>\n                                            <dd className='font-semibold' style={{ marginTop: 2 }}>\n                                                {f.value}\n                                            </dd>\n                                        </div>\n                                    ))}\n                                </dl>\n                            )}\n                            {snapshot.showCalls && (\n                                <div data-slot='inbox-why' className='flex gap-2 rounded-[10px] text-[13px] leading-[1.45]' style={{ padding: '12px 14px', background: 'var(--v2-acc-soft)', maxWidth: 860 }}>\n                                    <Glyph name='info' size={15} stroke={2} color='var(--v2-acc)' className='mt-px' />\n                                    <span>\n                                        <span className='font-semibold'>{C.why}: </span>\n                                        {C.whyText[selected.kind]}\n                                    </span>\n                                </div>\n                            )}\n                            {selected.hold?.kind === 'snooze' && selected.hold.returnsAt !== null && (\n                                <p data-slot='snooze-returns' className='text-[12px]' style={{ color: 'var(--v2-soft)' }}>\n                                    {SNOOZE_COPY.returns(selected.hold.returnsAt)}\n                                </p>\n                            )}\n                            <div className='flex flex-wrap' style={{ gap: 8, marginTop: 'auto' }}>\n                                {destinationFeature(selected) && selected.actionLabel && (\n                                    <button type='button' onClick={() => tenant && follow(selected, tenant.id, onNavigate)} className={`${button32} px-[18px] font-semibold`} style={{ background: 'var(--v2-acc)', color: 'var(--v2-acc-ink)' }}>\n                                        {selected.actionLabel}\n                                    </button>\n                                )}\n                                {selected.hold?.kind === 'acknowledge' ? (\n                                    <button type='button' aria-pressed='true' onClick={() => void act(selected, 'unsnoozeItem')} className={`${button32} border px-3.5`} style={{ borderColor: 'var(--v2-rule)', background: 'var(--v2-paper)', color: 'var(--v2-ink)' }}>\n                                        {C.needsAction}\n                                    </button>\n                                ) : (\n                                    <button type='button' aria-pressed='false' onClick={() => void act(selected, 'acknowledgeItem')} className={`${button32} border px-3.5`} style={{ borderColor: 'var(--v2-rule)', background: 'var(--v2-paper)', color: 'var(--v2-ink)' }}>\n                                        {C.acknowledge}\n                                    </button>\n                                )}\n                                {selected.hold?.kind === 'snooze' ? (\n                                    <button type='button' onClick={() => void act(selected, 'unsnoozeItem')} className={`${button32} border px-3.5`} style={{ borderColor: 'var(--v2-rule)', background: 'var(--v2-paper)', color: 'var(--v2-ink)' }}>\n                                        {C.unsnooze}\n                                    </button>\n                                ) : (\n                                    <button type='button' title={SNOOZE_COPY.offer} aria-label={`${SNOOZE_COPY.offer}: ${selected.title}`} onClick={() => void act(selected, 'snoozeItem')} className={`${button32} border px-3.5`} style={{ borderColor: 'var(--v2-rule)', background: 'var(--v2-paper)', color: 'var(--v2-ink)' }}>\n                                        {SNOOZE_COPY.offer}\n                                    </button>\n                                )}\n                            </div>\n                        </>\n                    )}\n                </aside>\n            </div>\n        </section>\n    )\n})\nimport { forwardRef } from 'react'\nimport type { AdminProduct, AdminProductId, FeatureId, InboxEntry, ProductId, ProductRead, ShellSnapshot } from '@prisma-airs/desktop-contracts'\nimport { HOME_COPY, INBOX_COPY, READ_COPY, SHELL_COPY, SNOOZE_COPY, clockOf } from './copy'\nimport { Glyph, PRODUCT_GLYPHS, type GlyphName } from './icons'\nimport { type Act, destinationFeature, follow, holdWhat } from './inbox/inbox'\nimport { useShellStore } from './store'\n\nexport interface HomeProps {\n    snapshot: ShellSnapshot\n    onAct: Act\n    onNavigate: (id: FeatureId) => void\n}\n\n/**\n * What the empty attention list may say (I4): an all-clear only after a\n * complete read; otherwise the unread, in-progress, failed or partial\n * coverage is named instead.\n */\nexport function attentionEmpty(snapshot: ShellSnapshot): string {\n    const read = snapshot.inbox.read\n    if (read.state === 'pending') return HOME_COPY.firstRead\n    if (read.state === 'reading' && read.lastReadAt === null) return HOME_COPY.reading\n    if (read.state === 'failed' && read.failedAt !== null) {\n        return read.lastReadAt === null ? READ_COPY.failed(clockOf(read.failedAt)) : HOME_COPY.clearSoFar(READ_COPY.failedKept(clockOf(read.failedAt), clockOf(read.lastReadAt)))\n    }\n    // A read in progress shows the cached read until the new one lands: its age stays named (C12).\n    const stale = read.lastReadAt !== null && !snapshot.overview.fresh\n    if (read.state === 'reading' && read.lastReadAt !== null) return HOME_COPY.clearSoFar(stale ? READ_COPY.readingStaleQualifier(clockOf(read.lastReadAt)) : READ_COPY.readingQualifier(clockOf(read.lastReadAt)))\n    if (read.sourcesMissing.length > 0) return HOME_COPY.clearSoFar(READ_COPY.unread(read.sourcesMissing.length))\n    // A healthy empty read older than the freshness window is a gap, not an all-clear (C12).\n    if (stale) return HOME_COPY.clearSoFar(READ_COPY.staleQualifier(clockOf(read.lastReadAt ?? 0)))\n    return HOME_COPY.allClear\n}\n\n/** The read-status line (I4): first read pending, reading, finished (with partial coverage), or failed. */\nexport function readLine(snapshot: ShellSnapshot, tenant: string | null): { text: string; tone: 'info' | 'flagged' | 'allowed' | 'blocked' } {\n    const read = snapshot.inbox.read\n    if (!tenant) return { text: HOME_COPY.noTenant, tone: 'info' }\n    if (read.state === 'reading' && read.lastReadAt === null) return { text: HOME_COPY.reading, tone: 'info' }\n    // Reading again: the cached read stays shown, with its age, until the new one lands.\n    if (read.state === 'reading' && read.lastReadAt !== null) {\n        const when = clockOf(read.lastReadAt)\n        return snapshot.overview.fresh ? { text: READ_COPY.readingKept(when), tone: 'info' } : { text: READ_COPY.readingStale(when), tone: 'flagged' }\n    }\n    // A failed read is failed, attempted or not before: never \"pending\", never an all-clear.\n    if (read.state === 'failed' && read.failedAt !== null) {\n        return read.lastReadAt === null ? { text: READ_COPY.failed(clockOf(read.failedAt)), tone: 'blocked' } : { text: READ_COPY.failedKept(clockOf(read.failedAt), clockOf(read.lastReadAt)), tone: 'blocked' }\n    }\n    if (read.state === 'pending' || (read.lastReadAt === null && read.settledAt === null)) return { text: HOME_COPY.firstRead, tone: 'info' }\n    // A settled attempt that established nothing (every source needs a role)\n    // is announced for when it settled, never as a first read still pending.\n    const when = clockOf(read.lastReadAt ?? read.settledAt ?? 0)\n    const needsRole = read.products.filter((p) => p.state === 'needsRole').length\n    if (needsRole > 0) return { text: READ_COPY.finishedNeedsRole(when, needsRole), tone: 'flagged' }\n    if (read.sourcesMissing.length > 0) return { text: READ_COPY.finishedIncomplete(when, read.sourcesMissing.length), tone: 'flagged' }\n    // Expired coverage stays distinct from healthy-empty (C12): the cached read is kept, its age named.\n    if (read.lastReadAt !== null && !snapshot.overview.fresh) return { text: READ_COPY.stale(when), tone: 'flagged' }\n    const activity = snapshot.overview.read?.summary.sessions\n    if (activity === 0 && snapshot.inbox.items.length === 0) return { text: READ_COPY.finishedNoActivity(when, tenant), tone: 'allowed' }\n    return { text: READ_COPY.finished(when), tone: 'allowed' }\n}\n\n/**\n * The one line under the greeting (R2App `homeSub`): the product count, the\n * core's read-status line (I4: pending, reading, finished with its coverage,\n * or failed, exactly as `readLine` says it) and the needs-action count.\n */\nexport function homeSub(snapshot: ShellSnapshot, tenant: string, products: number, needing: number): string {\n    const parts = [HOME_COPY.sub.products(products), readLine(snapshot, tenant).text]\n    if (needing > 0) parts.push(HOME_COPY.sub.needAction(needing))\n    return parts.join(' · ')\n}\n\ntype Pill = { word: string; bg: string; fg: string; glyph: GlyphName }\nconst PILLS: Record<'ok' | 'partial' | 'role' | 'pending' | 'failed' | 'gated', Pill> = {\n    ok: { word: HOME_COPY.pill.connected, bg: 'var(--v2-ok-bg)', fg: 'var(--v2-ok)', glyph: 'check' },\n    partial: { word: HOME_COPY.pill.partial, bg: 'var(--v2-flag-bg)', fg: 'var(--v2-flag)', glyph: 'alert' },\n    role: { word: HOME_COPY.pill.needsRole, bg: 'var(--v2-flag-bg)', fg: 'var(--v2-flag)', glyph: 'alert' },\n    pending: { word: HOME_COPY.pill.connecting, bg: 'var(--v2-inset)', fg: 'var(--v2-soft)', glyph: 'clock' },\n    failed: { word: HOME_COPY.pill.failed, bg: 'var(--v2-block-bg)', fg: 'var(--v2-block)', glyph: 'ban' },\n    gated: { word: HOME_COPY.pill.unavailable, bg: 'var(--v2-inset)', fg: 'var(--v2-faint)', glyph: 'lock' },\n}\n\ninterface Card {\n    id: AdminProductId\n    /** The read can be asked for again (a role granted, a failure, partial coverage): the C30 recheck. */\n    recheck: ProductId | null\n    name: string\n    pill: Pill\n    value: string\n    valueColor: string\n    metric: string\n    spark: { h: number; hot: boolean }[]\n    sub: string\n    subColor: string\n    subGlyph: GlyphName\n    isNew: boolean\n    gated: boolean\n}\n\n/** The products the read reports on (the inventory ids with an admitted service). */\nconst readIdOf = (id: AdminProductId): ProductId | null => (id === 'agenticIdentity' || id === 'agenticEndpoint' ? null : id)\n\nconst dollars = (cents: number) => `$${(cents / 100).toFixed(2)}`\nconst count = (n: number) => n.toLocaleString('en-US')\n\n/**\n * One card per Administration product (R2App `cards`), from the core only:\n * Runtime's headline is the read's detection events over its chart; the\n * Gateway's is the chosen workspace's day; Red Teaming and model/skill scans\n * carry their read state (the core publishes no figures for them); the two\n * gated products carry their gate. Nothing scripted is drawn.\n */\nexport function cardOf(snapshot: ShellSnapshot, product: AdminProduct, attention: InboxEntry[]): Card {\n    const readId = readIdOf(product.id)\n    const read = snapshot.inbox.read\n    const state: ProductRead | undefined = readId ? read.products.find((p) => p.product === readId) : undefined\n    const recheck = readId && state && (state.state === 'needsRole' || state.state === 'failed' || state.state === 'incomplete') ? readId : null\n    const base = { id: product.id, name: product.label, isNew: product.availability.state === 'unavailable', gated: product.availability.state === 'unavailable', recheck }\n    const blank = (pill: Pill, sub: string, subColor = 'var(--v2-faint)', subGlyph: GlyphName = 'clock'): Card => ({ ...base, pill, value: '—', valueColor: 'var(--v2-faint)', metric: HOME_COPY.metric[product.id] ?? '', spark: [], sub, subColor, subGlyph })\n    if (product.availability.state === 'unavailable') return blank(PILLS.gated, product.availability.reason, 'var(--v2-faint)', 'lock')\n    if (!state || state.state === 'pending' || state.state === 'notRead') return blank(PILLS.pending, read.state === 'reading' ? HOME_COPY.reading : HOME_COPY.firstRead)\n    if (state.state === 'needsRole') return blank(PILLS.role, HOME_COPY.cardNeedsRole(state.detail), 'var(--v2-flag)', 'alert')\n    if (state.state === 'failed') return blank(PILLS.failed, state.detail ?? READ_COPY.productState.failed ?? 'Failed', 'var(--v2-block)', 'ban')\n    const pill = state.state === 'incomplete' ? PILLS.partial : PILLS.ok\n    const worst = attention.find((e) => e.product === readId)\n    const overview = snapshot.overview.read\n    // The worst attention item is the last line when there is one; else the line states what the\n    // read established, and names what it could not (R1): unknown is never an all-clear.\n    const worstLine = worst ? { sub: worst.title, subColor: worst.severity === 'bad' ? 'var(--v2-block)' : 'var(--v2-flag)', subGlyph: (worst.severity === 'bad' ? 'ban' : 'alert') as GlyphName } : null\n    if (product.id === 'runtimeSecurity' && overview) {\n        const events = overview.summary.detectionEvents\n        const buckets = overview.chart?.buckets ?? []\n        const max = Math.max(1, ...buckets.map((b) => b.violating))\n        const spark = buckets.slice(-12).map((b) => ({ h: Math.max(2, Math.round((b.violating / max) * 38)), hot: b.violating > 0 }))\n        const violating = overview.summary.violating\n        const line =\n            worstLine ??\n            (overview.chart === null || overview.chartFailure !== null\n                ? { sub: HOME_COPY.chartNotRead, subColor: 'var(--v2-flag)', subGlyph: 'alert' as GlyphName }\n                : violating === null\n                  ? { sub: HOME_COPY.activityUnknown, subColor: 'var(--v2-flag)', subGlyph: 'alert' as GlyphName }\n                  : violating > 0\n                    ? { sub: HOME_COPY.runtimeViolating(violating), subColor: 'var(--v2-soft)', subGlyph: 'check' as GlyphName }\n                    : { sub: HOME_COPY.noDetections, subColor: 'var(--v2-soft)', subGlyph: 'check' as GlyphName })\n        return {\n            ...base,\n            pill,\n            value: events === null ? '—' : count(events),\n            valueColor: events !== null && events > 0 ? 'var(--v2-block)' : 'var(--v2-ink)',\n            metric: HOME_COPY.metric.runtimeSecurity,\n            spark,\n            ...line,\n        }\n    }\n    if (product.id === 'gateway') {\n        const g = overview?.gateway ?? null\n        if (!g) {\n            // No workspace chosen (or no read yet): no day to draw, and the gate said (R2).\n            return { ...base, pill, value: '—', valueColor: 'var(--v2-faint)', metric: HOME_COPY.metric.gateway, spark: [], ...(worstLine ?? { sub: HOME_COPY.gatewayNoWorkspace, subColor: 'var(--v2-faint)', subGlyph: 'route' as GlyphName }) }\n        }\n        const requests = g.requests\n        const errors = g.errors\n        const rate = requests !== null && errors !== null && requests > 0 ? (errors / requests) * 100 : null\n        const line =\n            worstLine ??\n            (g.usageFailure !== null || requests === null\n                ? { sub: HOME_COPY.usageNotRead(g.workspaceName), subColor: 'var(--v2-flag)', subGlyph: 'alert' as GlyphName }\n                : errors === null\n                  ? { sub: HOME_COPY.errorsUnknown(g.workspaceName), subColor: 'var(--v2-flag)', subGlyph: 'alert' as GlyphName }\n                  : rate === null\n                    ? { sub: HOME_COPY.gatewayNoRequests(g.workspaceName), subColor: 'var(--v2-soft)', subGlyph: 'check' as GlyphName }\n                    : { sub: HOME_COPY.gatewayErrorRate(rate), subColor: rate > 5 ? 'var(--v2-block)' : 'var(--v2-soft)', subGlyph: (rate > 5 ? 'ban' : 'check') as GlyphName })\n        return {\n            ...base,\n            pill: g.partial ? PILLS.partial : pill,\n            value: requests === null ? '—' : count(requests),\n            valueColor: 'var(--v2-ink)',\n            metric: g.cost === null ? HOME_COPY.metric.gateway : `${HOME_COPY.metric.gateway} · ${dollars(g.cost)}`,\n            spark: [],\n            ...line,\n        }\n    }\n    // Read-state cards: the read's coverage is the figure the core has.\n    return {\n        ...base,\n        pill,\n        value: state.sourcesTotal > 0 ? `${state.sourcesRead}/${state.sourcesTotal}` : '—',\n        valueColor: 'var(--v2-ink)',\n        metric: HOME_COPY.metric[product.id] ?? READ_COPY.sources(state.sourcesRead, state.sourcesTotal),\n        spark: [],\n        sub: worst ? worst.title : state.detail ?? (state.state === 'incomplete' ? HOME_COPY.partialRead(state.sourcesRead, state.sourcesTotal) : HOME_COPY.readOnly),\n        subColor: worst ? (worst.severity === 'bad' ? 'var(--v2-block)' : 'var(--v2-flag)') : state.state === 'incomplete' ? 'var(--v2-flag)' : 'var(--v2-soft)',\n        subGlyph: worst ? (worst.severity === 'bad' ? 'ban' : 'alert') : state.state === 'incomplete' ? 'alert' : 'check',\n    }\n}\n\nconst severityTile = (e: InboxEntry): { glyph: GlyphName; fg: string; bg: string } =>\n    e.severity === 'bad' ? { glyph: 'ban', fg: 'var(--v2-block)', bg: 'var(--v2-block-bg)' } : e.severity === 'warn' ? { glyph: 'alert', fg: 'var(--v2-flag)', bg: 'var(--v2-flag-bg)' } : { glyph: 'info', fg: 'var(--v2-soft)', bg: 'var(--v2-inset)' }\n\n/**\n * Home as the prototype draws it (R2App start=home, C36): the greeting row\n * with the read summary and Refresh, the Explain banner while the calls are\n * shown, the six product cards, then Needs attention beside Quick actions.\n * Every figure reads the snapshot; every action is a core intent whose\n * outcome reaches the shell's surfaces (DESIGN-V2 §7).\n */\nexport const Home = forwardRef<HTMLHeadingElement, HomeProps>(function Home({ snapshot, onAct, onNavigate }, ref) {\n    const tenant = snapshot.tenants.find((t) => t.id === snapshot.active?.tenant) ?? null\n    const context = snapshot.active?.context ?? null\n    const read = snapshot.inbox.read\n    const products = snapshot.administration?.products ?? []\n    const attention = snapshot.inbox.items.filter((e) => e.needsAction && !e.hold)\n    const shown = attention.slice(0, 5)\n    const needsRole = read.products.find((p) => p.state === 'needsRole') ?? null\n    const account = snapshot.harness.signIn?.account && snapshot.harness.signIn.failure === null ? snapshot.harness.signIn.account : null\n    const readNow = () => context && tenant && void onAct(SHELL_COPY.readOf(tenant.label), { kind: 'readTenant', context })\n    const hold = (kind: 'acknowledgeItem' | 'snoozeItem', id: string, title: string) => context && void onAct(holdWhat(kind, title), { kind, context, id })\n    // A recheck re-reads one product (C30); its admission is announced for the product.\n    const recheck = async (product: ProductId) => {\n        if (!context || !tenant) return\n        const label = READ_COPY.products[product] ?? product\n        const outcome = await onAct(SHELL_COPY.recheckOf(label, tenant.label), { kind: 'recheckProduct', context, product })\n        if (outcome.kind === 'admitted') useShellStore.getState().toast(READ_COPY.recheck(label), 'info', undefined, tenant.id, context)\n    }\n    const openProduct = (id: AdminProductId, tab?: string) => {\n        if (tenant) useShellStore.getState().arrive({ tenant: tenant.id, feature: 'administration', resource: null, item: null, product: id, tab })\n        onNavigate('administration')\n    }\n    const quick: { label: string; sub: string; key: string; glyph: GlyphName; go: () => void }[] = [\n        { label: HOME_COPY.quick.prompt, sub: HOME_COPY.quick.promptSub, key: '', glyph: 'play', go: () => openProduct('runtimeSecurity', 'playground') },\n        { label: HOME_COPY.quick.harness, sub: HOME_COPY.quick.harnessSub, key: '⌘3', glyph: 'bot', go: () => onNavigate('harness') },\n        { label: HOME_COPY.quick.request, sub: HOME_COPY.quick.requestSub, key: '⌘6', glyph: 'send', go: () => onNavigate('apiClient') },\n        { label: HOME_COPY.quick.learn, sub: HOME_COPY.quick.learnSub, key: '⌘4', glyph: 'cap', go: () => onNavigate('academy') },\n    ]\n    const button32 = 'flex h-8 min-h-0 items-center rounded-[7px] border text-[12px] whitespace-nowrap'\n    return (\n        <section aria-labelledby='home-heading' data-slot='home' className='flex flex-col' style={{ gap: 20 }}>\n            <div className='flex items-end' style={{ gap: 12 }}>\n                <div className='flex flex-col' style={{ gap: 2 }}>\n                    <h1 ref={ref} id='home-heading' tabIndex={-1} className='font-bold' style={{ fontSize: 'var(--v2-title)', letterSpacing: '-0.01em' }}>\n                        {account ? HOME_COPY.greeting(account) : HOME_COPY.title}\n                    </h1>\n                    <p role='status' aria-live='polite' data-slot='read-status' data-tone={readLine(snapshot, tenant?.label ?? null).tone} className='text-[14px]' style={{ marginTop: 4, color: 'var(--v2-soft)' }}>\n                        {tenant ? homeSub(snapshot, tenant.label, products.length, attention.length) : HOME_COPY.noTenant}\n                    </p>\n                </div>\n                {context && (\n                    <button type='button' aria-live='polite' onClick={readNow} disabled={read.state === 'reading'} className={`${button32} ml-auto px-3.5 text-[13px] disabled:opacity-60`} style={{ borderColor: 'var(--v2-rule)', background: 'var(--v2-paper)', color: 'var(--v2-ink)' }}>\n                        {read.state === 'reading' ? HOME_COPY.reading : HOME_COPY.refresh}\n                    </button>\n                )}\n            </div>\n            {snapshot.showCalls && (\n                <div data-slot='home-explain' className='flex gap-2 rounded-[10px] text-[13px] leading-[1.45]' style={{ padding: '12px 14px', background: 'var(--v2-acc-soft)', maxWidth: 860 }}>\n                    <Glyph name='info' size={15} stroke={2} color='var(--v2-acc)' className='mt-px' />\n                    <span>{HOME_COPY.explain}</span>\n                </div>\n            )}\n            {/* Three columns at the board's width (each card at least 300px); fewer when the page is narrower (the collapsed rail, 200% zoom). */}\n            {tenant && products.length > 0 && (\n                <ul data-slot='cards' aria-label={HOME_COPY.cards} className='grid' style={{ gridTemplateColumns: 'repeat(auto-fit, minmax(min(100%, 300px), 1fr))', gap: 16 }}>\n                    {products.map((product) => {\n                        const c = cardOf(snapshot, product, attention)\n                        return (\n                            // The card is one button (the prototype's); a Recheck control, when the read allows one,\n                            // sits beside the card's last line above the stretched button, never inside it.\n                            <li key={c.id} className='relative flex'>\n                                <button\n                                    type='button'\n                                    data-slot='card'\n                                    data-product={c.id}\n                                    aria-label={`${c.name}: ${c.pill.word}, ${c.value} ${c.metric}, ${c.sub}${c.isNew ? ` · ${SHELL_COPY.newTag}` : ''}`}\n                                    onClick={() => openProduct(c.id)}\n                                    className='flex w-full flex-col rounded-[12px] border text-left after:absolute after:inset-0 after:rounded-[12px] after:content-[\"\"]'\n                                    style={{ gap: 10, padding: '18px 20px', borderColor: 'var(--v2-rule)', background: 'var(--v2-paper)', color: 'var(--v2-ink)' }}\n                                >\n                                    <span className='flex w-full items-center' style={{ gap: 9 }}>\n                                        <span className='grid size-7 shrink-0 place-items-center rounded-[8px]' style={{ background: 'var(--v2-inset)', color: 'var(--v2-soft)' }}>\n                                            <Glyph name={PRODUCT_GLYPHS[c.id]} size={15} />\n                                        </span>\n                                        <b className='min-w-0 flex-grow truncate text-[13px]'>{c.name}</b>\n                                        <span className='flex shrink-0 items-center gap-1 rounded-full text-[12px] font-semibold whitespace-nowrap' style={{ padding: '2px 8px', background: c.pill.bg, color: c.pill.fg }}>\n                                            <Glyph name={c.pill.glyph} size={10} stroke={2.6} />\n                                            {c.pill.word}\n                                        </span>\n                                    </span>\n                                    <span className='flex w-full items-end' style={{ gap: 12 }}>\n                                        <span className='flex min-w-0 flex-1 flex-col'>\n                                            <span className='text-[26px] font-bold tabular-nums' style={{ letterSpacing: '-0.02em', color: c.valueColor }}>\n                                                {c.value}\n                                            </span>\n                                            <span className='text-[12px] leading-[1.35]' style={{ color: 'var(--v2-faint)' }}>\n                                                {c.metric}\n                                            </span>\n                                        </span>\n                                        <span aria-hidden='true' className='ml-auto flex h-[38px] w-[110px] shrink-0 items-end' style={{ gap: 3 }}>\n                                            {c.spark.map((b, i) => (\n                                                <span key={i} className='flex-1' style={{ height: b.h, borderRadius: '2px 2px 0 0', background: b.hot ? 'var(--v2-block)' : 'var(--v2-acc)' }} />\n                                            ))}\n                                        </span>\n                                    </span>\n                                    <span className='flex w-full items-center gap-1.5 text-[12px] font-semibold' style={{ paddingTop: 8, borderTop: '1px solid var(--v2-rule)', color: c.subColor }}>\n                                        <Glyph name={c.subGlyph} size={12} stroke={2.2} />\n                                        <span className='min-w-0 flex-grow truncate'>{c.sub}</span>\n                                        {c.isNew && (\n                                            <span className='shrink-0 rounded-full text-[12px] font-bold' style={{ padding: '1px 6px', background: 'var(--v2-acc-soft)', color: 'var(--v2-acc)' }}>\n                                                {SHELL_COPY.newTag}\n                                            </span>\n                                        )}\n                                    </span>\n                                </button>\n                                {c.recheck && context && (\n                                    <button\n                                        type='button'\n                                        onClick={() => void recheck(c.recheck!)}\n                                        disabled={read.state === 'reading'}\n                                        className='absolute right-5 bottom-[14px] z-10 h-7 rounded-[7px] border px-2.5 text-[12px] disabled:opacity-60'\n                                        style={{ borderColor: 'var(--v2-rule)', background: 'var(--v2-bg)', color: 'var(--v2-ink)' }}\n                                    >\n                                        {HOME_COPY.recheck}\n                                    </button>\n                                )}\n                            </li>\n                        )\n                    })}\n                </ul>\n            )}\n            <div data-slot='home-lower' className='grid' style={{ gridTemplateColumns: 'minmax(0, 1.75fr) minmax(0, 1fr)', gap: 16 }}>\n                <section aria-label={HOME_COPY.attention} data-slot='attention-section' className='flex flex-col rounded-[12px] border' style={{ padding: '4px 0', borderColor: 'var(--v2-rule)', background: 'var(--v2-paper)' }}>\n                    <div className='flex items-center' style={{ padding: '16px 18px 10px' }}>\n                        <h2 className='text-[13px] font-bold'>\n                            {HOME_COPY.attention}{' '}\n                            <span className='font-normal' style={{ color: 'var(--v2-faint)' }}>\n                                {attention.length > 0 ? attention.length : ''}\n                            </span>\n                        </h2>\n                        <button type='button' onClick={() => onNavigate('inbox')} className='ml-auto text-[12px] font-semibold' style={{ color: 'var(--v2-acc)' }}>\n                            {HOME_COPY.openInbox}\n                        </button>\n                    </div>\n                    {shown.length === 0 ? (\n                        <div className='flex flex-col items-center text-center leading-[1.5]' style={{ gap: 12, padding: '28px 18px', borderTop: '1px solid var(--v2-rule)', color: 'var(--v2-faint)' }}>\n                            <span>{attentionEmpty(snapshot)}</span>\n                            {needsRole && (\n                                <button type='button' onClick={() => openProduct(needsRole.product)} className={`${button32} px-3.5 font-semibold`} style={{ borderColor: 'var(--v2-flag)', background: 'var(--v2-flag-bg)', color: 'var(--v2-flag)' }}>\n                                    {HOME_COPY.openRoleIssue}\n                                </button>\n                            )}\n                        </div>\n                    ) : (\n                        <ul data-slot='attention' className='flex flex-col'>\n                            {shown.map((e) => {\n                                const tile = severityTile(e)\n                                return (\n                                    // One line at the board's width; at narrow widths (the collapsed rail, 200% zoom) the action\n                                    // group wraps under the text, which keeps at least 200px, and the controls keep their 32px.\n                                    <li key={e.id} className='flex flex-wrap items-center' style={{ gap: 12, padding: '12px 18px', borderTop: '1px solid var(--v2-rule)' }}>\n                                        <span aria-hidden='true' className='grid size-7 shrink-0 place-items-center rounded-[8px]' style={{ background: tile.bg, color: tile.fg }}>\n                                            <Glyph name={tile.glyph} size={14} stroke={2} />\n                                        </span>\n                                        <div className='min-w-0 flex-grow' style={{ flexBasis: 200 }}>\n                                            <div className='font-semibold [overflow-wrap:anywhere]'>{e.title}</div>\n                                            {/* The severity is a word as well as a colour and an icon (I9). */}\n                                            {/* The line wraps rather than clips (nothing is cut off at narrow widths or 200% zoom). */}\n                                            <div className='text-[12px] [overflow-wrap:anywhere]' style={{ color: 'var(--v2-faint)' }}>\n                                                <span data-slot='severity' className='font-semibold' style={{ color: tile.fg }}>\n                                                    {INBOX_COPY.severity[e.severity]}\n                                                </span>\n                                                {' · '}\n                                                {[e.product ? READ_COPY.products[e.product] : null, e.source, e.detail].filter(Boolean).join(' · ')}\n                                            </div>\n                                        </div>\n                                        <div className='flex shrink-0 items-center' style={{ gap: 12 }}>\n                                            {destinationFeature(e) && e.actionLabel && tenant && (\n                                                <button type='button' onClick={() => follow(e, tenant.id, onNavigate)} className={`${button32} shrink-0 px-3`} style={{ borderColor: 'var(--v2-rule)', background: 'var(--v2-bg)', color: 'var(--v2-ink)' }}>\n                                                    {e.actionLabel}\n                                                </button>\n                                            )}\n                                            <button type='button' aria-label={`${HOME_COPY.acknowledge}: ${e.title}`} title={HOME_COPY.acknowledge} onClick={() => hold('acknowledgeItem', e.id, e.title)} className='grid size-8 min-h-0 shrink-0 place-items-center rounded-[7px] border' style={{ borderColor: 'var(--v2-rule)', background: 'var(--v2-bg)', color: 'var(--v2-ink)' }}>\n                                                <Glyph name='check' size={12} stroke={2.2} />\n                                            </button>\n                                            <button type='button' aria-label={`${SNOOZE_COPY.offer}: ${e.title}`} title={SNOOZE_COPY.offer} onClick={() => hold('snoozeItem', e.id, e.title)} className='grid size-8 min-h-0 shrink-0 place-items-center rounded-[7px] border' style={{ borderColor: 'var(--v2-rule)', background: 'var(--v2-bg)', color: 'var(--v2-ink)' }}>\n                                                <Glyph name='clock' size={12} stroke={2} />\n                                            </button>\n                                        </div>\n                                    </li>\n                                )\n                            })}\n                        </ul>\n                    )}\n                </section>\n                <section aria-label={HOME_COPY.quickActions} data-slot='quick-actions' className='flex flex-col rounded-[12px] border' style={{ padding: '4px 0', borderColor: 'var(--v2-rule)', background: 'var(--v2-paper)' }}>\n                    <h2 className='text-[13px] font-bold' style={{ padding: '16px 18px 10px' }}>\n                        {HOME_COPY.quickActions}\n                    </h2>\n                    {quick.map((q) => (\n                        <button key={q.label} type='button' data-inset-focus='' onClick={q.go} className='flex items-center text-left' style={{ gap: 12, padding: '12px 18px', borderTop: '1px solid var(--v2-rule)', color: 'var(--v2-ink)' }}>\n                            <span aria-hidden='true' className='grid size-7 shrink-0 place-items-center rounded-[8px]' style={{ background: 'var(--v2-acc-soft)', color: 'var(--v2-acc)' }}>\n                                <Glyph name={q.glyph} size={14} stroke={1.9} />\n                            </span>\n                            <span className='flex-grow'>\n                                <b className='font-semibold'>{q.label}</b>\n                                <br />\n                                <span className='text-[12px]' style={{ color: 'var(--v2-faint)' }}>\n                                    {q.sub}\n                                </span>\n                            </span>\n                            <span className='text-[12px]' style={{ color: 'var(--v2-faint)' }}>\n                                {q.key}\n                            </span>\n                        </button>\n                    ))}\n                </section>\n            </div>\n        </section>\n    )\n})\nimport type { SwitchResolution } from '@prisma-airs/desktop-contracts'\nimport { GUARD_COPY } from './copy'\nimport { Modal } from './modal'\n\nexport interface SwitchGuardProps {\n    /** The tenant the switch (or the setup completion) leads to. */\n    target: string\n    /** The switch is a setup draft's completion (the body says so). */\n    completion: boolean\n    onStay: () => void\n    onResolve: (resolution: SwitchResolution) => void\n}\n\n/**\n * The one tenant-switch guard (I1): rendered from the core's `switchBlocked`\n * whether the switch was asked for through the switcher, the palette, the\n * native menu or the completion of a setup draft. Stay dismisses the guard;\n * Archive and Discard re-send the same intent with the chosen resolution.\n * Initial focus is on Stay, the safe default: Enter on arrival never ends\n * the conversation (Archive stays the visually primary action).\n */\nexport function SwitchGuard({ target, completion, onStay, onResolve }: SwitchGuardProps) {\n    return (\n        <Modal label={GUARD_COPY.title} onClose={onStay} width={520} data-slot='switch-guard'>\n            <h2 className='text-[16px] font-semibold'>{GUARD_COPY.title}</h2>\n            <p className='mt-2 text-[13px]' style={{ color: 'var(--v2-soft)' }}>\n                {completion ? GUARD_COPY.bodyCompletion(target) : GUARD_COPY.body(target)}\n            </p>\n            <div className='mt-4 flex flex-wrap justify-end gap-2'>\n                <button type='button' autoFocus onClick={onStay} className='h-8 rounded-[7px] border px-3 text-[13px]' style={{ borderColor: 'var(--v2-rule)' }}>\n                    {GUARD_COPY.stay}\n                </button>\n                <button type='button' onClick={() => onResolve('discard')} className='h-8 rounded-[7px] border px-3 text-[13px]' style={{ borderColor: 'var(--v2-rule)' }}>\n                    {GUARD_COPY.discard}\n                </button>\n                <button type='button' onClick={() => onResolve('archive')} className='h-8 rounded-[7px] px-3 text-[13px] font-semibold' style={{ background: 'var(--v2-acc)', color: 'var(--v2-acc-ink)' }}>\n                    {GUARD_COPY.archive}\n                </button>\n            </div>\n        </Modal>\n    )\n}\nimport type { TenantEnvironment } from '@prisma-airs/desktop-contracts'\n\n/** A tenant's environment as the shell names it (C29). */\nexport const ENVIRONMENT_LABELS: Record<TenantEnvironment, string> = { production: 'Production', staging: 'Staging', other: 'Other' }\n\n/** Every string the v2 shell shows (DESIGN-V2 §3: one copy file per screen family). */\nexport const SHELL_COPY = {\n    brand: 'Prisma AIRS',\n    tagline: 'Desktop v2',\n    navLabel: 'Destinations',\n    tenantSwitcher: 'Switch tenant',\n    tenantNone: 'No tenant yet',\n    addTenant: 'Add a tenant…',\n    tenantAdded: (tenant: string) => `${tenant} is set up and active.`,\n    palette: 'Go to…',\n    paletteLabel: 'Command palette',\n    paletteInput: 'Go to a destination, tenant or action',\n    paletteEmpty: 'Nothing matches.',\n    paletteSwitch: (name: string) => `Switch to ${name}`,\n    paletteReadNow: 'Read now',\n    unavailableHint: (reason: string) => `Not available: ${reason}`,\n    appearance: 'Appearance',\n    appearanceSystem: 'Match system',\n    appearanceLight: 'Light',\n    appearanceDark: 'Dark',\n    showCalls: 'Show the calls',\n    showCallsHint: 'Shows each request this app sends to the public APIs as you work.',\n    // The header (R2App): the Explain switch is the show-the-calls preference.\n    explain: 'Explain',\n    searchOrGo: 'Search or go to…',\n    askHarness: 'Ask Harness',\n    tenantMenu: 'Tenants',\n    tenantSettings: 'Tenant settings and credentials…',\n    changeWorkspace: 'Change Gateway workspace…',\n    switchTenantHeading: 'Switch tenant',\n    addTenantRow: 'Add a tenant',\n    workspaceOf: (name: string) => `Workspace ${name}`,\n    tsgOf: (tsg: string) => `TSG ${tsg}`,\n    signedInAs: (who: string) => `signed in as ${who}`,\n    connected: 'Connected',\n    harnessRow: 'Harness',\n    harnessSignedIn: 'Signed in · SSO',\n    harnessKey: 'Workspace key',\n    harnessOff: 'Not signed in',\n    harnessRenew: 'Sign in again',\n    harnessPending: 'Sign in needed',\n    harnessNoWorkspace: 'No workspace',\n    changeWorkspaceGate: 'Choose a tenant first',\n    keychainRow: 'Keychain',\n    keychainUnlocked: 'Unlocked',\n    keychainLocked: 'Locked',\n    keychainUnavailable: 'Unavailable',\n    jobsRow: 'Jobs',\n    jobsNone: 'None running',\n    jobsRunning: (n: number) => `${n} running`,\n    settingsButton: 'Settings  ⌘,',\n    themeToggle: 'Switch light or dark appearance',\n    productsToggle: 'Show or hide products',\n    newTag: 'New',\n    productsLabel: 'Products',\n    needAction: (n: number) => `${n} need${n === 1 ? 's' : ''} action`,\n    // The prototype's third hint (product-scoped search) names a search this palette does not have; it is left out.\n    paletteHints: { move: '↑ ↓ move', open: '↵ open' },\n    paletteGroups: { destinations: 'Go to', tenants: 'Tenants', actions: 'Actions' },\n    paletteAsk: 'Ask the Harness instead',\n    classic: 'Return to the classic interface',\n    fixture: 'Fixture build',\n    status: 'Status',\n    toastRefused: (what: string, reason: string, text: string | null = null) => `${what} was refused (${reason}).${text ? ` ${text}` : ''}`,\n    switchTo: (tenant: string) => `The switch to ${tenant}`,\n    readOf: (tenant: string) => `The read of ${tenant}`,\n    recheckOf: (product: string, tenant: string) => `The recheck of ${product} in ${tenant}`,\n    acknowledgmentOf: (title: string) => `The acknowledgment of “${title}”`,\n    snoozeOf: (title: string) => `The snooze of “${title}”`,\n    unsnoozeOf: (title: string) => `The unsnooze of “${title}”`,\n    toastUnknown: (what: string) => `${what} was sent but not confirmed. The current state is shown.`,\n    toastFailed: (what: string) => `${what} could not be delivered.`,\n    toastPrefix: { ok: 'Done: ', info: 'Note: ', warn: 'Warning: ' } as Record<'ok' | 'info' | 'warn', string>,\n    unconfirmed: (what: string) => `${what} was sent but the desktop did not confirm it. The current state is shown.`,\n    retry: 'Retry',\n    dismiss: 'Dismiss',\n} as const\n\n/** Wall-clock HH:MM for a seconds-since-epoch stamp. */\nexport function clockOf(seconds: number): string {\n    const d = new Date(seconds * 1000)\n    return `${String(d.getHours()).padStart(2, '0')}:${String(d.getMinutes()).padStart(2, '0')}`\n}\n\n/** Day-relative wording for a return time (today, tomorrow, or the date). */\nexport function returnsWording(seconds: number): string {\n    const d = new Date(seconds * 1000)\n    const today = new Date()\n    const dayOf = (x: Date) => `${x.getFullYear()}-${x.getMonth()}-${x.getDate()}`\n    const tomorrow = new Date(today.getTime() + 86_400_000)\n    const day = dayOf(d) === dayOf(today) ? 'today' : dayOf(d) === dayOf(tomorrow) ? 'tomorrow' : d.toLocaleDateString(undefined, { month: 'short', day: 'numeric' })\n    return `${day} ${clockOf(seconds)}`\n}\n\n/**\n * The one snooze label (I11): the core computes the return time; Home, the\n * Inbox row, the detail pane and the toast all say exactly this.\n */\nexport const SNOOZE_COPY = {\n    /** Before snoozing: what a snooze will do (24 hours, per P20). */\n    offer: 'Snooze 24 hours',\n    /** After snoozing: when the core says it returns. */\n    returns: (returnsAt: number) => `Returns ${returnsWording(returnsAt)}`,\n    toast: (title: string, returnsAt: number) => `${title} snoozed · returns ${returnsWording(returnsAt)}`,\n}\n\nexport const INBOX_COPY = {\n    title: 'Inbox',\n    tabs: { all: 'All', action: 'Needs action', updates: 'Updates', snoozed: 'Snoozed' } as const,\n    severity: { bad: 'Critical', warn: 'Warning', ok: 'Info' } as Record<'bad' | 'warn' | 'ok', string>,\n    kind: { runtime: 'AI Runtime Security', gateway: 'AI Gateway', setupWarning: 'Setup', rotation: 'Key rotation' } as Record<'runtime' | 'gateway' | 'setupWarning' | 'rotation', string>,\n    emptyPending: 'First read pending. Nothing has been read for this tenant yet.',\n    emptyReading: 'Reading this tenant…',\n    emptyClear: 'Nothing needs action.',\n    /** A partial read with nothing listed: what was read says nothing needs action; the unread sources are unknown (I4). */\n    emptyPartial: (read: number, total: number, missing: string[]) => `Nothing needs action in what was read (${read} of ${total} sources). Activity for ${missing.join(', ')} is unknown until it can be read.`,\n    emptyFailed: (when: string) => `The read at ${when} failed. Nothing has been read for this tenant yet.`,\n    emptyStale: (when: string) => `Nothing needed action at ${when}; that read is more than 10 minutes old. Read again to confirm.`,\n    stale: (when: string) => `The read from ${when} is more than 10 minutes old.`,\n    readingKept: (when: string) => `A read is in progress; the read from ${when} is shown.`,\n    readingStale: (when: string) => `A read is in progress; the read from ${when} shown is more than 10 minutes old.`,\n    emptyUnread: (when: string, sources: number) => `The read at ${when} established nothing: ${sources} source${sources === 1 ? '' : 's'} still unread. Nothing has been read for this tenant yet.`,\n    failedKept: (when: string, shown: string) => `The read at ${when} failed; the read from ${shown} is shown.`,\n    emptyTab: 'Nothing here.',\n    partial: (read: number, total: number, when: string) => `${read} of ${total} sources were read at ${when}.`,\n    acknowledged: 'Acknowledged',\n    acknowledge: 'Acknowledge',\n    needsAction: 'Mark as needing action',\n    unsnooze: 'Unsnooze',\n    why: 'Why this matters',\n    facts: 'Facts',\n    whyText: {\n        runtime: 'Runtime Security reads this from the tenant’s sessions and API keys; an item here changes what the scan key can do or how prompts are being handled.',\n        gateway: 'The chosen AI Gateway workspace reported errors or a quota for the day; routes and keys depend on it.',\n        setupWarning: 'A check during setup did not pass. The product reads only partially until it is fixed in Administration.',\n        rotation: 'An additional API key was issued for this application. Until the old key is removed, both keys work; finish the rotation once the application uses the new key.',\n    } as Record<'runtime' | 'gateway' | 'setupWarning' | 'rotation', string>,\n    listCard: 'Inbox list',\n    sub: (tenant: string) => `Everything that needs you in ${tenant} · newest first`,\n    reading: 'Reading…',\n    filter: 'Inbox filter',\n    openRoleIssue: 'Open role issue',\n    footNoReads: (tenant: string) => `No source reads yet for ${tenant}.`,\n    footPartial: (read: number, total: number, when: string) => `${read} of ${total} sources read at ${when}.`,\n    footAll: (when: string) => `All sources read at ${when}.`,\n    footGateway: (workspace: string, policies: number | null) => `AI Gateway ${workspace}${policies === null ? '' : ` · ${policies} limit polic${policies === 1 ? 'y' : 'ies'}`}`,\n    readNow: 'Read now',\n    detail: 'Details',\n    selectHint: 'Select an item to see its details.',\n    ariaList: 'Inbox items',\n}\n\nexport const READ_COPY = {\n    finished: (when: string) => `Read finished at ${when} · all sources complete`,\n    finishedIncomplete: (when: string, partial: number) => `Read finished at ${when} · ${partial} source${partial === 1 ? '' : 's'} partial`,\n    finishedNeedsRole: (when: string, products: number) => `Read finished at ${when} · ${products} product${products === 1 ? '' : 's'} still need${products === 1 ? 's' : ''} a role`,\n    finishedNoActivity: (when: string, tenant: string) => `Read finished at ${when} · no activity yet in ${tenant}`,\n    failed: (when: string) => `Read failed at ${when} · nothing read yet`,\n    failedKept: (when: string, shown: string) => `Read failed at ${when} · showing the read from ${shown}`,\n    unread: (sources: number) => `${sources} source${sources === 1 ? ' was' : 's were'} not read.`,\n    stale: (when: string) => `Read at ${when} · more than 10 minutes old; read again to confirm`,\n    staleQualifier: (when: string) => `The read from ${when} is more than 10 minutes old.`,\n    readingKept: (when: string) => `Reading… · showing the read from ${when}`,\n    readingStale: (when: string) => `Reading… · the read from ${when} shown is more than 10 minutes old`,\n    readingQualifier: (when: string) => `A read is in progress; the read from ${when} is shown.`,\n    readingStaleQualifier: (when: string) => `A read is in progress; the read from ${when} shown is more than 10 minutes old.`,\n    recheck: (product: string) => `Rechecking ${product}…`,\n    reading: (tenant: string) => `Reading ${tenant}…`,\n    rechecked: (product: string) => `${product} read again.`,\n    productState: { pending: 'Pending', ok: 'Read', incomplete: 'Incomplete', needsRole: 'Needs a role', failed: 'Failed', notRead: 'Not read here' } as Record<string, string>,\n    products: { runtimeSecurity: 'AI Runtime Security', gateway: 'AI Gateway', redTeam: 'AI Red Teaming', modelSkill: 'Model and skill scans' } as Record<string, string>,\n    sources: (read: number, total: number) => (total === 0 ? '' : `${read} of ${total} sources`),\n}\n\nexport const GUARD_COPY = {\n    title: 'A Harness decision is waiting',\n    body: (tenant: string) => `The conversation in this tenant is waiting for your approval. Switching to ${tenant} ends it. Keep its transcript, drop it, or stay.`,\n    bodyCompletion: (tenant: string) => `The conversation in this tenant is waiting for your approval. Finishing the setup of ${tenant} makes it active and ends the conversation. Keep its transcript, drop it, or stay.`,\n    archive: 'Archive and switch',\n    discard: 'Discard and switch',\n    stay: 'Stay',\n}\n\nexport const HOME_COPY = {\n    title: 'Home',\n    greeting: (account: string) => `Good ${(() => { const h = new Date().getHours(); return h < 12 ? 'morning' : h < 18 ? 'afternoon' : 'evening' })()}, ${account.split(/\\s+/)[0]}`,\n    refresh: 'Refresh',\n    recheck: 'Recheck',\n    cards: 'Product cards',\n    sub: {\n        products: (n: number) => `${n} product${n === 1 ? '' : 's'}`,\n        needAction: (n: number) => `${n} need${n === 1 ? 's' : ''} action`,\n        partial: (n: number) => `${n} source${n === 1 ? '' : 's'} partial`,\n    },\n    explain: 'Each card is one product: its headline figure for the period shown and how fresh it is. \"Partial\" means a source answered only in part, so the figure may be low. Open a card to manage that product in Administration.',\n    pill: { connected: 'Connected', partial: 'Partial', needsRole: 'Needs a role', connecting: 'Connecting', failed: 'Failed', unavailable: 'Not available' },\n    metric: { runtimeSecurity: 'detection events · last read', gateway: 'requests · today', redTeam: 'sources read', modelSkill: 'sources read', agenticIdentity: '', agenticEndpoint: '' } as Record<import('@prisma-airs/desktop-contracts').AdminProductId, string>,\n    cardNeedsRole: (detail: string | null) => `${detail ?? 'Missing read role'} · check again in Administration`,\n    runtimeViolating: (n: number) => `${n} violating session${n === 1 ? '' : 's'}`,\n    noDetections: 'No detections in this read',\n    gatewayErrorRate: (rate: number) => `Error rate ${rate.toFixed(1)}% today`,\n    gatewayNoRequests: (workspace: string) => `No requests today · ${workspace}`,\n    gatewayNoWorkspace: 'No Gateway workspace chosen · choose one in Administration',\n    usageNotRead: (workspace: string) => `Usage not read · ${workspace}`,\n    errorsUnknown: (workspace: string) => `Error count unknown · ${workspace}`,\n    chartNotRead: 'Sessions chart not read · figure may be low',\n    activityUnknown: 'Activity unknown · check again in Administration',\n    partialRead: (read: number, total: number) => `Partial · ${read} of ${total} sources`,\n    readOnly: 'Read-only here',\n    openRoleIssue: 'Open role issue',\n    acknowledge: 'Acknowledge',\n    quickActions: 'Quick actions',\n    quick: {\n        prompt: 'Test a prompt',\n        promptSub: 'AI Runtime Security · Playground',\n        harness: 'Ask the Harness',\n        harnessSub: 'Investigate with your tools',\n        request: 'Send a request',\n        requestSub: 'API Client · built-in catalog',\n        learn: 'Keep learning',\n        learnSub: 'Academy courses and labs',\n    },\n    noTenant: 'Add a tenant to start reading it.',\n    firstRead: 'First read pending',\n    reading: 'Reading…',\n    readAt: (when: string) => `Read finished at ${when}`,\n    readFailed: (when: string) => `Last read failed at ${when}; the previous read is shown`,\n    attention: 'Needs attention',\n    allClear: 'Nothing needs action.',\n    clearSoFar: (qualifier: string) => `Nothing needs action in what was read. ${qualifier}`,\n    inboxSoon: 'Items that need action appear here once the Inbox is available.',\n    openInbox: 'Open the Inbox',\n    products: 'Products',\n    readNow: 'Read now',\n    capabilities: 'Capabilities in this tenant',\n    scan: 'Runtime Security scan key',\n    management: 'Management client',\n    inference: 'Gateway workspace key',\n    state: {\n        missing: 'Not configured',\n        storing: 'Storing…',\n        ready: 'Ready',\n        failed: 'Failed',\n    } as Record<string, string>,\n    destinations: 'Destinations',\n} as const\n","exit_code":0,"status":"completed"}}
