"options\": \"runtime\",\n    \"signedUtc\": \"2026-10-25T21:23:45Z\",\n    \"teamIdentifier\": \"G5QLZ5A8TA\",\n    \"timestamp\": true,\n    \"unsignedBinarySha256\": \"f8e49cee8b0905818c9271e91b2ca8f39b67075e602e5db7db683f9d37aee50c\"\n  },\n  \"source\": {\n    \"buildInfoSha256\": \"a22d963e7bedf212c3190ef78ebc4d885e99cac87e87a53ed297f694b692cbc6\",\n    \"v1Archive\": \"packaging/harness/darwin-arm64.tar.gz\",\n    \"v1ArchiveSha256\": \"e79f564a5210241488a49c4756ff061dff3d336e23709f5fb7adfd4bde0928aa\",\n    \"v1Commit\": \"74754c02b19d87187b6dca81f64550a669b0f841\"\n  },\n  \"version\": 1\n}\n/**\n * Academy learner source compiled into the desktop (C05). The learner\n * package (@ai-security-academy/learner) exports Academy's own pages; their\n * `@/` imports are Academy's source in the prepared, hash-verified input\n * (.work/academy, xtask shared-prepare). Every bare import that source makes\n * resolves to this app's pinned copy (`dedupe`), so one React, one React\n * Query and one router instance exist and versions follow the desktop lock.\n */\n// A file-system path without Node typings in the app's tsconfig (the\n// repository path has no characters that URL-encode other than these).\nexport const ACADEMY_SRC = decodeURIComponent(new URL('../../.work/academy/src', import.meta.url).pathname)\nconst CONTRACTS_ROOT = decodeURIComponent(new URL('../../packages/desktop-contracts/', import.meta.url).pathname)\n\n// node_modules may be shared with another worktree. Compile this checkout's IPC parser and bindings,\n// not the workspace package reached through that other checkout's dependency symlink.\nexport const desktopAliases = [\n    { find: /^@prisma-airs\\/desktop-contracts$/, replacement: `${CONTRACTS_ROOT}src/index.ts` },\n    { find: /^@prisma-airs\\/desktop-contracts\\/fixtures\\//, replacement: `${CONTRACTS_ROOT}fixtures/` },\n    { find: /^@\\//, replacement: `${ACADEMY_SRC}/` },\n]\n\nexport const academyDedupe = [\n    'react',\n    'react-dom',\n    '@ai-security-academy/presentation',\n    '@ai-security-academy/shared',\n    '@codemirror/commands',\n    '@codemirror/lang-python',\n    '@codemirror/lang-yaml',\n    '@codemirror/language',\n    '@codemirror/state',\n    '@codemirror/view',\n    '@dnd-kit/core',\n    '@excalidraw/excalidraw',\n    '@lezer/highlight',\n    '@radix-ui/react-dialog',\n    '@radix-ui/react-slot',\n    '@tanstack/react-query',\n    '@tanstack/react-router',\n    '@trpc/client',\n    '@trpc/react-query',\n    '@trpc/server',\n    'class-variance-authority',\n    'clsx',\n    'dompurify',\n    'lucide-react',\n    'mermaid',\n    'qrcode.react',\n    'sanitize-html',\n    'tailwind-merge',\n    'zustand',\n]\n//! Prisma AIRS Desktop v2 native host.\n//!\n//! The host owns window/origin/schema admission for the two application\n//! commands, the packaged main window and its navigation policy, and native\n//! menus. Domain authority lives in `desktop-core`; the host creates the core\n//! once and derives the caller principal from the invoking window, never from\n//! request JSON.\n\nuse desktop_core::wire::{\n    DispatchRequest, DispatchResponse, MenuCommand, ObservationUpdate, ObserveRequest,\n    ObserveResponse, WireScope,\n};\nuse std::collections::VecDeque;\nuse std::sync::{Arc, Mutex};\n\nuse desktop_core::{AuthorityHandle, Core, CoreConfig, Observation, Refusal, Update, ViewScope};\nuse tauri::async_runtime::JoinHandle;\nuse tauri::ipc::{Channel, InvokeBody, JavaScriptChannelId, Request};\nuse tauri::webview::{NewWindowResponse, PageLoadEvent};\nuse tauri::{\n    AppHandle, Manager, Runtime, State, Url, Webview, WebviewUrl, WebviewWindow,\n    WebviewWindowBuilder, WindowEvent,\n};\nuse tokio::sync::broadcast;\n\npub mod adapters;\npub mod clipboard_secret;\n#[cfg(all(feature = \"test-fixtures\", target_os = \"macos\"))]\npub mod fixture_capture;\n#[cfg(target_os = \"macos\")]\npub mod keychain;\nmod menu;\npub mod native_confirmation;\n#[cfg(target_os = \"macos\")]\npub mod power;\n#[cfg(target_os = \"macos\")]\npub mod sidecar;\n\n/// Label of the single packaged window allowed to call application commands.\npub const MAIN_WINDOW: &str = \"main\";\n\n/// Application commands registered in the permission manifest (build.rs).\npub const APP_COMMANDS: [&str; 2] = [\"desktop_dispatch\", \"desktop_observe\"];\n\n/// Live shell observations a single webview may hold; further observations\n/// are refused (`Busy`) until one is closed or the page reloads.\npub const MAX_OBSERVATIONS_PER_WEBVIEW: usize = 8;\n\nstruct ObservationTask {\n    id: u64,\n    webview: String,\n    token: String,\n    handle: JoinHandle<()>,\n}\n\n#[derive(Default)]\nstruct Observations {\n    next_id: u64,\n    tasks: VecDeque<ObservationTask>,\n}\n\n/// Native host state managed by Tauri.\npub struct Host {\n    operator: AuthorityHandle,\n    menu: broadcast::Sender<MenuCommand>,\n    observations: Arc<Mutex<Observations>>,\n    zoom: Mutex<f64>,\n    /// The presentation the native Go menu was last reconciled with (C28).\n    menu_variant: Mutex<Option<desktop_core::features::UiVariant>>,\n}\n\nimpl Host {\n    pub fn new(core: &Core) -> Self {\n        let (menu, _) = broadcast::channel(32);\n        Self {\n            operator: core.operator(),\n            menu,\n            observations: Arc::default(),\n            zoom: Mutex::new(1.0),\n            menu_variant: Mutex::new(None),\n        }\n    }\n\n    /// Reconciles the native Go menu with `variant` (C28): called whenever a\n    /// shell observation starts or reports a changed presentation, so a\n    /// transition lost to an overflowing stream is repaired on the client's\n    /// resubscribe. Without an installed menu (host tests) only the record\n    /// is kept.\n    pub fn sync_menu<R: Runtime>(\n        &self,\n        app: &AppHandle<R>,\n        variant: desktop_core::features::UiVariant,\n    ) {\n        if let Ok(mut current) = self.menu_variant.lock() {\n            *current = Some(variant);\n        }\n        if app.menu().is_some() {\n            let _ = menu::rebuild(app, variant);\n        }\n    }\n\n    /// The presentation the Go menu was last reconciled with.\n    pub fn menu_variant(&self) -> Option<desktop_core::features::UiVariant> {\n        self.menu_variant.lock().ok().and_then(|v| *v)\n    }\ncat: apps/desktop/src-tauri/capabilities/default.json: No such file or directory\n","exit_code":1,"status":"failed"}}
