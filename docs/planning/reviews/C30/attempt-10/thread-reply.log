-clippy-order-fix-20261101/native/cumulative/C41/parity/proto/api-light.png\ndocs/planning/evidence/P09/native-history/Worf-generation-03-complete-before-clippy-order-fix-20261101/native/cumulative/C41/parity/api-light.png\ndocs/planning/evidence/C44/native/cumulative/C40/parity/cases-dark.png\ndocs/planning/evidence/C44/native/cumulative/C40/parity/cases-light.png\ndocs/planning/evidence/C44/native/cumulative/C40/parity/bundle.json\ndocs/planning/evidence/C44/native/cumulative/C38/parity/proto/harness-dark.png\ndocs/planning/evidence/C44/native/cumulative/C38/parity/proto/harness-light.png\ndocs/planning/evidence/C44/native/cumulative/C39/parity/proto/review-light.png\ndocs/planning/evidence/C44/native/cumulative/C39/parity/proto/admin-dark.png\ndocs/planning/evidence/C44/native/cumulative/C39/parity/proto/review-dark.png\ndocs/planning/evidence/C44/native/cumulative/C39/parity/proto/admin-light.png\ndocs/planning/evidence/P09/native-history/Worf-generation-03-complete-before-clippy-order-fix-20261101/native/cumulative/C41/parity/app/api-dark.png\ndocs/planning/evidence/P09/native-history/Worf-generation-03-complete-before-clippy-order-fix-20261101/native/cumulative/C41/parity/app/api-light.png\ndocs/planning/evidence/C44/native/cumulative/C40/parity/proto/cases-dark.png\ndocs/planning/evidence/C44/native/cumulative/C40/parity/proto/cases-light.png\ndocs/planning/evidence/C44/native/cumulative/C38/parity/app/harness-dark.png\ndocs/planning/evidence/C44/native/cumulative/C38/parity/app/harness-light.png\ndocs/planning/evidence/C44/native/cumulative/C39/parity/app/review-light.png\ndocs/planning/evidence/C44/native/cumulative/C39/parity/app/admin-dark.png\ndocs/planning/evidence/C44/native/cumulative/C39/parity/app/review-dark.png\ndocs/planning/evidence/C44/native/cumulative/C39/parity/app/admin-light.png\ndocs/planning/evidence/P09/native-history/Worf-generation-03-complete-before-clippy-order-fix-20261101/native/cumulative/C41/native/captures/parity-api-light.png\ndocs/planning/evidence/P09/native-history/Worf-generation-03-complete-before-clippy-order-fix-20261101/native/cumulative/C41/native/captures/parity-api-dark.png\ndocs/planning/evidence/C44/native/cumulative/C40/parity/app/cases-dark.png\ndocs/planning/evidence/C44/native/cumulative/C40/parity/app/cases-light.png\ndocs/planning/evidence/C44/native/cumulative/C38/native/captures/parity-harness-dark.png\ndocs/planning/evidence/C44/native/cumulative/C38/native/captures/parity-harness-light.png\ndocs/planning/evidence/C44/native/cumulative/C39/native/captures/parity-review-dark.png\ndocs/planning/evidence/C44/native/cumulative/C39/native/captures/parity-admin-light.png\ndocs/planning/evidence/C44/native/cumulative/C39/native/captures/parity-review-light.png\ndocs/planning/evidence/C44/native/cumulative/C39/native/captures/parity-admin-dark.png\ndocs/planning/evidence/C44/native/cumulative/C40/native/captures/parity-cases-light.png\ndocs/planning/evidence/C44/native/cumulative/C40/native/captures/parity-cases-dark.png\ndocs/planning/evidence/P09/native-history/C43-Worf-failed-20261101-start-03/native/captures/parity-cases-dark.png\ndocs/planning/evidence/P09/native-history/C43-Worf-failed-20261101-start-03/native/captures/parity-done-dark.png\ndocs/planning/evidence/P09/native-history/C43-Worf-failed-20261101-start-03/native/captures/parity-tenant-dark.png\ndocs/planning/evidence/P09/native-history/C43-Worf-failed-20261101-start-03/native/captures/parity-verify-dark.png\ndocs/planning/evidence/P09/native-history/C43-Worf-failed-20261101-start-03/native/captures/parity-done-light.png\ndocs/planning/evidence/P09/native-history/C43-Worf-failed-20261101-start-03/native/captures/parity-add-tenant-dark.png\ndocs/planning/evidence/P09/native-history/C43-Worf-failed-20261101-start-03/native/captures/parity-welcome-dark.png\ndocs/planning/evidence/P09/native-history/C43-Worf-failed-20261101-start-03/native/captures/parity-add-tenant-light.png\ndocs/planning/evidence/P09/native-history/C43-Worf-failed-20261101-start-03/native/captures/parity-products-dark.png\ndocs/planning/evidence/P09/native-history/C43-Worf-failed-20261101-start-03/native/captures/parity-tenant-light.png\ndocs/planning/evidence/P09/native-history/C43-Worf-failed-20261101-start-03/native/captures/parity-academy-dark.png\ndocs/planning/evidence/P09/native-history/C43-Worf-failed-20261101-start-03/native/captures/parity-cases-light.png\ndocs/planning/evidence/P09/native-history/C43-Worf-failed-20261101-start-03/native/captures/parity-academy-light.png\ndocs/planning/evidence/P09/native-history/C43-Worf-failed-20261101-start-03/native/captures/parity-products-light.png\ndocs/planning/evidence/P09/native-history/C43-Worf-failed-20261101-start-03/native/captures/parity-welcome-light.png\ndocs/planning/evidence/P09/native-history/C43-Worf-failed-20261101-start-03/native/captures/parity-verify-light.png\n","exit_code":0,"status":"completed"}}
