{"type":"item.completed","item":{"id":"item_62","type":"command_execution","command":"/bin/zsh -lc \"sed -n '140,250p' crates/desktop-core/src/authority/management_domain.rs; sed -n '2305,2365p' packages/desktop-contracts/src/client.ts; sed -n '100,165p' apps/desktop/src/v2/modal.tsx; cat apps/desktop/src/v2/toasts.tsx\"","aggregated_output":"    }\n\n    pub(super) fn retire_management_bindings(&mut self) {\n        let keep = self.active_ref.clone();\n        self.management_bindings.retain(|b| {\n            let current = Some(&b.context) == keep.as_ref();\n            if !current {\n                b.session.cancel();\n                // A write already admitted for this cache finds it retired\n                // and places nothing (the credential's cleanup may follow).\n                b.investigation.retire();\n            }\n            current\n        });\n    }\n\n    /// Admits one management read for the active tenant's management\n    /// capability. The scan key is never consulted.\n    /// The active tenant's management binding inputs, checked: a ready\n    /// management credential, its client ID and TSG, and the configured\n    /// token origin equal to the one the credential was stored for. The scan\n    /// key is never consulted.\n    pub(super) fn binding_source(\n        &mut self,\n        context: &ContextRef,\n        keychain: Arc<dyn super::CredentialStore>,\n        session_vault: Arc<SessionVault>,\n    ) -> Result<BindingSource, Refusal> {\n        let tenant = self.check_context(context)?;\n        let current = self.tenant(&tenant).ok_or(Refusal::StaleContext)?;\n        let (record, mode, destination) = match &current.management {\n            ScanCapability::Ready {\n                record,\n                mode,\n                destination,\n            } => (record.clone(), *mode, destination.clone()),\n            _ => return Err(Refusal::CapabilityMissing),\n        };\n        let client_id = current\n            .management_client\n            .clone()\n            .ok_or(Refusal::CapabilityMissing)?;\n        let tsg = current\n            .profile\n            .tsg_id\n            .clone()\n            .ok_or(Refusal::CapabilityMissing)?;\n        // The credential is bound to the token origin it was stored for; a\n        // different configured token origin never receives it.\n        let endpoints = self.management_endpoints.clone();\n        if endpoints.token_origin().as_deref() != Some(destination.as_str()) {\n            return Err(Refusal::CapabilityMissing);\n        }\n        let transport = self\n            .transport\n            .clone()\n            .ok_or(Refusal::CapabilityMissing)?\n            .for_tenant(\n                &self.calls,\n                crate::transport::CallTag {\n                    tenant: tenant.as_str().to_owned(),\n                    purpose: crate::transport::CallPurpose::Management,\n                    credential: crate::transport::CallCredential::ManagementClient,\n                },\n            )\n            .map_err(|_| Refusal::CapabilityMissing)?;\n        // Only a Keychain-stored credential's investigation is sealed on\n        // disk (its key in the same namespace); a session credential's stays\n        // in memory with its generation.\n        let root = self.sessions_root.clone();\n        let sealing: Arc<dyn crate::vault::Vault> = keychain.clone();\n        let credential = record.clone();\n        let (session, binding, investigation) = self.management_binding(context, || {\n            (mode == StorageMode::Keychain)\n                .then_some(root)\n                .flatten()\n                .map(|root| Persistence {\n                    root,\n                    credential,\n                    keychain: sealing,\n                })\n        });\n        Ok(BindingSource {\n            keychain,\n            session_vault,\n            record,\n            mode,\n            client_id,\n            tsg,\n            endpoints,\n            transport,\n            session,\n            binding,\n            investigation,\n        })\n    }\n\n    /// Admits one management read for the active tenant's management\n    /// capability.\n    pub(super) fn admit_management(\n        &mut self,\n        context: ContextRef,\n        request: ManagementRequest,\n        keychain: Arc<dyn super::CredentialStore>,\n        session_vault: Arc<SessionVault>,\n    ) -> Result<(OperationId, Vec<crate::runtime::Start>), Refusal> {\n        self.check_context(&context)?;\n        if !request.is_valid() {\n            return Err(Refusal::InvalidInput);\n        }\n        let gateway = self.gateway_admission(&context, &request)?;\n        Array.isArray(value.held) &&\n        value.held.every((h) => isRecord(h) && isInboxItem(h.item) && oneOf(HOLD_KINDS, h.kind) && optional(isCount, h.returnsAt) && (h.kind !== 'snooze' || h.returnsAt !== null)) &&\n        oneOf(FACES, value.face) &&\n        // All clear only from a fresh read with nothing open.\n        (value.face !== 'allClear' || (value.fresh === true && value.attention.length === 0))\n    )\n}\n\nconst INBOX_KINDS: readonly string[] = ['runtime', 'gateway', 'setupWarning', 'rotation']\nconst READ_STATES: readonly string[] = ['pending', 'reading', 'done', 'failed']\nconst PRODUCT_READ_STATES: readonly string[] = ['pending', 'ok', 'incomplete', 'needsRole', 'failed', 'notRead']\n/** The active tenant's Inbox and read status (C30): entries with their core-computed holds. */\nfunction isInboxView(value: unknown): boolean {\n    if (!isRecord(value) || !Array.isArray(value.items) || !isRecord(value.read)) return false\n    const entries = value.items.every(\n        (e: unknown) =>\n            isRecord(e) &&\n            isString(e.id) &&\n            oneOf(INBOX_KINDS, e.kind) &&\n            typeof e.needsAction === 'boolean' &&\n            oneOf(TONES, e.severity) &&\n            isString(e.title) &&\n            typeof e.detail === 'string' &&\n            typeof e.source === 'string' &&\n            optional((p) => oneOf(PRODUCT_IDS, p), e.product) &&\n            optional(\n                (t) =>\n                    isRecord(t) &&\n                    FEATURE_IDS.includes(t.feature as string) &&\n                    optional((p) => oneOf(PRODUCT_IDS, p), t.product) &&\n                    optional((r) => oneOf(MANAGEMENT_RESOURCES, r), t.resource) &&\n                    optional((i) => typeof i === 'string', t.item),\n                e.target\n            ) &&\n            optional((a) => typeof a === 'string', e.actionLabel) &&\n            Array.isArray(e.facts) &&\n            e.facts.every((f: unknown) => isRecord(f) && typeof f.label === 'string' && typeof f.value === 'string') &&\n            isCount(e.when) &&\n            optional((h) => isRecord(h) && oneOf(HOLD_KINDS, h.kind) && optional(isCount, h.returnsAt) && (h.kind !== 'snooze' || h.returnsAt !== null), e.hold)\n    )\n    const read = value.read\n    return (\n        entries &&\n        oneOf(READ_STATES, read.state) &&\n        optional(isCount, read.lastReadAt) &&\n        optional(isCount, read.failedAt) &&\n        optional(isCount, read.settledAt) &&\n        // A read that is done or failed settled at some time.\n        (read.state === 'pending' || read.state === 'reading' || read.settledAt !== null) &&\n        // A failed read names when it failed; never attempted means neither time.\n        (read.state !== 'failed' || read.failedAt !== null) &&\n        Array.isArray(read.products) &&\n        read.products.every((p: unknown) => isRecord(p) && oneOf(PRODUCT_IDS, p.product) && oneOf(PRODUCT_READ_STATES, p.state) && isCount(p.sourcesRead) && isCount(p.sourcesTotal) && optional((d) => typeof d === 'string', p.detail)) &&\n        Array.isArray(read.sourcesMissing) &&\n        read.sourcesMissing.every((s: unknown) => typeof s === 'string') &&\n        isCount(read.generation) &&\n        optional((p) => oneOf(PRODUCT_IDS, p), read.rechecking) &&\n        // Nothing read yet means no last-read time and no product result.\n        (read.state !== 'pending' || read.lastReadAt === null) &&\n        // The last snooze placed this session: the receipt the shell announces once.\n        optional((r) => isRecord(r) && isString(r.id) && typeof r.title === 'string' && isCount(r.returnsAt) && isCount(r.sequence), value.lastSnooze)\n        }\n        window.addEventListener('keydown', onWindowKey)\n        return () => window.removeEventListener('keydown', onWindowKey)\n    }, [topmost])\n\n    const onKeyDown = (event: KeyboardEvent<HTMLDivElement>) => {\n        if (!topmost) return\n        if (event.key === 'Escape') {\n            event.preventDefault()\n            event.stopPropagation()\n            onClose()\n            return\n        }\n        if (event.key === 'Tab') {\n            // Keyboard interaction stays inside the topmost dialog.\n            const node = dialog.current\n            if (!node) return\n            const items = Array.from(node.querySelectorAll<HTMLElement>(FOCUSABLE)).filter((el) => !el.hasAttribute('hidden') && el.getAttribute('aria-hidden') !== 'true')\n            if (items.length === 0) {\n                event.preventDefault()\n                node.focus()\n                return\n            }\n            const first = items[0] as HTMLElement\n            const last = items[items.length - 1] as HTMLElement\n            const active = document.activeElement\n            if (event.shiftKey && (active === first || active === node)) {\n                event.preventDefault()\n                last.focus()\n            } else if (!event.shiftKey && active === last) {\n                event.preventDefault()\n                first.focus()\n            }\n        }\n    }\n\n    return (\n        <div\n            className={sheet ? 'fixed z-50 flex justify-end' : 'fixed inset-0 z-50 grid place-items-start justify-center'}\n            style={sheet ? { inset: 'var(--v2-header, 56px) 0 0 0' } : { paddingTop: top ?? '4vh' }}\n            data-v2-scrim=''\n            aria-hidden={topmost ? undefined : true}\n            inert={topmost ? undefined : true}\n            onMouseDown={() => topmost && onClose()}\n        >\n            <div\n                ref={dialog}\n                role='dialog'\n                aria-modal={topmost ? 'true' : undefined}\n                aria-label={label}\n                tabIndex={-1}\n                data-slot={rest['data-slot'] ?? 'modal'}\n                data-topmost={topmost ? 'true' : 'false'}\n                onKeyDown={onKeyDown}\n                onMouseDown={(e) => e.stopPropagation()}\n                className='border'\n                // Bounded to the viewport: a tall dialog scrolls inside itself, so its\n                // actions stay reachable at the minimum window size and 200% zoom.\n                style={\n                    sheet\n                        ? { width: `min(${width}px, 100vw)`, height: '100%', overflowY: 'auto', padding, borderRadius: 0, borderLeft: '1px solid var(--v2-rule)', boxShadow: '-18px 0 40px rgba(0,0,0,0.18)', background: 'var(--v2-bg)', borderWidth: 0, color: 'var(--v2-ink)' }\n                        : { width: `min(${width}px, 92vw)`, maxHeight: '92vh', overflowY: 'auto', padding, borderRadius: radius, boxShadow: '0 24px 60px rgba(0,0,0,0.3)', background: 'var(--v2-paper)', borderColor: 'var(--v2-rule)', color: 'var(--v2-ink)' }\n                }\n            >\n                {children}\n            </div>\nimport { useEffect } from 'react'\nimport { CircleAlert, CircleCheck, Info } from 'lucide-react'\nimport { SHELL_COPY } from './copy'\nimport { useShellStore, type Toast } from './store'\n\nconst reducedMotion = () =>\n    typeof window.matchMedia === 'function' && window.matchMedia('(prefers-reduced-motion: reduce)').matches\n\nconst ICONS = { ok: CircleCheck, info: Info, warn: CircleAlert } as const\nconst COLORS = { ok: 'var(--v2-ok)', info: 'var(--v2-get)', warn: 'var(--v2-flag)' } as const\n\n/**\n * The one status surface's transient layer (I10): kinds ok/info/warn with\n * icon and word, a 6 s expiry, and persistence until dismissed when the OS\n * asks for reduced motion. Everything a toast says is derivable from an\n * observed scope; a toast never carries authority.\n */\nexport function Toasts() {\n    const toasts = useShellStore((s) => s.toasts)\n    const scope = useShellStore((s) => s.scope)\n    const dismiss = useShellStore((s) => s.dismissToast)\n    return (\n        <div data-slot='toasts' className='pointer-events-none fixed inset-x-0 bottom-6 z-40 flex justify-center px-4'>\n            {/* Only what speaks for the shown tenant (I2), whatever reached the store. */}\n            {toasts.filter((t) => (t.tenant === null || t.tenant === scope.tenant) && (t.context === null || t.context === scope.context)).map((toast) => (\n                <ToastView key={toast.id} toast={toast} onDismiss={() => dismiss(toast.id)} />\n            ))}\n        </div>\n    )\n}\n\nfunction ToastView({ toast, onDismiss }: { toast: Toast; onDismiss: () => void }) {\n    // The deadline is the toast's, not the render's: re-renders (snapshot\n    // updates) never restart it.\n    useEffect(() => {\n        if (reducedMotion()) return\n        const timer = window.setTimeout(() => useShellStore.getState().dismissToast(toast.id), useShellStore.getState().toastMs)\n        return () => window.clearTimeout(timer)\n    }, [toast.id])\n    const Icon = ICONS[toast.kind]\n    return (\n        <div\n            role='status'\n            aria-live='polite'\n            data-slot='toast'\n            data-kind={toast.kind}\n            className='pointer-events-auto flex max-w-[640px] items-center gap-3 rounded-[12px] border px-4 py-3 text-[13px] shadow-lg'\n            style={{ background: 'var(--v2-paper)', borderColor: 'var(--v2-rule)', color: 'var(--v2-ink)' }}\n        >\n            <Icon aria-hidden='true' size={16} strokeWidth={2.4} style={{ color: COLORS[toast.kind] }} />\n            <span className='sr-only'>{SHELL_COPY.toastPrefix[toast.kind]}</span>\n            <span className='flex-grow'>{toast.text}</span>\n            {toast.undo && (\n                <button\n                    type='button'\n                    onClick={() => {\n                        toast.undo?.run()\n                        onDismiss()\n                    }}\n                    className='h-8 rounded-[7px] border px-3 text-[12px] font-semibold'\n                    style={{ borderColor: 'var(--v2-rule)' }}\n                >\n                    {toast.undo.label}\n                </button>\n            )}\n            <button type='button' aria-label='Dismiss' onClick={onDismiss} className='h-8 w-8 rounded-[7px] text-[16px] leading-none'>\n                ×\n            </button>\n        </div>\n    )\n}\n","exit_code":0,"status":"completed"}}
