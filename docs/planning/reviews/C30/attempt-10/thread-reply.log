(app, \"And the catalog once more?\")\n    tree, n3[\"decision_waiting\"] = app.wait_for(lambda t: fx.App.node(t, \"AXButton\", \"Decline\") is not None, 60)\n    plain(mgmt)\n    c29.open_switcher(app)\n    c29.press(app, \"AXCheckBox\", OTHER_TENANT)\n    tree, n3[\"switcher_guard\"] = app.wait_for(lambda t: guard_dialog(t) is not None, 10)\n    n3[\"guard_buttons\"] = [l for l in (\"Stay\", \"Discard and switch\", \"Archive and switch\") if fx.App.node(tree, \"AXButton\", l)]\n    n3[\"guard_names_target\"] = app.has_text(tree, f\"Switching to {OTHER_TENANT} ends it\")\n    n3[\"initial_focus_stay\"] = ((fx.App.focused(tree) or {}).get(\"label\") or \"\") == \"Stay\"\n    obs[\"tree_guard\"] = c29.save_tree(\"harness-guard\", tree)\n    obs[\"captures\"][\"harness-guard\"] = {\"light\": c29.capture(app, \"harness-guard-light\")}\n    app.keycode(53)\n    tree, n3[\"switcher_stay\"] = app.wait_for(lambda t: guard_dialog(t) is None, 8)\n    time.sleep(0.4)\n    n3[\"still_first_tenant\"] = \"Northwind Health\" in str(c29.switcher(app.tree()).get(\"label\") or \"\")\n    n3[\"decision_kept_after_stay\"] = fx.App.node(app.tree(), \"AXButton\", \"Decline\") is not None\n    app.keys(\"k\", \"command down\")\n    app.wait_for(lambda t: any(n.get(\"role\") == \"AXComboBox\" for n in t), 8)\n    app.keys(f\"Switch to {OTHER_TENANT}\")\n    time.sleep(0.5)\n    app.keycode(36)\n    tree, n3[\"palette_guard\"] = app.wait_for(lambda t: guard_dialog(t) is not None, 10)\n    c29.press(app, \"AXButton\", \"Stay\")\n    _, n3[\"palette_stay\"] = app.wait_for(lambda t: guard_dialog(t) is None, 8)\n    app.menu(\"Go\", \"Switch Tenant…\")\n    app.wait_for(lambda t: any(n.get(\"role\") == \"AXGroup\" and (n.get(\"label\") or \"\") == \"Switch tenant\" for n in t), 8)\n    time.sleep(0.3)\n    c29.press(app, \"AXCheckBox\", OTHER_TENANT)\n    tree, n3[\"menu_guard\"] = app.wait_for(lambda t: guard_dialog(t) is not None, 10)\n    runs_before = len(c19.harness_runs(mgmt))\n    c29.press(app, \"AXButton\", \"Archive and switch\")\n    tree, n3[\"switched\"] = app.wait_for(lambda t: OTHER_TENANT in str(c29.switcher(t).get(\"label\") or \"\") and fx.App.node(t, \"AXHeading\", \"Home\") is not None, 20)\n    n3[\"engine_gone\"] = c19.wait(lambda: not c19.engines(), 20)\n    n3[\"runs_after\"] = len(c19.harness_runs(mgmt)) - runs_before\n    obs[\"tree_switched\"] = c29.save_tree(\"harness-archived-switched\", tree)\n    # The conversation ended through the guard's archive; nothing else runs.\n    n2[\"ended\"] = n3[\"switched\"]\n    n2[\"engine_gone\"] = n3[\"engine_gone\"]\n    obs[\"n2\"] = n2\n    obs[\"n3\"] = n3\n        f\"parity composites {sorted(n1['parity'].values())}\",\n        [run_rel, obs[\"tree_empty\"], obs[\"tree_first\"], obs[\"tree_decision\"], obs[\"tree_approved\"]] + caps(\"harness-empty\") + caps(\"harness-decision\") + sorted(n1[\"parity\"].values()))\n    lay = n2[\"layouts\"]\n    layouts_ok = len(lay) == 4 and all(v[\"overflow_px\"] == 0 and v[\"horizontal_scrollbars\"] == 0 and v[\"decision_populated\"] and v[\"columns\"][\"ok\"] for v in lay.values()) \\\n        and sum(1 for v in lay.values() if v.get(\"width_1440\")) == 2 and sum(1 for v in lay.values() if v.get(\"window_900x600\")) == 2\n    ring_ok = n2[\"ring\"].get(\"diff\", 0) > 150 and n2[\"ring\"].get(\"focused\") == n2[\"composer_action\"]\n    n3_ok = (n3[\"decision_waiting\"] and n3[\"switcher_guard\"] and len(n3[\"guard_buttons\"]) == 3 and n3[\"guard_names_target\"] and n3[\"switcher_stay\"]\n             and n3[\"still_first_tenant\"] and n3[\"decision_kept_after_stay\"] and n3[\"palette_guard\"] and n3[\"palette_stay\"] and n3[\"menu_guard\"]\n             and n3[\"switched\"] and n3[\"engine_gone\"] and n3[\"runs_after\"] == 0)\n    add(\"C38-N03\", n3_ok,\n        f\"with a decision waiting {n3['decision_waiting']}: the switcher's other tenant shows the guard {n3['switcher_guard']} with {n3['guard_buttons']}, naming {OTHER_TENANT} {n3['guard_names_target']}, focus on Stay {n3['initial_focus_stay']}; Escape stays {n3['switcher_stay']} with the first tenant {n3['still_first_tenant']} and the decision kept {n3['decision_kept_after_stay']}; the palette's Switch to entry shows it {n3['palette_guard']} and Stay closes it {n3['palette_stay']}; Go › Switch Tenant… shows it {n3['menu_guard']}; Archive and switch lands {OTHER_TENANT} on Home {n3['switched']}, the engine gone {n3['engine_gone']}, further runs {n3['runs_after']}\",\n        [run_rel, obs[\"tree_guard\"], obs[\"tree_switched\"], obs[\"captures\"][\"harness-guard\"][\"light\"]])\n# C44 — retired legacy native assertions (for the owner's acceptance)\n\nEvery pre-P09 native assertion the one presentation does not exercise natively is listed here with its reason (`tools/native-acceptance/legacy_assertions.py`, kind `r`). The gate (`acceptance_c44.py`, C44-N01) accepts a retirement only when its id is listed in this file and the acceptance line below is present; an assertion removed from this file must gain a native target or the gate fails.\n\nNot retired: the tenant-switch guard with a Harness decision pending (C30-N01, invariant I1) is exercised natively on the Harness board (C38-N03: the switcher, the palette and the Go menu; Stay; Archive and switch), and the staged Runtime key rotation with the host's reveal (C31-N03, invariants I6/I7) by acceptance_c31.py running on the one presentation.\n\n## Acceptance\n\nAccepted by the owner on 2026-10-31. Asked whether to accept the 90 retirements listed below (11 under D060, 6 under D059, 73 whose behaviour the named core or renderer suites hold with no native driver on the one presentation) or to port some into native drivers first, the owner answered, in their own words: \"accepted\". Every retirement below stands on that acceptance; a change to this list is a new decision. Of the 90 accepted, C30-N01 and C31-N03 were then exercised natively after all (C38-N03 on the Harness board; acceptance_c31.py on the one presentation) and stand as exercised in the map, not retired; 88 remain retired.\n\n## D060 — no import from the alpha (11)\n\n| Legacy check | What it asserted | Reason |\n|---|---|---|\n| C02-N06 | Profile import through the native open sheet attached to the main window: a synthetic airs-cli registry with an embedded synthetic secret an… | the airs-cli profile import is retired by D060 (no import from the alpha; its removal is the follow-up chunk's) |\n| C23-N01 | Import from v1 is available in the shell. Look for v1 data finds the staged fixture v1 folder without reading its Keychain (the fixture keyc… | retired by D060 (no import from the alpha): the destination, view, wizard links and first-run frame are removed; no replacement |\n| C23-N02 | Choosing the protected categories shows the Allow-not-Always-Allow note; Review what would be imported reads exactly the selected protected … | retired by D060 (no import from the alpha): the destination, view, wizard links and first-run frame are removed; no replacement |\n| C23-N03 | After the import, the new tenant carries v1's TSG ID with no key (Settings asks for its scan key), its cases are in the Case Library and its… | retired by D060 (no import from the alpha): the destination, view, wizard links and first-run frame are removed; no replacement |\n| C23-N04 | An import stopped by the fixture's crash hook after its first item (the new tenant) was written shows nothing of it while it is stopped: Set… | retired by D060 (no import from the alpha): the destination, view, wizard links and first-run frame are removed; no replacement |\n| C23-N05 | Roll back asks in a native sheet; Cancel keeps the import and returns focus to Roll back; confirming rolls the import back: the tenant it cr… | retired by D060 (no import from the alpha): the destination, view, wizard links and first-run frame are removed; no replacement |\n| C23-N06 | v1 is preserved: every file of the fixture v1 folder has the same bytes, modification time and mode after inspection, review, import, relaun… | retired by D060 (no import from the alpha): the destination, view, wizard links and first-run frame are removed; no replacement |\n| C23-N07 | No credential or sign-in is carried over: the imported tenant has no scan, management or inference key and the synthetic scan and management… | retired by D060 (no import from the alpha): the destination, view, wizard links and first-run frame are removed; no replacement |\n| C23-N08 | The import view works by keyboard alone in tab order (category checkboxes, tenant targets, Review, item checkboxes, Import, Import again aft… | retired by D060 (no import from the alpha): the destination, view, wizard links and first-run frame are removed; no replacement |\n| C23-N09 | Lost import records fail closed and are said: with a receipt damaged in both of its files the import view names it in an alert, Remove damag… | retired by D060 (no import from the alpha): the destination, view, wizard links and first-run frame are removed; no replacement |\n| C14-N13 | Profile adoption previews the staged v1 API Client profile, imports the selected collection into Recent with its private environment, never … | profile adoption from the alpha is retired by D060 (its removal is the follow-up chunk's) |\n\n## D059 — the prototype has no such surface (the legacy shell, or a view it does not draw) (6)\n\n| Legacy check | What it asserted | Reason |\n|---|---|---|\n| C13-N02 | Choosing another statistics window reads that window (LAST_7_DAYS) and says which window is shown.… | the statistics window choice is not on the prototype's card (D059); the windowed read is the core's: crates/desktop-core/tests/redteam_model_reads |\n| C18-N02 | One run is sent only when Run is pressed: once, with the inference key (no management authorization) to the stored endpoint, streaming, at m… | the Gateway Playground is not on the prototype's Gateway card (D059: Overview, Workspaces, Routes, Providers, Guardrails, Keys, I