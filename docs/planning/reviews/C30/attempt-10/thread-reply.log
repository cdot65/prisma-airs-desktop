oard\"),\n    \"C31-N03\": (S, [\"C31-N03\"], \"acceptance_c31.py through legacy_v2: Issue additional key… reviewed and confirmed natively, the issued key revealed through the host's secret sheet, the review exit, the Inbox reminder and its resumption, the old key's removal (invariants I6/I7)\"),\n71:def guard_dialog(tree):\n420:    n3[\"guard_buttons\"] = [l for l in (\"Stay\", \"Discard and switch\", \"Archive and switch\") if fx.App.node(tree, \"AXButton\", l)]\n422:    n3[\"initial_focus_stay\"] = ((fx.App.focused(tree) or {}).get(\"label\") or \"\") == \"Stay\"\n426:    tree, n3[\"switcher_stay\"] = app.wait_for(lambda t: guard_dialog(t) is None, 8)\n437:    _, n3[\"palette_stay\"] = app.wait_for(lambda t: guard_dialog(t) is None, 8)\n481:    n3_ok = (n3[\"decision_waiting\"] and n3[\"switcher_guard\"] and len(n3[\"guard_buttons\"]) == 3 and n3[\"guard_names_target\"] and n3[\"switcher_stay\"]\n482:             and n3[\"still_first_tenant\"] and n3[\"decision_kept_after_stay\"] and n3[\"palette_guard\"] and n3[\"palette_stay\"] and n3[\"menu_guard\"]\n485:        f\"with a decision waiting {n3['decision_waiting']}: the switcher's other tenant shows the guard {n3['switcher_guard']} with {n3['guard_buttons']}, naming {OTHER_TENANT} {n3['guard_names_target']}, focus on Stay {n3['initial_focus_stay']}; Escape stays {n3['switcher_stay']} with the first tenant {n3['still_first_tenant']} and the decision kept {n3['decision_kept_after_stay']}; the palette's Switch to entry shows it {n3['palette_guard']} and Stay closes it {n3['palette_stay']}; Go › Switch Tenant… shows it {n3['menu_guard']}; Archive and switch lands {OTHER_TENANT} on Home {n3['switched']}, the engine gone {n3['engine_gone']}, further runs {n3['runs_after']}\",\n350:    n1[\"detail_action_own\"] = any(n.get(\"role\") == \"AXButton\" and not (n.get(\"label\") or \"\").startswith((\"Acknowledge\", \"Snooze\", \"Unsnooze\", \"Mark as\")) for n in inside)\n366:    # The C30 holds, from the detail card: snoo