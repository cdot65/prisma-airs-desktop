+    let snap = desk.read().await;
+    assert_eq!(snap.inbox.read.generation, 3);
+    tokio::time::sleep(Duration::from_millis(500)).await;
+    assert!(!desk.snap().overview.refreshing);
+    desk.send(json!({"kind": "selectTenant", "tenant": b}))
+        .await
