+        ids = history_ids(&mut desk).await;
+    }
+    assert!(ids.contains(&kept), "archived, it is listed: {ids:?}");
+    assert!(!ids.contains(&history), "the discarded one stays gone");
+    std::fs::remove_dir_all(&dir).expect("cleanup");
+}
