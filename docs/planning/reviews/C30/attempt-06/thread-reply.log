            if (outcome.kind === 'refused') useShellStore.getState().toast(SHELL_COPY.toastRefused(what, outcome.refusal, outcomeMessage(outcome)), 'warn', undefined, bound, boundContext)
            else if (outcome.kind === 'unknown') useShellStore.getState().addUnconfirmed(what, intent)
            else if (outcome.kind === 'failed') useShellStore.getState().toast(SHELL_COPY.toastFailed(what), 'warn', undefined, bound, boundContext)
            return outcome
        },
        [dispatch]
    )
    const v2Preference = useCallback(
        async (what: string, intent: Intent, quiet: Refusal[] = []) => {
            await v2Act(what, intent, quiet)
        },
        [v2Act]
    )

    const onMenu = useRef<(command: MenuCommand) => void>(() => undefined)
    onMenu.current = (command: MenuCommand) => {
        if (command.kind === 'navigate') {
            // Native navigation dismisses the modal palette first so focus can
            // move to the new page heading instead of behind an open dialog.
            if (v2) void v2Navigate(command.feature)
                        onClick={props.onReturnToClassic}
                        title={SHELL_COPY.classic}
                        aria-label={SHELL_COPY.classic}
                        className='flex min-h-8 items-center gap-2 rounded-[7px] text-left text-[12px]'
                        style={{ color: 'var(--v2-faint)' }}
                    >
                        <Undo2 aria-hidden='true' size={14} className='shrink-0' />
                        <span data-v2-label className='underline'>
                            {SHELL_COPY.classic}
                        </span>
                    </button>
                    {snapshot.fixtureBuild && (
                        <p data-slot='build-identity' className='font-mono text-[10px] tracking-[0.14em] uppercase' style={{ color: 'var(--v2-flag)' }}>
                            {SHELL_COPY.fixture}
                        </p>
                    )}
                </div>
            </nav>
            <main
                data-slot='app-main'
                className='min-w-0 flex-grow'
                style={{ padding: 'var(--v2-page-top) var(--v2-page-x) 28px' }}
                aria-hidden={modalOpen ? true : undefined}
                inert={modalOpen ? true : undefined}
            >
                {unconfirmed.length > 0 && (
                    <ul data-slot='unconfirmed' aria-label='Not confirmed' className='mb-4 flex flex-col gap-2'>
                        {unconfirmed.map((u) => (
                            <li key={u.id} role='status' className='flex items-center gap-3 rounded-[12px] border px-4 py-2 text-[13px]' style={{ borderColor: 'var(--v2-flag)', background: 'var(--v2-flag-bg)', color: 'var(--v2-ink)' }}>
                                <span className='flex-grow'>{SHELL_COPY.unconfirmed(u.what)}</span>
                                <button
                                    type='button'
                                    onClick={() => {
                                        clearUnconfirmed(u.id)
                                        props.onRetry(u.what, u.intent)
                                    }}
                                    className='h-8 rounded-[7px] px-3 text-[12px] font-semibold'
                                    style={{ background: 'var(--v2-acc)', color: 'var(--v2-acc-ink)' }}
                                >
                                    {SHELL_COPY.retry}
                                </button>
                                <button type='button' onClick={() => clearUnconfirmed(u.id)} className='h-8 rounded-[7px] border px-3 text-[12px]' style={{ borderColor: 'var(--v2-rule)' }}>
                                    {SHELL_COPY.dismiss}
                                </button>
                            </li>
                        ))}
                    </ul>
                )}
                {feature.id === 'home' ? (
                    <Home ref={heading} snapshot={snapshot} onAct={props.onAct} onNavigate={props.onNavigate} />
                ) : feature.id === 'inbox' ? (
                    <Inbox ref={heading} snapshot={snapshot} onAct={props.onAct} onNavigate={props.onNavigate} />
                ) : (
                    <FeatureBody
                        ref={heading}
                        feature={feature}
                        snapshot={snapshot}
                        appearancePending={props.appearancePending}
                        onSetAppearance={props.onSetAppearance}
                        onNavigate={props.onNavigate}
                        dispatch={props.dispatch}
                        client={props.client}
                        arrival={arrival && arrival.tenant === tenantNow && arrival.feature === feature.id ? arrival : null}
                    />
                )}
                <p role='status' aria-live='polite' data-slot='shell-status' className='mt-4 pb-6 text-[13px]' style={{ color: 'var(--v2-soft)' }}>
                    {props.status}
                </p>
            </main>
            {paletteOpen && (
                <Palette snapshot={snapshot} onNavigate={props.onNavigate} onSwitchTenant={props.onSwitchTenant} onReadNow={props.onReadNow} onClose={closePalette} />
            )}
            {guard && guardTarget && (
                <SwitchGuard target={guardTarget} completion={false} onStay={() => void props.dispatch({ kind: 'dismissSwitchGuard' })} onResolve={(resolution) => props.onSwitchTenant(guard.to, resolution)} />
            )}
            {adding && (
                <Modal label='Add a tenant' onClose={() => setCloseRequests((n) => n + 1)} width={1160} data-slot='add-tenant-sheet'>
                    <Wizard
                        snapshot={snapshot}
                        dispatch={props.dispatch}
                        observeManagement={(operation) => props.client.observeManagement(operation)}
                        mode='add'
                        onClose={closeSheet}
                        closeRequests={closeRequests}
                        onNavigate={(feature) => {
                            setAdding(false)
                            props.onNavigate(feature)
                        }}
                    />
                </Modal>
            )}
            {/* Toasts are background siblings of a modal too (I8): inert and hidden while one is open. */}
            <div aria-hidden={modalOpen ? true : undefined} inert={modalOpen ? true : undefined}>
                <Toasts />
            </div>
        </div>
    )
}
