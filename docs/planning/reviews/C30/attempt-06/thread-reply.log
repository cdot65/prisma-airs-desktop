        expect(tabs).toEqual(['All 4', 'Needs action 2', 'Updates 1', 'Snoozed 1'])
        expect(screen.getByText(/3 of 4 sources were read at \d\d:\d\d\./)).toBeInTheDocument()
        await user.click(screen.getByRole('tab', { name: /Needs action/ }))
