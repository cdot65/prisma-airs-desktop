    /// The active tenant's Inbox (I2): overview items with their holds and
    /// the tenant's setup warnings; nothing of another tenant.
    pub(super) fn inbox_view(&self, overview: &OverviewView) -> InboxView {
        let now = self.clock();
        let holds = self.active_holds();
        let mut items = Vec::new();
        let read_at = overview.read.as_ref().map_or(now, |r| r.read_at);
        let hold_of = |item: &InboxItem| -> Option<HoldView> {
            holds.iter().find_map(|h| {
                if h.id != item.id {
                    return None;
                }
                match h.kind {
                    HoldKind::Acknowledge if crate::observation::level(item) <= h.level => {
                        Some(HoldView {
                            kind: HoldKind::Acknowledge,
                            returns_at: None,
                        })
                    }
                    HoldKind::Snooze if now < h.until => Some(HoldView {
                        kind: HoldKind::Snooze,
                        returns_at: Some(h.until),
                    }),
                    _ => None,
                }
            })
        };
        for item in overview.read.iter().flat_map(|r| r.items.iter()) {
            let (kind, product) = if item.id.starts_with("gateway-") {
                (InboxKind::Gateway, Some(ProductId::Gateway))
            } else {
                (InboxKind::Runtime, Some(ProductId::RuntimeSecurity))
            };
            items.push(InboxEntry {
                id: item.id.clone(),
                kind,
                needs_action: item.action,
                severity: item.tone,
                title: item.title.clone(),
                detail: item.detail.clone(),
                source: item.source.clone(),
                product,
                target: Some(item_target(item)),
                action_label: Some(item.action_label.clone()),
                facts: item.facts.clone(),
                when: read_at,
                hold: hold_of(item),
            });
        }
        if let Some(tenant) = self.data.active.as_ref().and_then(|id| self.tenant(id)) {
            for w in &tenant.setup_warnings {
                let item = setup_warning_item(w);
                let (target, label) = warning_target(w.product);
                items.push(InboxEntry {
                    id: w.id.clone(),
                    kind: InboxKind::SetupWarning,
                    needs_action: true,
                    severity: Tone::Warn,
                    title: item.title.clone(),
                    detail: w.reason.clone(),
                    source: item.source.clone(),
                    product: Some(w.product),
                    target: Some(target),
                    action_label: Some(label.to_owned()),
                    facts: item.facts.clone(),
                    when: w.recorded_secs,
                    hold: hold_of(&item),
                });
            }
        }
        InboxView {
            items,
            read: self.read_status(overview),
            last_snooze: self.active_record().and_then(|r| r.last_snooze.clone()),
        }
    }
}
import { forwardRef } from 'react'
import type { FeatureId, ProductId, ShellSnapshot } from '@prisma-airs/desktop-contracts'
import { FEATURE_ICONS } from '../shell/icons'
import { ENVIRONMENT_LABELS, HOME_COPY, READ_COPY, SHELL_COPY, SNOOZE_COPY, clockOf } from './copy'
import { type Act, destinationFeature, follow, holdWhat, toneOf } from './inbox/inbox'
import { useShellStore } from './store'
import { Verdict } from './verdict'

export interface HomeProps {
    snapshot: ShellSnapshot
    onAct: Act
    onNavigate: (id: FeatureId) => void
}

/**
 * What the empty attention list may say (I4): an all-clear only after a
 * complete read; otherwise the unread, in-progress, failed or partial
 * coverage is named instead.
 */
export function attentionEmpty(snapshot: ShellSnapshot): string {
    const read = snapshot.inbox.read
    if (read.state === 'pending') return HOME_COPY.firstRead
    if (read.state === 'reading' && read.lastReadAt === null) return HOME_COPY.reading
    if (read.state === 'failed' && read.failedAt !== null) {
        return read.lastReadAt === null ? READ_COPY.failed(clockOf(read.failedAt)) : HOME_COPY.clearSoFar(READ_COPY.failedKept(clockOf(read.failedAt), clockOf(read.lastReadAt)))
    }
    if (read.sourcesMissing.length > 0) return HOME_COPY.clearSoFar(READ_COPY.unread(read.sourcesMissing.length))
    // A healthy empty read older than the freshness window is a gap, not an all-clear (C12).
    if (read.state === 'done' && read.lastReadAt !== null && !snapshot.overview.fresh) return HOME_COPY.clearSoFar(READ_COPY.staleQualifier(clockOf(read.lastReadAt)))
    return HOME_COPY.allClear
}

/** The read-status line (I4): first read pending, reading, finished (with partial coverage), or failed. */
export function readLine(snapshot: ShellSnapshot, tenant: string | null): { text: string; tone: 'info' | 'flagged' | 'allowed' | 'blocked' } {
    const read = snapshot.inbox.read
    if (!tenant) return { text: HOME_COPY.noTenant, tone: 'info' }
    if (read.state === 'reading' && read.lastReadAt === null) return { text: HOME_COPY.reading, tone: 'info' }
    // A failed read is failed, attempted or not before: never "pending", never an all-clear.
    if (read.state === 'failed' && read.failedAt !== null) {
        return read.lastReadAt === null ? { text: READ_COPY.failed(clockOf(read.failedAt)), tone: 'blocked' } : { text: READ_COPY.failedKept(clockOf(read.failedAt), clockOf(read.lastReadAt)), tone: 'blocked' }
    }
    if (read.state === 'pending' || (read.lastReadAt === null && read.settledAt === null)) return { text: HOME_COPY.firstRead, tone: 'info' }
    // A settled attempt that established nothing (every source needs a role)
    // is announced for when it settled, never as a first read still pending.
    const when = clockOf(read.lastReadAt ?? read.settledAt ?? 0)
    const needsRole = read.products.filter((p) => p.state === 'needsRole').length
    if (needsRole > 0) return { text: READ_COPY.finishedNeedsRole(when, needsRole), tone: 'flagged' }
    if (read.sourcesMissing.length > 0) return { text: READ_COPY.finishedIncomplete(when, read.sourcesMissing.length), tone: 'flagged' }
    // Expired coverage stays distinct from healthy-empty (C12): the cached read is kept, its age named.
    if (read.state === 'done' && read.lastReadAt !== null && !snapshot.overview.fresh) return { text: READ_COPY.stale(when), tone: 'flagged' }
    const activity = snapshot.overview.read?.summary.sessions
    if (activity === 0 && snapshot.inbox.items.length === 0) return { text: READ_COPY.finishedNoActivity(when, tenant), tone: 'allowed' }
    return { text: READ_COPY.finished(when), tone: 'allowed' }
}

/**
 * Home (C28 skeleton, C30 attention and reads): the destination title row,
 * the tenant line, the one read-status line from the core's ReadStatus, up
 * to five items needing attention with their contextual action, Acknowledge
 * and Snooze (whose label is the Inbox's, I11), one card per chosen product
 * with its read state, and the destinations. Nothing here is invented:
 * every line reads the snapshot.
 */
export const Home = forwardRef<HTMLHeadingElement, HomeProps>(function Home({ snapshot, onAct, onNavigate }, ref) {
    const tenant = snapshot.tenants.find((t) => t.id === snapshot.active?.tenant) ?? null
    const context = snapshot.active?.context ?? null
    const status = readLine(snapshot, tenant?.label ?? null)
    const attention = snapshot.inbox.items.filter((e) => e.needsAction && !e.hold).slice(0, 5)
    const read = snapshot.inbox.read
    // Every action here is a core intent whose outcome reaches the shell's
    // surfaces, named for the tenant or the item (DESIGN-V2 §7).
    const readNow = () => context && tenant && void onAct(SHELL_COPY.readOf(tenant.label), { kind: 'readTenant', context })
    const recheck = async (product: ProductId) => {
        if (!context || !tenant) return
        const label = READ_COPY.products[product] ?? product
        const outcome = await onAct(SHELL_COPY.recheckOf(label, tenant.label), { kind: 'recheckProduct', context, product })
        if (outcome.kind === 'admitted') useShellStore.getState().toast(READ_COPY.recheck(label), 'info', undefined, tenant.id, context)
    }
    const hold = (kind: 'acknowledgeItem' | 'snoozeItem', id: string, title: string) => context && void onAct(holdWhat(kind, title), { kind, context, id })
    return (
        <section aria-labelledby='home-heading' data-slot='home' style={{ maxWidth: 'var(--v2-reading)' }}>
            <div className='flex flex-col gap-1'>
                <h1 ref={ref} id='home-heading' tabIndex={-1} className='font-bold' style={{ fontSize: 'var(--v2-title)' }}>
                    {HOME_COPY.title}
                </h1>
                {tenant && (
                    <p className='text-[13px]' style={{ color: 'var(--v2-soft)' }}>
                        {tenant.label} · {ENVIRONMENT_LABELS[tenant.environment]}
                        {tenant.tsgId ? ` · TSG ${tenant.tsgId}` : ''}
                    </p>
                )}
                <p role='status' aria-live='polite' data-slot='read-status' className='mt-1 flex items-center gap-3 text-[13px]'>
                    <Verdict tone={status.tone} word={status.text} />
                    {context && (
                        <button type='button' onClick={readNow} disabled={read.state === 'reading'} className='h-7 rounded-[7px] border px-2.5 text-[12px] disabled:opacity-60' style={{ borderColor: 'var(--v2-rule)' }}>
                            {HOME_COPY.readNow}
                        </button>
                    )}
                </p>
            </div>
            <div className='mt-6 rounded-[12px] border p-5' style={{ borderColor: 'var(--v2-rule)', background: 'var(--v2-paper)' }}>
                <div className='flex items-center justify-between'>
                    <h2 className='text-[15px] font-semibold'>{HOME_COPY.attention}</h2>
                    <button type='button' onClick={() => onNavigate('inbox')} className='text-[12px] underline' style={{ color: 'var(--v2-acc)' }}>
                        {HOME_COPY.openInbox}
                    </button>
                </div>
                {attention.length === 0 ? (
                    <p className='mt-2 text-[13px]' style={{ color: 'var(--v2-faint)' }}>
                        {attentionEmpty(snapshot)}
                    </p>
                ) : (
                    <ul data-slot='attention' className='mt-3 flex flex-col gap-2'>
                        {attention.map((e) => (
                            <li key={e.id} className='flex flex-wrap items-center gap-2 rounded-[10px] border px-3 py-2' style={{ borderColor: 'var(--v2-rule)' }}>
                                <Verdict tone={toneOf(e.severity)} word={e.severity === 'bad' ? 'Critical' : e.severity === 'warn' ? 'Warning' : 'Info'} />
                                <span className='flex-grow text-[13px] font-medium'>{e.title}</span>
                                <span className='text-[12px]' style={{ color: 'var(--v2-soft)' }}>
                                    {e.product ? READ_COPY.products[e.product] : ''}
                                </span>
                                {destinationFeature(e) && e.actionLabel && tenant && (
                                    <button type='button' onClick={() => follow(e, tenant.id, onNavigate)} className='h-7 rounded-[7px] px-2.5 text-[12px] font-semibold' style={{ background: 'var(--v2-acc)', color: 'var(--v2-acc-ink)' }}>
                                        {e.actionLabel}
                                    </button>
                                )}
                                <button type='button' onClick={() => hold('acknowledgeItem', e.id, e.title)} className='h-7 rounded-[7px] border px-2.5 text-[12px]' style={{ borderColor: 'var(--v2-rule)' }}>
                                    Acknowledge
                                </button>
                                <button type='button' title={SNOOZE_COPY.offer} aria-label={`${SNOOZE_COPY.offer}: ${e.title}`} onClick={() => hold('snoozeItem', e.id, e.title)} className='h-7 rounded-[7px] border px-2.5 text-[12px]' style={{ borderColor: 'var(--v2-rule)' }}>
                                    {SNOOZE_COPY.offer}
                                </button>
                            </li>
                        ))}
                    </ul>
                )}
            </div>
            {tenant && read.products.length > 0 && (
                <div className='mt-6'>
                    <h2 className='text-[15px] font-semibold'>{HOME_COPY.products}</h2>
                    <ul data-slot='products' className='mt-3 grid gap-3' style={{ gridTemplateColumns: 'repeat(auto-fill, minmax(220px, 1fr))' }}>
                        {read.products.map((p) => (
                            <li key={p.product} className='rounded-[12px] border p-4' style={{ borderColor: 'var(--v2-rule)', background: 'var(--v2-paper)' }}>
                                <p className='text-[13px] font-semibold'>{READ_COPY.products[p.product]}</p>
                                <p className='mt-2 flex flex-wrap items-center gap-2'>
                                    <Verdict tone={p.state === 'ok' ? 'allowed' : p.state === 'failed' ? 'blocked' : p.state === 'incomplete' || p.state === 'needsRole' ? 'flagged' : 'info'} word={READ_COPY.productState[p.state] ?? p.state} />
                                    <span className='text-[12px]' style={{ color: 'var(--v2-faint)' }}>
                                        {READ_COPY.sources(p.sourcesRead, p.sourcesTotal)}
                                    </span>
                                </p>
                                {p.detail && (
                                    <p className='mt-1 text-[12px]' style={{ color: 'var(--v2-soft)' }}>
                                        {p.detail}
                                    </p>
                                )}
                                {(p.state === 'needsRole' || p.state === 'failed' || p.state === 'incomplete') && context && (
                                    <button type='button' onClick={() => void recheck(p.product)} disabled={read.state === 'reading'} className='mt-2 h-7 rounded-[7px] border px-2.5 text-[12px] disabled:opacity-60' style={{ borderColor: 'var(--v2-rule)' }}>
                                        Recheck
                                    </button>
                                )}
                            </li>
                        ))}
                    </ul>
                </div>
            )}
            <div className='mt-6'>
                <h2 className='text-[15px] font-semibold'>{HOME_COPY.destinations}</h2>
                <ul className='mt-3 grid gap-3' style={{ gridTemplateColumns: 'repeat(auto-fill, minmax(200px, 1fr))' }}>
                    {snapshot.features
                        .filter((f) => f.sidebar && f.id !== 'home')
                        .map((f) => {
                            const Icon = FEATURE_ICONS[f.id]
                            const unavailable = f.availability.state === 'unavailable'
                            return (
                                <li key={f.id}>
                                    <button
                                        type='button'
                                        disabled={unavailable}
                                        onClick={() => onNavigate(f.id)}
                                        className='flex min-h-11 w-full items-center gap-3 rounded-[12px] border px-4 text-left text-[14px] font-medium disabled:opacity-60'
                                        style={{ borderColor: 'var(--v2-rule)', background: 'var(--v2-paper)' }}
                                    >
                                        <Icon aria-hidden='true' size={16} />
                                        <span className='flex-grow'>{f.label}</span>
                                        {unavailable && f.availability.state === 'unavailable' && (
                                            <span className='text-[11px] uppercase' style={{ color: 'var(--v2-faint)' }}>
                                                {f.availability.plannedChunk}
                                            </span>
                                        )}
                                    </button>
                                </li>
                            )
                        })}
                </ul>
            </div>
        </section>
    )
})
import { forwardRef, useEffect } from 'react'
import type { FeatureId, InboxEntry, Intent, ShellSnapshot } from '@prisma-airs/desktop-contracts'
import type { DispatchOutcome } from '../../features/tenants/dispatch'
import { INBOX_COPY as C, READ_COPY, SHELL_COPY, SNOOZE_COPY, clockOf } from '../copy'
import { useShellStore } from '../store'
import { Verdict, type VerdictTone } from '../verdict'

/**
 * Sends one intent and reports its outcome on the shell's surfaces (DESIGN-V2
 * §7): a refusal or failed delivery as a warn toast naming `what`, an
 * unconfirmed delivery inline with Retry (never replayed on its own).
 */
export type Act = (what: string, intent: Intent) => Promise<DispatchOutcome>

export interface InboxProps {
    snapshot: ShellSnapshot
    onAct: Act
    onNavigate: (feature: FeatureId) => void
}

export type InboxTab = 'all' | 'action' | 'updates' | 'snoozed'
const TABS: InboxTab[] = ['all', 'action', 'updates', 'snoozed']

export const toneOf = (severity: InboxEntry['severity']): VerdictTone => (severity === 'bad' ? 'blocked' : severity === 'warn' ? 'flagged' : 'info')

/** Where an entry's action leads (C30): the destination the core names. */
export function destinationFeature(entry: InboxEntry): FeatureId | null {
    return entry.target?.feature ?? null
}

/**
 * Follows an entry's contextual action: the target's inventory and item are
 * handed to the destination (it selects them on arrival), then the shell
 * navigates through the core.
 */
export function follow(entry: InboxEntry, tenant: string, onNavigate: (feature: FeatureId) => void) {
    const target = entry.target
    if (!target) return
    // The target belongs to the tenant it was followed in (I2): another tenant never inherits it.
    useShellStore.getState().arrive({ tenant, feature: target.feature, resource: target.resource, item: target.item })
    onNavigate(target.feature)
}

/** The tenant-named description of a hold action, for its outcome report. */
export function holdWhat(kind: 'acknowledgeItem' | 'snoozeItem' | 'unsnoozeItem', title: string): string {
    return kind === 'acknowledgeItem' ? SHELL_COPY.acknowledgmentOf(title) : kind === 'snoozeItem' ? SHELL_COPY.snoozeOf(title) : SHELL_COPY.unsnoozeOf(title)
}

/** Which tab an entry belongs to; held entries are never "needs action". */
export function tabOf(entry: InboxEntry): InboxTab {
    if (entry.hold?.kind === 'snooze') return 'snoozed'
    if (entry.needsAction && !entry.hold) return 'action'
    return 'updates'
}

/**
 * The Inbox (C30, screens/inbox-reads.md): the active tenant's entries from
 * the core's Inbox scope, in tabs with counts, a detail pane with the facts,
 * the explanation and the contextual actions. Acknowledge and snooze are
 * core intents on the entry; the snooze return time is the core's and the
 * label is the one Home uses (I11). The selected tab and item are kept per
 * tenant across a switch (I2) and cleared when the tenant is deleted.
 */
export const Inbox = forwardRef<HTMLHeadingElement, InboxProps>(function Inbox({ snapshot, onAct, onNavigate }, ref) {
    const tenant = snapshot.tenants.find((t) => t.id === snapshot.active?.tenant) ?? null
    const context = snapshot.active?.context ?? null
    const tenantKey = tenant?.id ?? 'none'
    const selection = useShellStore((s) => s.inboxSelection[tenantKey])
    const selectInbox = useShellStore((s) => s.selectInbox)
    const tab: InboxTab = selection?.tab ?? 'all'
    const selectedId = selection?.item ?? null
    const items = snapshot.inbox.items
    const counts: Record<InboxTab, number> = { all: items.length, action: 0, updates: 0, snoozed: 0 }
    for (const e of items) counts[tabOf(e)] += 1
    const visible = items.filter((e) => tab === 'all' || tabOf(e) === tab)
    const selected = items.find((e) => e.id === selectedId) ?? null
    useEffect(() => {
        if (selectedId && !items.some((e) => e.id === selectedId)) selectInbox(tenantKey, { tab, item: null })
    }, [items, selectedId, selectInbox, tenantKey, tab])
    const read = snapshot.inbox.read

    // Holds are core intents; their outcomes reach the shell's surfaces. A
    // snooze's return time is the core's: the shell announces it from the
    // receipt the snapshot carries (the same toast whether asked here or on Home).
    const act = (entry: InboxEntry, kind: 'acknowledgeItem' | 'snoozeItem' | 'unsnoozeItem') => context && void onAct(holdWhat(kind, entry.title), { kind, context, id: entry.id })
    const readNow = () => context && tenant && void onAct(SHELL_COPY.readOf(tenant.label), { kind: 'readTenant', context })

    // Never attempted, in progress, failed, partial, expired and healthy-empty
    // reads stay distinct (I4, C12). Entries the core supplies (a setup
    // warning before any read) are listed whatever the read status.
    const failedUnread = read.state === 'failed' && read.lastReadAt === null && read.failedAt !== null
    const stale = read.state === 'done' && read.lastReadAt !== null && !snapshot.overview.fresh
    const empty = !tenant
        ? C.emptyPending
        : items.length === 0 && read.state === 'reading'
          ? C.emptyReading
          : items.length === 0 && read.state === 'pending'
            ? C.emptyPending
            : items.length === 0 && failedUnread
              ? C.emptyFailed(clockOf(read.failedAt ?? 0))
              : items.length === 0 && read.lastReadAt === null && read.settledAt !== null
                ? C.emptyUnread(clockOf(read.settledAt), read.sourcesMissing.length)
                : visible.length === 0
                  ? tab === 'all' || tab === 'action'
                      ? stale
                          ? C.emptyStale(clockOf(read.lastReadAt ?? 0))
                          : C.emptyClear
                      : C.emptyTab
                  : null
    const partialLine =
        read.state === 'failed' && read.failedAt !== null && read.lastReadAt !== null
            ? C.failedKept(clockOf(read.failedAt), clockOf(read.lastReadAt))
            : (read.lastReadAt ?? read.settledAt) !== null && read.sourcesMissing.length > 0
              ? C.partial(read.products.reduce((n, p) => n + p.sourcesRead, 0), read.products.reduce((n, p) => n + p.sourcesTotal, 0), clockOf(read.lastReadAt ?? read.settledAt ?? 0))
              : stale
                ? C.stale(clockOf(read.lastReadAt ?? 0))
                : null

    return (
        <section aria-labelledby='inbox-heading' data-slot='inbox' className='flex min-h-0 flex-col gap-4'>
            <div className='flex items-end justify-between gap-4'>
                <div>
                    <h1 ref={ref} id='inbox-heading' tabIndex={-1} className='font-bold' style={{ fontSize: 'var(--v2-title)' }}>
                        {C.title}
                    </h1>
                    {partialLine && (
                        <p role='status' className='mt-1 text-[13px]' style={{ color: 'var(--v2-soft)' }}>
                            {partialLine}
                        </p>
                    )}
                </div>
                {context && (
                    <button type='button' onClick={readNow} disabled={read.state === 'reading'} className='h-8 rounded-[7px] border px-3 text-[13px] disabled:opacity-60' style={{ borderColor: 'var(--v2-rule)' }}>
                        {C.readNow}
                    </button>
                )}
            </div>
            <div role='tablist' aria-label={C.title} className='flex gap-1'>
                {TABS.map((t) => (
                    <button
                        key={t}
                        role='tab'
                        type='button'
                        aria-selected={tab === t}
                        onClick={() => selectInbox(tenantKey, { tab: t, item: selectedId })}
                        className='h-8 rounded-[7px] px-3 text-[13px]'
                        style={{ background: tab === t ? 'var(--v2-sel)' : 'transparent', color: tab === t ? 'var(--v2-sel-ink)' : 'var(--v2-ink)' }}
                    >
                        {C.tabs[t]} <span style={{ opacity: 0.7 }}>{counts[t]}</span>
                    </button>
                ))}
            </div>
            {/* Two columns while both fit; one under the other at 200% zoom or a narrow window (no horizontal clipping). */}
            <div data-slot='inbox-columns' className='grid min-h-0 min-w-0 gap-4' style={{ gridTemplateColumns: 'repeat(auto-fit, minmax(min(100%, 300px), 1fr))' }}>
                <div className='min-w-0'>
                    {empty ? (
                        <p role='status' data-slot='inbox-empty' className='text-[13px]' style={{ color: 'var(--v2-soft)' }}>
                            {empty}
                        </p>
                    ) : (
                        <ul aria-label={C.ariaList} className='flex flex-col gap-1'>
                            {visible.map((e) => (
                                <li key={e.id}>
                                    <button
                                        type='button'
                                        aria-current={selected?.id === e.id ? 'true' : undefined}
                                        onClick={() => selectInbox(tenantKey, { tab, item: e.id })}
                                        className='flex w-full min-w-0 flex-col gap-1 rounded-[12px] border px-4 py-3 text-left break-words'
                                        style={{ borderColor: selected?.id === e.id ? 'var(--v2-acc)' : 'var(--v2-rule)', background: 'var(--v2-paper)' }}
                                    >
                                        <span className='flex flex-wrap items-center gap-2'>
                                            <Verdict tone={toneOf(e.severity)} word={C.severity[e.severity]} />
                                            <span className='min-w-0 text-[14px] font-medium'>{e.title}</span>
                                            {e.hold?.kind === 'acknowledge' && <span className='text-[11px]' style={{ color: 'var(--v2-faint)' }}>{C.acknowledged}</span>}
                                        </span>
                                        <span className='text-[12px]' style={{ color: 'var(--v2-soft)' }}>
                                            {e.product ? READ_COPY.products[e.product] : C.kind[e.kind]} · {e.source} · {clockOf(e.when)}
                                            {e.hold?.kind === 'snooze' && e.hold.returnsAt !== null ? ` · ${SNOOZE_COPY.returns(e.hold.returnsAt)}` : ''}
                                        </span>
                                    </button>
                                </li>
                            ))}
                        </ul>
                    )}
                </div>
                <aside aria-label={C.detail} data-slot='inbox-detail' className='min-w-0 rounded-[12px] border p-5 break-words' style={{ borderColor: 'var(--v2-rule)', background: 'var(--v2-paper)' }}>
                    {!selected ? (
                        <p className='text-[13px]' style={{ color: 'var(--v2-soft)' }}>
                            {C.selectHint}
                        </p>
                    ) : (
                        <div className='flex flex-col gap-3'>
                            <div className='flex flex-wrap items-center gap-2'>
                                <Verdict tone={toneOf(selected.severity)} word={C.severity[selected.severity]} />
                                <h2 className='min-w-0 text-[16px] font-semibold'>{selected.title}</h2>
                            </div>
