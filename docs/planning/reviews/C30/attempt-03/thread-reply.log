                        feature={feature}
                        snapshot={snapshot}
                        appearancePending={props.appearancePending}
                        onSetAppearance={props.onSetAppearance}
                        onNavigate={props.onNavigate}
                        dispatch={props.dispatch}
                        client={props.client}
                        arrival={arrival && arrival.tenant === tenantNow && arrival.feature === feature.id ? arrival : null}
                    />
                )}
                <p role='status' aria-live='polite' data-slot='shell-status' className='mt-4 pb-6 text-[13px]' style={{ color: 'var(--v2-soft)' }}>
                    {props.status}
                </p>
            </main>
            {paletteOpen && (
                <Palette snapshot={snapshot} onNavigate={props.onNavigate} onSwitchTenant={props.onSwitchTenant} onReadNow={props.onReadNow} onClose={closePalette} />
            )}
            {guard && guardTarget && (
                <SwitchGuard target={guardTarget} completion={false} onStay={() => void props.dispatch({ kind: 'dismissSwitchGuard' })} onResolve={(resolution) => props.onSwitchTenant(guard.to, resolution)} />
            )}
            {adding && (
                <Modal label='Add a tenant' onClose={() => setCloseRequests((n) => n + 1)} width={1160} data-slot='add-tenant-sheet'>
                    <Wizard
                        snapshot={snapshot}
                        dispatch={props.dispatch}
                        observeManagement={(operation) => props.client.observeManagement(operation)}
                        mode='add'
                        onClose={closeSheet}
                        closeRequests={closeRequests}
                        onNavigate={(feature) => {
                            setAdding(false)
                            props.onNavigate(feature)
                        }}
                    />
                </Modal>
            )}
            {/* Toasts are background siblings of a modal too (I8): inert and hidden while one is open. */}
            <div aria-hidden={modalOpen ? true : undefined} inert={modalOpen ? true : undefined}>
                <Toasts />
            </div>
        </div>
    )
}
import type { SwitchResolution } from '@prisma-airs/desktop-contracts'
import { GUARD_COPY } from './copy'
import { Modal } from './modal'

export interface SwitchGuardProps {
    /** The tenant the switch (or the setup completion) leads to. */
    target: string
    /** The switch is a setup draft's completion (the body says so). */
    completion: boolean
    onStay: () => void
    onResolve: (resolution: SwitchResolution) => void
}

/**
 * The one tenant-switch guard (I1): rendered from the core's `switchBlocked`
 * whether the switch was asked for through the switcher, the palette, the
 * native menu or the completion of a setup draft. Stay dismisses the guard;
 * Archive and Discard re-send the same intent with the chosen resolution.
 */
export function SwitchGuard({ target, completion, onStay, onResolve }: SwitchGuardProps) {
    return (
        <Modal label={GUARD_COPY.title} onClose={onStay} width={520} data-slot='switch-guard'>
            <h2 className='text-[16px] font-semibold'>{GUARD_COPY.title}</h2>
            <p className='mt-2 text-[13px]' style={{ color: 'var(--v2-soft)' }}>
                {completion ? GUARD_COPY.bodyCompletion(target) : GUARD_COPY.body(target)}
            </p>
            <div className='mt-4 flex flex-wrap justify-end gap-2'>
                <button type='button' onClick={onStay} className='h-8 rounded-[7px] border px-3 text-[13px]' style={{ borderColor: 'var(--v2-rule)' }}>
                    {GUARD_COPY.stay}
                </button>
                <button type='button' onClick={() => onResolve('discard')} className='h-8 rounded-[7px] border px-3 text-[13px]' style={{ borderColor: 'var(--v2-rule)' }}>
                    {GUARD_COPY.discard}
                </button>
                <button type='button' autoFocus onClick={() => onResolve('archive')} className='h-8 rounded-[7px] px-3 text-[13px] font-semibold' style={{ background: 'var(--v2-acc)', color: 'var(--v2-acc-ink)' }}>
                    {GUARD_COPY.archive}
                </button>
            </div>
        </Modal>
    )
}

