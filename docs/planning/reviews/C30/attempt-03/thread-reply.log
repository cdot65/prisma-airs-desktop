            JobResult::Listed(list) => {
                if h.list_lease == lease {
                    h.list = Some(list);
                }
            }
            JobResult::Opened(record) => {
                if h.lease == lease {
                    h.busy = false;
                    match record {
                        Ok(record) => {
                            h.opened = Some(Arc::new(*record));
                            h.problem = None;
                        }
                        Err(failure) => h.problem = Some(failure),
                    }
                }
            }
            JobResult::Deleted(id, deleted, list) => {
                h.busy = false;
                if deleted.is_ok() {
                    self.history_discard_failures
                        .retain(|(s, i, _)| !(s == scope && i == &id));
                }
                h.problem = deleted.err();
                if h.opened.as_ref().is_some_and(|r| r.id == id) {
                    h.opened = None;
                }
                h.list = Some(list);
            }
            JobResult::Discarded(id, _, list) => {
                if h.opened.as_ref().is_some_and(|r| r.id == id) {
                    h.opened = None;
                }
                if h.list.is_some() {
                    h.list = Some(list);
                }
                h.problem = problem;
