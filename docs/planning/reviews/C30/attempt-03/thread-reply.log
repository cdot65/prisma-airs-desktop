#[tokio::test(flavor = "multi_thread")]
async fn a_fresh_tenant_shows_pending_reads_and_an_empty_inbox() {
    let desk = desk().await;
    let snap = desk.snap();
    assert_eq!(snap.inbox.read.state, ReadState::Pending);
    assert!(snap.inbox.items.is_empty());
    assert_eq!(snap.overview.face, AttentionFace::FirstLaunch);
    assert!(snap.overview.attention.is_empty() && snap.overview.held.is_empty());
    assert_eq!(
        snap.inbox.read.products.len(),
        1,
        "Runtime Security until the setup chooses more"
    );
    assert_eq!(snap.inbox.read.products[0].state, ProductReadState::Pending);
    assert_eq!(snap.inbox.read.generation, 0);
}

#[tokio::test(flavor = "multi_thread")]
async fn reads_report_per_product_coverage_and_a_recheck_names_its_product() {
    let mut desk = desk().await;
    desk.management_key().await;
    let expiring = desktop_core::sessions::rfc3339(now() + 5 * 86_400 + 60);
    desk.script().keys = vec![
        json!({"api_key_id": "k1", "api_key_name": "Runtime", "expiration": expiring, "api_key": "SYNTHETIC-KEY-NEVER-SHOWN"}),
    ];
    let snap = desk.read().await;
    let read = &snap.inbox.read;
    assert_eq!(read.state, ReadState::Done);
    assert!(read.last_read_at.is_some());
    assert_eq!(read.generation, 1);
    assert_eq!(read.products[0].state, ProductReadState::Ok);
    assert_eq!(
        (
            read.products[0].sources_read,
            read.products[0].sources_total
        ),
        (2, 2)
    );
    assert!(read.sources_missing.is_empty());
    // Items carry their kind and product; the key is never in the snapshot.
    let ids: Vec<&str> = snap.inbox.items.iter().map(|i| i.id.as_str()).collect();
    assert_eq!(ids, ["runtime-activity", "runtime-key:k1"]);
    assert!(
        snap.inbox
            .items
            .iter()
            .all(|i| i.kind == InboxKind::Runtime && i.product == Some(ProductId::RuntimeSecurity))
    );
    assert!(
        !serde_json::to_string(&snap)
            .expect("json")
            .contains("SYNTHETIC-KEY-NEVER-SHOWN")
    );
    // A failed chart is partial coverage, named.
    desk.script().chart_status = 503;
    let snap = desk.read().await;
    let read = &snap.inbox.read;
    assert_eq!(read.state, ReadState::Done);
    assert_eq!(read.products[0].state, ProductReadState::Incomplete);
    assert_eq!(read.sources_missing, vec!["sessions chart".to_owned()]);
    assert_eq!(read.generation, 2);
    // A refused source needs a role; a recheck names the product until its read lands.
    desk.script().chart_status = 200;
    desk.script().keys_status = 403;
    let context = desk.context();
    desk.send(json!({"kind": "recheckProduct", "context": context, "product": "runtimeSecurity"}))
        .await
        .expect("recheck admitted");
    assert_eq!(
        desk.snap().inbox.read.rechecking,
        Some(ProductId::RuntimeSecurity)
    );
    assert!(eventually(|| desk.snap().inbox.read.generation == 3).await);
    let read = desk.snap().inbox.read;
    assert_eq!(read.products[0].state, ProductReadState::NeedsRole);
    assert!(read.sources_missing.contains(&"API keys".to_owned()));
    assert_eq!(read.rechecking, None, "answered by the read");
}

#[tokio::test(flavor = "multi_thread")]
async fn snooze_returns_at_a_core_computed_time_shown_the_same_everywhere() {
async fn snooze_returns_at_a_core_computed_time_shown_the_same_everywhere() {
    let mut desk = desk().await;
    desk.management_key().await;
    let expiring = desktop_core::sessions::rfc3339(now() + 3 * 86_400 + 60);
    desk.script().keys =
        vec![json!({"api_key_id": "k1", "api_key_name": "Runtime", "expiration": expiring})];
    desk.read().await;
    let context = desk.context();
    let before = u32::try_from(now()).expect("fits");
    desk.send(json!({"kind": "snoozeItem", "context": context, "id": "runtime-key:k1"}))
        .await
        .expect("snoozed");
    let snap = desk.snap();
    let held = snap
        .overview
        .held
        .iter()
        .find(|h| h.item.id == "runtime-key:k1")
        .expect("held");
    let returns = held.returns_at.expect("a return time");
    assert!(
        (before + 86_400..=before + 86_400 + 5).contains(&returns),
        "24 hours, computed in the core"
    );
    let entry = snap
        .inbox
        .items
        .iter()
        .find(|i| i.id == "runtime-key:k1")
        .expect("entry");
    let hold = entry.hold.as_ref().expect("hold");
    assert_eq!(hold.kind, HoldKind::Snooze);
    assert_eq!(
        hold.returns_at,
        Some(returns),
        "the Inbox states the same time"
    );
    assert!(
        !snap
            .overview
            .attention
            .iter()
            .any(|i| i.id == "runtime-key:k1"),
        "off Home's attention list"
    );
    // Unsnooze brings it back; acknowledge hides it without a return time.
    desk.send(json!({"kind": "unsnoozeItem", "context": context, "id": "runtime-key:k1"}))
        .await
        .expect("unsnoozed");
    assert!(
        desk.snap()
            .overview
            .attention
            .iter()
            .any(|i| i.id == "runtime-key:k1")
    );
    desk.send(json!({"kind": "acknowledgeItem", "context": context, "id": "runtime-key:k1"}))
        .await
        .expect("acknowledged");
    let entry = desk
        .snap()
        .inbox
        .items
        .into_iter()
        .find(|i| i.id == "runtime-key:k1")
        .expect("entry");
    assert_eq!(
        entry.hold.as_ref().map(|h| (h.kind, h.returns_at)),
        Some((HoldKind::Acknowledge, None))
    );
    assert_eq!(
        desk.send(json!({"kind": "snoozeItem", "context": context, "id": "no-such-item"}))
            .await,
        Err(Refusal::InvalidInput)
    );
}

#[tokio::test(flavor = "multi_thread")]
#[tokio::test(flavor = "multi_thread")]
async fn a_pending_decision_refuses_a_tenant_switch_until_it_is_resolved() {
    let mut desk = desk().await;
    let dir = project();
    choose_project(&mut desk, &dir).await;
    let id = ready(&mut desk).await;
    tool(&desk, None, "exec_command", json!({"cmd": "ls"}));
    desk.say(&id, "List the files.").await.expect("sent");
    let c = answered_with(&mut desk, |c| {
        c["approvals"].as_array().is_some_and(|a| !a.is_empty())
    })
    .await;
    let token = c["approvals"][0]["id"].as_str().expect("id").to_owned();
    // Another tenant to switch to.
    let a = desk.json()["active"]["tenant"]
        .as_str()
        .expect("A")
        .to_owned();
    let origin = desk.json()["tenants"][0]["origin"]
        .as_str()
        .expect("origin")
        .to_owned();
    desk.send(
        json!({"kind": "createTenant", "profile": {"label": "Tenant B", "tsgId": "1234567890",
        "destination": {"kind": "custom", "origin": origin}}}),
    )
    .await
    .expect("B");
    let b = desk.json()["tenants"]
        .as_array()
        .expect("tenants")
        .iter()
        .find(|t| t["label"] == "Tenant B")
        .and_then(|t| t["id"].as_str())
        .expect("B id")
        .to_owned();
    // Without a resolution the switch is refused and the guard is published.
    assert_eq!(
        desk.send(json!({"kind": "selectTenant", "tenant": b}))
            .await,
        Err(desktop_core::Refusal::DecisionPending)
    );
    let s = desk.json();
    assert_eq!(s["active"]["tenant"], a, "still on A");
    assert_eq!(s["switchBlocked"]["to"], b);
    assert_eq!(s["switchBlocked"]["pending"]["conversation"], id);
    assert_eq!(s["switchBlocked"]["pending"]["decision"], token);
    assert!(
        s["harness"]["conversation"]["approvals"]
            .as_array()
            .is_some_and(|x| !x.is_empty()),
        "nothing was decided for the operator"
    );
    // Stay: the guard closes, nothing else changes.
    desk.send(json!({"kind": "dismissSwitchGuard"}))
        .await
        .expect("dismissed");
    assert!(desk.json()["switchBlocked"].is_null());
    assert_eq!(desk.json()["active"]["tenant"], a);
    // Archive and switch: the conversation is ended (kept) and B is active.
    desk.send(json!({"kind": "selectTenant", "tenant": b, "resolution": "archive"}))
        .await
        .expect("switched");
    let s = desk.json();
    assert_eq!(s["active"]["tenant"], b);
    assert!(s["switchBlocked"].is_null());
    assert!(
        s["harness"]["conversation"].is_null(),
        "another tenant's conversation is never shown"
    );
    // A plain switch with nothing pending needs no resolution.
    desk.send(json!({"kind": "selectTenant", "tenant": a}))
        .await
        .expect("back to A");
    assert!(
        settle_for(30, || {
            let c = desk.conversation();
            c.is_null() || c["phase"] == "ended" || c["phase"] == "ending"
        })
        .await
    );
}

#[tokio::test(flavor = "multi_thread")]
async fn discard_and_switch_drops_the_pending_conversation() {
async fn completing_a_tenant_setup_is_the_guarded_switch_path() {
    let mut desk = desk().await;
    let dir = project();
    choose_project(&mut desk, &dir).await;
    let id = ready(&mut desk).await;
    tool(&desk, None, "exec_command", json!({"cmd": "ls"}));
    desk.say(&id, "List the files.").await.expect("sent");
    let c = answered_with(&mut desk, |c| {
        c["approvals"].as_array().is_some_and(|a| !a.is_empty())
    })
    .await;
    let token = c["approvals"][0]["id"].as_str().expect("id").to_owned();
    let a = desk.json()["active"]["tenant"]
        .as_str()
        .expect("A")
        .to_owned();
    let origin = desk.json()["tenants"][0]["origin"]
        .as_str()
        .expect("origin")
        .to_owned();
    desk.send(json!({"kind": "beginTenantSetup", "mode": "add", "profile": {"label": "Tenant C", "tsgId": "1234567890",
        "destination": {"kind": "custom", "origin": origin}}}))
        .await
        .expect("draft");
    let setup = desk.json()["setup"].clone();
    let draft = setup["context"].as_str().expect("draft context").to_owned();
    let draft_id = setup["tenant"]["id"].as_str().expect("draft id").to_owned();
    desk.send(json!({"kind": "verifyTenantSetup", "context": draft}))
        .await
        .expect("verify");
    assert!(settle(|| desk.json()["setup"]["verify"]["done"] == true).await);
    assert_eq!(
        desk.send(json!({"kind": "completeTenantSetup", "context": draft, "packs": []}))
            .await,
        Err(desktop_core::Refusal::DecisionPending)
    );
    let s = desk.json();
    assert_eq!(s["active"]["tenant"], a, "still on A");
    assert_eq!(
        s["switchBlocked"]["to"], draft_id,
        "the guard names the draft"
    );
    assert_eq!(s["switchBlocked"]["completion"], true);
    assert_eq!(s["switchBlocked"]["pending"]["conversation"], id);
    assert_eq!(s["switchBlocked"]["pending"]["decision"], token);
    assert_eq!(s["setup"]["context"], draft, "the draft is untouched");
    assert!(
        s["harness"]["conversation"]["approvals"]
            .as_array()
            .is_some_and(|x| !x.is_empty()),
        "nothing was decided for the operator"
    );
    assert!(
        s["tenants"]
            .as_array()
            .expect("tenants")
            .iter()
            .all(|t| t["label"] != "Tenant C"),
        "nothing was committed"
    );
    // Stay: the guard closes; the draft, the tenant and the decision remain.
    desk.send(json!({"kind": "dismissSwitchGuard"}))
        .await
        .expect("dismissed");
    let s = desk.json();
    assert!(s["switchBlocked"].is_null());
    assert_eq!(s["setup"]["context"], draft);
    assert_eq!(s["active"]["tenant"], a);
    // Archive and complete: the conversation ends (kept), the tenant is
    // committed and active, the draft is gone.
    desk.send(json!({"kind": "completeTenantSetup", "context": draft, "packs": [], "resolution": "archive"}))
        .await
        .expect("completed");
    let s = desk.json();
    assert!(s["setup"].is_null());
    assert!(s["switchBlocked"].is_null());
    let c_id = s["tenants"]
        .as_array()
        .expect("tenants")
        .iter()
        .find(|t| t["label"] == "Tenant C")
        .and_then(|t| t["id"].as_str())
        .expect("committed")
        .to_owned();
    assert_eq!(s["active"]["tenant"], c_id);
    assert!(
        s["harness"]["conversation"].is_null(),
        "another tenant's conversation is never shown"
    );
    desk.send(json!({"kind": "selectTenant", "tenant": a}))
        .await
        .expect("back to A");
    assert!(
        settle_for(30, || {
            let c = desk.conversation();
            c.is_null() || c["phase"] == "ended" || c["phase"] == "ending"
        })
        .await
    );
    std::fs::remove_dir_all(&dir).expect("cleanup");
}

