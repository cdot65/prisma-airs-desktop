/** fx.inbox (R2Inbox): Northwind read with partial coverage; items of every kind, one snoozed. */
export function fxInbox(): ShellSnapshot {
    const base = fxSwitcher()
    const nw = tenant({ id: 'tn-0123456789abcdef', label: 'Northwind Health', tsgId: '1762204418', products: ['runtimeSecurity', 'gateway'] })
    return {
        ...base,
        tenants: [nw, base.tenants[1] as TenantView],
        activeFeature: 'inbox',
        inbox: {
            items: [KEY_ITEM, ACTIVITY_ITEM, SNOOZED_ITEM, SETUP_ITEM],
            read: {
                state: 'done',
                lastReadAt: 1_761_490_000,
                failedAt: null,
                products: [
                    { product: 'runtimeSecurity', state: 'ok', sourcesRead: 2, sourcesTotal: 2, detail: null },
                    { product: 'gateway', state: 'incomplete', sourcesRead: 1, sourcesTotal: 2, detail: 'workspace Team A' },
                ],
                sourcesMissing: ['Gateway limits'],
                generation: 1,
                rechecking: null,
            },
            lastSnooze: null,
        },
    }
}

/** fx.fresh: a tenant that has never been read (I12). */
export function fxFresh(): ShellSnapshot {
    return { ...fxSwitcher(), activeFeature: 'home' }
}
/// One Runtime overview read: both sources are read; each keeps its own
/// data or sanitized failure, and what they could not establish is a gap.
async fn runtime_overview(
    binding: &ManagementBinding,
    deadline: Instant,
    gateway: Option<&crate::gateway::WorkspaceScope>,
) -> crate::observation::RuntimeOverview {
    use crate::observation as obs;
    let now = std::time::SystemTime::now()
        .duration_since(std::time::UNIX_EPOCH)
        .map_or(0, |d| d.as_secs());
    let chart = binding
        .sessions_chart(deadline)
        .await
        .and_then(|v| obs::parse_chart(v).ok_or(PageError::Invalid));
    let keys = binding
        .page(ManagementResource::ApiKeys, 0, obs::KEY_PAGE, deadline)
        .await;
    let mut gaps = Vec::new();
    let mut items = Vec::new();
    let (chart, chart_failure, summary) = match chart {
        Ok(chart) => {
            let (summary, chart_gaps) = obs::summarize(&chart);
            gaps.extend(chart_gaps);
            items.extend(obs::activity_item(&summary));
            (Some(chart), None, summary)
        }
        Err(error) => {
            gaps.push("Runtime activity unavailable".to_owned());
            (
                None,
                Some(failure_of(error)),
                obs::RuntimeSummary::default(),
            )
        }
    };
    let (keys_complete, keys_failure) = match keys {
        Ok(page) => {
            let rows: Vec<Value> = serde_json::from_str(&page.items).unwrap_or_default();
            let complete = page.complete;
            let (key_items, key_gaps) =
                obs::key_items(&rows, complete, i64::try_from(now).unwrap_or(i64::MAX));
            items.extend(key_items);
            gaps.extend(key_gaps);
            (complete, None)
        }
        Err(error) => {
            gaps.push("Runtime API keys unavailable".to_owned());
            (false, Some(failure_of(error)))
        }
    };
    let gateway = match gateway {
        Some(scope) => {
            let read = crate::gateway_observe::overview(
                binding.gateway(),
                scope,
                ManagementBinding::options(deadline).as_ref(),
            )
            .await;
            let (item, gateway_gaps) = obs::gateway_items(&read);
            items.extend(item);
            gaps.extend(gateway_gaps);
            Some(read)
        }
        None => None,
    };
    obs::sort_items(&mut items);
    gaps.sort();
    gaps.dedup();
    obs::RuntimeOverview {
        gateway,
        read_at: u32::try_from(now).unwrap_or(u32::MAX),
        chart,
        chart_failure,
        summary,
        keys_complete,
        keys_failure,
        items,
        gaps,
    }
}

/// The product data plane a C13 read goes to.
#[derive(Clone, Copy)]
enum Product {
    RedTeam,
    ModelSecurity,
    AgentGuard,
}

impl ManagementBinding {
    /// One read-only GET to a product's data plane through its SDK client
    /// (OAuth, origin policy, limits and the tenant header as that family
    /// requires), returning the reply as JSON for v1's tolerant rules.
    async fn product_read(
        &self,
        product: Product,
        path: &str,
        query: Vec<(String, String)>,
function isInboxView(value: unknown): boolean {
    if (!isRecord(value) || !Array.isArray(value.items) || !isRecord(value.read)) return false
    const entries = value.items.every(
        (e: unknown) =>
            isRecord(e) &&
            isString(e.id) &&
            oneOf(INBOX_KINDS, e.kind) &&
            typeof e.needsAction === 'boolean' &&
            oneOf(TONES, e.severity) &&
            isString(e.title) &&
            typeof e.detail === 'string' &&
            typeof e.source === 'string' &&
            optional((p) => oneOf(PRODUCT_IDS, p), e.product) &&
            optional(
                (t) =>
                    isRecord(t) &&
                    FEATURE_IDS.includes(t.feature as string) &&
                    optional((p) => oneOf(PRODUCT_IDS, p), t.product) &&
                    optional((r) => oneOf(MANAGEMENT_RESOURCES, r), t.resource) &&
                    optional((i) => typeof i === 'string', t.item),
                e.target
            ) &&
            optional((a) => typeof a === 'string', e.actionLabel) &&
            Array.isArray(e.facts) &&
            e.facts.every((f: unknown) => isRecord(f) && typeof f.label === 'string' && typeof f.value === 'string') &&
            isCount(e.when) &&
            optional((h) => isRecord(h) && oneOf(HOLD_KINDS, h.kind) && optional(isCount, h.returnsAt) && (h.kind !== 'snooze' || h.returnsAt !== null), e.hold)
    )
    const read = value.read
    return (
        entries &&
        oneOf(READ_STATES, read.state) &&
        optional(isCount, read.lastReadAt) &&
        optional(isCount, read.failedAt) &&
        // A failed read names when it failed; never attempted means neither time.
        (read.state !== 'failed' || read.failedAt !== null) &&
        Array.isArray(read.products) &&
        read.products.every((p: unknown) => isRecord(p) && oneOf(PRODUCT_IDS, p.product) && oneOf(PRODUCT_READ_STATES, p.state) && isCount(p.sourcesRead) && isCount(p.sourcesTotal) && optional((d) => typeof d === 'string', p.detail)) &&
        Array.isArray(read.sourcesMissing) &&
        read.sourcesMissing.every((s: unknown) => typeof s === 'string') &&
        isCount(read.generation) &&
        optional((p) => oneOf(PRODUCT_IDS, p), read.rechecking) &&
        // Nothing read yet means no last-read time and no product result.
        (read.state !== 'pending' || read.lastReadAt === null) &&
        // The last snooze placed this session: the receipt the shell announces once.
        optional((r) => isRecord(r) && isString(r.id) && typeof r.title === 'string' && isCount(r.returnsAt) && isCount(r.sequence), value.lastSnooze)
    )
}

