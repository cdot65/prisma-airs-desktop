        tree, back = app.wait_for(lambda t: fx.App.node(t, "AXButton", "Snooze 24 hours: " + title) is not None, 8)
        obs["snooze"]["unsnoozed"] = back
        # Acknowledge from the All tab, where the acknowledged row stays listed with its mark.
