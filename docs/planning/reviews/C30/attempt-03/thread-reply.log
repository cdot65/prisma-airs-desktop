/// The chosen workspace's last day for Home and the Inbox (C18): its
/// requests, errors and cost, and how many limit policies apply. Each
/// source keeps its data or failure.
#[derive(Clone, Debug, PartialEq, Eq, Serialize, TS)]
#[serde(rename_all = "camelCase")]
pub struct GatewayOverview {
    pub workspace: String,
    pub workspace_name: String,
    pub requests: Option<Measure>,
    pub errors: Option<Measure>,
    /// In cents.
    pub cost: Option<Measure>,
    /// The service said the day is over its quota.
    pub partial: bool,
    pub usage_failure: Option<ManagementFailure>,
    /// Usage and rate-limit policies that apply, when both lists were read.
    pub policies: Option<u32>,
    pub limits_failure: Option<ManagementFailure>,
}

impl GatewayOverview {
    /// Whether the day's requests and errors are both known: read, whole
    /// and reported (an absent total or error count is unknown, not zero).
    pub fn activity_known(&self) -> bool {
        self.usage_failure.is_none()
            && !self.partial
            && self.requests.is_some()
            && self.errors.is_some()
    }
}

/// Reads the chosen workspace's last day for the overview.
pub(crate) async fn overview(
    gw: &AIGatewayClient,
    scope: &WorkspaceScope,
    options: Option<&RequestOptions>,
) -> GatewayOverview {
    let telemetry = gw.telemetry();
    let (requests, cost) = match chart(scope, 1) {
        Ok(params) => {
            let requests = match telemetry.requests(&params, options).await {
                Ok(r) => json(&r).and_then(|v| series(&v, false).ok_or(PageError::Invalid)),
                Err(e) => Err(e.into()),
            };
            let cost = match telemetry.cost(&params, options).await {
                Ok(r) => json(&r).and_then(|v| series(&v, false).ok_or(PageError::Invalid)),
                Err(e) => Err(e.into()),
            };
            (requests, cost)
        }
        Err(e) => (Err(e), Err(PageError::Invalid)),
    };
    let usage_failure = requests
        .as_ref()
        .err()
        .or(cost.as_ref().err())
        .map(failure_of);
    let partial =
        requests.as_ref().is_ok_and(|s| s.partial) || cost.as_ref().is_ok_and(|s| s.partial);
    let limits = limits(gw, scope, options).await;
    let (policies, limits_failure) = match &limits {
        Ok(l) => match (&l.usage, &l.rate) {
            (Some(u), Some(r)) if u.complete && r.complete => (
                u32::try_from(u.policies.len() + r.policies.len()).ok(),
                None,
            ),
            _ => (None, l.usage_failure.or(l.rate_failure)),
        },
        Err(e) => (None, Some(failure_of(e))),
    };
    GatewayOverview {
        workspace: scope.id.clone(),
        workspace_name: scope.name.clone(),
        requests: requests.as_ref().ok().and_then(|s| s.total),
        errors: requests.as_ref().ok().and_then(|s| s.errors),
        cost: cost.as_ref().ok().and_then(|s| s.total),
        partial,
        usage_failure,
        policies,
        limits_failure,
    }
}

/// What an observation read produced.
#[derive(Clone, Debug, PartialEq, Eq, Serialize, TS)]
#[serde(tag = "kind", rename_all = "camelCase")]
pub enum ObserveResult {
    Usage { usage: Box<GatewayUsage> },
    Logs { logs: Box<GatewayLogs> },
    Limits { limits: Box<GatewayLimits> },
}

/// Runs one admitted observation read of the chosen workspace.
pub(crate) async fn read(
    gw: &AIGatewayClient,
    read: &ObserveRead,
    scope: &WorkspaceScope,
    options: Option<&RequestOptions>,
) -> Result<ObserveResult, PageError> {
    if !read.is_valid() {
        return Err(PageError::Invalid);
    }
    match read {
        ObserveRead::Usage { days } => {
            usage(gw, scope, *days, options)
                .await
                .map(|usage| ObserveResult::Usage {
                    usage: Box::new(usage),
                })
        }
        rest = &frac[digits..];
    }
    let offset = match rest {
        "Z" | "z" => 0,
        _ if rest.len() == 6
            && matches!(rest.as_bytes()[0], b'+' | b'-')
            && rest.as_bytes()[3] == b':' =>
        {
            let oh: i64 = rest.get(1..3)?.parse().ok()?;
            let om: i64 = rest.get(4..6)?.parse().ok()?;
            let sign = if rest.starts_with('-') { -1 } else { 1 };
            sign * (oh * 3600 + om * 60)
        }
        _ => return None,
    };
    // Days from civil (Howard Hinnant).
    let y2 = if mo <= 2 { y - 1 } else { y };
    let era = y2.div_euclid(400);
    let yoe = y2 - era * 400;
    let mp = (mo + 9) % 12;
    let doy = (153 * mp + 2) / 5 + d - 1;
    let doe = yoe * 365 + yoe / 4 - yoe / 100 + doy;
    let days = era * 146_097 + doe - 719_468;
    Some(days * 86_400 + h * 3600 + mi * 60 + s - offset)
}

fn plural(n: i64, word: &str) -> String {
    format!("{n} {word}{}", if n == 1 { "" } else { "s" })
}

/// v1's key-expiry insights from the first key page: one item per active
/// key whose expiration is within 30 days (inclusive), and a gap for active
/// keys whose expiration is missing or unparseable.
pub fn key_items(keys: &[Value], complete: bool, now: i64) -> (Vec<InboxItem>, Vec<String>) {
    let source = if complete {
        "Runtime Security API keys".to_owned()
    } else {
        "Runtime Security API keys · partial inventory".to_owned()
    };
    let mut items = Vec::new();
    let mut unreported = 0;
    for key in keys {
        let text = |k: &str| key.get(k).and_then(Value::as_str).unwrap_or_default();
        let status = text("status").to_ascii_lowercase();
        if key.get("revoked").and_then(Value::as_bool) == Some(true)
            || key.get("removed").and_then(Value::as_bool) == Some(true)
            || matches!(status.as_str(), "revoked" | "disabled")
        {
            continue;
        }
        let Some(expires) = parse_instant(text("expiration")) else {
            unreported += 1;
            continue;
        };
        let days = (expires - now).div_euclid(86_400);
        if days > EXPIRY_DAYS {
            continue;
        }
        let name = [text("api_key_name"), text("name"), text("api_key_id")]
            .into_iter()
            .find(|s| !s.is_empty())
            .unwrap_or("API key")
            .to_owned();
        let id = [text("api_key_id"), text("id"), text("api_key_name")]
            .into_iter()
            .find(|s| !s.is_empty())
            .unwrap_or("key");
        let expired = expires < now;
        let title = if expired {
            let ago = (now - expires).div_euclid(86_400).max(1);
            format!("{name} expired {} ago", plural(ago, "day"))
        } else if days == 0 {
            format!("{name} expires today")
        } else {
            format!("{name} expires in {}", plural(days, "day"))
        };
        items.push(InboxItem {
            id: format!("runtime-key:{id}"),
            title,
            detail: "Review this key and rotate or replace it before its clients lose access. This insight reads expiration metadata only; opening it never retrieves a secret.".to_owned(),
            source: source.clone(),
            action: true,
            tone: if expired { Tone::Bad } else { Tone::Warn },
            destination: InboxDestination::ApiKeys,
            action_label: "Manage API keys".to_owned(),
            facts: vec![
                Fact { label: "Key".into(), value: name.clone() },
                Fact { label: "Expires".into(), value: text("expiration").to_owned() },
                Fact { label: "Source".into(), value: source.clone() },
            ],
            per_mille: None,
        });
    }
    let mut gaps = Vec::new();
    if unreported > 0 {
        gaps.push(format!(
            "{source}: {} unreported",
            plural(unreported, "key expiration")
        ));
    }
    if !complete {
        gaps.push("Runtime Security API keys · partial inventory".to_owned());
    }
    (items, gaps)
}

async fn a_truncated_listing_is_incomplete_coverage_not_a_complete_read() {
    let mut desk = desk().await;
    desk.script().more_rows = 500;
    desk.tenant_with_products("Tenant T", &["runtimeSecurity", "redTeam", "modelSkill"])
        .await;
    let snap = desk.read().await;
    let read = &snap.inbox.read;
    assert_eq!(read.state, ReadState::Done);
    let of = |product: ProductId| {
        read.products
            .iter()
            .find(|p| p.product == product)
            .expect("product")
    };
    let red_team = of(ProductId::RedTeam);
    assert_eq!(red_team.state, ProductReadState::Incomplete, "{red_team:?}");
    assert_eq!((red_team.sources_read, red_team.sources_total), (1, 2));
    assert!(
        red_team
            .detail
            .as_deref()
            .is_some_and(|d| d.contains("1 of 501 scans listed")),
        "{red_team:?}"
    );
    let model_skill = of(ProductId::ModelSkill);
    assert_eq!(
        model_skill.state,
        ProductReadState::Incomplete,
        "{model_skill:?}"
    );
    assert_eq!(
        (model_skill.sources_read, model_skill.sources_total),
        (2, 3)
    );
    assert_eq!(
        read.sources_missing,
        vec![
            "Red Team scan list".to_owned(),
            "model scan list".to_owned()
        ]
    );
    // The inventory in one page: complete.
    desk.script().more_rows = 0;
    let snap = desk.read().await;
    let read = &snap.inbox.read;
    assert!(
        read.sources_missing.is_empty(),
        "{:?}",
        read.sources_missing
    );
    assert!(
        read.products
            .iter()
            .all(|p| p.state == ProductReadState::Ok),
        "{:?}",
        read.products
    );
}

/// C30 (I4): an admitted first read that fails before any source answers
/// (the token grant refused) is a failed read: never "pending" (it was
/// attempted) and never done; its products are failed, its sources named
/// as missing, and the completion counts so the presentation announces the
/// failure. A later read recovers; a failed refresh after a good read keeps
/// the good read and says when the refresh failed.
//! C28 (D058): the v2 shell's Rust-owned presentation state through the
//! production authority interface: the `ui_variant` flag, the per-variant
//! feature catalogue the menu/sidebar/palette share, `navigate`, onboarding
//! transitions and the "show the calls" preference, all persisted or
//! session-scoped exactly as state-ownership.md assigns them.

use desktop_core::features::{self, FeatureId, OnboardingState, UiVariant};
use desktop_core::fixtures::{self, Handles, ScriptedStore};
use desktop_core::store::PersistedState;
use desktop_core::{
    AuthorityHandle, Core, CoreConfig, Delivery, Intent, Observation, Receipt, Refusal,
    ShellSnapshot, ViewScope,
};
use serde_json::json;

struct Desk {
    _core: Core,
    handle: AuthorityHandle,
    session: String,
    sequence: u64,
    adapters: Handles,
}

impl Desk {
    fn new() -> Self {
        Self::from_state(PersistedState::default())
    }

    fn from_state(state: PersistedState) -> Self {
        let (adapters, handles) = fixtures::adapters_with(ScriptedStore::with_state(state));
        let core = Core::new(CoreConfig::default(), adapters);
        core.start();
        let handle = core.operator();
        let session = handle.register_delivery_session().expect("session").nonce;
        Self {
            _core: core,
            handle,
            session,
            sequence: 0,
            adapters: handles,
        }
    }

    fn restart(self) -> Self {
        let state = self.adapters.store.saved().unwrap_or_default();
        drop(self._core);
        Self::from_state(state)
    }

    async fn send(&mut self, intent: serde_json::Value) -> Result<Receipt, Refusal> {
        let intent: Intent = serde_json::from_value(intent).expect("intent");
        self.sequence += 1;
        self.handle
            .dispatch(
                Delivery {
                    session: self.session.clone(),
                    sequence: self.sequence,
                },
                intent,
            )
            .await
    }

    fn snap(&self) -> ShellSnapshot {
        match self.handle.observe(ViewScope::Shell).expect("observe") {
            Observation::Shell { snapshot, .. } => snapshot,
            _ => unreachable!("shell scope"),
        }
    }
}

