   758	enum JobResult {
   759	    Listed(Result<Vec<Listed>, HistoryFailure>),
   760	    Opened(Result<Box<Record>, HistoryFailure>),
   761	    Deleted(
   762	        String,
   763	        Result<(), HistoryFailure>,
   764	        Result<Vec<Listed>, HistoryFailure>,
   765	    ),
   766	    Discarded(
   767	        String,
   768	        Result<(), HistoryFailure>,
   769	        Result<Vec<Listed>, HistoryFailure>,
   770	    ),
   771	}
   772	
   773	pub(super) async fn run_job(inner: Arc<Inner>, job: HistoryJob) {
   774	    let vault = Arc::clone(&inner.adapters.keychain);
   775	    let hold = match lock(&inner) {
   776	        Ok(state) => Arc::clone(&state.history_hold),
   777	        Err(_) => return,
   778	    };
   779	    let (lease, scope, result) = tokio::task::spawn_blocking(move || match job {
   780	        HistoryJob::List { lease, scope } => {
   781	            let list = history::list(&*vault, &scope);
   782	            (lease, scope, JobResult::Listed(list))
   783	        }
   784	        HistoryJob::Open { lease, scope, id } => {
   785	            let record = history::read(&*vault, &scope, &id).map(Box::new);
   786	            (lease, scope, JobResult::Opened(record))
   787	        }
   788	        HistoryJob::Delete { lease, scope, id } => {
   789	            let deleted = history::delete(&scope, &id);
   790	            let list = history::list(&*vault, &scope);
   791	            (lease, scope, JobResult::Deleted(id, deleted, list))
   792	        }
   793	        HistoryJob::Discard { scope, id } => {
   794	            // After any save of it under way (the sink holds the same lock
