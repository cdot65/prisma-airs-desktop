    /** Delivers one intent; resolves with the native receipt or refusal. */
    dispatch(intent: Intent): Promise<DispatchResponse> {
        const run = this.#queue.then(() => this.#deliver(intent))
        this.#queue = run.catch(() => undefined)
        return run
    }

