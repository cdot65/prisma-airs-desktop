    onReadNow: () => void
    /** Re-sends a delivery the desktop did not confirm, only on the operator's click. */
    onRetry: (what: string, intent: Intent) => void
    /** Sends one intent and reports its outcome on the shell's surfaces (Home and Inbox actions). */
    onAct: Act
    dispatch: Dispatch
    client: DesktopClient
}

const THEMES: { value: Theme; label: string; icon: typeof Sun }[] = [
    { value: 'system', label: SHELL_COPY.appearanceSystem, icon: SunMoon },
    { value: 'light', label: SHELL_COPY.appearanceLight, icon: Sun },
    { value: 'dark', label: SHELL_COPY.appearanceDark, icon: Moon },
]

/**
 * The "Refined Native" shell (C28, DESIGN-V2): a 244px rail with the tenant
 * switcher on top, the Rust navigation inventory (labels and ⌘ hints come
 * from the same catalogue the native menu is built from), appearance and
 * "show the calls" preferences, one status surface and the modal stack.
 * Every destination other than Home renders the same FeatureBody the legacy
 * shell renders, so behaviour is identical whichever shell frames it.
 */
export function V2Shell(props: V2ShellProps) {
    const { snapshot } = props
    const paletteOpen = useShellStore((s) => s.paletteOpen)
    const openPalette = useShellStore((s) => s.openPalette)
    const closePalette = useShellStore((s) => s.closePalette)
    const unconfirmedAll = useShellStore((s) => s.unconfirmed)
    // Only deliveries bound to the shown context, or to none (I2).
    const unconfirmed = unconfirmedAll.filter((u) => u.context === null || u.context === (snapshot.active?.context ?? null))
    const clearUnconfirmed = useShellStore((s) => s.clearUnconfirmed)
    const arrival = useShellStore((s) => s.arrival)
    const modalOpen = useModalsOpen()
    const heading = useRef<HTMLHeadingElement>(null)
    const firstRender = useRef(true)
    const [adding, setAdding] = useState(false)
    // The sheet closes only when the wizard says so: a committed tenant (toast)
    // or a discard the core admitted. Escape and the scrim are close requests
    // the wizard answers with the same Cancel as its button.
    const [closeRequests, setCloseRequests] = useState(0)
    const closeSheet = (added?: string) => {
        setAdding(false)
        setCloseRequests(0)
        if (added) useShellStore.getState().toast(SHELL_COPY.tenantAdded(added), 'ok')
    }
    const active = snapshot.activeFeature
    const feature = snapshot.features.find((f) => f.id === active) ?? snapshot.features[0]
    // Completion toasts are derived from the core's ReadStatus (I4): a new
    // generation is one finished read; its kind follows the coverage. A
    // tenant change re-baselines (the other tenant's generation is its own).
    const read = snapshot.inbox.read
    const tenantNow = snapshot.active?.tenant ?? null
    const seenGeneration = useRef<{ tenant: string | null; generation: number }>({ tenant: tenantNow, generation: read.generation })
    useEffect(() => {
        const seen = seenGeneration.current
        seenGeneration.current = { tenant: tenantNow, generation: read.generation }
        if (seen.tenant !== tenantNow || read.generation === seen.generation) return
        const tenant = snapshot.tenants.find((t) => t.id === tenantNow)
        const line = readLine(snapshot, tenant?.label ?? null)
        useShellStore.getState().toast(line.text, line.tone === 'allowed' ? 'ok' : 'warn', undefined, tenantNow)
    }, [read.generation, tenantNow, snapshot])
    // A snooze is announced once, from the receipt the core issues for it
    // (I11): the return time is the core's, wherever the snooze was asked
    // for. Holds a tenant already had, or a read rediscovers, are not news.
    const lastSnooze = snapshot.inbox.lastSnooze
    const seenSnooze = useRef<{ tenant: string | null; sequence: number }>({ tenant: tenantNow, sequence: lastSnooze?.sequence ?? 0 })
    useEffect(() => {
        const seen = seenSnooze.current
        const sequence = lastSnooze?.sequence ?? 0
        seenSnooze.current = { tenant: tenantNow, sequence }
        if (seen.tenant !== tenantNow || !lastSnooze || sequence === seen.sequence) return
        useShellStore.getState().toast(SNOOZE_COPY.toast(lastSnooze.title, lastSnooze.returnsAt), 'info', undefined, tenantNow)
    }, [lastSnooze, tenantNow])
    // Presentation state follows its tenant (I2): an arrival another tenant
    // asked for is forgotten, a toast that spoke for another tenant's item or
    // read is retired (however long Reduce Motion would have kept it), and an
    // unconfirmed delivery bound to a retired context is dropped (it can
    // never be revived, let alone rebound).
    const contextNow = snapshot.active?.context ?? null
    useEffect(() => {
        useShellStore.getState().scopeArrival(tenantNow)
        useShellStore.getState().retireToasts(tenantNow)
        useShellStore.getState().retireUnconfirmed(contextNow)
    }, [tenantNow, contextNow])
    // The guard for a switch asked here (I1); a setup draft's completion
    // renders the same guard inside the wizard, which re-sends the completion.
    const guard = snapshot.switchBlocked && !snapshot.switchBlocked.completion ? snapshot.switchBlocked : null
    const guardTarget = guard ? snapshot.tenants.find((t) => t.id === guard.to)?.label ?? guard.to : null

    useEffect(() => {
        // Move focus to the new page heading after navigation (not on launch).
        if (firstRender.current) {
            firstRender.current = false
            return
        }
        heading.current?.focus()
    }, [active])

    if (!feature) return null
    return (
        <div data-v2-shell='' className='flex min-h-screen'>
            <nav
                data-v2-rail=''
                aria-label={SHELL_COPY.navLabel}
                aria-hidden={modalOpen ? true : undefined}
                inert={modalOpen ? true : undefined}
                className='sticky top-0 flex h-screen shrink-0 flex-col gap-2 overflow-y-auto p-3'
                style={{ width: 'var(--v2-rail)', background: 'var(--v2-side)', borderRight: '1px solid var(--v2-rule)' }}
            >
                <TenantSwitcher snapshot={snapshot} onSwitch={props.onSwitchTenant} onAdd={() => setAdding(true)} />
                <ul className='mt-2 flex flex-col gap-0.5'>
                    {snapshot.features
                        .filter((f) => f.sidebar)
                        .map((f) => {
                            const Icon = FEATURE_ICONS[f.id]
                            const current = f.id === feature.id
                            const unavailable = f.availability.state === 'unavailable'
                            const reason = f.availability.state === 'unavailable' ? f.availability.reason : ''
                            return (
                                <li key={f.id}>
                                    <button
                                        type='button'
                                        aria-current={current ? 'page' : undefined}
                                        aria-disabled={unavailable || undefined}
                                        aria-describedby={unavailable ? `${f.id}-hint` : undefined}
                                        title={unavailable ? SHELL_COPY.unavailableHint(reason) : f.shortcut !== null ? `${f.label} (⌘${f.shortcut})` : f.label}
                                        onClick={() => !unavailable && props.onNavigate(f.id)}
                                        data-inset-focus=''
                                        className='flex min-h-9 w-full items-center gap-2.5 rounded-[7px] px-2.5 text-left text-[14px] font-medium'
                                        style={{
                                            background: current ? 'var(--v2-sel)' : 'transparent',
                                            color: current ? 'var(--v2-sel-ink)' : unavailable ? 'var(--v2-faint)' : 'var(--v2-ink)',
                                        }}
                                    >
                                        <Icon aria-hidden='true' size={16} />
                                        <span data-v2-label className='flex-grow truncate'>
                                            {f.label}
                                        </span>
                                        {f.shortcut !== null && (
                                            <kbd data-v2-label className='text-[11px]' aria-label={`Command ${f.shortcut}`} style={{ opacity: 0.75 }}>
                                                ⌘{f.shortcut}
                                            </kbd>
                                        )}
                                    </button>
                                    {unavailable && (
                                        <span id={`${f.id}-hint`} className='sr-only'>
                                            {SHELL_COPY.unavailableHint(reason)}
                                        </span>
                                    )}
                                </li>
                            )
                        })}
                </ul>
                <button
                    type='button'
                    data-slot='palette-trigger'
                    onClick={openPalette}
                    className='mt-1 flex min-h-9 items-center justify-between rounded-[7px] border px-2.5 text-[12px]'
                    style={{ borderColor: 'var(--v2-rule)', color: 'var(--v2-faint)' }}
                >
                    <span data-v2-label>{SHELL_COPY.palette}</span>
                    <kbd aria-label='Command K'>⌘K</kbd>
                </button>
                <div className='mt-auto flex flex-col gap-2 pt-3' style={{ borderTop: '1px solid var(--v2-rule)' }}>
                    <fieldset aria-busy={props.appearancePending} data-v2-stack='' className='flex gap-1'>
                        <legend className='sr-only'>{SHELL_COPY.appearance}</legend>
                        {THEMES.map((t) => (
                            <button
                                key={t.value}
                                type='button'
                                aria-pressed={snapshot.appearance === t.value}
                                aria-label={t.label}
                                title={t.label}
                                onClick={() => props.onSetAppearance(t.value)}
                                className='grid size-8 place-items-center rounded-[7px] border'
                                style={{
                                    borderColor: 'var(--v2-rule)',
                                    background: snapshot.appearance === t.value ? 'var(--v2-acc-soft)' : 'transparent',
                                }}
                            >
                                <t.icon aria-hidden='true' size={14} />
                            </button>
                        ))}
                    </fieldset>
                    <label className='flex min-h-8 items-center gap-2 text-[12px]' title={SHELL_COPY.showCallsHint}>
                        <Eye aria-hidden='true' size={14} className='shrink-0' />
                        <input
                            type='checkbox'
                            aria-label={SHELL_COPY.showCalls}
                            aria-describedby='v2-show-calls-hint'
                            checked={snapshot.showCalls}
                            onChange={(e) => props.onSetShowCalls(e.target.checked)}
//! Inbox, reads and the tenant-switch guard (C30, screens/inbox-reads.md,
//! invariants I1, I2, I4, I11, I12). Everything here is derived per tenant
//! from scopes the core already owns: the Runtime overview read (its items,
//! sources and failures), the operator's holds, the tenant's chosen
//! products and its setup warnings (C29). The core computes the snooze
//! return time, the per-product read status and whether a switch may
//! proceed; the presentation renders them.

use serde::{Deserialize, Serialize};
use ts_rs::TS;

use super::observation_domain::{
    FailedAttempt, HoldKind, OverviewView, ProductOutcome, SnoozeReceipt, product_sources,
    source_names,
};
use super::{PendingDecisionRef, Refusal, State, SwitchBlocked};
use crate::features::{FeatureId, ProductId, SetupWarning};
use crate::management::{ManagementFailure, ManagementResource};
use crate::observation::{Fact, InboxDestination, InboxItem, Tone};
use crate::tenants::TenantId;

/// How a blocked switch is resolved (I1): the pending conversation is
/// ended and kept (`archive`) or ended and dropped (`discard`).
#[derive(Clone, Copy, Debug, PartialEq, Eq, Serialize, Deserialize, TS)]
#[serde(rename_all = "camelCase")]
pub enum SwitchResolution {
    Archive,
    Discard,
}

/// Where an Inbox entry came from.
#[derive(Clone, Copy, Debug, PartialEq, Eq, Serialize, TS)]
#[serde(rename_all = "camelCase")]
pub enum InboxKind {
    /// A Runtime overview item (sessions, keys).
    Runtime,
    /// The chosen Gateway workspace's day (C18).
    Gateway,
    /// A warning recorded at tenant setup (C29).
    SetupWarning,
}

/// An operator's hold on an entry, with the core-computed return time.
#[derive(Clone, Debug, PartialEq, Eq, Serialize, TS)]
#[serde(rename_all = "camelCase")]
pub struct HoldView {
    pub kind: HoldKind,
    /// When a snoozed entry returns (seconds since the epoch); none for an
    /// acknowledgment, which ends when the item's level rises.
    pub returns_at: Option<u32>,
}

/// Where an entry's action leads (C30): the destination, and within it the
/// product, the inventory and the item the presentation selects on arrival.
#[derive(Clone, Debug, PartialEq, Eq, Serialize, TS)]
#[serde(rename_all = "camelCase")]
pub struct InboxTarget {
    pub feature: FeatureId,
    pub product: Option<ProductId>,
    /// The Administration inventory to open (API keys for a key item).
    pub resource: Option<ManagementResource>,
    /// The item's name within that inventory, for the filter.
    pub item: Option<String>,
}

/// One Inbox entry of the active tenant.
#[derive(Clone, Debug, PartialEq, Eq, Serialize, TS)]
#[serde(rename_all = "camelCase")]
pub struct InboxEntry {
    pub id: String,
    pub kind: InboxKind,
    /// Needs action (otherwise an update).
    pub needs_action: bool,
    pub severity: Tone,
    pub title: String,
    pub detail: String,
    pub source: String,
    pub product: Option<ProductId>,
    /// Where the action leads, with the context it carries.
    pub target: Option<InboxTarget>,
    pub action_label: Option<String>,
    pub facts: Vec<Fact>,
    /// When it was observed or recorded (seconds since the epoch).
    pub when: u32,
    pub hold: Option<HoldView>,
}

/// The read as a whole.
#[derive(Clone, Copy, Debug, PartialEq, Eq, Serialize, TS)]
#[serde(rename_all = "camelCase")]
pub enum ReadState {
    /// Nothing has been read for this tenant yet.
    Pending,
    Reading,
    Done,
    /// The last read failed; an older read may be shown.
    Failed,
}

/// One product's part of the read.
#[derive(Clone, Copy, Debug, PartialEq, Eq, Serialize, TS)]
#[serde(rename_all = "camelCase")]
pub enum ProductReadState {
    Pending,
    Ok,
    /// Some of its sources were not read.
    Incomplete,
    /// A source refused the client for permissions.
    NeedsRole,
    Failed,
    /// Nothing reads this product on Home; its destination does.
    NotRead,
}

#[derive(Clone, Debug, PartialEq, Eq, Serialize, TS)]
#[serde(rename_all = "camelCase")]
pub struct ProductRead {
    pub product: ProductId,
    pub state: ProductReadState,
    pub sources_read: u32,
    pub sources_total: u32,
    pub detail: Option<String>,
}

/// The active tenant's read status (I4), derived from the overview read.
#[derive(Clone, Debug, PartialEq, Eq, Serialize, TS)]
#[serde(rename_all = "camelCase")]
pub struct ReadStatus {
    pub state: ReadState,
    pub last_read_at: Option<u32>,
    /// When the last read failed (seconds since the epoch); with
    /// `last_read_at`, an older read is shown.
    pub failed_at: Option<u32>,
    /// When the latest attempt settled, established or not (seconds since
    /// the epoch): the time a completion is announced with when nothing was
    /// established yet.
    pub settled_at: Option<u32>,
    pub products: Vec<ProductRead>,
    /// Sources the last read could not establish, by name.
    pub sources_missing: Vec<String>,
    /// Counts completed reads of this tenant in this session: a change is
    /// a completion the presentation may announce.
    pub generation: u32,
    /// The product a `recheckProduct` asked for, until the next read lands.
    pub rechecking: Option<ProductId>,
}

/// The Inbox scope (per tenant, I2).
#[derive(Clone, Debug, PartialEq, Eq, Serialize, TS)]
#[serde(rename_all = "camelCase")]
pub struct InboxView {
    pub items: Vec<InboxEntry>,
    pub read: ReadStatus,
    /// The last snooze placed on this tenant in this session (I11).
    pub last_snooze: Option<SnoozeReceipt>,
}

fn product_label(product: ProductId) -> &'static str {
    match product {
        ProductId::RuntimeSecurity => "AI Runtime Security",
        ProductId::Gateway => "AI Gateway",
        ProductId::RedTeam => "AI Red Teaming",
        ProductId::ModelSkill => "Model and skill scans",
    }
}

fn warning_destination(product: ProductId) -> InboxDestination {
    match product {
        ProductId::Gateway => InboxDestination::Gateway,
        _ => InboxDestination::ApiKeys,
    }
}

/// Where a setup warning is fixed (C30): the scan key and the management
/// client live in Settings, a Gateway workspace in AI Gateway, the Red Team
/// and model/skill services in AI Red Teaming.
fn warning_target(product: ProductId) -> (InboxTarget, &'static str) {
    let (feature, label) = match product {
        ProductId::RuntimeSecurity => (FeatureId::Settings, "Open Settings"),
        ProductId::Gateway => (FeatureId::Gateway, "Open AI Gateway"),
        ProductId::RedTeam | ProductId::ModelSkill => (FeatureId::RedTeam, "Open AI Red Teaming"),
    };
    (
        InboxTarget {
            feature,
            product: Some(product),
            resource: None,
            item: None,
        },
        label,
    )
}

/// Where a Runtime overview item's action leads: an API key item opens the
/// API keys inventory filtered to that key.
fn item_target(item: &InboxItem) -> InboxTarget {
    match item.destination {
        InboxDestination::ApiKeys => InboxTarget {
            feature: FeatureId::Administration,
            product: Some(ProductId::RuntimeSecurity),
            resource: Some(ManagementResource::ApiKeys),
            item: item
                .facts
                .iter()
                .find(|f| f.label == "Key")
                .map(|f| f.value.clone()),
        },
        InboxDestination::Sessions => InboxTarget {
            feature: FeatureId::Sessions,
            product: Some(ProductId::RuntimeSecurity),
            resource: None,
            item: None,
        },
        InboxDestination::Gateway => InboxTarget {
            feature: FeatureId::Gateway,
            product: Some(ProductId::Gateway),
            resource: None,
            item: None,
        },
    }
}

/// A setup warning as an attention item (C29 → C30): the item id is the
/// warning's `vw-<n>`, so holds address it like any other item.
pub(super) fn setup_warning_item(w: &SetupWarning) -> InboxItem {
    InboxItem {
        id: w.id.clone(),
        title: format!("{}: setup warning", product_label(w.product)),
        detail: w.reason.clone(),
        source: "Setup · verify".to_owned(),
        action: true,
        tone: Tone::Warn,
        destination: warning_destination(w.product),
        action_label: warning_target(w.product).1.to_owned(),
        facts: vec![Fact {
            label: "Product".to_owned(),
            value: product_label(w.product).to_owned(),
        }],
        per_mille: None,
    }
}

fn source_state(failure: Option<ManagementFailure>) -> ProductReadState {
    match failure {
        None => ProductReadState::Ok,
        Some(ManagementFailure::Denied | ManagementFailure::Unauthorized) => {
            ProductReadState::NeedsRole
        }
        Some(_) => ProductReadState::Failed,
    }
}

fn pending(product: ProductId) -> ProductRead {
    ProductRead {
        product,
        state: ProductReadState::Pending,
        sources_read: 0,
        sources_total: product_sources(product),
        detail: None,
    }
}

fn needs_role_failure(failure: Option<ManagementFailure>) -> bool {
    matches!(
        failure,

2026-10-28T17:07:01.280477Z ERROR codex_models_manager::manager: failed to refresh available models: request timed out
codex
The predecessor evidence still shows C29’s required live verification as blocked. I’m checking C30’s code independently, including the latest fixes for read coverage and delayed notifications.
exec
/bin/zsh -lc "sed -n '265,760p' crates/desktop-core/src/authority/inbox_domain.rs; sed -n '1,260p' crates/desktop-core/src/authority/observation_domain.rs" in /Users/cdot/development/redtail/prisma-airs-desktop-v2
 succeeded in 0ms:
        failure,
        Some(ManagementFailure::Denied | ManagementFailure::Unauthorized)
    )
}

fn combined(needs_role: bool, read_count: u32, total: u32) -> ProductReadState {
    if needs_role {
        ProductReadState::NeedsRole
    } else if read_count == total {
        ProductReadState::Ok
    } else if read_count == 0 {
        ProductReadState::Failed
    } else {
        ProductReadState::Incomplete
    }
}

/// A product's finite outcome as its read entry, naming each source it
/// did not establish.
fn product_read(
    product: ProductId,
    o: &ProductOutcome,
    sources_missing: &mut Vec<String>,
) -> ProductRead {
    let state = combined(o.needs_role, o.sources_read, o.sources_total);
    sources_missing.extend(o.missing.iter().cloned());
    ProductRead {
        product,
        state,
        sources_read: o.sources_read,
        sources_total: o.sources_total,
        detail: Some(match (state, o.failure) {
            (ProductReadState::Ok, _) => o.detail.clone(),
            (_, Some(f)) => format!("{f:?}: {}", o.detail),
            (_, None) => o.detail.clone(),
        }),
    }
}

/// A product whose latest attempt established nothing: its failure, with
/// every source named missing and the retained older read (if any) named.
fn failed_product(
    product: ProductId,
    f: &FailedAttempt,
    kept: Option<&ProductOutcome>,
    sources_missing: &mut Vec<String>,
) -> ProductRead {
    let names = source_names(product);
    sources_missing.extend(names.iter().map(|n| (*n).to_owned()));
    let older = kept.map_or(String::new(), |o| {
        format!("; the read from {} ({}) is kept", o.read_at, o.detail)
    });
    ProductRead {
        product,
        state: if f.needs_role {
            ProductReadState::NeedsRole
        } else {
            ProductReadState::Failed
        },
        sources_read: 0,
        sources_total: names.len() as u32,
        detail: Some(match f.failure {
            Some(failure) => format!("{failure:?}: {}{older}", f.detail),
            None => format!("{}{older}", f.detail),
        }),
    }
}

impl State {
    /// The decision the active tenant's conversation is waiting for, if any.
    pub(super) fn pending_decision(&self) -> Option<PendingDecisionRef> {
        let conversation = self.live_bound_harness()?;
        let approvals = self.bound_approvals();
        let first = approvals.first()?;
        Some(PendingDecisionRef {
            conversation: conversation.as_str().to_owned(),
            decision: first.id.clone(),
        })
    }

    /// Admits a tenant switch, or refuses it while a decision is pending
    /// (I1): the refusal carries the guard the presentation renders.
    pub(super) fn guard_switch(
        &mut self,
        to: &TenantId,
        resolution: Option<SwitchResolution>,
        completion: bool,
    ) -> Result<(), Refusal> {
        let Some(pending) = self.pending_decision() else {
            self.switch_blocked = None;
            return Ok(());
        };
        let id = self.live_bound_harness().ok_or(Refusal::Busy)?;
        match resolution {
            None => {
                self.switch_blocked = Some(SwitchBlocked {
                    to: to.clone(),
                    pending,
                    completion,
                });
                Err(Refusal::DecisionPending)
            }
            Some(SwitchResolution::Archive) => {
                self.end_harness(&id)?;
                self.switch_blocked = None;
                Ok(())
            }
            Some(SwitchResolution::Discard) => {
                self.discard_harness(&id)?;
                self.switch_blocked = None;
                Ok(())
            }
        }
    }

    /// The active tenant's setup warnings as items.
    pub(super) fn setup_warning_items(&self) -> Vec<InboxItem> {
        self.data
            .active
            .as_ref()
            .and_then(|id| self.tenant(id))
            .map(|t| t.setup_warnings.iter().map(setup_warning_item).collect())
            .unwrap_or_default()
    }

    /// The products the active tenant chose (Runtime Security until a setup
    /// chooses more).
    pub(super) fn selected_products(&self, tenant: &TenantId) -> Vec<ProductId> {
        self.tenant(tenant)
            .map(|t| {
                if t.products.is_empty() {
                    vec![ProductId::RuntimeSecurity]
                } else {
                    t.products.clone()
                }
            })
            .unwrap_or_default()
    }

    /// The per-product read status (I4) from the overview read, the other
    /// products' finite outcomes and the tenant's chosen products. Coverage
    /// a read did not establish is named in `sources_missing`, so nothing
    /// unread is ever announced as complete.
    pub(super) fn read_status(&self, overview: &OverviewView) -> ReadStatus {
        let products = self
            .data
            .active
            .as_ref()
            .map(|id| self.selected_products(id))
            .unwrap_or_default();
        let record = self.active_record();
        // A refresh in which no source answered is shown by the overview for
        // its gaps (C12) but established nothing: it is not a read.
        let read = overview.read.as_ref().filter(|r| {
            !(overview.failure.is_some() && r.chart.is_none() && r.keys_failure.is_some())
        });
        let outcomes_read = record.is_some_and(|r| r.red_team.is_some() || r.model_skill.is_some());
        // The latest failed attempts across the chosen products; a missing
        // role is a settled attempt reported on the product, not a failed read.
        let attempts: Vec<&FailedAttempt> = record
            .map(|r| {
                [
                    (ProductId::RedTeam, r.red_team_failed.as_ref()),
                    (ProductId::ModelSkill, r.model_skill_failed.as_ref()),
                ]
                .into_iter()
                .filter(|(p, _)| products.contains(p))
                .filter_map(|(_, f)| f)
                .collect()
            })
            .unwrap_or_default();
        let product_failures: Vec<&FailedAttempt> =
            attempts.iter().copied().filter(|f| !f.needs_role).collect();
        let failed_at = overview
            .failed_at
            .into_iter()
            .chain(product_failures.iter().map(|f| f.at))
            .max();
        // Attempted: something settled for this tenant, established or not.
        let attempted =
            read.is_some() || outcomes_read || overview.failure.is_some() || !attempts.is_empty();
        // A failed read is failed, however little it established: never
        // "pending" (it was attempted) and never "done".
        let state = if overview.refreshing {
            ReadState::Reading
        } else if overview.failure.is_some() || !product_failures.is_empty() {
            ReadState::Failed
        } else if !attempted {
            ReadState::Pending
        } else {
            ReadState::Done
        };
        let failed_without_data = |product: ProductId, sources_missing: &mut Vec<String>| {
            let names = source_names(product);
            sources_missing.extend(names.iter().map(|n| (*n).to_owned()));
            ProductRead {
                product,
                state: if needs_role_failure(overview.failure) {
                    ProductReadState::NeedsRole
                } else {
                    ProductReadState::Failed
                },
                sources_read: 0,
                sources_total: names.len() as u32,
                detail: overview.failure.map(|f| format!("{f:?}")),
            }
        };
        let mut sources_missing = Vec::new();
        let mut per_product = Vec::new();
        for product in products.clone() {
            let entry = match product {
                ProductId::RuntimeSecurity => match read {
                    None if overview.failure.is_some() => {
                        failed_without_data(product, &mut sources_missing)
                    }
                    None => pending(product),
                    Some(r) => {
                        // Established means read and whole: a chart with
                        // inconsistent totals or a key page with an unreported
                        // expiration is unread coverage, not a complete read.
                        let chart = if r.chart_failure.is_some() {
                            source_state(r.chart_failure)
                        } else if r.chart_established() {
                            ProductReadState::Ok
                        } else {
                            ProductReadState::Incomplete
                        };
                        let keys = if r.keys_failure.is_some() {
                            source_state(r.keys_failure)
                        } else if r.keys_established() {
                            ProductReadState::Ok
                        } else {
                            ProductReadState::Incomplete
                        };
                        if chart != ProductReadState::Ok {
                            sources_missing.push("sessions chart".to_owned());
                        }
                        if keys != ProductReadState::Ok {
                            sources_missing.push("API keys".to_owned());
                        }
                        let read_count = u32::from(chart == ProductReadState::Ok)
                            + u32::from(keys == ProductReadState::Ok);
                        let state = combined(
                            chart == ProductReadState::NeedsRole
                                || keys == ProductReadState::NeedsRole,
                            read_count,
                            2,
                        );
                        ProductRead {
                            product,
                            state,
                            sources_read: read_count,
                            sources_total: 2,
                            detail: (state != ProductReadState::Ok).then(|| {
                                r.chart_failure.or(r.keys_failure).map_or_else(
                                    || {
                                        r.gaps
                                            .iter()
                                            .find(|g| {
                                                g.contains("unreported") || g.starts_with("Runtime")
                                            })
                                            .cloned()
                                            .unwrap_or_else(|| {
                                                "the key inventory was not complete".to_owned()
                                            })
                                    },
                                    |f| format!("{f:?}"),
                                )
                            }),
                        }
                    }
                },
                ProductId::Gateway => match read {
                    None if overview.failure.is_some() => {
                        failed_without_data(product, &mut sources_missing)
                    }
                    None => pending(product),
                    // A chosen product without a workspace is unread coverage,
                    // not a complete read.
                    Some(r) if r.gateway.is_none() => {
                        sources_missing.push("Gateway workspace (none chosen)".to_owned());
                        ProductRead {
                            product,
                            state: ProductReadState::Incomplete,
                            sources_read: 0,
                            sources_total: 2,
                            detail: Some(
                                "No Gateway workspace chosen; choose one in AI Gateway.".to_owned(),
                            ),
                        }
                    }
                    Some(r) => {
                        let g = r.gateway.as_ref().expect("checked");
                        // Usage is established only when the day's requests
                        // and errors are both known (read, whole, reported).
                        let usage = if g.usage_failure.is_some() {
                            source_state(g.usage_failure)
                        } else if g.activity_known() {
                            ProductReadState::Ok
                        } else {
                            ProductReadState::Incomplete
                        };
                        let limits = if g.limits_failure.is_some() {
                            source_state(g.limits_failure)
                        } else if g.policies.is_some() {
                            ProductReadState::Ok
                        } else {
                            ProductReadState::Incomplete
                        };
                        if usage != ProductReadState::Ok {
                            sources_missing.push("Gateway usage".to_owned());
                        }
                        if limits != ProductReadState::Ok {
                            sources_missing.push("Gateway limits".to_owned());
                        }
                        let read_count = u32::from(usage == ProductReadState::Ok)
                            + u32::from(limits == ProductReadState::Ok);
                        let state = combined(
                            usage == ProductReadState::NeedsRole
                                || limits == ProductReadState::NeedsRole,
                            read_count,
                            2,
                        );
                        ProductRead {
                            product,
                            state,
                            sources_read: read_count,
                            sources_total: 2,
                            detail: (state != ProductReadState::Ok)
                                .then(|| format!("workspace {}", g.workspace_name)),
                        }
                    }
                },
                ProductId::RedTeam | ProductId::ModelSkill => {
                    let (outcome, failed) = record.map_or((None, None), |r| match product {
                        ProductId::RedTeam => (r.red_team.as_ref(), r.red_team_failed.as_ref()),
                        _ => (r.model_skill.as_ref(), r.model_skill_failed.as_ref()),
                    });
                    match (outcome, failed) {
                        (None, None) => pending(product),
                        // The latest attempt established nothing: reported as
                        // such, with the retained read (if any) named as older.
                        (kept, Some(f)) => failed_product(product, f, kept, &mut sources_missing),
                        (Some(o), None) => product_read(product, o, &mut sources_missing),
                    }
                }
            };
            per_product.push(entry);
        }
        // Once anything was attempted, a chosen product nothing has reached
        // yet is unread coverage like any other (I4): named, so no completion
        // is announced as complete over it.
        if attempted {
            for entry in per_product
                .iter()
                .filter(|p| p.state == ProductReadState::Pending)
            {
                sources_missing.extend(source_names(entry.product).iter().map(|n| (*n).to_owned()));
            }
        }
        let last_read_at = read
            .map(|r| r.read_at)
            .into_iter()
            .chain(record.and_then(|r| r.red_team.as_ref()).map(|o| o.read_at))
            .chain(
                record
                    .and_then(|r| r.model_skill.as_ref())
                    .map(|o| o.read_at),
            )
            .max();
        let settled_at = last_read_at
            .into_iter()
            .chain(overview.failed_at)
            .chain(attempts.iter().map(|f| f.at))
            .max();
        ReadStatus {
            state,
            last_read_at,
            failed_at,
            settled_at,
            products: per_product,
            sources_missing,
            generation: record.map_or(0, |r| r.generation),
            rechecking: record.and_then(|r| r.rechecking),
        }
    }

    /// The active tenant's Inbox (I2): overview items with their holds and
    /// the tenant's setup warnings; nothing of another tenant.
    pub(super) fn inbox_view(&self, overview: &OverviewView) -> InboxView {
        let now = self.clock();
        let holds = self.active_holds();
        let mut items = Vec::new();
        let read_at = overview.read.as_ref().map_or(now, |r| r.read_at);
        let hold_of = |item: &InboxItem| -> Option<HoldView> {
            holds.iter().find_map(|h| {
                if h.id != item.id {
                    return None;
                }
                match h.kind {
                    HoldKind::Acknowledge if crate::observation::level(item) <= h.level => {
                        Some(HoldView {
                            kind: HoldKind::Acknowledge,
                            returns_at: None,
                        })
                    }
                    HoldKind::Snooze if now < h.until => Some(HoldView {
                        kind: HoldKind::Snooze,
                        returns_at: Some(h.until),
                    }),
                    _ => None,
                }
            })
        };
        for item in overview.read.iter().flat_map(|r| r.items.iter()) {
            let (kind, product) = if item.id.starts_with("gateway-") {
                (InboxKind::Gateway, Some(ProductId::Gateway))
            } else {
                (InboxKind::Runtime, Some(ProductId::RuntimeSecurity))
            };
            items.push(InboxEntry {
                id: item.id.clone(),
                kind,
                needs_action: item.action,
                severity: item.tone,
                title: item.title.clone(),
                detail: item.detail.clone(),
                source: item.source.clone(),
                product,
                target: Some(item_target(item)),
                action_label: Some(item.action_label.clone()),
                facts: item.facts.clone(),
                when: read_at,
                hold: hold_of(item),
            });
        }
        if let Some(tenant) = self.data.active.as_ref().and_then(|id| self.tenant(id)) {
            for w in &tenant.setup_warnings {
                let item = setup_warning_item(w);
                let (target, label) = warning_target(w.product);
                items.push(InboxEntry {
                    id: w.id.clone(),
                    kind: InboxKind::SetupWarning,
                    needs_action: true,
                    severity: Tone::Warn,
                    title: item.title.clone(),
                    detail: w.reason.clone(),
                    source: item.source.clone(),
                    product: Some(w.product),
                    target: Some(target),
                    action_label: Some(label.to_owned()),
                    facts: item.facts.clone(),
                    when: w.recorded_secs,
                    hold: hold_of(&item),
                });
            }
        }
        InboxView {
            items,
            read: self.read_status(overview),
            last_snooze: self.active_record().and_then(|r| r.last_snooze.clone()),
        }
    }
}
//! Runtime Home/Inbox state inside the authority (C12, C30): each opened
//! tenant's last overview read (kept when a refresh fails, marked with its
//! failure, and kept across a switch away and back, I2), the finite outcomes
//! of its other products' Home reads, its read bookkeeping, and the
//! operator's attention holds per tenant. A healthy empty source, a failed
//! one and one not yet read stay distinct; "all clear" is claimed only from
//! a fresh read of both sources with nothing open and no gap.
//!
//! A read is admitted under a context; its reply is recorded only while that
//! context is current (a retired context's reply is withdrawn and never
//! shown), but the tenant's recorded read outlives the context it was made
//! under: switching A → B → A shows A's cached read again until a new one
//! lands.

use serde::{Deserialize, Serialize};
use ts_rs::TS;

use super::{Refusal, State};
use crate::context::ContextRef;
use crate::features::ProductId;
use crate::management::{ManagementFailure, ManagementResult};
use crate::observation::{FRESH_SECS, HOLD_LIMIT, InboxItem, RuntimeOverview, SNOOZE_SECS, level};
use crate::tenants::TenantId;

/// How the operator set an attention item aside.
#[derive(Clone, Copy, Debug, PartialEq, Eq, Serialize, Deserialize, TS)]
#[serde(rename_all = "camelCase")]
pub enum HoldKind {
    /// Hidden until its level rises above the acknowledged level.
    Acknowledge,
    /// Hidden for 24 hours.
    Snooze,
}

#[derive(Clone, Debug, PartialEq, Eq)]
pub(super) struct Hold {
    pub(super) id: String,
    pub(super) kind: HoldKind,
    pub(super) level: u8,
    pub(super) until: u32,
}

/// What Needs attention can say (v1 faces, Runtime only).
#[derive(Clone, Copy, Debug, PartialEq, Eq, Serialize, TS)]
#[serde(rename_all = "camelCase")]
pub enum AttentionFace {
    /// Something needs attention.
    Items,
    /// Nothing has been read yet.
    FirstLaunch,
    /// A fresh, complete read of every source with nothing open.
    AllClear,
    /// Nothing open, but a source failed, is stale, partial or unknown.
    Gap,
}

#[derive(Clone, Debug, PartialEq, Eq, Serialize, TS)]
#[serde(rename_all = "camelCase")]
pub struct HeldItem {
    pub item: InboxItem,
    pub kind: HoldKind,
    /// When a snoozed item returns (seconds since the epoch), computed
    /// here (C30, I11); none for an acknowledgment.
    pub returns_at: Option<u32>,
}

#[derive(Clone, Debug, PartialEq, Eq, Serialize, TS)]
#[serde(rename_all = "camelCase")]
pub struct OverviewView {
    /// The last overview read for this tenant (kept when a refresh fails).
    pub read: Option<RuntimeOverview>,
    pub refreshing: bool,
    /// The last refresh failed (the shown read, if any, is older).
    pub failure: Option<ManagementFailure>,
    /// When the last refresh failed (seconds since the epoch).
    pub failed_at: Option<u32>,
    /// The read is younger than ten minutes.
    pub fresh: bool,
    /// Attention items not set aside (actionable, above normal).
    pub attention: Vec<InboxItem>,
    pub held: Vec<HeldItem>,
    pub face: AttentionFace,
}

/// The snooze the operator placed last in this session, announced once by
/// the presentation with the return time computed here (C30, I11).
#[derive(Clone, Debug, PartialEq, Eq, Serialize, TS)]
#[serde(rename_all = "camelCase")]
pub struct SnoozeReceipt {
    pub id: String,
    pub title: String,
    pub returns_at: u32,
    /// Counts snoozes placed on this tenant in this session: a change is a
    /// new snooze, however many snapshots repeat it.
    pub sequence: u32,
}

/// The finite outcome of one product's Home read (Red Team, model and
/// skill): which of its sources were established, by name, and the worst
/// failure. A listing counts as established only when its page is the
/// whole inventory (not capped, nothing beyond the first page).
#[derive(Clone, Debug, PartialEq, Eq)]
pub(super) struct ProductOutcome {
    pub(super) read_at: u32,
    pub(super) sources_read: u32,
    pub(super) sources_total: u32,
    /// The sources not established, by name.
    pub(super) missing: Vec<String>,
    pub(super) needs_role: bool,
    pub(super) failure: Option<ManagementFailure>,
    pub(super) detail: String,
}

/// A product read that established nothing (every source failed, or the
/// read never reached the service): kept apart from the last outcome that
/// did establish something, which stays shown as older.
#[derive(Clone, Debug, PartialEq, Eq)]
pub(super) struct FailedAttempt {
    pub(super) at: u32,
    pub(super) needs_role: bool,
    pub(super) failure: Option<ManagementFailure>,
    pub(super) detail: String,
}

/// One tenant's Home reads, kept for the session.
pub(super) struct OverviewRecord {
    pub(super) tenant: TenantId,
    pub(super) read: Option<RuntimeOverview>,
    pub(super) failure: Option<ManagementFailure>,
    pub(super) failed_at: Option<u32>,
    /// Home read parts under way, each with the context it was admitted
    /// under (the overview and each other product). Per-operation
    /// bookkeeping, separate from the cached data: a part admitted under a
    /// context the tenant no longer has is withdrawn when it lands and never
    /// counts, however the tenant was switched meanwhile.
    parts: Vec<ContextRef>,
    pub(super) red_team: Option<ProductOutcome>,
    pub(super) model_skill: Option<ProductOutcome>,
    /// The latest attempt of each, when it established nothing (cleared by
    /// an attempt that did).
    pub(super) red_team_failed: Option<FailedAttempt>,
    pub(super) model_skill_failed: Option<FailedAttempt>,
    /// Completed reads of this tenant in this session.
    pub(super) generation: u32,
    /// The product a `recheckProduct` asked for, until its read lands.
    pub(super) rechecking: Option<ProductId>,
    snoozes: u32,
    pub(super) last_snooze: Option<SnoozeReceipt>,
}

impl OverviewRecord {
    fn new(tenant: TenantId) -> Self {
        Self {
            tenant,
            read: None,
            failure: None,
            failed_at: None,
            parts: Vec::new(),
            red_team: None,
            model_skill: None,
            red_team_failed: None,
            model_skill_failed: None,
            generation: 0,
            rechecking: None,
            snoozes: 0,
            last_snooze: None,
        }
    }

    /// Reading: a part admitted under the tenant's current context is
    /// still under way.
    pub(super) fn refreshing(&self, current: Option<&ContextRef>) -> bool {
        self.parts.iter().any(|c| Some(c) == current)
    }

    /// A product's read settled: an outcome that established at least one
    /// source replaces the retained outcome (and clears any failure); one
    /// that established nothing is kept as the latest failed attempt, the
    /// retained outcome staying shown as older.
    fn settle_product(&mut self, product: ProductId, outcome: ProductOutcome) {
        let (slot, failed) = match product {
            ProductId::RedTeam => (&mut self.red_team, &mut self.red_team_failed),
            ProductId::ModelSkill => (&mut self.model_skill, &mut self.model_skill_failed),
            ProductId::RuntimeSecurity | ProductId::Gateway => return,
        };
        if outcome.sources_read > 0 {
            *slot = Some(outcome);
            *failed = None;
        } else {
            *failed = Some(FailedAttempt {
                at: outcome.read_at,
                needs_role: outcome.needs_role,
                failure: outcome.failure,
                detail: outcome.detail,
            });
        }
    }

    /// One read part landed under `context`. A current part completes the
    /// read when no current part is left (one generation); a withdrawn
    /// (retired-context) part counts nothing, and a recheck it carried is
    /// simply over once nothing current remains.
    fn part_landed(&mut self, context: &ContextRef, current: Option<&ContextRef>) {
        if let Some(at) = self.parts.iter().position(|c| c == context) {
            self.parts.remove(at);
        }
        if self.refreshing(current) {
            return;
        }
        if Some(context) == current {
            self.generation = self.generation.wrapping_add(1);
        }
        self.rechecking = None;
    }
}

fn wall() -> u32 {
    std::time::SystemTime::now()
        .duration_since(std::time::UNIX_EPOCH)
        .map_or(0, |d| u32::try_from(d.as_secs()).unwrap_or(u32::MAX))
}

/// A failure that means the client lacks a role, not that the source is down.
fn needs_role(failure: Option<ManagementFailure>) -> bool {
    matches!(
        failure,
        Some(ManagementFailure::Denied | ManagementFailure::Unauthorized)
    )
}

/// One source of a product's read: its name, whether it was established
/// (answered, and for a listing the whole inventory), and its failure.
type Source = (&'static str, bool, Option<ManagementFailure>);

fn outcome_of(read_at: u32, sources: &[Source], detail: String) -> ProductOutcome {
    let sources_read = sources.iter().filter(|(_, ok, _)| *ok).count() as u32;
    let failure = sources.iter().find_map(|(_, _, f)| *f);
    ProductOutcome {
        read_at,
        sources_read,
        sources_total: sources.len() as u32,
        missing: sources
            .iter()
            .filter(|(_, ok, _)| !*ok)
            .map(|(name, _, _)| (*name).to_owned())
            .collect(),
        needs_role: sources.iter().any(|(_, _, f)| needs_role(*f)),
        failure,
        detail,
    }
}

/// A listing establishes its source only when the page is the inventory:
/// a capped count or rows beyond the page leave it unread coverage.
fn listed(complete: Option<bool>) -> bool {
    complete == Some(true)
}

