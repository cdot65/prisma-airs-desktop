import { useEffect, useRef, useState } from 'react'
import { Eye, Moon, Sun, SunMoon, Undo2 } from 'lucide-react'
import type { SwitchResolution, DesktopClient, FeatureId, Intent, ShellSnapshot, Theme } from '@prisma-airs/desktop-contracts'
import type { Dispatch } from '../features/tenants/dispatch'
import { FeatureBody } from '../shell/feature-body'
import { Inbox } from './inbox/inbox'
import { FEATURE_ICONS } from '../shell/icons'
import { GUARD_COPY, SHELL_COPY, SNOOZE_COPY } from './copy'
import { readLine } from './home'
import { Home } from './home'
import { Palette } from './palette'
import { useShellStore } from './store'
import { TenantSwitcher } from './tenant-switcher'
import { Toasts } from './toasts'
import { Modal, useModalsOpen } from './modal'
import { Wizard } from './wizard/wizard'

export interface V2ShellProps {
    snapshot: ShellSnapshot
    appearancePending: boolean
    status: string
    onNavigate: (id: FeatureId) => void
    onSetAppearance: (theme: Theme) => void
    onSetShowCalls: (on: boolean) => void
    onReturnToClassic: () => void
    onSwitchTenant: (tenant: string, resolution?: SwitchResolution) => void
    onReadNow: () => void
    /** Re-sends a delivery the desktop did not confirm, only on the operator's click. */
    onRetry: (what: string, intent: Intent) => void
    dispatch: Dispatch
    client: DesktopClient
}

const THEMES: { value: Theme; label: string; icon: typeof Sun }[] = [
    { value: 'system', label: SHELL_COPY.appearanceSystem, icon: SunMoon },
    { value: 'light', label: SHELL_COPY.appearanceLight, icon: Sun },
    { value: 'dark', label: SHELL_COPY.appearanceDark, icon: Moon },
]

/**
 * The "Refined Native" shell (C28, DESIGN-V2): a 244px rail with the tenant
 * switcher on top, the Rust navigation inventory (labels and ⌘ hints come
 * from the same catalogue the native menu is built from), appearance and
 * "show the calls" preferences, one status surface and the modal stack.
 * Every destination other than Home renders the same FeatureBody the legacy
 * shell renders, so behaviour is identical whichever shell frames it.
 */
export function V2Shell(props: V2ShellProps) {
    const { snapshot } = props
    const paletteOpen = useShellStore((s) => s.paletteOpen)
    const openPalette = useShellStore((s) => s.openPalette)
    const closePalette = useShellStore((s) => s.closePalette)
    const unconfirmed = useShellStore((s) => s.unconfirmed)
    const clearUnconfirmed = useShellStore((s) => s.clearUnconfirmed)
    const modalOpen = useModalsOpen()
    const heading = useRef<HTMLHeadingElement>(null)
    const firstRender = useRef(true)
    const [adding, setAdding] = useState(false)
    // The sheet closes only when the wizard says so: a committed tenant (toast)
    // or a discard the core admitted. Escape and the scrim are close requests
    // the wizard answers with the same Cancel as its button.
    const [closeRequests, setCloseRequests] = useState(0)
    const closeSheet = (added?: string) => {
        setAdding(false)
        setCloseRequests(0)
        if (added) useShellStore.getState().toast(SHELL_COPY.tenantAdded(added), 'ok')
    }
    const active = snapshot.activeFeature
    const feature = snapshot.features.find((f) => f.id === active) ?? snapshot.features[0]
    // Completion toasts are derived from the core's ReadStatus (I4): a new
    // generation is one finished read; its kind follows the coverage.
    const read = snapshot.inbox.read
    const seenGeneration = useRef(read.generation)
    const seenTenant = useRef(snapshot.active?.tenant ?? null)
    useEffect(() => {
        const tenantNow = snapshot.active?.tenant ?? null
        if (tenantNow !== seenTenant.current) {
            seenTenant.current = tenantNow
            seenGeneration.current = read.generation
            return
        }
        if (read.generation === seenGeneration.current) return
        seenGeneration.current = read.generation
        const tenant = snapshot.tenants.find((t) => t.id === tenantNow)
        const line = readLine(snapshot, tenant?.label ?? null)
        useShellStore.getState().toast(line.text, line.tone === 'allowed' ? 'ok' : 'warn')
    }, [read.generation, snapshot])
    // A snooze's return time is the core's: the toast states it once the
    // snapshot carries it, wherever the snooze was asked for (Home or Inbox).
    const seenReturns = useRef<Map<string, number> | null>(null)
    useEffect(() => {
        const next = new Map<string, number>()
        for (const e of snapshot.inbox.items) {
            if (e.hold?.kind === 'snooze' && e.hold.returnsAt !== null) next.set(e.id, e.hold.returnsAt)
        }
        const previous = seenReturns.current
        seenReturns.current = next
        // The first snapshot of a tenant is a baseline, not a change.
        if (previous === null || (snapshot.active?.tenant ?? null) !== seenTenant.current) return
        for (const e of snapshot.inbox.items) {
            const returnsAt = next.get(e.id)
            if (returnsAt !== undefined && previous.get(e.id) !== returnsAt) useShellStore.getState().toast(SNOOZE_COPY.toast(e.title, returnsAt), 'info')
        }
    }, [snapshot.inbox.items, snapshot.active])
    const guard = snapshot.switchBlocked
    const guardTarget = guard ? snapshot.tenants.find((t) => t.id === guard.to)?.label ?? guard.to : null

    useEffect(() => {
        // Move focus to the new page heading after navigation (not on launch).
        if (firstRender.current) {
