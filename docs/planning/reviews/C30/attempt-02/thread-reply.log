    })
    .await;
    let a = desk.json()["active"]["tenant"]
        .as_str()
        .expect("A")
        .to_owned();
    let origin = desk.json()["tenants"][0]["origin"]
        .as_str()
        .expect("origin")
        .to_owned();
    desk.send(
        json!({"kind": "createTenant", "profile": {"label": "Tenant B", "tsgId": "1234567890",
        "destination": {"kind": "custom", "origin": origin}}}),
    )
    .await
    .expect("B");
    let b = desk.json()["tenants"]
        .as_array()
        .expect("tenants")
        .iter()
        .find(|t| t["label"] == "Tenant B")
        .and_then(|t| t["id"].as_str())
        .expect("B id")
        .to_owned();
    desk.send(json!({"kind": "selectTenant", "tenant": b, "resolution": "discard"}))
        .await
        .expect("switched");
    desk.send(json!({"kind": "selectTenant", "tenant": a}))
        .await
        .expect("back to A");
    assert!(
        settle_for(30, || desk.conversation().is_null()).await,
        "dropped once its task returned (its cut-short save refused)"
    );
    let ids = history_ids(&mut desk).await;
    assert!(
        !ids.contains(&history),
        "the discarded conversation is gone from the saved history: {ids:?}"
    );
    assert!(
        !files_under(&desk.history_root)
            .iter()
            .any(|f| f.to_string_lossy().contains(&history)),
        "and its record file was removed"
    );
    // The same with Archive: the conversation stays readable. (The dropped
    // conversation's engine may still be reaped: a start waits for it.)
    let reference = desk.choose(WS_A).await;
    desk.store_key(&reference, KEY, None).await;
    let id = start_when_free(&mut desk, &reference).await;
    assert!(settle_for(30, || desk.conversation()["phase"] == "ready").await);
    // (The synthetic model still proposes the command.) The turn the stop
    // cuts short is saved as it stood: that is what Archive keeps.
    desk.say(&id, "List the files.").await.expect("sent");
    answered_with(&mut desk, |c| {
        c["approvals"].as_array().is_some_and(|a| !a.is_empty())
    })
    .await;
    let kept = desk.conversation()["historyId"]
        .as_str()
        .expect("history id")
        .to_owned();
    desk.send(json!({"kind": "selectTenant", "tenant": b, "resolution": "archive"}))
        .await
        .expect("switched");
    desk.send(json!({"kind": "selectTenant", "tenant": a}))
        .await
        .expect("back to A");
    assert!(
        settle_for(30, || {
            let c = desk.conversation();
            c.is_null() || c["phase"] == "ended"
        })
        .await
    );
    // Its cut-short save lands after the stop: listed once it has.
    let mut ids = history_ids(&mut desk).await;
    for _ in 0..60 {
        if ids.contains(&kept) {
            break;
        }
        tokio::time::sleep(Duration::from_millis(500)).await;
        ids = history_ids(&mut desk).await;
    }
    assert!(ids.contains(&kept), "archived, it is listed: {ids:?}");
    assert!(!ids.contains(&history), "the discarded one stays gone");
    std::fs::remove_dir_all(&dir).expect("cleanup");
}

/// C30 (I1): completing an Add-a-tenant draft makes the new tenant active,
/// so it is the same guarded switch: a pending Harness decision refuses it
/// with the guard naming the draft, nothing is committed or retired until
/// the operator resolves the conversation, and the resolution completes it.
#[tokio::test(flavor = "multi_thread", worker_threads = 4)]
async fn completing_a_tenant_setup_is_the_guarded_switch_path() {
    let mut desk = desk().await;
    let dir = project();
    choose_project(&mut desk, &dir).await;
    let id = ready(&mut desk).await;
    tool(&desk, None, "exec_command", json!({"cmd": "ls"}));
    desk.say(&id, "List the files.").await.expect("sent");
    let c = answered_with(&mut desk, |c| {
        c["approvals"].as_array().is_some_and(|a| !a.is_empty())
    })
    .await;
    let token = c["approvals"][0]["id"].as_str().expect("id").to_owned();
    let a = desk.json()["active"]["tenant"]
        .as_str()
        .expect("A")
        .to_owned();
    let origin = desk.json()["tenants"][0]["origin"]
        .as_str()
        .expect("origin")
        .to_owned();
    desk.send(json!({"kind": "beginTenantSetup", "mode": "add", "profile": {"label": "Tenant C", "tsgId": "1234567890",
        "destination": {"kind": "custom", "origin": origin}}}))
        .await
        .expect("draft");
    let setup = desk.json()["setup"].clone();
    let draft = setup["context"].as_str().expect("draft context").to_owned();
    let draft_id = setup["tenant"]["id"].as_str().expect("draft id").to_owned();
    desk.send(json!({"kind": "verifyTenantSetup", "context": draft}))
        .await
        .expect("verify");
    assert!(settle(|| desk.json()["setup"]["verify"]["done"] == true).await);
    assert_eq!(
        desk.send(json!({"kind": "completeTenantSetup", "context": draft, "packs": []}))
            .await,
        Err(desktop_core::Refusal::DecisionPending)
    );
    let s = desk.json();
    assert_eq!(s["active"]["tenant"], a, "still on A");
    assert_eq!(
        s["switchBlocked"]["to"], draft_id,
        "the guard names the draft"
    );
    assert_eq!(s["switchBlocked"]["completion"], true);
    assert_eq!(s["switchBlocked"]["pending"]["conversation"], id);
    assert_eq!(s["switchBlocked"]["pending"]["decision"], token);
    assert_eq!(s["setup"]["context"], draft, "the draft is untouched");
    assert!(
        s["harness"]["conversation"]["approvals"]
            .as_array()
            .is_some_and(|x| !x.is_empty()),
        "nothing was decided for the operator"
    );
    assert!(
        s["tenants"]
            .as_array()
            .expect("tenants")
            .iter()
            .all(|t| t["label"] != "Tenant C"),
        "nothing was committed"
    );
    // Stay: the guard closes; the draft, the tenant and the decision remain.
    desk.send(json!({"kind": "dismissSwitchGuard"}))
        .await
        .expect("dismissed");
    let s = desk.json();
    assert!(s["switchBlocked"].is_null());
    assert_eq!(s["setup"]["context"], draft);
    assert_eq!(s["active"]["tenant"], a);
    // Archive and complete: the conversation ends (kept), the tenant is
    // committed and active, the draft is gone.
    desk.send(json!({"kind": "completeTenantSetup", "context": draft, "packs": [], "resolution": "archive"}))
        .await
        .expect("completed");
    let s = desk.json();
    assert!(s["setup"].is_null());
    assert!(s["switchBlocked"].is_null());
    let c_id = s["tenants"]
        .as_array()
        .expect("tenants")
        .iter()
        .find(|t| t["label"] == "Tenant C")
        .and_then(|t| t["id"].as_str())
        .expect("committed")
        .to_owned();
    assert_eq!(s["active"]["tenant"], c_id);
    assert!(
        s["harness"]["conversation"].is_null(),
        "another tenant's conversation is never shown"
    );
    desk.send(json!({"kind": "selectTenant", "tenant": a}))
        .await
import { useCallback, useEffect, useLayoutEffect, useRef, useState } from 'react'
import {
    DeliveryOutcomeUnknown,
    type DesktopClient,
    type FeatureId,
    type Intent,
    type MenuCommand,
    type Refusal,
    type ShellSnapshot,
    type Theme,
} from '@prisma-airs/desktop-contracts'
import { followAppearance } from './shell/appearance'
import { type DispatchOutcome, outcomeMessage } from './features/tenants/dispatch'
import { DesktopShell } from './shell/desktop-shell'
import { V2Shell } from './v2/v2-shell'
import { Wizard } from './v2/wizard/wizard'
import { ImportView } from './features/import-v1/import-view'
import { useShellStore } from './v2/store'
import { SHELL_COPY } from './v2/copy'
import { forgetAcademyPresentation } from './features/academy/presentation-storage'
import { SAVE_DOCUMENT_EVENT } from './features/workbench/document-editor'

export function App({ client }: { client: DesktopClient }) {
    const [snapshot, setSnapshot] = useState<ShellSnapshot | null>(null)
    const [failure, setFailure] = useState<string | null>(null)
    const [active, setActive] = useState<FeatureId | null>(null)
    const [paletteOpen, setPaletteOpen] = useState(false)
    const [pending, setPending] = useState(false)
    const [status, setStatus] = useState('')

    const setAppearance = useCallback(
        async (theme: Theme) => {
            setPending(true)
            setStatus('')
            try {
                const response = await client.dispatch({ kind: 'setAppearance', theme })
                if (response.outcome === 'refusal') {
                    setStatus(`The desktop refused the appearance change (${response.refusal}).`)
                }
            } catch (error) {
                setStatus(
                    error instanceof DeliveryOutcomeUnknown
                        ? 'The desktop did not confirm the appearance change. The current setting is shown.'
                        : 'The appearance change could not be delivered.'
                )
            } finally {
                setPending(false)
            }
        },
        [client]
    )

    const dispatch = useCallback(
        async (intent: Intent): Promise<DispatchOutcome> => {
            try {
                const response = await client.dispatch(intent)
                return response.outcome === 'refusal'
                    ? { kind: 'refused', refusal: response.refusal }
                    : { kind: 'admitted', operation: response.receipt.operation }
            } catch (error) {
                return error instanceof DeliveryOutcomeUnknown ? { kind: 'unknown' } : { kind: 'failed' }
            }
        },
        [client]
    )

    // v2 (C28): navigation is Rust-owned. The native menu, the sidebar and
    // the palette all dispatch `navigate`; refusals reach the status surface.
    const v2 = snapshot?.uiVariant === 'v2'
    const v2Navigate = useCallback(
        async (feature: FeatureId) => {
            useShellStore.getState().closePalette()
            const intent: Intent = { kind: 'navigate', feature }
            const outcome = await dispatch(intent)
            if (outcome.kind === 'refused') useShellStore.getState().toast(SHELL_COPY.toastRefused('Navigation', outcome.refusal), 'warn')
            // Unknown delivery is kept inline with Retry; never an expiring toast alone.
            else if (outcome.kind === 'unknown') useShellStore.getState().addUnconfirmed('Navigation', intent)
            else if (outcome.kind === 'failed') useShellStore.getState().toast(SHELL_COPY.toastFailed('Navigation'), 'warn')
        },
        [dispatch]
    )
    // Every v2 action's outcome reaches the shell's surfaces (DESIGN-V2 §7):
    // a refusal or failed delivery as a warn toast naming what was asked, an
    // unconfirmed delivery inline with Retry, never replayed on its own.
    const v2Act = useCallback(
        async (what: string, intent: Intent, quiet: Refusal[] = []): Promise<DispatchOutcome> => {
            const outcome = await dispatch(intent)
            if (outcome.kind === 'refused' && quiet.includes(outcome.refusal)) return outcome
            if (outcome.kind === 'refused') useShellStore.getState().toast(SHELL_COPY.toastRefused(what, outcome.refusal, outcomeMessage(outcome)), 'warn')
            else if (outcome.kind === 'unknown') useShellStore.getState().addUnconfirmed(what, intent)
            else if (outcome.kind === 'failed') useShellStore.getState().toast(SHELL_COPY.toastFailed(what), 'warn')
            return outcome
        },
        [dispatch]
    )
    const v2Preference = useCallback(
        async (what: string, intent: Intent, quiet: Refusal[] = []) => {
            await v2Act(what, intent, quiet)
        },
        [v2Act]
    )

    const onMenu = useRef<(command: MenuCommand) => void>(() => undefined)
    onMenu.current = (command: MenuCommand) => {
        if (command.kind === 'navigate') {
            // Native navigation dismisses the modal palette first so focus can
            // move to the new page heading instead of behind an open dialog.
            if (v2) void v2Navigate(command.feature)
            else {
                setPaletteOpen(false)
                setActive(command.feature)
            }
        }
        else if (command.kind === 'commandPalette') {
            if (v2) useShellStore.getState().openPalette()
            else setPaletteOpen(true)
        }
        // ⌘T: the tenant switcher opens; nothing switches until chosen.
        else if (command.kind === 'tenantSwitcher') {
            if (v2) useShellStore.getState().setSwitcher(true)
            else {
                setPaletteOpen(false)
                setActive('settings')
            }
        }
        // The open API Client request saves (its editor listens).
        else if (command.kind === 'saveDocument') window.dispatchEvent(new Event(SAVE_DOCUMENT_EVENT))
        else if (v2) void v2Preference('The appearance change', { kind: 'setAppearance', theme: command.theme })
        else void setAppearance(command.theme)
    }

    useEffect(() => {
        let stop: (() => void) | undefined
        let cancelled = false
        client
            .observeShell({
                onSnapshot: (next) => setSnapshot(next),
                onMenu: (command) => onMenu.current(command),
                onError: () => setFailure('The desktop sent an unexpected update.'),
            })
            .then(
                (unsubscribe) => {
                    if (cancelled) unsubscribe()
                    else stop = unsubscribe
                },
                () => setFailure('The desktop shell could not be observed.')
            )
        return () => {
            cancelled = true
            stop?.()
        }
    }, [client])

    // A completed reset also forgets Academy's WebView presentation state
    // (completion latches keyed by account); a stopped reset keeps it.
    const storage = snapshot?.storage
    const resetFailed = Boolean(snapshot?.resetFailure)
    const previousStorage = useRef(storage)
    useEffect(() => {
        if (previousStorage.current === 'resetting' && storage !== 'resetting' && !resetFailed) {
            forgetAcademyPresentation()
        }
        previousStorage.current = storage
    }, [storage, resetFailed])

    const appearance = snapshot?.appearance
    // Apply the theme in the same commit as the snapshot, before paint, so
    // the shell never shows a frame in the previous theme.
    useLayoutEffect(() => (appearance ? followAppearance(appearance) : undefined), [appearance])

    if (failure && !snapshot) {
        return (
            <main role='alert' className='text-academy-ink p-8'>
                {failure}
            </main>
        )
    }
    if (!snapshot) {
        return (
            <main role='status' aria-live='polite' className='text-academy-ink-soft p-8'>
            current
        });
    }

    /// Admits one management read for the active tenant's management
    /// capability. The scan key is never consulted.
    /// The active tenant's management binding inputs, checked: a ready
    /// management credential, its client ID and TSG, and the configured
    /// token origin equal to the one the credential was stored for. The scan
    /// key is never consulted.
    pub(super) fn binding_source(
        &mut self,
        context: &ContextRef,
        keychain: Arc<dyn super::CredentialStore>,
        session_vault: Arc<SessionVault>,
    ) -> Result<BindingSource, Refusal> {
        let tenant = self.check_context(context)?;
        let current = self.tenant(&tenant).ok_or(Refusal::StaleContext)?;
        let (record, mode, destination) = match &current.management {
            ScanCapability::Ready {
                record,
                mode,
                destination,
            } => (record.clone(), *mode, destination.clone()),
            _ => return Err(Refusal::CapabilityMissing),
        };
        let client_id = current
            .management_client
            .clone()
            .ok_or(Refusal::CapabilityMissing)?;
        let tsg = current
            .profile
            .tsg_id
            .clone()
            .ok_or(Refusal::CapabilityMissing)?;
        // The credential is bound to the token origin it was stored for; a
        // different configured token origin never receives it.
        let endpoints = self.management_endpoints.clone();
        if endpoints.token_origin().as_deref() != Some(destination.as_str()) {
            return Err(Refusal::CapabilityMissing);
        }
        let transport = self
            .transport
            .clone()
            .ok_or(Refusal::CapabilityMissing)?
            .for_admission()
            .map_err(|_| Refusal::CapabilityMissing)?;
        // Only a Keychain-stored credential's investigation is sealed on
        // disk (its key in the same namespace); a session credential's stays
        // in memory with its generation.
        let root = self.sessions_root.clone();
        let sealing: Arc<dyn crate::vault::Vault> = keychain.clone();
        let credential = record.clone();
        let (session, binding, investigation) = self.management_binding(context, || {
            (mode == StorageMode::Keychain)
                .then_some(root)
                .flatten()
                .map(|root| Persistence {
                    root,
                    credential,
                    keychain: sealing,
                })
        });
        Ok(BindingSource {
            keychain,
            session_vault,
            record,
            mode,
            client_id,
            tsg,
            endpoints,
            transport,
            session,
            binding,
            investigation,
        })
    }

    /// Admits one management read for the active tenant's management
    /// capability.
    pub(super) fn admit_management(
        &mut self,
        context: ContextRef,
        request: ManagementRequest,
        keychain: Arc<dyn super::CredentialStore>,
        session_vault: Arc<SessionVault>,
    ) -> Result<(OperationId, Vec<crate::runtime::Start>), Refusal> {
        self.check_context(&context)?;
        if !request.is_valid() {
            return Err(Refusal::InvalidInput);
        }
        let gateway = self.gateway_admission(&context, &request)?;
        let source = self.binding_source(&context, keychain, session_vault)?;
        let overview = request == ManagementRequest::Overview;
        let lists_workspaces = super::gateway_domain::lists_workspaces(&request);
        let (domain, workspace, scope) = match gateway {
            Some(g) => (g.domain, g.workspace, g.scope),
            // An overview also reads the chosen Gateway workspace's
            // activity (C18); it is labelled with that workspace.
            None if overview => (
                context.as_str().to_owned(),
                None,
                self.chosen_scope(&context),
            ),
            None => (context.as_str().to_owned(), None, None),
        };
        let slot: ResultSlot = Arc::default();
        let job = ManagementJob {
            source,
            request,
            slot: Arc::clone(&slot),
            workspace: scope,
        };
        let (operation, starts) =
            self.operations
                .admit(&domain, 0, job.into_work(), Instant::now())?;
        self.management_calls.push(ManagementRecord {
            operation: operation.clone(),
            context,
            slot,
            cell: Arc::default(),
            settled: false,
            observed: false,
            overview,
            workspace,
            lists_workspaces,
            read_part: None,
        });
        if overview {
            let context = self.management_calls.last().map(|r| r.context.clone());
            if let Some(context) = context {
                self.overview_started(&context);
            }
        }
        Ok((operation, starts))
    }

    /// Admits one product's part of the tenant's Home read (C30, I4): the
    /// Red Team scans and statistics over the last week, or the model and
    /// skill scans. The result is observed by the read record, never by a
    /// presentation observation.
