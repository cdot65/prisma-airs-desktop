import { create } from 'zustand'

export type ToastKind = 'ok' | 'info' | 'warn'
import type { FeatureId, Intent, ManagementResource } from '@prisma-airs/desktop-contracts'

/** What a contextual action asked the destination to select on arrival (C30). */
export interface Arrival {
    feature: FeatureId
    resource: ManagementResource | null
    /** The item to filter to, by name. */
    item: string | null
    /** Counts arrivals: a destination already open applies a new one. */
    sequence: number
}

/** A delivery the desktop did not confirm: kept until the operator retries or dismisses it (DESIGN-V2 §7). */
export interface Unconfirmed {
    id: number
    what: string
    intent: Intent
}

export interface Toast {
    id: number
    kind: ToastKind
    text: string
    /** An optional undo the toast offers (label + action). */
    undo?: { label: string; run: () => void }
}

/**
 * Transient shell presentation state (state-ownership.md "UI"): what is open,
 * the palette query, toasts and the modal stack. Nothing here survives a
 * reload and nothing here is authority: every durable fact is observed from
 * the Rust snapshot.
 */
interface ShellStore {
    paletteOpen: boolean
    switcherOpen: boolean
    toasts: Toast[]
    /** Open modal ids, bottom to top; only the last is interactive (I8). */
    modals: string[]
    /** The Inbox tab and item per tenant (I2: a switch round trip keeps it). */
    inboxSelection: Record<string, { tab: 'all' | 'action' | 'updates' | 'snoozed'; item: string | null }>
    selectInbox(tenant: string, selection: { tab: 'all' | 'action' | 'updates' | 'snoozed'; item: string | null }): void
    /** The last contextual action's target, consumed by the destination it names. */
    arrival: Arrival | null
    arrive(target: Omit<Arrival, 'sequence'>): void
    unconfirmed: Unconfirmed[]
    /** Toast lifetime in ms (6 s; tests shorten it). */
    toastMs: number
    addUnconfirmed(what: string, intent: Intent): number
    clearUnconfirmed(id: number): void
    openPalette(): void
    closePalette(): void
    setSwitcher(open: boolean): void
    toast(text: string, kind?: ToastKind, undo?: Toast['undo']): number
    dismissToast(id: number): void
    pushModal(id: string): void
    popModal(id: string): void
}

let nextToast = 1

export const useShellStore = create<ShellStore>((set) => ({
    paletteOpen: false,
    switcherOpen: false,
    toasts: [],
    modals: [],
    inboxSelection: {},
    selectInbox: (tenant, selection) => set((s) => ({ inboxSelection: { ...s.inboxSelection, [tenant]: selection } })),
    arrival: null,
    arrive: (target) => set((s) => ({ arrival: { ...target, sequence: (s.arrival?.sequence ?? 0) + 1 } })),
    unconfirmed: [],
    toastMs: 6000,
    addUnconfirmed: (what, intent) => {
        const id = nextToast++
        set((s) => ({ unconfirmed: [...s.unconfirmed, { id, what, intent }] }))
        return id
    },
    clearUnconfirmed: (id) => set((s) => ({ unconfirmed: s.unconfirmed.filter((u) => u.id !== id) })),
    openPalette: () => set({ paletteOpen: true, switcherOpen: false }),
    closePalette: () => set({ paletteOpen: false }),
    setSwitcher: (open) => set({ switcherOpen: open, ...(open ? { paletteOpen: false } : {}) }),
    toast: (text, kind = 'ok', undo) => {
        const id = nextToast++
        // One toast at a time: the newest replaces the rest (I10).
        set({ toasts: [{ id, kind, text, undo }] })
        return id
    },
    dismissToast: (id) => set((s) => ({ toasts: s.toasts.filter((t) => t.id !== id) })),
    pushModal: (id) => set((s) => ({ modals: s.modals.includes(id) ? s.modals : [...s.modals, id] })),
    popModal: (id) => set((s) => ({ modals: s.modals.filter((m) => m !== id) })),
}))

/** Test seam: forget everything (each test starts from an empty store). */
export function resetShellStore() {
    useShellStore.setState({ paletteOpen: false, switcherOpen: false, toasts: [], modals: [], unconfirmed: [], toastMs: 6000, inboxSelection: {}, arrival: null })
}
import type { SwitchResolution } from '@prisma-airs/desktop-contracts'
import { GUARD_COPY } from './copy'
import { Modal } from './modal'

export interface SwitchGuardProps {
    /** The tenant the switch (or the setup completion) leads to. */
    target: string
    /** The switch is a setup draft's completion (the body says so). */
    completion: boolean
    onStay: () => void
    onResolve: (resolution: SwitchResolution) => void
}

/**
 * The one tenant-switch guard (I1): rendered from the core's `switchBlocked`
 * whether the switch was asked for through the switcher, the palette, the
 * native menu or the completion of a setup draft. Stay dismisses the guard;
 * Archive and Discard re-send the same intent with the chosen resolution.
 */
export function SwitchGuard({ target, completion, onStay, onResolve }: SwitchGuardProps) {
    return (
        <Modal label={GUARD_COPY.title} onClose={onStay} width={520} data-slot='switch-guard'>
            <h2 className='text-[16px] font-semibold'>{GUARD_COPY.title}</h2>
            <p className='mt-2 text-[13px]' style={{ color: 'var(--v2-soft)' }}>
                {completion ? GUARD_COPY.bodyCompletion(target) : GUARD_COPY.body(target)}
            </p>
            <div className='mt-4 flex flex-wrap justify-end gap-2'>
                <button type='button' onClick={onStay} className='h-8 rounded-[7px] border px-3 text-[13px]' style={{ borderColor: 'var(--v2-rule)' }}>
                    {GUARD_COPY.stay}
                </button>
                <button type='button' onClick={() => onResolve('discard')} className='h-8 rounded-[7px] border px-3 text-[13px]' style={{ borderColor: 'var(--v2-rule)' }}>
                    {GUARD_COPY.discard}
                </button>
                <button type='button' autoFocus onClick={() => onResolve('archive')} className='h-8 rounded-[7px] px-3 text-[13px] font-semibold' style={{ background: 'var(--v2-acc)', color: 'var(--v2-acc-ink)' }}>
                    {GUARD_COPY.archive}
                </button>
            </div>
        </Modal>
    )
}

