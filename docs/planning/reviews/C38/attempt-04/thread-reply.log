    const on = servers.filter((s) => s.enabled).length
    const signingIn = servers.some((s) => s.step !== null)
    return (
        <section aria-labelledby={`${ids}-heading`} className='flex flex-col gap-2 rounded-[12px] border p-3' style={{ borderColor: 'var(--v2-rule)' }} data-slot='harness-mcp'>
            <h2 id={`${ids}-heading`} className='text-[13px] font-bold'>
                Workspace MCP servers
            </h2>
            <p className='text-[12px]' style={faint}>
                Servers published in this workspace’s AI Gateway. The Harness asks you before every tool call, and each server’s sign-in stays with this app.
            </p>
            {!here || mcp.state === 'loading' ? (
                <p role='status' className='text-[13px]'>
                    Reading the workspace’s MCP servers…
                </p>
            ) : null}
            {here && mcp.failure ? (
                <p role='alert' className='text-[13px]' style={{ color: 'var(--v2-flag)' }}>
                    {`The MCP servers could not be read: ${MANAGEMENT_FAILURE_TEXT[mcp.failure]}`}
                </p>
            ) : null}
            {here && mcp.state !== 'loading' && servers.length === 0 && !mcp.failure ? <p className='text-[13px]'>No MCP servers are published in this workspace.</p> : null}
            {here && !mcp.complete && servers.length > 0 ? (
                <p className='text-[12px]' style={faint}>
                    Only the first 500 servers are shown.
                </p>
            ) : null}
            {servers.length > 0 ? (
                <ul role='list' aria-label='MCP servers' className='flex flex-col gap-2'>
                    {servers.map((s) => {
                        const holdsSignIn = s.signedIn || s.stale || s.expired !== null
                        return (
                            <li key={s.id} className='rounded-[8px] border p-2' style={{ borderColor: 'var(--v2-rule)' }} data-slot='harness-mcp-server'>
                                <label className='flex items-start gap-2 text-[13px] font-semibold'>
                                    <input
                                        type='checkbox'
                                        className='mt-[3px] size-4 min-h-0'
                                        checked={s.enabled}
                                        disabled={busy || !s.supported || (!s.enabled && on >= MCP_MAX_ON)}
                                        aria-describedby={`${ids}-${s.id}-standing`}
                                        onChange={(event) =>
                                            void send(
                                                { kind: 'enableMcpServer', context, workspace, server: s.id, enabled: event.target.checked },
                                                event.target.checked ? `turning ${s.name} on` : `turning ${s.name} off`,
                                                event.target.checked ? ENABLE_REFUSED : undefined
                                            )
                                        }
                                    />
                                    {`Use ${s.name} in new conversations`}
                                </label>
                                <p className='font-mono text-[11px] break-all'>{`${s.namespace} · ${s.url}`}</p>
                                <p id={`${ids}-${s.id}-standing`} className='text-[12px]'>
                                    {standing(s)}
                                </p>
                                {s.step ? (
                                    <p role='status' className='text-[12px]'>
                                        {MCP_STEP_TEXT[s.step]}
                                    </p>
                                ) : null}
                                {s.failure ? (
                                    <p role='alert' className='text-[12px]' style={{ color: 'var(--v2-flag)' }}>
                                        {MCP_SIGN_IN_FAILURE_TEXT[s.failure]}
                                    </p>
                                ) : null}
                                <div className='mt-1 flex flex-wrap gap-2'>
                                    {s.step ? (
                                        <Btn tier='tertiary' onClick={() => void send({ kind: 'cancelMcpSignIn', context }, 'cancelling the sign-in')}>
                                            Cancel sign-in
                                        </Btn>
                                    ) : (
                                        <Btn
                                            disabled={busy || !s.supported || signingIn}
                                            onClick={() => void send({ kind: 'signInMcpServer', context, workspace, server: s.id }, `starting the sign-in to ${s.name}`, SIGN_IN_REFUSED)}
                                        >
                                            {holdsSignIn ? `Sign in to ${s.name} again` : `Sign in to ${s.name}`}
                                        </Btn>
                                    )}
                                    {holdsSignIn ? (
                                        <Btn tier='tertiary' disabled={busy} onClick={() => void send({ kind: 'signOutMcpServer', context, workspace, server: s.id }, `signing out of ${s.name}`)}>
                                            {`Sign out of ${s.name}`}
                                        </Btn>
                                    ) : null}
                                </div>
                            </li>
                        )
                    })}
                </ul>
            ) : null}
            {running ? (
                <p className='text-[12px]' style={faint}>
                    Turning a server off, signing in again or signing out ends the running conversation that uses it.
                </p>
            ) : null}
            <Btn tier='tertiary' className='self-start' disabled={here && mcp.state === 'loading'} onClick={() => void send({ kind: 'listMcpServers', context, workspace }, 'reading the servers')}>
                Read the servers again
            </Btn>
        </section>
    )
}
import { useId, useState } from 'react'
import type { ContextRef, HarnessProjectView } from '@prisma-airs/desktop-contracts'
import type { Dispatch } from '../../../features/tenants/dispatch'
import { actionOutcomeText } from '../text'
import { Btn } from './controls'

interface Props {
    context: ContextRef
    project: HarnessProjectView | null
    /** A folder just refused as the project. */
    refused: string | null
    /** A conversation is running (changing the project or access ends it). */
    running: boolean
    dispatch: Dispatch
    onMessage: (message: string | null) => void
}

const REFUSED = 'Folders that hold system files, credentials or this app’s own data cannot be used.'
const CHECK = 'Check the folder and the permission shown here before trying again.'

/**
 * The folder the Harness works in (C21, D048), as a v2 panel (C38): chosen
 * in the native folder sheet, read-only unless the operator allows changes.
 * Every command and file change still waits for the operator's approval,
 * and the engine's sandbox keeps both inside the folder.
 */
export function ProjectPanel({ context, project, refused, running, dispatch, onMessage }: Props) {
    const ids = useId()
    const [busy, setBusy] = useState(false)

    // An unknown delivery stays Not confirmed naming the action (the change may have applied; the folder and
    // its permission shown here are the state to reconcile with); a refusal says its own reason.
    async function send(intent: Parameters<Dispatch>[0], action: string) {
        onMessage(null)
        setBusy(true)
        try {
            onMessage(actionOutcomeText(await dispatch(intent), action, CHECK))
        } finally {
            setBusy(false)
        }
    }

    return (
        <section aria-labelledby={`${ids}-heading`} className='flex flex-col gap-2 rounded-[12px] border p-3' style={{ borderColor: 'var(--v2-rule)' }} data-slot='harness-project'>
            <h2 id={`${ids}-heading`} className='text-[13px] font-bold'>
                Project folder
            </h2>
            {project ? (
                <>
                    <p className='font-mono text-[12px] break-all' data-slot='harness-project-path'>
                        {project.path}
                    </p>
                    <label className='flex items-start gap-2 text-[13px]'>
                        <input
                            type='checkbox'
                            className='mt-[3px] size-4 min-h-0'
                            checked={project.write}
                            disabled={busy}
                            aria-describedby={`${ids}-write`}
                            onChange={(event) =>
                                void send({ kind: 'setHarnessWrite', context, write: event.target.checked }, event.target.checked ? 'allowing changes in this folder' : 'making this folder read-only')
                            }
                        />
                        Allow changes in this folder
                    </label>
                    <p id={`${ids}-write`} className='text-[12px]' style={{ color: 'var(--v2-faint)' }}>
                        {project.write
                            ? 'The Harness may ask to run commands and change files here. Each waits for your approval and stays inside this folder.'
                            : 'Read-only: the Harness may ask to run commands here, each with your approval, but cannot change anything.'}
                    </p>
                </>
            ) : (
                <p className='text-[13px]' style={{ color: 'var(--v2-faint)' }}>
                    No folder. The Harness can use this app’s own read tools and propose changes for your review, but cannot run commands.
                </p>
            )}
            {refused ? (
                <p role='alert' className='text-[13px] break-all' style={{ color: 'var(--v2-flag)' }} data-slot='harness-project-refused'>
                    {`${refused} cannot be used. ${REFUSED}`}
                </p>
            ) : null}
            {running ? (
                <p className='text-[12px]' style={{ color: 'var(--v2-faint)' }}>
                    Changing the folder or its access ends the running conversation.
                </p>
            ) : null}
            <div className='flex flex-wrap gap-2'>
                <Btn disabled={busy} onClick={() => void send({ kind: 'chooseHarnessProject', context }, 'choosing a folder')}>
                    {project ? 'Choose another folder…' : 'Choose a folder…'}
                </Btn>
                {project ? (
                    <Btn tier='tertiary' disabled={busy} onClick={() => void send({ kind: 'clearHarnessProject', context }, 'removing the folder')}>
                        Remove folder
                    </Btn>
                ) : null}
            </div>
        </section>
    )
}
import type { ButtonHTMLAttributes, InputHTMLAttributes } from 'react'

/** The prototype's 32px controls (R2App): a primary accent button, a bordered secondary, a plain tertiary. */
export function Btn({ tier = 'secondary', className = '', style, ...rest }: ButtonHTMLAttributes<HTMLButtonElement> & { tier?: 'primary' | 'secondary' | 'tertiary' }) {
    const look =
        tier === 'primary'
            ? { background: 'var(--v2-acc)', color: 'var(--v2-acc-ink)', border: 0 }
            : tier === 'secondary'
              ? { background: 'var(--v2-paper)', color: 'var(--v2-ink)', border: '1px solid var(--v2-rule)' }
              : { background: 'transparent', color: 'var(--v2-soft)', border: '1px solid var(--v2-rule)' }
    return (
        <button
            type='button'
            {...rest}
            className={`flex h-8 min-h-0 items-center justify-center rounded-[7px] px-3 text-[12px] whitespace-nowrap disabled:cursor-not-allowed disabled:opacity-60 ${tier === 'primary' ? 'font-semibold' : ''} ${className}`}
            style={{ ...look, ...style }}
        />
    )
}

/** A 32px text field with the prototype's control border. */
export function Field({ className = '', style, ...rest }: InputHTMLAttributes<HTMLInputElement>) {
    return (
        <input
            {...rest}
            className={`h-8 min-h-0 rounded-[7px] border px-2.5 text-[13px] ${className}`}
            style={{ borderColor: 'var(--v2-ctl)', background: 'var(--v2-paper)', color: 'var(--v2-ink)', ...style }}
        />
    )
}

