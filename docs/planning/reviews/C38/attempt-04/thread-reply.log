/* The v2 shell root: body background, type and the visible focus ring
 * (invariant: accent-colour ring on every focusable control; inset variant
 * where a control declares it). */
[data-v2-shell] {
    background: var(--v2-bg);
    color: var(--v2-ink);
    font-size: var(--v2-text);
    font-family: -apple-system, BlinkMacSystemFont, 'SF Pro Text', system-ui, sans-serif;
    min-height: 100vh;
}
/* The destination heading takes focus after navigation for assistive technology; it is not a control, so no ring (C35). */
[data-v2-shell] h1[tabindex='-1']:focus {
    outline: none;
}
/* A page inside the shell's main region: the prototype's 32/44 margins, scrolling by itself. */
[data-v2-shell] [data-v2-page] {
    padding: var(--v2-page-top) var(--v2-page-x) 28px;
    overflow-y: auto;
    min-height: 0;
    flex-grow: 1;
    min-width: 0;
}
[data-v2-shell] :focus-visible {
    outline: 2px solid var(--v2-acc);
    outline-offset: 2px;
}
[data-v2-shell] [data-inset-focus]:focus-visible {
    outline-offset: -4px;
}
[data-v2-shell] input,
[data-v2-shell] select,
[data-v2-shell] textarea {
    border: 1px solid var(--v2-ctl);
    border-radius: var(--v2-radius-control);
    background: var(--v2-bg);
    color: var(--v2-ink);
    min-height: var(--v2-control);
}
/* Rail collapses to icons below 1280 CSS px; nothing scrolls horizontally. */
[data-v2-shell] {
    overflow-x: hidden;
}
@media (max-width: 1279px) {
    [data-v2-rail] {
        width: 64px !important;
    }
    /* Collapsed: one 32px control per row; icons stay, labels leave the
     * layout but stay in the accessible name. */
    [data-v2-rail] [data-v2-stack] {
        flex-direction: column;
        align-items: stretch;
    }
    [data-v2-rail] [data-v2-stack] > * {
        width: 100%;
    }
    /* Collapsed: labels leave the layout but stay in the accessible name (rail and header). */
    [data-v2-rail] [data-v2-label],
    [data-v2-header] [data-v2-label] {
        position: absolute;
        width: 1px;
        height: 1px;
        overflow: hidden;
        clip: rect(0 0 0 0);
        white-space: nowrap;
    }
    /* Collapsed: the product children and the status rows leave the rail (C35). */
    [data-v2-rail] [data-v2-collapse] {
        display: none !important;
    }
    [data-v2-rail] [data-v2-stack] > * {
        padding-left: 0 !important;
        padding-right: 0 !important;
    }
    [data-v2-header] [data-v2-search] {
        width: auto !important;
        flex: 1 1 120px !important;
        min-width: 0;
    }
    /* The Harness's rail and Decisions aside stack above and below the transcript when the page is narrow (C38).
