import type {
    ContextRef,
    ManagementFailure,
    ManagementRequest,
    ManagementResource,
    ManagementResult,
} from '@prisma-airs/desktop-contracts'
import { RefusedError } from '@prisma-airs/desktop-contracts'
import { type Dispatch, outcomeMessage } from '../tenants/dispatch'

/** Waits for the single native result of an admitted management read. */
export type ObserveManagement = (operation: string) => Promise<ManagementResult>

/** What one management read produced, as the presentation shows it. */
export type ReadOutcome =
    | { kind: 'result'; result: ManagementResult }
    /** Not admitted (refused, unconfirmed or undelivered): nothing was read. */
    | { kind: 'notAdmitted'; message: string }

/**
 * Dispatches one management read for `context` and waits for its single
 * observation. A read whose context retires while it runs settles as
 * `cancelled`; it is never shown as data.
 */
export async function readManagement(
    dispatch: Dispatch,
    observe: ObserveManagement,
    context: ContextRef,
    request: ManagementRequest
): Promise<ReadOutcome> {
    const outcome = await dispatch({ kind: 'management', context, request })
    if (outcome.kind !== 'admitted' || outcome.operation === null) {
        return { kind: 'notAdmitted', message: outcomeMessage(outcome) ?? 'The read was not started.' }
    }
    try {
        return { kind: 'result', result: await observe(outcome.operation) }
    } catch (error) {
        if (error instanceof RefusedError) return { kind: 'notAdmitted', message: outcomeMessage({ kind: 'refused', refusal: error.refusal }) ?? '' }
        return { kind: 'notAdmitted', message: 'The desktop did not return the result of this read.' }
    }
}

/** Sanitized operator text for each management failure (no server text). */
export const MANAGEMENT_FAILURE_TEXT: Record<ManagementFailure, string> = {
    unauthorized: 'The management client was not accepted. Check the client ID and secret in Settings.',
    denied: 'This management client is not allowed to read this. Ask your administrator for the needed role.',
    notFound: 'The service did not find this resource.',
    rateLimited: 'The service is limiting requests. Wait a moment, then refresh.',
    unavailable: 'The management service is unavailable. Try again later.',
    rejected: 'The service rejected the request.',
    timeout: 'The read took too long and was stopped.',
    cancelled: 'The read was stopped because the tenant or its management credential changed.',
    network: 'The management service could not be reached.',
    destination: 'The service tried to send the read somewhere else. Nothing was followed.',
    invalidResponse: 'The service returned a reply the desktop could not use.',
    credentialLocked: 'The Keychain is locked. Unlock it and try again.',
    credentialDenied: 'macOS did not allow access to the management secret.',
    credentialMissing: 'The management secret is missing. Enter it again in Settings.',
    configuration: 'The management connection could not be set up for this tenant.',
}

export interface ResourceInfo {
    id: ManagementResource
    label: string
    group: 'AI Runtime Security' | 'Data Loss Prevention'
    /** Fields tried in order for a row's display name. */
    nameFields: readonly string[]
    /** The service's identity field (detail reads look items up by it). */
    idField: string
    /** Whether a detail read can address an item of this resource. */
    detail: boolean
}

export const RESOURCES: readonly ResourceInfo[] = [
    { id: 'profiles', label: 'Security profiles', group: 'AI Runtime Security', nameFields: ['profile_name'], idField: 'profile_id', detail: true },
    { id: 'topics', label: 'Custom topics', group: 'AI Runtime Security', nameFields: ['topic_name'], idField: 'topic_id', detail: true },
    { id: 'applications', label: 'Applications', group: 'AI Runtime Security', nameFields: ['app_name', 'customer_app_name'], idField: 'customer_appId', detail: true },
    { id: 'apiKeys', label: 'API keys', group: 'AI Runtime Security', nameFields: ['api_key_name'], idField: 'api_key_id', detail: true },
    { id: 'deploymentProfiles', label: 'Deployment profiles', group: 'AI Runtime Security', nameFields: ['dp_name'], idField: 'dp_name', detail: true },
    { id: 'dlpCatalog', label: 'DLP profiles (AIRS)', group: 'Data Loss Prevention', nameFields: ['name'], idField: 'id', detail: true },
    { id: 'dataProfiles', label: 'Data profiles', group: 'Data Loss Prevention', nameFields: ['name'], idField: 'id', detail: true },
    { id: 'dataPatterns', label: 'Data patterns', group: 'Data Loss Prevention', nameFields: ['name'], idField: 'id', detail: true },
    { id: 'filteringProfiles', label: 'Data filtering profiles', group: 'Data Loss Prevention', nameFields: ['name'], idField: 'id', detail: true },
    { id: 'dictionaries', label: 'Dictionaries', group: 'Data Loss Prevention', nameFields: ['name'], idField: 'id', detail: true },
]

/** A scalar rendered as plain text; nested values as compact JSON text. */
export function fieldText(value: unknown): string {
    if (value === null || value === undefined) return '—'
    if (typeof value === 'string') return value
    if (typeof value === 'number' || typeof value === 'boolean') return String(value)
    return JSON.stringify(value)
}

export function itemName(info: ResourceInfo, item: Record<string, unknown>): string {
    for (const field of info.nameFields) {
        const value = item[field]
        if (typeof value === 'string' && value.length > 0) return value
    }
    return fieldText(item[info.idField])
}

export function itemId(info: ResourceInfo, item: Record<string, unknown>): string | null {
    const value = item[info.idField]
    if (typeof value === 'string' && value.length > 0) return value
    if (typeof value === 'number') return String(value)
    return null
}
//! Workspace MCP servers for the Harness inside the authority (C22, D049).
//!
//! The chosen Gateway workspace's MCP catalog is read through the tenant's
//! management client. The operator turns servers on (at most eight per
//! workspace) and signs in to each in the browser; the desktop does the
//! OAuth ([`crate::harness::mcp_auth`]), never the engine. A sign-in is a
//! grant: a UUID bound to the server's URL and catalog revision when it was
//! made, its tokens a Keychain item kept under write-ahead ownership (the
//! record joins the cleanup ledger, confirmed durable, and is reserved as
//! in flight before it is written; it leaves the ledger only in the save
//! that names it). A renewed token rotates the item the same way.
//!
//! A conversation's MCP scope is fixed when it starts: the servers on in
//! the loaded catalog, each with its grant if it was made for the server's
//! current URL and revision. Signing out, signing in again, turning a
//! server off or a revision change retires a conversation that holds the
//! server; an expired sign-in does not (the engine gets the signed-out
//! placeholder, the server's tools fail to start and inference goes on).

use std::sync::atomic::{AtomicU64, Ordering};
use std::sync::{Arc, Mutex};

use serde::Serialize;
use tokio::time::Instant;
use tokio_util::sync::CancellationToken;
use ts_rs::TS;
use url::Url;
use zeroize::Zeroizing;

use super::harness_identity::{SignInStep, begin_write, now, settle_write, write};
use super::{Effect, Inner, Refusal, State, lock};
use crate::context::{ContextRef, WorkspaceRef};
use crate::gateway::{GatewayRead, GatewayResult, McpCatalog};
use crate::harness::callback::{self, Callback};
use crate::harness::mcp::{self, CatalogServer, ScopeServer};
use crate::harness::mcp_auth::{McpAuthClient, McpProvider, McpSignInFailure, McpTokens};
use crate::management::{ManagementFailure, ManagementRequest, ManagementResult};
use crate::store::{StoredMcpGrant, StoredMcpServer};
use crate::tenants::TenantId;
use crate::vault::{RecordId, VaultError};

/// A scope's grants, in scope order (`None`: no current sign-in).
pub(super) type ScopeGrants = Vec<Option<Arc<McpGrant>>>;
/// A scope's tokens (`None`: the signed-out placeholder) and the earliest
/// time one must be renewed.
pub(super) type ScopeTokens = (Vec<Option<Zeroizing<String>>>, Option<u64>);

/// How a conversation's MCP scope stands (see `mcp_scope_check`).
#[derive(Clone, Copy, Debug, PartialEq, Eq)]
pub(super) enum ScopeCheck {
    Current,
    Unchecked,
    Changed,
}

/// The chosen workspace's catalog, as last read.
pub(super) struct CatalogState {
    tenant: TenantId,
    workspace: String,
    lease: u64,
    loading: bool,
    catalog: Option<McpCatalog>,
    failure: Option<ManagementFailure>,
}

/// An interactive sign-in to one server.
pub(super) struct McpFlow {
    flow: u64,
    tenant: TenantId,
    workspace: String,
    server_id: String,
    step: Option<SignInStep>,
    failure: Option<McpSignInFailure>,
    cancel: CancellationToken,
}

/// Where the chosen workspace's catalog stands.
#[derive(Clone, Copy, Debug, PartialEq, Eq, Serialize, TS)]
#[serde(rename_all = "camelCase")]
pub enum McpListState {
    Loading,
    Ready,
    Failed,
}

/// One catalog server, as the presentation sees it.
#[derive(Clone, Debug, PartialEq, Eq, Serialize, TS)]
#[serde(rename_all = "camelCase")]
pub struct McpServerView {
    pub id: String,
    pub name: String,
    pub namespace: String,
    pub url: String,
    pub status: String,
    /// The engine can take it.
    pub supported: bool,
    /// On for new conversations.
    pub enabled: bool,
    /// Signed in for the server's current URL and revision.
    pub signed_in: bool,
    /// Signed in for an earlier revision or URL: sign in again.
    pub stale: bool,
    /// Why the sign-in must be renewed by signing in again.
    pub expired: Option<McpSignInFailure>,
    /// Signing in is in progress.
    pub step: Option<SignInStep>,
    /// The last sign-in to it failed.
    pub failure: Option<McpSignInFailure>,
}

/// The chosen workspace's MCP servers (C22).
#[derive(Clone, Debug, PartialEq, Eq, Serialize, TS)]
#[serde(rename_all = "camelCase")]
pub struct HarnessMcpView {
    pub workspace: String,
    pub state: McpListState,
    pub failure: Option<ManagementFailure>,
    /// Every catalog page was read.
    pub complete: bool,
    pub servers: Vec<McpServerView>,
}

/// What renewing a grant's token needs, read off the lock.
struct McpAuth {
    loaded: bool,
    access: Option<Zeroizing<String>>,
    refresh: Option<Zeroizing<String>>,
    issued: u64,
    expires: Option<u64>,
    record: RecordId,
}

/// A signed-in server's live tokens.
pub(super) struct McpGrant {
    pub(super) tenant: TenantId,
    pub(super) workspace: String,
    pub(super) server_id: String,
    pub(super) id: String,
    url: String,
    client_id: String,
    token_endpoint: Option<Url>,
    revocation: Option<Url>,
    auth: tokio::sync::Mutex<McpAuth>,
    /// When the cached access token should be renewed (0: none cached;
    /// `u64::MAX`: it does not expire).
    renew_at: AtomicU64,
    /// When the token in use expires (0: not loaded yet; `u64::MAX`: it
    /// does not expire). Checked against the clock before any call is
    /// approved (P06, C22 review F1).
    expires_at: AtomicU64,
    expired: Mutex<Option<McpSignInFailure>>,
}

/// `exp - min(120 s, lifetime / 2)`, as for the Gateway credential.
fn renew_at(issued: u64, expires: Option<u64>) -> u64 {
    match expires {
        Some(exp) => exp.saturating_sub((exp.saturating_sub(issued) / 2).min(120)),
        None => u64::MAX,
    }
}

