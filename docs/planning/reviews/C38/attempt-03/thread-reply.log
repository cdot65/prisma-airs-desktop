interface Lifecycle {
    lifecycle: string
    question: string
    steps: { asking: ConversationView; approved: ConversationView; declined: ConversationView; ended: ConversationView }
    saved: SavedConversationView
}
const LIFECYCLES = [blocks, mcp, keys] as unknown as Lifecycle[]

