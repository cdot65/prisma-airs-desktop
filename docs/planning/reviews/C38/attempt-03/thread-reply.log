import { type FormEvent, useId, useState } from 'react'
import type { ContextRef, CredentialSource, HarnessSignInView, SelectedWorkspace } from '@prisma-airs/desktop-contracts'
import type { Dispatch, DispatchOutcome } from '../../../features/tenants/dispatch'
import { SIGN_IN_FAILURE_TEXT, SIGN_IN_NEEDS, SIGN_IN_STEP_TEXT, actionOutcomeText, notConfirmedText, saveFailureText } from '../text'
import { Btn, Field } from './controls'

interface Props {
    context: ContextRef
    /** The chosen Gateway workspace; company sign-in is set up for one. */
    selected: SelectedWorkspace | null
    signIn: HarnessSignInView | null
    /** The workspace key is stored for the chosen workspace. */
    keyHere: boolean
    /** A conversation is running (changing the credential ends it). */
    running: boolean
    dispatch: Dispatch
    onMessage: (message: string | null) => void
}

/**
 * Which credential the Harness answers with (C20), as a v2 panel (C38): the
 * workspace inference key, or a company sign-in through the browser whose
 * Gateway token is renewed before it is sent.
 */
export function SignInPanel({ selected, ...rest }: Props) {
    return selected ? <WorkspaceSignIn selected={selected} {...rest} /> : <SignInUnavailable />
}

const faint = { color: 'var(--v2-faint)' }

/** With no workspace chosen, company sign-in is shown but cannot be set up yet. */
function SignInUnavailable() {
    const ids = useId()
    return (
        <section aria-labelledby={`${ids}-heading`} className='flex flex-col gap-3' data-slot='harness-sign-in-setup'>
            <h2 id={`${ids}-heading`} className='text-[13px] font-bold'>
                Company sign-in (SSO)
            </h2>
            <p className='text-[12px]' style={faint}>{`Answer with your company’s identity provider instead of a workspace inference key. ${SIGN_IN_NEEDS}`}</p>
            <Btn className='self-start' disabled aria-describedby={`${ids}-reason`}>
                Set up company sign-in
            </Btn>
            <p id={`${ids}-reason`} className='text-[12px]' style={faint} data-slot='harness-sign-in-reason'>
                Choose a Gateway workspace first
            </p>
        </section>
    )
}

const CHECK = 'Check the sign-in state shown here before trying again.'

function WorkspaceSignIn({ context, selected, signIn, keyHere, running, dispatch, onMessage }: Props & { selected: SelectedWorkspace }) {
    const ids = useId()
    const here = signIn !== null && signIn.workspace.id === selected.workspace.id
    const [editing, setEditing] = useState(false)
    const [busy, setBusy] = useState(false)
    const source: CredentialSource = here && signIn.selected ? 'companySignIn' : 'workspaceKey'

    // An unknown delivery stays Not confirmed naming the action (a sign-out or a credential choice may have
    // happened; the sign-in state shown here is the state to reconcile with); a refusal says its own reason.
    async function send(intent: Parameters<Dispatch>[0], action: string, failureText?: (outcome: DispatchOutcome) => string): Promise<boolean> {
        onMessage(null)
        setBusy(true)
        try {
            const outcome = await dispatch(intent)
            if (outcome.kind === 'unknown') onMessage(notConfirmedText(action, CHECK))
            else if (outcome.kind !== 'admitted') onMessage(failureText ? failureText(outcome) : actionOutcomeText(outcome, action, CHECK))
            return outcome.kind === 'admitted'
        } finally {
            setBusy(false)
        }
    }

    async function configure(event: FormEvent<HTMLFormElement>) {
        event.preventDefault()
        const first = !here
        const form = new FormData(event.currentTarget)
        const value = (name: string) => String(form.get(name) ?? '').trim()
        const saved = await send(
            {
                kind: 'configureHarnessSignIn',
                context,
                workspace: selected.reference,
                endpoint: value('endpoint'),
                issuer: value('issuer'),
                clientId: value('client'),
                audience: value('audience'),
            },
            'saving the company sign-in',
            saveFailureText
        )
        if (!saved) return
        setEditing(false)
        // Newly set up, company sign-in becomes the choice for new
        // conversations; signing in is still the operator's step. A running
        // conversation is left alone (changing the credential ends it).
        if (first && !running) await send({ kind: 'chooseHarnessCredential', context, source: 'companySignIn' }, 'choosing the company sign-in')
    }

    const signedIn = here && signIn.account !== null
    const step = here ? signIn.step : null
    return (
        <section aria-labelledby={`${ids}-heading`} className='flex flex-col gap-3' data-slot='harness-credential'>
            <h2 id={`${ids}-heading`} className='text-[13px] font-bold'>
                Gateway credential
            </h2>
            {here ? (
                <fieldset className='flex flex-col gap-1' disabled={busy}>
                    <legend className='text-[13px] font-medium'>Answer with</legend>
                    {(
                        [
                            ['workspaceKey', 'The workspace inference key', keyHere ? 'Stored in AI Gateway' : 'Not stored for this workspace'],
                            ['companySignIn', 'Company sign-in', signedIn ? `Signed in as ${signIn.account}` : 'Not signed in'],
                        ] as const
                    ).map(([value, label, hint]) => (
                        <label key={value} className='flex min-h-9 cursor-pointer items-center gap-3'>
                            <input
                                type='radio'
                                name={`${ids}-source`}
                                value={value}
                                checked={source === value}
                                onChange={() => void send({ kind: 'chooseHarnessCredential', context, source: value }, 'choosing the credential')}
                                className='size-4 min-h-0'
                            />
                            <span className='flex flex-col'>
                                <span className='text-[13px]'>{label}</span>
                                <span className='text-[12px]' style={faint}>
                                    {hint}
                                </span>
                            </span>
                        </label>
                    ))}
                    {running ? (
                        <p className='text-[12px]' style={faint}>
                            Changing the credential ends the running conversation.
                        </p>
                    ) : null}
                </fieldset>
            ) : null}
            <h3 className='text-[13px] font-semibold'>Company sign-in (SSO)</h3>
            {!here && !editing ? (
                <>
                    <p className='text-[12px]' style={faint}>
                        {SIGN_IN_NEEDS}
                    </p>
                    <Btn className='self-start' onClick={() => setEditing(true)}>
                        Set up company sign-in
                    </Btn>
                </>
            ) : here && !editing ? (
                <div className='flex flex-col gap-2' data-slot='harness-sign-in'>
                    <dl className='grid grid-cols-[auto_1fr] gap-x-4 gap-y-1 text-[13px]'>
                        <dt style={faint}>Identity provider</dt>
                        <dd className='font-mono text-[12px] break-all'>{signIn.issuer}</dd>
                        <dt style={faint}>Client ID</dt>
                        <dd className='font-mono text-[12px] break-all'>{signIn.clientId}</dd>
                        <dt style={faint}>Gateway audience</dt>
                        <dd className='font-mono text-[12px] break-all'>{signIn.audience}</dd>
                        <dt style={faint}>Gateway endpoint</dt>
                        <dd className='font-mono text-[12px] break-all'>{signIn.endpoint}</dd>
                    </dl>
                    {step ? (
                        <p role='status' className='text-[13px]' data-slot='harness-sign-in-step'>
                            {SIGN_IN_STEP_TEXT[step]}
                        </p>
                    ) : null}
                    {signIn.failure ? (
                        <p role='alert' className='text-[13px]' style={{ color: 'var(--v2-flag)' }} data-slot='harness-sign-in-failure'>
                            {SIGN_IN_FAILURE_TEXT[signIn.failure]}
                        </p>
                    ) : null}
                    <div className='flex flex-wrap gap-2'>
                        {step ? (
                            <Btn onClick={() => void send({ kind: 'cancelHarnessSignIn', context }, 'cancelling the sign-in')}>Cancel sign-in</Btn>
                        ) : (
                            <Btn tier='primary' disabled={busy} onClick={() => void send({ kind: 'signInHarness', context }, 'starting the sign-in')}>
                                {signedIn ? 'Sign in again' : 'Sign in with your browser'}
                            </Btn>
                        )}
                        {signedIn ? (
                            <Btn disabled={busy} onClick={() => void send({ kind: 'signOutHarness', context }, 'signing out')}>
                                Sign out
                            </Btn>
                        ) : (
                            <Btn tier='tertiary' disabled={busy || step !== null} onClick={() => setEditing(true)}>
                                Change identity provider
                            </Btn>
                        )}
                        <Btn tier='tertiary' disabled={busy} onClick={() => void send({ kind: 'removeHarnessSignIn', context }, 'removing the company sign-in')}>
                            Remove company sign-in
                        </Btn>
                    </div>
                </div>
            ) : (
                <form className='flex flex-col gap-2' onSubmit={(event) => void configure(event)} data-slot='harness-sign-in-form'>
                    <p className='text-[12px]' style={faint}>
                        {`Use your company’s identity provider for ${selected.workspace.name} instead of the workspace key. The Gateway token is a signed JWT verified against the provider’s keys, kept in memory, and renewed before it expires; only the refresh token is kept, in the Keychain.`}
                    </p>
                    <p className='text-[12px]' style={faint}>
                        The identity provider must allow loopback redirects to http://127.0.0.1 on any port (path /callback).
                    </p>
                    {(
                        [
                            ['endpoint', 'Gateway endpoint', here ? signIn.endpoint : '', 'https://'],
                            ['issuer', 'Identity provider (issuer URL)', here ? signIn.issuer : '', 'https://'],
                            ['client', 'Client ID', here ? signIn.clientId : '', ''],
                            ['audience', 'Gateway audience', here ? signIn.audience : '', ''],
                        ] as const
                    ).map(([name, label, value, placeholder]) => (
                        <label key={name} className='flex flex-col gap-1 text-[13px]'>
                            <span className='font-medium'>{label}</span>
                            <Field name={name} defaultValue={value} placeholder={placeholder} autoCapitalize='off' autoCorrect='off' spellCheck={false} required maxLength={2048} />
                        </label>
                    ))}
                    <div className='flex flex-wrap gap-2'>
                        <Btn type='submit' disabled={busy}>
                            Save company sign-in
                        </Btn>
                        <Btn tier='tertiary' onClick={() => setEditing(false)}>
                            Cancel
                        </Btn>
                    </div>
                </form>
            )}
        </section>
    )
}
import type {
    ConversationView,
    HarnessFailure,
    HarnessPhase,
    HarnessStop,
    HistoryFailure,
    HistoryFormat,
    McpSignInFailure,
    NotContinuable,
    Refusal,
    SignInFailure,
    SignInStep,
    TurnEnd,
} from '@prisma-airs/desktop-contracts'
import { type DispatchOutcome, outcomeMessage } from '../../features/tenants/dispatch'

/**
 * The Harness's words, as the C19–C22 screens said them, kept here so the v2
 * screen imports no legacy view (C38). Each table is the one the core's
 * sanitized failure kinds map to; nothing here is model text.
 */

export const HARNESS_FAILURE_TEXT: Record<HarnessFailure, string> = {
    engineUnavailable: 'The bundled engine is missing or is not the one this app was built with. Nothing was started.',
    credentialMissing: 'The inference key is missing. Store it again in the AI Gateway Playground.',
    credentialLocked: 'The Keychain is locked. Unlock it and start again.',
    credentialDenied: 'macOS did not allow access to the inference key.',
    startFailed: 'The engine could not be started on this Mac.',
    bootstrapRejected: 'The engine refused this workspace, key or endpoint.',
    timeout: 'The engine did not answer in time and was stopped.',
    protocol: 'The engine sent something unexpected and was stopped.',
    bounds: 'The engine sent more than this app accepts and was stopped.',
    exited: 'The engine stopped unexpectedly. Anything being answered was not finished.',
    refused: 'The engine refused the request.',
    turnFailed: 'The answer failed. The Gateway or the model ended it with an error.',
    cleanupFailed: 'The engine could not be stopped and removed in time. Quit the app to end it.',
    restoreFailed: 'The saved conversation could not be continued in a new engine. It is still saved; start a new conversation.',
    signInNeeded: 'Your company sign-in must be renewed. Sign in again, then start the conversation.',
    mcpTooLarge: 'The workspace MCP sign-ins are too large to give the engine together. Turn some servers off and start again.',
}

export const PHASE_TEXT: Record<HarnessPhase, string> = {
    starting: 'Starting the engine…',
    ready: 'Ready.',
    answering: 'Answering…',
    interrupting: 'Stopping the answer…',
    renewing: 'Renewing your sign-in and restarting the engine with the conversation…',
    confirmWrite: 'Waiting for you to allow changes in the folder again.',
    ending: 'Ending the conversation…',
    ended: 'Ended.',
    failed: 'Failed.',
}

export const STOP_TEXT: Record<HarnessStop, string> = {
    ended: 'You ended this conversation.',
    sleep: 'This conversation ended when the Mac went to sleep.',
    quit: 'This conversation ended when the app quit.',
    deadline: 'This conversation reached its eight-hour limit and ended.',
}

export const TURN_TEXT: Record<TurnEnd, string> = {
    completed: 'Answered.',
    interrupted: 'The answer was stopped.',
    truncated: 'The answer reached 256 KiB and was stopped; the rest was not kept.',
    // D046: the engine retries a failing Gateway itself; the app stops it at
    // its first reconnect, so up to five requests may have reached it.
    failed:
        'The answer failed: the Gateway or the model ended it with an error. The engine may have sent the message to the Gateway up to five times before this app stopped it, and each may have been processed; nothing was undone.',
    refused: 'The engine did not take that message.',
}

/** How the conversation stands, in one line (the C19 Harness's words). */
export function conversationText(c: ConversationView): string {
    if (c.phase === 'failed' && c.failure) return HARNESS_FAILURE_TEXT[c.failure]
    if (c.phase === 'ended' && c.stop) return STOP_TEXT[c.stop]
    if (c.phase === 'ready' && c.lastTurn) return TURN_TEXT[c.lastTurn]
    return PHASE_TEXT[c.phase]
}

// ---- Company sign-in (C20) ----

export const SIGN_IN_FAILURE_TEXT: Record<SignInFailure, string> = {
    invalidConfig:
        'The identity provider’s configuration could not be used: it must name this issuer, support PKCE with S256 and keep its endpoints on the issuer’s own address.',
    network: 'The identity provider could not be reached. Try again.',
    invalidResponse: 'The identity provider returned something this app does not accept.',
    denied: 'Sign-in was declined.',
    timedOut: 'The browser did not come back within five minutes.',
    cancelled: 'Sign-in was cancelled.',
    browserUnavailable: 'The browser could not be opened.',
    callbackUnavailable: 'The sign-in callback could not be opened on this Mac.',
    invalidToken: 'A token from the identity provider did not verify (signature, issuer, audience, client or time).',
    opaqueToken: 'The identity provider’s Gateway token is not a signed JWT, which this app requires.',
    wrongWorkspace: 'The token is for another Gateway workspace.',
    differentAccount: 'A different account signed in. Sign out first to use another account.',
    sessionExpired: 'Your sign-in has expired. Sign in again to send.',
    storeFailed: 'The sign-in could not be kept in the Keychain.',
}

export const SIGN_IN_STEP_TEXT: Record<SignInStep, string> = {
    contacting: 'Contacting the identity provider…',
    browser: 'Continue in your browser. This app is waiting for it to come back.',
    completing: 'Verifying the sign-in…',
}

export const GENERIC_FAILURE = 'That was not done. Check the values and try again.'

/**
 * A panel action the desktop did not confirm (DESIGN-V2 §7): the action is
 * named as Not confirmed, never as not done, because it may have happened
 * (a permission change, a sign-out, a permanent deletion); the operator
 * reconciles through the state the panel shows, and nothing is resent.
 */
export function notConfirmedText(action: string, check: string): string {
    return `Not confirmed: ${action}. The desktop did not confirm it and it may have been done. ${check}`
}

/**
 * The line a panel shows for an action that did not apply: an unknown
 * delivery stays Not confirmed (above); a refusal says why (the refusal's
 * own reason, or the panel's wording for it); a delivery that failed before
 * it reached the desktop is not done.
 */
export function actionOutcomeText(outcome: DispatchOutcome, action: string, check: string, refusedLine?: (refusal: Refusal) => string | undefined): string | null {
    switch (outcome.kind) {
        case 'admitted':
            return null
        case 'unknown':
            return notConfirmedText(action, check)
        case 'refused':
            return refusedLine?.(outcome.refusal) ?? `That was not done. ${outcomeMessage(outcome)}`
        case 'failed':
            return `That was not done. ${outcomeMessage(outcome)}`
    }
}

export const SAVE_REFUSAL_TEXT: Partial<Record<Refusal, string>> = {
    invalidInput: 'Issuer and Gateway endpoint must be https URLs without a query string.',
    busy: 'Sign out of the current company sign-in first.',
    staleContext: 'The workspace changed; choose it again in AI Gateway.',
}

export function saveFailureText(outcome: DispatchOutcome): string {
    if (outcome.kind === 'refused') return SAVE_REFUSAL_TEXT[outcome.refusal] ?? outcomeMessage(outcome) ?? GENERIC_FAILURE
    return outcomeMessage(outcome) ?? GENERIC_FAILURE
}

export const SIGN_IN_NEEDS =
    'Company sign-in needs the identity provider’s issuer URL, a client ID, the Gateway audience and the Gateway endpoint. The provider must allow loopback redirects to http://127.0.0.1 on any port (path /callback).'

