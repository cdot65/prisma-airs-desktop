/**
 * How the conversation stands, in words the C19–C22 Harness used (R5): a
 * failure names itself; a stopped, cut, failed or refused answer is never
 * shown as complete; an engine that could not be removed says so.
 */
function outcomeOf(c: ConversationView): { tone: VerdictTone; word: string; text: string } | null {
    if (c.phase === 'failed') return { tone: 'blocked', word: C.outcome.failed, text: c.failure ? HARNESS_FAILURE_TEXT[c.failure] : conversationText(c) }
    if (c.cleanup === 'failed') return { tone: 'blocked', word: C.outcome.cleanup, text: HARNESS_FAILURE_TEXT.cleanupFailed }
    if (c.phase === 'ended') return { tone: 'info', word: C.outcome.ended, text: conversationText(c) }
    if (c.lastTurn && c.lastTurn !== 'completed' && c.phase === 'ready') {
        return { tone: c.lastTurn === 'failed' ? 'blocked' : 'flagged', word: C.outcome.turn[c.lastTurn] ?? c.lastTurn, text: TURN_TEXT[c.lastTurn] }
    }
    return null
}

function Transcript({ entries }: { entries: HarnessEntry[] }) {
    return (
        <ol className='flex flex-col' style={{ gap: 18 }}>
            {entries.map((e) => {
                const mine = e.role === 'operator'
                return (
                    <li
                        key={e.id}
                        data-slot='harness-entry'
                        data-role={e.role}
                        data-state={e.state}
                        className='flex shrink-0 flex-col gap-1'
                        style={mine ? { alignSelf: 'flex-end', maxWidth: '70%' } : { maxWidth: '82%' }}
                    >
                        <span className='text-[12px] font-medium' style={{ color: 'var(--v2-faint)' }}>
                            {C.role[e.role] ?? e.role}
                            {C.entryState[e.state] ? ` · ${C.entryState[e.state]}` : ''}
                        </span>
                        <p
                            className='text-[13px] leading-[1.45] whitespace-pre-wrap'
                            style={mine ? { padding: '10px 14px', borderRadius: '14px 14px 4px 14px', background: 'var(--v2-acc)', color: 'var(--v2-acc-ink)' } : { lineHeight: 1.5 }}
                        >
                            {e.text}
                        </p>
                    </li>
                )
            })}
        </ol>
    )
}

/**
 * One decision, as the core classified it (R1): a read-only call is decided
 * here; anything that may change things says what, and approving it opens
 * the system confirmation, which alone lets it run.
 */
function Decision({ approval: a, busy, onDecide }: { approval: HarnessApproval; busy: boolean; onDecide: (allow: boolean) => void }) {
    const what = a.server && a.tool ? `${a.server}.${a.tool}` : (a.command ?? a.files.join(', '))
    // Absent (a snapshot before C32) counts as may-change: never a false assurance.
    const readOnly = a.effect === 'readOnly'
    return (
        <section aria-label={C.decision} data-slot='harness-decision' data-kind={a.kind} data-effect={a.effect ?? 'mayChange'} className='flex flex-col rounded-[12px] border' style={{ gap: 12, padding: 18, borderColor: readOnly ? 'var(--v2-rule)' : 'var(--v2-flag)', background: 'var(--v2-paper)' }}>
            <div className='flex items-center gap-2'>
                <Glyph name='plug' size={16} />
                <b className='text-[13px]'>{C.decision}</b>
                <span className='ml-auto rounded-full text-[12px] whitespace-nowrap' style={{ padding: '2px 8px', background: 'var(--v2-inset)', color: 'var(--v2-soft)' }}>
                    {readOnly ? C.readOnlyWord : C.mayChangeWord}
                </span>
            </div>
            <p className='text-[13px]'>{C.asks(C.kind[a.kind] ?? a.kind, what)}</p>
            {a.arguments ? (
                <pre className='overflow-x-auto rounded-[8px] p-2.5 font-mono text-[12px] leading-[1.55]' style={{ background: 'var(--v2-inset)' }}>
                    {a.arguments}
                </pre>
            ) : null}
            <div className='flex flex-col text-[12px]' style={{ gap: 5 }}>
                {a.cwd ? <p>{C.inFolder(a.cwd)}</p> : null}
                {a.reason ? <p>{a.reason}</p> : null}
            </div>
            <p className='rounded-[8px] text-[12px] leading-[1.45]' style={{ padding: '8px 10px', background: 'var(--v2-acc-soft)' }}>
                {readOnly ? (C.readOnlyNote[a.kind] ?? C.readOnlyNote.desktopRead) : (C.mayChangeNote[a.kind] ?? C.mayChangeNote.mcpTool)}
            </p>
            <div className='flex gap-2'>
                <button type='button' disabled={busy} className='h-8 min-h-0 flex-grow rounded-[7px] text-[13px] font-semibold disabled:opacity-60' style={{ background: 'var(--v2-acc)', color: 'var(--v2-acc-ink)' }} onClick={() => onDecide(true)}>
                    {readOnly ? C.approveOnce : C.approveNative}
                </button>
                <button type='button' disabled={busy} className='h-8 min-h-0 flex-grow rounded-[7px] border text-[13px] disabled:opacity-60' style={{ borderColor: 'var(--v2-rule)', background: 'var(--v2-paper)' }} onClick={() => onDecide(false)}>
                    {C.decline}
                </button>
            </div>
        </section>
    )
}

function applicationOf(p: ProposalView): string | null {
    try {
        const body = JSON.parse(p.draft.body) as { cust_app?: unknown }
        return typeof body.cust_app === 'string' ? body.cust_app : null
    } catch {
        return null
    }
}

/** The Harness's proposals as follow-ups: each opens only as the operator's own review, and only while its conversation runs. */
function FollowUps({
    proposals,
    rotations,
    busy,
    open,
    onOpen,
    onDismiss,
}: {
    proposals: ProposalView[]
    rotations: RotationView[]
    busy: boolean
    open: boolean
    onOpen: (p: ProposalView) => void
    onDismiss: (p: ProposalView) => void
}) {
    return (
        <section aria-label={C.followUps} data-slot='harness-follow-ups' className='flex flex-col gap-2 rounded-[12px] border p-3' style={{ borderColor: 'var(--v2-rule)' }}>
            <h2 className='text-[14px] font-semibold'>{C.followUps}</h2>
            <p className='text-[12px]' style={{ color: 'var(--v2-soft)' }}>
                {open ? C.followUpNote : C.followUpEnded}
            </p>
            <ul className='flex flex-col gap-2'>
                {proposals.map((p) => {
                    // A key rotation's hand-off says where the rotation stands (I7).
                    const app = p.draft.kind === 'apiKeys' && p.draft.action === 'version' ? applicationOf(p) : null
                    const rotation = app ? (rotations.find((r) => r.application === app) ?? null) : null
                    const stateTone: VerdictTone = p.state === 'staged' ? 'info' : p.state === 'inReview' ? 'flagged' : 'allowed'
                    return (
                        <li key={p.id} data-slot='follow-up' data-kind={p.draft.kind} data-action={p.draft.action} data-state={p.state} className='flex flex-col gap-1 text-[13px]'>
                            <span className='font-medium'>{p.summary}</span>
                            {app ? (
                                <span data-slot='follow-up-rotation' className='text-[12px]'>
                                    {rotation ? (C.rotation[rotation.stage] ?? rotation.stage) : C.rotation.none}
                                </span>
                            ) : null}
                            {p.state !== 'staged' ? <Verdict tone={stateTone} word={p.state === 'inReview' ? C.inReview : p.state === 'closed' ? C.closed : C.dismissed} /> : null}
                            {open && (p.state === 'staged' || p.state === 'inReview') ? (
                                <div className='flex flex-wrap gap-2'>
                                    <button
                                        type='button'
                                        disabled={busy}
                                        className='h-8 rounded-[7px] px-3 text-[13px] font-semibold disabled:opacity-60'
                                        style={{ background: 'var(--v2-acc)', color: 'var(--v2-acc-ink)' }}
                                        onClick={() => onOpen(p)}
                                    >
                                        {p.state === 'staged' ? C.openReview : C.goToReview}
                                    </button>
                                    {p.state === 'staged' ? (
                                        <button type='button' disabled={busy} className='h-8 rounded-[7px] border px-3 text-[13px] disabled:opacity-60' style={{ borderColor: 'var(--v2-rule)' }} onClick={() => onDismiss(p)}>
                                            {C.dismiss}
                                        </button>
                                    ) : null}
                                </div>
                            ) : null}
                        </li>
                    )
                })}
            </ul>
        </section>
    )
}
import { useId, useState } from 'react'
import type { ContextRef, HarnessProjectView } from '@prisma-airs/desktop-contracts'
import type { Dispatch } from '../../../features/tenants/dispatch'
import { actionOutcomeText } from '../text'
import { Btn } from './controls'

interface Props {
    context: ContextRef
    project: HarnessProjectView | null
    /** A folder just refused as the project. */
    refused: string | null
    /** A conversation is running (changing the project or access ends it). */
    running: boolean
    dispatch: Dispatch
    onMessage: (message: string | null) => void
}

const REFUSED = 'Folders that hold system files, credentials or this app’s own data cannot be used.'
const CHECK = 'Check the folder and the permission shown here before trying again.'

/**
 * The folder the Harness works in (C21, D048), as a v2 panel (C38): chosen
 * in the native folder sheet, read-only unless the operator allows changes.
 * Every command and file change still waits for the operator's approval,
 * and the engine's sandbox keeps both inside the folder.
 */
export function ProjectPanel({ context, project, refused, running, dispatch, onMessage }: Props) {
    const ids = useId()
    const [busy, setBusy] = useState(false)

    // An unknown delivery stays Not confirmed naming the action (the change may have applied; the folder and
    // its permission shown here are the state to reconcile with); a refusal says its own reason.
    async function send(intent: Parameters<Dispatch>[0], action: string) {
        onMessage(null)
        setBusy(true)
        try {
            onMessage(actionOutcomeText(await dispatch(intent), action, CHECK))
        } finally {
            setBusy(false)
        }
    }

    return (
        <section aria-labelledby={`${ids}-heading`} className='flex flex-col gap-2 rounded-[12px] border p-3' style={{ borderColor: 'var(--v2-rule)' }} data-slot='harness-project'>
            <h2 id={`${ids}-heading`} className='text-[13px] font-bold'>
                Project folder
            </h2>
            {project ? (
                <>
                    <p className='font-mono text-[12px] break-all' data-slot='harness-project-path'>
                        {project.path}
                    </p>
                    <label className='flex items-start gap-2 text-[13px]'>
                        <input
                            type='checkbox'
                            className='mt-[3px] size-4 min-h-0'
                            checked={project.write}
                            disabled={busy}
                            aria-describedby={`${ids}-write`}
                            onChange={(event) =>
                                void send({ kind: 'setHarnessWrite', context, write: event.target.checked }, event.target.checked ? 'allowing changes in this folder' : 'making this folder read-only')
                            }
                        />
                        Allow changes in this folder
                    </label>
                    <p id={`${ids}-write`} className='text-[12px]' style={{ color: 'var(--v2-faint)' }}>
                        {project.write
                            ? 'The Harness may ask to run commands and change files here. Each waits for your approval and stays inside this folder.'
                            : 'Read-only: the Harness may ask to run commands here, each with your approval, but cannot change anything.'}
                    </p>
                </>
            ) : (
                <p className='text-[13px]' style={{ color: 'var(--v2-faint)' }}>
                    No folder. The Harness can use this app’s own read tools and propose changes for your review, but cannot run commands.
                </p>
            )}
            {refused ? (
                <p role='alert' className='text-[13px] break-all' style={{ color: 'var(--v2-flag)' }} data-slot='harness-project-refused'>
                    {`${refused} cannot be used. ${REFUSED}`}
                </p>
            ) : null}
            {running ? (
                <p className='text-[12px]' style={{ color: 'var(--v2-faint)' }}>
                    Changing the folder or its access ends the running conversation.
                </p>
            ) : null}
            <div className='flex flex-wrap gap-2'>
                <Btn disabled={busy} onClick={() => void send({ kind: 'chooseHarnessProject', context }, 'choosing a folder')}>
                    {project ? 'Choose another folder…' : 'Choose a folder…'}
                </Btn>
                {project ? (
                    <Btn tier='tertiary' disabled={busy} onClick={() => void send({ kind: 'clearHarnessProject', context }, 'removing the folder')}>
                        Remove folder
                    </Btn>
                ) : null}
            </div>
        </section>
    )
}
import type { ButtonHTMLAttributes, InputHTMLAttributes } from 'react'

/** The prototype's 32px controls (R2App): a primary accent button, a bordered secondary, a plain tertiary. */
export function Btn({ tier = 'secondary', className = '', style, ...rest }: ButtonHTMLAttributes<HTMLButtonElement> & { tier?: 'primary' | 'secondary' | 'tertiary' }) {
    const look =
        tier === 'primary'
            ? { background: 'var(--v2-acc)', color: 'var(--v2-acc-ink)', border: 0 }
            : tier === 'secondary'
              ? { background: 'var(--v2-paper)', color: 'var(--v2-ink)', border: '1px solid var(--v2-rule)' }
              : { background: 'transparent', color: 'var(--v2-soft)', border: '1px solid var(--v2-rule)' }
    return (
        <button
            type='button'
            {...rest}
            className={`flex h-8 min-h-0 items-center justify-center rounded-[7px] px-3 text-[12px] whitespace-nowrap disabled:cursor-not-allowed disabled:opacity-60 ${tier === 'primary' ? 'font-semibold' : ''} ${className}`}
            style={{ ...look, ...style }}
        />
    )
}

/** A 32px text field with the prototype's control border. */
export function Field({ className = '', style, ...rest }: InputHTMLAttributes<HTMLInputElement>) {
    return (
        <input
            {...rest}
            className={`h-8 min-h-0 rounded-[7px] border px-2.5 text-[13px] ${className}`}
            style={{ borderColor: 'var(--v2-ctl)', background: 'var(--v2-paper)', color: 'var(--v2-ink)', ...style }}
        />
    )
}

