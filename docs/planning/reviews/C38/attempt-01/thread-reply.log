/bin/zsh -lc "rg -n 'harness/(panels|text)|SignInPanel|ProjectPanel|McpPanel|HistoryPanel' apps/desktop/src --glob '*test*'; rg -n 'SignInPanel|ProjectPanel|McpPanel|HistoryPanel' apps/desktop/src/features/harness/*test*; sed -n '200,470p' tools/native-acceptance/acceptance_c38.py" in /Users/cdot/development/redtail/prisma-airs-desktop-v2
