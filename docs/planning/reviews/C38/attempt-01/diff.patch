diff --git a/apps/desktop/src/v2/harness/panels/controls.tsx b/apps/desktop/src/v2/harness/panels/controls.tsx
new file mode 100644
index 00000000..e71f1336
--- /dev/null
+++ b/apps/desktop/src/v2/harness/panels/controls.tsx
@@ -0,0 +1,30 @@
+import type { ButtonHTMLAttributes, InputHTMLAttributes } from 'react'
+
+/** The prototype's 32px controls (R2App): a primary accent button, a bordered secondary, a plain tertiary. */
+export function Btn({ tier = 'secondary', className = '', style, ...rest }: ButtonHTMLAttributes<HTMLButtonElement> & { tier?: 'primary' | 'secondary' | 'tertiary' }) {
+    const look =
+        tier === 'primary'
+            ? { background: 'var(--v2-acc)', color: 'var(--v2-acc-ink)', border: 0 }
+            : tier === 'secondary'
+              ? { background: 'var(--v2-paper)', color: 'var(--v2-ink)', border: '1px solid var(--v2-rule)' }
+              : { background: 'transparent', color: 'var(--v2-soft)', border: '1px solid var(--v2-rule)' }
+    return (
+        <button
+            type='button'
+            {...rest}
+            className={`flex h-8 min-h-0 items-center justify-center rounded-[7px] px-3 text-[12px] whitespace-nowrap disabled:cursor-not-allowed disabled:opacity-60 ${tier === 'primary' ? 'font-semibold' : ''} ${className}`}
+            style={{ ...look, ...style }}
+        />
+    )
+}
+
+/** A 32px text field with the prototype's control border. */
+export function Field({ className = '', style, ...rest }: InputHTMLAttributes<HTMLInputElement>) {
+    return (
+        <input
+            {...rest}
+            className={`h-8 min-h-0 rounded-[7px] border px-2.5 text-[13px] ${className}`}
+            style={{ borderColor: 'var(--v2-ctl)', background: 'var(--v2-paper)', color: 'var(--v2-ink)', ...style }}
+        />
+    )
+}
diff --git a/apps/desktop/src/v2/harness/panels/history.tsx b/apps/desktop/src/v2/harness/panels/history.tsx
new file mode 100644
index 00000000..dd0db4e8
--- /dev/null
+++ b/apps/desktop/src/v2/harness/panels/history.tsx
@@ -0,0 +1,229 @@
+import { useEffect, useId, useRef, useState } from 'react'
+import type { ContextRef, HarnessHistoryView, HistoryFormat, SelectedWorkspace } from '@prisma-airs/desktop-contracts'
+import type { Dispatch } from '../../../features/tenants/dispatch'
+import { HISTORY_FAILURE_TEXT, HISTORY_FORMATS, NOT_CONTINUABLE_TEXT, savedAt } from '../text'
+import { Btn } from './controls'
+
+interface Props {
+    context: ContextRef
+    /** None while no workspace is chosen (as when AI Gateway cannot be read). */
+    selected: SelectedWorkspace | null
+    history: HarnessHistoryView | null
+    /** A conversation is running (one at a time). */
+    running: boolean
+    dispatch: Dispatch
+    onMessage: (message: string | null) => void
+}
+
+const faint = { color: 'var(--v2-faint)' }
+const warn = { color: 'var(--v2-flag)' }
+const card = { borderColor: 'var(--v2-rule)' }
+
+/**
+ * The chosen workspace's saved conversations (C20), as a v2 panel (C38):
+ * saved encrypted on this Mac after every answer. One can be read,
+ * exported, deleted, or continued in a new engine when it ran with the
+ * credential this workspace uses now. With no workspace chosen, the last
+ * chosen one's, read from this Mac only (T23): read, exported and deleted,
+ * never continued.
+ */
+export function HistoryPanel({ context, selected, history, running, dispatch, onMessage }: Props) {
+    const ids = useId()
+    const [format, setFormat] = useState<HistoryFormat>('markdown')
+    const [confirming, setConfirming] = useState<string | null>(null)
+    const openedRef = useRef<HTMLHeadingElement>(null)
+    const listRef = useRef<HTMLHeadingElement>(null)
+    const workspace = selected?.reference ?? null
+    // Without a chosen workspace there may be none saved on this Mac either.
+    const [none, setNone] = useState(false)
+
+    // Read the list whenever the chosen workspace changes.
+    useEffect(() => {
+        let current = true
+        setNone(false)
+        void dispatch({ kind: 'listHarnessHistory', context, workspace }).then((outcome) => {
+            if (current) setNone(workspace === null && outcome.kind !== 'admitted')
+        })
+        return () => {
+            current = false
+        }
+    }, [dispatch, context, workspace])
+
+    const opened = history?.opened ?? null
+    const wasOpened = useRef<string | null>(opened?.id ?? null)
+    useEffect(() => {
+        const was = wasOpened.current
+        wasOpened.current = opened?.id ?? null
+        if (opened && opened.id !== was) openedRef.current?.focus()
+        if (!opened && was !== null) listRef.current?.focus()
+    }, [opened])
+
+    async function send(intent: Parameters<Dispatch>[0]): Promise<boolean> {
+        onMessage(null)
+        const outcome = await dispatch(intent)
+        if (outcome.kind !== 'admitted') onMessage('That was not done.')
+        return outcome.kind === 'admitted'
+    }
+
+    const busy = history?.busy ?? false
+    const exportState = history?.export ?? null
+    if (none || (selected === null && history !== null && !history.local)) return null
+    return (
+        <section aria-labelledby={`${ids}-heading`} className='flex flex-col gap-3' data-slot='harness-history'>
+            <h2 ref={listRef} tabIndex={-1} id={`${ids}-heading`} className='text-[13px] font-bold'>
+                Saved conversations
+            </h2>
+            <p className='text-[12px]' style={faint}>
+                {selected
+                    ? `Conversations in ${selected.workspace.name} are saved on this Mac after every answer, encrypted with a key kept in the Keychain. Up to 16 are kept; nothing is deleted to make room.`
+                    : 'AI Gateway’s workspaces are not available, so these are the conversations saved on this Mac for the workspace you chose last. They can be read, exported and deleted here; continuing one needs that workspace from AI Gateway.'}
+            </p>
+            {history === null || history.state === 'loading' ? (
+                <p role='status' className='text-[13px]'>
+                    Reading saved conversations…
+                </p>
+            ) : history.state === 'failed' && history.failure ? (
+                <p role='alert' className='text-[13px]' style={warn}>
+                    {HISTORY_FAILURE_TEXT[history.failure]}
+                </p>
+            ) : history.conversations.length === 0 && history.unreadable.length === 0 ? (
+                <p className='text-[13px]'>No saved conversations in this workspace.</p>
+            ) : (
+                <ul role='list' aria-label='Saved conversations' className='flex flex-col gap-2' data-slot='harness-history-list'>
+                    {history.conversations.map((c) => (
+                        <li key={c.id} className='flex flex-wrap items-center gap-3 rounded-[10px] border p-2.5' style={card}>
+                            <span className='flex min-w-0 flex-1 flex-col'>
+                                <span className='truncate text-[13px] font-semibold'>{c.title || 'Untitled conversation'}</span>
+                                <span className='text-[12px]' style={faint}>
+                                    {`${c.entries} messages · ${savedAt(c.updated)} · ${c.source === 'companySignIn' ? 'company sign-in' : 'workspace key'}`}
+                                </span>
+                            </span>
+                            <Btn disabled={busy} aria-label={`Open ${c.title || 'untitled conversation'}`} onClick={() => void send({ kind: 'openHarnessHistory', context, workspace, id: c.id })}>
+                                Open
+                            </Btn>
+                        </li>
+                    ))}
+                    {history.unreadable.map((id) => (
+                        <li key={id} className='flex flex-wrap items-center gap-3 rounded-[10px] border p-2.5' style={card}>
+                            <span className='flex-1 text-[13px]' style={faint}>
+                                {HISTORY_FAILURE_TEXT.unreadable}
+                            </span>
+                            {/* Its key may be missing only for now (C20 F5): deleting asks first. */}
+                            {confirming === id ? (
+                                <>
+                                    <span role='alert' className='w-full text-[13px]'>
+                                        Delete this unreadable conversation from this Mac? If its key comes back it could be read again; once deleted it cannot be recovered.
+                                    </span>
+                                    <Btn
+                                        disabled={busy}
+                                        onClick={async () => {
+                                            setConfirming(null)
+                                            await send({ kind: 'deleteHarnessHistory', context, workspace, id })
+                                        }}
+                                    >
+                                        Delete permanently
+                                    </Btn>
+                                    <Btn tier='tertiary' onClick={() => setConfirming(null)}>
+                                        Keep it
+                                    </Btn>
+                                </>
+                            ) : (
+                                <Btn tier='tertiary' disabled={busy} onClick={() => setConfirming(id)}>
+                                    Delete unreadable conversation…
+                                </Btn>
+                            )}
+                        </li>
+                    ))}
+                </ul>
+            )}
+            {history?.full ? (
+                <p className='text-[13px]' style={warn}>
+                    {HISTORY_FAILURE_TEXT.full}
+                </p>
+            ) : null}
+            {history?.problem ? (
+                <p role='alert' className='text-[13px]' style={warn} data-slot='harness-history-problem'>
+                    {HISTORY_FAILURE_TEXT[history.problem]}
+                </p>
+            ) : null}
+            {opened ? (
+                <section aria-labelledby={`${ids}-opened`} className='flex flex-col gap-3' data-slot='harness-history-opened'>
+                    <h3 ref={openedRef} tabIndex={-1} id={`${ids}-opened`} className='text-[13px] font-semibold'>
+                        {opened.title || 'Untitled conversation'}
+                    </h3>
+                    <p className='text-[12px]' style={faint}>{`Saved ${savedAt(opened.updated)}`}</p>
+                    <ol role='list' aria-label='Saved messages' className='flex flex-col gap-2'>
+                        {opened.entries.map((e) => (
+                            <li key={e.id} className='rounded-[10px] border p-2.5' style={card}>
+                                <p className='text-[12px] font-semibold' style={faint}>
+                                    {e.role === 'operator' ? 'You' : 'Harness'}
+                                </p>
+                                <p className='text-[13px] whitespace-pre-wrap'>{e.text}</p>
+                            </li>
+                        ))}
+                    </ol>
+                    {opened.notContinuable ? <p className='text-[13px]'>{NOT_CONTINUABLE_TEXT[opened.notContinuable]}</p> : null}
+                    <div className='flex flex-wrap items-end gap-2'>
+                        {opened.notContinuable === null && workspace !== null ? (
+                            <Btn tier='primary' disabled={busy || running} onClick={() => void send({ kind: 'resumeHarness', context, workspace, id: opened.id })}>
+                                Continue this conversation
+                            </Btn>
+                        ) : null}
+                        <label className='flex flex-col gap-1 text-[12px]'>
+                            <span>Export as</span>
+                            <select value={format} onChange={(event) => setFormat(event.target.value as HistoryFormat)} className='h-8 min-h-0 rounded-[7px] border px-2 text-[13px]' style={{ borderColor: 'var(--v2-ctl)', background: 'var(--v2-paper)' }}>
+                                {HISTORY_FORMATS.map(([value, label]) => (
+                                    <option key={value} value={value}>
+                                        {label}
+                                    </option>
+                                ))}
+                            </select>
+                        </label>
+                        <Btn disabled={exportState?.state === 'saving'} onClick={() => void send({ kind: 'exportHarnessHistory', context, workspace, id: opened.id, format })}>
+                            Export…
+                        </Btn>
+                        {confirming === opened.id ? (
+                            <>
+                                <Btn
+                                    disabled={busy}
+                                    onClick={async () => {
+                                        setConfirming(null)
+                                        await send({ kind: 'deleteHarnessHistory', context, workspace, id: opened.id })
+                                    }}
+                                >
+                                    Delete permanently
+                                </Btn>
+                                <Btn tier='tertiary' onClick={() => setConfirming(null)}>
+                                    Keep it
+                                </Btn>
+                            </>
+                        ) : (
+                            <Btn tier='tertiary' disabled={busy || opened.notContinuable === 'running'} onClick={() => setConfirming(opened.id)}>
+                                Delete…
+                            </Btn>
+                        )}
+                        <Btn tier='tertiary' onClick={() => void send({ kind: 'closeHarnessHistory', context, workspace })}>
+                            Close
+                        </Btn>
+                    </div>
+                    {confirming === opened.id ? (
+                        <p role='alert' className='text-[13px]'>
+                            Delete this saved conversation from this Mac? It cannot be recovered.
+                        </p>
+                    ) : null}
+                    {exportState ? (
+                        <p role='status' className='text-[13px]' data-slot='harness-export'>
+                            {exportState.state === 'saving'
+                                ? 'Choose where to save the transcript…'
+                                : exportState.state === 'saved'
+                                  ? `Saved ${exportState.name ?? 'the transcript'}.`
+                                  : exportState.state === 'cancelled'
+                                    ? 'Export cancelled.'
+                                    : 'The transcript could not be saved.'}
+                        </p>
+                    ) : null}
+                </section>
+            ) : null}
+        </section>
+    )
+}
diff --git a/apps/desktop/src/v2/harness/panels/mcp.tsx b/apps/desktop/src/v2/harness/panels/mcp.tsx
new file mode 100644
index 00000000..68b88f9c
--- /dev/null
+++ b/apps/desktop/src/v2/harness/panels/mcp.tsx
@@ -0,0 +1,162 @@
+import { useEffect, useId, useState } from 'react'
+import type { ContextRef, HarnessMcpView, McpServerView, SelectedWorkspace } from '@prisma-airs/desktop-contracts'
+import { MANAGEMENT_FAILURE_TEXT } from '../../../features/administration/management-read'
+import type { Dispatch } from '../../../features/tenants/dispatch'
+import { MCP_MAX_ON, MCP_SIGN_IN_FAILURE_TEXT, MCP_STEP_TEXT } from '../text'
+import { Btn } from './controls'
+
+function standing(s: McpServerView): string {
+    if (!s.supported) return 'This server’s identifier is not one the Harness engine accepts; it cannot be used.'
+    if (s.expired) return MCP_SIGN_IN_FAILURE_TEXT[s.expired]
+    if (s.stale) return 'Signed in for an earlier version of this server. Sign in again to use it.'
+    if (s.signedIn) return 'Signed in.'
+    return 'Not signed in: its tools will be unavailable until you sign in.'
+}
+
+/** The aside's one-line standing (R2App's "Signed in" column). */
+export function mcpStanding(s: McpServerView): { word: string; tone: 'ok' | 'flag' | 'faint' } {
+    if (!s.supported) return { word: 'Not usable', tone: 'faint' }
+    if (s.expired) return { word: 'Sign-in expired', tone: 'flag' }
+    if (s.stale) return { word: 'Sign in again', tone: 'flag' }
+    if (s.signedIn) return { word: 'Signed in', tone: 'ok' }
+    return { word: 'Not signed in', tone: 'faint' }
+}
+
+interface Props {
+    context: ContextRef
+    selected: SelectedWorkspace
+    mcp: HarnessMcpView | null
+    /** A conversation is running (changing its servers ends it). */
+    running: boolean
+    dispatch: Dispatch
+    onMessage: (message: string | null) => void
+}
+
+const faint = { color: 'var(--v2-faint)' }
+
+/**
+ * The chosen workspace's MCP servers (C22, D049), as a v2 panel (C38): read
+ * from its Gateway catalog, turned on for new conversations (at most
+ * eight), each signed in to in the browser by this app. The engine only
+ * ever gets each server's token in memory, and asks before every tool call.
+ */
+export function McpPanel({ context, selected, mcp, running, dispatch, onMessage }: Props) {
+    const ids = useId()
+    const [busy, setBusy] = useState(false)
+    const workspace = selected.reference
+    const here = mcp !== null && mcp.workspace === selected.workspace.id
+
+    // Read the catalog whenever the chosen workspace changes.
+    useEffect(() => {
+        void dispatch({ kind: 'listMcpServers', context, workspace })
+    }, [dispatch, context, workspace])
+
+    async function send(intent: Parameters<Dispatch>[0], refused: string) {
+        onMessage(null)
+        setBusy(true)
+        try {
+            const outcome = await dispatch(intent)
+            if (outcome.kind !== 'admitted') onMessage(refused)
+        } finally {
+            setBusy(false)
+        }
+    }
+
+    const servers = here ? mcp.servers : []
+    const on = servers.filter((s) => s.enabled).length
+    const signingIn = servers.some((s) => s.step !== null)
+    return (
+        <section aria-labelledby={`${ids}-heading`} className='flex flex-col gap-2 rounded-[12px] border p-3' style={{ borderColor: 'var(--v2-rule)' }} data-slot='harness-mcp'>
+            <h2 id={`${ids}-heading`} className='text-[13px] font-bold'>
+                Workspace MCP servers
+            </h2>
+            <p className='text-[12px]' style={faint}>
+                Servers published in this workspace’s AI Gateway. The Harness asks you before every tool call, and each server’s sign-in stays with this app.
+            </p>
+            {!here || mcp.state === 'loading' ? (
+                <p role='status' className='text-[13px]'>
+                    Reading the workspace’s MCP servers…
+                </p>
+            ) : null}
+            {here && mcp.failure ? (
+                <p role='alert' className='text-[13px]' style={{ color: 'var(--v2-flag)' }}>
+                    {`The MCP servers could not be read: ${MANAGEMENT_FAILURE_TEXT[mcp.failure]}`}
+                </p>
+            ) : null}
+            {here && mcp.state !== 'loading' && servers.length === 0 && !mcp.failure ? <p className='text-[13px]'>No MCP servers are published in this workspace.</p> : null}
+            {here && !mcp.complete && servers.length > 0 ? (
+                <p className='text-[12px]' style={faint}>
+                    Only the first 500 servers are shown.
+                </p>
+            ) : null}
+            {servers.length > 0 ? (
+                <ul role='list' aria-label='MCP servers' className='flex flex-col gap-2'>
+                    {servers.map((s) => {
+                        const holdsSignIn = s.signedIn || s.stale || s.expired !== null
+                        return (
+                            <li key={s.id} className='rounded-[8px] border p-2' style={{ borderColor: 'var(--v2-rule)' }} data-slot='harness-mcp-server'>
+                                <label className='flex items-start gap-2 text-[13px] font-semibold'>
+                                    <input
+                                        type='checkbox'
+                                        className='mt-[3px] size-4 min-h-0'
+                                        checked={s.enabled}
+                                        disabled={busy || !s.supported || (!s.enabled && on >= MCP_MAX_ON)}
+                                        aria-describedby={`${ids}-${s.id}-standing`}
+                                        onChange={(event) =>
+                                            void send(
+                                                { kind: 'enableMcpServer', context, workspace, server: s.id, enabled: event.target.checked },
+                                                'That was not done. At most eight servers can be on, and only ones in the catalog.'
+                                            )
+                                        }
+                                    />
+                                    {`Use ${s.name} in new conversations`}
+                                </label>
+                                <p className='font-mono text-[11px] break-all'>{`${s.namespace} · ${s.url}`}</p>
+                                <p id={`${ids}-${s.id}-standing`} className='text-[12px]'>
+                                    {standing(s)}
+                                </p>
+                                {s.step ? (
+                                    <p role='status' className='text-[12px]'>
+                                        {MCP_STEP_TEXT[s.step]}
+                                    </p>
+                                ) : null}
+                                {s.failure ? (
+                                    <p role='alert' className='text-[12px]' style={{ color: 'var(--v2-flag)' }}>
+                                        {MCP_SIGN_IN_FAILURE_TEXT[s.failure]}
+                                    </p>
+                                ) : null}
+                                <div className='mt-1 flex flex-wrap gap-2'>
+                                    {s.step ? (
+                                        <Btn tier='tertiary' onClick={() => void send({ kind: 'cancelMcpSignIn', context }, 'That was not done.')}>
+                                            Cancel sign-in
+                                        </Btn>
+                                    ) : (
+                                        <Btn
+                                            disabled={busy || !s.supported || signingIn}
+                                            onClick={() => void send({ kind: 'signInMcpServer', context, workspace, server: s.id }, 'Sign-in could not start. Another may be in progress.')}
+                                        >
+                                            {holdsSignIn ? `Sign in to ${s.name} again` : `Sign in to ${s.name}`}
+                                        </Btn>
+                                    )}
+                                    {holdsSignIn ? (
+                                        <Btn tier='tertiary' disabled={busy} onClick={() => void send({ kind: 'signOutMcpServer', context, workspace, server: s.id }, 'That was not done.')}>
+                                            {`Sign out of ${s.name}`}
+                                        </Btn>
+                                    ) : null}
+                                </div>
+                            </li>
+                        )
+                    })}
+                </ul>
+            ) : null}
+            {running ? (
+                <p className='text-[12px]' style={faint}>
+                    Turning a server off, signing in again or signing out ends the running conversation that uses it.
+                </p>
+            ) : null}
+            <Btn tier='tertiary' className='self-start' disabled={here && mcp.state === 'loading'} onClick={() => void send({ kind: 'listMcpServers', context, workspace }, 'The servers could not be read.')}>
+                Read the servers again
+            </Btn>
+        </section>
+    )
+}
diff --git a/apps/desktop/src/v2/harness/panels/project.tsx b/apps/desktop/src/v2/harness/panels/project.tsx
new file mode 100644
index 00000000..a08ab02d
--- /dev/null
+++ b/apps/desktop/src/v2/harness/panels/project.tsx
@@ -0,0 +1,94 @@
+import { useId, useState } from 'react'
+import type { ContextRef, HarnessProjectView } from '@prisma-airs/desktop-contracts'
+import type { Dispatch } from '../../../features/tenants/dispatch'
+import { Btn } from './controls'
+
+interface Props {
+    context: ContextRef
+    project: HarnessProjectView | null
+    /** A folder just refused as the project. */
+    refused: string | null
+    /** A conversation is running (changing the project or access ends it). */
+    running: boolean
+    dispatch: Dispatch
+    onMessage: (message: string | null) => void
+}
+
+const REFUSED = 'Folders that hold system files, credentials or this app’s own data cannot be used.'
+
+/**
+ * The folder the Harness works in (C21, D048), as a v2 panel (C38): chosen
+ * in the native folder sheet, read-only unless the operator allows changes.
+ * Every command and file change still waits for the operator's approval,
+ * and the engine's sandbox keeps both inside the folder.
+ */
+export function ProjectPanel({ context, project, refused, running, dispatch, onMessage }: Props) {
+    const ids = useId()
+    const [busy, setBusy] = useState(false)
+
+    async function send(intent: Parameters<Dispatch>[0]) {
+        onMessage(null)
+        setBusy(true)
+        try {
+            const outcome = await dispatch(intent)
+            if (outcome.kind !== 'admitted') onMessage(`That was not done. ${REFUSED}`)
+        } finally {
+            setBusy(false)
+        }
+    }
+
+    return (
+        <section aria-labelledby={`${ids}-heading`} className='flex flex-col gap-2 rounded-[12px] border p-3' style={{ borderColor: 'var(--v2-rule)' }} data-slot='harness-project'>
+            <h2 id={`${ids}-heading`} className='text-[13px] font-bold'>
+                Project folder
+            </h2>
+            {project ? (
+                <>
+                    <p className='font-mono text-[12px] break-all' data-slot='harness-project-path'>
+                        {project.path}
+                    </p>
+                    <label className='flex items-start gap-2 text-[13px]'>
+                        <input
+                            type='checkbox'
+                            className='mt-[3px] size-4 min-h-0'
+                            checked={project.write}
+                            disabled={busy}
+                            aria-describedby={`${ids}-write`}
+                            onChange={(event) => void send({ kind: 'setHarnessWrite', context, write: event.target.checked })}
+                        />
+                        Allow changes in this folder
+                    </label>
+                    <p id={`${ids}-write`} className='text-[12px]' style={{ color: 'var(--v2-faint)' }}>
+                        {project.write
+                            ? 'The Harness may ask to run commands and change files here. Each waits for your approval and stays inside this folder.'
+                            : 'Read-only: the Harness may ask to run commands here, each with your approval, but cannot change anything.'}
+                    </p>
+                </>
+            ) : (
+                <p className='text-[13px]' style={{ color: 'var(--v2-faint)' }}>
+                    No folder. The Harness can use this app’s own read tools and propose changes for your review, but cannot run commands.
+                </p>
+            )}
+            {refused ? (
+                <p role='alert' className='text-[13px] break-all' style={{ color: 'var(--v2-flag)' }} data-slot='harness-project-refused'>
+                    {`${refused} cannot be used. ${REFUSED}`}
+                </p>
+            ) : null}
+            {running ? (
+                <p className='text-[12px]' style={{ color: 'var(--v2-faint)' }}>
+                    Changing the folder or its access ends the running conversation.
+                </p>
+            ) : null}
+            <div className='flex flex-wrap gap-2'>
+                <Btn disabled={busy} onClick={() => void send({ kind: 'chooseHarnessProject', context })}>
+                    {project ? 'Choose another folder…' : 'Choose a folder…'}
+                </Btn>
+                {project ? (
+                    <Btn tier='tertiary' disabled={busy} onClick={() => void send({ kind: 'clearHarnessProject', context })}>
+                        Remove folder
+                    </Btn>
+                ) : null}
+            </div>
+        </section>
+    )
+}
diff --git a/apps/desktop/src/v2/harness/panels/sign-in.tsx b/apps/desktop/src/v2/harness/panels/sign-in.tsx
