/** Harness copy (C32, screens/harness.md). */
export const HARNESS_COPY = {
    title: 'Harness',
    engineReady: (version: string) => `Engine ${version}`,
    engineMissing: 'Engine not available on this Mac',
    noWorkspace: 'No Gateway workspace chosen',
    prerequisites: 'Before you start',
    prerequisitesNote: 'The Harness runs on this Mac and answers through your AI Gateway workspace. It needs each of these.',
    done: 'Done',
    needed: 'Needed',
    tenant: 'A tenant',
    management: 'Its management client',
    workspace: 'A Gateway workspace',
    credential: 'The workspace key or your company sign-in',
    openSettings: 'Open Settings',
    chooseWorkspace: 'Choose in Administration',
    conversations: 'Conversations',
    newInvestigation: 'New investigation',
    untitled: 'New conversation',
    ended: 'Ended',
    phase: {
        starting: 'Starting',
        ready: 'Ready',
        answering: 'Answering',
        interrupting: 'Stopping',
        renewing: 'Renewing sign-in',
        confirmWrite: 'Waiting for you',
        ending: 'Ending',
        ended: 'Ended',
        failed: 'Failed',
    } as Record<string, string>,
    savedNone: 'No saved conversations in this workspace yet.',
    // The board (R2App start=harness, C38).
    savedLabel: 'Saved conversations · encrypted',
    noneFor: (tenant: string) => `No conversations yet for ${tenant}.`,
    decisions: 'Decisions',
    nothingToDecide: 'Nothing to decide yet. Tool calls appear here and wait for your OK.',
    pendingLine: (n: number) => (n === 1 ? 'Your OK is needed for a tool call →' : `Your OK is needed for ${n} tool calls →`),
    mcpHeading: (on: number, total: number) => `Workspace MCP servers · ${on} of ${total}`,
    mcpUnread: 'Workspace MCP servers · not read yet',
    mcpReading: 'Workspace MCP servers · reading…',
    mcpFailed: (why: string) => `Workspace MCP servers · could not be read: ${why}`,
    mcpPartial: 'only the first 500 servers were read',
    mcpMore: (hidden: number) => `${hidden} more in the setup below`,
    placeholder: 'Ask the Harness…',
    transcript: 'Transcript',
    empty: 'Ask a question about this tenant. Each answer comes from your AI Gateway workspace; changes are only ever proposed for your review.',
    role: {
        operator: 'You',
        assistant: 'Harness',
        command: 'Command',
        fileChange: 'File change',
        tool: 'Desktop read',
        mcp: 'Workspace MCP tool',
    } as Record<string, string>,
    entryState: {
        streaming: 'in progress',
        interrupted: 'stopped before it finished',
        truncated: 'cut at 256 KiB',
        failed: 'failed',
        declined: 'Declined',
    } as Record<string, string>,
    decision: 'Decision needed',
    kind: {
        desktopRead: 'read the tenant with',
        command: 'run the command',
        fileChange: 'change the files',
        mcpTool: 'run the workspace MCP tool',
    } as Record<string, string>,
    asks: (kind: string, what: string) => `The Harness asks to ${kind} ${what}`,
    inFolder: (cwd: string) => `In ${cwd}`,
    readOnlyWord: 'Read-only',
    mayChangeWord: 'May change things',
    readOnlyNote: {
        desktopRead: 'The desktop reads this tenant for the Harness and changes nothing. Approving runs this read once.',
        command: 'The project folder is read-only for this conversation, so the command cannot change it. Approving runs it once.',
    } as Record<string, string>,
