import type { ButtonHTMLAttributes, InputHTMLAttributes } from 'react'

/** The prototype's 32px controls (R2App): a primary accent button, a bordered secondary, a plain tertiary. */
export function Btn({ tier = 'secondary', className = '', style, ...rest }: ButtonHTMLAttributes<HTMLButtonElement> & { tier?: 'primary' | 'secondary' | 'tertiary' }) {
    const look =
        tier === 'primary'
            ? { background: 'var(--v2-acc)', color: 'var(--v2-acc-ink)', border: 0 }
            : tier === 'secondary'
              ? { background: 'var(--v2-paper)', color: 'var(--v2-ink)', border: '1px solid var(--v2-rule)' }
              : { background: 'transparent', color: 'var(--v2-soft)', border: '1px solid var(--v2-rule)' }
    return (
        <button
            type='button'
            {...rest}
            className={`flex h-8 min-h-0 items-center justify-center rounded-[7px] px-3 text-[12px] whitespace-nowrap disabled:cursor-not-allowed disabled:opacity-60 ${tier === 'primary' ? 'font-semibold' : ''} ${className}`}
            style={{ ...look, ...style }}
        />
    )
}

/** A 32px text field with the prototype's control border. */
export function Field({ className = '', style, ...rest }: InputHTMLAttributes<HTMLInputElement>) {
    return (
        <input
            {...rest}
            className={`h-8 min-h-0 rounded-[7px] border px-2.5 text-[13px] ${className}`}
            style={{ borderColor: 'var(--v2-ctl)', background: 'var(--v2-paper)', color: 'var(--v2-ink)', ...style }}
        />
    )
}
import { useId, useState } from 'react'
import type { ContextRef, HarnessProjectView } from '@prisma-airs/desktop-contracts'
import type { Dispatch } from '../../../features/tenants/dispatch'
import { Btn } from './controls'

interface Props {
    context: ContextRef
    project: HarnessProjectView | null
    /** A folder just refused as the project. */
    refused: string | null
    /** A conversation is running (changing the project or access ends it). */
    running: boolean
    dispatch: Dispatch
    onMessage: (message: string | null) => void
}

const REFUSED = 'Folders that hold system files, credentials or this app’s own data cannot be used.'

/**
 * The folder the Harness works in (C21, D048), as a v2 panel (C38): chosen
 * in the native folder sheet, read-only unless the operator allows changes.
 * Every command and file change still waits for the operator's approval,
 * and the engine's sandbox keeps both inside the folder.
 */
export function ProjectPanel({ context, project, refused, running, dispatch, onMessage }: Props) {
    const ids = useId()
    const [busy, setBusy] = useState(false)

    async function send(intent: Parameters<Dispatch>[0]) {
        onMessage(null)
        setBusy(true)
        try {
            const outcome = await dispatch(intent)
            if (outcome.kind !== 'admitted') onMessage(`That was not done. ${REFUSED}`)
        } finally {
            setBusy(false)
        }
    }

    return (
        <section aria-labelledby={`${ids}-heading`} className='flex flex-col gap-2 rounded-[12px] border p-3' style={{ borderColor: 'var(--v2-rule)' }} data-slot='harness-project'>
            <h2 id={`${ids}-heading`} className='text-[13px] font-bold'>
                Project folder
            </h2>
            {project ? (
                <>
                    <p className='font-mono text-[12px] break-all' data-slot='harness-project-path'>
                        {project.path}
                    </p>
                    <label className='flex items-start gap-2 text-[13px]'>
                        <input
                            type='checkbox'
                            className='mt-[3px] size-4 min-h-0'
                            checked={project.write}
                            disabled={busy}
                            aria-describedby={`${ids}-write`}
                            onChange={(event) => void send({ kind: 'setHarnessWrite', context, write: event.target.checked })}
                        />
                        Allow changes in this folder
                    </label>
                    <p id={`${ids}-write`} className='text-[12px]' style={{ color: 'var(--v2-faint)' }}>
                        {project.write
                            ? 'The Harness may ask to run commands and change files here. Each waits for your approval and stays inside this folder.'
                            : 'Read-only: the Harness may ask to run commands here, each with your approval, but cannot change anything.'}
                    </p>
                </>
            ) : (
                <p className='text-[13px]' style={{ color: 'var(--v2-faint)' }}>
                    No folder. The Harness can use this app’s own read tools and propose changes for your review, but cannot run commands.
                </p>
            )}
            {refused ? (
                <p role='alert' className='text-[13px] break-all' style={{ color: 'var(--v2-flag)' }} data-slot='harness-project-refused'>
                    {`${refused} cannot be used. ${REFUSED}`}
                </p>
            ) : null}
            {running ? (
                <p className='text-[12px]' style={{ color: 'var(--v2-faint)' }}>
                    Changing the folder or its access ends the running conversation.
                </p>
            ) : null}
            <div className='flex flex-wrap gap-2'>
                <Btn disabled={busy} onClick={() => void send({ kind: 'chooseHarnessProject', context })}>
                    {project ? 'Choose another folder…' : 'Choose a folder…'}
                </Btn>
                {project ? (
                    <Btn tier='tertiary' disabled={busy} onClick={() => void send({ kind: 'clearHarnessProject', context })}>
                        Remove folder
                    </Btn>
                ) : null}
            </div>
        </section>
    )
}
import { type FormEvent, useId, useState } from 'react'
import type { ContextRef, CredentialSource, HarnessSignInView, SelectedWorkspace } from '@prisma-airs/desktop-contracts'
import type { Dispatch, DispatchOutcome } from '../../../features/tenants/dispatch'
import { GENERIC_FAILURE, SIGN_IN_FAILURE_TEXT, SIGN_IN_NEEDS, SIGN_IN_STEP_TEXT, saveFailureText } from '../text'
import { Btn, Field } from './controls'

interface Props {
    context: ContextRef
    /** The chosen Gateway workspace; company sign-in is set up for one. */
    selected: SelectedWorkspace | null
    signIn: HarnessSignInView | null
    /** The workspace key is stored for the chosen workspace. */
    keyHere: boolean
    /** A conversation is running (changing the credential ends it). */
    running: boolean
    dispatch: Dispatch
    onMessage: (message: string | null) => void
}

/**
 * Which credential the Harness answers with (C20), as a v2 panel (C38): the
 * workspace inference key, or a company sign-in through the browser whose
 * Gateway token is renewed before it is sent.
 */
export function SignInPanel({ selected, ...rest }: Props) {
    return selected ? <WorkspaceSignIn selected={selected} {...rest} /> : <SignInUnavailable />
}

const faint = { color: 'var(--v2-faint)' }

/** With no workspace chosen, company sign-in is shown but cannot be set up yet. */
function SignInUnavailable() {
    const ids = useId()
    return (
        <section aria-labelledby={`${ids}-heading`} className='flex flex-col gap-3' data-slot='harness-sign-in-setup'>
            <h2 id={`${ids}-heading`} className='text-[13px] font-bold'>
                Company sign-in (SSO)
            </h2>
            <p className='text-[12px]' style={faint}>{`Answer with your company’s identity provider instead of a workspace inference key. ${SIGN_IN_NEEDS}`}</p>
            <Btn className='self-start' disabled aria-describedby={`${ids}-reason`}>
                Set up company sign-in
            </Btn>
            <p id={`${ids}-reason`} className='text-[12px]' style={faint} data-slot='harness-sign-in-reason'>
                Choose a Gateway workspace first
            </p>
        </section>
    )
}

function WorkspaceSignIn({ context, selected, signIn, keyHere, running, dispatch, onMessage }: Props & { selected: SelectedWorkspace }) {
    const ids = useId()
    const here = signIn !== null && signIn.workspace.id === selected.workspace.id
    const [editing, setEditing] = useState(false)
    const [busy, setBusy] = useState(false)
    const source: CredentialSource = here && signIn.selected ? 'companySignIn' : 'workspaceKey'

    async function send(intent: Parameters<Dispatch>[0], failureText: (outcome: DispatchOutcome) => string = () => GENERIC_FAILURE): Promise<boolean> {
        onMessage(null)
        setBusy(true)
        try {
            const outcome = await dispatch(intent)
            if (outcome.kind !== 'admitted') onMessage(failureText(outcome))
            return outcome.kind === 'admitted'
        } finally {
            setBusy(false)
        }
    }

    async function configure(event: FormEvent<HTMLFormElement>) {
        event.preventDefault()
        const first = !here
        const form = new FormData(event.currentTarget)
        const value = (name: string) => String(form.get(name) ?? '').trim()
        const saved = await send(
            {
                kind: 'configureHarnessSignIn',
                context,
                workspace: selected.reference,
                endpoint: value('endpoint'),
                issuer: value('issuer'),
                clientId: value('client'),
                audience: value('audience'),
            },
            saveFailureText
        )
        if (!saved) return
        setEditing(false)
        // Newly set up, company sign-in becomes the choice for new
        // conversations; signing in is still the operator's step. A running
        // conversation is left alone (changing the credential ends it).
        if (first && !running) await send({ kind: 'chooseHarnessCredential', context, source: 'companySignIn' })
    }

    const signedIn = here && signIn.account !== null
    const step = here ? signIn.step : null
    return (
        <section aria-labelledby={`${ids}-heading`} className='flex flex-col gap-3' data-slot='harness-credential'>
            <h2 id={`${ids}-heading`} className='text-[13px] font-bold'>
                Gateway credential
            </h2>
            {here ? (
                <fieldset className='flex flex-col gap-1' disabled={busy}>
                    <legend className='text-[13px] font-medium'>Answer with</legend>
                    {(
                        [
                            ['workspaceKey', 'The workspace inference key', keyHere ? 'Stored in AI Gateway' : 'Not stored for this workspace'],
                            ['companySignIn', 'Company sign-in', signedIn ? `Signed in as ${signIn.account}` : 'Not signed in'],
                        ] as const
                    ).map(([value, label, hint]) => (
                        <label key={value} className='flex min-h-9 cursor-pointer items-center gap-3'>
                            <input
                                type='radio'
                                name={`${ids}-source`}
                                value={value}
                                checked={source === value}
                                onChange={() => void send({ kind: 'chooseHarnessCredential', context, source: value })}
                                className='size-4 min-h-0'
                            />
                            <span className='flex flex-col'>
                                <span className='text-[13px]'>{label}</span>
                                <span className='text-[12px]' style={faint}>
                                    {hint}
                                </span>
                            </span>
                        </label>
                    ))}
                    {running ? (
                        <p className='text-[12px]' style={faint}>
                            Changing the credential ends the running conversation.
                        </p>
                    ) : null}
                </fieldset>
            ) : null}
            <h3 className='text-[13px] font-semibold'>Company sign-in (SSO)</h3>
            {!here && !editing ? (
                <>
                    <p className='text-[12px]' style={faint}>
                        {SIGN_IN_NEEDS}
                    </p>
                    <Btn className='self-start' onClick={() => setEditing(true)}>
                        Set up company sign-in
                    </Btn>
                </>
            ) : here && !editing ? (
                <div className='flex flex-col gap-2' data-slot='harness-sign-in'>
                    <dl className='grid grid-cols-[auto_1fr] gap-x-4 gap-y-1 text-[13px]'>
                        <dt style={faint}>Identity provider</dt>
                        <dd className='font-mono text-[12px] break-all'>{signIn.issuer}</dd>
                        <dt style={faint}>Client ID</dt>
                        <dd className='font-mono text-[12px] break-all'>{signIn.clientId}</dd>
                        <dt style={faint}>Gateway audience</dt>
                        <dd className='font-mono text-[12px] break-all'>{signIn.audience}</dd>
                        <dt style={faint}>Gateway endpoint</dt>
                        <dd className='font-mono text-[12px] break-all'>{signIn.endpoint}</dd>
                    </dl>
                    {step ? (
                        <p role='status' className='text-[13px]' data-slot='harness-sign-in-step'>
                            {SIGN_IN_STEP_TEXT[step]}
                        </p>
                    ) : null}
                    {signIn.failure ? (
                        <p role='alert' className='text-[13px]' style={{ color: 'var(--v2-flag)' }} data-slot='harness-sign-in-failure'>
                            {SIGN_IN_FAILURE_TEXT[signIn.failure]}
                        </p>
                    ) : null}
                    <div className='flex flex-wrap gap-2'>
                        {step ? (
                            <Btn onClick={() => void send({ kind: 'cancelHarnessSignIn', context })}>Cancel sign-in</Btn>
                        ) : (
                            <Btn tier='primary' disabled={busy} onClick={() => void send({ kind: 'signInHarness', context })}>
                                {signedIn ? 'Sign in again' : 'Sign in with your browser'}
                            </Btn>
                        )}
                        {signedIn ? (
                            <Btn disabled={busy} onClick={() => void send({ kind: 'signOutHarness', context })}>
                                Sign out
                            </Btn>
                        ) : (
                            <Btn tier='tertiary' disabled={busy || step !== null} onClick={() => setEditing(true)}>
                                Change identity provider
                            </Btn>
                        )}
                        <Btn tier='tertiary' disabled={busy} onClick={() => void send({ kind: 'removeHarnessSignIn', context })}>
                            Remove company sign-in
                        </Btn>
                    </div>
                </div>
            ) : (
                <form className='flex flex-col gap-2' onSubmit={(event) => void configure(event)} data-slot='harness-sign-in-form'>
                    <p className='text-[12px]' style={faint}>
                        {`Use your company’s identity provider for ${selected.workspace.name} instead of the workspace key. The Gateway token is a signed JWT verified against the provider’s keys, kept in memory, and renewed before it expires; only the refresh token is kept, in the Keychain.`}
                    </p>
                    <p className='text-[12px]' style={faint}>
                        The identity provider must allow loopback redirects to http://127.0.0.1 on any port (path /callback).
                    </p>
                    {(
                        [
                            ['endpoint', 'Gateway endpoint', here ? signIn.endpoint : '', 'https://'],
                            ['issuer', 'Identity provider (issuer URL)', here ? signIn.issuer : '', 'https://'],
                            ['client', 'Client ID', here ? signIn.clientId : '', ''],
                            ['audience', 'Gateway audience', here ? signIn.audience : '', ''],
                        ] as const
                    ).map(([name, label, value, placeholder]) => (
                        <label key={name} className='flex flex-col gap-1 text-[13px]'>
                            <span className='font-medium'>{label}</span>
                            <Field name={name} defaultValue={value} placeholder={placeholder} autoCapitalize='off' autoCorrect='off' spellCheck={false} required maxLength={2048} />
                        </label>
                    ))}
                    <div className='flex flex-wrap gap-2'>
                        <Btn type='submit' disabled={busy}>
                            Save company sign-in
                        </Btn>
                        <Btn tier='tertiary' onClick={() => setEditing(false)}>
                            Cancel
                        </Btn>
                    </div>
                </form>
            )}
        </section>
    )
}

