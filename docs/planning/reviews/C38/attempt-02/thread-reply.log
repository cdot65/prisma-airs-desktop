                                <label className='flex items-start gap-2 text-[13px] font-semibold'>
                                    <input
                                        type='checkbox'
                                        className='mt-[3px] size-4 min-h-0'
                                        checked={s.enabled}
                                        disabled={busy || !s.supported || (!s.enabled && on >= MCP_MAX_ON)}
                                        aria-describedby={`${ids}-${s.id}-standing`}
                                        onChange={(event) =>
