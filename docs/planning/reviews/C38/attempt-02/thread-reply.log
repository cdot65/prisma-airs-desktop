<div data-theme="{{theme}}" style="width: 1440px; height: 900px; position: relative; overflow: hidden; display: flex; background: {{t.bg}}; color: {{t.ink}}; font-family: -apple-system, BlinkMacSystemFont, 'SF Pro Text', system-ui, sans-serif; font-size: 13px; border-radius: 12px; box-sizing: border-box; border: 1px solid {{t.rule}};">

  <aside aria-label="Sidebar" aria-hidden="{{modalStr}}" style="width: 244px; flex-shrink: 0; display: flex; flex-direction: column; background: {{t.side}}; border-right: 1px solid {{t.rule}}; padding: 16px 10px 12px; box-sizing: border-box;">
    <div aria-hidden="true" style="display: flex; gap: 8px; padding: 2px 8px 16px;">
      <span style="width: 12px; height: 12px; border-radius: 50%; background: #ff5f57;"></span>
      <span style="width: 12px; height: 12px; border-radius: 50%; background: #febc2e;"></span>
      <span style="width: 12px; height: 12px; border-radius: 50%; background: #28c840;"></span>
    </div>
    <button onClick="{{toggleTenant}}" aria-haspopup="menu" aria-expanded="{{tenantOpenStr}}" aria-label="Tenant {{cur.name}} {{cur.env}}. Switch tenant" style="display: flex; align-items: center; gap: 10px; padding: 7px 8px; margin: 0 0 10px; border: 0; border-radius: 9px; background: {{tenantBtnBg}}; color: {{t.ink}}; font: inherit; text-align: left; cursor: pointer;">
      <span style="width: 34px; height: 34px; border-radius: 9px; background: {{cur.c}}; color: #ffffff; font-size: 13px; font-weight: 700; display: flex; align-items: center; justify-content: center; flex-shrink: 0;">{{cur.ini}}</span>
      <span style="flex-grow: 1; min-width: 0;"><span style="display: flex; align-items: center; gap: 5px; font-size: 14px; font-weight: 700;"><span style="white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">{{cur.name}}</span><svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" aria-hidden="true" style="flex-shrink: 0;"><path d="{{I.chev}}"></path></svg></span><span style="display: flex; align-items: center; gap: 5px; font-size: 12px; color: {{t.faint}};"><span style="width: 6px; height: 6px; border-radius: 50%; background: {{cur.envDot}};"></span>{{cur.env}} · {{cur.ws}}</span></span>
    </button>
    <nav aria-label="Destinations" style="display: flex; flex-direction: column; gap: 2px; flex-grow: 1; min-height: 0; overflow: hidden;">
      <sc-for list="{{nav}}" as="n" hint-placeholder-count="6">
        <div style="display: flex; flex-direction: column; gap: 1px;">
          <div style="display: flex; align-items: center; gap: 2px;">
            <button onClick="{{n.go}}" aria-current="{{n.cur}}" style="flex-grow: 1; display: flex; align-items: center; gap: 9px; height: 34px; padding: 0 10px; border: 0; border-radius: 8px; background: {{n.bg}}; color: {{n.fg}}; font: inherit; font-size: 13px; text-align: left; cursor: pointer;">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="{{n.icon}}"></path></svg>

