-    handle: AuthorityHandle,
-    session: String,
-    sequence: u64,
-    adapters: Handles,
-    history_root: PathBuf,
-}
-
-fn temp(name: &str) -> PathBuf {
-    let mut n = [0u8; 8];
-    getrandom::fill(&mut n).expect("fixture");
-    std::env::temp_dir()
-        .canonicalize()
-        .expect("fixture")
-        .join(format!("airs-v2-c23-{name}-{}", hex::encode(n)))
-}
