-    fn tsg_matches(&self, tsg: Option<&str>) -> Vec<TenantId> {
-        let Some(tsg) = tsg else {
-            return Vec::new();
-        };
-        self.data
-            .tenants
-            .iter()
-            .filter(|t| t.profile.tsg_id.as_deref() == Some(tsg))
-            .filter(|t| !self.v1_hides_tenant(&t.profile.id))
-            .map(|t| t.profile.id.clone())
-            .collect()
