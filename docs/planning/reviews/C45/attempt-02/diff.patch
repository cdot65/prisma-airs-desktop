-#[cfg(feature = "test-fixtures")]
-fn interrupted(inner: &Inner, point: CommitPoint) -> bool {
-    lock(inner)
-        .ok()
-        .is_some_and(|mut s| match &mut s.v1_import.interrupt_at {
-            Some((at, 0)) if *at == point => {
-                s.v1_import.interrupt_at = None;
-                true
-            }
-            Some((at, n)) if *at == point => {
-                *n -= 1;
-                false
-            }
-            _ => false,
-        })
-}
