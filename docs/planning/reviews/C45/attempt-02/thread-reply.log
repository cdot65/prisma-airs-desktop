ual minimum-size window; retired legacy decorative fade clearance was inapplicable to the one presentation. Require Tab reach and full actual window/WebView bounds, including negative clipping regressions. Preserve actual failed C04 raw and all16 repository/eight native passes; their runtime helper closures exclude C04. Retry affected C04 then unfinished queue. Same exact app, no rebuild or broad repeat.'\n    (base/marker_name).write_text(json.dumps(marker,indent=2)+'\\n');verify_native_continuation(root,base);return marker\n\nif __name__=='__main__':\n    import sys\n    print(json.dumps(prepare_native(Path.cwd().resolve(),frame=True) if sys.argv[1:]==['frame'] else prepare_native(Path.cwd().resolve(),adapter=True) if sys.argv[1:]==['adapter'] else (prepare_native if sys.argv[1:]==['native'] else prepare)(Path.cwd().resolve()),indent=2))\n\"\"\"Run a retained native driver on the C45 candidate without changing assertions.\n\nRun in the approved GUI context only. The legacy adapter and assertion-level\nrequirements are the same ones C44 used. Every record must name the exact C45\nprepared executable; raw records keep their original generated attribution.\n\"\"\"\nfrom pathlib import Path\nimport datetime\nimport hashlib\nimport importlib\nimport json\nimport os\nimport platform\nimport shutil\nimport subprocess\nimport sys\n\nROOT = Path.cwd().resolve()\nTOOLS = ROOT / 'tools/native-acceptance'\nsys.path.insert(0, str(TOOLS))\nsys.path.insert(0, str(ROOT / 'docs/planning/evidence/P09/native-controller'))\nfrom native_requirements import load_requirements, assess_record\n\n\ndef main():\n    which = sys.argv[1]\n    assert which in ['c03','c04','c05','c06','c07','c10','c11','c24','c31','c32',*[f'c{i}' for i in range(35,45)]]\n    legacy = len(sys.argv) > 2 and sys.argv[2] == 'legacy'\n    chunk = which.upper()\n    phase = ROOT / 'docs/planning/evidence/C45/baseline-03'\n    prepared = json.loads((phase / 'native-prepare.json').read_text())\n    exe = ROOT / prepared['bundle'] / 'Contents/MacOS/prisma-airs-desktop'\n    assert hashlib.sha256(exe.read_bytes()).hexdigest() == prepared['executable_sha256']\n    out = phase if chunk == 'C44' else phase / 'native/cumulative' / chunk\n    out.mkdir(parents=True, exist_ok=True)\n    record = out / 'native-acceptance.json'\n    assert not record.exists(), 'preserve earlier native records; archive explicitly before retry'\n    if chunk != 'C44':\n        shutil.copy2(phase / 'native-prepare.json', out / 'native-prepare.json')\n    if legacy:\n        importlib.import_module('legacy_v2')\n    driver_name = 'acceptance_c32_current' if chunk == 'C32' else f'acceptance_{which}'\n    if chunk == 'C32':\n        assert not legacy, 'C32 current driver uses the actual current presentation'\n        os.environ['AIRS_C32_EVIDENCE'] = str(out.relative_to(ROOT))\n    mod = importlib.import_module(driver_name)\n    original = str(mod.EVIDENCE)\n    # Only relocate evidence paths. Do not alter driver assertions, flows,\n    # timeouts, result values, provenance strings or the system capture folder.\n    for name in ['EVIDENCE', 'NATIVE', 'RECORD', 'PARITY']:\n        if hasattr(mod, name):\n            value = getattr(mod, name)\n            assert value == original or value.startswith(original + os.sep)\n            setattr(mod, name, str(out) + value[len(original):])\n    c29 = importlib.import_module('acceptance_c29')\n    c29.NATIVE = mod.NATIVE\n    if '--dry-run' in sys.argv[2:]:\n        required = load_requirements(ROOT)[chunk]\n        print(json.dumps({'subject':chunk,'mode':'paths only; no UI or driver execution',\n                          'evidence':str(out),'required_checks':sorted(required),\n                          'executable_sha256':prepared['executable_sha256']}))\n        return 0\n    os.environ['AIRS_NATIVE_PREPARE'] = str(phase / 'native-prepare.json')\n    os.environ['AIRS_NATIVE_PROCESS_RECORD'] = str(out / 'owned-processes.json')\n    started = datetime.datetime.now(datetime.timezone.utc).isoformat()\n    os.environ['AIRS_NATIVE_ORCHESTRATOR'] = 'Codex'\n    try:\n        code = mod.main()\n    finally:\n        import fixture_app as fx\n        fx.stop_app()\n        fx.stop_engines()\n    raw = json.loads(record.read_text())\n    errors, carried = assess_record(raw, ROOT, prepared['executable_sha256'], load_requirements(ROOT)[chunk])\n    execution = {'schema':'airs-v2/c45-native-execution/1','phase':'P10','driver_subject':chunk,\n                 'orchestrator':'Codex','started_utc':started,\n                 'finished_utc':datetime.datetime.now(datetime.timezone.utc).isoformat(),\n                 'source_root':str(ROOT),'source_head':subprocess.check_output(['git','rev-parse','HEAD'],text=True).strip(),\n                 'os':platform.platform(),'driver_return_code':code,\n                 'executable_sha256':prepared['executable_sha256'],\n                 'raw_record_sha256':hashlib.sha256(record.read_bytes()).hexdigest(),\n                 'controller_sha256':hashlib.sha256(Path(__file__).read_bytes()).hexdigest(),\n                 'requirements_sha256':hashlib.sha256((ROOT/'docs/planning/evidence/P09/native-controller/native_requirements.py').read_bytes()).hexdigest(),\n                 'driver_sha256':hashlib.sha256((TOOLS / (driver_name + '.py')).read_bytes()).hexdigest(),\n                 'required_check_errors':errors,'superseded_raw_checks':carried,\n                 'adaptation':'evidence paths relocated to C45; no assertion or result changes',\n                 'raw_attribution':'driver-generated performed_by retained; C43 reads the actual orchestrator from AIRS_NATIVE_ORCHESTRATOR'}\n    (out / 'execution.json').write_text(json.dumps(execution,indent=2)+'\\n')\n    print(json.dumps({'subject':chunk,'required_pass':not errors,'errors':errors,'carried':carried}))\n    return 1 if errors else 0\n\n\nif __name__ == '__main__':\n    raise SystemExit(main())\n","exit_code":0,"status":"completed"}}
