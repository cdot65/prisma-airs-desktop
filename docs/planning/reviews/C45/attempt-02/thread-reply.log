{"type":"item.completed","item":{"id":"item_52","type":"command_execution","command":"/bin/zsh -lc \"cat tools/native-acceptance/test_candidate_process.py && sed -n '248,310p' tools/native-acceptance/acceptance_c04.py && cat packages/desktop-contracts/src/generated/ShellSnapshot.ts && sed -n '1,120p' apps/desktop/src/app.tsx && sed -n '1,155p' apps/desktop/src/v2/v2-shell.tsx\"","aggregated_output":"\"\"\"Synthetic process-table tests: never launch or signal an OS process.\"\"\"\nimport json,plistlib,signal,sys,tempfile,unittest\nfrom pathlib import Path\nsys.path.insert(0,str(Path(__file__).resolve().parent))\nfrom candidate_process import Candidate,Identity,FIXTURE_ID,EXECUTABLE\nclass Processes:\n    def __init__(self):self.rows={};self.signals=[]\n    def snapshot(self,pid):return self.rows.get(pid)\n    def pids(self):return list(self.rows)\n    def send(self,pid,sig):self.signals.append((pid,sig))\nclass Ownership(unittest.TestCase):\n    def setUp(self):\n        self.temp=tempfile.TemporaryDirectory();self.root=Path(self.temp.name)/'Prisma AIRS Desktop Fixture.app'\n        p=self.root/'Contents/MacOS';p.mkdir(parents=True);(p/EXECUTABLE).write_text('synthetic executable')\n        (self.root/'Contents/Info.plist').write_bytes(plistlib.dumps({'CFBundleIdentifier':FIXTURE_ID,'CFBundleExecutable':EXECUTABLE}))\n        self.processes=Processes();self.candidate=Candidate(self.root,self.processes)\n    def tearDown(self):self.temp.cleanup()\n    def owned(self):\n        row=Identity(10,self.candidate.app_path,(123,456),1);self.processes.rows[10]=row;self.candidate.adopt_child(10,1);return row\n    def test_owned_exact_child_can_be_signaled(self):\n        self.owned();self.candidate.signal_app();self.assertEqual(self.processes.signals,[(10,signal.SIGTERM)])\n    def test_foreign_same_basename_old_namespace_and_regex_lookalike_are_not_signaled(self):\n        for path in ['/foreign/Prisma AIRS Desktop Fixture.app/Contents/MacOS/'+EXECUTABLE,'/old/Prisma AIRS Desktop v2 Fixture.app/Contents/MacOS/prisma-airs-desktop-v2',self.candidate.app_path.replace('Fixture.app','FixtureXapp')]:\n            self.processes.rows={11:Identity(11,path,(1,1),1)};self.candidate.signal_app()\n        self.assertEqual(self.processes.signals,[])\n    def test_unowned_same_candidate_is_not_adopted(self):\n        self.processes.rows[10]=Identity(10,self.candidate.app_path,(1,1),99)\n        with self.assertRaises(RuntimeError):self.candidate.app_pid()\n        self.assertEqual(self.processes.signals,[])\n    def test_reused_pid_cannot_be_signaled_even_with_same_path(self):\n        old=self.owned();self.processes.rows[10]=Identity(10,old.executable,(124,1),old.parent)\n        self.assertFalse(self.candidate.signal_identity(old,signal.SIGKILL));self.assertEqual(self.processes.signals,[])\n    def test_duplicate_candidate_processes_refuse_ui_and_cleanup(self):\n        self.owned();self.processes.rows[11]=Identity(11,self.candidate.app_path,(1,1),1)\n        with self.assertRaises(RuntimeError):self.candidate.app_pid()\n        self.assertEqual(self.processes.signals,[])\n    def test_engine_must_be_exact_owned_descendant(self):\n        self.owned();self.processes.rows.update({20:Identity(20,self.candidate.engine_path,(2,2),10),21:Identity(21,'/foreign/airs-harness',(2,3),10),22:Identity(22,self.candidate.engine_path,(2,4),99)})\n        self.assertEqual(self.candidate.engines(),[20]);self.candidate.stop_engines();self.assertEqual(self.processes.signals,[(20,signal.SIGKILL)])\n    def test_observed_engine_cleanup_survives_parent_exit_but_not_pid_reuse(self):\n        self.owned();engine=Identity(20,self.candidate.engine_path,(2,2),10);self.processes.rows[20]=engine;self.candidate.engines();del self.processes.rows[10];self.processes.rows[20]=Identity(20,engine.executable,engine.birth,1)\n        self.assertTrue(self.candidate.signal_engine(20));self.processes.rows[20]=Identity(20,engine.executable,(3,3),10)\n        self.assertFalse(self.candidate.signal_engine(20));self.assertEqual(self.processes.signals,[(20,signal.SIGKILL)])\n    def test_symlinked_engine_cannot_escape_the_bundle(self):\n        external=Path(self.temp.name)/'foreign-engine';external.write_text('foreign')\n        engine=self.root/'Contents/Resources/harness/airs-harness';engine.parent.mkdir(parents=True);engine.symlink_to(external)\n        with self.assertRaises(ValueError):Candidate(self.root,self.processes)\n        self.assertEqual(self.processes.signals,[])\n    def test_production_or_missing_bundle_is_rejected(self):\n        p=self.root/'Contents/Info.plist';p.write_bytes(plistlib.dumps({'CFBundleIdentifier':'io.cdot.airs-desktop','CFBundleExecutable':EXECUTABLE}))\n        with self.assertRaises(ValueError):Candidate(self.root,self.processes)\n        with self.assertRaises(FileNotFoundError):Candidate(self.root/'missing',self.processes)\nif __name__=='__main__':unittest.main()\n    # After Reset local data the one presentation shows the first-run wizard again (no Settings page to read the\n    # account status from): the wizard showing is the signed-out state here.\n    obs[\"reset_signed_out\"] = wait_account(app, \"Not signed in to Academy.\") or v2s.wizard_showing(app, timeout=5)\n    obs[\"academy_items_after_reset\"] = fx.keychain_accounts(ACADEMY_SERVICE)\n    trees = [os.path.join(NATIVE, n) for n in os.listdir(NATIVE) if n.startswith(\"tree-\")]\n    obs[\"secret_in_trees\"] = [rel(p) for p in trees if any(s in open(p).read() for s in SECRETS)]\n    obs[\"data_root_hits\"] = data_root_hits()\n    app.quit()\n    endpoint.stop()\n    obs[\"requests\"] = endpoint.requests()\n    shutil.rmtree(work, ignore_errors=True)\n    with open(os.path.join(NATIVE, \"observations.json\"), \"w\") as f:\n        json.dump({\"observations\": obs, \"log\": LOG}, f, indent=1)\n    return evaluate(prepared, obs)\n\n\ndef current_frame_clear(found, window, viewport):\n    \"\"\"The one presentation has no legacy fade; require full native bounds.\"\"\"\n    if not found or not viewport:\n        return False\n    for frame in (window, viewport):\n        for axis in (0, 1):\n            if found[\"pos\"][axis] < frame[\"pos\"][axis] - 1:\n                return False\n            if found[\"pos\"][axis] + found[\"size\"][axis] > frame[\"pos\"][axis] + frame[\"size\"][axis] + 1:\n                return False\n    return True\n\n\ndef reach(app, zoom):\n    \"\"\"Tab to the sign-in control and inspect the actual one-presentation frame.\n\n    The old 60 CSS px decorative fade belonged to the removed legacy shell.\n    This uses the same current-frame rule the retained legacy_v2 C08 adapter\n    already applies, with additional horizontal and WebView containment.\n    \"\"\"\n    found = None\n    tree = app.tree()\n    for _ in range(60):\n        app.keycode(48)\n        tree = app.tree()\n        focused = app.focused(tree)\n        if focused and focused.get(\"role\") == \"AXButton\" and focused.get(\"label\") in (\"Sign in again\", \"Sign in to Academy\"):\n            found = {\"label\": focused[\"label\"], \"pos\": focused[\"pos\"], \"size\": focused[\"size\"]}\n            break\n    window = next(node for node in tree if node.get(\"role\") == \"AXWindow\")\n    viewport = next((node for node in tree if node.get(\"role\") == \"AXWebArea\" and node.get(\"pos\") and node.get(\"size\")), None)\n    bounds = lambda node: {\"pos\": node[\"pos\"], \"size\": node[\"size\"]} if node else None\n    return {\"zoom\": zoom, \"window\": bounds(window), \"viewport\": bounds(viewport), \"found\": found,\n            \"clear\": current_frame_clear(found, window, viewport),\n            \"criterion\": \"keyboard-reached control fully inside actual window and WebView; one presentation has no legacy decorative bottom fade\"}\n\n\ndef evaluate(prepared, o):\n    inventory = {c[\"id\"]: c[\"check\"] for c in json.load(open(os.path.join(ROOT, \"docs/architecture/native-checks.json\")))[\"chunks\"][\"C04\"]}\n    obs_path = rel(os.path.join(NATIVE, \"observations.json\"))\n    checks = []\n\n    def add(cid, passed, observation, evidence):\n        checks.append({\"id\": cid, \"description\": inventory[cid], \"result\": \"pass\" if passed else \"fail\",\n                       \"observation\": observation, \"evidence\": [obs_path] + [e for e in evidence if e]})\n\n    add(\"C04-N01\", o[\"group\"] and o[\"keyboard_reached_sign_in\"],\n// This file was generated by [ts-rs](https://github.com/Aleph-Alpha/ts-rs). Do not edit this file manually.\nimport type { AcademyView } from \"./AcademyView\";\nimport type { ActiveContext } from \"./ActiveContext\";\nimport type { AdminInventoryView } from \"./AdminInventoryView\";\nimport type { CallView } from \"./CallView\";\nimport type { ChangesView } from \"./ChangesView\";\nimport type { DiagnosticsView } from \"./DiagnosticsView\";\nimport type { EndpointReviewView } from \"./EndpointReviewView\";\nimport type { FeatureEntry } from \"./FeatureEntry\";\nimport type { FeatureId } from \"./FeatureId\";\nimport type { GatewayView } from \"./GatewayView\";\nimport type { HarnessView } from \"./HarnessView\";\nimport type { InboxView } from \"./InboxView\";\nimport type { LearnerRef } from \"./LearnerRef\";\nimport type { LibraryView } from \"./LibraryView\";\nimport type { OfflineView } from \"./OfflineView\";\nimport type { OnboardingState } from \"./OnboardingState\";\nimport type { OverviewView } from \"./OverviewView\";\nimport type { ResetFailure } from \"./ResetFailure\";\nimport type { RotationView } from \"./RotationView\";\nimport type { ScanRecordView } from \"./ScanRecordView\";\nimport type { SessionsView } from \"./SessionsView\";\nimport type { SetupView } from \"./SetupView\";\nimport type { StorageHealth } from \"./StorageHealth\";\nimport type { SwitchBlocked } from \"./SwitchBlocked\";\nimport type { TenantView } from \"./TenantView\";\nimport type { Theme } from \"./Theme\";\nimport type { WorkbenchView } from \"./WorkbenchView\";\n\n/**\n * Redacted shell state.\n */\nexport type ShellSnapshot = { \n/**\n * Opaque, monotonically increasing revision (string-encoded u64).\n */\nrevision: string, appearance: Theme, \n/**\n * Which shell renders (C28, D058); `features` is that shell's catalogue.\n * First-run wizard state (C28/C29).\n */\nonboarding: OnboardingState, \n/**\n * The active destination (C28): what `navigate` last set, else the\n * presentation's first sidebar entry.\n */\nactiveFeature: FeatureId, \n/**\n * \"Show the calls\" preference (C28).\n */\nshowCalls: boolean, \n/**\n * The active tenant's recorded calls, newest last, while \"Show the\n * calls\" is on (C33); absent when it is off or no tenant is active.\n */\ncalls?: Array<CallView>, \n/**\n * A held tenant switch awaiting the operator's resolution (C30 raises\n * it; always absent in C28).\n */\nswitchBlocked: SwitchBlocked | null, \n/**\n * The tenant setup in progress (C29), with its draft and verification.\n */\nsetup: SetupView | null, features: Array<FeatureEntry>, \n/**\n * True only in the distinct test-fixtures identity.\n */\nfixtureBuild: boolean, storage: StorageHealth, tenants: Array<TenantView>, active: ActiveContext | null, endpointReview: EndpointReviewView | null, \n/**\n * The last reset stopped at this step. Scan keys were retired when it\n * started and must be entered again; other data stays until a reset\n * completes.\n */\nresetFailure: ResetFailure | null, \n/**\n * The last change was written but the OS did not confirm it durable.\n */\ndurabilityUnconfirmed: boolean, \n/**\n * The active tenant's scans this session, newest first.\n */\nscans: Array<ScanRecordView>, \n/**\n * The Academy learner account (independent of the tenant).\n */\nacademy: AcademyView, \n/**\n * The current learner generation: the signed-in account's, or a guest\n * generation for public catalog reads while signed out.\n */\nlearner: LearnerRef | null, \n/**\n * Academy web's origin, for public links Academy pages show (such as a\n * certificate's verify URL). The presentation never sends it back.\n */\nacademyOrigin: string, \n/**\n * The signed-in account's offline work: what is kept, its status and\n * whether Academy was last reachable (never content).\n */\nacademyOffline: OfflineView, \n/**\n * The active tenant's change review and applied changes (no secrets).\n */\nchanges: ChangesView, \n/**\n * The active tenant's FP/FN reports, investigation cache and exports.\n */\nsessions: SessionsView, \n/**\n * The active tenant's case Library.\n */\nlibrary: LibraryView, \n/**\n * The active context's Runtime Home/Inbox observations.\n */\noverview: OverviewView, \n/**\n * The Administration inventory (C31): static per build, published in\n * the v2 shell only (the legacy shell keeps its own fixed matrix and\n * literal snapshot).\n */\nadministration: AdminInventoryView | null, \n/**\n * The active tenant's Runtime key rotations (C31).\n */\nrotations: Array<RotationView>, \n/**\n * The active tenant's Inbox and read status (C30).\n */\ninbox: InboxView, \n/**\n * API Client projects on this Mac (C14).\n */\nworkbench: WorkbenchView, \n/**\n * The active context's Gateway workspaces and choice (C16).\n */\ngateway: GatewayView, harness: HarnessView, \n/**\n * Reviewed import of v1 work (C23).\n * Local redacted diagnostics (C24).\n */\ndiagnostics: DiagnosticsView, };\nimport { useCallback, useEffect, useLayoutEffect, useRef, useState } from 'react'\nimport {\n    DeliveryOutcomeUnknown,\n    type DesktopClient,\n    type FeatureId,\n    type Intent,\n    type MenuCommand,\n    type Refusal,\n    type ShellSnapshot,\n    type Theme,\n} from '@prisma-airs/desktop-contracts'\nimport { followAppearance } from './shell/appearance'\nimport { type DispatchOutcome, outcomeMessage } from './modules/tenants/dispatch'\nimport { V2Shell } from './v2/v2-shell'\nimport { Wizard } from './v2/wizard/wizard'\nimport { deliveryContext, useShellStore } from './v2/store'\nimport { SHELL_COPY } from './v2/copy'\nimport { forgetAcademyPresentation } from './modules/academy/presentation-storage'\nimport { SAVE_DOCUMENT_EVENT } from './v2/workbench/request-editor'\n\nexport function App({ client }: { client: DesktopClient }) {\n    const [snapshot, setSnapshot] = useState<ShellSnapshot | null>(null)\n    const snapshotRef = useRef<ShellSnapshot | null>(null)\n    snapshotRef.current = snapshot\n    const [failure, setFailure] = useState<string | null>(null)\n    const [pending, setPending] = useState(false)\n    const [status, setStatus] = useState('')\n\n    const dispatch = useCallback(\n        async (intent: Intent): Promise<DispatchOutcome> => {\n            try {\n                const response = await client.dispatch(intent)\n                return response.outcome === 'refusal'\n                    ? { kind: 'refused', refusal: response.refusal }\n                    : { kind: 'admitted', operation: response.receipt.operation }\n            } catch (error) {\n                return error instanceof DeliveryOutcomeUnknown ? { kind: 'unknown' } : { kind: 'failed' }\n            }\n        },\n        [client]\n    )\n\n    // v2 (C28): navigation is Rust-owned. The native menu, the sidebar and\n    // the palette all dispatch `navigate`; refusals reach the status surface.\n    const v2Navigate = useCallback(\n        async (feature: FeatureId) => {\n            useShellStore.getState().closePalette()\n            const intent: Intent = { kind: 'navigate', feature }\n            const outcome = await dispatch(intent)\n            if (outcome.kind === 'refused') useShellStore.getState().toast(SHELL_COPY.toastRefused('Navigation', outcome.refusal), 'warn')\n            // Unknown delivery is kept inline with Retry; never an expiring toast alone.\n            else if (outcome.kind === 'unknown') useShellStore.getState().addUnconfirmed('Navigation', intent)\n            else if (outcome.kind === 'failed') useShellStore.getState().toast(SHELL_COPY.toastFailed('Navigation'), 'warn')\n        },\n        [dispatch]\n    )\n    // Every v2 action's outcome reaches the shell's surfaces (DESIGN-V2 §7):\n    // a refusal or failed delivery as a warn toast naming what was asked, an\n    // unconfirmed delivery inline with Retry, never replayed on its own.\n    const v2Act = useCallback(\n        async (what: string, intent: Intent, quiet: Refusal[] = []): Promise<DispatchOutcome> => {\n            // A context-bound action speaks for the tenant it was sent in (I2).\n            const boundContext = deliveryContext(intent)\n            // A normal switch refusal still names its intended destination,\n            // but an uncertain switch must not offer Retry in another scope.\n            const retryContext = boundContext ?? (intent.kind === 'selectTenant' ? snapshotRef.current?.active?.context ?? null : null)\n            const bound = boundContext !== null ? (snapshotRef.current?.active?.tenant ?? null) : null\n            const outcome = await dispatch(intent)\n            if (outcome.kind === 'refused' && quiet.includes(outcome.refusal)) return outcome\n            if (outcome.kind === 'refused') useShellStore.getState().toast(SHELL_COPY.toastRefused(what, outcome.refusal, outcomeMessage(outcome)), 'warn', undefined, bound, boundContext)\n            else if (outcome.kind === 'unknown') useShellStore.getState().addUnconfirmed(what, intent, retryContext)\n            else if (outcome.kind === 'failed') useShellStore.getState().toast(SHELL_COPY.toastFailed(what), 'warn', undefined, bound, boundContext)\n            return outcome\n        },\n        [dispatch]\n    )\n    const v2Preference = useCallback(\n        async (what: string, intent: Intent, quiet: Refusal[] = []) => {\n            await v2Act(what, intent, quiet)\n        },\n        [v2Act]\n    )\n\n    const onMenu = useRef<(command: MenuCommand) => void>(() => undefined)\n    onMenu.current = (command: MenuCommand) => {\n        // Native navigation dismisses the modal palette first so focus can\n        // move to the new page heading instead of behind an open dialog.\n        if (command.kind === 'navigate') void v2Navigate(command.feature)\n        else if (command.kind === 'commandPalette') useShellStore.getState().openPalette()\n        // ⌘T: the tenant switcher opens; nothing switches until chosen.\n        else if (command.kind === 'tenantSwitcher') useShellStore.getState().setSwitcher(true)\n        // The open API Client request saves (its editor listens).\n        else if (command.kind === 'saveDocument') window.dispatchEvent(new Event(SAVE_DOCUMENT_EVENT))\n        else void v2Preference('The appearance change', { kind: 'setAppearance', theme: command.theme })\n    }\n\n    useEffect(() => {\n        let stop: (() => void) | undefined\n        let cancelled = false\n        client\n            .observeShell({\n                onSnapshot: (next) => {\n                    // The shell's scope follows the snapshot before it renders: a\n                    // notification for another tenant or context is never surfaced.\n                    useShellStore.getState().setScope(next.active?.tenant ?? null, next.active?.context ?? null, next.switchBlocked?.review ?? null)\n                    setSnapshot(next)\n                },\n                onMenu: (command) => onMenu.current(command),\n                onError: () => setFailure('The desktop sent an unexpected update.'),\n            })\n            .then(\n                (unsubscribe) => {\n                    if (cancelled) unsubscribe()\n                    else stop = unsubscribe\n                },\n                () => setFailure('The desktop shell could not be observed.')\n            )\n        return () => {\n            cancelled = true\n            stop?.()\nimport { useCallback, useEffect, useRef, useState, useSyncExternalStore } from 'react'\nimport type { AdminProductId, SwitchResolution, DesktopClient, FeatureId, Intent, ShellSnapshot, Theme } from '@prisma-airs/desktop-contracts'\nimport type { Dispatch } from '../modules/tenants/dispatch'\nimport { FeatureBody } from '../shell/feature-body'\nimport { type Act, Inbox } from './inbox/inbox'\nimport { Administration } from './admin/administration'\nimport { harnessCredential } from './harness/credential'\nimport { Harness } from './harness/harness'\nimport { FEATURE_GLYPHS, Glyph, PRODUCT_GLYPHS } from './icons'\nimport { HOME_COPY, SHELL_COPY, SNOOZE_COPY } from './copy'\nimport { readLine } from './home'\nimport { Home } from './home'\nimport { Palette } from './palette'\nimport { unconfirmedInContext, useShellStore } from './store'\nimport { SwitchGuard } from './switch-guard'\nimport { TenantSwitcher } from './tenant-switcher'\nimport { Toasts } from './toasts'\nimport { Modal, useModalsOpen } from './modal'\nimport { Wizard } from './wizard/wizard'\nimport { Academy } from './academy/academy'\nimport { ApiClient } from './workbench/api-client'\nimport { CallsPanel } from './workbench/calls-panel'\nimport { TestCases } from './workbench/test-cases'\n\n/** C44: the product destinations the catalogue still lists (Go, the palette), opened as Administration's products. */\nconst PRODUCT_DESTINATION: Record<'runtime' | 'gateway' | 'redTeam', { product: AdminProductId; sequence: number }> = { runtime: { product: 'runtimeSecurity', sequence: -1 }, gateway: { product: 'gateway', sequence: -2 }, redTeam: { product: 'redTeam', sequence: -3 } }\n\nexport interface V2ShellProps {\n    snapshot: ShellSnapshot\n    appearancePending: boolean\n    status: string\n    onNavigate: (id: FeatureId) => void\n    onSetAppearance: (theme: Theme) => void\n    onSetShowCalls: (on: boolean) => void\n    onSwitchTenant: (tenant: string, resolution?: SwitchResolution) => void\n    onReadNow: () => void\n    /** Re-sends a delivery the desktop did not confirm, only on the operator's click. */\n    onRetry: (what: string, intent: Intent) => void\n    /** Sends one intent and reports its outcome on the shell's surfaces (Home and Inbox actions). */\n    onAct: Act\n    dispatch: Dispatch\n    client: DesktopClient\n}\n\n/** The products the Inbox files entries under (the inventory's ids that have an admitted service). */\nconst productOf = (id: AdminProductId): string | null => (id === 'agenticIdentity' || id === 'agenticEndpoint' ? null : id)\n\nconst darkQuery = () => (typeof window !== 'undefined' && typeof window.matchMedia === 'function' ? window.matchMedia('(prefers-color-scheme: dark)') : null)\nconst subscribeDark = (notify: () => void) => {\n    const query = darkQuery()\n    if (!query) return () => undefined\n    query.addEventListener('change', notify)\n    return () => query.removeEventListener('change', notify)\n}\n// Without a media query the follower assumes dark (shell/appearance.ts): the toggle agrees with it.\nconst readDark = () => darkQuery()?.matches ?? true\n\n/**\n * Whether the shown appearance is dark: the choice, or the system's while\n * following it, re-read on every OS appearance change (C35 R2) so the\n * toggle's state and its next click follow what the follower applied.\n */\nfunction useShownDark(theme: Theme): boolean {\n    const systemDark = useSyncExternalStore(subscribeDark, readDark, readDark)\n    return theme === 'system' ? systemDark : theme === 'dark'\n}\n\n/**\n * The \"Refined Native\" shell as the prototype draws it (R2App, C35): a\n * 244px sidebar (tenant button, the Rust navigation inventory with the\n * Administration products as children and needs-action badges, the status\n * block) and a right column with the 56px header (title and subtitle, the\n * search button that opens the palette, the Explain switch, Ask Harness)\n * over the destination. Labels and ⌘ hints come from the same catalogue\n * the native menu is built from. Destinations not yet ported render the\n * legacy FeatureBody inside the page frame.\n */\nexport function V2Shell(props: V2ShellProps) {\n    const { snapshot } = props\n    const paletteOpen = useShellStore((s) => s.paletteOpen)\n    const openPalette = useShellStore((s) => s.openPalette)\n    const closePalette = useShellStore((s) => s.closePalette)\n    const adminNavOpen = useShellStore((s) => s.adminNavOpen)\n    const setAdminNav = useShellStore((s) => s.setAdminNav)\n    const unconfirmedAll = useShellStore((s) => s.unconfirmed)\n    // A captured null switch source is a scope too; only truly unbound actions survive (I2).\n    const unconfirmed = unconfirmedAll.filter((u) => unconfirmedInContext(u, snapshot.active?.context ?? null))\n    const clearUnconfirmed = useShellStore((s) => s.clearUnconfirmed)\n    const arrival = useShellStore((s) => s.arrival)\n    const modalOpen = useModalsOpen()\n    const heading = useRef<HTMLHeadingElement>(null)\n    const firstRender = useRef(true)\n    const [adding, setAdding] = useState(false)\n    // The sheet closes only when the wizard says so: a committed tenant (toast)\n    // or a discard the core admitted. Escape and the scrim are close requests\n    // the wizard answers with the same Cancel as its button.\n    const [closeRequests, setCloseRequests] = useState(0)\n    const closeSheet = (added?: string) => {\n        setAdding(false)\n        setCloseRequests(0)\n        if (added) useShellStore.getState().toast(SHELL_COPY.tenantAdded(added), 'ok')\n    }\n    const active = snapshot.activeFeature\n    const feature = snapshot.features.find((f) => f.id === active) ?? snapshot.features[0]\n    // Completion toasts are derived from the core's ReadStatus (I4): a new\n    // generation is one finished read; its kind follows the coverage. A\n    // tenant change re-baselines (the other tenant's generation is its own).\n    const read = snapshot.inbox.read\n    const tenantNow = snapshot.active?.tenant ?? null\n    const tenant = snapshot.tenants.find((t) => t.id === tenantNow) ?? null\n    const seenGeneration = useRef<{ tenant: string | null; generation: number }>({ tenant: tenantNow, generation: read.generation })\n    useEffect(() => {\n        const seen = seenGeneration.current\n        seenGeneration.current = { tenant: tenantNow, generation: read.generation }\n        if (seen.tenant !== tenantNow || read.generation === seen.generation) return\n        const tenant = snapshot.tenants.find((t) => t.id === tenantNow)\n        const line = readLine(snapshot, tenant?.label ?? null)\n        useShellStore.getState().toast(line.text, line.tone === 'allowed' ? 'ok' : 'warn', undefined, tenantNow, snapshot.active?.context ?? null)\n    }, [read.generation, tenantNow, snapshot])\n    // A snooze is announced once, from the receipt the core issues for it\n    // (I11): the return time is the core's, wherever the snooze was asked\n    // for. Holds a tenant already had, or a read rediscovers, are not news.\n    const lastSnooze = snapshot.inbox.lastSnooze\n    const seenSnooze = useRef<{ tenant: string | null; sequence: number }>({ tenant: tenantNow, sequence: lastSnooze?.sequence ?? 0 })\n    useEffect(() => {\n        const seen = seenSnooze.current\n        const sequence = lastSnooze?.sequence ?? 0\n        seenSnooze.current = { tenant: tenantNow, sequence }\n        if (seen.tenant !== tenantNow || !lastSnooze || sequence === seen.sequence) return\n        useShellStore.getState().toast(SNOOZE_COPY.toast(lastSnooze.title, lastSnooze.returnsAt), 'info', undefined, tenantNow, snapshot.active?.context ?? null)\n    }, [lastSnooze, tenantNow, snapshot.active])\n    // Presentation state follows its tenant (I2): an arrival another tenant\n    // asked for is forgotten, a toast that spoke for another tenant's item or\n    // read is retired (however long Reduce Motion would have kept it), and an\n    // unconfirmed delivery bound to a retired context is dropped (it can\n    // never be revived, let alone rebound).\n    const contextNow = snapshot.active?.context ?? null\n    useEffect(() => {\n        useShellStore.getState().scopeArrival(tenantNow)\n        useShellStore.getState().retireToasts(tenantNow)\n        useShellStore.getState().retireUnconfirmed(contextNow)\n    }, [tenantNow, contextNow])\n    // The guard for a switch asked here (I1); a setup draft's completion\n    // renders the same guard inside the wizard, which re-sends the completion.\n    const guard = snapshot.switchBlocked && !snapshot.switchBlocked.completion ? snapshot.switchBlocked : null\n    const guardTarget = guard ? snapshot.tenants.find((t) => t.id === guard.to)?.label ?? guard.to : null\n\n    useEffect(() => {\n        // Move focus to the new page heading after navigation (not on launch).\n        if (firstRender.current) {\n            firstRender.current = false\n            return\n        }\n        heading.current?.focus()\n    }, [active])\n","exit_code":0,"status":"completed"}}
