lification(root,root/standing[\"qualification\"][\"record\"],current=False)\n    99\t    request=read(root/\"docs/planning/reviews/P10\"/standing[\"attempt\"]/\"request.json\")\n   100\t    require(qualified == standing[\"qualification\"] == request[\"qualification\"] and request[\"predecessors\"][\"C45\"] == c45,\"P10 qualified candidate/member binding\")\n   101\t    return {\"p09\":p09,\"p10\":p10,\"c45\":c45,\"controller_complete\":False,\"c26_required_here\":False}\n   102\t\n   103\t\n   104\tif __name__ == \"__main__\":\n   105\t    require(len(sys.argv) == 2 and sys.argv[1] == \"release-prerequisites\", \"usage: review_gate.py release-prerequisites\")\n    12\tfrom phase_inputs import full_gate\n    13\t\n    14\t\n    15\tdef qualification(root,path,current=True):\n    16\t    record=read(path)\n    17\t    if record.get('schema')=='airs-desktop/c45-affected-followup/1':\n    18\t        from followup import verify as verify_followup\n    19\t        return {'record':str(path.relative_to(root)),'sha256':sha(path),'verified':verify_followup(root,record,current=current)}\n    20\t    from seal import verify_plan\n    21\t    verify_plan(root,read(bound(root,record['plan'])))\n    22\t    result=verify(root,record)\n    23\t    candidate=read(bound(root,record['candidate']))\n    24\t    verify_candidate(root,candidate)\n    25\t    if current:require(digest(source_inventory(root))==record['source_inventory_sha256'],'qualified source changed; declare and verify affected delta')\n    26\t    return {'record':str(path.relative_to(root)),'sha256':sha(path),'verified':result}\n    27\t\n    28\t\n    29\tdef prerequisites(root,subject):\n    44\t    require(source_inventory(root)==expected,'sealed source membership/content changed')\n    45\t    return digest(expected)\n    46\t\n    47\t\n    48\tdef verify_candidate(root, value):\n    49\t    prepared=read(root/value['prepare']['path'])\n    50\t    require(sha(root/value['prepare']['path'])==value['prepare']['sha256'],'preparation drift')\n    51\t    bundle=root/prepared['bundle']\n    52\t    require(sha(bundle/'Contents/MacOS/prisma-airs-desktop')==value['executable_sha256']==prepared['executable_sha256'],'candidate executable drift')\n    53\t    require(bundle_hash(bundle)==value['bundle_sha256']==prepared['bundle_sha256'],'complete candidate bundle drift')\n    54\t    for name,value_hash in value['helper_closure'].items():require(sha(root/name)==value_hash,'candidate helper drift: '+name)\n    55\t    if value.get('build_origin'):\n    56\t        import platform\n    57\t        origin=value['build_origin'];path=root/origin['record']\n    58\t        require(sha(path)==origin['sha256'],'build origin proof drift')\n    59\t        audit=verify_build_reuse(root,read(path),value['runner_inputs'],platform.platform(),platform.node())\n    60\t        require(audit==origin['audit'],'build reuse audit drift')\n    61\t    return value\n    83\t\n    84\tdef verify_build_reuse(root, record, current_identity, platform_name, hostname):\n    85\t    from qualification import bound\n    86\t    from stages import verify_completed\n    87\t    require(record['schema']=='airs-desktop/c45-helper-only-build-reuse/1','build reuse schema')\n    88\t    old=read(bound(root,record['original_candidate']))\n    89\t    before=read(bound(root,record['original_source']))['files']\n    90\t    after=read(bound(root,record['current_source']))['files']\n    91\t    changed=sorted(name for name in set(before)|set(after) if before.get(name)!=after.get(name))\n    92\t    require(changed==record['declared_changed_paths'] and set(changed)<=BUILD_REUSE_PATHS,'undeclared or application-affecting build-reuse delta')\n    93\t    require(source_inventory(root)==after,'current build-reuse source changed')\n    94\t    require(digest(before)==old['source_inventory_sha256'],'original source seal/candidate mismatch')\n    95\t    require(current_identity['dependencies']==old['runner_inputs']['dependencies'] and current_identity['build_flags']==old['runner_inputs']['build_flags'],'build dependency/toolchain/flags changed')\n    96\t    require(old['conditions']['platform']==platform_name and old['conditions']['hostname']==hostname,'build execution conditions changed')\n    97\t    state_path=bound(root,record['original_build_stage']);state=read(state_path)\n    98\t    verify_completed(root,state_path.parent,state,state['argv'],digest(before))\n    99\t    prepared=read(bound(root,old['prepare']));bundle=root/prepared['bundle']\n   100\t    require(sha(bundle/'Contents/MacOS/prisma-airs-desktop')==old['executable_sha256']==prepared['executable_sha256'],'retained executable changed')\n   101\t    require(bundle_hash(bundle)==old['bundle_sha256']==prepared['bundle_sha256'],'retained complete bundle changed')\n   102\t    return {'original_candidate_sha256':record['original_candidate']['sha256'],'original_build_stage_sha256':record['original_build_stage']['sha256'],'declared_helper_only_delta':changed,'executable_sha256':old['executable_sha256'],'bundle_sha256':old['bundle_sha256'],'new_build_executed':False,'meaning':'Exact unchanged application retained from actual baseline02 build; changed C45 selector and qualification provenance execute current affected verification.'}\n    45\t\n    46\tdef verify(root,record,current=True):\n    47\t    require(record['schema']=='airs-desktop/c45-affected-followup/1','followup schema')\n    48\t    baseline=read(bound(root,record['baseline_qualification']));base_result=verify_coverage(root,baseline)\n    49\t    old=read(bound(root,baseline['candidate']));candidate=read(bound(root,record['candidate']))\n    50\t    before=read(bound(root,record['source_before']))['files'];after=read(bound(root,record['source_after']))['files']\n    51\t    require(digest(before)==baseline['source_inventory_sha256']==old['source_inventory_sha256'],'baseline source binding')\n    52\t    source_delta(before,after,record['declared_changed_paths'])\n    53\t    require(digest(after)==candidate['source_inventory_sha256']==record['source_inventory_sha256'],'current followup source binding')\n    54\t    if current:require(source_inventory(root)==after,'followup current source drift')\n    55\t    # No historical source/helper hash is relabeled as current. The entire\n    56\t    # application/config/dependency tree outside the named delta is unchanged.\n    57\t    for key in ('executable_sha256','bundle_sha256','build_flags','conditions','dependency_fingerprint'):\n    58\t        require(candidate[key]==old[key],'followup app/build/conditions/dependencies changed: '+key)\n    59\t    require(set(candidate['helper_closure'])==set(old['helper_closure']),'runtime helper membership changed')\n    60\t    for name,value in old['helper_closure'].items():\n    61\t        if name not in META_ONLY:require(candidate['helper_closure'][name]==value==sha(root/name),'runtime helper changed: '+name)\n    62\t    verify_candidate(root,candidate)\n    63\t    checks=raw_checks(root,record['focused_run'],candidate['runner_inputs'])\n    64\t    for failure in record['old_red']:\n    65\t        path=bound(root,failure);require(failure['exit_code']==101 and 'test result: FAILED.' in path.read_text(),'causal original failure proof missing')\n    66\t    review=root/'docs/planning/reviews/C45/attempt-01'\n    67\t    for name,ref in record['actual_previous_review'].items():require(bound(root,ref)==review/name,'previous actual review binding')\n    68\t    audit=read(review/'post-review-audit.json');require(audit['scores']=={'architecture':9,'behavior':9,'authority_security':9,'validation':8,'overall':8} and audit['full_gate_pass'] is False,'actual previous review changed')\n    69\t    return {'qualified':True,'required':base_result['required']+len(COMMANDS),'baseline':base_result,'affected':checks,'source_inventory_sha256':digest(after),'candidate_sha256':record['candidate']['sha256'],'meaning':'Original baseline stays historical; named test/provenance-only delta, exact unchanged app/runtime helpers and new affected checks verified. No new native or baseline execution claimed.'}\n    let path = app\n        .path()\n        .app_data_dir()\n        .ok()?\n        .join(FIXTURE_MANAGEMENT_ORIGIN);\n    let text = std::fs::read_to_string(path).ok()?;\n    let origin = text.trim();\n    desktop_core::management::is_origin(origin).then(|| origin.to_owned())\n}\n\n#[cfg(all(target_os = \"macos\", not(feature = \"test-fixtures\")))]\nfn learner_store(_root: Option<&Path>) -> Arc<dyn CredentialStore> {\n    crate::keychain::KeychainStore::login_service(crate::keychain::ACADEMY_SERVICE)\n        .map(|k| Arc::new(k) as Arc<dyn CredentialStore>)\n        .unwrap_or_else(|_| Arc::new(UnavailableVault))\n}\n\n#[cfg(all(target_os = \"macos\", feature = \"test-fixtures\"))]\nfn learner_store(root: Option<&Path>) -> Arc<dyn CredentialStore> {\n    use crate::keychain::{FIXTURE_ACADEMY_SERVICE, Interaction, KeychainStore};\n    root.and_then(|dir| {\n        KeychainStore::file(\n            &dir.join(FIXTURE_KEYCHAIN),\n            FIXTURE_KEYCHAIN_PASSWORD,\n            FIXTURE_ACADEMY_SERVICE,\n            Interaction::Disallowed,\n        )\n        .ok()\n    })\n    .map(|k| Arc::new(k) as Arc<dyn CredentialStore>)\n    .unwrap_or_else(|| Arc::new(UnavailableVault))\n}\n\n#[cfg(not(target_os = \"macos\"))]\nfn learner_store(_root: Option<&Path>) -> Arc<dyn CredentialStore> {\n    Arc::new(UnavailableVault)\n}\n\n#[cfg(all(target_os = \"macos\", not(feature = \"test-fixtures\")))]\nfn credential_store(_root: Option<&Path>) -> Arc<dyn CredentialStore> {\n    crate::keychain::KeychainStore::login()\n        .map(|k| Arc::new(k) as Arc<dyn CredentialStore>)\n        .unwrap_or_else(|_| Arc::new(UnavailableVault))\n}\n\n/// The fixture keychain, for the fixture menu's lock/unlock items.\n#[cfg(all(target_os = \"macos\", feature = \"test-fixtures\"))]\npub static FIXTURE_STORE: std::sync::OnceLock<Arc<crate::keychain::KeychainStore>> =\n    std::sync::OnceLock::new();\n\n#[cfg(all(target_os = \"macos\", feature = \"test-fixtures\"))]\nfn credential_store(root: Option<&Path>) -> Arc<dyn CredentialStore> {\n    use crate::keychain::{FIXTURE_SCAN_SERVICE, Interaction, KeychainStore};\n    let store = root.and_then(|dir| {\n        KeychainStore::file(\n            &dir.join(FIXTURE_KEYCHAIN),\n            FIXTURE_KEYCHAIN_PASSWORD,\n            FIXTURE_SCAN_SERVICE,\n            Interaction::Disallowed,\n        )\n        .ok()\n    });\n    match store {\n        Some(store) => {\n            let store = Arc::new(store);\n            let _ = FIXTURE_STORE.set(Arc::clone(&store));\n            store\n        }\n        None => Arc::new(UnavailableVault),\n    }\n}\n\n#[cfg(not(target_os = \"macos\"))]\nfn credential_store(_root: Option<&Path>) -> Arc<dyn CredentialStore> {\n    Arc::new(UnavailableVault)\n}\n\n/// The fixture build's additional trust roots for the synthetic acceptance\n/// endpoint, read from `fixture-transport-roots.pem` in the fixture data root.\n/// Production builds have no such file or code path: they trust the OS store.\n#[cfg(feature = \"test-fixtures\")]\npub const FIXTURE_TRANSPORT_ROOTS: &str = \"fixture-transport-roots.pem\";\n\n/// The fixture transport policy, when the acceptance driver installed roots.\n                        // investigation was retired above).\n                        let _placement = crate::sessions::placement();\n                        for namespace in\n                            [&worker.adapters.keychain, &worker.adapters.learner_keychain]\n                        {\n                            namespace.purge().map_err(|reason| ResetFailure {\n                                stage: ResetStage::Credentials,\n                                reason,\n                            })?;\n                        }\n                        // Sealed investigations go with their keys (purged\n                        // above), and report files with the tenants.\n                        if let Some(root) = &worker.adapters.sessions_root {\n                            match std::fs::remove_dir_all(root) {\n                                Ok(()) => {}\n                                Err(e) if e.kind() == std::io::ErrorKind::NotFound => {}\n                                Err(_) => {\n                                    return Err(ResetFailure {\n                                        stage: ResetStage::Document,\n                                        reason: VaultError::Unavailable,\n                                    });\n                                }\n                            }\n                        }\n                        // The API Client's private folder (sealed profile and\n                        // the built-in collection) goes with its key too;\n                        // collections in the operator's folders stay.\n                        if let Some(root) = &worker.adapters.workbench_root {\n                            match std::fs::remove_dir_all(root) {\n                                Ok(()) => {}\n                                Err(e) if e.kind() == std::io::ErrorKind::NotFound => {}\n                                Err(_) => {\n                                    return Err(ResetFailure {\n                                        stage: ResetStage::Document,\n                                        reason: VaultError::Unavailable,\n                                    });\n                                }\n                            }\n                        }\n                        // Sealed case libraries go with their keys too.\n                        if let Some(root) = &worker.adapters.library_root {\n                            match std::fs::remove_dir_all(root) {\n                                Ok(()) => {}\n                                Err(e) if e.kind() == std::io::ErrorKind::NotFound => {}\n                                Err(_) => {\n                                    return Err(ResetFailure {\n                                        stage: ResetStage::Document,\n                                        reason: VaultError::Unavailable,\n                                    });\n                                }\n                            }\n                        }\n                        // Harness history goes with its keys (purged above).\n                        if let Some(root) = &worker.adapters.harness.history_root {\n                            match std::fs::remove_dir_all(root) {\n                                Ok(()) => {}\n                                Err(e) if e.kind() == std::io::ErrorKind::NotFound => {}\n                                Err(_) => {\n                                    return Err(ResetFailure {\n                                        stage: ResetStage::Document,\n                                        reason: VaultError::Unavailable,\n                                    });\n                                }\n                            }\n                        }\n                        // Diagnostics go with the data (D051).\n                        if !worker.diagnostics.purge() {\n                            return Err(ResetFailure {\n                                stage: ResetStage::Document,\n                                reason: VaultError::Unavailable,\n                            });\n                        }\n                        // Offline work goes with its keys (purged above).\n                        if let Some(root) = &worker.adapters.offline_root {\n                            crate::offline::purge(root).map_err(|_| ResetFailure {\n                                stage: ResetStage::Document,\n                                reason: VaultError::Unavailable,\n                            })?;\n                        }\n                        match worker.adapters.store.reset() {\n                            Ok(()) => Ok(false),\n                            Err(StoreError::Unconfirmed) => Ok(true),\n                            Err(_) => Err(ResetFailure {\n                                stage: ResetStage::Document,\n                                reason: VaultError::Unavailable,\n                            }),\n                        }\n                    })\n                    .await\n                    .unwrap_or(Err(ResetFailure {\n                        stage: ResetStage::Credentials,\n                        reason: VaultError::Unavailable,\n                    }));\n                    settle_reset(&inner, result);\n                });\n            }\n        }\n    }\n}\n\nfn complete_operation(\n    inner: &Arc<Inner>,\n    id: &OperationId,\n    outcome: Outcome,\n    stop: Option<StopReason>,\n) {\n","exit_code":0,"status":"completed"}}
