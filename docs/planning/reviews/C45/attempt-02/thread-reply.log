lem'\n-export type { ReceiptItemView } from './generated/ReceiptItemView'\n-export type { ReceiptState } from './generated/ReceiptState'\n-export type { ReceiptView } from './generated/ReceiptView'\n-export type { SourceState } from './generated/SourceState'\n-export type { TargetChoice } from './generated/TargetChoice'\n-export type { TenantTarget } from './generated/TenantTarget'\n-export type { V1ImportView } from './generated/V1ImportView'\n-export type { V1TenantChoice } from './generated/V1TenantChoice'\n export type { DiagnosticsClear } from './generated/DiagnosticsClear'\n export type { DiagnosticsExport } from './generated/DiagnosticsExport'\n export type { DiagnosticsView } from './generated/DiagnosticsView'\n/** What the scan form is filled with (a Runtime case or a starter). */\nexport interface CasePrefill {\n    name: string\n    profile: string\n    prompt: string\n    response: string\n    appName: string\n    /** Shown as the loaded case's goal; never a verdict. */\n    expected: string\n    /** A new value remounts the scan form with these fields. */\n    nonce: number\n}\n\nimport { forwardRef, useCallback } from 'react'\nimport type { DesktopClient, FeatureEntry, FeatureId, ShellSnapshot, Theme } from '@prisma-airs/desktop-contracts'\nimport { SessionsView } from '../modules/sessions/sessions-view'\nimport type { Dispatch } from '../modules/tenants/dispatch'\nimport { SettingsView, UnavailableView } from './feature-view'\n\nexport interface FeatureBodyProps {\n    feature: FeatureEntry\n    snapshot: ShellSnapshot\n    appearancePending: boolean\n    onSetAppearance: (theme: Theme) => void\n    onNavigate: (id: FeatureId) => void\n    dispatch: Dispatch\n    /** The native client, for management observations. */\n    client: DesktopClient\n}\n\n/**\n * The destinations the v2 shell frames without a board of their own (C44):\n * Settings, Sessions & Reports and the reviewed v1 import, keyed by the\n * active context where a view must never outlive its credential. Every\n * other destination is a v2 screen; the legacy shell and its views are gone.\n */\nexport const FeatureBody = forwardRef<HTMLHeadingElement, FeatureBodyProps>(function FeatureBody(props, heading) {\n    const { feature, snapshot } = props\n    const client = props.client\n    const observeManagement = useCallback((operation: string) => client.observeManagement(operation), [client])\n    return (\n        <>\n            {feature.id === 'settings' ? (\n                <SettingsView\n                    ref={heading}\n                    snapshot={snapshot}\n                    pending={props.appearancePending}\n                    onSetAppearance={props.onSetAppearance}\n                    dispatch={props.dispatch}\n                    observeManagement={observeManagement}\n                />\n            ) : feature.id === 'sessions' && feature.availability.state === 'available' ? (\n                <SessionsView\n                    // A new tenant or management credential remounts the view:\n                    // revealed content never outlives its credential.\n                    key={snapshot.active?.context ?? 'none'}\n                    ref={heading}\n                    snapshot={snapshot}\n                    dispatch={props.dispatch}\n                    observe={observeManagement}\n                    onNavigate={props.onNavigate}\n                />\n            ) : (\n                <UnavailableView ref={heading} feature={feature} />\n            )}\n        </>\n    )\n})\nimport { forwardRef, useId, useState } from 'react'\nimport { Button, Callout } from '@ai-security-academy/presentation'\nimport { Info } from 'lucide-react'\nimport type { FeatureEntry, Intent, ShellSnapshot, Theme } from '@prisma-airs/desktop-contracts'\nimport { type Dispatch, outcomeMessage } from '../modules/tenants/dispatch'\nimport { DiagnosticsPanel } from '../modules/diagnostics/diagnostics-panel'\nimport { AcademyAccount } from '../modules/academy/academy-account'\nimport { TenantsSettings } from '../modules/tenants/tenants-settings'\nimport type { ObserveManagement } from '../modules/administration/management-read'\n\ninterface HeadingProps {\n    id: string\n    kicker: string\n    title: string\n}\n\n/** Page heading that receives focus after navigation (tabIndex -1). */\nexport const PageHeading = forwardRef<HTMLHeadingElement, HeadingProps>(function PageHeading({ id, title }, ref) {\n    return (\n        <header className='mb-4 flex flex-col gap-1' data-slot='page-header'>\n            <h1 ref={ref} id={id} tabIndex={-1} data-slot='page-heading' className='font-bold outline-none' style={{ fontSize: 'var(--v2-title)' }}>\n                {title}\n            </h1>\n        </header>\n    )\n})\n\nexport const UnavailableView = forwardRef<HTMLHeadingElement, { feature: FeatureEntry }>(function UnavailableView({ feature }, ref) {\n    const planned = feature.availability.state === 'unavailable' ? feature.availability.plannedChunk : ''\n    return (\n        <section aria-labelledby={`${feature.id}-heading`} data-slot='feature-unavailable'>\n            <PageHeading ref={ref} id={`${feature.id}-heading`} kicker='Not available' title={feature.label} />\n            <Callout tone='default' icon={Info}>\n                <p>\n                    {feature.label} is not available in this build. Nothing here contacts a Prisma AIRS\n                    tenant or the Academy.\n                </p>\n                <p className='text-academy-ink-faint mt-2 font-mono text-[11px] tracking-[0.12em] uppercase'>\n                    Planned in {planned}\n                </p>\n            </Callout>\n        </section>\n    )\n})\n\nconst THEMES: { value: Theme; label: string; hint: string }[] = [\n    { value: 'system', label: 'Match System', hint: 'Follow the macOS appearance' },\n    { value: 'light', label: 'Light', hint: 'Paper light theme' },\n    { value: 'dark', label: 'Dark', hint: 'Gruvbox dark theme' },\n]\n\ninterface SettingsProps {\n    snapshot: ShellSnapshot\n    pending: boolean\n    onSetAppearance: (theme: Theme) => void\n    dispatch: Dispatch\n    observeManagement: ObserveManagement\n}\n\nexport const SettingsView = forwardRef<HTMLHeadingElement, SettingsProps>(function SettingsView(\n    { snapshot, pending, onSetAppearance, dispatch, observeManagement },\n    ref\n) {\n    const legend = useId()\n    const appearance = snapshot.appearance\n    return (\n        <section aria-labelledby='settings-heading' data-slot='settings'>\n            <PageHeading ref={ref} id='settings-heading' kicker='Desktop' title='Settings' />\n            <fieldset aria-labelledby={legend} aria-busy={pending} className='border-academy-rule flex flex-col gap-3 rounded-[12px] border p-5'>\n                <legend id={legend} className='text-academy-ink px-1 text-[15px] font-semibold'>\n                    Appearance\n                </legend>\n                <p className='text-academy-ink-soft text-[13px]'>\n                    A desktop-wide preference. It does not change your Academy account settings.\n                </p>\n                {THEMES.map((option) => (\n                    <label key={option.value} className='flex min-h-11 cursor-pointer items-center gap-3'>\n                        <input\n                            type='radio'\n                            name='appearance'\n                            value={option.value}\n                            checked={appearance === option.value}\n                            onChange={() => onSetAppearance(option.value)}\n                            className='accent-[var(--academy-accent)] size-4'\n                        />\n                        <span className='flex flex-col'>\n                            <span className='text-academy-ink text-[14px] font-medium'>{option.label}</span>\n                            <span className='text-academy-ink-faint text-[12px]'>{option.hint}</span>\n                        </span>\n                    </label>\n                ))}\n            </fieldset>\n            <div className='mt-6'>\n                <AcademyAccount view={snapshot.academy} dispatch={dispatch} />\n            </div>\n            <div className='mt-6'>\n                <TenantsSettings snapshot={snapshot} dispatch={dispatch} observeManagement={observeManagement} />\n            </div>\n            <div className='mt-6'>\n                <DiagnosticsPanel view={snapshot.diagnostics} dispatch={dispatch} />\n            </div>\n        </section>\n    )\n})\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_35","type":"command_execution","command":"/bin/zsh -lc \"sed -n '1,330p' apps/desktop/src-tauri/src/adapters.rs && sed -n '1050,1150p' apps/desktop/src-tauri/src/adapters.rs && sed -n '1,220p' apps/desktop/src-tauri/src/keychain.rs && sed -n '5450,5575p' crates/desktop-core/src/authority.rs\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_35","type":"command_execution","command":"/bin/zsh -lc \"sed -n '1,330p' apps/desktop/src-tauri/src/adapters.rs && sed -n '1050,1150p' apps/desktop/src-tauri/src/adapters.rs && sed -n '1,220p' apps/desktop/src-tauri/src/keychain.rs && sed -n '5450,5575p' crates/desktop-core/src/authority.rs\"","aggregated_output":"//! Production OS adapters for the core: the Rust-owned data store, the\n//! Keychain credential store and the native profile-import sheet.\n//!\n//! The data root is the OS application-data directory for this build's\n//! bundle identifier (`io.cdot.airs-desktop`, or `.fixture` in the\n//! fixture build), never a v1 directory. Fixture builds keep credentials in a\n//! dedicated test keychain inside that root under the fixture namespace, with\n//! OS prompts disabled so failures are deterministic; production uses the\n//! login Keychain. An adapter that cannot be opened is replaced by one that\n//! reports `Unavailable`; there is no fallback to plaintext or another store.\n\nuse std::io::Read;\nuse std::path::{Path, PathBuf};\nuse std::sync::Arc;\n\nuse desktop_core::ImportError;\nuse desktop_core::avatar::MAX_SOURCE_BYTES;\n/// A bounded generic file read; current collection formats are unchanged.\nconst MAX_PICKED_FILE_BYTES: usize = 1024 * 1024;\nuse desktop_core::store::{AppStore, FileStore, UnavailableStore};\nuse desktop_core::vault::UnavailableVault;\nuse desktop_core::{\n    Adapters, CredentialStore, FileSaver, FolderPicker, ImagePicker, ImportFile, ImportPicker,\n    PagePrinter, UrlOpener,\n};\nuse futures_util::future::BoxFuture;\nuse tauri::{AppHandle, Manager, Runtime};\nuse zeroize::Zeroizing;\n\nuse crate::MAIN_WINDOW;\n\n/// The fixture test keychain's file name inside the fixture data root.\npub const FIXTURE_KEYCHAIN: &str = \"fixture-credentials.keychain-db\";\n/// The fixture test keychain's password. It protects only synthetic fixture\n/// credentials in a keychain that exists solely for acceptance runs.\npub const FIXTURE_KEYCHAIN_PASSWORD: &str = \"prisma-airs-desktop-v2-fixture-keychain\";\n/// Builds the production adapters for the app's data root.\npub fn production<R: Runtime>(app: &AppHandle<R>) -> Adapters {\n    let candidate_root = app.path().app_data_dir().ok();\n    // An unavailable, symlinked or already leased root authorizes no other\n    // file adapter. In particular it must not open a fixture keychain or\n    // private subdirectory through a rejected root.\n    let opened = candidate_root\n        .as_deref()\n        .and_then(|dir| FileStore::open(dir).ok());\n    let root = opened.as_ref().and(candidate_root);\n    let store: Arc<dyn AppStore> = opened\n        .map(|s| Arc::new(s) as Arc<dyn AppStore>)\n        .unwrap_or_else(|| Arc::new(UnavailableStore));\n    Adapters {\n        keychain: credential_store(root.as_deref()),\n        learner_keychain: learner_store(root.as_deref()),\n        store,\n        opener: opener(root.as_deref()),\n        printer: printer(app, root.as_deref()),\n        images: images(app, root.as_deref()),\n        confirmer: confirmer(app),\n        secrets: secrets(app),\n        text_files: sheet_picker(\n            root.as_deref(),\n            text_files(app, root.as_deref()),\n            Arc::new(NativeTextPicker { app: app.clone() }),\n        ),\n        offline_root: root.as_ref().map(|r| r.join(\"academy-offline\")),\n        saver: sheet_saver(\n            root.as_deref(),\n            saver(app, root.as_deref()),\n            Arc::new(NativeSaver { app: app.clone() }),\n        ),\n        sessions_root: root.as_ref().map(|r| r.join(\"sessions\")),\n        case_files: sheet_picker(\n            root.as_deref(),\n            case_files(app, root.as_deref()),\n            Arc::new(NativeCasePicker { app: app.clone() }),\n        ),\n        library_root: root.as_ref().map(|r| r.join(\"library\")),\n        folders: folders(app, root.as_deref()),\n        workbench_files: sheet_picker(\n            root.as_deref(),\n            workbench_files(root.as_deref()),\n            Arc::new(NativeExportPicker { app: app.clone() }),\n        ),\n        workbench_root: root.as_ref().map(|r| r.join(\"api-client\")),\n        gateway_files: sheet_picker(\n            root.as_deref(),\n            gateway_files(app, root.as_deref()),\n            Arc::new(NativeUploadPicker { app: app.clone() }),\n        ),\n        harness: harness(app, root.as_deref()),\n        logs_root: logs_root(app, root.as_deref()),\n    }\n}\n\n/// macOS's own logs folder for this app (D051), apart from the work in the\n/// data folder. Fixture builds keep it under their data root, which the\n/// acceptance drivers remove after each run.\n#[cfg(not(feature = \"test-fixtures\"))]\nfn logs_root<R: Runtime>(app: &AppHandle<R>, root: Option<&Path>) -> Option<PathBuf> {\n    root?;\n    app.path().app_log_dir().ok()\n}\n\n#[cfg(feature = \"test-fixtures\")]\nfn logs_root<R: Runtime>(_: &AppHandle<R>, root: Option<&Path>) -> Option<PathBuf> {\n    root.map(|r| r.join(\"fixture-logs\"))\n}\n\n/// The bundled Harness engine (`Contents/Resources/harness/airs-harness`),\n/// its OS launcher and where its ephemeral runtime homes are made. A build\n/// without the engine resource offers no Harness.\nfn harness<R: Runtime>(\n    app: &AppHandle<R>,\n    root: Option<&Path>,\n) -> desktop_core::harness::sidecar::HarnessAdapters {\n    use desktop_core::harness::{engine::Engine, sidecar::HarnessAdapters};\n    let engine = app\n        .path()\n        .resource_dir()\n        .ok()\n        .map(|r| {\n            r.join(\"harness\")\n                .join(desktop_core::harness::engine::pin().executable)\n        })\n        .and_then(|p| p.canonicalize().ok())\n        .filter(|p| p.is_file())\n        .map(|executable| Engine { executable });\n    #[cfg(target_os = \"macos\")]\n    let launcher: Arc<dyn desktop_core::harness::sidecar::SidecarLauncher> =\n        Arc::new(crate::sidecar::OsLauncher);\n    #[cfg(not(target_os = \"macos\"))]\n    let launcher: Arc<dyn desktop_core::harness::sidecar::SidecarLauncher> =\n        Arc::new(desktop_core::harness::sidecar::UnavailableLauncher);\n    HarnessAdapters {\n        launcher,\n        engine,\n        runtime_root: root.map(|r| r.join(\"harness-runtime\")),\n        history_root: root.map(|r| r.join(\"harness-history\")),\n        #[cfg(feature = \"test-fixtures\")]\n        fixture: None,\n        #[cfg(feature = \"test-fixtures\")]\n        save_gate: None,\n    }\n}\n\n/// A separate native sheet for the close guard (its own registry, so its\n/// nonce never meets a change review's).\n#[cfg(target_os = \"macos\")]\npub fn close_guard<R: Runtime>(app: &AppHandle<R>) -> Arc<dyn desktop_core::OperatorConfirmation> {\n    Arc::new(crate::native_confirmation::NativeConfirmation::new(\n        app.clone(),\n    ))\n}\n\n#[cfg(not(target_os = \"macos\"))]\npub fn close_guard<R: Runtime>(_app: &AppHandle<R>) -> Arc<dyn desktop_core::OperatorConfirmation> {\n    Arc::new(crate::native_confirmation::Unsupported)\n}\n\n/// Insomnia exports are bounded like v1 (1 MiB); one byte more is read so\n/// the core can report \"too large\".\npub const MAX_EXPORT_BYTES: usize = desktop_core::workbench::insomnia::EXPORT_BYTES + 1;\n\n/// The native folder sheets for API Client collections (C14).\nfn folders<R: Runtime>(app: &AppHandle<R>, root: Option<&Path>) -> Arc<dyn FolderPicker> {\n    let native = Arc::new(NativeFolders { app: app.clone() });\n    staged_folders(root, native)\n}\n\n#[cfg(not(feature = \"test-fixtures\"))]\nfn staged_folders(\n    _root: Option<&Path>,\n    native: Arc<NativeFolders<impl Runtime>>,\n) -> Arc<dyn FolderPicker> {\n    native\n}\n\n/// Where the fixture driver names the folder the open sheet answers.\n#[cfg(feature = \"test-fixtures\")]\npub const FIXTURE_OPEN_FOLDER: &str = \"fixture-open-folder\";\n/// Where the fixture driver names the folder the new-collection sheet\n/// answers.\n#[cfg(feature = \"test-fixtures\")]\npub const FIXTURE_NEW_FOLDER: &str = \"fixture-new-folder\";\n/// Where the fixture driver names the folder the Harness project sheet\n/// answers (C21).\n#[cfg(feature = \"test-fixtures\")]\npub const FIXTURE_PROJECT_FOLDER: &str = \"fixture-project-folder\";\n/// Where the fixture driver names the file the save-response sheet answers.\n#[cfg(feature = \"test-fixtures\")]\npub const FIXTURE_SAVE_RESPONSE: &str = \"fixture-save-response\";\n\n/// The fixture build answers the folder sheets with the paths the driver\n/// staged (none: cancelled), unless the native-sheet flag asks for the real\n/// NSOpenPanel / NSSavePanel.\n#[cfg(feature = \"test-fixtures\")]\nfn staged_folders<R: Runtime>(\n    root: Option<&Path>,\n    native: Arc<NativeFolders<R>>,\n) -> Arc<dyn FolderPicker> {\n    struct Staged<R: Runtime>(Option<PathBuf>, Arc<NativeFolders<R>>);\n    impl<R: Runtime> Staged<R> {\n        fn staged(&self, name: &str) -> BoxFuture<'static, Option<PathBuf>> {\n            let file = self.0.as_ref().map(|r| r.join(name));\n            Box::pin(async move {\n                let text = std::fs::read_to_string(file?).ok()?;\n                Some(PathBuf::from(text.trim()))\n            })\n        }\n        fn native(&self) -> bool {\n            self.0\n                .as_ref()\n                .is_some_and(|r| r.join(FIXTURE_NATIVE_SHEETS).exists())\n        }\n    }\n    impl<R: Runtime> FolderPicker for Staged<R> {\n        fn choose_folder(&self) -> BoxFuture<'static, Option<PathBuf>> {\n            if self.native() {\n                self.1.choose_folder()\n            } else {\n                self.staged(FIXTURE_OPEN_FOLDER)\n            }\n        }\n        fn choose_new(&self) -> BoxFuture<'static, Option<PathBuf>> {\n            if self.native() {\n                self.1.choose_new()\n            } else {\n                self.staged(FIXTURE_NEW_FOLDER)\n            }\n        }\n        fn choose_project(&self) -> BoxFuture<'static, Option<PathBuf>> {\n            if self.native() {\n                self.1.choose_project()\n            } else {\n                self.staged(FIXTURE_PROJECT_FOLDER)\n            }\n        }\n        fn choose_save(&self, suggested: String) -> BoxFuture<'static, Option<PathBuf>> {\n            if self.native() {\n                self.1.choose_save(suggested)\n            } else {\n                self.staged(FIXTURE_SAVE_RESPONSE)\n            }\n        }\n    }\n    Arc::new(Staged(root.map(Path::to_path_buf), native))\n}\n\npub struct NativeFolders<R: Runtime> {\n    app: AppHandle<R>,\n}\n\n/// Which native sheet to show.\nenum Sheet {\n    Open,\n    New,\n    /// The Harness's project folder (C21).\n    Project,\n    /// Save a response body under a suggested name (the panel confirms\n    /// replacing an existing file).\n    Save(String),\n}\n\nimpl<R: Runtime> NativeFolders<R> {\n    fn sheet(&self, sheet: Sheet) -> BoxFuture<'static, Option<PathBuf>> {\n        let app = self.app.clone();\n        Box::pin(async move {\n            let (tx, rx) = tokio::sync::oneshot::channel::<Option<PathBuf>>();\n            let window = app.get_webview_window(MAIN_WINDOW)?;\n            app.run_on_main_thread(move || {\n                let dialog = rfd::FileDialog::new().set_parent(&window);\n                let chosen = match sheet {\n                    Sheet::New => dialog\n                        .set_title(\"New collection\")\n                        .set_file_name(\"New collection\")\n                        .save_file(),\n                    Sheet::Open => dialog.set_title(\"Open collection\").pick_folder(),\n                    Sheet::Project => dialog.set_title(\"Choose project folder\").pick_folder(),\n                    Sheet::Save(name) => dialog\n                        .set_title(\"Save response\")\n                        .set_file_name(name)\n                        .save_file(),\n                };\n                let _ = tx.send(chosen);\n            })\n            .ok()?;\n            rx.await.ok()?\n        })\n    }\n}\n\nimpl<R: Runtime> FolderPicker for NativeFolders<R> {\n    fn choose_folder(&self) -> BoxFuture<'static, Option<PathBuf>> {\n        self.sheet(Sheet::Open)\n    }\n    fn choose_new(&self) -> BoxFuture<'static, Option<PathBuf>> {\n        self.sheet(Sheet::New)\n    }\n    fn choose_project(&self) -> BoxFuture<'static, Option<PathBuf>> {\n        self.sheet(Sheet::Project)\n    }\n    fn choose_save(&self, suggested: String) -> BoxFuture<'static, Option<PathBuf>> {\n        self.sheet(Sheet::Save(suggested))\n    }\n}\n\n/// Where the fixture driver stages Insomnia exports.\n#[cfg(feature = \"test-fixtures\")]\npub const FIXTURE_WORKBENCH_FILES: &str = \"fixture-workbench-files\";\n\n#[cfg(not(feature = \"test-fixtures\"))]\nfn workbench_files(_root: Option<&Path>) -> Arc<dyn ImportPicker> {\n    Arc::new(Cancelled)\n}\n\n/// Production builds use the native sheet (`sheet_picker` picks it).\n#[cfg(not(feature = \"test-fixtures\"))]\nstruct Cancelled;\n\n#[cfg(not(feature = \"test-fixtures\"))]\nimpl ImportPicker for Cancelled {\n    fn choose(&self) -> BoxFuture<'static, Option<Result<ImportFile, ImportError>>> {\n        Box::pin(async { None })\n    }\n}\n\n/// The fixture build answers the export sheet with the first file staged\n/// in `fixture-workbench-files/` (none: cancelled). The file is only read.\n#[cfg(feature = \"test-fixtures\")]\nfn workbench_files(root: Option<&Path>) -> Arc<dyn ImportPicker> {\n    struct Staged(Option<PathBuf>);\n#[cfg(feature = \"test-fixtures\")]\npub const FIXTURE_TRANSPORT_ROOTS: &str = \"fixture-transport-roots.pem\";\n\n/// The fixture transport policy, when the acceptance driver installed roots.\n#[cfg(feature = \"test-fixtures\")]\npub fn fixture_transport<R: Runtime>(\n    app: &AppHandle<R>,\n) -> Option<desktop_core::transport::TransportPolicy> {\n    let path = app\n        .path()\n        .app_data_dir()\n        .ok()?\n        .join(FIXTURE_TRANSPORT_ROOTS);\n    let pem = std::fs::read(path).ok()?;\n    Some(desktop_core::transport::TransportPolicy {\n        revision: 2,\n        extra_roots: vec![pem],\n        ..Default::default()\n    })\n}\n\n/// Reads at most [`MAX_PICKED_FILE_BYTES`] from a regular file.\npub fn read_bounded(path: &Path) -> Result<Zeroizing<Vec<u8>>, ImportError> {\n    read_limited(path, MAX_PICKED_FILE_BYTES)\n}\n\n/// Reads a regular file of at most `limit` bytes.\npub fn read_limited(path: &Path, limit: usize) -> Result<Zeroizing<Vec<u8>>, ImportError> {\n    let meta = std::fs::metadata(path).map_err(|_| ImportError::Unsupported)?;\n    if !meta.is_file() {\n        return Err(ImportError::Unsupported);\n    }\n    if meta.len() > limit as u64 {\n        return Err(ImportError::TooLarge);\n    }\n    let mut bytes = Zeroizing::new(Vec::new());\n    std::fs::File::open(path)\n        .and_then(|f| f.take(limit as u64 + 1).read_to_end(&mut bytes))\n        .map_err(|_| ImportError::Unsupported)?;\n    if bytes.len() > limit {\n        return Err(ImportError::TooLarge);\n    }\n    Ok(bytes)\n}\n\n/// The native image sheet for the learner's avatar, attached to the main\n/// window; reads are bounded to the 16 MiB source-photo cap.\n#[cfg_attr(feature = \"test-fixtures\", allow(dead_code))]\npub struct NativeImagePicker<R: Runtime> {\n    app: AppHandle<R>,\n}\n\nimpl<R: Runtime> ImagePicker for NativeImagePicker<R> {\n    fn choose_image(&self) -> BoxFuture<'static, Option<Result<ImportFile, ImportError>>> {\n        let app = self.app.clone();\n        Box::pin(async move {\n            let (tx, rx) = tokio::sync::oneshot::channel::<Option<PathBuf>>();\n            let window = app.get_webview_window(MAIN_WINDOW)?;\n            app.run_on_main_thread(move || {\n                let chosen = rfd::FileDialog::new()\n                    .set_parent(&window)\n                    .set_title(\"Choose a photo\")\n                    .add_filter(\"Photos\", &[\"jpg\", \"jpeg\", \"png\", \"webp\"])\n                    .pick_file();\n                let _ = tx.send(chosen);\n            })\n            .ok()?;\n            let path = rx.await.ok()??;\n            let name = path\n                .file_name()\n                .map(|n| n.to_string_lossy().into_owned())\n                .unwrap_or_default();\n            let read = tokio::task::spawn_blocking(move || read_limited(&path, MAX_SOURCE_BYTES))\n                .await\n                .ok()?;\n            Some(read.map(|bytes| ImportFile { name, bytes }))\n        })\n    }\n}\n\n/// The native file sheet for a dictionary's keyword file, attached to the\n/// main window; the file is only read, bounded to [`MAX_TEXT_FILE_BYTES`].\n#[cfg_attr(feature = \"test-fixtures\", allow(dead_code))]\npub struct NativeTextPicker<R: Runtime> {\n    app: AppHandle<R>,\n}\n\nimpl<R: Runtime> ImportPicker for NativeTextPicker<R> {\n    fn choose(&self) -> BoxFuture<'static, Option<Result<ImportFile, ImportError>>> {\n        let app = self.app.clone();\n        Box::pin(async move {\n            let (tx, rx) = tokio::sync::oneshot::channel::<Option<PathBuf>>();\n            let window = app.get_webview_window(MAIN_WINDOW)?;\n            app.run_on_main_thread(move || {\n                let chosen = rfd::FileDialog::new()\n                    .set_parent(&window)\n                    .set_title(\"Choose a dictionary keyword file\")\n                    .add_filter(\"Text\", &[\"txt\", \"csv\"])\n                    .pick_file();\n                let _ = tx.send(chosen);\n            })\n//! Classic macOS Keychain credential adapter (DESIGN \"Native Harness,\n//! identity and protected storage\").\n//!\n//! Generic-password items with service = this build's v2 namespace and\n//! account = the immutable credential record ID; local, non-synchronizing,\n//! default application ACL. Production uses the login Keychain and allows the\n//! OS authorization prompts; fixture builds use a dedicated test keychain and\n//! the fixture namespace. Every call is serialized (the user-interaction\n//! setting is process-global), and OS status codes map to sanitized\n//! [`VaultError`]s: a keychain that is locked reports `Locked`, an item the\n//! process may not read reports `Denied`. Purge deletes only items in this\n//! namespace; v1 and foreign items are never addressed.\n//!\n//! `SecKeychainItem::delete` in security-framework discards the OS status, and\n//! the keychain lock status is not bound, so this module calls those two\n//! Security functions directly.\n#![allow(unsafe_code)]\n\nuse std::path::Path;\nuse std::sync::Mutex;\n\nuse core_foundation::base::TCFType;\nuse desktop_core::CredentialStore;\nuse desktop_core::vault::{RecordId, Vault, VaultError};\nuse security_framework::item::{ItemClass, ItemSearchOptions, Limit, Reference, SearchResult};\nuse security_framework::os::macos::keychain::{CreateOptions, SecKeychain};\nuse security_framework::os::macos::keychain_item::SecKeychainItem;\nuse security_framework_sys::base::SecKeychainRef;\n\n/// Security status code (`OSStatus` in `<MacTypes.h>`).\ntype OSStatus = i32;\nuse zeroize::Zeroizing;\n\n/// The production v2 scan-credential namespace (independent of v1's\n/// `io.cdot.prisma-airs-desktop`).\npub const SCAN_SERVICE: &str = \"io.cdot.airs-desktop.scan\";\n/// The fixture build's namespace, used only in its dedicated test keychain.\npub const FIXTURE_SCAN_SERVICE: &str = \"io.cdot.airs-desktop.fixture.scan\";\n/// The Academy learner namespace (refresh token of the signed-in learner).\npub const ACADEMY_SERVICE: &str = \"io.cdot.airs-desktop.academy\";\n/// The fixture build's Academy learner namespace.\npub const FIXTURE_ACADEMY_SERVICE: &str = \"io.cdot.airs-desktop.fixture.academy\";\n\nconst ERR_SEC_ITEM_NOT_FOUND: OSStatus = -25300;\nconst ERR_SEC_INTERACTION_NOT_ALLOWED: OSStatus = -25308;\nconst ERR_SEC_AUTH_FAILED: OSStatus = -25293;\nconst ERR_SEC_USER_CANCELED: OSStatus = -128;\nconst ERR_SEC_NO_SUCH_KEYCHAIN: OSStatus = -25294;\nconst ERR_SEC_INVALID_KEYCHAIN: OSStatus = -25295;\nconst K_SEC_UNLOCK_STATE_STATUS: u32 = 1;\n\nunsafe extern \"C\" {\n    fn SecKeychainGetStatus(keychain: SecKeychainRef, status: *mut u32) -> OSStatus;\n    #[cfg(feature = \"test-fixtures\")]\n    fn SecKeychainLock(keychain: SecKeychainRef) -> OSStatus;\n    #[cfg(feature = \"test-fixtures\")]\n    fn SecKeychainUnlock(\n        keychain: SecKeychainRef,\n        length: u32,\n        password: *const std::ffi::c_void,\n        use_password: u8,\n    ) -> OSStatus;\n}\n\n/// Whether the OS may show its own authorization prompts.\n#[derive(Clone, Copy, Debug, PartialEq, Eq)]\npub enum Interaction {\n    Allowed,\n    Disallowed,\n}\n\nstatic KEYCHAIN_CALLS: Mutex<()> = Mutex::new(());\n\n/// A credential store over one keychain and namespace.\npub struct KeychainStore {\n    keychain: SecKeychain,\n    service: &'static str,\n    interaction: Interaction,\n}\n\n// SAFETY (Send/Sync): SecKeychainRef is a Core Foundation object whose\n// Security APIs are thread-safe; every call here is additionally serialized.\nunsafe impl Send for KeychainStore {}\nunsafe impl Sync for KeychainStore {}\n\nimpl KeychainStore {\n    /// The login Keychain with the production scan namespace.\n    pub fn login() -> Result<Self, VaultError> {\n        Self::login_service(SCAN_SERVICE)\n    }\n\n    /// The login Keychain with one of this build's production namespaces.\n    pub fn login_service(service: &'static str) -> Result<Self, VaultError> {\n        Ok(Self {\n            keychain: SecKeychain::default().map_err(|e| map(e.code(), None))?,\n            service,\n            interaction: Interaction::Allowed,\n        })\n    }\n\n    /// A dedicated file keychain (fixture builds and tests). Creates it with\n    /// `password` when absent and unlocks it.\n    pub fn file(\n        path: &Path,\n        password: &str,\n        service: &'static str,\n        interaction: Interaction,\n    ) -> Result<Self, VaultError> {\n        let mut keychain = if path.exists() {\n            SecKeychain::open(path).map_err(|e| map(e.code(), None))?\n        } else {\n            CreateOptions::new()\n                .password(password)\n                .prompt_user(false)\n                .create(path)\n                .map_err(|e| map(e.code(), None))?\n        };\n        keychain\n            .unlock(Some(password))\n            .map_err(|e| map(e.code(), None))?;\n        Ok(Self {\n            keychain,\n            service,\n            interaction,\n        })\n    }\n\n    pub fn service(&self) -> &'static str {\n        self.service\n    }\n\n    /// Whether the keychain currently reports itself locked.\n    pub fn is_locked(&self) -> bool {\n        let mut status = 0u32;\n        // SAFETY: the keychain reference is valid for `self`'s lifetime and\n        // `status` is a valid out-pointer.\n        let code =\n            unsafe { SecKeychainGetStatus(self.keychain.as_concrete_TypeRef(), &mut status) };\n        code == 0 && status & K_SEC_UNLOCK_STATE_STATUS == 0\n    }\n\n    /// Runs `f` serialized, with OS prompts disabled when configured. The\n    /// lock state is read after the prompt guard is released: with user\n    /// interaction disabled the status call itself fails.\n    fn call<T>(&self, f: impl FnOnce() -> Result<T, OSStatus>) -> Result<T, VaultError> {\n        let _serial = KEYCHAIN_CALLS.lock().map_err(|_| VaultError::Unavailable)?;\n        let result = {\n            let _guard = match self.interaction {\n                Interaction::Allowed => None,\n                Interaction::Disallowed => Some(\n                    SecKeychain::disable_user_interaction().map_err(|_| VaultError::Unavailable)?,\n                ),\n            };\n            f()\n        };\n        result.map_err(|code| map(code, Some(self.is_locked())))\n    }\n\n    fn find(&self, record: &RecordId) -> Result<(Zeroizing<Vec<u8>>, SecKeychainItem), OSStatus> {\n        self.keychain\n            .find_generic_password(self.service, record.as_str())\n            .map(|(password, item)| (Zeroizing::new(password.to_vec()), item))\n            .map_err(|e| e.code())\n    }\n}\n\n/// Fixture-only lock control for native acceptance: a running app does not\n/// observe a lock made by another process through `security lock-keychain`\n/// (observed on macOS 27), so the fixture menu locks and unlocks this\n/// process's own keychain reference instead.\n#[cfg(feature = \"test-fixtures\")]\nimpl KeychainStore {\n    pub fn lock_for_fixture(&self) -> bool {\n        let _serial = KEYCHAIN_CALLS.lock();\n        // SAFETY: the keychain reference is valid for `self`'s lifetime.\n        unsafe { SecKeychainLock(self.keychain.as_concrete_TypeRef()) == 0 }\n    }\n\n    pub fn unlock_for_fixture(&self, password: &str) -> bool {\n        let _serial = KEYCHAIN_CALLS.lock();\n        // SAFETY: the reference is valid and the password pointer/length\n        // describe a live UTF-8 buffer for the duration of the call.\n        unsafe {\n            SecKeychainUnlock(\n                self.keychain.as_concrete_TypeRef(),\n                password.len() as u32,\n                password.as_ptr().cast(),\n                1,\n            ) == 0\n        }\n    }\n}\n\nfn delete_item(item: &SecKeychainItem) -> Result<(), OSStatus> {\n    // SAFETY: the item reference is valid while `item` is alive.\n    let code = unsafe {\n        security_framework_sys::keychain_item::SecKeychainItemDelete(item.as_concrete_TypeRef())\n    };\n    if code == 0 { Ok(()) } else { Err(code) }\n}\n\n/// Maps an OS status to a sanitized vault error. `locked` is the keychain's\n/// lock state when known: a locked keychain answers -25308 (prompting not\n/// allowed), -25293 (authentication failed, observed on macOS 27 for an\n/// already-open keychain locked externally) or -128 (unlock prompt\n/// cancelled); the same codes on an unlocked keychain mean the item's ACL\n/// denied this process.\nfn map(code: OSStatus, locked: Option<bool>) -> VaultError {\n    match code {\n        ERR_SEC_ITEM_NOT_FOUND => VaultError::NotFound,\n        ERR_SEC_INTERACTION_NOT_ALLOWED | ERR_SEC_AUTH_FAILED | ERR_SEC_USER_CANCELED\n            if locked == Some(true) =>\n        {\n            VaultError::Locked\n        }\n        ERR_SEC_INTERACTION_NOT_ALLOWED | ERR_SEC_AUTH_FAILED | ERR_SEC_USER_CANCELED => {\n            VaultError::Denied\n        }\n        ERR_SEC_NO_SUCH_KEYCHAIN | ERR_SEC_INVALID_KEYCHAIN => VaultError::Unavailable,\n        _ => VaultError::Unavailable,\n                        // investigation was retired above).\n                        let _placement = crate::sessions::placement();\n                        for namespace in\n                            [&worker.adapters.keychain, &worker.adapters.learner_keychain]\n                        {\n                            namespace.purge().map_err(|reason| ResetFailure {\n                                stage: ResetStage::Credentials,\n                                reason,\n                            })?;\n                        }\n                        // Sealed investigations go with their keys (purged\n                        // above), and report files with the tenants.\n                        if let Some(root) = &worker.adapters.sessions_root {\n                            match std::fs::remove_dir_all(root) {\n                                Ok(()) => {}\n                                Err(e) if e.kind() == std::io::ErrorKind::NotFound => {}\n                                Err(_) => {\n                                    return Err(ResetFailure {\n                                        stage: ResetStage::Document,\n                                        reason: VaultError::Unavailable,\n                                    });\n                                }\n                            }\n                        }\n                        // The API Client's private folder (sealed profile and\n                        // the built-in collection) goes with its key too;\n                        // collections in the operator's folders stay.\n                        if let Some(root) = &worker.adapters.workbench_root {\n                            match std::fs::remove_dir_all(root) {\n                                Ok(()) => {}\n                                Err(e) if e.kind() == std::io::ErrorKind::NotFound => {}\n                                Err(_) => {\n                                    return Err(ResetFailure {\n                                        stage: ResetStage::Document,\n                                        reason: VaultError::Unavailable,\n                                    });\n                                }\n                            }\n                        }\n                        // Sealed case libraries go with their keys too.\n                        if let Some(root) = &worker.adapters.library_root {\n                            match std::fs::remove_dir_all(root) {\n                                Ok(()) => {}\n                                Err(e) if e.kind() == std::io::ErrorKind::NotFound => {}\n                                Err(_) => {\n                                    return Err(ResetFailure {\n                                        stage: ResetStage::Document,\n                                        reason: VaultError::Unavailable,\n                                    });\n                                }\n                            }\n                        }\n                        // Harness history goes with its keys (purged above).\n                        if let Some(root) = &worker.adapters.harness.history_root {\n                            match std::fs::remove_dir_all(root) {\n                                Ok(()) => {}\n                                Err(e) if e.kind() == std::io::ErrorKind::NotFound => {}\n                                Err(_) => {\n                                    return Err(ResetFailure {\n                                        stage: ResetStage::Document,\n                                        reason: VaultError::Unavailable,\n                                    });\n                                }\n                            }\n                        }\n                        // Diagnostics go with the data (D051).\n                        if !worker.diagnostics.purge() {\n                            return Err(ResetFailure {\n                                stage: ResetStage::Document,\n                                reason: VaultError::Unavailable,\n                            });\n                        }\n                        // Offline work goes with its keys (purged above).\n                        if let Some(root) = &worker.adapters.offline_root {\n                            crate::offline::purge(root).map_err(|_| ResetFailure {\n                                stage: ResetStage::Document,\n                                reason: VaultError::Unavailable,\n                            })?;\n                        }\n                        match worker.adapters.store.reset() {\n                            Ok(()) => Ok(false),\n                            Err(StoreError::Unconfirmed) => Ok(true),\n                            Err(_) => Err(ResetFailure {\n                                stage: ResetStage::Document,\n                                reason: VaultError::Unavailable,\n                            }),\n                        }\n                    })\n                    .await\n                    .unwrap_or(Err(ResetFailure {\n                        stage: ResetStage::Credentials,\n                        reason: VaultError::Unavailable,\n                    }));\n                    settle_reset(&inner, result);\n                });\n            }\n        }\n    }\n}\n\nfn complete_operation(\n    inner: &Arc<Inner>,\n    id: &OperationId,\n    outcome: Outcome,\n    stop: Option<StopReason>,\n) {\n    let effects = match lock(inner) {\n        Ok(mut state) => {\n            let now = Instant::now();\n            if let Some(stop) = stop {\n                state.operations.cancel(id, stop, now);\n            }\n            let starts = state.operations.complete(id, outcome, now);\n            state.sync_scans();\n            state.changed();\n            let mut effects = vec![Effect::Start(starts)];\n            effects.extend(state.take_case_writes());\n            effects.extend(gateway_local_effects(&mut state));\n            effects\n        }\n        Err(_) => return,\n    };\n    run_effects(inner, effects);\n}\n\n/// Gateway work to keep on this Mac after settlements: the newest writes,\n","exit_code":0,"status":"completed"}}
