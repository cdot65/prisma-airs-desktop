{"type":"item.completed","item":{"id":"item_56","type":"command_execution","command":"/bin/zsh -lc \"cat tools/native-acceptance/test_candidate_process.py && sed -n '248,310p' tools/native-acceptance/acceptance_c04.py && git diff c8b804d3 -- crates/desktop-core/src/authority/harness_history.rs crates/desktop-core/src/features.rs | head -170 && sed -n '1,100p' docs/planning/evidence/P09/native-controller/native_requirements.py\"","aggregated_output":"\"\"\"Synthetic process-table tests: never launch or signal an OS process.\"\"\"\nimport json,plistlib,signal,sys,tempfile,unittest\nfrom pathlib import Path\nsys.path.insert(0,str(Path(__file__).resolve().parent))\nfrom candidate_process import Candidate,Identity,FIXTURE_ID,EXECUTABLE\nclass Processes:\n    def __init__(self):self.rows={};self.signals=[]\n    def snapshot(self,pid):return self.rows.get(pid)\n    def pids(self):return list(self.rows)\n    def send(self,pid,sig):self.signals.append((pid,sig))\nclass Ownership(unittest.TestCase):\n    def setUp(self):\n        self.temp=tempfile.TemporaryDirectory();self.root=Path(self.temp.name)/'Prisma AIRS Desktop Fixture.app'\n        p=self.root/'Contents/MacOS';p.mkdir(parents=True);(p/EXECUTABLE).write_text('synthetic executable')\n        (self.root/'Contents/Info.plist').write_bytes(plistlib.dumps({'CFBundleIdentifier':FIXTURE_ID,'CFBundleExecutable':EXECUTABLE}))\n        self.processes=Processes();self.candidate=Candidate(self.root,self.processes)\n    def tearDown(self):self.temp.cleanup()\n    def owned(self):\n        row=Identity(10,self.candidate.app_path,(123,456),1);self.processes.rows[10]=row;self.candidate.adopt_child(10,1);return row\n    def test_owned_exact_child_can_be_signaled(self):\n        self.owned();self.candidate.signal_app();self.assertEqual(self.processes.signals,[(10,signal.SIGTERM)])\n    def test_foreign_same_basename_old_namespace_and_regex_lookalike_are_not_signaled(self):\n        for path in ['/foreign/Prisma AIRS Desktop Fixture.app/Contents/MacOS/'+EXECUTABLE,'/old/Prisma AIRS Desktop v2 Fixture.app/Contents/MacOS/prisma-airs-desktop-v2',self.candidate.app_path.replace('Fixture.app','FixtureXapp')]:\n            self.processes.rows={11:Identity(11,path,(1,1),1)};self.candidate.signal_app()\n        self.assertEqual(self.processes.signals,[])\n    def test_unowned_same_candidate_is_not_adopted(self):\n        self.processes.rows[10]=Identity(10,self.candidate.app_path,(1,1),99)\n        with self.assertRaises(RuntimeError):self.candidate.app_pid()\n        self.assertEqual(self.processes.signals,[])\n    def test_reused_pid_cannot_be_signaled_even_with_same_path(self):\n        old=self.owned();self.processes.rows[10]=Identity(10,old.executable,(124,1),old.parent)\n        self.assertFalse(self.candidate.signal_identity(old,signal.SIGKILL));self.assertEqual(self.processes.signals,[])\n    def test_duplicate_candidate_processes_refuse_ui_and_cleanup(self):\n        self.owned();self.processes.rows[11]=Identity(11,self.candidate.app_path,(1,1),1)\n        with self.assertRaises(RuntimeError):self.candidate.app_pid()\n        self.assertEqual(self.processes.signals,[])\n    def test_engine_must_be_exact_owned_descendant(self):\n        self.owned();self.processes.rows.update({20:Identity(20,self.candidate.engine_path,(2,2),10),21:Identity(21,'/foreign/airs-harness',(2,3),10),22:Identity(22,self.candidate.engine_path,(2,4),99)})\n        self.assertEqual(self.candidate.engines(),[20]);self.candidate.stop_engines();self.assertEqual(self.processes.signals,[(20,signal.SIGKILL)])\n    def test_observed_engine_cleanup_survives_parent_exit_but_not_pid_reuse(self):\n        self.owned();engine=Identity(20,self.candidate.engine_path,(2,2),10);self.processes.rows[20]=engine;self.candidate.engines();del self.processes.rows[10];self.processes.rows[20]=Identity(20,engine.executable,engine.birth,1)\n        self.assertTrue(self.candidate.signal_engine(20));self.processes.rows[20]=Identity(20,engine.executable,(3,3),10)\n        self.assertFalse(self.candidate.signal_engine(20));self.assertEqual(self.processes.signals,[(20,signal.SIGKILL)])\n    def test_symlinked_engine_cannot_escape_the_bundle(self):\n        external=Path(self.temp.name)/'foreign-engine';external.write_text('foreign')\n        engine=self.root/'Contents/Resources/harness/airs-harness';engine.parent.mkdir(parents=True);engine.symlink_to(external)\n        with self.assertRaises(ValueError):Candidate(self.root,self.processes)\n        self.assertEqual(self.processes.signals,[])\n    def test_production_or_missing_bundle_is_rejected(self):\n        p=self.root/'Contents/Info.plist';p.write_bytes(plistlib.dumps({'CFBundleIdentifier':'io.cdot.airs-desktop','CFBundleExecutable':EXECUTABLE}))\n        with self.assertRaises(ValueError):Candidate(self.root,self.processes)\n        with self.assertRaises(FileNotFoundError):Candidate(self.root/'missing',self.processes)\nif __name__=='__main__':unittest.main()\n    # After Reset local data the one presentation shows the first-run wizard again (no Settings page to read the\n    # account status from): the wizard showing is the signed-out state here.\n    obs[\"reset_signed_out\"] = wait_account(app, \"Not signed in to Academy.\") or v2s.wizard_showing(app, timeout=5)\n    obs[\"academy_items_after_reset\"] = fx.keychain_accounts(ACADEMY_SERVICE)\n    trees = [os.path.join(NATIVE, n) for n in os.listdir(NATIVE) if n.startswith(\"tree-\")]\n    obs[\"secret_in_trees\"] = [rel(p) for p in trees if any(s in open(p).read() for s in SECRETS)]\n    obs[\"data_root_hits\"] = data_root_hits()\n    app.quit()\n    endpoint.stop()\n    obs[\"requests\"] = endpoint.requests()\n    shutil.rmtree(work, ignore_errors=True)\n    with open(os.path.join(NATIVE, \"observations.json\"), \"w\") as f:\n        json.dump({\"observations\": obs, \"log\": LOG}, f, indent=1)\n    return evaluate(prepared, obs)\n\n\ndef current_frame_clear(found, window, viewport):\n    \"\"\"The one presentation has no legacy fade; require full native bounds.\"\"\"\n    if not found or not viewport:\n        return False\n    for frame in (window, viewport):\n        for axis in (0, 1):\n            if found[\"pos\"][axis] < frame[\"pos\"][axis] - 1:\n                return False\n            if found[\"pos\"][axis] + found[\"size\"][axis] > frame[\"pos\"][axis] + frame[\"size\"][axis] + 1:\n                return False\n    return True\n\n\ndef reach(app, zoom):\n    \"\"\"Tab to the sign-in control and inspect the actual one-presentation frame.\n\n    The old 60 CSS px decorative fade belonged to the removed legacy shell.\n    This uses the same current-frame rule the retained legacy_v2 C08 adapter\n    already applies, with additional horizontal and WebView containment.\n    \"\"\"\n    found = None\n    tree = app.tree()\n    for _ in range(60):\n        app.keycode(48)\n        tree = app.tree()\n        focused = app.focused(tree)\n        if focused and focused.get(\"role\") == \"AXButton\" and focused.get(\"label\") in (\"Sign in again\", \"Sign in to Academy\"):\n            found = {\"label\": focused[\"label\"], \"pos\": focused[\"pos\"], \"size\": focused[\"size\"]}\n            break\n    window = next(node for node in tree if node.get(\"role\") == \"AXWindow\")\n    viewport = next((node for node in tree if node.get(\"role\") == \"AXWebArea\" and node.get(\"pos\") and node.get(\"size\")), None)\n    bounds = lambda node: {\"pos\": node[\"pos\"], \"size\": node[\"size\"]} if node else None\n    return {\"zoom\": zoom, \"window\": bounds(window), \"viewport\": bounds(viewport), \"found\": found,\n            \"clear\": current_frame_clear(found, window, viewport),\n            \"criterion\": \"keyboard-reached control fully inside actual window and WebView; one presentation has no legacy decorative bottom fade\"}\n\n\ndef evaluate(prepared, o):\n    inventory = {c[\"id\"]: c[\"check\"] for c in json.load(open(os.path.join(ROOT, \"docs/architecture/native-checks.json\")))[\"chunks\"][\"C04\"]}\n    obs_path = rel(os.path.join(NATIVE, \"observations.json\"))\n    checks = []\n\n    def add(cid, passed, observation, evidence):\n        checks.append({\"id\": cid, \"description\": inventory[cid], \"result\": \"pass\" if passed else \"fail\",\n                       \"observation\": observation, \"evidence\": [obs_path] + [e for e in evidence if e]})\n\n    add(\"C04-N01\", o[\"group\"] and o[\"keyboard_reached_sign_in\"],\ndiff --git a/crates/desktop-core/src/authority/harness_history.rs b/crates/desktop-core/src/authority/harness_history.rs\nindex 1fb70e01..0c721661 100644\n--- a/crates/desktop-core/src/authority/harness_history.rs\n+++ b/crates/desktop-core/src/authority/harness_history.rs\n@@ -277,12 +277,6 @@ impl State {\n         }\n         let lease = self.lease();\n         let h = self.history_for(context, reference)?;\n-        let (tenant, workspace) = (h.tenant.clone(), h.workspace.clone());\n-        // A conversation an unsettled import saved is not there yet (D050).\n-        if self.v1_hides_conversation(&tenant, &workspace, id) {\n-            return Err(Refusal::InvalidInput);\n-        }\n-        let h = self.history_for(context, reference)?;\n         if h.busy {\n             return Err(Refusal::Busy);\n         }\n@@ -368,15 +362,11 @@ impl State {\n         id: &str,\n     ) -> Result<Resume, Refusal> {\n         let h = self.history_for(context, reference)?;\n-        let (tenant, workspace) = (h.tenant.clone(), h.workspace.clone());\n         let record = h\n             .opened\n             .clone()\n             .filter(|r| r.id == id)\n             .ok_or(Refusal::InvalidInput)?;\n-        if self.v1_hides_conversation(&tenant, &workspace, id) {\n-            return Err(Refusal::InvalidInput);\n-        }\n         if self.not_continuable(&record).is_some() {\n             return Err(Refusal::StaleContext);\n         }\n@@ -731,12 +721,6 @@ impl State {\n         let conversations = listed\n             .iter()\n             .filter_map(|l| match l {\n-                // An import's conversations show once it commits (D050).\n-                Listed::Saved { id, .. }\n-                    if self.v1_hides_conversation(&h.tenant, &h.workspace, id) =>\n-                {\n-                    None\n-                }\n                 Listed::Saved {\n                     id,\n                     title,\n@@ -768,19 +752,15 @@ impl State {\n             unreadable,\n             failure,\n             // Nor is one opened while an import that saved it is unsettled.\n-            opened: h\n-                .opened\n-                .as_ref()\n-                .filter(|r| !self.v1_hides_conversation(&h.tenant, &h.workspace, &r.id))\n-                .map(|r| OpenedConversationView {\n-                    id: r.id.clone(),\n-                    title: r.title.clone(),\n-                    updated: r.updated,\n-                    entries: r.entries.clone(),\n-                    source: r.binding.source,\n-                    not_continuable: self.not_continuable(r),\n-                    opening: r.opening(),\n-                }),\n+            opened: h.opened.as_ref().map(|r| OpenedConversationView {\n+                id: r.id.clone(),\n+                title: r.title.clone(),\n+                updated: r.updated,\n+                entries: r.entries.clone(),\n+                source: r.binding.source,\n+                not_continuable: self.not_continuable(r),\n+                opening: r.opening(),\n+            }),\n             busy: h.busy,\n             problem: h.problem,\n             last_open: h.last_open.clone(),\ndiff --git a/crates/desktop-core/src/features.rs b/crates/desktop-core/src/features.rs\nindex 58a8cd37..87348ac6 100644\n--- a/crates/desktop-core/src/features.rs\n+++ b/crates/desktop-core/src/features.rs\n@@ -8,19 +8,6 @@\n use serde::{Deserialize, Serialize};\n use ts_rs::TS;\n \n-/// Which desktop presentation the shell renders (D058). `Legacy` was the\n-/// C01 shell, removed in C44; `V2` is the \"Refined Native\" shell introduced\n-/// in C28 and the only one. The value stays on the wire for compatibility\n-/// (the snapshot always says `v2`; `Intent::SetUiVariant` is accepted and\n-/// ignored) and the persisted field is no longer read.\n-#[derive(Clone, Copy, Debug, Default, PartialEq, Eq, Hash, Serialize, Deserialize, TS)]\n-#[serde(rename_all = \"camelCase\")]\n-pub enum UiVariant {\n-    Legacy,\n-    #[default]\n-    V2,\n-}\n-\n /// First-run state of the v2 onboarding wizard (D058, C29 realises D013).\n /// Persisted; it never moves back to `Needed`.\n #[derive(Clone, Copy, Debug, Default, PartialEq, Eq, Hash, Serialize, Deserialize, TS)]\n@@ -254,7 +241,6 @@ pub enum FeatureId {\n     ApiClient,\n     Gateway,\n     Harness,\n-    Import,\n     Settings,\n }\n \n@@ -298,128 +284,33 @@ impl FeatureEntry {\n     }\n }\n \n-/// The catalogue for a presentation, in navigation order: the single\n-/// inventory the native menu, the sidebar and the command palette read.\n-pub fn catalogue_for(variant: UiVariant) -> Vec<FeatureEntry> {\n-    match variant {\n-        UiVariant::Legacy => catalogue(),\n-        UiVariant::V2 => vec![\n-            FeatureEntry::available(FeatureId::Home, \"Home\", Some(1), true),\n-            // Listed with its shortcut from the start so ⌘2 never moves; the\n-            // Inbox view itself lands in C30 and is unavailable until then.\n-            FeatureEntry::available(FeatureId::Inbox, \"Inbox\", Some(2), true),\n-            FeatureEntry::available(FeatureId::Harness, \"Harness\", Some(3), true),\n-            FeatureEntry::available(FeatureId::Academy, \"Academy\", Some(4), true),\n-            FeatureEntry::available(FeatureId::Library, \"Test Cases\", Some(5), true),\n-            FeatureEntry::available(FeatureId::ApiClient, \"API Client\", Some(6), true),\n-            FeatureEntry::available(FeatureId::Administration, \"Administration\", Some(7), true),\n-            // Inside Administration's accordion in v2; still direct Go/palette\n-            // destinations so nothing the legacy shell reached is lost.\n-            FeatureEntry::available(FeatureId::Runtime, \"Runtime Security\", None, false),\n-            FeatureEntry::available(FeatureId::Gateway, \"AI Gateway\", None, false),\n-            FeatureEntry::available(FeatureId::RedTeam, \"Red Team & Models\", None, false),\n-            FeatureEntry::available(FeatureId::Sessions, \"Sessions & Reports\", None, false),\n-            FeatureEntry::available(FeatureId::Settings, \"Settings\", None, false),\n-        ],\n-    }\n+/// The one catalogue used by the native menu, sidebar and command palette.\n+pub fn catalogue() -> Vec<FeatureEntry> {\n+    vec![\n+        FeatureEntry::available(FeatureId::Home, \"Home\", Some(1), true),\n+        // Listed with its shortcut from the start so ⌘2 never moves; the\n+        // Inbox view itself lands in C30 and is unavailable until then.\n+        FeatureEntry::available(FeatureId::Inbox, \"Inbox\", Some(2), true),\n+        FeatureEntry::available(FeatureId::Harness, \"Harness\", Some(3), true),\n+        FeatureEntry::available(FeatureId::Academy, \"Academy\", Some(4), true),\n+        FeatureEntry::available(FeatureId::Library, \"Test Cases\", Some(5), true),\n+        FeatureEntry::available(FeatureId::ApiClient, \"API Client\", Some(6), true),\n+        FeatureEntry::available(FeatureId::Administration, \"Administration\", Some(7), true),\n+        // Inside Administration's accordion in v2; still direct Go/palette\n+        // destinations so nothing the legacy shell reached is lost.\n+        FeatureEntry::available(FeatureId::Runtime, \"Runtime Security\", None, false),\n+        FeatureEntry::available(FeatureId::Gateway, \"AI Gateway\", None, false),\n+        FeatureEntry::available(FeatureId::RedTeam, \"Red Team & Models\", None, false),\n+        FeatureEntry::available(FeatureId::Sessions, \"Sessions & Reports\", None, false),\n+        FeatureEntry::available(FeatureId::Settings, \"Settings\", None, false),\n+    ]\n }\n \n-/// The first sidebar destination of a presentation: where a fresh session\n-/// lands and where navigation falls back after a variant change.\n-pub fn default_feature(variant: UiVariant) -> FeatureId {\n-    catalogue_for(variant)\n+/// A fresh session's first sidebar destination.\n+pub fn default_feature() -> FeatureId {\n+    catalogue()\n         .into_iter()\n         .find(|e| e.sidebar)\n         .map(|e| e.id)\n-        .unwrap_or(FeatureId::Settings)\n-}\n-\n\"\"\"Read the C44 gate's existing assertion map without changing its requirements.\"\"\"\nimport json\nimport re\nimport runpy\n\n\ndef load_requirements(root):\n    manifest = json.loads((root / 'docs/architecture/native-checks.json').read_text())['chunks']\n    data = runpy.run_path(str(root / 'tools/native-acceptance/legacy_assertions.py'))\n    assertions = data['ASSERTIONS']\n    legacy_ids = {c['id'] for chunk, checks in manifest.items()\n                  if re.fullmatch(r'C(0[1-9]|1\\d|2\\d|3[0-3])', chunk) for c in checks}\n    assert legacy_ids == set(assertions), 'legacy map differs from the full manifest'\n    targets = {t for kind, ts, _ in assertions.values()\n               if kind in (data['X'], data['S'], data['P']) for t in ts}\n    self_run = {lid.split('-')[0] for lid, (kind, _, _) in assertions.items() if kind == data['S']}\n    required = {chunk: {t for t in targets if t.startswith(chunk + '-')} for chunk in self_run}\n    # Some legacy ids are carried by a different self-run driver. Only drivers with actual targets run;\n    # the union check below still requires every mapped target to be covered.\n    required = {chunk: checks for chunk, checks in required.items() if checks}\n    for chunk in [f'C{i}' for i in range(35, 45)]:\n        required[chunk] = {c['id'] for c in manifest[chunk]}\n    assert all(required.values()), 'empty required native check set'\n    assert targets <= set().union(*required.values()), 'mapped native target has no driver'\n    return required\n\n\ndef assess_record(record, root, executable_sha256, required):\n    errors = []\n    if record.get('app', {}).get('executable_sha256') != executable_sha256:\n        errors.append('stale executable')\n    checks = {c['id']: c for c in record.get('checks', [])}\n    for cid in sorted(required):\n        check = checks.get(cid)\n        if check is None:\n            errors.append(cid + ' missing')\n        elif check['result'] != 'pass':\n            errors.append(cid + ' ' + check['result'])\n        else:\n            errors.extend(cid + ' missing evidence: ' + e for e in check['evidence'] if not (root / e).exists())\n    carried_elsewhere = [cid for cid, c in checks.items() if cid not in required and c['result'] != 'pass']\n    return errors, carried_elsewhere\n","exit_code":0,"status":"completed"}}
