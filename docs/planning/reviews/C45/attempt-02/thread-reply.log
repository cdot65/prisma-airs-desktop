{"type":"item.started","item":{"id":"item_49","type":"command_execution","command":"/bin/zsh -lc \"cat crates/xtask/src/package.rs && sed -n '625,690p' crates/xtask/src/signing.rs && rg -n 'source_archive|completion-proof|release_prerequisites|current=False|C26' tools/p10 docs/planning/verification-plan.md docs/planning/C45-draft.md docs/planning/evidence/C45/verification-plan-20261102.json README.md | head -110 && sed -n '78,112p' tools/p10/candidate.py && sed -n '44,70p' tools/p10/followup.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_49","type":"command_execution","command":"/bin/zsh -lc \"cat crates/xtask/src/package.rs && sed -n '625,690p' crates/xtask/src/signing.rs && rg -n 'source_archive|completion-proof|release_prerequisites|current=False|C26' tools/p10 docs/planning/verification-plan.md docs/planning/C45-draft.md docs/planning/evidence/C45/verification-plan-20261102.json README.md | head -110 && sed -n '78,112p' tools/p10/candidate.py && sed -n '44,70p' tools/p10/followup.py\"","aggregated_output":"//! Package gates. Neither kind uploads or publishes anything.\n//!\n//! * preview: only completed chunks may be advertised; every other feature\n//!   must stay visibly unavailable in the build.\n//! * release-candidate: requires C01–C25 completed; C26 adds the signed,\n//!   notarized, stapled and installed-byte validators.\n\nuse crate::complete::{is_completed, read_ledger};\nuse crate::{Repo, Result, Subject, invalid};\n\n#[derive(Clone, Copy, Debug, PartialEq, Eq)]\npub enum Kind {\n    Preview,\n    ReleaseCandidate,\n}\n\nimpl Kind {\n    pub fn parse(text: &str) -> Result<Self> {\n        match text {\n            \"preview\" => Ok(Self::Preview),\n            \"release-candidate\" => Ok(Self::ReleaseCandidate),\n            other => Err(invalid(format!(\"unknown package kind {other}\"))),\n        }\n    }\n}\n\n/// Completed chunks, in order, from the append-only ledger.\npub fn completed_chunks(repo: &Repo) -> Result<Vec<Subject>> {\n    let entries = read_ledger(&repo.completion_ledger())?;\n    Ok((1..=Subject::LAST_CHUNK)\n        .map(Subject::Chunk)\n        .filter(|s| is_completed(repo, &entries, *s))\n        .collect())\n}\n\npub fn gate(repo: &Repo, kind: Kind) -> Result<Vec<Subject>> {\n    let completed = completed_chunks(repo)?;\n    match kind {\n        Kind::Preview => {\n            if completed.is_empty() {\n                return Err(invalid(\n                    \"a preview package needs at least one completed chunk\",\n                ));\n            }\n            // Completion must be a contiguous prefix: no skipped predecessor.\n            for (i, subject) in completed.iter().enumerate() {\n                if *subject != Subject::Chunk(i as u8 + 1) {\n                    return Err(invalid(\"completed chunks are not a contiguous prefix\"));\n                }\n            }\n            Ok(completed)\n        }\n        Kind::ReleaseCandidate => {\n            let missing: Vec<String> = (1..=25u8)\n                .map(Subject::Chunk)\n                .filter(|s| !completed.contains(s))\n                .map(|s| s.to_string())\n                .collect();\n            if !missing.is_empty() {\n                return Err(invalid(format!(\n                    \"release-candidate requires C01-C25 completed; missing {}\",\n                    missing.join(\", \")\n                )));\n            }\n            verify_current_release_phases(repo)?;\n            Ok(completed)\n        }\n    }\n}\n\n/// P09/P10 actual independent phase proofs supplement the existing C01-C25\n/// ledger. C26 remains open so its own release implementation is not circular.\npub fn verify_current_release_phases(repo: &Repo) -> Result<()> {\n    let output = std::process::Command::new(\"/usr/bin/python3\")\n        .args([\"-I\", \"tools/p10/review_gate.py\", \"release-prerequisites\"])\n        .current_dir(repo.root())\n        .env_clear()\n        .env(\"PATH\", crate::git_path())\n        .output()\n        .map_err(crate::io_err(&repo.join(\"tools/p10/review_gate.py\")))?;\n    if !output.status.success() {\n        return Err(invalid(format!(\n            \"release requires genuine audited P09 and P10 full-9 phase proofs: {}\",\n            String::from_utf8_lossy(&output.stderr)\n        )));\n    }\n    Ok(())\n}\n}\n\n/// Builds the production app and DMG with the sealed (signed) engine and\n/// records them as `evidence/C26/release-build.json`. Refuses a build whose\n/// bundled engine is not the compiled pin or whose signature does not verify.\npub fn release_build(\n    repo: &crate::Repo,\n    manifest: &crate::manifest::Manifest,\n    env: &crate::env::Environment,\n) -> Result<BuildRecord> {\n    crate::package::gate(repo, crate::package::Kind::ReleaseCandidate)?;\n    let built = crate::budgets::build_production(repo, env, manifest.target.as_str())?;\n    let pin = desktop_core::harness::engine::pin();\n    let engine = built\n        .app\n        .join(\"Contents/Resources/harness\")\n        .join(&pin.executable);\n    let engine_bytes = std::fs::read(&engine).map_err(io_err(&engine))?;\n    let engine_sha256 = sha256_hex(&engine_bytes);\n    if engine_sha256 != pin.binary_sha256 {\n        return Err(invalid(format!(\n            \"the bundled engine {engine_sha256} is not the compiled pin {}\",\n            pin.binary_sha256\n        )));\n    }\n    verify(&engine)?;\n    let executable = built\n        .app\n        .join(\"Contents/MacOS\")\n        .join(crate::native::plist_value(\n            &built.app,\n            \"CFBundleExecutable\",\n        )?);\n    let lock = repo.join(\"Cargo.lock\");\n    let relative = |p: &Path| {\n        p.strip_prefix(repo.root())\n            .unwrap_or(p)\n            .display()\n            .to_string()\n    };\n    let record = BuildRecord {\n        schema: BUILD_SCHEMA.to_owned(),\n        built_utc: now_utc(),\n        source_fingerprint: crate::fingerprint::source(repo)?,\n        cargo_lock_sha256: sha256_hex(&std::fs::read(&lock).map_err(io_err(&lock))?),\n        identifier: built.identifier,\n        app: relative(&built.app),\n        app_tree_sha256: crate::fingerprint::tree_hash(&built.app)?,\n        executable_sha256: sha256_hex(&std::fs::read(&executable).map_err(io_err(&executable))?),\n        engine_sha256,\n        dmg: relative(&built.dmg),\n        dmg_sha256: sha256_hex(&std::fs::read(&built.dmg).map_err(io_err(&built.dmg))?),\n        commands: built.commands,\n    };\n   