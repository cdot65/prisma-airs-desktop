xt'\n-export type { CandidateProblem } from './generated/CandidateProblem'\n export type { ContextRef } from './generated/ContextRef'\n export type { Destination } from './generated/Destination'\n-export type { Discarded } from './generated/Discarded'\n export type { EndpointReviewView } from './generated/EndpointReviewView'\n-export type { ImportCandidate } from './generated/ImportCandidate'\n-export type { ImportError } from './generated/ImportError'\n-export type { ImportFormat } from './generated/ImportFormat'\n-export type { ImportView } from './generated/ImportView'\n export type { ProfileDraft } from './generated/ProfileDraft'\n export type { Region } from './generated/Region'\n export type { ReviewId } from './generated/ReviewId'\n@@ -213,8 +207,6 @@ export type { SkillStatistics } from './generated/SkillStatistics'\n export type { SupplyChainObservation } from './generated/SupplyChainObservation'\n export type { RuntimeSummary } from './generated/RuntimeSummary'\n export type { Tone } from './generated/Tone'\n-export type { AdoptionProblem } from './generated/AdoptionProblem'\n-export type { CandidateView } from './generated/CandidateView'\n export type { CollectionView } from './generated/CollectionView'\n export type { ConflictKind } from './generated/ConflictKind'\n export type { CurlProblem } from './generated/CurlProblem'\n@@ -276,23 +268,6 @@ export type { PlaneAccess } from './generated/PlaneAccess'\n export type { ScopeBinding } from './generated/ScopeBinding'\n export type { SelectedWorkspace } from './generated/SelectedWorkspace'\n export type { WorkspaceRef } from './generated/WorkspaceRef'\n-export type { Category } from './generated/Category'\n-export type { CategoryView } from './generated/CategoryView'\n-export type { ImportActivity } from './generated/ImportActivity'\n-export type { ItemCounts } from './generated/ItemCounts'\n-export type { ItemState } from './generated/ItemState'\n-export type { ItemStatus } from './generated/ItemStatus'\n-export type { PlanItemView } from './generated/PlanItemView'\n-export type { PlanView } from './generated/PlanView'\n-export type { Problem } from './generated/Problem'\n-export type { ReceiptItemView } from './generated/ReceiptItemView'\n-export type { ReceiptState } from './generated/ReceiptState'\n-export type { ReceiptView } from './generated/ReceiptView'\n-export type { SourceState } from './generated/SourceState'\n-export type { TargetChoice } from './generated/TargetChoice'\n-export type { TenantTarget } from './generated/TenantTarget'\n-export type { V1ImportView } from './generated/V1ImportView'\n-export type { V1TenantChoice } from './generated/V1TenantChoice'\n export type { DiagnosticsClear } from './generated/DiagnosticsClear'\n export type { DiagnosticsExport } from './generated/DiagnosticsExport'\n export type { DiagnosticsView } from './generated/DiagnosticsView'\n# Prisma AIRS Desktop v2\n\nSuccessor to Prisma AIRS Desktop: React presentation in Tauri, a focused Rust\napplication core, the native Rust SCM SDK, and shared Academy presentation.\nFirst target: macOS Apple Silicon, distributed as a signed and notarized DMG.\nImplementation proceeds through ordered, independently reviewed chunks; see\n[status](docs/planning/status.md) for what exists and what is verified.\n\nFor the current Worf VM transition, start with [WORF-START-HERE](docs/planning/WORF-START-HERE.md). It includes the exact source/worktree checkpoint verifier.\n\n## Layout\n\n```text\ncrates/desktop-core/          Rust application core: native authority, wire DTOs\napps/desktop/src-tauri/       desktop-host: Tauri window/origin admission, menus\napps/desktop/src/             React application composition\npackages/desktop-contracts/   generated wire declarations, typed facade, fixtures\ncrates/xtask/                 build-time check/review/completion controller\ntools/reference-validator/    one-off independent C01 bootstrap validator\n```\n\n## Building from a clean checkout\n\n```text\ncorepack enable pnpm --install-directory .tools/bin      # pnpm 10.6.5 (packageManager)\ncargo run --locked -p xtask -- fetch-inputs --source <path to ai-security-academy clone>\ncargo run --locked -p xtask -- check --chunk C01 --manifest docs/architecture/checks.json\ncargo run --locked -p xtask -- test  --chunk C01 --manifest docs/architecture/checks.json\n```\n\nThe controller runs only the argv commands in\n[checks.json](docs/architecture/checks.json) under the environment contract in\n[toolchain.json](docs/architecture/toolchain.json); it never reads `.env` files.\n\nStart with the [implementation plan](docs/planning/IMPLEMENTATION-PLAN.md),\n[chunk instructions](docs/planning/chunks/README.md), [decisions](docs/planning/decisions.md),\nthe [design](docs/architecture/DESIGN.md) and [ADRs](docs/adr/0001-native-operation-authority.md).\nNewly authored material uses [Apache-2.0](LICENSE); upstream terms remain intact.\nIndependent review: Codex reviews every chunk and phase (D026).\n\nOwner-specified repository:\n`ssh://git@git-ssh.cdot.io/cdot/prisma-airs-desktop-v2.git`.\n\"\"\"Causal followup guard negatives; no native UI, services or real credentials.\"\"\"\nfrom pathlib import Path\nimport copy,json,tempfile,unittest\nfrom qualification import sha\nfrom followup import source_delta,raw_checks,COMMANDS\n\n\nclass FollowupTests(unittest.TestCase):\n    def test_named_synthetic_tests_may_change(self):\n        name='crates/xtask/tests/live_run/common.rs';self.assertEqual(source_delta({name:'old'},{name:'new'},[name]),[name])\n\n    def test_production_or_unlisted_source_cannot_be_carried(self):\n        for name in ['apps/desktop/src-tauri/src/lib.rs','crates/xtask/src/live.rs']:\n            with self.assertRaisesRegex(ValueError,'application-affecting'):source_delta({name:'old'},{name:'new'},[name])\n\n    def test_undeclared_changed_test_is_rejected(self):\n        name='crates/xtask/tests/live_run/common.rs'\n        with self.assertRaisesRegex(ValueError,'undeclared'):source_delta({name:'old'},{name:'new'},[])\n\n    def setUp(self):\n        self.temp=tempfile.TemporaryDirectory();self.addCleanup(self.temp.cleanup);self.root=Path(self.temp.name);self.inputs=dict(source='current',dependencies='same',build_flags='same');self.commands=[]\n        for index,(label,argv,tests) in enumerate(COMMANDS):\n            log=self.root/(str(index)+'.log');log.write_text('synthetic retained passing output')\n            self.commands.append(dict(label=label,argv=argv,cwd='.',status='passed',exit_code=0,note=None,log=log.name,output_sha256=sha(log),tests=dict(passed=72,failed=0) if tests else None))\n        self.raw=dict(schema='airs-v2/run/1',subject='C45',run_id='synthetic',status='passed',failure=None,inputs_before=self.inputs,inputs_after=self.inputs,commands=copy.deepcopy(self.commands))\n\n    def verify(self):\n        path=self.root/'run.json';path.write_text(json.dumps(self.raw));return raw_checks(self.root,dict(path='run.json',sha256=sha(path)),self.inputs)\n\n    def test_actual_focused_test_lint_format_command_membership(self):self.assertEqual(self.verify()['commands'],3)\n\n    def test_test_target_cannot_be_omitted_or_replaced(self):\n        self.raw['commands'].pop()\n        with self.assertRaisesRegex(ValueError,'membership'):self.verify()\n        self.raw['commands']=copy.deepcopy(self.commands);self.raw['commands'][0]['argv']=['cargo','test']\n        with self.assertRaisesRegex(ValueError,'mismatch'):self.verify()\n\n    def test_no_tests_or_drifted_log_cannot_pass(self):\n        self.raw['commands'][0]['tests']['passed']=0\n        with self.assertRaisesRegex(ValueError,'not actually executed'):self.verify()\n        self.raw['commands'][0]['tests']['passed']=72;(self.root/'0.log').write_text('changed')\n        with self.assertRaisesRegex(ValueError,'log drift'):self.verify()\n\n    def test_runner_source_and_dependency_fingerprint_must_match(self):\n        self.raw['inputs_after']={**self.inputs,'source':'changed'}\n        with self.assertRaisesRegex(ValueError,'drift'):self.verify()\n\n\nif __name__=='__main__':unittest.main()\n","exit_code":0,"status":"completed"}}
