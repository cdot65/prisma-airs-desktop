{"type":"item.completed","item":{"id":"item_42","type":"command_execution","command":"/bin/zsh -lc \"cat apps/desktop/src/shell/feature-body.tsx && sed -n '1,155p' apps/desktop/src/shell/feature-view.tsx && git diff c8b804d3 -- apps/desktop/src/modules apps/desktop/src/v2/icons.tsx apps/desktop/src/v2/fixtures.ts apps/desktop/src/v2/v2-shell.test.tsx apps/desktop/src/v2/workbench/api-client.test.tsx apps/desktop/src/v2/wizard/wizard-boards.test.tsx ':\"'!apps/desktop/src/modules/tenants/tenants-settings.tsx'\"' ':\"'!apps/desktop/src/modules/workbench/document-save.test.tsx'\"' ':\"'!apps/desktop/src/modules/workbench/workbench-call.ts'\"'\"","aggregated_output":"import { forwardRef, useCallback } from 'react'\nimport type { DesktopClient, FeatureEntry, FeatureId, ShellSnapshot, Theme } from '@prisma-airs/desktop-contracts'\nimport { SessionsView } from '../modules/sessions/sessions-view'\nimport type { Dispatch } from '../modules/tenants/dispatch'\nimport { SettingsView, UnavailableView } from './feature-view'\n\nexport interface FeatureBodyProps {\n    feature: FeatureEntry\n    snapshot: ShellSnapshot\n    appearancePending: boolean\n    onSetAppearance: (theme: Theme) => void\n    onNavigate: (id: FeatureId) => void\n    dispatch: Dispatch\n    /** The native client, for management observations. */\n    client: DesktopClient\n}\n\n/**\n * The destinations the v2 shell frames without a board of their own (C44):\n * Settings, Sessions & Reports and the reviewed v1 import, keyed by the\n * active context where a view must never outlive its credential. Every\n * other destination is a v2 screen; the legacy shell and its views are gone.\n */\nexport const FeatureBody = forwardRef<HTMLHeadingElement, FeatureBodyProps>(function FeatureBody(props, heading) {\n    const { feature, snapshot } = props\n    const client = props.client\n    const observeManagement = useCallback((operation: string) => client.observeManagement(operation), [client])\n    return (\n        <>\n            {feature.id === 'settings' ? (\n                <SettingsView\n                    ref={heading}\n                    snapshot={snapshot}\n                    pending={props.appearancePending}\n                    onSetAppearance={props.onSetAppearance}\n                    dispatch={props.dispatch}\n                    observeManagement={observeManagement}\n                />\n            ) : feature.id === 'sessions' && feature.availability.state === 'available' ? (\n                <SessionsView\n                    // A new tenant or management credential remounts the view:\n                    // revealed content never outlives its credential.\n                    key={snapshot.active?.context ?? 'none'}\n                    ref={heading}\n                    snapshot={snapshot}\n                    dispatch={props.dispatch}\n                    observe={observeManagement}\n                    onNavigate={props.onNavigate}\n                />\n            ) : (\n                <UnavailableView ref={heading} feature={feature} />\n            )}\n        </>\n    )\n})\nimport { forwardRef, useId, useState } from 'react'\nimport { Button, Callout } from '@ai-security-academy/presentation'\nimport { Info } from 'lucide-react'\nimport type { FeatureEntry, Intent, ShellSnapshot, Theme } from '@prisma-airs/desktop-contracts'\nimport { type Dispatch, outcomeMessage } from '../modules/tenants/dispatch'\nimport { DiagnosticsPanel } from '../modules/diagnostics/diagnostics-panel'\nimport { AcademyAccount } from '../modules/academy/academy-account'\nimport { TenantsSettings } from '../modules/tenants/tenants-settings'\nimport type { ObserveManagement } from '../modules/administration/management-read'\n\ninterface HeadingProps {\n    id: string\n    kicker: string\n    title: string\n}\n\n/** Page heading that receives focus after navigation (tabIndex -1). */\nexport const PageHeading = forwardRef<HTMLHeadingElement, HeadingProps>(function PageHeading({ id, title }, ref) {\n    return (\n        <header className='mb-4 flex flex-col gap-1' data-slot='page-header'>\n            <h1 ref={ref} id={id} tabIndex={-1} data-slot='page-heading' className='font-bold outline-none' style={{ fontSize: 'var(--v2-title)' }}>\n                {title}\n            </h1>\n        </header>\n    )\n})\n\nexport const UnavailableView = forwardRef<HTMLHeadingElement, { feature: FeatureEntry }>(function UnavailableView({ feature }, ref) {\n    const planned = feature.availability.state === 'unavailable' ? feature.availability.plannedChunk : ''\n    return (\n        <section aria-labelledby={`${feature.id}-heading`} data-slot='feature-unavailable'>\n            <PageHeading ref={ref} id={`${feature.id}-heading`} kicker='Not available' title={feature.label} />\n            <Callout tone='default' icon={Info}>\n                <p>\n                    {feature.label} is not available in this build. Nothing here contacts a Prisma AIRS\n                    tenant or the Academy.\n                </p>\n                <p className='text-academy-ink-faint mt-2 font-mono text-[11px] tracking-[0.12em] uppercase'>\n                    Planned in {planned}\n                </p>\n            </Callout>\n        </section>\n    )\n})\n\nconst THEMES: { value: Theme; label: string; hint: string }[] = [\n    { value: 'system', label: 'Match System', hint: 'Follow the macOS appearance' },\n    { value: 'light', label: 'Light', hint: 'Paper light theme' },\n    { value: 'dark', label: 'Dark', hint: 'Gruvbox dark theme' },\n]\n\ninterface SettingsProps {\n    snapshot: ShellSnapshot\n    pending: boolean\n    onSetAppearance: (theme: Theme) => void\n    dispatch: Dispatch\n    observeManagement: ObserveManagement\n}\n\nexport const SettingsView = forwardRef<HTMLHeadingElement, SettingsProps>(function SettingsView(\n    { snapshot, pending, onSetAppearance, dispatch, observeManagement },\n    ref\n) {\n    const legend = useId()\n    const appearance = snapshot.appearance\n    return (\n        <section aria-labelledby='settings-heading' data-slot='settings'>\n            <PageHeading ref={ref} id='settings-heading' kicker='Desktop' title='Settings' />\n            <fieldset aria-labelledby={legend} aria-busy={pending} className='border-academy-rule flex flex-col gap-3 rounded-[12px] border p-5'>\n                <legend id={legend} className='text-academy-ink px-1 text-[15px] font-semibold'>\n                    Appearance\n                </legend>\n                <p className='text-academy-ink-soft text-[13px]'>\n                    A desktop-wide preference. It does not change your Academy account settings.\n                </p>\n                {THEMES.map((option) => (\n                    <label key={option.value} className='flex min-h-11 cursor-pointer items-center gap-3'>\n                        <input\n                            type='radio'\n                            name='appearance'\n                            value={option.value}\n                            checked={appearance === option.value}\n                            onChange={() => onSetAppearance(option.value)}\n                            className='accent-[var(--academy-accent)] size-4'\n                        />\n                        <span className='flex flex-col'>\n                            <span className='text-academy-ink text-[14px] font-medium'>{option.label}</span>\n                            <span className='text-academy-ink-faint text-[12px]'>{option.hint}</span>\n                        </span>\n                    </label>\n                ))}\n            </fieldset>\n            <div className='mt-6'>\n                <AcademyAccount view={snapshot.academy} dispatch={dispatch} />\n            </div>\n            <div className='mt-6'>\n                <TenantsSettings snapshot={snapshot} dispatch={dispatch} observeManagement={observeManagement} />\n            </div>\n            <div className='mt-6'>\n                <DiagnosticsPanel view={snapshot.diagnostics} dispatch={dispatch} />\n            </div>\n        </section>\n    )\n})\ndiff --git a/apps/desktop/src/modules/academy/academy-account.test.tsx b/apps/desktop/src/modules/academy/academy-account.test.tsx\nnew file mode 100644\nindex 00000000..e4d9d76b\n--- /dev/null\n+++ b/apps/desktop/src/modules/academy/academy-account.test.tsx\n@@ -0,0 +1,89 @@\n+/**\n+ * Production Academy account controls through the real App, DesktopClient\n+ * and shell: device sign-in states, the issuer-named page, sign-out and\n+ * honest failures. No URL or credential crosses from the presentation.\n+ */\n+import { render, screen, within } from '@testing-library/react'\n+import userEvent from '@testing-library/user-event'\n+import { describe, expect, it } from 'vitest'\n+import { type AcademyView, DesktopClient, type ShellSnapshot } from '@prisma-airs/desktop-contracts'\n+import { App } from '../../app'\n+import { type Native, scriptedNative } from '../../test/native'\n+import { fxSwitcher } from '../../v2/fixtures'\n+\n+// C44: one presentation; Settings is the destination the core names in the snapshot.\n+const withAcademy = (academy: AcademyView): ShellSnapshot => ({ ...fxSwitcher(), activeFeature: 'settings', academy })\n+\n+async function openSettings(native: Native) {\n+    const user = userEvent.setup()\n+    render(<App client={new DesktopClient(native.transport)} />)\n+    // C44: one presentation; Settings is a Go destination the core names in the snapshot.\n+    await screen.findByRole('navigation', { name: 'Destinations' })\n+    await native.push({ ...native.current, activeFeature: 'settings' })\n+    await screen.findByRole('group', { name: 'Academy account' })\n+    return user\n+}\n+\n+const account = () => within(screen.getByRole('group', { name: 'Academy account' }))\n+\n+describe('Academy account', () => {\n+    it('starts device sign-in, shows the code, opens only the native page and signs out', async () => {\n+        const native = scriptedNative(withAcademy({ state: 'signedOut' }))\n+        const user = await openSettings(native)\n+        expect(account().getByText(/separate from AIRS tenants/)).toBeInTheDocument()\n+        await user.click(account().getByRole('button', { name: 'Sign in to Academy' }))\n+        expect(native.dispatched).toEqual([{ kind: 'startAcademySignIn' }])\n+        await native.push(withAcademy({ state: 'starting' }))\n+        expect(account().getByText('Contacting Academy…')).toBeInTheDocument()\n+        await native.push(\n+            withAcademy({\n+                state: 'awaitingApproval',\n+                userCode: 'WDJB-MJHT',\n+                verificationUri: 'https://clerk.academy.example/activate',\n+                expiresIn: 599,\n+            })\n+        )\n+        expect(account().getByLabelText('Sign-in code W D J B - M J H T')).toHaveTextContent('WDJB-MJHT')\n+        expect(account().getByText(/https:\\/\\/clerk.academy.example\\/activate · expires in 10 min/)).toBeInTheDocument()\n+        await user.click(account().getByRole('button', { name: 'Open sign-in page' }))\n+        expect(native.dispatched.at(-1)).toEqual({ kind: 'openAcademyVerification' })\n+        await native.push(withAcademy({ state: 'signedIn', displayName: 'Ada Lovelace', accountId: 'user_2fixturelearner', learner: 'lx-aaaaaaaaaaaaaaaaaaaaaaaa' }))\n+        expect(account().getByText('Ada Lovelace')).toBeInTheDocument()\n+        await user.click(account().getByRole('button', { name: 'Sign out of Academy' }))\n+        expect(native.dispatched.at(-1)).toEqual({ kind: 'signOutAcademy' })\n+        // Nothing the presentation sent names a URL or carries a token.\n+        expect(native.sent.some((body) => body.includes('https://'))).toBe(false)\n+    })\n+\n+    it('cancels a sign-in in progress', async () => {\n+        const native = scriptedNative(\n+            withAcademy({ state: 'awaitingApproval', userCode: 'ABCD-EFGH', verificationUri: 'https://a.example/x', expiresIn: 30 })\n+        )\n+        const user = await openSettings(native)\n+        await user.click(account().getByRole('button', { name: 'Cancel sign-in' }))\n+        expect(native.dispatched).toEqual([{ kind: 'cancelAcademySignIn' }])\n+    })\n+\n+    it.each([\n+        [{ state: 'failed', failure: 'denied', vault: null, displayName: null }, 'Sign-in was declined in the browser.'],\n+        [{ state: 'failed', failure: 'expired', vault: null, displayName: null }, 'The sign-in code expired before it was approved.'],\n+        [{ state: 'failed', failure: 'authFailed', vault: 'locked', displayName: null }, 'The Keychain is locked'],\n+        [{ state: 'failed', failure: 'sessionExpired', vault: null, displayName: 'Ada Lovelace' }, 'Your Academy session expired.'],\n+        [{ state: 'failed', failure: 'notConfigured', vault: null, displayName: null }, 'not available on this server'],\n+    ] as [AcademyView, string][])('explains %o with an explicit way forward', async (view, text) => {\n+        const native = scriptedNative(withAcademy(view))\n+        const user = await openSettings(native)\n+        expect(account().getByText(new RegExp(text))).toBeInTheDocument()\n+        await user.click(account().getByRole('button', { name: 'Sign in again' }))\n+        expect(native.dispatched).toEqual([{ kind: 'startAcademySignIn' }])\n+    })\n+\n+    it('reports a refusal without claiming a state change', async () => {\n+        const native = scriptedNative(withAcademy({ state: 'signedOut' }))\n+        native.respond = () => ({ outcome: 'refusal', refusal: 'deniedStore' })\n+        const user = await openSettings(native)\n+        await user.click(account().getByRole('button', { name: 'Sign in to Academy' }))\n+        expect(await account().findByRole('alert')).toHaveTextContent('Local desktop data or the credential store is not available.')\n+        expect(account().getByText('Not signed in to Academy.')).toBeInTheDocument()\n+    })\n+})\ndiff --git a/apps/desktop/src/modules/academy/academy-account.tsx b/apps/desktop/src/modules/academy/academy-account.tsx\nnew file mode 100644\nindex 00000000..b9ea26a9\n--- /dev/null\n+++ b/apps/desktop/src/modules/academy/academy-account.tsx\n@@ -0,0 +1,153 @@\n+import { useId, useState } from 'react'\n+import { Button, Callout } from '@ai-security-academy/presentation'\n+import { AlertTriangle, CheckCircle2, Info } from 'lucide-react'\n+import type { AcademyFailure, AcademyView, Intent, VaultError } from '@prisma-airs/desktop-contracts'\n+import { type Dispatch, outcomeMessage } from '../tenants/dispatch'\n+\n+const FAILURE_TEXT: Record<AcademyFailure, string> = {\n+    notConfigured: 'Academy desktop sign-in is not available on this server.',\n+    invalidConfig: 'Academy returned a sign-in configuration the desktop cannot trust.',\n+    network: 'Academy could not be reached. Check your connection and try again.',\n+    invalidResponse: 'Academy returned an unexpected sign-in response. Try again.',\n+    denied: 'Sign-in was declined in the browser.',\n+    expired: 'The sign-in code expired before it was approved. Start again.',\n+    sessionExpired: 'Your Academy session expired. Sign in again.',\n+    scopeMissing: 'Academy did not grant learning access to this sign-in.',\n+    accountChanged: 'Academy changed its sign-in configuration. Sign in again.',\n+    authFailed: 'Academy sign-in could not complete. Try again.',\n+}\n+\n+const VAULT_TEXT: Record<VaultError, string> = {\n+    locked: 'The Keychain is locked, so the session could not be saved. Unlock it and sign in again.',\n+    denied: 'macOS did not allow the Academy session to be saved in the Keychain.',\n+    unavailable: 'The Keychain is not available, so the session could not be saved.',\n+    notFound: 'The saved Academy session is missing from the Keychain.',\n+    corrupt: 'The saved Academy session could not be read.',\n+}\n+\n+interface Props {\n+    view: AcademyView\n+    dispatch: Dispatch\n+}\n+\n+/**\n+ * The Academy learner account, independent of AIRS tenants. Sign-in is a\n+ * browser device flow: the desktop shows a code, opens the Academy page the\n+ * issuer named, and never sees a password. Tokens stay in the native core.\n+ */\n+export function AcademyAccount({ view, dispatch }: Props) {\n+    const legend = useId()\n+    const [busy, setBusy] = useState(false)\n+    const [message, setMessage] = useState<string | null>(null)\n+\n+    async function send(intent: Intent) {\n+        setBusy(true)\n+        setMessage(null)\n+        const outcome = await dispatch(intent)\n+        setBusy(false)\n+        setMessage(outcomeMessage(outcome))\n+    }\n+\n+    return (\n+        <fieldset\n+            aria-labelledby={legend}\n+            aria-busy={busy}\n+            data-slot='academy-account'\n+            className='border-academy-rule flex flex-col gap-3 rounded-[12px] border p-5'\n+        >\n+            <legend id={legend} className='text-academy-ink px-1 text-[15px] font-semibold'>\n+                Academy account\n+            </legend>\n+            <p className='text-academy-ink-soft text-[13px]'>\n+                Your Academy learner account is separate from AIRS tenants; switching tenants does not change it.\n+            </p>\n+            <div role='status' aria-live='polite' className='flex flex-col gap-3'>\n+                <State view={view} busy={busy} send={send} />\n+            </div>\n+            {message ? (\n+                <p role='alert' data-slot='academy-message' className='text-academy-accent-warn text-[13px]'>\n+                    {message}\n+                </p>\n+            ) : null}\n+        </fieldset>\n+    )\n+}\n+\n+function State({ view, busy, send }: { view: AcademyView; busy: boolean; send: (intent: Intent) => Promise<void> }) {\n+    switch (view.state) {\n+        case 'signedOut':\n+            return (\n+                <div className='flex flex-col items-start gap-3'>\n+                    <p className='text-academy-ink text-[13px]'>Not signed in to Academy.</p>\n+                    <Button type='button' tier='primary' disabled={busy} onClick={() => void send({ kind: 'startAcademySignIn' })}>\n+                        Sign in to Academy\n+                    </Button>\n+                </div>\n+            )\n+        case 'starting':\n+        case 'completing':\n+            return (\n+                <div className='flex flex-col items-start gap-3'>\n+                    <p className='text-academy-ink text-[13px]'>\n+                        {view.state === 'starting' ? 'Contacting Academy…' : 'Approved. Finishing sign-in…'}\n+                    </p>\n+                    <Button type='button' tier='secondary' onClick={() => void send({ kind: 'cancelAcademySignIn' })}>\n+                        Cancel sign-in\n+                    </Button>\n+                </div>\n+            )\n+        case 'awaitingApproval':\n+            return (\n+                <div className='flex flex-col items-start gap-3' data-slot='academy-code'>\n+                    <p className='text-academy-ink text-[13px]'>Enter this code on the Academy sign-in page:</p>\n+                    <p\n+                        className='font-mono text-academy-ink text-[24px] font-semibold tracking-[0.12em] select-all'\n+                        aria-label={`Sign-in code ${view.userCode.split('').join(' ')}`}\n+                    >\n+                        {view.userCode}\n+                    </p>\n+                    <p className='text-academy-ink-faint text-[12px] break-all'>\n+                        {view.verificationUri} · expires in {Math.max(1, Math.ceil(view.expiresIn / 60))} min\n+                    </p>\n+                    <div className='flex flex-wrap gap-2'>\n+                        <Button type='button' tier='primary' onClick={() => void send({ kind: 'openAcademyVerification' })}>\n+                            Open sign-in page\n+                        </Button>\n+                        <Button type='button' tier='secondary' onClick={() => void send({ kind: 'cancelAcademySignIn' })}>\n+                            Cancel sign-in\n+                        </Button>\n+                    </div>\n+                </div>\n+            )\n+        case 'signedIn':\n+            return (\n+                <div className='flex flex-col items-start gap-3'>\n+                    <Callout tone='success' icon={CheckCircle2}>\n+                        <p>\n+                            Signed in to Academy as <span className='font-semibold'>{view.displayName}</span>.\n+                        </p>\n+                    </Callout>\n+                    <Button type='button' tier='secondary' disabled={busy} onClick={() => void send({ kind: 'signOutAcademy' })}>\n+                        Sign out of Academy\n+                    </Button>\n+                </div>\n+            )\n+        case 'failed':\n+            return (\n+                <div className='flex flex-col items-start gap-3'>\n+                    <Callout tone='warning' icon={view.failure === 'network' ? Info : AlertTriangle} data-slot='academy-failure'>\n+                        {view.displayName ? <p className='font-semibold'>{view.displayName}</p> : null}\n+                        <p>{view.vault ? VAULT_TEXT[view.vault] : FAILURE_TEXT[view.failure]}</p>\n+                    </Callout>\n+                    <div className='flex flex-wrap gap-2'>\n+                        <Button type='button' tier='primary' disabled={busy} onClick={() => void send({ kind: 'startAcademySignIn' })}>\n+                            Sign in again\n+                        </Button>\n+                        <Button type='button' tier='secondary' disabled={busy} onClick={() => void send({ kind: 'signOutAcademy' })}>\n+                            Sign out of Academy\n+                        </Button>\n+                    </div>\n+                </div>\n+            )\n+    }\n+}\ndiff --git a/apps/desktop/src/modules/academy/academy-generations.test.tsx b/apps/desktop/src/modules/academy/academy-generations.test.tsx\nnew file mode 100644\nindex 00000000..10484823\n--- /dev/null\n+++ b/apps/desktop/src/modules/academy/academy-generations.test.tsx\n@@ -0,0 +1,175 @@\n+/**\n+ * Academy's learner-scoped state follows the native learner generation\n+ * through the real shell: a completion moment and a notice of account A do\n+ * not return after leaving Academy, resetting local data and signing in to\n+ * the same account again in Settings, and the new generation never watches\n+ * A's earlier course.\n+ */\n+import { act, render, screen, waitFor, within } from '@testing-library/react'\n+import userEvent from '@testing-library/user-event'\n+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest'\n+import { DesktopClient, type DesktopTransport, type Intent, type ShellSnapshot } from '@prisma-airs/desktop-contracts'\n+import { App } from '../../app'\n+import { fxSwitcher } from '../../v2/fixtures'\n+\n+// C44: one presentation; the v2 fixture's finished onboarding puts the shell on screen.\n+const base = fxSwitcher()\n+const signedIn = (learner: string, revision: string): ShellSnapshot =>\n+    ({\n+        ...base,\n+        revision,\n+        learner,\n+        academy: { state: 'signedIn', displayName: 'Ada Lovelace', accountId: 'user_2fixturelearner', learner },\n+    }) as ShellSnapshot\n+\n+const moduleRow = (complete: boolean) => ({\n+    moduleId: 'm1',\n+    title: 'BEFORE RESET MODULE',\n+    description: '',\n+    concepts: [],\n+    estMinutes: 5,\n+    order: 1,\n+    unitsDone: complete ? 1 : 0,\n+    unitCount: 1,\n+    percent: complete ? 100 : 0,\n+    xpEarned: complete ? 100 : 0,\n+    xpTotal: 100,\n+    complete,\n+    reuseCount: 1,\n+    resumeUnitId: 'u1',\n+})\n+const lesson = {\n+    id: 'u1',\n+    moduleId: 'm1',\n+    kind: 'content',\n+    order: 1,\n+    slug: '1',\n+    title: 'Only lesson',\n+    xp: 100,\n+    estMinutes: 5,\n+    status: 'not_started',\n+    bodyHtml: '<p>Text.</p>',\n+    objectives: [],\n+    inlineChecks: [],\n+    sourceLessonId: null,\n+    siblings: [{ id: 'u1', kind: 'content', order: 1, slug: '1', title: 'Only lesson', xp: 100, estMinutes: 5, status: 'not_started', locked: false }],\n+    pathContext: { course: { courseId: 'course-a', title: 'Course A', slug: 'course-a' }, moduleTitle: 'BEFORE RESET MODULE', modules: [moduleRow(false)] },\n+}\n+\n+function scripted() {\n+    const listeners: ((update: unknown) => void)[] = []\n+    const dispatched: (Intent & { kind: 'academyCall' })[] = []\n+    const results = new Map<string, unknown>()\n+    let snapshot = signedIn('lx-gen1', '1')\n+    let completed = false\n+    let completeCalls = 0\n+    let n = 0\n+    const reply = (procedure: string): unknown => {\n+        const data: Record<string, unknown> = {\n+            'paths.list': [],\n+            'library.list': [\n+                { type: 'course', id: 'course-a', slug: 'course-a', title: 'Course A', description: '', durationMinutes: 5, level: 'Associate', courseCount: null, labKind: null, courseSlug: null },\n+            ],\n+            'courses.list': [{ id: 'course-a', slug: 'course-a', title: 'Course A', description: '', iconKey: null, estMinutes: 5 }],\n+            'paths.forCourse': [],\n+            'enrollment.affectedByCourseRemoval': { certifications: [] },\n+            'progress.courseSummary': { hasProgress: false, units: 0, quizzes: 0, labs: 0, objectives: 0 },\n+            'modules.intro': null,\n+            'units.listByPath': [moduleRow(completed)],\n+            'units.listByModule': lesson.siblings,\n+            'units.get': lesson,\n+        }\n+        if (procedure === 'units.complete') {\n+            completeCalls += 1\n+            if (completeCalls === 1) {\n+                // The first completion's reply is lost: a notice says it may have applied.\n+                return { kind: 'failed', failure: 'network', outcome: 'unknown' }\n+            }\n+            completed = true\n+            return { kind: 'data', data: JSON.stringify({ json: { completed: true, award: null } }) }\n+        }\n+        return procedure in data\n+            ? { kind: 'data', data: JSON.stringify({ json: data[procedure] }) }\n+            : { kind: 'failed', failure: 'network', outcome: 'notSent' }\n+    }\n+    const transport: DesktopTransport = {\n+        async observe(bytes) {\n+            const body = JSON.parse(new TextDecoder().decode(bytes)) as { scope: { kind: string; operation?: string } }\n+            if (body.scope.kind === 'deliverySession') return { kind: 'deliverySession', session: `ds-${'a'.repeat(32)}`, nextSequence: '1' }\n+            if (body.scope.kind === 'academyCall') return { kind: 'academyCall', result: results.get(body.scope.operation ?? '') }\n+            return { kind: 'shell', snapshot }\n+        },\n+        async dispatch(bytes) {\n+            const intent = (JSON.parse(new TextDecoder().decode(bytes)) as { intent: Intent }).intent\n+            n += 1\n+            if (intent.kind === 'academyCall') {\n+                dispatched.push(intent)\n+                results.set(`op-${n}`, reply(intent.procedure))\n+                return { outcome: 'receipt', receipt: { kind: 'admitted', request: `rq-${n}`, operation: `op-${n}` } }\n+            }\n+            return { outcome: 'receipt', receipt: { kind: 'admitted', request: `rq-${n}`, operation: null } }\n+        },\n+        openChannel(onMessage) {\n+            listeners.push(onMessage)\n+            return { token: `__CHANNEL__:${listeners.length}`, close: () => undefined }\n+        },\n+    }\n+    return {\n+        transport,\n+        dispatched,\n+        push: (next: ShellSnapshot) =>\n+            act(() => {\n+                snapshot = next\n+                listeners.at(-1)?.({ kind: 'shell', snapshot: next })\n+            }),\n+    }\n+}\n+\n+beforeEach(() => {\n+    window.scrollTo = vi.fn() as never\n+})\n+afterEach(() => localStorage.clear())\n+\n+describe('Academy state across native generations', () => {\n+    it('does not bring back an earlier generation after reset and signing in to the same account', async () => {\n+        const user = userEvent.setup()\n+        const matchMedia = vi\n+            .spyOn(window, 'matchMedia')\n+            .mockReturnValue({ matches: true, addEventListener: vi.fn(), removeEventListener: vi.fn() } as never)\n+        try {\n+            const s = scripted()\n+            render(<App client={new DesktopClient(s.transport)} />)\n+            // C44: one presentation; the core names the destination in the snapshot.\n+            await screen.findByRole('navigation', { name: 'Destinations' })\n+            s.push({ ...signedIn('lx-gen1', '2'), activeFeature: 'academy' })\n+            await user.click(await screen.findByRole('button', { name: 'Courses', pressed: false }))\n+            await user.click(await screen.findByRole('link', { name: /Course A/ }))\n+            await user.click(await screen.findByRole('link', { name: /Only lesson/ }))\n+            await screen.findByRole('heading', { level: 1, name: 'Only lesson' })\n+            const finish = screen.getByRole('button', { name: /Finish module|Complete & continue/ })\n+            await user.click(finish)\n+            await waitFor(() => expect(screen.getAllByRole('alert').some((a) => a.textContent?.includes('may have recorded'))).toBe(true))\n+            await user.click(finish)\n+            const overlay = () => document.querySelector('[data-slot=\"module-secure-overlay\"]')\n+            await waitFor(() => expect(overlay()).toHaveTextContent('Module secure: BEFORE RESET MODULE'), { timeout: 5000 })\n+\n+            // Settings: reset local data, then sign in to the same account.\n+            s.push({ ...signedIn('lx-gen1', '3'), activeFeature: 'settings', storage: 'resetting' } as ShellSnapshot)\n+            s.push({ ...base, revision: '4', learner: 'lx-gen2', academy: { state: 'signedOut' }, activeFeature: 'settings' } as ShellSnapshot)\n+            s.push({ ...signedIn('lx-gen3', '5'), activeFeature: 'settings' })\n+            const mark = s.dispatched.length\n+\n+            s.push({ ...signedIn('lx-gen3', '6'), activeFeature: 'academy' })\n+            await screen.findByRole('heading', { level: 1, name: 'What will you take up next?' })\n+            await new Promise((r) => setTimeout(r, 150))\n+            expect(overlay()).toBeNull()\n+            expect(document.body.textContent).not.toContain('BEFORE RESET MODULE')\n+            expect(screen.queryAllByRole('alert').some((a) => a.textContent?.includes('may have recorded'))).toBe(false)\n+            const later = s.dispatched.slice(mark)\n+            expect(later.every((i) => i.learner === 'lx-gen3')).toBe(true)\n+            expect(later.filter((i) => i.procedure === 'units.listByPath')).toEqual([])\n+        } finally {\n+            matchMedia.mockRestore()\n+        }\n+    }, 30000)\n+})\ndiff --git a/apps/desktop/src/modules/academy/desktop-link.test.ts b/apps/desktop/src/modules/academy/desktop-link.test.ts\nnew file mode 100644\nindex 00000000..900f3aed\n--- /dev/null\n+++ b/apps/desktop/src/modules/academy/desktop-link.test.ts\n@@ -0,0 +1,164 @@\n+/**\n+ * The production desktop tRPC link against literal SuperJSON/envelope\n+ * fixtures shared with the Rust learner transport tests\n+ * (packages/desktop-contracts/fixtures/academy).\n+ */\n+import { createTRPCClient, TRPCClientError } from '@trpc/client'\n+import { initTRPC } from '@trpc/server'\n+import SuperJSON from 'superjson'\n+import { describe, expect, it } from 'vitest'\n+import { DesktopClient, type Intent } from '@prisma-airs/desktop-contracts'\n+import unitsGet from '@prisma-airs/desktop-contracts/fixtures/academy/units-get.result.json'\n+import unitsGetInput from '@prisma-airs/desktop-contracts/fixtures/academy/units-get.input.json'\n+import shopBuyError from '@prisma-airs/desktop-contracts/fixtures/academy/shop-buy.error.json'\n+import { desktopLink } from './desktop-link'\n+\n+// A router type with the two procedures the fixtures cover.\n+const t = initTRPC.create({ transformer: SuperJSON })\n+const router = t.router({\n+    units: t.router({\n+        get: t.procedure.input((v) => v as { unitId: string; since: Date }).query(() => ({})),\n+    }),\n+    shop: t.router({ buy: t.procedure.input((v) => v as { itemId: string }).mutation(() => ({})) }),\n+    live: t.procedure.subscription(async function* () {}),\n+})\n+type Router = typeof router\n+\n+const LEARNER = 'lx-0123456789abcdef01234567'\n+\n+function native(results: Record<string, unknown>, refuse?: string) {\n+    const dispatched: Intent[] = []\n+    const observed: string[] = []\n+    let n = 0\n+    const transport = {\n+        async observe(bytes: Uint8Array) {\n+            const body = JSON.parse(new TextDecoder().decode(bytes)) as { scope: { kind: string; operation?: string } }\n+            if (body.scope.kind === 'deliverySession') {\n+                return { kind: 'deliverySession', session: `ds-${'b'.repeat(32)}`, nextSequence: '1' }\n+            }\n+            observed.push(body.scope.operation ?? '')\n+            return { kind: 'academyCall', result: results[body.scope.operation ?? ''] }\n+        },\n+        async dispatch(bytes: Uint8Array) {\n+            const body = JSON.parse(new TextDecoder().decode(bytes)) as { intent: Intent }\n+            dispatched.push(body.intent)\n+            if (refuse) return { outcome: 'refusal', refusal: refuse }\n+            n += 1\n+            return { outcome: 'receipt', receipt: { kind: 'admitted', request: `rq-${n}`, operation: `op-${n}` } }\n+        },\n+        openChannel: () => ({ token: '__CHANNEL__:1', close: () => undefined }),\n+    }\n+    const client = new DesktopClient(transport)\n+    const trpc = createTRPCClient<Router>({\n+        links: [desktopLink<Router>({ client, learner: () => LEARNER, transformer: SuperJSON })],\n+    })\n+    return { trpc, dispatched, observed }\n+}\n+\n+describe('desktop tRPC link', () => {\n+    it('serializes input with SuperJSON and revives the literal reply exactly as Rust returns it', async () => {\n+        // Rust returns `result.data` of the server envelope as text.\n+        const data = JSON.stringify(unitsGet.result.data)\n+        const { trpc, dispatched } = native({ 'op-1': { kind: 'data', data } })\n+        const value = await trpc.units.get.query({ unitId: 'unit-prompt-injection-1', since: new Date('2026-09-30T00:00:00.000Z') })\n+        expect(dispatched).toEqual([\n+            {\n+                kind: 'academyCall',\n+                learner: LEARNER,\n+                procedure: 'units.get',\n+                procedureKind: 'query',\n+                input: JSON.stringify(unitsGetInput),\n+            },\n+        ])\n+        expect(value).toEqual({\n+            id: 'unit-prompt-injection-1',\n+            title: 'Prompt injection basics',\n+            completedAt: new Date('2026-10-01T12:30:00.000Z'),\n+            steps: [{ kind: 'reading', minutes: 6 }],\n+        })\n+        expect((value as { completedAt: unknown }).completedAt).toBeInstanceOf(Date)\n+    })\n+\n+    it('turns a server error envelope into the same TRPCClientError the HTTP link would', async () => {\n+        const { trpc, dispatched } = native({ 'op-1': { kind: 'error', error: JSON.stringify(shopBuyError.error), httpStatus: 400, outcome: 'rejected' } })\n+        const error = await trpc.shop.buy.mutate({ itemId: 'x' }).catch((e: unknown) => e)\n+        expect(error).toBeInstanceOf(TRPCClientError)\n+        const e = error as TRPCClientError<Router>\n+        expect(e.message).toBe('Not enough credits')\n+        expect(e.data).toMatchObject({ code: 'BAD_REQUEST', httpStatus: 400, path: 'shop.buy', outcome: 'rejected' })\n+        expect(dispatched[0]).toMatchObject({ procedureKind: 'mutation', procedure: 'shop.buy' })\n+    })\n+\n+    it('reports native failures and refusals without retrying', async () => {\n+        const failed = native({ 'op-1': { kind: 'failed', failure: 'sessionExpired', outcome: 'notSent' } })\n+        const expired = await failed.trpc.units.get.query({ unitId: 'u', since: new Date(0) }).catch((e: unknown) => e)\n+        expect((expired as TRPCClientError<Router>).data).toMatchObject({ code: 'UNAUTHORIZED' })\n+        expect(failed.dispatched).toHaveLength(1)\n+\n+        const refused = native({}, 'capabilityMissing')\n+        const forbidden = await refused.trpc.shop.buy.mutate({ itemId: 'x' }).catch((e: unknown) => e)\n+        expect((forbidden as TRPCClientError<Router>).data).toMatchObject({ code: 'METHOD_NOT_SUPPORTED', httpStatus: 405 })\n+        expect(refused.observed).toEqual([])\n+    })\n+\n+    it('never sends subscriptions or calls without a learner', async () => {\n+        const { dispatched } = native({})\n+        const client = new DesktopClient({\n+            observe: async () => ({ kind: 'deliverySession', session: `ds-${'c'.repeat(32)}`, nextSequence: '1' }),\n+            dispatch: async () => {\n+                throw new Error('must not dispatch')\n+            },\n+            openChannel: () => ({ token: 't', close: () => undefined }),\n+        })\n+        const anonymous = createTRPCClient<Router>({\n+            links: [desktopLink<Router>({ client, learner: () => null, transformer: SuperJSON })],\n+        })\n+        const error = await anonymous.units.get.query({ unitId: 'u', since: new Date(0) }).catch((e: unknown) => e)\n+        expect((error as TRPCClientError<Router>).data).toMatchObject({ code: 'UNAUTHORIZED' })\n+        expect(dispatched).toEqual([])\n+    })\n+\n+    it.each([\n+        ['a lost reply', { kind: 'failed', failure: 'network', outcome: 'unknown' }],\n+        ['a timeout after dispatch', { kind: 'failed', failure: 'timeout', outcome: 'unknown' }],\n+        ['a cancellation after dispatch', { kind: 'failed', failure: 'cancelled', outcome: 'unknown' }],\n+        ['an HTTP 5xx', { kind: 'error', error: JSON.stringify({ json: { message: 'boom', code: -32603, data: { code: 'INTERNAL_SERVER_ERROR', httpStatus: 500 } } }), httpStatus: 500, outcome: 'unknown' }],\n+    ])('reports %s on a mutation as possibly applied and never sends it again', async (_case, result) => {\n+        const { trpc, dispatched } = native({ 'op-1': result })\n+        const error = (await trpc.shop.buy.mutate({ itemId: 'x' }).catch((e: unknown) => e)) as TRPCClientError<Router>\n+        expect(error).toBeInstanceOf(TRPCClientError)\n+        expect((error.data as { outcome?: string }).outcome).toBe('unknown')\n+        expect(error.message).toMatch(/may have applied this change/)\n+        if (result.kind === 'error') {\n+            // The server's own status, code and message are kept.\n+            expect(error.data).toMatchObject({ code: 'INTERNAL_SERVER_ERROR', httpStatus: 500, serverMessage: 'boom' })\n+        }\n+        expect(dispatched).toHaveLength(1)\n+    })\n+\n+    it('keeps not-sent and rejected distinct from unknown', async () => {\n+        const notSent = native({ 'op-1': { kind: 'failed', failure: 'credentialUnavailable', outcome: 'notSent' } })\n+        const e1 = (await notSent.trpc.shop.buy.mutate({ itemId: 'x' }).catch((e: unknown) => e)) as TRPCClientError<Router>\n+        expect(e1.data).toMatchObject({ outcome: 'notSent', code: 'UNAUTHORIZED' })\n+        expect(e1.message).not.toMatch(/may have applied/)\n+        const rejected = native({ 'op-1': { kind: 'error', error: JSON.stringify(shopBuyError.error), httpStatus: 400, outcome: 'rejected' } })\n+        const e2 = (await rejected.trpc.shop.buy.mutate({ itemId: 'x' }).catch((e: unknown) => e)) as TRPCClientError<Router>\n+        expect(e2.data).toMatchObject({ outcome: 'rejected' })\n+    })\n+\n+    it('treats an unconfirmed admission or an unreadable result as unknown', async () => {\n+        const lostAdmission = new DesktopClient({\n+            observe: async () => ({ kind: 'deliverySession', session: `ds-${'e'.repeat(32)}`, nextSequence: '1' }),\n+            dispatch: async () => {\n+                throw new Error('lost')\n+            },\n+            openChannel: () => ({ token: 't', close: () => undefined }),\n+        })\n+        const trpc = createTRPCClient<Router>({\n+            links: [desktopLink<Router>({ client: lostAdmission, learner: () => LEARNER, transformer: SuperJSON })],\n+        })\n+        const error = (await trpc.shop.buy.mutate({ itemId: 'x' }).catch((e: unknown) => e)) as TRPCClientError<Router>\n+        expect(error.data).toMatchObject({ outcome: 'unknown' })\n+        expect(error.message).toMatch(/may have applied this change/)\n+    })\n+})\ndiff --git a/apps/desktop/src/modules/academy/desktop-link.ts b/apps/desktop/src/modules/academy/desktop-link.ts\nnew file mode 100644\nindex 00000000..98798e7b\n--- /dev/null\n+++ b/apps/desktop/src/modules/academy/desktop-link.ts\n@@ -0,0 +1,192 @@\n+/**\n+ * The desktop's terminating tRPC link for Academy learner procedures.\n+ *\n+ * Instead of HTTP, each operation is admitted by the native core as an\n+ * `academyCall` for the current learner reference; Rust checks the pinned\n+ * learner allowlist, injects the account credential and returns the reply in\n+ * tRPC wire form. The link rebuilds the same envelope tRPC's HTTP link would\n+ * read and applies tRPC's own `transformResult`, so Academy's hooks see\n+ * identical data, errors and SuperJSON-revived values. Credentials never\n+ * reach this code.\n+ */\n+import { TRPCClientError, type TRPCLink } from '@trpc/client'\n+import type { AnyRouter } from '@trpc/server'\n+import { observable } from '@trpc/server/observable'\n+import { transformResult } from '@trpc/server/unstable-core-do-not-import'\n+import type { CallFailure, DesktopClient, LearnerRef, Outcome, Refusal } from '@prisma-airs/desktop-contracts'\n+\n+/** The transformer pair tRPC links take (SuperJSON for Academy). */\n+export interface Transformer {\n+    serialize(value: unknown): unknown\n+    deserialize(value: unknown): unknown\n+}\n+\n+export interface DesktopLinkOptions {\n+    client: DesktopClient\n+    /** The current learner reference, read at each operation. */\n+    learner: () => LearnerRef | null\n+    /**\n+     * Whether that reference is a signed-in account (false for the guest\n+     * generation). A refused procedure then reads as Academy's own sign-in\n+     * gate for a guest, and as not available on the desktop when signed in.\n+     */\n+    signedIn?: () => boolean\n+    transformer: Transformer\n+}\n+\n+const REFUSAL_TEXT: Partial<Record<Refusal, string>> = {\n+    staleContext: 'The Academy account changed. Reload this page.',\n+    capabilityMissing: 'This Academy action is not available on the desktop.',\n+    invalidInput: 'The request could not be sent.',\n+    busy: 'The desktop is busy. Try again in a moment.',\n+    shuttingDown: 'The desktop is shutting down.',\n+}\n+\n+/**\n+ * A client error the hooks can inspect like any other tRPC failure. `data`\n+ * also carries the native remote outcome (`notSent`, `rejected`, `unknown`)\n+ * so a possibly applied mutation is never mistaken for one that failed.\n+ */\n+function desktopError(\n+    message: string,\n+    code: string,\n+    outcome: Outcome,\n+    extra: { httpStatus?: number; failure?: CallFailure | Refusal } = {}\n+) {\n+    return TRPCClientError.from({\n+        error: {\n+            message,\n+            code: -32000,\n+            data: { code, httpStatus: extra.httpStatus ?? 0, desktop: true, outcome, failure: extra.failure ?? null },\n+        },\n+    })\n+}\n+\n+const MAY_HAVE_APPLIED = 'Academy may have applied this change. Check its current state before trying again.'\n+\n+function failureMessage(failure: CallFailure, outcome: Outcome, mutation: boolean): string {\n+    if (failure === 'sessionExpired' || failure === 'credentialUnavailable') {\n+        return 'Your Academy session expired. Sign in again.'\n+    }\n+    if (outcome === 'unknown' && mutation) return MAY_HAVE_APPLIED\n+    if (failure === 'cancelled') return 'The request was cancelled.'\n+    if (failure === 'invalidResponse') return 'Academy returned a reply the desktop does not accept.'\n+    return 'Academy could not be reached. Check your connection and try again.'\n+}\n+\n+export function desktopLink<TRouter extends AnyRouter>(options: DesktopLinkOptions): TRPCLink<TRouter> {\n+    return () =>\n+        ({ op }) =>\n+            observable((observer) => {\n+                let stopped = false\n+                const fail = (error: unknown) => {\n+                    if (!stopped) observer.error(error as never)\n+                }\n+                const run = async () => {\n+                    if (op.type === 'subscription') {\n+                        throw desktopError('Live Academy updates are not available on the desktop.', 'METHOD_NOT_SUPPORTED', 'notSent')\n+                    }\n+                    const mutation = op.type === 'mutation'\n+                    const learner = options.learner()\n+                    if (!learner) throw desktopError('Sign in to Academy first.', 'UNAUTHORIZED', 'notSent', { httpStatus: 401 })\n+                    const input =\n+                        op.input === undefined ? null : JSON.stringify(options.transformer.serialize(op.input))\n+                    let response\n+                    try {\n+                        response = await options.client.dispatch({\n+                            kind: 'academyCall',\n+                            learner,\n+                            procedure: op.path,\n+                            procedureKind: op.type,\n+                            input,\n+                        })\n+                    } catch {\n+                        // Admission unknown: nothing is resent; the hook decides.\n+                        throw desktopError(\n+                            mutation ? MAY_HAVE_APPLIED : 'The desktop did not confirm the request.',\n+                            'CLIENT_CLOSED_REQUEST',\n+                            'unknown'\n+                        )\n+                    }\n+                    if (response.outcome === 'refusal') {\n+                        if (response.refusal === 'capabilityMissing') {\n+                            // Not Academy's FORBIDDEN (a grant or progression\n+                            // gate): a guest is asked to sign in, a signed-in\n+                            // learner is told the desktop does not carry it.\n+                            const guest = options.signedIn ? !options.signedIn() : false\n+                            throw guest\n+                                ? desktopError('Sign in to Academy to do this.', 'UNAUTHORIZED', 'notSent', {\n+                                      httpStatus: 401,\n+                                      failure: response.refusal,\n+                                  })\n+                                : desktopError(REFUSAL_TEXT.capabilityMissing!, 'METHOD_NOT_SUPPORTED', 'notSent', {\n+                                      httpStatus: 405,\n+                                      failure: response.refusal,\n+                                  })\n+                        }\n+                        throw desktopError(\n+                            REFUSAL_TEXT[response.refusal] ?? 'The request was refused.',\n+                            'PRECONDITION_FAILED',\n+                            'notSent',\n+                            { failure: response.refusal }\n+                        )\n+                    }\n+                    const operation = response.receipt.operation\n+                    if (!operation) throw desktopError('The desktop returned no operation.', 'INTERNAL_SERVER_ERROR', 'unknown')\n+                    let result\n+                    try {\n+                        result = await options.client.observeAcademyCall(operation)\n+                    } catch {\n+                        // Admitted but its result could not be read.\n+                        throw desktopError(\n+                            mutation ? MAY_HAVE_APPLIED : 'The result is no longer available.',\n+                            'TIMEOUT',\n+                            'unknown'\n+                        )\n+                    }\n+                    if (result.kind === 'failed') {\n+                        const expired = result.failure === 'sessionExpired' || result.failure === 'credentialUnavailable'\n+                        throw desktopError(\n+                            failureMessage(result.failure, result.outcome, mutation),\n+                            expired ? 'UNAUTHORIZED' : 'CLIENT_CLOSED_REQUEST',\n+                            result.outcome,\n+                            { httpStatus: result.failure === 'sessionExpired' ? 401 : 0, failure: result.failure }\n+                        )\n+                    }\n+                    const envelope =\n+                        result.kind === 'data'\n+                            ? { result: { data: JSON.parse(result.data) as unknown } }\n+                            : { error: JSON.parse(result.error) as unknown }\n+                    const transformed = transformResult(envelope as never, options.transformer)\n+                    if (!transformed.ok) {\n+                        // The server's own error, plus what is known of its effect\n+                        // (a 5xx may have applied a mutation).\n+                        const shape = transformed.error as {\n+                            error: { message?: string; data?: Record<string, unknown> }\n+                        }\n+                        if (result.kind === 'error') {\n+                            shape.error.data = { ...(shape.error.data ?? {}), outcome: result.outcome }\n+                            // A server error on a mutation may still have applied\n+                            // it: lead with that guidance and keep the server's\n+                            // own message and codes in `data`.\n+                            if (result.outcome === 'unknown' && mutation) {\n+                                shape.error.data.serverMessage = shape.error.message ?? null\n+                                shape.error.message = MAY_HAVE_APPLIED\n+                            }\n+                        }\n+                        throw TRPCClientError.from(transformed.error)\n+                    }\n+                    if (stopped) return\n+                    observer.next({ result: transformed.result })\n+                    observer.complete()\n+                }\n+                run().catch((error: unknown) =>\n+                    fail(error instanceof TRPCClientError ? error : TRPCClientError.from(error as Error))\n+                )\n+                return () => {\n+                    // Unsubscribing ignores the result; it does not cancel\n+                    // native work (a mutation's effect may already exist).\n+                    stopped = true\n+                }\n+            })\n+}\ndiff --git a/apps/desktop/src/modules/academy/host-actions.test.ts b/apps/desktop/src/modules/academy/host-actions.test.ts\nnew file mode 100644\nindex 00000000..74776f58\n--- /dev/null\n+++ b/apps/desktop/src/modules/academy/host-actions.test.ts\n@@ -0,0 +1,48 @@\n+/**\n+ * Lab work kept on this Mac through the core's offline intents: saved as the\n+ * learner generation's JSON draft, read back only in its expected shape,\n+ * forgotten on request, and reported unkept when the core refuses or fails.\n+ */\n+import { describe, expect, it } from 'vitest'\n+import { nativeLocalDrafts } from './host-actions'\n+import { ACCOUNT, refuse, result, scriptedNative } from './test-support'\n+\n+const ATTEMPT = '00000000-0000-4000-8000-0000000000a1'\n+\n+describe('lab work kept on this Mac', () => {\n+    it('saves, reads back and forgets lab work as the learner generation', async () => {\n+        const kept = { attemptId: ATTEMPT, baseVersion: 3, draft: { debrief: 'kept' }, savedAt: '2026-10-18T12:00:00.000Z' }\n+        const native = scriptedNative({ '@saveLocalDraft': {}, '@loadLocalDraft': kept, '@clearLocalDraft': {} })\n+        const drafts = nativeLocalDrafts(native.client, ACCOUNT)\n+        await expect(drafts.save(ATTEMPT, 3, { debrief: 'kept' })).resolves.toBe(true)\n+        await expect(drafts.load(ATTEMPT)).resolves.toEqual({ baseVersion: 3, draft: { debrief: 'kept' }, savedAt: kept.savedAt })\n+        await expect(drafts.clear(ATTEMPT)).resolves.toBe(true)\n+        expect(native.intents).toEqual([\n+            { kind: 'saveLocalDraft', learner: ACCOUNT, attemptId: ATTEMPT, baseVersion: 3, draft: '{\"debrief\":\"kept\"}' },\n+            { kind: 'loadLocalDraft', learner: ACCOUNT, attemptId: ATTEMPT },\n+            { kind: 'clearLocalDraft', learner: ACCOUNT, attemptId: ATTEMPT },\n+        ])\n+    })\n+\n+    it.each([\n+        ['nothing kept', null],\n+        ['a malformed version', { baseVersion: 'x', draft: {}, savedAt: 'now' }],\n+        ['a draft that is not an object', { baseVersion: 1, draft: 'text', savedAt: 'now' }],\n+    ])('reads back nothing for %s', async (_case, reply) => {\n+        const native = scriptedNative({ '@loadLocalDraft': reply })\n+        await expect(nativeLocalDrafts(native.client, ACCOUNT).load(ATTEMPT)).resolves.toBeNull()\n+    })\n+\n+    it('reports work unkept, unreadable or not forgotten when the core refuses or fails', async () => {\n+        for (const reply of [refuse(), result({ kind: 'failed', failure: 'offlineFull', outcome: 'notSent' })]) {\n+            const native = scriptedNative({ '@saveLocalDraft': reply, '@loadLocalDraft': reply })\n+            const drafts = nativeLocalDrafts(native.client, ACCOUNT)\n+            await expect(drafts.save(ATTEMPT, 0, {})).resolves.toBe(false)\n+            // Unreadable kept work is reported, never answered as none.\n+            await expect(drafts.load(ATTEMPT)).rejects.toThrow()\n+        }\n+        // A clear the core did not confirm is reported, to be asked again.\n+        const failing = scriptedNative({ '@clearLocalDraft': result({ kind: 'failed', failure: 'offlineUnavailable', outcome: 'notSent' }) })\n+        await expect(nativeLocalDrafts(failing.client, ACCOUNT).clear(ATTEMPT)).resolves.toBe(false)\n+    })\n+})\ndiff --git a/apps/desktop/src/modules/academy/host-actions.ts b/apps/desktop/src/modules/academy/host-actions.ts\nnew file mode 100644\nindex 00000000..65e17c19\n--- /dev/null\n+++ b/apps/desktop/src/modules/academy/host-actions.ts\n@@ -0,0 +1,110 @@\n+/**\n+ * Native host actions Academy's pages ask for (print sheet, avatar upload,\n+ * avatar readback) and offline work (downloads, lab work kept on this Mac),\n+ * dispatched as intents of the current learner generation\n+ * and observed like learner calls. Each reports what is known of its\n+ * effect: done, cancelled in a native sheet, failed with nothing changed,\n+ * or possibly applied (Academy may have recorded it).\n+ */\n+import type { HostActionOutcome, LocalDraft, LocalDrafts } from '@ai-security-academy/learner'\n+import type { AcademyCallResult, DesktopClient, Intent, LearnerRef } from '@prisma-airs/desktop-contracts'\n+\n+type HostIntent = Extract<Intent, { kind: 'printPage' | 'uploadAvatar' | 'loadAcademyImage' }>\n+\n+async function run(client: DesktopClient, intent: HostIntent): Promise<AcademyCallResult | 'unconfirmed' | null> {\n+    let response\n+    try {\n+        response = await client.dispatch(intent)\n+    } catch {\n+        return 'unconfirmed'\n+    }\n+    if (response.outcome === 'refusal' || !response.receipt.operation) return null\n+    try {\n+        return await client.observeAcademyCall(response.receipt.operation)\n+    } catch {\n+        return 'unconfirmed'\n+    }\n+}\n+\n+/** The outcome of a host action that may change learner state. */\n+export async function hostAction(client: DesktopClient, intent: HostIntent): Promise<HostActionOutcome> {\n+    const result = await run(client, intent)\n+    // Admission or the result could not be confirmed: only an action that\n+    // can change Academy state may have applied.\n+    if (result === 'unconfirmed') return intent.kind === 'uploadAvatar' ? 'mayHaveApplied' : 'failed'\n+    if (result === null) return 'failed'\n+    if (result.kind === 'data') return 'done'\n+    if (result.outcome === 'unknown') return 'mayHaveApplied'\n+    if (result.kind === 'failed' && result.failure === 'cancelled' && result.outcome === 'notSent') return 'cancelled'\n+    return 'failed'\n+}\n+\n+/** An Academy avatar as a data URL, or null when it cannot be read. */\n+export async function loadAcademyImage(client: DesktopClient, intent: HostIntent): Promise<string | null> {\n+    const result = await run(client, intent)\n+    if (!result || result === 'unconfirmed' || result.kind !== 'data') return null\n+    try {\n+        const src = (JSON.parse(result.data) as { json?: { src?: unknown } }).json?.src\n+        return typeof src === 'string' && src.startsWith('data:image/') ? src : null\n+    } catch {\n+        return null\n+    }\n+}\n+\n+export type OfflineIntent = Extract<\n+    Intent,\n+    { kind: 'downloadCourse' | 'removeDownload' | 'saveLocalDraft' | 'loadLocalDraft' | 'clearLocalDraft' }\n+>\n+\n+/** An offline intent's result; null when it was refused or could not be confirmed. */\n+export async function offlineCall(client: DesktopClient, intent: OfflineIntent): Promise<AcademyCallResult | null> {\n+    try {\n+        const response = await client.dispatch(intent)\n+        if (response.outcome === 'refusal' || !response.receipt.operation) return null\n+        return await client.observeAcademyCall(response.receipt.operation)\n+    } catch {\n+        return null\n+    }\n+}\n+\n+function localDraft(data: string): LocalDraft | null {\n+    try {\n+        const value = (JSON.parse(data) as { json?: unknown }).json\n+        if (!value || typeof value !== 'object') return null\n+        const { baseVersion, draft, savedAt } = value as Record<string, unknown>\n+        return Number.isSafeInteger(baseVersion) && typeof savedAt === 'string' && draft && typeof draft === 'object'\n+            ? { baseVersion: baseVersion as number, draft, savedAt }\n+            : null\n+    } catch {\n+        return null\n+    }\n+}\n+\n+/**\n+ * Lab work Academy has not confirmed, sealed in the core for the signed-in\n+ * learner generation. The core never sends it by itself.\n+ */\n+export function nativeLocalDrafts(client: DesktopClient, learner: LearnerRef): LocalDrafts {\n+    return {\n+        async save(attemptId, baseVersion, draft) {\n+            const result = await offlineCall(client, {\n+                kind: 'saveLocalDraft',\n+                learner,\n+                attemptId,\n+                baseVersion,\n+                draft: JSON.stringify(draft ?? {}),\n+            })\n+            return result?.kind === 'data'\n+        },\n+        async load(attemptId) {\n+            const result = await offlineCall(client, { kind: 'loadLocalDraft', learner, attemptId })\n+            // Kept work that could not be read is not \"none\": the page leaves it untouched.\n+            if (result?.kind !== 'data') throw new Error('kept lab work could not be read')\n+            return localDraft(result.data)\n+        },\n+        async clear(attemptId) {\n+            const result = await offlineCall(client, { kind: 'clearLocalDraft', learner, attemptId })\n+            return result?.kind === 'data'\n+        },\n+    }\n+}\ndiff --git a/apps/desktop/src/modules/academy/learner-bundle.truth.ts b/apps/desktop/src/modules/academy/learner-bundle.truth.ts\nnew file mode 100644\nindex 00000000..8a118748\n--- /dev/null\n+++ b/apps/desktop/src/modules/academy/learner-bundle.truth.ts\n@@ -0,0 +1,27 @@\n+/**\n+ * The desktop production build ships Academy's learner presentation and\n+ * nothing of Academy's truth: no server, database, authored content or\n+ * question banks, content pipeline, scripts, admin features or grading and\n+ * lab-evaluation modules, no server or provider packages, and no seeded\n+ * canary from any of them; every procedure the shipped modules call is\n+ * allowed for the desktop or refused by design (tools/academy/truth-graph.mjs).\n+ */\n+import { expect, it } from 'vitest'\n+import { truthGraph } from '../../../../../tools/academy/truth-graph.mjs'\n+\n+it('ships no Academy truth, privileged module or unexplained procedure', async () => {\n+    const { report } = await truthGraph()\n+    expect(report.controlFound).toBe(true)\n+    expect(report.truthModules).toEqual([])\n+    expect(report.forbiddenPackages).toEqual([])\n+    expect(report.nodeBuiltins).toEqual([])\n+    expect(report.canaryHits).toEqual([])\n+    expect(report.unexplainedRefusals).toEqual([])\n+    expect(report.academyModuleCount).toBeGreaterThan(0)\n+    // The reading and knowledge-check path is carried for an account.\n+    const access = new Map(report.procedures.map((p) => [p.procedure, p.access]))\n+    for (const procedure of ['units.get', 'courses.list', 'units.startKnowledgeCheck', 'units.submitKnowledgeCheck']) {\n+        expect(access.get(procedure), procedure).toBe('account')\n+    }\n+    expect(report.passed).toBe(true)\n+})\ndiff --git a/apps/desktop/src/modules/academy/learner-call-probe.tsx b/apps/desktop/src/modules/academy/learner-call-probe.tsx\nnew file mode 100644\nindex 00000000..e26e45a9\n--- /dev/null\n+++ b/apps/desktop/src/modules/academy/learner-call-probe.tsx\n@@ -0,0 +1,38 @@\n+/**\n+ * Fixture builds only (`snapshot.fixtureBuild`, a Rust compile-time fact):\n+ * measures the C04-registered learner-call-overhead budget through the\n+ * production learner transport. It issues sequential `courses.list` queries\n+ * (a public catalog read) through the same desktop tRPC link the learner\n+ * pages use and exposes each dispatch-to-result time for the measurement\n+ * driver (tools/perf/measure_c05.py), which subtracts the synthetic\n+ * endpoint's own handling time from its log.\n+ */\n+import { useState } from 'react'\n+import { useLearnerTrpc } from './learner-provider'\n+\n+export const PROBE_CALLS = 100\n+\n+export default function LearnerCallProbe() {\n+    const trpc = useLearnerTrpc() as unknown as { courses: { list: { query(): Promise<unknown> } } }\n+    const [samples, setSamples] = useState<number[] | null>(null)\n+    const [running, setRunning] = useState(false)\n+    const run = async () => {\n+        setRunning(true)\n+        const taken: number[] = []\n+        for (let i = 0; i < PROBE_CALLS; i += 1) {\n+            const start = performance.now()\n+            await trpc.courses.list.query()\n+            taken.push(Math.round((performance.now() - start) * 1000) / 1000)\n+        }\n+        setSamples(taken)\n+        setRunning(false)\n+    }\n+    return (\n+        <section aria-label='Fixture learner call probe' data-slot='learner-call-probe' className='mt-8 text-[11px]'>\n+            <button type='button' disabled={running} onClick={() => void run()} className='underline'>\n+                Run learner call probe\n+            </button>\n+            <output aria-label='Learner call probe samples'>{samples ? JSON.stringify(samples) : ''}</output>\n+        </section>\n+    )\n+}\ndiff --git a/apps/desktop/src/modules/academy/learner-interactions.test.tsx b/apps/desktop/src/modules/academy/learner-interactions.test.tsx\nnew file mode 100644\nindex 00000000..effbca63\n--- /dev/null\n+++ b/apps/desktop/src/modules/academy/learner-interactions.test.tsx\n@@ -0,0 +1,605 @@\n+/**\n+ * C06 learner interactions through the production desktop transport:\n+ * Academy's own assessment, account, certificate and Program pages in the\n+ * Academy destination, with hosted authority (deadlines, grading, awards and\n+ * submission state come from Academy), truthful unknown outcomes and the\n+ * desktop's native host actions (sign-out, print), Shift timing that slow\n+ * optional reads never block, and course removal behind Academy's\n+ * affected-certification confirmation. Guests are asked to sign in for\n+ * account sections and nothing is sent for them.\n+ */\n+import { render, screen, waitFor, within } from '@testing-library/react'\n+import userEvent from '@testing-library/user-event'\n+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest'\n+import { Academy as AcademyView } from '../../v2/academy/academy'\n+import { ACADEMY_ORIGIN, ACCOUNT, academySnapshot, held, lostReply, result, scriptedNative, type Replies } from './test-support'\n+\n+function academy(path: string, replies: Replies, signedIn = true) {\n+    const native = scriptedNative(replies)\n+    render(<AcademyView snapshot={academySnapshot(signedIn)} client={native.client} onNavigate={vi.fn()} initialPath={path} />)\n+    return native\n+}\n+\n+const SETTINGS = {\n+    fullName: 'Ada Lovelace',\n+    displayName: 'Ada Lovelace',\n+    role: 'Security Engineer',\n+    region: 'EMEA',\n+    preferences: {\n+        emailDigests: true,\n+        streakReminders: true,\n+        proctorAlerts: false,\n+        labSounds: false,\n+        dailyIncidentAlerts: true,\n+        weeklyRecap: true,\n+        autoplayVideos: false,\n+    },\n+    accent: 'orange',\n+    theme: 'gruvbox',\n+    slaAccommodation: 'standard',\n+    onboardingCompletedAt: '2026-10-01T00:00:00.000Z',\n+    activeCertificationId: 'ai-app-security',\n+    account: { email: 'ada@example.com', firstName: 'Ada', lastName: 'Lovelace', imageUrl: null, avatarUrl: null },\n+}\n+\n+let fetchSpy: ReturnType<typeof vi.fn>\n+beforeEach(() => {\n+    fetchSpy = vi.fn()\n+    vi.stubGlobal('fetch', fetchSpy)\n+    window.scrollTo = vi.fn() as never\n+    window.matchMedia = vi.fn().mockReturnValue({ matches: true, addEventListener: vi.fn(), removeEventListener: vi.fn() }) as never\n+})\n+afterEach(() => {\n+    // The learner transport is the native core; the WebView never fetches.\n+    expect(fetchSpy).not.toHaveBeenCalled()\n+    vi.unstubAllGlobals()\n+})\n+\n+describe('account sections', () => {\n+    it.each(['/', '/program', '/assessment', '/certificate', '/shift', '/dossier', '/settings'])(\n+        'ask a guest to sign in at %s and send nothing for it',\n+        async (path) => {\n+            const { calls } = academy(path, {}, false)\n+            expect(await screen.findByRole('heading', { level: 1, name: 'Sign in to continue' })).toBeInTheDocument()\n+            // The page sends nothing; the chrome's Learning paths row reads the public catalog (paths.list) as the guest.\n+            expect(calls.filter((c) => c.procedure !== 'paths.list')).toEqual([])\n+            expect(calls.every((c) => c.procedureKind === 'query')).toBe(true)\n+            const nav = screen.getByRole('navigation', { name: 'Academy sections' })\n+            expect(within(nav).getAllByRole('link').map((l) => l.textContent)).toEqual(['Learn'])\n+        }\n+    )\n+\n+    it(\"show Academy's own navigation and the desktop's Downloads to a signed-in learner\", async () => {\n+        academy('/learn', { 'paths.list': [], 'library.list': [] })\n+        const nav = await screen.findByRole('navigation', { name: 'Academy sections' })\n+        expect(within(nav).getAllByRole('link').map((l) => l.textContent)).toEqual(['Home', 'Learn', 'Program', 'Downloads', 'Notifications', 'Settings'])\n+        expect(within(nav).getByRole('link', { name: 'Learn' })).toHaveAttribute('aria-current', 'page')\n+    })\n+})\n+\n+describe('learner account', () => {\n+    const replies = {\n+        'settings.get': SETTINGS,\n+        'shop.list': { items: [], credits: 0 },\n+        'gamification.summary': null,\n+    }\n+\n+    it(\"is reached from Academy's Settings entry\", async () => {\n+        const user = userEvent.setup()\n+        academy('/learn', { ...replies, 'paths.list': [], 'library.list': [] })\n+        const nav = await screen.findByRole('navigation', { name: 'Academy sections' })\n+        await user.click(within(nav).getByRole('link', { name: 'Settings' }))\n+        expect(await screen.findByRole('heading', { level: 1, name: 'Ada Lovelace' })).toBeInTheDocument()\n+        expect(within(nav).getByRole('link', { name: 'Settings' })).toHaveAttribute('aria-current', 'page')\n+    })\n+\n+    it('signs out through the desktop and leaves appearance to the app', async () => {\n+        const user = userEvent.setup()\n+        const { intents } = academy('/settings', replies)\n+        expect(await screen.findByRole('heading', { level: 1, name: 'Ada Lovelace' })).toBeInTheDocument()\n+        expect(screen.getByText(/This app sets the theme and accent/)).toBeInTheDocument()\n+        expect(screen.queryByRole('radiogroup', { name: 'Interface theme' })).toBeNull()\n+        await user.click(screen.getByRole('button', { name: 'Sign out' }))\n+        expect(intents.at(-1)).toEqual({ kind: 'signOutAcademy' })\n+    })\n+\n+    const AVATAR = `${ACADEMY_ORIGIN}/api/avatars/user_2fixturelearner.png?v=7`\n+    const PNG = 'data:image/png;base64,iVBORw0KGgo='\n+    const JPEG = 'data:image/jpeg;base64,/9j/4AAQ'\n+    const MAY_HAVE_CHANGED =\n+        'Your photo may have changed, but Academy did not confirm it. The photo shown is what Academy serves now; upload again if it is not the one you chose.'\n+    const withAvatar = { ...SETTINGS, account: { ...SETTINGS.account, avatarUrl: AVATAR } }\n+\n+    it('uploads a new photo natively, re-reads Academy and shows the photo the core reads back', async () => {\n+        const user = userEvent.setup()\n+        let uploaded = false\n+        const { intents, calls } = academy('/settings', (procedure, _learner, input) => {\n+            if (procedure === 'settings.get') return uploaded ? withAvatar : SETTINGS\n+            if (procedure === '@uploadAvatar') {\n+                uploaded = true\n+                return withAvatar\n+            }\n+            if (procedure === '@loadAcademyImage') return input === AVATAR ? { src: PNG } : undefined\n+            return replies[procedure as keyof typeof replies]\n+        })\n+        await user.click(await screen.findByRole('button', { name: 'Change photo' }))\n+        expect(intents).toContainEqual({ kind: 'uploadAvatar', learner: ACCOUNT })\n+        // The renderer never presigns or uploads; the core does.\n+        expect(calls.some((c) => c.procedure.startsWith('settings.avatar') || c.procedure === 'settings.confirmAvatar')).toBe(false)\n+        await waitFor(() => expect(document.querySelector('[data-slot=\"avatar-upload\"] img')).toHaveAttribute('src', PNG))\n+        expect(intents).toContainEqual({ kind: 'loadAcademyImage', learner: ACCOUNT, url: AVATAR })\n+        expect(screen.queryByRole('alert')).toBeNull()\n+    })\n+\n+    it.each([\n+        ['cancelled in the picker', result({ kind: 'failed', failure: 'cancelled', outcome: 'notSent' }), null],\n+        ['an unsupported image', result({ kind: 'failed', failure: 'unsupportedImage', outcome: 'notSent' }), 'Upload failed. Your photo is unchanged; try again.'],\n+        ['a refused destination', result({ kind: 'failed', failure: 'destinationRefused', outcome: 'notSent' }), 'Upload failed. Your photo is unchanged; try again.'],\n+        ['a denied upload', result({ kind: 'error', error: JSON.stringify({ json: { message: 'x', code: -32003, data: { code: 'FORBIDDEN', httpStatus: 403 } } }), httpStatus: 403, outcome: 'rejected' }), 'Upload failed. Your photo is unchanged; try again.'],\n+        ['an unconfirmed confirmation', result({ kind: 'failed', failure: 'network', outcome: 'unknown' }), MAY_HAVE_CHANGED],\n+        ['a stored photo whose reply was lost', result({ kind: 'failed', failure: 'uploadFailed', outcome: 'unknown' }), MAY_HAVE_CHANGED],\n+        ['a stored photo whose confirmation was denied', result({ kind: 'error', error: JSON.stringify({ json: { message: 'x', code: -32004, data: { code: 'NOT_FOUND', httpStatus: 404 } } }), httpStatus: 404, outcome: 'unknown' }), MAY_HAVE_CHANGED],\n+        ['a store that refused the photo', result({ kind: 'failed', failure: 'uploadFailed', outcome: 'rejected' }), 'Upload failed. Your photo is unchanged; try again.'],\n+    ])('reports %s truthfully', async (_case, reply, message) => {\n+        const user = userEvent.setup()\n+        let reads = 0\n+        academy('/settings', (procedure) => {\n+            if (procedure === 'settings.get') {\n+                reads += 1\n+                return SETTINGS\n+            }\n+            if (procedure === '@uploadAvatar') return reply\n+            return replies[procedure as keyof typeof replies]\n+        })\n+        await user.click(await screen.findByRole('button', { name: 'Change photo' }))\n+        if (message) expect(await screen.findByRole('alert')).toHaveTextContent(message)\n+        else {\n+            await new Promise((r) => setTimeout(r, 50))\n+            expect(screen.queryByRole('alert')).toBeNull()\n+        }\n+        // Academy is re-read only when the photo may have changed.\n+        await new Promise((r) => setTimeout(r, 50))\n+        expect(reads > 1).toBe(message === MAY_HAVE_CHANGED)\n+    })\n+\n+    it('reads the photo Academy serves again after an upload that may have replaced it at the same address', async () => {\n+        const user = userEvent.setup()\n+        let served = PNG\n+        const { intents } = academy('/settings', (procedure, _learner, input) => {\n+            if (procedure === 'settings.get') return withAvatar\n+            if (procedure === '@loadAcademyImage') return input === AVATAR ? { src: served } : undefined\n+            if (procedure === '@uploadAvatar') {\n+                served = JPEG\n+                return result({ kind: 'failed', failure: 'uploadFailed', outcome: 'unknown' })\n+            }\n+            return replies[procedure as keyof typeof replies]\n+        })\n+        await waitFor(() => expect(document.querySelector('[data-slot=\"avatar-upload\"] img')).toHaveAttribute('src', PNG))\n+        await user.click(screen.getByRole('button', { name: 'Change photo' }))\n+        expect(await screen.findByRole('alert')).toHaveTextContent(MAY_HAVE_CHANGED)\n+        await waitFor(() => expect(document.querySelector('[data-slot=\"avatar-upload\"] img')).toHaveAttribute('src', JPEG))\n+        expect(intents.filter((i) => i.kind === 'loadAcademyImage' && i.url === AVATAR).length).toBeGreaterThanOrEqual(2)\n+    })\n+\n+    it('removes the photo with Academy and returns to initials', async () => {\n+        const user = userEvent.setup()\n+        let removed = false\n+        const { calls } = academy('/settings', (procedure) => {\n+            if (procedure === 'settings.get') return removed ? SETTINGS : withAvatar\n+            if (procedure === 'settings.removeAvatar') {\n+                removed = true\n+                return SETTINGS\n+            }\n+            if (procedure === '@loadAcademyImage') return { src: PNG }\n+            return replies[procedure as keyof typeof replies]\n+        })\n+        await waitFor(() => expect(document.querySelector('[data-slot=\"avatar-upload\"] img')).toHaveAttribute('src', PNG))\n+        await user.click(screen.getByRole('button', { name: 'Remove photo' }))\n+        await waitFor(() => expect(document.querySelector('[data-slot=\"avatar-upload\"] img')).toBeNull())\n+        expect(calls.filter((c) => c.procedure === 'settings.removeAvatar')).toHaveLength(1)\n+    })\n+})\n+\n+describe('certificates', () => {\n+    const certificate = {\n+        certId: 'cert-certification',\n+        kind: 'certification',\n+        certificationId: 'ai-app-security',\n+        certTitle: 'Certified AI Application Security Professional',\n+        certificationTitle: 'AI Application Security',\n+        score: 92,\n+        breakdown: { courses: [{ courseId: 'ai-gateway', weight: 1, earnedWeight: 1, scorePercent: 100 }] },\n+        issuedAt: '2026-06-30T00:00:00.000Z',\n+        revokedAt: null,\n+        recipientName: 'Ada Lovelace',\n+    }\n+\n+    it(\"link verification to Academy web and download through the desktop's print sheet\", async () => {\n+        const user = userEvent.setup()\n+        const { intents } = academy('/certificate', { 'certificate.mine': [certificate], '@printPage': { opened: true } })\n+        await screen.findByTestId('certificate-credential')\n+        // The public verify URL (shared to LinkedIn, copied, in the QR code)\n+        // is on Academy web's origin, not the desktop's.\n+        const share = screen.getByRole('link', { name: /Add to LinkedIn/ }).getAttribute('href') ?? ''\n+        expect(new URL(share).searchParams.get('certUrl')).toBe(`${ACADEMY_ORIGIN}/verify/cert-certification`)\n+        await user.click(screen.getByRole('button', { name: /Download PDF/ }))\n+        expect(intents.at(-1)).toEqual({ kind: 'printPage', learner: ACCOUNT })\n+        expect(screen.queryByRole('alert')).toBeNull()\n+    })\n+\n+    it('says so when the print sheet cannot open and changes nothing', async () => {\n+        const user = userEvent.setup()\n+        const { calls } = academy('/certificate', {\n+            'certificate.mine': [certificate],\n+            '@printPage': result({ kind: 'failed', failure: 'hostUnavailable', outcome: 'notSent' }),\n+        })\n+        await screen.findByTestId('certificate-credential')\n+        const before = calls.length\n+        await user.click(screen.getByRole('button', { name: /Download PDF/ }))\n+        expect(await screen.findByRole('alert')).toHaveTextContent('The print sheet could not open. Your certificate is unchanged')\n+        expect(calls.slice(before).filter((c) => c.procedureKind === 'mutation')).toEqual([])\n+        expect(screen.getByTestId('certificate-credential')).toBeInTheDocument()\n+    })\n+})\n+\n+describe('final assessment', () => {\n+    const ATTEMPT = '00000000-0000-4000-8000-0000000000e1'\n+    const active = {\n+        attemptId: ATTEMPT,\n+        // Academy's deadline: the desktop never computes or sends one.\n+        deadline: new Date(Date.now() + 60 * 60 * 1000).toISOString(),\n+        questions: [\n+            {\n+                id: 'q1',\n+                moduleId: 'm',\n+                objectiveId: 'o',\n+                type: 'mcq',\n+                prompt: 'Where does AIRS evaluate a request?',\n+                options: ['Before the model', 'After shipping'],\n+            },\n+        ],\n+        answers: {},\n+        terminalItems: [],\n+    }\n+\n+    it('checks an unconfirmed submission with Academy before allowing a retry, never resending it', async () => {\n+        const user = userEvent.setup()\n+        const { calls } = academy('/assessment', (procedure) => {\n+            switch (procedure) {\n+                case 'exam.getActive':\n+                    return active\n+                case 'exam.answer':\n+                    return { saved: true }\n+                case 'exam.submit':\n+                    return lostReply()\n+                case 'exam.submissionState':\n+                    return { attemptId: ATTEMPT, status: 'submitted' }\n+                case 'exam.result':\n+                    return { status: 'grading', gradingCount: 1 }\n+                default:\n+                    return undefined\n+            }\n+        })\n+        await user.click(await screen.findByRole('button', { name: /Before the model/ }))\n+        await user.click(screen.getByRole('button', { name: /See results/ }))\n+        expect(await screen.findByText(/We could not confirm submission/)).toBeInTheDocument()\n+        await new Promise((r) => setTimeout(r, 50))\n+        expect(calls.filter((c) => c.procedure === 'exam.submit')).toHaveLength(1)\n+\n+        await user.click(screen.getByRole('button', { name: 'Check submission status' }))\n+        // Academy recorded it: the result comes from Academy, not a resend.\n+        expect(await screen.findByRole('heading', { level: 1, name: 'Grading your written answers' })).toBeInTheDocument()\n+        expect(calls.filter((c) => c.procedure === 'exam.submit')).toHaveLength(1)\n+        expect(calls.filter((c) => c.procedure === 'exam.submissionState')).toHaveLength(1)\n+        // Only learner answers travel: no clock, verdict or award fields.\n+        for (const call of calls.filter((c) => c.procedure.startsWith('exam.') && c.input)) {\n+            expect(call.input).not.toMatch(/deadline|score|passed|award|correct|startedAt/)\n+        }\n+    })\n+\n+    it('keeps the attempt open for a retry only when Academy says it is still in progress', async () => {\n+        const user = userEvent.setup()\n+        let submits = 0\n+        const { calls } = academy('/assessment', (procedure) => {\n+            if (procedure === 'exam.getActive') return active\n+            if (procedure === 'exam.answer') return { saved: true }\n+            if (procedure === 'exam.submissionState') return { attemptId: ATTEMPT, status: 'in-progress' }\n+            if (procedure === 'exam.submit') {\n+                submits += 1\n+                return submits === 1\n+                    ? lostReply()\n+                    : {\n+                          status: 'graded',\n+                          attemptId: ATTEMPT,\n+                          scorePercent: 40,\n+                          passed: false,\n+                          passThreshold: 70,\n+                          certTitle: 'Certified AI Application Security Professional',\n+                          perCourse: [],\n+                          results: [{ questionId: 'q1', correct: false }],\n+                          award: null,\n+                      }\n+            }\n+            return undefined\n+        })\n+        await user.click(await screen.findByRole('button', { name: /Before the model/ }))\n+        await user.click(screen.getByRole('button', { name: /See results/ }))\n+        await user.click(await screen.findByRole('button', { name: 'Check submission status' }))\n+        await user.click(await screen.findByRole('button', { name: 'Retry submission' }))\n+        await waitFor(() => expect(calls.filter((c) => c.procedure === 'exam.submit')).toHaveLength(2))\n+        // Academy's grade is what the learner sees.\n+        expect(await screen.findByTestId('exam-score')).toHaveTextContent('40%')\n+        // The retry is the learner's, for the same attempt.\n+        const attempts = calls.filter((c) => c.procedure === 'exam.submit').map((c) => JSON.parse(c.input ?? '{}').json.attemptId)\n+        expect(attempts).toEqual([ATTEMPT, ATTEMPT])\n+    })\n+})\n+\n+describe('assessment timer', () => {\n+    const ATTEMPT = '00000000-0000-4000-8000-0000000000e2'\n+    const session = (deadlineInMs: number) => ({\n+        attemptId: ATTEMPT,\n+        // Academy's deadline; the desktop only counts down to it.\n+        deadline: new Date(Date.now() + deadlineInMs).toISOString(),\n+        questions: [{ id: 'q1', moduleId: 'm', objectiveId: 'o', type: 'mcq', prompt: 'Where does AIRS evaluate a request?', options: ['Before the model', 'After shipping'] }],\n+        answers: {},\n+        terminalItems: [],\n+    })\n+    const graded = { status: 'graded', attemptId: ATTEMPT, scorePercent: 0, passed: false, passThreshold: 70, certTitle: 'Cert', perCourse: [], results: [{ questionId: 'q1', correct: false }], award: null }\n+\n+    it(\"shows Academy's countdown in view and submits once at the deadline\", async () => {\n+        const active = session(125_000)\n+        academy('/assessment', { 'exam.getActive': active })\n+        const timer = await screen.findByRole('timer', { name: 'Time remaining' })\n+        expect(timer.textContent).toMatch(/^02:0[0-5]$/)\n+        expect(timer.closest('[data-slot=\"academy-status\"]')).not.toBeNull()\n+        expect(screen.getByText('Proctored')).toBeInTheDocument()\n+    })\n+\n+    it('submits exactly once when the deadline passes and shows Academy’s grade', async () => {\n+        const { calls } = academy('/assessment', { 'exam.getActive': session(1_200), 'exam.submit': graded })\n+        await screen.findByRole('timer', { name: 'Time remaining' })\n+        expect(await screen.findByTestId('exam-score', {}, { timeout: 4000 })).toHaveTextContent('0%')\n+        await new Promise((r) => setTimeout(r, 1200))\n+        expect(calls.filter((c) => c.procedure === 'exam.submit')).toHaveLength(1)\n+        expect(screen.queryByRole('timer')).toBeNull()\n+    })\n+\n+    it('reports an unknown outcome at the deadline once and never resends it', async () => {\n+        const { calls } = academy('/assessment', {\n+            'exam.getActive': session(1_000),\n+            'exam.submit': lostReply(),\n+            'exam.submissionState': { attemptId: ATTEMPT, status: 'submitted' },\n+        })\n+        expect(await screen.findByText(/We could not confirm submission/, {}, { timeout: 4000 })).toBeInTheDocument()\n+        await new Promise((r) => setTimeout(r, 2200))\n+        expect(calls.filter((c) => c.procedure === 'exam.submit')).toHaveLength(1)\n+    })\n+\n+    it('stops with the attempt: leaving it or another learner generation submits nothing', async () => {\n+        const user = userEvent.setup()\n+        const native = scriptedNative({ 'exam.getActive': session(1_500), 'exam.submit': graded })\n+        const view = render(<AcademyView snapshot={academySnapshot(true)} client={native.client} onNavigate={vi.fn()} initialPath='/assessment' />)\n+        await screen.findByRole('timer', { name: 'Time remaining' })\n+        await user.click(within(screen.getByRole('navigation', { name: 'Academy sections' })).getByRole('link', { name: 'Program' }))\n+        await waitFor(() => expect(screen.queryByRole('timer')).toBeNull())\n+        await new Promise((r) => setTimeout(r, 2000))\n+        expect(native.calls.filter((c) => c.procedure === 'exam.submit')).toHaveLength(0)\n+        view.unmount()\n+\n+        const second = scriptedNative({ 'exam.getActive': session(1_500), 'exam.submit': graded })\n+        const again = render(<AcademyView snapshot={academySnapshot(true)} client={second.client} onNavigate={vi.fn()} initialPath='/assessment' />)\n+        await screen.findByRole('timer', { name: 'Time remaining' })\n+        again.rerender(<AcademyView snapshot={academySnapshot(true, 'lx-cccccccccccccccccccccccc')} client={second.client} onNavigate={vi.fn()} initialPath='/assessment' />)\n+        await new Promise((r) => setTimeout(r, 2000))\n+        expect(second.calls.filter((c) => c.procedure === 'exam.submit' && c.learner === ACCOUNT)).toHaveLength(0)\n+    })\n+})\n+\n+describe('lesson feedback', () => {\n+    const lesson = (status: 'done' | 'not_started') => ({\n+        id: 'm-rt-1-lesson-01',\n+        moduleId: 'm-rt-1',\n+        order: 1,\n+        slug: '1',\n+        title: 'Scanning at runtime: part 1',\n+        xp: 100,\n+        estMinutes: 5,\n+        status,\n+        kind: 'content',\n+        bodyHtml: '<p>Lesson body.</p>',\n+        objectives: [],\n+        inlineChecks: [],\n+        sourceLessonId: 'lesson-scan-1',\n+        siblings: [],\n+        pathContext: null,\n+    })\n+\n+    it('asks for a rating on a completed lesson and sends it once', async () => {\n+        const user = userEvent.setup()\n+        const { calls } = academy('/units/m-rt-1-lesson-01', {\n+            'units.get': lesson('done'),\n+            'admin.feedback.submit': { id: 'fb-1' },\n+        })\n+        await screen.findByTestId('feedback-widget')\n+        await user.click(within(screen.getByRole('group', { name: 'Rating' })).getAllByRole('button')[3]!)\n+        await user.click(screen.getByRole('button', { name: /Submit/ }))\n+        expect(await screen.findByTestId('feedback-thanks')).toBeInTheDocument()\n+        const sent = calls.filter((c) => c.procedure === 'admin.feedback.submit')\n+        expect(sent).toHaveLength(1)\n+        expect(JSON.parse(sent[0]!.input ?? '{}').json).toEqual({ moduleId: 'm-rt-1', lessonId: 'lesson-scan-1', rating: 4 })\n+    })\n+\n+    it('does not ask before the lesson is complete', async () => {\n+        academy('/units/m-rt-1-lesson-01', { 'units.get': lesson('not_started') })\n+        expect(await screen.findByRole('heading', { level: 1, name: 'Scanning at runtime: part 1' })).toBeInTheDocument()\n+        expect(screen.queryByTestId('feedback-widget')).toBeNull()\n+    })\n+})\n+\n+describe('shift', () => {\n+    const SHIFT = '00000000-0000-4000-8000-0000000000d1'\n+    const run = (stamped: boolean) => ({\n+        shiftId: SHIFT,\n+        stage: 1,\n+        stagesCleared: 0,\n+        alertsAnswered: 1,\n+        integrityLeft: 3,\n+        chain: 2,\n+        xpAwarded: 12,\n+        alert: { id: 'q2', type: 'mcq', prompt: 'A scan flags a prompt injection. What do you do first?', options: ['Block the request', 'Ignore it'] },\n+        alertOrder: 2,\n+        atBoundary: false,\n+        countermeasures: [],\n+        draft: [],\n+        rating: 100,\n+        // Academy's clock: the desktop renders this, it never computes one.\n+        serverNow: '2026-10-17T12:00:00.000Z',\n+        deadlineAt: stamped ? '2026-10-17T12:01:00.000Z' : null,\n+        slaTotalSeconds: stamped ? 60 : null,\n+        ruledOutOption: null,\n+        actor: null,\n+        suspectOption: null,\n+        optionRevealDelaySeconds: 0,\n+        alertsPerStage: 5,\n+        isBossProbe: false,\n+    })\n+\n+    it('serves and answers a timed alert while the optional briefing has not arrived', async () => {\n+        const user = userEvent.setup()\n+        let served = false\n+        const { calls } = academy('/shift', (procedure) => {\n+            switch (procedure) {\n+                case 'orientation.get':\n+                    return {\n+                        completedAt: '2026-10-01T00:00:00.000Z',\n+                        skippedAt: null,\n+                        hintsSeen: { 'watch-floor-explainer': '2026-10-01', 'watch-floor-unlocked': '2026-10-01' },\n+                    }\n+                case 'shift.getActive':\n+                    return run(served)\n+                case 'shift.serve':\n+                    served = true\n+                    return { breachResolved: false, settled: null }\n+                case 'shift.briefing':\n+                case 'shift.daily':\n+                    return held()\n+                case 'shift.answer':\n+                    return held()\n+                case 'shift.eligibility':\n+                    return { unlocked: true, poolCount: 80, minQuestions: 50 }\n+                default:\n+                    return undefined\n+            }\n+        })\n+        expect(await screen.findByText('A scan flags a prompt injection. What do you do first?')).toBeInTheDocument()\n+        // The unstamped alert is served at once although the briefing is pending.\n+        await waitFor(() => expect(calls.filter((c) => c.procedure === 'shift.serve')).toHaveLength(1))\n+        await user.click(await screen.findByRole('button', { name: 'Block the request' }))\n+        await waitFor(() => expect(screen.getByRole('button', { name: 'Submit' })).toBeEnabled())\n+        await user.click(screen.getByRole('button', { name: 'Submit' }))\n+        await waitFor(() => expect(calls.filter((c) => c.procedure === 'shift.answer')).toHaveLength(1))\n+        const answer = JSON.parse(calls.find((c) => c.procedure === 'shift.answer')!.input ?? '{}').json\n+        // Only the learner's choice travels: no clock, grade or award.\n+        expect(answer).toEqual({ shiftId: SHIFT, order: 2, values: ['0'] })\n+        expect(calls.some((c) => c.procedure === 'shift.briefing')).toBe(true)\n+    })\n+})\n+\n+describe('course removal', () => {\n+    const COURSE = {\n+        id: 'runtime-security',\n+        slug: 'runtime-security',\n+        title: 'Runtime Security Foundations',\n+        description: 'Scan prompts and responses at runtime.',\n+        iconKey: null,\n+        estMinutes: 60,\n+        status: 'published',\n+    }\n+    const replies = {\n+        'paths.list': [],\n+        'courses.list': [COURSE],\n+        'paths.forCourse': [],\n+        'progress.courseSummary': { hasProgress: true, units: 3, quizzes: 1, labs: 0, objectives: 2 },\n+        'units.listByPath': [\n+            {\n+                moduleId: 'm-rt-1',\n+                title: 'Scanning at runtime',\n+                description: 'Scanning at runtime.',\n+                concepts: [],\n+                estMinutes: 30,\n+                order: 1,\n+                unitsDone: 3,\n+                unitCount: 6,\n+                percent: 50,\n+                xpEarned: 300,\n+                xpTotal: 600,\n+                complete: false,\n+                reuseCount: 1,\n+                resumeUnitId: 'm-rt-1-lesson-04',\n+            },\n+        ],\n+        'modules.intro': null,\n+        'enrollment.affectedByCourseRemoval': {\n+            certifications: [\n+                {\n+                    certificationId: 'ai-app-security',\n+                    title: 'AI Application Security',\n+                    courses: [\n+                        { courseId: 'runtime-security', title: 'Runtime Security Foundations' },\n+                        { courseId: 'model-security', title: 'Model Security' },\n+                    ],\n+                },\n+            ],\n+        },\n+        'enrollment.removeByCourse': { removedCertifications: ['ai-app-security'] },\n+    }\n+\n+    it('names every affected certification and course and keeps earned certificates before removing', async () => {\n+        const user = userEvent.setup()\n+        const { calls } = academy('/courses/runtime-security', replies)\n+        await user.click(await screen.findByRole('button', { name: 'Remove enrollment' }))\n+        const dialog = await screen.findByRole('dialog', { name: 'Remove this course?' })\n+        expect(dialog).toHaveTextContent('AI Application Security')\n+        expect(dialog).toHaveTextContent('Runtime Security Foundations, Model Security')\n+        expect(dialog).toHaveTextContent('Certificates you’ve already earned stay valid.')\n+        expect(calls.some((c) => c.procedure === 'enrollment.removeByCourse')).toBe(false)\n+        await user.click(within(dialog).getByRole('button', { name: 'Remove enrollment' }))\n+        await waitFor(() => expect(calls.filter((c) => c.procedure === 'enrollment.removeByCourse')).toHaveLength(1))\n+        expect(JSON.parse(calls.find((c) => c.procedure === 'enrollment.removeByCourse')!.input ?? '{}').json).toEqual({\n+            courseId: 'runtime-security',\n+        })\n+        expect(calls.some((c) => c.procedure === 'progress.resetCourse')).toBe(false)\n+    })\n+\n+    it('resets course progress only after a confirmation with the counts and certificates kept', async () => {\n+        const user = userEvent.setup()\n+        const { calls } = academy('/courses/runtime-security', {\n+            ...replies,\n+            'progress.resetCourse': { reset: true },\n+        })\n+        await user.click(await screen.findByRole('button', { name: 'Reset course progress' }))\n+        const dialog = await screen.findByRole('dialog', { name: 'Reset your progress?' })\n+        expect(dialog).toHaveTextContent('3 units, 1 quizzes, 0 labs')\n+        expect(dialog).toHaveTextContent('Certificates you’ve already earned stay valid.')\n+        await user.click(within(dialog).getByRole('button', { name: 'Cancel' }))\n+        expect(calls.some((c) => c.procedure === 'progress.resetCourse')).toBe(false)\n+        await user.click(screen.getByRole('button', { name: 'Reset course progress' }))\n+        const again = await screen.findByRole('dialog', { name: 'Reset your progress?' })\n+        await user.click(within(again).getByRole('button', { name: 'Reset course progress' }))\n+        await waitFor(() => expect(calls.filter((c) => c.procedure === 'progress.resetCourse')).toHaveLength(1))\n+        expect(JSON.parse(calls.find((c) => c.procedure === 'progress.resetCourse')!.input ?? '{}').json).toEqual({\n+            courseId: 'runtime-security',\n+        })\n+    })\n+\n+    it('offers no removal when Academy reports no affected certification', async () => {\n+        const { calls } = academy('/courses/runtime-security', {\n+            ...replies,\n+            'enrollment.affectedByCourseRemoval': { certifications: [] },\n+        })\n+        expect(await screen.findByRole('heading', { level: 1, name: 'Runtime Security Foundations' })).toBeInTheDocument()\n+        await waitFor(() => expect(calls.some((c) => c.procedure === 'enrollment.affectedByCourseRemoval')).toBe(true))\n+        expect(screen.queryByRole('button', { name: 'Remove enrollment' })).toBeNull()\n+    })\n+})\ndiff --git a/apps/desktop/src/modules/academy/learner-provider.test.tsx b/apps/desktop/src/modules/academy/learner-provider.test.tsx\nnew file mode 100644\nindex 00000000..cc497c49\n--- /dev/null\n+++ b/apps/desktop/src/modules/academy/learner-provider.test.tsx\n@@ -0,0 +1,71 @@\n+/**\n+ * Learner query state is scoped to one account generation: a new learner\n+ * reference starts from an empty cache and never shows the previous\n+ * account's replies.\n+ */\n+import { act, render, screen } from '@testing-library/react'\n+import { useQuery } from '@tanstack/react-query'\n+import { describe, expect, it } from 'vitest'\n+import { DesktopClient, type Intent } from '@prisma-airs/desktop-contracts'\n+import { LearnerProvider, learnerQueryClient, useLearnerTrpc } from './learner-provider'\n+\n+function native(reply: (intent: Intent) => string) {\n+    const dispatched: Intent[] = []\n+    let n = 0\n+    const data = new Map<string, string>()\n+    const client = new DesktopClient({\n+        async observe(bytes: Uint8Array) {\n+            const body = JSON.parse(new TextDecoder().decode(bytes)) as { scope: { kind: string; operation?: string } }\n+            if (body.scope.kind === 'deliverySession') return { kind: 'deliverySession', session: `ds-${'d'.repeat(32)}`, nextSequence: '1' }\n+            return { kind: 'academyCall', result: { kind: 'data', data: data.get(body.scope.operation ?? '') } }\n+        },\n+        async dispatch(bytes: Uint8Array) {\n+            const intent = (JSON.parse(new TextDecoder().decode(bytes)) as { intent: Intent }).intent\n+            dispatched.push(intent)\n+            n += 1\n+            data.set(`op-${n}`, reply(intent))\n+            return { outcome: 'receipt', receipt: { kind: 'admitted', request: `rq-${n}`, operation: `op-${n}` } }\n+        },\n+        openChannel: () => ({ token: 't', close: () => undefined }),\n+    })\n+    return { client, dispatched }\n+}\n+\n+function Progress() {\n+    const trpc = useLearnerTrpc() as unknown as { progress: { get: { query(): Promise<{ done: number }> } } }\n+    const { data } = useQuery({ queryKey: ['progress.get'], queryFn: () => trpc.progress.get.query() })\n+    return <p>{data ? `done ${data.done}` : 'loading'}</p>\n+}\n+\n+describe('learner provider', () => {\n+    it('gives each learner reference its own cache and calls under that reference', async () => {\n+        const { client, dispatched } = native((intent) =>\n+            JSON.stringify({ json: { done: intent.kind === 'academyCall' && intent.learner.endsWith('a') ? 1 : 7 } })\n+        )\n+        const view = render(\n+            <LearnerProvider client={client} learner='lx-aaaaaaaaaaaaaaaaaaaaaaaa'>\n+                <Progress />\n+            </LearnerProvider>\n+        )\n+        expect(await screen.findByText('done 1')).toBeInTheDocument()\n+        await act(async () =>\n+            view.rerender(\n+                <LearnerProvider client={client} learner='lx-bbbbbbbbbbbbbbbbbbbbbbbb'>\n+                    <Progress />\n+                </LearnerProvider>\n+            )\n+        )\n+        // The new account never sees the old account's cached reply.\n+        expect(screen.queryByText('done 1')).toBeNull()\n+        expect(await screen.findByText('done 7')).toBeInTheDocument()\n+        expect(dispatched.map((i) => (i.kind === 'academyCall' ? i.learner : null))).toEqual([\n+            'lx-aaaaaaaaaaaaaaaaaaaaaaaa',\n+            'lx-bbbbbbbbbbbbbbbbbbbbbbbb',\n+        ])\n+    })\n+\n+    it('never retries mutations and stops on authorization failures', () => {\n+        const qc = learnerQueryClient()\n+        expect(qc.getDefaultOptions().mutations?.retry).toBe(false)\n+    })\n+})\ndiff --git a/apps/desktop/src/modules/academy/learner-provider.tsx b/apps/desktop/src/modules/academy/learner-provider.tsx\nnew file mode 100644\nindex 00000000..06a489dd\n--- /dev/null\n+++ b/apps/desktop/src/modules/academy/learner-provider.tsx\n@@ -0,0 +1,154 @@\n+/**\n+ * Account-scoped React Query cache and Academy learner host. Every learner\n+ * reference (an account generation, or the guest generation while signed\n+ * out) gets its own QueryClient and a remounted subtree: signing in or out,\n+ * or changing account, retires the previous cache, so no reply or cached\n+ * value for one account is shown to another. Tenant switches do not change\n+ * the learner reference and keep the cache.\n+ */\n+import { createContext, type ReactNode, useCallback, useContext, useEffect, useMemo } from 'react'\n+import { QueryClient, QueryClientProvider } from '@tanstack/react-query'\n+import { createTRPCClient, TRPCClientError, type TRPCClient } from '@trpc/client'\n+import type { AnyRouter } from '@trpc/server'\n+import SuperJSON from 'superjson'\n+import { LearnerHost } from '@ai-security-academy/learner'\n+import type { DesktopClient, LearnerRef } from '@prisma-airs/desktop-contracts'\n+import { desktopLink } from './desktop-link'\n+import { hostAction, loadAcademyImage, nativeLocalDrafts } from './host-actions'\n+\n+const NO_RETRY = new Set([\n+    'UNAUTHORIZED',\n+    'FORBIDDEN',\n+    'BAD_REQUEST',\n+    'NOT_FOUND',\n+    'PRECONDITION_FAILED',\n+    'METHOD_NOT_SUPPORTED',\n+])\n+\n+/** Queries may be asked once more after a transient failure; mutations never. */\n+export function learnerQueryClient(): QueryClient {\n+    return new QueryClient({\n+        defaultOptions: {\n+            queries: {\n+                staleTime: 60_000,\n+                retry: (count, error) =>\n+                    count < 1 &&\n+                    !(error instanceof TRPCClientError && NO_RETRY.has(String((error.data as { code?: unknown })?.code))),\n+            },\n+            mutations: { retry: false },\n+        },\n+    })\n+}\n+\n+const TrpcContext = createContext<TRPCClient<AnyRouter> | null>(null)\n+\n+/** A plain learner tRPC client for the current generation (inside a provider). */\n+export function useLearnerTrpc<TRouter extends AnyRouter>(): TRPCClient<TRouter> {\n+    const client = useContext(TrpcContext)\n+    if (!client) throw new Error('useLearnerTrpc needs a LearnerProvider')\n+    return client as unknown as TRPCClient<TRouter>\n+}\n+\n+interface Props {\n+    client: DesktopClient\n+    learner: LearnerRef\n+    /** Academy's account id when signed in; null for the guest generation. */\n+    accountId?: string | null\n+    /** The signed-in account's display name, for Academy's account pages. */\n+    displayName?: string | null\n+    theme?: 'gruvbox' | 'paper'\n+    /** Academy web's origin (public links such as certificate verify URLs). */\n+    webOrigin?: string | null\n+    children: ReactNode\n+}\n+\n+function Generation({\n+    client,\n+    learner,\n+    accountId = null,\n+    displayName = null,\n+    theme = 'gruvbox',\n+    webOrigin = null,\n+    children,\n+}: Props) {\n+    const queryClient = useMemo(() => learnerQueryClient(), [])\n+    const links = useMemo(\n+        () => [\n+            desktopLink<AnyRouter>({\n+                client,\n+                learner: () => learner,\n+                signedIn: () => accountId !== null,\n+                transformer: SuperJSON,\n+            }),\n+        ],\n+        [client, learner, accountId]\n+    )\n+    const trpc = useMemo(() => createTRPCClient<AnyRouter>({ links }), [links])\n+    // The generation is Academy's learner session: a new one (sign-in,\n+    // sign-out, reset, even for the same account) retires Academy's\n+    // learner-scoped state.\n+    const identity = useMemo(\n+        () => ({\n+            userId: accountId,\n+            session: learner,\n+            // The desktop knows the account's display name only; the email\n+            // and uploaded photo come from Academy's settings read.\n+            profile: accountId ? { fullName: displayName, firstName: null, email: null, imageUrl: null } : null,\n+        }),\n+        [accountId, learner, displayName]\n+    )\n+    // Native actions Academy's pages ask the host for: sign-out ends the\n+    // learner session in the core; print opens the native print sheet; the\n+    // avatar is chosen, checked and uploaded natively and read back as a\n+    // data URL (this WebView loads no remote images).\n+    const onSignOut = useCallback(() => void client.dispatch({ kind: 'signOutAcademy' }).catch(() => undefined), [client])\n+    const onPrint = useCallback(() => hostAction(client, { kind: 'printPage', learner }), [client, learner])\n+    const onUploadAvatar = useCallback(() => hostAction(client, { kind: 'uploadAvatar', learner }), [client, learner])\n+    const loadImage = useCallback(\n+        (url: string) => loadAcademyImage(client, { kind: 'loadAcademyImage', learner, url }),\n+        [client, learner]\n+    )\n+    // Lab work Academy has not confirmed is sealed in the core for this\n+    // account (signed in only); the core never sends it by itself.\n+    const localDrafts = useMemo(\n+        () => (accountId === null ? undefined : nativeLocalDrafts(client, learner)),\n+        [client, learner, accountId]\n+    )\n+    useEffect(() => () => queryClient.clear(), [queryClient])\n+    return (\n+        <QueryClientProvider client={queryClient}>\n+            <TrpcContext.Provider value={trpc}>\n+                <LearnerHost\n+                    links={links}\n+                    queryClient={queryClient}\n+                    identity={identity}\n+                    theme={theme}\n+                    labs='desktop'\n+                    diagrams='prerendered'\n+                    webOrigin={webOrigin}\n+                    onSignOut={onSignOut}\n+                    onPrint={onPrint}\n+                    remoteImages={false}\n+                    loadImage={loadImage}\n+                    avatarUpload={accountId !== null}\n+                    onUploadAvatar={onUploadAvatar}\n+                    appearance='host'\n+                    assessorTools={false}\n+                    awardPresenters={false}\n+                    courseReset\n+                    lessonFeedback\n+                    localDrafts={localDrafts}\n+                >\n+                    {children}\n+                </LearnerHost>\n+            </TrpcContext.Provider>\n+        </QueryClientProvider>\n+    )\n+}\n+\n+export function LearnerProvider(props: Props) {\n+    // Keyed by generation: query observers bind to the client they first\n+    // saw, so the learner subtree remounts and keeps nothing from the\n+    // previous account.\n+    return <Generation key={props.learner} {...props} />\n+}\ndiff --git a/apps/desktop/src/modules/academy/learner-routes.test.tsx b/apps/desktop/src/modules/academy/learner-routes.test.tsx\nnew file mode 100644\nindex 00000000..79128278\n--- /dev/null\n+++ b/apps/desktop/src/modules/academy/learner-routes.test.tsx\n@@ -0,0 +1,68 @@\n+/**\n+ * Every Academy route the desktop carries, rendered for a signed-in learner\n+ * over a native core that admits exactly what the real one does: the\n+ * learner allowlist (with its procedure kinds) and the public queries,\n+ * refusing anything else before it is sent. Academy never answers here, so\n+ * only the refusals can surface. No route may show an error toast, and\n+ * every refusal must be one the truth graph names as refused by design with\n+ * a reason: two Home queries, and the silent product beacons.\n+ */\n+import { render, screen } from '@testing-library/react'\n+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest'\n+import procedures from '@prisma-airs/desktop-contracts/fixtures/academy/learner-procedures.json'\n+import { Academy as AcademyView } from '../../v2/academy/academy'\n+import { academySnapshot, held, refuse, scriptedNative } from './test-support'\n+\n+const ADMITTED = new Map<string, string>([\n+    ...procedures.learner.map((p) => [p.procedure, p.kind] as [string, string]),\n+    ...procedures.public.map((p) => [p, 'query'] as [string, string]),\n+])\n+\n+// Queries tools/academy/truth-graph.mjs lists as refused by design, each\n+// with the reason the page stays truthful without them.\n+const REFUSED_QUERIES = new Set(['gamification.firstRotation', 'paths.recommended'])\n+const REFUSED_MUTATIONS = new Set(['telemetry.track'])\n+\n+const ROUTES = [\n+    '/',\n+    '/learn',\n+    '/program',\n+    '/assessment',\n+    '/assessment/intro',\n+    '/assessment/identity-practical',\n+    '/certificate',\n+    '/certificate/cert-certification',\n+    '/shift',\n+    '/dossier',\n+    '/leaderboard',\n+    '/settings',\n+    '/notifications',\n+    '/shop',\n+    '/orientation',\n+    '/onboarding',\n+    '/downloads',\n+]\n+\n+beforeEach(() => {\n+    window.scrollTo = vi.fn() as never\n+    window.matchMedia = vi.fn().mockReturnValue({ matches: true, addEventListener: vi.fn(), removeEventListener: vi.fn() }) as never\n+})\n+afterEach(() => vi.unstubAllGlobals())\n+\n+describe('desktop learner routes', () => {\n+    it.each(ROUTES)('%s sends only admitted procedures and shows no refusal', async (path) => {\n+        const native = scriptedNative((procedure) => (ADMITTED.has(procedure) ? held() : refuse()))\n+        render(<AcademyView snapshot={academySnapshot(true)} client={native.client} onNavigate={vi.fn()} initialPath={path} />)\n+        await new Promise((r) => setTimeout(r, 300))\n+        const refused = native.calls.filter((c) => !ADMITTED.has(c.procedure))\n+        const unexplained = refused.filter((c) =>\n+            c.procedureKind === 'query' ? !REFUSED_QUERIES.has(c.procedure) : !REFUSED_MUTATIONS.has(c.procedure)\n+        )\n+        expect(unexplained.map((c) => `${c.procedureKind} ${c.procedure}`)).toEqual([])\n+        // Admitted procedures are called with their admitted kind.\n+        for (const c of native.calls.filter((c) => ADMITTED.has(c.procedure))) {\n+            expect([c.procedure, c.procedureKind]).toEqual([c.procedure, ADMITTED.get(c.procedure)])\n+        }\n+        expect(screen.queryByRole('alert')).toBeNull()\n+    })\n+})\ndiff --git a/apps/desktop/src/modules/academy/offline-work.test.tsx b/apps/desktop/src/modules/academy/offline-work.test.tsx\nnew file mode 100644\nindex 00000000..57ded46d\n--- /dev/null\n+++ b/apps/desktop/src/modules/academy/offline-work.test.tsx\n@@ -0,0 +1,144 @@\n+/**\n+ * Offline Academy work in the destination: the Downloads page for a signed-in\n+ * account (download, update and remove through the core's offline intents,\n+ * with each failure said plainly), its absence for guests, the notice shown\n+ * while Academy cannot be reached, and lab work kept on this Mac.\n+ */\n+import { render, screen, waitFor, within } from '@testing-library/react'\n+import userEvent from '@testing-library/user-event'\n+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest'\n+import type { DownloadView } from '@prisma-airs/desktop-contracts'\n+import { Academy as AcademyView } from '../../v2/academy/academy'\n+import { ACCOUNT, academySnapshot, result, scriptedNative } from './test-support'\n+\n+const COURSES = [\n+    { id: 'runtime-security', slug: 'runtime-security', title: 'Runtime Security', description: '', iconKey: null, estMinutes: 30 },\n+    { id: 'red-teaming', slug: 'red-teaming', title: 'Red Teaming', description: '', iconKey: null, estMinutes: 45 },\n+]\n+\n+const kept = (overrides: Partial<DownloadView> = {}): DownloadView => ({\n+    courseId: 'runtime-security',\n+    title: 'Runtime Security',\n+    revision: 'rev-1',\n+    downloadedAt: '2026-10-18T12:00:00.000Z',\n+    leaseExpiresAt: '2026-10-25T12:00:00.000Z',\n+    status: 'current',\n+    units: 6,\n+    firstUnit: 'm-rt-1-lesson-01',\n+    ...overrides,\n+})\n+\n+const ready = (downloads: DownloadView[], extra: Record<string, unknown> = {}) =>\n+    academySnapshot(true, ACCOUNT, { state: 'ready', downloads, ...extra })\n+\n+beforeEach(() => {\n+    window.scrollTo = vi.fn() as never\n+    window.matchMedia = vi.fn().mockReturnValue({ matches: true, addEventListener: vi.fn(), removeEventListener: vi.fn() }) as never\n+})\n+afterEach(() => vi.unstubAllGlobals())\n+\n+describe('Academy downloads', () => {\n+    it('downloads a course Academy offers through the core and says so', async () => {\n+        const native = scriptedNative({ 'courses.list': COURSES, '@downloadCourse': { courseId: 'red-teaming', units: 4 } })\n+        render(<AcademyView snapshot={ready([kept()])} client={native.client} onNavigate={vi.fn()} initialPath='/downloads' />)\n+        expect(await screen.findByRole('heading', { level: 1, name: 'Downloads' })).toBeTruthy()\n+        expect(screen.getByText(/Videos, walkthroughs and live labs still need Academy/)).toBeTruthy()\n+        const onMac = screen.getByRole('region', { name: 'On this Mac' })\n+        expect(within(onMac).getByText('Runtime Security')).toBeTruthy()\n+        expect(within(onMac).getByText(/Ready offline · 6 units · until/)).toBeTruthy()\n+        // A kept course is not offered again; a current one needs no update.\n+        expect(within(onMac).queryByRole('button', { name: 'Update Runtime Security' })).toBeNull()\n+        // Reading starts at the course's first unit.\n+        expect(within(onMac).getByRole('link', { name: 'Open Runtime Security' })).toHaveAttribute('href', '/units/m-rt-1-lesson-01')\n+        const available = screen.getByRole('region', { name: 'Available to download' })\n+        await within(available).findByText('Red Teaming')\n+        expect(within(available).queryByText('Runtime Security')).toBeNull()\n+        await userEvent.click(within(available).getByRole('button', { name: 'Download Red Teaming' }))\n+        expect(await screen.findByText('Red Teaming is ready offline.')).toBeTruthy()\n+        expect(native.intents.filter((i) => i.kind === 'downloadCourse')).toEqual([\n+            { kind: 'downloadCourse', learner: ACCOUNT, courseId: 'red-teaming' },\n+        ])\n+    })\n+\n+    it.each([\n+        ['notDownloadable', 'Academy does not offer this course to your account for offline use.'],\n+        ['offlineFull', 'There is not enough room for this course in offline storage. Remove a download and try again.'],\n+        ['offlineUnavailable', 'Offline storage could not be opened. Check that Keychain access was allowed.'],\n+        ['invalidResponse', 'The download did not finish. Nothing was kept.'],\n+    ])('says why a download was not kept (%s)', async (failure, text) => {\n+        const native = scriptedNative({\n+            'courses.list': COURSES,\n+            '@downloadCourse': result({ kind: 'failed', failure, outcome: 'notSent' }),\n+        })\n+        render(<AcademyView snapshot={ready([])} client={native.client} onNavigate={vi.fn()} initialPath='/downloads' />)\n+        await userEvent.click(await screen.findByRole('button', { name: 'Download Runtime Security' }))\n+        expect(await screen.findByText(text)).toBeTruthy()\n+    })\n+\n+    it('updates a course with a newer version, removes one, and offers nothing for a withdrawn one', async () => {\n+        const native = scriptedNative({ 'courses.list': COURSES, '@downloadCourse': {}, '@removeDownload': {} })\n+        render(\n+            <AcademyView\n+                snapshot={ready([kept({ status: 'outdated' }), kept({ courseId: 'red-teaming', title: 'Red Teaming', status: 'withdrawn' })])}\n+                client={native.client}\n+                onNavigate={vi.fn()}\n+                initialPath='/downloads'\n+            />\n+        )\n+        const onMac = await screen.findByRole('region', { name: 'On this Mac' })\n+        expect(within(onMac).getByText(/A newer version is on Academy/)).toBeTruthy()\n+        expect(within(onMac).getByText('No longer part of your account')).toBeTruthy()\n+        expect(within(onMac).queryByRole('button', { name: 'Update Red Teaming' })).toBeNull()\n+        expect(within(onMac).queryByRole('link', { name: 'Open Red Teaming' })).toBeNull()\n+        await userEvent.click(within(onMac).getByRole('button', { name: 'Update Runtime Security' }))\n+        expect(await screen.findByText('Runtime Security is ready offline.')).toBeTruthy()\n+        await userEvent.click(within(onMac).getByRole('button', { name: 'Remove Red Teaming' }))\n+        expect(await screen.findByText('Red Teaming was removed from this Mac.')).toBeTruthy()\n+        expect(native.intents.filter((i) => i.kind === 'removeDownload')).toEqual([\n+            { kind: 'removeDownload', learner: ACCOUNT, courseId: 'red-teaming' },\n+        ])\n+    })\n+\n+    it('while Academy is unreachable, says so on every page, offers no new downloads and keeps checking', async () => {\n+        const native = scriptedNative({ 'courses.list': COURSES })\n+        const view = render(\n+            <AcademyView\n+                snapshot={ready([kept()], { reachable: false, localDrafts: [{ attemptId: 'att_1', baseVersion: 2, savedAt: '2026-10-18T12:00:00.000Z' }] })}\n+                client={native.client}\n+                onNavigate={vi.fn()}\n+                initialPath='/downloads'\n+            />\n+        )\n+        expect(await screen.findByText(/Academy can't be reached/)).toBeTruthy()\n+        expect(screen.getByText('Connect to Academy to download more courses.')).toBeTruthy()\n+        expect(screen.getByText('One lab draft is saved on this Mac only. Open its lab to send it.')).toBeTruthy()\n+        // The course list is still asked for: its reply is how Academy is seen to be back.\n+        await waitFor(() => expect(native.calls.some((c) => c.procedure === 'courses.list')).toBe(true))\n+        expect(screen.queryByRole('button', { name: 'Download Red Teaming' })).toBeNull()\n+        // Back online, the notice goes and the catalog is offered.\n+        view.rerender(<AcademyView snapshot={ready([kept()])} client={native.client} onNavigate={vi.fn()} initialPath='/downloads' />)\n+        await waitFor(() => expect(screen.queryByText(/Academy can't be reached/)).toBeNull())\n+        expect(await screen.findByRole('button', { name: 'Download Red Teaming' })).toBeTruthy()\n+    })\n+\n+    it('is not offered to guests, and offline storage that could not open says so', async () => {\n+        const guest = scriptedNative({})\n+        const view = render(<AcademyView snapshot={academySnapshot(false)} client={guest.client} onNavigate={vi.fn()} initialPath='/downloads' />)\n+        expect(await screen.findByRole('heading', { level: 1, name: 'Sign in to continue' })).toBeTruthy()\n+        expect(screen.queryByRole('link', { name: 'Downloads' })).toBeNull()\n+        view.unmount()\n+        const native = scriptedNative({ 'courses.list': COURSES })\n+        render(\n+            <AcademyView\n+                snapshot={academySnapshot(true, ACCOUNT, { state: 'unavailable' })}\n+                client={native.client}\n+                onNavigate={vi.fn()}\n+                initialPath='/downloads'\n+            />\n+        )\n+        expect(await screen.findByRole('link', { name: 'Downloads' })).toBeTruthy()\n+        expect(await screen.findByRole('alert')).toBeTruthy()\n+        const button = await screen.findByRole('button', { name: 'Download Runtime Security' })\n+        expect((button as HTMLButtonElement).disabled).toBe(true)\n+    })\n+})\ndiff --git a/apps/desktop/src/modules/academy/offline-work.tsx b/apps/desktop/src/modules/academy/offline-work.tsx\nnew file mode 100644\nindex 00000000..40c4d924\n--- /dev/null\n+++ b/apps/desktop/src/modules/academy/offline-work.tsx\n@@ -0,0 +1,220 @@\n+/**\n+ * Offline Academy work for the signed-in account: the Downloads page (keep a\n+ * course on this Mac, update or remove it), the notice shown while Academy\n+ * cannot be reached. What is kept, its status and reachability come from\n+ * the core's snapshot; downloaded course content stays sealed in the core\n+ * and reaches pages only as the learner calls it answers offline.\n+ */\n+import { createContext, useContext, useState, type ReactNode } from 'react'\n+import { useQuery } from '@tanstack/react-query'\n+import { Link } from '@tanstack/react-router'\n+import { Button, Callout } from '@ai-security-academy/presentation'\n+import { CloudOff, Info } from 'lucide-react'\n+import type { AcademyCallResult, DesktopClient, DownloadView, LearnerRef, ShellSnapshot } from '@prisma-airs/desktop-contracts'\n+import { offlineCall, type OfflineIntent } from './host-actions'\n+import { useLearnerTrpc } from './learner-provider'\n+\n+interface OfflineWork {\n+    client: DesktopClient\n+    learner: LearnerRef\n+    offline: ShellSnapshot['academyOffline']\n+}\n+\n+const OfflineContext = createContext<OfflineWork | null>(null)\n+\n+export function OfflineWorkProvider({ value, children }: { value: OfflineWork; children: ReactNode }) {\n+    return <OfflineContext.Provider value={value}>{children}</OfflineContext.Provider>\n+}\n+\n+/** Shown on every Academy page while the last learner call found Academy unreachable. */\n+export function OfflineNotice() {\n+    const work = useContext(OfflineContext)\n+    if (!work || work.offline.reachable || work.offline.state === 'signedOut') return null\n+    return (\n+        <div data-slot='academy-offline' className='mb-4'>\n+            <Callout tone='default' icon={CloudOff}>\n+                <p>\n+                    Academy can&apos;t be reached. Downloaded courses and lab work saved on this Mac still open.\n+                    Nothing is sent until you choose to send it again.\n+                </p>\n+            </Callout>\n+        </div>\n+    )\n+}\n+\n+const STATUS: Record<DownloadView['status'], string> = {\n+    current: 'Ready offline',\n+    outdated: 'A newer version is on Academy',\n+    expired: 'Offline access ended. Connect to renew it.',\n+    withdrawn: 'No longer part of your account',\n+}\n+\n+const day = (instant: string) =>\n+    new Date(instant).toLocaleDateString(undefined, { year: 'numeric', month: 'short', day: 'numeric' })\n+\n+interface CourseRow {\n+    id: string\n+    title: string\n+}\n+\n+/** While Academy cannot be reached, the course list is asked again now and then (a reply is what tells the core Academy is back). */\n+const RECHECK_MS = 15_000\n+\n+function useCatalog(reachable: boolean) {\n+    const trpc = useLearnerTrpc() as unknown as { courses: { list: { query(): Promise<unknown> } } }\n+    return useQuery({\n+        queryKey: ['desktop', 'offline', 'courses'],\n+        refetchInterval: reachable ? false : RECHECK_MS,\n+        retry: reachable ? 1 : false,\n+        queryFn: async (): Promise<CourseRow[]> => {\n+            const rows = await trpc.courses.list.query()\n+            if (!Array.isArray(rows)) return []\n+            return rows.flatMap((row) =>\n+                row && typeof row === 'object' && typeof row.id === 'string' && typeof row.title === 'string'\n+                    ? [{ id: row.id, title: row.title }]\n+                    : []\n+            )\n+        },\n+    })\n+}\n+\n+const FAILED: Partial<Record<string, string>> = {\n+    notDownloadable: 'Academy does not offer this course to your account for offline use.',\n+    offlineFull: 'There is not enough room for this course in offline storage. Remove a download and try again.',\n+    offlineUnavailable: 'Offline storage could not be opened. Check that Keychain access was allowed.',\n+    network: 'Academy could not be reached. Try again when you are online.',\n+    timeout: 'Academy did not answer in time. Try again.',\n+}\n+\n+function failureText(result: AcademyCallResult | null): string {\n+    if (result?.kind === 'failed') return FAILED[result.failure] ?? 'The download did not finish. Nothing was kept.'\n+    return 'The download did not finish. Nothing was kept.'\n+}\n+\n+/** The Downloads page (signed-in accounts only). */\n+export function DownloadsPage() {\n+    const work = useContext(OfflineContext)\n+    const [busy, setBusy] = useState<string | null>(null)\n+    const [message, setMessage] = useState<string | null>(null)\n+    const offline = work?.offline\n+    const catalog = useCatalog(offline?.reachable ?? true)\n+    if (!work || !offline) return null\n+    const run = async (courseId: string, intent: OfflineIntent, done: string) => {\n+        setBusy(courseId)\n+        setMessage(null)\n+        const result = await offlineCall(work.client, intent)\n+        setBusy(null)\n+        setMessage(result?.kind === 'data' ? done : intent.kind === 'removeDownload' ? 'The download could not be removed.' : failureText(result))\n+    }\n+    const download = (course: CourseRow | DownloadView) => {\n+        const id = 'id' in course ? course.id : course.courseId\n+        void run(id, { kind: 'downloadCourse', learner: work.learner, courseId: id }, `${course.title} is ready offline.`)\n+    }\n+    const remove = (course: DownloadView) =>\n+        void run(course.courseId, { kind: 'removeDownload', learner: work.learner, courseId: course.courseId }, `${course.title} was removed from this Mac.`)\n+    const kept = new Set(offline.downloads.map((d) => d.courseId))\n+    const available = (catalog.data ?? []).filter((c) => !kept.has(c.id))\n+    const closed = offline.state === 'unavailable'\n+    return (\n+        <section aria-labelledby='academy-downloads' className='mx-auto flex max-w-3xl flex-col gap-6 py-6'>\n+            <h1 id='academy-downloads' className='font-display text-academy-ink text-[28px] font-semibold'>\n+                Downloads\n+            </h1>\n+            <Callout tone='default' icon={Info}>\n+                <p>\n+                    Downloaded lessons, knowledge checks and lab instructions open without a connection, sealed on this\n+                    Mac for your account only. Videos, walkthroughs and live labs still need Academy. Progress and\n+                    submissions are sent only when you are online and choose to send them.\n+                </p>\n+            </Callout>\n+            {closed ? (\n+                <p role='alert' className='text-academy-ink text-[14px]'>\n+                    Offline storage could not be opened. Check that Keychain access was allowed, then sign in again.\n+                </p>\n+            ) : null}\n+            <p role='status' aria-live='polite' className='text-academy-ink-soft text-[13px] empty:hidden'>\n+                {message}\n+            </p>\n+            <section aria-labelledby='academy-downloads-kept' className='flex flex-col gap-3'>\n+                <h2 id='academy-downloads-kept' className='text-academy-ink text-[18px] font-semibold'>\n+                    On this Mac\n+                </h2>\n+                {offline.downloads.length === 0 ? (\n+                    <p className='text-academy-ink-soft text-[14px]'>No courses are downloaded yet.</p>\n+                ) : (\n+                    <ul className='flex flex-col gap-2'>\n+                        {offline.downloads.map((d) => (\n+                            <li key={d.courseId} className='border-academy-line rounded-academy-sm flex flex-wrap items-center gap-3 border p-3'>\n+                                <div className='flex min-w-0 flex-1 flex-col'>\n+                                    <span className='text-academy-ink text-[14px] font-medium'>{d.title}</span>\n+                                    <span className='text-academy-ink-soft text-[13px]'>\n+                                        {STATUS[d.status]}\n+                                        {d.status === 'current' || d.status === 'outdated'\n+                                            ? ` · ${d.units} ${d.units === 1 ? 'unit' : 'units'} · until ${day(d.leaseExpiresAt)}`\n+                                            : ''}\n+                                    </span>\n+                                </div>\n+                                {d.firstUnit && d.status !== 'withdrawn' ? (\n+                                    <Link\n+                                        to='/units/$unitId'\n+                                        params={{ unitId: d.firstUnit }}\n+                                        aria-label={`Open ${d.title}`}\n+                                        className='text-academy-ink inline-flex min-h-11 items-center px-2 text-[13px] underline'\n+                                    >\n+                                        Open\n+                                    </Link>\n+                                ) : null}\n+                                {d.status !== 'withdrawn' && offline.reachable && d.status !== 'current' ? (\n+                                    <Button type='button' tier='secondary' disabled={busy !== null} onClick={() => download(d)} aria-label={`Update ${d.title}`}>\n+                                        Update\n+                                    </Button>\n+                                ) : null}\n+                                <Button type='button' tier='secondary' disabled={busy !== null} onClick={() => remove(d)} aria-label={`Remove ${d.title}`}>\n+                                    Remove\n+                                </Button>\n+                            </li>\n+                        ))}\n+                    </ul>\n+                )}\n+                {offline.localDrafts.length > 0 ? (\n+                    <p className='text-academy-ink-soft text-[13px]' data-slot='academy-local-drafts'>\n+                        {offline.localDrafts.length === 1\n+                            ? 'One lab draft is saved on this Mac only. Open its lab to send it.'\n+                            : `${offline.localDrafts.length} lab drafts are saved on this Mac only. Open each lab to send it.`}\n+                    </p>\n+                ) : null}\n+            </section>\n+            <section aria-labelledby='academy-downloads-available' className='flex flex-col gap-3'>\n+                <h2 id='academy-downloads-available' className='text-academy-ink text-[18px] font-semibold'>\n+                    Available to download\n+                </h2>\n+                {!offline.reachable ? (\n+                    <p className='text-academy-ink-soft text-[14px]'>Connect to Academy to download more courses.</p>\n+                ) : catalog.isPending ? (\n+                    <p className='text-academy-ink-soft text-[14px]'>Loading courses…</p>\n+                ) : catalog.isError ? (\n+                    <p className='text-academy-ink-soft text-[14px]'>The course list could not be loaded.</p>\n+                ) : available.length === 0 ? (\n+                    <p className='text-academy-ink-soft text-[14px]'>Every course is already on this Mac.</p>\n+                ) : (\n+                    <ul className='flex flex-col gap-2'>\n+                        {available.map((c) => (\n+                            <li key={c.id} className='border-academy-line rounded-academy-sm flex items-center gap-3 border p-3'>\n+                                <span className='text-academy-ink min-w-0 flex-1 text-[14px]'>{c.title}</span>\n+                                <Button\n+                                    type='button'\n+                                    tier='primary'\n+                                    disabled={busy !== null || closed}\n+                                    onClick={() => download(c)}\n+                                    aria-label={`Download ${c.title}`}\n+                                >\n+                                    {busy === c.id ? 'Downloading…' : 'Download'}\n+                                </Button>\n+                            </li>\n+                        ))}\n+                    </ul>\n+                )}\n+            </section>\n+        </section>\n+    )\n+}\ndiff --git a/apps/desktop/src/modules/academy/presentation-storage.ts b/apps/desktop/src/modules/academy/presentation-storage.ts\nnew file mode 100644\nindex 00000000..5967972a\n--- /dev/null\n+++ b/apps/desktop/src/modules/academy/presentation-storage.ts\n@@ -0,0 +1,26 @@\n+/**\n+ * Academy's learner pages keep presentation-only state in WebView storage\n+ * under `academy-` keys: the per-account completion-moment latch\n+ * (`academy-completion-moments:<accountId>`) and the unit contents rail\n+ * preference. Server truth always wins, so the latch survives sign-out as\n+ * on Academy web; a completed local-data reset forgets it with everything\n+ * else the desktop kept about the learner.\n+ */\n+export const ACADEMY_STORAGE_PREFIX = 'academy-'\n+\n+/** Removes every Academy presentation key; returns how many were removed. */\n+export function forgetAcademyPresentation(storage: Storage | undefined = globalThis.localStorage): number {\n+    if (!storage) return 0\n+    try {\n+        const keys: string[] = []\n+        for (let i = 0; i < storage.length; i += 1) {\n+            const key = storage.key(i)\n+            if (key?.startsWith(ACADEMY_STORAGE_PREFIX)) keys.push(key)\n+        }\n+        for (const key of keys) storage.removeItem(key)\n+        return keys.length\n+    } catch {\n+        // Storage unavailable: nothing was kept there.\n+        return 0\n+    }\n+}\ndiff --git a/apps/desktop/src/modules/academy/test-support.tsx b/apps/desktop/src/modules/academy/test-support.tsx\nnew file mode 100644\nindex 00000000..4a1d43d0\n--- /dev/null\n+++ b/apps/desktop/src/modules/academy/test-support.tsx\n@@ -0,0 +1,125 @@\n+/**\n+ * Shared harness for Academy destination suites: a scripted native core that\n+ * answers learner calls per procedure (and per learner generation), records\n+ * every intent, and scripts refusals or raw call results; plus shell\n+ * snapshots for the guest and signed-in generations.\n+ */\n+import { DesktopClient, type Intent, type ShellSnapshot } from '@prisma-airs/desktop-contracts'\n+import shellResponse from '@prisma-airs/desktop-contracts/fixtures/wire/observe-shell-response.json'\n+\n+export const GUEST = 'lx-aaaaaaaaaaaaaaaaaaaaaaaa'\n+export const ACCOUNT = 'lx-bbbbbbbbbbbbbbbbbbbbbbbb'\n+export const ACADEMY_ORIGIN = 'https://academy.example'\n+\n+const base = shellResponse.snapshot as ShellSnapshot\n+\n+/** A guest or signed-in shell snapshot for the Academy destination. */\n+export function academySnapshot(\n+    signedIn: boolean,\n+    learner = signedIn ? ACCOUNT : GUEST,\n+    offline: Partial<ShellSnapshot['academyOffline']> = {}\n+): ShellSnapshot {\n+    return {\n+        ...base,\n+        learner,\n+        academyOrigin: ACADEMY_ORIGIN,\n+        academy: signedIn\n+            ? { state: 'signedIn', displayName: 'Ada Lovelace', accountId: 'user_2fixturelearner', learner }\n+            : { state: 'signedOut' },\n+        academyOffline: {\n+            state: signedIn ? 'empty' : 'signedOut',\n+            reachable: true,\n+            downloads: [],\n+            localDrafts: [],\n+            ...offline,\n+        },\n+    } as ShellSnapshot\n+}\n+\n+/** A reply that makes the native core refuse the call before sending it. */\n+export const refuse = (refusal = 'capabilityMissing') => ({ __refusal__: refusal })\n+/** A raw AcademyCallResult (server errors, unknown outcomes). */\n+export const result = (value: unknown) => ({ __result__: value })\n+/** A learner call whose remote outcome is unknown (the reply was lost). */\n+export const lostReply = () => result({ kind: 'failed', failure: 'network', outcome: 'unknown' })\n+const HELD = Symbol('held')\n+/** A learner call Academy has not answered yet (a slow optional read). */\n+export const held = () => ({ __held__: true })\n+\n+export type Replies = Record<string, unknown> | ((procedure: string, learner: string, input: unknown) => unknown)\n+\n+/** Native host and offline actions observed like learner calls, scripted as `@<kind>`. */\n+const HOST_ACTIONS = new Set([\n+    'printPage',\n+    'uploadAvatar',\n+    'loadAcademyImage',\n+    'downloadCourse',\n+    'removeDownload',\n+    'saveLocalDraft',\n+    'loadLocalDraft',\n+    'clearLocalDraft',\n+])\n+\n+/**\n+ * The native core: `replies` maps a procedure (`a.b`) to its data, a scripted\n+ * refusal or a raw result; a function may vary them by learner and input.\n+ * Host actions are scripted as `@printPage`, `@uploadAvatar` and\n+ * `@loadAcademyImage` (input: the image URL); offline actions as\n+ * `@downloadCourse` and the like (input: the course or attempt id, and for\n+ * `@saveLocalDraft` the intent); unscripted ones open nothing.\n+ */\n+export function scriptedNative(replies: Replies) {\n+    const intents: Intent[] = []\n+    const calls: (Intent & { kind: 'academyCall' })[] = []\n+    const results = new Map<string, unknown>()\n+    let n = 0\n+    const lookup = (procedure: string, learner: string, input: unknown) =>\n+        typeof replies === 'function' ? replies(procedure, learner, input) : replies[procedure]\n+    const client = new DesktopClient({\n+        async observe(bytes: Uint8Array) {\n+            const body = JSON.parse(new TextDecoder().decode(bytes)) as { scope: { kind: string; operation?: string } }\n+            if (body.scope.kind === 'deliverySession') {\n+                return { kind: 'deliverySession', session: `ds-${'f'.repeat(32)}`, nextSequence: '1' }\n+            }\n+            const value = results.get(body.scope.operation ?? '')\n+            if (value === HELD) return new Promise(() => undefined)\n+            return { kind: 'academyCall', result: value }\n+        },\n+        async dispatch(bytes: Uint8Array) {\n+            const intent = (JSON.parse(new TextDecoder().decode(bytes)) as { intent: Intent }).intent\n+            intents.push(intent)\n+            n += 1\n+            const host = HOST_ACTIONS.has(intent.kind)\n+            if (intent.kind !== 'academyCall' && !host) {\n+                return { outcome: 'receipt', receipt: { kind: 'admitted', request: `rq-${n}`, operation: null } }\n+            }\n+            let value: unknown\n+            if (intent.kind === 'academyCall') {\n+                calls.push(intent)\n+                const input = intent.input ? (JSON.parse(intent.input) as { json?: unknown }).json : undefined\n+                value = lookup(intent.procedure, intent.learner, input)\n+            } else {\n+                const action = intent as Extract<Intent, { learner: string }> & { url?: string; courseId?: string; attemptId?: string }\n+                const input = intent.kind === 'saveLocalDraft' ? intent : (action.url ?? action.courseId ?? action.attemptId)\n+                value = lookup(`@${intent.kind}`, action.learner, input)\n+                if (value === undefined) value = result({ kind: 'failed', failure: 'hostUnavailable', outcome: 'notSent' })\n+            }\n+            if (value && typeof value === 'object' && '__refusal__' in value) {\n+                return { outcome: 'refusal', refusal: (value as { __refusal__: string }).__refusal__ }\n+            }\n+            results.set(\n+                `op-${n}`,\n+                value && typeof value === 'object' && '__held__' in value\n+                    ? HELD\n+                    : value && typeof value === 'object' && '__result__' in value\n+                    ? (value as { __result__: unknown }).__result__\n+                    : value === undefined\n+                      ? { kind: 'failed', failure: 'network', outcome: 'notSent' }\n+                      : { kind: 'data', data: JSON.stringify({ json: value }) }\n+            )\n+            return { outcome: 'receipt', receipt: { kind: 'admitted', request: `rq-${n}`, operation: `op-${n}` } }\n+        },\n+        openChannel: () => ({ token: '__CHANNEL__:1', close: () => undefined }),\n+    })\n+    return { client, intents, calls }\n+}\ndiff --git a/apps/desktop/src/modules/academy/trpc-link.test.ts b/apps/desktop/src/modules/academy/trpc-link.test.ts\nnew file mode 100644\nindex 00000000..a04449c2\n--- /dev/null\n+++ b/apps/desktop/src/modules/academy/trpc-link.test.ts\n@@ -0,0 +1,252 @@\n+/**\n+ * C05 production learner transport: the desktop tRPC link Academy's learner\n+ * pages are hosted on, against the literal SuperJSON/envelope fixtures the\n+ * Rust `academy_learner` suite replays (packages/desktop-contracts/fixtures/\n+ * academy) and the pinned procedure sets Rust enforces\n+ * (learner-procedures.json). Covers the guest catalog, knowledge-check\n+ * lifecycle, account-generation changes, refusals and truth screening.\n+ */\n+import { createTRPCClient, TRPCClientError } from '@trpc/client'\n+import type { AnyRouter } from '@trpc/server'\n+import SuperJSON from 'superjson'\n+import { afterEach, beforeEach, describe, expect, it, type MockInstance, vi } from 'vitest'\n+import { DesktopClient, type Intent, type LearnerRef } from '@prisma-airs/desktop-contracts'\n+import procedures from '@prisma-airs/desktop-contracts/fixtures/academy/learner-procedures.json'\n+import coursesList from '@prisma-airs/desktop-contracts/fixtures/academy/courses-list.result.json'\n+import startInput from '@prisma-airs/desktop-contracts/fixtures/academy/units-startKnowledgeCheck.input.json'\n+import startResult from '@prisma-airs/desktop-contracts/fixtures/academy/units-startKnowledgeCheck.result.json'\n+import submitInput from '@prisma-airs/desktop-contracts/fixtures/academy/units-submitKnowledgeCheck.input.json'\n+import submitResult from '@prisma-airs/desktop-contracts/fixtures/academy/units-submitKnowledgeCheck.result.json'\n+import canary from '@prisma-airs/desktop-contracts/fixtures/academy/units-get.truth-canary.result.json'\n+import { desktopLink } from './desktop-link'\n+import { learnerQueryClient } from './learner-provider'\n+\n+const GUEST: LearnerRef = 'lx-aaaaaaaaaaaaaaaaaaaaaaaa'\n+const ACCOUNT: LearnerRef = 'lx-bbbbbbbbbbbbbbbbbbbbbbbb'\n+\n+type Reply = { outcome: 'refusal'; refusal: string } | { result: unknown }\n+\n+/**\n+ * A scripted native core: `answer` decides each dispatched intent's reply\n+ * (a refusal, or the AcademyCallResult observed for its operation).\n+ */\n+function native(answer: (intent: Intent & { kind: 'academyCall' }) => Reply) {\n+    const dispatched: (Intent & { kind: 'academyCall' })[] = []\n+    const results = new Map<string, unknown>()\n+    let n = 0\n+    const client = new DesktopClient({\n+        async observe(bytes: Uint8Array) {\n+            const body = JSON.parse(new TextDecoder().decode(bytes)) as { scope: { kind: string; operation?: string } }\n+            if (body.scope.kind === 'deliverySession') {\n+                return { kind: 'deliverySession', session: `ds-${'c'.repeat(32)}`, nextSequence: '1' }\n+            }\n+            return { kind: 'academyCall', result: results.get(body.scope.operation ?? '') }\n+        },\n+        async dispatch(bytes: Uint8Array) {\n+            const intent = (JSON.parse(new TextDecoder().decode(bytes)) as { intent: Intent & { kind: 'academyCall' } })\n+                .intent\n+            dispatched.push(intent)\n+            const reply = answer(intent)\n+            if ('outcome' in reply) return reply\n+            n += 1\n+            results.set(`op-${n}`, reply.result)\n+            return { outcome: 'receipt', receipt: { kind: 'admitted', request: `rq-${n}`, operation: `op-${n}` } }\n+        },\n+        openChannel: () => ({ token: '__CHANNEL__:1', close: () => undefined }),\n+    })\n+    return { client, dispatched }\n+}\n+\n+/** A path-proxied learner client for the current reference (any procedure). */\n+function learnerClient(client: DesktopClient, learner: () => LearnerRef | null) {\n+    return createTRPCClient<AnyRouter>({\n+        links: [desktopLink<AnyRouter>({ client, learner, signedIn: () => learner() === ACCOUNT, transformer: SuperJSON })],\n+    }) as unknown as Record<string, Record<string, Record<string, (input?: unknown) => Promise<unknown>>>>\n+}\n+\n+function call(trpc: ReturnType<typeof learnerClient>, procedure: string, kind: string, input?: unknown) {\n+    let node: unknown = trpc\n+    for (const part of procedure.split('.')) node = (node as Record<string, unknown>)[part]\n+    return (node as Record<string, (input?: unknown) => Promise<unknown>>)[kind === 'query' ? 'query' : 'mutate']!(input)\n+}\n+\n+/** Rust hands the renderer `result.data` of the server envelope as text. */\n+const data = (envelope: { result: { data: unknown } }) => ({\n+    result: { kind: 'data', data: JSON.stringify(envelope.result.data) },\n+})\n+\n+let fetchSpy: MockInstance<typeof fetch>\n+beforeEach(() => {\n+    fetchSpy = vi.spyOn(globalThis, 'fetch')\n+})\n+afterEach(() => {\n+    // The learner transport is the native core; the WebView never fetches.\n+    expect(fetchSpy).not.toHaveBeenCalled()\n+    fetchSpy.mockRestore()\n+})\n+\n+describe('C05 learner transport', () => {\n+    it('labels every pinned procedure with its literal path and kind', async () => {\n+        const all = [\n+            ...procedures.learner.map((p) => [p.procedure, p.kind] as const),\n+            ...procedures.public.map((p) => [p, 'query'] as const),\n+        ]\n+        const { client, dispatched } = native(() => ({ result: { kind: 'data', data: '{\"json\":null}' } }))\n+        const trpc = learnerClient(client, () => ACCOUNT)\n+        for (const [procedure, kind] of all) await call(trpc, procedure, kind)\n+        expect(dispatched.map((i) => [i.procedure, i.procedureKind])).toEqual(all)\n+        expect(new Set(dispatched.map((i) => i.learner))).toEqual(new Set([ACCOUNT]))\n+        expect(dispatched.every((i) => i.input === null)).toBe(true)\n+        // The sets Rust enforces are disjoint from manager and grading routes.\n+        for (const [procedure] of all) {\n+            expect(procedure).not.toMatch(/^(admin\\.(?!feedback\\.submit$)|manager\\.|assessor\\.)|\\.grade$/)\n+        }\n+    })\n+\n+    it('reads the public catalog as the guest generation and revives its literal reply', async () => {\n+        const { client, dispatched } = native(() => data(coursesList))\n+        const courses = (await call(learnerClient(client, () => GUEST), 'courses.list', 'query')) as {\n+            slug: string\n+            updatedAt: Date\n+        }[]\n+        expect(dispatched).toEqual([\n+            { kind: 'academyCall', learner: GUEST, procedure: 'courses.list', procedureKind: 'query', input: null },\n+        ])\n+        expect(courses).toEqual([\n+            {\n+                id: 'runtime-security',\n+                slug: 'runtime-security',\n+                title: 'Runtime Security',\n+                description: 'Scan prompts and responses before they reach users.',\n+                updatedAt: new Date('2026-10-01T09:00:00.000Z'),\n+            },\n+        ])\n+        expect(courses[0]!.updatedAt).toBeInstanceOf(Date)\n+    })\n+\n+    it('runs a knowledge check with byte-identical inputs and literal grades', async () => {\n+        const replies: Record<string, unknown> = {\n+            'units.startKnowledgeCheck': startResult,\n+            'units.submitKnowledgeCheck': submitResult,\n+        }\n+        const { client, dispatched } = native((intent) => data(replies[intent.procedure] as { result: { data: unknown } }))\n+        const trpc = learnerClient(client, () => ACCOUNT)\n+        const attempt = (await call(trpc, 'units.startKnowledgeCheck', 'mutation', { unitId: 'unit-kc-prompt-injection' })) as {\n+            attemptId: string\n+            questions: { id: string; options: string[] }[]\n+        }\n+        expect(attempt.questions[0]).toEqual({\n+            id: 'q-pi-1',\n+            moduleId: 'm-prompt-injection',\n+            objectiveId: 'obj-untrusted-input',\n+            type: 'mcq',\n+            prompt: 'Which input should a runtime scan treat as untrusted?',\n+            options: ['Retrieved web content', \"The application's own constant labels\"],\n+            weight: 1,\n+            scope: 'module',\n+            lessonId: null,\n+        })\n+        const graded = (await call(trpc, 'units.submitKnowledgeCheck', 'mutation', {\n+            unitId: 'unit-kc-prompt-injection',\n+            attemptId: attempt.attemptId,\n+            answers: [{ questionId: 'q-pi-1', value: 0 }],\n+        })) as { passed: boolean; scorePercent: number; results: unknown[] }\n+        expect(dispatched.map((i) => [i.procedure, i.procedureKind, i.input])).toEqual([\n+            ['units.startKnowledgeCheck', 'mutation', JSON.stringify(startInput)],\n+            ['units.submitKnowledgeCheck', 'mutation', JSON.stringify(submitInput)],\n+        ])\n+        expect(graded).toEqual({\n+            award: null,\n+            scorePercent: 100,\n+            passed: true,\n+            perObjective: [],\n+            results: [{ questionId: 'q-pi-1', correct: true }],\n+        })\n+        // The grade is the server's: the desktop never saw an answer key.\n+        expect(JSON.stringify(dispatched)).not.toMatch(/answerKey|correctValue/)\n+    })\n+\n+    it('says a knowledge check may have been recorded when Academy fails after receiving it', async () => {\n+        const failure = {\n+            message: 'Internal server error',\n+            code: -32603,\n+            data: { code: 'INTERNAL_SERVER_ERROR', httpStatus: 500, path: 'units.submitKnowledgeCheck' },\n+        }\n+        const { client } = native(() => ({\n+            result: { kind: 'error', error: JSON.stringify({ json: failure }), httpStatus: 500, outcome: 'unknown' },\n+        }))\n+        const error = (await call(learnerClient(client, () => ACCOUNT), 'units.submitKnowledgeCheck', 'mutation', submitInput.json).catch(\n+            (e: unknown) => e\n+        )) as TRPCClientError<AnyRouter>\n+        expect(error).toBeInstanceOf(TRPCClientError)\n+        expect(error.message).toBe('Academy may have applied this change. Check its current state before trying again.')\n+        expect(error.data).toMatchObject({ code: 'INTERNAL_SERVER_ERROR', outcome: 'unknown', serverMessage: 'Internal server error' })\n+    })\n+\n+    it('asks a guest to sign in and tells a signed-in learner the desktop does not carry it, never retrying', async () => {\n+        const { client, dispatched } = native((intent) =>\n+            !procedures.public.includes(intent.procedure) &&\n+            !(intent.learner === ACCOUNT && procedures.learner.some((p) => p.procedure === intent.procedure))\n+                ? { outcome: 'refusal', refusal: 'capabilityMissing' }\n+                : { result: { kind: 'data', data: '{\"json\":{\"done\":0}}' } }\n+        )\n+        const retry = learnerQueryClient().getDefaultOptions().queries?.retry as (n: number, e: unknown) => boolean\n+        // A guest reaching an account procedure gets Academy's sign-in gate.\n+        const guest = (await call(learnerClient(client, () => GUEST), 'progress.get', 'query').catch(\n+            (e: unknown) => e\n+        )) as TRPCClientError<AnyRouter>\n+        expect(guest.message).toBe('Sign in to Academy to do this.')\n+        expect(guest.data).toMatchObject({ code: 'UNAUTHORIZED', httpStatus: 401, outcome: 'notSent', failure: 'capabilityMissing' })\n+        expect(retry(0, guest)).toBe(false)\n+        // Signed in, a procedure outside the desktop allowlist is not an\n+        // Academy grant gate (FORBIDDEN): it is not carried by the desktop.\n+        const signed = (await call(learnerClient(client, () => ACCOUNT), 'labs.submitLab', 'mutation').catch(\n+            (e: unknown) => e\n+        )) as TRPCClientError<AnyRouter>\n+        expect(signed.message).toBe('This Academy action is not available on the desktop.')\n+        expect(signed.data).toMatchObject({ code: 'METHOD_NOT_SUPPORTED', httpStatus: 405, outcome: 'notSent' })\n+        expect(retry(0, signed)).toBe(false)\n+        expect(dispatched.map((i) => [i.procedure, i.learner])).toEqual([\n+            ['progress.get', GUEST],\n+            ['labs.submitLab', ACCOUNT],\n+        ])\n+    })\n+\n+    it('calls under the current generation and reports a superseded one as an account change', async () => {\n+        let current: LearnerRef | null = GUEST\n+        const { client, dispatched } = native((intent) =>\n+            intent.learner === current\n+                ? { result: { kind: 'data', data: '{\"json\":[]}' } }\n+                : { outcome: 'refusal', refusal: 'staleContext' }\n+        )\n+        const trpc = learnerClient(client, () => current)\n+        await call(trpc, 'paths.list', 'query')\n+        current = ACCOUNT\n+        await call(trpc, 'paths.list', 'query')\n+        expect(dispatched.map((i) => i.learner)).toEqual([GUEST, ACCOUNT])\n+\n+        // A client still bound to the guest generation after sign-in.\n+        const stale = learnerClient(client, () => GUEST)\n+        const error = (await call(stale, 'paths.list', 'query').catch((e: unknown) => e)) as TRPCClientError<AnyRouter>\n+        expect(error.message).toBe('The Academy account changed. Reload this page.')\n+        expect(error.data).toMatchObject({ code: 'PRECONDITION_FAILED', outcome: 'notSent' })\n+\n+        current = null\n+        const none = (await call(trpc, 'paths.list', 'query').catch((e: unknown) => e)) as TRPCClientError<AnyRouter>\n+        expect(none.data).toMatchObject({ code: 'UNAUTHORIZED', outcome: 'notSent' })\n+        expect(dispatched).toHaveLength(3)\n+    })\n+\n+    it('shows a screened reply as unacceptable without any of its content', async () => {\n+        // Rust screens `units-get.truth-canary.result.json` (it carries an\n+        // answer key) and reports only the failure.\n+        expect(JSON.stringify(canary)).toContain('AIRS-C05-TRUTH-CANARY')\n+        const { client } = native(() => ({ result: { kind: 'failed', failure: 'invalidResponse', outcome: 'unknown' } }))\n+        const error = (await call(learnerClient(client, () => ACCOUNT), 'units.get', 'query', { unitId: 'unit-kc-prompt-injection' }).catch(\n+            (e: unknown) => e\n+        )) as TRPCClientError<AnyRouter>\n+        expect(error.message).toBe('Academy returned a reply the desktop does not accept.')\n+        expect(error.data).toMatchObject({ failure: 'invalidResponse', outcome: 'unknown' })\n+        expect(JSON.stringify({ message: error.message, data: error.data })).not.toContain('CANARY')\n+    })\n+})\ndiff --git a/apps/desktop/src/modules/administration/management-read.ts b/apps/desktop/src/modules/administration/management-read.ts\nnew file mode 100644\nindex 00000000..40943f10\n--- /dev/null\n+++ b/apps/desktop/src/modules/administration/management-read.ts\n@@ -0,0 +1,108 @@\n+import type {\n+    ContextRef,\n+    ManagementFailure,\n+    ManagementRequest,\n+    ManagementResource,\n+    ManagementResult,\n+} from '@prisma-airs/desktop-contracts'\n+import { RefusedError } from '@prisma-airs/desktop-contracts'\n+import { type Dispatch, outcomeMessage } from '../tenants/dispatch'\n+\n+/** Waits for the single native result of an admitted management read. */\n+export type ObserveManagement = (operation: string) => Promise<ManagementResult>\n+\n+/** What one management read produced, as the presentation shows it. */\n+export type ReadOutcome =\n+    | { kind: 'result'; result: ManagementResult }\n+    /** Not admitted (refused, unconfirmed or undelivered): nothing was read. */\n+    | { kind: 'notAdmitted'; message: string }\n+\n+/**\n+ * Dispatches one management read for `context` and waits for its single\n+ * observation. A read whose context retires while it runs settles as\n+ * `cancelled`; it is never shown as data.\n+ */\n+export async function readManagement(\n+    dispatch: Dispatch,\n+    observe: ObserveManagement,\n+    context: ContextRef,\n+    request: ManagementRequest\n+): Promise<ReadOutcome> {\n+    const outcome = await dispatch({ kind: 'management', context, request })\n+    if (outcome.kind !== 'admitted' || outcome.operation === null) {\n+        return { kind: 'notAdmitted', message: outcomeMessage(outcome) ?? 'The read was not started.' }\n+    }\n+    try {\n+        return { kind: 'result', result: await observe(outcome.operation) }\n+    } catch (error) {\n+        if (error instanceof RefusedError) return { kind: 'notAdmitted', message: outcomeMessage({ kind: 'refused', refusal: error.refusal }) ?? '' }\n+        return { kind: 'notAdmitted', message: 'The desktop did not return the result of this read.' }\n+    }\n+}\n+\n+/** Sanitized operator text for each management failure (no server text). */\n+export const MANAGEMENT_FAILURE_TEXT: Record<ManagementFailure, string> = {\n+    unauthorized: 'The management client was not accepted. Check the client ID and secret in Settings.',\n+    denied: 'This management client is not allowed to read this. Ask your administrator for the needed role.',\n+    notFound: 'The service did not find this resource.',\n+    rateLimited: 'The service is limiting requests. Wait a moment, then refresh.',\n+    unavailable: 'The management service is unavailable. Try again later.',\n+    rejected: 'The service rejected the request.',\n+    timeout: 'The read took too long and was stopped.',\n+    cancelled: 'The read was stopped because the tenant or its management credential changed.',\n+    network: 'The management service could not be reached.',\n+    destination: 'The service tried to send the read somewhere else. Nothing was followed.',\n+    invalidResponse: 'The service returned a reply the desktop could not use.',\n+    credentialLocked: 'The Keychain is locked. Unlock it and try again.',\n+    credentialDenied: 'macOS did not allow access to the management secret.',\n+    credentialMissing: 'The management secret is missing. Enter it again in Settings.',\n+    configuration: 'The management connection could not be set up for this tenant.',\n+}\n+\n+export interface ResourceInfo {\n+    id: ManagementResource\n+    label: string\n+    group: 'AI Runtime Security' | 'Data Loss Prevention'\n+    /** Fields tried in order for a row's display name. */\n+    nameFields: readonly string[]\n+    /** The service's identity field (detail reads look items up by it). */\n+    idField: string\n+    /** Whether a detail read can address an item of this resource. */\n+    detail: boolean\n+}\n+\n+export const RESOURCES: readonly ResourceInfo[] = [\n+    { id: 'profiles', label: 'Security profiles', group: 'AI Runtime Security', nameFields: ['profile_name'], idField: 'profile_id', detail: true },\n+    { id: 'topics', label: 'Custom topics', group: 'AI Runtime Security', nameFields: ['topic_name'], idField: 'topic_id', detail: true },\n+    { id: 'applications', label: 'Applications', group: 'AI Runtime Security', nameFields: ['app_name', 'customer_app_name'], idField: 'customer_appId', detail: true },\n+    { id: 'apiKeys', label: 'API keys', group: 'AI Runtime Security', nameFields: ['api_key_name'], idField: 'api_key_id', detail: true },\n+    { id: 'deploymentProfiles', label: 'Deployment profiles', group: 'AI Runtime Security', nameFields: ['dp_name'], idField: 'dp_name', detail: true },\n+    { id: 'dlpCatalog', label: 'DLP profiles (AIRS)', group: 'Data Loss Prevention', nameFields: ['name'], idField: 'id', detail: true },\n+    { id: 'dataProfiles', label: 'Data profiles', group: 'Data Loss Prevention', nameFields: ['name'], idField: 'id', detail: true },\n+    { id: 'dataPatterns', label: 'Data patterns', group: 'Data Loss Prevention', nameFields: ['name'], idField: 'id', detail: true },\n+    { id: 'filteringProfiles', label: 'Data filtering profiles', group: 'Data Loss Prevention', nameFields: ['name'], idField: 'id', detail: true },\n+    { id: 'dictionaries', label: 'Dictionaries', group: 'Data Loss Prevention', nameFields: ['name'], idField: 'id', detail: true },\n+]\n+\n+/** A scalar rendered as plain text; nested values as compact JSON text. */\n+export function fieldText(value: unknown): string {\n+    if (value === null || value === undefined) return '—'\n+    if (typeof value === 'string') return value\n+    if (typeof value === 'number' || typeof value === 'boolean') return String(value)\n+    return JSON.stringify(value)\n+}\n+\n+export function itemName(info: ResourceInfo, item: Record<string, unknown>): string {\n+    for (const field of info.nameFields) {\n+        const value = item[field]\n+        if (typeof value === 'string' && value.length > 0) return value\n+    }\n+    return fieldText(item[info.idField])\n+}\n+\n+export function itemId(info: ResourceInfo, item: Record<string, unknown>): string | null {\n+    const value = item[info.idField]\n+    if (typeof value === 'string' && value.length > 0) return value\n+    if (typeof value === 'number') return String(value)\n+    return null\n+}\ndiff --git a/apps/desktop/src/modules/administration/runtime-changes.tsx b/apps/desktop/src/modules/administration/runtime-changes.tsx\nnew file mode 100644\nindex 00000000..81fea7e7\n--- /dev/null\n+++ b/apps/desktop/src/modules/administration/runtime-changes.tsx\n@@ -0,0 +1,727 @@\n+import { type ReactNode, useEffect, useId, useRef, useState } from 'react'\n+import { Button, Callout, Input, cn } from '@ai-security-academy/presentation'\n+import { AlertTriangle, Info, KeyRound } from 'lucide-react'\n+import type {\n+    ChangeAction,\n+    ChangeDraft,\n+    ChangeFailure,\n+    ChangeKind,\n+    ChangeProblem,\n+    ChangeResultView,\n+    ChangeReviewView,\n+    ContextRef,\n+    Provisioning,\n+    ScopeCleanup,\n+    StagedFileFailure,\n+    StagedFileView,\n+    StepState,\n+    WorkspaceRef,\n+} from '@prisma-airs/desktop-contracts'\n+import { type Dispatch, outcomeMessage } from '../tenants/dispatch'\n+import { MANAGEMENT_FAILURE_TEXT } from './management-read'\n+\n+/** What the operator chose to change (body is the editor's initial text). */\n+export interface ChangeTarget {\n+    kind: ChangeKind\n+    action: ChangeAction\n+    target: string\n+    title: string\n+    body: string\n+    /** A Gateway change inside the chosen workspace: its native reference. */\n+    workspace?: WorkspaceRef\n+    /** A Gateway draft kept on this Mac that this change edits (C17). */\n+    draftId?: string\n+    /** Why it cannot be reviewed now (the draft's workspace is not chosen). */\n+    reviewBlocked?: string\n+}\n+\n+const PROBLEM_TEXT: Record<ChangeProblem, string> = {\n+    unsupported: 'This change is not supported.',\n+    target: 'The item to change is missing or invalid.',\n+    body: 'The draft must be a single JSON object.',\n+    contract: 'The draft does not match what the service accepts. Check the field names and values.',\n+    description: 'A custom topic description can have at most 240 characters.',\n+    rotation: 'Key rotation must be 30, 90 or 180 days.',\n+    keyFields: 'Enter the key name, application, environment, cloud provider and deployment profile.',\n+    applicationExists: 'An application with that name already exists. Add a key version to it instead.',\n+    keyExists: 'An API key with that name already exists.',\n+    inventoryLimit: 'The inventory is too large to check completely, so the change was not prepared.',\n+    deploymentProfile: 'The deployment profile was not found exactly once.',\n+    sourceMismatch: 'The key version must use the existing key’s application.',\n+    notFound: 'The item is no longer in the service’s inventory.',\n+    dataProfile:\n+        'The data profile is incomplete: check the name (at most 32 characters), its rules, techniques, confidence levels and occurrence bounds.',\n+    dictionaryFile: 'The keyword list must be non-empty text of at most 65,536 characters.',\n+    fileName: 'The original file name cannot contain slashes, quotes or control characters (at most 255 characters).',\n+    stagedFile: 'The chosen file is no longer available. Choose it again.',\n+    previewOnly: 'Directional settings and customized prompt-injection modes were local previews in the previous desktop; remove them from the draft. They are never sent.',\n+    credentialPolicy:\n+        'Credentials are never part of a draft: remove keys, secret mappings and credential-bearing settings. They are entered only where the desktop protects them.',\n+    protectedConfiguration:\n+        'This item holds credentials the change would replace or lose, so it cannot be changed here. Change its other fields, or its credentials where they are protected.',\n+    workspaceMismatch: 'The draft names a different workspace. Changes apply only to the workspace chosen here.',\n+    configuration: 'The settings do not meet the provider family’s or the guardrail catalog’s rules.',\n+    scopeExists: 'That IAM scope already exists. Choose to reuse it, or name a new one.',\n+    scopeMissing: 'That IAM scope does not exist, so it cannot be reused.',\n+    referenced: 'Other configuration still references this item, so it was not changed.',\n+}\n+\n+const STAGED_TEXT: Record<StagedFileFailure, string> = {\n+    tooLarge: 'That file is larger than 65,536 characters.',\n+    notText: 'That file is not UTF-8 text.',\n+    empty: 'That file has no keywords.',\n+    unreadable: 'That file could not be read.',\n+}\n+\n+export function changeFailureText(failure: ChangeFailure): string {\n+    switch (failure.kind) {\n+        case 'problem':\n+            return PROBLEM_TEXT[failure.problem]\n+        case 'conflict':\n+            return 'The item changed since it was reviewed. Review the change again.'\n+        case 'service':\n+            // A change is stopped by the operator or a tenant change, never\n+            // \"read\".\n+            return failure.failure === 'cancelled'\n+                ? 'The desktop stopped waiting for this change.'\n+                : MANAGEMENT_FAILURE_TEXT[failure.failure]\n+        case 'expired':\n+            return 'This review expired before it was applied. Review the change again.'\n+        case 'capacity':\n+            return 'The desktop could not start the change right now, so nothing was sent. Review it again.'\n+        case 'workspaceChanged':\n+            return 'Another workspace was chosen before this change was sent, so nothing was sent. Review it again in the workspace it is for.'\n+    }\n+}\n+\n+export const CHANGE_NOUN: Record<ChangeKind, string> = {\n+    profiles: 'security profile',\n+    topics: 'custom topic',\n+    applications: 'application',\n+    apiKeys: 'API key',\n+    dataPatterns: 'data pattern',\n+    dataProfiles: 'data profile',\n+    filteringProfiles: 'data filtering profile',\n+    dictionaries: 'dictionary',\n+    gatewayWorkspaces: 'workspace',\n+    gatewayProviders: 'provider',\n+    gatewayRoutes: 'route',\n+    gatewayGuardrails: 'guardrail',\n+    gatewayServiceKeys: 'service key',\n+    gatewayUserKeys: 'user key',\n+    gatewayIntegrations: 'integration',\n+}\n+\n+/** How a change's action reads in a result line. */\n+export function verbOf(kind: ChangeKind, action: ChangeAction): string {\n+    if (kind === 'gatewayWorkspaces' && action === 'delete') return 'Archive'\n+    if (kind === 'gatewayWorkspaces' && action === 'create') return 'Provision'\n+    if (action === 'models') return 'Change models of'\n+    return action.charAt(0).toUpperCase() + action.slice(1)\n+}\n+\n+export const isGatewayKind = (kind: ChangeKind) => kind.startsWith('gateway')\n+\n+const TEXTAREA = cn(\n+    'rounded-academy-md bg-academy-bg-inset border-academy-rule focus-visible:border-academy-accent-ring w-full border px-3.5 py-2.5',\n+    'text-academy-ink min-h-48 resize-y font-mono text-[12px] leading-snug'\n+)\n+\n+function Json({ label, text }: { label: string; text: string | null }) {\n+    if (text === null) return null\n+    let pretty = text\n+    try {\n+        pretty = JSON.stringify(JSON.parse(text), null, 2)\n+    } catch {\n+        // Shown as received.\n+    }\n+    return (\n+        <div className='flex min-w-0 flex-1 flex-col gap-1'>\n+            <span className='text-academy-ink-soft text-[12px] font-medium'>{label}</span>\n+            <pre className='bg-academy-bg-inset rounded-academy-md max-h-72 overflow-auto p-3 font-mono text-[11px] break-all whitespace-pre-wrap'>\n+                {pretty}\n+            </pre>\n+        </div>\n+    )\n+}\n+\n+interface WorkbenchProps {\n+    change: ChangeTarget\n+    review: ChangeReviewView | null\n+    /** The dictionary keyword file chosen in the native sheet, if any. */\n+    staged?: StagedFileView | null\n+    context: ContextRef\n+    dispatch: Dispatch\n+    onClose: () => void\n+    /** Keeps the edited text as a local draft (C17); called after edits pause. */\n+    onDraft?: (body: string) => void\n+    /** Set to the workbench's draft flush, for a host that removes it (Close, Escape, the scrim) before React's cleanup can read the editor. */\n+    flushRef?: React.MutableRefObject<(() => void) | null>\n+    /** Shown under the editor (where the draft is kept). */\n+    note?: ReactNode\n+    /** v2 (C31, I3): Apply stays disabled until the typed name matches the review's. */\n+    requireTyped?: boolean\n+}\n+\n+/** How long typing pauses before a draft is kept. */\n+const DRAFT_PAUSE_MS = 800\n+\n+/** Splits a dictionary body into its metadata JSON and keyword text. */\n+function dictionaryParts(body: string): { metadata: string; keywords: string } {\n+    try {\n+        const parsed = JSON.parse(body) as { metadata?: unknown; file?: unknown }\n+        return { metadata: JSON.stringify(parsed.metadata ?? {}, null, 2), keywords: typeof parsed.file === 'string' ? parsed.file : '' }\n+    } catch {\n+        return { metadata: body, keywords: '' }\n+    }\n+}\n+\n+/**\n+ * Edit, review and apply one Runtime change. The editor is uncontrolled:\n+ * Review and Apply read its current text at the moment they are pressed\n+ * (no debounced copy), and Rust compares Apply's text with the reviewed\n+ * draft. While the native confirmation is open the editor is read-only and\n+ * the main window is held by the sheet.\n+ */\n+export function ChangeWorkbench({ change, review, staged = null, context, dispatch, onClose, onDraft, flushRef, note, requireTyped = false }: WorkbenchProps) {\n+    const ids = useId()\n+    const [typedText, setTypedText] = useState('')\n+    const heading = useRef<HTMLHeadingElement>(null)\n+    const editor = useRef<HTMLTextAreaElement>(null)\n+    const keywords = useRef<HTMLTextAreaElement>(null)\n+    const [useFile, setUseFile] = useState(false)\n+    const dictionary = change.kind === 'dictionaries'\n+    const parts = dictionary ? dictionaryParts(change.body) : null\n+    const typed = useRef<HTMLInputElement>(null)\n+    const [message, setMessage] = useState<string | null>(null)\n+    const [busy, setBusy] = useState(false)\n+    const mine =\n+        review && review.kind === change.kind && review.action === change.action && review.target === change.target\n+            ? review\n+            : null\n+    const confirming = mine?.state === 'confirming'\n+    const blocked = (mine?.references.length ?? 0) > 0\n+    const deletes = change.action === 'delete'\n+\n+    // The chosen file is used only once one is actually staged; a cancelled\n+    // or failed choice leaves the typed keywords in use.\n+    const fileReady = staged?.state === 'ready' && !!staged.token\n+    const usingFile = useFile && fileReady\n+    // Opening a change moves focus to it.\n+    useEffect(() => {\n+        heading.current?.focus()\n+    }, [])\n+    // Edited text is kept as a draft once typing pauses, and on close.\n+    const pending = useRef<ReturnType<typeof setTimeout> | null>(null)\n+    const kept = useRef(change.body)\n+    // The latest text typed, kept apart from the textarea: React's unmount cleanup runs after the textarea is\n+    // detached, so a flush there (or from the host's Close) reads this, never a gone node.\n+    const latest = useRef<string | undefined>(undefined)\n+    function keepDraft() {\n+        if (pending.current) clearTimeout(pending.current)\n+        pending.current = null\n+        const text = editor.current?.value ?? latest.current\n+        if (!onDraft || text === undefined || text === kept.current) return\n+        kept.current = text\n+        onDraft(text)\n+    }\n+    function edited(event?: React.FormEvent<HTMLTextAreaElement>) {\n+        if (event) latest.current = event.currentTarget.value\n+        if (!onDraft) return\n+        if (pending.current) clearTimeout(pending.current)\n+        pending.current = setTimeout(keepDraft, DRAFT_PAUSE_MS)\n+    }\n+    if (flushRef) flushRef.current = keepDraft\n+    useEffect(() => () => keepDraft(), [])\n+    const [awaitingFile, setAwaitingFile] = useState(false)\n+    useEffect(() => {\n+        if (!awaitingFile || staged?.state === 'choosing') return\n+        setAwaitingFile(false)\n+        setUseFile(staged?.state === 'ready')\n+    }, [awaitingFile, staged?.state])\n+\n+    /** The draft as entered now, or null (with a message) when it cannot be sent. */\n+    function draft(): ChangeDraft | null {\n+        const text = editor.current?.value ?? ''\n+        let body = deletes ? '{}' : text\n+        if (dictionary && !deletes) {\n+            // Read fresh from the fields. The metadata must be exactly one JSON\n+            // object: it is parsed, never spliced into the body as text.\n+            let metadata: unknown\n+            try {\n+                metadata = JSON.parse(text)\n+            } catch {\n+                metadata = null\n+            }\n+            if (typeof metadata !== 'object' || metadata === null || Array.isArray(metadata)) {\n+                setMessage('The dictionary metadata must be one JSON object.')\n+                return null\n+            }\n+            body = JSON.stringify(\n+                usingFile && staged?.token\n+                    ? { metadata, fileRef: staged.token }\n+                    : { metadata, file: keywords.current?.value ?? '' }\n+            )\n+        }\n+        const captured: ChangeDraft = { kind: change.kind, action: change.action, target: change.target, body }\n+        if (change.workspace) captured.workspace = change.workspace\n+        return captured\n+    }\n+\n+    async function chooseFile() {\n+        setAwaitingFile(true)\n+        setMessage(outcomeMessage(await dispatch({ kind: 'chooseDictionaryFile', context })))\n+    }\n+\n+    async function prepare() {\n+        // The reviewed text is kept first, so a later settlement finds it.\n+        keepDraft()\n+        setMessage(null)\n+        const captured = draft()\n+        if (!captured) return\n+        setBusy(true)\n+        const outcome = await dispatch({ kind: 'reviewChange', context, draft: captured })\n+        setBusy(false)\n+        setMessage(outcomeMessage(outcome))\n+    }\n+\n+    async function apply() {\n+        if (!mine) return\n+        setMessage(null)\n+        const captured = draft()\n+        if (!captured) return\n+        setBusy(true)\n+        const outcome = await dispatch({\n+            kind: 'requestApply',\n+            review: mine.review,\n+            draft: captured,\n+            confirmation: typed.current?.value ?? '',\n+        })\n+        setBusy(false)\n+        if (outcome.kind === 'refused' && outcome.refusal === 'reviewInvalid') {\n+            setMessage('The draft changed since it was reviewed, or the review expired. Review the change again.')\n+        } else if (outcome.kind === 'refused' && outcome.refusal === 'invalidInput') {\n+            setMessage(`Type ${mine.confirmation ?? 'the confirmation'} exactly to confirm.`)\n+        } else setMessage(outcomeMessage(outcome))\n+    }\n+\n+    async function discard() {\n+        keepDraft()\n+        if (mine) await dispatch({ kind: 'discardChange', review: mine.review })\n+        onClose()\n+    }\n+\n+    return (\n+        <section\n+            aria-labelledby={`${ids}-heading`}\n+            data-slot='change-workbench'\n+            className='border-academy-rule flex flex-col gap-4 rounded-[12px] border p-5'\n+        >\n+            <h2 id={`${ids}-heading`} ref={heading} tabIndex={-1} className='text-academy-ink text-[15px] font-semibold outline-none'>\n+                {change.title}\n+            </h2>\n+            {deletes ? (\n+                <p className='text-[13px]'>Review what will be removed before applying.</p>\n+            ) : (\n+                <div className='flex flex-col gap-1'>\n+                    <label htmlFor={`${ids}-editor`} className='text-academy-ink text-[13px] font-medium'>\n+                        {dictionary ? 'dictionary metadata (JSON)' : `${CHANGE_NOUN[change.kind]} draft (JSON)`}\n+                    </label>\n+                    <textarea\n+                        ref={editor}\n+                        id={`${ids}-editor`}\n+                        defaultValue={parts ? parts.metadata : change.body}\n+                        readOnly={confirming}\n+                        spellCheck={false}\n+                        aria-describedby={`${ids}-editor-hint`}\n+                        className={TEXTAREA}\n+                        onInput={edited}\n+                        data-slot='change-editor'\n+                    />\n+                    <p id={`${ids}-editor-hint`} className='text-academy-ink-faint text-[12px]'>\n+                        Authorship is set from the management client. Server-assigned fields are ignored.\n+                        {change.kind === 'profiles'\n+                            ? ' Directional settings and customized prompt-injection modes were local previews in the previous desktop; they are not part of a draft and are never sent.'\n+                            : ''}\n+                    </p>\n+                    {note}\n+                    {parts ? (\n+                        <fieldset className='mt-2 flex flex-col gap-2' data-slot='dictionary-keywords'>\n+                            <legend className='text-academy-ink text-[13px] font-medium'>Keywords</legend>\n+                            <label className='flex min-h-11 items-center gap-2 text-[13px]'>\n+                                <input\n+                                    type='radio'\n+                                    name={`${ids}-source`}\n+                                    checked={!usingFile}\n+                                    disabled={confirming}\n+                                    onChange={() => setUseFile(false)}\n+                                    className='size-4 accent-[var(--academy-accent)]'\n+                                />\n+                                Type them (one per line)\n+                            </label>\n+                            <textarea\n+                                ref={keywords}\n+                                aria-label='Dictionary keywords, one per line'\n+                                defaultValue={parts.keywords}\n+                                readOnly={confirming}\n+                                disabled={usingFile}\n+                                spellCheck={false}\n+                                className={TEXTAREA}\n+                                data-slot='dictionary-text'\n+                            />\n+                            <label className='flex min-h-11 items-center gap-2 text-[13px]'>\n+                                <input\n+                                    type='radio'\n+                                    name={`${ids}-source`}\n+                                    checked={usingFile}\n+                                    disabled={confirming || !fileReady}\n+                                    onChange={() => setUseFile(true)}\n+                                    className='size-4 accent-[var(--academy-accent)]'\n+                                />\n+                                Use the chosen file\n+                                {staged?.state === 'ready' ? ` (${staged.name}, ${staged.lines} lines)` : ''}\n+                            </label>\n+                            <div>\n+                                <Button type='button' tier='secondary' disabled={busy || confirming} onClick={() => void chooseFile()}>\n+                                    Choose keyword file…\n+                                </Button>\n+                            </div>\n+                            <p role='status' className='text-academy-ink-faint text-[12px]' data-slot='dictionary-file-status'>\n+                                {staged?.state === 'choosing'\n+                                    ? 'Choose a text file in the desktop’s file sheet.'\n+                                    : staged?.state === 'failed' && staged.failure\n+                                      ? STAGED_TEXT[staged.failure]\n+                                      : staged?.state === 'ready'\n+                                        ? `Chosen: ${staged.name} (${staged.bytes} bytes). The file itself is only read.`\n+                                        : 'A file is read once by the desktop; it is never changed.'}\n+                            </p>\n+                        </fieldset>\n+                    ) : null}\n+                </div>\n+            )}\n+            {change.reviewBlocked ? (\n+                <p className='text-[13px]' data-slot='change-review-blocked'>\n+                    {change.reviewBlocked}\n+                </p>\n+            ) : null}\n+            <div className='flex flex-wrap gap-2'>\n+                <Button\n+                    type='button'\n+                    tier='secondary'\n+                    disabled={busy || confirming || !!change.reviewBlocked}\n+                    onClick={() => void prepare()}\n+                >\n+                    {mine ? 'Review again' : 'Review change'}\n+                </Button>\n+                <Button type='button' tier='tertiary' disabled={busy} onClick={() => void discard()}>\n+                    Close\n+                </Button>\n+            </div>\n+            {mine ? (\n+                <div className='flex flex-col gap-3' data-slot='change-review'>\n+                    {mine.state === 'preparing' ? (\n+                        <p role='status' className='text-academy-ink-soft text-[13px]'>\n+                            Reading the current item for review…\n+                        </p>\n+                    ) : (mine.state === 'failed' || mine.state === 'expired') && mine.failure ? (\n+                        <Callout tone='danger' icon={AlertTriangle} role='alert' data-slot='change-review-failed'>\n+                            {changeFailureText(mine.failure)}\n+                        </Callout>\n+                    ) : (\n+                        <>\n+                            <Callout tone='warning' icon={Info} data-slot='change-impact'>\n+                                {mine.impact}\n+                            </Callout>\n+                            {mine.workspace ? (\n+                                <p className='text-[13px]' data-slot='change-scope'>\n+                                    Applies to workspace <strong>{mine.workspace.name}</strong> ({mine.workspace.slug}), IAM scope{' '}\n+                                    {mine.workspace.scopeName}.\n+                                </p>\n+                            ) : null}\n+                            {blocked ? (\n+                                <div role='alert' className='flex flex-col gap-1 text-[13px]' data-slot='change-references'>\n+                                    <p className='font-medium'>\n+                                        This cannot be applied while other configuration references it:\n+                                    </p>\n+                                    <ul className='list-disc pl-5'>\n+                                        {mine.references.map((r) => (\n+                                            <li key={r}>{r}</li>\n+                                        ))}\n+                                    </ul>\n+                                </div>\n+                            ) : null}\n+                            <div className='flex flex-wrap gap-3'>\n+                                <Json label='Existing key' text={mine.sourceKey} />\n+                                <Json label='Current' text={mine.before} />\n+                                <Json label='After applying' text={mine.after} />\n+                            </div>\n+                            {mine.after === null && change.action === 'delete' ? (\n+                                <p className='text-[13px]'>After applying, the item is removed.</p>\n+                            ) : null}\n+                            <label htmlFor={`${ids}-confirm`} className='text-academy-ink text-[13px] font-medium'>\n+                                Type {mine.confirmation ?? 'the confirmation'} to confirm\n+                            </label>\n+                            <Input\n+                                ref={typed}\n+                                id={`${ids}-confirm`}\n+                                autoComplete='off'\n+                                spellCheck={false}\n+                                readOnly={confirming}\n+                                data-slot='change-confirmation'\n+                                onChange={(e) => setTypedText(e.currentTarget.value)}\n+                            />\n+                            <div>\n+                                <Button\n+                                    type='button'\n+                                    tier='primary'\n+                                    disabled={busy || confirming || blocked || (requireTyped && typedText !== (mine.confirmation ?? ''))}\n+                                    onClick={() => void apply()}\n+                                >\n+                                    Apply…\n+                                </Button>\n+                            </div>\n+                            {confirming ? (\n+                                <p role='status' className='text-academy-ink-soft text-[13px]' data-slot='change-confirming'>\n+                                    Confirm or cancel in the desktop’s dialog. The draft is held until you do.\n+                                </p>\n+                            ) : null}\n+                        </>\n+                    )}\n+                </div>\n+            ) : null}\n+            {message ? (\n+                <p role='alert' className='text-academy-accent-warn text-[13px]' data-slot='change-message'>\n+                    {message}\n+                </p>\n+            ) : null}\n+        </section>\n+    )\n+}\n+\n+export function resultText(result: ChangeResultView): string {\n+    if (!result.settled) return 'Applying…'\n+    // Each provisioning step keeps its own outcome; the steps say what is known.\n+    if (result.provisioning)\n+        return `${result.failure ? `${changeFailureText(result.failure)} ` : ''}${provisioningText(result.provisioning)}`\n+    if (result.failure) {\n+        const why = changeFailureText(result.failure)\n+        switch (result.outcome) {\n+            case 'unknown':\n+                return `${why} The change may or may not have been applied. Refresh the inventory before trying again.`\n+            case 'completed':\n+                return `${why} The service accepted the change.`\n+            default:\n+                return `${why} Nothing was changed.`\n+        }\n+    }\n+    switch (result.readback) {\n+        case 'differs':\n+            return result.action === 'delete'\n+                ? 'Applied, but the item is still listed when read back. Refresh before trying again.'\n+                : 'Applied, but reading it back does not show the reviewed change. Refresh before trying again.'\n+        case 'found':\n+            return 'Applied. The item was read back.'\n+        case 'absent':\n+            return result.action === 'delete'\n+                ? 'Applied. The item is no longer in the inventory.'\n+                : 'Applied, but the item was not found when read back. Refresh the inventory.'\n+        case 'incomplete':\n+            return 'Applied. The inventory was too large to read the item back.'\n+        case 'stopped':\n+            return 'Applied: the service accepted the change. The desktop stopped waiting before reading it back; refresh the inventory to see the current state.'\n+        default:\n+            return 'Applied. Reading it back failed; refresh the inventory to see the current state.'\n+    }\n+}\n+\n+const STEP_TEXT: Record<StepState, string> = {\n+    notStarted: 'not attempted',\n+    notSent: 'not sent',\n+    rejected: 'refused by the service',\n+    unknown: 'outcome unknown',\n+    completed: 'done',\n+    existing: 'existing scope reused',\n+    deleted: 'created, then deleted again',\n+}\n+\n+/** What became of an IAM scope this attempt created (empty when none). */\n+const CLEANUP_TEXT: Record<ScopeCleanup, string> = {\n+    notNeeded: '',\n+    retained: 'The IAM scope was kept because the workspace exists or may exist. ',\n+    deleted: 'The IAM scope this attempt created was deleted again. ',\n+    failed: 'Deleting the IAM scope this attempt created was refused, so it remains. ',\n+    unknown: 'Whether the IAM scope this attempt created was deleted is not known. ',\n+}\n+\n+/** What reading the tenant back did not establish. */\n+function unconfirmed(p: Provisioning): string[] {\n+    const missing: string[] = []\n+    if (p.workspaceRead === 'ambiguous') missing.push('which workspace is this attempt’s')\n+    else if (p.workspaceRead !== 'found') missing.push('the workspace')\n+    if (p.scopeRead !== 'found') missing.push('the IAM scope')\n+    if (p.workspaceRead === 'found' && p.scopeRead === 'found' && p.boundRead !== true) missing.push('the scope’s binding to the workspace')\n+    return missing\n+}\n+\n+/**\n+ * A provisioning's summary: each step's own outcome, what the SDK removed\n+ * again, and only what reading the tenant back established is called\n+ * verified.\n+ */\n+export function provisioningText(p: Provisioning): string {\n+    const steps = [p.scope, p.workspace, p.binding]\n+    const cleanup = CLEANUP_TEXT[p.cleanup]\n+    if (steps.includes('unknown')) return `Not every step’s outcome is known. ${cleanup}Check what was read back below before trying again.`\n+    const written = (p.scope === 'completed' || p.scope === 'existing') && p.workspace === 'completed' && p.binding === 'completed'\n+    if (written) {\n+        const missing = unconfirmed(p)\n+        return missing.length === 0\n+            ? 'Provisioned. The workspace, its IAM scope and the scope’s binding to it were read back.'\n+            : `Every step was accepted, but reading the tenant back did not confirm ${missing.join(', ')}. Refresh the workspaces before trying again.`\n+    }\n+    if (p.workspace === 'completed') return `Partially completed: the workspace exists but a later step failed. ${cleanup}Do not create it again.`\n+    return `Not provisioned. ${cleanup || (p.scope === 'completed' ? 'The IAM scope this attempt created remains. ' : 'Nothing was created. ')}`.trim()\n+}\n+\n+/** Each provisioning step and what reading the tenant back found. */\n+export function ProvisioningSteps({ p }: { p: Provisioning }) {\n+    const read = (r: Provisioning['scopeRead']) =>\n+        r === 'found'\n+            ? 'found'\n+            : r === 'absent'\n+              ? 'not found'\n+              : r === 'incomplete'\n+                ? 'not established (inventory too large)'\n+                : r === 'ambiguous'\n+                  ? 'not identified (more than one could be this attempt’s)'\n+                  : 'could not be read'\n+    return (\n+        <dl className='grid grid-cols-[auto_1fr] gap-x-3 gap-y-1 text-[12px]' data-slot='provisioning-steps'>\n+            <dt className='font-medium'>IAM scope {p.scopeName}</dt>\n+            <dd>\n+                {STEP_TEXT[p.scope]}\n+                {p.cleanup === 'notNeeded' ? '' : ` · ${CLEANUP_TEXT[p.cleanup].trim()}`}\n+            </dd>\n+            <dt className='font-medium'>Workspace</dt>\n+            <dd>{STEP_TEXT[p.workspace]}</dd>\n+            <dt className='font-medium'>Scope binding</dt>\n+            <dd>{STEP_TEXT[p.binding]}</dd>\n+            <dt className='font-medium'>Read back</dt>\n+            <dd>\n+                Scope {read(p.scopeRead)}; workspace {read(p.workspaceRead)}\n+                {p.workspaceSlug ? ` (${p.workspaceSlug})` : ''}\n+                {p.boundRead === null ? '' : p.boundRead ? '; the scope lists it' : '; the scope does not list it'}.\n+            </dd>\n+        </dl>\n+    )\n+}\n+\n+/** The active tenant's applied changes and their one-time secrets. */\n+export function ChangeResults({\n+    results,\n+    dispatch,\n+    heading = 'Applied changes',\n+}: {\n+    results: ChangeResultView[]\n+    dispatch: Dispatch\n+    heading?: string\n+}) {\n+    const ids = useId()\n+    const [message, setMessage] = useState<string | null>(null)\n+    if (results.length === 0) return null\n+\n+    async function send(intent: Parameters<Dispatch>[0]) {\n+        setMessage(outcomeMessage(await dispatch(intent)))\n+    }\n+\n+    return (\n+        <section aria-labelledby={`${ids}-heading`} data-slot='change-results' className='flex flex-col gap-3'>\n+            <h2 id={`${ids}-heading`} className='text-academy-ink text-[15px] font-semibold'>\n+                {heading}\n+            </h2>\n+            <ul className='flex flex-col gap-3'>\n+                {results.map((result) => (\n+                    <li key={result.operation} className='border-academy-rule flex flex-col gap-2 rounded-[12px] border p-4' data-slot='change-result'>\n+                        <p className='text-academy-ink text-[13px] font-medium'>\n+                            {verbOf(result.kind, result.action)} {CHANGE_NOUN[result.kind]} {result.name ?? result.target}\n+                            {result.workspace ? ` in ${result.workspace.name}` : ''}\n+                        </p>\n+                        <p role='status' className='text-[13px]'>\n+                            {resultText(result)}\n+                        </p>\n+                        {result.provisioning ? <ProvisioningSteps p={result.provisioning} /> : null}\n+                        {!result.settled ? (\n+                            <div>\n+                                <Button type='button' tier='tertiary' onClick={() => void send({ kind: 'cancelChange', operation: result.operation })}>\n+                                    Stop waiting\n+                                </Button>\n+                                <p className='text-academy-ink-faint text-[12px]'>\n+                                    Stopping does not undo anything already sent; the result says what is known.\n+                                </p>\n+                            </div>\n+                        ) : null}\n+                        {result.secret === 'held' ? (\n+                            <Callout tone='warning' icon={KeyRound} data-slot='change-secret'>\n+                                <p>\n+                                    {isGatewayKind(result.kind)\n+                                        ? 'A new Gateway key is held in memory only. Show it once in the desktop’s dialog and store it securely.'\n+                                        : 'A new API key is held in memory only. Show it once in the desktop’s dialog and store it securely. The configured scan key is unchanged.'}\n+                                </p>\n+                                <div className='mt-2 flex flex-wrap gap-2'>\n+                                    <Button type='button' tier='secondary' onClick={() => void send({ kind: 'revealSecret', operation: result.operation })}>\n+                                        Show new key…\n+                                    </Button>\n+                                    <Button type='button' tier='tertiary' onClick={() => void send({ kind: 'forgetSecret', operation: result.operation })}>\n+                                        Clear key\n+                                    </Button>\n+                                </div>\n+                            </Callout>\n+                        ) : result.secret === 'forgotten' ? (\n+                            <p className='text-academy-ink-faint text-[12px]'>The new key was cleared from memory.</p>\n+                        ) : result.secret === 'shown' ? (\n+                            <p className='text-academy-ink-faint text-[12px]'>\n+                                The new key was shown once and is no longer held by the desktop.\n+                            </p>\n+                        ) : null}\n+                    </li>\n+                ))}\n+            </ul>\n+            {message ? (\n+                <p role='alert' className='text-academy-accent-warn text-[13px]'>\n+                    {message}\n+                </p>\n+            ) : null}\n+        </section>\n+    )\n+}\n+\n+/** Editor templates (v1 field names). */\n+export const TEMPLATES = {\n+    profile: { profile_name: '', active: true, policy: { 'ai-security-profiles': [] } },\n+    topic: { topic_name: '', description: '', examples: [] as string[] },\n+    key: {\n+        api_key_name: '',\n+        cust_app: '',\n+        cust_env: 'production',\n+        cust_cloud_provider: 'aws',\n+        dp_name: '',\n+        revoked: false,\n+        rotation_time_interval: 30,\n+        rotation_time_unit: 'days',\n+    },\n+    rotate: { rotation_time_interval: 30, rotation_time_unit: 'days' },\n+    pattern: { name: '', type: 'custom', description: '', detection_config: { technique: 'regex' } },\n+    dataProfile: { name: '', detection_rules: [] as unknown[] },\n+    dictionary: {\n+        metadata: {\n+            name: 'New dictionary',\n+            original_file_name: 'keywords.txt',\n+            type: 'custom',\n+            category: 'Confidential',\n+            region_name: 'United States',\n+        },\n+        file: 'internal\\nconfidential\\n',\n+    },\n+}\n+\n+export const pretty = (value: unknown) => JSON.stringify(value, null, 2)\ndiff --git a/apps/desktop/src/modules/diagnostics/diagnostics-panel.test.tsx b/apps/desktop/src/modules/diagnostics/diagnostics-panel.test.tsx\nnew file mode 100644\nindex 00000000..61e09a33\n--- /dev/null\n+++ b/apps/desktop/src/modules/diagnostics/diagnostics-panel.test.tsx\n@@ -0,0 +1,75 @@\n+/**\n+ * Local redacted diagnostics in Settings (C24): what is kept and for how\n+ * long is stated, nothing is exported until asked, and the export's outcome\n+ * is announced.\n+ */\n+import { render, screen, waitFor, within } from '@testing-library/react'\n+import userEvent from '@testing-library/user-event'\n+import { describe, expect, it } from 'vitest'\n+import { DesktopClient, type DiagnosticsView, type ShellSnapshot } from '@prisma-airs/desktop-contracts'\n+import { App } from '../../app'\n+import { baseSnapshot, scriptedNative, framed } from '../../test/native'\n+\n+const snapshot = (view: Partial<DiagnosticsView> = {}): ShellSnapshot => ({\n+    ...baseSnapshot,\n+    diagnostics: { ...baseSnapshot.diagnostics, events: 12, ...view },\n+})\n+\n+describe('diagnostics (C24)', () => {\n+    it('states what is kept, exports and clears only when asked, and announces the export', async () => {\n+        const native = framed(scriptedNative(snapshot()), 'settings')\n+        const user = userEvent.setup()\n+        render(<App client={new DesktopClient(native.transport)} />)\n+        await native.push({ ...native.current, onboarding: 'done', activeFeature: 'settings' })\n+        const group = await screen.findByRole('group', { name: 'Diagnostics' })\n+        expect(within(group).getByText(/Kept only on this Mac for 14 days and never sent anywhere/)).toBeInTheDocument()\n+        expect(within(group).getByText(/Prompts, responses, keys, tokens and names are never kept/)).toBeInTheDocument()\n+        expect(within(group).getByText('12 events kept.')).toBeInTheDocument()\n+        expect(native.dispatched.some((i) => i.kind === 'exportDiagnostics')).toBe(false)\n+        const exportButton = within(group).getByRole('button', { name: 'Export diagnostics…' })\n+        exportButton.focus()\n+        await user.keyboard(' ')\n+        await waitFor(() => expect(native.dispatched).toContainEqual({ kind: 'exportDiagnostics' }))\n+        await native.push(snapshot({ export: 'saving' }))\n+        // Held while the save dialog is open, without losing keyboard focus,\n+        // so focus is on Export when the dialog closes.\n+        expect(exportButton).toHaveAttribute('aria-disabled', 'true')\n+        expect(exportButton).toHaveFocus()\n+        await user.keyboard(' ')\n+        expect(native.dispatched.filter((i) => i.kind === 'exportDiagnostics')).toHaveLength(1)\n+        await native.push(snapshot({ export: 'saved' }))\n+        expect(await within(group).findByRole('status')).toHaveTextContent('Diagnostics saved.')\n+        expect(exportButton).toHaveFocus()\n+        expect(exportButton).toHaveAttribute('aria-disabled', 'false')\n+        await user.click(within(group).getByRole('button', { name: 'Clear diagnostics' }))\n+        await waitFor(() => expect(native.dispatched).toContainEqual({ kind: 'clearDiagnostics' }))\n+    })\n+\n+    it('announces a clearing, and says when one could not remove everything', async () => {\n+        const native = framed(scriptedNative(snapshot({ events: 12, clear: 'failed' })), 'settings')\n+        const user = userEvent.setup()\n+        render(<App client={new DesktopClient(native.transport)} />)\n+        await native.push({ ...native.current, onboarding: 'done', activeFeature: 'settings' })\n+        const group = await screen.findByRole('group', { name: 'Diagnostics' })\n+        // The events still kept are counted, and the failure is an alert.\n+        expect(within(group).getByText('12 events kept.')).toBeInTheDocument()\n+        expect(within(group).getByRole('alert')).toHaveTextContent(/could not all be removed, so the events counted above are still kept/)\n+        // Retried by keyboard: Clear is reachable and admitted again.\n+        within(group).getByRole('button', { name: 'Clear diagnostics' }).focus()\n+        await user.keyboard('{Enter}')\n+        await waitFor(() => expect(native.dispatched).toContainEqual({ kind: 'clearDiagnostics' }))\n+        await native.push(snapshot({ events: 2, clear: 'cleared' }))\n+        expect(await within(group).findByRole('status')).toHaveTextContent('Diagnostics cleared.')\n+        expect(within(group).queryByRole('alert')).toBeNull()\n+    })\n+\n+    it('says when a build keeps none', async () => {\n+        const native = framed(scriptedNative(snapshot({ available: false })), 'settings')\n+        const user = userEvent.setup()\n+        render(<App client={new DesktopClient(native.transport)} />)\n+        await native.push({ ...native.current, onboarding: 'done', activeFeature: 'settings' })\n+        const group = await screen.findByRole('group', { name: 'Diagnostics' })\n+        expect(within(group).getByText('This build keeps no diagnostics.')).toBeInTheDocument()\n+        expect(within(group).queryByRole('button')).toBeNull()\n+    })\n+})\ndiff --git a/apps/desktop/src/modules/diagnostics/diagnostics-panel.tsx b/apps/desktop/src/modules/diagnostics/diagnostics-panel.tsx\nnew file mode 100644\nindex 00000000..9e900885\n--- /dev/null\n+++ b/apps/desktop/src/modules/diagnostics/diagnostics-panel.tsx\n@@ -0,0 +1,92 @@\n+import { useId, useState } from 'react'\n+import { Button } from '@ai-security-academy/presentation'\n+import type { DiagnosticsClear, DiagnosticsExport, DiagnosticsView } from '@prisma-airs/desktop-contracts'\n+import { type Dispatch, outcomeMessage } from '../tenants/dispatch'\n+\n+const EXPORT_TEXT: Record<DiagnosticsExport, string> = {\n+    saving: 'Choose where to save the diagnostics in the open dialog.',\n+    saved: 'Diagnostics saved.',\n+    cancelled: 'Nothing was saved.',\n+    failed: 'The diagnostics could not be saved.',\n+}\n+\n+const CLEAR_TEXT: Record<DiagnosticsClear, string> = {\n+    cleared: 'Diagnostics cleared.',\n+    failed: 'The diagnostics could not all be removed, so the events counted above are still kept. Try again.',\n+}\n+\n+interface Props {\n+    view: DiagnosticsView\n+    dispatch: Dispatch\n+}\n+\n+/**\n+ * Local, redacted diagnostics (C24, D051). The desktop keeps only the kind\n+ * of each request and why one was refused, storage and reset outcomes, and\n+ * where the app stopped unexpectedly; never prompts, responses, keys or\n+ * names. Nothing is sent anywhere: export is explicit and saved where the\n+ * operator chooses.\n+ */\n+export function DiagnosticsPanel({ view, dispatch }: Props) {\n+    const legend = useId()\n+    const [message, setMessage] = useState<string | null>(null)\n+    const busy = view.export === 'saving'\n+\n+    async function run(intent: Parameters<Dispatch>[0]) {\n+        setMessage(null)\n+        const outcome = await dispatch(intent)\n+        setMessage(outcomeMessage(outcome))\n+    }\n+\n+    return (\n+        <fieldset aria-labelledby={legend} data-slot='diagnostics' className='border-academy-rule flex flex-col gap-3 rounded-[12px] border p-5'>\n+            <legend id={legend} className='text-academy-ink px-1 text-[15px] font-semibold'>\n+                Diagnostics\n+            </legend>\n+            {!view.available ? (\n+                <p className='text-academy-ink-soft text-[13px]'>This build keeps no diagnostics.</p>\n+            ) : (\n+                <>\n+                    <p className='text-academy-ink-soft max-w-prose text-[13px]'>\n+                        Kept only on this Mac for {view.retentionDays} days and never sent anywhere: the kind of each\n+                        request and why one was refused, storage and reset outcomes, and where the app stopped\n+                        unexpectedly. Prompts, responses, keys, tokens and names are never kept.\n+                    </p>\n+                    <p className='text-academy-ink text-[13px]' data-slot='diagnostics-count'>\n+                        {view.events} event{view.events === 1 ? '' : 's'} kept.\n+                    </p>\n+                    <div className='flex flex-wrap gap-2'>\n+                        {/* aria-disabled, not disabled, while the save dialog is open: a\n+                            disabled button drops keyboard focus, which would not come back to\n+                            Export when the dialog closes. */}\n+                        <Button type='button' tier='secondary' aria-disabled={busy} onClick={() => !busy && void run({ kind: 'exportDiagnostics' })}>\n+                            Export diagnostics…\n+                        </Button>\n+                        <Button type='button' tier='tertiary' aria-disabled={busy} onClick={() => !busy && void run({ kind: 'clearDiagnostics' })}>\n+                            Clear diagnostics\n+                        </Button>\n+                    </div>\n+                    {view.export ? (\n+                        <p role='status' aria-live='polite' className='text-academy-ink-soft text-[13px]'>\n+                            {EXPORT_TEXT[view.export]}\n+                        </p>\n+                    ) : null}\n+                    {view.clear === 'failed' ? (\n+                        <p role='alert' data-slot='diagnostics-clear' className='text-academy-accent-warn text-[13px]'>\n+                            {CLEAR_TEXT.failed}\n+                        </p>\n+                    ) : view.clear === 'cleared' ? (\n+                        <p role='status' aria-live='polite' data-slot='diagnostics-clear' className='text-academy-ink-soft text-[13px]'>\n+                            {CLEAR_TEXT.cleared}\n+                        </p>\n+                    ) : null}\n+                </>\n+            )}\n+            {message ? (\n+                <p role='alert' className='text-academy-accent-warn text-[13px]'>\n+                    {message}\n+                </p>\n+            ) : null}\n+        </fieldset>\n+    )\n+}\ndiff --git a/apps/desktop/src/modules/library/case-prefill.ts b/apps/desktop/src/modules/library/case-prefill.ts\nnew file mode 100644\nindex 00000000..29fa83d7\n--- /dev/null\n+++ b/apps/desktop/src/modules/library/case-prefill.ts\n@@ -0,0 +1,13 @@\n+/** What the scan form is filled with (a Runtime case or a starter). */\n+export interface CasePrefill {\n+    name: string\n+    profile: string\n+    prompt: string\n+    response: string\n+    appName: string\n+    /** Shown as the loaded case's goal; never a verdict. */\n+    expected: string\n+    /** A new value remounts the scan form with these fields. */\n+    nonce: number\n+}\n+\ndiff --git a/apps/desktop/src/modules/runtime/scan-text.ts b/apps/desktop/src/modules/runtime/scan-text.ts\nnew file mode 100644\nindex 00000000..9b7059bf\n--- /dev/null\n+++ b/apps/desktop/src/modules/runtime/scan-text.ts\n@@ -0,0 +1,126 @@\n+import type {\n+    Outcome,\n+    ProfileSelector,\n+    ScanDraft,\n+    ScanFailureKind,\n+    ScanRecordView,\n+    StopReason,\n+    Verdict,\n+} from '@prisma-airs/desktop-contracts'\n+\n+/** Per-text ceiling (UTF-8 bytes), matching the native admission check. */\n+export const MAX_TEXT_BYTES = 2 * 1024 * 1024\n+/** Whole-request ceiling (escaped JSON bytes plus envelope allowance). */\n+export const MAX_REQUEST_BYTES = 8 * 1024 * 1024\n+const ENVELOPE_BYTES = 16 * 1024\n+const MAX_PROFILE_NAME = 100\n+const MAX_APP_NAME = 256\n+const UUID = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i\n+\n+const CONTROL = /[\\u0000-\\u001f\\u007f-\\u009f]/\n+const encoder = new TextEncoder()\n+const bytes = (text: string): number => encoder.encode(text).length\n+const escapedBytes = (text: string): number => bytes(JSON.stringify(text))\n+\n+export interface ScanInput {\n+    profileKind: 'name' | 'id'\n+    profile: string\n+    prompt: string\n+    response: string\n+    appName: string\n+}\n+\n+/**\n+ * Builds the draft from input captured at submission, or explains why it\n+ * cannot be sent. The native side re-checks every limit at admission.\n+ */\n+export function draftFrom(input: ScanInput): { draft: ScanDraft } | { problem: string; field: keyof ScanInput } {\n+    const profile = input.profile.trim()\n+    if (profile.length === 0) return { problem: 'Choose the AI security profile for this scan.', field: 'profile' }\n+    let selector: ProfileSelector\n+    if (input.profileKind === 'name') {\n+        if (profile.length > MAX_PROFILE_NAME || CONTROL.test(profile)) {\n+            return { problem: `Profile names are at most ${MAX_PROFILE_NAME} characters, on one line.`, field: 'profile' }\n+        }\n+        selector = { kind: 'name', name: profile }\n+    } else {\n+        if (!UUID.test(profile)) return { problem: 'A profile ID is a UUID, for example 1b2c…-….', field: 'profile' }\n+        selector = { kind: 'id', id: profile.toLowerCase() }\n+    }\n+    if (input.prompt.trim().length === 0 && input.response.trim().length === 0) {\n+        return { problem: 'Enter a prompt, a response, or both.', field: 'prompt' }\n+    }\n+    if (bytes(input.prompt) > MAX_TEXT_BYTES) return { problem: 'The prompt is larger than 2 MiB.', field: 'prompt' }\n+    if (bytes(input.response) > MAX_TEXT_BYTES) return { problem: 'The response is larger than 2 MiB.', field: 'response' }\n+    const appName = input.appName.trim()\n+    if ([...appName].length > MAX_APP_NAME || CONTROL.test(appName)) {\n+        return { problem: `Application names are at most ${MAX_APP_NAME} characters, on one line.`, field: 'appName' }\n+    }\n+    const request = escapedBytes(input.prompt) + escapedBytes(input.response) + escapedBytes(profile) + escapedBytes(appName)\n+    if (request + ENVELOPE_BYTES > MAX_REQUEST_BYTES) {\n+        return { problem: 'This scan request would be larger than 8 MiB. Shorten the prompt or response.', field: 'prompt' }\n+    }\n+    return {\n+        draft: { profile: selector, prompt: input.prompt, response: input.response, appName: appName.length > 0 ? appName : null },\n+    }\n+}\n+\n+export const VERDICT_TEXT: Record<Verdict, { label: string; tone: 'success' | 'danger' | 'warning' | 'default' }> = {\n+    allow: { label: 'Allowed', tone: 'success' },\n+    block: { label: 'Blocked', tone: 'danger' },\n+    alert: { label: 'Allowed with a threat detected', tone: 'warning' },\n+    unknown: { label: 'Not determined', tone: 'warning' },\n+}\n+\n+export const FAILURE_TEXT: Record<ScanFailureKind, string> = {\n+    unauthorized: 'The tenant did not accept the scan key (HTTP 401). Check the key in Settings.',\n+    forbidden: 'The scan key is not allowed to run this scan (HTTP 403).',\n+    conflict: 'The service reported a conflict (HTTP 409).',\n+    rateLimited: 'The service is limiting requests (HTTP 429). Wait before scanning again.',\n+    badRequest: 'The service rejected the request (HTTP 400). Check the profile and input.',\n+    unprocessable: 'The service could not process the request (HTTP 422). Check the profile and input.',\n+    serverError: 'The service failed while handling the scan.',\n+    httpOther: 'The service returned an unexpected status.',\n+    timeout: 'No reply arrived in time.',\n+    cancelled: 'The scan was cancelled.',\n+    network: 'The connection failed before a reply arrived.',\n+    redirect: 'The service redirected the request; redirects are not followed.',\n+    malformedResponse: 'The reply could not be read as a scan result.',\n+    tooLarge: 'The request or reply exceeded the size limit.',\n+    invalidRequest: 'The scan request was not valid.',\n+    credentialLocked: 'The Keychain is locked. Unlock it and scan again.',\n+    credentialDenied: 'macOS did not allow access to the scan key.',\n+    credentialMissing: 'The scan key is missing. Enter it in Settings.',\n+    other: 'The scan did not complete.',\n+}\n+\n+/** What is known about the remote effect, in operator terms. */\n+export function outcomeText(outcome: Outcome | null, stop: StopReason | null): string {\n+    switch (outcome) {\n+        case null:\n+            return ''\n+        case 'completed':\n+            return 'The service returned a result.'\n+        case 'rejected':\n+            return 'The service refused the request; it was not scanned.'\n+        case 'notSent':\n+            return stop === 'cancelled' ? 'Cancelled before it was sent. Nothing reached the service.' : 'Nothing was sent to the service.'\n+        // Unknown never claims the request was sent: a connect failure or a\n+        // cancellation may or may not have reached the service.\n+        case 'unknown':\n+            return stop === 'cancelled'\n+                ? 'Cancelled. The request may already have reached the service and been scanned; no result will be shown.'\n+                : 'The outcome is unknown. The request may or may not have reached the service, and it may have been scanned. It is not resubmitted automatically.'\n+    }\n+}\n+\n+export function recordSummary(record: ScanRecordView): string {\n+    if (record.progress === 'queued') return 'Waiting to send…'\n+    if (record.progress === 'running') return 'Scanning…'\n+    if (record.discarded || record.stop === 'contextRetired') {\n+        return 'The tenant or scan key changed before the reply. Any reply was discarded and is not shown.'\n+    }\n+    if (record.result) return VERDICT_TEXT[record.result.verdict].label\n+    if (record.failure) return FAILURE_TEXT[record.failure.kind]\n+    return outcomeText(record.outcome, record.stop)\n+}\ndiff --git a/apps/desktop/src/modules/sessions/sessions-model.ts b/apps/desktop/src/modules/sessions/sessions-model.ts\nnew file mode 100644\nindex 00000000..62da9ca9\n--- /dev/null\n+++ b/apps/desktop/src/modules/sessions/sessions-model.ts\n@@ -0,0 +1,92 @@\n+import type { ReportKind, SessionSearch } from '@prisma-airs/desktop-contracts'\n+\n+export type Row = Record<string, unknown>\n+export type Verdict = 'malicious' | 'benign' | 'unknown'\n+\n+const text = (value: unknown): string => (typeof value === 'string' ? value : '')\n+\n+/** v1's verdict of a violation breakdown's counts. */\n+function violation(counts: unknown): boolean | null {\n+    if (typeof counts !== 'object' || counts === null) return null\n+    const c = counts as Record<string, unknown>\n+    const n = (k: string) => (typeof c[k] === 'number' ? (c[k] as number) : null)\n+    const buckets = ['critical', 'high', 'medium', 'low'].map(n)\n+    const total = n('total')\n+    if ((total ?? 0) > 0 || buckets.some((b) => (b ?? 0) > 0)) return true\n+    if (total === 0 || buckets.every((b) => b === 0)) return false\n+    return null\n+}\n+\n+/** The detectors a row reports a violation for (v1 `session_detectors`). */\n+export function detectors(row: Row): string[] {\n+    const entries = row.detection_type_violation_breakdown\n+    if (!Array.isArray(entries)) return []\n+    return entries\n+        .filter((e): e is Row => typeof e === 'object' && e !== null && violation((e as Row).violation_breakdown) === true)\n+        .map((e) => text(e.detection_type))\n+        .filter((d) => d.length > 0)\n+}\n+\n+/** A row's verdict and action as v1 read them (`Scan::read`). */\n+export function verdictOf(row: Row): { verdict: Verdict; action: string } {\n+    const status = text(row.status).trim().toLowerCase()\n+    const counts = violation(row.violation_breakdown)\n+    const verdict: Verdict =\n+        detectors(row).length > 0 || counts === true || ['block', 'blocked', 'alert', 'alerted'].includes(status)\n+            ? 'malicious'\n+            : counts === false || ['allow', 'allowed'].includes(status)\n+              ? 'benign'\n+              : 'unknown'\n+    const action =\n+        status === 'block' || status === 'blocked'\n+            ? 'Blocked'\n+            : status === 'alert' || status === 'alerted'\n+              ? 'Alerted'\n+              : status === 'allow' || status === 'allowed'\n+                ? 'Allowed'\n+                : status\n+    return { verdict, action }\n+}\n+\n+export const VERDICT_TEXT: Record<Verdict, string> = { malicious: 'Malicious', benign: 'Benign', unknown: 'No verdict' }\n+\n+export const sessionId = (row: Row) => text(row.session_id)\n+export const appId = (row: Row) => text(row.application_id)\n+export const appName = (row: Row) => text(row.application_name) || text(row.app_name)\n+export const scanId = (row: Row) => text(row.scan_id)\n+export const subRequest = (row: Row) => (typeof row.scan_sub_req_id === 'number' ? row.scan_sub_req_id : 0)\n+\n+/** v1's quick-pick categories (Rust refuses any other non-empty value). */\n+export const CATEGORIES: Record<ReportKind, readonly string[]> = {\n+    false_positive: ['Benign business content', 'Expected internal data', 'Wrong detector', 'Test or sample data'],\n+    false_negative: ['Prompt injection missed', 'Sensitive data missed', 'Harmful content missed', 'Malicious URL missed'],\n+}\n+\n+export const KIND_TEXT: Record<ReportKind, string> = { false_positive: 'False positive', false_negative: 'False negative' }\n+\n+/** The kind a scan's verdict suggests (v1 `ReportKind::suggested`). */\n+export const suggestedKind = (verdict: Verdict): ReportKind => (verdict === 'malicious' ? 'false_positive' : 'false_negative')\n+\n+/** What a search covered, in words: no claim beyond what it read. */\n+export function coverage(search: SessionSearch, found: number): string {\n+    const plural = (n: number, word: string) => `${n.toLocaleString()} ${word}${n === 1 ? '' : word.endsWith('h') ? 'es' : 's'}`\n+    switch (search.kind) {\n+        case 'sessionId':\n+            if (search.cached) return 'Found in this investigation.'\n+            if (found > 0)\n+                return search.complete\n+                    ? `Found among all ${plural(search.scanned, 'session')} of the last 30 days.`\n+                    : `Found among the newest ${plural(search.scanned, 'session')} of the last 30 days.`\n+            return search.complete\n+                ? `No session with this ID in the last 30 days (${plural(search.scanned, 'session')} read).`\n+                : `Not among the newest ${plural(search.scanned, 'session')} of the last 30 days. Older sessions were not read, so it may still exist.`\n+        case 'scanId':\n+            return search.scan !== null ? 'Scan found. Its metadata is shown; content stays hidden.' : 'The service has no scan with this ID.'\n+        case 'detector': {\n+            const head = `${plural(found, 'session')} reporting ${search.query} among ${plural(search.scanned, 'session')} read from the last 24 hours`\n+            if (search.matchLimit) return `${head}. Stopped at ${plural(100, 'match')}; more may exist.`\n+            if (search.complete) return `${head}. That is every session of the last 24 hours.`\n+            return `${head}. Stopped after ${plural(1000, 'session')}; later sessions were not read.`\n+        }\n+    }\n+}\ndiff --git a/apps/desktop/src/modules/sessions/sessions-view.test.tsx b/apps/desktop/src/modules/sessions/sessions-view.test.tsx\nnew file mode 100644\nindex 00000000..cf100142\n--- /dev/null\n+++ b/apps/desktop/src/modules/sessions/sessions-view.test.tsx\n@@ -0,0 +1,295 @@\n+/**\n+ * Sessions & Reports through the real App, DesktopClient and shell: the\n+ * 24-hour inventory with page-only filters, searches that say what they\n+ * covered, content shown only after an explicit reveal and forgotten on Hide\n+ * or when Sessions closes, reports sent as scan references plus the\n+ * operator's reason (never content), and the reports and cache controls.\n+ */\n+import { render, screen, within } from '@testing-library/react'\n+import userEvent from '@testing-library/user-event'\n+import { describe, expect, it } from 'vitest'\n+import {\n+    DesktopClient,\n+    type Intent,\n+    type ManagementResult,\n+    type Report,\n+    type SessionsView,\n+    type ShellSnapshot,\n+} from '@prisma-airs/desktop-contracts'\n+import { App } from '../../app'\n+import { baseSnapshot, type Native, scriptedNative, tenant, withTenant, framed } from '../../test/native'\n+\n+const CONTEXT = 'cx-aaaaaaaaaaaaaaaaaaaaaaaa'\n+const PROMPT = 'SYNTHETIC-PROMPT-TEXT'\n+\n+const row = (n: number, detector: string | null, status: string) => ({\n+    session_id: `ses-${n}`,\n+    application_id: `app-${n % 2}`,\n+    application_name: `Bot ${n % 2}`,\n+    status,\n+    detection_type_violation_breakdown: detector ? [{ detection_type: detector, violation_breakdown: { total: 1 } }] : [],\n+})\n+const ROWS = [row(1, 'prompt_injection', 'block'), row(2, null, 'allow'), row(3, 'dlp', 'alert')]\n+const ACTIONS = [\n+    { scan_id: 'scn-1-0', scan_sub_req_id: 0, session_id: 'ses-1', status: 'block', profile_name: 'Prod',\n+      detection_type_violation_breakdown: [{ detection_type: 'prompt_injection', violation_breakdown: { total: 1 } }] },\n+    { scan_id: 'scn-1-1', scan_sub_req_id: 0, session_id: 'ses-1', status: 'allow', detection_type_violation_breakdown: [] },\n+]\n+\n+const REPORT: Report = {\n+    scanId: 'scn-1-0', scanSubReqId: 0, sessionId: 'ses-1', applicationId: 'app-1', application: 'Bot 1',\n+    kind: 'false_positive', verdict: 'malicious', action: 'Blocked', detectors: ['prompt_injection'], profile: 'Prod',\n+    category: 'Wrong detector', reason: 'Order numbers', reportedAt: '2026-10-18T10:00:00Z',\n+}\n+\n+const sessionsView = (overrides: Partial<SessionsView> = {}): SessionsView => ({\n+    reports: { state: 'ready', failure: null, items: [], undo: null, problem: null, unsaved: false },\n+    investigation: null,\n+    export: null,\n+    ...overrides,\n+})\n+\n+const ready = (sessions: SessionsView = sessionsView()): ShellSnapshot => ({\n+    ...withTenant(\n+        baseSnapshot,\n+        tenant({\n+            management: { state: 'ready', mode: 'keychain', failure: null, clientId: 'svc@1234567890.iam.panserviceaccount.com', tokenOrigin: 'https://auth.apps.paloaltonetworks.com' },\n+        }),\n+        CONTEXT\n+    ),\n+    sessions,\n+})\n+\n+type Answer = (request: Extract<Intent, { kind: 'management' }>['request']) => ManagementResult\n+\n+const DEFAULT: Answer = (request) => {\n+    switch (request.kind) {\n+        case 'page':\n+            return { kind: 'page', page: { resource: 'sessions', offset: 0, limit: 25, items: JSON.stringify(ROWS), count: 3, nextOffset: null, complete: true, total: 3 } }\n+        case 'session':\n+            return { kind: 'session', session: { session: JSON.stringify({ session_id: 'ses-1', application_name: 'Bot 1', session_actions: ACTIONS }), actions: 2, more: false } }\n+        case 'transaction':\n+            return { kind: 'transaction', transaction: JSON.stringify({ scan_id: request.scanId, verdict: 'malicious' }) }\n+        case 'content':\n+            return { kind: 'content', content: { prompt: PROMPT, response: 'SYNTHETIC-RESPONSE-TEXT' } }\n+        default:\n+            return { kind: 'failed', failure: 'invalidResponse', outcome: 'completed' }\n+    }\n+}\n+\n+function service(native: Native, answer: Answer = DEFAULT) {\n+    const requests = new Map<string, Extract<Intent, { kind: 'management' }>['request']>()\n+    const respond = native.respond\n+    native.respond = (intent: Intent) => {\n+        if (intent.kind === 'management') {\n+            const operation = `op-${requests.size + 1}`\n+            requests.set(operation, intent.request)\n+            return { outcome: 'receipt', receipt: { kind: 'admitted', request: `rq-${requests.size}`, operation } }\n+        }\n+        return respond(intent)\n+    }\n+    native.observeManagement = (operation) => {\n+        const request = requests.get(operation)\n+        return { kind: 'management', result: request ? answer(request) : DEFAULT({ kind: 'verify' }) }\n+    }\n+    return requests\n+}\n+\n+async function openSessions(native: Native) {\n+    const user = userEvent.setup()\n+    render(<App client={new DesktopClient(native.transport)} />)\n+    await native.push({ ...native.current, onboarding: 'done', activeFeature: 'sessions' })\n+    await screen.findByRole('heading', { level: 1, name: 'Investigate sessions' })\n+    return user\n+}\n+\n+const sent = (native: Native, kind: Intent['kind']) => native.dispatched.filter((i) => i.kind === kind)\n+\n+describe('Sessions & Reports', () => {\n+    it('lists the last 24 hours with page-only filters and counts', async () => {\n+        const native = framed(scriptedNative(ready()), 'sessions')\n+        const requests = service(native)\n+        const user = await openSessions(native)\n+        expect(await screen.findByText(/Sessions 1–3 of 3/)).toBeInTheDocument()\n+        expect([...requests.values()][0]).toEqual({ kind: 'page', resource: 'sessions', offset: 0, limit: 25 })\n+        expect(screen.getByText('The list shows the last 24 hours. Filters and counts cover this page only.')).toBeInTheDocument()\n+        expect(screen.getByRole('button', { name: 'Malicious 2' })).toBeInTheDocument()\n+        expect(screen.getByRole('button', { name: 'Benign 1' })).toBeInTheDocument()\n+        await user.click(screen.getByRole('button', { name: 'Benign 1' }))\n+        expect(screen.getAllByRole('row').filter((r) => r.getAttribute('data-slot') === 'sessions-row')).toHaveLength(1)\n+        await user.click(screen.getByRole('button', { name: 'All 3' }))\n+        await user.selectOptions(screen.getByRole('combobox', { name: 'Threat category' }), 'dlp')\n+        const rows = screen.getAllByRole('row').filter((r) => r.getAttribute('data-slot') === 'sessions-row')\n+        expect(rows).toHaveLength(1)\n+        expect(within(rows[0] as HTMLElement).getByText('ses-3')).toBeInTheDocument()\n+    })\n+\n+    it('shows content only after an explicit reveal and forgets it on Hide and on leaving', async () => {\n+        const native = framed(scriptedNative(ready()), 'sessions')\n+        const requests = service(native)\n+        const user = await openSessions(native)\n+        await user.click(await screen.findByRole('button', { name: 'Open session ses-1' }))\n+        expect(await screen.findByText(/2 scans/)).toBeInTheDocument()\n+        expect(screen.queryByText(PROMPT)).toBeNull()\n+        expect([...requests.values()].some((r) => r.kind === 'content')).toBe(false)\n+        await user.click(screen.getByRole('button', { name: 'Details for scan scn-1-0' }))\n+        expect(await screen.findByText(/\"verdict\": \"malicious\"/)).toBeInTheDocument()\n+        expect(screen.queryByText(PROMPT)).toBeNull()\n+        await user.click(screen.getByRole('button', { name: 'Show content of scan scn-1-0' }))\n+        expect(await screen.findByText(PROMPT)).toBeInTheDocument()\n+        await user.click(screen.getByRole('button', { name: 'Hide content of scan scn-1-0' }))\n+        expect(screen.queryByText(PROMPT)).toBeNull()\n+        await user.click(screen.getByRole('button', { name: 'Show content of scan scn-1-0' }))\n+        expect(await screen.findByText(PROMPT)).toBeInTheDocument()\n+        // Leaving Sessions drops revealed content; coming back shows none.\n+        await native.push({ ...native.current, onboarding: 'done', activeFeature: 'administration' })\n+        await native.push({ ...native.current, onboarding: 'done', activeFeature: 'sessions' })\n+        await screen.findByRole('heading', { level: 1, name: 'Investigate sessions' })\n+        expect(screen.queryByText(PROMPT)).toBeNull()\n+    })\n+\n+    it('says what each search covered and never claims more', async () => {\n+        const searches: Record<string, ManagementResult> = {\n+            'ses-404': { kind: 'search', search: { kind: 'sessionId', query: 'ses-404', sessions: '[]', scanned: 4000, complete: false, matchLimit: false, scan: null, cached: false } },\n+            prompt_injection: { kind: 'search', search: { kind: 'detector', query: 'prompt_injection', sessions: JSON.stringify(Array.from({ length: 100 }, (_, n) => row(n, 'prompt_injection', 'block'))), scanned: 700, complete: false, matchLimit: true, scan: null, cached: false } },\n+            'scn-1': { kind: 'search', search: { kind: 'scanId', query: 'scn-1', sessions: '[]', scanned: 0, complete: true, matchLimit: false, scan: JSON.stringify({ scan_id: 'scn-1', report_id: 'R-1' }), cached: false } },\n+        }\n+        const native = framed(scriptedNative(ready()), 'sessions')\n+        service(native, (request) => (request.kind === 'search' ? (searches[request.query] as ManagementResult) : DEFAULT(request)))\n+        const user = await openSessions(native)\n+        const box = screen.getByRole('textbox', { name: 'Search by session ID, scan ID or detector' })\n+        await user.type(box, 'ses-404{Enter}')\n+        expect(await screen.findByText('Not among the newest 4,000 sessions of the last 30 days. Older sessions were not read, so it may still exist.')).toBeInTheDocument()\n+        await user.clear(box)\n+        await user.type(box, 'prompt_injection{Enter}')\n+        expect(await screen.findByText(/100 sessions reporting prompt_injection among 700 sessions read from the last 24 hours\\. Stopped at 100 matches; more may exist\\./)).toBeInTheDocument()\n+        await user.clear(box)\n+        await user.type(box, 'scn-1{Enter}')\n+        expect(await screen.findByText('Scan found. Its metadata is shown; content stays hidden.')).toBeInTheDocument()\n+        expect(screen.getByText(/\"report_id\": \"R-1\"/)).toBeInTheDocument()\n+    })\n+\n+    it('sends a report as a scan reference and the operator’s words only', async () => {\n+        const native = framed(scriptedNative(ready()), 'sessions')\n+        service(native)\n+        const user = await openSessions(native)\n+        await user.click(await screen.findByRole('button', { name: 'Open session ses-1' }))\n+        await user.click(await screen.findByRole('button', { name: 'Show content of scan scn-1-0' }))\n+        await screen.findByText(PROMPT)\n+        await user.click(screen.getByRole('button', { name: 'Report scan scn-1-0' }))\n+        const form = screen.getByRole('form', { name: 'Report scan scn-1-0' })\n+        // A malicious verdict suggests a false positive.\n+        expect(within(form).getByRole('radio', { name: 'False positive' })).toBeChecked()\n+        await user.click(within(form).getByRole('button', { name: 'Save report' }))\n+        expect(within(form).getByRole('alert')).toHaveTextContent('Say why this verdict is wrong')\n+        expect(sent(native, 'saveReport')).toEqual([])\n+        await user.selectOptions(within(form).getByRole('combobox', { name: 'Category' }), 'Wrong detector')\n+        await user.type(within(form).getByRole('textbox', { name: 'Why is this verdict wrong?' }), 'Order numbers')\n+        await user.click(within(form).getByRole('button', { name: 'Save report' }))\n+        expect(sent(native, 'saveReport')).toEqual([\n+            {\n+                kind: 'saveReport',\n+                context: CONTEXT,\n+                target: { scanId: 'scn-1-0', subRequest: 0, sessionId: 'ses-1', appId: 'app-1', appName: 'Bot 1' },\n+                input: { kind: 'false_positive', category: 'Wrong detector', reason: 'Order numbers' },\n+            },\n+        ])\n+        const reportBytes = native.sent.filter((s) => s.includes('saveReport')).join('\\n')\n+        expect(reportBytes).not.toContain(PROMPT)\n+    })\n+\n+    it('opens, removes, undoes and exports reports through the desktop', async () => {\n+        const native = framed(scriptedNative(ready(sessionsView({ reports: { state: 'ready', failure: null, items: [REPORT], undo: null, problem: null, unsaved: false } }))), 'sessions')\n+        service(native)\n+        const user = await openSessions(native)\n+        // The tenant's reports open with Sessions.\n+        expect(sent(native, 'openReports')).toEqual([{ kind: 'openReports', context: CONTEXT }])\n+        await user.click(screen.getByRole('tab', { name: /FP\\/FN reports \\(1\\)/ }))\n+        expect(screen.getByText('Order numbers')).toBeInTheDocument()\n+        expect(screen.getByText(/they suppress nothing and change no policy/)).toBeInTheDocument()\n+        await user.click(screen.getByRole('button', { name: 'Remove report for scn-1-0' }))\n+        expect(sent(native, 'removeReport')).toEqual([{ kind: 'removeReport', context: CONTEXT, scanId: 'scn-1-0', subRequest: 0 }])\n+        await native.push(ready(sessionsView({ reports: { state: 'ready', failure: null, items: [], undo: { scanId: 'scn-1-0', subRequest: 0 }, problem: null, unsaved: false } })))\n+        await user.click(screen.getByRole('button', { name: 'Undo' }))\n+        expect(sent(native, 'undoReport')).toEqual([{ kind: 'undoReport', context: CONTEXT }])\n+        await native.push(ready(sessionsView({ reports: { state: 'ready', failure: null, items: [REPORT], undo: null, problem: null, unsaved: true } })))\n+        expect(screen.getByText(/could not be saved on this Mac/)).toBeInTheDocument()\n+        await user.click(screen.getByRole('button', { name: 'Export CSV…' }))\n+        expect(sent(native, 'exportReports')).toEqual([{ kind: 'exportReports', context: CONTEXT }])\n+        await native.push(\n+            ready(sessionsView({ reports: { state: 'ready', failure: null, items: [REPORT], undo: null, problem: null, unsaved: false }, export: { kind: 'reports', state: 'saved', name: 'fpfn-reports-prod-eu-20261018-1000.csv' } }))\n+        )\n+        expect(screen.getByText('Saved fpfn-reports-prod-eu-20261018-1000.csv.')).toBeInTheDocument()\n+        // Editing sends only the scan reference with the new words.\n+        await user.click(screen.getByRole('button', { name: 'Edit report for scn-1-0' }))\n+        const form = screen.getByRole('form', { name: 'Report scan scn-1-0' })\n+        await user.click(within(form).getByRole('radio', { name: 'False negative' }))\n+        await user.click(within(form).getByRole('button', { name: 'Save report' }))\n+        expect(sent(native, 'saveReport').at(-1)).toMatchObject({\n+            target: { scanId: 'scn-1-0', subRequest: 0, sessionId: '', appId: '', appName: '' },\n+            input: { kind: 'false_negative', category: '', reason: 'Order numbers' },\n+        })\n+    })\n+\n+    it('reports an unreadable report file without offering to overwrite it', async () => {\n+        const native = framed(scriptedNative(ready(sessionsView({ reports: { state: 'failed', failure: 'unreadable', items: [], undo: null, problem: null, unsaved: false } }))), 'sessions')\n+        service(native)\n+        const user = await openSessions(native)\n+        await user.click(screen.getByRole('tab', { name: 'FP/FN reports' }))\n+        expect(screen.getByRole('alert')).toHaveTextContent('could not be read. It was kept unchanged.')\n+        expect(screen.queryByRole('button', { name: 'Export CSV…' })).toBeNull()\n+    })\n+\n+    it('clears and exports the investigation cache and says how it is kept', async () => {\n+        const native = framed(scriptedNative(ready(sessionsView({ investigation: { storage: 'protected', sessions: 2, transactions: 1, contents: 1 } }))), 'sessions')\n+        service(native)\n+        const user = await openSessions(native)\n+        expect(screen.getByText(/2 sessions, 1 transactions and 1 revealed scans\\. Sealed on this Mac under a key in your Keychain/)).toBeInTheDocument()\n+        await user.click(screen.getByRole('button', { name: 'Export metadata…' }))\n+        await user.click(screen.getByRole('button', { name: 'Clear cache' }))\n+        expect(sent(native, 'exportInvestigation')).toEqual([{ kind: 'exportInvestigation', context: CONTEXT }])\n+        expect(sent(native, 'clearInvestigation')).toEqual([{ kind: 'clearInvestigation', context: CONTEXT }])\n+        await native.push(ready(sessionsView({ investigation: { storage: 'memory', sessions: 0, transactions: 0, contents: 0 }, export: { kind: 'investigation', state: 'cancelled', name: null } })))\n+        expect(screen.getByText('Export cancelled. Nothing was saved.')).toBeInTheDocument()\n+        expect(screen.getByText(/Kept in memory for this credential/)).toBeInTheDocument()\n+    })\n+\n+    it('labels the exception patterns preview as synthetic and inert', async () => {\n+        const native = framed(scriptedNative(ready()), 'sessions')\n+        const requests = service(native)\n+        const user = await openSessions(native)\n+        const before = requests.size\n+        await user.click(screen.getByRole('tab', { name: 'Exception patterns' }))\n+        expect(screen.getByText('Synthetic data · Memory only · No live integrations')).toBeInTheDocument()\n+        expect(requests.size).toBe(before)\n+    })\n+\n+    it('asks for a management client before reading sessions', async () => {\n+        const native = framed(scriptedNative(withTenant(baseSnapshot, tenant(), CONTEXT)), 'sessions')\n+        service(native)\n+        await openSessions(native)\n+        expect(screen.getByText(/has no ready management client/)).toBeInTheDocument()\n+        expect(sent(native, 'management')).toEqual([])\n+    })\n+\n+    it('keeps existing reports usable without a management client', async () => {\n+        const native = framed(scriptedNative({\n+            ...withTenant(baseSnapshot, tenant(), CONTEXT),\n+            sessions: sessionsView({ reports: { state: 'ready', failure: null, items: [REPORT], undo: null, problem: null, unsaved: false } }),\n+        }), 'sessions')\n+        service(native)\n+        const user = await openSessions(native)\n+        expect(sent(native, 'openReports')).toEqual([{ kind: 'openReports', context: CONTEXT }])\n+        await user.click(screen.getByRole('tab', { name: /FP\\/FN reports \\(1\\)/ }))\n+        expect(screen.getByText('Order numbers')).toBeInTheDocument()\n+        await user.click(screen.getByRole('button', { name: 'Edit report for scn-1-0' }))\n+        const form = screen.getByRole('form', { name: 'Report scan scn-1-0' })\n+        await user.click(within(form).getByRole('button', { name: 'Save report' }))\n+        await user.click(screen.getByRole('button', { name: 'Remove report for scn-1-0' }))\n+        await user.click(screen.getByRole('button', { name: 'Export CSV…' }))\n+        expect(sent(native, 'saveReport')).toHaveLength(1)\n+        expect(sent(native, 'removeReport')).toHaveLength(1)\n+        expect(sent(native, 'exportReports')).toHaveLength(1)\n+        expect(sent(native, 'management')).toEqual([])\n+    })\n+})\ndiff --git a/apps/desktop/src/modules/sessions/sessions-view.tsx b/apps/desktop/src/modules/sessions/sessions-view.tsx\nnew file mode 100644\nindex 00000000..a1c73e91\n--- /dev/null\n+++ b/apps/desktop/src/modules/sessions/sessions-view.tsx\n@@ -0,0 +1,932 @@\n+import { forwardRef, useEffect, useId, useRef, useState } from 'react'\n+import { Button, Callout, Input, cn } from '@ai-security-academy/presentation'\n+import { AlertTriangle, Eye, EyeOff, FlaskConical, Info, Lock } from 'lucide-react'\n+import type {\n+    ContextRef,\n+    FeatureId,\n+    ManagementPage,\n+    Report,\n+    ReportKind,\n+    ReportProblem,\n+    ScanContent,\n+    SessionSearch,\n+    SessionsView as SessionsSnapshot,\n+    ShellSnapshot,\n+} from '@prisma-airs/desktop-contracts'\n+import { PageHeading } from '../../shell/feature-view'\n+import { type Dispatch, outcomeMessage } from '../tenants/dispatch'\n+import { MANAGEMENT_FAILURE_TEXT, type ObserveManagement, fieldText, readManagement } from '../administration/management-read'\n+import {\n+    CATEGORIES,\n+    KIND_TEXT,\n+    type Row,\n+    VERDICT_TEXT,\n+    type Verdict,\n+    appId,\n+    appName,\n+    coverage,\n+    detectors,\n+    scanId,\n+    sessionId,\n+    subRequest,\n+    suggestedKind,\n+    verdictOf,\n+} from './sessions-model'\n+\n+/** Sessions per inventory page (v1). */\n+export const PAGE_SIZE = 25\n+\n+interface Props {\n+    snapshot: ShellSnapshot\n+    dispatch: Dispatch\n+    observe: ObserveManagement\n+    onNavigate: (id: FeatureId) => void\n+}\n+\n+type Tab = 'sessions' | 'reports' | 'exceptions'\n+\n+interface Shown {\n+    page: ManagementPage\n+    rows: Row[]\n+    readAt: Date\n+}\n+\n+type SessionState =\n+    | { kind: 'loading'; row: Row }\n+    | { kind: 'shown'; row: Row; session: Row; actions: Row[]; more: boolean }\n+    | { kind: 'failed'; row: Row; message: string }\n+\n+type SearchState =\n+    | { kind: 'searching'; query: string }\n+    | { kind: 'shown'; search: SessionSearch; rows: Row[]; scan: Row | null }\n+    | { kind: 'failed'; message: string }\n+\n+/** What a revealed scan shows; only ever held while Sessions is open. */\n+type Revealed = { kind: 'loading' } | { kind: 'shown'; content: ScanContent } | { kind: 'failed'; message: string }\n+\n+const TEXTAREA = cn(\n+    'rounded-academy-md bg-academy-bg-inset border-academy-rule focus-visible:border-academy-accent-ring w-full border px-3.5 py-2.5',\n+    'text-academy-ink min-h-24 resize-y text-[13px] leading-snug'\n+)\n+\n+const time = (date: Date) => date.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit', second: '2-digit' })\n+const scanKey = (row: Row) => `${scanId(row)}\\u001f${subRequest(row)}`\n+\n+export const REPORT_PROBLEM_TEXT: Record<ReportProblem, string> = {\n+    reason: 'Say why this verdict is wrong (up to 2,000 characters).',\n+    field: 'The report has a value the desktop cannot keep. Choose one of the listed categories.',\n+    detectors: 'The scan names more detectors than a report can keep.',\n+    full: 'This tenant already has 2,000 reports. Remove some before adding more.',\n+    verdict: 'The scan’s verdict could not be kept.',\n+    scan: 'Open the scan’s session first; a report is built from the scan as the service returned it.',\n+}\n+\n+/**\n+ * Sessions investigations and metadata-only FP/FN reports (C11). The\n+ * inventory is the last 24 hours in pages of 25; searches walk v1's bounded\n+ * windows and say what they covered. A scan's prompt and response are read\n+ * only when the operator reveals them and are dropped when Sessions closes;\n+ * reports keep the scan's metadata and the operator's reason, never content,\n+ * and write nothing to the tenant.\n+ */\n+export const SessionsView = forwardRef<HTMLHeadingElement, Props>(function SessionsView(\n+    { snapshot, dispatch, observe, onNavigate },\n+    ref\n+) {\n+    const tenant = snapshot.tenants.find((t) => t.id === snapshot.active?.tenant)\n+    const context: ContextRef | null = snapshot.active?.context ?? null\n+    const ready = tenant?.management.state === 'ready'\n+    const [tab, setTab] = useState<Tab>('sessions')\n+    // The tenant's reports open with Sessions, so a scan can be reported\n+    // straight from its session. They are local work: existing reports stay\n+    // usable without a management client (only new reports need one).\n+    useEffect(() => {\n+        if (context) void dispatch({ kind: 'openReports', context })\n+    }, [context])\n+    const heading = <PageHeading ref={ref} id='sessions-heading' kicker='Sessions & Reports' title='Investigate sessions' />\n+\n+    if (!tenant || !context) {\n+        return (\n+            <section aria-labelledby='sessions-heading' data-slot='sessions'>\n+                {heading}\n+                <Callout tone='default' icon={Info} data-slot='sessions-no-tenant'>\n+                    <p>Add a tenant in Settings to investigate its sessions.</p>\n+                    <Button type='button' tier='secondary' className='mt-3' onClick={() => onNavigate('settings')}>\n+                        Open Settings\n+                    </Button>\n+                </Callout>\n+            </section>\n+        )\n+    }\n+    const tabs: { id: Tab; label: string }[] = [\n+        { id: 'sessions', label: 'Sessions' },\n+        { id: 'reports', label: `FP/FN reports${snapshot.sessions.reports.items.length > 0 ? ` (${snapshot.sessions.reports.items.length})` : ''}` },\n+        { id: 'exceptions', label: 'Exception patterns' },\n+    ]\n+    return (\n+        <section aria-labelledby='sessions-heading' data-slot='sessions' className='flex flex-col gap-5'>\n+            {heading}\n+            <p className='text-academy-ink-soft -mt-4 text-[13px]'>\n+                {ready\n+                    ? `${tenant.label}, read with its management client. Prompts and responses stay hidden until you reveal them.`\n+                    : `${tenant.label}. Its FP/FN reports are kept on this Mac and stay available without a management client.`}\n+            </p>\n+            <div role='tablist' aria-label='Sessions sections' className='flex flex-wrap gap-2'>\n+                {tabs.map((t) => (\n+                    <Button\n+                        key={t.id}\n+                        type='button'\n+                        role='tab'\n+                        aria-selected={tab === t.id}\n+                        tier={tab === t.id ? 'secondary' : 'tertiary'}\n+                        size='sm'\n+                        className={tab === t.id ? 'bg-academy-paper-deep font-semibold' : undefined}\n+                        onClick={() => setTab(t.id)}\n+                    >\n+                        {t.label}\n+                    </Button>\n+                ))}\n+            </div>\n+            {tab === 'sessions' && !ready ? (\n+                <Callout tone='default' icon={Lock} data-slot='sessions-not-configured'>\n+                    <p>\n+                        {tenant.label} has no ready management client. Sessions are read with a separate OAuth client;\n+                        scanning keeps working without one.\n+                    </p>\n+                    <Button type='button' tier='secondary' className='mt-3' onClick={() => onNavigate('settings')}>\n+                        Open Settings\n+                    </Button>\n+                </Callout>\n+            ) : tab === 'sessions' ? (\n+                <Investigation context={context} sessions={snapshot.sessions} dispatch={dispatch} observe={observe} />\n+            ) : tab === 'reports' ? (\n+                <Reports context={context} sessions={snapshot.sessions} dispatch={dispatch} />\n+            ) : (\n+                <ExceptionPreview />\n+            )}\n+        </section>\n+    )\n+})\n+\n+function Investigation({\n+    context,\n+    sessions,\n+    dispatch,\n+    observe,\n+}: {\n+    context: ContextRef\n+    sessions: SessionsSnapshot\n+    dispatch: Dispatch\n+    observe: ObserveManagement\n+}) {\n+    const ids = useId()\n+    const [shown, setShown] = useState<Shown | null>(null)\n+    const [failure, setFailure] = useState<string | null>(null)\n+    const [loading, setLoading] = useState(false)\n+    const [application, setApplication] = useState('')\n+    const [verdict, setVerdict] = useState<'all' | Verdict>('all')\n+    const [detector, setDetector] = useState('')\n+    const [query, setQuery] = useState('')\n+    const [search, setSearch] = useState<SearchState | null>(null)\n+    const [open, setOpen] = useState<SessionState | null>(null)\n+    const [details, setDetails] = useState<Record<string, string>>({})\n+    const [revealed, setRevealed] = useState<Record<string, Revealed>>({})\n+    const [reporting, setReporting] = useState<Row | null>(null)\n+    const token = useRef(0)\n+    const searchToken = useRef(0)\n+    const sessionToken = useRef(0)\n+\n+    async function load(offset: number) {\n+        const mine = ++token.current\n+        setLoading(true)\n+        const outcome = await readManagement(dispatch, observe, context, { kind: 'page', resource: 'sessions', offset, limit: PAGE_SIZE })\n+        if (mine !== token.current) return\n+        setLoading(false)\n+        if (outcome.kind === 'notAdmitted') return setFailure(outcome.message)\n+        const result = outcome.result\n+        if (result.kind === 'page' && result.page.resource === 'sessions' && result.page.offset === offset) {\n+            setShown({ page: result.page, rows: JSON.parse(result.page.items) as Row[], readAt: new Date() })\n+            setFailure(null)\n+        } else setFailure(MANAGEMENT_FAILURE_TEXT[result.kind === 'failed' ? result.failure : 'invalidResponse'])\n+    }\n+\n+    useEffect(() => {\n+        void load(0)\n+    }, [])\n+\n+    async function runSearch() {\n+        const trimmed = query.trim()\n+        if (trimmed.length === 0) return\n+        const mine = ++searchToken.current\n+        setSearch({ kind: 'searching', query: trimmed })\n+        const outcome = await readManagement(dispatch, observe, context, { kind: 'search', query: trimmed })\n+        if (mine !== searchToken.current) return\n+        if (outcome.kind === 'notAdmitted') {\n+            setSearch({\n+                kind: 'failed',\n+                message: outcome.message.startsWith('Check the entered')\n+                    ? 'Search by a session ID (ses…), a scan ID (scn… or a UUID) or a detector code such as prompt_injection.'\n+                    : outcome.message,\n+            })\n+        } else if (outcome.result.kind === 'search') {\n+            const found = outcome.result.search\n+            setSearch({ kind: 'shown', search: found, rows: JSON.parse(found.sessions) as Row[], scan: found.scan ? (JSON.parse(found.scan) as Row) : null })\n+        } else {\n+            setSearch({ kind: 'failed', message: MANAGEMENT_FAILURE_TEXT[outcome.result.kind === 'failed' ? outcome.result.failure : 'invalidResponse'] })\n+        }\n+    }\n+\n+    async function openSession(row: Row) {\n+        const mine = ++sessionToken.current\n+        setOpen({ kind: 'loading', row })\n+        setReporting(null)\n+        const outcome = await readManagement(dispatch, observe, context, {\n+            kind: 'session',\n+            sessionId: sessionId(row),\n+            appId: appId(row),\n+            appName: appName(row),\n+        })\n+        if (mine !== sessionToken.current) return\n+        if (outcome.kind === 'notAdmitted') return setOpen({ kind: 'failed', row, message: outcome.message })\n+        const result = outcome.result\n+        if (result.kind === 'session') {\n+            const session = JSON.parse(result.session.session) as Row\n+            const actions = Array.isArray(session.session_actions) ? (session.session_actions as Row[]) : []\n+            setOpen({ kind: 'shown', row, session, actions, more: result.session.more })\n+        } else setOpen({ kind: 'failed', row, message: MANAGEMENT_FAILURE_TEXT[result.kind === 'failed' ? result.failure : 'invalidResponse'] })\n+    }\n+\n+    async function loadDetails(row: Row, scan: Row) {\n+        const key = scanKey(scan)\n+        const outcome = await readManagement(dispatch, observe, context, {\n+            kind: 'transaction',\n+            sessionId: sessionId(row),\n+            appId: appId(row),\n+            appName: appName(row),\n+            scanId: scanId(scan),\n+            subRequest: subRequest(scan),\n+        })\n+        const text =\n+            outcome.kind === 'notAdmitted'\n+                ? outcome.message\n+                : outcome.result.kind === 'transaction'\n+                  ? JSON.stringify(JSON.parse(outcome.result.transaction), null, 2)\n+                  : MANAGEMENT_FAILURE_TEXT[outcome.result.kind === 'failed' ? outcome.result.failure : 'invalidResponse']\n+        setDetails((d) => ({ ...d, [key]: text }))\n+    }\n+\n+    async function reveal(scan: Row) {\n+        const key = scanKey(scan)\n+        setRevealed((r) => ({ ...r, [key]: { kind: 'loading' } }))\n+        const outcome = await readManagement(dispatch, observe, context, { kind: 'content', scanId: scanId(scan), subRequest: subRequest(scan) })\n+        const next: Revealed =\n+            outcome.kind === 'notAdmitted'\n+                ? { kind: 'failed', message: outcome.message }\n+                : outcome.result.kind === 'content'\n+                  ? { kind: 'shown', content: outcome.result.content }\n+                  : { kind: 'failed', message: MANAGEMENT_FAILURE_TEXT[outcome.result.kind === 'failed' ? outcome.result.failure : 'invalidResponse'] }\n+        setRevealed((r) => (r[key] ? { ...r, [key]: next } : r))\n+    }\n+\n+    const hide = (scan: Row) =>\n+        setRevealed((r) => {\n+            const { [scanKey(scan)]: _, ...rest } = r\n+            return rest\n+        })\n+\n+    const rows = shown?.rows ?? []\n+    const applications = [...new Set(rows.map(appName).filter((a) => a.length > 0))].sort()\n+    const detectorCodes = [...new Set(rows.flatMap(detectors))].sort()\n+    const counts = { all: rows.length, malicious: 0, benign: 0 }\n+    for (const row of rows) {\n+        const v = verdictOf(row).verdict\n+        if (v === 'malicious') counts.malicious += 1\n+        if (v === 'benign') counts.benign += 1\n+    }\n+    const visible = rows.filter(\n+        (row) =>\n+            (application === '' || appName(row) === application) &&\n+            (verdict === 'all' || verdictOf(row).verdict === verdict) &&\n+            (detector === '' || detectors(row).includes(detector))\n+    )\n+    const page = shown?.page\n+    const filtered = application !== '' || verdict !== 'all' || detector !== ''\n+\n+    return (\n+        <div className='flex flex-col gap-5' data-slot='sessions-investigation'>\n+            <form\n+                className='flex flex-wrap items-end gap-3'\n+                role='search'\n+                onSubmit={(e) => {\n+                    e.preventDefault()\n+                    void runSearch()\n+                }}\n+            >\n+                <label className='flex min-w-56 flex-1 flex-col gap-1 text-[13px] font-medium' htmlFor={`${ids}-search`}>\n+                    Search by session ID, scan ID or detector\n+                    <Input id={`${ids}-search`} value={query} maxLength={256} onChange={(e) => setQuery(e.target.value)} autoComplete='off' spellCheck={false} />\n+                </label>\n+                <Button type='submit' tier='secondary' disabled={search?.kind === 'searching' || query.trim().length === 0}>\n+                    Search\n+                </Button>\n+                {search ? (\n+                    <Button\n+                        type='button'\n+                        tier='tertiary'\n+                        onClick={() => {\n+                            searchToken.current += 1\n+                            setSearch(null)\n+                        }}\n+                    >\n+                        Clear search\n+                    </Button>\n+                ) : null}\n+            </form>\n+            {search ? <SearchResult state={search} onOpen={(row) => void openSession(row)} /> : null}\n+\n+            <div className='flex flex-wrap items-end gap-3' data-slot='sessions-filters'>\n+                <label className='flex flex-col gap-1 text-[13px] font-medium'>\n+                    Application\n+                    <select className='border-academy-rule rounded-academy-sm bg-academy-bg-inset min-h-11 border px-2' value={application} onChange={(e) => setApplication(e.target.value)}>\n+                        <option value=''>All applications</option>\n+                        {applications.map((a) => (\n+                            <option key={a} value={a}>\n+                                {a}\n+                            </option>\n+                        ))}\n+                    </select>\n+                </label>\n+                <label className='flex flex-col gap-1 text-[13px] font-medium'>\n+                    Threat category\n+                    <select className='border-academy-rule rounded-academy-sm bg-academy-bg-inset min-h-11 border px-2' value={detector} onChange={(e) => setDetector(e.target.value)}>\n+                        <option value=''>All detectors</option>\n+                        {detectorCodes.map((d) => (\n+                            <option key={d} value={d}>\n+                                {d}\n+                            </option>\n+                        ))}\n+                    </select>\n+                </label>\n+                <div role='group' aria-label='Verdict' className='flex gap-1'>\n+                    {(['all', 'malicious', 'benign'] as const).map((v) => (\n+                        <Button key={v} type='button' size='sm' tier={verdict === v ? 'secondary' : 'tertiary'} aria-pressed={verdict === v} onClick={() => setVerdict(v)}>\n+                            {`${v === 'all' ? 'All' : VERDICT_TEXT[v]}${shown ? ` ${counts[v]}` : ''}`}\n+                        </Button>\n+                    ))}\n+                </div>\n+                <Button type='button' tier='secondary' disabled={loading} onClick={() => void load(page?.offset ?? 0)}>\n+                    Refresh\n+                </Button>\n+            </div>\n+            <p className='text-academy-ink-faint text-[12px]'>\n+                The list shows the last 24 hours. Filters and counts cover this page only.\n+            </p>\n+            <div role='status' aria-live='polite' className='text-academy-ink-soft text-[13px]' data-slot='sessions-progress'>\n+                {loading\n+                    ? 'Reading sessions…'\n+                    : page && shown\n+                      ? `${page.count === 0 ? 'No sessions' : `Sessions ${page.offset + 1}–${page.offset + page.count}${page.total !== null ? ` of ${page.total}` : page.complete ? '' : '+'}`} · read at ${time(shown.readAt)}`\n+                      : ''}\n+            </div>\n+            {failure ? (\n+                <Callout tone='danger' icon={AlertTriangle} role='alert'>\n+                    <p>{failure}</p>\n+                    {shown ? <p className='mt-1 text-[12px]'>Showing sessions read at {time(shown.readAt)}. They may be out of date.</p> : null}\n+                </Callout>\n+            ) : null}\n+            {page && page.count === 0 && page.offset === 0 && page.complete && !failure ? (\n+                <Callout tone='default' icon={Info}>\n+                    The service reports no sessions in the last 24 hours.\n+                </Callout>\n+            ) : null}\n+            {rows.length > 0 ? (\n+                <SessionTable rows={visible} onOpen={(row) => void openSession(row)} caption='Sessions of the last 24 hours' />\n+            ) : null}\n+            {filtered && rows.length > 0 && visible.length === 0 ? <p className='text-academy-ink-faint text-[12px]'>No sessions on this page match the filters.</p> : null}\n+            {page ? (\n+                <div className='flex flex-wrap gap-2'>\n+                    <Button type='button' tier='secondary' disabled={loading || page.offset === 0} onClick={() => void load(0)}>\n+                        First page\n+                    </Button>\n+                    <Button\n+                        type='button'\n+                        tier='secondary'\n+                        disabled={loading || page.complete || page.nextOffset === null}\n+                        onClick={() => page.nextOffset !== null && void load(page.nextOffset)}\n+                    >\n+                        Next page\n+                    </Button>\n+                </div>\n+            ) : null}\n+\n+            {open ? (\n+                <SessionPanel\n+                    state={open}\n+                    details={details}\n+                    revealed={revealed}\n+                    reports={sessions.reports.items}\n+                    onDetails={(scan) => open.kind === 'shown' && void loadDetails(open.row, scan)}\n+                    onReveal={(scan) => void reveal(scan)}\n+                    onHide={hide}\n+                    onReport={setReporting}\n+                    onClose={() => {\n+                        sessionToken.current += 1\n+                        setOpen(null)\n+                        setReporting(null)\n+                    }}\n+                />\n+            ) : null}\n+            {reporting && open?.kind === 'shown' ? (\n+                <ReportForm\n+                    key={scanKey(reporting)}\n+                    context={context}\n+                    dispatch={dispatch}\n+                    problem={sessions.reports.problem}\n+                    reportsReady={sessions.reports.state === 'ready'}\n+                    target={{\n+                        scanId: scanId(reporting),\n+                        subRequest: subRequest(reporting),\n+                        sessionId: sessionId(open.row),\n+                        appId: appId(open.row),\n+                        appName: appName(open.row),\n+                    }}\n+                    existing={sessions.reports.items.find((r) => r.scanId === scanId(reporting) && r.scanSubReqId === subRequest(reporting)) ?? null}\n+                    suggested={suggestedKind(verdictOf(reporting).verdict)}\n+                    onDone={() => setReporting(null)}\n+                />\n+            ) : null}\n+            <CachePanel context={context} sessions={sessions} dispatch={dispatch} />\n+        </div>\n+    )\n+}\n+\n+function SessionTable({ rows, onOpen, caption }: { rows: Row[]; onOpen: (row: Row) => void; caption: string }) {\n+    return (\n+        <table className='w-full border-collapse text-left text-[13px]' data-slot='sessions-table'>\n+            <caption className='sr-only'>{caption}</caption>\n+            <thead>\n+                <tr className='border-academy-rule border-b'>\n+                    <th scope='col' className='py-2 pr-3 font-medium'>\n+                        Session\n+                    </th>\n+                    <th scope='col' className='py-2 pr-3 font-medium'>\n+                        Application\n+                    </th>\n+                    <th scope='col' className='py-2 pr-3 font-medium'>\n+                        Verdict\n+                    </th>\n+                    <th scope='col' className='py-2 font-medium'>\n+                        <span className='sr-only'>Actions</span>\n+                    </th>\n+                </tr>\n+            </thead>\n+            <tbody>\n+                {rows.map((row, index) => {\n+                    const { verdict } = verdictOf(row)\n+                    const found = detectors(row)\n+                    return (\n+                        <tr key={`${appId(row)}-${sessionId(row)}-${index}`} className='border-academy-rule border-b' data-slot='sessions-row'>\n+                            <td className='py-2 pr-3 font-mono text-[12px] break-all'>{sessionId(row) || '—'}</td>\n+                            <td className='py-2 pr-3 break-all'>{appName(row) || '—'}</td>\n+                            <td className='py-2 pr-3'>\n+                                {VERDICT_TEXT[verdict]}\n+                                {found.length > 0 ? <span className='text-academy-ink-soft'> · {found.join(', ')}</span> : null}\n+                            </td>\n+                            <td className='py-2 text-right'>\n+                                <Button type='button' tier='secondary' aria-label={`Open session ${sessionId(row)}`} onClick={() => onOpen(row)}>\n+                                    Open\n+                                </Button>\n+                            </td>\n+                        </tr>\n+                    )\n+                })}\n+            </tbody>\n+        </table>\n+    )\n+}\n+\n+function SearchResult({ state, onOpen }: { state: SearchState; onOpen: (row: Row) => void }) {\n+    if (state.kind === 'searching') {\n+        return (\n+            <p role='status' aria-live='polite' className='text-academy-ink-soft text-[13px]'>\n+                Searching for {state.query}…\n+            </p>\n+        )\n+    }\n+    if (state.kind === 'failed') {\n+        return (\n+            <Callout tone='danger' icon={AlertTriangle} role='alert'>\n+                {state.message}\n+            </Callout>\n+        )\n+    }\n+    return (\n+        <div className='flex flex-col gap-2' data-slot='sessions-search-result'>\n+            <p role='status' aria-live='polite' className='text-[13px]'>\n+                {coverage(state.search, state.rows.length)}\n+            </p>\n+            {state.scan ? (\n+                <pre className='bg-academy-bg-inset rounded-academy-md max-h-64 overflow-auto p-3 font-mono text-[12px]' data-slot='sessions-scan-metadata'>\n+                    {JSON.stringify(state.scan, null, 2)}\n+                </pre>\n+            ) : null}\n+            {state.rows.length > 0 ? <SessionTable rows={state.rows} onOpen={onOpen} caption={`Search results for ${state.search.query}`} /> : null}\n+        </div>\n+    )\n+}\n+\n+function SessionPanel(props: {\n+    state: SessionState\n+    details: Record<string, string>\n+    revealed: Record<string, Revealed>\n+    reports: Report[]\n+    onDetails: (scan: Row) => void\n+    onReveal: (scan: Row) => void\n+    onHide: (scan: Row) => void\n+    onReport: (scan: Row) => void\n+    onClose: () => void\n+}) {\n+    const { state } = props\n+    return (\n+        <section aria-label={`Session ${sessionId(state.row)}`} className='border-academy-rule rounded-academy-md flex flex-col gap-3 border p-4' data-slot='sessions-session'>\n+            <div className='flex flex-wrap items-center justify-between gap-2'>\n+                <h2 className='text-[16px] font-semibold'>\n+                    Session <span className='font-mono text-[14px]'>{sessionId(state.row)}</span>\n+                </h2>\n+                <Button type='button' tier='tertiary' onClick={props.onClose}>\n+                    Close session\n+                </Button>\n+            </div>\n+            {state.kind === 'loading' ? <p role='status' className='text-academy-ink-soft text-[13px]'>Reading the session…</p> : null}\n+            {state.kind === 'failed' ? (\n+                <Callout tone='danger' icon={AlertTriangle} role='alert'>\n+                    {state.message}\n+                </Callout>\n+            ) : null}\n+            {state.kind === 'shown' ? (\n+                <>\n+                    <p className='text-academy-ink-soft text-[13px]'>\n+                        {appName(state.session) || appName(state.row)} ·{' '}\n+                        {state.more ? `At least ${state.actions.length} scans (the first ${state.actions.length} are shown)` : `${state.actions.length} scans`}\n+                    </p>\n+                    <ol className='flex flex-col gap-3'>\n+                        {state.actions.map((scan) => {\n+                            const key = scanKey(scan)\n+                            const { verdict, action } = verdictOf(scan)\n+                            const shown = props.revealed[key]\n+                            const reported = props.reports.some((r) => r.scanId === scanId(scan) && r.scanSubReqId === subRequest(scan))\n+                            return (\n+                                <li key={key} className='border-academy-rule flex flex-col gap-2 border-b pb-3' data-slot='sessions-scan'>\n+                                    <div className='flex flex-wrap items-center gap-2 text-[13px]'>\n+                                        <span className='font-mono text-[12px]'>{scanId(scan)}</span>\n+                                        <span>\n+                                            {VERDICT_TEXT[verdict]}\n+                                            {detectors(scan).length > 0 ? ` · ${detectors(scan).join(', ')}` : ''}\n+                                            {action ? ` · ${action}` : ''}\n+                                        </span>\n+                                        {reported ? <span className='text-academy-ink-soft text-[12px]'>Reported</span> : null}\n+                                    </div>\n+                                    <div className='flex flex-wrap gap-2'>\n+                                        <Button type='button' size='sm' tier='secondary' onClick={() => props.onDetails(scan)} aria-label={`Details for scan ${scanId(scan)}`}>\n+                                            Details\n+                                        </Button>\n+                                        {shown ? (\n+                                            <Button type='button' size='sm' tier='secondary' onClick={() => props.onHide(scan)} aria-label={`Hide content of scan ${scanId(scan)}`}>\n+                                                <EyeOff aria-hidden className='size-4' /> Hide content\n+                                            </Button>\n+                                        ) : (\n+                                            <Button type='button' size='sm' tier='secondary' onClick={() => props.onReveal(scan)} aria-label={`Show content of scan ${scanId(scan)}`}>\n+                                                <Eye aria-hidden className='size-4' /> Show content\n+                                            </Button>\n+                                        )}\n+                                        <Button type='button' size='sm' tier='secondary' onClick={() => props.onReport(scan)} aria-label={`Report scan ${scanId(scan)}`}>\n+                                            {reported ? 'Edit report…' : 'Report…'}\n+                                        </Button>\n+                                    </div>\n+                                    {props.details[key] ? (\n+                                        <pre className='bg-academy-bg-inset rounded-academy-md max-h-64 overflow-auto p-3 font-mono text-[12px]' data-slot='sessions-transaction'>\n+                                            {props.details[key]}\n+                                        </pre>\n+                                    ) : null}\n+                                    {shown ? <ContentCard state={shown} /> : null}\n+                                </li>\n+                            )\n+                        })}\n+                    </ol>\n+                </>\n+            ) : null}\n+        </section>\n+    )\n+}\n+\n+function ContentCard({ state }: { state: Revealed }) {\n+    if (state.kind === 'loading') return <p role='status' className='text-academy-ink-soft text-[13px]'>Reading the content…</p>\n+    if (state.kind === 'failed')\n+        return (\n+            <Callout tone='danger' icon={AlertTriangle} role='alert'>\n+                {state.message}\n+            </Callout>\n+        )\n+    return (\n+        <div className='bg-academy-bg-inset rounded-academy-md flex flex-col gap-2 p-3 text-[13px]' data-slot='sessions-content'>\n+            <p className='font-medium'>Prompt</p>\n+            <p className='break-words whitespace-pre-wrap'>{state.content.prompt ?? '— (none)'}</p>\n+            <p className='font-medium'>Response</p>\n+            <p className='break-words whitespace-pre-wrap'>{state.content.response ?? '— (none)'}</p>\n+        </div>\n+    )\n+}\n+\n+function ReportForm(props: {\n+    context: ContextRef\n+    dispatch: Dispatch\n+    problem: ReportProblem | null\n+    reportsReady: boolean\n+    target: { scanId: string; subRequest: number; sessionId: string; appId: string; appName: string }\n+    existing: Report | null\n+    suggested: ReportKind\n+    onDone: () => void\n+}) {\n+    const ids = useId()\n+    const [kind, setKind] = useState<ReportKind>(props.existing?.kind ?? props.suggested)\n+    const [category, setCategory] = useState(props.existing?.category ?? '')\n+    const [reason, setReason] = useState(props.existing?.reason ?? '')\n+    const [message, setMessage] = useState<string | null>(null)\n+    const [saving, setSaving] = useState(false)\n+\n+    async function save() {\n+        if (reason.trim().length === 0 || reason.length > 2000) return setMessage(REPORT_PROBLEM_TEXT.reason)\n+        setSaving(true)\n+        const outcome = await props.dispatch({\n+            kind: 'saveReport',\n+            context: props.context,\n+            target: props.target,\n+            input: { kind, category, reason },\n+        })\n+        setSaving(false)\n+        if (outcome.kind === 'admitted') props.onDone()\n+        else setMessage(outcome.kind === 'refused' && outcome.refusal === 'invalidInput' && props.problem ? REPORT_PROBLEM_TEXT[props.problem] : outcomeMessage(outcome))\n+    }\n+\n+    return (\n+        <form\n+            aria-label={`Report scan ${props.target.scanId}`}\n+            className='border-academy-rule rounded-academy-md flex flex-col gap-3 border p-4'\n+            data-slot='sessions-report-form'\n+            onSubmit={(e) => {\n+                e.preventDefault()\n+                void save()\n+            }}\n+        >\n+            <h2 className='text-[16px] font-semibold'>{props.existing ? 'Edit report' : 'Report this verdict'}</h2>\n+            <p className='text-academy-ink-soft text-[13px]'>\n+                Kept on this Mac with the scan’s metadata. The prompt and response are never part of a report, and\n+                nothing is sent to the tenant.\n+            </p>\n+            {!props.reportsReady ? <p className='text-academy-ink-soft text-[13px]'>This tenant’s reports are not open, so a report cannot be saved now.</p> : null}\n+            <fieldset className='flex flex-wrap gap-4'>\n+                <legend className='mb-1 text-[13px] font-medium'>Kind</legend>\n+                {(['false_positive', 'false_negative'] as const).map((k) => (\n+                    <label key={k} className='flex items-center gap-2 text-[13px]'>\n+                        <input\n+                            type='radio'\n+                            name={`${ids}-kind`}\n+                            checked={kind === k}\n+                            onChange={() => {\n+                                setKind(k)\n+                                setCategory('')\n+                            }}\n+                        />\n+                        {KIND_TEXT[k]}\n+                    </label>\n+                ))}\n+            </fieldset>\n+            <label className='flex flex-col gap-1 text-[13px] font-medium'>\n+                Category\n+                <select className='border-academy-rule rounded-academy-sm bg-academy-bg-inset min-h-11 border px-2' value={category} onChange={(e) => setCategory(e.target.value)}>\n+                    <option value=''>No category</option>\n+                    {CATEGORIES[kind].map((c) => (\n+                        <option key={c} value={c}>\n+                            {c}\n+                        </option>\n+                    ))}\n+                </select>\n+            </label>\n+            <label className='flex flex-col gap-1 text-[13px] font-medium' htmlFor={`${ids}-reason`}>\n+                Why is this verdict wrong?\n+                <textarea id={`${ids}-reason`} className={TEXTAREA} value={reason} maxLength={2000} onChange={(e) => setReason(e.target.value)} />\n+            </label>\n+            {message ? (\n+                <p role='alert' className='text-academy-danger text-[13px]'>\n+                    {message}\n+                </p>\n+            ) : null}\n+            <div className='flex gap-2'>\n+                <Button type='submit' tier='primary' disabled={saving || !props.reportsReady}>\n+                    Save report\n+                </Button>\n+                <Button type='button' tier='tertiary' onClick={props.onDone}>\n+                    Cancel\n+                </Button>\n+            </div>\n+        </form>\n+    )\n+}\n+\n+const STORAGE_TEXT = {\n+    memory: 'Kept in memory for this credential until it changes or the app quits.',\n+    protected: 'Sealed on this Mac under a key in your Keychain, and removed with the credential.',\n+    unavailable: 'Protected storage is unavailable; kept in memory only.',\n+} as const\n+\n+function CachePanel({ context, sessions, dispatch }: { context: ContextRef; sessions: SessionsSnapshot; dispatch: Dispatch }) {\n+    const [message, setMessage] = useState<string | null>(null)\n+    const cache = sessions.investigation\n+    if (!cache) return null\n+    const exporting = sessions.export?.kind === 'investigation' ? sessions.export : null\n+    const send = async (kind: 'clearInvestigation' | 'exportInvestigation') => setMessage(outcomeMessage(await dispatch({ kind, context })))\n+    return (\n+        <section aria-label='Investigation cache' className='border-academy-rule flex flex-col gap-2 border-t pt-4 text-[13px]' data-slot='sessions-cache'>\n+            <h2 className='text-[14px] font-semibold'>Investigation cache</h2>\n+            <p>\n+                {cache.sessions} sessions, {cache.transactions} transactions and {cache.contents} revealed scans. {STORAGE_TEXT[cache.storage]}\n+            </p>\n+            <div className='flex flex-wrap gap-2'>\n+                <Button type='button' tier='secondary' onClick={() => void send('exportInvestigation')} aria-disabled={exporting?.state === 'saving'}>\n+                    Export metadata…\n+                </Button>\n+                <Button type='button' tier='secondary' onClick={() => void send('clearInvestigation')}>\n+                    Clear cache\n+                </Button>\n+            </div>\n+            <p className='text-academy-ink-faint text-[12px]'>An export holds session and transaction metadata only, never a prompt or response.</p>\n+            <ExportStatus view={exporting} />\n+            {message ? <p role='alert'>{message}</p> : null}\n+        </section>\n+    )\n+}\n+\n+function ExportStatus({ view }: { view: SessionsSnapshot['export'] }) {\n+    if (!view) return null\n+    const text = {\n+        saving: 'Choose where to save the export…',\n+        saved: `Saved ${view.name ?? ''}.`,\n+        cancelled: 'Export cancelled. Nothing was saved.',\n+        failed: 'The export could not be saved.',\n+    }[view.state]\n+    return (\n+        <p role='status' aria-live='polite' className='text-academy-ink-soft text-[13px]' data-slot='sessions-export-status'>\n+            {text}\n+        </p>\n+    )\n+}\n+\n+function Reports({ context, sessions, dispatch }: { context: ContextRef; sessions: SessionsSnapshot; dispatch: Dispatch }) {\n+    const reports = sessions.reports\n+    const [message, setMessage] = useState<string | null>(null)\n+    const [editing, setEditing] = useState<Report | null>(null)\n+    const send = async (intent: Parameters<Dispatch>[0]) => setMessage(outcomeMessage(await dispatch(intent)))\n+    const exporting = sessions.export?.kind === 'reports' ? sessions.export : null\n+    return (\n+        <div className='flex flex-col gap-4' data-slot='sessions-reports'>\n+            <p className='text-academy-ink-soft text-[13px]'>\n+                False-positive and false-negative reports for this tenant, kept on this Mac. They hold scan metadata and\n+                your reason only; they suppress nothing and change no policy.\n+            </p>\n+            {reports.state === 'loading' ? <p role='status'>Opening reports…</p> : null}\n+            {reports.state === 'failed' ? (\n+                <Callout tone='danger' icon={AlertTriangle} role='alert'>\n+                    {reports.failure === 'unreadable'\n+                        ? 'This tenant’s report file could not be read. It was kept unchanged.'\n+                        : 'This tenant’s reports could not be opened.'}\n+                </Callout>\n+            ) : null}\n+            {reports.unsaved ? (\n+                <Callout tone='danger' icon={AlertTriangle} role='alert'>\n+                    The last change could not be saved on this Mac. It is shown here but will be lost when the app quits.\n+                </Callout>\n+            ) : null}\n+            {reports.undo ? (\n+                <div className='flex flex-wrap items-center gap-2 text-[13px]' role='status'>\n+                    {`Removed the report for ${reports.undo.scanId}.`}\n+                    <Button type='button' size='sm' tier='secondary' onClick={() => void send({ kind: 'undoReport', context })}>\n+                        Undo\n+                    </Button>\n+                </div>\n+            ) : null}\n+            {reports.state === 'ready' && reports.items.length === 0 ? <p className='text-[13px]'>No reports yet. Report a scan from its session.</p> : null}\n+            {reports.items.length > 0 ? (\n+                <>\n+                    <table className='w-full border-collapse text-left text-[13px]' data-slot='sessions-reports-table'>\n+                        <caption className='sr-only'>FP/FN reports</caption>\n+                        <thead>\n+                            <tr className='border-academy-rule border-b'>\n+                                <th scope='col' className='py-2 pr-3 font-medium'>\n+                                    Scan\n+                                </th>\n+                                <th scope='col' className='py-2 pr-3 font-medium'>\n+                                    Kind\n+                                </th>\n+                                <th scope='col' className='py-2 pr-3 font-medium'>\n+                                    Reason\n+                                </th>\n+                                <th scope='col' className='py-2 font-medium'>\n+                                    <span className='sr-only'>Actions</span>\n+                                </th>\n+                            </tr>\n+                        </thead>\n+                        <tbody>\n+                            {reports.items.map((r) => (\n+                                <tr key={`${r.scanId}-${r.scanSubReqId}`} className='border-academy-rule border-b align-top' data-slot='sessions-report-row'>\n+                                    <td className='py-2 pr-3'>\n+                                        <span className='font-mono text-[12px] break-all'>{r.scanId}</span>\n+                                        <span className='text-academy-ink-soft block text-[12px]'>\n+                                            {[r.application, VERDICT_TEXT[r.verdict as Verdict] ?? fieldText(r.verdict), r.detectors.join(', ')].filter(Boolean).join(' · ')}\n+                                        </span>\n+                                    </td>\n+                                    <td className='py-2 pr-3'>\n+                                        {KIND_TEXT[r.kind]}\n+                                        {r.category ? <span className='text-academy-ink-soft block text-[12px]'>{r.category}</span> : null}\n+                                    </td>\n+                                    <td className='py-2 pr-3 break-words whitespace-pre-wrap'>{r.reason}</td>\n+                                    <td className='flex flex-col gap-1 py-2 text-right'>\n+                                        <Button type='button' size='sm' tier='secondary' aria-label={`Edit report for ${r.scanId}`} onClick={() => setEditing(r)}>\n+                                            Edit…\n+                                        </Button>\n+                                        <Button\n+                                            type='button'\n+                                            size='sm'\n+                                            tier='secondary'\n+                                            aria-label={`Remove report for ${r.scanId}`}\n+                                            onClick={() => void send({ kind: 'removeReport', context, scanId: r.scanId, subRequest: r.scanSubReqId })}\n+                                        >\n+                                            Remove\n+                                        </Button>\n+                                    </td>\n+                                </tr>\n+                            ))}\n+                        </tbody>\n+                    </table>\n+                    <div className='flex flex-wrap gap-2'>\n+                        <Button type='button' tier='secondary' aria-disabled={exporting?.state === 'saving'} onClick={() => void send({ kind: 'exportReports', context })}>\n+                            Export CSV…\n+                        </Button>\n+                    </div>\n+                </>\n+            ) : null}\n+            <ExportStatus view={exporting} />\n+            {editing ? (\n+                <ReportForm\n+                    key={`${editing.scanId}-${editing.scanSubReqId}`}\n+                    context={context}\n+                    dispatch={dispatch}\n+                    problem={reports.problem}\n+                    reportsReady={reports.state === 'ready'}\n+                    target={{ scanId: editing.scanId, subRequest: editing.scanSubReqId, sessionId: '', appId: '', appName: '' }}\n+                    existing={editing}\n+                    suggested={editing.kind}\n+                    onDone={() => setEditing(null)}\n+                />\n+            ) : null}\n+            {message ? <p role='alert' className='text-[13px]'>{message}</p> : null}\n+        </div>\n+    )\n+}\n+\n+/** v1's inert Exception Patterns prototype: synthetic data, nothing live. */\n+function ExceptionPreview() {\n+    return (\n+        <div className='flex flex-col gap-3' data-slot='sessions-exceptions'>\n+            <Callout tone='default' icon={FlaskConical}>\n+                <p className='font-medium'>Synthetic data · Memory only · No live integrations</p>\n+                <p className='mt-1'>\n+                    A preview of how recurring false positives could become reviewed exception patterns. Nothing here\n+                    reads or changes a tenant, and nothing is kept.\n+                </p>\n+            </Callout>\n+            <table className='w-full border-collapse text-left text-[13px]'>\n+                <caption className='sr-only'>Synthetic exception pattern preview</caption>\n+                <thead>\n+                    <tr className='border-academy-rule border-b'>\n+                        <th scope='col' className='py-2 pr-3 font-medium'>\n+                            Pattern\n+                        </th>\n+                        <th scope='col' className='py-2 pr-3 font-medium'>\n+                            Simulated matches\n+                        </th>\n+                        <th scope='col' className='py-2 font-medium'>\n+                            State\n+                        </th>\n+                    </tr>\n+                </thead>\n+                <tbody>\n+                    <tr className='border-academy-rule border-b'>\n+                        <td className='py-2 pr-3'>Order numbers flagged as card numbers (sim-application-001)</td>\n+                        <td className='py-2 pr-3'>12</td>\n+                        <td className='py-2'>Simulated · not applied</td>\n+                    </tr>\n+                </tbody>\n+            </table>\n+        </div>\n+    )\n+}\ndiff --git a/apps/desktop/src/modules/tenants/credential-entry.test.tsx b/apps/desktop/src/modules/tenants/credential-entry.test.tsx\nnew file mode 100644\nindex 00000000..bf8204dd\n--- /dev/null\n+++ b/apps/desktop/src/modules/tenants/credential-entry.test.tsx\n@@ -0,0 +1,142 @@\n+/**\n+ * Production scan-key entry through the real App, DesktopClient and shell:\n+ * fresh capture at submission, transient handling, storage-mode choice and\n+ * truthful outcome reporting.\n+ */\n+import { act, render, screen, within } from '@testing-library/react'\n+import userEvent from '@testing-library/user-event'\n+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest'\n+import { DesktopClient } from '@prisma-airs/desktop-contracts'\n+import { App } from '../../app'\n+import { baseSnapshot, type Native, scriptedNative, tenant, withTenant, framed } from '../../test/native'\n+\n+const KEY = 'synthetic-scan-key-0042'\n+\n+async function openSettings(native: Native) {\n+    const user = userEvent.setup()\n+    render(<App client={new DesktopClient(native.transport)} />)\n+    // C44: one presentation; the core names the destination in the snapshot.\n+    await native.push({ ...native.current, onboarding: 'done', activeFeature: 'settings' })\n+    return user\n+}\n+\n+const keyField = () => screen.getByLabelText('AIRS API key') as HTMLInputElement\n+\n+let setItem: ReturnType<typeof vi.spyOn>\n+beforeEach(() => {\n+    setItem = vi.spyOn(Storage.prototype, 'setItem')\n+})\n+afterEach(() => setItem.mockRestore())\n+\n+describe('scan-key entry', () => {\n+    it('captures the key typed at submission time and clears the field before awaiting', async () => {\n+        const native = framed(scriptedNative(withTenant(baseSnapshot, tenant())), 'settings')\n+        let admit: (value: unknown) => void = () => undefined\n+        native.respond = () => new Promise((resolve) => (admit = resolve))\n+        const user = await openSettings(native)\n+        await user.type(keyField(), 'first-draft')\n+        await user.clear(keyField())\n+        await user.type(keyField(), KEY)\n+        await user.click(screen.getByRole('button', { name: 'Save key' }))\n+        expect(keyField().value).toBe('')\n+        expect(native.dispatched).toEqual([\n+            {\n+                kind: 'configureScanCredential',\n+                context: 'cx-aaaaaaaaaaaaaaaaaaaaaaaa',\n+                mode: 'keychain',\n+                key: KEY,\n+            },\n+        ])\n+        await act(async () => admit({ outcome: 'receipt', receipt: { kind: 'admitted', request: 'rq-1', operation: null } }))\n+        expect(screen.queryByRole('alert')).toBeNull()\n+    })\n+\n+    it('keeps the key out of snapshots, observations, the page and browser storage', async () => {\n+        const native = framed(scriptedNative(withTenant(baseSnapshot, tenant())), 'settings')\n+        const user = await openSettings(native)\n+        await user.type(keyField(), KEY)\n+        await user.click(screen.getByRole('button', { name: 'Save key' }))\n+        await native.push(\n+            withTenant(baseSnapshot, tenant({ scan: { state: 'ready', mode: 'keychain', failure: null } }), 'cx-bbbbbbbbbbbbbbbbbbbbbbbb')\n+        )\n+        expect(screen.getByText('Scan key saved in the Keychain.')).toBeInTheDocument()\n+        const withKey = native.sent.filter((body) => body.includes(KEY))\n+        expect(withKey).toHaveLength(1)\n+        expect(JSON.parse(withKey[0]!).intent.kind).toBe('configureScanCredential')\n+        expect(native.delivered.some((update) => update.includes(KEY))).toBe(false)\n+        expect(document.body.innerHTML).not.toContain(KEY)\n+        expect(setItem).not.toHaveBeenCalled()\n+    })\n+\n+    it('sends the session-only choice when selected', async () => {\n+        const native = framed(scriptedNative(withTenant(baseSnapshot, tenant())), 'settings')\n+        const user = await openSettings(native)\n+        const scanKey = document.querySelector<HTMLElement>('[data-slot=\"scan-key\"]') as HTMLElement\n+        await user.click(within(scanKey).getByRole('radio', { name: /For this session only/ }))\n+        await user.type(keyField(), KEY)\n+        await user.click(screen.getByRole('button', { name: 'Save key' }))\n+        expect(native.dispatched.at(-1)).toMatchObject({ kind: 'configureScanCredential', mode: 'session' })\n+    })\n+\n+    it('reports a refusal without claiming the key was saved', async () => {\n+        const native = framed(scriptedNative(withTenant(baseSnapshot, tenant())), 'settings')\n+        native.respond = () => ({ outcome: 'refusal', refusal: 'staleContext' })\n+        const user = await openSettings(native)\n+        await user.type(keyField(), KEY)\n+        await user.click(screen.getByRole('button', { name: 'Save key' }))\n+        expect(await screen.findByRole('alert')).toHaveTextContent(/active tenant changed/i)\n+        expect(keyField().value).toBe('')\n+        expect(screen.getByText(/No scan key/)).toBeInTheDocument()\n+    })\n+\n+    it('reports an unconfirmed delivery as unknown', async () => {\n+        const native = framed(scriptedNative(withTenant(baseSnapshot, tenant())), 'settings')\n+        native.respond = () => Promise.reject(new Error('lost'))\n+        const user = await openSettings(native)\n+        await user.type(keyField(), KEY)\n+        await user.click(screen.getByRole('button', { name: 'Save key' }))\n+        expect(await screen.findByRole('alert')).toHaveTextContent(/did not confirm/i)\n+        const configure = native.dispatched.filter((i) => i.kind === 'configureScanCredential')\n+        expect(configure.length).toBeGreaterThan(0)\n+        expect(new Set(native.sent.filter((b) => b.includes(KEY)))).toHaveProperty('size', 1)\n+    })\n+\n+    it('refuses an empty key locally and focuses the field', async () => {\n+        const native = framed(scriptedNative(withTenant(baseSnapshot, tenant())), 'settings')\n+        const user = await openSettings(native)\n+        await user.click(screen.getByRole('button', { name: 'Save key' }))\n+        expect(await screen.findByRole('alert')).toHaveTextContent('Enter the scan key.')\n+        expect(keyField()).toHaveFocus()\n+        expect(native.dispatched).toEqual([])\n+    })\n+\n+    it('shows locked and denied failures with explicit recovery, never a fallback', async () => {\n+        const native = framed(scriptedNative(\n+            withTenant(baseSnapshot, tenant({ scan: { state: 'failed', mode: 'keychain', failure: 'locked' } }))\n+        ), 'settings')\n+        await openSettings(native)\n+        expect(screen.getByText(/Keychain is locked/)).toBeInTheDocument()\n+        await native.push(withTenant(baseSnapshot, tenant({ scan: { state: 'failed', mode: 'keychain', failure: 'denied' } })))\n+        expect(screen.getByText(/did not allow access/)).toBeInTheDocument()\n+        expect(screen.getByRole('button', { name: 'Replace key' })).toBeInTheDocument()\n+    })\n+\n+    it('removes the scan key under the current context', async () => {\n+        const native = framed(scriptedNative(\n+            withTenant(baseSnapshot, tenant({ scan: { state: 'ready', mode: 'session', failure: null } }))\n+        ), 'settings')\n+        const user = await openSettings(native)\n+        expect(screen.getByText('Scan key held for this session only.')).toBeInTheDocument()\n+        await user.click(screen.getByRole('button', { name: 'Remove scan key' }))\n+        expect(native.dispatched).toEqual([{ kind: 'removeScanCredential', context: 'cx-aaaaaaaaaaaaaaaaaaaaaaaa' }])\n+    })\n+\n+    it('discards a partially typed key when the context changes', async () => {\n+        const native = framed(scriptedNative(withTenant(baseSnapshot, tenant())), 'settings')\n+        const user = await openSettings(native)\n+        await user.type(keyField(), 'partial')\n+        await native.push(withTenant(baseSnapshot, tenant(), 'cx-cccccccccccccccccccccccc'))\n+        expect(keyField().value).toBe('')\n+        expect(native.dispatched).toEqual([])\n+    })\n+})\ndiff --git a/apps/desktop/src/modules/tenants/credential-entry.tsx b/apps/desktop/src/modules/tenants/credential-entry.tsx\nnew file mode 100644\nindex 00000000..5bad24f3\n--- /dev/null\n+++ b/apps/desktop/src/modules/tenants/credential-entry.tsx\n@@ -0,0 +1,158 @@\n+import { type FormEvent, useId, useRef, useState } from 'react'\n+import { Button, Callout, Input } from '@ai-security-academy/presentation'\n+import { AlertTriangle, CheckCircle2, Info } from 'lucide-react'\n+import type { ContextRef, StorageMode, TenantView, VaultError } from '@prisma-airs/desktop-contracts'\n+import { type Dispatch, outcomeMessage } from './dispatch'\n+\n+const FAILURE_TEXT: Record<VaultError, string> = {\n+    locked: 'The Keychain is locked. Unlock it and enter the key again, or keep it for this session only.',\n+    denied: 'macOS did not allow access to the Keychain. Enter the key again, or keep it for this session only.',\n+    unavailable: 'The credential store is not available. Enter the key again, or keep it for this session only.',\n+    notFound: 'The stored key is missing. Enter it again.',\n+    corrupt: 'The stored key could not be read. Enter it again.',\n+}\n+\n+function scanStatus(tenant: TenantView): { tone: 'default' | 'success' | 'danger'; text: string } {\n+    const { state, mode, failure } = tenant.scan\n+    switch (state) {\n+        case 'missing':\n+            return { tone: 'default', text: 'No scan key. Enter this tenant’s AIRS API key to enable scans.' }\n+        case 'storing':\n+            return { tone: 'default', text: 'Saving the scan key…' }\n+        case 'ready':\n+            return {\n+                tone: 'success',\n+                text: mode === 'session' ? 'Scan key held for this session only.' : 'Scan key saved in the Keychain.',\n+            }\n+        case 'failed':\n+            return { tone: 'danger', text: failure ? FAILURE_TEXT[failure] : 'The scan key could not be saved.' }\n+    }\n+}\n+\n+interface Props {\n+    tenant: TenantView\n+    context: ContextRef\n+    dispatch: Dispatch\n+}\n+\n+/**\n+ * Scan-key entry for the active tenant. The key is read from the field at\n+ * the moment of submission and the field is cleared before the request is\n+ * awaited; it is never held in React state, storage or any snapshot. (A\n+ * JavaScript string cannot be reliably zeroized; the native side keeps it.)\n+ */\n+export function ScanKeyForm({ tenant, context, dispatch }: Props) {\n+    const [mode, setMode] = useState<StorageMode>('keychain')\n+    const [message, setMessage] = useState<string | null>(null)\n+    const [busy, setBusy] = useState(false)\n+    const keyRef = useRef<HTMLInputElement>(null)\n+    const keyId = useId()\n+    const hintId = useId()\n+    const modeLegend = useId()\n+    const status = scanStatus(tenant)\n+    const hasKey = tenant.scan.state === 'ready' || tenant.scan.state === 'failed'\n+\n+    async function submit(event: FormEvent<HTMLFormElement>) {\n+        event.preventDefault()\n+        const field = keyRef.current\n+        if (!field) return\n+        const key = field.value\n+        field.value = ''\n+        if (key.length === 0) {\n+            setMessage('Enter the scan key.')\n+            field.focus()\n+            return\n+        }\n+        setBusy(true)\n+        setMessage(null)\n+        const outcome = await dispatch({ kind: 'configureScanCredential', context, mode, key })\n+        setBusy(false)\n+        setMessage(outcomeMessage(outcome))\n+    }\n+\n+    async function remove() {\n+        setBusy(true)\n+        setMessage(null)\n+        const outcome = await dispatch({ kind: 'removeScanCredential', context })\n+        setBusy(false)\n+        setMessage(outcomeMessage(outcome))\n+    }\n+\n+    return (\n+        <section aria-labelledby={`${keyId}-heading`} data-slot='scan-key' className='flex flex-col gap-3'>\n+            <h3 id={`${keyId}-heading`} className='text-academy-ink text-[14px] font-semibold'>\n+                Scan key\n+            </h3>\n+            <Callout\n+                tone={status.tone}\n+                icon={status.tone === 'success' ? CheckCircle2 : status.tone === 'danger' ? AlertTriangle : Info}\n+                role='status'\n+                aria-live='polite'\n+                data-slot='scan-status'\n+            >\n+                {status.text}\n+            </Callout>\n+            <form onSubmit={(e) => void submit(e)} className='flex flex-col gap-3' aria-busy={busy}>\n+                <label htmlFor={keyId} className='text-academy-ink text-[13px] font-medium'>\n+                    AIRS API key\n+                </label>\n+                <Input\n+                    ref={keyRef}\n+                    id={keyId}\n+                    name='scan-key'\n+                    type='password'\n+                    autoComplete='off'\n+                    autoCapitalize='off'\n+                    autoCorrect='off'\n+                    spellCheck={false}\n+                    aria-describedby={hintId}\n+                    data-slot='scan-key-input'\n+                />\n+                <p id={hintId} className='text-academy-ink-faint text-[12px]'>\n+                    Sent only to {tenant.origin}. Entering a new key replaces the current one.\n+                </p>\n+                <fieldset aria-labelledby={modeLegend} className='flex flex-col gap-1'>\n+                    <legend id={modeLegend} className='text-academy-ink text-[13px] font-medium'>\n+                        Keep the key\n+                    </legend>\n+                    {(\n+                        [\n+                            ['keychain', 'In the Keychain', 'Available after restarting the desktop'],\n+                            ['session', 'For this session only', 'Forgotten when the desktop quits'],\n+                        ] as const\n+                    ).map(([value, label, hint]) => (\n+                        <label key={value} className='flex min-h-11 cursor-pointer items-center gap-3'>\n+                            <input\n+                                type='radio'\n+                                name='scan-key-mode'\n+                                value={value}\n+                                checked={mode === value}\n+                                onChange={() => setMode(value)}\n+                                className='size-4 accent-[var(--academy-accent)]'\n+                            />\n+                            <span className='flex flex-col'>\n+                                <span className='text-academy-ink text-[13px]'>{label}</span>\n+                                <span className='text-academy-ink-faint text-[12px]'>{hint}</span>\n+                            </span>\n+                        </label>\n+                    ))}\n+                </fieldset>\n+                <div className='flex flex-wrap gap-2'>\n+                    <Button type='submit' tier='primary' disabled={busy}>\n+                        {hasKey ? 'Replace key' : 'Save key'}\n+                    </Button>\n+                    {hasKey ? (\n+                        <Button type='button' tier='secondary' disabled={busy} onClick={() => void remove()}>\n+                            Remove scan key\n+                        </Button>\n+                    ) : null}\n+                </div>\n+                {message ? (\n+                    <p role='alert' data-slot='scan-key-message' className='text-academy-accent-warn text-[13px]'>\n+                        {message}\n+                    </p>\n+                ) : null}\n+            </form>\n+        </section>\n+    )\n+}\ndiff --git a/apps/desktop/src/modules/tenants/dispatch.ts b/apps/desktop/src/modules/tenants/dispatch.ts\nnew file mode 100644\nindex 00000000..e99c78b2\n--- /dev/null\n+++ b/apps/desktop/src/modules/tenants/dispatch.ts\n@@ -0,0 +1,41 @@\n+import type { Intent, Refusal } from '@prisma-airs/desktop-contracts'\n+\n+/** What the presentation learned about one delivered intent. */\n+export type DispatchOutcome =\n+    /** Admitted; `operation` names native work the intent started, if any. */\n+    | { kind: 'admitted'; operation: string | null }\n+    | { kind: 'refused'; refusal: Refusal }\n+    /** The desktop did not confirm admission; the current state is shown. */\n+    | { kind: 'unknown' }\n+    | { kind: 'failed' }\n+\n+export type Dispatch = (intent: Intent) => Promise<DispatchOutcome>\n+\n+const REFUSAL_TEXT: Record<Refusal, string> = {\n+    staleContext: 'The active tenant changed before this was applied. Check the current tenant and try again.',\n+    capabilityMissing: 'That is not available for the current tenant.',\n+    invalidInput: 'Check the entered values and try again.',\n+    reviewInvalid: 'This review is no longer valid. Start a new review.',\n+    reviewConsumed: 'This review was already used.',\n+    busy: 'The desktop is busy with a previous request. Try again in a moment.',\n+    lockedStore: 'The Keychain is locked. Unlock it and try again.',\n+    deniedStore: 'Local desktop data or the credential store is not available.',\n+    alreadyProcessed: 'That request was already processed.',\n+    sequenceGap: 'The request was not delivered in order. Try again.',\n+    shuttingDown: 'The desktop is shutting down.',\n+    decisionPending: 'A Harness decision is pending; resolve it before switching tenants.',\n+}\n+\n+/** Sanitized operator text for an outcome that did not apply. */\n+export function outcomeMessage(outcome: DispatchOutcome): string | null {\n+    switch (outcome.kind) {\n+        case 'admitted':\n+            return null\n+        case 'refused':\n+            return REFUSAL_TEXT[outcome.refusal]\n+        case 'unknown':\n+            return 'The desktop did not confirm the request. The current state is shown; check it before trying again.'\n+        case 'failed':\n+            return 'The request could not be delivered.'\n+    }\n+}\ndiff --git a/apps/desktop/src/modules/tenants/management-credential.tsx b/apps/desktop/src/modules/tenants/management-credential.tsx\nnew file mode 100644\nindex 00000000..5b254b52\n--- /dev/null\n+++ b/apps/desktop/src/modules/tenants/management-credential.tsx\n@@ -0,0 +1,229 @@\n+import { type FormEvent, useId, useRef, useState } from 'react'\n+import { Button, Callout, Input } from '@ai-security-academy/presentation'\n+import { AlertTriangle, CheckCircle2, Info } from 'lucide-react'\n+import type { ContextRef, StorageMode, TenantView, VaultError } from '@prisma-airs/desktop-contracts'\n+import { MANAGEMENT_FAILURE_TEXT, type ObserveManagement, readManagement } from '../administration/management-read'\n+import { type Dispatch, outcomeMessage } from './dispatch'\n+\n+const FAILURE_TEXT: Record<VaultError, string> = {\n+    locked: 'The Keychain is locked. Unlock it and enter the secret again, or keep it for this session only.',\n+    denied: 'macOS did not allow access to the Keychain. Enter the secret again, or keep it for this session only.',\n+    unavailable: 'The credential store is not available. Enter the secret again, or keep it for this session only.',\n+    notFound: 'The stored client secret is missing. Enter it again.',\n+    corrupt: 'The stored client secret could not be read. Enter it again.',\n+}\n+\n+function status(tenant: TenantView): { tone: 'default' | 'success' | 'danger'; text: string } {\n+    const { state, mode, failure } = tenant.management\n+    switch (state) {\n+        case 'missing':\n+            return {\n+                tone: 'default',\n+                text: 'No management client. Scans do not need one; add one to read this tenant’s inventories in Administration.',\n+            }\n+        case 'storing':\n+            return { tone: 'default', text: 'Saving the management client…' }\n+        case 'ready':\n+            return {\n+                tone: 'success',\n+                text:\n+                    mode === 'session'\n+                        ? 'Management client secret held for this session only.'\n+                        : 'Management client secret saved in the Keychain.',\n+            }\n+        case 'failed':\n+            return { tone: 'danger', text: failure ? FAILURE_TEXT[failure] : 'The management client could not be saved.' }\n+    }\n+}\n+\n+interface Props {\n+    tenant: TenantView\n+    context: ContextRef\n+    dispatch: Dispatch\n+    observe: ObserveManagement\n+}\n+\n+/**\n+ * The tenant's separate management OAuth client (C08). It never replaces or\n+ * reads the scan key. The secret is read from its field at submission and\n+ * the field is cleared before the request is awaited; it is never held in\n+ * React state, storage or any snapshot. Verify performs one bounded\n+ * management read with the stored client.\n+ */\n+export function ManagementCredentialForm({ tenant, context, dispatch, observe }: Props) {\n+    const [mode, setMode] = useState<StorageMode>('keychain')\n+    const [message, setMessage] = useState<string | null>(null)\n+    const [verified, setVerified] = useState<string | null>(null)\n+    const [busy, setBusy] = useState(false)\n+    const secretRef = useRef<HTMLInputElement>(null)\n+    const clientRef = useRef<HTMLInputElement>(null)\n+    const ids = useId()\n+    const shown = status(tenant)\n+    const view = tenant.management\n+    const hasClient = view.state === 'ready' || view.state === 'failed'\n+    const noTsg = tenant.tsgId === null\n+\n+    async function submit(event: FormEvent<HTMLFormElement>) {\n+        event.preventDefault()\n+        const secretField = secretRef.current\n+        const clientField = clientRef.current\n+        if (!secretField || !clientField) return\n+        const secret = secretField.value\n+        secretField.value = ''\n+        const clientId = clientField.value.trim()\n+        setVerified(null)\n+        if (clientId.length === 0) {\n+            setMessage('Enter the client ID.')\n+            clientField.focus()\n+            return\n+        }\n+        if (secret.length === 0) {\n+            setMessage('Enter the client secret.')\n+            secretField.focus()\n+            return\n+        }\n+        setBusy(true)\n+        setMessage(null)\n+        const outcome = await dispatch({ kind: 'configureManagementCredential', context, mode, clientId, secret })\n+        setBusy(false)\n+        setMessage(outcomeMessage(outcome))\n+    }\n+\n+    async function verify() {\n+        setBusy(true)\n+        setMessage(null)\n+        setVerified(null)\n+        const outcome = await readManagement(dispatch, observe, context, { kind: 'verify' })\n+        setBusy(false)\n+        if (outcome.kind === 'notAdmitted') setMessage(outcome.message)\n+        else if (outcome.result.kind === 'verified') setVerified('The management client can read this tenant.')\n+        else if (outcome.result.kind === 'failed') setMessage(MANAGEMENT_FAILURE_TEXT[outcome.result.failure])\n+        else setMessage('The service returned a reply the desktop could not use.')\n+    }\n+\n+    async function remove() {\n+        setBusy(true)\n+        setMessage(null)\n+        setVerified(null)\n+        const outcome = await dispatch({ kind: 'removeManagementCredential', context })\n+        setBusy(false)\n+        setMessage(outcomeMessage(outcome))\n+    }\n+\n+    return (\n+        <section aria-labelledby={`${ids}-heading`} data-slot='management-credential' className='flex flex-col gap-3'>\n+            <h3 id={`${ids}-heading`} className='text-academy-ink text-[14px] font-semibold'>\n+                Management client\n+            </h3>\n+            <Callout\n+                tone={shown.tone}\n+                icon={shown.tone === 'success' ? CheckCircle2 : shown.tone === 'danger' ? AlertTriangle : Info}\n+                role='status'\n+                aria-live='polite'\n+                data-slot='management-status'\n+            >\n+                {shown.text}\n+                {view.clientId ? (\n+                    <span className='text-academy-ink-soft mt-1 block text-[12px]' data-slot='management-client-id'>\n+                        Client ID: {view.clientId}\n+                    </span>\n+                ) : null}\n+            </Callout>\n+            {noTsg ? (\n+                <Callout tone='warning' icon={AlertTriangle} data-slot='management-no-tsg'>\n+                    This tenant has no TSG ID. Add one to its profile before configuring a management client.\n+                </Callout>\n+            ) : null}\n+            <p className='text-academy-ink-faint text-[12px]' data-slot='management-sso-pointer'>\n+                Company sign-in (SSO) for the Harness is set up per Gateway workspace, in Harness.\n+            </p>\n+            <form onSubmit={(e) => void submit(e)} className='flex flex-col gap-3' aria-busy={busy}>\n+                <label htmlFor={`${ids}-client`} className='text-academy-ink text-[13px] font-medium'>\n+                    Client ID\n+                </label>\n+                <Input\n+                    ref={clientRef}\n+                    id={`${ids}-client`}\n+                    name='management-client-id'\n+                    autoComplete='off'\n+                    autoCapitalize='off'\n+                    autoCorrect='off'\n+                    spellCheck={false}\n+                    defaultValue={view.clientId ?? ''}\n+                    maxLength={1024}\n+                    data-slot='management-client-input'\n+                />\n+                <label htmlFor={`${ids}-secret`} className='text-academy-ink text-[13px] font-medium'>\n+                    Client secret\n+                </label>\n+                <Input\n+                    ref={secretRef}\n+                    id={`${ids}-secret`}\n+                    name='management-secret'\n+                    type='password'\n+                    autoComplete='off'\n+                    autoCapitalize='off'\n+                    autoCorrect='off'\n+                    spellCheck={false}\n+                    aria-describedby={`${ids}-hint`}\n+                    data-slot='management-secret-input'\n+                />\n+                <p id={`${ids}-hint`} className='text-academy-ink-faint text-[12px]'>\n+                    The secret is sent only to {view.tokenOrigin ?? 'the Palo Alto Networks token service'} to obtain\n+                    short-lived access tokens. It is separate from the scan key.\n+                </p>\n+                <fieldset aria-labelledby={`${ids}-mode`} className='flex flex-col gap-1'>\n+                    <legend id={`${ids}-mode`} className='text-academy-ink text-[13px] font-medium'>\n+                        Keep the secret\n+                    </legend>\n+                    {(\n+                        [\n+                            ['keychain', 'In the Keychain', 'Available after restarting the desktop'],\n+                            ['session', 'For this session only', 'Forgotten when the desktop quits'],\n+                        ] as const\n+                    ).map(([value, label, hint]) => (\n+                        <label key={value} className='flex min-h-11 cursor-pointer items-center gap-3'>\n+                            <input\n+                                type='radio'\n+                                name='management-mode'\n+                                value={value}\n+                                checked={mode === value}\n+                                onChange={() => setMode(value)}\n+                                className='size-4 accent-[var(--academy-accent)]'\n+                            />\n+                            <span className='flex flex-col'>\n+                                <span className='text-academy-ink text-[13px]'>{label}</span>\n+                                <span className='text-academy-ink-faint text-[12px]'>{hint}</span>\n+                            </span>\n+                        </label>\n+                    ))}\n+                </fieldset>\n+                <div className='flex flex-wrap gap-2'>\n+                    <Button type='submit' tier='primary' disabled={busy || noTsg}>\n+                        {hasClient ? 'Replace client' : 'Save client'}\n+                    </Button>\n+                    {view.state === 'ready' ? (\n+                        <Button type='button' tier='secondary' disabled={busy} onClick={() => void verify()}>\n+                            Verify\n+                        </Button>\n+                    ) : null}\n+                    {hasClient ? (\n+                        <Button type='button' tier='secondary' disabled={busy} onClick={() => void remove()}>\n+                            Remove management client\n+                        </Button>\n+                    ) : null}\n+                </div>\n+                {verified ? (\n+                    <p role='status' data-slot='management-verified' className='text-academy-ink text-[13px]'>\n+                        {verified}\n+                    </p>\n+                ) : null}\n+                {message ? (\n+                    <p role='alert' data-slot='management-message' className='text-academy-accent-warn text-[13px]'>\n+                        {message}\n+                    </p>\n+                ) : null}\n+            </form>\n+        </section>\n+    )\n+}\ndiff --git a/apps/desktop/src/modules/tenants/reset.test.tsx b/apps/desktop/src/modules/tenants/reset.test.tsx\nnew file mode 100644\nindex 00000000..7ed12df7\n--- /dev/null\n+++ b/apps/desktop/src/modules/tenants/reset.test.tsx\n@@ -0,0 +1,76 @@\n+/**\n+ * Reset and storage-durability presentation through the real App and shell:\n+ * the two-step reset, stage-specific failure text that never claims retired\n+ * keys are still saved, and the unconfirmed-durability notice.\n+ */\n+import { render, screen, within } from '@testing-library/react'\n+import userEvent from '@testing-library/user-event'\n+import { describe, expect, it } from 'vitest'\n+import { DesktopClient } from '@prisma-airs/desktop-contracts'\n+import { App } from '../../app'\n+import { baseSnapshot, type Native, scriptedNative, tenant, withTenant, framed } from '../../test/native'\n+\n+async function openSettings(native: Native) {\n+    const user = userEvent.setup()\n+    render(<App client={new DesktopClient(native.transport)} />)\n+    // C44: one presentation; the core names the destination in the snapshot.\n+    await native.push({ ...native.current, onboarding: 'done', activeFeature: 'settings' })\n+    return user\n+}\n+\n+const resetSection = () => screen.getByRole('region', { name: 'Reset local data' })\n+\n+describe('reset local data', () => {\n+    it('asks for confirmation before dispatching a reset', async () => {\n+        const native = framed(scriptedNative(withTenant(baseSnapshot, tenant())), 'settings')\n+        const user = await openSettings(native)\n+        await user.click(within(resetSection()).getByRole('button', { name: 'Reset local data…' }))\n+        expect(native.dispatched).toEqual([])\n+        await user.click(within(resetSection()).getByRole('button', { name: 'Confirm reset' }))\n+        expect(native.dispatched).toEqual([{ kind: 'resetLocalData' }])\n+    })\n+\n+    it('explains a stop while deleting keys without claiming the keys were kept', async () => {\n+        const native = framed(scriptedNative(withTenant(baseSnapshot, tenant())), 'settings')\n+        await openSettings(native)\n+        await native.push({\n+            ...withTenant(baseSnapshot, tenant()),\n+            resetFailure: { stage: 'credentials', reason: 'locked' },\n+        })\n+        const alert = within(resetSection()).getByRole('alert')\n+        expect(alert).toHaveTextContent(/Reset stopped while deleting scan keys because the Keychain is locked/)\n+        expect(alert).toHaveTextContent(/removed from use/)\n+        expect(alert).not.toHaveTextContent(/data was kept/i)\n+        expect(screen.getByText(/scan key missing/)).toBeInTheDocument()\n+    })\n+\n+    it('explains a stop while removing the document after the keys were deleted', async () => {\n+        const native = framed(scriptedNative(withTenant(baseSnapshot, tenant())), 'settings')\n+        await openSettings(native)\n+        await native.push({\n+            ...withTenant(baseSnapshot, tenant()),\n+            resetFailure: { stage: 'document', reason: 'unavailable' },\n+        })\n+        expect(within(resetSection()).getByRole('alert')).toHaveTextContent(\n+            /deleted the scan keys but could not remove the local desktop data/\n+        )\n+    })\n+\n+    it('says while resetting that keys are out of use', async () => {\n+        const native = framed(scriptedNative(withTenant(baseSnapshot, tenant())), 'settings')\n+        await openSettings(native)\n+        await native.push({ ...baseSnapshot, storage: 'resetting', tenants: [tenant()], active: null })\n+        expect(screen.getByText(/Scan keys are out of use until it finishes/)).toBeInTheDocument()\n+        expect(screen.queryByLabelText('AIRS API key')).toBeNull()\n+    })\n+\n+    it('reports a change whose durability was not confirmed', async () => {\n+        const native = framed(scriptedNative(withTenant(baseSnapshot, tenant())), 'settings')\n+        await openSettings(native)\n+        expect(document.querySelector('[data-slot=\"durability-notice\"]')).toBeNull()\n+        await native.push({ ...withTenant(baseSnapshot, tenant()), durabilityUnconfirmed: true })\n+        expect(document.querySelector('[data-slot=\"durability-notice\"]')).toHaveTextContent(\n+            /saved, but macOS did not confirm it was written to disk/\n+        )\n+    })\n+})\ndiff --git a/apps/desktop/src/modules/workbench/request-send.test.tsx b/apps/desktop/src/modules/workbench/request-send.test.tsx\nnew file mode 100644\nindex 00000000..28e3ffbe\n--- /dev/null\n+++ b/apps/desktop/src/modules/workbench/request-send.test.tsx\n@@ -0,0 +1,285 @@\n+/**\n+ * API Client Send through the real App, DesktopClient and shell (C15):\n+ * Send carries the fields the editor holds at the click (typed before the\n+ * protection debounce, never saved) with the active tenant context; a\n+ * known tenant change shows its review, and Apply sends the fresh snapshot\n+ * with the review ID (the presentation cannot mark anything approved);\n+ * refusals and uncertain outcomes are explained; a running request can be\n+ * cancelled; history shows runs and saving a response goes through the\n+ * native sheet.\n+ */\n+import { render, screen, waitFor, within } from '@testing-library/react'\n+import userEvent from '@testing-library/user-event'\n+import { describe, expect, it } from 'vitest'\n+import {\n+    type CollectionView,\n+    DesktopClient,\n+    type DocumentView,\n+    type Fields,\n+    type Intent,\n+    type RunRecord,\n+    type RunView,\n+    type SendReviewView,\n+    type ShellSnapshot,\n+    type WorkbenchRequest,\n+    type WorkbenchResult,\n+} from '@prisma-airs/desktop-contracts'\n+import { App } from '../../app'\n+import { baseSnapshot, type Native, scriptedNative, tenant, withTenant, framed } from '../../test/native'\n+\n+const R1 = '1'.repeat(32)\n+const CONTEXT = 'cx-aaaaaaaaaaaaaaaaaaaaaaaa'\n+\n+const fields = (overrides: Partial<Fields> = {}): Fields => ({\n+    method: 'GET',\n+    url: 'http://127.0.0.1:8080/items',\n+    headers: '',\n+    query: '',\n+    body: '',\n+    bodyKind: 'text',\n+    settings: '',\n+    ...overrides,\n+})\n+\n+const doc = (overrides: Partial<DocumentView> = {}): DocumentView => ({\n+    id: 'list',\n+    relative: 'items/list.request.toml',\n+    revision: R1,\n+    fields: fields(),\n+    saved: fields(),\n+    new: false,\n+    recovered: false,\n+    bodyEditable: true,\n+    schema: null,\n+    conflict: null,\n+    interrupted: false,\n+    metadataDirty: false,\n+    ...overrides,\n+})\n+\n+const collection = (overrides: Partial<CollectionView> = {}): CollectionView => ({\n+    id: 'c15',\n+    name: 'Exec',\n+    folder: 'api',\n+    scope: '1'.repeat(32),\n+    builtIn: false,\n+    complete: true,\n+    requests: [{ relative: 'items/list.request.toml', id: 'list', method: 'GET', url: 'http://127.0.0.1:8080/items' }],\n+    folders: ['items'],\n+    schemas: [],\n+    issues: [],\n+    environments: [],\n+    environment: null,\n+    tabs: [{ id: 'list', relative: 'items/list.request.toml', method: 'GET', draft: false, new: false, recovered: false, conflict: null, interrupted: false }],\n+    selected: 'list',\n+    secrets: [],\n+    unsaved: null,\n+    archives: 0,\n+    ...overrides,\n+})\n+\n+const opened = (workbench: Partial<ShellSnapshot['workbench']> = {}): ShellSnapshot =>\n+    withTenant({ ...baseSnapshot, workbench: { ...baseSnapshot.workbench, loaded: true, collection: collection(), ...workbench } }, tenant(), CONTEXT)\n+\n+const record = (overrides: Partial<RunRecord> = {}): RunRecord => ({\n+    id: 'run-0123456789abcdef',\n+    request: 'list',\n+    relative: 'items/list.request.toml',\n+    at: 1_760_000_000,\n+    method: 'GET',\n+    url: 'http://127.0.0.1:8080/items',\n+    class: 'anonymous',\n+    operation: null,\n+    state: 'completed',\n+    failure: null,\n+    uncertain: false,\n+    status: 200,\n+    headers: [['content-type', 'application/json']],\n+    redirect: null,\n+    elapsedMs: 42,\n+    bytes: 11,\n+    stored: true,\n+    ...overrides,\n+})\n+\n+const ran = (overrides: Partial<RunRecord> = {}, preview: string | null = '{\"ok\":true}'): RunView => ({\n+    record: record(overrides),\n+    preview,\n+    previewBytes: preview?.length ?? 0,\n+    tokenDropped: false,\n+})\n+\n+const review = (): SendReviewView => ({\n+    review: 'rv-00000000000000aa',\n+    request: 'list',\n+    operation: 'IAM/Delete access policy',\n+    method: 'DELETE',\n+    url: 'https://127.0.0.1:9443/iam/v1/access_policies/abc',\n+    headers: [],\n+    body: '',\n+    bodyBytes: 0,\n+    files: [],\n+    destination: 'https://127.0.0.1:9443',\n+    expires: 1_760_000_900,\n+})\n+\n+type Answer = (request: WorkbenchRequest) => WorkbenchResult | Promise<WorkbenchResult>\n+\n+function workbench(native: Native, answer: Answer): WorkbenchRequest[] {\n+    const requests: WorkbenchRequest[] = []\n+    const pending = new Map<string, WorkbenchRequest>()\n+    const respond = native.respond\n+    native.respond = (intent: Intent) => {\n+        if (intent.kind !== 'workbench') return respond(intent)\n+        requests.push(intent.request)\n+        const operation = `op-${requests.length}`\n+        pending.set(operation, intent.request)\n+        return { outcome: 'receipt', receipt: { kind: 'admitted', request: `rq-${requests.length}`, operation } }\n+    }\n+    native.observeWorkbench = async (operation) => {\n+        const request = pending.get(operation)\n+        if (!request) return { kind: 'refusal', refusal: 'invalidInput' }\n+        return { kind: 'workbench', result: await answer(request) }\n+    }\n+    return requests\n+}\n+\n+const standard =\n+    (sent: Answer): Answer =>\n+    (request) => {\n+        switch (request.kind) {\n+            case 'openRequest':\n+                return { kind: 'document', document: doc(), notes: [] }\n+            case 'protect':\n+                return { kind: 'protected', id: request.id }\n+            case 'send':\n+            case 'apply':\n+            case 'cancel':\n+            case 'history':\n+            case 'showRun':\n+            case 'saveResponse':\n+                return sent(request)\n+            default:\n+                return { kind: 'done' }\n+        }\n+    }\n+\n+const of = <K extends WorkbenchRequest['kind']>(requests: WorkbenchRequest[], kind: K) =>\n+    requests.filter((r): r is Extract<WorkbenchRequest, { kind: K }> => r.kind === kind)\n+\n+async function open(native: Native) {\n+    const user = userEvent.setup()\n+    render(<App client={new DesktopClient(native.transport)} />)\n+    await native.push({ ...native.current, onboarding: 'done', activeFeature: 'apiClient' })\n+    await screen.findByRole('form', { name: 'Request list' })\n+    return user\n+}\n+\n+const url = () => screen.getByRole('textbox', { name: 'URL' }) as HTMLInputElement\n+\n+describe('API Client Send', () => {\n+    it('sends the fields typed before the protection debounce, with the active context', async () => {\n+        const native = framed(scriptedNative(opened()), 'apiClient')\n+        const requests = workbench(native, standard(() => ({ kind: 'ran', run: ran() })))\n+        const user = await open(native)\n+        await user.clear(url())\n+        await user.type(url(), 'http://127.0.0.1:8080/fresh')\n+        await user.click(screen.getByRole('button', { name: 'Send' }))\n+        const response = await screen.findByRole('region', { name: 'Response' })\n+        expect(within(response).getByText('HTTP 200 · 11 B · 42 ms')).toBeInTheDocument()\n+        // C44: the v2 pane pretty-prints JSON first; Raw shows exactly what arrived.\n+        await user.click(within(response).getByRole('button', { name: 'Raw' }))\n+        expect(within(response).getByLabelText('Response body')).toHaveTextContent('{\"ok\":true}')\n+        expect(of(requests, 'send')).toEqual([\n+            { kind: 'send', id: 'list', revision: R1, fields: fields({ url: 'http://127.0.0.1:8080/fresh' }), context: CONTEXT },\n+        ])\n+        // Nothing was saved to send it.\n+        expect(of(requests, 'save')).toHaveLength(0)\n+    })\n+\n+    it('shows a tenant change for review and applies the fresh snapshot with its review ID', async () => {\n+        const native = framed(scriptedNative(opened()), 'apiClient')\n+        const requests = workbench(\n+            native,\n+            standard((request) =>\n+                request.kind === 'send'\n+                    ? { kind: 'reviewRequired', review: review() }\n+                    : { kind: 'ran', run: ran({ method: 'DELETE', class: 'managed', operation: 'IAM/Delete access policy' }) }\n+            )\n+        )\n+        const user = await open(native)\n+        await user.click(screen.getByRole('button', { name: 'Send' }))\n+        expect(await screen.findByText('This change to the tenant needs your review below.')).toBeInTheDocument()\n+        // The review arrives with the native snapshot.\n+        await native.push(opened({ review: review() }))\n+        const panel = (await screen.findByText('Review this change to the tenant: IAM/Delete access policy')).closest('[data-slot=\"workbench-review\"]') as HTMLElement\n+        expect(panel).toHaveAttribute('role', 'alert')\n+        expect(within(panel).getByText('DELETE https://127.0.0.1:9443/iam/v1/access_policies/abc')).toBeInTheDocument()\n+        // Typed after the review: Apply sends what the editor holds now, so\n+        // Rust can see it differs from what was reviewed.\n+        await user.type(url(), '/x')\n+        await user.click(within(panel).getByRole('button', { name: 'Send to tenant…' }))\n+        await waitFor(() => expect(of(requests, 'apply')).toHaveLength(1))\n+        expect(of(requests, 'apply')[0]).toEqual({\n+            kind: 'apply',\n+            review: 'rv-00000000000000aa',\n+            id: 'list',\n+            revision: R1,\n+            fields: fields({ url: 'http://127.0.0.1:8080/items/x' }),\n+            context: CONTEXT,\n+        })\n+        expect(await screen.findByRole('region', { name: 'Response' })).toBeInTheDocument()\n+    })\n+\n+    it('explains refusals and uncertain outcomes,