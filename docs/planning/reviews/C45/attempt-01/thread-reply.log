{"type":"item.completed","item":{"id":"item_34","type":"command_execution","command":"/bin/zsh -lc 'cat tools/p10/test_qualification.py tools/p10/test_build_reuse.py tools/p10/test_continuation.py tools/p10/test_review_gate.py tools/p10/test_stages.py; cat tools/native-acceptance/test_candidate_process.py tools/native-acceptance/test_fixture_safety.py tools/native-acceptance/test_c04_current_frame.py tools/native-acceptance/test_c32_project_path.py'","aggregated_output":"import copy\nimport json\nfrom pathlib import Path\nimport tempfile\nimport unittest\nfrom qualification import verify, sha\n\n\nclass CoverageTests(unittest.TestCase):\n    def setUp(self):\n        self.temp = tempfile.TemporaryDirectory()\n        self.addCleanup(self.temp.cleanup)\n        self.root = Path(self.temp.name)\n        self.candidate = dict(executable_sha256=\"exe\", bundle_sha256=\"bundle\", helper_closure={\"driver\": \"hash\"}, build_flags=[\"fixture\"], conditions={\"os\": \"VM\"}, source_inventory_sha256=\"current\", execution_root=\"/synthetic\", runner_inputs={\"source\":\"current\"})\n        self.ref = self.write(\"candidate.json\", self.candidate)\n        self.log = self.write(\"log.txt\", \"actual synthetic output\")\n        self.result = dict(status=\"pass\", exit_code=0, execution_id=\"run-1\", argv=[\"synthetic-check\"], cwd=\"/synthetic\", started_utc=\"start\", finished_utc=\"end\", required_ids=[\"N01\"], log=self.log, candidate=self.ref)\n        raw=dict(schema=\"airs-v2/run/1\",status=\"passed\",failure=None,inputs_before={\"source\":\"current\"},inputs_after={\"source\":\"current\"},commands=[dict(label=\"check\",argv=[\"synthetic-check\"],cwd=\"/synthetic\",status=\"passed\",exit_code=0,note=None,output_sha256=self.log[\"sha256\"],log=\"log.txt\",tests=dict(passed=1,failed=0))])\n        self.result[\"raw\"]=self.write(\"raw.json\",raw)\n        self.result_ref = self.write(\"result.json\", self.result)\n        self.plan = dict(schema=\"airs-desktop/required-coverage/1\", requirements=[dict(id=\"N01\",kind=\"command\",label=\"check\",argv=[\"synthetic-check\"],expects_tests=True, affected=True, must_execute=False, dependencies=[\"native\"] )])\n        self.record = dict(schema=\"airs-desktop/qualified-coverage/1\", source_inventory_sha256=\"current\", candidate=self.ref, plan=self.write(\"plan.json\", self.plan), coverage=[dict(id=\"N01\", disposition=\"executed\", result=self.result_ref)])\n\n    def write(self, name, value):\n        path = self.root/name\n        path.write_text(json.dumps(value) if not isinstance(value, str) else value)\n        return dict(path=name, sha256=sha(path))\n\n    def test_current_execution_and_phase_exact_reuse(self):\n        self.assertTrue(verify(self.root, self.record)[\"qualified\"])\n        # A phase consumes the actual chunk execution without executing it again.\n        self.record[\"coverage\"][0][\"disposition\"] = \"reused_exact\"\n        self.assertEqual(verify(self.root, self.record)[\"dispositions\"], {\"reused_exact\": 1})\n\n    def test_test_only_source_change_allows_exact_artifact_reuse(self):\n        new = dict(self.candidate, source_inventory_sha256=\"test-only-new\")\n        self.record.update(candidate=self.write(\"new-candidate.json\", new), source_inventory_sha256=\"test-only-new\")\n        self.record[\"coverage\"][0][\"disposition\"] = \"reused_exact\"\n        self.assertTrue(verify(self.root, self.record)[\"qualified\"])\n        self.record[\"coverage\"][0][\"disposition\"] = \"executed\"\n        with self.assertRaisesRegex(ValueError, \"historical\"):\n            verify(self.root, self.record)\n\n    def test_every_exact_boundary_mismatch_rejected(self):\n        for field in [\"executable_sha256\", \"bundle_sha256\", \"helper_closure\", \"build_flags\", \"conditions\"]:\n            with self.subTest(field=field):\n                record=copy.deepcopy(self.record)\n                candidate=dict(self.candidate); candidate[field]=\"different\"\n                record[\"candidate\"]=self.write(\"different.json\", candidate)\n                record[\"coverage\"][0][\"disposition\"]=\"reused_exact\"\n                with self.assertRaisesRegex(ValueError, \"differ\"):verify(self.root,record)\n\n    def test_forged_coverage_claim_cannot_replace_raw_failure(self):\n        raw=json.loads((self.root/\"raw.json\").read_text());raw[\"commands\"][0][\"exit_code\"]=1\n        result=dict(self.result,raw=self.write(\"raw-fail.json\",raw))\n        self.record[\"coverage\"][0][\"result\"]=self.write(\"forged-pass.json\",result)\n        with self.assertRaisesRegex(ValueError,\"raw runner\"):verify(self.root,self.record)\n\n    def test_native_claim_requires_actual_passing_bound_assertion(self):\n        self.plan[\"requirements\"][0].update(kind=\"native\",argv=[\"native-driver\"])\n        self.record[\"plan\"]=self.write(\"plan.json\",self.plan)\n        evidence=self.write(\"capture.json\",{\"observed\":\"native synthetic fixture\"})\n        raw=dict(schema=\"airs-v2/native-acceptance/1\",app={\"executable_sha256\":\"exe\"},checks=[dict(id=\"N01\",result=\"pass\",observation=\"observed\",evidence=[evidence[\"path\"]])])\n        execution=dict(self.result,argv=[\"native-driver\"],raw=self.write(\"native.json\",raw),evidence={evidence[\"path\"]:evidence[\"sha256\"]})\n        self.record[\"coverage\"][0][\"result\"]=self.write(\"native-execution.json\",execution)\n        self.assertTrue(verify(self.root,self.record)[\"qualified\"])\n        raw[\"checks\"][0][\"result\"]=\"fail\";execution[\"raw\"]=self.write(\"native-failed.json\",raw)\n        self.record[\"coverage\"][0][\"result\"]=self.write(\"native-execution-false.json\",execution)\n        with self.assertRaisesRegex(ValueError,\"raw native assertion\"):verify(self.root,self.record)\n\n    def test_unapproved_command_rejected(self):\n        result=dict(self.result,argv=[\"different\"])\n        self.record[\"coverage\"][0][\"result\"]=self.write(\"other.json\",result)\n        with self.assertRaisesRegex(ValueError,\"approved plan\"):verify(self.root,self.record)\n\n    def test_missing_duplicate_unknown_ids_rejected(self):\n        for rows in [[], self.record[\"coverage\"]*2, [dict(id=\"unknown\", disposition=\"executed\")]]:\n            with self.subTest(rows=rows):\n                with self.assertRaisesRegex(ValueError,\"coverage\"):verify(self.root,dict(self.record,coverage=rows))\n\n    def test_failed_and_edited_execution_rejected(self):\n        result=dict(self.result,status=\"fail\",exit_code=1)\n        self.record[\"coverage\"][0][\"result\"]=self.write(\"failed.json\",result)\n        with self.assertRaisesRegex(ValueError,\"passing\"):verify(self.root,self.record)\n        self.record[\"coverage\"][0][\"result\"]=self.result_ref\n        (self.root/\"log.txt\").write_text(\"edited\")\n        with self.assertRaisesRegex(ValueError,\"hash drift\"):verify(self.root,self.record)\n\n    def test_unsupported_retirement_rejected(self):\n        self.record[\"coverage\"]=[dict(id=\"N01\",disposition=\"not_applicable\",reason=\"convenient\")]\n        with self.assertRaisesRegex(ValueError,\"retirement\"):verify(self.root,self.record)\n\n    def test_changed_test_or_lint_target_must_execute(self):\n        self.plan[\"requirements\"][0][\"must_execute\"]=True\n        self.record[\"plan\"]=self.write(\"plan.json\",self.plan)\n        self.record[\"coverage\"][0][\"disposition\"]=\"reused_exact\"\n        with self.assertRaisesRegex(ValueError,\"must execute\"):verify(self.root,self.record)\n\n    def test_unrelated_helper_edit_does_not_invalidate_driver(self):\n        self.plan[\"requirements\"][0][\"helper_paths\"]=[\"driver\"]\n        self.record[\"plan\"]=self.write(\"plan.json\",self.plan)\n        current=dict(self.candidate,helper_closure={\"driver\":\"hash\",\"unrelated\":\"new\"})\n        self.record[\"candidate\"]=self.write(\"current.json\",current)\n        self.record[\"coverage\"][0][\"disposition\"]=\"reused_exact\"\n        self.assertTrue(verify(self.root,self.record)[\"qualified\"])\n\n    def test_affected_target_cannot_be_carried(self):\n        self.record[\"coverage\"][0][\"disposition\"]=\"carried_unaffected\"\n        with self.assertRaisesRegex(ValueError,\"affected\"):verify(self.root,self.record)\n\n    def test_unaffected_historical_result_preserves_original_binding(self):\n        self.plan[\"requirements\"][0][\"affected\"]=False\n        dependency=self.write(\"native\", \"unchanged native dependency\")\n        self.record[\"plan\"]=self.write(\"plan.json\",self.plan)\n        self.record[\"coverage\"][0].update(disposition=\"carried_unaffected\",impact=dict(reason=\"exact native dependency closure unchanged\",dependencies=[\"native\"],original_candidate_sha256=self.ref[\"sha256\"],proof=self.write(\"impact.json\",dict(unchanged_dependencies=[\"native\"],current_source_inventory_sha256=\"current\",original_candidate_sha256=self.ref[\"sha256\"],file_bindings={\"native\":dict(original_sha256=dependency[\"sha256\"],current_sha256=dependency[\"sha256\"],original_file=dependency)}))))\n        self.assertTrue(verify(self.root,self.record)[\"qualified\"])\n        self.record[\"coverage\"][0][\"impact\"][\"dependencies\"]=[\"unrelated\"]\n        with self.assertRaisesRegex(ValueError,\"impact\"):verify(self.root,self.record)\n\n\nif __name__ == \"__main__\":unittest.main()\n\"\"\"Synthetic exact-artifact/source-delta proof tests, no app or UI execution.\"\"\"\nfrom pathlib import Path\nimport copy,json,platform,tempfile,unittest\nfrom unittest.mock import patch\nfrom candidate import verify_build_reuse,bundle_hash,digest\nfrom qualification import sha\n\n\nclass BuildReuseTests(unittest.TestCase):\n    def setUp(self):\n        self.temp=tempfile.TemporaryDirectory();self.addCleanup(self.temp.cleanup);self.root=Path(self.temp.name)\n        executable=self.root/'fixture.app/Contents/MacOS/prisma-airs-desktop';executable.parent.mkdir(parents=True);executable.write_text('same actual synthetic executable')\n        self.bundle=executable.parents[2]\n        self.before={'apps/source.rs':{'sha256':'unchanged'},'tools/native-acceptance/acceptance_c45.py':{'sha256':'old-selector'}}\n        self.after=copy.deepcopy(self.before);self.after['tools/native-acceptance/acceptance_c45.py']['sha256']='corrected-selector'\n        prepared=dict(bundle='fixture.app',executable_sha256=sha(executable),bundle_sha256=bundle_hash(self.bundle))\n        self.prepared=self.write('prepared.json',prepared)\n        self.original=dict(source_inventory_sha256=digest(self.before),runner_inputs=dict(dependencies='deps',build_flags='flags'),conditions=dict(platform='VM',hostname='worf'),prepare=self.prepared,executable_sha256=prepared['executable_sha256'],bundle_sha256=prepared['bundle_sha256'])\n        self.current=dict(source='new-source',dependencies='deps',build_flags='flags')\n        stage=self.root/'old-stage';stage.mkdir();(stage/'stdout.log').write_text('actual synthetic build output');(stage/'stderr.log').write_text('')\n        state=dict(exit_code=0,argv=['actual-build'],source_fingerprint=digest(self.before),stdout_sha256=sha(stage/'stdout.log'),stderr_sha256=sha(stage/'stderr.log'),artifacts={'prepared.json':self.prepared['sha256']})\n        self.record=dict(schema='airs-desktop/c45-helper-only-build-reuse/1',original_candidate=self.write('old-candidate.json',self.original),original_source=self.write('before.json',{'files':self.before}),current_source=self.write('after.json',{'files':self.after}),original_build_stage=self.write('old-stage/completed.json',state),declared_changed_paths=['tools/native-acceptance/acceptance_c45.py'])\n\n    def write(self,name,value):\n        p=self.root/name;p.parent.mkdir(parents=True,exist_ok=True);p.write_text(json.dumps(value));return dict(path=name,sha256=sha(p))\n\n    def verify(self):\n        with patch('candidate.source_inventory',return_value=self.after):return verify_build_reuse(self.root,self.record,self.current,'VM','worf')\n\n    def test_same_app_full_bundle_and_declared_helper_delta_reuses_actual_build(self):\n        result=self.verify();self.assertFalse(result['new_build_executed']);self.assertEqual(result['executable_sha256'],self.original['executable_sha256'])\n\n    def test_application_source_change_cannot_be_declared_helper_only(self):\n        self.after['apps/source.rs']['sha256']='changed';self.record['current_source']=self.write('after.json',{'files':self.after});self.record['declared_changed_paths'].append('apps/source.rs');self.record['declared_changed_paths'].sort()\n        with self.assertRaisesRegex(ValueError,'application-affecting'):self.verify()\n\n    def test_complete_bundle_change_rejects_reuse_even_when_executable_same(self):\n        (self.bundle/'new-resource').write_text('changed resource')\n        with self.assertRaisesRegex(ValueError,'complete bundle'):self.verify()\n\n    def test_dependencies_and_execution_conditions_must_match(self):\n        self.current['dependencies']='changed'\n        with self.assertRaisesRegex(ValueError,'dependency/toolchain'):self.verify()\n        self.current['dependencies']='deps';self.original['conditions']['hostname']='other';self.record['original_candidate']=self.write('old-candidate.json',self.original)\n        with self.assertRaisesRegex(ValueError,'conditions'):self.verify()\n\n    def test_original_build_logs_cannot_be_edited_and_rebound(self):\n        (self.root/'old-stage/stdout.log').write_text('edited')\n        with self.assertRaisesRegex(ValueError,'log drift'):self.verify()\n\n\nif __name__=='__main__':unittest.main()\n\"\"\"Synthetic source/stage scope tests; no application or UI execution.\"\"\"\nfrom pathlib import Path\nimport copy,json,tempfile,unittest\nfrom unittest.mock import patch\nfrom qualification import sha\nfrom candidate import digest\nimport continuation\n\n\nclass ContinuationTests(unittest.TestCase):\n    def setUp(self):\n        self.temp=tempfile.TemporaryDirectory();self.addCleanup(self.temp.cleanup);self.root=Path(self.temp.name);self.base=self.root/'baseline';self.folder=self.base/'continuation-01';self.folder.mkdir(parents=True)\n        name='apps/desktop/src-tauri/tests/permission_manifest.rs';source=self.root/name;source.parent.mkdir(parents=True);source.write_text('current synthetic identity assertions')\n        self.before={name:{'sha256':'old'},'apps/desktop/src-tauri/src/lib.rs':{'sha256':'unchanged'}};self.after=copy.deepcopy(self.before);self.after[name]['sha256']='new'\n        self.write(self.base/'source-seal.json',{'files':self.before});self.write(self.folder/'source-seal.json',{'files':self.after});self.write(self.base/'candidate.json',{'source_inventory_sha256':digest(self.before)})\n        log=self.folder/'focused.log';log.write_text('actual synthetic test result')\n        self.marker=dict(schema='airs-desktop/c45-test-only-continuation/1',affected_stage='command-C45-host-2',source_seal_sha256=sha(self.folder/'source-seal.json'),original_candidate_sha256=sha(self.base/'candidate.json'),declared_changed_paths=[name],retained_completed_stages=[],focused_checks=[dict(log=str(log.relative_to(self.root)),log_sha256=sha(log),exit_code=0,source_sha256=sha(source))])\n        self.write(self.base/'continuation-01.json',self.marker)\n\n    def write(self,path,value):path.write_text(json.dumps(value))\n    def verify(self):\n        with patch('continuation.source_inventory',return_value=self.after):return continuation.verify(self.root,self.base)\n\n    def test_test_only_source_delta_and_affected_target_are_explicit(self):self.assertEqual(self.verify()['affected_stage'],'command-C45-host-2')\n\n    def test_application_source_cannot_change_under_test_only_acceptance(self):\n        name='apps/desktop/src-tauri/src/lib.rs';self.after[name]['sha256']='changed';self.write(self.folder/'source-seal.json',{'files':self.after});self.marker.update(source_seal_sha256=sha(self.folder/'source-seal.json'),declared_changed_paths=sorted(self.after));self.write(self.base/'continuation-01.json',self.marker)\n        with self.assertRaisesRegex(ValueError,'application source'):self.verify()\n\n    def test_failed_affected_stage_cannot_be_retained(self):\n        self.marker['retained_completed_stages']=['command-C45-host-2'];self.write(self.base/'continuation-01.json',self.marker)\n        with self.assertRaisesRegex(ValueError,'failed/affected'):self.verify()\n\n    def test_focused_test_proof_cannot_drift(self):\n        (self.folder/'focused.log').write_text('edited')\n        with self.assertRaisesRegex(ValueError,'focused check'):self.verify()\n\n\n\n\nclass NativeContinuationTests(unittest.TestCase):\n    def setUp(self):\n        self.temp=tempfile.TemporaryDirectory();self.addCleanup(self.temp.cleanup);self.root=Path(self.temp.name);self.base=self.root/'baseline';self.folder=self.base/'continuation-02';self.folder.mkdir(parents=True)\n        self.driver='tools/native-acceptance/acceptance_c36.py';self.changed='tools/native-acceptance/acceptance_c32_current.py'\n        for name,text in [(self.driver,'unchanged native assertions'),(self.changed,'canonical project path')]:\n            p=self.root/name;p.parent.mkdir(parents=True,exist_ok=True);p.write_text(text)\n        self.before={self.driver:{'sha256':sha(self.root/self.driver)},self.changed:{'sha256':'old-alias'}};self.after=copy.deepcopy(self.before);self.after[self.changed]['sha256']=sha(self.root/self.changed)\n        def write(name,value):\n            p=self.root/name;p.parent.mkdir(parents=True,exist_ok=True);p.write_text(json.dumps(value));return dict(path=name,sha256=sha(p))\n        self.write=write;before_ref=write('before.json',{'files':self.before});write('baseline/continuation-02/source-seal.json',{'files':self.after})\n        candidate=write('origin-candidate.json',dict(source_inventory_sha256=digest(self.before),helper_closure={self.driver:sha(self.root/self.driver)}))\n        stage=self.root/'old-native-stage';stage.mkdir()\n        for name in ['stdout.log','stderr.log','raw.json']:(stage/name).write_text('actual synthetic native output')\n        state=dict(exit_code=0,argv=['driver'],source_fingerprint=digest(self.before),candidate_sha256=candidate['sha256'],stdout_sha256=sha(stage/'stdout.log'),stderr_sha256=sha(stage/'stderr.log'),artifacts={'old-native-stage/raw.json':sha(stage/'raw.json')})\n        completed=write('old-native-stage/completed.json',state);log=self.folder/'focused.log';log.write_text('Ran 2 tests\\nOK\\n')\n        self.marker=dict(schema='airs-desktop/c45-native-helper-continuation/1',affected_stage='native-c32',source_before=before_ref,source_seal_sha256=sha(self.folder/'source-seal.json'),declared_changed_paths=[self.changed],retained_records={'native-c36':dict(folder='old-native-stage',completed=completed,candidate=candidate,source=before_ref,disposition='carried_unaffected',dependencies=[self.driver])},focused_check=dict(exit_code=0,log=str(log.relative_to(self.root)),log_sha256=sha(log),source_sha256=sha(self.root/self.changed)))\n        write('baseline/continuation-02.json',self.marker)\n\n    def verify(self):\n        with patch('continuation.source_inventory',return_value=self.after):return continuation.verify(self.root,self.base)\n\n    def test_unchanged_native_driver_retains_original_source_and_result(self):self.assertEqual(self.verify()['retained_records']['native-c36']['disposition'],'carried_unaffected')\n\n    def test_changed_runtime_helper_cannot_be_carried_unaffected(self):\n        (self.root/self.driver).write_text('changed native assertions')\n        with self.assertRaisesRegex(ValueError,'assertion/helper changed'):self.verify()\n\n    def test_failed_c32_cannot_be_retained(self):\n        self.marker['retained_records']['native-c32']=self.marker['retained_records'].pop('native-c36');self.write('baseline/continuation-02.json',self.marker)\n        with self.assertRaisesRegex(ValueError,'failed native driver'):self.verify()\n\n\nclass FrameContinuationTests(NativeContinuationTests):\n    def setUp(self):\n        super().setUp()\n        old=self.folder;self.folder=self.base/'continuation-04';old.rename(self.folder)\n        old_source=self.root/self.changed\n        self.changed='tools/native-acceptance/acceptance_c04.py'\n        target=self.root/self.changed;target.write_text('current frame containment')\n        previous=self.before.pop('tools/native-acceptance/acceptance_c32_current.py')\n        self.before[self.changed]=previous\n        self.after=copy.deepcopy(self.before);self.after[self.changed]['sha256']=sha(target)\n        self.write('before.json',{'files':self.before})\n        self.marker['source_before']['sha256']=sha(self.root/'before.json')\n        self.write('baseline/continuation-04/source-seal.json',{'files':self.after})\n        self.marker.update(affected_stage='native-c04',declared_changed_paths=[self.changed],source_seal_sha256=sha(self.folder/'source-seal.json'))\n        self.marker['focused_check'].update(log='baseline/continuation-04/focused.log',source_path=self.changed,source_sha256=sha(target))\n        # Original retained stage has the original source, independent of current helper.\n        origin=self.root/'origin-candidate.json';value=json.loads(origin.read_text());value['source_inventory_sha256']=digest(self.before);origin.write_text(json.dumps(value))\n        entry=self.marker['retained_records']['native-c36'];entry['candidate']['sha256']=sha(origin)\n        state=self.root/'old-native-stage/completed.json';value=json.loads(state.read_text());value.update(source_fingerprint=digest(self.before),candidate_sha256=sha(origin));state.write_text(json.dumps(value));entry['completed']['sha256']=sha(state)\n        self.write('baseline/continuation-04.json',self.marker)\n\n    def test_failed_c32_cannot_be_retained(self):\n        self.marker['retained_records']['native-c04']=self.marker['retained_records'].pop('native-c36');self.write('baseline/continuation-04.json',self.marker)\n        with self.assertRaisesRegex(ValueError,'failed native driver'):self.verify()\n\n\nclass AdapterInvocationTests(unittest.TestCase):\n    def test_current_plan_matches_actual_retained_g11_without_running_it(self):\n        import seal\n        result=seal.verify_historical_invocations(Path(__file__).resolve().parents[2])\n        self.assertEqual(result['status'],'pass')\n        self.assertIn(('c31',True),result['queue'])\n        self.assertIn(('c39',False),result['queue'])\n\n    def test_omitted_c31_adapter_is_rejected_before_any_driver(self):\n        import seal\n        with patch.object(seal,'LEGACY',seal.LEGACY-{'c31'}):\n            with self.assertRaisesRegex(ValueError,'differs from actual retained G11'):\n                seal.verify_historical_invocations(Path(__file__).resolve().parents[2])\n\n\nif __name__=='__main__':unittest.main()\nfrom pathlib import Path\nimport tempfile\nimport unittest\nfrom unittest.mock import patch\nimport review_gate\n\n\nclass ReleaseProofTests(unittest.TestCase):\n    def test_isolated_release_interpreter_can_load_qualification_siblings(self):\n        import subprocess\n        root=Path(__file__).resolve().parents[2]\n        result=subprocess.run([\"/usr/bin/python3\",\"-I\",\"-c\",\"import runpy;runpy.run_path('tools/p10/review_gate.py');from packet import qualification;assert callable(qualification)\"],cwd=root,capture_output=True,text=True)\n        self.assertEqual(result.returncode,0,result.stderr)\n\n    def test_missing_actual_p10_proof_blocks_release(self):\n        with tempfile.TemporaryDirectory() as directory:\n            root=Path(directory)\n            with patch.object(review_gate,\"actual_review\",return_value={\"subject\":\"P09\"}):\n                with self.assertRaises(FileNotFoundError):review_gate.release_prerequisites(root)\n\n    def test_unbound_member_or_qualification_cannot_complete_release(self):\n        import json\n        with tempfile.TemporaryDirectory() as directory:\n            root=Path(directory);path=root/\"docs/planning/evidence/P10\";path.mkdir(parents=True)\n            proof=dict(schema=\"airs-desktop/p10-completion-proof/1\",p09={\"subject\":\"P09\"},p10={\"subject\":\"P10\"},attempt=\"attempt-01\",source_archive=\"docs/planning/evidence/P10/source-archive\")\n            (path/\"completion-proof.json\").write_text(json.dumps(proof))\n            with patch.object(review_gate,\"actual_review\",side_effect=[proof[\"p09\"],proof[\"p10\"]]):\n                with self.assertRaises(KeyError):review_gate.release_prerequisites(root)\n\n    def test_actual_historical_transport_and_reject_output_mutations(self):\n        import json,shutil\n        root=Path(__file__).resolve().parents[2]\n        original=root/\"docs/planning/reviews/P09/attempt-02\"\n        request=json.loads((original/\"request.json\").read_text())\n        request[\"execution_root\"]=json.loads((root/\"docs/planning/evidence/C45/activation-20261102-g11/p09-proof.json\").read_text())[\"source_checkout\"]\n        request[\"schema_archive\"]=\"docs/planning/evidence/C45/activation-20261102-g11/p09-source/docs/architecture/review-verdict.schema.json\"\n        self.assertTrue(review_gate.transport(root,original,request)[\"reviewer_sessions_observed\"])\n        for flag,wrong in [(\"-o\",\"/wrong/verdict.json\"),(\"--output-schema\",\"/wrong/schema.json\"),(\"-s\",\"workspace-write\")]:\n            with self.subTest(flag=flag),tempfile.TemporaryDirectory() as directory:\n                out=Path(directory)\n                for name in [\"invocation.json\",\"request.json\",\"feature-probe.log\",\"thread-reply.log\",\"verdict-returned.json\"]:shutil.copy2(original/name,out/name)\n                invocation=json.loads((out/\"invocation.json\").read_text());args=invocation[\"command_without_prompt\"];args[args.index(flag)+1]=wrong\n                (out/\"invocation.json\").write_text(json.dumps(invocation))\n                with self.assertRaisesRegex(ValueError,\"transport\"):review_gate.transport(root,out,request)\n\n\nif __name__ == \"__main__\":unittest.main()\nfrom pathlib import Path\nimport tempfile\nimport unittest\nfrom qualification import sha\nfrom stages import verify_completed,verify_conditions\n\n\nclass StageBindingTests(unittest.TestCase):\n    def test_original_logs_raw_records_and_evidence_are_immutable(self):\n        with tempfile.TemporaryDirectory() as directory:\n            root=Path(directory);folder=root/\"stage\";folder.mkdir()\n            for name in [\"stdout.log\",\"stderr.log\",\"raw.json\",\"capture.json\"]:(folder/name).write_text(\"actual synthetic stage output\")\n            state=dict(exit_code=0,argv=[\"driver\"],source_fingerprint=\"source\",candidate_sha256=\"candidate\",stdout_sha256=sha(folder/\"stdout.log\"),stderr_sha256=sha(folder/\"stderr.log\"),artifacts={\"stage/raw.json\":sha(folder/\"raw.json\"),\"stage/capture.json\":sha(folder/\"capture.json\")})\n            self.assertTrue(verify_completed(root,folder,state,[\"driver\"],\"source\",\"candidate\"))\n            for name in [\"stdout.log\",\"stderr.log\",\"raw.json\",\"capture.json\"]:\n                with self.subTest(name=name):\n                    path=folder/name;before=path.read_text();path.write_text(\"edited\")\n                    with self.assertRaisesRegex(ValueError,\"drift\"):verify_completed(root,folder,state,[\"driver\"],\"source\",\"candidate\")\n                    path.write_text(before)\n            with self.assertRaisesRegex(ValueError,\"command/source\"):verify_completed(root,folder,state,[\"other-driver\"],\"source\",\"candidate\")\n\n    def test_superseded_raw_failure_missing_evidence_is_retained_as_missing(self):\n        with tempfile.TemporaryDirectory() as directory:\n            root=Path(directory);folder=root/\"stage\";folder.mkdir()\n            for name in [\"stdout.log\",\"stderr.log\"]:(folder/name).write_text(\"actual synthetic output\")\n            state=dict(exit_code=0,argv=[\"driver\"],source_fingerprint=\"s\",stdout_sha256=sha(folder/\"stdout.log\"),stderr_sha256=sha(folder/\"stderr.log\"),artifacts={\"superseded-missing.json\":None})\n            self.assertTrue(verify_completed(root,folder,state,[\"driver\"],\"s\"))\n            (root/\"superseded-missing.json\").write_text(\"invented evidence\")\n            with self.assertRaisesRegex(ValueError,\"missing superseded\"):verify_completed(root,folder,state,[\"driver\"],\"s\")\n\n    def test_recovery_checks_toolchain_dependencies_flags_and_machine(self):\n        current=dict(source=\"s\",dependencies=\"d\",build_flags=\"b\")\n        candidate=dict(runner_inputs=current,conditions=dict(platform=\"VM-macOS\",hostname=\"worf-vm\"))\n        self.assertTrue(verify_conditions(candidate,current,\"VM-macOS\",\"worf-vm\"))\n        for field in current:\n            changed=dict(current);changed[field]=\"changed\"\n            with self.assertRaisesRegex(ValueError,\"identity changed\"):verify_conditions(candidate,changed,\"VM-macOS\",\"worf-vm\")\n        for platform,host in [(\"different\",\"worf-vm\"),(\"VM-macOS\",\"another-host\")]:\n            with self.assertRaisesRegex(ValueError,\"conditions changed\"):verify_conditions(candidate,current,platform,host)\n\n\nif __name__=='__main__':unittest.main()\n\"\"\"Synthetic process-table tests: never launch or signal an OS process.\"\"\"\nimport json,plistlib,signal,sys,tempfile,unittest\nfrom pathlib import Path\nsys.path.insert(0,str(Path(__file__).resolve().parent))\nfrom candidate_process import Candidate,Identity,FIXTURE_ID,EXECUTABLE\nclass Processes:\n    def __init__(self):self.rows={};self.signals=[]\n    def snapshot(self,pid):return self.rows.get(pid)\n    def pids(self):return list(self.rows)\n    def send(self,pid,sig):self.signals.append((pid,sig))\nclass Ownership(unittest.TestCase):\n    def setUp(self):\n        self.temp=tempfile.TemporaryDirectory();self.root=Path(self.temp.name)/'Prisma AIRS Desktop Fixture.app'\n        p=self.root/'Contents/MacOS';p.mkdir(parents=True);(p/EXECUTABLE).write_text('synthetic executable')\n        (self.root/'Contents/Info.plist').write_bytes(plistlib.dumps({'CFBundleIdentifier':FIXTURE_ID,'CFBundleExecutable':EXECUTABLE}))\n        self.processes=Processes();self.candidate=Candidate(self.root,self.processes)\n    def tearDown(self):self.temp.cleanup()\n    def owned(self):\n        row=Identity(10,self.candidate.app_path,(123,456),1);self.processes.rows[10]=row;self.candidate.adopt_child(10,1);return row\n    def test_owned_exact_child_can_be_signaled(self):\n        self.owned();self.candidate.signal_app();self.assertEqual(self.processes.signals,[(10,signal.SIGTERM)])\n    def test_foreign_same_basename_old_namespace_and_regex_lookalike_are_not_signaled(self):\n        for path in ['/foreign/Prisma AIRS Desktop Fixture.app/Contents/MacOS/'+EXECUTABLE,'/old/Prisma AIRS Desktop v2 Fixture.app/Contents/MacOS/prisma-airs-desktop-v2',self.candidate.app_path.replace('Fixture.app','FixtureXapp')]:\n            self.processes.rows={11:Identity(11,path,(1,1),1)};self.candidate.signal_app()\n        self.assertEqual(self.processes.signals,[])\n    def test_unowned_same_candidate_is_not_adopted(self):\n        self.processes.rows[10]=Identity(10,self.candidate.app_path,(1,1),99)\n        with self.assertRaises(RuntimeError):self.candidate.app_pid()\n        self.assertEqual(self.processes.signals,[])\n    def test_reused_pid_cannot_be_signaled_even_with_same_path(self):\n        old=self.owned();self.processes.rows[10]=Identity(10,old.executable,(124,1),old.parent)\n        self.assertFalse(self.candidate.signal_identity(old,signal.SIGKILL));self.assertEqual(self.processes.signals,[])\n    def test_duplicate_candidate_processes_refuse_ui_and_cleanup(self):\n        self.owned();self.processes.rows[11]=Identity(11,self.candidate.app_path,(1,1),1)\n        with self.assertRaises(RuntimeError):self.candidate.app_pid()\n        self.assertEqual(self.processes.signals,[])\n    def test_engine_must_be_exact_owned_descendant(self):\n        self.owned();self.processes.rows.update({20:Identity(20,self.candidate.engine_path,(2,2),10),21:Identity(21,'/foreign/airs-harness',(2,3),10),22:Identity(22,self.candidate.engine_path,(2,4),99)})\n        self.assertEqual(self.candidate.engines(),[20]);self.candidate.stop_engines();self.assertEqual(self.processes.signals,[(20,signal.SIGKILL)])\n    def test_observed_engine_cleanup_survives_parent_exit_but_not_pid_reuse(self):\n        self.owned();engine=Identity(20,self.candidate.engine_path,(2,2),10);self.processes.rows[20]=engine;self.candidate.engines();del self.processes.rows[10];self.processes.rows[20]=Identity(20,engine.executable,engine.birth,1)\n        self.assertTrue(self.candidate.signal_engine(20));self.processes.rows[20]=Identity(20,engine.executable,(3,3),10)\n        self.assertFalse(self.candidate.signal_engine(20));self.assertEqual(self.processes.signals,[(20,signal.SIGKILL)])\n    def test_symlinked_engine_cannot_escape_the_bundle(self):\n        external=Path(self.temp.name)/'foreign-engine';external.write_text('foreign')\n        engine=self.root/'Contents/Resources/harness/airs-harness';engine.parent.mkdir(parents=True);engine.symlink_to(external)\n        with self.assertRaises(ValueError):Candidate(self.root,self.processes)\n        self.assertEqual(self.processes.signals,[])\n    def test_production_or_missing_bundle_is_rejected(self):\n        p=self.root/'Contents/Info.plist';p.write_bytes(plistlib.dumps({'CFBundleIdentifier':'io.cdot.airs-desktop','CFBundleExecutable':EXECUTABLE}))\n        with self.assertRaises(ValueError):Candidate(self.root,self.processes)\n        with self.assertRaises(FileNotFoundError):Candidate(self.root/'missing',self.processes)\nif __name__=='__main__':unittest.main()\n\"\"\"No UI, keychain or real user-data operations: isolated helper boundary tests.\"\"\"\nfrom pathlib import Path\nimport os\nimport tempfile\nimport unittest\nfrom unittest.mock import patch\nimport fixture_app as fx\n\n\nclass FixtureSafetyTests(unittest.TestCase):\n    def test_rejects_old_or_foreign_root_before_any_cleanup(self):\n        with patch.object(fx,\"DATA\",\"/synthetic/old-v2\"), patch.object(fx,\"sh\") as run, patch.object(fx.shutil,\"rmtree\") as remove:\n            with self.assertRaisesRegex(RuntimeError,\"exact new fixture root\"):fx.clean_fixture_root()\n            run.assert_not_called();remove.assert_not_called()\n\n    def test_symlinked_root_and_keychain_cannot_escape(self):\n        with tempfile.TemporaryDirectory() as tmp:\n            home=Path(tmp).resolve();expected=home/\"Library/Application Support/io.cdot.airs-desktop.fixture\";expected.parent.mkdir(parents=True)\n            other=home/\"foreign\";other.mkdir();expected.symlink_to(other,target_is_directory=True)\n            with patch.object(fx.os.path,\"expanduser\",return_value=str(home)),patch.object(fx,\"DATA\",str(expected)),patch.object(fx,\"KEYCHAIN\",str(expected/\"fixture-credentials.keychain-db\")),patch.object(fx,\"sh\") as run:\n                with self.assertRaisesRegex(RuntimeError,\"exact new fixture root\"):fx.clean_fixture_root()\n                run.assert_not_called()\n            expected.unlink();expected.mkdir();(expected/\"fixture-credentials.keychain-db\").symlink_to(other/\"secret\")\n            with patch.object(fx.os.path,\"expanduser\",return_value=str(home)),patch.object(fx,\"DATA\",str(expected)),patch.object(fx,\"KEYCHAIN\",str(expected/\"fixture-credentials.keychain-db\")),patch.object(fx,\"sh\") as run:\n                with self.assertRaisesRegex(RuntimeError,\"symlinked\"):fx.clean_fixture_root()\n                run.assert_not_called()\n\n    def test_canary_digest_detects_same_size_same_timestamp_mutation(self):\n        with tempfile.TemporaryDirectory() as tmp,patch.object(fx,\"V1_DATA\",tmp):\n            p=Path(tmp)/\"old-state\";p.write_text(\"before\");stamp=p.stat().st_mtime_ns;before=fx.v1_metadata()\n            p.write_text(\"after!\");os.utime(p,ns=(stamp,stamp));after=fx.v1_metadata()\n            self.assertEqual(before[0][:3],after[0][:3]);self.assertNotEqual(before[0][3],after[0][3])\n\n    def test_process_name_signaling_rejected_before_subprocess(self):\n        with patch.object(fx.subprocess,\"run\") as run:\n            for command in [[\"pkill\",\"app\"],[\"/usr/bin/killall\",\"app\"]]:\n                with self.assertRaisesRegex(RuntimeError,\"forbidden\"):fx.sh(command)\n            run.assert_not_called()\n\n\nif __name__ == \"__main__\":unittest.main()\n\"\"\"Actual-frame containment, including retained failure geometry and negatives.\"\"\"\nimport unittest\nfrom acceptance_c04 import current_frame_clear\n\nclass CurrentFrameTests(unittest.TestCase):\n    def setUp(self):\n        self.window=dict(pos=[320,95],size=[900,600]);self.viewport=dict(pos=[320,123],size=[900,572]);self.control=dict(pos=[449,651],size=[113,44])\n    def test_actual_retained_minimum_geometry_is_visible_without_a_nonexistent_fade(self):\n        self.assertGreater(self.control['pos'][1]+self.control['size'][1],self.window['pos'][1]+self.window['size'][1]-60)\n        self.assertTrue(current_frame_clear(self.control,self.window,self.viewport))\n    def test_below_window_control_is_rejected(self):\n        self.control['pos'][1]+=5;self.assertFalse(current_frame_clear(self.control,self.window,self.viewport))\n    def test_horizontal_clipping_is_rejected(self):\n        self.control['pos'][0]=1200;self.assertFalse(current_frame_clear(self.control,self.window,self.viewport))\n    def test_viewport_clipping_is_rejected_even_inside_window(self):\n        self.viewport['size'][1]-=20;self.assertFalse(current_frame_clear(self.control,self.window,self.viewport))\n    def test_missing_focused_control_or_webview_cannot_pass(self):\n        self.assertFalse(current_frame_clear(None,self.window,self.viewport));self.assertFalse(current_frame_clear(self.control,self.window,None))\n\nif __name__=='__main__':unittest.main()\n\"\"\"Controlled filesystem regression for the isolated-worktree path alias.\"\"\"\nimport os\nfrom pathlib import Path\nimport tempfile\nimport unittest\nfrom unittest.mock import patch\nwith patch.dict(os.environ,{\"AIRS_C32_EVIDENCE\":\"synthetic-no-UI\"}):\n    from acceptance_c32_current import native_project_root\n\n\nclass ProjectPathTests(unittest.TestCase):\n    def test_symlinked_target_matches_the_native_canonical_selected_folder(self):\n        with tempfile.TemporaryDirectory() as directory:\n            root=Path(directory).resolve();physical=root/\"shared-target\";physical.mkdir();work=root/\"isolated-worktree\";work.mkdir();(work/\"target\").symlink_to(physical,target_is_directory=True)\n            old_alias=work/\"target/native-c32-000000000001/agent-demo\"\n            expected=physical/\"native-c32-000000000001/agent-demo\"\n            current=Path(native_project_root(str(work),\"000000000001\"))/\"agent-demo\";current.mkdir(parents=True)\n            self.assertNotEqual(str(old_alias),str(expected),\"old exact text assertion did not handle the path alias\")\n            self.assertEqual(current,expected)\n            self.assertTrue(os.path.samefile(old_alias,current),\"same selected owned folder, no assertion retirement\")\n\n    def test_regular_target_also_uses_its_exact_owned_folder(self):\n        with tempfile.TemporaryDirectory() as directory:\n            root=Path(directory).resolve();(root/\"target\").mkdir()\n            self.assertEqual(native_project_root(str(root),\"000000000002\"),str(root/\"target/native-c32-000000000002\"))\n\n\nif __name__=='__main__':unittest.main()\n","exit_code":0,"status":"completed"}}
