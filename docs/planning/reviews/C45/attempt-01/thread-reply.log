mpleted,focused_checks=focused,reason='Real Host failure was a test still enforcing retired v2 IDs. Strengthened current1.0 names/version/old-ID exclusion; no application/config/dependency or native driver/helper behavior changed. Preserve actual failed Host record and all13 successful commands/current smoke. Execute affected Host aggregate and first remaining checks/native queue; no rebuild or unrelated repeat.')\n    (base/'continuation-01.json').write_text(json.dumps(marker,indent=2)+'\\n')\n    verify(root,base);return marker\n\n\n\nNATIVE_ALLOWED={\n 'tools/native-acceptance/acceptance_c32_current.py',\n 'tools/native-acceptance/test_c32_project_path.py',\n 'tools/p10/candidate.py','tools/p10/continuation.py',\n 'tools/p10/finalize.py','tools/p10/test_continuation.py',\n}\nFRAME_ALLOWED={'tools/native-acceptance/acceptance_c04.py','tools/native-acceptance/test_c04_current_frame.py','tools/p10/candidate.py','tools/p10/continuation.py','tools/p10/test_continuation.py'}\nMETA_ONLY={'tools/p10/candidate.py'}\n\n\ndef verify_native_continuation(root,base):\n    from qualification import bound\n    frame=(base/'continuation-04.json').exists()\n    adapter=(base/'continuation-03.json').exists() and not frame\n    marker=read(base/('continuation-04.json' if frame else 'continuation-03.json' if adapter else 'continuation-02.json'));layout=paths(base)\n    affected='native-c04' if frame else 'native-c31' if adapter else 'native-c32'\n    allowed=FRAME_ALLOWED if frame else {'tools/p10/seal.py','tools/p10/continuation.py','tools/p10/test_continuation.py'} if adapter else NATIVE_ALLOWED\n    require(marker['schema']=='airs-desktop/c45-native-helper-continuation/1' and marker['affected_stage']==affected,'native continuation schema/scope')\n    before=read(bound(root,marker['source_before']))['files'];after=read(layout['source'])['files']\n    require(sha(layout['source'])==marker['source_seal_sha256'],'native continuation seal drift')\n    changed=sorted(n for n in set(before)|set(after) if before.get(n)!=after.get(n))\n    require(changed==marker['declared_changed_paths'] and set(changed)<=allowed,'undeclared/application native continuation delta')\n    require(source_inventory(root)==after,'native continuation current source drift')\n    for stage,entry in marker['retained_records'].items():\n        require(stage!=affected,'failed native driver cannot be retained')\n        origin=read(bound(root,entry['candidate']));prior_source=read(bound(root,entry['source']))['files']\n        require(digest(prior_source)==origin['source_inventory_sha256'],'retained origin source binding')\n        state_path=bound(root,entry['completed']);state=read(state_path)\n        require(state_path.parent==root/entry['folder'],'retained stage folder binding')\n        verify_completed(root,state_path.parent,state,state['argv'],origin['source_inventory_sha256'],entry['candidate']['sha256'])\n        if stage.startswith('native-'):\n            require(entry['disposition']=='carried_unaffected' and entry['dependencies'],'native carry rationale missing')\n            for name in entry['dependencies']:\n                require(name not in META_ONLY and prior_source[name]['sha256']==origin['helper_closure'][name]==sha(root/name),'retained native assertion/helper changed: '+name)\n    focused=marker['focused_check'];require(focused['exit_code']==0 and sha(root/focused['log'])==focused['log_sha256'] and sha(root/focused.get('source_path','tools/native-acceptance/acceptance_c32_current.py'))==focused['source_sha256'],'canonical-path focused check drift')\n    return marker\n\n\ndef prepare_native(root,adapter=False,frame=False):\n    from qualification import bound\n    base=root/'docs/planning/evidence/C45/baseline-03';prior=base/('continuation-03' if frame else 'continuation-02' if adapter else 'continuation-01');folder=base/('continuation-04' if frame else 'continuation-03' if adapter else 'continuation-02')\n    affected='native-c04' if frame else 'native-c