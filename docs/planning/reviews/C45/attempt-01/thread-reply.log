{"type":"item.completed","item":{"id":"item_41","type":"command_execution","command":"/bin/zsh -lc \"rg -n 'fn credential_store|fn learner_store' apps/desktop/src-tauri/src/adapters.rs; sed -n '600,720p' apps/desktop/src-tauri/src/adapters.rs; sed -n '1,200p' apps/desktop/src/app.tsx; cat apps/desktop/src/shell/feature-body.tsx apps/desktop/src/shell/feature-view.tsx\"","aggregated_output":"981:fn learner_store(_root: Option<&Path>) -> Arc<dyn CredentialStore> {\n988:fn learner_store(root: Option<&Path>) -> Arc<dyn CredentialStore> {\n1004:fn learner_store(_root: Option<&Path>) -> Arc<dyn CredentialStore> {\n1009:fn credential_store(_root: Option<&Path>) -> Arc<dyn CredentialStore> {\n1021:fn credential_store(root: Option<&Path>) -> Arc<dyn CredentialStore> {\n1043:fn credential_store(_root: Option<&Path>) -> Arc<dyn CredentialStore> {\n            let window = app.get_webview_window(MAIN_WINDOW)?;\n            app.run_on_main_thread(move || {\n                let chosen = rfd::FileDialog::new()\n                    .set_parent(&window)\n                    .set_title(\"Import test cases\")\n                    .add_filter(\"JSON\", &[\"json\"])\n                    .pick_file();\n                let _ = tx.send(chosen);\n            })\n            .ok()?;\n            let path = rx.await.ok()??;\n            let name = path\n                .file_name()\n                .map(|n| n.to_string_lossy().into_owned())\n                .unwrap_or_default();\n            let read =\n                tokio::task::spawn_blocking(move || read_limited(&path, MAX_CASE_FILE_BYTES))\n                    .await\n                    .ok()?;\n            Some(read.map(|bytes| ImportFile { name, bytes }))\n        })\n    }\n}\n\n/// The native save sheet for report and investigation exports (C11).\n#[cfg(not(feature = \"test-fixtures\"))]\nfn saver<R: Runtime>(app: &AppHandle<R>, _root: Option<&Path>) -> Arc<dyn FileSaver> {\n    Arc::new(NativeSaver { app: app.clone() })\n}\n\n/// The fixture build saves exports into `fixture-exports/` under its data\n/// root without a sheet (never replacing a file), so acceptance can read\n/// exactly what an operator would have saved.\n#[cfg(feature = \"test-fixtures\")]\nfn saver<R: Runtime>(_app: &AppHandle<R>, root: Option<&Path>) -> Arc<dyn FileSaver> {\n    struct FixtureSaver(Option<PathBuf>);\n    impl FileSaver for FixtureSaver {\n        fn save(\n            &self,\n            suggested: String,\n            bytes: Vec<u8>,\n        ) -> BoxFuture<'static, Result<Option<String>, ()>> {\n            let dir = self.0.clone();\n            Box::pin(async move {\n                let dir = dir.ok_or(())?;\n                tokio::task::spawn_blocking(move || {\n                    std::fs::create_dir_all(&dir).map_err(|_| ())?;\n                    write_owner_only(&dir.join(&suggested), &bytes, false)?;\n                    Ok(Some(suggested))\n                })\n                .await\n                .map_err(|_| ())?\n            })\n        }\n    }\n    Arc::new(FixtureSaver(root.map(|r| r.join(\"fixture-exports\"))))\n}\n\n/// Writes `bytes` owner-only: atomically through a temporary file beside the\n/// target, replacing an existing file only when `replace` (the save sheet\n/// already confirmed it).\nfn write_owner_only(path: &Path, bytes: &[u8], replace: bool) -> Result<(), ()> {\n    use std::io::Write;\n    use std::os::unix::fs::OpenOptionsExt;\n    let dir = path.parent().ok_or(())?;\n    let mut suffix = [0u8; 8];\n    getrandom::fill(&mut suffix).map_err(|_| ())?;\n    let temp = dir.join(format!(\".airs-export-{}.tmp\", hex_of(&suffix)));\n    let written = (|| {\n        let mut file = std::fs::OpenOptions::new()\n            .write(true)\n            .create_new(true)\n            .mode(0o600)\n            .open(&temp)?;\n        file.write_all(bytes)?;\n        file.sync_all()\n    })();\n    let placed = written.and_then(|()| {\n        if replace {\n            std::fs::rename(&temp, path)\n        } else {\n            // Never replace: a hard link fails if the target exists.\n            std::fs::hard_link(&temp, path).and_then(|()| std::fs::remove_file(&temp))\n        }\n    });\n    if placed.is_err() {\n        let _ = std::fs::remove_file(&temp);\n    }\n    placed.map_err(|_| ())\n}\n\nfn hex_of(bytes: &[u8]) -> String {\n    bytes.iter().map(|b| format!(\"{b:02x}\")).collect()\n}\n\n#[cfg_attr(feature = \"test-fixtures\", allow(dead_code))]\npub struct NativeSaver<R: Runtime> {\n    app: AppHandle<R>,\n}\n\nimpl<R: Runtime> FileSaver for NativeSaver<R> {\n    fn save(\n        &self,\n        suggested: String,\n        bytes: Vec<u8>,\n    ) -> BoxFuture<'static, Result<Option<String>, ()>> {\n        let app = self.app.clone();\n        Box::pin(async move {\n            let (tx, rx) = tokio::sync::oneshot::channel::<Option<PathBuf>>();\n            let window = app.get_webview_window(MAIN_WINDOW).ok_or(())?;\n            let extension = if suggested.ends_with(\".csv\") {\n                \"csv\"\n            } else {\n                \"json\"\n            };\n            app.run_on_main_thread(move || {\n                let chosen = rfd::FileDialog::new()\n                    .set_parent(&window)\n                    .set_title(\"Export\")\n                    .set_file_name(&suggested)\n                    .add_filter(extension.to_uppercase(), &[extension])\nimport { useCallback, useEffect, useLayoutEffect, useRef, useState } from 'react'\nimport {\n    DeliveryOutcomeUnknown,\n    type DesktopClient,\n    type FeatureId,\n    type Intent,\n    type MenuCommand,\n    type Refusal,\n    type ShellSnapshot,\n    type Theme,\n} from '@prisma-airs/desktop-contracts'\nimport { followAppearance } from './shell/appearance'\nimport { type DispatchOutcome, outcomeMessage } from './modules/tenants/dispatch'\nimport { V2Shell } from './v2/v2-shell'\nimport { Wizard } from './v2/wizard/wizard'\nimport { deliveryContext, useShellStore } from './v2/store'\nimport { SHELL_COPY } from './v2/copy'\nimport { forgetAcademyPresentation } from './modules/academy/presentation-storage'\nimport { SAVE_DOCUMENT_EVENT } from './v2/workbench/request-editor'\n\nexport function App({ client }: { client: DesktopClient }) {\n    const [snapshot, setSnapshot] = useState<ShellSnapshot | null>(null)\n    const snapshotRef = useRef<ShellSnapshot | null>(null)\n    snapshotRef.current = snapshot\n    const [failure, setFailure] = useState<string | null>(null)\n    const [pending, setPending] = useState(false)\n    const [status, setStatus] = useState('')\n\n    const dispatch = useCallback(\n        async (intent: Intent): Promise<DispatchOutcome> => {\n            try {\n                const response = await client.dispatch(intent)\n                return response.outcome === 'refusal'\n                    ? { kind: 'refused', refusal: response.refusal }\n                    : { kind: 'admitted', operation: response.receipt.operation }\n            } catch (error) {\n                return error instanceof DeliveryOutcomeUnknown ? { kind: 'unknown' } : { kind: 'failed' }\n            }\n        },\n        [client]\n    )\n\n    // v2 (C28): navigation is Rust-owned. The native menu, the sidebar and\n    // the palette all dispatch `navigate`; refusals reach the status surface.\n    const v2Navigate = useCallback(\n        async (feature: FeatureId) => {\n            useShellStore.getState().closePalette()\n            const intent: Intent = { kind: 'navigate', feature }\n            const outcome = await dispatch(intent)\n            if (outcome.kind === 'refused') useShellStore.getState().toast(SHELL_COPY.toastRefused('Navigation', outcome.refusal), 'warn')\n            // Unknown delivery is kept inline with Retry; never an expiring toast alone.\n            else if (outcome.kind === 'unknown') useShellStore.getState().addUnconfirmed('Navigation', intent)\n            else if (outcome.kind === 'failed') useShellStore.getState().toast(SHELL_COPY.toastFailed('Navigation'), 'warn')\n        },\n        [dispatch]\n    )\n    // Every v2 action's outcome reaches the shell's surfaces (DESIGN-V2 §7):\n    // a refusal or failed delivery as a warn toast naming what was asked, an\n    // unconfirmed delivery inline with Retry, never replayed on its own.\n    const v2Act = useCallback(\n        async (what: string, intent: Intent, quiet: Refusal[] = []): Promise<DispatchOutcome> => {\n            // A context-bound action speaks for the tenant it was sent in (I2).\n            const boundContext = deliveryContext(intent)\n            // A normal switch refusal still names its intended destination,\n            // but an uncertain switch must not offer Retry in another scope.\n            const retryContext = boundContext ?? (intent.kind === 'selectTenant' ? snapshotRef.current?.active?.context ?? null : null)\n            const bound = boundContext !== null ? (snapshotRef.current?.active?.tenant ?? null) : null\n            const outcome = await dispatch(intent)\n            if (outcome.kind === 'refused' && quiet.includes(outcome.refusal)) return outcome\n            if (outcome.kind === 'refused') useShellStore.getState().toast(SHELL_COPY.toastRefused(what, outcome.refusal, outcomeMessage(outcome)), 'warn', undefined, bound, boundContext)\n            else if (outcome.kind === 'unknown') useShellStore.getState().addUnconfirmed(what, intent, retryContext)\n            else if (outcome.kind === 'failed') useShellStore.getState().toast(SHELL_COPY.toastFailed(what), 'warn', undefined, bound, boundContext)\n            return outcome\n        },\n        [dispatch]\n    )\n    const v2Preference = useCallback(\n        async (what: string, intent: Intent, quiet: Refusal[] = []) => {\n            await v2Act(what, intent, quiet)\n        },\n        [v2Act]\n    )\n\n    const onMenu = useRef<(command: MenuCommand) => void>(() => undefined)\n    onMenu.current = (command: MenuCommand) => {\n        // Native navigation dismisses the modal palette first so focus can\n        // move to the new page heading instead of behind an open dialog.\n        if (command.kind === 'navigate') void v2Navigate(command.feature)\n        else if (command.kind === 'commandPalette') useShellStore.getState().openPalette()\n        // ⌘T: the tenant switcher opens; nothing switches until chosen.\n        else if (command.kind === 'tenantSwitcher') useShellStore.getState().setSwitcher(true)\n        // The open API Client request saves (its editor listens).\n        else if (command.kind === 'saveDocument') window.dispatchEvent(new Event(SAVE_DOCUMENT_EVENT))\n        else void v2Preference('The appearance change', { kind: 'setAppearance', theme: command.theme })\n    }\n\n    useEffect(() => {\n        let stop: (() => void) | undefined\n        let cancelled = false\n        client\n            .observeShell({\n                onSnapshot: (next) => {\n                    // The shell's scope follows the snapshot before it renders: a\n                    // notification for another tenant or context is never surfaced.\n                    useShellStore.getState().setScope(next.active?.tenant ?? null, next.active?.context ?? null, next.switchBlocked?.review ?? null)\n                    setSnapshot(next)\n                },\n                onMenu: (command) => onMenu.current(command),\n                onError: () => setFailure('The desktop sent an unexpected update.'),\n            })\n            .then(\n                (unsubscribe) => {\n                    if (cancelled) unsubscribe()\n                    else stop = unsubscribe\n                },\n                () => setFailure('The desktop shell could not be observed.')\n            )\n        return () => {\n            cancelled = true\n            stop?.()\n        }\n    }, [client])\n\n    // A completed reset also forgets Academy's WebView presentation state\n    // (completion latches keyed by account); a stopped reset keeps it.\n    const storage = snapshot?.storage\n    const resetFailed = Boolean(snapshot?.resetFailure)\n    const previousStorage = useRef(storage)\n    useEffect(() => {\n        if (previousStorage.current === 'resetting' && storage !== 'resetting' && !resetFailed) {\n            forgetAcademyPresentation()\n        }\n        previousStorage.current = storage\n    }, [storage, resetFailed])\n\n    const appearance = snapshot?.appearance\n    // Apply the theme in the same commit as the snapshot, before paint, so\n    // the shell never shows a frame in the previous theme.\n    useLayoutEffect(() => (appearance ? followAppearance(appearance) : undefined), [appearance])\n\n    if (failure && !snapshot) {\n        return (\n            <main role='alert' className='text-academy-ink p-8'>\n                {failure}\n            </main>\n        )\n    }\n    if (!snapshot) {\n        return (\n            <main role='status' aria-live='polite' className='text-academy-ink-soft p-8'>\n                Starting Prisma AIRS Desktop…\n            </main>\n        )\n    }\n    if (snapshot.onboarding !== 'done') {\n        // First run: the wizard owns the window (D060: no alpha import; nothing leaves it before a tenant exists).\n        return (\n            <div data-v2-shell=''>\n                <Wizard\n                    snapshot={snapshot}\n                    dispatch={dispatch}\n                    observeManagement={(operation) => client.observeManagement(operation)}\n                    mode='firstRun'\n                    onClose={() => undefined}\n                    onNavigate={(feature) => void v2Navigate(feature)}\n                />\n            </div>\n        )\n    }\n    return (\n        <V2Shell\n            snapshot={snapshot}\n            appearancePending={pending}\n            status={failure ?? status}\n            onNavigate={(feature) => void v2Navigate(feature)}\n            onSetAppearance={(theme) => void v2Preference('The appearance change', { kind: 'setAppearance', theme })}\n            onSetShowCalls={(on) => void v2Preference('The preference change', { kind: 'setShowCalls', on })}\n            onSwitchTenant={(tenant, resolution) => {\n                // The target is captured now: a late refusal still names it. A\n                // pending-decision refusal is not a toast: the snapshot carries\n                // the guard the shell renders (I1).\n                const label = snapshot.tenants.find((t) => t.id === tenant)?.label ?? tenant\n                void v2Preference(SHELL_COPY.switchTo(label), { kind: 'selectTenant', tenant, resolution: resolution ?? null }, ['decisionPending'])\n            }}\n            onReadNow={() => {\n                // The palette's Read now is the same finite read of every chosen product (I4).\n                const active = snapshot.active\n                if (!active) return\n                const label = snapshot.tenants.find((t) => t.id === active.tenant)?.label ?? active.tenant\n                void v2Preference(SHELL_COPY.readOf(label), { kind: 'readTenant', context: active.context })\n            }}\n            onRetry={(what, intent) => void v2Preference(what, intent)}\n            onAct={v2Act}\n            dispatch={dispatch}\n            client={client}\n        />\n    )\n}\nimport { forwardRef, useCallback } from 'react'\nimport type { DesktopClient, FeatureEntry, FeatureId, ShellSnapshot, Theme } from '@prisma-airs/desktop-contracts'\nimport { SessionsView } from '../modules/sessions/sessions-view'\nimport type { Dispatch } from '../modules/tenants/dispatch'\nimport { SettingsView, UnavailableView } from './feature-view'\n\nexport interface FeatureBodyProps {\n    feature: FeatureEntry\n    snapshot: ShellSnapshot\n    appearancePending: boolean\n    onSetAppearance: (theme: Theme) => void\n    onNavigate: (id: FeatureId) => void\n    dispatch: Dispatch\n    /** The native client, for management observations. */\n    client: DesktopClient\n}\n\n/**\n * The destinations the v2 shell frames without a board of their own (C44):\n * Settings, Sessions & Reports and the reviewed v1 import, keyed by the\n * active context where a view must never outlive its credential. Every\n * other destination is a v2 screen; the legacy shell and its views are gone.\n */\nexport const FeatureBody = forwardRef<HTMLHeadingElement, FeatureBodyProps>(function FeatureBody(props, heading) {\n    const { feature, snapshot } = props\n    const client = props.client\n    const observeManagement = useCallback((operation: string) => client.observeManagement(operation), [client])\n    return (\n        <>\n            {feature.id === 'settings' ? (\n                <SettingsView\n                    ref={heading}\n                    snapshot={snapshot}\n                    pending={props.appearancePending}\n                    onSetAppearance={props.onSetAppearance}\n                    dispatch={props.dispatch}\n                    observeManagement={observeManagement}\n                />\n            ) : feature.id === 'sessions' && feature.availability.state === 'available' ? (\n                <SessionsView\n                    // A new tenant or management credential remounts the view:\n                    // revealed content never outlives its credential.\n                    key={snapshot.active?.context ?? 'none'}\n                    ref={heading}\n                    snapshot={snapshot}\n                    dispatch={props.dispatch}\n                    observe={observeManagement}\n                    onNavigate={props.onNavigate}\n                />\n            ) : (\n                <UnavailableView ref={heading} feature={feature} />\n            )}\n        </>\n    )\n})\nimport { forwardRef, useId, useState } from 'react'\nimport { Button, Callout } from '@ai-security-academy/presentation'\nimport { Info } from 'lucide-react'\nimport type { FeatureEntry, Intent, ShellSnapshot, Theme } from '@prisma-airs/desktop-contracts'\nimport { type Dispatch, outcomeMessage } from '../modules/tenants/dispatch'\nimport { DiagnosticsPanel } from '../modules/diagnostics/diagnostics-panel'\nimport { AcademyAccount } from '../modules/academy/academy-account'\nimport { TenantsSettings } from '../modules/tenants/tenants-settings'\nimport type { ObserveManagement } from '../modules/administration/management-read'\n\ninterface HeadingProps {\n    id: string\n    kicker: string\n    title: string\n}\n\n/** Page heading that receives focus after navigation (tabIndex -1). */\nexport const PageHeading = forwardRef<HTMLHeadingElement, HeadingProps>(function PageHeading({ id, title }, ref) {\n    return (\n        <header className='mb-4 flex flex-col gap-1' data-slot='page-header'>\n            <h1 ref={ref} id={id} tabIndex={-1} data-slot='page-heading' className='font-bold outline-none' style={{ fontSize: 'var(--v2-title)' }}>\n                {title}\n            </h1>\n        </header>\n    )\n})\n\nexport const UnavailableView = forwardRef<HTMLHeadingElement, { feature: FeatureEntry }>(function UnavailableView({ feature }, ref) {\n    const planned = feature.availability.state === 'unavailable' ? feature.availability.plannedChunk : ''\n    return (\n        <section aria-labelledby={`${feature.id}-heading`} data-slot='feature-unavailable'>\n            <PageHeading ref={ref} id={`${feature.id}-heading`} kicker='Not available' title={feature.label} />\n            <Callout tone='default' icon={Info}>\n                <p>\n                    {feature.label} is not available in this build. Nothing here contacts a Prisma AIRS\n                    tenant or the Academy.\n                </p>\n                <p className='text-academy-ink-faint mt-2 font-mono text-[11px] tracking-[0.12em] uppercase'>\n                    Planned in {planned}\n                </p>\n            </Callout>\n        </section>\n    )\n})\n\nconst THEMES: { value: Theme; label: string; hint: string }[] = [\n    { value: 'system', label: 'Match System', hint: 'Follow the macOS appearance' },\n    { value: 'light', label: 'Light', hint: 'Paper light theme' },\n    { value: 'dark', label: 'Dark', hint: 'Gruvbox dark theme' },\n]\n\ninterface SettingsProps {\n    snapshot: ShellSnapshot\n    pending: boolean\n    onSetAppearance: (theme: Theme) => void\n    dispatch: Dispatch\n    observeManagement: ObserveManagement\n}\n\nexport const SettingsView = forwardRef<HTMLHeadingElement, SettingsProps>(function SettingsView(\n    { snapshot, pending, onSetAppearance, dispatch, observeManagement },\n    ref\n) {\n    const legend = useId()\n    const appearance = snapshot.appearance\n    return (\n        <section aria-labelledby='settings-heading' data-slot='settings'>\n            <PageHeading ref={ref} id='settings-heading' kicker='Desktop' title='Settings' />\n            <fieldset aria-labelledby={legend} aria-busy={pending} className='border-academy-rule flex flex-col gap-3 rounded-[12px] border p-5'>\n                <legend id={legend} className='text-academy-ink px-1 text-[15px] font-semibold'>\n                    Appearance\n                </legend>\n                <p className='text-academy-ink-soft text-[13px]'>\n                    A desktop-wide preference. It does not change your Academy account settings.\n                </p>\n                {THEMES.map((option) => (\n                    <label key={option.value} className='flex min-h-11 cursor-pointer items-center gap-3'>\n                        <input\n                            type='radio'\n                            name='appearance'\n                            value={option.value}\n                            checked={appearance === option.value}\n                            onChange={() => onSetAppearance(option.value)}\n                            className='accent-[var(--academy-accent)] size-4'\n                        />\n                        <span className='flex flex-col'>\n                            <span className='text-academy-ink text-[14px] font-medium'>{option.label}</span>\n                            <span className='text-academy-ink-faint text-[12px]'>{option.hint}</span>\n                        </span>\n                    </label>\n                ))}\n            </fieldset>\n            <div className='mt-6'>\n                <AcademyAccount view={snapshot.academy} dispatch={dispatch} />\n            </div>\n            <div className='mt-6'>\n                <TenantsSettings snapshot={snapshot} dispatch={dispatch} observeManagement={observeManagement} />\n            </div>\n            <div className='mt-6'>\n                <DiagnosticsPanel view={snapshot.diagnostics} dispatch={dispatch} />\n            </div>\n        </section>\n    )\n})\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_42","type":"command_execution","command":"/bin/zsh -lc \"cat tools/native-acceptance/test_candidate_process.py tools/native-acceptance/test_fixture_safety.py tools/native-acceptance/test_c04_current_frame.py tools/native-acceptance/test_c32_project_path.py; sed -n '1,220p' tools/native-acceptance/legacy_v2.py; sed -n '1,150p' tools/native-acceptance/legacy_map.py; sed -n '1,165p' docs/planning/evidence/P09/native-controller/native_requirements.py\"","aggregated_output":"\"\"\"Synthetic process-table tests: never launch or signal an OS process.\"\"\"\nimport json,plistlib,signal,sys,tempfile,unittest\nfrom pathlib import Path\nsys.path.insert(0,str(Path(__file__).resolve().parent))\nfrom candidate_process import Candidate,Identity,FIXTURE_ID,EXECUTABLE\nclass Processes:\n    def __init__(self):self.rows={};self.signals=[]\n    def snapshot(self,pid):return self.rows.get(pid)\n    def pids(self):return list(self.rows)\n    def send(self,pid,sig):self.signals.append((pid,sig))\nclass Ownership(unittest.TestCase):\n    def setUp(self):\n        self.temp=tempfile.TemporaryDirectory();self.root=Path(self.temp.name)/'Prisma AIRS Desktop Fixture.app'\n        p=self.root/'Contents/MacOS';p.mkdir(parents=True);(p/EXECUTABLE).write_text('synthetic executable')\n        (self.root/'Contents/Info.plist').write_bytes(plistlib.dumps({'CFBundleIdentifier':FIXTURE_ID,'CFBundleExecutable':EXECUTABLE}))\n        self.processes=Processes();self.candidate=Candidate(self.root,self.processes)\n    def tearDown(self):self.temp.cleanup()\n    def owned(self):\n        row=Identity(10,self.candidate.app_path,(123,456),1);self.processes.rows[10]=row;self.candidate.adopt_child(10,1);return row\n    def test_owned_exact_child_can_be_signaled(self):\n        self.owned();self.candidate.signal_app();self.assertEqual(self.processes.signals,[(10,signal.SIGTERM)])\n    def test_foreign_same_basename_old_namespace_and_regex_lookalike_are_not_signaled(self):\n        for path in ['/foreign/Prisma AIRS Desktop Fixture.app/Contents/MacOS/'+EXECUTABLE,'/old/Prisma AIRS Desktop v2 Fixture.app/Contents/MacOS/prisma-airs-desktop-v2',self.candidate.app_path.replace('Fixture.app','FixtureXapp')]:\n            self.processes.rows={11:Identity(11,path,(1,1),1)};self.candidate.signal_app()\n        self.assertEqual(self.processes.signals,[])\n    def test_unowned_same_candidate_is_not_adopted(self):\n        self.processes.rows[10]=Identity(10,self.candidate.app_path,(1,1),99)\n        with self.assertRaises(RuntimeError):self.candidate.app_pid()\n        self.assertEqual(self.processes.signals,[])\n    def test_reused_pid_cannot_be_signaled_even_with_same_path(self):\n        old=self.owned();self.processes.rows[10]=Identity(10,old.executable,(124,1),old.parent)\n        self.assertFalse(self.candidate.signal_identity(old,signal.SIGKILL));self.assertEqual(self.processes.signals,[])\n    def test_duplicate_candidate_processes_refuse_ui_and_cleanup(self):\n        self.owned();self.processes.rows[11]=Identity(11,self.candidate.app_path,(1,1),1)\n        with self.assertRaises(RuntimeError):self.candidate.app_pid()\n        self.assertEqual(self.processes.signals,[])\n    def test_engine_must_be_exact_owned_descendant(self):\n        self.owned();self.processes.rows.update({20:Identity(20,self.candidate.engine_path,(2,2),10),21:Identity(21,'/foreign/airs-harness',(2,3),10),22:Identity(22,self.candidate.engine_path,(2,4),99)})\n        self.assertEqual(self.candidate.engines(),[20]);self.candidate.stop_engines();self.assertEqual(self.processes.signals,[(20,signal.SIGKILL)])\n    def test_observed_engine_cleanup_survives_parent_exit_but_not_pid_reuse(self):\n        self.owned();engine=Identity(20,self.candidate.engine_path,(2,2),10);self.processes.rows[20]=engine;self.candidate.engines();del self.processes.rows[10];self.processes.rows[20]=Identity(20,engine.executable,engine.birth,1)\n        self.assertTrue(self.candidate.signal_engine(20));self.processes.rows[20]=Identity(20,engine.executable,(3,3),10)\n        self.assertFalse(self.candidate.signal_engine(20));self.assertEqual(self.processes.signals,[(20,signal.SIGKILL)])\n    def test_symlinked_engine_cannot_escape_the_bundle(self):\n        external=Path(self.temp.name)/'foreign-engine';external.write_text('foreign')\n        engine=self.root/'Contents/Resources/harness/airs-harness';engine.parent.mkdir(parents=True);engine.symlink_to(external)\n        with self.assertRaises(ValueError):Candidate(self.root,self.processes)\n        self.assertEqual(self.processes.signals,[])\n    def test_production_or_missing_bundle_is_rejected(self):\n        p=self.root/'Contents/Info.plist';p.write_bytes(plistlib.dumps({'CFBundleIdentifier':'io.cdot.airs-desktop','CFBundleExecutable':EXECUTABLE}))\n        with self.assertRaises(ValueError):Candidate(self.root,self.processes)\n        with self.assertRaises(FileNotFoundError):Candidate(self.root/'missing',self.processes)\nif __name__=='__main__':unittest.main()\n\"\"\"No UI, keychain or real user-data operations: isolated helper boundary tests.\"\"\"\nfrom pathlib import Path\nimport os\nimport tempfile\nimport unittest\nfrom unittest.mock import patch\nimport fixture_app as fx\n\n\nclass FixtureSafetyTests(unittest.TestCase):\n    def test_rejects_old_or_foreign_root_before_any_cleanup(self):\n        with patch.object(fx,\"DATA\",\"/synthetic/old-v2\"), patch.object(fx,\"sh\") as run, patch.object(fx.shutil,\"rmtree\") as remove:\n            with self.assertRaisesRegex(RuntimeError,\"exact new fixture root\"):fx.clean_fixture_root()\n            run.assert_not_called();remove.assert_not_called()\n\n    def test_symlinked_root_and_keychain_cannot_escape(self):\n        with tempfile.TemporaryDirectory() as tmp:\n            home=Path(tmp).resolve();expected=home/\"Library/Application Support/io.cdot.airs-desktop.fixture\";expected.parent.mkdir(parents=True)\n            other=home/\"foreign\";other.mkdir();expected.symlink_to(other,target_is_directory=True)\n            with patch.object(fx.os.path,\"expanduser\",return_value=str(home)),patch.object(fx,\"DATA\",str(expected)),patch.object(fx,\"KEYCHAIN\",str(expected/\"fixture-credentials.keychain-db\")),patch.object(fx,\"sh\") as run:\n                with self.assertRaisesRegex(RuntimeError,\"exact new fixture root\"):fx.clean_fixture_root()\n                run.assert_not_called()\n            expected.unlink();expected.mkdir();(expected/\"fixture-credentials.keychain-db\").symlink_to(other/\"secret\")\n            with patch.object(fx.os.path,\"expanduser\",return_value=str(home)),patch.object(fx,\"DATA\",str(expected)),patch.object(fx,\"KEYCHAIN\",str(expected/\"fixture-credentials.keychain-db\")),patch.object(fx,\"sh\") as run:\n                with self.assertRaisesRegex(RuntimeError,\"symlinked\"):fx.clean_fixture_root()\n                run.assert_not_called()\n\n    def test_canary_digest_detects_same_size_same_timestamp_mutation(self):\n        with tempfile.TemporaryDirectory() as tmp,patch.object(fx,\"V1_DATA\",tmp):\n            p=Path(tmp)/\"old-state\";p.write_text(\"before\");stamp=p.stat().st_mtime_ns;before=fx.v1_metadata()\n            p.write_text(\"after!\");os.utime(p,ns=(stamp,stamp));after=fx.v1_metadata()\n            self.assertEqual(before[0][:3],after[0][:3]);self.assertNotEqual(before[0][3],after[0][3])\n\n    def test_process_name_signaling_rejected_before_subprocess(self):\n        with patch.object(fx.subprocess,\"run\") as run:\n            for command in [[\"pkill\",\"app\"],[\"/usr/bin/killall\",\"app\"]]:\n                with self.assertRaisesRegex(RuntimeError,\"forbidden\"):fx.sh(command)\n            run.assert_not_called()\n\n\nif __name__ == \"__main__\":unittest.main()\n\"\"\"Actual-frame containment, including retained failure geometry and negatives.\"\"\"\nimport unittest\nfrom acceptance_c04 import current_frame_clear\n\nclass CurrentFrameTests(unittest.TestCase):\n    def setUp(self):\n        self.window=dict(pos=[320,95],size=[900,600]);self.viewport=dict(pos=[320,123],size=[900,572]);self.control=dict(pos=[449,651],size=[113,44])\n    def test_actual_retained_minimum_geometry_is_visible_without_a_nonexistent_fade(self):\n        self.assertGreater(self.control['pos'][1]+self.control['size'][1],self.window['pos'][1]+self.window['size'][1]-60)\n        self.assertTrue(current_frame_clear(self.control,self.window,self.viewport))\n    def test_below_window_control_is_rejected(self):\n        self.control['pos'][1]+=5;self.assertFalse(current_frame_clear(self.control,self.window,self.viewport))\n    def test_horizontal_clipping_is_rejected(self):\n        self.control['pos'][0]=1200;self.assertFalse(current_frame_clear(self.control,self.window,self.viewport))\n    def test_viewport_clipping_is_rejected_even_inside_window(self):\n        self.viewport['size'][1]-=20;self.assertFalse(current_frame_clear(self.control,self.window,self.viewport))\n    def test_missing_focused_control_or_webview_cannot_pass(self):\n        self.assertFalse(current_frame_clear(None,self.window,self.viewport));self.assertFalse(current_frame_clear(self.control,self.window,None))\n\nif __name__=='__main__':unittest.main()\n\"\"\"Controlled filesystem regression for the isolated-worktree path alias.\"\"\"\nimport os\nfrom pathlib import Path\nimport tempfile\nimport unittest\nfrom unittest.mock import patch\nwith patch.dict(os.environ,{\"AIRS_C32_EVIDENCE\":\"synthetic-no-UI\"}):\n    from acceptance_c32_current import native_project_root\n\n\nclass ProjectPathTests(unittest.TestCase):\n    def test_symlinked_target_matches_the_native_canonical_selected_folder(self):\n        with tempfile.TemporaryDirectory() as directory:\n            root=Path(directory).resolve();physical=root/\"shared-target\";physical.mkdir();work=root/\"isolated-worktree\";work.mkdir();(work/\"target\").symlink_to(physical,target_is_directory=True)\n            old_alias=work/\"target/native-c32-000000000001/agent-demo\"\n            expected=physical/\"native-c32-000000000001/agent-demo\"\n            current=Path(native_project_root(str(work),\"000000000001\"))/\"agent-demo\";current.mkdir(parents=True)\n            self.assertNotEqual(str(old_alias),str(expected),\"old exact text assertion did not handle the path alias\")\n            self.assertEqual(current,expected)\n            self.assertTrue(os.path.samefile(old_alias,current),\"same selected owned folder, no assertion retirement\")\n\n    def test_regular_target_also_uses_its_exact_owned_folder(self):\n        with tempfile.TemporaryDirectory() as directory:\n            root=Path(directory).resolve();(root/\"target\").mkdir()\n            self.assertEqual(native_project_root(str(root),\"000000000002\"),str(root/\"target/native-c32-000000000002\"))\n\n\nif __name__=='__main__':unittest.main()\n\"\"\"Runs a pre-P09 native driver on the one presentation (C44).\n\nImported before the driver, it patches the fixture-app helpers the legacy\nscripts call so their assertions run unchanged against the v2 shell:\n\n- `open_settings`: the first run of a fresh store is the wizard; it is\n  walked once with a placeholder tenant (no credential) before Settings.\n- `create_custom_tenant`: the core keeps the active tenant on create, so a\n  tenant the script creates is made active at once, as the legacy form did.\n- `ax press/focus` of a legacy sidebar entry (Sessions & Reports, Import\n  from v1, a product page): the v2 shell lists these in the Go menu.\n\"\"\"\n\nimport time\n\nimport fixture_app as fx\nimport v2_setup as v2s\n\nGO = {\n    \"Sessions &\": \"Sessions & Reports\",\n    \"Sessions & Reports\": \"Sessions & Reports\",\n    \"Runtime Security\": \"Runtime Security\",\n    \"Runtime\": \"Runtime Security\",\n    \"AI Gateway\": \"AI Gateway\",\n    \"Red Team & Models\": \"Red Team & Models\",\n    \"Administration\": \"Administration\",\n    # The legacy Case Library is the Test Cases destination.\n    \"Case Library\": \"Test Cases\",\n    \"Academy\": \"Academy\",\n    \"Harness\": \"Harness\",\n    \"Home\": \"Home\",\n    \"API Client\": \"API Client\",\n}\n\n# The legacy Administration sidebar's inventories: on the v2 shell they are the AI Runtime Security card's DLP tab\n# (its DLP inventory segments) and the card's own tabs.\nDLP_INVENTORIES = (\"Data patterns\", \"Dictionaries\", \"Data profiles\", \"Data filtering profiles\")\nRUNTIME_TABS = (\"Deployment profiles\", \"Security profiles\", \"Custom topics\", \"Applications\", \"API keys\", \"Overview\", \"Playground\", \"DLP\")\n\n_open_settings = fx.App.open_settings\n_create = fx.App.create_custom_tenant\n_ax = fx.App.ax\n\n\n# The placeholder tenant's TSG: not the drivers' shared TSG (c8.TSG), which the v1 import fixture gives its Prod tenant;\n# the importer maps a v1 tenant onto an existing tenant with the same TSG, and the C23 run saw Prod land on the\n# placeholder instead of becoming its own tenant.\nPLACEHOLDER_TSG = \"9000000009\"\n\n\ndef open_settings(self):\n    if v2s.wizard_showing(self, timeout=3):\n        v2s.first_run(self, None, label=v2s.PLACEHOLDER, tsg=PLACEHOLDER_TSG, client=False)\n    return _open_settings(self)\n\n\ndef create_custom_tenant(self, label, origin):\n    out = _create(self, label, origin)\n    self.make_active(label)\n    # The switch leaves Settings for Home: the pre-P09 driver's next step types the credentials into Settings, so it\n    # is opened again here (the first run on this build found Home where it expected the key field).\n    _open_settings(self)\n    return out\n\n\ndef _runtime_card(self):\n    \"\"\"Administration with the AI Runtime Security card open (Expand all opens every card).\"\"\"\n    tree = self.tree()\n    if self.node(tree, \"AXHeading\", \"Administration\") is None:\n        self.menu(\"Go\", \"Administration\")\n        tree, _ = self.wait_for(lambda t: self.node(t, \"AXHeading\", \"Administration\") is not None, 12)\n    if not any(n.get(\"role\") == \"AXRadioButton\" and (n.get(\"label\") or \"\") == \"DLP\" for n in tree):\n        _ax(self, \"press\", \"AXButton\", \"Expand all\")\n        self.wait_for(lambda t: any(n.get(\"role\") == \"AXRadioButton\" and (n.get(\"label\") or \"\") == \"DLP\" for n in t), 10)\n\n\ndef _runtime_tab(self, label):\n    \"\"\"Selects a tab of the Runtime card. Pressed every time: the tree reports a value of 1 on tabs that are not\n    selected (the C10 run read Data filtering profiles where it expected Deployment profiles), and pressing the\n    selected tab again changes nothing.\"\"\"\n    _runtime_card(self)\n    _ax(self, \"press\", \"AXRadioButton\", label)\n    time.sleep(0.8)\n\n\ndef _playground(self):\n    \"\"\"The Runtime card's Playground tab with its scan form shown: the legacy Runtime Security view's scan form is the\n    AI Runtime Security card's Playground tab on the one presentation (Go › Runtime Security lands on the card's\n    default tab).\"\"\"\n    _runtime_tab(self, \"Playground\")\n    self.wait_for(lambda t: self.node(t, \"AXTextField\", \"Profile name or ID\") is not None, 12)\n\n\ndef open_runtime(self):\n    self.menu(\"Go\", \"Runtime Security\")\n    self.wait_for(lambda t: self.node(t, \"AXHeading\", \"Administration\") is not None, 12)\n    _playground(self)\n    return self.tree()\n\n\ndef ax(self, command, *args):\n    # The first v2 shell's drivers (C28–C33) switched the window to v2 through Settings' interface switch; on the one\n    # presentation there is no switch and the window is already v2.\n    if command == \"press\" and len(args) >= 2 and args[0] == \"AXCheckBox\" and args[1] == \"Use the new interface\" and self.node(self.tree(), \"AXCheckBox\", args[1]) is None:\n        return \"\"\n    if command in (\"press\", \"focus\") and len(args) >= 2 and args[0] == \"AXButton\" and args[1] in GO and self.node(self.tree(), \"AXButton\", args[1]) is None:\n        # A pre-P09 driver may open a destination before any tenant exists (the legacy shell allowed it); on the one\n        # presentation the first run is the wizard, walked once with the placeholder tenant first.\n        if v2s.wizard_showing(self, timeout=1):\n            v2s.first_run(self, None, label=v2s.PLACEHOLDER, tsg=PLACEHOLDER_TSG, client=False)\n        self.menu(\"Go\", GO[args[1]])\n        if GO[args[1]] == \"Runtime Security\":\n            self.wait_for(lambda t: self.node(t, \"AXHeading\", \"Administration\") is not None, 12)\n            _playground(self)\n        return \"\"\n    if command == \"press\" and len(args) == 2 and args[0] == \"AXButton\" and args[1] in DLP_INVENTORIES:\n        # A legacy DLP inventory: the Runtime card's DLP tab, then its segment.\n        _runtime_tab(self, \"DLP\")\n        _ax(self, \"press\", \"AXRadioButton\", args[1])\n        time.sleep(0.8)\n        return \"\"\n    if command == \"press\" and len(args) == 2 and args[0] == \"AXButton\" and args[1] in RUNTIME_TABS and self.node(self.tree(), \"AXButton\", args[1]) is None:\n        _runtime_tab(self, args[1])\n        return \"\"\n    if command == \"press\" and len(args) >= 2 and args[0] == \"AXButton\" and args[1] == \"Close\" and not any(n.get(\"role\") == \"AXButton\" and (n.get(\"label\") or \"\") == \"Close\" for n in self.tree()):\n        # The v2 review sheet's close control is \"Close review\".\n        if self.node(self.tree(), \"AXButton\", \"Close review\") is not None:\n            return _ax(self, \"press\", \"AXButton\", \"Close review\")\n    if command in (\"press\", \"focus\") and len(args) >= 2 and args[0] in (\"AXButton\", \"AXCheckBox\") and isinstance(args[1], str) and self.node(self.tree(), args[0], args[1]) is None:\n        # The v2 Harness keeps its project, sign-in and workspace panels behind one disclosure (C38); a pre-P09 driver\n        # presses their controls directly, so the disclosure is opened first when the control is not in the tree.\n        toggle = self.node(self.tree(), \"AXButton\", \"Project, sign-in and workspace tools\")\n        if toggle is not None:\n            _ax(self, \"press\", \"AXButton\", \"Project, sign-in and workspace tools\")\n            self.wait_for(lambda t: self.node(t, args[0], args[1]) is not None, 6)\n    if command in (\"press\", \"focus\") and len(args) == 2 and isinstance(args[1], str):\n        # The probe matches a label by prefix, in tree order. The v2 shell's rail puts \"Search or go to… Command K\"\n        # ahead of a page's own \"Search\" button, so a legacy driver's exact label is preferred when one exists\n        # (the first run on this build opened the palette instead of searching).\n        role, label = args\n        matches = [n for n in self.tree() if n.get(\"role\") == role and (n.get(\"label\") or \"\").startswith(label)]\n        exact = [i for i, n in enumerate(matches) if (n.get(\"label\") or \"\") == label]\n        if exact and exact[0] != 0:\n            return _ax(self, command, role, label, exact[0])\n    return _ax(self, command, *args)\n\n\nfx.App.open_settings = open_settings\nfx.App.open_runtime = open_runtime\nfx.App.create_custom_tenant = create_custom_tenant\nfx.App.ax = ax\n\n# The C8 reach: the legacy shell drew a 60 CSS px fade over the bottom of every page, so a control reached by Tab\n# had to end above it; the v2 shell has no such fade, and a control scrolled into view is clear when it lies inside\n# the window.\nimport acceptance_c08 as _c8\n\n_reach = _c8.reach\n\n\ndef reach(app, zoom, label):\n    out = _reach(app, zoom, label)\n    f, w = out.get(\"found\"), out.get(\"window\")\n    if f and w:\n        out[\"clear\"] = f[\"pos\"][1] >= w[\"pos\"][1] and f[\"pos\"][1] + f[\"size\"][1] <= w[\"pos\"][1] + w[\"size\"][1] + 1\n        out[\"criterion\"] = \"inside the window (the v2 shell has no bottom fade)\"\n    return out\n\n\n_c8.reach = reach\n\n# The C23 keyboard run reaches the legacy sidebar's \"Import from v1\" by Tab and presses Space on it. The v2 shell has\n# no sidebar entry for it; its keyboard route is the command palette (⌘K, the destination's name, Return), used here\n# so the run stays keyboard-only.\ntry:\n    import acceptance_c23 as _c23\n\n    _space_on = _c23.space_on\n\n    def space_on(app, role, prefix):\n        if role == \"AXButton\" and prefix in GO and app.node(app.tree(), \"AXButton\", prefix) is None:\n            app.keys(\"k\", \"command down\")\n            time.sleep(0.6)\n            app.keys(GO[prefix])\n            time.sleep(0.6)\n            app.keycode(36)\n            time.sleep(0.8)\n            return GO[prefix]\n        return _space_on(app, role, prefix)\n\n    _c23.space_on = space_on\nexcept ImportError:\n    pass\n\n# The C9 helpers' exact Close: the v2 review sheet's control is \"Close review\".\ntry:\n    import acceptance_c09 as _c9\n\n    _press_exact = _c9.press_exact\n\n    def press_exact(app, label):\n        if label == \"Close\" and not any(n.get(\"role\") == \"AXButton\" and (n.get(\"label\") or \"\") == \"Close\" for n in app.tree()):\n            return _press_exact(app, \"Close review\")\n        return _press_exact(app, label)\n\n    _c9.press_exact = press_exact\nexcept ImportError:  # a driver that does not use the C9 helpers\n    pass\n#!/usr/bin/env python3\n\"\"\"Writes the assertion-level legacy-script map (C44): every native check a pre-P09 script recorded\n(docs/architecture/native-checks.json), what it asserts, where it stands on the one presentation\n(tools/native-acceptance/legacy_assertions.py: exercised by a v2 check, self-run through legacy_v2, ported into a v2\ncheck, or retired with its reason) and the result of each target on the C44 bundle (native/cumulative/<CNN>/ for the\ncumulative drivers, the root C44 record for C44-N01). Run from the repository root after the native stage; prints the\ntable and rewrites the table section of docs/planning/evidence/C44/legacy-script-map.md.\"\"\"\n\nimport json\nimport os\nimport re\nimport sys\nfrom collections import Counter\n\nsys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))\nimport legacy_assertions as la  # noqa: E402\n\nROOT = os.getcwd()\nCHECKS = json.load(open(os.path.join(ROOT, \"docs/architecture/native-checks.json\")))[\"chunks\"]\nCUM = os.path.join(ROOT, \"docs/planning/evidence/C44/native/cumulative\")\nROOT_RECORD = os.path.join(ROOT, \"docs/planning/evidence/C44/native-acceptance.json\")\nMAP = os.path.join(ROOT, \"docs/planning/evidence/C44/legacy-script-map.md\")\nKIND = {la.X: \"exercised\", la.S: \"self-run\", la.P: \"ported\", la.R: \"retired\"}\nLEGACY = [c for c in CHECKS if re.fullmatch(r\"C(0[1-9]|1\\d|2[0-9]|3[0-3])\", c)]\n\n\ndef results(chunk):\n    path = ROOT_RECORD if chunk == \"C44\" else os.path.join(CUM, chunk, \"native-acceptance.json\")\n    try:\n        rec = json.load(open(path))\n        return {c[\"id\"]: c[\"result\"] for c in rec[\"checks\"]}\n    except (OSError, ValueError, KeyError):\n        return {}\n\n\nrows, missing_entries, counts = [], [], Counter()\nfor chunk in LEGACY:\n    for c in CHECKS[chunk]:\n        what = re.sub(r\"\\s+\", \" \", c[\"check\"]).strip()\n        if len(what) > 170:\n            what = what[:167] + \"…\"\n        entry = la.ASSERTIONS.get(c[\"id\"])\n        if entry is None:\n            missing_entries.append(c[\"id\"])\n            rows.append((c[\"id\"], what, \"UNMAPPED\", \"—\", \"—\"))\n            continue\n        kind, targets, note = entry\n        counts[kind] += 1\n        if kind == la.R:\n            rows.append((c[\"id\"], what, KIND[kind], note, \"retired\"))\n        else:\n            per = [f\"{t} {results(t.split('-')[0]).get(t, 'not run')}\" for t in targets]\n            where = (\", \".join(targets) + (f\" — {note}\" if note else \"\")) if targets else note\n            rows.append((c[\"id\"], what, KIND[kind], where, \", \".join(per) or \"—\"))\n\ntable = [\"| Legacy check | What it asserts | Standing | Where it is asserted on the one presentation (or why it is retired) | Result on the C44 bundle |\", \"|---|---|---|---|---|\"]\nfor r in rows:\n    table.append(\"| \" + \" | \".join(x.replace(\"|\", \"\\\\|\") for x in r) + \" |\")\nsummary = (f\"{sum(counts.values())} legacy assertions: {counts.get(la.X, 0)} exercised by v2 checks, {counts.get(la.S, 0)} self-run through legacy_v2, \"\n           f\"{counts.get(la.P, 0)} ported into v2 checks, {counts.get(la.R, 0)} retired with a reason\"\n           + (f\"; UNMAPPED: {missing_entries}\" if missing_entries else \"\") + \".\")\ntext = summary + \"\\n\\n\" + \"\\n\".join(table) + \"\\n\"\nprint(text)\nmd = open(MAP).read()\nstart = md.index(\"## Every legacy assertion\")\nend = md.index(\"\\n## \", start + 10) if \"\\n## \" in md[start + 10:] else len(md)\nmd = (md[:start] + \"## Every legacy assertion, where it stands now, and its result on this bundle\\n\\n\"\n      \"Generated by `tools/native-acceptance/legacy_map.py` from `docs/architecture/native-checks.json`, `tools/native-acceptance/legacy_assertions.py` \"\n      \"(the per-assertion standing: exercised, self-run, ported, retired) and the records under `native/cumulative/` and the root C44 record, after the native stage. \"\n      \"A retirement names the suite that holds the behaviour where it survives in the core; that suite result does not stand in for a native assertion. \"\n      \"The gate (`acceptance_c44.py`, C44-N01) fails when an exercised, self-run or ported assertion has a target missing or failing on this bundle.\\n\\n\" + text + md[end:])\nopen(MAP, \"w\").write(md)\nif missing_entries:\n    sys.exit(1)\n\"\"\"Read the C44 gate's existing assertion map without changing its requirements.\"\"\"\nimport json\nimport re\nimport runpy\n\n\ndef load_requirements(root):\n    manifest = json.loads((root / 'docs/architecture/native-checks.json').read_text())['chunks']\n    data = runpy.run_path(str(root / 'tools/native-acceptance/legacy_assertions.py'))\n    assertions = data['ASSERTIONS']\n    legacy_ids = {c['id'] for chunk, checks in manifest.items()\n                  if re.fullmatch(r'C(0[1-9]|1\\d|2\\d|3[0-3])', chunk) for c in checks}\n    assert legacy_ids == set(assertions), 'legacy map differs from the full manifest'\n    targets = {t for kind, ts, _ in assertions.values()\n               if kind in (data['X'], data['S'], data['P']) for t in ts}\n    self_run = {lid.split('-')[0] for lid, (kind, _, _) in assertions.items() if kind == data['S']}\n    required = {chunk: {t for t in targets if t.startswith(chunk + '-')} for chunk in self_run}\n    # Some legacy ids are carried by a different self-run driver. Only drivers with actual targets run;\n    # the union check below still requires every mapped target to be covered.\n    required = {chunk: checks for chunk, checks in required.items() if checks}\n    for chunk in [f'C{i}' for i in range(35, 45)]:\n        required[chunk] = {c['id'] for c in manifest[chunk]}\n    assert all(required.values()), 'empty required native check set'\n    assert targets <= set().union(*required.values()), 'mapped native target has no driver'\n    return required\n\n\ndef assess_record(record, root, executable_sha256, required):\n    errors = []\n    if record.get('app', {}).get('executable_sha256') != executable_sha256:\n        errors.append('stale executable')\n    checks = {c['id']: c for c in record.get('checks', [])}\n    for cid in sorted(required):\n        check = checks.get(cid)\n        if check is None:\n            errors.append(cid + ' missing')\n        elif check['result'] != 'pass':\n            errors.append(cid + ' ' + check['result'])\n        else:\n            errors.extend(cid + ' missing evidence: ' + e for e in check['evidence'] if not (root / e).exists())\n    carried_elsewhere = [cid for cid, c in checks.items() if cid not in required and c['result'] != 'pass']\n    return errors, carried_elsewhere\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_43","type":"command_execution","command":"/bin/zsh -lc \"sed -n '375,470p' apps/desktop/src-tauri/src/adapters.rs; cat docs/planning/evidence/C45/baseline-03/build-reuse-preflight.json; cat docs/planning/evidence/C45/baseline-03/identity/observations.json | head -65; cat docs/planning/evidence/C45/baseline-03/native/cumulative/C04/native/observations.json | head -15\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_43","type":"command_execution","command":"/bin/zsh -lc \"sed -n '375,470p' apps/desktop/src-tauri/src/adapters.rs; cat docs/planning/evidence/C45/baseline-03/build-reuse-preflight.json; cat docs/planning/evidence/C45/baseline-03/identity/observations.json | head -65; cat docs/planning/evidence/C45/baseline-03/native/cumulative/C04/native/observations.json | head -15\"","aggregated_output":"            })\n            .ok()?;\n            let path = rx.await.ok()??;\n            let name = path\n                .file_name()\n                .map(|n| n.to_string_lossy().into_owned())\n                .unwrap_or_default();\n            let read = tokio::task::spawn_blocking(move || read_limited(&path, MAX_EXPORT_BYTES))\n                .await\n                .ok()?;\n            Some(read.map(|bytes| ImportFile { name, bytes }))\n        })\n    }\n}\n\n/// When this file exists in the fixture data root, the fixture build uses\n/// the production rfd sheets (NSOpenPanel / NSSavePanel) instead of staged\n/// files, so native acceptance can drive the real panels.\n#[cfg(feature = \"test-fixtures\")]\npub const FIXTURE_NATIVE_SHEETS: &str = \"fixture-native-sheets\";\n\n/// Production builds always use the native sheet.\n#[cfg(not(feature = \"test-fixtures\"))]\nfn sheet_picker(\n    _root: Option<&Path>,\n    configured: Arc<dyn ImportPicker>,\n    _native: Arc<dyn ImportPicker>,\n) -> Arc<dyn ImportPicker> {\n    configured\n}\n\n#[cfg(feature = \"test-fixtures\")]\nfn sheet_picker(\n    root: Option<&Path>,\n    staged: Arc<dyn ImportPicker>,\n    native: Arc<dyn ImportPicker>,\n) -> Arc<dyn ImportPicker> {\n    struct Switch(\n        Option<PathBuf>,\n        Arc<dyn ImportPicker>,\n        Arc<dyn ImportPicker>,\n    );\n    impl ImportPicker for Switch {\n        fn choose(&self) -> BoxFuture<'static, Option<Result<ImportFile, ImportError>>> {\n            if self.0.as_ref().is_some_and(|flag| flag.exists()) {\n                self.2.choose()\n            } else {\n                self.1.choose()\n            }\n        }\n    }\n    Arc::new(Switch(\n        root.map(|r| r.join(FIXTURE_NATIVE_SHEETS)),\n        staged,\n        native,\n    ))\n}\n\n#[cfg(not(feature = \"test-fixtures\"))]\nfn sheet_saver(\n    _root: Option<&Path>,\n    configured: Arc<dyn FileSaver>,\n    _native: Arc<dyn FileSaver>,\n) -> Arc<dyn FileSaver> {\n    configured\n}\n\n#[cfg(feature = \"test-fixtures\")]\nfn sheet_saver(\n    root: Option<&Path>,\n    staged: Arc<dyn FileSaver>,\n    native: Arc<dyn FileSaver>,\n) -> Arc<dyn FileSaver> {\n    struct Switch(Option<PathBuf>, Arc<dyn FileSaver>, Arc<dyn FileSaver>);\n    impl FileSaver for Switch {\n        fn save(\n            &self,\n            suggested: String,\n            bytes: Vec<u8>,\n        ) -> BoxFuture<'static, Result<Option<String>, ()>> {\n            if self.0.as_ref().is_some_and(|flag| flag.exists()) {\n                self.2.save(suggested, bytes)\n            } else {\n                self.1.save(suggested, bytes)\n            }\n        }\n    }\n    Arc::new(Switch(\n        root.map(|r| r.join(FIXTURE_NATIVE_SHEETS)),\n        staged,\n        native,\n    ))\n}\n\n/// Case exports are bounded like v1 (256 KiB).\npub const MAX_CASE_FILE_BYTES: usize = desktop_core::library::LIBRARY_BYTES;\n{\n  \"original_candidate_sha256\": \"4727744473b204ac2851b975daeea4d1292292af460af4279d5684645e33f7bd\",\n  \"original_build_stage_sha256\": \"a513ea3607a0459a8815394159679b38aba50c56ac7050e6e32929a74d460874\",\n  \"declared_helper_only_delta\": [\n    \"tools/native-acceptance/acceptance_c45.py\",\n    \"tools/p10/candidate.py\",\n    \"tools/p10/finalize.py\",\n    \"tools/p10/native.py\",\n    \"tools/p10/seal.py\",\n    \"tools/p10/supervise.py\",\n    \"tools/p10/test_build_reuse.py\"\n  ],\n  \"executable_sha256\": \"4cdca217bdf315f6688047f9b5ad8f84dbc03e4b07cb13e3dcdaa1524efaf661\",\n  \"bundle_sha256\": \"f0f14e6be19d7b5a9dce7c848