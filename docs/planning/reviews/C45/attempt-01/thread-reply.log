{"type":"item.completed","item":{"id":"item_22","type":"command_execution","command":"/bin/zsh -lc 'cat tools/p10/stages.py tools/p10/continuation.py tools/p10/finalize.py tools/p10/native.py'","aggregated_output":"\"\"\"Immutable actual-stage bindings for recovery and finalization.\"\"\"\nfrom pathlib import Path\nfrom qualification import read,sha,require\n\n\ndef collect(root,base,stage,raw_runner=None):\n    files=[];missing=[]\n    if raw_runner:\n        path=root/raw_runner;raw=read(path);files=[path]+[path.parent/command['log'] for command in raw['commands']]\n    elif stage.startswith('native-'):\n        chunk=stage[len('native-'):].upper()\n        folder=base if chunk=='C44' else base/'identity' if chunk=='C45' else base/'native/cumulative'/chunk\n        path=folder/'native-acceptance.json';raw=read(path);files=[path]\n        for check in raw['checks']:\n            for name in check['evidence']:\n                evidence=root/name\n                if not evidence.exists() and check['result']!='pass':missing.append(name)\n                else:\n                    require(evidence.is_file(),'native raw evidence missing: '+name)\n                    files.append(evidence)\n        if chunk!='C45':\n            wrapper=folder/'execution.json';execution=read(wrapper)\n            require(execution['raw_record_sha256']==sha(path) and execution['controller_sha256']==sha(root/'tools/p10/native.py') and execution['required_check_errors']==[],'native wrapper/raw/controller binding')\n            require(execution['executable_sha256']==read(base/'candidate.json')['executable_sha256'],'native wrapper candidate binding')\n            files.append(wrapper)\n    elif stage=='startup-smoke':files=list((base/'startup-smoke-01').rglob('*.json'))\n    elif stage=='build':files=[root/'docs/planning/evidence/C45/native-prepare.json']\n    elif stage=='finalize':files=[root/'docs/planning/evidence/C45/qualified-coverage.json',base/'qualification-audit.json']\n    return {**{str(path.relative_to(root)):sha(path) for path in sorted(set(files))},**{name:None for name in missing}}\n\n\ndef verify_completed(root,folder,state,argv,source,candidate_sha=None):\n    require(state['exit_code']==0 and state['argv']==argv and state['source_fingerprint']==source,'completed stage command/source failed or differs')\n    require(sha(folder/'stdout.log')==state['stdout_sha256'] and sha(folder/'stderr.log')==state['stderr_sha256'],'completed stage log drift')\n    if candidate_sha:require(state['candidate_sha256']==candidate_sha,'completed stage candidate drift')\n    require(state.get('artifacts'),'completed stage raw artifact binding missing')\n    for name,expected in state['artifacts'].items():\n        if expected is None:require(not (root/name).exists(),'recorded missing superseded raw evidence changed: '+name)\n        else:require(sha(root/name)==expected,'completed stage raw/evidence drift: '+name)\n    return True\n\n\ndef verify_conditions(candidate,current,platform_name,hostname):\n    require({key:current[key] for key in ['source','dependencies','build_flags']}==candidate['runner_inputs'],'dependency/toolchain/build identity changed; diagnose affected checks without blanket replay')\n    require(candidate['conditions']['platform']==platform_name and candidate['conditions']['hostname']==hostname,'execution platform/conditions changed')\n    return True\n\"\"\"Explicit test-only continuation; preserves passed raw stages and their inputs.\n\nOnly the stale C45 permission-manifest test and named provenance consumers may\nchange. The successful app build and completed checks are never relabeled as\nnew executions. The failed Host aggregate is executed again to finish its\npreviously unrun targets; unrelated Core/frontend/native work is not restarted.\n\"\"\"\nfrom pathlib import Path\nimport copy,json,shutil\nfrom qualification import read,sha,require\nfrom candidate import source_inventory,digest,helper_closure\nfrom stages import verify_completed\n\nALLOWED={\n 'apps/desktop/src-tauri/tests/permission_manifest.rs',\n 'tools/p10/candidate.py','tools/p10/supervise.py','tools/p10/finalize.py',\n 'tools/p10/continuation.py','tools/p10/test_continuation.py',\n}\n\n\ndef paths(base):\n    marker=base/'continuation-04.json'\n    folder=base/'continuation-04' if marker.exists() else base/'continuation-03' if (base/'continuation-03.json').exists() else base/'continuation-02' if (base/'continuation-02.json').exists() else base/'continuation-01' if (base/'continuation-01.json').exists() else base\n    return dict(folder=folder,source=folder/'source-seal.json',candidate=folder/'candidate.json',plan=folder/'required-coverage.json',stages=folder/'stages',reuse=folder/'build-reuse.json')\n\n\ndef verify(root,base):\n    if any((base/('continuation-%02d.json'%n)).exists() for n in (4,3,2)):return verify_native_continuation(root,base)\n    marker=read(base/'continuation-01.json');current=paths(base)\n    require(marker['schema']=='airs-desktop/c45-test-only-continuation/1' and marker['affected_stage']=='command-C45-host-2','continuation schema/scope')\n    before=read(base/'source-seal.json')['files'];after=read(current['source'])['files']\n    require(sha(current['source'])==marker['source_seal_sha256'],'continuation seal changed')\n    changed=sorted(name for name in set(before)|set(after) if before.get(name)!=after.get(name))\n    require(changed==marker['declared_changed_paths'] and set(changed)<=ALLOWED,'undeclared/application source continuation delta')\n    require(source_inventory(root)==after,'continuation source membership/content changed')\n    require(sha(base/'candidate.json')==marker['original_candidate_sha256'],'original candidate changed')\n    origin=read(base/'candidate.json')\n    for stage in marker['retained_completed_stages']:\n        require(stage!='command-C45-host-2','failed/affected Host stage cannot be retained')\n        folder=base/'stages'/stage;state=read(folder/'completed.json')\n        verify_completed(root,folder,state,state['argv'],digest(before),sha(base/'candidate.json'))\n    for check in marker['focused_checks']:\n        log=root/check['log'];require(sha(log)==check['log_sha256'] and check['exit_code']==0,'affected focused check failed/drifted')\n        require(check['source_sha256']==sha(root/'apps/desktop/src-tauri/tests/permission_manifest.rs'),'focused check source drift')\n    return marker\n\n\ndef retained(root,base,stage,argv):\n    if any((base/('continuation-%02d.json'%n)).exists() for n in (4,3,2)):\n        marker=verify_native_continuation(root,base)\n        entry=marker['retained_records'].get(stage)\n        if not entry:return None\n        folder=root/entry['folder'];state=read(folder/'completed.json')\n        require(state['argv']==argv,'retained command differs')\n        return folder,state,root/entry['candidate']['path']\n    if not (base/'continuation-01.json').exists():return None\n    marker=verify(root,base)\n    if stage not in marker['retained_completed_stages']:return None\n    folder=base/'stages'/stage;state=read(folder/'completed.json')\n    require(state['argv']==argv,'retained command differs')\n    return folder,state,base/'candidate.json'\n\n\ndef prepare(root):\n    base=root/'docs/planning/evidence/C45/baseline-03';folder=base/'continuation-01'\n    require(not folder.exists() and not (base/'continuation-01.json').exists(),'preserve prior continuation')\n    folder.mkdir();source=source_inventory(root);before=read(base/'source-seal.json')['files']\n    changed=sorted(n for n in set(before)|set(source) if before.get(n)!=source.get(n))\n    require(set(changed)<=ALLOWED,'application-affecting continuation not authorized by this policy')\n    old=read(base/'candidate.json');plan=copy.deepcopy(read(base/'required-coverage.json'))\n    completed=[]\n    for file in sorted((base/'stages').glob('*/completed.json')):\n        if file.parent.name=='command-C45-host-2':continue\n        state=read(file);veri