{"type":"item.completed","item":{"id":"item_56","type":"command_execution","command":"/bin/zsh -lc \"sed -n '145,210p' crates/xtask/tests/live_run/common.rs; sed -n '225,280p' crates/xtask/src/live.rs; rg -n 'live::check|live::load|check\\\\(.*manifest|manifest.*check' crates/xtask/src/live_run.rs; sed -n '1,175p' crates/xtask/tests/live_run/wizard.rs; sed -n '1,125p' crates/xtask/tests/live_run/reads.rs; nl -ba docs/architecture/checks.json | sed -n '3435,3495p'; nl -ba crates/xtask/src/live.rs | sed -n '21,30p'\"","aggregated_output":"        Evidence::Fixture(FixtureTargets {\n            extra_roots: vec![self.ca.pem.as_bytes().to_vec()],\n            management: self.management.clone(),\n            academy: self.academy.clone(),\n            settle: Some(Duration::from_secs(10)),\n        })\n    }\n\n    pub async fn run(\n        &self,\n        value: Value,\n        families: &[&str],\n        secrets: &Secrets,\n        operator: Arc<dyn Operator>,\n    ) -> (Repo, xtask::Result<RunRecord>) {\n        let repo = Repo::new(scratch());\n        let record = self.run_in(&repo, value, families, secrets, operator).await;\n        (repo, record)\n    }\n\n    /// One run in an existing repository, so that runs can follow each\n    /// other there.\n    pub async fn run_in(\n        &self,\n        repo: &Repo,\n        value: Value,\n        families: &[&str],\n        secrets: &Secrets,\n        operator: Arc<dyn Operator>,\n    ) -> xtask::Result<RunRecord> {\n        let manifest: LiveManifest = serde_json::from_value(value).expect(\"manifest\");\n        let families: Vec<String> = families.iter().map(|f| (*f).to_owned()).collect();\n        live_run::run(\n            repo,\n            &manifest,\n            \"f\".repeat(64).as_str(),\n            secrets,\n            operator,\n            self.evidence(),\n            &families,\n        )\n        .await\n    }\n}\n\npub fn receipt(repo: &Repo, family: &str, check: &str) -> CheckReceipt {\n    let path = repo.root().join(format!(\n        \"docs/planning/evidence/C25/live/{family}/{check}.json\"\n    ));\n    serde_json::from_slice(&std::fs::read(&path).unwrap_or_else(|_| panic!(\"receipt {check}\")))\n        .expect(\"receipt json\")\n}\n\npub fn outcomes(record: &RunRecord, family: &str) -> Vec<String> {\n    record\n        .families\n        .iter()\n        .find(|f| f.id == family)\n        .map(|f| f.checks.clone())\n        .unwrap_or_default()\n}\n\nfn every_file(dir: &Path, out: &mut Vec<PathBuf>) {\n    for entry in std::fs::read_dir(dir).expect(\"dir\").flatten() {\n        let path = entry.path();\n        if path.is_dir() {\n        failures.push(\"the owner approval is incomplete\".to_owned());\n    }\n    for (name, env) in &manifest.environments {\n        if env.kind != \"staging\" && env.kind != \"test\" {\n            failures.push(format!(\n                \"environment {name} is {}; only staging or test is allowed\",\n                env.kind\n            ));\n        }\n    }\n    let ids = families();\n    for id in &ids {\n        if !manifest.families.contains_key(id) {\n            failures.push(format!(\n                \"{id} is missing; an undesignated family is blocked, not omitted\"\n            ));\n        }\n    }\n    let known = known_families();\n    for (id, family) in &manifest.families {\n        if !known.contains(id) {\n            failures.push(format!(\"{id} is not a live family\"));\n            continue;\n        }\n        for (key, value) in &family.nonsecret {\n            if secret_name(key) {\n                failures.push(format!(\n                    \"{id} nonsecret {key} names a secret; use a credential reference\"\n                ));\n            } else if secret_value(value) {\n                failures.push(format!(\"{id} nonsecret {key} looks like a secret value\"));\n            }\n        }\n        for (name, secret) in &family.credentials {\n            match secret {\n                SecretRef::Keychain { service, account } => {\n                    if service == V1_SERVICE || !service.starts_with(V2_SERVICE_PREFIX) {\n                        failures.push(format!(\n                            \"{id} credential {name} names Keychain service {service}; only {V2_SERVICE_PREFIX}* test items\"\n                        ));\n                    }\n                    if account.trim().is_empty() {\n                        failures.push(format!(\"{id} credential {name} has no Keychain account\"));\n                    }\n                }\n                SecretRef::File { path } => {\n                    let p = Path::new(path);\n                    if !p.is_absolute() {\n                        failures.push(format!(\"{id} credential {name} file path is not absolute\"));\n                    } else if inside(repo, p) {\n                        failures.push(format!(\n                            \"{id} credential {name} file is inside the repository\"\n                        ));\n                    }\n                }\n            }\n6://! The runner refuses a manifest `live::check` rejects and every blocked\n1236:/// `evidence/C25/live/run.json`. Refuses a manifest `live::check` rejects\n1273:    let failures = live::check(repo, manifest);\n1468:    let (manifest, sha) = live::load(repo, scope)?;\n//! L19 belongs to the real wizard, never the general C25 live runner.\n\nuse serde_json::json;\nuse xtask::live;\n\nuse super::common::{Browser, Fixture, designate, manifest, secrets};\n\nfn wizard_only() -> serde_json::Value {\n    let mut value = manifest();\n    designate(\n        &mut value,\n        \"L19\",\n        json!({\n            \"environment\": \"test-b\",\n            \"credentials\": {\"client_secret\": super::common::keychain(\"wizard-not-resolved\")},\n            \"nonsecret\": {\"client_id\": \"wizard@example.test\", \"tsg_id\": \"1852583913\", \"region\": \"us\"},\n            \"permitted_operations\": [live::WIZARD_VERIFY_OPERATION],\n            \"budget\": {\"reads\": 2}\n        }),\n    );\n    value\n}\n\n#[tokio::test]\nasync fn an_optional_wizard_designation_never_enters_default_c25_execution() {\n    let (_, result) = Fixture::new()\n        .run(wizard_only(), &[], &secrets(&[]), Browser::idle())\n        .await;\n    let record = result.expect(\"L19 must not be dispatched by the default C25 run\");\n    assert!(record.families.is_empty());\n}\n\n#[tokio::test]\nasync fn explicitly_selecting_l19_refuses_before_resolving_its_secret() {\n    let (_, result) = Fixture::new()\n        .run(wizard_only(), &[\"L19\"], &secrets(&[]), Browser::idle())\n        .await;\n    let error = result.expect_err(\"L19 requires the native first-run wizard\");\n    assert!(\n        error\n            .to_string()\n            .contains(\"L19 requires the native first-run wizard\")\n    );\n}\n//! L02 management reads, L05 sessions, L06 Red Team/Model reads, L07\n//! Gateway reads and L10 operational observation against the synthetic\n//! cloud.\n\nuse std::sync::{Arc, Mutex};\n\nuse serde_json::{Value, json};\n\nuse crate::cloud::{Cloud, RED_TEAM_SCAN, Restricted, WS_A};\nuse crate::common::{\n    Browser, CLIENT_SECRET, Fixture, RESTRICTED_SECRET, assert_no_secret, designate,\n    management_family, management_secrets, manifest, outcomes, receipt, routed,\n};\nuse crate::support::TlsServer;\n\npub struct Served {\n    pub fixture: Fixture,\n    pub cloud: Arc<Mutex<Cloud>>,\n    pub server: TlsServer,\n}\n\npub async fn served(cloud: Cloud) -> Served {\n    let mut fixture = Fixture::new();\n    let cloud = Arc::new(Mutex::new(cloud));\n    let server = fixture.serve(routed(&cloud, Cloud::route)).await;\n    fixture.management = Some(format!(\"https://localhost:{}\", server.port));\n    Served {\n        fixture,\n        cloud,\n        server,\n    }\n}\n\nfn scope() -> Value {\n    let mut value = manifest();\n    designate(\n        &mut value,\n        \"L02\",\n        management_family(json!({\"nonsecret\": {\"restricted_denied_resource\": \"apiKeys\"}})),\n    );\n    designate(\n        &mut value,\n        \"L05\",\n        management_family(json!({\"nonsecret\": {\n        \"session_id\": \"ses-0\", \"session_app_id\": \"app-0\", \"session_app_name\": \"Bot 0\",\n        \"scan_id\": \"scn-ses-0-0\", \"reveal_content\": \"synthetic\"}})),\n    );\n    designate(\n        &mut value,\n        \"L06\",\n        management_family(json!({\"nonsecret\": {\"red_team_scan_id\": RED_TEAM_SCAN}})),\n    );\n    designate(\n        &mut value,\n        \"L07\",\n        management_family(\n            json!({\"nonsecret\": {\"workspace_id\": WS_A, \"restricted_denied_resource\": \"workspaces\"}}),\n        ),\n    );\n    designate(\n        &mut value,\n        \"L10\",\n        management_family(json!({\"nonsecret\": {\"workspace_id\": WS_A}})),\n    );\n    value\n}\n\n#[tokio::test(flavor = \"multi_thread\")]\nasync fn the_read_families_pass_through_the_production_management_intent() {\n    let s = served(Cloud::new()).await;\n    let (repo, record) = s\n        .fixture\n        .run(\n            scope(),\n            &[\"L02\", \"L05\", \"L06\", \"L07\", \"L10\"],\n            &management_secrets(&[]),\n            Browser::idle(),\n        )\n        .await;\n    let record = record.expect(\"run\");\n    for family in [\"L02\", \"L05\", \"L06\", \"L07\", \"L10\"] {\n        let checks = outcomes(&record, family);\n        assert!(\n            checks.iter().all(|c| c.ends_with(\": passed\")),\n            \"{family}: {checks:?}\"\n        );\n    }\n    assert!(record.passed(), \"{record:?}\");\n\n    let inventories = receipt(&repo, \"L02\", \"L02-inventories\");\n    assert_eq!(inventories.observed[\"pages\"][\"profiles\"][\"count\"], json!(3));\n    assert_eq!(\n        inventories.observed[\"pages\"][\"dataPatterns\"][\"result\"],\n        json!(\"page\")\n    );\n    let paging = receipt(&repo, \"L02\", \"L02-pagination\");\n    assert_eq!(paging.observed[\"first\"][\"next_offset\"], json!(1));\n    assert_eq!(paging.observed[\"second\"][\"offset\"], json!(1));\n    let denied = receipt(&repo, \"L02\", \"L02-least-privilege-denied\");\n    assert_eq!(denied.observed[\"read\"][\"failure\"], json!(\"denied\"));\n    assert_eq!(\n        receipt(&repo, \"L02\", \"L02-verify\").observed[\"scan_key_used\"],\n        json!(false)\n    );\n    // Content is revealed for the designated synthetic scan only, and only\n    // its length is kept.\n    let content = receipt(&repo, \"L05\", \"L05-content-reveal\");\n    assert_eq!(\n        content.observed[\"lengths\"][\"prompt_chars\"],\n        json!(\"SYNTHETIC-PROMPT-c25\".len())\n    );\n    assert_eq!(\n        receipt(&repo, \"L07\", \"L07-least-privilege-denied\").outcome,\n        \"passed\"\n    );\n    assert_eq!(\n        receipt(&repo, \"L10\", \"L10-gateway-observation\").observed[\"observations\"][\"usage\"][\"result\"],\n        json!(\"gateway\")\n    );\n    // Reads only: nothing was written to the cloud.\n    assert!(s.cloud.lock().expect(\"cloud\").writes.is_empty());\n    assert_no_secret(\n        &repo,\n        &[\n            CLIENT_SECRET,\n  3435\t        \"--\",\n  3436\t        \"native-prepare\",\n  3437\t        \"--chunk\",\n  3438\t        \"C45\",\n  3439\t        \"--target\",\n  3440\t        \"aarch64-apple-darwin\",\n  3441\t        \"--features\",\n  3442\t        \"test-fixtures\"\n  3443\t      ],\n  3444\t      \"native_acceptance\": \"ONE broad current identity/isolation/cleanup baseline: G11 mapped20 including restoredC32 plusC45-N01/N02/N03; all required assertion coverage accounted under docs/planning/verification-policy.md. Followup fixes/merge/P10 use affected verification and explicit exact-artifact or honest unaffected carry, not automatic full repetition.\",\n  3445\t      \"live_requirement\": \"no product endpoint calls; fixtures only\",\n  3446\t      \"host_commands\": [\n  3447\t        [\n  3448\t          \"cargo\",\n  3449\t          \"test\",\n  3450\t          \"--locked\",\n  3451\t          \"-p\",\n  3452\t          \"desktop-core\",\n  3453\t          \"--features\",\n  3454\t          \"test-fixtures\"\n  3455\t        ],\n  3456\t        [\n  3457\t          \"cargo\",\n  3458\t          \"test\",\n  3459\t          \"--locked\",\n  3460\t          \"-p\",\n  3461\t          \"desktop-host\",\n  3462\t          \"--features\",\n  3463\t          \"test-fixtures\",\n  3464\t          \"--\",\n  3465\t          \"--skip\",\n  3466\t          \"the_classic_login_keychain_api_is_available_read_only\",\n  3467\t          \"--skip\",\n  3468\t          \"records_round_trip_in_the_v2_namespace_without_touching_the_search_list\"\n  3469\t        ],\n  3470\t        [\n  3471\t          \"cargo\",\n  3472\t          \"test\",\n  3473\t          \"--locked\",\n  3474\t          \"-p\",\n  3475\t          \"xtask\",\n  3476\t          \"--lib\",\n  3477\t          \"--features\",\n  3478\t          \"test-fixtures\",\n  3479\t          \"--test\",\n  3480\t          \"shell_controller\"\n  3481\t        ]\n  3482\t      ],\n  3483\t      \"frontend_commands\": [\n  3484\t        [\n  3485\t          \"pnpm\",\n  3486\t          \"--filter\",\n  3487\t          \"@prisma-airs/desktop\",\n  3488\t          \"exec\",\n  3489\t          \"vitest\",\n  3490\t          \"run\",\n  3491\t          \"--config\",\n  3492\t          \"vitest.config.ts\"\n  3493\t        ],\n  3494\t        [\n  3495\t          \"pnpm\",\n    21\tpub const SCHEMA: &str = \"airs-v2/live-manifest/1\";\n    22\tpub const REPORT_SCHEMA: &str = \"airs-v2/live-scope/1\";\n    23\tpub const REPORT: &str = \"docs/planning/evidence/C25/live-scope.json\";\n    24\tconst LEDGER: &str = \"docs/architecture/workflow-ledger.json\";\n    25\t/// Keychain services a manifest may name: v2 test items only.\n    26\tpub const V2_SERVICE_PREFIX: &str = \"io.cdot.airs-desktop.\";\n    27\t/// v1's own Keychain service, which C25 never touches.\n    28\tpub const V1_SERVICE: &str = \"io.cdot.prisma-airs-desktop\";\n    29\tpub const NO_MANIFEST: &str = \"no owner-approved live manifest\";\n    30\tpub const WIZARD_VERIFY_FAMILY: &str = \"L19\";\n","exit_code":0,"status":"completed"}}
