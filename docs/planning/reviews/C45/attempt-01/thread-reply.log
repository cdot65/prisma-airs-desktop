{"type":"item.completed","item":{"id":"item_51","type":"command_execution","command":"/bin/zsh -lc \"git diff --unified=1 c8b804d3 -- crates/xtask/src/live.rs crates/xtask/src/live_scan.rs crates/xtask/src/lib.rs apps/desktop/index.html apps/desktop/package.json packages/desktop-contracts/package.json; sed -n '1,150p' crates/xtask/src/package.rs; sed -n '1,70p' crates/xtask/src/live.rs\"","aggregated_output":"diff --git a/apps/desktop/index.html b/apps/desktop/index.html\nindex 0e6dd50b..9ee379fd 100644\n--- a/apps/desktop/index.html\n+++ b/apps/desktop/index.html\n@@ -5,3 +5,3 @@\n     <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n-    <title>Prisma AIRS Desktop v2</title>\n+    <title>Prisma AIRS Desktop</title>\n   </head>\ndiff --git a/apps/desktop/package.json b/apps/desktop/package.json\nindex 7d14d2a9..291da68c 100644\n--- a/apps/desktop/package.json\n+++ b/apps/desktop/package.json\n@@ -2,3 +2,3 @@\n   \"name\": \"@prisma-airs/desktop\",\n-  \"version\": \"2.0.0\",\n+  \"version\": \"1.0.0\",\n   \"private\": true,\ndiff --git a/crates/xtask/src/lib.rs b/crates/xtask/src/lib.rs\nindex de8ae216..dc62a1da 100644\n--- a/crates/xtask/src/lib.rs\n+++ b/crates/xtask/src/lib.rs\n@@ -1,2 +1,2 @@\n-//! Build-time controller for Prisma AIRS Desktop v2.\n+//! Build-time controller for Prisma AIRS Desktop.\n //!\ndiff --git a/crates/xtask/src/live.rs b/crates/xtask/src/live.rs\nindex 90b74ab9..3688204f 100644\n--- a/crates/xtask/src/live.rs\n+++ b/crates/xtask/src/live.rs\n@@ -25,3 +25,3 @@ const LEDGER: &str = \"docs/architecture/workflow-ledger.json\";\n /// Keychain services a manifest may name: v2 test items only.\n-pub const V2_SERVICE_PREFIX: &str = \"io.cdot.prisma-airs-desktop.v2.\";\n+pub const V2_SERVICE_PREFIX: &str = \"io.cdot.airs-desktop.\";\n /// v1's own Keychain service, which C25 never touches.\ndiff --git a/crates/xtask/src/live_scan.rs b/crates/xtask/src/live_scan.rs\nindex 3cea398a..b43a096e 100644\n--- a/crates/xtask/src/live_scan.rs\n+++ b/crates/xtask/src/live_scan.rs\n@@ -16,3 +16,3 @@ use crate::{Result, invalid, now_utc};\n const DEFAULT_PROMPT: &str =\n-    \"Prisma AIRS Desktop v2 controlled live check: a synthetic benign prompt.\";\n+    \"Prisma AIRS Desktop controlled live check: a synthetic benign prompt.\";\n \ndiff --git a/packages/desktop-contracts/package.json b/packages/desktop-contracts/package.json\nindex b39df70f..a7d022a6 100644\n--- a/packages/desktop-contracts/package.json\n+++ b/packages/desktop-contracts/package.json\n@@ -2,3 +2,3 @@\n   \"name\": \"@prisma-airs/desktop-contracts\",\n-  \"version\": \"2.0.0\",\n+  \"version\": \"1.0.0\",\n   \"private\": true,\n//! Package gates. Neither kind uploads or publishes anything.\n//!\n//! * preview: only completed chunks may be advertised; every other feature\n//!   must stay visibly unavailable in the build.\n//! * release-candidate: requires C01–C25 completed; C26 adds the signed,\n//!   notarized, stapled and installed-byte validators.\n\nuse crate::complete::{is_completed, read_ledger};\nuse crate::{Repo, Result, Subject, invalid};\n\n#[derive(Clone, Copy, Debug, PartialEq, Eq)]\npub enum Kind {\n    Preview,\n    ReleaseCandidate,\n}\n\nimpl Kind {\n    pub fn parse(text: &str) -> Result<Self> {\n        match text {\n            \"preview\" => Ok(Self::Preview),\n            \"release-candidate\" => Ok(Self::ReleaseCandidate),\n            other => Err(invalid(format!(\"unknown package kind {other}\"))),\n        }\n    }\n}\n\n/// Completed chunks, in order, from the append-only ledger.\npub fn completed_chunks(repo: &Repo) -> Result<Vec<Subject>> {\n    let entries = read_ledger(&repo.completion_ledger())?;\n    Ok((1..=Subject::LAST_CHUNK)\n        .map(Subject::Chunk)\n        .filter(|s| is_completed(repo, &entries, *s))\n        .collect())\n}\n\npub fn gate(repo: &Repo, kind: Kind) -> Result<Vec<Subject>> {\n    let completed = completed_chunks(repo)?;\n    match kind {\n        Kind::Preview => {\n            if completed.is_empty() {\n                return Err(invalid(\n                    \"a preview package needs at least one completed chunk\",\n                ));\n            }\n            // Completion must be a contiguous prefix: no skipped predecessor.\n            for (i, subject) in completed.iter().enumerate() {\n                if *subject != Subject::Chunk(i as u8 + 1) {\n                    return Err(invalid(\"completed chunks are not a contiguous prefix\"));\n                }\n            }\n            Ok(completed)\n        }\n        Kind::ReleaseCandidate => {\n            let missing: Vec<String> = (1..=25u8)\n                .map(Subject::Chunk)\n                .filter(|s| !completed.contains(s))\n                .map(|s| s.to_string())\n                .collect();\n            if !missing.is_empty() {\n                return Err(invalid(format!(\n                    \"release-candidate requires C01-C25 completed; missing {}\",\n                    missing.join(\", \")\n                )));\n            }\n            verify_current_release_phases(repo)?;\n            Ok(completed)\n        }\n    }\n}\n\n/// P09/P10 actual independent phase proofs supplement the existing C01-C25\n/// ledger. C26 remains open so its own release implementation is not circular.\npub fn verify_current_release_phases(repo: &Repo) -> Result<()> {\n    let output = std::process::Command::new(\"/usr/bin/python3\")\n        .args([\"-I\", \"tools/p10/review_gate.py\", \"release-prerequisites\"])\n        .current_dir(repo.root())\n        .env_clear()\n        .env(\"PATH\", crate::git_path())\n        .output()\n        .map_err(crate::io_err(&repo.join(\"tools/p10/review_gate.py\")))?;\n    if !output.status.success() {\n        return Err(invalid(format!(\n            \"release requires genuine audited P09 and P10 full-9 phase proofs: {}\",\n            String::from_utf8_lossy(&output.stderr)\n        )));\n    }\n    Ok(())\n}\n//! The controlled live scope (C25): the owner-approved private execution\n//! manifest and the access report derived from it.\n//!\n//! The manifest names accounts, environments, permitted operations, budgets\n//! and cleanup for the default families L01–L18 and optional C29 family L19\n//! (`docs/planning/live-checks.md`,\n//! `release-contract.md`). It lives outside the repository, readable only by\n//! its owner, and names each secret by where it is stored, never by value.\n//! Validation never resolves a secret. A family without designated access is\n//! blocked, never dropped: every required workflow row reports which of its\n//! families are blocked.\n\nuse std::collections::BTreeMap;\nuse std::path::Path;\n\nuse serde::{Deserialize, Serialize};\n\nuse crate::ledger::Ledger;\nuse crate::{Repo, Result, invalid, io_err, now_utc, read_json, sha256_hex, write_json};\n\npub const SCHEMA: &str = \"airs-v2/live-manifest/1\";\npub const REPORT_SCHEMA: &str = \"airs-v2/live-scope/1\";\npub const REPORT: &str = \"docs/planning/evidence/C25/live-scope.json\";\nconst LEDGER: &str = \"docs/architecture/workflow-ledger.json\";\n/// Keychain services a manifest may name: v2 test items only.\npub const V2_SERVICE_PREFIX: &str = \"io.cdot.airs-desktop.\";\n/// v1's own Keychain service, which C25 never touches.\npub const V1_SERVICE: &str = \"io.cdot.prisma-airs-desktop\";\npub const NO_MANIFEST: &str = \"no owner-approved live manifest\";\npub const WIZARD_VERIFY_FAMILY: &str = \"L19\";\npub const WIZARD_VERIFY_OPERATION: &str = \"one management credential verification through the first-run wizard (C29): one latest security-profile probe with limit=1; discard profile contents; no other inventory browsing or writes\";\n\n/// Families whose operations change remote state: each needs disposable\n/// names and cleanup.\npub const MUTATING: [&str; 5] = [\"L03\", \"L04\", \"L08\", \"L13\", \"L17\"];\n/// Families that consume scans, inference or assessments: each needs a\n/// budget.\npub const CONSUMING: [&str; 5] = [\"L01\", \"L09\", \"L12\", \"L13\", \"L16\"];\n\npub fn families() -> Vec<String> {\n    (1..=18).map(|n| format!(\"L{n:02}\")).collect()\n}\n\n/// C25's default execution set remains L01–L18. L19 is an optional, separately\n/// designated C29 wizard probe; recognizing it never makes it a C25 live run.\npub fn known_families() -> Vec<String> {\n    let mut known = families();\n    known.push(WIZARD_VERIFY_FAMILY.to_owned());\n    known\n}\n\nfn check_wizard_family(family: &Family, failures: &mut Vec<String>) {\n    if family.environment != \"test-b\" {\n        failures.push(\"L19 requires test-b (Vulture)\".to_owned());\n    }\n    if family.permitted_operations != [WIZARD_VERIFY_OPERATION] {\n        failures.push(\"L19 permits only the bounded wizard management verification\".to_owned());\n    }\n    if family.budget.len() != 1 || !matches!(family.budget.get(\"reads\"), Some(1 | 2)) {\n        failures.push(\n            \"L19 requires a read budget of one or two and no other service budget\".to_owned(),\n        );\n    }\n    if family.credentials.len() != 1\n        || !matches!(\n            family.credentials.get(\"client_secret\"),\n            Some(SecretRef::Keychain { .. })\n        )\n    {\n        failures.push(\"L19 requires one client_secret Keychain reference\".to_owned());\n","exit_code":0,"status":"completed"}}
