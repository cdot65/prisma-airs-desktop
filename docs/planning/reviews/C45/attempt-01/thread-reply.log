tecture/checks.json:2749:        \"test-fixtures\"\ndocs/architecture/checks.json:2761:          \"test-fixtures\"\ndocs/architecture/checks.json:2770:          \"test-fixtures\"\ndocs/architecture/checks.json:2795:        \"test-fixtures\",\ndocs/architecture/checks.json:2812:        \"test-fixtures\"\ndocs/architecture/checks.json:2824:          \"test-fixtures\"\ndocs/architecture/checks.json:2833:          \"test-fixtures\"\ndocs/architecture/checks.json:2858:        \"test-fixtures\",\ndocs/architecture/checks.json:2875:        \"test-fixtures\"\ndocs/architecture/checks.json:2887:          \"test-fixtures\"\ndocs/architecture/checks.json:2896:          \"test-fixtures\"\ndocs/architecture/checks.json:2921:        \"test-fixtures\",\ndocs/architecture/checks.json:2938:        \"test-fixtures\"\ndocs/architecture/checks.json:2950:          \"test-fixtures\"\ndocs/architecture/checks.json:2959:          \"test-fixtures\"\ndocs/architecture/checks.json:2984:        \"test-fixtures\",\ndocs/architecture/checks.json:3001:        \"test-fixtures\"\ndocs/architecture/checks.json:3013:          \"test-fixtures\"\ndocs/architecture/checks.json:3022:          \"test-fixtures\"\ndocs/architecture/checks.json:3047:        \"test-fixtures\",\ndocs/architecture/checks.json:3064:        \"test-fixtures\"\ndocs/architecture/checks.json:3076:          \"test-fixtures\"\ndocs/architecture/checks.json:3085:          \"test-fixtures\"\ndocs/architecture/checks.json:3110:        \"test-fixtures\",\ndocs/architecture/checks.json:3127:        \"test-fixtures\"\ndocs/architecture/checks.json:3139:          \"test-fixtures\"\ndocs/architecture/checks.json:3148:          \"test-fixtures\"\ndocs/architecture/checks.json:3173:        \"test-fixtures\",\ndocs/architecture/checks.json:3190:        \"test-fixtures\"\ndocs/architecture/checks.json:3202:          \"test-fixtures\"\ndocs/architecture/checks.json:3211:          \"test-fixtures\"\ndocs/architecture/checks.json:3236:        \"test-fixtures\",\ndocs/architecture/checks.json:3253:        \"test-fixtures\"\ndocs/architecture/checks.json:3265:          \"test-fixtures\"\ndocs/architecture/checks.json:3274:          \"test-fixtures\"\ndocs/architecture/checks.json:3299:        \"test-fixtures\",\ndocs/architecture/checks.json:3316:        \"test-fixtures\"\ndocs/architecture/checks.json:3328:          \"test-fixtures\"\ndocs/architecture/checks.json:3337:          \"test-fixtures\"\ndocs/architecture/checks.json:3362:        \"test-fixtures\",\ndocs/architecture/checks.json:3379:        \"test-fixtures\"\ndocs/architecture/checks.json:3391:          \"test-fixtures\"\ndocs/architecture/checks.json:3400:          \"test-fixtures\"\ndocs/architecture/checks.json:3425:        \"test-fixtures\",\ndocs/architecture/checks.json:3442:        \"test-fixtures\"\ndocs/architecture/checks.json:3454:          \"test-fixtures\"\ndocs/architecture/checks.json:3463:          \"test-fixtures\",\ndocs/architecture/checks.json:3478:          \"test-fixtures\",\ndocs/architecture/checks.json:3587:    \"test-fixtures\"\n//! The C25 controlled live runner against synthetic TLS services on this\n//! Mac: the production core is driven exactly as for a live run, but every\n//! receipt is recorded as `fixture` evidence. Secrets come from an\n//! in-memory resolver and browser steps from a stand-in operator; no\n//! Keychain item is read and no product endpoint is called.\n\n#[allow(dead_code)]\n#[path = \"../../../desktop-core/tests/context_credentials/support.rs\"]\nmod support;\n\nmod cloud;\n\n/// What the shared MCP fixture expects of its desk.\nmod desk {\n    pub const DATA: &str = crate::cloud::DATA;\n}\n\nmod common;\n#[allow(dead_code)]\n#[path = \"../../../desktop-core/tests/workspace_mcp/fixture.rs\"]\nmod mcp_fixture;\n\nmod academy;\nmod changes;\nmod inference;\nmod mcp;\nmod reads;\nmod scan;\nmod wizard;\nmod workbench;\n    let rows: Vec<RowAccess> = ledger\n        .rows\n        .iter()\n        .filter(|r| r.live.requirement == \"required\")\n        .map(|r| {\n            let fams = row_families(&r.live_column);\n            let blocked: Vec<String> = fams.iter().filter(|f| !designated(f)).cloned().collect();\n            let (access_status, owner) = if fams.is_empty() {\n                (\"final-artifact\".to_owned(), Some(\"C26\".to_owned()))\n            } else if blocked.is_empty() {\n                (\"designated\".to_owned(), None)\n            } else {\n                (\"blocked-by-access\".to_owned(), None)\n            };\n            RowAccess {\n                id: r.id.clone(),\n                workflow: r.workflow.clone(),\n                families: fams,\n                access_status,\n                blocked_families: blocked,\n                owner,\n            }\n        })\n        .collect();\n    let count = |s: &str| rows.iter().filter(|r| r.access_status == s).count();\n    let summary = Summary {\n        families_designated: families.iter().filter(|f| f.status == \"designated\").count(),\n        families_blocked: families.iter().filter(|f| f.status != \"designated\").count(),\n        rows_required: rows.len(),\n        rows_designated: count(\"designated\"),\n        rows_blocked: count(\"blocked-by-access\"),\n        rows_owned_by_c26: count(\"final-artifact\"),\n    };\n    Report {\n        schema: REPORT_SCHEMA.to_owned(),\n        generated_utc: now_utc(),\n        manifest_sha256: scope.map(|(_, sha)| sha.to_owned()),\n        owner_approval: scope.map(|(m, _)| m.owner_approval.clone()),\n        families,\n        rows,\n        summary,\n    }\n}\n\n/// Validates the scope (if any) and writes the C25 access report.\npub fn run(repo: &Repo, scope: Option<&Path>) -> Result<Report> {\n//! C26 signed-artifact controls on a synthetic bundle, with ad-hoc\n//! signatures (no certificate, no network): the release signing refuses an\n//! engine that is not the pin before it signs anything, never changes the\n//! engine's bytes, records each stage's hashes, and a signed bundle no\n//! longer verifies once any of its files changes.\n\nuse std::path::{Path, PathBuf};\n\nuse sha2::{Digest, Sha256};\nuse xtask::signing::{AD_HOC, Release, execute, sign_engine, verify};\n\nfn scratch(name: &str) -> PathBuf {\n    let dir = std::env::temp_dir()\n        .canonicalize()\n        .expect(\"temp\")\n        .join(format!(\n            \"airs-v2-signed-artifact-{name}-{}\",\n            std::process::id()\n        ));\n    let _ = std::fs::remove_dir_all(&dir);\n    std::fs::create_dir_all(&dir).expect(\"scratch\");\n    dir\n}\n\nfn sha256(path: &Path) -> String {\n    hex::encode(Sha256::digest(std::fs::read(path).expect(\"read\")))\n}\n\n/// A Mach-O to sign: a copy of a system tool.\nfn macho(path: &Path) {\n    std::fs::create_dir_all(path.parent().expect(\"parent\")).expect(\"dir\");\n    std::fs::copy(\"/usr/bin/true\", path).expect(\"copy\");\n}\n\n/// A minimal app bundle whose engine is signed at \"sealing\" (ad hoc) and\n/// whose pin is that signed engine's hash.\nfn bundle(dir: &Path) -> (PathBuf, String) {\n    let app = dir.join(\"Fake.app\");\n    std::fs::create_dir_all(app.join(\"Contents/Resources\")).expect(\"bundle\");\n    std::fs::write(\n        app.join(\"Contents/Info.plist\"),\n        r#\"<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<!DOCTYPE plist PUBLIC \"-//Apple//DTD PLIST 1.0//EN\" \"http://www.apple.com/DTDs/PropertyList-1.0.dtd\">\n<plist version=\"1.0\"><dict>\n<key>CFBundleExecutable</key><string>fake</string>\n<key>CFBundleIdentifier</key><string>io.cdot.prisma-airs-desktop.v2.signed-artifact-test</string>\n<key>CFBundlePackageType</key><string>APPL</string>\n</dict></plist>\n\"#,\n    )\n    .expect(\"plist\");\n    std::fs::write(\n        app.join(\"Contents/Resources/notice.txt\"),\n        b\"synthetic resource\\n\",\n    )\n    .expect(\"resource\");\n    macho(&app.join(\"Contents/MacOS/fake\"));\n    let unsigned = dir.join(\"unsigned/airs-harness\");\n    macho(&unsigned);\n    let staged = dir.join(\"staged\");\n    let signed = sign_engine(&unsigned, &sha256(&unsigned), &staged, AD_HOC).expect(\"engine\");\n    let engine = app.join(\"Contents/Resources/harness/airs-harness\");\n    std::fs::create_dir_all(engine.parent().expect(\"parent\")).expect(\"dir\");\n    std::fs::copy(staged.join(\"airs-harness\"), &engine).expect(\"bundle engine\");\n    assert_eq!(sha256(&engine), signed.signed_sha256);\n    (app, signed.signed_sha256)\n}\n\nfn release(app: &Path, dir: &Path) -> Release {\n    Release {\n        app: app.to_path_buf(),\n        executable: \"fake\".to_owned(),\n        dmg: dir.join(\"Fake.dmg\"),\n        volume: \"Fake\".to_owned(),\n        identity: AD_HOC.to_owned(),\n        profile: \"prisma-airs-desktop\".to_owned(),\n    }\n}\n\n#[test]\nfn an_engine_that_is_not_the_pin_is_refused_before_anything_is_signed() {\n    let dir = scratch(\"unpinned\");\n    let (app, _) = bundle(&dir);\n    let exe = app.join(\"Contents/MacOS/fake\");\n    let before = sha256(&exe);\n    let err = execute(&release(&app, &dir), &\"0\".repeat(64), false).expect_err(\"refused\");\n    assert!(err.to_string().contains(\"not the pinned engine\"), \"{err}\");\n    assert_eq!(sha256(&exe), before, \"the executable was not signed\");\n    let _ = std::fs::remove_dir_all(&dir);\n}\n\n#[test]\nfn signing_records_every_stage_and_never_changes_the_engine() {\n    let dir = scratch(\"stages\");\n    let (app, pin) = bundle(&dir);\n    let record = execute(&release(&app, &dir), &pin, false).expect(\"signed\");\n    verify(&app).expect(\"the signed app verifies\");\n    assert_eq!(\n        record.before_signing.engine_sha256.as_deref(),\n        Some(pin.as_str())\n    );\n    assert_eq!(\n        record.after_signing.engine_sha256.as_deref(),\n        Some(pin.as_str())\n    );\n    assert_ne!(\n        record.before_signing.executable_sha256, record.after_signing.executable_sha256,\n        \"the main executable was signed\"\n    );\n    assert_ne!(\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_54","type":"command_execution","command":"/bin/zsh -lc \"rg -n 'V2_SERVICE_PREFIX|service\\\\.starts_with|check_secret|secret_ref|keychain' crates/xtask/src/live.rs; sed -n '1,205p' crates/xtask/tests/controlled_live.rs; sed -n '1,155p' crates/xtask/tests/live_run/common.rs; sed -n '325,375p' crates/xtask/tests/controlled_live.rs; sed -n '440,485p' crates/xtask/tests/controlled_live.rs; cat crates/xtask/Cargo.toml\"","aggregated_output":"26:pub const V2_SERVICE_PREFIX: &str = \"io.cdot.airs-desktop.\";\n117:            Self::Keychain { service, account } => format!(\"keychain:{service}/{account}\"),\n261:                    if service == V1_SERVICE || !service.starts_with(V2_SERVICE_PREFIX) {\n263:                            \"{id} credential {name} names Keychain service {service}; only {V2_SERVICE_PREFIX}* test items\"\n//! Adversarial tests for the C25 controlled live scope.\n//!\n//! A complete owner-approved manifest passes. Each case breaks one rule, so\n//! every rejection below is caused by the single mutation it names. No test\n//! resolves a secret reference or calls a service.\n\nuse std::path::{Path, PathBuf};\nuse std::sync::atomic::{AtomicUsize, Ordering};\n\nuse serde_json::{Value, json};\nuse xtask::Repo;\nuse xtask::ledger::Ledger;\nuse xtask::live::{self, LiveManifest};\n\nstatic NEXT: AtomicUsize = AtomicUsize::new(0);\n\nfn repo() -> Repo {\n    Repo::discover()\n}\n\nfn scratch() -> PathBuf {\n    let dir = std::env::temp_dir().join(format!(\n        \"airs-v2-controlled-live-{}-{}\",\n        std::process::id(),\n        NEXT.fetch_add(1, Ordering::SeqCst)\n    ));\n    std::fs::create_dir_all(&dir).expect(\"scratch dir\");\n    dir\n}\n\nfn keychain(account: &str) -> Value {\n    json!({\"kind\": \"keychain\", \"service\": \"io.cdot.prisma-airs-desktop.v2.c25\", \"account\": account})\n}\n\n/// Every family designated, the mutating ones with names and cleanup, the\n/// consuming ones with budgets, L18 in its own environment.\nfn baseline() -> Value {\n    let mut families = serde_json::Map::new();\n    for id in live::families() {\n        let isolated = id == \"L18\";\n        let mut family = json!({\n            \"status\": \"designated\",\n            \"environment\": if isolated { \"test-b\" } else { \"staging-a\" },\n            \"credentials\": {\"primary\": keychain(&format!(\"{id}-{}\", if isolated { \"b\" } else { \"a\" }))},\n            \"nonsecret\": {\"endpoint\": \"https://service.example.test/api\", \"tsg_id\": \"1234567890\", \"client_id\": \"0b4f6a3e-2c1d-4e5f-8a9b-7c6d5e4f3a2b\"},\n            \"permitted_operations\": [\"read\"],\n            \"irreversible_exclusions\": [\"production tenants\"]\n        });\n        if live::MUTATING.contains(&id.as_str()) {\n            family[\"disposable_prefix\"] = json!(\"airs-v2-c25-\");\n            family[\"cleanup\"] =\n                json!([\"delete every airs-v2-c25- resource and read back its absence\"]);\n        }\n        if live::CONSUMING.contains(&id.as_str()) {\n            family[\"budget\"] = json!({\"requests\": 50});\n        }\n        families.insert(id, family);\n    }\n    json!({\n        \"schema\": live::SCHEMA,\n        \"owner_approval\": {\"approved_by\": \"owner\", \"approved_utc\": \"2026-10-25T00:00:00Z\", \"decision\": \"D0xx\"},\n        \"environments\": {\"staging-a\": {\"kind\": \"staging\"}, \"test-b\": {\"kind\": \"test\"}},\n        \"families\": families\n    })\n}\n\nfn failures(value: &Value) -> Vec<String> {\n    let manifest: LiveManifest = serde_json::from_value(value.clone()).expect(\"manifest parses\");\n    live::check(&repo(), &manifest)\n}\n\nfn rejected(edit: impl FnOnce(&mut Value), needle: &str) {\n    let mut value = baseline();\n    edit(&mut value);\n    let found = failures(&value);\n    assert!(\n        found.iter().any(|f| f.contains(needle)),\n        \"expected a failure containing {needle:?}, got {found:?}\"\n    );\n}\n\nfn write_private(dir: &Path, value: &Value, mode: u32) -> PathBuf {\n    use std::os::unix::fs::PermissionsExt;\n    let path = dir.join(\"live-manifest.json\");\n    std::fs::write(&path, serde_json::to_vec_pretty(value).expect(\"fixture\")).expect(\"fixture\");\n    std::fs::set_permissions(&path, std::fs::Permissions::from_mode(mode)).expect(\"fixture\");\n    path\n}\n\nfn ledger() -> Ledger {\n    let path = repo().join(\"docs/architecture/workflow-ledger.json\");\n    serde_json::from_slice(&std::fs::read(path).expect(\"fixture\")).expect(\"fixture\")\n}\n\n#[test]\nfn a_complete_private_manifest_passes() {\n    assert_eq!(failures(&baseline()), Vec::<String>::new());\n    let path = write_private(&scratch(), &baseline(), 0o600);\n    let (_, sha) = live::load(&repo(), &path).expect(\"baseline loads\");\n    assert_eq!(sha.len(), 64);\n}\n\n#[test]\nfn the_manifest_must_be_approved_and_current() {\n    rejected(\n        |v| v[\"owner_approval\"][\"approved_by\"] = json!(\"\"),\n        \"owner approval is incomplete\",\n    );\n    rejected(\n        |v| v[\"owner_approval\"][\"decision\"] = json!(\" \"),\n        \"owner approval is incomplete\",\n    );\n    rejected(\n        |v| v[\"schema\"] = json!(\"airs-v2/live-manifest/0\"),\n        \"is not airs-v2/live-manifest/1\",\n    );\n}\n\n#[test]\nfn production_is_never_an_environment() {\n    rejected(\n        |v| v[\"environments\"][\"staging-a\"][\"kind\"] = json!(\"production\"),\n        \"only staging or test\",\n    );\n}\n\n#[test]\nfn every_family_is_present_and_a_blocked_one_says_why() {\n    rejected(\n        |v| {\n            v[\"families\"]\n                .as_object_mut()\n                .expect(\"fixture\")\n                .remove(\"L05\");\n        },\n        \"L05 is missing\",\n    );\n    rejected(\n        |v| v[\"families\"][\"L20\"] = v[\"families\"][\"L01\"].clone(),\n        \"L20 is not a live family\",\n    );\n    rejected(\n        |v| v[\"families\"][\"L06\"] = json!({\"status\": \"blocked\", \"reason\": \"\"}),\n        \"L06 is blocked without a reason\",\n    );\n    rejected(\n        |v| v[\"families\"][\"L06\"][\"status\"] = json!(\"skipped\"),\n        \"L06 status skipped\",\n    );\n    let mut value = baseline();\n    value[\"families\"][\"L06\"] = json!({\"status\": \"blocked\", \"reason\": \"no seeded Red Team records\"});\n    assert_eq!(failures(&value), Vec::<String>::new());\n}\n\nconst WIZARD_VERIFY: &str = \"one management credential verification through the first-run wizard (C29): one latest security-profile probe with limit=1; discard profile contents; no other inventory browsing or writes\";\n\nfn with_l19() -> Value {\n    let mut value = baseline();\n    value[\"families\"][\"L19\"] = json!({\n        \"status\": \"designated\", \"environment\": \"test-b\",\n        \"credentials\": {\"client_secret\": keychain(\"fixture-vulture-management\")},\n        \"nonsecret\": {\"client_id\": \"0b4f6a3e-2c1d-4e5f-8a9b-7c6d5e4f3a2b\", \"tsg_id\": \"1852583913\", \"region\": \"us\"},\n        \"permitted_operations\": [WIZARD_VERIFY], \"budget\": {\"reads\": 2},\n        \"cleanup\": [], \"irreversible_exclusions\": [\"no changes on Vulture\"]\n    });\n    value\n}\n\n#[test]\nfn l19_is_an_optional_explicit_wizard_designation_without_changing_c25_defaults() {\n    assert!(\n        failures(&baseline()).is_empty(),\n        \"existing 18-family manifests remain valid\"\n    );\n    assert!(\n        failures(&with_l19()).is_empty(),\n        \"the designated read-only wizard family is recognized\"\n    );\n    let mut one_read = with_l19();\n    one_read[\"families\"][\"L19\"][\"budget\"][\"reads\"] = json!(1);\n    assert!(failures(&one_read).is_empty());\n    assert_eq!(\n        live::families().len(),\n        18,\n        \"C25's default live execution set is unchanged\"\n    );\n    let old: LiveManifest = serde_json::from_value(baseline()).expect(\"fixture\");\n    let report = live::report(&ledger(), Some((&old, \"fixture-sha\")));\n    let row = report\n        .families\n        .iter()\n        .find(|f| f.id == \"L19\")\n        .expect(\"L19 is visible even without access\");\n    assert_eq!(row.status, \"blocked\");\n}\n\n#[test]\nfn l19_rejects_scope_expansion_and_incomplete_credentials() {\n    assert!(failures(&with_l19()).is_empty(), \"positive control\");\n    let cases: Vec<(Value, &str, &str)> = vec![\n        (json!(\"staging-a\"), \"environment\", \"L19 requires test-b\"),\n        (json!([\"write\"]), \"permitted_operations\", \"L19 permits only\"),\n        (json!({\"reads\": 0}), \"budget\", \"L19 requires a read budget\"),\n        (json!({\"reads\": 3}), \"budget\", \"L19 requires a read budget\"),\n        (\n//! Shared fixtures: an in-memory secret resolver, a stand-in operator, a\n//! manifest builder and receipt helpers.\n\nuse std::collections::BTreeMap;\nuse std::path::{Path, PathBuf};\nuse std::sync::atomic::{AtomicUsize, Ordering};\nuse std::sync::{Arc, Mutex};\nuse std::time::Duration;\n\nuse serde_json::{Value, json};\nuse xtask::Repo;\nuse xtask::live::{self, LiveManifest, SecretRef};\nuse xtask::live_adapters::Operator;\nuse xtask::live_run::{self, CheckReceipt, Evidence, FixtureTargets, Resolve, RunRecord};\nuse zeroize::Zeroizing;\n\nuse crate::support::{Reply, Seen, TestCa, TlsServer};\n\nstatic NEXT: AtomicUsize = AtomicUsize::new(0);\n\npub fn scratch() -> PathBuf {\n    let dir = std::env::temp_dir().join(format!(\n        \"airs-v2-live-run-{}-{}\",\n        std::process::id(),\n        NEXT.fetch_add(1, Ordering::SeqCst)\n    ));\n    std::fs::create_dir_all(&dir).expect(\"scratch\");\n    dir\n}\n\n/// Secrets by Keychain account, held only by the test.\npub struct Secrets(pub BTreeMap<String, String>);\n\nimpl Resolve for Secrets {\n    fn resolve(&self, reference: &SecretRef) -> xtask::Result<Zeroizing<String>> {\n        let SecretRef::Keychain { account, .. } = reference else {\n            panic!(\"tests use keychain references only\");\n        };\n        Ok(Zeroizing::new(\n            self.0.get(account).expect(\"known account\").clone(),\n        ))\n    }\n}\n\npub fn secrets(pairs: &[(&str, &str)]) -> Secrets {\n    Secrets(\n        pairs\n            .iter()\n            .map(|(a, v)| ((*a).to_owned(), (*v).to_owned()))\n            .collect(),\n    )\n}\n\npub fn keychain(account: &str) -> Value {\n    json!({\"kind\": \"keychain\", \"service\": \"io.cdot.prisma-airs-desktop.v2.c25\", \"account\": account})\n}\n\ntype Prompted = dyn Fn(&str, Option<&url::Url>) + Send + Sync;\n\n/// The operator stand-in: records each prompt and acts like the person in\n/// the browser (through `act`).\npub struct Browser {\n    pub prompts: Mutex<Vec<(String, Option<String>)>>,\n    act: Box<Prompted>,\n}\n\nimpl Browser {\n    pub fn new(act: impl Fn(&str, Option<&url::Url>) + Send + Sync + 'static) -> Arc<Self> {\n        Arc::new(Self {\n            prompts: Mutex::new(Vec::new()),\n            act: Box::new(act),\n        })\n    }\n\n    pub fn idle() -> Arc<Self> {\n        Self::new(|_, _| {})\n    }\n\n    pub fn prompts(&self) -> Vec<(String, Option<String>)> {\n        self.prompts.lock().expect(\"prompts\").clone()\n    }\n}\n\nimpl Operator for Browser {\n    fn prompt(&self, instruction: &str, url: Option<&url::Url>) {\n        self.prompts\n            .lock()\n            .expect(\"prompts\")\n            .push((instruction.to_owned(), url.map(|u| u.to_string())));\n        (self.act)(instruction, url);\n    }\n}\n\n/// Every family blocked; tests designate the ones they drive.\npub fn manifest() -> Value {\n    let mut families = serde_json::Map::new();\n    for id in live::families() {\n        families.insert(\n            id.clone(),\n            json!({\"status\": \"blocked\", \"reason\": \"not designated in this fixture\"}),\n        );\n    }\n    json!({\n        \"schema\": live::SCHEMA,\n        \"owner_approval\": {\"approved_by\": \"owner\", \"approved_utc\": \"2026-10-25T00:00:00Z\", \"decision\": \"fixture\"},\n        \"environments\": {\"staging-a\": {\"kind\": \"staging\"}, \"test-b\": {\"kind\": \"test\"}},\n        \"families\": families\n    })\n}\n\npub fn designate(manifest: &mut Value, id: &str, mut family: Value) {\n    family[\"status\"] = json!(\"designated\");\n    if family.get(\"environment\").is_none() {\n        family[\"environment\"] = json!(\"staging-a\");\n    }\n    if family.get(\"permitted_operations\").is_none() {\n        family[\"permitted_operations\"] = json!([\"read\"]);\n    }\n    if family.get(\"irreversible_exclusions\").is_none() {\n        family[\"irreversible_exclusions\"] = json!([\"production tenants\"]);\n    }\n    manifest[\"families\"][id] = family;\n}\n\npub struct Fixture {\n    pub ca: TestCa,\n    pub management: Option<String>,\n    pub academy: Option<String>,\n}\n\nimpl Fixture {\n    pub fn new() -> Self {\n        Self {\n            ca: TestCa::new(\"airs-v2 c25 ca\"),\n            management: None,\n            academy: None,\n        }\n    }\n\n    pub async fn serve(&self, reply: Reply) -> TlsServer {\n        TlsServer::start(self.ca.leaf(&[\"localhost\"]), reply).await\n    }\n\n    pub fn evidence(&self) -> Evidence {\n        Evidence::Fixture(FixtureTargets {\n            extra_roots: vec![self.ca.pem.as_bytes().to_vec()],\n            management: self.management.clone(),\n            academy: self.academy.clone(),\n            settle: Some(Duration::from_secs(10)),\n        })\n    }\n\n    pub async fn run(\n        &self,\n        value: Value,\n        |v| {\n            v[\"families\"][\"L01\"][\"nonsecret\"][\"note\"] =\n                json!(\"eyJhbGciOiJIUzI1NiJ9.eyJzdWIiOiJ4In0.c2ln\")\n        },\n        \"L01 nonsecret note looks like a secret value\",\n    );\n    rejected(\n        |v| {\n            v[\"families\"][\"L01\"][\"nonsecret\"][\"note\"] =\n                json!(\"Zk9xR2pLbTNuQjV2QzhYejFXcTRUeTdVaTBPcA\")\n        },\n        \"L01 nonsecret note looks like a secret value\",\n    );\n    rejected(\n        |v| v[\"families\"][\"L02\"][\"nonsecret\"][\"client_secret\"] = json!(\"x\"),\n        \"L02 nonsecret client_secret names a secret\",\n    );\n    rejected(\n        |v| v[\"families\"][\"L01\"][\"nonsecret\"][\"api-key\"] = json!(\"x\"),\n        \"L01 nonsecret api-key names a secret\",\n    );\n}\n\n#[test]\nfn secret_references_stay_in_v2_test_storage_outside_the_repository() {\n    rejected(\n        |v| {\n            v[\"families\"][\"L01\"][\"credentials\"][\"primary\"] = json!({\"kind\": \"keychain\", \"service\": \"io.cdot.prisma-airs-desktop\", \"account\": \"x\"})\n        },\n        \"L01 credential primary names Keychain service io.cdot.prisma-airs-desktop;\",\n    );\n    rejected(\n        |v| {\n            v[\"families\"][\"L01\"][\"credentials\"][\"primary\"] =\n                json!({\"kind\": \"keychain\", \"service\": \"com.example.other\", \"account\": \"x\"})\n        },\n        \"only io.cdot.prisma-airs-desktop.v2.* test items\",\n    );\n    rejected(\n        |v| v[\"families\"][\"L01\"][\"credentials\"][\"primary\"][\"account\"] = json!(\"\"),\n        \"L01 credential primary has no Keychain account\",\n    );\n    let inside = repo().join(\"docs/secret.key\").display().to_string();\n    rejected(\n        |v| {\n            v[\"families\"][\"L01\"][\"credentials\"][\"primary\"] = json!({\"kind\": \"file\", \"path\": inside})\n        },\n        \"L01 credential primary file is inside the repository\",\n    );\n    rejected(\n        |v| {\n    let required = ledger\n        .rows\n        .iter()\n        .filter(|r| r.live.requirement == \"required\")\n        .count();\n\n    let none = live::report(&ledger, None);\n    assert_eq!(none.summary.families_blocked, 19);\n    assert_eq!(none.summary.rows_required, required);\n    assert_eq!(none.summary.rows_owned_by_c26, 1);\n    assert_eq!(none.summary.rows_blocked, required - 1);\n    assert!(none.families.iter().all(|f| f.reason == live::NO_MANIFEST));\n    assert!(none.manifest_sha256.is_none() && none.owner_approval.is_none());\n    let w63 = none.rows.iter().find(|r| r.id == \"W63\").expect(\"fixture\");\n    assert_eq!(\n        (w63.access_status.as_str(), w63.owner.as_deref()),\n        (\"final-artifact\", Some(\"C26\"))\n    );\n\n    let all: LiveManifest = serde_json::from_value(baseline()).expect(\"fixture\");\n    let full = live::report(&ledger, Some((&all, \"abc\")));\n    assert_eq!(full.summary.families_designated, 18);\n    assert_eq!(full.summary.rows_designated, required - 1);\n    assert_eq!(full.summary.rows_blocked, 0);\n    assert_eq!(full.manifest_sha256.as_deref(), Some(\"abc\"));\n    let l01 = full\n        .families\n        .iter()\n        .find(|f| f.id == \"L01\")\n        .expect(\"fixture\");\n    assert_eq!(l01.environment_kind.as_deref(), Some(\"staging\"));\n    assert_eq!(\n        l01.credentials[0].reference,\n        \"keychain:io.cdot.prisma-airs-desktop.v2.c25/L01-a\"\n    );\n\n    let mut partial = baseline();\n    partial[\"families\"][\"L09\"] =\n        json!({\"status\": \"blocked\", \"reason\": \"no inference budget designated\"});\n    let partial: LiveManifest = serde_json::from_value(partial).expect(\"fixture\");\n    let report = live::report(&ledger, Some((&partial, \"abc\")));\n    let w40 = report.rows.iter().find(|r| r.id == \"W40\").expect(\"fixture\");\n    assert_eq!(w40.access_status, \"blocked-by-access\");\n    assert_eq!(w40.blocked_families, vec![\"L09\".to_owned()]);\n    let w41 = report.rows.iter().find(|r| r.id == \"W41\").expect(\"fixture\");\n    assert_eq!(w41.access_status, \"designated\");\n[package]\nname = \"xtask\"\nversion = \"1.0.0\"\ndescription = \"Build-time check, review and artifact controller for Prisma AIRS Desktop\"\nedition.workspace = true\nrust-version.workspace = true\nlicense.workspace = true\npublish.workspace = true\n\n[features]\ndefault = []\n# Exposes deterministic controller fixtures to its integration tests.\ntest-fixtures = []\n\n[dependencies]\ndesktop-core = { path = \"../desktop-core\" }\nserde.workspace = true\nserde_json.workspace = true\nsha2.workspace = true\nhex.workspace = true\nthiserror.workspace = true\n# The controlled live runner (C25) drives the production core.\ntokio = { workspace = true, features = [\"rt\", \"rt-multi-thread\", \"time\"] }\nzeroize = { version = \"=1.9.1\", features = [\"std\"] }\nurl = \"=2.5.8\"\n\n[dev-dependencies]\n# Synthetic TLS endpoints for the live runner's fixture tests (already\n# locked through desktop-core's tests).\ntokio = { workspace = true, features = [\"rt\", \"rt-multi-thread\", \"time\", \"macros\", \"net\", \"io-util\"] }\nrcgen = { version = \"=0.14.10\", default-features = false, features = [\"aws_lc_rs\", \"pem\"] }\nrustls = { version = \"=0.23.46\", default-features = false, features = [\"aws_lc_rs\", \"std\", \"tls12\"] }\ntokio-rustls = { version = \"=0.26.6\", default-features = false, features = [\"aws_lc_rs\", \"tls12\"] }\ntime = \"=0.3.55\"\n# The workspace MCP plane fixture (shared with desktop-core's tests).\nbase64 = \"=0.22.1\"\n\n[lints]\nworkspace = true\n\n[[test]]\nname = \"shell_controller\"\nrequired-features = [\"test-fixtures\"]\n\n[[test]]\nname = \"controlled_live\"\nrequired-features = [\"test-fixtures\"]\n\n[[test]]\nname = \"signed_artifact\"\nrequired-features = [\"test-fixtures\"]\n\n[[test]]\nname = \"live_run\"\npath = \"tests/live_run/main.rs\"\nrequired-features = [\"test-fixtures\"]\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_55","type":"agent_message","text":"I found a current verification regression: C45 changes the live-manifest Keychain prefix, while the synthetic `controlled_live` and `live_run` fixtures still use the retired prefix. The selected xtask check runs only library and shell-controller tests, so it misses those affected consumers. I’m checking the exact impact before finalizing the verdict.\n"}}
